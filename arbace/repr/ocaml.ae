(ns arbace.repr.ocaml
  "Command line of repr/ocaml (doc/ocaml/SPEC.md, doc/ocaml/OCAML-SURVEY.md \"As built: O2\"), run by
  bin/repr-ocaml as -m arbace.repr.ocaml VERB ...:

    read [-o DIR] DUMP...           each helper dump (tools/ocdump) to OCaml forms in mode :lines
                                    (arbace.repr.ocaml.convert: positions removed, heads checked), one
                                    .ae under DIR (default .tmp/repr-ocaml/forms), read back and compared
    read --root DIR -o OUT          every DUMP under DIR (named REL.ae), OUT/REL.ae
    print [-o DIR] FORMS.ae...      the printer (arbace.repr.ocaml.print): one file under DIR (default
                                    .tmp/repr-ocaml/printed) named as the forms file less its .ae
    print --root DIR -o OUT         every forms file under DIR, OUT/REL
    print --full ...                forms in mode :full (the metadata's :layout): the original text, byte for byte
    full --src DIR --parse DIR --layout DIR --out DIR [--forms DIR] [--known FILE] [--record]
                                    mode :full (O3): for each PARSE/REL.ae (the helper's parse dump) and
                                    LAYOUT/REL.ae (its token and comment dump) the forms in mode :full
                                    (OUT-FORMS/REL.ae, written and read back), the text printed from the
                                    forms read back to OUT/REL, and equal to SRC/REL byte for byte; a file
                                    the helper rejects (parse or layout) is classed against FILE
                                    (test/ocaml/full-known.edn: :not-utf8 only; parse rejections are
                                    roundtrip-known.edn's)
    dumps --mode types|lambda --root DIR [--again DIR] [--known FILE] [--times SECONDS]
                                    O4: each ROOT/REL.MODE.ae (ocdump --mode MODE) read by Arbace's reader and
                                    checked against the spec's shapes (arbace.repr.ocaml.lambda: heads, arities,
                                    constants, positions); with --again the second run's file must be byte for
                                    byte the same; a compiler error form is classed against FILE
                                    (test/ocaml/dumps-known.edn, a map REL -> class, per mode); prints the
                                    sizes, node counts and the speed (--times: the helper's seconds)
    compare --orig DIR --cand DIR [--printed DIR] [--known FILE] [--record] [--report FILE]
                                    the round trip's tree level: for each ORIG/REL.ae (the helper's dump
                                    of the original) the dump of the printed file CAND/REL.ae equal
                                    without positions and the file names; a file the helper rejects is
                                    classed (kind, message, class) against FILE (test/ocaml/
                                    roundtrip-known.edn), a printed file the helper rejects is a failure;
                                    with --printed the forms of CAND printed again equal the printed text"
  (:require [arbace.repr.ocaml.convert :as cv]
            [arbace.repr.ocaml.lambda :as lm]
            [arbace.repr.ocaml.print :as pr]
            [arbace.string :as str])
  (:import [java.io File]))

(defn- parse-args [args with-value]
  (loop [as args opts {} pos []]
    (if (empty? as)
      {:opts opts :args pos}
      (let [[a & more] as]
        (cond
          (contains? with-value a) (recur (rest more) (assoc opts a (first more)) pos)
          (str/starts-with? a "-") (recur more (assoc opts a true) pos)
          :else (recur more opts (conj pos a)))))))

(defn- files-under [^String dir ext]
  (->> (file-seq (File. dir))
       (filter #(and (.isFile ^File %) (str/ends-with? (.getName ^File %) ext)))
       (map #(.getPath ^File %))
       sort))

(defn- rel [^String root ^String path]
  (let [r (str (.getCanonicalPath (File. root)) "/")
        p (.getCanonicalPath (File. path))]
    (if (str/starts-with? p r) (subs p (count r)) path)))

(defn- spit-mk [^String path text]
  (let [f (File. path)]
    (.mkdirs (.getParentFile f))
    (spit f text)))

(defn- strip-ae [^String s] (if (str/ends-with? s ".ae") (subs s 0 (- (count s) 3)) s))

;; ---- read ----

(defn- do-read [{:keys [opts args]}]
  (let [out (get opts "-o" ".tmp/repr-ocaml/forms")
        root (get opts "--root")
        files (if root (files-under root ".ae") args)
        bad (atom 0)]
    (doseq [f files]
      (let [r (if root (rel root f) (.getName (File. ^String f)))]
        (try
          (let [x (cv/convert (slurp f))
                text (cv/write-forms x)]
            (cv/read-check text x)
            (spit-mk (str out "/" r) text))
          (catch Throwable t
            (swap! bad inc)
            (println "FAIL" r (.getMessage t))))))
    (println (str "read: " (count files) " dumps, " @bad " failures"))
    (System/exit (if (zero? @bad) 0 1))))

;; ---- print ----

(defn- do-print [{:keys [opts args]}]
  (let [out (get opts "-o" ".tmp/repr-ocaml/printed")
        root (get opts "--root")
        files (if root (files-under root ".ae") args)
        bad (atom 0) skipped (atom 0)]
    (doseq [f files]
      (let [r (strip-ae (if root (rel root f) (.getName (File. ^String f))))]
        (try
          (let [x (read-string (slurp f))]
            (if (cv/error-form? x)
              (swap! skipped inc)
              (spit-mk (str out "/" r) (if (get opts "--full") (cv/full-text x) (pr/print-file x)))))
          (catch Throwable t
            (swap! bad inc)
            (println "FAIL" r (.getMessage t))))))
    (println (str "print: " (count files) " files, " @skipped " error dumps skipped, " @bad " failures"))
    (System/exit (if (zero? @bad) 0 1))))

;; ---- compare ----

(defn- first-diff
  "The path to the first difference of two forms, with both sides"
  [a b path]
  (cond
    (= a b) nil
    (and (sequential? a) (sequential? b) (not= (count a) (count b)) (not= (first a) (first b)))
    [path (pr-str (if (seq? a) (first a) :seq)) (pr-str (if (seq? b) (first b) :seq))]
    (and (sequential? a) (sequential? b))
    (or (some (fn [i] (first-diff (nth a i) (nth b i) (conj path (if (seq? a) (str (first a) "." i) i))))
              (range (min (count a) (count b))))
        [path (str "length " (count a)) (str "length " (count b))])
    (and (map? a) (map? b))
    (or (some (fn [k] (first-diff (get a k) (get b k) (conj path k))) (distinct (concat (keys a) (keys b)))) [path "map" "map"])
    :else [path (let [s (pr-str a)] (subs s 0 (min 160 (count s)))) (let [s (pr-str b)] (subs s 0 (min 160 (count s))))]))

(defn- reject-class [r kind]
  (cond (str/includes? r "templates/") :template
        (= kind :syntax) :syntax-error
        (= kind :lexer) :lexer-error
        :else :other-error))

(defn- do-compare [{:keys [opts]}]
  (let [orig (get opts "--orig") cand (get opts "--cand") printed (get opts "--printed")
        known-file (get opts "--known")
        known-all (if (and known-file (.exists (File. ^String known-file)))
                    (read-string (slurp known-file)) {})
        files (files-under orig ".ae")
        names (set (map #(strip-ae (rel orig %)) files))
        known (if (get opts "--record") {} (select-keys known-all names))
        ok (atom 0) rejects (atom {}) diffs (atom {}) fails (atom []) unstable (atom 0)]
    (doseq [f files]
      (let [r (strip-ae (rel orig f))
            a (cv/convert (slurp f))]
        (if (cv/error-form? a)
          (let [[_ kind msg] a]
            (swap! rejects assoc r {:class (reject-class r kind) :kind kind :message msg}))
          (let [cf (str cand "/" r ".ae")]
            (if-not (.exists (File. ^String cf))
              (swap! diffs assoc r {:class :not-printed :message "no dump of the printed file (the printer failed)"})
              (let [b (try (cv/convert (slurp cf)) (catch Throwable t (list 'ocaml/error :other (.getMessage t))))]
                (cond
                  (cv/error-form? b)
                  (swap! diffs assoc r {:class :printed-rejected :message (pr-str (rest b))})
                  :else
                  (let [d (first-diff (cv/without-file a) (cv/without-file b) [])]
                    (if d
                      (swap! diffs assoc r {:class :diff :at (first d) :orig (second d) :printed (nth d 2)})
                      (do (swap! ok inc)
                          (when printed
                            (let [pf (str printed "/" r)
                                  again (pr/print-file b)]
                              (when-not (= again (slurp pf)) (swap! unstable inc)
                                (println "UNSTABLE" r))))))))))))))
    (let [unexpected-rej (remove (fn [[r v]] (= (select-keys (get known r) [:class :kind :message]) (select-keys v [:class :kind :message]))) @rejects)
          unexpected-diff (remove (fn [[r v]] (= (select-keys (get known r) [:class :at :orig :printed :message]) v)) @diffs)
          gone (remove (fn [[r _]] (or (contains? @rejects r) (contains? @diffs r))) known)
          n (count files)]
      (doseq [[r m] @fails] (println "FAIL" r m))
      (when-not (get opts "--record")
        (doseq [[r v] unexpected-rej] (println "UNEXPECTED REJECT" r (pr-str v))))
      (doseq [[r v] unexpected-diff] (println "DIFF" r (pr-str v)))
      (doseq [[r _] gone] (println "GONE (listed, no longer occurs)" r))
      (println (str "compare: " n " files: " @ok " equal, " (count @rejects) " rejected by the helper ("
                    (pr-str (frequencies (map :class (vals @rejects)))) "), " (count @diffs) " differ, "
                    (count @fails) " failures, " @unstable " unstable"))
      (when (get opts "--report")
        (spit-mk (get opts "--report")
                 (pr-str {:files n :equal @ok :rejected @rejects :differ @diffs :failures @fails :unstable @unstable})))
      (when (get opts "--record")
        (spit-mk known-file (str ";; recorded by `bin/repr-ocaml roundtrip --record`: the files the helper rejects (class, kind, message) and the differences\n"
                                 (str "{" (str/join "\n " (map (fn [[k v]] (str (pr-str k) " " (pr-str v))) (into (sorted-map) (merge (apply dissoc known-all names) @rejects @diffs)))) "}") "\n")))
      (System/exit (if (or (get opts "--record")
                           (and (empty? @fails) (empty? unexpected-rej) (empty? unexpected-diff) (empty? gone) (zero? @unstable)))
                     0 1)))))

;; ---- full ----

(defn- do-full [{:keys [opts]}]
  (let [src (get opts "--src") parse (get opts "--parse") layout (get opts "--layout") out (get opts "--out")
        forms (get opts "--forms") known-file (get opts "--known")
        rt-known (if-let [f (get opts "--rt-known")] (read-string (slurp f)) {})
        known-all (if (and known-file (.exists (File. ^String known-file))) (read-string (slurp known-file)) {})
        files (files-under parse ".ae")
        names (set (map #(strip-ae (rel parse %)) files))
        known (if (get opts "--record") {} (select-keys known-all names))
        ok (atom 0) rejects (atom {}) fails (atom {})]
    (doseq [f files]
      (let [r (strip-ae (rel parse f))
            lf (str layout "/" r ".ae")]
        (try
          (let [ptext (slurp f)
                ltext (slurp lf)
                x (cv/convert-full ptext ltext)]
            (if (cv/error-form? x)
              (let [[_ kind msg] x]
                (if (contains? rt-known r)
                  (swap! rejects assoc r {:class :helper-rejected :kind kind})
                  (swap! rejects assoc r {:class (if (= kind :encoding) :not-utf8 (reject-class r kind)) :kind kind :message msg})))
              (let [text (cv/write-forms x)
                    _ (cv/read-check text x)
                    back (read-string text)
                    printed (cv/full-text back)
                    orig (slurp (str src "/" r))]
                (when forms (spit-mk (str forms "/" r ".ae") text))
                (spit-mk (str out "/" r) printed)
                (if (= printed orig)
                  (swap! ok inc)
                  (swap! fails assoc r {:class :text :message (str "text differs, lengths " (count printed) " and " (count orig))})))))
          (catch Throwable t
            (swap! fails assoc r {:class :error :message (str (.getMessage t))})))))
    (let [counted (into {} (remove (fn [[_ v]] (= :helper-rejected (:class v))) @rejects))
          unexpected-rej (remove (fn [[r v]] (= (select-keys (get known r) [:class :kind :message]) (select-keys v [:class :kind :message]))) counted)
          gone (remove (fn [[r _]] (or (contains? counted r) (contains? @fails r))) known)]
      (doseq [[r v] unexpected-rej] (println "UNEXPECTED REJECT" r (pr-str v)))
      (doseq [[r v] @fails] (println "FAIL" r (pr-str v)))
      (doseq [[r _] gone] (println "GONE (listed, no longer occurs)" r))
      (println (str "full: " (count files) " files: " @ok " text equal, "
                    (count (filter #(= :helper-rejected (:class %)) (vals @rejects))) " rejected by the parse (the round trip's classes), "
                    (count counted) " classed here " (pr-str (frequencies (map :class (vals counted)))) ", " (count @fails) " failures"))
      (when (get opts "--record")
        (spit-mk known-file (str ";; recorded by `bin/repr-ocaml roundtrip --text --record`: the files mode :full classes (layout dump rejected)\n"
                                 (str "{" (str/join "\n " (map (fn [[k v]] (str (pr-str k) " " (pr-str v))) (into (sorted-map) (merge (apply dissoc known-all names) counted)))) "}") "\n")))
      (System/exit (if (and (empty? @fails) (empty? unexpected-rej) (empty? gone)) 0 1)))))

;; ---- the typed and Lambda dumps (O4) ----

(defn- do-dumps [{:keys [opts]}]
  (let [mode (get opts "--mode") root (get opts "--root") again (get opts "--again")
        known (when-let [k (get opts "--known")] (get (read-string (slurp k)) (keyword mode) {}))
        suffix (str "." mode ".ae")
        files (files-under root suffix)
        st (atom {:ok 0 :err 0 :bytes 0 :nodes 0 :unstable 0 :classed 0 :counts {}})
        bad (atom [])]
    (doseq [f files]
      (let [r (subs (rel root f) 0 (- (count (rel root f)) (count suffix)))
            text (slurp f)]
        (swap! st update :bytes + (count (.getBytes ^String text "UTF-8")))
        (try
          (let [res (lm/check-dump mode text)]
            (if-let [e (:error res)]
              (if (contains? known r)
                (swap! st update :classed inc)
                (do (swap! st update :err inc) (swap! bad conj (str r ": " e))))
              (do (swap! st update :ok inc)
                  (swap! st update :nodes + (reduce + (vals (:counts res))))
                  (swap! st update :counts #(merge-with + % (:counts res))))))
          (catch Throwable t
            (swap! st update :err inc)
            (swap! bad conj (str r ": " (.getMessage t) " " (ex-data t)))))
        (when again
          (let [g (str again "/" r suffix)]
            (when-not (and (.exists (File. ^String g)) (= text (slurp g)))
              (swap! st update :unstable inc)
              (swap! bad conj (str r ": differs in the second run")))))))
    (let [{:keys [ok err bytes nodes unstable classed counts]} @st
          secs (some-> (get opts "--times") parse-double)]
      (doseq [b (take 30 @bad)] (println "FAIL" b))
      (println (str "dumps " mode ": " (count files) " files, " ok " read and shaped, " classed " classed errors, "
                    err " failures, " unstable " unstable; " bytes " bytes, " nodes " nodes"
                    (when (and secs (pos? secs)) (str "; " (format "%.1f" secs) " s, " (long (/ bytes secs)) " bytes/s"))))
      (println " heads:" (pr-str (into (sorted-map) (map (fn [[k v]] [(str k) v]) counts))))
      (System/exit (if (and (zero? err) (zero? unstable)) 0 1)))))

(defn -main [& args]
  (let [[verb & more] args
        pa (fn [wv] (parse-args more wv))]
    (case verb
      "read" (do-read (pa #{"-o" "--root"}))
      "print" (do-print (pa #{"-o" "--root"}))
      "full" (do-full (pa #{"--src" "--parse" "--layout" "--out" "--forms" "--known" "--rt-known"}))
      "dumps" (do-dumps (pa #{"--mode" "--root" "--again" "--known" "--times"}))
      "compare" (do-compare (pa #{"--orig" "--cand" "--printed" "--known" "--report"}))
      (do (println "usage: -m arbace.repr.ocaml read|print|compare ...") (System/exit 2)))))

(def target-prefixes
  #{"x86" "aarch64" "amdgcn" "nvvm" "arm" "arm64ec" "riscv" "hexagon" "ppc" "mips" "s390" "wasm" "r600" "spv" "bpf" "xcore"
    "loongarch" "dx" "ve" "sparc" "systemz" "msp430" "csky" "avr"})

(defn recognized?
  "Whether the function name `nm` (with `llvm.`) names an intrinsic: a target's by prefix, a generic one by its name
  with the overload suffixes (`.p0`, `.i32`, `.v4i32`) dropped."
  [^String nm]
  (and (str/starts-with? nm "llvm.")
       (let [n (subs nm 5)]
         (or (contains? target-prefixes (first (str/split n #"\.")))
             (loop [k n]
               (cond (contains? generic-names k) true
                     (str/includes? k ".") (recur (subs k 0 (.lastIndexOf k ".")))
                     :else false))))))

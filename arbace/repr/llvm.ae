(ns arbace.repr.llvm
  "repr/llvm, LLVM IR's bridge (doc/llvm/SPEC.md; doc/cpp/CPP-SURVEY.md §5.2, \"As built: CX6\"): `read-ll` reads IR
  text into LLVM forms (arbace.repr.llvm.read), `module-text` writes them as .ae text (a top-level form a line, a
  function's blocks and instructions a line each), `print-ll` prints forms back to IR (arbace.repr.llvm.print). The
  judge is clang: `clang -c` of the print gives the original's object. Mode :full (arbace.repr.llvm.full) keeps the
  text's layer beside the forms and prints the original back byte for byte. `-main` is bin/repr-llvm read, print,
  verify (arbace.repr.llvm.verify) and the Arbace half of its round trips."
  (:require [arbace.repr.llvm.read :as rd]
            [arbace.repr.llvm.print :as pr]
            [arbace.repr.llvm.full :as full]
            [arbace.repr.c.layout :as layout]
            [arbace.string :as str])
  (:import [java.util.concurrent Executors Callable Future]))

(set! *warn-on-reflection* true)

(defn latin1 ^String [^String path]
  (String. (java.nio.file.Files/readAllBytes (.toPath (java.io.File. path))) "ISO-8859-1"))

(defn spit-latin1 [^String path ^String s]
  (when-let [p (.getParentFile (java.io.File. path))] (.mkdirs p))
  (java.nio.file.Files/write (.toPath (java.io.File. path)) (.getBytes s "ISO-8859-1")
                             ^"[Ljava.nio.file.OpenOption;" (make-array java.nio.file.OpenOption 0)))

(defn read-ll
  "The LLVM forms of the IR text at `path`."
  [^String path]
  (rd/read-module (latin1 path)))

(defn print-ll ^String [forms] (pr/print-module forms))

(defn- define-text
  "A define's .ae text: its header on one line, each block's label and each instruction (or debug record) on its own
  line, then the options after the body (the use-list orders), one a line."
  ^String [f]
  (let [v (vec f)
        bi (.indexOf ^java.util.List v :body)
        head (subvec v 0 bi)
        blocks (nth v (inc bi))
        tail (partition 2 (subvec v (+ bi 2)))
        b (StringBuilder.)]
    (.append b (subs (layout/form-str (apply list head)) 0 (dec (count (layout/form-str (apply list head))))))
    (.append b " :body\n [")
    (doseq [[i blk] (map-indexed vector blocks)]
      (let [[_ l & is] blk]
        (when (pos? i) (.append b "\n  "))
        (.append b (str "(block " (layout/form-str l)))
        (doseq [x is] (.append b "\n   ") (.append b (layout/form-str x)))
        (.append b ")")))
    (.append b "]")
    (doseq [[k x] tail] (.append b (str "\n " (layout/form-str k) " " (layout/form-str x))))
    (.append b ")")
    (str b)))

(defn module-text
  "A module's .ae text: (in-ns 'llvm.NAME) and its forms, a top-level form a line (a define over several)."
  ^String [^String ns forms]
  (str "(in-ns '" ns ")\n"
       (str/join "\n" (map #(if (= (first %) 'llvm/define) (define-text %) (layout/form-str %)) forms))
       "\n"))

(defn read-module-text
  "The forms of a module's .ae text (its in-ns left out)."
  [^String text]
  (let [r (arbace.lang.LineNumberingPushbackReader. (java.io.StringReader. text))
        eof (Object.)
        forms (loop [out []] (let [x (read r false eof)] (if (identical? x eof) out (recur (conj out x)))))]
    (vec (remove #(and (seq? %) (= (first %) 'in-ns)) forms))))

(defn- strip-line
  "A form without the reader's :line and :column metadata (the comparison of level 1)."
  [x]
  (cond
    (seq? x) (apply list (map strip-line x))
    (vector? x) (mapv strip-line x)
    :else x))

(defn ns-name-of ^String [^String path]
  (let [b (.getName (java.io.File. path))
        b (str/replace b #"\.ll$" "")]
    (str "llvm." (str/replace b #"[^A-Za-z0-9_-]" "_"))))

(defn roundtrip-one
  "One file's round trip on the Arbace side: read, the .ae text, read back (equal), print, read again (equal). Writes the
  forms' text at `ae-path` and the print at `print-path`; [ae-path status detail]."
  [^String ae-path ll ^String print-path]
  (try
    (let [forms (if (string? ll) (read-ll ll) ll)
          ae (module-text (ns-name-of (if (string? ll) ll ae-path)) forms)
          back (read-module-text ae)
          same (= (strip-line back) forms)
          txt (print-ll forms)
          again (rd/read-module txt)]
      (spit-latin1 ae-path ae)
      (spit-latin1 print-path txt)
      (cond
        (not same) [ae-path "ae-differs" ""]
        (not= again forms) [ae-path "forms-differ" ""]
        :else [ae-path "ok" ""]))
    (catch Throwable e
      [ae-path (if-let [c (:llvm/refused (ex-data e))] (str "refused:" (name c)) "crash")
       (str/replace (str (.getMessage e)) #"[\t\n]" " ")])))

(defn full-ae
  "A module's `.ae` text in mode :full: its forms as the plain mode writes them, then the layer's line."
  ^String [^String ns {:keys [forms layer]}]
  (str (module-text ns forms) (full/layer-text layer)))

(defn text-one
  "One file's round trip in mode :full: read in :full (the forms the plain mode's), its `.ae` text read back (the forms
  and the layer equal), printed back (the original byte for byte), and the plain print read in :full (a canonical
  text: no layer). Writes the `.ae` text at `ae-path`; [ae-path status detail forms-kept gaps texts]."
  [^String ae-path ^String ll]
  (try
    (let [src (latin1 ll)
          {:keys [forms layer] :as r} (full/read-full src)
          ae (full-ae (ns-name-of ll) r)
          _ (spit-latin1 ae-path ae)
          back (strip-line (read-module-text ae))
          st (full/layer-stats layer)
          plain (print-ll forms)
          pr2 (full/read-full plain)
          status (cond
                   (not= forms (rd/read-module src)) "forms-differ"
                   (not= back forms) "ae-differs"
                   (not= (full/layer-of-ae ae) layer) "layer-differs"
                   (not= (full/print-full forms layer) src) "text-differs"
                   (not= (:forms pr2) forms) "plain-forms-differ"
                   (or (some some? (:items (:layer pr2))) (:end (:layer pr2))) "plain-layer"
                   (not= (full/print-full forms (:layer pr2)) plain) "plain-differs"
                   :else "ok")]
      [ae-path status "" (:forms st) (:gaps st) (:texts st)])
    (catch Throwable e
      [ae-path (if-let [c (:llvm/refused (ex-data e))] (str "refused:" (name c)) "crash")
       (str/replace (str (.getMessage e)) #"[\t\n]" " ") 0 0 0])))

(defn- pool-map
  "f over rows on REPR_LLVM_THREADS threads, in order."
  [f rows]
  (let [threads (Integer/parseInt (or (System/getenv "REPR_LLVM_THREADS") "4"))
        pool (Executors/newFixedThreadPool threads)
        futs (mapv (fn [r] (.submit pool ^Callable (fn [] (f r)))) rows)
        res (mapv #(.get ^Future %) futs)]
    (.shutdown pool)
    res))

(defn- list-rows [lst] (for [l (str/split-lines (slurp lst)) :when (seq l)] (str/split l #"\t")))

(defn -main
  "bin/repr-llvm read [--full] FILE.ll [-o OUT.ae]; print [--full] FILE.ae [-o OUT.ll]; verify FILE.ll|FILE.ae; rt LIST
  WORK (NAME<tab>PATH.ll lines: the Arbace half of the round trip, WORK/rt.tsv); rt-text LIST WORK (mode :full's,
  WORK/text.tsv); verify-list LIST OUT (each file's verdict and first message, a line each)."
  [verb & args]
  (let [full? (= (first args) "--full")
        args (if full? (rest args) args)]
    (case verb
      "read" (let [[f _ o] args
                   t (if full? (full-ae (ns-name-of f) (full/read-full (latin1 f))) (module-text (ns-name-of f) (read-ll f)))]
               (if o (spit-latin1 o t) (print t)) (flush))
      "print" (let [[f _ o] args
                    ae (latin1 f)
                    forms (strip-line (read-module-text ae))
                    t (if full? (full/print-full forms (full/layer-of-ae ae)) (print-ll forms))]
                (if o (spit-latin1 o t) (print t)) (flush))
      "verify" (let [vf (requiring-resolve 'arbace.repr.llvm.verify/verify-main)] (System/exit (int (vf args))))
      "slots-check" (let [[lst] args]
                      (doseq [[n p] (list-rows lst)]
                        (let [forms (read-ll p) m ((requiring-resolve 'arbace.repr.llvm.diag/md-slots) forms)]
                          (when (seq m) (println n (count m) (take 3 (sort-by (fn [[k _]] (Long/parseLong (subs (name k) 1))) m)))))))
      "groups-check" (let [[lst] args]
                       (doseq [[n p] (list-rows lst)]
                         (let [mm ((requiring-resolve 'arbace.repr.llvm.verify/group-mismatches) (read-ll p))]
                           (when (seq mm) (println n (count mm) (take 4 mm))))))
      ;; control WORK SUBJECT REFERENCE-PATH.ll: the negative control's forms level (GTS81 (a)): the forms the SUBJECT's print reads
      ;; again to against the REFERENCE's original forms, `=` as the round trip compares them: prints "differs" (as it must) or "same"
      "control" (let [[work subject ref] args]
                  (println (if (= (rd/read-module (latin1 (str work "/print/" subject ".ll"))) (read-ll ref)) "same" "differs")))
      ;; text-control WORK SUBJECT REFERENCE-PATH.ll: mode :full's negative control (GTS81 (a)): the SUBJECT's .ae text of the round
      ;; trip (WORK/full/SUBJECT.ae) printed back with its layer, against the REFERENCE's original text byte for byte, as rt-text
      ;; compares a file with its own: prints "differs" (as it must) or "same"
      "text-control" (let [[work subject ref] args
                           ae (latin1 (str work "/full/" subject ".ae"))]
                       (println (if (= (full/print-full (strip-line (read-module-text ae)) (full/layer-of-ae ae)) (latin1 ref))
                                  "same" "differs")))
      "verify-list" (let [vf (requiring-resolve 'arbace.repr.llvm.verify/verify-list)] (vf args))
      "rt" (let [[lst work] args
                 res (pool-map (fn [[n p]] (assoc (roundtrip-one (str work "/forms/" n ".ae") p (str work "/print/" n ".ll")) 0 n)) (list-rows lst))]
             (spit (str work "/rt.tsv") (str (str/join "\n" (map #(str/join "\t" %) res)) "\n"))
             (println (count res) "files," (count (filter #(= "ok" (second %)) res)) "read and printed"))
      "rt-text" (let [[lst work] args
                      res (pool-map (fn [[n p]] (assoc (text-one (str work "/full/" n ".ae") p) 0 n)) (list-rows lst))]
                  (spit (str work "/text.tsv") (str (str/join "\n" (map #(str/join "\t" %) res)) "\n"))
                  (println (count res) "files," (count (filter #(= "ok" (second %)) res)) "printed back byte for byte;"
                           (reduce + (map #(nth % 3) res)) "forms with a layer entry,"
                           (reduce + (map #(nth % 4) res)) "gaps and" (reduce + (map #(nth % 5) res)) "texts kept"))
      (do (println "repr/llvm: read, print, verify or rt") (System/exit 2)))))

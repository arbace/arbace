(ns arbace.repr.cpp
  "repr/cpp, C++'s bridge (doc/cpp/SPEC.md; doc/cpp/CPP-SURVEY.md, \"As built: CX3, CX4\"): `read-cpp` reads the
  oracle's filtered AST of a C++ file (tools/cxxdump's output) with the file's text into C++ forms
  (arbace.repr.cpp.convert), `unit-text` writes them as .ae text (repr/c's layout), `print-cpp` prints forms back
  to C++ (arbace.repr.cpp.print, mode :lines). `-main` is bin/repr-cpp read and print."
  (:require [arbace.repr.cpp.convert :as convert]
            [arbace.repr.cpp.print :as print]
            [arbace.repr.c.layout :as layout]
            [arbace.string :as str]))

(set! *warn-on-reflection* true)

(defn ns-name-of
  "A translation unit's namespace (§4.1): cpp. and its path, / as ., the extension dropped, a . or - as _."
  ^String [^String path]
  (let [p (str/replace path #"^\./" "")
        parts (str/split p #"/")
        base (last parts)
        base (let [i (.lastIndexOf ^String base ".")] (if (pos? i) (subs base 0 i) base))]
    (str "cpp." (str/join "." (map #(str/replace % #"[.+\-]" "_") (concat (butlast parts) [base]))))))

(defn read-dump
  "tools/cxxdump's output: [header nodes]."
  [^String path]
  (let [r (arbace.lang.LineNumberingPushbackReader. (java.io.StringReader. (slurp path)))
        eof (Object.)
        xs (loop [out []] (let [x (read r false eof)] (if (identical? x eof) out (recur (conj out x)))))]
    [(first xs) (vec (filter #(and (map? %) (:kind %)) (rest xs)))]))

(defn latin1 ^String [^String path]
  (String. (java.nio.file.Files/readAllBytes (.toPath (java.io.File. path))) "ISO-8859-1"))

(defn read-cpp
  "The forms of the C++ file whose text is at `src-path` and whose dump is at `dump-path` (`main`, its name as clang
  was given it; `std`, its standard): {:ns :file-form :forms :texts} or {:refused class :message m}."
  [^String dump-path ^String src-path ^String main ^String std]
  (try
    (let [[_ nodes] (read-dump dump-path)
          c (convert/convert nodes (latin1 src-path) main nil)]
      (assoc c :ns (ns-name-of main) :file-form (list 'cpp/file main :std (keyword std))))
    (catch arbace.lang.ExceptionInfo e
      (if-let [g (:cpp/gap (ex-data e))]
        {:refused g :message (ex-message e)}
        (throw e)))))

(defn unit-text
  "A read's .ae text."
  ^String [rd]
  (layout/unit-text (str "(in-ns '" (:ns rd) ") " (layout/form-str (:file-form rd))) (:forms rd)))

(defn read-unit-text
  "The forms of an .ae text: [file-form forms]."
  [^String text]
  (let [r (arbace.lang.LineNumberingPushbackReader. (java.io.StringReader. text))
        eof (Object.)
        forms (loop [out []] (let [x (read r false eof)] (if (identical? x eof) out (recur (conj out x)))))
        forms (remove #(and (seq? %) (= (first %) 'in-ns)) forms)]
    [(first forms) (vec (rest forms))]))

(defn print-cpp ^String [file-form forms] (print/print-unit forms))

(defn -main
  "bin/repr-cpp read DUMP FILE [--main NAME] [--std S]: FILE's forms (from its cxxdump output DUMP) as .ae text;
  bin/repr-cpp print FILE.ae...: each unit's C++ text."
  [verb & args]
  (case verb
    "read" (let [[dump src & opts] args
                 o (apply hash-map opts)
                 rd (read-cpp dump src (get o "--main" src) (get o "--std" "gnu++17"))]
             (if (:refused rd)
               (do (binding [*out* *err*] (println (str src ": refused (" (name (:refused rd)) "): " (:message rd)))) (flush) (System/exit 1))
               (do (print (unit-text rd)) (flush))))
    "print" (do (doseq [f args]
                  (let [[ff forms] (read-unit-text (slurp f))]
                    (.write ^java.io.Writer *out* (print-cpp ff forms))))
                (flush))
    (do (println "repr/cpp: read or print") (System/exit 2))))

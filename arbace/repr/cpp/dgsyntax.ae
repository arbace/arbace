(ns arbace.repr.cpp.dgsyntax
  "CP262 (b) (the user, 2026-11-08; doc/cpp/CPP-SURVEY.md, \"As built: cpp-props\"): the dg check's files that expect only syntax
  errors, the read cell's classification side. A file of the dg-error part whose every expected error line's every message is a
  syntax, lexical or preprocessor diagnostic (arbace.c.dg/syntax-expectation?, C's rule: the errors a reader stands for before
  any checker runs) is judged by the native front end's own errors (the own record of CX12, test/cpp/check-dg-own-linux-amd64.edn,
  arbace.repr.cpp.diag's syntax errors), not clang's: bin/reap's dg source takes those files' rows from the own record when it
  holds them (:own-for), a failure there the class :syntax-own (deferred: the parser's gap), not one of clang's by-design classes.
  The list is data, test/cpp/dg-syntax-only.txt, made from the directives (the `lists` step of bin/repr-cpp dg, no read):
  `list WORK OUT` from WORK/dg-error/dg.edn, `check WORK FILE` that FILE is what `list` makes."
  (:require [arbace.c.dg :as cdg]
            [arbace.string :as str]))

(set! *warn-on-reflection* true)

(def list-file "test/cpp/dg-syntax-only.txt")

(defn syntax-only?
  "A file's directives (arbace.repr.cpp.dg/analyze's map at the run's standard): it expects errors, on lines only (no line-0
  count, no dg-excess-errors, which take any error), and every message of every expected error line is a syntax expectation."
  [dg]
  (let [ls (get-in dg [:expect :error])]
    (boolean (and (seq ls) (not (:unsupported dg)) (not= :preprocess (:action dg))
                  (zero? (long (get-in dg [:any :error] 0))) (not (:excess dg))
                  (every? (fn [l] (let [ms (get-in dg [:msgs l])] (and (seq ms) (every? cdg/syntax-expectation? ms)))) ls)))))

(defn names
  "The syntax-only files of a dg work directory's dg-error part, gxx-dg/NAME, sorted."
  [^String work]
  (let [dg (read-string (slurp (str work "/dg-error/dg.edn")))]
    (vec (sort (for [[nm d] dg :when (syntax-only? d)] (str "gxx-dg/" nm))))))

(defn- text [ns]
  (str "# The dg check's files that expect only syntax errors (CP262 (b); arbace.repr.cpp.dgsyntax, made by its `list` from the\n"
       "# directives of the dg-error part): judged by the native front end's own errors (bin/reap's dg source, :own-for). One a line.\n"
       (str/join (map #(str % "\n") ns))))

(defn -main [verb & args]
  (case verb
    "list" (let [[work out] args ns (names work)]
             (spit (or out list-file) (text ns))
             (println (str "wrote " (or out list-file) ": " (count ns) " files expecting only syntax errors")))
    "check" (let [[work f] args ns (names work) want (text ns) have (slurp (or f list-file))]
              (if (= want have)
                (println (str (or f list-file) ": " (count ns) " files, as the directives give"))
                (do (println (str (or f list-file) " is not what the directives give (" (count ns) " files): bin/repr-cpp dg-syntax-list"))
                    (System/exit 1))))
    (do (println "dgsyntax: list WORK [OUT] | check WORK [FILE]") (System/exit 2))))

(ns arbace.repr.cpp.native
  "repr/cpp's native reader (doc/cpp/NATIVE.md; doc/cpp/CPP-SURVEY.md, CX11): a C++ file read without the oracle --
  the shared preprocessor (arbace.repr.c.pp in C++ mode, with clang's predefined macros and search list: the forms
  are the oracle's reading of the file, CP23) and the native parser (arbace.repr.cpp.parse), whose tree is clang's AST
  as tools/cxxdump writes it, so that arbace.repr.cpp.convert makes the forms from it as from the dump. `parse-file`
  gives the main file's nodes and the lines of its directives the preprocessor ran (cxxdump's `{:executed ...}`)."
  (:require [arbace.repr.c.pp :as pp]
            [arbace.repr.cpp.host :as host]
            [arbace.repr.cpp.lit :as lit]
            [arbace.repr.cpp.parse :as ps]
            [arbace.string :as str]))

(set! *warn-on-reflection* true)

(defn host-dir
  "The directory of clang's answers the native parser reads: REPR_CPP_HOST, else the target's (arbace.repr.cpp.host/gxx-dir:
  Arbace's C++ target, cpp/target/host, whose clang half test/cpp/clang.ae computes, CP248 (a); REPR_CPP_TARGET=gxx clang's recorded
  answers, test/cpp/host, the oracle tier's), relative to the current directory (the checkout's root)."
  ^String []
  (or (System/getenv "REPR_CPP_HOST") (host/gxx-dir)))

;; cpp-extfloat (2026-11-24): the own front end (arbace.repr.cpp.diag binds this true) reads GCC's dialect, whose x86-64 target has
;; C++23's extended floating-point types ([basic.extended.fp], P1467R9): its predefined macros are clang's (as the native reader's)
;; plus the target's extended floating types' that clang lacks, as Arbace's own C++ target's GNU half has them (cpp/target/host's
;; predefined/gxx, made by test/cpp/predef.ae from c/target/abi.edn's :floats and cpp/target/dialect.edn's :from-year): the
;; __FLTnn_*, __FLTnnX_* and __BFLT16_* families at every standard and C++23's __STDCPP_FLOATnn_T__ and __STDCPP_BFLOAT16_T__
(def ^:dynamic *gnu-floats* false)

(def ^:private ext-float-macro #"#define (__STDCPP_B?FLOAT\d+_T__|__B?FLT\d+X?_[A-Z0-9_]+__)\b.*")

(defn- ext-float-lines
  "The lines of the GNU half's predefined macros of `std` (cpp/target/host/predefined/gxx) of the extended floating types that
  `text` (clang's) does not define."
  ^String [^String dir ^String std ^String text]
  (let [f (java.io.File. (str dir "/predefined/gxx/" std ".h"))]
    (if-not (.exists f)
      ""
      (let [have (set (map second (re-seq #"(?m)^#define (\S+)" text)))]
        (apply str (for [l (str/split-lines (slurp f))
                         :let [[_ n] (re-matches ext-float-macro l)]
                         :when (and n (not (have n)))]
                     (str l "\n")))))))

(defn- latin1 ^String [^String path]
  (String. (java.nio.file.Files/readAllBytes (.toPath (java.io.File. path))) "ISO-8859-1"))

(defn- line-starts [^String s]
  (let [v (java.util.ArrayList.)]
    (.add v (long 0))
    (dotimes [i (.length s)] (when (= \newline (.charAt s i)) (.add v (long (inc i)))))
    v))

(defn- line-of ^long [^java.util.ArrayList starts ^long off]
  (let [i (java.util.Collections/binarySearch starts off)]
    (if (neg? i) (- (- i) 1) (inc i))))

(defn executed-lines
  "The lines of the main file's directives the preprocessor ran (its layer's main-file entries)."
  [layer ^String path ^String src]
  (let [starts (line-starts src)]
    (set (for [d layer
               :when (and (:directive d) (= (:file d) path) (:off d))]
           (line-of starts (long (:off d)))))))

(defn parse-file
  "The main file at `path`, named `main` as the oracle names it, read at the standard `std` with the compiler options
  `args` (-D, -U, -I, ...): {:nodes [clang's nodes of the main file's declarations] :executed #{line ...} :declines n
  :reasons {why n} :pp-errors [...]}."
  [^String path ^String main ^String std args]
  (let [h (host/load-host (host-dir) "clang")
        std (or (host/canonical-std std) std)
        ;; queue 336 (D336-1 (a)): -fconcepts (GCC's, passed by the dg check's own front end alone) makes concept and requires
        ;; keywords below C++20; the predefined macros stay those of the options without it, as before
        concepts (boolean (some #{"-fconcepts"} args))
        ;; (cpp-1123: -fcoroutines below C++20, which the dg check's own front end passes where GCC's driver has it on -- an
        ;; earlier -std=c++20 or later on the command line, g++.dg/coroutines' coroutines.exp's: co_await, co_return and
        ;; co_yield keywords and __cpp_impl_coroutine, as `g++ -std=c++20 -std=c++17 -dM -E` gives, g++ 15.2 by hand)
        coroutines (boolean (some #{"-fcoroutines"} args))
        ;; (cpp-read, 2026-11-22: -fexec-charset=ISO-8859-1, given by the dg check's own front end: the ordinary literals'
        ;; encoding, ps/*exec-latin1*; not the preprocessor's)
        exec-latin1 (boolean (some #(re-matches #"(?i)-fexec-charset=(ISO-?8859-1|LATIN-?1|ISO_8859-1)" %) args))
        fc (host/file-config (vec (remove #(or (#{"-fconcepts" "-fpermissive" "-fcoroutines"} %) (str/starts-with? % "-fexec-charset=")) args)) std)
        coroutines (and coroutines (< (long (host/std-year (:std fc))) 2020))
        fc (cond-> fc coroutines (update :pre str "#define __cpp_impl_coroutine 201902L\n"))
        ;; queue 411 (DECISION 392-2 (a)): -fchar8_t below C++20 (the runtime's limits.cc, codecvt.cc, locale_init.cc and
        ;; localename.cc are compiled with it) makes char8_t a keyword and u8 literals of it (arbace.repr.cpp.lit/*char8*), and adds
        ;; the macros clang 23 adds for it (clang++ -std=gnu++11 -fchar8_t -dM -E against no option: __cpp_char8_t and the two
        ;; atomics' lock-freedom); the last of -fchar8_t and -fno-char8_t wins
        char8 (and (< (long (host/std-year (:std fc))) 2020)
                   (= "-fchar8_t" (last (filter #{"-fchar8_t" "-fno-char8_t"} args))))
        fc (cond-> fc char8 (update :pre str "#define __CLANG_ATOMIC_CHAR8_T_LOCK_FREE 2\n#define __GCC_ATOMIC_CHAR8_T_LOCK_FREE 2\n#define __cpp_char8_t 202207L\n"))
        ;; the file preprocessed under its name as the oracle was given it (__FILE__'s), from the directory it is relative to
        [base nm] (if (and (str/ends-with? path (str "/" main)) (not (str/starts-with? main "/")))
                    [(subs path 0 (- (count path) (count main) 1)) main]
                    ["." path])
        h (cond-> h *gnu-floats* (update-in [:predefined (:std fc)] #(str % (ext-float-lines (host-dir) (:std fc) (str %)))))
        cfg (host/config h fc base)
        t0 (System/nanoTime)
        r (pp/preprocess cfg nm)
        t1 (System/nanoTime)
        src (latin1 path)
        year (host/std-year (:std fc))
        gnu (str/starts-with? (:std fc) "gnu")
        ;; (h-cpp-read: -fno-gnu-keywords takes typeof out of the keywords, as GCC's D_EXT keywords; ext/no-gnu-keywords-1.C)
        toks (binding [lit/*char8* char8]
               ;; queue 540: a failed #include is clang's fatal error: the token after its line, which the port's stream (cc's)
               ;; keeps, is not read (gxx-modules' target-aarch64-1_a.C, `#include <arm_sve.h>` then `export module M;`)
               (ps/tokens (cond-> (:tokens r) (:closed-token r) pop) nm main src (cond-> (ps/keywords year (and gnu (not (some #{"-fno-gnu-keywords"} args))) concepts)
                                                    char8 (conj "char8_t")
                                                    ;; (cpp-rind: -fno-char8_t from C++20, the last of the two, takes char8_t out of the
                                                    ;; keywords, GCC's D_CXX_CHAR8_T; cpp2a/char8_t2.C)
                                                    (and (>= (long year) 2020) (= "-fno-char8_t" (last (filter #{"-fchar8_t" "-fno-char8_t"} args))))
                                                    (disj "char8_t")
                                                    coroutines (into #{"co_await" "co_return" "co_yield"})
                                                    *gnu-floats* (into #{"_Float32" "_Float64" "_Float128" "_Float32x" "_Float64x"}))))
        _ (when (System/getenv "REPR_CPP_TIME") (binding [*out* *err*] (println (format "repr/cpp native: tokens %.2f s" (/ (- (System/nanoTime) t1) 1e9)))))
        u (binding [lit/*char8* char8 ps/*exec-latin1* exec-latin1]
            (ps/parse-unit toks main src year gnu (cond-> [(:std fc)] char8 (conj "-fchar8_t") exec-latin1 (conj "-fexec-charset=ISO-8859-1"))))
        t2 (System/nanoTime)]
    ;; REPR_CPP_TIME: the preprocessor's and the parser's seconds, the header-skim cache's use (stderr)
    (when (System/getenv "REPR_CPP_TIME")
      (binding [*out* *err*]
        (println (format "repr/cpp native: %s: %d tokens, preprocess %.2f s, parse %.2f s, skim cache %s" main (alength ^objects toks)
                         (/ (- t1 t0) 1e9) (/ (- t2 t1) 1e9) (or (:skim-cache u) "-")))))
    (assoc u :executed (executed-lines (:layer r) nm src) :pp-errors (:errors r)
           ;; (cpp-gnu, 2026-11-22: the main file's #pragma directives, their offsets and texts, for the front end's pragma rules,
           ;; arbace.repr.cpp.diag/pragmas)
           :pragmas (vec (for [d (:layer r) :when (and (= "pragma" (:directive d)) (= (:file d) nm) (:off d))]
                           {:off (:off d) :text (:text d)})))))

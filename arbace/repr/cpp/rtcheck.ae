(ns arbace.repr.cpp.rtcheck
  "repr/cpp's round trip (doc/cpp/CPP-SURVEY.md, \"As built: CX3, CX4\"), the Arbace half of bin/repr-cpp
  roundtrip: `forms` reads each file of a list from its oracle dump into forms (WORK/forms/NAME.ae) and prints them
  (WORK/print/NAME, the same relative name under another root); `again` reads the prints' dumps into forms
  (WORK/forms2/NAME.ae), level 1's other side. The levels are judged by the driver (cmp of the .ae texts, of the
  normalized dumps, of the objects)."
  (:require [arbace.repr.cpp :as rc]
            [arbace.string :as str])
  (:import [java.util.concurrent Executors Callable Future]))

(set! *warn-on-reflection* true)

(defn- spit-utf8 [^String path ^String s]
  (let [f (java.io.File. path)]
    (.mkdirs (.getParentFile f))
    (spit f s)))

(defn- full-level
  "Level 5 (mode :full): the file read in mode :full, written as .ae text and read back, printed: the original's bytes.
  \"same\", \"differs\" or \"refused: CLASS\"."
  [^String dump ^String src ^String nm ^String std]
  (try
    (let [rd (rc/read-cpp dump src nm std true)]
      (if (:refused rd)
        (str "refused: " (name (:refused rd)))
        (let [[ff forms] (rc/read-unit-text (rc/unit-text rd))
              t (rc/print-cpp ff forms)]
          (if (java.util.Arrays/equals (.getBytes ^String t "ISO-8859-1") (java.nio.file.Files/readAllBytes (.toPath (java.io.File. src))))
            "same" "differs"))))
    (catch Throwable e (str "crash: " (str/replace (str e) #"[\t\n]" " ")))))

(defn- one
  "One file: [name status texts detail]; status ok, refused, crash."
  [^String work ^String nm ^String std ^String dump ^String src ^String forms-dir ^String print-dir]
  (try
    (let [rd (rc/read-cpp dump src nm std)]
      (if (:refused rd)
        [nm "refused" 0 (str (name (:refused rd)) ": " (str/replace (str (:message rd)) #"[\t\n]" " "))]
        (let [ae (rc/unit-text rd)
              txt (when print-dir (rc/print-cpp (:file-form rd) (:forms rd)))
              n (reduce + (vals (dissoc (:texts rd) :macro-form :group)))]
          (spit-utf8 (str forms-dir "/" nm ".ae") ae)
          (when print-dir (spit-utf8 (str print-dir "/" nm) txt))
          [nm "ok" n (pr-str (:texts rd)) (if print-dir (full-level dump src nm std) "-")])))
    (catch Throwable e
      [nm "crash" 0 (str/replace (str e) #"[\t\n]" " ")])))

(defn run
  "Each line of LIST (name, std, ...) whose dump DUMPS/NAME.edn exists: its forms under FORMS, its print under PRINT
  (none when PRINT is \"-\"), its source SRC-ROOT/NAME; the results in OUT (name, status, text forms, detail)."
  [^String list ^String dumps ^String src-root ^String forms-dir ^String print-dir ^String out]
  (let [rows (for [l (str/split-lines (slurp list)) :when (seq l)] (str/split l #"\t" -1))
        rows (filter (fn [[nm]] (.exists (java.io.File. (str dumps "/" nm ".edn")))) rows)
        threads (Integer/parseInt (or (System/getenv "REPR_CPP_THREADS") "4"))
        pool (Executors/newFixedThreadPool threads)
        t0 (System/nanoTime)
        futs (mapv (fn [[nm std]]
                     (.submit pool ^Callable (fn [] (one nil nm std (str dumps "/" nm ".edn") (str src-root "/" nm) forms-dir
                                                         (when-not (= print-dir "-") print-dir)))))
                   rows)
        rs (mapv #(.get ^Future %) futs)]
    (.shutdown pool)
    (spit out (str/join (map #(str (str/join "\t" %) "\n") rs)))
    (println (str (count rs) " files: " (pr-str (frequencies (map second rs))) ", "
                  (count (filter #(and (= (second %) "ok") (zero? (long (nth % 2)))) rs)) " without a text form, "
                  (Math/round (double (/ (- (System/nanoTime) t0) 1e9))) " s"))))

(defn- bytes-of [^String p]
  (let [f (java.io.File. p)] (when (.exists f) (java.nio.file.Files/readAllBytes (.toPath f)))))

(defn- same? [^String a ^String b]
  (let [x (bytes-of a) y (bytes-of b)] (boolean (and x y (java.util.Arrays/equals ^bytes x ^bytes y)))))

(defn- status [^String p] (let [b (bytes-of p)] (when b (str/trim (String. ^bytes b "UTF-8")))))

(defn- tsv [^String p]
  (if (.exists (java.io.File. p))
    (into {} (for [l (str/split-lines (slurp p)) :when (seq l) :let [r (str/split l #"\t" -1)]] [(first r) r]))
    {}))

(defn oracle-rejects?
  "Whether a dump's status and stderr are clang rejecting the file (review 007's finding 3): cxxdump's status 1 (clang exited
  1; cxxdump's own failures, a crash or a kill of clang are 3, a timeout of ours 124) and one of clang's own diagnostics
  (`FILE:LINE:COL: error:` or `fatal error:`) in its stderr."
  [st ^String err]
  (boolean (and (= st "1") err (re-find #"(?m)^[^\s:][^:\n]*:[0-9]+:[0-9]+: (fatal )?error: " err))))

(defn judge
  "The levels of each file of WORK's list, against the known file: WORK/results.tsv (name, verdict, class, read, l1,
  l3, l4 g++, l4 clang, text forms) and WORK/summary.edn; prints the table's line. Exit status 1 when a file fails."
  [^String work ^String known-file & [objects]]
  (let [known (if (.exists (java.io.File. known-file)) (read-string (slurp known-file)) {})
        kfiles (:files known {})
        ;; level 4 (review 007's finding 7): the objects are required unless the run had --no-objects; a compiler may fail on
        ;; the original only where the known file's :orig-fails records it (NAME -> the compilers, #{:gxx :clang})
        objects? (not= objects "no-objects")
        ofails (:orig-fails known {})
        names (for [l (str/split-lines (slurp (str work "/list.tsv"))) :when (seq l)] (first (str/split l #"\t")))
        r1 (tsv (str work "/read.tsv"))
        r2 (tsv (str work "/read2.tsv"))
        obj (fn [side who nm] (status (str work "/obj/" side "/" who "/" nm ".status")))
        rows (for [nm names]
               (let [o (status (str work "/orig/" nm ".status"))
                     [_ rs texts detail full] (get r1 nm)
                     read (cond (= o "0") (if (nil? rs) "no-read" rs)
                                (oracle-rejects? o (some-> (bytes-of (str work "/orig/" nm ".err")) (String. "UTF-8"))) "oracle-rejects"
                                (nil? o) "no-dump"
                                :else (str "dump-error-" o))
                     ;; the dumps' own failures (review 018's R1): the original's -norm dump, and the print's dump and -norm dump
                     ;; failing for another reason than clang's rejection of the print are the check's failure, never known
                     err-of (fn [side nm] (some-> (bytes-of (str work "/" side "/" nm ".err")) (String. "UTF-8")))
                     nst (status (str work "/orig/" nm ".norm.status"))
                     p (status (str work "/dump2/" nm ".status"))
                     pn (status (str work "/dump2/" nm ".norm.status"))
                     read (cond (not= read "ok") read
                                (not= nst "0") (str "dump-error-norm-" (or nst "none"))
                                (and p (not= p "0") (not (oracle-rejects? p (err-of "dump2" nm)))) (str "dump-error-print-" p)
                                (and (= p "0") (not= pn "0")) (str "dump-error-print-norm-" (or pn "none"))
                                :else read)
                     l1 (when (= read "ok") (and (= "ok" (second (get r2 nm))) (same? (str work "/forms/" nm ".ae") (str work "/forms2/" nm ".ae"))))
                     l3 (when (= read "ok") (and (= "0" (status (str work "/dump2/" nm ".status"))) (same? (str work "/orig/" nm ".norm") (str work "/dump2/" nm ".norm"))))
                     l4 (fn [who]
                          (when (= read "ok")
                            (let [a (obj "orig" who nm) b (obj "print" who nm)]
                              (cond (nil? a) (when objects? :missing)
                                    (not= a "0") (if (contains? (get ofails nm) (keyword who)) :orig-fails :orig-fails-unrecorded)
                                    (not= b "0") false
                                    :else (same? (str work "/obj/orig/" who "/" nm ".o") (str work "/obj/print/" who "/" nm ".o"))))))
                     g (l4 "gxx") c (l4 "clang")
                     ok4? (fn [x] (or (true? x) (nil? x) (= x :orig-fails)))
                     l5 (or full "-")
                     pass (and (= read "ok") l1 l3 (contains? #{"same" "-"} l5) (ok4? g) (ok4? c))
                     k (get kfiles nm)
                     ;; the first level that fails (review 007's finding 8): a known file is known only when its class names
                     ;; that level; the objects count as differing only when both were made and compared
                     first (cond pass nil
                                 (not= read "ok") :read
                                 ;; level 1 is two classes (review 018's R6): the print rejected by clang (its dump's status 1 with a
                                 ;; diagnostic: the failures of any other kind are dump errors above), and forms that differ
                                 (not l1) (if (and p (not= p "0")) :l1-rejected :l1-differs)
                                 (not l3) :l3
                                 (not (and (ok4? g) (ok4? c))) (cond (not (every? #(or (ok4? %) (false? %)) [g c])) :l4-other
                                                                     (and (false? g) (ok4? c)) :l4-gxx
                                                                     :else :l4)
                                 :else :l5)
                     fits (get {:print-rejected #{:l1-rejected} :forms-differ #{:l1-differs} :ast-differs #{:l3}
                                :objects-differ #{:l4 :l4-gxx} :gxx-objects-location #{:l4-gxx}} k #{})
                     ;; a dump that failed for another reason than clang's rejection is the check's failure, never known
                     verdict (cond (= read "oracle-rejects") "oracle-rejects" pass "pass"
                                   (or (= read "no-dump") (str/starts-with? read "dump-error")) "fail"
                                   (and k (contains? fits first)) "known" :else "fail")]
                 [nm verdict (if k (name k) "-") read (str l1) (str l3) (str g) (str c) (or texts "-") (or full "-") (if first (name first) "-")]))
        rows (vec rows)
        cnt (fn [pred] (count (filter pred rows)))
        summary {:files (count rows)
                 :verdicts (frequencies (map second rows))
                 :read-ok (cnt #(= (nth % 3) "ok"))
                 :refused (cnt #(= (nth % 3) "refused"))
                 :crash (cnt #(= (nth % 3) "crash"))
                 :oracle-rejects (cnt #(= (nth % 3) "oracle-rejects"))
                 :dump-errors (cnt #(or (= (nth % 3) "no-dump") (str/starts-with? (nth % 3) "dump-error")))
                 :l1 (cnt #(= (nth % 4) "true")) :l3 (cnt #(= (nth % 5) "true"))
                 :l4-gxx (cnt #(= (nth % 6) "true")) :l4-gxx-orig-fails (cnt #(= (nth % 6) ":orig-fails"))
                 :l4-unrecorded-orig-fails (cnt #(or (= (nth % 6) ":orig-fails-unrecorded") (= (nth % 7) ":orig-fails-unrecorded")))
                 :l4-missing (cnt #(or (= (nth % 6) ":missing") (= (nth % 7) ":missing")))
                 :l5-full (cnt #(= (nth % 9) "same")) :l5-differs (cnt #(= (nth % 9) "differs"))
                 :l5-refused (frequencies (keep #(when (str/starts-with? (nth % 9) "refused") (nth % 9)) rows))
                 :l5-crash (cnt #(str/starts-with? (nth % 9) "crash"))
                 :l4-clang (cnt #(= (nth % 7) "true")) :l4-clang-orig-fails (cnt #(= (nth % 7) ":orig-fails"))
                 :no-text-form (cnt #(and (= (nth % 3) "ok") (= (nth % 8) "0")))
                 :known (frequencies (keep #(when (= (second %) "known") (nth % 2)) rows))}]
    (spit (str work "/results.tsv") (str/join (map #(str (str/join "\t" %) "\n") rows)))
    (spit (str work "/summary.edn") (pr-str summary))
    (println (pr-str summary))
    (let [fails (filter #(= (second %) "fail") rows)]
      (when (seq fails)
        (println (str (count fails) " failing: " (str/join " " (map #(str (first %) (when (not= "-" (nth % 2)) (str " (known as " (nth % 2) ", fails at " (nth % 10) ")"))) (take 12 fails))))))
      (System/exit (if (seq fails) 1 0)))))

(defn -main [cmd & args]
  (case cmd
    "run" (apply run args)
    "judge" (apply judge args)
    (do (println "rtcheck: run LIST DUMPS SRC-ROOT FORMS PRINT OUT") (System/exit 2))))

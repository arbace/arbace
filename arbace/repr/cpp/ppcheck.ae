(ns arbace.repr.cpp.ppcheck
  "repr/cpp's token check (doc/cpp/CPP-SURVEY.md, \"As built: CX2\"; bin/repr-cpp pp-check, its driver
  bin/lib/repr-cpp/pp-check): the corpora of test/cpp/corpora.edn read in place, each file lexed and
  preprocessed by arbace.repr.c.lex and arbace.repr.c.pp in C++ mode (arbace.repr.cpp.host), and judged by
  the two compilers' recorded answers, as C's CS51 (a) judges by gcc -E's:
  - the preprocessed stream: the SHA-256 of its tokens against g++ -E -P's (test/repr/cpp/pp-gxx.sha256), or both
    reject the file, or the known file lists it with its class;
  - the lexer: the file's raw tokens (position and text, no comments or white space, no header names) against
    clang's `-Xclang -dump-raw-tokens` (test/repr/cpp/lex-clang.sha256), or the known file lists it.
  Also `pp` and `lex`, bin/repr-cpp's commands."
  (:require [arbace.repr.c.lex :as lex]
            [arbace.repr.c.pp :as pp]
            [arbace.repr.c.ppcheck :as cpc]
            [arbace.repr.cpp.host :as host]
            [arbace.string :as str])
  (:import [arbace.repr.c.lex Tok]
           [java.util.concurrent Executors Callable]))

(set! *warn-on-reflection* true)

(def known-file "test/repr/cpp/pp-check-known.edn")
(def gxx-file "test/repr/cpp/pp-gxx.sha256")
(def clang-file "test/repr/cpp/lex-clang.sha256")
(def corpora-file "test/cpp/corpora.edn")

;; ---------------------------------------------------------------------------------------------
;; The corpora

(defn- slurp-latin1 ^String [^String path] (String. (lex/read-bytes path) "ISO-8859-1"))

(defn- name* ^String [k] (if (keyword? k) (name k) (str k)))

(defn file-entry
  "A file's entry: {:name :read :fc}, its configuration from the corpus' :std and its dg-options."
  [corpus ^String base ^String name]
  (let [std (let [s (:std corpus)] (if (or (nil? s) (= s :from-file)) host/default-std (name* s)))
        std (or (host/canonical-std std) host/default-std)
        text (slurp-latin1 (str base "/" name))
        opts (if (= (:std corpus) :from-file) (host/dg-options text) [])
        ;; CP66 (b): the corpus owns its harness' include paths (:include-dirs, relative to its directory, "" the directory)
        opts (into (vec opts) (map #(str "-I" (str/replace (str base "/" %) #"/$" "")) (:include-dirs corpus)))
        ;; CX5d: the corpus' own compiler arguments (:cxx-args, `{jdk26u}` and `{build}` resolved by `lists`), after the file's
        ;; CP76 (b): a path the build compiles with other options (HotSpot's share/adlc/, a host tool) has them in :cxx-args-for
        opts (into opts (or (some (fn [{:keys [path-regex args]}] (when (re-find (re-pattern path-regex) name) args)) (:cxx-args-for corpus))
                            (:cxx-args corpus)))]
    {:name name :read (if (:absolute corpus) (str base "/" name) name)
     ;; CP76 (b): :clang-args (clang's alone, `{checkout}` resolved by `lists`) join the modelled options, not g++'s
     :fc (let [fc (host/file-config opts std)] (update fc :args into (:clang-args corpus)))}))

(defn- shard-of
  "Files `n` of `of` (1-based) of a corpus' sorted list, or all: --sample N takes every Nth file."
  [files sample] (if (and sample (> (long sample) 1)) (vec (take-nth (long sample) files)) files))

(defn- only-names
  "The names of corpus ID in an --only list (CX10: one CORPUS/NAME a line, `#` comments and blank lines skipped), or nil."
  [^String f ^String id]
  (let [pre (str id "/")]
    (vec (for [l (str/split-lines (slurp f))
               :let [l (str/trim l)]
               :when (and (seq l) (not (str/starts-with? l "#")) (str/starts-with? l pre))]
           (subs l (count pre))))))

(defn lists
  "Writes WORK/CORPUS/files.edn (the entries), base.txt, gxx.list and clang.list for each corpus id; `roots` maps
  a :root to its directory, `sample` keeps every Nth file. CX10: `sample` a map {:only FILE :key K} keeps the files FILE
  names under the corpus (CORPUS/NAME a line; a name not in the corpus refused), the round trip's list headed
  `#list CORPUS-K`, and marks the corpus' run a subset (WORK/CORPUS/subset.txt: its known entries held only for its files)."
  [^String work roots sample ids]
  (let [man (read-string (slurp corpora-file))]
    (doseq [id ids]
      (let [corpus (or (first (filter #(= (:id %) (keyword id)) (:corpora man)))
                       (throw (ex-info (str "no corpus " id) {})))
            dir (str (get roots (:root (:where corpus))) "/" (:path (:where corpus)))
            dir (str/replace dir #"/$" "")
            all (cpc/corpus-files corpus dir)
            ;; review 007's finding 10: a tree with another number of files than the manifest's (a partial extraction, another
            ;; tree) is refused, sampled or not
            _ (when (and (:count corpus) (not= (long (:count corpus)) (count all)))
                (throw (ex-info (str id ": the tree " dir " has " (count all) " files, the manifest counts " (:count corpus)
                                     " (a partial extraction?)") {})))
            only (when (map? sample) (only-names (:only sample) id))
            _ (when-let [bad (seq (remove (set all) only))]
                (throw (ex-info (str id ": --only names files the corpus does not have: " (str/join " " (take 5 bad))) {})))
            files (if (map? sample) (vec (filter (set only) all)) (shard-of all sample))
            corpus (assoc corpus :absolute (or (:absolute corpus) (= (:root (:where corpus)) :gcc-15.2.0)))
            subst (fn [as] (mapv (fn [^String a] (reduce-kv (fn [a k v] (str/replace a (str "{" (name k) "}") (str v))) a roots)) as))
            corpus (update (update corpus :cxx-args subst) :cxx-args-for (fn [fs] (mapv #(update % :args subst) fs)))
            corpus (update corpus :clang-args (fn [as] (mapv (fn [^String a] (reduce-kv (fn [a k v] (str/replace a (str "{" (name k) "}") (str v))) a roots)) as)))
            entries (mapv #(file-entry corpus dir %) files)
            d (str work "/" id)]
        (.mkdirs (java.io.File. d))
        (spit (str d "/base.txt") dir)
        (spit (str d "/files.edn") (pr-str entries))
        ;; NAME, STD, ARGS, FILE as the compilers are given them (the fields separated by tabs)
        (spit (str d "/gxx.list")
              (str/join (for [e entries]
                          (str (:name e) "\t" (:std (:fc e)) "\t" (str/join " " (:all-args (:fc e))) "\t" (:read e) "\t" (str/join " " (:args (:fc e))) "\n"))))
        ;; re-review 032's F4: the same list under a header naming its corpus for the round trip's oracle record (the key of
        ;; test/repr/cpp/roundtrip-oracle.edn: the id, every Nth file or all)
        (spit (str d "/roundtrip.list")
              (str "#list " id (cond (map? sample) (str "-" (:key sample "only"))
                                     (and sample (> (long sample) 1)) (str "-every-" sample)
                                     :else "-all")
                   "\n" (slurp (str d "/gxx.list"))))
        (let [m (java.io.File. (str d "/subset.txt"))]
          (if (map? sample) (spit m (str (:only sample) "\n")) (.delete m)))
        (println (str id ": " (count files) " files" (when (> (count all) (count files)) (str " of " (count all)))))))))

;; ---------------------------------------------------------------------------------------------
;; The judges' texts

(defn tokens-digest [texts] (cpc/tokens-digest texts))

(defn- ud-split
  "A user-defined literal token's texts, the literal and its suffix (the compilers' output lets them touch)."
  [^Tok t]
  (let [^String s (.-src t)
        q (long (.lastIndexOf s (if (= (.-ch t) :UDLSTRING) 34 39)))]
    [(subs s 0 (inc q)) (cpc/norm-ident (subs s (inc q)))]))

(defn port-texts
  "The texts of the port's stream's tokens, identifiers in gcc's spelling, user-defined literals as literal and suffix."
  [r]
  (mapcat (fn [^Tok t]
            (cond
              (#{\space \newline} (.-ch t)) nil
              (#{:UDLSTRING :UDLCHAR} (.-ch t)) (ud-split t)
              (= (.-ch t) :IDENTIFIER) [(cpc/norm-ident (.-src t))]
              :else [(.-src t)]))
          (:tokens r)))

(defn unplaced
  "CX10: the texts with the corpus' directory BASE written {base}: a file read by its absolute name (the corpora read in place
  from gcc's tarball, :absolute) expands __FILE__ (assert's message) to a string of the checkout's path, which the recorded
  digests must not hold (CX2's held /root/arbace/.tmp/worktrees/cpp-cx2/..., so 9 files of g++.dg's tenth failed in every
  other checkout and in the gate's clean clone)."
  [texts ^String base]
  (if (str/blank? base)
    texts
    (map (fn [^String t] (if (str/includes? t base) (str/replace t base "{base}") t)) texts)))

(defn gxx-texts
  "The tokens of g++ -E -P's output `text` (lexed in C++ mode, `mask`, but without user-defined literals,
  which g++'s output lets touch their suffix): its directive lines (#pragma ...) dropped."
  [^String text mask]
  (let [f (lex/new-file "gxx" (.getBytes text "ISO-8859-1"))
        [ts _] (lex/tokens f (bit-and (long mask) (bit-not lex/F-UDL)))
        out (java.util.ArrayList.)]
    (loop [ts (seq ts) bol true]
      (when ts
        (let [^Tok t (first ts)]
          (cond
            (= (.-ch t) \newline) (recur (next ts) true)
            (and bol (= (.-ch t) \#) (zero? (.length ^String (.-sep t))))
            (let [line (take-while #(not= (.-ch ^Tok %) \newline) (next ts))]
              ;; #embed lines (-P keeps the resource as __base64__ strings): the integers they stand for, as C's check reads them
              (when (and (seq line) (= (.-src ^Tok (first line)) "embed"))
                (let [strs (loop [xs (drop-while #(not= (.-src ^Tok %) "__base64__") line) acc []]
                             (if-let [^Tok x (first xs)]
                               (recur (next xs) (if (#{:STRINGLITERAL} (.-ch x)) (conj acc (let [q (.-src x)] (subs q 1 (dec (count q))))) acc))
                               acc))
                      bs (when (seq strs) (.decode (java.util.Base64/getDecoder) ^String (apply str strs)))]
                  (when bs
                    (doseq [[i b] (map-indexed vector bs)]
                      (when (pos? i) (.add out ","))
                      (.add out (str (bit-and (long b) 0xff)))))))
              (recur (drop (count line) (next ts)) true))
            :else (do (.add out (if (= (.-ch t) :IDENTIFIER) (cpc/norm-ident (.-src t)) (.-src t)))
                      (recur (next ts) false))))))
    (vec out)))

(defn raw-lines
  "The raw tokens of `bytes` as the lexer scans them (no header names, no comments or new-lines), a line
  `LINE:COL<tab>TEXT` each: what clang's -dump-raw-tokens gives, normalized."
  [^bytes bs mask]
  (let [f (lex/new-file "raw" bs)
        s (lex/scanner f (fn [_] nil) mask)]
    (loop [acc (transient [])]
      (let [^Tok t (lex/scan0 s)]
        (cond
          (= (.-ch t) :eof) (persistent! acc)
          (= (.-ch t) \newline) (recur acc)
          :else (let [;; clang places a token at the line splices that touch it from the left
                      po (loop [o (.-po t)]
                           (cond
                             (and (>= o 2) (= (aget bs (dec o)) 10) (= (aget bs (- o 2)) 92)) (recur (- o 2))
                             (and (>= o 3) (= (aget bs (dec o)) 10) (= (aget bs (- o 2)) 13) (= (aget bs (- o 3)) 92)) (recur (- o 3))
                             :else o))
                      [_ l c] (lex/position f po)]
                  (recur (conj! acc (str l ":" c "\t" (-> ^String (.-src t) (.replace "\\\n" "") (.replace "\\\r\n" "")))))))))))

(defn- unescape
  "clang's escaping of a token's text (\\\" \\\\ \\n \\t and octal bytes) undone."
  ^String [^String s]
  (if (neg? (.indexOf s "\\"))
    s
    (let [b (StringBuilder.) n (.length s)]
      (loop [i 0]
        (when (< i n)
          (let [c (.charAt s i)]
            (if (and (= c \\) (< (inc i) n))
              (let [d (.charAt s (inc i))]
                (cond
                  (and (>= (int d) 48) (<= (int d) 55) (<= (+ i 4) n))
                  (do (.append b (char (Long/parseLong (subs s (inc i) (+ i 4)) 8))) (recur (+ i 4)))
                  :else (do (.append b (case d \n \newline \t \tab \r \return \a (char 7) \b (char 8) \f (char 12) \v (char 11) d))
                            (recur (+ i 2)))))
              (do (.append b c) (recur (inc i)))))))
      (.toString b))))

(defn clang-lines
  "The raw tokens of clang's `-Xclang -dump-raw-tokens` output `text`, as raw-lines gives theirs: comments,
  white space and the end-of-file token left out, splices taken out of the texts."
  [^String text]
  (vec (for [[_ kind t line col] (re-seq #"(?m)^([a-z_0-9]+) +'((?:.|\n)*?)' +Loc=<[^>]*?:(\d+):(\d+)>" text)
             :let [t (-> ^String (unescape t) (.replace "\\\n" "") (.replace "\\\r\n" ""))]
             :when (not (or (= kind "comment") (= kind "eof")
                            (and (= kind "unknown") (str/blank? t))))]
         (str line ":" col "\t" t))))

(defn lines-digest [lines] (tokens-digest lines))

;; ---------------------------------------------------------------------------------------------
;; The recorded answers

(defn- load-db [^String file]
  (let [f (java.io.File. file)]
    (if (.exists f)
      (into {} (for [l (str/split-lines (slurp f)) :when (seq l)
                     :let [i (.indexOf ^String l "  ")]]
                 [(subs l (+ i 2)) (let [d (subs l 0 i)] (if (= d "rejected") :rejected d))]))
      {})))

(defn- read-or-nil ^String [^String p] (let [f (java.io.File. p)] (when (.exists f) (slurp-latin1 p))))

(defn- status-of [^String d ^String path]
  (str/trim (or (read-or-nil (str d "/" path ".status")) "?")))

(defn gxx-digest
  "g++ -E's digest of a file of WORK/ID (WORK/ID/gxx/NAME.i and .status): :rejected, a digest, or nil when g++ did not run."
  [^String d ^String nm mask]
  (let [g (read-or-nil (str d "/gxx/" nm ".i"))]
    (cond (nil? g) nil
          (not= (status-of d (str "gxx/" nm)) "0") :rejected
          :else (tokens-digest (unplaced (gxx-texts g mask) (str/trim (or (read-or-nil (str d "/base.txt")) "")))))))

(defn clang-digest
  "clang's raw tokens' digest of a file of WORK/ID (WORK/ID/clang/NAME.raw), :rejected when clang did not run, nil when absent."
  [^String d ^String nm]
  (let [g (read-or-nil (str d "/clang/" nm ".raw"))]
    (cond (nil? g) nil
          (not= (status-of d (str "clang/" nm)) "0") :rejected
          :else (lines-digest (clang-lines g)))))

;; ---------------------------------------------------------------------------------------------
;; The reference (doc/cpp/CPP-SURVEY.md, "As built: pp-ref"; CP413 (a), CP414 (a), the user's of 2026-11-20): GCC 15.2.0's
;; libcpp, unmodified from the pinned gcc-15.2.0 tarball, behind Arbace's own harness tools/ppref (bin/repr-cpp ppref build),
;; run over the corpus at check time with the target the port reads (the predefined macros of each file's configuration, the
;; __has_ table, the search list under the sysroot). REPR_CPP_PP_JUDGE=own judges each file by its runs; records (the default
;; until the reference is built by Arbace alone) by g++ -E's and clang's recorded digests, then the oracle tier's.

(defn judge-mode
  "The token check's judge: \"own\" (the reference run at check time) or \"records\" (pp-gxx.sha256, lex-clang.sha256)."
  ^String []
  (let [m (or (System/getenv "REPR_CPP_PP_JUDGE") "records")]
    (when-not (#{"own" "records"} m) (throw (ex-info (str "REPR_CPP_PP_JUDGE is own or records, not " m) {})))
    m))

(defn- sha256-hex ^String [^String s]
  (let [md (java.security.MessageDigest/getInstance "SHA-256")]
    (apply str (map #(format "%02x" (bit-and (long %) 0xff)) (.digest md (.getBytes s "ISO-8859-1"))))))

(defn ref-lists
  "The reference's runs of the corpora `ids` under WORK: WORK/ref.args (the options every run shares: the __has_ table
  WORK/ref/has.tsv, the search list, the sysroot, the epoch, a word a line), WORK/ID/ref.pp.list and ref.lex.list (OUT, then the
  run's words: --predef FILE, -std=STD, the options the reference is given, the file as g++ reads it; tab-separated), the
  predefined macros of each configuration in WORK/ref/predef/SHA.h (the port's: host/config's :predefined)."
  [^String work ids]
  (let [h (host/load-host (host/gxx-dir) "gxx")
        sysroot (System/getenv "ARBACE_C_SYSROOT")
        rd (str work "/ref")]
    (.mkdirs (java.io.File. (str rd "/predef")))
    (spit (str rd "/has.tsv") (str/join (for [[[op nm] v] (sort-by (comp str key) (:has h))] (str op "\t" nm "\t" v "\n"))))
    (spit (str work "/ref.args")
          (str/join "\n" (concat ["--has" (str rd "/has.tsv") "--epoch" (str (:epoch h))]
                                 (when (and sysroot (not= sysroot "") (not= sysroot "/")) ["--sysroot" sysroot])
                                 (mapcat (fn [d] ["--sys" d]) (:search h))
                                 [""])))
    (doseq [id ids]
      (let [d (str work "/" id)
            base (str/trim (slurp (str d "/base.txt")))
            entries (read-string (slurp (str d "/files.edn")))
            lines (for [e entries]
                    (let [cfg (host/config h (:fc e) base)
                          pre (:predefined cfg)
                          pf (str rd "/predef/" (subs (sha256-hex pre) 0 16) ".h")
                          _ (when-not (.exists (java.io.File. pf)) (spit pf pre))
                          words (concat ["--predef" pf (str "-std=" (:std (:fc e)))] (:all-args (:fc e)) [(:read e)])]
                      [(:name e) words]))
            out (fn [kind] (str/join (for [[nm words] lines]
                                       (let [o (str d "/ref/" nm "." kind)]
                                         (.mkdirs (.getParentFile (java.io.File. o)))
                                         (str (str/join "\t" (cons o words)) "\n")))))]
        (spit (str d "/ref.pp.list") (out "pp"))
        (spit (str d "/ref.lex.list") (out "lex"))
        (println (str id ": the reference's lists, " (count lines) " files"))))))

(defn ref-records
  "A reference output's records (tools/ppref's `KLEN TEXT` lines): [[kind text] ...], nil when the file is absent."
  [^String path]
  (when-let [s (read-or-nil path)]
    (let [n (.length ^String s)]
      (loop [i 0 acc (transient [])]
        (if (>= i n)
          (persistent! acc)
          (let [k (.charAt ^String s i)
                sp (.indexOf ^String s " " (int (inc i)))
                len (Long/parseLong (subs s (inc i) sp))
                t (subs s (inc sp) (+ (inc sp) len))]
            (recur (+ (inc sp) len 1) (conj! acc [k t]))))))))

(defn ref-pp-digest
  "The reference's digest of a file's stream (WORK/ID/ref/NAME.pp and .pp.status): :rejected when it reported an error, nil
  when it did not run (or crashed: no status), else the digest of its tokens' texts as the port's (identifiers in gcc -E's
  spelling, the corpus's directory written {base})."
  [^String d ^String nm ^String base]
  (let [st (str/trim (or (read-or-nil (str d "/ref/" nm ".pp.status")) ""))]
    (cond (= st "") nil
          (not= st "0") (if (#{"1"} st) :rejected nil)
          :else (when-let [rs (ref-records (str d "/ref/" nm ".pp"))]
                  (tokens-digest (unplaced (map (fn [[k t]] (if (= k \i) (cpc/norm-ident t) t)) rs) base))))))

(defn ref-lex-digest
  "The reference's raw tokens' digest of a file (WORK/ID/ref/NAME.lex), as raw-lines' (LINE:COL<tab>TEXT), nil when absent."
  [^String d ^String nm]
  (let [st (str/trim (or (read-or-nil (str d "/ref/" nm ".lex.status")) ""))]
    (when (= st "0")
      (when-let [rs (ref-records (str d "/ref/" nm ".lex"))]
        (lines-digest (map second rs))))))

;; ---------------------------------------------------------------------------------------------
;; The check

(defn- judge
  "The reference's judgment: agree, both-reject, clang-tokens (CP261 (a): g++ -E is no reference for the file and clang's raw
  tokens are the port's, `by-clang`), known, unrecorded, differ."
  ([rec mine known? errors?] (judge rec mine known? errors? false))
  ([rec mine known? errors? by-clang]
   (cond (nil? rec) "unrecorded"
         (= rec mine) "agree"
         (and (= rec :rejected) errors?) "both-reject"
         by-clang "clang-tokens"
         known? "known"
         :else "differ")))

(defn- other-target?
  "A file whose options name another target than the host's (-march=, -mcpu= ...): g++'s rejection is the option's (the class
  :target-option, not applicable, CP260 (a)), not the file's."
  [^String text] (boolean (re-find #"-march=|-mcpu=|-mtune=|-m(32|x32|avx|sse)" text)))

(defn gxx-no-reference?
  "CP261 (a) (the user, 2026-11-08): g++ -E is no reference for the file's stream when it refuses a file the port reads without
  an error (a pedantic error, an option or a character set it refuses, a header unit: the class gxx-rejects; not an option for
  another target) or when the file is read under -fmodules-ts, where g++ -E looks the imported modules up and rewrites the
  import directives (modules-ts). Such a file's stream is judged by clang's recorded raw tokens alone."
  [rec errors? modules? ^String text]
  (boolean (and (not errors?)
                (or modules? (and (= rec :rejected) (not (other-target? text)))))))

(defn clang-tokens?
  "CP261 (a): the port's raw tokens' digest `lex-dg` is clang's recorded one `crec` (a digest, not a rejection)."
  [crec lex-dg] (boolean (and (string? crec) lex-dg (= crec lex-dg))))

(defn check-file
  "One file: [name lex-status pp-status port-digest detail]. In the own mode (judge-mode) the reference's runs (WORK/ID/ref/)
  stand where the records' digests stood: the stream against the reference's (agree, both-reject), and where g++ -E is no reference
  (CP261 (a)) against its raw tokens (ref-tokens)."
  [^String work ^String id host ^String base levels e gxx-db clang-db known-pp known-lex]
  (let [nm (:name e)
        d (str work "/" id)
        own? (= "own" (judge-mode))
        cfg (assoc (host/config host (:fc e) base) :missing (:missing host))
        mask (long (:trigraphs cfg))
        key (str id "/" nm)
        gxx-db (if own? {key (ref-pp-digest d nm base)} gxx-db)
        clang-db (if own? {key (ref-lex-digest d nm)} clang-db)
        lex-dg (when (levels "lex")
                 (lines-digest (try (raw-lines (lex/read-bytes (str base "/" nm)) mask) (catch Throwable x [(str "#panic " x)]))))
        lex-st (when lex-dg (judge (get clang-db key) lex-dg (contains? known-lex nm) false))
        [pp-st dg pp-err]
        (when (levels "pp")
          (let [r (try (pp/preprocess cfg (:read e)) (catch Throwable x {:tokens [] :errors [(str x)] :panic true :crash (str x)}))
                dg (tokens-digest (unplaced (port-texts r) base))
                rec (get gxx-db key)
                ;; CP261 (a): where g++ -E is no reference, clang's raw tokens (the lex level's digest, computed for this
                ;; even when the lex level is not run)
                by-clang (and (gxx-no-reference? rec (seq (:errors r)) (:modules (:fc e)) (slurp-latin1 (str base "/" nm)))
                              (clang-tokens? (get clang-db key)
                                             (or lex-dg (lines-digest (try (raw-lines (lex/read-bytes (str base "/" nm)) mask)
                                                                           (catch Throwable x [(str "#panic " x)]))))))
                _ (let [^java.io.File o (java.io.File. (str d "/port/" nm ".txt"))]
                    (.mkdirs (.getParentFile o))
                    (spit o (str (str/join "\n" (port-texts r)) "\n" (str/join "\n" (map #(str "#error " %) (:errors r))) "\n")))
                st (if (:crash r)
                     "crash"
                     (judge rec dg (contains? known-pp nm) (seq (:errors r)) by-clang))]
            [(if (and own? (= st "clang-tokens")) "ref-tokens" st) dg (boolean (seq (:errors r)))]))]
    ;; the fifth and sixth: the lex digest and whether the port gave errors, for the negative controls (not in files.tsv)
    [nm (or lex-st "-") (or pp-st "-") (or dg "-") (or lex-dg "-") pp-err]))

(def controls-file "test/cpp/controls.edn")

(defn controls
  "The token check's negative controls (doc/GATE-SURVEY.md, GTS81 (a); test/cpp/controls.edn's :level :pp and :lex entries, cpp-90): the
  :subject's port, judged by the level's own judgment against the :reference's recorded answer (g++ -E's digest at :pp, clang's raw tokens'
  at :lex), must not agree. A control whose subject is not a file of this run of the corpus `id`, or whose reference has no recorded
  answer, is left (said); one that agrees is printed and returned (the check fails). The names are CORPUS/NAME."
  [^String id rs gxx-db clang-db levels & [^String work]]
  (let [cs (filter #(contains? #{:pp :lex :pp-clang} (:level %)) (if (.exists (java.io.File. ^String controls-file)) (read-string (slurp controls-file)) []))
        ;; the own mode: the reference's answers are its runs of the reference file (when that file's corpus ran)
        [gxx-db clang-db] (if (and work (= "own" (judge-mode)))
                            (let [ks (distinct (mapcat (juxt :subject :reference) cs))
                                  at (fn [k] (let [i (.indexOf ^String k "/") c (subs k 0 i) n (subs k (inc i)) d (str work "/" c)
                                                   b (str/trim (or (read-or-nil (str d "/base.txt")) ""))]
                                               [d n b]))]
                              [(into {} (for [k ks :let [[d n b] (at k) v (ref-pp-digest d n b)] :when v] [k v]))
                               (into {} (for [k ks :let [[d n _] (at k) v (ref-lex-digest d n)] :when v] [k v]))])
                            [gxx-db clang-db])
        by (into {} (map (juxt first identity) rs))
        pre (str id "/")]
    (vec (for [{cid :id :keys [level subject reference]} cs
               :when (str/starts-with? subject pre)
               :let [row (get by (subs subject (count pre)))
                     lv (if (= level :pp-clang) "lex" (name level))
                     rec (get (if (= level :pp) gxx-db clang-db) reference)
                     v (when (and row (levels lv) rec)
                         (case level
                           :pp (judge rec (nth row 3) false (nth row 5))
                           ;; CP261 (a)'s rule: the subject's stream judged by clang's tokens, the reference's raw tokens in its place
                           ;; the own mode: the reference reads the subject (its stream agrees), so the path is taken as where g++ -E
                           ;; is no reference, the subject's record :rejected (pp-ref)
                           :pp-clang (judge (if (and work (= "own" (judge-mode))) :rejected (get gxx-db subject)) (nth row 3) false (nth row 5)
                                            (clang-tokens? rec (nth row 4)))
                           (judge rec (nth row 4) false false)))]
               :when (cond (nil? row) false
                           (nil? v) (do (println (str "control " cid " left: " (if rec "the level not run" (str "no recorded answer for " reference)))) false)
                           (= v "differ") (do (println (str "control " cid " fails as it must (" lv ": " subject " against " reference "'s record)")) false)
                           :else (do (println (str "control " cid " passed (" lv ": " v "): the judgment takes what differs")) true))]
           cid))))

(defn check
  "The check of the corpus `id` under WORK (its lists made, the compilers run): WORK/ID/files.tsv (name, lex
  status, pp status, the port's digest), report.edn; its summary line printed. 0 when no file fails."
  [^String work ^String id levels]
  (let [d (str work "/" id)
        base (str/trim (slurp (str d "/base.txt")))
        entries (read-string (slurp (str d "/files.edn")))
        known-all (read-string (slurp known-file))
        own? (= "own" (judge-mode))
        ;; the own mode's known entries (pp-ref): the files whose port's answers are not the reference's, each with its class
        known-pp (get-in known-all [(if own? :pp-own :pp) (keyword id)] {})
        known-lex (get-in known-all [(if own? :lex-own :lex) (keyword id)] {})
        missing (java.util.concurrent.ConcurrentHashMap/newKeySet)
        h (assoc (host/load-host (host/gxx-dir) "gxx") :missing missing)
        gxx-db (load-db gxx-file)
        clang-db (load-db clang-file)
        threads (Integer/parseInt (or (System/getenv "REPR_CPP_THREADS") "4"))
        pool (Executors/newFixedThreadPool threads)
        t0 (System/nanoTime)
        futs (mapv (fn [e] (.submit pool ^Callable (fn [] (check-file work id h base levels e gxx-db clang-db known-pp known-lex)))) entries)
        rs (mapv #(.get ^java.util.concurrent.Future %) futs)
        secs (/ (- (System/nanoTime) t0) 1e9)
        _ (.shutdown pool)
        by (fn [i] (frequencies (map #(nth % i) rs)))
        bad #{"differ" "unrecorded" "crash"}
        lex-fail (filter #(bad (nth % 1)) rs)
        pp-fail (filter #(bad (nth % 2)) rs)
        ;; review 007's finding 10: a recorded digest whose file is not in the tree (a shrunken corpus) fails
        vanished (sort (for [db [gxx-db clang-db] [k _] db
                             :when (str/starts-with? k (str id "/"))
                             :let [nm (subs k (inc (count id)))]
                             :when (not (.exists (java.io.File. (str base "/" nm))))]
                         nm))
        vanished (vec (distinct vanished))
        ;; CX10: a subset's run (--only, WORK/ID/subset.txt) holds the known entries of its own files alone
        in-run? (if (.exists (java.io.File. (str d "/subset.txt"))) (set (map :name entries)) (constantly true))
        stale (concat (for [[nm _] known-pp :when (in-run? nm) :when (not (some (fn [r] (and (= (first r) nm) (= (nth r 2) "known"))) rs))] [:pp nm])
                      (for [[nm _] known-lex :when (in-run? nm) :when (not (some (fn [r] (and (= (first r) nm) (= (nth r 1) "known"))) rs))] [:lex nm]))
        bytes (reduce + (map #(.length (java.io.File. (str base "/" (:name %)))) entries))]
    (spit (str d "/files.tsv") (str/join (map #(str (str/join "\t" (take 4 %)) "\n") rs)))
    (spit (str d "/differ.txt") (str/join (map #(str (first %) "\tlex " (nth % 1) "\tpp " (nth % 2) "\n") (distinct (concat lex-fail pp-fail)))))
    (spit (str d "/missing.tsv") (str/join (map #(str (first %) "\t" (second %) "\n") (sort missing))))
    (let [cfail (controls id rs gxx-db clang-db levels work)
          report {:corpus id :files (count rs) :bytes bytes :seconds (Math/round (double secs)) :threads threads
                  :lex (by 1) :pp (by 2) :lex-failing (count lex-fail) :pp-failing (count pp-fail)
                  :stale-known (vec stale) :missing-has (count missing) :vanished (count vanished)}]
      (spit (str d "/report.edn") (pr-str report))
      (println (str id ": " (count rs) " files, lex " (pr-str (by 1)) ", pp " (pr-str (by 2)) ", " (Math/round (double secs)) " s"
                    (when (seq lex-fail) (str "; " (count lex-fail) " lex files failing: " (str/join " " (map first (take 5 lex-fail)))))
                    (when (seq pp-fail) (str "; " (count pp-fail) " pp files failing: " (str/join " " (map first (take 5 pp-fail)))))
                    (when (seq stale) (str "; " (count stale) " known entries stale"))
                    (when (seq vanished) (str "; " (count vanished) " recorded files not in the tree: " (str/join " " (take 5 vanished))))
                    (when (seq missing) (str "; " (count missing) " __has answers not recorded"))))
      (if (or (seq lex-fail) (seq pp-fail) (seq stale) (seq vanished) (seq cfail)) 1 0))))

;; ---------------------------------------------------------------------------------------------
;; Recording

(defn- write-db [^String file db]
  (spit file (str/join (for [[k g] (sort-by first db)] (str (if (= g :rejected) "rejected" g) "  " k "\n")))))

(defn record-deltas
  "Merges the option lists' deltas the recorder computed (WORK/ID/opts/N.key and N.delta) into
  test/cpp/host/opt-deltas-gxx.edn."
  [^String work ids]
  (let [file "test/cpp/host/opt-deltas-gxx.edn"
        old (let [^java.io.File f (java.io.File. file)] (if (.exists f) (read-string (slurp f)) {}))
        new (into {} (for [id ids
                           :let [^java.io.File dir (java.io.File. (str work "/" id "/opts"))]
                           ^java.io.File k (or (seq (.listFiles dir)) [])
                           :when (.endsWith (.getName k) ".key")
                           :let [dp (str (subs (.getPath k) 0 (- (count (.getPath k)) 4)) ".delta")]
                           :when (.exists (java.io.File. ^String dp))]
                       [(str/trim (slurp-latin1 (.getPath k))) (slurp-latin1 dp)]))
        all (merge old new)]
    (spit file (str ";; The effect of g++'s options on its predefined macros (bin/repr-cpp pp-check --record): for a standard and the\n"
                    ";; options the reference is given (a file's dg-options but the ones that write files), the lines added to\n"
                    ";; test/cpp/host/predefined/gxx/STD.h (#define, and #undef of what the options remove). Read with the Clojure reader.\n"
                    "{" (str/join "\n " (for [[k v] (sort all)] (str (pr-str k) " " (pr-str v)))) "}\n"))
    (println (str "recorded " file ": " (count all) " option lists (" (count new) " this run)"))))

(defn record
  "Rewrites the recorded answers of the corpora `ids` from the compilers' runs under WORK: g++'s digests
  (pp-gxx.sha256) and clang's raw-token digests (lex-clang.sha256), the other corpora's lines kept."
  [^String work ids]
  (let [man (read-string (slurp corpora-file))
        ids (vec ids)
        idset (set ids)
        keep-other (fn [db] (into {} (remove (fn [[k _]] (idset (subs k 0 (.indexOf ^String k "/")))) db)))
        gxx (keep-other (load-db gxx-file))
        clang (keep-other (load-db clang-file))
        pool (Executors/newFixedThreadPool (Integer/parseInt (or (System/getenv "REPR_CPP_THREADS") "4")))
        rows (for [id ids
                   :let [d (str work "/" id)
                         entries (read-string (slurp (str d "/files.edn")))]
                   e entries]
               (let [mask (host/feature-mask (:std (:fc e)) (:trigraphs (:fc e)) (:modules (:fc e)))]
                 [(str id "/" (:name e))
                  (.submit pool ^Callable (fn [] (gxx-digest d (:name e) mask)))
                  (.submit pool ^Callable (fn [] (clang-digest d (:name e))))]))
        rows (doall rows)
        res (doall (for [[k g c] rows] [k (.get ^java.util.concurrent.Future g) (.get ^java.util.concurrent.Future c)]))
        _ (.shutdown pool)
        gxx (into gxx (for [[k g _] res :when g] [k g]))
        clang (into clang (for [[k _ c] res :when c] [k c]))]
    (write-db gxx-file gxx)
    (write-db clang-file clang)
    (record-deltas work ids)
    (println (str "recorded " gxx-file ": " (count gxx) " files, " clang-file ": " (count clang) " files"))))

(defn classify
  "A difference's class from the file's text and the compilers' statuses: the feature that explains it."
  [^String path ^String what ^String d ^String nm]
  (let [s (slurp-latin1 path)]
    (cond
      (re-find #"fmodules" s) :modules-ts
      (re-find #"#\s*embed|__has_embed" s) :embed
      (other-target? s) :target-option
      (and (= what "pp") (not= (status-of d (str "gxx/" nm)) "0")) :gxx-rejects
      (re-find #"(?m)^\s*(export\s+)?(import|module)\b" s) :modules
      (re-find #"__has_cpp_attribute|__has_attribute|__has_builtin|__has_include" s) :has-answer
      (re-find #"R\"[^(\s]*\(" s) :raw-string
      (re-find #"[\"'][A-Za-z_]" s) :udl
      (re-find #"\?\?[=(/)'<!>-]" s) :trigraphs
      (re-find #"\bGCC (poison|pch)" s) :pragma
      :else :unclassified)))

(declare write-known)

(defn record-known
  "Rewrites the known file's entries of the corpora `ids` from WORK/ID/files.tsv: each file whose lex or pp status is
  differ or unrecorded-with-a-recorded-peer is listed with its class (the old class kept, else `classify`'s)."
  [^String work ids]
  (let [known (read-string (slurp known-file))
        known (reduce
                (fn [known id]
                  (let [d (str work "/" id)
                        base (str/trim (slurp (str d "/base.txt")))
                        rows (map #(str/split % #"\t") (str/split-lines (slurp (str d "/files.tsv"))))
                        entries (fn [level idx]
                                  (let [old (get-in known [level (keyword id)] {})]
                                    (into (sorted-map)
                                          (keep (fn [r] (when (#{"differ" "known"} (nth r idx))
                                                          [(first r) {:class (or (:class (get old (first r)))
                                                                                 (classify (str base "/" (first r)) (name level) d (first r)))}])))
                                          rows)))]
                    (if (= "own" (judge-mode))
                      (-> known
                          (assoc-in [:pp-own (keyword id)] (entries :pp-own 2))
                          (assoc-in [:lex-own (keyword id)] (entries :lex-own 1)))
                      (-> known
                          (assoc-in [:pp (keyword id)] (entries :pp 2))
                          (assoc-in [:lex (keyword id)] (entries :lex 1))))))
                known ids)]
    (write-known known)
    (println "recorded" known-file)))

(defn write-known
  "The known file written from `known` (its sections in order, the classes first)."
  [known]
    (spit known-file
          (str ";; The files of the C++ token check (bin/repr-cpp pp-check; doc/cpp/CPP-SURVEY.md, \"As built: CX2\") whose answers\n"
               ";; are not the compilers': at :pp the stream's tokens are not g++ -E -P's (test/repr/cpp/pp-gxx.sha256), at :lex the\n"
               ";; raw tokens are not clang's (test/repr/cpp/lex-clang.sha256), each with its class. Written by\n"
               ";; bin/repr-cpp pp-check --record-known, the classes kept. Read with the Clojure reader.\n"
               ";; Since pp-ref (doc/cpp/CPP-SURVEY.md, \"As built: pp-ref\"): :pp-own and :lex-own, the files whose answers are not the own\n"
               ";; reference's (REPR_CPP_PP_JUDGE=own: GCC 15.2.0's libcpp behind tools/ppref), each with its class; :ref, the reference's\n"
               ";; answers that are not the records' (bin/repr-cpp pp-check --fidelity, the oracle tier's), each with its level and class.\n"
               "{:classes\n {" (str/join "\n  " (for [[k v] (sort-by key (:classes known))] (str k " " (pr-str v)))) "}\n"
               (str/join "\n"
                 (for [level [:pp :lex :pp-own :lex-own :ref] :when (or (#{:pp :lex} level) (contains? known level))]
                   (str " " level "\n {"
                        (str/join "\n  "
                                  (for [[k v] (sort (get known level)) :when (seq v)]
                                    (str k "\n  {" (str/join "\n   " (map (fn [[f e]] (str (pr-str f) " " (pr-str e))) v)) "}")))
                        "}")))
               "}\n")))

(defn known-add
  "bin/repr-cpp pp-known-add FILE: the sections and classes of FILE (a map read with the Clojure reader: {:classes {...} LEVEL
  {CORPUS {NAME ENTRY}}}) merged into the known file, entry by entry."
  [^String f]
  (let [add (read-string (slurp f))
        known (read-string (slurp known-file))
        known (reduce-kv (fn [k level m]
                           (if (= level :classes)
                             (update k :classes merge m)
                             (reduce-kv (fn [k c es] (update-in k [level c] merge es)) k m)))
                         known add)]
    (write-known known)
    (println "merged" f "into" known-file)))

;; ---------------------------------------------------------------------------------------------
;; The reference's fidelity (the oracle tier's): its runs against g++ -E's and clang's recorded digests

(defn fidelity
  "The reference's runs of the corpora `ids` under WORK against the recorded digests (pp-gxx.sha256, lex-clang.sha256), file by
  file: WORK/ID/fidelity.tsv (NAME, pp: equal, both-reject, differ, unrecorded or no-run, lex likewise), a summary line a corpus.
  A difference is accounted for by the known file's :ref section ({CORPUS {NAME {:level :pp|:lex :class K}}}); 1 when one is not."
  [^String work ids]
  (let [gxx-db (load-db gxx-file)
        clang-db (load-db clang-file)
        known (get (read-string (slurp known-file)) :ref {})
        bad (atom 0)]
    (doseq [id ids]
      (let [d (str work "/" id)
            base (str/trim (slurp (str d "/base.txt")))
            entries (read-string (slurp (str d "/files.edn")))
            kn (get known (keyword id) {})
            v (fn [rec mine] (cond (nil? mine) "no-run" (nil? rec) "unrecorded" (= rec mine) (if (= rec :rejected) "both-reject" "equal")
                                   (= rec :rejected) "gxx-rejects" (= mine :rejected) "ref-rejects" :else "differ"))
            rows (vec (for [e entries
                            :let [nm (:name e) k (str id "/" nm)]]
                        [nm (v (get gxx-db k) (ref-pp-digest d nm base)) (v (get clang-db k) (ref-lex-digest d nm))]))
            off (fn [[nm pp lx]] (let [c (get kn nm)]
                                   (or (and (not (#{"equal" "both-reject"} pp)) (not= :pp (:level c)) (not= :both (:level c)))
                                       (and (not= "equal" lx) (not= :lex (:level c)) (not= :both (:level c))))))
            unexplained (filter off rows)]
        (spit (str d "/fidelity.tsv") (str/join (map #(str (str/join "\t" %) "\n") rows)))
        (swap! bad + (count unexplained))
        (println (str id ": the reference against the records, " (count rows) " files: pp " (pr-str (frequencies (map second rows)))
                      ", lex " (pr-str (frequencies (map #(nth % 2) rows)))
                      (when (seq unexplained) (str "; " (count unexplained) " not in the known file's :ref: "
                                                   (str/join " " (map first (take 8 unexplained)))))))))
    (if (pos? (long @bad)) 1 0)))

(defn ref-diff-main
  "bin/repr-cpp pp-diff --ref: the first difference between the reference's stream and the port's of a file of WORK/ID."
  [work id nm]
  (let [d (str work "/" id)
        e (first (filter #(= (:name %) nm) (read-string (slurp (str d "/files.edn")))))
        base (str/trim (slurp (str d "/base.txt")))
        g (vec (unplaced (map (fn [[k t]] (if (= k \i) (cpc/norm-ident t) t)) (ref-records (str d "/ref/" nm ".pp"))) base))
        r (pp/preprocess (host/config (host/load-host (host/gxx-dir) "gxx") (:fc e) base) (:read e))
        p (vec (unplaced (port-texts r) base))
        i (first (for [i (range (max (count g) (count p))) :when (not= (get g i) (get p i))] i))]
    (println (str nm ": reference " (count g) " tokens (status " (str/trim (or (read-or-nil (str d "/ref/" nm ".pp.status")) "?"))
                  "), port " (count p) " tokens, " (count (:errors r)) " errors"))
    (doseq [x (take 3 (:errors r))] (println "  #error" x))
    (when i
      (println "first difference at" i)
      (println " ref :" (pr-str (mapv lex/esc (subvec g (max 0 (- i 6)) (min (count g) (+ i 6))))))
      (println " port:" (pr-str (mapv lex/esc (subvec p (max 0 (- i 6)) (min (count p) (+ i 6)))))))))

;; ---------------------------------------------------------------------------------------------
;; bin/repr-cpp pp, lex

(defn- cfg-of [args]
  (let [[opts files] (split-with #(.startsWith ^String % "-") args)
        h (if (some #{"--clang"} opts) (host/load-host (host/gxx-dir) "clang") (host/load-host (host/gxx-dir) "gxx"))
        opts (vec (remove #{"--text" "--clang"} opts))
        fc (host/file-config opts host/default-std)]
    [(host/config h fc ".") files (some #{"--text"} args)]))

(defn pp-main [args]
  (let [[cfg files text?] (cfg-of args)]
    (doseq [f files]
      (let [r (pp/preprocess cfg f)]
        (print (if text? (pp/text r) (pp/dump r)))
        (doseq [w (:warnings r)] (binding [*out* *err*] (println "warning:" w)))))
    (flush)))

(defn lex-main [args]
  (let [[cfg files _] (cfg-of args)]
    (doseq [f files]
      (doseq [l (raw-lines (lex/read-bytes f) (:trigraphs cfg))] (println l)))
    (flush)))

(defn diff-main
  "bin/repr-cpp pp-diff: the first difference between g++'s tokens and the port's of a file of WORK/ID."
  [work id nm]
  (let [d (str work "/" id)
        e (first (filter #(= (:name %) nm) (read-string (slurp (str d "/files.edn")))))
        mask (host/feature-mask (:std (:fc e)) (:trigraphs (:fc e)) (:modules (:fc e)))
        base (str/trim (slurp (str d "/base.txt")))
        g (vec (unplaced (gxx-texts (or (read-or-nil (str d "/gxx/" nm ".i")) "") mask) base))
        r (pp/preprocess (host/config (host/load-host (host/gxx-dir) "gxx") (:fc e) base) (:read e))
        p (vec (unplaced (port-texts r) base))
        errs (map #(str "#error " %) (:errors r))
        n (max (count g) (count p))
        i (first (for [i (range n) :when (not= (get g i) (get p i))] i))]
    (println (str "digests: g++ " (tokens-digest g) " port " (tokens-digest p) " recorded " (get (load-db gxx-file) (str id "/" nm))))
    (println (str nm ": g++ " (count g) " tokens (status " (status-of d (str "gxx/" nm)) "), port " (count p) " tokens, " (count errs) " errors"))
    (doseq [x (take 3 errs)] (println " " x))
    (when i
      (println "first difference at" i)
      (println " g++ :" (pr-str (mapv lex/esc (subvec g (max 0 (- i 6)) (min (count g) (+ i 6))))))
      (println " port:" (pr-str (mapv lex/esc (subvec p (max 0 (- i 6)) (min (count p) (+ i 6)))))))))

(defn lexdiff-main
  "bin/repr-cpp: the first difference between clang's raw tokens and the port's of a file of WORK/ID."
  [work id nm]
  (let [d (str work "/" id)
        base (str/trim (slurp (str d "/base.txt")))
        e (first (filter #(= (:name %) nm) (read-string (slurp (str d "/files.edn")))))
        mask (host/feature-mask (:std (:fc e)) (:trigraphs (:fc e)) (:modules (:fc e)))
        c (clang-lines (or (read-or-nil (str d "/clang/" nm ".raw")) ""))
        p (raw-lines (lex/read-bytes (str base "/" nm)) mask)
        i (first (for [i (range (max (count c) (count p))) :when (not= (get c i) (get p i))] i))]
    (println (str nm ": clang " (count c) " tokens, port " (count p)))
    (when i
      (println "first difference at" i)
      (println " clang:" (pr-str (subvec c (max 0 (- i 3)) (min (count c) (+ i 4)))))
      (println " port :" (pr-str (subvec p (max 0 (- i 3)) (min (count p) (+ i 4))))))))

(defn record-results
  "CX10 (CS240 (a)'s analogue): the results of the corpora `ids` from WORK/ID/files.tsv into FILE, one row a file
  [\"CORPUS/NAME\" RESULT REASON] (bin/reap's :c-known with :id-sep \"/\"; the rotation's universe, GT8.4): :pass when every level
  checked agrees or both reject, :known when one is known, else the run's status (no record is written from a run with one);
  the other corpora's rows kept. The record is of whole corpora at their recorded sampling: a subset's run (--only) replaces the
  rows of its own files alone (cpp-props, CP261 (a): a judgment's change recorded on the files it changes), each of which the
  record must hold already (a file outside the recorded sampling refused)."
  [^String work ^String file ids]
  (let [subset? (fn [id] (.exists (java.io.File. (str work "/" id "/subset.txt"))))
        ok #{"agree" "both-reject" "clang-tokens" "ref-tokens" "-"}
        rows (vec (for [id ids
                        l (str/split-lines (slurp (str work "/" id "/files.tsv"))) :when (seq l)
                        :let [[nm lx pp] (str/split l #"\t")]]
                    [(str id "/" nm)
                     (cond (and (ok lx) (ok pp)) :pass
                           (and (#{"known" "agree" "both-reject" "-"} lx) (#{"known" "agree" "both-reject" "clang-tokens" "ref-tokens" "-"} pp)) :known
                           :else :fail)
                     (str "lex " lx ", pp " pp)]))
        bad (filter #(= :fail (second %)) rows)
        _ (when (seq bad) (throw (ex-info (str "record-results: " (count bad) " failing files, not recorded: " (str/join " " (map first (take 5 bad)))) {})))
        pre (set (map #(str % "/") (remove subset? ids)))
        old0 (let [f (java.io.File. file)] (if (.exists f) (read-string (slurp f)) []))
        sub-ids (set (for [r rows :when (subset? (subs (first r) 0 (.indexOf ^String (first r) "/")))] (first r)))
        outside (remove (set (map first old0)) sub-ids)
        _ (when (seq outside)
            (throw (ex-info (str "record-results: " (count outside) " files of a subset's run are not in " file
                                 " (outside the recorded sampling), not recorded: " (str/join " " (take 5 outside))) {})))
        old (remove (fn [[i]] (or (some #(str/starts-with? i %) pre) (sub-ids i))) old0)
        all (sort-by first (concat old rows))]
    (spit file (str ";; bin/repr-cpp pp-check's results (doc/cpp/CPP-SURVEY.md, \"As built: CX10 (write-ahead)\"): every file of the corpora's\n"
                    ";; recorded runs (cpp-lexical whole, gxx-dg every 10th, libstdcxx-headers every 8th), [\"CORPUS/NAME\" RESULT REASON], RESULT\n"
                    ";; :pass or :known (test/repr/cpp/pp-check-known.edn), the reason the levels' statuses. Written by bin/repr-cpp pp-check\n"
                    ";; --record-results from a run with no failing file; read by bin/reap (the C++ read cell's passes). Read with the Clojure reader.\n"
                    "[\n" (str/join (map #(str (pr-str %) "\n") all)) "]\n"))
    (println (str "recorded " file ": " (count rows) " rows of " (str/join ", " ids) ", " (count (filter #(= :pass (second %)) rows)) " pass"))))

(defn -main [cmd & args]
  (case cmd
    "lexdiff" (apply lexdiff-main args)
    "diff" (apply diff-main args)
    "ref-diff" (apply ref-diff-main args)
    "pp" (pp-main args)
    "lex" (lex-main args)
    "lists" (let [[work roots sample & ids] args] (lists work (read-string roots) (read-string sample) ids))
    "check" (let [[work levels & ids] args
                  st (reduce max 0 (map #(check work % (set (str/split levels #","))) ids))]
              (shutdown-agents)
              (System/exit st))
    "record" (let [[work & ids] args] (record work ids))
    "record-known" (let [[work & ids] args] (record-known work ids))
    "known-add" (let [[f] args] (known-add f))
    "record-results" (let [[work file & ids] args] (record-results work file ids))
    "ref-lists" (let [[work & ids] args] (ref-lists work ids))
    "fidelity" (let [[work & ids] args] (System/exit (fidelity work ids)))
    (do (println "ppcheck: pp, lex, lists, check, record or record-known") (System/exit 2))))

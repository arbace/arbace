;; Part of Arbace. Its diagnostics' texts are clang's (clang/include/clang/Basic/DiagnosticSemaKinds.td: err_undeclared_var_use,
;; err_redefinition, err_redefinition_different_kind, err_param_redefinition, err_duplicate_member, err_member_redeclared) and its
;; rules follow clang's Sema (clang/lib/Sema/SemaExpr.cpp's DiagnoseEmptyLookup, SemaDecl.cpp's MergeVarDecl, MergeFunctionDecl,
;; ActOnTag, CheckRedeclaration, ActOnParamDeclarator, ActOnField; SemaLookup.cpp's LookupBuiltin) of the LLVM Project
;; (llvm-project-23.1.5.src.tar.xz, the pin of test/cpp/corpora.edn, sha256
;; fb50b1eac93ddeb3aa8dab4cfe324dff74f4a9c2bdee6160c9e36188f8d06a6e), written by hand on 2026-11-08 (doc/cpp/CPP-SURVEY.md,
;; "As built: CX12 (first slice)"). Their notice:
;;
;;   Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
;;   See https://llvm.org/LICENSE.txt for license information.
;;   SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
;;
(ns arbace.repr.cpp.diag
  "Arbace's own C++ front end's diagnostics (doc/cpp/CPP-SURVEY.md, CX12, \"As built: CX12 (first slice)\"): a C++ file's
  errors as a compiler gives them, `FILE:LINE:COL: error: MESSAGE [RULE]`, from the shared preprocessor (its errors,
  arbace.repr.c.pp in C++ mode), the native parser (arbace.repr.cpp.parse: a construct the grammar does not derive, at the
  token the parse failed at) and the checks over the parser's tree and scopes (`checks` below, each a port of the clang
  Sema check that gives the diagnostic, over the facts the parser records on its nodes). No clang and no gcc: the dg check's dg-error part judges each test's
  errors by its own dg-error lines (arbace.repr.cpp.dg's verdict) with these in place of clang's (`bin/repr-cpp dg --front
  native`), so that a test passing on them is judged by Arbace alone.

  A diagnostic is a map {:line :col :kind :msg :rule}: :kind :error (the verdict's), :rule the check that made it
  (:pp, :syntax, or a Sema rule's keyword)."
  (:require [arbace.repr.cpp.lit :as lit]
            [arbace.repr.cpp.native :as native]
            [arbace.repr.cpp.parse :as ps]
            [arbace.string :as str]))

(set! *warn-on-reflection* true)

(defn- latin1 ^String [^String path]
  (String. (java.nio.file.Files/readAllBytes (.toPath (java.io.File. path))) "ISO-8859-1"))

(defn line-starts ^java.util.ArrayList [^String s]
  (let [v (java.util.ArrayList.)]
    (.add v (long 0))
    (dotimes [i (.length s)] (when (= \newline (.charAt s i)) (.add v (long (inc i)))))
    v))

(defn line-col
  "The 1-based [line column] of offset `off` in the text whose line starts are `starts`."
  [^java.util.ArrayList starts ^long off]
  (let [i (java.util.Collections/binarySearch starts off)
        l (if (neg? i) (- (- i) 1) (inc i))]
    [l (inc (- off (long (.get starts (dec l)))))]))

;; ---------------------------------------------------------------------------------------------
;; Sema's checks: each (fn [unit starts] -> [diagnostic ...]) over the parse's result (its main-file nodes, clang's AST as
;; data, with the parser's facts under :_ keys)

(def ^:dynamic *driver-args*
  "cpp-gnu (2026-11-22): the file's g++ options as the dg check runs it (bound by arbace.repr.cpp.dg's own read), for GCC's rules
  of options clang does not take (the driver's, -fno-immediate-escalation, -fext-numeric-literals ...)."
  nil)

(def ^:dynamic *params*
  "The names of the parameters of the function declarators enclosing the node being walked (a default argument may name
  an earlier parameter, [basic.scope.param], DR 2082; the parser declares them with the body)."
  #{})

(defn- walk-nodes
  "Calls (f node parent) for every node of the tree `x` (maps with :kind, through every map and vector value)."
  [f x parent]
  (cond
    (map? x) (do (when (:kind x) (f x parent))
                 (binding [*params* (if-let [ps (seq (keep #(when (and (= "ParmVarDecl" (:kind %)) (not (:_badtypes %))) (:name %)) (when (vector? (:inner x)) (:inner x))))]
                                      (into *params* ps) *params*)]
                   (doseq [[k v] x :when (and (not= k :_ent) (or (map? v) (vector? v) (seq? v)))]
                     (walk-nodes f v (if (:kind x) x parent)))))
    (or (vector? x) (seq? x)) (doseq [y x] (walk-nodes f y parent))
    :else nil))

(def ^:private literal-kinds
  #{"IntegerLiteral" "FloatingLiteral" "StringLiteral" "CharacterLiteral" "CXXBoolLiteralExpr" "CXXNullPtrLiteralExpr"})

(defn- adl-free?
  "Whether a call's arguments have no associated namespace or class ([basic.lookup.argdep]/3: a fundamental type's
  argument has none): every argument a literal (an expression of a fundamental type the parser knows without types)."
  [call]
  (every? #(contains? literal-kinds (:kind %)) (rest (:inner call))))

(def ^:private clang-identifiers
  "clang's identifiers a __ name may be (cpp/target/clang-builtins.edn, CP270 (a): the builtins Sema declares implicitly
  in C++ -- LookupBuiltin: not the library builtins, which need their header's declaration -- and the lexer's keywords),
  or nil when the table is not there (a __ name then not judged)."
  (delay
    (let [f (java.io.File. "cpp/target/clang-builtins.edn")] ; (the checkout's, the tools' working directory, as host.ae's)
      (when (.exists f)
        (let [t (read-string (slurp f))]
          (into (set (:keywords t)) (keep (fn [[n k]] (when-not (#{:lib :target-lib} k) n)) (:builtins t))))))))

(def ^:private gcc-only-builtins
  "cpp-gnu (2026-11-22): GCC's builtins clang's table does not hold (the GCC 15.2 manual's \"Constructing Function Calls\":
  __builtin_va_arg_pack, __builtin_va_arg_pack_len), never undeclared."
  #{"__builtin_va_arg_pack" "__builtin_va_arg_pack_len" "__integer_pack"})

(defn- dunder-ok?
  "Whether the unqualified name `nm` no lookup found may be undeclared: any name not starting with __; a __ name only when
  clang's table is there and holds neither a builtin nor a keyword of that spelling (nor one of GCC's own builtins)."
  [^String nm]
  (if (str/starts-with? nm "__")
    (when-let [ids @clang-identifiers] (not (or (contains? ids nm) (contains? gcc-only-builtins nm))))
    true))

(def ^:private block-kinds
  #{"CompoundStmt" "IfStmt" "ForStmt" "WhileStmt" "DoStmt" "SwitchStmt" "CXXForRangeStmt" "CXXCatchStmt" "FunctionDecl" "CXXMethodDecl"
    "CXXConstructorDecl" "CXXDestructorDecl" "CXXConversionDecl" "LambdaExpr"})

(defn undeclared
  "Sema::DiagnoseEmptyLookup's \"use of undeclared identifier 'X'\" (clang/lib/Sema/SemaExpr.cpp, ActOnIdExpression): an
  unqualified id-expression no unqualified lookup finds, outside a template (the parser's :_undecl, at the name), not
  the callee of a call ADL could still resolve ([basic.lookup.argdep]: a call whose arguments are not all of
  fundamental types; Sema::ActOnCallExpr's ADL happens before the diagnostic). Each name once a line, and once a block (below)."
  [u starts _ _]
  (let [out (java.util.ArrayList.)
        ;; (CX12, third slice: every name a declaration of the unit names, the headers' too; a callee whose name none
        ;; declares is found by no ADL either, [basic.lookup.argdep]/4: ADL finds declarations, hidden friends among them)
        declared (delay (let [hs (java.util.HashSet.)]
                          (walk-nodes (fn [n _] (when-let [nm (:name n)] (when (string? nm) (.add hs nm)))) (:nodes u) nil)
                          hs))]
    ;; (round 54, third pass: GCC's suppression of a repeated error, its unqualified_name_lookup_error's declaration of the
    ;; name in the innermost block scope: an undeclared name is reported once in a block and the blocks it encloses, a later
    ;; use there found; a compound statement, a selection or iteration statement's own scope, a handler and a function each a
    ;; block, [basic.scope.block]/1; at namespace scope every use)
    (letfn [(w [x parent levels]
              (cond
                (map? x) (let [levels (if (contains? block-kinds (:kind x)) (cons (java.util.HashSet.) levels) levels)]
                           (when (:kind x) (f x parent levels))
                           (binding [*params* (if-let [ps (seq (keep #(when (and (= "ParmVarDecl" (:kind %)) (not (:_badtypes %))) (:name %)) (when (vector? (:inner x)) (:inner x))))]
                                                (into *params* ps) *params*)]
                             (doseq [[k v] x :when (and (not= k :_ent) (or (map? v) (vector? v) (seq? v)))]
                               (w v (if (:kind x) x parent) levels))))
                (or (vector? x) (seq? x)) (doseq [y x] (w y parent levels))
                :else nil))
            (f [n parent levels]
                  (when-let [[off nm] (:_undecl n)]
                    ;; in a template a non-dependent name is bound at its definition ([temp.res.general]/1, clang's two-phase
                    ;; lookup), so the same diagnostic; a call's name with a type-dependent argument waits for ADL at the
                    ;; instantiation ([temp.dep.candidate]): the literal-argument rule below covers both
                    (let [callee? (and parent (= "CallExpr" (:kind parent)) (identical? n (first (:inner parent))))]
                      (when (and (or (not callee?) (adl-free? parent) (not (.contains ^java.util.HashSet @declared nm)))
                                 (not (contains? *params* nm)) (dunder-ok? nm)
                                 ;; (a braced list's element still: its auto deduction fails on the error, GCC's "unable to
                                 ;; deduce", on that line)
                                 (or (and parent (= "InitListExpr" (:kind parent))) (not-any? #(.contains ^java.util.HashSet % nm) levels)))
                        (when-let [^java.util.HashSet b (first levels)] (.add b nm))
                        (let [[l c] (line-col starts (long off))]
                          (.add out {:line l :col c :kind :error :rule :undeclared
                                     :msg (str "use of undeclared identifier '" nm "'")}))))))]
      (w (:nodes u) nil ()))
    (distinct (vec out))))

;; Redeclarations (clang/lib/Sema/SemaDecl.cpp: Sema::MergeVarDecl's and CheckVariableDeclaration's err_redefinition,
;; MergeFunctionDecl's err_redefinition (CheckForFunctionRedefinition) and err_member_redeclared, ActOnTag's err_redefinition,
;; CheckRedeclaration's err_redefinition_different_kind, ActOnParamDeclarator's err_param_redefinition, ActOnField's
;; err_duplicate_member; [basic.scope.block]/2's names of a condition, an init-statement or a parameter redeclared in the
;; outermost block): each declarative region's declarations in order, by name, the later one diagnosed at its name.

(defn- qualified-name?
  "Whether the declaration's name at `off` is written qualified (`A::x`): the text before it ends in ::."
  [^String src ^long off]
  (loop [i (dec off)]
    (cond (neg? i) false
          (Character/isWhitespace (.charAt src (int i))) (recur (dec i))
          :else (and (pos? i) (= \: (.charAt src (int i))) (= \: (.charAt src (int (dec i))))))))

(defn qualifier
  "The nested-name-specifier written before the declaration's name at `off` (`A::B` of `A::B::x`), nil when there is
  none or it is not plain identifiers (a template-id, a decltype, a global ::)."
  [^String src ^long off]
  (let [ws (fn [^long i] (loop [i i] (if (and (>= i 0) (Character/isWhitespace (.charAt src (int i)))) (recur (dec i)) i)))]
    (loop [i (ws (dec off)) parts ()]
      (if (and (pos? i) (= \: (.charAt src (int i))) (= \: (.charAt src (int (dec i)))))
        (let [j (ws (- i 2))
              k (loop [k j] (if (and (>= k 0) (let [c (.charAt src (int k))] (or (Character/isLetterOrDigit c) (= c \_)))) (recur (dec k)) k))]
          (if (= k j) nil (recur (ws k) (conj parts (subs src (inc k) (inc j))))))
        (when (seq parts)
          ;; a global qualifier or a template-id before the first part: not followed
          (when-not (and (>= i 0) (#{\: \>} (.charAt src (int i)))) (str/join "::" parts)))))))

(defn- has-body? [n] (some #(= "CompoundStmt" (:kind %)) (:inner n)))
(def ^:private fn-kinds #{"FunctionDecl" "CXXMethodDecl" "CXXConstructorDecl" "CXXDestructorDecl" "CXXConversionDecl"})
;; (round 54: a deleted or explicitly defaulted function definition is a definition, [dcl.fct.def.general]/1, [dcl.fct.def.delete]/1)
(defn- fn-def? [n] (boolean (or (has-body? n) (:explicitlyDeleted n) (:explicitlyDefaulted n) (some #(= "CXXTryStmt" (:kind %)) (:inner n)))))

(defn- strip-noexcept
  "A function type's spelling without its own trailing exception specification (round 54, fourth pass: two declarations
  that differ in it alone declare the same function, [except.spec]/5, so a second definition is one still; a parameter's
  function type keeps its own, the specification after the parameter list's parenthesis only)."
  [^String qt]
  (when qt
    (if-let [^String head (second (re-find #"^(.*?)\s+noexcept(?:\(.*\))?$" qt))]
      (let [close (loop [i 0 d 0 last -1]
                    (if (>= i (count head)) last
                        (let [c (.charAt head (int i))]
                          (cond (= c \() (recur (inc i) (inc d) last)
                                (= c \)) (recur (inc i) (dec d) (if (= d 1) i last))
                                :else (recur (inc i) d last)))))]
        ;; the noexcept follows the outermost parameter list (and its cv- and ref-qualifiers), not a parameter's type
        (if (and (>= (long close) 0) (re-matches #"(?:\s*(?:const|volatile|&|&&))*\s*" (subs head (inc (long close)))))
          head
          qt))
      qt)))

(defn- decl-class
  "A declaration's class for the redeclaration rules: [cls def? sig] or nil (not a name this check follows)."
  [n]
  (case (:kind n)
    "VarDecl" [:var (or (not= "extern" (:storageClass n)) (contains? n :init)) nil]
    ("FunctionDecl" "CXXMethodDecl" "CXXConstructorDecl" "CXXDestructorDecl" "CXXConversionDecl")
    [:fn (fn-def? n) (strip-noexcept (get-in n [:type :qualType]))]
    "FieldDecl" [:field true nil]
    ("CXXRecordDecl" "EnumDecl") [:tag (boolean (:completeDefinition n)) (:tagUsed n)]
    ("TypedefDecl" "TypeAliasDecl") [:typedef true nil]
    "NamespaceDecl" [:ns true nil]
    "FunctionTemplateDecl" [:fn-tmpl true nil]
    "VarTemplateDecl" [:var-tmpl (let [v (last (:inner n))] (not (or (= "extern" (:storageClass v)) (:extern v)))) nil]
    ("ClassTemplateDecl" "TypeAliasTemplateDecl" "ConceptDecl") [:tmpl true nil]
    nil))

(def ^:private value-classes #{:var :fn :fn-tmpl :var-tmpl})

(defn- conflict
  "The diagnostic of the declaration `n` (class [c def sig]) after the entry `o` of its name in a region of kind `rk`
  (:ns :block :class), or nil."
  [rk o [c def sig] n]
  (let [oc (:cls o) nm (:name n)]
    (cond
      (:poison o) nil
      ;; a variable defined twice; at block scope every declaration but an extern one defines
      (and (= :var oc c)) (cond (and (:def o) def (not (and (= rk :class)))) (str "redefinition of '" nm "'")
                                ;; (round 54, fourth pass: [basic.scope.scope]/4, [basic.link]/8: at block scope an extern declaration
                                ;; after a local variable (or parameter, or a condition's variable in a substatement's outermost
                                ;; block, [stmt.pre]/5) of its name declares another entity in the same scope: GCC's "'int x' conflicts
                                ;; with a previous declaration")
                                (and (= rk :block) (:def o) (not def) (= "extern" (:storageClass n)) (not (contains? n :init))
                                     (= "VarDecl" (:kind n)) (#{"VarDecl" "ParmVarDecl"} (:kind (:node o))))
                                (str "'" (get-in n [:type :qualType]) " " nm "' conflicts with a previous declaration"))
      (= :fn oc c) (cond (and (= rk :class) (= sig (:sig o)) sig) "class member cannot be redeclared"
                         (and (:def o) def (= sig (:sig o)) sig) (str "redefinition of '" nm "'"))
      ;; (round 54: a function template defined twice with the same template-head and type, [basic.def.odr]/1; a variable template's
      ;; definition twice at namespace scope)
      (= :fn-tmpl oc c) (when (and (not= rk :class) (:def o) def sig (= sig (:sig o))) (str "redefinition of '" nm "'"))
      (= :var-tmpl oc c) (when (and (not= rk :class) (:def o) def) (str "redefinition of '" nm "'"))
      (= :field oc c) (str "duplicate member '" nm "'")
      (and (= rk :class) (#{[:field :var] [:var :field] [:field :fn] [:fn :field]} [oc c])) (str "duplicate member '" nm "'")
      (= :tag oc c) (when (and (:def o) def (not= "EnumDecl" (:kind n)) (= (:kind n) (:kind (:node o)))) (str "redefinition of '" nm "'"))
      (= :ns oc c) nil
      ;; (cpp-gnu, 2026-11-22: [dcl.typedef]/... a typedef-name redeclared names the same type: one naming a fundamental type and the
      ;; other a class -- GNU's typeof of *this, the member function's class, or a class-key's name -- is GCC's "conflicting
      ;; declaration", ext/typeof10.C)
      ;; (cpp-read, 2026-11-24: [class.mem.general]/6, a member declared twice in a class's member-specification, a member typedef
      ;; even of the same type: GCC's "redeclaration of 'typedef ...'", template/typedef1.C)
      (and (= :typedef oc c) (= rk :class) (= "TypedefDecl" (:kind n)) (= "TypedefDecl" (:kind (:node o))))
      (str "redeclaration of 'typedef " (str/trim (str (get-in n [:type :qualType]))) " " nm "'")
      (= :typedef oc c) (let [cls? (fn [^String t] (boolean (re-find #"^(?:(?:__typeof__|__typeof|typeof)\s*\(\s*\*\s*this\s*\)|(?:struct|class|union) \w+)$" t)))
                              fund? (fn [^String t] (boolean (re-matches #"(?:(?:const|volatile|unsigned|signed|short|long|int|char|bool|float|double|void|wchar_t)\s*)+" t)))
                              a (str/trim (str (get-in (:node o) [:type :qualType]))) b (str/trim (str (get-in n [:type :qualType])))]
                          (when (or (and (cls? a) (fund? b)) (and (fund? a) (cls? b)))
                            (str "conflicting declaration 'typedef " b " " nm "'")))
      ;; a value and a typedef, a namespace and anything but a namespace, a variable and a function
      (or (and (= :ns oc) (not= :ns c)) (and (= :ns c) (not= :ns oc))
          (and (= :typedef oc) (or (value-classes c) (= :tmpl c))) (and (or (value-classes oc) (= :tmpl oc)) (= :typedef c))
          (and (#{:var :var-tmpl} oc) (#{:fn :fn-tmpl} c)) (and (#{:fn :fn-tmpl} oc) (#{:var :var-tmpl} c))
          (and (= :tmpl oc) (value-classes c)) (and (value-classes oc) (= :tmpl c)))
      (when (not= rk :class) (str "redefinition of '" nm "' as different kind of symbol"))
      :else nil)))

(defn redefinitions
  "The redeclaration diagnostics of the unit `u` (see above). The definitions of members, in their class or out of it by
  a qualified name (`int S::foo() {}`, `struct A::B {}`), are kept by their written path from the namespace (a
  qualifier that is not plain identifiers is not followed): a second definition of a path is a redefinition."
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        qdefs (java.util.HashMap.)
        ;; (cpp-gnu, 2026-11-22: a declaration a macro of the main file writes is the main file's, at its expansion,
        ;; ext/gnu-inline-global-reject.C's)
        mine? (fn [n] (= main (or (get-in n [:loc :file]) (get-in n [:loc :expansionLoc :file]))))
        loff (fn [n] (or (get-in n [:loc :offset]) (get-in n [:loc :expansionLoc :offset])))
        report! (fn [n msg] (let [[l c] (line-col starts (long (loff n)))]
                              (.add out {:line l :col c :kind :error :rule :redefinition :msg msg})))
        ;; a trailing requires-clause makes a function's signature another (C++20 [over.dcl]): none compared
        reqs? (fn [n] (let [b (long (or (loff n) (get-in n [:loc :expansionLoc :offset]) 0))
                            e (loop [i b d 0]
                                (if (>= i (.length src)) i
                                    (let [c (.charAt src (int i))]
                                      (cond (= c \() (recur (inc i) (inc d)) (= c \)) (recur (inc i) (dec d))
                                            (and (<= d 0) (or (= c \;) (= c \{))) i
                                            :else (recur (inc i) d)))))]
                        (str/includes? (subs src b e) "requires")))
        ;; (round 54: a function template's class: defined when its function is, its signature its template-head's parameters as
        ;; written and the function's type; a requires-clause none)
        tmpl-class (fn [n]
                     (let [f (last (:inner n))
                           ps (butlast (:inner n))
                           txt (fn [x] (let [b (get-in x [:range :begin :offset]) e (get-in x [:range :end :offset]) l (get-in x [:range :end :tokLen])]
                                         (when (and b e l (<= (long b) (+ (long e) (long l)) (.length src))) (str/replace (subs src b (+ (long e) (long l))) #"\s+" ""))))
                           pt (map txt ps)]
                       (when (and (fn-kinds (:kind f)) (not (:requiresClause n)))
                         [:fn-tmpl (fn-def? f) (when (and (every? some? pt) (not (reqs? f)) (not (some #(str/includes? % "requires") pt)))
                                                 (str (str/join "," pt) "|" (get-in f [:type :qualType])))])))
        dclass (fn [n] (if (= "FunctionTemplateDecl" (:kind n))
                         (tmpl-class n)
                         (let [dc (decl-class n)] (if (and (= :fn (first dc)) (reqs? n)) (assoc dc 2 nil) dc))))
        ;; a definition by its path: [path sig-or-kind]
        qdef! (fn [n path]
                (let [[c def sig] (dclass n)]
                  (when (and def (#{:fn :tag :var :fn-tmpl} c) (or (not (#{:fn :fn-tmpl} c)) sig) (mine? n))
                    (let [k [path (if (#{:fn :fn-tmpl} c) [c sig] c)]]
                      (if (.containsKey qdefs k)
                        (report! n (str "redefinition of '" (:name n) "'"))
                        (.put qdefs k true))))))
        ;; (cpp-decl2: the namespace region of the class being walked, for its friends' definitions; and the namespace
        ;; functions declared so far by region, name and signature, for a deleted friend's earlier declaration)
        cur-ns (atom nil)
        ns-fns (java.util.HashMap.)]
    (letfn [(enter! [^java.util.HashMap r rk n path]
              (let [nm (:name n) off (loff n) dc (when (and off (mine? n)) (dclass n))]
                (when (and nm (not= "" nm) dc)
                  (if (qualified-name? src (long off))
                    (if-let [q (qualifier src (long off))]
                      (qdef! n (str path q "::" nm))
                      ;; (cpp-decl2: a class template's member defined out of its class, `template <int N> int Z<N>::var37;`,
                      ;; its template-head non-empty and its arguments identifiers: the pattern's member, "(template)::Z::var37",
                      ;; the class walk's path for the template's own members; cpp1z/inline-var2.C)
                      (let [b (long (or (get-in n [:range :begin :offset]) off))
                            before (str (subs src (max 0 (- b 200)) b) "\u0001" (subs src (min b (long off)) (long off)))
                            head (subs src (max 0 (- (long off) 200)) (long off))]
                        (when-let [[_ cn args] (re-find #"(\w+)\s*<\s*([A-Za-z_]\w*(?:\s*,\s*[A-Za-z_]\w*)*)\s*>\s*::\s*$" head)]
                          (when (and (re-find #"template\s*<[^<>]*[A-Za-z_][^<>]*>" (subs before (inc (.indexOf ^String before "\u0001"))))
                                     (not-any? #{"int" "char" "bool" "long" "short" "unsigned" "signed" "float" "double" "void" "wchar_t"
                                                 "char8_t" "char16_t" "char32_t" "auto"}
                                               (map str/trim (str/split args #","))))
                            (qdef! n (str "(template)::" cn "::" nm))))))
                    (do
                      ;; (a static data member in its class is declared, not defined: [class.static.data]/3)
                      ;; (cpp-decl2: an inline static data member's declaration is its definition, [class.static.data]/4)
                      (when (and (= rk :class) (or (not= "VarDecl" (:kind n)) (:inline n))) (qdef! n (str path nm)))
                      (if-let [o (.get r nm)]
                        ;; (cpp-diag-a: C++26's name-independent declarations, P2169 [basic.scope.scope]/5-6: a block-scope variable
                        ;; named _ of automatic storage conflicts with no earlier declaration, and takes the name's place; GCC
                        ;; accepts them before C++26 with a pedwarn, which -pedantic-errors makes an error)
                        (if-let [m (when-not (and (= nm "_") (= rk :block) (= "VarDecl" (:kind n)) (nil? (:storageClass n)) (not (:tls n))
                                                  (or (re-find #"(?:26|2c)$" (str (:std u))) (not (some #{"-pedantic-errors"} (:args u)))))
                                     (conflict rk o dc n))]
                          (do (report! n m)
                              ;; (cpp-singles: GCC's note at the earlier declaration, which a dg-error's later branch may take,
                              ;; arbace.repr.cpp.dg/alt-hits: cpp0x/override2.C's `has a previous declaration|previously declared
                              ;; here`)
                              (when-let [po (and (map? (:node o)) (mine? (:node o)) (loff (:node o)))]
                                (let [[l c] (line-col starts (long po))]
                                  (.add out {:line l :col c :kind :note :rule :redefinition :msg (str "'" nm "' previously declared here")}))))
                          (if (and (= nm "_") (= rk :block) (= "VarDecl" (:kind n)))
                            (.put r nm {:cls (first dc) :def (second dc) :sig (nth dc 2) :node n})
                            (when (and (second dc) (not (:def o)) (= (first dc) (:cls o))) (.put r nm (assoc o :def true :sig (nth dc 2))))))
                        (.put r nm {:cls (first dc) :def (second dc) :sig (nth dc 2) :node n})))))))
            (poison! [^java.util.HashMap r n] (when-let [nm (:name n)] (.put r nm {:poison true})))
            (params! [^java.util.HashMap r f]
              (doseq [pm (:inner f) :when (and (= "ParmVarDecl" (:kind pm)) (:name pm) (mine? pm))]
                (if (.get r (:name pm))
                  (report! pm (str "redefinition of parameter '" (:name pm) "'"))
                  (.put r (:name pm) {:cls :var :def true :node pm}))))
            (decls! [^java.util.HashMap r rk ^java.util.HashMap nss nodes path]
              (doseq [n nodes]
                (case (:kind n)
                  "LinkageSpecDecl" (decls! r rk nss (:inner n) path)
                  "NamespaceDecl" (do (enter! r rk n path)
                                      (let [k (or (:name n) "")
                                            [r2 nss2] (or (.get nss k) (let [v [(java.util.HashMap.) (java.util.HashMap.)]] (.put nss k v) v))]
                                        (decls! r2 :ns nss2 (:inner n) (str path (if (= k "") "(anonymous)" k) "::"))))
                  ("UsingDecl" "UsingShadowDecl" "UsingEnumDecl" "NativeDecline") (poison! r n)
                  (do (enter! r rk n path)
                      (when (= rk :ns)
                        (reset! cur-ns r)
                        (when (and (= "FunctionDecl" (:kind n)) (string? (:name n)) (mine? n) (loff n) (not (qualified-name? src (long (loff n)))))
                          (when-let [sg (nth (dclass n) 2 nil)] (.put ns-fns [(System/identityHashCode r) (:name n) sg] (fn-def? n)))))
                      (body! n path)))))
            (class! [n path]
              (let [r (java.util.HashMap.)
                    ;; the members' path: the class's, written in its namespace or qualified (`struct A::B {...}`)
                    q (when-let [off (when (mine? n) (loff n))] (when (qualified-name? src (long off)) (qualifier src (long off))))
                    ;; a specialization's members are its own (A<bool>::B is not A<T>::B)
                    path (cond (#{"ClassTemplateSpecializationDecl" "ClassTemplatePartialSpecializationDecl"} (:kind n))
                               (str "(specialization@" (loff n) ")::")
                               (:name n) (str path (when q (str q "::")) (:name n) "::")
                               :else "(unnamed)::")]
                (doseq [m (:inner n)]
                  (case (:kind m)
                    ("UsingDecl" "NativeDecline") (poison! r m)
                    ("FieldDecl" "VarDecl" "CXXMethodDecl" "CXXConstructorDecl" "CXXDestructorDecl" "CXXConversionDecl" "CXXRecordDecl")
                    (do (enter! r :class m path) (body! m path))
                    ;; (cpp-read, 2026-11-24: a member typedef, for conflict's member typedef declared twice)
                    "TypedefDecl" (enter! r :class m path)
                    ;; (round 54: a member function template, its definition by its path for an out-of-class one's redefinition)
                    "FunctionTemplateDecl" (do (enter! r :class m path) (body! m path))
                    ;; (cpp-decl2: a friend function's definition, a body or `= delete`, defines a function of the enclosing
                    ;; namespace, [class.friend]/6-7: a second definition there is a redefinition, and a deleted one after a
                    ;; declaration of the function is not its first declaration, [dcl.fct.def.delete]/4: GCC's "redefinition of
                    ;; 'void foo()'", "deleted definition of 'void bar()' is not first declaration"; cpp0x/pr80259.C)
                    "FriendDecl" (do (when-let [nr @cur-ns]
                                       (when-not (re-find #"\(local\)|\(template\)|\(specialization@" path)
                                         (doseq [f (:inner m)
                                                 :when (and (= "FunctionDecl" (:kind f)) (fn-def? f) (mine? f) (loff f) (string? (:name f))
                                                            (not (qualified-name? src (long (loff f)))))]
                                           (let [dc (dclass f) o (.get ^java.util.HashMap nr (:name f))
                                                 k [(System/identityHashCode nr) (:name f) (nth dc 2)]]
                                             (when (and (:explicitlyDeleted f) (nth dc 2)
                                                        (or (and o (= :fn (:cls o)) (not (:def o)) (= (nth dc 2) (:sig o)))
                                                            (false? (.get ns-fns k))))
                                               (report! f (str "deleted definition of '" (:name f) "' is not first declaration")))
                                             (when (nth dc 2) (.put ns-fns k true))
                                             (enter! nr :ns f path)))))
                                     (body! m path))
                    (body! m path)))))
            (body! [n path]
              ;; a declaration's nested regions: a class's members, a function's parameters and body, a template's pattern
              (case (:kind n)
                ("CXXRecordDecl" "ClassTemplateSpecializationDecl" "ClassTemplatePartialSpecializationDecl") (class! n path)
                ("FunctionDecl" "CXXMethodDecl" "CXXConstructorDecl" "CXXDestructorDecl" "CXXConversionDecl")
                (let [r (java.util.HashMap.)]
                  (params! r n)
                  (doseq [b (:inner n) :when (= "CompoundStmt" (:kind b))] (block! (java.util.HashMap. r) (:inner b))))
                ;; a template's pattern: its members' paths not followed (a specialization's would share them)
                ("ClassTemplateDecl" "FunctionTemplateDecl" "VarTemplateDecl" "TypeAliasTemplateDecl")
                (doseq [m (:inner n)] (body! m "(template)::"))
                (stmt! n)))
            (block! [^java.util.HashMap r stmts]
              (doseq [st stmts] (in-block! r st)))
            (in-block! [^java.util.HashMap r st]
              (case (:kind st)
                "DeclStmt" (doseq [d (:inner st)] (if (= "NativeDecline" (:kind d)) (poison! r d) (do (enter! r :block d "(local)::") (body! d "(local)::"))))
                "CompoundStmt" (block! (java.util.HashMap.) (:inner st))
                ("ForStmt" "IfStmt" "WhileStmt" "SwitchStmt" "CXXForRangeStmt" "CXXCatchStmt")
                (let [c (java.util.HashMap.)]
                  (doseq [x (:inner st)]
                    (cond (= "DeclStmt" (:kind x)) (in-block! c x)
                          (= "VarDecl" (:kind x)) (do (enter! c :block x "(local)::") (body! x "(local)::"))
                          (= "CompoundStmt" (:kind x)) (block! (java.util.HashMap. c) (:inner x))
                          :else (stmt! x))))
                "NativeDecline" nil
                (stmt! st)))
            (stmt! [x]
              ;; any other node: its nested blocks (a lambda's body, a statement expression) and local classes, each a region
              (cond
                (map? x) (case (:kind x)
                           "CompoundStmt" (block! (java.util.HashMap.) (:inner x))
                           "LambdaExpr" (doseq [y (:inner x)] (when-not (= "CXXRecordDecl" (:kind y)) (stmt! y)))
                           ("CXXRecordDecl" "FunctionDecl" "CXXMethodDecl") (body! x "(local)::")
                           (doseq [[k v] x :when (and (not= k :_ent) (coll? v))] (stmt! v)))
                (sequential? x) (doseq [y x] (stmt! y))
                :else nil))]
      (decls! (java.util.HashMap.) :ns (java.util.HashMap.) (:nodes u) ""))
    (vec out)))

;; The code generator's Sema (arbace.cpp.sema, doc/cpp/CODEGEN.md §3: lookup, expressions' types, overload resolution,
;; initialization) run over the unit as a checker: each function's body analyzed in turn (sema's *on-refusal*), a refusal
;; that is one of Sema's own errors -- the program ill-formed, not the slice exceeded -- a diagnostic at the node the
;; analysis was at (its line), the function's later errors not looked for (the analysis stops at its first). Each rule:
;; [class message-regex clang's diagnostic].
(def sema-rules
  [;; (CP332 (a): clang's builtin template __type_pack_element, its index checked as clang's checkBuiltinTemplateIdType does)
   [:pack-element #"^codegen: __type_pack_element's index is not an integral constant" "template argument for non-type template parameter must be an expression / not an integral constant"]
   [:pack-element #"^codegen: __type_pack_element's index -?\d+ is negative" "index of __type_pack_element is negative"]
   [:pack-element #"^codegen: __type_pack_element's index \d+ is out of range" "index of __type_pack_element is out of range"]
   [:overload #"^codegen: no viable function among [1-9]" "no matching function for call"]
   [:overload #"^codegen: call to a deleted function" "call to deleted function"]
   ;; (queue 497: GNU's unavailable attribute)
   [:unavailable #"^codegen: '.*' is unavailable" "is unavailable"]
   [:access #"^codegen: '.*' is a (private|protected) member of" "is a private member of"]
   ;; (the rest of CP313 (a): a member named through an inaccessible base, [class.access.base]/5; structured bindings,
   ;; [dcl.struct.bind]/4)
   [:access #"^codegen: '.*' is a member of '.*', an inaccessible base of" "cannot cast to its private base class"]
   [:decomp #"^codegen: cannot decompose" "cannot decompose"]
   [:decomp #"^codegen: .*decomposes into \d+ elements" "type decomposes into N elements, but M names were provided"]
   [:conversion #"^codegen: incompatible member function pointer types" "assigning to X from incompatible type X"]
   [:conversion #"^codegen: ambiguous conversion from derived class '.*' to base class" "ambiguous conversion from derived class X to base class X"]
   [:conversion #"^codegen: cannot initialize a variable of type '.*' with a value of another type" "cannot initialize a variable of type X with a value of type X"]
   ;; (queue 460: an implicit conversion between scalar types no standard conversion makes, [conv]/1, [conv.ptr],
   ;; [conv.qual], [conv.mem], [conv.integral], [conv.bool]; GCC's -fpermissive makes the pointer ones warnings)
   [:conversion #"^codegen: cannot convert .* implicitly" "cannot convert X to X"]
   [:mptr #"^codegen: pointer-to-member function type requires an" "pointer-to-member function type requires an lvalue/rvalue"]
   [:constexpr #"^codegen: constexpr variable '.*' must be initialized by a constant expression" "constexpr variable must be initialized by a constant expression"]
   [:constexpr #"^codegen: constexpr if condition is not a constant expression" "constexpr if condition is not a constant expression"]
   ;; (CP310 (b): an immediate invocation of a function whose body is not constant)
   [:constexpr #"^codegen: call to consteval function '.*' is not a constant expression" "call to consteval function is not a constant expression"]
   ;; (cpp-p2564: an escalated function's address outside an immediate function context, arbace.cpp.sema/cx-addr-report!)
   [:constexpr #"^codegen: taking address of an immediate function" "taking address of an immediate function"]
   [:overload #"^codegen: ambiguous call" "call is ambiguous"]
   ;; (cpp-sweep: [dcl.link]/6, one C function's declarations giving another default argument, arbace.cpp.sema/resolve-overload*)
   [:overload #"^codegen: default argument mismatch in overload resolution" "default argument mismatch in overload resolution"]
   ;; (queue 412, round 7: [dcl.init.list]/7)
   [:narrowing #"^codegen: narrowing conversion" "narrowing conversion"]
   [:sassert #"^codegen: static assertion failed" "static assertion failed"]
   ;; (cpp-rind: [expr.unary.op]/3 and [expr.pre.incr]/1, the operand of & and of ++ and -- an lvalue: GCC's "lvalue required as
   ;; unary '&' operand", "lvalue required as increment operand")
   [:addr #"^codegen: & of an rvalue" "lvalue required as unary '&' operand"]
   [:incdec #"^codegen: \+\+ of an rvalue" "lvalue required as increment operand"]
   ;; (cpp-rind: [dcl.type.auto.deduct]/4, arbace.cpp.sema's return statements)
   [:deduce #"^codegen: (unable to deduce 'auto\*'|no return statements in function returning)" "unable to deduce / no return statements"]
   ;; (cpp-rind: [expr.new]/1, arbace.cpp.sema/new-expr)
   [:new-array #"^codegen: invalid use of array with unspecified bounds" "invalid use of array with unspecified bounds"]
   ;; (cpp-rind: [over.ref]/1, arbace.cpp.sema/member-expr)
   [:arrow-op #"^codegen: no operator-> of " "base operand of '->' has non-pointer type"]
   ;; (cpp-rind: [expr.type.conv]/1, arbace.cpp.sema's casts)
   [:cast-array #"^codegen: functional cast to array type" "functional cast to array type"]
   ;; (cpp-rind: [expr.prim.id.general]/3, arbace.cpp.sema/name-expr's :field)
   [:member-use #"^codegen: invalid use of non-static data member" "invalid use of non-static data member"]
   ;; (cpp-rind: [dcl.init.general]/9, arbace.cpp.sema/ctor-inits)
   [:init-ref #"^codegen: invalid value-initialization of reference type" "invalid value-initialization of reference type"]
   ;; (cpp-rind: [dcl.fct.default]/9, arbace.cpp.sema/call-args)
   [:default-arg #"^codegen: recursive evaluation of default argument" "recursive evaluation of default argument"]
   ;; (cpp-rind: [class.base.init]/6, arbace.cpp.sema/ctor-inits)
   [:ctor-deleg #"^codegen: constructor delegates to itself" "constructor delegates to itself"]
   ;; (h-cpp-consteval: a condition, or an initializer's operation, surely not constant, [expr.const]/5)
   [:sassert #"^codegen: non-constant condition for static assertion" "static assertion expression is not an integral constant expression"]
   [:constexpr #"^codegen: expression is not a constant expression" "expression is not a constant expression"]
   [:constexpr #"^codegen: constinit variable '.*' does not have a constant initializer" "variable does not have a constant initializer"]
   ;; (cpp-sweep: literal types, arbace.cpp.sema/cx-non-literal: C++11's enclosing class, a constexpr function's signature
   ;; before C++23, a constexpr variable's type)
   [:constexpr #"^codegen: enclosing class of 'constexpr' non-static member function '.*' is not a literal type" "enclosing class of constexpr non-static member function is not a literal type"]
   [:constexpr #"^codegen: invalid (type for parameter \d+|return type) of 'constexpr' function" "constexpr function's parameter or return type is not a literal type"]
   [:constexpr #"^codegen: the type of 'constexpr' variable '.*' is not literal" "constexpr variable cannot have non-literal type"]
   [:constexpr #"^codegen: variable '.*' of non-literal type in '(constexpr|consteval)' function only available with" "variable of non-literal type in a constexpr function is a C++23 extension"]
   [:constexpr #"^codegen: member '.*' must be initialized by mem-initializer in 'constexpr' constructor" "constexpr constructor must initialize every member"]
   [:constexpr #"^codegen: explicitly defaulted function '.*' cannot be declared '(constexpr|consteval)' because the implicit declaration is not 'constexpr'" "defaulted definition of special member function cannot be constexpr"]
   [:noconv #"^codegen: no viable conversion from" "no viable conversion"]
   ;; (n-cpp-concepts: a constrained placeholder's deduced type, [dcl.type.auto.deduct]/2)
   [:placeholder #"^codegen: placeholder constraints not satisfied" "placeholder constraints not satisfied"]
   ;; (n-cpp-concepts: a constrained class or variable template's simple-template-id, [temp.names]/7)
   [:template #"^codegen: template constraint failure for" "template constraint failure"]
   ;; (n-cpp-concepts: [temp.over.link]/7, a class template's redeclaration)
   [:template #"^codegen: redeclaration of '.*' with different constraints" "redeclaration with different constraints"]
   [:template #"^codegen: out-of-line declaration of a member of '.*' with different constraints" "out-of-line declaration with different constraints"]
   [:constraint #"^codegen: invalid parameter type 'void' in a requires-expression" "invalid parameter type 'void'"]
   ;; (n-cpp-concepts: [temp.constr.atomic]/3)
   [:constraint #"^codegen: constraint expression does not have type 'bool'" "atomic constraint must be of type 'bool'"]
   ;; (n-cpp-concepts: [temp.spec.partial.general]/9.2)
   [:template #"^codegen: partial specialization of '.*' does not specialize any template arguments" "partial specialization does not specialize any template arguments"]
   ;; (cpp-tpl2: [temp.arg.template]/3-4 in a class template's template-id, template.ae's cx-ttp-arg-mismatch?)
   [:template #"^codegen: a template template argument whose parameters do not match" "type/value mismatch in a template argument list"]
   ;; (cpp-tpl2: a qualified name of a type a complete class does not declare, sema's resolve-type-form)
   [:type #"^codegen: unknown type .*: no type named '.*' in the complete class" "no type named in the class"]
   ;; (cpp-tpl2: [expr.prim.id.general]/4, sema's expression statements and requirements)
   [:expr #"^codegen: invalid use of non-static member function" "reference to non-static member function must be called"]
   ;; (cpp-tpl2: [class.copy.ctor]/5, sema's declare-fn!)
   [:decl #"^codegen: invalid constructor: " "copy constructor must pass its first argument by reference"]
   ;; (cpp-tpl2: template.ae's template-id, a member class named as a template)
   [:template #"^codegen: '.*' names a class, which is not a class template" "is not a class template"]
   ;; (cpp-tpl2: a typename-specifier naming a member class template before C++17, sema's resolve-type-form)
   [:name #"^codegen: '.*' names a template, which is not a type" "typename specifier refers to a member template, not a type"]
   ;; (cpp-tpl2: [temp.explicit]/4, template.ae's cx-explicit-var-type!)
   [:template #"^codegen: type of the explicit instantiation of '.*' does not match declared type" "explicit instantiation does not match the declared type"]
   ;; (cpp-tpl2: CWG 1430, template.ae's template-id)
   [:template #"^codegen: pack expansion argument for non-pack parameter of (alias template|concept)" "pack expansion used as argument for non-pack parameter of alias template or concept"]
   ;; (cpp-tpl2: [temp.spec.partial.match]/3)
   [:template #"^codegen: template parameters not deducible in partial specialization" "template parameters not deducible in partial specialization"]
   [:undecl #"^codegen: use of undeclared identifier" "use of undeclared identifier"]
   ;; (queue 487: [basic.lookup.general]/1 and /4 through using-directives, [namespace.udir]/2, [namespace.qual]/2)
   [:ambiguous #"^codegen: reference to '.*' is ambiguous" "reference to X is ambiguous"]
   [:name #"^codegen: '.*' is not a member of '" "no member named in the namespace"]
   ;; (queue 484: [dcl.typedef]/6, a typedef name redeclared as another type)
   [:redecl #"^codegen: conflicting declaration of '" "redefinition with a different type"]
   [:redecl #"^codegen: redefinition of enumerator '" "redefinition of enumerator"]
   ;; (queue 484: [temp.expl.spec]/12, [temp.deduct.decl]/1)
   [:template #"^codegen: explicit specialization of '.*' matches no template declaration" "no function template matches function template specialization"]
   ;; (queue 497: an out-of-line member declaration of a class with no such member)
   [:decl #"^codegen: no declaration matches '" "out-of-line declaration does not match any declaration"]
   ;; (queue 497: an explicit instantiation's)
   [:template #"^codegen: explicit instantiation of '.*' matches no template declaration" "explicit instantiation does not refer to a function template"]
   ;; (queue 484: a qualified name a complete class without bases, or an enumeration, does not declare, [basic.lookup.qual]/1,
   ;; [class.member.lookup]; name-expr's refusal, which the constraints' sure-failure? had already taken as the program's)
   [:name #"^codegen: unknown name \S+: no member of the complete class" "no member named in the class"]
   ;; (queue 368: [dcl.enum]/5, an implicit enumerator value past a fixed underlying type's range)
   [:enum #"^codegen: enumerator value '.*' is outside the range of underlying type" "enumerator value is outside the range of its underlying type"]
   ;; (cpp-read: [dcl.enum]/2)
   [:enum #"^codegen: enumerator value for '.*' is not an integer constant" "enumerator value is not an integer constant"]
   ;; (cpp-read: [dcl.enum]/7)
   [:enum #"^codegen: no integral type can represent all of the enumerator values" "no integral type can represent all of the enumerator values"]
   ;; (round 54: [class.mi]/3)
   [:base #"^codegen: duplicate base type" "base class specified more than once as a direct base class"]
   ;; (CP368 (a): a member of a class being defined, clang's err_field_incomplete_or_sizeless; the instantiation depth,
   ;; clang's err_template_recursion_depth_exceeded)
   [:incomplete #"^codegen: field has incomplete type" "field has incomplete type"]
   ;; (round 54: [class.mem.general]/11, a union's default member initializers)
   [:union #"^codegen: initializations for multiple members of" "initializing multiple members of union"]
   ;; (round 54: [dcl.array]/1, an array of unknown bound initialized by {})
   [:array #"^codegen: zero-size array" "zero-size array"]
   ;; (cpp-small, G2: [expr.new]/8, arbace.cpp.sema/cx-new-size!)
   [:array #"^codegen: size '[0-9]+' of array exceeds maximum object size" "size of array exceeds maximum object size"]
   ;; (round 54: [basic.def]/5)
   [:incomplete #"^codegen: variable has incomplete type" "variable has incomplete type"]
   [:incomplete #"^codegen: incomplete result type" "incomplete result type in function definition"]
   ;; (queue 484: [dcl.fct.def.general]/2's parameters; [expr.sizeof]/1, [expr.alignof]/1)
   [:incomplete #"^codegen: parameter has incomplete type" "variable has incomplete type"]
   ;; (queue 518: [dcl.fct]/2)
   [:incomplete #"^codegen: invalid use of type 'void' in parameter declaration" "invalid use of type 'void' in parameter declaration"]
   [:incomplete #"^codegen: variable or field '.*' declared void" "variable or field declared void"]
   [:redecl #"^codegen: deleted definition of '.*' is not its first declaration" "deleted definition is not the first declaration"]
   ;; (queue 518: [expr.const]/12's converted constant expressions)
   [:conversion #"^codegen: could not convert an expression of type .* in a converted constant expression" "could not convert in a converted constant expression"]
   [:incomplete #"^codegen: incomplete type '.*' used in nested name specifier" "incomplete type named in nested name specifier"]
   [:incomplete #"^codegen: invalid application of \S+ to incomplete type" "invalid application of 'sizeof' to an incomplete type"]
   ;; (queue 492: an object of an incomplete class initialized, sema's class-init)
   [:incomplete #"^codegen: invalid use of incomplete type '" "invalid use of incomplete type"]
   ;; (queue 484: a value trait's precondition, [meta.unary.prop], [meta.rel])
   [:incomplete #"^codegen: incomplete type '.*' in the type trait" "incomplete type used in type trait expression"]
   [:depth #"^codegen: recursive template instantiation exceeded maximum depth" "template instantiation depth exceeds maximum"]
   [:nomatch #"^codegen: no match for 'operator" "invalid operands: no viable overloaded operator"]
   ;; (cpp-sweep: a defaulted <=> deleted for a subobject's comparison not converting to its declared return type,
   ;; arbace.cpp.sema/cx-cmp-explain!)
   [:nomatch #"^codegen: three-way comparison of '.*' does not convert to the declared return type" "three-way comparison of a subobject does not convert to the declared return type"]
   [:nomatch #"^codegen: invalid 'static_cast' to the declared return type" "invalid static_cast to the declared return type"]
   [:adl #"^codegen: call to function '.*' that is neither visible" "call to function that is neither visible in the template definition nor found by argument-dependent lookup"]
   [:init #"^codegen: no default constructor for " "no matching constructor for initialization"]
   ;; (queue 510: a placement new-expression with no allocation function declared at all)
   [:new #"^codegen: no matching operator new" "no matching function for call to operator new"]
   ;; (cpp-sweep: [expr.new]/8, a floating array bound, in a template's specialization too)
   [:new #"^codegen: size in array new must have integral type" "size in array new must have integral type"]
   [:init #"^codegen: a non-const reference to a temporary" "non-const lvalue reference cannot bind to a temporary"]
   [:init #"^codegen: reference initialization is ambiguous" "reference initialization of type X with initializer of type X is ambiguous"]
   [:init #"^codegen: too many initializers" "excess elements in initializer"]
   ;; (queue 492: [over.match.list]/1, an explicit constructor chosen by a copy-list-initialization)
   [:init #"^codegen: converting to '.*' from initializer list would use explicit constructor" "chosen constructor is explicit in copy-initialization"]
   [:init #"^codegen: several values for a scalar" "excess elements in scalar initializer"]
   ;; (cpp-singles: a class template's specialization's using-declaration naming no base, arbace.cpp.sema's UsingDecl)
   [:using #"^codegen: type '.*' is not a base type for type '.*'" "not a base type"]
   ;; (cpp-singles: an empty aggregate's element from a non-class expression, arbace.cpp.sema/cx-empty-agg-elide!)
   [:init #"^codegen: initializer for '.*' must be brace-enclosed" "initializer must be brace-enclosed"]
   [:assign #"^codegen: assignment to an rvalue" "expression is not assignable"]
   [:assign #"^codegen: no operator=" "no viable overloaded '='"]
   [:assign #"^codegen: assignment of read-only variable" "cannot assign to variable with const-qualified type"]
   ;; (queue 412, round 7: [expr.assign]/1, an array as the left operand)
   [:assign #"^codegen: (invalid array assignment|assigning to an array from an initializer list)" "array type is not assignable"]
   [:member #"^codegen: no member " "no member named in the class"]
   [:member #"^codegen: member of a non-class" "member reference base type is not a structure or union"]
   [:call #"^codegen: missing argument" "too few arguments to function call"]
   [:call #"^codegen: call of a non-function" "called object type is not a function or function pointer"]
   [:deref #"^codegen: \* of a non-pointer" "indirection requires pointer operand"]
   ;; (CP291 (a): [temp.variadic]/12, a unary fold of an empty pack over an operator with no fallback value)
   [:fold #"^codegen: a unary fold expression with an empty expansion" "unary fold expression has empty expansion for operator"]
   ;; (CP311 (a): class template argument deduction, SemaInit.cpp's DeduceTemplateSpecializationFromInitializer)
   [:ctad #"^codegen: no viable constructor or deduction guide" "no viable constructor or deduction guide for deduction of template arguments"]
   [:ctad #"^codegen: ambiguous deduction for template arguments" "ambiguous deduction for template arguments"]
   [:ctad #"^codegen: class template argument deduction for '.*' selected an explicit" "class template argument deduction selected an explicit constructor or deduction guide for copy-list-initialization"]
   [:ctad #"^codegen: class template argument deduction for alias templates is a C\+\+20 extension" "class template argument deduction for alias templates is a C++20 extension"]
   [:ctad #"^codegen: template '.*' has no definition and no deduction guides" "template has no definition and no deduction guides"]
   [:ctad #"^codegen: use of class template '.*' requires template arguments" "use of class template requires template arguments"]
   [:ctad #"^codegen: cannot form .* deduced class template specialization type" "cannot form a compound type of a deduced class template specialization type"]])

(def ^:dynamic *sema-log* nil)
;; CP329 (a): the System/nanoTime past which a file's read stops (arbace.repr.cpp.dg/read-own binds it; 0: no cap)
(def ^:dynamic *deadline* 0)

(defn timed-out!
  "Throws the read's time cap ({:cpp/timeout true}) when the deadline passed."
  []
  (let [d (long *deadline*)]
    (when (and (pos? d) (> (System/nanoTime) d))
      (throw (ex-info "the read's time cap passed" {:cpp/timeout true})))))

(def ^:private sema-load (delay (locking arbace.lang.RT/REQUIRE_LOCK (require 'arbace.cpp.sema 'arbace.cpp.template)) true))

(defn load-sema!
  "Loads the code generator's Sema and its templates once, under the loader's lock (CP322 (a)): the dg read's threads call
  sema-errors at once, and requiring-resolve's unlocked resolve sees arbace.cpp.sema while another thread still loads it,
  and a plain require of arbace.cpp.template loads it again beside the first (its vars redefined while a unit uses them)."
  []
  @sema-load)

(defn cxx-year
  "The year of the standard `std` names (arbace.cpp.sema/cxx-year's)."
  ^long [std]
  (load-sema!)
  ((resolve 'arbace.cpp.sema/cxx-year) std))

;; queue 499: a quoted include from the main file's own directory (arbace.cpp.sema/local-include-file) is checked as the
;; main file's text, its errors at its own line numbers, as DejaGnu matches them (by line, whatever the file)
(defn- sema-starts
  "The line starts an error at a node of the file `file` is located by: the main file's `starts`, a local include's own,
  else nil (the error is dropped)."
  [^String main starts file]
  (if (= main file)
    starts
    (when-let [f ((resolve 'arbace.cpp.sema/local-include-file) file)]
      (line-starts (latin1 (.getPath ^java.io.File f))))))

(defn sema-errors
  "The code generator's Sema's errors over the unit `u` (parsed with the headers in full) of the text `src`."
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        _ (load-sema!)
        sema (resolve 'arbace.cpp.sema/analyze-program)
        at-var (resolve 'arbace.cpp.sema/*at*)
        on-var (resolve 'arbace.cpp.sema/*on-refusal*)
        dts (resolve 'arbace.cpp.sema/*decltypes*)
        mn (resolve 'arbace.cpp.sema/*main-name*)
        md (resolve 'arbace.cpp.sema/*main-dir*)
        yr (resolve 'arbace.cpp.sema/*cxx-year*)
        pe (resolve 'arbace.cpp.sema/*pedantic-errors*)
        ice (resolve 'arbace.cpp.sema/*invalid-constexpr-error*)
        icw (resolve 'arbace.cpp.sema/*invalid-constexpr-warned*)
        pd (resolve 'arbace.cpp.sema/*pedantic*)
        nw (resolve 'arbace.cpp.sema/*narrowing*)
        fre (resolve 'arbace.cpp.sema/*fp-rank-error*)
        ntm (resolve 'arbace.cpp.sema/*new-ttp-matching*)
        dl (resolve 'arbace.cpp.sema/*deadline*)
        ad (resolve 'arbace.cpp.sema/*analyze-depth*)
        cd (resolve 'arbace.cpp.sema/*constexpr-depth*)
        ;; (cpp-ce3: GCC's -fconstexpr-loop-limit=N, else its 262144)
        cll (resolve 'arbace.cpp.sema/*constexpr-loop-limit*)
        clln (or (some #(when-let [[_ d] (re-find #"^-fconstexpr-loop-limit=(\d+)$" (str %))] (Long/parseLong d)) (concat (:args u) *driver-args*)) 262144)
        ;; (cpp-small, G1: GCC's -ftemplate-depth=N, or its old spelling -ftemplate-depth-N, the last given; else GCC's 900)
        md* (resolve 'arbace.cpp.sema/*max-tmpl-depth*)
        ;; (cpp-tpl2: GCC's -fconcepts-diagnostics-depth=N, the last given, else 1)
        cdd (resolve 'arbace.cpp.sema/*concepts-diag-depth*)
        cddn (or (last (keep #(when-let [[_ d] (re-find #"^-fconcepts-diagnostics-depth=(\d+)$" (str %))] (Long/parseLong d)) (:args u))) 1)
        tdn (or (last (keep #(when-let [[_ d] (re-find #"^-ftemplate-depth[-=](\d+)$" (str %))] (Long/parseLong d)) (:args u))) 900)
        permissive (boolean (some #{"-fpermissive"} (:args u)))
        nesting (boolean (some #(re-find #"^-fdiagnostics-set-output=.*experimental-nesting=yes" (str %)) (:args u)))
        cdn (or (some #(when-let [[_ d] (re-find #"^-fconstexpr-depth=(\d+)$" (str %))] (Long/parseLong d)) (:args u)) 512)
        ;; (queue 412: the main file's lines where `#pragma GCC diagnostic ignored "-Wnarrowing"` is in force, push and pop
        ;; kept: GCC's narrowing permerror is silenced there)
        nw-off (loop [ls (str/split-lines src) i 1 on false stack () out #{}]
                 (if-let [l (first ls)]
                   (let [[on stack] (cond (re-find #"^\s*#\s*pragma\s+GCC\s+diagnostic\s+push\b" l) [on (cons on stack)]
                                          (re-find #"^\s*#\s*pragma\s+GCC\s+diagnostic\s+pop\b" l) [(if (seq stack) (first stack) false) (rest stack)]
                                          (re-find #"^\s*#\s*pragma\s+GCC\s+diagnostic\s+ignored\s+\"-Wnarrowing\"" l) [true stack]
                                          (re-find #"^\s*#\s*pragma\s+GCC\s+diagnostic\s+(warning|error)\s+\"-Wnarrowing\"" l) [false stack]
                                          :else [on stack])]
                     (recur (rest ls) (inc i) on stack (if on (conj out i) out)))
                   out))
        h (fn [e n]
            (when-not (:cx/reported (ex-data e)) ; (cpp-small: an error reported where it was found, arbace.cpp.sema/depth-fatal!)
            (let [cls (:codegen/refused (ex-data e)) m (str (ex-message e))
                  ;; (a refusal over a type the slice leaves undeduced or dependent is the slice's, not the program's)
                  rule (when-not (re-find #":k :(auto|dep|tparam)" m) (some (fn [[c re d]] (when (and (= c cls) (re-find re m)) d)) sema-rules))
                  ;; (queue 460: under -fpermissive GCC gives the implicit conversions no standard conversion makes as warnings)
                  rule (when-not (and permissive (re-find #"^codegen: cannot convert .* implicitly" m)) rule)
                  ;; (a refusal that names its own node: the constant evaluation's operation)
                  n (or (:cx/node (ex-data e)) n)
                  off (get-in n [:range :begin :offset])]
              (when *sema-log* (swap! *sema-log* conj [cls (subs m 0 (min 120 (count m))) (boolean rule)]))
              ;; (cpp-tpl2: a call with no viable function reported with its candidates' substitution failures, each an error at its
              ;; construct in the template's declaration, as GCC's explanations; arbace.cpp.template/call-candidates)
              ;; (not under GCC's nested text output, -fdiagnostics-set-output=text:experimental-nesting=yes: there they are
              ;; the nested output a test reads by dg-begin-multiline-output, concepts/nested-diagnostics-1.C)
              (when (and rule (not nesting))
                (doseq [{xm :msg xn :node} (:cx/explain (ex-data e))]
                  (when-let [xo (get-in xn [:range :begin :offset])]
                    (when-let [st (sema-starts main starts (get-in xn [:range :begin :file]))]
                      (let [[l c] (line-col st (long xo))]
                        (.add out {:line l :col c :kind :error :rule :sema :msg (str "substitution failure (" (subs xm 9 (min 100 (count xm))) ")")}))))))
              ;; (cpp-singles: a refusal whose construct GCC also diagnoses inside a system header it instantiates, an error
              ;; outside the main file, :cx/header-error: <initializer_list>'s pointer to a reference type)
              (when-let [hm (and rule (:cx/header-error (ex-data e)))]
                (.add out {:line 0 :col 0 :kind :error :rule :sema :msg (str hm " (in a system header)")}))
              (if-let [st (when (and rule off) (sema-starts main starts (get-in n [:range :begin :file])))]
                (let [[l c] (line-col st (long off))]
                  (when-not (and (= :narrowing cls) (contains? nw-off l))
                    (.add out {:line l :col c :kind :error :rule :sema :msg (str rule " (" (subs m 9 (min 100 (count m))) ")")})))
                ;; (cpp-ce2: a constant evaluation's error at an operation of a file the test includes from its own directory, a
                ;; relative name -- g++.dg/cpp2a/construct_at.h's std::construct_at -- is GCC's error there: an error outside the main
                ;; file, line 0; a system header's left out, as before)
                (let [f (str (get-in n [:range :begin :file]))]
                  (when (and rule off (= :constexpr cls) (:cx/node (ex-data e)) (seq f) (not= f main) (not (str/starts-with? f "/")))
                    (.add out {:line 0 :col 0 :kind :error :rule :sema :msg (str rule " (" (subs m 9 (min 100 (count m))) ") in " f)})))))))]
    ;; CP325 (a): a unit's refusal (the slice's, :codegen/refused or a type's :cpp/gap, or a constant the evaluation does not reach) leaves the
    ;; unit with the errors found before it, as before; anything else thrown is a crash of the analysis, the file's read
    ;; then a failing :crash with its message (arbace.repr.cpp.dg/read-own), never an acceptance. CP329 (a): past the
    ;; deadline the analysis unwinds and the read is a :timeout.
    (try
      (with-bindings {at-var (atom nil) on-var h dts (:decltypes u) mn main md (:dir u) yr (cxx-year (:std u)) pe (boolean (some #{"-pedantic-errors"} (:args u)))
                      icw (boolean (some #{"-Winvalid-constexpr"} (concat (:args u) *driver-args*)))
                      ice (boolean (and (some #{"-pedantic-errors" "-Werror=invalid-constexpr" "-Werror"} (concat (:args u) *driver-args*))
                                        (not (some #{"-Wno-invalid-constexpr" "-Wno-error=invalid-constexpr"} (concat (:args u) *driver-args*))))) pd (boolean (some #{"-pedantic" "-Wpedantic" "-pedantic-errors"} (:args u)))
                      ;; (queue 412: [dcl.init.list]/7, GCC's permerror; nothing or a warning under these)
                      nw (not (some #{"-Wno-narrowing" "-fpermissive" "-Wno-error=narrowing"} (:args u)))
                      ;; (cpp-extfloat: GCC's pedwarn on a floating conversion to a lesser conversion rank, -Wnarrowing's, an error)
                      fre (boolean (and (some #{"-pedantic-errors" "-Werror=narrowing" "-Werror"} (concat (:args u) *driver-args*))
                                        (not (some #{"-Wno-narrowing" "-Wno-error=narrowing"} (concat (:args u) *driver-args*)))))
                      dl (long *deadline*) ad (long-array 1) cd cdn cll clln md* tdn cdd cddn
                      ;; (queue 518: GCC's -fnew-ttp-matching and -fno-new-ttp-matching, the last given)
                      ntm (last (keep {"-fnew-ttp-matching" true "-fno-new-ttp-matching" false} (:args u)))}
        (sema (:nodes u) (:root u) src))
      (catch arbace.lang.ExceptionInfo e
        (timed-out!)
        (let [d (ex-data e)]
          (if (or (:codegen/refused d) (:codegen/not-constant d) (:cpp/gap d))
            (when *sema-log* (swap! *sema-log* conj [(or (:codegen/refused d) :other) (str "unit: " (subs (str (ex-message e)) 0 (min 100 (count (str (ex-message e))))))  false]))
            (do (when (System/getenv "CX12_TRACE") (.printStackTrace e))
                (throw (ex-info (str "Sema crashed: " (ex-message e)) {:cpp/crash true}))))))
      (catch Throwable e
        (timed-out!)
        (when (System/getenv "CX12_TRACE") (.printStackTrace e))
        (throw (ex-info (str "Sema crashed: " e) {:cpp/crash true}))))
    (timed-out!)
    (vec out)))

;; GNU's attributes clang does not know (CP294 (a)): the native parser keeps them as data on the declaration they appertain
;; to (:_gattrs, no node: the tree compared with clang's stays clang's), and each is checked by its rules as GCC's
;; documentation states them (the GCC 15.2 manual's "Common Variable Attributes", strict_flex_array: gcc/doc/extend.texi of
;; the pinned gcc-15.2.0.tar.xz), clean-room: no GCC code read or ported, the messages Arbace's own (the dg verdict compares
;; lines, not messages).

(defn- int-literal
  "The value of a decimal, octal or hexadecimal integer literal's text (a suffix allowed), or nil."
  [^String t]
  (when-let [[_ d] (re-matches #"(?i)\s*(0x[0-9a-f]+|0[0-7]*|[1-9][0-9]*)(?:u|l|ul|lu|ll|ull|llu)?\s*" t)]
    (cond (str/starts-with? (str/lower-case d) "0x") (Long/parseLong (subs d 2) 16)
          (and (str/starts-with? d "0") (> (count d) 1)) (Long/parseLong (subs d 1) 8)
          :else (Long/parseLong d))))

(def gattr-rules
  "The rules of an unknown GNU attribute by name: (fn [attr node vars] -> message or nil), `vars` the namespace-scope
  variables of the main file by name (their nodes)."
  {"strict_flex_array"
   ;; (the manual: one argument, the level, an integer from 0 to 3, on a structure's trailing array field): one argument; a
   ;; field, of array type; the argument an integer constant in [0, 3] (that the field is the trailing one is not checked)
   (fn [{:keys [args]} n vars]
     (let [a (first args)
           v (when a (int-literal a))]
       (cond
         (not= 1 (count args)) "the strict_flex_array attribute takes one argument, its level"
         (not= "FieldDecl" (:kind n)) (str "the strict_flex_array attribute applies to a structure's array field, not to '" (:name n) "'")
         (not (re-find #"\]\s*$" (str (get-in n [:type :qualType])))) "the strict_flex_array attribute applies to an array field"
         ;; (not an integer constant: only a variable the slice sees is no constant, an object of the main file's that is
         ;; neither const nor constexpr; any other expression is not judged)
         (and (nil? v) (re-matches #"[A-Za-z_][A-Za-z_0-9]*" (str/trim a))
              (when-let [d (get vars (str/trim a))]
                (and (= "VarDecl" (:kind d)) (not (:constexpr d)) (not (re-find #"\bconst\b" (str (get-in d [:type :qualType])))))))
         "the strict_flex_array attribute's level is not an integer constant"
         (and v (not (<= 0 (long v) 3))) (str "the strict_flex_array attribute's level " v " is not between 0 and 3")
         :else nil)))
   ;; CP303 (a), the manual's "Common Variable Attributes" and "Common Type Attributes": a threshold for a structure's field, or
   ;; a type's; so not for a variable or a function, nor a bit-field (a field whose alignment is its own); at the declarator's name
   "warn_if_not_aligned"
   (fn [_ n _]
     (let [what (fn [] (if (#{"FunctionDecl" "CXXMethodDecl"} (:kind n))
                         (let [qt (str (get-in n [:type :qualType]))
                               [_ r ps] (re-find #"^(.*?)\s*\((.*)\)" qt)]
                           (str r " " (:name n) "(" (if (= "void" (str/trim (str ps))) "" ps) ")"))
                         (:name n)))]
       (when (or (#{"VarDecl" "FunctionDecl" "CXXMethodDecl"} (:kind n)) (and (= "FieldDecl" (:kind n)) (:isBitfield n)))
         {:at-decl true :msg (str "'warn_if_not_aligned' may not be specified for '" (what) "'")})))
   ;; CP303 (a), the manual's "C++-Specific Variable, Function, and Type Attributes": an optional argument, an expression that
   ;; evaluates to true or false, on a class type, a function or a member function (else ignored, a warning); [[gnu::no_dangling()]]
   ;; an empty argument list written, which a standard attribute's syntax forbids
   "no_dangling"
   (fn [{:keys [args std]} n _]
     (cond
       (and std (= [] args)) "parentheses must be omitted if 'no_dangling' attribute argument list is empty"
       (not (#{"FunctionDecl" "CXXMethodDecl"} (:kind n))) nil
       (> (count args) 1) "wrong number of arguments specified for 'no_dangling' attribute"
       (and (= 1 (count args)) (re-matches #"(?s)(?:u8|u|U|L)?\".*\"" (str/trim (first args))))
       "'no_dangling' argument must be an expression that evaluates to true or false"
       :else nil))})

(defn gnu-attrs
  "CP294 (a): the unknown GNU attributes' rules (gattr-rules) over the declarations that carry them, each error at the
  attribute's name."
  [u starts _ _]
  (let [out (java.util.ArrayList.)
        vars (into {} (for [n (:nodes u) :when (and (= "VarDecl" (:kind n)) (string? (:name n)))] [(:name n) n]))]
    (walk-nodes (fn [n _]
                  (doseq [a (:_gattrs n)]
                    (when-let [r (get gattr-rules (:name a))]
                      (when-let [m (r a n vars)]
                        ;; (a rule's {:at-decl true :msg m}: at the declarator's name, else at the attribute's)
                        (let [o (if (and (map? m) (:at-decl m)) (or (get-in n [:loc :offset]) (:off a)) (:off a))
                              [l c] (line-col starts (long o))]
                          (.add out {:line l :col c :kind :error :rule :gnu-attr :msg (if (map? m) (:msg m) m)}))))))
                (:nodes u) nil)
    ;; CP303 (a): a bit-field of a type declared warn_if_not_aligned (a typedef of the main file's), at its name
    (let [wtypes (set (for [n (:nodes u) :when (and (= "TypedefDecl" (:kind n)) (some #(= "warn_if_not_aligned" (:name %)) (:_gattrs n)))] (:name n)))]
      (when (seq wtypes)
        (walk-nodes (fn [n _]
                      (when (and (= "FieldDecl" (:kind n)) (:isBitfield n)
                                 (contains? wtypes (str/trim (str/replace (str (get-in n [:type :qualType])) #"\b(?:const|volatile)\b" ""))))
                        (let [o (or (get-in n [:loc :offset]) (get-in n [:range :begin :offset]))
                              [l c] (line-col starts (long o))]
                          (.add out {:line l :col c :kind :error :rule :gnu-attr
                                     :msg (str "cannot declare bit-field " (when (seq (:name n)) (str "'" (:name n) "' ")) "with 'warn_if_not_aligned' type")}))))
                    (:nodes u) nil)))
    (vec out)))

;; A constexpr function's definition (clang/lib/Sema/SemaDeclCXX.cpp at llvmorg-23.1.5: CheckConstexprFunctionBody,
;; CheckConstexprDeclStmt, CheckConstexprMissingReturn; Sema::ActOnFunctionDeclarator's err_constexpr_dtor), [dcl.constexpr]/3
;; as C++11 to C++17 word it: the rules a definition's text decides, over the main file's non-template definitions (a
;; template's pattern is not judged here: its dependent types are the specializations'):
;; - a constexpr function returning non-void (no deduced return type) whose body has no return statement: "no return
;;   statement in constexpr function" at its name, before C++23 (CheckConstexprMissingReturn; from C++14 a void one is not);
;; - before C++20 a definition of a local variable for which no initialization is performed (ext_constexpr_local_var_no_init,
;;   which g++ makes an error before C++20): a scalar, or a class the unit defines whose default constructor is trivial and
;;   leaves its members uninitialized (no constructor declared, no base, no virtual member, every member a scalar with no
;;   default member initializer), with no initializer, not static, not extern, not a for-range variable; in a constexpr
;;   function, constructor or a lambda declared constexpr (the parser's :_cexpr), at the variable's name;
;; - before C++20 a destructor declared constexpr ("destructor cannot be declared constexpr", [dcl.constexpr]/1 of C++17), at
;;   the declaration.
;; - in C++11 (CP314 (a), CheckConstexprFunctionStmt's C++11 cases, which g++ makes errors) a function's body beside null
;;   statements and declarations of static_assert, typedefs, aliases, using-declarations and using-directives is one return
;;   statement ("body of constexpr function ... not a return-statement"), a constructor's nothing ("constexpr constructor does
;;   not have empty body", a class template's too), at the body's closing brace; a void function's body not judged (its
;;   return type is the error).
;; Everything else of the body (the literal types) is not judged.

(def ^:private scalar-type-re
  #"(?:(?:const|volatile)\s+)*(?:(?:unsigned|signed|short|long|int|char|bool|float|double|wchar_t|char8_t|char16_t|char32_t)\s*)+|.*\*\s*(?:const\s*)?")

(def ^:dynamic *ctor-only* "CP314 (a): only the C++11 constructor rule (a class template's constructor)" false)

(defn constexpr-bodies
  [u starts _ main]
  (let [out (java.util.ArrayList.)
        year (cxx-year (:std u))
        recs (into {} (for [n (:nodes u) :when (and (= "CXXRecordDecl" (:kind n)) (:completeDefinition n) (string? (:name n)))] [(:name n) n]))
        scalar? (fn [qt] (boolean (re-matches scalar-type-re (str/trim (str qt)))))
        uninit-class? (fn [qt]
                        (when-let [r (get recs (str/trim (str/replace (str qt) #"^(?:struct|class)\s+" "")))]
                          (let [fs (filter #(= "FieldDecl" (:kind %)) (:inner r))]
                            (and (empty? (:bases r)) (seq fs)
                                 (every? #(and (scalar? (get-in % [:type :qualType])) (not (:hasInClassInitializer %)) (empty? (:inner %))) fs)
                                 (not-any? #(or (#{"CXXConstructorDecl" "CXXRecordDecl"} (:kind %)) (:virtual %)) (:inner r))))))
        at! (fn [n msg rule]
              (let [o (or (get-in n [:loc :offset]) (get-in n [:range :begin :offset]))]
                (when (and o (= main (get-in n [:range :begin :file])))
                  (let [[l c] (line-col starts (long o))]
                    (.add out {:line l :col c :kind :error :rule rule :msg msg})))))
        ;; the statements of a body, not into a lambda's body nor a local class
        walk-stmts (fn walk [f x]
                     (cond (map? x) (do (f x)
                                        (when-not (#{"LambdaExpr" "CXXRecordDecl" "FunctionDecl" "CXXMethodDecl"} (:kind x))
                                          (doseq [[k v] x :when (and (not= k :_ent) (coll? v))] (walk f v))))
                           (sequential? x) (doseq [y x] (walk f y))
                           :else nil))
        declined? (fn [b] (let [d (volatile! false)] (walk-stmts #(when (= "NativeDecline" (:kind %)) (vreset! d true)) b) @d))
        uninit! (fn [body]
                  (when (and (< year 20) (not (declined? body)))
                    (walk-stmts (fn [x]
                                  (when (= "DeclStmt" (:kind x))
                                    (doseq [v (:inner x)
                                            :when (and (= "VarDecl" (:kind v)) (nil? (:init v)) (empty? (:inner v))
                                                       (nil? (:storageClass v)) (not (:tls v)))
                                            :let [qt (get-in v [:type :qualType])]
                                            :when (or (scalar? qt) (uninit-class? qt))]
                                      (at! v "uninitialized variable in a constexpr function" :constexpr))))
                                body)))
        lambdas! (fn [body]
                   (walk-nodes (fn [x _] (when (and (= "LambdaExpr" (:kind x)) (:_cexpr x))
                                           (when-let [b (last (filter #(= "CompoundStmt" (:kind %)) (:inner x)))] (uninit! b))))
                               body nil))
        fn! (fn [n]
              (let [body (last (filter #(= "CompoundStmt" (:kind %)) (:inner n)))]
                (when (and body (not *ctor-only*)) (lambdas! body))
                (when (and (= "CXXDestructorDecl" (:kind n)) (:constexpr n) (< year 20) (not *ctor-only*))
                  (let [o (get-in n [:range :begin :offset])]
                    (when (= main (get-in n [:range :begin :file]))
                      (let [[l c] (line-col starts (long o))]
                        (.add out {:line l :col c :kind :error :rule :constexpr :msg "destructor cannot be declared constexpr"})))))
                ;; CP314 (a): C++11's constexpr body (SemaDeclCXX's CheckConstexprFunctionBody and CheckConstexprFunctionStmt
                ;; before C++14, which g++ makes errors): beside null statements, static_assert-declarations, typedefs, alias
                ;; declarations, using-declarations and using-directives, a function's body is one return statement and a
                ;; constructor's nothing; the error at the body's closing brace, as g++ places it
                (when (and body (:constexpr n) (not (:_consteval n)) (= 11 (long year)) (not (declined? body))
                           (#{"FunctionDecl" "CXXMethodDecl" "CXXConstructorDecl"} (:kind n)))
                  (let [;; (a nested compound statement is g++'s error of its own, "compound-statement in constexpr function", at
                        ;; its brace; its statements are the body's: cpp0x/constexpr-compound)
                        flat (fn flat [xs] (mapcat #(if (= "CompoundStmt" (:kind %))
                                                      (do (at! % "compound-statement in constexpr function" :constexpr) (flat (:inner %)))
                                                      [%])
                                                   xs))
                        ctor? (= "CXXConstructorDecl" (:kind n))
                        judged? (and (= main (get-in n [:range :begin :file]))
                                     ;; (a void function is an error of its own in C++11, its body not judged, as g++)
                                     (or ctor? (not (re-find #"^void\s*\(" (str (get-in n [:type :qualType]))))))
                        ss (when judged? (doall (flat (:inner body))))
                        decl-ok #{"StaticAssertDecl" "TypedefDecl" "TypeAliasDecl" "UsingDecl" "UsingDirectiveDecl" "UsingShadowDecl"}
                        ok? (fn [s] (or (= "NullStmt" (:kind s))
                                        (and (= "DeclStmt" (:kind s)) (seq (:inner s)) (every? #(decl-ok (:kind %)) (:inner s)))))
                        rets (count (filter #(= "ReturnStmt" (:kind %)) ss))
                        others (remove #(or (ok? %) (= "ReturnStmt" (:kind %))) ss)
                        o (get-in body [:range :end :offset])]
                    (when (and o judged?
                               (if ctor? (or (seq others) (pos? rets)) (or (seq others) (not= 1 rets))))
                      (let [[l c] (line-col starts (long o))]
                        (.add out {:line l :col c :kind :error :rule :constexpr
                                   :msg (if ctor? "constexpr constructor does not have empty body"
                                            (str "body of constexpr function '" (:name n) "' not a return-statement"))})))))
                (when (and body (or (:constexpr n) (:_consteval n)) (not *ctor-only*))
                  (uninit! body)
                  (when (#{"FunctionDecl" "CXXMethodDecl"} (:kind n))
                    (let [qt (str (get-in n [:type :qualType]))
                          ret (second (re-find #"^(.*?)\s*\(" qt))
                          rets (volatile! 0)]
                      (walk-stmts #(when (= "ReturnStmt" (:kind %)) (vswap! rets inc)) body)
                      (when (and ret (not (re-find #"\b(auto|decltype)\b|^$" ret)) (zero? (long @rets)) (not (declined? body))
                                 (if (= "void" (str/trim ret)) (< year 14) (< year 23)))
                        (at! n "no return statement in constexpr function" :constexpr)))))))]
    (letfn [(decls! [ns]
              (doseq [n ns]
                (case (:kind n)
                  ("NamespaceDecl" "LinkageSpecDecl" "ExportDecl") (decls! (:inner n))
                  "CXXRecordDecl" (decls! (:inner n))
                  ("FunctionDecl" "CXXMethodDecl" "CXXConstructorDecl" "CXXDestructorDecl") (fn! n)
                  ;; CP314 (a): a class template's constexpr constructors are judged at their definition (cpp0x/constexpr-ctor19)
                  "ClassTemplateDecl" (doseq [r (:inner n) :when (= "CXXRecordDecl" (:kind r)) m (:inner r)
                                              :when (and (= "CXXConstructorDecl" (:kind m)) (= 11 (long year)))]
                                        (binding [*ctor-only* true] (fn! m)))
                  nil)))]
      (decls! (remove :_hdr (:nodes u))))
    (vec out)))

;; [dcl.constexpr]/1: every declaration of a function has the same constexpr or consteval specifier as the others
;; (clang/lib/Sema/SemaDeclCXX.cpp at llvmorg-23.1.5, Sema::MergeCXXFunctionDecl's err_constexpr_redecl_mismatch: the new
;; declaration against the previous one): the main file's non-member functions declared by an unqualified name at namespace
;; scope, and block-scope function declarations (which declare the innermost enclosing namespace's, [dcl.meaning]/3), each
;; known by its namespace, name and parameter types as written (a typedef's spelling is another function: missed, never
;; wrong), in order; a mismatch at the later declaration's name, which then does not become the previous one.
(defn constexpr-redecls
  [u starts ^String src main]
  (let [out (java.util.ArrayList.)
        prev (java.util.HashMap.)
        kind-of (fn [n] (cond (:_consteval n) "consteval" (:constexpr n) "constexpr" :else "non-constexpr"))
        params-of (fn [n] (second (re-find #"^[^(]*(\(.*)$" (str (get-in n [:type :qualType])))))
        decl! (fn [path n]
                (let [o (get-in n [:loc :offset])
                      ps (params-of n)]
                  (when (and o ps (string? (:name n)) (= main (get-in n [:range :begin :file]))
                             (not (qualified-name? src (long o))))
                    (let [k [path (:name n) ps]
                          old (.get prev k)
                          nk (kind-of n)]
                      (if (and old (not= old nk))
                        (let [[l c] (line-col starts (long o))]
                          (.add out {:line l :col c :kind :error :rule :redeclaration
                                     :msg (str nk " declaration of '" (:name n) "' follows " old " declaration")}))
                        (.put prev k nk))))))
        walk-body (fn walk [path x]
                    (cond (map? x) (case (:kind x)
                                     "DeclStmt" (doseq [d (:inner x)] (if (= "FunctionDecl" (:kind d)) (decl! path d) (walk path d)))
                                     ("LambdaExpr" "CXXRecordDecl" "ClassTemplateDecl" "FunctionTemplateDecl") nil
                                     (doseq [[k v] x :when (and (not= k :_ent) (coll? v))] (walk path v)))
                          (sequential? x) (doseq [y x] (walk path y))
                          :else nil))]
    (letfn [(decls! [path ns]
              (doseq [n ns]
                (case (:kind n)
                  "NamespaceDecl" (decls! (conj path (or (:name n) "(anonymous)")) (:inner n))
                  ("LinkageSpecDecl" "ExportDecl") (decls! path (:inner n))
                  "FunctionDecl" (do (decl! path n)
                                     (when-let [b (last (filter #(= "CompoundStmt" (:kind %)) (:inner n)))] (walk-body path b)))
                  nil)))]
      (decls! [] (remove :_hdr (:nodes u))))
    (vec out)))

;; n-cpp-read (round 52): jumps into a protected scope, written from the standard (clean-room, no compiler's code):
;; [stmt.dcl]/2 (a goto or a switch's case or default label may not pass from a point where a variable of automatic storage
;; duration is not in scope to one where it is, unless its initialization is vacuous, [basic.life]), [except.pre]/2 (a goto
;; or a switch may not transfer control into a try block or a handler), [stmt.if]/2 (a label in a constexpr if's or a
;; consteval if's substatement is referred to only from within the same substatement), and GNU's statement expressions
;; (GCC's manual, "Statements and Declarations in Expressions": jumping into one is not allowed). The error at the label
;; (the label's line, as g++ places it; its notes "from here" are not errors). The function bodies of the main file, a
;; lambda's and a local class's on their own; a body the parser declined a construct of is not judged. Conservative: a
;; variable counts when it has an initializer or a variably modified type over a parameter (int a[n]), never a class
;; variable default-initialized (its triviality unknown here): missed, never wrong.
(defn jumps
  [u starts ^String src main]
  (let [out (java.util.ArrayList.)
        ids (volatile! 0)
        region (fn [what] {:id (vswap! ids inc) :what what})
        at! (fn [n msg]
              (let [o (get-in n [:range :begin :offset])]
                (when (and o (= main (get-in n [:range :begin :file])))
                  (let [[l c] (line-col starts (long o))]
                    (.add out {:line l :col c :kind :error :rule :jump :msg msg})))))
        goto-name (fn [n] (when-let [o (get-in n [:range :begin :offset])]
                            (when (= main (get-in n [:range :begin :file]))
                              (second (re-find #"^goto\s+([A-Za-z_][A-Za-z_0-9]*)" (subs src (min (long o) (count src))))))))
        declined? (fn d [x] (cond (map? x) (or (= "NativeDecline" (:kind x)) (boolean (some d (:inner x))))
                                  (sequential? x) (boolean (some d x)) :else false))
        pending (java.util.ArrayDeque.)
        body-of (fn [n] (last (filter #(#{"CompoundStmt" "CXXTryStmt"} (:kind %)) (:inner n))))
        fn-body! (fn [body params]
                   (when (and body (not (declined? body)))
                     (let [labels (java.util.LinkedHashMap.) gotos (java.util.ArrayList.) cases (java.util.ArrayList.)
                           vm? (fn [qt] (some #(contains? params (second %)) (re-seq #"\[\s*([A-Za-z_][A-Za-z_0-9]*)\s*\]" (str qt))))
                           counts? (fn [v] (and (#{"VarDecl" "DecompositionDecl"} (:kind v)) (nil? (:storageClass v)) (not (:tls v))
                                                (or (:init v) (vm? (get-in v [:type :qualType])))))
                           walk (fn w [x prot sw]
                                  (cond
                                    (sequential? x) (do (doseq [y x] (w y prot sw)) prot)
                                    (not (map? x)) prot
                                    :else
                                    (let [k (:kind x) kids (when (vector? (:inner x)) (:inner x))
                                          seqw (fn [xs p] (reduce (fn [p c] (w c p sw)) p xs))]
                                      (case k
                                        ("CXXRecordDecl" "ClassTemplateDecl" "FunctionDecl" "CXXMethodDecl" "FunctionTemplateDecl")
                                        (do (.add pending x) prot)
                                        "LambdaExpr" (do (.add pending {:kind "LambdaBody" :body (last (filter #(= "CompoundStmt" (:kind %)) kids))}) prot)
                                        "CompoundStmt" (do (seqw kids prot) prot)
                                        "StmtExpr" (do (seqw kids (conj prot (region "enters a statement expression"))) prot)
                                        "DeclStmt" (reduce (fn [p v]
                                                             (w (:inner v) p sw)
                                                             (if (counts? v) (conj p (region (str "bypasses the initialization of '" (:name v) "'"))) p))
                                                           prot kids)
                                        "LabelStmt" (do (when (string? (:name x)) (.put labels (:name x) [x prot])) (seqw kids prot))
                                        ("CaseStmt" "DefaultStmt") (do (when sw (.add cases [x prot sw]))
                                                                       (seqw (butlast kids) prot) (w (last kids) prot sw))
                                        "GotoStmt" (do (when-let [nm (goto-name x)] (.add gotos [nm prot])) prot)
                                        "SwitchStmt" (let [p (seqw (butlast kids) prot)] (w (last kids) p p) prot)
                                        "CXXTryStmt" (do (w (first kids) (conj prot (region "enters a try block")) sw)
                                                         (doseq [h (rest kids)] (w h (conj prot (region "enters a handler")) sw))
                                                         prot)
                                        "IfStmt" (if (or (:isConstexpr x) (:isConsteval x))
                                                   (let [nsub (if (:hasElse x) 2 1)
                                                         what (if (:isConsteval x) "enters a 'consteval if' statement" "enters a 'constexpr if' statement")
                                                         p (seqw (drop-last nsub kids) prot)]
                                                     (doseq [s (take-last nsub kids)] (w s (conj p (region what)) sw))
                                                     prot)
                                                   (do (seqw kids prot) prot))
                                        (do (seqw kids prot) prot)))))]
                       (walk body [] nil)
                       (let [done (java.util.HashSet.)]
                         (doseq [[nm gp] gotos
                                 :let [[l lp] (.get labels nm) in (set (map :id gp))]
                                 :when (and l (not (.contains done nm)))
                                 :let [e (first (remove #(in (:id %)) lp))]
                                 :when e]
                           (.add done nm)
                           (at! l (str "jump to label '" nm "' " (:what e)))))
                       (doseq [[c cp sp] cases
                               :let [in (set (map :id sp)) e (first (remove #(in (:id %)) cp))]
                               :when e]
                         (at! c (str "jump to case label " (:what e)))))))
        fn! (fn [n]
              (case (:kind n)
                "LambdaBody" (fn-body! (:body n) #{})
                ("FunctionDecl" "CXXMethodDecl" "CXXConstructorDecl" "CXXDestructorDecl" "CXXConversionDecl")
                (fn-body! (body-of n) (set (keep #(when (and (= "ParmVarDecl" (:kind %)) (not (:_badtypes %))) (:name %)) (:inner n))))
                nil))]
    (letfn [(decls! [ns]
              (doseq [n ns]
                (case (:kind n)
                  ("NamespaceDecl" "LinkageSpecDecl" "ExportDecl" "CXXRecordDecl" "ClassTemplateDecl" "FunctionTemplateDecl"
                   "ClassTemplatePartialSpecializationDecl" "ClassTemplateSpecializationDecl")
                  (decls! (filter map? (:inner n)))
                  (fn! n))))]
      (decls! (remove :_hdr (:nodes u)))
      (loop []
        (when-let [n (.poll pending)]
          (if (= "LambdaBody" (:kind n)) (fn! n) (decls! [n]))
          (recur))))
    (vec out)))

;; Coroutines (round 54): [dcl.fct.def.coroutine]/3-5, a function whose body holds a co_await, co_yield or co_return names
;; std::coroutine_traits<R, P...>::promise_type and std::coroutine_handle<promise_type>, class templates of <coroutine>
;; ([coroutine.syn]): neither declared as a class template is GCC's "coroutines require a traits template" / "a handle class
;; template", and for a non-class R, or a class of the main file with no member promise_type and no base (the primary template's
;; `R::promise_type`, [coroutine.traits.primary]/1, when the main file specializes no coroutine_traits) "unable to find the
;; promise type for this coroutine". At the body's first co_ operator, once a function (a lambda's body its own).

(def ^:private co-kinds #{"CoawaitExpr" "CoyieldExpr" "CoreturnStmt"})

(defn- first-co
  "The first co_ node of a function's body `x`, not looking into a lambda's."
  [x]
  (cond
    (map? x) (cond (co-kinds (:kind x)) x
                   (= "LambdaExpr" (:kind x)) nil
                   ;; (queue 368: nor into a local class's members or a nested function, whose bodies are their own)
                   (or (#{"CXXRecordDecl" "ClassTemplateDecl" "FunctionTemplateDecl"} (:kind x)) (fn-kinds (:kind x))) nil
                   :else (some (fn [[k v]] (when (and (not= k :_ent) (coll? v)) (first-co v))) x))
    (or (vector? x) (seq? x)) (some first-co x)
    :else nil))

(defn coroutines
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        tmpls (java.util.HashSet.) classes (java.util.HashMap.)
        _ (letfn [(ns-walk [nodes std?]
                    (doseq [n nodes]
                      (case (:kind n)
                        "NamespaceDecl" (cond (and (not std?) (= "std" (:name n))) (ns-walk (:inner n) true)
                                              (and std? (:isInline n)) (ns-walk (:inner n) true)
                                              :else nil)
                        "LinkageSpecDecl" (ns-walk (:inner n) std?)
                        "ClassTemplateDecl" (when std? (.add tmpls (:name n))
                                              ;; (queue 368: a coroutine_traits the main file defines itself, whose promise_type is
                                              ;; not [coroutine.traits.primary]'s R::promise_type: pr105475-2.C's)
                                              (when (= main (get-in n [:loc :file])) (.add tmpls (str "main:" (:name n)))))
                        "CXXRecordDecl" (when (and (not std?) (:name n) (:completeDefinition n) (= main (get-in n [:loc :file])))
                                          (.put classes (:name n) n))
                        nil)))]
            (ns-walk (:nodes u) false))
        ;; (queue 368: a specialization's own head, `struct coroutine_traits<...>` or `class std::coroutine_traits<...>`, any qualifier (a namespace alias's `coro::`), in the
        ;; text without its comments and literals; a use, `std::coroutine_traits<R>::promise_type`, or a comment is none)
        specialized (re-find #"(?:struct|class)\s+(?:::\s*)?(?:[A-Za-z_]\w*\s*::\s*)*coroutine_traits\s*<"
                             (-> src (str/replace #"(?s)/\*.*?\*/" " ") (str/replace #"//[^\n]*" " ")
                                 (str/replace #"\"(?:\\.|[^\"\\\n])*\"" "\"\"")))
        report! (fn [c msg]
                  (when-let [off (get-in c [:range :begin :offset])]
                    (when (= main (or (get-in c [:range :begin :file]) (get-in c [:range :begin :expansionLoc :file])))
                      (let [[l col] (line-col starts (long off))]
                        (.add out {:line l :col col :kind :error :rule :coroutine :msg msg})))))
        ;; (round 54, second pass: [dcl.fct.def.coroutine]/15, `co_await promise.final_suspend()` is not potentially-throwing:
        ;; final_suspend, the awaitable's operator co_await, the awaiter's await_ready, await_suspend and await_resume, then the
        ;; destructors (the awaitable's after its operator co_await, the awaiter's last), each a main-file class's member declared noexcept; GCC's
        ;; "the expression 'X::f' is required to be non-throwing" at the first that is not, once a class)
        seen (java.util.HashSet.)
        member (fn [cn nm] (some #(when (and (= nm (:name %)) (fn-kinds (:kind %))) %) (:inner cn)))
        throwing? (fn [m dtor?] (let [qt (str (get-in m [:type :qualType]))]
                                  (if dtor? (boolean (re-find #"noexcept\(false\)" qt))
                                      (not (or (re-find #"noexcept(?!\(false\))" qt) (re-find #"throw\(\)" qt))))))
        rtype (fn [m] (when-let [[_ r] (re-find #"^([^()<>:*&]+?)\s*\(" (str (get-in m [:type :qualType])))] (.get classes (str/trim r))))
        final-throwing! (fn [ret]
                          (when-let [pt (some->> (.get classes ret) :inner (some #(when (and (= "CXXRecordDecl" (:kind %)) (= "promise_type" (:name %))) %)))]
                            (when (.add seen ret)
                              (let [fs (member pt "final_suspend")
                                    obj (when fs (rtype fs))
                                    oc (when obj (member obj "operator co_await"))
                                    aw (if oc (rtype oc) obj)
                                    cands (concat [[fs (str ret "::promise_type::final_suspend") false]]
                                                  (when obj [[oc (str (:name obj) "::operator co_await") false]])
                                                  (when (and obj (not= obj aw)) [[(member obj (str "~" (:name obj))) (str (:name obj) "::~" (:name obj)) true]])
                                                  (when aw (for [f ["await_ready" "await_suspend" "await_resume"]] [(member aw f) (str (:name aw) "::" f) false]))
                                                  (when aw [[(member aw (str "~" (:name aw))) (str (:name aw) "::~" (:name aw)) true]]))]
                                (when-let [[m nm] (first (filter (fn [[m _ d]] (and m (throwing? m d))) cands))]
                                  (report! m (str "the expression '" nm "' is required to be non-throwing")))))))
        check! (fn [body ret]
                 (when-let [c (first-co body)]
                   (cond
                     (not (.contains tmpls "coroutine_traits")) (report! c "coroutines require a traits template; cannot find 'std::coroutine_traits'")
                     (not (.contains tmpls "coroutine_handle")) (report! c "coroutines require a handle class template; cannot find 'std::coroutine_handle'")
                     (and ret (not specialized) (not (.contains tmpls "main:coroutine_traits"))
                          (or (re-matches #"(?:(?:unsigned|signed|short|long|int|char|bool|float|double|void|wchar_t|char8_t|char16_t|char32_t)\s*)+" ret)
                              (when-let [cn (.get classes ret)]
                                (and (empty? (:bases cn))
                                     (not (some #(= "promise_type" (:name %)) (:inner cn)))))))
                     (report! c "unable to find the promise type for this coroutine")
                     :else (when ret (final-throwing! ret)))))]
    (walk-nodes (fn [n _]
                  (cond
                    (and (fn-kinds (:kind n)) (= main (get-in n [:loc :file])))
                    (when-let [b (some #(when (= "CompoundStmt" (:kind %)) %) (:inner n))]
                      (let [qt (str (get-in n [:type :qualType]))
                            ret (when-let [[_ r] (re-find #"^([^()<>:*&]+?)\s*\(" qt)] (str/trim r))
                            ;; (queue 368: [dcl.fct.def.coroutine]/4, a coroutine is no constructor, destructor, main function,
                            ;; constexpr function or function with a C variadic parameter list: GCC's "'co_await' cannot be used in a
                            ;; constructor", at the first co_ operator, before the promise's lookup)
                            no-co (cond (= "CXXConstructorDecl" (:kind n)) "a constructor"
                                        (= "CXXDestructorDecl" (:kind n)) "a destructor"
                                        (and (= "FunctionDecl" (:kind n)) (= "main" (:name n))) "the 'main' function"
                                        (:constexpr n) "a 'constexpr' function"
                                        (re-find #"\.\.\.\)" qt) "a varargs function")]
                        (if-let [c (and no-co (first-co b))]
                          (report! c (str "'" (case (:kind c) "CoawaitExpr" "co_await" "CoyieldExpr" "co_yield" "co_return") "' cannot be used in " no-co))
                          (check! b (when-not (#{"auto" "decltype"} ret) ret)))))
                    (= "LambdaExpr" (:kind n))
                    (when-let [b (some #(when (= "CompoundStmt" (:kind %)) %) (:inner n))] (check! b nil))
                    :else nil))
                (:nodes u) nil)
    (vec out)))

;; (round 54, third pass) Class templates' redeclarations at namespace scope, a friend's among them ([temp.over.link]/6 with
;; [temp.class.general]: every declaration of a class template has an equivalent template-head, its parameters of the same
;; kinds, a non-type one of the same type, and as many): GCC's "redeclared with N template parameter(s)" at the later
;; declaration, "template parameter 'int i'" at the earlier one's parameter of another kind. A non-type parameter's type is
;; compared only when it is fundamental (a typedef's name not resolved), a constrained type parameter not at all.

(defn- fund-key
  "A fundamental type's spelling (`long int`, `int *`) as one key, nil when it is not one."
  [^String t]
  (let [t (str/trim t)]
    (when (re-matches #"(?:(?:unsigned|signed|short|long|int|char|bool|wchar_t|char8_t|char16_t|char32_t)\s*)+(?:\*\s*)*" t)
      (let [ptrs (count (filter #(= \* %) t))
            ws (re-seq #"[a-z_0-9]+" t)
            ws (if (some #{"char"} ws) ws (remove #{"signed"} (if (> (count ws) 1) (remove #{"int"} ws) ws)))
            ws (if (empty? ws) ["int"] ws)]
        (str (str/join " " (sort ws)) (apply str (repeat ptrs "*")))))))

(defn- tparam-key [x]
  (case (:kind x)
    "TemplateTypeParmDecl" (if (some #(= "ConceptSpecializationExpr" (:kind %)) (:inner x)) :unknown [:type (boolean (:isParameterPack x))])
    "NonTypeTemplateParmDecl" (if-let [k (fund-key (str (get-in x [:type :qualType])))] [:value (boolean (:isParameterPack x)) k] :unknown)
    ;; (round 54, fourth pass: a template template parameter pack against one that is none, its own parameters not compared)
    "TemplateTemplateParmDecl" [:template (boolean (:_pack x))]
    :unknown))

(defn- tparam-desc [x]
  (case (:kind x)
    "TemplateTypeParmDecl" (str (or (:tagUsed x) "typename") (when (:name x) (str " " (:name x))))
    "NonTypeTemplateParmDecl" (str (get-in x [:type :qualType]) (when (:name x) (str " " (:name x))))
    (str "template" (when (:name x) (str " " (:name x))))))

(defn template-heads
  "The class template redeclarations' template-head checks of the unit `u` (see above)."
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        regions (java.util.HashMap.)
        mine? (fn [x] (= main (get-in x [:loc :file])))
        report! (fn [x msg] (let [[l c] (line-col starts (long (get-in x [:loc :offset])))]
                              (.add out {:line l :col c :kind :error :rule :template-head :msg msg})))
        rec-of (fn [t] (let [r (last (:inner t))] (when (= "CXXRecordDecl" (:kind r)) r)))
        unqualified? (fn [r] (and (mine? r) (get-in r [:loc :offset]) (not (qualified-name? src (long (get-in r [:loc :offset]))))))
        compare! (fn [^java.util.HashMap r t]
                   (when-let [rec (rec-of t)]
                     (when (and (:name t) (unqualified? rec))
                       (if-let [o (.get r (:name t))]
                         (let [ops (vec (butlast (:inner o))) nps (vec (butlast (:inner t)))
                               ok (map tparam-key ops) nk (map tparam-key nps)
                               pack? (some #(and (vector? %) (second %)) (concat ok nk))]
                           (cond
                             (and (not= (count ops) (count nps)) (not pack?) (mine? rec))
                             (report! rec (str "redeclared with " (count nps) " template parameter" (when (not= 1 (count nps)) "s")))
                             (= (count ops) (count nps))
                             (when-let [i (first (filter #(let [a (nth ok %) b (nth nk %)]
                                                            (and (vector? a) (vector? b) (not= a b)))
                                                         (range (count ops))))]
                               (let [x (nth ops i)
                                     x (if (and (nil? (:loc x)) (:_loc x)) (assoc x :loc (:_loc x)) x)]
                                 (when (and (mine? x) (get-in x [:loc :offset]))
                                   (report! x (str "template parameter '" (tparam-desc x) "'")))))
                             :else nil))
                         (.put r (:name t) t)))))
        friends! (fn [r rec]
                   (doseq [f (:inner rec) :when (= "FriendDecl" (:kind f))
                           t (:inner f) :when (= "ClassTemplateDecl" (:kind t))]
                     (compare! r t)))]
    (letfn [(region! [path nodes]
              (let [^java.util.HashMap r (or (.get regions path) (let [m (java.util.HashMap.)] (.put regions path m) m))]
                (doseq [n nodes]
                  (case (:kind n)
                    "LinkageSpecDecl" (region! path (:inner n))
                    "NamespaceDecl" (region! (str path (or (:name n) "(anonymous)") "::") (:inner n))
                    "ClassTemplateDecl" (do (compare! r n) (when-let [rec (rec-of n)] (friends! r rec)))
                    "CXXRecordDecl" (friends! r n)
                    nil))))]
      (region! "" (:nodes u)))
    (vec out)))

;; (round 54, third pass) Exception specifications of a function's declarations ([except.spec]/5 (C++20 /4): every
;; declaration of a function whose exception specification is not potentially-throwing has a compatible one; a dependent
;; noexcept-specifier's expression equivalent, [temp.over.link]/5, its tokens the same up to the template parameters'
;; names): GCC's "declaration of 'f' has a different exception specifier" at the later declaration, or at a friend of a
;; class template, declared again when the class is instantiated (only then: a use of the template's name after it).
;; The declarations compared: a namespace's functions and function templates, its classes' friends of either, a class's
;; member functions with their out-of-class definitions (`X<T>::f`, its arguments the class template's parameters); both
;; in the main file, no destructor, allocation or deallocation function or defaulted one (their implicit specifications).

(defn- split-exc
  "A function type's spelling without its exception specification, and that specification (nil when none)."
  [^String qt]
  (let [n (.length qt)
        close (loop [i 0 d 0 seen false]
                (cond (>= i n) nil
                      (= \( (.charAt qt i)) (recur (inc i) (inc d) true)
                      (= \) (.charAt qt i)) (if (and seen (= d 1)) i (recur (inc i) (dec d) seen))
                      :else (recur (inc i) d seen)))]
    (if-not close
      [qt nil]
      (let [m (re-matcher #"\b(noexcept|throw)\b" qt)]
        (if (and (.find m (inc (long close))))
          (let [b (.start m)
                j (loop [j (.end m)] (if (and (< j n) (= \space (.charAt qt j))) (recur (inc j)) j))
                e (if (and (< j n) (= \( (.charAt qt j)))
                    (loop [k j d 0] (cond (>= k n) n
                                          (= \( (.charAt qt k)) (recur (inc k) (inc d))
                                          (= \) (.charAt qt k)) (if (= d 1) (inc k) (recur (inc k) (dec d)))
                                          :else (recur (inc k) d)))
                    (.end m))]
            [(str/trim (str/replace (str (subs qt 0 b) " " (subs qt e)) #"\s+" " ")) (str/replace (subs qt b e) #"\s+" "")])
          [(str/replace qt #"\s+" " ") nil])))))

(defn- rename-params
  "`s` with the template parameters `names` (by position) spelled @tpI@."
  [^String s names]
  (reduce (fn [s [i nm]] (if (seq nm) (str/replace s (re-pattern (str "\\b" (java.util.regex.Pattern/quote nm) "\\b")) (str "@tp" i "@")) s))
          s (map-indexed vector names)))

;; (round 54, fifth pass) the standard's year exc-class reads, bound by exception-specs
(def ^:dynamic *exc-year* nil)

(defn- exc-class
  "An exception specification's class: :none (potentially-throwing), :nothrow, [:dep expr] (a dependent noexcept-specifier,
  its parameters renamed), or nil (not compared)."
  [exc]
  (cond (nil? exc) :none
        (#{"noexcept" "noexcept(true)" "throw()"} exc) :nothrow
        (= "noexcept(false)" exc) :nfalse
        (and (str/starts-with? exc "noexcept(") (str/includes? exc "@tp")) [:dep exc]
        ;; (round 54, fifth pass: before C++17 a dynamic exception specification, its set of types)
        (and *exc-year* (< (long *exc-year*) 17) (re-matches #"throw\((.+)\)" exc))
        {:dyn (set (map str/trim (str/split (second (re-matches #"throw\((.+)\)" exc)) #",")))}
        :else nil))

(defn- out-of-class
  "The class a qualified declarator-id at `off` names a member of, `X` of `X::f` or `X<T, U>::f`: [name [argument ...]], nil
  when the qualifier is longer or an argument is not an identifier."
  [^String src ^long off]
  (let [ws (fn [^long i] (loop [i i] (if (and (>= i 0) (Character/isWhitespace (.charAt src (int i)))) (recur (dec i)) i)))
        idc? (fn [c] (or (Character/isLetterOrDigit (char c)) (= \_ c)))
        i (ws (dec off))]
    (when (and (pos? i) (= \: (.charAt src (int i))) (= \: (.charAt src (int (dec i)))))
      (let [j (ws (- i 2))
            [j args] (if (and (>= j 0) (= \> (.charAt src (int j))))
                       (let [k (loop [k (dec j) d 1] (cond (neg? k) nil
                                                          (= \> (.charAt src (int k))) (recur (dec k) (inc d))
                                                          (= \< (.charAt src (int k))) (if (= d 1) k (recur (dec k) (dec d)))
                                                          :else (recur (dec k) d)))]
                         (when k [(ws (dec k)) (mapv str/trim (str/split (subs src (inc k) j) #","))]))
                       [j []])]
        (when (and j (every? #(re-matches #"[A-Za-z_][A-Za-z_0-9]*" %) (remove #{""} args)) (not (some #{""} args)))
          (let [k (loop [k j] (if (and (>= k 0) (idc? (.charAt src (int k)))) (recur (dec k)) k))
                b (ws k)]
            (when (and (< k j) (not (and (pos? b) (= \: (.charAt src (int b))))))
              [(subs src (inc k) (inc j)) (if (= args [""]) [] args)])))))))

(defn exception-specs
  "The exception specifications' checks of the unit `u` (see above)."
  [u starts ^String src ^String main]
  (binding [*exc-year* (cxx-year (:std u))]
  (let [out (java.util.ArrayList.)
        decls (java.util.HashMap.)
        heads (java.util.HashMap.)
        recs (java.util.HashMap.)
        mine? (fn [x] (= main (get-in x [:loc :file])))
        report! (fn [x nm] (let [[l c] (line-col starts (long (get-in x [:loc :offset])))]
                             (.add out {:line l :col c :kind :error :rule :exception-spec
                                        :msg (str "declaration of '" nm "' has a different exception specifier")})))
        excluded? (fn [f] (or (not (fn-kinds (:kind f))) (= "CXXDestructorDecl" (:kind f)) (:explicitlyDefaulted f)
                              (re-find #"^operator\s*(new|delete)" (str (:name f))) (not (mine? f)) (nil? (get-in f [:loc :offset]))))
        ;; enter! a declaration f under key k, its exception class c; `late` a friend of a class template the file instantiates
        enter! (fn [k f c friend-of]
                 (when c
                   (if-let [[of oc ofr] (.get decls k)]
                     (let [;; (round 54, fifth pass: C++11's [except.spec]/3, a dynamic exception specification is compatible
                           ;; with one of the same set of types alone, not with noexcept(false) or a non-throwing one; a
                           ;; declaration without one is not judged, as GCC)
                           dyn (or (and (map? oc) (map? c) (not= oc c))
                                   (and (map? oc) (#{:nfalse :nothrow} c)) (and (#{:nfalse :nothrow} oc) (map? c)))
                           oc (if (= :nfalse oc) :none oc) c (if (= :nfalse c) :none c)
                           bad (or dyn
                                   (and (#{:none :nothrow} oc) (#{:none :nothrow} c) (not= oc c))
                                   (and (vector? oc) (vector? c) (not= oc c))
                                   (and (= :none oc) (vector? c)) (and (vector? oc) (= :none c)))]
                       (when bad
                         (cond (#{:inst :uninst} friend-of) (when (= :inst friend-of) (report! f (:name f)))
                               (#{:inst :uninst} ofr) (when (= :inst ofr) (report! of (:name of)))
                               :else (report! f (:name f)))
                         ;; (cpp-decl2: the later declaration's specification is the one the next is held to, as GCC's
                         ;; merged declaration keeps it: cpp0x/noexcept46.C's friend g() noexcept(true) after friend g()
                         ;; noexcept(false) after g() noexcept(true))
                         (when-not (or (#{:inst :uninst} friend-of) (#{:inst :uninst} ofr))
                           (.put decls k [f c friend-of]))))
                     (.put decls k [f c friend-of]))))
        instantiated? (fn [rec nm]
                        (let [e (get-in rec [:range :end :offset])]
                          (boolean (and e (re-find (re-pattern (str "\\b" (java.util.regex.Pattern/quote nm) "\\s*<")) (subs src (min (.length src) (inc (long e)))))))))
        ;; a function or a function template: [f key-part exc-class own-names] or nil
        fn-of (fn [n]
                (let [tmpl? (= "FunctionTemplateDecl" (:kind n))
                      f (if tmpl? (last (:inner n)) n)
                      ps (when tmpl? (butlast (:inner n)))
                      names (map :name ps)]
                  (when (and (map? f) (not (excluded? f)) (every? some? names))
                    (let [[sig exc] (split-exc (str (get-in f [:type :qualType])))]
                      [f (str (when tmpl? (str "<" (str/join "," (map #(pr-str (tparam-key %)) ps)) ">")) (:name f) "|" (rename-params sig names))
                       (exc-class (when exc (rename-params exc names))) names]))))]
    (letfn [(region! [path nodes]
              (doseq [n nodes]
                (case (:kind n)
                  "LinkageSpecDecl" (region! path (:inner n))
                  "NamespaceDecl" (region! (str path (or (:name n) "(anonymous)") "::") (:inner n))
                  ("FunctionDecl" "FunctionTemplateDecl" "CXXMethodDecl")
                  (when-let [[f k c] (fn-of n)]
                    (let [off (long (get-in f [:loc :offset]))]
                      (if (qualified-name? src off)
                        (when-let [[cls args] (out-of-class src off)]
                          (when (and (= "CXXMethodDecl" (:kind f)) (not= "FunctionTemplateDecl" (:kind n))
                                     (.containsKey heads [path cls]) (= (vec args) (vec (.get heads [path cls]))))
                            (let [[sig exc] (split-exc (str (get-in f [:type :qualType])))]
                              (enter! [:member path cls (str (:name f) "|" (rename-params sig args))] f
                                      (exc-class (when exc (rename-params exc args))) nil))))
                        (enter! [:ns path k] f c nil))))
                  "ClassTemplateDecl" (when-let [rec (last (:inner n))] (class! path rec (map :name (butlast (:inner n))) (:name n)))
                  "CXXRecordDecl" (class! path n nil (:name n))
                  nil)))
            (class! [path rec cnames cname]
              (when (and cname (= "CXXRecordDecl" (:kind rec)))
                (.put heads [path cname] (vec cnames))
                ;; (round 54, fourth pass: [except.spec]/8, a function overriding a virtual function whose exception specification
                ;; is non-throwing has a non-throwing one too: GCC's "looser exception specification on overriding virtual
                ;; function", at the overrider; the bases the file's own non-template classes of its region, by their names, their
                ;; functions declared virtual; a deleted overrider, a destructor and a dependent specification not judged)
                (when (and (nil? cnames) (mine? rec)) (.put recs [path cname] rec))
                (when (and (nil? cnames) (mine? rec) (seq (:bases rec)))
                  (let [bases (fn bases [r seen]
                                (mapcat (fn [b] (let [bn (str/trim (str (get-in b [:type :qualType])))
                                                      br (.get recs [path bn])]
                                                  (when (and br (not (contains? seen bn))) (cons br (bases br (conj seen bn))))))
                                        (:bases r)))
                        bs (bases rec #{cname})]
                    (doseq [m (:inner rec)
                            :when (and (= "CXXMethodDecl" (:kind m)) (mine? m) (not (:explicitlyDeleted m)) (get-in m [:loc :offset]))
                            :let [[sig exc] (split-exc (str (get-in m [:type :qualType])))]
                            :when (#{:none :nfalse} (exc-class exc))]
                      (when (some (fn [br] (some (fn [bm] (and (= "CXXMethodDecl" (:kind bm)) (:virtual bm) (= (:name bm) (:name m))
                                                                (let [[bsig bexc] (split-exc (str (get-in bm [:type :qualType])))]
                                                                  (and (= bsig sig) (= :nothrow (exc-class bexc))))))
                                                 (:inner br)))
                                  bs)
                        (let [[l c] (line-col starts (long (get-in m [:loc :offset])))
                              [_ ret ps] (re-find #"^(.*?)\s*\((.*)\)(.*)$" sig)]
                          (.add out {:line l :col c :kind :error :rule :exception-spec
                                     :msg (str "looser exception specification on overriding virtual function 'virtual " ret " " cname "::" (:name m) "(" ps ")'")}))))))
                (let [inst (when cnames (if (instantiated? rec cname) :inst :uninst))]
                  (doseq [m (:inner rec)]
                    (case (:kind m)
                      "FriendDecl"
                      (doseq [x (:inner m)]
                        (when-let [[f k c] (fn-of x)]
                          (when (and (not (qualified-name? src (long (get-in f [:loc :offset]))))
                                     ;; (a friend naming the class template's parameters: a function of each specialization)
                                     (not-any? #(and (seq %) (re-find (re-pattern (str "\\b" (java.util.regex.Pattern/quote %) "\\b")) k)) cnames)
                                     (not (and (vector? c) (some #(and (seq %) (str/includes? (second c) %)) cnames))))
                            (enter! [:ns path k] f c (or inst :plain)))))
                      "CXXMethodDecl"
                      (when-not (excluded? m)
                        (when (every? some? cnames)
                          (let [[sig exc] (split-exc (str (get-in m [:type :qualType])))]
                            (enter! [:member path cname (str (:name m) "|" (rename-params sig cnames))] m
                                    (exc-class (when exc (rename-params exc cnames))) nil))))
                      nil)))))]
      (region! "" (:nodes u)))
    (vec out))))

;; (round 54, fourth pass) A union's members ([class.union.general]): no non-static data member of reference type (GCC's
;; "non-static data member 'b' in a union may not have reference type 'int&'", at the member; a dependent type only when
;; written as a reference); at most one variant member with a default member initializer ([class.mem.general]/11), an
;; anonymous structure's member counting as its structure's (GCC's "multiple fields in union 'U' initialized", at the union;
;; the union's own members alone are Sema's rule); a constructor's mem-initializer-list initializes at most one of its
;; members ([class.base.init]/5: GCC's "initializations for multiple members of 'B'", at the second; an in-class constructor).

(defn unions
  "The union checks of the unit `u` (see above)."
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        off-of (fn [x] (or (get-in x [:loc :offset]) (get-in x [:range :begin :offset])))
        mine? (fn [x] (let [f (or (get-in x [:loc :file]) (get-in x [:range :begin :file]))] (or (nil? f) (= main f))))
        report! (fn [x msg] (when-let [o (off-of x)]
                              (let [[l c] (line-col starts (long o))]
                                (.add out {:line l :col c :kind :error :rule :union :msg msg}))))
        nsdmi? (fn nsdmi? [r] (some (fn [m] (or (and (= "FieldDecl" (:kind m)) (:hasInClassInitializer m) (not (:isImplicit m)))
                                                (and (= "CXXRecordDecl" (:kind m)) (nil? (:name m)) (nsdmi? m))))
                                    (:inner r)))]
    (walk-nodes
     (fn [n _]
       (when (and (= "CXXRecordDecl" (:kind n)) (= "union" (:tagUsed n)) (:completeDefinition n) (mine? n) (off-of n))
         (let [ms (:inner n)]
           (doseq [m ms :when (and (= "FieldDecl" (:kind m)) (not (:isImplicit m)) (mine? m))
                   :let [qt (str (get-in m [:type :qualType]))]
                   :when (re-find #"&$" (str/trim qt))]
             (report! m (str "non-static data member '" (:name m) "' in a union may not have reference type '" (str/replace (str/trim qt) #"\s+(&&?)$" "$1") "'")))
           (let [direct (count (filter #(and (= "FieldDecl" (:kind %)) (:hasInClassInitializer %) (not (:isImplicit %))) ms))
                 anon (count (filter #(and (= "CXXRecordDecl" (:kind %)) (nil? (:name %)) (= "struct" (:tagUsed %)) (nsdmi? %)) ms))]
             (when (and (<= direct 1) (> (+ direct anon) 1))
               ;; (an anonymous union's location its brace, as GCC gives it)
               (report! (if (:name n) n (let [o (long (off-of n)) i (.indexOf src "{" (int o))] (if (>= i 0) {:loc {:offset i}} n)))
                        (str "multiple fields in union '" (or (:name n) "<unnamed union>") "' initialized"))))
           (doseq [c ms :when (and (= "CXXConstructorDecl" (:kind c)) (mine? c))]
             (when-let [i2 (second (filter #(and (= "CXXCtorInitializer" (:kind %)) (get-in % [:anyInit :name])) (:inner c)))]
               (report! (or (first (:inner i2)) c) (str "initializations for multiple members of '" (:name n) "'")))))))
     (:nodes u) nil)
    (vec out)))

;; (round 54, fourth pass) [class.mem.general]/? (CWG 1397), [class.default.ctor]/4: a default member initializer is a
;; complete-class context of its outermost enclosing class E, read at E's end; so a value-initialization `N()` of a class N
;; that is E or nested in E, whose implicit default constructor would use a default member initializer (N's own, or an
;; anonymous or member subobject's of a class nested in E), cannot be used in E's default member initializers or in its
;; member functions' default arguments: GCC's "default member initializer for 'A::i' required before the end of its
;; enclosing class", at the use. Not judged: a class with a user-declared constructor, templates, lambdas' bodies and
;; unevaluated operands.

(defn nsdmi-uses
  "The default member initializers' uses before their class's end in the unit `u` (see above)."
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        mine? (fn [x] (= main (get-in x [:loc :file])))
        class? (fn [x] (and (= "CXXRecordDecl" (:kind x)) (:completeDefinition x) (not= "union" (:tagUsed x))))]
    (doseq [e (let [tops (fn tops [ns] (mapcat #(if (#{"NamespaceDecl" "LinkageSpecDecl"} (:kind %)) (tops (:inner %)) [%]) ns))] (tops (:nodes u)))
            :when (and (class? e) (:name e) (mine? e))]
      (let [;; the classes nested in e, e among them, by name (an anonymous one by itself)
            nested (loop [todo [e] acc []]
                     (if-let [x (first todo)]
                       (recur (into (vec (rest todo)) (filter class? (:inner x))) (conj acc x))
                       acc))
            by-name (into {} (keep #(when (:name %) [(:name %) %]) nested))
            field-class (fn [f] (let [t (str/trim (str (get-in f [:type :qualType])))
                                      nm (last (str/split (str/replace t #"^(?:const|volatile|struct|class)\s+" "") #"::"))]
                                  (get by-name nm)))
            ;; the first default member initializer N's implicit default constructor uses: [class-name field-name] or nil
            needs (fn needs [n seen]
                    (when-not (or (contains? seen n) (some #(and (= "CXXConstructorDecl" (:kind %)) (not (:isImplicit %))) (:inner n)))
                      (let [seen (conj seen n)]
                        (some (fn [m]
                                (cond (and (= "FieldDecl" (:kind m)) (:hasInClassInitializer m)) [n m]
                                      (and (= "FieldDecl" (:kind m)) (not (re-find #"[&*\[]" (str (get-in m [:type :qualType])))))
                                      (when-let [c (field-class m)] (needs c seen))
                                      (and (class? m) (nil? (:name m))) (needs m seen)
                                      :else nil))
                              (:inner n)))))
            path (fn [n] (str/join "::" (keep #(when (and (:name %) (some (fn [y] (identical? y n)) (tree-seq map? (comp (partial filter map?) :inner) %))) (:name %)) nested)))
            uses (fn uses [x]
                   (cond (map? x) (case (:kind x)
                                    ("LambdaExpr" "UnaryExprOrTypeTraitExpr" "CXXTypeidExpr" "CXXNoexceptExpr") nil
                                    "CXXTemporaryObjectExpr"
                                    (concat (when (empty? (:inner x))
                                              (let [t (str/trim (str (get-in x [:type :qualType])))
                                                    nm (last (str/split t #"::"))]
                                                (when-let [n (get by-name nm)] [[x n]])))
                                            (uses (:inner x)))
                                    (mapcat (fn [[k v]] (when (and (not= k :_ent) (not= k :_t) (coll? v)) (uses v))) x))
                         (sequential? x) (mapcat uses x)
                         :else nil))
            sites (concat
                   (for [c nested, m (:inner c) :when (and (= "FieldDecl" (:kind m)) (:hasInClassInitializer m))] (:inner m))
                   (for [c nested, f (:inner c) :when (fn-kinds (:kind f)), pm (:inner f) :when (= "ParmVarDecl" (:kind pm))] (:inner pm)))]
        (doseq [site sites [x n] (uses site)]
          (when-let [[owner fld] (needs n #{})]
            (when-let [o (get-in x [:range :begin :offset])]
              (when (= main (or (get-in x [:range :begin :file]) main))
                (let [[l c] (line-col starts (long o))
                      on (if (:name owner) (path owner) (str (path e) "::<unnamed struct>"))]
                  (.add out {:line l :col c :kind :error :rule :nsdmi
                             :msg (str "default member initializer for '" on "::" (:name fld) "' required before the end of its enclosing class")}))))))))
    (vec (distinct out))))

;; (round 54, fifth pass) GCC's spelling of a function `nm` of the function type `qt` ("int (void)", "void *(unsigned long)"):
;; "int nm()", "void* nm(long unsigned int)" as far as the type's own text goes (pointers and references bound to their type).
(defn- fn-spelling ^String [^String nm ^String qt]
  (let [[sig _] (split-exc qt)
        [_ ret ps] (or (re-matches #"(?s)^(.*?)\s*\((.*)\)\s*$" (str sig)) [nil (str sig) ""])
        tight (fn [^String x] (str/replace (str/trim x) #"\s+([*&])" "$1"))
        ps (if (= "void" (str/trim ps)) "" (str/join ", " (map tight (remove str/blank? (str/split ps #",")))))]
    (str (tight ret) " " nm "(" ps ")")))

;; (round 54, fifth pass) [dcl.link]/6 (C++23 /5): two declarations of one function with different language linkages are
;; ill-formed; a function first declared with C++ language linkage (at namespace scope, or by a friend declaration of a
;; class at namespace scope, which declares it there) and then with C language linkage: GCC's "conflicting declaration of
;; 'int fork()' with 'C' linkage", at the later one. The same namespace, name and parameter types; both in the main file; a
;; later declaration without a linkage-specification takes the first's ([dcl.link]/5), not judged.
(defn linkage-conflicts
  "The language linkage check of the unit `u` (see above)."
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        seen (java.util.HashMap.)
        mine? (fn [x] (= main (get-in x [:loc :file])))
        key-of (fn [path f] [path (:name f) (str/replace (str/replace (first (split-exc (str (get-in f [:type :qualType])))) #"\(void\)" "()") #"\s+" " ")])
        enter! (fn [path f lang]
                 (when (and (= "FunctionDecl" (:kind f)) (:name f) (mine? f) (get-in f [:loc :offset])
                            (not (qualified-name? src (long (get-in f [:loc :offset])))))
                   (let [k (key-of path f)]
                     (if-let [old (.get seen k)]
                       (when (and (= :cpp old) (= :c lang))
                         (let [[l c] (line-col starts (long (get-in f [:loc :offset])))]
                           (.add out {:line l :col c :kind :error :rule :linkage
                                      :msg (str "conflicting declaration of '" (fn-spelling (:name f) (str (get-in f [:type :qualType]))) "' with 'C' linkage")})))
                       (.put seen k lang)))))]
    (letfn [(region! [path lang nodes]
              (doseq [n nodes]
                (case (:kind n)
                  "LinkageSpecDecl" (region! path (if (= "C" (:language n)) :c :cpp) (:inner n))
                  "NamespaceDecl" (region! (str path (or (:name n) "(anonymous)") "::") lang (:inner n))
                  "FunctionDecl" (enter! path n lang)
                  "CXXRecordDecl" (doseq [m (:inner n) :when (= "FriendDecl" (:kind m)) x (:inner m)] (enter! path x lang))
                  nil)))]
      (region! "" :cpp (:nodes u)))
    (vec out)))

;; (round 54, fifth pass) [basic.stc.dynamic.allocation]/1, [basic.stc.dynamic.deallocation]/3 (C++23 /2): a template
;; allocation or deallocation function has two or more parameters: GCC's "invalid template declaration of 'void operator
;; delete(void*)'", at the parameter list's closing parenthesis; a namespace's and a class's (static) ones, in the main file.
(defn alloc-templates
  "The allocation function templates' check of the unit `u` (see above)."
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)]
    (walk-nodes
     (fn [n parent]
       (when (= "FunctionTemplateDecl" (:kind n))
         (let [f (last (:inner n))
               nm (str (:name f))]
           (when (and (map? f) (re-matches #"operator\s*(new|delete)(\s*\[\s*\])?" nm) (= main (get-in f [:loc :file])) (get-in f [:loc :offset]))
             (let [ps (count (filter #(= "ParmVarDecl" (:kind %)) (:inner f)))]
               (when (< ps 2)
                 (let [o (long (get-in f [:loc :offset]))
                       open (.indexOf src "(" (int (+ o (count "operator"))))
                       close (when (>= open 0)
                               (loop [i (inc open) d 1]
                                 (cond (>= i (.length src)) nil
                                       (= \( (.charAt src i)) (recur (inc i) (inc d))
                                       (= \) (.charAt src i)) (if (= d 1) i (recur (inc i) (dec d)))
                                       :else (recur (inc i) d))))
                       [l c] (line-col starts (long (or close o)))
                       gnm (str/replace (str/replace nm #"operator\s*(new|delete)" "operator $1") #"\s*\[\s*\]" " []")
                       cls (when (= "CXXRecordDecl" (:kind parent)) (:name parent))]
                   (.add out {:line l :col c :kind :error :rule :alloc-template
                              :msg (str "invalid template declaration of '" (when cls "static ")
                                        (fn-spelling (str (when cls (str cls "::")) gnm) (str (get-in f [:type :qualType]))) "'")})))))))
       nil)
     (:nodes u) nil)
    (vec out)))

;; (round 54, fifth pass) [temp.local]/6: a template parameter's name is bound by no declaration in its scope; a class
;; template's member (a class, enumeration, function, data member, typedef or member template, not a friend) named as one of
;; the class template's own parameters: GCC's "declaration of 'struct U<non_template>::non_template' shadows template
;; parameter", at the member; the main file's class templates.
(defn tparam-shadows
  "The template parameters' shadowing check of the unit `u` (see above)."
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        tparam-kinds #{"TemplateTypeParmDecl" "NonTypeTemplateParmDecl" "TemplateTemplateParmDecl"}
        member-kinds #{"CXXRecordDecl" "EnumDecl" "CXXMethodDecl" "FieldDecl" "VarDecl" "TypedefDecl" "TypeAliasDecl"
                       "FunctionTemplateDecl" "ClassTemplateDecl" "VarTemplateDecl" "TypeAliasTemplateDecl"}]
    (walk-nodes
     (fn [n _]
       (when (= "ClassTemplateDecl" (:kind n))
         (let [ps (filter #(tparam-kinds (:kind %)) (:inner n))
               names (set (keep :name ps))
               rec (last (:inner n))]
           (when (and (seq names) (= "CXXRecordDecl" (:kind rec)) (= main (get-in rec [:loc :file])))
             (let [head (str (:name rec) "<" (str/join ", " (map #(or (:name %) "") ps)) ">")]
               (doseq [m (:inner rec)
                       :when (and (member-kinds (:kind m)) (not (:isImplicit m)) (contains? names (:name m))
                                  (= main (get-in m [:loc :file])) (get-in m [:loc :offset]))]
                 (let [[l c] (line-col starts (long (get-in m [:loc :offset])))
                       f (if (= "FunctionTemplateDecl" (:kind m)) (last (:inner m)) m)
                       what (case (:kind m)
                              ("CXXRecordDecl" "EnumDecl") (str (or (:tagUsed m) "enum") " " head "::" (:name m))
                              ("CXXMethodDecl" "FunctionTemplateDecl") (fn-spelling (str head "::" (:name m)) (str (get-in f [:type :qualType])))
                              (str (get-in m [:type :qualType] "") " " head "::" (:name m)))]
                   (.add out {:line l :col c :kind :error :rule :tparam-shadow
                              :msg (str "declaration of '" (str/trim what) "' shadows template parameter")}))))))))
     (:nodes u) nil)
    (vec out)))

;; (round 54, fifth pass) [dcl.spec.auto.general]/11 (C++14 [dcl.spec.auto]/11): a function whose declared return type
;; holds an undeduced placeholder cannot be named by an expression until a return statement of its definition deduced it:
;; GCC's "use of 'auto foo()' before deduction of 'auto'", at the name. The main file's functions of the global namespace
;; declared only so (`auto f();`, `auto& f();`, no trailing return type), never defined in the file, a declaration before
;; the use; their names' uses anywhere after.
(defn undeduced-uses
  "The undeduced placeholders' check of the unit `u` (see above)."
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        decls (java.util.HashMap.)
        bad (java.util.HashSet.)
        off (fn [x] (or (get-in x [:range :begin :offset]) (get-in x [:loc :offset])))]
    (doseq [n (:nodes u) :when (and (= "FunctionDecl" (:kind n)) (:name n))]
      (let [qt (str (get-in n [:type :qualType]))
            und (and (= main (get-in n [:loc :file])) (get-in n [:loc :offset])
                     (re-find #"^(const )?auto( |&|\*|\()" qt) (not (str/includes? qt "->"))
                     (not (some #(= "CompoundStmt" (:kind %)) (:inner n))))]
        (if und
          (when-not (.containsKey decls (:name n)) (.put decls (:name n) [(long (get-in n [:loc :offset])) qt]))
          (.add bad (:name n)))))
    (doseq [b bad] (.remove decls b))
    ;; (cpp-read, 2026-11-22: [dcl.spec.auto.general]/11 in the function's own body: its return type is deduced at its first
    ;; return statement, so a use of its name before that statement ends -- a recursive call in the first return's operand, or
    ;; with no return statement at all anywhere in the body -- is GCC's same error, at the use; a non-template function the unit
    ;; declares once, the main file's, the statements' returns outside a lambda's or a local class's body)
    (let [counts (java.util.HashMap.)]
      (walk-nodes (fn [x _] (when (and (= "FunctionDecl" (:kind x)) (:name x)) (.put counts (:name x) (inc (long (or (.get counts (:name x)) 0))))))
                  (:nodes u) nil)
      (walk-nodes
       (fn [n parent]
         (when (and (= "FunctionDecl" (:kind n)) (:name n) (not= "FunctionTemplateDecl" (:kind parent))
                    (= 1 (.get counts (:name n))) (= main (get-in n [:loc :file])) (get-in n [:loc :offset]))
           (let [qt (str (get-in n [:type :qualType]))
                 body (some #(when (= "CompoundStmt" (:kind %)) %) (:inner n))]
             (when (and body (re-find #"^(const )?auto( |&|\*|\()" qt) (not (str/includes? qt "->")))
               (let [first-ret (atom nil)
                     find-ret (fn find-ret [x]
                                (cond (map? x) (cond (#{"LambdaExpr" "CXXRecordDecl"} (:kind x)) nil
                                                     (= "ReturnStmt" (:kind x)) (when (nil? @first-ret) (reset! first-ret (get-in x [:range :end :offset])))
                                                     :else (doseq [[k v] x :when (and (not= k :_ent) (coll? v))] (find-ret v)))
                                      (coll? x) (doseq [y x] (find-ret y))
                                      :else nil))
                     _ (find-ret (:inner body))
                     lim (or @first-ret Long/MAX_VALUE)
                     seen (java.util.HashSet.)]
                 (walk-nodes
                  (fn [x _]
                    (when (and (= "DeclRefExpr" (:kind x)) (= (:name n) (get-in x [:referencedDecl :name])))
                      (when-let [xo (get-in x [:range :begin :offset])]
                        (when (and (<= (long xo) (long lim)) (= main (or (get-in x [:range :begin :file]) main)))
                          (let [[l c] (line-col starts (long xo))]
                            (when (.add seen l)
                              (.add out {:line l :col c :kind :error :rule :undeduced
                                         :msg (str "use of '" (str/replace (fn-spelling (:name n) qt) #"^auto &" "auto& ") "' before deduction of 'auto'")})))))))
                  (:inner body) nil))))))
       (:nodes u) nil))
    (when (seq decls)
      (walk-nodes
       (fn [x _]
         (when (= "DeclRefExpr" (:kind x))
           (when-let [[o qt] (.get decls (get-in x [:referencedDecl :name]))]
             (when-let [xo (off x)]
               (when (and (> (long xo) (long o)) (= main (or (get-in x [:range :begin :file]) main)))
                 (let [[l c] (line-col starts (long xo))
                       nm (get-in x [:referencedDecl :name])]
                   (.add out {:line l :col c :kind :error :rule :undeduced
                              :msg (str "use of '" (str/replace (fn-spelling nm qt) #"^auto &" "auto& ") "' before deduction of 'auto'")})))))))
       (:nodes u) nil))
    (vec out)))

;; (round 54, fifth pass) [temp.param]/12: a friend function template declaration with a default template argument is a
;; definition, and no other declaration of the function template is reachable from it or it from one: GCC's "default template
;; arguments may not be used in template friend declarations" at a friend that is no definition, and "redeclaration of
;; friend 'template<class T> void g(X)' may not have default template arguments" at a namespace's later declaration with one
;; of a function template a friend declared first (by name, the main file's).
(defn friend-default-targs
  "The friend templates' default arguments check of the unit `u` (see above)."
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        friends (java.util.HashMap.)
        mine? (fn [x] (and (= main (get-in x [:loc :file])) (get-in x [:loc :offset])))
        dflt? (fn [t] (some #(and (#{"TemplateTypeParmDecl" "NonTypeTemplateParmDecl" "TemplateTemplateParmDecl"} (:kind %))
                                  (or (:_dflt %) (some (fn [a] (= "TemplateArgument" (:kind a))) (:inner %))))
                            (butlast (:inner t))))
        body? (fn [f] (some #(= "CompoundStmt" (:kind %)) (:inner f)))
        report! (fn [f msg] (let [[l c] (line-col starts (long (get-in f [:loc :offset])))]
                              (.add out {:line l :col c :kind :error :rule :friend-default :msg msg})))
        head (fn [t] (str "template<" (str/join ", " (map #(str (if (= "TemplateTypeParmDecl" (:kind %)) "class" "auto") " " (:name %)) (butlast (:inner t)))) "> "))]
    (doseq [n (:nodes u)]
      (case (:kind n)
        "CXXRecordDecl"
        (doseq [m (:inner n) :when (= "FriendDecl" (:kind m)) t (:inner m)
                :when (= "FunctionTemplateDecl" (:kind t))
                :let [f (last (:inner t))]
                :when (and (map? f) (mine? f) (not (qualified-name? src (long (get-in f [:loc :offset])))))]
          (when (and (dflt? t) (not (body? f)))
            (report! f "default template arguments may not be used in template friend declarations"))
          (when-not (.containsKey friends (:name f)) (.put friends (:name f) t)))
        "FunctionTemplateDecl"
        (let [f (last (:inner n))]
          (when-let [ft (and (map? f) (mine? f) (dflt? n) (.get friends (:name f)))]
            (report! f (str "redeclaration of friend '" (head ft) (fn-spelling (:name f) (str (get-in (last (:inner ft)) [:type :qualType])))
                            "' may not have default template arguments"))))
        nil))
    (vec out)))

;; (round 54, fifth pass) [dcl.spec.auto.general]/? (C++23 [dcl.type.auto.deduct]/2.1): a function's return type `auto*` or
;; `auto&` is deduced from its return statements' operands; `return;` deduces void, which no such type takes: GCC's
;; "return-statement with no value, in function returning 'auto*'", at the statement (a lambda's body apart).
(defn auto-void-returns
  "The placeholder return types' check of the unit `u` (see above)."
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)]
    (walk-nodes
     (fn [n _]
       (when (and (#{"FunctionDecl" "CXXMethodDecl"} (:kind n)) (= main (get-in n [:loc :file])))
         (let [qt (str (get-in n [:type :qualType]))]
           (when-let [[_ ptr] (and (not (str/includes? qt "->")) (re-find #"^auto\s*(\*|&&|&)\s*\(" qt))]
             (letfn [(rets [x] (cond (map? x) (case (:kind x)
                                                "LambdaExpr" nil
                                                "ReturnStmt" (if (empty? (:inner x)) [x] nil)
                                                (mapcat (fn [[k v]] (when (and (not= k :_ent) (coll? v)) (rets v))) x))
                                     (sequential? x) (mapcat rets x)
                                     :else nil))]
               (doseq [b (:inner n) :when (= "CompoundStmt" (:kind b)) r (rets b)]
                 (when-let [o (get-in r [:range :begin :offset])]
                   (let [[l c] (line-col starts (long o))]
                     (.add out {:line l :col c :kind :error :rule :auto-return
                                :msg (str "return-statement with no value, in function returning 'auto" ptr "'")})))))))))
     (:nodes u) nil)
    ;; (cpp-read, 2026-11-22: [dcl.type.decltype]/1.3 with [dcl.type.auto.deduct]/5, decltype(auto) deduces from its
    ;; initializer as decltype does: an unparenthesized id-expression naming a function gives the function's type, which no
    ;; variable has ([dcl.fct]/? [basic.compound]): GCC's "initializer for 'decltype(auto) a' has function type; did you forget
    ;; the '()'?", at the declaration; the name the unit's function's and no variable's, parameter's, member's or binding's)
    (let [fns (java.util.HashSet.) vars (java.util.HashSet.)]
      (walk-nodes (fn [x _] (when-let [nm (:name x)]
                              (case (:kind x)
                                ("FunctionDecl" "CXXMethodDecl") (.add fns nm)
                                ("VarDecl" "ParmVarDecl" "FieldDecl" "BindingDecl" "EnumConstantDecl" "NonTypeTemplateParmDecl") (.add vars nm)
                                nil)))
                  (:nodes u) nil)
      (walk-nodes
       (fn [n _]
         (when (and (= "VarDecl" (:kind n)) (:name n) (= main (get-in n [:loc :file])) (get-in n [:loc :offset])
                    (= "decltype(auto)" (str/trim (str (get-in n [:type :qualType])))))
           (let [init (last (:inner n))]
             (when (and (= "DeclRefExpr" (:kind init)) (.contains fns (get-in init [:referencedDecl :name]))
                        (not (.contains vars (get-in init [:referencedDecl :name]))))
               (let [[l c] (line-col starts (long (get-in n [:loc :offset])))]
                 (.add out {:line l :col c :kind :error :rule :auto-return
                            :msg (str "initializer for 'decltype(auto) " (:name n) "' has function type; did you forget the '()'?")}))))))
       (:nodes u) nil))
    (vec (distinct out))))

;; cpp-read (2026-11-22): GCC's classification built-ins take floating-point operands (c-family's
;; check_builtin_function_arguments: __builtin_isfinite and its kin one REAL_TYPE operand, "non-floating-point argument in call to
;; function", at it; __builtin_isless and its kin two, both real or one real and one integer, "non-floating-point arguments in
;; call to function", at the call): an operand the tree shows is neither, a function's name (the unit's function and no
;; variable's) or a string literal, at the call's line.
(def ^:private fp-builtins-1 #{"__builtin_isfinite" "__builtin_isinf" "__builtin_isinf_sign" "__builtin_isnan" "__builtin_isnormal"
                               "__builtin_issignaling" "__builtin_signbit"})
(def ^:private fp-builtins-2 #{"__builtin_isgreater" "__builtin_isgreaterequal" "__builtin_isless" "__builtin_islessequal"
                               "__builtin_islessgreater" "__builtin_isunordered" "__builtin_iseqsig"})

(defn builtin-fp-args
  "The classification built-ins' operands' check of the unit `u` (see above)."
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        fns (java.util.HashSet.) vars (java.util.HashSet.)]
    (walk-nodes (fn [x _] (when-let [nm (:name x)]
                            (case (:kind x)
                              ("FunctionDecl" "CXXMethodDecl") (.add fns nm)
                              ("VarDecl" "ParmVarDecl" "FieldDecl" "BindingDecl" "EnumConstantDecl" "NonTypeTemplateParmDecl") (.add vars nm)
                              nil)))
                (:nodes u) nil)
    (walk-nodes
     (fn [x _]
       (when (= "CallExpr" (:kind x))
         (let [[callee & args] (:inner x)
               nm (when (= "DeclRefExpr" (:kind callee)) (get-in callee [:referencedDecl :name]))
               bad? (fn [a] (or (= "StringLiteral" (:kind a))
                                (and (= "DeclRefExpr" (:kind a)) (.contains fns (get-in a [:referencedDecl :name]))
                                     (not (.contains vars (get-in a [:referencedDecl :name]))))))]
           (when-let [o (and nm (or (and (fp-builtins-1 nm) (= 1 (count args))) (and (fp-builtins-2 nm) (= 2 (count args))))
                             (some bad? args) (get-in callee [:range :begin :offset]))]
             (when (= main (or (get-in callee [:range :begin :file]) main))
               (let [[l c] (line-col starts (long o))]
                 (.add out {:line l :col c :kind :error :rule :builtin-args
                            :msg (str (if (fp-builtins-1 nm) "non-floating-point argument" "non-floating-point arguments") " in call to function '" nm "'")})))))))
     (:nodes u) nil)
    (vec out)))

;; cpp-read (2026-11-22): [expr.reinterpret.cast]/11, a glvalue is cast to a reference type, a prvalue not: GCC's "invalid cast of
;; a prvalue expression of type 'T1' to type 'T2'" (typeck.cc's build_reinterpret_cast_1), at the cast; the operand a prvalue the
;; tree shows, a literal but a string literal, or a call of the unit's function (no variable's name) every declaration of which
;; returns no reference.
(defn reinterpret-prvalues
  "The reinterpret_casts' prvalue operands' check of the unit `u` (see above)."
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        rets (java.util.HashMap.) vars (java.util.HashSet.)]
    (walk-nodes (fn [x _] (when-let [nm (:name x)]
                            (case (:kind x)
                              "FunctionDecl" (.put rets nm (conj (or (.get rets nm) []) (str (get-in x [:type :qualType]))))
                              ("VarDecl" "ParmVarDecl" "FieldDecl" "BindingDecl" "EnumConstantDecl" "NonTypeTemplateParmDecl" "CXXMethodDecl") (.add vars nm)
                              nil)))
                (:nodes u) nil)
    (walk-nodes
     (fn [x _]
       (when (and (= "CXXReinterpretCastExpr" (:kind x)) (#{"lvalue" "xvalue"} (:valueCategory x)))
         (let [a (first (:inner x))
               callee (when (= "CallExpr" (:kind a)) (first (:inner a)))
               cn (when (= "DeclRefExpr" (:kind callee)) (get-in callee [:referencedDecl :name]))
               ret (fn [^String q] (when-let [[_ r] (re-find #"^(.*?)\s*\(" q)] (str/trim r)))
               intype (cond (#{"IntegerLiteral" "FloatingLiteral" "CharacterLiteral" "CXXBoolLiteralExpr" "CXXNullPtrLiteralExpr"} (:kind a))
                            (str (get-in a [:type :qualType]))
                            (and cn (seq (.get rets cn)) (not (.contains vars cn)))
                            (let [rs (map ret (.get rets cn))]
                              (when (and (every? some? rs) (apply = rs) (not (re-find #"&|^auto|^decltype" (first rs)))) (first rs)))
                            :else nil)]
           (when-let [o (and intype (get-in x [:range :begin :offset]))]
             (when (= main (or (get-in x [:range :begin :file]) main))
               (let [[l c] (line-col starts (long o))]
                 (.add out {:line l :col c :kind :error :rule :reinterpret
                            :msg (str "invalid cast of a prvalue expression of type '" intype "'")})))))))
     (:nodes u) nil)
    (vec out)))

;; queue 460: [temp.variadic]/5, "a pack whose name appears within the pattern of a pack expansion is expanded by that
;; expansion ... an appearance of a name of a pack that is not expanded is ill-formed" (GCC's "parameter packs not expanded with
;; '...'"). Clean-room from the standard, over the native parser's tree of the main file: the packs of each template head (a
;; template parameter declared with `...`; an inner head's parameter of the same name not a pack hides it) and the function
;; parameter packs (a parameter whose type ends in `...`), named (a) by a DeclRefExpr whose entity is a pack (:ty {:t :pk}) or
;; (b) in a type the declaration writes (the :qualType of a variable, member, alias, typedef, parameter, function, a cast's or a
;; functional construction's type, a fixed underlying type, a base not written with `...`), outside every PackExpansionExpr,
;; SizeOfPackExpr, CXXFoldExpr and PackIndexingExpr and not a lambda's capture initializer; in a type's text a name is expanded
;; when an element of a bracket it is in (a template argument, a function parameter, the whole type) holds `...` at the element's
;; own depth, sizeof...(N) and N...[i] expanding their operand. Constructs the tree holds no text for (mem-initializers,
;; attributes, exception specifications, requires-expressions' parameters) are not judged.

(defn- pack-text-tokens [^String s]
  (re-seq #"\.\.\.|::|->|[A-Za-z_][A-Za-z_0-9]*|[<>()\[\]{},.]|[^\sA-Za-z_0-9<>()\[\]{},.]" s))

(defn unexpanded-in-text
  "The names of `packs` (a set) that appear unexpanded in the type text `s` (see above), or nil."
  [packs ^String s]
  (when (and (seq packs) s (re-find #"[A-Za-z_]" s))
    (let [ts (vec (pack-text-tokens s))
          n (count ts)
          ;; each token's depth, and the [start end) of the element it is in at each depth (from the brackets and commas)
          opens #{"<" "(" "[" "{"} closes #{">" ")" "]" "}"}
          ;; (a `>` closes an angle bracket only when one is open: `->` and comparisons are other tokens or not in types)
          depth (loop [i 0 d 0 stack [] out (transient [])]
                  (if (= i n) (persistent! out)
                      (let [t (ts i)]
                        (cond (opens t) (recur (inc i) (inc d) (conj stack t) (conj! out d))
                              (and (closes t) (seq stack)) (recur (inc i) (dec d) (pop stack) (conj! out (dec d)))
                              :else (recur (inc i) d stack (conj! out d))))))
          d-of (fn [i] (long (depth i)))
          ;; the element of token i at the depth k (k <= its depth): back and forward to a comma or bracket at depth k-1..k
          elem (fn [i k]
                 (let [k (long k)
                       lo (loop [j (dec (long i))] (if (< j 0) 0
                                                       (let [t (ts j) dj (d-of j)]
                                                         (if (or (and (= t ",") (= dj k)) (and (opens t) (= dj (dec k)))) (inc j) (recur (dec j))))))
                       hi (loop [j (inc (long i))] (if (>= j n) n
                                                       (let [t (ts j) dj (d-of j)]
                                                         (if (or (and (= t ",") (= dj k)) (and (closes t) (= dj (dec k)))) j (recur (inc j))))))]
                   [lo hi]))
          ;; the token ranges sizeof...( ... ) covers
          sized (set (for [i (range (- n 2)) :when (and (= "sizeof" (ts i)) (= "..." (ts (inc i))) (= "(" (ts (+ i 2))))
                           j (range (+ i 3) (or (first (filter #(and (= ")" (ts %)) (= (d-of %) (d-of i))) (range (+ i 3) n))) n))]
                       j))
          expanded? (fn [i]
                      (or (contains? sized i)
                          (and (< (inc (long i)) n) (= "..." (ts (inc i))))
                          (boolean (some (fn [k] (let [[lo hi] (elem i k)]
                                                   (some #(and (= "..." (ts %)) (= (d-of %) k)) (range lo hi))))
                                         (range (d-of i) -1 -1)))))]
      (seq (distinct (for [i (range n) :let [t (ts i)]
                           :when (contains? packs t)
                           :when (not (and (pos? i) (#{"::" "." "->"} (ts (dec i)))))
                           :when (not (expanded? i))]
                       t))))))

;; (a mem-initializer's expansion, B(b)..., is no PackExpansionExpr in the tree: a CXXCtorInitializer is not judged)
(def ^:private pack-expanders #{"PackExpansionExpr" "SizeOfPackExpr" "CXXFoldExpr" "PackIndexingExpr" "CXXCtorInitializer"})
(def ^:private pack-decl-kinds #{"VarDecl" "FieldDecl" "TypeAliasDecl" "TypedefDecl" "ParmVarDecl" "FunctionDecl" "CXXMethodDecl"
                                 "CXXConstructorDecl" "CXXConversionDecl" "CXXFunctionalCastExpr" "CStyleCastExpr" "CXXStaticCastExpr"
                                 "CXXReinterpretCastExpr" "CXXConstCastExpr" "CXXUnresolvedConstructExpr" "CXXTemporaryObjectExpr"
                                 ;; (queue 497: a friend's declared type)
                                 "FriendDecl"})
(def ^:private tparam-kinds #{"TemplateTypeParmDecl" "NonTypeTemplateParmDecl" "TemplateTemplateParmDecl"})

;; (queue 497: the template heads of an out-of-line member's definition, which the tree holds no parameters of: read from the
;; source text at the declaration's start, `template <...>` after `template <...>`, a parameter a pack when `...` at the
;; head's own depth is followed by its name)
(defn- head-packs
  "The names of the packs the template heads at the source offset `o` of `src` declare (a set, possibly empty)."
  [^String src o]
  (loop [i (long o) acc #{}]
    (let [m (re-matcher #"\Gtemplate\s*<" src)
          j (loop [j i] (if (and (< j (count src)) (Character/isWhitespace (.charAt src j))) (recur (inc j)) j))]
      (if-not (and (< j (count src)) (.find (.region m (int j) (count src))))
        acc
        (let [b (.end m)
              ;; the head's closing `>`: the brackets' depth, a `>` closing only an open `<`; its parameters split at depth 0
              [e ps] (loop [k b stack [] start b ps []]
                       (if (>= k (count src)) [nil ps]
                           (let [c (.charAt src k)]
                             (cond (and (= c \>) (empty? stack)) [k (conj ps (subs src start k))]
                                   (and (= c \,) (empty? stack)) (recur (inc k) stack (inc k) (conj ps (subs src start k)))
                                   (#{\< \( \[ \{} c) (recur (inc k) (conj stack c) start ps)
                                   (and (#{\) \] \}} c) (seq stack)) (recur (inc k) (pop stack) start ps)
                                   (and (= c \>) (= \< (peek stack))) (recur (inc k) (pop stack) start ps)
                                   :else (recur (inc k) stack start ps)))))]
          (if-not e
            acc
            (recur (inc (long e))
                   (into acc (keep (fn [^String q] (second (re-find #"^[^<(\[{]*\.\.\.\s*([A-Za-z_][A-Za-z_0-9]*)\s*(?:=.*)?$" (str/trim (loop [q q] (let [r (str/replace q #"<[^<>]*>" "")] (if (= r q) q (recur r)))))))) ps)))))))))

(defn- explicit-text
  "The condition of an `explicit(...)` written in `src` between the offsets `b` and `e`, or nil."
  [^String src b e]
  (when (and b e (< (long b) (long e)) (<= (long e) (count src)))
    (let [t (subs src (int b) (int e))]
      (when-let [m (re-find #"\bexplicit\s*\(" t)]
        (let [o (+ (.indexOf t ^String m) (count m))]
          (loop [k o d 1]
            (when (< k (count t))
              (let [c (.charAt t k)]
                (cond (= c \() (recur (inc k) (inc d))
                      (= c \)) (if (= d 1) (subs t o k) (recur (inc k) (dec d)))
                      :else (recur (inc k) d))))))))))

(defn- no-strings ^String [^String s] (when s (str/replace s #"\"(?:[^\"\\]|\\.)*\"" "\"\"")))

(defn unexpanded-packs
  "[temp.variadic]/5's unexpanded packs in the unit `u`'s main file (see above): an error a declaration or expression."
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        seen (java.util.HashSet.)
        off-of (fn [x] (or (get-in x [:range :begin :offset]) (get-in x [:loc :offset])))
        mine? (fn [x] (let [f (or (get-in x [:range :begin :file]) (get-in x [:loc :file]))] (= main f)))
        report! (fn [x what]
                  (when-let [o (off-of x)]
                    (let [[l c] (line-col starts (long o))]
                      (when (.add seen [l c])
                        (.add out {:line l :col c :kind :error :rule :pack
                                   :msg (str "parameter packs not expanded with '...' (" what ")")})))))
        ;; (GCC diagnoses a lambda's unexpanded pack at the lambda's full expression: at the lambda, or at the call's `(` after
        ;; its `}` when the lambda is called at once: lambda-variadic7.C, lambda-variadic10.C)
        lam-at (fn [lam parent]
                 (if (and (= "CallExpr" (:kind parent)) (identical? lam (first (:inner parent))))
                   {:range {:begin {:offset (get-in lam [:range :end :offset])}}}
                   lam))
        ;; (queue 497: a mem-initializer not followed by `...` is no expansion: the source after its last argument's end, past
        ;; the initializer's own closing `)` or `}`, does not start with `...`; one the tree holds no argument range of stays
        ;; unjudged)
        ctor-init-unexpanded? (fn [x]
                                (when-let [e (some #(when (map? %) (get-in % [:range :end :offset])) (:inner x))]
                                  (let [n (count src)
                                        c (loop [k (long e) d 0]
                                            (when (< k n)
                                              (let [ch (.charAt src (int k))]
                                                (cond (#{\( \[ \{} ch) (recur (inc k) (inc d))
                                                      (#{\) \] \}} ch) (if (zero? d) k (recur (inc k) (dec d)))
                                                      :else (recur (inc k) d)))))]
                                    (when c
                                      (let [t (str/triml (subs src (inc (long c)) (min n (+ (long c) 40))))]
                                        (not (str/starts-with? t "...")))))))
        walk (fn walk [x packs at parent]
               (when (map? x)
                 (let [k (:kind x)
                       here (or at x)]
                   (when-not (and (pack-expanders k) (not (and (= "CXXCtorInitializer" k) (ctor-init-unexpanded? x))))
                     (let [;; a template head's parameters: its packs added, a non-pack of the same name hiding an outer pack
                           ps (filter #(tparam-kinds (:kind %)) (when (vector? (:inner x)) (:inner x)))
                           ;; (queue 497: a template template parameter pack is marked :_pack)
                           packs (reduce (fn [s p] (if (:name p) (if (or (:isParameterPack p) (:_pack p)) (conj s (:name p)) (disj s (:name p))) s)) packs ps)
                           ;; (queue 497: an out-of-line definition's own heads, read from the text)
                           qual (when (and (string? (:_qual x)) (pos? (long (or (:_qtmpl x) 0))) (mine? x)) (:_qual x))
                           packs (if qual (into packs (head-packs src (off-of x))) packs)
                           ;; a function's parameter packs (their names in its types and body)
                           fps (when (#{"FunctionDecl" "CXXMethodDecl" "CXXConstructorDecl" "CXXConversionDecl"} k)
                                 (keep #(when (and (map? %) (= "ParmVarDecl" (:kind %)) (:name %)
                                                   (str/ends-with? (str/trim (str (get-in % [:type :qualType]))) "..."))
                                          (:name %))
                                       (:inner x)))
                           packs (into packs fps)
                           ;; (a partial specialization's arguments, its text from the name to its body: GCC drops the
                           ;; specialization with the error, its members not diagnosed)
                           spec-bad (when (and (#{"ClassTemplatePartialSpecializationDecl" "VarTemplatePartialSpecializationDecl"} k) (seq packs) (mine? x))
                                      ;; (queue 497: a variable template's, from its VarDecl's name)
                                      (when-let [o (if (= "VarTemplatePartialSpecializationDecl" k)
                                                     (some #(when (= "VarDecl" (:kind %)) (get-in % [:loc :offset])) (:inner x))
                                                     (get-in x [:loc :offset]))]
                                        (let [e (let [b (.indexOf src "{" (int o)) c (.indexOf src ";" (int o))]
                                                  (cond (neg? b) c (neg? c) b :else (min b c)))]
                                          (when (pos? e) (unexpanded-in-text packs (subs src (int o) (int e)))))))]
                       (if spec-bad
                         (report! {:loc (:loc x)} (str "'" (first spec-bad) "'"))
                         (do
                           (when (and (seq packs) (mine? x))
                             (when (and (= "DeclRefExpr" k) (= :pk (get-in x [:_ent :ty :t])))
                               (report! here (str "'" (get-in x [:referencedDecl :name]) "'")))
                             (when (and (pack-decl-kinds k) (not (:isImplicit x)))
                               (when-let [bad (unexpanded-in-text packs (str (get-in x [:type :qualType])))] (report! here (str "'" (first bad) "'"))))
                             ;; (queue 497: the texts the tree keeps of other constructs: an out-of-line definition's qualifier
                             ;; (at its name), a DeclRefExpr's nested-name-specifier, sizeof's or alignof's type operand, an
                             ;; attribute's argument, a using-declaration, and a constructor's or conversion's explicit(cond))
                             (when qual
                               (when-let [bad (unexpanded-in-text packs qual)] (report! (if (:loc x) {:loc (:loc x)} here) (str "'" (first bad) "'"))))
                             (when (= "DeclRefExpr" k)
                               (doseq [q (:qualifier x) :when (string? q)]
                                 (when-let [bad (unexpanded-in-text packs q)] (report! here (str "'" (first bad) "'")))))
                             (when (= "UnaryExprOrTypeTraitExpr" k)
                               (when-let [bad (unexpanded-in-text packs (get-in x [:argType :qualType]))] (report! here (str "'" (first bad) "'"))))
                             (when (= "NativeAttr" k)
                               (when-let [bad (unexpanded-in-text packs (no-strings (:_arg x)))] (report! here (str "'" (first bad) "'"))))
                             (when (= "UsingDecl" k)
                               (when-let [bad (unexpanded-in-text packs (:_text x))] (report! here (str "'" (first bad) "'"))))
                             (when (#{"CXXConstructorDecl" "CXXConversionDecl"} k)
                               (when-let [bad (unexpanded-in-text packs (explicit-text src (get-in x [:range :begin :offset]) (get-in x [:loc :offset])))]
                                 (report! here (str "'" (first bad) "'"))))
                             (when-let [ft (get-in x [:fixedUnderlyingType :qualType])]
                               (when-let [bad (unexpanded-in-text packs ft)] (report! here (str "'" (first bad) "'"))))
                             (when (= "CXXRecordDecl" k)
                               (doseq [b (:bases x) :when (not (:isPackExpansion b))]
                                 (when-let [bad (unexpanded-in-text packs (str (get-in b [:type :qualType])))] (report! here (str "'" (first bad) "'"))))))
                           (when (vector? (:inner x))
                             (if (= "LambdaExpr" k)
                               ;; (a lambda: its body and its call operator's declaration, at the lambda's full expression; its
                               ;; captures' initializers, whose `...` the tree does not keep, not judged)
                               (let [at2 (or at (lam-at x parent))
                                     ;; (queue 497: a generic lambda's own packs, `auto...` parameters and its own template
                                     ;; head's packs, judged in its body at the construct itself)
                                     gl (some #(when (map? %) (:_glam %)) (:inner x))
                                     own (set (concat (keep #(when (and (map? %) (:name %) (str/ends-with? (str/trim (str (get-in % [:type :qualType]))) "..."))
                                                               (:name %))
                                                            (:params gl))
                                                      (keep #(when (and (map? %) (:name %) (or (:isParameterPack %) (:_pack %))) (:name %)) (:tparams gl))))]
                                 (doseq [y (:inner x) :when (and (map? y) (#{"CompoundStmt" "CXXRecordDecl"} (:kind y)))]
                                   (walk y packs at2 x))
                                 (when (seq own)
                                   (doseq [y (:inner x) :when (and (map? y) (= "CompoundStmt" (:kind y)))]
                                     (walk y own nil x))))
                               (doseq [y (:inner x)] (walk y packs at x)))))))))))]
    (doseq [n (:nodes u) :when (mine? n)] (walk n #{} nil nil))
    (vec out)))

(defn type-exprs
  "cpp-read (2026-11-22): a type's name the parser met where an expression's primary stands, with no ( or { after it for a
  functional cast (the parser's :_typex: [expr.prim.id]/1, an id-expression names no type), GCC's \"expected
  primary-expression before X\" (cp_parser_primary_expression), at the name; once a line."
  [u starts _ _]
  (let [out (java.util.ArrayList.)]
    (walk-nodes (fn [n _]
                  (when-let [[off nx] (:_typex n)]
                    (let [[l c] (line-col starts (long off))]
                      (.add out {:line l :col c :kind :error :rule :type-expr
                                 :msg (str "expected primary-expression before '" nx "' token")}))))
                ;; (a decltype's operand the parser kept beside the tree, :decltypes)
                [(:nodes u) (vec (vals (:decltypes u)))] nil)
    (vec (vals (into (sorted-map) (map (juxt :line identity) out))))))

;; ---------------------------------------------------------------------------------------------
;; GNU's extensions' rules (cpp-gnu, the user's decision of 2026-11-22: CP398 (c)'s :gcc-own-rules built): each rule restated from
;; the GCC 15.2 manual (gcc/doc/extend.texi and invoke.texi of the pinned gcc-15.2.0.tar.xz: "Common Function Attributes",
;; "Common Type Attributes", "Common Variable Attributes", "C++-Specific Variable, Function, and Type Attributes", "Unnamed
;; struct/union fields within structs/unions") and the dg-error lines of the g++.dg tests that state it, clean-room: no GCC code
;; read or ported, the messages Arbace's own in GCC's words where a test names them (the dg verdict compares lines).

(defn- gnu-attr-name ^String [a] (str/replace (str (:_gnu a)) #"^__|__$" ""))

(defn- gnu-attrs-of
  "The GNU attributes (NativeAttr nodes with :_gnu) among the node's inner nodes, by bare name."
  [n]
  (filter #(and (= "NativeAttr" (:kind %)) (:_gnu %)) (:inner n)))

(defn- int-type-size
  "The size in bytes of a builtin integer, character, boolean or pointer type's spelling on x86-64 (the psABI's), or nil."
  [^String qt]
  (let [t (-> qt (str/replace #"\b(?:const|volatile)\b" "") str/trim (str/replace #"\s+" " "))]
    (cond
      (re-find #"[*&]$" t) 8
      (re-matches #"(?:unsigned |signed )?char|bool|char8_t" t) 1
      (re-matches #"(?:unsigned )?short(?: int)?|char16_t" t) 2
      (re-matches #"(?:unsigned )?int|unsigned|char32_t|wchar_t" t) 4
      (re-matches #"(?:unsigned )?long(?: long)?(?: int)?" t) 8
      (re-matches #"(?:unsigned )?__int128" t) 16
      :else nil)))

(defn- float-type-size [^String qt]
  (let [t (-> qt (str/replace #"\b(?:const|volatile)\b" "") str/trim (str/replace #"\s+" " "))]
    (case t "float" 4 "double" 8 "long double" 16 "_Float16" 2 "__float128" 16
      ;; (cpp-extfloat: GCC's extended floating types)
      "_Float32" 4 "_Float64" 8 "_Float128" 16 "_Float32x" 8 "_Float64x" 16 "__bf16" 2 nil)))

(defn gnu-rules
  "The GNU extensions' rules over the main file's nodes (see above):
  - abi_tag: each argument a narrow string literal naming an identifier (the manual's \"abi_tag (\\\"tag\\\", ...)\": tags are
    identifiers mangled into the name), at the attribute (abi/abi-tag13.C);
  - aligned: not on an enumerator (it applies to variables, fields and types), \"alignment may not be specified for 'e'\"
    (ext/attrib68.C);
  - an unnamed struct or union member (an anonymous struct, the manual's unnamed fields) has no base class: \"anonymous struct
    with base classes\", at its class-key (ext/anon-struct8.C, anon-struct9.C);
  - transparent_union: the union is passed as its first member, so that member's machine mode is the union's own: the union's
    mode is the integer mode of its size, so the first member must be an integer, enumeration or pointer type of the union's
    size (a floating type, a smaller member, a class or an array has another mode): \"type transparent 'union X' cannot be made
    transparent\", at the union (ext/transparent-union.C);
  - visibility: a class redeclared with an explicit visibility other than its earlier declaration's, \"'struct B' redeclared
    with different visibility\", at the later declaration (ext/visibility/redecl1.C; a function's is a warning, not judged);
  - main: vector_size among a function's decl-specifiers makes its return type a vector ([basic.start.main]/2: main returns
    int), \"'::main' must return 'int'\" (warn/main-3.C)."
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        off-of (fn [x] (or (get-in x [:loc :offset]) (get-in x [:range :begin :offset])))
        mine? (fn [x] (let [f (or (get-in x [:loc :file]) (get-in x [:range :begin :file]))] (or (nil? f) (= main f))))
        report! (fn [x rule msg] (when-let [o (off-of x)]
                                   (when (mine? x)
                                     (let [[l c] (line-col starts (long o))]
                                       (.add out {:line l :col c :kind :error :rule rule :msg msg})))))
        args-of (fn [a] (let [t (str/trim (str (:_arg a)))]
                          (when (seq t) (map str/trim (str/split t #"\s*,\s*(?=(?:[^\"]*\"[^\"]*\")*[^\"]*$)")))))
        vis-of (fn [n] (or (:_vis n)
                           (some #(when (= "visibility" (gnu-attr-name %)) (some->> (:_arg %) (re-find #"\"([^\"]*)\"") second)) (gnu-attrs-of n))))
        seen-vis (java.util.HashMap.)]
    (walk-nodes
     (fn [n parent]
       (let [k (:kind n)]
         ;; abi_tag's arguments
         (doseq [a (gnu-attrs-of n) :when (= "abi_tag" (gnu-attr-name a))]
           (let [as (args-of a)]
             (when-let [bad (some (fn [x] (cond (not (re-matches #"\"(?:[^\"\\]|\\.)*\"" x)) "arguments to the 'abi_tag' attribute must be narrow string literals"
                                                (not (re-matches #"\"[A-Za-z_][A-Za-z_0-9]*\"" x)) "arguments to the 'abi_tag' attribute must contain valid identifiers"
                                                :else nil))
                                  as)]
               (report! a :gnu-rule bad))))
         ;; aligned on an enumerator
         (when (= "EnumConstantDecl" k)
           (when (some #(= "aligned" (gnu-attr-name %)) (gnu-attrs-of n))
             (report! n :gnu-rule (str "alignment may not be specified for '" (:name n) "'"))))
         (when (and (= "CXXRecordDecl" k) (:completeDefinition n))
           ;; an anonymous struct or union with a base: its parent holds an implicit field of its type right after it
           (when (and (nil? (:name n)) (seq (:bases n)) parent)
             (let [sibs (vec (:inner parent))
                   i (.indexOf ^java.util.List sibs n)]
               ;; (or, with no member, no declaration of the parent names its type: GCC's anonymous struct is any unnamed
               ;; class defined in a class with no declarator, anon-struct9.C's `class : virtual a {};`)
               (when (and (>= i 0) (= "CXXRecordDecl" (:kind parent))
                          (or (and (< (inc i) (count sibs))
                                   (let [f (nth sibs (inc i))] (and (= "FieldDecl" (:kind f)) (:isImplicit f) (nil? (:name f)))))
                              (and (empty? (filter #(not (#{"NativeAttr"} (:kind %))) (:inner n)))
                                   (when-let [o (off-of n)]
                                     (let [tag (str " at " main ":" o ")")]
                                       (not-any? #(str/includes? (str (get-in % [:type :qualType])) tag) sibs))))))
                 (report! n :gnu-rule (str "anonymous " (:tagUsed n) " with base classes")))))
           ;; transparent_union
           (when (and (= "union" (:tagUsed n)) (some #(= "transparent_union" (gnu-attr-name %)) (gnu-attrs-of n)))
             (let [fs (filter #(and (= "FieldDecl" (:kind %)) (not (:isImplicit %))) (:inner n))
                   size (fn [f] (let [qt (str (get-in f [:type :qualType]))] (or (int-type-size qt) (float-type-size qt))))
                   sizes (map size fs)]
               (when (and (seq fs) (every? some? sizes))
                 (let [usize (apply max sizes)
                       qt0 (str (get-in (first fs) [:type :qualType]))]
                   (when (or (float-type-size qt0) (not= usize (int-type-size qt0)))
                     (report! n :gnu-rule (str "type transparent 'union " (or (:name n) "<unnamed>") "' cannot be made transparent"))))))))
         ;; a class's visibility against its earlier declarations' in the same scope (keyed by the parent's identity)
         (when (and (= "CXXRecordDecl" k) (:name n))
           (when-let [v (vis-of n)]
             (let [key [(System/identityHashCode parent) (:name n)]
                   o (.get seen-vis key)]
               (if (and o (not= o v))
                 (report! n :gnu-rule (str "'" (:tagUsed n) " " (:name n) "' redeclared with different visibility"))
                 (when-not o (.put seen-vis key v))))))
         ;; main's return type made a vector
         (when (and (= "FunctionDecl" k) (= "main" (:name n)) (or (nil? parent) (#{"LinkageSpecDecl" "TranslationUnitDecl"} (:kind parent)))
                    (some #(= "vector_size" (gnu-attr-name %)) (gnu-attrs-of n)))
           (report! n :gnu-rule "'::main' must return 'int'"))))
     (:nodes u) nil)
    (vec out)))

;; [basic.scope.class]/2 of C++20 (C++23 [class.member.lookup]/... "A name N used in a class S shall refer to the same
;; declaration in its context and when re-evaluated in the completed scope of S. No diagnostic is required."): GCC diagnoses it
;; (-Wchanges-meaning, an error by default) when a member declared in S has the name of an unqualified name used earlier in S, or
;; in a class nested in it, outside a complete-class context, whose lookup then found a declaration outside S -- unless the
;; member is a typedef or alias naming that same type again ("lenient if it has the same meaning", warn/changes-meaning2.C's
;; `typedef ::Lock Lock;`, a warning). The parser notes the uses (arbace.repr.cpp.parse/note-cm-use!, the class node's
;; :_cm-uses: the name to its first use's offset); a use at a declaration's own name (a parameter's, a declarator's) is none.

(def ^:private cm-member-kinds
  #{"FieldDecl" "VarDecl" "TypedefDecl" "TypeAliasDecl" "CXXMethodDecl" "FunctionTemplateDecl" "CXXRecordDecl" "EnumDecl"
    "ClassTemplateDecl" "TypeAliasTemplateDecl" "VarTemplateDecl" "EnumConstantDecl"})

(defn changes-meaning
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        off-of (fn [x] (get-in x [:loc :offset]))
        mine? (fn [x] (let [f (or (get-in x [:loc :file]) (get-in x [:range :begin :file]))] (or (nil? f) (= main f))))]
    (walk-nodes
     (fn [n _]
       (when-let [uses (and (= "CXXRecordDecl" (:kind n)) (:_cm-uses n))]
         (let [decl-offs (let [hs (java.util.HashSet.)]
                           (walk-nodes (fn [x _] (when (and (:name x) (string? (:name x))) (when-let [o (off-of x)] (.add hs (long o))))) (:inner n) nil)
                           hs)
               members (mapcat (fn [m] (if (and (= "EnumDecl" (:kind m)) (not (:scopedEnumTag m)))
                                         (cons m (filter #(= "EnumConstantDecl" (:kind %)) (:inner m)))
                                         [m]))
                               (:inner n))]
           (doseq [m members
                   :let [nm (:name m) o (off-of m) u (when (string? nm) (get uses nm))]
                   :when (and u o (contains? cm-member-kinds (:kind m)) (not (:isImplicit m)) (mine? m)
                              (< (long u) (long o)) (not (.contains decl-offs (long u))))
                   ;; (a typedef or alias of that same name's type: the same meaning)
                   :when (not (and (#{"TypedefDecl" "TypeAliasDecl"} (:kind m))
                                   (= nm (-> (str (get-in m [:type :qualType])) (str/replace #"\b(?:const|volatile|struct|class|union|enum)\b" "")
                                             str/trim (str/replace #"^::\s*" "")))))]
             (let [[l c] (line-col starts (long o))]
               (.add out {:line l :col c :kind :error :rule :changes-meaning
                          :msg (str "declaration of '" nm "' changes meaning of '" nm "'")}))))))
     (:nodes u) nil)
    (vec out)))

;; GCC's runtime interface for exceptions (cpp-gnu, 2026-11-22): a throw-expression, a handler and a rethrow are lowered to calls
;; of the Itanium C++ ABI's exception-handling functions (the ABI's 2.4, "Throwing an Exception", and 2.5, "Catching an
;; Exception": __cxa_allocate_exception(size_t), __cxa_free_exception(void *), __cxa_throw(void *, std::type_info *, void (*)(void
;; *)), __cxa_get_exception_ptr(void *), __cxa_begin_catch(void *), __cxa_end_catch(), __cxa_rethrow()), which g++ declares
;; implicitly as extern "C" functions at their first use, the type_info pointer as void *: a declaration of that name at namespace
;; scope that is not such a function (a variable: "redeclared as different kind of entity") or of another type ("conflicting
;; declaration of C function"; an exception specification aside) is an error at the construct that first needs it, once a
;; function (eh/builtin6.C, builtin7.C, builtin9.C, builtin10.C, builtin11.C). A throw-expression needs allocate, free and throw;
;; a handler begin_catch and end_catch, and get_exception_ptr when its parameter is a class object by value; a rethrow rethrow.

(def ^:private eh-abi
  {"__cxa_allocate_exception" "void *(unsigned long)" "__cxa_free_exception" "void (void *)"
   "__cxa_throw" "void (void *, void *, void (*)(void *))" "__cxa_get_exception_ptr" "void *(void *)"
   "__cxa_begin_catch" "void *(void *)" "__cxa_end_catch" "void ()" "__cxa_rethrow" "void ()"})

(defn eh-runtime
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        decls (into {} (for [n (mapcat #(if (= "LinkageSpecDecl" (:kind %)) (:inner %) [%]) (:nodes u))
                             :when (and (#{"FunctionDecl" "VarDecl"} (:kind n)) (contains? eh-abi (:name n)))]
                         [(:name n) n]))]
    (when (and (seq decls) (not (some #{"-fno-exceptions"} (:args u))))
      (let [bad (into {} (for [[nm n] decls
                               :let [qt (-> (str (get-in n [:type :qualType])) (str/replace #"\s*(?:throw\(\)|noexcept(?:\(true\))?)\s*$" "") str/trim)]
                               :when (or (= "VarDecl" (:kind n)) (not= qt (get eh-abi nm)))]
                           [nm (if (= "VarDecl" (:kind n)) "redeclared as different kind of entity" "conflicting declaration of C function")]))
            done (java.util.HashSet.)
            uses (java.util.ArrayList.)]
        (when (seq bad)
          (walk-nodes (fn [n _]
                        (case (:kind n)
                          "CXXThrowExpr" (.add uses [n (if (seq (:inner n)) ["__cxa_allocate_exception" "__cxa_free_exception" "__cxa_throw"] ["__cxa_rethrow"])])
                          "CXXCatchStmt" (let [v (first (filter #(= "VarDecl" (:kind %)) (:inner n)))
                                               qt (str/trim (str (get-in v [:type :qualType])))
                                               byval-class (and v (not (re-find #"[*&]$" qt))
                                                                (nil? (int-type-size qt)) (nil? (float-type-size qt))
                                                                (re-matches #"(?:const\s+)?[A-Za-z_][\w:<>, ]*" qt)
                                                                (not (#{"void" "bool"} qt)))]
                                           (.add uses [n (cond-> ["__cxa_begin_catch" "__cxa_end_catch"] byval-class (conj "__cxa_get_exception_ptr"))]))
                          nil))
                      (:nodes u) nil)
          (doseq [[n fns] (sort-by #(get-in (first %) [:range :begin :offset] 0) uses)
                  :let [o (get-in n [:range :begin :offset])
                        f (or (get-in n [:range :begin :file]) main)
                        hit (remove #(.contains done %) (filter bad fns))]
                  :when (and o (= f main) (seq hit))]
            (doseq [h hit] (.add done h))
            (let [[l c] (line-col starts (long o))]
              (.add out {:line l :col c :kind :error :rule :eh-abi
                         :msg (str "'" (first hit) "' " (get bad (first hit)))}))))))
    ;; (the destructor of a namespace-scope object is registered by __cxa_atexit(dtor, &object, &__dso_handle), the ABI's 3.3.5.3,
    ;; g++ declaring `extern "C" void *__dso_handle` then: a declaration of __dso_handle of another type conflicts, at the first such
    ;; object of a class whose destructor the unit declares, init/dso_handle2.C)
    (when-let [d (first (for [n (mapcat #(if (= "LinkageSpecDecl" (:kind %)) (:inner %) [%]) (:nodes u))
                              :when (and (#{"VarDecl" "FunctionDecl"} (:kind n)) (= "__dso_handle" (:name n))
                                         (not= "void *" (str/trim (str (get-in n [:type :qualType])))))]
                          n))]
      (let [dtor-classes (let [hs (java.util.HashSet.)]
                           (walk-nodes (fn [n _] (when (and (= "CXXRecordDecl" (:kind n)) (:name n)
                                                            (some #(and (= "CXXDestructorDecl" (:kind %)) (not (:explicitlyDefaulted %))) (:inner n)))
                                                   (.add hs (:name n))))
                                       (:nodes u) nil)
                           hs)]
        (when-let [v (first (for [n (mapcat #(if (#{"LinkageSpecDecl" "NamespaceDecl"} (:kind %)) (:inner %) [%]) (:nodes u))
                                  :when (and (= "VarDecl" (:kind n)) (not= "extern" (:storageClass n))
                                             (.contains dtor-classes (str/trim (str/replace (str (get-in n [:type :qualType])) #"\b(?:const|volatile|struct|class)\b" ""))))]
                              n))]
          (when-let [o (get-in v [:loc :offset])]
            (let [[l c] (line-col starts (long o))]
              (.add out {:line l :col c :kind :error :rule :eh-abi :msg "conflicting declaration of '__dso_handle'"}))))))
    (vec out)))

;; GNU's musttail (cpp-gnu, 2026-11-22; the GCC 15.2 manual's "Statement Attributes": musttail on a return statement whose operand is
;; a call asserts that the call is a tail call -- the caller's frame gone before it -- and "if the compiler cannot generate a musttail
;; tail call it reports an error"): the call cannot replace the caller's return when (a) the caller is non-throwing and the callee
;; may throw (the exception would have to stop at the caller: "call may throw exception that does not propagate"), (b) the call's
;; type is not the caller's return type (a conversion follows the call: "return value type mismatch"), (c) the caller returns a
;; class with a destructor that does something (the returned temporary outlives the frame), or (d) an automatic variable whose
;; destructor does something is in scope (it is destroyed after the call: "other reasons"); a destructor with an empty body does
;; nothing. A function template is judged at each of its specializations the unit names by explicit template arguments
;; (musttail8.C to musttail11.C, opt/musttail4.C). The parser marks the return statement (:_musttail).

(defn- fn-ret-type ^String [^String qt]
  (let [d (loop [i 0 depth 0] (when (< i (count qt)) (let [c (.charAt qt i)]
                                                       (cond (and (= c \() (zero? depth) (pos? i)) i
                                                             :else (recur (inc i) depth)))))]
    (str/trim (if d (subs qt 0 d) qt))))

(defn- nothrow-type? [^String qt]
  (boolean (or (re-find #"\bthrow\(\)\s*$" qt) (re-find #"\bnoexcept(?:\(true\))?\s*$" qt))))

(defn musttail
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        tops (mapcat #(if (#{"LinkageSpecDecl"} (:kind %)) (:inner %) [%]) (:nodes u))
        fns (into {} (for [n tops
                           :let [[fd tps] (if (= "FunctionTemplateDecl" (:kind n))
                                            [(first (filter #(= "FunctionDecl" (:kind %)) (:inner n)))
                                             (vec (keep #(when (= "TemplateTypeParmDecl" (:kind %)) (:name %)) (:inner n)))]
                                            [(when (= "FunctionDecl" (:kind n)) n) []])]
                           :when (and fd (string? (:name fd)))]
                       [(:name fd) {:node fd :tps tps :qt (str (get-in fd [:type :qualType]))}]))
        dtor-nontrivial (into #{} (for [n tops :when (and (= "CXXRecordDecl" (:kind n)) (:name n))
                                        :let [d (first (filter #(= "CXXDestructorDecl" (:kind %)) (:inner n)))
                                              b (when d (first (filter #(= "CompoundStmt" (:kind %)) (:inner d))))]
                                        :when (and d (not (:explicitlyDefaulted d)) (or (nil? b) (seq (:inner b))))]
                                    (:name n)))
        norm (fn [^String t] (-> t (str/replace #"\s+" " ") (str/replace #"\b(?:class|struct) " "") str/trim))
        subst (fn [^String t env] (reduce (fn [t [k v]] (str/replace t (re-pattern (str "\\b" (java.util.regex.Pattern/quote k) "\\b")) v)) t env))
        insts (let [m (java.util.HashMap.)]
                (walk-nodes (fn [n _] (when (and (= "DeclRefExpr" (:kind n)) (:explicitTemplateArgs n))
                                        (let [nm (get-in n [:referencedDecl :name])]
                                          (when (seq (:tps (get fns nm)))
                                            (.put m nm (conj (or (.get m nm) #{}) (vec (:explicitTemplateArgs n))))))))
                            (:nodes u) nil)
                m)
        strip (fn strip [x] (if (#{"ImplicitCastExpr" "ParenExpr" "ExprWithCleanups" "CXXBindTemporaryExpr" "MaterializeTemporaryExpr"} (:kind x))
                              (strip (first (:inner x))) x))
        reported (java.util.HashSet.)]
    (doseq [[fname {fd :node tps :tps fqt :qt}] fns
            :let [body (first (filter #(= "CompoundStmt" (:kind %)) (:inner fd)))]
            :when body
            env (if (seq tps) (for [as (.get ^java.util.HashMap insts fname) :when (= (count as) (count tps))] (zipmap tps as)) [{}])]
      (letfn [(walk [x locals]
                (cond
                  (map? x)
                  (case (:kind x)
                    "LambdaExpr" nil
                    "CompoundStmt" (loop [cs (:inner x) ls locals]
                                     (when-let [c (first cs)]
                                       (walk c ls)
                                       (recur (rest cs) (if (= "DeclStmt" (:kind c))
                                                          (into ls (filter #(= "VarDecl" (:kind %)) (:inner c)))
                                                          ls))))
                    "ReturnStmt" (when (:_musttail x)
                                   (let [call (some-> (first (:inner x)) strip)
                                         callee (when (= "CallExpr" (:kind call)) (strip (first (:inner call))))
                                         cinfo (when (= "DeclRefExpr" (:kind callee)) (get fns (get-in callee [:referencedDecl :name])))]
                                     (when cinfo
                                       (let [cenv (zipmap (:tps cinfo) (map #(subst % env) (:explicitTemplateArgs callee)))
                                             fret (norm (subst (fn-ret-type fqt) env))
                                             cret (norm (subst (fn-ret-type (:qt cinfo)) cenv))
                                             why (cond
                                                   (and (nothrow-type? fqt) (not (nothrow-type? (:qt cinfo)))) "call may throw exception that does not propagate"
                                                   (not= fret cret) "return value type mismatch"
                                                   (contains? dtor-nontrivial fret) "the returned class has a non-trivial destructor"
                                                   :else nil)
                                             why (or why
                                                     (when (some (fn [v] (contains? dtor-nontrivial (norm (str/replace (str (get-in v [:type :qualType])) #"\bconst\b" ""))))
                                                                 (remove #(#{"static" "extern"} (:storageClass %)) locals))
                                                       "other reasons"))]
                                         (when why
                                           (when-let [o (get-in x [:range :begin :offset])]
                                             (when (and (= main (or (get-in x [:range :begin :file]) main)) (.add reported o))
                                               (let [[l c] (line-col starts (long o))]
                                                 (.add out {:line l :col c :kind :error :rule :musttail :msg (str "cannot tail-call: " why)})))))))))
                    (doseq [[k v] x :when (and (not= k :_ent) (or (map? v) (vector? v)))] (walk v locals)))
                  (vector? x) (doseq [y x] (walk y locals))
                  :else nil))]
        (walk body [])))
    (vec out)))

;; GNU's flexible array members in C++ (cpp-gnu, 2026-11-22; the GCC 15.2 manual's "Arrays of Length Zero": a flexible array
;; member, a non-static data member of array type of unknown bound, is a GNU extension in C++, and as in C it must be the last
;; member, its storage the object's end): a structure's sequence of non-virtual base subobjects and non-static data members (an
;; anonymous struct's or union's members its own, an unnamed bit-field none) with a flexible array member followed by another data
;; member or a base subobject that has storage is an error, "flexible array member 'A::a' not at end of 'struct A'", at that flexible
;; array member, once a structure: the first one, where a member or base of class type (or an array of it) contributes the flexible
;; array member that ends it (a union the first among its members; a class whose own flexible array member is not at its end
;; contributes none, it is diagnosed itself; a virtual base none). Its initialization: a mem-initializer or a default member
;; initializer of a flexible array member ("initializer for flexible array member", the latter when a constructor or an object
;; of the class makes it used), a default member initializer of a class type whose list reaches its flexible array member
;; ("non-static initialization of a flexible array member"), an object initialized with a flexible array member of a class whose
;; destructor does something ("unknown array size in delete", at the class), and __builtin_clear_padding of a class holding one
;; (its padding bits are not known). Not judged in a template's pattern. ext/flexary4.C, flexary5.C, flexary18.C, flexary21.C,
;; flexary22.C, flexary28.C, flexary29.C, flexary32.C, flexary36.C, flexary37.C, flexary42.C, array1.C, builtin-clear-padding-1.C,
;; torture/pr64312.C.

(defn- fam-type?
  "Whether the type's spelling is an array of unknown bound (`int[]`, `int[][2]`, `struct (unnamed struct at f:9)[]`), not a pointer
  or reference to one (`int (*)[]`)."
  [^String qt]
  (let [t (str/trim qt)]
    (boolean (and (re-find #"\[\](?:\[\d+\])*$" t)
                  (not (re-find #"\([^()]*[*&]\s*(?:const|volatile|__restrict)?\s*\)\s*\[\](?:\[\d+\])*$" t))))))

(defn flexible-arrays
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        mine? (fn [x] (let [f (or (get-in x [:loc :file]) (get-in x [:range :begin :file]))] (or (nil? f) (= main f))))
        report! (fn [x msg] (when-let [o (or (get-in x [:loc :offset]) (get-in x [:range :begin :offset]))]
                              (when (mine? x)
                                (let [[l c] (line-col starts (long o))]
                                  (.add out {:line l :col c :kind :error :rule :flexible-array :msg msg})))))
        ;; the records: by their class-key's offset (an unnamed one's type names it), by name; the parents of each, and those in
        ;; templates' patterns
        by-off (java.util.HashMap.) by-name (java.util.HashMap.) parent-of (java.util.IdentityHashMap.) in-tmpl (java.util.IdentityHashMap.)
        _ (letfn [(idx [x par tmpl]
                    (cond
                      (map? x) (let [rec? (and (= "CXXRecordDecl" (:kind x)) (:completeDefinition x))
                                     tmpl (or tmpl (#{"ClassTemplateDecl" "ClassTemplatePartialSpecializationDecl" "FunctionTemplateDecl"} (:kind x)))]
                                 (when rec?
                                   (when-let [o (get-in x [:range :begin :offset])] (.put by-off (long o) x))
                                   (when (:name x) (.put by-name (:name x) (conj (or (.get by-name (:name x)) []) x)))
                                   (.put parent-of x par)
                                   (when tmpl (.put in-tmpl x true)))
                                 (doseq [[k v] x :when (and (not= k :_ent) (or (map? v) (vector? v)))]
                                   (idx v (if rec? x par) tmpl)))
                      (vector? x) (doseq [y x] (idx y par tmpl))
                      :else nil))]
            (idx (:nodes u) nil false))
        base-name (fn [^String qt]
                    (-> qt (str/replace #"\b(?:const|volatile|struct|class|union)\b" "") str/trim
                        (str/replace #"(?:\s*\[\d*\])+$" "") str/trim))
        resolve (fn [^String qt scope]
                  (let [t (base-name qt)]
                    (if-let [[_ o] (re-find #"\(unnamed (?:struct|class|union) at [^()]*:(\d+)\)(?:\s*\[\d*\])*\s*$" qt)]
                      (.get by-off (Long/parseLong o))
                      (let [nm (-> t (str/replace #"<.*$" "") (str/replace #"^.*::" "") str/trim)
                            cands (.get by-name nm)]
                        (when (seq cands)
                          (or (loop [r scope]
                                (when r
                                  (or (some #(when (identical? (.get parent-of %) r) %) cands) (recur (.get parent-of r)))))
                              (first (filter #(nil? (.get parent-of %)) cands))
                              (first cands)))))))
        memo (java.util.IdentityHashMap.)
        nonempty-memo (java.util.IdentityHashMap.)
        members (fn [r] (filter #(and (= "FieldDecl" (:kind %)) (not (and (:isBitfield %) (nil? (:name %))))) (:inner r)))
        nonempty? (fn nonempty? [r]
                    (if (.containsKey nonempty-memo r)
                      (.get nonempty-memo r)
                      (do (.put nonempty-memo r false)
                          (let [v (boolean (or (seq (members r))
                                               (some #(or (:virtual %) (:isVirtual %)) (:inner r))
                                               (some :isVirtual (:bases r))
                                               (some #(when-let [b (resolve (str (get-in % [:type :qualType])) r)] (nonempty? b)) (:bases r))))]
                            (.put nonempty-memo r v) v))))
        analyze (fn analyze [r]
                  (if (.containsKey memo r)
                    (.get memo r)
                    (do (.put memo r {:first nil :bad false})
                        (let [union? (= "union" (:tagUsed r))
                              contrib (fn [qt]
                                        (when-let [c (resolve qt r)]
                                          (let [a (analyze c)] (when-not (:bad a) (:first a)))))
                              res (if union?
                                    {:first (some (fn [m] (or (contrib (str (get-in m [:type :qualType]))) (when (fam-type? (str (get-in m [:type :qualType]))) m))) (members r))
                                     :bad false}
                                    (let [steps (concat (for [b (:bases r) :when (not (:isVirtual b))] [:base b]) (for [m (members r)] [:member m]))]
                                      (loop [ss steps fst nil]
                                        (if-let [[k x] (first ss)]
                                          (let [qt (str (get-in x [:type :qualType]))]
                                            (case k
                                              :base (let [c (resolve qt r)]
                                                      (cond (and fst c (nonempty? c)) {:first fst :bad true}
                                                            fst (recur (rest ss) fst)
                                                            :else (recur (rest ss) (contrib qt))))
                                              :member (if fst
                                                        {:first fst :bad true}
                                                        (recur (rest ss) (or (contrib qt) (when (fam-type? qt) x))))))
                                          {:first fst :bad false}))))]
                          (.put memo r res)
                          res))))]
    ;; not at end (a class template's pattern too when the unit names a specialization of it outside its definition: what its
    ;; members of non-dependent types contribute, torture/pr64312.C's any_iterator<...>)
    (doseq [r (.values by-off)
            :when (and (not= "union" (:tagUsed r))
                       (or (not (.containsKey in-tmpl r))
                           (when-let [nm (:name r)]
                             (let [b (long (or (get-in r [:range :begin :offset]) -1)) e (long (or (get-in r [:range :end :offset]) -1))
                                   m (re-matcher (re-pattern (str "\\b" (java.util.regex.Pattern/quote nm) "\\s*<")) src)]
                               (loop [] (when (.find m) (if (or (< (.start m) b) (> (.start m) e)) true (recur))))))))
            :let [a (analyze r)]
            :when (:bad a)]
      (report! (:first a) (str "flexible array member '" (:name (:first a)) "' not at end of '" (:tagUsed r) " " (or (:name r) "<unnamed>") "'")))
    ;; initializers
    (doseq [r (.values by-off) :when (not (.containsKey in-tmpl r))
            :let [fams (set (keep #(when (fam-type? (str (get-in % [:type :qualType]))) (:name %)) (members r)))
                  ctors (filter #(= "CXXConstructorDecl" (:kind %)) (:inner r))]]
      (when (seq fams)
        ;; a mem-initializer of one, at its constructor
        (doseq [c ctors
                :when (some #(and (= "CXXCtorInitializer" (:kind %)) (contains? fams (get-in % [:anyInit :name]))) (:inner c))]
          (report! c "initializer for flexible array member"))
        ;; a default member initializer of one, when a constructor or an object of the class uses it
        (doseq [m (members r)
                :when (and (contains? fams (:name m)) (:hasInClassInitializer m)
                           (or (some #(not (:explicitlyDeleted %)) ctors)
                               (let [nm (:name r)
                                     tag (when-let [o (get-in r [:range :begin :offset])] (str " at " main ":" o ")"))]
                                 (some (fn [v] (and (= "VarDecl" (:kind v))
                                                    (let [t (base-name (str (get-in v [:type :qualType])))]
                                                      (or (and nm (= t nm)) (and tag (str/includes? t tag))))))
                                       (let [p (.get parent-of r)] (if p (:inner p) (:nodes u)))))))]
          (report! m "initializer for flexible array member")))
      ;; a default member initializer of a class type whose list reaches the flexible array member
      (doseq [m (members r)
              :when (:hasInClassInitializer m)
              :let [c (resolve (str (get-in m [:type :qualType])) r)
                    k (when c (first (keep-indexed (fn [i x] (when (fam-type? (str (get-in x [:type :qualType]))) i)) (members c))))
                    il (first (filter #(= "InitListExpr" (:kind %)) (:inner m)))]
              :when (and k il (> (count (:inner il)) (long k)))]
        (report! m "non-static initialization of a flexible array member")))
    ;; a constructor defined out of its class with a mem-initializer of one, at the constructor
    (doseq [c (:nodes u)
            :when (= "CXXConstructorDecl" (:kind c))
            :let [r (resolve (str (:name c)) nil)
                  fams (when r (set (keep #(when (fam-type? (str (get-in % [:type :qualType]))) (:name %)) (members r))))]
            :when (some #(and (= "CXXCtorInitializer" (:kind %)) (contains? fams (get-in % [:anyInit :name]))) (:inner c))]
      (report! c "initializer for flexible array member"))
    ;; an object initialized with a list: a flexible array member of a subobject or an array element given a value ("in a nested
    ;; context", at the list's end: only the complete object's own may be initialized), and a string literal for one whose element
    ;; type is arithmetic but no character type ("invalid conversion from 'const char*'", ext/flexary12.C; a class template's
    ;; parameter substituted)
    (let [fam-at (fn [r] (first (keep-indexed (fn [i x] (when (fam-type? (str (get-in x [:type :qualType]))) i)) (members r))))
          strip (fn strip [x] (if (#{"ImplicitCastExpr" "ParenExpr"} (:kind x)) (strip (first (:inner x))) x))]
      (walk-nodes (fn [v _]
                    (when (= "VarDecl" (:kind v))
                      (when-let [il (first (filter #(= "InitListExpr" (:kind %)) (:inner v)))]
                        (let [qt (str (get-in v [:type :qualType]))
                              r (resolve qt (.get parent-of v))
                              arr? (re-find #"\]\s*$" qt)
                              els (vec (:inner il))
                              ;; (GCC gives the initializer up there: Sema's errors inside it are dropped, :suppress, arbace.repr.cpp.diag/diagnose)
                              end! (fn [] (when-let [o (get-in il [:range :end :offset])]
                                            (when-let [b (and (report! {:loc {:offset o}} "initialization of flexible array member in a nested context")
                                                              (get-in il [:range :begin :offset]))]
                                              (let [d (.get out (dec (.size out)))]
                                                (.set out (dec (.size out)) (assoc d :suppress [(first (line-col starts (long b))) (:line d)]))))))]
                          (when r
                            (if arr?
                              (when-let [k (fam-at r)]
                                (when (some #(and (= "InitListExpr" (:kind %)) (> (count (:inner %)) (long k))) els)
                                  (end!)))
                              (do
                                ;; a member of class type whose own flexible array member the list reaches
                                (when (some (fn [[j m]]
                                              (when-let [mc (resolve (str (get-in m [:type :qualType])) r)]
                                                (when-let [k (fam-at mc)]
                                                  (let [e (get els j)]
                                                    (cond (nil? e) false
                                                          (= "InitListExpr" (:kind e)) (> (count (:inner e)) (long k))
                                                          :else (> (count els) (+ (long j) (long k))))))))
                                            (map-indexed vector (members r)))
                                  (end!))
                                ;; a string literal for an arithmetic flexible array member
                                (when-let [k (fam-at r)]
                                  (let [m (nth (vec (members r)) k)
                                        et (str/replace (str/trim (str (get-in m [:type :qualType]))) #"\s*\[\]$" "")
                                        targs (when-let [[_ a] (re-find #"<(.*)>\s*$" (base-name qt))] (map str/trim (str/split a #",")))
                                        tmpl (some (fn [n] (when (and (= "ClassTemplateDecl" (:kind n)) (some #(identical? r %) (:inner n))) n)) (:nodes u))
                                        env (when (and tmpl targs) (zipmap (keep #(when (#{"TemplateTypeParmDecl"} (:kind %)) (:name %)) (:inner tmpl)) targs))
                                        et (get env et et)
                                        e (some-> (get els k) strip)]
                                    (when (and e (= "StringLiteral" (:kind e))
                                               (re-matches #"(?:unsigned |signed )?(?:short|int|long|long long|bool|float|double|long double)(?: int)?|unsigned" et))
                                      (when-let [o (get-in e [:range :begin :offset])]
                                        (report! {:loc {:offset o}} (str "invalid conversion from 'const char*' to '" et "'")))))))))))))
                  (:nodes u) nil))
    ;; an object whose flexible array member of a class with a destructor that does something is initialized
    (walk-nodes (fn [v _]
                  (when (= "VarDecl" (:kind v))
                    (when-let [il (first (filter #(= "InitListExpr" (:kind %)) (:inner v)))]
                      (when-let [r (resolve (str (get-in v [:type :qualType])) (.get parent-of v))]
                        (let [ms (vec (members r))
                              k (first (keep-indexed (fn [i x] (when (fam-type? (str (get-in x [:type :qualType]))) i)) ms))]
                          (when (and k (> (count (:inner il)) (long k)))
                            (when-let [ec (resolve (str (get-in (nth ms k) [:type :qualType])) r)]
                              (when-let [d (first (filter #(= "CXXDestructorDecl" (:kind %)) (:inner ec)))]
                                (when (and (not (:explicitlyDefaulted d)) (not (:explicitlyDeleted d)))
                                  (report! r "unknown array size in delete"))))))))))
                (:nodes u) nil)
    ;; __builtin_clear_padding of a pointer to a class holding a flexible array member
    (let [holds? (fn holds? [r seen]
                   (when (and r (not (contains? seen r)))
                     (some (fn [m] (let [qt (str (get-in m [:type :qualType]))]
                                     (or (fam-type? qt) (holds? (resolve qt r) (conj seen r)))))
                           (members r))))
          vars (java.util.HashMap.)]
      (walk-nodes (fn [n _] (when (#{"VarDecl" "ParmVarDecl"} (:kind n)) (when (string? (:name n)) (.put vars (:name n) n)))) (:nodes u) nil)
      (walk-nodes (fn [n _]
                    (when (and (= "CallExpr" (:kind n))
                               (= "__builtin_clear_padding" (get-in (first (:inner n)) [:referencedDecl :name])))
                      (let [a (loop [x (second (:inner n))] (if (#{"ImplicitCastExpr" "ParenExpr"} (:kind x)) (recur (first (:inner x))) x))
                            v (when (= "DeclRefExpr" (:kind a)) (.get vars (get-in a [:referencedDecl :name])))
                            qt (str (get-in v [:type :qualType]))]
                        (when (and v (str/ends-with? (str/trim qt) "*"))
                          (when (holds? (resolve (str/replace (str/trim qt) #"\*$" "") nil) #{})
                            (report! n "flexible array member does not have well defined padding bits for '__builtin_clear_padding'"))))))
                  (:nodes u) nil))
    (vec (distinct out))))

;; GNU's unavailable attribute (cpp-gnu, 2026-11-22; the GCC 15.2 manual's "Common Function Attributes", "Common Variable Attributes"
;; and "Common Type Attributes": unavailable "results in an error if the function [variable, type] is used anywhere in the source
;; file", as deprecated's warning; a use within a declaration itself marked unavailable is none): the uses of a type (a declaration's
;; written type, a function's return type, a typedef's, a cast's or functional notation's, a template argument), of a variable, a
;; function or an enumerator (an id-expression naming it, a call, a conversion to a pointer), of a member (a member access through
;; it), and the calls of a lambda whose attributes name it ([expr.prim.lambda.general]/1), each at the use. A name is judged when
;; every declaration of it the unit holds (a member: in classes) is unavailable; a type's name is not judged inside a template that
;; declares a parameter of that name (ext/attr-unavailable-1.C, -6.C, -8.C, -9.C, cpp23/lambda-attr2.C).

(defn unavailable
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        unav? (fn [n] (some #(= "unavailable" (gnu-attr-name %)) (gnu-attrs-of n)))
        types (java.util.HashSet.) values (java.util.HashMap.) members (java.util.HashMap.) lams (java.util.HashSet.)
        note! (fn [^java.util.HashMap m nm u?] (let [[a b] (or (.get m nm) [0 0])] (.put m nm [(inc (long a)) (+ (long b) (if u? 1 0))])))
        _ (walk-nodes (fn [n parent]
                        (let [k (:kind n) nm (:name n)]
                          (when (string? nm)
                            (case k
                              ("TypedefDecl" "TypeAliasDecl" "EnumDecl") (when (unav? n) (.add types nm))
                              "CXXRecordDecl" (when (unav? n) (.add types nm))
                              "ClassTemplateDecl" (when (some #(and (= "CXXRecordDecl" (:kind %)) (unav? %)) (:inner n)) (.add types nm))
                              "FunctionTemplateDecl" (note! values nm (some #(and (= "FunctionDecl" (:kind %)) (unav? %)) (:inner n)))
                              ("VarDecl" "ParmVarDecl" "FunctionDecl" "EnumConstantDecl") (when-not (= "FunctionTemplateDecl" (:kind parent)) (note! values nm (unav? n)))
                              ("FieldDecl" "CXXMethodDecl") (when (= "CXXRecordDecl" (:kind parent)) (note! members nm (unav? n)))
                              nil))
                          (when (and (= "VarDecl" k) (some #(and (= "LambdaExpr" (:kind %)) (:_unavailable %)) (:inner n)))
                            (.add lams nm))))
                      (:nodes u) nil)
        all-unav (fn [^java.util.HashMap m nm] (when-let [[a b] (.get m nm)] (and (pos? (long a)) (= a b))))
        report! (fn [n msg] (when-let [o (or (get-in n [:loc :offset]) (get-in n [:range :begin :offset]))]
                              (when (= main (or (get-in n [:loc :file]) (get-in n [:range :begin :file]) main))
                                (let [[l c] (line-col starts (long o))]
                                  (.add out {:line l :col c :kind :error :rule :unavailable :msg msg})))))
        type-hit (fn [^String qt hidden] (first (filter #(and (not (contains? hidden %)) (re-find (re-pattern (str "(?<![\\w:])" (java.util.regex.Pattern/quote %) "\\b")) qt)) types)))]
    (when (or (seq types) (seq values) (seq members) (seq lams))
      (letfn [(w [x parent hidden in-unav]
                (cond
                  (map? x)
                  (let [k (:kind x)
                        hidden (if (#{"ClassTemplateDecl" "FunctionTemplateDecl" "TypeAliasTemplateDecl" "VarTemplateDecl" "ClassTemplatePartialSpecializationDecl"} k)
                                 (into hidden (keep #(when (#{"TemplateTypeParmDecl" "TemplateTemplateParmDecl"} (:kind %)) (:name %)) (:inner x)))
                                 hidden)
                        ;; (a class's own name inside its definition: its injected-class-name, no use, line 95's `int member3(T *);`)
                        hidden (if (and (= "CXXRecordDecl" k) (string? (:name x))) (conj hidden (:name x)) hidden)
                        self-unav (unav? x)
                        in-unav (or in-unav (and self-unav (#{"FunctionDecl" "CXXMethodDecl" "TypedefDecl" "TypeAliasDecl" "VarDecl" "FieldDecl"} k)))]
                    (when (and k (not self-unav) (not in-unav) (seq types))
                      (let [qt (case k
                                 ("VarDecl" "FieldDecl" "ParmVarDecl" "TypedefDecl" "TypeAliasDecl") (str (get-in x [:type :qualType]))
                                 ("FunctionDecl" "CXXMethodDecl") (fn-ret-type (str (get-in x [:type :qualType])))
                                 ("CXXTemporaryObjectExpr" "CXXFunctionalCastExpr" "CXXUnresolvedConstructExpr" "CXXScalarValueInitExpr" "CStyleCastExpr"
                                  "CXXStaticCastExpr" "CXXReinterpretCastExpr" "CXXConstCastExpr" "CXXNewExpr") (str (get-in x [:type :qualType]))
                                 nil)]
                        (when-let [t (and qt (type-hit qt hidden))]
                          (report! x (str "'" t "' is unavailable")))))
                    (when (and k (not in-unav))
                      (case k
                        "DeclRefExpr" (let [nm (get-in x [:referencedDecl :name])]
                                        (cond (and (string? nm) (all-unav values nm)) (report! x (str "'" nm "' is unavailable"))
                                              (and (string? nm) (.contains lams nm) parent (= "CallExpr" (:kind parent)) (identical? x (first (:inner parent))))
                                              (report! x (str "'" nm "' is unavailable"))
                                              :else nil))
                        "MemberExpr" (let [nm (:name x)] (when (and (string? nm) (all-unav members nm)) (report! x (str "'" nm "' is unavailable"))))
                        nil))
                    (doseq [[kk v] x :when (and (not= kk :_ent) (or (map? v) (vector? v)))]
                      (w v (if k x parent) hidden in-unav)))
                  (vector? x) (doseq [y x] (w y parent hidden in-unav))
                  :else nil))]
        (w (:nodes u) nil #{} false)))
    (vec out)))

;; GCC's built-in traits in a function template's signature (cpp-gnu, 2026-11-22; the GCC 15.2 manual's "Type Traits": the __is_*,
;; __has_*, __underlying_type, __decay, __remove_*, __add_* ... built-ins, for which the Itanium ABI has no mangling): a function
;; template whose type names one with a dependent operand (written, or through an alias template whose type is one) cannot be
;; mangled, an error once a specialization is used -- the unit names the template outside its own definition: "use of built-in
;; trait '...' in function signature; use library traits instead", at the template (ext/decay1.C, is_empty2.C, underlying_type7.C).

(def ^:private builtin-trait-re
  #"\b__(?:is_[a-z_]+|has_[a-z_]+|underlying_type|decay|remove_[a-z_]+|add_[a-z_]+|make_signed|make_unsigned|reference_(?:binds|constructs|converts)_[a-z_]+|builtin_is_[a-z_]+)\s*[(<]")

(defn trait-signatures
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        aliases (set (for [n (:nodes u) :when (= "TypeAliasTemplateDecl" (:kind n))
                           :let [a (first (filter #(= "TypeAliasDecl" (:kind %)) (:inner n)))]
                           :when (re-find builtin-trait-re (str (get-in a [:type :qualType])))]
                       (:name n)))
        named (java.util.HashMap.)]
    (walk-nodes (fn [n _] (when (= "DeclRefExpr" (:kind n))
                            (when-let [o (get-in n [:range :begin :offset])]
                              (let [nm (get-in n [:referencedDecl :name])] (when (string? nm) (.put named nm (conj (or (.get named nm) []) (long o))))))))
                (:nodes u) nil)
    (doseq [t (:nodes u) :when (= "FunctionTemplateDecl" (:kind t))
            :let [f (first (filter #(= "FunctionDecl" (:kind %)) (:inner t)))
                  qt (str (get-in f [:type :qualType]))
                  tps (set (keep #(when (#{"TemplateTypeParmDecl" "NonTypeTemplateParmDecl"} (:kind %)) (:name %)) (:inner t)))
                  m (re-matcher builtin-trait-re qt)
                  hit (or (loop [] (when (.find m)
                                     ;; (a dependent operand: a template parameter named in what follows the trait's name)
                                     (if (some #(re-find (re-pattern (str "\\b" (java.util.regex.Pattern/quote %) "\\b")) (subs qt (.end m))) tps) true (recur))))
                          (some #(re-find (re-pattern (str "\\b" (java.util.regex.Pattern/quote %) "\\s*<")) qt) aliases))
                  b (long (or (get-in t [:range :begin :offset]) -1)) e (long (or (get-in t [:range :end :offset]) -1))]
            :when (and hit (string? (:name t)) (some #(or (< (long %) b) (> (long %) e)) (.get named (:name t))))
            :let [o (or (get-in f [:loc :offset]) (get-in t [:range :begin :offset]))]
            :when (and o (= main (or (get-in f [:loc :file]) main)))]
      (let [[l c] (line-col starts (long o))]
        (.add out {:line l :col c :kind :error :rule :builtin-trait :msg "use of built-in trait in function signature; use library traits instead"}))
      ;; (__underlying_type of a template parameter a call's explicit argument makes a fundamental type, no enumeration: the
      ;; substitution fails ([meta.trans.other]'s underlying_type is an enumeration's), so a template of that name alone has no viable
      ;; candidate, "no matching function for call", at the call; ext/underlying_type14.C)
      (when (= 1 (count (filter #(= (:name t) (:name %)) (:nodes u))))
        (let [order (vec (keep #(when (#{"TemplateTypeParmDecl" "NonTypeTemplateParmDecl"} (:kind %)) (:name %)) (:inner t)))]
          (walk-nodes (fn [d par]
                        (when (and (= "DeclRefExpr" (:kind d)) (= (:name t) (get-in d [:referencedDecl :name])) (:explicitTemplateArgs d)
                                   par (= "CallExpr" (:kind par)))
                          (let [env (zipmap order (map str/trim (:explicitTemplateArgs d)))]
                            (when (some (fn [[p a]] (and (re-find (re-pattern (str "__underlying_type\\s*\\(\\s*" (java.util.regex.Pattern/quote p) "\\s*\\)")) qt)
                                                         (or (int-type-size a) (float-type-size a))))
                                        env)
                              (when-let [co (get-in par [:range :begin :offset])]
                                (when (= main (or (get-in par [:range :begin :file]) main))
                                  (let [[l c] (line-col starts (long co))]
                                    (.add out {:line l :col c :kind :error :rule :builtin-trait :msg (str "no matching function for call to '" (:name t) "'")}))))))))
                      (:nodes u) nil))))
    (vec (distinct out))))

;; GCC's front end's pragmas (cpp-gnu, 2026-11-22; the GCC 15.2 manual's "Pragmas Accepted by GCC": the loop pragmas `#pragma GCC ivdep`,
;; `#pragma GCC unroll n`, `#pragma GCC novector` before a for, while or do statement of a function, n "an integer constant expression"
;; whose values 0 and 1 block unrolling, GCC's limit 65534; `#pragma interface`, `implementation`, `pack`, `weak`, which the front end
;; reads between declarations or statements): a loop pragma outside any function's body, "'#pragma GCC ivdep' must be inside a
;; function"; an unroll factor that is not a non-negative integral constant less than 65535 (a floating type, a value out of range;
;; in a template a type-dependent factor at each specialization the unit names by explicit template arguments, a value-dependent
;; one of floating type at once), "'#pragma GCC unroll' requires an assignment-expression that evaluates to a non-negative integral
;; constant less than 65535"; such a pragma inside a declaration or an expression, "'#pragma' is not allowed here" (parse/ivdep-2.C,
;; ivdep-3.C, pragma2.C, ext/unroll-6.C, unroll-8.C). The preprocessor's records of the main file's pragmas (:pragmas).

(defn- unroll-value
  "The unroll factor's text evaluated: {:t :int|:float|:dep|nil :v BigInteger}, `env` a template parameter's name to its argument
  (a type's name, or an integer), `tps` the template parameters' names to :type or :value; nil :t when it is no expression read here."
  [^String text env tps]
  (let [toks (vec (re-seq #"0[xX][0-9a-fA-F]+[uUlL]*|\d+\.\d*(?:[eE][-+]?\d+)?[fFlL]?|\d+[eE][-+]?\d+[fFlL]?|\d+[uUlL]*|[A-Za-z_]\w*|[-+()*/]" text))
        pos (atom 0)
        peek* (fn [] (get toks @pos))
        next* (fn [] (let [t (get toks @pos)] (swap! pos inc) t))
        num (fn [^String t]
              (cond (re-find #"[.eE]" (if (re-find #"^0[xX]" t) "" t)) {:t :float}
                    (re-find #"^0[xX]" t) {:t :int :v (java.math.BigInteger. (str/replace (subs t 2) #"[uUlL]+$" "") 16)}
                    :else {:t :int :v (java.math.BigInteger. (str/replace t #"[uUlL]+$" ""))}))
        type-of (fn [nm] (let [a (get env nm)] (cond (nil? a) :dep (re-find #"\b(?:float|double)\b" (str a)) :float :else :int)))
        comb (fn [a b op]
               (cond (or (nil? (:t a)) (nil? (:t b))) {:t nil}
                     (or (= :float (:t a)) (= :float (:t b))) {:t :float}
                     (or (= :dep (:t a)) (= :dep (:t b))) {:t :dep}
                     (or (nil? (:v a)) (nil? (:v b))) {:t :int-dep}
                     :else {:t :int :v (if (= op "+") (.add ^java.math.BigInteger (:v a) (:v b)) (.subtract ^java.math.BigInteger (:v a) (:v b)))}))]
    (letfn [(primary []
              (let [t (next*)]
                (cond
                  (nil? t) {:t nil}
                  (= t "-") (let [x (primary)] (if (and (= :int (:t x)) (:v x)) {:t :int :v (.negate ^java.math.BigInteger (:v x))} x))
                  (= t "(") (if (and (= :type (get tps (peek*))) (= ")" (get toks (inc @pos))))
                              (let [nm (next*)] (next*) (let [x (primary) ty (type-of nm)]
                                                          (case ty :float {:t :float} :dep {:t :dep} (if (= :int (:t x)) x {:t :int-dep}))))
                              (let [x (expr)] (next*) x))
                  (re-find #"^\d" t) (num t)
                  (= :value (get tps t)) (if-let [a (get env t)] {:t :int :v (java.math.BigInteger. (str a))} {:t :int-dep})
                  :else {:t nil})))
            (expr []
              (loop [a (primary)]
                (if (#{"+" "-"} (peek*))
                  (let [op (next*) b (primary)] (recur (comb a b op)))
                  a)))]
      (let [r (expr)] (if (peek*) {:t nil} r)))))

(defn pragmas
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        prs (:pragmas u)
        report! (fn [o msg] (let [[l c] (line-col starts (long o))] (.add out {:line l :col c :kind :error :rule :pragma :msg msg})))]
    (when (seq prs)
      (let [bodies (java.util.ArrayList.) ; [begin end tparams template-name]
            spans (java.util.ArrayList.)  ; [begin end kind] of every node with a range in the main file
            calls (java.util.HashMap.)]
        (letfn [(w [x tmpl]
                  (cond
                    (map? x)
                    (let [k (:kind x)
                          tmpl (if (= "FunctionTemplateDecl" k)
                                 {:name (:name x) :tps (into {} (keep #(case (:kind %) "TemplateTypeParmDecl" [(:name %) :type] "NonTypeTemplateParmDecl" [(:name %) :value] nil) (:inner x)))
                                  :order (vec (keep #(when (#{"TemplateTypeParmDecl" "NonTypeTemplateParmDecl" "TemplateTemplateParmDecl"} (:kind %)) (:name %)) (:inner x)))}
                                 tmpl)
                          b (get-in x [:range :begin :offset]) e (get-in x [:range :end :offset])
                          f (or (get-in x [:range :begin :file]) main)]
                      (when (and k b e (= f main)) (.add spans [(long b) (long e) k]))
                      (when (and (#{"FunctionDecl" "CXXMethodDecl" "CXXConstructorDecl" "CXXDestructorDecl" "CXXConversionDecl"} k))
                        (when-let [body (first (filter #(= "CompoundStmt" (:kind %)) (:inner x)))]
                          (let [bb (get-in body [:range :begin :offset]) be (get-in body [:range :end :offset])]
                            (when (and bb be) (.add bodies [(long bb) (long be) tmpl])))))
                      (when (and (= "DeclRefExpr" k) (:explicitTemplateArgs x))
                        (let [nm (get-in x [:referencedDecl :name])] (.put calls nm (conj (or (.get calls nm) #{}) (vec (:explicitTemplateArgs x))))))
                      (doseq [[kk v] x :when (and (not= kk :_ent) (or (map? v) (vector? v)))] (w v tmpl)))
                    (vector? x) (doseq [y x] (w y tmpl))
                    :else nil))]
          (w (:nodes u) nil))
        (doseq [{:keys [off text]} prs
                :let [o (long off)
                      [_ ns verb arg] (re-matches #"#\s*pragma\s+(?:(GCC)\s+)?(\w+)\s*(.*?)\s*" (str text))
                      loop? (and (= ns "GCC") (#{"ivdep" "unroll" "novector"} verb))
                      deferred? (or loop? (and (nil? ns) (#{"interface" "implementation" "pack" "weak"} verb)))
                      body (reduce (fn [best [b e :as bd]] (if (and (< (long b) o (long e)) (or (nil? best) (> (long b) (long (first best))))) bd best)) nil bodies)
                      inner (reduce (fn [best [b e :as sp]] (if (and (< (long b) o (long e)) (or (nil? best) (> (long b) (long (first best))))) sp best)) nil spans)]
                :when deferred?]
          (cond
            (and inner (not (#{"CompoundStmt" "CXXRecordDecl" "NamespaceDecl" "LinkageSpecDecl" "ClassTemplateDecl"} (nth inner 2)))
                 (not (and loop? (#{"ForStmt" "WhileStmt" "DoStmt" "CXXForRangeStmt"} (nth inner 2)))))
            (report! o "'#pragma' is not allowed here")
            (and loop? (nil? body)) (report! o (str "'#pragma GCC " verb "' must be inside a function"))
            (and (= verb "unroll") body)
            (let [tmpl (nth body 2)
                  bad? (fn [r] (or (= :float (:t r)) (and (= :int (:t r)) (:v r) (or (neg? (.signum ^java.math.BigInteger (:v r))) (>= (.compareTo ^java.math.BigInteger (:v r) (java.math.BigInteger/valueOf 65535)) 0)))))
                  r (unroll-value arg {} (:tps tmpl))]
              (when (or (bad? r)
                        (and (#{:dep :int-dep} (:t r)) tmpl
                             (some (fn [as] (bad? (unroll-value arg (zipmap (:order tmpl) as) (:tps tmpl)))) (.get calls (:name tmpl)))))
                (report! o "'#pragma GCC unroll' requires an assignment-expression that evaluates to a non-negative integral constant less than 65535")))
            :else nil))))
    (vec out)))

;; GNU's labels as values (cpp-gnu, 2026-11-22; the GCC 15.2 manual's "Labels as Values": `&&label` is the label's address, a
;; `void *` constant of the function it labels, and `goto *exp;` jumps to the address `exp` gives, "any expression of type void *"):
;; `&&label` outside any function's body names no label ("label 'N' referenced outside of any function"); an enumerator's value
;; given by one is a pointer, no integral constant ("enumerator value for 'O' must have integral or unscoped enumeration type");
;; a computed goto's operand of array or class type does not convert to void * ("cannot convert 'b' from type 'B' to type
;; 'void*'"), its type read off the variable it names, through subscripts (ext/label1.C, label10.C, label11.C; templates' operands
;; are not judged).

(defn labels-as-values
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        report! (fn [n msg] (when-let [o (get-in n [:range :begin :offset])]
                              (when (= main (or (get-in n [:range :begin :file]) main))
                                (let [[l c] (line-col starts (long o))]
                                  (.add out {:line l :col c :kind :error :rule :label-value :msg msg})))))
        records (into #{} (keep #(when (and (= "CXXRecordDecl" (:kind %)) (:name %)) (:name %)) (:nodes u)))
        globals (into {} (for [n (:nodes u) :when (and (= "VarDecl" (:kind n)) (string? (:name n)))] [(:name n) (str (get-in n [:type :qualType]))]))
        strip (fn strip [x] (if (#{"ImplicitCastExpr" "ParenExpr"} (:kind x)) (strip (first (:inner x))) x))]
    (letfn [(w [x in-fn tmpl vars]
              (cond
                (map? x)
                (let [k (:kind x)
                      tmpl (or tmpl (#{"FunctionTemplateDecl" "ClassTemplateDecl"} k))
                      fn? (#{"FunctionDecl" "CXXMethodDecl" "CXXConstructorDecl" "CXXDestructorDecl" "LambdaExpr"} k)
                      vars (if fn? (into vars (for [pv (:inner x) :when (and (= "ParmVarDecl" (:kind pv)) (string? (:name pv)))] [(:name pv) (str (get-in pv [:type :qualType]))])) vars)]
                  ;; (local label declarations "must come at the beginning of the block, before any ordinary declarations or
                  ;; statements", the manual's "Locally Declared Labels": GCC's "'__label__' declarations are only allowed at the
                  ;; beginning of a block", ext/label9.C)
                  (let [label-decl? (fn [s] (and (map? s) (= "DeclStmt" (:kind s)) (seq (:inner s)) (every? #(= "LabelDecl" (:kind %)) (:inner s))))]
                    (if (= "CompoundStmt" k)
                      (loop [ss (:inner x) seen-other false]
                        (when-let [s1 (first ss)]
                          (when (and seen-other (label-decl? s1)) (report! s1 "'__label__' declarations are only allowed at the beginning of a block"))
                          (recur (rest ss) (or seen-other (not (label-decl? s1))))))
                      (when (#{"WhileStmt" "ForStmt" "DoStmt" "IfStmt" "SwitchStmt" "CXXForRangeStmt" "LabelStmt" "CaseStmt" "DefaultStmt"} k)
                        (doseq [s1 (:inner x) :when (label-decl? s1)]
                          (report! s1 "'__label__' declarations are only allowed at the beginning of a block")))))
                  (case k
                    "AddrLabelExpr" (when-not in-fn (report! x (str "label '" (:_label x) "' referenced outside of any function")))
                    "EnumConstantDecl" (when (some #(= "AddrLabelExpr" (:kind (strip %))) (:inner x))
                                         (report! x (str "enumerator value for '" (:name x) "' must have integral or unscoped enumeration type")))
                    "IndirectGotoStmt" (when-not tmpl
                                         (let [t (loop [e (strip (:_target x)) dims 0]
                                                   (case (:kind e)
                                                     "ArraySubscriptExpr" (recur (strip (first (:inner e))) (inc dims))
                                                     "DeclRefExpr" (when-let [qt (get vars (get-in e [:referencedDecl :name]) (get globals (get-in e [:referencedDecl :name])))]
                                                                     (loop [qt (str/trim qt) d dims]
                                                                       (cond (zero? d) qt
                                                                             (re-find #"\[\d*\]$" qt) (recur (str/trim (str/replace qt #"\[\d*\]$" "")) (dec d))
                                                                             (re-find #"\*$" qt) (recur (str/trim (str/replace qt #"\s*\*$" "")) (dec d))
                                                                             :else nil)))
                                                     nil))]
                                           (when (and t (or (re-find #"\]$" t)
                                                            (contains? records (str/trim (str/replace t #"\b(?:const|volatile|struct|class)\b" "")))))
                                             (report! x (str "cannot convert the operand from type '" t "' to type 'void*'")))))
                    nil)
                  (doseq [[kk v] x :when (and (not= kk :_ent) (or (map? v) (vector? v)))]
                    (w v (or in-fn fn?) tmpl vars)))
                (vector? x) (loop [ys x vars vars]
                              (when-let [y (first ys)]
                                (w y in-fn tmpl vars)
                                (recur (rest ys) (if (and (map? y) (= "DeclStmt" (:kind y)))
                                                   (into vars (for [d (:inner y) :when (and (= "VarDecl" (:kind d)) (string? (:name d)))] [(:name d) (str (get-in d [:type :qualType]))]))
                                                   vars))))
                :else nil))]
      (w (:nodes u) false false {}))
    (vec out)))

;; A switch's case values (cpp-gnu, 2026-11-22): [stmt.switch]/2, no two case constants of a switch have the same value, and GNU's
;; case ranges (the GCC 15.2 manual's "Case Ranges": `case low ... high:`, every value from low to high) none in common with another
;; label of the switch: "duplicate (or overlapping) case value", at the later label. The values read here: integer and character
;; literals, negation, a const or constexpr variable or an enumerator whose value is such a literal (an enumerator without one the
;; previous plus one); a label of another value is not judged. In a function template the switch is judged when its labels are
;; known and the unit names the template outside its definition (an instantiation, as GCC judges it; ext/case-range2.C).

(defn case-values
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        consts (java.util.HashMap.)
        strip (fn strip [x] (if (#{"ImplicitCastExpr" "ParenExpr" "ConstantExpr"} (:kind x)) (strip (first (:inner x))) x))
        lit (fn lit [x]
              (let [x (strip x)]
                (case (:kind x)
                  "IntegerLiteral" (some-> (:value x) str (str/replace #"[uUlL']+$" "") (#(try (Long/decode %) (catch Exception _ nil))))
                  "CharacterLiteral" (when (number? (:value x)) (long (:value x)))
                  "UnaryOperator" (when (#{"-" "+"} (:opcode x)) (when-let [v (lit (first (:inner x)))] (if (= "-" (:opcode x)) (- (long v)) v)))
                  "DeclRefExpr" (.get consts (get-in x [:referencedDecl :name]))
                  ;; (cpp-rind: a floating literal cast to a 64-bit integer type, its value truncated, [conv.fpint]/1;
                  ;; cpp0x/Wnarrowing17.C's `(long long int) 1e10`)
                  ("CStyleCastExpr" "CXXFunctionalCastExpr" "CXXStaticCastExpr")
                  (let [ws (get-in x [:_t :w]) y (strip (first (filter map? (:inner x))))]
                    (when (and (some #{"long"} ws) (not (some #{"double" "float"} ws)) (= "FloatingLiteral" (:kind y)))
                      (when-let [d (try (Double/parseDouble (str/replace (str (:value y)) #"[fFlL]$" "")) (catch Exception _ nil))]
                        (when (< (Math/abs (double d)) 9.0E18) (long d)))))
                  nil)))
        _ (walk-nodes (fn [n _]
                        (case (:kind n)
                          "VarDecl" (when (and (string? (:name n))
                                               (or (:constexpr n) (re-find #"^\s*const\b|\bconst\s*$" (str (get-in n [:type :qualType]))))
                                               (re-matches #"(?:const\s+)?(?:unsigned |signed )?(?:int|long|short|char|long long)\s*(?:const)?" (str/trim (str (get-in n [:type :qualType])))))
                                      (when-let [v (some lit (:inner n))] (.put consts (:name n) v)))
                          "EnumDecl" (loop [es (filter #(= "EnumConstantDecl" (:kind %)) (:inner n)) prev -1]
                                       (when-let [e (first es)]
                                         (let [v (if (seq (:inner e)) (some lit (:inner e)) (inc (long prev)))]
                                           (when (and v (string? (:name e))) (.put consts (:name e) v))
                                           (when v (recur (rest es) v)))))
                          nil))
                      (:nodes u) nil)
        ;; (cpp-rind: the scoped enumerations' names, a name also another type's not taken)
        scoped-enums (delay (let [sc (java.util.HashSet.) other (java.util.HashSet.)]
                              (walk-nodes (fn [n _] (when (and (string? (:name n)) (seq (:name n)))
                                                      (cond (and (= "EnumDecl" (:kind n)) (:scopedEnumTag n)) (.add sc (:name n))
                                                            (#{"EnumDecl" "CXXRecordDecl" "TypedefDecl" "TypeAliasDecl" "ClassTemplateDecl"} (:kind n)) (.add other (:name n))
                                                            :else nil)))
                                          (:nodes u) nil)
                              (set (remove #(.contains other %) sc))))
        ;; (the scoped enumerations' enumerators, a name also declared otherwise not taken)
        scoped-enumerators (delay (let [sc (java.util.HashSet.) other (java.util.HashSet.)]
                                    (walk-nodes (fn [n _] (when (= "EnumDecl" (:kind n))
                                                            (doseq [e (:inner n) :when (and (= "EnumConstantDecl" (:kind e)) (string? (:name e)))]
                                                              (.add (if (:scopedEnumTag n) sc other) (:name e))))
                                                    (when (and (#{"VarDecl" "FunctionDecl" "ParmVarDecl" "FieldDecl"} (:kind n)) (string? (:name n)))
                                                      (.add other (:name n))))
                                                (:nodes u) nil)
                                    (set (remove #(.contains other %) sc))))
        named (java.util.HashSet.)
        _ (walk-nodes (fn [n _] (when (= "DeclRefExpr" (:kind n)) (when-let [o (get-in n [:range :begin :offset])] (.add named [(get-in n [:referencedDecl :name]) (long o)])))) (:nodes u) nil)
        instantiated? (fn [t] (let [b (long (or (get-in t [:range :begin :offset]) -1)) e (long (or (get-in t [:range :end :offset]) -1))]
                                (some (fn [[nm o]] (and (= nm (:name t)) (or (< (long o) b) (> (long o) e)))) named)))]
    (letfn [(cases [body]
              ;; the case labels of a switch's body, not of the switches nested in it
              (let [acc (java.util.ArrayList.)]
                (letfn [(c [x] (cond (map? x) (when-not (= "SwitchStmt" (:kind x))
                                                (when (= "CaseStmt" (:kind x)) (.add acc x))
                                                (doseq [[kk v] x :when (and (not= kk :_ent) (or (map? v) (vector? v)))] (c v)))
                                     (vector? x) (doseq [y x] (c y))
                                     :else nil))]
                  (c body))
                (vec acc)))
            (judge [sw]
              ;; (cpp-rind: [stmt.switch]/2 from C++11, each case's constant a converted constant expression of the condition's
              ;; adjusted (promoted) type, so no narrowing ([expr.const]/12, [dcl.init.list]/7.4): a value that type cannot
              ;; represent is GCC's "narrowing conversion of '2149056512' from 'unsigned int' to 'int'", at the label; the
              ;; condition a variable of a fundamental integral type; cpp0x/Wnarrowing17.C)
              (let [cnd (some #(when (and (map? %) (= "DeclRefExpr" (:kind %))) %) (butlast (:inner sw)))
                    ws (when (= :b (get-in cnd [:_ent :ty :t])) (get-in cnd [:_ent :ty :w]))
                    nl (count (filter #{"long"} ws))
                    [rlo rhi tn] (cond (or (empty? ws) (some #{"float" "double" "__int128" "wchar_t" "char8_t" "char16_t" "char32_t"} ws)) nil
                                       (>= nl 1) (if (some #{"unsigned"} ws) [0 Long/MAX_VALUE "long unsigned int"] [Long/MIN_VALUE Long/MAX_VALUE "long int"])
                                       (and (some #{"unsigned"} ws) (not-any? #{"short" "char" "bool"} ws)) [0 4294967295 "unsigned int"]
                                       :else [-2147483648 2147483647 "int"])]
                ;; (cpp-rind: [stmt.switch]/2, a case's constant converted to the condition's type: a floating literal never an
                ;; integral constant expression nor a converted constant expression of an integral type, and an integer literal no
                ;; converted constant expression of a scoped enumeration ([dcl.enum]/10: no implicit conversion); GCC's "could not
                ;; convert '1' from 'int' to 'A'", "case label does not reduce to an integer constant"; cpp0x/enum15.C)
                (let [scoped? (and (= :n (get-in cnd [:_ent :ty :t])) (contains? @scoped-enums (get-in cnd [:_ent :ty :s])))]
                  (doseq [cs (cases (last (:inner sw)))
                          :let [k (strip (first (filter map? (:inner cs))))
                                k (if (and (= "UnaryOperator" (:kind k)) (#{"-" "+"} (:opcode k))) (strip (first (:inner k))) k)]
                          :when (or (= "FloatingLiteral" (:kind k)) (and scoped? (#{"IntegerLiteral" "CharacterLiteral"} (:kind k)))
                                    ;; (a scoped enumeration's enumerator in a switch on an integral variable)
                                    (and (seq ws) (= "DeclRefExpr" (:kind k)) (get-in k [:_ent :enumerator])
                                         (contains? @scoped-enumerators (get-in k [:referencedDecl :name]))))]
                    (when-let [o (get-in cs [:range :begin :offset])]
                      (when (= main (or (get-in cs [:range :begin :file]) main))
                        (let [[l c] (line-col starts (long o))]
                          (.add out {:line l :col c :kind :error :rule :case-value
                                     :msg (if (= "FloatingLiteral" (:kind k)) "case label does not reduce to an integer constant"
                                              (str "could not convert the case value to the condition's type" (when scoped? (str " '" (get-in cnd [:_ent :ty :s]) "'"))))}))))))
                (when (and rlo (>= (long (cxx-year (:std u))) 11))
                  (doseq [cs (cases (last (:inner sw)))
                          :let [v (lit (first (:inner cs)))]
                          :when (and v (not (<= (long rlo) (long v) (long rhi))))]
                    (when-let [o (get-in cs [:range :begin :offset])]
                      (when (= main (or (get-in cs [:range :begin :file]) main))
                        (let [[l c] (line-col starts (long o))]
                          (.add out {:line l :col c :kind :error :rule :case-value :msg (str "narrowing conversion of '" v "' to '" tn "'")})))))))
              (let [seen (java.util.ArrayList.)]
                (doseq [cs (cases (last (:inner sw)))
                        :let [in (vec (:inner cs))
                              range? (and (= 3 (count in)) (lit (nth in 1)))
                              lo (lit (first in)) hi (if range? (lit (nth in 1)) lo)]
                        :when (and lo hi)]
                  (when (some (fn [[a z]] (and (<= (long a) (long hi)) (<= (long lo) (long z)))) seen)
                    (when-let [o (get-in cs [:range :begin :offset])]
                      (when (= main (or (get-in cs [:range :begin :file]) main))
                        (let [[l c] (line-col starts (long o))]
                          (.add out {:line l :col c :kind :error :rule :case-value :msg "duplicate (or overlapping) case value"})))))
                  (.add seen [lo hi]))))
            (w [x tmpl]
              (cond (map? x) (let [tmpl (if (#{"FunctionTemplateDecl" "ClassTemplateDecl"} (:kind x)) x tmpl)]
                               (when (and (= "SwitchStmt" (:kind x)) (or (nil? tmpl) (and (= "FunctionTemplateDecl" (:kind tmpl)) (instantiated? tmpl))))
                                 (judge x))
                               (doseq [[kk v] x :when (and (not= kk :_ent) (or (map? v) (vector? v)))] (w v tmpl)))
                    (vector? x) (doseq [y x] (w y tmpl))
                    :else nil))]
      (w (:nodes u) nil))
    (vec out)))

;; GNU's statement expressions in a constant expression (cpp-gnu, 2026-11-22; the GCC 15.2 manual's "Statements and Declarations in
;; Expressions": `({ ... })`, its value the last expression statement's): evaluated in a constexpr variable's initializer, its
;; declarations are a constexpr function body's ([dcl.constexpr]/3 before C++23, [expr.const]/5): a static variable there,
;; "'inner' defined 'static' in 'constexpr' context"; before C++20 a variable with no initialization, "uninitialized variable
;; 'inner' in 'constexpr' context", each at the variable (ext/stmtexpr21.C, stmtexpr25.C).

(defn stmt-expr-constexpr
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        year (cxx-year (:std u))
        report! (fn [n msg] (when-let [o (or (get-in n [:loc :offset]) (get-in n [:range :begin :offset]))]
                              (when (= main (or (get-in n [:loc :file]) (get-in n [:range :begin :file]) main))
                                (let [[l c] (line-col starts (long o))]
                                  (.add out {:line l :col c :kind :error :rule :stmt-expr :msg msg})))))]
    (walk-nodes (fn [v _]
                  (when (and (= "VarDecl" (:kind v)) (:constexpr v))
                    (walk-nodes (fn [se _]
                                  (when (= "StmtExpr" (:kind se))
                                    (doseq [cs (:inner se) :when (= "CompoundStmt" (:kind cs))
                                            ds (:inner cs) :when (= "DeclStmt" (:kind ds))
                                            d (:inner ds) :when (and (= "VarDecl" (:kind d)) (string? (:name d)))]
                                      (cond
                                        (= "static" (:storageClass d)) (report! d (str "'" (:name d) "' defined 'static' in 'constexpr' context"))
                                        (and (< (long year) 20) (not (:init d)) (not= "extern" (:storageClass d))
                                             (or (int-type-size (str (get-in d [:type :qualType]))) (float-type-size (str (get-in d [:type :qualType]))))
                                             (not (some #(not (#{"NativeAttr"} (:kind %))) (:inner d))))
                                        (report! d (str "uninitialized variable '" (:name d) "' in 'constexpr' context"))
                                        :else nil))))
                                (:inner v) nil)))
                (:nodes u) nil)
    (vec out)))

;; GNU's asm (cpp-gnu, 2026-11-22; the GCC 15.2 manual's "Extended Asm", "Constraints for asm Operands", "Explicit Register
;; Variables"): an operand whose constraint allows only a register (no m, o, V, g, X, p, < or > among its letters) cannot be an object
;; of a class with a user-declared destructor or copy constructor, which must stay in memory ("impossible constraint in 'asm'", the
;; operand's type read off the variable, member or parameter it names; ext/asm10.C, asm15.C, asm16.C); the address of an explicit
;; register variable (`register T x asm ("reg");`) is not taken ("address of explicit register variable 'x' requested",
;; warn/register-var-1.C); an asm statement evaluated in a constant expression -- in the cleanup function GNU's cleanup attribute
;; ("Common Variable Attributes") runs at the end of a variable's scope in a constexpr function a constexpr variable's initializer
;; calls -- is no constant expression ("inline assembly is not a constant expression", ext/constexpr-attr-cleanup1.C).

(defn gnu-asm
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        report! (fn [n msg] (when-let [o (or (get-in n [:loc :offset]) (get-in n [:range :begin :offset]))]
                              (when (= main (or (get-in n [:loc :file]) (get-in n [:range :begin :file]) main))
                                (let [[l c] (line-col starts (long o))]
                                  (.add out {:line l :col c :kind :error :rule :gnu-asm :msg msg})))))
        records (into {} (for [n (:nodes u) :when (and (= "CXXRecordDecl" (:kind n)) (:name n) (:completeDefinition n))] [(:name n) n]))
        memory-class? (fn [r] (some (fn [m] (or (and (= "CXXDestructorDecl" (:kind m)) (not (:explicitlyDefaulted m)))
                                                (and (= "CXXConstructorDecl" (:kind m)) (not (:explicitlyDefaulted m))
                                                     (re-find (re-pattern (str "^void \\((?:const )?" (java.util.regex.Pattern/quote (str (:name r))) " &\\)$"))
                                                              (str (get-in m [:type :qualType]))))))
                                    (:inner r)))
        cls-of (fn [^String qt] (get records (-> qt (str/replace #"\b(?:const|volatile|struct|class)\b" "") (str/replace #"\s*&+\s*$" "") str/trim)))
        globals (into {} (for [n (:nodes u) :when (and (= "VarDecl" (:kind n)) (string? (:name n)))] [(:name n) n]))
        strip (fn strip [x] (if (#{"ImplicitCastExpr" "ParenExpr"} (:kind x)) (strip (first (:inner x))) x))
        reg-only? (fn [^String c] (let [c (str/replace c #"[\"=+&%*#!?,]" "")] (and (seq c) (re-matches #"[rqQRabcdSDxyftulYvk]+" c))))]
    (letfn [(w [x vars cls]
              (cond
                (map? x)
                (let [k (:kind x)
                      fn? (#{"FunctionDecl" "CXXMethodDecl" "CXXConstructorDecl" "CXXDestructorDecl"} k)
                      vars (if fn? (into vars (for [pv (:inner x) :when (and (= "ParmVarDecl" (:kind pv)) (string? (:name pv)))] [(:name pv) pv])) vars)
                      cls (cond (= "CXXRecordDecl" k) x
                                (and fn? (#{"CXXConstructorDecl" "CXXMethodDecl" "CXXDestructorDecl"} k) (get records (str/replace (str (:name x)) #"^~" ""))) (get records (str/replace (str (:name x)) #"^~" ""))
                                :else cls)
                      type-of (fn [e]
                                (let [e (strip e)]
                                  (case (:kind e)
                                    "DeclRefExpr" (let [nm (get-in e [:referencedDecl :name])]
                                                    (if-let [d (or (get vars nm) (get globals nm))]
                                                      (str (get-in d [:type :qualType]))
                                                      (some #(when (and (= "FieldDecl" (:kind %)) (= nm (:name %))) (str (get-in % [:type :qualType]))) (:inner cls))))
                                    "MemberExpr" (let [b (strip (first (:inner e)))
                                                       bt (case (:kind b)
                                                            "DeclRefExpr" (let [nm (get-in b [:referencedDecl :name])] (some-> (or (get vars nm) (get globals nm)) (get-in [:type :qualType]) str))
                                                            nil)
                                                       r (if (= "CXXThisExpr" (:kind b)) cls (when bt (cls-of (str/replace bt #"\s*\*$" ""))))]
                                                   (some #(when (and (= "FieldDecl" (:kind %)) (= (:name e) (:name %))) (str (get-in % [:type :qualType]))) (:inner r)))
                                    nil)))]
                  (when (= "GCCAsmStmt" k)
                    (let [a (:_asm x) cons (concat (:outputs a) (:inputs a))]
                      (doseq [[[_ c] e] (map vector cons (:inner x))
                              :when (and c e (reg-only? (str c)))
                              :let [t (type-of e) r (when t (cls-of t))]
                              :when (and r (memory-class? r))]
                        (report! x "impossible constraint in 'asm'"))))
                  (when (and (= "UnaryOperator" k) (= "&" (:opcode x)))
                    (let [e (strip (first (:inner x)))]
                      (when (= "DeclRefExpr" (:kind e))
                        (let [nm (get-in e [:referencedDecl :name])]
                          (when (:_asmreg (get vars nm))
                            (report! x (str "address of explicit register variable '" nm "' requested")))))))
                  (doseq [[kk v] x :when (and (not= kk :_ent) (or (map? v) (vector? v)))]
                    (w v vars cls)))
                (vector? x) (loop [ys x vars vars]
                              (when-let [y (first ys)]
                                (w y vars cls)
                                (recur (rest ys) (if (and (map? y) (= "DeclStmt" (:kind y)))
                                                   (into vars (for [d (:inner y) :when (and (= "VarDecl" (:kind d)) (string? (:name d)))] [(:name d) d]))
                                                   vars))))
                :else nil))]
      (w (:nodes u) {} nil))
    ;; a cleanup function with an asm statement, run by a constexpr function a constexpr variable's initializer calls
    (let [fns (into {} (for [n (:nodes u) :when (and (= "FunctionDecl" (:kind n)) (string? (:name n)))] [(:name n) n]))
          asm-in (fn [f] (let [r (atom nil)] (walk-nodes (fn [n _] (when (and (nil? @r) (= "GCCAsmStmt" (:kind n))) (reset! r n))) (:inner f) nil) @r))]
      (doseq [v (:nodes u) :when (and (= "VarDecl" (:kind v)) (:constexpr v))
              :let [call (some (fn [x] (let [x (strip x)] (when (= "CallExpr" (:kind x)) x))) (:inner v))
                    f (get fns (get-in (some-> call :inner first strip) [:referencedDecl :name]))]
              :when f
              :let [cleanups (let [acc (java.util.ArrayList.)]
                               (walk-nodes (fn [n _] (when (= "VarDecl" (:kind n))
                                                       (doseq [a (gnu-attrs-of n) :when (= "cleanup" (gnu-attr-name a))] (.add acc (str/trim (str (:_arg a)))))))
                                           (:inner f) nil)
                               acc)]
              g (distinct cleanups)
              :let [gf (get fns g) a (when gf (asm-in gf))]
              :when a]
        (report! a "inline assembly is not a constant expression")))
    (vec (distinct out))))

;; GNU's packed attribute (cpp-gnu, 2026-11-22; the GCC 15.2 manual's "Common Type Attributes" and "Common Variable Attributes":
;; packed on a structure lays its members out with the smallest alignment, one byte, packed on a field likewise for it): a reference
;; bound to a packed field, or to a member reached through one, of a type whose alignment is more than a byte would claim an
;; alignment the object lacks: GCC's "cannot bind packed field ... to 'int&'". Bound here: a call's argument for a parameter of
;; non-const reference type (every function of the callee's name and arity has one there); a packed field of a class with a
;; user-declared copy constructor copied (a function returning the class by value returning the field, whose copy constructor
;; binds a const reference: ext/packed8.C); the implicit copy constructor of a class with such a packed field used (a
;; mem-initializer copying an object of the class), at that class (other/crash-4.C); ext/packed3.C.

(defn gnu-packed
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        report! (fn [n msg] (when-let [o (or (get-in n [:loc :offset]) (get-in n [:range :begin :offset]))]
                              (when (= main (or (get-in n [:loc :file]) (get-in n [:range :begin :file]) main))
                                (let [[l c] (line-col starts (long o))]
                                  (.add out {:line l :col c :kind :error :rule :gnu-packed :msg msg})))))
        records (into {} (for [n (:nodes u) :when (and (= "CXXRecordDecl" (:kind n)) (:name n) (:completeDefinition n))] [(:name n) n]))
        packed-attr? (fn [n] (some #(= "packed" (gnu-attr-name %)) (gnu-attrs-of n)))
        cls-of (fn [^String qt] (get records (-> (str qt) (str/replace #"\b(?:const|volatile|struct|class)\b" "") (str/replace #"\s*[&*]+\s*$" "") str/trim)))
        field-of (fn [r nm] (some #(when (and (= "FieldDecl" (:kind %)) (= nm (:name %))) %) (:inner r)))
        aligned? (fn [^String qt] (let [t (str/trim (str/replace qt #"\b(?:const|volatile)\b" ""))]
                                    (cond (int-type-size t) (> (long (int-type-size t)) 1)
                                          (float-type-size t) true
                                          (cls-of t) (some #(and (= "FieldDecl" (:kind %)) (not (re-find #"char|bool" (str (get-in % [:type :qualType]))))) (:inner (cls-of t)))
                                          :else false)))
        copy-ctor? (fn [r] (some #(and (= "CXXConstructorDecl" (:kind %)) (not (:explicitlyDefaulted %))
                                       (re-find (re-pattern (str "^void \\((?:const )?" (java.util.regex.Pattern/quote (str (:name r))) " &\\)$")) (str (get-in % [:type :qualType]))))
                                 (:inner r)))
        globals (into {} (for [n (:nodes u) :when (and (#{"VarDecl"} (:kind n)) (string? (:name n)))] [(:name n) n]))
        fns (group-by :name (filter #(= "FunctionDecl" (:kind %)) (:nodes u)))
        strip (fn strip [x] (if (#{"ImplicitCastExpr" "ParenExpr"} (:kind x)) (strip (first (:inner x))) x))]
    (letfn [(info [e vars cls]
              ;; [type packed?] of an lvalue expression: a variable, a member access through one, `this`'s members
              (let [e (strip e)]
                (case (:kind e)
                  "DeclRefExpr" (let [nm (get-in e [:referencedDecl :name])]
                                  (if-let [d (or (get vars nm) (get globals nm))]
                                    [(str (get-in d [:type :qualType])) false]
                                    (when-let [f (and cls (field-of cls nm))]
                                      [(str (get-in f [:type :qualType])) (boolean (or (packed-attr? f) (packed-attr? cls)))])))
                  "MemberExpr" (let [b (strip (first (:inner e)))
                                     [bt bp] (if (= "CXXThisExpr" (:kind b)) [(:name cls) false] (info b vars cls))
                                     r (when bt (cls-of bt))
                                     f (when r (field-of r (:name e)))]
                                 (when f [(str (get-in f [:type :qualType])) (boolean (or bp (packed-attr? f) (packed-attr? r)))]))
                  nil)))
            (w [x vars cls fnode]
              (cond
                (map? x)
                (let [k (:kind x)
                      fn? (#{"FunctionDecl" "CXXMethodDecl" "CXXConstructorDecl"} k)
                      vars (if fn? (into vars (for [pv (:inner x) :when (and (= "ParmVarDecl" (:kind pv)) (string? (:name pv)))] [(:name pv) pv])) vars)
                      cls (if (= "CXXRecordDecl" k) x cls)
                      fnode (if fn? x fnode)]
                  (case k
                    "CallExpr" (let [callee (strip (first (:inner x)))
                                     args (rest (:inner x))
                                     cands (when (= "DeclRefExpr" (:kind callee)) (get fns (get-in callee [:referencedDecl :name])))]
                                 (doseq [[i a] (map-indexed vector args)
                                         :let [[t pk] (info a vars cls)]
                                         :when (and pk t (aligned? t)
                                                    (seq cands)
                                                    (every? (fn [c] (let [ps (filter #(= "ParmVarDecl" (:kind %)) (:inner c))]
                                                                      (when (= (count ps) (count args))
                                                                        (let [pt (str/trim (str (get-in (nth (vec ps) i) [:type :qualType])))]
                                                                          (and (re-find #"[^&]&$" pt) (not (re-find #"^const\b" pt)))))))
                                                            cands))]
                                   (report! a (str "cannot bind packed field to '" t "&'"))))
                    "ReturnStmt" (when-let [e (first (:inner x))]
                                   (let [[t pk] (info e vars cls)
                                         r (when t (cls-of t))]
                                     (when (and pk r (copy-ctor? r) fnode (= (str/trim (str (fn-ret-type (str (get-in fnode [:type :qualType]))))) (str/trim (str/replace t #"\b(?:struct|class)\b" ""))))
                                       (report! x (str "cannot bind packed field to 'const " (:name r) "&'")))))
                    "CXXCtorInitializer" (when-let [f (and cls (field-of cls (get-in x [:anyInit :name])))]
                                           (when-let [fr (cls-of (str (get-in f [:type :qualType])))]
                                             (let [e (some-> (first (:inner x)) strip)
                                                   et (when (= "DeclRefExpr" (:kind e)) (some-> (get vars (get-in e [:referencedDecl :name])) (get-in [:type :qualType]) str))]
                                               (when (and et (= fr (cls-of et))
                                                          (some (fn [m] (and (= "FieldDecl" (:kind m)) (or (packed-attr? m) (packed-attr? fr))
                                                                             (when-let [mc (cls-of (str (get-in m [:type :qualType])))] (copy-ctor? mc))))
                                                                (:inner fr))
                                                          (not (copy-ctor? fr)))
                                                 (report! fr (str "cannot bind packed field in the implicit copy constructor of '" (:name fr) "'"))))))
                    nil)
                  (doseq [[kk v] x :when (and (not= kk :_ent) (or (map? v) (vector? v)))]
                    (w v vars cls fnode)))
                (vector? x) (doseq [y x] (w y vars cls fnode))
                :else nil))]
      (w (:nodes u) {} nil nil))
    (vec (distinct out))))

;; GCC's own interfaces and options (cpp-gnu, 2026-11-22), each from the GCC 15.2 manual (invoke.texi, extend.texi, libstdc++'s):
;; - -fno-exceptions ("Options Controlling C++ Dialect"): the first throw-expression or try-block of the unit, "exception handling
;;   disabled, use '-fexceptions' to enable", once (eh/no-exceptions1.C);
;; - GCC's decimal floating types for C++ (the ISO/IEC TR 24733 classes std::decimal::decimal32, decimal64, decimal128, which GCC
;;   lays out as the _Decimal type they hold): such a class with a base class ("'decimal32' has base classes") or without a field
;;   ("'decimal32' does not have any fields"), at the class (dfp/base.C, dfp/nofields.C);
;; - -Werror=deprecated-copy-dtor ([depr.impldec]/1: the implicit copy constructor of a class with a user-provided destructor is
;;   deprecated, the warning made an error): a copy initialization from an object of such a class without a user-declared copy
;;   constructor, at the declaration, from C++11 (cpp0x/depr-copy5.C);
;; - weak ("Common Function Attributes"): a function declared weak after a manifestly constant-evaluated use of its address (an
;;   if constexpr condition naming it, whose value assumed it defined), "declared weak after being used" (cpp1z/constexpr-if36.C);
;; - format (archetype, string-index, first-to-check) on a non-static member function or a constructor counts the implicit this as
;;   argument 1; its string-index argument names a parameter of character pointer type, else "'format' attribute argument 2 value
;;   '2' refers to parameter type 'int'" (ext/attr-format3.C; an index past the parameters is a warning);
;; - std::initializer_list, whose layout g++ builds itself (libstdc++'s <initializer_list>: a pointer to const E and a size_t): a
;;   definition by the program of other members, "definition of 'std::initializer_list' does not match '#include
;;   <initializer_list>'", at the class template (cpp0x/initlist93.C).

(defn gnu-interface
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        args (set (:args u))
        year (cxx-year (:std u))
        report! (fn [n msg] (when-let [o (or (get-in n [:loc :offset]) (get-in n [:range :begin :offset]))]
                              (when (= main (or (get-in n [:loc :file]) (get-in n [:range :begin :file]) main))
                                (let [[l c] (line-col starts (long o))]
                                  (.add out {:line l :col c :kind :error :rule :gnu-interface :msg msg})
                                  true))))
        records (into {} (for [n (:nodes u) :when (and (= "CXXRecordDecl" (:kind n)) (:name n) (:completeDefinition n))] [(:name n) n]))]
    ;; -fno-exceptions
    (when (contains? args "-fno-exceptions")
      (let [first-eh (atom nil)]
        (walk-nodes (fn [n _] (when (#{"CXXThrowExpr" "CXXTryStmt"} (:kind n))
                                (let [o (get-in n [:range :begin :offset])]
                                  (when (and o (= main (or (get-in n [:range :begin :file]) main))
                                             (or (nil? @first-eh) (< (long o) (long (get-in @first-eh [:range :begin :offset])))))
                                    (reset! first-eh n)))))
                    (:nodes u) nil)
        (when-let [n @first-eh] (report! n "exception handling disabled, use '-fexceptions' to enable"))))
    ;; std::decimal's classes and std::initializer_list
    (doseq [nsd (:nodes u) :when (and (= "NamespaceDecl" (:kind nsd)) (= "std" (:name nsd)))]
      (doseq [d (:inner nsd) :when (and (= "NamespaceDecl" (:kind d)) (= "decimal" (:name d)))
              r (:inner d) :when (and (= "CXXRecordDecl" (:kind r)) (:completeDefinition r) (#{"decimal32" "decimal64" "decimal128"} (:name r)))]
        (cond (seq (:bases r)) (report! r (str "'" (:name r) "' has base classes"))
              (not-any? #(= "FieldDecl" (:kind %)) (:inner r)) (report! r (str "'" (:name r) "' does not have any fields"))
              :else nil))
      (doseq [t (:inner nsd) :when (and (= "ClassTemplateDecl" (:kind t)) (= "initializer_list" (:name t)))
              :let [e (some #(when (= "TemplateTypeParmDecl" (:kind %)) (:name %)) (:inner t))
                    r (some #(when (and (= "CXXRecordDecl" (:kind %)) (:completeDefinition %)) %) (:inner t))]
              :when r]
        (let [tds (into {} (for [m (:inner r) :when (#{"TypedefDecl" "TypeAliasDecl"} (:kind m))] [(:name m) (str/trim (str (get-in m [:type :qualType])))]))
              ty (fn [f] (let [t (str/trim (str (get-in f [:type :qualType])))] (get tds t t)))
              fs (filter #(= "FieldDecl" (:kind %)) (:inner r))
              ok (and e (= 2 (count fs))
                      (re-matches (re-pattern (str "const " (java.util.regex.Pattern/quote e) " \\*")) (ty (first fs)))
                      (#{"size_t" "std::size_t" "unsigned long" "__SIZE_TYPE__" "::size_t"} (ty (second fs))))]
          (when-not ok (report! t "definition of 'std::initializer_list' does not match '#include <initializer_list>'"))))
      ;; (cpp-sweep: [support.initlist]/1, std::initializer_list is a class template: a class of that name declared in std that is
      ;; no template is GCC's "declaration of 'std::initializer_list' does not match '#include <initializer_list>', isn't a
      ;; template", at its name: cpp0x/initlist85.C, initlist97.C)
      (doseq [r (:inner nsd) :when (and (= "CXXRecordDecl" (:kind r)) (= "initializer_list" (:name r)) (not (:isImplicit r)))]
        (report! r "declaration of 'std::initializer_list' does not match '#include <initializer_list>', isn't a template")))
    ;; -Werror=deprecated-copy-dtor
    (when (and (>= (long year) 11) (or (contains? args "-Werror=deprecated-copy-dtor") (and (contains? args "-Werror") (contains? args "-Wdeprecated-copy-dtor"))))
      (let [deprecated? (fn [r] (and (some #(and (= "CXXDestructorDecl" (:kind %)) (not (:explicitlyDefaulted %)) (not (:isImplicit %))) (:inner r))
                                     (not-any? #(and (#{"CXXConstructorDecl" "CXXMethodDecl"} (:kind %))
                                                     (or (= "operator=" (:name %))
                                                         (re-find (re-pattern (str "\\((?:const )?" (java.util.regex.Pattern/quote (str (:name r))) " &\\)")) (str (get-in % [:type :qualType])))))
                                               (:inner r))))]
        (letfn [(w [x vars]
                  (cond (map? x) (doseq [[kk v] x :when (and (not= kk :_ent) (or (map? v) (vector? v)))] (w v vars))
                        (vector? x) (loop [ys x vars vars]
                                      (when-let [y (first ys)]
                                        (w y vars)
                                        (let [vs (when (and (map? y) (= "DeclStmt" (:kind y))) (filter #(= "VarDecl" (:kind %)) (:inner y)))]
                                          (doseq [v vs]
                                            (let [r (get records (str/trim (str (get-in v [:type :qualType]))))
                                                  e (first (filter #(= "DeclRefExpr" (:kind %)) (:inner v)))]
                                              (when (and r e (= "c" (:init v)) (deprecated? r)
                                                         (= (get vars (get-in e [:referencedDecl :name])) (:name r)))
                                                (report! v (str "implicitly-declared copy constructor of '" (:name r) "' is deprecated [-Werror=deprecated-copy-dtor]")))))
                                          (recur (rest ys) (into vars (for [v vs :when (string? (:name v))] [(:name v) (str/trim (str (get-in v [:type :qualType])))]))))))
                        :else nil))]
          (w (:nodes u) {}))))
    ;; weak after a constant-evaluated use
    (let [used (java.util.HashMap.)]
      (walk-nodes (fn [n _] (when (and (= "IfStmt" (:kind n)) (:isConstexpr n))
                              (walk-nodes (fn [d _] (when (= "DeclRefExpr" (:kind d))
                                                      (let [nm (get-in d [:referencedDecl :name]) o (get-in d [:range :begin :offset])]
                                                        (when (and (string? nm) o (not (.containsKey used nm))) (.put used nm (long o))))))
                                          (first (:inner n)) nil)))
                  (:nodes u) nil)
      (doseq [f (:nodes u) :when (and (= "FunctionDecl" (:kind f)) (some #(= "weak" (gnu-attr-name %)) (gnu-attrs-of f)))
              :let [o (get-in f [:range :begin :offset]) uo (.get used (:name f))]
              :when (and o uo (> (long o) (long uo)))]
        (report! f (str "'" (:name f) "' declared weak after being used"))))
    ;; format's string index
    (walk-nodes (fn [n parent]
                  (when (#{"FunctionDecl" "CXXMethodDecl" "CXXConstructorDecl"} (:kind n))
                    (doseq [a (gnu-attrs-of n) :when (= "format" (gnu-attr-name a))
                            :let [[_ si] (re-matches #"\s*\w+\s*,\s*(\d+)\s*,\s*\d+\s*" (str (:_arg a)))]
                            :when si]
                      (let [member? (and (#{"CXXMethodDecl" "CXXConstructorDecl"} (:kind n)) (not= "static" (:storageClass n)))
                            ps (vec (filter #(= "ParmVarDecl" (:kind %)) (:inner n)))
                            k (- (Long/parseLong si) 1 (if member? 1 0))]
                        (when (and (>= k 0) (< k (count ps)))
                          (let [pt (str/trim (str (get-in (nth ps k) [:type :qualType])))]
                            (when-not (re-find #"char\s*(?:const\s*)?\*$" pt)
                              (report! a (str "'format' attribute argument 2 value '" si "' refers to parameter type '" pt "'")))))))))
                (:nodes u) nil)
    (vec out)))

;; GCC's maximum object size (cpp-gnu, 2026-11-22; [intro.compliance.general]/2's resource limits, [dcl.array]/1's bound a
;; converted constant expression of type size_t: GCC refuses an object larger than PTRDIFF_MAX, 2^63-1 on x86-64, so that pointer
;; differences within it are defined, [expr.add]/5): an array variable, or an array member of a class template's specialization the
;; unit names by its arguments, whose size in bytes passes it: "size of array 'a' exceeds maximum object size '9223372036854775807'",
;; at the declarator; the variable then declares nothing, its later uses in the block "'a' was not declared in this scope"
;; (other/large-size-array.C, template/array32.C). The bounds read here: integer literals, their arithmetic, a template's
;; non-type parameters; the elements fundamental types or pointers.

(defn- int-eval
  "The value of an integer constant expression's text (literals with their suffixes, + - * / % << >> & | ^ ~, parentheses, names
  `env` maps to numbers) as a BigInteger, or nil."
  [^String text env]
  (let [toks (vec (re-seq #"0[xX][0-9a-fA-F]+[uUlL]*|\d+[uUlL]*|[A-Za-z_]\w*|<<|>>|[-+*/%&|^~()]" (str text)))
        pos (atom 0)
        pk (fn [] (get toks @pos))
        nx (fn [] (let [t (pk)] (swap! pos inc) t))
        prec {"|" 1 "^" 2 "&" 3 "<<" 4 ">>" 4 "+" 5 "-" 5 "*" 6 "/" 6 "%" 6}]
    (try
      (letfn [(prim []
                (let [t (nx)]
                  (cond (nil? t) (throw (ex-info "end" {}))
                        (= t "(") (let [v (expr 0)] (when-not (= ")" (nx)) (throw (ex-info ")" {}))) v)
                        (= t "-") (.negate ^java.math.BigInteger (prim))
                        (= t "+") (prim)
                        (= t "~") (.not ^java.math.BigInteger (prim))
                        (re-find #"^0[xX]" t) (java.math.BigInteger. (str/replace (subs t 2) #"[uUlL]+$" "") 16)
                        (re-find #"^0\d" t) (java.math.BigInteger. (str/replace (subs t 1) #"[uUlL]+$" "") 8)
                        (re-find #"^\d" t) (java.math.BigInteger. (str/replace t #"[uUlL]+$" ""))
                        (contains? env t) (java.math.BigInteger. (str (get env t)))
                        :else (throw (ex-info "name" {})))))
              (expr [mp]
                (loop [l (prim)]
                  (let [op (pk) pr (get prec op)]
                    (if (and pr (> (long pr) (long mp)))
                      (do (nx)
                          (let [r (expr pr) ^java.math.BigInteger l l ^java.math.BigInteger r r]
                            (recur (case op "+" (.add l r) "-" (.subtract l r) "*" (.multiply l r) "/" (.divide l r) "%" (.mod l r)
                                         "<<" (.shiftLeft l (.intValue r)) ">>" (.shiftRight l (.intValue r))
                                         "&" (.and l r) "|" (.or l r) "^" (.xor l r)))))
                      l))))]
        (let [v (expr 0)] (when (nil? (pk)) v)))
      (catch Exception _ nil))))

(defn object-sizes
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        max-size (java.math.BigInteger. "9223372036854775807")
        report! (fn [n msg] (when-let [o (or (get-in n [:loc :offset]) (get-in n [:range :begin :offset]))]
                              (when (= main (or (get-in n [:loc :file]) (get-in n [:range :begin :file]) main))
                                (let [[l c] (line-col starts (long o))]
                                  (.add out {:line l :col c :kind :error :rule :object-size :msg msg})))))
        size-of (fn [^String qt env]
                  ;; the array type's size in bytes, or nil
                  (when-let [[_ el dims] (re-matches #"(.*?)\s*((?:\[[^\[\]]+\])+)" (str/trim qt))]
                    (let [es (or (int-type-size el) (float-type-size el))
                          ds (map #(int-eval % env) (map second (re-seq #"\[([^\[\]]+)\]" dims)))]
                      (when (and es (every? some? ds))
                        (reduce #(.multiply ^java.math.BigInteger %1 ^java.math.BigInteger %2) (java.math.BigInteger/valueOf (long es)) ds)))))
        too-big? (fn [v] (and v (pos? (.compareTo ^java.math.BigInteger v max-size))))
        tmpls (into {} (for [t (:nodes u) :when (= "ClassTemplateDecl" (:kind t))] [(:name t) t]))]
    ;; variables (a failed one's later uses in its block)
    (letfn [(w [x]
              (cond (map? x) (doseq [[kk v] x :when (and (not= kk :_ent) (or (map? v) (vector? v)))] (w v))
                    (vector? x) (loop [ys x failed #{}]
                                  (when-let [y (first ys)]
                                    (when (seq failed)
                                      (walk-nodes (fn [d _] (when (and (= "DeclRefExpr" (:kind d)) (contains? failed (get-in d [:referencedDecl :name])))
                                                              (report! d (str "'" (get-in d [:referencedDecl :name]) "' was not declared in this scope"))))
                                                  y nil))
                                    (w y)
                                    (let [bad (when (map? y)
                                                (for [v (if (= "DeclStmt" (:kind y)) (:inner y) [y])
                                                      :when (and (= "VarDecl" (:kind v)) (string? (:name v)) (too-big? (size-of (str (get-in v [:type :qualType])) {})))]
                                                  (do (report! v (str "size of array '" (:name v) "' exceeds maximum object size '9223372036854775807'")) (:name v))))]
                                      (recur (rest ys) (into failed bad)))))
                    :else nil))]
      (w (:nodes u)))
    ;; a class template's array members at the specializations the unit's variables name
    (walk-nodes (fn [v _]
                  (when (= "VarDecl" (:kind v))
                    (when-let [[_ nm as] (re-matches #"(?:struct |class )?(\w+)<(.*)>" (str/trim (str (get-in v [:type :qualType]))))]
                      (when-let [t (get tmpls nm)]
                        (let [ps (vec (keep #(when (= "NonTypeTemplateParmDecl" (:kind %)) (:name %)) (:inner t)))
                              args (map str/trim (str/split as #","))
                              env (into {} (keep (fn [[p a]] (when-let [v (int-eval a {})] [p v])) (map vector ps args)))
                              r (some #(when (= "CXXRecordDecl" (:kind %)) %) (:inner t))]
                          (when (= (count ps) (count args) (count env))
                            (doseq [f (:inner r) :when (= "FieldDecl" (:kind f))]
                              (when (too-big? (size-of (str (get-in f [:type :qualType])) env))
                                (report! f (str "size of array '" (:name f) "' exceeds maximum object size '9223372036854775807'"))))))))))
                (:nodes u) nil)
    (vec (distinct out))))

;; GNU's variable-length arrays in C++ (cpp-gnu, 2026-11-22; the GCC 15.2 manual's "Arrays of Variable Length": an automatic array
;; whose bound is no constant, its type variably modified, as C's 6.7.6.2): such a type for a data member or a parameter (a local
;; class's, through a typedef of the block; "data member may not have variably modified type", "parameter may not have variably
;; modified type", diagnostic/variably-modified-type-1.C), or as a function template's explicit template argument ("'int [n]' is a
;; variably modified type", at the template whose specialization it would make, template/pr65390.C). A bound is variable when it
;; names a variable or parameter of the function that is neither const nor constexpr.

(defn vla-types
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        report! (fn [n msg] (when-let [o (or (get-in n [:loc :offset]) (get-in n [:range :begin :offset]))]
                              (when (= main (or (get-in n [:loc :file]) (get-in n [:range :begin :file]) main))
                                (let [[l c] (line-col starts (long o))]
                                  (.add out {:line l :col c :kind :error :rule :vla :msg msg})))))
        tmpl-fns (into {} (for [t (:nodes u) :when (= "FunctionTemplateDecl" (:kind t))] [(:name t) (or (some #(when (= "FunctionDecl" (:kind %)) %) (:inner t)) t)]))
        ;; (a name inside sizeof, alignof or decltype is no evaluation: such a bound is constant)
        vla? (fn [^String qt runtime]
               (some (fn [[_ b]] (some #(contains? runtime %)
                                       (re-seq #"[A-Za-z_]\w*" (-> b (str/replace #"\b(?:sizeof|alignof|__alignof__|_Alignof|decltype|__typeof__|typeof)\s*\([^()]*\)" "")
                                                                    (str/replace #"\bsizeof\s+\w+" "")))))
                     (re-seq #"\[([^\[\]]+)\]" qt)))]
    (doseq [f (:nodes u) :when (#{"FunctionDecl" "CXXMethodDecl"} (:kind f))]
      (let [runtime (java.util.HashSet.)
            vtypes (java.util.HashSet.)]
        (doseq [pv (:inner f) :when (and (= "ParmVarDecl" (:kind pv)) (string? (:name pv)) (not (re-find #"\bconst\b" (str (get-in pv [:type :qualType])))))]
          (.add runtime (:name pv)))
        (walk-nodes (fn [n _]
                      (case (:kind n)
                        "VarDecl" (when (and (string? (:name n)) (not (:constexpr n)) (not (re-find #"^\s*const\b|\bconst\s*$" (str (get-in n [:type :qualType])))))
                                    (.add runtime (:name n)))
                        ("TypedefDecl" "TypeAliasDecl") (when (vla? (str (get-in n [:type :qualType])) runtime) (.add vtypes (:name n)))
                        "CXXRecordDecl" (doseq [m (:inner n)]
                                          (let [uses? (fn [x] (let [qt (str (get-in x [:type :qualType]))]
                                                                (or (vla? qt runtime) (some #(re-find (re-pattern (str "\\b" (java.util.regex.Pattern/quote %) "\\b")) qt) vtypes))))]
                                            (case (:kind m)
                                              "FieldDecl" (when (uses? m) (report! m "data member may not have variably modified type"))
                                              ("CXXMethodDecl" "CXXConstructorDecl") (doseq [pv (:inner m) :when (and (= "ParmVarDecl" (:kind pv)) (uses? pv))]
                                                                                       (report! pv "parameter may not have variably modified type"))
                                              nil)))
                        "DeclRefExpr" (when-let [as (:explicitTemplateArgs n)]
                                        (when-let [t (get tmpl-fns (get-in n [:referencedDecl :name]))]
                                          (when-let [a (some #(when (vla? (str %) runtime) %) as)]
                                            (report! t (str "'" a "' is a variably modified type")))))
                        nil))
                    (:inner f) nil)))
    (vec (distinct out))))

;; Operands of scalar and GNU vector types (cpp-gnu, 2026-11-22; the GCC 15.2 manual's "Using Vector Instructions through Built-in
;; Functions": vector_size makes a vector of its element type, whose binary operators take two vectors of the same element type and
;; number of elements, ~ an integer vector's; and the standard's rules the same operands break): a subscript whose index operand is
;; of floating or vector type ([expr.sub]/1: one operand a pointer or array, the other of integral or unscoped enumeration type:
;; "invalid types 'int[10][float]' for array subscript"), an array new's bound of such a type ([expr.new]/8: "expression in
;; new-declarator must have integral or enumeration type"), a switch's ([stmt.switch]/2: "switch quantity not an integer"), ~ of a
;; floating type or vector ([expr.unary.op]/10: "wrong type argument to bit-complement"), a binary operator between vectors of
;; different element types ("invalid operands to binary +"; conversion/simd3.C, simd4.C). The operands judged are variables named
;; directly, their types read off their declarations.

(defn operand-types
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        report! (fn [n msg] (when-let [o (get-in n [:range :begin :offset])]
                              (when (= main (or (get-in n [:range :begin :file]) main))
                                (let [[l c] (line-col starts (long o))]
                                  (.add out {:line l :col c :kind :error :rule :operand-type :msg msg})))))
        tds (into {} (for [n (:nodes u) :when (#{"TypedefDecl" "TypeAliasDecl"} (:kind n))] [(:name n) n]))
        kind-of (fn [d]
                  (let [qt (str/trim (str/replace (str (get-in d [:type :qualType])) #"\b(?:const|volatile)\b" ""))
                        td (get tds qt)
                        vec? (or (some #(= "vector_size" (gnu-attr-name %)) (gnu-attrs-of d))
                                 (and td (some #(= "vector_size" (gnu-attr-name %)) (gnu-attrs-of td))))
                        ;; (a vector typedef's spelling carries its attribute, `__attribute__((__vector_size__(16))) float`)
                        base (str/trim (str/replace (if td (str/replace (str (get-in td [:type :qualType])) #"\b(?:const|volatile)\b" "") qt)
                                                    #"^\s*__attribute__\s*\(\(.*\)\)\s*" ""))]
                    (cond
                      (re-find #"\]$" base) (if vec? nil {:k :array})
                      (re-find #"[*&]$" base) (if vec? nil {:k :ptr})
                      (float-type-size base) {:k (if vec? :vector :float) :el base :fl true}
                      (int-type-size base) {:k (if vec? :vector :int) :el base :fl false}
                      :else nil)))
        strip (fn strip [x] (if (#{"ImplicitCastExpr" "ParenExpr"} (:kind x)) (strip (first (:inner x))) x))
        globals (into {} (for [n (:nodes u) :when (and (= "VarDecl" (:kind n)) (string? (:name n)))] [(:name n) n]))]
    (letfn [(w [x vars]
              (cond
                (map? x)
                (let [k (:kind x)
                      vars (if (#{"FunctionDecl" "CXXMethodDecl"} k)
                             (into vars (for [pv (:inner x) :when (and (= "ParmVarDecl" (:kind pv)) (string? (:name pv)))] [(:name pv) pv]))
                             vars)
                      kd (fn [e] (let [e (some-> e strip)]
                                   (when (= "DeclRefExpr" (:kind e))
                                     (when-let [d (or (get vars (get-in e [:referencedDecl :name])) (get globals (get-in e [:referencedDecl :name])))]
                                       (kind-of d)))))
                      bad-index? (fn [t] (or (= :float (:k t)) (= :vector (:k t))))]
                  (case k
                    ;; (GNU's ?: with a vector condition and two scalars, the manual's "Vector Extensions": the scalars' common type
                    ;; is the result's element type, of the condition's elements' size ("inferred scalar type 'C' is not an integer or
                    ;; floating-point type of the same size as 'E'"), an integer variable converted to a floating one of no more bits
                    ;; "involves truncation"; ext/vector23.C)
                    "ConditionalOperator"
                    (let [[cnd b c] (:inner x)
                          cv (let [cn (some-> cnd strip)]
                               (when (= "BinaryOperator" (:kind cn))
                                 (let [o (some-> (first (:inner cn)) strip)
                                       o (if (and (= "UnaryOperator" (:kind o)) (= "*" (:opcode o))) (let [d (some-> (first (:inner o)) strip)]
                                                                                                        (when (= "DeclRefExpr" (:kind d))
                                                                                                          (when-let [v (or (get vars (get-in d [:referencedDecl :name])) (get globals (get-in d [:referencedDecl :name])))]
                                                                                                            (kind-of (update-in v [:type :qualType] #(str/replace (str %) #"\s*\*\s*$" ""))))))
                                             (kd o))]
                                   (when (= :vector (:k o)) o))))
                          sty (fn [e] (let [e (strip e)]
                                        (case (:kind e)
                                          ("IntegerLiteral" "CharacterLiteral" "FloatingLiteral") [(str/trim (str (get-in e [:type :qualType]))) true]
                                          "DeclRefExpr" (when-let [d (or (get vars (get-in e [:referencedDecl :name])) (get globals (get-in e [:referencedDecl :name])))]
                                                          (let [t (str/trim (str/replace (str (get-in d [:type :qualType])) #"\b(?:const|volatile)\b" ""))]
                                                            (when (or (int-type-size t) (float-type-size t)) [t false])))
                                          nil)))]
                      (when cv
                        (let [[tb lb] (sty b) [tc lc] (sty c)]
                          (when (and tb tc)
                            (let [fl? (fn [t] (some? (float-type-size t)))
                                  rank (fn [t] (let [t (str/replace t #"^unsigned |^signed " "")] (case t ("char" "bool" "short" "short int" "char8_t" "char16_t" "wchar_t") 1 ("int" "char32_t") 2 ("long" "long int") 3 ("long long" "long long int") 4 ("__int128") 5 2)))
                                  prom (fn [t] (if (and (not (fl? t)) (< (long (rank t)) 2)) "int" t))
                                  ct (let [b2 (prom tb) c2 (prom tc)]
                                       (cond (and (fl? b2) (fl? c2)) (if (>= (long (float-type-size b2)) (long (float-type-size c2))) b2 c2)
                                             (fl? b2) b2 (fl? c2) c2
                                             (> (long (rank b2)) (long (rank c2))) b2 (< (long (rank b2)) (long (rank c2))) c2
                                             (str/starts-with? b2 "unsigned") b2 :else c2))
                                  csz (or (int-type-size ct) (float-type-size ct))
                                  esz (or (int-type-size (:el cv)) (float-type-size (:el cv)))]
                              (cond
                                (and csz esz (not= (long csz) (long esz)))
                                (report! x (str "inferred scalar type '" ct "' is not an integer or floating-point type of the same size as '" (:el cv) "'"))
                                (and (fl? ct) (some (fn [[t l]] (and (not l) (not (fl? t)) (>= (long (int-type-size t)) (long (float-type-size ct))))) [[tb lb] [tc lc]]))
                                (report! x (str "conversion of scalar to vector of '" ct "' involves truncation"))
                                :else nil))))))
                    "ArraySubscriptExpr" (let [[a b] (:inner x) ka (kd a) kb (kd b)]
                                           (when (and ka kb
                                                      (if (#{:array :ptr} (:k ka)) (bad-index? kb)
                                                          (if (#{:array :ptr} (:k kb)) (bad-index? ka) (not (and (= :vector (:k ka)) (= :int (:k kb)))))))
                                             (report! x "invalid types for array subscript")))
                    "CXXNewExpr" (when-let [sz (and (:isArray x) (some #(when (= "DeclRefExpr" (:kind (some-> % strip))) %) (:inner x)))]
                                   (when (bad-index? (kd sz)) (report! sz "expression in new-declarator must have integral or enumeration type")))
                    "SwitchStmt" (when (bad-index? (kd (first (:inner x)))) (report! (first (:inner x)) "switch quantity not an integer"))
                    "UnaryOperator" (when (= "~" (:opcode x))
                                      (let [t (kd (first (:inner x)))] (when (and t (:fl t) (#{:float :vector} (:k t))) (report! x "wrong type argument to bit-complement"))))
                    ("BinaryOperator" "CompoundAssignOperator")
                    (let [[a b] (:inner x) ka (kd a) kb (kd b)]
                      (when (and (= :vector (:k ka)) (= :vector (:k kb)) (not= (:el ka) (:el kb))
                                 (#{"+" "-" "*" "/" "%" "&" "|" "^" "+=" "-=" "*=" "/=" "%=" "&=" "|=" "^="} (:opcode x)))
                        (report! x (str "invalid operands to binary " (str/replace (str (:opcode x)) #"=$" "")))))
                    nil)
                  (doseq [[kk v] x :when (and (not= kk :_ent) (or (map? v) (vector? v)))] (w v vars)))
                (vector? x) (loop [ys x vars vars]
                              (when-let [y (first ys)]
                                (w y vars)
                                (recur (rest ys) (if (and (map? y) (= "DeclStmt" (:kind y)))
                                                   (into vars (for [d (:inner y) :when (and (= "VarDecl" (:kind d)) (string? (:name d)))] [(:name d) d]))
                                                   vars))))
                :else nil))]
      (w (:nodes u) {}))
    (vec (distinct out))))

;; GNU's numeric literal suffixes (cpp-gnu, 2026-11-22; the GCC 15.2 manual's "Options Controlling C++ Dialect", -fext-numeric-literals,
;; the default of the gnu++ dialects: the suffixes of GCC's extended literals -- imaginary i and j, the fixed-point types of ISO/IEC TR
;; 18037, w and q -- are its own, not user-defined literals' ud-suffixes): a literal with a fixed-point suffix (k or r, after u, h, l or ll)
;; is GCC's "fixed-point types not supported in C++", at the literal (cpp0x/gnu_fext-numeric-literals.C, std_fext-numeric-literals.C).

(defn fixed-point-literals
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        ext (let [ds (filter #{"-fext-numeric-literals" "-fno-ext-numeric-literals"} (concat (:args u) *driver-args*))]
              (if (seq ds) (= "-fext-numeric-literals" (last ds)) (str/starts-with? (str (:std u)) "gnu")))]
    (when ext
      (walk-nodes (fn [n _]
                    (when (= "UserDefinedLiteral" (:kind n))
                      (let [b (get-in n [:range :begin :offset]) len (get-in n [:range :begin :tokLen])]
                        (when (and b len (= main (or (get-in n [:range :begin :file]) main)) (<= (+ (long b) (long len)) (.length src)))
                          (let [t (subs src (long b) (+ (long b) (long len)))]
                            (when (re-matches #"(?:\d[\d']*\.?[\d']*|\.\d[\d']*)(?:[eE][-+]?\d+)?(?i:u?(?:h|l|ll)?[kr])" t)
                              (let [[l c] (line-col starts (long b))]
                                (.add out {:line l :col c :kind :error :rule :literal :msg "fixed-point types not supported in C++"}))))))))
                  (:nodes u) nil))
    (vec out)))

;; GNU's gnu_inline (cpp-gnu, 2026-11-22; the GCC 15.2 manual's "Common Function Attributes": gnu_inline with inline gives GNU C89's
;; inline semantics, the definition used for inlining alone, "in C++ ... it still requires the inline keyword"): the inline declarations
;; of a function agree on it -- an inline declaration after a gnu_inline one or the reverse, "'f' redeclared inline with[out]
;; 'gnu_inline' attribute", at the later (ext/gnu-inline-global-reject.C; the redefinitions are redefinitions' own). And GCC's
;; dynamic_cast runtime (the Itanium C++ ABI's 2.9.7: a dynamic_cast to a pointer or reference of another class is a call of
;; __cxxabiv1's extern "C" void *__dynamic_cast(const void *, const __class_type_info *, const __class_type_info *, ptrdiff_t), which
;; g++ declares implicitly): a declaration by the program of that name of another type conflicts, an error with no line (its
;; implicit declaration's place, :line 0), rtti/dyncast8.C.

(defn gnu-inline-and-abi
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        gi? (fn [n] (some #(= "gnu_inline" (gnu-attr-name %)) (gnu-attrs-of n)))
        first-inline (java.util.HashMap.)]
    (doseq [f (mapcat #(if (= "LinkageSpecDecl" (:kind %)) (:inner %) [%]) (:nodes u))
            :when (and (= "FunctionDecl" (:kind f)) (:inline f) (string? (:name f)))]
      (if-let [g0 (.get first-inline (:name f))]
        (when (not= (= g0 :gnu) (boolean (gi? f)))
          (when-let [o (or (get-in f [:loc :offset]) (get-in f [:loc :expansionLoc :offset]) (get-in f [:range :begin :offset]))]
            (when (= main (or (get-in f [:loc :file]) (get-in f [:loc :expansionLoc :file]) (get-in f [:range :begin :file]) main))
              (let [[l c] (line-col starts (long o))]
                (.add out {:line l :col c :kind :error :rule :gnu-inline
                           :msg (str "'" (:name f) "' redeclared inline " (if (gi? f) "with" "without") " 'gnu_inline' attribute")})))))
        (.put first-inline (:name f) (if (gi? f) :gnu :plain))))
    ;; __dynamic_cast
    (let [decls (for [ns (:nodes u) :when (and (= "NamespaceDecl" (:kind ns)) (= "__cxxabiv1" (:name ns)))
                      d (mapcat #(if (= "LinkageSpecDecl" (:kind %)) (:inner %) [%]) (:inner ns))
                      :when (and (#{"FunctionDecl" "VarDecl"} (:kind d)) (= "__dynamic_cast" (:name d)))]
                  d)
          used (let [r (atom false)]
                 (walk-nodes (fn [n _] (when (and (= "CXXDynamicCastExpr" (:kind n)) (not (re-find #"^(?:const )?void \*" (str (get-in n [:type :qualType])))))
                                         (reset! r true)))
                             (:nodes u) nil)
                 @r)]
      (when (and used (some #(or (= "VarDecl" (:kind %))
                                 (not= "void *(const void *, const __class_type_info *, const __class_type_info *, long)"
                                       (str/replace (str (get-in % [:type :qualType])) #"\s*(?:throw\(\)|noexcept)\s*$" "")))
                            decls))
        (.add out {:line 0 :col 0 :kind :error :rule :eh-abi :msg "conflicting declaration of C function '__dynamic_cast'"})))
    (vec out)))

;; GNU's __builtin_va_arg_pack (cpp-gnu, 2026-11-22; the GCC 15.2 manual's "Constructing Function Calls": it "represents all
;; anonymous arguments of an inline function ... It must be only passed as last argument to some other function with variable
;; arguments"): a use that is not the last argument of a call, or not in the callee's variable arguments (a parameter's place, a
;; function without ...), or no argument at all, is "invalid use of '__builtin_va_arg_pack ()'", at the use (ext/va-arg-pack-2.C).

(defn va-arg-pack
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        fns (into {} (for [n (mapcat #(if (= "LinkageSpecDecl" (:kind %)) (:inner %) [%]) (:nodes u)) :when (and (= "FunctionDecl" (:kind n)) (string? (:name n)))]
                       [(:name n) n]))
        strip (fn strip [x] (if (#{"ImplicitCastExpr" "ParenExpr"} (:kind x)) (strip (first (:inner x))) x))
        pack? (fn [x] (let [x (some-> x strip)]
                        (and (= "CallExpr" (:kind x)) (= "__builtin_va_arg_pack" (get-in (some-> (first (:inner x)) strip) [:referencedDecl :name])))))
        ok (java.util.IdentityHashMap.)]
    ;; the uses as a call's last argument in the callee's variable arguments
    (walk-nodes (fn [n _]
                  (when (= "CallExpr" (:kind n))
                    (let [args (vec (rest (:inner n)))
                          callee (get fns (get-in (some-> (first (:inner n)) strip) [:referencedDecl :name]))
                          np (count (filter #(= "ParmVarDecl" (:kind %)) (:inner callee)))
                          va (re-find #"\.\.\.\)" (str (get-in callee [:type :qualType])))]
                      (doseq [[i a] (map-indexed vector args) :when (pack? a)]
                        (when (and callee va (= i (dec (count args))) (>= (long i) (long np)))
                          (.put ok (strip a) true))))))
                (:nodes u) nil)
    (walk-nodes (fn [n _]
                  (when (and (pack? n) (= n (strip n)) (not (.containsKey ok n)))
                    (when-let [o (get-in n [:range :begin :offset])]
                      (when (= main (or (get-in n [:range :begin :file]) main))
                        (let [[l c] (line-col starts (long o))]
                          (.add out {:line l :col c :kind :error :rule :va-arg-pack :msg "invalid use of '__builtin_va_arg_pack ()'"}))))))
                (:nodes u) nil)
    (vec out)))

;; A modifiable lvalue (cpp-gnu, 2026-11-22; [expr.pre.incr]/1, [expr.post.incr]/1, [expr.assign]/1: the operand of ++ and -- and the
;; left operand of an assignment is a modifiable lvalue, [basic.lval]/6): a local variable or parameter of const-qualified non-reference
;; type named directly is not: GCC's "increment of read-only variable 'n'" ("decrement", "assignment"), at the operator, in a template's
;; definition too (template/permissive-error1b.C, -1c.C, with -Wtemplate-body's handling in diagnose).

(defn read-only-modify
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        const? (fn [d] (let [qt (str/trim (str (get-in d [:type :qualType])))]
                         (and (not (re-find #"&$" qt))
                              (if (re-find #"\*" qt) (re-find #"\*\s*const\s*$" qt) (re-find #"^const\b|\bconst$" qt)))))
        strip (fn strip [x] (if (#{"ImplicitCastExpr" "ParenExpr"} (:kind x)) (strip (first (:inner x))) x))
        report! (fn [n msg] (when-let [o (get-in n [:range :begin :offset])]
                              (when (= main (or (get-in n [:range :begin :file]) main))
                                (let [[l c] (line-col starts (long o))]
                                  (.add out {:line l :col c :kind :error :rule :read-only :msg msg})))))]
    (letfn [(w [x vars]
              (cond
                (map? x)
                (let [k (:kind x)
                      vars (cond (#{"FunctionDecl" "CXXMethodDecl" "CXXConstructorDecl" "CXXDestructorDecl" "LambdaExpr"} k)
                                 (into vars (for [pv (:inner x) :when (and (= "ParmVarDecl" (:kind pv)) (string? (:name pv)))] [(:name pv) pv]))
                                 ;; (a for, if, while or switch statement's own variables, its init-statement's or condition's)
                                 (#{"ForStmt" "IfStmt" "WhileStmt" "SwitchStmt" "CXXForRangeStmt" "CXXCatchStmt"} k)
                                 (into vars (for [c (:inner x)
                                                  d (cond (= "DeclStmt" (:kind c)) (:inner c) (= "VarDecl" (:kind c)) [c] :else nil)
                                                  :when (and (= "VarDecl" (:kind d)) (string? (:name d)))]
                                              [(:name d) d]))
                                 :else vars)
                      target (fn [e] (let [e (some-> e strip)]
                                       (when (= "DeclRefExpr" (:kind e))
                                         (let [nm (get-in e [:referencedDecl :name]) d (get vars nm)]
                                           (when (and d (const? d)) nm)))))]
                  (case k
                    "UnaryOperator" (when (#{"++" "--"} (:opcode x))
                                      (when-let [nm (target (first (:inner x)))]
                                        (report! x (str (if (= "++" (:opcode x)) "increment" "decrement") " of read-only variable '" nm "'"))))
                    ("BinaryOperator" "CompoundAssignOperator")
                    (when (re-matches #"=|[-+*/%&|^]=|<<=|>>=" (str (:opcode x)))
                      (when-let [nm (target (first (:inner x)))]
                        (report! x (str "assignment of read-only variable '" nm "'"))))
                    nil)
                  ;; (a lambda's body sees no enclosing local but by capture: its own scope)
                  (doseq [[kk v] x :when (and (not= kk :_ent) (or (map? v) (vector? v)))]
                    (w v (if (= "LambdaExpr" k) (into {} (filter (fn [[_ d]] (= "ParmVarDecl" (:kind d))) vars)) vars))))
                (vector? x) (loop [ys x vars vars]
                              (when-let [y (first ys)]
                                (w y vars)
                                (recur (rest ys) (if (and (map? y) (= "DeclStmt" (:kind y)))
                                                   (into vars (for [d (:inner y) :when (and (= "VarDecl" (:kind d)) (string? (:name d)))] [(:name d) d]))
                                                   vars))))
                :else nil))]
      (w (:nodes u) {}))
    (vec out)))

;; GCC's constant evaluation options (cpp-gnu, 2026-11-22; the GCC 15.2 manual's "Options Controlling C++ Dialect"):
;; - -fconstexpr-loop-limit=n, "the maximum number of iterations for a loop in C++14 constexpr functions" (default 262144): a loop of a
;;   constexpr function a constexpr variable's initializer calls that never ends -- its condition the constant true, or none, and no
;;   break, return or goto in its body -- exceeds any limit, "constexpr loop iteration count exceeds limit of N", at the loop
;;   (cpp1y/constexpr-loop6.C);
;; - -fimplicit-constexpr, "make inline functions implicitly constexpr": an inline function a constexpr variable's initializer calls is
;;   evaluated, and a call in it of a function neither constexpr nor inline is "call to non-'constexpr' function", at that call
;;   (ext/fimplicit-constexpr1.C);
;; - -fno-immediate-escalation, which turns off P2564R3's escalation of a constexpr function calling a consteval one: such a call with
;;   an argument that names one of the caller's parameters is no constant expression, "'id(i)' is not a constant expression", at the
;;   call, in a function template when the unit names it outside its definition (cpp2a/consteval-prop17.C).

(defn constexpr-options
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        dargs (concat (:args u) *driver-args*)
        report! (fn [n msg] (when-let [o (get-in n [:range :begin :offset])]
                              (when (= main (or (get-in n [:range :begin :file]) main))
                                (let [[l c] (line-col starts (long o))]
                                  (.add out {:line l :col c :kind :error :rule :constexpr-option :msg msg})))))
        strip (fn strip [x] (if (#{"ImplicitCastExpr" "ParenExpr" "ExprWithCleanups"} (:kind x)) (strip (first (:inner x))) x))
        tops (mapcat #(if (= "LinkageSpecDecl" (:kind %)) (:inner %) [%]) (:nodes u))
        fns (into {} (for [n tops
                           :let [f (if (= "FunctionTemplateDecl" (:kind n)) (some #(when (= "FunctionDecl" (:kind %)) %) (:inner n)) n)]
                           :when (and (= "FunctionDecl" (:kind f)) (string? (:name f)))]
                       [(:name f) f]))
        called (fn [v] (some (fn [x] (let [x (strip x)] (when (= "CallExpr" (:kind x)) (get fns (get-in (some-> (first (:inner x)) strip) [:referencedDecl :name]))))) (:inner v)))
        cvars (for [v (:nodes u) :when (and (= "VarDecl" (:kind v)) (:constexpr v))] v)
        limit (or (some #(second (re-matches #"-fconstexpr-loop-limit=(\d+)" %)) dargs) "262144")]
    ;; loops that never end
    (doseq [v cvars :let [f (called v)] :when (and f (:constexpr f))]
      (walk-nodes (fn [n _]
                    (when (#{"WhileStmt" "DoStmt" "ForStmt"} (:kind n))
                      (let [c (case (:kind n) "WhileStmt" (first (:inner n)) "DoStmt" (second (:inner n)) nil)
                            forever (case (:kind n)
                                      "ForStmt" (not-any? #(and (map? %) (not (#{"CompoundStmt" "NullStmt" "DeclStmt"} (:kind %)))) (butlast (:inner n)))
                                      (let [c (some-> c strip)] (or (and (= "CXXBoolLiteralExpr" (:kind c)) (true? (:value c)))
                                                                    (and (= "IntegerLiteral" (:kind c)) (not= "0" (str (:value c)))))))
                            exits (let [r (atom false)] (walk-nodes (fn [x _] (when (#{"BreakStmt" "ReturnStmt" "GotoStmt" "CXXThrowExpr"} (:kind x)) (reset! r true))) (:inner n) nil) @r)]
                        (when (and forever (not exits))
                          (report! n (str "constexpr loop iteration count exceeds limit of " limit " (use '-fconstexpr-loop-limit=' to increase the limit)"))))))
                  (:inner f) nil))
    ;; -fimplicit-constexpr
    (when (some #{"-fimplicit-constexpr"} dargs)
      (doseq [v cvars :let [g (called v)] :when (and g (:inline g) (not (:constexpr g)))]
        (walk-nodes (fn [n _]
                      (when (= "CallExpr" (:kind n))
                        (when-let [h (get fns (get-in (some-> (first (:inner n)) strip) [:referencedDecl :name]))]
                          (when (and (not (:constexpr h)) (not (:inline h)) (not (:_consteval h)))
                            (report! n (str "call to non-'constexpr' function '" (:name h) "'"))))))
                    (:inner g) nil)))
    ;; -fno-immediate-escalation
    (when (some #{"-fno-immediate-escalation"} dargs)
      (let [refs (let [acc (java.util.ArrayList.)]
                   (walk-nodes (fn [x _] (when (= "DeclRefExpr" (:kind x)) (when-let [o (get-in x [:range :begin :offset])] (.add acc [(get-in x [:referencedDecl :name]) (long o)])))) (:nodes u) nil)
                   acc)]
        (doseq [n tops
                :let [tmpl? (= "FunctionTemplateDecl" (:kind n))
                      f (if tmpl? (some #(when (= "FunctionDecl" (:kind %)) %) (:inner n)) n)
                      b (long (or (get-in n [:range :begin :offset]) -1)) e (long (or (get-in n [:range :end :offset]) -1))
                      ;; (an abbreviated function template, auto among its parameters' types, is a template too)
                      tmpl? (or tmpl? (some #(and (= "ParmVarDecl" (:kind %)) (re-find #"\bauto\b" (str (get-in % [:type :qualType])))) (:inner f)))]
                :when (and (= "FunctionDecl" (:kind f)) (not (:_consteval f))
                           (or (not tmpl?) (some (fn [[nm o]] (and (= nm (:name f)) (or (< (long o) b) (> (long o) e)))) refs)))
                :let [params (set (keep #(when (and (= "ParmVarDecl" (:kind %)) (not (:_badtypes %))) (:name %)) (:inner f)))]]
          (walk-nodes (fn [c _]
                        (when (= "CallExpr" (:kind c))
                          (when-let [h (get fns (get-in (some-> (first (:inner c)) strip) [:referencedDecl :name]))]
                            (when (and (:_consteval h)
                                       (some #(let [a (strip %)] (and (= "DeclRefExpr" (:kind a)) (contains? params (get-in a [:referencedDecl :name])))) (rest (:inner c))))
                              (report! c (str "'" (:name h) "(...)' is not a constant expression"))))))
                      (:inner f) nil))))
    (vec (distinct out))))

;; An atomic constraint's satisfaction changing (cpp-gnu, 2026-11-22; [temp.constr.atomic]/3: "If, at different points in the program,
;; the satisfaction result is different for identical atomic constraints and template arguments, the program is ill-formed, no
;; diagnostic required" -- GCC diagnoses it, keeping each satisfaction result it computed): a concept whose atomic constraint needs the
;; class it is checked for complete (a nested type, sizeof, a member function's deduced return type) evaluated for a class X at a
;; namespace-scope static_assert before X is complete -- declared and not yet defined, or a member function of deduced return type not
;; yet defined -- and again after: "satisfaction value of atomic constraint ... changed from 'false' to 'true'", at the atomic
;; constraint (the concept's own, or that of the concept its definition names), and the later static_assert, evaluated with the result
;; kept, fails ("static assertion failed"), once. The evaluations: a concept-id C<X>, or a call f<X>() of a function template one of
;; whose overloads constrains its parameter by C (cpp2a/concepts-complete1.C to -complete4.C).

(defn satisfaction-changes
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        off (fn [n] (get-in n [:range :begin :offset]))
        report! (fn [o msg] (when o (let [[l c] (line-col starts (long o))] (.add out {:line l :col c :kind :error :rule :satisfaction :msg msg}))))
        concepts (into {} (for [n (:nodes u) :when (and (= "ConceptDecl" (:kind n)) (string? (:name n)))] [(:name n) n]))
        constrained (let [m (java.util.HashMap.)]
                      (doseq [t (:nodes u) :when (= "FunctionTemplateDecl" (:kind t))
                              p (:inner t) :when (= "TemplateTypeParmDecl" (:kind p))
                              c (:_tc p) :when (contains? concepts c)]
                        (.put m (:name t) (conj (or (.get m (:name t)) #{}) c)))
                      m)
        ;; the atomic constraint's place: a concept-id definition's concept's
        atom-of (fn atom-of [c seen]
                  (let [ce (:constraintExpr c)]
                    (if (and (#{"ConceptSpecializationExpr" "DeclRefExpr"} (:kind ce))
                             (contains? concepts (get-in ce [:referencedDecl :name])) (not (contains? seen (:name c))))
                      (atom-of (get concepts (get-in ce [:referencedDecl :name])) (conj seen (:name c)))
                      c)))
        needs-complete? (fn [c] (let [t (pr-str (:constraintExpr (atom-of c #{})))]
                                  (boolean (or (re-find #"TypeRequirement" t) (re-find #"\"sizeof\"" t) (re-find #"MemberExpr" t)
                                               (re-find #":qualifier \[" t) (re-find #"::" t)))))
        ;; each class's completion: its definition's offset, or a later out-of-class definition of a member function of deduced type
        complete-at (into {} (for [r (:nodes u) :when (and (= "CXXRecordDecl" (:kind r)) (:completeDefinition r) (:name r))
                                   :let [ro (off r)
                                         fwd (some #(and (= "CXXRecordDecl" (:kind %)) (= (:name r) (:name %)) (not (:completeDefinition %)) (< (long (off %)) (long ro))) (:nodes u))
                                         deduced (set (keep #(when (and (= "CXXMethodDecl" (:kind %)) (re-find #"^auto\b" (str (get-in % [:type :qualType])))) (:name %)) (:inner r)))
                                         late (when (seq deduced)
                                                (some #(when (and (= "CXXMethodDecl" (:kind %)) (contains? deduced (:name %)) (> (long (or (off %) 0)) (long ro))) (off %)) (:nodes u)))]
                                   :when (or fwd late)]
                               [(:name r) [(if late ro (some #(when (and (= "CXXRecordDecl" (:kind %)) (= (:name r) (:name %)) (not (:completeDefinition %))) (off %)) (:nodes u))) (or late ro)]]))
        evals (fn [sa] (let [acc (java.util.ArrayList.)]
                         (walk-nodes (fn [d _] (when (and (= "DeclRefExpr" (:kind d)) (= 1 (count (:explicitTemplateArgs d))))
                                                 (let [nm (get-in d [:referencedDecl :name]) x (str/trim (first (:explicitTemplateArgs d)))]
                                                   (cond (contains? concepts nm) (.add acc [nm x])
                                                         (.get constrained nm) (doseq [c (.get constrained nm)] (.add acc [c x]))
                                                         :else nil))))
                                     (:inner sa) nil)
                         acc))
        before (java.util.HashSet.) reported (java.util.HashSet.)]
    (doseq [sa (sort-by #(long (or (off %) 0)) (filter #(= "StaticAssertDecl" (:kind %)) (:nodes u)))
            :let [o (off sa)]
            :when o
            [c x] (distinct (evals sa))
            :let [[decl-at done-at] (get complete-at x)]
            :when (and decl-at (needs-complete? (get concepts c)))]
      (cond
        (and (> (long o) (long decl-at)) (< (long o) (long done-at))) (.add before [c x])
        (and (> (long o) (long done-at)) (.contains before [c x]) (.add reported [c x]))
        (do (report! (let [a (atom-of (get concepts c) #{})] (or (off (:constraintExpr a)) (off a))) "satisfaction value of atomic constraint changed from 'false' to 'true'")
            (report! o "static assertion failed"))
        :else nil))
    (vec (distinct out))))

;; GCC's -fno-new-inheriting-ctors (cpp-gnu, 2026-11-22; the GCC 15.2 manual's "Options Controlling C++ Dialect": the inheriting
;; constructors of C++11 before P0136R1, as declarations of the derived class's own): a using-declaration of a base's constructors
;; declares in the class a constructor of each of their parameter lists, so two such of the same parameter list from two bases, which
;; the class does not declare itself, are one constructor declared twice ("'D1::D1(int)' inherited from 'B2'", at the second using);
;; and an inherited constructor's ellipsis is not inherited, so a construction with more arguments than its parameters finds no match
;; ("no matching function for call", at the declaration), cpp0x/inh-ctor3.C, inh-ctor11.C.

(defn old-inheriting-ctors
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)]
    (when (some #{"-fno-new-inheriting-ctors"} (concat (:args u) *driver-args*))
      (let [records (into {} (for [r (:nodes u) :when (and (= "CXXRecordDecl" (:kind r)) (:name r) (:completeDefinition r))] [(:name r) r]))
            report! (fn [n msg] (when-let [o (get-in n [:range :begin :offset])]
                                  (when (= main (or (get-in n [:range :begin :file]) main))
                                    (let [[l c] (line-col starts (long o))] (.add out {:line l :col c :kind :error :rule :inheriting-ctor :msg msg})))))
            ctors (fn [r] (filter #(and (= "CXXConstructorDecl" (:kind %)) (not (:isImplicit %))) (:inner r)))
            params (fn [c] (str/replace (str (get-in c [:type :qualType])) #"^void\s*" ""))
            inherited (fn [r] (for [ud (:inner r) :when (= "UsingDecl" (:kind ud))
                                    :let [[_ b n] (re-matches #"using\s+(\w+)\s*::\s*(\w+)" (str (:_text ud)))]
                                    :when (and b (= b n) (get records b))]
                                [ud (get records b)]))]
        (doseq [r (vals records)]
          (let [own (set (map params (ctors r)))
                seen (java.util.HashMap.)]
            (doseq [[ud b] (inherited r)
                    c (ctors b) :let [ps (params c)]
                    :when (not (contains? own ps))]
              (if (and (.containsKey seen ps) (not= (.get seen ps) (:name b)))
                (report! ud (str "'" (:name r) "::" (:name r) ps "' inherited from '" (:name b) "'"))
                (.put seen ps (:name b))))))
        ;; ellipses not inherited
        (walk-nodes (fn [v _]
                      (when (and (= "VarDecl" (:kind v)) (= "call" (:init v)))
                        (when-let [r (get records (str/trim (str/replace (str (get-in v [:type :qualType])) #"\b(?:const|struct|class)\b" "")))]
                          (let [args (let [x (first (:inner v))] (if (= "ParenListExpr" (:kind x)) (:inner x) [x]))
                                n (count args)
                                cands (concat (map (fn [c] [c false]) (ctors r)) (for [[_ b] (inherited r) c (ctors b)] [c true]))]
                            (when (and (seq cands) (some second cands)
                                       (not-any? (fn [[c inh]] (let [np (count (filter #(= "ParmVarDecl" (:kind %)) (:inner c)))
                                                                     va (re-find #"\.\.\.\)" (str (get-in c [:type :qualType])))]
                                                                 (if (and va (not inh)) (>= n np) (= n np))))
                                                 cands))
                              (report! v (str "no matching function for call to '" (:name r) "::" (:name r) "(...)'")))))))
                    (:nodes u) nil)))
    (vec out)))

;; GCC's __builtin_operator_new and __builtin_operator_delete (cpp-gnu, 2026-11-22; the GCC 15.2 manual's "Other Built-in Functions",
;; after P2652's and clang's: a call as `::operator new (args)` whose selected function must be a replaceable global allocation
;; (deallocation) function, [new.delete.single], [new.delete.array]'s signatures): when the viable functions are a placement form
;; (`operator new (size_t, void *)`, <new>'s) or one the program declares with another signature, and no replaceable one, "call to
;; '__builtin_operator_new' does not select replaceable global allocation function", at the call; no viable one is overload
;; resolution's own error (ext/builtin-operator-new-2.C). An argument's kind read off a literal, a variable's or parameter's type, a
;; template parameter's type taken to fit an arithmetic or pointer parameter.

(defn builtin-operator-new
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        strip (fn strip [x] (if (#{"ImplicitCastExpr" "ParenExpr"} (:kind x)) (strip (first (:inner x))) x))
        pkind (fn [^String qt] (let [t (str/trim (str/replace qt #"\b(?:const|volatile)\b" ""))]
                                 (cond (re-find #"align_val_t" t) :align (re-find #"nothrow_t" t) :nothrow (re-find #"\*$" t) :ptr
                                       (or (int-type-size t) (float-type-size t) (#{"size_t" "std::size_t"} t)) :arith :else :other)))
        repl {"operator new" #{[:arith] [:arith :align] [:arith :nothrow] [:arith :align :nothrow]}
              "operator delete" #{[:ptr] [:ptr :arith] [:ptr :align] [:ptr :arith :align] [:ptr :nothrow] [:ptr :align :nothrow]}}
        placement {"operator new" [[:arith :ptr]] "operator delete" [[:ptr :ptr]]}
        user (for [f (:nodes u) :when (and (= "FunctionDecl" (:kind f)) (#{"operator new" "operator delete"} (:name f)))]
               [(:name f) (mapv #(pkind (str (get-in % [:type :qualType]))) (filter #(= "ParmVarDecl" (:kind %)) (:inner f)))])
        fits? (fn [ak pk] (case ak (:int :float) (= pk :arith) :ptr (= pk :ptr) :dep (#{:arith :ptr} pk) :align (= pk :align) :nothrow (= pk :nothrow) false))
        viable? (fn [aks pks] (and (= (count aks) (count pks)) (every? boolean (map fits? aks pks))))]
    (letfn [(w [x vars tps]
              (cond
                (map? x)
                (let [k (:kind x)
                      tps (if (= "FunctionTemplateDecl" k) (into tps (keep #(when (= "TemplateTypeParmDecl" (:kind %)) (:name %)) (:inner x))) tps)
                      vars (if (#{"FunctionDecl" "CXXMethodDecl"} k)
                             (into vars (for [pv (:inner x) :when (and (= "ParmVarDecl" (:kind pv)) (string? (:name pv)))] [(:name pv) (str (get-in pv [:type :qualType]))]))
                             vars)
                      akind (fn [a] (let [a (strip a)]
                                      (case (:kind a)
                                        "IntegerLiteral" :int "FloatingLiteral" :float
                                        "DeclRefExpr" (let [nm (get-in a [:referencedDecl :name])]
                                                        (if-let [t (get vars nm)]
                                                          (if (contains? tps (str/trim (str/replace t #"[&\s]+$" ""))) :dep
                                                              (case (pkind t) :ptr :ptr :arith (if (float-type-size (str/trim t)) :float :int) :align :align :nothrow :nothrow nil))
                                                          (when (= "nothrow" nm) :nothrow)))
                                        nil)))]
                  (when (= "CallExpr" k)
                    (let [cn (get-in (some-> (first (:inner x)) strip) [:referencedDecl :name])
                          op (case cn "__builtin_operator_new" "operator new" "__builtin_operator_delete" "operator delete" nil)]
                      (when op
                        (let [aks (mapv akind (rest (:inner x)))]
                          (when (every? some? aks)
                            (let [rv (some #(viable? aks %) (get repl op))
                                  nv (or (some #(viable? aks %) (get placement op))
                                         (some (fn [[n pks]] (and (= n op) (not (contains? (get repl op) pks)) (viable? aks pks))) user))]
                              (when (and nv (not rv))
                                (when-let [o (get-in x [:range :begin :offset])]
                                  (when (= main (or (get-in x [:range :begin :file]) main))
                                    (let [[l c] (line-col starts (long o))]
                                      (.add out {:line l :col c :kind :error :rule :operator-new
                                                 :msg (str "call to '" cn "' does not select replaceable global " (if (= op "operator new") "allocation" "deallocation") " function")})))))))))))
                  (doseq [[kk v] x :when (and (not= kk :_ent) (or (map? v) (vector? v)))] (w v vars tps)))
                (vector? x) (loop [ys x vars vars]
                              (when-let [y (first ys)]
                                (w y vars tps)
                                (recur (rest ys) (if (and (map? y) (= "DeclStmt" (:kind y)))
                                                   (into vars (for [d (:inner y) :when (and (= "VarDecl" (:kind d)) (string? (:name d)))] [(:name d) (str (get-in d [:type :qualType]))]))
                                                   vars))))
                :else nil))]
      (w (:nodes u) {} #{}))
    (vec out)))

;; GCC's __is_invocable and __is_nothrow_invocable (cpp-gnu, 2026-11-22; the GCC 15.2 manual's "Type Traits", as std::is_invocable's
;; precondition, [meta.rel]: each type is a complete type, cv void or an array of unknown bound): an operand that is a class declared and
;; not yet defined at the trait (cv-qualified or not; a reference, pointer, function or member pointer type naming it is complete) is
;; GCC's "invalid use of incomplete type", at the trait (ext/is_invocable3.C).

(defn invocable-traits
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        ;; (a macro's expansion in the main file at its place there, the SA macro's)
        off (fn [n] (or (get-in n [:range :begin :offset]) (get-in n [:range :begin :expansionLoc :offset])))
        decls (group-by :name (filter #(and (= "CXXRecordDecl" (:kind %)) (:name %)) (:nodes u)))
        incomplete-at? (fn [nm o] (let [ds (get decls nm)]
                                    (and (some #(and (not (:completeDefinition %)) (< (long (or (off %) 0)) (long o))) ds)
                                         (not-any? #(and (:completeDefinition %) (< (long (or (off %) 0)) (long o))) ds))))
        split (fn [^String t] (loop [cs (seq t) d 0 cur (StringBuilder.) acc []]
                                (if-let [c (first cs)]
                                  (cond (and (= c \,) (zero? d)) (recur (rest cs) d (StringBuilder.) (conj acc (str cur)))
                                        (#{\( \< \[} c) (recur (rest cs) (inc d) (.append cur c) acc)
                                        (#{\) \> \]} c) (recur (rest cs) (dec d) (.append cur c) acc)
                                        :else (recur (rest cs) d (.append cur c) acc))
                                  (conj acc (str cur)))))]
    (walk-nodes (fn [n _]
                  (when (= "TypeTraitExpr" (:kind n))
                    (when-let [[_ body] (re-matches #"(?s)\s*__is_(?:nothrow_)?invocable\s*\((.*)\)\s*" (str (:_text n)))]
                      (let [o (off n)]
                        (when (and o (= main (or (get-in n [:range :begin :file]) (get-in n [:range :begin :expansionLoc :file]) main))
                                   (some (fn [a] (let [t (-> a (str/replace #"\b(?:const|volatile)\b" "") str/trim)]
                                                   (and (re-matches #"[A-Za-z_]\w*" t) (incomplete-at? t o))))
                                         (split body)))
                          (let [[l c] (line-col starts (long o))]
                            (.add out {:line l :col c :kind :error :rule :builtin-trait :msg "invalid use of incomplete type"})))))))
                (:nodes u) nil)
    (vec out)))

;; GNU's error attribute through always_inline (cpp-gnu, 2026-11-22; the GCC 15.2 manual's "Common Function Attributes": error
;; (message) "If ... a call to such a function is not eliminated through dead code elimination or other optimizations, an error ...
;; is diagnosed"; always_inline and gnu_inline's extern inline functions are inlined at each call, __builtin_va_arg_pack_len the number of
;; the call's anonymous arguments, __builtin_constant_p of an argument the call gives as a literal 1): at each call of such an inline
;; function with literal arguments, its body is followed with its parameters bound -- an if's condition decided or both branches
;; kept, a return ending the path -- and a call of an error function on a path is "call to 'f' declared with attribute error", at
;; that call (ext/va-arg-pack-len-2.C).

(defn error-attr-calls
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        fns (into {} (for [n (mapcat #(if (= "LinkageSpecDecl" (:kind %)) (:inner %) [%]) (:nodes u)) :when (and (= "FunctionDecl" (:kind n)) (string? (:name n)))]
                       [(:name n) n]))
        erroring (set (for [[nm f] fns :when (some #(= "error" (gnu-attr-name %)) (gnu-attrs-of f))] nm))
        strip (fn strip [x] (if (#{"ImplicitCastExpr" "ParenExpr"} (:kind x)) (strip (first (:inner x))) x))
        inline? (fn [f] (and (:inline f) (some #(#{"always_inline" "gnu_inline"} (gnu-attr-name %)) (gnu-attrs-of f))))
        callee (fn [c] (get-in (some-> (first (:inner c)) strip) [:referencedDecl :name]))]
    (when (seq erroring)
      (walk-nodes
       (fn [c _]
         (when (= "CallExpr" (:kind c))
           (when-let [f (get fns (callee c))]
             (when-let [body (and (inline? f) (first (filter #(= "CompoundStmt" (:kind %)) (:inner f))))]
               (let [ps (vec (keep #(when (and (= "ParmVarDecl" (:kind %)) (not (:_badtypes %))) (:name %)) (:inner f)))
                     args (vec (rest (:inner c)))
                     lit (fn [a] (let [a (strip a)] (case (:kind a) "IntegerLiteral" (try (Long/parseLong (str (:value a))) (catch Exception _ nil)) "StringLiteral" :str nil)))]
                 (when (and (>= (count args) (count ps)) (every? some? (map lit args)))
                   (let [env (zipmap ps (map lit args))
                         va-len (- (count args) (count ps))]
                     (letfn [(ev [x]
                               (let [x (strip x)]
                                 (case (:kind x)
                                   "IntegerLiteral" (try (Long/parseLong (str (:value x))) (catch Exception _ nil))
                                   "DeclRefExpr" (let [v (get env (get-in x [:referencedDecl :name]))] (when (number? v) v))
                                   "CallExpr" (case (callee x)
                                                "__builtin_va_arg_pack_len" va-len
                                                "__builtin_constant_p" (let [a (some-> (second (:inner x)) strip)]
                                                                         (if (or (#{"IntegerLiteral" "StringLiteral"} (:kind a))
                                                                                 (and (= "DeclRefExpr" (:kind a)) (contains? env (get-in a [:referencedDecl :name]))))
                                                                           1 0))
                                                nil)
                                   "UnaryOperator" (when (= "!" (:opcode x)) (when-let [v (ev (first (:inner x)))] (if (zero? (long v)) 1 0)))
                                   "BinaryOperator" (let [[a b] (:inner x) va (ev a) vb (ev b) op (:opcode x)]
                                                      (cond
                                                        (= op "&&") (cond (and va (zero? (long va))) 0 (and va vb) (if (zero? (long vb)) 0 1) :else nil)
                                                        (= op "||") (cond (and va (not (zero? (long va)))) 1 (and va vb) (if (zero? (long vb)) 0 1) :else nil)
                                                        (and va vb) (let [va (long va) vb (long vb)]
                                                                      (case op "&" (bit-and va vb) "|" (bit-or va vb) "+" (+ va vb) "-" (- va vb)
                                                                            "==" (if (= va vb) 1 0) "!=" (if (not= va vb) 1 0) "<" (if (< va vb) 1 0) ">" (if (> va vb) 1 0)
                                                                            "<=" (if (<= va vb) 1 0) ">=" (if (>= va vb) 1 0) nil))
                                                        :else nil))
                                   nil)))
                             (calls! [x]
                               (walk-nodes (fn [k _] (when (and (= "CallExpr" (:kind k)) (contains? erroring (callee k)))
                                                       (when-let [o (get-in k [:range :begin :offset])]
                                                         (when (= main (or (get-in k [:range :begin :file]) main))
                                                           (let [[l cc] (line-col starts (long o))]
                                                             (.add out {:line l :col cc :kind :error :rule :error-attr
                                                                        :msg (str "call to '" (callee k) "' declared with attribute error")}))))))
                                           x nil))
                             ;; a statement followed: true when it ends the path (a return on every way through it)
                             (stmt [x]
                               (case (:kind x)
                                 "ReturnStmt" (do (calls! x) true)
                                 "CompoundStmt" (loop [ss (:inner x)] (if-let [s1 (first ss)] (if (stmt s1) true (recur (rest ss))) false))
                                 "IfStmt" (let [[cnd th el] (:inner x) v (ev cnd)]
                                            (calls! cnd)
                                            (cond (nil? v) (let [a (stmt th) b (if el (stmt el) false)] (and a b))
                                                  (zero? (long v)) (if el (stmt el) false)
                                                  :else (stmt th)))
                                 (do (calls! x) false)))]
                       (stmt body)))))))))
       (:nodes u) nil))
    (vec (distinct out))))

;; GCC's built-in functions as values (cpp-gnu, 2026-11-22; the GCC 15.2 manual's "Other Built-in Functions": a built-in without a
;; library function behind it, __builtin_trap's kind, exists only as a call: GCC's "built-in function '__builtin_trap' must be directly
;; called"; one with a library fallback, __builtin_abs for abs, has an address): such a name used other than as a call's callee, the
;; operand of a cast to void, an expression statement of its own or an unevaluated operand (sizeof, alignof, decltype, typeof,
;; noexcept), or as a template argument of a variable's type, is an error at the use (addr_builtin-1.C). A builtin's fallback is the
;; library function of its name without __builtin_ in clang's table (cpp/target/clang-builtins.edn).

(def ^:private lib-functions
  (delay (let [f (java.io.File. "cpp/target/clang-builtins.edn")]
           (when (.exists f)
             (into #{} (keep (fn [[n k]] (when (#{:lib :target-lib} k) n)) (:builtins (read-string (slurp f)))))))))

(defn builtin-values
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        libs @lib-functions
        declared (into #{} (for [n (mapcat #(if (= "LinkageSpecDecl" (:kind %)) (:inner %) [%]) (:nodes u)) :when (string? (:name n))] (:name n)))
        direct? (fn [^String nm] (and libs (re-matches #"__builtin_\w+" nm) (not (contains? libs (subs nm 10))) (not (contains? declared nm))
                                      (some? (re-find #"^__builtin_(?:trap|unreachable|abort_|return_address|frame_address|expect|prefetch|constant_p|clear_cache|debugtrap|ia32_\w+|choose_expr|va_\w+|unpredictable)" nm))))
        report! (fn [o msg] (when o (let [[l c] (line-col starts (long o))] (.add out {:line l :col c :kind :error :rule :builtin-value :msg msg}))))
        off (fn [n] (when (= main (or (get-in n [:range :begin :file]) main)) (get-in n [:range :begin :offset])))]
    (letfn [(w [x parent uneval]
              (cond
                (map? x)
                (let [k (:kind x)
                      uneval (or uneval (and (= "UnaryExprOrTypeTraitExpr" k)) (#{"CXXNoexceptExpr" "DecltypeType"} k))]
                  (when (and (= "DeclRefExpr" k) (not uneval))
                    (let [nm (str (get-in x [:referencedDecl :name]))]
                      (when (direct? nm)
                        (let [pk (:kind parent)]
                          (when-not (or (and (= "CallExpr" pk) (identical? x (first (:inner parent))))
                                        (and (#{"CStyleCastExpr" "CXXStaticCastExpr" "CXXFunctionalCastExpr"} pk) (= "void" (str/trim (str (get-in parent [:type :qualType])))))
                                        (= "CompoundStmt" pk))
                            (report! (off x) (str "built-in function '" nm "' must be directly called")))))))
                  (when (= "VarDecl" k)
                    (when-let [[_ nm] (re-find #"<[^<>]*\b(__builtin_\w+)\b[^<>]*>" (str (get-in x [:type :qualType])))]
                      (when (direct? nm) (report! (or (get-in x [:loc :offset]) (off x)) (str "built-in function '" nm "' must be directly called")))))
                  (doseq [[kk v] x :when (and (not= kk :_ent) (or (map? v) (vector? v)))]
                    (w v (if k x parent) uneval)))
                (vector? x) (doseq [y x] (w y parent uneval))
                :else nil))]
      (w (:nodes u) nil false))
    (vec (distinct out))))

;; GCC's __builtin_launder (cpp-gnu, 2026-11-22; the GCC 15.2 manual's "Other Built-in Functions", as std::launder's [ptr.launder]:
;; one argument, a pointer to an object type): another number of arguments is "wrong number of arguments to '__builtin_launder'" -- in a
;; template a written argument beside a pack expansion at once, GCC's, a pack's size at each specialization the unit names by explicit
;; template arguments --, an argument of non-pointer type "argument is not a pointer to object type" (a variable's declared type, in a
;; function template's specialization the unit calls the parameter's type deduced from the call's argument), at the call
;; (cpp1z/launder2.C).

(defn builtin-launder
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        strip (fn strip [x] (if (#{"ImplicitCastExpr" "ParenExpr"} (:kind x)) (strip (first (:inner x))) x))
        report! (fn [n msg] (when-let [o (get-in n [:range :begin :offset])]
                              (when (= main (or (get-in n [:range :begin :file]) main))
                                (let [[l c] (line-col starts (long o))] (.add out {:line l :col c :kind :error :rule :launder :msg msg})))))
        launder? (fn [c] (and (= "CallExpr" (:kind c)) (= "__builtin_launder" (get-in (some-> (first (:inner c)) strip) [:referencedDecl :name]))))
        globals (into {} (for [n (:nodes u) :when (and (= "VarDecl" (:kind n)) (string? (:name n)))] [(:name n) (str (get-in n [:type :qualType]))]))
        ptr? (fn [^String t] (boolean (re-find #"\*\s*(?:const\s*)?$" (str/trim t))))
        ;; calls of each function template: [explicit-args arg-exprs]
        calls (let [m (java.util.HashMap.)]
                (walk-nodes (fn [c _] (when (= "CallExpr" (:kind c))
                                        (let [cal (some-> (first (:inner c)) strip)]
                                          (when (= "DeclRefExpr" (:kind cal))
                                            (let [nm (get-in cal [:referencedDecl :name])]
                                              (.put m nm (conj (or (.get m nm) []) [(vec (:explicitTemplateArgs cal)) (vec (rest (:inner c)))])))))))
                            (:nodes u) nil)
                m)
        expr-type (fn [e vars] (let [e (strip e)]
                                 (case (:kind e)
                                   "DeclRefExpr" (or (get vars (get-in e [:referencedDecl :name])) (get globals (get-in e [:referencedDecl :name])))
                                   "UnaryOperator" (when (= "&" (:opcode e)) "T *")
                                   nil)))]
    (doseq [n (:nodes u)]
      (if (= "FunctionTemplateDecl" (:kind n))
        (let [f (some #(when (= "FunctionDecl" (:kind %)) %) (:inner n))
              tps (vec (filter #(= "TemplateTypeParmDecl" (:kind %)) (:inner n)))
              pack (some #(when (:isParameterPack %) (:name %)) tps)
              npre (count (take-while #(not (:isParameterPack %)) tps))
              params (vec (filter #(= "ParmVarDecl" (:kind %)) (:inner f)))
              pvars (into {} (for [p params :when (string? (:name p))] [(:name p) (str (get-in p [:type :qualType]))]))]
          (walk-nodes (fn [c _]
                        (when (launder? c)
                          (let [args (rest (:inner c))
                                plain (count (remove #(= "PackExpansionExpr" (:kind %)) args))
                                exps (count (filter #(= "PackExpansionExpr" (:kind %)) args))]
                            (cond
                              (or (and (zero? exps) (not= 1 plain)) (and (pos? exps) (pos? plain)))
                              (report! c "wrong number of arguments to '__builtin_launder'")
                              (and (pos? exps) pack)
                              (when (some (fn [[eas _]] (and (>= (count eas) npre) (not= 1 (- (count eas) npre)))) (.get calls (:name n)))
                                (report! c "wrong number of arguments to '__builtin_launder'"))
                              (= 1 plain)
                              (let [a (strip (first args))]
                                (when (= "DeclRefExpr" (:kind a))
                                  (when-let [pt (get pvars (get-in a [:referencedDecl :name]))]
                                    (let [pt (str/trim pt) tp (some #(when (= pt (:name %)) pt) tps)
                                          pi (first (keep-indexed (fn [i p] (when (= (:name p) (get-in a [:referencedDecl :name])) i)) params))]
                                      ;; a parameter of type T deduced at each call from the argument's type
                                      (when (and tp pi (some (fn [[eas cargs]] (when-let [at (and (empty? eas) (get cargs pi) (expr-type (get cargs pi) {}))]
                                                                                 (not (ptr? at))))
                                                             (.get calls (:name n))))
                                        (report! c "argument is not a pointer to object type"))))))
                              :else nil))))
                      (:inner f) nil))
        (walk-nodes (fn [c _]
                      (when (launder? c)
                        (let [args (vec (rest (:inner c)))]
                          (cond (not= 1 (count args)) (report! c "wrong number of arguments to '__builtin_launder'")
                                :else (when-let [t (expr-type (first args) {})]
                                        (when-not (ptr? t) (report! c "argument is not a pointer to object type")))))))
                    n nil)))
    (vec (distinct out))))

;; GCC's coroutine interface (cpp-gnu, 2026-11-22; the GCC 15.2 manual's coroutine support with libstdc++'s <coroutine>: the lowering of a
;; coroutine whose promise type is P calls std::coroutine_handle<P>::from_address, which [coroutine.handle.export.import] declares a
;; static member function): a specialization of std::coroutine_handle<P> by the program whose from_address is not one static member
;; function, with a coroutine of promise type P in the unit, is GCC's "'std::coroutine_handle<P>::from_address' must be a
;; non-overloaded static function", at the coroutine's first co_return, co_await or co_yield (coroutines/pr105475-3.C).

(defn coroutine-handle-interface
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        specs (into {} (for [ns (:nodes u) :when (and (= "NamespaceDecl" (:kind ns)) (= "std" (:name ns)))
                             r (:inner ns) :when (and (= "ClassTemplateSpecializationDecl" (:kind r)) (= "coroutine_handle" (:name r)))
                             :let [arg (some #(when (= "TemplateArgument" (:kind %)) (str/trim (str (get-in % [:type :qualType])))) (:inner r))
                                   fa (filter #(and (= "CXXMethodDecl" (:kind %)) (= "from_address" (:name %))) (:inner r))]
                             :when (and arg (or (not= 1 (count fa)) (not= "static" (:storageClass (first fa)))))]
                         [arg r]))
        promise-of (into {} (for [r (:nodes u) :when (and (= "CXXRecordDecl" (:kind r)) (:name r))
                                  m (:inner r) :when (and (#{"TypeAliasDecl" "TypedefDecl"} (:kind m)) (= "promise_type" (:name m)))]
                              [(:name r) (str/trim (str (get-in m [:type :qualType])))]))]
    (when (seq specs)
      (doseq [f (:nodes u) :when (= "FunctionDecl" (:kind f))
              :let [ret (str/trim (str/replace (fn-ret-type (str (get-in f [:type :qualType]))) #"\b(?:struct|class)\b" ""))
                    p (get promise-of ret)]
              :when (and p (contains? specs p))
              :let [co (let [r (atom nil)] (walk-nodes (fn [x _] (when (and (nil? @r) (#{"CoreturnStmt" "CoawaitExpr" "CoyieldExpr"} (:kind x))) (reset! r x))) (:inner f) nil) @r)
                    o (or (get-in co [:range :begin :offset]) (get-in f [:loc :offset]))]
              :when (and co o (= main (or (get-in co [:range :begin :file]) main)))]
        (let [[l c] (line-col starts (long o))]
          (.add out {:line l :col c :kind :error :rule :coroutine :msg (str "'std::coroutine_handle<" p ">::from_address' must be a non-overloaded static function")}))))
    (vec out)))

;; GCC's __integer_pack (cpp-gnu, 2026-11-22; the GCC 15.2 manual's "Other Built-in Functions": `__integer_pack (length)` is a pack of
;; the integers 0 to length-1, "only valid within a pack expansion" of a template argument list, libstdc++'s make_integer_sequence's):
;; one in an alias template's argument list without its `...` ("parameter packs not expanded with '...'"), or named without its call
;; (no constant), at the alias; one whose length at a specialization the unit names is negative or past GCC's limit 268435452 ("argument
;; to '__integer_pack' must be between 0 and 268435452"), at the alias; a call of it outside a template's arguments ("use of built-in
;; parameter pack '__integer_pack' outside of a template"); and an object of such an alias's class type copy-initialized from an
;; integer, a class with no constructor ("conversion from 'int' to non-scalar type"), at the object (ext/integer-pack1.C).

(defn integer-pack
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        off (fn [n] (or (get-in n [:loc :offset]) (get-in n [:range :begin :offset])))
        report! (fn [n msg] (when-let [o (off n)]
                              (when (= main (or (get-in n [:loc :file]) (get-in n [:range :begin :file]) main))
                                (let [[l c] (line-col starts (long o))] (.add out {:line l :col c :kind :error :rule :integer-pack :msg msg})))))
        aliases (for [t (:nodes u) :when (= "TypeAliasTemplateDecl" (:kind t))
                      :let [a (some #(when (= "TypeAliasDecl" (:kind %)) %) (:inner t))
                            qt (str (get-in a [:type :qualType]))]
                      :when (str/includes? qt "__integer_pack")]
                  [t a qt])
        classes (into {} (for [t (:nodes u) :when (= "ClassTemplateDecl" (:kind t))] [(:name t) (some #(when (= "CXXRecordDecl" (:kind %)) %) (:inner t))]))]
    (doseq [[t a qt] aliases]
      (cond (re-find #"__integer_pack\s*(?![\s(])" qt) (report! a "'__integer_pack' used without its argument")
            (re-find #"__integer_pack\s*\([^()]*\)\s*(?!\s*\.\.\.)" qt) (report! a "parameter packs not expanded with '...'")
            :else nil))
    (walk-nodes (fn [v _]
                  (when (= "VarDecl" (:kind v))
                    (when-let [[_ nm as] (re-matches #"(\w+)<(.*)>" (str/trim (str (get-in v [:type :qualType]))))]
                      (when-let [[t a qt] (last (filter (fn [[t]] (and (= nm (:name t)) (< (long (or (off t) 0)) (long (or (off v) 0))))) aliases))]
                        (let [ps (vec (keep #(when (= "NonTypeTemplateParmDecl" (:kind %)) (:name %)) (:inner t)))
                              env (into {} (keep (fn [[p x]] (when-let [n (int-eval (str/replace x #"\s+" "") {})] [p n])) (map vector ps (map str/trim (str/split as #",")))))]
                          (when-let [[_ arg] (re-find #"__integer_pack\s*\(([^()]*)\)" qt)]
                            (when-let [n (int-eval arg env)]
                              (when (or (neg? (.signum ^java.math.BigInteger n)) (> (.compareTo ^java.math.BigInteger n (java.math.BigInteger/valueOf 268435452)) 0))
                                (report! a "argument to '__integer_pack' must be between 0 and 268435452"))))
                          ;; a class with no constructor copy-initialized from an integer
                          (when-let [[_ cn] (re-find #"^(\w+)<" qt)]
                            (when-let [r (get classes cn)]
                              (when (and (= "c" (:init v)) (= "IntegerLiteral" (:kind (first (:inner v))))
                                         (not-any? #(= "CXXConstructorDecl" (:kind %)) (:inner r)))
                                (report! v (str "conversion from 'int' to non-scalar type '" nm "<" as ">' requested"))))))))))
                (:nodes u) nil)
    ;; (cpp-tpl2: a call within a template's declaration, an alias template's argument list or a templated function's body, is
    ;; inside a template: cpp0x/variadic184.C, cpp1z/constexpr-if-lambda3.C had been reported)
    ;; (a node of the template's copied elsewhere, an alias's expansion the parser keeps on a use, keeps its place: judged by it)
    (let [inside (java.util.HashSet.) outside (java.util.ArrayList.)]
      (letfn [(w [x in-t]
                (cond
                  (map? x) (let [in-t (or in-t (contains? #{"TypeAliasTemplateDecl" "ClassTemplateDecl" "FunctionTemplateDecl" "VarTemplateDecl"
                                                            "ClassTemplatePartialSpecializationDecl" "VarTemplatePartialSpecializationDecl"} (:kind x)))]
                             (when (and (= "CallExpr" (:kind x)) (= "__integer_pack" (get-in (first (:inner x)) [:referencedDecl :name])))
                               (if in-t (.add inside (off x)) (.add outside x)))
                             (doseq [[k v] x :when (and (not= k :_ent) (or (map? v) (vector? v) (seq? v)))] (w v in-t)))
                  (or (vector? x) (seq? x)) (doseq [y x] (w y in-t))
                  :else nil))]
        (w (:nodes u) false))
      (doseq [x outside :when (not (.contains inside (off x)))]
        (report! x "use of built-in parameter pack '__integer_pack' outside of a template")))
    (vec (distinct out))))

(def checks (atom [type-exprs undeclared redefinitions gnu-attrs constexpr-bodies constexpr-redecls jumps coroutines template-heads exception-specs unions nsdmi-uses linkage-conflicts alloc-templates tparam-shadows undeduced-uses friend-default-targs auto-void-returns unexpanded-packs builtin-fp-args reinterpret-prvalues gnu-rules changes-meaning eh-runtime musttail flexible-arrays unavailable trait-signatures pragmas labels-as-values case-values stmt-expr-constexpr gnu-asm gnu-packed gnu-interface object-sizes vla-types operand-types fixed-point-literals gnu-inline-and-abi va-arg-pack read-only-modify constexpr-options satisfaction-changes old-inheriting-ctors builtin-operator-new invocable-traits error-attr-calls builtin-values builtin-launder coroutine-handle-interface integer-pack]))

;; ---------------------------------------------------------------------------------------------
;; cpp-diag-b (2026-11-22): the checks of the burst's stream cpp-diag-b, appended to `checks` (each rule from the standard, GCC's
;; manual for its words; no GCC code read)

(defn- mine-at
  "A node's main-file offset (its location's, its range's begin, through a macro expansion), or nil outside the main file."
  [n ^String main]
  (let [f (or (get-in n [:loc :file]) (get-in n [:loc :expansionLoc :file]) (get-in n [:range :begin :file]))
        o (or (get-in n [:loc :offset]) (get-in n [:loc :expansionLoc :offset]) (get-in n [:range :begin :offset]))]
    (when (and o (or (nil? f) (= f main))) (long o))))

;; [basic.scope.block]/2: a declaration binding a name in the block scope of a function body's, a function-try-block's or its
;; handlers', a lambda's compound-statement, or of a selection or iteration statement's substatement (not itself one) conflicts
;; with a declaration of the parent scope: the function's parameters, the statement's init-statement, condition or
;; for-range-declaration, a handler's exception-declaration. GCC's "declaration of 'int x' shadows a parameter", "redeclaration
;; of 'int x'", at the inner declaration. A class or enumeration name hides rather than conflicts; C++26's `_` is name-independent.

(def ^:private conflicting-kinds #{"VarDecl" "FunctionDecl" "TypedefDecl" "TypeAliasDecl" "DecompositionDecl"})

(defn block-redeclarations
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        year (cxx-year (:std u))
        pe? (boolean (some #{"-pedantic-errors"} (:args u)))
        names-of (fn [decls] (into {} (for [d decls :let [nm (:name d)] :when (and (string? nm) (seq nm) (or (conflicting-kinds (:kind d)) (#{"ParmVarDecl" "BindingDecl"} (:kind d)))
                                                                                  ;; (cpp-1123: before C++26 a name-independent `_` is GCC's pedwarn alone,
                                                                                  ;; an error under -pedantic-errors only: cpp26/name-independent-decl2.C, -8.C)
                                                                                  (not (and (= nm "_") (or (>= (long year) 2026) (not pe?)))))]
                                        [nm d])))
        stmt-decls (fn [s] (case (:kind s)
                             "DeclStmt" (mapcat #(cond (= "DecompositionDecl" (:kind %)) (filter (fn [b] (= "BindingDecl" (:kind b))) (:inner %))
                                                       ;; (an anonymous union's members are the block's names, [class.union.anon]/1)
                                                       (and (= "CXXRecordDecl" (:kind %)) (nil? (:name %)) (= "union" (:tagUsed %)))
                                                       (filter (fn [f] (= "FieldDecl" (:kind f))) (:inner %))
                                                       :else [%])
                                                (:inner s))
                             nil))
        block-decls (fn [s] (case (:kind s)
                              "CompoundStmt" (mapcat stmt-decls (:inner s))
                              "DeclStmt" (stmt-decls s)
                              nil))
        judge (fn [outer s param?]
                (when (seq outer)
                  (doseq [d (block-decls s)
                          :let [nm (:name d) prev (get outer nm)]
                          :when (and prev (string? nm) (or (conflicting-kinds (:kind d)) (#{"BindingDecl" "FieldDecl"} (:kind d))))
                          :let [o (mine-at d main)]
                          :when o]
                    (let [[l c] (line-col starts o)
                          ty (get-in d [:type :qualType])
                          what (str "'" (when ty (str ty " ")) nm "'")]
                      (.add out {:line l :col c :kind :error :rule :block-redeclaration
                                 :msg (if param? (str "declaration of " what " shadows a parameter") (str "redeclaration of " what))})))))
        header (fn [s] (let [in (vec (:inner s))]
                         (case (:kind s)
                           ("IfStmt" "SwitchStmt") (concat (when (:hasInit s) (stmt-decls (first in)))
                                                           (when (:hasVar s) (stmt-decls (nth in (if (:hasInit s) 1 0)))))
                           "WhileStmt" (when (:hasVar s) (stmt-decls (first in)))
                           "ForStmt" (concat (stmt-decls (nth in 0 nil)) (stmt-decls (nth in 1 nil)))
                           "CXXForRangeStmt" (concat (stmt-decls (nth in 0 nil)) (stmt-decls (nth in 6 nil)))
                           nil)))
        subs* (fn [s] (let [in (vec (:inner s))]
                        (case (:kind s)
                          "IfStmt" (let [k (+ (if (:hasInit s) 1 0) (if (:hasVar s) 1 0) 1)] (subvec in (min k (count in))))
                          ("SwitchStmt" "WhileStmt" "ForStmt" "CXXForRangeStmt") [(peek in)]
                          nil)))
        loop-kinds #{"IfStmt" "SwitchStmt" "WhileStmt" "ForStmt" "CXXForRangeStmt" "DoStmt"}
        fn-body (fn [f params]
                  (let [ps (names-of params)
                        body (last (:inner f))]
                    (case (:kind body)
                      "CompoundStmt" (judge ps body true)
                      "CXXTryStmt" (do (judge ps (first (:inner body)) true)
                                       (doseq [h (rest (:inner body)) :when (= "CXXCatchStmt" (:kind h))]
                                         ;; (a handler's exception-declaration too, [except.pre]/? : at the handler)
                                         (let [v (first (:inner h)) nm (:name v)]
                                           (when-let [o (and (string? nm) (get ps nm) (or (mine-at v main) (mine-at h main)))]
                                             (let [[l c] (line-col starts o)]
                                               (.add out {:line l :col c :kind :error :rule :block-redeclaration
                                                          :msg (str "declaration of '" (get-in v [:type :qualType]) " " nm "' shadows a parameter")}))))
                                         (judge ps (second (:inner h)) true)))
                      nil)))]
    (walk-nodes (fn [n _]
                  (let [k (:kind n)]
                    (cond
                      (fn-kinds k) (fn-body n (filter #(= "ParmVarDecl" (:kind %)) (:inner n)))
                      (= k "LambdaExpr")
                      (let [m (some (fn [r] (when (= "CXXRecordDecl" (:kind r))
                                              (some (fn [x] (cond (= "CXXMethodDecl" (:kind x)) x
                                                                  (= "FunctionTemplateDecl" (:kind x)) (some #(when (= "CXXMethodDecl" (:kind %)) %) (:inner x))
                                                                  :else nil))
                                                    (:inner r))))
                                    (:inner n))
                            body (some #(when (= "CompoundStmt" (:kind %)) %) (:inner n))]
                        (when (and m body) (judge (names-of (filter #(= "ParmVarDecl" (:kind %)) (:inner m))) body true)))
                      (= k "CXXCatchStmt")
                      (let [[v c] (:inner n)] (when (and (map? v) (string? (:name v))) (judge {(:name v) v} c false)))
                      (contains? loop-kinds k)
                      (let [h (names-of (header n))]
                        (doseq [s (subs* n) :when (and (map? s) (not (loop-kinds (:kind s))))] (judge h s false)))
                      :else nil)))
                (:nodes u) nil)
    (vec (distinct out))))

(swap! checks conj block-redeclarations)

;; [basic.def]/2 with [dcl.array]/5-ish ([basic.types.general]/5: an object's type is complete at its definition): a variable
;; defined (not extern, not a static data member's declaration in its class) with an array type of unknown bound and no
;; initializer to deduce the bound from: GCC's "storage size of 'a' isn't known", "array size missing in 'x'", at the name.

(defn unsized-arrays
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)]
    (walk-nodes (fn [n parent]
                  (when (and (= "VarDecl" (:kind n)) (string? (:name n))
                             (re-find #"\[\]$" (str (get-in n [:type :qualType])))
                             ;; (a pointer or reference to an array of unknown bound, `int *(*xx)[]`, is complete)
                             (not (re-find #"\((\*|&)" (str (get-in n [:type :qualType]))))
                             (not (:init n)) (empty? (remove #(not (map? %)) (:inner n)))
                             (not (#{"extern"} (:storageClass n)))
                             (not (#{"CXXRecordDecl" "ClassTemplateSpecializationDecl" "LinkageSpecDecl" "VarTemplateDecl" "ClassTemplatePartialSpecializationDecl"} (:kind parent))))
                    (when-let [o (mine-at n main)]
                      (let [[l c] (line-col starts o)]
                        (.add out {:line l :col c :kind :error :rule :unsized-array :msg (str "storage size of '" (:name n) "' isn't known")})))))
                (:nodes u) nil)
    (vec out)))

(swap! checks conj unsized-arrays)

;; [class.union.general]/? : a union has no base classes and is no base class: GCC's "derived union 'U' invalid", at the union, and
;; "base type 'U' fails to be a struct or class type", at the derived class; a base named by a union's name the file defines once
;; (no class of that name beside it).

(defn union-bases
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        recs (java.util.ArrayList.)
        _ (walk-nodes (fn [n _] (when (and (= "CXXRecordDecl" (:kind n)) (string? (:name n))) (.add recs n))) (:nodes u) nil)
        by-name (group-by :name recs)
        union? (fn [nm] (let [rs (get by-name nm)] (and (seq rs) (every? #(= "union" (:tagUsed %)) rs) (some :completeDefinition rs))))
        report! (fn [n msg] (when-let [o (mine-at n main)] (let [[l c] (line-col starts o)] (.add out {:line l :col c :kind :error :rule :union-base :msg msg}))))]
    (doseq [n recs :when (and (:completeDefinition n) (seq (:bases n)))]
      (if (= "union" (:tagUsed n))
        (report! n (str "derived union '" (:name n) "' invalid"))
        (when-let [b (first (filter #(union? (str/replace (str (get-in % [:type :qualType])) #"^union " "")) (:bases n)))]
          (report! n (str "base type '" (str/replace (str (get-in b [:type :qualType])) #"^union " "") "' fails to be a struct or class type")))))
    (vec out)))

(swap! checks conj union-bases)

;; [class.virtual]/8: an overrider's return type is the overridden function's, or both are pointers (or lvalue, or rvalue,
;; references) to classes, the overridden's class an unambiguous and accessible base of the overrider's (complete), the
;; overrider's no more cv-qualified: GCC's "invalid covariant return type for 'virtual C* C::foo()'" (class pointers or references
;; that are not), "conflicting return type specified for ..." (the rest), at the overrider. Judged on the file's own classes by
;; name (a class defined once, out of a template), a type whose names are no class of the file nor a fundamental type (a typedef,
;; a dependent type) not judged.

(def ^:private fund-words #{"void" "bool" "char" "signed" "unsigned" "short" "int" "long" "float" "double" "wchar_t" "char8_t" "char16_t" "char32_t" "__int128"})

(defn covariant-returns
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        recs (java.util.HashMap.)
        dup (java.util.HashSet.)
        _ (letfn [(w [x in-tmpl]
                    (cond (map? x) (let [k (:kind x)
                                         in-tmpl (or in-tmpl (#{"ClassTemplateDecl" "FunctionTemplateDecl" "ClassTemplatePartialSpecializationDecl"} k))]
                                     (when (and (= "CXXRecordDecl" k) (string? (:name x)) (seq (:name x)))
                                       (if (or (.containsKey recs (:name x)) in-tmpl)
                                         (when (or in-tmpl (:completeDefinition x) (:completeDefinition (.get recs (:name x)))) (.add dup (:name x)))
                                         (.put recs (:name x) x)))
                                     (doseq [[kk v] x :when (and (not= kk :_ent) (or (map? v) (vector? v)))] (w v in-tmpl)))
                          (vector? x) (doseq [y x] (w y in-tmpl))
                          :else nil))]
            (w (:nodes u) false))
        rec (fn [nm] (let [r (.get recs nm)] (when (and r (:completeDefinition r) (not (.contains dup nm))) r)))
        known-rec (fn [nm] (and (.containsKey recs nm) (not (.contains dup nm))))
        strip-key (fn [^String s] (str/trim (str/replace (str s) #"^(struct|class|union|enum)\s+" "")))
        ;; the bases of a class: [name public? virtual?]
        bases (fn [r] (for [b (:bases r)]
                        [(strip-key (get-in b [:type :qualType]))
                         (= "public" (let [a (:writtenAccess b)] (if (or (nil? a) (= a "none")) (if (= "class" (:tagUsed r)) "private" "public") a)))
                         (boolean (:isVirtual b))]))
        ;; the paths from class `d` up to `b`: each a vector of publicness, nil when `b` is no base
        paths (fn paths [d b depth]
                (when (< (long depth) 16)
                  (when-let [r (rec d)]
                    (vec (mapcat (fn [[bn pub _]] (if (= bn b) [[pub]] (map #(conj % pub) (paths bn b (inc (long depth)))))) (bases r))))))
        virt-bases (fn [d b] (when-let [r (rec d)] (some (fn [[bn _ v]] (and v (= bn b))) (bases r))))
        split (fn [^String qt] (let [i (.indexOf qt "(")] (when (pos? i) (let [r (str/trim (subs qt 0 i))] (when-not (str/includes? r ")") [r (str/replace (subs qt i) #"\s+" "")])))))
        ;; a return type: {:cls name :k "*"/"&"/"&&"/nil :cv #{} :fund bool} or nil when not judged
        rtype (fn [^String r]
                (let [k (cond (str/ends-with? r "&&") "&&" (str/ends-with? r "&") "&" (str/ends-with? r "*") "*" :else nil)
                      core (str/trim (if k (subs r 0 (- (count r) (count k))) r))
                      ws (remove #{""} (str/split core #"\s+"))
                      cv (set (filter #{"const" "volatile"} ws))
                      nm (remove #{"const" "volatile" "struct" "class" "union" "enum"} ws)]
                  (cond (and (seq nm) (every? fund-words nm)) {:fund (str/join " " nm) :k k :cv cv}
                        (and (= 1 (count nm)) (known-rec (first nm))) {:cls (first nm) :k k :cv cv}
                        :else nil)))
        methods (fn [r] (filter #(and (= "CXXMethodDecl" (:kind %)) (string? (:name %)) (not (str/starts-with? (:name %) "operator ")))
                                (:inner r)))
        ;; the virtual function of the bases `nm` with the signature `sig` overrides, [the base's method] or nil
        overridden (fn ov [cls nm sig depth]
                     (when (< (long depth) 16)
                       (when-let [r (rec cls)]
                         (some (fn [[bn]]
                                 (or (when-let [br (rec bn)]
                                       (some (fn [m] (when (and (= nm (:name m)) (= sig (second (split (str (get-in m [:type :qualType])))))
                                                                (or (:virtual m) (ov bn nm sig (inc (long depth)))))
                                                       m))
                                             (methods br)))
                                     (ov bn nm sig (inc (long depth)))))
                               (bases r)))))]
    (doseq [[cn r] recs :when (and (rec cn) (seq (:bases r)))
            m (methods r)
            :let [[rt sig] (split (str (get-in m [:type :qualType])))]
            :when sig
            :let [bm (overridden cn (:name m) sig 0)]
            :when bm
            :let [[brt _] (split (str (get-in bm [:type :qualType])))]
            :when (and brt (not= (str/replace rt #"\s+" "") (str/replace brt #"\s+" "")))
            :let [a (rtype rt) b (rtype brt) o (mine-at m main)]
            :when (and a b o)]
      (let [cls-ptr? (and (:cls a) (:cls b) (:k a) (= (:k a) (:k b)))
            ok? (and cls-ptr?
                     (every? (:cv b) (:cv a))
                     (or (= (:cls a) (:cls b))
                         (let [ps (paths (:cls a) (:cls b) 0)]
                           (and (rec (:cls a)) (= 1 (count ps)) (every? true? (first ps))))))
            ;; (two paths through one virtual base, the base reached once: not judged)
            unsure? (and cls-ptr? (not ok?) (> (count (paths (:cls a) (:cls b) 0)) 1))]
        (when-not (or ok? unsure?)
          (let [[l c] (line-col starts o)]
            (.add out {:line l :col c :kind :error :rule :covariant
                       :msg (if cls-ptr?
                              (str "invalid covariant return type for '" (:name m) "'")
                              (str "conflicting return type specified for '" (:name m) "'"))})))))
    (vec out)))

(swap! checks conj covariant-returns)

;; [basic.start.main]/3: main is not declared with a linkage-specification, and nothing named main of a namespace has C language
;; linkage: GCC's "cannot declare '::main' with a linkage specification", at the declaration (a class's member main aside).

(defn main-linkage
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)]
    (letfn [(w [x lang]
              (cond (map? x)
                    (let [k (:kind x)]
                      (when (and lang (= "main" (:name x))
                                 (or (= "FunctionDecl" k) (and (= "VarDecl" k) (= "C" lang))))
                        (when-let [o (mine-at x main)]
                          (let [[l c] (line-col starts o)]
                            (.add out {:line l :col c :kind :error :rule :main-linkage :msg "cannot declare '::main' with a linkage specification"}))))
                      (cond (= k "LinkageSpecDecl") (doseq [y (:inner x)] (w y (:language x)))
                            (= k "NamespaceDecl") (doseq [y (:inner x)] (w y lang))
                            (nil? k) (doseq [y (if (vector? x) x [])] (w y lang))
                            :else nil))
                    (vector? x) (doseq [y x] (w y lang))
                    :else nil))]
      (w (:nodes u) nil))
    (vec out)))

(swap! checks conj main-linkage)

;; [class.mem.general]/? (C++23 /21-22): a class T's static data members, member types and templates, enumerators of its unscoped
;; enumerations, an anonymous union's members are named otherwise than T, and its non-static data members too when it has a
;; user-declared constructor: GCC's "'int B::B' has the same name as the class in which it is declared", at the member.

(defn same-name-members
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        report! (fn [n cls] (when-let [o (mine-at n main)]
                              (let [[l c] (line-col starts o)]
                                (.add out {:line l :col c :kind :error :rule :same-name :msg (str "'" (:name n) "' has the same name as the class '" cls "' in which it is declared")}))))]
    (walk-nodes (fn [n _]
                  (when (and (= "CXXRecordDecl" (:kind n)) (:completeDefinition n) (string? (:name n)) (seq (:name n)))
                    (let [cls (:name n)
                          ms (:inner n)
                          ctor? (some #(and (= "CXXConstructorDecl" (:kind %)) (not (:isImplicit %))) ms)]
                      (doseq [m ms :when (= cls (:name m))]
                        (case (:kind m)
                          "VarDecl" (report! m cls)
                          "FieldDecl" (when ctor? (report! m cls))
                          ("TypedefDecl" "TypeAliasDecl" "ClassTemplateDecl" "EnumDecl") (report! m cls)
                          "CXXRecordDecl" (when-not (:isImplicit m) (report! m cls))
                          nil))
                      (doseq [m ms :when (and (= "EnumDecl" (:kind m)) (not (:scopedEnumTag m)))
                              e (:inner m) :when (and (= "EnumConstantDecl" (:kind e)) (= cls (:name e)))]
                        (report! e cls)))))
                (:nodes u) nil)
    (vec (distinct out))))

(swap! checks conj same-name-members)

;; [basic.start.main]/2-3: the global namespace's main is a function returning int, not a template, not static, inline or constexpr,
;; and no variable of the global namespace is named main; GCC's -Wmain under -pedantic-errors (its parameters: none, or int and
;; char**, GNU's third char** too). GCC's "'::main' must return 'int'", "cannot declare '::main' to be a template", "cannot declare
;; '::main' to be a global variable", "first argument of 'int main(char)' should be 'int'", at the declaration.

(defn main-rules
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        pe (some #{"-pedantic-errors"} (:args u))
        report! (fn [n msg] (when-let [o (mine-at n main)]
                              (let [[l c] (line-col starts o)] (.add out {:line l :col c :kind :error :rule :main :msg msg}))))
        fn-main (fn [n]
                  (let [qt (str (get-in n [:type :qualType]))
                        i (.indexOf qt "(")
                        ret (when (pos? i) (str/trim (subs qt 0 i)))
                        ps (filter #(= "ParmVarDecl" (:kind %)) (:inner n))]
                    (cond
                      (and ret (not (re-find #"^(auto|decltype)" ret)) (not (re-matches #"(signed )?int|signed" ret)))
                      (report! (dissoc n :loc) "'::main' must return 'int'")
                      (= "static" (:storageClass n)) (report! n "cannot declare '::main' to be static")
                      ;; (cpp-rind: [basic.start.main]/3 as DR882 makes it, main defined as deleted, GCC's "'int main()' cannot be
                      ;; deleted"; DRs/dr882.C)
                      (:explicitlyDeleted n) (report! n "'::main' cannot be deleted")
                      (:inline n) (report! n "cannot declare '::main' to be inline")
                      (:constexpr n) (report! n "cannot declare '::main' to be 'constexpr'")
                      (and pe (seq ps) (not (re-matches #"(const )?int|int const" (str (get-in (first ps) [:type :qualType])))))
                      (report! n "first argument of 'main' should be 'int'")
                      (and pe (not (#{0 2 3} (count ps)))) (report! n "'main' takes only zero or two arguments")
                      :else nil)))]
    (letfn [(top [xs in-class]
              (doseq [x xs :when (map? x)]
                (case (:kind x)
                  "FunctionDecl" (when (and (= "main" (:name x)) (not in-class)) (fn-main x))
                  "VarDecl" (when (and (= "main" (:name x)) (not in-class) (not= "extern" (:storageClass x)))
                              (report! x "cannot declare '::main' to be a global variable"))
                  "FunctionTemplateDecl" (when (some #(and (= "FunctionDecl" (:kind %)) (= "main" (:name %))) (:inner x))
                                           (report! x "cannot declare '::main' to be a template"))
                  "LinkageSpecDecl" (top (:inner x) in-class)
                  ("CXXRecordDecl" "ClassTemplateDecl") (top (:inner x) true)
                  ;; (a friend declaration's main is the global namespace's)
                  "FriendDecl" (doseq [y (:inner x) :when (and (= "FunctionTemplateDecl" (:kind y))
                                                                (some #(and (= "FunctionDecl" (:kind %)) (= "main" (:name %)) (not (str/includes? (str (:name %)) "::"))) (:inner y)))]
                                 (report! x "cannot declare '::main' to be a template"))
                  nil)))]
      (top (:nodes u) false))
    (vec (distinct out))))

(swap! checks conj main-rules)

;; GNU's __thread (the GCC 15.2 manual's "Thread-Local Storage": a __thread variable of static storage duration has a constant
;; initializer, no dynamic initialization or destruction, unlike C++11's thread_local): a namespace-scope or static member __thread
;; variable initialized by a call of a function the file declares without constexpr, by the address of another thread-local
;; variable, or default-initialized by a class's user-declared constructor that is not constexpr: GCC's "non-local variable 'j'
;; declared '__thread' needs dynamic initialization", at the variable.

(defn thread-dynamic-init
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        fns (java.util.HashMap.)
        tls (java.util.HashSet.)
        recs (java.util.HashMap.)
        _ (walk-nodes (fn [n _]
                        (case (:kind n)
                          "FunctionDecl" (when (string? (:name n)) (.put fns (:name n) (boolean (or (:constexpr n) (:consteval n) (.get fns (:name n))))))
                          "VarDecl" (when (:tls n) (.add tls (:name n)))
                          "CXXRecordDecl" (when (and (:completeDefinition n) (string? (:name n))) (.put recs (:name n) n))
                          nil))
                      (:nodes u) nil)
        dynamic? (fn [x]
                   (let [hit (atom false)]
                     (walk-nodes (fn [m _]
                                   (case (:kind m)
                                     "CallExpr" (let [c (first (:inner m))
                                                      nm (when (= "DeclRefExpr" (:kind c)) (get-in c [:referencedDecl :name]))]
                                                  (when (and nm (false? (.get fns nm))) (reset! hit true)))
                                     "UnaryOperator" (when (= "&" (:opcode m))
                                                       (let [c (first (:inner m))]
                                                         (when (and (= "DeclRefExpr" (:kind c)) (.contains tls (get-in c [:referencedDecl :name])))
                                                           (reset! hit true))))
                                     nil))
                                 x nil)
                     @hit))
        ctor-dynamic? (fn [qt] (when-let [r (.get recs (str/trim (str/replace (str qt) #"^(const |volatile )*(struct |class )?" "")))]
                                 (some #(and (= "CXXConstructorDecl" (:kind %)) (not (:constexpr %)) (not (:isImplicit %))
                                             (not (:explicitlyDefaulted %)) (re-find #"^void \(\s*\)" (str (get-in % [:type :qualType]))))
                                       (:inner r))))]
    (letfn [(top [xs]
              (doseq [x xs :when (map? x)]
                (case (:kind x)
                  "VarDecl" (when (and (= "static" (:tls x)) (not= "extern" (:storageClass x))
                                       (or (and (:init x) (dynamic? (:inner x)))
                                           (and (not (:init x)) (ctor-dynamic? (get-in x [:type :qualType])))
                                           ;; (a class with a user-provided destructor: its dynamic destruction)
                                           (when-let [r (.get recs (str/trim (str/replace (str (get-in x [:type :qualType])) #"^(const |volatile )*(struct |class )?" "")))]
                                             (some #(and (= "CXXDestructorDecl" (:kind %)) (not (:isImplicit %)) (not (:explicitlyDefaulted %))) (:inner r)))))
                              (when-let [o (mine-at x main)]
                                (let [[l c] (line-col starts o)]
                                  (.add out {:line l :col c :kind :error :rule :tls-init
                                             :msg (str "non-local variable '" (:name x) "' declared '__thread' needs dynamic initialization")}))))
                  ("NamespaceDecl" "LinkageSpecDecl") (top (:inner x))
                  nil)))]
      (top (:nodes u)))
    (vec out)))

(swap! checks conj thread-dynamic-init)

;; [stmt.break]/1, [stmt.cont]/1: a break statement appears only in an iteration or switch statement, a continue statement only in an
;; iteration statement, of its own function (a lambda's body a function of its own): GCC's "break statement not within loop or
;; switch", "continue statement not within a loop", at the statement.

(defn stray-jumps
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        loops #{"ForStmt" "WhileStmt" "DoStmt" "CXXForRangeStmt"}
        report! (fn [n msg] (when-let [o (mine-at n main)] (let [[l c] (line-col starts o)] (.add out {:line l :col c :kind :error :rule :jump :msg msg}))))]
    (letfn [(w [x in-loop in-switch in-fn]
              (cond (map? x)
                    (let [k (:kind x)]
                      (cond
                        (= k "BreakStmt") (when (and in-fn (not in-loop) (not in-switch)) (report! x "break statement not within loop or switch"))
                        (= k "ContinueStmt") (when (and in-fn (not in-loop)) (report! x "continue statement not within a loop"))
                        :else
                        (let [[l s f] (cond (contains? fn-kinds k) [false false true]
                                            (= k "LambdaExpr") [false false true]
                                            (#{"CXXRecordDecl" "ClassTemplateDecl"} k) [false false false]
                                            (contains? loops k) [true in-switch in-fn]
                                            (= k "SwitchStmt") [in-loop true in-fn]
                                            :else [in-loop in-switch in-fn])]
                          (doseq [[kk v] x :when (and (not= kk :_ent) (or (map? v) (vector? v)))] (w v l s f)))))
                    (vector? x) (doseq [y x] (w y in-loop in-switch in-fn))
                    :else nil))]
      (w (:nodes u) false false false))
    (vec out)))

(swap! checks conj stray-jumps)

;; [dcl.init.general]/8 (C++23 /8): a const object default-initialized (no initializer, not extern, not a static data member's
;; declaration in its class) is of a const-default-constructible class type: a user-provided default constructor, or every direct
;; non-static data member with a default member initializer or of such a class type, every base such a class. A scalar const
;; object has an initializer. GCC's "uninitialized 'const b'", at the variable. Classes judged by name (defined once, outside a
;; template); a type the file does not define, a template's, not judged.

(defn uninit-consts
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        recs (java.util.HashMap.)
        dup (java.util.HashSet.)
        _ (letfn [(w [x tm]
                    (cond (map? x) (let [k (:kind x) tm (or tm (#{"ClassTemplateDecl" "FunctionTemplateDecl" "ClassTemplatePartialSpecializationDecl" "ClassTemplateSpecializationDecl"} k))]
                                     (when (and (= "CXXRecordDecl" k) (string? (:name x)) (seq (:name x)) (:completeDefinition x))
                                       (if (or tm (.containsKey recs (:name x))) (.add dup (:name x)) (.put recs (:name x) x)))
                                     (doseq [[kk v] x :when (and (not= kk :_ent) (or (map? v) (vector? v)))] (w v tm)))
                          (vector? x) (doseq [y x] (w y tm))
                          :else nil))]
            (w (:nodes u) false))
        strip (fn [^String t] (-> t (str/replace #"\[[^\]]*\]" "") (str/replace #"\b(const|volatile|struct|class)\b" "") str/trim))
        ;; :yes, :no or nil (not judged)
        cdc (fn cdc [nm depth]
              (cond (> (long depth) 8) nil
                    (.contains dup nm) nil
                    :else
                    (when-let [r (.get recs nm)]
                      (let [ms (:inner r)
                            ctors (filter #(= "CXXConstructorDecl" (:kind %)) ms)
                            dflt (some #(and (not (:isImplicit %)) (not (:explicitlyDefaulted %)) (not (:explicitlyDeleted %))
                                             (re-find #"^void \(\s*\)" (str (get-in % [:type :qualType]))))
                                       ctors)]
                        (cond
                          dflt :yes
                          (= "union" (:tagUsed r)) nil
                          (some #(or (#{"CXXRecordDecl"} (:kind %)) (= "IndirectFieldDecl" (:kind %))) (filter #(and (= "CXXRecordDecl" (:kind %)) (nil? (:name %))) ms)) nil
                          :else
                          (let [fields (filter #(= "FieldDecl" (:kind %)) ms)
                                fs (for [f fields]
                                     (cond (:hasInClassInitializer f) :yes
                                           (nil? (:name f)) nil
                                           :else (let [t (str (get-in f [:type :qualType]))
                                                       b (strip t)]
                                                   (cond (re-find #"[*&(]" t) :no
                                                         (re-matches #"(unsigned |signed )?(char|short|int|long|long long|bool|float|double|wchar_t)( int)?" b) :no
                                                         (.containsKey recs b) (cdc b (inc (long depth)))
                                                         :else nil))))
                                bs (for [b (:bases r)] (cdc (strip (str (get-in b [:type :qualType]))) (inc (long depth))))
                                all (concat fs bs)]
                            (cond (some #(= :no %) all) (if (some nil? all) nil :no)
                                  (every? #(= :yes %) all) :yes
                                  :else nil)))))))]
    (walk-nodes (fn [n parent]
                  (when (and (= "VarDecl" (:kind n)) (string? (:name n)) (not (:init n))
                             (not (#{"extern"} (:storageClass n)))
                             ;; (cpp-decl2: an inline static data member's declaration in its class is its definition, [dcl.inline]/?
                             ;; with [class.static.data]/4: cpp1z/inline-var2.C's `static inline const int var25;`)
                             (or (and (:inline n) (#{"CXXRecordDecl"} (:kind parent)))
                                 (not (#{"CXXRecordDecl" "ClassTemplateSpecializationDecl" "ClassTemplatePartialSpecializationDecl" "LinkageSpecDecl" "VarTemplateDecl"} (:kind parent))))
                             (empty? (filter map? (:inner n))))
                    (let [t (str (get-in n [:type :qualType]))
                          b (strip t)]
                      ;; (a static data member's definition out of its class, `const int A::size;`, its initializer in the class)
                      (when (and (re-find #"(^|\s)const(\s|$)" t) (not (re-find #"[*&(]" t))
                                 (not (some-> (mine-at n main) (#(qualified-name? src (long %))))))
                        (when (or (re-matches #"(unsigned |signed )?(char|short|int|long|long long|bool|float|double|wchar_t)( int)?" b)
                                  (= :no (cdc b 0)))
                          (when-let [o (mine-at n main)]
                            (let [[l c] (line-col starts o)]
                              (.add out {:line l :col c :kind :error :rule :uninit-const :msg (str "uninitialized 'const " (:name n) "'")}))))))))
                (:nodes u) nil)
    (vec out)))

(swap! checks conj uninit-consts)

;; In a class's member-specification: [namespace.udecl]/10, a member using-declarator is not repeated ("redeclaration of 'using
;; Base::f'"); [over.load]/2, member functions of one name and parameter-type-list differ in more than their return type ("cannot
;; be overloaded"); [basic.scope.scope]/4 with [dcl.typedef]/? , a typedef-name and a class name of the class conflict unless the
;; typedef names that class ("conflicts with a previous declaration"); each at the later member.

(defn class-member-conflicts
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        report! (fn [n msg] (when-let [o (mine-at n main)] (let [[l c] (line-col starts o)] (.add out {:line l :col c :kind :error :rule :member-conflict :msg msg}))))
        split (fn [^String qt] (let [i (.indexOf qt "(")] (when (pos? i) [(str/replace (subs qt 0 i) #"\s+" "") (str/replace (subs qt i) #"\s+" "")])))]
    (walk-nodes (fn [n _]
                  (when (and (= "CXXRecordDecl" (:kind n)) (:completeDefinition n))
                    (let [ms (:inner n)
                          seen-u (java.util.HashSet.)
                          seen-f (java.util.HashMap.)
                          tags (set (keep #(when (and (= "CXXRecordDecl" (:kind %)) (not (:isImplicit %)) (string? (:name %))) (:name %)) ms))]
                      (doseq [m ms]
                        (case (:kind m)
                          "UsingDecl" (when-let [t (some-> (:_text m) (str/replace #"\s+" ""))]
                                        (when-not (.add seen-u t) (report! m (str "redeclaration of '" (:_text m) "'"))))
                          "CXXMethodDecl" (when-let [[r sg] (and (string? (:name m)) (split (str (get-in m [:type :qualType]))))]
                                            (let [k [(:name m) sg]]
                                              (if-let [r0 (.get seen-f k)]
                                                (when (and (not= r0 r) (not (re-find #"auto|decltype" (str r0 r))))
                                                  (report! m (str "'" (:name m) "' cannot be overloaded with a function differing only in its return type")))
                                                (.put seen-f k r))))
                          "EnumDecl" (when (and (string? (:name m)) (seq (filter #(= "EnumConstantDecl" (:kind %)) (:inner m))))
                                       (when-not (.add seen-u (str "enum " (:name m))) (report! m (str "multiple definition of 'enum " (:name m) "'"))))
                          ("TypedefDecl" "TypeAliasDecl")
                          (when (and (contains? tags (:name m))
                                     (not (#{(:name m) (str "struct " (:name m)) (str "class " (:name m)) (str "union " (:name m))}
                                           (str/trim (str (get-in m [:type :qualType]))))))
                            (report! m (str "'" (:name m) "' conflicts with a previous declaration")))
                          nil)))))
                (:nodes u) nil)
    (vec out)))

(swap! checks conj class-member-conflicts)

;; cpp-diag-b, round 2 (2026-11-22): warnings the file's options make errors (GCC's manual, "Warning Options": -Werror=X, or -Werror
;; with -WX), and pedwarns under -pedantic-errors the parser cannot see the options of; a check of the source text with the
;; comments, string and character literals blanked (`code-text`).

(defn- code-text
  "The source `src` with its comments and its string and character literals' bodies blanked (offsets and newlines kept)."
  ^String [^String src]
  (let [sb (StringBuilder. src) n (.length src)]
    (loop [i 0]
      (when (< i n)
        (let [c (.charAt src i) d (if (< (inc i) n) (.charAt src (inc i)) \space)]
          (cond
            (and (= c \/) (= d \/)) (let [e (let [k (.indexOf src "\n" (int i))] (if (neg? k) n k))]
                                      (doseq [k (range i e)] (.setCharAt sb (int k) \space)) (recur e))
            (and (= c \/) (= d \*)) (let [e (let [k (.indexOf src "*/" (int (+ i 2)))] (if (neg? k) n (+ k 2)))]
                                      (doseq [k (range i e) :when (not= \newline (.charAt src (int k)))] (.setCharAt sb (int k) \space)) (recur e))
            (or (= c \") (and (= c \') (not (and (pos? i) (Character/isLetterOrDigit (.charAt src (dec i)))))))
            (let [e (loop [k (inc i)] (cond (>= k n) n (= \\ (.charAt src k)) (recur (+ k 2)) (= c (.charAt src k)) k (= \newline (.charAt src k)) k :else (recur (inc k))))]
              (doseq [k (range (inc i) (min e n))] (.setCharAt sb (int k) \space)) (recur (inc e)))
            :else (recur (inc i))))))
    (str sb)))

(defn- werror?
  "Whether the options make the warning `w` (its name without -W) an error."
  [args ^String w]
  (let [as (set (map str args))]
    (and (not (contains? as (str "-Wno-" w)))
         (or (contains? as (str "-Werror=" w)) (and (contains? as "-Werror") (contains? as (str "-W" w)))))))

(defn option-errors
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        args (:args u)
        year (cxx-year (:std u))
        add! (fn [o msg] (let [[l c] (line-col starts (long o))] (.add out {:line l :col c :kind :error :rule :options :msg msg})))
        code (delay (code-text src))]
    ;; (cpplib: #pragma once in the main file, -Wpragma-once-outside-header's warning)
    (when (werror? args "pragma-once-outside-header")
      (let [m (re-matcher #"(?m)^[ \t]*#[ \t]*pragma[ \t]+once\b" @code)]
        (while (.find m) (add! (.start m) "#pragma once in main file [-Werror=pragma-once-outside-header]"))))
    ;; ([conv.array] with [lex.string]: a string literal converted to char*, -Wwrite-strings' warning, an error under its -Werror)
    (when (and (>= (long year) 11) (werror? args "write-strings") (not (some #{"-pedantic-errors"} args)))
      (walk-nodes (fn [n _]
                    (when (and (= "VarDecl" (:kind n)) (re-matches #"(signed |unsigned )?char \*( const)?" (str (get-in n [:type :qualType])))
                               (some #(= "StringLiteral" (:kind %)) (:inner n)))
                      (when-let [o (mine-at n main)] (add! o "ISO C++ forbids converting a string constant to 'char*' [-Werror=write-strings]"))))
                  (:nodes u) nil))
    ;; ([diff.cpp03]: long long is C++11's; under -pedantic-errors without -Wno-long-long, GCC's pedwarn "ISO C++ 1998 does not
    ;; support 'long long'", for the type and an integer literal's suffix)
    (when (and (< (long year) 2011) (some #{"-pedantic-errors"} args) (not (some #{"-Wno-long-long"} args)))
      (let [m (re-matcher #"\blong\s+long\b|\b(?:0[xX][0-9a-fA-F]+|[0-9]+)(?:[uU]?(?:ll|LL)|(?:ll|LL)[uU])\b" @code)]
        (while (.find m) (add! (.start m) "ISO C++ 1998 does not support 'long long'"))))
    (vec out)))

(swap! checks conj option-errors)

;; [expr.const]/5 (C++23 /5.7-5.8): an operation with undefined behaviour is no core constant expression: a division or remainder by
;; zero, a shift by a negative count or one not less than the promoted left operand's width ([expr.shift]/1), in an evaluated part of
;; a case label's or an enumerator's integral constant expression (|| and && and ?: evaluate one side). GCC's "division by zero is
;; not a constant expression", "right operand of shift expression is negative", "enumerator value for 'E3' is not an integer
;; constant", at the label or the enumerator. Only literals, casts and the operators judged: a name or a call leaves the expression.

(defn- ce-type [^String qt]
  (let [q (str/trim (str/replace (str qt) #"\b(const|volatile)\b" ""))]
    (case q
      ("int" "short" "signed char" "char" "bool" "unsigned short" "unsigned char" "wchar_t" "char16_t" "char8_t") [32 false]
      ("unsigned int" "char32_t") [32 true]
      ("long" "long long") [64 false]
      ("unsigned long" "unsigned long long") [64 true]
      nil)))

(def ^:private ^:dynamic *ce-overflow* "an atom set when a signed operation's value leaves its type's range" nil)

(defn- ce-eval
  "[value bits unsigned] of the integral constant expression `x`, nil when not judged; throws ex-info {:ce-bad msg}."
  [x]
  (let [k (:kind x) in (:inner x)
        bad (fn [m] (throw (ex-info m {:ce-bad m})))
        wrap (fn [^BigInteger v bits u] (let [m (.shiftLeft BigInteger/ONE (int bits)) r (.mod v m)
                                              w (if (or u (< (.compareTo r (.shiftLeft BigInteger/ONE (int (dec bits)))) 0)) r (.subtract r m))]
                                          w))
        ;; (a signed operation's mathematical value outside its type: [expr.pre]/4's undefined behaviour, noted)
        swrap (fn [^BigInteger v bits u] (let [r (wrap v bits u)] (when (and (not u) *ce-overflow* (not= r v)) (reset! *ce-overflow* true)) r))
        usual (fn [[_ b1 u1] [_ b2 u2]] (let [b (max (long b1) (long b2))] [b (boolean (or (and u1 (= b b1)) (and u2 (= b b2))))]))]
    (case k
      "IntegerLiteral" (when-let [[b u] (ce-type (get-in x [:type :qualType]))]
                         (let [v (try (BigInteger. (str/replace (str (:value x)) #"'" "")) (catch Exception _ nil))] (when v [v b u])))
      "CharacterLiteral" (when (number? (:value x)) [(BigInteger/valueOf (long (:value x))) 32 false])
      ("ParenExpr" "ConstantExpr") (ce-eval (first in))
      ("ImplicitCastExpr" "CStyleCastExpr" "CXXStaticCastExpr" "CXXFunctionalCastExpr")
      (when-let [[b u] (ce-type (get-in x [:type :qualType]))]
        (when-let [[v] (ce-eval (last in))] [(wrap v b u) b u]))
      "UnaryOperator"
      (when-let [[v b u :as e] (ce-eval (first in))]
        (let [[b u] (if (< (long b) 32) [32 false] [b u])]
          (case (:opcode x) "-" [(swrap (.negate ^BigInteger v) b u) b u] "+" [v b u] "~" [(wrap (.not ^BigInteger v) b u) b u]
                "!" [(if (zero? (.signum ^BigInteger v)) BigInteger/ONE BigInteger/ZERO) 32 false] nil)))
      "BinaryOperator"
      (let [o (:opcode x)]
        (case o
          ("||" "&&") (when-let [[a] (ce-eval (first in))]
                        (if (= (= o "||") (not (zero? (.signum ^BigInteger a))))
                          [(if (= o "||") BigInteger/ONE BigInteger/ZERO) 32 false]
                          (when-let [[b] (ce-eval (second in))] [(if (zero? (.signum ^BigInteger b)) BigInteger/ZERO BigInteger/ONE) 32 false])))
          (when-let [l (ce-eval (first in))]
            (when-let [r (ce-eval (second in))]
              (let [[lv] l [rv] r
                    lp (if (< (long (second l)) 32) [lv 32 false] l)
                    [b u] (usual lp (if (< (long (second r)) 32) [rv 32 false] r))]
                (case o
                  ("/" "%") (if (zero? (.signum ^BigInteger rv)) (bad "division by zero is not a constant expression")
                                [(wrap (if (= o "/") (.divide ^BigInteger lv rv) (.remainder ^BigInteger lv rv)) b u) b u])
                  ("<<" ">>") (let [w (long (second lp))]
                                (cond (neg? (.signum ^BigInteger rv)) (bad "right operand of shift expression is negative")
                                      (>= (.compareTo ^BigInteger rv (BigInteger/valueOf w)) 0) (bad "right operand of shift expression is greater than or equal to the precision of the left operand")
                                      :else [(wrap (if (= o "<<") (.shiftLeft ^BigInteger lv (int rv)) (.shiftRight ^BigInteger lv (int rv))) w (nth lp 2)) w (nth lp 2)]))
                  "+" [(swrap (.add ^BigInteger lv rv) b u) b u]
                  "-" [(swrap (.subtract ^BigInteger lv rv) b u) b u]
                  "*" [(swrap (.multiply ^BigInteger lv rv) b u) b u]
                  "&" [(wrap (.and ^BigInteger lv rv) b u) b u]
                  "|" [(wrap (.or ^BigInteger lv rv) b u) b u]
                  "^" [(wrap (.xor ^BigInteger lv rv) b u) b u]
                  ("<" ">" "<=" ">=" "==" "!=") (let [c (.compareTo ^BigInteger lv rv)]
                                                  [(if (case o "<" (neg? c) ">" (pos? c) "<=" (<= c 0) ">=" (>= c 0) "==" (zero? c) "!=" (not (zero? c))) BigInteger/ONE BigInteger/ZERO) 32 false])
                  nil))))))
      "ConditionalOperator" (when-let [[c] (ce-eval (first in))] (ce-eval (if (zero? (.signum ^BigInteger c)) (nth in 2) (second in))))
      nil)))

(defn constant-ub
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        pe (some #{"-pedantic-errors"} (:args u))
        year (cxx-year (:std u))
        add! (fn [n m] (when-let [o (mine-at n main)]
                         (let [[l c] (line-col starts o)]
                           (.add out {:line l :col c :kind :error :rule :constant-ub :msg m}))))
        judge (fn [n e what]
                (when (map? e)
                  (binding [*ce-overflow* (atom false)]
                    (try (ce-eval e)
                         ;; (GCC's pedwarn "overflow in constant expression", an error under -pedantic-errors)
                         (when (and pe @*ce-overflow*) (add! n "overflow in constant expression"))
                         (catch arbace.lang.ExceptionInfo x
                           (when-let [m (:ce-bad (ex-data x))]
                             (add! n (str m (when what (str "; " what))))))))))]
    ;; ([conv.ptr]/1 since C++11 (CWG 903): a null pointer constant is an integer literal of value zero, or of std::nullptr_t; an
    ;; integral expression of literals that is none initializing a pointer: GCC's "invalid conversion from 'int' to 'void*'")
    (when (and (>= (long year) 11) (not (some #{"-fpermissive"} (:args u))))
      (walk-nodes (fn [n _]
                    (when (and (= "VarDecl" (:kind n)) (= "c" (:init n)) (str/ends-with? (str/trim (str (get-in n [:type :qualType]))) "*"))
                      (let [e (first (filter map? (:inner n)))]
                        (when (and (#{"BinaryOperator" "ParenExpr" "ConditionalOperator" "UnaryOperator"} (:kind e))
                                   (not (and (= "ParenExpr" (:kind e)) (= "IntegerLiteral" (:kind (first (:inner e))))))
                                   (try (some? (ce-eval e)) (catch arbace.lang.ExceptionInfo _ true)))
                          (add! n "invalid conversion from 'int' to a pointer type")))))
                  (:nodes u) nil))
    ;; (cpp-read, 2026-11-24: C++98's [expr.const]/1, an integral constant expression uses no function call and no comma operator,
    ;; but in sizeof's operand -- even in an unevaluated operand of ?: (C++11's core constant expressions take both): GCC's "a function
    ;; call cannot appear in a constant-expression", "a comma operator cannot appear in a constant-expression", at a case label and a
    ;; bit-field's width; parse/constant1.C)
    (when (< (long year) 11)
      (let [bad? (fn bad? [e]
                   (cond (not (map? e)) false
                         (= "UnaryExprOrTypeTraitExpr" (:kind e)) false
                         (#{"CallExpr" "CXXMemberCallExpr" "CXXOperatorCallExpr"} (:kind e)) true
                         (and (= "BinaryOperator" (:kind e)) (= "," (:opcode e))) true
                         :else (boolean (some bad? (filter map? (:inner e))))))]
        (walk-nodes (fn [n _]
                      (case (:kind n)
                        "CaseStmt" (when (bad? (first (:inner n))) (add! n "a function call or comma operator cannot appear in a constant-expression"))
                        "FieldDecl" (when (and (:isBitfield n) (bad? (first (filter map? (:inner n)))))
                                      (add! n "a function call or comma operator cannot appear in a constant-expression"))
                        nil))
                    (:nodes u) nil)))
    (walk-nodes (fn [n _]
                  (case (:kind n)
                    "CaseStmt" (let [in (:inner n)] (judge n (first in) nil) (when (= 3 (count in)) (judge n (second in) nil)))
                    "EnumConstantDecl" (judge n (first (filter map? (:inner n))) (str "enumerator value for '" (:name n) "' is not an integer constant"))
                    "FieldDecl" (when (:isBitfield n) (judge n (first (filter map? (:inner n))) "bit-field width not an integer constant"))
                    nil))
                (:nodes u) nil)
    (vec out)))

(swap! checks conj constant-ub)

;; cpp-read (2026-11-24): GCC's loop pragmas (`#pragma GCC ivdep`, `#pragma GCC unroll N`, extend.texi's "Loop-Specific Pragmas")
;; apply to the for, while or do loop that follows; a for loop without a condition there is GCC's "missing loop condition in loop with
;; 'GCC ivdep' pragma before ';' token", at the loop (parse/ivdep.C). From the main file's text: the pragma's line, then the next
;; line that is not blank, a comment or another pragma.

(defn loop-pragmas
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        ls (vec (str/split-lines src))]
    (doseq [i (range (count ls))
            :let [[_ which] (re-find #"^\s*#\s*pragma\s+GCC\s+(ivdep|unroll)\b" (ls i))]
            :when which]
      (when-let [j (first (filter #(not (re-find #"^\s*($|//|/\*|#\s*pragma\b)" (ls %))) (range (inc i) (count ls))))]
        (when (re-find #"^\s*for\s*\([^;()]*;\s*;" (ls j))
          (.add out {:line (inc j) :col 1 :kind :error :rule :loop-pragma
                     :msg (str "missing loop condition in loop with 'GCC " which "' pragma before ';' token")}))))
    (vec out)))

(swap! checks conj loop-pragmas)

;; [expr.new]/6-7: in a new-expression's type every array bound past the first is a converted constant expression: a function
;; parameter there is GCC's "array size in new-expression must be constant", at the new-expression.

(defn new-bounds
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)]
    (walk-nodes (fn [n _]
                  (when (= "CXXNewExpr" (:kind n))
                    (when-let [[_ dims] (re-find #"\(\*\)((?:\[[^\]]*\])+)$" (str (get-in n [:type :qualType])))]
                      (let [ds (map second (re-seq #"\[([^\]]*)\]" dims))
                            ds (if (:isArray n) ds (rest ds))]
                        (when (some #(and (re-matches #"[A-Za-z_]\w*" (str/trim %)) (contains? *params* (str/trim %))) ds)
                          (when-let [o (mine-at n main)]
                            (let [[l c] (line-col starts o)]
                              (.add out {:line l :col c :kind :error :rule :new-bounds :msg "array size in new-expression must be constant"}))))))))
                (:nodes u) nil)
    (vec out)))

(swap! checks conj new-bounds)

;; the checker's (arbace.cpp.sema) refusals this stream adds, as sema-rules' entries: [class regexp diagnostic]
(alter-var-root #'sema-rules into
  [[:bool-incdec #"^codegen: use of an operand of type 'bool' in 'operator" "use of an operand of type 'bool' is forbidden"]
   [:ordered-cmp #"^codegen: ordered comparison of pointer with integer zero" "ordered comparison of pointer with integer zero"]
   [:array-init #"^codegen: array must be initialized" "array must be initialized with a brace-enclosed initializer"]
   [:scalar-braces #"^codegen: braces around scalar initializer" "braces around scalar initializer"]
   [:uninit-ref #"^codegen: uninitialized reference member" "uninitialized reference member"]
   [:write-strings #"^codegen: ISO C\+\+ forbids converting a string constant" "ISO C++ forbids converting a string constant"]
   [:return-value #"^codegen: return-statement with" "return-statement with or without a value"]
   [:void-value #"^codegen: void value not ignored" "void value not ignored as it ought to be"]
   [:unary-type #"^codegen: wrong type argument to unary" "wrong type argument to unary operator"]
   [:string-long #"^codegen: initializer-string for" "initializer-string is too long"]
   [:named-cast #"^codegen: invalid ('const_cast' from|cast from) type" "invalid cast"]
   [:fn-arith #"^codegen: pointer to a function used in arithmetic" "pointer to a function used in arithmetic"]
   [:delete-arg #"^codegen: (type of the argument given to 'delete'|cannot delete a function)" "invalid argument to delete"]
   [:cond-void #"^codegen: an operand of the conditional operator is of type 'void'" "void operand of the conditional operator"]
   [:ptr-cmp #"^codegen: comparison between distinct pointer types" "comparison between distinct pointer types lacks a cast"]
   [:mptr-base #"^codegen: (pointer to member conversion via virtual base|'.*' is an (ambiguous|inaccessible) base of)" "invalid pointer to member conversion"]
   [:init #"^codegen: a reference from arguments" "invalid value-initialization of reference type"]])

;; queue 499: a fallthrough statement ([dcl.attr.fallthrough]/1, `[[fallthrough]];`, GNU's `[[gnu::fallthrough]];`) with no
;; enclosing switch statement in its function: ill-formed, GCC's error "invalid use of attribute 'fallthrough'"; and under
;; -pedantic-errors (GCC's pedwarn) one after which no statement is executed in its switch, DR 2406: the last statement of
;; the switch's body, or of an iteration statement's body inside it ("attribute 'fallthrough' not preceding a case label or
;; default label"). GCC checks both as it gimplifies a function, so only a function g++ -fsyntax-only does not need but a
;; compilation surely emits is judged: a non-member function definition at namespace scope (a named namespace or none),
;; neither inline, constexpr, consteval, static nor a template's; a statement whose next one the walk below does not
;; determine (a statement after it that is no case label, a try block, a lambda between) is not judged.

(defn- fallthrough-stmt?
  "Queue 499: whether the node `n` is a fallthrough statement: an AttributedStmt of a null statement whose attribute's text
  names fallthrough."
  [n ^String src]
  (and (= "AttributedStmt" (:kind n))
       (let [ks (:inner n)]
         (and (vector? ks) (= "NullStmt" (:kind (peek ks)))
              (some (fn [a] (when (= "NativeAttr" (:kind a))
                              (let [b (get-in a [:range :begin :offset]) e (get-in a [:range :end :offset]) l (get-in a [:range :end :tokLen])]
                                (when (and b e l (<= (long b) (+ (long e) (long l)) (count src)))
                                  (re-find #"\b(?:__)?fallthrough(?:__)?\b" (subs src (long b) (+ (long e) (long l))))))))
                    (pop ks))))))

(defn fallthroughs
  [u starts ^String src main]
  (let [out (java.util.ArrayList.)
        pe? (let [args (:args u)] (and (some #{"-pedantic-errors"} args) (not (some #{"-Wno-pedantic"} (drop-while #(not= "-pedantic-errors" %) args)))))
        at! (fn [n msg]
              (let [o (get-in n [:range :begin :offset])]
                (when (and o (= main (get-in n [:range :begin :file])))
                  (let [[l c] (line-col starts (long o))]
                    (.add out {:line l :col c :kind :error :rule :fallthrough :msg msg})))))
        loops #{"DoStmt" "WhileStmt" "ForStmt" "CXXForRangeStmt"}
        ;; the fallthrough statement `x` with its ancestors `anc` (innermost first) up to the function's body
        judge (fn [x anc]
                (if-not (some #(= "SwitchStmt" (:kind %)) anc)
                  (when-not (some #(= "LambdaExpr" (:kind %)) anc)
                    (at! x "invalid use of attribute 'fallthrough' (no enclosing switch statement)"))
                  (when (and pe? (not (some #(#{"LambdaExpr" "CXXTryStmt" "CXXCatchStmt" "StmtExpr"} (:kind %)) (take-while #(not= "SwitchStmt" (:kind %)) anc))))
                    (loop [cur x [p & more] anc]
                      (when p
                        (case (:kind p)
                          "CompoundStmt" (let [ks (:inner p)
                                               i (long (or (first (keep-indexed (fn [i k] (when (identical? k cur) i)) ks)) -1))
                                               nxt (when (>= i 0) (get ks (inc i)))]
                                           (cond (neg? i) nil
                                                 nxt nil ; a statement after it: a case label is the right one, another not judged
                                                 (= "SwitchStmt" (:kind (first more))) (at! x "attribute 'fallthrough' not preceding a case label or default label (the switch's last statement)")
                                                 :else (recur p more)))
                          ("IfStmt" "CaseStmt" "DefaultStmt" "LabelStmt" "AttributedStmt") (recur p more)
                          ("DoStmt" "WhileStmt" "ForStmt" "CXXForRangeStmt")
                          (at! x "attribute 'fallthrough' not preceding a case label or default label (an iteration statement's last statement)")
                          nil))))))
        walk (fn w [x anc]
               (cond
                 (sequential? x) (doseq [y x] (w y anc))
                 (not (map? x)) nil
                 (fallthrough-stmt? x src) (judge x anc)
                 (#{"CXXRecordDecl" "FunctionDecl" "CXXMethodDecl" "FunctionTemplateDecl" "ClassTemplateDecl"} (:kind x)) nil
                 :else (when (vector? (:inner x)) (doseq [y (:inner x)] (w y (cons x anc))))))
        fn! (fn [f]
              (when (and (= "FunctionDecl" (:kind f)) (not (:inline f)) (not (:constexpr f)) (not (:consteval f))
                         (nil? (:storageClass f)) (= main (get-in f [:range :begin :file])))
                (when-let [b (last (filter #(= "CompoundStmt" (:kind %)) (:inner f)))]
                  ;; (a body with a construct the parser declined is not judged)
                  (when-not (some #(and (map? %) (= "NativeDecline" (:kind %))) (tree-seq #(or (map? %) (vector? %)) #(if (map? %) (:inner %) (seq %)) b))
                    (doseq [y (:inner b)] (walk y (list b)))))))
        top (fn t [ns]
              (doseq [n ns]
                (case (and (= main (get-in n [:range :begin :file])) (:kind n))
                  "FunctionDecl" (fn! n)
                  "LinkageSpecDecl" (t (:inner n))
                  "NamespaceDecl" (when (seq (str (:name n))) (t (:inner n)))
                  nil)))]
    (top (:nodes u))
    (vec out)))

(swap! checks conj fallthroughs)

;; ---------------------------------------------------------------------------------------------
;; cpp-diag-a (2026-11-22; the burst's stream on C++'s independence, doc/cpp/CPP-SURVEY.md, "As built: cpp-diag-a"): rules
;; restated from the C++ standard (N4950 and the C++26 draft's wording where named) and the GCC 15.2 manual for GCC's wording;
;; no GCC code read.

;; Coroutines ([dcl.fct.def.coroutine], [expr.await], [expr.yield], [stmt.return.coroutine]):
;; - [expr.await]/2: an await-expression (co_yield's too, [expr.yield]/1 being co_await of yield_value) appears only in a
;;   function body: one in a namespace-scope variable's initializer is "'co_await' cannot be used outside a function"; nor in a
;;   handler ("await expressions are not permitted in handlers"), nor in an unevaluated operand (sizeof, decltype: "'co_await'
;;   cannot be used in an unevaluated context");
;; - [dcl.spec.auto.general]/4 (a coroutine's return type is never deduced: [dcl.fct.def.coroutine]/1's note): a co_ operator in a
;;   function or lambda whose declared return type is a placeholder with no trailing return type, "'co_await' cannot be used in a
;;   function with a deduced return type", at the operator;
;; - [stmt.return]/1 with [stmt.return.coroutine]: a coroutine has no return statement ("a 'return' statement is not allowed in
;;   coroutine; did you mean 'co_return'?", at the function's name, as GCC places it);
;; - [dcl.fct.def.coroutine]/3-/12: the promise type, coroutine_traits<R, P...>::promise_type (an explicit specialization the
;;   unit gives for R with no other argument, else R::promise_type, [coroutine.traits.primary]), must declare initial_suspend,
;;   final_suspend and get_return_object (/5, /7), unhandled_exception when exceptions are enabled (/5), return_void for a
;;   co_return with no operand and return_value for one with a non-void operand ([stmt.return.coroutine]/2), yield_value for a
;;   co_yield ([expr.yield]/1), and not both return_void and return_value (/6): "no member named 'X' in 'P'" (GCC's places:
;;   the function's name, final_suspend at the body's closing brace, return_value or return_void at the co_return, yield_value at
;;   the co_yield), "the coroutine promise type 'P' declares both 'return_value' and 'return_void'". Judged only when the
;;   promise class is resolved: a complete class of the unit, no bases, no using-declaration, the function no template's and
;;   no member function (whose traits take the object parameter), no partial specialization of coroutine_traits in the unit.

(defn- co-word ^String [c] (case (:kind c) "CoawaitExpr" "co_await" "CoyieldExpr" "co_yield" "co_return"))

(defn- co-nodes
  "Every co_ node of a function body `x` with its ancestors' kinds (innermost first), not looking into lambdas, local classes
  or nested functions."
  [x]
  (let [out (java.util.ArrayList.)]
    ((fn w [x anc]
       (cond
         (map? x) (cond (co-kinds (:kind x)) (do (.add out [x anc]) (w (:inner x) (cons x anc)))
                        (or (= "LambdaExpr" (:kind x)) (#{"CXXRecordDecl" "ClassTemplateDecl" "FunctionTemplateDecl"} (:kind x)) (fn-kinds (:kind x))) nil
                        :else (doseq [[k v] x :when (and (not= k :_ent) (not= k :_t) (coll? v))] (w v (if (:kind x) (cons x anc) anc))))
         (or (vector? x) (seq? x)) (doseq [y x] (w y anc))
         :else nil))
     x ())
    (vec out)))

(defn- returns-in
  "The return statements of a function body `x`, not looking into lambdas, local classes or nested functions."
  [x]
  (let [out (java.util.ArrayList.)]
    ((fn w [x]
       (cond
         (map? x) (cond (= "ReturnStmt" (:kind x)) (.add out x)
                        (or (= "LambdaExpr" (:kind x)) (#{"CXXRecordDecl" "ClassTemplateDecl" "FunctionTemplateDecl"} (:kind x)) (fn-kinds (:kind x))) nil
                        :else (doseq [[k v] x :when (and (not= k :_ent) (not= k :_t) (coll? v))] (w v)))
         (or (vector? x) (seq? x)) (doseq [y x] (w y))
         :else nil))
     x)
    (vec out)))

(defn- deduced-ret? [^String qt]
  (boolean (and (re-find #"^(?:const\s+)?(?:auto|decltype\(auto\))\s*\(" qt)
                (not (re-find #"\)\s*(?:const\s*|volatile\s*|&{1,2}\s*|noexcept(?:\([^()]*\))?\s*)*->" qt)))))

(defn coroutine-rules
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        at! (fn [off msg]
              (when off
                (let [[l c] (line-col starts (long off))]
                  (.add out {:line l :col c :kind :error :rule :coroutine :msg msg}))))
        mine? (fn [n] (= main (or (get-in n [:range :begin :file]) (get-in n [:range :begin :expansionLoc :file]))))
        begin (fn [n] (when (mine? n) (get-in n [:range :begin :offset])))
        classes (java.util.HashMap.)
        specs (java.util.ArrayList.)
        partial? (volatile! false)
        _ ((fn ns-walk [nodes prefix]
             (doseq [n nodes]
               (case (:kind n)
                 "NamespaceDecl" (ns-walk (:inner n) (if (and (= "std" (:name n)) (= "" prefix)) "std::" (str prefix (when (:name n) (str (:name n) "::")))))
                 "LinkageSpecDecl" (ns-walk (:inner n) prefix)
                 "CXXRecordDecl" (when (and (:name n) (:completeDefinition n) (not (str/starts-with? prefix "std::")))
                                   (let [q (str prefix (:name n))]
                                     (.put classes q (if (.containsKey classes q) :ambiguous n))
                                     (ns-walk (:inner n) (str q "::"))))
                 "ClassTemplateSpecializationDecl" (when (= "coroutine_traits" (:name n)) (.add specs n))
                 "ClassTemplatePartialSpecializationDecl" (when (= "coroutine_traits" (:name n)) (vreset! partial? true))
                 nil)))
           (:nodes u) "")
        cls (fn [^String q] (let [q (str/replace (str/replace q #"^(?:struct|class)\s+" "") #"\s+" "")
                                  q (str/replace q #"^::" "")
                                  c (.get classes q)]
                              (when (map? c) c)))
        promise-in (fn [c]
                     (when (and c (empty? (:bases c)))
                       (some (fn [m] (case (:kind m)
                                       "CXXRecordDecl" (when (and (= "promise_type" (:name m)) (:completeDefinition m)) m)
                                       ("TypeAliasDecl" "TypedefDecl") (when (= "promise_type" (:name m)) (or (cls (str (get-in m [:type :qualType]))) :unknown))
                                       nil))
                             (:inner c))))
        promise-of (fn [^String r method?]
                     (let [r (str/trim r)
                           mine (filter (fn [s] (= (str/replace (str (get-in (first (:inner s)) [:type :qualType])) #"^::" "") r)) specs)]
                       (cond
                         @partial? nil
                         ;; (a member function's traits take its object parameter: judged only with R's primary traits)
                         (and (seq mine) method?) nil
                         (seq mine) (when (= 1 (count mine))
                                      (let [s (first mine) targs (filter #(= "TemplateArgument" (:kind %)) (:inner s))]
                                        (when (and (= 2 (count targs)) (:isPack (second targs)))
                                          (promise-in (assoc s :bases [])))))
                         :else (promise-in (cls r)))))
        no-exc? (some #{"-fno-exceptions"} (:args u))
        names-of (fn [p] (set (keep :name (:inner p))))
        literal-like #{"IntegerLiteral" "FloatingLiteral" "StringLiteral" "CharacterLiteral" "CXXBoolLiteralExpr" "InitListExpr" "UnaryOperator" "BinaryOperator"}
        coroutine! (fn [f b lambda?]
                     (let [cos (co-nodes b)
                           qt (str (if lambda? (get-in f [:inner 0 :inner 0 :type :qualType]) (get-in f [:type :qualType])))]
                       (when (seq cos)
                         (let [[c] (first cos)]
                           (cond
                             (deduced-ret? qt)
                             (at! (begin c) (str "'" (co-word c) "' cannot be used in a function with a deduced return type"))
                             ;; (no coroutine at all, [dcl.fct.def.coroutine]/4: coroutines' "cannot be used in a constructor", ...)
                             (and (not lambda?)
                                  (or (#{"CXXConstructorDecl" "CXXDestructorDecl"} (:kind f)) (and (= "FunctionDecl" (:kind f)) (= "main" (:name f)))
                                      (:constexpr f) (:consteval f) (re-find #"\.\.\.\)" qt)))
                             nil
                             :else
                             (do
                               (doseq [r (returns-in b)]
                                 (at! (or (get-in f [:loc :offset]) (begin f)) "a 'return' statement is not allowed in coroutine; did you mean 'co_return'?")
                                 r)
                               (doseq [[c anc] cos]
                                 (when (and (#{"CoawaitExpr" "CoyieldExpr"} (:kind c)) (some #(= "CXXCatchStmt" (:kind %)) anc))
                                   (at! (begin c) (str (if (= "CoyieldExpr" (:kind c)) "yield" "await") " expressions are not permitted in handlers")))
                                 (when (and (#{"CoawaitExpr" "CoyieldExpr"} (:kind c))
                                            (some #(and (= "UnaryExprOrTypeTraitExpr" (:kind %)) (#{"sizeof" "alignof"} (:name %))) anc))
                                   (at! (begin c) (str "'" (co-word c) "' cannot be used in an unevaluated context"))))
                               (when (and (not lambda?) (fn-kinds (:kind f)) (mine? f))
                                 (when-let [[_ r] (re-find #"^([^()]+?)\s*\(" qt)]
                                   (let [p (promise-of r (= "CXXMethodDecl" (:kind f)))]
                                     (when (and (map? p) (not (some #(#{"UsingDecl" "UsingShadowDecl"} (:kind %)) (:inner p))))
                                       (let [ms (names-of p)
                                             n-before (.size out)
                                             pn (str (:name p))
                                             name-off (or (get-in f [:loc :offset]) (begin f))
                                             miss (fn [m] (str "no member named '" m "' in '" pn "'"))]
                                         ;; ([expr.await]/3: with no await_transform in the promise, a co_await's operand of a class type
                                         ;; with no operator co_await is its awaiter, and a co_yield's awaiter promise.yield_value(e)'s
                                         ;; result; the awaiter has await_ready, await_suspend and await_resume, and await_suspend returns
                                         ;; void, bool or a coroutine handle ([expr.await]/3.7): "no member named 'await_ready' in 'A'",
                                         ;; "'await_suspend' must return 'void', 'bool' or a coroutine handle", at the operator)
                                         (when-not (ms "await_transform")
                                           (let [outer (str/replace (str r) #"\s+" "")
                                                 awaiter! (fn [c ^String tn]
                                                            (let [tn (str/replace (str/trim tn) #"^(?:struct|class)\s+" "")
                                                                  a (or (cls tn) (cls (str outer "::" tn)))]
                                                              (when (and (map? a) (empty? (:bases a)) (not (some #(= "operator co_await" (:name %)) (:inner a)))
                                                                         (not (some #(#{"UsingDecl" "UsingShadowDecl"} (:kind %)) (:inner a))))
                                                                (let [an (set (keep :name (:inner a)))]
                                                                  (doseq [m ["await_ready" "await_suspend" "await_resume"] :when (not (an m))]
                                                                    (at! (begin c) (str "no member named '" m "' in '" tn "'")))
                                                                  (let [sus (filter #(and (= "await_suspend" (:name %)) (= "CXXMethodDecl" (:kind %))) (:inner a))]
                                                                    (when (= 1 (count sus))
                                                                      (let [rt (str/trim (or (second (re-find #"^(.*?)\s*\(" (str (get-in (first sus) [:type :qualType])))) ""))]
                                                                        (when-not (or (str/blank? rt) (re-matches #"(?:const\s+)?(?:void|bool)" rt) (re-find #"coroutine_handle|\bauto\b|decltype" rt))
                                                                          (at! (begin c) "'await_suspend' must return 'void', 'bool' or a coroutine handle")))))))))]
                                             (doseq [[c] cos]
                                               (case (:kind c)
                                                 "CoawaitExpr" (let [e (first (:inner c))]
                                                                 (when (#{"CXXFunctionalCastExpr" "CXXTemporaryObjectExpr" "CXXConstructExpr"} (:kind e))
                                                                   (awaiter! c (str (get-in e [:type :qualType])))))
                                                 "CoyieldExpr" (let [ys (filter #(and (= "yield_value" (:name %)) (= "CXXMethodDecl" (:kind %))) (:inner p))]
                                                                 (when (= 1 (count ys))
                                                                   (when-let [[_ rt] (re-find #"^([A-Za-z_][\w:]*)\s*\(" (str (get-in (first ys) [:type :qualType])))]
                                                                     (if (= "auto" rt)
                                                                       ;; (a deduced return type: its one return statement's class prvalue)
                                                                       (let [rs (returns-in (some #(when (= "CompoundStmt" (:kind %)) %) (:inner (first ys))))
                                                                             e (first (:inner (first rs)))]
                                                                         (when (and (= 1 (count rs)) (#{"CXXFunctionalCastExpr" "CXXTemporaryObjectExpr"} (:kind e)))
                                                                           (awaiter! c (str (get-in e [:type :qualType])))))
                                                                       (awaiter! c rt)))))
                                                 nil))))
                                         ;; (GCC checks the promise's other members after the body, and not when the body had an error)
                                         (when (= n-before (.size out))
                                         (when-not (ms "initial_suspend") (at! name-off (miss "initial_suspend")))
                                         (when-not (ms "final_suspend") (at! (get-in b [:range :end :offset]) (miss "final_suspend")))
                                         (when-not (ms "get_return_object") (at! name-off (miss "get_return_object")))
                                         (when (and (not no-exc?) (not (ms "unhandled_exception"))) (at! name-off (miss "unhandled_exception")))
                                         ;; ([dcl.fct.def.coroutine]/9-11: the promise's own operator new is called with the frame's size
                                         ;; (a function with no parameter: no other form), its operator delete with (void*) or (void*,
                                         ;; size_t); a get_return_object_on_allocation_failure is static, and asks a nothrow operator new
                                         ;; (a promise's, noexcept) and std::nothrow: "'operator new' is provided by 'P' but is not usable
                                         ;; with the function signature 'f'", "no suitable 'operator delete' for 'P'", "cannot call member
                                         ;; function 'P::get_return_object_on_allocation_failure()' without object", "... but 'operator new'
                                         ;; is not marked 'throw()' or 'noexcept'", "... but 'std::nothrow' cannot be found")
                                         (let [mem (fn [nm] (filter #(and (= nm (:name %)) (= "CXXMethodDecl" (:kind %))) (:inner p)))
                                               pts (fn [m] (filter #(= "ParmVarDecl" (:kind %)) (:inner m)))
                                               size-t? (fn [t] (boolean (re-matches #"(?:std::)?(?:__)?size_t|unsigned long(?: int)?" (str/trim (str t)))))
                                               news (mem "operator new") dels (mem "operator delete")
                                               fparams (filter #(= "ParmVarDecl" (:kind %)) (:inner f))
                                               gro (mem "get_return_object_on_allocation_failure")]
                                           (when (and (seq news) (empty? fparams)
                                                      (not-any? (fn [m] (let [ps (vec (pts m))]
                                                                          (and (seq ps) (size-t? (get-in (ps 0) [:type :qualType]))
                                                                               (every? :init (rest ps)))))
                                                                news))
                                             (at! name-off (str "'operator new' is provided by '" pn "' but is not usable with the function signature")))
                                           (when (and (seq dels)
                                                      (not-any? (fn [m] (let [ps (vec (map #(str/replace (str (get-in % [:type :qualType])) #"\s+" "") (pts m)))]
                                                                          (or (= ps ["void*"]) (and (= 2 (count ps)) (= "void*" (ps 0)) (size-t? (ps 1))))))
                                                                dels))
                                             (at! name-off (str "no suitable 'operator delete' for '" pn "'")))
                                           (when (seq gro)
                                             (cond (not-any? #(= "static" (:storageClass %)) gro)
                                                   (at! name-off (str "cannot call member function '" pn "::get_return_object_on_allocation_failure()' without object"))
                                                   (and (seq news) (not-any? #(re-find #"noexcept|throw\(\)" (str (get-in % [:type :qualType]))) news))
                                                   (at! name-off (str "'" pn "::get_return_object_on_allocation_failure()' is provided by '" pn "' but 'operator new' is not marked 'throw()' or 'noexcept'"))
                                                   (not (some (fn [ns] (and (= "NamespaceDecl" (:kind ns)) (= "std" (:name ns))
                                                                            (some #(and (= "VarDecl" (:kind %)) (= "nothrow" (:name %))) (:inner ns))))
                                                              (:nodes u)))
                                                   (at! name-off (str "'" pn "::get_return_object_on_allocation_failure()' is provided by '" pn "' but 'std::nothrow' cannot be found"))
                                                   :else nil))))
                                         (if (and (ms "return_value") (ms "return_void"))
                                           (at! name-off (str "the coroutine promise type '" pn "' declares both 'return_value' and 'return_void'"))
                                           (doseq [[c] cos]
                                             (case (:kind c)
                                               "CoreturnStmt" (let [e (first (:inner c))]
                                                                (cond (nil? e) (when-not (ms "return_void") (at! (begin c) (miss "return_void")))
                                                                      (literal-like (:kind e)) (when-not (ms "return_value") (at! (begin c) (miss "return_value")))
                                                                      :else nil))
                                               "CoyieldExpr" (when-not (ms "yield_value") (at! (begin c) (miss "yield_value")))
                                               nil))))))))))))))
        walk (fn w [nodes tmpl?]
               (doseq [n nodes]
                 (let [k (:kind n)]
                   (cond
                     (#{"FunctionTemplateDecl" "ClassTemplateDecl" "ClassTemplatePartialSpecializationDecl" "VarTemplateDecl"} k) (w (:inner n) true)
                     (fn-kinds k) (when-let [b (some #(when (= "CompoundStmt" (:kind %)) %) (:inner n))]
                                    (when (mine? n) (if tmpl? (when-let [[c] (first (co-nodes b))] (when (deduced-ret? (str (get-in n [:type :qualType]))) (at! (begin c) (str "'" (co-word c) "' cannot be used in a function with a deduced return type")))) (coroutine! n b false)))
                                    (w (:inner b) tmpl?))
                     (= "LambdaExpr" k) (when-let [b (some #(when (= "CompoundStmt" (:kind %)) %) (:inner n))]
                                          (when (mine? n) (when-let [[c] (first (co-nodes b))]
                                                            (when (deduced-ret? (str (get-in n [:inner 0 :inner 0 :type :qualType])))
                                                              (at! (begin c) (str "'" (co-word c) "' cannot be used in a function with a deduced return type")))))
                                          (w (:inner b) tmpl?))
                     (#{"NamespaceDecl" "LinkageSpecDecl" "CXXRecordDecl" "ClassTemplateSpecializationDecl"} k) (w (:inner n) (or tmpl? (and (= "CXXRecordDecl" k) false)))
                     (#{"VarDecl" "DeclStmt"} k)
                     (do (when (and (= "VarDecl" k) (mine? n) (re-find #"decltype\s*\(\s*co_(?:await|yield)\b" (str (get-in n [:type :qualType]))))
                           (at! (begin n) (str "'" (second (re-find #"(co_await|co_yield)" (str (get-in n [:type :qualType])))) "' cannot be used in an unevaluated context")))
                         (w (:inner n) tmpl?))
                     :else (when (vector? (:inner n)) (w (:inner n) tmpl?))))))]
    ;; namespace-scope initializers
    ((fn top [nodes]
       (doseq [n nodes]
         (case (:kind n)
           ("NamespaceDecl" "LinkageSpecDecl") (top (:inner n))
           "VarDecl" (when-let [[c] (first (co-nodes (:inner n)))]
                       (when (#{"CoawaitExpr" "CoyieldExpr"} (:kind c))
                         (at! (begin c) (str "'" (co-word c) "' cannot be used outside a function"))))
           nil)))
     (:nodes u))
    (walk (:nodes u) false)
    (vec (distinct out))))

(swap! checks conj coroutine-rules)

;; GCC's coroutine interface (the GCC 15.2 manual's -fcoroutines with [coroutine.handle]'s members, which a coroutine's lowering
;; calls: std::coroutine_handle<void>::address, a non-static member function, and std::coroutine_handle<P>::from_address, a static
;; one, [coroutine.handle.export.import]): a std::coroutine_handle the main file declares itself whose coroutine_handle<void> (its
;; explicit specialization, else the primary template) has no member address ("'address' is not a member of
;; 'std::coroutine_handle<void>'") or another kind of one ("'std::coroutine_handle<void>::address' must be a non-overloaded
;; method"), or whose primary template has no from_address or another kind of one, at a coroutine's first co_ operator
;; (coroutines/pr105475*.C; an explicit specialization's from_address is coroutine-handle-interface's).

(defn coroutine-handle-members
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        std-items (for [ns (:nodes u) :when (and (= "NamespaceDecl" (:kind ns)) (= "std" (:name ns)) (= main (get-in ns [:range :begin :file])))
                        r (:inner ns)] r)
        primary (some (fn [t] (when (and (= "ClassTemplateDecl" (:kind t)) (= "coroutine_handle" (:name t)))
                                (some #(when (and (= "CXXRecordDecl" (:kind %)) (:completeDefinition %)) %) (:inner t))))
                      std-items)
        void-spec (some (fn [r] (when (and (= "ClassTemplateSpecializationDecl" (:kind r)) (= "coroutine_handle" (:name r))
                                           (= "void" (some #(when (= "TemplateArgument" (:kind %)) (str/trim (str (get-in % [:type :qualType])))) (:inner r))))
                                  r))
                        std-items)
        hv (or void-spec primary)
        members (fn [r nm] (filter #(= nm (:name %)) (:inner r)))
        addr (when hv (let [ms (members hv "address")]
                        (cond (empty? ms) "'address' is not a member of 'std::coroutine_handle<void>'"
                              (not (and (= 1 (count ms)) (= "CXXMethodDecl" (:kind (first ms))) (not= "static" (:storageClass (first ms)))))
                              "'std::coroutine_handle<void>::address' must be a non-overloaded method")))
        from (when primary (let [ms (members primary "from_address")]
                             (cond (empty? ms) "'from_address' is not a member of 'std::coroutine_handle<promise_type>'"
                                   (not (and (= 1 (count ms)) (= "CXXMethodDecl" (:kind (first ms))) (= "static" (:storageClass (first ms)))))
                                   "'std::coroutine_handle<promise_type>::from_address' must be a non-overloaded static function")))]
    (when (or addr from)
      (walk-nodes (fn [f _]
                    (when (and (fn-kinds (:kind f)) (= main (get-in f [:range :begin :file])))
                      (when-let [b (some #(when (= "CompoundStmt" (:kind %)) %) (:inner f))]
                        (when-let [[c] (first (co-nodes b))]
                          (when-let [o (get-in c [:range :begin :offset])]
                            (let [[l col] (line-col starts (long o))]
                              (doseq [m [addr from] :when m]
                                (.add out {:line l :col col :kind :error :rule :coroutine :msg m}))))))))
                  (:nodes u) nil))
    (vec out)))

(swap! checks conj coroutine-handle-members)

;; Explicit object parameters (C++23, P0847R7: [dcl.fct]/6, [class.mfct.non.static], [over.match.funcs.general], [class.virtual]/7,
;; [expr.prim.lambda.closure]/5, [expr.prim.req.general]/4, [expr.prim.this]/2):
;; - only the first parameter of a member function's (or lambda's) parameter list may be one ("only the first parameter of a member
;;   function can be declared as an explicit object parameter"), and none of a requires-expression's ("'this' specifier in a
;;   requires-expression parameter"), of a function type's or of a non-member function ("a function type cannot have an explicit
;;   object parameter", the parser's error for the latter);
;; - it has no default argument ("an explicit object parameter may not have a default argument") and is no function parameter pack
;;   ("an explicit object parameter cannot be a function parameter pack");
;; - its member function is neither static nor virtual ("an explicit object member function cannot be 'static'", "... 'virtual'"),
;;   overrides no virtual function of a base ("explicit object member function overrides virtual function"; a base's virtual
;;   function of that name and the other parameters' count), and has no cv-qualifier or ref-qualifier ("explicit object member
;;   function 'f' cannot have cv-qualifier", "... ref-qualifier"); a destructor has no parameter ("destructors may not have
;;   parameters"); a non-virtual one marked override or final ([class.virtual]/5: "marked 'override', but does not override",
;;   "marked 'final', but is not virtual") when it overrides nothing;
;; - a lambda with one is neither mutable nor static ("'mutable' lambda specifier with explicit object parameter", "'static' ...");
;; - its body has no `this` ("'this' is unavailable for explicit object member functions"), local classes' members aside.

(defn- fn-tail-quals
  "The qualifiers after a function type's parameter list (`void (S) const &` -> \"const &\"), nil when not found."
  [^String qt]
  (let [n (count qt)
        open (loop [i 0 depth 0]
               (when (< i n)
                 (let [c (.charAt qt i)]
                   (cond (and (= c \() (zero? depth)
                              (not (re-find #"(?:decltype|typeof|__typeof__|noexcept|alignas|sizeof)\s*$" (subs qt 0 i)))) i
                         (#{\< \(} c) (recur (inc i) (inc depth))
                         (#{\> \)} c) (recur (inc i) (max 0 (dec depth)))
                         :else (recur (inc i) depth)))))]
    (when open
      (let [close (loop [i (inc open) depth 1]
                    (when (< i n)
                      (let [c (.charAt qt i)]
                        (cond (= c \() (recur (inc i) (inc depth))
                              (= c \)) (if (= 1 depth) i (recur (inc i) (dec depth)))
                              :else (recur (inc i) depth)))))]
        (when close
          (str/trim (str/replace (subs qt (inc close)) #"(?:noexcept|throw)\b.*$|->.*$" "")))))))

(defn explicit-object-params
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        mine? (fn [n] (= main (get-in n [:range :begin :file])))
        at! (fn [n msg]
              (when-let [o (when (mine? n) (or (get-in n [:loc :offset]) (get-in n [:range :begin :offset])))]
                (let [[l c] (line-col starts (long o))]
                  (.add out {:line l :col c :kind :error :rule :explicit-object :msg msg}))))
        text (fn [n] (let [b (get-in n [:range :begin :offset]) e (get-in n [:range :end :offset]) l (get-in n [:range :end :tokLen])]
                       (when (and b e (mine? n) (<= (long b) (+ (long e) (long (or l 0)))) (<= (+ (long e) (long (or l 0))) (count src)))
                         (subs src (long b) (+ (long e) (long (or l 0)))))))
        classes (java.util.HashMap.)
        _ (walk-nodes (fn [n _] (when (and (= "CXXRecordDecl" (:kind n)) (:name n) (:completeDefinition n))
                                  (.put classes (:name n) (if (.containsKey classes (:name n)) :ambiguous n))))
                      (:nodes u) nil)
        params (fn [m] (filter #(= "ParmVarDecl" (:kind %)) (:inner m)))
        base-virtual (fn bv [cls nm nparams seen]
                       (some (fn [b] (let [bn (str/replace (str/trim (str (get-in b [:type :qualType]))) #"^(?:struct|class)\s+" "")
                                           c (.get classes bn)]
                                       (when (and (map? c) (not (contains? seen bn)))
                                         (or (some #(and (= nm (:name %)) (= "CXXMethodDecl" (:kind %)) (:virtual %)
                                                         (= nparams (count (remove :isExplicitObjectParameter (params %)))))
                                                   (:inner c))
                                             (bv c nm nparams (conj seen bn))))))
                             (:bases cls)))
        this-in (fn [b] (let [acc (java.util.ArrayList.)]
                          ((fn w [x] (cond (map? x) (cond (= "CXXThisExpr" (:kind x)) (.add acc x)
                                                          (#{"CXXRecordDecl" "ClassTemplateDecl"} (:kind x)) nil
                                                          :else (doseq [[k v] x :when (and (not= k :_ent) (not= k :_t) (coll? v))] (w v)))
                                           (or (vector? x) (seq? x)) (doseq [y x] (w y))))
                           b)
                          (vec acc)))
        method! (fn [cls m]
                  (let [ps (vec (params m))
                        xs (filter :isExplicitObjectParameter ps)]
                    (when (seq xs)
                      ;; (C++23's: before it GCC's error "explicit object member function only available with '-std=c++23'")
                      ;; (cpp-decl2: a pedwarn of -Wc++23-extensions, so -Wno-error=c++23-extensions or -Wno-c++23-extensions
                      ;; makes it no error: cpp2a/concepts-memfun4.C)
                      (when (and (< (long (cxx-year (:std u))) 23)
                                 (not (some #{"-Wno-error=c++23-extensions" "-Wno-c++23-extensions"} (:args u))))
                        (at! (first xs) "explicit object member function only available with '-std=c++23' or '-std=gnu++23'"))
                      (doseq [p (rest ps) :when (:isExplicitObjectParameter p)]
                        (at! p "only the first parameter of a member function can be declared as an explicit object parameter"))
                      (doseq [p xs]
                        (when (:init p) (at! p "an explicit object parameter may not have a default argument"))
                        (when (str/ends-with? (str/trim (str (get-in p [:type :qualType]))) "...")
                          (at! p "an explicit object parameter cannot be a function parameter pack")))
                      (when (:isExplicitObjectParameter (first ps))
                        (let [qt (str (get-in m [:type :qualType]))
                              q (or (fn-tail-quals qt) "")
                              ^String t (or (text m) "")
                              ;; the declarator's text after its parameter list, before the body or the end
                              tail (let [i (.lastIndexOf t ")" (int (let [j (.indexOf t "{")] (if (neg? j) (count t) j))))] (if (neg? i) "" (subs t (inc i))))
                              ov (re-find #"\boverride\b" (str/replace tail #"\{.*" ""))
                              fi (re-find #"\bfinal\b" (str/replace tail #"\{.*" ""))]
                          (case (:kind m)
                            "CXXDestructorDecl" (at! m "destructors may not have parameters")
                            nil)
                          (when (= "static" (:storageClass m)) (at! m "an explicit object member function cannot be 'static'"))
                          ;; ([dcl.fct.def.default]/2: an explicitly defaulted copy or move assignment returns a reference to its class
                          ;; and takes its non-object parameter by reference: "defaulted 'operator=' ...")
                          (when (and (= "operator=" (:name m)) (:explicitlyDefaulted m) cls (= 2 (count ps)))
                            (let [rt (str/replace (str/trim (or (second (re-find #"^(.*?)\s*\(" qt)) "")) #"\s+" "")
                                  pt (str/replace (str (get-in (second ps) [:type :qualType])) #"\s+" "")]
                              (when (or (not= rt (str (:name cls) "&")) (not (str/ends-with? pt "&")))
                                (at! m (str "explicitly defaulted 'operator=' of '" (:name cls) "' has an invalid signature")))))
                          ;; (an allocation or deallocation function is a static member, [class.free]/1)
                          (when (re-matches #"operator\s*(?:new|delete)\s*(?:\[\])?" (str (:name m)))
                            (at! m (str "'" (:name m) "' cannot be an explicit object member function (it is implicitly static)")))
                          (when (:virtual m) (at! m "an explicit object member function cannot be 'virtual'"))
                          (when (re-find #"\b(?:const|volatile)\b" q) (at! m (str "explicit object member function '" (:name m) "' cannot have cv-qualifier")))
                          (when (re-find #"&" q) (at! m (str "explicit object member function '" (:name m) "' cannot have ref-qualifier")))
                          (when (and (= "CXXMethodDecl" (:kind m)) cls)
                            (if (base-virtual cls (:name m) (dec (count ps)) #{})
                              (at! m "explicit object member function overrides virtual function")
                              (when-not (:virtual m)
                                (cond ov (at! m (str "'" (:name m) "' marked 'override', but does not override"))
                                      fi (at! m (str "'" (:name m) "' marked 'final', but is not virtual"))))))
                          (when-let [b (some #(when (= "CompoundStmt" (:kind %)) %) (:inner m))]
                            (doseq [x (take 1 (this-in b))]
                              (at! x "'this' is unavailable for explicit object member functions"))))))))]
    (walk-nodes (fn [n parent]
                  (case (:kind n)
                    ("CXXMethodDecl" "CXXDestructorDecl" "CXXConstructorDecl" "CXXConversionDecl")
                    (when (mine? n) (method! (when (= "CXXRecordDecl" (:kind parent)) parent) n))
                    "FunctionDecl" (when (and (mine? n) (:isExplicitObjectParameter (first (params n))) (not (str/includes? (str (text n)) "::")))
                                     (at! n "a non-member function cannot have an explicit object parameter"))
                    "RequiresExpr" (doseq [p (:params n) :when (:isExplicitObjectParameter p)]
                                     (at! p "'this' specifier in a requires-expression parameter"))
                    ("TypeAliasDecl" "TypedefDecl" "FieldDecl" "VarDecl")
                    (when-let [t (text n)]
                      (when (re-find #"[(,]\s*this\s+[A-Za-z_:]" (if (#{"FieldDecl" "VarDecl"} (:kind n)) (str/replace t #"(?s)[={\[].*" "") (str/replace t #"(?s)[{\[].*" "")))
                        (at! n "a function type cannot have an explicit object parameter")))
                    "LambdaExpr" (when-let [t (text n)]
                                   (let [b (some #(when (= "CompoundStmt" (:kind %)) %) (:inner n))
                                         bo (get-in b [:range :begin :offset])
                                         head (if (and bo (mine? b)) (subs src (long (get-in n [:range :begin :offset])) (long bo)) t)]
                                     (when (re-find #"\(\s*this\b" head)
                                       (when-let [[_ w] (re-find #"\)\s*(?:[^()]*\s)?\b(mutable|static)\b" head)]
                                         (at! n (str "'" w "' lambda specifier with explicit object parameter"))))))
                    nil))
                (:nodes u) nil)
    (vec (distinct out))))

(swap! checks conj explicit-object-params)

;; [basic.scope.scope]/4 and [over.load]/1 with explicit object parameters (C++23): two member function declarations of a class with
;; the same name, the same non-object parameter-type-list and both templates or neither correspond, so cannot be overloaded, when
;; one is static, or when both are non-static with corresponding object parameters: exactly one an implicit object member function
;; with no ref-qualifier and the object parameters' types the same after removing references, or the types the same (an implicit
;; object member function's object parameter "cv X&", "cv X&&" with &&). Judged when one of the two has an explicit object parameter,
;; whose type names the class unless the other is static (GCC's "'g' cannot be overloaded with 'f'", at the later one).

(defn- obj-type-key
  "A parameter type's [base cv ref] (`S const&` -> [\"S\" #{\"const\"} \"&\"]), the base's spaces dropped."
  [^String t]
  (let [t (str/trim t)
        ref (cond (str/ends-with? t "&&") "&&" (str/ends-with? t "&") "&" :else nil)
        cv (set (re-seq #"\b(?:const|volatile)\b" t))
        base (-> t (str/replace #"\b(?:const|volatile|struct|class)\b" "") (str/replace #"[&\s]" ""))]
    [base cv ref]))

(defn xobj-overloads
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        mine? (fn [n] (= main (get-in n [:range :begin :file])))
        norm (fn [^String t] (-> t (str/replace #"\s+" " ") str/trim))]
    (walk-nodes
     (fn [c _]
       (when (and (= "CXXRecordDecl" (:kind c)) (:completeDefinition c) (:name c) (mine? c))
         (let [cn (:name c)
               ms (vec (keep (fn [m]
                               (let [[f tmpl] (cond (= "CXXMethodDecl" (:kind m)) [m false]
                                                    (= "FunctionTemplateDecl" (:kind m)) [(some #(when (= "CXXMethodDecl" (:kind %)) %) (:inner m)) true]
                                                    :else nil)]
                                 (when f
                                   (let [ps (filter #(= "ParmVarDecl" (:kind %)) (:inner f))
                                         xo (when (:isExplicitObjectParameter (first ps)) (first ps))
                                         q (or (fn-tail-quals (str (get-in f [:type :qualType]))) "")]
                                     {:f f :name (:name f) :tmpl tmpl :static (= "static" (:storageClass f))
                                      :xo xo :others (mapv #(norm (str (get-in % [:type :qualType]))) (if xo (rest ps) ps))
                                      :obj (cond xo (obj-type-key (str (get-in xo [:type :qualType])))
                                                 :else [cn (set (re-seq #"\b(?:const|volatile)\b" q)) (if (str/includes? q "&&") "&&" "&")])
                                      :noref (and (not xo) (not (str/includes? q "&")))}))))
                             (:inner c)))]
           (doseq [j (range (count ms)) i (range j)
                   :let [a (ms i) b (ms j)]
                   :when (and (= (:name a) (:name b)) (= (:tmpl a) (:tmpl b)) (= (:others a) (:others b))
                              (or (:xo a) (:xo b))
                              (or (:static a) (:static b) (some #(= cn (first (:obj %))) (filter :xo [a b]))))]
             (let [corr (cond (or (:static a) (:static b)) true
                              (not= (boolean (:noref a)) (boolean (:noref b)))
                              (= (vec (take 2 (:obj a))) (vec (take 2 (:obj b))))
                              :else (= (:obj a) (:obj b)))]
               (when (and corr (mine? (:f b)))
                 (when-let [o (or (get-in b [:f :loc :offset]) (get-in b [:f :range :begin :offset]))]
                   (let [[l col] (line-col starts (long o))]
                     (.add out {:line l :col col :kind :error :rule :explicit-object
                                :msg (str "'" (:name b) "' cannot be overloaded with '" (:name a) "'")})))))))))
     (:nodes u) nil)
    (vec (distinct out))))

(swap! checks conj xobj-overloads)

;; GCC's __builtin_source_location (which std::source_location::current calls, [support.srcloc.cons]): it returns a pointer to a
;; constant std::source_location::__impl, so (as its diagnostics in the dg tests state) the unit must declare std::source_location as
;; a class ("'source_location' is not a member of 'std'", "'void std::source_location()' is not a type", "'std::source_location' is
;; not a class type") whose member __impl is a class ("'__impl' is not a member of 'std::source_location'", "... is not a type", "...
;; is not a class type") with only the non-static data members _M_file_name and _M_function_name of type const char * and _M_line and
;; _M_column of an integral type ("'std::source_location::__impl' does not contain only non-static data members '_M_file_name',
;; '_M_function_name', '_M_line' and '_M_column'", "... does not have 'const char *' type", "... does not have integral type"), at
;; the call (cpp2a/srcloc*.C).

(defn builtin-source-location
  [u starts ^String src ^String main]
  (let [calls (let [acc (java.util.ArrayList.)]
                (walk-nodes (fn [n _] (when (and (#{"CallExpr" "BuiltinExpr"} (:kind n)) (= main (get-in n [:range :begin :file])))
                                        (let [o (long (or (get-in n [:range :begin :offset]) -1))]
                                          (when (and (>= o 0) (.startsWith src "__builtin_source_location" (int o)))
                                            (.add acc n)))))
                            (:nodes u) nil)
                (vec acc))]
    (when (seq calls)
      (let [std-items (for [ns (:nodes u) :when (and (= "NamespaceDecl" (:kind ns)) (= "std" (:name ns)))
                            r ((fn flat [xs] (mapcat #(if (and (= "NamespaceDecl" (:kind %)) (:isInline %)) (flat (:inner %)) [%]) xs)) (:inner ns))] r)
            sl (filter #(= "source_location" (:name %)) std-items)
            cls (some #(when (and (= "CXXRecordDecl" (:kind %)) (:completeDefinition %)) %) sl)
            integral #"^(?:(?:unsigned|signed|short|long|int|char|char8_t|char16_t|char32_t|wchar_t|bool|__int128)\s*)+$"
            msg (cond
                  cls (let [im (filter #(= "__impl" (:name %)) (:inner cls))
                            ic (some #(when (and (= "CXXRecordDecl" (:kind %)) (:completeDefinition %)) %) im)]
                        (cond
                          ic (let [fs (filter #(= "FieldDecl" (:kind %)) (:inner ic))
                                   nm (set (map :name fs))
                                   want #{"_M_file_name" "_M_function_name" "_M_line" "_M_column"}
                                   ty (fn [n] (str/trim (str (get-in (first (filter #(= n (:name %)) fs)) [:type :qualType]))))]
                               (cond
                                 (or (not= nm want) (not= (count fs) 4))
                                 "'std::source_location::__impl' does not contain only non-static data members '_M_file_name', '_M_function_name', '_M_line' and '_M_column'"
                                 (not (re-matches #"const char\s*\*" (ty "_M_file_name"))) "'std::source_location::__impl::_M_file_name' does not have 'const char *' type"
                                 (not (re-matches #"const char\s*\*" (ty "_M_function_name"))) "'std::source_location::__impl::_M_function_name' does not have 'const char *' type"
                                 (not (re-matches integral (ty "_M_line"))) "'std::source_location::__impl::_M_line' does not have integral type"
                                 (not (re-matches integral (ty "_M_column"))) "'std::source_location::__impl::_M_column' does not have integral type"
                                 :else nil))
                          (some #(fn-kinds (:kind %)) im) "'std::source_location::__impl()' is not a type"
                          (some #(#{"TypedefDecl" "TypeAliasDecl"} (:kind %)) im) "'std::source_location::__impl' is not a class type"
                          (empty? im) "'__impl' is not a member of 'std::source_location'"
                          :else nil))
                  (some #(fn-kinds (:kind %)) sl) "'void std::source_location()' is not a type"
                  (some #(#{"TypedefDecl" "TypeAliasDecl"} (:kind %)) sl) "'std::source_location' is not a class type"
                  (empty? sl) "'source_location' is not a member of 'std'"
                  :else nil)]
        (when msg
          (vec (for [c calls :let [o (get-in c [:range :begin :offset])] :when o
                     :let [[l col] (line-col starts (long o))]]
                 {:line l :col col :kind :error :rule :source-location :msg msg})))))))

(swap! checks conj builtin-source-location)

;; constinit and consteval where no declaration may have them ([dcl.constinit]/1: constinit only on a variable of static or thread
;; storage duration; [dcl.constexpr]/1-2: consteval only on a function or function template, not a destructor, nor an allocation
;; or deallocation function, [basic.start.main]/3 not main; [dcl.spec.general]/2: at most one of constexpr, consteval and
;; constinit; [dcl.typedef]/1: none with typedef; [dcl.type.elab]: none on a type's declaration; [dcl.fct]/3: none on a parameter,
;; [temp.param]/2 nor a template parameter), each at the declaration in GCC's words ("'constinit' on function return type is not
;; allowed", "'constinit' specifier invalid for function", "non-static data member 'm' declared 'constinit'", "a parameter cannot
;; be declared 'constinit'", "'constinit' can only be applied to a variable with static or thread storage duration", "'constinit'
;; cannot appear in a typedef declaration", "'constinit' cannot be used for type declarations", "can use at most one of the
;; 'constinit' and 'constexpr' specifiers", "a variable cannot be declared 'consteval'", "static data member 'w' declared
;; 'consteval'", "structured binding declaration cannot be 'consteval'", "a destructor cannot be 'consteval'", "'operator new'
;; cannot be 'consteval'", "cannot declare '::main' to be 'consteval'", "both 'constexpr' and 'consteval' specified"). The
;; decl-specifiers are read off the source between a declaration's start and its name.

(defn constinit-consteval-specs
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        mine? (fn [n] (= main (get-in n [:range :begin :file])))
        at! (fn [n msg]
              (when-let [o (when (mine? n) (or (get-in n [:loc :offset]) (get-in n [:range :begin :offset])))]
                (let [[l c] (line-col starts (long o))]
                  (.add out {:line l :col c :kind :error :rule :decl-spec :msg msg}))))
        n-src (count src)
        ;; (the decl-specifier's own place, where GCC reports these: the keyword in the declaration's specifiers)
        kw-at! (fn [n ^String w msg]
                 (let [b (get-in n [:range :begin :offset]) e (get-in n [:loc :offset])
                       i (when (and b e (< (long b) (long e) n-src)) (let [m (re-matcher (re-pattern (str "\\b" w "\\b")) (subs src (long b) (long e)))] (when (.find m) (+ (long b) (.start m)))))]
                   (if (and i (mine? n))
                     (let [[l c] (line-col starts (long i))] (.add out {:line l :col c :kind :error :rule :decl-spec :msg msg}))
                     (at! n msg))))
        fn-aliases (set (for [n (:nodes u) :when (and (#{"TypedefDecl" "TypeAliasDecl"} (:kind n)) (:name n))
                              :let [t (str (get-in n [:type :qualType]))]
                              :when (and (re-find #"\)\s*(?:const|volatile|&|noexcept)?\s*$" t) (not (re-find #"\(\s*[*&]" t)))]
                          (:name n)))
        specs (fn [n] (let [b (get-in n [:range :begin :offset]) e (get-in n [:loc :offset])]
                        (when (and b e (mine? n) (= main (get-in n [:loc :file] main)) (< (long b) (long e) n-src))
                          (set (re-seq #"\b(?:constinit|consteval|constexpr|static|extern|thread_local|typedef)\b"
                                       (str/replace (subs src (long b) (long e)) #"(?s)\(.*" ""))))))
        prefix (fn [n] (let [b (get-in n [:range :begin :offset])]
                         (when (and b (mine? n))
                           (let [t (subs src (max 0 (- (long b) 200)) (long b))
                                 t (last (str/split t #"[;{}]" -1))]
                             (set (re-seq #"\b(?:constinit|consteval)\b" (or t "")))))))
        both! (fn [n ss]
                (when (and (ss "constexpr") (ss "constinit")) (at! n "can use at most one of the 'constinit' and 'constexpr' specifiers"))
                (when (and (ss "constexpr") (ss "consteval")) (at! n "both 'constexpr' and 'consteval' specified"))
                (when (and (ss "consteval") (ss "constinit")) (at! n "can use at most one of the 'constinit' and 'consteval' specifiers")))
        walk (fn w [nodes ctx]
               (doseq [n nodes :when (map? n)]
                 (let [k (:kind n)
                       ss (when (#{"FunctionDecl" "CXXMethodDecl" "CXXConstructorDecl" "CXXDestructorDecl" "CXXConversionDecl" "VarDecl"
                                   "FieldDecl" "ParmVarDecl" "NonTypeTemplateParmDecl" "TypedefDecl" "DecompositionDecl"} k)
                            (specs n))]
                   (when (seq ss) (both! n ss))
                   (case k
                     ("FunctionDecl" "CXXMethodDecl" "CXXConstructorDecl" "CXXDestructorDecl" "CXXConversionDecl")
                     (do (when (and ss (ss "constinit"))
                           (let [after (let [o (long (get-in n [:loc :offset]))] (subs src o (min n-src (+ o 200))))]
                             (kw-at! n "constinit" (if (or (#{"CXXConstructorDecl" "CXXDestructorDecl"} k) (re-find #"^~?[A-Za-z_]\w*\s*\(" after))
                                      "'constinit' on function return type is not allowed"
                                      "'constinit' specifier invalid for function"))))
                         (when (and ss (ss "consteval"))
                           (cond (= "CXXDestructorDecl" k) (at! n "a destructor cannot be 'consteval'")
                                 (re-matches #"operator\s*(?:new|delete)\s*(?:\[\])?" (str (:name n)))
                                 (at! n (str "'" (str/replace (str (:name n)) #"\[\]" " []") "' cannot be 'consteval'"))
                                 (and (= "main" (:name n)) (= ctx :ns) (= "FunctionDecl" k)) (at! n "cannot declare '::main' to be 'consteval'")
                                 :else nil))
                         (doseq [c (:inner n) :when (= "ParmVarDecl" (:kind c))] (w [c] :param))
                         (doseq [c (:inner n) :when (= "CompoundStmt" (:kind c))] (w (:inner c) :local)))
                     "VarDecl" (do (when ss
                                     (when (and (ss "constinit") (fn-aliases (str/trim (str (get-in n [:type :qualType])))))
                                       (kw-at! n "constinit" "'constinit' specifier invalid for function"))
                                     (when (and (ss "constinit") (= ctx :local) (not (or (ss "static") (ss "extern") (ss "thread_local"))))
                                       (at! n "'constinit' can only be applied to a variable with static or thread storage duration"))
                                     (when (ss "consteval")
                                       (at! n (if (= ctx :class) (str "static data member '" (:name n) "' declared 'consteval'") "a variable cannot be declared 'consteval'"))))
                                   (w (:inner n) (if (= ctx :class) :ns ctx)))
                     "DecompositionDecl" (when ss
                                           (when (and (ss "constinit") (= ctx :local) (not (or (ss "static") (ss "extern") (ss "thread_local"))))
                                             (at! n "'constinit' can only be applied to a variable with static or thread storage duration"))
                                           (when (ss "consteval") (at! n "structured binding declaration cannot be 'consteval'")))
                     "FieldDecl" (when ss (doseq [w ["constinit" "consteval"] :when (ss w)] (at! n (str "non-static data member '" (:name n) "' declared '" w "'"))))
                     ("ParmVarDecl" "NonTypeTemplateParmDecl") (when ss (doseq [w ["constinit" "consteval"] :when (ss w)] (at! n (str "a parameter cannot be declared '" w "'"))))
                     "TypedefDecl" (when ss (doseq [w ["constinit" "consteval" "constexpr"] :when (ss w)] (at! n (str "'" w "' cannot appear in a typedef declaration"))))
                     ("CXXRecordDecl" "EnumDecl")
                     (do (when (and (:completeDefinition n) (not (:isImplicit n)) (#{:ns :local :class} ctx))
                           (doseq [w (prefix n)] (at! n (str "'" w "' cannot be used for type declarations"))))
                         (w (:inner n) :class))
                     ("NamespaceDecl" "LinkageSpecDecl") (w (:inner n) :ns)
                     ("FunctionTemplateDecl" "ClassTemplateDecl" "ClassTemplatePartialSpecializationDecl" "ClassTemplateSpecializationDecl" "VarTemplateDecl")
                     (w (:inner n) ctx)
                     ("CompoundStmt" "DeclStmt" "IfStmt" "ForStmt" "WhileStmt" "DoStmt" "SwitchStmt" "CXXForRangeStmt" "CaseStmt" "DefaultStmt" "LabelStmt" "AttributedStmt" "CXXTryStmt" "CXXCatchStmt")
                     (w (:inner n) ctx)
                     nil))))]
    (walk (:nodes u) :ns)
    (vec (distinct out))))

(swap! checks conj constinit-consteval-specs)

;; [expr.const]/16-18 (C++23, P2564; GCC applies it in C++20 too): a potentially-evaluated id-expression naming an immediate (consteval)
;; function that is not the function of an immediate invocation is immediate-escalating, so may appear only in an immediate function
;; context (a consteval function's body, an `if consteval`'s compound statement) or an immediate-escalating function (a lambda's call
;; operator, a constexpr function template's specialization, a defaulted special member): elsewhere -- a namespace-scope or static
;; variable's initializer, a non-template function that is not consteval -- taking its address is ill-formed ("taking address of an
;; immediate function 'consteval int f()'", "constant evaluation returns address of immediate function" for a constexpr variable's).
;; Judged for the unit's consteval functions of a name no other function of the unit has (a member as Class::name), not in a
;; template, lambda, unevaluated operand, default argument or default member initializer; there too an immediate invocation whose
;; argument reads a variable not usable in constant expressions.

(defn immediate-addresses
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        ce (java.util.HashMap.)
        ;; escalating functions ([expr.const]/18: a constexpr function template's specialization, an abbreviated one's): name -> body
        esc-cands (java.util.HashMap.)
        _ ((fn coll [nodes cls tmpl?]
             (doseq [n nodes :when (map? n)]
               (case (:kind n)
                 ("FunctionDecl" "CXXMethodDecl")
                 (do (doseq [k (cond-> [(:name n)] cls (conj (str cls "::" (:name n))))]
                       (.put ce k (and (not (identical? false (.get ce k))) (boolean (:_consteval n)))))
                     (when (and (:constexpr n) (not (:_consteval n)) (nil? cls)
                                (or tmpl? (some #(and (= "ParmVarDecl" (:kind %)) (re-find #"\bauto\b" (str (get-in % [:type :qualType])))) (:inner n))))
                       (when-let [b (some #(when (= "CompoundStmt" (:kind %)) %) (:inner n))]
                         (.put esc-cands (:name n) [n b]))))
                 "FunctionTemplateDecl" (coll (:inner n) cls true)
                 ("CXXRecordDecl" "ClassTemplateDecl") (coll (:inner n) (or (when (= "CXXRecordDecl" (:kind n)) (:name n)) cls) false)
                 ("NamespaceDecl" "LinkageSpecDecl") (coll (:inner n) nil false)
                 nil)))
           (:nodes u) nil false)
        escalated (java.util.HashSet.)
        imm? (fn [d] (let [nm (str (get-in d [:referencedDecl :name]))
                           q (:qualifier d)
                           k (if (seq q) (str (str/join "::" q) "::" nm) nm)]
                       (and (= :fn (get-in d [:_ent :k]))
                            (or (and (true? (.get ce k)) (not (:tmpl (:_ent d))))
                                (and (empty? q) (.contains escalated nm))))))
        ;; an argument reading a variable not usable in constant expressions ([expr.const]/5.9): a parameter (no declaration
        ;; point in the parser's entity) or a non-const variable of a fundamental type, not under & or an unevaluated operand
        reads-var? (fn rv [x]
                     (cond (map? x) (case (:kind x)
                                      "DeclRefExpr" (let [e (:_ent x)]
                                                      (and (= :var (:k e)) (not (:enumerator e)) (not (:constexpr e)) (not (:tparam e))
                                                           (or (nil? (:vat e))
                                                               (and (= :b (get-in e [:ty :t])) (not (get-in e [:ty :c]))))))
                                      ("UnaryExprOrTypeTraitExpr" "CXXNoexceptExpr" "CXXTypeidExpr" "LambdaExpr") false
                                      "UnaryOperator" (if (= "&" (:opcode x)) false (some rv (:inner x)))
                                      (boolean (some (fn [[k v]] (and (not= k :_ent) (not= k :_t) (coll? v) (rv v))) x)))
                           (sequential? x) (boolean (some rv x))
                           :else false))
        ;; the walk of an evaluated region outside an immediate function context: (hit! node kind constexpr?) at an immediate
        ;; function's address (:addr) and an immediate invocation that is no constant expression (:call)
        expr (fn ex [x constexpr? hit!]
               (cond
                 (map? x) (let [k (:kind x)]
                            (cond
                              (= "DeclRefExpr" k) (when (imm? x) (hit! x :addr constexpr?))
                              (#{"LambdaExpr" "UnaryExprOrTypeTraitExpr" "CXXNoexceptExpr" "CXXTypeidExpr" "RequiresExpr" "ConceptSpecializationExpr"
                                 "CXXRecordDecl" "ClassTemplateDecl" "FunctionTemplateDecl" "StmtExpr"} k) nil
                              (fn-kinds k) nil
                              ;; (`if consteval`'s compound statement is an immediate function context, its else branch not; `if !consteval`
                              ;; the other way round)
                              (and (= "IfStmt" k) (:isConsteval x))
                              (if (:isNegatedConsteval x) (ex (first (:inner x)) constexpr? hit!) (ex (second (:inner x)) constexpr? hit!))
                              (#{"CallExpr" "CXXMemberCallExpr" "CXXOperatorCallExpr"} k)
                              (let [[f & args] (:inner x)]
                                (when-not (= "DeclRefExpr" (:kind f)) (ex f constexpr? hit!))
                                ;; (an immediate invocation, [expr.const]/16, is a constant expression: an argument that reads a
                                ;; variable not usable in constant expressions for a parameter of a non-reference type makes it none:
                                ;; "call to consteval function 'f(x)' is not a constant expression", at the call)
                                (when (and (= "DeclRefExpr" (:kind f)) (imm? f))
                                  (let [ptys (get-in f [:_ent :ptys])]
                                    (when (some (fn [[i a]] (and (reads-var? a) (not (#{:r :rr :lref :rref} (:t (nth ptys i nil)))) (not= :ref (:t (nth ptys i nil)))
                                                                 (or (= :b (:t (nth ptys i nil))) (.contains escalated (str (get-in f [:referencedDecl :name]))))))
                                                (map-indexed vector args))
                                      (hit! x :call constexpr?))))
                                (doseq [a args] (ex a constexpr? hit!)))
                              (= "VarDecl" k) (ex (:inner x) (boolean (:constexpr x)) hit!)
                              (= "ParmVarDecl" k) nil
                              :else (doseq [[kk v] x :when (and (not= kk :_ent) (not= kk :_t) (coll? v))] (ex v constexpr? hit!))))
                 (or (vector? x) (seq? x)) (doseq [y x] (ex y constexpr? hit!))
                 :else nil))
        ;; P2564's escalation: a candidate whose body has an immediate-escalating expression is an immediate function (to a fixpoint)
        _ (loop [i 0]
            (let [before (.size escalated)]
              (doseq [[nm [_ b]] esc-cands :when (not (.contains escalated nm))]
                (let [hit (volatile! false)]
                  (expr b false (fn [_ _ _] (vreset! hit true)))
                  (when @hit (.add escalated nm))))
              (when (and (< i 4) (> (.size escalated) before)) (recur (inc i)))))
        report! (fn [d kind constexpr?]
                  (when-let [o (get-in d [:range :begin :offset])]
                    (when (= main (get-in d [:range :begin :file]))
                      (let [[l c] (line-col starts (long o))
                            nm (if (= kind :call) (get-in (first (:inner d)) [:referencedDecl :name]) (get-in d [:referencedDecl :name]))]
                        (.add out {:line l :col c :kind :error :rule :immediate
                                   :msg (case kind
                                          :call (str "call to consteval function '" nm "(...)' is not a constant expression")
                                          (if constexpr? (str "constant evaluation returns address of immediate function '" nm "'")
                                              (str "taking address of an immediate function '" nm "'")))})))))
        decls (fn dw [nodes]
                (doseq [n nodes :when (map? n)]
                  (case (:kind n)
                    ("NamespaceDecl" "LinkageSpecDecl") (dw (:inner n))
                    "CXXRecordDecl" (dw (filter #(not= "FieldDecl" (:kind %)) (:inner n)))
                    "VarDecl" (expr n false report!)
                    ("FunctionDecl" "CXXMethodDecl" "CXXConstructorDecl" "CXXDestructorDecl" "CXXConversionDecl")
                    (when-not (or (:_consteval n) (:explicitlyDefaulted n)
                                  ;; (an abbreviated function template's, [dcl.fct]/22: a parameter of a placeholder type)
                                  (some #(and (= "ParmVarDecl" (:kind %)) (re-find #"\bauto\b" (str (get-in % [:type :qualType])))) (:inner n)))
                      (doseq [c (:inner n) :when (#{"CompoundStmt" "CXXCtorInitializer" "CXXTryStmt"} (:kind c))] (expr c false report!)))
                    nil)))]
    (decls (:nodes u))
    (vec (distinct out))))

(swap! checks conj immediate-addresses)

;; cpp-sweep: [expr.prim.this]/2-3, `this` appears only within a non-static member function's declaration after its
;; cv-qualifier-seq (its trailing return type, its noexcept-specifier) or body, or a default member initializer: in a static member
;; function's or a friend function's declarator GCC's "'this' may not be used in this context", at it (cpp0x/this1.C). The main file's
;; class members as written, the text from the declarator's name to the body (or the declaration's end), outside comments.
(defn static-this
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        n-src (count src)
        check! (fn [n]
                 (let [b (get-in n [:loc :offset])
                       body (some #(when (= "CompoundStmt" (:kind %)) %) (:inner n))
                       e (or (get-in body [:range :begin :offset]) (some-> (get-in n [:range :end :offset]) long inc))]
                   (when (and b e (= main (get-in n [:loc :file] main)) (= main (get-in n [:range :begin :file] main)) (< (long b) (long e) n-src))
                     (let [t (subs src (long b) (long e))
                           t (str/replace t #"//[^\n]*|/\*(?s:.*?)\*/" (fn [m] (apply str (repeat (count m) \space))))
                           m (re-matcher #"\bthis\b" t)]
                       (when (.find m)
                         (let [[l c] (line-col starts (+ (long b) (.start m)))]
                           (.add out {:line l :col c :kind :error :rule :this :msg "'this' may not be used in this context"})))))))
        walk (fn w [nodes]
               (doseq [n nodes :when (map? n)]
                 (case (:kind n)
                   ("NamespaceDecl" "LinkageSpecDecl" "ClassTemplateDecl") (w (:inner n))
                   "CXXRecordDecl" (doseq [m (:inner n)]
                                     (case (:kind m)
                                       "CXXMethodDecl" (when (= "static" (:storageClass m)) (check! m))
                                       "FunctionTemplateDecl" (doseq [f (:inner m) :when (and (= "CXXMethodDecl" (:kind f)) (= "static" (:storageClass f)))] (check! f))
                                       "FriendDecl" (doseq [f (:inner m) :when (#{"FunctionDecl" "CXXMethodDecl"} (:kind f))] (check! f))
                                       "CXXRecordDecl" (w [m])
                                       nil))
                   nil)))]
    (walk (remove :_hdr (:nodes u)))
    (vec (distinct out))))

(swap! checks conj static-this)

;; cpp-sweep: [namespace.memdef]/3 with [basic.scope.declarative]/5, a friend class declaration with an unqualified name declares
;; it in the innermost enclosing namespace: there a namespace of that name is GCC's "'template<...> class N' redeclared as different
;; kind of entity", at the befriending class's opening brace (parse/pr81247-b.C; the namespace's own member template that names it,
;; pr81247-c.C, declares N::N, no error). The main file's classes and class templates at namespace scope.
(defn friend-namespace-clash
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        n-src (count src)
        friend-names (fn [r] (keep (fn [f] (when (= "FriendDecl" (:kind f))
                                             (some #(when (#{"ClassTemplateDecl" "CXXRecordDecl"} (:kind %)) (:name %)) (:inner f))))
                                   (:inner r)))
        walk (fn w [nodes]
               (let [nss (set (keep #(when (and (= "NamespaceDecl" (:kind %)) (string? (:name %))) (:name %)) nodes))]
                 (doseq [n nodes :when (map? n)]
                   (case (:kind n)
                     ("NamespaceDecl" "LinkageSpecDecl") (w (:inner n))
                     ("CXXRecordDecl" "ClassTemplateDecl")
                     (let [r (if (= "ClassTemplateDecl" (:kind n)) (some #(when (= "CXXRecordDecl" (:kind %)) %) (:inner n)) n)]
                       (when (and r (:completeDefinition r) (= main (get-in r [:loc :file] main)) (some nss (friend-names r)))
                         (when-let [o (get-in r [:loc :offset])]
                           (let [i (.indexOf src "{" (int o))]
                             (when (< -1 i n-src)
                               (let [[l c] (line-col starts i)]
                                 (.add out {:line l :col c :kind :error :rule :redecl :msg "friend class redeclared as different kind of entity (a namespace)"})))))))
                     nil))))]
    (walk (remove :_hdr (:nodes u)))
    (vec out)))

(swap! checks conj friend-namespace-clash)

;; cpp-sweep: [temp.mem]/1 with [temp.alias]/2, a member's out-of-class definition has one template header for each enclosing class
;; template its qualifier names: a qualifier through a member alias template whose type names none of the templates' parameters
;; (`B<T>::C<U>` of `template<class U> using C = A;`) denotes the class A, no template, so its headers are GCC's "too many
;; template-parameter-lists", at the declaration (cpp0x/alias-decl-42.C, cpp2a/concepts-pr59200.C). The main file's
;; namespace-scope variable definitions by the parser's header count (:_qtmpl), their qualifier read off the text.
(defn alias-qualified-headers
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        ;; class template name -> {member alias template name -> its aliased type text}
        aliases (into {} (for [n (:nodes u) :when (and (= "ClassTemplateDecl" (:kind n)) (string? (:name n)))
                               :let [r (some #(when (= "CXXRecordDecl" (:kind %)) %) (:inner n))
                                     tps (set (keep #(when (#{"TemplateTypeParmDecl" "NonTypeTemplateParmDecl"} (:kind %)) (:name %)) (:inner n)))]
                               :when r]
                           [(:name n) (into {} (for [a (:inner r) :when (= "TypeAliasTemplateDecl" (:kind a))
                                                     :let [own (set (keep #(when (#{"TemplateTypeParmDecl" "NonTypeTemplateParmDecl"} (:kind %)) (:name %)) (:inner a)))
                                                           t (some #(when (= "TypeAliasDecl" (:kind %)) (str (get-in % [:type :qualType]))) (:inner a))]
                                                     :when t]
                                                 [(:name a) (not (some (into tps own) (re-seq #"[A-Za-z_]\w*" t)))]))]))]
    (doseq [n (remove :_hdr (:nodes u))
            :when (and (= "VarDecl" (:kind n)) (pos? (long (or (:_qtmpl n) 0))) (= main (get-in n [:loc :file] main)))
            :let [b (get-in n [:range :begin :offset]) e (get-in n [:loc :offset])]
            :when (and b e (< (long b) (long e) (count src)))
            :let [t (subs src (long b) (long e))
                  m (re-find #"([A-Za-z_]\w*)\s*<[^<>]*>\s*::\s*([A-Za-z_]\w*)\s*<[^<>]*>\s*::\s*$" t)]
            :when (and m (true? (get-in aliases [(nth m 1) (nth m 2)])))]
      (let [[l c] (line-col starts (long e))]
        (.add out {:line l :col c :kind :error :rule :template :msg "too many template-parameter-lists"})))
    (vec out)))

(swap! checks conj alias-qualified-headers)

;; A constexpr (or consteval) function's body before C++23 ([dcl.constexpr]/3 of C++11 to C++20, P2242 lifting the last of it): no
;; definition of a variable of static or thread storage duration ("'b' defined 'static' in 'constexpr' function only available with
;; '-std=c++23'"), no goto statement ("'goto' in 'constexpr' function only available with '-std=c++23'"); before C++20 (P1002) no
;; try-block ("'try' in 'constexpr' function only available with '-std=c++20'") nor function-try-block ("function-try-block body of
;; 'constexpr' function only available with '-std=c++20'"; GCC's pedwarns, errors under -pedantic-errors) and no uninitialized
;; variable of a scalar type ("uninitialized variable 'a' in 'constexpr' function", the existing rule's in a function-try-block's
;; blocks); in C++11 a function-try-block is no return statement ("body of 'constexpr' function 'f' not a return-statement", at the
;; function's end) nor, with statements in its try-block, a constructor's empty body ("'constexpr' constructor does not have empty
;; body", at the try-block's end), and its compound statements are C++11's "compound-statement in 'constexpr' function" (a pedwarn).
;; The main file's functions outside templates, as constexpr-bodies judges them; lambdas and local classes not looked into.

(defn constexpr-pre23-bodies
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        year (long (cxx-year (:std u)))
        pe? (boolean (some #{"-pedantic-errors"} (:args u)))
        pw? (or pe? (boolean (some #{"-pedantic" "-Wpedantic"} (:args u))))
        at! (fn [n off msg]
              (when (and off (= main (or (get-in n [:range :begin :file]) main)))
                (let [[l c] (line-col starts (long off))]
                  (.add out {:line l :col c :kind :error :rule :constexpr :msg msg}))))
        beg (fn [n] (get-in n [:range :begin :offset]))
        walk (fn w [f x]
               (cond (map? x) (do (f x)
                                  (when-not (#{"LambdaExpr" "CXXRecordDecl" "ClassTemplateDecl" "FunctionTemplateDecl" "FunctionDecl" "CXXMethodDecl"} (:kind x))
                                    (doseq [[k v] x :when (and (not= k :_ent) (not= k :_t) (coll? v))] (w f v))))
                     (sequential? x) (doseq [y x] (w f y))
                     :else nil))
        fn! (fn [n]
              (let [what (if (:_consteval n) "consteval" "constexpr")
                    body (some #(when (#{"CompoundStmt" "CXXTryStmt"} (:kind %)) %) (:inner n))
                    ftb? (= "CXXTryStmt" (:kind body))
                    ctor? (= "CXXConstructorDecl" (:kind n))]
                (when (and body (= main (get-in n [:range :begin :file]))
                           (not (some #(= "NativeDecline" (:kind %)) (tree-seq #(or (map? %) (vector? %)) #(if (map? %) (:inner %) (seq %)) body))))
                  (when (< year 23)
                    (walk (fn [x]
                            (case (:kind x)
                              "VarDecl" (when (and (string? (:name x)) (or (= "static" (:storageClass x)) (:tls x)) (not= "extern" (:storageClass x)))
                                          (at! x (or (get-in x [:loc :offset]) (beg x))
                                               (str "'" (:name x) "' defined '" (if (:tls x) "thread_local" "static") "' in '" what "' function only available with '-std=c++23' or '-std=gnu++23'")))
                              "GotoStmt" (at! x (beg x) (str "'goto' in '" what "' function only available with '-std=c++23' or '-std=gnu++23'"))
                              nil))
                          body))
                  (when (< year 20)
                    (when (and ftb? pe?)
                      (at! body (beg body) (str "function-try-block body of '" what "' " (if ctor? "constructor" "function") " only available with '-std=c++20' or '-std=gnu++20'")))
                    (when pe?
                      (walk (fn [x] (when (and (= "CXXTryStmt" (:kind x)) (not (identical? x body)))
                                      (at! x (beg x) (str "'try' in '" what "' function only available with '-std=c++20' or '-std=gnu++20'"))))
                            body)
                      ;; (cpp-sweep: and an asm-declaration, P1668R1: GCC's pedwarn "'asm' in 'constexpr' function only available with
                      ;; '-std=c++20'", cpp1y/constexpr-neg1.C)
                      (walk (fn [x] (when (= "GCCAsmStmt" (:kind x))
                                      (at! x (beg x) (str "'asm' in '" what "' function only available with '-std=c++20' or '-std=gnu++20'"))))
                            body))
                    (when ftb?
                      (walk (fn [x]
                              (when (= "DeclStmt" (:kind x))
                                (doseq [v (:inner x)
                                        :when (and (= "VarDecl" (:kind v)) (nil? (:init v)) (empty? (:inner v)) (nil? (:storageClass v)) (not (:tls v))
                                                   (re-matches scalar-type-re (str/trim (str (get-in v [:type :qualType])))))]
                                  (at! v (or (get-in v [:loc :offset]) (beg v)) (str "uninitialized variable '" (:name v) "' in '" what "' function")))))
                            body)))
                  (when (= 11 year)
                    (when ftb?
                      (let [tb (first (:inner body))]
                        (if ctor?
                          (when (some #(not (#{"NullStmt"} (:kind %))) (:inner tb))
                            (at! tb (get-in tb [:range :end :offset]) "'constexpr' constructor does not have empty body"))
                          (at! body (get-in n [:range :end :offset]) (str "body of 'constexpr' function '" (:name n) "' not a return-statement")))))
                    (when (and pe? (or ftb? (some #(= "CXXTryStmt" (:kind %)) (:inner body))))
                      (walk (fn [x] (when (= "CXXTryStmt" (:kind x))
                                      (doseq [c (:inner x)
                                              :let [cs (if (= "CXXCatchStmt" (:kind c)) (some #(when (= "CompoundStmt" (:kind %)) %) (:inner c)) c)]
                                              :when (and (= "CompoundStmt" (:kind cs)) (not (and (identical? x body) (identical? c (first (:inner x))))))]
                                        (at! cs (beg cs) "compound-statement in 'constexpr' function"))))
                            body))))))
        decls (fn d [ns]
                (doseq [n ns]
                  (case (:kind n)
                    ("NamespaceDecl" "LinkageSpecDecl" "ExportDecl" "CXXRecordDecl") (d (:inner n))
                    ("FunctionDecl" "CXXMethodDecl" "CXXConstructorDecl" "CXXDestructorDecl")
                    (when (or (:constexpr n) (:_consteval n)) (fn! n))
                    nil)))]
    (decls (remove :_hdr (:nodes u)))
    (vec (distinct out))))

(swap! checks conj constexpr-pre23-bodies)

;; Later standards' constructs in an earlier standard's unit, GCC's pedwarns ("only available with '-std=c++NN'"), errors under
;; -pedantic-errors: a label at the end of a compound statement (C++23, P2324: "label at end of compound statement only available
;; with '-std=c++23'", at the closing brace), an alias-declaration as an init-statement (C++23, P2360: "alias-declaration in
;; init-statement only available with '-std=c++23'"), auto(x) and auto{x} (C++23, P0849: "'auto(x)' only available with
;; '-std=c++23'"), a lambda's template-parameter-list (C++20, P0428: "lambda templates are only available with '-std=c++20'").

(defn version-pedwarns
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        year (long (cxx-year (:std u)))
        args (:args u)
        pe? (and (some #{"-pedantic-errors"} args) (not (some #{"-Wno-pedantic"} (drop-while #(not= "-pedantic-errors" %) args))))
        at! (fn [n off msg]
              (when (and off (= main (get-in n [:range :begin :file])))
                (let [[l c] (line-col starts (long off))]
                  (.add out {:line l :col c :kind :error :rule :pedantic :msg msg}))))
        n-src (count src)]
    (when pe?
      (walk-nodes
       (fn [n _]
         (case (:kind n)
           "CompoundStmt" (when (< year 23)
                            (let [l (peek (vec (:inner n)))
                                  ;; (the labels' statement: none, or the parser's null statement at the brace, not a written `;`)
                                  end (loop [x l] (if (and (= "LabelStmt" (:kind x)) (= 1 (count (:inner x))) (= "LabelStmt" (:kind (first (:inner x))))) (recur (first (:inner x))) x))
                                  st (first (:inner end))]
                              (when (and (= "LabelStmt" (:kind l))
                                         (or (nil? st)
                                             (and (= "NullStmt" (:kind st))
                                                  (let [o (get-in st [:range :begin :offset])] (and o (< (long o) n-src) (not= 59 (int (.charAt src (int o)))))))))
                                (at! n (get-in n [:range :end :offset]) "label at end of compound statement only available with '-std=c++23' or '-std=gnu++23'"))))
           ("IfStmt" "SwitchStmt" "ForStmt" "CXXForRangeStmt")
           (when (< year 23)
             (let [i (first (:inner n))]
               (when (and (= "DeclStmt" (:kind i)) (some #(= "TypeAliasDecl" (:kind %)) (:inner i))
                          (or (#{"ForStmt" "CXXForRangeStmt"} (:kind n)) (:hasInit n)))
                 (at! n (get-in i [:range :begin :offset]) "alias-declaration in init-statement only available with '-std=c++23' or '-std=gnu++23'"))))
           "CXXFunctionalCastExpr" (when (and (< year 23) (= :auto (get-in n [:_t :t])))
                                     (let [o (get-in n [:range :begin :offset])]
                                       (when (and o (< (+ (long o) 4) n-src) (.startsWith src "auto" (int o)))
                                         (at! n o (str "'auto" (if (= "InitListExpr" (:kind (first (:inner n)))) "{x}" "(x)") "' only available with '-std=c++23' or '-std=gnu++23'")))))
           "LambdaExpr" (when (< year 20)
                          (let [o (get-in n [:range :begin :offset])]
                            (when (and o (= main (get-in n [:range :begin :file])))
                              ;; the lambda-introducer's closing bracket, then `<`
                              (let [t (subs src (long o) (min n-src (+ (long o) 400)))
                                    close (loop [i 0 depth 0]
                                            (when (< i (count t))
                                              (let [c (.charAt t i)]
                                                (cond (= c \[) (recur (inc i) (inc depth))
                                                      (= c \]) (if (= 1 depth) i (recur (inc i) (dec depth)))
                                                      :else (recur (inc i) depth)))))]
                                (when (and close (re-find #"^\s*<" (subs t (inc (long close)))))
                                  (at! n o "lambda templates are only available with '-std=c++20' or '-std=gnu++20'"))))))
           nil))
       (:nodes u) nil))
    (vec (distinct out))))

(swap! checks conj version-pedwarns)

;; [expr.prim.lambda.general]/4 (C++23, P1169): a lambda-specifier-seq has not both mutable and static ("'mutable' specifier conflicts
;; with 'static'", "'static' specifier conflicts with 'mutable'", at the later), and a static lambda has no lambda-capture ("'static'
;; lambda specifier with lambda capture"). Read off the lambda's text: its introducer, its parameter list's closing parenthesis, the
;; specifiers up to the body.

(defn lambda-specifiers
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        n-src (count src)
        at! (fn [off msg] (let [[l c] (line-col starts (long off))] (.add out {:line l :col c :kind :error :rule :lambda :msg msg})))
        match (fn [^String t i open close]
                (loop [i (long i) depth 0]
                  (when (< i (count t))
                    (let [c (.charAt t (int i))]
                      (cond (= (int c) (int open)) (recur (inc i) (inc depth))
                            (= (int c) (int close)) (if (= 1 depth) i (recur (inc i) (dec depth)))
                            :else (recur (inc i) depth))))))]
    (walk-nodes
     (fn [n _]
       (when (= "LambdaExpr" (:kind n))
         (let [o (get-in n [:range :begin :offset])
               b (some #(when (= "CompoundStmt" (:kind %)) %) (:inner n))
               bo (get-in b [:range :begin :offset])]
           (when (and o bo (= main (get-in n [:range :begin :file])) (= main (get-in b [:range :begin :file])) (< (long o) (long bo) n-src))
             (let [t (subs src (long o) (long bo))
                   ic (match t 0 \[ \])]
               ;; (cpp-diag-a: [expr.prim.lambda.capture]/2, a capture has one ellipsis, before an init-capture's name or after a
               ;; simple capture's: "too many '...' in lambda capture")
               (when (and ic (re-find #"(?:^|,)\s*&?\s*\.\.\.\s*[A-Za-z_]\w*\s*\.\.\." (subs t 1 (long ic))))
                 (at! (long o) "too many '...' in lambda capture"))
               (when ic
                 (let [rest-t (subs t (inc (long ic)))
                       po (.indexOf ^String rest-t "(")]
                   (when (and (>= po 0) (re-find #"^\s*(?:<[^{]*>\s*(?:requires[^(]*)?)?\($" (subs rest-t 0 (inc po))))
                     (when-let [pc (match rest-t po \( \))]
                       (let [base (+ (long o) (inc (long ic)) (inc (long pc)))
                             specs (subs rest-t (inc (long pc)))
                             m (re-matcher #"\b(mutable|static)\b" specs)
                             found (loop [acc []] (if (.find m) (recur (conj acc [(.group m 1) (.start m)])) acc))
                             kinds (map first found)]
                         (when (and (some #{"mutable"} kinds) (some #{"static"} kinds))
                           (let [[w off] (first (filter (fn [[w]] (not= w (first kinds))) found))]
                             (at! (+ base (long off)) (str "'" w "' specifier conflicts with '" (first kinds) "'"))))
                         (when (and (some #{"static"} kinds) (re-find #"\S" (subs t 1 (long ic))))
                           (at! (+ base (long (second (first (filter #(= "static" (first %)) found)))))
                                "'static' lambda specifier with lambda capture"))))))))))))
     (:nodes u) nil)
    (vec (distinct out))))

(swap! checks conj lambda-specifiers)

;; [over.sub]/1 before C++23 (P2128's multidimensional subscript): a class's operator[] has exactly one parameter beside its object
;; ("'int& S::operator[]()' must have exactly one argument", at the declaration; a static one's every parameter counted).

(defn subscript-arity
  [u starts ^String src ^String main]
  (when (< (long (cxx-year (:std u))) 23)
    (let [out (java.util.ArrayList.)]
      (walk-nodes (fn [n parent]
                    (when (and (= "CXXMethodDecl" (:kind n)) (re-matches #"operator\s*\[\]" (str (:name n)))
                               (= main (get-in n [:range :begin :file])) (#{"CXXRecordDecl"} (:kind parent)))
                      (let [ps (remove :isExplicitObjectParameter (filter #(= "ParmVarDecl" (:kind %)) (:inner n)))]
                        (when (and (not= 1 (count ps)) (not (:variadic n)))
                          (when-let [o (or (get-in n [:loc :offset]) (get-in n [:range :begin :offset]))]
                            (let [[l c] (line-col starts (long o))]
                              (.add out {:line l :col c :kind :error :rule :operator
                                         :msg (str "'" (:name n) "' must have exactly one argument")})))))))
                  (:nodes u) nil)
      (vec out))))

(swap! checks conj subscript-arity)

;; Defaulted comparison operator functions ([class.compare.default]/1-2, P2085, P2002): for a class C, a non-template member that is
;; const with one parameter of type const C& (beside its implicit object parameter, no && ref-qualifier: "defaulted member 'X' must
;; have parameter type 'const C&'", "defaulted 'X' must have exactly one parameter", "defaulted member 'X' must be 'const'",
;; "defaulted 'X' cannot have '&&' ref-qualifier"), or a friend of C with two parameters both const C& or both C ("defaulted 'X'
;; must have parameters of either type 'const C&' or 'C', not both"); defined at namespace scope only as a friend C declares ("defaulted
;; 'X' is not a friend of 'C'"); == and the secondary comparison operators return bool ([class.eq]/1, [class.compare.secondary]/1:
;; "defaulted 'X' must return 'bool'").

(defn defaulted-comparisons
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        ops #{"operator==" "operator!=" "operator<" "operator>" "operator<=" "operator>=" "operator<=>"}
        at! (fn [n msg]
              (when-let [o (when (= main (get-in n [:range :begin :file])) (or (get-in n [:loc :offset]) (get-in n [:range :begin :offset])))]
                (let [[l c] (line-col starts (long o))]
                  (.add out {:line l :col c :kind :error :rule :defaulted-comparison :msg msg}))))
        norm (fn [^String t] (-> t (str/replace #"\b(?:struct|class)\s+" "") (str/replace #"\s+" " ") (str/replace #" ?& ?" "&") str/trim))
        cls-of (fn [^String t] (-> (norm t) (str/replace #"^const " "") (str/replace #" const$" "") (str/replace #"&+$" "") (str/replace #"<.*>$" "") str/trim))
        is-c? (fn [^String t ^String c] (let [b (str/replace (norm t) #"<.*>" "")] (= b c)))
        cref? (fn [^String t ^String c] (let [x (str/replace (norm t) #"<.*>" "")] (or (= x (str "const " c "&")) (= x (str c " const&")))))
        ret-of (fn [^String qt] (str/trim (or (second (re-find #"^(.*?)\s*\(" qt)) "")))
        params (fn [f] (filter #(= "ParmVarDecl" (:kind %)) (:inner f)))
        bool-op? (fn [nm] (not= nm "operator<=>"))
        friend-sigs (java.util.HashMap.)
        classes (java.util.HashMap.)]
    ((fn coll [nodes prefix]
       (doseq [n nodes :when (map? n)]
         (case (:kind n)
           "NamespaceDecl" (coll (:inner n) (str prefix (:name n) "::"))
           "LinkageSpecDecl" (coll (:inner n) prefix)
           "CXXRecordDecl" (when (and (:name n) (:completeDefinition n))
                             (.put classes (str prefix (:name n)) n)
                             (doseq [fd (:inner n) :when (= "FriendDecl" (:kind fd)) f (:inner fd) :when (and (= "FunctionDecl" (:kind f)) (ops (:name f)))]
                               (.put friend-sigs [(str prefix (:name n)) (:name f) (mapv #(norm (str (get-in % [:type :qualType]))) (params f))] true)))
           nil)))
     (:nodes u) "")
    (letfn [(member! [c f]
              (let [nm (:name f) qt (str (get-in f [:type :qualType])) q (or (fn-tail-quals qt) "")
                    ps (vec (params f))
                    xo (some :isExplicitObjectParameter ps)]
                (when-not xo
                  (cond
                    (not= 1 (count ps)) (at! f (str "defaulted '" nm "' must have exactly one parameter"))
                    (not (cref? (str (get-in (first ps) [:type :qualType])) c)) (at! f (str "defaulted member '" nm "' must have parameter type 'const " c "&'"))
                    :else nil)
                  (when (str/includes? q "&&") (at! f (str "defaulted '" nm "' cannot have '&&' ref-qualifier")))
                  (when-not (re-find #"\bconst\b" q) (at! f (str "defaulted member '" nm "' must be 'const'"))))
                (when (and (bool-op? nm) (not (#{"bool" "auto"} (ret-of qt))) (not (str/blank? (ret-of qt))))
                  (at! f (str "defaulted '" nm "' must return 'bool'")))))
            (friend! [c f]
              (let [nm (:name f) qt (str (get-in f [:type :qualType]))
                    ts (mapv #(str (get-in % [:type :qualType])) (params f))]
                (when (= 2 (count ts))
                  (let [kinds (mapv #(cond (cref? % c) :cref (is-c? % c) :val :else :other) ts)]
                    (cond (some #{:other} kinds) (at! f (str "defaulted '" nm "' must have parameters of either type 'const " c "&' or '" c "'"))
                          (apply not= kinds) (at! f (str "defaulted '" nm "' must have parameters of either type 'const " c "&' or '" c "', not both 'const " c "&' and '" c "'"))
                          :else nil)))
                (when (and (bool-op? nm) (not (#{"bool" "auto"} (ret-of qt))) (not (str/blank? (ret-of qt))))
                  (at! f (str "defaulted '" nm "' must return 'bool'")))))
            (walk [nodes prefix]
              (doseq [n nodes :when (map? n)]
                (case (:kind n)
                  "NamespaceDecl" (walk (:inner n) (str prefix (:name n) "::"))
                  "LinkageSpecDecl" (walk (:inner n) prefix)
                  "ClassTemplateDecl" (walk (:inner n) prefix)
                  "CXXRecordDecl" (when (and (:name n) (:completeDefinition n))
                                    (doseq [m (:inner n)]
                                      (cond (and (= "CXXMethodDecl" (:kind m)) (:explicitlyDefaulted m) (ops (:name m))) (member! (:name n) m)
                                            (= "FriendDecl" (:kind m))
                                            (doseq [f (:inner m) :when (and (= "FunctionDecl" (:kind f)) (:explicitlyDefaulted f) (ops (:name f)))] (friend! (:name n) f))
                                            (= "CXXRecordDecl" (:kind m)) (walk [m] prefix)
                                            :else nil)))
                  "FunctionDecl" (when (and (:explicitlyDefaulted n) (ops (:name n)) (= main (get-in n [:range :begin :file])))
                                   (let [ps (params n)
                                         c (when (seq ps) (cls-of (str (get-in (first ps) [:type :qualType]))))
                                         sig (mapv #(norm (str (get-in % [:type :qualType]))) ps)]
                                     (when (and c (re-matches #"[A-Za-z_]\w*" c) (not (.get friend-sigs [(str prefix c) (:name n) sig])))
                                       (at! n (str "defaulted '" (:name n) "' is not a friend of '" c "'")))))
                  nil)))]
      (walk (:nodes u) ""))
    (vec (distinct out))))

(swap! checks conj defaulted-comparisons)

;; [dcl.struct.bind]/1 with [dcl.spec.auto.general]/2 (P1141): a structured binding declaration's decl-specifier-seq has the
;; placeholder `auto` alone, no type-constraint ("structured binding declaration cannot have constrained 'auto' type", at the
;; declaration; templates' too, GCC diagnosing their definitions).

(defn constrained-bindings
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        n-src (count src)
        ;; (GCC accepts it as an extension with a pedwarn, which -pedantic-errors makes an error: concepts-placeholder10.C)
        args (:args u)
        pe? (and (some #{"-pedantic-errors"} args) (not (some #{"-Wno-pedantic"} (drop-while #(not= "-pedantic-errors" %) args))))
        concepts (java.util.HashSet.)
        _ (walk-nodes (fn [n _] (when (and (= "ConceptDecl" (:kind n)) (:name n)) (.add concepts (:name n)))) (:nodes u) nil)]
    (walk-nodes (fn [n _]
                  (when (and pe? (= "DecompositionDecl" (:kind n)))
                    (let [b (get-in n [:range :begin :offset])]
                      (when (and b (= main (get-in n [:range :begin :file])))
                        (let [t (subs src (long b) (min n-src (+ (long b) 300)))
                              head (let [i (.indexOf ^String t "[")] (when (pos? i) (subs t 0 i)))]
                          ;; (the identifier before auto a concept the unit declares: a type-constraint, not a decl-specifier)
                          (when (and head (when-let [[_ c] (re-find #"([A-Za-z_]\w*)\s*(?:<[^\[]*>)?\s+auto\b\s*&{0,2}\s*$" (str/replace head #"\b(?:const|volatile|static|thread_local|inline|constexpr|constinit|extern)\b" ""))]
                                               (.contains concepts c)))
                            (let [[l c] (line-col starts (long b))]
                              (.add out {:line l :col c :kind :error :rule :structured-binding
                                         :msg "structured binding declaration cannot have constrained 'auto' type"}))))))))
                (:nodes u) nil)
    (vec out)))

(swap! checks conj constrained-bindings)

;; The built-in three-way comparison ([expr.spaceship]/2-8): with operands the check can type (literals, variables, enumerators, the
;; address of a function or member, a call's declared type), none of type std::nullptr_t ("ordered comparison of pointer with
;; 'std::nullptr_t'"), not a bool with another type, no array operand (no array-to-pointer conversion), no unscoped enumeration with a
;; floating type or another enumeration ([depr.arith.conv.enum] made ill-formed for <=>), no narrowing (a negative constant or a signed
;; variable against an unsigned operand), no pointer to function or member and no complex operand ("invalid operands of types 'A' and
;; 'B' to binary 'operator<=>'"); and an operand pair that is valid needs its comparison category type declared, a class
;; std::strong_ordering or std::partial_ordering ("'std::strong_ordering' is not defined", "... is not a type"; [cmp.categories]: the
;; header <compare>) whose value members are static data members ("'std::partial_ordering::equivalent()' is not a static data member").

(defn builtin-spaceship
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        enums (java.util.HashMap.) enum-types (java.util.HashSet.)
        std (java.util.HashMap.)
        _ (walk-nodes (fn [n _]
                        (when (and (= "EnumDecl" (:kind n)) (:name n) (not (:scopedEnumTag n)))
                          (.add enum-types (:name n))
                          (doseq [c (:inner n) :when (= "EnumConstantDecl" (:kind c))] (.put enums (:name c) (:name n)))))
                      (:nodes u) nil)
        _ (doseq [ns (:nodes u) :when (and (= "NamespaceDecl" (:kind ns)) (= "std" (:name ns)))
                  n ((fn flat [xs] (mapcat #(if (and (= "NamespaceDecl" (:kind %)) (:isInline %)) (flat (:inner %)) [%]) xs)) (:inner ns))
                  :when (#{"strong_ordering" "partial_ordering"} (:name n))]
            (.put std (:name n) (if (and (= "CXXRecordDecl" (:kind n)) (:completeDefinition n)) n (or (.get std (:name n)) n))))
        words-kind (fn [ws] (let [s (set ws)]
                              (cond (s "bool") :bool
                                    (or (s "float") (s "double")) :float
                                    (s "unsigned") :uint
                                    (some #{"int" "long" "short" "char" "signed"} s) :int
                                    :else nil)))
        kind (fn k [x]
               (case (:kind x)
                 ("IntegerLiteral") (let [t (str (get-in x [:type :qualType]))] (if (re-find #"unsigned" t) :uint :int))
                 "CharacterLiteral" :int
                 "CXXBoolLiteralExpr" :bool
                 "FloatingLiteral" :float
                 "ImaginaryLiteral" :complex
                 "CXXNullPtrLiteralExpr" :nullptr
                 "ParenExpr" (when (= 1 (count (:inner x))) (k (first (:inner x))))
                 "UnaryOperator" (let [[y] (:inner x)]
                                   (case (:opcode x)
                                     "-" (let [kk (k y)] (if (and (#{"IntegerLiteral" "FloatingLiteral"} (:kind y)) (#{:int :uint} kk)) :negint kk))
                                     "&" (when (= "DeclRefExpr" (:kind y))
                                           (cond (seq (:qualifier y)) (when (#{:fn :var} (get-in y [:_ent :k])) :memptr)
                                                 (= :fn (get-in y [:_ent :k])) :fnptr
                                                 :else nil))
                                     nil))
                 "DeclRefExpr" (let [e (:_ent x)]
                                 (cond (:enumerator e) (when-let [en (.get enums (str (:name e)))] [:enum en])
                                       (not= :var (:k e)) nil
                                       (= :a (get-in e [:ty :t])) :array
                                       (= :b (get-in e [:ty :t])) (words-kind (get-in e [:ty :w]))
                                       (and (= :n (get-in e [:ty :t])) (.contains enum-types (str (get-in e [:ty :s])))) [:enum (get-in e [:ty :s])]
                                       :else nil))
                 "CallExpr" (let [f (first (:inner x))]
                              (when (and (= "DeclRefExpr" (:kind f)) (= :fn (get-in f [:_ent :k]))
                                         (re-find #"^(?:decltype\(nullptr\)|std::nullptr_t|nullptr_t)\s*\(" (str (get-in f [:_ent :qt]))))
                                :nullptr))
                 nil))
        at! (fn [n msg] (when-let [o (get-in n [:range :begin :offset])]
                          (when (= main (get-in n [:range :begin :file]))
                            (let [[l c] (line-col starts (long o))]
                              (.add out {:line l :col c :kind :error :rule :spaceship :msg msg})))))
        tn (fn [k] (cond (vector? k) (second k) (keyword? k) (name k) :else "?"))]
    (walk-nodes
     (fn [n _]
       (when (and (= "BinaryOperator" (:kind n)) (= "<=>" (:opcode n)) (= 2 (count (:inner n))))
         (let [[a b] (map kind (:inner n))
               bad (str "invalid operands of types '" (tn a) "' and '" (tn b) "' to binary 'operator<=>'")
               arith #{:int :uint :negint :float :bool}]
           (when (and a b)
             (cond
               (or (= :nullptr a) (= :nullptr b)) (at! n "ordered comparison of pointer with 'std::nullptr_t'")
               (or (#{:array :fnptr :memptr :complex} a) (#{:array :fnptr :memptr :complex} b)) (at! n bad)
               (and (or (= :bool a) (= :bool b)) (not= a b)) (at! n "operands of 'operator<=>' of type 'bool' and another type")
               (and (vector? a) (vector? b) (not= a b)) (at! n bad)
               (or (and (vector? a) (= :float b)) (and (vector? b) (= :float a))) (at! n bad)
               (or (and (= :negint a) (= :uint b)) (and (= :negint b) (= :uint a))) (at! n "narrowing conversion in 'operator<=>'")
               (and (arith a) (arith b))
               (let [cat (if (or (= :float a) (= :float b)) "partial_ordering" "strong_ordering")
                     c (.get std cat)]
                 (cond (nil? c) (at! n (str "'std::" cat "' is not defined; did you forget to '#include <compare>'?"))
                       (not (#{"CXXRecordDecl"} (:kind c))) (at! n (str "'std::" cat "' is not a type"))
                       (not (:completeDefinition c)) nil
                       :else (let [want (if (= cat "partial_ordering") ["less" "equivalent" "greater" "unordered"] ["less" "equal" "greater"])]
                               (when-let [m (some (fn [w] (let [ms (filter #(= w (:name %)) (:inner c))]
                                                            (when (and (seq ms) (not (some #(= "VarDecl" (:kind %)) ms))) w)))
                                                  want)]
                                 (at! n (str "'std::" cat "::" m "' is not a static data member"))))))
               :else nil)))))
     (:nodes u) nil)
    (vec (distinct out))))

(swap! checks conj builtin-spaceship)

;; Using-declarations and using-enum-declarations ([namespace.udecl]/3-5, [enum.udecl]/1): a using-declarator names no destructor ("'E::~E'
;; names destructor"); one in a class's member-specification names a member of a base class, its nested-name-specifier no other class
;; of the unit nor a namespace ("type 'A' is not a base type for type 'B'", "using-declaration for non-member at class scope"; a class
;; template's members not judged, their bases dependent); a using-enum-declaration names an enumeration ("'A' is not an enumerated type").
;; [class.virtual]/18: a consteval virtual function overrides and is overridden only by consteval ones ("non-'consteval' function 'f'
;; overriding 'consteval' function", "'consteval' function 'f' overriding non-'consteval' function"; the unit's bases by name, the
;; parameters' types as written).

(defn using-and-consteval-overrides
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        n-src (count src)
        at! (fn [n msg] (when-let [o (when (= main (get-in n [:range :begin :file])) (or (get-in n [:loc :offset]) (get-in n [:range :begin :offset])))]
                          (let [[l c] (line-col starts (long o))]
                            (.add out {:line l :col c :kind :error :rule :using :msg msg}))))
        text (fn [n] (let [b (get-in n [:range :begin :offset]) e (get-in n [:range :end :offset])]
                       (when (and b e (= main (get-in n [:range :begin :file])) (<= (long b) (long e)) (< (long e) n-src))
                         (subs src (long b) (inc (long e))))))
        classes (java.util.HashMap.) namespaces (java.util.HashSet.) enums (java.util.HashSet.)
        _ (walk-nodes (fn [n _]
                        (case (:kind n)
                          "CXXRecordDecl" (when (and (:name n) (:completeDefinition n)) (.put classes (:name n) (if (.containsKey classes (:name n)) :ambiguous n)))
                          "NamespaceDecl" (when (:name n) (.add namespaces (:name n)))
                          "EnumDecl" (when (:name n) (.add enums (:name n)))
                          nil))
                      (:nodes u) nil)
        base-names (fn bn [c seen]
                     (into #{} (mapcat (fn [b] (let [nm (-> (str (get-in b [:type :qualType])) (str/replace #"^(?:struct|class)\s+" "") (str/replace #"<.*$" "") str/trim)
                                                     bc (.get classes nm)]
                                                 (cons nm (when (and (map? bc) (not (seen nm))) (bn bc (conj seen nm))))))
                                       (:bases c))))
        params (fn [f] (mapv #(str/replace (str (get-in % [:type :qualType])) #"\s+" "") (filter #(= "ParmVarDecl" (:kind %)) (:inner f))))
        consteval? (fn [f] (boolean (or (:_consteval f) (:consteval f))))]
    (letfn [(walk [nodes cls tmpl?]
              (doseq [n nodes :when (map? n)]
                (case (:kind n)
                  ("NamespaceDecl" "LinkageSpecDecl") (walk (:inner n) nil tmpl?)
                  "ClassTemplateDecl" (walk (:inner n) nil true)
                  "CXXRecordDecl" (when (:completeDefinition n)
                                    (when (and (not tmpl?) (= main (get-in n [:range :begin :file])))
                                      (let [bs (base-names n #{})]
                                        (doseq [m (:inner n) :when (= "CXXMethodDecl" (:kind m))]
                                          (doseq [b bs :let [bc (.get classes b)] :when (map? bc)
                                                  bm (:inner bc) :when (and (= "CXXMethodDecl" (:kind bm)) (= (:name m) (:name bm)) (:virtual bm)
                                                                            (= (params m) (params bm)))]
                                            (cond (and (consteval? bm) (not (consteval? m)))
                                                  (at! m (str "non-'consteval' function '" (:name m) "' overriding 'consteval' function"))
                                                  (and (consteval? m) (not (consteval? bm)))
                                                  (at! m (str "'consteval' function '" (:name m) "' overriding non-'consteval' function"))
                                                  :else nil)))))
                                    (walk (:inner n) n tmpl?))
                  "UsingDecl" (when-let [t (or (:_text n) (text n))]
                                (when (= main (get-in n [:range :begin :file] main))
                                  (let [t (str/replace (str/replace t #"^\s*using\s+" "") #"^typename\s+" "")
                                        parts (map str/trim (str/split (str/replace t #";\s*$" "") #"::"))]
                                    (cond
                                      (and (>= (count parts) 2) (str/starts-with? (last parts) "~"))
                                      (at! n (str "'" (str/join "::" parts) "' names destructor"))
                                      (and cls (not tmpl?) (>= (count parts) 2) (not= "" (first parts)))
                                      (let [q (first parts)
                                            ;; (C++20's P1099: a using-declarator naming an enumerator needs no base)
                                            enumerator? (and (>= (long (cxx-year (:std u))) 20) (map? (.get classes q))
                                                             (some (fn [e] (and (= "EnumDecl" (:kind e)) (some #(and (= "EnumConstantDecl" (:kind %)) (= (last parts) (:name %))) (:inner e))))
                                                                   (:inner (.get classes q))))]
                                        (cond (and (map? (.get classes q)) (not= q (:name cls)) (not ((base-names cls #{}) q)) (not enumerator?))
                                              (at! n (str "type '" q "' is not a base type for type '" (:name cls) "'"))
                                              (and (.contains namespaces q) (not (.containsKey classes q)))
                                              (at! n "using-declaration for non-member at class scope")
                                              :else nil))
                                      :else nil))))
                  "UsingEnumDecl" (when-let [t (text n)]
                                    (when-let [[_ nm] (re-find #"using\s+enum\s+(?:[\w:]*::)?\s*([A-Za-z_]\w*)\s*;?\s*$" t)]
                                      (when (and (map? (.get classes nm)) (not (.contains enums nm)))
                                        (at! n (str "'" nm "' is not an enumerated type")))))
                  nil)))]
      (walk (:nodes u) nil false))
    (vec (distinct out))))

(swap! checks conj using-and-consteval-overrides)

;; Concepts' and placeholders' declarations ([temp.concept]/2-5, [dcl.spec.auto.general]/5, [temp.param]/14, [temp.friend]/9,
;; [expr.prim.req.general]/5, [basic.scope.scope]/4): a concept is declared at namespace scope ("concept 'C' not in namespace scope"),
;; with one template-head and no constraint on its parameters ("a concept cannot be constrained", "concept 'C' has multiple template
;; parameter lists"), once ("redefinition of concept 'b'"), and not with a class of its name in its scope ("'E' redeclared as different
;; kind of entity"); a requires-expression's parameters have distinct names ("conflicting declaration"); an alias-declaration or typedef
;; has no placeholder type ("'auto' not allowed in alias declaration", "typedef declared 'auto'"); a template parameter pack has no
;; default argument ("template parameter pack cannot have a default argument"); a non-template friend function declaration with a
;; requires-clause, or a friend function template whose requires-clause names its enclosing template's parameters, is a definition
;; ("non-template friend 'foo' with a requires-clause must be a definition", "friend 'bar' with a requires-clause that depends on an
;; enclosing template parameter must be a definition").

(defn concept-decl-rules
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        n-src (count src)
        mine? (fn [n] (= main (get-in n [:range :begin :file])))
        at! (fn [n msg] (when-let [o (when (mine? n) (or (get-in n [:loc :offset]) (get-in n [:range :begin :offset])))]
                          (let [[l c] (line-col starts (long o))]
                            (.add out {:line l :col c :kind :error :rule :concept :msg msg}))))
        names-in (fn [x] (let [acc (java.util.HashSet.)]
                           (walk-nodes (fn [d _] (when (= "DeclRefExpr" (:kind d)) (.add acc (str (get-in d [:referencedDecl :name]))))) x nil)
                           acc))
        tparam-names (fn [t] (set (keep #(when (#{"TemplateTypeParmDecl" "NonTypeTemplateParmDecl" "TemplateTemplateParmDecl"} (:kind %)) (:name %)) (:inner t))))
        has-body? (fn [f] (some #(#{"CompoundStmt" "CXXTryStmt"} (:kind %)) (:inner f)))
        tparams! (fn [t]
                   (doseq [p (:inner t) :when (and (#{"TemplateTypeParmDecl" "NonTypeTemplateParmDecl" "TemplateTemplateParmDecl"} (:kind p)) (:isParameterPack p))]
                     (when (or (some #(= "TemplateArgument" (:kind %)) (:inner p))
                               (and (= "NonTypeTemplateParmDecl" (:kind p)) (seq (remove #(#{"ConceptSpecializationExpr" "NativeAttr"} (:kind %)) (:inner p)))))
                       (at! p "template parameter pack cannot have a default argument"))))]
    (letfn [(scope! [nodes cls? enclosing]
              (let [seen (java.util.HashMap.)]
                (doseq [n nodes :when (map? n)]
                  (case (:kind n)
                    "ConceptDecl"
                    (do (when cls? (at! n (str "concept '" (:name n) "' not in namespace scope")))
                        (when (some :_tc (filter #(#{"TemplateTypeParmDecl" "NonTypeTemplateParmDecl"} (:kind %)) (:inner n)))
                          (at! n "a concept cannot be constrained"))
                        (let [b (get-in n [:range :begin :offset])]
                          (when (and b (mine? n) (or (re-find #"^template\s*<[^{};]*?>\s*template\s*<" (subs src (long b) (min n-src (+ (long b) 300))))
                                                     (re-find #"template\s*<[^{};]*>\s*$" (last (str/split (subs src (max 0 (- (long b) 300)) (long b)) #"[;{}]" -1)))))
                            (at! n (str "concept '" (:name n) "' has multiple template parameter lists"))))
                        (case (.get seen (:name n))
                          :concept (at! n (str "redefinition of concept '" (:name n) "'"))
                          :class (at! n (str "'" (:name n) "' redeclared as different kind of entity"))
                          nil)
                        (.put seen (:name n) :concept))
                    "CXXRecordDecl" (do (when (and (:name n) (:completeDefinition n) (not (:isImplicit n)))
                                          (when (= :concept (.get seen (:name n))) (at! n (str "'" (:name n) "' redeclared as different kind of entity")))
                                          (when-not (.containsKey seen (:name n)) (.put seen (:name n) :class)))
                                        (scope! (:inner n) true enclosing))
                    ("NamespaceDecl" "LinkageSpecDecl") (scope! (:inner n) false enclosing)
                    "ClassTemplateDecl" (do (tparams! n)
                                            (scope! (filter #(= "CXXRecordDecl" (:kind %)) (:inner n)) cls? (into enclosing (tparam-names n))))
                    ("FunctionTemplateDecl" "VarTemplateDecl" "TypeAliasTemplateDecl") (tparams! n)
                    "TypeAliasDecl" (when (re-matches #"(?:(?:const|volatile)\s+)*auto" (str/trim (str (get-in n [:type :qualType]))))
                                      (at! n "'auto' not allowed in alias declaration"))
                    "TypedefDecl" (when (re-matches #"(?:(?:const|volatile)\s+)*auto" (str/trim (str (get-in n [:type :qualType]))))
                                    (at! n "typedef declared 'auto'"))
                    "FriendDecl" (doseq [f (:inner n)]
                                   (case (:kind f)
                                     "FunctionDecl" (when (and (:trailingRequiresClause f) (not (has-body? f)))
                                                      (at! f (str "non-template friend '" (:name f) "' with a requires-clause must be a definition")))
                                     "FunctionTemplateDecl" (when-let [fd (some #(when (= "FunctionDecl" (:kind %)) %) (:inner f))]
                                                              (when (and (:trailingRequiresClause fd) (not (has-body? fd))
                                                                         (some (set enclosing) (names-in (:trailingRequiresClause fd))))
                                                                (at! fd (str "friend '" (:name fd) "' with a requires-clause that depends on an enclosing template parameter must be a definition"))))
                                     nil))
                    nil))))]
      (scope! (:nodes u) false #{}))
    (walk-nodes (fn [n _]
                  (when (= "RequiresExpr" (:kind n))
                    (let [seen (java.util.HashSet.)]
                      (doseq [p (:params n) :when (:name p)]
                        (when-not (.add seen (:name p)) (at! p (str "conflicting declaration '" (get-in p [:type :qualType]) " " (:name p) "'")))))))
                (:nodes u) nil)
    (vec (distinct out))))

(swap! checks conj concept-decl-rules)

;; Abbreviated function templates and constrained placeholders ([dcl.fct]/22, [temp.mem]/4, [over.literal]/5, [dcl.spec.auto.general]/4):
;; a function with a placeholder parameter is a template, so not virtual ("templates may not be 'virtual'") nor a literal operator
;; (whose template has an empty parameter-declaration-clause: "literal operator template has invalid parameter list"); a function
;; declarator with a trailing return type has plain auto ("'f' function with trailing return type has constrained 'auto' type
;; specifier rather than plain 'auto'"), and a type-id no constrained placeholder ("invalid use of constrained 'auto' type").

(defn abbreviated-templates
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        n-src (count src)
        mine? (fn [n] (= main (get-in n [:range :begin :file])))
        at! (fn [n msg] (when-let [o (when (mine? n) (or (get-in n [:loc :offset]) (get-in n [:range :begin :offset])))]
                          (let [[l c] (line-col starts (long o))]
                            (.add out {:line l :col c :kind :error :rule :placeholder :msg msg}))))
        auto-param? (fn [f] (some #(and (= "ParmVarDecl" (:kind %)) (re-find #"\bauto\b" (str (get-in % [:type :qualType])))) (:inner f)))
        head (fn [n] (let [b (get-in n [:range :begin :offset]) e (get-in n [:loc :offset])]
                       (when (and b e (mine? n) (< (long b) (long e) n-src)) (subs src (long b) (long e)))))]
    (walk-nodes
     (fn [n parent]
       (case (:kind n)
         ("CXXMethodDecl" "FunctionDecl")
         (do (when (and (:virtual n) (auto-param? n)) (at! n "templates may not be 'virtual'"))
             (when (and (re-find #"^operator\s*\"\"" (str (:name n))) (auto-param? n))
               (at! n "literal operator template has invalid parameter list"))
             (when (re-find #"\)\s*(?:const\s*|noexcept\s*)*->" (str (get-in n [:type :qualType])))
               (when-let [h (head n)]
                 (when (re-find #"[A-Za-z_][\w:]*(?:<[^>]*>)?\s+auto\s*$" (str/replace h #"\b(?:static|inline|constexpr|consteval|virtual|explicit|friend|extern|const|volatile)\b" ""))
                   (at! n (str "'" (:name n) "' function with trailing return type has constrained 'auto' type specifier rather than plain 'auto'"))))))
         ("TypeAliasDecl" "TypedefDecl")
         (let [b (get-in n [:range :begin :offset]) e (get-in n [:range :end :offset])]
           (when (and b e (mine? n) (< (long b) (long e) n-src))
             (let [t (subs src (long b) (inc (long e)))
                   ty (if (= "TypeAliasDecl" (:kind n)) (second (re-find #"(?s)=(.*)$" t)) t)]
               ;; (cpp-1123: a decl-specifier keyword before auto is no type-constraint: `static auto constexpr value` in an alias's
               ;; class, cpp0x/alias-decl-16.C)
               (when (and ty (re-find #"(?:^|[\s(<,])(?!const\b|volatile\b|typedef\b|using\b|static\b|constexpr\b|inline\b|extern\b|thread_local\b|mutable\b|constinit\b|consteval\b|friend\b|register\b|virtual\b|explicit\b)[A-Za-z_][\w:]*(?:<[^>]*>)?\s+auto\b" ty))
                 (at! n "invalid use of constrained 'auto' type")))))
         nil))
     (:nodes u) nil)
    (vec (distinct out))))

(swap! checks conj abbreviated-templates)

;; Designated initializers (C++20, [dcl.init.general]/1, [dcl.init.aggr]/3.1, [temp.variadic]/5): a braced-init-list is a
;; designated-initializer-list or none of its clauses is designated ("either all initializer clauses should be designated or none of
;; them should be"), and a designated clause is no pack expansion ("'...' not allowed in designated initializer list"). Read off the
;; list's text, its top-level clauses; a list with a GNU array designator `[N] =` not judged.

(defn designated-lists
  [u starts ^String src ^String main]
  (when (>= (long (cxx-year (:std u))) 20)
    (let [out (java.util.ArrayList.)
          n-src (count src)
          clauses (fn [^String t]
                    ;; the top-level clauses of `{ ... }`'s text
                    (let [n (count t)]
                      (loop [i 1 depth 0 start 1 acc [] q nil]
                        (if (>= i n) acc
                            (let [c (.charAt t i)]
                              (cond
                                (and q (= c \\)) (recur (+ i 2) depth start acc q)
                                q (recur (inc i) depth start acc (if (= (int c) (int q)) nil q))
                                (or (= c \") (= c \')) (recur (inc i) depth start acc c)
                                (#{\( \[ \{} c) (recur (inc i) (inc depth) start acc nil)
                                (and (#{\) \] \}} c) (zero? depth)) (conj acc (subs t start i))
                                (#{\) \] \}} c) (recur (inc i) (dec depth) start acc nil)
                                (and (= c \,) (zero? depth)) (recur (inc i) depth (inc i) (conj acc (subs t start i)) nil)
                                :else (recur (inc i) depth start acc nil)))))))]
      (walk-nodes
       (fn [n _]
         (when (= "InitListExpr" (:kind n))
           (let [b (get-in n [:range :begin :offset]) e (get-in n [:range :end :offset])]
             (when (and b e (= main (get-in n [:range :begin :file])) (< (long b) (long e) n-src) (= \{ (.charAt src (int b))))
               (let [lt (subs src (long b) (inc (long e)))
                     ;; (cpp-decl2: an #embed directive among the clauses, [cpp.embed]/9-10: its prefix, the resource's
                     ;; bytes (at most its limit; two or more when no limit is given) and its suffix as the clauses it
                     ;; expands to, so a designated prefix before the bytes mixes designated and plain clauses: cpp/embed-14.C)
                     emb (boolean (re-find #"(?m)^\s*#\s*embed\b" lt))
                     lt (if emb
                          (str/replace lt #"(?m)^\s*#\s*embed\b([^\n]*)"
                                       (fn [[_ ^String d]]
                                         (let [arg (fn [k] (second (re-find (re-pattern (str "\\b" k "\\s*\\(([^)]*)\\)")) d)))
                                               lim (some-> (arg "limit") str/trim (#(try (Long/decode ^String %) (catch Exception _ nil))))
                                               bytes (cond (nil? lim) " 0, 0" (zero? (long lim)) "" (= 1 (long lim)) " 0" :else " 0, 0")]
                                           (if (str/blank? bytes)
                                             (str " " (or (arg "if_empty") "") " ")
                                             (str " " (or (arg "prefix") "") bytes (or (arg "suffix") "") " ")))))
                          lt)
                     cs (remove str/blank? (map str/trim (clauses lt)))
                     desig? (fn [^String c] (boolean (or (re-find #"^\.\s*[A-Za-z_]\w*\s*(?:=|\{)" c)
                                                         (and emb (re-find #"^\[[^\[\]]*\]\s*=(?!=)" c)))))]
                 (when (and (seq cs) (or emb (not-any? #(str/starts-with? % "[") cs)) (or emb (not-any? #(str/includes? % "#") cs)))
                   (let [ds (filter desig? cs)
                         ;; (an #embed's list: GCC's place, the first clause that differs, the directive's bytes)
                         [l c] (line-col starts (long (if emb (+ (long b) (.indexOf ^String (subs src (long b) (inc (long e))) "#")) b)))]
                     (when (and (seq ds) (some (complement desig?) cs))
                       (.add out {:line l :col c :kind :error :rule :designator
                                  :msg "either all initializer clauses should be designated or none of them should be"}))
                     (when (some #(str/ends-with? % "...") ds)
                       (.add out {:line l :col c :kind :error :rule :designator :msg "'...' not allowed in designated initializer list"})))))))))
       (:nodes u) nil)
      (vec (distinct out)))))

(swap! checks conj designated-lists)

;; A destroying operator delete ([basic.stc.dynamic.deallocation]/3, P0722): a member of C whose second parameter is
;; std::destroying_delete_t has a first parameter of type C* ("'operator delete' takes type 'C*' as first parameter").

(defn destroying-deletes
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)]
    (walk-nodes (fn [n parent]
                  (when (and (= "CXXMethodDecl" (:kind n)) (re-matches #"operator\s*delete" (str (:name n)))
                             (= "CXXRecordDecl" (:kind parent)) (:name parent) (= main (get-in n [:range :begin :file])))
                    (let [ps (vec (filter #(= "ParmVarDecl" (:kind %)) (:inner n)))]
                      (when (and (>= (count ps) 2) (re-find #"destroying_delete_t" (str (get-in (ps 1) [:type :qualType])))
                                 (not= (str (:name parent) "*") (str/replace (str (get-in (ps 0) [:type :qualType])) #"\s+|\bstruct\b|\bclass\b" "")))
                        (when-let [o (or (get-in n [:loc :offset]) (get-in n [:range :begin :offset]))]
                          (let [[l c] (line-col starts (long o))]
                            (.add out {:line l :col c :kind :error :rule :delete
                                       :msg (str "'operator delete' takes type '" (:name parent) "*' as first parameter")})))))))
                (:nodes u) nil)
    (vec out)))

(swap! checks conj destroying-deletes)

;; [expr.prim.lambda.capture]/3: a lambda-expression whose smallest enclosing scope is no block scope (a namespace-scope variable's
;; initializer, a parameter's type there) has no capture-default ("non-local lambda expression cannot have a capture-default"). Read
;; off a namespace-scope variable's initializer text outside every lambda body. And [dcl.constexpr]/3-4 with [class.default.ctor]/4: a
;; class with a virtual base has no constexpr constructor, so a constexpr variable of it is no constant ("'struct A' has virtual base
;; classes", at the class, and at the variable).

(defn nonlocal-lambdas
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        n-src (count src)
        at-off! (fn [off rule msg] (let [[l c] (line-col starts (long off))] (.add out {:line l :col c :kind :error :rule rule :msg msg})))
        classes (java.util.HashMap.)]
    (walk-nodes (fn [n _] (when (and (= "CXXRecordDecl" (:kind n)) (:name n) (:completeDefinition n)) (.put classes (:name n) n))) (:nodes u) nil)
    ((fn top [nodes]
       (doseq [n nodes :when (map? n)]
         (case (:kind n)
           ("NamespaceDecl" "LinkageSpecDecl") (top (:inner n))
           "VarDecl"
           (do
             (let [b (get-in n [:loc :offset]) e (get-in n [:range :end :offset])]
               (when (and b e (= main (get-in n [:range :begin :file])) (< (long b) (long e) n-src) (:init n))
                 (let [t (subs src (long b) (inc (long e)))
                       eq (.indexOf ^String t "=")]
                   (when (pos? eq)
                     (loop [i (inc eq) depth 0]
                       (when (< i (count t))
                         (let [c (.charAt t i)]
                           (cond (= c \{) (recur (inc i) (inc depth))
                                 (= c \}) (recur (inc i) (max 0 (dec depth)))
                                 (and (zero? depth) (= c \[) (< (inc i) (count t)) (#{\& \=} (.charAt t (inc i)))
                                      (re-find #"^\[\s*[&=]\s*(?:,[^\]]*)?\]" (subs t i)))
                                 (do (at-off! (+ (long b) i) :lambda "non-local lambda expression cannot have a capture-default") (recur (inc i) depth))
                                 :else (recur (inc i) depth)))))))))
             (when (:constexpr n)
               (when-let [c (.get classes (str/trim (str/replace (str (get-in n [:type :qualType])) #"^(?:const\s+)?(?:(?:struct|class)\s+)?" "")))]
                 (when (some :isVirtual (:bases c))
                   (when-let [o (get-in c [:loc :offset])]
                     (when (= main (get-in c [:range :begin :file]))
                       (at-off! o :constexpr (str "'struct " (:name c) "' has virtual base classes"))))
                   (when-let [o (get-in n [:loc :offset])]
                     (at-off! o :constexpr (str "call to non-'constexpr' function '" (:name c) "::" (:name c) "()'")))))))
           nil)))
     (:nodes u))
    (vec (distinct out))))

(swap! checks conj nonlocal-lambdas)

;; [expr.prim.lambda.capture]/12 with [dcl.init.ref]/5: a structured binding naming a bit-field ([dcl.struct.bind]/5: the binding
;; refers to the member) is not captured by reference, explicitly (`&a`, `&a = a`) or by a capture-default `&` that a use in the body
;; captures ("cannot bind bit-field 'a' to 'int&'", at the lambda). The bindings of a class whose non-static data members the
;; initializer's type lists, no base.

(defn bitfield-captures
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        n-src (count src)
        recs (java.util.HashMap.)
        _ (walk-nodes (fn [n _] (when (and (= "CXXRecordDecl" (:kind n)) (:name n) (:completeDefinition n)) (.put recs (:name n) n))) (:nodes u) nil)
        names-in (fn [x] (let [acc (java.util.HashSet.)]
                           (walk-nodes (fn [d _] (when (= "DeclRefExpr" (:kind d)) (.add acc (str (get-in d [:referencedDecl :name]))))) x nil)
                           acc))]
    (walk-nodes
     (fn [f _]
       (when (and (fn-kinds (:kind f)) (= main (get-in f [:range :begin :file])))
         (when-let [b (some #(when (= "CompoundStmt" (:kind %)) %) (:inner f))]
           (let [bits (java.util.HashSet.)]
             ;; the body's statements in order: a binding of a bit-field, then the lambdas after it
             (walk-nodes
              (fn [n _]
                (case (:kind n)
                  "DecompositionDecl"
                  (let [init (first (remove #(= "BindingDecl" (:kind %)) (:inner n)))
                        cn (get-in init [:_t :s])
                        r (when cn (.get recs cn))
                        fs (when (and r (empty? (:bases r))) (filter #(= "FieldDecl" (:kind %)) (:inner r)))
                        bs (filter #(= "BindingDecl" (:kind %)) (:inner n))]
                    (when (and (seq fs) (= (count fs) (count bs)))
                      (doseq [[bd fd] (map vector bs fs) :when (:isBitfield fd)] (.add bits (:name bd)))))
                  "LambdaExpr"
                  (when (and (pos? (.size bits)) (= main (get-in n [:range :begin :file])))
                    (let [o (long (get-in n [:range :begin :offset]))
                          lb (some #(when (= "CompoundStmt" (:kind %)) %) (:inner n))
                          intro (let [t (subs src o (min n-src (+ o 300)))] (second (re-find #"^\[([^\]]*)\]" t)))
                          caps (when intro (map str/trim (str/split intro #",")))
                          used (when lb (names-in lb))]
                      (doseq [nm bits]
                        (when (or (some #(re-matches (re-pattern (str "&\\s*" nm "(?:\\s*=.*)?")) %) caps)
                                  (and (some #(= "&" %) caps) used (.contains ^java.util.HashSet used nm)
                                       (not (some #(re-matches (re-pattern (str nm "(?:\\s*=.*)?")) %) caps))))
                          (let [[l c] (line-col starts o)]
                            (.add out {:line l :col c :kind :error :rule :capture :msg (str "cannot bind bit-field '" nm "' to 'int&'")}))))))
                  nil))
              (:inner b) nil)))))
     (:nodes u) nil)
    (vec (distinct out))))

(swap! checks conj bitfield-captures)

;; C++26's name-independent declarations (P2169, [basic.scope.scope]/5, [basic.lookup.general]/? ): a block-scope variable or
;; structured binding named _ of automatic storage may be declared again in its scope; an unqualified use of _ whose lookup finds
;; more than one entity there (two such declarations, or one with a declaration of another kind, the extern ones of a name one
;; entity) is ambiguous ("reference to '_' is ambiguous", at the use). A selection or iteration statement's init-statement,
;; condition and for-range-declaration share their scope with the substatement's outermost block ([stmt.pre]/5).

(defn name-independent-uses
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        new-frame (fn ^java.util.HashMap [] (java.util.HashMap. {:ext 0 :ind 0}))
        add! (fn [^java.util.HashMap fr kind] (.put fr kind (inc (long (.get fr kind)))))
        decl! (fn [fr d]
                (case (:kind d)
                  "VarDecl" (when (= "_" (:name d)) (add! fr (if (#{"extern" "static"} (:storageClass d)) :ext :ind)))
                  "FunctionDecl" (when (= "_" (:name d)) (add! fr :ext))
                  "DecompositionDecl" (doseq [b (:inner d) :when (and (= "BindingDecl" (:kind b)) (= "_" (:name b)))] (add! fr :ind))
                  nil))
        use! (fn [stack x]
               (when-let [fr (first (filter (fn [^java.util.HashMap f] (pos? (+ (long (.get f :ext)) (long (.get f :ind))))) stack))]
                 (let [^java.util.HashMap fr fr]
                   (when (>= (+ (if (pos? (long (.get fr :ext))) 1 0) (long (.get fr :ind))) 2)
                     (when-let [o (get-in x [:range :begin :offset])]
                       (when (= main (get-in x [:range :begin :file]))
                         (let [[l c] (line-col starts (long o))]
                           (.add out {:line l :col c :kind :error :rule :name-independent :msg "reference to '_' is ambiguous"}))))))))]
    (letfn [(expr [x stack]
              (cond (map? x) (case (:kind x)
                               "DeclRefExpr" (when (and (= "_" (get-in x [:referencedDecl :name])) (empty? (:qualifier x))) (use! stack x))
                               ("LambdaExpr" "CXXRecordDecl") nil
                               (doseq [[k v] x :when (and (not= k :_ent) (not= k :_t) (coll? v))] (expr v stack)))
                    (sequential? x) (doseq [y x] (expr y stack))
                    :else nil))
            (stmts [xs stack] (doseq [x xs] (stmt x stack)))
            (stmt [x stack]
              (when (map? x)
                (case (:kind x)
                  "CompoundStmt" (stmts (:inner x) (cons (new-frame) stack))
                  "DeclStmt" (doseq [d (:inner x)] (expr (:inner d) stack) (decl! (first stack) d))
                  ("ForStmt" "WhileStmt" "IfStmt" "SwitchStmt" "CXXForRangeStmt")
                  (let [fr (new-frame) st (cons fr stack)]
                    (doseq [c (:inner x)]
                      (cond (= "CompoundStmt" (:kind c)) (stmts (:inner c) st)
                            (= "DeclStmt" (:kind c)) (stmt c st)
                            (#{"VarDecl" "DecompositionDecl"} (:kind c)) (do (expr (:inner c) st) (decl! fr c))
                            (#{"ForStmt" "WhileStmt" "IfStmt" "SwitchStmt" "CXXForRangeStmt" "DoStmt" "ReturnStmt"} (:kind c)) (stmt c st)
                            :else (expr c st))))
                  (expr x stack))))]
      (walk-nodes (fn [f _]
                    (when (and (fn-kinds (:kind f)) (= main (get-in f [:range :begin :file])))
                      (when-let [b (some #(when (= "CompoundStmt" (:kind %)) %) (:inner f))]
                        ;; (a parameter's scope is the body's outermost block's, [basic.scope.param]/1, [basic.scope.block]/2)
                        (let [fr (new-frame)]
                          (doseq [pm (:inner f) :when (and (= "ParmVarDecl" (:kind pm)) (= "_" (:name pm)))] (add! fr :ind))
                          (stmts (:inner b) (list fr))))))
                  (:nodes u) nil)
      ;; a lambda's captures named _ ([expr.prim.lambda.capture]/6: an init-capture is name-independent), read off its introducer:
      ;; two, then a use of _ in its body, is ambiguous; a parameter _ with a capture _ is "lambda parameter '_' previously declared
      ;; as a capture" ([expr.prim.lambda.capture]/5)
      (walk-nodes (fn [l _]
                    (when (and (= "LambdaExpr" (:kind l)) (= main (get-in l [:range :begin :file])))
                      (let [o (long (get-in l [:range :begin :offset]))
                            intro (second (re-find #"^\[([^\]]*)\]" (subs src o (min (count src) (+ o 300)))))
                            caps (when intro (filter #(re-matches #"&?\s*_(?:\s*=.*)?" %) (map str/trim (str/split intro #","))))
                            b (some #(when (= "CompoundStmt" (:kind %)) %) (:inner l))
                            m (get-in l [:inner 0 :inner 0])]
                        (when (seq caps)
                          (when (some #(and (= "ParmVarDecl" (:kind %)) (= "_" (:name %))) (:inner m))
                            (let [[ln c] (line-col starts o)]
                              (.add out {:line ln :col c :kind :error :rule :name-independent :msg "lambda parameter '_' previously declared as a capture"})))
                          (when (and b (>= (count caps) 2))
                            (stmts (:inner b) (list (doto ^java.util.HashMap (new-frame) (.put :ind (count caps))))))))))
                  (:nodes u) nil))
    ;; structured bindings and template parameters that are not name-independent ([basic.scope.scope]/5: a static or namespace-scope
    ;; structured binding, a template parameter): one named twice is "redeclaration of 'auto _'", "redefinition of 'int _'"
    ((fn ns-walk [nodes ns?]
       (doseq [n nodes :when (map? n)]
         (case (:kind n)
           ("NamespaceDecl" "LinkageSpecDecl") (ns-walk (:inner n) true)
           ("FunctionTemplateDecl" "ClassTemplateDecl" "VarTemplateDecl" "TypeAliasTemplateDecl")
           (do (let [nms (keep #(when (#{"TemplateTypeParmDecl" "NonTypeTemplateParmDecl" "TemplateTemplateParmDecl"} (:kind %)) (:name %)) (:inner n))
                     dup (some (fn [[k v]] (when (> (long v) 1) k)) (frequencies nms))]
                 (when dup
                   (when-let [p (last (filter #(= dup (:name %)) (:inner n)))]
                     (when-let [o (when (= main (get-in p [:range :begin :file])) (or (get-in p [:loc :offset]) (get-in p [:range :begin :offset])))]
                       (let [[l c] (line-col starts (long o))]
                         (.add out {:line l :col c :kind :error :rule :redefinition :msg (str "redefinition of template parameter '" dup "'")}))))))
               (ns-walk (filter #(fn-kinds (:kind %)) (:inner n)) false))
           nil)))
     (:nodes u) true)
    (walk-nodes (fn [d _]
                  (when (and (= "DecompositionDecl" (:kind d)) (= main (get-in d [:range :begin :file])))
                    (let [o (long (get-in d [:range :begin :offset]))
                          static? (re-find #"^(?:\[\[[^\]]*\]\]\s*)?(?:static|thread_local|extern)\b" (subs src o (min (count src) (+ o 40))))
                          nms (keep #(when (= "BindingDecl" (:kind %)) (:name %)) (:inner d))]
                      (when (and (or static? (:_nsscope d)) (some (fn [[_ v]] (> (long v) 1)) (frequencies nms)))
                        (let [[l c] (line-col starts o)]
                          (.add out {:line l :col c :kind :error :rule :redefinition :msg "redeclaration of 'auto _'"}))))))
                (:nodes u) nil)
    ((fn nsd [nodes]
       (doseq [d nodes :when (map? d)]
         (case (:kind d)
           ("NamespaceDecl" "LinkageSpecDecl") (nsd (:inner d))
           "DecompositionDecl"
           (let [nms (keep #(when (= "BindingDecl" (:kind %)) (:name %)) (:inner d))]
             (when (and (= main (get-in d [:range :begin :file])) (some (fn [[_ v]] (> (long v) 1)) (frequencies nms)))
               (let [[l c] (line-col starts (long (get-in d [:range :begin :offset])))]
                 (.add out {:line l :col c :kind :error :rule :redefinition :msg "redefinition of 'auto _'"}))))
           nil)))
     (:nodes u))
    (vec (distinct out))))

(swap! checks conj name-independent-uses)

;; Prospective destructors (C++20, [class.dtor]/4, P0848): of a class's prospective destructors with constraints the check can
;; evaluate (true, false, !, &&, || and parentheses), the destructor is the one whose constraints are satisfied; two satisfied, none
;; more constrained, is "destructor for 'A<int>' is ambiguous", none satisfied "no viable destructor for 'B<int>'", at the class, when
;; the unit names a specialization of it (a class template's are judged at its specialization's name, here its first written one).

(defn- const-bool
  "The value of a constraint's text made only of true, false, !, &&, ||, not, and, or and parentheses, nil otherwise."
  [^String t]
  (let [t (-> t (str/replace #"\bnot\b" "!") (str/replace #"\band\b" "&&") (str/replace #"\bor\b" "||") str/trim)]
    (when (re-matches #"[\s()!&|]*(?:(?:true|false)[\s()!&|]*)+" t)
      (let [toks (re-seq #"true|false|&&|\|\||!|\(|\)" t)
            pos (volatile! 0)
            peek* (fn [] (nth toks @pos nil))
            next* (fn [] (let [x (peek* )] (vswap! pos inc) x))]
        (letfn [(prim [] (let [x (next*)]
                           (case x
                             "true" true "false" false
                             "!" (not (prim))
                             "(" (let [v (orx)] (next*) v)
                             (throw (ex-info "bad" {})))))
                (andx [] (loop [v (prim)] (if (= "&&" (peek*)) (do (next*) (let [w (prim)] (recur (and v w)))) v)))
                (orx [] (loop [v (andx)] (if (= "||" (peek*)) (do (next*) (let [w (andx)] (recur (or v w)))) v)))]
          (try (let [v (orx)] (when (= @pos (count toks)) (boolean v))) (catch Throwable _ nil)))))))

(defn prospective-destructors
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        n-src (count src)
        text (fn [x] (let [b (get-in x [:range :begin :offset]) e (get-in x [:range :end :offset]) l (get-in x [:range :end :tokLen])]
                       (when (and b e l (<= (long b) (+ (long e) (long l)) n-src)) (subs src (long b) (+ (long e) (long l))))))]
    (walk-nodes
     (fn [n parent]
       (when (and (= "CXXRecordDecl" (:kind n)) (:name n) (:completeDefinition n) (= main (get-in n [:range :begin :file])))
         (let [ds (filter #(= "CXXDestructorDecl" (:kind %)) (:inner n))
               vals (map #(when-let [rc (:trailingRequiresClause %)] (when-let [t (text rc)] (const-bool t))) ds)]
           (when (and (>= (count ds) 2) (every? some? vals))
             (let [tmpl? (= "ClassTemplateDecl" (:kind parent))
                   spec (when tmpl? (second (re-find (re-pattern (str "\\b" (java.util.regex.Pattern/quote (:name n)) "\\s*(<[^<>;]*>)")) src)))
                   cn (str (:name n) (or spec ""))
                   sat (count (filter true? vals))
                   o (or (get-in n [:loc :offset]) (get-in n [:range :begin :offset]))]
               (when (and o (or (not tmpl?) spec))
                 (let [[l c] (line-col starts (long o))]
                   (cond (>= sat 2) (.add out {:line l :col c :kind :error :rule :destructor :msg (str "destructor for '" cn "' is ambiguous")})
                         (zero? sat) (.add out {:line l :col c :kind :error :rule :destructor :msg (str "no viable destructor for '" cn "'")})
                         :else nil))))))))
     (:nodes u) nil)
    (vec out)))

(swap! checks conj prospective-destructors)

;; A friend class template's declaration redeclares the class template of its name, so its template-head is equivalent to the
;; earlier one's ([temp.over.link]/6-7, [temp.friend]): the same type-constraints on its parameters and an equivalent
;; requires-clause, its tokens the same ("redeclaration of 'template<class T> struct A' with different constraints", at the friend).

(defn friend-template-constraints
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        n-src (count src)
        text (fn [x] (let [b (get-in x [:range :begin :offset]) e (get-in x [:range :end :offset]) l (get-in x [:range :end :tokLen])]
                       (when (and b e l (<= (long b) (+ (long e) (long l)) n-src)) (str/replace (subs src (long b) (+ (long e) (long l))) #"\s+" ""))))
        sig (fn [t rc] [(mapv #(vec (:_tc %)) (filter #(#{"TemplateTypeParmDecl" "NonTypeTemplateParmDecl"} (:kind %)) (:inner t)))
                        (when rc (or (text rc) :unknown))])
        originals (java.util.HashMap.)]
    ((fn top [nodes]
       (doseq [n nodes :when (map? n)]
         (case (:kind n)
           ("NamespaceDecl" "LinkageSpecDecl") (top (:inner n))
           "ClassTemplateDecl" (when-not (.containsKey originals (:name n)) (.put originals (:name n) (sig n (:requiresClause n))))
           nil)))
     (:nodes u))
    (walk-nodes (fn [fd _]
                  (when (and (= "FriendDecl" (:kind fd)) (= main (get-in fd [:range :begin :file])))
                    (when-let [t (some #(when (= "ClassTemplateDecl" (:kind %)) %) (:inner fd))]
                      (when-let [orig (.get originals (:name t))]
                        (let [mine (sig t (or (:requiresClause fd) (:requiresClause t)))]
                          (when (and (not (some #{:unknown} [(second orig) (second mine)])) (not= orig mine))
                            (when-let [o (or (get-in t [:loc :offset]) (get-in (some #(when (= "CXXRecordDecl" (:kind %)) %) (:inner t)) [:loc :offset]) (get-in fd [:range :begin :offset]))]
                              (let [[l c] (line-col starts (long o))]
                                (.add out {:line l :col c :kind :error :rule :friend
                                           :msg (str "redeclaration of class template '" (:name t) "' with different constraints")})))))))))
                (:nodes u) nil)
    (vec (distinct out))))

(swap! checks conj friend-template-constraints)

;; [temp.names]/8 with [expr.prim.id.qual]/1: a concept-id names no type or namespace, so it is no nested-name-specifier
;; ("concept-id 'foo<T>' in nested-name-specifier", at the qualified name).

(defn concept-qualifiers
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        concepts (java.util.HashSet.)
        ;; (cpp-diag-a: a concept-id in an expression names every template parameter of its concept, [temp.arg.general]/4-5:
        ;; "wrong number of template arguments (1, should be 2)"; a concept with a pack or a default argument not judged)
        arity (java.util.HashMap.)]
    (walk-nodes (fn [n _] (when (and (= "ConceptDecl" (:kind n)) (:name n))
                            (.add concepts (:name n))
                            (let [ps (filter #(#{"TemplateTypeParmDecl" "NonTypeTemplateParmDecl" "TemplateTemplateParmDecl"} (:kind %)) (:inner n))]
                              (.put arity (:name n) (if (or (.containsKey arity (:name n)) (some :isParameterPack ps) (some #(seq (:inner %)) ps)) :unknown (count ps))))))
                (:nodes u) nil)
    (when (pos? (.size concepts))
      (walk-nodes (fn [n _]
                    (when (and (= "DeclRefExpr" (:kind n)) (:explicitTemplateArgs n) (empty? (:qualifier n)))
                      (let [k (.get arity (str (get-in n [:referencedDecl :name])))]
                        (when (and (number? k) (not= (long k) (count (:explicitTemplateArgs n))) (not-any? #(str/includes? (str %) "...") (:explicitTemplateArgs n)))
                          (when-let [o (when (= main (get-in n [:range :begin :file])) (get-in n [:range :begin :offset]))]
                            (let [[l col] (line-col starts (long o))]
                              (.add out {:line l :col col :kind :error :rule :concept
                                         :msg (str "wrong number of template arguments (" (count (:explicitTemplateArgs n)) ", should be " k ")")})))))))
                    (:nodes u) nil)
      (walk-nodes (fn [n _]
                    (when-let [q (seq (:qualifier n))]
                      (when-let [c (some #(let [b (str/trim (str/replace (str %) #"<.*$" ""))] (when (and (str/includes? (str %) "<") (.contains concepts b)) %)) q)]
                        (when-let [o (when (= main (get-in n [:range :begin :file])) (get-in n [:range :begin :offset]))]
                          (let [[l col] (line-col starts (long o))]
                            (.add out {:line l :col col :kind :error :rule :concept :msg (str "concept-id '" c "' in nested-name-specifier")}))))))
                  (:nodes u) nil))
    (vec (distinct out))))

(swap! checks conj concept-qualifiers)

;; A placeholder type in a template argument ([dcl.spec.auto.general]/5 lists where auto may appear: no template-argument; the
;; Concepts TS's `tuple<auto>` is gone from C++20): a declared variable's type with `auto` inside a template argument list is
;; "invalid use of 'auto' in template argument" (decltype(auto) and a class template's deduction aside).

(defn auto-template-args
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)]
    (walk-nodes (fn [n _]
                  (when (and (#{"VarDecl" "FieldDecl"} (:kind n)) (= main (get-in n [:range :begin :file])))
                    (let [t (str/replace (str (get-in n [:type :qualType])) #"decltype\(auto\)" "")]
                      (when (re-find #"[A-Za-z_]\w*\s*<[^<>;=]*\bauto\b[^<>;=]*>" t)
                        (when-let [o (or (get-in n [:loc :offset]) (get-in n [:range :begin :offset]))]
                          (let [[l c] (line-col starts (long o))]
                            (.add out {:line l :col c :kind :error :rule :placeholder :msg "invalid use of 'auto' in template argument"})))))))
                (:nodes u) nil)
    (vec out)))

(swap! checks conj auto-template-args)

;; C++26's [expr.delete]/5 (P3144): the operand of a delete-expression is no pointer to an incomplete class type ("operator 'delete'
;; used on incomplete type", "operator 'delete []' ..."); a class completed only after the expression is incomplete there.

(defn delete-incomplete
  [u starts ^String src ^String main]
  (when (re-find #"(?:26|2c)$" (str (:std u)))
    (let [out (java.util.ArrayList.)
          defs (java.util.HashMap.)
          _ (walk-nodes (fn [n _] (when (and (= "CXXRecordDecl" (:kind n)) (:name n) (:completeDefinition n) (= main (get-in n [:range :begin :file])))
                                    (when-let [o (get-in n [:range :begin :offset])]
                                      (.put defs (:name n) (min (long o) (long (or (.get defs (:name n)) Long/MAX_VALUE)))))))
                        (:nodes u) nil)
          declared (java.util.HashSet.)
          _ (walk-nodes (fn [n _] (when (and (= "CXXRecordDecl" (:kind n)) (:name n)) (.add declared (:name n)))) (:nodes u) nil)]
      (walk-nodes (fn [n _]
                    (when (and (= "CXXDeleteExpr" (:kind n)) (= main (get-in n [:range :begin :file])))
                      (let [x (first (:inner n))
                            ty (get-in x [:_ent :ty])
                            cn (when (and (= "DeclRefExpr" (:kind x)) (= :p (:t ty)) (= :n (get-in ty [:of :t]))) (get-in ty [:of :s]))
                            o (get-in n [:range :begin :offset])]
                        (when (and cn o (.contains declared cn) (> (long (or (.get defs cn) Long/MAX_VALUE)) (long o)))
                          (let [[l c] (line-col starts (long o))
                                arr (re-find #"^delete\s*\[" (subs src (long o) (min (count src) (+ (long o) 12))))]
                            (.add out {:line l :col c :kind :error :rule :delete
                                       :msg (str "operator 'delete" (when arr " []") "' used on incomplete type")}))))))
                  (:nodes u) nil)
      (vec out))))

(swap! checks conj delete-incomplete)

;; [stmt.pre]/1: an init-statement is an expression-statement, a simple-declaration or an alias-declaration, not a using-declaration
;; or a using-directive ("expected primary-expression before 'using'", at it).

(defn using-init-statements
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)]
    (walk-nodes (fn [n _]
                  (when (#{"IfStmt" "SwitchStmt" "ForStmt" "CXXForRangeStmt"} (:kind n))
                    (let [i (first (:inner n))]
                      (when (and (= "DeclStmt" (:kind i)) (some #(#{"UsingDecl" "UsingDirectiveDecl"} (:kind %)) (:inner i))
                                 (or (#{"ForStmt" "CXXForRangeStmt"} (:kind n)) (:hasInit n)))
                        (when-let [o (when (= main (get-in i [:range :begin :file])) (get-in i [:range :begin :offset]))]
                          (let [[l c] (line-col starts (long o))]
                            (.add out {:line l :col c :kind :error :rule :syntax :msg "expected primary-expression before 'using'"})))))))
                (:nodes u) nil)
    (vec out)))

(swap! checks conj using-init-statements)

;; [dcl.attr.grammar]/4 with [dcl.attr.assume]/1: an assume attribute followed by `...` is a pack expansion of it, which the attribute
;; does not allow (an attribute-token's own rule): "pack expansion of 'assume' attribute" (its argument with a pack), "expansion pattern
;; '(1 > 0)' contains no parameter packs" (without). Read off the main file's text, comments and literals aside.

(defn assume-expansions
  [u starts ^String src ^String main]
  (let [clean (-> src (str/replace #"(?s)/\*.*?\*/" (fn [m] (str/replace m #"[^\n]" " "))) (str/replace #"//[^\n]*" (fn [m] (str/replace m #"." " ")))
                  (str/replace #"\"(?:\\.|[^\"\\\n])*\"" (fn [m] (str/replace m #"." " "))))
        m (re-matcher #"\[\[\s*(?:(?:__)?gnu(?:__)?\s*::\s*)?(?:__)?assume(?:__)?\s*\(((?:[^()]|\((?:[^()]|\([^()]*\))*\))*)\)\s*\.\.\.\s*\]\]" clean)]
    (loop [acc []]
      (if (.find m)
        (let [[l c] (line-col starts (long (.start m)))]
          (recur (conj acc {:line l :col c :kind :error :rule :attribute
                            :msg (if (re-find #"[A-Za-z_]" (.group m 1)) "pack expansion of 'assume' attribute"
                                     (str "expansion pattern '(" (str/trim (.group m 1)) ")' contains no parameter packs"))})))
        acc))))

(swap! checks conj assume-expansions)

;; ---------------------------------------------------------------------------------------------
;; cpp-decl (2026-11-23): lookup, declarations and classes (doc/cpp/CPP-SURVEY.md, "As built: cpp-decl")

;; [over.literal]/3: a literal operator's parameter-declaration-clause is one of (const char*), (unsigned long long int), (long
;; double), (char), (wchar_t), (char8_t), (char16_t), (char32_t), (const C*, std::size_t) for those five character types; no ellipsis.
;; [over.literal]/5: a literal operator template's is empty. [lex.ext]/3 (a numeric literal: a raw literal operator or a numeric
;; literal operator template but not both), GCC's at the declaration: "... conflicts with raw literal operator" and the reverse.
;; A parameter whose type names an identifier the rule does not know (a typedef) leaves the declaration unjudged.

(def ^:private udl-words #{"const" "volatile" "char" "wchar_t" "char8_t" "char16_t" "char32_t" "bool" "short" "int" "long" "signed"
                           "unsigned" "float" "double" "void" "std" "size_t" "__size_t" "decltype" "sizeof" "auto" "nullptr_t"})

(defn- udl-judgeable? [^String q] (every? udl-words (re-seq #"[A-Za-z_]\w*" q)))

(defn- udl-size? [^String q]
  (let [q (str/trim q)]
    (or (#{"std::size_t" "size_t" "__size_t" "unsigned long" "long unsigned" "unsigned long int" "long unsigned int"} q)
        (str/starts-with? q "decltype(sizeof"))))

(defn- udl-list-ok? [qs variadic]
  (and (not variadic)
       (case (count qs)
         1 (contains? #{"const char *" "unsigned long long" "long double" "char" "wchar_t" "char8_t" "char16_t" "char32_t"} (first qs))
         2 (and (contains? #{"const char *" "const wchar_t *" "const char8_t *" "const char16_t *" "const char32_t *"} (first qs))
                (udl-size? (second qs)))
         false)))

(defn literal-operators
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        raws (java.util.HashMap.) tmpls (java.util.HashMap.)
        report! (fn [n msg] (when-let [o (mine-at n main)]
                              (let [[l c] (line-col starts o)] (.add out {:line l :col c :kind :error :rule :literal-operator :msg msg}))))
        fdecl (fn [f tmpl]
                (let [nm (str (:name f))
                      ps (filter #(= "ParmVarDecl" (:kind %)) (:inner f))
                      qs (mapv #(str/trim (str (get-in % [:type :qualType]))) ps)]
                  (when (and (str/starts-with? nm "operator\"\"") (every? udl-judgeable? qs) (not (:_qn f)))
                    (if tmpl
                      (do (when (seq qs) (report! f (str "literal operator template '" nm "' has invalid argument list")))
                          (when (empty? qs)
                            (if-let [r (.get raws nm)] (report! f (str "literal operator template '" nm "' conflicts with raw literal operator '" r "'"))
                                (.put tmpls nm nm))))
                      (if (udl-list-ok? qs (:variadic f))
                        (when (= qs ["const char *"])
                          (if (.get tmpls nm) (report! f (str "raw literal operator '" nm "' conflicts with literal operator template"))
                              (.put raws nm nm)))
                        (report! f (str "'" (get-in f [:type :qualType]) " " nm "' has invalid argument list")))))))
        w (fn w [xs]
            (doseq [x xs]
              (case (:kind x)
                ("NamespaceDecl" "LinkageSpecDecl") (w (:inner x))
                "FunctionDecl" (fdecl x false)
                "FunctionTemplateDecl" (when-let [f (some #(when (= "FunctionDecl" (:kind %)) %) (:inner x))]
                                         (when (some #(and (= "NonTypeTemplateParmDecl" (:kind %)) (:isParameterPack %)) (:inner x))
                                           (fdecl f true)))
                nil)))]
    (w (:nodes u))
    (vec out)))

(swap! checks conj literal-operators)

(defn- pp-diag
  "A preprocessor error `FILE:LINE:COL: msg` (the port's) as a diagnostic, the main file's alone (nil else)."
  [^String main ^String e]
  (when-let [[_ f ln col msg] (re-find #"^(.*?):(\d+):(?:(\d+):)? (.*)$" e)]
    (when (= f main)
      {:line (Long/parseLong ln) :col (if col (Long/parseLong col) 1) :kind :error :msg msg :rule :pp})))

;; GCC's driver's options (cpp-gnu, 2026-11-22; the GCC 15.2 manual's "Option Summary" and "Options That Control Optimization"):
;; the dg check's g++ options of a file (bound by arbace.repr.cpp.dg's own read, *driver-args* above), of which the driver refuses a
;; long option it does not define ("unrecognized command-line option '--c++17'", cpp1z/pr115440.C; the corpus' --param and --coverage
;; are GCC's) and -flifetime-dse=N outside its documented values 0, 1 and 2 ("argument to '-flifetime-dse=' is not between 0 and 2",
;; opt/pr79659.C): an error with no line, counted with those outside the main file (:other).

(defn driver-errors [args]
  (vec (concat
        (for [a args :when (and (str/starts-with? a "--") (not (re-matches #"--(?:param(?:=.*)?|coverage|std=.*|sysroot(?:=.*)?|help(?:=.*)?|version|embed-dir=.*|include|output)" a)))]
          (str "unrecognized command-line option '" a "'"))
        (for [a args :let [[_ n] (re-matches #"-flifetime-dse=(\d+)" a)] :when (and n (> (Long/parseLong n) 2))]
          "argument to '-flifetime-dse=' is not between 0 and 2"))))

(defn- declined-name
  "cpp-read (2026-11-24): the name a declaration the parser declined declares, from its text `t`: a template's or a
  declaration's class key's name (`template<int(> struct A;`), else the identifier before its declarator's first parenthesis at
  depth 0 (`fk (XE..., SW);`), outside a template-head's angle brackets; nil when none is plain."
  [^String t]
  (let [t (str/replace t #"(?s)/\*.*?\*/|//[^\n]*" " ")
        ;; the template-heads dropped: `template` and its <...>, nested
        body (loop [s (str/trim t)]
               (if-let [[_ rest] (re-find #"(?s)^template\s*<(.*)$" s)]
                 (let [n (count rest)
                       e (loop [i 0 d 1] (cond (>= i n) n
                                               (= \< (.charAt ^String rest i)) (recur (inc i) (inc d))
                                               (= \> (.charAt ^String rest i)) (if (= 1 d) i (recur (inc i) (dec d)))
                                               :else (recur (inc i) d)))]
                   (recur (str/trim (subs rest (min n (inc e))))))
                 s))]
    (or (second (re-find #"^(?:\w+\s+)*?(?:struct|class|union|enum(?:\s+(?:class|struct))?)\s+([A-Za-z_]\w*)\s*(?:[;{:<]|$)" body))
        (when-not (re-find #"^(?:struct|class|union|enum|typedef|using|namespace|friend|static_assert|extern\s+\"|asm)\b" body)
          (second (re-find #"^[^(<{;=]*?\b([A-Za-z_]\w*)\s*\(" body))))))

(defn- declined-names-silent
  "cpp-read (2026-11-24): GCC declares a declaration's name after the syntax errors that end it, so its later uses give no error
  of their own (template/crash57.C's `A<char> a;` after `template<int(> struct A;`, cpp0x/pr89900-3.C's `fk (0)` after `fk (XE...,
  SW)`); the native parser declines the declaration, so the errors on another, later line that name it, an undeclared
  identifier, or a syntax error at the name or in its template argument list (`A<`), are dropped."
  [ds u ^String src ^java.util.ArrayList starts ^String main]
  (let [names (java.util.ArrayList.)]
    (walk-nodes (fn [x _]
                  (when (= "NativeDecline" (:kind x))
                    (let [b (get-in x [:range :begin :offset]) e (get-in x [:range :end :offset])]
                      (when (and b e (= main (or (get-in x [:range :begin :file]) main)) (<= 0 (long b) (long e) (dec (.length src))))
                        (when-let [nm (declined-name (subs src (long b) (inc (long e))))]
                          (.add names [nm (first (line-col starts (long e)))]))))))
                (:nodes u) nil)
    ;; (the parser's errors that leave a declaration's entity erroneous in GCC, error_mark_node its type or its missing default
    ;; arguments, so that its uses are silent: template/incomplete10.C's `extern S s;` then `s.x`, other/default2.C's foo(0),
    ;; ext/anon-struct5.C's static member of an anonymous struct named in a member function; the Sema errors on a later line
    ;; whose text names it dropped)
    (doseq [d ds :when (= :syntax (:rule d))
            :let [m (str (:msg d))
                  nm (some #(second (re-find % m)) [#"^'([A-Za-z_]\w*)' has incomplete type"
                                                   #"^default argument missing for a parameter of '([A-Za-z_]\w*)'"
                                                   #"^static data member '([A-Za-z_]\w*)' in unnamed class"])]
            :when nm]
      (.add names [nm (:line d) :uses]))
    (if (.isEmpty names)
      ds
      (vec (remove (fn [d]
                     (let [l (long (:line d))]
                       (some (fn [[nm el uses]]
                               (and (> l (long el))
                                    (or (= (str (:msg d)) (str "use of undeclared identifier '" nm "'"))
                                        (and uses (#{:sema :undeclared} (:rule d))
                                             (let [ls (long (.get starts (dec l)))
                                                   le (let [i (.indexOf src "\n" (int ls))] (if (neg? i) (.length src) i))]
                                               (re-find (re-pattern (str "\\b" (java.util.regex.Pattern/quote nm) "\\b")) (subs src ls le))))
                                        (and (= :syntax (:rule d))
                                             (let [ls (long (.get starts (dec l)))
                                                   before (subs src ls (min (.length src) (+ ls (max 0 (dec (long (:col d)))))))]
                                               (re-find (re-pattern (str "\\b" (java.util.regex.Pattern/quote nm) "\\s*(<[^;{}()]*)?$")) before))))))
                             names)))
                   ds)))))

(defn diagnose
  "The diagnostics of the C++ file at `path` (named `main`, as the oracle names it), read at the standard `std` with the
  options `args`: {:diags [...] :other n (errors outside the main file) :declines n} or {:refused why :message m}."
  [^String path ^String main ^String std args]
  (try
    (let [sema? (not= "0" (System/getenv "REPR_CPP_DIAG_SEMA"))
          u (assoc (binding [ps/*full-headers* sema? native/*gnu-floats* true lit/*gnu-floats* true] (native/parse-file path main std args))
                   :dir (.getParent (.getAbsoluteFile (java.io.File. path))) :std std :args (vec args))
          src (latin1 path)
          starts (line-starts src)
          pps (keep #(pp-diag main (str %)) (:pp-errors u))
          other (count (remove #(pp-diag main (str %)) (filter #(re-find #"^.*?:\d+:" (str %)) (:pp-errors u))))
          ;; (CP338 (a): the parser's pedantic diagnostics, GCC's pedwarns, errors under -pedantic-errors alone)
          pe? (boolean (some #{"-pedantic-errors"} args))
          ;; (round 54, sixth pass: a pedwarn of -Wpedantic's own, `pedantic-w: `, which -Wno-pedantic after it turns off)
          pw? (and pe? (not (some #{"-Wno-pedantic"} (drop-while #(not= "-pedantic-errors" %) args))))
          syn (for [[off why tok] (distinct (:syntax u))
                    :when (or pe? (not (str/starts-with? (str why) "pedantic: ")))
                    :when (or pw? (not (str/starts-with? (str why) "pedantic-w: ")))
                    :let [[l c] (line-col starts (long off))]]
                {:line l :col c :kind :error :rule :syntax
                 :msg (str (str/replace (str why) #"^(statement|declaration|pedantic|pedantic-w): " "") " (at '" tok "')")})
          ;; cpp-read (2026-11-22): a GNU line marker (`# 1 "f" 1`, [cpp.line]'s directive without its `line`) the preprocessor ran
          ;; in the main file, libcpp's pedwarn "style of line directive is a GCC extension" (directives.cc's do_linemarker), an
          ;; error under -pedantic-errors
          lms (when pe?
                (for [l (sort (:executed u))
                      :let [l (long l)
                            a (long (.get starts (dec l)))
                            z (if (< l (.size starts)) (long (.get starts l)) (.length src))]
                      :when (re-find #"^[ \t]*#[ \t]*[0-9]" (subs src a z))]
                  {:line l :col 1 :kind :error :rule :pp :msg "style of line directive is a GCC extension"}))
          sema (concat lms (mapcat (fn [f] (f u starts src main)) @checks)
                       ;; (a unit the parser declined a construct of is not analyzed: the code generator's refusal)
                       (when (and sema? (zero? (long (:declines u 0)))) (sema-errors u starts src main)))
          ds (->> (concat pps syn sema) (sort-by (juxt :line :col)) vec)
          ;; cpp-gnu (2026-11-22): a check's diagnostic after which GCC gives an initializer up (:suppress [FROM-LINE TO-LINE]) drops
          ;; the code generator's Sema's errors on those lines (flexible-arrays' nested context)
          ;; cpp-gnu (2026-11-22): GCC's -Wno-template-body (invoke.texi: errors found parsing a template are not diagnosed then, "an
          ;; error only upon instantiation"; -Wno-error=template-body makes them warnings): the errors inside a template's definition
          ;; dropped, and a function template that had one and is instantiated -- named outside its definition -- gets GCC's
          ;; "instantiating erroneous template" at its name and its first such error again
          ds (if-not (some #{"-Wno-template-body" "-Wno-error=template-body"} args)
               ds
               (let [tmpls (for [n (:nodes u) :when (#{"FunctionTemplateDecl" "ClassTemplateDecl" "ClassTemplatePartialSpecializationDecl" "VarTemplateDecl"} (:kind n))
                                 :let [b (get-in n [:range :begin :offset]) e (get-in n [:range :end :offset])]
                                 :when (and b e (= main (or (get-in n [:range :begin :file]) main)))]
                             [n (first (line-col starts (long b))) (first (line-col starts (long e)))])
                     in-t (fn [d] (some (fn [[n a z]] (when (<= (long a) (long (:line d)) (long z)) n)) tmpls))
                     dropped (filter in-t ds)
                     kept (vec (remove in-t ds))
                     refs (let [acc (java.util.ArrayList.)]
                            (walk-nodes (fn [x _] (when (= "DeclRefExpr" (:kind x)) (when-let [o (get-in x [:range :begin :offset])] (.add acc [(get-in x [:referencedDecl :name]) (first (line-col starts (long o)))]))))
                                        (:nodes u) nil)
                            acc)
                     again (for [[n a z] tmpls :when (= "FunctionTemplateDecl" (:kind n))
                                 :let [fd (first (filter #(when (and (<= (long a) (long (:line %)) (long z))) %) dropped))]
                                 :when (and fd (some (fn [[nm l]] (and (= nm (:name n)) (or (< (long l) (long a)) (> (long l) (long z))))) refs))
                                 :let [f (some #(when (= "FunctionDecl" (:kind %)) %) (:inner n))
                                       o (or (get-in f [:loc :offset]) (get-in n [:range :begin :offset]))
                                       [l c] (line-col starts (long o))]]
                             [{:line l :col c :kind :error :rule :template-body :msg "instantiating erroneous template"} fd])]
                 (->> (concat kept (mapcat identity again)) (sort-by (juxt :line :col)) vec)))
          sup (keep :suppress ds)
          ds (if (seq sup)
               (vec (remove (fn [d] (and (= :sema (:rule d)) (some (fn [[a z]] (<= (long a) (long (:line d)) (long z))) sup))) ds))
               ds)
          ;; cpp-read (2026-11-22): an undeclared name is GCC's error once in a block: unqualified_name_lookup_error declares it in
          ;; the innermost local scope, error_mark_node its type, so its later uses there and in the blocks nested in it are silent
          ;; (cp/lex.cc); the parser's and Sema's errors for such a later use on another line dropped (conversion/const3.C)
          blocks (let [out (java.util.ArrayList.)]
                   (walk-nodes (fn [x _] (when (= "CompoundStmt" (:kind x))
                                           (let [b (get-in x [:range :begin :offset]) e (get-in x [:range :end :offset])]
                                             (when (and b e (= main (or (get-in x [:range :begin :file]) main))) (.add out [(long b) (long e)])))))
                               (:nodes u) nil)
                   (vec out))
          given (java.util.ArrayList.)
          ds (vec (remove (fn [d]
                            (when-let [[_ nm] (and (#{:undeclared :sema} (:rule d))
                                                   (re-find #"use of undeclared identifier '([^']+)'" (str (:msg d))))]
                              (let [o (+ (long (.get starts (dec (long (:line d))))) (dec (long (:col d))))
                                    inner (reduce (fn [best [b e :as r]] (if (and (<= b o e) (or (nil? best) (> b (long (first best))))) r best)) nil blocks)]
                                (when (and inner (not (str/starts-with? nm "operator")))
                                  ;; (the name's later use is error_mark_node, silent but where its type is needed: a decltype's
                                  ;; operand, "template argument 1 is invalid", lambda-ice8.C; an auto variable's initializer,
                                  ;; "unable to deduce", auto44.C; a literal operator's lookup is no such name's, pr51420.C)
                                  (if (and (some (fn [[n l [b e]]] (and (= n nm) (not= l (:line d)) (<= (long b) o (long e)))) given)
                                           (let [ls (long (.get starts (dec (long (:line d)))))
                                                 le (let [i (.indexOf ^String src "\n" (int ls))] (if (neg? i) (.length src) i))
                                                 before (subs src ls (min le (max ls o)))
                                                 line (subs src ls le)]
                                             (not (or (str/includes? line (str "decltype(" nm ")"))
                                                      (re-find (re-pattern (str "decltype\\s*\\(\\s*" (java.util.regex.Pattern/quote nm) "\\s*\\)")) line)
                                                      (re-find #"^\s*(const\s+)?auto\b[^;]*=" before)))))
                                    true
                                    (do (.add given [nm (:line d) inner]) false))))))
                          ds))]
      ;; (cpp-gnu: a check's error with no line, :line 0, an implicit declaration's, counted with those outside the main file)
      (let [ds (declined-names-silent ds u src starts main)]
      {:diags (vec (remove #(= 0 (:line %)) ds))
       :other (+ (long other) (count (driver-errors *driver-args*)) (count (filter #(= 0 (:line %)) ds))) :declines (:declines u)}))
    (catch arbace.lang.ExceptionInfo e
      (if-let [g (or (:cpp/gap (ex-data e)) (when (:cpp/parse (ex-data e)) :parse))]
        {:refused g :message (ex-message e)}
        (throw e)))))

(defn format-diag ^String [^String main {:keys [line col kind msg rule]}]
  (str main ":" line ":" col ": " (name kind) ": " msg " [" (name rule) "]"))

(defn read-map
  "The dg verdict's read (arbace.repr.cpp.dg/verdict's): {:status :accepted|:rejected :lines {line n} :other n :fatal 0
  :message first-error :diags [...]}."
  [^String main r]
  (if (:refused r)
    {:status :refused :lines {} :message (str (name (:refused r)) ": " (str/replace (str (:message r)) #"[\t\n\r]" " "))}
    (let [es (filter #(= :error (:kind %)) (:diags r))]
      {:status (if (or (seq es) (pos? (long (:other r 0)))) :rejected :accepted)
       :lines (into (sorted-map) (frequencies (map :line es)))
       :other (:other r 0) :fatal 0
       :message (if-let [e (first es)] (format-diag main e) "")
       :diags (mapv #(format-diag main %) es)
       ;; (cpp-singles: the notes too, for the dg-errors' later branches, arbace.repr.cpp.dg/read-own's alt-hits)
       :notes (mapv #(format-diag main %) (filter #(= :note (:kind %)) (:diags r)))})))

;; cpp-tpl (2026-11-23): the checker's refusals of templates' instantiations ([temp.res.general]/3, [temp.inst])
(alter-var-root #'sema-rules conj
  [:name #"^codegen: '.*' is not a class, struct, or union type" "is not a class, struct, or union type"])

;; cpp-1123 (2026-11-23): the checker's objects of abstract class types ([class.abstract]/3, arbace.cpp.sema/cx-abstract!)
(alter-var-root #'sema-rules conj
  [:abstract #"^codegen: cannot declare .* to be of abstract type" "cannot declare to be of abstract type"]
  [:base #"^codegen: cannot derive from 'final' base" "cannot derive from 'final' base"])

;; cpp-ce2 (2026-11-23): the checker's __builtin_bit_cast ([bit.cast]/1, arbace.cpp.sema/bit-cast-expr: GCC's diagnostics)
(alter-var-root #'sema-rules conj
  [:bit-cast #"^codegen: '__builtin_bit_cast' (source|destination) (type|size) " "invalid __builtin_bit_cast"]
  [:incomplete #"^codegen: '[^']*' has incomplete type$" "variable has incomplete type"])

;; cpp-decl2 (2026-11-23): the checker's initialization, lookup, special member and overload rules (arbace.cpp.sema)
(alter-var-root #'sema-rules conj
  [:init #"^codegen: designator order for field '.*' does not match declaration order" "designator order does not match declaration order"])
(alter-var-root #'sema-rules conj
  [:uninit #"^codegen: uninitialized (const|reference) member '.*' in a constructor" "uninitialized const or reference member in a constructor"])
(alter-var-root #'sema-rules conj
  ;; (a non-member operator=, (), [] or -> the checker did not declare, arbace.cpp.sema/declare-fn!: GCC's "'operator=' not defined")
  [:name #"^codegen: unknown name operator(=|\(\)|\[\]|->)$" "not defined"])
(alter-var-root #'sema-rules conj
  [:incomplete #"^codegen: invalid use of cv-qualified type 'void' in parameter declaration" "invalid use of cv-qualified type 'void' in parameter declaration"])
(alter-var-root #'sema-rules conj
  [:init #"^codegen: conversion from .* to non-scalar type '.*' requested" "conversion to non-scalar type requested"])

;; cpp-decl2 (2026-11-23): [dcl.link]/7 (C++23 /6): two declarations of a function or a variable with C language linkage and
;; one name in different namespaces declare the same entity, and [basic.link]/11 wants their types the same (an array's bound
;; given once): GCC's "conflicting C language linkage declaration 'long int BAD::i'", at the later declaration's name;
;; lookup/extern-c-redecl6.C. The main file's namespace-scope declarations in extern "C" (not static), each against the first.
(defn c-linkage-entities
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        seen (java.util.HashMap.)
        norm (fn [t] (str/replace (str/replace (first (split-exc (str t))) #"\(void\)" "()") #"\s+" ""))
        arr (fn [^String t] (when-let [[_ e b] (re-matches #"(.*)\[(\d*)\]" t)] [e b]))
        same? (fn [a b] (or (= a b)
                            (let [[ea ba] (arr a) [eb bb] (arr b)]
                              (and ea eb (= ea eb) (or (= "" ba) (= "" bb))))))
        enter! (fn [path n]
                 (when (and (#{"FunctionDecl" "VarDecl"} (:kind n)) (string? (:name n)) (seq (:name n))
                            (not= "static" (:storageClass n)) (= main (get-in n [:loc :file])) (get-in n [:loc :offset])
                            (not (qualified-name? src (long (get-in n [:loc :offset])))))
                   (let [k [(:kind n) (:name n)] t (norm (get-in n [:type :qualType]))]
                     (if-let [[p0 t0] (.get seen k)]
                       (when (and (not= p0 path) (not (same? t0 t)))
                         (let [[l c] (line-col starts (long (get-in n [:loc :offset])))]
                           (.add out {:line l :col c :kind :error :rule :linkage
                                      :msg (str "conflicting C language linkage declaration '" (:name n) "'")})))
                       (.put seen k [path t])))))]
    (letfn [(region! [path lang nodes]
              (doseq [n nodes]
                (case (:kind n)
                  "LinkageSpecDecl" (region! path (if (= "C" (:language n)) :c :cpp) (:inner n))
                  "NamespaceDecl" (region! (str path (or (:name n) "(anonymous)") "::") lang (:inner n))
                  ("FunctionDecl" "VarDecl") (when (= :c lang) (enter! path n))
                  nil)))]
      (region! "" :cpp (:nodes u)))
    (vec out)))

(swap! checks conj c-linkage-entities)

;; cpp-decl2 (2026-11-23): [namespace.def.general]/2: a namespace-definition's identifier is looked up in its enclosing namespace
;; and the inline namespaces of it (transitively, [namespace.def.general]/7's inline namespace set); two namespaces found is GCC's
;; "'namespace B' is ambiguous", at the definition: lookup/pr94257.C's `inline namespace B { namespace B { } }` reopened as
;; `namespace B`. One found is the one extended (an inline namespace's member among them). The main file's definitions.
(defn namespace-ambiguity
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        found (fn found [^java.util.Map m nm]
                (concat (when-let [e (.get m nm)] [e])
                        (mapcat (fn [e] (when (:inline e) (found (:sub e) nm))) (vals m))))]
    (letfn [(walk [^java.util.Map m nodes]
              (doseq [n nodes :when (= "NamespaceDecl" (:kind n))]
                (let [nm (or (:name n) "\u0001anon")
                      fs (if (:isNested n) (keep #(.get m %) [nm]) (distinct (found m nm)))
                      _ (when (and (>= (count fs) 2) (:name n) (= main (get-in n [:loc :file])) (get-in n [:loc :offset]))
                          (let [[l c] (line-col starts (long (get-in n [:loc :offset])))]
                            (.add out {:line l :col c :kind :error :rule :namespace :msg (str "'namespace " nm "' is ambiguous")})))
                      e (or (first fs)
                            (let [e {:inline (boolean (:isInline n)) :sub (java.util.LinkedHashMap.)}] (.put m nm e) e))]
                  (walk (:sub e) (:inner n)))))]
      (walk (java.util.LinkedHashMap.) (:nodes u)))
    (vec out)))

(swap! checks conj namespace-ambiguity)
(alter-var-root #'sema-rules conj
  [:virtual #"^codegen: (non-)?deleted function '.*' overriding (non-)?deleted function" "deleted and non-deleted functions overriding each other"])
(alter-var-root #'sema-rules conj
  [:uninit #"^codegen: uninitialized const in 'new'" "uninitialized const in new"])

;; cpp-decl2 (2026-11-23): an enumeration's declarations ([dcl.enum]/3-5): each redeclaration scoped or unscoped as the first
;; ("scoped/unscoped mismatch in enum 'E1'"), of the same underlying type when both are fixed (a scoped one's int when none is
;; written: "different underlying type in enum 'E4'"), one definition ("multiple definition of 'enum E6'"), an
;; opaque-enum-declaration's name a simple identifier ("opaque-enum-specifier must use a simple identifier"), and a definition
;; by a qualified name in a scope that encloses the enumeration's ([dcl.enum]/4: "declaration of 'enum class N1::E6' in namespace
;; 'N2' which does not enclose 'N1'"); at the later declaration's name. cpp0x/forw_enum6.C. The main file's namespaces and classes,
;; templates not followed.
(defn enum-redecls
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        seen (java.util.HashMap.)
        report! (fn [n msg] (when-let [o (get-in n [:loc :offset])]
                              (let [[l c] (line-col starts (long o))]
                                (.add out {:line l :col c :kind :error :rule :enum-redecl :msg msg}))))
        ut (fn [n] (some-> (get-in n [:fixedUnderlyingType :qualType]) str str/trim (str/replace #"\s+" " ")))]
    (letfn [(region! [path nodes]
              (doseq [n nodes]
                (case (:kind n)
                  "LinkageSpecDecl" (region! path (:inner n))
                  "NamespaceDecl" (region! (str path (or (:name n) "(anonymous)") "::") (:inner n))
                  "CXXRecordDecl" (when (and (string? (:name n)) (:completeDefinition n)) (region! (str path (:name n) "::") (:inner n)))
                  ;; (cpp-sweep: a class template's own definition too, its underlying types compared as written, a template
                  ;; parameter's name against another's or a type's: GCC's check at the definition, cpp0x/forw_enum10.C)
                  "ClassTemplateDecl" (region! path (filter #(= "CXXRecordDecl" (:kind %)) (:inner n)))
                  "EnumDecl" (when (and (string? (:name n)) (seq (:name n)) (= main (get-in n [:loc :file])))
                               (let [q (:_equal n)
                                     k (if q
                                         (let [nested (str path (str/join "::" q) "::" (:name n))
                                               glob (str (str/join "::" q) "::" (:name n))]
                                           (cond (.containsKey seen nested) nested
                                                 (.containsKey seen glob) glob
                                                 :else nested))
                                         (str path (:name n)))]
                                 (when (and q (not (:_body n)))
                                   (report! n "opaque-enum-specifier must use a simple identifier"))
                                 (when (and q (:_body n) (seq path) (not (str/starts-with? k path)) (.containsKey seen k))
                                   (report! n (str "declaration of 'enum " (:name n) "' in '" (subs path 0 (- (count path) 2))
                                                   "' which does not enclose '" (str/join "::" q) "'")))
                                 (when-not (or (and q (not (:_body n)))
                                               ;; (a definition refused as not enclosed defines nothing)
                                               (and q (:_body n) (seq path) (not (str/starts-with? k path)) (.containsKey seen k)))
                                   (if-let [o (.get seen k)]
                                     (cond
                                       (not= (boolean (:scopedEnumTag o)) (boolean (:scopedEnumTag n)))
                                       (report! n (str "scoped/unscoped mismatch in enum '" (:name n) "'"))
                                       (and (ut o) (ut n) (not= (ut o) (ut n)))
                                       (report! n (str "different underlying type in enum '" (:name n) "'"))
                                       (and (:_body o) (:_body n) (or (not q) (str/starts-with? k path)))
                                       (report! n (str "multiple definition of 'enum " (:name n) "'"))
                                       :else (when (:_body n) (.put seen k n)))
                                     (.put seen k n)))))
                  nil)))]
      (region! "" (:nodes u)))
    (vec out)))

(swap! checks conj enum-redecls)

;; cpp-decl2 (2026-11-23): [basic.def.odr]/11 (C++23 /12): an inline variable odr-used in a translation unit is defined there; an
;; `extern inline` declaration at namespace scope never defined in the file whose name is used outside an unevaluated operand
;; (sizeof, alignof, decltype, noexcept, typeid) is GCC's "odr-used inline variable 'var19' is not defined", at the declaration;
;; cpp1z/inline-var2.C. Read off the main file's text after the declaration.
(defn odr-inline-vars
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        decls (java.util.ArrayList.)
        defined (java.util.HashSet.)]
    (letfn [(region! [nodes]
              (doseq [n nodes]
                (case (:kind n)
                  ("LinkageSpecDecl" "NamespaceDecl") (region! (:inner n))
                  "VarDecl" (when (and (string? (:name n)) (= main (get-in n [:loc :file])))
                              (if (and (:inline n) (= "extern" (:storageClass n)) (not (:init n)) (empty? (filter map? (:inner n))))
                                (.add decls n)
                                (when (or (:init n) (not= "extern" (:storageClass n))) (.add defined (:name n)))))
                  nil)))]
      (region! (:nodes u)))
    (doseq [n decls :when (not (.contains defined (:name n)))
            :let [e (long (or (get-in n [:range :end :offset]) (get-in n [:loc :offset])))
                  m (re-matcher (re-pattern (str "\\b" (java.util.regex.Pattern/quote (:name n)) "\\b")) (subs src (min (count src) (inc e))))]]
      (when (loop []
              (if (.find m)
                (let [i (+ (inc e) (.start m))
                      before (subs src (max 0 (- i 40)) i)]
                  (if (re-find #"(?:sizeof|alignof|__alignof__|decltype|noexcept|typeid)\s*\(\s*$|extern\s+inline[^;]*$|//[^\n]*$" before)
                    (recur)
                    true))
                false))
        (let [[l c] (line-col starts (long (get-in n [:loc :offset])))]
          (.add out {:line l :col c :kind :error :rule :odr-inline :msg (str "odr-used inline variable '" (:name n) "' is not defined")}))))
    (vec out)))

(swap! checks conj odr-inline-vars)
(alter-var-root #'sema-rules conj
  [:nsdmi #"^codegen: default member initializer for '.*' required before the end of its enclosing class" "default member initializer required before the end of its enclosing class"])
(alter-var-root #'sema-rules conj
  [:varargs #"^codegen: binding a const reference to a volatile object passed through" "binding reference discards qualifiers"])
(alter-var-root #'sema-rules conj
  [:null-object #"^codegen: invalid access to non-static data member '.*' of NULL object" "invalid access to non-static data member of NULL object"])

;; cpp-rind (2026-11-24): [basic.def.odr]/11 (C++23 /12) with [basic.link]/4: a function of internal linkage -- declared `static` at
;; namespace scope, or declared in an unnamed namespace, a static member function of a class defined there among them -- that is
;; odr-used is defined in its translation unit; GCC's "'int {anonymous}::A::bar()' used but never defined" (a pedwarn, an error
;; under the dg harness's -pedantic-errors), at the declaration. A use counted only where GCC emits it: in the body of a namespace-
;; scope function that is no inline, constexpr or consteval function nor a template's (an uninstantiated or unemitted body refers to
;; nothing), outside an unevaluated operand; inline and virtual functions, and any name the file defines anywhere, not judged
;; (ext/visibility/anon7.C).
(defn internal-undefined
  [u starts ^String src ^String main]
  (when (some #{"-pedantic-errors"} (:args u))
    (let [out (java.util.ArrayList.)
          decls (java.util.HashMap.)
          defined (java.util.HashSet.)
          uses (java.util.HashSet.)
          body? (fn [n] (or (:explicitlyDefaulted n) (:explicitlyDeleted n) (some #(= "CompoundStmt" (:kind %)) (:inner n))
                            (some #(= "CXXTryStmt" (:kind %)) (:inner n))))
          plain (fn [nm] (last (str/split (str nm) #"::")))
          fn-kinds #{"FunctionDecl" "CXXMethodDecl"}]
      ;; definitions anywhere, by name
      (walk-nodes (fn [n _] (when (and (fn-kinds (:kind n)) (string? (:name n)) (body? n)) (.add defined (plain (:name n))))) (:nodes u) nil)
      (letfn [(unevaluated? [n] (#{"UnaryExprOrTypeTraitExpr" "CXXNoexceptExpr" "CXXTypeidExpr" "DecltypeExpr" "RequiresExpr"} (:kind n)))
              (uses! [x]
                (cond (map? x) (when-not (unevaluated? x)
                                 (when (and (#{"DeclRefExpr" "MemberExpr"} (:kind x)) (string? (get-in x [:referencedDecl :name])))
                                   (.add uses (plain (get-in x [:referencedDecl :name]))))
                                 (doseq [[k v] x :when (and (not= k :_ent) (coll? v))] (uses! v)))
                      (sequential? x) (doseq [y x] (uses! y))
                      :else nil))
              (internal! [n]
                (when (and (string? (:name n)) (not (body? n)) (not (:inline n)) (not (:virtual n)) (not (:isImplicit n))
                           (not (:constexpr n)) (not (:consteval n)) (mine-at n main))
                  (.putIfAbsent decls (plain (:name n)) n)))
              (region! [nodes anon]
                (doseq [n nodes :when (map? n)]
                  (case (:kind n)
                    "NamespaceDecl" (region! (:inner n) (or anon (nil? (:name n)) (= "" (:name n))))
                    "LinkageSpecDecl" (region! (:inner n) anon)
                    "FunctionDecl" (do (when (or anon (= "static" (:storageClass n))) (internal! n))
                                       (when (and (body? n) (not (:inline n)) (not (:constexpr n)) (not (:consteval n)))
                                         (uses! (:inner n))))
                    "CXXRecordDecl" (when (and anon (:completeDefinition n) (string? (:name n)) (seq (:name n)))
                                      (doseq [m (:inner n) :when (and (= "CXXMethodDecl" (:kind m)) (= "static" (:storageClass m)))]
                                        (internal! m)))
                    nil)))]
        (region! (:nodes u) false))
      (doseq [[nm n] decls :when (and (.contains uses nm) (not (.contains defined nm)))]
        (let [[l c] (line-col starts (long (mine-at n main)))]
          (.add out {:line l :col c :kind :error :rule :odr-internal :msg (str "'" nm "' used but never defined")})))
      (vec out))))

(swap! checks conj internal-undefined)

;; cpp-rind (2026-11-24): [class.union.anon]/1, an anonymous union's member names are declared in the scope where the union is
;; declared and conflict with that scope's other declarations ([basic.scope.scope]/4): a namespace-scope or block-scope variable
;; or function of a member's name, before or after the union, or another anonymous union's member; GCC's "redeclaration of
;; 'int v1'" (or "conflicting declaration"), at the later declaration (lookup/anon6.C, other/anon4.C).
(defn anon-union-redecls
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        report! (fn [n nm] (when-let [o (mine-at n main)]
                             (let [[l c] (line-col starts o)]
                               (.add out {:line l :col c :kind :error :rule :anon-union :msg (str "redeclaration of '" nm "'")}))))
        anon-union? (fn [n] (and (= "CXXRecordDecl" (:kind n)) (= "union" (:tagUsed n)) (nil? (:name n)) (:completeDefinition n)))]
    (letfn [(region! [nodes]
              ;; the region's declarations in order: [name node anon?]
              (let [seen (java.util.HashMap.)
                    xs (vec (mapcat (fn [n] (if (= "DeclStmt" (:kind n)) (filter map? (:inner n)) [n])) (filter map? nodes)))]
                (doseq [[i n] (map-indexed vector xs)]
                  (cond
                    ;; an anonymous union: followed by its implicit variable (not a named object of the union type)
                    (and (anon-union? n) (let [nx (get xs (inc i))] (and nx (= "VarDecl" (:kind nx)) (:isImplicit nx))))
                    (doseq [f (:inner n) :when (and (= "FieldDecl" (:kind f)) (string? (:name f)) (seq (:name f)))]
                      (if (.containsKey seen (:name f))
                        (report! n (:name f))
                        (.put seen (:name f) :anon)))
                    (and (#{"VarDecl" "FunctionDecl"} (:kind n)) (string? (:name n)) (seq (:name n)) (not (:isImplicit n)))
                    (when (= :anon (.get seen (:name n)))
                      (report! n (:name n)))
                    :else nil)
                  (when (and (#{"VarDecl" "FunctionDecl"} (:kind n)) (string? (:name n)) (seq (:name n)) (not (:isImplicit n))
                             (not (.containsKey seen (:name n))))
                    (.put seen (:name n) :decl)))
                ;; nested regions
                (doseq [n xs]
                  (case (:kind n)
                    "NamespaceDecl" (region! (:inner n))
                    ("FunctionDecl" "CXXMethodDecl" "CXXConstructorDecl" "CXXDestructorDecl")
                    (doseq [b (:inner n) :when (= "CompoundStmt" (:kind b))] (block! b))
                    ;; (a function template's and a class's member functions' bodies too)
                    ("FunctionTemplateDecl" "ClassTemplateDecl" "CXXRecordDecl")
                    (doseq [m (:inner n) :when (and (map? m) (#{"FunctionDecl" "CXXMethodDecl" "CXXConstructorDecl" "CXXDestructorDecl" "CXXRecordDecl" "FunctionTemplateDecl"} (:kind m)))]
                      (if (#{"CXXRecordDecl" "FunctionTemplateDecl"} (:kind m))
                        (region-nested! m)
                        (doseq [b (:inner m) :when (= "CompoundStmt" (:kind b))] (block! b))))
                    nil))))
            (region-nested! [m]
              (doseq [x (:inner m) :when (and (map? x) (#{"FunctionDecl" "CXXMethodDecl" "CXXConstructorDecl" "CXXDestructorDecl"} (:kind x)))]
                (doseq [b (:inner x) :when (= "CompoundStmt" (:kind b))] (block! b))))
            (block! [b]
              (region! (:inner b))
              (doseq [x (:inner b) :when (map? x)] (if (= "CompoundStmt" (:kind x)) (block! x) (stmts! x))))
            (stmts! [x]
              (cond (#{"CXXRecordDecl" "LambdaExpr"} (:kind x)) nil
                    :else (doseq [[k v] x :when (and (not= k :_ent) (coll? v))]
                            (doseq [y (if (map? v) [v] v) :when (map? y)]
                              (if (= "CompoundStmt" (:kind y)) (block! y) (when-not (#{"CXXRecordDecl" "LambdaExpr"} (:kind y)) (stmts! y)))))))]
      (region! (:nodes u)))
    (vec (distinct out))))

(swap! checks conj anon-union-redecls)

;; cpp-rind (2026-11-24): [dcl.fct.def.default]/2 as C++11-C++17 state it (C++20, P0641, makes most mismatches deleted instead): an
;; explicitly defaulted copy or move constructor or assignment operator has the implicit declaration's type but for the copy
;; operations' parameter `C&` for `const C&`: a volatile-qualified parameter, a const or volatile one of a move operation, an
;; assignment returning another type than `C&`, and in C++11 a constexpr assignment (C++11's constexpr member functions are const)
;; are GCC's "defaulted declaration 'T::T(volatile T&)' does not match the expected signature", at the declaration
;; (cpp0x/defaulted51.C, defaulted56.C, defaulted65.C, constexpr-68754.C).
(defn defaulted-signatures
  [u starts ^String src ^String main]
  (let [yr (long (cxx-year (:std u)))
        out (java.util.ArrayList.)]
    (when (<= 11 yr 17)
      (walk-nodes
        (fn [n _]
          (when (and (= "CXXRecordDecl" (:kind n)) (string? (:name n)) (seq (:name n)) (:completeDefinition n))
            (let [cn (:name n)
                  q (java.util.regex.Pattern/quote cn)
                  ref-re (re-pattern (str "^((?:const |volatile )*)" q "(?:<.*>)?\\s*(&&?)$"))]
              (doseq [m (:inner n)
                      :when (and (#{"CXXConstructorDecl" "CXXMethodDecl"} (:kind m)) (= "default" (:explicitlyDefaulted m)))
                      :let [ps (filter #(= "ParmVarDecl" (:kind %)) (:inner m))
                            ctor? (= "CXXConstructorDecl" (:kind m))
                            assign? (and (= "CXXMethodDecl" (:kind m)) (= "operator=" (:name m)))]
                      :when (and (or ctor? assign?) (= 1 (count ps)))
                      :let [pt (str/trim (str (get-in (first ps) [:type :qualType])))
                            [_ cv rk] (re-matches ref-re pt)
                            cv (str cv)
                            ret (when assign? (str/trim (first (str/split (str (get-in m [:type :qualType])) #"\("))))
                            bad (if (nil? rk)
                                  ;; (an assignment operator's parameter of the class type by value: defaulted69.C)
                                  (and assign? (re-matches (re-pattern (str "^(?:const |volatile )*" q "(?:<.*>)?$")) pt))
                                  (or (and (= "&" rk) (str/includes? cv "volatile"))
                                      (and (= "&&" rk) (or (str/includes? cv "const") (str/includes? cv "volatile")))
                                      (and assign? ret (not (re-matches (re-pattern (str q "(?:<.*>)?\\s*&")) ret)))
                                      (and assign? (= 11 yr) (:constexpr m))))]
                      :when bad]
                (when-let [o (mine-at m main)]
                  (let [[l c] (line-col starts o)]
                    (.add out {:line l :col c :kind :error :rule :defaulted :msg (str "defaulted declaration of '" (:name m) "' does not match the expected signature")})))))))
        (:nodes u) nil))
    (vec out)))

(swap! checks conj defaulted-signatures)

;; cpp-rind (2026-11-24): [basic.link]/8 (C++23 /11) with [dcl.stc]/? : a block-scope extern declaration (a variable declared extern,
;; or a function) declares an entity of the enclosing namespace, so it agrees with that namespace's earlier declaration of the name:
;; a variable of another type is GCC's "conflicting declaration 'char X'", a function of the same parameters and another return type
;; "ambiguating new declaration of 'char Y(int)'", at the block-scope declaration (lookup/extern-redecl1.C, tls/pr102642.C). The
;; global namespace's functions' bodies judged; types compared as written by the parser, arrays (an unknown bound) not judged.
(defn block-extern-conflicts
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        globals (java.util.HashMap.)
        report! (fn [n msg] (when-let [o (mine-at n main)]
                              (let [[l c] (line-col starts o)] (.add out {:line l :col c :kind :error :rule :block-extern :msg msg}))))
        qt (fn [n] (str/replace (str (get-in n [:type :qualType])) #"\s+" " "))
        split-fn (fn [^String t] (let [i (.indexOf t "(")] (when (pos? i) [(str/trim (subs t 0 i)) (subs t i)])))]
    (letfn [(block! [x]
              (cond (map? x)
                    (case (:kind x)
                      ("CXXRecordDecl" "LambdaExpr" "ClassTemplateDecl" "FunctionTemplateDecl") nil
                      "DeclStmt"
                      (doseq [d (:inner x) :when (and (map? d) (string? (:name d)) (seq (:name d)))]
                        (let [olds (.get globals (:name d)) o (long (or (mine-at d main) -1))
                              olds (filter #(< (long (:off %)) o) olds)]
                          (cond
                            (and (= "VarDecl" (:kind d)) (= "extern" (:storageClass d)) (not (str/includes? (qt d) "[")))
                            (when-let [g (first (filter #(= :var (:k %)) olds))]
                              (when (and (not= (:t g) (qt d)) (not (str/includes? (:t g) "[")))
                                (report! d (str "conflicting declaration '" (qt d) " " (:name d) "'"))))
                            (= "FunctionDecl" (:kind d))
                            (when-let [[r ps] (split-fn (qt d))]
                              (when (some (fn [g] (and (= :fn (:k g)) (= ps (:ps g)) (not= r (:r g)))) olds)
                                (report! d (str "ambiguating new declaration of '" (:name d) "'"))))
                            :else nil)))
                      (doseq [[k v] x :when (and (not= k :_ent) (coll? v))] (block! v)))
                    (sequential? x) (doseq [y x] (block! y))
                    :else nil))]
      (doseq [n (:nodes u) :when (and (map? n) (string? (:name n)) (seq (:name n)) (mine-at n main))]
        (case (:kind n)
          "VarDecl" (.put globals (:name n) (conj (vec (.get globals (:name n))) {:k :var :t (qt n) :off (mine-at n main)}))
          "FunctionDecl" (when-let [[r ps] (split-fn (qt n))]
                           (.put globals (:name n) (conj (vec (.get globals (:name n))) {:k :fn :r r :ps ps :off (mine-at n main)})))
          nil))
      (doseq [n (:nodes u) :when (and (map? n) (= "FunctionDecl" (:kind n)))]
        (doseq [b (:inner n) :when (and (map? b) (= "CompoundStmt" (:kind b)))] (block! b))))
    (vec (distinct out))))

(swap! checks conj block-extern-conflicts)

;; cpp-rind (2026-11-24): [dcl.link]/7 (C++23 /6): functions of one name declared with C language linkage in any namespaces are one
;; function, so their declarations agree in type: two of other parameter types are GCC's "conflicting C language linkage declaration
;; 'float Bob::fabsf(float, float)'", at the later one (lookup/extern-c-hidden.C); and /6 with [basic.link]: a variable first declared
;; with C++ language linkage and then in an `extern "C"` declaration of the same scope, GCC's "conflicting declaration of 'int i' with
;; 'C' linkage" (lookup/linkage1.C). The main file's declarations, by name.
(defn c-linkage-agreement
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        cfns (java.util.HashMap.)
        vars (java.util.HashMap.)
        report! (fn [n msg] (when-let [o (mine-at n main)]
                              (let [[l c] (line-col starts o)] (.add out {:line l :col c :kind :error :rule :c-linkage :msg msg}))))
        ps-of (fn [n] (let [t (str/replace (str (get-in n [:type :qualType])) #"\s+" " ") i (.indexOf t "(")]
                        (when (pos? i) (subs t i))))
        nothrow? (fn [^String ps] (boolean (re-find #"\)\s*(throw\s*\(\s*\)|noexcept)\s*$" ps)))
        bare (fn [^String ps] (str/replace ps #"\)\s*(throw\s*\(\s*\)|noexcept)\s*$" ")"))]
    (letfn [(w [nodes lang path]
              (doseq [n nodes :when (map? n)]
                (case (:kind n)
                  "LinkageSpecDecl" (w (:inner n) (:language n) path)
                  "NamespaceDecl" (w (:inner n) lang (conj path (or (:name n) "")))
                  "FunctionDecl"
                  (when (and (= "C" lang) (string? (:name n)) (mine-at n main) (not (str/includes? (str (:name n)) "::")))
                    (when-let [ps (ps-of n)]
                      ;; (the parameters' disagreement is linkage-conflicts' ("conflicting C language linkage declaration");
                      ;; here the same parameters with another exception specification, lookup/extern-c-redecl.C)
                      (if-let [[ops on] (.get cfns (:name n))]
                        (when (and (= (bare ops) (bare ps)) (not= (nothrow? ops) (nothrow? ps)))
                          (report! n (str "conflicting C language linkage declaration of '" (:name n) "' (exception specifications)")))
                        (.put cfns (:name n) [ps n]))))
                  "VarDecl"
                  (when (and (string? (:name n)) (mine-at n main))
                    (let [k [path (:name n)] old (.get vars k)]
                      (cond (nil? old) (.put vars k (or lang "C++"))
                            (and (= "C++" old) (= "C" lang)) (report! n (str "conflicting declaration of '" (:name n) "' with 'C' linkage"))
                            :else nil)))
                  nil)))]
      (w (:nodes u) nil []))
    (vec (distinct out))))

(swap! checks conj c-linkage-agreement)

;; cpp-rind (2026-11-24): [stmt.label]/1, a label's name is declared once in its function (a lambda's body and a local class's
;; member functions are functions of their own): a second is GCC's "duplicate label 'L'", at it (other/label1.C).
(defn duplicate-labels
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        fn-kinds #{"FunctionDecl" "CXXMethodDecl" "CXXConstructorDecl" "CXXDestructorDecl" "CXXConversionDecl"}]
    (letfn [(body! [b]
              (let [seen (java.util.HashSet.)
                    ;; (cpp-rind: and a goto's label defined nowhere in its function, [stmt.goto]/1: GCC's "label 'lab' used but
                    ;; not defined", at the goto; ext/timevar1.C)
                    gotos (java.util.ArrayList.)]
                (letfn [(w [x]
                          (cond (map? x)
                                (cond
                                  (= "LambdaExpr" (:kind x)) (doseq [y (:inner x) :when (and (map? y) (= "CompoundStmt" (:kind y)))] (body! y))
                                  (#{"CXXRecordDecl" "ClassTemplateDecl"} (:kind x)) (top! [x])
                                  :else (do (when (and (= "GotoStmt" (:kind x)) (string? (:label x))) (.add gotos x))
                                            (when (and (= "LabelStmt" (:kind x)) (string? (:name x)))
                                              (if (.contains seen (:name x))
                                                (when-let [o (mine-at x main)]
                                                  (let [[l c] (line-col starts o)]
                                                    (.add out {:line l :col c :kind :error :rule :label :msg (str "duplicate label '" (:name x) "'")})))
                                                (.add seen (:name x))))
                                            (doseq [[k v] x :when (and (not= k :_ent) (coll? v))] (w v))))
                                (sequential? x) (doseq [y x] (w y))
                                :else nil))]
                  (w b)
                  (doseq [g gotos :when (not (.contains seen (:label g)))]
                    (when-let [o (mine-at g main)]
                      (let [[l c] (line-col starts o)]
                        (.add out {:line l :col c :kind :error :rule :label :msg (str "label '" (:label g) "' used but not defined")})))))))
            (top! [nodes]
              (doseq [n nodes :when (map? n)]
                (cond (fn-kinds (:kind n)) (doseq [b (:inner n) :when (and (map? b) (#{"CompoundStmt" "CXXTryStmt"} (:kind b)))] (body! b))
                      (#{"NamespaceDecl" "LinkageSpecDecl" "CXXRecordDecl" "ClassTemplateDecl" "FunctionTemplateDecl" "ClassTemplatePartialSpecializationDecl"} (:kind n))
                      (top! (:inner n))
                      :else nil)))]
      (top! (:nodes u)))
    (vec (distinct out))))

(swap! checks conj duplicate-labels)

;; cpp-rind (2026-11-24): [dcl.constexpr]/3 (C++11-C++23 /4): a constexpr constructor's or destructor's class has no virtual base
;; class: GCC's "'constexpr' constructor in 'struct B' that has virtual base classes", at the constructor; cpp0x/constexpr-ice4.C.
(defn constexpr-virtual-bases
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)]
    (walk-nodes (fn [n _]
                  (when (and (= "CXXRecordDecl" (:kind n)) (:completeDefinition n) (some :isVirtual (:bases n)))
                    (doseq [m (:inner n) :when (and (map? m) (#{"CXXConstructorDecl" "CXXDestructorDecl"} (:kind m)) (:constexpr m))]
                      (when-let [o (mine-at m main)]
                        (let [[l c] (line-col starts o)]
                          (.add out {:line l :col c :kind :error :rule :constexpr-vbase
                                     :msg (str "'constexpr' " (if (= "CXXConstructorDecl" (:kind m)) "constructor" "destructor") " in '" (:name n) "' that has virtual base classes")}))))))
                (:nodes u) nil)
    (vec (distinct out))))

(swap! checks conj constexpr-virtual-bases)

;; cpp-rind (2026-11-24): [dcl.constexpr]/3 of C++14-C++20 (P2242 lifts it in C++23): a constexpr function's body holds no label
;; definition (case and default labels aside): GCC's pedwarn "label definition in 'constexpr' function only available with
;; '-std=c++23'", an error under -pedantic-errors, at the label; cpp1y/constexpr-label.C.
(defn constexpr-labels
  [u starts ^String src ^String main]
  (when (and (some #{"-pedantic-errors"} (:args u)) (<= 14 (long (cxx-year (:std u))) 20))
    (let [out (java.util.ArrayList.)]
      (letfn [(body! [x]
                (cond (map? x) (when-not (#{"LambdaExpr" "CXXRecordDecl"} (:kind x))
                                 (when (and (= "LabelStmt" (:kind x)) (string? (:name x)))
                                   (when-let [o (mine-at x main)]
                                     (let [[l c] (line-col starts o)]
                                       (.add out {:line l :col c :kind :error :rule :constexpr-label :msg "label definition in 'constexpr' function only available with '-std=c++23'"}))))
                                 (doseq [[k v] x :when (and (not= k :_ent) (coll? v))] (body! v)))
                      (sequential? x) (doseq [y x] (body! y))
                      :else nil))]
        (walk-nodes (fn [n _]
                      (when (and (#{"FunctionDecl" "CXXMethodDecl" "CXXConstructorDecl"} (:kind n)) (:constexpr n))
                        (doseq [b (:inner n) :when (and (map? b) (= "CompoundStmt" (:kind b)))] (body! b))))
                    (:nodes u) nil))
      (vec (distinct out)))))

(swap! checks conj constexpr-labels)

;; cpp-rind (2026-11-24): [class.mfct]/? with [special]/? : a constructor or destructor defined out of its class is declared in it; a
;; class that declares none has only the implicit one, which no definition may define: GCC's "definition of implicitly-declared
;; 'A::A()'", at the definition (other/ctor1.C, ctor2.C, dtor1.C). The main file's namespace-scope classes by name, defined once.
(defn implicit-special-definitions
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        recs (java.util.HashMap.)
        dup (java.util.HashSet.)]
    (letfn [(collect! [nodes]
              (doseq [n nodes :when (map? n)]
                (case (:kind n)
                  "CXXRecordDecl" (when (and (string? (:name n)) (seq (:name n)) (:completeDefinition n))
                                    (if (.containsKey recs (:name n)) (.add dup (:name n)) (.put recs (:name n) n)))
                  ("NamespaceDecl" "LinkageSpecDecl") (collect! (:inner n))
                  nil)))
            (judge! [nodes]
              (doseq [n nodes :when (map? n)]
                (case (:kind n)
                  ("CXXConstructorDecl" "CXXDestructorDecl")
                  (let [dtor? (= "CXXDestructorDecl" (:kind n))
                        cn (str/replace (str (:name n)) #"^~" "")
                        r (when-not (.contains dup cn) (.get recs cn))]
                    (when (and r (mine-at n main)
                               ;; (written `A::A` or `A::~A` with no other qualifier before: a nested class's of the same name not)
                               (let [o (long (mine-at n main)) before (subs src (max 0 (- o 200)) o)]
                                 (re-find (re-pattern (str "(?:^|[^:\\w])" (java.util.regex.Pattern/quote cn) "\\s*::\\s*~?\\s*$")) before))
                               (not-any? #(and (map? %) (= (:kind %) (:kind n)) (not (:isImplicit %))) (:inner r)))
                      (let [[l c] (line-col starts (long (mine-at n main)))]
                        (.add out {:line l :col c :kind :error :rule :implicit-special
                                   :msg (str "definition of implicitly-declared '" cn "::" (if dtor? "~" "") cn "()'")}))))
                  ("NamespaceDecl" "LinkageSpecDecl") (judge! (:inner n))
                  nil)))]
      (collect! (:nodes u))
      (judge! (:nodes u)))
    (vec (distinct out))))

(swap! checks conj implicit-special-definitions)

;; cpp-rind (2026-11-24): [dcl.fct.default]/4 (C++23 /4): a friend declaration that specifies a default argument is a definition and
;; the function's only declaration in the translation unit: another declaration of that function, a friend's in a class or one at
;; namespace scope, before or after, is GCC's "friend declaration 'int foo(bool)' specifies default arguments and isn't the only
;; declaration", at the later one (other/friend10.C, friend11.C, friend13.C). Functions by name and parameter types as written.
(defn friend-default-only
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        decls (java.util.ArrayList.) ; [key node friend-with-defaults?]
        key-of (fn [n] [(:name n) (str/replace (str (get-in n [:type :qualType])) #"\s+" "")])
        dflt? (fn [n] (some #(and (= "ParmVarDecl" (:kind %)) (= "c" (:init %))) (:inner n)))
        fnode (fn [x] (cond (= "FunctionDecl" (:kind x)) x
                            (= "FunctionTemplateDecl" (:kind x)) (some #(when (= "FunctionDecl" (:kind %)) %) (:inner x))
                            :else nil))]
    (letfn [(w [nodes]
              (doseq [n nodes :when (map? n)]
                (case (:kind n)
                  ("FunctionDecl" "FunctionTemplateDecl")
                  (when-let [f (fnode n)] (when (string? (:name f)) (.add decls [(key-of f) f false])))
                  "FriendDecl" (doseq [x (:inner n) :when (map? x)]
                                 (when-let [f (fnode x)]
                                   (when (and (string? (:name f)) (not (str/includes? (str (:name f)) "::")))
                                     (.add decls [(key-of f) f (boolean (and (dflt? f) (some #(= "CompoundStmt" (:kind %)) (:inner f))))]))))
                  ("CXXRecordDecl" "NamespaceDecl" "LinkageSpecDecl" "ClassTemplateDecl") (w (:inner n))
                  nil)))]
      (w (:nodes u)))
    (let [ds (vec (sort-by #(long (or (mine-at (second %) main) -1)) decls))]
      (doseq [[k n fd] ds :when fd
              [k2 n2 _] ds :when (and (= k k2) (not (identical? n n2)))]
        (let [later (if (< (long (or (mine-at n main) 0)) (long (or (mine-at n2 main) 0))) n2 n)]
          (when-let [o (mine-at later main)]
            (let [[l c] (line-col starts o)]
              (.add out {:line l :col c :kind :error :rule :friend-default
                         :msg (str "friend declaration '" (first k) "' specifies default arguments and isn't the only declaration")}))))))
    (vec (distinct out))))

(swap! checks conj friend-default-only)
;; cpp-singles (2026-11-24): DR 1612 ([expr.prim.lambda.capture]/? of C++14-C++23, "an entity that is a member of an anonymous union
;; shall not be captured"): in a lambda's compound-statement, a member of an anonymous union of automatic storage declared in an
;; enclosing block outside the lambda, named there (the native parser's MemberExpr over the union's unnamed variable), is captured,
;; implicitly or explicitly: GCC's "cannot capture member 'a' of anonymous union", at the name's first use in the lambda.
;; cpp0x/lambda/lambda-anon1.C. A static anonymous union's members are not captured; unevaluated operands not told apart.

(defn anon-union-captures
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        report! (fn [n msg] (when-let [o (mine-at n main)] (let [[l c] (line-col starts o)] (.add out {:line l :col c :kind :error :rule :lambda-capture :msg msg}))))
        anon-members (fn [ds]
                       ;; a DeclStmt's anonymous union of automatic storage: its members' names
                       (let [xs (:inner ds)]
                         (when (and (vector? xs)
                                    (some #(and (= "CXXRecordDecl" (:kind %)) (= "union" (:tagUsed %)) (nil? (:name %)) (:completeDefinition %)) xs)
                                    (some #(and (= "VarDecl" (:kind %)) (:isImplicit %) (not (#{"static" "extern"} (:storageClass %)))) xs))
                           (for [r xs :when (= "CXXRecordDecl" (:kind r)) f (:inner r) :when (and (= "FieldDecl" (:kind f)) (string? (:name f)) (seq (:name f)))]
                             (:name f)))))]
    (letfn [(walk [x env cap seen]
              (cond
                (map? x)
                (cond
                  (= "LambdaExpr" (:kind x)) (let [seen (java.util.HashSet.)] (doseq [[k v] x :when (and (not= k :_ent) (coll? v))] (walk v env env seen)))
                  (and cap (= "MemberExpr" (:kind x)) (contains? cap (:name x))
                       (let [o (first (:inner x))] (and (= "DeclRefExpr" (:kind o)) (= "" (get-in o [:referencedDecl :name])))))
                  (do (when (.add ^java.util.HashSet seen (:name x))
                        (report! x (str "cannot capture member '" (:name x) "' of anonymous union")))
                      (doseq [y (rest (:inner x))] (walk y env cap seen)))
                  (= "CompoundStmt" (:kind x))
                  (loop [ys (:inner x) env env]
                    (when-let [y (first ys)]
                      (walk y env cap seen)
                      (recur (rest ys) (if (= "DeclStmt" (:kind y)) (into env (anon-members y)) env))))
                  :else (doseq [[k v] x :when (and (not= k :_ent) (coll? v))] (walk v env cap seen)))
                (or (vector? x) (seq? x)) (doseq [y x] (walk y env cap seen))
                :else nil))]
      (walk (:nodes u) #{} nil nil))
    (vec out)))

(swap! checks conj anon-union-captures)

;; cpp-singles (2026-11-24): [class.static.mfct]/2 with [class.virtual]/2: a static member function of a derived class with the name
;; and parameter-type-list of a virtual function of a base would override it, and a static member function is not virtual: GCC's
;; "'static void B::foo5()' cannot be declared", at it, and "since 'virtual void A::foo5()' declared in base class", an error at the
;; base's function too; inherit/pure1.C. Classes of the main file named by a plain name, the bases followed through them; a
;; template's not judged.

(defn static-overrides
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        report! (fn [n msg] (when-let [o (mine-at n main)] (let [[l c] (line-col starts o)] (.add out {:line l :col c :kind :error :rule :static-override :msg msg}))))
        classes (java.util.HashMap.)
        _ (walk-nodes (fn [n parent]
                        (when (and (= "CXXRecordDecl" (:kind n)) (:completeDefinition n) (string? (:name n)) (seq (:name n))
                                   (not (and parent (#{"ClassTemplateDecl" "ClassTemplatePartialSpecializationDecl"} (:kind parent))))
                                   (mine-at n main))
                          (if (.containsKey classes (:name n)) (.put classes (:name n) ::ambiguous) (.put classes (:name n) n))))
                      (:nodes u) nil)
        params (fn [m] (let [^String qt (str (get-in m [:type :qualType])) i (.indexOf qt "(")]
                         (when (pos? i)
                           (loop [j i d 0]
                             (when (< j (.length qt))
                               (let [c (.charAt qt j) d (case c \( (inc d) \) (dec d) d)]
                                 (if (zero? d) (str/replace (subs qt i (inc j)) #"\s+" "") (recur (inc j) d))))))))
        virtuals (fn virtuals [n seen]
                   (mapcat (fn [b] (let [bn (str/trim (str (get-in b [:type :qualType])))
                                         c (.get classes bn)]
                                     (when (and (map? c) (re-matches #"[A-Za-z_]\w*" bn) (not (contains? seen bn)))
                                       (concat (filter #(and (= "CXXMethodDecl" (:kind %)) (:virtual %)) (:inner c))
                                               (virtuals c (conj seen bn))))))
                           (:bases n)))]
    (doseq [[_ n] classes :when (map? n) :when (seq (:bases n))
            :let [vs (virtuals n #{(:name n)})]
            :when (seq vs)
            m (:inner n) :when (and (= "CXXMethodDecl" (:kind m)) (= "static" (:storageClass m)) (string? (:name m)))
            :let [p (params m) v (first (filter #(and (= (:name %) (:name m)) (= (params %) p)) vs))]
            :when (and p v)]
      (report! m (str "'static " (:name n) "::" (:name m) "' cannot be declared"))
      (report! v (str "since 'virtual " (:name m) "' declared in base class")))
    (vec out)))

(swap! checks conj static-overrides)

;; cpp-rind (2026-11-24): [over.load]/2.3 (C++23 [basic.scope.scope]/? ): member function declarations of one name and parameter-type-
;; list, with and without a ref-qualifier, do not overload: GCC's "'void Y::i() const' cannot be overloaded with 'void Y::i() &'", at
;; the later one (cpp0x/ref-qual5.C). The main file's classes' member functions, templates' aside.
(defn ref-qualifier-overloads
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)]
    (walk-nodes (fn [n _]
                  (when (and (= "CXXRecordDecl" (:kind n)) (:completeDefinition n))
                    (let [ms (for [m (:inner n) :when (and (map? m) (= "CXXMethodDecl" (:kind m)) (string? (:name m)) (mine-at m main))
                                   :let [t (str/replace (str (get-in m [:type :qualType])) #"\s+" " ")
                                         i (.indexOf t "(") j (.lastIndexOf t ")")]
                                   :when (and (pos? i) (> j i))]
                               {:node m :key [(:name m) (subs t i (inc j))] :ref (boolean (re-find #"&\s*$" (subs t (inc j))))})]
                      (doseq [[_ g] (group-by :key ms) :when (and (some :ref g) (some (complement :ref) g))]
                        (let [g (sort-by #(long (mine-at (:node %) main)) g)
                              first-ref (:ref (first g))]
                          (doseq [x (rest g) :when (not= (:ref x) first-ref)]
                            (let [[l c] (line-col starts (long (mine-at (:node x) main)))]
                              (.add out {:line l :col c :kind :error :rule :ref-qualifier
                                         :msg (str "'" (:name (:node x)) "' cannot be overloaded with and without a ref-qualifier")}))))))))
                (:nodes u) nil)
    (vec (distinct out))))

(swap! checks conj ref-qualifier-overloads)

;; cpp-rind (2026-11-24): [dcl.array]/1, an array bound is a converted constant expression: a block-scope array whose bound names a
;; function parameter or a local variable that is neither const nor constexpr is GNU's variable length array, GCC's pedwarn "ISO C++
;; forbids variable length array 'a'", an error under -pedantic-errors, at the variable (cpp1y/pr63996.C). sizeof, alignof and
;; decltype operands aside; a const local's bound not judged (it may be constant).
(defn vla-pedantic
  [u starts ^String src ^String main]
  (when (some #{"-pedantic-errors"} (:args u))
    (let [out (java.util.ArrayList.)
          vla? (fn [^String qt runtime]
                 (some (fn [[_ b]] (some #(contains? runtime %)
                                         (re-seq #"[A-Za-z_]\w*" (-> b (str/replace #"\b(?:sizeof|alignof|__alignof__|_Alignof|decltype|__typeof__|typeof)\s*\([^()]*\)" "")
                                                                      (str/replace #"\bsizeof\s+\w+" "")))))
                       (re-seq #"\[([^\[\]]+)\]" qt)))]
      (doseq [f (:nodes u) :when (#{"FunctionDecl" "CXXMethodDecl"} (:kind f))]
        (let [runtime (java.util.HashSet.)]
          (doseq [pv (:inner f) :when (and (= "ParmVarDecl" (:kind pv)) (string? (:name pv)) (not (re-find #"\bconst\b" (str (get-in pv [:type :qualType])))))]
            (.add runtime (:name pv)))
          (letfn [(w [x]
                    (cond (map? x)
                          (when-not (#{"LambdaExpr" "CXXRecordDecl"} (:kind x))
                            (when (= "VarDecl" (:kind x))
                              (let [qt (str (get-in x [:type :qualType]))]
                                (when (and (string? (:name x)) (not (#{"extern"} (:storageClass x))) (vla? qt runtime))
                                  (when-let [o (mine-at x main)]
                                    (let [[l c] (line-col starts o)]
                                      (.add out {:line l :col c :kind :error :rule :vla :msg (str "ISO C++ forbids variable length array '" (:name x) "'")}))))
                                (when (and (string? (:name x)) (not (:constexpr x)) (not (re-find #"^\s*const\b|\bconst\s*$" qt)))
                                  (.add runtime (:name x)))))
                            (doseq [[k v] x :when (and (not= k :_ent) (coll? v))] (w v)))
                          (sequential? x) (doseq [y x] (w y))
                          :else nil))]
            (doseq [b (:inner f) :when (and (map? b) (= "CompoundStmt" (:kind b)))] (w b)))))
      (vec (distinct out)))))

(swap! checks conj vla-pedantic)

;; cpp-rind (2026-11-24): GNU's warn_unused_result (the GCC 15.2 manual's "Common Function Attributes"): a call of such a function
;; whose value an expression statement discards is warned (-Wunused-result, on by default), an error under -Werror=unused-result or
;; -Werror: GCC's "ignoring return value of 'QByteArray QString::toLocal8Bit() const', declared with attribute 'warn_unused_result'",
;; at the call (warn/unused-result1-Werror.C). The main file's functions by name; a cast to void discards nothing to warn of.
(defn unused-result-werror
  [u starts ^String src ^String main]
  (when (and (some #{"-Werror=unused-result" "-Werror"} (:args u)) (not (some #{"-Wno-unused-result"} (:args u))))
    (let [out (java.util.ArrayList.)
          wur (java.util.HashSet.)]
      (walk-nodes (fn [n _]
                    (when (and (#{"FunctionDecl" "CXXMethodDecl"} (:kind n)) (string? (:name n))
                               (some #(and (= "NativeAttr" (:kind %)) (#{"warn_unused_result" "__warn_unused_result__"} (:_gnu %))) (:inner n)))
                      (.add wur (:name n))))
                  (:nodes u) nil)
      (when (pos? (.size wur))
        (walk-nodes (fn [n _]
                      (when (= "CompoundStmt" (:kind n))
                        (doseq [x (:inner n) :when (and (map? x) (str/ends-with? (str (:kind x)) "CallExpr"))]
                          (let [callee (first (filter map? (:inner x)))
                                nm (when (#{"MemberExpr" "DeclRefExpr"} (:kind callee)) (or (:name callee) (get-in callee [:referencedDecl :name])))]
                            (when (and nm (.contains wur nm))
                              (when-let [o (mine-at x main)]
                                (let [[l c] (line-col starts o)]
                                  (.add out {:line l :col c :kind :error :rule :unused-result
                                             :msg (str "ignoring return value of '" nm "', declared with attribute 'warn_unused_result'")}))))))))
                    (:nodes u) nil))
      (vec (distinct out)))))

(swap! checks conj unused-result-werror)

;; cpp-rind (2026-11-24): [basic.def.odr]/1 with [temp.expl.spec]: an explicit specialization of a function template is defined once
;; (a body, or = delete / = default): a second definition of one with the same written template arguments and type is GCC's
;; "redefinition of 'void foo<int>(int)'", at the second (cpp0x/pr79361-1.C, pr79361-2.C). Namespace-scope specializations whose
;; arguments are written.
(defn explicit-spec-redefinitions
  [u starts ^String src ^String main]
  (let [out (java.util.ArrayList.)
        seen (java.util.HashSet.)
        targ-text (fn [a] (or (get-in a [:type :qualType]) (pr-str (mapv #(or (:value %) (:kind %)) (filter map? (:inner a))))))]
    (letfn [(w [nodes path]
              (doseq [n nodes :when (map? n)]
                (case (:kind n)
                  ("NamespaceDecl" "LinkageSpecDecl") (w (:inner n) (conj path (str (:name n))))
                  ("FunctionDecl" "VarDecl")
                  (let [targs (filter #(and (map? %) (= "TemplateArgument" (:kind %))) (:inner n))]
                    (when (and (seq targs) (string? (:name n)) (mine-at n main)
                               (if (= "VarDecl" (:kind n))
                                 ;; (a variable template's explicit specialization with an initializer: its definition, cpp1y/var-templ13.C)
                                 (and (:init n) (not= "extern" (:storageClass n)))
                                 (or (:explicitlyDeleted n) (:explicitlyDefaulted n) (some #(= "CompoundStmt" (:kind %)) (:inner n)))))
                      (let [k [path (:name n) (str (get-in n [:type :qualType])) (mapv targ-text targs)]]
                        (if (.contains seen k)
                          (let [[l c] (line-col starts (long (mine-at n main)))]
                            (.add out {:line l :col c :kind :error :rule :redefinition :msg (str "redefinition of the explicit specialization '" (:name n) "'")}))
                          (.add seen k)))))
                  nil)))]
      (w (:nodes u) []))
    (vec out)))

(swap! checks conj explicit-spec-redefinitions)

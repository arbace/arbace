                  ;; name, cv-qualified or not) is GCC's "field 's' has incomplete type", at the name)
                  _ (when (and field nm (not (skim? p)) (= :n (:t ty)) (not (:args (peek (:parts (:qn ty)))))
                               (some-> (:ent ty) :scope (identical? (:scope (:ent (class-ctx p))))))
                      (soft-diag! p ni (str "field '" nm "' has incomplete type '" (qt ty) "'")))
                  e (cond x (last-ix p) bits (ne bits) :else (long (:e d)))
                  ;; a class template's arguments deduced from the initializer (class template argument deduction)
                  ;; (CP311 (a): the placeholder as written, :_ctad, for the checker's and the code generator's own deduction,
                  ;; arbace.cpp.template/ctad; a :_ key, the tree compared with clang's unchanged)
                  ctad0 (when (and x (= :n (:t ty)) (:tmpl (:ent ty)) (not (:args (peek (:parts (:qn ty)))))) (qt ty))
                  ty (if (and x (= :n (:t ty)) (:tmpl (:ent ty)) (not (:args (peek (:parts (:qn ty))))) (not (in-template? p)))
                       (if-let [s (sema/ctad ty init x qt respell)] (assoc ty :s s) ty)
                       ty)
                  x (when x (if (= init "call") (paren-init p ty x) (designate p ty x)))
                  _ (when-not (or field (= ctx :member) (:friend ds) (= "extern" (:storage ds)) (:typedef ds))
                      (use-var-init! p ty init x))
                  ty (if (and (:constexpr ds) (not field) (not (#{:lr :rr} (:t ty)))) (with-cv ty true nil) ty)
                  ;; (CP294 (a): the declarator's unknown GNU attributes, and the declaration-specifiers' for the first)
                  ga (vec (concat (when (empty? out) (gattrs-in p (long (or (:gb ds) (:b ds))) (dec (long (:b d))))) (gattrs-in p (:b d) (last-ix p))))
                  n (if field
                      (node p "FieldDecl" (:b ds) e
                            (cond-> {:name nn :loc (loc p ni) :type {:qualType (qt ty)}
                                     :inner (vec (concat (when bits [bits]) (when x [x]) (:attrs ds) (:attrs d) as1))}
                              (:mutable ds) (assoc :mutable true)
                              bits (assoc :isBitfield true)
                              x (assoc :hasInClassInitializer true)
                              (seq ga) (assoc :_gattrs ga)))
                      (node p "VarDecl" (:b ds) e
                            (cond-> {:name nn :loc (loc p ni) :type {:qualType (qt ty)}
                                     :inner (vec (concat (:attrs ds) (:attrs d) as1 (when x [x])))
                                     :_qtmpl (count (filter :args (butlast (:parts qn))))}
                              (#{"static" "extern"} (:storage ds)) (assoc :storageClass (:storage ds))
                              (:inline ds) (assoc :inline true)
                              (:constexpr ds) (assoc :constexpr true)
                              (:tls ds) (assoc :tls (:tls ds))
                              (:constinit ds) (assoc :_constinit true)
                              (and al (= "register" (:storage ds))) (assoc :_asmreg true)
                              init (assoc :init init)
                              (:args lp) (assoc :_args (:args lp))
                              ctad0 (assoc :_ctad ctad0)
                              ;; (cpp-rt-own4, DECISION cpp-rt-own3-1 (a): the declarator's array bounds as parsed, outermost
                              ;; first, when one is no literal: a GNU variable-length array's bound, analyzed by the code
                              ;; generator's sema where the bound is no constant; a :_ key, the tree compared with clang's
                              ;; unchanged)
                              (some #(and (:x %) (not= "IntegerLiteral" (:kind (:x %)))) (filter :a (:sufs d)))
                              (assoc :_vla (mapv :x (filter :a (:sufs d))))
                              ;; (queue 411: the qualifier's tokens after macro expansion, as a function's :_qual, the code
                              ;; generator's: limits.cc's INT_N(__GLIBCXX_TYPE_INT_N_0), `const bool numeric_limits<__int128>::
                              ;; is_specialized;` written by a macro, whose source text sema's qualifier-before cannot read)
                              (and *full-headers* (:q qn) (> (count (:parts qn)) 1) (:i (first (:parts qn))))
                              (assoc :_qual (tok-text p (long (:i (first (:parts qn)))) (dec (long ni))))
                              (seq ga) (assoc :_gattrs ga))))]
              (when (and nm (nil? (:args lp)) (not (and (:undeclared-type ds) (= ctx :block)))) (declare! p (cond-> {:k :var :name nm :tmpl (boolean (and tmpl (pos? (long (:n tmpl))))) :ty ty :vat ni}
                                                             (and (= :auto (:t ty)) (= "LambdaExpr" (:kind x))) (assoc :closure true)
                                                             (= "static" (:storage ds)) (assoc :static true)
                                                             (= "C" *linkage*) (assoc :clink true))))
              (cond
                ;; (cpp-read, 2026-11-22: a structured binding after another declarator, `auto m = x, [a, b] = y;`: GCC's
                ;; "expected unqualified-id before '[' token", the declaration ended)
                (and (is? p ",") (is-at? p 1 "[") (not (is-at? p 2 "[")) (= :auto (:t (:type ds))) (not (skim? p)) (main-tok? p (ix p)))
                (do (soft-diag! p (inc (ix p)) "expected unqualified-id before '[' token") (skip-until! p #{";"}) (expect! p ";") (conj out n))
                (decl-comma! p) (recur (conj out n))
                (accept! p ";") (conj out n)
                ;; cpp-read (2026-11-22): a member declarator followed by neither , nor ;: GCC's "expected ';' at end of member
                ;; declaration" at the declarator's last token, the semicolon assumed (cp_parser_member_declaration's
                ;; assume_semicolon: no skipping into a later member's body)
                (and (= ctx :member) (not (skim? p)) (not (eof? p)))
                (do (soft-diag! p (last-ix p) "expected ';' at end of member declaration") (conj out (assoc n :_semi-missing true)))
                :else (perr p "a declaration")))))))))

;; ---------------------------------------------------------------------------------------------
;; Templates (clang's ParseTemplate.cpp)

(defn- skip-targ!
  "Skim mode: a default template argument skipped to the , or > that ends it."
  [^P p]
  (loop [d 0]
    (let [^T t (cur p)]
      (cond (identical? :eof (.-k t)) nil
            (and (zero? d) (or (t= t ",") (t= t ">"))) nil
            (t= t "<") (do (adv! p) (recur (inc d)))
            (t= t ">") (do (adv! p) (recur (dec d)))
            (or (t= t "(") (t= t "[") (t= t "{")) (do (skip-balanced! p) (recur d))
            (or (t= t ";") (t= t ")") (t= t "}")) nil
            :else (do (adv! p) (recur d))))))

(defn- parse-template-params
  "A template-parameter-list after its < (the > not consumed): [nodes names], each parameter declared."
  [^P p]
  (if (is? p ">")
    [[] []]
    (loop [ns [] names [] nreq nil]
      (let [b (ix p)
            ;; D342-3 (a): whether this parameter has a default argument (its own `=`, not one inside a template template
            ;; parameter's list or a type's tokens), skimmed or parsed
            hd (volatile! false)
            [n nm]
            (cond
              ;; a type parameter by clang's isStartOfTemplateTypeParameter ([temp.param]/2): class or typename followed by
              ;; ..., ",", >, >> or =, or by an identifier and then ",", >, >> or =; otherwise (typename enable_if<...>::type
              ;; = true, typename X::y, class N::C) the type of a non-type parameter (cpp-route: std::pair's C++17
              ;; constructors, whose template headers were declined from typename enable_if< on)
              (and (or (is? p "class") (is? p "typename"))
                   (let [tp-end? (fn [k] (or (is-at? p k ",") (is-at? p k ">") (is-at? p k ">>") (is-at? p k "=")))]
                     (or (is-at? p 1 "...") (tp-end? 1)
                         (and (identical? :id (tk (nxt p 1))) (tp-end? 2)))))
              (let [kw (ts (cur p))]
                (adv! p)
                (let [pack (accept! p "...")
                      nm (when (id? p) (ts (cur p)))
                      ni (if nm (let [i (ix p)] (adv! p) i) (ix p))
                      dflt (when (and (accept! p "=") (vreset! hd true)) (if (skim? p) (do (skip-targ! p) nil) (with-gt p false (parse-type-id p :targ))))]
                  (when nm (sc/declare! (scope p) (cond-> {:k :type :name nm :tparam true} pack (assoc :pack true))))
                  [(node p "TemplateTypeParmDecl" b (last-ix p)
                         (cond-> {:tagUsed kw :loc (loc p ni) :inner (if dflt [{:kind "TemplateArgument" :type {:qualType (qt dflt)}}] [])}
                           nm (assoc :name nm) pack (assoc :isParameterPack true) dflt (assoc :_dflt dflt)))
                   (when nm (str nm (when pack "...")))]))
              (is? p "template")
              (let [_ (adv! p) _ (expect! p "<")
                    ;; (queue 518: its own parameters kept, :_tparams, for the checker's match of a template template argument)
                    ;; (cpp-tpl2: and its own requires-clause, parsed in its parameters' scope, :_treq, a private key no tree
                    ;; check reads: the checker's match of a template template argument's constraints)
                    [tps treq] (with-scope p :tparams nil
                                 (let [[tps] (parse-template-params p)]
                                   (expect! p ">")
                                   [tps (when (is? p "requires") (requires-clause! p))]))]
                  ;; (h-cpp-read: [temp.param]/1's type-parameter-key: GCC's "expected 'class' or 'typename' before" another
                  ;; token, the parameter taken; concept and auto, P2841's template parameters, left alone)
                  (cond (or (is? p "class") (is? p "typename")) (adv! p)
                        (or (is? p "concept") (is? p "auto")) nil
                        :else (do (soft-diag! p (ix p) (str "expected 'class' or 'typename' before '" (ts (cur p)) "'"))
                                  (when (or (is? p "struct") (is? p "union")) (adv! p))))
                  (let [pack (accept! p "...")
                        nm (when (id? p) (ts (cur p)))
                        ni (ix p)
                        _ (when nm (adv! p))]
                    (when (and (accept! p "=") (vreset! hd true)) (skip-targ! p))
                    (when nm (sc/declare! (scope p) {:k :type :name nm :tmpl true :tparam true}))
                    ;; (round 54, fourth pass: a pack's fact and the name's place kept apart, :_pack and :_loc, for the
                    ;; template-heads' comparison alone)
                    [(node p "TemplateTemplateParmDecl" b (last-ix p) (cond-> {:_tparams (vec tps)} nm (assoc :name nm :_loc (loc p ni)) pack (assoc :_pack true) treq (assoc :_treq treq)))
                     (when nm (str nm (when pack "...")))]))
              ;; a type-constraint: a concept's name (with arguments) before the parameter's
              ;; (n-cpp-concepts: not before auto or decltype(auto), a constrained placeholder's non-type parameter,
              ;; [temp.param]/1's parameter-declaration with [dcl.spec.auto.general]/1: `template<Type auto N>`)
              (and (name-start? p) (when-let [[qn e] (scan-name p)]
                                     (and (concept-ent? (:ent qn))
                                          (not (t= (tok-at p e) "auto")) (not (t= (tok-at p e) "decltype")))))
              (let [tc (parse-name p (if (skim? p) :scan :parse))
                    pack (accept! p "...")
                    nm (when (id? p) (ts (cur p)))
                    ni (if nm (let [i (ix p)] (adv! p) i) (ix p))
                    dflt (when (and (accept! p "=") (vreset! hd true)) (if (skim? p) (do (skip-targ! p) nil) (with-gt p false (parse-type-id p :targ))))]
                (when nm (sc/declare! (scope p) (cond-> {:k :type :name nm :tparam true} pack (assoc :pack true))))
                ;; (queue 336: [temp.param]/4, the type-constraint's concept takes the parameter and its own arguments: as
                ;; many as the concept's parameters unless its last is a pack, GCC's "wrong number of template arguments")
                ;; (n-cpp-concepts, [temp.param]/4 with [temp.concept]/7: a type-constraint's concept a type concept, GCC's
                ;; "does not constrain a type")
                (when (and (map? tc) (not (skim? p)) (false? (:type-concept (:ent tc))))
                  (soft-diag! p b (str "'" (:s (peek (:parts tc))) "' does not constrain a type")))
                (when (and (map? tc) (not (skim? p)) (not (false? (:type-concept (:ent tc)))))
                  (let [ce (:ent tc) lp (peek (:parts tc)) as (:args lp)]
                    (when (and (pos? (long (or (:nparams ce) 0))) (not (:vpack ce)) (or (nil? as) (vector? as))
                               ;; (an argument's pack expansion: its count unknown here)
                               (not (and as (:ab lp) (:ae lp) (some #(t= (tok-at p %) "...") (range (long (:ab lp)) (inc (long (:ae lp))))))))
                      (let [n (inc (count as)) np (long (:nparams ce)) nr (long (or (:nreq ce) np))]
                        (when (or (> n np) (< n nr))
                          (soft-diag! p b (str "wrong number of template arguments (" n ", should be " (if (< nr np) (str "at least " nr) np) ")")))))))
                [(node p "TemplateTypeParmDecl" b (last-ix p)
                       (cond-> {:tagUsed "typename" :loc (loc p ni)
                                :inner (into [{:kind "ConceptSpecializationExpr"}] (when dflt [{:kind "TemplateArgument" :type {:qualType (qt dflt)}}]))}
                         nm (assoc :name nm) pack (assoc :isParameterPack true)
                         ;; the type-constraint's concept as written (its name's parts; with arguments: their texts)
                         (and (map? tc) (seq (:parts tc))) (assoc :_tc (mapv :s (:parts tc)) :_tcargs (boolean (:args (peek (:parts tc)))))))
                 (when nm (str nm (when pack "...")))])
              :else
              (let [ds (parse-decl-specs p :tparam)
                    base (or (ds-type ds) (perr p "a template parameter"))
                    d (parse-declarator p :either)
                    de (ix p)
                    ty (build-type base d)
                    qn (:name (last (name-chain d)))
                    nm (name-plain qn)
                    ni (if qn (long (:i (peek (:parts qn)))) (ix p))
                    dflt (when (and (accept! p "=") (vreset! hd true))
                           (cond (skim? p) (do (skip-targ! p) nil)
                                 ;; (cpp-read, 2026-11-22: a `...` where the default's expression begins, GCC's "expected
                                 ;; primary-expression before '...' token", the default skipped and the template declared)
                                 (and (is? p "...") (main-tok? p (ix p)))
                                 (do (soft-diag! p (ix p) "expected primary-expression before '...' token") (skip-targ! p) nil)
                                 :else (with-gt p false (parse-cond-expr p))))
                    pack (or (:pack d) (= :pk (:t ty)))]
                ;; CX12's checker (clang's DiagnoseUnexpandedParameterPack for a non-type parameter's type, [temp.variadic]/7):
                ;; an enclosing template's parameter pack named in the type with no ... in it (g++.dg's cpp0x/variadic170.C,
                ;; `template <typename A<T::value>::type>` in B<typename... T>, which the parser declined until typename
                ;; enable_if<...>::type was read as a type; cpp-route)
                (when-not pack
                  (let [b (long (:b ds)) e (long (if qn (dec ni) de))]
                    (when (not-any? #(t= (tok-at p %) "...") (range b e))
                      (when-let [i (first (filter (fn [i] (let [^T t (tok-at p i)]
                                                            (and (identical? :id (.-k t))
                                                                 (let [en (lookup (scope p) (.-s t))] (and (:tparam en) (:pack en))))))
                                                  (range b e)))]
                        (soft-diag! p i (str "non-type template parameter type contains unexpanded parameter pack '" (ts (tok-at p i)) "'"))))))
                ;; (queue 492: [temp.param]/6, a non-type template parameter's type is structural -- an lvalue reference,
                ;; an integral, enumeration, pointer, pointer-to-member or std::nullptr_t type, from C++20 a floating-point
                ;; type or a literal class -- so void, an rvalue reference, a complex type, or before C++20 a floating type
                ;; written as the parameter's own type is GCC's "'void' is not a valid type for a template non-type
                ;; parameter")
                (when-not (skim? p)
                  (let [w (when (= :b (:t ty)) (set (:w ty)))]
                    (when (or (= :rr (:t ty))
                              (and w (or (w "void") (w "_Complex") (w "__complex__")
                                         (and (< (.-year p) 2020) (or (w "float") (w "double"))))))
                      (soft-diag! p (long (:b ds)) "the type is not a valid type for a template non-type parameter"))))
                (when nm (sc/declare! (scope p) {:k :var :name nm :tparam true :ty ty}))
                [(node p "NonTypeTemplateParmDecl" (:b ds) (last-ix p)
                       (cond-> {:loc (loc p ni) :type {:qualType (qt (param-type (if (and (= :pk (:t ty)) (not (:pack (:ent base))) (not (:pack (:q (:qn base))))) (:of ty) ty)))}
                                :inner (if dflt [{:kind "TemplateArgument" :inner [dflt]}] [])}
                         nm (assoc :name nm) pack (assoc :isParameterPack true)))
                 (when nm (str nm (when pack "...")))]))]
        (let [;; (n-review-cc: the parameters before the first with a default argument, [temp.param]/14, which a
              ;; concept's type-constraint may leave out: std::three_way_comparable<T, Cat = partial_ordering>; D342-3 (a): the
              ;; parameter's own default (hd), not an `=` among its tokens: `template<class = int> class TT` has none)
              nreq (or nreq (when @hd (count ns)))
              ;; (cpp-rind: [temp.param]/? with [basic.scope.temp]/? : a template-parameter-list declares each name once: GCC's
              ;; "redefinition of 'int N'", at the second; template/crash67.C)
              _ (when (and nm (some #{nm} names) (not (skim? p)) (main-tok? p b))
                  (soft-diag! p b (str "redefinition of template parameter '" nm "'")))
              ns (conj ns n) names (conj names nm)]
          (if (accept! p ",") (recur ns names nreq)
              (do
                ;; (a list of unnamed parameters, `template <class...>`, is a template's all the same: in-template? asks
                ;; the scope for names, so it holds one no lookup can spell; CP290 (a): such a template's deduced return
                ;; type stays `auto`, as clang's pattern has it)
                (when (zero? (.size ^java.util.HashMap (sc/names-of (scope p))))
                  (.put ^java.util.HashMap (sc/names-of (scope p)) " unnamed" {:k :type :name " unnamed" :tparam true}))
                ;; (cpp-read, 2026-11-22: [temp.param]/14, a primary class or alias template's (or a template template
                ;; parameter's) parameter pack is its last parameter: GCC's "parameter pack 'T' must be at the end of the
                ;; template parameter list", at the pack; a function template's and a partial specialization's aside)
                (when (and (is? p ">") (not (skim? p)) (> (count ns) 1))
                  (let [^T a (nxt p 1) ^T b (nxt p 2) ^T c (nxt p 3)]
                    (when (or (t= a "using") (t= a "concept")
                              (and (or (t= a "class") (t= a "struct") (t= a "union") (t= a "typename"))
                                   (or (not (identical? :id (.-k b))) (not (t= c "<")))))
                      (doseq [n (butlast ns) :when (:isParameterPack n)]
                        (let [i (first (filter #(main-tok? p %) [(long (or (:_b n) -1))]))]
                          (when (and i (>= (long i) 0))
                            (soft-diag! p (long i) (str "parameter pack '" (or (:name n) "") "' must be at the end of the template parameter list"))))))))
                [(with-meta ns {:nreq (or nreq (count ns))}) names])))))))

(defn- fold-const
  "An integral constant expression's value (a specialization's template argument), or nil."
  [x]
  (case (:kind x)
    "IntegerLiteral" (let [v (bigint (:value x))] (if (<= v Long/MAX_VALUE) (long v) v))
    "CharacterLiteral" (:value x)
    "CXXBoolLiteralExpr" (:value x)
    "ParenExpr" (fold-const (first (:inner x)))
    "UnaryOperator" (let [v (fold-const (first (:inner x)))] (when (number? v) (case (:opcode x) "-" (- v) "+" v "~" (bit-not v) nil)))
    "BinaryOperator" (let [[a b] (map fold-const (:inner x))]
                       (when (and (number? a) (number? b))
                         (case (:opcode x) "+" (+ a b) "-" (- a b) "*" (* a b) "/" (when-not (zero? b) (quot a b)) "%" (when-not (zero? b) (rem a b))
                               "<<" (bit-shift-left a b) ">>" (bit-shift-right a b) "&" (bit-and a b) "|" (bit-or a b) "^" (bit-xor a b) nil)))
    nil))

(defn- targ-node
  "A written template argument as clang's TemplateArgument of a specialization, converted to its parameter `prm`'s type
  (clang's integral values: a bool's true is -1, a 1-bit signed value)."
  [a prm]
  (let [pt (get-in prm [:type :qualType])]
    (case (:k a)
      :type {:kind "TemplateArgument" :type {:qualType (qt (:t a))}}
      :expr (let [v (fold-const (:x a))
                  v (cond (nil? v) nil
                          (= pt "bool") (if (if (number? v) (not (zero? (long v))) v) -1 0)
                          (boolean? v) (if v 1 0)
                          :else v)]
              (if (some? v) {:kind "TemplateArgument" :value v} {:kind "TemplateArgument" :isExpr true :inner [(:x a)]}))
      {:kind "TemplateArgument"})))

(defn- default-targ
  "A template parameter's default argument as its TemplateArgument, or nil."
  [prm]
  (when-let [d (first (filter #(= "TemplateArgument" (:kind %)) (:inner prm)))]
    (if (:type d)
      d
      (let [x (first (:inner d)) v (fold-const x)]
        (targ-node {:k :expr :x x} prm)))))

(defn- targ-nodes
  "A specialization's written template arguments as clang's TemplateArgument nodes, against the primary template's
  parameters `tps` when known: each converted to its parameter's type, a pack's arguments one pack (no form: the
  converter writes the specialization as its text), the parameters with no argument their defaults."
  ([^P p args] (targ-nodes p args nil))
  ([^P p args tps]
   (if (empty? tps)
     (mapv #(targ-node % nil) args)
     (loop [as (seq args) ps (seq tps) out []]
       (let [prm (first ps)]
         (cond
           (nil? prm) (into out (map #(targ-node % nil) as))
           (:isParameterPack prm) (conj out {:kind "TemplateArgument" :isPack true})
           (nil? as) (if-let [d (default-targ prm)] (recur nil (next ps) (conj out d)) out)
           :else (recur (next as) (next ps) (conj out (targ-node (first as) prm)))))))))

(defn- set-begin
  "A node whose range begins at token b."
  [^P p n ^long b]
  (assoc n :range {:begin (loc p b) :end (get-in n [:range :end])} :_b b))

(defn- wrap-template
  "The declaration `n` under the template header of token `hb` (its parameters `ps`, `names`), the outermost header
  at `ob`, this header the `depth`th: the node clang gives it."
  [^P p n ^long hb ^long ob ps names ^long depth]
  (let [k (:kind n)
        e (long (:_e n))
        explicit (empty? ps)]
    (cond
      ;; CP352: an enum under a template header (ill-formed: `template <typename T> enum A<T>::E : T { e };`) has no form that keeps
      ;; the header (clang's EnumDecl does not): the converter's text form of the whole declaration, which reads again as itself
      (= k "EnumDecl") (node p "NativeDecline" ob e {})
      (and explicit (= k "CXXRecordDecl"))
      (node p "ClassTemplateSpecializationDecl" ob e
            (-> (dissoc n :_args :_qn :kind :range)
                (assoc :inner (vec (concat (targ-nodes p (:_args n) (:tps (:ent (:_qn n)))) (:inner n))))))
      explicit (cond-> (set-begin p n ob) (:_args n) (update :inner (fn [xs] (vec (concat (targ-nodes p (:_args n)) xs)))))
      (= k "CXXRecordDecl")
      (if (:_args n)
        (node p "ClassTemplatePartialSpecializationDecl" (if (> depth 1) ob hb) e
              (cond-> (-> (dissoc n :_args :_qn :kind :range) (assoc :inner (vec (concat ps (:inner n)))))
                ;; (cpp-s5: the code generator's: the arguments' tokens as the preprocessor gave them, `<...>`, for a
                ;; partial specialization a macro writes, whose source text is the macro's invocation: <refwrap.h>'s
                ;; _GLIBCXX_MEM_FN_TRAITS's _Mem_fn_traits<_Res (_Class::*)(_ArgTypes...) const &>)
                (and *full-headers* (:ab (last (:parts (:_qn n)))) (:ae (last (:parts (:_qn n)))))
                (assoc :_targtext (tok-text p (long (:ab (last (:parts (:_qn n))))) (long (:ae (last (:parts (:_qn n)))))))))
        (node p "ClassTemplateDecl" hb e {:name (:name n) :loc (:loc n) :inner (conj (vec ps) (if (> depth 1) (set-begin p n ob) n))}))
      (#{"FunctionDecl" "CXXMethodDecl" "CXXConstructorDecl" "CXXDestructorDecl" "CXXConversionDecl" "CXXDeductionGuideDecl" "VarDecl"} k)
      (if (<= depth (long (or (:_qtmpl n) 0)))
        (set-begin p n ob)
        (node p (if (= k "VarDecl") (if (:_args n) "VarTemplatePartialSpecializationDecl" "VarTemplateDecl") "FunctionTemplateDecl") hb e
              {:name (:name n) :loc (:loc n) :inner (conj (vec ps) (if (> depth 1) (set-begin p n ob) n))}))
      (= k "TypeAliasDecl") (node p "TypeAliasTemplateDecl" hb e {:name (:name n) :loc (:loc n) :inner (conj (vec ps) n)})
      (and (= k "FriendDecl") (:_elab n))
      (let [{:keys [kw kb ni e]} (:_elab n)
            r (node p "CXXRecordDecl" kb e {:tagUsed kw :name (:_name n) :loc (loc p ni)})]
        (node p "FriendDecl" ob (long (:_e n)) {:loc (:loc n) :inner [(node p "ClassTemplateDecl" hb (long (:_e n)) {:name (:_name n) :loc (loc p ni) :inner (conj (vec ps) r)})]}))
      (and (= k "FriendDecl") (seq (:inner n)) (#{"FunctionDecl" "CXXMethodDecl" "CXXConstructorDecl"} (:kind (first (:inner n)))))
      (let [f (first (:inner n))]
        (node p "FriendDecl" ob e {:loc (:loc n) :inner [(node p "FunctionTemplateDecl" hb e {:name (:name f) :loc (:loc f) :inner (conj (vec ps) (if (> depth 1) (set-begin p f ob) f))})]}))
      (= k "FriendDecl") (set-begin p n ob)
      :else (set-begin p n ob))))

(defn parse-template-decl
  "A template declaration, an explicit specialization or an explicit instantiation at the cursor (`template`, or
  `extern template`): its nodes. `ob` the outermost header's first token, `depth` this header's place."
  [^P p ctx ^long ob ^long depth]
  (let [hb (ix p)
        ext (accept! p "extern")]
    (expect! p "template")
    (if-not (is? p "<")
      ;; an explicit instantiation: the converter reads it from its text
      (let [b0 (ix p)
            fi (try (skimming p true
                      (let [ds (parse-decl-specs p :top) d (parse-declarator p :named) fs (fn-suffix-of d)
                            qn (:name (last (name-chain d)))]
                        {:names (when fs (:names fs))
                         ;; (G5: a function's name and type, for the code generator)
                         :fname (when (and fs qn) (fn-name p (peek (:parts qn)) false false))
                         :ftype (when (and fs (ds-type ds)) (try (qt (build-type (ds-type ds) d)) (catch Exception _ nil)))
                         ;; (queue 367: a constructor's, no decl-specifiers: `template S::basic_string(C*, C*, const allocator<C>&);`)
                         :fctype (when (and fs (nil? (ds-type ds))) (try (qt (build-type {:t :b :w ["void"]} d)) (catch Exception _ nil)))}))
                    (catch arbace.lang.ExceptionInfo _ nil))
            names (:names fi)
            _ (seek! p b0)
            ;; (cpp-read, 2026-11-22: [temp.explicit]/3, an explicit instantiation's declaration names a template declared
            ;; before: an unqualified name no lookup finds first, before a <, GCC's "'A' is not a template", at the name)
            _ (let [^T t (cur p)]
                (when (and *full-headers* (not (skim? p)) (identical? :id (.-k t)) (is-at? p 1 "<") (main-tok? p b0)
                           (nil? (lookup (scope p) (.-s t))))
                  (soft-diag! p b0 (str "'" (.-s t) "' is not a template"))))
            ;; (cpp-read, 2026-11-22: [expr.prim.id.qual]/1 with [basic.lookup.qual]/1, a nested-name-specifier's class is complete
            ;; where it names a member: the instantiation's `A::` of a class only declared is GCC's "invalid use of incomplete type
            ;; 'struct A'", at the name (template/incomplete3.C); not a class template's)
            _ (when (and (not (skim? p)) (main-tok? p b0))
                (loop [i b0 n 0]
                  (let [^T t (tok-at p i)]
                    (when (and (< n 64) (not (t= t ";")) (not (identical? :eof (.-k t))))
                      (if (and (identical? :id (.-k t)) (t= (tok-at p (inc i)) "::") (not (t= (tok-at p (dec i)) "::")))
                        (let [e (lookup (scope p) (.-s t))]
                          (when (and (:incomplete e) (:class e) (not (:tmpl e)))
                            (soft-diag! p i (str "invalid use of incomplete type 'struct " (.-s t) "'"))))
                        (recur (inc i) (inc n)))))))
            ;; (cpp-sweep: [temp.explicit]/3, an explicit instantiation uses no inline, constexpr or consteval specifier: GCC's
            ;; permerror "explicit instantiation shall not use 'consteval' specifier", at the specifier; cpp2a/consteval3.C)
            _ (when (and (not (skim? p)) (main-tok? p b0))
                (loop [i b0 n 0]
                  (let [^T t (tok-at p i)]
                    (when (and (< n 64) (not (t= t ";")) (not (t= t "(")) (not (t= t "{")) (not (identical? :eof (.-k t))))
                      (when (and (identical? :kw (.-k t)) (#{"inline" "constexpr" "consteval"} (.-s t)))
                        (soft-diag! p i (str "explicit instantiation shall not use '" (.-s t) "' specifier")))
                      (recur (inc i) (inc n))))))
            _ (skip-until! p #{";"})
            e (last-ix p)]
        (expect! p ";")
        [(cond-> (node p "ExplicitInstantiationDecl" hb e
                       (if (some some? names)
                         {:inner [{:kind "FunctionProtoTypeLoc" :inner (mapv (fn [nm] (cond-> {:kind "ParmVarDecl"} nm (assoc :name nm))) names)}]}
                         {}))
           ;; (G5: the code generator's: extern, and the declaration's tokens' text after `template`)
           *full-headers* (assoc :_extern (boolean ext) :_text (tok-text p b0 e))
           (and *full-headers* (:fname fi) (:ftype fi)) (assoc :_fname (:fname fi) :_ftype (:ftype fi))
           (and *full-headers* (:fname fi) (:fctype fi)) (assoc :_fname (:fname fi) :_fctype (:fctype fi)))])
      (with-scope p :tparams nil
        ;; (round 54, second pass: [temp.pre]/6, a template, its explicit or partial specialization has no C language linkage:
        ;; GCC's "template with C linkage", the declaration taken)
        (when (and (= "C" *linkage*) (= depth 1) (not= ctx :member) (empty? (stv p CLS))) (soft-diag! p hb "template with C linkage"))
        (adv! p)
        (let [[ps names] (parse-template-params p)
              _ (expect! p ">")
              rc (when (is? p "requires") (requires-clause! p))
              ;; (h-cpp-read: an enumeration is no templated entity's declaration, [temp.pre]/2: GCC's "template declaration
              ;; of 'enum E'"; the enumeration taken)
              _ (when (and (is? p "enum") (seq ps)
                           (let [j (if (or (is-at? p 1 "class") (is-at? p 1 "struct")) 2 1)]
                             (not (or (is-at? p (inc j) "::") (is-at? p (inc j) "<") (is-at? p j "::")))))
                  (soft-diag! p (ix p) "template declaration of an enumeration"))]
          (cond
            (is? p "template") (parse-template-decl p ctx ob (inc depth))
            (is? p "concept")
            (do (adv! p)
                (let [nm (ts (cur p)) ni (ix p)]
                  (adv! p) (attr-nodes p) (expect! p "=")
                  (let [cb (ix p)
                        _ (skip-until! p #{";"})
                        ce (ix p)
                        ;; its constraint expression (P14 (b), the code generator's mode: G4)
                        cx (when (and *full-headers* (not (skim? p)))
                             (let [x (tentatively p (fn [p] (seek! p cb) (let [x (with-gt p true (parse-expr p))] (when (= (ix p) ce) x))))]
                               (when (map? x) x)))
                        e (last-ix p)]
                    (expect! p ";")
                    ;; (queue 336: its parameters' count and whether the last is a pack, for a type-constraint's arguments)
                    (sc/declare! (sc/decl-scope (scope p)) {:k :concept :name nm :nparams (count ps)
                                                            :nreq (or (:nreq (meta ps)) (count ps))
                                                            :vpack (boolean (:isParameterPack (peek ps)))
                                                            ;; (n-cpp-concepts: whether it is a type concept, [temp.concept]/7: its
                                                            ;; first template parameter a type parameter)
                                                            :type-concept (= "TemplateTypeParmDecl" (:kind (first ps)))})
                    [(node p "ConceptDecl" hb e (cond-> {:name nm :loc (loc p ni) :inner ps} cx (assoc :constraintExpr cx)))])))
            :else
            (do (st! p THDR {:names (vec (remove nil? names)) :n (count names) :params ps})
                (let [ns (try (parse-external-decl p (if (= ctx :member) :member :top)) (finally (st! p THDR nil)))
                      ws (mapv #(cond-> (wrap-template p % hb ob ps names depth) rc (assoc :requiresClause rc)) ns)]
                  ;; (round 54: [temp.param]/14, a primary class, variable or alias template's parameter pack is its last parameter)
                  (when (and (some #(#{"ClassTemplateDecl" "VarTemplateDecl" "TypeAliasTemplateDecl"} (:kind %)) ws)
                             (some :isParameterPack (butlast ps)))
                    (soft-diag! p hb (str "parameter pack " (when-let [pn (some #(when (:isParameterPack %) (:name %)) (butlast ps))] (str "'" pn "' ")) "must be at the end of the template parameter list")))
                  ;; (round 54, third pass: [temp.param]/14, a parameter after one with a default template argument has one too or
                  ;; is a pack, in a primary class, variable or alias template: GCC's "no default argument for 'U'" at the
                  ;; declaration; a template template parameter's default not recorded, so none judged after one)
                  (when-let [d (first ns)]
                    (when (and (#{"CXXRecordDecl" "VarDecl" "TypeAliasDecl"} (:kind d)) (nil? (:_args d)) (nil? (:_qn d)) (not (skim? p))
                               (not (and (= "CXXRecordDecl" (:kind d)) (when-let [o (get-in d [:loc :offset])] (qualified-at? p (long (:_b d)) (long o)))))
                               (some #(#{"ClassTemplateDecl" "VarTemplateDecl" "TypeAliasTemplateDecl"} (:kind %)) ws))
                      (let [dflt? (fn [x] (some #(= "TemplateArgument" (:kind %)) (:inner x)))
                            after (drop-while (complement dflt?) ps)]
                        (when (not-any? #(= "TemplateTemplateParmDecl" (:kind %)) after)
                          (when-let [x (first (filter #(not (or (dflt? %) (:isParameterPack %))) after))]
                            (soft-diag! p (long (:_b d)) (str "no default argument for '" (or (:name x) "") "'")))))))
                  ;; (round 54, second pass: [over.literal]/5, a literal operator template's one template parameter is a non-type
                  ;; parameter of class type or (GNU's) a char pack: a pack of another type is GCC's "literal operator template ...
                  ;; has invalid parameter list")
                  (when-let [f (some #(when (and (= "FunctionDecl" (:kind %)) (str/starts-with? (str (:name %)) "operator\"\"")) %) ns)]
                    ;; (sixth pass: and every other list but an empty one, an explicit specialization's: two parameters, a type or
                    ;; template parameter, a non-type one of a fundamental, pointer or reference type, a pack of an undeclared type)
                    (when (or (and (= 1 (count ps)) (= "NonTypeTemplateParmDecl" (:kind (first ps))) (:isParameterPack (first ps))
                                   (not= "char" (get-in (first ps) [:type :qualType])))
                              (> (count ps) 1)
                              (and (= 1 (count ps)) (#{"TemplateTypeParmDecl" "TemplateTemplateParmDecl"} (:kind (first ps))))
                              (and (= 1 (count ps)) (= "NonTypeTemplateParmDecl" (:kind (first ps))) (not (:isParameterPack (first ps)))
                                   (let [q (str (get-in (first ps) [:type :qualType]))]
                                     (or (re-find #"[*&]" q)
                                         (every? #{"char" "wchar_t" "char8_t" "char16_t" "char32_t" "bool" "short" "int" "long" "signed" "unsigned"
                                                   "float" "double" "const" "volatile" "decltype(nullptr)" "std::nullptr_t"} (str/split (str/trim q) #"\s+"))))))
                      (soft-diag! p (long (:_b f)) (str "literal operator template '" (:name f) "' has invalid parameter list"))))
                  ;; (round 54, second pass: [temp.expl.spec]/17 and [temp.mem]/1, a class's template headers one for itself and one
                  ;; for each enclosing class template its name's qualifier names: more is GCC's "too many template-parameter-lists")
                  (when-let [qn (some #(when (and (= "CXXRecordDecl" (:kind %)) (:_qn %)) (:_qn %)) ns)]
                    (when (> depth (count (:parts qn)))
                      (soft-diag! p (long (:i (peek (:parts qn)))) "too many template-parameter-lists")))
                  ws))))))))

;; ---------------------------------------------------------------------------------------------
;; Namespaces, linkage, using, static_assert, export

(defn- ns-ent!
  "The namespace `nm` of the current scope, opened or reopened (inline: its names visible in the enclosing one)."
  [^P p ^String nm inline]
  (let [s (sc/decl-scope (scope p))
        old (when nm (sc/find-in s nm))
        old (if (= :ns (:k old)) old nil)
        e (or old {:k :ns :name nm :scope (sc/new-scope :ns s nil)})]
    (when-not old (when nm (sc/declare! s e)))
    (when (or inline (nil? nm)) (sc/add-inline! s (:scope e)))
    e))

(defn- parse-namespace [^P p]
  (let [b (ix p)
        inline (accept! p "inline")]
    (expect! p "namespace")
    (let [a1 (attr-nodes p)]
    (if (and (id? p) (is-at? p 1 "="))
      (let [nm (ts (cur p)) ni (ix p)]
        (adv! p) (adv! p)
        (let [qn (or (parse-name p :parse) (perr p "a namespace alias"))
              e (last-ix p)]
          (expect! p ";")
          (when-let [t (:ent qn)] (when (= :ns (:k t)) (sc/declare! (sc/decl-scope (scope p)) (assoc t :name nm))))
          [(node p "NamespaceAliasDecl" b e {:name nm :loc (loc p ni)})]))
      (let [parts (loop [out []]
                    (let [inl (accept! p "inline")]
                      (if (id? p)
                        (let [x {:name (ts (cur p)) :i (ix p) :inline inl}]
                          (adv! p)
                          (if (accept! p "::") (recur (conj out x)) (conj out x)))
                        out)))
            ;; (cpp-read, 2026-11-22: [namespace.def.general]/1, a nested-namespace-definition `namespace A::B` takes `inline`
            ;; only before a name after the first (C++20's `A::inline B`): GCC's "a nested namespace definition cannot be inline"
            ;; for `inline namespace A::B`, "expected" for `namespace inline A::B` and an `inline` after the names)
            _ (when (and (seq parts) (not (skim? p)) (main-tok? p b))
                (cond (:inline (first parts)) (soft-diag! p (long (:i (first parts))) "expected identifier before 'inline'")
                      (and inline (> (count parts) 1)) (soft-diag! p b "a nested namespace definition cannot be inline")))
            _ (when (and (is? p "inline") (seq parts) (not (skim? p)) (main-tok? p (ix p)))
                (soft-diag! p (ix p) "expected '{' before 'inline'")
                (adv! p))
            a2 (attr-nodes p)
            ;; (cpp-rt-own2: GNU's abi_tag on a namespace kept as :_abi-tags, the tags it names, for the code generator's implicit
            ;; tags: <c++config.h>'s `inline namespace __cxx11 __attribute__((__abi_tag__ ("cxx11")))`; the nodes are no children)
            tags (not-empty (vec (sort (distinct (for [a (concat a1 a2) :when (and (= "NativeAttr" (:kind a)) (#{"abi_tag" "__abi_tag__"} (:_gnu a)))
                                                       [_ t] (re-seq #"\"([^\"]*)\"" (str (:_arg a)))]
                                                   t)))))
            parts (if (empty? parts) [{:name nil :i b :inline inline}] (update parts 0 assoc :inline inline))
            open (fn open [ps]
                   (let [{:keys [name i] inl :inline} (first ps)
                         e (ns-ent! p name inl)]
                     (in-scope p (:scope e)
                       (if (next ps)
                         [(open (next ps))]
                         (do (expect! p "{") (with-gt p true (decl-seq p :top)))))))
            members (open parts)
            _ (expect! p "}")
            e (last-ix p)
            mk (fn mk [ps inner nested]
                 (let [{:keys [name i] inl :inline} (first ps)
                       kids (if (next ps) [(mk (next ps) inner true)] inner)]
                   (node p "NamespaceDecl" b e (cond-> {:loc (loc p i) :inner kids} name (assoc :name name) inl (assoc :isInline true) nested (assoc :isNested true)
                                                   (and tags (nil? (next ps))) (assoc :_abi-tags tags)))))]
        [(mk parts (loop [m members] (if (and (vector? m) (= 1 (count m)) (vector? (first m))) (recur (first m)) m)) false)])))))

(defn- parse-linkage [^P p]
  (let [b (ix p)]
    (adv! p)
    ;; (h-cpp-read: a string-literal with a ud-suffix is a user-defined-string-literal, not a linkage spec's string-literal
    ;; ([dcl.link]/2): GCC's "expected unqualified-id before user-defined string literal"; the linkage taken without the suffix)
    (let [lang (let [s (ts (cur p))
                     ;; (the shared lexer ends the literal before a keyword written against it, "c"void: the keyword's token
                     ;; glued to the literal's in the main file is its ud-suffix)
                     ^T t0 (cur p) ^T t1 (nxt p 1)
                     _ (when (and (main-tok? p (ix p)) (nil? (.-mac t0)) (identical? :kw (.-k t1)) (= (.-o t1) (+ (.-o t0) (.-n t0))))
                         (soft-diag! p (ix p) "expected unqualified-id before user-defined string literal"))
                     s (if-let [[_ q] (re-matches #"(.*[\"])[A-Za-z_][A-Za-z0-9_]*" s)]
                         (do (soft-diag! p (ix p) "expected unqualified-id before user-defined string literal") q)
                         s)]
                 (subs s 1 (dec (count s))))]
      (adv! p)
      (binding [*linkage* lang]
      (if (accept! p "{")
        (let [ms (with-gt p true (decl-seq p :top))]
          (expect! p "}")
          [(node p "LinkageSpecDecl" b (last-ix p) {:language lang :hasBraces true :inner ms})])
        (let [;; (cpp-diag-b, 2026-11-22: [dcl.link]/8, a declaration directly contained in a linkage-specification is taken as
              ;; extern and specifies no storage class: GCC's "invalid use of 'static' in linkage specification", at the specifier)
              _ (when (and (not (skim? p)) (main-tok? p (ix p)))
                  (loop [j (ix p) k 0]
                    (let [^T t (tok-at p j)]
                      (when (and (< k 12) (identical? :kw (.-k t))
                                 ;; (a nested linkage-specification's extern, `extern "C" extern "C" { ... }`, is none)
                                 (not (and (t= t "extern") (#{:str :udls} (tk (tok-at p (inc j)))))))
                        (if (or (contains? #{"static" "extern" "register" "mutable"} (.-s t)) (and (t= t "auto") (< (.-year p) 2011)))
                          (soft-diag! p j (str "invalid use of '" (.-s t) "' in linkage specification"))
                          (recur (inc j) (inc k)))))))
              ns (parse-external-decl p :top)]
          [(node p "LinkageSpecDecl" b (if (seq ns) (ne (peek ns)) (last-ix p)) {:language lang :inner ns})]))))))

(defn- dependent-type? [t]
  (case (:t t)
    (:n :tn) (or (= :tn (:t t)) (nil? (:ent t)) (:tparam (:ent t))
                 (some (fn [part] (some #(case (:k %) :type (dependent-type? (:t %)) false) (:args part))) (:parts (:qn t))))
    (:p :lr :rr :a :pk) (dependent-type? (:of t))
    :dt true
    false))

(defn- dependent-arg?
  "A template argument that depends on a template parameter (an expression's: in a template, when it names one)."
  [^P p a]
  (case (:k a)
    :type (dependent-type? (:t a))
    :expr (and (in-template? p)
               (some (fn [i] (let [^T t (tok-at p i)] (and (identical? :id (.-k t)) (:tparam (lookup (scope p) (.-s t))))))
                     (range (:b a) (inc (long (:e a))))))
    false))

(defn- parse-using [^P p]
  (let [b (ix p)]
    (adv! p)
    (cond
      (is? p "namespace")
      (do (adv! p)
          (let [qn (or (parse-name p :parse) (perr p "a namespace's name")) e (last-ix p)]
            ;; (cpp-read, 2026-11-22: a standard attribute-specifier after the namespace-name, which [namespace.udir]/1 places
            ;; before `using` alone: GCC's "expected ';' before '[' token"; GNU's __attribute__ taken, as clang and GCC take it)
            (when (and (is? p "[") (is-at? p 1 "[") (not (skim? p)) (main-tok? p (ix p)))
              (soft-diag! p (ix p) "expected ';' before '[' token"))
            (attr-nodes p)
            (expect! p ";")
            (when-let [s (ent-scope (:ent qn))] (sc/add-using! (sc/decl-scope (scope p)) s))
            [(node p "UsingDirectiveDecl" b e {})]))
      (is? p "enum")
      (do (adv! p)
          (let [qn (or (parse-name p :parse) (perr p "an enumeration's name")) e (last-ix p)]
            (expect! p ";")
            (when-let [s (ent-scope (:ent qn))] (sc/add-using! (sc/decl-scope (scope p)) s))
            [(node p "UsingEnumDecl" b e {})]))
      (and (id? p) (let [i (ix p)] (or (is-at? p 1 "=") (and (is-at? p 1 "[") (is-at? p 2 "[")) (is-at? p 1 "__attribute__"))))
      (let [tmpl (stv p THDR)
            nm (ts (cur p)) ni (ix p)]
        (st! p THDR nil)
        (adv! p)
        (let [as (attr-nodes p)
              _ (expect! p "=")
              ;; (queue 368: the alias template's class or enumeration definition diagnosed at its head, before its body is read,
              ;; so an ill-formed body, alias-decl-16.C's `enum B3 {b = 0;};`, still gets the rule's error as g++'s)
              pre (when (and tmpl (pos? (long (:n tmpl))) (or (is? p "struct") (is? p "class") (is? p "union") (is? p "enum")))
                    (let [i0 (ix p)]
                      (loop [k 1]
                        (let [^T t (tok-at p (+ i0 k))]
                          (cond (or (> k 32) (identical? :eof (.-k t)) (t= t ";") (t= t "=") (t= t ")") (t= t "<")) nil
                                (t= t "{") (do (soft-diag! p i0 "types may not be defined in alias template declarations") true)
                                :else (recur (inc k)))))))
              ds (parse-decl-specs p :alias)
              ad (parse-declarator p :abstract)
              ty (vectorized (build-type (or (ds-type ds) (perr p "an alias's type")) ad) (concat (:attrs ds) (:attrs ad)))
              e (last-ix p)]
          ;; (round 54: [dcl.typedef]/2, an alias template's defining-type-id defines no class or enumeration: GCC's "types may not
          ;; be defined in alias template declarations")
          (when-let [tn (:tag-node ds)]
            (when (and (not pre) tmpl (pos? (long (:n tmpl))) (or (:completeDefinition tn) (and (= "EnumDecl" (:kind tn)) (seq (:inner tn)))))
              (soft-diag! p (long (:b ds)) "types may not be defined in alias template declarations")))
          ;; (round 54, second pass: [dcl.spec.auto.general]/5, a placeholder type is no alias-declaration's defining-type-id: GCC's
          ;; "'auto' not allowed in alias declaration")
          (when (and (= :auto (:t (:type ds))) (nil? (:cn (:type ds))) (t= (tok-at p (long (:b ds))) "auto") (t= (tok-at p (inc (long (:b ds)))) ";"))
            (soft-diag! p (long (:b ds)) "'auto' not allowed in alias declaration"))
          (expect! p ";")
          (declare! p (cond-> {:k :type :name nm :tmpl (boolean (and tmpl (pos? (long (:n tmpl))))) :target (:ent ty) :scope (ent-scope (:ent ty))}
                        (not (and tmpl (pos? (long (:n tmpl))))) (assoc :ty ty)
                        (and tmpl (pos? (long (:n tmpl)))) (assoc :aty ty :atps (tparam-records p (:params tmpl)))))
          (vec (concat (when-let [n (:tag-node ds)] [n])
                       [(node p "TypeAliasDecl" b e {:name nm :loc (loc p ni) :type {:qualType (qt ty)} :inner (vec as)})]))))
      :else
      (let [tn (accept! p "typename")
            out (loop [out []]
                  (let [qn (or (parse-name p :parse) (perr p "a using-declaration"))
                        lp (peek (:parts qn))
                        e (last-ix p)]
                    (accept! p "...")
                    ;; (round 54, second pass: [namespace.udecl]/8, before C++20 a using-declaration naming a class member is a
                    ;; member-declaration: at block scope GCC's "using-declaration for member at non-class scope")
                    (when (and (< (.-year p) 2020) (= :block (sc/kind-of (scope p))) (> (count (:parts qn)) 1)
                               (let [q (:q qn)] (and (type-ent? q) (not (:tparam q)) (not (let [qs (:scope q)] (and (instance? Scope qs) (= :enum (sc/kind-of qs))))))))
                      (soft-diag! p (long (:b qn)) "using-declaration for member at non-class scope"))
                    ;; (cpp-rind: [namespace.udecl]/1 with [basic.lookup.qual]/1, a using-declarator's nested-name-specifier whose
                    ;; first name no lookup finds and the main file declares nowhere: GCC's "'N' has not been declared", at the name;
                    ;; lookup/using12.C)
                    (let [f (first (:parts qn))]
                      (when (and *full-headers* (not (skim? p)) (> (count (:parts qn)) 1) (not (:g qn)) (:s f) (not (:args f)) (:i f)
                                 (main-tok? p (long (:i f))) (nil? (lookup (scope p) (:s f))) (not (declared-in-main? p (:s f)))
                                 (not= "std" (:s f)))
                        (soft-diag! p (long (:i f)) (str "'" (:s f) "' has not been declared"))))
                    (let [dep (or (nil? (:q qn)) (:tparam (:q qn))
                                  (some #(some (fn [a] (dependent-arg? p a)) (:args %)) (butlast (:parts qn))))
                          ;; (round 54, fifth pass: [basic.scope.scope]/4 with [namespace.udecl]/1, a using-declarator's
                          ;; declaration corresponds to one its namespace or class scope already holds and they conflict: both
                          ;; variables, or both types, of other entities (a class and a variable of one name may coexist,
                          ;; functions overload); GCC's "'int A::a' conflicts with a previous declaration" for a variable,
                          ;; "'using H::type' conflicts ..." for a type; in the main file, a non-dependent qualifier)
                          _ (when-let [nm (and (not dep) (not (skim? p)) (:s lp))]
                              (let [ds (sc/decl-scope (scope p))
                                    t (:ent qn)
                                    old (when (#{:ns :class} (sc/kind-of ds)) (get (sc/names-of ds) nm))]
                                ;; (round 54, sixth pass: [namespace.udecl]/10 (C++23 /9), a using-declarator of a class names no
                                ;; member a using-declarator of the class named before, "double member declaration": GCC's
                                ;; "redeclaration of 'using M::type'"; and [dcl.typedef]/? (C++23 /6), a class scope's typedef-name
                                ;; is not redeclared: two types there of other entities conflict, a typedef-name among them)
                                (when (and t old (= :class (sc/kind-of ds)) (:udecl old)
                                           (#{:var :type} (:k t)) (#{:var :type} (:k old)) (not (:tparam old)))
                                  (soft-diag! p (long (:i lp)) (str "redeclaration of 'using " (name-str p qn) "'")))
                                (when (and t old (not (identical? t old)) (or (not= (dissoc t :udecl) (dissoc old :udecl)) (= :class (sc/kind-of ds))) (not (:using old)) (not (:udecl old))
                                           (or (and (= :var (:k t)) (= :var (:k old)) (not (:tparam old)) (not (:anon old)))
                                               (and (= :class (sc/kind-of ds)) (= :type (:k t)) (= :type (:k old)) (not (:tparam old))
                                                    (not (:tmpl t)) (not (:tmpl old)) (not (:inj old)) (not (:inj-full old))
                                                    (not (and (:scope t) (identical? (:scope t) (:scope old)))))
                                               ;; (a class and a typedef of a type that is no class: two typedefs of one type
                                               ;; redeclare it, [dcl.typedef]/? (C++23 /5))
                                               (and (= :type (:k t)) (= :type (:k old)) (not (:tparam old)) (not (:tmpl t)) (not (:tmpl old))
                                                    (or (and (:scope old) (:tag old) (nil? (:scope t)) (:ty t))
                                                        (and (:scope t) (:tag t) (nil? (:scope old)) (:ty old))))))
                                  (soft-diag! p (long (:i lp))
                                              (if (= :var (:k t))
                                                (str "'" (if (:ty t) (str (qt (:ty t)) " ") "") (name-str p qn) "' conflicts with a previous declaration")
                                                (str "'using " (name-str p qn) "' conflicts with a previous declaration"))))))
                          _ (when-let [nm (:s lp)]
                              (declare! p (cond-> (or (when-let [t (:ent qn)] (dissoc (assoc t :name nm) :udecl)) (if tn {:k :type :name nm} {:k :fn :name nm}))
                                            ;; (round 54, sixth pass: a class's using-declarator, for the rule above)
                                            (and (not dep) (not (skim? p)) (:ent qn) (#{:var :type} (:k (:ent qn))) (= :class (sc/kind-of (sc/decl-scope (scope p)))))
                                            (assoc :udecl true)
                                            ;; a value named through a dependent qualifier: unresolved until instantiated
                                            (and dep (not tn) (not (type-ent? (:ent qn)))) (assoc :unres true)
                                            ;; (cpp-decl2: a class's using-declarator with a dependent qualifier, for the class rule)
                                            (and dep (not (skim? p)) (= :class (sc/kind-of (sc/decl-scope (scope p))))) (assoc :udecl-dep true))))
                          ;; (cpp-s15, CP392 (a): the code generator's: the declaration's tokens as the preprocessor gave them, `using
                          ;; std :: vector` for <vector>'s `using _GLIBCXX_STD_C::vector;`, whose source text is the macro's name)
                          out (conj out (node p (cond (not dep) "UsingDecl" tn "UnresolvedUsingTypenameDecl" :else "UnresolvedUsingValueDecl") b e
                                              (if *full-headers* {:_text (tok-text p b e)} {})))]
                      (if (accept! p ",") (recur out) out))))]
        (expect! p ";")
        out))))

(defn- parse-static-assert [^P p]
  (let [b (ix p)]
    (adv! p)
    (if (skim? p)
      (do (skip-balanced! p) (expect! p ";") [])
      (do (expect! p "(")
          (let [c (with-gt p true (parse-assign-expr p))
                m (when (accept! p ",") (with-gt p true (parse-assign-expr p)))]
            (expect! p ")")
            (let [e (last-ix p)]
              (expect! p ";")
              [(node p "StaticAssertDecl" b e {:inner (if m [c m] [c {}])})]))))))

(defn- module-line?
  "A module declaration or an import at the cursor (parse-module-line's)."
  [^P p]
  (let [i (if (is? p "export") 1 0)
        ^T t (nxt p i)]
    (and (identical? :id (.-k t))
         (or (and (= "module" (.-s t)) (let [^T n (nxt p (inc i))] (or (t= n ";") (t= n ":") (identical? :id (.-k n)))))
             (and (= "import" (.-s t)) (let [^T n (nxt p (inc i))] (or (t= n "<") (t= n ":") (identical? :id (.-k n)) (identical? :str (.-k n)))))))))

(defn- module-name!
  "A module-name (a.b.c) or a partition's at the cursor, consumed. Its identifiers are not macro-expanded (P3034R1, as
  clang reads them): a name a macro's expansion begins is the macro's name, the expansion's tokens consumed with it
  (`module :PRIVATE_SEMI` with `#define PRIVATE_SEMI private ;` names the partition PRIVATE_SEMI)."
  [^P p]
  (let [^T t (cur p)]
    (if (.-mac t)
      (let [o (.-o t)] (loop [] (let [^T c (cur p)] (when (and (.-mac c) (= o (.-o c)) (not (identical? :eof (.-k c)))) (adv! p) (recur)))))
      (loop []
        (if (id? p)
          (let [^T c (cur p)]
            ;; CP352: a later identifier a macro's expansion begins (`export module foo:bar.bob;` with `#define bob fred;`) is the macro's
            ;; name too, its whole expansion consumed, its `;` with it: the written `;` is the declaration's own
            (if (.-mac c)
              (let [o (.-o c)] (loop [] (let [^T d (cur p)] (when (and (.-mac d) (= o (.-o d)) (not (identical? :eof (.-k d)))) (adv! p) (recur)))))
              (adv! p)))
          (perr p "a module name"))
        (when (and (is? p ".") (identical? :id (tk (nxt p 1)))) (adv! p) (recur))))))

(defn- module-semi!
  "A module declaration's or an import's ;: one missing is recovered as clang does, the tokens to the next ; (or the
  end) skipped."
  [^P p]
  (when-not (is? p ";") (skip-until! p #{";"}))
  (accept! p ";"))

(defn- parse-module-line
  "A module declaration or an import ([module.unit], [module.import]): `module;` (the global module fragment), `export?
  module NAME [:PARTITION] attrs;`, `module :private;`, `export? import NAME|:PARTITION|<header>|\"header\" attrs;`.
  clang's AST has no node for a module declaration (the converter reads its line from the text) and an ImportDecl for
  an import (which the forms leave to the line as well)."
  [^P p]
  (let [b (ix p)]
    (accept! p "export")
    (if (id-is? p "module")
      (do (adv! p)
          (cond
            (is? p ";") (do (adv! p) [])
            (and (is? p ":") (is-at? p 1 "private") (not (.-mac ^T (nxt p 1)))) (do (adv! p) (adv! p) (module-semi! p) [])
            :else (do (when-not (is? p ":") (module-name! p))
                      (when (accept! p ":") (module-name! p))
                      (attr-nodes p)
                      (module-semi! p)
                      [])))
      (do (adv! p) ; import
          (cond
            (accept! p ":") (module-name! p)
            (identical? :str (tk (cur p))) (adv! p)
            (is? p "<") (do (skip-until! p #{">"}) (expect! p ">"))
            :else (module-name! p))
          (attr-nodes p)
          (let [e (ix p)] (module-semi! p) [(node p "ImportDecl" b e {})])))))

(defn parse-external-decl
  "A declaration at the cursor in context `ctx` (:top, :member, :block): its nodes, its ; or } consumed."
  [^P p ctx]
  (let [^T t (cur p) b (ix p)]
    (cond
      (t= t ";") (do ;; (cpp-diag-b, 2026-11-22: C++98 has no empty-declaration ([dcl.dcl], C++11's addition) and a member-declaration's
                     ;; `;` only after a member function's definition ([class.mem]): GCC's pedwarns "extra ';' outside of a function",
                     ;; "extra ';' inside a struct", errors under -pedantic-errors)
                     (when (and (< (.-year p) 2011) (not (skim? p)) (main-tok? p b))
                       (cond (= ctx :top) (pedantic-diag! p b "extra ';' outside of a function")
                             (and (= ctx :member) (not (t= (tok-at p (dec b)) "}"))) (pedantic-diag! p b "extra ';' inside a struct")
                             :else nil))
                     (adv! p) (if (= ctx :top) [(node p "EmptyDecl" b b {})] []))
      (or (t= t "namespace") (and (t= t "inline") (is-at? p 1 "namespace")))
      (do ;; (cpp-diag-b, 2026-11-22: [namespace.def.general]/? : a namespace-definition appears at namespace scope alone: in a block
          ;; GCC's "'namespace' definition is not allowed here")
          (when (and (= ctx :block) (not (skim? p)) (main-tok? p b) (not (is-at? p 2 "="))) (soft-diag! p b "'namespace' definition is not allowed here"))
          (parse-namespace p))
      (t= t "using") (parse-using p)
      ;; (cpp-read, 2026-11-22: a using-directive's attribute-specifier-seq, [namespace.udir]/1)
      (and (t= t "[") (is-at? p 1 "[")
           (let [save (ix p)] (attr-nodes p) (let [r (and (is? p "using") (is-at? p 1 "namespace"))] (seek! p save) r)))
      (do (attr-nodes p) (parse-using p))
      ;; (cpp-read, 2026-11-22: an attribute-specifier-seq alone before ; in a class, no member-declaration ([class.mem.general]/1
      ;; derives no attribute-declaration): GCC's "declaration does not declare anything", at the ;)
      (and (= ctx :member) (t= t "[") (is-at? p 1 "[") (not (skim? p))
           (let [save (ix p)] (attr-nodes p) (let [r (is? p ";")] (seek! p save) r)))
      (do (attr-nodes p) (soft-diag! p (ix p) "declaration does not declare anything") (adv! p) [])
      (or (t= t "template") (and (t= t "extern") (is-at? p 1 "template"))) (parse-template-decl p ctx b 1)
      ;; (cpp-s5: `__extension__ template<...>`, clang's ParseExternalDeclaration consuming the keyword before the
      ;; declaration: <type_traits>' __is_signed_integer alias template)
      (and (t= t "__extension__") (is-at? p 1 "template")) (do (adv! p) (parse-template-decl p ctx (ix p) 1))
      ;; (cpp-s15: `__extension__ using ...;` likewise, <bits/max_size_type.h>'s `__extension__ using __rep = unsigned
      ;; __int128;`, a member alias-declaration the keyword had hidden: "unknown type __rep")
      (and (t= t "__extension__") (is-at? p 1 "using")) (do (adv! p) (parse-using p))
      ;; clang's recovery of `inline template <...>`: the stray specifier dropped, the template declaration read
      ;; (round 54, sixth pass: an error all the same, [temp.pre]/1: GCC's "expected unqualified-id before '<' token")
      (and (t= t "inline") (is-at? p 1 "template")) (do (when (is-at? p 2 "<") (soft-diag! p (+ (ix p) 2) "expected unqualified-id before '<' token"))
                                                         (adv! p) (parse-template-decl p ctx (ix p) 1))
      (and (t= t "extern") (#{:str :udls} (tk (nxt p 1))) (not (is-at? p 2 ";"))) (parse-linkage p)
      (or (t= t "static_assert") (t= t "_Static_assert")) (parse-static-assert p)
      (and (= ctx :member) (#{"public" "private" "protected"} (.-s t)) (sym? t) (is-at? p 1 ":"))
      (do (adv! p) (adv! p)
          (when (skim? p) (when-let [^HashMap i (sema/info (:ent (class-ctx p)))] (.put i :acc (.-s t))))
          [(node p "AccessSpecDecl" b (last-ix p) {:access (.-s t) :loc (loc p b)})])
      (and (= ctx :top) (module-line? p)) (parse-module-line p)
      (and (= ctx :top) (t= t "export"))
      (do (adv! p)
          (if (accept! p "{")
            (let [ms (decl-seq p :top)] (expect! p "}") [(node p "ExportDecl" b (last-ix p) {:inner ms})])
            (let [ns (parse-external-decl p :top)] [(node p "ExportDecl" b (if (seq ns) (ne (peek ns)) (last-ix p)) {:inner ns})])))
      (and (#{:top :member} ctx) (or (t= t "asm") (t= t "__asm__") (t= t "__asm")))
      (do (adv! p)
          ;; (cpp-rind: [dcl.asm]/1, an asm-declaration outside a function takes no asm-qualifier: GCC's "'const' is not an
          ;; 'asm' qualifier", "'asm' qualifier outside of function body" (inline, goto), "expected '(' before 'restrict'",
          ;; volatile a warning; the declaration read on; asm-qual-3.C had crashed in skip-balanced!)
          (loop []
            (let [q (ts (cur p))]
              (when (#{"volatile" "__volatile__" "__volatile" "const" "inline" "__inline" "__inline__" "goto" "restrict" "__restrict"} q)
                (when (and (not (skim? p)) (main-tok? p (ix p)))
                  (case q
                    ("volatile" "__volatile__" "__volatile") nil
                    "const" (soft-diag! p (ix p) "'const' is not an 'asm' qualifier")
                    ("restrict" "__restrict") (soft-diag! p (ix p) (str "expected '(' before '" q "'"))
                    (soft-diag! p (ix p) "'asm' qualifier outside of function body")))
                (adv! p) (recur))))
          (if (is? p "(") (skip-balanced! p) (perr p "an asm declaration's ("))
          (let [e (last-ix p)] (expect! p ";") [(node p "FileScopeAsmDecl" b e {})]))
      :else (parse-simple-decl p ctx))))

;; ---------------------------------------------------------------------------------------------
;; Declarations in statements, conditions, for-range and catch

(defn block-decl-start?
  "A declaration statement at the cursor."
  [^P p]
  (let [^T t (cur p) s (.-s t)]
    (or (and (identical? :kw (.-k t))
             (contains? #{"static" "extern" "typedef" "using" "static_assert" "_Static_assert" "namespace" "register" "thread_local"
                          "constexpr" "constinit" "consteval" "struct" "class" "union" "enum" "inline" "_Thread_local" "__thread" "mutable"
                          "friend" "const" "volatile"} s))
        (is-simple-declaration? p false))))

(defn parse-block-decl
  "A declaration statement: its DeclStmt (the ; in its range)."
  [^P p]
  (let [b (ix p)
        ns (parse-external-decl p :block)]
    (node p "DeclStmt" b (last-ix p) {:inner ns})))

(declare parse-condition-var)

(defn parse-condition-decl
  "A condition's declaration (if (T x = e), if (auto [a, b] = e)): a DeclStmt holding its VarDecl or its
  DecompositionDecl, the names declared."
  [^P p]
  (let [ds (parse-decl-specs p :block)
        base (or (ds-type ds) (perr p "a condition's type"))]
    (if (or (is? p "[") (and (or (is? p "&") (is? p "&&")) (is-at? p 1 "[")))
      ;; a structured binding declaration as a condition (C++26's P0963, an extension before)
      (do ;; (cpp-read, 2026-11-22: GCC's pedwarn before C++26, "structured bindings in conditions only available with
          ;; -std=c++2c or -std=gnu++2c", at the [)
          (when (and (< (.-year p) 2026) (not (skim? p)) (main-tok? p (ix p)))
            (pedantic-diag! p (ix p) "structured bindings in conditions only available with -std=c++2c or -std=gnu++2c"))
          {:kind "DeclStmt" :inner [(parse-decomposition p ds :block base)]})
      (parse-condition-var p ds base))))

(defn- parse-condition-var [^P p ds base]
  (let [d (parse-declarator p :named)
        qn (:name (last (name-chain d)))
        _ (when-not qn (perr p "a condition's declarator"))
        nm (name-plain qn)
        ty (build-type base d)
        [x init] (cond (accept! p "=") [(parse-init-clause p) "c"]
                       (is? p "{") [(parse-braced-init p) "list"]
                       :else (perr p "a condition's initializer"))
        e (last-ix p)]
    (when nm (declare! p {:k :var :name nm}))
    {:kind "DeclStmt" :inner [(node p "VarDecl" (:b ds) e {:name nm :loc (loc p (long (:i (peek (:parts qn))))) :type {:qualType (qt ty)} :init init :inner [x]})]}))

(defn parse-for-range-decl
  "A for-range-declaration: its VarDecl (or a structured binding's DecompositionDecl), the name declared."
  [^P p]
  (let [ds (parse-decl-specs p :block)
        ;; (queue 376: [stmt.ranged]/2 with [dcl.type.general]/3, a for-range-declaration defines no class or enumeration: GCC's
        ;; "types may not be defined in a for-range-declaration", a permerror, at the class-key)
        _ (when-let [tn (:tag-node ds)]
            (when (and (not (skim? p)) (or (:completeDefinition tn) (and (= "EnumDecl" (:kind tn)) (seq (:inner tn)))))
              (soft-diag! p (long (:b ds)) "types may not be defined in a for-range-declaration")))
        base (or (ds-type ds) (perr p "a for-range declaration's type"))]
    (if (or (is? p "[") (and (or (is? p "&") (is? p "&&")) (is-at? p 1 "[")))
      (parse-decomposition p ds :for-range base)
      (let [d (parse-declarator p :named)
            qn (:name (last (name-chain d)))
            nm (name-plain qn)
            ty (build-type base d)]
        (when nm (declare! p {:k :var :name nm}))
        (node p "VarDecl" (:b ds) (last-ix p) {:name nm :loc (loc p (long (:i (peek (:parts qn))))) :type {:qualType (qt ty)}})))))

(defn parse-catch-param
  "A handler's exception-declaration: [type name name-token first-token], the name declared."
  [^P p]
  (let [ds (parse-decl-specs p :param)
        ;; (queue 376: [except.handle]/1 with [dcl.type.general]/3, an exception-declaration defines no class or enumeration:
        ;; GCC's "types may not be defined in exception-declarations", at the definition's opening brace)
        _ (when-let [tn (:tag-node ds)]
            (when (and (not (skim? p)) (or (:completeDefinition tn) (and (= "EnumDecl" (:kind tn)) (seq (:inner tn)))))
              (let [bi (loop [i (long (:b ds))] (if (or (t= (tok-at p i) "{") (>= i (long (ix p)))) i (recur (inc i))))]
                (soft-diag! p bi "types may not be defined in exception-declarations"))))
        base (or (ds-type ds) (perr p "a handler's type"))
        d (parse-declarator p :either)
        _ (op-param! p d)
        qn (:name (last (name-chain d)))
        nm (name-plain qn)
        ty (build-type base d)]
    (when nm (declare! p {:k :var :name nm}))
    [ty nm (if qn (long (:i (peek (:parts qn)))) (ix p)) (:b ds)]))

;; ---------------------------------------------------------------------------------------------
;; Lambdas, requires-expressions, requires-clauses

(def ^:dynamic *lambda-head-rc* "cpp-tpl2: a lambda's template-head's requires-clause being read (skip-requires-clause!)" false)

(defn skip-requires-clause!
  "A requires-clause at its `requires`: its constraint-logical-or-expression skipped (the converter writes a
  constrained template as its text)."
  [^P p]
  (adv! p)
  (loop []
    ;; (cpp-tpl2: [temp.pre]/1, the operands of && and || in a requires-clause are primary expressions: a `!`, or a postfix `(`
    ;; or `[` after a name, is GCC's "expression must be enclosed in parentheses" (skipped as before); in a lambda's
    ;; template-head a `(` after the clause begins its parameter list, *lambda-head-rc*)
    (let [enclose! (fn [] (when (and (not (skim? p)) (main-tok? p (ix p))) (soft-diag! p (ix p) "expression must be enclosed in parentheses")))]
    (loop [] (when (is? p "!") (enclose!) (adv! p) (recur)))
    (cond
      (is? p "(") (skip-balanced! p)
      (is? p "requires") (do (adv! p) (when (is? p "(") (skip-balanced! p)) (skip-balanced! p))
      (or (id? p) (is? p "::")) (let [builtin (and (id? p) (str/starts-with? (ts (cur p)) "__"))]
                                  (parse-name p :scan)
                                  (cond
                                    ;; (a built-in type trait's call, `__is_same(T, char)`, is a primary expression)
                                    (and builtin (is? p "(")) (skip-balanced! p)
                                    (and (or (is? p "(") (is? p "[")) (not (and *lambda-head-rc* (is? p "("))))
                                    (do (enclose!) (skip-balanced! p))))
      (or (is? p "true") (is? p "false") (identical? :num (tk (cur p)))) (adv! p)
      :else (perr p "a constraint")))
    (when (or (is? p "&&") (is? p "||")) (adv! p) (recur))))

(defn- requires-clause!
  "A requires-clause at its `requires` (P14 (b), the code generator's mode): skipped as before, and in full-header mode
  its constraint-logical-or-expression parsed as an expression node (clang's TemplateParameterList::getRequiresClause,
  FunctionDecl::getTrailingRequiresClause), or nil when it does not parse as one."
  [^P p]
  (let [b (ix p)
        _ (skip-requires-clause! p)
        e (ix p)]
    (when (and *full-headers* (not (skim? p)))
      (let [x (tentatively p (fn [p] (seek! p (inc b)) (let [x (with-gt p true (parse-expr p))] (when (= (ix p) e) x))))
            ;; (cpp-tpl2: else by its own grammar, [temp.pre]/1's constraint-logical-or-expression of primary expressions joined
            ;; by && and ||: a lambda's `requires C<T> (T t)`, whose parameter list a whole expression's parse takes for a call)
            x (if (map? x)
                x
                (tentatively p (fn [p]
                                 (seek! p (inc b))
                                 (let [and-e (fn [] (loop [l (with-gt p true (parse-primary p))]
                                                      (if (is? p "&&") (do (adv! p) (recur (bin-node p "&&" l (with-gt p true (parse-primary p))))) l)))
                                       x (loop [l (and-e)] (if (is? p "||") (do (adv! p) (recur (bin-node p "||" l (and-e)))) l))]
                                   (when (= (ix p) e) x)))))]
        (when (map? x) x)))))

(defn- keep-decltypes!
  "cpp-s11 (CP379 (a)): the operands of the decltypes among the tokens [from, to) of a requirement the parser keeps as its
  text (a type requirement, a return-type-requirement), parsed tentatively and kept by their text for the code generator's
  decltype as a decl-specifier's are (G4); the cursor put back."
  [^P p ^long from ^long to]
  (let [save (ix p)]
    (loop [i from]
      (when (< i to)
        (let [^T t (tok-at p i)]
          (if (and (or (t= t "decltype") (t= t "__decltype")) (t= (tok-at p (inc i)) "("))
            (let [close (loop [j (+ i 2) d 1]
                          (let [^T x (tok-at p j)]
                            (cond (or (identical? :eof (.-k x)) (>= j to)) nil
                                  (t= x "(") (recur (inc j) (inc d))
                                  (t= x ")") (if (= d 1) j (recur (inc j) (dec d)))
                                  :else (recur (inc j) d))))]
              (when (and close (not (and (t= (tok-at p (+ i 2)) "auto") (= (long close) (+ i 3)))))
                (seek! p (inc i))
                (let [x (tentatively p (fn [p] (adv! p) (let [x (with-gt p true (parse-expr p))] (when (is? p ")") x))))]
                  (when (map? x) (.put ^HashMap (stv p DECLTYPES) (str/replace (tok-text p (+ i 2) (dec (long close))) #"\s+" "") x))))
              (recur (inc i)))
            (recur (inc i))))))
    (seek! p save)))

(defn- parse-requires-body
  "A requires-expression's parameters and requirements ([expr.prim.req]), the cursor after its `requires`: the node with
  its requirements as clang's AST has them (SimpleRequirement, TypeRequirement, CompoundRequirement, NestedRequirement:
  the code generator's mode, G4)."
  [^P p b]
  (with-scope p :block nil
    (let [pl (when (is? p "(") (adv! p) (binding [*param-depth* 0 *auto-params* nil] (parse-param-list p)))
          _ (when pl (declare-params! p (:names pl) (:types pl)))
          _ (expect! p "{")
          reqs (loop [out []]
                 (cond
                   (accept! p "}") out
                   (is? p "typename") (let [rb (ix p)]
                                        ;; (cpp-s11, CP379 (a): its decltypes' operands parsed tentatively and kept by their
                                        ;; text as a decl-specifier's are (keep-decltypes!): <iterator_concepts.h>'s
                                        ;; __cpp17_input_iterator requires `typename common_reference_t<decltype(*__it++)&&,
                                        ;; ...>`, which had not resolved, "decltype(* __it ++)", so the requirement was false,
                                        ;; iterator_traits of a C++20 iterator declaring only iterator_concept took the output
                                        ;; iterator's specialization and <format>'s basic_string(_Utf_iterator, _Utf_iterator)
                                        ;; no constructor; the requirement is still kept as its text)
                                        (skip-until! p #{";"})
                                        (keep-decltypes! p (inc rb) (ix p)) (let [e (last-ix p)] (expect! p ";")
                                                                                  (recur (conj out {:kind "TypeRequirement" :type {:qualType (tok-text p (inc rb) e)}}))))
                   (is? p "{") (do (adv! p)
                                   (let [x (with-gt p true (parse-expr p))]
                                     (expect! p "}")
                                     (let [nx (accept! p "noexcept")
                                           ;; (CX12, CP281 (a): the return-type-requirement's type-constraint as written)
                                           rb (when (accept! p "->") (ix p))]
                                       (skip-until! p #{";"})
                                       ;; (cpp-s11: its decltypes' operands kept too, __cpp17_randacc_iterator's
                                       ;; `{ __it - __it } -> same_as<decltype(__n)>`)
                                       (when rb (keep-decltypes! p rb (ix p)))
                                       (let [rt (when (and rb (> (long (ix p)) (long rb))) (tok-text p rb (last-ix p)))
                                             ;; (n-cpp-concepts, [expr.prim.req.compound]/1: a return-type-requirement is
                                             ;; `-> type-constraint`, a concept's name with its arguments and nothing else;
                                             ;; GCC's "return-type-requirement is not a type-constraint" on a type, `-> T`)
                                             bad (when (and rt (not (skim? p)))
                                                   (let [end (ix p)]
                                                     (seek! p rb)
                                                     (let [ok (when (name-start? p)
                                                                (when-let [[qn e] (scan-name p)] (and (concept-ent? (:ent qn)) (= (long e) (long end)))))]
                                                       (seek! p end)
                                                       (when-not ok (soft-diag! p rb "return-type-requirement is not a type-constraint") true))))]
                                         (expect! p ";")
                                         (recur (conj out (cond-> {:kind "CompoundRequirement" :inner [x]}
                                                            nx (assoc :_noexcept true)
                                                            rt (assoc :_ret rt)
                                                            bad (assoc :_ret_bad true))))))))
                   (is? p "requires") (do (adv! p)
                                          (let [x (with-gt p true (parse-expr p))] (expect! p ";")
                                            (recur (conj out {:kind "NestedRequirement" :inner [x]}))))
                   :else (let [x (with-gt p true (parse-expr p))] (expect! p ";")
                           (recur (conj out {:kind "SimpleRequirement" :inner [x]})))))]
      (node p "RequiresExpr" b (last-ix p) {:inner reqs :params (vec (:params pl))}))))

(defn parse-requires-expr [^P p]
  (let [b (ix p)]
    (adv! p)
    (or (when (and *full-headers* (not (skim? p)))
          (let [save (ix p)]
            (try (parse-requires-body p b)
                 (catch arbace.lang.ExceptionInfo x
                   ;; cpp-read (2026-11-22): a main-file requirement the grammar does not derive is the requires-expression's
                   ;; syntax error ([expr.prim.req]), the text node kept as before (lambda-requires4.C's `requires { []; }`)
                   (let [at (:at (ex-data x))]
                     (when (and (:cpp/parse (ex-data x)) at (main-tok? p (long at)))
                       (soft-diag! p (long at) (str (:why (ex-data x))))))
                   (seek! p save) nil))))
        (do
          (when (is? p "(") (skip-balanced! p))
          (when-not (is? p "{") (perr p "a requires-expression's body"))
          (skip-balanced! p)
          (text-node p "RequiresExpr" b)))))

(defn parse-lambda [^P p]
  (let [b (ix p)]
    (expect! p "[")
    (with-scope p :block nil
      (let [inits (loop [inits []]
                    (cond
                      (is? p "]") (do (adv! p) inits)
                      (is? p ",") (do (adv! p) (recur inits))
                      (and (or (is? p "&") (is? p "=")) (or (is-at? p 1 "]") (is-at? p 1 ","))) (do (adv! p) (recur inits))
                      ;; the init-captures' initializers (the converter finds each by its offset; clang lists one for every
                      ;; capture, a simple one's the variable it names, which the forms do not need)
                      (is? p "this") (do (adv! p) (recur inits))
                      (and (is? p "*") (is-at? p 1 "this")) (do (adv! p) (adv! p) (recur inits))
                      :else
                      (let [amp (accept! p "&")]
                          (accept! p "...")
                          (if (id? p)
                            (let [nm (ts (cur p)) i (ix p)
                                  outer (lookup (scope p) nm)]
                              (adv! p) (accept! p "...")
                              ;; a capture by copy copies its variable (its class's copy constructor)
                              (when (and (not amp) (not (is? p "=")) (not (is? p "{")) (not (is? p "(")) (:ty outer))
                                (when-let [[c e] (sema/vclass {:kind "DeclRefExpr" :_ent outer} (.-year p))] (use-member! p e :copy)))
                              (sc/declare! (scope p) (cond-> {:k :var :name nm} (:ty outer) (assoc :ty (:ty outer))))
                              (cond (accept! p "=") (recur (conj inits (parse-init-clause p)))
                                    (is? p "{") (let [bi (ix p) x (parse-braced-init p)
                                                      ;; (cpp-rind: [expr.prim.lambda.capture]/6 with [dcl.type.auto.deduct]/4, an init-capture's
                                                      ;; direct-list-initialization deduces from one element: GCC's "initializer for lambda
                                                      ;; capture 'n' does not have one element"; cpp1y/lambda-ice1.C)
                                                      els (when (map? x) (filter map? (:inner x)))]
                                                  (when (and (map? x) (= "InitListExpr" (:kind x)) (not= 1 (count els)) (not (skim? p)) (main-tok? p bi))
                                                    (soft-diag! p bi (str "initializer for lambda capture '" nm "' does not have one element")))
                                                  (recur (conj inits x)))
                                    (is? p "(") (let [as (paren-args p)] (recur (into inits (take 1 as))))
                                    :else (recur inits)))
                            (perr p "a capture")))))
            ;; (an explicit template-parameter-list's nodes: CP290 (a)'s generic lambda keeps them as data)
            tmpl (when (is? p "<")
                   ;; (h-cpp-read: a lambda's template-parameter-list is not empty, [expr.prim.lambda.general]/1: GCC's
                   ;; "expected identifier before '>' token")
                   (when (is-at? p 1 ">") (soft-diag! p (inc (ix p)) "expected identifier before '>' token"))
                   (let [ts (sc/new-scope :tparams (scope p) nil)]
                     (st! p SCOPE ts) (adv! p) (let [[tns] (parse-template-params p)] (expect! p ">") (vec tns))))
            ;; (cpp-tpl2: the template-head's requires-clause kept for the generic lambda's call operator template, :_glam's :rc)
            hrc (when (is? p "requires") (binding [*lambda-head-rc* true] (let [b0 (ix p)] (or (requires-clause! p) (do (when (= b0 (ix p)) (skip-requires-clause! p)) nil)))))
            ;; (cpp-read, 2026-11-22: C++23's attribute-specifier-seq after the lambda-introducer, appertaining to the call
            ;; operator ([expr.prim.lambda.general]/1, P2173R1; GCC takes it in every mode), before the lambda-declarator)
            ;; (cpp-gnu, 2026-11-22: GNU's unavailable among them marks the lambda, arbace.repr.cpp.diag/unavailable's)
            lam-unavail (when (and (is? p "[") (is-at? p 1 "["))
                          (let [a0 (ix p)] (attr-nodes p) (some #(contains? #{"unavailable" "__unavailable__"} (ts (tok-at p %))) (range a0 (ix p)))))
            pi0 (ix p)
            pl (when (is? p "(") (adv! p) (binding [*param-depth* 0 *auto-params* nil] (parse-param-list p)))
            ;; (round 54, fourth pass: C++11's [expr.prim.lambda]/5, a lambda's parameter-declaration-clause has no default argument
            ;; (allowed from C++14, CWG 974): GCC's pedwarn "default argument specified for lambda parameter", at the '=')
            _ (when (and pl (= 2011 (.-year p)))
                (loop [i (inc (long pi0)) d 0]
                  (when (< i (long (ix p)))
                    (let [^T t (tok-at p i)]
                      (cond (or (t= t "(") (t= t "[") (t= t "{")) (recur (inc i) (inc d))
                            (or (t= t ")") (t= t "]") (t= t "}")) (when (pos? d) (recur (inc i) (dec d)))
                            (and (zero? d) (t= t "=")) (pedantic-diag! p i "default argument specified for lambda parameter")
                            :else (recur (inc i) d))))))
            ;; (CX12: a lambda declared constexpr keeps the fact, `:_cexpr`, for the checker's rules of a constexpr function's
            ;; body, [dcl.constexpr]/3)
            cexpr (volatile! false)
            ;; (cpp-read, 2026-11-22: before C++23 a lambda-declarator's specifiers, exception specification or trailing return
            ;; type follow its parameter-declaration-clause, [expr.prim.lambda.general]/1 (P1102R2 made the () optional): GCC's
            ;; pedwarn "parameter declaration before lambda ... only optional with -std=c++23", once, where the ( was expected)
            _ (when (and (nil? pl) (< (.-year p) 2023) (not (skim? p)) (main-tok? p (ix p)))
                (when-let [what (cond (or (is? p "mutable") (is? p "constexpr") (is? p "consteval") (is? p "static")) "declaration specifiers"
                                      (or (is? p "noexcept") (and (is? p "throw") (is-at? p 1 "("))) "exception specification"
                                      (is? p "->") "trailing return type"
                                      :else nil)]
                  (pedantic-diag! p (ix p) (str "parameter declaration before lambda " what " only optional with -std=c++23 or -std=gnu++23"))))
            ;; (h-cpp-read: the lambda-specifier-seq precedes the attributes of the call operator's type, [expr.prim.lambda.general]/1:
            ;; a specifier after them is GCC's "expected '{' before" it)
            latt (volatile! false)
            seen (java.util.HashSet.)
            _ (loop [] (cond (or (is? p "mutable") (is? p "constexpr") (is? p "consteval") (is? p "static"))
                             (do (when @latt (soft-diag! p (ix p) (str "expected '{' before '" (ts (cur p)) "'")))
                                 ;; (round 54: [expr.prim.lambda.general]/4, each lambda-specifier at most once; a static lambda C++23's,
                                 ;; GCC's pedwarn before it)
                                 (when-not (.add seen (ts (cur p))) (soft-diag! p (ix p) (str "duplicate '" (ts (cur p)) "' specifier")))
                                 (when (and (is? p "static") (< (.-year p) 2023)) (pedantic-diag! p (ix p) "'static' only valid in lambda with -std=c++23"))
                                 ;; (round 54, fourth pass: [expr.prim.lambda.general]/4's constexpr lambda-specifier is C++17's: before it
                                 ;; GCC's error "'constexpr' lambda only available with '-std=c++17' or '-std=gnu++17'")
                                 (when (and (is? p "constexpr") (< (.-year p) 2017)) (soft-diag! p (ix p) "'constexpr' lambda only available with '-std=c++17' or '-std=gnu++17'"))
                                 (when (or (is? p "constexpr") (is? p "consteval")) (vreset! cexpr true)) (adv! p) (recur))
                             (is? p "noexcept") (do (adv! p)
                                                    (when (and (is? p "(") (is-at? p 1 ")")) (soft-diag! p (inc (ix p)) "expected primary-expression before ')' token"))
                                                    (when (is? p "(") (skip-balanced! p)) (recur))
                             (and (is? p "throw") (is-at? p 1 "(")) (do (adv! p) (skip-balanced! p) (recur))
                             (or (and (is? p "[") (is-at? p 1 "[")) (is? p "__attribute__")) (do (vreset! latt true) (if pl (type-attrs! p) (attr-nodes p)) (recur))
                             :else nil))
            ret (when (is? p "->") (adv! p)
                      (let [rb (ix p) r (parse-type-id p :trailing)]
                        ;; (cpp-read, 2026-11-22: [dcl.fct]/11, no function returns a function or an array: a lambda's
                        ;; trailing return type of function type is GCC's "function returning a function", at the type)
                        (when (and (= :f (:t r)) (main-tok? p rb) (not (skim? p)))
                          (soft-diag! p rb "lambda declared as function returning a function"))
                        r))
            ;; (cpp-tpl2: the trailing requires-clause, its place kept, :_trq; for a generic lambda parsed with the parameters
            ;; in scope, :_glam's :trc)
            trq-at (when (is? p "requires") (ix p))
            trc (when trq-at
                  (with-scope p :fparams nil
                    (declare-params! p (:names pl) (:types pl))
                    (let [b0 (ix p)] (or (requires-clause! p) (do (when (= b0 (ix p)) (skip-requires-clause! p)) nil)))))
            generic (or tmpl (some (fn [t] (some #(= :auto (:t %)) (tree-seq map? (comp vector :of) t))) (:types pl)))
            ;; (cpp-tpl2: [dcl.decl.general]/4, a lambda's trailing requires-clause on a call operator that is no template,
            ;; outside any template: GCC's "constraints on a non-templated function", as a function declarator's below)
            _ (when (and trq-at (not generic) (not (skim? p)) (main-tok? p trq-at) (not (in-template? p)) (not (dep-this? p)))
                (soft-diag! p trq-at "constraints on a non-templated function"))
            body (let [old (stv p RET)]
                   (st! p RET nil)
                   (try (with-scope p :fparams nil (declare-params! p (:names pl) (:types pl)) (binding [*in-if* false] (parse-compound-stmt p)))
                        (finally (st! p RET old))))
            op-type {:t :f :ps (:types pl) :va (:va pl) :r (or ret {:t :auto}) :tr (boolean ret)}
            rec (cond-> {:kind "CXXRecordDecl" :isImplicit true
                         :inner (if generic [] [{:kind "CXXMethodDecl" :name "operator()" :type {:qualType (qt op-type)} :inner (or (:params pl) [])}])}
                  ;; (CP290 (a): a generic lambda's call operator is a member function template, clang's FunctionTemplateDecl
                  ;; in the closure; the native tree keeps the closure empty as before, compared with clang's as it was, and
                  ;; the template's parts as data for the code generator's Sema: the explicit template parameters, the
                  ;; parameters, the operator's type as written)
                  generic (assoc :_glam (cond-> {:tparams (if (vector? tmpl) tmpl []) :params (vec (:params pl)) :qt (qt op-type)}
                                          hrc (assoc :rc hrc) trc (assoc :trc trc))))]
        (node p "LambdaExpr" b (ne body) (cond-> {:inner (vec (concat [rec] inits [body]))} @cexpr (assoc :_cexpr true) lam-unavail (assoc :_unavailable true)
                                           ;; (cpp-tpl2: a non-generic lambda's trailing requires-clause, its place)
                                           (and trq-at (not generic)) (assoc :_trq (loc p trq-at))))))))

;; ---------------------------------------------------------------------------------------------
;; Declaration sequences, recovery, skim mode, the unit

(defn- skip-declaration!
  "Recovery: from a declaration's first token `b` to after its end (its ; at depth 0, or the } of a body at depth 0;
  a class body's declarators followed to their ;), stopping before the } of the enclosing scope: the declaration's last
  token before its ;."
  [^P p ^long b]
  (seek! p b)
  (let [classy (atom false)]
    (loop []
      (let [^T t (cur p)]
        (cond
          (identical? :eof (.-k t)) (last-ix p)
          (t= t ";") (let [e (last-ix p)] (adv! p) e)
          (t= t "}") (last-ix p)
          (t= t "{") (do (skip-rec! p false)
                         (cond (is? p ";") (let [e (last-ix p)] (adv! p) e)
                               (and @classy (or (id? p) (is? p "*") (is? p "&") (is? p ",") (is? p "=") (is? p "["))) (recur)
                               :else (last-ix p)))
          ;; (cpp-read, 2026-11-22: skip-rec!, an unclosed parenthesis yielding to the ; or the } of its level; it ran to the
          ;; file's end)
          (or (t= t "(") (t= t "[")) (do (skip-rec! p false) (recur))
          (or (t= t ")") (t= t "]")) (do (adv! p) (recur))
          :else (do (when (and (identical? :kw (.-k t)) (#{"class" "struct" "union" "enum" "typedef"} (.-s t))) (reset! classy true))
                    (adv! p) (recur)))))))

(defn- decl-or-decline [^P p ctx]
  (let [b (ix p)]
    (try (parse-external-decl p ctx)
         (catch arbace.lang.ExceptionInfo x
           (if (:cpp/parse (ex-data x))
             (let [_ (when (and debug? (not (skim? p))) (binding [*out* *err*] (println "decline:" (ex-message x))))
                   e (skip-declaration! p b)]
               (when (= (ix p) b) (adv! p))
               (if (or (skim? p) (not (main-tok? p b)))
                 (do (when (and *full-headers* (not (skim? p)) (System/getenv "CPP_HDR_TRACE"))
                       (binding [*out* *err*] (println "header decline:" (.-f (tok-at p b)) (.-o (tok-at p b)) (ex-message x))))
                     [])
                 (do (decline! p (str "declaration: " (:why (ex-data x))) (:at (ex-data x)) b)
                     [(node p "NativeDecline" b (max b (long e)) {})])))
             (throw x))))))

(defn decl-seq
  "The declarations at the cursor up to a } (not consumed) or the end: their nodes. A run of a header's tokens is
  skimmed: its declarations for their names alone."
  [^P p ctx]
  (loop [out []]
    (cond
      (or (eof? p) (is? p "}")) out
      (and (not (skim? p)) (not *full-headers*) (not (main-tok? p (ix p))))
      (do (skimming p true
            (loop []
              (when (and (not (eof? p)) (not (main-tok? p (ix p))))
                (if (is? p "}") (adv! p) (decl-or-decline p ctx))
                (recur))))
          (recur out))
      :else (recur (into out (decl-or-decline p ctx))))))

(def ^:private builtin-types
  ["__builtin_va_list" "__int128_t" "__uint128_t" "__NSConstantString" "__builtin_ms_va_list" "__size_t" "__signed_size_t"
   "__ptrdiff_t" "__bf16" "__fp16"])

(def ^:private builtin-templates ["__type_pack_element" "__make_integer_seq"])

(def ^:private skim-cache-min
  "The fewest header tokens worth a cache file."
  20000)

(defn- tokens-text
  "The tokens 0..k-1 as one text, every field of each (the header-skim cache's key): its kind, spelling, offset and
  length, its file when it changes, its macro expansion's length when it has one, its glue and scratch flags."
  ^String [^P p ^long k]
  (let [sb (StringBuilder.)]
    (loop [i 0 f nil]
      (when (< i k)
        (let [^T t (tok-at p i)
              tf (.-f t)]
          (when-not (identical? tf f) (.append sb \u0003) (.append sb (str tf)))
          (.append sb (str (.-k t))) (.append sb \u0001) (.append sb (.-s t)) (.append sb \u0001) (.append sb (.-o t))
          (.append sb \u0001) (.append sb (.-n t))
          (when-let [m (.-mac t)] (.append sb \u0004) (.append sb (str m)))
          (when (.-glue t) (.append sb \u0005))
          (when (.-scr t) (.append sb \u0006) (.append sb (str (.-scr t))))
          (.append sb \u0002)
          (recur (inc i) tf))))
    (.toString sb)))

(defn- specs-of
  "queue 380: the explicit specializations' registry (SPECS) as the caches keep it, [[primary-scope args entity] ...]: its
  scopes the state's own objects, written with their sharing."
  [^P p]
  (vec (for [^java.util.Map$Entry e (.entrySet ^java.util.IdentityHashMap (stv p SPECS))
             ^java.util.Map$Entry a (.entrySet ^HashMap (.getValue e))]
         [(.getKey e) (.getKey a) (.getValue a)])))

(defn- specs-from!
  "queue 380: the registry read back from a cache's state (a state written before it has none: no specialization known)."
  [^P p specs]
  (let [^java.util.IdentityHashMap m (stv p SPECS)]
    (doseq [[ps args ent] specs]
      (let [^HashMap h (or (.get m ps) (let [h (HashMap.)] (.put m ps h) h))] (.put h args ent)))))

(defn- skim-headers!
  "The leading run of header tokens skimmed (decl-seq's skim), its state taken from the header-skim cache when it holds
  it (arbace.repr.cpp.skim, keyed by the run's tokens and `parts`), else written into it: :hit, :stored or nil."
  [^P p parts]
  (let [n (.-cnt p)
        k (long (loop [i 0] (if (or (>= i (dec n)) (main-tok? p i)) i (recur (inc i)))))
        run (fn [] (skimming p true
                     (loop []
                       (when (and (not (eof? p)) (not (main-tok? p (ix p))))
                         (if (is? p "}") (adv! p) (decl-or-decline p :top))
                         (recur)))))
        dir (when (and parts (>= k (long skim-cache-min))) (skim/cache-dir))]
    (if-not dir
      (do (run) nil)
      (let [t00 (System/nanoTime)
            path (str dir "/" (skim/digest (concat parts [(.-year p) (.-gnu p) (.-main p) (tokens-text p k)])) ".skim")
            _ (when (System/getenv "REPR_CPP_TIME") (binding [*out* *err*] (println (format "repr/cpp native: the skim key %.2f s" (/ (- (System/nanoTime) t00) 1e9)))))
            t0 (System/nanoTime)
            st (try (skim/read-state path) (catch Exception _ nil))
            _ (when (System/getenv "REPR_CPP_TIME") (binding [*out* *err*] (println (format "repr/cpp native: the skim cache read %.2f s" (/ (- (System/nanoTime) t0) 1e9)))))]
        (if st
          (let [[root mt i specs] st]
            (st! p SCOPE root) (st! p ROOT root) (st! p MTMPL mt) (seek! p (long i)) (specs-from! p specs)
            :hit)
          (let [root (stv p ROOT)]
            (run)
            (when (and (identical? root (stv p SCOPE)) (nil? (stv p CLS)) (nil? (stv p THDR)))
              (try (skim/write-state path [root (stv p MTMPL) (ix p) (specs-of p)]) :stored
                   (catch Exception e
                     (binding [*out* *err*] (println "repr/cpp: the header-skim cache not written:" (ex-message e)))
                     nil)))))))))

(defn- full-headers!
  "In full-header mode (*full-headers*, the code generator's): the leading run of header tokens parsed in full, its
  nodes and the parser's state taken from the cache when it holds them (P15 (b), doc/cpp/CODEGEN.md G5: the skim
  cache's table and key, the run's tokens and `parts`, a key of its own kind), else parsed and written into it:
  [:hit|:stored|nil nodes]."
  [^P p parts]
  (let [n (.-cnt p)
        k (long (loop [i 0] (if (or (>= i (dec n)) (main-tok? p i)) i (recur (inc i)))))
        run (fn [] (loop [out []]
                     (if (and (not (eof? p)) (not (main-tok? p (ix p))))
                       (recur (if (is? p "}") (do (adv! p) out) (into out (decl-or-decline p :top))))
                       out)))
        ;; (opt-in, CPP_FULL_CACHE=1: on the tools' host reading the table back costs about what parsing does, G5.2)
        on (case (System/getenv "CPP_FULL_CACHE") "1" true "0" false *full-cache*)
        dir (when (and parts on (>= k (long skim-cache-min))) (skim/cache-dir))]
    (if-not dir
      [nil (run)]
      (let [t0 (System/nanoTime)
            path (str dir "/" (skim/digest (concat ["full"] parts [(.-year p) (.-gnu p) (.-main p) (tokens-text p k)])) ".full")
            t1 (System/nanoTime)
            st (try (skim/read-state path) (catch Exception _ nil))
            _ (when (System/getenv "REPR_CPP_TIME")
                (binding [*out* *err*] (println (format "repr/cpp native: the full-header key %.2f s, cache read %.2f s" (/ (- t1 t0) 1e9) (/ (- (System/nanoTime) t1) 1e9)))))]
        (if st
          (let [[root mt i nodes ^HashMap dts unnamed specs] st]
            (st! p SCOPE root) (st! p ROOT root) (st! p MTMPL mt) (seek! p (long i)) (specs-from! p specs)
            (.putAll ^HashMap (stv p DECLTYPES) dts) (st! p UNNAMED unnamed)
            [:hit nodes])
          (let [root (stv p ROOT)
                nodes (run)]
            [(when (and (identical? root (stv p SCOPE)) (nil? (stv p CLS)) (nil? (stv p THDR)))
               (try (skim/write-state path [root (stv p MTMPL) (ix p) nodes (stv p DECLTYPES) (stv p UNNAMED) (specs-of p)]) :stored
                    (catch Exception e
                      (binding [*out* *err*] (println "repr/cpp: the full-header cache not written:" (ex-message e)))
                      nil)))
             nodes]))))))

(defn- digit-sep-error
  "h-cpp-read: what is wrong with a pp-number's digit separators ([lex.icon]/1, [lex.fcon]/1: a separator between two digits
  of one digit sequence), as cpplib's cpp_classify_number words it, or nil."
  [^String s]
  (when (str/includes? s "'")
    (let [hex (re-find #"^0[xX]" s)]
      (cond (re-find #"^0[xXbB]'" s) "digit separator after base indicator"
            (or (str/includes? s ".'") (str/includes? s "'.")) "digit separator adjacent to decimal point"
            (re-find (if hex #"'[pP]|[pP][+-]?'" #"'[eE]|[eE][+-]?'") s) "digit separator adjacent to exponent"
            (re-find (if hex #"'(?![0-9A-Fa-f])" #"'(?![0-9])") s) "digit separator outside digit sequence"))))

(defn- ucn-error
  "h-cpp-read: a universal-character-name in an identifier that names no identifier character ([lex.name]/1, [lex.charset]/6):
  a surrogate, a control or basic character (below U+00A0; $ GCC's extension before C++26, where it is basic), or a
  bidirectional control (not XID_Continue), in cpplib's words; or nil."
  [^String s ^long year]
  (some (fn [[u h4 h8]]
          (let [v (Long/parseLong (or h4 h8) 16)]
            (cond (<= 0xD800 v 0xDFFF) (str u " is not a valid universal character")
                  (or (and (< v 0xA0) (not (and (= v 0x24) (< year 2026))))
                      (<= 0x202A v 0x202E) (<= 0x2066 v 0x2069) (= v 0x200E) (= v 0x200F))
                  (str "universal character " u " is not valid in an identifier"))))
        (re-seq #"\\u([0-9A-Fa-f]{4})|\\U([0-9A-Fa-f]{8})" s)))

(defn- char-literal-error
  "Round 54, fifth pass: what is wrong with a character literal token `s` (or a string literal's, `str?`) at the standard's
  `year`, in cpplib's words, or nil. [lex.ccon]/1 (P2362R3): a literal with an encoding prefix holds one c-char ('multi-
  character literal cannot have an encoding prefix'; u and U from C++11, u8 from C++17, L only from C++23, a warning before),
  encodable in one code unit of its type ('character not encodable in a single code unit': u8 past U+007F, u past U+FFFF);
  [lex.ccon]/3 (P1854R4), an ordinary literal's c-char encodable in one execution character code unit (UTF-8), GCC's pedwarn:
  a universal-character-name's or source character's code point past U+007F ('character not encodable in a single execution
  character code unit', or with more c-chars 'at least one character in a multi-character literal not encodable ...'); a
  universal-character-name past U+10FFFF in a UTF-16 literal, string or character, which cannot be converted ('converting UCN
  to execution character set: Illegal byte sequence')."
  [^String s ^long year str?]
  (let [[prefix cs] (try (lit/literal-c-chars s) (catch Exception _ nil))
        wide? (fn [[k v]] (and (not= k :unit) (> (long v) 0x7F)))]
    (cond
      (nil? prefix) nil
      (and (= prefix "u") (some (fn [[k v]] (and (= k :cp) (> (long v) 0x10FFFF))) cs))
      "converting UCN to execution character set: Illegal byte sequence"
      ;; (cpp-read: an ordinary string's character past U+00FF under an ISO-8859-1 execution character set)
      (and str? (= prefix "") *exec-latin1* (some (fn [[k v]] (and (not= k :unit) (> (long v) 0xFF))) cs))
      "converting to execution character set: Invalid or incomplete multibyte or wide character"
      str? nil
      ;; (cpp-rind: [lex.ccon]/1, a character literal holds at least one c-char: cpplib's "empty character constant"; ext/utf16-4.C)
      (empty? cs) "empty character constant"
      (and (> (count cs) 1) (or (and (#{"u" "U"} prefix) (>= year 2011)) (and (= prefix "u8") (>= year 2017)) (and (= prefix "L") (>= year 2023))))
      "multi-character literal cannot have an encoding prefix"
      (and (= 1 (count cs)) (not= :unit (ffirst cs))
           (or (and (= prefix "u8") (>= year 2017) (> (long (second (first cs))) 0x7F))
               (and (= prefix "u") (>= year 2011) (> (long (second (first cs))) 0xFFFF))))
      "character not encodable in a single code unit"
      ;; (cpp-read: an ISO-8859-1 execution character set, *exec-latin1*: a character past U+00FF converts to no code unit, an error;
      ;; one up to it is one)
      (and (= prefix "") *exec-latin1* (some (fn [[k v]] (and (not= k :unit) (> (long v) 0xFF))) cs))
      "converting to execution character set: Invalid or incomplete multibyte or wide character"
      (and (= prefix "") *exec-latin1*) nil
      (and (= prefix "") (= 1 (count cs)) (wide? (first cs))) "pedantic: character not encodable in a single execution character code unit"
      (and (= prefix "") (> (count cs) 1) (some wide? cs))
      "pedantic: at least one character in a multi-character literal not encodable in a single execution character code unit")))

(defn- escape-error
  "Round 54, sixth pass: a character or string literal token's `s` escapes at the standard's `year`, in cpplib's words, or nil:
  before C++23 a named-universal-character (P2071R2, [lex.universal.char]) is GCC's pedwarn 'named universal character
  escapes are only valid in C++23'; a hexadecimal escape's value past its code unit's range ([lex.ccon]/? (C++23 /8),
  [lex.string]/? : 8 bits narrow and UTF-8, 16 UTF-16, 32 UTF-32 and wide) GCC's pedwarn 'hex escape sequence out of range'."
  [^String s ^long year]
  (let [q (if (re-find #"^[A-Za-z0-9]*'" s) "'" "\"")
        i (.indexOf s q)
        prefix (subs s 0 (max 0 i))]
    (when (and (>= i 0) (not (str/ends-with? prefix "R")))
      (let [body (subs s (inc i) (max (inc i) (.lastIndexOf s q)))
            bits (case prefix ("" "u8") 8 "u" 16 ("U" "L") 32 nil)
            n (count body)]
        (loop [j 0 named nil hex nil]
          (if (>= j (dec n))
            (cond named (if (string? named) named "pedantic: named universal character escapes are only valid in C++23")
                  hex "pedantic: hex escape sequence out of range"
                  :else nil)
            (if (= \\ (.charAt body (int j)))
              (let [c (.charAt body (int (inc j)))]
                (cond
                  ;; (cpp-diag-b, 2026-11-22: [lex.ccon]'s simple, octal, hexadecimal and universal escapes alone, GNU's \e and \E
                  ;; beside: another is cpplib's pedwarn "unknown escape sequence"; C++23's delimited escapes \x{...} \o{...} \u{...}
                  ;; (P2290R3) before C++23 "delimited escape sequences are only valid in C++23")
                  (not (or (contains? #{\' \" \? \\ \a \b \f \n \r \t \v \x \u \U \N \o \e \E} c) (Character/isDigit c)))
                  (recur (+ j 2) "pedantic: unknown escape sequence" hex)
                  (and (contains? #{\x \u \o} c) (< year 2023) (< (+ j 2) n) (= \{ (.charAt body (int (+ j 2)))) (not (string? named)))
                  (recur (+ j 3) "pedantic: delimited escape sequences are only valid in C++23" hex)
                  (and (= c \o) (not (and (< (+ j 2) n) (= \{ (.charAt body (int (+ j 2)))))))
                  (recur (+ j 2) "pedantic: unknown escape sequence" hex)
                  (and (= c \N) (< year 2023) (< (+ j 2) n) (= \{ (.charAt body (int (+ j 2))))) (recur (+ j 3) (or named true) hex)
                  (and (= c \x) bits (< (+ j 2) n) (not= \{ (.charAt body (int (+ j 2)))))
                  (let [k (loop [k (+ j 2)] (if (and (< k n) (>= (Character/digit (.charAt body (int k)) 16) 0)) (recur (inc k)) k))
                        big (when (> k (+ j 2)) (.bitLength (BigInteger. (subs body (+ j 2) k) 16)))]
                    (recur (long k) named (or hex (and big (> (long big) (long bits))))))
                  :else (recur (+ j 2) named hex)))
              (recur (inc j) named hex))))))))

(defn- lexical-diags!
  "h-cpp-read (CP262 (b)'s syntax files): the main file's own tokens' lexical errors the shared lexer leaves to the
  compiler proper: digit separators out of place (C++14 on) and identifiers' universal-character-names, each a syntax error
  at its token, the parse unchanged."
  [^P p]
  (dotimes [i (.-cnt p)]
    (let [^T t (tok-at p i)]
      (when (and (main-tok? p i) (nil? (.-mac t)))
        (when-let [why (case (.-k t)
                         :num (or (when (>= (.-year p) 2014) (digit-sep-error (.-s t)))
                                  ;; (cpp-diag-b, 2026-11-22: [lex.icon]/1, an octal-literal's digits 0-7, a binary-literal's 0 and 1:
                                  ;; GCC's "invalid digit \"8\" in octal constant", "invalid digit \"2\" in binary constant")
                                  (when-let [[_ d] (re-matches #"0[0-7']*([89])[0-9']*(?:[uUlLzZ]*)" (.-s t))]
                                    (str "invalid digit \"" d "\" in octal constant"))
                                  (when-let [[_ d] (re-matches #"0[bB][01']*([2-9])[0-9']*(?:[uUlLzZ]*)" (.-s t))]
                                    (str "invalid digit \"" d "\" in binary constant"))
                                  ;; ([lex.fcon]: hexadecimal floating literals are C++17's; before, GCC's pedwarn)
                                  (when (and (< (.-year p) 2017) (re-matches #"0[xX][0-9a-fA-F'.]*[pP][-+]?[0-9']+[fFlL]?" (.-s t)))
                                    "pedantic: use of C++17 hexadecimal floating constant"))
                         :id (when (str/includes? (.-s t) "\\") (ucn-error (.-s t) (.-year p)))
                         ;; (round 54, fifth pass: [lex.ccon]'s encodable literals)
                         :chr (or (escape-error (.-s t) (.-year p)) (char-literal-error (.-s t) (.-year p) false))
                         :str (or (escape-error (.-s t) (.-year p)) (when (or (str/starts-with? (.-s t) "u\"") (and *exec-latin1* (str/starts-with? (.-s t) "\"")))
                                                                      (char-literal-error (.-s t) (.-year p) true)))
                         ;; (a user-defined literal's ud-suffix is an identifier too, [lex.ext]/1)
                         :udls (let [^String s (.-s t) x (subs s (inc (.lastIndexOf s "\"")))] (when (str/includes? x "\\") (ucn-error x (.-year p))))
                         :udlc (let [^String s (.-s t) x (subs s (inc (.lastIndexOf s "'")))] (when (str/includes? x "\\") (ucn-error x (.-year p))))
                         nil)]
          (soft-diag! p i why))))))

(defn parse-unit
  "The main file's top-level declarations as clang's AST nodes, from the parser's tokens `toks` (tokens'):
  {:nodes [...] :declines n :reasons {why n} :skim-cache :hit|:stored|nil}. `main` the main file's name in locations,
  `src` its text, `year` the standard's year, `gnu` a GNU mode; `cache-parts`, when given, what else keys the
  header-skim cache (the run's tokens key it too; nil: no cache)."
  ([toks main src year gnu] (parse-unit toks main src year gnu nil))
  ([^objects toks ^String main ^String src ^long year gnu cache-parts]
  (let [root (sc/new-scope :ns nil {:k :ns :name ""})
        p (P. toks (alength toks) (long-array 1) (object-array 17) main src year gnu)]
    (st! p SCOPE root) (st! p ROOT root) (st! p SKIM false) (st! p MTMPL (HashSet.)) (st! p DECLINES 0) (st! p GTOP true)
    (st! p UNNAMED 0) (st! p REASONS (HashMap.)) (st! p CLS nil) (st! p THDR nil) (st! p PATTRS (ArrayList.)) (st! p USES (ArrayList.)) (st! p DECLTYPES (HashMap.)) (st! p DIAGS (ArrayList.)) (st! p GATTRS (HashMap.)) (st! p SPECS (java.util.IdentityHashMap.))
    (doseq [nm builtin-types] (sc/declare! root {:k :type :name nm}))
    (lexical-diags! p)
    ;; clang's builtin templates (BuiltinTemplateDecl: __type_pack_element<N, T...>, __make_integer_seq<Seq, T, N>), names in
    ;; every scope as clang's ASTContext declares them; <bits/utility.h> uses them when __has_builtin answers 1 (CP332 (a))
    (doseq [nm builtin-templates] (sc/declare! root {:k :type :name nm :tmpl true :builtin-tmpl true}))
    (let [[cached pre] (if *full-headers* (full-headers! p cache-parts) [(skim-headers! p cache-parts) []])
          nodes (loop [out (vec pre)]
                  (let [out (into out (decl-seq p :top))]
                    ;; (cpp-gnu, 2026-11-22: a } at namespace scope with no block to close begins no declaration ([dcl.pre]/1):
                    ;; GCC's "expected declaration before '}' token", at it, parse/ivdep-2.C's and ivdep-3.C's)
                    (if (eof? p) out (do (soft-diag! p (ix p) "expected declaration before '}' token") (adv! p) (recur out)))))]
      {:nodes (let [^ArrayList us (stv p USES)
                    ;; (not in full-header mode: the headers' classes' uses make its graph cyclic; the code generator
                    ;; decides the exception specifications itself)
                    r (when (and (seq us) (not *full-headers*)) (sema/resolve-uses (vec us) year))]
                (this-members (if (seq r) (sema/patch-defaulted nodes r) nodes)))
       :declines (stv p DECLINES) :reasons (into {} (stv p REASONS)) :root (stv p ROOT) :skim-cache cached
       :decltypes (into {} (stv p DECLTYPES)) :syntax (vec (stv p DIAGS))}))))

(ns arbace.repr.cpp.parse
  "C++'s native parser (doc/cpp/NATIVE.md; doc/cpp/CPP-SURVEY.md §4.4, CX11): C++23 read without the oracle, giving
  clang 23.1.4's AST as data -- the main file's declarations as tools/cxxdump keeps them, the nodes' kinds, ranges
  and the fields arbace.repr.cpp.convert reads -- so that the converter makes the same forms from either tree, as
  repr/java's native parser gives javac's trees and repr/c's cc's. The grammar is the standard's (ISO/IEC
  14882:2024, Annex A), decided as clang's Parse decides it: the declaration-or-expression ambiguities of
  [stmt.ambig] and [dcl.ambig.res] by ParseTentative's disambiguation (isCXXDeclarationStatement,
  isCXXFunctionDeclarator, isCXXTypeId: the TPResult rules), `<` after a template name ([temp.names]) and `>>`
  split in template argument lists (C++11's ParseGreaterThanInTemplateList), the names' kinds from Sema's minimum
  (arbace.repr.cpp.scope). Clang's own printing is kept where the converter reads it: a declaration's type as its
  `qualType` (clang's TypePrinter: `const char *`, `int (*)[3]`, the injected class name with its parameters),
  literals as clang's (arbace.repr.cpp.lit). The headers' declarations are parsed for their names only (skim mode:
  bodies, initializers and default arguments skipped, as -skip-function-bodies does), and a main-file construct the
  parser cannot read is a node of kind \"NativeDecline\" over its text, which the converter writes as a text form
  and counts."
  (:require [arbace.repr.cpp.lit :as lit]
            [arbace.repr.cpp.scope :as sc]
            [arbace.repr.cpp.sema :as sema]
            [arbace.repr.cpp.skim :as skim]
            [arbace.string :as str])
  (:import [arbace.repr.c.lex Tok CFile]
           [arbace.repr.cpp.scope Scope]
           [java.util ArrayList HashMap HashSet]))

(set! *warn-on-reflection* true)

;; ---------------------------------------------------------------------------------------------
;; Tokens: the preprocessed stream as the parser reads it

;; k: :id :kw :num :str :chr :udls :udlc :punct :eof; s: the text (a punctuator's primary spelling, an alternative token's
;; operator); o: the offset in its file (a macro's token: the invocation's, as clang's expansion location); n: the token's
;; length as clang measures it at o (a `>` split from `>>` measures `>>`); f: the file's name as clang knows it (the main
;; file's as the converter's *main*); mac: a macro's token: the length of the invocation's name at o; glue: a `>` split from
;; `>>`, `>=` or `>>=` whose next token is the rest of it; scr: a token spelled in clang's scratch space (a builtin macro's: __LINE__,
;; __FILE__, __COUNTER__; a split `>`).
(deftype T [k ^String s ^long o ^long n f mac glue scr])

(def ^:private alt-ops
  {"and" "&&" "or" "||" "not" "!" "not_eq" "!=" "bitand" "&" "bitor" "|" "xor" "^" "compl" "~" "and_eq" "&=" "or_eq" "|="
   "xor_eq" "^="})

(def ^:private kws98
  #{"asm" "auto" "bool" "break" "case" "catch" "char" "class" "const" "const_cast" "continue" "default" "delete" "do" "double"
    "dynamic_cast" "else" "enum" "explicit" "export" "extern" "false" "float" "for" "friend" "goto" "if" "inline" "int" "long"
    "mutable" "namespace" "new" "operator" "private" "protected" "public" "register" "reinterpret_cast" "return" "short"
    "signed" "sizeof" "static" "static_cast" "struct" "switch" "template" "this" "throw" "true" "try" "typedef" "typeid"
    "typename" "union" "unsigned" "using" "virtual" "void" "volatile" "wchar_t" "while"})
(def ^:private kws11 #{"alignas" "alignof" "char16_t" "char32_t" "constexpr" "decltype" "noexcept" "nullptr" "static_assert" "thread_local"})
(def ^:private kws20 #{"char8_t" "concept" "consteval" "constinit" "co_await" "co_return" "co_yield" "requires"})
(def ^:private kws-ext
  #{"__attribute__" "__attribute" "__extension__" "__typeof__" "__typeof" "__decltype" "__restrict" "__restrict__" "__inline"
    "__inline__" "__asm__" "__asm" "__alignof" "__alignof__" "__const" "__volatile" "__volatile__" "__signed" "__signed__"
    "__complex" "__complex__" "_Complex" "__real" "__real__" "__imag" "__imag__" "__int128" "__thread" "_Alignas" "_Alignof"
    "_Atomic" "_Bool" "_Noreturn" "_Static_assert" "_Thread_local" "__label__" "__builtin_va_arg" "__builtin_offsetof" "__null"
    "__func__" "__FUNCTION__" "__PRETTY_FUNCTION__" "__float128" "__bf16" "_Float16" "__fp16" "__auto_type"
    "__builtin_bit_cast" "__builtin_types_compatible_p" "__builtin_convertvector" "__builtin_choose_expr" "__declspec"
    ;; (cpp-read, 2026-11-22: GCC's __constinit, constinit's spelling in every mode)
    "__constinit"})

(defn keywords
  "The keywords of the standard of year `year` (`gnu`: a GNU mode, `typeof` a keyword; `concepts`: -fconcepts, which makes
  `concept` and `requires` keywords at any standard, as GCC's D_CXX_CONCEPTS keywords; queue 336, D336-1 (a))."
  ([^long year gnu] (keywords year gnu false))
  ([^long year gnu concepts]
   (cond-> (into kws98 kws-ext)
     (>= year 2011) (into kws11)
     (>= year 2020) (into kws20)
     concepts (into #{"concept" "requires"})
     gnu (conj "typeof"))))

(def ^:private digraphs {"<:" "[" ":>" "]" "<%" "{" "%>" "}" "%:" "#" "%:%:" "##"})

(defn- id-len
  "The length of the identifier at offset `o` of `src` (a macro invocation's name)."
  ^long [^String src ^long o]
  (let [n (.length src)]
    (loop [i o] (if (and (< i n) (let [c (.charAt src (int i))] (or (Character/isLetterOrDigit c) (= c \_) (= c \$) (> (int c) 127)))) (recur (inc i)) (max 1 (- i o))))))

(defn tokens
  "The parser's tokens (an array of T, an :eof last) of the preprocessor's stream `pp-toks` (arbace.repr.c.pp's
  :tokens), the main file's tokens being those of the file named `main-path`, written `main` in locations;
  `src` the main file's text (one char a byte), `kws` the keyword set."
  [pp-toks ^String main-path ^String main ^String src kws]
  (let [out (ArrayList.)
        scr (volatile! nil)
        add (fn [k ^String s o n f mac glue] (.add out (T. k s (long o) (long n) f mac glue @scr)))]
    (doseq [^Tok t pp-toks]
      (let [ch (.-ch t)]
        (when-not (or (= ch \space) (= ch \newline))
          (let [^CFile cf (.-pf t)
                fname (when cf (.-name cf))
                main? (= fname main-path)
                f (if main? main (or fname "<built-in>"))
                o (.-po t)
                mac (when (and main? (seq (.-hs t))) (id-len src o))
                _ (vreset! scr (when-let [m (.-m t)]
                                 (when-let [^Tok nm (:name m)]
                                   (contains? #{"__LINE__" "__FILE__" "__COUNTER__" "__BASE_FILE__" "__INCLUDE_LEVEL__" "__FILE_NAME__"} (.-src nm)))))
                ^String s (.-src t)
                n (count s)]
            (case ch
              :IDENTIFIER (cond
                            (contains? alt-ops s) (add :punct (alt-ops s) o n f mac nil)
                            (contains? kws s) (add :kw s o n f mac nil)
                            :else (add :id s o n f mac nil))
              :PPNUMBER (add :num s o n f mac nil)
              (:STRINGLITERAL :LONGSTRINGLITERAL) (add :str s o n f mac nil)
              (:CHARCONST :LONGCHARCONST) (add :chr s o n f mac nil)
              :UDLSTRING (add :udls s o n f mac nil)
              :UDLCHAR (add :udlc s o n f mac nil)
              (:HEADER_NAME) (add :punct s o n f mac nil)
              (let [s (get digraphs s s)]
                (case s
                  ">>" (do (add :punct ">" o 2 f mac true) (add :punct ">" (if mac o (inc o)) 1 f mac nil))
                  ">=" (do (add :punct ">" o 2 f mac true) (add :punct "=" (if mac o (inc o)) 1 f mac nil))
                  ">>=" (do (add :punct ">" o 3 f mac true) (add :punct ">" (if mac o (inc o)) 2 f mac true)
                            (add :punct "=" (if mac o (+ o 2)) 1 f mac nil))
                  (add :punct s o n f mac nil))))))))
    (let [^T l (when (pos? (.size out)) (.get out (dec (.size out))))]
      (.add out (T. :eof "" (if l (+ (.-o l) (.-n l)) 0) 0 main nil nil nil)))
    (.toArray out)))

;; ---------------------------------------------------------------------------------------------
;; The parser's state

(deftype P [^objects toks ^long cnt ^longs ix ^objects st ^String main ^String src ^long year gnu])

(def ^:private ^:const SCOPE 0)    ; the current scope
(def ^:private ^:const SKIM 1)     ; skim mode: declarations for their names alone
(def ^:private ^:const MTMPL 2)    ; the names of member templates seen anywhere (a HashSet)
(def ^:private ^:const ROOT 3)     ; the global namespace's scope
(def ^:private ^:const CLS 4)      ; the classes being defined, innermost first: [{:name :ent :params} ...]
(def ^:private ^:const DECLINES 5) ; the count of main-file constructs declined
(def ^:private ^:const GTOP 6)     ; false inside a template argument list: `>` ends it
(def ^:private ^:const UNNAMED 7)  ; a counter of unnamed entities
(def ^:private ^:const REASONS 8)  ; the declines' reasons (a HashMap: reason -> count)
(def ^:private ^:const THDR 9)
(def ^:private ^:const USES 11)     ; the special members' uses (arbace.repr.cpp.sema's resolve-uses: an ArrayList)
(def ^:private ^:const RET 12)      ; the return type of the function whose body is being parsed
(def ^:private ^:const DECLTYPES 13) ; G4: decltype's operands parsed ({text-without-spaces node}, a HashMap; *full-headers* only)
(def ^:private ^:const GATTRS 15)  ; CP294 (a): the main file's GNU attributes clang does not know, by their first token (a HashMap)
(def ^:private ^:const DIAGS 14)   ; CX12: the main file's syntax errors, one a decline: [offset why] in an ArrayList (arbace.repr.cpp.diag)
(def ^:private ^:const SPECS 16)   ; queue 380: the explicit specializations defined, by their primary's scope (an IdentityHashMap) and arguments' text
(def ^:private ^:const PATTRS 10)   ; the attributes the ptr-operators of the declarator being parsed carried     ; the template header the next declaration is under: its parameters' names (for the injected class name)

(defn- stv [^P p k] (aget ^objects (.-st p) (int k)))
(defn- st! [^P p k v] (aset ^objects (.-st p) (int k) v))

(defn- ix ^long [^P p] (aget ^longs (.-ix p) 0))
(defn- seek! [^P p ^long i] (aset ^longs (.-ix p) 0 i))
(defn- adv! [^P p] (aset ^longs (.-ix p) 0 (inc (aget ^longs (.-ix p) 0))))
(defn- tok-at ^T [^P p ^long i] (aget ^objects (.-toks p) (int (if (< i (.-cnt p)) i (dec (.-cnt p))))))
(defn- cur ^T [^P p] (tok-at p (ix p)))
(defn- nxt ^T [^P p ^long k] (tok-at p (+ (ix p) k)))
(defn- tk [^T t] (.-k t))
(defn- ts ^String [^T t] (.-s t))

(defn- sym? [^T t] (let [k (.-k t)] (or (identical? k :punct) (identical? k :kw))))
(defn- t= [^T t ^String s] (and (sym? t) (.equals s (.-s t))))
(defn- is? [^P p ^String s] (t= (cur p) s))
(defn- is-at? [^P p ^long k ^String s] (t= (nxt p k) s))
(defn- id? [^P p] (identical? :id (.-k (cur p))))
(defn- id-is? [^P p ^String s] (let [t (cur p)] (and (identical? :id (.-k t)) (.equals s (.-s t)))))
(defn- id-is-at? [^P p ^long k ^String s] (let [^T t (nxt p k)] (and (identical? :id (.-k t)) (.equals s (.-s t)))))
(defn- eof? [^P p] (identical? :eof (.-k (cur p))))
(defn- main-tok? [^P p ^long i] (let [^T t (tok-at p i)] (= (.-f t) (.-main p))))

(def ^:dynamic *in-if*
  "cpp-read (2026-11-22): true while an if-statement's then-clause is parsed, GCC's in_statement IN_IF_STMT (an iteration or switch
  statement's body and a lambda's resets it): a compound statement there ends at an `else`."
  false)

(def ^:dynamic *exec-latin1*
  "cpp-read (2026-11-22): the ordinary literals' encoding is ISO-8859-1 (-fexec-charset=ISO-8859-1, the dg check's own front end
  given the test's option, arbace.repr.cpp.native): a character past U+00FF has no code unit, [lex.ccon]/3, [lex.string]/10
  (C++26's P1854R4: ill-formed), GCC's \"converting to execution character set\"."
  false)

(def ^:dynamic *sub-stmt*
  "cpp-read (2026-11-22): true while a selection or iteration statement's sub-statement is parsed (not a compound statement's
  statements): a label there labels a statement, P2324R2's label at the end applies to a compound statement alone."
  false)

(def ^:dynamic *fn-names*
  "cpp-read (2026-11-22): the names of the functions whose bodies are parsed: [basic.scope.pdecl]/1 puts a function's point of
  declaration after its declarator, so its body names it (a recursive call), which the parser declares after the body."
  #{})

(def ^:dynamic *fn-start*
  "cpp-read (2026-11-22): the offset of the declaration whose function body is parsed (nil outside one): an error already given in
  it holds back 'does not name a type' there, a declaration's failure's cascade (template/crash35.C)."
  nil)

(def ^:dynamic *this-ok*
  "cpp-read (2026-11-22): the function whose body is parsed, for `this` ([expr.prim.this]/2-3): :member a non-static member
  function's (or an out-of-class member's), :static a static member function's, :nonmember another function's; nil outside a
  body and within a class's member-specification (its default member initializers)."
  nil)

(defn- perr [^P p ^String msg]
  (throw (ex-info (str "cpp native: " msg " at " (ts (cur p)) " (" (.-o (cur p)) ")") {:cpp/parse true :at (ix p) :why msg})))

(defn- accept! [^P p ^String s] (when (is? p s) (adv! p) true))
(defn- expect! [^P p ^String s] (if (is? p s) (adv! p) (perr p (str "expected " s))))

(defn- skim? [^P p] (boolean (stv p SKIM)))
;; cpp-tpl (2026-11-23): the lexer splits `>=` and `>>=` into `>` tokens (glued) and a `=`; [lex.pptoken]/3's maximal munch made them one
;; token, which [temp.names]/4 does not split: such a `>` closes no template argument list (GCC's "'>=' should be '> =' to terminate a
;; template argument list"), and a `>=` in a template argument is the relational operator (clang's getBinOpPrecedence: greaterequal is
;; relational whatever GreaterThanIsOperator says)
(defn- gt-lexeme-at
  "The lexeme the `>` at offset `k` from the cursor starts: \">=\" or \">>=\" (one of the split tokens), else nil; the second `>` of a
  `>>=` is its own lexeme's middle: \">>=\" too."
  [^P p ^long k]
  (let [^T t (nxt p k)]
    (when (and (t= t ">") (.-glue t))
      (let [^T a (nxt p (inc k)) ^T pv (when (pos? (+ (ix p) k)) (nxt p (dec k)))]
        (cond (and (t= pv ">") (.-glue pv) (= 3 (.-n pv)) (t= a "=")) ">>="
              (t= a "=") ">="
              (and (t= a ">") (.-glue a) (is-at? p (+ k 2) "=")) ">>=")))))

(declare scope)

;; the language linkage of the declarations being parsed ("C" inside extern "C"): kept in a function's entity for
;; the code generator (arbace.cpp.sema), whose header functions are known by their entities alone
(def ^:dynamic *linkage* nil)

;; (round 54, second pass: a type-id's decl-specifiers being parsed, [dcl.type.general]/3: the depth of the class stack there, so
;; that a class defined as a member of the class the type-id defines is the same error, GCC's, and a type-id nested in it not again)
(def ^:dynamic *tid-def* nil)
;; queue 376: where a type-id stands, in GCC's words for "types may not be defined ..." ("in casts", "in 'sizeof' expressions",
;; ...), bound by the callers of parse-type-id; nil: "in a type-id"
(def ^:dynamic *tdef-ctx* nil)

;; G4 (doc/cpp/CODEGEN.md): the headers' declarations parsed in full, bodies and all, their nodes given with the main
;; file's (the code generator's mode: arbace.cpp.codegen binds it); a header construct the parser cannot read is dropped
;; (CPP_HDR_TRACE=1 prints each, its file and offset). Off: the headers skimmed for their names (the converter's mode)
(def ^:dynamic *full-headers* false)
;; P15 (b)'s full parse cache: on with CPP_FULL_CACHE=1, or where a caller binds this true (CP336 (a): the run checks' gen-batch,
;; arbace.cpp.codegen); CPP_FULL_CACHE=0 keeps it off everywhere
(def ^:dynamic *full-cache* false)
;; queue 439: GNU's vector_size among a declaration's specifiers or a cast's type-id makes their type the vector type (as a
;; typedef's always does): arbace.cpp.codegen binds it true; the checker (arbace.repr.cpp.diag) refuses vector types, so off there
(def ^:dynamic *vector-specs* false)
;; cpp-gnu (2026-11-22): the classes being defined whose member-specification is being parsed (not pre-skimmed): an identity map
;; of each class's scope to [its complete scope (the pre-skim's) and a map of the names used in it (unqualified names, a qualified
;; name's first part) whose lookup passed the class without finding a member it declares later, to the first use's offset];
;; arbace.repr.cpp.diag/changes-meaning reads them off the class's node (:_cm-uses)
(def ^:dynamic *cm-scopes* nil)

;; cpp-rind: [dcl.fct]/22 (C++20 [dcl.spec.auto.general]/2-3), a placeholder `auto` as a parameter's decl-specifier only in a
;; lambda's parameter-declaration-clause or a function declaration's own one at namespace or class scope (an abbreviated function
;; template, never in a local class): the depth of the parameter-declaration-clauses being read (a function type's own parameter
;; of a parameter is depth 2) and the declaration's depth-1 `auto` tokens, judged once its declarator is read
(def ^:dynamic *param-depth* 0)
(def ^:dynamic *auto-params* nil)


(defn- in-template?
  "Whether the cursor is in a template (a parameter list with parameters encloses it; an explicit specialization's has none)."
  [^P p]
  (loop [^Scope s (stv p SCOPE)]
    (when s (if (and (= :tparams (sc/kind-of s)) (pos? (.size ^java.util.HashMap (sc/names-of s)))) true (recur (sc/parent-of s))))))
(defn- scope ^Scope [^P p] (stv p SCOPE))

;; (cpp-rt-own: the two below are parse.ae's, not arbace.repr.cpp.scope's: a change to that namespace redefines its deftype Scope
;; while the stage 0 seed's compiled skim and sema keep the old class, the "Tok cannot be cast to Tok" of doc/W-WINDOW.md §8 risk 2)
(defn- lookup
  "Unqualified lookup of `nm` from the scope `s` outward (arbace.repr.cpp.scope/lookup), but that a lookup scope of a qualified
  declarator-id's class or namespace (an out-of-class member's, `struct N::C::D`, `void N::f(...)`: its entity a :type or :ns)
  is followed by the definition's own template parameter lists and then by the namespaces enclosing that class or namespace,
  before the scopes the definition is written in ([basic.lookup.unqual]/9, C++23 [basic.lookup.unqual]/4: the names after a
  member's declarator-id are looked up in its class, its enclosing classes and namespaces; [temp.local]/7: the definition's
  template parameters hide the namespace's members): libstdc++'s fs_dir.cc defines `struct fs::_Dir` and
  `fs::directory_iterator::directory_iterator(const path& p, ..., error_code* ecptr)` at the global namespace, `fs` an alias of
  std::filesystem."
  ([s nm] (lookup s nm false))
  ([s nm tags?]
   (loop [s s]
     (when s
       (or (sc/find-in s nm tags?)
           (let [e (sc/ent-of s) cs (:scope e)]
             (if (and (= :lookup (sc/kind-of s)) (#{:type :ns} (:k e)) (some? cs))
               (let [[r q] (loop [q (sc/parent-of s)]
                             (if (and q (= :tparams (sc/kind-of q)))
                               (if-let [r (sc/find-in q nm tags?)] [r q] (recur (sc/parent-of q)))
                               [nil q]))]
                 (or r
                     ;; (the class's own enclosing scopes in turn: a class defined outside its class, `class locale::_Impl`, has a
                     ;; lookup scope of locale for its parent, whose names (facet) its members' bodies see, as the enclosing classes)
                     (loop [o (sc/parent-of cs)] (when o (or (when (#{:ns :lookup :class} (sc/kind-of o)) (sc/find-in o nm tags?)) (recur (sc/parent-of o)))))
                     (recur q)))
               (recur (sc/parent-of s)))))))))

(defn- redeclare-incomplete!
  "A class defined by a qualified name (`struct N::C { ... }`): `e` replaces the incomplete class `nm` declared before in the
  scope `s` or one of its inline namespaces (<bits/fs_dir.h>'s `struct _Dir;` in std::filesystem::__cxx11), in the scope that
  holds it, its names and its tags; true when one was replaced."
  [s nm e]
  (let [seen (java.util.IdentityHashMap.)]
    (letfn [(go [s]
              (when (and s (not (.containsKey seen s)))
                (.put seen s true)
                (let [^HashMap m (sc/names-of s) ^HashMap t (sc/tags-of s)
                      o (.get m nm) ot (.get t nm)
                      inc? (fn [x] (and (sc/type-ent? x) (:incomplete x)))]
                  (if (or (inc? o) (inc? ot))
                    (do (when (inc? o) (.put m nm (cond-> e (:tmpl o) (assoc :tmpl true))))
                        (when (inc? ot) (.put t nm (cond-> e (:tmpl ot) (assoc :tmpl true))))
                        true)
                    (some go (sc/inline-of s))))))]
      (boolean (go s)))))

(defmacro ^:private with-scope
  "Runs body with a new scope of kind `kind` (entity `ent`) pushed, popped after."
  [p kind ent & body]
  `(let [p# ~p old# (stv p# SCOPE) s# (sc/new-scope ~kind old# ~ent)]
     (st! p# SCOPE s#)
     (try ~@body (finally (st! p# SCOPE old#)))))

(defmacro ^:private in-scope
  "Runs body with `s` as the current scope."
  [p s & body]
  `(let [p# ~p old# (stv p# SCOPE)]
     (st! p# SCOPE ~s)
     (try ~@body (finally (st! p# SCOPE old#)))))

(defmacro ^:private with-gt
  "Runs body with `>` an operator (true) or the end of a template argument list (false)."
  [p v & body]
  `(let [p# ~p old# (stv p# GTOP)]
     (st! p# GTOP ~v)
     (try ~@body (finally (st! p# GTOP old#)))))

(defmacro ^:private skimming
  "Runs body in skim mode (`v` true) or not."
  [p v & body]
  `(let [p# ~p old# (stv p# SKIM)]
     (st! p# SKIM ~v)
     (try ~@body (finally (st! p# SKIM old#)))))

;; ---------------------------------------------------------------------------------------------
;; Locations and nodes, as tools/cxxdump writes clang's

(defn- loc [^P p ^long i]
  (let [^T t (tok-at p i)]
    (if-let [m (or (.-mac t) (when (and (.-glue t) (identical? :punct (.-k t)) (= ">" (.-s t))) (.-n t)))]
      {:spellingLoc {:offset (.-o t) :file (if (or (.-scr t) (.-glue t)) "<scratch space>" "<macro>") :tokLen (.-n t)}
       :expansionLoc {:offset (.-o t) :file (.-f t) :tokLen (long m)}}
      {:offset (.-o t) :file (.-f t) :tokLen (.-n t)})))

(defn- rng [^P p ^long b ^long e] {:begin (loc p b) :end (loc p e)})

(defn- nd
  "A node of kind `kind` over the tokens b..e (both included) with the fields of `m`."
  [^P p ^String kind ^long b ^long e m]
  (assoc m :kind kind :range (rng p b e)))

(defn- last-ix ^long [^P p] (dec (ix p)))

(declare builtin-name)

(def ^:private builtin-type-words
  #{"char" "short" "int" "long" "signed" "unsigned" "float" "double" "__int128" "_Complex" "__signed" "__signed__" "bool" "void"
    "wchar_t" "char8_t" "char16_t" "char32_t"})

(defn- tok-text
  "The tokens' texts from b to e (included), a space between: a printed name's or expression's text, its integer
  literals and builtin types' words as clang's StmtPrinter writes them."
  ^String [^P p ^long b ^long e]
  (let [sb (StringBuilder.)]
    (loop [i b]
      (when (<= i e)
        (let [^T t (tok-at p i)]
          (when (> i b) (when-not (and (t= (tok-at p (dec i)) ">") (.-glue (tok-at p (dec i)))) (.append sb " ")))
          (if (and (identical? :kw (.-k t)) (contains? builtin-type-words (.-s t)))
            (let [j (loop [j i] (if (and (<= (inc j) e) (let [^T n (tok-at p (inc j))] (and (identical? :kw (.-k n)) (contains? builtin-type-words (.-s n))))) (recur (inc j)) j))]
              (.append sb (builtin-name (mapv #(.-s ^T (tok-at p %)) (range i (inc j)))))
              (recur (inc j)))
            (do (.append sb (if (and (identical? :num (.-k t)) (lit/int-literal (.-s t)))
                              (let [[v ty] (lit/int-literal (.-s t))] (lit/int-print v ty))
                              (.-s t)))
                (recur (inc i)))))))
    (str sb)))

;; ---------------------------------------------------------------------------------------------
;; Types as clang's TypePrinter writes them (the converter reads a declaration's `qualType`)
;;
;; {:t :b :w [word ...]}           a builtin type's specifier words
;; {:t :n :s "a::b<int>"}          a named type (a class, enum, typedef, alias, template parameter), as clang prints it
;; {:t :elab :kw "struct" :s "S"}  an elaborated type specifier
;; {:t :tn :s "T::type"}           typename T::type
;; {:t :dt :s "x + 1"}             decltype(x + 1); {:t :auto} {:t :dta} decltype(auto)
;; {:t :p :of T}  {:t :lr :of T}  {:t :rr :of T}  {:t :mp :cls "C" :of T}  {:t :a :n "3" :of T}  {:t :pk :of T}
;; {:t :f :ps [T ...] :va bool :r T :q " const" :tr bool}
;; any of them with :c true :v true (cv-qualifiers)

(defn builtin-name
  "Clang's spelling of a builtin type's specifier words (in any order)."
  ^String [words]
  (let [ws (frequencies words)
        u (contains? ws "unsigned")
        l (+ (long (get ws "long" 0)) 0)
        cx (or (contains? ws "_Complex") (contains? ws "__complex") (contains? ws "__complex__"))
        core (first (remove #{"unsigned" "signed" "__signed" "__signed__" "long" "short" "int" "_Complex" "__complex" "__complex__"} (keys ws)))
        nm (cond
             (contains? ws "short") (if u "unsigned short" "short")
             (= core "char") (cond u "unsigned char" (or (contains? ws "signed") (contains? ws "__signed") (contains? ws "__signed__")) "signed char" :else "char")
             (= core "double") (if (pos? l) "long double" "double")
             (= core "__int128") (if u "unsigned __int128" "__int128")
             (= core "_Bool") "bool"
             core core
             (= l 2) (if u "unsigned long long" "long long")
             (= l 1) (if u "unsigned long" "long")
             u "unsigned int"
             :else "int")]
    (if cx (str "_Complex " nm) nm)))

(defn- cvs ^String [t]
  (str/join " " (remove nil? [(when (:c t) "const") (when (:v t) "volatile") (when (:rs t) "__restrict")])))

(declare qt*)

(defn- base? [t] (contains? #{:b :n :elab :tn :dt :auto :dta :unnamed :tt} (:t t)))

(defn- glue-inner ^String [^String base ^String inner]
  (cond (= "" inner) base
        (.startsWith inner "[") (str base inner)
        :else (str base " " inner)))

(defn- param-type
  "A parameter's type as a function type prints it: decayed, top-level cv dropped."
  [t]
  (let [t (case (:t t) :a {:t :p :of (:of t)} :f {:t :p :of t} t)]
    (dissoc t :c :v)))

(defn- strip-restrict [t] (dissoc t :r))

(defn qt*
  "The text of type `t` around the declarator text `inner`."
  ^String [t ^String inner]
  (let [cv (cvs t)]
    (case (:t t)
      (:b :n :elab :tn :dt :auto :dta :unnamed :tt)
      (let [b (case (:t t)
                :b (builtin-name (:w t))
                :n (:s t)
                :tt (:s t)
                :elab (str (:kw t) " " (:s t))
                :tn (str "typename " (:s t))
                :dt (str "decltype(" (:s t) ")")
                :auto (if (:cn t) (str (:cn t) " auto") "auto")
                :dta "decltype(auto)"
                :unnamed (:s t))]
        (glue-inner (if (= "" cv) b (str cv " " b)) inner))
      (:p :lr :rr :mp)
      (let [op (case (:t t) :p "*" :lr "&" :rr "&&" :mp (str (:cls t) "::*"))
            core (str op (when (and (not= "" cv) (or (#{:p :mp} (:t t)) (:rs t))) (str cv (when (and (seq inner) (not (.startsWith inner ")")) (not (.startsWith inner "["))) " "))) inner)
            of (:of t)]
        (if (#{:a :f} (:t of)) (qt* of (str "(" core ")")) (qt* of core)))
      :a (qt* (cond-> (:of t) (:c t) (assoc :c true) (:v t) (assoc :v true)) (str inner "[" (or (:n t) "") "]"))
      :f (let [ps (str/join ", " (concat (map #(qt* (param-type %) "") (:ps t)) (when (:va t) ["..."])))
               q (or (:q t) "")]
           (if (:tr t)
             (str "auto " inner "(" ps ")" q " -> " (qt* (:r t) ""))
             (qt* (:r t) (str inner "(" ps ")" q))))
      :pk (str (qt* (:of t) inner) "...")
      (throw (ex-info (str "cpp native: a type " (pr-str t)) {:cpp/parse true})))))

(defn qt ^String [t] (qt* t ""))

(defn- with-cv [t c v] (cond-> t c (assoc :c true) v (assoc :v true)))

;; ---------------------------------------------------------------------------------------------
;; Names: a possibly qualified id, its parts and template arguments, its entity
;;
;; {:g bool :parts [part ...] :b first-token :e last-token :ent the-entity :q the-qualifier's-entity}
;; part: {:s "id" :i token} with :args [arg ...] :ab :ae (the < and > tokens) and :tkw (after `template`); or the last part
;; {:op "+"} {:conv type} {:dtor "S"} {:lit "_km"}, each with :i. An argument: {:k :type :t T} {:k :expr :x node}
;; {:k :tmpl :name name} with :b :e (its tokens) and :pack.

(declare parse-template-args parse-type-id parse-cond-expr parse-assign-expr parse-expr tentatively soft-diag! class-ctx)

(defn- root-ent [^P p] {:k :ns :name "" :scope (stv p ROOT)})

(defn- ent-scope
  "The scope a qualified name continues in after the entity `e`: a namespace's, a class's (an alias's target's)."
  [e]
  (when e (or (:scope e) (:scope (:target e)))))

(defn- find-member [e ^String s] (when-let [sc (ent-scope e)] (sc/find-in sc s)))

(defn- tmpl-ent? [e] (boolean (and e (or (:tmpl e) (:inj e) (= :concept (:k e))))))
(defn- type-ent? [e] (= :type (:k e)))
(defn- concept-ent? [e] (= :concept (:k e)))

(defn- angle-close
  "The index of the > that closes the < at token `i` (the ones in parentheses, brackets and braces not counted), or nil
  when the list does not close before a ; or an unbalanced closer: whether `<` can open a template argument list."
  [^P p ^long i]
  (loop [j (inc i) d 1 pd 0]
    (let [^T t (tok-at p j)]
      (cond
        (identical? :eof (.-k t)) nil
        (pos? pd) (cond (or (t= t "(") (t= t "[") (t= t "{")) (recur (inc j) d (inc pd))
                        (or (t= t ")") (t= t "]") (t= t "}")) (recur (inc j) d (dec pd))
                        (t= t ";") nil
                        :else (recur (inc j) d pd))
        (or (t= t "(") (t= t "[") (t= t "{")) (recur (inc j) d 1)
        (or (t= t ")") (t= t "]") (t= t "}") (t= t ";")) nil
        ;; (cpp-s5: a < after a ) not of `operator()` or after a number opens no template argument list, [temp.names]/3
        ;; (only a name does): <type_traits>' `__bool_constant<_Tp(-1) < _Tp(0)>`, whose class was declined)
        (t= t "<") (let [^T pv (tok-at p (dec j))]
                     (if (or (identical? :num (.-k pv))
                             (and (t= pv ")") (not (and (t= (tok-at p (- j 2)) "(") (t= (tok-at p (- j 3)) "operator")))))
                       (recur (inc j) d pd)
                       (recur (inc j) (inc d) pd)))
        (t= t ">") (if (= d 1) j (recur (inc j) (dec d) pd))
        :else (recur (inc j) d pd)))))

(defn- assumed-template?
  "[temp.names]/3 (C++20, P0846): an unqualified name followed by < for which lookup finds nothing or only functions."
  [^P p e]
  (and (>= (.-year p) 2020) (or (nil? e) (and (= :fn (:k e)) (not (:tmpl e))))))

(defn- operator-part
  "An operator-function-id, a conversion-function-id or a literal-operator-id after `operator` (the cursor on it)."
  [^P p mode]
  (let [i (ix p)]
    (adv! p)
    (let [^T t (cur p)]
      (cond
        (and (t= t "(") (is-at? p 1 ")")) (do (adv! p) (adv! p) {:op "()" :i i})
        (and (t= t "[") (is-at? p 1 "]")) (do (adv! p) (adv! p) {:op "[]" :i i})
        (and (or (t= t "new") (t= t "delete")) (is-at? p 1 "[") (is-at? p 2 "]")) (do (adv! p) (adv! p) (adv! p) {:op (str (ts t) "[]") :i i})
        (or (t= t "new") (t= t "delete") (t= t "co_await")) (do (adv! p) {:op (ts t) :i i})
        (#{:str :udls} (tk t)) (let [s (ts t)]
                                 ;; (h-cpp-read: [over.literal]/1, the literal-operator-id's string-literal is empty: GCC's
                                 ;; "expected empty string after 'operator' keyword", the name taken)
                                 (when-not (re-find #"^(u8|u|U|L)?[\"][\"]" s)
                                   (soft-diag! p (ix p) "expected empty string after 'operator' keyword"))
                                 (adv! p)
                                 (if (= s "\"\"")
                                   (let [nm (ts (cur p))]
                                     (when-not (identical? :id (tk (cur p))) (soft-diag! p (ix p) "expected suffix identifier"))
                                     (adv! p) {:lit nm :i i :spaced true})
                                   {:lit (subs s 2) :i i}))
        (t= t ">") (cond (and (.-glue t) (is-at? p 1 ">") (.-glue (nxt p 1)) (is-at? p 2 "="))
                         (do (adv! p) (adv! p) (adv! p) {:op ">>=" :i i})
                         (and (.-glue t) (is-at? p 1 ">")) (do (adv! p) (adv! p) {:op ">>" :i i})
                         (and (.-glue t) (is-at? p 1 "=")) (do (adv! p) (adv! p) {:op ">=" :i i})
                         :else (do (adv! p) {:op ">" :i i}))
        (identical? :punct (tk t)) (do (adv! p) {:op (ts t) :i i})
        :else {:conv (parse-type-id p :conv) :i i}))))

(defn- note-cm-use!
  "cpp-gnu (2026-11-22): the unqualified name `nm` at token `i`, found by lookup from the cursor's scope: in each class being
  defined (*cm-scopes*) whose scope the lookup passed without finding `nm` there while the class's complete scope declares it
  (a member declared later), its first use noted ([basic.scope.class]/2 of C++20, [class.member.lookup]: a name used in a class
  shall refer to the same declaration when looked up again in the completed class)."
  [^P p ^String nm ^long i]
  (when (main-tok? p i)
    (let [^java.util.IdentityHashMap m *cm-scopes*]
      (loop [s (scope p)]
        (when (and s (nil? (sc/find-in s nm)))
          (when-let [[late ^HashMap uses] (.get m s)]
            (when (and (.get ^HashMap (sc/names-of late) nm) (not (.containsKey uses nm)))
              (.put uses nm (.-o ^T (tok-at p i)))))
          (recur (sc/parent-of s)))))))

(defn parse-name
  "A possibly qualified name at the cursor: the name map with the cursor after it, or nil (the cursor unmoved) when
  none starts there. `mode` :parse parses template arguments, :scan skips them; `member` (a name after . or ->): its
  first part is looked up as a member template's."
  ([^P p mode] (parse-name p mode false))
  ([^P p mode member]
   (let [b (ix p)
         g (and (is? p "::") (let [^T n (nxt p 1)] (or (identical? :id (.-k n)) (t= n "template") (t= n "operator") (t= n "~"))) (do (adv! p) true))]
     (loop [parts [] qe (if g (root-ent p) nil)]
       (let [tkw (when (and (is? p "template") (or (identical? :id (tk (nxt p 1))) (is-at? p 1 "operator"))) (adv! p) true)
             ^T t (cur p)
             first? (and (empty? parts) (not g))]
         (cond
           (identical? :id (.-k t))
           (let [s (.-s t) i (ix p)
                 e (cond member (when (or (is-at? p 1 "::")
                                          (and (is-at? p 1 "<") (let [c (angle-close p (inc (ix p)))] (and c (t= (tok-at p (inc (long c))) "::")))))
                                  (lookup (scope p) s))
                         first? (let [e (lookup (scope p) s)]
                                  (when (and e *cm-scopes*) (note-cm-use! p s i))
                                  e)
                         :else (find-member qe s))]
             (adv! p)
             ;; cpp-read (2026-11-22): a name after the template keyword followed by no template argument list where a type is
             ;; declared, a declarator or ; after it ([temp.names]/5: a template-id, or a class or alias template as a template
             ;; template argument): GCC's "expected template-id"
             (when (and tkw (= mode :parse) (not (is? p "<")) (not (is? p "::")) (or (id? p) (is? p ";")) (not (tmpl-ent? e)) (main-tok? p i))
               (soft-diag! p i "expected template-id"))
             (let [lt (when (is? p "<") (angle-close p (ix p)))
                   tmpl? (and lt (or tkw (tmpl-ent? e)
                                     (and first? (not member) (assumed-template? p e))
                                     ;; before C++20 too, as clang's extension (ext_adl_only_template_id): a call's template-id
                                     (and first? (not member) (or (nil? e) (and (= :fn (:k e)) (not (:tmpl e))))
                                          (t= (tok-at p (inc (long lt))) "("))
                                     (and member (contains? ^HashSet (stv p MTMPL) s) (t= (tok-at p (inc (long lt))) "("))))
                   [args ab ae] (when tmpl?
                                  (let [ab (ix p)]
                                    (if (= mode :parse)
                                      (let [as (parse-template-args p e)] [as ab (last-ix p)])
                                      (do (seek! p (inc (long lt))) [nil ab lt]))))
                   part (cond-> {:s s :i i} tmpl? (assoc :args (or args []) :ab ab :ae ae) tkw (assoc :tkw true))]
               (if (and (is? p "::") (not (is-at? p 1 "*")) (let [^T n (nxt p 1)] (or (identical? :id (.-k n)) (t= n "template") (t= n "~") (t= n "operator"))))
                 (do (adv! p) (recur (conj parts part) (if (or first? qe) e nil)))
                 {:g g :parts (conj parts part) :b b :e (last-ix p) :ent e :q qe})))
           (and (t= t "~") (identical? :id (tk (nxt p 1))))
           (let [i (ix p)]
             (adv! p)
             (let [s (ts (cur p))]
               (adv! p)
               (let [part {:dtor s :i i}
                     part (if (and (is? p "<") (angle-close p (ix p)) (= mode :parse)) (let [ab (ix p) as (parse-template-args p)] (assoc part :args as :ab ab :ae (last-ix p))) part)]
                 {:g g :parts (conj parts part) :b b :e (last-ix p) :ent nil :q qe})))
           (t= t "operator")
           ;; a qualified conversion-function-id's conversion-type-id is looked up in the qualifier's class first
           ;; ([basic.lookup.unqual]/5, [class.conv.fct]; G5c: libsupc++'s `exception_ptr::operator __safe_bool()`)
           (let [part (if (and qe (:scope qe) (:class qe)) (in-scope p (sc/new-scope :lookup (scope p) qe) (operator-part p mode)) (operator-part p mode))
                 part (if (and (:op part) (is? p "<") (angle-close p (ix p)) (or tkw (= mode :parse)))
                        (if (= mode :parse) (let [ab (ix p) as (parse-template-args p)] (assoc part :args as :ab ab :ae (last-ix p))) part)
                        part)]
             {:g g :parts (conj parts part) :b b :e (last-ix p) :ent (when first? nil) :q qe})
           (and (t= t "decltype") first? (is-at? p 1 "("))
           ;; decltype(e):: as the first part of a nested-name-specifier
           (let [i (ix p) close (loop [j (+ i 2) d 1] (let [^T x (tok-at p j)] (cond (identical? :eof (.-k x)) (perr p "decltype") (t= x "(") (recur (inc j) (inc d)) (t= x ")") (if (= d 1) j (recur (inc j) (dec d))) :else (recur (inc j) d))))]
             (if (t= (tok-at p (inc (long close))) "::")
               (do ;; (cpp-s5: the operand kept for the code generator's decltype, as a decl-specifier's is: `typename
                   ;; decltype(_S_to_arg_type<_Tp>())::type`, <format>'s _Normalize)
                   (when (and (= mode :parse) *full-headers* (not (skim? p)))
                     (seek! p (inc i))
                     (let [x (tentatively p (fn [p] (adv! p) (let [x (with-gt p true (parse-expr p))] (when (is? p ")") x))))]
                       (when (map? x) (.put ^HashMap (stv p DECLTYPES) (str/replace (tok-text p (+ i 2) (dec (long close))) #"\s+" "") x))))
                   (seek! p (+ 2 (long close))) (recur (conj parts {:s (str "decltype(" (tok-text p (+ i 2) (dec (long close))) ")") :i i :decltype true}) nil))
               (do (seek! p b) nil)))
           :else (do (seek! p b) (when (or g (seq parts)) (perr p "a name")) nil)))))))

(declare scan-name is-type-id?)

(defn- template-name-arg?
  "A template template argument at the cursor: a class or alias template's name (no arguments) followed by , > or ...."
  [^P p]
  (when (or (identical? :id (tk (cur p))) (is? p "::"))
    (when-let [[qn e] (scan-name p)]
      (let [en (:ent qn) ^T n (tok-at p e)]
        (and (type-ent? en) (:tmpl en) (nil? (:args (peek (:parts qn))))
             (or (t= n ",") (t= n ">") (t= n "...")))))))

(defn- gt-close-check!
  "cpp-tpl: a template argument list closed by the first `>` of a `>=` or `>>=` lexeme (or the second of a `>>=`): GCC's
  \"'>=' should be '> =' to terminate a template argument list\" ([temp.names]/4 splits no such token)."
  [^P p]
  (when (and (not (skim? p)) (main-tok? p (ix p)))
    (when-let [lx (gt-lexeme-at p 0)]
      (soft-diag! p (ix p) (str "'" lx "' should be '" (if (= lx ">=") "> =" "> >=") "' to terminate a template argument list")))))

(defn parse-template-args
  "A template-argument-list at its <: the arguments ({:k :type :t T}, {:k :expr :x node}, {:k :tmpl :name name}, each with
  :b :e and :pack), the cursor after the > (one half of a split >>)."
  ([^P p] (parse-template-args p nil))
  ([^P p tmpl]
  (adv! p)
  (with-gt p false
    (if (do (gt-close-check! p) (accept! p ">"))
      []
      (loop [out []]
        ;; cpp-read (2026-11-22): a `...` before an argument ([temp.variadic]/5's pack expansion follows its pattern): GCC's
        ;; "expected parameter pack before '...'" (cp_parser_template_argument_list), the `...` passed over
        (when (is? p "...")
          (soft-diag! p (ix p) "expected parameter pack before '...'")
          (when-not (or (is-at? p 1 ">") (is-at? p 1 ",")) (adv! p)))
        (let [b (ix p)
              ;; [temp.local]/1: the injected-class-name as the argument of a type parameter is the class's type
              tparam-kind (some-> (:tps tmpl) vec (get (count out)) :kind)
              inj-type? (fn [] (and tparam-kind (not= "TemplateTemplateParmDecl" tparam-kind)
                                    (when-let [[qn _] (scan-name p)]
                                      (let [en (:ent qn)] (and (= 1 (count (:parts qn))) (or (:inj en) (:inj-full en)))))))
              a (cond
                  (and (template-name-arg? p) (not (inj-type?))) {:k :tmpl :name (parse-name p :parse)}
                  (is-type-id? p :targ) {:k :type :t (binding [*tdef-ctx* "in template arguments"] (parse-type-id p :targ))}
                  :else {:k :expr :x (parse-cond-expr p)})
              a (assoc a :b b :e (last-ix p))
              ;; (round 54, second pass: [dcl.spec.auto.general]/5, a placeholder is no template argument's type-id: GCC's
              ;; "invalid use of 'auto' in template argument")
              _ (when (and (= :type (:k a)) (= b (long (:e a))) (t= (tok-at p b) "auto"))
                  (soft-diag! p b "invalid use of 'auto' in template argument"))
              ;; cpp-read (2026-11-22): [temp.arg]/1, an argument's kind is its parameter's: a type-id for a non-type parameter, or
              ;; a literal or a variable for a type parameter, of a class or alias template: GCC's "type/value mismatch at argument
              ;; N in template parameter list for 'X'", at the argument
              _ (when (and tmpl (type-ent? tmpl) (seq (:tps tmpl)) (not (skim? p)) (main-tok? p b))
                  (let [tps (vec (:tps tmpl)) i (count out)
                        pi (first (keep-indexed (fn [j t] (when (:isParameterPack t) j)) tps))
                        tp (if (and pi (>= i (long pi))) (tps pi) (get tps i))
                        x (:x a)
                        ;; (a name's kind not judged in the class being defined, its injected-class-name's arguments its own
                        ;; parameters, which a member's first reading may have taken for variables, nsdmi-defer5.C; a literal's
                        ;; still, parse/ptrmem3.C)
                        defining (or (:inj tmpl) (:inj-full tmpl) (some #(= (:name tmpl) (:name (:ent %))) (stv p CLS)))
                        bad (case (:kind tp)
                              "NonTypeTemplateParmDecl" (and (or (= :type (:k a)) (= :tmpl (:k a))) (not defining))
                              "TemplateTypeParmDecl" (and (= :expr (:k a))
                                                          (or (contains? #{"IntegerLiteral" "FloatingLiteral" "CharacterLiteral" "StringLiteral"
                                                                           "CXXBoolLiteralExpr" "CXXNullPtrLiteralExpr"} (:kind x))
                                                              (and (= "DeclRefExpr" (:kind x)) (not defining)
                                                                   (let [en (lookup (scope p) (str (get-in x [:referencedDecl :name])))]
                                                                     (and (= :var (:k en)) (not (:tparam en)))))))
                              false)]
                    (when bad
                      (soft-diag! p b (str "type/value mismatch at argument " (inc i) " in template parameter list for '" (:name tmpl) "'")))))
              a (if (accept! p "...") (assoc a :pack true) a)
              out (conj out a)]
          (cond (accept! p ",") (recur out)
                (do (gt-close-check! p) (accept! p ">")) out
                :else (perr p "a template argument list"))))))))

(defn- arg-str ^String [^P p a]
  (str (case (:k a)
         :type (qt (:t a))
         :expr (tok-text p (:b a) (:e a))
         :tmpl (tok-text p (:b a) (:e a)))
       (when (:pack a) "...")))

(defn- part-str ^String [^P p part]
  (str (when (:tkw part) "template ")
       (cond (:s part) (:s part)
             (:dtor part) (str "~" (:dtor part))
             (:op part) (str "operator" (:op part))
             (:lit part) (str "operator\"\"" (:lit part))
             (:conv part) (str "operator " (qt (:conv part))))
       (when-let [as (:args part)] (str "<" (str/join ", " (map #(arg-str p %) as)) ">"))))

(defn name-str
  "A name as clang prints it in a type: its written qualifiers and template arguments (an integer literal in clang's
  spelling); the injected class name of a class template with the template's parameters."
  ^String [^P p qn]
  (let [parts (:parts qn)
        e (:ent qn)]
    (cond
      (and (= 1 (count parts)) (not (:g qn)) (:inj-full e) (nil? (:args (first parts)))) (:inj-full e)
      (and (= 1 (count parts)) (not (:g qn)) (:inj e) (nil? (:args (first parts))))
      (str (:s (first parts)) "<" (str/join ", " (:inj e)) ">")
      :else
      (str (when (:g qn) "::") (str/join "::" (map #(part-str p %) parts))))))

(defn- written-name
  "A name expression's written parts as clang's DeclRefExpr and MemberExpr keep them (CODEGEN.md P13 (b)): the explicit
  template arguments of its last part (`:explicitTemplateArgs`, each argument's text; DeclRefExpr::template_arguments)
  and the nested-name-specifier's parts (`:qualifier`, each part's text with its arguments; `:globalQualifier` for a
  leading ::)."
  [^P p qn]
  (let [parts (:parts qn) lp (peek parts) q (butlast parts)]
    (cond-> {:_wn true}
      (:args lp) (assoc :explicitTemplateArgs (mapv #(arg-str p %) (:args lp)))
      (seq q) (assoc :qualifier (mapv #(part-str p %) q))
      (:g qn) (assoc :globalQualifier true))))

(defn- name-plain
  "A name's last part's identifier, nil for an operator, a destructor or a qualified name."
  [qn]
  (let [parts (:parts qn)]
    (when (and (= 1 (count parts)) (not (:g qn))) (:s (first parts)))))

;; ---------------------------------------------------------------------------------------------
;; Tentative parsing (clang's ParseTentative.cpp): the cursor moves, the caller puts it back. A result is :true (a
;; declaration, a type-id), :false (an expression), :ambig (either, so far) or :error.

(def ^:private storage-kws
  #{"static" "extern" "inline" "virtual" "explicit" "typedef" "friend" "mutable" "register" "thread_local" "constexpr"
    "consteval" "constinit" "__constinit" "_Thread_local" "__thread" "__inline" "__inline__" "_Noreturn" "__extension__" "export"})
(def ^:private cv-kws #{"const" "volatile" "__restrict" "__restrict__" "__const" "__volatile" "__volatile__"})
(def ^:private builtin-kws
  #{"char" "char8_t" "char16_t" "char32_t" "wchar_t" "bool" "short" "int" "long" "signed" "unsigned" "float" "double" "void"
    "__int128" "_Bool" "_Complex" "__complex__" "__complex" "__float128" "__bf16" "_Float16" "__fp16" "__signed" "__signed__"})
(def ^:private type-transforms
  #{"__underlying_type" "__remove_cv" "__remove_const" "__remove_volatile" "__remove_cvref" "__remove_reference_t"
    "__remove_pointer" "__remove_extent" "__remove_all_extents" "__remove_restrict" "__add_pointer" "__add_lvalue_reference"
    "__add_rvalue_reference" "__decay" "__make_signed" "__make_unsigned"})
(def ^:private attr-kws #{"__attribute__" "__attribute" "alignas" "_Alignas" "__declspec"})

(defn- type-transform? [^P p] (and (id? p) (contains? type-transforms (ts (cur p))) (is-at? p 1 "(")))

(defn- def-brace
  "Queue 377: the index of the opening brace of a class or enumeration definition whose head starts at token `i` (a class-key or
  enum; the head's names, class-keys, `::`, `final` and a base clause's names and commas skipped), or nil when another token
  ends the head first (an elaborated-type-specifier)."
  [^P p ^long i]
  (when (contains? #{"struct" "class" "union" "enum"} (ts (tok-at p i)))
    (loop [k (inc i)]
      (let [^T t (tok-at p k)]
        (cond (> k (+ i 32)) nil
              (identical? :eof (.-k t)) nil
              (t= t "{") k
              (or (identical? :id (.-k t)) (t= t "::") (t= t ",") (t= t ":")
                  (contains? #{"struct" "class" "union" "enum" "public" "protected" "private" "virtual" "final"} (.-s t))) (recur (inc k))
              :else nil)))))

(defn- skip-balanced!
  "The cursor on an opener ( [ { or <: after its closer. False when the stream ends first."
  [^P p]
  (let [^T o (cur p)
        open (ts o)
        close ({"(" ")" "[" "]" "{" "}"} open)]
    (if (= open "<")
      (if-let [e (angle-close p (ix p))] (do (seek! p (inc (long e))) true) false)
      (loop [d 0]
        (let [^T t (cur p)]
          (cond
            (identical? :eof (.-k t)) false
            (t= t open) (do (adv! p) (recur (inc d)))
            (t= t close) (do (adv! p) (if (= d 1) true (recur (dec d))))
            (or (t= t "(") (t= t "[") (t= t "{")) (do (when-not (skip-balanced! p) (seek! p (dec (.-cnt p)))) (recur d))
            :else (do (adv! p) (recur d))))))))

(defn- skip-until!
  "SkipUntil(stops, StopAtSemi | StopBeforeMatch): the cursor on the first token of `stops` (a set of texts) at this
  nesting, nested parentheses, brackets and braces skipped; false at a ; or a closer of an outer nesting, or the end."
  [^P p stops]
  (loop []
    (let [^T t (cur p)]
      (cond
        (identical? :eof (.-k t)) false
        (and (sym? t) (contains? stops (.-s t))) true
        (or (t= t ";") (t= t ")") (t= t "]") (t= t "}")) false
        (or (t= t "(") (t= t "[") (t= t "{")) (if (skip-balanced! p) (recur) false)
        :else (do (adv! p) (recur))))))

(defn- skip-attrs!
  "Attributes at the cursor skipped: [[...]], __attribute__((...)), alignas(...), __declspec(...). True when any."
  [^P p]
  (loop [any false]
    (cond
      (and (is? p "[") (is-at? p 1 "[")) (do (skip-balanced! p) (recur true))
      (and (contains? attr-kws (ts (cur p))) (sym? (cur p)) (is-at? p 1 "(")) (do (adv! p) (skip-balanced! p) (recur true))
      :else any)))

(defn- name-start? [^P p] (or (id? p) (and (is? p "::") (let [^T n (nxt p 1)] (or (identical? :id (.-k n)) (t= n "template"))))))

(defn- scan-name
  "The name at the cursor scanned (template arguments skipped), the cursor put back: [name end] or nil."
  [^P p]
  (let [b (ix p)
        qn (try (parse-name p :scan) (catch arbace.lang.ExceptionInfo _ nil))
        e (ix p)]
    (seek! p b)
    (when qn [qn e])))

(defn- after-name-kind
  "What the token after a name at `e` is: :id, :paren, :brace, :other."
  [^P p ^long e]
  (let [^T t (tok-at p e)]
    (cond (identical? :id (.-k t)) :id (t= t "(") :paren (t= t "{") :brace :else :other)))

(defn- tp-decl-spec
  "isCXXDeclarationSpecifier at the cursor (nothing consumed); `braced`: the result of a type name followed by `{`."
  ([^P p] (tp-decl-spec p :false))
  ([^P p braced]
   (let [^T t (cur p) s (.-s t)]
     (cond
       (identical? :kw (.-k t))
       (cond
         (or (contains? storage-kws s) (contains? cv-kws s)) :true
         (#{"class" "struct" "union" "enum" "typename" "__typeof__" "__typeof" "typeof" "_Atomic" "__auto_type" "concept"} s) :true
         (= s "auto") (if (is-at? p 1 "(") :ambig :true)
         (contains? builtin-kws s) (cond (is-at? p 1 "(") :ambig (is-at? p 1 "{") braced :else :true)
         (contains? attr-kws s) :true
         ;; (GNU's __decltype too, libstdc++'s spelling in the heap and algorithm bodies: `__decltype(...) __cmp(...);`
         ;; was read as an expression statement and declined; cpp-route)
         (#{"decltype" "__decltype"} s) (let [b (ix p)]
                            (adv! p)
                            (let [ok (and (is? p "(") (skip-balanced! p))
                                  r (cond (not ok) :error
                                          (is? p "::") (do (seek! p b) (let [[qn e] (scan-name p)]
                                                                         (cond (and qn (type-ent? (:ent qn))) (if (= :paren (after-name-kind p e)) :ambig :true)
                                                                               ;; (cpp-s15, CP392 (a): `decltype(e)::type x = ...;`, a member the
                                                                               ;; parser cannot resolve through the decltype followed by a name:
                                                                               ;; a declaration, as an unknown type name's is; an expression
                                                                               ;; `a::b c` is never one)
                                                                               (and qn (nil? (:ent qn)) (= :id (after-name-kind p e))
                                                                                    (not (#{"final" "override"} (ts (tok-at p e)))))
                                                                               :true
                                                                               :else :false)))
                                          (is? p "(") :ambig
                                          (is? p "{") braced
                                          :else :true)]
                              (seek! p b)
                              r))
         :else :false)
       (and (identical? :punct (.-k t)) (= s "[") (is-at? p 1 "[")) :true
       (type-transform? p) :true
       (name-start? p)
       (if-let [[qn e] (scan-name p)]
         (let [en (:ent qn)
               lp (peek (:parts qn))
               ak (after-name-kind p e)]
           (cond
             (type-ent? en)
             (if (and (:tmpl en) (not (:inj en)) (nil? (:args lp)))
               (case ak :id :true :paren :ambig :brace braced :false) ; a class template's name: deduced arguments
               (case ak :paren :ambig :brace braced :true))
             ;; (n-cpp-concepts: and before a name: a concept's name meant as a type, parse-decl-specs' "expected 'auto'" /
             ;; "does not constrain a type"; no expression has a concept-id followed by a name)
             (concept-ent? en) (if (or (t= (tok-at p e) "auto") (t= (tok-at p e) "decltype") (= ak :id)) :true :false)
             (and (nil? en) (nil? (:q qn)) (= 1 (count (:parts qn))) (not (:g qn)) (= ak :id)
                  (not (#{"final" "override"} (ts (tok-at p e)))))
             :true ; an unknown name followed by a name: a declaration with a type the table misses (clang: unknown type name)
             ;; (queue 411: and a qualified name the table cannot resolve followed by a name, as decltype's above (an expression
             ;; `a::b c` is never one): streambuf.cc's `traits_type::int_type __c = ...`, traits_type a local typedef of
             ;; basic_streambuf<char>::traits_type, a member of a header's class template the skim does not follow)
             (and (nil? en) (> (count (:parts qn)) 1) (= ak :id) (not (#{"final" "override"} (ts (tok-at p e)))))
             :true
             :else :false))
         :false)
       :else :false))))

(defn- decl-spec-start?
  "isDeclarationSpecifier: the cursor starts a decl-specifier (a keyword of one, a type name, a concept)."
  [^P p]
  (not= :false (tp-decl-spec p :true)))

(defn- tp-consume-decl-spec!
  "TryConsumeDeclarationSpecifier: one decl-specifier consumed."
  [^P p]
  (let [^T t (cur p) s (.-s t)]
    (cond
      (and (identical? :kw (.-k t)) (#{"decltype" "__typeof__" "__typeof" "typeof" "_Atomic" "__decltype"} s) (is-at? p 1 "("))
      (let [b (ix p)]
        (adv! p) (if (skip-balanced! p) (if (is? p "::") (do (seek! p b) (if (parse-name p :scan) :ambig :error)) :ambig) :error))
      (and (identical? :kw (.-k t)) (#{"class" "struct" "union" "enum"} s))
      (do (adv! p) (when (and (= s "enum") (or (is? p "class") (is? p "struct"))) (adv! p)) (skip-attrs! p)
          (if (name-start? p) (if (parse-name p :scan) :ambig :error) :ambig))
      (and (identical? :kw (.-k t)) (= s "typename")) (do (adv! p) (if (parse-name p :scan) :ambig :error))
      (and (contains? attr-kws s) (sym? t)) (do (skip-attrs! p) :ambig)
      (and (t= t "[") (is-at? p 1 "[")) (do (skip-attrs! p) :ambig)
      (type-transform? p) (do (adv! p) (if (skip-balanced! p) :ambig :error))
      (identical? :kw (.-k t)) (do (adv! p) :ambig)
      (name-start? p) (if (parse-name p :scan) (do (when (and (is? p "auto")) (adv! p)) :ambig) :error)
      :else :error)))

(defn- skip-cv! [^P p] (loop [] (when (or (contains? cv-kws (ts (cur p))) (is? p "restrict")) (when (sym? (cur p)) (adv! p) (recur)))) (skip-attrs! p))

(defn- tp-ptr-ops!
  "TryParsePtrOperatorSeq: * & && and C::* with their qualifiers consumed. :error on a bad one."
  [^P p]
  (loop []
    (cond
      (or (is? p "*") (is? p "&") (is? p "&&") (is? p "^")) (do (adv! p) (skip-cv! p) (recur))
      (name-start? p) (let [b (ix p) qn (try (parse-name p :scan) (catch arbace.lang.ExceptionInfo _ nil))]
                        (if (and qn (is? p "::") (is-at? p 1 "*"))
                          (do (adv! p) (adv! p) (skip-cv! p) (recur))
                          (do (seek! p b) :ok)))
      :else :ok)))

(declare spec-of-qualifier tp-declarator! tp-param-clause! is-type-id? is-function-declarator?)

(defn- tp-fn-declarator!
  "TryParseFunctionDeclarator, the ( consumed."
  [^P p may-have-trailing]
  (let [r (tp-param-clause! p false)
        r (if (and (= r :ambig) (not (is? p ")"))) :false r)]
    (if (#{:false :error} r)
      r
      (if-not (skip-until! p #{")"})
        :error
        (do
          (adv! p)
          (loop [] (when (or (is? p "const") (is? p "volatile") (is? p "__restrict")) (adv! p) (recur)))
          (when (or (is? p "&") (is? p "&&")) (adv! p))
          (let [bad (or (when (is? p "throw") (adv! p) (not (and (is? p "(") (skip-balanced! p))))
                        (when (is? p "noexcept") (adv! p) (when (is? p "(") (not (skip-balanced! p)))))]
            (cond
              bad :error
              (and (skip-attrs! p) false) :ambig
              (and (is? p "->") may-have-trailing)
              (if (= r :true) r (do (adv! p) (if (is-type-id? p :trailing) :true :ambig)))
              :else :ambig)))))))

(defn- tp-bracket!
  [^P p]
  (if (skip-balanced! p) :ambig :error))

(defn- tp-declarator!
  "TryParseDeclarator."
  [^P p may-be-abstract may-have-ident may-have-direct-init may-have-trailing]
  (if (= :error (tp-ptr-ops! p))
    :error
    (do
      (accept! p "...")
      (let [r0 (cond
                 (and may-have-ident (or (id? p) (is? p "operator") (and (is? p "::") (name-start? p))
                                         (and (is? p "~") (identical? :id (tk (nxt p 1))))))
                 (let [qn (try (parse-name p :scan) (catch arbace.lang.ExceptionInfo _ nil))]
                   (cond (nil? qn) :error
                         ;; (cpp-decl2: a class template's template-id is a type, no declarator-id here -- clang's annotated
                         ;; type token, not an identifier: `A<int, int>(A<int, int>());` an expression, template/crash126.C)
                         (and (:args (peek (:parts qn))) (type-ent? (:ent qn)) (not (:g qn)) (= 1 (count (:parts qn)))) :false
                         :else :go))
                 (is? p "(")
                 (do (adv! p)
                     (if (and may-be-abstract (or (is? p ")") (and (is? p "...") (is-at? p 1 ")")) (decl-spec-start? p)))
                       (let [r (tp-fn-declarator! p may-have-trailing)] (if (= r :ambig) :go r))
                       (if (or (contains? attr-kws (ts (cur p))))
                         :true
                         (let [r (tp-declarator! p may-be-abstract may-have-ident false may-have-trailing)]
                           (cond (not= r :ambig) r
                                 (not (is? p ")")) :false
                                 :else (do (adv! p) :go))))))
                 (not may-be-abstract) :false
                 :else :go)]
        (cond
          (not= r0 :go) r0
          may-have-direct-init :ambig
          :else
          (loop []
            (cond
              (is? p "(")
              (if (and (not may-be-abstract) (not (is-function-declarator? p)))
                :ambig
                (do (adv! p) (let [r (tp-fn-declarator! p may-have-trailing)] (if (= r :ambig) (recur) r))))
              (is? p "[") (let [r (tp-bracket! p)] (if (= r :ambig) (recur) r))
              (is? p "requires") :true
              :else :ambig)))))))

(defn- tp-param-clause!
  "TryParseParameterDeclarationClause, the ( consumed."
  [^P p versus-targ]
  (if (is? p ")")
    :ambig
    (loop []
      (cond
        (is? p "...") (do (adv! p) (if (is? p ")") :true :false))
        (and (is? p "[") (is-at? p 1 "[")) :true
        :else
        (let [r (tp-decl-spec p :false)]
          (if (and (not= r :ambig) (not (and versus-targ (= r :true))))
            r
            (let [auto? (is? p "auto")
                  r2 (loop [seen-type false]
                       (let [st (or seen-type (not (or (contains? storage-kws (ts (cur p))) (contains? cv-kws (ts (cur p))))))]
                         (if (= :error (tp-consume-decl-spec! p))
                           :error
                           (if (and st (id? p) (not (#{"final" "override"} (ts (cur p)))))
                             :true
                             (let [r (tp-decl-spec p :false)]
                               (cond (= r :error) :error
                                     (and (= r :true) (not versus-targ)) :true
                                     (= r :false) :go
                                     :else (recur st)))))))]
              (if (not= r2 :go)
                r2
                (let [r (tp-declarator! p true true false auto?)]
                  (cond
                    (not= r :ambig) r
                    (or (is? p "__attribute__") (is? p "__attribute")) :true
                    versus-targ (if (is? p "=") :true :false)
                    :else
                    (let [ok (if (is? p "=") (do (adv! p) (skip-until! p #{"," ")"})) true)]
                      (cond
                        (not ok) :error
                        (is? p "...") (do (adv! p) (if (is? p ")") :true :false))
                        (accept! p ",") (recur)
                        :else :ambig))))))))))))

(defn- tp-init-declarator-list!
  [^P p may-have-trailing]
  (loop []
    (let [r (tp-declarator! p false true false may-have-trailing)]
      (cond
        (not= r :ambig) r
        (or (is? p "asm") (is? p "__asm__") (is? p "__asm") (is? p "__attribute__")) :true
        (is? p "(") (do (adv! p) (if (and (skip-until! p #{")"}) (accept! p ")")) (if (accept! p ",") (recur) :ambig) :error))
        (is? p "{") :true
        (is? p "=") :true
        (accept! p ",") (recur)
        :else :ambig))))

(defn- tp-simple-declaration!
  [^P p allow-for-range]
  (let [auto? (is? p "auto")]
    (if (= :error (tp-consume-decl-spec! p))
      :error
      (let [r (if (is? p "(") :false (tp-decl-spec p :false))]
        (cond
          (= r :ambig) :true
          (#{:true :error} r) r
          :else
          (let [r (tp-init-declarator-list! p auto?)]
            (cond
              (not= r :ambig) r
              (and (not (is? p ";")) (not (and allow-for-range (is? p ":")))) :false
              :else :ambig)))))))

(defn- angle-paren-close
  "The index of the ) closing the ( at token `i`, or nil."
  [^P p ^long i]
  (loop [j (inc i) d 1]
    (let [^T t (tok-at p j)]
      (cond (identical? :eof (.-k t)) nil
            (t= t "(") (recur (inc j) (inc d))
            (t= t ")") (if (= d 1) j (recur (inc j) (dec d)))
            :else (recur (inc j) d)))))

(defn- tentatively
  "Runs (f p) with the cursor put back after."
  [^P p f]
  (let [b (ix p)] (try (f p) (catch arbace.lang.ExceptionInfo _ :error) (finally (seek! p b)))))

(defn- is-simple-declaration?
  "isCXXSimpleDeclaration: a declaration statement (or a for-range declaration, `allow-for-range`)."
  [^P p allow-for-range]
  (let [r (tp-decl-spec p :false)]
    (if (not= r :ambig)
      (not= r :false)
      (let [r (tentatively p #(tp-simple-declaration! % allow-for-range))]
        (not= r :false)))))

(defn- is-function-declarator?
  "isCXXFunctionDeclarator: the ( at the cursor opens a parameter list (not a direct initializer)."
  [^P p]
  (let [r (tentatively p (fn [p]
                           (adv! p)
                           (let [r (tp-param-clause! p false)]
                             (if (= r :ambig)
                               (if (not (is? p ")"))
                                 :false
                                 (let [^T n (nxt p 1)]
                                   (if (or (t= n "&") (t= n "&&") (t= n "const") (t= n "volatile") (t= n "throw") (t= n "noexcept")
                                           (t= n "[") (t= n "{") (t= n "try") (t= n "=") (t= n "->")
                                           (and (identical? :id (.-k n)) (#{"override" "final"} (.-s n))))
                                     :true :ambig)))
                               r))))]
    (not= r :false)))

(defn- type-id-kind
  "isCXXTypeId in context `ctx` (:paren, :targ, :trailing): :false, :true, or :ambig (a type-id only because the
  context said so: `(T())` ends at its ), [dcl.ambig.res]/2)."
  [^P p ctx]
  (let [r (tp-decl-spec p :false)]
    (if (not= r :ambig)
      (if (= r :false) :false :true)
      (tentatively p (fn [p]
                       (let [auto? (is? p "auto")]
                         (tp-consume-decl-spec! p)
                         (let [r (tp-declarator! p true false false auto?)
                               r (if (= r :error) :true r)]
                           (if (= r :ambig)
                             (case ctx
                               :paren (if (is? p ")") :ambig :false)
                               :targ (if (or (and (is? p ">") (not (gt-lexeme-at p 0))) (is? p ",") (and (is? p "...") (or (is-at? p 1 ">") (is-at? p 1 ",")))) :ambig :false)
                               :trailing :ambig
                               :false)
                             r))))))))

(defn- is-type-id?
  "isCXXTypeId: the cursor starts a type-id."
  [^P p ctx]
  (not= :false (type-id-kind p ctx)))

(defn- condition-kind
  "isCXXConditionDeclarationOrInitStatement: :init-decl, :cond-decl, :for-range or :expr for the condition of an if,
  switch, while or for at the cursor."
  [^P p can-init can-range]
  (if (and can-init (is? p "using"))
    :init-decl
    (let [r (tp-decl-spec p :false)]
      (case r
        :true (tentatively p (fn [p]
                               ;; a declaration: which kind is decided by what follows its first declarator
                               (let [b0 (ix p)]
                                 (tp-consume-decl-spec! p)
                                 (loop [] (when (not= :false (tp-decl-spec p :false)) (when (not= :error (tp-consume-decl-spec! p)) (recur))))
                                 ;; (queue 376: a class or enumeration defined in the decl-specifiers, `for (struct S { } *x : r)`: its
                                 ;; body skipped, so the declarator after it decides, as GCC's parser does before its "types may not be
                                 ;; defined in a for-range-declaration")
                                 (when (and can-range (is? p "{") (#{"struct" "class" "union" "enum"} (ts (tok-at p b0))))
                                   (skip-balanced! p)
                                   (loop [] (when (not= :false (tp-decl-spec p :false)) (when (not= :error (tp-consume-decl-spec! p)) (recur))))))
                               ;; a structured binding: [ ... ] after the specifiers (and & or &&)
                               (when (or (is? p "&") (is? p "&&")) (when (is-at? p 1 "[") (adv! p)))
                               (if (and (is? p "[") (not (is-at? p 1 "[")))
                                 (skip-balanced! p)
                                 (tp-declarator! p false true false (is? p "auto")))
                               (cond (or (is? p "=") (is? p "{")) (if (and can-init (let [b (ix p)] (skip-until! p #{";" ")"}) (let [r (is? p ";")] (seek! p b) r))) :init-decl :cond-decl)
                                     (and can-range (is? p ":")) :for-range
                                     :else :init-decl)))
        (:false :error) :expr
        :ambig (tentatively p (fn [p]
                                (let [auto? (is? p "auto")]
                                  (tp-consume-decl-spec! p)
                                  (let [r (tp-declarator! p false true false auto?)]
                                    (cond
                                      (= r :false) :expr
                                      (= r :error) :expr
                                      (or (is? p "=") (is? p "{") (is? p "__attribute__") (is? p "asm"))
                                      (if (and can-init (let [b (ix p)] (skip-until! p #{";" ")"}) (let [x (is? p ";")] (seek! p b) x))) :init-decl :cond-decl)
                                      (and can-range (is? p ":")) :for-range
                                      (and can-init (is? p ";")) :init-decl
                                      (and can-init (is? p ",")) :init-decl
                                      :else :expr)))))))))

;; ---------------------------------------------------------------------------------------------
;; Expressions (clang's ParseExpr.cpp, ParseExprCXX.cpp), each node with its tokens :_b and :_e

(declare parse-expr parse-cast-expr parse-postfix parse-primary parse-braced-init parse-compound-stmt parse-lambda
         parse-type-specs parse-abstract-declarator parse-decl-specs parse-statement build-type parse-param-list
         declare-params! parse-requires-expr skip-requires-clause! requires-clause! parse-init-clause)

(defn- node
  "A node over the tokens b..e."
  [^P p ^String kind ^long b ^long e m]
  (assoc (nd p kind b e m) :_b b :_e e))

(defn- nb ^long [n] (long (:_b n)))
(defn- ne ^long [n] (long (:_e n)))

(def ^:private bin-prec
  {"=" 2 "*=" 2 "/=" 2 "%=" 2 "+=" 2 "-=" 2 "<<=" 2 ">>=" 2 "&=" 2 "^=" 2 "|=" 2
   "?" 3 "||" 4 "&&" 5 "|" 6 "^" 7 "&" 8 "==" 9 "!=" 9 "<" 10 ">" 10 "<=" 10 ">=" 10 "<=>" 11 "<<" 12 ">>" 12
   "+" 13 "-" 13 "*" 14 "/" 14 "%" 14 ".*" 15 "->*" 15})

(defn- binop-at
  "The binary operator at the cursor: [op tokens] or nil (a `>` in a template argument list is none)."
  [^P p]
  (let [^T t (cur p)]
    (when (identical? :punct (.-k t))
      (let [s (.-s t)]
        (if (= s ">")
          (if (false? (stv p GTOP))
            ;; (cpp-tpl: a `>=` lexeme is relational in a template argument too)
            (when (= ">=" (gt-lexeme-at p 0)) [">=" 2])
            (cond (and (.-glue t) (is-at? p 1 ">") (.-glue (nxt p 1)) (is-at? p 2 "=")) [">>=" 3]
                  (and (.-glue t) (is-at? p 1 ">")) [">>" 2]
                  (and (.-glue t) (is-at? p 1 "=")) [">=" 2]
                  :else [">" 1]))
          (when (contains? bin-prec s) [s 1]))))))

(defn- assign-op? [^String op] (= 2 (long (bin-prec op))))

(defn- fold-op-token?
  "A fold-operator's token ([expr.prim.fold]/1: the binary operators, the assignments and the comma)."
  [^T t]
  (and (identical? :punct (tk t)) (or (contains? bin-prec (ts t)) (= "," (ts t))) (not= "?" (ts t))))

(declare use-binary!)

(defn- bin-node [^P p ^String op l r]
  (use-binary! p op l r)
  (cond
    (= op "=") (node p "BinaryOperator" (nb l) (ne r) {:opcode op :inner [l r]})
    (assign-op? op) (node p "CompoundAssignOperator" (nb l) (ne r) {:opcode op :inner [l r]})
    :else (node p "BinaryOperator" (nb l) (ne r) {:opcode op :inner [l r]})))

(defn- parse-rhs
  "ParseRHSOfBinaryExpression: the operators of precedence at least `min` after `lhs`."
  [^P p lhs ^long min]
  (loop [lhs lhs]
    (let [[op n] (binop-at p)]
      (if (or (nil? op) (< (long (bin-prec op)) min))
        lhs
        (let [pr (long (bin-prec op))]
          (cond
            (= op "?")
            (do (adv! p)
                (if (is? p ":")
                  ;; GNU's a ?: b
                  (do (adv! p) (let [r (parse-assign-expr p)] (recur (node p "BinaryConditionalOperator" (nb lhs) (ne r) {:inner [lhs r]}))))
                  (let [mid (with-gt p true (parse-expr p))
                        _ (expect! p ":")
                        r (parse-assign-expr p)]
                    (recur (node p "ConditionalOperator" (nb lhs) (ne r) {:inner [lhs mid r]})))))
            (= pr 2)
            (do (dotimes [_ n] (adv! p))
                (let [r (if (is? p "{") (parse-braced-init p) (parse-assign-expr p))]
                  (recur (bin-node p op lhs r))))
            :else
            (do (dotimes [_ n] (adv! p))
                (let [r (loop [r (parse-cast-expr p)]
                          (let [[op2] (binop-at p)]
                            (if (and op2 (> (long (bin-prec op2)) pr) (not= op2 "?") (not (assign-op? op2)))
                              (recur (parse-rhs p r (inc pr)))
                              r)))]
                  (recur (bin-node p op lhs r))))))))))

(defn parse-assign-expr
  "An assignment-expression (throw and co_yield among them)."
  [^P p]
  (cond
    (is? p "throw")
    (let [b (ix p)]
      (adv! p)
      (if (or (is? p ";") (is? p ")") (is? p ",") (is? p "]") (is? p "}") (is? p ":"))
        (node p "CXXThrowExpr" b b {:inner []})
        (let [x (parse-assign-expr p)] (node p "CXXThrowExpr" b (ne x) {:inner [x]}))))
    (is? p "co_yield")
    (let [b (ix p)]
      (adv! p)
      (let [x (if (is? p "{") (parse-braced-init p) (parse-assign-expr p))]
        ;; clang's operand is the promise's yield_value call, whose argument is the written expression
        (node p "CoyieldExpr" b (ne x) {:inner [{:kind "CXXMemberCallExpr" :inner [{:kind "MemberExpr" :name "yield_value"} x]}]})))
    :else (parse-rhs p (parse-cast-expr p) 2)))

(defn parse-expr
  "An expression (the comma operator's too)."
  [^P p]
  (loop [l (parse-assign-expr p)]
    (if (and (is? p ",") (not (false? (stv p GTOP))))
      (do (adv! p) (let [r (parse-assign-expr p)] (recur (node p "BinaryOperator" (nb l) (ne r) {:opcode "," :inner [l r]}))))
      l)))

(defn parse-cond-expr
  "A conditional-expression (a constant-expression: no assignment, no comma)."
  [^P p]
  (parse-rhs p (parse-cast-expr p) 3))

(defn- fold-operand
  "A fold expression's operand: a cast-expression, with the operators that bind tighter than the fold's `op` (clang
  parses them and diagnoses; the code generator analyzes the expression they make)."
  [^P p ^String op]
  (if (= op ",")
    (parse-assign-expr p)
    (parse-rhs p (parse-cast-expr p) (inc (long (bin-prec op))))))

(defn- parse-fold
  "CP291 (a): a fold expression at its ( ([expr.prim.fold]): (E op ...), (... op E), (E1 op ... op E2), the cursor after
  its ). {:op :l :r} with :l or :r nil for a unary fold's missing side; the template expands it ([temp.variadic]/11).
  The fold-operator is the token beside the `...` (a glued `>>`, `>=` or `>>=` is not taken: the text node as before)."
  [^P p]
  (expect! p "(")
  (with-gt p true
    (let [b (ix p)
          j (loop [j b d 0]
              (let [^T x (tok-at p j)]
                (cond (or (t= x "(") (t= x "[") (t= x "{")) (recur (inc j) (inc d))
                      (or (t= x ")") (t= x "]") (t= x "}")) (if (zero? d) (perr p "a fold's ...") (recur (inc j) (dec d)))
                      (and (zero? d) (t= x "...")) j
                      :else (recur (inc j) d))))
          ;; the operator starting at token i: [op tokens] (binop-at's, a `>>` or `>=` of glued `>` tokens among them)
          op-at (fn [^long i] (let [s0 (ix p)]
                                (seek! p i)
                                (let [r (if (is? p ",") ["," 1] (let [[o n] (binop-at p)] (when (and o (not= o "?")) [o n])))]
                                  (seek! p s0) r)))
          f (if (= j b)
              (let [[op n] (or (op-at (inc j)) (perr p "a fold-operator"))]
                (adv! p) (dotimes [_ n] (adv! p))
                {:op op :l nil :r (fold-operand p op)})
              (let [[op n] (or (some (fn [k] (when-let [[o n] (op-at (- j k))] (when (= n k) [o n]))) [3 2 1]) (perr p "a fold-operator"))
                    l (fold-operand p op)]
                (when-not (= (ix p) (- j (long n))) (perr p "a fold's left operand"))
                (dotimes [_ n] (adv! p)) (expect! p "...")
                (if (is? p ")")
                  {:op op :l l :r nil}
                  (let [[op2 n2] (or (op-at (ix p)) (perr p "a fold-operator"))]
                    (when-not (= op op2) (perr p "the same fold-operator"))
                    (dotimes [_ n2] (adv! p))
                    {:op op :l l :r (fold-operand p op)}))))]
      (expect! p ")")
      f)))

(defn- paren-args
  "A parenthesized expression list at the cursor ( ... ): its nodes (pack expansions and braced lists among them)."
  [^P p]
  (expect! p "(")
  (with-gt p true
    (if (accept! p ")")
      []
      (loop [out []]
        (let [x (parse-init-clause p)
              x (if (is? p "...") (let [e (ix p)] (adv! p) (node p "PackExpansionExpr" (nb x) e {:inner [x]})) x)
              out (conj out x)]
          (cond (accept! p ",") (recur out)
                (accept! p ")") out
                :else (perr p "an argument list")))))))

(defn parse-init-clause
  "An initializer-clause: an assignment-expression or a braced-init-list."
  [^P p]
  (if (is? p "{") (parse-braced-init p) (parse-assign-expr p)))

(defn parse-braced-init
  "A braced-init-list { ... } as clang's InitListExpr (designators dropped: clang's semantic form)."
  [^P p]
  (let [b (ix p)]
    (expect! p "{")
    (with-gt p true
      (loop [out [] desigs []]
        (cond
          (is? p "}") (do (adv! p) (node p "InitListExpr" b (last-ix p) (cond-> {:inner out} (some some? desigs) (assoc :_desigs desigs))))
          :else
          (let [dz (loop [dz []] ; designators: .a = , [0] = , .a.b[1] = : [[:f "a"] [:i 0] ...] (:i nil an index not a literal)
                     (cond (and (is? p ".") (identical? :id (tk (nxt p 1))))
                           (let [nm (ts (nxt p 1)) di (ix p)] (adv! p) (adv! p) (let [dz (conj dz [:f nm di])] (if (or (is? p ".") (is? p "[")) (recur dz) dz)))
                           (and (is? p "[") (not (is-at? p 1 "[")))
                           (let [s (ix p) ^T n (nxt p 1)
                                 v (when (and (identical? :num (.-k n)) (is-at? p 2 "]")) (try (Long/decode (.-s n)) (catch Exception _ nil)))]
                             (skip-balanced! p)
                             (if (or (is? p "=") (is? p ".") (is? p "["))
                               (let [dz (conj dz [:i v s])] (if (is? p "=") dz (recur dz)))
                               (do (seek! p s) dz)))
                           ;; (cpp-gnu, 2026-11-22: GNU's obsolete designator `member:` before an element, the manual's
                           ;; "Designated Initializers": `.member =` written `member:`, parse/pr43765.C)
                           (and (empty? dz) (identical? :id (tk (cur p))) (is-at? p 1 ":"))
                           (let [nm (ts (cur p)) di (ix p)] (adv! p) (adv! p) [[:f nm di :gnu]])
                           :else dz))
                _ (when (and (is? p "=") (> (ix p) (inc b))) (let [^T pv (tok-at p (dec (ix p)))] (when (or (identical? :id (.-k pv)) (t= pv "]")) (adv! p))))
                x (parse-init-clause p)
                x (if (is? p "...") (let [e (ix p)] (adv! p) (node p "PackExpansionExpr" (nb x) e {:inner [x]})) x)
                out (conj out x)
                desigs (conj desigs (when (seq dz) dz))]
            (cond (accept! p ",") (recur out desigs)
                  (is? p "}") (recur out desigs)
                  :else (perr p "an initializer list"))))))))

(defn- class-ent-of
  "The class entity a type names (through a typedef or an alias), or nil."
  [t]
  (when (#{:n :elab} (:t t))
    (let [e (:ent t)]
      (cond (:fields e) e
            (:fields (:target e)) (:target e)
            :else nil))))

(defn- anon-path
  "The anonymous union or struct members (nested) through which the class `ce` has the member `v`, or nil."
  [ce v]
  (let [fields (vec (:fields ce)) ^java.util.Map ftypes (:ftypes ce)]
    (some (fn [f] (when (.startsWith ^String f "\u0001anon")
                    (let [ae (:ent (.get ftypes f))]
                      (cond (some #{v} (:fields ae)) [f]
                            ae (when-let [r (anon-path ae v)] (into [f] r))
                            :else nil))))
          fields)))

(defn- respell
  "A template-id type's spelling from its name's parts and (substituted) arguments."
  [t]
  (let [qn (:qn t)]
    (assoc t :s (str (when (:g qn) "::")
                     (str/join "::" (map (fn [part]
                                           (str (:s part)
                                                (when (:args part)
                                                  (str "<" (str/join ", " (map (fn [a] (if (= :type (:k a)) (qt (:t a)) (throw (ex-info "ctad: an expression argument" {:cpp/sema true}))))
                                                                               (:args part)))
                                                       ">"))))
                                         (:parts qn)))))))

(defn- designate
  "An initializer list `x` for an object of type `t` in clang's semantic form: its designated elements put at their
  members' (an aggregate's, as declared) or their indices' (an array's) places, the members or elements skipped
  between them value-initialized (ImplicitValueInitExpr), the trailing ones left out (the converter's reading); a
  nested designator's elements (.a.y = 2) in a list of the member's own without braces; a nested list designated in
  turn by its member's or element's type. A list whose designators the parser cannot place (an index not a literal, a
  class with bases, a union, an unknown type, an element without a designator after a nested one) is kept as written."
  [^P p t x]
  (if-not (= "InitListExpr" (:kind x))
    x
    (or
     ;; no designators: the list's semantic form by clang's InitListChecker (arbace.repr.cpp.sema), when it can be decided
     (when (nil? (:_desigs x)) (sema/semantic-list t x (.-year p) (in-template? p) (fn [t2 x2] (designate p t2 x2))))
     (let [ds0 (:_desigs x)
          kids (vec (:inner x))
          ce (class-ent-of t)
          arr (= :a (:t t))
          fields (when ce (vec (:fields ce)))
          ;; (cpp-gnu, 2026-11-22: GNU's obsolete `name:` designator names a member: for an array GCC's "name 'X' used in a
          ;; GNU-style designated initializer for an array", for a class one naming no non-static data member "'A' has no
          ;; non-static data member named 'i'", at the name; parse/error9.C, template/crash62.C, init/error2.C, ext/pr28291.C)
          _ (when-not (skim? p)
              (doseq [d ds0 :let [[k v di g] (first d)] :when (and (= k :f) (= g :gnu))]
                (cond arr (soft-diag! p (long di) (str "name '" v "' used in a GNU-style designated initializer for an array"))
                      (and ce (not (some #{v} fields)) (not (anon-path ce v)))
                      (soft-diag! p (long di) (str "'" (or (:name ce) "<unnamed>") "' has no non-static data member named '" v "'"))
                      :else nil)))
          ftypes (when ce (:ftypes ce))
          ;; a designator naming a member of an anonymous union or struct member designates that member first
          ;; (clang's implicit .anon.a)
          ds (if (and ce ds0)
               (mapv (fn [d]
                       (let [[k v] (first d)]
                         (if (and (= k :f) (not (some #{v} fields)))
                           (if-let [path (anon-path ce v)]
                             (into (mapv (fn [an] [:f an (nth (first d) 2)]) path) d)
                             d)
                           d)))
                     ds0)
               ds0)
          sub-type (fn [^long i] (cond arr (:of t)
                                       (and fields (empty? (:bases-order ce)) (< i (count fields))) (get ftypes (fields i))
                                       :else nil))
          head-ok (fn [[k v]] (if arr (and (= k :i) v) (and (= k :f) (some #{v} fields))))
          ;; (cpp-ce2: a union's one designated element, `{.f = 3.14}`: the member it names is the one initialized,
          ;; [dcl.init.aggr]/3.1 with [dcl.init.aggr]/5's union rule; clang's semantic InitListExpr's `field`, which Sema
          ;; reads; a nested designator `.s.b = 1` the member's list without braces)
          un (when (and ce (:union ce) (= 1 (count kids)) (= 1 (count ds)) (first ds) (head-ok (first (first ds))))
               (let [d (first ds) v (second (first d)) st (get ftypes v) x1 (kids 0)
                     x2 (if (> (count d) 1)
                          {:kind "InitListExpr" :inner [x1] :_desigs [(vec (rest d))] :range (:range x1)}
                          x1)
                     x2 (if st (designate p st x2) (dissoc x2 :_desigs))]
                 (assoc (dissoc x :_desigs) :inner [x2] :field {:name v})))
          placeable (and (nil? un) ds (or arr (and ce (not (:union ce)) (empty? (:bases-order ce))))
                         (every? (fn [d] (or (nil? d) (head-ok (first d)))) ds)
                         (not (some (fn [[d e]] (and (> (count d) 1) (nil? e))) (partition 2 1 ds))))
          slots (when placeable
                  (loop [i 0 at 0 m (sorted-map) prev nil]
                    (if (>= i (count kids))
                      m
                      (let [d (get ds i)
                            [k v] (first d)
                            at (long (if d (if (= k :i) v (.indexOf ^java.util.List fields v)) at))
                            x (kids i)]
                        ;; (round 54: [dcl.init.aggr]/3.1, a class's designators in the order of its members, each once: GCC's
                        ;; "designator order ... does not match declaration order", "designator used multiple times")
                        (when (and d (= k :f) (not arr) prev (nth (first d) 2 nil))
                          (let [[pat psingle] prev]
                            (cond (< at (long pat))
                                  (soft-diag! p (long (nth (first d) 2)) (str "designator order for field '" (when (:name ce) (str (:name ce) "::")) v "' does not match declaration order" (when (:name ce) (str " in '" (:name ce) "'"))))
                                  (and (= at (long pat)) psingle (= 1 (count d)))
                                  (soft-diag! p (long (nth (first d) 2)) "designator used multiple times in the same initializer list"))))
                        (if (> (count d) 1)
                          ;; a nested designator: its rest and its value into the member's list without braces
                          (let [sub (let [o (get m at)]
                                      (if (:_nested o) o {:kind "InitListExpr" :_nested true :inner [] :_desigs []
                                                          :range {:begin (loc p (long (nth (second d) 2))) :end (:end (:range x))}}))
                                sub (-> sub (update :inner conj x) (update :_desigs conj (vec (rest d))) (assoc-in [:range :end] (:end (:range x))))]
                            (recur (inc i) (inc at) (assoc m at sub) (if d [at false] prev)))
                          (recur (inc i) (inc at) (assoc m at x) (if d [at (= 1 (count d))] prev)))))))
          ;; (round 54, third pass: the same rule when the designators are not placed, a member of an anonymous member among
          ;; them: one field's name designated twice, each a designator alone)
          _ (when (and ds (not placeable) (not arr))
              (loop [xs (seq ds) seen #{}]
                (when (seq xs)
                  (let [d (first xs) [k v i] (first d)]
                    (if (and d (= 1 (count d)) (= k :f) i)
                      (if (contains? seen v)
                        (soft-diag! p (long i) "designator used multiple times in the same initializer list")
                        (recur (next xs) (conj seen v)))
                      (recur (next xs) seen))))))
          inner (if placeable
                  (let [n (if (seq slots) (inc (long (key (last slots)))) 0)]
                    (mapv (fn [^long j] (let [k (get slots j)]
                                          (cond (nil? k) {:kind "ImplicitValueInitExpr"}
                                                (sub-type j) (designate p (sub-type j) (dissoc k :_nested))
                                                :else (dissoc k :_nested :_desigs))))
                          (range n)))
                  (vec (map-indexed (fn [j k] (if (and (nil? ds) (sub-type j)) (designate p (sub-type j) k) k)) kids)))]
      (or un (assoc (dissoc x :_desigs) :inner inner))))))

(defn- paren-init
  "A direct-initialization's single parenthesized argument `x` for an object of type `t`: a braced list for a class is
  the argument of its copy or move constructor ([dcl.init]/17.6.2: clang's CXXConstructExpr over the list, the list in
  its semantic form for an aggregate); any other argument as it is."
  [^P p t x]
  (let [ti (when (= "InitListExpr" (:kind x)) (sema/tinfo t (.-year p)))]
    (cond
      (#{:class :record} (:k ti))
      {:kind "CXXConstructExpr" :range (:range x) :_b (:_b x) :_e (:_e x) :inner [(if (= :class (:k ti)) (designate p t x) x)]}
      ;; CP352: an array's `a({1})` (C++20 parenthesized aggregate initialization) is clang's InitListExpr in its semantic form,
      ;; the one `a{1}` has (g++.dg/cpp2a/paren-init33.C: the print's `a1{1}` read again must equal)
      (and (= "InitListExpr" (:kind x)) (= :a (:t t))) (designate p t x)
      :else x)))

(declare dependent-type? designate pack-indexed targ-nodes)

(defn- class-type? [t]
  (and (#{:n :elab :tn} (:t t))
       (let [e (:ent t)] (or (nil? e) (:class e) (:class (:target e)) (:tparam e) (and (:target e) (nil? (:scope e)) false)))))

(defn- cast-type
  "A cast's type as clang's expression has it: a prvalue of a non-class type has no top-level cv-qualifiers."
  [t]
  (if (or (#{:lr :rr} (:t t)) (class-type? t)) t (dissoc t :c :v)))

(defn- type-node-fields
  "A cast's type and value category as clang's expression has them: a reference type's referent, an lvalue (an xvalue
  for T&&) -- the type written is the expression's type with that reference."
  [t]
  (let [r (cast-type t)]
    (if (#{:lr :rr} (:t r))
      {:type {:qualType (qt (:of r))} :valueCategory (if (= :lr (:t r)) "lvalue" "xvalue") :_t t}
      {:type {:qualType (qt r)} :valueCategory "prvalue" :_t t})))

(defn- cast-node [^P p ^String kind ^long b t x]
  (node p kind b (ne x) (assoc (type-node-fields t) :inner [x])))

(defn- use-member!
  "Records a use of the special member of kind `k` of the class entity `e` (arbace.repr.cpp.sema's resolve-uses)."
  [^P p e k]
  (when (and e k (not (skim? p)) (:info e))
    (.add ^ArrayList (stv p USES) [e k])))

(defn- use-from!
  "The copy or the move an initialization of an object of class `e` from the expression `x` uses."
  [^P p e x]
  (when-let [[c e2] (sema/vclass x (.-year p))]
    (when (sema/same-class? e e2)
      (use-member! p e (case c :lvalue :copy :xvalue :move nil)))))

(defn- use-var-init!
  "The special members a variable's definition of type `t` (initializer `x` of kind `init`) uses: its default
  constructor without an initializer, from {} or for an array's elements a list leaves out; a copy or a move."
  [^P p t init x]
  (let [y (.-year p) ti (sema/tinfo t y)]
    (case (:k ti)
      (:class :record)
      (let [e (:ent ti)]
        (cond
          (nil? x) (use-member! p e :ctor0)
          (= "InitListExpr" (:kind x)) (when (= :record (:k ti))
                                         (case (count (:inner x)) 0 (use-member! p e :ctor0) 1 (use-from! p e (first (:inner x))) nil))
          (= "CXXConstructExpr" (:kind x)) nil
          :else (use-from! p e x)))
      :array
      (let [ei (sema/tinfo (:of ti) y)]
        (when (#{:class :record} (:k ei))
          (cond (nil? x) (use-member! p (:ent ei) :ctor0)
                (and (= :record (:k ei)) (= "InitListExpr" (:kind x)) (number? (:n ti)) (> (long (:n ti)) (count (:inner x))))
                (use-member! p (:ent ei) :ctor0))))
      nil)))

(declare class-member? in-body-member?)

(defn- local-name?
  "Whether unqualified lookup of `nm` finds a block's or a function's parameters' name."
  [^P p nm]
  (loop [^Scope s (scope p)]
    (when s (if (sc/find-in s nm) (contains? #{:block :fparams} (sc/kind-of s)) (recur (sc/parent-of s))))))

(defn- use-return!
  "The copy or the move a return of `x` from a function returning a class by value uses (an implicit move of a local)."
  [^P p x]
  (when-let [re (some-> (stv p RET) sema/class-ent)]
    (when-let [[c e] (sema/vclass x (.-year p))]
      (when (sema/same-class? re e)
        (use-member! p e (case c
                           :lvalue (if (and (= "DeclRefExpr" (:kind x)) (local-name? p (get-in x [:referencedDecl :name]))) :move :copy)
                           :xvalue :move
                           nil))))))

(defn- use-binary!
  "The special member an assignment or a comparison of class objects uses."
  [^P p ^String op l r]
  (when (#{"=" "==" "!="} op)
    (let [y (.-year p) [cl el] (sema/vclass l y) [cr er] (sema/vclass r y)]
      (when (and el er (sema/same-class? el er))
        (if (= op "=")
          (when (= cl :lvalue) (use-member! p el (if (= cr :lvalue) :copy= :move=)))
          (use-member! p el :eq))))))

(defn- construct-node
  "A functional cast or temporary object: T(args) or T{args}, the type `t` spelled from b."
  [^P p ^long b t builtin]
  (if (is? p "{")
    (let [l (designate p t (parse-braced-init p))
          _ (when (and (empty? (:inner l)) (= :record (:k (sema/tinfo t (.-year p))))) (use-member! p (sema/class-ent t) :ctor0))]
      (node p (if (and (in-template? p) (dependent-type? t)) "CXXUnresolvedConstructExpr" "CXXFunctionalCastExpr") b (ne l)
            (assoc (type-node-fields t) :inner [l])))
    (let [as (paren-args p) e (last-ix p)
          ;; a class template's arguments deduced from a closure (CTAD: Merged(l1, l2) is a Merged<(lambda ...), ...>):
          ;; a type the converter writes as the expression's text
          t (if (and (:tmpl (:ent t)) (not (some :args (:parts (:qn t))))
                     (some (fn [a] (or (= "LambdaExpr" (:kind a)) (:closure (:_ent a)))) as))
              (assoc t :s (str (:s t) "<(lambda at " (.-main p) ")>"))
              t)]
      (when (and (empty? as) (not builtin)) (use-member! p (sema/class-ent t) :ctor0))
      (cond
        ;; a dependent type's construction (Sema::BuildCXXTypeConstructExpr): unresolved until instantiated
        (and (in-template? p) (dependent-type? t)) (node p "CXXUnresolvedConstructExpr" b e (assoc (type-node-fields t) :inner as))
        (and (= 1 (count as)) (not= "InitListExpr" (:kind (first as)))) (node p "CXXFunctionalCastExpr" b e (assoc (type-node-fields t) :inner as))
        (and (empty? as) builtin) (node p "CXXScalarValueInitExpr" b e (type-node-fields t))
        :else (node p "CXXTemporaryObjectExpr" b e (assoc (type-node-fields t) :inner as))))))

(def ^:private named-casts
  {"static_cast" "CXXStaticCastExpr" "dynamic_cast" "CXXDynamicCastExpr" "reinterpret_cast" "CXXReinterpretCastExpr"
   "const_cast" "CXXConstCastExpr" "addrspace_cast" "CXXAddrspaceCastExpr"})

(defn- text-node
  "A node the converter writes as its text (a kind it has no form for): the tokens from b to the cursor's last."
  [^P p ^String kind ^long b]
  (node p kind b (last-ix p) {}))

(declare soft-diag!)

(defn- parse-string-literal [^P p]
  (let [b (ix p)
        ss (loop [out []] (if (#{:str :udls} (tk (cur p))) (let [s (ts (cur p))] (adv! p) (recur (conj out s))) out))
        e (last-ix p)
        ;; (CX12, cpp-s2: adjacent literals of two different encoding prefixes, [lex.string]/7 since P2201R1: ill-formed,
        ;; clang's "unsupported non-standard concatenation of string literals" at the second; the literal taken)
        _ (loop [i b enc nil]
            (when (<= i (long e))
              (let [pre (second (re-find #"^(u8|u|U|L)?R?[\"]" (ts (tok-at p i))))]
                (if (and pre enc (not= pre enc))
                  (soft-diag! p i "unsupported non-standard concatenation of string literals")
                  (recur (inc i) (or enc pre))))))]
    (if (some #(re-find #"[\"][A-Za-z_][A-Za-z0-9_]*$" %) ss)
      ;; (G5: the literal and its ud-suffix for the code generator's literal operator call, [lex.ext]/5)
      (let [sfx (some #(second (re-find #"[\"]([A-Za-z_][A-Za-z0-9_]*)$" %)) ss)
            plain (mapv #(str/replace % #"([\"])[A-Za-z_][A-Za-z0-9_]*$" "$1") ss)
            [v ty n] (try (lit/string-literal plain (.-year p)) (catch Exception _ nil))]
        (node p "UserDefinedLiteral" b e (if v {:_udl {:k :str :suffix sfx :value v :ty ty :n n}} {})))
      (let [[v ty n] (lit/string-literal ss (.-year p))]
        (node p "StringLiteral" b e {:value v :type {:qualType (str "const " ty "[" n "]")} :valueCategory "lvalue"})))))

(defn- trait-name? [^String s]
  (boolean (re-matches #"__(is|has|array|reference)_[A-Za-z0-9_]+|__is_same|__is_convertible_to|__builtin_types_compatible_p|__can_pass_in_regs|__builtin_is_virtual_base_of|__builtin_is_implicit_lifetime|__builtin_is_cpp_trivially_relocatable|__builtin_structured_binding_size" s)))

(defn- parse-number [^P p]
  (let [^T t (cur p) s (.-s t) i (ix p)]
    (adv! p)
    (if-let [[v ty] (lit/int-literal s)]
      (node p "IntegerLiteral" i i {:value v :type {:qualType ty} :valueCategory "prvalue"})
      (if-let [[v ty] (lit/float-literal s)]
        (do ;; (round 54: GNU's q, Q, w and W floating suffixes, GCC's extension in its GNU modes alone; in a strict mode the suffix
            ;; from C++11 is a ud-suffix, [lex.ext]/1 (C++98 has none: the suffix GCC's extension again), whose literal operator lookup finds none: GCC's "unable to find numeric literal operator")
            (when-let [[_ sfx] (and (not (.-gnu p)) (>= (.-year p) 2011) (re-find #"[0-9.]([qQwW])$" s))]
              (when-not (lookup (scope p) (str "operator\"\"" sfx))
                (soft-diag! p i (str "unable to find numeric literal operator 'operator\"\"" sfx "'"))))
            (node p "FloatingLiteral" i i {:value v :type {:qualType ty} :valueCategory "prvalue"}))
        (if (and (re-matches #"(?i)[0-9.][0-9a-z.'+-]*?(i|j)(f|l|u|ul|ll|ull)?|(?i)[0-9.][0-9a-z.'+-]*?(f|l)(i|j)" s)
                 (not (lookup (scope p) (str "operator\"\"" (second (re-find #"([A-Za-z_]+)$" s))))))
          (node p "ImaginaryLiteral" i i {})
          (let [[_ num sfx] (or (re-find #"^(.*?)(_[A-Za-z0-9_]*)$" s)
                                ;; (cpp-1123: a suffix without an underscore, the standard library's reserved ones -- <chrono>'s
                                ;; 0min, <string>'s s -- [lex.ext]/1 with [usrlit.suffix]: the longest numeric prefix whose rest is
                                ;; an identifier a literal operator in scope has; tzdb.cc's `info.save = 0min;`)
                                (some (fn [k] (let [num (subs s 0 k) sfx (subs s k)]
                                                (when (and (re-matches #"[A-Za-z][A-Za-z0-9_]*" sfx)
                                                           (or (lit/int-literal num) (lit/float-literal num))
                                                           (lookup (scope p) (str "operator\"\"" sfx)))
                                                  [s num sfx])))
                                      (range (dec (count s)) 0 -1)))]
            ;; (round 54, fourth pass: C++98 has no user-defined literal, [lex.icon], [lex.fcon]: a number's identifier suffix is
            ;; GCC's error "invalid suffix \"_mm\" on floating constant", "... on integer constant")
            (when (and num (< (.-year p) 2011))
              (soft-diag! p i (str "invalid suffix \"" sfx "\" on " (if (lit/int-literal num) "integer" "floating") " constant")))
            ;; (round 54, fifth pass: C23's bit-precise integer suffixes wb and uwb are not C++'s, [lex.icon]/1: from C++11 the
            ;; suffix is a ud-suffix, [lex.ext]/1, whose literal operator lookup finds none, GCC's "unable to find numeric literal
            ;; operator 'operator\"\"wb'")
            (when-let [[_ _ bsfx] (and (nil? num) (>= (.-year p) 2011) (re-matches #"(?i)([0-9][0-9']*)(u?wb|wbu)" s))]
              (when-not (lookup (scope p) (str "operator\"\"" bsfx))
                (soft-diag! p i (str "unable to find numeric literal operator 'operator\"\"" bsfx "'"))))
            (node p "UserDefinedLiteral" i i
                  (if num
                    (if-let [[v] (lit/int-literal num)]
                      {:_udl {:k :int :suffix sfx :value v :text num}}
                      (if-let [[v] (lit/float-literal num)] {:_udl {:k :float :suffix sfx :value v :text num}} {}))
                    {}))))))))

(defn- simple-type-start?
  "A simple-type-specifier begins at the cursor and a ( or { follows it: a functional cast or construction (not a
  call): a builtin type's keyword, typename, decltype, or a name of a type."
  [^P p]
  (let [^T t (cur p)]
    (cond
      (and (identical? :kw (.-k t)) (contains? builtin-kws (.-s t))) (or (is-at? p 1 "(") (is-at? p 1 "{"))
      (and (identical? :kw (.-k t)) (= "auto" (.-s t))) (or (is-at? p 1 "(") (is-at? p 1 "{"))
      (t= t "typename") true
      :else false)))

(declare dependent-type?)

(defn- dep-this?
  "Whether `this` is type-dependent here: in a member of a class template or of a partial specialization (a class
  being defined, or the class of an out-of-class member's qualifier)."
  [^P p]
  (or (boolean (some #(:dep (:ent %)) (stv p CLS)))
      (loop [^Scope s (scope p)]
        (when s (if (and (= :lookup (sc/kind-of s)) (let [e (sc/ent-of s)] (or (:tmpl e) (:dep e)))) true (recur (sc/parent-of s)))))))

(defn- dep-bases?
  "cpp-read (2026-11-22): whether a class template whose member is parsed (being defined, or the class of an out-of-class
  member's qualifier) has a base that may depend on a template parameter: a template parameter, a template-id, a name no
  lookup found or a dependent class. Without one, [temp.res.general]/? binds an unqualified name at the definition ([temp.dep]/3:
  a dependent base is never looked in), so a name no lookup finds is undeclared there too."
  [^P p]
  (let [ents (concat (map :ent (stv p CLS))
                     (loop [^Scope s (scope p) out []]
                       (if s (recur (sc/parent-of s) (if (= :lookup (sc/kind-of s)) (conj out (sc/ent-of s)) out)) out)))]
    (boolean
      (some (fn [e]
              (when-let [^HashMap i (and (map? e) (sema/info e))]
                (some (fn [b] (let [t (:ty b) en (:ent t)]
                                (or (nil? en) (:tparam en) (:dep en) (some :args (:parts (:qn t))))))
                      (.get i :bases))))
            ents))))

(defn- class-member?
  "Whether unqualified lookup of `nm` finds it in a class's scope (a member, the implicit object's)."
  [^P p nm]
  (loop [^Scope s (scope p)]
    (when s
      (if (sc/find-in s nm)
        (let [k (sc/kind-of s)] (or (= k :class) (and (= k :lookup) (= :class (some-> ^Scope (:scope (sc/ent-of s)) sc/kind-of)))))
        (recur (sc/parent-of s))))))

(defn- type-dependent?
  "Whether the expression `x` is type-dependent, as far as the parser knows ([temp.dep.expr]): `this` in a class
  template, a name of a dependent type, a dependent construction."
  [^P p x]
  (case (:kind x)
    "CXXThisExpr" (dep-this? p)
    ("ParenExpr" "UnaryOperator" "BinaryOperator" "MemberExpr" "ArraySubscriptExpr") (boolean (some #(type-dependent? p %) (:inner x)))
    "DeclRefExpr" (let [e (:_ent x)] (boolean (and (:ty e) (dependent-type? (:ty e)))))
    ("CXXUnresolvedConstructExpr" "PackExpansionExpr" "UnresolvedMemberExpr") true
    ("CXXFunctionalCastExpr" "CStyleCastExpr" "CXXStaticCastExpr" "CXXTemporaryObjectExpr") (boolean (some-> (:_t x) dependent-type?))
    false))

(defn- unresolved-call
  "A call's callee `x` with its arguments `as`: clang's UnresolvedMemberExpr (written as its text) when it names a
  member function overload set or template (not all static) through a type-dependent object or with a type-dependent
  argument in a template (Sema::BuildMemberReferenceExpr keeps the lookup's result for the instantiation)."
  [^P p x as]
  (let [e (:_mfn x)]
    (if (and e (or (in-template? p) (dep-this? p)) (or (:ovl e) (:tmpl e)) (not (:static e))
             (or (:_objdep x) (some #(type-dependent? p %) as)))
      (assoc x :kind "UnresolvedMemberExpr")
      x)))

(def ^:private sync-builtins
  #{"__sync_fetch_and_add" "__sync_fetch_and_sub" "__sync_fetch_and_or" "__sync_fetch_and_and" "__sync_fetch_and_xor"
    "__sync_fetch_and_nand" "__sync_add_and_fetch" "__sync_sub_and_fetch" "__sync_or_and_fetch" "__sync_and_and_fetch"
    "__sync_xor_and_fetch" "__sync_nand_and_fetch" "__sync_bool_compare_and_swap" "__sync_val_compare_and_swap"
    "__sync_lock_test_and_set" "__sync_lock_release" "__sync_swap"})

(defn- type-size
  "The size of a type on LP64, as far as a __sync builtin's suffix asks it, or nil."
  [t]
  (loop [t t n 0]
    (let [e (:ent t)]
      (cond
        (> n 32) nil
        (and (#{:n :elab} (:t t)) (:size e)) (:size e)
        (and (#{:n :elab} (:t t)) (:ty e)) (recur (:ty e) (inc n))
        (= :p (:t t)) 8
        (= :b (:t t)) (let [w (set (:w t))]
                        (cond (or (w "char") (w "bool") (w "_Bool")) 1
                              (w "short") 2
                              (w "__int128") 16
                              (or (w "long") (w "double")) 8
                              (or (w "int") (w "float") (w "unsigned") (w "signed")) 4
                              :else nil))
        (and (#{:n :elab} (:t t)) (:scope e) (= :enum (sc/kind-of (:scope e)))) 4
        :else nil))))

(defn- sync-builtin
  "A call of a __sync builtin overloaded on its pointer's pointee: clang's call of the sized one (Sema's
  BuiltinAtomicOverloaded: __sync_fetch_and_add on a long * calls __sync_fetch_and_add_8)."
  [^P p x as]
  (let [nm (get-in x [:referencedDecl :name])]
    (if (and (= "DeclRefExpr" (:kind x)) (sync-builtins nm) (seq as) (not (in-template? p)))
      (let [a (first as)
            t (case (:kind a)
                ("CStyleCastExpr" "CXXStaticCastExpr" "CXXReinterpretCastExpr") (:_t a)
                "DeclRefExpr" (:ty (:_ent a))
                "ParenExpr" nil
                nil)
            n (when (= :p (:t t)) (type-size (:of t)))]
        (if (#{1 2 4 8 16} n) (assoc-in x [:referencedDecl :name] (str nm "_" n)) x))
      x)))

(defn- call-args
  "A call's arguments `as`, a braced list among them in its semantic form when the callee is a function that is not
  overloaded and its parameter's type is known (overload resolution would choose it alone)."
  [^P p x as]
  (let [ps (when (= "DeclRefExpr" (:kind x)) (let [e (:_ent x)] (when (and (= :fn (:k e)) (not (:ovl e)) (not (:tmpl e))) (:ptys e))))]
    (if (and ps (some #(= "InitListExpr" (:kind %)) as) (<= (count as) (count ps)))
      (mapv (fn [a t] (if (= "InitListExpr" (:kind a)) (designate p (if (#{:lr :rr} (:t t)) (:of t) t) a) a)) as ps)
      as)))

(defn- object-class
  "The class entity of the object expression `base` of a member access (through a pointer for ->) and whether it is
  dependent, or nil."
  [^P p base arrow]
  (let [t (case (:kind base)
            ("CXXFunctionalCastExpr" "CXXTemporaryObjectExpr") (:_t base)
            "DeclRefExpr" (:ty (:_ent base))
            nil)
        t (if (and t arrow) (when (= :p (:t t)) (:of t)) t)
        e (:ent t)
        e (if (and e (:target e) (nil? (:scope e))) (:target e) e)]
    (when (and (#{:n :elab} (:t t)) e (:scope e) (= :class (sc/kind-of (:scope e))))
      [e (boolean (or (:tmpl e) (:dep e) (dependent-type? t)))])))

(declare declared-in-main?)

(defn parse-primary [^P p]
  (let [^T t (cur p) k (.-k t) s (.-s t) b (ix p)]
    (cond
      (identical? k :num) (parse-number p)
      (identical? k :chr) (let [[v ty] (lit/char-literal s (.-year p))] (adv! p) (node p "CharacterLiteral" b b {:value v :type {:qualType ty} :valueCategory "prvalue"}))
      (identical? k :udlc) (do (adv! p)
                               (let [[_ lit sfx] (re-find #"^(.*')([A-Za-z_][A-Za-z0-9_]*)$" s)
                                     [v ty] (when lit (try (lit/char-literal lit (.-year p)) (catch Exception _ nil)))]
                                 (node p "UserDefinedLiteral" b b (if v {:_udl {:k :chr :suffix sfx :value v :ty ty}} {}))))
      (or (identical? k :str) (identical? k :udls)) (parse-string-literal p)
      (t= t "true") (do (adv! p) (node p "CXXBoolLiteralExpr" b b {:value true :type {:qualType "bool"}}))
      (t= t "false") (do (adv! p) (node p "CXXBoolLiteralExpr" b b {:value false :type {:qualType "bool"}}))
      (t= t "nullptr") (do (adv! p) (node p "CXXNullPtrLiteralExpr" b b {}))
      (t= t "__null") (do (adv! p) (node p "GNUNullExpr" b b {}))
      (t= t "this") (do ;; (cpp-read, 2026-11-22: [expr.prim.this]/2-3, `this` in a static member function or a non-member function's
                        ;; body: GCC's "'this' is unavailable for static member functions", "invalid use of 'this' in non-member function")
                        (when (and (#{:static :nonmember} *this-ok*) (main-tok? p b) (not (skim? p)))
                          (soft-diag! p b (if (= :static *this-ok*) "'this' is unavailable for static member functions"
                                              "invalid use of 'this' in non-member function")))
                        (adv! p) (node p "CXXThisExpr" b b {}))
      (t= t "(")
      (cond
        (is-at? p 1 "{") (do (adv! p) (let [c (binding [*in-if* false] (parse-compound-stmt p))] (expect! p ")") (node p "StmtExpr" b (last-ix p) {:inner [c]})))
        ;; a fold expression: an operator then ... (or ... then an operator) at the parentheses' level
        (let [e (do (let [s0 (ix p)] (skip-balanced! p) (let [e (dec (ix p))] (seek! p s0) e)))]
          (loop [j (inc b) d 0]
            (cond (>= j e) false
                  (let [^T x (tok-at p j)] (or (t= x "(") (t= x "[") (t= x "{"))) (recur (inc j) (inc d))
                  (let [^T x (tok-at p j)] (or (t= x ")") (t= x "]") (t= x "}"))) (recur (inc j) (dec d))
                  ;; (CP291 (a): the comma among the fold-operators, [expr.prim.fold]/1)
                  (and (zero? d) (t= (tok-at p j) "...")
                       (or (and (> j (inc b)) (fold-op-token? (tok-at p (dec j))))
                           (and (< (inc j) e) (fold-op-token? (tok-at p (inc j))))))
                  true
                  :else (recur (inc j) d))))
        (let [full? (and *full-headers* (not (skim? p)))
              f (when full?
                  (let [r (tentatively p (fn [p] (let [f (parse-fold p)] [f (ix p)])))]
                    (when (vector? r) r)))
              e0 (let [s0 (ix p)] (skip-balanced! p) (let [e (ix p)] (seek! p s0) e))
              ;; (CP332 (a), full-header mode: a parenthesized expression whose `...` the test took for a fold's is one
              ;; when it does not parse as a fold and does as an expression, `(__constructible<_Elements...>())`: the pack
              ;; expansion closes a template argument list, `...>` not a fold over >; tuple's constraints)
              pe (when (and full? (not (and f (= (second f) e0))))
                   (let [r (tentatively p (fn [p] (adv! p)
                                            (let [x (with-gt p true (parse-expr p))]
                                              (expect! p ")")
                                              [x (ix p)])))]
                     (when (and (vector? r) (= (second r) e0)) r)))]
          (if pe
            (do (adv! p)
                (let [x (with-gt p true (parse-expr p))]
                  (expect! p ")")
                  (node p "ParenExpr" b (last-ix p) {:inner [x]})))
            (do
          ;; cpp-read (2026-11-22): a `...` at the parentheses' level beside an operator that neither a fold-expression nor an
          ;; expression derives ([expr.prim.fold]/1: the fold-operator stands between the `...` and its operand, `(E op ...)`,
          ;; `(... op E)`): GCC's "expected ..." (cp_parser_fold_expression's errors), at the parenthesis
          (when (and full? (not (and f (= (second f) e0))) (main-tok? p b))
            (soft-diag! p b "expected a fold-expression"))
          (skip-balanced! p)
          (cond-> (text-node p "CXXFoldExpr" b)
            ;; (the operands as data, the node the text it was: the tree compared with clang's unchanged)
            (and f (= (second f) (ix p))) (assoc :_fold (first f))))))
        :else (do (adv! p)
                  (let [x (with-gt p true (parse-expr p))]
                    (expect! p ")")
                    (node p "ParenExpr" b (last-ix p) {:inner [x]}))))
      (and (t= t "[") (not (is-at? p 1 "["))) (parse-lambda p)
      (t= t "{") (parse-braced-init p)
      (and (identical? k :kw) (contains? named-casts s))
      (do (adv! p) (expect! p "<")
          (let [ty (binding [*tdef-ctx* "in casts"] (with-gt p false (parse-type-id p :targ)))]
            (expect! p ">")
            (expect! p "(")
            (let [x (with-gt p true (parse-expr p))]
              (expect! p ")")
              (node p (named-casts s) b (last-ix p) (assoc (type-node-fields ty) :inner [x])))))
      (t= t "typeid")
      (do ;; (cpp-read, 2026-11-22: [expr.typeid]/7, a typeid with no std::type_info declared, <typeinfo> neither imported nor
          ;; included: GCC's "must '#include <typeinfo>' before using 'typeid'", at the keyword)
          (when (and *full-headers* (not (skim? p)) (main-tok? p b)
                     (nil? (find-member (lookup (scope p) "std") "type_info")))
            (soft-diag! p b "must '#include <typeinfo>' before using 'typeid'"))
          (adv! p) (expect! p "(")
          (if (is-type-id? p :paren)
            (let [ty (binding [*tdef-ctx* "in a 'typeid' expression"] (parse-type-id p :paren))] (expect! p ")") (node p "CXXTypeidExpr" b (last-ix p) {:typeArg {:qualType (qt ty)}}))
            (let [x (with-gt p true (parse-expr p))] (expect! p ")") (node p "CXXTypeidExpr" b (last-ix p) {:inner [x]}))))
      (t= t "requires") (parse-requires-expr p)
      (or (t= t "__func__") (t= t "__FUNCTION__") (t= t "__PRETTY_FUNCTION__")) (do (adv! p) (text-node p "PredefinedExpr" b))
      ;; G5: __builtin_va_arg(ap, T) for the code generator: its operand and type (clang's VAArgExpr), the node the
      ;; converter's text all the same
      (and (= s "__builtin_va_arg") *full-headers* (not (skim? p)) (is-at? p 1 "("))
      (or (try (adv! p) (adv! p)
               (let [x (with-gt p true (parse-assign-expr p))]
                 (when (accept! p ",")
                   (let [ti (ix p)
                         ty (parse-type-id p :paren)]
                     ;; (cpp-diag-b, 2026-11-22: [cstdarg.syn]/1 with C's va_arg: an argument through ... is a prvalue, no reference
                     ;; type is received: GCC's "cannot receive reference type 'int&' through '...'")
                     (when (and (#{:lr :rr} (:t ty)) (main-tok? p ti))
                       (soft-diag! p ti (str "cannot receive reference type '" (qt ty) "' through '...'")))
                     (when (is? p ")") (adv! p)
                       (assoc (node p "BuiltinExpr" b (last-ix p) {}) :_vaarg x :_vatype (qt ty))))))
               (catch arbace.lang.ExceptionInfo _ nil))
          (do (seek! p b) (adv! p) (skip-balanced! p) (text-node p "BuiltinExpr" b)))
      ;; G5c: __builtin_offsetof(T, designator) for the code generator (clang's OffsetOfExpr, Parser::ParseBuiltinPrimaryExpression:
      ;; an identifier, then .identifier and [expression]s; libsupc++'s dyncast.cc and eh_ptr.cc), the type and the components kept
      ;; (queue 377: __builtin_classify_type's type argument defining a class or enumeration: GCC's "types may not be defined in
      ;; '__builtin_classify_type' calls", at the brace; the call is then read as before, its argument an expression)
      ;; (cpp-gnu, 2026-11-22: GCC's __builtin_classify_type takes a type-id too, the GCC 15.2 manual's "Other Built-in Functions":
      ;; `__builtin_classify_type (type)`; a type defined there "types may not be defined in '__builtin_classify_type' calls", as a
      ;; cast's, ext/builtin-classify-type-2.C)
      (and (= s "__builtin_classify_type") (is-at? p 1 "(")
           (let [save (ix p)] (adv! p) (adv! p) (let [r (is-type-id? p :paren)] (seek! p save) r)))
      (do (adv! p) (adv! p)
          (binding [*tdef-ctx* "in '__builtin_classify_type' calls"] (parse-type-id p :paren))
          (expect! p ")")
          (text-node p "BuiltinExpr" b))
      (and (= s "__builtin_classify_type") (is-at? p 1 "(") (not (skim? p))
           (do (when-let [bi (def-brace p (+ (long (ix p)) 2))] (soft-diag! p bi "types may not be defined in '__builtin_classify_type' calls")) false))
      nil
      (and (= s "__builtin_offsetof") (is-at? p 1 "("))
      (let [r (tentatively p (fn [p]
                               (adv! p) (adv! p)
                               (let [ty (binding [*tdef-ctx* "within '__builtin_offsetof'"] (parse-type-id p :paren))
                                     _ (expect! p ",")
                                     id1 (let [^T t (cur p)] (when (identical? :id (.-k t)) (adv! p) (.-s t)))
                                     cs (when id1
                                          (loop [cs [{:f id1}]]
                                            (cond (accept! p ".") (let [^T t (cur p)] (if (identical? :id (.-k t)) (do (adv! p) (recur (conj cs {:f (.-s t)}))) nil))
                                                  (accept! p "[") (let [x (with-gt p true (parse-expr p))] (when (accept! p "]") (recur (conj cs {:i x}))))
                                                  :else cs)))]
                                 (when (and cs (is? p ")")) {:type (qt ty) :path cs}))))]
        (adv! p) (skip-balanced! p)
        (cond-> (text-node p "BuiltinExpr" b) (map? r) (assoc :_offsetof r)))
      ;; (cpp-ce2: __builtin_bit_cast(T, e) for Sema, clang's BuiltinBitCastExpr, Parser::ParseBuiltinBitCast: a type-id, then an
      ;; assignment-expression; the node the converter's text all the same, as __builtin_va_arg's)
      (and (= s "__builtin_bit_cast") *full-headers* (not (skim? p)) (is-at? p 1 "("))
      (or (try (adv! p) (adv! p)
               (let [ty (parse-type-id p :paren)]
                 (when (accept! p ",")
                   (let [x (with-gt p true (parse-assign-expr p))]
                     (when (is? p ")") (adv! p)
                       (assoc (node p "BuiltinExpr" b (last-ix p) {}) :_bitcast x :_bctype (qt ty))))))
               (catch arbace.lang.ExceptionInfo _ nil))
          (do (seek! p b) (adv! p) (skip-balanced! p) (text-node p "BuiltinExpr" b)))
      (and (identical? k :kw) (#{"__builtin_va_arg" "__builtin_offsetof" "__builtin_bit_cast" "__builtin_types_compatible_p" "__builtin_convertvector" "__builtin_choose_expr"} s))
      (do (adv! p) (when (is? p "(") (skip-balanced! p)) (text-node p "BuiltinExpr" b))
      ;; (cpp-gnu, 2026-11-22: a type trait's operands are type-ids, the GCC 15.2 manual's "Type Traits": a ( after the trait's own
      ;; begins none, GCC's "expected type-specifier before '(' token", the statement given up to its ;, ext/is_class_error1.C)
      (and (identical? k :id) (is-at? p 1 "(") (is-at? p 2 "(") (trait-name? s) (not (lookup (scope p) s))
           (re-find #"^__is_|^__has_" s) (main-tok? p (+ (ix p) 2)))
      (do (soft-diag! p (+ (ix p) 2) "expected type-specifier before '(' token")
          (adv! p) (adv! p)
          (loop [d 0] (when-not (or (eof? p) (and (zero? d) (or (is? p ";") (is? p "}"))))
                        (let [d (cond (or (is? p "(") (is? p "[") (is? p "{")) (inc d) (or (is? p ")") (is? p "]")) (max 0 (dec d)) :else d)]
                          (adv! p) (recur d))))
          (assoc (text-node p "TypeTraitExpr" b) :_text (tok-text p b (last-ix p))))
      (and (identical? k :id) (is-at? p 1 "(") (trait-name? s) (not (lookup (scope p) s)))
      (do (when (= s "__is_nothrow_constructible")
            ;; the trait evaluates the constructor's exception specification
            (tentatively p (fn [p]
                             (adv! p) (expect! p "(")
                             (let [ts (loop [ts []] (let [ts (conj ts (parse-type-id p :targ))] (if (accept! p ",") (recur ts) ts)))
                                   e (sema/class-ent (first ts))
                                   a (second ts)]
                               (when (and e (<= (count ts) 2))
                                 (use-member! p e (cond (nil? a) :ctor0
                                                        (sema/same-class? e (sema/class-ent a)) :move
                                                        (and (= :rr (:t a)) (sema/same-class? e (sema/class-ent (:of a)))) :move
                                                        (and (= :lr (:t a)) (sema/same-class? e (sema/class-ent (:of a)))) :copy
                                                        :else nil)))))))
          ;; (its tokens' text kept: a macro's expansion has no text of its own in the file, G5)
          (adv! p) (skip-balanced! p) (assoc (text-node p "TypeTraitExpr" b) :_text (tok-text p b (last-ix p))))
      ;; builtins clang's AST has as expressions of their own, not calls: the converter writes them as their text
      (and (identical? k :id) (is-at? p 1 "(") (re-matches #"__(c11_|opencl_|scoped_|hip_)?atomic_[a-z_]+" s)
           (not (#{"__atomic_thread_fence" "__atomic_signal_fence" "__atomic_always_lock_free" "__atomic_is_lock_free"} s))
           ;; (a function the program declares under such a name is called as one: libstdc++'s <ext/atomicity.h>
           ;; __atomic_add_single and __atomic_add_dispatch, CallExprs in clang's AST; cpp-s2)
           (not (lookup (scope p) s))
           (not (in-template? p)))
      ;; G5c: the operands kept for the code generator (clang's AtomicExpr, Sema::BuildAtomicExpr; libsupc++'s guard.cc,
      ;; new_handler.cc, atomicity.h), in the source's order under an underscored field (the dump's children are clang's
      ;; own order, not compared)
      (let [xs (tentatively p (fn [p]
                                (adv! p) (expect! p "(")
                                (let [xs (loop [xs []] (let [xs (conj xs (with-gt p true (parse-assign-expr p)))] (if (accept! p ",") (recur xs) xs)))]
                                  (when (is? p ")") (adv! p) xs))))]
        (adv! p) (skip-balanced! p)
        (cond-> (text-node p "AtomicExpr" b) (and (vector? xs) (every? map? xs)) (assoc :_atomic s :_args xs)))
      (and (identical? k :id) (is-at? p 1 "(") (#{"__builtin_shufflevector" "__builtin_FILE" "__builtin_LINE" "__builtin_FUNCTION" "__builtin_FUNCSIG"
                                                   "__builtin_COLUMN" "__builtin_source_location" "__builtin_FILE_NAME" "__builtin_astype"
                                                   "__builtin_sycl_unique_stable_name" "__builtin_vectorelements"} s))
      (do (adv! p) (skip-balanced! p) (text-node p "BuiltinExpr" b))
      ;; (cpp-gnu, 2026-11-22: GNU's _Complex and __complex__ are type-specifiers of a complex type, `_Complex float`, never a
      ;; type of their own: before ( they begin no explicit type conversion ([expr.type.conv]/1's simple-type-specifier), GCC's
      ;; "expected primary-expression before '_Complex'", parse/parser-pr28152.C, parser-pr28152-2.C)
      (and (#{"_Complex" "__complex__" "__complex"} s) (is-at? p 1 "("))
      (do (soft-diag! p (ix p) (str "expected primary-expression before '" s "'"))
          (adv! p) (parse-primary p))
      (simple-type-start? p)
      (let [ty (parse-type-specs p :expr)]
        (if (or (is? p "(") (is? p "{")) (construct-node p b ty (= :b (:t ty))) (perr p "a functional cast")))
      (and (t= t "decltype") (is-at? p 1 "("))
      (let [save (ix p)
            qn (parse-name p :parse)]
        (if qn
          (if (or (type-ent? (:ent qn)) (and (is? p "(") false))
            (construct-node p b {:t :n :s (name-str p qn) :ent (:ent qn)} false)
            (node p "DeclRefExpr" b (:e qn) {:referencedDecl {:name (or (:s (peek (:parts qn))) "")}}))
          (do (seek! p save)
              (let [ty (parse-type-specs p :expr)]
                (if (or (is? p "(") (is? p "{")) (construct-node p b ty false) (perr p "decltype"))))))
      (or (identical? k :id) (t= t "::") (t= t "operator") (t= t "template"))
      (let [qn (or (parse-name p :parse) (perr p "an expression"))
            en (:ent qn)
            lp (peek (:parts qn))]
        (cond
          (and (type-ent? en) (or (is? p "(") (is? p "{") (and (is? p "...") (is-at? p 1 "["))) (or (:s lp)))
          (let [t (pack-indexed p {:t :n :s (name-str p qn) :ent en :qn qn})]
            (if (or (is? p "(") (is? p "{")) (construct-node p b t false) (perr p "a functional cast")))
          ;; C++26's pack indexing: pack...[I]
          (and (is? p "...") (is-at? p 1 "[") (= 1 (count (:parts qn))))
          (let [r (node p "DeclRefExpr" b (:e qn) {:referencedDecl {:name (or (:s lp) "")}})]
            (adv! p) (adv! p)
            (let [i (with-gt p true (parse-expr p))]
              (expect! p "]")
              (node p "PackIndexingExpr" b (last-ix p) {:inner [r i]})))
          ;; a member of an anonymous union or struct of a block or a namespace: clang's member access through its implicit object
          (and (:anon en) (= 1 (count (:parts qn))))
          (node p "MemberExpr" b (:e qn) {:name (:s lp) :isArrow false :inner [(node p "DeclRefExpr" b (:e qn) {:referencedDecl {:name ""}})]})
          ;; a value named through a dependent using-declaration in a class template: unresolved (its text)
          (and (:unres en) (= 1 (count (:parts qn))) (not (:g qn)) (or (in-template? p) (dep-this? p)))
          (node p "UnresolvedMemberExpr" b (:e qn) (merge (written-name p qn) {:referencedDecl {:name (:s lp)}}))
          :else
          (do
          ;; (cpp-diag-b, 2026-11-22: an id-expression's nested-name-specifier whose first name no lookup finds and the main file
          ;; declares nowhere, as a declaration's type's (parse-decl-specs*): GCC's "'X' has not been declared", std's members
          ;; "'cout' is not a member of 'std'", at the name)
          (let [f (first (:parts qn)) s2 (second (:parts qn))]
            (when (and *full-headers* (not (skim? p)) (> (count (:parts qn)) 1) (not (:g qn)) (:s f) (not (:args f)) (:i f)
                       (main-tok? p (long (:i f))) (nil? (lookup (scope p) (:s f))) (not (declared-in-main? p (:s f))))
              (if (= "std" (:s f))
                (when (and (:s s2) (:i s2) (not (and (= "align_val_t" (:s s2)) (>= (.-year p) 2017))))
                  (soft-diag! p (long (:i s2)) (str "'" (:s s2) "' is not a member of 'std'")))
                (soft-diag! p (long (:i f)) (str "'" (:s f) "' has not been declared")))))
          (node p "DeclRefExpr" b (:e qn) (merge (written-name p qn)
                                          {:_ent en
                                           :_this (boolean (and (= 1 (count (:parts qn))) (not (:g qn)) (:s lp)
                                                                (or (= :var (:k en))
                                                                    (and (= :fn (:k en))
                                                                         (not (and (or (in-template? p) (dep-this? p)) (or (:ovl en) (:tmpl en))))))
                                                                (in-body-member? p (:s lp))))
                                           :_mfn (when (and (= :fn (:k en)) (= 1 (count (:parts qn))) (not (:g qn)) (:s lp) (or (in-template? p) (dep-this? p))
                                                            (class-member? p (:s lp)))
                                                   en)
                                           :_objdep (dep-this? p)
                                           ;; cpp-read (2026-11-22): a type's name where an expression's primary stands, no ( or { after
                                           ;; it for a functional cast ([expr.prim.id]/1: an id-expression names no type): GCC's
                                           ;; "expected primary-expression before X" (arbace.repr.cpp.diag/type-exprs over the final
                                           ;; tree, so a tentative parse's leaves none): the name's offset and the next token
                                           :_typex (when (and (type-ent? en) (:s lp) (not (:args lp)) (main-tok? p b) (not (skim? p)))
                                                     [(.-o (tok-at p b)) (ts (cur p))])
                                           ;; CX12: an unqualified name no lookup finds, not in a class template's member (Sema's
                                           ;; ActOnIdExpression -> DiagnoseEmptyLookup, "use of undeclared identifier"; a call's
                                           ;; ADL decided by arbace.repr.cpp.check over the final tree; a __ name judged there by
                                           ;; clang's identifier table, CP270 (a)): the name token's offset
                                           :_undecl (when (and (nil? en) (= 1 (count (:parts qn))) (not (:g qn)) (:s lp) (not (:args lp))
                                                               (main-tok? p b) (not (contains? *fn-names* (:s lp)))
                                                               ;; (cpp-read, 2026-11-22: in a class template's member too, when
                                                               ;; no base may be dependent, dep-bases?;
                                                               ;; a nested class's member aside: its enclosing class's later members,
                                                               ;; which [class.mem.general]/7 shows it, are not in the parser's scopes)
                                                               (or (not (dep-this? p)) (and (not (dep-bases? p)) (<= (count (stv p CLS)) 1))))
                                                      [(.-o (tok-at p b)) (:s lp) (boolean (in-template? p))])
                                           :referencedDecl {:name (or (:s lp) (when (:op lp) (if (re-find #"^[a-z]" (:op lp)) (str "operator " (:op lp)) (str "operator" (:op lp))))
                                                                ;; (queue 492: a literal operator's id, [over.literal]/1, as clang
                                                                ;; names it)
                                                                (when (:lit lp) (str "operator\"\"" (:lit lp))) "")}})))))
      :else (perr p "an expression"))))

(defn- member-node [^P p base arrow]
  (adv! p)
  (let [qn (or (parse-name p :parse true) (perr p "a member name"))
        lp (peek (:parts qn))
        nm (cond (:s lp) (:s lp) (:dtor lp) (str "~" (:dtor lp)) (:op lp) (str "operator" (:op lp)) :else "")
        ;; the member function it names, for an unresolved call (unresolved-call)
        [mfn dep] (when (and (:s lp) (or (in-template? p) (dep-this? p)) (= 1 (count (:parts qn))))
                    (if (= "CXXThisExpr" (:kind base))
                      (let [e (lookup (scope p) (:s lp))] (when (and (= :fn (:k e)) (class-member? p (:s lp))) [e (dep-this? p)]))
                      (when-let [[ce d] (object-class p base arrow)]
                        (let [e (sc/find-in (:scope ce) (:s lp))] (when (= :fn (:k e)) [e d])))))]
    ;; (round 54, second pass: [expr.ref]/3, the object expression of `.` has a complete class type: a variable whose class is
    ;; still only declared, GCC's "'a' has incomplete type" at the variable's declaration)
    (when (and (not arrow) (= "DeclRefExpr" (:kind base)))
      (when-let [ve (lookup (scope p) (str (get-in base [:referencedDecl :name])))]
        (when (and (= :var (:k ve)) (:vat ve) (= :n (:t (:ty ve))) (:class (:ent (:ty ve))))
          (when-let [ce (lookup (scope p) (str (:name (:ent (:ty ve)))))]
            (when (and (:incomplete ce) (:class ce) (= (:at ce) (:at (:ent (:ty ve)))))
              (soft-diag! p (long (:vat ve)) (str "'" (get-in base [:referencedDecl :name]) "' has incomplete type")))))))
    (node p "MemberExpr" (nb base) (:e qn)
          (cond-> (merge (written-name p qn) {:name nm :isArrow arrow :inner [base]})
            mfn (assoc :_mfn mfn :_objdep dep)
            ;; a member of a type-dependent object that no class of the current instantiation has: clang's
            ;; CXXDependentScopeMemberExpr (Sema::ActOnMemberAccessExpr, ActOnDependentMemberExpr)
            (and (nil? mfn) (:s lp) (= 1 (count (:parts qn))) (type-dependent? p base)
                 (if (= "CXXThisExpr" (:kind base))
                   (not (class-member? p (:s lp)))
                   (not (when-let [[ce _] (object-class p base arrow)] (and (:scope ce) (sc/find-in (:scope ce) (:s lp)))))))
            (assoc :_depscope true)))))

(defn parse-postfix [^P p x]
  (loop [x x]
    (cond
      (is? p "[") (if (is-at? p 1 "[")
                    x
                    (do (adv! p)
                        ;; (CP338 (a): C++23's multidimensional subscript, P2128R6: `a[]` and `a[i, j, k]` an operator[] call of
                        ;; that many arguments, [expr.sub]/1's expression-list; before C++23 the comma is the comma operator)
                        (if (>= (long (.-year p)) 2023)
                          (let [is (with-gt p true
                                     (if (is? p "]") []
                                         (loop [out [(if (is? p "{") (parse-braced-init p) (parse-assign-expr p))]]
                                           (if (accept! p ",") (recur (conj out (if (is? p "{") (parse-braced-init p) (parse-assign-expr p)))) out))))]
                            (expect! p "]")
                            (recur (node p "ArraySubscriptExpr" (nb x) (last-ix p) (cond-> {:inner (into [x] is)} (not= 1 (count is)) (assoc :_multi true)))))
                          (let [i (with-gt p true (if (is? p "{") (parse-braced-init p) (parse-expr p)))]
                            (expect! p "]")
                            (recur (node p "ArraySubscriptExpr" (nb x) (last-ix p) {:inner [x i]}))))))
      (is? p "(") (let [as (call-args p x (paren-args p))] (recur (node p "CallExpr" (nb x) (last-ix p) {:inner (into [(sync-builtin p (unresolved-call p x as) as)] as)})))
      (is? p ".") (recur (member-node p x false))
      (is? p "->") (recur (member-node p x true))
      (or (is? p "++") (is? p "--")) (let [op (ts (cur p))] (adv! p) (recur (node p "UnaryOperator" (nb x) (last-ix p) {:opcode op :isPostfix true :inner [x]})))
      :else x)))

(def ^:private unary-ops #{"*" "&" "+" "-" "!" "~" "++" "--"})

(defn- cast-operand-start?
  "The cursor can start a cast-expression (what follows an ambiguous parenthesized type-id decides it is a cast)."
  [^P p]
  (let [^T t (cur p) k (.-k t) s (.-s t)]
    (cond
      (#{:id :num :str :chr :udls :udlc} k) true
      (identical? k :kw) (not (contains? #{"else" "case" "default" "return" "throw"} s))
      (identical? k :punct) (contains? #{"(" "*" "&" "+" "-" "!" "~" "++" "--" "::" "[" "&&"} s)
      :else false)))

(declare type-attrs! attr-nodes)

(defn- parse-new [^P p ^long b global]
  (adv! p) ; new
  (let [paren-type? (fn [] (and (is? p "(") (let [save (ix p)] (adv! p) (let [r (is-type-id? p :paren)] (seek! p save) r))))
        ;; (h-cpp-read: a new-placement is an expression-list, not empty, [expr.new]/1: GCC's "expected expression-list or
        ;; type-id")
        _ (when (and (is? p "(") (is-at? p 1 ")")) (soft-diag! p (inc (ix p)) "expected expression-list or type-id"))
        place (when (and (is? p "(") (not (paren-type?))) (paren-args p))
        ;; the allocated type: (type-id) or a new-type-id with its array bounds
        [ty dims] (if (paren-type?)
                    (do (adv! p) (let [t (binding [*tdef-ctx* "in a new-expression"] (parse-type-id p :paren))] (expect! p ")") [t []]))
                    (let [_ (when-let [bi (and (not (skim? p)) (def-brace p (ix p)))]
                              ;; (queue 377: [expr.new]/2 with [dcl.type.general]/3, a new-type-id defines no class or enumeration:
                              ;; GCC's "types may not be defined in a new-type-id", at the definition's brace)
                              (soft-diag! p bi "types may not be defined in a new-type-id"))
                          base (parse-type-specs p :new)
                          ptrs (loop [t base] (cond (or (is? p "*") (is? p "&") (is? p "&&"))
                                                    (let [o (ts (cur p))] (adv! p)
                                                      (let [c (accept! p "const") v (accept! p "volatile")]
                                                        (recur (with-cv {:t (case o "*" :p "&" :lr "&&" :rr) :of t} c v))))
                                                    :else t))
                          dims (loop [ds []] (cond
                                               ;; (cpp-read, 2026-11-22: a noptr-new-declarator's attribute-specifier-seq after each
                                               ;; ] , [expr.new]/1)
                                               (and (seq ds) (is? p "[") (is-at? p 1 "[")) (do (if (= 1 (count ds)) (attr-nodes p) (type-attrs! p)) (recur ds))
                                               (is? p "[")
                                               ;; (h-cpp-read: only the first bound may be omitted, [expr.new]/1's
                                               ;; noptr-new-declarator: GCC's "expected primary-expression")
                                               (do (when (and (seq ds) (is-at? p 1 "]")) (soft-diag! p (inc (ix p)) "expected primary-expression before ']' token"))
                                                   (adv! p) (let [x (with-gt p true (if (is? p "]") nil (parse-expr p)))] (expect! p "]") (recur (conj ds x))))
                                               :else ds))]
                      [ptrs dims]))
        arr (seq dims)
        elem (reduce (fn [t d] {:t :a :n (when d (tok-text p (nb d) (ne d))) :of t}) ty (reverse (rest dims)))
        init (cond (is? p "(") (let [ab (ix p) as (paren-args p)]
                                 [(cond (= 1 (count as)) (first as)
                                        (and (empty? as) (not (class-type? ty))) {:kind "ImplicitValueInitExpr"}
                                        :else (node p "ParenListExpr" ab (last-ix p) {:inner as}))
                                  "call"])
                   (is? p "{") [(parse-braced-init p) "list"]
                   :else nil)
        ;; (cpp-read, 2026-11-22: before C++20 an array's new-initializer is ( ) or a braced-init-list, P0960 allowing an
        ;; expression-list: GCC's build_new_1 "parenthesized initializer in array new", at the new-expression; the allocated type
        ;; an array by its bounds, a parenthesized type-id or a typedef-name; not in a template, checked at its instantiation)
        _ (when (and init (= "call" (second init)) (not= "ImplicitValueInitExpr" (:kind (first init))) (< (.-year p) 2020)
                     (not (skim? p)) (main-tok? p b) (not (in-template? p))
                     (or arr (loop [t ty n 0] (cond (= :a (:t t)) true
                                                    (and (= :n (:t t)) (:ty (:ent t)) (< n 8)) (recur (:ty (:ent t)) (inc n))
                                                    :else false))))
            (soft-diag! p b "parenthesized initializer in array new"))
        ;; (round 54, sixth pass: [expr.new]/2 with [dcl.type.auto.deduct]/2.2, a placeholder allocated type deduces from a
        ;; new-initializer of one assignment-expression: GCC's "initialization of new-expression for type 'auto' requires
        ;; exactly one element", at the initializer)
        _ (when (and init (= :auto (:t ty)) (nil? (:cn ty)) (not arr) (not (skim? p)))
            (let [x (first init)
                  n (cond (= "ParenListExpr" (:kind x)) (count (:inner x))
                          (= "list" (second init)) (count (:inner x))
                          :else 1)]
              (when (not= 1 n)
                (soft-diag! p (long (or (:_b x) (ix p))) "initialization of new-expression for type 'auto' requires exactly one element"))))
        e (last-ix p)
        ;; `new A` calling A's operator new(size_t, double = 0.0): the default argument is the call's (implicit)
        nd (when (and (empty? place) (not global)) (some-> (sema/class-ent ty) sema/info (.get :new-dflt)))
        place (if nd (vec (repeat (dec (long nd)) {:kind "CXXDefaultArgExpr"})) place)
        np (count place)]
    (node p "CXXNewExpr" b e
          (cond-> {:type {:qualType (qt {:t :p :of elem})} :valueCategory "prvalue"
                   :inner (vec (concat (when arr (when-let [d (first dims)] [d])) (when init [(first init)]) place))}
            arr (assoc :isArray true)
            init (assoc :initStyle (second init))
            place (assoc :isPlacement true :operatorNewDecl {:type {:qualType (str "void *(unsigned long" (apply str (repeat np ", void *")) ")")}})
            global (assoc :isGlobal true)))))

(defn parse-cast-expr [^P p]
  (let [^T t (cur p) s (.-s t) b (ix p)]
    (cond
      (and (t= t "(") (not (is-at? p 1 "{"))
           (let [save (ix p)]
             (adv! p)
             (let [r (type-id-kind p :paren)]
               (seek! p save)
               (case r
                 :true true
                 :false false
                 ;; ParseCXXAmbiguousParenExpression: a cast when a cast-expression follows the ), else an expression
                 (let [_ (skip-balanced! p)
                       ok (and (cast-operand-start? p)
                               (not (and (or (is? p "++") (is? p "--")) (not (let [_ (adv! p)] (cast-operand-start? p))))))]
                   (seek! p save) ok)))))
      (do (adv! p)
          (let [ty (binding [*tdef-ctx* "in casts"] (parse-type-id p :cast))
                ;; (h-cpp-read: a cast's type-id holds no placeholder type, [dcl.spec.auto.general]/5: GCC's "expected
                ;; primary-expression")
                _ (when (some #(= :auto (:t %)) (tree-seq map? (comp vector :of) ty))
                    (soft-diag! p (inc b) (str "expected primary-expression before '" (ts (tok-at p (inc b))) "'")))]
            (expect! p ")")
            (if (is? p "{")
              (let [l (parse-braced-init p)] (node p "CompoundLiteralExpr" b (ne l) (assoc (type-node-fields ty) :inner [l])))
              (let [x (parse-cast-expr p)] (cast-node p "CStyleCastExpr" b ty x)))))
      (and (identical? :punct (.-k t)) (contains? unary-ops s))
      (do ;; (round 54, sixth pass: [class.dtor]/? (C++23 /14), a destructor's address is not taken: `&X::~X` is GCC's "taking
          ;; address of destructor", at the operator)
          (when (and (= s "&") (not (skim? p)))
            (loop [j (inc (ix p)) q 0]
              (let [^T u (tok-at p j)]
                (cond (t= u "::") (recur (inc j) (inc q))
                      (identical? :id (.-k u)) (recur (inc j) q)
                      (and (t= u "~") (pos? q) (identical? :id (tk (tok-at p (inc j)))) (not (t= (tok-at p (+ j 2)) "(")))
                      (soft-diag! p (ix p) (str "taking address of destructor '" (tok-text p (inc (ix p)) (inc j)) "'"))
                      :else nil))))
          (adv! p) (let [x (parse-cast-expr p)] (node p "UnaryOperator" b (ne x) {:opcode s :isPostfix false :inner [x]})))
      (and (t= t "&&") (identical? :id (tk (nxt p 1))))
      (do (adv! p) (adv! p) (assoc (text-node p "AddrLabelExpr" b) :_label (ts (tok-at p (inc b)))))
      (t= t "sizeof")
      (do (adv! p)
          (cond
            (is? p "...") (do (adv! p) (expect! p "(") (let [nm (ts (cur p))] (adv! p) (expect! p ")") (node p "SizeOfPackExpr" b (last-ix p) {:name nm})))
            (and (is? p "(") (let [save (ix p)] (adv! p) (let [r (is-type-id? p :paren)] (seek! p save) r)))
            (do (adv! p)
                ;; (queue 365: round 54's [temp.variadic]/5 check of `sizeof(T)` for a pack T removed: it fired inside the pattern of
                ;; an expansion too, `(sizeof(Ts) + ...)`, `f(sizeof(Ts)...)`, valid code; the parser does not know the enclosing
                ;; expansion here)
                (let [ty (binding [*tdef-ctx* "in 'sizeof' expressions"] (parse-type-id p :paren))] (expect! p ")") (node p "UnaryExprOrTypeTraitExpr" b (last-ix p) {:name "sizeof" :argType {:qualType (qt ty)}})))
            :else (let [x (parse-cast-expr p)] (node p "UnaryExprOrTypeTraitExpr" b (ne x) {:name "sizeof" :inner [x]}))))
      (or (t= t "alignof") (t= t "_Alignof") (t= t "__alignof") (t= t "__alignof__"))
      (let [nm (if (#{"alignof" "_Alignof"} s) "alignof" "__alignof")]
        (adv! p)
        (if (and (is? p "(") (let [save (ix p)] (adv! p) (let [r (is-type-id? p :paren)] (seek! p save) r)))
          (do (adv! p) (let [ty (binding [*tdef-ctx* (str "in '" s "' expressions")] (parse-type-id p :paren))] (expect! p ")") (node p "UnaryExprOrTypeTraitExpr" b (last-ix p) {:name nm :argType {:qualType (qt ty)}})))
          (let [x (parse-cast-expr p)] (node p "UnaryExprOrTypeTraitExpr" b (ne x) {:name nm :inner [x]}))))
      (and (t= t "noexcept") (is-at? p 1 "("))
      (do (adv! p) (adv! p)
          (let [ob (ix p) x (with-gt p true (parse-expr p))]
            ;; (cpp-s15: the operand kept for the code generator by its text, as a noexcept-specifier's is: a noexcept-expression
            ;; in a template argument the code generator evaluates from its text, <type_traits>' __is_nothrow_new_constructible_impl's
            ;; base `__bool_constant<noexcept(::new(std::declval<void*>()) _Tp(std::declval<_Args>()...))>`)
            (when (and *full-headers* (not (skim? p)) (map? x) (> (ix p) ob))
              (.put ^HashMap (stv p DECLTYPES) (str "noexcept-expr:" (str/replace (tok-text p ob (dec (ix p))) #"\s+" "")) x))
            (expect! p ")") (node p "CXXNoexceptExpr" b (last-ix p) {:inner [x]})))
      (t= t "new") (parse-new p b false)
      (and (t= t "::") (is-at? p 1 "new")) (do (adv! p) (parse-new p b true))
      (or (t= t "delete") (and (t= t "::") (is-at? p 1 "delete")))
      (let [global (when (t= t "::") (adv! p) true)]
        (adv! p)
        (let [arr (when (and (is? p "[") (is-at? p 1 "]")) (adv! p) (adv! p) true)
              x (parse-cast-expr p)]
          (node p "CXXDeleteExpr" b (ne x) (cond-> {:inner [x]} arr (assoc :isArrayAsWritten true) global (assoc :isGlobal true)))))
      (t= t "co_await") (do (adv! p) (let [x (parse-cast-expr p)] (node p "CoawaitExpr" b (ne x) {:inner [x]})))
      (or (t= t "__extension__") (t= t "__real") (t= t "__real__") (t= t "__imag") (t= t "__imag__"))
      (let [op (case s ("__real" "__real__") "__real" ("__imag" "__imag__") "__imag" "__extension__")]
        (adv! p) (let [x (parse-cast-expr p)] (node p "UnaryOperator" b (ne x) {:opcode op :isPostfix false :inner [x]})))
      :else (parse-postfix p (parse-primary p)))))

;; ---------------------------------------------------------------------------------------------
;; Statements (clang's ParseStmt.cpp)

(declare parse-block-decl parse-condition-decl block-decl-start? parse-for-range-decl attr-nodes parse-catch-param)

(def ^:private none {})

(def ^:private debug? (boolean (System/getenv "REPR_CPP_NATIVE_DEBUG")))

(defn- decline!
  "A main-file construct the parser declines, counted by `why`; CX12: the token it failed at (`at`, the failure's
  index: ex-data's :at, else the construct's first token `b`) kept with the reason as the construct's syntax error, at
  that token's offset when it is the main file's (else at the construct's first token: a macro's or header's token)."
  ([^P p ^String why] (decline! p why nil nil))
  ([^P p ^String why at b]
   (st! p DECLINES (inc (long (stv p DECLINES))))
   (let [^HashMap m (stv p REASONS)] (.put m why (inc (long (or (.get m why) 0)))))
   (when-let [^ArrayList d (stv p DIAGS)]
     (let [i (long (or at b 0))
           i (if (main-tok? p i) i (long (or b i)))
           ^T t (tok-at p i)
           ;; cpp-read (2026-11-22): a missing ) ] ; , or : is placed after the previous token, as GCC's cp_parser_error_1 places
           ;; its "expected" (c-family's maybe_suggest_missing_token_insertion, MTIK_INSERT_AFTER_PREV: the fix-it's location the
           ;; diagnostic's), on that token's line when the next token is on another
           ^T pv (when (and (pos? i) (re-find #"^(?:(?:statement|declaration): )?expected [;)\],:]$" why)) (tok-at p (dec i)))
           o (if (and pv (= (.-f pv) (.-f t)) (main-tok? p (dec i))) (+ (.-o pv) (max 0 (dec (.-n pv))))
               (or (when (and (identical? :eof (.-k t)) (.-src p) (<= (.-o t) (.length ^String (.-src p))))
                     ;; (cpp-read, 2026-11-22: GCC places an error at the end of input at the previous token, and a #pragma the
                     ;; front end handles is tokens to it (CPP_PRAGMA ... CPP_PRAGMA_EOL), libcpp's own pragmas not: a last such
                     ;; pragma after the main file's last token is the place, its line's end, nsdmi-defer7.C)
                     (let [m (re-matcher #"(?m)^[ \t]*#[ \t]*pragma[ \t]+(\w+)(?:[ \t]+(\w+))?[^\n]*" (subs (.-src p) (.-o t)))]
                       (loop [last nil]
                         (if (.find m)
                           (recur (if (or (#{"once" "push_macro" "pop_macro"} (.group m 1))
                                          (and (= "GCC" (.group m 1)) (#{"system_header" "poison" "dependency" "warning" "error"} (.group m 2))))
                                    last (+ (.-o t) (.end m))))
                           last))))
                   (.-o t)))]
       (.add d [o why (.-s t)])))))

;; (round 54, third pass) Whether the file declares an explicit or partial specialization of the class template `nm`: a
;; class-key, the name and a template argument list not followed by ::
(defn- class-specialized? [^P p ^String nm]
  (let [n (.-cnt p)]
    (boolean
      (some (fn [i]
              (when (and (#{"class" "struct" "union"} (ts (tok-at p i))) (= nm (ts (tok-at p (inc i)))) (= "<" (ts (tok-at p (+ i 2)))))
                (let [j (loop [j (+ i 3) d 1]
                          (cond (>= j n) nil
                                (= "<" (ts (tok-at p j))) (recur (inc j) (inc d))
                                (= ">" (ts (tok-at p j))) (if (= d 1) j (recur (inc j) (dec d)))
                                (= ">>" (ts (tok-at p j))) (if (<= d 2) j (recur (inc j) (- d 2)))
                                :else (recur (inc j) d)))]
                  (and j (not= "::" (ts (tok-at p (inc j))))))))
            (range (max 0 (- n 3)))))))

(defn- qualified-at?
  "Whether the declaration's name at source offset `o` is written qualified: a :: token before it after token `b`."
  [^P p ^long b ^long o]
  (boolean (some #(and (= "::" (ts (tok-at p %))) (let [^T t (tok-at p (inc %))] (= o (.-o t)))) (range b (+ b 64)))))

(defn- soft-diag!
  "CX12, CP282 (a): a main-file error the grammar diagnoses without declining the construct (the parse goes on, the tree
  unchanged: an attribute's rules), at token `i`."
  [^P p ^long i ^String why]
  (when-let [^ArrayList d (stv p DIAGS)]
    (when (main-tok? p i)
      (let [^T t (tok-at p i)] (.add d [(.-o t) why (.-s t)])))))

(defn- pedantic-diag!
  "CP338 (a): a main-file diagnostic GCC gives as a pedwarn (an error under -pedantic-errors alone), the construct taken:
  kept as a syntax error whose reason starts `pedantic: `, which arbace.repr.cpp.diag/diagnose drops without -pedantic-errors."
  [^P p ^long i ^String why]
  (soft-diag! p i (str "pedantic: " why)))

(defn- decl-comma!
  "h-cpp-read: the `,` between a declaration's declarators, consumed (true) or not there; a `;` after it is no declarator
  ([dcl.decl]/1's init-declarator-list): GCC's \"stray ',' at end of member declaration\" (\"expected unqualified-id\" at
  namespace scope), the declaration taken."
  [^P p]
  (when (accept! p ",")
    (when (or (is? p ";") (is? p ","))
      (soft-diag! p (ix p) (if (class-ctx p) "stray ',' at end of member declaration" "expected unqualified-id before ';' token")))
    true))

(defn- delete-reason!
  "h-cpp-read: C++26's `= delete ( unevaluated-string )` (P2573R2, [dcl.fct.def.delete]/1) at its `(`: a string-literal
  without an encoding prefix, then `)`, as GCC's cp_parser_function_definition_after_declarator checks it (\"expected
  string-literal\", \"a wide string is invalid in this context\", \"expected ')'\"); past an error the tokens to the `)` or
  the `;` skipped, the deletion taken."
  [^P p]
  ;; (cpp-diag-b, round 2: before C++26 GCC's pedwarn "'delete' reason only available with -std=c++2c or -std=gnu++2c", at the `(`)
  (when (and (< (.-year p) 2026) (not (skim? p)) (main-tok? p (ix p)))
    (pedantic-diag! p (ix p) "'delete' reason only available with -std=c++2c or -std=gnu++2c"))
  (adv! p)
  (if (identical? :str (tk (cur p)))
    (do (when (re-find #"^(u8|u|U|L)" (ts (cur p))) (soft-diag! p (ix p) "a wide string is invalid in this context"))
        (while (identical? :str (tk (cur p))) (adv! p))
        (when-not (accept! p ")")
          (soft-diag! p (ix p) (str "expected ')' before '" (ts (cur p)) "'"))
          (skip-until! p #{";"})))
    (do (soft-diag! p (ix p) (str "expected string-literal before '" (ts (cur p)) "'"))
        (loop [d 0]
          (let [^T t (cur p)]
            (cond (identical? :eof (.-k t)) nil
                  (and (zero? d) (t= t ";")) nil
                  (and (zero? d) (t= t ")")) (adv! p)
                  (or (t= t "(") (t= t "[") (t= t "{")) (do (adv! p) (recur (inc d)))
                  (or (t= t ")") (t= t "]") (t= t "}")) (do (adv! p) (recur (dec d)))
                  :else (do (adv! p) (recur d))))))))

(defn- parse-asm-parts
  "CP338 (a): an asm statement from its keyword to its `)`: {:volatile :inline :goto :template S :outputs [[name constraint]]
  :inputs [...] :clobbers [S] :labels [S] :inner [output operands..., input operands...]} (the strings' values as the
  literal's node gives them, quoted). Throws (a perr) on what it does not parse."
  [^P p]
  (adv! p)
  (let [qs (loop [qs #{}]
             (let [s (ts (cur p))]
               (if (#{"volatile" "__volatile__" "__volatile" "inline" "__inline__" "__inline" "goto"} s)
                 (let [q (case s ("volatile" "__volatile__" "__volatile") :volatile ("inline" "__inline__" "__inline") :inline :goto)]
                   ;; (CX12, cpp-s2: a qualifier given twice is an error, GCC's and clang's "duplicate asm qualifier";
                   ;; the statement is taken, g++.dg's asm-qual-2.C)
                   (when (contains? qs q) (soft-diag! p (ix p) (str "duplicate asm qualifier '" s "'")))
                   (adv! p) (recur (conj qs q)))
                 qs)))
        _ (expect! p "(")
        lit (fn [] (if (identical? :str (tk (cur p))) (:value (parse-string-literal p)) (perr p "an asm string")))
        ;; (h-cpp-read: the template is a string-literal, or C++26's parenthesized constant expression (GCC's constexpr asm):
        ;; GCC's "expected string-literal" else, before the statement is skipped)
        _ (when-not (or (identical? :str (tk (cur p))) (is? p "(")) (soft-diag! p (ix p) "expected string-literal"))
        tmpl (lit)
        ;; the sections' separators: `:` each, `::` two
        colons (atom 0)
        sep! (fn [] (cond (and (pos? (long @colons)) (swap! colons dec)) true
                          (is? p "::") (do (adv! p) (reset! colons 1) true)
                          (is? p ":") (do (adv! p) true)
                          :else false))
        section (fn [one] (if (or (is? p ")") (is? p ":") (is? p "::") (pos? (long @colons))) []
                            (loop [out [(one)]] (if (accept! p ",") (recur (conj out (one))) out))))
        operand (fn [] (let [nm (when (accept! p "[")
                                  ;; (cpp-diag-b, round 2: an asm operand's symbolic name is an identifier, its constraint a
                                  ;; string-literal: GCC's "expected identifier before numeric constant", "expected string-literal")
                                  (when-not (identical? :id (tk (cur p))) (soft-diag! p (ix p) (str "expected identifier before '" (ts (cur p)) "'")))
                                  (let [s (ts (cur p))] (adv! p) (expect! p "]") s))
                             _ (when-not (identical? :str (tk (cur p))) (soft-diag! p (ix p) (str "expected string-literal before '" (ts (cur p)) "'")))
                             c (lit)
                             _ (expect! p "(")
                             x (parse-expr p)]
                         (expect! p ")")
                         [nm c x]))
        outs (if (sep!) (section operand) [])
        ins (if (sep!) (section operand) [])
        clob (if (sep!) (section lit) [])
        labels (if (sep!) (section (fn [] (let [s (ts (cur p))] (adv! p) s))) [])]
    (when (pos? (long @colons)) (perr p "an asm section"))
    (expect! p ")")
    {:volatile (boolean (:volatile qs)) :inline (boolean (:inline qs)) :goto (boolean (:goto qs)) :template tmpl
     :outputs (mapv (fn [[n c _]] [n c]) outs) :inputs (mapv (fn [[n c _]] [n c]) ins) :clobbers clob :labels labels
     :inner (vec (concat (map #(nth % 2) outs) (map #(nth % 2) ins)))}))

(defn- skip-rec!
  "Recovery (cpp-read, 2026-11-22): the cursor on an opener ( [ { after its closer, as GCC's recovery skips (the braces nest,
  cp_parser_skip_to_end_of_statement's depth; a parenthesis yields to them): an unclosed ( or [ ends before a } or another
  closer of its level (and before a ; there unless `semis`: a statement's for, if or switch header holds them), an unclosed {
  at the end; true when its closer was consumed."
  [^P p semis]
  (let [open (ts (cur p))
        close ({"(" ")" "[" "]" "{" "}"} open)
        brace? (= open "{")]
    (adv! p)
    (loop []
      (let [^T t (cur p)]
        (cond
          (identical? :eof (.-k t)) false
          (t= t close) (do (adv! p) true)
          (and (not brace?) (or (t= t "}") (t= t ")") (t= t "]") (and (not semis) (t= t ";")))) false
          (and brace? (or (t= t ")") (t= t "]"))) (do (adv! p) (recur))
          ;; (an initializer's braces, `semis` :init: a ; at their level ends them, the } missing, as GCC's braced-init-list
          ;; requires its } there and the declaration goes on)
          (and brace? (= semis :init) (t= t ";")) false
          (or (t= t "(") (t= t "[") (t= t "{")) (do (skip-rec! p (if (= semis :init) true semis)) (recur))
          :else (do (adv! p) (recur)))))))

(defn- skip-statement!
  "The cursor from a statement's first token `b` to after its end: its ; at depth 0, or the } closing a block it opened
  (an else, catch or while after it continuing it; a class, enum or typedef's declarators after its body), stopping before
  the } of the enclosing block. The decline's last token: [last-token-index consumed-semicolon?]. cpp-read (2026-11-22): the
  nested groups skipped by skip-rec!, an unclosed parenthesis yielding to the enclosing block's } (it ran to the file's end)."
  [^P p ^long b]
  (seek! p b)
  (let [classy (contains? #{"class" "struct" "union" "enum" "typedef"} (ts (cur p)))]
    (loop []
      (let [^T t (cur p)]
        (cond
          (identical? :eof (.-k t)) [(last-ix p) false]
          (t= t ";") (let [e (last-ix p)] (adv! p) [e true])
          (t= t "}") [(last-ix p) false]
          (t= t "{") (do (skip-rec! p (if (and (not classy) (> (ix p) b)
                                               (let [^T pv (tok-at p (dec (ix p)))]
                                                 (or (t= pv "=") (t= pv ",") (t= pv "(") (t= pv "return") (identical? :id (.-k pv)))))
                                        :init true))
                         (if (or classy (is? p "else") (is? p "catch") (is? p "while") (is? p ",") (is? p ")") (is? p ";"))
                           (recur)
                           [(last-ix p) false]))
          ;; (an unclosed [ yields to the statement's ; -- GCC's skip counts the braces alone, parse/error11.C; a ( holds them, a
          ;; for's header)
          (t= t "(") (do (skip-rec! p true) (recur))
          (t= t "[") (do (skip-rec! p false) (recur))
          (or (t= t ")") (t= t "]")) (do (adv! p) (recur))
          :else (do (adv! p) (recur)))))))

(defn- statement-or-decline [^P p]
  (let [b (ix p)]
    (try (parse-statement p)
         (catch arbace.lang.ExceptionInfo x
           (if (:cpp/parse (ex-data x))
             (let [_ (when debug? (binding [*out* *err*] (println "decline:" (ex-message x))))
                   [e _] (skip-statement! p b)]
               (if (main-tok? p b)
                 (decline! p (str "statement: " (:why (ex-data x))) (:at (ex-data x)) b)
                 (when (System/getenv "CPP_HDR_TRACE")
                   (binding [*out* *err*] (println "header statement decline:" (.-f (tok-at p b)) (.-o (tok-at p b)) (ex-message x)))))
               (node p "NativeDecline" b (max b (long e)) {}))
             (throw x))))))

(defn parse-compound-stmt [^P p]
  (let [b (ix p)]
    (expect! p "{")
    (with-scope p :block nil
      (with-gt p true
        (loop [out []]
          (cond (is? p "}") (do (adv! p) (node p "CompoundStmt" b (last-ix p) {:inner out}))
                (eof? p) (perr p "an unclosed block")
                ;; (cpp-read, 2026-11-22: an `else` in an if-statement's then-clause ends its statements, GCC's
                ;; cp_parser_statement_seq_opt; the `}` missing, "expected '}' before 'else'", the else the if's)
                (and *in-if* (is? p "else") (not (skim? p)))
                (do (soft-diag! p (ix p) "expected '}' before 'else'")
                    (node p "CompoundStmt" b (last-ix p) {:inner out}))
                :else (recur (conj out (binding [*sub-stmt* false] (statement-or-decline p))))))))))

(defn- sub-statement [^P p] (with-scope p :block nil (binding [*sub-stmt* true] (statement-or-decline p))))

(defn- condition
  "The parenthesized condition of an if, switch or while (the ( consumed, the ) not): [init var cond], init a
  statement node or nil, var a DeclStmt holding the condition's declaration or nil."
  [^P p can-init]
  (let [init (when can-init
               (case (condition-kind p true false)
                 :init-decl (parse-block-decl p)
                 :expr (let [save (ix p) x (parse-expr p)]
                         (if (is? p ";") (do (adv! p) x) (do (seek! p save) nil)))
                 nil))
        k (condition-kind p false false)]
    (if (= k :cond-decl)
      (let [v (parse-condition-decl p)] [init v {:kind "DeclRefExpr"}])
      [init nil (parse-expr p)])))

(defn- parse-if [^P p]
  (let [b (ix p)]
    (adv! p)
    (let [constexpr (accept! p "constexpr")
          neg (when (and (is? p "!") (is-at? p 1 "consteval")) (adv! p) true)]
      (if (accept! p "consteval")
        (let [a (binding [*in-if* true] (parse-compound-stmt p))
              ;; (cpp-diag-a: [stmt.if]/4, `if consteval`'s else branch is a compound-statement too: GCC's "'if consteval' requires
              ;; compound statement", at the statement)
              e (when (accept! p "else")
                  (let [ei (ix p) st (sub-statement p)]
                    (when-not (= "CompoundStmt" (:kind st)) (soft-diag! p ei "'if consteval' requires compound statement"))
                    st))]
          (node p "IfStmt" b (ne (or e a)) (cond-> {:isConsteval true :inner (if e [a e] [a])} e (assoc :hasElse true) neg (assoc :isNegatedConsteval true))))
        (with-scope p :block nil
          (expect! p "(")
          (let [[init var c] (with-gt p true (condition p true))]
            (expect! p ")")
            (let [a (binding [*in-if* true] (sub-statement p))
                  e (when (accept! p "else") (sub-statement p))]
              (node p "IfStmt" b (ne (or e a))
                    (cond-> {:inner (vec (concat (when init [init]) (when var [var]) [c a] (when e [e])))}
                      init (assoc :hasInit true) var (assoc :hasVar true) e (assoc :hasElse true) constexpr (assoc :isConstexpr true))))))))))

(defn- parse-for [^P p]
  (let [b (ix p)]
    (adv! p)
    (when (is? p "co_await") (perr p "for co_await"))
    (expect! p "(")
    (with-scope p :block nil
      (with-gt p true
        (let [k0 (if (is? p ";") :none (condition-kind p true true))
              init (case k0
                     :init-decl (parse-block-decl p)
                     :expr (let [x (parse-expr p)] (expect! p ";") x)
                     :none (do (adv! p) nil)
                     nil)
              range? (or (= k0 :for-range) (and init (not (is? p ";")) (not (is? p ")")) (= :for-range (condition-kind p false true))))]
          (if range?
            (let [lv (parse-for-range-decl p)
                  _ (expect! p ":")
                  r (if (is? p "{") (parse-braced-init p) (parse-expr p))
                  _ (expect! p ")")
                  s (binding [*in-if* false] (sub-statement p))]
              (node p "CXXForRangeStmt" b (ne s)
                    {:inner [(or init none) {:kind "DeclStmt" :inner [{:kind "VarDecl" :inner [r]}]} none none none none
                             {:kind "DeclStmt" :inner [lv]} s]}))
            (let [cv (when (and (not (is? p ";")) (= :cond-decl (condition-kind p false false))) (parse-condition-decl p))
                  c (cond cv {:kind "DeclRefExpr"} (is? p ";") none :else (parse-expr p))
                  _ (expect! p ";")
                  inc (if (is? p ")") none (parse-expr p))
                  _ (expect! p ")")
                  s (binding [*in-if* false] (sub-statement p))]
              (node p "ForStmt" b (ne s) {:inner [(or init none) (or cv none) c inc s]}))))))))

(declare try-rest)

(defn- parse-try [^P p ^long b]
  (adv! p)
  (try-rest p))

(defn- try-rest
  "A try-block's compound statement and handlers, the cursor after `try` (and, in a constructor's function-try-block, after its
  mem-initializers: [dcl.fct.def.general]/1's `try ctor-initializer? compound-statement handler-seq`): [body handlers]."
  [^P p]
  (let [body (parse-compound-stmt p)
        hs (loop [out []]
             (if (is? p "catch")
               (let [cb (ix p)
                     h (do (adv! p) (expect! p "(")
                           (with-scope p :block nil
                             (let [v (if (is? p "...")
                                       (do (adv! p) none)
                                       (let [[ty nm ni pb] (parse-catch-param p)]
                                         (cond-> {:kind "VarDecl" :type {:qualType (qt ty)} :loc (loc p ni) :range (rng p pb (max pb (dec (long ni))))}
                                           nm (assoc :name nm :range (rng p pb ni)))))]
                               (expect! p ")")
                               (let [c (parse-compound-stmt p)]
                                 (node p "CXXCatchStmt" cb (ne c) {:inner [v c]})))))]
                 (recur (conj out h)))
               out))]
    (when (empty? hs) (perr p "a try without a handler"))
    [body hs]))

(defn parse-statement [^P p]
  (let [^T t (cur p) b (ix p)]
    (cond
      (t= t "{") (parse-compound-stmt p)
      (t= t ";") (do (adv! p) (node p "NullStmt" b b {}))
      (t= t "if") (parse-if p)
      (t= t "switch")
      (do (adv! p) (expect! p "(")
          (with-scope p :block nil
            (let [[init var c] (with-gt p true (condition p true))]
              (expect! p ")")
              (let [s (binding [*in-if* false] (sub-statement p))]
                (node p "SwitchStmt" b (ne s) (cond-> {:inner (vec (concat (when init [init]) (when var [var]) [c s]))}
                                                init (assoc :hasInit true) var (assoc :hasVar true)))))))
      (t= t "while")
      (do (adv! p) (expect! p "(")
          (with-scope p :block nil
            (let [[_ var c] (with-gt p true (condition p false))]
              (expect! p ")")
              (let [s (binding [*in-if* false] (sub-statement p))]
                (node p "WhileStmt" b (ne s) (cond-> {:inner (if var [var c s] [c s])} var (assoc :hasVar true)))))))
      (t= t "do")
      (do (adv! p)
          (let [s (binding [*in-if* false] (sub-statement p))]
            ;; (cpp-read, 2026-11-22: a missing while: GCC's cp_parser_iteration_statement goes on requiring `( expression ) ;`,
            ;; its missing ) placed after the previous token, c-family's MTIK_INSERT_AFTER_PREV: an error there too, label2.C)
            (when (and (not (is? p "while")) (not (eof? p)) (not (skim? p)) (main-tok? p (last-ix p)))
              (soft-diag! p (last-ix p) (str "expected ')' before '" (ts (cur p)) "' token")))
            (expect! p "while") (expect! p "(")
            (let [c (with-gt p true (parse-expr p))]
              (expect! p ")")
              ;; (round 54, second pass: [stmt.iter.general]/1, `do statement while ( expression ) ;`: a missing ; is GCC's
              ;; "expected ';' before ..." at the ), the statement taken and the parse going on)
              (let [e (last-ix p)]
                (if (and (not (is? p ";")) (not (eof? p)) (not (skim? p)))
                  (soft-diag! p e (str "expected ';' before '" (ts (cur p)) "'"))
                  (expect! p ";"))
                (node p "DoStmt" b e {:inner [s c]})))))
      (t= t "for") (parse-for p)
      (t= t "return")
      (do (adv! p)
          (if (accept! p ";")
            (node p "ReturnStmt" b b {:inner []})
            (let [x (if (is? p "{") (parse-braced-init p) (parse-expr p))] (expect! p ";") (use-return! p x) (node p "ReturnStmt" b (ne x) {:inner [x]}))))
      (t= t "co_return")
      (do (adv! p)
          (if (accept! p ";")
            (node p "CoreturnStmt" b b {:inner []})
            (let [x (if (is? p "{") (parse-braced-init p) (parse-expr p))] (expect! p ";") (node p "CoreturnStmt" b (ne x) {:inner [x none]}))))
      ;; (cpp-gnu, 2026-11-22: GNU's local label declaration, the manual's "Locally Declared Labels": `__label__ L1, L2;` at a
      ;; block's beginning, clang's DeclStmt of LabelDecls)
      (t= t "__label__")
      (do (adv! p)
          (let [ls (loop [ls []]
                     (let [i (ix p)]
                       (when-not (id? p) (perr p "a label's name"))
                       (adv! p)
                       (let [ls (conj ls (node p "LabelDecl" i i {:name (ts (tok-at p i))}))]
                         (if (accept! p ",") (recur ls) ls))))]
            (expect! p ";")
            (node p "DeclStmt" b (last-ix p) {:inner ls})))
      (t= t "break") (do (adv! p) (expect! p ";") (node p "BreakStmt" b b {}))
      (t= t "continue") (do (adv! p) (expect! p ";") (node p "ContinueStmt" b b {}))
      (t= t "goto")
      (do (adv! p)
          (if (accept! p "*")
            ;; (cpp-gnu, 2026-11-22: GNU's computed goto, its operand kept, :_target, for arbace.repr.cpp.diag/labels-as-values)
            (let [x (parse-expr p)] (expect! p ";") (node p "IndirectGotoStmt" b (ne x) {:_target x}))
            ;; (cpp-rt-own: the label's name kept, `:label`, as the token gives it: a goto a macro writes, libcpp's expr.cc
            ;; `SYNTAX_ERROR (...)`'s `goto syntax_error`, has no text of its own at the expansion's location, from which the
            ;; analysis had read the name; clang's node names its target by declaration, targetLabelDeclId)
            (let [lt (cur p)] (adv! p) (let [e (last-ix p)] (expect! p ";") (node p "GotoStmt" b e (if (identical? :id (.-k lt)) {:label (.-s lt)} {}))))))
      (t= t "try") (let [[body hs] (parse-try p b)] (node p "CXXTryStmt" b (ne (peek hs)) {:inner (into [body] hs)}))
      (t= t "case")
      (do (adv! p)
          (let [v (with-gt p true (parse-cond-expr p))
                v2 (when (accept! p "...") (parse-cond-expr p))]
            (expect! p ":")
            (let [s (if (is? p "}") (node p "NullStmt" (last-ix p) (last-ix p) {}) (statement-or-decline p))]
              (node p "CaseStmt" b (ne s) {:inner (if v2 [v v2 s] [v s])}))))
      (and (t= t "default") (is-at? p 1 ":"))
      (do (adv! p) (adv! p) (let [s (if (is? p "}") (node p "NullStmt" (last-ix p) (last-ix p) {}) (statement-or-decline p))] (node p "DefaultStmt" b (ne s) {:inner [s]})))
      (and (identical? :id (.-k t)) (is-at? p 1 ":"))
      (do (adv! p) (adv! p)
          (let [attrs (attr-nodes p)
                ;; (cpp-read, 2026-11-22: P2324R2 lets a label end a compound statement, not stand for a selection or iteration
                ;; statement's sub-statement: GCC's "expected statement before '}' token" there)
                _ (when (and *sub-stmt* (is? p "}") (not (skim? p)) (main-tok? p (ix p)))
                    (soft-diag! p (ix p) "expected statement before '}' token"))
                s (if (is? p "}") (node p "NullStmt" (last-ix p) (last-ix p) {}) (statement-or-decline p))]
            (node p "LabelStmt" b (ne s) {:name (.-s t) :inner [s]})))
      ;; (cpp-read, 2026-11-22: `__extension__ [[...]] asm (...)`, GNU's keyword and the statement's attributes before an asm
      ;; statement, which GCC takes; gen-attrs-76.C)
      (and (t= t "__extension__") (is-at? p 1 "[") (is-at? p 2 "[")
           (let [save (ix p)] (adv! p) (attr-nodes p) (let [r (or (is? p "asm") (is? p "__asm__") (is? p "__asm"))] (seek! p save) r)))
      (do (adv! p) (attr-nodes p) (parse-statement p))
      (or (t= t "asm") (t= t "__asm__") (t= t "__asm"))
      ;; (CP338 (a): GNU's asm statement's parts for the code generator, clang's GCCAsmStmt: the qualifiers, the template,
      ;; the outputs' and inputs' constraints and operands, the clobbers and goto labels; in a header skimmed, or past
      ;; what is parsed here, the statement's tokens skipped as before)
      (let [a (when-not (skim? p) (try (parse-asm-parts p) (catch arbace.lang.ExceptionInfo _ (seek! p b) nil)))]
        (when-not a (skip-until! p #{";"}))
        (let [e (last-ix p)] (expect! p ";") (node p "GCCAsmStmt" b e (if a {:_asm (dissoc a :inner) :inner (:inner a)} {}))))
      (or (and (t= t "[") (is-at? p 1 "[")) (t= t "__attribute__") (and (t= t "__attribute") (is-at? p 1 "(")))
      (let [as (attr-nodes p)
            ;; (cpp-read, 2026-11-22: a label's attributes, [stmt.label]/1: deprecated appertains to no label
            ;; ([dcl.attr.deprecated]/2), GCC's "'deprecated' attribute ignored"; maybe_unused to no case or default label
            ;; ([dcl.attr.unused]/2), "'maybe_unused' on 'case' or 'default' label")
            _ (when (and (not (skim? p)) (main-tok? p b))
                (let [lbl (cond (or (is? p "case") (and (is? p "default") (is-at? p 1 ":"))) :case
                                (and (id? p) (is-at? p 1 ":")) :label)]
                  (when lbl
                    (doseq [i (range b (ix p))]
                      (let [^T t (tok-at p i) ^T pv (tok-at p (dec i))]
                        (when (and (or (t= pv "[") (t= pv ",")) (not (t= (tok-at p (inc i)) "::")))
                          (cond (= "deprecated" (.-s t)) (soft-diag! p i "'deprecated' attribute ignored")
                                (and (= "maybe_unused" (.-s t)) (= lbl :case)) (soft-diag! p i "'maybe_unused' on 'case' or 'default' label"))))))))]
        ;; (cpp-gnu, 2026-11-22: an attribute-specifier-seq before GNU's __label__, which declares local labels and takes none:
        ;; GCC's "expected ..." at the keyword, cpp0x/gen-attrs-76.C)
        (when (and (is? p "__label__") (> (ix p) b) (not (skim? p)))
          (soft-diag! p (ix p) "expected primary-expression before '__label__'"))
        (if (block-decl-start? p)
          ;; the attributes of a declaration: its declaration-specifiers' (from them again)
          (do (seek! p b) (parse-block-decl p))
          (let [sb (ix p)
                s (parse-statement p)
                ;; (cpp-gnu, 2026-11-22: GNU's musttail on a return statement, [[gnu::musttail]], [[clang::musttail]] or
                ;; __attribute__((musttail)): marked for arbace.repr.cpp.diag/musttail's rules)
                s (if (and (map? s) (= "ReturnStmt" (:kind s))
                           (some #(contains? #{"musttail" "__musttail__"} (ts (tok-at p %))) (range b sb)))
                    (assoc s :_musttail true)
                    s)]
            (if (seq as) (node p "AttributedStmt" b (ne s) {:inner (conj (vec as) s)}) s))))
      (block-decl-start? p) (parse-block-decl p)
      :else (let [x (parse-expr p)] (expect! p ";") x))))

;; ---------------------------------------------------------------------------------------------
;; Attributes: a node a written attribute, over its own tokens (the converter reads its text and what precedes it)

(defn- known-attr-ns? [^String s] (contains? #{"gnu" "clang" "__gnu__" "__clang__" "std" "msvc" "riscv"} s))

(def ^:private gnu-attrs
  "The GNU attribute names clang 23 knows (an unknown one it drops, with a warning: no node in its AST)."
    #{"aligned" "alloc_align" "alloc_size" "always_inline" "artificial" "assume_aligned" "cleanup" "cold" "common" "const"
    "constructor" "deprecated" "destructor" "diagnose_if" "error" "fallthrough" "flatten" "format" "format_arg" "gnu_inline"
    "hot" "ifunc" "init_priority" "interrupt" "leaf" "malloc" "may_alias" "mode" "naked" "no_instrument_function" "no_sanitize"
    "no_sanitize_address" "no_sanitize_thread" "no_sanitize_undefined" "no_split_stack" "no_stack_protector" "nocommon"
    "noinline" "nonnull" "noreturn" "nothrow" "packed" "patchable_function_entry" "pure" "regparm" "retain" "returns_nonnull"
    "returns_twice" "section" "sentinel" "target" "target_clones" "tls_model" "transparent_union" "unavailable" "unused" "used"
    "vector_size" "visibility" "warn_unused_result" "warning" "weak" "weakref" "zero_call_used_regs" "cdecl" "stdcall"
    "fastcall" "thiscall" "ms_abi" "sysv_abi" "abi_tag" "alias" "noderef" "nodebug" "designated_init" "enable_if"
    "overloadable" "annotate" "lifetimebound" "nodiscard" "uninitialized" "minsize" "optnone" "convergent" "noduplicate"
    "nomerge" "not_tail_called" "disable_tail_calls" "preserve_most" "preserve_all" "vectorcall" "regcall" "ext_vector_type"
    "address_space" "callback" "warn_unused" "maybe_unused" "standalone_debug" "trivial_abi" "no_destroy" "always_destroy"
    "require_constant_initialization" "internal_linkage" "exclude_from_explicit_instantiation" "no_builtin" "noescape"
    "nouwtype" "cpu_specific" "cpu_dispatch" "no_profile_instrument_function" "no_caller_saved_registers"
    "nocf_check" "force_align_arg_pointer" "no_speculative_load_hardening" "speculative_load_hardening" "objc_root_class"
    "availability" "flag_enum" "enum_extensibility" "pass_object_size" "format_matches" "counted_by" "sized_by" "guarded_by"
    "pt_guarded_by" "capability" "lockable" "scoped_lockable" "acquire_capability" "release_capability"
    "no_thread_safety_analysis" "noinit" "persistent" "strict_flex_arrays" "unsafe_buffer_usage" "using_if_exists"
    "btf_decl_tag" "btf_type_tag" "randomize_layout" "no_randomize_layout" "nonblocking" "nonallocating" "blocking"
    "allocating" "hybrid_patchable" "vecreturn" "matrix_type" "simd" "symver" "init_seg" "selectany" "dllimport"
    "dllexport" "thread" "nonnull_if_nonzero"})

(defn- known-gnu-attr? [^String s] (contains? gnu-attrs (str/replace s #"^__|__$" "")))

(def ^:private std-attrs
  #{"noreturn" "carries_dependency" "deprecated" "fallthrough" "likely" "unlikely" "maybe_unused" "nodiscard" "no_unique_address"
    "assume" "indeterminate" "optimize_for_synchronized" "noinline" "always_inline"})

(defn- unknown-gnu-attr!
  "CP294 (a): a GNU attribute clang does not know (it drops it, so the tree has no node for it), written in the main file,
  kept as data for the checker (arbace.repr.cpp.diag's gnu-attr rules): its name (`__` affixes dropped), its arguments'
  texts split at their top-level commas (nil without parentheses), its token's offset; the name at token `ni`, the
  attribute's first token `b`, the cursor after it."
  [^P p ^long b ^long ni args?]
  (when-let [^HashMap m (stv p GATTRS)]
    (when (main-tok? p b)
      (let [nm (str/replace (ts (tok-at p ni)) #"^__|__$" "")
            args (when args?
                   (let [t (tok-text p (+ ni 2) (- (ix p) 2))]
                     (if (str/blank? t) [] (loop [i 0 d 0 st 0 out []]
                                             (if (= i (count t))
                                               (conj out (str/trim (subs t st)))
                                               (let [c (.charAt ^String t i)]
                                                 (cond (#{\( \[ \{} c) (recur (inc i) (inc d) st out)
                                                       (#{\) \] \}} c) (recur (inc i) (dec d) st out)
                                                       (and (= c \,) (zero? d)) (recur (inc i) d (inc i) (conj out (str/trim (subs t st i))))
                                                       :else (recur (inc i) d st out))))))))]
        ;; (:std: written as a standard attribute, [[gnu::x]], whose empty argument list is an error of its own, CP303 (a))
        (.put m b (cond-> {:name nm :args args :off (.-o ^T (tok-at p ni)) :i b} (not= b ni) (assoc :std true)))))))

(defn- gattrs-in
  "CP294 (a): the unknown GNU attributes recorded between tokens `b` and `e`, in order."
  [^P p ^long b ^long e]
  (when-let [^HashMap m (stv p GATTRS)]
    (not-empty (vec (sort-by :i (filter #(<= b (long (:i %)) e) (vals m)))))))

(defn- attr-args-semicolon!
  "h-cpp-read: an attribute's argument clause at its `(` holds balanced tokens ([dcl.attr.grammar]/1) that GCC parses as
  expressions: a `;` among them, outside braces, is GCC's \"expected primary-expression before ';' token\" (the clause still
  skipped whole)."
  [^P p]
  (loop [j (inc (ix p)) d 1 br 0]
    (let [^T t (tok-at p j)]
      (cond (identical? :eof (.-k t)) nil
            (t= t "{") (recur (inc j) d (inc br))
            (t= t "}") (recur (inc j) d (dec br))
            (or (t= t "(") (t= t "[")) (recur (inc j) (inc d) br)
            (or (t= t ")") (t= t "]")) (when (> d 1) (recur (inc j) (dec d) br))
            (and (t= t ";") (<= br 0)) (soft-diag! p j "expected primary-expression before ';' token")
            :else (recur (inc j) d br)))))

(defn attr-nodes
  "The attribute-specifiers at the cursor: [[...]], __attribute__((...)), alignas(...): their nodes."
  [^P p]
  (loop [out []]
    (cond
      (and (is? p "[") (is-at? p 1 "["))
      (do (adv! p) (adv! p)
          (when (and (is? p "using") (identical? :id (tk (nxt p 1))) (is-at? p 2 ":")) (adv! p) (adv! p) (adv! p))
          (let [out (loop [out out]
                      (cond
                        (and (is? p "]") (is-at? p 1 "]")) (do (adv! p) (adv! p) out)
                        (is? p ",") (do (adv! p) (recur out))
                        (or (id? p) (identical? :kw (tk (cur p))))
                        (let [b (ix p)
                              ns? (and (is-at? p 1 "::") (or (identical? :id (tk (nxt p 2))) (identical? :kw (tk (nxt p 2)))))
                              nsname (when ns? (ts (cur p)))]
                          (adv! p) (when ns? (adv! p) (adv! p))
                          (let [args? (is? p "(")]
                            ;; (h-cpp-read: nodiscard's and deprecated's argument is a string-literal, [dcl.attr.nodiscard]/1,
                            ;; [dcl.attr.deprecated]/1: GCC's "expected string-literal")
                            (when (and args? (nil? nsname) (#{"nodiscard" "deprecated"} (ts (tok-at p b)))
                                       (not (and (identical? :str (tk (nxt p 1)))
                                                 (loop [k 2] (if (identical? :str (tk (nxt p k))) (recur (inc k)) (is-at? p k ")"))))))
                              ;; (queue 368: in GCC's words, by what the clause holds: none, a string and more, another token)
                              (let [an (ts (tok-at p b))]
                                (soft-diag! p (inc (ix p))
                                            (cond (is-at? p 1 ")") (str "parentheses must be omitted if '" an "' attribute argument list is empty")
                                                  (and (identical? :str (tk (nxt p 1))) (is-at? p 2 ",")) (str "wrong number of arguments specified for '" an "' attribute")
                                                  (= an "deprecated") "deprecated message is not a string"
                                                  :else (str "'" an "' attribute argument must be a string constant")))))
                            ;; (round 54: [dcl.attr.noreturn]/1, [dcl.attr.unused]/1, [dcl.attr.likelihood]/1, [dcl.attr.fallthrough]/1,
                            ;; [dcl.attr.nouniqueaddr]/1, [dcl.attr.depend]/1: these attribute-tokens take no attribute-argument-clause;
                            ;; GNU's attributes of no argument likewise, as GCC's attribute tables give them)
                            (when (and args? (if (nil? nsname)
                                               (contains? #{"noreturn" "carries_dependency" "likely" "unlikely" "maybe_unused" "fallthrough" "no_unique_address"} (ts (tok-at p b)))
                                               (and (#{"gnu" "__gnu__"} nsname)
                                                    (contains? #{"noinline" "always_inline" "noreturn" "cold" "hot" "flatten" "leaf" "noclone" "returns_twice" "artificial" "noipa"}
                                                               (str/replace (ts (tok-at p (+ b 2))) #"^__|__$" "")))))
                              (soft-diag! p b (str "'" (str/replace (ts (tok-at p (if nsname (+ b 2) b))) #"^__|__$" "") "' attribute does not take any arguments")))
                            (when args? (attr-args-semicolon! p) (skip-balanced! p))
                            (when (is? p "...")
                              ;; ([dcl.attr.grammar]/4: an attribute followed by an ellipsis is a pack expansion; the
                              ;; standard attributes take none -- clang's err_cxx11_attribute_forbids_ellipsis, gcc's
                              ;; "attribute with no arguments contains no parameter packs")
                              (when (and (nil? nsname) (not args?) (contains? std-attrs (ts (tok-at p b))))
                                (soft-diag! p b (str "attribute '" (ts (tok-at p b)) "' cannot be used as an attribute pack")))
                              (adv! p)))
                          (when (and (#{"gnu" "__gnu__"} nsname) (not (known-gnu-attr? (ts (tok-at p (+ b 2))))))
                            (unknown-gnu-attr! p b (+ b 2) (t= (tok-at p (+ b 3)) "(")))
                          ;; (cpp-gatefix: [[no_unique_address]] as libstdc++ writes it, [[__no_unique_address__]], which clang
                          ;; normalizes to the same attribute: its node named, :_std, for the layout of a potentially-overlapping member;
                          ;; the other standard attributes' __x__ spellings are left as they were)
                          (let [nua (and (nil? nsname) (#{"no_unique_address" "__no_unique_address__"} (ts (tok-at p b))))]
                            (recur (if (cond nua true
                                             (nil? nsname) (contains? std-attrs (ts (tok-at p b)))
                                             (#{"gnu" "__gnu__"} nsname) (known-gnu-attr? (ts (tok-at p (+ b 2))))
                                             :else (known-attr-ns? nsname))
                                     (conj out (node p "NativeAttr" b (last-ix p) (cond (#{"gnu" "__gnu__"} nsname) {:_gnu (ts (tok-at p (+ b 2)))}
                                                                                       nua {:_std "no_unique_address"}
                                                                                       :else {})))
                                     out))))
                        :else (perr p "an attribute")))]
            (recur out)))
      (and (or (is? p "__attribute__") (is? p "__attribute")) (is-at? p 1 "("))
      (do (adv! p) (expect! p "(") (expect! p "(")
          (let [out (loop [out out]
                      (cond
                        (and (is? p ")") (is-at? p 1 ")")) (do (adv! p) (adv! p) out)
                        (is? p ",") (do (adv! p) (recur out))
                        (or (id? p) (identical? :kw (tk (cur p))))
                        (let [b (ix p)
                              ;; format with a kind of gcc's own (__gcc_diag__ ...): clang drops the attribute
                              gcc-kind (and (is-at? p 1 "(") (re-matches #"__gcc_\w+__|gcc_\w+" (ts (tok-at p (+ b 2)))))]
                          ;; (cpp-gnu, 2026-11-22: GNU's attributes of no argument, as the [[gnu::...]] spelling's above, in the
                          ;; __attribute__ spelling: GCC's "wrong number of arguments specified for 'noinline' attribute", at the name,
                          ;; ext/attr-noinline-4.C)
                          (when (and (is-at? p 1 "(") (not (skim? p))
                                     (contains? #{"noinline" "always_inline" "noreturn" "cold" "hot" "flatten" "leaf" "noclone" "returns_twice" "artificial" "noipa"}
                                                (str/replace (ts (tok-at p b)) #"^__|__$" "")))
                            (soft-diag! p b (str "wrong number of arguments specified for '" (str/replace (ts (tok-at p b)) #"^__|__$" "") "' attribute")))
                          (adv! p) (when (is? p "(") (attr-args-semicolon! p) (skip-balanced! p))
                          (when-not (known-gnu-attr? (ts (tok-at p b))) (unknown-gnu-attr! p b b (t= (tok-at p (inc b)) "(")))
                          (recur (if (and (known-gnu-attr? (ts (tok-at p b))) (not gcc-kind))
                                   (conj out (node p "NativeAttr" b (last-ix p) (cond-> {:_gnu (ts (tok-at p b))}
                                                                                  (t= (tok-at p (inc b)) "(") (assoc :_arg (tok-text p (+ b 2) (- (ix p) 2))))))
                                   out)))
                        :else (perr p "a GNU attribute")))]
            (recur out)))
      (and (or (is? p "alignas") (is? p "_Alignas")) (is-at? p 1 "("))
      (let [b (ix p)]
        ;; (h-cpp-read: alignas takes a type-id or a constant-expression, [dcl.align]/1, none an error)
        (when (is-at? p 2 ")") (soft-diag! p (+ b 2) "expected type-id or expression before ')' token"))
        (adv! p)
        ;; (cpp-read, 2026-11-22: the argument parsed, [dcl.align]/1: a `)` missing after it is GCC's "expected ')' before X", the
        ;; declaration going on at X; a pack expansion whose pattern names no pack, [temp.variadic]/5, "expansion pattern ...
        ;; contains no parameter packs")
        (let [e (when (and *full-headers* (not (skim? p)) (main-tok? p b) (not (is-at? p 1 ")")))
                  (tentatively p (fn [p] (adv! p)
                                   (if (is-type-id? p :targ) (parse-type-id p :targ) (parse-assign-expr p))
                                   (let [pe (ix p)]
                                     (cond (accept! p "...") [pe (ix p)]
                                           ;; (a type-id's declarator took the `...`)
                                           (t= (tok-at p (dec pe)) "...") [(dec pe) pe]
                                           :else [pe nil])))))]
          (if (and (vector? e) (not (t= (tok-at p (long (or (second e) (first e)))) ")")))
            (let [at (long (or (second e) (first e)))]
              (soft-diag! p at (str "expected ')' before '" (ts (tok-at p at)) "'"))
              (seek! p at))
            (do (when (and (vector? e) (second e)
                           (not-any? (fn [i] (let [^T t (tok-at p i)] (and (identical? :id (.-k t)) (let [en (lookup (scope p) (.-s t))] (or (:pack en) (= :pk (:t (:ty en))) (not (:tparam en)))))))
                                     (range (+ b 2) (long (first e)))))
                  (soft-diag! p (long (first e)) "expansion pattern contains no parameter packs"))
                (skip-balanced! p))))
        (recur (conj out (node p "AlignedAttr" b b {:_arg (tok-text p (+ b 2) (- (ix p) 2))}))))
      (and (is? p "__declspec") (is-at? p 1 "(")) (do (adv! p) (skip-balanced! p) (recur out))
      ;; an attribute keyword without its parenthesis (`alignas a`, g++.dg's cpp0x/pr96440.C): clang's "expected '('" (ParseAlignmentSpecifier,
      ;; ParseGNUAttributes); a declaration-specifier loop that asks again would otherwise never advance (cpp-90)
      (and (contains? attr-kws (ts (cur p))) (sym? (cur p))) (perr p "'(' after the attribute keyword")
      :else out)))

;; ---------------------------------------------------------------------------------------------
;; Declaration specifiers (clang's ParseDeclarationSpecifiers)

(declare parse-class-specifier parse-enum-specifier parse-declarator parse-external-decl decl-seq parse-template-decl)


(defn- type-attrs!
  "cpp-read (2026-11-22): the attribute-specifiers at the cursor where they appertain to a type, after a ptr-operator, an
  array bound or a function declarator's parameters ([dcl.ptr]/1, [dcl.array]/3, [dcl.fct]/1): their nodes, with GCC's error
  \"'deprecated' on a type other than class or enumeration definition\" for a standard deprecated or maybe_unused among them
  ([dcl.attr.deprecated]/2, [dcl.attr.unused]/2: they appertain to declarations, not to such types), at the attribute."
  [^P p]
  (let [b (ix p) as (attr-nodes p) e (ix p)]
    (when (and (not (skim? p)) (main-tok? p b))
      (doseq [i (range b e)]
        (let [^T t (tok-at p i)]
          (when (and (contains? #{"deprecated" "maybe_unused"} (.-s t)) (not (identical? :str (.-k t)))
                     (let [^T pv (tok-at p (dec i))] (or (t= pv "[") (t= pv ",")))
                     (not (t= (tok-at p (inc i)) "::")))
            (soft-diag! p i (str "'" (.-s t) "' on a type other than class or enumeration definition"))))))
    as))
(defn- class-ctx [^P p] (first (stv p CLS)))

(defn- vectorized
  "A type with GNU's vector_size among the declaration's attributes `attrs`: the vector type, as clang prints it
  __attribute__((__vector_size__(N))) T (its size as written: the converter has no form for a vector type)."
  [t attrs]
  (if-let [a (first (filter #(and (#{"vector_size" "__vector_size__"} (:_gnu %)) (:_arg %)) attrs))]
    {:t :n :s (str "__attribute__((__vector_size__(" (:_arg a) "))) " (qt t))}
    t))

(defn- ctor-name-here?
  "In a class (`ctx` :member) the cursor at the class's own name followed by a parameter list: a constructor's
  declarator. At namespace scope a qualified name X::X (X<T>::X) followed by (: an out-of-class constructor's."
  [^P p ctx]
  (let [c (class-ctx p)]
    (cond
      (and (= ctx :member) c (id? p) (= (ts (cur p)) (:name c)))
      (let [i (if (and (is-at? p 1 "<") (angle-close p (inc (ix p)))) (inc (long (angle-close p (inc (ix p))))) (inc (ix p)))]
        (and (t= (tok-at p i) "(")
             (or (t= (tok-at p (inc i)) ")")
                 (let [save (ix p)] (seek! p (inc i)) (let [r (try (tp-param-clause! p false) (catch arbace.lang.ExceptionInfo _ :error))] (seek! p save) (not= r :false)))
                 (and (identical? :id (tk (tok-at p (inc i)))) (t= (tok-at p (+ i 2)) "::")
                      (:tparam (lookup (scope p) (ts (tok-at p (inc i)))))))))
      (name-start? p)
      (when-let [[qn e] (scan-name p)]
        (let [parts (:parts qn)
              n (count parts)]
          (and (>= n 2) (t= (tok-at p e) "(")
               (let [a (:s (nth parts (- n 2))) z (:s (nth parts (dec n)))]
                 ;; (round 54, second pass: X<T>::X<T>( too, [class.qual]/2 naming the constructor, which the declarator's
                 ;; check then diagnoses: DR1435's ill-formed template-id)
                 (and a z (= a z) (or (nil? (:args (nth parts (dec n)))) (some? (:args (nth parts (- n 2))))))))))
      :else false)))

(defn- guide-here?
  "A deduction guide: a class template's name, (...), then ->."
  [^P p]
  (when (and (id? p) (is-at? p 1 "("))
    (let [e (lookup (scope p) (ts (cur p)))]
      (and (type-ent? e) (:tmpl e)
           (let [save (ix p)]
             (adv! p)
             (let [ok (skip-balanced! p) r (and ok (is? p "->"))] (seek! p save) r))))))

(defn- pack-indexed
  "A type `t` followed by C++26's pack index ...[I]: the PackIndexingType clang prints T...[I]; else `t`."
  [^P p t]
  (if (and (is? p "...") (is-at? p 1 "["))
    (let [_ (adv! p) ob (ix p)]
      (skip-balanced! p)
      (assoc t :s (str (:s t) "...[" (tok-text p (inc ob) (- (ix p) 2)) "]")))
    t))

(defn- words-type
  "A builtin type's specifier words as its type, {:t :b :w words}; queue 411 (the checker): a character type of its own
  (char8_t, char16_t, char32_t, wchar_t) or bool with signed, unsigned, short or long is ill-formed ([dcl.type.simple]/3's
  table has no such combination), diagnosed at the decl-specifiers (GCC's \"'signed' specified with 'char8_t'\"; before
  -fchar8_t made char8_t a keyword below C++20, ext/char8_t-type-specifier-2.C's errors came from an unknown name)."
  [^P p ds words]
  (let [core (first (filter #{"char8_t" "char16_t" "char32_t" "wchar_t" "bool"} words))
        bad (first (filter #{"signed" "unsigned" "__signed" "__signed__" "short" "long"} words))]
    (when (and core bad (:b ds)) (soft-diag! p (long (:b ds)) (str "'" bad "' specified with '" core "'")))
    {:t :b :w words}))

(defn- want-semicolon?
  "cpp-read (2026-11-22): whether the token after a class definition is none that may follow it in its declaration, GCC's
  want_semicolon (cp_parser_class_specifier_1): not an identifier, ; * & ( ) , or ::, nor an attribute-specifier, nor a
  decl-specifier keyword (storage class, cv-qualifier, function specifier, typedef, friend, constexpr, constinit) unless a
  keyword beginning a type specifier follows it (c-family's keyword_is_decl_specifier, keyword_begins_type_specifier)."
  [^P p]
  (let [^T t (cur p)]
    (cond
      (identical? :id (.-k t)) false
      (or (t= t ";") (t= t "*") (t= t "&") (t= t "(") (t= t ")") (t= t ",") (t= t "::")) false
      (or (and (t= t "[") (is-at? p 1 "[")) (t= t "alignas") (t= t "__attribute__") (t= t "__attribute")) false
      (contains? #{"static" "extern" "register" "auto" "mutable" "thread_local" "__thread" "const" "volatile" "restrict"
                   "__restrict" "__restrict__" "_Atomic" "inline" "virtual" "explicit" "typedef" "friend" "constexpr" "constinit"}
                 (.-s t))
      (contains? #{"int" "char" "float" "double" "void" "unsigned" "long" "short" "signed" "bool" "wchar_t" "char8_t" "char16_t"
                   "char32_t" "_Complex" "__complex__" "typeof" "__typeof__" "__typeof" "struct" "class" "union" "enum" "__int128"
                   "_Float16" "_Float32" "_Float64" "_Float128" "__float128" "_BitInt" "__auto_type"}
                 (ts (nxt p 1)))
      :else true)))

(defn- unclosed-paren!
  "cpp-read (2026-11-22): at a decltype's or typeof's (, a ; or } of its level before its ) is the operand's end, GCC's \"expected
  primary-expression before ';' token\" there (the declaration declined at it; skip-balanced! ran to the file's end)."
  [^P p]
  (let [n (.-cnt p)]
    (loop [j (inc (ix p)) d 1]
      (when (< j n)
        (let [^T t (tok-at p j)]
          (cond (identical? :eof (.-k t)) nil
                (or (t= t "(") (t= t "[") (t= t "{")) (recur (inc j) (inc d))
                (or (t= t ")") (t= t "]")) (when (> d 1) (recur (inc j) (dec d)))
                (and (= d 1) (or (t= t ";") (t= t "}"))) (do (seek! p j) (perr p (str "expected primary-expression before '" (.-s t) "' token")))
                (t= t "}") (recur (inc j) (dec d))
                :else (recur (inc j) d)))))))

(defn- declared-in-main?
  "cpp-read (2026-11-22): whether the main file declares a type named `nm` somewhere (`using NM =`, a class-key or enum before
  it, `typedef ... NM;`, `concept NM`): a later use no lookup finds is then a declaration's failure's cascade (GCC declares the
  failed name as erroneous and says nothing more), not \"does not name a type\"."
  [^P p ^String nm]
  (let [n (.-cnt p)]
    (boolean
      (some (fn [i]
              (let [^T t (tok-at p i)]
                (and (identical? :id (.-k t)) (.equals nm (.-s t)) (main-tok? p i)
                     (let [^T pv (tok-at p (dec i)) ^T nx (tok-at p (inc i))]
                       (or (and (t= pv "using") (t= nx "="))
                           (#{"class" "struct" "union" "enum" "concept" "typename"} (.-s pv))
                           (and (or (t= nx ";") (t= nx "[") (t= nx ",") (t= nx ")") (t= nx "("))
                                (loop [j (dec i)] (cond (< j (max 0 (- i 64))) false
                                                        (or (t= (tok-at p j) ";") (t= (tok-at p j) "{") (t= (tok-at p j) "}")) false
                                                        (t= (tok-at p j) "typedef") true
                                                        :else (recur (dec j))))))))))
            (range 1 n)))))

(defn- parse-decl-specs*
  "A decl-specifier-seq: {:b :e :type :storage :typedef :friend :inline :virtual :explicit :constexpr :consteval
  :constinit :mutable :tls :attrs :tag-node}, :b its first token after the leading attribute-specifier-seq (clang's
  range starts there), :tag-node a class or enumeration declared in it."
  [^P p ctx]
  (let [b0 (ix p)
        lead (when (and (is? p "[") (is-at? p 1 "[")) (attr-nodes p))
        b (if (some #(#{"fastcall" "stdcall" "thiscall" "vectorcall" "regcall" "ms_abi" "preserve_most" "preserve_all"} (some-> (:_gnu %) (str/replace #"^__|__$" ""))) lead)
            b0 (ix p))
        decl-ctx (contains? #{:top :member :block :param :tmpl} ctx)]
    ;; (:gb: the first token of the leading attribute-specifier-seq, where the declaration's unknown GNU attributes start, CP303 (a))
    (loop [ds {:b b :gb b0 :attrs (vec lead)} words []]
      (let [^T t (cur p) s (.-s t) k (.-k t)
            has-type (or (:type ds) (seq words))]
        (cond
          (identical? k :kw)
          (cond
            (and (= s "extern") (#{:str :udls} (tk (nxt p 1)))) (if (seq words) (assoc ds :type {:t :b :w words} :e (last-ix p)) (assoc ds :e (last-ix p)))
            ;; (round 54: [dcl.spec.general]/2, each of these decl-specifiers at most once, [dcl.stc]/1 one storage-class-specifier:
            ;; GCC's "duplicate 'friend'", "'extern' specifier conflicts with 'static'")
            (#{"static" "extern" "register"} s) (do (when-let [o (:storage ds)]
                                                      (soft-diag! p (ix p) (if (= o s) (str "duplicate '" s "'") (str "'" s "' specifier conflicts with '" o "'"))))
                                                    (adv! p) (recur (assoc ds :storage s) words))
            (and (#{"mutable" "typedef" "friend" "virtual" "constexpr" "consteval" "constinit"} s) (get ds (keyword s)))
            (do (soft-diag! p (ix p) (str "duplicate '" s "'" (when (= s "mutable") " specifier"))) (adv! p) (recur ds words))
            (= s "mutable") (do (adv! p) (recur (assoc ds :mutable true) words))
            (= s "typedef") (do (adv! p) (recur (assoc ds :typedef true) words))
            (= s "friend") (do (adv! p) (recur (assoc ds :friend true) words))
            (#{"inline" "__inline" "__inline__"} s) (do (adv! p) (recur (assoc ds :inline true :inline-i (last-ix p)) words))
            (= s "virtual") (do (adv! p) (recur (assoc ds :virtual true :virtual-i (last-ix p)) words))
            (= s "explicit") (do (adv! p) (when (is? p "(") (skip-balanced! p)) (recur (assoc ds :explicit true) words))
            (= s "constexpr") (do (adv! p) (recur (assoc ds :constexpr true :constexpr-i (last-ix p)) words))
            (= s "consteval") (do (adv! p) (recur (assoc ds :consteval true) words))
            (#{"constinit" "__constinit"} s) (do (adv! p) (recur (assoc ds :constinit true) words))
            ;; (cpp-s5b: the TLS kind as clang's VarDecl::getTLSKind gives it: thread_local's is dynamic, __thread's and
            ;; _Thread_local's static)
            (#{"thread_local" "_Thread_local" "__thread"} s) (do (when (:tls ds) (soft-diag! p (ix p) (str "duplicate '" s "'"))) (adv! p) (recur (assoc ds :tls (if (= s "thread_local") "dynamic" "static")) words))
            (#{"_Noreturn" "__extension__" "export"} s) (if (and (= s "export") (not= ctx :top)) (assoc ds :e (last-ix p)) (do (adv! p) (recur (cond-> ds (= s "__extension__") (assoc :ext true)) words)))
            ;; (round 54, fifth pass: [dcl.type.general]/2, const and volatile each at most once in a decl-specifier-seq: GCC's
            ;; "duplicate 'volatile'")
            (#{"const" "__const"} s) (do (when (:c ds) (soft-diag! p (ix p) (str "duplicate '" s "'"))) (adv! p) (recur (assoc ds :c true :cv-i (or (:cv-i ds) (last-ix p))) words))
            (#{"volatile" "__volatile" "__volatile__"} s) (do (when (:v ds) (soft-diag! p (ix p) (str "duplicate '" s "'"))) (adv! p) (recur (assoc ds :v true :cv-i (or (:cv-i ds) (last-ix p))) words))
            (#{"__restrict" "__restrict__"} s) (do (adv! p) (recur ds words))
            (and (contains? builtin-kws s) (nil? (:type ds)))
            (do ;; (cpp-gnu, 2026-11-22: GNU's __int128 is no type of ISO C++, [basic.fundamental]'s standard integer types:
                ;; GCC's pedwarn "ISO C++ does not support '__int128' for ...", at the keyword, an error under -pedantic-errors
                ;; alone; none after __extension__, which GCC's -pedantic spares, ext/int128-1.C, int128-6.C)
                (when (and (= s "__int128") (not (:ext ds)) (not (skim? p)))
                  (pedantic-diag! p (ix p) "ISO C++ does not support '__int128'"))
                (adv! p) (recur ds (conj words s)))
            (and (= s "auto") (not has-type)) (do (adv! p) (recur (assoc ds :type (if (< (.-year p) 2011) {:t :b :w ["int"]} {:t :auto}) :auto-i (last-ix p)) words))
            ;; (n-cpp-concepts: `C const auto`, the placeholder after its cv-qualifier, the error given at C: the auto taken)
            (and (= s "auto") (:bare-concept ds)) (do (adv! p) (recur (dissoc ds :bare-concept) words))
            (and (= s "__auto_type") (not has-type)) (do (adv! p) (recur (assoc ds :type {:t :auto}) words))
            (and (#{"decltype" "__decltype"} s) (not has-type) (is-at? p 1 "("))
            (if (and (is-at? p 2 "auto") (is-at? p 3 ")"))
              (do (dotimes [_ 4] (adv! p)) (recur (assoc ds :type {:t :dta}) words))
              (let [save (ix p)
                    qn (parse-name p :scan)]
                (if (and qn (> (count (:parts qn)) 1))
                  (do (seek! p save) (let [qn (parse-name p :parse)] (recur (assoc ds :type {:t :n :s (name-str p qn)}) words)))
                  (do (seek! p save) (adv! p)
                      (unclosed-paren! p)
                      (let [ob (ix p)]
                        ;; (h-cpp-read: decltype's operand is an expression, [dcl.type.decltype]/1: none, or a keyword that
                        ;; begins none, is GCC's "expected primary-expression")
                        (when (or (is-at? p 1 ")")
                                  (and (is-at? p 2 ")") (identical? :kw (tk (nxt p 1)))
                                       (not (#{"this" "true" "false" "nullptr"} (ts (nxt p 1))))))
                          (soft-diag! p (inc (ix p)) (str "expected primary-expression before '" (ts (nxt p 1)) "'")))
                        ;; G4: the operand parsed for the code generator's decltype, keyed by its text
                        (when (and *full-headers* (not (skim? p)))
                          (let [x (tentatively p (fn [p] (adv! p) (let [x (with-gt p true (parse-expr p))] (when (is? p ")") x))))]
                            (when (map? x) (let [^HashMap m (stv p DECLTYPES)] (.put m (str/replace (tok-text p (inc ob) (dec (long (or (some-> (angle-paren-close p ob) long) ob))))
                                                                                                  #"\s+" "") x)))))
                        (skip-balanced! p)
                        (recur (assoc ds :type {:t :dt :s (tok-text p (inc ob) (- (ix p) 2))}) words))))))
            ;; (cpp-gnu, 2026-11-22: GNU's typeof after unsigned, signed, short or long, no type of GNU's: GCC's "'unsigned' specified
            ;; with 'typeof'", at the keyword, the typeof taken, ext/typeof13.C)
            (and (#{"__typeof__" "__typeof" "typeof"} s) (nil? (:type ds)) (seq words) (is-at? p 1 "(")
                 (every? #{"unsigned" "signed" "short" "long" "__signed" "__signed__"} words))
            (do (when-not (skim? p) (soft-diag! p (ix p) (str "'" (first words) "' specified with '" s "'")))
                (adv! p) (let [ob (ix p)] (skip-balanced! p) (recur (assoc ds :type {:t :n :s (str s "(" (tok-text p (inc ob) (- (ix p) 2)) ")")}) [])))
            (and (#{"__typeof__" "__typeof" "typeof"} s) (not has-type) (is-at? p 1 "("))
            (do (adv! p) (unclosed-paren! p) (let [ob (ix p)] (skip-balanced! p) (recur (assoc ds :type {:t :n :s (str s "(" (tok-text p (inc ob) (- (ix p) 2)) ")")}) words)))
            (and (= s "_Atomic") (is-at? p 1 "(") (not has-type))
            (do ;; (cpp-diag-b, 2026-11-22: C's _Atomic type specifier is no C++ keyword (C++23's <stdatomic.h> defines it as a
                ;; macro): GCC's "'_Atomic' does not name a type", at the keyword)
                (when (and (main-tok? p (ix p)) (not (skim? p)) (nil? (.-mac ^T (cur p)))) (soft-diag! p (ix p) "'_Atomic' does not name a type"))
                (adv! p) (let [ob (ix p)] (skip-balanced! p) (recur (assoc ds :type {:t :n :s (str "_Atomic(" (tok-text p (inc ob) (- (ix p) 2)) ")")}) words)))
            (and (#{"class" "struct" "union"} s) (not has-type))
            (let [{:keys [type node]} (parse-class-specifier p ds ctx)
                  ds (cond-> (assoc ds :type type) node (assoc :tag-node node))]
              (if (and node (#{:top :member :block} ctx) (t= (tok-at p (last-ix p)) "}") (want-semicolon? p))
                ;; cpp-read (2026-11-22): a class definition followed by a token no declarator or decl-specifier of its
                ;; declaration begins with, GCC's "expected ';' after class definition" (cp_parser_class_specifier_1: the
                ;; tokens that may follow the production enumerated, the semicolon inserted): at the closing brace, the
                ;; declaration ended there (parse-simple-decl's :semi-missing)
                (do (when (and (main-tok? p (last-ix p)) (not (skim? p)))
                      (soft-diag! p (last-ix p) (str "expected ';' after " s " definition")))
                    (assoc ds :e (last-ix p) :semi-missing true))
                (recur ds words)))
            (and (= s "enum") (not has-type))
            (let [{:keys [type node]} (parse-enum-specifier p ds ctx)] (recur (cond-> (assoc ds :type type) node (assoc :tag-node node)) words))
            (and (= s "typename") (not has-type))
            (do (adv! p) (let [qn (or (parse-name p :parse)
                                      ;; (cpp-read, 2026-11-22: `typename ::` with no name after it, GCC's error at the token after
                                      ;; the ::, parse/crash10.C)
                                      (do (when (and (is? p "::") (not (is-at? p 1 "::"))) (adv! p)) (perr p "a typename's name")))]
                           ;; cpp-read (2026-11-22): a typename-specifier's nested-name-specifier names nothing declared, or a
                           ;; namespace without the member ([temp.res.general]/5 with [basic.lookup.qual]): GCC's "'X' has not been
                           ;; declared", "'Y' in namespace 'N' does not name a type", at the name
                           (when-not (skim? p)
                             (let [parts (:parts qn) f (first parts) l (peek parts)]
                               (cond
                                 ;; ([temp.res.general]/5: a typename-specifier has a nested-name-specifier, GCC's "expected
                                 ;; nested-name-specifier before 'X'")
                                 (and (= 1 (count parts)) (not (:g qn)) (:i f) (main-tok? p (long (:i f))))
                                 (soft-diag! p (long (:i f)) (str "expected nested-name-specifier before '" (or (:s f) "") "'"))
                                 (and (= 2 (count parts)) (not (:g qn)) (:s f) (not (:args f)) (nil? (:q qn)) (main-tok? p (long (:i f)))
                                      (nil? (lookup (scope p) (:s f))))
                                 (soft-diag! p (long (:i f)) (str "'" (:s f) "' has not been declared"))
                                 (and (= :ns (:k (:q qn))) (nil? (:ent qn)) (:s l) (:i l) (main-tok? p (long (:i l))))
                                 (soft-diag! p (long (:i l)) (str "'" (:s l) "' in namespace '" (:name (:q qn)) "' does not name a type"))
                                 ;; (the class being defined named by its injected-class-name, no dependent base, without the member:
                                 ;; [temp.dep.type]/1's current instantiation, looked up at the definition: template/crash7.C)
                                 (and (= 2 (count parts)) (:inj (:q qn)) (nil? (:ent qn)) (:s l) (:i l) (main-tok? p (long (:i l)))
                                      (not (dep-bases? p)) (<= (count (stv p CLS)) 1))
                                 (soft-diag! p (long (:i l)) (str "'" (:s l) "' in '" (:s f) "' does not name a type"))
                                 :else nil)))
                           (recur (assoc ds :type {:t :tn :s (name-str p qn) :qn qn}) words)))
            (contains? attr-kws s) (let [as (attr-nodes p)] (recur (update ds :attrs into as) words))
            :else (cond-> (assoc ds :e (last-ix p)) (seq words) (assoc :type (words-type p ds words))))
          (and (t= t "[") (is-at? p 1 "["))
          (let [i (ix p) as (attr-nodes p)]
            ;; (round 54, second pass: [dcl.spec.general]/1, a decl-specifier-seq's attribute-specifier-seq follows its last
            ;; decl-specifier alone: one before another decl-specifier is GCC's "standard attributes in middle of decl-specifiers")
            (when (and (> i (long (:b ds))) (or (storage-kws (ts (cur p))) (cv-kws (ts (cur p))) (builtin-kws (ts (cur p)))))
              (soft-diag! p i "standard attributes in middle of decl-specifiers"))
            (recur (update ds :attrs into as) words))
          (and (type-transform? p) (not has-type))
          (do (adv! p) (let [ob (ix p)] (skip-balanced! p) (recur (assoc ds :type {:t :n :s (str s "(" (tok-text p (inc ob) (- (ix p) 2)) ")")}) words)))
          ;; (cpp-gnu, 2026-11-22: in a type-id, where no declarator-id may follow, unsigned, signed, short or long before a
          ;; typedef-name of an integer type: GCC takes the pair as an extension, its pedwarn "'unsigned' specified with typedef-name
          ;; 'foo_t'" (an error under -pedantic-errors alone), ext/typeof13.C's `(unsigned foo_t)s`)
          (and (= ctx :type-id) (identical? k :id) (seq words) (nil? (:type ds))
               (every? #{"unsigned" "signed" "short" "long" "__signed" "__signed__"} words)
               (let [^T n (nxt p 1)] (or (t= n ")") (t= n "*") (t= n "&") (t= n ">") (t= n ",")))
               (let [e (lookup (scope p) s)] (and (type-ent? e) (not (:tag e)) (not (:class e)) (not (:tparam e)) (not (:tmpl e)))))
          (let [e (lookup (scope p) s)]
            (when-not (skim? p) (pedantic-diag! p (ix p) (str "'" (first words) "' specified with typedef-name '" s "'")))
            (adv! p)
            (recur (assoc ds :type {:t :n :s s :ent e}) []))
          (and (not has-type) (name-start? p)
               (not (and (= ctx :member) (ctor-name-here? p ctx)))
               (not (and (#{:top :member :tmpl} ctx) (ctor-name-here? p :top)))
               (not (and (#{:top :tmpl :member} ctx) (guide-here? p))))
          (let [save (ix p)
                qn (parse-name p :parse)
                e (:ent qn)
                lp (peek (:parts qn))]
            (cond
              (nil? qn) (assoc ds :e (last-ix p))
              (or (:op lp) (:dtor lp) (:conv lp) (:lit lp)) (do (seek! p save) (assoc ds :e (last-ix p)))
              (type-ent? e) (recur (assoc ds :type (pack-indexed p {:t :n :s (name-str p qn) :ent e :qn qn})) words)
              (and (concept-ent? e) (or (is? p "auto") (and (is? p "decltype") (is-at? p 2 "auto"))))
              (let [cn (name-str p qn)]
                (if (is? p "auto") (adv! p) (dotimes [_ 4] (adv! p)))
                (recur (assoc ds :type {:t :auto :cn cn}) words))
              ;; (n-cpp-concepts, [dcl.spec.auto.general]/1 with [temp.param]/4: a concept's name where a type stands, before
              ;; a declarator's name or a parameter's end: a type concept wants `auto` after it (GCC's "expected 'auto' or
              ;; 'decltype(auto)' after"), another "does not constrain a type"; taken as its placeholder, the declaration
              ;; kept)
              (and (concept-ent? e) (or decl-ctx (= ctx :alias)) (not (skim? p))
                   (or (= ctx :alias) (id? p) (is? p "&") (is? p "&&") (is? p "*") (is? p "const") (is? p "volatile")
                       (and (= ctx :param) (or (is? p ")") (is? p ",")))))
              (let [cn (name-str p qn)]
                (soft-diag! p save (if (false? (:type-concept e))
                                     (str "'" cn "' does not constrain a type")
                                     (str "expected 'auto' or 'decltype(auto)' after '" cn "'")))
                (recur (assoc ds :type {:t :auto :cn cn} :bare-concept true) words))
              ;; a dependent name where only a type can stand (P0634: a parameter's, an alias's, a return type's)
              (and (nil? e) (or (:q qn) (> (count (:parts qn)) 1)) (or decl-ctx (= ctx :alias))
                   (or (= ctx :alias) (id? p) (is? p "*") (is? p "&") (is? p "&&")
                       ;; an abstract parameter declarator: B(T::type); (clang's implicit typename, an extension before C++20)
                       (and (= ctx :param) (or (is? p ")") (is? p ",") (is? p "=") (is? p "...")))
                       ;; a friend-type-specifier (friend Ts::Y..., Us...;)
                       (and (:friend ds) (or (is? p "...") (is? p ",") (is? p ";")))))
              (do ;; (h-cpp-read: before C++20 a dependent qualified name names a type only after typename, [temp.res]/3: GCC's
                  ;; "need 'typename' before 'T::type' because 'T' is a dependent scope", for a declarator's name after it)
                  (when (and (< (.-year p) 2020) (not (:friend ds)) (not= ctx :alias)
                             ;; (cpp-read: a parameter's abstract declarator too, `void func(A<T>::B*)`, parse/crash13.C)
                             (or (id? p) (and (= ctx :param) (or (is? p "*") (is? p "&") (is? p "&&") (is? p ")") (is? p ","))))
                             (let [f (first (:parts qn))]
                               (or (some-> (lookup (scope p) (:s f)) :tparam)
                                   ;; (cpp-read, 2026-11-22: a template-id first whose arguments name a template parameter, a
                                   ;; dependent scope as well, parse/typedef2.C's `B<T>::X::Y`)
                                   (and (:args f) (:ab f) (:ae f) (not (skim? p))
                                        (some (fn [i] (let [^T t (tok-at p i)] (and (identical? :id (.-k t)) (:tparam (lookup (scope p) (.-s t))))))
                                              (range (long (:ab f)) (inc (long (:ae f)))))))))
                    (soft-diag! p save (str "need 'typename' before '" (name-str p qn) "' because '" (:s (first (:parts qn))) "' is a dependent scope")))
                  ;; (cpp-read, 2026-11-22: a nested-name-specifier's first name no lookup finds, [basic.lookup.qual]/1 with
                  ;; [basic.lookup.unqual]: GCC's "'X' has not been declared" (at namespace scope "'X' does not name a type"), at the
                  ;; name, parse/crash1.C; the main file not declaring it anywhere)
                  ;; std GCC declares itself, with std::align_val_t from C++17 (cxx_init_decl_processing): its other members
                  ;; are "'b' is not a member of 'std'", at the member
                  (let [f (first (:parts qn)) s2 (second (:parts qn))]
                    (when (and *full-headers* (not (skim? p)) (> (count (:parts qn)) 1) (not (:g qn)) (:s f) (not (:args f)) (:i f)
                               (main-tok? p (long (:i f))) (nil? (lookup (scope p) (:s f))) (not (declared-in-main? p (:s f))))
                      (if (= "std" (:s f))
                        (when (and (:s s2) (:i s2) (not (and (= "align_val_t" (:s s2)) (>= (.-year p) 2017))))
                          (soft-diag! p (long (:i s2)) (str "'" (:s s2) "' is not a member of 'std'")))
                        (soft-diag! p (long (:i f)) (str "'" (:s f) "' has not been declared")))))
                  ;; (cpp-rind: [basic.lookup.qual]/1 with [dcl.type.simple]/1, a name qualified by a complete class without bases or
                  ;; an enumeration, not a template's, that declares no such member: GCC's "'Type' in 'enum class ENUM' does not name
                  ;; a type", at the name; cpp0x/enum16.C, parse/error52.C)
                  (let [f (first (:parts qn)) l (peek (:parts qn)) q (:q qn)]
                    (when (and *full-headers* (not (skim? p)) (= 2 (count (:parts qn))) (not (:g qn)) (nil? (:ent qn)) (:s f) (:s l)
                               (not-any? :args (:parts qn)) (:i l) (main-tok? p (long (:i l)))
                               (map? q) (:tag q) (not (:incomplete q)) (not (:dep q)) (not (:tmpl q)) (not (:tparam q)) (:scope q)
                               (= (:name q) (:s f))
                               (if (:class q) (and (some? (:bases-order q)) (zero? (.size ^ArrayList (:bases-order q))) (not (:union q))) true)
                               (nil? (sc/find-in (:scope q) (:s l) true)) (nil? (sc/find-in (:scope q) (:s l) false)))
                      (soft-diag! p (long (:i l)) (str "'" (:s l) "' in '" (:s f) "' does not name a type"))))
                  (recur (assoc ds :type {:t :n :s (name-str p qn) :qn qn}) words))
              (and decl-ctx (nil? e) (id? p) (not (#{"final" "override"} (ts (cur p)))))
              (do ;; (cpp-read, 2026-11-22: an unqualified name no lookup finds where a declaration's type stands, a declarator's
                  ;; name after it ([dcl.type.simple]/1 with [basic.lookup.unqual]): GCC's "'B' does not name a type", at the name;
                  ;; the declaration taken)
                  (let [bad (and *full-headers* (not (skim? p)) (= 1 (count (:parts qn))) (not (:g qn)) (:s lp) (not (:args lp))
                                 (main-tok? p save) (nil? (lookup (scope p) (:s lp))) (not (declared-in-main? p (:s lp)))
                                 (not (and *fn-start* (some (fn [x] (>= (long (first x)) (long *fn-start*))) (stv p DIAGS)))))]
                    (when bad (soft-diag! p save (str "'" (:s lp) "' does not name a type")))
                    ;; (:undeclared-type: in a block GCC reads the statement as an expression, its declarator declaring nothing,
                    ;; so a later use of the name is undeclared too: ext/builtin11.C)
                    (recur (cond-> (assoc ds :type {:t :n :s (name-str p qn) :qn qn :unknown true}) bad (assoc :undeclared-type true)) words)))
              :else (do ;; (cpp-read, 2026-11-22: an unqualified name no lookup finds before a <, where a declaration's type
                        ;; stands: GCC's "'A' does not name a type", at the name)
                        (when (and *full-headers* decl-ctx (nil? e) (is? p "<") (not (skim? p)) (= 1 (count (:parts qn))) (not (:g qn))
                                   (:s lp) (main-tok? p save) (nil? (lookup (scope p) (:s lp))) (not (declared-in-main? p (:s lp))))
                          (soft-diag! p save (str "'" (:s lp) "' does not name a type")))
                        (seek! p save) (assoc ds :e (last-ix p)))))
          :else (cond-> (assoc ds :e (last-ix p)) (seq words) (assoc :type (words-type p ds words))))))))

(defn- spec-tokens
  "cpp-diag-b (2026-11-22): the decl-specifier-seq's keyword tokens at its own level, [index spelling] in order: what a
  parenthesized operand (decltype, typeof, an attribute's, alignas), a class or enumeration body and a template argument
  list hold left out."
  [^P p ^long b ^long e]
  (loop [i b d 0 out []]
    (if (> i e)
      out
      (let [^T t (tok-at p i) s (.-s t)]
        (cond
          (or (t= t "(") (t= t "[") (t= t "{") (t= t "<")) (recur (inc i) (inc d) out)
          (or (t= t ")") (t= t "]") (t= t "}") (t= t ">")) (recur (inc i) (max 0 (dec d)) out)
          (t= t ">>") (recur (inc i) (max 0 (- d 2)) out)
          ;; (a class-specifier's or enum-specifier's head and body, its base-clause's virtual among them, are its own: from the key
          ;; past the closing brace)
          (and (zero? d) (contains? #{"class" "struct" "union" "enum"} s)
               (some #(t= (tok-at p %) "{") (range (inc i) (inc e))))
          (let [k (long (first (filter #(t= (tok-at p %) "{") (range (inc i) (inc e)))))
                z (loop [j (inc k) dd 1] (cond (> j e) j
                                              (t= (tok-at p j) "{") (recur (inc j) (inc dd))
                                              (t= (tok-at p j) "}") (if (= dd 1) j (recur (inc j) (dec dd)))
                                              :else (recur (inc j) dd)))]
            (recur (inc (long z)) d (conj out [i s])))
          (and (zero? d) (identical? :kw (.-k t))) (recur (inc i) d (conj out [i s]))
          :else (recur (inc i) d out))))))

(def ^:private spec-word-norm {"__signed" "signed" "__signed__" "signed" "__complex" "_Complex" "__complex__" "_Complex" "_Bool" "bool"})

(defn- spec-checks!
  "cpp-diag-b (2026-11-22): the rules of a decl-specifier-seq's combination GCC diagnoses at the specifiers, from the standard's
  [dcl.spec.general]/2 (one storage class, typedef with none), [dcl.type.simple]/3's table of the simple-type-specifiers' valid
  combinations, [dcl.stc]/1 (thread_local only with static or extern; register removed in C++17, [diff.cpp14.dcl.dcl]),
  [dcl.fct.spec]/2 (virtual only in a member function's declaration in its class, [class.friend]/... no virtual friend,
  [class.static.mfct]/2 no virtual static), [class.friend]/... (friend only in a class), [dcl.stc]/9 (mutable only on a class's
  non-static data member); GCC's words (the manual's -Wpedantic for register)."
  [^P p ds ctx]
  ;; ([temp.param]/2: a template parameter's decl-specifiers have no storage class)
  (when (and (= ctx :tparam) (:b ds) (:e ds) (not (skim? p)) (main-tok? p (long (:b ds))))
    (when-let [[i _] (first (filter #(#{"static" "extern" "register" "mutable" "__thread" "thread_local" "_Thread_local"} (second %))
                                    (spec-tokens p (long (:b ds)) (long (:e ds)))))]
      (soft-diag! p (long i) "storage class specified for template parameter")))
  (when (and (:b ds) (:e ds) (contains? #{:top :member :block :param :tparam} ctx) (not (skim? p)) (main-tok? p (long (:b ds))))
    (let [ks (spec-tokens p (long (:b ds)) (long (:e ds)))
          first-of (fn [pred] (first (filter #(pred (second %)) ks)))
          words (filter #(builtin-kws (second %)) ks)
          wn (map (fn [[i s]] [i (get spec-word-norm s s)]) words)
          wf (frequencies (map second wn))
          at (fn [w] (first (first (filter #(= w (second %)) wn))))
          cores (remove #(#{"unsigned" "signed" "long" "short" "_Complex"} (second %)) wn)
          core (second (first cores))
          nl (long (get wf "long" 0))
          sto (first-of #{"static" "extern" "register"})
          tdf (first-of #{"typedef"})
          tls (first-of #{"__thread" "thread_local" "_Thread_local"})
          virt (first-of #{"virtual"})
          frnd (first-of #{"friend"})
          mut (first-of #{"mutable"})]
      ;; storage classes, typedef and the thread storage
      (cond
        (and sto tdf) (let [[a b] (sort-by first [sto tdf])] (soft-diag! p (long (first b)) (str "'" (second b) "' specifier conflicts with '" (second a) "'")))
        (and tls (or tdf (and sto (= "register" (second sto)))))
        (soft-diag! p (long (if tdf (first tls) (min (long (first tls)) (long (first sto))))) "multiple storage classes in declaration")
        (and tls (= "__thread" (second tls)) sto (< (long (first tls)) (long (first sto))))
        (soft-diag! p (long (first tls)) (str "'__thread' before '" (second sto) "'"))
        :else nil)
      ;; [diff.cpp14.dcl.dcl]: register is no storage class in C++17 (an explicit register variable's asm label aside, checked
      ;; at its declarator: :_reg-spec)
      ;; the simple-type-specifiers
      (cond
        (> (count cores) 1) (soft-diag! p (long (first (first cores))) "two or more data types in declaration")
        (> nl 2) (soft-diag! p (long (at "long")) "'long long long' is too long for GCC")
        (and (wf "signed") (wf "unsigned")) (soft-diag! p (long (at "signed")) "'signed' and 'unsigned' specified together")
        (and (pos? nl) (wf "short")) (soft-diag! p (long (at "long")) "'long' and 'short' specified together")
        (and (wf "_Complex") (#{"bool" "void" "wchar_t" "char8_t" "char16_t" "char32_t"} core))
        (soft-diag! p (long (at "_Complex")) "complex invalid for this declaration")
        ;; (a character type of its own or bool: words-type's)
        (#{"bool" "wchar_t" "char8_t" "char16_t" "char32_t"} core) nil
        (and (pos? nl) core (not (or (= core "int") (and (= core "double") (= nl 1)))))
        (soft-diag! p (long (at "long")) (str "'long" (when (= nl 2) " long") "' invalid for this declaration"))
        (and (wf "short") core (not= core "int")) (soft-diag! p (long (at "short")) "'short' invalid for this declaration")
        (and (or (wf "signed") (wf "unsigned")) core (not (#{"int" "char" "__int128"} core)))
        (soft-diag! p (long (or (at "signed") (at "unsigned"))) "'signed' or 'unsigned' invalid for this declaration")
        :else nil)
      ;; the function specifier virtual, friend and mutable
      (when virt
        (cond
          frnd (soft-diag! p (long (first virt)) "virtual functions cannot be friends")
          (and (= ctx :member) sto (= "static" (second sto))) (soft-diag! p (long (first virt)) "member cannot be declared both 'virtual' and 'static'")
          ;; ([temp.mem]/3: a member function template is not virtual)
          (and (= ctx :member) (pos? (long (or (:n (stv p THDR)) 0)))) (soft-diag! p (long (first virt)) "templates may not be 'virtual'")
          (#{:top :block} ctx) (soft-diag! p (long (first virt)) "'virtual' outside class declaration")
          :else nil))
      ;; ([dcl.stc]/4: thread_local at block scope with static or extern only as GNU __thread wants them spelled, on a static data
      ;; member, on no parameter; [dcl.stc]/2: a parameter's storage class register alone)
      (when (and tls (not tdf) (not (and sto (= "register" (second sto)))))
        (cond
          (and (= ctx :block) (not sto) (= "__thread" (second tls))) (soft-diag! p (long (first tls)) "function-scope variable implicitly auto and declared '__thread'")
          (and (= ctx :member) (not sto) (not frnd)) (soft-diag! p (long (first tls)) "storage class specified for a non-static data member")
          :else nil))
      (when (and (= ctx :member) sto (#{"extern" "register"} (second sto)))
        (soft-diag! p (long (first sto)) "storage class specified for a member"))
      (when (and (= ctx :param) (or tls (and sto (not= "register" (second sto)))))
        (soft-diag! p (long (first (or tls sto))) "storage class specified for parameter"))
      (when (and frnd (#{:top :block} ctx) (not virt)) (soft-diag! p (long (first frnd)) "'friend' used outside of class"))
      ;; ([class.mem.general]/3: a member-declaration without a declarator declares a class, an enumeration or a friend: storage
      ;; classes or cv-qualifiers alone declare nothing, GCC's "declaration does not declare anything")
      (when (and (= ctx :member) (nil? (:type ds)) (nil? (:tag-node ds)) (not frnd) (is? p ";") (or sto (:c ds) (:v ds)))
        (soft-diag! p (ix p) "declaration does not declare anything"))
      ;; ([class.friend]/3: a friend declaration of a class is an elaborated-type-specifier, no class definition)
      (when (and frnd (= ctx :member) (:tag-node ds) (:completeDefinition (:tag-node ds)))
        (soft-diag! p (long (first frnd)) "class definition may not be declared a friend"))
      (when (and mut (#{:top :block} ctx)) (soft-diag! p (long (first mut)) "non-member cannot be declared 'mutable'"))
      ;; ([class.ctor.general]/1: a constructor's decl-specifiers are function specifiers, friend, constexpr alone, so cv-qualifiers
      ;; before the class's name make it a type and `()` an empty declarator: GCC's "expected unqualified-id before ')' token")
      (when (and (= ctx :member) (or (:c ds) (:v ds)) (= :n (:t (:type ds))) (some? (:name (class-ctx p)))
                 (= (:s (:type ds)) (:name (class-ctx p))) (is? p "(") (is-at? p 1 ")"))
        (soft-diag! p (inc (ix p)) "expected unqualified-id before ')' token")))))

(defn parse-decl-specs
  "A decl-specifier-seq (parse-decl-specs*), its combination's rules checked (spec-checks!)."
  [^P p ctx]
  (let [ds (parse-decl-specs* p ctx)]
    (spec-checks! p ds ctx)
    ds))

(defn- ds-type
  "The decl-specifiers' type with their cv-qualifiers."
  [ds]
  (when-let [t (:type ds)] (with-cv t (:c ds) (:v ds))))

;; ---------------------------------------------------------------------------------------------
;; Declarators (clang's ParseDeclarator): {:ptrs [...] :name name :ni token :nested d :sufs [...] :pack bool :b :e}

(defn- ptr-ops
  "The ptr-operators at the cursor, outermost first: {:t :p} {:t :lr} {:t :rr} {:t :mp :cls \"C\"} with :c :v."
  [^P p]
  (loop [out []]
    (cond
      (or (is? p "*") (is? p "^"))
      (do (adv! p)
          (let [[c v r] (loop [c false v false r false]
                          (cond (or (is? p "const") (is? p "__const")) (do (adv! p) (recur true v r))
                                (or (is? p "volatile") (is? p "__volatile") (is? p "__volatile__")) (do (adv! p) (recur c true r))
                                (or (is? p "__restrict") (is? p "__restrict__") (id-is? p "restrict")) (do (adv! p) (recur c v true))
                                (is? p "__attribute__") (do (.addAll ^ArrayList (stv p PATTRS) ^java.util.Collection (attr-nodes p)) (recur c v r))
                                (and (is? p "[") (is-at? p 1 "[")) (do (type-attrs! p) (recur c v r))
                                :else [c v r]))]
            (recur (conj out (cond-> (with-cv {:t :p} c v) r (assoc :rs true))))))
      ;; GNU's restrict-qualified references (`T &__restrict r`: libsupc++'s __do_upcast, clang's Sema::BuildReferenceType keeps the
      ;; qualifier, its type printed `T &__restrict`)
      (or (is? p "&") (is? p "&&"))
      (let [k (if (is? p "&") :lr :rr)]
        (adv! p) (type-attrs! p)
        (let [r (loop [r false] (if (or (is? p "__restrict") (is? p "__restrict__")) (do (adv! p) (recur true)) r))]
          (recur (conj out (cond-> {:t k} r (assoc :rs true))))))
      (name-start? p)
      (let [save (ix p) qn (try (parse-name p :parse) (catch arbace.lang.ExceptionInfo _ nil))]
        (if (and qn (is? p "::") (is-at? p 1 "*"))
          (do ;; (cpp-diag-b, 2026-11-22: [dcl.mptr]/1, a pointer to member's nested-name-specifier denotes a class: a namespace's
              ;; is GCC's "'A' is a namespace", at the name)
              (when (and (not (skim? p)) (main-tok? p save) (= :ns (:k (:ent qn))))
                (soft-diag! p save (str "cannot create pointer to member of namespace '" (name-str p qn) "'")))
              (adv! p) (adv! p)
              (let [[c v] (loop [c false v false] (cond (is? p "const") (do (adv! p) (recur true v)) (is? p "volatile") (do (adv! p) (recur c true))
                                                        ;; (cpp-read, 2026-11-22: the ptr-operator's attribute-specifier-seq, [dcl.decl.general]/4)
                                                        (and (is? p "[") (is-at? p 1 "[")) (do (type-attrs! p) (recur c v))
                                                        :else [c v]))]
                (recur (conj out (with-cv {:t :mp :cls (name-str p qn)} c v)))))
          (do (seek! p save) out)))
      :else out)))

(defn- nested-declarator?
  "At a ( where a direct declarator may start: whether it opens a nested declarator (not a parameter list)."
  [^P p mode]
  (let [^T n (nxt p 1)]
    (or (t= n "*") (t= n "&") (t= n "&&") (t= n "^") (t= n "(")
        (and (t= n "[") (not (t= (nxt p 2) "[")))
        (and (t= n "...") (not (t= (nxt p 2) ")")))
        (and (not= mode :abstract) (or (t= n "operator") (t= n "~")))
        (t= n "__attribute__")
        ;; a member pointer C::*
        (and (or (identical? :id (.-k n)) (t= n "::"))
             (let [save (ix p)]
               (adv! p)
               (let [qn (try (parse-name p :scan) (catch arbace.lang.ExceptionInfo _ nil))
                     r (cond (and qn (is? p "::") (is-at? p 1 "*")) true
                             (= mode :abstract) false
                             (and qn (not (type-ent? (:ent qn))) (not (concept-ent? (:ent qn)))) true
                             :else false)]
                 (seek! p save)
                 r))))))

(defn- member-name?
  "Whether `nm`, looked up from the cursor's scope, is a non-static member of the class being defined (or of an
  out-of-class member's class), not a name of a scope inside it."
  [^P p ^String nm]
  (loop [^Scope s (scope p)]
    (when s
      (case (sc/kind-of s)
        :class (let [e (or (sc/find-in s nm) (when-let [late (:late (class-ctx p))] (sc/find-in late nm)))]
                 (and e (#{:var :fn} (:k e)) (not (:static e))))
        ;; (cpp-rt-own: a namespace's lookup scope, a namespace member defined outside it, holds no member: its name is no class's)
        :lookup (if (= :ns (:k (sc/ent-of s)))
                  (if (sc/find-in s nm) false (recur (sc/parent-of s)))
                  (let [e (sc/find-in s nm)] (and e (#{:var :fn} (:k e)) (not (:static e)))))
        (if (.get ^java.util.HashMap (sc/names-of s) nm) false (recur (sc/parent-of s)))))))

(defn- in-body-member?
  "Whether `nm` names a non-static member of the class being defined, reached from a function's parameters or body (a
  scope of kind :fparams or :block below the class's): clang's implicit member access this->nm there (an unevaluated
  operand of the class's own scope is a plain reference)."
  [^P p ^String nm]
  (loop [^Scope s (scope p) body false]
    (when s
      (case (sc/kind-of s)
        :class (let [e (or (sc/find-in s nm) (when-let [late (:late (class-ctx p))] (sc/find-in late nm)))]
                 (and body e (#{:var :fn} (:k e)) (not (:static e)) (not (:enumerator e)) (not (:anon e)) (not (:unres e)) (not (:tmpl e))))
        ;; the lookup scope of a default member initializer (with-late*: its entity has no kind) is the class's own
        ;; (cpp-rt-own: a namespace's lookup scope, fs_ops.cc's `fs::copy(...)` calling `copy(from, to, options, ec)`, is no class's)
        :lookup (if (= :ns (:k (sc/ent-of s)))
                  (if (sc/find-in s nm) false (recur (sc/parent-of s) body))
                  (let [e (sc/find-in s nm)]
                    (and (or body (nil? (:k (sc/ent-of s)))) e (#{:var :fn} (:k e)) (not (:static e)) (not (:enumerator e)) (not (:anon e)) (not (:unres e)) (not (:tmpl e)))))
        (if (.get ^java.util.HashMap (sc/names-of s) nm)
          false
          (recur (sc/parent-of s) (or body (contains? #{:fparams :block} (sc/kind-of s)))))))))

(defn- this-members
  "The tree with the member names the parser marked (`:_this`: an unqualified non-static member of the class, named
  in a function's body) as clang's tree has them: a MemberExpr through the implicit `this`."
  [nodes]
  (letfn [(walk [n]
            (if-not (map? n)
              n
              (let [n (if-let [in (:inner n)] (assoc n :inner (mapv walk in)) n)
                    ;; (a fold expression's operands, kept as data: CP291 (a))
                    n (if-let [f (:_fold n)] (assoc n :_fold (cond-> f (:l f) (update :l walk) (:r f) (update :r walk))) n)]
                (cond
                  (and (:_depscope n) (= "MemberExpr" (:kind n)))
                  (-> n (dissoc :name :_depscope) (assoc :kind "CXXDependentScopeMemberExpr" :member (:name n)))
                  (and (:_this n) (= "DeclRefExpr" (:kind n)))
                  (let [r (:range n) nm (get-in n [:referencedDecl :name])]
                    (-> n (dissoc :referencedDecl :_this)
                        (assoc :kind "MemberExpr" :name nm :isArrow true
                               :inner [{:kind "CXXThisExpr" :implicit true :range r :inner []}])))
                  :else n))))]
    (mapv walk nodes)))

(defn- tok-text-this
  "tok-text, a non-static member's name written as clang prints an implicit member access: this->name."
  ^String [^P p ^long b ^long e]
  (str/join " " (for [i (range b (inc e))
                      :let [^T t (tok-at p i)
                            pv (when (> i b) (ts (tok-at p (dec i))))
                            nx (when (< i e) (ts (tok-at p (inc i))))]]
                  (if (and (identical? :id (.-k t)) (not (#{"." "->" "::"} pv)) (not= "::" nx) (member-name? p (.-s t)))
                    (str "this -> " (.-s t))
                    (tok-text p i i)))))

(defn- fn-quals
  "The qualifiers after a parameter list: [quals-text meta], meta {:const :volatile :ref :noexcept :trailing}."
  [^P p]
  (loop [q "" m {}]
    (cond
      ;; (round 54, fifth pass: [dcl.decl.general]/? (C++23 [dcl.decl.general]/5), a cv-qualifier-seq names each cv-qualifier once:
      ;; GCC's "duplicate cv-qualifier")
      (or (is? p "const") (is? p "__const")) (do (when (:const m) (soft-diag! p (ix p) "duplicate cv-qualifier")) (adv! p) (recur (if (:const m) q (str q " const")) (assoc m :const true)))
      (or (is? p "volatile") (is? p "__volatile__")) (do (when (:volatile m) (soft-diag! p (ix p) "duplicate cv-qualifier")) (adv! p) (recur (if (:volatile m) q (str q " volatile")) (assoc m :volatile true)))
      (or (is? p "__restrict") (is? p "__restrict__")) (do (adv! p) (recur q m))
      (and (is? p "&") (not (:ref m))) (do (adv! p) (recur (str q " &") (assoc m :ref "&" :ref-i (last-ix p))))
      (and (is? p "&&") (not (:ref m))) (do (adv! p) (recur (str q " &&") (assoc m :ref "&&" :ref-i (last-ix p))))
      (is? p "noexcept")
      (do (adv! p)
          ;; (h-cpp-read: noexcept's operand is a constant-expression, none written is an error, [except.spec]/1)
          (when (and (is? p "(") (is-at? p 1 ")")) (soft-diag! p (inc (ix p)) "expected primary-expression before ')' token"))
          (if (is? p "(")
            (let [ob (ix p)
                  ;; G5: the operand parsed for the code generator (noexcept(e) evaluated per specialization), keyed by its text
                  ;; (a noexcept-specifier is a complete-class context, [class.mem.general]/7, cpp-gnu)
                  x (when (and *full-headers* (not (skim? p)))
                      (binding [*cm-scopes* nil]
                        (tentatively p (fn [p] (adv! p) (let [x (with-gt p true (parse-expr p))] (when (is? p ")") x))))))]
              (skip-balanced! p)
              (let [txt (tok-text-this p (inc ob) (- (ix p) 2))]
                (when (map? x) (.put ^HashMap (stv p DECLTYPES) (str "noexcept:" (str/replace txt #"\s+" "")) x))
                (recur (str q " noexcept(" txt ")") (assoc m :noexcept true))))
            (recur (str q " noexcept") (assoc m :noexcept true))))
      (and (is? p "throw") (is-at? p 1 "("))
      (do (adv! p) (let [ob (ix p)] (skip-balanced! p)
                     ;; (queue 377: [except.spec] with [dcl.type.general]/3, a dynamic exception specification's type-ids define no class
                     ;; or enumeration: GCC's "types may not be defined in an exception-specification", at the definition's brace)
                     (when-not (skim? p)
                       (when-let [bi (some #(def-brace p %) (range (inc (long ob)) (dec (long (ix p)))))]
                         (soft-diag! p bi "types may not be defined in an exception-specification"))
                       ;; (cpp-read, 2026-11-22: a type-id of one identifier no lookup finds, [except.spec]/1 with
                       ;; [basic.lookup]: GCC's "expected type-specifier" (its type-id-list parsed), at the name)
                       (let [c (dec (long (ix p)))]
                         (loop [i (inc (long ob))]
                           (when (< i c)
                             (let [^T t (tok-at p i) ^T n (tok-at p (inc i))]
                               (when (and (identical? :id (.-k t)) (t= (tok-at p (dec i)) (if (= i (inc (long ob))) "(" ","))
                                          (or (= (inc i) c) (t= n ",") (t= n "...")) (main-tok? p i) (nil? (lookup (scope p) (.-s t))))
                                 (soft-diag! p i (str "expected type-specifier before '" (.-s t) "'")))
                               (recur (inc i)))))))
                     (recur (str q " throw(" (tok-text p (inc ob) (- (ix p) 2)) ")") (assoc m :throw true))))
      (or (and (is? p "[") (is-at? p 1 "[")) (is? p "__attribute__"))
      (let [as (type-attrs! p)] (recur q (update m :attrs (fnil into []) as)))
      :else [q m])))

(defn- parse-fn-suffix
  "A function declarator's ( params ) and qualifiers, the cursor on its (: {:f true :params :types :names :va :q :m :trailing}."
  [^P p]
  (expect! p "(")
  (let [pl (parse-param-list p)
        [q m] (fn-quals p)
        tr (when (is? p "->") (adv! p) (parse-type-id p :trailing))]
    (assoc pl :f true :q q :m m :trailing tr)))

(defn- special-name?
  "A declarator-id that is not an identifier (clang's UnqualifiedIdKind other than IK_Identifier: an operator, a
  destructor, a conversion function, a literal operator, a qualified constructor X::X): never followed by a direct
  initializer (Declarator::mayBeFollowedByCXXDirectInit), so its ( opens a parameter list."
  [qn]
  (let [parts (:parts qn) n (count parts) lp (peek parts)]
    (boolean
      (or (:op lp) (:dtor lp) (:conv lp) (:lit lp)
          (and (>= n 2) (:s lp) (= (:s lp) (:s (nth parts (- n 2)))) (nil? (:args lp)))))))

(defn parse-declarator
  "A declarator at the cursor; `mode` :named (a declarator-id, a ( after it a parameter list only when
  isCXXFunctionDeclarator says so), :either (a parameter's), :abstract (a type-id's)."
  [^P p mode]
  (let [b (ix p)
        saved (stv p PATTRS)
        _ (st! p PATTRS (ArrayList.))
        ptrs (ptr-ops p)
        pattrs (vec (stv p PATTRS))
        _ (st! p PATTRS saved)
        pack (accept! p "...")
        [name ni nested]
        (cond
          (and (not= mode :abstract) (or (id? p) (is? p "operator") (and (is? p "~") (identical? :id (tk (nxt p 1))))
                                         (and (is? p "::") (name-start? p)) (and (is? p "template") false)))
          (let [i (ix p) qn (parse-name p :parse)
                lp (peek (:parts qn))]
            [qn (long (:i lp)) nil])
          (and (is? p "(") (nested-declarator? p mode))
          (do (adv! p) (let [d (parse-declarator p mode)] (expect! p ")") [(:name (loop [d d] (if (:nested d) (recur (:nested d)) d))) nil d]))
          :else [nil nil nil])
        mid (ArrayList.)
        lastx (long-array 1)
        _ (aset lastx 0 (last-ix p))
        ;; after a qualified declarator-id the declarator's rest is in its class's scope (clang's DeclScopeObj)
        qcls (when (and name (:q name)) (let [e (:q name)] (when (and (type-ent? e) (:scope e)) (spec-of-qualifier p name e))))
        suffixes
        (fn []
             (loop [out []]
               (cond
                 (and (is? p "[") (is-at? p 1 "[")) (do (.addAll mid ^java.util.Collection (if (seq out) (type-attrs! p) (attr-nodes p))) (recur out))
                 (is? p "[")
                 (if (is-at? p 1 "[")
                   out
                   (do (adv! p)
                       (let [s0 (ix p)
                             x (if (is? p "]") nil (if (skim? p) (do (skip-until! p #{"]"}) nil) (with-gt p true (parse-expr p))))
                             ;; a skimmed bound's text (an aggregate's initialization asks the bound: arbace.repr.cpp.sema)
                             sn (when (and (nil? x) (> (ix p) s0)) (tok-text p s0 (dec (ix p))))
                             e (ix p)]
                         (expect! p "]")
                         (aset lastx 0 (last-ix p))
                         (recur (conj out (cond-> {:a true :n (when x (tok-text p (nb x) (ne x))) :x x} sn (assoc :sn sn)))))))
                 (and (is? p "(") (or (not= mode :named) (nil? name) (special-name? name)
                                      ;; a qualified declarator-id naming a member function (Sema::isDeclaratorFunctionLike)
                                      (and qcls (= :fn (:k (sc/find-in (:scope qcls) (:s (peek (:parts name)))))))
                                      (is-function-declarator? p)))
                 (let [f (parse-fn-suffix p)] (aset lastx 0 (last-ix p)) (recur (conj out f)))
                 :else out)))
        ;; (cpp-rt-own: a namespace's member defined outside it, `fs::path fs::absolute(const path& p)` at the global namespace
        ;; (fs an alias of std::filesystem): the rest in the namespace's scope, then its enclosing ones (arbace.repr.cpp.scope/lookup))
        qns (when (and (nil? qcls) name (:q name)) (let [e (:q name)] (when (and (= :ns (:k e)) (:scope e)) e)))
        sufs (if-let [lk (or qcls qns)] (in-scope p (sc/new-scope :lookup (scope p) lk) (suffixes)) (suffixes))
        ;; (cpp-read, 2026-11-22: GNU attributes after an abstract declarator's last ptr-operator with nothing after them: GCC
        ;; parses them as the dependent declarator's, which is then empty, "expected declarator", the tentative parse undone, so
        ;; the attribute stands where the type-id's end is wanted, "expected '>' before '__attribute'" (cp_parser_declarator with
        ;; cp_parser_direct_declarator's abstract case; ext/attrib22.C))
        _ (when (and (= mode :abstract) (seq ptrs) (nil? name) (nil? nested) (empty? sufs) (not pack) (not (skim? p))
                     (or (is? p "__attribute__") (is? p "__attribute")) (is-at? p 1 "(") (main-tok? p (ix p)))
            (soft-diag! p (ix p) (str "expected declarator before '" (ts (cur p)) "'")))
        _ (when (and (= mode :abstract) (seq ptrs) (nil? name) (nil? nested) (empty? sufs) (not pack) (not (skim? p))
                     (t= (tok-at p (dec (ix p))) ")"))
            (let [open (loop [j (- (ix p) 2) d 1]
                         (when (>= j (long b))
                           (let [^T t (tok-at p j)]
                             (cond (t= t ")") (recur (dec j) (inc d))
                                   (t= t "(") (if (= d 1) j (recur (dec j) (dec d)))
                                   :else (recur (dec j) d)))))]
              (when (and open (> (long open) (long b)) (#{"__attribute__" "__attribute"} (ts (tok-at p (dec (long open)))))
                         (main-tok? p (dec (long open))))
                (soft-diag! p (dec (long open)) (str "expected declarator before '" (ts (tok-at p (dec (long open)))) "'")))))
        as (into (into pattrs mid) (attr-nodes p))]
    {:ptrs ptrs :name name :ni ni :nested nested :sufs sufs :pack pack :b b :e (aget lastx 0) :attrs as
     :after (ix p)}))

(defn- apply-suffix [s t]
  (if (:f s)
    (cond-> {:t :f :ps (:types s) :va (:va s) :r (or (:trailing s) t) :q (:q s)}
      (:trailing s) (assoc :tr true))
    (cond-> {:t :a :n (:n s) :of t} (:sn s) (assoc :sn (:sn s)))))

(defn build-type
  "The type a declarator gives its name from the base type `base`."
  [base d]
  (let [t1 (reduce (fn [t op] (assoc op :of t)) base (:ptrs d))
        t2 (reduce (fn [t s] (apply-suffix s t)) t1 (reverse (:sufs d)))
        t3 (if (:nested d) (build-type t2 (:nested d)) t2)]
    (if (and (:pack d) (not (:nested d))) {:t :pk :of t3} t3)))

(defn- name-chain [d] (loop [d d out [d]] (if (:nested d) (recur (:nested d) (conj out (:nested d))) out)))

(defn- arr-of-ref?
  "cpp-rind: [dcl.array]/1, whether the type built by a declarator holds an array whose element type is a reference (`int &a[1]`,
  `const int& (a)[1]`; a reference to an array, `int (&a)[1]`, is none), through its pointers, arrays and return types."
  [t]
  (loop [t t k 0]
    (when (and (map? t) (< k 32))
      (if (and (= :a (:t t)) (#{:lr :rr} (:t (:of t))))
        true
        (recur (if (= :f (:t t)) (:r t) (:of t)) (inc k))))))

(defn- op-param!
  "Round 54, sixth pass: [dcl.fct]/? (C++23 [dcl.fct]/3) with [dcl.decl.general]/? : a parameter's and an exception-declaration's
  declarator-id is an identifier: an operator-function-id there is GCC's \"declaration of 'operator+' as parameter\", at the
  name."
  [^P p d]
  (when-let [lp (some-> (:name (last (name-chain d))) :parts peek)]
    (when (and (:op lp) (:i lp))
      (soft-diag! p (long (:i lp)) (str "declaration of 'operator" (:op lp) "' as parameter")))))

(defn- fn-suffix-of
  "The function suffix that makes the declarator's name a function, or nil (a pointer, an array, an object)."
  [d]
  (loop [ds (reverse (name-chain d))]
    (when-let [x (first ds)]
      (cond (seq (:sufs x)) (let [s (first (:sufs x))] (when (:f s) s))
            (seq (:ptrs x)) nil
            :else (recur (rest ds))))))

(defn- decl-type-without-fn
  "A function declarator's return type: the type of the declarator with its function suffix taken as the type."
  [base d]
  (let [t (build-type base d)] (if (= :f (:t t)) (:r t) t)))

(defn parse-type-id
  "A type-id (a cast's, sizeof's, a template argument's, a trailing return type's...): its type. `ctx` :conv (a
  conversion-type-id: ptr-operators alone after the specifiers); :cast (a C-style cast's or a compound literal's: GNU's
  vector_size among its attributes makes it the vector type in the code generator's mode, *vector-specs*, queue 439)."
  [^P p ctx]
  (let [outer *tid-def*
        ds (if (or outer (= ctx :trailing) (not (#{"class" "struct" "union" "enum"} (ts (cur p)))))
             (parse-decl-specs p (if (= ctx :trailing) :alias :type-id))
             (binding [*tid-def* (count (stv p CLS))] (parse-decl-specs p :type-id)))
        base (or (ds-type ds) (perr p "a type"))
        ;; CP352: a class or enumeration defined in a trailing return type (`auto f() -> struct C {} {}`, ill-formed) has no place in the
        ;; function's forms (its declaration would stand beside it): a decline, the declaration's text
        _ (when (and (= ctx :trailing) (:tag-node ds) (not (skim? p))) (perr p "a type defined in a trailing return type"))
        ;; (round 54: [dcl.type.general]/3 (C++23 [dcl.type.general]/2), a type-specifier-seq defines no class or enumeration outside
        ;; a declaration's: a cast's, sizeof's, offsetof's or a template argument's type-id; GCC's "types may not be defined in ...")
        _ (when-let [tn (:tag-node ds)]
            (when (and (not= ctx :trailing) (nil? outer) (or (:completeDefinition tn) (and (= "EnumDecl" (:kind tn)) (seq (:inner tn)))))
              (soft-diag! p (long (:b ds)) (str "types may not be defined " (or *tdef-ctx* "in a type-id")))))]
    (if (= ctx :conv)
      (reduce (fn [t op] (assoc op :of t)) base (ptr-ops p))
      (let [d (parse-declarator p :abstract) t (build-type base d)]
        (if (and (= ctx :cast) *vector-specs*) (vectorized t (concat (:attrs ds) (:attrs d))) t)))))

(defn parse-type-specs
  "The simple-type-specifier of a functional cast or a new-type-id: its type."
  [^P p ctx]
  (let [ds (parse-decl-specs p :type-id)] (or (ds-type ds) (perr p "a type specifier"))))

;; ---------------------------------------------------------------------------------------------
;; Parameters

(defn- declare! [^P p e] (sc/declare! (sc/decl-scope (scope p)) e))

(defn parse-param-list
  "A parameter-declaration-clause, the ( consumed, its ) too: {:params [ParmVarDecl ...] :types [...] :names [...] :va}."
  [^P p]
  (binding [*param-depth* (inc (long *param-depth*))]
  (with-gt p true
    (cond
      (is? p ")") (do (adv! p) {:params [] :types [] :names [] :va false})
      (and (is? p "void") (is-at? p 1 ")")) (do (adv! p) (adv! p) {:params [] :types [] :names [] :va false :void true})
      :else
      (loop [ps [] tys [] nms [] ]
        (cond
          (is? p "...") (do (adv! p) (expect! p ")") {:params ps :types tys :names nms :va true})
          :else
          (let [;; C++23's explicit object parameter (P0847R7, [dcl.fct]/3): `this` before its declaration
                xo (accept! p "this")
                ds (parse-decl-specs p :param)
                ;; (cpp-diag-b, 2026-11-22: a register parameter in C++17, [diff.cpp14.dcl.dcl]: GCC's pedwarn, as for a variable)
                _ (when (and (= "register" (:storage ds)) (>= (.-year p) 2017) (not (skim? p)) (main-tok? p (long (:b ds))))
                    (pedantic-diag! p (long (:b ds)) "ISO C++17 does not allow 'register' storage class specifier"))
                ;; (queue 376: [dcl.fct]/17 (C++23 [dcl.fct]/16), a class or enumeration defined in a parameter's type: GCC's
                ;; "types may not be defined in parameter types", at the definition's opening brace)
                _ (when-let [tn (:tag-node ds)]
                    (when (and (not (skim? p)) (or (:completeDefinition tn) (and (= "EnumDecl" (:kind tn)) (seq (:inner tn)))))
                      (let [bi (loop [i (long (:b ds))] (if (or (t= (tok-at p i) "{") (>= i (long (ix p)))) i (recur (inc i))))]
                        (soft-diag! p bi "types may not be defined in parameter types"))))
                base (or (ds-type ds) (perr p "a parameter's type"))
                ;; (cpp-rind: a placeholder parameter of a function type's own parameter, never permitted, GCC's "'auto' parameter not
                ;; permitted in this context"; one of the outermost clause kept for its declaration, *auto-params*)
                _ (when (and (= :auto (:t base)) (:auto-i ds) (not (skim? p)) (main-tok? p (long (:auto-i ds))))
                    (cond (>= (long *param-depth*) 2) (soft-diag! p (long (:auto-i ds)) "'auto' parameter not permitted in this context")
                          (some? *auto-params*) (.add ^ArrayList *auto-params* (long (:auto-i ds)))
                          :else nil))
                d (parse-declarator p :either)
                ;; (cpp-decl2: [dcl.inline]/1, no inline parameter: GCC's "'var31' declared as an 'inline' parameter")
                _ (when (and (:inline ds) (not (skim? p)) (main-tok? p (long (:b ds))))
                    (when-let [pn (:s (last (:parts (:name (last (name-chain d))))))]
                      (soft-diag! p (long (:b ds)) (str "'" pn "' declared as an 'inline' parameter"))))
                _ (op-param! p d)
                cva (and (:pack d) (nil? (:name d)) (nil? (:nested d)) (is? p ")")
                         (not (= :auto (:t base))) (not (:pack (:ent base)))
                         ;; a type naming a parameter pack (typename decay<B>::type...): a pack expansion, not C's ...
                         (not (and (#{:n :tn} (:t base)) (:s base)
                                   (some (fn [w] (:pack (lookup (scope p) w))) (re-seq #"[A-Za-z_]\w*" (:s base))))))
                d (if cva (dissoc d :pack) d)
                ;; (cpp-sweep: [temp.variadic]/5, a function parameter pack's pattern names a pack: a declarator `...x` of a
                ;; type written with fundamental type keywords and cv-qualifiers alone, or decltype(auto), names none, GCC's
                ;; "expansion pattern 'int' contains no parameter packs", at the name; any declarator with a suffix or a nested
                ;; declarator, and any type naming a name, not judged: cpp1y/decltype-auto-103497.C)
                _ (when (and (:pack d) (not cva) (nil? (:nested d)) (empty? (:sufs d)) (empty? (:ptrs d)) (:name d)
                             (not (skim? p)) (main-tok? p (long (:b ds))))
                    (let [ws (mapv #(ts (tok-at p %)) (range (long (:b ds)) (long (:b d))))]
                      (when (and (seq ws)
                                 (or (= ws ["decltype" "(" "auto" ")"])
                                     (every? #{"int" "char" "short" "long" "unsigned" "signed" "bool" "float" "double" "wchar_t" "char8_t"
                                               "char16_t" "char32_t" "const" "volatile"} ws)))
                        (let [qn0 (:name (last (name-chain d)))]
                          (when qn0
                            (soft-diag! p (long (:i (peek (:parts qn0)))) (str "expansion pattern '" (str/join " " ws) "' contains no parameter packs")))))))
                ;; (queue 365: round 54's [temp.variadic]/5 check of a parameter's type naming a pack removed: a parameter inside an
                ;; expansion's pattern is valid, `fn<void(Ts)>...`, `void (*...fs)(Ts)`, a lambda's `(T x)` in a fold)
                ty (build-type (cond-> base *vector-specs* (vectorized (:attrs ds))) d)
                qn (:name (last (name-chain d)))
                nm (name-plain qn)
                ni (if qn (long (:i (peek (:parts qn)))) (ix p))
                ;; (cpp-rind: a parameter declared as an array of references, as a variable, [dcl.array]/1; cpp0x/initlist57.C)
                _ (when (and (not (skim? p)) (main-tok? p ni) (arr-of-ref? ty))
                    (soft-diag! p ni (str "declaration of '" (or nm "") "' as array of references")))
                has-dflt (is? p "=")
                db (ix p)
                dflt (when (accept! p "=")
                       ;; (a default argument is a complete-class context, [class.mem.general]/7: no use there changes a name's
                       ;; meaning, cpp-gnu)
                       (if (skim? p) (do (skip-until! p #{"," ")"}) nil) (binding [*cm-scopes* nil] (with-gt p true (parse-init-clause p)))))
                ;; (round 54, second pass: [expr.await]/2 and [expr.yield]/1, no await-expression or yield-expression in a default
                ;; argument: GCC's "'co_await' cannot be used in default arguments")
                _ (when has-dflt
                    (when-let [i (first (filter #(#{"co_await" "co_yield"} (ts (tok-at p %))) (range (inc db) (ix p))))]
                      (soft-diag! p (long i) (str "'" (ts (tok-at p (long i))) "' cannot be used in default arguments"))))
                ;; (cpp-read, 2026-11-22: [dcl.fct.default]/7-9, an enclosing function's local variable or parameter in a default
                ;; argument (a lambda's or a local declaration's): GCC's "local variable 'x' may not appear in this context", at the
                ;; name; an unevaluated operand's aside)
                _ (when (and has-dflt (not (skim? p)) (main-tok? p db)
                             (not-any? #(#{"sizeof" "decltype" "alignof" "noexcept" "typeid" "__typeof__" "__decltype"} (ts (tok-at p %))) (range (inc db) (ix p))))
                    (when-let [i (first (filter (fn [i]
                                                  (let [^T t (tok-at p i) ^T pv (tok-at p (dec i))]
                                                    (and (identical? :id (.-k t)) (not (or (t= pv ".") (t= pv "->") (t= pv "::"))) (not (t= (tok-at p (inc i)) "::"))
                                                         (let [en (loop [^Scope s (scope p)]
                                                                    (when s (if-let [e (.get ^java.util.HashMap (sc/names-of s) (.-s t))] [e (sc/kind-of s)] (recur (sc/parent-of s)))))]
                                                           (and en (#{:block :fparams} (second en)) (= :var (:k (first en)))
                                                                (not (:enumerator (first en))) (not (:static (first en))) (not (:constexpr (first en)))
                                                                (not (:tparam (first en))))))))
                                                (range (inc db) (ix p))))]
                      (soft-diag! p (long i) (str "local variable '" (ts (tok-at p (long i))) "' may not appear in this context"))))
                ;; (cpp-diag-b, 2026-11-22: [dcl.fct.default]/9, an earlier parameter of the clause in a default argument, outside
                ;; an unevaluated operand: GCC's "parameter 'I' may not appear in this context", at the name; a lambda's parameters
                ;; aside)
                _ (when (and has-dflt (not (skim? p)) (main-tok? p db) (seq (remove nil? nms))
                             (not-any? #(#{"sizeof" "decltype" "alignof" "noexcept" "typeid" "__typeof__" "__decltype" "[" "requires"} (ts (tok-at p %))) (range (inc db) (ix p))))
                    (let [pn (set (remove nil? nms))]
                      (when-let [i (first (filter (fn [i] (let [^T t (tok-at p i) ^T pv (tok-at p (dec i))]
                                                            (and (identical? :id (.-k t)) (contains? pn (.-s t))
                                                                 (not (or (t= pv ".") (t= pv "->") (t= pv "::"))) (not (t= (tok-at p (inc i)) "::")))))
                                                  (range (inc db) (ix p))))]
                        (soft-diag! p (long i) (str "parameter '" (ts (tok-at p (long i))) "' may not appear in this context")))))
                _ (when (and (skim? p) (t= (tok-at p (dec (ix p))) "=")) nil)
                e (if cva (dec (last-ix p)) (last-ix p))
                pv (node p "ParmVarDecl" (:b ds) (max (:b ds) e)
                         (cond-> {:loc (loc p ni) :type {:qualType (qt (param-type ty))}
                                  :inner (vec (concat (:attrs ds) (:attrs d) (when dflt [dflt])))}
                           nm (assoc :name nm)
                           xo (assoc :isExplicitObjectParameter true)
                           (or dflt has-dflt) (assoc :init "c")
                           ;; (cpp-rt-own4: the parameter declared const at its top level, which its type as a function type
                           ;; prints leaves out, [dcl.fct]/5, and its variable keeps: the code generator's sema; a :_ key, the
                           ;; tree compared with clang's unchanged)
                           (and (:c ty) (not (#{:a :f} (:t ty)))) (assoc :_const true)))
                ;; (cpp-diag-b, round 2: [dcl.fct]/? with [basic.scope.param]: two parameters of one clause named alike, GCC's
                ;; "redefinition of 'int x'", at the second)
                _ (when (and nm (some #{nm} nms) (not (skim? p)) (main-tok? p ni))
                    (soft-diag! p ni (str "redefinition of parameter '" nm "'")))
                ps (conj ps pv) tys (conj tys ty) nms (conj nms nm)]
            (cond
              cva (do (expect! p ")") {:params ps :types tys :names nms :va true})
              (accept! p ",") (recur ps tys nms)
              (and (is? p "...") (is-at? p 1 ")")) (do (adv! p) (adv! p) {:params ps :types tys :names nms :va true})
              (accept! p ")") {:params ps :types tys :names nms :va false}
              :else (perr p "a parameter list")))))))))

(defn declare-params!
  ([^P p names] (declare-params! p names nil))
  ([^P p names types] (doseq [[nm t] (map vector names (concat types (repeat nil))) :when nm] (sc/declare! (scope p) (cond-> {:k :var :name nm} t (assoc :ty t))))))

;; ---------------------------------------------------------------------------------------------
;; Classes (clang's ParseClassSpecifier, ParseCXXMemberSpecification)

(defn- parse-bases
  "A base-clause after its :, the class scope `cs` given the bases' scopes: the :bases entries; each base's name (its
  last part's) and whether it is virtual added to `order`."
  [^P p ^Scope cs ^ArrayList order ^HashMap info kw]
  (loop [out []]
    (attr-nodes p)
    (let [[virt acc] (loop [virt false acc nil]
                       (cond (is? p "virtual") (do (adv! p) (recur true acc))
                             (or (is? p "public") (is? p "private") (is? p "protected")) (let [a (ts (cur p))] (adv! p) (recur virt a))
                             :else [virt acc]))
          ;; (round 54, second pass: [class.derived.general]/1, a class-or-decltype takes no typename: GCC's "keyword 'typename'
          ;; not allowed outside of templates" or "in this context", the name after it taken)
          _ (when (is? p "typename")
              (soft-diag! p (ix p) "keyword 'typename' not allowed in this context (the base class is implicitly a type)")
              (adv! p))
          ty (if (is? p "decltype")
               (let [ds (parse-decl-specs p :type-id)] (ds-type ds))
               (let [qn (or (parse-name p :parse) (perr p "a base class"))
                     lp (peek (:parts qn))
                     ;; (h-cpp-read: a class template's name without its arguments names no class, [class.derived.general]/2:
                     ;; GCC's "expected class-name"; the injected-class-name, a class, is not one)
                     en (:ent qn)
                     _ (when (and en (:tmpl en) (not (:tparam en)) (nil? (:args lp)) (not (:inj en)) (not (:inj-full en)) (= :type (:k en)))
                         (soft-diag! p (ix p) (str "expected class-name before '" (ts (cur p)) "' token")))]
                 ;; (cpp-diag-b, 2026-11-22: [class.mi]/3, a class is a direct base at most once: GCC's "duplicate base type 'a'
                 ;; invalid", at the name)
                 (when (and (:s lp) (not (skim? p)) (main-tok? p (long (:i lp))) (nil? (:args lp)) (= 1 (count (:parts qn)))
                            (some #(= (:s lp) (first %)) order) (not (:tparam (:ent qn))))
                   (soft-diag! p (long (:i lp)) (str "duplicate base type '" (:s lp) "' invalid")))
                 (sc/add-base! cs (ent-scope (:ent qn)))
                 (.add order [(:s lp) virt])
                 (when info (.add ^ArrayList (.get info :bases) {:ty {:t :n :s (name-str p qn) :ent (:ent qn) :qn qn} :virt virt
                                                                 :acc (or acc (if (= kw "class") "private" "public"))}))
                 ;; (i) a base class template's injected name, found in the derived class, is the base's type
                 (when (and (:args lp) (:ent qn)) (sc/declare! cs {:k :type :name (:s lp) :scope (ent-scope (:ent qn)) :tmpl true :inj-full (name-str p qn)}))
                 (pack-indexed p {:t :n :s (name-str p qn)})))
          pack (accept! p "...")
          b (cond-> {:type {:qualType (qt ty)} :writtenAccess (or acc "none")} virt (assoc :isVirtual true) pack (assoc :isPackExpansion true))
          out (conj out b)]
      (if (accept! p ",") (recur out) out))))

(defn- unnamed-type [^P p ^String kw ^long i]
  {:t :unnamed :kw kw :s (str kw " (unnamed " kw " at " (.-main p) ":" (.-o (tok-at p i)) ")")})

(defn- tparam-records
  "A template's parameters as class template argument deduction asks them: [{:name :ent :dflt :pack :nontype}]."
  [^P p params]
  (mapv (fn [n] (let [nm (:name n)]
                  (cond-> {:name nm :ent (when nm (lookup (scope p) nm)) :dflt (:_dflt n)}
                    (:isParameterPack n) (assoc :pack true)
                    (or (nil? nm) (not= "TemplateTypeParmDecl" (:kind n))) (assoc :nontype true))))
        params))

(defn parse-class-specifier
  "A class-specifier or an elaborated type specifier at its class-key: {:type T :node n}, n the class's node when it
  is defined here or first declared."
  [^P p ds ctx]
  (let [kb (ix p) kw (ts (cur p))
        hdr (stv p THDR)]
    (st! p THDR nil)
    (adv! p)
    (let [attrs (attr-nodes p)
          qn (when (name-start? p) (parse-name p :parse))
          fin (when (and qn (or (id-is? p "final") (id-is? p "__final")) (or (is-at? p 1 "{") (is-at? p 1 ":")
                                                                             ;; (round 54: `final final`, the class-virt-specifier twice)
                                                                             (and (or (id-is-at? p 1 "final") (id-is-at? p 1 "__final")) (or (is-at? p 2 "{") (is-at? p 2 ":")))))
                (let [i (ix p)] (adv! p)
                  (when (or (id-is? p "final") (id-is? p "__final")) (soft-diag! p (ix p) "duplicate virt-specifier") (adv! p))
                  i))
          attrs (into attrs (attr-nodes p))
          defn? (or (is? p "{") (and (is? p ":") (not (is-at? p 1 ":")) (or (nil? qn) (not (#{:member} ctx)) true)))
          ;; (cpp-diag-b, 2026-11-22: [class.pre]/3, a class-head-name's nested-name-specifier names a class or namespace that
          ;; declared the class, the name a class's: a template parameter's qualifier, or a typedef-name, GCC's "invalid class name
          ;; in declaration of 'A::C'", at the name)
          _ (when (and defn? qn (> (count (:parts qn)) 1) (not (skim? p)) (:i (peek (:parts qn))) (main-tok? p (long (:i (peek (:parts qn))))))
              (let [f (first (:parts qn)) fe (when (and (:s f) (not (:g qn))) (lookup (scope p) (:s f))) le (:ent qn)]
                (when (or (:tparam fe)
                          (and le (= :type (:k le)) (some? (:ty le)) (not (:class le)) (not (:tag le)) (not (:tmpl le))))
                  (soft-diag! p (long (:i (peek (:parts qn)))) (str "invalid class name in declaration of '" (name-str p qn) "'")))
                ;; ([class.pre]/3: a class named by a qualified class-head-name is defined in a scope that encloses the qualifier's
                ;; namespace: GCC's "declaration of 'struct O::SO' in namespace 'O::I' which does not enclose 'O'")
                (let [q (:q qn) cur (sc/enclosing (scope p) #{:ns})]
                  (when (and q (= :ns (:k q)) (:scope q) cur (#{:top} ctx)
                             (not (loop [s (:scope q)] (cond (nil? s) false (identical? s cur) true :else (recur (sc/parent-of s))))))
                    (soft-diag! p (long (:i (peek (:parts qn)))) (str "declaration of '" (name-str p qn) "' in a namespace which does not enclose it"))))))]
      (if-not defn?
        (let [nm (when qn (name-plain qn))
              e (or (:ent qn) (when nm (lookup (scope p) nm true)))
              lp (when qn (peek (:parts qn)))
              e (if (and e (= (:at e) (:i lp))) nil e)
              alone (and (is? p ";") (not (:friend ds)))
              ;; (queue 497: [dcl.type.elab]/2 with [basic.lookup.elab], an elaborated-type-specifier whose name lookup finds a
              ;; typedef-name is ill-formed -- one that names a class of its own name aside (`typedef struct D D;`); a
              ;; declaration `struct B;` only against a typedef of its own scope: GCC's "using typedef-name 'B' after 'struct'")
              qual? (and qn (< 1 (count (:parts qn))) (not (:g qn)) (not-any? :args (:parts qn)))
              te (if qual?
                   (let [ps (:parts qn)]
                     (reduce (fn [e part] (when (:scope e) (sc/find-in (:scope e) (:s part)))) (sc/lookup (scope p) (:s (first ps))) (rest ps)))
                   (when (and qn (= 1 (count (:parts qn))) (not (:g qn))) e))
              tn (:s lp)
              _ (when (and te tn (nil? (:args lp)) (not (skim? p))
                           (= :type (:k te)) (not (:tag te)) (not (:class te)) (not (:tparam te)) (not (:tmpl te))
                           (not= tn (some-> (:target te) :name))
                           (or (not alone) qual? (identical? te (sc/find-in (sc/decl-scope (scope p)) tn true))))
                  (soft-diag! p (long (:i lp)) (str "using typedef-name '" tn "' after '" kw "'")))
              ;; (cpp-read, 2026-11-22: [dcl.type.elab]/2, an elaborated-type-specifier naming an alias template's
              ;; specialization: GCC's "using alias template specialization 'X<int>' after 'struct'", at the name)
              _ (when (and lp (:args lp) e (= :type (:k e)) (:tmpl e) (not (:tag e)) (not (:class e)) (not (:tparam e)) (not (:inj e))
                           (not (skim? p)) (main-tok? p (long (:i lp))))
                  (soft-diag! p (long (:i lp)) (str "using alias template specialization '" tn "<...>' after '" kw "'")))
              spec (and alone hdr (:args lp))
              new? (and nm (nil? (:args lp)) (or alone (nil? e)))
              n (when (and (or new? spec) (not (:friend ds)) (not (skim? p)))
                  (node p "CXXRecordDecl" kb (:e qn) (cond-> {:tagUsed kw :name (or nm (:s lp)) :loc (loc p (:i lp))}
                                                       spec (assoc :_args (:args lp) :_qn qn)
                                                       ;; (queue 505, 500-2 (a): a class first declared by an elaborated-type-specifier
                                                       ;; of a declaration with declarators, `struct T { struct S *a; };`: declared in
                                                       ;; the smallest enclosing namespace or block scope, [basic.scope.pdecl]/7.2, as
                                                       ;; the entity is just below; the node stays where it is written, so Sema knows)
                                                       (and new? (not alone)) (assoc :_elab-decl true)
                                                       ;; (cpp-gnu, 2026-11-22: a GNU visibility attribute of the declaration, which
                                                       ;; arbace.repr.cpp.diag/gnu-rules holds to the class's other declarations)
                                                       (some #(= "visibility" (str/replace (str (:_gnu %)) #"^__|__$" "")) attrs)
                                                       (assoc :_vis (some #(when (= "visibility" (str/replace (str (:_gnu %)) #"^__|__$" ""))
                                                                             (some->> (:_arg %) (re-find #"\"([^\"]*)\"") second))
                                                                          attrs)))))]
          (when (and new? (not (:friend ds)))
            (let [ent {:k :type :name nm :tag true :class true :scope (sc/new-scope :class (scope p) nil) :incomplete true :at (:i lp)
                       :tps (:params hdr)
                       :tmpl (boolean (and hdr (pos? (long (:n hdr))) (nil? (:args (peek (:parts qn))))))}]
              (if alone (declare! p ent) (sc/declare! (or (sc/enclosing (scope p) #{:ns :block}) (scope p)) ent))))
          {:type {:t :elab :kw kw :s (if qn (name-str p qn) "") :ent e :kb kb :ni (when lp (:i lp)) :e (when qn (:e qn))} :node n})
        (let [_ (when (and *tid-def* (= ctx :member) (= (count (stv p CLS)) (inc (long *tid-def*))))
                  (soft-diag! p kb (str "types may not be defined " (or *tdef-ctx* "in a type-id"))))
              lp (when qn (peek (:parts qn)))
              nm (:s lp)
              simple (and qn (= 1 (count (:parts qn))) (not (:g qn)))
              ;; a nested class defined outside its class (class locale::_Impl { ... }): its names looked up in the
              ;; enclosing class's scope first ([class.nest]/3, [basic.lookup.unqual]/9; G5), a lookup scope standing for it
              qent (when (and qn (> (count (:parts qn)) 1))
                     (let [ps (butlast (:parts qn))]
                       (reduce (fn [e part] (when (:scope e) (sc/find-in (:scope e) (:s part))))
                               (lookup (scope p) (:s (first ps))) (rest ps))))
              ;; (round 54, third pass: a member class defined out of its class template, [temp.mem]/1 and [temp.class.general]/3:
              ;; its template-head the class template's, or the member template's own after it, and as many parameters, GCC's
              ;; "redeclared with N template parameters" ([temp.over.link]/6); and no default template argument there,
              ;; [temp.param]/12. Not judged when the class has an explicit or partial specialization in the file, whose own
              ;; members these may be, or with a pack)
              _ (when (and hdr qent (nil? (:args lp)) (not (skim? p)) (> (count (:parts qn)) 1))
                  (let [mem (when (:scope qent) (sc/find-in (:scope qent) nm))
                        n (long (:n hdr))
                        qargs (:args (nth (:parts qn) (- (count (:parts qn)) 2)))
                        pk? (or (some :isParameterPack (:params hdr)) (some :isParameterPack (:tps mem)) (some :isParameterPack (:tps qent)))
                        msg (str "redeclared with " n " template parameter" (when (not= n 1) "s"))]
                    (when-not (or pk? (class-specialized? p (:s (nth (:parts qn) (- (count (:parts qn)) 2)))))
                      (cond
                        (and (:tmpl mem) (:tps mem) (not= n (count (:tps mem))))
                        (soft-diag! p (long (:i lp)) msg)
                        (and mem (:class mem) (not (:tmpl mem)) (:tmpl qent) (:tps qent) (pos? n)
                             (= (count (:names hdr)) n) (= (count qargs) (count (:tps qent)))
                             (= (map #(tok-text p (long (:b %)) (long (:e %))) qargs) (take (count qargs) (:names hdr)))
                             (not= n (count (:tps qent))))
                        (soft-diag! p (long (:i lp)) msg)
                        :else nil)
                      (when (and (:tmpl qent) (some (fn [x] (some #(= "TemplateArgument" (:kind %)) (:inner x))) (:params hdr)))
                        (soft-diag! p (long (:i lp)) (str "default argument for template parameter for class enclosing '" (name-str p qn) "'"))))))
              ;; (round 54, fourth pass: [class.pre]/3, a class-head-name with a nested-name-specifier names a class declared before
              ;; in the namespace it nominates (a friend declaration's name is not one, [namespace.memdef]/3): GCC's "'B' in
              ;; namespace 'N' does not name a class"; a class qualifier not judged)
              _ (when (and qent (= :ns (:k qent)) (:scope qent) (nil? (:args lp)) (not (skim? p)) (not (:friend ds))
                           (not-any? :args (:parts qn)) (nil? (sc/find-in (:scope qent) nm true)))
                  (soft-diag! p (long (:i lp)) (str "'" nm "' in namespace '" (str/join "::" (map :s (butlast (:parts qn)))) "' does not name a class")))
              ;; (round 54, sixth pass: [temp.expl.spec]/1, an explicit specialization's class-head-name is a simple-template-id:
              ;; `template<> struct X { };` of a class template X is GCC's "template specifiers not specified in declaration
              ;; of 'X'", at the name)
              _ (when (and hdr (zero? (long (:n hdr))) simple (nil? (:args lp)) (not (skim? p)) (not (:friend ds)))
                  (when-let [te (lookup (scope p) nm true)]
                    (when (and (:tmpl te) (:class te))
                      (soft-diag! p (long (:i lp)) (str "template specifiers not specified in declaration of '" nm "'")))))
              cs (sc/new-scope :class (if (:scope qent) (sc/new-scope :lookup (scope p) qent) (scope p)) nil)
              tmpl (boolean (and hdr (pos? (long (:n hdr))) (nil? (:args lp))))
              ent (cond-> {:k :type :name nm :tag true :class true :scope cs :fields (ArrayList.) :bases-order (ArrayList.)
                           :ftypes (java.util.HashMap.) :union (= kw "union") :info (sema/new-info kw kb)
                           :dep (boolean (or (and hdr (pos? (long (:n hdr)))) (some #(:dep (:ent %)) (stv p CLS))))}
                    tmpl (assoc :tmpl true :tps (:params hdr)))
              _ (when tmpl (.put ^HashMap (:info ent) :tparams (tparam-records p (:params hdr))))
              ;; (CP338 (a): a class declared before its definition, whose entity a typedef took as its target then
              ;; (iosfwd's `typedef basic_streambuf<char> streambuf;`): the declaration's scope looks in the
              ;; definition's, so that a member named through the typedef is found, `int_type` in a class derived from
              ;; std::streambuf, runtime/library.cpp)
              _ (when (and nm simple (nil? (:args lp)))
                  (let [old (sc/find-in (sc/decl-scope (scope p)) nm true)]
                    (when (and (:incomplete old) (:scope old) (not (identical? (:scope old) cs))) (sc/add-base! (:scope old) cs))))
              ;; (round 54, sixth pass: [basic.scope.scope]/4, a class defined in a class scope whose using-declarator named a class
              ;; of that name: GCC's "redefinition of 'struct J::type'", at the name)
              _ (when-let [o (and nm simple (nil? (:args lp)) (not (skim? p)) (= ctx :member)
                                  (get (sc/names-of (sc/decl-scope (scope p))) nm))]
                  (when (and (:udecl o) (= :type (:k o)) (:tag o))
                    (soft-diag! p (long (:i lp)) (str "redefinition of '" kw " " (name-str p qn) "'")))
                  ;; (cpp-decl2: one a using-declarator with a dependent qualifier named, `using BT<T>::S;` in a class template,
                  ;; conflicts with it as g++ 15.2 reports at the instantiation (an enumeration's is PR c++/115806, not reported);
                  ;; lookup/using53.C)
                  (when (and (:udecl-dep o) (#{"struct" "class" "union"} kw))
                    (soft-diag! p (long (:i lp)) (str "'" kw " " (name-str p qn) "' conflicts with a previous declaration"))))
              _ (when (and nm simple (nil? (:args lp))) (declare! p ent))
              ;; (cpp-rt-own: a class declared in a namespace or class and defined outside it by a qualified name, fs_dir.cc's
              ;; `struct fs::_Dir : _Dir_base { ... }` of <bits/fs_dir.h>'s `struct _Dir;`: the definition is the entity its
              ;; qualifier's scope names from then on, its declaration's scope looking in the definition's as CP338's)
              _ (when (and nm (not simple) (nil? (:args lp)) qent (:scope qent))
                  (let [old (sc/find-in (:scope qent) nm true)]
                    (when (and (:incomplete old) (:scope old) (not (identical? (:scope old) cs))) (sc/add-base! (:scope old) cs))
                    (when (:incomplete old) (redeclare-incomplete! (:scope qent) nm ent))))
              ;; (queue 380: an explicit specialization's entity, by its primary's scope and its arguments' text: its
              ;; members defined outside it are looked up in its scope, spec-of-qualifier)
              _ (when (and nm simple (:args lp) hdr (zero? (long (:n hdr))))
                  (when-let [ps (:scope (lookup (scope p) nm))]
                    (let [^java.util.IdentityHashMap m (stv p SPECS)
                          ^HashMap byargs (or (.get m ps) (let [h (HashMap.)] (.put m ps h) h))]
                      (.put byargs (mapv #(arg-str p %) (:args lp)) ent))))
              _ (when nm (sc/declare! cs (cond-> (assoc ent :tag false)
                                          tmpl (assoc :inj (:names hdr))
                                          ;; (a parameter without a name, `template <typename, typename T2> struct bs`: no
                                          ;; argument list to spell it by, so the class's bare name, which the code generator
                                          ;; finds as the injected class name; `bs<T2>` named another specialization, pr77550.C)
                                          (and tmpl (not= (count (:names hdr)) (:n hdr))) (assoc :inj-full nm)
                                          (:args lp) (assoc :tmpl true :inj (mapv #(arg-str p %) (:args lp))))))
              bases (if (accept! p ":") (parse-bases p cs (:bases-order ent) (sema/info ent) kw) [])
              _ (expect! p "{")
              ;; [class.mem]/7: member functions' bodies, default arguments and initializers see the whole class (clang
              ;; parses them after it): its members are declared by a skim of the body before it is parsed
              late (when-not (skim? p)
                     (let [save (ix p) old (stv p CLS)
                           late (sc/new-scope :class (sc/parent-of cs) nil)]
                       (doseq [b (sc/bases-of cs)] (sc/add-base! late b))
                       (doseq [[_ v] (sc/names-of cs)] (sc/declare! late v))
                       (in-scope p late
                         (st! p CLS (cons {:name nm :ent ent :skim true} old))
                         (try (skimming p true (with-gt p true (decl-seq p :member))) (finally (st! p CLS old))))
                       (seek! p save)
                       (.put ^HashMap (sema/info ent) :done true)
                       late))
              cm-uses (when late (HashMap.))
              members (in-scope p cs
                        (let [old (stv p CLS)]
                          (st! p CLS (cons {:name nm :ent ent :late late} old))
                          (try (binding [*this-ok* nil
                                         *cm-scopes* (if late
                                                       (let [m (if *cm-scopes* (java.util.IdentityHashMap. ^java.util.Map *cm-scopes*) (java.util.IdentityHashMap.))]
                                                         (.put m cs [late cm-uses]) m)
                                                       *cm-scopes*)]
                                 (with-gt p true (decl-seq p :member)))
                               (finally (st! p CLS old)))))
              _ (expect! p "}")
              _ (when (skim? p) (.put ^HashMap (sema/info ent) :done true))
              e (last-ix p)
              ;; GNU attributes after the closing brace appertain to the class
              post (when (or (is? p "__attribute__") (is? p "__attribute")) (attr-nodes p))
              fin-n (when fin [(node p "FinalAttr" fin fin {})])
              n (node p "CXXRecordDecl" kb e
                      (cond-> {:tagUsed kw :completeDefinition true :bases bases :inner (vec (concat attrs post fin-n members))
                               :loc (loc p (if lp (long (:i lp)) kb))}
                        (seq cm-uses) (assoc :_cm-uses (into {} cm-uses))
                        nm (assoc :name nm)
                        (:args lp) (assoc :_args (:args lp) :_qn qn)))]
          {:type (if nm {:t :n :s (if simple nm (name-str p qn)) :ent ent} (assoc (unnamed-type p kw kb) :cs cs :ent ent)) :node n})))))

;; ---------------------------------------------------------------------------------------------
;; Enumerations

(defn parse-enum-specifier [^P p ds ctx]
  (let [kb (ix p)]
    (adv! p)
    (let [scoped (cond (accept! p "class") "class" (accept! p "struct") "struct" :else nil)
          attrs (attr-nodes p)
          qn (when (name-start? p) (parse-name p :parse))
          nm (when qn (:s (peek (:parts qn))))
          fixed (when (and (is? p ":") (not (is-at? p 1 ":")) (let [save (ix p)] (adv! p) (let [r (decl-spec-start? p)] (seek! p save) r)))
                  (adv! p)
                  ;; (queue 377: [dcl.enum]/1's enum-base, a type-specifier-seq, defines no class or enumeration: GCC's "types may not be
                  ;; defined in enum-base", at the definition's brace; enum_base4.C's `: union enum struct c { ... }`)
                  (when-let [bi (and (not (skim? p)) (def-brace p (ix p)))]
                    (soft-diag! p bi "types may not be defined in enum-base"))
                  (parse-type-specs p :type-id))
          body? (is? p "{")
          ;; (cpp-decl2: [dcl.type.elab]/1 and [dcl.enum]/2: an elaborated-type-specifier names an enumeration by `enum` alone,
          ;; and an enum-base belongs to an opaque-enum-declaration or a definition: GCC's "scoped enum must not use 'class'
          ;; keyword", "declaration of enumeration with fixed underlying type", at `enum`; cpp0x/forw_enum6.C)
          ;; (cpp-rind: an unnamed one's enum-base likewise, `enum : int a;`, [dcl.enum]/2's opaque-enum-declaration names its
          ;; enumeration; cpp0x/enum40.C)
          _ (when (and (or qn fixed) (not body?) (not (is? p ";")) (not (skim? p)) (main-tok? p kb))
              (cond scoped (soft-diag! p kb "scoped enum must not use 'class' keyword")
                    fixed (soft-diag! p kb "declaration of enumeration with fixed underlying type")
                    :else nil))]
      (if (and (not body?) (not fixed) (not (and scoped (is? p ";"))))
        (let [e (or (:ent qn) (when nm (lookup (scope p) nm true)))]
          (when (and nm (nil? e)) (sc/declare! (or (sc/enclosing (scope p) #{:ns :block}) (scope p)) {:k :type :name nm :tag true :scope (sc/new-scope :enum (scope p) nil)}))
          {:type {:t :elab :kw "enum" :s (if qn (name-str p qn) "") :ent e} :node nil})
        (let [_ (when (and qn (> (count (:parts qn)) 1) (nil? (:ent qn))
                           ;; (cpp-rind: the class being defined named with its template arguments, `enum D2<T>::A`, is that class
                           ;; too: cpp0x/forw_enum13.C)
                           (or (not-any? :args (:parts qn))
                               (and (= 2 (count (:parts qn))) (not-any? :args (rest (:parts qn)))
                                    (= (:s (first (:parts qn))) (some-> (stv p CLS) first :name))))
                           (when-let [q (lookup (scope p) (:s (first (:parts qn))))] (not (:tparam q))))
                  ;; (round 54, second pass: [dcl.enum]/4, a qualified enum-head-name names an enumeration declared before in the
                  ;; class or namespace its nested-name-specifier nominates: GCC's "'bar' in 'class foo' does not name an enumeration")
                  (soft-diag! p (long (:i (peek (:parts qn)))) (str "'" nm "' in '" (str/join "::" (map :s (butlast (:parts qn)))) "' does not name an enumeration")))
              ;; (cpp-read, 2026-11-22: [dcl.enum]/4 and [dcl.type.elab]/3, a qualified enum-head-name that finds a typedef-name:
              ;; GCC's "using typedef-name 'A' after 'enum'", at the name)
              _ (when (and qn (or (:g qn) (> (count (:parts qn)) 1)) (type-ent? (:ent qn)) (not (:tag (:ent qn))) (not (:tparam (:ent qn)))
                           (not (skim? p)) (main-tok? p (long (:i (peek (:parts qn))))))
                  (soft-diag! p (long (:i (peek (:parts qn)))) (str "using typedef-name '" nm "' after 'enum'")))
              es (sc/new-scope :enum (scope p) nil)
              ent {:k :type :name nm :tag true :scope es}
              ;; (cpp-decl2: [basic.scope.scope]/4, an enumeration defined in a class scope whose using-declarator named an
              ;; enumeration of that name: GCC's "multiple definition of 'enum D::E'", at the name; lookup/using53.C)
              _ (when-let [o (and nm body? (= 1 (count (:parts qn))) (not (skim? p)) (= ctx :member)
                                  (get (sc/names-of (sc/decl-scope (scope p))) nm))]
                  (when (and (:udecl o) (= :type (:k o)) (:tag o))
                    (soft-diag! p (long (:i (peek (:parts qn)))) (str "multiple definition of 'enum " nm "'"))))
              _ (when (and nm (= 1 (count (:parts qn)))) (declare! p ent))
              cs (when body?
                   (adv! p)
                   (with-gt p true
                     (loop [out []]
                       (cond
                         (is? p "}") (do (adv! p) out)
                         (is? p ",") (do (adv! p) (recur out))
                         (id? p)
                         (let [b (ix p) cn (ts (cur p))]
                           (adv! p)
                           (let [as (attr-nodes p)
                                 x (when (accept! p "=") (if (skim? p) (do (skip-until! p #{"," "}"}) nil) (parse-cond-expr p)))
                                 n (node p "EnumConstantDecl" b (last-ix p) {:name cn :loc (loc p b) :inner (vec (concat as (when x [x])))})]
                             (sc/declare! es {:k :var :name cn :enumerator true})
                             (when-not scoped (declare! p {:k :var :name cn :enumerator true}))
                             (recur (conj out n))))
                         :else (perr p "an enumerator")))))
              e (last-ix p)
              post (when (and body? (or (is? p "__attribute__") (is? p "__attribute"))) (attr-nodes p))
              n (node p "EnumDecl" kb e (cond-> {:inner (vec (concat attrs post cs)) :loc (loc p (if qn (long (:i (peek (:parts qn)))) kb))}
                                         nm (assoc :name nm)
                                         ;; (queue 492: a qualified enum-head-name's qualifier, `enum C::D : int { y };`, the
                                         ;; class or namespace whose member it defines, [dcl.enum]/1)
                                         (and qn (> (count (:parts qn)) 1) (every? :s (pop (:parts qn))) (not-any? :args (pop (:parts qn))))
                                         (assoc :_equal (mapv :s (pop (:parts qn))))
                                         scoped (assoc :scopedEnumTag scoped)
                                         ;; (cpp-decl2: a definition, its enumerator list written, empty or not: diag's enum-redecls)
                                         body? (assoc :_body true)
                                         fixed (assoc :fixedUnderlyingType {:qualType (qt fixed)})
                                         (and scoped (not fixed)) (assoc :fixedUnderlyingType {:qualType "int"})))]
          {:type (if nm {:t :n :s (name-str p qn) :ent ent} (unnamed-type p "enum" kb)) :node n})))))

;; ---------------------------------------------------------------------------------------------
;; Simple declarations: variables, functions, typedefs (clang's ParseDeclGroup, ParseFunctionDefinition)

(defn- skip-init!
  "Skim mode: an initializer skipped to the , or ; that ends it; `one?`: a template's declaration, whose
  init-declarator-list has one declarator ([temp.pre]/5), so that a , ends nothing (cpp-s4: variant's
  `__not_self = !is_same_v<__remove_cvref_t<_Tp>, variant>;`, whose template argument list's , had ended it and
  declared a variable `variant` that hid the injected-class-name from the delegating constructors' mem-initializers)."
  ([^P p] (skip-init! p false))
  ([^P p one?]
  (loop [d 0]
    (let [^T t (cur p)]
      (cond (identical? :eof (.-k t)) nil
            (and (zero? d) (or (and (not one?) (t= t ",")) (t= t ";"))) nil
            (and (zero? d) (t= t "}")) nil
            (or (t= t "(") (t= t "[") (t= t "{")) (do (skip-balanced! p) (recur d))
            :else (do (adv! p) (recur d)))))))

(defn- init-order
  "The mem-initializers `inits` in clang's order, the initialization's ([class.base.init]/13): the virtual bases, the
  other direct bases, the members, as the class `ce` declares them; one it does not name keeps its place after them."
  [inits ce]
  (let [bases (vec (:bases-order ce))
        fields (vec (:fields ce))
        nm-of (fn [i] (or (get-in i [:anyInit :name])
                          (some-> (get-in i [:baseInit :qualType]) (str/replace #"<.*$" "") (str/split #"::") last)))
        key (fn [[k i]]
              (let [n (nm-of i)
                    vb (keep-indexed (fn [j [b v]] (when (and v (= b n)) j)) bases)
                    nb (keep-indexed (fn [j [b v]] (when (and (not v) (= b n)) j)) bases)
                    fi (keep-indexed (fn [j f] (when (= f n) j)) fields)]
                (cond (seq vb) [0 (first vb)] (seq nb) [1 (first nb)] (seq fi) [2 (first fi)] :else [3 k])))]
    (if (or (<= (count inits) 1) (and (empty? fields) (empty? bases))
            (some #(= 3 (first (key [0 %]))) inits))
      inits
      (mapv second (sort-by key (map-indexed vector inits))))))

(defn- ctor-inits
  "A ctor-initializer's mem-initializers, the : consumed: CXXCtorInitializer nodes; a braced initializer in its semantic
  form by the member's or the base's type (the class `ce`'s)."
  [^P p ce]
  (loop [out []]
    ;; (round 54, second pass: [class.base.init]/1, a mem-initializer-id is a class-or-decltype or an identifier, no typename:
    ;; GCC's "keyword 'typename' not allowed in this context (the base class is implicitly a type)", the name after it taken)
    (when (is? p "typename")
      (soft-diag! p (ix p) "keyword 'typename' not allowed in this context (the base class is implicitly a type)")
      (adv! p))
    (let [mb (ix p)
          qn (or (parse-name p :parse) (if (is? p "decltype") (do (parse-decl-specs p :type-id) nil) (perr p "a mem-initializer")))
          ib (ix p)
          ;; (cpp-read, 2026-11-22: [temp.variadic]/5, a function parameter pack named in a mem-initializer-id's decltype is
          ;; expanded only by the mem-initializer's ...: GCC's "parameter packs not expanded with '...'", at the decltype)
          _ (when (and (nil? qn) (not (skim? p)) (main-tok? p mb)
                       (some (fn [i] (let [^T t (tok-at p i)]
                                       (and (identical? :id (.-k t)) (= :pk (:t (:ty (lookup (scope p) (.-s t))))))))
                             (range mb ib))
                       (let [c (when (is? p "(") (let [s0 (ix p)] (skip-balanced! p) (let [r (is? p "...")] (seek! p s0) r)))
                             b (when (is? p "{") (let [s0 (ix p)] (skip-balanced! p) (let [r (is? p "...")] (seek! p s0) r)))]
                         (not (or c b))))
              (soft-diag! p mb "parameter packs not expanded with '...'"))
          mt (when qn
               (if (and (name-plain qn) (nil? (:args (peek (:parts qn)))) (not (type-ent? (:ent qn))))
                 (some-> ^java.util.Map (:ftypes ce) (.get (name-plain qn)))
                 (when (type-ent? (:ent qn)) {:t :n :s (name-str p qn) :ent (:ent qn) :qn qn})))
          x (if (is? p "{")
              (let [l (parse-braced-init p)] (if mt (designate p mt l) l))
              (let [as (paren-args p)]
                (cond (and (empty? as)) {:kind "ImplicitValueInitExpr"}
                      (and (= 1 (count as)) (not (is? p "..."))) (if mt (paren-init p mt (first as)) (first as))
                      :else (node p "ParenListExpr" ib (last-ix p) {:inner as}))))
          _ (accept! p "...")
          ;; a member's name, else a base's or the class's own (a delegating constructor's): clang prints the latter as a type
          who (cond
                (and qn (name-plain qn) (nil? (:args (peek (:parts qn)))) (not (type-ent? (:ent qn))))
                {:anyInit {:name (name-plain qn)}}
                ;; the class's own name: a delegating constructor (clang's CXXCtorInitializer::isDelegatingInitializer)
                (and qn ce (type-ent? (:ent qn)) (= (:name (:ent qn)) (:name ce)) (= 1 (count (:parts qn))) (nil? (:args (peek (:parts qn)))) (not (or (in-template? p) (dep-this? p))))
                {:delegatingInit {:qualType (name-str p qn)}}
                :else {:baseInit {:qualType (if qn (name-str p qn) "decltype")}})
          ;; (cpp-ce3: its range, the checker's place of its constructor call's errors; a private key, no tree check reads it)
          out (conj out (merge {:kind "CXXCtorInitializer" :inner [x] :_range (rng p mb (last-ix p))} who))]
      (if (accept! p ",") (recur out) out))))

(defn- spec-of-qualifier
  "queue 380 (W3d): the entity of the explicit specialization a qualified declarator-id's qualifier names, X<char> of
  `X<char>::f`, when one was defined ([temp.expl.spec]: its members' definitions are looked up in the specialization's
  scope, not the primary's: __basic_file<char>::open's `__basic_file*`, ctype<wchar_t>'s __wmask_type), else `e`."
  [^P p qn e]
  (let [qp (last (butlast (:parts qn)))
        ^java.util.IdentityHashMap m (stv p SPECS)]
    (or (when (and m (:args qp) (:scope e))
          (when-let [^HashMap byargs (.get m (:scope e))] (.get byargs (mapv #(arg-str p %) (:args qp)))))
        e)))

(defn- class-of-qualifier
  "The class entity a qualified declarator-id's qualifier names (an out-of-class member's), or nil."
  [^P p qn]
  (let [e (:q qn)] (when (type-ent? e) (spec-of-qualifier p qn e))))

(defn- with-late*
  "Runs f with the class being defined's complete scope (its pre-skim's) looked up first: a member function's body, a
  default member initializer ([class.mem]/7)."
  [^P p f]
  (if-let [late (:late (class-ctx p))]
    (in-scope p (sc/new-scope :lookup (scope p) {:scope late}) (f))
    (f)))

(defn- fn-body
  "A function's body at the cursor ({, try, or : and mem-initializers): [inits body], the parameters `names` in scope,
  the class `cls` (an out-of-class member's) looked up through."
  [^P p names cls ctor & [types]]
  (let [run (fn []
              (with-scope p :fparams nil
                (declare-params! p names types)
                ;; a function-try-block: `try` before a constructor's mem-initializers ([dcl.fct.def.general]/1; cpp-90: the
                ;; mem-initializers were looked for first, and `try : m(x) {` was skimmed from the colon)
                (let [tb (when (is? p "try") (let [b (ix p)] (adv! p) b))
                      inits (when (accept! p ":")
                              (if (skim? p) (do (skip-until! p #{"{"}) nil)
                                  (let [ce (or cls (:ent (class-ctx p)))] (init-order (ctor-inits p ce) ce))))]
                  (cond
                    tb
                    (if (skim? p)
                      (do (skip-balanced! p) (loop [] (when (is? p "catch") (adv! p) (skip-balanced! p) (skip-balanced! p) (recur))) [inits nil])
                      (let [[body hs] (try-rest p)] [inits (node p "CXXTryStmt" tb (ne (peek hs)) {:inner (into [body] hs)})]))
                    (skim? p) (do (skip-balanced! p) [inits nil])
                    :else [inits (binding [*in-if* false] (parse-compound-stmt p))]))))]
    (if cls
      (in-scope p (sc/new-scope :lookup (scope p) cls) (run))
      (with-late* p run))))

(defn- returns-lambda?
  "Whether the function body `n` returns a lambda-expression (outside the lambdas it holds)."
  [n]
  (letfn [(w [n] (and (map? n) (not= "LambdaExpr" (:kind n))
                      (or (and (= "ReturnStmt" (:kind n))
                               (= "LambdaExpr" (:kind (loop [x (first (:inner n))] (if (= "ParenExpr" (:kind x)) (recur (first (:inner x))) x)))))
                          (boolean (some w (:inner n))))))]
    (boolean (w n))))

(defn- virt-specifiers
  "override, final (and GNU's __final) after a member function's declarator: their attribute nodes."
  [^P p]
  (loop [out []]
    ;; (round 54: [class.mem.general]/1's virt-specifier-seq, each virt-specifier at most once, [class.mem.general]/14: GCC's
    ;; "duplicate virt-specifier")
    (let [dup! (fn [k] (when (some #(= k (:kind %)) out) (soft-diag! p (ix p) "duplicate virt-specifier")))]
      (cond (id-is? p "override") (let [i (ix p)] (dup! "OverrideAttr") (adv! p) (recur (conj out (node p "OverrideAttr" i i {}))))
            (or (id-is? p "final") (id-is? p "__final")) (let [i (ix p)] (dup! "FinalAttr") (adv! p) (recur (conj out (node p "FinalAttr" i i {}))))
            :else out))))

(defn- skip-asm-label! [^P p]
  (when (and (or (is? p "asm") (is? p "__asm__") (is? p "__asm")) (is-at? p 1 "("))
    ;; (h-cpp-read: GNU's asm label is a string-literal, GCC's "expected string-literal")
    (when-not (or (identical? :str (tk (nxt p 2))) (is-at? p 2 "(")) (soft-diag! p (+ (ix p) 2) "expected string-literal"))
    (adv! p) (skip-balanced! p)))

(defn- decl-kind
  "The node kind of a function declarator named `qn` (`lp` its last part) in context `ctx`."
  [^P p ctx ds qn lp ctor guide]
  (cond
    guide "CXXDeductionGuideDecl"
    ctor "CXXConstructorDecl"
    (:dtor lp) "CXXDestructorDecl"
    (:conv lp) "CXXConversionDecl"
    (:friend ds) "FunctionDecl"
    (= ctx :member) "CXXMethodDecl"
    (class-of-qualifier p qn) "CXXMethodDecl"
    (and (:q qn) (some :args (butlast (:parts qn)))) "CXXMethodDecl"
    :else "FunctionDecl"))

(defn- fn-name ^String [^P p lp ctor guide]
  (cond
    guide (str "<deduction guide for " (:s lp) ">")
    (:dtor lp) (str "~" (:dtor lp))
    (:conv lp) (str "operator " (qt (:conv lp)))
    (:op lp) (if (re-find #"^[a-z]" (:op lp)) (str "operator " (:op lp)) (str "operator" (:op lp)))
    (:lit lp) (str "operator\"\"" (:lit lp))
    :else (:s lp)))

(defn- parse-decomposition
  "A structured binding declaration after its decl-specifiers: the DecompositionDecl node."
  [^P p ds ctx base]
  (let [ref (cond (accept! p "&") :lr (accept! p "&&") :rr :else nil)
        li (ix p)
        ;; (cpp-read, 2026-11-22: structured bindings are C++17's, [dcl.struct.bind]: GCC's pedwarn "structured bindings only
        ;; available with -std=c++17 or -std=gnu++17" before it, at the [)
        _ (when (and (< (.-year p) 2017) (not (skim? p)) (main-tok? p li))
            (pedantic-diag! p li "structured bindings only available with -std=c++17 or -std=gnu++17"))
        _ (expect! p "[")
        names (loop [out []]
                (cond (is? p "]") (do (adv! p) out)
                      (is? p ",") (do (adv! p) (recur out))
                      (is? p "...") (do (adv! p) (recur out))
                      (id? p) (let [nm (ts (cur p)) i (ix p)] (adv! p) (attr-nodes p) (recur (conj out [nm i])))
                      :else (perr p "a structured binding")))
        ib (ix p)
        [x init] (cond
                   (= ctx :for-range) [nil nil]
                   (accept! p "=") [(if (skim? p) (do (skip-init! p) nil) (parse-init-clause p)) "c"]
                   (is? p "{") [(if (skim? p) (do (skip-balanced! p) nil) (parse-braced-init p)) "list"]
                   (is? p "(") (let [ab (ix p) as (paren-args p)] [(if (= 1 (count as)) (first as) (node p "ParenListExpr" ab (last-ix p) {:inner as})) "call"])
                   :else [nil nil])
        ;; (cpp-read, 2026-11-22: [dcl.struct.bind]/1 with [basic.scope.pdecl]: a binding is declared before its initializer, so a
        ;; use of its name there is of a binding whose type is not deduced yet, GCC's "use of 'x' before deduction of 'auto'")
        _ (when (and x (not (skim? p)) (main-tok? p ib))
            (let [nms (set (map first names))]
              (when-let [i (first (filter (fn [i] (let [^T t (tok-at p i) ^T pv (tok-at p (dec i))]
                                                    (and (identical? :id (.-k t)) (nms (.-s t))
                                                         (not (or (t= pv ".") (t= pv "->") (t= pv "::"))))))
                                          (range ib (ix p))))]
                (soft-diag! p i (str "use of '" (ts (tok-at p i)) "' before deduction of 'auto'")))))
        ty (cond-> base ref (#(hash-map :t ref :of %)))
        bs (mapv (fn [[nm i]] (declare! p {:k :var :name nm}) {:kind "BindingDecl" :name nm :loc (loc p i)}) names)]
    (node p "DecompositionDecl" (:b ds) (last-ix p)
          (cond-> {:loc (loc p li) :type {:qualType (qt ty)} :inner (vec (concat (when x [x]) bs))}
            init (assoc :init init)
            (:storage ds) (assoc :storageClass (:storage ds))))))

(defn parse-simple-decl
  "A simple-declaration (or a function definition, a member-declaration) at the cursor in context `ctx` (:top,
  :member, :block): its nodes, the ; consumed."
  [^P p ctx]
  (let [tmpl (stv p THDR)
        b0 (ix p)
        ds (parse-decl-specs p ctx)
        _ (st! p THDR nil)
        pre (:tag-node ds)
        base0 (ds-type ds)]
    (cond
      (and (is? p ";") pre (= :unnamed (:t base0)) (:cs base0) (#{"union" "struct"} (:kw base0)) (not (:typedef ds)))
      ;; an anonymous union or struct: an implicit object of its type (a member in a class), its members the scope's
      (let [e (:e ds)]
        ;; (round 54, sixth pass: [dcl.pre]/5, a declaration with no declarator declares a class's name, or is an anonymous
        ;; union ([class.union.anon]/1): an unnamed struct with none outside a class is GCC's "abstract declarator
        ;; '<unnamed struct>' used as declaration" (its anonymous structs, an extension, are members of a named class), at the
        ;; `;`; and within anonymous classes alone, "anonymous struct not inside named type", at its brace)
        (when (and (= "struct" (:kw base0)) (not (skim? p)))
          (cond
            (not= ctx :member) (soft-diag! p (ix p) "abstract declarator '<unnamed struct>' used as declaration")
            ;; (the outermost of the anonymous classes declares no object either: GCC names an unnamed class by its first
            ;; declarator or typedef, `struct { struct { int a; }; } d;`)
            (let [ncls (loop [s (scope p) n 0] (if (or (nil? s) (#{:ns :block} (sc/kind-of s))) n (recur (sc/parent-of s) (if (= :class (sc/kind-of s)) (inc n) n))))]
              (and (pos? ncls) (<= ncls (count (take-while #(nil? (:name %)) (stv p CLS))))
                   (let [n (.-cnt p)
                         j (loop [j (inc (ix p)) d 0]
                             (cond (>= j n) nil
                                   (t= (tok-at p j) "{") (recur (inc j) (inc d))
                                   (t= (tok-at p j) "}") (if (= d (- 1 ncls)) j (recur (inc j) (dec d)))
                                   :else (recur (inc j) d)))]
                     (and j (t= (tok-at p (inc j)) ";")))))
            (soft-diag! p (long (or (first (filter #(t= (tok-at p %) "{") (range (long (:b ds)) (ix p)))) (:b ds))) "anonymous struct not inside named type")
            ;; (and a member of a named class, GNU's extension: GCC's pedwarn "ISO C++ prohibits anonymous structs", -Wpedantic's,
            ;; at the brace)
            :else (soft-diag! p (long (or (first (filter #(t= (tok-at p %) "{") (range (long (:b ds)) (ix p)))) (:b ds))) "pedantic-w: ISO C++ prohibits anonymous structs")))
        ;; ([class.union.anon]/1: an anonymous union's member-specification defines non-static data members; none is GCC's
        ;; "anonymous union with no members", at the `;`)
        (when (and (= "union" (:kw base0)) (not (skim? p))
                   (not-any? #(#{"FieldDecl" "VarDecl" "IndirectFieldDecl"} (:kind %)) (:inner pre)))
          (soft-diag! p (ix p) "anonymous union with no members"))
        (adv! p)
        (when (and (= ctx :member) (skim? p))
          (let [ce (:ent (class-ctx p)) nm (str "\u0001anon" (count (:fields ce)))]
            (when-let [^ArrayList fs (:fields ce)] (.add fs nm))
            (when-let [^java.util.HashMap ft (:ftypes ce)] (.put ft nm base0))))
        (doseq [[k v] (sc/names-of (:cs base0)) :when (#{:var :fn} (:k v))]
          (declare! p (cond-> {:k :var :name k} (not= ctx :member) (assoc :anon true))))
        [pre (node p (if (= ctx :member) "FieldDecl" "VarDecl") (:b ds) e {:isImplicit true :type {:qualType (qt base0)}})])
      ;; C++26's friend-type-specifier-list: friend T, Us...;
      (and (:friend ds) base0 (nil? pre) (or (is? p ",") (and (is? p "...") (or (is-at? p 1 ";") (is-at? p 1 ",")))))
      (loop [t base0 tb (:b ds) out []]
        (let [pack (accept! p "...")
              te (last-ix p)
              out (conj out (node p "FriendDecl" (:b ds) te (cond-> {:type {:qualType (qt t)} :loc (loc p tb)} pack (assoc :isPackExpansion true))))]
          (if (accept! p ",")
            (let [b2 (ix p) t2 (parse-type-specs p :friend)] (recur t2 b2 out))
            (do (expect! p ";") out))))
      (or (is? p ";") (:semi-missing ds))
      (do ;; (round 54, sixth pass: [dcl.type.cv]/1, a declaration's cv-qualifier wants a declarator: GCC's "'const' can only be
          ;; specified for objects and functions", at the qualifier; a class or enumeration declared with none)
          (when (and (:cv-i ds) (or pre (= :elab (:t base0))) (not (:typedef ds)) (not (:friend ds)))
            (soft-diag! p (long (:cv-i ds)) (str "'" (ts (tok-at p (long (:cv-i ds)))) "' can only be specified for objects and functions")))
          ;; (cpp-decl2: [dcl.spec]'s specifiers that want a declarator before a class or enumeration declared with none,
          ;; [dcl.pre]/5 with [dcl.inline]/1, [dcl.fct.spec]/3 (explicit), [dcl.stc]/1 (thread storage), [dcl.constexpr]/1:
          ;; GCC's "'inline' can only be specified for functions", "'explicit' can only be specified for constructors", "'__restrict'
          ;; can only be specified for objects and functions", "'__thread' can only be specified for objects and functions",
          ;; "'constexpr' cannot be used for type declarations", at the specifier; cpp0x/decl-loc1.C)
          (when (and (or pre (= :elab (:t base0))) (not (:typedef ds)) (not (:friend ds)) (not (skim? p)) (#{:top :member :block} ctx))
            (when-let [i (first (filter #(#{"inline" "explicit" "__restrict" "__restrict__" "__thread" "thread_local" "constexpr" "consteval" "constinit"} (ts (tok-at p %)))
                                        (take-while #(not (#{"struct" "class" "union" "enum" "{" "typename"} (ts (tok-at p %))))
                                                    (range (long (:b ds)) (ix p)))))]
              (let [w (ts (tok-at p (long i)))]
                (soft-diag! p (long i) (case w
                                         "inline" "'inline' can only be specified for functions"
                                         "explicit" "'explicit' can only be specified for constructors"
                                         ("constexpr" "consteval" "constinit") (str "'" w "' cannot be used for type declarations")
                                         (str "'" w "' can only be specified for objects and functions"))))))
          ;; (cpp-read, 2026-11-22: an alignment-specifier alone before ; in a block, no declaration it appertains to ([dcl.align]/1;
          ;; a block-declaration is no attribute-declaration): GCC's "expected unqualified-id before ';' token", parse/error58.C)
          (when (and (nil? base0) (nil? pre) (= ctx :block) (not (skim? p))
                     (some #(contains? #{"alignas" "_Alignas"} (ts (tok-at p %))) (range (long (:gb ds)) (ix p))))
            (soft-diag! p (ix p) "expected unqualified-id before ';' token"))
          ;; (cpp-gnu, 2026-11-22: GNU attributes alone before ; at namespace scope or in a class, no decl-specifier and no
          ;; declarator: a GNU attribute is a decl-specifier of GCC's grammar, not an attribute-declaration ([dcl.pre]/5, the
          ;; init-declarator-list omitted only after a class or an enumeration): GCC's "declaration does not declare anything",
          ;; at the ; -- an error at namespace scope (-fpermissive's), a pedwarn in a class, as ext/attrib45.C)
          (when (and (nil? base0) (nil? pre) (not (:friend ds)) (#{:top :member} ctx) (not (:semi-missing ds)) (not (skim? p))
                     (not (:storage ds)) (not (:c ds)) (not (:v ds))
                     (some #(contains? #{"__attribute__" "__attribute"} (ts (tok-at p %))) (range (long (:gb ds)) (ix p))))
            (if (= ctx :top)
              (soft-diag! p (ix p) "declaration does not declare anything")
              (pedantic-diag! p (long (:gb ds)) "declaration does not declare anything")))
          ;; (cpp-read: a class definition whose ; GCC inserts, want-semicolon?: the declaration ends at its })
          (when-not (:semi-missing ds) (adv! p))
          (cond (and (nil? base0) (nil? pre) (not (:friend ds)) (= ctx :top) (> (long (:b ds)) b0)) [(node p "EmptyDecl" (last-ix p) (last-ix p) {})]
                (:friend ds) [(node p "FriendDecl" (:b ds) (:e ds)
                                    (cond-> {:type {:qualType (qt (or base0 {:t :n :s ""}))} :loc (loc p (:e ds))}
                                      (and (= :elab (:t base0)) (:ni base0) (#{"class" "struct" "union"} (:kw base0)))
                                      (assoc :_elab {:kw (:kw base0) :kb (:kb base0) :ni (:ni base0) :e (:e base0)}
                                             :_name (ts (tok-at p (long (:ni base0)))))))]
                pre [pre]
                ;; n-cpp-bd (round 54): decl-specifiers that name a type but declare no class or enumeration and no declarator
                ;; (`typedef_A;`, `int;`) declare nothing: [dcl.pre]/5 lets the init-declarator-list be omitted only for a class
                ;; or an enumeration, [class.mem.general]/3 the member-declarator-list only after a class-specifier, an
                ;; enum-specifier or in a friend declaration. GCC's "declaration does not declare anything": an error in a
                ;; class (ext/anon-struct2.C, ext/anon-struct3.C), a pedwarn elsewhere
                ;; (second pass: GNU's typeof of a class's name names that class, as its elaborated name would: decltype7.C's
                ;; `__typeof__ (B);`)
                (and base0 (not (#{:elab :unnamed} (:t base0)))
                     (not (when-let [[_ _ w] (re-matches #"(__typeof__|__typeof|typeof)\((\w+)\)" (str (:s base0)))]
                            (let [en (lookup (scope p) w)] (and (type-ent? en) (or (:tag en) (:inj en) (:inj-full en) (some? (:scope en))))))))
                (do (if (= ctx :member)
                            (soft-diag! p (long (:b ds)) "declaration does not declare anything")
                            (pedantic-diag! p (long (:b ds)) "declaration does not declare anything"))
                          [])
                :else []))
      (and base0 (= :auto (:t (:type ds))) (or (and (is? p "[") (not (is-at? p 1 "["))) (and (or (is? p "&") (is? p "&&")) (is-at? p 1 "["))))
      (do ;; (cpp-read, 2026-11-22: [dcl.pre]/6 and [dcl.struct.bind]/1, a structured binding declaration is a block's or a
          ;; namespace's simple-declaration of its own: in a class or under a template header GCC's "expected unqualified-id before
          ;; '[' token", at the [)
          (when (and (or (= ctx :member) tmpl) (not (skim? p)) (main-tok? p (ix p)))
            (soft-diag! p (ix p) "expected unqualified-id before '[' token"))
          (let [n (parse-decomposition p ds ctx base0)]
            ;; (another declarator after it, `auto [a, b] = x, c;`, is none of a structured binding declaration's)
            (when (and (is? p ",") (not (skim? p)) (main-tok? p (ix p)))
              (soft-diag! p (ix p) "expected ';' before ',' token")
              (skip-until! p #{";"}))
            (expect! p ";")
            [n]))
      :else
      (loop [out (if pre [pre] [])]
        (let [ctor (and (nil? base0) (ctor-name-here? p (if (= ctx :member) :member :top)))
              guide (and (nil? base0) (guide-here? p))
              aps (ArrayList.)
              d (binding [*auto-params* aps *param-depth* 0] (parse-declarator p (if (= ctx :member) :either :named)))
              ;; (cpp-rind: the declaration's own placeholder parameters, permitted for a function declared at namespace scope or as a
              ;; member of a class that is no local class; a pointer's, a block-scope function's, a local class's member's not)
              _ (when (and (seq aps) (not (skim? p))
                           (or (nil? (fn-suffix-of d)) (= ctx :block)
                               (and (= ctx :member) (loop [^Scope s (scope p)] (when s (if (#{:block :fparams} (sc/kind-of s)) true (recur (sc/parent-of s))))))))
                  (doseq [i aps] (soft-diag! p (long i) "'auto' parameter not permitted in this context")))
              chain (name-chain d)
              qn (:name (last chain))
              lp (peek (:parts qn))
              fs (fn-suffix-of d)
              base (or base0
                       (when (:conv lp) (:conv lp))
                       (when (or ctor (:dtor lp) guide) {:t :b :w ["void"]})
                       (when (and (= ctx :member) (is? p ":")) {:t :b :w ["int"]})
                       ;; (CP338 (a): `main()` with no type, as GCC's grokdeclarator takes it: an int function and a
                       ;; pedantic diagnostic, an error under -pedantic-errors (diagnostic/no-type-1.C), nothing under -w
                       ;; (abi/vbase8-10.C); another name with no type stays the declined permerror, no-type-2.C. clang
                       ;; rejects both)
                       (when (and (= ctx :top) qn (= 1 (count chain)) (= 1 (count (:parts qn))) (= "main" (:s lp)) fs)
                         (pedantic-diag! p (long (:i lp)) "ISO C++ forbids declaration of 'main' with no type")
                         {:t :b :w ["int"]})
                       (perr p "a declaration without a type"))
              ;; (queue 439: GNU's vector_size among the declaration specifiers' attributes makes the specifiers' type the vector
              ;; type, as a typedef's: a function's return, a variable's, a member's or a parameter's, ext/attribute-test-1.C's
              ;; `inline vector uint32_t deadbeef (void) const` and `union u { vector uint32_t v; }`; in the code generator's mode alone:
              ;; the checker refuses vector types, and conversion/simd1.C's overloads on them were answered as on their elements)
              ty (build-type (cond-> base *vector-specs* (vectorized (:attrs ds))) d)
              ni (if qn (long (:i lp)) (ix p))
              nm (when qn (name-plain qn))
              ;; (cpp-rind: [dcl.array]/1, no array of references: GCC's "declaration of 'a' as array of references", at the name)
              _ (when (and (not (skim? p)) (not (:typedef ds)) (main-tok? p ni) (arr-of-ref? ty))
                  (soft-diag! p ni (str "declaration of '" (or nm "") "' as array of references")))
              nn (:s lp)
              e0 (long (:e d))
              ;; (round 54: DR2237, C++20's [class.ctor.general]/1 and [class.dtor]/1: a constructor's or destructor's declarator-id
              ;; is no simple-template-id; GCC's pedwarn, -Wtemplate-id-cdtor)
              _ (when (and fs (>= (.-year p) 2020) (:args lp) (or (and ctor (= ctx :member) (not (and (:friend ds) (> (count (:parts qn)) 1)))) (:dtor lp)))
                  (pedantic-diag! p (long (:i lp)) (str "template-id not allowed for " (if (:dtor lp) "destructor" "constructor") " in C++20")))
              ;; (queue 365: round 54's [temp.variadic]/5 check of a declaration's type naming a pack removed: a lambda's local
              ;; `T y` in a fold over the lambda is valid)
              ;; (round 54: [dcl.stc]/2 (C++14), the register specifier applies to variables alone; GCC's error at every standard)
              _ (when (and fs (not (:a fs)) (= "register" (:storage ds)))
                  (soft-diag! p (long (:b ds)) (str "storage class 'register' invalid for function" (when nm (str " '" nm "'")))))
              ;; (cpp-diag-b, 2026-11-22: [dcl.stc]/4, thread_local applies to variables alone: GCC's "storage class '__thread' invalid
              ;; for function", at the decl-specifiers)
              _ (when (and fs (not (:a fs)) (:tls ds) (not (skim? p)) (not (:typedef ds)))
                  (soft-diag! p (long (:b ds)) (str "storage class 'thread_local' invalid for function" (when nm (str " '" nm "'")))))
              ;; (cpp-diag-b, 2026-11-22: [class.ctor.general]/1, [class.dtor]/1 and [class.conv.fct]/1: a constructor's, destructor's
              ;; or conversion function's declaration has no return type, so no type-specifier and no ptr-operator before the
              ;; declarator-id: GCC's "return type specification for constructor invalid", "return type specified for 'operator
              ;; int'", at the decl-specifiers; [class.ctor.general]/? and [class.dtor]/? neither is static: "constructor cannot be
              ;; static member function"; [class.dtor]/1 a destructor's name is its class's: "declaration of '~A' as member of 'B'",
              ;; "as non-member", "as non-function")
              _ (when (and qn lp (not (skim? p)) (main-tok? p (long (:b ds))) (#{:member :top :block} ctx))
                  (let [parts (:parts qn)
                        np (count parts)
                        cls (:name (class-ctx p))
                        ctor? (and fs (:s lp) (not (:args lp))
                                   (or (and (= ctx :member) (= 1 np) (not (:g qn)) (= (:s lp) cls) (not (:friend ds)))
                                       (and (>= np 2) (= (:s lp) (:s (nth parts (- np 2)))) (:class (:q qn)))))
                        what (cond ctor? "constructor" (:dtor lp) "destructor" (:conv lp) "conv" :else nil)
                        ptrs? (some #(seq (:ptrs %)) chain)]
                    (cond
                      (and what fs (or base0 ptrs?) (not (:typedef ds)))
                      (soft-diag! p (long (:b ds)) (if (= what "conv")
                                                     "return type specified for conversion operator"
                                                     (str "return type specification for " what " invalid")))
                      (and fs (#{"constructor" "destructor"} what) (nil? base0) (or (:c ds) (:v ds)))
                      (soft-diag! p (long (:b ds)) (str "qualifiers are not allowed on declaration of '" (if (= what "destructor") (str "~" (:dtor lp)) (:s lp)) "'"))
                      ;; (a qualified destructor's name: its qualifier a namespace, "is not a class-name"; another class than the
                      ;; one its name names, both classes declared so (no typedef), "as member of")
                      (and (:dtor lp) (string? (:dtor lp)) (>= np 2) (= :ns (some-> (:q qn) :k)))
                      (soft-diag! p (long (:i lp)) (str "'~" (:dtor lp) "' is not a class-name"))
                      (and (:dtor lp) (string? (:dtor lp)) (>= np 2) (:s (nth parts (- np 2))) (not= (:dtor lp) (:s (nth parts (- np 2))))
                           (let [qe (lookup (scope p) (:s (nth parts (- np 2)))) de (lookup (scope p) (:dtor lp))]
                             (and (:class qe) (:class de) (not (:target qe)) (not (:target de)) (not (:tparam qe)) (not (:tparam de)))))
                      (soft-diag! p (long (:i lp)) (str "declaration of '~" (:dtor lp) "' as member of '" (:s (nth parts (- np 2))) "'"))
                      (and fs (#{"constructor" "destructor"} what) (= ctx :member) (= "static" (:storage ds)))
                      (soft-diag! p (long (:b ds)) (str what " cannot be static member function"))
                      ;; ([class.mfct]/2, [class.static.data]/? , [namespace.memdef]/2: a member declared out of its class by a
                      ;; qualified name, in a namespace that encloses the class: else GCC's "definition of 'void foo::f()' is not
                      ;; in namespace enclosing 'foo'")
                      (and (= ctx :top) (>= np 2) (:class (:q qn)) (:scope (:q qn)) (not (:friend ds))
                           (let [cur (sc/enclosing (scope p) #{:ns})]
                             (and cur (not (loop [s (sc/parent-of (:scope (:q qn)))]
                                             (cond (nil? s) false (identical? s cur) true :else (recur (sc/parent-of s))))))))
                      (soft-diag! p (long (:i lp)) (str "definition of '" (name-str p qn) "' is not in namespace enclosing '" (:s (nth parts (- np 2))) "'"))
                      ;; ([dcl.meaning.general]/1: a qualified declarator-id at namespace or class scope alone, and in a class not
                      ;; qualified by the class itself; [class.friend]/? a friend declaration's declarator names a function)
                      (and (= ctx :block) base0 (or (>= np 2) (:g qn)))
                      (soft-diag! p (long (:i lp)) "qualified-id in declaration")
                      ;; (cpp-decl2: [dcl.meaning.general]/1, a declarator-id qualified only outside the namespace of its member:
                      ;; `void ::S () {}` in the global namespace for its own S is GCC's "explicit qualification in declaration of
                      ;; 'void S()'"; one of an inline namespace's members, `void ::R ()` for Z::R, is not; lookup/pr79766.C)
                      (and (= ctx :top) fs (:g qn) (= 1 np) (:s lp) (not (:friend ds))
                           (let [cur (sc/enclosing (scope p) #{:ns})]
                             (and cur (nil? (sc/parent-of cur)) (some? (.get ^java.util.Map (sc/names-of cur) (:s lp))))))
                      (soft-diag! p (long (:i lp)) (str "explicit qualification in declaration of '" (:s lp) "'"))
                      ;; (cpp-decl2: [dcl.meaning.general]/1, a qualified declarator-id names a member of the namespace or of an
                      ;; element of its inline namespace set: two such members of the name (a function's of as many parameters)
                      ;; are GCC's "reference to 'Q::i' is ambiguous", none (a member a using-directive nominates) its "'void
                      ;; R::h()' should have been declared inside 'R'"; cpp0x/inline-ns2.C)
                      (and (= ctx :top) (= 2 np) (not (:g qn)) (= :ns (:k (:q qn))) (:scope (:q qn)) (:s lp) (not (:friend ds))
                           (not (some :args parts))
                           (let [X (:scope (:q qn)) nm (:s lp)
                                 es (loop [todo [X] seen #{} out []]
                                      (if-let [s (first todo)]
                                        (if (contains? seen s)
                                          (recur (rest todo) seen out)
                                          (recur (concat (rest todo) (seq (sc/inline-of s))) (conj seen s)
                                                 (if-let [e (.get ^java.util.Map (sc/names-of s) nm)] (conj out e) out)))
                                        out))
                                 es (if fs (filter #(and (= :fn (:k %)) (= (count (:ptys %)) (count (:types fs)))) es) es)]
                             (or (>= (count es) 2)
                                 (and (empty? es) (some? (sc/find-in X nm))))))
                      (let [X (:scope (:q qn)) nm (:s lp)]
                        (soft-diag! p (long (:i lp)) (if (.get ^java.util.Map (sc/names-of X) nm)
                                                       (str "reference to '" (:s (first parts)) "::" nm "' is ambiguous")
                                                       (if (some? (sc/find-in X nm))
                                                         (if (some #(.get ^java.util.Map (sc/names-of %) nm) (sc/inline-of X))
                                                           (str "reference to '" (:s (first parts)) "::" nm "' is ambiguous")
                                                           (str "'" (:s (first parts)) "::" nm "' should have been declared inside '" (:s (first parts)) "'"))
                                                         (str "reference to '" (:s (first parts)) "::" nm "' is ambiguous")))))

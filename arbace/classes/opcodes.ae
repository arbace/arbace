(ns arbace.classes.opcodes
  "The JVM's access and property flags (JVMS §4.1, §4.5, §4.6, §4.7.6, §4.7.25), the values of
  ASM's Opcodes/ACC_* (arbace.asm.Opcodes until 2026-10-12; ASM left main with the bytecode back
  end, doc/STANDALONE-NOTES.md, S4): a class info's and a member's :flags in the Java forms'
  analysis (arbace.classes) and j2g. Required with the alias Opcodes, so that Opcodes/ACC_PUBLIC
  reads as before. Each is an int (an Integer, as the interface's static fields were), a
  constant the compiler inlines.")

(def ^:const ACC_PUBLIC (int 0x0001))
(def ^:const ACC_PRIVATE (int 0x0002))
(def ^:const ACC_PROTECTED (int 0x0004))
(def ^:const ACC_STATIC (int 0x0008))
(def ^:const ACC_FINAL (int 0x0010))
(def ^:const ACC_SUPER (int 0x0020))
(def ^:const ACC_SYNCHRONIZED (int 0x0020))
(def ^:const ACC_OPEN (int 0x0020))
(def ^:const ACC_TRANSITIVE (int 0x0020))
(def ^:const ACC_VOLATILE (int 0x0040))
(def ^:const ACC_BRIDGE (int 0x0040))
(def ^:const ACC_STATIC_PHASE (int 0x0040))
(def ^:const ACC_VARARGS (int 0x0080))
(def ^:const ACC_TRANSIENT (int 0x0080))
(def ^:const ACC_NATIVE (int 0x0100))
(def ^:const ACC_INTERFACE (int 0x0200))
(def ^:const ACC_ABSTRACT (int 0x0400))
(def ^:const ACC_STRICT (int 0x0800))
(def ^:const ACC_SYNTHETIC (int 0x1000))
(def ^:const ACC_ANNOTATION (int 0x2000))
(def ^:const ACC_ENUM (int 0x4000))
(def ^:const ACC_MANDATED (int 0x8000))
(def ^:const ACC_MODULE (int 0x8000))
(def ^:const ACC_RECORD (int 0x10000))
(def ^:const ACC_DEPRECATED (int 0x20000))

(ns arbace.classes.env
  "The class environment (SPEC §9.2): what the compiler knows about classes, from the class
  forms being compiled, from classes it defined earlier, from the edge's declared classes (j2g)
  and from the class path (by reflection; on a JVM, with constant values and annotations read
  from class files by arbace.classes.jvm). Member lookup with Java's access rules (§5.6)."
  (:require [arbace.string :as str]
            [arbace.set]
            [arbace.classes.types :as t]
            [arbace.classes.opcodes :as Opcodes])
  (:import (java.lang.reflect Field Method Constructor Modifier)))

;; A class info is a map:
;;   {:name "p/C" :flags int :super "java/lang/Object" :interfaces ["p/I" ...]
;;    :fields  [{:name "f" :desc "I" :flags int :owner "p/C" :const v-or-nil} ...]
;;    :methods [{:name "m" :desc "(I)V" :flags int :owner "p/C"} ...]   ; <init> included
;;    :nest-host "p/Outer" :outer "p/Outer"-or-nil}
;; Class declarations being compiled (see arbace.classes.parse) are class infos too.

(def ^:dynamic *compile-set*
  "An atom: internal name -> class declaration, the classes of the current compilation."
  nil)

(defonce ^{:doc "internal name -> class info of the classes this compiler defined or wrote."}
  defined (atom {}))

;; ---------------------------------------------------------------------------------------------
;; reflection

(defn- internal [^Class c] (str/replace (.getName c) "." "/"))

(def ^:dynamic *from-source*
  "nil, or a predicate on internal names: classes that are compiled from their sources and never
  taken from the class path, even when a class of that name is loaded (a stage recompiling
  itself: the runtime's own classes are the ones being compiled, SPEC §9.6)."
  nil)

(defn from-source? [n] (boolean (and *from-source* (*from-source* n))))

(def source-imports
  "An atom: namespace name -> {simple name symbol -> internal name}, the imports of classes that
  are not on the class path (yet) or are compiled from source, which namespaces cannot map."
  (atom {}))

(def ^:dynamic *declared*
  "nil, or the classes outside the forms as data, in place of the class path: {internal name ->
  {:info class-info, facet value ...}} (j2g's edge, jdk/edge.edn: doc/STANDALONE-NOTES.md, S2).
  Bound, no class is loaded and nothing is reflected: a class neither compiled nor declared does
  not exist, and a facet a declared class lacks is an error."
  nil)

(def ^:dynamic *recorded*
  "nil, or an atom of what the class path answered: {internal name -> {facet value}} (:exists
  true for a class loaded), from which j2g writes its edge."
  nil)

(defn record!
  "Records facet value v of class n (when *recorded*); returns v."
  [n facet v]
  (when *recorded* (swap! *recorded* update n assoc facet v))
  v)

(defn load-class
  "The Class of an internal name or array descriptor, without initializing it, or nil. nil for
  classes compiled from source (*from-source*), and for every class when *declared* is bound."
  [n]
  (when-not (or (from-source? n) *declared*)
   (try
    (let [cn (if (str/starts-with? n "[") (str/replace n "/" ".") (str/replace n "/" "."))
          c (arbace.lang.RT/classForNameNonLoading cn)]
      (when (and c *recorded*) (record! n :exists true))
      c)
    (catch ClassNotFoundException _ nil)
    (catch NoClassDefFoundError _ nil))))

(defn known?
  "Is n a class outside the compilation: on the class path, or declared (*declared*)? Not a
  class compiled from source (*from-source*), even when the declared edge also has it: a world
  that holds forms of a class the shipped edge declares (javac's tool build's java.io.DataOutput,
  doc/classes/JAVA-FRONTEND-SURVEY.md, \"As built: JN3\") asks its forms, as load-class does."
  [n]
  (if *declared* (and (contains? *declared* n) (not (from-source? n))) (some? (load-class n))))

(defn reflected
  "Facet `facet` of class n, which is not compiled from source: (f Class) by reflection on the
  class path, recorded (*recorded*); with *declared* bound, the declared value (an error when n
  is declared without it). nil when there is no class n."
  [n facet f]
  (if *declared*
    (when-let [d (get *declared* n)]
      (if-let [e (find d facet)]
        (val e)
        (throw (ex-info (str "Undeclared " (name facet) " of class " (str/replace (str n) "/" ".")
                             ": not in the declared edge (bin/j2g-edge update)")
                        {:class n :facet facet}))))
    (when-let [c (load-class n)]
      (record! n facet (f c)))))

(defn- class-file?
  "Does c come from a class file (on a JVM; the Go build has none)? Its fields' constants and its
  methods' annotations are then read from it, by arbace.classes.jvm (ASM's ClassReader, which
  the frozen jar of arbace-for-java-26 holds: j2g's --record-edge and --jvm-reflection),
  loaded on demand."
  [^Class c]
  (let [ld (or (.getClassLoader c) (ClassLoader/getSystemClassLoader))]
    (when-let [in (.getResourceAsStream ld (str (internal c) ".class"))]
      (.close in)
      true)))

(defn- read-fields
  "The fields of the class file of c: [{:name :desc :flags :value}], or nil without a class
  file. (Reflection hides some fields of the JDK's own classes, jdk.internal.reflect.Reflection's
  filters.)"
  [^Class c]
  (when (class-file? c)
    ((requiring-resolve 'arbace.classes.jvm/read-fields) c)))

(defn read-method-annotations
  "[name desc] -> {:annotations [...] :param-annotations [[...] ...]} of the methods of the
  class file of c (the declaration annotations javac copies to bridges); {} without one."
  [^Class c]
  (if (class-file? c)
    ((requiring-resolve 'arbace.classes.jvm/read-method-annotations) c)
    {}))

(defn- coerce-const [desc v]
  (case desc
    "Z" (not (zero? (long v)))
    "C" (char (int v))
    "S" (short v)
    "B" (byte v)
    v))

(def ^:private ^java.util.concurrent.ConcurrentHashMap reflect-cache
  ;; strong: the Go build's jrt has no weak references in its maps, and the class infos of
  ;; reflection are kept there; read without the lock (j2g's analysis asks it from many threads),
  ;; filled under it
  (java.util.concurrent.ConcurrentHashMap.))

(defn- inner-member? [^Class c]
  (boolean (and (.getDeclaringClass c) (not (Modifier/isStatic (.getModifiers c)))
                (not (.isInterface c)) (not (.isEnum c)) (not (.isRecord c)))))

(defn reflect-info [^Class c]
  (or (.get reflect-cache c)
   (locking reflect-cache
    (or (.get reflect-cache c)
        (let [n (internal c)
              manns (delay (read-method-annotations c))
              info {:name n
                    :flags (.getModifiers c)
                    :interface? (.isInterface c)
                    :super (some-> (.getSuperclass c) internal)
                    :interfaces (mapv internal (.getInterfaces c))
                    :nest-host (internal (.getNestHost c))
                    :outer (some-> (.getDeclaringClass c) internal)
                    :fields (if-let [fs (read-fields c)]
                              (vec (for [{:keys [name desc flags value]} fs]
                                     {:name name :desc desc :flags flags :owner n
                                      :const (when (and (Modifier/isFinal flags) (some? value)
                                                        (or (t/prim? desc) (= desc t/string-desc)))
                                               (coerce-const desc value))}))
                              (vec (for [^Field f (.getDeclaredFields c)]
                                     {:name (.getName f) :desc (t/class->desc (.getType f))
                                      :flags (.getModifiers f) :owner n :const nil})))
                    ;; an inner member class: its constructors take the outer instance first
                    :outer-instance? (inner-member? c)
                    :methods (vec (concat
                                    (for [^Method m (.getDeclaredMethods c)
                                          :let [desc (t/method-desc (map t/class->desc (.getParameterTypes m))
                                                                    (t/class->desc (.getReturnType m)))]]
                                      {:name (.getName m)
                                       :desc desc
                                       :flags (.getModifiers m) :owner n
                                       :throws (mapv internal (.getExceptionTypes m))
                                       :annotations (delay (get-in @manns [[(.getName m) desc] :annotations]))
                                       :param-annotations (map-indexed
                                                           (fn [i _] (delay (get-in @manns [[(.getName m) desc] :param-annotations i])))
                                                           (.getParameterTypes m))})
                                    (for [^Constructor m (.getDeclaredConstructors c)]
                                      {:name "<init>"
                                       :desc (t/method-desc (map t/class->desc (cond->> (seq (.getParameterTypes m))
                                                                                  (inner-member? c) rest))
                                                            "V")
                                       :flags (.getModifiers m) :owner n
                                       :throws (mapv internal (.getExceptionTypes m))})))
                    :class c}
              ;; the Go build: jrt's reflection lists no constructors of an abstract class; the
              ;; world's signatures have them (arbace.classes.go/constructors; on the JVM every
              ;; class has its constructors, and nothing is added)
              info (if (and (not (.isInterface c)) (empty? (filter #(= "<init>" (:name %)) (:methods info))))
                     (update info :methods into (for [[d f] ((requiring-resolve 'arbace.classes.go/constructors) n)]
                                                  {:name "<init>" :desc d :flags f :owner n :throws []}))
                     info)]
          (.put reflect-cache c info)
          info)))))

;; ---------------------------------------------------------------------------------------------
;; lookup

(defn info
  "The class info of an internal name, or nil."
  [n]
  (when (and n (not (str/starts-with? n "[")))
    (or (some-> *compile-set* deref (get n))
        (if *declared*
          (when-not (from-source? n) (:info (get *declared* n)))
          (when-let [c (load-class n)]
            (let [d (get @defined n)]
              (if (and d (identical? (:class d) c)) d (reflect-info c))))))))

(defn info! [n]
  (or (info n) (throw (ex-info (str "Unknown class: " (str/replace (str n) "/" ".")) {:class n}))))

(defn interface? [n]
  (let [i (info n)] (boolean (or (:interface? i) (some-> (:flags i) (bit-and Opcodes/ACC_INTERFACE) pos?)))))

(defn const-value [field]
  (let [c (:const field)] (if (delay? c) @c c)))

(defn supertypes
  "Direct supertypes of class n (superclass first)."
  [n]
  (let [i (info! n)] (cond-> (vec (:interfaces i)) (:super i) (->> (cons (:super i)) vec))))

(defn subclass?
  "Is class a (internal name) a subtype of class b?"
  [a b]
  (or (= a b) (= b "java/lang/Object")
      (boolean (some #(subclass? % b) (when-let [i (info a)]
                                         (cond-> (vec (:interfaces i)) (:super i) (conj (:super i))))))))

(defn assignable?
  "Is a value of reference type `from` (a descriptor or :null) assignable to `to`?"
  [from to]
  (cond
    (= from to) true
    (= from :null) (t/ref? to)
    (not (and (t/ref? from) (t/ref? to))) false
    (= to t/object-desc) true
    (t/array? from)
    (cond (t/array? to) (let [fe (t/elem-type from) te (t/elem-type to)]
                          (and (t/ref? fe) (t/ref? te) (assignable? fe te)))
          :else (contains? #{"Ljava/lang/Cloneable;" "Ljava/io/Serializable;"} to))
    (t/array? to) false
    :else (subclass? (t/desc->internal from) (t/desc->internal to))))

(defn superclass-chain [n]
  (take-while some? (iterate #(some-> % info :super) n)))

(defn common-super
  "The common superclass of two internal names, for stack map frames."
  [a b]
  (cond
    (= a b) a
    (or (str/starts-with? a "[") (str/starts-with? b "[")) "java/lang/Object"
    (subclass? a b) (if (interface? b) "java/lang/Object" b)
    (subclass? b a) (if (interface? a) "java/lang/Object" a)
    (or (interface? a) (interface? b)) "java/lang/Object"
    :else (let [bs (set (superclass-chain b))]
            (or (first (filter bs (superclass-chain a))) "java/lang/Object"))))

(defn lub
  "A least upper bound of two reference descriptors (only the class chain; interfaces give
  Object unless one type is assignable to the other)."
  [a b]
  (cond (= a b) a
        (= a :null) b
        (= b :null) a
        (assignable? a b) b
        (assignable? b a) a
        (and (t/class-desc? a) (t/class-desc? b))
        (let [c (common-super (t/desc->internal a) (t/desc->internal b))]
          (if (= c "java/lang/Object")
            ;; javac's lub: the common interface, when there is one most specific one
            (let [sups (fn [n] (set (tree-seq some? (fn [x] (when-let [i (info x)]
                                                             (cond-> (vec (:interfaces i)) (:super i) (conj (:super i)))))
                                              n)))
                  common (filter interface? (arbace.set/intersection (sups (t/desc->internal a))
                                                                     (sups (t/desc->internal b))))
                  minimal (remove (fn [i] (some #(and (not= % i) (subclass? % i)) common)) common)]
              (if (= 1 (count minimal)) (t/internal->desc (first minimal)) t/object-desc))
            (t/internal->desc c)))
        :else t/object-desc))

;; access

(defn nest-host [n]
  (let [i (info n)]
    (or (:nest-host i)
        (if-let [o (:outer i)] (nest-host o) n))))

(defn- flag? [flags f] (not (zero? (bit-and flags f))))

(defn accessible?
  "Can code in class `from` access member m (with :owner and :flags)?"
  [from m]
  (let [fl (:flags m) owner (:owner m)]
    (cond
      (flag? fl Opcodes/ACC_PUBLIC) true
      (flag? fl Opcodes/ACC_PRIVATE) (= (nest-host from) (nest-host owner))
      (= (t/package-of from) (t/package-of owner)) true
      (flag? fl Opcodes/ACC_PROTECTED)
      (boolean (some #(subclass? % owner)
                     (take-while some? (iterate #(:outer (info %)) from))))
      :else false)))

(defn find-field
  "The field `name` of class n as JLS 8.3 finds it (declared, then superinterfaces, then
  superclass), or nil."
  [n name]
  (when-let [i (info n)]
    (or (first (filter #(= name (:name %)) (:fields i)))
        (some #(find-field % name) (:interfaces i))
        (some-> (:super i) (find-field name)))))

(defn- same-infos?
  "Are the class infos of names (a vector) still infos (identical, one by one)?"
  [names ^objects infos]
  (let [n (count names)
        cs (some-> *compile-set* deref)]
    (loop [i 0]
      (or (= i n)
          (and (let [c (nth names i)
                     x (aget infos i)]
                 ;; a class of the compilation: its declaration (info's first answer)
                 (or (and (some? x) (some? cs) (identical? x (get cs c)) (not (str/starts-with? c "[")))
                     (identical? (info c) x)))
               (recur (inc i)))))))

(defn- infos-now ^objects [names]
  (let [a (object-array (count names))]
    (dotimes [i (count names)] (aset a i (info (nth names i))))
    a))

;; The memos of all-supertypes and member-methods (the build's speed, fourth round, part B):
;; what each computed, with the class infos it was computed from (those of the supertypes: the
;; only infos either reads), taken again only while every one of those infos is the one it read
;; (by identity; a class declared, resolved or bridged anew has a new info, and so does any
;; other compilation or class environment). Strong, as reflect-cache; read without a lock.

(def ^:private ^java.util.concurrent.ConcurrentHashMap supertypes-memo
  (java.util.concurrent.ConcurrentHashMap.))

(def ^:private ^java.util.concurrent.ConcurrentHashMap member-methods-memo
  (java.util.concurrent.ConcurrentHashMap.))

(defn- all-supertypes*
  [n]
  (let [chain (vec (superclass-chain n))]
    (loop [out chain seen (set chain) queue (vec (mapcat #(:interfaces (info %)) chain))]
      (if-let [[q & more] (seq queue)]
        (if (seen q)
          (recur out seen (vec more))
          (recur (conj out q) (conj seen q) (into (vec more) (:interfaces (info q)))))
        (cond-> out (and (interface? n) (not (seen "java/lang/Object"))) (conj "java/lang/Object"))))))

(defn all-supertypes
  "n and all its supertypes, classes first (the superclass chain), then interfaces breadth first."
  [n]
  (let [e (when n (.get supertypes-memo n))]
    (if (and e (same-infos? (aget ^objects e 0) (aget ^objects e 1)))
      (aget ^objects e 0)
      (let [r (all-supertypes* n)
            infos (infos-now r)]
        ;; kept when computed again from those infos (none changed meanwhile)
        (when (and n (= r (all-supertypes* n)))
          (.put supertypes-memo n (object-array [r infos])))
        r))))

(defn- params-key [^String desc] (subs desc 0 (inc (.indexOf desc ")"))))

(defn- member-methods*
  [n name sups]
  (loop [[c & more] sups seen #{} out []]
    (if-not c
      out
      (let [ms (for [m (:methods (info! c))
                     :when (= name (:name m))
                     :when (not (flag? (:flags m) Opcodes/ACC_SYNTHETIC))
                     :when (or (= c n) (not (flag? (:flags m) Opcodes/ACC_PRIVATE)))
                     :when (or (= c n) (not (interface? c)) (not (flag? (:flags m) Opcodes/ACC_STATIC)))
                     :when (not (seen (params-key (:desc m))))]
                 m)]
        (recur more (into seen (map (comp params-key :desc) ms)) (into out ms))))))

(defn member-methods
  "The methods named `name` that are members of class n (inherited ones included, overridden
  and synthetic ones excluded), in order: most specific declaring class first."
  [n name]
  (if-not (and (string? n) (string? name))
    (member-methods* n name (all-supertypes n))
    (let [^java.util.concurrent.ConcurrentHashMap by-name
          (or (.get member-methods-memo n)
              (do (.putIfAbsent member-methods-memo n (java.util.concurrent.ConcurrentHashMap.))
                  (.get member-methods-memo n)))
          e (.get by-name name)]
      (if (and e (same-infos? (aget ^objects e 1) (aget ^objects e 2)))
        (aget ^objects e 0)
        (let [sups (all-supertypes n)
              infos (infos-now sups)
              r (member-methods* n name sups)]
          ;; kept when no info changed meanwhile
          (when (and (= sups (all-supertypes n)) (same-infos? sups infos))
            (.put by-name name (object-array [r sups infos])))
          r)))))

(defn constructors [n]
  (filter #(= "<init>" (:name %)) (:methods (info! n))))

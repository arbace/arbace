(ns arbace.c2j.emit
  "Standalone S6 (doc/STANDALONE-NOTES.md, \"S6: Arbace compiled to Go\"): the back end that
  compiles analyzed namespaces to Java forms, which j2g translates into Go like the runtime's
  own classes.

  The input is what the program records while it prepares its namespaces (ARBACE_COMPILE): for
  each source, its units in order (a top-level form, analyzed: Compiler$Image's unit, its Expr
  tree and the events of its analysis), read through Compiler$AST/node, which shows a node's
  fields as a map. The output follows the JVM's bytecode back end (Compiler.clj on the branch
  arbace-for-java-26: ObjExpr.compile, the emit methods), with Java forms in place of
  bytecode:

  - a fn (FnExpr) is a class named as the JVM names it (arbace.walk$walk), a static member
    class of a holder class per namespace (arbace.walk), nested as its name nests; it extends
    AFunction (RestFn when variadic), its closed-over locals are fields set by its constructor,
    each arity an invoke method (doInvoke for the variadic one), its constants static fields;
  - a source's top-level forms are the static methods of its loader class SCRIPTBASE__init
    (arbace.walk__init), whose load() runs them in order; Compiler$AOT/load calls it in the
    bindings Compiler.load makes; past loader-part-units units, in parts, static member
    classes SCRIPTBASE__init$partP (SA210);
  - each Expr becomes the Java forms code its emit method's bytecode is: interop on the
    analyzer's resolved members (param-tags pin the overload), reflection where it was
    unresolved, Clojure's boxing and conversions (emitBoxReturn, emitTypedArgs)."
  (:require [arbace.string :as str]
            [arbace.j2g.jrt :as jrt]
            [arbace.j2g.names :as nm]
            [arbace.c2j.node :refer [defnode]])
  (:import [arbace.lang Compiler$AST Var Keyword Symbol IObj IPersistentMap IPersistentVector
            IPersistentSet IPersistentList ISeq IType IRecord PersistentHashSet Namespace]
           [java.util IdentityHashMap]
           [java.util.regex Pattern]))

;; ---------------------------------------------------------------------------------------
;; nodes

(def ^:private node-cache
  "The nodes' maps by node (the back end runs on one thread)."
  (IdentityHashMap.))

(defn node
  "The analyzed node x as a map (Compiler$AST/node), nil for nil."
  [x]
  (when (some? x)
    (or (.get ^IdentityHashMap node-cache x)
        (let [n (assoc (Compiler$AST/node x) :self x)]
          (.put ^IdentityHashMap node-cache x n)
          n))))

(defn- fail [msg & [data]]
  (throw (ex-info (str "aot: " msg) (or data {}))))

;; ---------------------------------------------------------------------------------------
;; class names and types

(defn destub
  "A class name without the compile stub's prefix (Compiler.destubClassName)."
  [^String n]
  (if (str/starts-with? n "compile__stub.") (subs n (count "compile__stub.")) n))

(defn type-sym
  "The Java forms type of class c: a primitive's name, a class's binary name, an array as
  T/n."
  [^Class c]
  (if (.isArray c)
    (loop [^Class e c n 0]
      (if (.isArray e)
        (recur (.getComponentType e) (inc n))
        (symbol (str (type-sym e)) (str n))))
    (symbol (destub (.getName c)))))

(def ^:private prim-names
  {Long/TYPE 'long Double/TYPE 'double Integer/TYPE 'int Boolean/TYPE 'boolean
   Character/TYPE 'char Float/TYPE 'float Short/TYPE 'short Byte/TYPE 'byte Void/TYPE 'void})

(defn- tagged
  "Symbol s with the Java forms tag of class c."
  [s c]
  ;; an array type as Clojure's string tag ("[Ljava.lang.Object;"), which the Java forms' types
  ;; take as written
  (vary-meta s assoc :tag (if (instance? Class c)
                            (or (prim-names c) (if (.isArray ^Class c) (destub (.getName ^Class c)) (type-sym c)))
                            c)))

(def ^:private registered
  "Whether a class name is registered in the program (Class/forName finds it), by name."
  (atom {}))

(defn- registered? [^Class c]
  (let [^Class c (loop [^Class c c] (if (.isArray c) (recur (.getComponentType c)) c))]
    (or (.isPrimitive c)
        (let [n (destub (.getName c))]
          (if-some [r (get @registered n)]
            r
            (let [r (try (let [k (Class/forName n false nil)]
                           (and (some? k)
                                ;; a cut class (outside j2g's world): by reflection
                                (not (try (arbace.lang.Reflector/invokeStaticMethod
                                            "arbace.lang.Compiler$AST" "cut" (object-array [k]))
                                          ;; a program older than AST.cut
                                          (catch Throwable _ false)))))
                         (catch Throwable _ false))]
              (swap! registered assoc n r)
              r))))))

(defn- runtime-class?
  "Is class c made at run time (a Dyn class: an evaluated fn's, deftype's, interface's, proxy's)
  rather than a class of the program, or one the program does not register by name (java.sql's,
  whose members reflection reached from a world class)? Such a class is not named in compiled
  code."
  [^Class c ctx]
  (or (contains? @(:runtime-classes ctx) (destub (.getName c)))
      (not (registered? c))
      ;; a proxy's class made at run time before the analysis that names it (no proxy event
      ;; of any source: (get-proxy-class C) evaluated, then (proxy [C] ...) analyzed): as one
      ;; made with an event, it is made again before the unit runs (unit-method)
      (when (.isAssignableFrom arbace.lang.IProxy c)
        (when-let [ps (:unit-proxies ctx)] (swap! ps conj c))
        true)))

(defn- public? [^Class c]
  (java.lang.reflect.Modifier/isPublic (.getModifiers c)))

;; ---------------------------------------------------------------------------------------
;; the class being emitted: its constants

(defn- top-name [^String n] (let [i (.indexOf n "$")] (if (neg? i) n (subs n 0 i))))

(defn- pool
  "The constants of top-level class top (a namespace's holder, a deftype, a loader), which its
  member classes share (SA145): an atom {:name :consts :const-map}, made on first use."
  [ctx top]
  (let [pools (:pools ctx)]
    (or (get @pools top)
        (get (swap! pools (fn [m] (if (contains? m top) m
                                     (assoc m top (atom {:name top :consts [] :const-map (IdentityHashMap.) :const-prefix ""})))))
             top))))

(defn- const-field
  "The static field holding constant value v in the class being emitted, made on first use (as
  the JVM's const__N, one per distinct object): its symbol, const-N (a munged local's name has
  no -, so no local, name__index, can shadow it)."
  [ctx v ctype]
  (let [cls (:cls ctx)
        ^IdentityHashMap m (:const-map @cls)
        ;; a part of a split loader (SA210): the constants its source's earlier parts made,
        ;; by value, as their fields' qualified names
        ^IdentityHashMap prev (:prev @cls)]
    (or (.get m v)
        (let [n (count (:consts @cls))
              s (symbol (str (:const-prefix @cls) "const-" n))
              ;; one an earlier part made: a field of this part too, set from that part's (one
              ;; object, as unsplit; read here unguarded)
              alias (when prev (.get prev v))]
          (.put m v s)
          (when (and prev (not alias)) (.put prev v (symbol (:name @cls) (name s))))
          (swap! cls update :consts conj [s ctype v alias])
          s))))

(declare emit-value)

(defn- emit-list-array [ctx xs]
  (list 'new 'java.lang.Object/1 (mapv #(emit-value ctx %) xs)))

(defn- char-form [^Character c]
  (let [i (int (.charValue c))]
    (if (and (>= i 33) (<= i 126) (not= c \\))
      c
      (list 'unchecked-char i))))

(defn- double-form [^double d]
  (if (or (Double/isNaN d) (Double/isInfinite d))
    (list 'java.lang.Double/longBitsToDouble (Double/doubleToRawLongBits d))
    d))

(defn emit-value
  "Code making constant value v (ObjExpr.emitValue), its metadata included."
  [ctx v]
  (let [[form partial?]
        (cond
          (nil? v) [nil true]
          (string? v) [v true]
          (instance? Boolean v) [(if v 'java.lang.Boolean/TRUE 'java.lang.Boolean/FALSE) true]
          (instance? Integer v) [(list 'java.lang.Integer/valueOf (list 'unchecked-int (long v))) true]
          (instance? Long v) [(list 'java.lang.Long/valueOf (long v)) true]
          (instance? Double v) [(list 'java.lang.Double/valueOf (double-form v)) true]
          (instance? Character v) [(list 'java.lang.Character/valueOf (char-form v)) true]
          (class? v) [(if (.isPrimitive ^Class v)
                        (symbol (.getName ^Class ({Boolean/TYPE Boolean Byte/TYPE Byte Character/TYPE Character
                                                   Double/TYPE Double Float/TYPE Float Integer/TYPE Integer
                                                   Long/TYPE Long Short/TYPE Short} v))
                                "TYPE")
                        (list 'arbace.lang.RT/classForNameNonLoading (destub (.getName ^Class v))))
                      true]
          (symbol? v) [(list (with-meta 'arbace.lang.Symbol/intern {:param-tags '[java.lang.String java.lang.String]})
                             (namespace v) (name v))
                       true]
          (keyword? v) [(list (with-meta 'arbace.lang.RT/keyword {:param-tags '[java.lang.String java.lang.String]})
                              (namespace v) (name v))
                        true]
          (var? v) [(list (with-meta 'arbace.lang.RT/var {:param-tags '[java.lang.String java.lang.String]})
                          (str (.-name (.-ns ^Var v))) (str (.-sym ^Var v)))
                    true]
          (instance? Namespace v) [(list (with-meta 'arbace.lang.Namespace/findOrCreate {:param-tags '[arbace.lang.Symbol]})
                                         (list (with-meta 'arbace.lang.Symbol/intern {:param-tags '[java.lang.String java.lang.String]})
                                               nil (str (.-name ^Namespace v))))
                                   false]
          (instance? IRecord v) (fail (str "a record as a constant: " (class v)))
          (instance? IType v) (fail (str "a deftype as a constant: " (class v)))
          (map? v) [(list (with-meta 'arbace.lang.RT/map {:param-tags '[java.lang.Object/1]})
                          (emit-list-array ctx (mapcat identity v)))
                    true]
          (vector? v) [(if (<= (count v) 6)
                         (list* (with-meta 'arbace.lang.Tuple/create
                                  {:param-tags (vec (repeat (count v) 'java.lang.Object))})
                                (map #(emit-value ctx %) v))
                         (list (with-meta 'arbace.lang.RT/vector {:param-tags '[java.lang.Object/1]})
                               (emit-list-array ctx v)))
                       true]
          (instance? PersistentHashSet v) [(if (empty? v)
                                             'arbace.lang.PersistentHashSet/EMPTY
                                             (list (with-meta 'arbace.lang.PersistentHashSet/create
                                                     {:param-tags '[java.lang.Object/1]})
                                                   (emit-list-array ctx (seq v))))
                                           true]
          (or (seq? v) (list? v)) [(list (with-meta 'arbace.lang.PersistentList/create
                                           {:param-tags '[java.util.List]})
                                         (list (with-meta 'java.util.Arrays/asList {:param-tags '[java.lang.Object/1]})
                                               (emit-list-array ctx v)))
                                   true]
          (instance? Pattern v) [(list (with-meta 'java.util.regex.Pattern/compile {:param-tags '[java.lang.String]})
                                       (str v))
                                 true]
          :else
          (let [s (binding [*print-dup* true] (pr-str v))]
            (when (or (empty? s) (str/starts-with? s "#<"))
              (fail (str "can't embed unreadable object in code: " s)))
            [(list (with-meta 'arbace.lang.RT/readString {:param-tags '[java.lang.String]}) s) false]))
        m (when (and partial? (instance? IObj v)) (meta v))]
    (if (pos? (count m))
      (list '.withMeta (list 'cast 'arbace.lang.IObj form)
            (list 'cast 'arbace.lang.IPersistentMap (emit-value ctx m)))
      form)))

;; ---------------------------------------------------------------------------------------
;; constant pools as data (SA155): a class's constants are encoded in one string, which
;; Compiler$AOT/pool decodes when the class is initialized, making each value as emit-value's
;; code would (the same calls, in the same order); its keywords and symbols without metadata
;; are made once and named by the values that hold them. The code that made the values was
;; most of a compiled namespace's static initializers (and of gc's stack maps)

(defn- pool-kind
  "The tag of constant v, in the order of emit-value's cases."
  [v]
  (cond
    (nil? v) :nil
    (string? v) :string
    (instance? Boolean v) :boolean
    (instance? Integer v) :int
    (instance? Long v) :long
    (instance? Double v) :double
    (instance? Character v) :char
    (class? v) :class
    (symbol? v) :symbol
    (keyword? v) :keyword
    (var? v) :var
    (instance? Namespace v) :ns
    (instance? IRecord v) (fail (str "a record as a constant: " (class v)))
    (instance? IType v) (fail (str "a deftype as a constant: " (class v)))
    (map? v) :map
    (vector? v) :vector
    (instance? PersistentHashSet v) :set
    (or (seq? v) (list? v)) :list
    (instance? Pattern v) :pattern
    :else :read))

(def ^:private pool-partial
  "The kinds whose metadata is made too (emit-value's partial?)."
  #{:nil :string :boolean :int :long :double :char :class :symbol :keyword :var :map :vector :set :list :pattern})

(defn- pool-shared?
  "Is v made once in a pool and named where used: a keyword, a symbol without metadata."
  [v]
  (or (keyword? v) (and (symbol? v) (empty? (meta v)))))

(defn- pool-parts
  "The values constant v is made of (its elements, its metadata)."
  [v]
  (let [k (pool-kind v)]
    (concat (case k
              :map (mapcat identity v)
              (:vector :set :list) (seq v)
              nil)
            (when (and (contains? pool-partial k) (instance? IObj v) (pos? (count (meta v))))
              [(meta v)]))))

(defn- pool-str [^StringBuilder sb ^String s]
  (-> sb (.append (.length s)) (.append \,) (.append s)))

(defn- pool-encode
  "Appends the encoding of v to sb (Compiler$AOT/poolValue's format); shared: shared value →
  its index."
  [^StringBuilder sb shared v]
  (if-let [i (and (pool-shared? v) (get shared v))]
    (-> sb (.append \R) (.append (long i)) (.append \,))
    (let [k (pool-kind v)
          num (fn [tag n] (-> sb (.append tag) (.append (long n)) (.append \,)))
          arr (fn [tag xs] (.append sb tag) (.append sb (long (count xs))) (.append sb \,)
                (doseq [x xs] (pool-encode sb shared x)))
          m (when (and (contains? pool-partial k) (instance? IObj v)) (meta v))
          m? (pos? (count m))]
      (when m? (.append sb \M))
      (case k
        :nil (.append sb \n)
        :string (do (.append sb \s) (pool-str sb v))
        :boolean (.append sb (if v \T \F))
        :int (num \i v)
        :long (num \l v)
        :double (num \d (Double/doubleToRawLongBits (double v)))
        :char (num \c (int (.charValue ^Character v)))
        :class (if (.isPrimitive ^Class v)
                 (-> sb (.append \P)
                     (.append ({Boolean/TYPE \Z Byte/TYPE \B Character/TYPE \C Double/TYPE \D Float/TYPE \F
                                Integer/TYPE \I Long/TYPE \J Short/TYPE \S Void/TYPE \V} v)))
                 (do (.append sb \C) (pool-str sb (destub (.getName ^Class v)))))
        :symbol (do (.append sb \y)
                    (if (namespace v) (do (.append sb \s) (pool-str sb (namespace v))) (.append sb \n))
                    (pool-str sb (name v)))
        :keyword (do (.append sb \k)
                     (if (namespace v) (do (.append sb \s) (pool-str sb (namespace v))) (.append sb \n))
                     (pool-str sb (name v)))
        :var (do (.append sb \v)
                 (pool-str sb (str (.-name (.-ns ^Var v))))
                 (pool-str sb (str (.-sym ^Var v))))
        :ns (do (.append sb \N) (pool-str sb (str (.-name ^Namespace v))))
        :map (arr \m (vec (mapcat identity v)))
        :vector (arr \V (vec v))
        :set (if (empty? v) (.append sb \E) (arr \S (vec (seq v))))
        :list (arr \L (vec v))
        :pattern (do (.append sb \p) (pool-str sb (str v)))
        :read (let [s (binding [*print-dup* true] (pr-str v))]
                (when (or (empty? s) (str/starts-with? s "#<"))
                  (fail (str "can't embed unreadable object in code: " s)))
                (.append sb \r) (pool-str sb s)))
      (when m? (pool-encode sb shared m))
      sb)))

(defn- pool-fields
  "The static fields of constants consts ([sym type value alias] ...): the pool's array, decoded
  once (Compiler$AOT/pool), then each constant's field, its element, or for one with an alias
  (a split loader's constant an earlier part made, SA210) that part's field."
  [consts]
  (when (seq consts)
    (let [pooled (vec (remove #(nth % 3 nil) consts))
          ;; the keywords and symbols of the values, first met first (depth first)
          seen (java.util.LinkedHashSet.)
          walk (fn walk [v]
                 (when (pool-shared? v) (.add seen v))
                 (run! walk (pool-parts v)))
          _ (doseq [[_ _ v] pooled] (walk v))
          sh (vec seen)
          shared (into {} (map-indexed (fn [i v] [v i]) sh))
          sb (StringBuilder.)
          _ (doseq [v sh] (pool-encode sb {} v))
          base (count sh)
          ;; a constant that is itself a shared value is that entry
          _ (doseq [[_ _ v] pooled] (pool-encode sb shared v))
          n (+ base (count pooled))
          index (into {} (map-indexed (fn [i [s]] [s i]) pooled))]
      (concat
        (when (seq pooled)
          [(list 'field (tagged (with-meta 'const-pool {:static true :final true :private true}) (class (object-array 0)))
                 (list (with-meta 'arbace.lang.Compiler$AOT/pool {:param-tags '[java.lang.String int]})
                       (str sb) (list 'unchecked-int n)))])
        (for [[s t _ alias] consts]
          (list 'field (tagged (with-meta s {:static true :final true :c2j/nn true}) t)
                (or alias
                    (let [e (list 'aget 'const-pool (list 'unchecked-int (+ base (index s))))]
                      (if (= t 'java.lang.Object) e (list 'cast t e))))))))))

(defn- const-type [v]
  (cond (var? v) 'arbace.lang.Var
        (keyword? v) 'arbace.lang.Keyword
        (class? v) 'java.lang.Class
        :else 'java.lang.Object))

(def ^:dynamic *late-classes*
  "The names of the classes the Java forms compiler made while the program prepared (its
  deftypes, fns and defclasses using the Java forms, arbace.c2j.main's java-forms-classes): in the
  tree, but j2g may leave one out (Clojure in its body it cannot analyze, F2.4), so a constant
  naming one is looked up where used, as a class made at run time, and the classes holding it
  initialize without it."
  #{})

(defn- constant [ctx v]
  (cond
    (or (nil? v) (string? v)) v
    ;; a class made at run time may not exist yet when the class holding the constant is
    ;; initialized: looked up where used
    (and (class? v) (or (runtime-class? v ctx) (contains? *late-classes* (destub (.getName ^Class v)))))
    (list (with-meta 'arbace.lang.RT/classForNameNonLoading {:param-tags '[java.lang.String]})
          (destub (.getName ^Class v)))
    :else (const-field ctx v (const-type v))))

;; ---------------------------------------------------------------------------------------
;; locals

(defn- gsym
  "A fresh name for a temporary of the emitted code, numbered per class being emitted (the
  output does not depend on the program's gensym counter)."
  [ctx base]
  (let [cls (:cls ctx)
        k (:gensyms (swap! cls update :gensyms (fnil inc 0)))]
    (symbol (str base k))))

(defn- local-sym
  "The Java forms local of LocalBinding lb (its node b): its name and index, unique in a
  method."
  [b]
  (symbol (str (:name b) "__" (:idx b))))

(defn- identity-set
  "The objects of xs as a set by identity. A fn's closes map cannot be asked containsKey: its
  keys, LocalBindings, hash by their index (Arbace's deterministic hashCode), and FnExpr.parse
  renumbers a direct fn's arguments after its inner fns closed over them."
  [xs]
  (let [m (IdentityHashMap.)]
    (doseq [x xs] (.put m x true))
    m))

(defn- closed? [ctx lb]
  (when-let [^IdentityHashMap s (:closed ctx)]
    (.containsKey s lb)))

(defn- field-sym [b] (symbol (str ".-" (:name b))))

(defn- field-read [ctx lb b]
  (list (field-sym b) 'this))

;; ---------------------------------------------------------------------------------------
;; expressions

(declare emit emit-unboxed emit-fn-class! emit-deftype-class! emit-body jrt-lacks? prim-call spec-intrinsic
         emit-local)

(defn- prim [e] (:prim (node e)))

(defn- can-prim? [n] (boolean (:canEmitPrimitive n)))

(declare box-of)

(defn- box
  "Form f of type c as a boxed value (emitBoxReturn: valueOf, long's Numbers.num being
  Long.valueOf; void as nil)."
  [f ^Class c]
  (cond
    (= c Void/TYPE) (list 'do f nil)
    (.isPrimitive c) (list (with-meta (box-of c) {:param-tags [(prim-names c)]}) f)
    :else f))

(defn- unbox-arg
  "Boxed form f converted to parameter type p (HostExpr.emitUnboxArg)."
  [ctx f ^Class p]
  (cond
    (= p Object) f
    (= p Boolean/TYPE) (list '.booleanValue (list 'cast 'java.lang.Boolean f))
    (= p Character/TYPE) (list '.charValue (list 'cast 'java.lang.Character f))
    (.isPrimitive p)
    (let [unchecked (:unchecked-math ctx)
          m ({Integer/TYPE (if unchecked "uncheckedIntCast" "intCast")
              Float/TYPE (if unchecked "uncheckedFloatCast" "floatCast")
              Double/TYPE (if unchecked "uncheckedDoubleCast" "doubleCast")
              Long/TYPE (if unchecked "uncheckedLongCast" "longCast")
              Byte/TYPE (if unchecked "uncheckedByteCast" "byteCast")
              Short/TYPE (if unchecked "uncheckedShortCast" "shortCast")} p)]
      (list (with-meta (symbol "arbace.lang.RT" m) {:param-tags '[java.lang.Object]}) f))
    (or (runtime-class? p ctx) (not (public? p))) f
    :else (list 'cast (type-sym p) f)))

(defn- fi?
  "Is p a functional interface a fn argument is adapted to (Clojure 1.12's FISupport, as the
  analysis decides it: Compiler$AST/fiMethod)?"
  [^Class p]
  (and (.isInterface p)
       (some? (arbace.lang.Reflector/invokeStaticMethod "arbace.lang.Compiler$AST" "fiMethod" (object-array [p])))))

(defn- typed-args
  "The arguments es as parameters of types ps (MethodExpr.emitTypedArgs)."
  [ctx ps es]
  (mapv (fn [^Class p e]
          (let [n (node e)
                pc (:prim n)]
            (cond
              (and pc (= pc p)) (emit-unboxed ctx e)
              (and (= pc Integer/TYPE) (= p Long/TYPE)) (emit-unboxed ctx e)
              (and (= pc Long/TYPE) (= p Integer/TYPE))
              (list (with-meta (if (:unchecked-math ctx) 'arbace.lang.RT/uncheckedIntCast 'arbace.lang.RT/intCast)
                      {:param-tags '[long]})
                    (emit-unboxed ctx e))
              (and (= pc Float/TYPE) (= p Double/TYPE)) (emit-unboxed ctx e)
              (and (= pc Double/TYPE) (= p Float/TYPE)) (list 'unchecked-float (emit-unboxed ctx e))
              :else
              (or
                ;; a call of a primitive fn returning p: its unboxed value (F6)
                (prim-call ctx e p #(unbox-arg ctx % p))
                (let [f (emit ctx e)
                    jc (:class n)]
                (if (and (fi? p) (not (and jc (.isAssignableFrom p jc))))
                  ;; Clojure 1.12: a fn passed where a functional interface is expected
                  (unbox-arg ctx (list 'arbace.lang.Compiler$Evaluator/fiAdapt (constant ctx p) f) p)
                  (unbox-arg ctx f p)))))))
        ps es))

(defn- param-tags [ps] {:param-tags (mapv type-sym ps)})

(defn- obj-array [ctx es]
  (list 'new 'java.lang.Object/1 (mapv #(emit ctx %) es)))

(defn- var-value [ctx ^Var v]
  (let [c (const-field ctx v 'arbace.lang.Var)]
    (if (.isDynamic v) (list '.get c) (list '.getRawRoot c))))

(defn- line-meta [f n]
  (if (and (seq? f) (pos? (or (:line n) 0)))
    (vary-meta f assoc :c2j/line (:line n))
    f))

(defn- spec-local
  "The worker's long and box of parameter lb (F6, spec-mask: {:l :b}), or nil."
  [ctx lb]
  (when-let [^IdentityHashMap m (:spec-locals ctx)]
    (.get m lb)))

(defn- long-box* [f] (list (with-meta 'java.lang.Long/valueOf {:param-tags '[long]}) f))

(defn- local-place
  "Where the local of node n lives in the emitted code (the local node kind's place): {:form
  its read and the target of its write, :clears true when its use clears it (a ^:once fn's
  closed-over value read for the last time on its path)}."
  [ctx n]
  (let [lb (:b n)
        b (node lb)]
    (cond
      (closed? ctx lb)
      {:form (field-read ctx lb b)
       :clears (boolean (and (:once ctx) (:shouldClear n) (:canBeCleared b) (not (:bindingPrim b))))}
      (and (zero? (:idx b)) (not (:isArg b))) {:form (or (:self-sym ctx) 'this)}
      ;; a parameter a worker takes as a long (F6, spec-mask): its box, made once, when needed
      (spec-local ctx lb) {:form (let [{:keys [l b]} (spec-local ctx lb)]
                                   (list 'if (list 'nil? b) (list 'set! b (long-box* l)) b))}
      :else {:form (local-sym b)})))

;; ---------------------------------------------------------------------------------------
;; guarded direct linking (Futamura F5 (a), doc/FUTAMURA-SURVEY.md, "F5 as built")

(def ^:dynamic *link*
  "While the call sites of vars may be linked, an atom of the sites' data in the order emitted
  (arbace.c2j.main's compile-all binds it, and resolves the sites, link-form, once every class
  is known); else nil."
  nil)

(defn- link-key
  "The key of the compiled fn var v's root is at the end of the prepare run, for a call site
  of v: the FnExpr of an evaluated fn (Compiler$EvalFn), or the class name of a compiled one
  (Compiler$AOTFn, Compiler$AOTRestFn: the back end's own namespaces, compiled-back-end); nil
  when v is dynamic, ^:dynamic, ^:redef or a macro, or its root is no such fn."
  [^Var v]
  (when-not (or (.isDynamic v) (let [m (meta v)] (or (:dynamic m) (:redef m) (:macro m))))
    (let [r (.getRawRoot v)]
      (cond
        (instance? arbace.lang.Compiler$EvalFn r) (.-fe ^arbace.lang.Compiler$EvalFn r)
        (or (instance? arbace.lang.Compiler$AOTFn r) (instance? arbace.lang.Compiler$AOTRestFn r))
        (.getName (class r))
        :else nil))))

(declare deep)

;; primitive fns (Futamura F6 (a), doc/FUTAMURA-SURVEY.md, "F6 as built"): a fn method with
;; ^long or ^double parameters or return (at most 4 parameters, not variadic: the JVM's
;; FnMethod.primInterface) has an unboxed entry, invokePrim, beside its boxed invoke, which
;; converts and calls it; a linked call of it calls invokePrim directly. The analysis is not
;; changed (no fn has a primitive interface in the Go build, EVAL-PLAN Q1): callers still see an
;; invoke, whose value the consumers convert as before.

(defn- psig
  "The primitive signature of FnMethod mn (its node): {:params [Class...] :ret Class}, each
  long, double or Object; nil when the method has no unboxed entry."
  [mn]
  (when (and (= "fn-method" (:op mn)) (not (:restParm mn)) (<= (count (:reqParms mn)) 4))
    (let [ps (mapv #(let [p (:bindingPrim (node %))] (if (#{Long/TYPE Double/TYPE} p) p Object)) (:reqParms mn))
          r (let [r (:retClass mn)] (if (#{Long/TYPE Double/TYPE} r) r Object))]
      (when (or (not= r Object) (some #(not= % Object) ps))
        {:params ps :ret r}))))

(declare intrinsic-probe long-valued-ops)

(defn- walk-nodes
  "Calls f on the node (map) of each Expr of the tree of e, not inside the methods of nested
  fns, reifys and deftypes."
  [e f]
  (letfn [(w [x]
            (cond
              (or (instance? arbace.lang.Compiler$Expr x) (instance? arbace.lang.Compiler$BindingInit x))
              (let [n (node x)]
                (f n)
                (when-not (#{"fn" "new-instance"} (:op n))
                  (doseq [[k v] n :when (not= k :self)] (w v))))
              (instance? java.util.Map x) (doseq [v (.values ^java.util.Map x)] (w v))
              (instance? java.util.Collection x) (doseq [v x] (w v))
              :else nil))]
    (w e)))

(defn- spec-mask
  "Futamura F6, step 2: which parameters of FnMethod mn (its node) a speculative worker takes as
  longs: those an operation of Numbers with fast paths takes as an Object operand (F3), when the
  method also passes one of them, or such an operation of them, to a call of a var (where a
  worker may take it unboxed: the worker's gain; a fn whose parameters only meet operations,
  as arbace.core's +, would pay the dispatch for nothing); nil when there are none, or when the
  method has an unboxed entry (psig), is variadic, has more than 4 parameters, or recurs to its
  parameters (a recur would rebind them to values of any type)."
  [mn]
  (when (and (= "fn-method" (:op mn)) (not (:restParm mn)) (<= 1 (count (:reqParms mn)) 4) (not (psig mn)))
    (let [ps (vec (:reqParms mn))
          used (atom #{})
          recurs (atom false)
          passes (atom false)
          param? (fn [a] (let [an (node a)] (and (= "local" (:op an)) (some #(identical? % (:b an)) ps))))]
      (walk-nodes (:body mn)
                  (fn [n]
                    (case (:op n)
                      "invoke"
                      (when (and (= "var" (:op (node (:fexpr n))))
                                 (some (fn [a]
                                         (or (param? a)
                                             (let [an (node a)
                                                   ^java.lang.reflect.Method m (:method an)]
                                               (and (= "static-method" (:op an)) m (intrinsic-probe m)
                                                    (contains? long-valued-ops (.getName m))
                                                    (some param? (:args an))))))
                                       (:args n)))
                        (reset! passes true))
                      "recur" (when (and (= (count (:loopLocals n)) (count ps))
                                         (every? true? (map identical? (:loopLocals n) ps)))
                                (reset! recurs true))
                      "static-method"
                      (when-let [sig (when-let [m (:method n)] (intrinsic-probe m))]
                        (doseq [[s a] (map vector sig (:args n))
                                :let [an (node a)]
                                :when (and (= s :o) (= "local" (:op an)))
                                [i lb] (map-indexed vector ps)
                                :when (identical? lb (:b an))]
                          (swap! used conj i)))
                      nil)))
      (when (and (seq @used) @passes (not @recurs))
        (mapv #(contains? @used %) (range (count ps)))))))

(def ^:dynamic *var-fns*
  "The fn each var's last def in the recorded units defines (an IdentityHashMap Var → FnExpr,
  var-fns; arbace.c2j.main's compile-all binds it): the code an F6 call site's linked call
  expects, read from the analysis alone, so that the back end decides the same whether its own
  namespaces and arbace.core run evaluated (their roots Compiler$EvalFns) or compiled
  (Compiler$AOTFns, compiled-back-end: the fixpoint's G2); nil when not bound."
  nil)

(defn var-fns
  "The index *var-fns* of units us (each the recorded [kind line column lb cb expr events]): by
  each var, the FnExpr of its last top-level def whose init is a fn."
  [us]
  (let [m (IdentityHashMap.)]
    (doseq [u us]
      (walk-nodes (nth u 5)
                  (fn [n]
                    (when (and (= "def" (:op n)) (:initProvided n))
                      (let [i (node (:init n))]
                        (if (= "fn" (:op i))
                          (.put m (:var n) (:init n))
                          (.remove m (:var n))))))))
    m))

(defn- site-fn-methods
  "The fixed-arity method of nargs parameters (its node) of the fn var v's last def defines."
  [^Var v nargs]
  (when-let [^IdentityHashMap m *var-fns*]
    (when-let [fe (.get m v)]
      (some (fn [x] (let [mn (node x)]
                      (when (and (not (:isVariadic mn)) (= nargs (count (:reqParms mn)))) mn)))
            (:methods (node fe))))))

;; The callee's nodes are read in its own namespace: a parameter's class is its tag resolved
;; lazily (LocalBinding.getJavaClass), as the namespace that defined the fn imports it, not the
;; caller's (a call of arbace.repr.java.javac/types, [^Context ctx], from arbace.repr.java, compiled
;; before javac.ae: "Unable to resolve classname: Context"; doc/classes/JAVA-FRONTEND-SURVEY.md,
;; "As built: JN4")
(defn- site-spec
  "The worker's mask (spec-mask) of the fixed arity nargs of the fn of var v, or nil."
  [^Var v nargs]
  (binding [*ns* (.-ns v)]
    (some-> (site-fn-methods v nargs) spec-mask)))

(defn- site-psig
  "The primitive signature of the fixed arity nargs of the fn of var v, or nil."
  [^Var v nargs]
  (binding [*ns* (.-ns v)]
    (some-> (site-fn-methods v nargs) psig)))

(defn- prim-arg
  "Argument e of a call of an unboxed entry, for its parameter of class p: {:binds (the
  temporary of its value, evaluated once, in order), :gen (its boxed value, as the generic call
  passes it), :pri (its value as the entry takes it: the boxed invoke's own conversion of the
  boxed value, RT.longCast or doubleCast, unless the argument is of p already)}."
  [ctx e ^Class p t]
  (let [n (node e)
        pc (:prim n)
        conv (fn [f] (list (with-meta (if (= p Double/TYPE) 'arbace.lang.RT/doubleCast 'arbace.lang.RT/longCast)
                                {:param-tags '[java.lang.Object]})
                              f))
        m (:method n)]
    (cond
      (= p Object) {:binds [(tagged t Object) (deep (emit ctx e))] :gen t :pri t}
      ;; a constant: the boxed constant as emit makes it for the generic call, the literal (or
      ;; the constant converted) for the entry
      (= "number" (:op n))
      (let [v (:n n)
            g (deep (emit ctx e))]
        {:binds [] :gen g
         :pri (cond (and (= p Long/TYPE) (instance? Long v)) (long v)
                    (and (= p Double/TYPE) (instance? Double v)) (double-form v)
                    :else (conv g))})
      ;; a primitive expression whose boxed code is its unboxed code boxed (a local; a resolved
      ;; public static call): its value unboxed, boxed for the generic call as emit boxes it
      (and (= pc p) (can-prim? n)
           (or (= "local" (:op n))
               (and (= "static-method" (:op n)) m (public? (.getDeclaringClass ^java.lang.reflect.Method m))
                    (not (runtime-class? (.getDeclaringClass ^java.lang.reflect.Method m) ctx))
                    (not (jrt-lacks? m)))))
      {:binds [(tagged t p) (deep (emit-unboxed ctx e))] :gen (box t p) :pri t}
      :else {:binds [(tagged t Object) (deep (emit ctx e))] :gen t :pri (conv t)})))

(defn- spec-arg
  "Argument e of a call of a worker (F6, spec-mask), for its parameter taken as a long when k:
  {:binds (its temporary, evaluated once, in order), :gen (its boxed value, for the generic
  call), :pass (what the worker takes: the long and the box, or nil for a box the worker makes
  when needed; the value for a parameter not taken as a long), :guard (the test that it is a
  Long, nil when it is one by its type)}."
  [ctx e k t]
  (let [n (node e)
        m (:method n)
        sl (when (= "local" (:op n)) (spec-local ctx (:b n)))]
    (cond
      (not k) {:binds [(tagged t Object) (deep (emit ctx e))] :gen t :pass [t]}
      ;; the calling worker's own long parameter
      sl {:binds [] :gen (deep (emit ctx e)) :pass [(:l sl) (:b sl)]}
      (and (= "number" (:op n)) (instance? Long (:n n)))
      (let [g (deep (emit ctx e))] {:binds [] :gen g :pass [(long (:n n)) g]})
      (and (= Long/TYPE (:prim n)) (can-prim? n)
           (or (= "local" (:op n))
               (and (= "static-method" (:op n)) m (public? (.getDeclaringClass ^java.lang.reflect.Method m))
                    (not (runtime-class? (.getDeclaringClass ^java.lang.reflect.Method m) ctx))
                    (not (jrt-lacks? m)))))
      {:binds [(tagged t Long/TYPE) (deep (emit-unboxed ctx e))] :gen (box t Long/TYPE) :pass [t nil]}
      :else (or (some-> (spec-intrinsic ctx e t) deep)
                {:binds [(tagged t Object) (deep (emit ctx e))] :gen t
                 :guard (list 'instance? 'java.lang.Long t)
                 :pass [(list '.longValue (list 'cast 'java.lang.Long t)) t]}))))

(defn- emit-link-site
  "A call of var fexpr (its node fnode) with args (at most 20), linked when its root's code is
  known (link-key): a marker (c2j/link {...}) holding the emitted root, arguments and
  temporaries, which link-form resolves into the guarded direct call or the generic one. With
  out, the class a consumer converts the call's value to (long, double: the code's primitive
  return), and conv, the consumer's conversion of the generic call's value."
  ([ctx fnode args key] (emit-link-site ctx fnode args key nil nil))
  ([ctx fnode args key out conv]
   (let [root (deep (var-value ctx (:var fnode)))
         sig (site-psig (:var fnode) (count args))
         syms {:r (gsym ctx "root-") :w (gsym ctx "linked-") :f (gsym ctx "ifn-")
               :as (mapv (fn [_] (gsym ctx "arg-")) args)}
         mask (when-not sig (site-spec (:var fnode) (count args)))
         pargs (cond
                 sig (mapv (fn [e p t] (prim-arg ctx e p t)) args (:params sig) (:as syms))
                 mask (mapv (fn [e k t] (spec-arg ctx e k t)) args mask (:as syms)))
         as (if pargs (mapv :gen pargs) (mapv #(deep (emit ctx %)) args))
         site {:id (count @*link*)
               :key key
               :caller (top-name (:name @(:cls ctx)))
               :root root
               :args as
               :syms syms}
         site (cond
                sig (assoc site :psig sig :out out :conv conv
                           :binds (vec (mapcat :binds pargs)) :pri (mapv :pri pargs)
                           :parts [(vec (mapcat :binds pargs)) (mapv :pri pargs)])
                mask (let [guards (keep :guard pargs)
                           spass (vec (mapcat :pass pargs))]
                       (assoc site :smask mask
                              :binds (vec (mapcat :binds pargs)) :spass spass
                              :guard (when (seq guards) (if (next guards) (cons 'and guards) (first guards)))
                              :parts [(vec (mapcat :binds pargs)) spass (vec guards)]))
                :else site)]
     (swap! *link* conj site)
     (list 'c2j/link site))))

(defn link-form
  "The code of link marker m (emit-link-site): with cname, the code class of the fn the site
  expects (its fixed arity of the call's argument count, variadic its required count or nil),
  the guarded direct call; without, the generic call T1 makes. The guard: the root is a
  compiled fn (Compiler$AOTFn, or Compiler$AOTRestFn for variadic code) whose class is the code
  class's fn class (fn-class, one Class per code: Compiler$AOT/fnClass), one pointer compare
  (Compiler$AOTFn/linked, which answers the fn's body or nil); then the code's invoke is called
  directly with the fn as self, as the fn's invoke would call it. The root is read once, and
  cast to IFn before the arguments when the guard fails, as the generic call casts it.

  A call of a primitive fn's arity (:psig, F6) or of an arity with a worker (:smask, F6 step 2):
  its arguments bound first, each once (unboxed when the entry takes it so and it is of that
  type). For a primitive fn the direct call is of the code's unboxed entry, invokePrim (prims:
  the code's signatures by arity), its value boxed as the boxed invoke boxes it, or left unboxed
  for a consumer converting to the return's class (:out); for a worker it is of the code's
  invokeSpec (specs: the code's masks by arity) when the arguments it takes as longs are Longs
  (:guard), else of its invoke. The generic call is given the boxed arguments, its value
  converted as the consumer converts it."
  ([m cname variadic] (link-form m cname variadic nil nil))
  ([m cname variadic prims specs]
   (let [{:keys [root args syms psig smask out conv binds pri spass guard]} (second m)
         {:keys [r w f as]} syms
         conv (or conv identity)]
     (cond
       (and (or psig smask) (nil? cname))
       (list 'let (vec (concat [(tagged f 'arbace.lang.IFn) (list 'cast 'arbace.lang.IFn root)] binds))
             (conv (list* '.invoke f args)))
       (nil? cname)
       (list* '.invoke (list 'cast 'arbace.lang.IFn root) args)
       (or psig smask)
       (let [boxed (conv (list* '.invoke (list 'cast (symbol cname) w) r args))
             direct (cond
                      (and psig (= psig (get prims (count args))))
                      (let [c (list* '.invokePrim (list 'cast (symbol cname) w) r pri)]
                        (if out c (box c (:ret psig))))
                      (and smask (= smask (get specs (count args))))
                      (let [c (list* '.invokeSpec (list 'cast (symbol cname) w) r spass)]
                        (if guard (list 'if guard c boxed) c))
                      :else boxed)]
         (list 'let (vec (concat
                           [(tagged r Object) root
                            (tagged w Object) (list (if variadic 'arbace.lang.Compiler$AOTRestFn/linked 'arbace.lang.Compiler$AOTFn/linkedFast)
                                                    r (symbol cname "fn-class"))
                            (tagged f 'arbace.lang.IFn) (list 'if (list 'nil? w) (list 'cast 'arbace.lang.IFn r) nil)]
                           binds))
               (list 'if (list 'nil? w)
                     (conv (list* '.invoke f args))
                     direct)))
       :else
       (let [wt (if variadic 'arbace.lang.Compiler$AOTRestFn 'arbace.lang.Compiler$AOTFn)]
         (list 'let (vec (concat
                           [(tagged r Object) root
                            (tagged w Object) (list (symbol (str wt) "linked") r (symbol cname "fn-class"))
                            (tagged f 'arbace.lang.IFn) (list 'if (list 'nil? w) (list 'cast 'arbace.lang.IFn r) nil)]
                           (mapcat (fn [s a] [(tagged s Object) a]) as args)))
               (list 'if (list 'nil? w)
                     (list* '.invoke f as)
                     (list* '.invoke (list 'cast (symbol cname) w) r as))))))))

(defn link-target
  "The class name and record of the code class link key k names (link-key), given the classes
  made (name → record) and the fns' class names by FnExpr (fn-names); nil when none was made."
  [k classes ^IdentityHashMap fn-names]
  (let [cname (if (string? k) k (.get fn-names k))
        rec (when cname (get classes cname))]
    (when (= :fn (:kind rec)) [cname rec])))

(defn- site-key
  "The link key of invoke node n (link-key) when its call may be linked, else nil."
  [n]
  (let [fnode (node (:fexpr n))]
    (when (and *link* (= "var" (:op fnode)) (<= (count (:args n)) 20)
               (not (and (:isProtocol n) (:protocolOn n))))
      (link-key (:var fnode)))))

(defn- prim-call
  "The code of e, an invoke whose value a consumer converts to primitive class p by conv (a fn
  of the boxed value's form), when it is a call of a primitive fn's arity returning p (F6):
  its direct call's value left unboxed; else nil."
  [ctx e ^Class p conv]
  (let [n (node e)]
    (when (and (= "invoke" (:op n)) (#{Long/TYPE Double/TYPE} p))
      (when-let [key (site-key n)]
        (when (= p (:ret (site-psig (:var (node (:fexpr n))) (count (:args n)))))
          (line-meta (emit-link-site ctx (node (:fexpr n)) (:args n) key p conv) n))))))

(defn- invoke-linked
  "The invoke node kind's refinements of the emitted code (its emit-first): a protocol fn's
  call, the target's own method when it implements the protocol's interface, else the protocol
  fn (InvokeExpr.emitProto); a linked call (F5, F6); else nil, the generic call."
  [ctx n _]
  (let [args (:args n)
        fexpr (:fexpr n)
        fnode (node fexpr)
        key (site-key n)]
    (cond
      (and (:isProtocol n) (:protocolOn n) (not (runtime-class? (:protocolOn n) ctx)))
      (let [^java.lang.reflect.Method m (:onMethod n)
            on (:protocolOn n)
            t (gsym ctx "target-")
            rest-args (rest args)]
        (list 'let [(tagged t Object) (emit ctx (first args))]
              ;; not an object of a class made at run time: its Go type has a compiled
              ;; interface's methods only when the interface is the runtime's (SA142)
              (list 'if (list 'and (list 'instance? (type-sym on) t)
                              (list 'not (list 'arbace.lang.Compiler$AOT/isDyn t)))
                    (box (list* (with-meta (symbol (str (type-sym on)) (str "." (.getName m)))
                                  (param-tags (.getParameterTypes m)))
                                (list 'cast (type-sym on) t)
                                (typed-args ctx (.getParameterTypes m) rest-args))
                         (.getReturnType m))
                    (list* '.invoke (list 'cast 'arbace.lang.IFn (emit ctx fexpr)) t
                           (map #(emit ctx %) rest-args)))))
      key (emit-link-site ctx fnode args key))))

(defn- descriptor [^Class c]
  (cond
    (= c Void/TYPE) "V" (= c Long/TYPE) "J" (= c Integer/TYPE) "I" (= c Double/TYPE) "D"
    (= c Boolean/TYPE) "Z" (= c Character/TYPE) "C" (= c Float/TYPE) "F" (= c Short/TYPE) "S"
    (= c Byte/TYPE) "B"
    (.isArray c) (str/replace (.getName c) "." "/")
    :else (str "L" (str/replace (destub (.getName c)) "." "/") ";")))

(def ^:private jrt-scan
  (delay (jrt/scan (str (or (System/getenv "ARBACE_AOT_ROOT") ".") "/go/arbace/jrt"))))

(defn- jrt-lacks?
  "Is method m declared by a class jrt writes by hand (not a stand-in j2g's translation
  replaces) without it in Go? j2g would translate a direct call to a throw; the member tables
  (reflection) have such members, so compiled code calls them by reflection."
  [^java.lang.reflect.Method m]
  (let [scan @jrt-scan
        c (.getDeclaringClass m)
        jc (get (:classes scan) (.getName c))]
    (when (and jc (not (:standin jc)) (not= c Object))
      (let [g (nm/go-class-name (str/replace (.getName c) "." "/"))
            desc (str "(" (apply str (map #(descriptor %) (.getParameterTypes m))) ")"
                      (descriptor (.getReturnType m)))
            base (nm/method-base (.getName m) desc)]
        (if (java.lang.reflect.Modifier/isStatic (.getModifiers m))
          (not (contains? (:funcs scan) (str g "_" base)))
          (let [ms (into (jrt/struct-methods scan g) (jrt/iface-methods scan g))]
            (not (or (contains? ms base) (contains? ms (nm/impl-name base))
                     (contains? (:funcs scan) (str g "_" base))))))))))

(defn- method-call
  "A call of resolved method m: static (target nil) or on target form t."
  [ctx ^java.lang.reflect.Method m t args]
  (let [dc (.getDeclaringClass m)
        ps (.getParameterTypes m)
        static? (java.lang.reflect.Modifier/isStatic (.getModifiers m))
        head (with-meta (symbol (str (type-sym dc)) (str (when-not static? ".") (.getName m)))
               (param-tags ps))]
    (when (runtime-class? dc ctx) (fail (str "a call of a method of a class made at run time: " m)))
    (if static?
      (list* head (typed-args ctx ps args))
      (list* head (list 'cast (type-sym dc) t) (typed-args ctx ps args)))))

(defn- compiled-interface?
  "Is class c an interface of a namespace being compiled (gen-interface's, a protocol's)?"
  [ctx ^Class c]
  (= :interface (:kind (get @(:classes ctx) (destub (.getName c))))))

(defn- emit-instance-method [ctx n unboxed?]
  (let [^java.lang.reflect.Method m (:method n)]
    (cond
      ;; a method of a compiled namespace's interface: an object of a class made at run time
      ;; implements it only nominally (its Go type is the runtime's Dyn), so it is called by
      ;; reflection on such an object (SA142)
      (and m (compiled-interface? ctx (.getDeclaringClass m)) (not (:dyn-guarded n)))
      (let [t (gsym ctx "target-")
            dc (.getDeclaringClass m)
            n' (assoc n :target ::local :dyn-guarded true :target-sym t)]
        (list 'let [(tagged t Object) (emit ctx (:target n))]
              (list 'if (list 'and (list 'some? t) (list 'arbace.lang.Compiler$AOT/isDyn t))
                    (let [r (list (with-meta 'arbace.lang.Reflector/invokeInstanceMethod
                                    {:param-tags '[java.lang.Object java.lang.String java.lang.Object/1]})
                                  t (:methodName n) (obj-array ctx (:args n)))]
                      (if unboxed? (unbox-arg ctx r (.getReturnType m)) r))
                    (emit-instance-method ctx n' unboxed?))))
      (and m (public? (.getDeclaringClass m)) (not (runtime-class? (.getDeclaringClass m) ctx))
           (not (jrt-lacks? m)))
      (let [f (method-call ctx m (if (:target-sym n) (:target-sym n) (emit ctx (:target n))) (:args n))]
        (if unboxed? f (box f (.getReturnType m))))
      (and m unboxed?)
      (unbox-arg ctx (emit-instance-method ctx (assoc n :method nil :qualifyingClass (.getDeclaringClass m)) false)
                 (.getReturnType m))
      m (emit-instance-method ctx (assoc n :method nil :qualifyingClass (.getDeclaringClass m)) false)
      (:qualifyingClass n)
      (list 'arbace.lang.Reflector/invokeInstanceMethodOfClass (emit ctx (:target n))
            (constant ctx (:qualifyingClass n)) (:methodName n) (obj-array ctx (:args n)))
      :else
      (list (with-meta 'arbace.lang.Reflector/invokeInstanceMethod
              {:param-tags '[java.lang.Object java.lang.String java.lang.Object/1]})
            (emit ctx (:target n)) (:methodName n) (obj-array ctx (:args n))))))

;; ---------------------------------------------------------------------------------------
;; arithmetic intrinsics (Futamura F3, doc/FUTAMURA-SURVEY.md "F3 and the back end's limits as
;; built"): a call of one of Numbers' boxed operations (an Object operand) gets an inline fast
;; path for Long operands (and Double ones, both Double, for the (Object, Object) and (Object)
;; operations), which computes what Numbers' LongOps (DoubleOps) would and boxes as they box
;; (Long/valueOf, Double/valueOf); any other operand, and a Long case whose result Numbers
;; would not make as a long (an overflow: thrown, or promoted to a BigInt by the ' operations; a
;; zero divisor; a negation of Long/MIN_VALUE), calls the operation itself. So the fast path
;; only ever answers what Numbers answers, ratios, bigints, Integers and the rest included.

(def ^:private long-min 'java.lang.Long/MIN_VALUE)
(def ^:private long-max 'java.lang.Long/MAX_VALUE)

(def ^:private ^:dynamic *lbox*
  "While set, how the Long case's result is given (spec-intrinsic: as the long itself), in
  place of its box."
  nil)

(defn- long-box [f] (if *lbox* (*lbox* f) (list (with-meta 'java.lang.Long/valueOf {:param-tags '[long]}) f)))
(defn- double-box [f] (list (with-meta 'java.lang.Double/valueOf {:param-tags '[double]}) f))

(defn- long-op2
  "The Long case of Numbers' binary operation op on longs x, y (symbols; r the result's local):
  a form of the operation's result type, slow where Numbers would not answer a long; nil: not
  an intrinsic."
  [op x y slow r]
  (let [checked (fn [f ok] (list 'let [(tagged r Long/TYPE) f] (list 'if ok (long-box r) slow)))
        add-ok (list '>= (list 'bit-and (list 'bit-xor x r) (list 'bit-xor y r)) 0)
        ;; x - y: Numbers adds the negation of y, which overflows for Long/MIN_VALUE
        sub-ok (list 'and (list 'not (list '== y long-min))
                     (list '>= (list 'bit-and (list 'bit-xor x y) (list 'bit-xor x r)) 0))
        ;; Numbers' own test (multiplyP's), exact for multiplyExact's overflow
        mul-ok (list 'and (list 'not (list 'and (list '== x long-min) (list '< y 0)))
                     (list 'or (list '== y 0) (list '== (list 'unchecked-divide r y) x)))]
    (case op
      ("add" "addP") (checked (list 'unchecked-add x y) add-ok)
      "unchecked_add" (long-box (list 'unchecked-add x y))
      ("minus" "minusP") (checked (list 'unchecked-subtract x y) sub-ok)
      "unchecked_minus" (long-box (list 'unchecked-subtract x y))
      ("multiply" "multiplyP") (checked (list 'unchecked-multiply x y) mul-ok)
      "unchecked_multiply" (long-box (list 'unchecked-multiply x y))
      ;; a zero divisor throws Numbers' ArithmeticException
      "quotient" (list 'if (list '== y 0) slow (long-box (list 'unchecked-divide x y)))
      "remainder" (list 'if (list '== y 0) slow (long-box (list 'unchecked-remainder x y)))
      "and" (list 'bit-and x y)
      "or" (list 'bit-or x y)
      "xor" (list 'bit-xor x y)
      "shiftLeft" (list 'bit-shift-left x y)
      "shiftRight" (list 'bit-shift-right x y)
      "lt" (list '< x y)
      "lte" (list '<= x y)
      "gt" (list '> x y)
      "gte" (list '>= x y)
      "equiv" (list '== x y)
      nil)))

(defn- double-op2
  "The Double case (both operands Double) of Numbers' binary operation op (DoubleOps: the '
  operations are the others, a difference the sum with the negation), or nil."
  [op x y]
  (case op
    ("add" "addP" "unchecked_add") (double-box (list 'unchecked-add x y))
    ("minus" "minusP" "unchecked_minus") (double-box (list 'unchecked-add x (list 'unchecked-negate y)))
    ("multiply" "multiplyP" "unchecked_multiply") (double-box (list 'unchecked-multiply x y))
    "lt" (list '< x y)
    "lte" (list '<= x y)
    "gt" (list '< y x)
    "gte" (list '>= x y)
    "equiv" (list '== x y)
    nil))

(defn- long-op1
  "The Long case of Numbers' unary operation op on long x, as long-op2's."
  [op x slow]
  (let [guard (fn [bad f] (list 'if (list '== x bad) slow (long-box f)))]
    (case op
      ("inc" "incP") (guard long-max (list 'unchecked-inc x))
      "unchecked_inc" (long-box (list 'unchecked-inc x))
      ("dec" "decP") (guard long-min (list 'unchecked-dec x))
      "unchecked_dec" (long-box (list 'unchecked-dec x))
      ("minus" "minusP") (guard long-min (list 'unchecked-negate x))
      "unchecked_minus" (long-box (list 'unchecked-negate x))
      "isZero" (list '== x 0)
      "isPos" (list '> x 0)
      "isNeg" (list '< x 0)
      nil)))

(defn- double-op1
  "The Double case of Numbers' unary operation op, as double-op2's."
  [op x]
  (case op
    ("inc" "incP" "unchecked_inc") (double-box (list 'unchecked-add x 1.0))
    ("dec" "decP" "unchecked_dec") (double-box (list 'unchecked-subtract x 1.0))
    ("minus" "minusP" "unchecked_minus") (double-box (list 'unchecked-negate x))
    "isZero" (list '== x 0.0)
    "isPos" (list '> x 0.0)
    "isNeg" (list '< x 0.0)
    nil))

(defn- intrinsic-probe
  "Is Numbers' static method m one of the boxed operations with fast paths? Its signature
  ([:o :j ...]) when it is, else nil."
  [^java.lang.reflect.Method m]
  (when (= (.getDeclaringClass m) arbace.lang.Numbers)
    (let [ps (vec (.getParameterTypes m))
          sig (mapv #(cond (= % Object) :o (= % Long/TYPE) :j :else :x) ps)
          op (.getName m)
          probe (case (count ps)
                  1 (when (= sig [:o]) (long-op1 op 'x 'slow))
                  2 (when (and (some #{:o} sig) (every? #{:o :j} sig)) (long-op2 op 'x 'y 'slow 'r))
                  nil)]
      (when probe sig))))

(defn numbers-fast
  "The call of Numbers' static method m with its fast paths, or nil when m is not one of the
  boxed operations above: the builder both halves of the static call share (arbace.c2j.node's
  static-call: the evaluator's CodeOpN too, test/c2j/gen_nodes.ae). (specs-fn sig): per operand,
  the worker's long parameter it is (F6, spec-local: a Long, no test, its long as is, its box
  for the slow path) or nil; (gs base): a fresh temporary; (targs-fn): the operands' forms,
  asked after the temporaries are named."
  [^java.lang.reflect.Method m specs-fn gs targs-fn]
  (when-let [sig (intrinsic-probe m)]
    (let [ps (vec (.getParameterTypes m))
          op (.getName m)
          specs (specs-fn sig)
          temps (mapv (fn [sp] (when-not sp (gs "na-"))) specs)
          targs (targs-fn)
          binds (vec (mapcat (fn [t p f] (when t [(tagged t p) f])) temps ps targs))
          boxes (mapv (fn [t sp] (if sp (list 'if (list 'nil? (:b sp)) (list 'set! (:b sp) (long-box* (:l sp))) (:b sp)) t))
                      temps specs)
          slow (list* (with-meta (symbol "arbace.lang.Numbers" op) (param-tags ps)) boxes)
          lv (fn [t] (list '.longValue (list 'cast 'java.lang.Long t)))
          dv (fn [t] (list '.doubleValue (list 'cast 'java.lang.Double t)))
          objs (keep (fn [[t s sp]] (when (and (= s :o) (not sp)) t)) (map vector temps sig specs))
          is (fn [c] (let [ts (map #(list 'instance? c %) objs)]
                       (if (next ts) (cons 'and ts) (first ts))))
          xs (mapv (fn [k] (gs (str "n" k "-"))) (range (count ps)))
          ;; the operands as longs: an Object one unboxed, a long one as is
          lbinds (vec (mapcat (fn [x t s sp] [(tagged x Long/TYPE) (cond sp (:l sp) (= s :o) (lv t) :else t)])
                              xs temps sig specs))
          lfast (if (= 1 (count ps)) (long-op1 op (xs 0) slow) (long-op2 op (xs 0) (xs 1) slow (gs "nr-")))
          dfast (when (and (every? #{:o} sig) (not-any? some? specs))
                  (if (= 1 (count ps)) (double-op1 op (xs 0)) (double-op2 op (xs 0) (xs 1))))
          dbinds (vec (mapcat (fn [x t] [(tagged x Double/TYPE) (dv t)]) xs temps))]
      (list 'let binds
            (if (empty? objs)
              (list 'let lbinds lfast)
              (list 'if (is 'java.lang.Long)
                    (list 'let lbinds lfast)
                    (if dfast
                      (list 'if (is 'java.lang.Double) (list 'let dbinds dfast) slow)
                      slow)))))))

(defn- numbers-intrinsic
  "The call of Numbers' static method m on args (as: a delay of their forms, typed-args's) with
  its fast paths, or nil (numbers-fast). An Object operand that is a worker's long parameter
  (F6, spec-local) is a Long."
  [ctx ^java.lang.reflect.Method m args as]
  (numbers-fast m
                (fn [sig] (mapv (fn [s e] (when (= s :o)
                                            (let [n (node e)]
                                              (when (= "local" (:op n)) (spec-local ctx (:b n))))))
                                sig args))
                #(gsym ctx %)
                #(deref as)))

(defn static-call-form
  "The direct call of static method m on argument forms args."
  [^java.lang.reflect.Method m args]
  (list* (with-meta (symbol (str (type-sym (.getDeclaringClass m))) (.getName m)) (param-tags (.getParameterTypes m)))
         args))

(defn- call-static
  "The direct call of static method m on the arguments as (a delay of their forms, typed-args
  of the children xs), with Numbers' fast paths (F3) when m is one of its boxed operations."
  [ctx ^java.lang.reflect.Method m as xs]
  (or (numbers-intrinsic ctx m xs as) (static-call-form m @as)))

(def ^:private long-valued-ops
  #{"add" "addP" "minus" "minusP" "multiply" "multiplyP" "unchecked_add" "unchecked_minus"
    "unchecked_multiply" "inc" "incP" "dec" "decP" "unchecked_inc" "unchecked_dec" "quotient"
    "remainder"})

(defn- spec-intrinsic
  "Argument e of a worker's call for a parameter it takes as a long (F6, spec-arg), when e is an
  operation of Numbers with fast paths whose Object operands are all the calling worker's long
  parameters: its Long case computed as a long, not boxed (the worker boxes it if it needs to,
  as the generic call's argument would have been boxed, once); its other case's value (Numbers'
  own: an overflow promoted, a ratio) in temporary t, nil in the Long case. As spec-arg's
  result, or nil."
  [ctx e t]
  (let [n (node e)
        ^java.lang.reflect.Method m (:method n)
        sig (when (and (= "static-method" (:op n)) m) (intrinsic-probe m))]
    (when (and sig (contains? long-valued-ops (.getName m)) (not (.isPrimitive (.getReturnType m))))
      (let [args (:args n)
            specs (mapv (fn [s a] (when (= s :o) (let [an (node a)] (when (= "local" (:op an)) (spec-local ctx (:b an))))))
                        sig args)]
        (when (every? identity (map (fn [s sp] (or (= s :j) sp)) sig specs))
          (let [ps (vec (.getParameterTypes m))
                op (.getName m)
                tl (symbol (str t "_l"))
                xs (mapv (fn [k] (gsym ctx (str "n" k "-"))) (range (count ps)))
                xbinds (vec (mapcat (fn [x s sp a] [(tagged x Long/TYPE) (if sp (:l sp) (first (typed-args ctx [Long/TYPE] [a])))])
                                    xs sig specs args))
                boxes (mapv (fn [x s sp] (if sp (list 'if (list 'nil? (:b sp)) (list 'set! (:b sp) (long-box* (:l sp))) (:b sp)) x))
                            xs sig specs)
                slow (list 'do (list 'set! t (list* (with-meta (symbol "arbace.lang.Numbers" op) (param-tags ps)) boxes)) 0)
                fast (binding [*lbox* identity]
                       (if (= 1 (count ps)) (long-op1 op (xs 0) slow) (long-op2 op (xs 0) (xs 1) slow (gsym ctx "nr-"))))]
            {:binds [(vary-meta (tagged t Object) assoc :mutable true) nil
                     (tagged tl Long/TYPE) (list 'let xbinds fast)]
             :gen (list 'if (list 'nil? t) (long-box* tl) t)
             :guard (list 'or (list 'nil? t) (list 'instance? 'java.lang.Long t))
             :pass [(list 'if (list 'nil? t) tl (list '.longValue (list 'cast 'java.lang.Long t))) t]}))))))

(defn- direct-static?
  "Does the emitted code call the method of static-method node n directly (the static-call
  node kind), not by reflection?"
  [ctx n]
  (let [^java.lang.reflect.Method m (:method n)]
    (boolean (and m (public? (.getDeclaringClass m)) (not (runtime-class? (.getDeclaringClass m) ctx))
                  (not (jrt-lacks? m))))))

(defn- emit-static-method
  "A static method called by reflection (one direct-static? does not take: static-call)."
  [ctx n unboxed?]
  (let [^java.lang.reflect.Method m (:method n)]
    (if (and m unboxed?)
      (unbox-arg ctx (emit-static-method ctx (assoc n :method nil) false) (.getReturnType m))
      (list (with-meta 'arbace.lang.Reflector/invokeStaticMethod
              {:param-tags '[java.lang.Class java.lang.String java.lang.Object/1]})
            (constant ctx (:c n)) (:methodName n) (obj-array ctx (:args n))))))

(defn- field-ok? [ctx ^java.lang.reflect.Field f]
  (and f (public? (.getDeclaringClass f)) (not (runtime-class? (.getDeclaringClass f) ctx))))

(defn- emit-instance-field [ctx n unboxed?]
  (let [^java.lang.reflect.Field f (:field n)]
    (if (field-ok? ctx f)
      (let [r (list (symbol (str ".-" (.getName f))) (list 'cast (type-sym (.getDeclaringClass f)) (emit ctx (:target n))))]
        (if unboxed? r (box r (.getType f))))
      (list (with-meta 'arbace.lang.Reflector/invokeNoArgInstanceMember
              {:param-tags '[java.lang.Object java.lang.String boolean]})
            (emit ctx (:target n)) (:fieldName n) (:requireField n)))))

(defn- emit-static-field [ctx n unboxed?]
  (let [^java.lang.reflect.Field f (:field n)]
    (if (field-ok? ctx f)
      (let [r (symbol (str (type-sym (.getDeclaringClass f))) (.getName f))]
        (if unboxed? r (box r (.getType f))))
      (list (with-meta 'arbace.lang.Reflector/getStaticField {:param-tags '[java.lang.Class java.lang.String]})
            (constant ctx (:c n)) (:fieldName n)))))

(defn- emit-new [ctx n]
  (let [^java.lang.reflect.Constructor k (:ctor n)
        c (:c n)]
    (if (and k (public? c) (not (runtime-class? c ctx)))
      (list* (with-meta (symbol (str (type-sym c) ".")) (param-tags (.getParameterTypes k)))
             (typed-args ctx (.getParameterTypes k) (:args n)))
      (list (with-meta 'arbace.lang.Reflector/invokeConstructor {:param-tags '[java.lang.Class java.lang.Object/1]})
            (constant ctx c) (obj-array ctx (:args n))))))

(defn- emit-def [ctx n top?]
  (let [v (const-field ctx (:var n) 'arbace.lang.Var)
        init (when (:initProvided n) (emit ctx (:init n)))
        meta (when (:meta n) (list 'cast 'arbace.lang.IPersistentMap (emit ctx (:meta n))))]
    (if top?
      ;; a top-level def of an embedded source (the variant's DefExpr.eval, aot): the root,
      ;; the metadata, then the dynamic flag only when ^:dynamic
      (concat (list 'do)
              (when (:initProvided n) [(list '.bindRoot v init)])
              (when meta [(list '.setMeta v meta)])
              [(if (:isDynamic n) (list '.setDynamic v true) v)])
      ;; a def in a fn (DefExpr.emit)
      (concat (list 'do)
              (when (:isDynamic n) [(list '.setDynamic v true)])
              (when meta [(list '.setMeta v meta)])
              (when (:initProvided n) [(list '.bindRoot v init)])
              [v]))))

(defn- emit-assign [ctx n]
  (let [t (:target n)
        tn (node t)
        val (:val n)]
    (case (:op tn)
      "var" (list '.set (const-field ctx (:var tn) 'arbace.lang.Var) (emit ctx val))
      "local" (let [lb (:b tn) b (node lb)]
                (if (closed? ctx lb)
                  (list 'set! (field-read ctx lb b) (if (:bindingPrim b) (emit-unboxed ctx val) (emit ctx val)))
                  (fail "set! of a local that is no field")))
      "instance-field" (let [^java.lang.reflect.Field f (:field tn)]
                         (if (field-ok? ctx f)
                           (list 'set! (list (symbol (str ".-" (.getName f)))
                                             (list 'cast (type-sym (.getDeclaringClass f)) (emit ctx (:target tn))))
                                 (first (typed-args ctx [(.getType f)] [val])))
                           (list 'arbace.lang.Reflector/setInstanceField (emit ctx (:target tn)) (:fieldName tn)
                                 (emit ctx val))))
      "static-field" (let [^java.lang.reflect.Field f (:field tn)]
                       (list 'set! (symbol (str (type-sym (.getDeclaringClass f))) (.getName f))
                             (first (typed-args ctx [(.getType f)] [val]))))
      (fail (str "set! of " (:op tn))))))

(defn- coll-call [sym es ctx]
  (list (with-meta sym {:param-tags '[java.lang.Object/1]}) (obj-array ctx es)))

(defn- emit-binding-init
  "A let or loop binding [sym init] of LocalBinding lb (LetExpr.doEmit)."
  [ctx lb init]
  (let [b (node lb)
        p (:bindingPrim b)]
    (if p
      [(tagged (local-sym b) p) (emit-unboxed ctx init)]
      [(tagged (local-sym b) Object) (emit ctx init)])))

(defn- emit-let [ctx n unboxed?]
  (let [bis (map node (:bindingInits n))
        ctx' (if (:isLoop n) (assoc ctx :loop-locals (mapv :binding bis)) ctx)
        bindings (vec (mapcat #(emit-binding-init ctx (:binding %) (:init %)) bis))
        body (if unboxed? (emit-unboxed ctx' (:body n)) (emit ctx' (:body n)))]
    (list (if (:isLoop n) 'loop 'let) bindings body)))

(defn- emit-recur [ctx n]
  (let [lls (:loopLocals n)]
    (when (:method-recur ctx)
      (when (= (vec lls) (:method-locals ctx)) (reset! (:method-recur ctx) true)))
    (cons 'recur
          (map (fn [lb arg]
                 (let [b (node lb)
                       primc (:bindingPrim b)
                       pc (prim arg)]
                   (if primc
                     (cond
                       (= pc primc) (emit-unboxed ctx arg)
                       (and (= primc Long/TYPE) (= pc Integer/TYPE)) (emit-unboxed ctx arg)
                       (and (= primc Double/TYPE) (= pc Float/TYPE)) (emit-unboxed ctx arg)
                       (and (= primc Integer/TYPE) (= pc Long/TYPE))
                       (list (with-meta 'arbace.lang.RT/intCast {:param-tags '[long]}) (emit-unboxed ctx arg))
                       (and (= primc Float/TYPE) (= pc Double/TYPE)) (list 'unchecked-float (emit-unboxed ctx arg))
                       :else (fail (str "recur arg for primitive local: " (:name b) " is not matching primitive")))
                     (emit ctx arg))))
               lls (:args n)))))

(defn- body-instance
  "A new instance of fn or reify class ox (its node), its closed-over values from the current
  method: (new C closed...) (ObjExpr.emit); letfn's own locals nil (set after). A fn's is its
  code (SA141), which fn-wrap makes the fn."
  [ctx ox nil-locals]
  (let [cname (emit-fn-class! ctx ox)
        args (for [lb (keys (:closes ox))]
               (if (.containsKey ^IdentityHashMap nil-locals lb)
                 nil
                 (let [b (node lb)]
                   (emit-local ctx {:b lb :shouldClear false} (boolean (:bindingPrim b))))))]
    (list* 'new (symbol cname) (concat (when (and (= "new-instance" (:op ox)) (:supportsMeta ox)) [nil]) args))))

(defn- fn-wrap
  "The fn of fn ox (its node) whose code is form body: a Compiler$AOTFn, or a
  Compiler$AOTRestFn of the variadic arity's required count."
  [ctx ox body]
  (let [cname (emit-fn-class! ctx ox)
        k (:variadic (get @(:classes ctx) cname))
        f (symbol cname "fn-class")
        c (gsym ctx "fncls__")
        ;; the fn's class, made at run time on the first fn of this code and kept in the code
        ;; class's static field (SA154: no static initializer per fn class)
        cls (list 'let [(tagged c 'java.lang.Class) f]
                  (list 'if (list 'nil? c)
                        (let [d (symbol (str c "d"))]
                          (list 'let [(tagged d 'java.lang.Class)
                                      (list (with-meta 'arbace.lang.Compiler$AOT/fnClass {:param-tags '[java.lang.String boolean]})
                                            cname (boolean k))]
                                (list 'set! f d)
                                d))
                        c))]
    (if k
      (list 'new 'arbace.lang.Compiler$AOTRestFn body cls nil (list 'unchecked-int k))
      (list 'new 'arbace.lang.Compiler$AOTFn body cls nil))))

(defn- fn-instance
  "A new fn or reify (ox, its node)."
  [ctx ox nil-locals]
  (let [b (body-instance ctx ox nil-locals)]
    (if (= "fn" (:op ox)) (fn-wrap ctx ox b) b)))

(defn- emit-letfn [ctx n unboxed?]
  (let [bis (map node (:bindingInits n))
        lbs (identity-set (map :binding bis))
        syms (map #(local-sym (node (:binding %))) bis)
        bsyms (map #(symbol (str "body-" %)) syms)
        bodies (for [bi bis] (body-instance ctx (node (:init bi)) lbs))
        sets (for [[bi bs] (map vector bis bsyms)
                   :let [ox (node (:init bi))
                         cname (emit-fn-class! ctx ox)]
                   lb (keys (:closes ox))
                   :when (.containsKey ^IdentityHashMap lbs lb)]
               (list 'set! (list (field-sym (node lb)) bs) (local-sym (node lb))))]
    (list 'let (vec (concat
                      (mapcat (fn [bs bi b] [(tagged bs (symbol (emit-fn-class! ctx (node (:init bi))))) b]) bsyms bis bodies)
                      (mapcat (fn [s bs bi] [(tagged s Object) (fn-wrap ctx (node (:init bi)) bs)]) syms bsyms bis)))
          (concat (list 'do) sets [(if unboxed? (emit-unboxed ctx (:body n)) (emit ctx (:body n)))]))))

(defn- emit-try [ctx n unboxed?]
  (let [body (fn [e] (if unboxed? (emit-unboxed ctx e) (emit ctx e)))]
    (concat (list 'try (body (:tryExpr n)))
            (for [c (:catchExprs n)
                  :let [cn (node c)]]
              (list 'catch (type-sym (:c cn)) (local-sym (node (:lb cn))) (body (:handler cn))))
            (when (:finallyExpr n)
              [(list 'finally (emit ctx (:finallyExpr n)))]))))

(defn- emit-case [ctx n unboxed?]
  (let [e (:expr n)
        en (node e)
        pt (:prim en)
        shift (:shift n) mask (:mask n)
        sm (fn [f] (if (zero? mask) f (list 'bit-and-int (list 'bit-shift-right-int f shift) (unchecked-int mask))))
        tests (into (sorted-map) (:tests n))
        thens (:thens n)
        ret (fn [x] (if unboxed? (emit-unboxed ctx x) (emit ctx x)))
        lbl (keyword (str (gsym ctx "case-")))
        int-test? (= (:testType n) :int)
        key (cond
              (not int-test?) (sm (list 'arbace.lang.Util/hash (emit ctx e)))
              (nil? pt) nil
              (#{Long/TYPE Integer/TYPE Short/TYPE Byte/TYPE} pt) (sm (list 'unchecked-int (emit-unboxed ctx e)))
              :else :default)
        skip (set (:skipCheck n))
        arm (fn [i t th]
              (cond
                (and int-test? (nil? pt))
                (list 'when (list (with-meta 'arbace.lang.Util/equiv {:param-tags '[java.lang.Object java.lang.Object]})
                                  (emit ctx e) (emit ctx t))
                      (list 'break lbl (ret th)))
                (and int-test? (= pt Long/TYPE))
                (list 'when (list '== (emit-unboxed ctx t) (emit-unboxed ctx e)) (list 'break lbl (ret th)))
                int-test?
                (if (zero? mask)
                  (list 'break lbl (ret th))
                  (list 'when (list '== (emit-unboxed ctx t) (list 'long (emit-unboxed ctx e))) (list 'break lbl (ret th))))
                (contains? skip i) (list 'break lbl (ret th))
                (= (:testType n) :hash-identity)
                (list 'when (list 'identical? (emit ctx e) (emit ctx t)) (list 'break lbl (ret th)))
                :else
                (list 'when (list (with-meta 'arbace.lang.Util/equiv {:param-tags '[java.lang.Object java.lang.Object]})
                                  (emit ctx e) (emit ctx t))
                      (list 'break lbl (ret th)))))
        sw (cond
             (= key :default) nil
             (and int-test? (nil? pt))
             (list 'when (list 'instance? 'java.lang.Number (emit ctx e))
                   (concat (list 'switch (sm (list '.intValue (list 'cast 'java.lang.Number (emit ctx e)))))
                           (mapcat (fn [[i t]] [i (arm i t (get thens i))]) tests)))
             :else
             (concat (list 'switch key)
                     (mapcat (fn [[i t]] [i (arm i t (get thens i))]) tests)))]
    (list 'label lbl sw (ret (:defaultExpr n)))))

;; ---------------------------------------------------------------------------------------
;; node kinds defined once (Futamura F7, doc/FUTAMURA-SURVEY.md, "F7 as built"): each defnode
;; is this back end's emitter of the kind (emit-KIND) and, read by test/c2j/gen_nodes.ae, the
;; evaluator's Code classes of it (arbace/lang/go/CompilerNodes.ae); arbace.c2j.node says how.
;; What a definition's expansion asks of this namespace: emit, emit-unboxed, typed-args, box,
;; call-static, local-place (above) and lift, prim-chan (here)

(defn- lift
  "A defnode's static value v, of class t (a symbol), as the emitted code's: a primitive's
  literal; nil, a string, a boolean, an empty collection as Java forms write them; else a
  constant of the class's pool."
  [ctx v t]
  (case t
    boolean (boolean v)
    long (long v)
    int (int v)
    double (double-form v)
    (cond
      (or (nil? v) (string? v)) v
      (instance? Boolean v) (if v 'java.lang.Boolean/TRUE 'java.lang.Boolean/FALSE)
      (and (instance? arbace.lang.IPersistentCollection v) (zero? (count v)))
      (cond (instance? IPersistentList v) 'arbace.lang.PersistentList/EMPTY
            (instance? IPersistentVector v) 'arbace.lang.PersistentVector/EMPTY
            (instance? IPersistentMap v) 'arbace.lang.PersistentArrayMap/EMPTY
            (instance? IPersistentSet v) 'arbace.lang.PersistentHashSet/EMPTY
            :else (fail "unknown empty collection"))
      :else (constant ctx v))))

(defn- prim-chan
  "The channel of node n's unboxed value (its primitive type's): :j a long or int, :d a double,
  :z a boolean, :p another."
  [n]
  (let [p (:prim n)]
    (cond (or (= p Long/TYPE) (= p Integer/TYPE)) :j (= p Double/TYPE) :d (= p Boolean/TYPE) :z :else :p)))

(defnode const
  "A literal or a quoted constant (NumberExpr ... TheVarExpr): its value, made when the node is,
  and a number's long and double."
  {:exprs [NumberExpr ConstantExpr StringExpr KeywordExpr NilExpr BooleanExpr EmptyExpr TheVarExpr]
   :chans [:o :j :d]}
  [v (static Object (arbace.lang.Compiler$AST/literal e))
   num (static boolean (instance? Number v))
   lv (static long (if num (.longValue (cast Number v)) 0))
   dv (static double (if num (.doubleValue (cast Number v)) 0.0))]
  (static-case ch
    :o v
    :j (static-if num lv (.longValue (cast Number v)))
    :d (static-if num dv (.doubleValue (cast Number v)))))

(defnode local
  "A use of a local (LocalBindingExpr): its value where it lives; on its last use on its path,
  where the half keeps it alive, cleared (locals clearing: ObjExpr.emitLocal, emitClearLocals).
  Where it lives is each half's own (the evaluator's slots, prims and closed-over values, the
  emitted code's locals and fields)."
  {:exprs [] :fields [b shouldClear]}
  [at (place)]
  (static-if (clears? at)
    (let [t (get-place at :o)] (set-place at nil) t)
    (get-place at ch)))

(defnode if
  "Clojure's if (IfExpr): the test's truth (a boolean's own when the test is one) chooses the
  branch, in the channel asked."
  {:exprs [IfExpr]}
  [test (child testExpr)
   thn (child thenExpr)
   els (child elseExpr)
   z (static boolean (identical? (arbace.lang.Compiler$AST/primType testExpr) Boolean/TYPE))]
  (if (static-if z (run :z test) (run :o test)) (run ch thn) (run ch els)))

(defnode static-call
  "A call of a resolved static method the half calls directly (StaticMethodExpr): its
  arguments converted to the parameters' classes and bound in order, then the call (Numbers'
  boxed operations with F3's fast paths), its value in the channel asked (boxed as its
  return's). The evaluator's: Numbers', RT's, Util's and Math's listed methods
  (test/c2j/gen_nodes.ae), a switch per arity; the emitted code's: every public one
  (direct-static?)."
  {:exprs [StaticMethodExpr] :fields [method args line] :class "CodeOp"
   :domain {:index (if (nil? method) -1 (Compiler$CodeRun/op method))}}
  [m (static java.lang.reflect.Method method)
   xs (children args 3 :convert (.getParameterTypes method))
   line (static int line)]
  (call-site line [as (run-args m xs)]
    (box-as ch m (call-static m as))))

(defnode invoke
  "A call of a fn value (InvokeExpr): the fn, then its arguments, in order, then IFn's invoke
  (applyTo past 20 arguments); in tail position the evaluator's frame lets go of its object
  first (InvokeExpr.emitArgsAndCall, ObjMethod.emitClearThis). The emitted code's refinements:
  protocol calls and linked calls (invoke-linked)."
  {:exprs [InvokeExpr] :fields [fexpr args line tailPosition] :chans [:o] :emit-first invoke-linked}
  [fx (child fexpr)
   xs (children args 20)
   line (static int line)
   clear (eval-static boolean (and tailPosition (not (.-canBeDirect (.-objx cc)))))]
  (call-site line [g (cast arbace.lang.IFn (run :o fx)) as (run-all :o xs)]
    (eval-only (when clear (Compiler$CodeRun/clearThis f)))
    (static-if (many? xs)
      (.applyTo g (^{:param-tags [java.lang.Object/1]} arbace.lang.ArraySeq/create (array-of as)))
      (.invoke g (splice as)))))

(def ^:private box-of
  {Long/TYPE 'java.lang.Long/valueOf Double/TYPE 'java.lang.Double/valueOf
   Integer/TYPE 'java.lang.Integer/valueOf Boolean/TYPE 'java.lang.Boolean/valueOf
   Character/TYPE 'java.lang.Character/valueOf Float/TYPE 'java.lang.Float/valueOf
   Short/TYPE 'java.lang.Short/valueOf Byte/TYPE 'java.lang.Byte/valueOf})

(defn- box-prim
  "Form f of node n boxed when it is of a primitive type (emitBoxReturn: valueOf, long's
  Numbers.num being Long.valueOf), so that emit's code is always a reference, as the bytecode's
  emit leaves one."
  [f n]
  (let [p (:prim n)]
    (if (and p (#{"local" "instance?"} (:op n))
             (box-of p))
      (list (with-meta (box-of p) {:param-tags [(prim-names p)]}) f)
      f)))

(defn emit
  "Code for analyzed node e, its value boxed (an Expr's emit)."
  [ctx e]
  (let [n (node e)
        f (case (:op n)
            "local" (emit-local ctx n false)
            ("number" "constant" "string" "keyword" "nil" "boolean" "empty" "the-var") (emit-const ctx n false)
            "var" (var-value ctx (:var n))
            "def" (emit-def ctx n false)
            "set!" (emit-assign ctx n)
            ;; the class, as ImportExpr.emit leaves it (and the evaluator's ImportExpr.evalIn)
            "import" (list '.importClass (list 'cast 'arbace.lang.Namespace (list '.deref 'arbace.lang.RT/CURRENT_NS))
                           (list 'arbace.lang.RT/classForNameNonLoading (:c n)))
            "instance-field" (emit-instance-field ctx n false)
            "static-field" (emit-static-field ctx n false)
            "instance-method" (emit-instance-method ctx n false)
            "static-method" (if (direct-static? ctx n) (emit-static-call ctx n false) (emit-static-method ctx n false))
            "monitor-enter" (list 'do (list 'arbace.lang.Compiler$Evaluator/monitorEnter (emit ctx (:target n))) nil)
            "monitor-exit" (list 'do (list 'arbace.lang.Compiler$Evaluator/monitorExit (emit ctx (:target n))) nil)
            "try" (emit-try ctx n false)
            "throw" (list 'throw (list 'cast 'java.lang.Throwable (emit ctx (:excExpr n))))
            "new" (emit-new ctx n)
            "with-meta" (list '.withMeta (list 'cast 'arbace.lang.IObj (emit ctx (:expr n)))
                              (list 'cast 'arbace.lang.IPersistentMap (emit ctx (:meta n))))
            "if" (emit-if ctx n false)
            "list" (coll-call 'arbace.lang.RT/arrayToList (:args n) ctx)
            "vector" (let [args (:args n)]
                       (if (<= (count args) 6)
                         (list* (with-meta 'arbace.lang.Tuple/create {:param-tags (vec (repeat (count args) 'java.lang.Object))})
                                (map #(emit ctx %) args))
                         (coll-call 'arbace.lang.RT/vector args ctx)))
            "map" (coll-call 'arbace.lang.RT/map (:keyvals n) ctx)
            "set" (coll-call 'arbace.lang.RT/set (:keys n) ctx)
            "keyword-invoke" (list '.invoke (const-field ctx (:k (node (:kw n))) 'arbace.lang.Keyword) (emit ctx (:target n)))
            "str-concat" (let [texts (vec (:texts n))]
                           (list 'arbace.lang.Compiler$AOT/strConcat
                                 (list 'new 'java.lang.String/1 texts)
                                 (list 'new 'java.lang.Object/1
                                       (mapv (fn [t a] (if t nil (emit ctx a))) texts (:args n)))))
            "instance?" (let [c (:c n)]
                          (if (runtime-class? c ctx)
                            (list '.isInstance (constant ctx c) (emit ctx (:expr n)))
                            (list 'instance? (type-sym c) (emit ctx (:expr n)))))
            "invoke" (emit-invoke ctx n false)
            "fn" (fn-instance ctx n (IdentityHashMap.))
            "new-instance" (if (:isDeftype n)
                             ;; deftype*: the class, made once; its value nil (ObjExpr.emit)
                             (do (emit-deftype-class! ctx n) nil)
                             (fn-instance ctx n (IdentityHashMap.)))
            "do" (let [es (:exprs n)]
                   (if (empty? es)
                     nil
                     (concat (list 'do)
                             (keep (fn [x] (let [xn (node x)]
                                             (when-not (= "local" (:op xn)) (emit ctx x))))
                                   (butlast es))
                             [(emit ctx (last es))])))
            "let" (emit-let ctx n false)
            "letfn" (emit-letfn ctx n false)
            "recur" (emit-recur ctx n)
            "case" (emit-case ctx n false)
            (fail (str "no back end for " (:op n) (when (:type n) (str " " (:type n))))))]
    (line-meta (box-prim f n) n)))

(defn emit-unboxed
  "Code for analyzed node e, its value of its primitive type (emitUnboxed)."
  [ctx e]
  (let [n (node e)]
    (when-not (or (can-prim? n) (= "throw" (:op n))) (fail (str "unboxed emit of " (:op n))))
    (line-meta
      (case (:op n)
        "local" (emit-local ctx n true)
        "number" (emit-const ctx n true)
        "instance-method" (emit-instance-method ctx n true)
        "static-method" (if (direct-static? ctx n) (emit-static-call ctx n true) (emit-static-method ctx n true))
        "static-field" (emit-static-field ctx n true)
        "instance-field" (emit-instance-field ctx n true)
        "if" (emit-if ctx n true)
        "do" (let [es (:exprs n)]
               (concat (list 'do) (map #(emit ctx %) (butlast es)) [(emit-unboxed ctx (last es))]))
        "let" (emit-let ctx n true)
        "letfn" (emit-letfn ctx n true)
        "try" (emit-try ctx n true)
        "case" (emit-case ctx n true)
        "instance?" (let [c (:c n)]
                      (if (runtime-class? c ctx)
                        (list '.isInstance (constant ctx c) (emit ctx (:expr n)))
                        (list 'instance? (type-sym c) (emit ctx (:expr n)))))
        "recur" (emit-recur ctx n)
        "throw" (list 'throw (list 'cast 'java.lang.Throwable (emit ctx (:excExpr n))))
        (fail (str "no unboxed back end for " (:op n))))
      n)))

;; ---------------------------------------------------------------------------------------
;; fn classes

(defn- deep
  "Form f realized throughout (the emitters build lazy seqs; what they record, the constants
  and the classes, must be recorded before it is read), metadata kept."
  [f]
  (cond
    (seq? f) (with-meta (apply list (map deep f)) (meta f))
    (vector? f) (with-meta (mapv deep f) (meta f))
    :else f))

(defn- simple-name [^String binary]
  (subs binary (inc (.lastIndexOf binary "$"))))

(defn- throws?
  "Does node e end in a throw (a form that does not complete, which needs no conversion)?"
  [e]
  (let [n (node e)]
    (case (:op n)
      "throw" true
      "do" (throws? (last (:exprs n)))
      false)))

(defn- ret-body
  "A deftype's method body as returned in type ret (ObjMethod.emitBody): unboxed when it can be,
  else boxed then cast or unboxed as ASM's unbox does."
  [ctx body ^Class ret]
  (let [n (node body)
        bc (:prim n)]
    (if (and (.isPrimitive ret) (not= ret Void/TYPE) (can-prim? n))
      (cond
        (= bc ret) (emit-unboxed ctx body)
        (and (= ret Long/TYPE) (= bc Integer/TYPE)) (emit-unboxed ctx body)
        (and (= ret Double/TYPE) (= bc Float/TYPE)) (emit-unboxed ctx body)
        (and (= ret Integer/TYPE) (= bc Long/TYPE))
        (list (with-meta 'arbace.lang.RT/intCast {:param-tags '[long]}) (emit-unboxed ctx body))
        (and (= ret Float/TYPE) (= bc Double/TYPE)) (list 'unchecked-float (emit-unboxed ctx body))
        :else (fail (str "mismatched primitive return, expected " ret ", had " bc)))
      (let [num (fn [f] (list (symbol (str "." (.getName ret) "Value")) (list 'cast 'java.lang.Number f)))]
       (or
        ;; a call of a primitive fn returning ret: its unboxed value (F6)
        (and (#{Long/TYPE Double/TYPE} ret) (prim-call ctx body ret num))
        (let [f (emit ctx body)]
        (cond
          (throws? body) f
          (= ret Void/TYPE) f
          (= ret Object) f
          (= ret Boolean/TYPE) (list '.booleanValue (list 'cast 'java.lang.Boolean f))
          (= ret Character/TYPE) (list '.charValue (list 'cast 'java.lang.Character f))
          (.isPrimitive ret) (num f)
          (or (runtime-class? ret ctx) (not (public? ret))) f
          :else (list 'cast (type-sym ret) f))))))))

(defn- method-body
  "The body of FnMethod or NewInstanceMethod m (its node), in the method's context: wrapped in
  a loop over its parameters when a recur targets them. With entry, the body of a fn method's
  unboxed entry (F6, psig): its primitive parameters taken as they are, its value of the
  signature's return class."
  [ctx mn params & [entry]]
  (let [rec (atom false)
        locals (vec (concat (:reqParms mn) (when (:restParm mn) [(:restParm mn)])
                            (when-not (:reqParms mn) (:argLocals mn))))
        ctx' (assoc ctx :method-recur rec :method-locals locals :loop-locals locals)
        ;; ^long and ^double parameters of a fn that is not primitive: converted on entry, as
        ;; the evaluator's invokeFn does (RT.longCast, doubleCast)
        fn-method? (= "fn-method" (:op mn))
        prims (when (and fn-method? (not entry))
                (for [lb locals
                      :let [b (node lb)]
                      :when (:bindingPrim b)]
                  b))
        ret (:retClass mn)
        body (cond
               ;; the unboxed entry's: the return as its class
               (and entry (#{Long/TYPE Double/TYPE} ret)) (ret-body ctx' (:body mn) ret)
               ;; a fn's ^long or ^double return: converted on exit, as the evaluator's
               ;; Evaluator.result (the Go build makes no fn primitive)
               (and fn-method? (#{Long/TYPE Double/TYPE} ret)) (box (ret-body ctx' (:body mn) ret) ret)
               fn-method? (emit ctx' (:body mn))
               :else (ret-body ctx' (:body mn) ret))
        _ (when (and (= entry :spec) (do (deep body) @rec))
            (fail (str "a worker's body recurs to its parameters: " (:name (:objx ctx)))))
        body (if @rec
               (list 'loop (vec (mapcat (fn [lb] (let [b (node lb)] [(tagged (local-sym b) (or (:bindingPrim b) Object)) (local-sym b)]))
                                        locals))
                     body)
               body)]
    (if (seq prims)
      (list 'let (vec (mapcat (fn [b] [(tagged (local-sym b) (:bindingPrim b))
                                       (list (with-meta (if (= (:bindingPrim b) Double/TYPE) 'arbace.lang.RT/doubleCast 'arbace.lang.RT/longCast)
                                               {:param-tags '[java.lang.Object]})
                                             (symbol (str "p-" (local-sym b))))])
                              prims))
            body)
      body)))

(defn- param-sym [lb]
  (let [b (node lb)]
    (if (:bindingPrim b)
      (symbol (str "p-" (local-sym b)))
      (local-sym b))))

(def ^:private prim-classes
  {'long Long/TYPE 'double Double/TYPE 'int Integer/TYPE 'boolean Boolean/TYPE 'char Character/TYPE
   'float Float/TYPE 'short Short/TYPE 'byte Byte/TYPE})

(defn- tag-class
  "The class a field's tag names (Compiler.tagClass): Object without one."
  [tag]
  (cond
    (nil? tag) Object
    (prim-classes tag) (prim-classes tag)
    (class? tag) tag
    :else (let [c (ns-resolve *ns* tag)] (if (class? c) c (Class/forName (str tag))))))

(defn- box-class [^Class c]
  ({Long/TYPE Long Double/TYPE Double Integer/TYPE Integer Boolean/TYPE Boolean Character/TYPE Character
    Float/TYPE Float Short/TYPE Short Byte/TYPE Byte} c))

(defn- class-interfaces
  "The interfaces of a deftype's or reify's class (its node ox), as the analysis made the
  class: their names. A class of the program cannot implement an interface made at run time."
  [ctx ox]
  (let [^Class c (:compiledClass ox)]
    (when-not c (fail (str "no class for " (:name ox))))
    (vec (for [^Class i (.getInterfaces c)]
           (if (runtime-class? i ctx)
             (fail (str (:name ox) " implements " (.getName i) ", made at run time"))
             (symbol (destub (.getName i))))))))

(defn- field-mods
  "The modifiers of a deftype's field lb (ObjExpr.compile): volatile, mutable (package), or
  public final."
  [ox lb]
  (let [m (meta (:sym (node lb)))]
    (cond
      (:volatile-mutable m) {:volatile true}
      (:unsynchronized-mutable m) {}
      :else {:public true :final true})))

(defn emit-deftype-class!
  "Defines deftype ox's class (its node), a top-level class named as the deftype, once:
  its fields, constructors, getBasis (and create for a record), and methods
  (NewInstanceExpr.compile, emitStatics)."
  [ctx ox]
  (let [cname (destub (:name ox))]
    (when-not (contains? @(:classes ctx) cname)
      (swap! (:classes ctx) assoc cname ::pending)
      (let [cls (pool ctx cname)
            fields (vec (keys (:closes ox)))
            ;; its methods' this is this, also when the deftype is in a fn's code (self there)
            ctx' (assoc (dissoc ctx :spec-locals) :cls cls :objx ox :once false :closed (identity-set fields) :self-sym 'this)
            fbs (mapv node fields)
            ftype (fn [b] (or (:bindingPrim b) Object))
            fsym (fn [b] (symbol (:name b)))
            hinted (:hintedFields ox)
            nh (count hinted)
            drops (:altCtorDrops ox)
            ctor (list* 'constructor (with-meta (vec (cons 'this (map #(tagged (fsym %) (ftype %)) fbs))) {:public true})
                        '(super.)
                        (for [b fbs] (list 'set! (list (field-sym b) 'this) (fsym b))))
            alt-ctors (when (pos? drops)
                        (let [n (count fbs)
                              ps (fn [k] (vec (cons 'this (map #(tagged (fsym %) (ftype %)) (take k fbs)))))]
                          [(list 'constructor (with-meta (ps (- n drops)) {:public true})
                                 (list* 'this. (concat (map fsym (take (- n drops) fbs)) [nil nil (list 'unchecked-int 0) (list 'unchecked-int 0)])))
                           (list 'constructor (with-meta (ps (- n 2)) {:public true})
                                 (list* 'this. (concat (map fsym (take (- n 2) fbs)) [(list 'unchecked-int 0) (list 'unchecked-int 0)])))]))
            basis (list 'method (with-meta 'getBasis {:public true :static true}) (tagged [] 'arbace.lang.IPersistentVector)
                        (emit-value ctx' hinted))
            create (when (> (count fbs) nh)
                     (let [m 'm__]
                       (list 'method (with-meta 'create {:public true :static true})
                             (tagged [(tagged m 'arbace.lang.IPersistentMap)] (symbol cname))
                             (let [steps (for [[i f] (map-indexed vector hinted)
                                               :let [k (list (with-meta 'arbace.lang.Keyword/intern {:param-tags '[java.lang.String]}) (name f))
                                                     c (tag-class (:tag (meta f)))]]
                                           [(symbol (str "v__" i))
                                            (let [v (list '.valAt m k nil)]
                                              (if (.isPrimitive ^Class c)
                                                (list (symbol (str "." (.getName ^Class c) "Value"))
                                                      (list 'cast (type-sym (box-class c)) v))
                                                v))
                                            k])]
                               (list 'let [(with-meta m {:mutable true}) m]
                                     (list* 'let (vec (mapcat (fn [[v x _]] [v x]) steps))
                                            (concat (for [[_ _ k] steps] (list 'set! m (list '.without m k)))
                                                    [(list* 'new (symbol cname)
                                                            (concat (map first steps)
                                                                    [nil (list 'arbace.lang.RT/seqOrElse m)
                                                                     (list 'unchecked-int 0) (list 'unchecked-int 0)]))])))))))
            methods (for [m (:methods ox)
                          :let [mn (node m)
                                als (:argLocals mn)
                                ptypes (map #(:c (node (:init (node %)))) als)
                                ps (vec (cons 'this (map (fn [lb c] (tagged (local-sym (node lb)) c)) als ptypes)))]]
                      (vary-meta
                        (list 'method (with-meta (symbol (:name mn)) {:public true}) (tagged ps (:retClass mn))
                              (method-body ctx' mn ps))
                        assoc :c2j/line (:line mn)))
            fields-forms (for [lb fields :let [b (node lb)]]
                           (list 'field (tagged (with-meta (fsym b) (field-mods ox lb)) (ftype b))))
            members (deep (concat fields-forms [ctor] alt-ctors [basis] (when create [create]) methods))]
        (swap! (:classes ctx) assoc cname
               {:name cname :kind :deftype :super 'java.lang.Object :interfaces (class-interfaces ctx ox)
                :members members :line (:line ox) :source (:source ctx)})))
    cname))

(defn emit-fn-class!
  "Defines the class of fn or reify ox (its node) once, in the classes being emitted; returns
  its binary name."
  [ctx ox]
  (let [^IdentityHashMap named (:fn-names ctx)
        known (.get named (:self ox))
        base (destub (:name ox))
        ;; two fns of one name (a defn evaluated again in its source, as core's bootstrap
        ;; definitions are: the JVM's AOT keeps the last class file of the name): the later one
        ;; numbered
        cname (or known
                  (loop [k 0]
                    (let [c (if (zero? k) base (str base "__" k))]
                      (if (contains? @(:classes ctx) c) (recur (inc k)) c))))]
    (when-not known
      (.put named (:self ox) cname)
      (swap! (:classes ctx) assoc cname ::pending)
      (let [cls (pool ctx (top-name cname))
            fn? (= "fn" (:op ox))
            ctx' (assoc (dissoc ctx :spec-locals) :cls cls :objx ox :once (:onceOnly ox) :closed (identity-set (keys (:closes ox)))
                        :self-sym (if fn? 'self 'this))
            closes (keys (:closes ox))
            ;; a reify's metadata is its object's (__meta); a fn's is its Compiler$AOTFn's
            meta? (and (not fn?) (boolean (:supportsMeta ox)))
            fields (for [lb closes :let [b (node lb)]]
                     (list 'field (tagged (symbol (:name b)) (or (:bindingPrim b) Object))))
            ctor (list* 'constructor (with-meta (vec (concat ['this] (when meta? [(tagged 'meta__ 'arbace.lang.IPersistentMap)])
                                                             (for [lb closes :let [b (node lb)]]
                                                               (tagged (symbol (str "c__" (:name b))) (or (:bindingPrim b) Object)))))
                                       {:public true})
                        '(super.)
                        (concat (when meta? ['(set! (.-__meta this) meta__)])
                                (for [lb closes :let [b (node lb)]]
                                  (list 'set! (list (field-sym b) 'this) (symbol (str "c__" (:name b)))))))
            variadic (some #(when (:isVariadic (node %)) (node %)) (when fn? (:methods ox)))
            methods
            (if fn?
              ;; a fn's code (SA141): invoke(self, a...) of Compiler$AOTF<n>, doInvoke(self, a...,
              ;; rest) of Compiler$AOTR<k>, self the fn (its name in its body)
              (for [m (:methods ox)
                    :let [mn (node m)
                          req (:reqParms mn)
                          ps (vec (concat ['this 'self] (map param-sym req)
                                          (when (:restParm mn) [(param-sym (:restParm mn))])))
                          sig (psig mn)
                          mask (when-not sig (spec-mask mn))]
                    f (cond
                        mask
                        ;; F6, step 2: a speculative worker, invokeSpec, taking the parameters
                        ;; of the mask as longs (with their boxes, nil when the caller had none:
                        ;; made once, when needed), entered from the boxed invoke and from linked
                        ;; calls when those arguments are Longs; else the boxed body
                        (let [infos (mapv (fn [lb k] (when k (let [ls (local-sym (node lb))]
                                                               {:l (symbol (str ls "_l")) :b (symbol (str ls "_b"))})))
                                          req mask)
                              sl (IdentityHashMap.)
                              _ (doseq [[lb i] (map vector req infos) :when i] (.put sl lb i))
                              wps (vec (concat ['this 'self]
                                               (mapcat (fn [lb i] (if i
                                                                    [(tagged (:l i) Long/TYPE) (vary-meta (tagged (:b i) Object) assoc :mutable true)]
                                                                    [(param-sym lb)]))
                                                       req infos)))
                              generic (deep (method-body ctx' mn ps))
                              worker (deep (method-body (assoc ctx' :spec-locals sl) mn wps :spec))
                              guards (for [[lb i] (map vector req infos) :when i]
                                       (list 'instance? 'java.lang.Long (param-sym lb)))
                              guard (if (next guards) (cons 'and guards) (first guards))]
                          [(list 'method (with-meta 'invoke {:public true}) ps
                                 (list 'if guard
                                       (list* '.invokeSpec 'this 'self
                                              (mapcat (fn [lb i] (if i
                                                                   [(list '.longValue (list 'cast 'java.lang.Long (param-sym lb))) (param-sym lb)]
                                                                   [(param-sym lb)]))
                                                      req infos))
                                       generic))
                           (list 'method (with-meta 'invokeSpec {:public true}) wps worker)])
                        sig
                        ;; a primitive fn's arity (F6): its unboxed entry, and the boxed invoke
                        ;; converting its arguments (RT.longCast, doubleCast) and boxing the
                        ;; entry's value, as the boxed method converts and boxes
                        (let [eps (vec (concat ['this 'self]
                                               (map (fn [lb p] (tagged (local-sym (node lb)) p)) req (:params sig))))]
                          [(list 'method (with-meta 'invokePrim {:public true}) (tagged eps (:ret sig))
                                 (method-body ctx' mn eps true))
                           (list 'method (with-meta 'invoke {:public true}) ps
                                 (box (list* '.invokePrim 'this 'self
                                             (map (fn [lb p]
                                                    (if (= p Object)
                                                      (param-sym lb)
                                                      (list (with-meta (if (= p Double/TYPE) 'arbace.lang.RT/doubleCast 'arbace.lang.RT/longCast)
                                                              {:param-tags '[java.lang.Object]})
                                                            (param-sym lb))))
                                                  req (:params sig)))
                                      (:ret sig)))])
                        :else
                        [(list 'method (with-meta (if (:isVariadic mn) 'doInvoke 'invoke) {:public true}) ps
                               (method-body ctx' mn ps))])]
                (vary-meta f assoc :c2j/line (:line mn)))
              (for [m (:methods ox)
                    :let [mn (node m)
                          als (:argLocals mn)
                          ptypes (map #(:c (node (:init (node %)))) als)
                          ps (vec (cons 'this (map (fn [lb c] (tagged (local-sym (node lb)) c)) als ptypes)))]]
                (list 'method (with-meta (symbol (:name mn)) {:public true}) (tagged ps (:retClass mn))
                      (method-body ctx' mn ps))))
            extra (concat
                    (when fn?
                      ;; the fn's class, named as the JVM names it, a subclass of the fn's
                      ;; Compiler$AOTFn made at run time (getClass answers it: j2g$class)
                      ;; (SA154: set by the code making the fn, fn-wrap; no static initializer)
                      [(list 'field (tagged (with-meta 'fn-class {:public true :static true}) 'java.lang.Class))])
                    (when meta?
                      [(list 'field (tagged '__meta 'arbace.lang.IPersistentMap))
                       (list 'method (with-meta 'meta {:public true}) (tagged '[this] 'arbace.lang.IPersistentMap) '(.-__meta this))
                       (list 'method (with-meta 'withMeta {:public true}) (tagged ['this (tagged 'm 'arbace.lang.IPersistentMap)] 'arbace.lang.IObj)
                             (list* 'new (symbol cname) 'm
                                    (for [lb closes] (list (field-sym (node lb)) 'this))))]))
            interfaces (if fn?
                         (vec (for [m (:methods ox) :let [mn (node m)]]
                                (symbol (str (if (:isVariadic mn) "arbace.lang.Compiler$AOTR" "arbace.lang.Compiler$AOTF")
                                             (count (:reqParms mn))))))
                         (class-interfaces ctx ox))]
        (let [members (deep (concat fields [ctor] methods extra))]
        (swap! (:classes ctx) assoc cname
               {:name cname
                :members members
                :source (:source ctx)
                :kind (if fn? :fn :reify)
                :super 'java.lang.Object
                :interfaces interfaces
                :variadic (when variadic (count (:reqParms variadic)))
                ;; the unboxed entries' signatures by arity (F6)
                :prims (when fn? (not-empty (into {} (for [m (:methods ox)
                                                          :let [mn (node m) sig (psig mn)]
                                                          :when sig]
                                                      [(count (:reqParms mn)) sig]))))
                ;; the workers' masks by arity (F6, step 2)
                :specs (when fn? (not-empty (into {} (for [m (:methods ox)
                                                          :let [mn (node m) mask (spec-mask mn)]
                                                          :when mask]
                                                      [(count (:reqParms mn)) mask]))))
                :line (:line ox)}))))
    cname))

;; ---------------------------------------------------------------------------------------
;; a source's units

(defn- unit-method
  "The static method unitK of a source's loader class: unit u's events made again, then its
  code."
  [ctx k [kind line column _ _ expr events]]
  (let [ctx (assoc ctx :unit-proxies (atom #{}))
        ns-events (keep identity (for [ev events
                        :let [ev (vec ev)]]
                    (case (first ev)
                      "ns" (list '.set 'arbace.lang.RT/CURRENT_NS
                                 (list 'arbace.lang.Namespace/findOrCreate (list 'cast 'arbace.lang.Symbol (constant ctx (nth ev 2)))))
                      ;; the class a deftype*, reify* or gen-interface made is compiled
                      ("stub" "type" "iface" "imethod")
                      (if-let [n (and (string? (nth ev 1)) (nth ev 1))]
                        ;; none when the analysis that made the event was given up for the Java
                        ;; forms compiler (a reify in a fn using the code forms: its stub)
                        (if-let [c (try (Class/forName (destub n)) (catch Exception _ nil))]
                          (if (runtime-class? c ctx)
                            (fail (str "an event of a class made at run time: " n))
                            nil)
                          nil)
                        nil)
                      ;; proxy's class, made again (Compiler$Image.replay)
                      "proxy" (list '.applyTo
                                    (list 'cast 'arbace.lang.IFn (list '.getRawRoot (const-field ctx #'arbace.core/get-proxy-class 'arbace.lang.Var)))
                                    (list (with-meta 'arbace.lang.RT/cons {:param-tags '[java.lang.Object java.lang.Object]})
                                          (constant ctx (nth ev 2))
                                          (list (with-meta 'arbace.lang.RT/seq {:param-tags '[java.lang.Object]})
                                                (list 'new 'java.lang.Object/1 (mapv #(constant ctx %) (seq (nth ev 3)))))))
                      (fail (str "an event of kind " (first ev))))))
        n (node expr)
        code (if (= kind 1)
               ;; (fn* [] form): its one method's body, inline
               (let [m (node (first (:methods n)))
                     ctx' (assoc ctx :objx n :once false :closed nil)]
                 (when (seq (:closes n)) (fail "a top-level fn closing over locals"))
                 (emit ctx' (:body m)))
               (if (= "def" (:op n))
                 (emit-def ctx n true)
                 (emit ctx expr)))
        ;; realized in the order of the method's form, as before (the constants' numbers):
        ;; the events, then the code
        ns-events (doall ns-events)
        code (deep code)
        ;; a deftype the compiler made in code it handed to the Java forms compiler (a deftype*
        ;; in a fn using the code forms, analyze-clj-special) is in no unit's tree but its event:
        ;; emitted from it, as from the tree (REAP3, RPS6 (a), the compiler's classes; none in the
        ;; shipped tree, every deftype's class being emitted by its code first)
        _ (doseq [ev events
                  :let [ev (vec ev)]
                  :when (and (= "type" (first ev)) (string? (nth ev 1))
                             (instance? arbace.lang.Compiler$NewInstanceExpr (nth ev 2))
                             (not (contains? @(:classes ctx) (destub (nth ev 1)))))]
            (emit-deftype-class! ctx (node (nth ev 2))))
        ;; the proxy classes made at run time before this unit was analyzed, which its code
        ;; names (runtime-class?): made again unless they are (arbace.core's define-proxy, as
        ;; get-proxy-class makes them, by their name: the namespace then may have been another)
        proxies (for [^Class c (sort-by #(.getName ^Class %) @(:unit-proxies ctx))
                      :let [pname (.getName c)]]
                  (list 'when (list 'nil? (list (with-meta 'arbace.lang.RT/loadClassForName {:param-tags '[java.lang.String]}) pname))
                        (list '.invoke
                              (list 'cast 'arbace.lang.IFn (list '.getRawRoot (const-field ctx #'arbace.core/define-proxy 'arbace.lang.Var)))
                              pname
                              (constant ctx (.getSuperclass c))
                              (list (with-meta 'arbace.lang.RT/seq {:param-tags '[java.lang.Object]})
                                    (list 'new 'java.lang.Object/1
                                          (vec (for [^Class i (.getInterfaces c) :when (not= i arbace.lang.IProxy)]
                                                 (constant ctx i))))))))]
    (vary-meta
      (list 'method (with-meta (symbol (str "unit" k)) {:private true :static true}) []
            (concat (list 'do (list 'arbace.lang.Compiler$AOT/at (list 'unchecked-int line) (list 'unchecked-int column)))
                    ns-events
                    (doall proxies)
                    [code]))
      assoc :c2j/line line)))

(defn- unit-ns
  "The namespace unit u was analyzed in: its fn's (kind 1) or its def's, else nil."
  [[kind _ _ _ _ expr]]
  (let [n (node expr)]
    (cond
      (= kind 1) (let [nm ^String (:name n)
                       i (.indexOf nm "$")]
                   (find-ns (symbol (arbace.lang.Compiler/demunge (if (neg? i) nm (subs nm 0 i))))))
      (= "def" (:op n)) (.-ns ^Var (:var n))
      :else nil)))

(def loader-part-units
  "The most units a source's loader class holds itself; a source of more is split into parts of
  as many (SA210): j2g analyzes classes in parallel, one class on one thread (arbace.core's 903
  units were one task of 9 to 14 s, the last of the analysis)."
  100)

(defn unnamed-package
  "The option placing top-level class nm in Java's unnamed package when its name has no
  package: the classes of a namespace of one segment (user: its holder user, the fns
  user$eval1$fn__2, the loader of a source user.ae, user__init), named as the JVM names them,
  where the Java forms would put a simple name in the package of the namespace they are read in
  (arbace). The tree's files import them (arbace.c2j.main), so that a class of a package can name
  them, as Java could not."
  [^String nm]
  (when-not (str/includes? nm ".") [:package ""]))

(defn emit-source
  "The Java forms of source path src (scriptbase.ae), compiled from its units: the loader
  class SCRIPTBASE__init's form and the fn classes made, into the atom classes (fn-names: the
  fns' class names by their FnExpr, an IdentityHashMap shared by the sources)."
  [classes runtime-classes fn-names pools src units]
  (let [base (subs src 0 (.lastIndexOf ^String src "."))
        lname (str (str/replace base "/" ".") "__init")
        ;; the source's file name, its classes' source file in stack traces (:c2j/source)
        file (subs src (inc (.lastIndexOf ^String src "/")))
        ctx {:classes classes :runtime-classes runtime-classes :fn-names fn-names :pools pools
             :source file}
        ;; the methods of the units ks, their constants in pool cls, in order
        unit-methods (fn [cls ks]
                       (mapv (fn [k]
                               (let [[u um] (nth units k)]
                                 ;; the analysis resolved tags lazily, against *ns*: the unit's
                                 ;; namespace while it is emitted
                                 (binding [*ns* (or (unit-ns u) *ns*)]
                                   (deep (unit-method (assoc ctx :cls cls :unchecked-math um) k u)))))
                             ks))
        calls (fn [cname ks] (for [k ks] (list (symbol cname (str "unit" k)))))
        n (count units)]
    (if (<= n loader-part-units)
      (let [cls (pool {:pools pools} lname)
            ms (unit-methods cls (range n))]
        {:name lname
         :form (concat (list 'defclass (with-meta (symbol lname) {:public true :final true :c2j/source file}))
                       (unnamed-package lname)
                       (pool-fields (:consts @cls))
                       ms
                       [(list 'method (with-meta 'load {:public true :static true}) []
                              (concat (list 'do) (calls lname (range n)) [nil]))])})
      ;; split (SA210): the units in parts of at most loader-part-units, each a static member
      ;; class SCRIPTBASE__init$partP with its units and their constants (an object an earlier
      ;; part met is a field set from that part's: one object, as unsplit), which j2g analyzes in
      ;; parallel (the analysis of one class is sequential); load initializes the parts in
      ;; order, so that every constant is made before the first unit runs, as unsplit, then
      ;; runs their units in order
      (let [prev (IdentityHashMap.)
            parts (vec (for [[p ks] (map-indexed vector (partition-all loader-part-units (range n)))]
                         (let [pname (str lname "$part" p)
                               cls (atom {:name pname :consts [] :const-map (IdentityHashMap.) :const-prefix "" :prev prev})
                               ms (unit-methods cls ks)]
                           {:name pname
                            :form (vary-meta
                                    (concat (list 'defclass (with-meta (symbol (str "part" p))
                                                              {:static true :final true :c2j/source file}))
                                            (pool-fields (:consts @cls))
                                            ms
                                            [(list 'method (with-meta 'init {:static true}) [] nil)
                                             (list 'method (with-meta 'load {:static true}) []
                                                   (concat (list 'do) (calls pname ks) [nil]))])
                                    assoc :c2j/line (:c2j/line (meta (first ms))))})))]
        {:name lname
         :form (concat (list 'defclass (with-meta (symbol lname) {:public true :final true :c2j/source file}))
                       (unnamed-package lname)
                       (map :form parts)
                       [(list 'method (with-meta 'load {:public true :static true}) []
                              (concat (list 'do)
                                      (for [{pn :name} parts] (list (symbol pn "init")))
                                      (for [{pn :name} parts] (list (symbol pn "load")))
                                      [nil]))])}))))

;; ---------------------------------------------------------------------------------------
;; the holder classes: fn classes nested as their names nest

(defn- class-form
  "The defclass form of class c (its record: a fn's, a reify's, a deftype's, an interface's, or
  a holder of nested classes), its nested classes inside; at the top its full name and the
  constants it shares with them (pools: top → its pool), else a static member class by its
  simple name."
  [c children-of top? pools]
  (let [nm (:name c)
        nested (map #(class-form % children-of false pools) (children-of nm))
        ;; the source file a class was compiled from (not a holder's: its fns may come from
        ;; several), its frames' file in stack traces (j2g's ClassInfo.Source)
        mods (fn [m] (cond-> (if top? (dissoc m :static) m)
                       (:source c) (assoc :c2j/source (:source c))
                       ;; a fn's code: no member table (SA154), reflection sees its fn's class
                       (= :fn (:kind c)) (assoc :c2j/code true)))
        head (if top? (symbol nm) (symbol (simple-name nm)))
        ctx {:cls (atom {}) :runtime-classes (atom #{})}
        consts (when top? (when-let [p (get pools nm)] (:consts @p)))
        const-forms (pool-fields consts)
        pkg (when top? (unnamed-package nm))]
    (vary-meta
      (case (:kind c)
        :holder (concat (list 'defclass (with-meta head (mods {:public true :static true :final true}))) pkg const-forms nested)
        :interface (concat (list 'defclass (with-meta head (mods {:public true :static true :interface true})))
                           pkg
                           (when (seq (:extends c)) [:extends (:extends c)])
                           (:members c)
                           nested)
        (concat (list 'defclass (with-meta head (mods {:public true :static true :final true}))
                      :extends (:super c))
                pkg
                (when (seq (:interfaces c)) [:implements (:interfaces c)])
                const-forms
                (:members c)
                nested))
      assoc :c2j/line (:line c))))

(defn class-forms
  "The top-level Java forms holding every class of classes (name → record), nested as their
  binary names nest, with holder classes made for the missing levels (a namespace's fns nest
  in a holder named as the namespace); pools: the top-level classes' constants."
  [classes pools]
  (let [names (set (keys classes))
        parent (fn [^String n] (let [i (.lastIndexOf n "$")] (when (pos? i) (subs n 0 i))))
        all (loop [todo (vec names) acc names]
              (if-let [n (peek todo)]
                (let [p (parent n)]
                  (if (and p (not (contains? acc p)))
                    (recur (conj (pop todo) p) (conj acc p))
                    (recur (pop todo) acc)))
                acc))
        recs (into {} (for [n all] [n (or (get classes n) {:name n :kind :holder})]))
        ;; member classes in the order of their lines: j2g lays a Java forms file's text out on
        ;; the lines its forms carry (J2G-SPEC §4.3), so lines that go back and forth pad it
        kids (group-by parent (sort-by (fn [n] [(or (:line (recs n)) 0) n]) all))
        children-of (fn [n] (map recs (get kids n)))]
    (for [top (sort (get kids nil))]
      (class-form (recs top) children-of true pools))))

(defn interface-record
  "The record of an interface made by gen-interface (events iface and imethod): name, the
  interfaces it extends, its abstract methods."
  [name extends methods]
  {:name name :kind :interface
   :extends (mapv #(symbol (destub (.getName ^Class %))) extends)
   :members (for [[mname ps ret] methods]
              (list 'method (with-meta (symbol mname) {:public true :abstract true})
                    (tagged (vec (cons 'this (map-indexed (fn [i p] (tagged (symbol (str "p" i)) p)) ps))) ret)))})

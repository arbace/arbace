(ns arbace.c2j.main
  "Standalone S6: compiles the namespaces the program prepared (Compiler$AST/units, recorded
  with ARBACE_COMPILE set) to Java forms (arbace.c2j.emit), a tree j2g reads as one more input
  (bin/j2g --input DIR). The back end runs as the program's compiled code when the program holds
  it for the sources on ARBACE_PATH (compiled-back-end, SA164).

  (run OUT SOURCES): SOURCES the source paths to compile (arbace/walk.ae ...), or nil for every
  source recorded. Writes OUT/arbace.ae (the namespace of the classes' package, loading the
  others), one file per loader class (aot_SCRIPTBASE__init.ae) and per holder class
  (aot_HOLDER.ae), a large Java form continued in more (aot_HOLDER.1.ae ..., form-texts,
  SA220), and OUT/aot.edn (the sources compiled, those that failed and why)."
  (:require [arbace.string :as str]
            [arbace.set]
            [arbace.java.io :as io]
            [arbace.c2j.emit :as e])
  (:import [arbace.lang Compiler$AST]))

(defn units
  "The recorded units by source, in the order of their first unit: [[src [[unit um] ...]] ...]."
  []
  (let [us (or (Compiler$AST/units) (throw (ex-info "aot: no units recorded (ARBACE_COMPILE not set)" {})))
        order (distinct (map #(aget ^objects % 0) us))
        by (group-by #(aget ^objects % 0) us)]
    (for [src order]
      [src (mapv (fn [^objects a] [(vec (aget a 1)) (boolean (aget a 2))]) (get by src))])))

(defn- events [ss]
  (for [[u _] ss, ev (nth u 6)] (vec ev)))

(defn- source-classes
  "The names of the classes the events of a source's units make at run time (deftypes,
  interfaces, proxies)."
  [ss]
  (set (for [ev (events ss)
             :let [n (nth ev 1)]
             :when (string? n)]
         (e/destub n))))

(defn- interfaces
  "The interfaces gen-interface made in a source's units (events iface, imethod): name →
  record."
  [ss]
  (let [evs (events ss)
        ms (group-by #(.getName ^Class (nth % 2)) (filter #(= "imethod" (first %)) evs))]
    (into {} (for [ev evs
                   :when (= "iface" (first ev))
                   :let [n (nth ev 2)]]
               [n (e/interface-record n (seq (nth ev 3))
                                      (for [m (get ms n)] [(nth m 3) (seq (nth m 4)) (nth m 5)]))]))))

(defn- clean-meta
  "The metadata m of an emitted form for printing: the back end's line (:c2j/line) as :line;
  the reader's positions of the back end's own source dropped."
  [m]
  (let [l (:c2j/line m)
        m (dissoc m :line :column :c2j/line)
        m (if (and l (pos? l)) (assoc m :line l) m)]
    (not-empty m)))

(def ^:private ^:dynamic *link*
  "The resolution of a call site's link marker (arbace.c2j.emit's emit-link-site) into its code,
  once every class is made (run*), or nil."
  nil)

(defn- forms->lists
  "Form f with every seq a list, for printing; metadata as clean-meta leaves it, a list without
  a line of its own given the enclosing form's (line): the Java forms' analysis gives a form
  without one the reader's line in the printed file, and j2g lays the Go text out on the lines
  (J2G-SPEC §4.3), so lines that went back and forth would pad it. A link marker becomes its
  code (*link*)."
  ([f] (forms->lists f nil))
  ([f line]
   (cond
     (and (seq? f) (= 'c2j/link (first f))) (forms->lists (vary-meta (*link* f) merge (meta f)) line)
     (seq? f) (let [m (clean-meta (meta f))
                    l (or (:line m) line)]
                (with-meta (apply list (map #(forms->lists % l) f))
                  (if (and l (not (:line m))) (assoc m :line l) m)))
     (vector? f) (with-meta (mapv #(forms->lists % line) f) (clean-meta (meta f)))
     (symbol? f) (with-meta f (clean-meta (meta f)))
     :else f)))

(defn- write-form [^java.io.Writer w f]
  (binding [*out* w *print-meta* true *print-length* nil *print-level* nil *print-dup* false
            *print-namespace-maps* false]
    (pr (forms->lists f))
    (.write w "\n\n")))

(def ^:private file-chars
  "A top-level Java form printed longer than this many characters is written across several
  files (SA220): j2g reads a tree's files in parallel, one reader a file, at about 2 MB/s, so
  one large file (arbace.core's holder, 2.6 MB on one line) bounds the whole read.
  ARBACE_AOT_FILE_CHARS sets another bound (measurements: a large one writes each Java form
  whole, as before)."
  (or (some-> (System/getenv "ARBACE_AOT_FILE_CHARS") Long/parseLong) 262144))

(defn- form-texts
  "The texts of top-level Java form f as the tree holds it: [text], its printed form; or, past
  file-chars, its elements in about equal parts cut before a seq element (a field, a method, a
  member class), [main continuation...]: main the Java form with the first part and :c2j/parts
  n in its metadata, a continuation (c2j/continue NAME k element...) for part k (1 to n), which
  j2g appends to the Java form in that order (arbace.j2g.world/join-continued), restoring the
  form printed whole. Each part is printed as the whole form would print it, element by element
  (the lines are the forms' own, forms->lists's: a file's text starts on the same line)."
  [f]
  (binding [*print-meta* true *print-length* nil *print-level* nil *print-dup* false
            *print-namespace-maps* false]
    (let [g (forms->lists f)
          whole (pr-str g)]
      (if (<= (count whole) file-chars)
        [whole]
        (let [[hd nm & els] g
              texts (mapv pr-str els)
              total (reduce + 0 (map count texts))
              target (quot total (long (Math/ceil (/ total (double file-chars)))))
              ;; [[element text]...] per part, a part closed before a seq element once it holds
              ;; target characters
              parts (loop [es (map vector els texts) cur [] size 0 acc []]
                      (if-let [[[e t :as x] & more] (seq es)]
                        (if (and (seq cur) (seq? e) (>= size target))
                          (recur more [x] (count t) (conj acc cur))
                          (recur more (conj cur x) (+ size (count t)) acc))
                        (conj acc cur)))]
          (if (< (count parts) 2)
            [whole]
            (cons (pr-str (with-meta (apply list hd nm (map first (first parts)))
                            (assoc (meta g) :c2j/parts (dec (count parts)))))
                  (for [k (range 1 (count parts))]
                    (str "(c2j/continue " (symbol (str nm)) " " k " "
                         (str/join " " (map second (nth parts k))) ")")))))))))

(defn- file-name [^String cname]
  (str "aot_" (str/replace cname "." "_") ".ae"))

(defn- compile-all
  "Compiles the sources of us (each [src units]) whose names are in want: their results, and the
  classes made (name → record). A class a source's events make is a class of the program when
  that source compiles, else made at run time (named only by reflection); a source that fails
  makes its classes run-time ones, and the others are compiled again until none fails anew."
  [us want]
  (let [all-rt (apply arbace.set/union #{} (map (comp source-classes second) us))
        var-fns (e/var-fns (for [[_ ss] us, [u _] ss] u))
        proxies (set (for [[_ ss] us, ev (events ss) :when (= "proxy" (first ev))] (nth ev 1)))]
    (loop [failed #{}]
      (let [compiled (remove (fn [[src _]] (or (not (want src)) (failed src))) us)
            rt (atom (apply arbace.set/difference all-rt
                            (map (comp #(arbace.set/difference % proxies) source-classes second) compiled)))
            classes (atom (apply merge {} (map (comp interfaces second) compiled)))
            fn-names (java.util.IdentityHashMap.)
            pools (atom {})
            sites (atom [])
            results (doall
                      (for [[src ss] compiled]
                        (binding [e/*link* sites e/*var-fns* var-fns]
                          (let [before @classes]
                            (try
                              {:src src :loader (e/emit-source classes rt fn-names pools src ss)}
                              (catch Throwable t
                                (reset! classes before)
                                {:src src :error (str (.getMessage t)
                                                      (when-let [d (not-empty (ex-data t))] (str " " (pr-str d))))}))))))
            bad (set (map :src (filter :error results)))]
        (if (empty? bad)
          [(concat results (for [src failed] {:src src :error (get-in (meta failed) [:errors src])})) @classes @pools fn-names @sites]
          (recur (with-meta (into failed bad)
                   {:errors (merge (:errors (meta failed))
                                   (into {} (for [r results :when (:error r)] [(:src r) (:error r)])))})))))))

(def ^:private ^:dynamic *compiled*
  "True while run is the program's compiled one (compiled-back-end)."
  false)

(defn- path-source
  "The bytes of source path p (arbace/c2j/main.ae) as ARBACE_PATH finds it (a directory, or a
  store's entry store:PREFIX, as RT.pathResource looks), nil when it does not."
  ^bytes [^String p]
  (when-let [path (System/getenv "ARBACE_PATH")]
    (some (fn [^String e]
            (if (str/starts-with? e "store:")
              (jdk.internal.jrt.HostStore/resource (subs e 6) p)
              (let [f (io/file e p)]
                (when (.isFile f) (java.nio.file.Files/readAllBytes (.toPath f))))))
          (jdk.internal.jrt.HostStore/pathEntries path))))

(defn- forms
  "The top-level forms of source text (only the first n when n), read with *read-eval* false;
  nil when unreadable."
  ([b] (forms b nil))
  ([^bytes b n]
   (try
     (binding [*read-eval* false]
       (let [r (java.io.PushbackReader. (java.io.StringReader. (String. b "UTF-8")))
             eof (Object.)
             fs (take-while #(not (identical? % eof)) (repeatedly #(read r false eof)))]
         (doall (if n (take n fs) fs))))
     (catch Throwable _ nil))))

(defn- libs
  "The namespaces an ns form requires or uses (:require, :use; libspecs, prefix lists)."
  [form]
  (for [clause (drop 2 form)
        :when (and (seq? clause) (#{:require :use} (first clause)))
        spec (rest clause)
        lib (cond
              (symbol? spec) [spec]
              (vector? spec) [(first spec)]
              (seq? spec) (for [x (rest spec)]
                            (symbol (str (first spec) "." (if (sequential? x) (first x) x))))
              :else nil)]
    lib))

(defn- source-ns
  "The namespace of a source's top-level forms: an ns form's name, or an in-ns form's (a source
  of a namespace another source declares, as core_print is core's)."
  [fs]
  (let [f (first fs)]
    (when (seq? f)
      (case (first f)
        ns (second f)
        in-ns (let [n (second f)] (if (seq? n) (second n) n))
        nil))))

(defn- source-deps
  "The namespaces source forms fs (of namespace n) need: its ns form's libs and the sources its
  top-level load forms load (a path relative to n's directory, as load takes it), by path."
  [n fs]
  (let [dir (let [p (-> (str n) (str/replace "-" "_") (str/replace "." "/"))]
              (subs p 0 (max 0 (.lastIndexOf p "/"))))]
    (concat
      (when (and (seq? (first fs)) (= 'ns (ffirst fs))) (map (fn [l] [:ns l]) (libs (first fs))))
      (for [f fs
            :when (and (seq? f) (= 'load (first f)))
            p (rest f)
            :when (string? p)]
        [:src (str (if (str/starts-with? p "/") (subs p 1) (str dir "/" p)) ".ae")]))))

(defn- back-end-sources
  "The recorded sources (srcs, in the order they were loaded) of the namespaces the back end
  needs: the closure of arbace.c2j.main and arbace.core under :require, :use and top-level load,
  each [src text-on-ARBACE_PATH]; nil when one of them is not on ARBACE_PATH or not readable."
  [srcs]
  (let [texts (into {} (for [src srcs] [src (path-source src)]))
        ns-of (into {} (for [[src b] texts :when b :let [n (source-ns (forms b 1))] :when n] [src n]))
        fss (memoize (fn [src] (some-> (texts src) forms)))
        srcs-of (group-by ns-of (keys ns-of))
        closure (loop [todo ['arbace.c2j.main 'arbace.core] seen #{}]
                  (if-let [n (first todo)]
                    (if (seen n)
                      (recur (rest todo) seen)
                      (recur (concat (rest todo)
                                     (for [src (srcs-of n)
                                           [k d] (source-deps n (fss src))
                                           :let [m (if (= k :ns) d (ns-of d))]
                                           :when m]
                                       m))
                             (conj seen n)))
                    seen))
        mine (filter #(closure (ns-of %)) srcs)]
    (when (and (seq mine) (every? (comp seq fss) mine) (every? srcs-of closure))
      (for [src mine] [src (texts src)]))))

(defn- compiled-back-end
  "Whether the back end now runs as the program's compiled code (SA164). The namespaces the
  program prepares to compile them (ARBACE_NO_AOT) are evaluated, and the back end and the
  namespaces it calls with them (arbace.core, arbace.string ...), most of its time. When
  the program holds the compiled loaders of those namespaces' sources (S6) and the sources on
  ARBACE_PATH are the program's embedded ones, the loaders run in the order the sources were
  loaded, in the bindings Compiler$AOT/load makes, so that their vars' roots are the compiled
  fns: the units the back end reads are the analysis' either way, and the code is the same
  sources'. Else nothing changes."
  []
  (let [srcs (distinct (map #(aget ^objects % 0) (or (Compiler$AST/units) [])))
        bs (back-end-sources srcs)
        loader (fn [^String src]
                 (try (Class/forName (str (str/replace (subs src 0 (- (count src) 3)) "/" ".") "__init"))
                      (catch Throwable _ nil)))]
    (boolean
      (when (and (seq bs)
                 (every? (fn [[src ^bytes b]]
                           (and (loader src)
                                (when-let [ins (arbace.lang.RT/resourceAsStream nil src)]
                                  (java.util.Arrays/equals b (with-open [i ins] (.readAllBytes i))))))
                         bs))
        (doseq [[^String src] bs]
          (push-thread-bindings
            {arbace.lang.Compiler/LOADER (arbace.lang.RT/makeClassLoader)
             arbace.lang.Compiler/SOURCE_PATH src
             arbace.lang.Compiler/SOURCE (subs src (inc (.lastIndexOf src "/")))
             arbace.lang.Compiler/METHOD nil arbace.lang.Compiler/LOCAL_ENV nil
             arbace.lang.Compiler/LOOP_LOCALS nil arbace.lang.Compiler/CLASS_FORM_SIBLINGS nil
             arbace.lang.Compiler/NEXT_LOCAL_NUM (Integer/valueOf 0)
             #'*read-eval* true #'*ns* *ns* #'*unchecked-math* *unchecked-math*
             #'*warn-on-reflection* *warn-on-reflection* #'*data-readers* *data-readers*
             arbace.lang.Compiler/LINE_BEFORE (Integer/valueOf 1)
             arbace.lang.Compiler/COLUMN_BEFORE (Integer/valueOf 1)
             arbace.lang.Compiler/LINE_AFTER (Integer/valueOf 1)
             arbace.lang.Compiler/COLUMN_AFTER (Integer/valueOf 1)
             arbace.lang.Compiler$Image/RECORDER nil arbace.lang.Compiler$Image/PENDING nil
             arbace.lang.Compiler$Evaluator/EMBEDDED_LOAD true})
          (try
            (arbace.lang.Reflector/invokeStaticMethod (loader src) "load" (object-array 0))
            (finally (pop-thread-bindings))))
        true))))

(defn- java-forms-records
  "What the Java forms compiler compiled while the program prepared its namespaces
  (arbace.classes.native/compiled), in order."
  []
  (some-> (find-ns 'arbace.classes.native) (ns-resolve 'compiled) deref deref))

(defn- java-forms-classes
  "The classes the Java forms compiler made while the program prepared its namespaces (a
  deftype, a fn or a defclass using the Java forms), but those of the back end's classes
  (names): [{:ns :imports :forms :names} ...], a compilation made again (an analysis tried
  twice) kept once, its last."
  [names]
  (let [rs (java-forms-records)
        last-of (into {} (for [r rs] [(:names r) r]))]
    (vec (for [r (distinct (map (comp last-of :names) rs))
               :when (not-any? #(contains? names %) (:names r))]
           r))))

(defn- java-forms-file
  "The file of the Java forms compiler's classes r: its namespace, its imports, its forms."
  [r]
  (let [nm (first (:names r))]
    [(str "aot_jf_" (str/replace (str/replace nm "." "_") "$" "_") ".ae")
     (concat [(list 'in-ns (list 'quote (:ns r)))]
             (when (seq (:imports r)) [(cons 'import (map symbol (vals (:imports r))))])
             (for [f (:forms r)] (cons 'defclass f)))]))

(defn- class-ns
  "The namespace (a holder, a loader's source) or package (a deftype, an interface) whose Go
  package holds top-level class c, given the classes made (name → record): the package is aot_
  and its munged name (j2g's names/compiled-packages, SA142)."
  [classes ^String c]
  (cond
    (str/ends-with? c "__init") (subs c 0 (- (count c) 6))
    (contains? classes c) (if (= :holder (:kind (get classes c)))
                            c
                            (subs c 0 (max 0 (.lastIndexOf c "."))))
    :else c))

(defn- package-name
  "The Go package of the compiled classes of namespace or package n (class-ns)."
  [n]
  (str "aot_" (str/replace (str/replace (str n) "." "_") "-" "_")))

(defn- top-of [^String n] (let [i (.indexOf n "$")] (if (neg? i) n (subs n 0 i))))

(defn- form-refs
  "The names of the classes form f names (its symbols, as a class, a class's member or a
  constructor, their tags and param-tags, and the classes of array tags), into the
  java.util.HashSet acc; a link marker's root and arguments (the code of both its outcomes)."
  [f ^java.util.HashSet acc]
  (letfn [(sym! [s]
            (when (symbol? s)
              (let [nm (name s) ns (namespace s)]
                (.add acc (if (str/ends-with? nm ".") (subs nm 0 (dec (count nm))) nm))
                (when ns (.add acc ns))))
            (when (string? s)
              (doseq [[_ c] (re-seq #"L([^;\[]+);" s)] (.add acc c))))
          (walk [x]
            (when-let [m (meta x)]
              (sym! (:tag m))
              (run! sym! (:param-tags m)))
            (cond
              (and (seq? x) (= 'c2j/link (first x))) (let [{:keys [root args parts]} (second x)] (walk root) (run! walk args) (walk parts))
              (or (seq? x) (vector? x)) (run! walk x)
              (symbol? x) (sym! x)
              :else nil))]
    (walk f)))

(defn- reaches?
  "Does node a reach node b in graph g (node → set of nodes)?"
  [g a b]
  (loop [todo [a] seen #{}]
    (if-let [n (peek todo)]
      (cond
        (= n b) true
        (seen n) (recur (pop todo) seen)
        :else (recur (into (pop todo) (get g n)) (conj seen n)))
      false)))

(defn- link-plan
  "Which link sites (by :id) are linked (Futamura F5): a site whose var's root at the end of the
  prepare run was a fn whose code class was made (link-target), with a fixed arity of the
  call's argument count. A direct call names the code's Go type, so it imports the code's Go
  package, and the compiled namespaces' packages must not import each other in a cycle: a site
  in another package than its code's is linked only when the packages' graph, the classes the
  tree's top-level forms (tops: [package form]) name and the links taken so far, does not reach
  the caller's package from the code's; the sites are taken in the order emitted. The result:
  id → [cname variadic prims specs]."
  [sites classes fn-names tops pkg-of-class]
  (let [g (atom {})]
    (doseq [[p f] tops
            :let [acc (java.util.HashSet.)]]
      (form-refs f acc)
      (doseq [c acc
              :let [q (pkg-of-class c)]
              :when (and q (not= q p))]
        (swap! g update p (fnil conj #{}) q)))
    (into {}
          (for [{:keys [id key caller args]} sites
                :let [[cname rec] (e/link-target key classes fn-names)
                      p (pkg-of-class caller)
                      q (when cname (pkg-of-class cname))]
                :when (and cname p q
                           (some #{(symbol (str "arbace.lang.Compiler$AOTF" (count args)))} (:interfaces rec))
                           (or (= p q)
                               (contains? (get @g p) q)
                               (when-not (reaches? @g q p)
                                 (swap! g update p (fnil conj #{}) q)
                                 true)))]
            [id [cname (:variadic rec) (:prims rec) (:specs rec)]]))))

(defn- linker
  "The resolution of link markers (arbace.c2j.emit/link-form) by plan (link-plan): the guarded
  direct call, or the generic one. Counts the sites in links (:linked, :generic)."
  [plan links]
  (fn [m]
    (let [[cname variadic prims specs] (get plan (:id (second m)))
          d (second m)]
      (swap! links update (if cname :linked :generic) (fnil inc 0))
      (when (and cname (:psig d) (= (:psig d) (get prims (count (:args d)))))
        (swap! links update :prim (fnil inc 0)))
      (when (and cname (:smask d) (= (:smask d) (get specs (count (:args d)))))
        (swap! links update :spec (fnil inc 0)))
      (e/link-form m cname variadic prims specs))))

(defn- run*
  "Compiles sources (or all recorded) into directory out; returns the report."
  [out sources]
  (let [us (units)
        want (if sources (set sources) (set (map first us)))
        [results classes pools fn-names sites] (binding [e/*late-classes* (set (mapcat :names (java-forms-records)))]
                                                 (compile-all us want))
        links (atom {})
        ok (filter :loader results)
        dir (io/file out)
        tops (e/class-forms classes pools)
        jfs (java-forms-classes (set (keys classes)))
        loader-files (for [r ok] [(file-name (:name (:loader r))) (:src r) (:form (:loader r))])
        class-files (for [h tops] [(file-name (str (second h))) nil h])
        ;; the top-level classes of Java's unnamed package (a namespace of one segment's,
        ;; e/unnamed-package), imported by every file of the tree, so that a class in a package
        ;; names them (none in the shipped program's tree)
        unnamed (sort (for [[_ _ f] (concat loader-files class-files)
                            :let [nm (str (second f))]
                            :when (e/unnamed-package nm)]
                        (symbol nm)))
        ns-forms (cons '(in-ns 'arbace) (when (seq unnamed) [(cons 'import unnamed)]))
        ;; each compiled top-level class's Go package (packages.edn, below)
        top-pkgs (merge (into {} (for [t (concat (map (comp :name :loader) ok) (map #(str (second %)) tops))]
                                   [t (package-name (class-ns classes t))]))
                        (into {} (for [r jfs, n (:names r)] [n (package-name (:ns r))])))
        pkg-of-class (fn [^String c] (or (get top-pkgs c) (get top-pkgs (top-of c))))
        plan (link-plan sites classes fn-names
                        (concat (for [[_ _ f] loader-files] [(pkg-of-class (str (second f))) f])
                                (for [[_ _ f] class-files] [(pkg-of-class (str (second f))) f])
                                (for [r jfs] [(package-name (:ns r)) (second (java-forms-file r))]))
                        pkg-of-class)]
    (binding [*link* (linker plan links)]
      (.mkdirs (io/file dir "arbace"))
      (with-open [w (io/writer (io/file dir "arbace.ae"))]
        (write-form w '(ns arbace))
        (doseq [f (concat (map first loader-files) (map first class-files) (map (comp first java-forms-file) jfs))]
          (write-form w (list 'load (str "arbace/" (subs f 0 (- (count f) 3)))))))
      ;; the Java forms compiler's classes, in their namespaces, as it compiled them
      (doseq [r jfs
              :let [[f fs] (java-forms-file r)]]
        (with-open [w (io/writer (io/file dir "arbace" f))]
          (.write w (str ";; Compiled by arbace.classes.native (the Java forms compiler) in " (:ns r)
                         " while the program prepared it; kept by arbace.c2j. Regenerated by the build.\n\n"))
          (doseq [x fs] (write-form w x))))
      ;; the files printed in parallel (printing is most of the time here: half a minute
      ;; evaluated), on threads of their own (a future's pool would keep the program alive a
      ;; minute after the run), each Java form by one of them, with its continuation files
      ;; (form-texts: aot_NAME.1.ae ..., which arbace.ae does not list: they are its class's file)
      (let [files (vec (concat loader-files class-files))
            n (min 16 (max 1 (.availableProcessors (Runtime/getRuntime))))
            err (atom nil)
            threads (vec (for [k (range n)]
                           (Thread.
                             ^Runnable
                             (bound-fn []
                               (try
                                 (doseq [[f src form] (take-nth n (drop k files))
                                         :let [[main & more] (form-texts form)
                                               stem (subs f 0 (- (count f) 3))
                                               parts (count more)]
                                         [k' f' text] (cons [0 f main]
                                                            (map-indexed (fn [i t] [(inc i) (str stem "." (inc i) ".ae") t]) more))]
                                   (with-open [w (io/writer (io/file dir "arbace" f'))]
                                     (.write w (str ";; Compiled by arbace.c2j (standalone S6)"
                                                    (if src (str " from " src ": its loader") ": the classes of a namespace")
                                                    (when (pos? parts)
                                                      (if (zero? k')
                                                        (str ", continued in " stem ".1.ae to " stem "." parts ".ae")
                                                        (str ", continuing " f " (" k' " of " parts ")")))
                                                    ". Regenerated by the build.\n\n"))
                                     (doseq [f ns-forms] (write-form w f))
                                     (.write w ^String text)
                                     (.write w "\n\n")))
                                 (catch Throwable t (reset! err t)))))))]
        (run! #(.start ^Thread %) threads)
        (run! #(.join ^Thread %) threads)
        (when-let [t @err] (throw t))))
    ;; each top-level class's Go package (j2g's names/compiled-packages, SA142): its namespace's,
    ;; aot_ and the munged name (a holder: its own name; a loader: its source's; a deftype or
    ;; an interface: its package)
    (let [ns-of (partial class-ns classes)
          tops (concat (map (comp :name :loader) ok) (map #(str (second %)) tops))
          pkg package-name]
      (spit (io/file dir "packages.edn")
            (with-out-str
              (prn (into (sorted-map)
                         (concat
                           (for [t tops] [(str/replace t "." "/") (pkg (ns-of t))])
                           ;; the Java forms compiler's: their namespace's package
                           (for [r jfs, n (:names r)] [(str/replace n "." "/") (pkg (:ns r))])))))))
    (let [report (cond-> {:compiled (vec (sort (map :src ok)))
                          :failed (into (sorted-map) (for [r results :when (:error r)] [(:src r) (:error r)]))
                          :classes (count (remove #(= :holder (:kind %)) (vals classes)))
                          :links (into (sorted-map) @links)}
                   (seq jfs) (assoc :java-forms-classes (count (mapcat :names jfs))))]
      (spit (io/file dir "aot.edn") (with-out-str (prn report)))
      report)))

(defn run
  "Compiles sources (or all recorded) into directory out; returns the report. The back end's
  own code compiled when the program holds it (compiled-back-end)."
  [out sources]
  (if (and (not *compiled*) (compiled-back-end))
    (binding [*compiled* true] ((var-get #'run) out sources))
    (run* out sources)))

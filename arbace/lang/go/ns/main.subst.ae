;; The Go build's arbace/main.ae (doc/go/EVAL-NOTES.md, "Namespace variants"):
;; - the REPL makes no DynamicClassLoader for the thread (one loader, A2G-SPEC §10.3);
;; - a script or an -i file named ref:NAME is the source ref NAME's blob holds (arbace.box/load-ref;
;;   doc/go/BOX-NOTES.md, S3);
;; - an error report is printed with prn, not pprint (loading pprint takes about 8 s). Since
;;   java.nio.file's Files is in the Go build (JRT-NOTES.md, "Files"), the report goes to a
;;   temporary file as on the JVM.
["(.setContextClassLoader (Thread/currentThread) (arbace.lang.DynamicClassLoader. cl))"
 "(.setContextClassLoader (Thread/currentThread) cl)"

 "((requiring-resolve 'arbace.pprint/pprint) report)"
 "(prn report)"

 "(if (.startsWith path \"@\")
    (RT/loadResourceScript
     (.substring path (if (.startsWith path \"@/\") 2 1)))
    (Compiler/loadFile path)))"
 "(cond
    (.startsWith path \"ref:\")
    ((requiring-resolve 'arbace.box/load-ref) (.substring path 4))
    (.startsWith path \"@\")
    (RT/loadResourceScript
     (.substring path (if (.startsWith path \"@/\") 2 1)))
    :else
    (Compiler/loadFile path)))"]

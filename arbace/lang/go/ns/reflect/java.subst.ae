;; The Go build's arbace/reflect/java.ae (doc/go/EVAL-NOTES.md, "Namespace variants"; "The
;; suite's Java fixtures"): the names ASM's Type gives classes, descriptors and internal names
;; (getClassName), computed without ASM, which is outside the Go build's world (A2G-SPEC §10.1,
;; E2: its members throw): an array's component name followed by [], an object type's internal
;; name with . for /, a primitive descriptor's keyword; else Class.getName (the same for nested
;; classes and primitives). arbace.reflect's JavaReflector (type-reflect, reflect) works then;
;; its AsmReflector reads class files, which the Go build has not.
["  (typename
   [c]
   (typename (Type/getType c)))"
 "  (typename
   [c]
   (if (.isArray ^Class c)
     (str (typename (.getComponentType ^Class c)) \"[]\")
     (.getName ^Class c)))"

 "(defn- field-descriptor->class-symbol"
 "(defn- descriptor-class-name
  \"Type.getType(d).getClassName() of field descriptor d, without ASM.\"
  [^String d]
  (case (.charAt d 0)
    \\[ (str (descriptor-class-name (subs d 1)) \"[]\")
    \\L (str/replace (subs d 1 (dec (count d))) \"/\" \".\")
    ({\"Z\" \"boolean\" \"B\" \"byte\" \"C\" \"char\" \"S\" \"short\" \"I\" \"int\" \"J\" \"long\"
      \"F\" \"float\" \"D\" \"double\" \"V\" \"void\"} d)))

(defn- field-descriptor->class-symbol"

 "  {:pre [(string? d)]}
  (typesym (Type/getType d)))"
 "  {:pre [(string? d)]}
  (symbol (str/replace (descriptor-class-name d) \"[]\" \"<>\")))"

 "  {:pre [(string? d)]}
  (typesym (Type/getObjectType d)))"
 "  {:pre [(string? d)]}
  (symbol (str/replace (if (.startsWith ^String d \"[\") (descriptor-class-name d) (str/replace d \"/\" \".\"))
                       \"[]\" \"<>\")))"]

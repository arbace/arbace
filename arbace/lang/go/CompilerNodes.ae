  ;; CodeNodes: the nodes of these kinds made (CodeCompiler.compile), the domains' cases
  (j2g/add
    (defclass ^{:public true, :static true} CodeNodes
      (method ^{:public true, :static true} compile ^Compiler$Code [^Compiler$CodeCompiler cc ^Compiler$Expr e]
        (cond
          (or
            (instance? Compiler$NumberExpr e)
            (instance? Compiler$ConstantExpr e)
            (instance? Compiler$StringExpr e)
            (instance? Compiler$KeywordExpr e)
            (instance? Compiler$NilExpr e)
            (instance? Compiler$BooleanExpr e)
            (instance? Compiler$EmptyExpr e)
            (instance? Compiler$TheVarExpr e))
            (let [v (arbace.lang.Compiler$AST/literal e)
                  num (instance? Number v)
                  lv (if num (.longValue (cast Number v)) 0)
                  dv (if num (.doubleValue (cast Number v)) 0.0)]
              (if num (new Compiler$CodeConstNum v lv dv) (new Compiler$CodeConst v)))
          (instance? Compiler$IfExpr e)
            (let [x (cast Compiler$IfExpr e)
                  testExpr (.-testExpr x)
                  thenExpr (.-thenExpr x)
                  elseExpr (.-elseExpr x)
                  test (.compile cc testExpr)
                  thn (.compile cc thenExpr)
                  els (.compile cc elseExpr)
                  z (identical? (arbace.lang.Compiler$AST/primType testExpr) Boolean/TYPE)]
              (if z (new Compiler$CodeIfZ test thn els) (new Compiler$CodeIf test thn els)))
          (instance? Compiler$StaticMethodExpr e)
            (let [x (cast Compiler$StaticMethodExpr e)
                  args (.-args x)
                  method (.-method x)
                  line (.-line x)
                  op (if (nil? method) -1 (Compiler$CodeRun/op method))]
              (if (< op 0)
                nil
                (let [m method line line ps (.getParameterTypes method)]
                  (let [k (unchecked-divide-int op 10000)
                        o (unchecked-subtract-int op (unchecked-multiply-int k 10000))]
                    (cond
                      (== k 0) (new Compiler$CodeOp0 o line)
                      (== k 1)
                        (new
                          Compiler$CodeOp1
                          o
                          (.convert cc (aget ps 0) (cast Compiler$Expr (.nth args 0)))
                          line)
                      (== k 2)
                        (new
                          Compiler$CodeOp2
                          o
                          (.convert cc (aget ps 0) (cast Compiler$Expr (.nth args 0)))
                          (.convert cc (aget ps 1) (cast Compiler$Expr (.nth args 1)))
                          line)
                      (== k 3)
                        (new
                          Compiler$CodeOp3
                          o
                          (.convert cc (aget ps 0) (cast Compiler$Expr (.nth args 0)))
                          (.convert cc (aget ps 1) (cast Compiler$Expr (.nth args 1)))
                          (.convert cc (aget ps 2) (cast Compiler$Expr (.nth args 2)))
                          line)
                      :else nil)))))
          (instance? Compiler$InvokeExpr e)
            (let [x (cast Compiler$InvokeExpr e)
                  fexpr (.-fexpr x)
                  args (.-args x)
                  line (.-line x)
                  tailPosition (.-tailPosition x)
                  fx (.compile cc fexpr)
                  line line
                  clear (and tailPosition (not (.-canBeDirect (.-objx cc))))]
              (let [nc (.count args)]
                (cond
                  (== nc 0) (new Compiler$CodeInvoke0 fx line clear)
                  (== nc 1)
                    (new Compiler$CodeInvoke1 fx (.compile cc (cast Compiler$Expr (.nth args 0))) line clear)
                  (== nc 2)
                    (new
                      Compiler$CodeInvoke2
                      fx
                      (.compile cc (cast Compiler$Expr (.nth args 0)))
                      (.compile cc (cast Compiler$Expr (.nth args 1)))
                      line
                      clear)
                  (== nc 3)
                    (new
                      Compiler$CodeInvoke3
                      fx
                      (.compile cc (cast Compiler$Expr (.nth args 0)))
                      (.compile cc (cast Compiler$Expr (.nth args 1)))
                      (.compile cc (cast Compiler$Expr (.nth args 2)))
                      line
                      clear)
                  (== nc 4)
                    (new
                      Compiler$CodeInvoke4
                      fx
                      (.compile cc (cast Compiler$Expr (.nth args 0)))
                      (.compile cc (cast Compiler$Expr (.nth args 1)))
                      (.compile cc (cast Compiler$Expr (.nth args 2)))
                      (.compile cc (cast Compiler$Expr (.nth args 3)))
                      line
                      clear)
                  (== nc 5)
                    (new
                      Compiler$CodeInvoke5
                      fx
                      (.compile cc (cast Compiler$Expr (.nth args 0)))
                      (.compile cc (cast Compiler$Expr (.nth args 1)))
                      (.compile cc (cast Compiler$Expr (.nth args 2)))
                      (.compile cc (cast Compiler$Expr (.nth args 3)))
                      (.compile cc (cast Compiler$Expr (.nth args 4)))
                      line
                      clear)
                  (== nc 6)
                    (new
                      Compiler$CodeInvoke6
                      fx

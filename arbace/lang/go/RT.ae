;; Go-build variant of arbace.lang.RT (A2G-SPEC §4.6): read by a2g only, never by the JVM
;; build. RT's static initializer loads arbace/core through the compiler, which the Go build
;; has not (its evaluator is B1a step 5): the variant initializes RT's vars as the JVM's does
;; and leaves the loading of arbace/core to the program. What needs no arbace.core works
;; without it: vars, namespaces, the reader, RT.print's own printer (used until arbace.core
;; sets *print-initialized*), and *out*, *err*, *in* over System's streams.
(in-ns 'arbace.lang)

(a2g/variant RT
  ;; *out*, *err*, *in* are the JVM's (RT's own fields): an OutputStreamWriter over System.out,
  ;; a PrintWriter over one over System.err, a LineNumberingPushbackReader over an
  ;; InputStreamReader over System.in, all translated (A2G-NOTES.md, phase 2C)

  ;; Classes by name (A2G-SPEC §10.3): the closed world in jrt's registry, through the one
  ;; class loader the Go build has; no DynamicClassLoader (not translated: no classes are
  ;; defined at run time) and no thread context loader to consult (*use-context-classloader*
  ;; is kept, but every loader is the same)
  ;; Compiler/LOADER is bound to nil in the Go build (no DynamicClassLoader: makeClassLoader),
  ;; so the base loader is the application loader then (repl/source-fn's resources)
  (method ^:public ^:static baseLoader ^ClassLoader []
    (let [l (when (.isBound arbace.lang.Compiler/LOADER) (.deref arbace.lang.Compiler/LOADER))]
      (if (some? l)
          (cast ClassLoader l)
          (.getClassLoader arbace.lang.Compiler))))

  (static-initializer
    (let [arglistskw (Keyword/intern nil "arglists")
          namesym (Symbol/intern "name")]
      (.setTag OUT (Symbol/intern "java.io.Writer"))
      (.setTag CURRENT_NS (Symbol/intern "arbace.lang.Namespace"))
      (.setMeta AGENT
                (^[Object/1] RT/map
                  DOC_KEY
                  "The agent currently running an action on this thread, else nil"))
      (.setTag AGENT (Symbol/intern "arbace.lang.Agent"))
      (.setTag MATH_CONTEXT (Symbol/intern "java.math.MathContext"))
      (let [nv (Var/intern CLOJURE_NS NAMESPACE bootNamespace)]
        (.setMacro nv)
        (let [^:mutable ^Var v nil]
          (set! v (Var/intern CLOJURE_NS IN_NAMESPACE inNamespace))
          (.setMeta v
                    (^[Object/1] RT/map
                      DOC_KEY
                      "Sets *ns* to the namespace named by the symbol, creating it if needed."
                      arglistskw
                      (RT/list (RT/vector namesym))))
          (set! v
                (Var/intern CLOJURE_NS
                            LOAD_FILE
                            (anon AFn []
                              (method ^:public invoke [this arg1]
                                (try
                                  (arbace.lang.Compiler/loadFile (cast String arg1))
                                  (catch IOException e (throw (Util/sneakyThrow e))))))))
          (.setMeta v
                    (^[Object/1] RT/map
                      DOC_KEY
                      "Sequentially read and evaluate the set of forms contained in the file."
                      arglistskw
                      (RT/list (RT/vector namesym))))
          ;; arbace.core, as the JVM's RT loads it: from the program's embedded sources (B1a step
          ;; 5; doc/go/EVAL-NOTES.md). A program without them (a2g's check programs, the
          ;; evaluator's proof) runs without arbace.core, as before step 5
          (when (some? (RT/resourceAsStream nil "arbace/core.ae"))
            (try (RT/load "arbace/core") (catch Exception e (throw (Util/sneakyThrow e))))
            (set! CHECK_SPECS RT/instrumentMacros)))))))

;; B1a step 5 (doc/go/EVAL-NOTES.md): sources by name. The Go build has no class files and no
;; URLs: RT.load reads a namespace's .ae (else its .clj or .cljc) from the program's embedded
;; sources (jrt's host resources, A2G-SPEC §10.3), else from the directories of ARBACE_PATH
;; (separated by :), and evaluates it; RT's initialization loads arbace.core so. RT.doInit loads
;; arbace.core.server and starts the socket servers of the arbace.server.* properties as the
;; JVM's does (doc/go/JRT-NOTES.md, "Sockets")
(a2g/variant RT
  ;; the JVM's last resort for ARBACE_PATH (hand change 22): the Go build's pathResource reads
  ;; its entries itself
  (a2g/cut ^:static loadFromPath ^boolean [^String scriptbase])
  (a2g/cut ^:static inArbacePath ^boolean [^URL url])

  (method ^:public ^:static resourceAsStream ^InputStream [^ClassLoader loader ^String name]
    (let [b (RT/hostResource name)]
      (if (some? b)
          (java.io.ByteArrayInputStream. b)
          (RT/pathResource name))))

  (a2g/add
    (method ^:static ^:native hostResource ^byte/1 [^String name]))

  ;; ARBACE_PATH's entries (jdk.internal.jrt.HostStore/pathEntries): directories, and the store's
  ;; entries store:PREFIX, which find name in the store (doc/go/BOX-NOTES.md, S3): its stream is
  ;; not a ByteArrayInputStream, which load takes for an embedded source
  (a2g/add
    (method ^:static pathResource ^InputStream [^String name]
      (let [path (System/getenv "ARBACE_PATH")]
        (when (some? path)
          (let [entries (jdk.internal.jrt.HostStore/pathEntries path)]
            (loop [^int i 0]
              (when (< i (alength entries))
                (let [^String e (aget entries i)]
                  (if (.startsWith e "store:")
                      (let [b (jdk.internal.jrt.HostStore/resource (.substring e 6) name)]
                        (when (some? b)
                          (return (java.io.BufferedInputStream. (java.io.ByteArrayInputStream. b)))))
                      (let [ins (RT/openFile (java-str e "/" name))]
                        (when (some? ins) (return ins))))
                  (recur (unchecked-inc-int i)))))))
        nil)))

  ;; the id counter (gensym's, the compiler's fn names) of the calling thread when it has an id
  ;; space of its own (ID_SPACE: an AtomicInteger), else the runtime's: a2g analyzes classes in
  ;; parallel, each in a space that starts at the same value, so that the names it gives
  ;; temporaries depend on the class alone (standalone S6, SA143)
  (a2g/add
    (field ^:public ^:static ^:final ^ThreadLocal ID_SPACE (ThreadLocal.)))

  (method ^:public ^:static nextID ^int []
    (let [s (.get ID_SPACE)]
      (if (nil? s)
          (.getAndIncrement id)
          (.getAndIncrement (cast java.util.concurrent.atomic.AtomicInteger s)))))

  (a2g/add
    (method ^:static toolSource ^boolean [^String scriptbase]
      (or (.startsWith scriptbase "arbace/a2g/") (.startsWith scriptbase "arbace/g2a/")
          (.startsWith scriptbase "arbace/c2a/") (.startsWith scriptbase "arbace/j2a/")
          (.startsWith scriptbase "arbace/aot/"))))

  (a2g/add
    (method ^:static openFile ^InputStream [^String file]
      (try
        (java.io.FileInputStream. file)
        (catch FileNotFoundException e nil))))

  ;; the embedded sources loaded (by scriptbase): each is loaded once, as the JVM initializes the
  ;; class of an AOT-compiled namespace (its __init) once, however often RT.load is asked for it
  ;; (a require of arbace.core, which is not in *loaded-libs*, or a :reload): loading one again
  ;; would define its protocols' interfaces and its types anew, and the instances of the old ones
  ;; would no longer satisfy them (doc/go/BOX-NOTES.md, S2: the reducers' tests)
  ;; (made when first needed: RT's static initializer loads arbace.core through RT.load, which
  ;; may run before a static field's initializer; that first load is on one thread)
  (a2g/add
    (field ^:static ^java.util.concurrent.ConcurrentHashMap LOADED_EMBEDDED))

  (a2g/add
    (method ^:static loadedEmbedded ^java.util.concurrent.ConcurrentHashMap []
      (let [^:mutable m LOADED_EMBEDDED]
        (when (nil? m)
          (set! m (java.util.concurrent.ConcurrentHashMap.))
          (set! LOADED_EMBEDDED m))
        m)))

  (method ^:public ^:static load :throws [IOException ClassNotFoundException] ^void [^String scriptbase
                                                                                     ^boolean failIfNotFound]
    ;; a namespace's .ae, else its .clj, else its .cljc, as the JVM's (VENDOR-NOTES.md, hand
    ;; change 19)
    (let [classfile (java-str scriptbase LOADER_SUFFIX ".class")
          aefile (java-str scriptbase ".ae")
          cljfile (java-str scriptbase ".clj")
          cljcfile (java-str scriptbase ".cljc")
          ^:mutable scriptfile aefile
          ;; ARBACE_PATH_FIRST set: a source of ARBACE_PATH before the embedded one (the
          ;; compilation of a checkout's namespaces by a program built from the same runtime,
          ;; S6's one-pass build, SA144)
          ^:mutable ins (or (when (some? (System/getenv "ARBACE_PATH_FIRST"))
                              ;; as an embedded source (recorded when the program prepares)
                              (let [p (RT/pathResource aefile)]
                                (when (some? p)
                                  (let [b (.readAllBytes p)] (.close p) (java.io.ByteArrayInputStream. b)))))
                            (RT/resourceAsStream nil aefile))]
      (when (nil? ins)
        (set! scriptfile cljfile)
        (set! ins (RT/resourceAsStream nil cljfile)))
      (when (nil? ins)
        (set! scriptfile cljcfile)
        (set! ins (RT/resourceAsStream nil cljcfile)))
      ;; a tool's embedded source (a2g, g2a, c2a, j2a, arbace.aot: loaded from the checkout
      ;; before S6) that a source of ARBACE_PATH differs from: the latter, loaded from source,
      ;; so that a tool changed in the checkout runs as changed (S6: the program's compiled code
      ;; is the embedded source's); the runtime's namespaces stay the program's own
      (when (and (instance? java.io.ByteArrayInputStream ins) (RT/toolSource scriptbase)
                 (nil? (System/getenv "ARBACE_PATH_FIRST")))
        (let [other (RT/pathResource scriptfile)]
          (when (some? other)
            (let [b (.readAllBytes other)]
              (.close other)
              (if (java.util.Arrays/equals b (RT/hostResource scriptfile))
                nil
                (do (.close ins)
                    (set! ins (java.io.BufferedInputStream. (java.io.ByteArrayInputStream. b)))))))))
      (cond
        ;; a source compiled into the program (S6, Compiler$AOT): its loader, once, as an
        ;; embedded source
        (and (instance? java.io.ByteArrayInputStream ins) (some? (Compiler$AOT/loader scriptbase)))
          (do
            (when (some? ins) (.close ins))
            (when-not (.containsKey (RT/loadedEmbedded) scriptbase)
              (let [slash (.lastIndexOf scriptfile \/)
                    file (if (>= slash 0) (.substring scriptfile (unchecked-add-int slash 1)) scriptfile)]
                (Var/pushThreadBindings
                  (^[Object/1] RT/map Compiler$Evaluator/EMBEDDED_LOAD Boolean/TRUE))
                (try
                  (Compiler$AOT/load scriptbase scriptfile file)
                  (.put (RT/loadedEmbedded) scriptbase Boolean/TRUE)
                  (finally (Var/popThreadBindings))))))
        (and (instance? java.io.ByteArrayInputStream ins) (.containsKey (RT/loadedEmbedded) scriptbase))
          (.close ins)
        (some? ins)
          (let [slash (.lastIndexOf scriptfile \/)
                file (if (>= slash 0) (.substring scriptfile (unchecked-add-int slash 1)) scriptfile)]
            (let [t0 (System/nanoTime)]
              ;; the embedded sources are the namespaces the JVM ships AOT-compiled
              (Var/pushThreadBindings
                (^[Object/1] RT/map Compiler$Evaluator/EMBEDDED_LOAD
                                    (Boolean/valueOf (instance? java.io.ByteArrayInputStream ins))))
              (try
                ;; an embedded source: replayed from the program's image of prepared
                ;; namespaces when it holds it, recorded when the program prepares them
                ;; (Compiler$Image, doc/go/EXEC-NOTES.md)
                (if (instance? java.io.ByteArrayInputStream ins)
                    (do
                      (Compiler$Image/load (InputStreamReader. ins UTF8) scriptfile file)
                      (.put (RT/loadedEmbedded) scriptbase Boolean/TRUE))
                    (arbace.lang.Compiler/load (InputStreamReader. ins UTF8) scriptfile file))
                (finally
                  (Var/popThreadBindings)
                  (.close ins)
                  ;; ARBACE_LOAD_TIMES: each source's load time on stderr (EVAL-NOTES.md)
                  (when (some? (System/getenv "ARBACE_LOAD_TIMES"))
                    (.println (RT/errPrintWriter)
                              (java-str "load " scriptfile " "
                                        (quot (- (System/nanoTime) t0) 1000000) " ms")))))))
        failIfNotFound
          (throw
            (FileNotFoundException.
              (String/format
                "Could not locate %s, %s, %s or %s on classpath.%s"
                (new
                  Object/1
                  [classfile
                   aefile
                   cljfile
                   cljcfile
                   (if (.contains scriptbase "_")
                       " Please check that namespaces with dashes use underscores in the Clojure file name."
                       "")])))))))

  (method ^:private ^:static ^:synchronized doInit ^void []
    (when-not INIT
      (set! INIT true)
      (Var/pushThreadBindings
        (^[Object/1] RT/mapUniqueKeys CURRENT_NS
                                      (.deref CURRENT_NS)
                                      WARN_ON_REFLECTION
                                      (.deref WARN_ON_REFLECTION)
                                      RT/UNCHECKED_MATH
                                      (.deref RT/UNCHECKED_MATH)))
      (try
        (let [USER (Symbol/intern "user")
              CLOJURE (Symbol/intern "arbace.core")
              in_ns (RT/var "arbace.core" "in-ns")
              refer (RT/var "arbace.core" "refer")]
          (.invoke in_ns USER)
          (.invoke refer CLOJURE)
          ;; user.ae, else user.clj, as the JVM's
          (let [ins (RT/resourceAsStream nil "user.ae")]
            (if (some? ins)
                (do (.close ins) (RT/maybeLoadResourceScript "user.ae"))
                (RT/maybeLoadResourceScript "user.clj")))
          ;; as the JVM's: arbace.core.server, then the servers of the arbace.server.*
          ;; properties; System.getProperties() through the reflection tables, where a2g writes it
          (let [require (RT/var "arbace.core" "require")
                SERVER (Symbol/intern "arbace.core.server")]
            (.invoke require SERVER)
            (let [start_servers (RT/var "arbace.core.server" "start-servers")]
              (.invoke start_servers
                       (Reflector/invokeStaticMethod "java.lang.System" "getProperties" (new Object/1 0))))))
        (catch Exception e (throw (Util/sneakyThrow e)))
        (finally (Var/popThreadBindings))))))

;; B1a step 6 (doc/go/EXEC-NOTES.md): the boot ns macro (core.ae's first form) sets *ns* when it
;; expands, so a source of the image of prepared namespaces replays that: an event of the image
(a2g/variant RT
  (field ^:static ^:final ^IFn bootNamespace
    (anon AFn []
      (method ^:public invoke [this __form __env arg1]
        (let [nsname (cast Symbol arg1) ns (Namespace/findOrCreate nsname)]
          (Compiler$Image/event (new Object/1 ["ns" nil nsname]))
          (.set CURRENT_NS ns)
          ns)))))

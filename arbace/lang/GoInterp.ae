;; goi's classes in arbace.lang (doc/go/GOI-SPEC.md §1.3, §4.11, §5.5, §7.1, §7.2), milestone
;; GR1: GoInterp, the natives the table's namespaces, the calls and the values crossing use (goi's,
;; S32: j2g translates each native into a call of arbace/goi's GoInterp_<name>_native), and the
;; arbace.lang side of what crosses: GoFn (a Go function as an IFn), GoVar (a package variable),
;; GoType (a Go type as an IFn), GoValue (the class of every Go value in Arbace), GoPanic and
;; GoExit (a panic and os.Exit leaving Go).

(in-ns 'arbace.lang)

(import '(java.math BigInteger) '(java.util Map$Entry))

;; The class of Go values in Arbace (GOI-SPEC.md §5.5): every non-nil value that is no Java
;; object; jrt's Object protocol gives them goi's toString (their %#v), equals and hashCode. No
;; instance of the class exists.
(defclass ^:public ^:final GoValue
  (constructor ^:private [this]))

;; A Go panic that left Go into Arbace (§10.4): the message is the panic's text as gc prints it
;; after "panic: "; ex-data holds :go/value (the value, converted by its dynamic type) and
;; :go/type.
(defclass ^:public GoPanic
  :extends ExceptionInfo
  (constructor ^:public [this ^String s ^IPersistentMap data] (super. s data)))

;; os.Exit called from Go at the REPL (§2.7, S12): ex-data holds :go/status.
(defclass ^:public GoExit
  :extends ExceptionInfo
  (constructor ^:public [this ^String s ^IPersistentMap data] (super. s data))
  (method ^:public status ^int [this]
    (.intValue (cast Number (.valAt (.getData this) (Keyword/intern "go" "status"))))))

;; A Go function as an Arbace fn (§2.1, §7.2): a member of a table's package, a method
;; expression (its receiver first), or a Go func value that reached Arbace (S35). Its arguments
;; and results are converted by the function's parameter and result types (§5.6); several
;; results are a vector.
(defclass ^:public GoFn
  :extends AFn
  (field ^:public ^:final handle)
  (field ^:public ^:final ^String name)
  (constructor ^:public [this h ^String n] (set! handle h) (set! name n))
  (method ^:public toString ^String [this] (java-str "#go/fn " name))

  (method ^:public invoke [this] (GoInterp/call handle (new Object/1 0)))

  (method ^:public invoke [this a1] (GoInterp/call handle (new Object/1 [a1])))

  (method ^:public invoke [this a1 a2] (GoInterp/call handle (new Object/1 [a1 a2])))

  (method ^:public invoke [this a1 a2 a3] (GoInterp/call handle (new Object/1 [a1 a2 a3])))

  (method ^:public invoke [this a1 a2 a3 a4] (GoInterp/call handle (new Object/1 [a1 a2 a3 a4])))

  (method ^:public invoke [this a1 a2 a3 a4 a5] (GoInterp/call handle (new Object/1 [a1 a2 a3 a4 a5])))

  (method ^:public invoke [this a1 a2 a3 a4 a5 a6] (GoInterp/call handle (new Object/1 [a1 a2 a3 a4 a5 a6])))

  (method ^:public invoke [this a1 a2 a3 a4 a5 a6 a7] (GoInterp/call handle (new Object/1 [a1 a2 a3 a4 a5 a6 a7])))

  (method ^:public invoke [this a1 a2 a3 a4 a5 a6 a7 a8] (GoInterp/call handle (new Object/1 [a1 a2 a3 a4 a5 a6 a7 a8])))

  (method ^:public invoke [this a1 a2 a3 a4 a5 a6 a7 a8 a9] (GoInterp/call handle (new Object/1 [a1 a2 a3 a4 a5 a6 a7 a8 a9])))

  (method ^:public invoke [this a1 a2 a3 a4 a5 a6 a7 a8 a9 a10] (GoInterp/call handle (new Object/1 [a1 a2 a3 a4 a5 a6 a7 a8 a9 a10])))

  (method ^:public invoke [this a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11] (GoInterp/call handle (new Object/1 [a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11])))

  (method ^:public invoke [this a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12] (GoInterp/call handle (new Object/1 [a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12])))

  (method ^:public invoke [this a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13] (GoInterp/call handle (new Object/1 [a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13])))

  (method ^:public invoke [this a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14] (GoInterp/call handle (new Object/1 [a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14])))

  (method ^:public invoke [this a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15] (GoInterp/call handle (new Object/1 [a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15])))

  (method ^:public invoke [this a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16] (GoInterp/call handle (new Object/1 [a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16])))

  (method ^:public invoke [this a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17] (GoInterp/call handle (new Object/1 [a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17])))

  (method ^:public invoke [this a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17 a18] (GoInterp/call handle (new Object/1 [a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17 a18])))

  (method ^:public invoke [this a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17 a18 a19] (GoInterp/call handle (new Object/1 [a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17 a18 a19])))

  (method ^:public invoke [this a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17 a18 a19 a20] (GoInterp/call handle (new Object/1 [a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17 a18 a19 a20])))

  (method ^:public applyTo [this ^ISeq args] (GoInterp/call handle (RT/seqToArray args))))

;; A package variable of Go (§2.1): deref reads it, converted to Arbace by its type.
(defclass ^:public GoVar
  :implements [IDeref]
  (field ^:public ^:final cell)
  (field ^:public ^:final ^String name)
  (constructor ^:public [this c ^String n] (set! cell c) (set! name n))
  (method ^:public deref [this] (GoInterp/load cell))
  (method ^:public toString ^String [this] (java-str "#go/var " name)))

;; A Go type (§2.1, §7.1, S46): (T) is its zero value, (T v) Go's conversion T(v) of v (a map of
;; keywords for a struct type: the struct of those fields).
(defclass ^:public GoType
  :extends AFn
  (field ^:public ^:final handle)
  (constructor ^:public [this h] (set! handle h))
  (method ^:public getName ^String [this] (GoInterp/typeName handle))
  (method ^:public toString ^String [this] (java-str "#go/type " (GoInterp/typeName handle)))
  (method ^:public equals ^boolean [this o]
    (and (instance? GoType o) (Util/equals handle (.-handle (cast GoType o)))))
  (method ^:public hashCode ^int [this] (Util/hash handle))
  (method ^:public invoke [this] (GoInterp/zero handle))
  (method ^:public invoke [this x] (GoInterp/convert handle x))
  (method ^:public applyTo [this ^ISeq args]
    (if (nil? args)
        (.invoke this)
        (if (nil? (.next args))
            (.invoke this (.first args))
            (.throwArity this (RT/count args))))))

;; goi's natives and their Arbace side (§4.11). GR1: the namespaces of the table's packages
;; (loadTable, members), Arbace calling compiled Go (call), variables (load, store), types
;; (typeOf, convert, zero, newValue) and the values that cross (spread, str, digest).
(defclass ^:public ^:final GoInterp
  (constructor ^:private [this])

  (field ^:private ^:static ^:final ^boolean READY (GoInterp/init0 GoValue))

  (method ^:private ^:static ^:native init0 ^boolean [^Class goValue])
  (method ^:private ^:static ^:native packagePath0 ^String [^String base])
  (method ^:private ^:static ^:native paths0 ^Object/1 [])
  (method ^:private ^:static ^:native members0 ^Object/1 [^String path])
  (method ^:private ^:static ^:native call0 ^Object/1 [c ^Object/1 args])
  (method ^:private ^:static ^:native load0 [cell])
  (method ^:private ^:static ^:native store0 ^void [cell v])
  (method ^:private ^:static ^:native typeOf0 [v])
  (method ^:private ^:static ^:native typeName0 ^String [t])
  (method ^:private ^:static ^:native convert0 [t v])
  (method ^:private ^:static ^:native zero0 [t])
  (method ^:private ^:static ^:native new0 [t])
  (method ^:private ^:static ^:native structArg0 [^Object/1 names ^Object/1 values orig])
  (method ^:private ^:static ^:native bigArg0 [^String s orig])
  (method ^:private ^:static ^:native spread0 [v])
  (method ^:private ^:static ^:native marker0 ^int [x])
  (method ^:private ^:static ^:native bigText0 ^String [x])
  (method ^:private ^:static ^:native funcCallable0 [x ^String name])
  (method ^:private ^:static ^:native funcValue0 [c])
  (method ^:private ^:static ^:native goString0 ^String [v])
  (method ^:private ^:static ^:native str0 ^String [v])
  (method ^:private ^:static ^:native digest0 ^String [])
  (method ^:private ^:static ^:native complex0 [^double re ^double im])

  ;; RT.load's hook (doc/VENDOR-NOTES.md): the namespace of a listed package (go/strings) is
  ;; made from the table (§2.1, §2.3: the table first), by arbace.go/table-ns!
  (method ^:public ^:static loadTable ^boolean [^String scriptbase]
    (let [path (GoInterp/packagePath0 scriptbase)]
      (when (nil? path)
        (return false))
      (.invoke (RT/var "arbace.core" "require") (Symbol/intern "arbace.go"))
      (.invoke (RT/var "arbace.go" "table-ns!") path)
      true))

  (method ^:public ^:static paths ^Object/1 [] (GoInterp/paths0))

  (method ^:public ^:static members ^Object/1 [^String path] (GoInterp/members0 path))

  (method ^:private ^:static keywordMap ^boolean [^IPersistentMap m]
    (loop [s (.seq m)]
      (if (nil? s)
          true
          (if (instance? Keyword (.getKey (cast Map$Entry (.first s))))
              (recur (.next s))
              false))))

  ;; an Arbace value as goi takes it: a GoFn as its Go func (S35), a BigInt or BigInteger as its
  ;; decimal text, a map of keywords (for a struct) as its names and values, each the same way
  (method ^:public ^:static toGo [x]
    (cond
      (instance? GoFn x) (GoInterp/funcValue0 (.-handle (cast GoFn x)))
      (or (instance? BigInt x) (instance? BigInteger x)) (GoInterp/bigArg0 (.toString x) x)
      (and (instance? IPersistentMap x) (GoInterp/keywordMap (cast IPersistentMap x)))
        (let [m (cast IPersistentMap x)
              n (.count m)
              names (new Object/1 n)
              values (new Object/1 n)]
          (loop [^int i 0 s (.seq m)]
            (when (some? s)
              (let [e (cast Map$Entry (.first s))]
                (aset names i (.getName (cast Keyword (.getKey e))))
                (aset values i (GoInterp/toGo (.getValue e)))
                (recur (unchecked-inc-int i) (.next s)))))
          (GoInterp/structArg0 names values x))
      :else x))

  ;; a value from goi as Arbace takes it: a BigInt of a big uint64, a GoFn of a Go func
  (method ^:public ^:static fromGo [x]
    (let [m (GoInterp/marker0 x)]
      (cond
        (== m 1) (BigInt/fromBigInteger (BigInteger. (GoInterp/bigText0 x)))
        (== m 2) (GoFn. (GoInterp/funcCallable0 x "go func") "go func")
        :else x)))

  (method ^:public ^:static call [c ^Object/1 args]
    (let [n (alength args)
          as (new Object/1 n)]
      (loop [^int i 0]
        (when (< i n)
          (aset as i (GoInterp/toGo (aget args i)))
          (recur (unchecked-inc-int i))))
      (let [r (GoInterp/call0 c as)
            status (.intValue (cast Number (aget r 0)))]
        (cond
          (== status 1)
            (throw (GoPanic. (cast String (aget r 1))
                             (^[Object/1] RT/map (new Object/1 [(Keyword/intern "go" "value") (GoInterp/fromGo (aget r 3))
                                                                (Keyword/intern "go" "type") (aget r 2)]))))
          (== status 2)
            (throw (GoExit. (java-str "os.Exit(" (aget r 1) ")")
                            (^[Object/1] RT/map (new Object/1 [(Keyword/intern "go" "status") (aget r 1)]))))
          :else
            (let [nr (unchecked-dec-int (alength r))]
              (cond
                (== nr 0) nil
                (== nr 1) (GoInterp/fromGo (aget r 1))
                :else
                  (let [out (new Object/1 nr)]
                    (loop [^int i 0]
                      (when (< i nr)
                        (aset out i (GoInterp/fromGo (aget r (unchecked-inc-int i))))
                        (recur (unchecked-inc-int i))))
                    (LazilyPersistentVector/createOwning out))))))))

  (method ^:public ^:static load [cell] (GoInterp/fromGo (GoInterp/load0 cell)))

  (method ^:public ^:static store ^void [cell v] (GoInterp/store0 cell (GoInterp/toGo v)))

  (method ^:public ^:static typeOf [v]
    (let [t (GoInterp/typeOf0 v)] (if (nil? t) nil (GoType. t))))

  (method ^:public ^:static typeName ^String [t] (GoInterp/typeName0 t))

  (method ^:public ^:static convert [t v] (GoInterp/fromGo (GoInterp/convert0 t (GoInterp/toGo v))))

  (method ^:public ^:static zero [t] (GoInterp/fromGo (GoInterp/zero0 t)))

  (method ^:public ^:static newValue [t] (GoInterp/new0 t))

  (method ^:public ^:static spread [v] (GoInterp/spread0 v))

  (method ^:public ^:static goString ^String [v] (GoInterp/goString0 v))

  (method ^:public ^:static str ^String [v] (GoInterp/str0 (GoInterp/toGo v)))

  (method ^:public ^:static digest ^String [] (GoInterp/digest0))

  (method ^:public ^:static complex [^double re ^double im] (GoInterp/complex0 re im)))

;; goi's classes in arbace.lang (doc/go/GOI-SPEC.md §1.3, §4.11, §5.5, §7.1, §7.2), milestone
;; GR1: GoInterp, the natives the table's namespaces, the calls and the values crossing use (goi's,
;; S32: j2g translates each native into a call of arbace/goi's GoInterp_<name>_native), and the
;; arbace.lang side of what crosses: GoFn (a Go function as an IFn), GoVar (a package variable),
;; GoType (a Go type as an IFn), GoValue (the class of every Go value in Arbace), GoPanic and
;; GoExit (a panic and os.Exit leaving Go). GR3: GoInterp's op, the factories of the
;; interpreter's nodes, descriptors and functions by name; an interpreted function's GoFn is
;; GR1's over its Callable. GR5: GoBridge, what goi asks of Arbace (Arbace fns called as Go
;; funcs, §7.5; the package arbace, §7.3); a GoPanic's trace, cause and Go value (§10.4, §10.6);
;; Go values' methods and fields from Arbace (GS10) and their collection protocols (GS7).

(in-ns 'arbace.lang)

(import '(java.math BigInteger BigDecimal) '(java.util Map$Entry))

;; The class of Go values in Arbace (GOI-SPEC.md §5.5): every non-nil value that is no Java
;; object; jrt's Object protocol gives them goi's toString (their %#v), equals and hashCode. No
;; instance of the class exists.
(defclass ^:public ^:final GoValue
  (constructor ^:private [this]))

;; A Go panic that left Go into Arbace (§10.4): the message is the panic's text as gc prints it
;; after "panic: "; ex-data holds :go/value (the value, converted by its dynamic type), :go/type
;; and :go/trace (the interpreted frames, innermost first: [go.demo/Div "REPL" 8]); its stack trace
;; begins with those frames; a run-time error's cause is the Java exception jrt maps it to (GS11);
;; goValue is the value itself, which Go code given the GoPanic again panics with (S50).
(defclass ^:public GoPanic
  :extends ExceptionInfo
  (field ^:public goValue)
  (constructor ^:public [this ^String s ^IPersistentMap data] (super. s data))
  (constructor ^:public [this ^String s ^IPersistentMap data ^Throwable cause] (super. s data cause)))

;; os.Exit called from Go at the REPL (§2.7, S12): ex-data holds :go/status.
(defclass ^:public GoExit
  :extends ExceptionInfo
  (constructor ^:public [this ^String s ^IPersistentMap data] (super. s data))
  (method ^:public status ^int [this]
    (.intValue (cast Number (.valAt (.getData this) (Keyword/intern "go" "status"))))))

;; A Go function as an Arbace fn (§2.1, §7.2): a member of a table's package, a method
;; expression (its receiver first), or a Go func value that reached Arbace (S35). Its arguments
;; and results are converted by the function's parameter and result types (§5.6); several
;; results are a vector.
(defclass ^:public GoFn
  :extends AFn
  (field ^:public ^:final handle)
  (field ^:public ^:final ^String name)
  (constructor ^:public [this h ^String n] (set! handle h) (set! name n))
  (method ^:public toString ^String [this] (java-str "#go/fn " name))

  (method ^:public invoke [this] (GoInterp/call handle (new Object/1 0)))

  (method ^:public invoke [this a1] (GoInterp/call handle (new Object/1 [a1])))

  (method ^:public invoke [this a1 a2] (GoInterp/call handle (new Object/1 [a1 a2])))

  (method ^:public invoke [this a1 a2 a3] (GoInterp/call handle (new Object/1 [a1 a2 a3])))

  (method ^:public invoke [this a1 a2 a3 a4] (GoInterp/call handle (new Object/1 [a1 a2 a3 a4])))

  (method ^:public invoke [this a1 a2 a3 a4 a5] (GoInterp/call handle (new Object/1 [a1 a2 a3 a4 a5])))

  (method ^:public invoke [this a1 a2 a3 a4 a5 a6] (GoInterp/call handle (new Object/1 [a1 a2 a3 a4 a5 a6])))

  (method ^:public invoke [this a1 a2 a3 a4 a5 a6 a7] (GoInterp/call handle (new Object/1 [a1 a2 a3 a4 a5 a6 a7])))

  (method ^:public invoke [this a1 a2 a3 a4 a5 a6 a7 a8] (GoInterp/call handle (new Object/1 [a1 a2 a3 a4 a5 a6 a7 a8])))

  (method ^:public invoke [this a1 a2 a3 a4 a5 a6 a7 a8 a9] (GoInterp/call handle (new Object/1 [a1 a2 a3 a4 a5 a6 a7 a8 a9])))

  (method ^:public invoke [this a1 a2 a3 a4 a5 a6 a7 a8 a9 a10] (GoInterp/call handle (new Object/1 [a1 a2 a3 a4 a5 a6 a7 a8 a9 a10])))

  (method ^:public invoke [this a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11] (GoInterp/call handle (new Object/1 [a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11])))

  (method ^:public invoke [this a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12] (GoInterp/call handle (new Object/1 [a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12])))

  (method ^:public invoke [this a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13] (GoInterp/call handle (new Object/1 [a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13])))

  (method ^:public invoke [this a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14] (GoInterp/call handle (new Object/1 [a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14])))

  (method ^:public invoke [this a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15] (GoInterp/call handle (new Object/1 [a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15])))

  (method ^:public invoke [this a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16] (GoInterp/call handle (new Object/1 [a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16])))

  (method ^:public invoke [this a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17] (GoInterp/call handle (new Object/1 [a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17])))

  (method ^:public invoke [this a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17 a18] (GoInterp/call handle (new Object/1 [a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17 a18])))

  (method ^:public invoke [this a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17 a18 a19] (GoInterp/call handle (new Object/1 [a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17 a18 a19])))

  (method ^:public invoke [this a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17 a18 a19 a20] (GoInterp/call handle (new Object/1 [a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17 a18 a19 a20])))

  (method ^:public applyTo [this ^ISeq args] (GoInterp/call handle (RT/seqToArray args))))

;; A package variable of Go (§2.1): deref reads it, converted to Arbace by its type.
(defclass ^:public GoVar
  :implements [IDeref]
  (field ^:public ^:final cell)
  (field ^:public ^:final ^String name)
  (constructor ^:public [this c ^String n] (set! cell c) (set! name n))
  (method ^:public deref [this] (GoInterp/load cell))
  (method ^:public toString ^String [this] (java-str "#go/var " name)))

;; A Go type (§2.1, §7.1, S46): (T) is its zero value, (T v) Go's conversion T(v) of v (a map of
;; keywords for a struct type: the struct of those fields).
(defclass ^:public GoType
  :extends AFn
  (field ^:public ^:final handle)
  (constructor ^:public [this h] (set! handle h))
  (method ^:public getName ^String [this] (GoInterp/typeName handle))
  (method ^:public toString ^String [this] (java-str "#go/type " (GoInterp/typeName handle)))
  (method ^:public equals ^boolean [this o]
    (and (instance? GoType o) (Util/equals handle (.-handle (cast GoType o)))))
  (method ^:public hashCode ^int [this] (Util/hash handle))
  (method ^:public invoke [this] (GoInterp/zero handle))
  (method ^:public invoke [this x] (GoInterp/convert handle x))
  (method ^:public applyTo [this ^ISeq args]
    (if (nil? args)
        (.invoke this)
        (if (nil? (.next args))
            (.invoke this (.first args))
            (.throwArity this (RT/count args))))))

;; A generic Go function (or a generic type's method, its receiver first) as an Arbace fn
;; (GOI-SPEC.md "As built: GR9d", GC72-GC74): a call keys its arguments by their types for
;; inference (keyOf: a Go value its descriptor, an Arbace scalar its untyped kind, a fn or a
;; collection none), finds the instance's GoFn for the key (the last key's inline, else the
;; map), else asks resolve (arbace.go.generic's: inference, the instance's cell, its GoFn) and
;; keeps it; data is arbace.go.generic's description of the function.
(defclass ^:public ^:final GoGenericFn
  :extends AFn
  (field ^:public ^:final ^String name)
  (field ^:public ^:final data)
  (field ^:public ^:final ^IFn resolve)
  (field ^:private ^:final ^java.util.concurrent.ConcurrentHashMap cache)
  ;; the last key and its instance: [key GoFn]
  (field ^:private ^:volatile last)
  (constructor ^:public [this ^String n d ^IFn r]
    (set! name n) (set! data d) (set! resolve r) (set! cache (java.util.concurrent.ConcurrentHashMap.)))
  (method ^:public toString ^String [this] (java-str "#go/generic " name))

  (field ^:private ^:static ^:final K_INT (Keyword/intern "untyped-int"))
  (field ^:private ^:static ^:final K_FLOAT (Keyword/intern "untyped-float"))
  (field ^:private ^:static ^:final K_RUNE (Keyword/intern "untyped-rune"))
  (field ^:private ^:static ^:final K_BOOL (Keyword/intern "untyped-bool"))
  (field ^:private ^:static ^:final K_STRING (Keyword/intern "untyped-string"))
  (field ^:private ^:static ^:final K_NIL (Keyword/intern "untyped-nil"))
  (field ^:private ^:static ^:final K_FN (Keyword/intern "fn"))
  (field ^:private ^:static ^:final K_COLL (Keyword/intern "coll"))
  (field ^:private ^:static ^:final K_ANY (Keyword/intern "any"))

  ;; an argument's element of the key (§4.3 of doc/go/GR9-SURVEY.md, GC72 (a))
  (method ^:public ^:static keyOf [x]
    (cond
      (nil? x) GoGenericFn/K_NIL
      (instance? GoValue x) (let [d (GoInterp/valueType x)] (if (nil? d) GoGenericFn/K_ANY d))
      (or (instance? Long x) (instance? Integer x) (instance? Short x) (instance? Byte x)
          (instance? BigInt x) (instance? BigInteger x)) GoGenericFn/K_INT
      (or (instance? Double x) (instance? Float x) (instance? Ratio x) (instance? BigDecimal x)) GoGenericFn/K_FLOAT
      (instance? Character x) GoGenericFn/K_RUNE
      (instance? Boolean x) GoGenericFn/K_BOOL
      (instance? String x) GoGenericFn/K_STRING
      (instance? IPersistentCollection x) GoGenericFn/K_COLL
      (instance? Keyword x) GoGenericFn/K_ANY
      (instance? Symbol x) GoGenericFn/K_ANY
      (instance? IFn x) GoGenericFn/K_FN
      :else GoGenericFn/K_ANY))

  (method ^:private ^:static sameKey ^boolean [^Object/1 a ^Object/1 b]
    (if (== (alength a) (alength b))
        (loop [^int i 0]
          (if (< i (alength a))
              (if (identical? (aget a i) (aget b i)) (recur (unchecked-inc-int i)) false)
              true))
        false))

  ;; the instance's GoFn for args (GC74 (a))
  (method ^:public instanceFor [this ^Object/1 args]
    (let [n (alength args)
          k (new Object/1 n)]
      (loop [^int i 0]
        (when (< i n)
          (aset k i (GoGenericFn/keyOf (aget args i)))
          (recur (unchecked-inc-int i))))
      (let [l (cast Object/1 last)]
        (if (and (some? l) (GoGenericFn/sameKey (cast Object/1 (aget l 0)) k))
            (aget l 1)
            (let [kv (LazilyPersistentVector/createOwning k)
                  f0 (.get cache kv)
                  f (if (some? f0)
                        f0
                        (let [r (.invoke resolve this k args)]
                          (.put cache kv r)
                          r))]
              (set! last (new Object/1 [k f]))
              f)))))

  (method ^:public callWith [this ^Object/1 args]
    (let [f (.instanceFor this args)]
      (if (instance? GoFn f)
          (GoInterp/call (.-handle (cast GoFn f)) args)
          (.applyTo (cast IFn f) (RT/seq args)))))

  ;; the number of instances made (tests, measurements)
  (method ^:public instanceCount ^int [this] (.size cache))

  (method ^:public invoke [this] (.callWith this (new Object/1 0)))
  (method ^:public invoke [this a1] (.callWith this (new Object/1 [a1])))
  (method ^:public invoke [this a1 a2] (.callWith this (new Object/1 [a1 a2])))
  (method ^:public invoke [this a1 a2 a3] (.callWith this (new Object/1 [a1 a2 a3])))
  (method ^:public invoke [this a1 a2 a3 a4] (.callWith this (new Object/1 [a1 a2 a3 a4])))
  (method ^:public invoke [this a1 a2 a3 a4 a5] (.callWith this (new Object/1 [a1 a2 a3 a4 a5])))
  (method ^:public invoke [this a1 a2 a3 a4 a5 a6] (.callWith this (new Object/1 [a1 a2 a3 a4 a5 a6])))
  (method ^:public invoke [this a1 a2 a3 a4 a5 a6 a7] (.callWith this (new Object/1 [a1 a2 a3 a4 a5 a6 a7])))
  (method ^:public invoke [this a1 a2 a3 a4 a5 a6 a7 a8] (.callWith this (new Object/1 [a1 a2 a3 a4 a5 a6 a7 a8])))
  (method ^:public invoke [this a1 a2 a3 a4 a5 a6 a7 a8 a9] (.callWith this (new Object/1 [a1 a2 a3 a4 a5 a6 a7 a8 a9])))
  (method ^:public invoke [this a1 a2 a3 a4 a5 a6 a7 a8 a9 a10] (.callWith this (new Object/1 [a1 a2 a3 a4 a5 a6 a7 a8 a9 a10])))
  (method ^:public invoke [this a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11] (.callWith this (new Object/1 [a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11])))
  (method ^:public invoke [this a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12] (.callWith this (new Object/1 [a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12])))
  (method ^:public invoke [this a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13] (.callWith this (new Object/1 [a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13])))
  (method ^:public invoke [this a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14] (.callWith this (new Object/1 [a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14])))
  (method ^:public invoke [this a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15] (.callWith this (new Object/1 [a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15])))
  (method ^:public invoke [this a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16] (.callWith this (new Object/1 [a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16])))
  (method ^:public invoke [this a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17] (.callWith this (new Object/1 [a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17])))
  (method ^:public invoke [this a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17 a18] (.callWith this (new Object/1 [a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17 a18])))
  (method ^:public invoke [this a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17 a18 a19] (.callWith this (new Object/1 [a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17 a18 a19])))
  (method ^:public invoke [this a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17 a18 a19 a20] (.callWith this (new Object/1 [a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17 a18 a19 a20])))
  (method ^:public applyTo [this ^ISeq args] (.callWith this (RT/seqToArray args))))

;; An Arbace object implementing Go interfaces (G13; GOI-SPEC.md "As built: GR7b"): what reify
;; makes of a reify naming Go interfaces of the table. goiReify is [T f0 f1 ...]: T the reify type
;; (GoInterp/reifyType's, goi's descriptor), fi the fn of T's method i, the object its first
;; argument.
(defclass ^:public ^:interface GoReify
  (method goiReify ^Object/1 [this]))

;; What goi asks of Arbace (GR5; goi cannot import arbace/lang, §1.3): an instance is given to goi
;; at GoInterp's initialization, and goi calls its methods through an interface of its own
;; (go/arbace/goi/adapt.ae's langBridge: the names j2g gives them).
(defclass ^:public ^:final GoBridge
  (constructor ^:public [this])

  (method ^:static varOf ^Var [^Symbol s]
    (let [v (.invoke (RT/var "arbace.core" "requiring-resolve") s)]
      (when-not (instance? Var v)
        (throw (IllegalArgumentException. (java-str "no var " s))))
      (cast Var v)))

  (method ^:static fnOf ^IFn [f]
    (cond
      (nil? f) (throw (NullPointerException. "nil is not an Arbace fn"))
      (instance? IFn f) (cast IFn f)
      (instance? Symbol f) (GoBridge/varOf (cast Symbol f))
      (instance? String f) (GoBridge/varOf (Symbol/intern (cast String f)))
      :else (throw (ClassCastException. (java-str "not an Arbace fn: " (.getName (.getClass f)))))))

  ;; f (an IFn, a Var, a Symbol or a String naming a var) applied to goi's args (finished by
  ;; fromGo): [0 result] as it is (nres < 0), [0] (nres 0), [0 results...] each as goi takes it
  ;; (toGo; nres > 1: the elements of the sequential result); [1 value] for a GoPanic goi made
  ;; (S50), [2 status] for a GoExit
  (method ^:public apply ^Object/1 [this f ^Object/1 args ^int nres]
    (let [n (alength args)]
      (loop [^int i 0]
        (when (< i n)
          (aset args i (GoInterp/fromGo (aget args i)))
          (recur (unchecked-inc-int i))))
      (try
        (let [r (.applyTo (GoBridge/fnOf f) (RT/seq args))]
          (cond
            (< nres 0) (new Object/1 [(Integer/valueOf 0) r])
            (== nres 0) (new Object/1 [(Integer/valueOf 0)])
            (== nres 1) (new Object/1 [(Integer/valueOf 0) (GoInterp/toGo r)])
            :else
              (let [out (new Object/1 (unchecked-inc-int nres))]
                (aset out 0 (Integer/valueOf 0))
                (loop [^int i 0]
                  (when (< i nres)
                    (aset out (unchecked-inc-int i) (GoInterp/toGo (RT/nth r i)))
                    (recur (unchecked-inc-int i))))
                out)))
        (catch GoPanic e
          (if (some? (.-goValue e))
              (new Object/1 [(Integer/valueOf 1) (.-goValue e)])
              (throw e)))
        (catch GoExit e (new Object/1 [(Integer/valueOf 2) (Integer/valueOf (.status e))])))))

  (method ^:public isFn ^boolean [this x] (instance? IFn x))
  (method ^:public keyword [this ^String s] (Keyword/intern (Symbol/intern s)))
  (method ^:public symbol [this ^String s] (Symbol/intern s))
  (method ^:public findVar [this ^String s] (GoBridge/varOf (Symbol/intern s)))
  (method ^:public derefOf [this x] (.deref (cast IDeref x)))
  (method ^:public longOf ^long [this x] (.longValue (cast Number x)))
  (method ^:public doubleOf ^double [this x] (.doubleValue (cast Number x)))
  (method ^:public truth ^boolean [this x]
    (if (instance? Boolean x) (.booleanValue (cast Boolean x)) (some? x)))
  (method ^:public seqOf [this x] (RT/seq x))
  (method ^:public firstOf [this x] (RT/first x))
  (method ^:public nextOf [this x] (RT/next x))
  (method ^:public invokeMethod [this obj ^String name ^Object/1 args]
    (Reflector/invokeInstanceMethod obj name args))
  (method ^:public fromGo [this x] (GoInterp/fromGo x))
  (method ^:public reifyOf ^Object/1 [this x]
    (if (instance? GoReify x) (.goiReify (cast GoReify x)) nil)))

;; goi's natives and their Arbace side (§4.11). GR1: the namespaces of the table's packages
;; (loadTable, members), Arbace calling compiled Go (call), variables (load, store), types
;; (typeOf, convert, zero, newValue) and the values that cross (spread, str, digest).
(defclass ^:public ^:final GoInterp
  (constructor ^:private [this])

  (field ^:private ^:static ^:final ^boolean READY (GoInterp/init0 GoValue))
  (field ^:private ^:static ^:final ^boolean BRIDGED (GoInterp/init1 (GoBridge.)))

  (method ^:private ^:static ^:native init0 ^boolean [^Class goValue])
  (method ^:private ^:static ^:native packagePath0 ^String [^String base])
  (method ^:private ^:static ^:native paths0 ^Object/1 [])
  (method ^:private ^:static ^:native members0 ^Object/1 [^String path])
  (method ^:private ^:static ^:native call0 ^Object/1 [c ^Object/1 args])
  (method ^:private ^:static ^:native load0 [cell])
  (method ^:private ^:static ^:native store0 ^void [cell v])
  (method ^:private ^:static ^:native typeOf0 [v])
  (method ^:private ^:static ^:native typeName0 ^String [t])
  (method ^:private ^:static ^:native convert0 [t v])
  (method ^:private ^:static ^:native zero0 [t])
  (method ^:private ^:static ^:native new0 [t])
  (method ^:private ^:static ^:native structArg0 [^Object/1 names ^Object/1 values orig])
  (method ^:private ^:static ^:native bigArg0 [^String s orig])
  (method ^:private ^:static ^:native spread0 [v])
  (method ^:private ^:static ^:native marker0 ^int [x])
  (method ^:private ^:static ^:native bigText0 ^String [x])
  (method ^:private ^:static ^:native funcCallable0 [x ^String name])
  (method ^:private ^:static ^:native funcValue0 [c])
  (method ^:private ^:static ^:native goString0 ^String [v])
  (method ^:private ^:static ^:native str0 ^String [v])
  (method ^:private ^:static ^:native digest0 ^String [])
  (method ^:private ^:static ^:native complex0 [^double re ^double im])
  (method ^:private ^:static ^:native op0 [^String name ^Object/1 args])
  (method ^:private ^:static ^:native init1 ^boolean [bridge])
  (method ^:private ^:static ^:native count0 ^int [v])
  (method ^:private ^:static ^:native nth0 ^Object/1 [v ^int n])
  (method ^:private ^:static ^:native lookup0 ^Object/1 [v key ^String kw])
  (method ^:private ^:static ^:native seq0 ^Object/1 [v])
  (method ^:private ^:static ^:native field0 ^Object/1 [v ^String name])
  (method ^:private ^:static ^:native method0 [v ^String name])
  (method ^:private ^:static ^:native interpType0 ^Object/1 [v])
  (method ^:private ^:static ^:native reifyType0 ^Object/1 [^Object/1 types])
  (method ^:private ^:static ^:native valueType0 [v])
  (method ^:private ^:static ^:native typeInfo0 ^Object/1 [t])

  ;; GR9d: the descriptor of a Go value's type as inference sees it (a proxy's type, an
  ;; interpreted struct's by its RT), or null; a descriptor's parts (arbace.go.generic)
  (method ^:public ^:static valueType [v] (GoInterp/valueType0 v))
  (method ^:public ^:static typeInfo ^Object/1 [t] (GoInterp/typeInfo0 t))

  ;; the reify type of Go interface types (their GoTypes, G13): [T key...], T goi's descriptor
  (method ^:public ^:static reifyType ^Object/1 [^Object/1 types]
    (let [n (alength types)
          hs (new Object/1 n)]
      (loop [^int i 0]
        (when (< i n)
          (aset hs i (.-handle (cast GoType (aget types i))))
          (recur (unchecked-inc-int i))))
      (GoInterp/reifyType0 hs)))

  ;; RT.load's hook (doc/VENDOR-NOTES.md): the namespace of a listed package (go/strings) is
  ;; made from the table (§2.1, §2.3: the table first), by arbace.go/table-ns!
  (method ^:public ^:static loadTable ^boolean [^String scriptbase]
    (let [path (GoInterp/packagePath0 scriptbase)]
      (when (nil? path)
        ;; GR9d: an interpretable package of the digest (go/slices: §9.3), loaded by goi
        (when (== (.indexOf scriptbase "/" 3) -1)
          (.invoke (RT/var "arbace.core" "require") (Symbol/intern "arbace.go"))
          (return (.equals Boolean/TRUE (.invoke (RT/var "arbace.go" "interpretable-ns!") (.substring scriptbase 3)))))
        (return false))
      (.invoke (RT/var "arbace.core" "require") (Symbol/intern "arbace.go"))
      (.invoke (RT/var "arbace.go" "table-ns!") path)
      true))

  (method ^:public ^:static paths ^Object/1 [] (GoInterp/paths0))

  (method ^:public ^:static members ^Object/1 [^String path] (GoInterp/members0 path))

  (method ^:private ^:static keywordMap ^boolean [^IPersistentMap m]
    (loop [s (.seq m)]
      (if (nil? s)
          true
          (if (instance? Keyword (.getKey (cast Map$Entry (.first s))))
              (recur (.next s))
              false))))

  ;; an Arbace value as goi takes it: a GoFn as its Go func (S35), a BigInt or BigInteger as its
  ;; decimal text, a map of keywords (for a struct) as its names and values, each the same way
  (method ^:public ^:static toGo [x]
    (cond
      (instance? GoFn x) (GoInterp/funcValue0 (.-handle (cast GoFn x)))
      (or (instance? BigInt x) (instance? BigInteger x)) (GoInterp/bigArg0 (.toString x) x)
      (and (instance? IPersistentMap x) (GoInterp/keywordMap (cast IPersistentMap x)))
        (let [m (cast IPersistentMap x)
              n (.count m)
              names (new Object/1 n)
              values (new Object/1 n)]
          (loop [^int i 0 s (.seq m)]
            (when (some? s)
              (let [e (cast Map$Entry (.first s))]
                (aset names i (.getName (cast Keyword (.getKey e))))
                (aset values i (GoInterp/toGo (.getValue e)))
                (recur (unchecked-inc-int i) (.next s)))))
          (GoInterp/structArg0 names values x))
      :else x))

  ;; a value from goi as Arbace takes it: a BigInt of a big uint64, a GoFn of a Go func
  (method ^:public ^:static fromGo [x]
    (let [m (GoInterp/marker0 x)]
      (cond
        (== m 1) (BigInt/fromBigInteger (BigInteger. (GoInterp/bigText0 x)))
        (== m 2) (GoFn. (GoInterp/funcCallable0 x "go func") "go func")
        :else x)))

  (method ^:public ^:static call [c ^Object/1 args]
    (let [n (alength args)
          as (new Object/1 n)]
      (loop [^int i 0]
        (when (< i n)
          (aset as i (GoInterp/toGo (aget args i)))
          (recur (unchecked-inc-int i))))
      (let [r (GoInterp/call0 c as)
            status (.intValue (cast Number (aget r 0)))]
        (cond
          (== status 1)
            (let [frames (cast Object/1 (aget r 4))
                  e (GoPanic. (cast String (aget r 1))
                              (^[Object/1] RT/map (new Object/1 [(Keyword/intern "go" "value") (GoInterp/fromGo (aget r 3))
                                                                 (Keyword/intern "go" "type") (aget r 2)
                                                                 (Keyword/intern "go" "trace") (GoInterp/traceData frames)]))
                              (cast Throwable (aget r 5)))]
              (set! (.-goValue e) (aget r 6))
              (GoInterp/prependTrace e frames)
              (throw e))
          (== status 2)
            (throw (GoExit. (java-str "os.Exit(" (aget r 1) ")")
                            (^[Object/1] RT/map (new Object/1 [(Keyword/intern "go" "status") (aget r 1)]))))
          :else
            (let [nr (unchecked-dec-int (alength r))]
              (cond
                (== nr 0) nil
                (== nr 1) (GoInterp/fromGo (aget r 1))
                :else
                  (let [out (new Object/1 nr)]
                    (loop [^int i 0]
                      (when (< i nr)
                        (aset out i (GoInterp/fromGo (aget r (unchecked-inc-int i))))
                        (recur (unchecked-inc-int i))))
                    (LazilyPersistentVector/createOwning out))))))))

  ;; a GoPanic's :go/trace: the interpreted frames as [go.demo/Div "REPL" 8]
  (method ^:static traceData [^Object/1 frames]
    (let [n (alength frames)
          out (new Object/1 n)]
      (loop [^int i 0]
        (when (< i n)
          (let [el (cast StackTraceElement (aget frames i))]
            (aset out i (LazilyPersistentVector/createOwning
                          (new Object/1 [(Symbol/intern (.getClassName el) (.getMethodName el)) (.getFileName el)
                                         (Long/valueOf (long (.getLineNumber el)))]))))
          (recur (unchecked-inc-int i))))
      (LazilyPersistentVector/createOwning out)))

  ;; the interpreted frames first in e's stack trace (§10.6)
  (method ^:static prependTrace ^void [^Throwable e ^Object/1 frames]
    (let [own (.getStackTrace e)
          n (alength frames)
          out (new StackTraceElement/1 (unchecked-add-int n (alength own)))]
      (loop [^int i 0]
        (when (< i n)
          (aset out i (cast StackTraceElement (aget frames i)))
          (recur (unchecked-inc-int i))))
      (System/arraycopy own 0 out n (alength own))
      (.setStackTrace e out)))

  (method ^:public ^:static load [cell] (GoInterp/fromGo (GoInterp/load0 cell)))

  (method ^:public ^:static store ^void [cell v] (GoInterp/store0 cell (GoInterp/toGo v)))

  (method ^:public ^:static typeOf [v]
    (let [t (GoInterp/typeOf0 v)] (if (nil? t) nil (GoType. t))))

  (method ^:public ^:static typeName ^String [t] (GoInterp/typeName0 t))

  (method ^:public ^:static convert [t v] (GoInterp/fromGo (GoInterp/convert0 t (GoInterp/toGo v))))

  (method ^:public ^:static zero [t] (GoInterp/fromGo (GoInterp/zero0 t)))

  (method ^:public ^:static newValue [t] (GoInterp/new0 t))

  (method ^:public ^:static spread [v] (GoInterp/spread0 v))

  (method ^:public ^:static goString ^String [v] (GoInterp/goString0 v))

  (method ^:public ^:static str ^String [v] (GoInterp/str0 (GoInterp/toGo v)))

  (method ^:public ^:static digest ^String [] (GoInterp/digest0))

  (method ^:public ^:static complex [^double re ^double im] (GoInterp/complex0 re im))

  ;; GR3 (§4.1, §4.11): the builder's and the REPL's factories of goi's nodes, descriptors and
  ;; functions, by name (go/arbace/goi/registry.ae), and what they ask of the table
  (method ^:public ^:static op [^String name ^Object/1 args] (GoInterp/op0 name args))

  ;; GR5, GS7: Go values in Arbace's collection protocols, read-only (RT's count, nth, get,
  ;; seq: doc/VENDOR-NOTES.md), elements converted by their types (§5.6)
  (method ^:static status ^int [^Object/1 r] (.intValue (cast Number (aget r 0))))

  (method ^:public ^:static countOf ^int [v]
    (let [n (GoInterp/count0 v)]
      (when (< n 0)
        (throw (UnsupportedOperationException. (java-str "count not supported on this Go value: " (GoInterp/goString v)))))
      n))

  (method ^:public ^:static nthOf [v ^int n]
    (let [r (GoInterp/nth0 v n)
          st (GoInterp/status r)]
      (cond
        (== st 0) (GoInterp/fromGo (aget r 1))
        (== st 1) (throw (IndexOutOfBoundsException. (java-str "Index " n " out of bounds for length " (GoInterp/count0 v))))
        :else (throw (UnsupportedOperationException. (java-str "nth not supported on this Go value: " (GoInterp/goString v)))))))

  (method ^:public ^:static nthOf [v ^int n notFound]
    (let [r (GoInterp/nth0 v n)
          st (GoInterp/status r)]
      (cond
        (== st 0) (GoInterp/fromGo (aget r 1))
        (== st 1) notFound
        :else (throw (UnsupportedOperationException. (java-str "nth not supported on this Go value: " (GoInterp/goString v)))))))

  (method ^:public ^:static getOf [v key notFound]
    (let [r (GoInterp/lookup0 v (GoInterp/toGo key) (when (instance? Keyword key) (.getName (cast Keyword key))))]
      (if (== (GoInterp/status r) 0) (GoInterp/fromGo (aget r 1)) notFound)))

  (method ^:public ^:static seqOf ^ISeq [v]
    (let [r (GoInterp/seq0 v)
          st (GoInterp/status r)
          n (unchecked-dec-int (alength r))]
      (cond
        (== st 0)
          (let [out (new Object/1 n)]
            (loop [^int i 0]
              (when (< i n)
                (aset out i (GoInterp/fromGo (aget r (unchecked-inc-int i))))
                (recur (unchecked-inc-int i))))
            (RT/seq out))
        (== st 1)
          (let [m (unchecked-divide-int n 2)
                out (new Object/1 m)]
            (loop [^int i 0]
              (when (< i m)
                (aset out i (MapEntry/create (GoInterp/fromGo (aget r (unchecked-add-int 1 (unchecked-multiply-int 2 i))))
                                             (GoInterp/fromGo (aget r (unchecked-add-int 2 (unchecked-multiply-int 2 i))))))
                (recur (unchecked-inc-int i))))
            (RT/seq out))
        :else (throw (IllegalArgumentException. "Don't know how to create ISeq from: arbace.lang.GoValue")))))

  ;; GS10: (.M v) and (.-F v) on a Go value, Reflector's fallback (doc/VENDOR-NOTES.md): its
  ;; dynamic type's method (an interpreted type's method set, the table's for a compiled type)
  ;; or exported field
  ;; an interpreted type's method by its var T.M in the type's namespace (its method set may not
  ;; be made yet), or nil
  (method ^:static methodVar [target ^String name]
    (let [tp (GoInterp/interpType0 target)]
      (when (some? tp)
        (let [ns (.invoke (RT/var "arbace.go" "path->ns") (aget tp 0))
              v (Namespace/find (cast Symbol ns))]
          (when (some? v)
            ;; a generic type's instance (List[int]): its methods' vars are List.M (GR9d)
            (let [tn (cast String (aget tp 1))
                  b (.indexOf tn "[")
                  x (.findInternedVar (cast Namespace v) (Symbol/intern (java-str (if (>= b 0) (.substring tn 0 b) tn) "." name)))]
              (when (and (some? x) (or (instance? GoFn (.deref (cast Var x))) (instance? GoGenericFn (.deref (cast Var x)))))
                (.deref (cast Var x)))))))))

  (method ^:public ^:static hasMethod ^boolean [target ^String name]
    (or (some? (GoInterp/method0 target name)) (some? (GoInterp/methodVar target name))))

  (method ^:public ^:static invokeMethod [target ^String name ^Object/1 args]
    (let [c (GoInterp/method0 target name)
          n (alength args)
          all (new Object/1 (unchecked-inc-int n))]
      (aset all 0 target)
      (System/arraycopy args 0 all 1 n)
      (when (nil? c)
        (let [f (GoInterp/methodVar target name)]
          (when (nil? f)
            (throw (IllegalArgumentException. (java-str "No method " name " found for the Go value " (GoInterp/goString target)))))
          (return (.applyTo (cast IFn f) (RT/seq all)))))
      (GoInterp/call c all)))

  (method ^:public ^:static fieldOf [target ^String name]
    (let [r (GoInterp/field0 target name)]
      (when-not (== (GoInterp/status r) 0)
        (throw (IllegalArgumentException. (java-str "No field " name " found for the Go value " (GoInterp/goString target)))))
      (GoInterp/fromGo (aget r 1))))

  (method ^:public ^:static memberOf [target ^String name]
    (if (GoInterp/hasMethod target name)
        (GoInterp/invokeMethod target name RT/EMPTY_ARRAY)
        (GoInterp/fieldOf target name))))

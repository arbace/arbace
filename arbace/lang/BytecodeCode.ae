                        (throw (ClassCastException. (java-str "class " (.getName (.getClass o)) " cannot be cast to class " (.getName c)))))))
                  (set! pc (unchecked-add-int pc 3)))
            193 (let [o (aget r (unchecked-dec-int sp))]
                  (aset s (unchecked-dec-int sp)
                        (if (and (some? o) (.isInstance (.resolveClass this (.u2 this (unchecked-inc-int pc))) o)) 1 0))
                  (set! pc (unchecked-add-int pc 3)))
            194 (do (set! sp (unchecked-dec-int sp)) (BytecodeCode/monitorEnter (aget r sp)) (set! pc (unchecked-inc-int pc)))
            195 (do (set! sp (unchecked-dec-int sp)) (BytecodeCode/monitorExit (aget r sp)) (set! pc (unchecked-inc-int pc)))
            196 (let [op2 (.u1 this (unchecked-inc-int pc))
                      n (.u2 this (unchecked-add-int pc 2))]

;; Classes defined from class-file bytes (doc/classes/BYTECODE-SURVEY.md, JD3, the user's decision of 2026-11-22): the
;; bytecode interpreter, JVMS chapter 6 (6.5's instructions) over the Java forms' interpreter's frames
;; (Compiler$CF$Frame: a method's locals are its frame's slots by local index, a reference in r, any other value in p:
;; int-like ones as longs, long, float as a double's bits, double as its bits, as the Java forms' interpreter keeps
;; them), its calls of interpreted methods by their Compiler$CF$Meth, of the world's by reflection or the host's super
;; calls, as Compiler$CF$CallV and its kin call them. Written from the JVMS (Java SE 26 edition).
;; Copyright (c) the Arbace authors; Eclipse Public License 1.0.

(in-ns 'arbace.lang)

(import '(java.lang.reflect Array Constructor Field InvocationTargetException Method Modifier))

;; one activation's operand stack (the JVM's slot accounting: a long or double takes two slots, its value in the
;; first), the pc of the instruction being run and the stack's depth
(defclass ^:public ^:final BytecodeAct
  (field ^:public ^:final ^long/1 s)
  (field ^:public ^:final ^Object/1 r)
  (field ^:public ^int sp)
  (field ^:public ^int pc)
  (constructor ^:public [this ^int n]
    (set! (.-s this) (new long/1 n))
    (set! (.-r this) (new Object/1 n))))

;; the object of a new of a class of the world, until its constructor runs (JVMS's uninitialized(Offset))
(defclass ^:public ^:final BytecodeUninit
  (field ^:public ^:final ^Class c)
  (constructor ^:public [this ^Class c] (set! (.-c this) c)))

;; a returnAddress (jsr, ret)
(defclass ^:public ^:final BytecodeRet
  (field ^:public ^:final ^int pc)
  (constructor ^:public [this ^int pc] (set! (.-pc this) pc)))

;; a resolved field reference: kind 0 an interpreted class's instance field (its index), 1 its static (the Klass's
;; statics and the index), 2 a field of the world (reflection), 3 a protected instance field of a superclass of the
;; world (the host's superField)
(defclass ^:public ^:final BytecodeFieldRef
  (field ^:public ^int kind)
  (field ^:public ^char t)
  (field ^:public ^int index)
  (field ^:public ^Compiler$CF$Klass k)
  (field ^:public ^Field rf)
  (field ^:public ^String name)
  (constructor ^:public [this]))

;; a resolved method reference: kind 0 an interpreted method without dispatch (m), 1 a virtual call (key; m the
;; resolved interpreted method or nil, rm the world's), 2 a static method of the world (rm), 3 a super call of a
;; method of a superclass of the world (c, key), 4 a constructor of the world (rc: of a new object; on an object of an
;; interpreted subclass, the host's superCtor of c)
(defclass ^:public ^:final BytecodeMethodRef
  (field ^:public ^int kind)
  (field ^:public ^Compiler$CF$Meth m)
  (field ^:public ^String key)
  (field ^:public ^String name)
  (field ^:public ^String desc)
  (field ^:public ^Method rm)
  (field ^:public ^Constructor rc)
  (field ^:public ^Class c)
  ;; the parameters' type chars, the return's, the arguments' slots (the receiver's not counted)
  (field ^:public ^char/1 ptypes)
  (field ^:public ^char ret)
  (field ^:public ^int slots)
  (field ^:public ^boolean hasThis)
  (field ^:public ^boolean iface)
  (constructor ^:public [this]))

;; a resolved invokedynamic call site or dynamic constant: kind 0 a lambda (its class: k), 1 string concatenation
;; (recipe, constants), 2 ObjectMethods' toString, 3 hashCode, 4 equals (fields: the getters' field references,
;; names), 5 SwitchBootstraps.typeSwitch, 6 enumSwitch (labels), 7 a constant (value)
(defclass ^:public ^:final BytecodeIndy
  (field ^:public ^int kind)
  (field ^:public ^Compiler$CF$Klass k)
  (field ^:public ^String recipe)
  (field ^:public ^Object/1 consts)
  (field ^:public ^Object/1 labels)
  (field ^:public ^BytecodeFieldRef/1 fields)
  (field ^:public ^String/1 names)
  (field ^:public ^Class recordClass)
  (field ^:public ^char/1 ptypes)
  (field ^:public ^int slots)
  (field ^:public value)
  (constructor ^:public [this]))

;; a lambda's method (LambdaMetafactory): the implementation method's handle, the captured values' count, the
;; functional method's return type char
(defclass ^:public ^:final BytecodeLambda
  (field ^:public ^int refKind)
  (field ^:public ^BytecodeMethodRef target)
  (field ^:public ^int ncaps)
  (field ^:public ^char ret)
  (constructor ^:public [this]))

(defclass ^:public ^:final BytecodeCode
  (field ^:public ^:final ^BytecodeClass bc)
  (field ^:public ^:final ^BytecodeMember mm)
  (field ^:public ^:final ^Compiler$CF$Meth meth)
  (field ^:public ^:final ^byte/1 code)
  ;; the resolved references by the pc of their instruction
  (field ^:public ^:final ^Object/1 sites)
  ;; a lambda's method (no code)
  (field ^:public ^BytecodeLambda lambda)

  (constructor ^:public [this ^BytecodeClass bc ^BytecodeMember mm ^Compiler$CF$Meth meth]
    (set! (.-bc this) bc)
    (set! (.-mm this) mm)
    (set! (.-meth this) meth)
    (set! (.-code this) (if (some? mm) (.-code mm) nil))
    (set! (.-sites this) (new Object/1 (if (and (some? mm) (some? (.-code mm))) (alength (.-code mm)) 0))))

  ;; ---------------------------------------------------------------------------------------------
  ;; values

  (method ^:public ^:static fbits ^long [^float x] (Double/doubleToRawLongBits (unchecked-double x)))
  (method ^:public ^:static fval ^float [^long b] (unchecked-float (Double/longBitsToDouble b)))
  (method ^:public ^:static dbits ^long [^double x] (Double/doubleToRawLongBits x))
  (method ^:public ^:static dval ^double [^long b] (Double/longBitsToDouble b))

  ;; slot value b of type char t as an object
  (method ^:public ^:static box [^char t ^long b]
    (switch t
      \F (Float/valueOf (BytecodeCode/fval b))
      \D (Double/valueOf (BytecodeCode/dval b))
      (Compiler$CF$Rt/box t b)))

  ;; object v as the slot value of type char t
  (method ^:public ^:static unbox ^long [^char t v]
    (switch t
      (\F \D) (Double/doubleToRawLongBits (if (== t \F) (unchecked-double (unchecked-float (Compiler$CF$Rt/toD v))) (Compiler$CF$Rt/toD v)))
      (Compiler$CF$Rt/narrow t (Compiler$CF$Rt/toJ v))))

  (method ^:public ^:static wide ^boolean [^char t] (or (== t \J) (== t \D)))

  ;; ---------------------------------------------------------------------------------------------
  ;; the code's operands

  (method ^:private s1 ^int [this ^int i] (unchecked-int (aget code i)))
  (method ^:private u1 ^int [this ^int i] (bit-and-int (aget code i) 0xFF))
  (method ^:private s2 ^int [this ^int i]
    (unchecked-int (unchecked-short (bit-or-int (bit-shift-left-int (.u1 this i) 8) (.u1 this (unchecked-inc-int i))))))
  (method ^:private u2 ^int [this ^int i]
    (bit-or-int (bit-shift-left-int (.u1 this i) 8) (.u1 this (unchecked-inc-int i))))
  (method ^:private s4 ^int [this ^int i]
    (bit-or-int (bit-shift-left-int (.u2 this i) 16) (.u2 this (unchecked-add-int i 2))))

  ;; ---------------------------------------------------------------------------------------------
  ;; running

  ;; runs the method in frame f (its receiver and arguments in their slots): a reference result returned, any other in
  ;; f's jl (int-like, long) or jd (float, double)
  (method ^:public run [this ^Compiler$CF$Frame f]
    (when (some? lambda) (return (.runLambda this f)))
    (when (not (.-linked bc)) (Bytecode/link bc))
    (when (not (== 0 (bit-and-int (.-access mm) 0x0100)))
      (throw (UnsatisfiedLinkError. (java-str "'" (Bytecode/bin2 (.-desc mm) (.-name mm) (.-name (.-k bc))) "'"))))
    (if (not (== 0 (bit-and-int (.-access mm) 0x0020)))
        (let [lock (if (.isStatic mm) (.-cls bc) (aget (.-r f) 0))]
          (BytecodeCode/monitorEnter lock)
          (try
            (.interp this f)
            (finally (BytecodeCode/monitorExit lock))))
        (.interp this f)))

  (method ^:public ^:static monitorEnter ^void [o]
    (when (nil? o) (throw (NullPointerException.)))
    ;; @dev-strip-begin
    (Compiler$Evaluator/monitorEnter o)
    ;; @dev-strip-end
    )

  (method ^:public ^:static monitorExit ^void [o]
    (when (nil? o) (throw (NullPointerException.)))
    ;; @dev-strip-begin
    (Compiler$Evaluator/monitorExit o)
    ;; @dev-strip-end
    )

  (method ^:private interp [this ^Compiler$CF$Frame f]
    (let [a (BytecodeAct. (unchecked-add-int (.-maxStack mm) 2))]
      (while true
        (try
          (return (.exec this f a))
          (catch Throwable e
            (let [h (.handler this (.-pc a) e)]
              (when (< h 0) (throw e))
              (aset (.-r a) 0 e)
              (set! (.-sp a) 1)
              (set! (.-pc a) h)))))))

  ;; the handler of exception e thrown at pc (JVMS 2.10: the first entry whose range holds pc and whose class e is an
  ;; instance of), -1 when none
  (method ^:private handler ^int [this ^int pc ^Throwable e]
    (let [hs (.-handlers mm)]
      (loop [^int i 0]
        (if (< i (alength hs))
            (if (and (>= pc (aget hs i)) (< pc (aget hs (unchecked-inc-int i))))
                (let [ct (aget hs (unchecked-add-int i 3))]
                  (if (or (== ct 0) (.isInstance (.resolveClass this ct) e))
                      (aget hs (unchecked-add-int i 2))
                      (recur (unchecked-add-int i 4))))
                (recur (unchecked-add-int i 4)))
            -1))))

  ;; the class of Class entry i of the pool, resolved through the defining loader (JVMS 5.4.3.1)
  (method ^:public resolveClass ^Class [this ^int i]
    (let [rs (.-resolved bc)
          c (aget rs i)]
      (cond
        (some? c) (cast Class c)
        ;; the class itself (this_class), not looked up by name
        (and (== i (.-thisIndex (.-cf bc))) (some? (.-cls bc))) (.-cls bc)
        :else
          (let [n (.className (.-cf bc) i)
                k (Bytecode/loadClass (.-loader bc) n)]
            (aset rs i k)
            k))))

  ;; the instructions, from a's pc and stack; the method's result when a return instruction runs
  (method ^:private exec [this ^Compiler$CF$Frame f ^BytecodeAct a]
    (let [s (.-s a)
          r (.-r a)
          lp (.-p f)
          lr (.-r f)
          cf (.-cf bc)
          ^:mutable ^int pc (.-pc a)
          ^:mutable ^int sp (.-sp a)]
      (while true
        (set! (.-pc a) pc)
        (let [op (bit-and-int (aget code pc) 0xFF)]
          (switch op
            0 (set! pc (unchecked-inc-int pc))
            1 (do (aset r sp nil) (set! sp (unchecked-inc-int sp)) (set! pc (unchecked-inc-int pc)))
            (2 3 4 5 6 7 8) (do (aset s sp (unchecked-long (unchecked-subtract-int op 3))) (set! sp (unchecked-inc-int sp)) (set! pc (unchecked-inc-int pc)))
            (9 10) (do (aset s sp (unchecked-long (unchecked-subtract-int op 9))) (set! sp (unchecked-add-int sp 2)) (set! pc (unchecked-inc-int pc)))
            (11 12 13) (do (aset s sp (BytecodeCode/fbits (unchecked-float (unchecked-subtract-int op 11)))) (set! sp (unchecked-inc-int sp)) (set! pc (unchecked-inc-int pc)))
            (14 15) (do (aset s sp (BytecodeCode/dbits (unchecked-double (unchecked-subtract-int op 14)))) (set! sp (unchecked-add-int sp 2)) (set! pc (unchecked-inc-int pc)))
            16 (do (aset s sp (unchecked-long (.s1 this (unchecked-inc-int pc)))) (set! sp (unchecked-inc-int sp)) (set! pc (unchecked-add-int pc 2)))
            17 (do (aset s sp (unchecked-long (.s2 this (unchecked-inc-int pc)))) (set! sp (unchecked-inc-int sp)) (set! pc (unchecked-add-int pc 3)))
            (18 19 20)
              (let [i (if (== op 18) (.u1 this (unchecked-inc-int pc)) (.u2 this (unchecked-inc-int pc)))
                    t (.tag cf i)]
                (switch t
                  3 (aset s sp (unchecked-long (.intValue (cast Integer (aget (.-vals cf) i)))))
                  4 (aset s sp (BytecodeCode/fbits (.floatValue (cast Float (aget (.-vals cf) i)))))
                  5 (aset s sp (.longValue (cast Long (aget (.-vals cf) i))))
                  6 (aset s sp (BytecodeCode/dbits (.doubleValue (cast Double (aget (.-vals cf) i)))))
                  8 (aset r sp (.intern (cast String (.constant cf i))))
                  7 (aset r sp (.resolveClass this i))
                  (do (set! (.-sp a) sp)
                      (let [v (.ldcOther this i pc)
                            d (.natDesc cf (aget (.-ib cf) i))]
                        (if (== t 17)
                            (let [ty (Bytecode/tc d)]
                              (if (== ty \L) (aset r sp v) (aset s sp (BytecodeCode/unbox ty v)))
                              (set! sp (unchecked-add-int sp (if (BytecodeCode/wide ty) 1 0))))
                            (aset r sp v)))))
                (set! sp (unchecked-add-int sp (if (or (== t 5) (== t 6)) 2 1)))
                (set! pc (unchecked-add-int pc (if (== op 18) 2 3))))
            (21 23) (do (aset s sp (aget lp (.u1 this (unchecked-inc-int pc)))) (set! sp (unchecked-inc-int sp)) (set! pc (unchecked-add-int pc 2)))
            (22 24) (do (aset s sp (aget lp (.u1 this (unchecked-inc-int pc)))) (set! sp (unchecked-add-int sp 2)) (set! pc (unchecked-add-int pc 2)))
            25 (do (aset r sp (aget lr (.u1 this (unchecked-inc-int pc)))) (set! sp (unchecked-inc-int sp)) (set! pc (unchecked-add-int pc 2)))
            (26 27 28 29) (do (aset s sp (aget lp (unchecked-subtract-int op 26))) (set! sp (unchecked-inc-int sp)) (set! pc (unchecked-inc-int pc)))
            (30 31 32 33) (do (aset s sp (aget lp (unchecked-subtract-int op 30))) (set! sp (unchecked-add-int sp 2)) (set! pc (unchecked-inc-int pc)))
            (34 35 36 37) (do (aset s sp (aget lp (unchecked-subtract-int op 34))) (set! sp (unchecked-inc-int sp)) (set! pc (unchecked-inc-int pc)))
            (38 39 40 41) (do (aset s sp (aget lp (unchecked-subtract-int op 38))) (set! sp (unchecked-add-int sp 2)) (set! pc (unchecked-inc-int pc)))
            (42 43 44 45) (do (aset r sp (aget lr (unchecked-subtract-int op 42))) (set! sp (unchecked-inc-int sp)) (set! pc (unchecked-inc-int pc)))
            ;; array loads
            (46 47 48 49 50 51 52 53)
              (let [i (unchecked-int (aget s (unchecked-dec-int sp)))
                    arr (aget r (unchecked-subtract-int sp 2))]
                (when (nil? arr) (throw (NullPointerException.)))
                (set! sp (unchecked-subtract-int sp 2))
                (switch op
                  46 (aset s sp (unchecked-long (aget (cast int/1 arr) i)))
                  47 (aset s sp (aget (cast long/1 arr) i))
                  48 (aset s sp (BytecodeCode/fbits (aget (cast float/1 arr) i)))
                  49 (aset s sp (BytecodeCode/dbits (aget (cast double/1 arr) i)))
                  50 (aset r sp (aget (cast Object/1 arr) i))
                  51 (aset s sp (if (instance? boolean/1 arr)
                                    (if (aget (cast boolean/1 arr) i) 1 0)
                                    (unchecked-long (aget (cast byte/1 arr) i))))
                  52 (aset s sp (unchecked-long (aget (cast char/1 arr) i)))
                  (aset s sp (unchecked-long (aget (cast short/1 arr) i))))
                (set! sp (unchecked-add-int sp (if (or (== op 47) (== op 49)) 2 1)))
                (set! pc (unchecked-inc-int pc)))
            (54 56) (do (set! sp (unchecked-dec-int sp)) (aset lp (.u1 this (unchecked-inc-int pc)) (aget s sp)) (set! pc (unchecked-add-int pc 2)))
            (55 57) (do (set! sp (unchecked-subtract-int sp 2)) (aset lp (.u1 this (unchecked-inc-int pc)) (aget s sp)) (set! pc (unchecked-add-int pc 2)))
            58 (do (set! sp (unchecked-dec-int sp)) (aset lr (.u1 this (unchecked-inc-int pc)) (aget r sp)) (set! pc (unchecked-add-int pc 2)))
            (59 60 61 62) (do (set! sp (unchecked-dec-int sp)) (aset lp (unchecked-subtract-int op 59) (aget s sp)) (set! pc (unchecked-inc-int pc)))
            (63 64 65 66) (do (set! sp (unchecked-subtract-int sp 2)) (aset lp (unchecked-subtract-int op 63) (aget s sp)) (set! pc (unchecked-inc-int pc)))
            (67 68 69 70) (do (set! sp (unchecked-dec-int sp)) (aset lp (unchecked-subtract-int op 67) (aget s sp)) (set! pc (unchecked-inc-int pc)))
            (71 72 73 74) (do (set! sp (unchecked-subtract-int sp 2)) (aset lp (unchecked-subtract-int op 71) (aget s sp)) (set! pc (unchecked-inc-int pc)))
            (75 76 77 78) (do (set! sp (unchecked-dec-int sp)) (aset lr (unchecked-subtract-int op 75) (aget r sp)) (set! pc (unchecked-inc-int pc)))
            ;; array stores
            (79 80 81 82 83 84 85 86)
              (let [w (if (or (== op 80) (== op 82)) 2 1)
                    vi (unchecked-subtract-int sp w)
                    i (unchecked-int (aget s (unchecked-dec-int vi)))
                    arr (aget r (unchecked-subtract-int vi 2))]
                (when (nil? arr) (throw (NullPointerException.)))
                (switch op
                  79 (aset (cast int/1 arr) i (unchecked-int (aget s vi)))
                  80 (aset (cast long/1 arr) i (aget s vi))
                  81 (aset (cast float/1 arr) i (BytecodeCode/fval (aget s vi)))
                  82 (aset (cast double/1 arr) i (BytecodeCode/dval (aget s vi)))
                  83 (let [v (aget r vi)
                           oa (cast Object/1 arr)]
                       (when (and (some? v) (not (.isInstance (.getComponentType (.getClass arr)) v)))
                         (throw (ArrayStoreException. (.getName (.getClass v)))))
                       (aset oa i v))
                  84 (if (instance? boolean/1 arr)
                         (aset (cast boolean/1 arr) i (not (== 0 (bit-and (aget s vi) 1))))
                         (aset (cast byte/1 arr) i (unchecked-byte (aget s vi))))
                  85 (aset (cast char/1 arr) i (unchecked-char (aget s vi)))
                  (aset (cast short/1 arr) i (unchecked-short (aget s vi))))
                (set! sp (unchecked-subtract-int vi 2))
                (set! pc (unchecked-inc-int pc)))
            87 (do (set! sp (unchecked-dec-int sp)) (set! pc (unchecked-inc-int pc)))
            88 (do (set! sp (unchecked-subtract-int sp 2)) (set! pc (unchecked-inc-int pc)))
            ;; the stack's slots moved as the JVM's
            (89 90 91 92 93 94 95)
              (do (BytecodeCode/shuffle op s r sp)
                  (set! sp (unchecked-add-int sp (switch op (89 90 91) 1 (92 93 94) 2 0)))
                  (set! pc (unchecked-inc-int pc)))
            ;; int arithmetic
            (96 100 104 108 112 120 122 124 126 128 130)
              (let [y (unchecked-int (aget s (unchecked-dec-int sp)))
                    x (unchecked-int (aget s (unchecked-subtract-int sp 2)))
                    v (switch op
                        96 (unchecked-add-int x y)
                        100 (unchecked-subtract-int x y)
                        104 (unchecked-multiply-int x y)
                        108 (if (== y 0) (throw (ArithmeticException. "/ by zero")) (if (== y -1) (unchecked-negate-int x) (unchecked-divide-int x y)))
                        112 (if (== y 0) (throw (ArithmeticException. "/ by zero")) (if (== y -1) 0 (unchecked-remainder-int x y)))
                        120 (bit-shift-left-int x (bit-and-int y 31))
                        122 (bit-shift-right-int x (bit-and-int y 31))
                        124 (unsigned-bit-shift-right-int x (bit-and-int y 31))
                        126 (bit-and-int x y)
                        128 (bit-or-int x y)
                        (bit-xor-int x y))]
                (set! sp (unchecked-dec-int sp))
                (aset s (unchecked-dec-int sp) (unchecked-long v))
                (set! pc (unchecked-inc-int pc)))
            ;; long arithmetic
            (97 101 105 109 113 127 129 131)
              (let [y (aget s (unchecked-subtract-int sp 2))
                    x (aget s (unchecked-subtract-int sp 4))
                    v (switch op
                        97 (unchecked-add x y)
                        101 (unchecked-subtract x y)
                        105 (unchecked-multiply x y)
                        109 (if (== y 0) (throw (ArithmeticException. "/ by zero")) (if (== y -1) (unchecked-negate x) (unchecked-divide x y)))
                        113 (if (== y 0) (throw (ArithmeticException. "/ by zero")) (if (== y -1) 0 (unchecked-remainder x y)))
                        127 (bit-and x y)
                        129 (bit-or x y)
                        (bit-xor x y))]
                (set! sp (unchecked-subtract-int sp 2))
                (aset s (unchecked-subtract-int sp 2) v)
                (set! pc (unchecked-inc-int pc)))
            ;; long shifts (an int count)
            (121 123 125)
              (let [y (bit-and-int (unchecked-int (aget s (unchecked-dec-int sp))) 63)
                    x (aget s (unchecked-subtract-int sp 3))]
                (set! sp (unchecked-dec-int sp))
                (aset s (unchecked-subtract-int sp 2)
                      (switch op 121 (bit-shift-left x y) 123 (bit-shift-right x y) (unsigned-bit-shift-right x y)))
                (set! pc (unchecked-inc-int pc)))
            ;; float arithmetic
            (98 102 106 110 114)
              (let [y (BytecodeCode/fval (aget s (unchecked-dec-int sp)))
                    x (BytecodeCode/fval (aget s (unchecked-subtract-int sp 2)))
                    v (switch op
                        98 (unchecked-add-float x y)
                        102 (unchecked-subtract-float x y)
                        106 (unchecked-multiply-float x y)
                        110 (unchecked-divide-float x y)
                        (unchecked-remainder-float x y))]
                (set! sp (unchecked-dec-int sp))
                (aset s (unchecked-dec-int sp) (BytecodeCode/fbits v))
                (set! pc (unchecked-inc-int pc)))
            ;; double arithmetic
            (99 103 107 111 115)
              (let [y (BytecodeCode/dval (aget s (unchecked-subtract-int sp 2)))
                    x (BytecodeCode/dval (aget s (unchecked-subtract-int sp 4)))
                    v (switch op
                        99 (unchecked-add x y)
                        103 (unchecked-subtract x y)
                        107 (unchecked-multiply x y)
                        111 (unchecked-divide x y)
                        (unchecked-remainder x y))]
                (set! sp (unchecked-subtract-int sp 2))
                (aset s (unchecked-subtract-int sp 2) (BytecodeCode/dbits v))
                (set! pc (unchecked-inc-int pc)))
            116 (let [i (unchecked-dec-int sp)] (aset s i (unchecked-long (unchecked-negate-int (unchecked-int (aget s i))))) (set! pc (unchecked-inc-int pc)))
            117 (let [i (unchecked-subtract-int sp 2)] (aset s i (unchecked-negate (aget s i))) (set! pc (unchecked-inc-int pc)))
            118 (let [i (unchecked-dec-int sp)] (aset s i (BytecodeCode/fbits (unchecked-negate-float (BytecodeCode/fval (aget s i))))) (set! pc (unchecked-inc-int pc)))
            119 (let [i (unchecked-subtract-int sp 2)] (aset s i (BytecodeCode/dbits (unchecked-negate (BytecodeCode/dval (aget s i))))) (set! pc (unchecked-inc-int pc)))
            132 (let [n (.u1 this (unchecked-inc-int pc))]
                  (aset lp n (unchecked-long (unchecked-add-int (unchecked-int (aget lp n)) (.s1 this (unchecked-add-int pc 2)))))
                  (set! pc (unchecked-add-int pc 3)))
            ;; conversions
            133 (do (aset s (unchecked-dec-int sp) (unchecked-long (unchecked-int (aget s (unchecked-dec-int sp))))) (set! sp (unchecked-inc-int sp)) (set! pc (unchecked-inc-int pc)))
            134 (let [i (unchecked-dec-int sp)] (aset s i (BytecodeCode/fbits (unchecked-float (unchecked-int (aget s i))))) (set! pc (unchecked-inc-int pc)))
            135 (let [i (unchecked-dec-int sp)] (aset s i (BytecodeCode/dbits (unchecked-double (unchecked-int (aget s i))))) (set! sp (unchecked-inc-int sp)) (set! pc (unchecked-inc-int pc)))
            136 (let [i (unchecked-subtract-int sp 2)] (aset s i (unchecked-long (unchecked-int (aget s i)))) (set! sp (unchecked-dec-int sp)) (set! pc (unchecked-inc-int pc)))
            137 (let [i (unchecked-subtract-int sp 2)] (aset s i (BytecodeCode/fbits (unchecked-float (aget s i)))) (set! sp (unchecked-dec-int sp)) (set! pc (unchecked-inc-int pc)))

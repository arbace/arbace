                    (21 23) (do (aset s sp (aget lp n)) (set! sp (unchecked-inc-int sp)))
                    (22 24) (do (aset s sp (aget lp n)) (set! sp (unchecked-add-int sp 2)))
                    25 (do (aset r sp (aget lr n)) (set! sp (unchecked-inc-int sp)))

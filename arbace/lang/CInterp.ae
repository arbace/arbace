;; ci's back end reached from Arbace (doc/C23-SURVEY.md, CS103 (c), "As built: C9 (preparation)"): one static native, whose Go
;; side is go/arbace/cinterp's CInterp_RunNodes_String_String1__I_native (j2g translates a native of this class into a call of
;; cinterp's, as arbace.lang.GoInterp's are goi's, GOI-SPEC §4.11). arbace.c.cinterp binds arbace.c.repl's *run-nodes* to it.

(in-ns 'arbace.lang)

(defclass ^:public ^:final CInterp
  (constructor ^:private [this])
  ;; runs the node program text (arbace.c.build's program-text) with the command line argv (argv[0] the program's name) in a
  ;; fresh address space, on the process's standard streams: the program's exit status (128 + a signal's number); a fault
  ;; is reported on the standard error as "cirun: fault: ...", the back end's own failures as "cirun: internal: ..." with
  ;; status 70 (the lines tools/cirun writes, which bin/ci check's judge reads)
  (method ^:public ^:static ^:native runNodes ^int [^String text ^String/1 argv]))

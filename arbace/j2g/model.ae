(ns arbace.j2g.model
  "The closed world of one j2g run (J2G-SPEC §4.1, §5): which classes exist in Go (translated
  ones, T, and jrt's hand-written ones, H), leaf classes (§5.3), the Go type of a Java type
  (§5.1), virtual method sets and their implementations (§5.4, §5.5)."
  (:require [arbace.string :as str]
            [arbace.classes.types :as t]
            [arbace.classes.env :as env]
            [arbace.classes.analyze :as a]
            [arbace.j2g.names :as nm]
            [arbace.j2g.jrt :as jrt]
            [arbace.j2g.start :as start]
            [arbace.classes.opcodes :as Opcodes]))

(def ^:dynamic *w*
  "The world: {:jrt scan :T atom-or-set :jrt-classes {internal {:go :var :standin :file}}}."
  nil)

;; ---------------------------------------------------------------------------------------
;; the parallel translation (J2G-SPEC §4.1, "The run in parallel")

(def default-jobs
  "At most this many threads by default: on Go, 16 take 10 GB at most for the program, 64 take
  12 GB (GOMEMLIMIT 12GiB) for 5% less time (doc/STANDALONE-NOTES.md, S4, amendment SA51)."
  16)

(defn jobs
  "How many threads translate and write: J2G_JOBS, else the number of processors, at most
  default-jobs."
  []
  (let [e (System/getenv "J2G_JOBS")]
    (max 1 (if (seq e)
             (Long/parseLong e)
             (min default-jobs (.availableProcessors (Runtime/getRuntime)))))))

(defn par-mapv
  "(mapv f xs), f applied on up to n threads, each taking the next element (in xs' order, or
  in the order of the indices `order`: the longest first); the results in xs' order. f's
  dynamic bindings are the caller's (future's conveyance). The last element in that order (the
  shortest) first, alone, then the others: on a host whose evaluator compiles an evaluated fn's
  method on its first call without a lock (a stage 0 older than 2026-10-18,
  Compiler$CodeRun.cmethod), threads first calling one at once could read its analyzed tree's
  lazy state torn (a NullPointerException in HashMap$EntrySet.iterator); that element compiles
  the fns of its path alone (on a thread of its own, as the others)."
  [n f xs & [order]]
  (let [xs (vec xs)
        cnt (count xs)
        n (min n cnt)
        order (if order (vec order) (vec (range cnt)))]
    (if (<= n 1)
      (mapv f xs)
      (let [res (object-array cnt)
            last-i (peek order)
            _ (aset res last-i @(future (f (nth xs last-i))))
            next-i (atom -1)
            work (fn [] (loop []
                          (let [k (swap! next-i inc)]
                            (when (< k (dec cnt))
                              (let [i (nth order k)]
                                (aset res i (f (nth xs i))))
                              (recur)))))
            ws (doall (repeatedly n #(future (work))))]
        (run! deref ws)
        (vec res)))))

;; ---------------------------------------------------------------------------------------

(defn has? [flags f] (not (zero? (bit-and (or flags 0) f))))

(defn T [] (let [x (:T *w*)] (if (instance? arbace.lang.IDeref x) @x x)))

(defn translated? [n] (contains? (T) n))

(defn j2g-static?
  "A static method of jrt's hand-written class cls (Go base name base) that j2g writes itself,
  in the program's support code, because its type is a translated class jrt cannot name:
  System.getProperties(), a Properties (out.ae; JRT-NOTES.md, \"Text and locales\":
  StaticProperty reads it)."
  [cls base]
  (and (= cls "java/lang/System") (= base "GetProperties__Properties")
       (translated? "java/util/Properties")))

(defn jrt-class
  "jrt's hand-written (or stand-in) class n, when jrt defines it: {:go :var :standin :file}."
  [n]
  (get (:jrt-classes *w*) n))

(defn hand-written?
  "Is n a class jrt provides and j2g does not translate in this world?"
  [n]
  (and (jrt-class n) (not (translated? n))))

(defn in-world? [n]
  (or (= n "java/lang/Object") (translated? n) (boolean (jrt-class n))))

(defn translatable?
  "Is n in the class environment as Java forms (j2g can translate it)?"
  [n]
  (boolean (a/decl n)))

(defn reflectable-interface?
  "Is n a JDK interface j2g knows only by reflection (no Java forms: outside the converted
  closure), which it may declare: its methods, no code (J2G-NOTES.md, \"Reflected
  interfaces\")?"
  [n]
  (and (not (a/decl n))
       (or (str/starts-with? n "java/") (str/starts-with? n "javax/") (str/starts-with? n "jdk/") (str/starts-with? n "sun/")
           (str/starts-with? n "com/sun/"))
       (not (str/includes? n "$$"))
       (some? (env/info n))
       (env/interface? n)
       ;; annotation types are interfaces too: not these
       (not (has? (:flags (env/info n)) 0x2000))
       ;; marker interfaces only (RandomAccess): one with methods would bring the types of
       ;; its methods (IntStream, TemporalField) and jrt's classes would lack them
       (empty? (:methods (env/info n)))
       (every? #(or (in-world? %) (reflectable-interface? %)) (:interfaces (env/info n)))))

(defn reflected?
  "Is n a translated class declared from reflection (no Java forms)?"
  [n]
  (and (translated? n) (not (a/decl n))))

(defn info [n] (env/info n))
(defn interface? [n] (env/interface? n))

(defn desc-classes
  "The classes a descriptor mentions (array element classes included)."
  [d]
  (cond (nil? d) nil
        (keyword? d) nil
        (t/array? d) (desc-classes (subs d (t/array-dims d)))
        (t/class-desc? d) [(t/desc->internal d)]
        :else nil))

(def ^:private ^java.util.concurrent.ConcurrentHashMap mdesc-classes
  "Method descriptor -> method-desc-classes' answer (asked for every call, by every thread)."
  (java.util.concurrent.ConcurrentHashMap.))

(defn method-desc-classes [desc]
  (or (when (string? desc) (.get mdesc-classes desc))
      (let [[ps r] (t/parse-method-desc desc)
            v (vec (mapcat desc-classes (cons r ps)))]
        (when (string? desc) (.put mdesc-classes desc v))
        v)))

(defn erased-desc?
  "Is d a class outside the world in a package a variant erases (j2g/erase), or an array of
  one? Values of such types exist only to feed what the Go build cuts (the bytecode back end):
  an operation producing one is the zero value (proposed amendment B2)."
  [d]
  (and (string? d)
       (let [e (loop [d d] (if (t/array? d) (recur (t/elem-type d)) d))]
         (and (t/class-desc? e)
              (let [n (t/desc->internal e)]
                (and (not (in-world? n))
                     (some #(str/starts-with? n %) (:erased *w*))))))))

(defn desc-in-world? [d] (every? in-world? (desc-classes d)))
(defn mdesc-in-world? [desc] (every? in-world? (method-desc-classes desc)))

;; ---------------------------------------------------------------------------------------
;; classes

(defn go-name
  "The Go type name of class n: jrt's own name for a class jrt provides and j2g does not
  translate (a jrt class may register a JDK name under another Go name: ReentrantLock's
  condition is AbstractQueuedSynchronizer$ConditionObject), else the name derived from n."
  [n]
  (or (when *w*
        (when-let [jc (get (:jrt-classes *w*) n)]
          (when-not (translated? n) (:go jc))))
      (nm/go-class-name n)))
(defn pkg [n] (nm/pkg-of n))

(defn abstract? [n] (has? (:flags (info n)) Opcodes/ACC_ABSTRACT))
(defn final? [n] (has? (:flags (info n)) Opcodes/ACC_FINAL))

(defn subclasses
  "Direct subclasses of class n in the world (memoized per world)."
  [n]
  (get ((:subclass-index *w*)) n))

(defn make-subclass-index [w]
  (let [cache (atom nil)]
    (fn []
      (or @cache
          (reset! cache
                  (binding [*w* w]
                    (reduce (fn [m c]
                              (let [s (:super (info c))]
                                (if s (update m s (fnil conj #{}) c) m)))
                            {} (concat (T) (keys (:jrt-classes w))))))))))

(def proxy-supers
  "The classes besides Object that a proxy may extend in the Go build (§5.12, arbace.j2g.dyn):
  each gets a Go type DynSub_C, a subclass of C in the world, so a translated class of the list
  is not a leaf (§5.3)."
  ["java/io/Writer" "java/io/Reader" "java/io/PushbackReader" "java/io/InputStream"
   "java/io/OutputStream" "arbace/lang/APersistentMap"
   ;; pprint's tests count the flushes of a proxy of BufferedWriter
   "java/io/BufferedWriter"
   ;; jrt's hand-written ThreadLocal (test.check's random, arbace.instant on the JVM)
   "java/lang/ThreadLocal"
   ;; java-interop's test-proxy-super: proxy-super of a translated class's method (REAP4)
   "java/util/BitSet"])

(def ^:private proxy-super? (set proxy-supers))

(defn leaf?
  "Is class n a leaf (§5.3): its values are *C pointers. Interfaces are not; jrt's classes are
  leaves when jrt gives them no class interface C_I; a translated class of proxy-supers is not
  (its DynSub_C extends it)."
  [n]
  (cond
    (= n "java/lang/Object") false
    (interface? n) false
    (hand-written? n) (not (contains? (:types (:jrt *w*)) (str (go-name n) "_I")))
    :else (and (not (abstract? n)) (empty? (subclasses n))
               (not (and (proxy-super? n) (not (final? n)))))))

;; ---------------------------------------------------------------------------------------
;; Go types (§5.1)

(defn qualify
  "A Go identifier of package `of` (:jrt or :lang) as referred to from package `from`."
  [from of ident]
  (if (or (= from of) (nil? from)) (symbol ident) (symbol (nm/pkg-name of) ident)))

(defn class-sym
  "The Go identifier `suffix` of class n (\"\" for the type itself), as referred to from `from`."
  ([from n] (class-sym from n ""))
  ([from n suffix] (qualify from (pkg n) (str (go-name n) suffix))))

(defn jrt-sym [from ident] (qualify from :jrt ident))

(def prim-go '{"Z" bool "B" int8 "C" uint16 "S" int16 "I" int32 "J" int64 "F" float32 "D" float64})

(def prim-array-go {"Z" "BooleanArray" "B" "ByteArray" "C" "CharArray" "S" "ShortArray"
                    "I" "IntArray" "J" "LongArray" "F" "FloatArray" "D" "DoubleArray"})

(defn array-test
  "checkcast (kind :cast) or instanceof (:instance) of array type d on x, an any, in package
  `from` (J2G-SPEC §5.7, §5.9): jrt's type switch on the array's Go type, a primitive array's
  `jrt.IntArray_Cast` and kin, Object[]'s `jrt.ObjectArray_Cast`, another reference array's
  `jrt.RefArray_Cast` with comp, the form of the component class (Class.isInstance only where the
  component classes differ)."
  [from kind x d comp]
  (let [e (t/elem-type d)
        suffix (if (= kind :cast) "_Cast" "_InstanceOf")]
    (cond
      (t/prim? e) (list (jrt-sym from (str (prim-array-go e) suffix)) x)
      (= e "Ljava/lang/Object;") (list (jrt-sym from (str "ObjectArray" suffix)) x)
      :else (list (jrt-sym from (str "RefArray" suffix)) x comp))))

(defn go-type
  "The Go type form of descriptor d in package `from` (§5.1)."
  [from d]
  (cond
    (= d :null) 'any
    (prim-go d) (prim-go d)
    (= d "V") nil
    (= d "Ljava/lang/Object;") 'any
    (t/array? d) (let [e (t/elem-type d)]
                   (if (t/prim? e)
                     (list '* (jrt-sym from (prim-array-go e)))
                     (list '* (jrt-sym from "RefArray"))))
    (t/class-desc? d)
    (let [n (t/desc->internal d)]
      (cond
        (not (in-world? n)) 'any
        (interface? n) (class-sym from n)
        (leaf? n) (list '* (class-sym from n))
        :else (class-sym from n "_I")))
    :else (throw (ex-info (str "j2g: no Go type for " (pr-str d)) {:desc d}))))

(defn pointer-desc?
  "Is the Go type of d a pointer (leaf class, String, array)?"
  [d]
  (cond (t/array? d) true
        (t/class-desc? d) (let [n (t/desc->internal d)]
                            (and (in-world? n) (not (interface? n)) (not= n "java/lang/Object")
                                 (leaf? n)))
        :else false))

(defn iface-desc?
  "Is the Go type of d an interface (any, C_I, J)?"
  [d]
  (and (t/ref? d) (not= d :null) (not (pointer-desc? d))))

;; ---------------------------------------------------------------------------------------
;; members

(defn static? [m] (has? (:flags m) Opcodes/ACC_STATIC))
(defn private? [m] (has? (:flags m) Opcodes/ACC_PRIVATE))
(defn abstract-m? [m] (has? (:flags m) Opcodes/ACC_ABSTRACT))

(defn methods-of [n] (:methods (info n)))
(defn fields-of [n] (:fields (info n)))

(defn find-method [n name desc]
  (some #(when (and (= name (:name %)) (= desc (:desc %))) %) (methods-of n)))

(defn virtual-member?
  "A method that takes part in dispatch: an instance method, not private, not a constructor."
  [m]
  (and (not (static? m)) (not (private? m)) (not= "<init>" (:name m)) (not= "<clinit>" (:name m))))

(def object-keys
  "Object's methods every class has through jrt.Object_I (§5.8)."
  #{["toString" "()Ljava/lang/String;"] ["hashCode" "()I"] ["equals" "(Ljava/lang/Object;)Z"]
    ["clone" "()Ljava/lang/Object;"] ["getClass" "()Ljava/lang/Class;"]})

(defn supertypes [n]
  (let [i (info n)] (remove nil? (cons (:super i) (:interfaces i)))))

(defn world-supertypes
  "n's supertypes that exist in the world (interfaces that do not are left out, §4.1)."
  [n]
  (filter in-world? (supertypes n)))

(defn all-supertypes
  "n and its supertypes that exist in the world, superclass chain first then interfaces
  (Java's supertypes: an interface in the world counts also when it is reached only through
  one that is not)."
  [n]
  (vec (filter in-world? (env/all-supertypes n))))

(declare j2g-method?)

(defn hw-method-exists?
  "Does jrt's hand-written class or interface n have method m (name desc) in Go?"
  [n m]
  (let [scan (:jrt *w*)
        g (go-name n)
        base (nm/method-base (:name m) (:desc m))]
    (cond
      (= n "java/lang/Object") (contains? object-keys [(:name m) (:desc m)])
      (interface? n) (or (contains? (jrt/iface-methods scan g) base)
                         ;; a default method is a package function J_m
                         (contains? (:funcs scan) (str g "_" base)))
      :else (let [ms (jrt/struct-methods scan g)]
              (or (contains? ms base) (contains? ms (nm/impl-name base))
                  (j2g-method? n base))))))

(defn j2g-method?
  "An instance method of jrt's hand-written class n (Go base name base) that the program's
  support code has, though jrt does not: String's chars() and codePoints(), the default methods
  of CharSequence (translated), which j2g forwards to on the classes jrt writes that implement
  it (JRT-NOTES.md, \"Text and locales\": CompactNumberFormat and java.time's text call them on
  a String)."
  [n base]
  (and (= n "java/lang/String") (#{"Chars__IntStream" "CodePoints__IntStream"} base)
       (translated? "java/lang/CharSequence") (translated? "java/util/stream/IntStream")))

(defn member-in-world?
  "Does method m of class n exist in Go: its descriptor's classes exist, and for a jrt class
  jrt has it."
  [n m]
  (and (mdesc-in-world? (:desc m))
       (or (not (hand-written? n)) (hw-method-exists? n m))))

(defn declared-vmethods
  "The virtual methods n declares that exist in Go, by [name desc]."
  [n]
  (for [m (methods-of n)
        :when (virtual-member? m)
        :when (member-in-world? n m)]
    (assoc m :owner n)))

(defn vmethods
  "Every virtual method of n (declared and inherited, abstract or not), in the world, Object's
  excluded: an ordered map [name desc] -> method (the most specific declaration: classes first)."
  [n]
  (let [cache (:vmethods-cache *w*)]
    (or (get @cache n)
        (let [r (reduce (fn [acc c]
                          (if (= c "java/lang/Object")
                            acc
                            (reduce (fn [acc m]
                                      (let [k [(:name m) (:desc m)]]
                                        (if (or (contains? acc k) (contains? object-keys k)) acc (assoc acc k m))))
                                    acc (declared-vmethods c))))
                        (array-map) (all-supertypes n))]
          (swap! cache assoc n r)
          r))))

(defn java-type-name
  "The Java name of descriptor d (int, java.lang.Object, byte[])."
  [d]
  (cond (t/array? d) (str (java-type-name (t/elem-type d)) "[]")
        (= 1 (count d)) ({"Z" "boolean" "B" "byte" "C" "char" "S" "short" "I" "int" "J" "long"
                          "F" "float" "D" "double" "V" "void"} d)
        :else (str/replace (t/desc->internal d) "/" ".")))

(defn abstract-method-error-text
  "HotSpot's message of the AbstractMethodError of method k = [name desc] (declared in owner, an
  interface or an abstract class) called on an object of class n, which does not implement it."
  [n owner [name desc]]
  (let [[ps r] (t/parse-method-desc desc)]
    (str "Receiver class " (str/replace n "/" ".") " does not define or inherit an implementation of the resolved method "
         "'abstract " (java-type-name r) " " name "(" (str/join ", " (map java-type-name ps)) ")'"
         (when owner (str " of " (if (interface? owner) "interface " "abstract class ") (str/replace owner "/" "."))) ".")))

(defn superclass-chain [n]
  (take-while some? (iterate #(:super (info %)) n)))

(defn impl-of
  "The implementation of virtual method k = [name desc] for class n: {:kind :class :owner c
  :method m} for a method with a body in n or a superclass (a jrt class's: :jrt-impl when jrt
  has Impl_, :promoted when the method itself is on its struct), {:kind :default :owner j
  :method m} for an interface's default method, or nil (abstract)."
  [n [name desc :as k]]
  (or (some (fn [c]
              (when-let [m (and (not (interface? c)) (find-method c name desc))]
                (when (and (not (static? m)) (not (abstract-m? m))
                           (or (not (private? m)) (= c n)))
                  (cond
                    (= c "java/lang/Object") {:kind :object :owner c :method m}
                    (hand-written? c)
                    (let [base (nm/method-base name desc)
                          ms (jrt/struct-methods (:jrt *w*) (go-name c))]
                      (cond (contains? ms (nm/impl-name base)) {:kind :jrt-impl :owner c :method m}
                            (contains? ms base) {:kind :promoted :owner c :method m}
                            :else nil))
                    :else {:kind :class :owner c :method m}))))
            (superclass-chain n))
      ;; default methods: the maximally specific one (JVMS 5.4.3.3)
      (let [cands (for [c (all-supertypes n)
                        :when (interface? c)
                        :let [m (find-method c name desc)]
                        :when (and m (not (abstract-m? m)) (not (static? m)) (not (private? m)))
                        :when (or (not (hand-written? c))
                                  (contains? (:funcs (:jrt *w*)) (str (go-name c) "_" (nm/method-base name desc))))]
                    {:kind :default :owner c :method m})
            cands (remove (fn [x] (some #(and (not= (:owner %) (:owner x)) (env/subclass? (:owner %) (:owner x))) cands)) cands)]
        (first cands))))

(defn code-class?
  "Is class n a compiled fn's code (standalone S6, :c2j/code; SA156)? Not a Java object in Go:
  it implements its arities' interfaces (code-iface?) and nothing of Object's protocol, which
  its fn (Compiler$AOTFn) answers; its struct starts with a header word that stays zero (so
  that jrt.IsDynamic reads it as any object's). Its allocation initializes its nest's
  top-level class (its namespace's holder, whose constants its code reads), so that its code
  reads them unguarded (SA158)."
  [n]
  (boolean (:c2j/code (:meta (a/decl n)))))

(defn code-iface?
  "Is interface n a compiled fn's arity, Compiler$AOTF<n> or $AOTR<n> (SA156): its Go interface
  does not embed jrt.Object_I, so that code-class? types implement it."
  [^String n]
  (boolean (re-matches #"arbace/lang/Compiler\$AOT[FR]\d+" n)))

(defn nest-top
  "The top-level class of class n's nest (internal names: before the first $)."
  [^String n]
  (let [i (.indexOf n "$")] (if (neg? i) n (subs n 0 i))))

(defn trivial-init?
  "Does class n have trivial initialization (§6.2): no static initializer code, no
  non-constant static field initializer, a superclass with trivial initialization? jrt's
  classes count as trivial (jrt initializes them itself)."
  [n]
  (let [cache (:trivial-cache *w*)]
    (if (contains? @cache n)
      (get @cache n)
      (let [r (cond
                (not (translated? n)) true
                (nil? (a/decl n)) true
                :else (let [d (a/decl n)
                            st @(:state d)]
                        (and (empty? (:clinit st))
                             (empty? (:clj-consts st))
                             (not (:uses-assert st))
                             (not (:interface-assert st))
                             (or (nil? (:super d)) (trivial-init? (:super d))))))]
        (swap! cache assoc n r)
        r))))

;; ---------------------------------------------------------------------------------------
;; the classes initialized at start (Futamura F4, arbace.j2g.start)

(defn go-qualified-name
  "Class n's Go name with its package's path (arbace/lang.Util), as jrt's trace of class
  initialization prints it (ARBACE_TRACE_INIT)."
  [n]
  (str (nm/pkg-path (pkg n)) "." (go-name n)))

(def ^:private start-names
  "The Go names of arbace.j2g.start/classes, as a set."
  (set start/classes))

(defn start-class?
  "Is n one of the classes initialized at start (arbace.j2g.start/classes) in this world:
  translated, with non-trivial initialization?"
  [n]
  (boolean (and (seq start-names) (translated? n) (contains? start-names (go-qualified-name n))
                (not (trivial-init? n)))))

(defn start-classes
  "The classes initialized at start in this world (start-class?), in arbace.j2g.start's order."
  []
  (let [by-go (into {} (for [n (T) :when (start-class? n)] [(go-qualified-name n) n]))]
    (keep by-go start/classes)))

;; ---------------------------------------------------------------------------------------
;; benign initialization (J2G-NOTES, phase 2D: static methods without an entry guard)

(declare pure-node?)

(defn- top-class [^String n] (let [i (.indexOf n "$")] (if (neg? i) n (subs n 0 i))))

(defn- pure-ctor?
  "Is constructor m of class c (in the file of class n) free of effects beyond its object's
  fields: field stores of pure values on this, a super or this constructor call that is pure
  too (Object's at the end)?"
  [n c m seen]
  (let [d (a/decl c)
        ab (when d (get (:bodies @(:state d)) ["<init>" (:desc m)]))]
    (and d ab (translated? c)
         (= (top-class c) (top-class n))
         (not (contains? seen [c (:desc m)]))
         (let [seen (conj seen [c (:desc m)])
               call (:call ab)
               sup (:super d)]
           (and (empty? (:prologue ab))
                (not (:nested-call ab))
                (or (nil? call)
                    (and (every? #(pure-node? n % seen) (:args call))
                         (or (nil? (:class call)) (#{"java/lang/Object" "java/lang/Enum" "java/lang/Record"} (:class call))
                             (pure-ctor? n (:class call) (:ctor call) seen))))
                (or (some? call) (nil? sup) (= sup "java/lang/Object"))
                (every? #(pure-node? n % seen) (:init @(:state d)))
                (or (nil? (:body ab)) (pure-node? n (:body ab) seen)))))))

(defn- pure-node?
  "Can node, run inside the static initializer of class n, neither be observed outside n's
  statics and new objects nor throw (bar running out of memory)?"
  [n node seen]
  (case (:op node)
    (:const :class-lit :local :this-path) true
    :do (and (every? #(pure-node? n % seen) (:statements node)) (pure-node? n (:ret node) seen))
    :let (and (every? (fn [[_ init]] (pure-node? n init seen)) (:bindings node)) (pure-node? n (:body node) seen))
    :array-init (every? #(pure-node? n % seen) (:elems node))
    :new-array (every? #(and (= :const (:op %)) (number? (:val %)) (not (neg? (long (:val %))))) (:dims node))
    :get-static (= n (or (:declarer (:field node)) (:owner (:field node))))
    :set-static (and (= n (or (:declarer (:field node)) (:owner (:field node)))) (pure-node? n (:val node) seen))
    :set-field (and (= :this-path (:op (:target node))) (empty? (:path (:target node))) (pure-node? n (:val node) seen))
    :new (and (every? #(pure-node? n % seen) (:args node))
              (nil? (:outer node))
              (or (= "java/lang/Object" (:class node))
                  (and (or (= (:class node) n) (trivial-init? (:class node)))
                       (pure-ctor? n (:class node) (:ctor node) seen))))
    :invoke (and (= :static (:kind node))
                 (or (and (= "java/lang/Class" (:owner node)) (= "getPrimitiveClass" (:name node)))
                     ;; an enum's $values(): its constants in an array
                     (and (= n (:owner node)) (= "$values" (:name node))))
                 (every? #(pure-node? n % seen) (:args node)))
    :convert (and (t/prim? (:from node)) (t/prim? (:to node)) (pure-node? n (:expr node) seen))
    :arith (and (not (#{:div :rem} (:o node))) (not= :exact (:family node)) (every? #(pure-node? n % seen) (:args node)))
    false))

(defn benign-init?
  "Is class n's initialization unobservable but through n's own static fields: trivial, or a
  static initializer that only stores pure values (constants, arrays, n's own objects built by
  pure constructors) into n's statics, over a superclass whose initialization is benign too?
  Then a static method of n that reads no static field of n needs no initialization guard
  (J2G-NOTES, phase 2D)."
  [n]
  (let [cache (:trivial-cache *w*)
        k [:benign n]]
    (if (contains? @cache k)
      (get @cache k)
      (let [r (cond
                (trivial-init? n) true
                (nil? (a/decl n)) false
                :else (let [d (a/decl n)
                            st @(:state d)]
                        (and (empty? (:clj-consts st))
                             (not (:uses-assert st))
                             (not (:interface-assert st))
                             (or (nil? (:super d)) (benign-init? (:super d)))
                             (every? #(pure-node? n % #{}) (:clinit st)))))]
        (swap! cache assoc k r)
        r))))

(def throwable-print-helpers
  "Throwable's printStackTrace to a PrintWriter or a PrintStream, by descriptor: j2g's support
  functions (out.ae, J2g_PrintStackTrace...), since jrt's hand-written Throwable cannot name the
  translated stream classes. Calls of them are translated to the function (javac's crash reports; doc/classes/JAVA-FRONTEND-SURVEY.md, \"As built:
  JN2\")."
  {"(Ljava/io/PrintWriter;)V" ["J2g_PrintStackTraceWriter" "java/io/PrintWriter"]
   "(Ljava/io/PrintStream;)V" ["J2g_PrintStackTraceStream" "java/io/PrintStream"]})

(defn throwable-print-helper
  "The support function of a call of Throwable.printStackTrace(PrintWriter|PrintStream) declared
  by Throwable (owner, the method's declaring class), when its stream class has Java forms
  (main.ae then roots its print(String), which the function calls)."
  [owner name desc]
  (when (and (= owner "java/lang/Throwable") (= name "printStackTrace"))
    (when-let [[f c] (get throwable-print-helpers desc)]
      (when (translatable? c) f))))


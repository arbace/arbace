(ns arbace.j2g.main
  "bin/j2g: Java forms to Go forms (doc/go/J2G-SPEC.md, doc/go/J2G-NOTES.md).

  bin/j2g [OPTIONS]
    --out DIR          output directory (default .tmp/j2g/out): DIR/gen/go/... the generated
                       forms (J2G-SPEC §4.3: the files j2g writes), DIR/prog/ a program root
                       merging them with jrt's hand-written forms (stand-ins of translated
                       classes removed), for bin/build-go; DIR/report.edn
    --lang             input: Arbace's arbace/lang/*.ae (default: both)
    --jdk DIR          input: the converted JDK closure (default $JRT_CONV, else jdk/forms:
                       the committed forms, bin/jrt-convert's output; its resource data in the
                       directory data beside it, jdk/data)
    --input DIR        input: an extra tree of Java forms files (test fixtures; a tree with a
                       packages.edn: the compiled namespaces, arbace.c2j, entered in the second
                       round of the load, w/load-world)
    --await DIR        --input DIR, read once DIR/aot.edn exists (j2g meanwhile loads and
                       starts analyzing the other inputs; bin/arbace-go starts j2g while the
                       host compiles the namespaces into DIR); the output is --input DIR's
    --slice REGEX      only classes whose internal names match one of the given regexes
                       (repeatable) are translated; everything else is outside the closed
                       world and the operations needing it throw (phase 1's slices)
    --root SPEC        a reachability root: CLASS (all its public members), CLASS#name (its
                       members named name), CLASS#<init> (its constructors), CLASS$* (the
                       class and its named nested classes, all their public members);
                       internal names with / or binary names with . (repeatable)
    --tests            also copy jrt's test files into the program
    --main DIR         a main package's forms tree to add to the program (its go/... files)
    --program          the whole program (J2G-SPEC §10.6): arbace.lang.Main is a root, and
                       j2g writes the main package arbace/cmd/arbace, whose main makes the
                       calling goroutine the thread main (jrt.RunMain) and calls
                       arbace.lang.Main.main(args) (RT's initialization first); build it with
                       bin/build-go --line-file DIR/prog
    --entry CLASS      with --program, the main package's main calls CLASS's static
                       main(String[]) (a root) in place of arbace.lang.Main's: a Java forms
                       program (bin/arbace-go --build-program, REAP7); no rlwrap
    --entry-arg ARG    with --program, ARG put before the command line's arguments
                       (repeated, in order): -m NS for a namespace's -main; no rlwrap
    --resources DIR[=PREFIX]
                       with --program, every file under DIR embedded too, at its path relative
                       to DIR (after PREFIX/ when given), as a directory of the class path: a
                       user's namespaces (.ae, .clj, .cljc) join the embedded sources, other
                       files the resource data (bin/arbace-go --build-program, REAP7)
    --edge FILE        the classes outside the forms, as data (default jdk/edge.edn:
                       doc/STANDALONE-NOTES.md, S2): j2g loads no class, reflects on none and
                       runs no ASM
    --record-edge FILE instead, ask the JVM (reflection, class files) and write what this run
                       asked into FILE (bin/j2g-edge update merges the builds' runs)
    --jvm-reflection   instead, ask the JVM, without recording (a world the edge does not
                       cover)"
  (:require [arbace.string :as str]
            [arbace.java.io :as io]
            [arbace.classes.types :as t]
            [arbace.classes.env :as env]
            [arbace.classes.analyze :as a]
            [arbace.j2g.world :as w]
            [arbace.j2g.jrt :as jrt]
            [arbace.j2g.model :as m]
            [arbace.j2g.names :as nm]
            [arbace.j2g.reach :as r]
            [arbace.j2g.access :as acc]
            [arbace.j2g.code :as c]
            [arbace.j2g.vh :as vh]
            [arbace.j2g.decls :as d]
            [arbace.j2g.out :as out]
            [arbace.j2g.dyn :as dyn]
            [arbace.j2g.dyncf :as dyncf]
            [arbace.j2g.fromfn :as fromfn]
            [arbace.j2g.checks :as chk]
            [arbace.j2g.embed :as embed]
            [arbace.j2g.edge :as edge]
            [arbace.j2g.zlib :as zlib]
            [arbace.repr.go.print :as gp]))

(defn- now [] (System/nanoTime))
(defn- secs [t0] (/ (Math/round (/ (- (System/nanoTime) t0) 1e7)) 100.0))

(defn parse-args [args]
  (loop [[a & more] args opts {:out ".tmp/j2g/out" :slice [] :roots [] :inputs []}]
    (case a
      nil opts
      "--out" (recur (rest more) (assoc opts :out (first more)))
      "--lang" (recur more (assoc opts :lang true))
      "--jdk" (recur (rest more) (assoc opts :jdk (first more)))
      "--input" (recur (rest more) (update opts :inputs conj (first more)))
      "--await" (recur (rest more) (-> opts (update :inputs conj (first more)) (assoc :await (first more))))
      "--slice" (recur (rest more) (update opts :slice conj (re-pattern (first more))))
      "--root" (recur (rest more) (update opts :roots conj (first more)))
      "--tests" (recur more (assoc opts :tests true))
      "--main" (recur (rest more) (update opts :mains (fnil conj []) (first more)))
      ;; goi's table of compiled packages (bin/goi table's output, doc/go/GOI-SPEC.md §6): its
      ;; package arbace/gotable joins the program root, the main package imports it
      "--gotable" (recur (rest more) (assoc opts :gotable (first more)))
      "--program" (recur more (-> opts (assoc :program true) (update :roots conj "arbace.lang.Main#main")))
      ;; repeated: the union of the edges (the tool build's jdk/edge.edn and jdk/javac/edge.edn)
      "--edge" (recur (rest more) (update opts :edges (fnil conj []) (first more)))
      ;; more Go-build variant files: the .ae files of a directory (the tool build's
      ;; overlay/jdk/javac/variants, doc/classes/JAVA-FRONTEND-SURVEY.md, "As built: JN2")
      "--variants" (recur (rest more) (update opts :variant-dirs (fnil conj []) (first more)))
      ;; a package prefix whose classes are named by their binary name (names.ae, qualified?),
      ;; beside the tool's modules' (a driver's package)
      "--qualify" (recur (rest more) (update opts :qualify (fnil conj []) (first more)))
      ;; --program: sources the shipped program leaves out embedded too (a path prefix,
      ;; embed/sources: javac's tool embeds repr/java's reader, compiled by c2j,
      ;; doc/classes/JAVA-FRONTEND-SURVEY.md, "As built: JN4")
      "--embed" (recur (rest more) (update opts :embed (fnil conj []) (first more)))
      ;; --program: a user's program (bin/arbace-go --build-program, REAP7): its entry, the
      ;; arguments before the command line's, its source and resource directories
      "--entry" (recur (rest more) (-> opts (assoc :entry (first more)) (update :roots conj (str (first more) "#main"))))
      "--entry-arg" (recur (rest more) (update opts :entry-args (fnil conj []) (first more)))
      "--resources" (recur (rest more) (update opts :resources (fnil conj []) (first more)))
      ;; --program: a Java forms tree's package namespaces embedded as no-op loaders (REAP7b, RPS93)
      "--java-namespaces" (recur (rest more) (update opts :java-namespaces (fnil conj []) (first more)))
      "--record-edge" (recur (rest more) (assoc opts :record-edge (first more)))
      "--jvm-reflection" (recur more (assoc opts :jvm-reflection true))
      (throw (ex-info (str "j2g: unknown option " a) {})))))

(defn- internal [s] (str/replace s "." "/"))

(defn manifest-classes
  "The classes the jrt manifest declares (internal names)."
  [dir]
  (let [f (io/file dir "manifest.edn")]
    (if (.isFile f)
      (set (map #(internal (str %)) (keys (first (w/read-forms f)))))
      #{})))

(defn jrt-classes
  "jrt's classes: those its forms register (Define) and those its manifest declares."
  [scan manifest]
  (merge
    (into {} (for [n manifest]
               [n {:go (nm/go-class-name n) :var (str (nm/go-class-name n) "_class") :standin false :file nil}]))
    (into {} (for [[jn v] (:classes scan)] [(internal jn) v]))))

(defn- repl-visible?
  "Can the REPL name class n's public members (internal name)? Not when n is in a JDK module's
  package that the module does not export (jdk.internal.misc, sun.nio.cs ...): the JVM refuses
  such access from Clojure code (IllegalAccessError), so the Go build's REPL world does not root
  them (J2G-SPEC §10.6; JRT-NOTES.md, \"The JDK's resource data\", amendment RD2). Classes of no
  JDK module (Arbace's, jrt's own jdk.internal.jrt) are visible, and so are the tool's modules'
  (nm/qualified?: javac's internal packages, com.sun.tools.javac.*, which repr/java's reader
  calls on the tool executable; doc/classes/JAVA-FRONTEND-SURVEY.md, JFS17 (a), \"As built:
  JN4\"): the shipped world holds none of them."
  [^String n]
  (let [i (.lastIndexOf n "/")
        pkg (.replace (subs n 0 (max i 0)) \/ \.)]
    (or (nm/qualified? n)
        ;; the packages a JDK module does not export: the edge's :unexported
        (not (edge/jvm? :unexported pkg #((requiring-resolve 'arbace.j2g.jvm/unexported?) pkg))))))

(defn- bundle-roots
  "The public no-argument constructors of the world's concrete ResourceBundle subclasses:
  ResourceBundle.getBundle makes its bundles by reflection (overlay/jdk's ResourceBundle;
  javac's messages, doc/classes/JAVA-FRONTEND-SURVEY.md, \"As built: JN2\")."
  []
  (let [bundle? (fn [n] (loop [n n i 0]
                          (cond (or (nil? n) (> i 32)) false
                                (= n "java/util/ResourceBundle") true
                                :else (recur (:super (a/decl n)) (inc i)))))]
    (for [n (sort @(:order a/*unit*))
          :let [dd (a/decl n)]
          :when (and dd (not= n "java/util/ResourceBundle")
                     (not (m/has? (:flags dd) 0x0200)) (not (m/has? (:flags dd) 0x0400))
                     (bundle? (:super dd))
                     (some #(and (= "<init>" (:name %)) (= "()V" (:desc %)) (m/has? (:flags %) 1)) (:methods dd)))]
      [n "<init>" "()V"])))

(defn- root-keys
  "Method keys of a root spec. CLASS$* is the class and every named class nested in it (the
  whole of Compiler, say)."
  [spec]
  (if (str/ends-with? spec "$*")
    (let [n (internal (subs spec 0 (- (count spec) 2)))]
      (mapcat root-keys (cons n (filter #(and (str/starts-with? % (str n "$"))
                                              (not (re-find #"\$\d" %)))
                                        @(:order a/*unit*)))))
  (let [[cls mname] (str/split spec #"#" 2)
        n (internal cls)
        dd (a/decl n)]
    (when-not dd (throw (ex-info (str "j2g: root class not found: " cls) {})))
    (concat
      (for [mm (:methods dd)
            :when (if mname (= mname (:name mm))
                      (m/has? (:flags mm) 1))]
        [n (:name mm) (:desc mm)])
      [[n "<clinit>" "()V"]]))))

(def lazy-standins
  "Replaced stand-ins initialized on first use like any translated class, not eagerly: jrt's
  hand-written code (but its tests) reads none of their statics, and their initialization needs
  much of the program initialized first (Locale's: its constants, the default locale from the
  system properties; JRT-NOTES.md, \"Text and locales\")."
  #{"java/util/Locale" "java/util/Locale$Category"})

(defn standin-roots
  "Roots for the translated classes that replace jrt's stand-ins: their static initializer
  and the members the stand-in defined (jrt's code may use them)."
  [scan T]
  (concat
    (for [n T :let [jc (get (:jrt-classes m/*w*) n)] :when (and jc (:standin jc) (a/decl n))]
      [n "<clinit>" "()V"])
  (for [n T
        :let [jc (get (:jrt-classes m/*w*) n)]
        :when (and jc (:standin jc))
        :let [g (m/go-name n)
              fs (get-in scan [:files (:file jc)])
              funcs (:funcs fs)
              meths (get-in fs [:methods g] #{})]
        mm (:methods (a/decl n))
        :let [gn (cond (= "<init>" (:name mm)) (nm/new-name g (a/ctor-real-desc n mm))
                       (m/static? mm) (str g "_" (nm/method-base (:name mm) (:desc mm)))
                       :else (nm/method-base (:name mm) (:desc mm)))]
        :when (or (contains? funcs gn) (contains? meths gn))]
    [n (:name mm) (:desc mm)])))

;; ---------------------------------------------------------------------------------------
;; filtering jrt's stand-ins

(defn- form-names
  "Go identifiers a top-level form declares."
  [f]
  (when (seq? f)
    (let [h (when (symbol? (first f)) (name (first f)))]
      (case h
        "type" (let [x (second f)] (if (symbol? x) [(name x)] []))
        "var" (let [x (second f)] (if (symbol? x) [(name x)] []))
        "func" [(name (second f))]
        nil))))

(defn- method-recv-type [f]
  (let [params (first (filter vector? (drop 2 f)))
        r (first params)
        tg (when (symbol? r) (:tag (meta r)))]
    (cond (symbol? tg) (name tg)
          (and (seq? tg) (= '* (first tg)) (symbol? (second tg))) (name (second tg))
          :else nil)))

(defn- mentions? [form names-re]
  (let [hit (volatile! false)]
    (letfn [(w [x] (cond @hit nil
                         (symbol? x) (when (re-matches names-re (name x)) (vreset! hit true))
                         (coll? x) (run! w x)
                         :else nil))]
      (w form))
    @hit))

(defn- filter-init-body [f own-re]
  (let [[h nm params & body] f]
    (apply list h nm params (remove #(mentions? % own-re) body))))

(defn filter-standins* [forms gs]
  (if (empty? gs)
    forms
    (let [alt (str/join "|" (map #(java.util.regex.Pattern/quote %) gs))
          own-re (re-pattern (str "(" alt ")(_[A-Za-z0-9_]*)?"))
          drop? (fn [f]
                  (and (seq? f) (symbol? (first f))
                       (let [h (name (first f))]
                         (cond
                           (= h "method") (some? (some->> (method-recv-type f) (re-matches own-re)))
                           (#{"type" "var" "func" "const"} h)
                           (let [nm (first (form-names f))]
                             (and nm (not= nm "init") (re-matches own-re nm)))
                           :else false))))
          ;; groups (go/var [a e] [b e]): the specs of translated classes go
          group (fn [f]
                  (if (and (seq? f) (symbol? (first f)) (#{"var" "const" "type"} (name (first f)))
                           (some vector? (rest f)))
                    (let [[h & more] f
                          [doc specs] (if (string? (first more)) [[(first more)] (rest more)] [[] more])
                          keep (remove (fn [sp] (let [x (first sp)] (and (symbol? x) (re-matches own-re (name x))))) specs)]
                      (when (seq keep) (apply list h (concat doc keep))))
                    f))]
      (vec (for [f forms :when (not (drop? f))
                 :let [f (group f)] :when f]
             (if (and (seq? f) (symbol? (first f)) (= "func" (name (first f))) (= 'init (second f)))
               (filter-init-body f own-re)
               f))))))

;; ---------------------------------------------------------------------------------------

(defn- write! [f text]
  (io/make-parents (io/file f))
  (spit (io/file f) text))

(defn- copy-file! [from to]
  (io/make-parents (io/file to))
  (io/copy (io/file from) (io/file to)))

(defn- resource-file
  "The embedded resource p (bytes b) as it is written: as p.z, zlib-compressed, when that saves
  a quarter or more (the sources, generics.edn, tzdb.dat), else as it is; jrt's OSHost.Resource
  inflates a p.z when asked for p (amendment SZ2). [name bytes]."
  [p ^bytes b]
  (let [z (zlib/deflate b)]
    (if (<= (* 4 (alength z)) (* 3 (alength b))) [(str p ".z") z] [p b])))

(defn- write-resources!
  "Writes the embedded resources ps ([path bytes-fn] in order) under dir, compressed in
  parallel (resource-file), written in order. Returns the names written."
  [dir ps]
  (let [files (m/par-mapv (m/jobs) (fn [[p bf]] (resource-file p (bf))) ps)]
    (doall
      (for [[nme ^bytes data] files]
        (let [f (io/file dir nme)]
          (io/make-parents f)
          (with-open [o (java.io.FileOutputStream. f)] (.write o data))
          nme)))))

(defn- top-of [^String n] (let [i (.indexOf n "$")] (if (neg? i) n (subs n 0 i))))

(defn- program-package-forms
  "The main package: main.go and the embedded sources (res/..., EVAL-NOTES.md, \"Loading\")."
  [embedded]
  ['(ns go.arbace.cmd.arbace (:require [arbace.go :as go]))
   (list 'go/package 'main :path "arbace/cmd/arbace" :files ["image.go" "image_types.go" "main.go" "rlwrap_linux.go" "rlwrap_other.go"]
         :embed-files (conj (vec (for [p embedded] [(str "res/" p) nil])) ["image.bin" nil]))
   '(load "arbace/image")
   '(load "arbace/image_types")
   '(load "arbace/main")
   '(load "arbace/rlwrap_linux")
   '(load "arbace/rlwrap_other")])

(defn- program-entry-main
  "A user's program's main (program-main-forms with an entry): Main's start but rlwrap, the
  command line after entry-args, entry's main (default arbace.lang.Main's)."
  [entry entry-args]
  (let [internal (str/replace (or entry "arbace.lang.Main") "." "/")
        pkg (nm/pkg-of internal)
        _ (when-not (= :lang pkg)
            (throw (ex-info (str "j2g: --entry " entry ": not a class of the program's Java forms") {})))
        call (symbol "lang" (nm/static-method-name (nm/go-class-name internal) "main" "([Ljava/lang/String;)V"))
        n (count entry-args)]
    (list 'go/func 'main []
          '(when (!= arbaceVersion "")
             (jrt/System_SetProperty_String_String__String (jrt/Str "arbace.version") (jrt/Str arbaceVersion)))
          '(let [(values sub err) (fs/Sub resources "res")]
             (when (== err nil)
               (jrt/SetHost (jrt/ProgramHost sub))))
          '(setupImage imageData)
          (concat
            (list 'let ['args (list 'jrt/NewRefArray 'jrt/String_class (list 'conv 'int32 (list '+ n '(- (len os/Args) 1))))])
            (for [[i a] (map-indexed vector entry-args)]
              (list 'aset '(.-A args) i (list 'jrt/Str a)))
            [(list 'range '[i a (subslice os/Args 1)]
                   (list 'aset '(.-A args) (list '+ 'i n) '(jrt/Str a)))
             (list 'let ['status (list 'jrt/RunMain (list 'fn [] (list call 'args)))]
                   '(finishImage)
                   '(os/Exit status))]))))

(defn- program-main-forms
  "main: first rlwrap for an interactive REPL (execRlwrap, which replaces the process when it
  applies), then the system property arbace.version from arbaceVersion (when the link set it),
  then jrt's host for the build's system (jrt.ProgramHost: OSHost, or the box's on TamaGo,
  doc/go/BOX-NOTES.md),
  then the command line as a String[], then arbace.lang.Main.main inside jrt.RunMain
  (the thread main, uncaught exceptions printed as the JVM prints them, status 1), its status
  the process's. With gotable?, the main package imports goi's table (its registration).
  With entry (a class's binary name) its static main(String[]) is called in place of Main's,
  with entry-args (strings) those arguments put before the command line's: a user's program
  (bin/arbace-go --build-program, REAP7), whose command line is its own (no rlwrap)."
  [gotable? & [entry entry-args]]
  [(list 'go/file "main.go" :imports (vec (concat '[[embed "embed"] [fs "io/fs"] [os "os"] [jrt "arbace/jrt"] [lang "arbace/lang"]]
                                                 (when gotable? '[[_ "arbace/gotable"]])
                                                 ;; the compiled namespaces' packages, for their classes' registration (S6)
                                                 (for [p (sort (distinct (vals @nm/compiled-packages)))]
                                                   ['_ (nm/pkg-path (keyword p))]))))
   '(go/var ^{:go/embed ["res"] :tag embed/FS
              :doc "resources are the namespaces' sources RT.load reads (EVAL-NOTES.md, \"Loading\").\n"}
      resources)
   '(go/var ^{:go/embed ["image.bin"] :tag string
              :doc "imageData is the image of prepared namespaces (EXEC-NOTES.md; image.go): empty until bin/arbace-go --build writes it.\n"}
      imageData)
   '(go/var ^{:tag string
              :doc "arbaceVersion is Arbace's version, the map *arbace-version* reads from the system property arbace.version: empty in j2g's output, set by bin/arbace-go's link (go build -ldflags -X main.arbaceVersion=...).\n"}
      arbaceVersion)
   (if (or entry (seq entry-args))
     (program-entry-main entry entry-args)
     '(go/func main []
        (execRlwrap)
        (when (!= arbaceVersion "")
          (jrt/System_SetProperty_String_String__String (jrt/Str "arbace.version") (jrt/Str arbaceVersion)))
        (let [(values sub err) (fs/Sub resources "res")]
          (when (== err nil)
            (jrt/SetHost (jrt/ProgramHost sub))))
        (setupImage imageData)
        (let [args (jrt/NewRefArray jrt/String_class (conv int32 (- (len os/Args) 1)))]
          (range [i a (subslice os/Args 1)]
            (aset (.-A args) i (jrt/Str a)))
          (let [status (jrt/RunMain (fn [] (lang/Main_Main_String1__V args)))]
            (finishImage)
            (os/Exit status)))))])

(defn- source-top
  "The name a Go file is named after (§4.3): in arbace/lang the Java forms file of top-level
  class top (FxClasses for the classes of FxClasses.ae, so that --line-file positions name
  it), in jrt the class (its Java source path)."
  [world pkg top]
  (if-let [f (and (not= pkg :jrt) (get (:source-of world) top))]
    (let [b (.getName (io/file f))]
      (str (subs top 0 (inc (.lastIndexOf ^String top "/"))) (subs b 0 (- (count b) 3))))
    top))

;; ---------------------------------------------------------------------------------------
;; the parallel translation and writing (J2G-SPEC §4.1, "The run in parallel")

(defn- apart
  "Runs f (forms of class n, the i-th of its kind, tag naming the kind) on its own, with the
  effects the sequential run has on the package's state recorded rather than applied: its
  literals named apart (Lit?<tag><i>_k, in first-use order), what it conj'ed into the
  package's ups, lambdas and cuts and into the races, in order, and its printed output. With
  catch?, an exception is the result's :error [n message] (a translation's), else it is
  thrown."
  [tag i n f catch?]
  (let [t0 (now)
        ps {:lits (atom {}) :lit-prefix (str "Lit?" tag i "_")
            :ups (atom []) :lambdas (atom []) :cuts (atom [])}
        races (atom [])
        sw (java.io.StringWriter.)
        r (binding [c/*pkgstate* ps c/*races* races *out* sw
                    c/*node-memo* {:simple (java.util.IdentityHashMap.) :effects (java.util.IdentityHashMap.)}]
            (if catch?
              (try
                {:forms (f)}
                (catch Throwable ex
                  (println "j2g: error in" n ":" (.getMessage ex))
                  (when (System/getenv "J2G_TRACE") (.printStackTrace ex))
                  {:error [n (.getMessage ex)]}))
              {:forms (f)}))]
    (assoc r :lits @(:lits ps) :lit-prefix (:lit-prefix ps) :ups @(:ups ps) :lambdas @(:lambdas ps)
           :cuts @(:cuts ps) :races @races :out (str sw) :secs (secs t0))))

(defn- merge-apart!
  "Applies to the package state ps (and c/*races*) what result r of apart recorded, as the
  sequential run would have done it: its printed output, its conj's replayed one by one, its
  literals named in the package's pool (Lit_n, numbered in order of first use; one an earlier
  class used keeps its name). Returns renames with r's literals' renames added."
  [r ps renames]
  (let [plen (count (:lit-prefix r))
        conj-all (fn [a xs] (when (seq xs) (swap! a #(reduce conj % xs))))
        lits (:lits ps)
        renames (reduce (fn [renames [s sym]]
                          (let [g (or (get @lits s)
                                      (let [g (symbol (str "Lit_" (count @lits)))]
                                        (swap! lits assoc s g)
                                        g))]
                            (assoc renames sym g)))
                        renames
                        (sort-by #(Long/parseLong (subs (name (val %)) plen)) (:lits r)))]
    (print (:out r))
    (conj-all (:ups ps) (:ups r))
    (conj-all (:lambdas ps) (:lambdas r))
    (conj-all (:cuts ps) (:cuts r))
    (conj-all c/*races* (:races r))
    renames))

(defn translate-classes
  "Translates the classes ns (in order) in parallel (jobs threads), each apart, and merges what
  each did, in their order, as the sequential translation would have done it class after
  class (merge-apart!): the forms into files ([pkg go-file] -> forms; file-of gives a
  class's), its errors into errors. cost-of estimates a class's translation time (the
  costliest start first). Returns the renames of the classes' literals (out/*renames*)."
  [ns file-of cost-of pkgstates files errors]
  (let [results (m/par-mapv (m/jobs)
                            (fn [[i n]] (apart "" i n #(if (m/reflected? n) (d/reflected-forms n) (d/class-forms n)) true))
                            (map-indexed vector ns)
                            ;; the costliest first, so that none is left to the end alone
                            (sort-by #(- (cost-of (nth ns %))) (range (count ns))))
        _ (when (System/getenv "J2G_CLASS_TIMES")
            (doseq [[n r] (take 25 (sort-by (comp - :secs second) (map vector ns results)))]
              (println "j2g: class time" n (:secs r))))]
    (reduce
      (fn [renames [n r]]
        (let [[pkg fname] (file-of n)
              renames (merge-apart! r (get pkgstates pkg) renames)]
          (if-let [e (:error r)]
            (swap! errors conj e)
            (swap! files update [pkg fname] (fnil into []) (:forms r)))
          renames))
      {}
      (map vector ns results))))

(defn- merge-registrations!
  "Merges the registrations' results rs, in order, into the package state ps (as
  translate-classes). Returns their literals' renames."
  [rs ps]
  (reduce (fn [renames r] (merge-apart! r ps renames)) {} rs))

(defn- registration-forms
  "The forms of j2g_classes.go of package pkg from its classes' registrations rs."
  [pkg rs]
  (let [forms (mapcat :forms rs)
        code? #(and (seq? %) (= 'j2g/code-decl (first %)))
        decls (map second (filter code? forms))
        cd (m/jrt-sym pkg "CodeDecl")]
    (vec (concat
          ;; the compiled fns' code classes (SA159): one table of static data, defined
          ;; first (the package's other classes may name them), linked at init
          (when (seq decls)
            [(list 'go/var (with-meta 'j2gCode {:tag (list 'slice cd)}) (apply list 'lit (list 'slice cd) decls))
             (list 'go/var (with-meta 'j2gCodeDefined {:tag 'bool}) (list (m/jrt-sym pkg "DefineCode") 'j2gCode))
             (list 'go/func 'init [] (list (m/jrt-sym pkg "LinkCode") 'j2gCode))])
          (remove code? forms)))))

(defn registrations
  "The forms of j2g_classes.go of each package pkg of pkg-classes ([pkg classes], in order;
  out/class-registration of each class, in order), the classes of all the packages in
  parallel, each apart. Returns [pkg forms results], whose results merge-registrations! merges
  into the package's state, in order."
  [pkg-classes]
  (let [jobs (vec (for [[pkg classes] pkg-classes [i n] (map-indexed vector classes)] [pkg i n]))
        rs (m/par-mapv (m/jobs) (fn [[pkg i n]] (apart (str "r" (name pkg)) i n #(out/class-registration pkg n) false))
                       jobs)
        by-pkg (group-by first (map (fn [[pkg] r] [pkg r]) jobs rs))]
    (for [[pkg _] pkg-classes]
      (let [rs (mapv second (get by-pkg pkg))]
        [pkg (registration-forms pkg rs) rs]))))

(def default-edge "jdk/edge.edn")

(defn- report-str
  "report.edn's text: the map a key per line, a map or vector with more than one element an
  element per line, the rest as pr-str prints it (arbace.pprint took half a minute on the
  program's report, on the critical path at the end of the run)."
  [report]
  (let [big? #(and (coll? %) (not (seq? %)) (> (count %) 1))
        val-str (fn [v]
                  (cond
                    (not (big? v)) (pr-str v)
                    (map? v) (str "{" (str/join ",\n  " (for [[k x] v] (str (pr-str k) " " (pr-str x)))) "}")
                    (vector? v) (str "[" (str/join "\n  " (map pr-str v)) "]")
                    :else (pr-str v)))]
    (str "{" (str/join ",\n " (for [[k v] report] (str (pr-str k) " " (val-str v)))) "}\n")))

(defn run*
  "j2g's run, in the class environment run binds."
  [opts]
  (reset! nm/qualified-prefixes (vec (:qualify opts)))
  (let [t0 (now)
        root-dir "."
        ;; the converted JDK: --jdk, else $JRT_CONV, else the committed forms (jdk/README.md)
        jdk (or (:jdk opts) (System/getenv "JRT_CONV") "jdk/forms")
        opts (if (:program opts)
               (let [srcs (embed/sources root-dir (:embed opts))
                     ;; the JDK's resource data, next to the converted JDK (jdk/data)
                     data (embed/data (str (.getParent (io/file jdk)) "/data"))
                     ;; a user's program's directories (--resources, REAP7)
                     [usrcs udata] (embed/user-resources (:resources opts) (into (set (keys srcs)) (keys data)))
                     srcs (merge srcs usrcs)
                     srcs (merge srcs (embed/package-loaders (:java-namespaces opts) (into (set (keys srcs)) (keys data))))]
                 (assoc opts :embedded srcs :cut-candidates (sort (embed/cut-candidates srcs))
                        :embedded-data (merge data udata)))
               opts)
        ;; the second round's inputs: the compiled namespaces' trees (their packages.edn)
        late? (fn [i] (or (= i (:await opts)) (.isFile (io/file i "packages.edn"))))
        compiled-packages! #(reset! nm/compiled-packages
                                    (apply merge {} (for [i (:inputs opts)
                                                          :let [f (io/file i "packages.edn")]
                                                          :when (.isFile f)]
                                                      (read-string (slurp f)))))
        _ (compiled-packages!)
        wait (fn []
               (when-let [d (:await opts)]
                 (let [t (now)]
                   (while (not (.isFile (io/file d "aot.edn")))
                     (Thread/sleep 100))
                   (println (str "j2g: " d " ready after " (secs t) " s"))
                   (compiled-packages!))))
        inputs (vec (concat
                      (when (or (:lang opts) (not (:jdk opts)))
                        ;; --program: the Java API arbace.java.api.Clojure too (a class of
                        ;; the runtime on the JVM; Clojure's suite calls it by reflection)
                        [{:root "arbace" :dirs (if (:program opts) ["lang" "java/api"] ["lang"])}])
                      (when (or (:jdk opts) (not (:lang opts))) (when (.isDirectory (io/file jdk)) [{:root jdk :tree true}]))
                      (for [i (:inputs opts) :when (not (late? i))] {:root i :tree true})))
        late-inputs (vec (for [i (:inputs opts) :when (late? i)] {:root i :tree true}))
        clj-files (fn [dir] (let [d (io/file dir)]
                              (when (.isDirectory d)
                                (sort (filter #(str/ends-with? (str %) ".ae") (.listFiles d))))))
        variant-files (or (:variant-files opts)
                          (concat
                            (when (some #(= "arbace" (:root %)) inputs) (clj-files "arbace/lang/go"))
                            ;; the JDK closure's variants (jrt's, overlay/jdk/variants)
                            (when (some #(= jdk (:root %)) inputs) (clj-files "overlay/jdk/variants"))
                            ;; --variants DIR: more, after them
                            (mapcat clj-files (:variant-dirs opts))))
        world (w/load-world inputs :variant-files variant-files :late-inputs late-inputs :wait wait)
        _ (doseq [[n c] (sort (:variants world))]
            (println (str "j2g: variant of " n ": " (:replaced c) " replaced, " (:cut c) " cut, " (:added c) " added")))
        t-load (secs t0)
        _ (println (str "j2g: " (count (:files world)) " files, " (count @(:compile-set world)) " classes analyzed in " t-load " s"
                        (when (seq (:failed world)) (str ", " (count (:failed world)) " failures"))))
        jrt-dir "go/arbace/jrt"
        scan (jrt/scan jrt-dir)
        manifest (manifest-classes jrt-dir)
        jc (jrt-classes scan manifest)
        ;; String.format over the translated Formatter (JRT-NOTES.md: "waiting for j2g"):
        ;; j2g writes it into jrt's j2g_support when Formatter is translated
        formatter? (and (contains? @(:compile-set world) "java/util/Formatter")
                        (or (empty? (:slice opts)) (some #(re-find % "java/util/Formatter") (:slice opts))))
        slice (:slice opts)
        in-slice? (fn [n] (or (empty? slice) (some #(re-find % n) slice)))
        ;; jrt's statics whose values are translated objects (overlay/jdk's jrt classes): the
        ;; standard streams of System and String.CASE_INSENSITIVE_ORDER, written by j2g into
        ;; jrt's j2g_support (out/jrt-statics-forms) when their classes are translated
        jrt-java? (fn [n] (and (contains? @(:compile-set world) n) (in-slice? n)))
        streams? (jrt-java? "jdk/internal/jrt/StandardStreams")
        ci-order? (jrt-java? "jdk/internal/jrt/CaseInsensitiveComparator")
        ;; String's regex methods over the translated java.util.regex (out/support-forms)
        regex? (jrt-java? "java/util/regex/Pattern")
        ;; ForkJoinPool's ExecutorService methods over translated types (out/fjp-support-forms)
        fjp-support? (and (jrt-java? out/fjp-support-class) (jrt-java? "java/util/concurrent/ExecutorService"))
        scan (cond-> scan
               formatter? (update :funcs into ["String_Format_String_O1__String" "String_Format_Locale_String_O1__String"])
               formatter? (update-in [:methods "String"] (fnil conj #{}) "Formatted_O1__String")
               (contains? @(:compile-set world) "java/lang/Iterable")
               (update :funcs conj "String_Join_CharSequence_Iterable__String")
               (contains? @(:compile-set world) "java/util/Optional")
               (update-in [:methods "String"] (fnil conj #{}) "DescribeConstable__Optional")
               ;; Class.getResourceAsStream (out/support-forms)
               (contains? @(:compile-set world) "java/io/ByteArrayInputStream")
               (update-in [:methods "Class"] (fnil conj #{}) "GetResourceAsStream_String__InputStream")
               (contains? @(:compile-set world) "java/util/stream/Stream")
               (update-in [:methods "String"] (fnil conj #{}) "Lines__Stream")
               streams? (update :vars into ["System_in" "System_out" "System_err"])
               streams? (update :funcs into ["System_SetIn_InputStream__V" "System_SetOut_PrintStream__V" "System_SetErr_PrintStream__V"])
               ci-order? (update :vars conj "String_CASE_INSENSITIVE_ORDER")
               regex? (update-in [:methods "String"] (fnil into #{}) (map first out/string-regex-methods))
               fjp-support? (update-in [:methods "ForkJoinPool"] (fnil into #{})
                                       (map (fn [[n d]] (nm/method-base n d)) out/fjp-support-methods)))
        cs (:compile-set world)]
    (w/with-world world
      (let [wst {:jrt scan :jrt-classes jc :T #{} :vmethods-cache (atom {}) :trivial-cache (atom {})
                 :erased (:erased world)
                 ;; the constant VarHandles of the world and the fields they name (§8.5)
                 :vh (vh/handles @(:order a/*unit*))}
            _ (println (str "j2g: " (count (:handles (:vh wst))) " constant VarHandles, on "
                            (count (:fields (:vh wst))) " fields"))
            t1 (now)
            roots (vec (concat (mapcat root-keys (concat (:roots opts) (when-let [f (:root-fn opts)] (f))
                                                         ;; --program: the REPL's world, every public
                                                         ;; member of every class with Java forms
                                                         ;; (J2G-SPEC §10.6, EVAL-PLAN.md Q2)
                                                         (when (:program opts) (filter #(and (a/decl %) (repl-visible? %)
                                                                                             ;; not a compiled fn's code or a
                                                                                             ;; reify's (S6): reached by their
                                                                                             ;; interfaces' calls
                                                                                             (not (and (nm/compiled-class? %) (str/includes? % "$"))))
                                                                                       (sort @(:order a/*unit*))))))
                               ;; what the evaluator's Dyn (j2g_dyn.go) calls
                               (when (a/decl dyn/api-class) (concat (dyn/roots) (dyn/proxy-roots)))
                               (when (a/decl "arbace/lang/RT") (fromfn/roots))
                               ;; what Class.getResourceAsStream (out/support-forms) makes
                               (when (a/decl "java/io/ByteArrayInputStream")
                                 [["java/io/ByteArrayInputStream" "<init>" "([B)V"]])
                               (when streams?
                                 [["jdk/internal/jrt/StandardStreams" "in" "()Ljava/io/InputStream;"]
                                  ["jdk/internal/jrt/StandardStreams" "out" "()Ljava/io/PrintStream;"]
                                  ["jdk/internal/jrt/StandardStreams" "err" "()Ljava/io/PrintStream;"]])
                               (when regex?
                                 [["java/util/regex/Pattern" "compile" "(Ljava/lang/String;)Ljava/util/regex/Pattern;"]
                                  ["java/util/regex/Pattern" "split" "(Ljava/lang/CharSequence;I)[Ljava/lang/String;"]
                                  ["java/util/regex/Pattern" "matcher" "(Ljava/lang/CharSequence;)Ljava/util/regex/Matcher;"]
                                  ["java/util/regex/Pattern" "matches" "(Ljava/lang/String;Ljava/lang/CharSequence;)Z"]
                                  ["java/util/regex/Matcher" "replaceAll" "(Ljava/lang/String;)Ljava/lang/String;"]
                                  ["java/util/regex/Matcher" "replaceFirst" "(Ljava/lang/String;)Ljava/lang/String;"]])
                               (when ci-order?
                                 [["jdk/internal/jrt/CaseInsensitiveComparator" "<clinit>" "()V"]])
                               ;; Runtime.exec's six overloads (out/support-forms; JRT-NOTES.md,
                               ;; "Processes")
                               (when (jrt-java? "jdk/internal/jrt/RuntimeExec")
                                 (for [d ["(Ljava/lang/String;)Ljava/lang/Process;"
                                          "(Ljava/lang/String;[Ljava/lang/String;)Ljava/lang/Process;"
                                          "(Ljava/lang/String;[Ljava/lang/String;Ljava/io/File;)Ljava/lang/Process;"
                                          "([Ljava/lang/String;)Ljava/lang/Process;"
                                          "([Ljava/lang/String;[Ljava/lang/String;)Ljava/lang/Process;"
                                          "([Ljava/lang/String;[Ljava/lang/String;Ljava/io/File;)Ljava/lang/Process;"]]
                                   ["jdk/internal/jrt/RuntimeExec" "exec" d]))
                               (when fjp-support?
                                 (map out/fjp-support-key out/fjp-support-methods))
                               ;; Date.toInstant's support function (m/support-call-helpers; JCS77
                               ;; (a)): Instant.ofEpochMilli, and Timestamp's own toInstant
                               (when (jrt-java? "java/time/Instant")
                                 (concat [["java/time/Instant" "ofEpochMilli" "(J)Ljava/time/Instant;"]]
                                         (when (jrt-java? "java/sql/Timestamp")
                                           [["java/sql/Timestamp" "toInstant" "()Ljava/time/Instant;"]])))
                               ;; ResourceBundle.getBundle's classes (overlay/jdk's ResourceBundle:
                               ;; Class.forName, then the public no-argument constructor by
                               ;; reflection): every concrete bundle class's
                               (when (a/decl "java/util/ResourceBundle")
                                 (bundle-roots))
                               ;; j2g's support for the REPL's reflection (out/support-forms)
                               (when (contains? @(:compile-set world) "java/util/Optional")
                                 [["java/util/Optional" "of" "(Ljava/lang/Object;)Ljava/util/Optional;"]])
                               (when (contains? @(:compile-set world) "java/util/stream/Stream")
                                 [["java/util/ArrayList" "<init>" "()V"]
                                  ["java/util/ArrayList" "add" "(Ljava/lang/Object;)Z"]
                                  ["java/util/Collection" "stream" "()Ljava/util/stream/Stream;"]])
                               (when (contains? @(:compile-set world) "java/io/PrintWriter")
                                 [["java/io/PrintWriter" "print" "(Ljava/lang/String;)V"]])
                               (when (contains? @(:compile-set world) "java/io/PrintStream")
                                 [["java/io/PrintStream" "print" "(Ljava/lang/String;)V"]])
                               (when (and (contains? @(:compile-set world) "java/util/HashMap")
                                          (contains? @(:compile-set world) "java/util/Collections"))
                                 [["java/util/HashMap" "<init>" "()V"]
                                  ["java/util/HashMap" "put" "(Ljava/lang/Object;Ljava/lang/Object;)Ljava/lang/Object;"]
                                  ["java/util/Collections" "unmodifiableMap" "(Ljava/util/Map;)Ljava/util/Map;"]])
                               (when formatter?
                                 [["java/util/Formatter" "<init>" "()V"]
                                  ["java/util/Formatter" "<init>" "(Ljava/util/Locale;)V"]
                                  ["java/util/Formatter" "format" "(Ljava/lang/String;[Ljava/lang/Object;)Ljava/util/Formatter;"]
                                  ["java/util/Formatter" "toString" "()Ljava/lang/String;"]])))
            slice? (fn [n] (boolean (in-slice? (top-of n))))
            ;; the stand-ins the translated classes replace: the members they define are roots
            ;; too (jrt's own code uses them), to a fixpoint
            ;; every stand-in j2g can translate (in the slice) is replaced (J2G-SPEC §4.3)
            standins (vec (for [[n j] jc :when (and (:standin j) (m/translatable? n) (slice? n))] n))
            ;; each round continues the previous one from the new roots (reach/run's :state)
            res (loop [res (binding [m/*w* wst] (r/run {:roots roots :slice? slice? :classes standins})) n 0]
                  (let [sroots (binding [m/*w* (assoc wst :T (:T res))] (vec (standin-roots scan (:T res))))
                        res2 (binding [m/*w* wst] (r/run {:roots sroots :slice? slice? :state (:state res)
                                                          :fis (binding [m/*w* (assoc wst :T (:T res))] (fromfn/fis (:T res)))}))]
                    (if (or (= (:T res2) (:T res)) (> n 8)) res2 (recur res2 (inc n)))))
            T (:T res)
            wst (assoc wst :T T :vmethods-cache (atom {}) :trivial-cache (atom {}))
            wst (assoc wst :subclass-index (m/make-subclass-index wst))
            ;; built once here rather than by the first threads of the translation to ask
            _ ((:subclass-index wst))
            t-reach (secs t1)
            _ (println (str "j2g: reachability: " (count T) " classes, " (count (:reached res)) " methods reached, "
                            (count (:unavailable res)) " with missing parts (" t-reach " s)"))
            t2 (now)
            gen-dir (str (:out opts) "/gen")
            prog-dir (str (:out opts) "/prog")
            cuts (atom #{})
            ;; the Go packages: jrt, lang, and the compiled namespaces' (S6, SA142)
            T-by-pkg (group-by m/pkg T)
            pkgs (vec (concat [:jrt :lang] (sort (filter nm/compiled-pkg? (keys T-by-pkg)))))
            pkgstates (into {} (for [p pkgs] [p {:lits (atom {}) :ups (atom #{}) :lambdas (atom #{}) :cuts cuts}]))
            files (atom {})   ; [pkg go-file] -> forms
            errors (atom [])
            lit-renames (atom {})
            ;; the steps' times (report.edn's :times :steps)
            steps (atom [])
            lap (let [t (atom (now))]
                  (fn [k] (let [x (now)]
                            (swap! steps conj [k (/ (Math/round (/ (- x @t) 1e7)) 100.0)])
                            (reset! t x))))]
        (binding [m/*w* wst
                  out/*absent-members* (boolean (:program opts))
                  d/*reached* (:reached res)
                  c/*races* (atom #{})]
          ;; classes, grouped by the file of their top-level class: translated in parallel,
          ;; each with state of its own, merged in class order (translate-classes)
          (reset! lit-renames
                  (translate-classes (vec (sort T))
                                     (fn [n] (let [pkg (m/pkg n)]
                                               [pkg (out/go-file-name pkg (source-top world pkg (top-of n)))]))
                                     ;; a class's cost, roughly: the size of its Java forms file
                                     (let [size (memoize (fn [f] (.length (io/file f))))]
                                       (fn [n] (if-let [f (get (:source-of world) (top-of n))] (size f) 0)))
                                     pkgstates files errors))
          (lap :classes)
          ;; the type of the objects of classes made at run time (J2G-SPEC §5.12)
          (when (dyn/enabled?)
            (binding [c/*pkgstate* (get pkgstates :lang)]
              (swap! files assoc [:lang "j2g_dyn.go"] (vec (dyn/forms T)))))
          ;; the Java forms' host at the REPL (doc/go/CLASSFORMS-REPL.md)
          (when (and (dyn/enabled?) (dyncf/enabled?))
            (binding [c/*pkgstate* (get pkgstates :lang)]
              (swap! files assoc [:lang "j2g_cf.go"] (vec (dyncf/forms T)))))
          (lap :dyn)
          ;; FromFn of the functional interfaces (J2G-SPEC §7.11), their adapters with the lambdas'
          (let [fis (filter #(contains? T %) (fromfn/fis T))]
            (when (seq fis)
              (swap! (:lambdas (get pkgstates :lang)) into fis)
              (swap! files assoc [:lang "j2g_fromfn.go"] (vec (fromfn/forms fis)))))
          (lap :fromfn)
          ;; adapters of the functional interfaces lambdas target (in the interface's package)
          (loop [done #{}]
            (let [todo (doall (distinct (remove done (for [[pkg ps] pkgstates fi @(:lambdas ps)] fi))))]
              (when (seq todo)
                (doseq [fi todo]
                  (let [pkg (m/pkg (if (vector? fi) (first fi) fi))]
                    (binding [c/*pkgstate* (get pkgstates pkg)]
                      (swap! files update [pkg "j2g_lambdas.go"] (fnil into []) (out/adapter-forms pkg fi)))))
                (recur (into done todo)))))
          (lap :adapters)
          ;; per package: registrations first (their member tables may name cut classes of
          ;; either package), then the literal pool, conversions, frames, support, cut classes
          (let [regs (registrations (for [pkg pkgs
                                          :let [classes (vec (sort (get T-by-pkg pkg)))]
                                          :when (or (seq classes) (= pkg :jrt))]
                                      [pkg classes]))]
            (doseq [[pkg forms rs] regs]
              (swap! lit-renames merge (merge-registrations! rs (get pkgstates pkg)))
              (swap! files assoc [pkg "j2g_classes.go"] forms)))
          (lap :registrations)
          (doseq [pkg pkgs
                  :let [ps (get pkgstates pkg)
                        classes (sort (get T-by-pkg pkg))]
                  :when (or (seq classes) (= pkg :jrt))]
            (binding [c/*pkgstate* ps]
              (when-let [fr (out/frames-forms pkg classes)] (swap! files assoc [pkg "j2g_frames.go"] (vec fr)))
              ;; the classes initialized at start, for jrt.StartCheck (Futamura F4)
              (when (= pkg :lang)
                (when-let [sf (out/start-forms pkg (m/start-classes))]
                  (swap! files assoc [pkg "j2g_start.go"] sf)))
              (when (= pkg :jrt) (swap! files assoc [pkg "j2g_support.go"] (out/support-forms)))
              (when (= pkg :jrt)
                (when-let [tf (out/support-table-forms)]
                  (swap! files assoc [pkg "reflect_tables_j2g.go"] (vec tf)))))
            ;; --program: the classes the embedded namespaces name outside the world are cut
            ;; classes too, so that their imports and hints resolve (EVAL-NOTES.md); found once
            ;; (with jrt's package), the runtime's packages' alone
            (when (= pkg :jrt)
            (let [taken (into (set (map m/go-name T)) (concat (:vars (:jrt m/*w*)) (keys (:types (:jrt m/*w*)))))
                  taken (into taken (map #(str (m/go-name %) "_class") T))
                  cands (set (:cut-candidates opts))]
              (doseq [n (embed/with-member-types (:cut-candidates opts) m/in-world?)
                      :when (or (not (m/in-world? n))
                                (and (m/hand-written? n)
                                     (not (contains? (:vars (:jrt m/*w*)) (str (m/go-name n) "_class")))))
                      ;; a member type whose Go name another class has (java.sql.Date) is left out
                      :when (or (contains? cands n)
                                (not (or (taken (m/go-name n)) (taken (str (m/go-name n) "_class"))
                                         (some #(and (not= % n) (= (m/go-name %) (m/go-name n))) @cuts))))]
                (swap! cuts conj n))))
            (swap! files assoc [pkg "j2g_cut.go"]
                   (vec (concat (out/cut-forms pkg (filter #(= pkg (m/pkg %)) @cuts))
                                ;; --program: the cut classes' members, throwing (EVAL-NOTES.md)
                                (when (:program opts)
                                  (out/cut-table-forms pkg @cuts (filter #(= pkg (m/pkg %)) @cuts))))))
            ;; the classes that replace jrt's stand-ins initialize at Go package initialization:
            ;; jrt's hand-written code reads their statics as the stand-ins' package variables
            ;; (J2G-NOTES.md, proposed amendment A3)
            (when (= pkg :jrt)
              (let [eager (sort (for [n T :let [j (get jc n)]
                                      :when (and j (:standin j) (a/decl n) (not (m/trivial-init? n))
                                                 (not (lazy-standins n))
                                                 (contains? (:reached res) [n "<clinit>" "()V"]))]
                                  n))]
                (when (seq eager)
                  (swap! files assoc [pkg "j2g_init.go"]
                         [(apply list 'go/func 'init []
                                 (for [n eager] (list (symbol (str (m/go-name n) "_Init")))))]))))
            (swap! files assoc [pkg "j2g_strings.go"] (vec (out/strings-forms pkg @(:lits ps))))
            (swap! files assoc [pkg "j2g_up.go"] (vec (out/ups-forms pkg @(:ups ps)))))
          (lap :packages)
          (let [t-trans (secs t2)
                ;; §4.4: duplicate Go names, package-private methods Go would override; §8.3
                collisions (chk/collisions @files scan)
                _ (lap :collisions)
                _ (doseq [c collisions]
                    (swap! errors conj [(str "Go name " (:name c)) (str "declared more than once in " (name (:pkg c)) ": " (str/join ", " (:sources c)))])
                    (println (str "j2g: error: Go name " (:name c) " declared more than once in package " (name (:pkg c)) ": " (str/join ", " (:sources c)))))
                pp-overrides (chk/package-private-overrides T)
                _ (lap :overrides)
                _ (doseq [o pp-overrides]
                    (swap! errors conj [(:method o) (str "package-private, redeclared by " (:hidden-by o) " in another package (J2G-SPEC §4.4: rename table)")])
                    (println (str "j2g: error: package-private " (:method o) " is redeclared by " (:hidden-by o) " in another Java package; Go would override it")))
                races (chk/race-report @c/*races*)
                _ (lap :checks)
                t3 (now)
                replaced (for [n T :let [j (get jc n)] :when (and j (:standin j))] n)
                ;; report.edn, but its times (report-of), printed beside the writing
                report-of (fn [times]
                            {:classes (count T) :reached (count (:reached res))
                             ;; the classes in the inputs, by Go package
                             :world (frequencies (map #(name (m/pkg %)) @(:order (:unit world))))
                             :methods-with-missing-parts (count (:unavailable res))
                             :translated (vec (sort T))
                             :replaced-standins (vec (sort replaced))
                             :unavailable (into (sorted-map) (for [[k v] (:unavailable res)] [(str/join " " k) (vec (sort v))]))
                             :missing (into (sorted-map) (for [[k v] (:missing res)] [k (count v)]))
                             :analysis-failures (:failed world)
                             :variants (:variants world)
                             :errors @errors
                             ;; §8.3, Q10: non-volatile fields of interface Go type written after
                             ;; construction without a lock
                             :race-candidates races
                             :package-private-overrides pp-overrides
                             :times times})
                report-text (future (report-str (report-of ::times)))
                ;; write the generated tree
                _ (when (.exists (io/file gen-dir)) (doseq [f (reverse (file-seq (io/file gen-dir)))] (io/delete-file f true)))
                ;; the files' texts computed in parallel, written in order
                to-write (vec (for [[[pkg fname] forms] (sort @files)
                                    :when (seq forms)]
                                [pkg fname forms]))
                texts (binding [out/*renames* @lit-renames]
                        (m/par-mapv (m/jobs) (fn [[pkg fname forms]] (out/file-text pkg fname forms)) to-write
                                  ;; the files of most declarations first
                                  (sort-by #(- (count (nth (nth to-write %) 2))) (range (count to-write)))))
                _ (lap :texts)
                written (doall
                          (for [[[pkg fname _] text] (map vector to-write texts)]
                            (let [stem (subs fname 0 (- (count fname) 3))
                                  path (str gen-dir "/go/arbace/" (nm/pkg-name pkg) "/" stem ".ae")]
                              (write! path text)
                              [pkg fname stem text])))
                _ (lap :generated)
                ;; the program root: jrt's hand-written files (stand-ins filtered) and the generated ones
                _ (when (.exists (io/file prog-dir)) (doseq [f (reverse (file-seq (io/file prog-dir)))] (io/delete-file f true)))
                replaced-by-file (group-by #(:file (get jc %)) replaced)
                ;; a stand-in file all of whose classes are translated goes as a whole (its
                ;; helpers refer to the stand-in's own shapes)
                whole-files (set (for [[fname defined] (group-by :file (vals jc))
                                       :when (and fname (str/starts-with? fname "standin_"))
                                       :when (every? (fn [j] (some #(= (:go j) (m/go-name %)) (get replaced-by-file fname))) defined)]
                                   fname))
                hw-files (sort (for [^java.io.File f (.listFiles (io/file jrt-dir))
                                     :let [nme (.getName f)]
                                     :when (and (str/ends-with? nme ".ae")
                                                (not (contains? whole-files nme))
                                                (or (:tests opts) (not (str/ends-with? nme "_test.ae"))))]
                                 nme))
                _ (doseq [fname hw-files]
                    (let [src (str jrt-dir "/" fname)
                          dst (str prog-dir "/go/arbace/jrt/" fname)
                          gs (map m/go-name (get replaced-by-file fname))]
                      (if (seq gs)
                        (let [forms (filter-standins* (gp/read-forms src) gs)
                              text (str ";; j2g: " fname " without the classes j2g translates: " (str/join ", " (sort gs)) "\n"
                                        (str/join "\n\n" (map out/form-text forms)) "\n")]
                          (write! dst text))
                        (copy-file! src dst))))
                ;; goi's back end, hand-written Go forms as jrt's (doc/go/GOI-SPEC.md §1.3): the
                ;; package arbace/goi, whose natives arbace.lang.GoInterp's are (S32)
                _ (when (.isFile (io/file "go/arbace/goi.ae"))
                    (copy-file! "go/arbace/goi.ae" (str prog-dir "/go/arbace/goi.ae"))
                    (doseq [^java.io.File f (sort (.listFiles (io/file "go/arbace/goi")))
                            :when (str/ends-with? (.getName f) ".ae")]
                      (copy-file! f (str prog-dir "/go/arbace/goi/" (.getName f)))))
                ;; the package arbace, Go forms' API to Arbace (GOI-SPEC.md §7.3, GR5), which goi
                ;; imports and the table lists
                _ (when (.isFile (io/file "go/arbace.ae"))
                    (copy-file! "go/arbace.ae" (str prog-dir "/go/arbace.ae"))
                    (copy-file! "go/arbace/api.ae" (str prog-dir "/go/arbace/api.ae")))
                ;; repr/go's native reader's packages, which the table lists (GP7,
                ;; doc/go/GO-PARSER-SURVEY.md): the dumper, gc's syntax errors' driver and the
                ;; renamed copy of gc's syntax it imports, under go/arbace/repr/
                _ (doseq [^java.io.File f (sort-by #(.getPath ^java.io.File %) (file-seq (io/file "go/arbace/repr")))
                          :when (and (.isFile f) (str/ends-with? (.getName f) ".ae"))]
                    (copy-file! f (str prog-dir "/" (.getPath f))))
                ;; goi's table (--gotable DIR: bin/goi table's output), its files as they are
                _ (when-let [gt (:gotable opts)]
                    (copy-file! (io/file gt "go/arbace/gotable.ae") (str prog-dir "/go/arbace/gotable.ae"))
                    (doseq [^java.io.File f (sort (.listFiles (io/file gt "go/arbace/gotable")))
                            :when (.isFile f)]
                      (copy-file! f (str prog-dir "/go/arbace/gotable/" (.getName f)))))
                _ (lap :hand-written)
                ;; data files jrt embeds or copies (none expected besides forms)
                gen-jrt (sort (for [[pkg _ stem] written :when (= pkg :jrt)] stem))
                gen-lang (sort (for [[pkg _ stem] written :when (= pkg :lang)] stem))
                ;; the generated files, as written in gen-dir
                _ (doseq [[pkg _ stem text] written]
                    (write! (str prog-dir "/go/arbace/" (nm/pkg-name pkg) "/" stem ".ae") text))
                hw-stems (map #(subs % 0 (- (count %) 3)) hw-files)
                go-names (fn [stems] (vec (sort (map #(str % ".go") stems))))
                jrt-stems (concat (remove #(str/ends-with? % "_test") hw-stems) gen-jrt)
                jrt-tests (filter #(str/ends-with? % "_test") hw-stems)]
            (write! (str prog-dir "/go/arbace/jrt.ae")
                    (str ";; Generated by j2g: jrt's hand-written files and j2g's translation (J2G-SPEC §4.3).\n"
                         (out/form-text '(ns go.arbace.jrt (:require [arbace.go :as go]))) "\n\n"
                         (out/form-text (apply list 'go/package 'jrt :path "arbace/jrt" :files (go-names jrt-stems)
                                               (when (seq jrt-tests) [:test-files (go-names jrt-tests)]))) "\n\n"
                         (str/join "\n" (for [s (sort (concat jrt-stems jrt-tests))] (out/form-text (list 'load (str "jrt/" s)))))
                         "\n"))
            (doseq [pkg (rest pkgs)
                    :let [stems (sort (for [[p _ stem] written :when (= p pkg)] stem))
                          pn (nm/pkg-name pkg)]
                    :when (seq stems)]
              (write! (str prog-dir "/go/arbace/" pn ".ae")
                      (str ";; Generated by j2g (J2G-SPEC §4.2): the package " (nm/pkg-path pkg) ".\n"
                           (out/form-text (list 'ns (symbol (nm/pkg-ns pkg)) '(:require [arbace.go :as go]))) "\n\n"
                           (out/form-text (list 'go/package (symbol pn) :path (nm/pkg-path pkg) :files (go-names stems))) "\n\n"
                           (str/join "\n" (for [s stems] (out/form-text (list 'load (str pn "/" s)))))
                           "\n")))
            (write! (str prog-dir "/program.edn") "{:module \"arbace\" :go \"1.27\"}\n")
            (when (:program opts)
              ;; the generic signatures of the world, for the Java forms' analysis
              ;; (doc/go/CLASSFORMS-REPL.md)
              ;; the embedded namespaces, for bin/arbace-go's image (a source with a line
              ;; that begins (ns), as named by its path)
              (write! (str prog-dir "/namespaces.txt")
                      (str/join (for [[p text] (sort (:embedded opts))
                                      :when (and (str/starts-with? p "arbace/") (str/ends-with? p ".ae") (re-find #"(?m)^\(ns( |$)" text))]
                                  (str (-> (subs p 0 (- (count p) 3)) (str/replace "/" ".") (str/replace "_" "-")) "\n"))))
              (let [res-dir (str prog-dir "/go/arbace/cmd/arbace/res")
                    written (write-resources!
                              res-dir
                              (concat
                                (for [[p text] (cond-> (:embedded opts)
                                                 (dyncf/enabled?) (assoc "arbace/classes/generics.edn" (dyncf/generics-text T)))]
                                  [p #(.getBytes ^String text "UTF-8")])
                                (for [[p f] (:embedded-data opts)]
                                  [p #(java.nio.file.Files/readAllBytes (.toPath (io/file f)))])))
                    _ (lap :resources)]
                (write! (str prog-dir "/go/arbace/cmd/arbace.ae")
                        (str ";; Generated by j2g --program (J2G-SPEC §10.6): the program's main package.\n"
                             (str/join "\n" (map out/form-text (program-package-forms (sort written))))
                             "\n")))
              ;; the sources are data to repr/go, not forms
              (write! (str prog-dir "/go/arbace/cmd/arbace/res/.build-go-data")
                      "The main package's embedded sources (j2g --program): data, not Go forms.\n")
              (write! (str prog-dir "/go/arbace/cmd/arbace/main.ae")
                      (str ";; Generated by j2g --program (J2G-SPEC §10.6).\n(in-ns 'go.arbace.cmd.arbace)\n\n"
                           (str/join "\n\n" (map out/form-text (program-main-forms (some? (:gotable opts)) (:entry opts) (:entry-args opts)))) "\n"))
              ;; the image of prepared namespaces (EXEC-NOTES.md): its encoding (hand-written
              ;; forms of the main package), the program's types, and an empty image, which
              ;; bin/arbace-go --build replaces
              (copy-file! (io/file root-dir embed/image-forms) (str prog-dir "/go/arbace/cmd/arbace/image.ae"))
              ;; the REPL under rlwrap (EXEC-NOTES.md): hand-written forms of the main package
              (doseq [f embed/rlwrap-forms]
                (copy-file! (io/file root-dir f) (str prog-dir "/go/arbace/cmd/arbace/" (.getName (io/file f)))))
              (write! (str prog-dir "/go/arbace/cmd/arbace/image_types.ae")
                      (str ";; Generated by j2g --program: the program's struct types, by name (EXEC-NOTES.md).\n"
                           "(in-ns 'go.arbace.cmd.arbace)\n\n"
                           (str/join "\n\n" (map out/form-text (embed/image-type-forms prog-dir))) "\n"))
              (write! (str prog-dir "/go/arbace/cmd/arbace/image.bin") "")
              (lap :image-types))
            (doseq [mdir (:mains opts)]
              (doseq [^java.io.File f (file-seq (io/file mdir))
                      :when (.isFile f)
                      :let [rel (str (.relativize (.toPath (.getCanonicalFile (io/file mdir))) (.toPath (.getCanonicalFile f))))]]
                (copy-file! f (str prog-dir "/" rel))))
            ;; the caller's additions to the program root, once it is complete
            (when-let [after (:after opts)]
              (after {:prog-dir prog-dir :T T :res res :world world}))
            (let [report (report-of {:load t-load :reach t-reach :translate t-trans :write (secs t3)
                                     :steps (do (lap :files) @steps)})]
              ;; the text printed beside the writing, its times put in
              (write! (str (:out opts) "/report.edn")
                      (str/replace @report-text (str ::times) (pr-str (:times report))))
              (println (str "j2g: steps (s): " (str/join ", " (for [[k v] @steps] (str (name k) " " v)))
                            " (" (m/jobs) " jobs)"))
              (println (str "j2g: translated in " t-trans " s, written in " (secs t3) " s: "
                            (count written) " files; program root " prog-dir))
              (println (str "j2g: " (reduce + (map count (vals races))) " candidate two-word race fields in "
                            (count races) " classes (report.edn :race-candidates); "
                            (count collisions) " name collisions, " (count pp-overrides) " package-private overrides"))
              report)))))))

(def id-floor
  "Where the runtime's id counter (RT/nextID, gensym's) stands when j2g's run starts. The
  analyzer and the translator name temporaries by it (arr_100417), so j2g first advances it to
  this fixed value: its output then depends on its inputs, not on how much code the running
  Arbace compiled before (j2g's own namespaces load from source, and on the Go executable in
  other amounts than on the JVM). A round value well above what loading j2g takes
  (doc/STANDALONE-NOTES.md, SA13)."
  100000)

(defn- advance-ids!
  "Advances the runtime's id counter to id-floor (an error when it is past it already)."
  []
  (let [v (arbace.lang.RT/nextID)]
    (when (>= v (dec id-floor))
      (throw (ex-info (str "j2g: the runtime's id counter (" v ") is at j2g's id-floor (" id-floor
                           ") already: raise it (j2g's output then names its temporaries afresh)") {})))
    (loop [x v] (when (< x (dec id-floor)) (recur (arbace.lang.RT/nextID))))))

(defn run
  "j2g's run (bin/j2g's options as parse-args gives them). The classes outside the forms come
  from the edge (--edge, default jdk/edge.edn: doc/STANDALONE-NOTES.md, S2), without the JVM's
  reflection or ASM; --record-edge FILE: from the JVM's reflection, writing the edge of what
  this run asked into FILE; --jvm-reflection: from the JVM's reflection (the edge unused)."
  [opts]
  (advance-ids!)
  (cond
    (:record-edge opts)
    (let [env-rec (atom {})
          j2g-rec (atom {})
          report (binding [env/*recorded* env-rec edge/*recording* j2g-rec]
                   (run* opts))]
      (edge/write-edge! (:record-edge opts) (edge/recorded-edge @env-rec @j2g-rec))
      (println (str "j2g: the edge of this run in " (:record-edge opts) ": " (count @env-rec) " classes"))
      report)

    (:jvm-reflection opts)
    (run* opts)

    :else
    (let [t0 (now)
          fs (or (seq (:edges opts)) [default-edge])
          _ (doseq [f fs]
              (when-not (.isFile (io/file f))
                (throw (ex-info (str "j2g: no edge " f " (bin/j2g-edge update, or --jvm-reflection)") {}))))
          e (apply edge/read-edge fs)]
      (println (str "j2g: the edge " (str/join " + " fs) ": " (count (:classes e)) " classes, read in " (secs t0) " s"))
      (binding [env/*declared* (:classes e)
                edge/*edge* e
                ;; no Java forms sources from the class path (§9.2), as on the Go build
                a/*source-lookup* false]
        (run* opts)))))

(defn -main [& args]
  (let [opts (parse-args args)
        report (run opts)]
    (shutdown-agents)
    (System/exit (if (seq (:errors report)) 1 0))))

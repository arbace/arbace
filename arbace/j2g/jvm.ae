(ns arbace.j2g.jvm
  "j2g's questions that only the JVM can answer and that name classes only the JVM has (its
  module layer), asked when j2g records the edge (--record-edge) or runs without it
  (--jvm-reflection; arbace.j2g.edge/jvm?). Loaded on demand (requiring-resolve), so that j2g's
  own namespaces load on the Go executable, which has no modules (doc/STANDALONE-NOTES.md, S3).")

(def ^:private boot-packages
  (delay (into {} (for [^java.lang.Module m (.modules (ModuleLayer/boot)) p (.getPackages m)] [p m]))))

(defn unexported?
  "Is package pkg (dotted) in a JDK module that does not export it (jdk.internal.misc,
  sun.nio.cs ...)?"
  [pkg]
  (when-let [^java.lang.Module m (get @boot-packages pkg)]
    (not (.isExported m pkg))))


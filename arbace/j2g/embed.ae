(ns arbace.j2g.embed
  "bin/j2g --program: the namespaces' sources the executable embeds (J2G-SPEC §10.3, §10.6;
  doc/go/EVAL-NOTES.md, \"Loading\"), and the classes they name that are outside the closed
  world (registered as cut classes, so that imports and hints resolve).

  The embedded tree is arbace/**/*.ae less the JVM-side tools (repr/java, j2g's and the class
  forms' JVM-only parts), the runtime's Java forms (arbace/lang, compiled into the program), and
  the namespaces the Go build leaves out (JAVA-SURFACE.md decision 6, B1-PLAN.md D6). The Go build's namespace
  variants, arbace/lang/go/ns/P.ae, replace arbace/P.ae; arbace/lang/go/ns/P.after.ae is
  appended to it; arbace/lang/go/ns/P.subst.ae, a vector [old new ...] of strings, replaces
  each old (found exactly once) in it."
  (:require [arbace.string :as str]
            [arbace.java.io :as io]
            [arbace.j2g.edge :as edge]
            [arbace.j2g.model :as m])
  (:import (java.io File PushbackReader StringReader)
           (arbace.lang LispReader$Resolver)))

(def excluded
  "Resource paths (prefixes) not embedded."
  [;; of the Java forms compiler, the analysis and the interpreter are embedded
   ;; (doc/go/CLASSFORMS-REPL.md): not the class file reader of the JVM's edge recording
   ;; repr/java needs javac; j2g's questions to the JVM (the edge's recording, SA23). The tools j2g,
   ;; repr/go, arbace.build.go, repr/clojure and c2j are embedded and compiled with the program
   ;; (standalone S6, doc/STANDALONE-NOTES.md, SA133)
   "arbace/classes/jvm.ae" "arbace/repr/java.ae" "arbace/repr/java/" "arbace/j2g/jvm.ae" "arbace/lang/"
   ;; repr/haskell (its helper on the host's GHC) runs evaluated from the checkout, not embedded
   ;; (doc/haskell/HASKELL-NOTES.md)
   "arbace/repr/haskell.ae" "arbace/repr/haskell/"
   ;; repr/rust (its helper on the host's rustc) likewise (doc/rust/RUST-NOTES.md)
   "arbace/repr/rust.ae" "arbace/repr/rust/"
   ;; goi (doc/go/GOI-SPEC.md): arbace.go (the table's namespaces, GR1; the macros of Go forms,
   ;; GR3), the checker (§3, GR2), the builder, the REPL's state and program runs (GR3) are
   ;; embedded, the program's; the table's generator (§6.3, GR1), a tool of the build, runs
   ;; evaluated from the checkout
   "arbace/go/table.ae"
   "arbace/lang.ae" "arbace/java/api"
   ;; decision 6: URLs, browsers (sockets, arbace.core.server, are in since 2026-10-09:
   ;; JRT-NOTES.md, "Sockets"; processes, arbace.java.process and arbace.java.shell, since
   ;; 2026-10-10: JRT-NOTES.md, "Processes")
   "arbace/repl/deps.ae" "arbace/java/basis" "arbace/tools/deps/"
   ;; arbace.java.browse, arbace.java.javadoc, arbace.inspector (Swing) and arbace.xml (SAX) are
   ;; embedded since REAP4 (SL5, the user's RPS18 (b)): the classes they name are cut
   ;; (arbace.java.browse-ui, which browse requires to open a Swing window, is not restored)
   ;; loaded by arbace/instant.ae, whose Go variant holds java.sql.Timestamp's part itself
   "arbace/instant_timestamp.ae"])

(def variants-dir "arbace/lang/go/ns")

(defn sources
  "The embedded sources: {resource-path text}, from the checkout at root; the excluded paths that
  begin with one of `also` (j2g --embed: javac's tool embeds repr/java's reader,
  doc/classes/JAVA-FRONTEND-SURVEY.md, \"As built: JN4\") embedded too."
  [root & [also]]
  (let [base (io/file root "arbace")
        files (for [^File f (file-seq base)
                    :when (and (.isFile f) (str/ends-with? (.getName f) ".ae"))
                    :let [rel (str "arbace/" (str (.relativize (.toPath base) (.toPath f))))]
                    :when (or (not-any? #(str/starts-with? rel %) excluded)
                              (some #(str/starts-with? rel %) also))]
                [rel (slurp f)])
        vdir (io/file root variants-dir)
        variants (when (.isDirectory vdir)
                   (for [^File f (file-seq vdir)
                         :when (and (.isFile f) (str/ends-with? (.getName f) ".ae"))]
                     [(str (.relativize (.toPath vdir) (.toPath f))) (slurp f)]))]
    (reduce (fn [m [rel text]]
              (cond
                ;; P.subst.ae: [old new ...], each old found exactly once in arbace/P.ae
                (str/ends-with? rel ".subst.ae")
                (let [p (str "arbace/" (subs rel 0 (- (count rel) (count ".subst.ae"))) ".ae")
                      pairs (partition 2 (read-string text))]
                  (when-not (contains? m p)
                    (throw (ex-info (str "j2g: namespace variant " rel ": no " p) {})))
                  (update m p (fn [^String src]
                                (reduce (fn [^String src [^String old new]]
                                          (let [i (.indexOf src old)]
                                            (when (or (neg? i) (not= i (.lastIndexOf src old)))
                                              (throw (ex-info (str "j2g: namespace variant " rel ": "
                                                                   (pr-str old) " not found exactly once in " p) {})))
                                            (str (subs src 0 i) new (subs src (+ i (count old))))))
                                        src pairs))))
                (str/ends-with? rel ".after.ae")
                (let [p (str "arbace/" (subs rel 0 (- (count rel) (count ".after.ae"))) ".ae")]
                  (when-not (contains? m p)
                    (throw (ex-info (str "j2g: namespace variant " rel ": no " p) {})))
                  (update m p str text))
                :else (assoc m (str "arbace/" rel) text)))
            (into (sorted-map) files)
            (sort-by first variants))))

;; ---------------------------------------------------------------------------------------
;; The classes the sources name

(def ^:private resolver
  "Reads ::kw and `sym without the namespaces' aliases (only class names are wanted)."
  (reify LispReader$Resolver
    (currentNS [_] 'user)
    (resolveClass [_ s] s)
    (resolveAlias [_ s] s)
    (resolveVar [_ s] s)))

(defn- read-all [text]
  (let [r (PushbackReader. (StringReader. text))]
    (binding [*read-eval* false
              *reader-resolver* resolver
              *default-data-reader-fn* (fn [_ v] v)]
      (loop [acc []]
        (let [f (read {:eof ::eof :read-cond :allow} r)]
          (if (= f ::eof) acc (recur (conj acc f))))))))

(defn- class-like? [^String s]
  (let [i (.lastIndexOf s ".")]
    (and (pos? i) (< (inc i) (count s)) (Character/isUpperCase (.charAt s (inc i))))))

(defn- package-like? [^String s]
  (and (pos? (.indexOf s ".")) (not (class-like? s))))

(defn names
  "The class names (binary, dotted) the forms of text mention: qualified symbols, the
  namespace of a qualified symbol, and import lists (pkg Name ...)."
  [text]
  (let [acc (transient #{})
        walk (fn walk [x]
               (when-let [m (meta x)] (walk m))
               (cond
                 (symbol? x)
                 (do (when (and (nil? (namespace x)) (class-like? (name x)))
                       (conj! acc (name x)))
                     (when (and (namespace x) (class-like? (namespace x)))
                       (conj! acc (namespace x))))
                 (or (seq? x) (vector? x))
                 (do (when (and (symbol? (first x)) (nil? (namespace (first x)))
                                (package-like? (name (first x))) (seq (rest x))
                                (every? symbol? (rest x)))
                       (doseq [c (rest x)] (conj! acc (str (first x) "." c))))
                     (doseq [y x] (walk y)))
                 (map? x) (doseq [[k v] x] (walk k) (walk v))
                 (set? x) (doseq [y x] (walk y))))]
    (doseq [f (read-all text)] (walk f))
    (persistent! acc)))

(def library-cuts
  "Classes outside the world that libraries loaded from ARBACE_PATH import, cut as those the
  embedded sources name are: Clojure's suite's test.generative runner requires
  clojure.tools.namespace.find and clojure.java.classpath, which import java.util.jar's JarFile
  and JarEntry and java.io.FileReader (the runner then lists no jars, and reads no files through
  them); clojure.tools.reader names java.text.SimpleDateFormat (its #inst reader's formatter).
  (java.net.URLClassLoader, which clojure.java.classpath extends, is in the world since
  JRT-NOTES.md's \"Resources by URL\".)"
  ["java.util.jar.JarFile" "java.util.jar.JarEntry" "java.io.FileReader"
   "java.text.SimpleDateFormat"])

(defn cut-candidates
  "The classes the sources name that exist on this JVM (the edge's :exists), from the JDK or arbace.lang
  (not the classes the namespaces define themselves: deftype, defrecord, definterface), as
  internal names; and library-cuts."
  [srcs]
  (set (for [n (concat (apply concat (m/par-mapv (m/jobs) (fn [[_ text]] (names text)) srcs)) library-cuts)
             ;; the JDK's packages, org.xml.sax and org.w3c.dom (java.xml's: arbace.xml) among them
             :when (and (or (re-find #"^(java|javax|jdk|sun|org\.xml\.sax|org\.w3c\.dom)\." n)
                            (re-find #"^arbace\.lang\." n))
                        ;; on this JVM (the edge's :exists)
                        (edge/jvm? :exists n
                                   #(try (Class/forName n false (ClassLoader/getSystemClassLoader)) true
                                         (catch Throwable _ false))))]
         (str/replace n "." "/"))))

(defn with-member-types
  "The cut candidates (internal names) and the JDK classes their public members name that are
  outside the world (in-world?), one level deep: the cut classes' member tables then name them
  (Files/createTempFile returns a Path)."
  [cands in-world?]
  (let [types (fn [^Class c]
                (concat (mapcat (fn [^java.lang.reflect.Method m] (cons (.getReturnType m) (.getParameterTypes m))) (.getMethods c))
                        (map (fn [^java.lang.reflect.Field f] (.getType f)) (.getFields c))
                        (mapcat (fn [^java.lang.reflect.Constructor k] (.getParameterTypes k)) (.getConstructors c))))
        elem (fn [^Class c] (if (.isArray c) (recur (.getComponentType c)) c))
        ;; the JDK's public classes the members of class n name (the edge's :member-types)
        member-types (fn [n]
                       (when-let [c (try (Class/forName (str/replace n "/" ".") false (ClassLoader/getSystemClassLoader))
                                         (catch Throwable _ nil))]
                         (vec (sort (distinct
                                      (for [^Class t (map elem (types c))
                                            :when (not (.isPrimitive t))
                                            :let [tn (str/replace (.getName t) "." "/")]
                                            :when (and (re-find #"^(java|javax|jdk|sun|org/xml/sax|org/w3c/dom)/" tn)
                                                       (java.lang.reflect.Modifier/isPublic (.getModifiers t)))]
                                        tn))))))
        more (for [n cands
                   :when (not (in-world? n))
                   tn (edge/jvm :member-types n #(member-types n))
                   :when (not (in-world? tn))]
               tn)]
    (sort (distinct (concat cands more)))))

;; ---------------------------------------------------------------------------------------
;; The JDK's resource data

(defn data
  "The resource data the executable embeds besides the sources (JRT-NOTES.md, \"The JDK's
  resource data\"): the files under dir (bin/jrt-convert's .tmp/jrt/data: uniName.dat, ICU's
  normalization data), {resource-path File}, sorted; empty when dir does not exist."
  [dir]
  (let [base (io/file dir)]
    (into (sorted-map)
          (when (.isDirectory base)
            (for [^File f (file-seq base)
                  :when (.isFile f)]
              [(str/replace (str (.relativize (.toPath base) (.toPath f))) File/separator "/") f])))))

(defn user-resources
  "j2g --resources (bin/arbace-go --build-program, REAP7): a user's program's directories, each
  DIR or DIR=PREFIX, embedded as directories of the class path: every file under DIR (but those
  whose name begins with a dot) at its path relative to DIR, after PREFIX/ when given. [srcs
  data]: the sources (.ae, .clj, .cljc), {resource-path text}, which join the embedded sources,
  and the other files, {resource-path File}, which join the resource data. A path that taken
  (the program's own sources and data) or another DIR holds already is an error."
  [specs taken]
  (loop [[spec & more] specs srcs (sorted-map) data (sorted-map)]
    (if (nil? spec)
      [srcs data]
      (let [i (.lastIndexOf ^String spec "=")
            [dir prefix] (if (pos? i) [(subs spec 0 i) (subs spec (inc i))] [spec nil])
            base (io/file dir)
            _ (when-not (.isDirectory base)
                (throw (ex-info (str "j2g: --resources " spec ": no directory " dir) {})))
            files (for [^File f (sort (file-seq base))
                        :when (and (.isFile f) (not (str/starts-with? (.getName f) ".")))
                        :let [rel (str/replace (str (.relativize (.toPath base) (.toPath f))) File/separator "/")]]
                    [(if (seq prefix) (str prefix "/" rel) rel) f])
            [srcs data] (reduce (fn [[srcs data] [p ^File f]]
                                  (when (or (contains? taken p) (contains? srcs p) (contains? data p))
                                    (throw (ex-info (str "j2g: --resources " spec ": " p " is embedded already") {})))
                                  (if (re-find #"\.(ae|clj|cljc)$" p)
                                    [(assoc srcs p (slurp f)) data]
                                    [srcs (assoc data p f)]))
                                [srcs data] files)]
        (recur more srcs data)))))

(defn package-loaders
  "j2g --java-namespaces (bin/arbace-go --build-program, REAP7b, RPS93 (c)): the namespaces of
  the Java packages under each DIR (SPEC.md §9.2: a package's file, its first form (ns P)),
  {path text}, each a no-op loader (ns P) at its path: the package's classes are the program's,
  so that a (require 'P) written at the REPL works unchanged. A path taken is left as it is."
  [dirs taken]
  (into (sorted-map)
        (for [dir dirs
              :let [base (io/file dir)]
              ^File f (sort (file-seq base))
              :when (and (.isFile f) (str/ends-with? (.getName f) ".ae"))
              :let [rel (str/replace (str (.relativize (.toPath base) (.toPath f))) File/separator "/")
                    m (re-find #"(?m)^\(ns\s+([^\s()]+)" (slurp f))]
              :when (and m (not (contains? taken rel)))]
          [rel (str ";; j2g --java-namespaces: the Java package " (second m) "'s namespace, a no-op loader\n"
                    ";; (its classes are the program's; bin/arbace-go --build-program, RPS93).\n"
                    "(ns " (second m) ")\n")])))

;; ---------------------------------------------------------------------------------------
;; The image of prepared namespaces (doc/go/EXEC-NOTES.md): its encoding is hand-written forms
;; of the main package; decoding makes objects of the program's struct types by name, so the
;; main package lists them

(def image-forms
  "The image's encoding: Go forms of the main package, copied into the program."
  "go/arbace/cmd/arbace/image.ae")

(def rlwrap-forms
  "The interactive REPL under rlwrap (EXEC-NOTES.md, \"Line editing: rlwrap\"): Go forms of the
  main package, copied into the program, Linux's and the other systems' (an empty execRlwrap)."
  ["go/arbace/cmd/arbace/rlwrap_linux.ae" "go/arbace/cmd/arbace/rlwrap_other.ae"])

(defn image-type-forms
  "The main package's table of the program's struct types (image_types.go): every exported,
  non-generic struct type of arbace/lang and arbace/jrt, as declared by the forms under
  prog-dir, registered by name for the image's decoder."
  [prog-dir]
  (let [re #"\(go/type ([A-Z][A-Za-z0-9_]*)\s+(?:\"(?:[^\"\\]|\\.)*\"\s+)?\(struct[ )]"
        files (for [[pkg alias] [["lang" "lang"] ["jrt" "jrt"]]
                    :let [dir (io/file prog-dir "go/arbace" pkg)]
                    ^File f (sort (.listFiles dir))
                    :when (and (.isFile f) (str/ends-with? (.getName f) ".ae")
                               (not (str/ends-with? (.getName f) "_test.ae")))]
                [alias f])
        ;; the files scanned in parallel
        types (apply concat (m/par-mapv (m/jobs) (fn [[alias f]] (vec (for [[_ n] (re-seq re (slurp f))] (symbol alias n))))
                                        files))]
    ;; in parts of 128, each an init function: one function of the 2,500 types made 2.5 MB of
    ;; gc's stack maps (amendment SA153)
    (into [(list 'go/file "image_types.go" :imports '[[reflect "reflect"] [jrt "arbace/jrt"] [lang "arbace/lang"]])]
          (for [part (partition-all 128 (sort-by str (distinct types)))]
            (list 'go/func 'init []
                  (list 'registerImageTypes
                        (apply list 'lit '(slice reflect/Type)
                               (for [t part]
                                 (list 'reflect/TypeOf (list 'lit t))))))))))

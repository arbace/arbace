(ns arbace.j2g.names
  "j2g's names (doc/go/J2G-SPEC.md §4.2, §4.4): Go packages of Java classes, Go identifiers of
  classes, members and locals, the descriptor codes of mangled method names, and the Go type of
  a Java type (§5.1) given the class facts of the closed world."
  (:require [arbace.string :as str]
            [arbace.classes.types :as t]))

;; ---------------------------------------------------------------------------------------
;; Go packages (§4.2)

(def compiled-packages
  "The Go packages of compiled namespaces' classes (standalone S6, SA142): top-level class
  (internal name) → package name, from the packages.edn of the inputs (arbace.c2j's tree);
  set once by j2g's run, before any translation."
  (atom {}))

(defn- top-of [^String n] (let [i (.indexOf n "$")] (if (neg? i) n (subs n 0 i))))

(defn pkg-of
  "The Go package of a class (internal name): :jrt for the JDK's packages (java, javax, jdk,
  sun, and com.sun since the SunJCE provider: amendment SC3; org.xml and org.w3c, java.xml's, and
  build.tools, the JDK build's tools, in javac's tool build since JN7; compileproperties and
  propertiesparser, the JDK build's langtools tools, since JFS48 (b), and flagsgenerator, the third
  of them, since JFS52 (b)), a compiled namespace's own
  (compiled-packages: a keyword of its package name), else :lang for Arbace's."
  [internal]
  (cond
    (or (str/starts-with? internal "java/") (str/starts-with? internal "jdk/")
        (str/starts-with? internal "sun/") (str/starts-with? internal "javax/")
        (str/starts-with? internal "com/sun/") (str/starts-with? internal "org/xml/")
        (str/starts-with? internal "org/w3c/") (str/starts-with? internal "build/tools/")
        (str/starts-with? internal "compileproperties/") (str/starts-with? internal "propertiesparser/")
        (str/starts-with? internal "flagsgenerator/")) :jrt
    :else (if-let [p (get @compiled-packages (top-of internal))] (keyword p) :lang)))

(defn compiled-pkg? [pkg] (not (#{:jrt :lang} pkg)))

(defn pkg-name [pkg] (name pkg))
(defn pkg-path [pkg] (str "arbace/" (name pkg)))
(defn pkg-ns [pkg] (str "go.arbace." (name pkg)))

;; ---------------------------------------------------------------------------------------
;; munging

(def go-keywords
  #{"break" "case" "chan" "const" "continue" "default" "defer" "else" "fallthrough" "for"
    "func" "go" "goto" "if" "import" "interface" "map" "package" "range" "return" "select"
    "struct" "switch" "type" "var"})

(def go-predeclared
  #{"any" "bool" "byte" "comparable" "complex64" "complex128" "error" "float32" "float64" "int"
    "int8" "int16" "int32" "int64" "rune" "string" "uint" "uint8" "uint16" "uint32" "uint64"
    "uintptr" "true" "false" "iota" "nil" "append" "cap" "clear" "close" "complex" "copy"
    "delete" "imag" "len" "make" "max" "min" "new" "panic" "print" "println" "real" "recover"})

(def reserved-locals
  "Names j2g's generated code uses for itself (receivers, imports, temporaries)."
  #{"t" "this" "jrt" "math" "atomic" "reflect" "unsafe" "lang" "exc" "ctl" "rv" "_"})

(defn- memo-str
  "f of one string argument, its results kept (j2g's names are asked for again and again,
  from every thread translating)."
  [f]
  (let [cache (java.util.concurrent.ConcurrentHashMap.)]
    (fn [^String k]
      (or (.get cache k)
          (let [v (f k)]
            (.put cache k v)
            v)))))

(def ^:private munge-name*
  (memo-str
    (fn [s]
      (let [m (str/replace (str (munge s)) "$" "_")]
        ;; munge leaves characters Go rejects that Clojure allows in symbols only rarely;
        ;; anything else not a letter, digit or _ becomes _
        (apply str (map (fn [c] (if (or (Character/isLetterOrDigit (char c)) (= c \_)) c \_)) m))))))

(defn munge-name
  "A Java or Clojure name as a Go identifier fragment: Clojure's munge, $ as _."
  [s]
  (munge-name* (str s)))

(defn local-name
  "The Go name of a Java local or parameter (§4.4): munged, with _ appended when it would be a
  Go keyword, a predeclared or reserved name, or would start with an upper-case letter (which
  could shadow a type of the package)."
  [sym]
  (let [s (munge-name (name sym))
        s (if (str/blank? s) "x" s)]
    (if (or (go-keywords s) (go-predeclared s) (reserved-locals s)
            (Character/isUpperCase (.charAt ^String s 0))
            (str/starts-with? s "j2g_") (re-matches #"tmp\d+.*" s) (re-matches #"[lL]\d+" s))
      (str s "_")
      s)))

;; ---------------------------------------------------------------------------------------
;; classes (§4.4)

(def renames
  "The rename table (§4.4, Collisions): classes whose Go name would collide with another of the
  closed world's or with jrt's own names."
  {;; jrt's byte[] is ByteArray (§5.9)
   "jdk/internal/util/ByteArray" "Jdk_ByteArray"
   ;; jrt's java.util.Date is Date (JRT-NOTES.md, phase 2B "Dates")
   "java/sql/Date" "Sql_Date"
   ;; java.util.Tripwire's twin in java.util.stream (step 5 phase 2B, streams)
   "java/util/stream/Tripwire" "Stream_Tripwire"
   ;; java.net.URLConnection's subclass in sun.net.www, and the URL handlers, all named Handler
   ;; (JRT-NOTES.md, "Files")
   "sun/net/www/URLConnection" "Www_URLConnection"
   "sun/net/www/protocol/file/Handler" "File_Handler"
   "sun/net/www/protocol/http/Handler" "Http_Handler"
   "sun/net/www/protocol/https/Handler" "Https_Handler"
   "sun/net/www/protocol/jar/Handler" "Jar_Handler"
   ;; jrt's java.lang.reflect.Proxy is Proxy; java.net.Proxy, which URL's members and
   ;; Socket(Proxy) name (JRT-NOTES.md, "Files", "Sockets")
   "java/net/Proxy" "Net_Proxy"
   ;; java.text.Normalizer's internal twin, which Pattern calls for combining classes
   ;; (JRT-NOTES.md, "The JDK's resource data")
   "sun/text/Normalizer" "Sun_Normalizer"
   ;; java.time.chrono.Era's namesake in sun.util.calendar, which ZoneInfo's calendars use
   ;; (JRT-NOTES.md, "Time")
   "sun/util/calendar/Era" "Calendar_Era"
   ;; java.lang.annotation.Annotation's namesake in java.text, an attribute value's wrapper
   ;; (JRT-NOTES.md, "Text and locales")
   "java/text/Annotation" "Text_Annotation"
   ;; java.security.SecureRandom's namesake in sun.security.provider, the SHA1PRNG
   ;; (JRT-NOTES.md, "Security", amendment SC2)
   "sun/security/provider/SecureRandom" "Sun_SecureRandom"
   ;; java.io.FileSystem's namesake in java.nio.file, in the world of javac's tool build (its
   ;; file manager names it; doc/classes/JAVA-FRONTEND-SURVEY.md, "As built: JN2")
   "java/nio/file/FileSystem" "Nio_FileSystem"})

(defn compiled-class?
  "Is class `internal` one of a namespace compiled to Java forms (standalone S6, arbace.c2j):
  Arbace's but not the runtime's (arbace/lang, the Java API), or one in a package of arbace.c2j's
  tree outside arbace/ (aot_..., compiled-packages: a user's namespace, bin/diffcheck's
  corpora; F2.6)?"
  [^String internal]
  (or (and (str/starts-with? internal "arbace/") (not (str/starts-with? internal "arbace/lang/"))
           (not (str/starts-with? internal "arbace/java/api/")))
      (when-let [^String p (get @compiled-packages (top-of internal))]
        (str/starts-with? p "aot_"))))

(def tool-module-prefixes
  "The packages of the tool's modules (doc/classes/JAVA-FRONTEND-SURVEY.md, JFS13 (a)): javac's
  jdk.compiler, java.compiler and jdk.internal.opt's CommandLine (jdk/javac/), and javac's
  command line on Arbace, jrt's own in jdk.compiler (jdk.internal.jrt.javac, JN3); and since JN7 the
  JDK build's tools bin/jrt-convert runs on the tool (build.tools) with java.xml's SAX parser
  (com.sun.org.apache.xerces, com.sun.xml.internal, javax.xml, jdk.xml.internal, org.w3c.dom,
  org.xml.sax: build.tools.tzdb's interim ZoneRules beside java.time.zone's); and since JFS48 (b)
  the langtools tools bin/javac-vendor runs on the tool (compileproperties, propertiesparser:
  make/langtools/tools, which generate jdk.compiler's resource bundles; and since JFS52 (b)
  flagsgenerator, FlagsEnum). Their classes are
  named by their whole binary name, Jv_...: their simple names collide with java.base's and with
  each other's (List, Type, Name, Flow, the two ReturnTrees, the two Scopes), in type names and
  in the descriptor codes of method names. A rule, not a table: the names do not depend on what
  else the world holds, and the shipped program, which holds none of these packages, keeps its
  names."
  ["com/sun/source/" "com/sun/tools/doclint/" "com/sun/tools/javac/" "sun/tools/serialver/"
   "javax/annotation/processing/" "javax/lang/model/" "javax/tools/" "jdk/internal/opt/"
   "jdk/internal/jrt/javac/"
   "build/tools/" "com/sun/org/apache/" "com/sun/xml/internal/" "javax/xml/" "jdk/xml/internal/"
   "org/w3c/dom/" "org/xml/sax/"
   "compileproperties/" "propertiesparser/" "flagsgenerator/"])

(def qualified-prefixes
  "Package prefixes named as the tool's modules are, beside them (j2g --qualify: a driver's
  package); set before the world is loaded."
  (atom []))

(defn qualified?
  "Is class `internal` named by its binary name (tool-module-prefixes, qualified-prefixes)?"
  [^String internal]
  (boolean (or (some #(str/starts-with? internal %) tool-module-prefixes)
               (some #(str/starts-with? internal %) @qualified-prefixes))))

(defn user-class?
  "Is class `internal` outside Arbace's runtime and the JDK (doc/classes/JAVA-CONFORMANCE-SURVEY.md,
  JCS15 (a), JC2): a class of package lang (pkg-of) that is not Arbace's (arbace/...): a user's Java
  forms, the conformance check's tests, diffcheck's corpora, the fixtures. Such classes are named by
  their binary name between J_ and _J, as compiled classes are between A_ and _A, and so are their Go files
  (out/go-file-name): two packages' Basics, or SuperClass and Superclass, never meet in lang, in
  type names, descriptor codes or (case-insensitively) file names."
  [^String internal]
  (and (= :lang (pkg-of internal)) (not (str/starts-with? internal "arbace/"))))

(declare go-class-name*)

(defn go-class-name
  "The Go type name of a class: its binary name after the package, $ as _; X prepended when it
  does not start with an upper-case letter. A class of the tool's modules (qualified?) is named by
  its whole binary name after Jv_, one outside the runtime and the JDK (user-class?, JCS15 (a))
  between J_ and _J (p.Main is J_p_Main_J). A compiled namespace's class (S6), in package lang
  with the runtime's, is named by its whole binary name between A_ and _A (arbace.core.Vec is
  A_arbace_core_Vec_A, the fn arbace.walk$walk A_arbace_walk_walk_A)."
  [internal]
  (go-class-name* internal))

(defn- go-class-name** [internal]
  (or (get renames internal)
  (when (qualified? internal)
    (str "Jv_" (munge-name (str/replace internal "/" "_"))))
  (when (user-class? internal)
    ;; _J at the end, as compiled classes' _A: j2g's suffixes (a static member's _Name, _New,
    ;; _class) cannot make another class's name (p.C's static b(short) and p.C$B's static s())
    (str "J_" (munge-name (str/replace internal "/" "_")) "_J"))
  (when (compiled-class? internal)
    ;; _A at the end: j2g's suffixes (_class, _New, _Init ...) cannot make another one's name
    (str "A_" (munge-name (str/replace internal "/" "_")) "_A"))
  (let [s (subs internal (inc (.lastIndexOf ^String internal "/")))
        s (munge-name s)]
    (if (and (seq s) (Character/isUpperCase (.charAt ^String s 0)))
      s
      (str "X" s)))))

(def ^:private go-class-name* (memo-str go-class-name**))

(defn capitalize [^String s]
  (if (empty? s) s (str (Character/toUpperCase (.charAt s 0)) (subs s 1))))

;; ---------------------------------------------------------------------------------------
;; descriptor codes (§4.4)

(def ^:private method-bases
  "[name desc] -> method-base's answer."
  (java.util.concurrent.ConcurrentHashMap.))

(defn desc-code
  "The code of a parameter or return descriptor in a mangled name."
  [d]
  (cond
    (t/array? d) (let [n (t/array-dims d)
                       e (subs d n)]
                   (str (desc-code e) n))
    (= d "Ljava/lang/Object;") "O"
    (t/class-desc? d) (go-class-name (t/desc->internal d))
    :else d))

(declare method-base*)

(defn method-base
  "The mangled method name without a class prefix: M_P1_..._Pn__R."
  [name desc]
  (let [^java.util.concurrent.ConcurrentHashMap c method-bases
        k [name desc]]
    (or (.get c k)
        (let [v (method-base* name desc)]
          (.put c k v)
          v))))

(defn- method-base* [name desc]
  (let [[ps r] (t/parse-method-desc desc)
        m (capitalize (munge-name name))
        m (if (str/starts-with? m "_") (str "X" m) m)]
    (str m (apply str (map #(str "_" (desc-code %)) ps)) "__" (desc-code r))))

(defn ctor-base
  "Ctor_P1_..._Pn, or Ctor; desc is the constructor's full descriptor (implicit parameters
  included)."
  [desc]
  (let [[ps _] (t/parse-method-desc desc)]
    (str "Ctor" (apply str (map #(str "_" (desc-code %)) ps)))))

(defn new-name
  "C_New_P1_..._Pn, or C_New."
  [cls-go desc]
  (let [[ps _] (t/parse-method-desc desc)]
    (str cls-go "_New" (apply str (map #(str "_" (desc-code %)) ps)))))

(defn field-name [fname] (str "F_" (munge-name fname)))

(def ^:private derived-suffix
  "The suffixes j2g derives package members of a class C from (§4.4's package members): C_class,
  C_Init and its state C_init, C_clinit and its parts C_clinit_pK, C_I, C_InstanceOf, C_Cast,
  C_members, C_New..., C_Fn... (an enum's C__VALUES is its field $VALUES, not a derived name)."
  #"class|Init|init|clinit|clinit_p\d+|I|InstanceOf|Cast|members|New(_\w*)?|Fn(_\w*)?")

(defn reserved-member
  "A static member's munged name as its Go name's suffix: with _f appended when it would be (after
  any _f marks of its own, which a field init_f has) one j2g derives (derived-suffix), as locals get
  _ (§4.4; doc/classes/JAVA-CONFORMANCE-SURVEY.md, JCS43 (a), \"As built: JC2b\": a static field
  init beside the class's initialization state C_init). Methods' names never need it: theirs hold
  the descriptor's __ and return code, which no derived suffix does."
  [^String s]
  (if (re-matches derived-suffix (str/replace s #"(_f)+$" "")) (str s "_f") s))

(defn static-field-name [cls-go fname] (str cls-go "_" (reserved-member (munge-name fname))))

(defn static-method-name [cls-go name desc] (str cls-go "_" (method-base name desc)))

(defn impl-name [mbase] (str "Impl_" mbase))

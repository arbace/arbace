(ns arbace.python.run
  "pyi's host side of a run and of the REPL (PY5e; doc/python/PYI-SPEC.md §7.6, §9): the compiler the runtime calls
  back (go.arbace.py/SetCompiler) for an import, exec, eval, compile and each interactive statement, and the run's
  configuration (go.arbace.py/Configure: sys.argv, sys.path). Evaluated from the checkout on stage 0, as
  arbace.python is (PYS18 (a)).

  The compiler: source text read by the native reader (PY9; before it the helper, tools/pydump/pydump.py tree --full),
  converted (arbace.repr.python.convert) and compiled (arbace.python.compile); the IR's text, or
  \"SyntaxError: MESSAGE\", or for mode single \"incomplete\" (codeop's rule). The modes are the compiler's
  (arbace.python.compile/compile-source: exec; eval, the expression's value returned; single, each expression statement
  displayed by print-expr, sys.displayhook). Compiled code is kept by the SHA-256 of the mode, the source and the
  compiler's sources, in WORK/ir-cache."
  (:require [arbace.python.compile :as pc]
            [arbace.repr.python.convert :as cv]
            [arbace.string :as str])
  (:import [java.io File]
           [java.security MessageDigest]))

(def ^:private root (or (System/getenv "PYI_ROOT") "."))
(def ^:private work (or (System/getenv "PYI_WORK") (str root "/.tmp/repr-python/pyi")))

(defn- hex [^bytes bs] (apply str (map #(format "%02x" (bit-and (int %) 0xff)) bs)))

(defn- sha256 [^String s]
  (let [md (MessageDigest/getInstance "SHA-256")]
    (hex (.digest md (.getBytes s "UTF-8")))))

(def ^:private compiler-digest
  (delay (sha256 (apply str (for [f (concat ["arbace/python/compile.ae" "arbace/python/ir.ae" "arbace/python/scope.ae"
                                             "arbace/python/run.ae"]
                                            ;; the native reader (PY9): arbace/repr/python's namespaces
                                            (sort (for [^File x (.listFiles (File. (str root "/arbace/repr/python")))
                                                        :when (.endsWith (.getName x) ".ae")]
                                                    (str "arbace/repr/python/" (.getName x)))))
                                  :let [ff (File. (str root "/" f))] :when (.exists ff)]
                              (str f "\u0000" (slurp ff) "\u0000"))))))

(def ^:private counter (atom 0))

(defn- read-dump
  "The native reader's forms of source (PY9: arbace.repr.python.astjson/read-forms, mode :full, as the helper's
  tools/pydump/pydump.py tree --full gave them): the module's forms or its (python/error ...)"
  [source]
  ((requiring-resolve 'arbace.repr.python.astjson/read-forms) source))

(defn- node-head [x] (when (seq? x) (first x)))

(def ^:private incomplete-messages
  [#"was never closed" #"^expected an indented block" #"unexpected EOF" #"^unterminated triple-quoted"
   #"incomplete input"])

(def ^:private compound-heads
  '#{if for async-for while function-def async-function-def class-def try try-star with async-with match})

(defn- incomplete?
  "codeop's rule, approximated: a reader error of input that goes on, or a compound statement (or a line ending in a
  backslash) not yet ended by a blank line"
  [source form]
  (let [lines (str/split-lines source)
        last-blank (boolean (re-find #"\n[ \t]*\n$" (str "\n" source)))]
    (if (cv/error-form? form)
      (boolean (some #(re-find % (str (nth form 2))) incomplete-messages))
      (and (not last-blank)
           (or (contains? compound-heads (node-head (last (second form))))
               (re-find #"\\$" (last lines)))))))

(defn- syntax-error
  "The compiler's answer for a SyntaxError: \"TYPE: MSG\" (SyntaxError, IndentationError or TabError), then after NULs
  its line, offset, end line and end offset when known (CPython's 1-based offsets; the runtime makes the exception's
  fields of them), then its kind, p (the parser's: TEXT, the helper's text of the line, follows, empty for None), m
  (p with the SyntaxError's _metadata line and column before the text, reader-kind) or c (the compiler's: CPython's
  text is the line of the file when it reads, PyErr_ProgramTextObject)"
  ([msg] (str "SyntaxError: " msg))
  ([msg loc] (syntax-error "SyntaxError" msg loc "c" nil))
  ([typ msg loc kind text]
   (str (if (#{"SyntaxError" "IndentationError" "TabError"} typ) typ "SyntaxError") ": " msg
        (apply str (map #(str "\u0000" (if (nil? %) "" %)) (take 4 (concat loc (repeat nil)))))
        "\u0000" kind (when (and (not= kind "c") (some? text)) (str "\u0000" text)))))

(defn- reader-text
  "A reader error's :text, the helper's SyntaxError text, or nil"
  [form]
  (second (drop-while #(not= :text %) form)))

(defn- reader-kind
  "A reader error's kind for syntax-error: p, or with the parser's :metadata (the last statement's line and column, the
  SyntaxError's _metadata; queue 202c) m and them"
  [form]
  (if-let [[l c] (second (drop-while #(not= :metadata %) form))] (str "m\u0000" l "\u0000" c) "p"))

(defn- reader-loc
  "A reader error's location: its :pos, the helper's SyntaxError fields as CPython gives them (lineno, offset,
  end_lineno, end_offset)"
  [form]
  (second (drop-while #(not= :pos %) form)))

(defn- native-answer
  "compile()'s PyCF_ONLY_AST (mode \"ast:MODE:FLAGS:FEATURE:OPTIMIZE\") and _tokenize's tokens (mode \"tokenize:EXTRA\"):
  the native reader's answers (PY9, arbace.repr.python.astjson/compile-answer; tools/pyi/ast_json.py's form)"
  [mode file source]
  ((requiring-resolve 'arbace.repr.python.astjson/compile-answer) mode file source))

(defn- single-error
  "compile()'s mode single as CPython parses it, the native reader's answer (arbace.repr.python.astjson/single-error):
  nil, or the SyntaxError as the compiler's answer"
  [source]
  ((requiring-resolve 'arbace.repr.python.astjson/single-error) source))

(defn- compile-uncached [mode source]
  ;; mode single-complete: compile()'s single without PyCF_ALLOW_INCOMPLETE_INPUT, codeop's rule not applied (PY7)
  ;; mode single parsed as CPython parses it (queue 203: Py_single_input's start rule, one statement, then pegen's
  ;; bad_single_statement): "multiple statements found ..." ahead of codeop's rule (CPython's parser stops after the
  ;; first statement, so the rest may be incomplete or broken), the parser's other errors after it
  (let [form (read-dump source)
        incomplete-rule? (= mode "single")
        single? (#{"single" "single-complete"} mode)
        single-err (when single? (single-error source))
        mode (if (= mode "single-complete") "single" mode)]
    (cond
      (and single-err (str/starts-with? single-err "SyntaxError: multiple statements found")) single-err
      (and incomplete-rule? (incomplete? source form)) "incomplete"
      single-err single-err
      (cv/error-form? form)(syntax-error (str (second form)) (nth form 2) (reader-loc form) (reader-kind form) (reader-text form))
      :else
      (try ((resolve 'arbace.python/ir-text) (pc/compile-source form (keyword mode)))
           (catch Throwable e
             (if (= 'SyntaxError (:class (ex-data e)))
               (syntax-error (:msg (ex-data e)) (let [d (ex-data e)] (when (:lineno d) [(:lineno d) (:offset d) (:end-lineno d) (:end-offset d)])))
               (str "SystemError: pyi's compiler: " (str/replace (str (.getMessage e)) #"\n" " "))))))))

(defn compile-source
  "go.arbace.py's compiler (SetCompiler): MODE exec, eval or single; FILE names the source in messages only"
  [mode file source]
  (let [key (sha256 (str mode "\u0000" @compiler-digest "\u0000" source))
        cf (File. (str work "/ir-cache/" (subs key 0 2) "/" key))]
    (if (.exists cf)
      (slurp cf)
      (let [r (if (or (str/starts-with? mode "ast:") (str/starts-with? mode "tokenize:"))
                (native-answer mode file source)
                (compile-uncached mode source))]
        (when (or (str/starts-with? r "{") (str/starts-with? r "AST:") (str/starts-with? r "TOK:") (= r "incomplete")
                  (str/starts-with? r "SyntaxError: "))
          (.mkdirs (.getParentFile cf))
          (let [tmp (File. (str (.getPath cf) ".tmp" (swap! counter inc)))]
            (spit tmp r)
            (.renameTo tmp cf)))
        r))))

(defn- runtime-fn [sym]
  (require 'go.arbace.py)
  (or (resolve (symbol "go.arbace.py" (name sym))) (throw (ex-info (str "no go.arbace.py/" sym) {}))))

(defn install!
  "Before RunModule or Repl: the compiler, sys.argv (ARGV) and sys.path (PATH)"
  [argv path]
  ((runtime-fn 'SetCompiler) (fn [mode file source] (compile-source mode file source)))
  ;; a built-in module whose Go package is loaded on its first import (pyexpat: go.arbace.pyexpat over go.arbace.expat,
  ;; queue 202e), so a run that never imports it does not load expat's forms
  ((runtime-fn 'SetPackageLoader) (fn [ns] (require (symbol ns))))
  ((runtime-fn 'Configure) (str/join "\u0000" argv) (str/join "\u0000" path)))

(defn repl
  "The REPL on the standard streams (go.arbace.py/Repl); sys.path is ['' LIB SITE...]"
  [lib & [site]]
  (install! [""] (concat (cond-> [""] lib (conj lib)) site))
  ((runtime-fn 'Repl)))

(ns arbace.python.ir
  "pyi's IR (doc/python/PYI-SPEC.md §3, §4; PYS7 (a); PY5a): the code objects the compiler (arbace.python.compile) makes
  and the frame machine (go/arbace/py, PY5b) runs, and their verifier.

  A code object is a map:
    {:name :qualname :kind (:module :class :function :lambda :comprehension :annotation :type-params :type-alias
                            :type-variable)
     :flags #{:generator :coroutine :varargs :varkw :optimized :nested :has-docstring}
     :argcount :posonly :kwonly            ; the parameters, as CPython's co_argcount and the rest count them
     :locals [NAME ...]                    ; the fast locals, the parameters first (in their order)
     :cells [NAME ...] :frees [NAME ...]   ; the cell variables (a parameter among them copied in), then the free ones
     :names [NAME ...]                     ; attribute, global and name-op names
     :consts [VALUE ...]                   ; constants, nested code objects among them as {:code CODE}
     :code [[OP ARG] ...]                  ; the instructions; a jump's ARG is an instruction index
     :handlers [[START END TARGET DEPTH LASTI?] ...]   ; the exception table, innermost first
     :lines [LINE ...]}                    ; each instruction's source line (nil in mode :lines)

  ops: every operation with its stack effect, (fn [arg] [effect-fallthrough effect-if-jumping]) or a number;
  verify: the checks of §4, nil when the code holds, else a message."
  (:require [arbace.string :as str]))

(defn- n [k] (fn [_] k))

(def ops
  "OP -> {:effect (fn [arg] number), :jump (fn [arg] number) when OP may jump to ARG's target, :ends true when control
  does not fall through}"
  {:nop {:effect (n 0)}
   :const {:effect (n 1)}
   :pop {:effect (n -1)}
   :copy {:effect (n 1)}                        ; push a copy of the ARG-th item (1 the top)
   :swap {:effect (n 0)}                        ; swap the top with the ARG-th item
   :load-fast {:effect (n 1)} :store-fast {:effect (n -1)} :delete-fast {:effect (n 0)}
   :load-cell-and-clear {:effect (n 1)}          ; an inlined comprehension's cell (DEF_COMP_CELL): pushes the cell
                                                 ; itself and puts a fresh empty one in its place; :store-cell puts it back
   :store-cell {:effect (n -1)}
   :load-fast-and-clear {:effect (n 1)}          ; pushes the local's value (or the marker :unbound) and unbinds it;
                                                 ; :store-fast of :unbound unbinds (PEP 709's inlined comprehensions)
   :load-deref {:effect (n 1)} :store-deref {:effect (n -1)} :delete-deref {:effect (n 0)}
   :load-closure {:effect (n 1)}                ; the cell object itself (for a nested function's closure)
   :load-global {:effect (n 1)} :store-global {:effect (n -1)} :delete-global {:effect (n 0)}
   :load-name {:effect (n 1)} :store-name {:effect (n -1)} :delete-name {:effect (n 0)}
   :load-dict-or-global {:effect (n 0)}         ; pops a mapping (__classdict__), pushes ARG's value from it or the globals
   :load-dict-or-deref {:effect (n 0)}          ; pops a mapping, pushes ARG's value from it or the cell ARG
   :load-locals {:effect (n 1)}
   :load-build-class {:effect (n 1)}
   :binary {:effect (n -1)}                     ; ARG an operator symbol (+, floor-div, ...)
   :inplace {:effect (n -1)}
   :unary {:effect (n 0)}                       ; ARG +, -, bit-not
   :not {:effect (n 0)}
   :to-bool {:effect (n 0)}
   :compare {:effect (n -1)}                    ; ARG ==, !=, <, <=, >, >=
   :is {:effect (n -1)}                         ; ARG true for is not
   :contains {:effect (n -1)}                   ; ARG true for not in
   :build-tuple {:effect (fn [k] (- 1 k))} :build-list {:effect (fn [k] (- 1 k))} :build-set {:effect (fn [k] (- 1 k))}
   :build-map {:effect (fn [k] (- 1 (* 2 k)))}
   :build-slice {:effect (fn [k] (- 1 k))}
   :list-append {:effect (n -1)}                ; pops a value onto the list ARG items down
   :set-add {:effect (n -1)}
   :map-add {:effect (n -2)}
   :list-extend {:effect (n -1)} :set-update {:effect (n -1)} :dict-update {:effect (n -1)}
   :dict-merge {:effect (n -1)}                 ; ** in a call: a duplicate keyword is a TypeError
   :list-to-tuple {:effect (n 0)}
   :unpack-sequence {:effect (fn [k] (dec k))}
   :unpack-ex {:effect (fn [[b a]] (+ b a))}    ; ARG [before after]: before + a list + after
   :load-attr {:effect (n 0)} :store-attr {:effect (n -2)} :delete-attr {:effect (n -1)}
   :subscr {:effect (n -1)} :store-subscr {:effect (n -3)} :delete-subscr {:effect (n -2)}
   :call {:effect (fn [[k _]] (- k))}           ; ARG [argument-count keyword-names]: callable and args -> result
   :call-ex {:effect (fn [kw?] (if kw? -2 -1))} ; callable, a tuple and (ARG) a dict -> result
   :call-intrinsic {:effect (fn [[_ k]] (- 1 k))}   ; ARG [NAME count]: a runtime helper of §3.4
   :make-function {:effect (fn [[_ parts]] (- 1 (count parts)))}  ; ARG [const-index parts]: pops the parts, pushes a function
   :jump {:effect (n 0) :jump (n 0) :ends true}
   :jump-if-false {:effect (n -1) :jump (n -1)}
   :jump-if-true {:effect (n -1) :jump (n -1)}
   :jump-if-none {:effect (n -1) :jump (n -1)}
   :jump-if-not-none {:effect (n -1) :jump (n -1)}
   :get-iter {:effect (n 0)}
   :for-iter {:effect (n 1) :jump (n -1)}       ; pushes the next item; at the end pops the iterator and jumps
   :get-aiter {:effect (n 0)}
   :get-anext {:effect (n 1)}                   ; pushes the awaitable of the next item (the iterator stays)
   :end-async-for {:effect (n -2)}              ; in a handler: StopAsyncIteration ends the loop (pops it and the iterator)
   :get-awaitable {:effect (n 0)}
   :get-yield-from-iter {:effect (n 0)}
   :yield-from {:effect (n -1)}                 ; [iterator first-value] -> its return value: sends the value (None),
                                                ; then delegates (yields what it yields, sends and throws into it)
   :yield-value {:effect (n 0)}                 ; pops the value yielded, pushes the value sent
   :return {:effect (n -1) :ends true}
   :raise {:effect (fn [k] (- k)) :ends true}   ; ARG 0 (re-raise), 1, 2 (with a cause)
   :reraise {:effect (n -1) :ends true}         ; re-raises the exception on the top
   :push-exc-info {:effect (n 1)}               ; exc -> previous-exc exc
   :pop-except {:effect (n -1)}                 ; restores the previous exception
   :check-exc-match {:effect (n 0)}             ; exc type -> exc bool
   :check-eg-match {:effect (n 0)}              ; eg type -> rest match
   :prep-reraise-star {:effect (n -1)}          ; original raised-list -> the group to re-raise or None
   :with-enter {:effect (n 1)}                  ; manager -> exit result-of-enter
   :async-with-enter {:effect (n 1)}            ; manager -> aexit awaitable-of-aenter
   :with-except {:effect (n 1)}                 ; exit lasti prev exc -> exit lasti prev exc result
   :import-name {:effect (n -1)}                ; level fromlist -> module
   :import-from {:effect (n 1)}                 ; module -> module value
   :import-star {:effect (n -1)}
   :format {:effect (fn [[_ spec?]] (if spec? -1 0))}  ; ARG [conversion spec?]
   :build-string {:effect (fn [k] (- 1 k))}
   :build-interpolation {:effect (fn [[_ spec?]] (if spec? -2 -1))}  ; value text (spec) -> interpolation
   :build-template {:effect (fn [k] (- 1 k))}  ; ARG parts (strings and interpolations, in order) -> template
   :match-class {:effect (n -2)}                ; subject cls names -> attributes or None
   :match-mapping {:effect (n 1)} :match-sequence {:effect (n 1)} :get-len {:effect (n 1)}
   :match-keys {:effect (n 1)}                  ; subject keys -> subject keys values-or-None
   :copy-dict-without-keys {:effect (n 0)}      ; subject keys -> subject rest-dict
   :setup-annotations {:effect (n 0)}
   :print-expr {:effect (n -1)}                 ; mode :single: the value to sys.displayhook (INTRINSIC_PRINT)
   :exit-init-check {:effect (n -1)}})

(defn stack-effect [op arg]
  (if-let [o (ops op)] ((:effect o) arg) (throw (ex-info (str "unknown op " op) {}))))

(def ^:private jumps-to-label #{:jump :jump-if-false :jump-if-true :jump-if-none :jump-if-not-none :for-iter})

(defn verify
  "nil when the code object holds (doc/python/PYI-SPEC.md §4), else a message: every op known; every jump and handler
  inside the code; the stack's depth at each instruction the same on every path into it and never negative; a handler
  entered at its DEPTH plus the exception (and lasti); a return at depth 1; every local, cell, free, name and const index in range; nested
  code objects verified too"
  [co]
  (let [code (:code co) nc (count code)
        handlers (:handlers co)
        depth (object-array nc)
        err (atom nil)
        fail (fn [msg] (when-not @err (reset! err (str (:qualname co) ": " msg))))
        in? (fn [i] (and (integer? i) (<= 0 i) (< i nc)))]
    (doseq [[i [op arg]] (map-indexed vector code)]
      (when-not (ops op) (fail (str "unknown op " op " at " i)))
      (when (and (jumps-to-label op) (not (in? arg))) (fail (str op " at " i " jumps out of the code: " arg)))
      (case op
        (:load-fast :store-fast :delete-fast :load-fast-and-clear) (when-not (and (integer? arg) (< -1 arg (count (:locals co)))) (fail (str op " " arg " at " i)))
        (:load-deref :store-deref :delete-deref :load-closure :load-dict-or-deref :load-cell-and-clear :store-cell)
        (when-not (and (integer? arg) (< -1 arg (+ (count (:cells co)) (count (:frees co))))) (fail (str op " " arg " at " i)))
        (:load-global :store-global :delete-global :load-name :store-name :delete-name :load-attr :store-attr :delete-attr
         :import-name :import-from :load-dict-or-global)
        (when-not (and (integer? arg) (< -1 arg (count (:names co)))) (fail (str op " " arg " at " i)))
        :const (when-not (and (integer? arg) (< -1 arg (count (:consts co)))) (fail (str "const " arg " at " i)))
        nil))
    (doseq [[s e t d] handlers]
      (when-not (and (in? s) (<= s e nc) (in? t) (integer? d) (>= d 0)) (fail (str "bad handler " [s e t d]))))
    ;; the stack's depth by a worklist over the control flow
    (let [work (java.util.ArrayDeque.)
          enter (fn [i d from]
                  (cond (not (in? i)) (fail (str "control reaches " i " from " from))
                        (neg? d) (fail (str "the stack's depth is " d " at " i " (from " from ")"))
                        (nil? (aget depth i)) (do (aset depth i d) (.add work i))
                        (not= (aget depth i) d) (fail (str "the stack's depth at " i " is " (aget depth i) " and " d " (from " from ")"))))]
      (when (pos? nc) (enter 0 0 :start))
      (while (and (not (.isEmpty work)) (nil? @err))
        (let [i (.poll work)
              d (aget depth i)
              [op arg] (nth code i)
              o (ops op)
              eff ((:effect o) arg)
              pops (case op :copy (- arg 1) :swap arg 0)]
          ;; a return leaves nothing beneath its value: every block it leaves unwound (doc/python/PYI-SPEC.md §4)
          (when (and (= op :return) (not= d 1)) (fail (str "return at " i " with " d " on the stack")))
          (when (> pops d) (fail (str op " " arg " at " i " reaches below the stack (depth " d ")")))
          ;; the handlers covering i: the exception's entry
          (doseq [[s e t hd lasti] handlers :when (and (<= s i) (< i e))]
            (when (> hd d) (fail (str "the handler of " [s e] " at depth " hd " covers " i " at depth " d)))
            (enter t (+ hd 1 (if lasti 1 0)) i))
          (when-let [j (:jump o)] (enter arg (+ d (j arg)) i))
          (when-not (:ends o) (if (< (inc i) nc) (enter (inc i) (+ d eff) i) (fail (str "control falls off the end after " i)))))))
    (doseq [c (:consts co) :when (and (map? c) (:code c))]
      (when-let [e (verify (:code c))] (fail e)))
    @err))

(defn count-ops
  "{OP count} over a code object and its nested ones"
  [co]
  (merge-with + (frequencies (map first (:code co)))
              (apply merge-with + {} (for [c (:consts co) :when (and (map? c) (:code c))] (count-ops (:code c))))))

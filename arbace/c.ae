(ns arbace.c
  "C forms at the REPL (doc/C23-SURVEY.md §6.1, §6.6, CS17 (a), CS20 (a); doc/c/SPEC.md): the macros of C
  forms, as arbace.go's are Go forms' (doc/go/GOI-SPEC.md §2.2). A translation unit is a namespace; its
  declaration forms are data entered into the unit by arbace.c.repl (nothing in them is evaluated as
  Arbace, SPEC principle 1), checked by arbace.repr.c.check and built by arbace.c.build when the program
  runs. With the alias c:

    (ns c.letters (:require [arbace.c :as c]))
    (c/file \"letters.c\" :std :c23)
    (c/include \"<stdio.h>\")
    (c/defn main ^int [void] (printf \"%d\\n\" 42) (return 0))
    (c/run-main 'c.letters)                      ; prints 42, => 0

  A unit read by repr/c (bin/repr-c read) loads the same way: its c/include forms name their header units
  (:unit), which the REPL takes from the read."
  (:refer-clojure :exclude [defn var declare struct enum])
  (:require [arbace.c.repl :as repl]))

(defn- repl-ns [] (ns-name *ns*))

(defmacro file "c/file: the unit's file and standard (§4.2)." [& _]
  `(repl/file! '~&form '~(repl-ns)))

(defmacro include
  "c/include: at the REPL, (c/include \"<stdio.h>\") reads the header in the unit's context; in a read
  unit's forms, (c/include \"<stdio.h>\" :unit U) names its header unit, taken from the read."
  [spec & opts]
  (if (some #{:unit} opts)
    `(repl/declare! '~&form '~(repl-ns))
    `(repl/include! ~spec '~(repl-ns))))

(defmacro defn "c/defn: a function definition (§6.4)." [& _] `(repl/declare! '~&form '~(repl-ns)))
(defmacro var "c/var: an object (§6.2)." [& _] `(repl/declare! '~&form '~(repl-ns)))
(defmacro declare "c/declare: a function's declaration (§6.3)." [& _] `(repl/declare! '~&form '~(repl-ns)))
(defmacro typedef "c/typedef (§6.5)." [& _] `(repl/declare! '~&form '~(repl-ns)))
(defmacro struct "c/struct: a tag declaration (§6.6)." [& _] `(repl/declare! '~&form '~(repl-ns)))
(defmacro union "c/union: a tag declaration (§6.6)." [& _] `(repl/declare! '~&form '~(repl-ns)))
(defmacro enum "c/enum: a tag declaration (§6.6)." [& _] `(repl/declare! '~&form '~(repl-ns)))
(defmacro group "c/group: declarators sharing a defined type (§6.7)." [& _] `(repl/declare! '~&form '~(repl-ns)))
(defmacro static-assert "c/static-assert (§6.8)." [& _] `(repl/declare! '~&form '~(repl-ns)))
(defmacro attr-decl "c/attr-decl (§6.8)." [& _] nil)
(defmacro define "c/define: the layer's, ignored by eval (§9.2)." [& _] nil)
(defmacro undef "c/undef: the layer's, ignored by eval (§9.2)." [& _] nil)
(defmacro directive "c/directive: the layer's, ignored by eval (§9.2)." [& _] nil)
(defmacro pragma "c/pragma: entered for the checker (#pragma pack, §9.2)." [& _] `(repl/declare! '~&form '~(repl-ns)))
(defmacro header "c/header: a header unit's first form (§4.3)." [& _] nil)

(defn run-main
  "(c/run-main 'c.letters & args): main of the REPL's program run in the program mode: its status."
  [ns & args]
  (apply repl/run-main ns args))

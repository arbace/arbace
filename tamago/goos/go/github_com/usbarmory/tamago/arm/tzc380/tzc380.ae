  ^{:line 47} [^{:val 1} REGION_ATTRS_SIZE 1]
  ^{:line 48} [^{:val 0} REGION_ATTRS_EN 0]

  ^{:line 50} [^{:val 14} SIZE_MIN 2r001110]
  ^{:line 51} [^{:val 63} SIZE_MAX 2r111111])




(go/const "TZASC security permissions,\n(p28, Table 2-4, TZC-380 TRM).\n"

  ^{:line 58} [^{:val 3 :doc "Secure Read Access bit\n"} SP_SW_RD 3]

  ^{:line 60} [^{:val 2 :doc "Secure Write Access bit\n"} SP_SW_WR 2]

  ^{:line 62} [^{:val 1 :doc "NonSecure Read Access bit\n"} SP_NW_RD 1]

  ^{:line 64} [^{:val 0 :doc "NonSecure Write Access bit\n"} SP_NW_WR 0])



(go/type TZASC "TZASC represents the TrustZone Address Space Controller instance.\n" (struct

    ^{:line 70 :tag uint32 :doc "Base register\n"} Base














    ^{:line 85 :tag uint32 :doc "The bypass register controls the TZASC monitoring of DDR\ntransactions.\n\nTo use the TZASC, the bypass must be disabled early in the boot\nprocess, before DDR use. This is a one time operation, until the\nnext power-up cycle.\n\nTo do so the register can be written in the board DCD file (e.g.\nimximage.cfg in usbarmory package):\n\t`DATA 4 0x020e4024 0x00000001`\n\nThe register must be specified in the TZASC instance for\nverification purposes.\n"} Bypass


    ^{:line 88 :tag uint32 :doc "Secure Boot Lock signal (see 2.2.8 TZC-380 TRM)\n"} SecureBootLockReg
    ^{:line 89 :tag int} SecureBootLockPos


    ^{:line 92 :tag uint32 :doc "control registers\n"} conf
    ^{:line 93 :tag uint32} lockdown_range
    ^{:line 94 :tag uint32} lockdown_select
    ^{:line 95 :tag uint32} sec_inv_en
    ^{:line 96 :tag uint32} region_setup_low_0
    ^{:line 97 :tag uint32} region_setup_high_0
    ^{:line 98 :tag uint32} region_attrs_0))



^{:go/end 114} (go/method Init "Init initializes the TrustZone Address Space Controller (TZASC).\n" [^{:tag (* TZASC)} hw]
  (when (or (== (.-Base hw) 0) (== (.-Bypass hw) 0) (== (.-SecureBootLockReg hw) 0))
    (panic "invalid TZASC instance"))


  (set! (.-conf hw) (+ (.-Base hw) TZASC_CONF))
  (set! (.-lockdown_range hw) (+ (.-Base hw) TZASC_LOCKDOWN_RANGE))
  (set! (.-lockdown_select hw) (+ (.-Base hw) TZASC_LOCKDOWN_SELECT))
  (set! (.-sec_inv_en hw) (+ (.-Base hw) TZASC_SEC_INV_EN))
  (set! (.-region_setup_low_0 hw) (+ (.-Base hw) TZASC_REGION_SETUP_LOW_0))
  (set! (.-region_setup_high_0 hw) (+ (.-Base hw) TZASC_REGION_SETUP_HIGH_0))
  (set! (.-region_attrs_0 hw) (+ (.-Base hw) TZASC_REGION_ATTRS_0)))



^{:go/end 119} (go/method Regions "Regions returns the number of regions that the TZASC provides.\n" ^int [^{:tag (* TZASC)} hw]
  (+ (conv int (reg/GetN (.-conf hw) CONF_REGIONS 0xf)) 1))






^{:go/end 127} (go/method EnableSecurityInversion "EnableSecurityInversion allows configuration of arbitrary security\npermissions, disabling automatic enabling of secure access on non-secure\nonly permissions\n(p49, 3.2.12 Security Inversion Enable Register, TZC-380 TRM).\n" [^{:tag (* TZASC)} hw]
  (reg/Set (.-sec_inv_en hw) 0))





^{:go/end 184} (go/method EnableRegion "EnableRegion configures a TZASC region with the argument start address, size\nand security permissions, for region 0 only security permissions are\nrelevant.\n" [^{:tag (* TZASC)} hw ^int n ^uint32 start ^uint32 size ^int sp] :results [^error err]
  (let [^uint32 attrs (zero uint32)
      ^{:line 134 :tag uint32} s (zero uint32)]

    (when (or (< n 0) (> (+ n 1) (.Regions hw)))
      (return (errors/New "invalid region index")))


    (when (!= (reg/Read (.-Bypass hw)) 1)
      (return (errors/New "TZASC inactive (bypass detected)")))


    (when (== n 0)
      (reg/SetN (.-region_attrs_0 hw) REGION_ATTRS_SP 2r1111 (conv uint32 sp))
      (return))


    (when (!= (% start (<< 1 15)) 0)
      (return (errors/New "incompatible start address")))


    (when (and (!= start 0) (!= (% start size) 0))
      (return (errors/New "start address must be a multiple of its region size")))


    (when (> sp 2r1111)
      (return (errors/New "invalid security permissions")))


    ;; size = 2^(s+1)
    (for [i (conv uint32 SIZE_MIN)] (<= i SIZE_MAX) (inc! i)
      (when (== size ^uint32 (<< 1 (+ i 1)))
        (set! s i)
        (break)))



    (when (== s 0)
      (return (errors/New "incompatible region size")))


    (bits/SetN (addr attrs) REGION_ATTRS_SP 2r1111 (conv uint32 sp))
    (bits/SetN (addr attrs) REGION_ATTRS_SIZE 2r111111 s)
    (bits/Set (addr attrs) REGION_ATTRS_EN)

    (let [off (conv uint32 (* 0x10 n))]

      (reg/Write (+ (.-region_setup_low_0 hw) off) (bit-and start 0xffff8000))
      (reg/Write (+ (.-region_setup_high_0 hw) off) 0)
      (reg/Write (+ (.-region_attrs_0 hw) off) attrs)

      (return))))



^{:go/end 199} (go/method DisableRegion "DisableRegion disables a TZASC region.\n" [^{:tag (* TZASC)} hw ^int n] :results [^error err]
  (when (or (< n 0) (> (+ n 1) (.Regions hw)))
    (return (errors/New "invalid region index")))


  (when (!= (reg/Read (.-Bypass hw)) 1)
    (return (errors/New "TZASC inactive (bypass detected)")))


  (reg/Clear (+ (.-region_attrs_0 hw) (conv uint32 (* 0x10 n))) REGION_ATTRS_EN)

  (return))




^{:go/end 207} (go/method Lock "Lock enables TZASC secure boot lock register writing restrictions\n(p30, 2.2.8 Preventing writes to registers and using secure_boot_lock, TZC-380 TRM).\n" [^{:tag (* TZASC)} hw]
  (reg/Write (.-lockdown_range hw) 0xffffffff)
  (reg/Write (.-lockdown_select hw) 0xffffffff)
  (reg/Set (.-SecureBootLockReg hw) (.-SecureBootLockPos hw)))

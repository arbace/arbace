  ^{:line 35} [^{:val 0} TZASC_CONF 0x000]
  ^{:line 36} [^{:val 0} CONF_REGIONS 0]

  ^{:line 38} [^{:val 8} TZASC_LOCKDOWN_RANGE 0x008]
  ^{:line 39} [^{:val 12} TZASC_LOCKDOWN_SELECT 0x00c]

  ^{:line 42} [^{:val 256} TZASC_REGION_SETUP_LOW_0 0x100]
  ^{:line 43} [^{:val 260} TZASC_REGION_SETUP_HIGH_0 0x104]

  ^{:line 45} [^{:val 264} TZASC_REGION_ATTRS_0 0x108]

;; Package goos describes required, as well as optional, runtime
;; functions/variables for custom GOOS implementations as supported by the
;; GOOSPKG variable for [runtime/goos] overlay.
;;
;; These hooks act as a "Rosetta Stone" for integration of a freestanding Go
;; runtime within an arbitrary environment, whether bare metal or OS supported.
;;
;; For bare metal examples see the following packages: [usbarmory], [uefi],
;; [microvm].
;;
;; For OS supported examples see the following tamago packages: [linux],
;; [applet].
;;
;; This package is a stub and is only used for documentation purposes,
;; applications need to define the described functions/variables or import them
;; from external packages (such as the ones provided by [tamago]) relevant to
;; the target environment.
;;
;; [tamago]: https://github.com/usbarmory/tamago
;; [usbarmory]: https://github.com/usbarmory/tamago/tree/master/board/usbarmory
;; [uefi]: https://github.com/usbarmory/go-boot/tree/main/uefi
;; [microvm]: https://github.com/usbarmory/tamago/tree/master/board/firecracker/microvm
;; [linux]: https://github.com/usbarmory/tamago/tree/master/user/linux
;; [applet]: https://github.com/usbarmory/GoTEE/tree/master/applet
(in-ns 'go.github_com.usbarmory.tamago.goos) (go/file "goos.go" :doc "Package goos describes required, as well as optional, runtime\nfunctions/variables for custom GOOS implementations as supported by the\nGOOSPKG variable for [runtime/goos] overlay.\n\nThese hooks act as a \"Rosetta Stone\" for integration of a freestanding Go\nruntime within an arbitrary environment, whether bare metal or OS supported.\n\nFor bare metal examples see the following packages: [usbarmory], [uefi],\n[microvm].\n\nFor OS supported examples see the following tamago packages: [linux],\n[applet].\n\nThis package is a stub and is only used for documentation purposes,\napplications need to define the described functions/variables or import them\nfrom external packages (such as the ones provided by [tamago]) relevant to\nthe target environment.\n\n[tamago]: https://github.com/usbarmory/tamago\n[usbarmory]: https://github.com/usbarmory/tamago/tree/master/board/usbarmory\n[uefi]: https://github.com/usbarmory/go-boot/tree/main/uefi\n[microvm]: https://github.com/usbarmory/tamago/tree/master/board/firecracker/microvm\n[linux]: https://github.com/usbarmory/tamago/tree/master/user/linux\n[applet]: https://github.com/usbarmory/GoTEE/tree/master/applet\n" :imports [

    ^{:line 35} [unsafe "unsafe"]])


(go/var "Required variables.\n"



  ^{:line 42} [^{:tag uint :doc "RamStart defines the start address of the physical or virtual memory\navailable to the runtime for allocation (including the code segment\nwhich must be mapped within).\n"} RamStart]




  ^{:line 47} [^{:tag uint :doc "RamSize defines the total size of the physical or virtual memory\navailable to the runtime for allocation (including the code segment\nwhich must be mapped within).\n"} RamSize]



  ^{:line 51} [^{:tag uint :doc "RamStackOffset, defines the negative offset from the end of the\navailable memory for stack allocation.\n"} RamStackOffset])




(go/func ^:extern CPUInit "CPUInit handles immediate startup CPU initialization as it represents the\nfirst instruction set executed.\n" [])







(go/func ^:extern Hwinit0 "Hwinit0 takes care of the lower level initialization triggered before\nruntime setup (pre World start).\n\nIt must be defined using Go's Assembler to retain Go's commitment to\nbackward compatibility, otherwise extreme care must be taken as the lack of\nWorld start does not allow memory allocation.\n" [])


(go/func ^:extern InitRNG "InitRNG initializes random number generation.\n" [])


(go/func ^:extern GetRandomData "GetRandomData generates len(b) random bytes and writes them into b.\n" [^{:tag (slice byte)} b])






(go/func ^:extern Nanotime "Nanotime returns the system time in nanoseconds.\n\nBefore [Hwinit1] it must be defined using Go's Assembler to retain Go's\ncommitment to backward compatibility, otherwise extreme care must be taken\nas the lack of World start does not allow memory allocation.\n" ^int64 [])






(go/func ^:extern Printk "Printk handles character printing to standard output.\n\nBefore [Hwinit1] it must be defined using Go's Assembler to retain Go's\ncommitment to backward compatibility, otherwise extreme care must be taken\nas the lack of World start does not allow memory allocation.\n" [^byte c])



(go/func ^:extern Hwinit1 "Hwinit1 takes care of the lower level initialization triggered early in\nruntime setup (post World start).\n" [])


(go/var "Optional variables/functions.\n"



  ^{:line 95} [^{:tag uintptr :doc "Bloc is an optional variable which can be set to redefine the heap\nmemory start address, this is typically only required on OS\nsupported environments.\n"} Bloc]



  ^{:line 99} [^{:tag (func [^int32 code]) :doc "Exit is an optional function which can be set to override default\nruntime termination.\n"} Exit]



  ^{:line 103} [^{:tag (func [^int64 until]) :doc "Idle is an optional function which can be set to implement CPU idle\ntime management.\n"} Idle]



  ^{:line 107} [^{:tag (func [] [uint64]) :doc "ProcID is an optional function which can be set to provide the\nprocessor identifier for tracing purposes.\n"} ProcID]



  ^{:line 111} [^{:tag (func [^unsafe/Pointer sp ^unsafe/Pointer mp ^unsafe/Pointer gp ^unsafe/Pointer fn]) :doc "Task is an optional function which can be set to provide an\nimplementation for HW/OS threading (e.g. [runtime.newosproc]).\n"} Task]





  ^{:line 117} [^{:tag (func [^uint64 procid]) :doc "Wake is an optional function which can be set to provide a wake up\ncall for halted processors as reported by [ProcID], it must be\ndefined as required to handle [Idle] implementations which halt a\nprocessor.\n"} Wake])

(in-ns 'go.github_com.usbarmory.tamago.goos) (go/file "mem.go" :build ["//go:build !tiny"] :imports [])

(go/const ^{:val 8} bits (/ (<< 32 (>> (bit-not (conv uint 0)) 63)) 8))


(go/const "Required constants.\n"


  ^{:line 19} [^{:val 0 :doc "ArenaBaseOffset is the pointer value that corresponds to index 0 in\nthe heap arena map (see runtime.arenaBaseOffset).\n"} ArenaBaseOffset 0]



  ^{:line 23} [^{:val 40 :doc "HeapAddrBits defines the number of bits in a heap address (see\nruntime.heapAddrBits).\n"} HeapAddrBits (+ (* (- 8 bits) 3) (* bits 5))] ; 32-bit:32 64-bit:40



  ^{:line 27} [^{:val 22 :doc "LogHeapArenaBytes defines the size of a runtime heap arena in log_2\nbytes (see runtime.logHeapArenaBytes).\n"} LogHeapArenaBytes (+ 2 20)]



  ^{:line 31} [^{:val 9 :doc "LogPallocChunkPages defines the size of a runtime bitmap chunk in\nlog_2 bytes (see runtime.logPallocChunkPages).\n"} LogPallocChunkPages 9]



  ^{:line 35} [^{:val 4096 :doc "MinPhysPageSize is a lower-bound on the physical page size (see\nruntime.minPhysPageSize).\n"} MinPhysPageSize 4096]




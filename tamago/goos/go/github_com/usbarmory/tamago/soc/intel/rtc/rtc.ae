;; Package rtc implements a driver for Real Time Clock devices adopting the
;; following reference specifications:
;;   - IBM PC AT Technical Reference - March 1984
;;
;; This package is only meant to be used with `GOOS=tamago GOARCH=amd64` as
;; supported by the TamaGo framework for bare metal Go, see
;; https://github.com/usbarmory/tamago.
(in-ns 'go.github_com.usbarmory.tamago.soc.intel.rtc) (go/file "rtc.go" :doc "Package rtc implements a driver for Real Time Clock devices adopting the\nfollowing reference specifications:\n  - IBM PC AT Technical Reference - March 1984\n\nThis package is only meant to be used with `GOOS=tamago GOARCH=amd64` as\nsupported by the TamaGo framework for bare metal Go, see\nhttps://github.com/usbarmory/tamago.\n" :imports [


    ^{:line 19} [errors "errors"]
    ^{:line 20} [time "time"]

    ^{:line 22} [reg "github.com/usbarmory/tamago/internal/reg"]])



(go/const "CMOS registers\n"
  ^{:line 27} [^{:val 112} CMOS_RTC_OUT 0x70]
  ^{:line 28} [^{:val 113} CMOS_RTC_IN 0x71])



(go/const "RTC registers\n"
  ^{:line 33} [^{:val 0} SECONDS 0x00]
  ^{:line 34} [^{:val 2} MINUTES 0x02]
  ^{:line 35} [^{:val 4} HOURS 0x04]
  ^{:line 36} [^{:val 7} DOW 0x07]
  ^{:line 37} [^{:val 8} MONTH 0x08]
  ^{:line 38} [^{:val 9} YEAR 0x09]
  ^{:line 39} [^{:val 50} CENTURY 0x32]

  ^{:line 41} [^{:val 10} STATUSA 0x0a]
  ^{:line 42} [^{:val 7} STATUSA_UIP 7])



(go/type RTC "RTC represents a Real Time Clock instance.\n" (struct

    ^{:line 48 :tag (* time/Location) :doc "Time zone\n"} Location))


^{:go/end 54} (go/method read ^int [^{:tag (* RTC)} rtc ^int addr]
  (reg/Out8 CMOS_RTC_OUT (conv uint8 addr))
  (conv int (reg/In8 CMOS_RTC_IN)))


^{:go/end 58} (go/func bcdToBin ^int [^int val]
  (+ (bit-and val 0x0f) (* (/ val 16) 10)))



^{:go/end 87} (go/method Now "Now() returns the real-time clock.\n" [^{:tag (* RTC)} rtc] :results [^time/Time t ^error err]
  (when (== (.-Location rtc) nil)
    (when [(set! (values (.-Location rtc) err) (time/LoadLocation ""))] (!= err nil)
      (return)))



  (when [a (.read rtc STATUSA)] (== (bit-and (>> a STATUSA_UIP) 1) 1)
    (set! err (errors/New "update in progress"))
    (return))


  ;; We assume that the RTC remains in its initialized state with Data
  ;; Mode set to BCD and 24-hour mode.

  (let [ss (bcdToBin (.read rtc SECONDS))
      ^{:line 77} mm (bcdToBin (.read rtc MINUTES))
      ^{:line 78} dd (bcdToBin (.read rtc DOW))
      ^{:line 79} MM (bcdToBin (.read rtc MONTH))
      ^{:line 80} yy (bcdToBin (.read rtc YEAR))
      ^{:line 81} cc (bcdToBin (.read rtc CENTURY))

      ^{:line 83} hh (.read rtc HOURS)]
    (set! hh (bit-or (+ (bit-and hh 0x0f) (* (/ (bit-and hh 0x70) 16) 10)) (bit-and hh 0x80)))

    (return (time/Date (+ (* cc 100) yy) (conv time/Month MM) dd hh mm ss 0 (.-Location rtc)) nil)))

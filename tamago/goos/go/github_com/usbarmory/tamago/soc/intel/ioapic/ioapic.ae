;; Package ioapic implements a driver for the Intel I/O (IOAPIC) Advanced
;; Programmable Interrupt Controllers adopting the following reference
;; specifications:
;;   - 82093AA I/O Advanced Programmable Interrupt Controller (IOAPIC)
;;
;; This package is only meant to be used with `GOOS=tamago` as
;; supported by the TamaGo framework for bare metal Go, see
;; https://github.com/usbarmory/tamago.
(in-ns 'go.github_com.usbarmory.tamago.soc.intel.ioapic) (go/file "ioapic.go" :doc "Package ioapic implements a driver for the Intel I/O (IOAPIC) Advanced\nProgrammable Interrupt Controllers adopting the following reference\nspecifications:\n  - 82093AA I/O Advanced Programmable Interrupt Controller (IOAPIC)\n\nThis package is only meant to be used with `GOOS=tamago` as\nsupported by the TamaGo framework for bare metal Go, see\nhttps://github.com/usbarmory/tamago.\n" :imports [


    ^{:line 20} [bits "github.com/usbarmory/tamago/bits"]
    ^{:line 21} [reg "github.com/usbarmory/tamago/internal/reg"]])



(go/const "I/O APIC supported vectors\n"
  ^{:line 26} [^{:val 16} MinVector 16]
  ^{:line 27} [^{:val 255} MaxVector 255])



(go/const "I/O APIC registers\n"
  ^{:line 32} [^{:val 0} IOREGSEL 0x00]
  ^{:line 33} [^{:val 16} IOWIN 0x10]

  ^{:line 35} [^{:val 0} IOAPICID 0x00]

  ^{:line 37} [^{:val 1} IOAPICVER 0x01]
  ^{:line 38} [^{:val 16} VER_ENTRIES 16]

  ^{:line 40} [^{:val 16} IOAPICREDTBLn 0x10]
  ^{:line 41} [^{:val 56} REDTBL_DEST 56]
  ^{:line 42} [^{:val 16} REDTBL_MASK 16]
  ^{:line 43} [^{:val 11} REDTBL_DESTMOD 11]
  ^{:line 44} [^{:val 0} REDTBL_INTVEC 0])



(go/type IOAPIC "IOAPIC represents an I/O APIC instance.\n" (struct

    ^{:line 50 :tag int :doc "Controller index\n"} Index

    ^{:line 52 :tag uint32 :doc "Base register\n"} Base

    ^{:line 54 :tag int :doc "Global System Interrupt Base\n"} GSIBase))



^{:go/end 65} (go/method Init "Init initializes the I/O APIC.\n" [^{:tag (* IOAPIC)} io]
  (when (== (.-Base io) 0)
    (panic "invalid IOAPIC instance"))


  (reg/Write (+ (.-Base io) IOREGSEL) IOAPICID)
  (reg/SetN (+ (.-Base io) IOWIN) 24 0xf (conv uint32 (.-Index io))))



^{:go/end 71} (go/method ID "ID returns the IOAPIC identification.\n" ^uint32 [^{:tag (* IOAPIC)} io]
  (reg/Write (+ (.-Base io) IOREGSEL) IOAPICID)
  (reg/GetN (+ (.-Base io) IOWIN) 24 0xf))



^{:go/end 77} (go/method Version "Version returns the IOAPIC version register.\n" ^uint32 [^{:tag (* IOAPIC)} io]
  (reg/Write (+ (.-Base io) IOREGSEL) IOAPICVER)
  (reg/Read (+ (.-Base io) IOWIN)))



^{:go/end 84} (go/method Entries "Entries returns the size of the IOAPIC redirection table.\n" ^int [^{:tag (* IOAPIC)} io]
  (reg/Write (+ (.-Base io) IOREGSEL) IOAPICVER)
  (let [maxIndex (reg/GetN (+ (.-Base io) IOWIN) VER_ENTRIES 0xff)]
    (+ (conv int maxIndex) 1)))




^{:go/end 115} (go/method EnableInterrupt "EnableInterrupt activates an IOAPIC redirection table entry at the\ncorresponding index for the desired interrupt vector.\n" [^{:tag (* IOAPIC)} io ^int index ^int id]
  (let [^uint32 val (zero uint32)]

    (when (or (< id MinVector) (> id MaxVector))
      (return))


    (set! index - (.-GSIBase io))

    (when (> index (- (.Entries io) 1))
      (return))


    ;; set destination field for physical mode
    (bits/Clear (addr val) REDTBL_DESTMOD)

    ;; set destination to BSP
    (reg/Write (+ (.-Base io) IOREGSEL) (+ IOAPICREDTBLn (conv uint32 (* index 2)) 1))
    (reg/Write (+ (.-Base io) IOWIN) (<< 0 (- REDTBL_DEST 32)))

    ;; set interrupt vector
    (bits/Clear (addr val) REDTBL_MASK)
    (bits/SetN (addr val) REDTBL_INTVEC 0xff (conv uint32 id))

    ;; set redirection table entry
    (reg/Write (+ (.-Base io) IOREGSEL) (+ IOAPICREDTBLn (conv uint32 (* index 2))))
    (reg/Write (+ (.-Base io) IOWIN) val)))

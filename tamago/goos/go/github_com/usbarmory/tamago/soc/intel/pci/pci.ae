;; Package pci implements a driver for Intel Peripheral Component Interconnect
;; (PCI) controllers adopting the following reference
;; specifications:
;;   - PCI Local Bus Specification, revision 3.0, PCI Special Interest Group
;;
;; This package is only meant to be used with `GOOS=tamago` as
;; supported by the TamaGo framework for bare metal Go, see
;; https://github.com/usbarmory/tamago.
(in-ns 'go.github_com.usbarmory.tamago.soc.intel.pci) (go/file "pci.go" :doc "Package pci implements a driver for Intel Peripheral Component Interconnect\n(PCI) controllers adopting the following reference\nspecifications:\n  - PCI Local Bus Specification, revision 3.0, PCI Special Interest Group\n\nThis package is only meant to be used with `GOOS=tamago` as\nsupported by the TamaGo framework for bare metal Go, see\nhttps://github.com/usbarmory/tamago.\n" :imports [


    ^{:line 20} [bits "github.com/usbarmory/tamago/bits"]
    ^{:line 21} [reg "github.com/usbarmory/tamago/internal/reg"]])


(go/const
  ^{:line 25} [^{:val 3320} CONFIG_ADDRESS 0x0cf8]
  ^{:line 26} [^{:val 3324} CONFIG_DATA 0x0cfc])


(go/const
  ^{:line 30} [^{:val 256} maxBuses 256]
  ^{:line 31} [^{:val 32} maxDevices 32])



(go/const "Header Type 0x0 offsets\n"
  ^{:line 36} [^{:val 0} VendorID 0x00]
  ^{:line 37} [^{:val 4} Command 0x04]
  ^{:line 38} [^{:val 8} RevisionID 0x08]
  ^{:line 39} [^{:val 16} Bar0 0x10]
  ^{:line 40} [^{:val 52} CapabilitiesOffset 0x34])



(go/type Device "Device represents a PCI device.\n" (struct

    ^{:line 46 :tag uint32 :doc "Bus number\n"} Bus

    ^{:line 48 :tag uint16 :doc "Vendor ID\n"} Vendor

    ^{:line 50 :tag uint16 :doc "Device ID\n"} Device

    ^{:line 52 :tag uint8 :doc "Revision ID\n"} Revision


    ^{:line 55 :tag uint32 :doc "PCI Slot\n"} Slot))


^{:go/end 60} (go/method address ^uint32 [^{:tag (* Device)} d ^uint32 fn ^uint32 off]
  (bit-or (<< 1 31) (<< (.-Bus d) 16) (<< (.-Slot d) 11) (<< fn 8) (bit-and off 0xfc)))




^{:go/end 67} (go/method Read "Read reads the device configuration space for a given function and\nregister offset.\n" ^uint32 [^{:tag (* Device)} d ^uint32 fn ^uint32 off]
  (reg/Out32 CONFIG_ADDRESS (.address d fn off))
  (>> (reg/In32 CONFIG_DATA) (* (bit-and off 2) 8)))




^{:go/end 78} (go/method Write "Write writes the device configuration space for a given function and\nregister offset, the offset must be 32-bit aligned.\n" [^{:tag (* Device)} d ^uint32 fn ^uint32 off ^uint32 val]
  (when (!= (* (bit-and off 2) 8) 0)
    (return))


  (reg/Out32 CONFIG_ADDRESS (.address d fn off))
  (reg/Out32 CONFIG_DATA val))



^{:go/end 98} (go/method BaseAddress "BaseAddress returns a device Base Address register (BAR).\n" ^uint [^{:tag (* Device)} d ^int n]
  (when (> n 5)
    (return 0))


  ^{:go/breaks [[3 97]]} (let [off (+ Bar0 (* (conv uint32 n) 4))
      ^{:line 87} bar (.Read d 0 (+ Bar0 (* (conv uint32 n) 4)))]

    ;; decode BAR Type
    (switch (bits/GetN (addr bar) 1 2r11)
      (case [2r00]
        (return (conv uint bar)))
      (case [2r10]
        (return (bit-or (<< (conv uint (.Read d 0 (+ off 4))) 32) (bit-and (conv uint bar) 0xfffffff0)))))


    0))


^{:go/end 115} (go/method probe ^bool [^{:tag (* Device)} d]
  (when (> (.-Bus d) maxBuses)
    (return false))


  ^{:go/breaks [[5 114]]} (let [val (.Read d 0 VendorID)]

    (when [(set! (.-Vendor d) (conv uint16 val))] (== (.-Vendor d) 0xffff)
      (return false))


    (set! (.-Device d) (conv uint16 (>> val 16)))
    (set! (.-Revision d) (conv uint8 (.Read d 0 RevisionID)))

    true))



^{:go/end 132} (go/func Probe "Probe probes a PCI device.\n" ^{:tag (* Device)} [^int bus ^uint16 vendor ^uint16 device]
  ^{:go/breaks [[3 131]]} (let [d (addr ^{:go/breaks [2]} (lit Device
          :Bus (conv uint32 bus)))]


    (range [slot (conv uint32 maxDevices)]
      (set! (.-Slot d) slot)

      (when (and (.probe d) (== (.-Vendor d) vendor) (== (.-Device d) device))
        (return d)))



    nil))



^{:go/end 148} (go/func Devices "Devices returns all found PCI devices on a given bus.\n" [^int bus] :results [^{:tag (slice (* Device))} devices]
  (range [slot (conv uint32 maxDevices)]
    (let [d (addr ^{:go/breaks [2 4]} (lit Device
            :Bus (conv uint32 bus)
            :Slot slot))]


      (when (.probe d)
        (set! devices (append devices d)))))



  (return))

(in-ns 'go.github_com.usbarmory.tamago.soc.intel.pci) (go/file "capability.go" :imports [


    ^{:line 12} [binary "encoding/binary"]])






(go/const "Capability IDs\n\n(PCI Code and ID Assignment Specification Revision 1.11\n24 Jan 2019 - 2. Capability IDs).\n"
  ^{:line 20} [^{:val 0} Null 0x00]
  ^{:line 21} [^{:val 1} Power 0x01]
  ^{:line 22} [^{:val 2} AGP 0x02]
  ^{:line 23} [^{:val 3} VPD 0x03]
  ^{:line 24} [^{:val 4} SlotID 0x04]
  ^{:line 25} [^{:val 5} MSI 0x05]
  ^{:line 26} [^{:val 6} HotSwap 0x06]
  ^{:line 27} [^{:val 7} PCIX 0x07]
  ^{:line 28} [^{:val 8} HyperTransport 0x08]
  ^{:line 29} [^{:val 9} VendorSpecific 0x09]
  ^{:line 30} [^{:val 10} Debug 0x0a]
  ^{:line 31} [^{:val 11} CompactPCI 0x0b]
  ^{:line 32} [^{:val 12} HotPlug 0x0c]
  ^{:line 33} [^{:val 13} Bridge 0x0d]
  ^{:line 34} [^{:val 14} AGP8x 0x0e]
  ^{:line 35} [^{:val 15} Secure 0x0f]
  ^{:line 36} [^{:val 16} PCIe 0x10]
  ^{:line 37} [^{:val 17} MSIX 0x11]
  ^{:line 38} [^{:val 18} SATA 0x12]
  ^{:line 39} [^{:val 19} AF 0x13]
  ^{:line 40} [^{:val 20} EA 0x14]
  ^{:line 41} [^{:val 21} FPB 0x15])



(go/type CapabilityHeader "CapabilityHeader represents the common fields of PCI Capabilities entries.\n" (struct
    ^{:line 46 :tag uint8} Vendor
    ^{:line 47 :tag uint8} Next))




^{:go/end 57} (go/method Unmarshal "Unmarshal decodes a PCI Capability common fields from the argument device\nconfiguration space at function 0 and the given register offset.\n" [^{:tag (* CapabilityHeader)} hdr ^{:tag (* Device)} d ^uint32 off] :results [^error err]
  (let [buf (make (slice byte) 4)]
    (.PutUint32 binary/LittleEndian buf (.Read d 0 off))
    (set! (values _ err) (binary/Decode buf binary/LittleEndian hdr))
    (return)))




^{:go/end 79} (go/method Capabilities "Capabilities is an iterator over the entries of the device Capabilities\nList.\n" ^{:tag (func [(func [^uint32 off ^{:tag (* CapabilityHeader)} hdr] [bool])])} [^{:tag (* Device)} d]
  ^{:go/end 78} (fn [^{:tag (func [uint32 (* CapabilityHeader)] [bool])} yield]
    (let [off (.Read d 0 CapabilitiesOffset)]

      (while (!= off 0)
        (let [hdr (addr (lit CapabilityHeader))]

          (when [err (.Unmarshal hdr d off)] (!= err nil)
            (return))


          (when (not (yield off hdr))
            (return))


          (set! off (conv uint32 (.-Next hdr))))))))

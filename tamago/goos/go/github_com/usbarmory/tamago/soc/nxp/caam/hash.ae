(in-ns 'go.github_com.usbarmory.tamago.soc.nxp.caam) (go/file "hash.go" :imports [


    ^{:line 12} [dma "github.com/usbarmory/tamago/dma"]])


^{:go/end 66} (go/method hash [^{:tag (* CAAM)} hw ^{:tag (slice byte)} buf ^int mode ^int size ^bool init ^bool term] :results [^{:tag (slice byte)} sum ^error err]
  (let [sourceBufferAddress (dma/Alloc buf 4)]
    (defer (dma/Free sourceBufferAddress))

    (let [op (lit Operation)]
      (.SetDefaults op)
      (.OpType op OPTYPE_ALG_CLASS2)
      (.Algorithm op mode 0)

      (switch
        (case [(and init term)]
          (.State op (bit-or AS_INITIALIZE AS_FINALIZE)))
        (case [init]
          (.State op AS_INITIALIZE))
        (case [term]
          (.State op AS_FINALIZE))
        (default
          (.State op AS_UPDATE)))


      (let [src (lit FIFOLoad)]
        (.SetDefaults src)
        ^{:go/via [ExtendedLengthCommand Command]} (.Class src 2)
        (.DataType src (bit-or INPUT_DATA_TYPE_MESSAGE_DATA INPUT_DATA_TYPE_LC2))
        ^{:go/via [ExtendedLengthCommand]} (.Pointer src sourceBufferAddress (len buf))

        (let [jd ^{:go/via [Command]} (.Bytes op)]
          (set! jd (append jd (spread ^{:go/via [ExtendedLengthCommand Command]} (.Bytes src))))

          (when term
            (set! sum (make (slice byte) size))

            (let [destinationBufferAddress (dma/Alloc sum 4)]
              (defer (dma/Free destinationBufferAddress))

              (let [dst (lit Store)]
                (.SetDefaults dst)
                ^{:go/via [LengthCommand Command]} (.Class dst 2)
                (.Source dst CTX)
                ^{:go/via [LengthCommand]} (.Pointer dst destinationBufferAddress (len sum))

                (set! jd (append jd (spread ^{:go/via [LengthCommand Command]} (.Bytes dst))))

                (defer (^{:go/end 60} (fn []
                      (dma/Read destinationBufferAddress 0 sum)))))))



          (set! err (.Job hw nil jd))

          (return))))))

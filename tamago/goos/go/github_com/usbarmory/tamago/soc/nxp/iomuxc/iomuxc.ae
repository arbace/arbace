(in-ns 'go.github_com.usbarmory.tamago.soc.nxp.iomuxc) (go/file "iomuxc.go" :doc "Package iomuxc implements helpers for IOMUX configuration on NXP SoCs.\n\nThis package is only meant to be used with `GOOS=tamago` as supported by the\nTamaGo framework for bare metal Go, see https://github.com/usbarmory/tamago.\n" :imports [


    ^{:line 16} [reg "github.com/usbarmory/tamago/internal/reg"]])



(go/const "IOMUXC registers\n"
  ^{:line 21} [^{:val 16} SW_PAD_CTL_HYS 16]

  ^{:line 23} [^{:val 14} SW_PAD_CTL_PUS 14]
  ^{:line 24} [^{:val 0} SW_PAD_CTL_PUS_PULL_DOWN_100K 2r00]
  ^{:line 25} [^{:val 1} SW_PAD_CTL_PUS_PULL_UP_47K 2r01]
  ^{:line 26} [^{:val 2} SW_PAD_CTL_PUS_PULL_UP_100K 2r10]
  ^{:line 27} [^{:val 3} SW_PAD_CTL_PUS_PULL_UP_22K 2r11]

  ^{:line 29} [^{:val 13} SW_PAD_CTL_PUE 13]
  ^{:line 30} [^{:val 12} SW_PAD_CTL_PKE 12]
  ^{:line 31} [^{:val 11} SW_PAD_CTL_ODE 11]

  ^{:line 33} [^{:val 6} SW_PAD_CTL_SPEED 6]
  ^{:line 34} [^{:val 0} SW_PAD_CTL_SPEED_50MHZ 2r00]
  ^{:line 35} [^{:val 2} SW_PAD_CTL_SPEED_100MHZ 2r10]
  ^{:line 36} [^{:val 3} SW_PAD_CTL_SPEED_200MHZ 2r11]

  ^{:line 38} [^{:val 3} SW_PAD_CTL_DSE 3]
  ^{:line 39} [^{:val 0} SW_PAD_CTL_DSE_OUTPUT_DRIVER_DISABLED 2r000]
  ^{:line 40} [^{:val 2} SW_PAD_CTL_DSE_2_R0_2 2r010]
  ^{:line 41} [^{:val 3} SW_PAD_CTL_DSE_2_R0_3 2r011]
  ^{:line 42} [^{:val 4} SW_PAD_CTL_DSE_2_R0_4 2r100]
  ^{:line 43} [^{:val 5} SW_PAD_CTL_DSE_2_R0_5 2r101]
  ^{:line 44} [^{:val 6} SW_PAD_CTL_DSE_2_R0_6 2r110]
  ^{:line 45} [^{:val 7} SW_PAD_CTL_DSE_2_R0_7 2r111]

  ^{:line 47} [^{:val 0} SW_PAD_CTL_SRE 0]

  ^{:line 49} [^{:val 4} SW_MUX_CTL_SION 4]
  ^{:line 50} [^{:val 0} SW_MUX_CTL_MUX_MODE 0])



(go/type Pad "Pad instance.\n" (struct

    ^{:line 56 :tag uint32 :doc "Mux register (e.g. IOMUXC_SW_MUX_CTL_PAD_*)\n"} Mux

    ^{:line 58 :tag uint32 :doc "Pad register (e.g. IOMUXC_SW_PAD_CTL_PAD_*)\n"} Pad

    ^{:line 60 :tag uint32 :doc "Daisy register (e.g. IOMUXC_*_SELECT_INPUT)\n"} Daisy))



^{:go/end 73} (go/func Init "Init initializes a pad.\n" [^uint32 mux ^uint32 pad ^uint32 mode] :results [^{:tag (* Pad)} p]
  (set! p (addr ^{:go/breaks [2 4]} (lit Pad
        :Mux mux
        :Pad pad)))


  (.Mode p mode)

  (return))



^{:go/end 78} (go/method Mode "Mode configures the pad iomux mode.\n" [^{:tag (* Pad)} pad ^uint32 mode]
  (reg/SetN (.-Mux pad) SW_MUX_CTL_MUX_MODE 2r1111 mode))



^{:go/end 83} (go/method SoftwareInput "SoftwareInput configures the pad SION bit.\n" [^{:tag (* Pad)} pad ^bool enabled]
  (reg/SetTo (.-Mux pad) SW_MUX_CTL_SION enabled))



^{:go/end 88} (go/method Ctl "Ctl configures the pad control register.\n" [^{:tag (* Pad)} pad ^uint32 ctl]
  (reg/Write (.-Pad pad) ctl))



^{:go/end 97} (go/method Select "Select configures the pad daisy chain register.\n" [^{:tag (* Pad)} pad ^uint32 input]
  (when (== (.-Daisy pad) 0)
    (return))


  (reg/Write (.-Daisy pad) input))

(in-ns 'go.github_com.usbarmory.tamago.soc.nxp.enet) (go/file "mii.go" :imports [


    ^{:line 12} [errors "errors"]
    ^{:line 13} [time "time"]

    ^{:line 15} [mdio "github.com/usbarmory/tamago/internal/mdio"]
    ^{:line 16} [reg "github.com/usbarmory/tamago/internal/reg"]])



(go/const ^{:val 1000000000 :doc "Timeout is the default timeout for MIIM operations.\n"} Timeout (* 1 time/Second))



^{:go/end 36} (go/method MDIO22 "MDIO22 transmits an MII frame (IEEE 802.3-2008 Clause 22) to a connected\nEthernet PHY, the transacted frame is returned.\n" [^{:tag (* ENET)} hw ^int op ^int pa ^int ra ^uint16 data] :results [^uint32 frame ^error err]
  (reg/Set (.-eir hw) IRQ_MII)
  (defer (reg/Set (.-eir hw) IRQ_MII))

  (set! frame (mdio/Frame mdio/ST (conv uint32 op) (conv uint32 pa) (conv uint32 ra) mdio/TA data))
  (reg/Write (.-mmfr hw) frame)

  (when (not (reg/WaitFor (.-Timeout hw) (.-eir hw) IRQ_MII 1 1))
    (return 0 (errors/New "command timeout")))


  (return (reg/Read (.-mmfr hw)) nil))




^{:go/end 52} (go/method MDIO45 "MDIO45 transmits an MII frame (IEEE 802.3-2008 Clause 45) to a connected\nEthernet PHY, the transacted frame is returned.\n" [^{:tag (* ENET)} hw ^int op ^int prtad ^int devad ^uint16 data] :results [^uint32 frame ^error err]
  (reg/Set (.-eir hw) IRQ_MII)
  (defer (reg/Set (.-eir hw) IRQ_MII))

  (set! frame (mdio/Frame mdio/ST_45 (conv uint32 op) (conv uint32 prtad) (conv uint32 devad) mdio/TA_45 data))
  (reg/Write (.-mmfr hw) frame)

  (when (not (reg/WaitFor (.-Timeout hw) (.-eir hw) IRQ_MII 1 1))
    (return 0 (errors/New "command timeout")))


  (return (reg/Read (.-mmfr hw)) nil))




^{:go/end 59} (go/method ReadPHYRegister "ReadPHYRegister reads a standard management register of a connected Ethernet\nPHY (IEEE 802.3-2008 Clause 22).\n" [^{:tag (* ENET)} hw ^int pa ^int ra] :results [^uint16 data ^error err]
  (let [(values frame ^:assign err) (.MDIO22 hw mdio/OP_READ pa ra 0)]
    (return (conv uint16 frame) err)))




^{:go/end 66} (go/method WritePHYRegister "WritePHYRegister writes a standard management register of a connected\nEthernet PHY (IEEE 802.3-2008 Clause 22).\n" [^{:tag (* ENET)} hw ^int pa ^int ra ^uint16 data] :results [^error err]
  (set! (values _ err) (.MDIO22 hw mdio/OP_WRITE pa ra data))
  (return))

;; Package caam implements a driver for the NXP Cryptographic Acceleration and
;; Assurance Module (CAAM) adopting the following reference specifications:
;;   - IMX6ULSRM - i.MX6UL Security Reference Manual - Rev 0 04/2016
;;   - IMX7DSSRM - i.MX7DS Security Reference Manual - Rev 0 03/2017
;;   - IMX8MPSRM - i.MX8MP Security Reference Manual - Rev A 06/2020
;;
;; This package is only meant to be used with `GOOS=tamago` as supported by the
;; TamaGo framework for bare metal Go, see https://github.com/usbarmory/tamago.
(in-ns 'go.github_com.usbarmory.tamago.soc.nxp.caam) (go/file "caam.go" :doc "Package caam implements a driver for the NXP Cryptographic Acceleration and\nAssurance Module (CAAM) adopting the following reference specifications:\n  - IMX6ULSRM - i.MX6UL Security Reference Manual - Rev 0 04/2016\n  - IMX7DSSRM - i.MX7DS Security Reference Manual - Rev 0 03/2017\n  - IMX8MPSRM - i.MX8MP Security Reference Manual - Rev A 06/2020\n\nThis package is only meant to be used with `GOOS=tamago` as supported by the\nTamaGo framework for bare metal Go, see https://github.com/usbarmory/tamago.\n" :imports [


    ^{:line 20} [sync "sync"]

    ^{:line 22} [dma "github.com/usbarmory/tamago/dma"]
    ^{:line 23} [reg "github.com/usbarmory/tamago/internal/reg"]])



(go/const "CAAM registers\n"
  ^{:line 28} [^{:val 12} CAAM_SCFGR 0xc]
  ^{:line 29} [^{:val 9} SCFGR_RNGSH0 9]
  ^{:line 30} [^{:val 8} SCFGR_RANDDPAR 8]

  ^{:line 32} [^{:val 1536} CAAM_RTMCTL 0x600]
  ^{:line 33} [^{:val 16} RTMCTL_PRGM 16]
  ^{:line 34} [^{:val 10} RTMCTL_ENT_VAL 10]
  ^{:line 35} [^{:val 6} RTMCTL_RST_DEF 6]
  ^{:line 36} [^{:val 5} RTMCTL_TRNG_ACC 5]

  ^{:line 38} [^{:val 1600} CAAM_RTENT0 0x640]
  ^{:line 39} [^{:val 1660} CAAM_RTENT15 0x67c]

  ^{:line 41} [^{:val 32836} CAAM_C0CWR 0x8044]
  ^{:line 42} [^{:val 0} C0CWR_C1M 0])




(go/type CAAM "CAAM represents the Cryptographic Acceleration and Assurance Module\ninstance.\n" (struct
    ^{:line 48} sync/Mutex


    ^{:line 51 :tag uint32 :doc "Base register\n"} Base

    ^{:line 53 :tag uint32 :doc "Clock gate register\n"} CCGR

    ^{:line 55 :tag int :doc "Clock gate\n"} CG











    ^{:line 67 :tag (* dma/Region) :doc "DeriveKeyMemory represents the DMA memory region where the CAAM blob\nkey encryption key (BKEK), derived from the hardware unique key, is\nplaced to derive diversified keys. The memory region must be\ninitialized before DeriveKey().\n\nWhen BEE is not used to encrypt external RAM it is recommended to\nuse a DMA region within the internal RAM (e.g. On-Chip OCRAM/iRAM).\n\nThe DeriveKey() function uses DeriveKeyMemory only if the default\nDMA region start does not overlap with it.\n"} DeriveKeyMemory


    ^{:line 70 :tag bool :doc "Disable Timing Equalization protections (when supported)\n"} DisableTimingEqualization


    ^{:line 73 :tag uint32 :doc "control registers\n"} scfgr
    ^{:line 74 :tag uint32} rtmctl
    ^{:line 75 :tag uint32} rtent0
    ^{:line 76 :tag uint32} rtent15


    ^{:line 79 :tag uint32 :doc "current RTENTa register\n"} rtenta


    ^{:line 82 :tag (* jobRing) :doc "default job ring\n"} jr))



^{:go/end 123} (go/method Init "Init initializes the CAAM module.\n" [^{:tag (* CAAM)} hw]
  ^{:go/via [Mutex]} (.Lock hw)
  (defer ^{:go/via [Mutex]} (.Unlock hw))

  (when (== (.-Base hw) 0)
    (panic "invalid CAAM instance"))


  (set! (.-scfgr hw) (+ (.-Base hw) CAAM_SCFGR))
  (set! (.-rtmctl hw) (+ (.-Base hw) CAAM_RTMCTL))
  (set! (.-rtent0 hw) (+ (.-Base hw) CAAM_RTENT0))
  (set! (.-rtent15 hw) (+ (.-Base hw) CAAM_RTENT15))

  (when (!= (.-CCGR hw) 0)
    ;; enable clock
    (reg/SetN (.-CCGR hw) (.-CG hw) 2r11 2r11))


  ;; enter program mode
  (reg/Set (.-rtmctl hw) RTMCTL_PRGM)
  ;; reset defaults
  (reg/Set (.-rtmctl hw) RTMCTL_RST_DEF)

  ;; enable entropy generation
  (set! (.-rtenta hw) (.-rtent0 hw))

  ;; force entropy re-generation
  (reg/Set (.-rtmctl hw) RTMCTL_TRNG_ACC)
  (defer (reg/Clear (.-rtmctl hw) RTMCTL_TRNG_ACC))

  ;; disable RNG deterministic mode
  (reg/Set (.-scfgr hw) SCFGR_RNGSH0)
  ;; enable Random Differential Power Analysis Resistance
  (reg/Set (.-scfgr hw) SCFGR_RANDDPAR)

  ;; enter run mode
  (reg/Clear (.-rtmctl hw) RTMCTL_PRGM))

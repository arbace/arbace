;; Package spi implements a driver for NXP SPI controllers adopting the
;; following reference specifications:
;;   - IMX6ULLRM - i.MX 6ULL Applications Processor Reference Manual - Rev 1 2017/11
;;
;; This package is only meant to be used with `GOOS=tamago` as
;; supported by the TamaGo framework for bare metal Go, see
;; https://github.com/usbarmory/tamago.
(in-ns 'go.github_com.usbarmory.tamago.soc.nxp.spi) (go/file "ecspi.go" :doc "Package spi implements a driver for NXP SPI controllers adopting the\nfollowing reference specifications:\n  - IMX6ULLRM - i.MX 6ULL Applications Processor Reference Manual - Rev 1 2017/11\n\nThis package is only meant to be used with `GOOS=tamago` as\nsupported by the TamaGo framework for bare metal Go, see\nhttps://github.com/usbarmory/tamago.\n" :imports [


    ^{:line 19} [binary "encoding/binary"]
    ^{:line 20} [errors "errors"]
    ^{:line 21} [sync "sync"]
    ^{:line 22} [time "time"]

    ^{:line 24} [reg "github.com/usbarmory/tamago/internal/reg"]])




(go/const "SPI registers\n(p805, 20.7 ECSPI memory map, IMX6ULLRM)\n"


  ^{:line 32} [^{:val 14 :doc "The default divider values correspond to a resulting SPI clock of 1\nMHz.\n"} ECSPI_DEFAULT_PRE_DIVIDER 14]
  ^{:line 33} [^{:val 2} ECSPI_DEFAULT_POST_DIVIDER 2]

  ^{:line 35} [^{:val 0} ECSPIx_RXDATA 0x00]
  ^{:line 36} [^{:val 4} ECSPIx_TXDATA 0x04]

  ^{:line 38} [^{:val 8} ECSPIx_CONREG 0x08]
  ^{:line 39} [^{:val 20} CONREG_BURST_LENGTH 20]
  ^{:line 40} [^{:val 18} CONREG_CHANNEL_SELECT 18]
  ^{:line 41} [^{:val 12} CONREG_PRE_DIVIDER 12]
  ^{:line 42} [^{:val 8} CONREG_POST_DIVIDER 8]
  ^{:line 43} [^{:val 4} CONREG_CHANNEL_MODE 4]
  ^{:line 44} [^{:val 2} CONREG_XCH 2]
  ^{:line 45} [^{:val 0} CONREG_EN 0]

  ^{:line 47} [^{:val 12} ECSPIx_CONFIGREG 0x0c]
  ^{:line 48} [^{:val 4} CONFIGREG_SCLK_POL 4]
  ^{:line 49} [^{:val 0} CONFIGREG_SCLK_PHA 0]

  ^{:line 51} [^{:val 24} ECSPIx_STATREG 0x18]
  ^{:line 52} [^{:val 7} STATREG_TC 7]
  ^{:line 53} [^{:val 3} STATREG_RR 3]
  ^{:line 54} [^{:val 2} STATREG_TF 2]

  ^{:line 56} [^{:val 64} ECSPIx_MSGDATA 0x40])



(go/const ^{:val 100000000 :doc "Timeout is the default timeout for SPI operations.\n"} Timeout (* 100 time/Millisecond))


(go/type ECSPI "ECSPI represents an ECSPI port instance.\n" (struct
    ^{:line 64} sync/Mutex


    ^{:line 67 :tag int :doc "Controller index\n"} Index

    ^{:line 69 :tag uint32 :doc "Base register\n"} Base

    ^{:line 71 :tag uint32 :doc "Clock gate register\n"} CCGR

    ^{:line 73 :tag int :doc "Clock gate\n"} CG

    ^{:line 75 :tag (func [] [uint32]) :doc "Clock retrieval function\n"} Clock


    ^{:line 78 :tag int :doc "PreDiv sets the 1st stage SPI frequency divider\n"} PreDiv

    ^{:line 80 :tag int :doc "PostDiv sets the 2nd stage SPI frequency divider\n"} PostDiv

    ^{:line 82 :tag time/Duration :doc "Timeout for SPI operations\n"} Timeout


    ^{:line 85 :tag int :doc "Channel defines the Chip Select assertion on [Transfer]\n"} Channel


    ^{:line 88 :tag int :doc "Mode defines the clock polarization mode\n"} Mode


    ^{:line 91 :tag uint32 :doc "control registers\n"} rxdata
    ^{:line 92 :tag uint32} txdata
    ^{:line 93 :tag uint32} conreg
    ^{:line 94 :tag uint32} configreg
    ^{:line 95 :tag uint32} statreg))




^{:go/end 143} (go/method Init "Init initializes an ECSPI controller instance in master mode 0 (CPOL=0\nCPHA=0).\n" [^{:tag (* ECSPI)} hw]
  ^{:go/via [Mutex]} (.Lock hw)
  (defer ^{:go/via [Mutex]} (.Unlock hw))

  (when (or (== (.-Base hw) 0) (== (.-CCGR hw) 0))
    (panic "invalid ECSPI controller instance"))


  (when (== (.-Timeout hw) 0)
    (set! (.-Timeout hw) Timeout))


  (set! (.-rxdata hw) (+ (.-Base hw) ECSPIx_RXDATA))
  (set! (.-txdata hw) (+ (.-Base hw) ECSPIx_TXDATA))
  (set! (.-conreg hw) (+ (.-Base hw) ECSPIx_CONREG))
  (set! (.-configreg hw) (+ (.-Base hw) ECSPIx_CONFIGREG))
  (set! (.-statreg hw) (+ (.-Base hw) ECSPIx_STATREG))

  ;; p804, 20.5 Initialization, IMX6ULLRM

  ;; reset
  (reg/Clear (.-conreg hw) CONREG_EN)

  ;; set 8-bit burst length
  (reg/SetN (.-conreg hw) CONREG_BURST_LENGTH 0xfff 7)

  ;; enable clock
  (reg/SetN (.-CCGR hw) (.-CG hw) 2r11 2r11)

  ;; set master mode for all channels
  (reg/SetN (.-conreg hw) CONREG_CHANNEL_MODE 0xf 0xf)

  (when (and (== (.-PreDiv hw) 0) (== (.-PostDiv hw) 0))
    (set! (.-PreDiv hw) ECSPI_DEFAULT_PRE_DIVIDER)
    (set! (.-PostDiv hw) ECSPI_DEFAULT_POST_DIVIDER))


  ;; set SPI frequency
  (reg/SetN (.-conreg hw) CONREG_PRE_DIVIDER 0xf (conv uint32 (.-PreDiv hw)))
  (reg/SetN (.-conreg hw) CONREG_POST_DIVIDER 0xf (conv uint32 (.-PostDiv hw)))

  ;; out of reset
  (reg/Set (.-conreg hw) CONREG_EN))



^{:go/end 153} (go/method GetFreq "GetFreq returns the frequency of SCLK line.\n" [^{:tag (* ECSPI)} hw] :results [^uint32 freq]

  (let [pre (reg/GetN (.-conreg hw) CONREG_PRE_DIVIDER 0xf)
      ^{:line 149} post (reg/GetN (.-conreg hw) CONREG_POST_DIVIDER 0xf)]
    (set! freq (>> (/ ((.-Clock hw)) (+ pre 1)) post))

    (return)))




^{:go/end 240} (go/method Transfer "Transfer performs a full-duplex SPI exchange in-place. On return, buf\ncontains the received bytes.\n" [^{:tag (* ECSPI)} hw ^{:tag (slice byte)} buf] :results [^error err]
  ^{:go/via [Mutex]} (.Lock hw)
  (defer ^{:go/via [Mutex]} (.Unlock hw))

  (when (or (< (.-Channel hw) 0) (> (.-Channel hw) 3))
    (return (errors/New "invalid channel")))


  (reg/SetN (.-conreg hw) CONREG_CHANNEL_SELECT 2r11 (conv uint32 (.-Channel hw)))
  (reg/SetN (.-conreg hw) CONREG_BURST_LENGTH 0xfff (- (conv uint32 (* (len buf) 8)) 1))

  (let [(values ^uint32 sclk_pol ^uint32 sclk_pha) (zero uint32)]

    (switch (.-Mode hw)
      (case [0]
        (set! sclk_pol 0)
        (set! sclk_pha 0))
      (case [1]
        (set! sclk_pol 0)
        (set! sclk_pha 1))
      (case [2]
        (set! sclk_pol 1)
        (set! sclk_pha 0))
      (case [3]
        (set! sclk_pol 1)
        (set! sclk_pha 1)))


    (reg/SetN (.-configreg hw) CONFIGREG_SCLK_POL ^int (<< 1 (.-Channel hw)) sclk_pol)
    (reg/SetN (.-configreg hw) CONFIGREG_SCLK_PHA ^int (<< 1 (.-Channel hw)) sclk_pha)

    (let [^{:tag (slice byte)} b (zero (slice byte))]

      (for [i 0] (< i (len buf)) (set! i + 4)
        (when (reg/Get (.-statreg hw) STATREG_TF)
          (return (errors/New "transmit FIFO full")))


        (set! b (subslice buf i))

        (when [n (% (len b) 4)] (!= n 0)
          (set! b (append (make (slice byte) (- 4 n)) (spread b)))
          (set! i - (- 4 n)))


        (reg/Write (.-txdata hw) (.Uint32 binary/BigEndian b)))


      ;; initiate exchange
      (reg/Set (.-conreg hw) CONREG_XCH)

      ;; wait for exchange completion
      (when (not (reg/WaitFor (.-Timeout hw) (.-conreg hw) CONREG_XCH 1 0))
        (return (errors/New "exchange timeout")))


      ;; wait for transfer completion
      (when (not (reg/WaitFor (.-Timeout hw) (.-statreg hw) STATREG_TC 1 1))
        (return (errors/New "transfer timout")))


      ;; read response
      (for [i 0] (< i (len buf)) (set! i + 4)
        (when (not (reg/Get (.-statreg hw) STATREG_RR))
          (break))


        (set! b (subslice buf i))

        (if [n (% (len b) 4)] (!= n 0)
          (let [r (make (slice byte) 4)]
            (.PutUint32 binary/BigEndian r (reg/Read (.-rxdata hw)))
            (copy b r)
            (set! i - (- 4 n)))

          (.PutUint32 binary/BigEndian b (reg/Read (.-rxdata hw)))))



      ;; clear transfer completion
      (reg/Set (.-statreg hw) STATREG_TC)

      (return))))

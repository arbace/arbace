(ns go.github_com.usbarmory.tamago.soc.nxp.usdhc
  (:require [arbace.go :as go]))

(go/package usdhc
  :path "github.com/usbarmory/tamago/soc/nxp/usdhc"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["adma.go" "cmd.go" "mmc.go" "sd.go" "usdhc.go"]
  :init-order [cmds]
  :positions :lines)

(load "usdhc/adma")
(load "usdhc/cmd")
(load "usdhc/mmc")
(load "usdhc/sd")
(load "usdhc/usdhc")

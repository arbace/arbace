;; Package csu implements a driver for the NXP Central Security Unit (CSU)
;; adopting the following reference specifications:
;;   - IMX6ULLRM  - i.MX 6ULL Applications Processor Reference Manual          - Rev 1 2017/11
;;   - IMX6ULLSRM - i.MX 6ULL Applications Processor Security Reference Manual - Rev 0 2016/09
;;
;; This package is only meant to be used with `GOOS=tamago` as supported by the
;; TamaGo framework for bare metal Go, see https://github.com/usbarmory/tamago.
(in-ns 'go.github_com.usbarmory.tamago.soc.nxp.csu) (go/file "csu.go" :doc "Package csu implements a driver for the NXP Central Security Unit (CSU)\nadopting the following reference specifications:\n  - IMX6ULLRM  - i.MX 6ULL Applications Processor Reference Manual          - Rev 1 2017/11\n  - IMX6ULLSRM - i.MX 6ULL Applications Processor Security Reference Manual - Rev 0 2016/09\n\nThis package is only meant to be used with `GOOS=tamago` as supported by the\nTamaGo framework for bare metal Go, see https://github.com/usbarmory/tamago.\n" :imports [


    ^{:line 19} [errors "errors"]

    ^{:line 21} [reg "github.com/usbarmory/tamago/internal/reg"]])



(go/const "CSU registers\n"
  ^{:line 26} [^{:val 0} CSU_CSL0 0x00]
  ^{:line 27} [^{:val 536} CSU_SA 0x218])



(go/type CSU "CSU represents the Central Security Unit instance.\n" (struct

    ^{:line 33 :tag uint32 :doc "Base register\n"} Base

    ^{:line 35 :tag uint32 :doc "Clock gate register\n"} CCGR

    ^{:line 37 :tag int :doc "Clock gate\n"} CG


    ^{:line 40 :tag uint32 :doc "control registers\n"} csl0
    ^{:line 41 :tag uint32} sa))



^{:go/end 55} (go/method Init "Init initializes the Central Security Unit (CSU).\n" [^{:tag (* CSU)} hw]
  (when (or (== (.-Base hw) 0) (== (.-CCGR hw) 0))
    (panic "invalid CSU instance"))


  (set! (.-csl0 hw) (+ (.-Base hw) CSU_CSL0))
  (set! (.-sa hw) (+ (.-Base hw) CSU_SA))

  ;; enable clock
  (reg/SetN (.-CCGR hw) (.-CG hw) 2r11 2r11))





^{:go/end 76} (go/method GetAccess "GetAccess returns the security access (SA) for one of the 16 masters IDs.\nThe lock return value indicates whether the SA is locked for changes until\nthe next power cycle.\n" [^{:tag (* CSU)} hw ^int id] :results [^bool secure ^bool lock ^error err]
  (when (or (< id SA_MIN) (> id SA_MAX))
    (return false false (errors/New "index out of range")))


  (let [val (reg/GetN (.-sa hw) (* id 2) 2r11)]

    (when (== (bit-and val 2r01) 0)
      (set! secure true))


    (when (!= (bit-and val 2r10) 0)
      (set! lock true))


    (return)))





^{:go/end 93} (go/method SetAccess "SetAccess configures the security access (SA) for one of the 16 masters IDs.\nThe lock argument controls whether the SA is locked for changes until the\nnext power cycle.\n" [^{:tag (* CSU)} hw ^int id ^bool secure ^bool lock] :results [^error err]
  (when (or (< id SA_MIN) (> id SA_MAX))
    (return (errors/New "index out of range")))


  (reg/SetTo (.-sa hw) (* id 2) (not secure))

  (when lock
    (reg/Set (.-sa hw) (+ (* id 2) 1)))


  (return))

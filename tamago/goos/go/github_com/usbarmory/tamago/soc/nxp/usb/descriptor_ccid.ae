(in-ns 'go.github_com.usbarmory.tamago.soc.nxp.usb) (go/file "descriptor_ccid.go" :imports [


    ^{:line 12} [bytes "bytes"]
    ^{:line 13} [binary "encoding/binary"]])



(go/const "CCID descriptor constants\n"

  ^{:line 19} [^{:val 11 :doc "p16, Table 4.3-1, CCID Rev1.1\n"} SMARTCARD_DEVICE_CLASS 0x0b]


  ^{:line 22} [^{:val 33 :doc "p17, Table 5.1-1, CCID Rev1.1\n"} CCID_INTERFACE 0x21]
  ^{:line 23} [^{:val 54} CCID_DESCRIPTOR_LENGTH 54])



(go/type CCIDDescriptor "CCIDDescriptor implements p17, Table 5.1-1, CCID Rev1.1\n" (struct
    ^{:line 28 :tag uint8} Length
    ^{:line 29 :tag uint8} DescriptorType
    ^{:line 30 :tag uint16} CCID
    ^{:line 31 :tag uint8} MaxSlotIndex
    ^{:line 32 :tag uint8} VoltageSupport
    ^{:line 33 :tag uint32} Protocols
    ^{:line 34 :tag uint32} DefaultClock
    ^{:line 35 :tag uint32} MaximumClock
    ^{:line 36 :tag uint8} NumClockSupported
    ^{:line 37 :tag uint32} DataRate
    ^{:line 38 :tag uint32} MaxDataRate
    ^{:line 39 :tag uint8} NumDataRatesSupported
    ^{:line 40 :tag uint32} MaxIFSD
    ^{:line 41 :tag uint32} SynchProtocols
    ^{:line 42 :tag uint32} Mechanical
    ^{:line 43 :tag uint32} Features
    ^{:line 44 :tag uint32} MaxCCIDMessageLength
    ^{:line 45 :tag uint8} ClassGetResponse
    ^{:line 46 :tag uint8} ClassEnvelope
    ^{:line 47 :tag uint16} LcdLayout
    ^{:line 48 :tag uint8} PINSupport
    ^{:line 49 :tag uint8} MaxCCIDBusySlots))




^{:go/end 58} (go/method SetDefaults "SetDefaults initializes default values for the USB Smart Card Device Class\nDescriptor.\n" [^{:tag (* CCIDDescriptor)} d]
  (set! (.-Length d) CCID_DESCRIPTOR_LENGTH)
  (set! (.-DescriptorType d) CCID_INTERFACE)
  (set! (.-CCID d) 0x0110))



^{:go/end 65} (go/method Bytes "Bytes converts the descriptor structure to byte array format.\n" ^{:tag (slice byte)} [^{:tag (* CCIDDescriptor)} d]
  (let [buf (new bytes/Buffer)]
    (binary/Write buf binary/LittleEndian d)
    (.Bytes buf)))

(in-ns 'go.github_com.usbarmory.tamago.soc.nxp.imx8mp) (go/file "clock.go" :imports [])


(go/const "Clock registers\n"
  ^{:line 13} [^{:val 808847360} CCM_ANALOG_DIGPROG 0x30360800]
  ^{:line 14} [^{:val 808992768} CCM_CCGR_BASE 0x30384000]

  ^{:line 16} [^{:val 808992928} CCM_CCGR10 (+ CCM_CCGR_BASE 0x00a0)]
  ^{:line 17} [^{:val 808993312} CCM_CCGR34 (+ CCM_CCGR_BASE 0x0220)]
  ^{:line 18} [^{:val 808993904} CCM_CCGR71 (+ CCM_CCGR_BASE 0x0470)]
  ^{:line 19} [^{:val 808993936} CCM_CCGR73 (+ CCM_CCGR_BASE 0x0490)]
  ^{:line 20} [^{:val 808993952} CCM_CCGR74 (+ CCM_CCGR_BASE 0x04a0)]
  ^{:line 21} [^{:val 808994096} CCM_CCGR83 (+ CCM_CCGR_BASE 0x0530)]
  ^{:line 22} [^{:val 808994112} CCM_CCGR84 (+ CCM_CCGR_BASE 0x0540)]
  ^{:line 23} [^{:val 808994128} CCM_CCGR85 (+ CCM_CCGR_BASE 0x0550)])




(go/const "Clocks at boot time\n(p749, Table 6-4. Clock root setting by ROM, IMX8MPRM)\n"
  ^{:line 29} [^{:val 1000000000} ARM_FREQ 1000000000] ; 1GHz
  ^{:line 30} [^{:val 133000000} AHB_FREQ 133000000] ; 133MHz
  ^{:line 31} [^{:val 24000000} REF_FREQ 24000000]) ; 24MHz



^{:go/end 37} (go/func ARMFreq "ARMFreq returns the ARM core frequency.\n" [] :results [^uint32 hz]
  ^{:line 36} ARM_FREQ) ; TODO: default is assumed




^{:go/end 44} (go/func GetPeripheralClock "GetPeripheralClock returns the IPG_CLK_ROOT frequency,\n(p253, Figure 5-3. CCM Clock Tree Root Slics, IMX8MPRM).\n" ^uint32 []
  ;; IPG_CLK_ROOT derived from AHB_CLK_ROOT which is 133 MHz
  ^{:line 43} AHB_FREQ) ; TODO: default is assumed




^{:go/end 50} (go/func GetUARTClock "GetUARTClock returns the UART_CLK_ROOT frequency,\n(p253, Figure 5-3. CCM Clock Tree Root Slics, IMX8MPRM).\n" ^uint32 []
  ^{:line 49} REF_FREQ) ; TODO: default is assumed

;; Package gpio implements helpers for GPIO configuration on NXP SoCs.
;;
;; This package is only meant to be used with `GOOS=tamago` as supported by the
;; TamaGo framework for bare metal Go, see https://github.com/usbarmory/tamago.
(in-ns 'go.github_com.usbarmory.tamago.soc.nxp.gpio) (go/file "gpio.go" :doc "Package gpio implements helpers for GPIO configuration on NXP SoCs.\n\nThis package is only meant to be used with `GOOS=tamago` as supported by the\nTamaGo framework for bare metal Go, see https://github.com/usbarmory/tamago.\n" :imports [


    ^{:line 16} [errors "errors"]
    ^{:line 17} [fmt "fmt"]

    ^{:line 19} [reg "github.com/usbarmory/tamago/internal/reg"]])



(go/const "GPIO registers\n"
  ^{:line 24} [^{:val 0} GPIO_DR 0x00]
  ^{:line 25} [^{:val 4} GPIO_GDIR 0x04])



(go/type GPIO "GPIO controller instance\n" (struct

    ^{:line 31 :tag int :doc "Controller index\n"} Index

    ^{:line 33 :tag uint32 :doc "Base register\n"} Base

    ^{:line 35 :tag uint32 :doc "Clock gate register\n"} CCGR

    ^{:line 37 :tag int :doc "Clock gate\n"} CG

    ^{:line 39 :tag bool} clk))



(go/type Pin "Pin instance\n" (struct
    ^{:line 44 :tag int} num
    ^{:line 45 :tag uint32} data
    ^{:line 46 :tag uint32} dir))



^{:go/end 72} (go/method Init "Init initializes a GPIO.\n" [^{:tag (* GPIO)} hw ^int num] :results [^{:tag (* Pin)} gpio ^error err]
  (when (or (== (.-Base hw) 0) (== (.-CCGR hw) 0))
    (return nil (errors/New "invalid GPIO controller instance")))


  (when (> num 31)
    (return nil (fmt/Errorf "invalid GPIO number %d" num)))


  (set! gpio (addr ^{:go/breaks [2 4 6]} (lit Pin
        :num num
        :data (+ (.-Base hw) GPIO_DR)
        :dir (+ (.-Base hw) GPIO_GDIR))))


  (when (not (.-clk hw))
    ;; enable clock
    (reg/SetN (.-CCGR hw) (.-CG hw) 2r11 2r11)
    (set! (.-clk hw) true))


  (return))



^{:go/end 77} (go/method Out "Out configures a GPIO as output.\n" [^{:tag (* Pin)} gpio]
  (reg/Set (.-dir gpio) (.-num gpio)))



^{:go/end 82} (go/method In "In configures a GPIO as input.\n" [^{:tag (* Pin)} gpio]
  (reg/Clear (.-dir gpio) (.-num gpio)))



^{:go/end 87} (go/method High "High configures a GPIO signal as high.\n" [^{:tag (* Pin)} gpio]
  (reg/Set (.-data gpio) (.-num gpio)))



^{:go/end 92} (go/method Low "Low configures a GPIO signal as low.\n" [^{:tag (* Pin)} gpio]
  (reg/Clear (.-data gpio) (.-num gpio)))



^{:go/end 97} (go/method Value "Value returns a GPIO signal level.\n" [^{:tag (* Pin)} gpio] :results [^bool high]
  (== (reg/GetN (.-data gpio) (.-num gpio) 1) 1))

(in-ns 'go.github_com.usbarmory.tamago.soc.nxp.csu) (go/file "csl.go" :imports [


    ^{:line 12} [errors "errors"]

    ^{:line 14} [reg "github.com/usbarmory/tamago/internal/reg"]])


^{:go/end 27} (go/func checkArgs [^int periph ^int slave] :results [^error err]
  (when (or (< periph CSL_MIN) (> periph CSL_MAX))
    (return (errors/New "peripheral index out of range")))


  (when (or (< slave 0) (> slave 1))
    (return (errors/New "slave index out of range")))


  (return))





^{:go/end 45} (go/method GetSecurityLevel "GetSecurityLevel returns the config security level (CSL) registers for a\nperipheral slave. The lock return value indicates whether the CSL is locked\nfor changes until the next power cycle.\n" [^{:tag (* CSU)} hw ^int periph ^int slave] :results [^uint8 csl ^bool lock ^error err]
  (when [(set! err (checkArgs periph slave))] (!= err nil)
    (return))


  (let [val (reg/Read (+ (.-csl0 hw) (conv uint32 (* 4 periph))))]
    (set! csl (conv uint8 (bit-and (>> val (* CSL_S2 slave)) 0xff)))

    (when (== (conv uint8 (bit-and (>> val (+ CSL_S1_LOCK (* CSL_S2 slave))) 1)) 1)
      (set! lock true))


    (return)))





^{:go/end 64} (go/method SetSecurityLevel "SetSecurityLevel sets the config security level (CSL) registers for a\nperipheral slave. The lock argument controls whether the CSL is locked for\nchanges until the next power cycle.\n" [^{:tag (* CSU)} hw ^int periph ^int slave ^uint8 csl ^bool lock] :results [^error err]
  (when [(set! err (checkArgs periph slave))] (!= err nil)
    (return))


  (let [addr (+ (.-csl0 hw) (conv uint32 (* 4 periph)))]

    (reg/SetN addr (* CSL_S2 slave) 0xff (conv uint32 csl))

    (when lock
      (reg/Set addr (+ CSL_S1_LOCK (* CSL_S2 slave))))


    (return)))

(go/type UART "UART represents a serial port instance.\n" (struct

    ^{:line 118 :tag int :doc "Controller index\n"} Index

    ^{:line 120 :tag uint32 :doc "Base register\n"} Base

    ^{:line 122 :tag uint32 :doc "Clock gate register\n"} CCGR

    ^{:line 124 :tag int :doc "Clock gate\n"} CG

    ^{:line 126 :tag (func [] [uint32]) :doc "Clock retrieval function\n"} Clock

    ^{:line 128 :tag uint32 :doc "port speed\n"} Baudrate

    ^{:line 130 :tag bool :doc "DTE mode\n"} DTE

    ^{:line 132 :tag bool :doc "hardware flow control\n"} Flow


    ^{:line 135 :tag uint32 :doc "control registers\n"} urxd
    ^{:line 136 :tag uint32} utxd
    ^{:line 137 :tag uint32} ucr1
    ^{:line 138 :tag uint32} ucr2
    ^{:line 139 :tag uint32} ucr3
    ^{:line 140 :tag uint32} ucr4
    ^{:line 141 :tag uint32} ufcr
    ^{:line 142 :tag uint32} usr2
    ^{:line 143 :tag uint32} uesc
    ^{:line 144 :tag uint32} utim
    ^{:line 145 :tag uint32} ubir
    ^{:line 146 :tag uint32} ubmr
    ^{:line 147 :tag uint32} uts))




^{:go/end 179} (go/method Init "Init initializes and enables the UART for RS-232 mode,\np3605, 55.13.1 Programming the UART in RS-232 mode, IMX6ULLRM.\n" [^{:tag (* UART)} hw]
  (when (or (== (.-Base hw) 0) (== (.-CCGR hw) 0) (== (.-Clock hw) nil))
    (panic "invalid UART controller instance"))


  (when (== (.-Baudrate hw) 0)
    (set! (.-Baudrate hw) UART_DEFAULT_BAUDRATE))


  (set! (.-urxd hw) (+ (.-Base hw) UARTx_URXD))
  (set! (.-utxd hw) (+ (.-Base hw) UARTx_UTXD))
  (set! (.-ucr1 hw) (+ (.-Base hw) UARTx_UCR1))
  (set! (.-ucr2 hw) (+ (.-Base hw) UARTx_UCR2))
  (set! (.-ucr3 hw) (+ (.-Base hw) UARTx_UCR3))
  (set! (.-ucr4 hw) (+ (.-Base hw) UARTx_UCR4))
  (set! (.-ufcr hw) (+ (.-Base hw) UARTx_UFCR))
  (set! (.-usr2 hw) (+ (.-Base hw) UARTx_USR2))
  (set! (.-uesc hw) (+ (.-Base hw) UARTx_UESC))
  (set! (.-utim hw) (+ (.-Base hw) UARTx_UTIM))
  (set! (.-ubir hw) (+ (.-Base hw) UARTx_UBIR))
  (set! (.-ubmr hw) (+ (.-Base hw) UARTx_UBMR))
  (set! (.-uts hw) (+ (.-Base hw) UARTx_UTS))

  ;; enable clock
  (reg/SetN (.-CCGR hw) (.-CG hw) 2r11 2r11)

  (.setup hw))


^{:go/end 269} (go/method setup [^{:tag (* UART)} hw]
  ;; disable UART
  (reg/Write (.-ucr1 hw) 0)
  (reg/Write (.-ucr2 hw) 0)

  ;; wait for software reset deassertion
  (reg/Wait (.-ucr2 hw) UCR2_SRST 1 1)

  (let [^uint32 ucr3 (zero uint32)]
    ;; Data Set Ready
    (bits/Set (addr ucr3) UCR3_DSR)
    ;; Data Carrier Detect
    (bits/Set (addr ucr3) UCR3_DCD)
    ;; Ring Indicator
    (bits/Set (addr ucr3) UCR3_RI)
    ;; Disable autobaud detection
    (bits/Set (addr ucr3) UCR3_ADNIMP)
    ;; UART is in MUXED mode
    (bits/Set (addr ucr3) UCR3_RXDMUXSEL)
    ;; set UCR3
    (reg/Write (.-ucr3 hw) ucr3)

    ;; set escape character
    (reg/Write (.-uesc hw) ESC)
    ;; reset escape timer
    (reg/Write (.-utim hw) 0)

    (let [^uint32 ufcr (zero uint32)]
      ;; Divide input clock by 2
      (bits/SetN (addr ufcr) UFCR_RFDIV 2r111 2r100)
      ;; TxFIFO has 2 or fewer characters
      (bits/SetN (addr ufcr) UFCR_TXTL 2r111111 2)
      ;; RxFIFO has 1 character
      (bits/SetN (addr ufcr) UFCR_RXTL 2r111111 1)

      (when (.-DTE hw)
        (bits/Set (addr ufcr) UFCR_DCEDTE))


      ;; set UFCR
      (reg/Write (.-ufcr hw) ufcr)

      ;; p3592, 55.5 Binary Rate Multiplier (BRM), IMX6ULLRM
      ;;
      ;;              ref_clk_freq
      ;; baudrate = -----------------
      ;;                   UBMR + 1
      ;;             16 * ----------
      ;;                   UBIR + 1
      ;;
      ;; ref_clk_freq = module_clock

      ;; multiply to match UFCR_RFDIV divider value
      (let [ubmr (/ ((.-Clock hw)) (* 2 (.-Baudrate hw)))]
        ;; neutralize denominator
        (reg/Write (.-ubir hw) 15)
        ;; set UBMR
        (reg/Write (.-ubmr hw) ubmr)

        (let [^uint32 ucr2 (zero uint32)]
          ;; 8-bit transmit and receive character length
          (bits/Set (addr ucr2) UCR2_WS)
          ;; Enable the transmitter
          (bits/Set (addr ucr2) UCR2_TXEN)
          ;; Enable the receiver
          (bits/Set (addr ucr2) UCR2_RXEN)
          ;; Software reset
          (bits/Set (addr ucr2) UCR2_SRST)

          (if (.-Flow hw) (do
              ;; Receiver controls CTS
              (bits/Set (addr ucr2) UCR2_CTSC)

              ;; 16 characters in the RxFIFO as the maximum value leads to
              ;; overflow even with hardware flow control in place.
              (reg/SetN (.-ucr4 hw) UCR4_CTSTL 2r111111 16))
            (do
              ;; Ignore the RTS pin
              (bits/Set (addr ucr2) UCR2_IRTS)

              ;; 32 characters in the RxFIFO (maximum)
              (reg/SetN (.-ucr4 hw) UCR4_CTSTL 2r111111 32)))


          ;; set UCR2
          (reg/Write (.-ucr2 hw) ucr2)
          ;; Enable the UART
          (reg/Set (.-ucr1 hw) UCR1_UARTEN))))))




^{:go/end 275} (go/method Enable "Enable enables the UART, this is only required after an explicit disable\n(see Disable()) as initialized interfaces (see Init()) are enabled by default.\n" [^{:tag (* UART)} hw]
  (reg/Set (.-ucr1 hw) UCR1_UARTEN))



^{:go/end 280} (go/method Disable "Disable disables the UART.\n" [^{:tag (* UART)} hw]
  (reg/Clear (.-ucr1 hw) UCR1_UARTEN))



^{:go/end 289} (go/method Tx "Tx transmits a single character to the serial port.\n" [^{:tag (* UART)} hw ^byte c]
  (while (== (reg/GetN (.-uts hw) UTS_TXFULL 1) 1))
  ;; wait for TX FIFO to have room for a character


  (reg/Write (.-utxd hw) (conv uint32 c)))



^{:go/end 304} (go/method Rx "Rx receives a single character from the serial port.\n" [^{:tag (* UART)} hw] :results [^byte c ^bool valid]
  (when (!= (reg/GetN (.-usr2 hw) USR2_RDR 1) 1)
    (return))


  (let [urxd (reg/Read (.-urxd hw))]

    (when (!= (bits/GetN (addr urxd) URXD_PRERR 2r11111) 0)
      (return))


    (return (conv byte (bits/GetN (addr urxd) URXD_RX_DATA 0xff)) true)))



^{:go/end 313} (go/method Write "Write data from buffer to serial port.\n" [^{:tag (* UART)} hw ^{:tag (slice byte)} buf] :results [^int n ^error _]
  (range [_ c buf]
    (.Tx hw c))


  (return (len buf) nil))



^{:go/end 334} (go/method Read "Read available data to buffer from serial port.\n" [^{:tag (* UART)} hw ^{:tag (slice byte)} buf] :results [^int n ^error _]
  (let [^bool valid (zero bool)]

    (while (< n (len buf))
      (set! (values (aget buf n) valid) (.Rx hw))

      (when (not valid)
        (when (== n 0)
          (runtime/Gosched))


        (break))


      (inc! n))


    (return)))

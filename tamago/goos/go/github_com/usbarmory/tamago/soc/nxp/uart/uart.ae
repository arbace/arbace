(in-ns 'go.github_com.usbarmory.tamago.soc.nxp.uart) (go/file "uart.go" :doc "Package uart implements a driver for NXP UART controllers adopting the\nfollowing reference specifications:\n  - IMX6ULLRM - i.MX 6ULL Applications Processor Reference Manual - Rev 1 2017/11\n\nThis package is only meant to be used with `GOOS=tamago` as supported by the\nTamaGo framework for bare metal Go, see https://github.com/usbarmory/tamago.\n" :imports [


    ^{:line 18} [runtime "runtime"]

    ^{:line 20} [bits "github.com/usbarmory/tamago/bits"]
    ^{:line 21} [reg "github.com/usbarmory/tamago/internal/reg"]])



(go/const "UART registers\n"
  ^{:line 26} [^{:val 115200} UART_DEFAULT_BAUDRATE 115200]
  ^{:line 27} [^{:val 27} ESC 0x1b]

  ;; p3608, 55.15 UART Memory Map/Register Definition, IMX6ULLRM

  ^{:line 31} [^{:val 0} UARTx_URXD 0x0000]
  ^{:line 32} [^{:val 15} URXD_CHARRDY 15]
  ^{:line 33} [^{:val 14} URXD_ERR 14]
  ^{:line 34} [^{:val 13} URXD_OVRRUN 13]
  ^{:line 35} [^{:val 12} URXD_FRMERR 12]
  ^{:line 36} [^{:val 11} URXD_BRK 11]
  ^{:line 37} [^{:val 10} URXD_PRERR 10]
  ^{:line 38} [^{:val 0} URXD_RX_DATA 0]

  ^{:line 40} [^{:val 64} UARTx_UTXD 0x0040]
  ^{:line 41} [^{:val 0} UTXD_TX_DATA 0]

  ^{:line 43} [^{:val 128} UARTx_UCR1 0x0080]
  ^{:line 44} [^{:val 15} UCR1_ADEN 15]
  ^{:line 45} [^{:val 14} UCR1_ADBR 14]
  ^{:line 46} [^{:val 13} UCR1_TRDYEN 13]
  ^{:line 47} [^{:val 12} UCR1_IDEN 12]
  ^{:line 48} [^{:val 10} UCR1_ICD 10]
  ^{:line 49} [^{:val 9} UCR1_RRDYEN 9]
  ^{:line 50} [^{:val 8} UCR1_RXDMAEN 8]
  ^{:line 51} [^{:val 7} UCR1_IREN 7]
  ^{:line 52} [^{:val 6} UCR1_TXMPTYEN 6]
  ^{:line 53} [^{:val 5} UCR1_RTSDEN 5]
  ^{:line 54} [^{:val 4} UCR1_SNDBRK 4]
  ^{:line 55} [^{:val 3} UCR1_TXDMAEN 3]
  ^{:line 56} [^{:val 2} UCR1_ATDMAEN 2]
  ^{:line 57} [^{:val 1} UCR1_DOZE 1]
  ^{:line 58} [^{:val 0} UCR1_UARTEN 0]

  ^{:line 60} [^{:val 132} UARTx_UCR2 0x0084]
  ^{:line 61} [^{:val 15} UCR2_ESCI 15]
  ^{:line 62} [^{:val 14} UCR2_IRTS 14]
  ^{:line 63} [^{:val 13} UCR2_CTSC 13]
  ^{:line 64} [^{:val 12} UCR2_CTS 12]
  ^{:line 65} [^{:val 11} UCR2_ESCEN 11]
  ^{:line 66} [^{:val 9} UCR2_RTEC 9]
  ^{:line 67} [^{:val 8} UCR2_PREN 8]
  ^{:line 68} [^{:val 7} UCR2_PROE 7]
  ^{:line 69} [^{:val 6} UCR2_STPB 6]
  ^{:line 70} [^{:val 5} UCR2_WS 5]
  ^{:line 71} [^{:val 4} UCR2_RTSEN 4]
  ^{:line 72} [^{:val 3} UCR2_ATEN 3]
  ^{:line 73} [^{:val 2} UCR2_TXEN 2]
  ^{:line 74} [^{:val 1} UCR2_RXEN 1]
  ^{:line 75} [^{:val 0} UCR2_SRST 0]

  ^{:line 77} [^{:val 136} UARTx_UCR3 0x0088]
  ^{:line 78} [^{:val 14} UCR3_DPEC 14]
  ^{:line 79} [^{:val 13} UCR3_DTREN 13]
  ^{:line 80} [^{:val 12} UCR3_PARERREN 12]

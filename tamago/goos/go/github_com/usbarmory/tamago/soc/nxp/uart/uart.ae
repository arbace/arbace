  ^{:line 83} [^{:val 9} UCR3_DCD 9]
  ^{:line 84} [^{:val 8} UCR3_RI 8]
  ^{:line 85} [^{:val 7} UCR3_ADNIMP 7]
  ^{:line 86} [^{:val 6} UCR3_RXDSEN 6]
  ^{:line 87} [^{:val 5} UCR3_AIRINTEN 5]
  ^{:line 88} [^{:val 4} UCR3_AWAKEN 4]
  ^{:line 89} [^{:val 3} UCR3_DTRDEN 3]
  ^{:line 90} [^{:val 2} UCR3_RXDMUXSEL 2]
  ^{:line 91} [^{:val 1} UCR3_INVT 1]
  ^{:line 92} [^{:val 0} UCR3_ACIEN 0]

  ^{:line 94} [^{:val 140} UARTx_UCR4 0x008c]

^{:go/end 158} (go/method Bytes "Bytes converts the DCP work packet structure to byte array format.\n" ^{:tag (slice byte)} [^{:tag (* WorkPacket)} pkt]
  (let [buf (new bytes/Buffer)]
    (binary/Write buf binary/LittleEndian pkt)
    (.Bytes buf)))



^{:go/end 192} (go/method Init "Init initializes the DCP module.\n" [^{:tag (* DCP)} hw]
  ^{:go/via [Mutex]} (.Lock hw)
  (defer ^{:go/via [Mutex]} (.Unlock hw))

  (when (or (== (.-Base hw) 0) (== (.-CCGR hw) 0))
    (panic "invalid DCP instance"))


  (set! (.-ctrl hw) (+ (.-Base hw) DCP_CTRL))
  (set! (.-stat hw) (+ (.-Base hw) DCP_STAT))
  (set! (.-stat_clr hw) (+ (.-Base hw) DCP_STAT_CLR))
  (set! (.-chctrl hw) (+ (.-Base hw) DCP_CHANNELCTRL))
  (set! (.-key hw) (+ (.-Base hw) DCP_KEY))
  (set! (.-keydata hw) (+ (.-Base hw) DCP_KEYDATA))
  (set! (.-ch0cmdptr hw) (+ (.-Base hw) DCP_CH0CMDPTR))
  (set! (.-ch0sema hw) (+ (.-Base hw) DCP_CH0SEMA))
  (set! (.-ch0stat hw) (+ (.-Base hw) DCP_CH0STAT))
  (set! (.-ch0stat_clr hw) (+ (.-Base hw) DCP_CH0STAT_CLR))

  ;; enable clock
  (reg/SetN (.-CCGR hw) (.-CG hw) 2r11 2r11)

  ;; soft reset DCP
  (reg/Set (.-ctrl hw) CTRL_SFTRST)
  (reg/Clear (.-ctrl hw) CTRL_SFTRST)

  ;; enable DCP
  (reg/Clear (.-ctrl hw) CTRL_CLKGATE)

  ;; enable channel 0
  (reg/Write (.-chctrl hw) DCP_CHANNEL_0))


^{:go/end 230} (go/method cmd [^{:tag (* DCP)} hw ^uint ptr ^int count] :results [^error err]
  ^{:go/via [Mutex]} (.Lock hw)
  (defer ^{:go/via [Mutex]} (.Unlock hw))

  (when (!= (reg/Read (.-chctrl hw)) DCP_CHANNEL_0)
    (return (errors/New "co-processor is not initialized")))


  ;; clear channel status
  (reg/Write (.-ch0stat_clr hw) 0xffffffff)

  ;; set command address
  (reg/Write (.-ch0cmdptr hw) (conv uint32 ptr))
  ;; activate channel
  (reg/SetN (.-ch0sema hw) 0 0xff (conv uint32 count))

  ;; wait for completion
  (if (!= (.-irq hw) nil)
    (<! (.-irq hw))

    (reg/Wait (.-stat hw) DCP_STAT_IRQ DCP_CHANNEL_0 1))


  ;; clear interrupt register
  (reg/Set (.-stat_clr hw) DCP_CHANNEL_0)

  (let [chstatus (reg/Read (.-ch0stat hw))]

    ;; check for errors
    (when (!= (bits/GetN (addr chstatus) 0 CHxSTAT_ERROR_MASK) 0)
      (let [code (bits/GetN (addr chstatus) CHxSTAT_ERROR_CODE 0xff)
          ^{:line 225} sema (reg/Read (.-ch0sema hw))]
        (return (fmt/Errorf "DCP channel 0 error, status:%#x error_code:%#x sema:%#x" chstatus code sema))))


    (return)))




^{:go/end 237} (go/method EnableInterrupt "EnableInterrupt enables interrupt generation on command completion, when\nenabled ServiceInterrupt() is required to finalize command processing.\n" [^{:tag (* DCP)} hw]
  (set! (.-irq hw) (make (chan bool)))
  (reg/SetN (.-ctrl hw) CTRL_CHANNEL_INTERRUPT_ENABLE 0xf DCP_CHANNEL_0))



^{:go/end 242} (go/method ServiceInterrupt "ServiceInterrupt signals completion to pending commands.\n" [^{:tag (* DCP)} hw]
  (>! (.-irq hw) true))

(go/const ^{:val 32} WorkPacketLength 32)



(go/type WorkPacket "WorkPacket represents a DCP work packet\n(p1067, 13.2.6.4 Work Packet Structure, MCIMX28RM).\n" (struct
    ^{:line 103 :tag uint32} NextCmdAddr

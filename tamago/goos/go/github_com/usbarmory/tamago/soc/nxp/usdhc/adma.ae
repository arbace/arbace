(in-ns 'go.github_com.usbarmory.tamago.soc.nxp.usdhc) (go/file "adma.go" :imports [


    ^{:line 14} [bytes "bytes"]
    ^{:line 15} [binary "encoding/binary"]])



(go/const "ADMA constants\n"
  ^{:line 20} [^{:val 0} ATTR_VALID 0]
  ^{:line 21} [^{:val 1} ATTR_END 1]
  ^{:line 22} [^{:val 2} ATTR_INT 2]
  ^{:line 23} [^{:val 4} ATTR_ACT 4]

  ^{:line 25} [^{:val 2} ACT_TRANSFER 2r10]
  ^{:line 26} [^{:val 3} ACT_LINK 2r11]

  ^{:line 28} [^{:val 0} DMASEL_NONE 2r00]
  ^{:line 29} [^{:val 1} DMASEL_ADMA1 2r01]
  ^{:line 30} [^{:val 2} DMASEL_ADMA2 2r10]

  ^{:line 32} [^{:val 65532} ADMA_BD_MAX_LENGTH 65532])



(go/type ADMABufferDescriptor "ADMABufferDescriptor implements p3964 58.4.2.4.1 ADMA Concept and Descriptor Format, IMX6ULLRM.\n" (struct
    ^{:line 37 :tag uint8} Attribute
    ^{:line 38 :tag uint8} res
    ^{:line 39 :tag uint16} Length
    ^{:line 40 :tag uint32} Address

    ^{:line 42 :tag (* ADMABufferDescriptor)} next))



^{:go/end 67} (go/method Init "Init initializes an ADMA2 buffer descriptor.\n" [^{:tag (* ADMABufferDescriptor)} bd ^uint addr ^int size]
  (let [b bd]

    (while (> size 0)
      (if (<= size ADMA_BD_MAX_LENGTH) (do
          (set! (.-Attribute b) (bit-or (<< ACT_TRANSFER ATTR_ACT) (<< 1 ATTR_END) (<< 1 ATTR_VALID)))
          (set! (.-Length b) (conv uint16 size))
          (set! (.-Address b) (conv uint32 addr))
          (break))
        (do
          (set! (.-Attribute b) (bit-or (<< ACT_TRANSFER ATTR_ACT) (<< 1 ATTR_VALID)))
          (set! (.-Length b) (conv uint16 ADMA_BD_MAX_LENGTH))
          (set! (.-Address b) (conv uint32 addr))

          (set! addr + ADMA_BD_MAX_LENGTH)
          (set! size - ADMA_BD_MAX_LENGTH)

          (set! (.-next b) (addr (lit ADMABufferDescriptor)))
          (set! b (.-next b)))))))





^{:go/end 85} (go/method Bytes "Bytes converts the descriptor structure to byte array format.\n" ^{:tag (slice byte)} [^{:tag (* ADMABufferDescriptor)} bd]
  (let [buf (new bytes/Buffer)

      ^{:line 73} b bd]

    (while (!= b nil)
      (binary/Write buf binary/LittleEndian (.-Attribute b))
      (binary/Write buf binary/LittleEndian (.-res b))
      (binary/Write buf binary/LittleEndian (.-Length b))
      (binary/Write buf binary/LittleEndian (.-Address b))

      (set! b (.-next b)))


    (.Bytes buf)))

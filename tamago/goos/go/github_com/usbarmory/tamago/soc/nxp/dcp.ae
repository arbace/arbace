(ns go.github_com.usbarmory.tamago.soc.nxp.dcp
  (:require [arbace.go :as go]))

(go/package dcp
  :path "github.com/usbarmory/tamago/soc/nxp/dcp"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["cipher.go" "dcp.go" "hash.go" "key.go" "sha.go"]
  :init-order []
  :positions :lines)

(load "dcp/cipher")
(load "dcp/dcp")
(load "dcp/hash")
(load "dcp/key")
(load "dcp/sha")

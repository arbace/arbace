(in-ns 'go.github_com.usbarmory.tamago.soc.nxp.imx8mp) (go/file "rng.go" :imports [


    ^{:line 12} [binary "encoding/binary"]
    ^{:line 13} [time "time"]
    ^{:line 14} [_ "unsafe"]

    ^{:line 16} [dma "github.com/usbarmory/tamago/dma"]
    ^{:line 17} [rng "github.com/usbarmory/tamago/internal/rng"]
    ^{:line 18} [caam "github.com/usbarmory/tamago/soc/nxp/caam"]])



^{:go/end 51} (go/func ^{:go/linkname "initRNG runtime/goos.InitRNG"} initRNG []
  (set! (values _ Family _) (SiliconVersion))

  ;; only emulated targets have been tested so far
  (set! Native false)

  (when (not Native)
    (let [drbg (addr (lit rng/DRBG))]
      (.PutUint64 binary/LittleEndian (subslice (.-Seed drbg)) (conv uint64 (.UnixNano (time/Now))))
      (set! rng/GetRandomDataFn (.-GetRandomData drbg))
      (return)))


  (switch Family
    (case [IMX8MPD IMX8MPQ]
      ;; Cryptographic Acceleration and Assurance Module
      (set! CAAM (addr ^{:go/breaks [2 4]} (lit caam/CAAM
            :Base CAAM_BASE
            :DeriveKeyMemory (dma/Default))))

      (.Init CAAM)

      ;; The CAAM TRNG is too slow for direct use, therefore
      ;; we use it to seed an AES-CTR based DRBG.
      (let [drbg (addr (lit rng/DRBG))]
        (.GetRandomData CAAM (subslice (.-Seed drbg)))

        (set! rng/GetRandomDataFn (.-GetRandomData drbg))))))

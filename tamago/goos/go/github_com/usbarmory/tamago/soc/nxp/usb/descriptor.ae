^{:go/end 200} (go/method Bytes "Bytes converts the descriptor structure to byte array format,\n" ^{:tag (slice byte)} [^{:tag (* InterfaceDescriptor)} d]
  (let [buf (new bytes/Buffer)]

    ;; Interface Association Descriptor for multi-function device support.
    (when (!= (.-IAD d) nil)
      (set! buf (bytes/NewBuffer (.Bytes (.-IAD d)))))


    (binary/Write buf binary/LittleEndian (.-Length d))
    (binary/Write buf binary/LittleEndian (.-DescriptorType d))
    (binary/Write buf binary/LittleEndian (.-InterfaceNumber d))
    (binary/Write buf binary/LittleEndian (.-AlternateSetting d))
    (binary/Write buf binary/LittleEndian (.-NumEndpoints d))
    (binary/Write buf binary/LittleEndian (.-InterfaceClass d))
    (binary/Write buf binary/LittleEndian (.-InterfaceSubClass d))
    (binary/Write buf binary/LittleEndian (.-InterfaceProtocol d))
    (binary/Write buf binary/LittleEndian (.-Interface d))

    ;; add class descriptors
    (range [_ classDesc (.-ClassDescriptors d)]
      (.Write buf classDesc))


    (.Bytes buf)))

















(go/type EndpointFunction "EndpointFunction represents the function to process either IN or OUT\ntransfers, depending on the endpoint configuration.\n\nOn OUT endpoints the function is expected to receive data from the host in\nthe input buffer. The expected size, or a reserved DMA buffer (see\n`dma.Reserve`), for the next OUT transfer can be passed as a result buffer,\notherwise a short or single packet is assumed. In case a reserved DMA buffer\nis returned the next OUT transfer `buf` argument represents a slice of it,\ncare must be taken not to use such slice (without a copy) after the reserved\nbuffer is released.\n\nOn IN endpoints the function is expected to return data, or reserved and\nfilled DMA buffer, for transmission to the host, such data is used to fill\nthe transmission queue in advance, to respond to IN requests. The function\nis invoked by the EndpointHandler to fill the buffer as needed.\n" (func [^{:tag (slice byte)} buf ^error lastErr] [^{:tag (slice byte)} res ^error err]))



(go/type EndpointDescriptor "EndpointDescriptor implements\np297, Table 9-13. Standard Endpoint Descriptor, USB2.0.\n" (struct
    ^{:line 222 :tag uint8} Length
    ^{:line 223 :tag uint8} DescriptorType
    ^{:line 224 :tag uint8} EndpointAddress
    ^{:line 225 :tag uint8} Attributes
    ^{:line 226 :tag uint16} MaxPacketSize
    ^{:line 227 :tag uint8} Interval


    ^{:line 230 :tag bool :doc "Automatic Zero Length Termination\n"} Zero

    ^{:line 232 :tag EndpointFunction} Function))



^{:go/end 245} (go/method SetDefaults "SetDefaults initializes default values for the USB endpoint descriptor.\n" [^{:tag (* EndpointDescriptor)} d]
  (set! (.-Length d) ENDPOINT_LENGTH)
  (set! (.-DescriptorType d) ENDPOINT)
  ;; EP1 IN
  (set! (.-EndpointAddress d) 0x81)
  ;; maximum packet size for EP1+ (high speed)
  (set! (.-MaxPacketSize d) 512)
  ;; most applications require Zero Length Termination
  (set! (.-Zero d) true))



^{:go/end 250} (go/method Number "Number returns the endpoint number.\n" ^int [^{:tag (* EndpointDescriptor)} d]
  (conv int (bit-and (.-EndpointAddress d) 2r1111)))



^{:go/end 255} (go/method Direction "Direction returns the endpoint direction.\n" ^int [^{:tag (* EndpointDescriptor)} d]
  (/ (conv int (bit-and (.-EndpointAddress d) 2r10000000)) 2r10000000))



^{:go/end 260} (go/method TransferType "TransferType returns the endpoint transfer type.\n" ^int [^{:tag (* EndpointDescriptor)} d]
  (conv int (bit-and (.-Attributes d) 2r11)))



^{:go/end 274} (go/method Bytes "Bytes converts the descriptor structure to byte array format.\n" ^{:tag (slice byte)} [^{:tag (* EndpointDescriptor)} d]
  (let [buf (new bytes/Buffer)]

    (binary/Write buf binary/LittleEndian (.-Length d))
    (binary/Write buf binary/LittleEndian (.-DescriptorType d))
    (binary/Write buf binary/LittleEndian (.-EndpointAddress d))
    (binary/Write buf binary/LittleEndian (.-Attributes d))
    (binary/Write buf binary/LittleEndian (.-MaxPacketSize d))
    (binary/Write buf binary/LittleEndian (.-Interval d))

    (.Bytes buf)))





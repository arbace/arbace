^{:go/end 105} (go/method AddInterface "AddInterface adds an Interface Descriptor to a configuration, updating the\ninterface number and Configuration Descriptor interface count accordingly.\n" [^{:tag (* ConfigurationDescriptor)} d ^{:tag (* InterfaceDescriptor)} iface]
  (cond (== (.-AlternateSetting iface) 0) (do
      (set! (.-InterfaceNumber iface) (.-NumInterfaces d))
      (set! (.-NumInterfaces d) + 1))
    (> (.-NumInterfaces d) 0)
    (set! (.-InterfaceNumber iface) (- (.-NumInterfaces d) 1)))


  (set! (.-Interfaces d) (append (.-Interfaces d) iface)))



^{:go/end 121} (go/method Bytes "Bytes converts the descriptor structure to byte array format.\n" ^{:tag (slice byte)} [^{:tag (* ConfigurationDescriptor)} d]
  (let [buf (new bytes/Buffer)]

    (binary/Write buf binary/LittleEndian (.-Length d))
    (binary/Write buf binary/LittleEndian (.-DescriptorType d))
    (binary/Write buf binary/LittleEndian (.-TotalLength d))
    (binary/Write buf binary/LittleEndian (.-NumInterfaces d))
    (binary/Write buf binary/LittleEndian (.-ConfigurationValue d))
    (binary/Write buf binary/LittleEndian (.-Configuration d))
    (binary/Write buf binary/LittleEndian (.-Attributes d))
    (binary/Write buf binary/LittleEndian (.-MaxPower d))

    (.Bytes buf)))





(go/type SetupFunction "SetupFunction represents the function to process class-specific setup\nrequests.\n\nThe function is invoked before standard setup handlers and is expected to\nreturn an `in` buffer for transmission on IN endpoint 0, the `ack` boolean\ncan be used to signal whether a zero length packet should be sent (true) in\ncase the `in` buffer returned empty.\n\nA non-nil `err` results in a stall. The `done` flag can be used to signal\nwhether standard setup handlers should be invoked (false) or not (true)\nif function returns with a non-nil error.\n" (func [^{:tag (* SetupData)} setup] [^{:tag (slice byte)} in ^bool ack ^bool done ^error err]))



(go/type Device "Device is a collection of USB device descriptors and host driven settings\nto represent a USB device.\n" (struct
    ^{:line 358 :tag (* DeviceDescriptor)} Descriptor
    ^{:line 359 :tag (* DeviceQualifierDescriptor)} Qualifier
    ^{:line 360 :tag (slice (* ConfigurationDescriptor))} Configurations
    ^{:line 361 :tag (slice (slice byte))} Strings


    ^{:line 364 :tag uint8 :doc "Host requested settings\n"} ConfigurationValue
    ^{:line 365 :tag uint8} AlternateSetting


    ^{:line 368 :tag SetupFunction :doc "Optional class-specific setup handler\n"} Setup))


^{:go/end 392} (go/method setStringDescriptor [^{:tag (* Device)} d ^{:tag (slice byte)} s ^bool zero] :results [uint8 error]
  (let [^{:tag (slice byte)} buf (zero (slice byte))

      ^{:line 374} desc (addr (lit StringDescriptor))]
    (.SetDefaults desc)
    (set! (.-Length desc) + (conv uint8 (len s)))

    (when (> (.-Length desc) 255)
      (return 0 (fmt/Errorf "string descriptor size (%d) cannot exceed 255" (.-Length desc))))


    (set! buf (append buf (spread (.Bytes desc))))
    (set! buf (append buf (spread s)))

    (if (and zero (>= (len (.-Strings d)) 1))
      (aset (.-Strings d) 0 buf)

      (set! (.-Strings d) (append (.-Strings d) buf)))


    (return (conv uint8 (- (len (.-Strings d)) 1)) nil)))




^{:go/end 412} (go/method SetLanguageCodes "SetLanguageCodes configures String Descriptor Zero language codes\n(p273, Table 9-15. String Descriptor Zero, Specifying Languages Supported by the Device, USB2.0).\n" [^{:tag (* Device)} d ^{:tag (slice uint16)} codes] :results [^error err]
  (let [^{:tag (slice byte)} buf (zero (slice byte))]

    (when (> (len codes) 1)
      (return (fmt/Errorf "only a single language is currently supported")))


    (range [i codes]
      (let [b (make (slice byte) 2)]
        (.PutUint16 binary/LittleEndian b (aget codes i))
        (set! buf (append buf (spread b)))))


    (set! (values _ err) (.setStringDescriptor d buf true))

    (return)))





^{:go/end 432} (go/method AddString "AddString adds a string descriptor to a USB device. The returned index can\nbe used to fill string descriptor index value in configuration descriptors\n(p274, Table 9-16. UNICODE String Descriptor, USB2.0).\n" [^{:tag (* Device)} d ^string s] :results [uint8 error]
  (let [^{:tag (slice byte)} buf (zero (slice byte))

      ^{:line 420} desc (addr (lit StringDescriptor))]
    (.SetDefaults desc)

    (let [r (conv (slice rune) s)
        ^{:line 424} u (utf16/Encode (conv (slice rune) r))]

      (range [i u]
        (set! buf (append buf (conv byte (bit-and (aget u i) 0xff))))
        (set! buf (append buf (conv byte (>> (aget u i) 8)))))


      (.setStringDescriptor d buf false))))




^{:go/end 446} (go/method AddConfiguration "AddConfiguration adds a Configuration Descriptor to a device, updating its\nDevice Descriptor configuration count accordingly.\n" [^{:tag (* Device)} d ^{:tag (* ConfigurationDescriptor)} conf] :results [^error err]
  (set! (.-Configurations d) (append (.-Configurations d) conf))

  (when (== (.-Descriptor d) nil)
    (return (errors/New "invalid device descriptor")))


  (set! (.-NumConfigurations (.-Descriptor d)) + 1)

  (return))





^{:go/end 481} (go/method Configuration "Configuration converts the device configuration hierarchy to a buffer, as expected by Get\nDescriptor for configuration descriptor type\n(p281, 9.4.3 Get Descriptor, USB2.0).\n" [^{:tag (* Device)} d ^uint16 wIndex] :results [^{:tag (slice byte)} buf ^error err]
  (when (> (conv int (+ wIndex 1)) (len (.-Configurations d)))
    (set! err (errors/New "invalid configuration index"))
    (return))


  (let [conf (aget (.-Configurations d) (conv int wIndex))]

    (for [i 0] (< i (len (.-Interfaces conf))) (inc! i)
      (let [iface (aget (.-Interfaces conf) i)]

        ;; If an IAD is present set the first interface value, unless
        ;; already set, depending on where we are in the interface
        ;; list.
        (when (and (!= (.-IAD iface) nil) (== (.-FirstInterface (.-IAD iface)) 0))
          (set! (.-FirstInterface (.-IAD iface)) (conv uint8 i)))


        (set! buf (append buf (spread (.Bytes iface))))

        (for [i 0] (< i (len (.-Endpoints iface))) (inc! i)
          (let [ep (aget (.-Endpoints iface) i)]
            (set! buf (append buf (spread (.Bytes ep))))))))



    (set! (.-TotalLength conf) (conv uint16 (+ (conv int (.-Length conf)) (len buf))))
    (set! buf (append (.Bytes conf) (spread buf)))

    (return)))

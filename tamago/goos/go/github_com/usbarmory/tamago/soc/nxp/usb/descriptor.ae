^{:go/end 59} (go/method SetDefaults "SetDefaults initializes default values for the USB device descriptor.\n" [^{:tag (* DeviceDescriptor)} d]
  (set! (.-Length d) DEVICE_LENGTH)
  (set! (.-DescriptorType d) DEVICE)
  ;; USB 2.0
  (set! (.-bcdUSB d) 0x0200)
  ;; maximum packet size for EP0

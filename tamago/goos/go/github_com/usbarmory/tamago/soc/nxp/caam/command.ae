(go/type Command "Command represents a CAAM command\n(p266, 6.6.7.3 Command types, IMX6ULSRM).\n" (struct

    ^{:line 131 :tag uint32 :doc "Main fields\n"} Word0

    ^{:line 133 :tag (slice uint32) :doc "Optional words\n"} Words))



^{:go/end 139} (go/method Class "Class sets the command CLASS field.\n" [^{:tag (* Command)} c ^int class]
  (bits/SetN (addr (.-Word0 c)) CLASS 2r11 (conv uint32 class)))




^{:go/end 149} (go/method Bytes "Bytes converts the descriptor non-optional words structure to byte array\nformat.\n" ^{:tag (slice byte)} [^{:tag (* Command)} c]
  (let [buf (new bytes/Buffer)]
    (binary/Write buf binary/LittleEndian (.-Word0 c))
    (binary/Write buf binary/LittleEndian (.-Words c))

    (.Bytes buf)))



(go/type LengthCommand "LengthCommand represents a CAAM command with Length and Pointer fields.\n" (struct
    ^{:line 153} Command))



^{:go/end 160} (go/method Pointer "Pointer sets the command POINTER and EXT LENGTH fields.\n" [^{:tag (* LengthCommand)} c ^uint addr ^int n]
  (bits/SetN (addr ^{:go/via [Command]} (.-Word0 c)) LENGTH 0xff (conv uint32 n))
  (set! ^{:go/via [Command]} (.-Words c) (lit (slice uint32) (conv uint32 addr))))




(go/type ExtendedLengthCommand "ExtendedLengthCommand represents a CAAM command with Extended Length and\nPointer fields.\n" (struct
    ^{:line 165} Command))



^{:go/end 175} (go/method Pointer "Pointer sets the command POINTER and EXT LENGTH fields.\n" [^{:tag (* ExtendedLengthCommand)} c ^uint addr ^int n]
  (bits/Set (addr ^{:go/via [Command]} (.-Word0 c)) EXT)
  (set! ^{:go/via [Command]} (.-Words c) (lit (slice uint32)
      (conv uint32 addr)
      (conv uint32 n))))






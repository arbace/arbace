(go/type dTD "dTD implements\np3787, 56.4.5.2 Endpoint Transfer Descriptor (dTD), IMX6ULLRM.\n" (struct
    ^{:line 71 :tag uint32} Next
    ^{:line 72 :tag uint32} Token

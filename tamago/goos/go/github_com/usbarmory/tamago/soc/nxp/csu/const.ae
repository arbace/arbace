  ^{:line 26} [^{:val 3 :doc "NonSecure User: NA, NonSecure Supervisor: NA, Secure User: RO, Secure Supervisor: RO\n"} SEC_LEVEL_6 2r00000011]

  ^{:line 28} [^{:val 0 :doc "NonSecure User: NA, NonSecure Supervisor: NA, Secure User: NA, Secure Supervisor: NA\n"} SEC_LEVEL_7 2r00000000]


  ^{:line 31} [^{:val 7 :doc "NonSecure Supervisor Write Access bit\n"} CSL_NW_SUP_WR 7]

  ^{:line 33} [^{:val 6 :doc "NonSecure User Write Access bit\n"} CSL_NW_USR_WR 6]

  ^{:line 35} [^{:val 5 :doc "Secure Supervisor Write Access bit\n"} CSL_SW_SUP_WR 5]

  ^{:line 37} [^{:val 4 :doc "Secure User Write Access bit\n"} CSL_SW_USR_WR 4]

  ^{:line 39} [^{:val 3 :doc "NonSecure Supervisor Read Access bit\n"} CSL_NW_SUP_RD 3]

  ^{:line 41} [^{:val 2 :doc "NonSecure User Read Access bit\n"} CSL_NW_USR_RD 2]

  ^{:line 43} [^{:val 1 :doc "Secure Supervisor Read Access bit\n"} CSL_SW_SUP_RD 1]


(go/const "p383, 11.2.3.1 CSU Peripheral Access Policy, IMX6ULLRM\n"

  ^{:line 14} [^{:val 255 :doc "NonSecure User: RW, NonSecure Supervisor: RW, Secure User: RW, Secure Supervisor: RW\n"} SEC_LEVEL_0 2r11111111]

  ^{:line 16} [^{:val 187 :doc "NonSecure User: NA, NonSecure Supervisor: RW, Secure User: RW, Secure Supervisor: RW\n"} SEC_LEVEL_1 2r10111011]


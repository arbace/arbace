  ^{:line 20} [^{:val 59 :doc "NonSecure User: NA, NonSecure Supervisor: RO, Secure User: RW, Secure Supervisor: RW\n"} SEC_LEVEL_3 2r00111011]

  ^{:line 22} [^{:val 51 :doc "NonSecure User: NA, NonSecure Supervisor: NA, Secure User: RW, Secure Supervisor: RW\n"} SEC_LEVEL_4 2r00110011]


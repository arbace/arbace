    ^{:line 168 :tag bufferDescriptorRing :doc "transmit data buffers\n"} tx))




^{:go/end 218} (go/method Init "Init initializes and enables the Ethernet MAC controller for 100 Mbps full\nduplex operation with Auto-Negotiation enabled.\n" [^{:tag (* ENET)} hw] :results [^error err]
  ^{:go/via [Mutex]} (.Lock hw)
  (defer ^{:go/via [Mutex]} (.Unlock hw))

  (when (or (== (.-Base hw) 0) (== (.-Clock hw) nil))
    (return (errors/New "invalid ENET controller instance")))


  (cond (== (.-MAC hw) nil) (do
      (set! (.-MAC hw) (make (slice byte) 6))
      (rand/Read (.-MAC hw))
      ;; flag address as unicast and locally administered
      (set! (aget (.-MAC hw) 0) bit-and 0xfe)
      (set! (aget (.-MAC hw) 0) bit-or 0x02))
    (!= (len (.-MAC hw)) 6)
    (return (errors/New "invalid MAC")))


  (when (== (.-RingSize hw) 0)
    (set! (.-RingSize hw) defaultRingSize))


  (when (== (.-Timeout hw) 0)
    (set! (.-Timeout hw) Timeout))


  (set! (.-eir hw) (+ (.-Base hw) ENETx_EIR))
  (set! (.-eimr hw) (+ (.-Base hw) ENETx_EIMR))
  (set! (.-rdar hw) (+ (.-Base hw) ENETx_RDAR))
  (set! (.-tdar hw) (+ (.-Base hw) ENETx_TDAR))
  (set! (.-ecr hw) (+ (.-Base hw) ENETx_ECR))
  (set! (.-mmfr hw) (+ (.-Base hw) ENETx_MMFR))
  (set! (.-mscr hw) (+ (.-Base hw) ENETx_MSCR))
  (set! (.-mib hw) (+ (.-Base hw) ENETx_MIB))
  (set! (.-rcr hw) (+ (.-Base hw) ENETx_RCR))
  (set! (.-tcr hw) (+ (.-Base hw) ENETx_TCR))
  (set! (.-palr hw) (+ (.-Base hw) ENETx_PALR))
  (set! (.-paur hw) (+ (.-Base hw) ENETx_PAUR))
  (set! (.-rdsr hw) (+ (.-Base hw) ENETx_RDSR))
  (set! (.-tdsr hw) (+ (.-Base hw) ENETx_TDSR))
  (set! (.-mrbr hw) (+ (.-Base hw) ENETx_MRBR))
  (set! (.-ftrl hw) (+ (.-Base hw) ENETx_FTRL))
  (set! (.-racc hw) (+ (.-Base hw) ENETx_RACC))

  (.setup hw))


^{:go/end 280} (go/method setup [^{:tag (* ENET)} hw] :results [^error err]
  ;; enable clock
  (reg/SetN (.-CCGR hw) (.-CG hw) 2r11 2r11)

  (when (!= (.-EnablePLL hw) nil)
    ((.-EnablePLL hw) (.-Index hw)))


  ;; soft reset
  (reg/Set (.-ecr hw) ECR_RESET)
  (reg/Wait (.-ecr hw) ECR_RESET 1 0)
  (reg/Set (.-ecr hw) ECR_DBSWP)

  ;; clear all interrupts
  (reg/Write (.-eir hw) 0xffffffff)
  ;; mask all interrupts
  (reg/Write (.-eimr hw) 0)

  ;; enable Full-Duplex
  (reg/Set (.-tcr hw) TCR_FDEN)
  ;; disable Management Information Database
  (reg/Set (.-mib hw) MIB_DIS)

  ;; use legacy descriptors
  (reg/Clear (.-ecr hw) ECR_EN1588)

  ;; set receive buffer size and maximum frame length
  (let [size (+ maxFrameSize (- bufferAlign (% maxFrameSize bufferAlign)))]
    (reg/Write (.-mrbr hw) (conv uint32 size))
    (reg/Write (.-ftrl hw) maxFrameSize)
    (reg/SetN (.-rcr hw) RCR_MAX_FL 0x3fff maxFrameSize)

    (when (.-DiscardErrors hw)
      (reg/Set (.-racc hw) RACC_LINEDIS))


    ;; set physical address
    (.SetMAC hw (.-MAC hw))

    ;; set Media Independent Interface Mode
    (reg/Set (.-rcr hw) RCR_MII_MODE)
    (reg/SetTo (.-rcr hw) RCR_RMII_MODE (.-RMII hw))
    ;; enable Flow Control
    (reg/Set (.-rcr hw) RCR_FCE)
    ;; disable loopback
    (reg/Clear (.-rcr hw) RCR_LOOP)

    ;; set MII clock
    (reg/SetN (.-mscr hw) MSCR_HOLDTIME 2r111 1)
    (reg/SetN (.-mscr hw) MSCR_MII_SPEED 0x3f (/ ((.-Clock hw)) (* 2 2500000)))

    ;; enable Ethernet MAC
    (reg/Set (.-ecr hw) ECR_ETHEREN)

    (when (!= (.-EnablePHY hw) nil)
      ;; enable Ethernet PHY
      (set! err ((.-EnablePHY hw) hw)))


    (return)))




^{:go/end 292} (go/method SetMAC "SetMAC allows to change the controller physical address register after\ninitialization.\n" [^{:tag (* ENET)} hw ^net/HardwareAddr mac]
  (set! (.-MAC hw) mac)

  (let [lower (.Uint32 binary/BigEndian (subslice (.-MAC hw) 0 4))
      ^{:line 288} upper (.Uint16 binary/BigEndian (subslice (.-MAC hw) 4 6))]

    (reg/Write (.-palr hw) lower)
    (reg/Write (.-paur hw) (<< (conv uint32 upper) 16))))



^{:go/end 301} (go/method Start "Start begins processing of incoming packets.\n" [^{:tag (* ENET)} hw]
  ;; set receive and transmit descriptors
  (reg/Write (.-rdsr hw) (.init (.-rx hw) true (.-RingSize hw) (addr (.-Stats hw))))
  (reg/Write (.-tdsr hw) (.init (.-tx hw) false (.-RingSize hw) (addr (.-Stats hw))))

  (reg/Set (.-rdar hw) RDAR_ACTIVE))



^{:go/end 306} (go/method EnableInterrupt "EnableInterrupt enables interrupt generation for a specific event.\n" [^{:tag (* ENET)} hw ^int event]
  (reg/Set (.-eimr hw) event))



^{:go/end 311} (go/method ClearInterrupt "ClearInterrupt clears the interrupt corresponding to a specific event.\n" [^{:tag (* ENET)} hw ^int event]
  (reg/Set (.-eir hw) event))

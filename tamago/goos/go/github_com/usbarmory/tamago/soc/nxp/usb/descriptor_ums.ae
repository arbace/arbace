(go/type CBW "CBW implements p13, 5.1 Command Block Wrapper (CBW),\nUSB Mass Storage Class 1.0\n" (struct
    ^{:line 47 :tag uint32} Signature
    ^{:line 48 :tag uint32} Tag
    ^{:line 49 :tag uint32} DataTransferLength
    ^{:line 50 :tag uint8} Flags
    ^{:line 51 :tag uint8} LUN
    ^{:line 52 :tag uint8} Length
    ^{:line 53 :tag (array 16 byte)} CommandBlock))



^{:go/end 59} (go/method SetDefaults "SetDefaults initializes default values for the CBW descriptor.\n" [^{:tag (* CBW)} d]
  (set! (.-Signature d) CBW_SIGNATURE))



^{:go/end 66} (go/method Bytes "Bytes converts the descriptor structure to byte array format.\n" ^{:tag (slice byte)} [^{:tag (* CBW)} d]
  (let [buf (new bytes/Buffer)]
    (binary/Write buf binary/LittleEndian d)
    (.Bytes buf)))



(go/type CSW "CSW implements p14, 5.2 Command Status Wrapper (CSW), USB Mass Storage Class 1.0\n" (struct
    ^{:line 70 :tag uint32} Signature

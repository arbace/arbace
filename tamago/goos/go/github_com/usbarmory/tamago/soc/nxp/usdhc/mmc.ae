  ^{:line 29} [^{:val 15} MMC_OCR_VDD_HV_MIN 15]
  ^{:line 30} [^{:val 7} MMC_OCR_VDD_LV 7]

  ^{:line 32} [^{:val 0} ACCESS_MODE_BYTE 2r00]
  ^{:line 33} [^{:val 2} ACCESS_MODE_SECTOR 2r10]



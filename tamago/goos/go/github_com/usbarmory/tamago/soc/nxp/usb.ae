(ns go.github_com.usbarmory.tamago.soc.nxp.usb
  (:require [arbace.go :as go]))

(go/package usb
  :path "github.com/usbarmory/tamago/soc/nxp/usb"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["bus.go" "descriptor.go" "descriptor_ccid.go" "descriptor_cdc.go" "descriptor_ums.go" "device.go" "endpoint.go" "endpoint_handler.go" "setup.go"]
  :init-order []
  :positions :lines)

(load "usb/bus")
(load "usb/descriptor")
(load "usb/descriptor_ccid")
(load "usb/descriptor_cdc")
(load "usb/descriptor_ums")
(load "usb/device")
(load "usb/endpoint")
(load "usb/endpoint_handler")
(load "usb/setup")

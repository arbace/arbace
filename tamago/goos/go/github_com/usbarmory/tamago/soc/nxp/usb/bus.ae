(go/type USB "USB represents a USB controller instance.\n" (struct
    ^{:line 129} sync/Mutex


    ^{:line 132 :tag int :doc "Controller index\n"} Index

    ^{:line 134 :tag uint32 :doc "Base register\n"} Base

    ^{:line 136 :tag uint32 :doc "Clock gate register\n"} CCGR

    ^{:line 138 :tag int :doc "Clock gate\n"} CG

    ^{:line 140 :tag uint32 :doc "Analog base register\n"} Analog

    ^{:line 142 :tag uint32 :doc "PHY base register\n"} PHY

    ^{:line 144 :tag int :doc "Interrupt ID\n"} IRQ

    ^{:line 146 :tag (func [^int index] [error]) :doc "PLL enable function\n"} EnablePLL


    ^{:line 149 :tag (* Device) :doc "USB device configuration\n"} Device


    ^{:line 152 :tag (* sync/Cond) :doc "EP1-N transfer completion rendezvous point\n"} event

    ^{:line 154 :tag (chan (struct)) :doc "EP1-N cancellation signal\n"} exit

    ^{:line 156 :tag sync/WaitGroup :doc "EP-1-N completion synchronization\n"} wg


    ^{:line 159 :tag uint32 :doc "control registers\n"} ctrl
    ^{:line 160 :tag uint32} pwd
    ^{:line 161 :tag uint32} chrg
    ^{:line 162 :tag uint32} mode
    ^{:line 163 :tag uint32} otg
    ^{:line 164 :tag uint32} cmd
    ^{:line 165 :tag uint32} addr
    ^{:line 166 :tag uint32} sts
    ^{:line 167 :tag uint32} intr
    ^{:line 168 :tag uint32} sc
    ^{:line 169 :tag uint32} eplist
    ^{:line 170 :tag uint32} setup
    ^{:line 171 :tag uint32} flush
    ^{:line 172 :tag uint32} prime
    ^{:line 173 :tag uint32} stat
    ^{:line 174 :tag uint32} complete
    ^{:line 175 :tag uint32} epctrl


    ^{:line 178 :tag uint32 :doc "cache for endpoint list pointer\n"} epListAddr

    ^{:line 180 :tag (array MAX_ENDPOINTS (array 2 uint32)) :doc "cache for endpoint queue heads pointers\n"} dQH))



^{:go/end 233} (go/method Init "Init initializes the USB controller.\n" [^{:tag (* USB)} hw]
  ^{:go/via [Mutex]} (.Lock hw)
  (defer ^{:go/via [Mutex]} (.Unlock hw))

  (when (or (== (.-Base hw) 0) (== (.-CCGR hw) 0) (== (.-Analog hw) 0) (== (.-PHY hw) 0) (== (.-EnablePLL hw) nil))
    (panic "invalid USB controller instance"))


  (set! (.-ctrl hw) (+ (.-PHY hw) USBPHYx_CTRL))
  (set! (.-pwd hw) (+ (.-PHY hw) USBPHYx_PWD))
  (set! (.-chrg hw) (+ (.-Analog hw) USB_ANALOG_USBx_CHRG_DETECT))
  (set! (.-mode hw) (+ (.-Base hw) USB_UOGx_USBMODE))
  (set! (.-otg hw) (+ (.-Base hw) USB_UOGx_OTGSC))
  (set! (.-cmd hw) (+ (.-Base hw) USB_UOGx_USBCMD))
  (set! (.-addr hw) (+ (.-Base hw) USB_UOGx_DEVICEADDR))
  (set! (.-sts hw) (+ (.-Base hw) USB_UOGx_USBSTS))
  (set! (.-intr hw) (+ (.-Base hw) USB_UOGx_USBINTR))
  (set! (.-sc hw) (+ (.-Base hw) USB_UOGx_PORTSC1))
  (set! (.-eplist hw) (+ (.-Base hw) USB_UOGx_ENDPTLISTADDR))
  (set! (.-setup hw) (+ (.-Base hw) USB_UOGx_ENDPTSETUPSTAT))
  (set! (.-flush hw) (+ (.-Base hw) USB_UOGx_ENDPTFLUSH))
  (set! (.-prime hw) (+ (.-Base hw) USB_UOGx_ENDPTPRIME))
  (set! (.-stat hw) (+ (.-Base hw) USB_UOGx_ENDPTSTAT))
  (set! (.-complete hw) (+ (.-Base hw) USB_UOGx_ENDPTCOMPLETE))
  (set! (.-epctrl hw) (+ (.-Base hw) USB_UOGx_ENDPTCTRL))

  ;; enable clock
  (reg/SetN (.-CCGR hw) (.-CG hw) 2r11 2r11)
  ((.-EnablePLL hw) (.-Index hw))

  ;; soft reset USB PHY
  (reg/Set (.-ctrl hw) CTRL_SFTRST)
  (reg/Clear (.-ctrl hw) CTRL_SFTRST)

  ;; disable clock gate
  (reg/Clear (.-ctrl hw) CTRL_CLKGATE)

  ;; clear power down
  (reg/Write (.-pwd hw) 0)

  ;; enable UTMI+
  (reg/Set (.-ctrl hw) CTRL_ENUTMILEVEL3)
  (reg/Set (.-ctrl hw) CTRL_ENUTMILEVEL2)
  ;; enable disconnection detect
  (reg/Set (.-ctrl hw) CTRL_ENHOSTDISCONDETECT)

  ;; disable charger detector
  (reg/Set (.-chrg hw) CHRG_DETECT_EN_B)
  (reg/Set (.-chrg hw) CHRG_DETECT_CHK_CHRG_B))



^{:go/end 252} (go/method Speed "Speed returns the port speed.\n" [^{:tag (* USB)} hw] :results [^string speed]
  ^{:go/via [Mutex]} (.Lock hw)
  (defer ^{:go/via [Mutex]} (.Unlock hw))

  (switch (reg/GetN (.-sc hw) PORTSC_PSPD 2r11)
    (case [2r00]
      (set! speed "full"))
    (case [2r01]
      (set! speed "low"))
    (case [2r10]
      (set! speed "high"))
    (case [2r11]
      (panic "invalid port speed")))


  (return))



^{:go/end 257} (go/method PowerDown "PowerDown shuts down the USB PHY.\n" [^{:tag (* USB)} hw]
  (reg/Write (.-pwd hw) 0xffffffff))



^{:go/end 262} (go/method Run "Run sets the controller in run mode.\n" [^{:tag (* USB)} hw]
  (reg/Set (.-cmd hw) USBCMD_RS))



^{:go/end 267} (go/method Stop "Stop sets the controller in stop mode.\n" [^{:tag (* USB)} hw]
  (reg/Clear (.-cmd hw) USBCMD_RS))



^{:go/end 289} (go/method Reset "Reset waits for and handles a bus reset.\n" [^{:tag (* USB)} hw]
  ^{:go/via [Mutex]} (.Lock hw)
  (defer ^{:go/via [Mutex]} (.Unlock hw))

  (reg/Wait (.-sts hw) USBSTS_URI 1 1)

  ;; p3792, 56.4.6.2.1 Bus Reset, IMX6ULLRM

  ;; read and write back to clear setup token semaphores
  (reg/WriteBack (.-setup hw))
  ;; read and write back to clear setup status
  (reg/WriteBack (.-complete hw))
  ;; flush endpoint buffers
  (reg/Write (.-flush hw) 0xffffffff)

  (reg/Wait (.-sc hw) PORTSC_PR 1 0)

  ;; clear reset
  (reg/Or (.-sts hw) (bit-or (<< 1 USBSTS_URI) (<< 1 USBSTS_UI))))



^{:go/end 294} (go/method EnableInterrupt "EnableInterrupt enables interrupt generation for a specific event.\n" [^{:tag (* USB)} hw ^int event]
  (reg/Set (.-intr hw) event))



^{:go/end 299} (go/method ClearInterrupt "ClearInterrupt clears the interrupt corresponding to a specific event.\n" [^{:tag (* USB)} hw ^int event]
  (reg/Set (.-sts hw) event))

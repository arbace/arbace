(in-ns 'go.github_com.usbarmory.tamago.soc.nxp.imx8mp) (go/file "timer.go" :imports [


    ^{:line 12} [_ "unsafe"]])



(go/const ^{:val 812253184 :doc "Timer registers (p31, Table 2-4, IMX8MPRM)\n"} SYS_CNT_BASE 0x306a0000)


(go/const ^{:val 8000000 :doc "CNTFID0 (p215, 4.11.4.1.6.4, IMX8MPRM)\n"} CNTFID0_FREQ (/ REF_FREQ 3))

^{:go/end 27} (go/func initTimers []
  (if (not Native)
    (.InitGenericTimers ARM64 0 CNTFID0_FREQ)

    (.InitGenericTimers ARM64 SYS_CNT_BASE CNTFID0_FREQ)))




^{:go/end 32} (go/func ^{:go/linkname "nanotime runtime/goos.Nanotime"} nanotime ^int64 []
  (.GetTime ARM64))

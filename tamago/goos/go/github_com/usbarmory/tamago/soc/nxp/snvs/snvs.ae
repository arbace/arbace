;; Package snvs implements a driver for NXP Secure Non-Volatile Storage (SNVS)
;; following reference specifications:
;;   - IMX6ULLRM  - i.MX 6ULL Applications Processor Reference Manual          - Rev 1 2017/11
;;   - IMX6ULLSRM - i.MX 6ULL Applications Processor Security Reference Manual - Rev 0 2016/09
;;
;; This package is only meant to be used with `GOOS=tamago` as supported by the
;; TamaGo framework for bare metal Go, see https://github.com/usbarmory/tamago.
(in-ns 'go.github_com.usbarmory.tamago.soc.nxp.snvs) (go/file "snvs.go" :doc "Package snvs implements a driver for NXP Secure Non-Volatile Storage (SNVS)\nfollowing reference specifications:\n  - IMX6ULLRM  - i.MX 6ULL Applications Processor Reference Manual          - Rev 1 2017/11\n  - IMX6ULLSRM - i.MX 6ULL Applications Processor Security Reference Manual - Rev 0 2016/09\n\nThis package is only meant to be used with `GOOS=tamago` as supported by the\nTamaGo framework for bare metal Go, see https://github.com/usbarmory/tamago.\n" :imports [


    ^{:line 19} [bits "github.com/usbarmory/tamago/bits"]
    ^{:line 20} [reg "github.com/usbarmory/tamago/internal/reg"]

    ^{:line 22} [sync "sync"]
    ^{:line 23} [time "time"]])



(go/const "SNVS registers\n"
  ^{:line 28} [^{:val 4} SNVS_HPCOMR 0x04]
  ^{:line 29} [^{:val 19} HPCOMR_HAC_STOP 19]
  ^{:line 30} [^{:val 17} HPCOMR_HAC_LOAD 17]
  ^{:line 31} [^{:val 16} HPCOMR_HAC_EN 16]

  ^{:line 33} [^{:val 16} SNVS_HPSVCR 0x10]
  ^{:line 34} [^{:val 30} HPSVCR_LPSV_CFG 30]

  ^{:line 36} [^{:val 20} SNVS_HPSR 0x14]
  ^{:line 37} [^{:val 27} HPSR_OTPMK_ZERO 27]
  ^{:line 38} [^{:val 16} HPSR_OTPMK_SYNDROME 16]

  ^{:line 40} [^{:val 28} SNVS_HPHACIVR 0x1c]
  ^{:line 41} [^{:val 32} SNVS_HPHACR 0x20]

  ^{:line 43} [^{:val 8} HPSR_SSM_STATE 8]

  ^{:line 45} [^{:val 72} SNVS_LPTDCR 0x48]
  ^{:line 46} [^{:val 6} LPTDCR_VT_EN 6]
  ^{:line 47} [^{:val 5} LPTDCR_TT_EN 5]
  ^{:line 48} [^{:val 4} LPTDCR_CT_EN 4]

  ^{:line 50} [^{:val 76} SNVS_LPSR 0x4c]
  ^{:line 51} [^{:val 6} LPSR_VTD 6]
  ^{:line 52} [^{:val 5} LPSR_TTD 5]
  ^{:line 53} [^{:val 4} LPSR_CTD 4]
  ^{:line 54} [^{:val 3} LPSR_PGD 3]

  ^{:line 56} [^{:val 100} SNVS_LPPGDR 0x64]

  ^{:line 58} [^{:val 1098080614 :doc "Power Glitch Detector Register hardwired value\n"} LPPGDR_PGD_VAL 0x41736166])



(go/const "System Security Monitor (SSM) states\n"
  ^{:line 63} [^{:val 0} SSM_STATE_INIT 2r0000]
  ^{:line 64} [^{:val 1} SSM_STATE_HARD_FAIL 2r0001]
  ^{:line 65} [^{:val 3} SSM_STATE_SOFT_FAIL 2r0011]
  ^{:line 66} [^{:val 9} SSM_STATE_CHECK 2r1001]
  ^{:line 67} [^{:val 11} SSM_STATE_NONSECURE 2r1011]
  ^{:line 68} [^{:val 13} SSM_STATE_TRUSTED 2r1101]
  ^{:line 69} [^{:val 15} SSM_STATE_SECURE 2r1111])



(go/const "DryIce registers\n"
  ^{:line 74} [^{:val 0} DRYICE_DTOCR 0x00]
  ^{:line 75} [^{:val 0} DTOCR_DRYICE_EN 0]

  ^{:line 77} [^{:val 4} DRYICE_DTMR 0x04]
  ^{:line 78} [^{:val 22} DTMR_TEMP_MON_TRIM 22]
  ^{:line 79} [^{:val 12} DTMR_VOLT_MON_TRIM 12]
  ^{:line 80} [^{:val 6} DTMR_BGR_TRIM 6]
  ^{:line 81} [^{:val 0} DTMR_PROG_TRIM 0]

  ^{:line 83} [^{:val 8} DRYICE_DTRR 0x08]
  ^{:line 84} [^{:val 2} DTRR_SNVS_CLK_TAMP_DETECT 2]
  ^{:line 85} [^{:val 1} DTRR_DRYICE_TEMP_DETECT 1]
  ^{:line 86} [^{:val 0} DTRR_DRYICE_VOLT_TAMP_DETECT 0]

  ^{:line 88} [^{:val 12} DRYICE_DMCR 0x0c]
  ^{:line 89} [^{:val 2} DMCR_CLOCK_DET_EN 2]
  ^{:line 90} [^{:val 1} DMCR_VOLT_DET_EN 1]
  ^{:line 91} [^{:val 0} DMCR_TEMP_DET_EN 0])



(go/type SNVS "SNVS represents the SNVS instance.\n" (struct
    ^{:line 96} sync/Mutex


    ^{:line 99 :tag uint32 :doc "Base register\n"} Base

    ^{:line 101 :tag uint32 :doc "Clock gate register\n"} CCGR

    ^{:line 103 :tag int :doc "Clock gate\n"} CG

    ^{:line 105 :tag uint32 :doc "auxiliary logic base register\n"} DryIce


    ^{:line 108 :tag uint32 :doc "control registers\n"} hpcomr
    ^{:line 109 :tag uint32} hpsvcr
    ^{:line 110 :tag uint32} hpsr
    ^{:line 111 :tag uint32} hphacivr
    ^{:line 112 :tag uint32} hphacr
    ^{:line 113 :tag uint32} lptdcr
    ^{:line 114 :tag uint32} lpsr
    ^{:line 115 :tag uint32} lppgdr


    ^{:line 118 :tag uint32 :doc "DryIce registers\n"} dtocr
    ^{:line 119 :tag uint32} dtmr
    ^{:line 120 :tag uint32} dtrr
    ^{:line 121 :tag uint32} dmcr


    ^{:line 124 :tag SecurityPolicy :doc "active configuration\n"} sp))




(go/type SecurityPolicy "SecurityPolicy represents an SNVS configuration and is used to configure\ntamper detection or return detected violations (see SetPolicy()).\n" (struct

    ^{:line 131 :tag bool :doc "SRTC Clock Tampering\n"} Clock

    ^{:line 133 :tag bool :doc "Temperature Tamper\n"} Temperature

    ^{:line 135 :tag bool :doc "Voltage Tamper\n"} Voltage

    ^{:line 137 :tag bool :doc "Power Glitch Violation (used only when reporting, see Monitor())\n"} Power




    ^{:line 142 :tag bool :doc "SecurityViolation controls whether monitored conditions generate a\nviolation which transitions the SNVS state to soft fail, preventing\naccess to the OTPMK and SNVS availability (see Available()).\n"} SecurityViolation




    ^{:line 147 :tag bool :doc "HardFail controls whether a soft fail state (see SecurityViolation)\ntransitions the system to a hard reset after a predefined system\nclock delay (see HAC).\n"} HardFail




    ^{:line 152 :tag uint32 :doc "HAC is used to stop and reset the initial value of the High\nAssurance Counter, a delay in system clocks between a soft fail and\na hard fail, or return the current HAC value.\n"} HAC



    ^{:line 156 :tag uint8 :doc "State represents the System Security Monitor (SSM) State (used only\nwhen reporting, see Monitor()).\n"} State))


^{:go/end 169} (go/method initDryIce [^{:tag (* SNVS)} hw ^uint32 calibrationData]
  (set! (.-dtocr hw) (+ (.-DryIce hw) DRYICE_DTOCR))
  (set! (.-dtmr hw) (+ (.-DryIce hw) DRYICE_DTMR))
  (set! (.-dtrr hw) (+ (.-DryIce hw) DRYICE_DTRR))
  (set! (.-dmcr hw) (+ (.-DryIce hw) DRYICE_DMCR))

  (reg/SetN (.-dtmr hw) DTMR_TEMP_MON_TRIM 0x3ff (bits/GetN (addr calibrationData) 0 0x3ff))
  (reg/SetN (.-dtmr hw) DTMR_VOLT_MON_TRIM 0x3ff (bits/GetN (addr calibrationData) 10 0x3ff))
  (reg/SetN (.-dtmr hw) DTMR_BGR_TRIM 0x3f (bits/GetN (addr calibrationData) 20 0x3f))
  (reg/SetN (.-dtmr hw) DTMR_PROG_TRIM 0x3f (bits/GetN (addr calibrationData) 26 0x3f)))





^{:go/end 194} (go/method Init "Init initializes the SNVS controller, the calibration data is fused\nindividually for each part and is required for correct initialization of the\nDryIce auxiliary logic (when available).\n" [^{:tag (* SNVS)} hw ^uint32 calibrationData]
  (when (or (== (.-Base hw) 0) (== (.-CCGR hw) 0))
    (panic "invalid SNVS instance"))


  ;; enable clock
  (reg/SetN (.-CCGR hw) (.-CG hw) 2r11 2r11)

  (set! (.-hpcomr hw) (+ (.-Base hw) SNVS_HPCOMR))
  (set! (.-hpsvcr hw) (+ (.-Base hw) SNVS_HPSVCR))
  (set! (.-hpsr hw) (+ (.-Base hw) SNVS_HPSR))
  (set! (.-hphacivr hw) (+ (.-Base hw) SNVS_HPHACIVR))
  (set! (.-hphacr hw) (+ (.-Base hw) SNVS_HPHACR))
  (set! (.-lptdcr hw) (+ (.-Base hw) SNVS_LPTDCR))
  (set! (.-lpsr hw) (+ (.-Base hw) SNVS_LPSR))
  (set! (.-lppgdr hw) (+ (.-Base hw) SNVS_LPPGDR))

  (when (> (.-DryIce hw) 0)
    (.initDryIce hw calibrationData)))



^{:go/end 209} (go/method setDryIcePolicy [^{:tag (* SNVS)} hw ^SecurityPolicy sp]
  (reg/Set (.-dtocr hw) DTOCR_DRYICE_EN)
  (time/Sleep (* 1 time/Millisecond))

  (reg/SetTo (.-dmcr hw) DMCR_VOLT_DET_EN (.-Voltage sp))
  (reg/SetTo (.-dmcr hw) DMCR_TEMP_DET_EN (.-Temperature sp))
  (reg/SetTo (.-dmcr hw) DMCR_CLOCK_DET_EN (.-Clock sp))
  (time/Sleep (* 1 time/Millisecond))

  ;; clear records
  (reg/Set (.-dtrr hw) DTRR_DRYICE_TEMP_DETECT)
  (reg/Set (.-dtrr hw) DTRR_DRYICE_VOLT_TAMP_DETECT)
  (reg/Set (.-dtrr hw) DTRR_SNVS_CLK_TAMP_DETECT))






^{:go/end 252} (go/method SetPolicy "SetPolicy configures the SNVS tamper detection and security violation\npolicy, It can be used to prevent a transition from soft fail to hard fail\nif invoked within the expiration of a previously applied policy (see\nSecurityPolicy.HAC).\n" [^{:tag (* SNVS)} hw ^SecurityPolicy sp]
  ^{:go/via [Mutex]} (.Lock hw)
  (defer ^{:go/via [Mutex]} (.Unlock hw))

  ;; stop High Assurance Counter
  (reg/Set (.-hpcomr hw) HPCOMR_HAC_STOP)
  (reg/Clear (.-hpcomr hw) HPCOMR_HAC_EN)

  ;; set Power Glitch Detector value and clear its record
  (reg/Write (.-lppgdr hw) LPPGDR_PGD_VAL)
  (reg/Set (.-lpsr hw) LPSR_PGD)

  ;; set LP security violation configuration
  (reg/SetTo (.-hpsvcr hw) (+ HPSVCR_LPSV_CFG 1) (.-SecurityViolation sp))

  (when (.-HardFail sp)
    (reg/Clear (.-hpcomr hw) HPCOMR_HAC_STOP)
    (reg/Write (.-hphacivr hw) (.-HAC sp))
    (reg/Set (.-hpcomr hw) HPCOMR_HAC_LOAD)
    (reg/Set (.-hpcomr hw) HPCOMR_HAC_EN))


  (when (> (.-DryIce hw) 0)
    (.setDryIcePolicy hw sp))


  ;; set tamper monitors
  (reg/SetTo (.-lptdcr hw) LPTDCR_VT_EN (.-Voltage sp))
  (reg/SetTo (.-lptdcr hw) LPTDCR_TT_EN (.-Temperature sp))
  (reg/SetTo (.-lptdcr hw) LPTDCR_CT_EN (.-Clock sp))

  ;; clear records
  (reg/Set (.-lpsr hw) LPSR_VTD)
  (reg/Set (.-lpsr hw) LPSR_TTD)
  (reg/Set (.-lpsr hw) LPSR_CTD)

  (set! (.-sp hw) sp))




^{:go/end 277} (go/method Monitor "Monitor returns the SNVS tamper System Security Monitor (SSM) state, its\nconfigured violation policy and the current High Assurance Counter value.\n" [^{:tag (* SNVS)} hw] :results [^SecurityPolicy violations]
  (let [clk (reg/Get (.-lpsr hw) LPSR_CTD)
      ^{:line 258} tmp (reg/Get (.-lpsr hw) LPSR_TTD)
      ^{:line 259} vcc (reg/Get (.-lpsr hw) LPSR_VTD)]

    (when (> (.-DryIce hw) 0)
      (set! clk (or clk (reg/Get (.-dtrr hw) DTRR_SNVS_CLK_TAMP_DETECT)))
      (set! tmp (or tmp (reg/Get (.-dtrr hw) DTRR_DRYICE_VOLT_TAMP_DETECT)))
      (set! vcc (or vcc (reg/Get (.-dtrr hw) DTRR_DRYICE_TEMP_DETECT))))


    ^{:go/breaks [2 4 6 8 10 12 14 16]} (lit SecurityPolicy
      :Clock clk
      :Temperature tmp
      :Voltage vcc
      :Power (reg/Get (.-lpsr hw) LPSR_PGD)
      :SecurityViolation (.-SecurityViolation (.-sp hw))
      :HardFail (.-HardFail (.-sp hw))
      :HAC (reg/Read (.-hphacr hw))
      :State (conv uint8 (reg/GetN (.-hpsr hw) HPSR_SSM_STATE 2r1111)))))










^{:go/end 300} (go/method Available "Available verifies whether the Secure Non Volatile Storage (SNVS) is\ncorrectly programmed and in Trusted or Secure state (indicating that Secure\nBoot is enabled and no security violations have been detected).\n\nThe unique OTPMK internal key is available only when Secure Boot (HAB) is\nenabled, otherwise a Non-volatile Test Key (NVTK), identical for each SoC,\nis used.\n" ^bool [^{:tag (* SNVS)} hw]
  (let [hpsr (reg/Read (.-hpsr hw))]

    ;; ensure that the OTPMK has been correctly programmed
    (when (or (!= (bits/GetN (addr hpsr) HPSR_OTPMK_ZERO 1) 0) (!= (bits/GetN (addr hpsr) HPSR_OTPMK_SYNDROME 0x1ff) 0))
      (return false))


    (switch (bits/GetN (addr hpsr) HPSR_SSM_STATE 2r1111)
      (case [SSM_STATE_TRUSTED SSM_STATE_SECURE]
        (return true))
      (default
        (return false)))))

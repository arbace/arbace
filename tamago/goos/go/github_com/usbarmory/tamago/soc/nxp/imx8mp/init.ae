(in-ns 'go.github_com.usbarmory.tamago.soc.nxp.imx8mp) (go/file "init.go" :imports [


    ^{:line 12} [_ "unsafe"]

    ^{:line 14} [dma "github.com/usbarmory/tamago/dma"]])



(go/const "i.MX8 processor families\n"

  ^{:line 20} [^{:val 33281 :doc "i.MX 8M Mini\n"} IMX8MMD 0x8201]
  ^{:line 21} [^{:val 33345} IMX8MMQ 0x8241]


  ^{:line 24} [^{:val 33283 :doc "i.MX 8M Plus\n"} IMX8MPD 0x8203]
  ^{:line 25} [^{:val 33344} IMX8MPQ 0x8240])



(go/var ^{:tag uint64 :go/linkname "ramStackOffset runtime/goos.RamStackOffset"} ramStackOffset 0x100)

(go/var

  ^{:line 33} [^{:tag uint32 :doc "Processor family\n"} Family]


  ^{:line 36} [^{:tag bool :doc "Flag native or emulated processor\n"} Native])




^{:go/end 46} (go/func Init "Init takes care of the lower level initialization triggered early in runtime\nsetup (e.g. runtime/goos.Hwinit1).\n" []
  (.Init ARM64)
  (.EnableCache ARM64)

  (initTimers))


^{:go/end 67} (go/func init []
  ;; Initialize watchdogs, this must be done within 16 seconds to clear
  ;; their power-down counter event
  ;; (p4085, 6.6.2.4 Power-down counter event, IMX8MPRM).
  (.Init WDOG1)
  (.Init WDOG2)
  (.Init WDOG3)

  ;; use internal OCRAM (iRAM) as default DMA region
  (dma/Init OCRAM_START OCRAM_SIZE)

  (.Init OCOTP)

  (switch Family
    (case [IMX8MMD IMX8MMQ]
      (set! (.-Banks OCOTP) 14))
    (case [IMX8MPD IMX8MPQ]
      (set! (.-Banks OCOTP) 40))))

  ^{:line 47} [^{:val 8} INTERFACE_POWER 8]


  ^{:line 50} [^{:val 9 :doc "Engineering Change Notices (ECN)\n"} OTG 9]
  ^{:line 51} [^{:val 10} DEBUG 10]
  ^{:line 52} [^{:val 11} INTERFACE_ASSOCIATION 11])



(go/const "Standard feature selectors (p280, Table 9-6, USB2.0)\n"

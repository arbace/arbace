(in-ns 'go.github_com.usbarmory.tamago.soc.nxp.usb) (go/file "setup.go" :imports [


    ^{:line 12} [binary "encoding/binary"]
    ^{:line 13} [fmt "fmt"]

    ^{:line 15} [reg "github.com/usbarmory/tamago/internal/reg"]])



(go/const "Format of Setup Data (p276, Table 9-2, USB2.0)\n"
  ^{:line 20} [^{:val 7} REQUEST_TYPE_DIR 7])



(go/const "Standard request codes (p279, Table 9-4, USB2.0)\n"
  ^{:line 25} [^{:val 0} GET_STATUS 0]
  ^{:line 26} [^{:val 1} CLEAR_FEATURE 1]
  ^{:line 27} [^{:val 3} SET_FEATURE 3]
  ^{:line 28} [^{:val 5} SET_ADDRESS 5]
  ^{:line 29} [^{:val 6} GET_DESCRIPTOR 6]
  ^{:line 30} [^{:val 7} SET_DESCRIPTOR 7]
  ^{:line 31} [^{:val 8} GET_CONFIGURATION 8]
  ^{:line 32} [^{:val 9} SET_CONFIGURATION 9]
  ^{:line 33} [^{:val 10} GET_INTERFACE 10]
  ^{:line 34} [^{:val 11} SET_INTERFACE 11]
  ^{:line 35} [^{:val 12} SYNCH_FRAME 12])



(go/const "Descriptor types (p279, Table 9-5, USB2.0)\n"
  ^{:line 40} [^{:val 1} DEVICE 1]
  ^{:line 41} [^{:val 2} CONFIGURATION 2]
  ^{:line 42} [^{:val 3} STRING 3]
  ^{:line 43} [^{:val 4} INTERFACE 4]
  ^{:line 44} [^{:val 5} ENDPOINT 5]

(in-ns 'go.github_com.usbarmory.tamago.soc.nxp.dcp) (go/file "hash.go" :imports [


    ^{:line 12} [dma "github.com/usbarmory/tamago/dma"]])




^{:go/end 23} (go/method SetHashDefaults "SetHashDefaults initializes default values for a DCP work packet that\nperforms hash operation.\n" [^{:tag (* WorkPacket)} pkt]
  (set! (.-Control0 pkt) bit-or (<< 1 DCP_CTRL0_INTERRUPT_ENABL))
  (set! (.-Control0 pkt) bit-or (<< 1 DCP_CTRL0_DECR_SEMAPHORE))
  (set! (.-Control0 pkt) bit-or (<< 1 DCP_CTRL0_ENABLE_HASH))

  (set! (.-Control1 pkt) bit-or (<< HASH_SELECT_SHA256 DCP_CTRL1_HASH_SELECT)))


^{:go/end 64} (go/method hash [^{:tag (* DCP)} hw ^{:tag (slice byte)} buf ^int mode ^int size ^bool init ^bool term] :results [^{:tag (slice byte)} sum ^error err]
  (let [sourceBufferAddress (dma/Alloc buf 4)]
    (defer (dma/Free sourceBufferAddress))

    (let [pkt (addr (lit WorkPacket))]
      (.SetHashDefaults pkt)
      (set! (.-SourceBufferAddress pkt) (conv uint32 sourceBufferAddress))
      (set! (.-BufferSize pkt) (conv uint32 (len buf)))

      (when init
        (set! (.-Control0 pkt) bit-or (<< 1 DCP_CTRL0_HASH_INIT)))


      (when term
        (set! sum (make (slice byte) size))

        (let [payloadPointer (dma/Alloc sum 4)]
          (defer (dma/Free payloadPointer))

          (set! (.-Control0 pkt) bit-or (<< 1 DCP_CTRL0_HASH_TERM))
          (set! (.-PayloadPointer pkt) (conv uint32 payloadPointer))

          (defer (^{:go/end 53} (fn []
                (dma/Read payloadPointer 0 sum)

                (for [(values i j) (values 0 (- (len sum) 1))] (< i j) (set! (values i j) (values (+ i 1) (- j 1)))
                  (set! (values (aget sum i) (aget sum j)) (values (aget sum j) (aget sum i)))))))))




      (set! (.-Control1 pkt) bit-or (<< (conv uint32 mode) DCP_CTRL1_HASH_SELECT))

      (let [ptr (dma/Alloc (.Bytes pkt) 4)]
        (defer (dma/Free ptr))

        (set! err (.cmd hw ptr 1))

        (return)))))

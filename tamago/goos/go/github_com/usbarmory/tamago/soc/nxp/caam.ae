(ns go.github_com.usbarmory.tamago.soc.nxp.caam
  (:require [arbace.go :as go]))

(go/package caam
  :path "github.com/usbarmory/tamago/soc/nxp/caam"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["caam.go" "cipher.go" "cmac.go" "command.go" "ecdsa.go" "hash.go" "job.go" "key.go" "rng.go" "rtic.go" "sha.go"]
  :init-order [RTICThrottle RTICWatchdog]
  :positions :lines)

(load "caam/caam")
(load "caam/cipher")
(load "caam/cmac")
(load "caam/command")
(load "caam/ecdsa")
(load "caam/hash")
(load "caam/job")
(load "caam/key")
(load "caam/rng")
(load "caam/rtic")
(load "caam/sha")

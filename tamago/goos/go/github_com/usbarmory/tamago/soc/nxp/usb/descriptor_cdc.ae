(go/type CDCHeaderDescriptor "CDCHeaderDescriptor implements\np45, Table 26: Class-Specific Descriptor Header Format, USB Class\nDefinitions for Communication Devices 1.1.\n" (struct
    ^{:line 69 :tag uint8} Length
    ^{:line 70 :tag uint8} DescriptorType
    ^{:line 71 :tag uint8} DescriptorSubType
    ^{:line 72 :tag uint16} bcdCDC))




^{:go/end 83} (go/method SetDefaults "SetDefaults initializes default values for the USB CDC Header Functional\nDescriptor.\n" [^{:tag (* CDCHeaderDescriptor)} d]
  (set! (.-Length d) 5)
  (set! (.-DescriptorType d) CS_INTERFACE)
  (set! (.-DescriptorSubType d) HEADER)
  ;; CDC 1.10
  (set! (.-bcdCDC d) 0x0110))



^{:go/end 90} (go/method Bytes "Bytes converts the descriptor structure to byte array format.\n" ^{:tag (slice byte)} [^{:tag (* CDCHeaderDescriptor)} d]
  (let [buf (new bytes/Buffer)]
    (binary/Write buf binary/LittleEndian d)
    (.Bytes buf)))






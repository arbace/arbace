        :CCGR CCM_CCGR74
        :Clock GetUARTClock))]



  ^{:line 142} [^{:doc "Watchdog Timer 1\n"} WDOG1 (addr ^{:go/breaks [2 4 6]} (lit wdog/WDOG
        :Index 1
        :Base WDOG1_BASE
        :CCGR CCM_CCGR83))]



  ^{:line 149} [^{:doc "Watchdog Timer 2\n"} WDOG2 (addr ^{:go/breaks [2 4 6]} (lit wdog/WDOG

        ;; required before Init()
        :TimerOffset 1))]



  ^{:line 95} [^{:tag (* caam/CAAM) :doc "Cryptographic Acceleration and Assurance Module (UL only)\n"} CAAM]


  ^{:line 98} [^{:doc "Ethernet MAC 1\n"} ENET1 (addr ^{:go/breaks [2 4 6 8 10]} (lit enet/ENET

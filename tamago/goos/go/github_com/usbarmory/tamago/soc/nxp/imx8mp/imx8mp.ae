  ^{:line 65} [^{:val 948436992} GICR_BASE 0x38880000]


  ^{:line 68} [^{:val 808779776 :doc "On-Chip OTP Controller\n"} OCOTP_BASE 0x30350000]
  ^{:line 69} [^{:val 808780800} OCOTP_BANK_BASE 0x30350400]


  ^{:line 72} [^{:val 808910848 :doc "Secure Non-Volatile Storage\n"} SNVS_HP_BASE 0x30370000]



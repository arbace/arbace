        :CCGR CCM_CCGR85))])





^{:go/end 172} (go/func SiliconVersion "SiliconVersion returns the SoC silicon version information\n(p566, 5.1.8.39 DIGPROG Register (CCM_ANALOG_DIGPROG), IMX8MPRM).\n" [] :results [^uint32 sv ^uint32 revMajor ^uint32 revMinor]
  (set! sv (reg/Read CCM_ANALOG_DIGPROG))

  (set! revMajor (bit-and (>> sv 8) 0xffff))
  (set! revMinor (bit-and sv 0xff))

  (return))



^{:go/end 187} (go/func UniqueID "UniqueID returns the NXP SoC Device Unique 128-bit ID.\n" [] :results [^{:tag (array 16 byte)} uid]
  (let [(values otp0 _) (.Read OCOTP 0 2)
      (values otp1 _) (.Read OCOTP 0 3)
      (values otp2 _) (.Read OCOTP 40 0)
      (values otp3 _) (.Read OCOTP 40 1)]

    (.PutUint32 binary/LittleEndian (subslice uid 0 4) otp0)
    (.PutUint32 binary/LittleEndian (subslice uid 4 8) otp1)
    (.PutUint32 binary/LittleEndian (subslice uid 8 12) otp2)
    (.PutUint32 binary/LittleEndian (subslice uid 8 16) otp3)

    (return)))



^{:go/end 205} (go/func Model "Model returns the SoC model name.\n" [] :results [^string model]
  (switch Family
    (case [IMX8MPD]
      (set! model "i.MX 8M Plus Dual"))
    (case [IMX8MPQ]
      (set! model "i.MX 8M Plus Quad"))
    (case [IMX8MMD]
      (set! model "i.MX 8M Mini Dual"))
    (case [IMX8MMQ]
      (set! model "i.MX 8M Mini Quad"))
    (default
      (set! model "unknown")))


  (return))

;; Package imx8mp provides support to Go bare metal unikernels, written using
;; the TamaGo framework, on the NXP i.MX 8M Plus family of System-on-Chip (SoC)
;; application processors.
;;
;; The package implements initialization and drivers for NXP i.MX8MP SoCs,
;; adopting the following reference specifications:
;;   - IMX8MPRM - i.MX 8M Plus Applications Processor Reference Manual - Rev 1 2021/06
;;
;; This package is only meant to be used with `GOOS=tamago GOARCH=arm64` as
;; supported by the TamaGo framework for bare metal Go, see
;; https://github.com/usbarmory/tamago.
(in-ns 'go.github_com.usbarmory.tamago.soc.nxp.imx8mp) (go/file "imx8mp.go" :doc "Package imx8mp provides support to Go bare metal unikernels, written using\nthe TamaGo framework, on the NXP i.MX 8M Plus family of System-on-Chip (SoC)\napplication processors.\n\nThe package implements initialization and drivers for NXP i.MX8MP SoCs,\nadopting the following reference specifications:\n  - IMX8MPRM - i.MX 8M Plus Applications Processor Reference Manual - Rev 1 2021/06\n\nThis package is only meant to be used with `GOOS=tamago GOARCH=arm64` as\nsupported by the TamaGo framework for bare metal Go, see\nhttps://github.com/usbarmory/tamago.\n" :imports [


    ^{:line 23} [binary "encoding/binary"]

    ^{:line 25} [reg "github.com/usbarmory/tamago/internal/reg"]

    ^{:line 27} [arm64 "github.com/usbarmory/tamago/arm64"]
    ^{:line 28} [gic "github.com/usbarmory/tamago/arm64/gic"]

    ^{:line 30} [caam "github.com/usbarmory/tamago/soc/nxp/caam"]
    ^{:line 31} [enet "github.com/usbarmory/tamago/soc/nxp/enet"]
    ^{:line 32} [ocotp "github.com/usbarmory/tamago/soc/nxp/ocotp"]
    ^{:line 33} [snvs "github.com/usbarmory/tamago/soc/nxp/snvs"]
    ^{:line 34} [uart "github.com/usbarmory/tamago/soc/nxp/uart"]
    ^{:line 35} [wdog "github.com/usbarmory/tamago/soc/nxp/wdog"]])



(go/const "Interrupts\n"

  ^{:line 41} [^{:val 32 :doc "The first 32 interrupts are private to the CPUs' interface.\n"} BASE_IRQ 32]


  ^{:line 44} [^{:val 150 :doc "Ethernet MAC\n"} ENET1_IRQ (+ BASE_IRQ 118)]


  ^{:line 47} [^{:val 110 :doc "Watchdog Timers\n"} WDOG1_IRQ (+ BASE_IRQ 78)]
  ^{:line 48} [^{:val 111} WDOG2_IRQ (+ BASE_IRQ 79)]
  ^{:line 49} [^{:val 42} WDOG3_IRQ (+ BASE_IRQ 10)])



(go/const "Peripheral registers\n"

  ^{:line 55} [^{:val 814743552 :doc "Cryptographic Acceleration and Assurance Module\n"} CAAM_BASE 0x30900000]


  ^{:line 58} [^{:val 1073741824 :doc "DDR base address\n"} DDR_BASE 0x40000000]



(go/const "I2C registers\n(p1462, 31.7 I2C Memory Map/Register Definition, IMX6ULLRM)\n"




  ^{:line 33} [^{:val 22 :doc "The default IFDR value corresponds to a frequency divider of 768,\nassuming 66 MHz for PERCLK_CLK_ROOT this results in a baud rate of\n85 kbps (p1464, 31.7.2 I2C Frequency Divider Register (I2Cx_IFDR),\nIMX6ULLRM).\n"} I2C_DEFAULT_IFDR 0x16]

  ^{:line 35} [^{:val 0} I2Cx_IADR 0x0000]
  ^{:line 36} [^{:val 4} I2Cx_IFDR 0x0004]

  ^{:line 38} [^{:val 8} I2Cx_I2CR 0x0008]
  ^{:line 39} [^{:val 7} I2CR_IEN 7]
  ^{:line 40} [^{:val 5} I2CR_MSTA 5]
  ^{:line 41} [^{:val 4} I2CR_MTX 4]
  ^{:line 42} [^{:val 3} I2CR_TXAK 3]
  ^{:line 43} [^{:val 2} I2CR_RSTA 2]

  ^{:line 45} [^{:val 12} I2Cx_I2SR 0x000c]
  ^{:line 46} [^{:val 5} I2SR_IBB 5]
  ^{:line 47} [^{:val 1} I2SR_IIF 1]
  ^{:line 48} [^{:val 0} I2SR_RXAK 0]

  ^{:line 50} [^{:val 16} I2Cx_I2DR 0x0010])



(go/const ^{:val 100000000 :doc "Timeout is the default timeout for I2C operations.\n"} Timeout (* 100 time/Millisecond))


(go/type I2C "I2C represents an I2C port instance.\n" (struct
    ^{:line 58} sync/Mutex


    ^{:line 61 :tag int :doc "Controller index\n"} Index

    ^{:line 63 :tag uint32 :doc "Base register\n"} Base

    ^{:line 65 :tag uint32 :doc "Clock gate register\n"} CCGR

    ^{:line 67 :tag int :doc "Clock gate\n"} CG

    ^{:line 69 :tag time/Duration :doc "Timeout for I2C operations\n"} Timeout


    ^{:line 72 :tag uint16 :doc "Div sets the frequency divider to control the I2C clock rate\n(p1464, 31.7.2 I2C Frequency Divider Register (I2Cx_IFDR), IMX6ULLRM).\n"} Div


    ^{:line 75 :tag uint32 :doc "control registers\n"} iadr

^{:go/end 115} (go/method Init "Init initializes an I2C controller instance in master mode.\n" [^{:tag (* I2C)} hw]
  ^{:go/via [Mutex]} (.Lock hw)
  (defer ^{:go/via [Mutex]} (.Unlock hw))

  (when (or (== (.-Base hw) 0) (== (.-CCGR hw) 0))
    (panic "invalid I2C controller instance"))


  (when (== (.-Timeout hw) 0)
    (set! (.-Timeout hw) Timeout))


  (when (== (.-Div hw) 0)
    (set! (.-Div hw) I2C_DEFAULT_IFDR))


  (set! (.-iadr hw) (+ (.-Base hw) I2Cx_IADR))
  (set! (.-ifdr hw) (+ (.-Base hw) I2Cx_IFDR))
  (set! (.-i2cr hw) (+ (.-Base hw) I2Cx_I2CR))
  (set! (.-i2sr hw) (+ (.-Base hw) I2Cx_I2SR))
  (set! (.-i2dr hw) (+ (.-Base hw) I2Cx_I2DR))

  ;; p1452, 31.5.1 Initialization sequence, IMX6ULLRM

  ;; enable clock
  (reg/SetN (.-CCGR hw) (.-CG hw) 2r11 2r11)

  ;; set SCL frequency
  (reg/Write16 (.-ifdr hw) (.-Div hw))

  ;; out of reset
  (reg/Set16 (.-i2cr hw) I2CR_IEN))












^{:go/end 157} (go/method Read "Read reads a sequence of bytes from a target device\n(p167, 16.4.2 Programming the I2C controller for I2C Read, IMX6FG).\n\nThe return data buffer always matches the requested size, otherwise an error\nis returned.\n\nThe address length (`alen`) parameter should be set greater then 0 for\nordinary I2C reads (`SLAVE W|ADDR|SLAVE R|DATA`), equal to 0 when not\nsending a register address (`SLAVE W|SLAVE R|DATA`) and less than 0 only to\nsend a target read (`SLAVE R|DATA`).\n" [^{:tag (* I2C)} hw ^uint8 target ^uint32 addr ^int alen ^int size] :results [^{:tag (slice byte)} buf ^error err]
  ^{:go/via [Mutex]} (.Lock hw)
  (defer ^{:go/via [Mutex]} (.Unlock hw))

  (when [(set! err (.start hw false))] (!= err nil)
    (return))

  (defer (.stop hw))

  (when (> alen 0)
    (when [(set! err (.txAddress hw target addr alen))] (!= err nil)
      (return))


    (when [(set! err (.start hw true))] (!= err nil)
      (return)))



  ;; send target address with R/W bit set
  (let [a (conv byte (bit-or (<< target 1) 1))]

    (when [(set! err (.tx hw (lit (slice byte) a)))] (!= err nil)
      (return))


    (set! buf (make (slice byte) size))
    (set! err (.rx hw buf))

    (return)))












^{:go/end 187} (go/method Write "Write writes a sequence of bytes to a target device\n(p170, 16.4.4 Programming the I2C controller for I2C Write, IMX6FG)\n\nSet greater then 0 for ordinary I2C write (`SLAVE W|ADDR|DATA`),\nset equal then 0 to not send register address (`SLAVE W|DATA`),\nalen less then 0 is invalid.\n\nThe address length (`alen`) parameter should be set greater then 0 for\nordinary I2C writes (`SLAVE W|ADDR|DATA`), equal to 0 when not sending a\nregister address (`SLAVE W|DATA`), values less than 0 are not valid.\n" [^{:tag (* I2C)} hw ^{:tag (slice byte)} buf ^uint8 target ^uint32 addr ^int alen] :results [^error err]
  (when (< alen 0)
    (return (errors/New "invalid address length")))


  ^{:go/via [Mutex]} (.Lock hw)
  (defer ^{:go/via [Mutex]} (.Unlock hw))

  (when [(set! err (.start hw false))] (!= err nil)
    (return))

  (defer (.stop hw))

  (when [(set! err (.txAddress hw target addr alen))] (!= err nil)
    (return))


  (.tx hw buf))


^{:go/end 218} (go/method txAddress [^{:tag (* I2C)} hw ^uint8 target ^uint32 addr ^int alen] :results [^error err]
  (when (> target 0x7f)
    (return (errors/New "invalid target address")))


  (when (> alen 4)
    (return (errors/New "invalid register address length")))


  (when (>= alen 0)
    ;; send target address with R/W bit unset
    (let [a (conv byte (<< target 1))]

      (when [(set! err (.tx hw (lit (slice byte) a)))] (!= err nil)
        (return))))



  ;; send register address
  (while (> alen 0)
    (dec! alen)
    (let [a (conv byte (bit-and (>> addr (* alen 8)) 0xff))]

      (when [(set! err (.tx hw (lit (slice byte) a)))] (!= err nil)
        (return))))



  (return))


^{:go/end 252} (go/method rx [^{:tag (* I2C)} hw ^{:tag (slice byte)} buf] :results [^error err]
  (let [size (len buf)]

    ;; set read from target bit
    (reg/Clear16 (.-i2cr hw) I2CR_MTX)

    (if (== size 1)
      (reg/Set16 (.-i2cr hw) I2CR_TXAK)

      (reg/Clear16 (.-i2cr hw) I2CR_TXAK))


    (reg/Clear16 (.-i2sr hw) I2SR_IIF)
    ;; dummy read
    (reg/Read16 (.-i2dr hw))

    (range [i size]
      (when (not (reg/WaitFor16 (.-Timeout hw) (.-i2sr hw) I2SR_IIF 1 1))
        (return (errors/New "timeout on byte reception")))


      (cond (== i (- size 2))
        (reg/Set16 (.-i2cr hw) I2CR_TXAK)
        (== i (- size 1))
        (.stop hw))


      (aset buf i (conv byte (bit-and (reg/Read16 (.-i2dr hw)) 0xff)))
      (reg/Clear16 (.-i2sr hw) I2SR_IIF))


    (return)))


^{:go/end 269} (go/method tx [^{:tag (* I2C)} hw ^{:tag (slice byte)} buf] :results [^error err]
  (range [i buf]
    (reg/Clear16 (.-i2sr hw) I2SR_IIF)
    (reg/Write16 (.-i2dr hw) (conv uint16 (aget buf i)))

    (when (not (reg/WaitFor16 (.-Timeout hw) (.-i2sr hw) I2SR_IIF 1 1))
      (return (errors/New "timeout on byte transmission")))


    (when (== (reg/GetN16 (.-i2sr hw) I2SR_RXAK 1) 1)
      (return (errors/New "no acknowledgement received"))))



  (return))


^{:go/end 300} (go/method start [^{:tag (* I2C)} hw ^bool repeat] :results [^error err]
  (let [^int pos (zero int)]

    (if (not repeat) (do
        ;; wait for bus to be free
        (when (not (reg/WaitFor16 (.-Timeout hw) (.-i2sr hw) I2SR_IBB 1 0))
          (return (errors/New "timeout waiting bus to be free")))


        ;; enable master mode, generates START signal
        (set! pos I2CR_MSTA))

      (set! pos I2CR_RSTA))


    (reg/Set16 (.-i2cr hw) pos)

    ;; wait for bus to be busy
    (when (not (reg/WaitFor16 (.-Timeout hw) (.-i2sr hw) I2SR_IBB 1 1))
      (reg/Clear16 (.-i2cr hw) pos)
      (return (errors/New "timeout waiting bus to be busy")))


    (when (not repeat)
      ;; set Master Transmit mode
      (reg/Set16 (.-i2cr hw) I2CR_MTX))


    (return)))


^{:go/end 305} (go/method stop [^{:tag (* I2C)} hw]
  (reg/Clear16 (.-i2cr hw) I2CR_MSTA)
  (reg/Clear16 (.-i2cr hw) I2CR_MTX))

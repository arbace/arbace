(go/const "Configuration constants (p348, 35.4.2 Frequency divider configuration,\nIMX6FG) to support the following frequencies:\n  - Identification frequency ≤ 400 KHz\n  - Operating frequency ≤ 25 MHz\n  - High frequency ≤ 50 MHz\n"
  ;; p346, 35.2 Clocks, IMX6FG.
  ;;
  ;; The root clock is derived by default from PLL2 PFD2 (396MHz) with divide
  ;; by 2, therefore 198MHz.


  ^{:line 178} [^{:val 15 :doc "Data Timeout Counter Value: SDCLK x 2** 29\n"} DTOCV 0xf]


  ^{:line 181} [^{:val 7 :doc "Divide-by-8\n"} DVS_ID 7]

  ^{:line 183} [^{:val 32 :doc "Root clock divided by 64\n"} SDCLKFS_ID 0x20]
  ;; Identification frequency: 198 / (8 * 64) == ~400 KHz


  ^{:line 187} [^{:val 1 :doc "Divide-by-2\n"} DVS_OP 1]

  ^{:line 189} [^{:val 2 :doc "Root clock divided by 4\n"} SDCLKFS_OP 0x02]
  ;; Operating frequency: 198 / (2 * 4) == 24.75 MHz


  ^{:line 193} [^{:val 1 :doc "PLL2 PFD2 clock divided by 2\n"} ROOTCLK_HS_SDR 1]
  ;; Root clock frequency: 396 MHz / (1 + 1) = 198 MHz


  ^{:line 197} [^{:val 0 :doc "Divide-by-1\n"} DVS_HS 0]

  ^{:line 199} [^{:val 2 :doc "Root clock divided by 4 (Single Data Rate mode)\n"} SDCLKFS_HS_SDR 0x02]

  ^{:line 201} [^{:val 1 :doc "Root clock divided by 4 (Dual Data Rate mode)\n"} SDCLKFS_HS_DDR 0x01])
;; High Speed frequency: 198 / (1 * 4) == 49.5 MHz




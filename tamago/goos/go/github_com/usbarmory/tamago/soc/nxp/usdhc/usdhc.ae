^{:go/end 314} (go/method setFreq "setFreq controls the clock of USDHCx_CLK line by setting\nthe SDCLKFS and DVS fields of USDHCx_SYS_CTRL register\np4035, 58.8.12 System Control (uSDHCx_SYS_CTRL), IMX6ULLRM.\n" [^{:tag (* USDHC)} hw ^int dvs ^int sdclkfs]
  ;; Prevent possible glitch on the card clock as noted in
  ;; p4011, 58.7.7 Change Clock Frequency, IMX6ULLRM.
  (reg/Clear (.-vend_spec hw) VEND_SPEC_FRC_SDCLK_ON)

  (when (and (< dvs 0) (< sdclkfs 0))
    (return))


  ;; Wait for stable clock as noted in
  ;; p4038, DVS[3:0], IMX6ULLRM.
  (reg/Wait (.-pres_state hw) PRES_STATE_SDSTB 1 1)

  (let [sys (reg/Read (.-sys_ctrl hw))]

    ;; p348, 35.4.2 Frequency divider configuration, IMX6FG
    (bits/SetN (addr sys) SYS_CTRL_DVS 0xf (conv uint32 dvs))
    (bits/SetN (addr sys) SYS_CTRL_SDCLKFS 0xff (conv uint32 sdclkfs))

    (reg/Write (.-sys_ctrl hw) sys)
    (reg/Wait (.-pres_state hw) PRES_STATE_SDSTB 1 1)

    (reg/SetTo (.-vend_spec hw) VEND_SPEC_FRC_SDCLK_ON (.-SD (.-card hw)))))





^{:go/end 357} (go/method executeTuning "executeTuning performs the bus tuning, `cmd` should be set to the relevant\nsend tuning block command index, `blocks` represents the number of tuning\nblocks.\n" ^error [^{:tag (* USDHC)} hw ^uint32 index ^uint32 blocks]
  (reg/SetN (.-tuning_ctrl hw) TUNING_CTRL_TUNING_STEP 2r111 TUNING_STEP)
  (reg/SetN (.-tuning_ctrl hw) TUNING_CTRL_TUNING_START_TAP 0xff TUNING_START_TAP)
  (reg/Set (.-tuning_ctrl hw) TUNING_CTRL_STD_TUNING_EN)

  (reg/Clear (.-ac12_err_status hw) AUTOCMD12_ERR_STATUS_SMP_CLK_SEL)
  (reg/Set (.-ac12_err_status hw) AUTOCMD12_ERR_STATUS_EXE_TUNE)

  (reg/Set (.-mix_ctrl hw) MIX_CTRL_FBCLK_SEL)
  (reg/Set (.-mix_ctrl hw) MIX_CTRL_AUTO_TUNE_EN)

  ;; temporarily disable all interrupts other than Buffer Read Ready
  (defer (reg/Write (.-int_signal_en hw) (reg/Read (.-int_signal_en hw))))
  (defer (reg/Write (.-int_status_en hw) (reg/Read (.-int_status_en hw))))
  (reg/Write (.-int_signal_en hw) INT_SIGNAL_EN_BWRIEN)
  (reg/Write (.-int_status_en hw) INT_STATUS_EN_BWRSEN)

  ;; temporarily lower read timeout for faster tuning
  (defer (^{:go/end 339} (fn [^time/Duration d]
        (set! (.-readTimeout hw) d))
      (.-readTimeout hw)))
  (set! (.-readTimeout hw) (* 1 time/Millisecond))

  (let [tuning_block (make (slice byte) blocks)]

    (range [TUNING_MAX_LOOP_COUNT]
      ;; send tuning block command, ignore responses
      (.transfer hw index READ 0 1 blocks tuning_block)

      (let [ac12_err_status (reg/Read (.-ac12_err_status hw))]

        (when (and (== (bits/GetN (addr ac12_err_status) AUTOCMD12_ERR_STATUS_EXE_TUNE 1) 0)
            (== (bits/GetN (addr ac12_err_status) AUTOCMD12_ERR_STATUS_SMP_CLK_SEL 1) 1))
          (return nil))))



    (errors/New "tuning failed")))



^{:go/end 362} (go/method Info "Info returns detected card information.\n" ^CardInfo [^{:tag (* USDHC)} hw]
  (.-card hw))



^{:go/end 403} (go/method Init "Init initializes the uSDHC controller instance.\n" [^{:tag (* USDHC)} hw ^int width]
  ^{:go/via [Mutex]} (.Lock hw)
  (defer ^{:go/via [Mutex]} (.Unlock hw))

  (when (or (== (.-Index hw) 0) (== (.-Base hw) 0) (== (.-SetClock hw) nil) (== (.-CCGR hw) 0))
    (panic "invalid uSDHC controller instance"))


  (set! (.-width hw) width)
  (set! (.-blk_att hw) (+ (.-Base hw) USDHCx_BLK_ATT))
  (set! (.-wtmk_lvl hw) (+ (.-Base hw) USDHCx_WTMK_LVL))
  (set! (.-cmd_arg hw) (+ (.-Base hw) USDHCx_CMD_ARG))
  (set! (.-cmd_xfr hw) (+ (.-Base hw) USDHCx_CMD_XFR_TYP))
  (set! (.-cmd_rsp hw) (+ (.-Base hw) USDHCx_CMD_RSP0))
  (set! (.-prot_ctrl hw) (+ (.-Base hw) USDHCx_PROT_CTRL))
  (set! (.-sys_ctrl hw) (+ (.-Base hw) USDHCx_SYS_CTRL))
  (set! (.-mix_ctrl hw) (+ (.-Base hw) USDHCx_MIX_CTRL))
  (set! (.-pres_state hw) (+ (.-Base hw) USDHCx_PRES_STATE))
  (set! (.-int_status hw) (+ (.-Base hw) USDHCx_INT_STATUS))
  (set! (.-int_status_en hw) (+ (.-Base hw) USDHCx_INT_STATUS_EN))
  (set! (.-int_signal_en hw) (+ (.-Base hw) USDHCx_INT_SIGNAL_EN))
  (set! (.-adma_sys_addr hw) (+ (.-Base hw) USDHCx_ADMA_SYS_ADDR))
  (set! (.-adma_err_status hw) (+ (.-Base hw) USDHCx_ADMA_ERR_STATUS))
  (set! (.-ac12_err_status hw) (+ (.-Base hw) USDHCx_AUTOCMD12_ERR_STATUS))
  (set! (.-vend_spec hw) (+ (.-Base hw) USDHCx_VEND_SPEC))
  (set! (.-vend_spec2 hw) (+ (.-Base hw) USDHCx_VEND_SPEC2))
  (set! (.-tuning_ctrl hw) (+ (.-Base hw) USDHCx_TUNING_CTRL))

  ;; Generic SD specs read/write timeout rules (applied also to MMC by
  ;; this driver).
  ;;
  ;; p106, 4.6.2.1 Read, SD-PL-7.10
  (set! (.-readTimeout hw) (* 100 time/Millisecond))
  ;; p106, 4.6.2.2 Write, SD-PL-7.10
  (set! (.-writeTimeout hw) (* 500 time/Millisecond))

  ;; enable clock
  (reg/SetN (.-CCGR hw) (.-CG hw) 2r11 2r11))






^{:go/end 495} (go/method Detect "Detect initializes an SD/MMC card. The highest speed supported by the\ndriver, card and controller is automatically selected. Speed modes that\nrequire voltage switching require definition of function VoltageSelect on\nthe USDHC instance, which is up to board packages.\n" [^{:tag (* USDHC)} hw] :results [^error err]
  ^{:go/via [Mutex]} (.Lock hw)
  (defer ^{:go/via [Mutex]} (.Unlock hw))

  (when (== (.-sys_ctrl hw) 0)
    (return (errors/New "controller is not initialized")))


  ;; check if a card has already been detected and not removed since
  (when (and (== (reg/GetN (.-int_status hw) INT_STATUS_CRM 1) 0) ^:go/paren (or (.-MMC (.-card hw)) (.-SD (.-card hw))))
    (return))


  ;; clear card information
  (set! (.-card hw) (lit CardInfo))

  ;; soft reset uSDHC
  (reg/Set (.-sys_ctrl hw) SYS_CTRL_RSTA)
  (reg/Wait (.-sys_ctrl hw) SYS_CTRL_RSTA 1 0)

  ;; A soft reset fails to clear MIX_CTRL register, clear it all except
  ;; tuning bits.
  (let [mix (reg/Read (.-mix_ctrl hw))]
    (bits/Clear (addr mix) MIX_CTRL_FBCLK_SEL)
    (bits/Clear (addr mix) MIX_CTRL_AUTO_TUNE_EN)
    (bits/Clear (addr mix) MIX_CTRL_SMP_CLK_SEL)
    (bits/Clear (addr mix) MIX_CTRL_EXE_TUNE)
    (reg/Write (.-mix_ctrl hw) mix)

    ;; data transfer width, default to 1-bit mode
    (let [dtw 2r00]

      (switch (.-width hw)
        (case [1]
          (set! dtw 2r00))
        (case [4]
          (set! dtw 2r01))
        (case [8]
          (set! dtw 2r10))
        (default
          (return (errors/New "unsupported controller data transfer width"))))


      ;; set data transfer width
      (reg/SetN (.-prot_ctrl hw) PROT_CTRL_DTW 2r11 (conv uint32 dtw))
      ;; set little endian mode
      (reg/SetN (.-prot_ctrl hw) PROT_CTRL_EMODE 2r11 2r10)

      ;; clear clock
      (.setFreq hw -1 -1)
      ;; set identification frequency
      (.setFreq hw DVS_ID SDCLKFS_ID)

      ;; set data timeout counter to SDCLK x 2^28
      (reg/Clear (.-int_status_en hw) INT_STATUS_EN_DTOESEN)
      (reg/SetN (.-sys_ctrl hw) SYS_CTRL_DTOCV 0xf DTOCV)
      (reg/Set (.-int_status_en hw) INT_STATUS_EN_DTOESEN)

      ;; initialize
      (reg/Set (.-sys_ctrl hw) SYS_CTRL_INITA)
      (reg/Wait (.-sys_ctrl hw) SYS_CTRL_INITA 1 0)

      ;; CMD0 - GO_IDLE_STATE - reset card
      (when [(set! err (.cmd hw 0 GO_IDLE_STATE 0 0))] (!= err nil)
        (return))


      (cond (.voltageValidationSD hw)
        (set! err (.initSD hw))
        (.voltageValidationMMC hw)
        (set! err (.initMMC hw)) :else

        (return (fmt/Errorf "no card detected on uSDHC%d" (.-Index hw))))


      (when (!= err nil)
        (return))


      (when (not (.-DDR (.-card hw)))
        ;; CMD16 - SET_BLOCKLEN - define the block length,
        ;; only legal In single data rate mode.
        (set! err (.cmd hw 16 (conv uint32 (.-BlockSize (.-card hw))) 0 0)))


      (return))))






^{:go/end 594} (go/method transfer "transfer data from/to the card as specified in:\n\n\tp347, 35.5.1 Reading data from the card, IMX6FG,\n\tp354, 35.5.2 Writing data to the card, IMX6FG.\n" [^{:tag (* USDHC)} hw ^uint32 index ^uint32 dtd ^uint64 arg ^uint32 blocks ^uint32 blockSize ^{:tag (slice byte)} buf] :results [^error err]
  (let [^time/Duration timeout (zero time/Duration)]

    (when (== (.-blk_att hw) 0)
      (return (errors/New "controller is not initialized")))


    (when (or (== blocks 0) (== blockSize 0))
      (return))


    (when (> blocks 0xffff)
      (return (errors/New "transfer size cannot exceed 65535 blocks")))


    ;; State polling cannot be issued while tuning (CMD19 and CMD21).
    (when (not (or (== index 19) (== index 21)))
      (when [(set! err (.waitState hw CURRENT_STATE_TRAN (* 1 time/Millisecond)))] (!= err nil)
        (return)))



    ;; set block size
    (reg/SetN (.-blk_att hw) BLK_ATT_BLKSIZE 0x1fff blockSize)
    ;; set block count
    (reg/SetN (.-blk_att hw) BLK_ATT_BLKCNT 0xffff blocks)

    (let [bufAddress (dma/Alloc buf 32)]
      (defer (dma/Free bufAddress))

      ;; ADMA2 descriptor
      (let [bd (addr (lit ADMABufferDescriptor))]
        (.Init bd bufAddress (len buf))

        (let [bdAddress (dma/Alloc (.Bytes bd) 4)]
          (defer (dma/Free bdAddress))

          (reg/Write (.-adma_sys_addr hw) (conv uint32 bdAddress))

          (when (and (.-HC (.-card hw)) ^:go/paren (or (== index 18) (== index 25)))
            ;; p102, 4.3.14 Command Functional Difference in Card Capacity Types, SD-PL-7.10
            (set! arg (/ arg (conv uint64 blockSize))))


          (when (.-rpmb hw)
            (set! err (.partitionAccessMMC hw PARTITION_ACCESS_RPMB))

            (when (!= err nil)
              (return))


            (let [cmd23Arg blocks]

              (when (.-rel hw)
                ;; reliable write request
                (bits/Set (addr cmd23Arg) 31))


              ;; CMD23 - SET_BLOCK_COUNT - define read/write block count
              (when [(set! err (.cmd hw 23 cmd23Arg 0 0))] (!= err nil)
                (return))


              (defer (.partitionAccessMMC hw PARTITION_ACCESS_NONE))))


          (switch dtd
            (case [WRITE]
              (set! timeout (* (.-writeTimeout hw) (conv time/Duration blocks)))
              ;; set write watermark level
              (reg/SetN (.-wtmk_lvl hw) WTMK_LVL_WR_WML 0xff (/ blockSize 4)))
            (case [READ]
              (set! timeout (* (.-readTimeout hw) (conv time/Duration blocks)))
              ;; set read watermark level
              (reg/SetN (.-wtmk_lvl hw) WTMK_LVL_RD_WML 0xff (/ blockSize 4))))


          (set! err (.cmd hw index (conv uint32 arg) blocks timeout))
          (let [adma_err (reg/Read (.-adma_err_status hw))]

            (when (!= err nil)
              (return (fmt/Errorf "len:%d arg:%#x timeout:%v ADMA:%#x, %v" (len buf) arg timeout adma_err err)))


            (when (> adma_err 0)
              (return (fmt/Errorf "len:%d arg:%#x timeout:%v ADMA:%#x" (len buf) arg timeout adma_err)))


            (when (== dtd READ)
              (dma/Read bufAddress 0 buf))


            (return)))))))


^{:go/end 615} (go/method transferBlocks [^{:tag (* USDHC)} hw ^uint32 index ^uint32 dtd ^int lba ^{:tag (slice byte)} buf] :results [^error err]
  (let [blockSize (.-BlockSize (.-card hw))
      ^{:line 598} offset (* (conv uint64 lba) (conv uint64 blockSize))
      ^{:line 599} size (len buf)]

    (when (or (== size 0) (== blockSize 0))
      (return))


    (when (!= (% size blockSize) 0)
      (return (fmt/Errorf "write size must be %d bytes aligned" blockSize)))


    (let [blocks (/ size blockSize)]

      ^{:go/via [Mutex]} (.Lock hw)
      (defer ^{:go/via [Mutex]} (.Unlock hw))

      (.transfer hw index dtd offset (conv uint32 blocks) (conv uint32 blockSize) buf))))



^{:go/end 621} (go/method WriteBlocks "WriteBlocks transfers full blocks of data to the card.\n" [^{:tag (* USDHC)} hw ^int lba ^{:tag (slice byte)} buf] :results [^error err]
  ;; CMD25 - WRITE_MULTIPLE_BLOCK - write consecutive blocks
  (.transferBlocks hw 25 WRITE lba buf))



^{:go/end 627} (go/method ReadBlocks "ReadBlocks transfers full blocks of data from the card.\n" [^{:tag (* USDHC)} hw ^int lba ^{:tag (slice byte)} buf] :results [^error err]
  ;; CMD18 - READ_MULTIPLE_BLOCK - read consecutive blocks
  (.transferBlocks hw 18 READ lba buf))



^{:go/end 672} (go/method Read "Read transfers data from the card.\n" [^{:tag (* USDHC)} hw ^int64 offset ^int64 size] :results [^{:tag (slice byte)} buf ^error err]
  (let [blockSize (conv int64 (.-BlockSize (.-card hw)))]

    (when (or (== size 0) (== blockSize 0))
      (return))


    (let [blockOffset (% offset blockSize)
        ^{:line 638} blocks (/ (+ blockOffset size) blockSize)]

      (cond (== blocks 0)
        (set! blocks 1)
        (!= (% (+ offset size) blockSize) 0)
        (set! blocks + 1))


      (let [bufSize (conv int (* blocks blockSize))]

        ;; data buffer
        (set! buf (make (slice byte) bufSize))

        ^{:go/via [Mutex]} (.Lock hw)
        (defer ^{:go/via [Mutex]} (.Unlock hw))

        ;; CMD18 - READ_MULTIPLE_BLOCK - read consecutive blocks
        (set! err (.transfer hw 18 READ (conv uint64 offset) (conv uint32 blocks) (conv uint32 blockSize) buf))

        (when (!= err nil)
          (return))


        (let [trim (% size blockSize)]

          (cond (.-HC (.-card hw))
            (when (or (!= blockOffset 0) (> trim 0))
              (set! buf (subslice buf blockOffset (+ blockOffset size))))

            (> trim 0)
            (set! buf (subslice buf _ (+ offset size))))


          (return))))))

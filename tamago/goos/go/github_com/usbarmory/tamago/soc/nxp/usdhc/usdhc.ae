    ^{:line 266 :tag uint32} int_status
    ^{:line 267 :tag uint32} int_status_en
    ^{:line 268 :tag uint32} int_signal_en
    ^{:line 269 :tag uint32} adma_sys_addr
    ^{:line 270 :tag uint32} adma_err_status
    ^{:line 271 :tag uint32} ac12_err_status
    ^{:line 272 :tag uint32} vend_spec
    ^{:line 273 :tag uint32} vend_spec2
    ^{:line 274 :tag uint32} tuning_ctrl


    ^{:line 277 :tag CardInfo :doc "detected card properties\n"} card


    ^{:line 280 :tag bool :doc "eMMC Replay Protected Memory Block (RPMB) operation\n"} rpmb


(in-ns 'go.github_com.usbarmory.tamago.soc.sifive.clint) (go/file "timer.go" :imports [])

^{:go/end 16} (go/func mulDiv ^uint64 [^uint64 x ^uint64 m ^uint64 d]
  (let [divx (/ x d)
      ^{:line 12} modx (- x (* divx d))
      ^{:line 13} divm (/ m d)
      ^{:line 14} modm (- m (* divm d))]
    (+ (* divx m) (* modx divm) (/ (* modx modm) d))))



^{:go/end 21} (go/method Nanotime "Nanotime returns the number of nanoseconds counted from the RTCCLK input.\n" ^int64 [^{:tag (* CLINT)} hw]
  (conv int64 (mulDiv (.Mtime hw) 1.0E9 (.-RTCCLK hw))))

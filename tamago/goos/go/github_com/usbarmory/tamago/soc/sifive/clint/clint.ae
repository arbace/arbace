  ^{:line 26} [^{:val 0} MSIP 0x0000]
  ^{:line 27} [^{:val 49144} MTIME 0xbff8])



(go/type CLINT "CLINT represents a Core-Local Interruptor (CLINT) instance.\n" (struct

    ^{:line 33 :tag uint64 :doc "Base register\n"} Base

    ^{:line 35 :tag uint64 :doc "CPU real time clock\n"} RTCCLK))



^{:go/end 41} (go/method Mtime "Mtime returns the number of cycles counted from the RTCCLK input.\n" ^uint64 [^{:tag (* CLINT)} hw]

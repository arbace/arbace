(in-ns 'go.github_com.usbarmory.tamago.soc.sifive.clint) (go/file "irq.go" :imports [


    ^{:line 11} [reg "github.com/usbarmory/tamago/internal/reg"]])



^{:go/end 18} (go/method IPI "IPI sends an Inter-Processor Interrupt (IPI).\n" [^{:tag (* CLINT)} hw ^int hart]
  (let [off (+ MSIP (conv uint32 (* hart 4)))]
    (reg/Set (+ (conv uint32 (.-Base hw)) off) 0)))



^{:go/end 24} (go/method ClearIPI "ClearIPI clears an Inter-Processor Interrupt (IPI).\n" [^{:tag (* CLINT)} hw ^int hart]
  (let [off (+ MSIP (conv uint32 (* hart 4)))]
    (reg/Clear (+ (conv uint32 (.-Base hw)) off) 0)))

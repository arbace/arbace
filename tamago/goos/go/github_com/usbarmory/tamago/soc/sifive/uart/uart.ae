  ^{:line 49} [^{:val 48} UART_SETUP_8N1 0x30])



(go/type UART "UART represents a serial port instance.\n" (struct

    ^{:line 55 :tag int :doc "Controller index\n"} Index

    ^{:line 57 :tag uint32 :doc "Base register\n"} Base



    ^{:line 61 :tag (func [] [uint32]) :doc "Clock returns the UART input clock frequency in Hz; when set the baud\nrate divisor is programmed during Init (otherwise the divisor left by\nan earlier boot stage is kept).\n"} Clock


    ^{:line 64 :tag uint32 :doc "Baudrate is the desired baud rate; defaults to UART_DEFAULT_BAUDRATE\nwhen zero. Only used when Clock is set.\n"} Baudrate



    ^{:line 68 :tag uint32 :doc "Setup, when non-zero, is written to the framing setup register\n(offset 0x20) during Init. Required by the Nuclei UX600 UART variant\n(UART_SETUP_8N1); leave zero for standard SiFive FU540 UARTs.\n"} Setup


    ^{:line 71 :tag uint32 :doc "control registers\n"} txdata
    ^{:line 72 :tag uint32} rxdata))




^{:go/end 104} (go/method Init "Init initializes and enables the UART for RS-232 mode,\np3605, 55.13.1 Programming the UART in RS-232 mode, IMX6ULLRM.\n" [^{:tag (* UART)} hw]
  (when (== (.-Base hw) 0)
    (panic "invalid UART controller instance"))


  (set! (.-txdata hw) (+ (.-Base hw) UARTx_TXDATA))
  (set! (.-rxdata hw) (+ (.-Base hw) UARTx_RXDATA))

  (when (!= (.-Clock hw) nil)
    (let [baudrate (.-Baudrate hw)]

      (when (== baudrate 0)
        (set! baudrate UART_DEFAULT_BAUDRATE))


      ;; div = ceil(f_in / baud) - 1 (SiFive FSBL convention, matching
      ;; the vendor OpenSBI and U-Boot drivers).
      (let [clock ((.-Clock hw))]
        (reg/Write (+ (.-Base hw) UARTx_DIV) (- (/ (- (+ clock baudrate) 1) baudrate) 1)))))


  (when (!= (.-Setup hw) 0)
    (reg/Write (+ (.-Base hw) UARTx_SETUP) (.-Setup hw)))


  (reg/Set (+ (.-Base hw) UARTx_TXCTRL) CTRL_EN)
  (reg/Set (+ (.-Base hw) UARTx_RXCTRL) CTRL_EN))



^{:go/end 113} (go/method Tx "Tx transmits a single character to the serial port.\n" [^{:tag (* UART)} hw ^byte c]
  (while (== (reg/GetN (.-txdata hw) TXDATA_FULL 1) 1))
  ;; wait for TX FIFO to have room for a character


  (reg/Write (.-txdata hw) (conv uint32 c)))



^{:go/end 124} (go/method Rx "Rx receives a single character from the serial port.\n" [^{:tag (* UART)} hw] :results [^byte c ^bool valid]
  (let [rxdata (reg/Read (.-rxdata hw))]

    (when (== (bits/GetN (addr rxdata) RXDATA_EMPTY 1) 1)
      (return))


    (return (conv byte (bits/GetN (addr rxdata) RXDATA_DATA 0xff)) true)))



^{:go/end 133} (go/method Write "Write data from buffer to serial port.\n" [^{:tag (* UART)} hw ^{:tag (slice byte)} buf] :results [^int n ^error _]
  (range [_ c buf]
    (.Tx hw c))


  (return (len buf) nil))



^{:go/end 154} (go/method Read "Read available data to buffer from serial port.\n" [^{:tag (* UART)} hw ^{:tag (slice byte)} buf] :results [^int n ^error _]
  (let [^bool valid (zero bool)]

    (while (< n (len buf))
      (set! (values (aget buf n) valid) (.Rx hw))

      (when (not valid)
        (when (== n 0)
          (runtime/Gosched))


        (break))


      (inc! n))


    (return)))

  ^{:line 31} [^{:val 0} UARTx_TXDATA 0x0000]
  ^{:line 32} [^{:val 31} TXDATA_FULL 31]
  ^{:line 33} [^{:val 0} TXDATA_DATA 0]

  ^{:line 35} [^{:val 4} UARTx_RXDATA 0x0004]

(ns go.github_com.usbarmory.tamago.soc.sifive.clint
  (:require [arbace.go :as go]))

(go/package clint
  :path "github.com/usbarmory/tamago/soc/sifive/clint"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["clint.go" "irq.go" "timer.go"]
  :init-order []
  :positions :lines)

(load "clint/clint")
(load "clint/irq")
(load "clint/timer")

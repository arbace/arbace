;; Package physicalfilter implements a driver for SiFive physical-filter IP
;; adopting the following reference specifications:
;;   - FU740C00RM - SiFive FU740-C000 Manual - v1p2 2021/03/25
;;
;; This package is only meant to be used with `GOOS=tamago GOARCH=riscv64` as
;; supported by the TamaGo framework for bare metal Go on RISC-V SoCs, see
;; https://github.com/usbarmory/tamago.
(in-ns 'go.github_com.usbarmory.tamago.soc.sifive.physicalfilter) (go/file "physical_filter.go" :doc "Package physicalfilter implements a driver for SiFive physical-filter IP\nadopting the following reference specifications:\n  - FU740C00RM - SiFive FU740-C000 Manual - v1p2 2021/03/25\n\nThis package is only meant to be used with `GOOS=tamago GOARCH=riscv64` as\nsupported by the TamaGo framework for bare metal Go on RISC-V SoCs, see\nhttps://github.com/usbarmory/tamago.\n" :imports [


    ^{:line 19} [errors "errors"]
    ^{:line 20} [sync "sync"]

    ^{:line 22} [bits "github.com/usbarmory/tamago/bits"]
    ^{:line 23} [reg "github.com/usbarmory/tamago/internal/reg"]])




(go/const "DevicePMP constants\n(p194, 23.2.1 Physical Filter Registers, FU740C00RM).\n"
  ^{:line 29} [^{:val 0} DEVICE_PMP_0 0x00]

  ^{:line 31} [^{:val 10} PMP_ADDR_HI 10]
  ^{:line 32} [^{:val 63} PMP_L 63] ; lock
  ^{:line 33} [^{:val 59} PMP_A 59] ; address-matching mode
  ^{:line 34} [^{:val 57} PMP_W 57] ; write access
  ^{:line 35} [^{:val 56} PMP_R 56] ; read access

  ^{:line 37} [^{:val false} PMP_A_OFF false] ; Null region (disabled)
  ^{:line 38} [^{:val true} PMP_A_TOR true]) ; Top of range



(go/type PhysicalFilter "PhysicalFilter represents a Physical Filter instance.\n" (struct
    ^{:line 43} sync/Mutex


    ^{:line 46 :tag uint32 :doc "Base register\n"} Base))




^{:go/end 67} (go/method ReadPMP "ReadPMP returns the Device Physical Memory Protection register,\nconfiguration and address, for the relevant index.\n" [^{:tag (* PhysicalFilter)} hw ^int i] :results [^uint64 addr ^bool r ^bool w ^bool a ^bool l ^error err]
  (when (> i 3)
    (set! err (errors/New "invalid PMP index"))
    (return))


  (let [pmp (reg/Read64 (+ (conv uint64 (.-Base hw)) (conv uint64 (* 8 i))))]

    (set! addr (<< (bits/GetN64 (addr pmp) PMP_ADDR_HI 0x1ffffff) 4))

    (set! r (== (bits/GetN64 (addr pmp) PMP_R 1) 1))
    (set! w (== (bits/GetN64 (addr pmp) PMP_W 1) 1))
    (set! a (== (bits/GetN64 (addr pmp) PMP_A 1) 1))
    (set! l (== (bits/GetN64 (addr pmp) PMP_L 1) 1))

    (return)))




^{:go/end 89} (go/method WritePMP "WritePMP sets the Device Physical Memory Protection register, configuration\nand address, for the relevant index.\n" [^{:tag (* PhysicalFilter)} hw ^int i ^uint64 addr ^bool r ^bool w ^bool a ^bool l] :results [^error err]
  (when (> i 3)
    (return (errors/New "invalid PMP index")))


  ^{:go/via [Mutex]} (.Lock hw)
  (defer ^{:go/via [Mutex]} (.Unlock hw))

  (let [pmp (reg/Read64 (+ (conv uint64 (.-Base hw)) (conv uint64 (* 8 i))))]

    (bits/SetN64 (addr pmp) PMP_ADDR_HI 0x1ffffff (>> addr 4))

    (bits/SetTo64 (addr pmp) PMP_R r)
    (bits/SetTo64 (addr pmp) PMP_W w)
    (bits/SetTo64 (addr pmp) PMP_A a)
    (bits/SetTo64 (addr pmp) PMP_L l)

    (return)))

;; Package etimer implements a driver for the Enhanced Timer (ETimer) blocks
;; found on Nuvoton SoCs adopting the following reference specifications:
;;   - NUC980 Series Datasheet - Rev 1.24
;;
;; This package is only meant to be used with `GOOS=tamago GOARCH=arm` as
;; supported by the TamaGo framework for bare metal Go, see
;; https://github.com/usbarmory/tamago.
(in-ns 'go.github_com.usbarmory.tamago.soc.nuvoton.etimer) (go/file "etimer.go" :doc "Package etimer implements a driver for the Enhanced Timer (ETimer) blocks\nfound on Nuvoton SoCs adopting the following reference specifications:\n  - NUC980 Series Datasheet - Rev 1.24\n\nThis package is only meant to be used with `GOOS=tamago GOARCH=arm` as\nsupported by the TamaGo framework for bare metal Go, see\nhttps://github.com/usbarmory/tamago.\n" :imports [


    ^{:line 19} [reg "github.com/usbarmory/tamago/internal/reg"]])



(go/const "ETimer registers\n"
  ^{:line 24} [^{:val 0} CTL 0x00] ; Timer Control Register
  ^{:line 25} [^{:val 4} PRECNT 0x04] ; Pre-scale Counter Register


  ^{:line 28} [^{:val 8 :doc "Compare Register\n"} CMPR 0x08]
  ^{:line 29} [^{:val 16777215} CMPR_MAX 0x00ffffff]


  ^{:line 32} [^{:val 12 :doc "// Interrupt Enable Register\n"} IER 0x0c]
  ^{:line 33} [^{:val 0} IER_CMP_IEN 0]

  ^{:line 35} [^{:val 16} ISR 0x10] ; Interrupt Status Register
  ^{:line 36} [^{:val 20} DR 0x14]) ; Data Register (current count)



(go/const "CTL register bits.\n"
  ^{:line 41} [^{:val 1} CTL_EN 0x01] ; bit 0: timer enable (CEN)
  ^{:line 42} [^{:val 8} CTL_DBGACK 0x08] ; bit 3: continue counting during ICE debug halt
  ^{:line 43} [^{:val 16} CTL_PERIODIC 0x10] ; bits [5:4] = 01: periodic mode
  ^{:line 44} [^{:val 32} CTL_TOGGLE 0x20] ; bits [5:4] = 10: toggle mode
  ^{:line 45} [^{:val 48} CTL_CONTINUOUS 0x30]) ; bits [5:4] = 11: continuous (free-running)



(go/type ETimer "ETimer represents an Enhanced Timer instance.\n" (struct

    ^{:line 51 :tag uint32 :doc "Base register\n"} Base))



^{:go/end 57} (go/method Stop "Stop disables the timer.\n" [^{:tag (* ETimer)} hw]
  (reg/Write (+ (.-Base hw) CTL) 0))




^{:go/end 63} (go/method SetPrescale "SetPrescale sets the pre-scale divider; the tick rate is the eclk source\ndivided by (prescale + 1).\n" [^{:tag (* ETimer)} hw ^uint32 prescale]
  (reg/Write (+ (.-Base hw) PRECNT) prescale))




^{:go/end 69} (go/method SetCompare "SetCompare sets the 24-bit compare value at which the timer wraps or\ntriggers its interrupt.\n" [^{:tag (* ETimer)} hw ^uint32 compare]
  (reg/Write (+ (.-Base hw) CMPR) (bit-and compare CMPR_MAX)))



^{:go/end 74} (go/method EnableInterrupt "EnableInterrupt enables or disables the compare-match interrupt.\n" [^{:tag (* ETimer)} hw ^bool enable]
  (reg/SetTo (+ (.-Base hw) IER) IER_CMP_IEN enable))



^{:go/end 79} (go/method ClearInterrupt "ClearInterrupt clears a pending compare-match interrupt.\n" [^{:tag (* ETimer)} hw]
  (reg/Write (+ (.-Base hw) ISR) 0x1))




^{:go/end 85} (go/method Start "Start enables the timer with CTL_EN set together with the given mode bits\n(e.g. CTL_PERIODIC, CTL_DBGACK).\n" [^{:tag (* ETimer)} hw ^uint32 mode]
  (reg/Write (+ (.-Base hw) CTL) (bit-or CTL_EN mode)))



^{:go/end 90} (go/method Count "Count returns the current 24-bit counter value.\n" ^uint32 [^{:tag (* ETimer)} hw]
  (bit-and (reg/Read (+ (.-Base hw) DR)) CMPR_MAX))



^{:go/end 95} (go/method Control "Control returns the CTL register value.\n" ^uint32 [^{:tag (* ETimer)} hw]
  (reg/Read (+ (.-Base hw) CTL)))



^{:go/end 100} (go/method Compare "Compare returns the CMPR register value.\n" ^uint32 [^{:tag (* ETimer)} hw]
  (reg/Read (+ (.-Base hw) CMPR)))



^{:go/end 105} (go/method InterruptEnabled "InterruptEnabled returns the IER register value.\n" ^uint32 [^{:tag (* ETimer)} hw]
  (reg/Read (+ (.-Base hw) IER)))



^{:go/end 110} (go/method InterruptStatus "InterruptStatus returns the ISR register value.\n" ^uint32 [^{:tag (* ETimer)} hw]
  (reg/Read (+ (.-Base hw) ISR)))

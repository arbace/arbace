;; Package uart implements a driver for the UART Interface Controller found on
;; Nuvoton SoCs adopting the following reference specifications:
;;   - NUC980 Series Datasheet - Rev 1.24
;;
;; This package is only meant to be used with `GOOS=tamago GOARCH=arm` as
;; supported by the TamaGo framework for bare metal Go, see
;; https://github.com/usbarmory/tamago.
(in-ns 'go.github_com.usbarmory.tamago.soc.nuvoton.uart) (go/file "uart.go" :doc "Package uart implements a driver for the UART Interface Controller found on\nNuvoton SoCs adopting the following reference specifications:\n  - NUC980 Series Datasheet - Rev 1.24\n\nThis package is only meant to be used with `GOOS=tamago GOARCH=arm` as\nsupported by the TamaGo framework for bare metal Go, see\nhttps://github.com/usbarmory/tamago.\n" :imports [


    ^{:line 19} [reg "github.com/usbarmory/tamago/internal/reg"]])



(go/const "UART register offsets (from UART.Base).\n"
  ^{:line 24} [^{:val 0} RBR 0x00] ; Receive Buffer Register
  ^{:line 25} [^{:val 0} THR 0x00] ; Transmit Holding Register (same offset)
  ^{:line 26} [^{:val 4} IER 0x04] ; Interrupt Enable Register


  ^{:line 29} [^{:val 8 :doc "FIFO Control Register\n"} FCR 0x08]
  ^{:line 30} [^{:val 1} FCR_RFR 1] ; RX FIFO reset
  ^{:line 31} [^{:val 2} FCR_TFR 2] ; TX FIFO reset


  ^{:line 34} [^{:val 12 :doc "Line Control Register\n"} LCR 0x0c]
  ^{:line 35} [^{:val 0} LCR_WLS 0] ; word length select [1:0]


  ^{:line 38} [^{:val 16 :doc "Modem Control Register\n"} MCR 0x10]


  ^{:line 41} [^{:val 24 :doc "FIFO Status Register\n"} FSR 0x18]
  ^{:line 42} [^{:val 23} FSR_TXFULL 23]


  ^{:line 45} [^{:val 36 :doc "Baud Rate Divisor Register\n"} BAUD 0x24])



(go/const ^{:val 3 :doc "WLS_8BIT selects an 8-bit word length in the LCR_WLS field.\n"} WLS_8BIT 2r11)


(go/type UART "UART represents a Nuvoton UART instance.\n" (struct

    ^{:line 54 :tag uint32 :doc "Base register\n"} Base


    ^{:line 57 :tag uint32 :doc "Baud is the value written to the BAUD divisor register, it encodes\nboth the divider mode and divisor for the configured input clock.\n"} Baud))



^{:go/end 75} (go/method Init "Init configures the UART for 8N1 operation at the divisor set in Baud.\n" [^{:tag (* UART)} hw]
  (when (== (.-Base hw) 0)
    (panic "invalid UART controller instance"))


  ;; 8-bit word length, no parity, 1 stop bit
  (reg/SetN (+ (.-Base hw) LCR) LCR_WLS 2r11 WLS_8BIT)

  ;; reset the TX/RX FIFOs
  (reg/Set (+ (.-Base hw) FCR) FCR_RFR)
  (reg/Set (+ (.-Base hw) FCR) FCR_TFR)

  ;; baud rate divisor
  (reg/Write (+ (.-Base hw) BAUD) (.-Baud hw)))



^{:go/end 83} (go/method Tx "Tx transmits a single character to the serial port.\n" [^{:tag (* UART)} hw ^byte c]
  (while (reg/Get (+ (.-Base hw) FSR) FSR_TXFULL))


  (reg/Write (+ (.-Base hw) THR) (conv uint32 c)))



^{:go/end 92} (go/method Write "Write data from buffer to serial port.\n" [^{:tag (* UART)} hw ^{:tag (slice byte)} buf] :results [^int n ^error _]
  (range [_ c buf]
    (.Tx hw c))


  (return (len buf) nil))

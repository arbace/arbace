;; Package aic implements a driver for the Advanced Interrupt Controller (AIC)
;; found on Nuvoton SoCs adopting the following reference specifications:
;;   - NUC980 Series Datasheet - Rev 1.24
;;
;; The AIC supports 64 interrupt sources (IRQ0..IRQ63). Sources 0..31 are
;; controlled by the low-word registers, sources 32..63 by the high-word
;; (H) registers.
;;
;; This package is only meant to be used with `GOOS=tamago GOARCH=arm` as
;; supported by the TamaGo framework for bare metal Go, see
;; https://github.com/usbarmory/tamago.
(in-ns 'go.github_com.usbarmory.tamago.soc.nuvoton.aic) (go/file "aic.go" :doc "Package aic implements a driver for the Advanced Interrupt Controller (AIC)\nfound on Nuvoton SoCs adopting the following reference specifications:\n  - NUC980 Series Datasheet - Rev 1.24\n\nThe AIC supports 64 interrupt sources (IRQ0..IRQ63). Sources 0..31 are\ncontrolled by the low-word registers, sources 32..63 by the high-word\n(H) registers.\n\nThis package is only meant to be used with `GOOS=tamago GOARCH=arm` as\nsupported by the TamaGo framework for bare metal Go, see\nhttps://github.com/usbarmory/tamago.\n" :imports [


    ^{:line 23} [reg "github.com/usbarmory/tamago/internal/reg"]])



(go/const "AIC registers\n"
  ^{:line 28} [^{:val 256} SISCR 0x100] ; Software Interrupt Set Command Register
  ^{:line 29} [^{:val 260} SICCR 0x104] ; Software Interrupt Clear Command Register
  ^{:line 30} [^{:val 296} IMR 0x128] ; Interrupt Mask Register
  ^{:line 31} [^{:val 288} ISNR 0x120] ; Interrupt Source Number Register (current IRQ)
  ^{:line 32} [^{:val 304} MECR 0x130] ; Mask Enable  Command Register, IRQ0..31
  ^{:line 33} [^{:val 308} MECRH 0x134] ; Mask Enable  Command Register, IRQ32..63
  ^{:line 34} [^{:val 312} MDCR 0x138] ; Mask Disable Command Register, IRQ0..31
  ^{:line 35} [^{:val 316} MDCRH 0x13c] ; Mask Disable Command Register, IRQ32..63
  ^{:line 36} [^{:val 336} EOSCR 0x150]) ; End-of-Service Command Register



(go/const ^{:val 63 :doc "maxIRQ is the highest valid interrupt source number.\n"} maxIRQ 63)


(go/type AIC "AIC represents an Advanced Interrupt Controller instance.\n" (struct

    ^{:line 45 :tag uint32 :doc "Base register\n"} Base))



^{:go/end 52} (go/method DisableAll "DisableAll masks all 64 interrupt sources.\n" [^{:tag (* AIC)} hw]
  (reg/Write (+ (.-Base hw) MDCR) 0xffffffff)
  (reg/Write (+ (.-Base hw) MDCRH) 0xffffffff))



^{:go/end 65} (go/method EnableInterrupt "EnableInterrupt unmasks interrupt source irq (0..63).\n" [^{:tag (* AIC)} hw ^int irq]
  (when (or (< irq 0) (> irq maxIRQ))
    (return))


  (if (< irq 32)
    (reg/Write (+ (.-Base hw) MECR) ^uint32 (<< 1 (conv uint irq)))

    (reg/Write (+ (.-Base hw) MECRH) ^uint32 (<< 1 (conv uint (- irq 32))))))




^{:go/end 78} (go/method DisableInterrupt "DisableInterrupt masks interrupt source irq (0..63).\n" [^{:tag (* AIC)} hw ^int irq]
  (when (or (< irq 0) (> irq maxIRQ))
    (return))


  (if (< irq 32)
    (reg/Write (+ (.-Base hw) MDCR) ^uint32 (<< 1 (conv uint irq)))

    (reg/Write (+ (.-Base hw) MDCRH) ^uint32 (<< 1 (conv uint (- irq 32))))))





^{:go/end 84} (go/method CurrentInterrupt "CurrentInterrupt returns the interrupt source number currently being\nserviced.\n" ^int [^{:tag (* AIC)} hw]
  (conv int (bit-and (reg/Read (+ (.-Base hw) ISNR)) 0x7f)))



^{:go/end 89} (go/method ClearInterrupt "ClearInterrupt signals end-of-interrupt to the AIC.\n" [^{:tag (* AIC)} hw]
  (reg/Write (+ (.-Base hw) EOSCR) 0x1))





^{:go/end 100} (go/method SoftwareInterrupt "SoftwareInterrupt generates a software interrupt for source irq. The AIC\nSISCR register only covers the first 32 IRQs (0..31), higher sources are not\nsupported.\n" [^{:tag (* AIC)} hw ^int irq]
  (when (or (< irq 0) (> irq 31))
    (return))


  (reg/Write (+ (.-Base hw) SISCR) ^uint32 (<< 1 (conv uint irq))))

;; https://github.com/usbarmory/tamago.
(in-ns 'go.github_com.usbarmory.tamago.soc.microchip.wdt) (go/file "wdt.go" :doc "Package wdt implements a driver for Synopsys DesignWare APB Watchdog Timers\nas integrated in Microchip LAN969x SoCs adopting the following\nspecifications:\n  - Microchip - LAN9694/LAN9696/LAN9698 Datasheet - DS00005048E (02-27-25)\n\nThis package is only meant to be used with `GOOS=tamago GOARCH=arm64` as\nsupported by the TamaGo framework for bare metal Go, see\nhttps://github.com/usbarmory/tamago.\n" :imports [


    ^{:line 20} [sync "sync"]

    ^{:line 22} [reg "github.com/usbarmory/tamago/internal/reg"]])


(go/const
  ^{:line 26} [^{:val 0} WDT_CR 0x00]
  ^{:line 27} [^{:val 1} CR_RMOD 1]
  ^{:line 28} [^{:val 0} CR_WDT_EN 0]

  ^{:line 30} [^{:val 4} WDT_TORR 0x04]
  ^{:line 31} [^{:val 0} TORR_TOP 0]

  ^{:line 33} [^{:val 8} WDT_CCVR 0x08]
  ^{:line 34} [^{:val 12} WDT_CRR 0x0c]

  ^{:line 36} [^{:val 16} WDT_STAT 0x10]
  ^{:line 37} [^{:val 0} STAT_WDT 0]

  ^{:line 39} [^{:val 20} WDT_EOI 0x14]

  ^{:line 41} [^{:val 244} WDT_COMP_PARAM_1 0xf4]
  ^{:line 42} [^{:val 248} WDT_COMP_VERSION 0xf8]
  ^{:line 43} [^{:val 252} WDT_COMP_TYPE 0xfc]

  ^{:line 45} [^{:val 0} TOP_MIN 0]
  ^{:line 46} [^{:val 15} TOP_MAX 15]

  ^{:line 48} [^{:val 118} CRR_KICK 0x76]



  ^{:line 52} [^{:val 250000000 :doc "CLOCK_HZ matches the 250 MHz LAN969x fabric clock.\np501, 3.47.3 CLOCKING AND RESET, Microchip DS00005048E\n"} CLOCK_HZ 250000000])



(go/type WDT "WDT represents a Watchdog Timer instance.\n" (struct
    ^{:line 57} sync/Mutex


    ^{:line 60 :tag uint32 :doc "Base register\n"} Base))




^{:go/end 67} (go/method EnableReset "EnableReset starts the watchdog in direct-reset mode. The timeout range\nrepresents 2^(16+top) watchdog clock cycles.\n" [^{:tag (* WDT)} hw ^int top]
  (.enable hw top false))







^{:go/end 76} (go/method EnableInterrupt "EnableInterrupt starts the watchdog in interrupt-first mode, the timeout\nrange represents 2^(16+top) watchdog clock cycles.\n\nThe first timeout raises an interrupt and the second timeout resets the\nsystem.\n" [^{:tag (* WDT)} hw ^int top]
  (.enable hw top true))


^{:go/end 91} (go/method enable [^{:tag (* WDT)} hw ^int top ^bool interrupt]
  (when (or (< top TOP_MIN) (> top TOP_MAX))
    (panic "invalid watchdog timeout range"))


  ^{:go/via [Mutex]} (.Lock hw)
  (defer ^{:go/via [Mutex]} (.Unlock hw))

  (reg/Write (+ (.-Base hw) WDT_TORR) (conv uint32 top))
  (reg/SetTo (+ (.-Base hw) WDT_CR) CR_RMOD interrupt)
  (reg/Set (+ (.-Base hw) WDT_CR) CR_WDT_EN)

  (.Kick hw))



^{:go/end 96} (go/method Kick "Kick restarts the watchdog counter.\n" [^{:tag (* WDT)} hw]
  (reg/Write (+ (.-Base hw) WDT_CRR) CRR_KICK))



^{:go/end 101} (go/method Enabled "Enabled reports whether the watchdog is running.\n" ^bool [^{:tag (* WDT)} hw]
  (reg/Get (+ (.-Base hw) WDT_CR) CR_WDT_EN))



^{:go/end 106} (go/method Counter "Counter returns the current watchdog counter value.\n" ^uint32 [^{:tag (* WDT)} hw]
  (reg/Read (+ (.-Base hw) WDT_CCVR)))



^{:go/end 111} (go/method Top "Top returns the configured timeout range.\n" ^int [^{:tag (* WDT)} hw]
  (conv int (reg/GetN (+ (.-Base hw) WDT_TORR) TORR_TOP 0xf)))



^{:go/end 116} (go/method InterruptMode "InterruptMode reports whether interrupt-first mode is selected.\n" ^bool [^{:tag (* WDT)} hw]
  (reg/Get (+ (.-Base hw) WDT_CR) CR_RMOD))



^{:go/end 121} (go/method Status "Status reports whether the watchdog interrupt is active.\n" ^bool [^{:tag (* WDT)} hw]
  (reg/Get (+ (.-Base hw) WDT_STAT) STAT_WDT))



^{:go/end 126} (go/method ClearInterrupt "ClearInterrupt clears the watchdog interrupt without restarting the counter.\n" [^{:tag (* WDT)} hw]
  (reg/Read (+ (.-Base hw) WDT_EOI)))



^{:go/end 131} (go/method Version "Version returns the component version register.\n" ^uint32 [^{:tag (* WDT)} hw]
  (reg/Read (+ (.-Base hw) WDT_COMP_VERSION)))



^{:go/end 136} (go/method ComponentType "ComponentType returns the component type register.\n" ^uint32 [^{:tag (* WDT)} hw]
  (reg/Read (+ (.-Base hw) WDT_COMP_TYPE)))



^{:go/end 141} (go/method Parameters "Parameters returns the component parameters register.\n" ^uint32 [^{:tag (* WDT)} hw]
  (reg/Read (+ (.-Base hw) WDT_COMP_PARAM_1)))

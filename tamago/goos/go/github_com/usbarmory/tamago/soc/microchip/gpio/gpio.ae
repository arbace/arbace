;; Package gpio implements helpers for GPIO configuration on Microchip SoCs,
;; compliant GPIO blocks adopting the following reference specifications:
;;   - Microchip - LAN9694/LAN9696/LAN9698 Datasheet - DS00005048E (02-27-25)
;;
;; This package is only meant to be used with `GOOS=tamago GOARCH=arm64` as
;; supported by the TamaGo framework for bare metal Go, see
;; https://github.com/usbarmory/tamago.
(in-ns 'go.github_com.usbarmory.tamago.soc.microchip.gpio) (go/file "gpio.go" :doc "Package gpio implements helpers for GPIO configuration on Microchip SoCs,\ncompliant GPIO blocks adopting the following reference specifications:\n  - Microchip - LAN9694/LAN9696/LAN9698 Datasheet - DS00005048E (02-27-25)\n\nThis package is only meant to be used with `GOOS=tamago GOARCH=arm64` as\nsupported by the TamaGo framework for bare metal Go, see\nhttps://github.com/usbarmory/tamago.\n" :imports [


    ^{:line 19} [errors "errors"]
    ^{:line 20} [fmt "fmt"]

    ^{:line 22} [reg "github.com/usbarmory/tamago/internal/reg"]])



(go/const "GPIO registers\n"
  ^{:line 27} [^{:val 0} GPIO_OUT_SET 0x00]
  ^{:line 28} [^{:val 12} GPIO_OUT_CLR 0x0c]
  ^{:line 29} [^{:val 24} GPIO_OUT 0x18]
  ^{:line 30} [^{:val 36} GPIO_IN 0x24]
  ^{:line 31} [^{:val 48} GPIO_OE 0x30]
  ^{:line 32} [^{:val 96} GPIO_ALT 0x60])


(go/const
  ^{:line 36} [^{:val 32} bankSize 32]
  ^{:line 37} [^{:val 3} banks 3])



(go/type GPIO "GPIO represents a GPIO controller instance.\n" (struct

    ^{:line 43 :tag uint32 :doc "Base register\n"} Base))



(go/type Pin "Pin represents a GPIO line instance.\n" (struct
    ^{:line 48 :tag int} num
    ^{:line 49 :tag int} pos
    ^{:line 50 :tag uint32} set
    ^{:line 51 :tag uint32} clr
    ^{:line 52 :tag uint32} in
    ^{:line 53 :tag uint32} oe
    ^{:line 54 :tag uint32} alt))


^{:go/end 59} (go/func bank ^uint32 [^int num ^uint32 size]
  (* (conv uint32 (/ num bankSize)) size))



^{:go/end 82} (go/method Init "Init initializes a GPIO line instance.\n" [^{:tag (* GPIO)} hw ^int num] :results [^{:tag (* Pin)} pin ^error err]
  (when (== (.-Base hw) 0)
    (return nil (errors/New "invalid GPIO controller instance")))


  (when (or (< num 0) (>= num (* banks bankSize)))
    (return nil (fmt/Errorf "invalid GPIO number %d" num)))


  (set! pin (addr ^{:go/breaks [2 4 6 8 10 12 14]} (lit Pin
        :num num
        :pos (% num bankSize)
        :set (+ (.-Base hw) GPIO_OUT_SET (bank num 4))
        :clr (+ (.-Base hw) GPIO_OUT_CLR (bank num 4))
        :in (+ (.-Base hw) GPIO_IN (bank num 4))
        :oe (+ (.-Base hw) GPIO_OE (bank num 4))
        :alt (+ (.-Base hw) GPIO_ALT (bank num 12)))))


  (return))



^{:go/end 87} (go/method Out "Out configures a GPIO line for output.\n" [^{:tag (* Pin)} pin]
  (reg/Set (.-oe pin) (.-pos pin)))



^{:go/end 92} (go/method In "In configures a GPIO line for input.\n" [^{:tag (* Pin)} pin]
  (reg/Clear (.-oe pin) (.-pos pin)))



^{:go/end 97} (go/method High "High configures a GPIO line to be high.\n" [^{:tag (* Pin)} pin]
  (reg/Set (.-set pin) (.-pos pin)))



^{:go/end 102} (go/method Low "Low configures a GPIO line to be low.\n" [^{:tag (* Pin)} pin]
  (reg/Set (.-clr pin) (.-pos pin)))



^{:go/end 107} (go/method Value "Value returns the GPIO line level.\n" [^{:tag (* Pin)} pin] :results [^bool high]
  (reg/Get (.-in pin) (.-pos pin)))



^{:go/end 121} (go/method Function "Function selects a GPIO line overlaid function.\n" [^{:tag (* Pin)} pin ^int mode] :results [^error err]
  (when (or (< mode 0) (> mode 2r111))
    (return (fmt/Errorf "invalid GPIO function %d" mode)))


  ;; Table 3-426: GPIO overlaid functions
  (reg/SetTo (+ (.-alt pin) (* 0 4)) (.-pos pin) (> (bit-and mode 2r001) 0))
  (reg/SetTo (+ (.-alt pin) (* 1 4)) (.-pos pin) (> (bit-and mode 2r010) 0))
  (reg/SetTo (+ (.-alt pin) (* 2 4)) (.-pos pin) (> (bit-and mode 2r100) 0))

  (return))

;; Package trng implements a driver for the Microchip True Random Number Generator
;; (TRNG) adopting the following specifications:
;;   - Microchip - LAN9694/LAN9696/LAN9698 Datasheet - DS00005048E (02-27-25)
;;
;; This package is only meant to be used with `GOOS=tamago GOARCH=arm64` as
;; supported by the TamaGo framework for bare metal Go, see
;; https://github.com/usbarmory/tamago.
(in-ns 'go.github_com.usbarmory.tamago.soc.microchip.trng) (go/file "trng.go" :doc "Package trng implements a driver for the Microchip True Random Number Generator\n(TRNG) adopting the following specifications:\n  - Microchip - LAN9694/LAN9696/LAN9698 Datasheet - DS00005048E (02-27-25)\n\nThis package is only meant to be used with `GOOS=tamago GOARCH=arm64` as\nsupported by the TamaGo framework for bare metal Go, see\nhttps://github.com/usbarmory/tamago.\n" :imports [


    ^{:line 19} [fmt "fmt"]

    ^{:line 21} [reg "github.com/usbarmory/tamago/internal/reg"]
    ^{:line 22} [rng "github.com/usbarmory/tamago/internal/rng"]])


(go/const ^{:val 5393991} WAKEY 0x524e47) ; "RNG"


(go/const "TRNG registers\n"
  ^{:line 29} [^{:val 0} TRNG_CR 0x00]
  ^{:line 30} [^{:val 8} CR_WAKEY 8]
  ^{:line 31} [^{:val 0} CR_ENABLE 0]

  ^{:line 33} [^{:val 4} TRNG_MR 0x04]
  ^{:line 34} [^{:val 0} MR_HALFR 0]

  ^{:line 36} [^{:val 28} TRNG_ISR 0x1c]
  ^{:line 37} [^{:val 0} ISR_DATRDY 0]

  ^{:line 39} [^{:val 80} TRNG_ODATA 0x50]
  ^{:line 40} [^{:val 232} TRNG_WPSR 0xe8])



(go/type TRNG "TRNG represents the TRNG instance.\n" (struct

    ^{:line 46 :tag uint32 :doc "Base register\n"} Base

    ^{:line 48 :tag int} cycles))



^{:go/end 63} (go/method Init "Init initializes the TRNG module with automatic seeding.\n" [^{:tag (* TRNG)} hw]
  (when (== (.-Base hw) 0)
    (panic "invalid TRNG instance"))


  ;; peripheral clk is 250MHz (> 100MHz)
  (reg/Set (+ (.-Base hw) TRNG_MR) MR_HALFR)
  (set! (.-cycles hw) 168)

  ;; set Write Access Key and enable
  (reg/Write (+ (.-Base hw) TRNG_CR) (bit-or (<< WAKEY CR_WAKEY) 1)))




^{:go/end 93} (go/method GetRandomData "GetRandomData returns len(b) random bytes gathered from the TRNG module,\n[TRNG.Status] is set on error conditions.\n" [^{:tag (* TRNG)} hw ^{:tag (slice byte)} b]
  (let [i 0
      ^{:line 69} read 0
      ^{:line 70} need (len b)]

    (while (< read need)
      (when (> (reg/GetN (+ (.-Base hw) TRNG_ISR) ISR_DATRDY 1) 0)
        (set! read (rng/Fill b read (reg/Read (+ (.-Base hw) TRNG_ODATA))))
        (set! i 0)
        (continue))


      (when [isr (reg/Read (+ (.-Base hw) TRNG_ISR))] (> isr (<< 1 ISR_DATRDY))
        (panic (fmt/Sprintf "trng error, isr:%#x" isr)))


      (when [wpsr (reg/Read (+ (.-Base hw) TRNG_WPSR))] (> wpsr 0)
        (panic (fmt/Sprintf "trng error, wpsr:%#x" wpsr)))


      (inc! i)

      (when (> i (.-cycles hw))
        (panic "trng unresponsive")))))

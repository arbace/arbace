;; Package temp implements a driver for Microchip Temperature sensors adopting
;; the following specifications:
;;   - Microchip - LAN9694/LAN9696/LAN9698 Datasheet - DS00005048E (02-27-25)
;;
;; This package is only meant to be used with `GOOS=tamago GOARCH=arm64` as
;; supported by the TamaGo framework for bare metal Go, see
;; https://github.com/usbarmory/tamago.
(in-ns 'go.github_com.usbarmory.tamago.soc.microchip.temp) (go/file "temp.go" :doc "Package temp implements a driver for Microchip Temperature sensors adopting\nthe following specifications:\n  - Microchip - LAN9694/LAN9696/LAN9698 Datasheet - DS00005048E (02-27-25)\n\nThis package is only meant to be used with `GOOS=tamago GOARCH=arm64` as\nsupported by the TamaGo framework for bare metal Go, see\nhttps://github.com/usbarmory/tamago.\n" :imports [


    ^{:line 19} [sync "sync"]

    ^{:line 21} [reg "github.com/usbarmory/tamago/internal/reg"]])



(go/const "Temperature sensor registers\n"
  ^{:line 26} [^{:val 4} TEMP_SENSOR_CFG 0x04]
  ^{:line 27} [^{:val 15} CFG_CLK_CYCLES_1US 15]
  ^{:line 28} [^{:val 1} CFG_CONTINUOUS_MODE 1]
  ^{:line 29} [^{:val 0} CFG_SAMPLE_ENA 0]

  ^{:line 31} [^{:val 8} TEMP_SENSOR_STAT 0x08]
  ^{:line 32} [^{:val 12} STAT_TEMP_VALID 12]
  ^{:line 33} [^{:val 0} STAT_TEMP 0])




(go/const ^{:val 328 :doc "TEMP_CLK_CYCLES_1US matches the 328.125 MHz system clock.\np501, 3.47.3 CLOCKING AND RESET, Microchip DS00005048E\n"} TEMP_CLK_CYCLES_1US 328)


(go/type SENSOR "SENSOR represents the Temperature sensor instance.\n" (struct
    ^{:line 42} sync/Mutex


    ^{:line 45 :tag uint32 :doc "Base register\n"} Base

    ^{:line 47 :tag bool} run))



^{:go/end 64} (go/method Init "Init initializes and enables continuous temperature sampling.\n" [^{:tag (* SENSOR)} hw]
  ^{:go/via [Mutex]} (.Lock hw)
  (defer ^{:go/via [Mutex]} (.Unlock hw))

  (when (== (.-Base hw) 0)
    (panic "invalid SENSOR instance"))


  (reg/SetN (+ (.-Base hw) TEMP_SENSOR_CFG) CFG_CLK_CYCLES_1US 0x1ff TEMP_CLK_CYCLES_1US)
  (reg/Set (+ (.-Base hw) TEMP_SENSOR_CFG) CFG_CONTINUOUS_MODE)
  (reg/Set (+ (.-Base hw) TEMP_SENSOR_CFG) CFG_SAMPLE_ENA)

  (set! (.-run hw) true))




^{:go/end 83} (go/method Read "Read returns the latest temperature sample in degrees Celsius and whether it\nis valid.\n" [^{:tag (* SENSOR)} hw] :results [^float32 celsius ^bool valid]
  ^{:go/via [Mutex]} (.Lock hw)
  (defer ^{:go/via [Mutex]} (.Unlock hw))

  (when (or (not (.-run hw)) (not (reg/Get (+ (.-Base hw) TEMP_SENSOR_STAT) STAT_TEMP_VALID)))
    (return))


  (let [raw (reg/GetN (+ (.-Base hw) TEMP_SENSOR_STAT) STAT_TEMP 0xfff)]

    ;; p768, 3.47.11.17 Temperature Sensor, Microchip DS00005048E
    (set! celsius (- (* (/ (conv float32 raw) 4096) 352.3) 109.4))
    (set! valid true)

    (return)))

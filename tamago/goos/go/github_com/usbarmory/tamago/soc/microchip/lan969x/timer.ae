(in-ns 'go.github_com.usbarmory.tamago.soc.microchip.lan969x) (go/file "timer.go" :imports [


    ^{:line 12} [_ "unsafe"]])



(go/const ^{:val 3892314112 :doc "SYS_CNT CTRL (p500 TABLE 3-326, DS00005048E)\n"} SYS_CNT_BASE 0xe8000000)

^{:go/end 21} (go/func initTimers []
  ;; Use default frequency, set in bootloaders
  (.InitGenericTimers ARM64 SYS_CNT_BASE 0))



^{:go/end 26} (go/func ^{:go/linkname "nanotime runtime/goos.Nanotime"} nanotime ^int64 []
  (.GetTime ARM64))

(in-ns 'go.github_com.usbarmory.tamago.soc.microchip.devcpu) (go/file "const.go" :imports [])


(go/const "Common fields\n"
  ^{:line 13} [^{:val 2} CFG_MODE 2]
  ^{:line 14} [^{:val 1} CFG_STATUS_WORD_POS 1]
  ^{:line 15} [^{:val 0} CFG_BYTE_SWAP 0]
  ^{:line 16} [^{:val 36} IFH_LEN 36])



(go/const "Frame extraction registers\n"
  ^{:line 21} [^{:val 0} XTR 0x00]
  ^{:line 22} [^{:val 0} XTR_GRP_CFG (+ XTR 0x00)]
  ^{:line 23} [^{:val 8} XTR_RD (+ XTR 0x08)]
  ^{:line 24} [^{:val 16} XTR_FRM_PRUNING (+ XTR 0x10)]
  ^{:line 25} [^{:val 28} XTR_DATA_PRESENT (+ XTR 0x1c)])



(go/const "Special frame error values (little endian)\n"
  ^{:line 30} [^{:val 128} RD_EOF_UNUSED_0 0x00000080]
  ^{:line 31} [^{:val 16777344} RD_EOF_UNUSED_1 0x01000080]
  ^{:line 32} [^{:val 33554560} RD_EOF_UNUSED_2 0x02000080]
  ^{:line 33} [^{:val 50331776} RD_EOF_UNUSED_3 0x03000080]
  ^{:line 34} [^{:val 67108992} RD_EOF_TRUNCATED 0x04000080]
  ^{:line 35} [^{:val 83886208} RD_EOF_ABORTED 0x05000080]
  ^{:line 36} [^{:val 100663424} RD_ESCAPE 0x06000080]
  ^{:line 37} [^{:val 117440640} RD_NOT_READY 0x07000080])



(go/const "Frame injection registers\n"
  ^{:line 42} [^{:val 36} INJ 0x24]
  ^{:line 43} [^{:val 36} INJ_GRP_CFG (+ INJ 0x00)]
  ^{:line 44} [^{:val 44} INJ_WR (+ INJ 0x08)]

  ^{:line 46} [^{:val 52} INJ_CTRL (+ INJ 0x10)]
  ^{:line 47} [^{:val 21} CTRL_GAP_SIZE 21]
  ^{:line 48} [^{:val 20} CTRL_ABORT 20]
  ^{:line 49} [^{:val 19} CTRL_EOF 19]
  ^{:line 50} [^{:val 18} CTRL_SOF 18]
  ^{:line 51} [^{:val 16} CTRL_VLD_BYTES 16]

  ^{:line 53} [^{:val 60} INJ_STATUS (+ INJ 0x18)]
  ^{:line 54} [^{:val 4} INJ_STATUS_WMARK_REACHED 4]
  ^{:line 55} [^{:val 2} INJ_STATUS_FIFO_RDY 2]
  ^{:line 56} [^{:val 0} INJ_STATUS_INJ_IN_PROGRESS 0])

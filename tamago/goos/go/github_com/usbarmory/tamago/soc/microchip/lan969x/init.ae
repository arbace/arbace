(in-ns 'go.github_com.usbarmory.tamago.soc.microchip.lan969x) (go/file "init.go" :imports [


    ^{:line 12} [_ "unsafe"]])



(go/var ^{:tag uint32 :go/linkname "ramStackOffset runtime/goos.RamStackOffset"} ramStackOffset 0x100)



^{:go/end 25} (go/func Init "Init takes care of the lower level initialization triggered early in runtime\nsetup (e.g. runtime/goos.Hwinit1).\n" []
  (.Init ARM64)
  (.EnableCache ARM64)

  (initTimers))

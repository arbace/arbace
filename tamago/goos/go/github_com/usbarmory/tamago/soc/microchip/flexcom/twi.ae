(in-ns 'go.github_com.usbarmory.tamago.soc.microchip.flexcom) (go/file "twi.go" :imports [


    ^{:line 12} [errors "errors"]
    ^{:line 13} [fmt "fmt"]
    ^{:line 14} [runtime "runtime"]
    ^{:line 15} [time "time"]

    ^{:line 17} [bits "github.com/usbarmory/tamago/bits"]
    ^{:line 18} [reg "github.com/usbarmory/tamago/internal/reg"]])



(go/const "TWI registers\n"
  ^{:line 23} [^{:val 1536} FLEX_TWI_OFFSET 0x600]

  ^{:line 25} [^{:val 0} FLEX_TWI_CR 0x00]
  ^{:line 26} [^{:val 0} TWI_CR_START 0]
  ^{:line 27} [^{:val 1} TWI_CR_STOP 1]
  ^{:line 28} [^{:val 2} TWI_CR_MSEN 2]
  ^{:line 29} [^{:val 7} TWI_CR_SWRST 7]

  ^{:line 31} [^{:val 4} FLEX_TWI_MMR 0x04]
  ^{:line 32} [^{:val 8} TWI_MMR_IADRSZ 8]
  ^{:line 33} [^{:val 3} TWI_MMR_IADRSZ_MASK 0x3]
  ^{:line 34} [^{:val 12} TWI_MMR_MREAD 12]
  ^{:line 35} [^{:val 16} TWI_MMR_DADR 16]
  ^{:line 36} [^{:val 127} TWI_MMR_DADR_MASK 0x7f]

  ^{:line 38} [^{:val 12} FLEX_TWI_IADR 0x0c]

  ^{:line 40} [^{:val 16} FLEX_TWI_CWGR 0x10]
  ^{:line 41} [^{:val 0} TWI_CWGR_CLDIV 0]
  ^{:line 42} [^{:val 255} TWI_CWGR_CLDIV_MASK 0xff]
  ^{:line 43} [^{:val 8} TWI_CWGR_CHDIV 8]
  ^{:line 44} [^{:val 255} TWI_CWGR_CHDIV_MASK 0xff]
  ^{:line 45} [^{:val 16} TWI_CWGR_CKDIV 16]
  ^{:line 46} [^{:val 7} TWI_CWGR_CKDIV_MASK 0x7]
  ^{:line 47} [^{:val 20} TWI_CWGR_GCK 20]

  ^{:line 49} [^{:val 32} FLEX_TWI_SR 0x20]
  ^{:line 50} [^{:val 0} TWI_SR_TXCOMP 0]
  ^{:line 51} [^{:val 1} TWI_SR_RXRDY 1]
  ^{:line 52} [^{:val 2} TWI_SR_TXRDY 2]
  ^{:line 53} [^{:val 8} TWI_SR_NACK 8]

  ^{:line 55} [^{:val 48} FLEX_TWI_RHR 0x30]
  ^{:line 56} [^{:val 52} FLEX_TWI_THR 0x34]

  ^{:line 58} [^{:val 3} TWI_IADRSZ_MAX 3])



(go/const ^{:val 100000000 :doc "TWITimeout is the default timeout for TWI operations.\n"} TWITimeout (* 100 time/Millisecond))


(go/type TWI "TWI represents the FLEXCOM TWI mode instance.\n" (struct
    ^{:line 66} FLEXCOM


    ^{:line 69 :tag uint8 :doc "ClockLowDivider configures the TWI low-period divider.\n"} ClockLowDivider


    ^{:line 72 :tag uint8 :doc "ClockHighDivider configures the TWI high-period divider.\n"} ClockHighDivider


    ^{:line 75 :tag uint8 :doc "ClockDivider applies a 2^n scale to both TWI clock periods.\n"} ClockDivider


    ^{:line 78 :tag bool :doc "GenericClock selects GCLK instead of the peripheral clock.\n"} GenericClock


    ^{:line 81 :tag time/Duration :doc "Timeout bounds each wait for TWI controller progress. Zero selects 100 ms.\n"} Timeout

    ^{:line 83 :tag uint32} clock))


^{:go/end 90} (go/method reset [^{:tag (* TWI)} hw]
  (reg/Write (+ ^{:go/via [FLEXCOM]} (.-Base hw) FLEX_TWI_OFFSET FLEX_TWI_CR) (<< 1 TWI_CR_SWRST))
  (reg/Write (+ ^{:go/via [FLEXCOM]} (.-Base hw) FLEX_TWI_OFFSET FLEX_TWI_CWGR) (.-clock hw))
  (reg/Write (+ ^{:go/via [FLEXCOM]} (.-Base hw) FLEX_TWI_OFFSET FLEX_TWI_CR) (<< 1 TWI_CR_MSEN)))


^{:go/end 109} (go/method init [^{:tag (* TWI)} hw] :results [^error err]
  (when (> (.-ClockDivider hw) TWI_CWGR_CKDIV_MASK)
    (return (fmt/Errorf "invalid TWI clock divider %d" (.-ClockDivider hw))))


  (when (<= (.-Timeout hw) 0)
    (set! (.-Timeout hw) TWITimeout))


  (bits/SetN (addr (.-clock hw)) TWI_CWGR_CLDIV TWI_CWGR_CLDIV_MASK (conv uint32 (.-ClockLowDivider hw)))
  (bits/SetN (addr (.-clock hw)) TWI_CWGR_CHDIV TWI_CWGR_CHDIV_MASK (conv uint32 (.-ClockHighDivider hw)))
  (bits/SetN (addr (.-clock hw)) TWI_CWGR_CKDIV TWI_CWGR_CKDIV_MASK (conv uint32 (.-ClockDivider hw)))
  (bits/SetTo (addr (.-clock hw)) TWI_CWGR_GCK (.-GenericClock hw))

  (.reset hw)

  (return))


^{:go/end 132} (go/method configure [^{:tag (* TWI)} hw ^uint8 target ^uint32 addr ^int alen ^bool read] :results [^error err]
  (switch
    (case [(== ^{:go/via [FLEXCOM]} (.-Base hw) 0)]
      (return (errors/New "invalid FLEXCOM controller instance")))
    (case [(> target TWI_MMR_DADR_MASK)]
      (return (fmt/Errorf "invalid device address %#x" target)))
    (case [(or (< alen 0) (> alen TWI_IADRSZ_MAX))]
      (return (fmt/Errorf "invalid internal device address size %d" alen)))
    (case [(and (== alen 0) (!= addr 0))
        (and (> alen 0) (>= addr ^uint32 (<< 1 (conv uint (* alen 8)))))]
      (return (fmt/Errorf "invalid internal device address %#x" addr))))


  (let [^uint32 mode (zero uint32)]
    (bits/SetN (addr mode) TWI_MMR_IADRSZ TWI_MMR_IADRSZ_MASK (conv uint32 alen))
    (bits/SetTo (addr mode) TWI_MMR_MREAD read)
    (bits/SetN (addr mode) TWI_MMR_DADR TWI_MMR_DADR_MASK (conv uint32 target))
    (reg/Write (+ ^{:go/via [FLEXCOM]} (.-Base hw) FLEX_TWI_OFFSET FLEX_TWI_MMR) mode)
    (reg/Write (+ ^{:go/via [FLEXCOM]} (.-Base hw) FLEX_TWI_OFFSET FLEX_TWI_IADR) addr)

    (return)))


^{:go/end 153} (go/method wait [^{:tag (* TWI)} hw ^int bit] :results [^error err]
  (let [start (time/Now)]

    (while true
      (let [status (reg/Read (+ ^{:go/via [FLEXCOM]} (.-Base hw) FLEX_TWI_OFFSET FLEX_TWI_SR))]

        (switch
          (case [(bits/Get (addr status) TWI_SR_NACK)]
            (.reset hw)
            (return (errors/New "target did not acknowledge")))
          (case [(bits/Get (addr status) bit)]
            (return nil))
          (case [(>= (time/Since start) (.-Timeout hw))]
            (.reset hw)
            (return (fmt/Errorf "timeout waiting for status bit %d (%#08x)" bit status))))


        (runtime/Gosched)))))





^{:go/end 168} (go/method Init "Init initializes and enables a FLEXCOM controller in TWI initiator mode,\nthis is mutually exclusive with other modes.\n" [^{:tag (* TWI)} hw] :results [^error err]
  ^{:go/via [FLEXCOM Mutex]} (.Lock hw)
  (defer ^{:go/via [FLEXCOM Mutex]} (.Unlock hw))

  (when (== ^{:go/via [FLEXCOM]} (.-Base hw) 0)
    (return (errors/New "invalid FLEXCOM controller instance")))


  ^{:go/via [FLEXCOM]} (.mode hw MR_OPMODE_TWI)

  (.init hw))











^{:go/end 216} (go/method Read "Read reads a sequence of bytes from a target device.\n\nThe address length (`alen`) parameter should be set greater than 0 for\nordinary I2C reads (`TARGET W|ADDR|TARGET R|DATA`) and equal to 0 when not\nsending a register address (`TARGET R|DATA`), values less than 0 or greater\nthan 3 are not valid.\n\nThe buffer is filled to its full length, on error it may be partially\nfilled.\n" [^{:tag (* TWI)} hw ^uint8 target ^uint32 addr ^int alen ^{:tag (slice byte)} buf] :results [^error err]
  ^{:go/via [FLEXCOM Mutex]} (.Lock hw)
  (defer ^{:go/via [FLEXCOM Mutex]} (.Unlock hw))

  (when (== (len buf) 0)
    (return))


  (when [(set! err (.configure hw target addr alen true))] (!= err nil)
    (return))


  (reg/Read (+ ^{:go/via [FLEXCOM]} (.-Base hw) FLEX_TWI_OFFSET FLEX_TWI_SR))

  (range [i buf]
    (let [^uint32 cr (zero uint32)]

      (when (== i 0)
        (bits/Set (addr cr) TWI_CR_START))


      (when (== i (- (len buf) 1))
        (bits/Set (addr cr) TWI_CR_STOP))


      (when (!= cr 0)
        (reg/Write (+ ^{:go/via [FLEXCOM]} (.-Base hw) FLEX_TWI_OFFSET FLEX_TWI_CR) cr))


      (when [(set! err (.wait hw TWI_SR_RXRDY))] (!= err nil)
        (return))


      (aset buf i (conv byte (reg/Read (+ ^{:go/via [FLEXCOM]} (.-Base hw) FLEX_TWI_OFFSET FLEX_TWI_RHR))))))


  (.wait hw TWI_SR_TXCOMP))








^{:go/end 251} (go/method Write "Write writes a sequence of bytes to a target device.\n\nThe address length (`alen`) parameter should be set greater than 0 for\nordinary I2C writes (`TARGET W|ADDR|DATA`) and equal to 0 when not sending\na register address (`TARGET W|DATA`), values less than 0 or greater than 3\nare not valid.\n" [^{:tag (* TWI)} hw ^uint8 target ^uint32 addr ^int alen ^{:tag (slice byte)} buf] :results [^error err]
  ^{:go/via [FLEXCOM Mutex]} (.Lock hw)
  (defer ^{:go/via [FLEXCOM Mutex]} (.Unlock hw))

  (when (== (len buf) 0)
    (return))


  (when [(set! err (.configure hw target addr alen false))] (!= err nil)
    (return))


  (reg/Read (+ ^{:go/via [FLEXCOM]} (.-Base hw) FLEX_TWI_OFFSET FLEX_TWI_SR))

  (range [i buf]
    (reg/Write (+ ^{:go/via [FLEXCOM]} (.-Base hw) FLEX_TWI_OFFSET FLEX_TWI_THR) (conv uint32 (aget buf i)))

    (when (== i (- (len buf) 1))
      (reg/Write (+ ^{:go/via [FLEXCOM]} (.-Base hw) FLEX_TWI_OFFSET FLEX_TWI_CR) (<< 1 TWI_CR_STOP)))


    (when [(set! err (.wait hw TWI_SR_TXRDY))] (!= err nil)
      (return)))



  (.wait hw TWI_SR_TXCOMP))

;; Package lan969x provides support to Go bare metal unikernels, written using
;; the TamaGo framework, on the Microchip LAN969x family of System-on-Chip
;; (SoC) application processors.
;;
;; The package implements initialization and drivers for Microchip LAN969x SoCs,
;; adopting the following reference specifications:
;;   - Microchip - LAN9694/LAN9696/LAN9698 Datasheet - DS00005048E (02-27-25)
;;
;; This package is only meant to be used with `GOOS=tamago GOARCH=arm64` as
;; supported by the TamaGo framework for bare metal Go, see
;; https://github.com/usbarmory/tamago.
(in-ns 'go.github_com.usbarmory.tamago.soc.microchip.lan969x) (go/file "lan969x.go" :doc "Package lan969x provides support to Go bare metal unikernels, written using\nthe TamaGo framework, on the Microchip LAN969x family of System-on-Chip\n(SoC) application processors.\n\nThe package implements initialization and drivers for Microchip LAN969x SoCs,\nadopting the following reference specifications:\n  - Microchip - LAN9694/LAN9696/LAN9698 Datasheet - DS00005048E (02-27-25)\n\nThis package is only meant to be used with `GOOS=tamago GOARCH=arm64` as\nsupported by the TamaGo framework for bare metal Go, see\nhttps://github.com/usbarmory/tamago.\n" :imports [


    ^{:line 23} [gic "github.com/usbarmory/tamago/arm/gic"]
    ^{:line 24} [arm64 "github.com/usbarmory/tamago/arm64"]

    ^{:line 26} [analyzer "github.com/usbarmory/tamago/soc/microchip/analyzer"]
    ^{:line 27} [fan "github.com/usbarmory/tamago/soc/microchip/fan"]
    ^{:line 28} [flexcom "github.com/usbarmory/tamago/soc/microchip/flexcom"]
    ^{:line 29} [gpio "github.com/usbarmory/tamago/soc/microchip/gpio"]
    ^{:line 30} [miim "github.com/usbarmory/tamago/soc/microchip/miim"]
    ^{:line 31} [otpc "github.com/usbarmory/tamago/soc/microchip/otpc"]
    ^{:line 32} [sgpio "github.com/usbarmory/tamago/soc/microchip/sgpio"]
    ^{:line 33} [temp "github.com/usbarmory/tamago/soc/microchip/temp"]
    ^{:line 34} [trng "github.com/usbarmory/tamago/soc/microchip/trng"]
    ^{:line 35} [wdt "github.com/usbarmory/tamago/soc/microchip/wdt"]])



(go/const ^{:val 30 :doc "Ports defines the number of available Ethernet ports\n"} Ports 30)


(go/const "Interrupts\n"

  ^{:line 44} [^{:val 42 :doc "CPU Device Queue System\n"} XTR_READY_IRQ 42]
  ^{:line 45} [^{:val 43} INJ_READY_IRQ 43]


  ^{:line 48} [^{:val 78 :doc "Serial ports\n"} FLEXCOM0_IRQ 78]
  ^{:line 49} [^{:val 79} FLEXCOM1_IRQ 79]
  ^{:line 50} [^{:val 80} FLEXCOM2_IRQ 80]
  ^{:line 51} [^{:val 81} FLEXCOM3_IRQ 81])



(go/const "Peripheral registers\n"

  ^{:line 57} [^{:val 3795845120 :doc "Analyzer\n"} ANA_CL_BASE 0xe2400000] ; classifier
  ^{:line 58} [^{:val 3796369408} ANA_L3_BASE 0xe2480000] ; layer 3 handling and routing
  ^{:line 59} [^{:val 3800039424} ANA_L2_BASE 0xe2800000] ; layer 2 forwarding and learning
  ^{:line 60} [^{:val 3801088000} ANA_AC_BASE 0xe2900000] ; access control


  ^{:line 63} [^{:val 3810525184 :doc "Assembler\n"} ASM_BASE 0xe3200000]


  ^{:line 66} [^{:val 3758882816 :doc "CPU system registers\n"} CPU_BASE 0xe00c0000]


  ^{:line 69} [^{:val 1610612736 :doc "DDR base address\n"} DDR_BASE 0x60000000]


  ^{:line 72} [^{:val 3791847424 :doc "CPU Device Queue System\n"} DEVCPU_QS 0xe2030000]


  ^{:line 75} [^{:val 3809361920 :doc "RGMII interfaces\n"} DEVRGMII0 0xe30e4000] ; port 28
  ^{:line 76} [^{:val 3809378304} DEVRGMII1 0xe30e8000] ; port 29


  ^{:line 79} [^{:val 3809394688 :doc "Disassembler\n"} DSM_BASE 0xe30ec000]


  ^{:line 82} [^{:val 3794534400 :doc "Egress Access Control Lists\n"} EACL_BASE 0xe22c0000]


  ^{:line 85} [^{:val 3758358528 :doc "Serial ports\n"} FLEXCOM0_BASE 0xe0040000]
  ^{:line 86} [^{:val 3758374912} FLEXCOM1_BASE 0xe0044000]
  ^{:line 87} [^{:val 3758489600} FLEXCOM2_BASE 0xe0060000]
  ^{:line 88} [^{:val 3758505984} FLEXCOM3_BASE 0xe0064000]


  ^{:line 91} [^{:val 3791716352 :doc "General Configuration Block\n"} GCB_BASE 0xe2010000]


  ^{:line 94} [^{:val 3791717192 :doc "Fan controller\n"} FAN_BASE (+ GCB_BASE 0x348)]


  ^{:line 97} [^{:val 3904962560 :doc "General Interrupt Controller\n"} GIC_BASE 0xe8c10000]


  ^{:line 100} [^{:val 3791716564 :doc "General Purpose I/O Control\n"} GPIO_BASE 0xe20100d4]


  ^{:line 103} [^{:val 3797417984 :doc "Hierarchical Scheduler Configuration\n"} HSCH_BASE 0xe2580000]


  ^{:line 106} [^{:val 3812655104 :doc "High-speed I/O\n"} HSIO_BASE 0xe3408000]


  ^{:line 109} [^{:val 3792044032 :doc "Learn block\n"} LRN_BASE 0xe2060000]


  ^{:line 112} [^{:val 3791716776 :doc "PHY Management Controller\n"} MIIM0_BASE 0xe20101a8]
  ^{:line 113} [^{:val 3791716812} MIIM1_BASE 0xe20101cc]


  ^{:line 116} [^{:val 3758231552 :doc "One Time Programmable Controller\n"} OTPC_BASE 0xe0021000]


  ^{:line 119} [^{:val 3791912960 :doc "DEVCPU Precision Timing Protocol Originator\n"} PTP_BASE 0xe2040000]


  ^{:line 122} [^{:val 3792371712 :doc "Queue Forwarding\n"} QFWD_BASE 0xe20b0000]


  ^{:line 125} [^{:val 3792306176 :doc "Queue System Configuration\n"} QSYS_BASE 0xe20a0000]


  ^{:line 128} [^{:val 3797942272 :doc "Rewriter\n"} REW_BASE 0xe2600000]


  ^{:line 131} [^{:val 3791716912 :doc "Serial GPIO controller\n"} SGPIO_BASE (+ GCB_BASE 0x230)]


  ^{:line 134} [^{:val 3791782144 :doc "Temperature sensor control\n"} TEMP_SENSOR_BASE 0xe2020100]


  ^{:line 137} [^{:val 3758391296 :doc "True Random Number Generator\n"} TRNG_BASE 0xe0048000]


  ^{:line 140} [^{:val 3792175104 :doc "Versatile Content Aware Processor\n"} VCAP_SUPER_BASE 0xe2080000]


  ^{:line 143} [^{:val 3802136576 :doc "Versatile OAM MEP Processor (VOP) block\n"} VOP_BASE 0xe2a00000]


  ^{:line 146} [^{:val 3758686208 :doc "Watchdog Timer\n"} WDT_BASE 0xe0090000])



(go/var "Peripheral instances\n"

  ^{:line 152} [^{:doc "Analyzer\n"} ANA (addr ^{:go/breaks [2 4]} (lit analyzer/ANA
        :AccessControl ANA_AC_BASE
        :Learn LRN_BASE))]



  ^{:line 158} [^{:doc "ARM64 core\n"} ARM64 (addr ^{:go/breaks [[2 160]]} (lit arm64/CPU
        ;; required before Init()
        :TimerOffset 1))]



  ^{:line 164} [^{:doc "Fan controller\n"} FAN (addr ^{:go/breaks [2]} (lit fan/FAN
        :Base FAN_BASE))]



  ^{:line 169} [^{:doc "Serial port 1\n"} FLEXCOM0 (addr ^{:go/breaks [2 4 6]} (lit flexcom/FLEXCOM
        :Index 1
        :Base FLEXCOM0_BASE
        :IRQ FLEXCOM0_IRQ))]



  ^{:line 176} [^{:doc "Serial port 2\n"} FLEXCOM1 (addr ^{:go/breaks [2 4 6]} (lit flexcom/FLEXCOM
        :Index 2
        :Base FLEXCOM1_BASE
        :IRQ FLEXCOM1_IRQ))]



  ^{:line 183} [^{:doc "Serial port 3\n"} FLEXCOM2 (addr ^{:go/breaks [2 4 6]} (lit flexcom/FLEXCOM
        :Index 3
        :Base FLEXCOM2_BASE
        :IRQ FLEXCOM2_IRQ))]



  ^{:line 190} [^{:doc "Serial port 4\n"} FLEXCOM3 (addr ^{:go/breaks [2 4 6]} (lit flexcom/FLEXCOM
        :Index 4
        :Base FLEXCOM3_BASE
        :IRQ FLEXCOM3_IRQ))]



  ^{:line 197} [^{:doc "Generic Interrupt Controller\n"} GIC (addr ^{:go/breaks [2]} (lit gic/GIC
        :Base GIC_BASE))]



  ^{:line 202} [^{:doc "GPIO controller 1\n"} GPIO (addr ^{:go/breaks [2]} (lit gpio/GPIO
        :Base GPIO_BASE))]



  ^{:line 207} [^{:doc "PHY Management Controller 1\n"} MIIM0 (addr ^{:go/breaks [2]} (lit miim/MIIM
        :Base MIIM0_BASE))]



  ^{:line 212} [^{:doc "PHY Management Controller 2\n"} MIIM1 (addr ^{:go/breaks [2]} (lit miim/MIIM
        :Base MIIM1_BASE))]



  ^{:line 217} [^{:doc "One Time Programmable Controller\n"} OTPC (addr ^{:go/breaks [2 4]} (lit otpc/OTPC
        :Base OTPC_BASE
        :Size (* 16 1024)))]



  ^{:line 223} [^{:doc "Serial GPIO controller\n"} SGPIO (addr ^{:go/breaks [2]} (lit sgpio/SGPIO
        :Base SGPIO_BASE))]



  ^{:line 228} [^{:doc "Temperature sensor\n"} TEMP (addr ^{:go/breaks [2]} (lit temp/SENSOR
        :Base TEMP_SENSOR_BASE))]



  ^{:line 233} [^{:doc "True Random Number Generator\n"} TRNG (addr ^{:go/breaks [2]} (lit trng/TRNG
        :Base TRNG_BASE))]



  ^{:line 238} [^{:doc "Watchdog Timer\n"} WDT (addr ^{:go/breaks [2]} (lit wdt/WDT
        :Base WDT_BASE))])

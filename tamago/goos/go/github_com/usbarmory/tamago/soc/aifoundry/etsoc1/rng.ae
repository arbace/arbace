(in-ns 'go.github_com.usbarmory.tamago.soc.aifoundry.etsoc1) (go/file "rng.go" :imports [


    ^{:line 12} [binary "encoding/binary"]
    ^{:line 13} [time "time"]
    ^{:line 14} [_ "unsafe"]

    ^{:line 16} [rng "github.com/usbarmory/tamago/internal/rng"]])



^{:go/end 24} (go/func ^{:go/linkname "initRNG runtime/goos.InitRNG"} initRNG []
  (let [drbg (addr (lit rng/DRBG))]
    (.PutUint64 binary/LittleEndian (subslice (.-Seed drbg)) (conv uint64 (.UnixNano (time/Now))))
    (set! rng/GetRandomDataFn (.-GetRandomData drbg))))









^{:go/end 35} (go/func SetRNG "SetRNG allows to override the internal random number generator function used\nby TamaGo on the ET-SoC-1 processor.\n\nAt runtime initialization the etsoc1 package seeds a DRBG with the CPU\ntimer, as the ET-SoC-1 lacks an entropy source. This is unsuitable for\nsecure random number generation and must therefore be overridden to ensure\nsecure operation of Go crypto.\n" [^{:tag (func [(slice byte)])} getRandomData]
  (set! rng/GetRandomDataFn getRandomData))

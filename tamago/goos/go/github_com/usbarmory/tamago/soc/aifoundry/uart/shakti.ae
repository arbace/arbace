(in-ns 'go.github_com.usbarmory.tamago.soc.aifoundry.uart) (go/file "shakti.go" :imports [


    ^{:line 12} [runtime "runtime"]

    ^{:line 14} [reg "github.com/usbarmory/tamago/internal/reg"]])



(go/const "Shakti UART registers\n"
  ^{:line 19} [^{:val 6} CONFIG_UART_ENABLE 6]

  ^{:line 21} [^{:val 0} UART_BAUD 0x00]
  ^{:line 22} [^{:val 8} UART_TX 0x08]
  ^{:line 23} [^{:val 16} UART_RX 0x10]

  ^{:line 25} [^{:val 24} UART_STATUS 0x18]
  ^{:line 26} [^{:val 2} STATUS_RX_READY 2]
  ^{:line 27} [^{:val 1} STATUS_TX_FULL 1]
  ^{:line 28} [^{:val 0} STATUS_TX_EMPTY 0])



(go/type Shakti "Shakti represents a Shakti serial port instance.\n" (struct

    ^{:line 34 :tag int :doc "Controller index\n"} Index

    ^{:line 36 :tag uint32 :doc "Base register\n"} Base

    ^{:line 38 :tag uint32 :doc "System config register\n"} System


    ^{:line 41 :tag uint32 :doc "control registers\n"} txdata
    ^{:line 42 :tag uint32} rxdata
    ^{:line 43 :tag uint32} status))



^{:go/end 59} (go/method Init "Init initializes a serial port instance.\n" [^{:tag (* Shakti)} hw]
  (when (== (.-Base hw) 0)
    (panic "invalid UART controller instance"))


  (set! (.-txdata hw) (+ (.-Base hw) UART_TX))
  (set! (.-rxdata hw) (+ (.-Base hw) UART_RX))
  (set! (.-status hw) (+ (.-Base hw) UART_STATUS))

  (when (!= (.-System hw) 0)
    (reg/Set (.-System hw) CONFIG_UART_ENABLE)))




^{:go/end 68} (go/method Tx "Tx transmits a single character to the serial port.\n" [^{:tag (* Shakti)} hw ^byte c]
  (while (reg/Get (.-status hw) STATUS_TX_FULL))
  ;; wait for TX FIFO to have room for a character


  (reg/Write (.-txdata hw) (conv uint32 c)))



^{:go/end 77} (go/method Rx "Rx receives a single character from the serial port.\n" [^{:tag (* Shakti)} hw] :results [^byte c ^bool valid]
  (when (not (reg/Get (.-status hw) STATUS_RX_READY))
    (return))


  (return (conv byte (reg/Read (.-rxdata hw))) true))



^{:go/end 86} (go/method Write "Write data from buffer to serial port.\n" [^{:tag (* Shakti)} hw ^{:tag (slice byte)} buf] :results [^int n ^error _]
  (range [_ c buf]
    (.Tx hw c))


  (return (len buf) nil))



^{:go/end 107} (go/method Read "Read available data to buffer from serial port.\n" [^{:tag (* Shakti)} hw ^{:tag (slice byte)} buf] :results [^int n ^error _]
  (let [^bool valid (zero bool)]

    (while (< n (len buf))
      (set! (values (aget buf n) valid) (.Rx hw))

      (when (not valid)
        (when (== n 0)
          (runtime/Gosched))


        (break))


      (inc! n))


    (return)))

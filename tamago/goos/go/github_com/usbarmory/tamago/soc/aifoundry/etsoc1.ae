(ns go.github_com.usbarmory.tamago.soc.aifoundry.etsoc1
  (:require [arbace.go :as go]))

(go/package etsoc1
  :path "github.com/usbarmory/tamago/soc/aifoundry/etsoc1"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["etsoc1.go" "irq.go" "rng.go"]
  :init-order [UART0 UART1]
  :positions :lines)

(load "etsoc1/etsoc1")
(load "etsoc1/irq")
(load "etsoc1/rng")

    ^{:line 213 :tag uint16} size))




^{:go/end 238} (go/method Bytes "Bytes converts the descriptor structure to byte array format, the device\narea and driver area location offsets are also returned.\n" [^{:tag (* VirtualQueue)} d] :results [(slice byte) int int]
  (let [buf (new bytes/Buffer)]

    (range [_ desc (.-Descriptors d)]
      (.Write buf (.Bytes desc)))


    (let [driver (.Len buf)]
      (.Write buf (.Bytes (.-Available d)))

      ;; Used ring requires 4 bytes alignment but we apply legacy values to
      ;; support both *PCI and *LegacyPCI.
      (when [r (% (.Len buf) pageSize)] (!= r 0)
        (.Write buf (make (slice byte) (- pageSize r))))


      (let [device (.Len buf)]
        (.Write buf (.Bytes (.-Used d)))

        (return (.Bytes buf) driver device)))))



^{:go/end 280} (go/method Init "Init initializes a split virtual queue for the given size.\n" [^{:tag (* VirtualQueue)} d ^int size ^int length ^uint16 flags]
  ^{:go/via [Mutex]} (.Lock d)
  (defer ^{:go/via [Mutex]} (.Unlock d))

  ;; To avoid excessive DMA region fragmentation a single allocation
  ;; reserves all descriptor buffers.
  (let [(values _ buf) (dma/Reserve (* size length) 0)]

    (range [i size]
      (let [off (* length i)

          ^{:line 252} desc (addr (lit Descriptor))]
        (.Init desc (subslice buf off (+ off length)) flags)

        (let [ring (addr (lit Ring))]

          (set! (.-Descriptors d) (append (.-Descriptors d) desc))
          (set! (.-ring (.-Available d)) (append (.-ring (.-Available d)) (conv uint16 i)))
          (set! (.-ring (.-Used d)) (append (.-ring (.-Used d)) ring)))))


    (when (== flags Write)
      ;; make all buffers immediately available
      (set! (.-index (.-Available d)) (conv uint16 size)))


    ;; allocate DMA buffer
    (let [(values ^:assign buf driver device) (.Bytes d)]
      (set! (values (.-desc d) (.-buf d)) (dma/Reserve (len buf) pageSize))
      (copy (.-buf d) buf)

      ;; calculate area pointers
      (set! (.-driver d) (+ (.-desc d) (conv uint driver)))
      (set! (.-device d) (+ (.-desc d) (conv uint device)))
      (set! (.-size d) (conv uint16 size))

      ;; assign DMA slices
      (set! (.-buf (.-Available d)) (subslice (.-buf d) driver device))
      (set! (.-buf (.-Used d)) (subslice (.-buf d) device)))))




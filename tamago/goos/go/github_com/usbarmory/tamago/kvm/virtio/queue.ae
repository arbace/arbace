^{:go/end 329} (go/method Pop "Pop receives a single used buffer from the virtual queue,\n" [^{:tag (* VirtualQueue)} d ^{:tag (slice byte)} buf] :results [^int n ^error err]
  ^{:go/via [Mutex]} (.Lock d)
  (defer ^{:go/via [Mutex]} (.Unlock d))

  (when (== (.Index (.-Used d)) (.-last (.-Used d)))
    (return))


  (let [avail (.Ring (.-Used d) (% (.-last (.-Used d)) (.-size d)))]
    (set! n (conv int (.-Length avail)))

    (when (< (len buf) n)
      (return 0 (fmt/Errorf "buffer too small (%d < %d)" (len buf) n)))


    (.Read (aget (.-Descriptors d) (.-Index avail)) buf)

    (.SetRingIndex (.-Available d) (% (.-index (.-Available d)) (.-size d)) (conv uint16 (.-Index avail)))
    (.SetIndex (.-Available d) (+ (.-index (.-Available d)) 1))

    (set! (.-last (.-Used d)) + 1)

    (return)))




(go/type VirtualQueue "VirtualQueue represents a VirtIO split virtual queue Descriptor\n" (struct
    ^{:line 201} sync/Mutex

    ^{:line 203 :tag (slice (* Descriptor))} Descriptors
    ^{:line 204 :tag Available} Available
    ^{:line 205 :tag Used} Used


    ^{:line 208 :tag (slice byte) :doc "DMA buffer\n"} buf
    ^{:line 209 :tag uint} desc ; physical address for QueueDesc
    ^{:line 210 :tag uint} driver ; phusical address for QueueDriver

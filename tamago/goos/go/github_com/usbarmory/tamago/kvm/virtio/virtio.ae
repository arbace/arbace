;; Package virtio implements a driver for Virtual I/O devices (VirtIO)
;; following reference specifications:
;;   - Virtual I/O Device (VIRTIO) - Version 1.2
;;
;; This package is only meant to be used with `GOOS=tamago` as
;; supported by the TamaGo framework for bare metal Go, see
;; https://github.com/usbarmory/tamago.
(in-ns 'go.github_com.usbarmory.tamago.kvm.virtio) (go/file "virtio.go" :doc "Package virtio implements a driver for Virtual I/O devices (VirtIO)\nfollowing reference specifications:\n  - Virtual I/O Device (VIRTIO) - Version 1.2\n\nThis package is only meant to be used with `GOOS=tamago` as\nsupported by the TamaGo framework for bare metal Go, see\nhttps://github.com/usbarmory/tamago.\n" :imports [


    ^{:line 19} [bits "github.com/usbarmory/tamago/bits"]])



(go/const "Reserved Feature bits\n"
  ^{:line 24} [^{:val 34} Packed 34]
  ^{:line 25} [^{:val 38} NotificationData 38])



(go/const "Device Status bits\n"
  ^{:line 30} [^{:val 0} Acknowledge 0]
  ^{:line 31} [^{:val 1} Driver 1]
  ^{:line 32} [^{:val 2} DriverOk 2]
  ^{:line 33} [^{:val 3} FeaturesOk 3]
  ^{:line 34} [^{:val 6} DeviceNeedsReset 6]
  ^{:line 35} [^{:val 7} Failed 7])


(go/const
  ^{:line 39} [^{:val 1953655158} MAGIC 0x74726976] ; "virt"
  ^{:line 40} [^{:val 2} VERSION 0x02]


  ^{:line 43} [^{:val 18445618173819486207N :doc "bits 0 to 23, and 50 to 63\n"} deviceSpecificFeatureMask 0xfffc000000ffffff]

  ^{:line 45} [^{:val 1125899890065408 :doc "bits 24 to 49\n"} deviceReservedFeatureMask 0x0003ffffff000000])



(go/type VirtIO "VirtIO represents a VirtIO device.\n" (interface

    (^{:doc "Init initializes a VirtIO device instance.\n"} Init ^error [^uint64 features])

    (^{:doc "Config returns the device configuration layout.\n"} Config ^{:tag (slice byte)} [^int size])

    (^{:doc "DeviceID returns the VirtIO subsystem device ID\n"} DeviceID ^uint32 [])

    (^{:doc "DeviceFeatures returns the device feature bits.\n"} DeviceFeatures [] :results [^uint64 features])

    (^{:doc "DriverFeatures returns the driver feature bits.\n"} DriverFeatures [] :results [^uint64 features])

    (^{:doc "SetDriverFeatures sets the driver feature bits.\n"} SetDriverFeatures [^uint64 features])

    (^{:doc "NegotiatedFeatures returns the set of negotiated feature bits.\n"} NegotiatedFeatures [] :results [^uint64 features])

    (^{:doc "QueueReady returns whether a queue is ready for use.\n"} QueueReady [^int index] :results [^bool ready])

    (^{:doc "MaxQueueSize returns the maximum virtual queue size.\n"} MaxQueueSize ^int [^int index])

    (^{:doc "SetQueueSize sets the virtual queue size.\n"} SetQueueSize [^int index ^int n])

    (^{:doc "Status returns the device status.\n"} Status ^uint32 [])

    (^{:doc "SetQueue registers the indexed virtual queue for device access.\n"} SetQueue [^int index ^{:tag (* VirtualQueue)} queue])

    (^{:doc "SetReady indicates that the driver is set up and ready to drive the device.\n"} SetReady [])

    (^{:doc "QueueNotify notifies the device that a queue can be processed.\n"} QueueNotify [^int index])

    (^{:doc "ConfigVersion returns the device configuration (see Config field) version.\n"} ConfigVersion ^uint32 [])


    (^{:doc "EnableInterrupt enables interrupt vector routing to a LAPIC instance\nfor the indexed virtual queue.\n"} EnableInterrupt ^error [^int id ^int index])))


^{:go/end 99} (go/func negotiate [^uint64 deviceFeatures ^uint64 driverFeatures] :results [^uint64 features]
  (set! features deviceFeatures)

  ;; clear unsupported features
  (bits/Clear64 (addr features) Packed)
  (bits/Clear64 (addr features) NotificationData)

  ;; keep all remaining reserved features, clear device type ones
  (set! features bit-and deviceReservedFeatureMask)

  ;; apply device type features from the driver
  (set! features bit-and driverFeatures)

  (return))

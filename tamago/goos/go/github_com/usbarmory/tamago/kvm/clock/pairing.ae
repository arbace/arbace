;; Package kvmclock implements a driver for the KVM specific paravirtualized
;; clocksources following the KVM_HC_CLOCK_PAIRING hypercall as described at:
;;
;;	https://docs.kernel.org/virt/kvm/x86/hypercalls.html
;;
;; This package is only meant to be used with `GOOS=tamago` as
;; supported by the TamaGo framework for bare metal Go, see
;; https://github.com/usbarmory/tamago.
(in-ns 'go.github_com.usbarmory.tamago.kvm.clock) (go/file "pairing.go" :doc "Package kvmclock implements a driver for the KVM specific paravirtualized\nclocksources following the KVM_HC_CLOCK_PAIRING hypercall as described at:\n\n\thttps://docs.kernel.org/virt/kvm/x86/hypercalls.html\n\nThis package is only meant to be used with `GOOS=tamago` as\nsupported by the TamaGo framework for bare metal Go, see\nhttps://github.com/usbarmory/tamago.\n" :imports [


    ^{:line 20} [time "time"]])



(go/func ^:extern Pairing "Pairing() returns the KVM host clock information.\n" [] :results [^int64 sec ^int64 nsec ^uint64 tsc])


^{:go/end 30} (go/func Now "Now() returns the time corresponding to the KVM host clock.\n" [] :results [^time/Time t]
  (let [(values sec nsec _) (Pairing)]
    (time/Unix sec nsec)))

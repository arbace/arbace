(in-ns 'go.github_com.usbarmory.tamago.kvm.sev) (go/file "vmsa.go" :imports [


    ^{:line 12} [bytes "bytes"]
    ^{:line 13} [binary "encoding/binary"]])




(go/type Segment "Segment represents a segment descriptor\n(AMD64 Architecture Programmer’s Manual, Volume 2 - Table B-2).\n" (struct
    ^{:line 19 :tag uint16} Selector
    ^{:line 20 :tag uint16} Attrib
    ^{:line 21 :tag uint32} Limit
    ^{:line 22 :tag uint64} Base))




(go/type VMSA "VMSA represents an AMD SEV-SNP Virtual Machine Save Area page\n(AMD64 Architecture Programmer’s Manual, Volume 2 - Table B-4).\n" (struct
    ^{:line 28 :tag Segment} ES
    ^{:line 29 :tag Segment} CS
    ^{:line 30 :tag Segment} SS
    ^{:line 31 :tag Segment} DS
    ^{:line 32 :tag Segment} FS
    ^{:line 33 :tag Segment} GS
    ^{:line 34 :tag Segment} GDTR
    ^{:line 35 :tag Segment} LDTR
    ^{:line 36 :tag Segment} IDTR
    ^{:line 37 :tag Segment} TR

    ^{:line 39 :tag uint64} PL0SSP
    ^{:line 40 :tag uint64} PL1SSP
    ^{:line 41 :tag uint64} PL2SSP
    ^{:line 42 :tag uint64} PL3SSP
    ^{:line 43 :tag uint64} U_CET
    ^{:line 44 :tag (array 2 byte)} _

    ^{:line 46 :tag uint8} VMPL
    ^{:line 47 :tag uint8} CPL
    ^{:line 48 :tag (array 4 byte)} _

    ^{:line 50 :tag uint64} EFER
    ^{:line 51 :tag (array 104 byte)} _

    ^{:line 53 :tag uint64} XSS
    ^{:line 54 :tag uint64} CR4
    ^{:line 55 :tag uint64} CR3
    ^{:line 56 :tag uint64} CR0
    ^{:line 57 :tag uint64} DR7
    ^{:line 58 :tag uint64} DR6
    ^{:line 59 :tag uint64} RFLAGS
    ^{:line 60 :tag uint64} RIP
    ^{:line 61 :tag uint64} DR0
    ^{:line 62 :tag uint64} DR1
    ^{:line 63 :tag uint64} DR2
    ^{:line 64 :tag uint64} DR3
    ^{:line 65 :tag uint64} DR0AddrMask
    ^{:line 66 :tag uint64} DR1AddrMask
    ^{:line 67 :tag uint64} DR2AddrMask
    ^{:line 68 :tag uint64} DR3AddrMask
    ^{:line 69 :tag (array 24 byte)} _

    ^{:line 71 :tag uint64} RSP
    ^{:line 72 :tag uint64} S_CET
    ^{:line 73 :tag uint64} SSP
    ^{:line 74 :tag uint64} ISST_ADDR
    ^{:line 75 :tag uint64} RAX
    ^{:line 76 :tag uint64} STAR
    ^{:line 77 :tag uint64} LSTAR
    ^{:line 78 :tag uint64} CSTAR
    ^{:line 79 :tag uint64} SFMASK
    ^{:line 80 :tag uint64} KernelGsBase
    ^{:line 81 :tag uint64} SYSENTER_CS
    ^{:line 82 :tag uint64} SYSENTER_ESP
    ^{:line 83 :tag uint64} SYSENTER_EIP
    ^{:line 84 :tag uint64} CR2
    ^{:line 85 :tag (array 32 byte)} _

    ^{:line 87 :tag uint64} G_PAT
    ^{:line 88 :tag uint64} DBGCTL
    ^{:line 89 :tag uint64} BR_FROM
    ^{:line 90 :tag uint64} BR_TO
    ^{:line 91 :tag uint64} LASTEXCPFROM
    ^{:line 92 :tag uint64} LASTEXCPTO
    ^{:line 93 :tag (array 80 byte)} _

    ^{:line 95 :tag uint32} PKRU
    ^{:line 96 :tag uint32} TSC_AUX
    ^{:line 97 :tag (array 24 byte)} _

    ^{:line 99 :tag uint64} RCX
    ^{:line 100 :tag uint64} RDX
    ^{:line 101 :tag uint64} RBX
    ^{:line 102 :tag (array 8 byte)} _
    ^{:line 103 :tag uint64} RBP
    ^{:line 104 :tag uint64} RSI
    ^{:line 105 :tag uint64} RDI
    ^{:line 106 :tag uint64} R8
    ^{:line 107 :tag uint64} R9
    ^{:line 108 :tag uint64} R10
    ^{:line 109 :tag uint64} R11
    ^{:line 110 :tag uint64} R12
    ^{:line 111 :tag uint64} R13
    ^{:line 112 :tag uint64} R14
    ^{:line 113 :tag uint64} R15
    ^{:line 114 :tag (array 16 byte)} _

    ^{:line 116 :tag uint64} GUEST_EXITINFO1
    ^{:line 117 :tag uint64} GUEST_EXITINFO2
    ^{:line 118 :tag uint64} GUEST_EXITINTINFO
    ^{:line 119 :tag uint64} GUEST_NRIP
    ^{:line 120 :tag uint64} SEV_FEATURES
    ^{:line 121 :tag uint64} VINTR_CTRL
    ^{:line 122 :tag uint64} GUEST_EXITCODE
    ^{:line 123 :tag uint64} VIRTUAL_TOM
    ^{:line 124 :tag uint64} TLB_ID
    ^{:line 125 :tag uint64} PCPU_ID
    ^{:line 126 :tag uint64} EVENTINJ
    ^{:line 127 :tag uint64} XCR0
    ^{:line 128 :tag (array 16 byte)} _

    ^{:line 130 :tag uint64} X87_DP
    ^{:line 131 :tag uint32} MXCSR
    ^{:line 132 :tag uint16} X87_FTW
    ^{:line 133 :tag uint16} X87_FSW
    ^{:line 134 :tag uint16} X87_FCW
    ^{:line 135 :tag uint16} X87_FOP
    ^{:line 136 :tag uint16} X87_DS
    ^{:line 137 :tag uint16} X87_CS
    ^{:line 138 :tag uint64} X87_RIP
    ^{:line 139 :tag (array 80 uint8)} FPREG_X87
    ^{:line 140 :tag (array 256 uint8)} FPREG_XMM
    ^{:line 141 :tag (array 256 uint8)} FPREG_YMM
    ^{:line 142 :tag (array 2448 byte)} _))



^{:go/end 150} (go/method Bytes "Bytes converts the descriptor structure to byte array format.\n" ^{:tag (slice byte)} [^{:tag (* VMSA)} v]
  (let [buf (new bytes/Buffer)]
    (binary/Write buf binary/LittleEndian v)
    (.Bytes buf)))




^{:go/end 200} (go/method Init "Init sets the VMSA state to safe defaults for AP initialization by\n[amd64.CPU.InitSMP].\n" [^{:tag (* VMSA)} v ^uint64 pc]
  (let [vector (>> pc 12)]

    ;; AMD64 Architecture Programmer’s Manual, Volume 2
    ;; Canonicalization and Consistency Checks (p505).

    (set! (.-Selector (.-CS v)) (<< (conv uint16 vector) 8))
    (set! (.-Base (.-CS v)) (<< (conv uint64 vector) 12))
    (set! (.-Limit (.-CS v)) 0xffff)
    (set! (.-Attrib (.-CS v)) 0x009b) ; Present, Code, Executable, Read, Accessed

    (set! (.-Limit (.-DS v)) 0xffff)
    (set! (.-Attrib (.-DS v)) 0x0093) ; Present, Data, Read/Write, Accessed

    (set! (.-ES v) (.-DS v))
    (set! (.-FS v) (.-DS v))
    (set! (.-GS v) (.-DS v))
    (set! (.-SS v) (.-DS v))

    (set! (.-Limit (.-GDTR v)) 0xffff)
    (set! (.-Limit (.-IDTR v)) 0xffff)

    (set! (.-Limit (.-LDTR v)) 0xffff)
    (set! (.-Attrib (.-LDTR v)) 0x0082) ; Present, LDT

    (set! (.-Limit (.-TR v)) 0xffff)
    (set! (.-Attrib (.-TR v)) 0x008B) ; Present, Busy TSS

    (set! (.-CR0 v) 0x60000010) ; Cache Disabled, Not Writethrough
    (set! (.-EFER v) 0x1000) ; SVME Secure Virtual Machine Enable

    (set! (.-RIP v) (bit-and pc 0xfff))

    ;; set reserved bits
    (set! (.-RFLAGS v) 0x2)
    (set! (.-DR6 v) 0xffff0ff0)
    (set! (.-DR7 v) 0x400)

    ;; set architectural defaults
    (set! (.-G_PAT v) 0x0007040600070406)
    (set! (.-XCR0 v) 0x1)
    (set! (.-MXCSR v) 0x1f80)
    (set! (.-X87_FCW v) 0x0040)
    (set! (.-X87_FTW v) 0x5555)

    (return)))

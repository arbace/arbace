(in-ns 'go.github_com.usbarmory.tamago.kvm.sev) (go/file "secrets.go" :imports [


    ^{:line 12} [binary "encoding/binary"]
    ^{:line 13} [errors "errors"]

    ^{:line 15} [dma "github.com/usbarmory/tamago/dma"]])


(go/const ^{:val 4} secretsVersion 0x4)



(go/type SecretsPage "SecretsPage represents an AMD SEV-SNP Secrets Page format version 4\n(SEV Secure Nested Paging Firmware ABI Specification - Table 71).\n" (struct
    ^{:line 23 :tag uint32} Version
    ^{:line 24 :tag uint32} _
    ^{:line 25 :tag uint32} FMS
    ^{:line 26 :tag uint32} _
    ^{:line 27 :tag (array 16 byte)} GOSVW
    ^{:line 28 :tag (array 32 byte)} VMPCK0
    ^{:line 29 :tag (array 32 byte)} VMPCK1
    ^{:line 30 :tag (array 32 byte)} VMPCK2
    ^{:line 31 :tag (array 32 byte)} VMPCK3
    ^{:line 32 :tag (array 96 byte)} GuestArea1
    ^{:line 33 :tag (array 64 byte)} VMSATweakBitmap
    ^{:line 34 :tag (array 32 byte)} GuestArea2
    ^{:line 35 :tag uint32} TSCFactor
    ^{:line 36 :tag uint32} _
    ^{:line 37 :tag uint64} LaunchMitVector))




^{:go/end 68} (go/method Init "Init initializes a Secrets Page instance, mapping the argument memory\nlocation for guest/hypervisor access.\n" [^{:tag (* SecretsPage)} s ^uint addr ^int size] :results [^error err]
  (when (== addr 0)
    (return (errors/New "invalid address")))


  (when (< size pageSize)
    (return (errors/New "invalid size")))


  (let [(values r ^:assign err) (dma/NewRegion addr size false)]

    (when (!= err nil)
      (return))


    (let [(values _ buf) (.Reserve r size 0)]

      (when [(set! (values _ err) (binary/Decode buf binary/LittleEndian s))] (!= err nil)
        (return))


      (when (!= (.-Version s) secretsVersion)
        (return (errors/New "unsupported version")))


      (return))))

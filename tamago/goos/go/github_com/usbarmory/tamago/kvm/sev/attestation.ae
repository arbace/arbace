^{:go/end 141} (go/method GetAttestationReport "GetAttestationReport sends a guest request for an AMD SEV-SNP attestation\nreport. The arguments represent guest provided data and the VM Communication\nKey (see [SecretsPage.VMPCK]) payload and index for encrypting the request.\n" [^{:tag (* GHCB)} b ^{:tag (slice byte)} data ^{:tag (slice byte)} key ^int index] :results [^{:tag (* AttestationReport)} r ^error err]
  (let [^{:tag (slice byte)} buf (zero (slice byte))

      ^{:line 114} req (addr ^{:go/breaks [2 4]} (lit ReportRequest
          :VMPL 0
          :KeySel 0)) ; sign with VLEK | VCEK


      ^{:line 119} res (addr (lit ReportResponse))]

    ;; fill message data
    (copy (subslice (.-Data req)) data)

    (when [(set! (values buf err) (.GuestRequest b index key (.Bytes req) MSG_REPORT_REQ))] (!= err nil)
      (return))


    (when [(set! err (.unmarshal res buf))] (!= err nil)
      (return nil (fmt/Errorf "could not parse response, %v" err)))


    (when (!= (.-Status res) 0)
      (return nil (fmt/Errorf "request error, %#x" (.-Status res))))


    (when (!= (.-Version (.-Report res)) reportVersion)
      (set! err (errors/New "unsupported report version")))


    (return (addr (.-Report res)) err)))

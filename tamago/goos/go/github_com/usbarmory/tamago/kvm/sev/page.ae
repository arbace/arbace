^{:go/end 161} (go/method PageStateChange "PageStateChange requests a page state change to either private/shared\nassignment, as pages are validated/invalidated accordingly any C-Bit\ntransition [see SetEncryptedBit] must be performed after/before.\n" [^{:tag (* GHCB)} b ^uint64 start ^uint64 end ^int pageSize ^bool private] :results [^error err]
  (let [^uint64 size (zero uint64)
      ^{:line 102 :tag int} i (zero int)]

    (switch pageSize
      (case [PAGE_SIZE_4K]
        (set! size (<< 1 12)))
      (case [PAGE_SIZE_2M]
        (set! size (<< 2 20)))
      (default
        (return (errors/New "invalid page size"))))


    (let [req (addr (lit psc))]

      (for [gpa start] (< gpa end) (set! gpa + size)
        (when (>= i MaxPSCEntries)
          (return (errors/New "range exceeds page state change entries size")))


        (.AddEntry req i gpa pageSize private)
        (set! i + 1)

        (if (not private)
          (when [ret (pvalidate gpa pageSize false)] (!= ret 0)
            (return (fmt/Errorf "pvalidate error, gpa:%#x ret:%d" gpa ret)))


          (defer (^{:go/end 132} (fn []
                (when [ret (pvalidate gpa pageSize true)] (!= ret 0)
                  (set! err (fmt/Errorf "pvalidate error, gpa:%#x ret:%d" gpa ret))))))))





      (let [last (conv uint16 (- i 1))]
        (set! (.-EndEntry (.-Header req)) last)

        (when (== (.-Layout b) nil)
          (when [(set! err (.init b))] (!= err nil)
            (return)))



        (let [buf (.Bytes req)]
          (copy (subslice (.-buf b) SharedBuffer) buf)

          (when [(set! err (.Exit b PAGE_STATE_CHANGE 0 0 (+ (conv uint64 (.-addr b)) SharedBuffer)))] (!= err nil)
            (return))


          (when [(set! err (.unmarshal (.-Header req) (subslice (.-buf b) SharedBuffer (+ SharedBuffer 8))))] (!= err nil)
            (return (fmt/Errorf "could not parse response header, %v" err)))


          (when (or (<= (.-CurEntry (.-Header req)) last) (> (.-EndEntry (.-Header req)) last))
            (return (fmt/Errorf "incomplete psc (%d/%d/%d)" last (.-CurEntry (.-Header req)) (.-EndEntry (.-Header req)))))


          (return))))))

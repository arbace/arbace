  ^{:line 53} [^{:val 56 :doc "offsets\n"} entryPageSize 56]
  ^{:line 54} [^{:val 52} entryOperation 52]
  ^{:line 55} [^{:val 12} entryGFN 12]
  ^{:line 56} [^{:val 0} entrycurrentPage 0]


  ^{:line 59} [^{:val 1 :doc "page types\n"} privatePage 0x0001]
  ^{:line 60} [^{:val 2} sharedPage 0x0002]


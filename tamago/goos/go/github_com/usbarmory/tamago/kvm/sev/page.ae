^{:go/end 91} (go/method AddEntry [^{:tag (* psc)} r ^int index ^uint64 gpa ^int pageSize ^bool private]
  (let [^uint64 entry (zero uint64)]

    (bits/SetN64 (addr entry) entryGFN 0xffffffffff (>> gpa 12))
    (bits/SetN64 (addr entry) entryPageSize 1 (conv uint64 pageSize))

    (if private
      (bits/SetN64 (addr entry) entryOperation 2r1111 privatePage)

      (bits/SetN64 (addr entry) entryOperation 2r1111 sharedPage))


    (aset (.-Entries r) index entry)

    (return)))




;; Package sev implements a driver for AMD Secure Encrypted Virtualization
;; (SEV), following reference specifications:
;;
;;   - AMD64 Architecture Programmer’s Manual, Volume 2
;;   - SEV-ES Guest-Hypervisor Communication Block Standardization
;;   - SEV Secure Nested Paging Firmware ABI Specification
;;
;; This package is only meant to be used with `GOOS=tamago` as
;; supported by the TamaGo framework for bare metal Go, see
;; https://github.com/usbarmory/tamago.
(in-ns 'go.github_com.usbarmory.tamago.kvm.sev) (go/file "sev.go" :build ["//go:build !user_linux"] :doc "Package sev implements a driver for AMD Secure Encrypted Virtualization\n(SEV), following reference specifications:\n\n  - AMD64 Architecture Programmer’s Manual, Volume 2\n  - SEV-ES Guest-Hypervisor Communication Block Standardization\n  - SEV Secure Nested Paging Firmware ABI Specification\n\nThis package is only meant to be used with `GOOS=tamago` as\nsupported by the TamaGo framework for bare metal Go, see\nhttps://github.com/usbarmory/tamago.\n" :imports [


    ^{:line 27} [amd64 "github.com/usbarmory/tamago/amd64"]
    ^{:line 28} [bits "github.com/usbarmory/tamago/bits"]])




(go/const "AMD64 Architecture Programmer’s Manual, Volume 2\n15.34.10 SEV_STATUS MSR\n"
  ^{:line 34} [^{:val 3221291313} MSR_AMD_SEV_STATUS 0xc0010131]
  ^{:line 35} [^{:val 2} SEV_STATUS_SEV_SNP 2]
  ^{:line 36} [^{:val 1} SEV_STATUS_SEV_ES 1]
  ^{:line 37} [^{:val 0} SEV_STATUS_SEV 0])




(go/const "SEV-ES Guest-Hypervisor Communication Block Standardization\nTable 1: FEATURES Bitmap.\n"
  ^{:line 43} [^{:val 0} FeatureSNP 0]
  ^{:line 44} [^{:val 1} FeatureAPCreation 1]
  ^{:line 45} [^{:val 2} FeatureRestrictedInjection 2]
  ^{:line 46} [^{:val 3} FeatureRestrictedInjectionTimer 3]
  ^{:line 47} [^{:val 4} FeatureAPICIDList 4]
  ^{:line 48} [^{:val 5} FeatureMultiVMPL 5]
  ^{:line 49} [^{:val 6} FeaturePSC 6]
  ^{:line 50} [^{:val 7} FeatureTIO 7]
  ^{:line 51} [^{:val 8} FeatureUnregister 8])




(go/const ^{:val 2147549181 :doc "SEV-ES Guest-Hypervisor Communication Block Standardization\nTable 7: List of Supported Non-Automatic Events.\n"} HV_FEATURE_SUPPORT 0x8000fffd)



(go/type SEVStatus "SEVStatus represents active AMD Secure Encrypted Virtualization (SEV)\nfeatures.\n" (struct

    ^{:line 62 :tag bool :doc "SEV reports whether the KVM guest was run with SEV.\n"} SEV

    ^{:line 64 :tag bool :doc "SEV reports whether the KVM guest was run with SEV-ES.\n"} ES

    ^{:line 66 :tag bool :doc "SEV reports whether the KVM guest was run with SEV-SNP.\n"} SNP


    ^{:line 69 :tag uint64 :doc "Features reports Guest-controlled SEV feature selection.\n"} Features))




(go/type SVMFeatures "SVMFeatures represents the processor AMD Secure Virtual Machine\ncapabilities.\n" (struct

    ^{:line 76 :tag SEVStatus :doc "SEV represents the AMD SEV-SNP features\n"} SEV

    ^{:line 78 :tag int :doc "EncryptedBit represents the C-bit position\n"} EncryptedBit))



^{:go/end 103} (go/func Features "Features returns the processor AMD Secure Virtual Machine capabilities.\n" [^{:tag (* amd64/CPU)} cpu] :results [^{:tag (* SVMFeatures)} f]
  (let [(values _ _ ecx _) (.CPUID cpu amd64/CPUID_VENDOR 0)]

    (when (!= ecx amd64/CPUID_VENDOR_ECX_AMD)
      (return))


    (let [status (conv uint32 (.MSR cpu MSR_AMD_SEV_STATUS))
        (values _ ebx _ _) (.CPUID cpu amd64/CPUID_AMD_ENCM 0)]

      (set! f (addr ^{:go/breaks [2 [4 99]]} (lit SVMFeatures
            :SEV ^{:go/breaks [2 4 6 8]} (lit SEVStatus
              :SEV (bits/Get (addr status) SEV_STATUS_SEV)
              :ES (bits/Get (addr status) SEV_STATUS_SEV_ES)
              :SNP (bits/Get (addr status) SEV_STATUS_SEV_SNP)
              :Features (conv uint64 (>> status 2)))

            :EncryptedBit (conv int (bit-and ebx 2r111111)))))


      (return))))



^{:go/end 112} (go/method HypervisorFeatures "HypervisorFeatures requests the hypervisor features support bitmap.\n" [^{:tag (* GHCB)} b] :results [^uint64 features ^error err]
  (when [(set! err (.Exit b HV_FEATURE_SUPPORT 0 0 0))] (!= err nil)
    (return))


  (return (.read b SW_EXITINFO2) nil))

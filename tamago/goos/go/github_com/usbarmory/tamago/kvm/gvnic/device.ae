(in-ns 'go.github_com.usbarmory.tamago.kvm.gvnic) (go/file "device.go" :imports [


    ^{:line 12} [binary "encoding/binary"]
    ^{:line 13} [net "net"]])


(go/const
  ^{:line 17} [^{:val 1} ADMINQ_DESCRIBE_DEVICE 0x1]
  ^{:line 18} [^{:val 1} ADMINQ_DEVICE_DESCRIPTOR_VERSION 1])


(go/type deviceDescriptorCommand (struct
    ^{:line 22 :tag uint64} Address
    ^{:line 23 :tag uint32} Version
    ^{:line 24 :tag uint32} Length))


(go/type DeviceDescriptor (struct
    ^{:line 28 :tag uint64} MaxRegisteredPages
    ^{:line 29 :tag uint16} _
    ^{:line 30 :tag uint16} TxQueueEntries
    ^{:line 31 :tag uint16} RxQueueEntries
    ^{:line 32 :tag uint16} DefaultNumQueues
    ^{:line 33 :tag uint16} MTU
    ^{:line 34 :tag uint16} Counters
    ^{:line 35 :tag uint16} TxPagesPerQpl
    ^{:line 36 :tag uint16} RxPagesPerQpl
    ^{:line 37 :tag (array 6 byte)} MAC
    ^{:line 38 :tag uint16} NumDeviceOptions
    ^{:line 39 :tag uint16} TotalLength
    ^{:line 40 :tag (array 6 byte)} _))


^{:go/end 64} (go/method describeDevice [^{:tag (* GVE)} hw] :results [^error err]
  (when (== (.-Info hw) nil)
    (set! (.-Info hw) (addr (lit DeviceDescriptor))))


  (let [(values addr buf) (.Reserve (.-Region hw) pageSize pageSize)]
    (defer (.Release (.-Region hw) addr))

    (let [cmd (addr ^{:go/breaks [2 4 6]} (lit deviceDescriptorCommand
            :Address (conv uint64 addr)
            :Version ADMINQ_DEVICE_DESCRIPTOR_VERSION
            :Length pageSize))]


      (when [(set! err (.Push (.-aq hw) ADMINQ_DESCRIBE_DEVICE cmd))] (!= err nil)
        (return))


      (set! (values _ err) (binary/Decode buf binary/BigEndian (.-Info hw)))

      (return))))



^{:go/end 73} (go/method MAC "MAC returns the Media Access Control hardware address.\n" [^{:tag (* GVE)} hw] :results [^net/HardwareAddr mac]
  (when (== (.-Info hw) nil)
    (return))


  (subslice (.-MAC (.-Info hw))))

(ns go.github_com.usbarmory.tamago.kvm.virtio
  (:require [arbace.go :as go]))

(go/package virtio
  :path "github.com/usbarmory/tamago/kvm/virtio"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["legacy.go" "mmio.go" "pci.go" "queue.go" "virtio.go"]
  :init-order []
  :positions :lines)

(load "virtio/legacy")
(load "virtio/mmio")
(load "virtio/pci")
(load "virtio/queue")
(load "virtio/virtio")

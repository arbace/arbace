(ns go.github_com.usbarmory.tamago.kvm.gvnic
  (:require [arbace.go :as go]))

(go/package gvnic
  :path "github.com/usbarmory/tamago/kvm/gvnic"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["admin.go" "device.go" "gve.go" "queue.go" "resources.go"]
  :init-order [CommandTimeout]
  :positions :lines)

(load "gvnic/admin")
(load "gvnic/device")
(load "gvnic/gve")
(load "gvnic/queue")
(load "gvnic/resources")

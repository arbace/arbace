(ns go.github_com.usbarmory.tamago.user.linux
  (:require [arbace.go :as go]))

(go/package linux_user
  :path "github.com/usbarmory/tamago/user/linux"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["runtime.go"]
  :other-files ["syscall_amd64.s"]
  :init-order [ramStart ramSize ramStackOffset]
  :positions :lines)

(load "linux/runtime")

;; Package linux_user provides support for using `GOOS=tamago` in Linux user
;; space.
;;
;; This package is only meant to be used with `GOOS=tamago` as supported by the
;; TamaGo framework for bare metal Go, see https://github.com/usbarmory/tamago.
(in-ns 'go.github_com.usbarmory.tamago.user.linux) (go/file "runtime.go" :doc "Package linux_user provides support for using `GOOS=tamago` in Linux user\nspace.\n\nThis package is only meant to be used with `GOOS=tamago` as supported by the\nTamaGo framework for bare metal Go, see https://github.com/usbarmory/tamago.\n" :imports [


    ^{:line 17} [goos "runtime/goos"]
    ^{:line 18} [_ "unsafe"]])



(go/var ^{:tag uint64 :go/linkname "ramStart runtime/goos.RamStart"} ramStart 0x80000000)


(go/var ^{:tag uint64 :go/linkname "ramSize runtime/goos.RamSize"} ramSize 0x20000000) ; 512MB


(go/var ^{:tag uint64 :go/linkname "ramStackOffset runtime/goos.RamStackOffset"} ramStackOffset 0x100)


(go/func ^:extern sys_exit "defined in syscall_*.s\n" [^int32 code])
(go/func ^:extern sys_write [^{:tag (* byte)} c])
(go/func ^:extern sys_clock_gettime [] :results [^int64 ns])
(go/func ^:extern sys_getrandom [^{:tag (slice byte)} b ^int n])


^{:go/end 39} (go/func ^{:go/linkname "nanotime runtime/goos.Nanotime"} nanotime ^int64 []
  (sys_clock_gettime))



^{:go/end 42} (go/func ^{:go/linkname "initRNG runtime/goos.InitRNG"} initRNG [])


^{:go/end 47} (go/func ^{:go/linkname "getRandomData runtime/goos.GetRandomData"} getRandomData [^{:tag (slice byte)} b]
  (sys_getrandom b (len b)))



(go/var ^{:tag (array 1 byte) :doc "preallocated memory to avoid malloc during panic\n"} a)


^{:go/end 56} (go/func ^{:go/linkname "printk runtime/goos.Printk"} printk [^byte c]
  (aset a 0 c)
  (sys_write (addr (aget a 0))))



^{:go/end 61} (go/func ^{:go/linkname "hwinit0 runtime/goos.Hwinit0"} hwinit0 []
  (set! goos/Bloc (conv uintptr ramStart)))



^{:go/end 66} (go/func ^{:go/linkname "hwinit1 runtime/goos.Hwinit1"} hwinit1 []
  (set! goos/Exit sys_exit))

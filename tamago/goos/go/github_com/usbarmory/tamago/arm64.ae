(ns go.github_com.usbarmory.tamago.arm64
  (:require [arbace.go :as go]))

(go/package arm64
  :path "github.com/usbarmory/tamago/arm64"
  :files ["arm64.go" "cache.go" "exception.go" "fp.go" "init.go" "irq.go" "mmu.go" "timer.go"]
  :other-files ["arm64.h" "arm64.s" "cache.s" "exception.s" "fp.s" "init.s" "irq.s" "mmu.s" "timer.s"]
  :positions :lines)

(load "arm64/arm64")
(load "arm64/cache")
(load "arm64/exception")
(load "arm64/fp")
(load "arm64/init")
(load "arm64/irq")
(load "arm64/mmu")
(load "arm64/timer")

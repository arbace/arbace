(ns go.github_com.usbarmory.tamago.board.cloud_hypervisor.vm
  (:require [arbace.go :as go]))

(go/package vm
  :path "github.com/usbarmory/tamago/board/cloud_hypervisor/vm"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["console.go" "mem.go" "vm.go"]
  :init-order [ramSize AMD64 IOAPIC0 UART0]
  :positions :lines)

(load "vm/console")
(load "vm/mem")
(load "vm/vm")

(in-ns 'go.github_com.usbarmory.tamago.board.cloud_hypervisor.vm) (go/file "mem.go" :build ["//go:build !linkramsize"] :imports [


    ^{:line 14} [_ "unsafe"]])


;; Applications can override ramSize with the `linkramsize` build tag.
;;
;; This is useful when large DMA descriptors are required to re-initialize
;; tamago `dma` package in external RAM.


(go/var ^{:tag uint64 :go/linkname "ramSize runtime/goos.RamSize"} ramSize (- 0xb0000000 dmaSize)) ; 2560 MiB

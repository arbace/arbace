(in-ns 'go.github_com.usbarmory.tamago.board.cloud_hypervisor.vm) (go/file "console.go" :build ["//go:build !linkprintk"] :imports [


    ^{:line 14} [_ "unsafe"]])



^{:go/end 24} (go/func ^{:go/linkname "printk runtime/goos.Printk"} printk [^byte c]
  (.Tx UART0 c)

  (when (== c 0x0a) ; LF
    (.Tx UART0 0x0d))) ; CR

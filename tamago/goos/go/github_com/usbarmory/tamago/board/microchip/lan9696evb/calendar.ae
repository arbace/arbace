(in-ns 'go.github_com.usbarmory.tamago.board.microchip.lan9696evb) (go/file "calendar.go" :imports [


    ^{:line 12} [reg "github.com/usbarmory/tamago/internal/reg"]])


(go/const ^{:val 30} CalendarLength 30)

(go/var ^{:tag (slice (slice uint32))} TaxiCalendar (lit (slice (slice uint32))
    ;;  2G5: Port Group Manager IDs (0-9) separated by idle slots
    (lit (slice uint32) 0 10 10 1 10 10 2 10 10 3 10 10 4 10 10 5 10 10 6 10 10 7 10 10 8 10 10 9 10 10)
    ;;   5G: Port Group Manager IDs (0-7) separated by idle slots
    (lit (slice uint32) 0 10 10 1 10 10 2 10 10 3 10 10 4 10 10 5 10 10 6 10 10 7 10 10 10 10 10 10 10 10)
    (lit (slice uint32) 0 10 10 1 10 10 2 10 10 3 10 10 4 10 10 5 10 10 6 10 10 7 10 10 10 10 10 10 10 10)
    ;; <=1G: Port Group Manager IDs (0-1) separated by idle slots
    (lit (slice uint32) 0 10 10 1 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10)
    (lit (slice uint32) 0 10 10 1 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10 10)))


^{:go/end 47} (go/func calendarConfig [^uint32 taxi]
  (let [taxi_cal_cfg (+ TAXI_CAL_CFG (conv uint32 (* taxi 4)))

      ;; select inactive calendar for update
      ^{:line 32} active (reg/Get taxi_cal_cfg CAL_SEL_STAT)]
    (reg/SetTo taxi_cal_cfg CAL_PGM_SEL (not active))
    (reg/Set taxi_cal_cfg CAL_PGM_ENA)

    ;; initialize calendar entries
    (range [i (conv uint32 CalendarLength)]
      (reg/SetN taxi_cal_cfg CAL_IDX 0x3f i)
      (reg/SetN taxi_cal_cfg CAL_PGM_VAL 0xf (aget (aget TaxiCalendar taxi) i)))


    ;; disable update of selected calendar
    (reg/Clear taxi_cal_cfg CAL_PGM_ENA)

    ;; switch calendar
    (reg/Set taxi_cal_cfg CAL_SWITCH)))

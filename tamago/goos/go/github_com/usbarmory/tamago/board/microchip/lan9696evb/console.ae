(in-ns 'go.github_com.usbarmory.tamago.board.microchip.lan9696evb) (go/file "console.go" :build ["//go:build !linkprintk"] :imports [


    ^{:line 14} [_ "unsafe"]])


;; On the LAN969x 24-port EVB FLEXCOM0 is connected as serial console through
;; the on-board serial-to-USB (Type-C port) converter.  The standard output is
;; redirected there.


^{:go/end 24} (go/func ^{:go/linkname "printk runtime/goos.Printk"} printk [^byte c]
  (.Tx USART0 c))

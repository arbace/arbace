    ^{:line 18} [_ "unsafe"]

    ^{:line 20} [flexcom "github.com/usbarmory/tamago/soc/microchip/flexcom"]
    ^{:line 21} [lan969x "github.com/usbarmory/tamago/soc/microchip/lan969x"]])



(go/var "Peripheral instances\n"
  ^{:line 26} [USART0 (addr ^{:go/via {:Base [FLEXCOM] :IRQ [FLEXCOM] :Index [FLEXCOM]} :go/breaks [2 4 6]} (lit flexcom/USART
        :Index 1
        :Base lan969x/FLEXCOM0_BASE
        :IRQ lan969x/FLEXCOM0_IRQ))])







^{:go/end 42} (go/func ^{:go/linkname "Init runtime/goos.Hwinit1"} Init "Init takes care of the lower level initialization triggered early in runtime\nsetup (post World start).\n" []

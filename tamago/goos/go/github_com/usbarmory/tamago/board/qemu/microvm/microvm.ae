;; Package microvm provides hardware initialization, automatically on import,
;; for a QEMU microvm machine configured with one or more x86_64 cores.
;;
;; This package is only meant to be used with `GOOS=tamago GOARCH=amd64` as
;; supported by the TamaGo framework for bare metal Go, see
;; https://github.com/usbarmory/tamago.
(in-ns 'go.github_com.usbarmory.tamago.board.qemu.microvm) (go/file "microvm.go" :doc "Package microvm provides hardware initialization, automatically on import,\nfor a QEMU microvm machine configured with one or more x86_64 cores.\n\nThis package is only meant to be used with `GOOS=tamago GOARCH=amd64` as\nsupported by the TamaGo framework for bare metal Go, see\nhttps://github.com/usbarmory/tamago.\n" :imports [


    ^{:line 18} [goos "runtime/goos"]
    ^{:line 19} [_ "unsafe"]

    ^{:line 21} [amd64 "github.com/usbarmory/tamago/amd64"]
    ^{:line 22} [dma "github.com/usbarmory/tamago/dma"]
    ^{:line 23} [pvclock "github.com/usbarmory/tamago/kvm/pvclock"]
    ^{:line 24} [ioapic "github.com/usbarmory/tamago/soc/intel/ioapic"]
    ^{:line 25} [rtc "github.com/usbarmory/tamago/soc/intel/rtc"]
    ^{:line 26} [uart "github.com/usbarmory/tamago/soc/intel/uart"]])


(go/const
  ^{:line 30} [^{:val 268435456} dmaSize 0x10000000] ; 256MB
  ^{:line 31} [^{:val 2952790016} dmaStart (- 0xc0000000 dmaSize)])



(go/const "Peripheral registers\n"

  ^{:line 37} [^{:val 1016 :doc "Communication port\n"} COM1 0x3f8]


  ^{:line 40} [^{:val 4273995776 :doc "Intel I/O Programmable Interrupt Controllers\n"} IOAPIC0_BASE 0xfec00000]
  ^{:line 41} [^{:val 4274061312} IOAPIC1_BASE 0xfec10000]


  ^{:line 44} [^{:val 4272947200 :doc "VirtIO Memory-mapped I/O\n"} VIRTIO_MMIO_BASE 0xfeb00000]


  ^{:line 47} [^{:val 4272958976 :doc "VirtIO Networking\n"} VIRTIO_NET0_BASE (+ VIRTIO_MMIO_BASE 0x2e00)]
  ^{:line 48} [^{:val 47} VIRTIO_NET0_IRQ 47])



(go/var "Peripheral instances\n"

  ^{:line 54} [^{:doc "CPU instance(s)\n"} AMD64 (addr ^{:go/breaks [[2 56]]} (lit amd64/CPU
        ;; required before Init()
        :TimerMultiplier 1))]



  ^{:line 60} [^{:doc "I/O APIC - GSI 0-23\n"} IOAPIC0 (addr ^{:go/breaks [2 4 6]} (lit ioapic/IOAPIC
        :Index 0
        :Base IOAPIC0_BASE
        :GSIBase 0))]



  ^{:line 67} [^{:doc "I/O APIC - GSI 24-47\n"} IOAPIC1 (addr ^{:go/breaks [2 4 6]} (lit ioapic/IOAPIC
        :Index 1
        :Base IOAPIC1_BASE
        :GSIBase 24))]



  ^{:line 74} [^{:doc "Real-Time Clock\n"} RTC (addr (lit rtc/RTC))]


  ^{:line 77} [^{:doc "Serial port\n"} UART0 (addr ^{:go/breaks [2 4]} (lit uart/UART
        :Index 1
        :Base COM1))])




^{:go/end 86} (go/func ^{:go/linkname "nanotime runtime/goos.Nanotime"} nanotime ^int64 []
  (.GetTime AMD64))






^{:go/end 108} (go/func ^{:go/linkname "Init runtime/goos.Hwinit1"} Init "Init takes care of the lower level initialization triggered early in runtime\nsetup (post World start).\n" []
  ;; initialize BSP
  (.Init AMD64)

  ;; initialize I/O APICs
  (.Init IOAPIC0)
  (.Init IOAPIC1)

  ;; initialize serial console
  (.Init UART0)

  (set! goos/Exit ^{:go/end 107} (fn [^int32 _]
      ;; On microvm the recommended way to trigger a guest-initiated
      ;; shut down is by generating a triple-fault.
      (amd64/Fault))))



^{:go/end 122} (go/func init []
  ;; trap CPU exceptions
  (.EnableExceptions AMD64)

  ;; initialize APs
  (.InitSMP AMD64 -1)

  ;; allocate global DMA region
  (dma/Init dmaStart dmaSize)

  ;; initialize KVM pvclock as needed
  (pvclock/Init AMD64))

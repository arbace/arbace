(in-ns 'go.github_com.usbarmory.tamago.board.nxp.imx8mpevk) (go/file "console.go" :build ["//go:build !linkprintk"] :imports [


    ^{:line 14} [_ "unsafe"]

    ^{:line 16} [imx8mp "github.com/usbarmory/tamago/soc/nxp/imx8mp"]])


;; On the 8MPLUSLPD4-EVK the serial console is UART1, therefore standard
;; output is redirected there.


^{:go/end 25} (go/func ^{:go/linkname "printk runtime/goos.Printk"} printk [^byte c]
  (.Tx imx8mp/UART1 c))

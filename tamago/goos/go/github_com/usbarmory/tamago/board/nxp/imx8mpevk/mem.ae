(in-ns 'go.github_com.usbarmory.tamago.board.nxp.imx8mpevk) (go/file "mem.go" :build ["//go:build !linkramsize"] :imports [


    ^{:line 14} [_ "unsafe"]])


;; Applications can override ramSize with the `linkramsize` build tag.
;;
;; This is useful when large DMA descriptors are required to re-initialize
;; tamago `dma` package in external RAM.

;; The 8MPLUSLPD4-EVK features 6GB LPDDR4 RAM.


(go/var ^{:tag uint64 :go/linkname "ramSize runtime/goos.RamSize"} ramSize 0x180000000) ; 6GB

;; Package imx8mpevk provides hardware initialization, automatically on import,
;; for the NXP 8MPLUSLPD4-EVK evaluation board.
;;
;; This package is only meant to be used with `GOOS=tamago GOARCH=arm64` as
;; supported by the TamaGo framework for bare metal Go, see
;; https://github.com/usbarmory/tamago.
(in-ns 'go.github_com.usbarmory.tamago.board.nxp.imx8mpevk) (go/file "imx8mpevk.go" :doc "Package imx8mpevk provides hardware initialization, automatically on import,\nfor the NXP 8MPLUSLPD4-EVK evaluation board.\n\nThis package is only meant to be used with `GOOS=tamago GOARCH=arm64` as\nsupported by the TamaGo framework for bare metal Go, see\nhttps://github.com/usbarmory/tamago.\n" :imports [


    ^{:line 18} [_ "unsafe"]

    ^{:line 20} [imx8mp "github.com/usbarmory/tamago/soc/nxp/imx8mp"]])



(go/var "Peripheral instances\n"
  ^{:line 25} [ENET1 imx8mp/ENET1]
  ^{:line 26} [UART1 imx8mp/UART1])






^{:go/end 38} (go/func ^{:go/linkname "Init runtime/goos.Hwinit1"} Init "Init takes care of the lower level initialization triggered early in runtime\nsetup (post World start).\n" []
  (imx8mp/Init)

  ;; initialize console
  (.Init imx8mp/UART1))

(ns go.github_com.usbarmory.tamago.board.google.gcp
  (:require [arbace.go :as go]))

(go/package gcp
  :path "github.com/usbarmory/tamago/board/google/gcp"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["console.go" "gcp.go" "mem.go"]
  :init-order [AMD64 IOAPIC0 RTC UART0 ramSize]
  :positions :lines)

(load "gcp/console")
(load "gcp/gcp")
(load "gcp/mem")

;; Package gcp provides hardware initialization, automatically on import, for a
;; Google Compute Engine machine configured with one or more x86_64 cores.
;;
;; This package is only meant to be used with `GOOS=tamago GOARCH=amd64` as
;; supported by the TamaGo framework for bare metal Go, see
;; https://github.com/usbarmory/tamago.
(in-ns 'go.github_com.usbarmory.tamago.board.google.gcp) (go/file "gcp.go" :doc "Package gcp provides hardware initialization, automatically on import, for a\nGoogle Compute Engine machine configured with one or more x86_64 cores.\n\nThis package is only meant to be used with `GOOS=tamago GOARCH=amd64` as\nsupported by the TamaGo framework for bare metal Go, see\nhttps://github.com/usbarmory/tamago.\n" :imports [


    ^{:line 18} [goos "runtime/goos"]
    ^{:line 19} [_ "unsafe"]

    ^{:line 21} [amd64 "github.com/usbarmory/tamago/amd64"]
    ^{:line 22} [dma "github.com/usbarmory/tamago/dma"]
    ^{:line 23} [pvclock "github.com/usbarmory/tamago/kvm/pvclock"]
    ^{:line 24} [ioapic "github.com/usbarmory/tamago/soc/intel/ioapic"]
    ^{:line 25} [rtc "github.com/usbarmory/tamago/soc/intel/rtc"]
    ^{:line 26} [uart "github.com/usbarmory/tamago/soc/intel/uart"]])


(go/const
  ^{:line 30} [^{:val 1342177280} dmaStart 0x50000000]
  ^{:line 31} [^{:val 268435456} dmaSize 0x10000000]) ; 256MB



(go/const "Peripheral registers\n"

  ^{:line 37} [^{:val 1016 :doc "Communication port\n"} COM1 0x3f8]


  ^{:line 40} [^{:val 4273995776 :doc "Intel I/O Programmable Interrupt Controllers\n"} IOAPIC0_BASE 0xfec00000]


  ^{:line 43} [^{:val 6900 :doc "VirtIO Networking\n"} VIRTIO_NET_PCI_VENDOR 0x1af4] ; Red Hat, Inc.
  ^{:line 44} [^{:val 4096} VIRTIO_NET_PCI_DEVICE 0x1000]) ; Virtio 1.0 network device



(go/var "Peripheral instances\n"

  ^{:line 50} [^{:doc "CPU instance(s)\n"} AMD64 (addr ^{:go/breaks [[2 52]]} (lit amd64/CPU
        ;; required before Init()
        :TimerMultiplier 1))]



  ^{:line 56} [^{:doc "I/O APIC\n"} IOAPIC0 (addr ^{:go/breaks [2]} (lit ioapic/IOAPIC
        :Base IOAPIC0_BASE))]



  ^{:line 61} [^{:doc "Real-Time Clock\n"} RTC (addr (lit rtc/RTC))]


  ^{:line 64} [^{:doc "Serial port\n"} UART0 (addr ^{:go/breaks [2 4 6 8]} (lit uart/UART
        :Index 1
        :Base COM1
        :DTR true
        :RTS true))])




^{:go/end 75} (go/func ^{:go/linkname "nanotime runtime/goos.Nanotime"} nanotime ^int64 []
  (.GetTime AMD64))






^{:go/end 94} (go/func ^{:go/linkname "Init runtime/goos.Hwinit1"} Init "Init takes care of the lower level initialization triggered early in runtime\nsetup (post World start).\n" []
  ;; initialize BSP
  (.Init AMD64)

  ;; initialize I/O APIC
  (.Init IOAPIC0)

  ;; initialize serial console
  (.Init UART0)

  (set! goos/Exit ^{:go/end 93} (fn [^int32 _]
      (amd64/Fault))))



^{:go/end 108} (go/func init []
  ;; trap CPU exceptions
  (.EnableExceptions AMD64)

  ;; initialize APs
  (.InitSMP AMD64 -1)

  ;; allocate global DMA region
  (dma/Init dmaStart dmaSize)

  ;; initialize KVM pvclock as needed
  (pvclock/Init AMD64))

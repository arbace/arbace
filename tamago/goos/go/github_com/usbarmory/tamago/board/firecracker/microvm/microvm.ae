;; Package microvm provides hardware initialization, automatically on import,
;; for a Firecracker microvm configured with one or more x86_64 cores.
;;
;; This package is only meant to be used with `GOOS=tamago GOARCH=amd64` as
;; supported by the TamaGo framework for bare metal Go, see
;; https://github.com/usbarmory/tamago.
(in-ns 'go.github_com.usbarmory.tamago.board.firecracker.microvm) (go/file "microvm.go" :doc "Package microvm provides hardware initialization, automatically on import,\nfor a Firecracker microvm configured with one or more x86_64 cores.\n\nThis package is only meant to be used with `GOOS=tamago GOARCH=amd64` as\nsupported by the TamaGo framework for bare metal Go, see\nhttps://github.com/usbarmory/tamago.\n" :imports [


    ^{:line 18} [goos "runtime/goos"]
    ^{:line 19} [_ "unsafe"]

    ^{:line 21} [amd64 "github.com/usbarmory/tamago/amd64"]
    ^{:line 22} [dma "github.com/usbarmory/tamago/dma"]
    ^{:line 23} [pvclock "github.com/usbarmory/tamago/kvm/pvclock"]
    ^{:line 24} [ioapic "github.com/usbarmory/tamago/soc/intel/ioapic"]
    ^{:line 25} [uart "github.com/usbarmory/tamago/soc/intel/uart"]

    ^{:line 27} [reg "github.com/usbarmory/tamago/internal/reg"]])


(go/const
  ^{:line 31} [^{:val 268435456} dmaSize 0x10000000] ; 256MB
  ^{:line 32} [^{:val 2952790016} dmaStart (- 0xc0000000 dmaSize)])



(go/const "Peripheral registers\n"
  ^{:line 37} [^{:val 33} PIC_DATA 0x21]


  ^{:line 40} [^{:val 1016 :doc "Communication port\n"} COM1 0x3f8]


  ^{:line 43} [^{:val 4273995776 :doc "Intel I/O Programmable Interrupt Controller\n"} IOAPIC0_BASE 0xfec00000]


  ^{:line 46} [^{:val 3221225472 :doc "VirtIO Memory-mapped I/O\n"} VIRTIO_MMIO_BASE 0xc0000000]


  ^{:line 49} [^{:val 3221233664 :doc "VirtIO Networking\n"} VIRTIO_NET0_BASE (+ VIRTIO_MMIO_BASE 0x2000)]
  ^{:line 50} [^{:val 6} VIRTIO_NET0_IRQ 6])



(go/var "Peripheral instances\n"

  ^{:line 56} [^{:doc "CPU instance(s)\n"} AMD64 (addr ^{:go/breaks [[2 58]]} (lit amd64/CPU
        ;; required before Init()
        :TimerMultiplier 1))]



  ^{:line 62} [^{:doc "I/O APIC\n"} IOAPIC0 (addr ^{:go/breaks [2]} (lit ioapic/IOAPIC
        :Base IOAPIC0_BASE))]



  ^{:line 67} [^{:doc "Serial port\n"} UART0 (addr ^{:go/breaks [2 4]} (lit uart/UART
        :Index 1
        :Base COM1))])




^{:go/end 76} (go/func ^{:go/linkname "nanotime runtime/goos.Nanotime"} nanotime ^int64 []
  (.GetTime AMD64))






^{:go/end 98} (go/func ^{:go/linkname "Init runtime/goos.Hwinit1"} Init "Init takes care of the lower level initialization triggered early in runtime\nsetup (post World start).\n" []
  ;; initialize CPU
  (.Init AMD64)

  ;; initialize I/O APIC
  (.Init IOAPIC0)

  ;; disable PIC interrupts
  (reg/Out8 PIC_DATA 0xff)

  ;; initialize serial console
  (.Init UART0)

  (set! goos/Exit ^{:go/end 97} (fn [^int32 _]
      (.Reset AMD64))))



^{:go/end 112} (go/func init []
  ;; trap CPU exceptions
  (.EnableExceptions AMD64)

  ;; initialize APs
  (.InitSMP AMD64 -1)

  ;; allocate global DMA region
  (dma/Init dmaStart dmaSize)

  ;; initialize KVM pvclock as needed
  (pvclock/Init AMD64))

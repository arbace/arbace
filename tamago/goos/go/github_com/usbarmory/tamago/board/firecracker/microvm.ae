(ns go.github_com.usbarmory.tamago.board.firecracker.microvm
  (:require [arbace.go :as go]))

(go/package microvm
  :path "github.com/usbarmory/tamago/board/firecracker/microvm"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["console.go" "mem.go" "microvm.go"]
  :init-order [ramSize AMD64 IOAPIC0 UART0]
  :positions :lines)

(load "microvm/console")
(load "microvm/mem")
(load "microvm/microvm")

(in-ns 'go.github_com.usbarmory.tamago.internal.rng) (go/file "aes.go" :imports [


    ^{:line 10} [aes "crypto/aes"]
    ^{:line 11} [binary "encoding/binary"]
    ^{:line 12} [sync "sync"]])




(go/type DRBG "DRBG is an AES-CTR based Deterministic Random Bit Generator. The generator\nis a fast key erasure RNG.\n" (struct
    ^{:line 18} sync/Mutex



    ^{:line 22 :tag (array 32 byte) :doc "Seed represents the initial key for the AES-CTR cipher instance, it\nwill be overwritten during use to implement key erasure.\n"} Seed))



^{:go/end 60} (go/method GetRandomData "GetRandomData returns len(b) random bytes.\n" [^{:tag (* DRBG)} r ^{:tag (slice byte)} b]
  (let [^uint64 counter (zero uint64)
      ^{:line 28 :tag (array aes/BlockSize byte)} block (zero (array aes/BlockSize byte))]

    ^{:go/via [Mutex]} (.Lock r)
    (let [(values blockCipher err) (aes/NewCipher (subslice (.-Seed r)))]

      (when (!= err nil)
        (panic err))


      (let [inc ^{:go/end 43} (fn []
            (inc! counter)
            (when (== counter 0)
              (panic "DRBG counter wrapped"))

            (.PutUint64 binary/LittleEndian (subslice block) counter))]


        (.Encrypt blockCipher (subslice (.-Seed r) _ aes/BlockSize) (subslice block))
        (inc)
        (.Encrypt blockCipher (subslice (.-Seed r) aes/BlockSize) (subslice block))
        (inc)
        ^{:go/via [Mutex]} (.Unlock r)

        (while (>= (len b) aes/BlockSize)
          (.Encrypt blockCipher (subslice b _ aes/BlockSize) (subslice block))
          (inc)
          (set! b (subslice b aes/BlockSize)))

        (when (> (len b) 0)
          (.Encrypt blockCipher (subslice block) (subslice block))
          (copy b (subslice block)))))))

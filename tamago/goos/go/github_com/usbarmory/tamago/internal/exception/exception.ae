(in-ns 'go.github_com.usbarmory.tamago.internal.exception) (go/file "exception.go" :imports [

    ^{:line 10} [runtime "runtime"]])

^{:go/end 18} (go/func Throw [^uintptr pc]
  (let [fn (runtime/FuncForPC pc)
      (values file line) (.FileLine fn pc)]

    (print "\t" file ":" line "\n")
    (panic "unhandled exception")))

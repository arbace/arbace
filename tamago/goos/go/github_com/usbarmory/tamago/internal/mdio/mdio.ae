(in-ns 'go.github_com.usbarmory.tamago.internal.mdio) (go/file "mdio.go" :imports [


    ^{:line 12} [bits "github.com/usbarmory/tamago/bits"]])


(go/const

  ^{:line 17} [^{:val 1 :doc "IEEE 802.3-2008 Clause 22\n"} ST 2r01]
  ^{:line 18} [^{:val 2} OP_READ 2r10]
  ^{:line 19} [^{:val 1} OP_WRITE 2r01]
  ^{:line 20} [^{:val 2} TA 2r10]


  ^{:line 23} [^{:val 0 :doc "IEEE 802.3-2008 Clause 45\n"} ST_45 2r00]
  ^{:line 24} [^{:val 0} OP_ADDR 2r00]
  ^{:line 25} [^{:val 2} OP_READ_INC 2r10]
  ^{:line 26} [^{:val 3} OP_READ_45 2r11]
  ^{:line 27} [^{:val 2} TA_45 2r10]


  ^{:line 30} [^{:val 30 :doc "Management Frame Fields\n"} MMFR_ST 30]
  ^{:line 31} [^{:val 28} MMFR_OP 28]
  ^{:line 32} [^{:val 23} MMFR_PA 23]
  ^{:line 33} [^{:val 18} MMFR_RA 18]
  ^{:line 34} [^{:val 16} MMFR_TA 16]
  ^{:line 35} [^{:val 0} MMFR_DATA 0])



^{:go/end 48} (go/func Frame "Frame builds an MDIO frame.\n" [^uint32 st ^uint32 op ^uint32 pa ^uint32 ra ^uint32 ta ^uint16 data] :results [^uint32 frame]
  (bits/SetN (addr frame) MMFR_ST 2r11 st)
  (bits/SetN (addr frame) MMFR_OP 2r11 op)
  (bits/SetN (addr frame) MMFR_PA 0x1f pa)
  (bits/SetN (addr frame) MMFR_RA 0x1f ra)
  (bits/SetN (addr frame) MMFR_TA 2r11 ta)
  (bits/SetN (addr frame) MMFR_DATA 0xffff (conv uint32 data))

  (return))

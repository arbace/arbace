(in-ns 'go.github_com.usbarmory.tamago.internal.reg) (go/file "reg64.go" :build ["//go:build arm64 || amd64 || loong64 || riscv64"] :imports [


    ^{:line 13} [atomic "sync/atomic"]
    ^{:line 14} [unsafe "unsafe"]])


^{:go/end 22} (go/func Get64 ^bool [^uint64 addr ^int pos]
  (let [reg (conv (* uint64) (conv unsafe/Pointer (conv uintptr addr)))
      ^{:line 19} r (atomic/LoadUint64 reg)]

    (== (bit-and (>> r pos) 1) 1)))


^{:go/end 31} (go/func Set64 [^uint64 addr ^int pos]
  (let [reg (conv (* uint64) (conv unsafe/Pointer (conv uintptr addr)))

      ^{:line 27} r (atomic/LoadUint64 reg)]
    (set! r bit-or ^uint64 (<< 1 pos))

    (atomic/StoreUint64 reg r)))


^{:go/end 39} (go/func SetTo64 [^uint64 addr ^int pos ^bool val]
  (if val
    (Set64 addr pos)

    (Clear64 addr pos)))



^{:go/end 48} (go/func Clear64 [^uint64 addr ^int pos]
  (let [reg (conv (* uint64) (conv unsafe/Pointer (conv uintptr addr)))

      ^{:line 44} r (atomic/LoadUint64 reg)]
    (set! r bit-and (bit-not ^uint64 (<< 1 pos)))

    (atomic/StoreUint64 reg r)))


^{:go/end 55} (go/func GetN64 ^uint64 [^uint64 addr ^int pos ^int mask]
  (let [reg (conv (* uint64) (conv unsafe/Pointer (conv uintptr addr)))
      ^{:line 52} r (atomic/LoadUint64 reg)]

    (bit-and (>> r pos) (conv uint64 mask))))


^{:go/end 60} (go/func Read64 ^uint64 [^uint64 addr]
  (let [reg (conv (* uint64) (conv unsafe/Pointer (conv uintptr addr)))]
    (atomic/LoadUint64 reg)))



(go/func ^:extern Write64 "defined in reg_*.s\n" [^uint64 addr ^uint64 val])

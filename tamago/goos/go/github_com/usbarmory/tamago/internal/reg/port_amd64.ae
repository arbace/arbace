(in-ns 'go.github_com.usbarmory.tamago.internal.reg) (go/file "port_amd64.go" :imports [])


(go/func ^:extern In8 "defined in port_amd64.s\n" [^uint16 port] :results [^uint8 val])
(go/func ^:extern Out8 [^uint16 port ^uint8 val])
(go/func ^:extern In16 [^uint16 port] :results [^uint16 val])
(go/func ^:extern Out16 [^uint16 port ^uint16 val])
(go/func ^:extern In32 [^uint16 port] :results [^uint32 val])
(go/func ^:extern Out32 [^uint16 port ^uint32 val])

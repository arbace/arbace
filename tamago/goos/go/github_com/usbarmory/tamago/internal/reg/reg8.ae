(in-ns 'go.github_com.usbarmory.tamago.internal.reg) (go/file "reg8.go" :imports [])


(go/func ^:extern Read8 "defined in reg_*.s\n" ^uint8 [^uint32 addr])
(go/func ^:extern Write8 [^uint32 addr ^uint8 val])

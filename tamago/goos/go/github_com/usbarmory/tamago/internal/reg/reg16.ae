(in-ns 'go.github_com.usbarmory.tamago.internal.reg) (go/file "reg16.go" :imports [


    ^{:line 11} [runtime "runtime"]
    ^{:line 12} [time "time"]
    ^{:line 13} [unsafe "unsafe"]])


;; As sync/atomic does not provide 16-bit support, note that these functions do
;; not necessarily enforce memory ordering.

^{:go/end 24} (go/func Get16 ^bool [^uint32 addr ^int pos]
  (let [reg (conv (* uint16) (conv unsafe/Pointer (conv uintptr addr)))
      ^{:line 21} r @reg]

    (== (bit-and (>> r pos) 1) 1)))


^{:go/end 29} (go/func Set16 [^uint32 addr ^int pos]
  (let [reg (conv (* uint16) (conv unsafe/Pointer (conv uintptr addr)))]
    (set! @reg bit-or ^uint16 (<< 1 pos))))


^{:go/end 37} (go/func SetTo16 [^uint32 addr ^int pos ^bool val]
  (if val
    (Set16 addr pos)

    (Clear16 addr pos)))



^{:go/end 42} (go/func Clear16 [^uint32 addr ^int pos]
  (let [reg (conv (* uint16) (conv unsafe/Pointer (conv uintptr addr)))]
    (set! @reg bit-and (bit-not ^uint16 (<< 1 pos)))))


^{:go/end 47} (go/func GetN16 ^uint16 [^uint32 addr ^int pos ^int mask]
  (let [reg (conv (* uint16) (conv unsafe/Pointer (conv uintptr addr)))]
    (bit-and (>> @reg pos) (conv uint16 mask))))


^{:go/end 52} (go/func SetN16 [^uint32 addr ^int pos ^int mask ^uint16 val]
  (let [reg (conv (* uint16) (conv unsafe/Pointer (conv uintptr addr)))]
    (set! @reg (bit-or (bit-and @reg (bit-not (<< (conv uint16 mask) pos))) (<< (bit-and val (conv uint16 mask)) pos)))))


^{:go/end 57} (go/func ClearN16 [^uint32 addr ^int pos ^int mask]
  (let [reg (conv (* uint16) (conv unsafe/Pointer (conv uintptr addr)))]
    (set! @reg bit-and (bit-not (<< (conv uint16 mask) pos)))))


^{:go/end 62} (go/func Read16 ^uint16 [^uint32 addr]
  (let [reg (conv (* uint16) (conv unsafe/Pointer (conv uintptr addr)))]
    ^{:line 61} @reg))


^{:go/end 67} (go/func Write16 [^uint32 addr ^uint16 val]
  (let [reg (conv (* uint16) (conv unsafe/Pointer (conv uintptr addr)))]
    (set! @reg val)))


^{:go/end 72} (go/func Or16 [^uint32 addr ^uint16 val]
  (let [reg (conv (* uint16) (conv unsafe/Pointer (conv uintptr addr)))]
    (set! @reg bit-or val)))


^{:go/end 78} (go/func Wait16 [^uint32 addr ^int pos ^int mask ^uint16 val]
  (while (!= (GetN16 addr pos mask) val)
    (runtime/Gosched)))



^{:go/end 92} (go/func WaitFor16 ^bool [^time/Duration timeout ^uint32 addr ^int pos ^int mask ^uint16 val]
  ^{:go/breaks [[3 91]]} (let [start (time/Now)]

    (while (!= (GetN16 addr pos mask) val)
      (runtime/Gosched)

      (when (>= (time/Since start) timeout)
        (return false)))



    true))

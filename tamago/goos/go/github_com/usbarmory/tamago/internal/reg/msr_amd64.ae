(in-ns 'go.github_com.usbarmory.tamago.internal.reg) (go/file "msr_amd64.go" :imports [])


(go/func ^:extern ReadMSR "defined in msr_amd64.s\n" [^uint64 addr] :results [^uint64 val])
(go/func ^:extern WriteMSR [^uint64 addr ^uint64 val])

(in-ns 'go.github_com.usbarmory.tamago.bits) (go/file "bits64.go" :imports [])


^{:go/end 13} (go/func Get64 "Get64 returns whether a specific bit position is set at the pointed value.\n" ^bool [^{:tag (* uint64)} addr ^int pos]
  (== (bit-and (>> (conv int @addr) pos) 1) 1))




^{:go/end 19} (go/func Set64 "Set64 modifies the pointed value by setting an individual bit at the\nposition argument.\n" [^{:tag (* uint64)} addr ^int pos]
  (set! @addr bit-or ^uint64 (<< 1 pos)))




^{:go/end 29} (go/func SetTo64 "SetTo64 modifies the pointed value by setting an individual bit at the\nposition argument.\n" [^{:tag (* uint64)} addr ^int pos ^bool val]
  (if val
    (Set64 addr pos)

    (Clear64 addr pos)))





^{:go/end 35} (go/func Clear64 "Clear64 modifies the pointed value by clearing an individual bit at the\nposition argument.\n" [^{:tag (* uint64)} addr ^int pos]
  (set! @addr bit-and (bit-not ^uint64 (<< 1 pos))))




^{:go/end 41} (go/func GetN64 "GetN64 returns the pointed value at a specific bit position and with a\nbitmask applied.\n" ^uint64 [^{:tag (* uint64)} addr ^int pos ^int mask]
  (conv uint64 (bit-and (>> (conv int @addr) pos) mask)))




^{:go/end 47} (go/func SetN64 "SetN64 modifies the pointed value by setting a value at a specific bit\nposition and with a bitmask applied.\n" [^{:tag (* uint64)} addr ^int pos ^int mask ^uint64 val]
  (set! @addr (bit-or (bit-and @addr (bit-not (<< (conv uint64 mask) pos))) (<< val pos))))

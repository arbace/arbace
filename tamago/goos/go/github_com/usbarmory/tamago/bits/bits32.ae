;; Package bits provides primitives for bitwise operations on registers.
(in-ns 'go.github_com.usbarmory.tamago.bits) (go/file "bits32.go" :doc "Package bits provides primitives for bitwise operations on registers.\n" :imports [])


^{:go/end 14} (go/func Get "Get returns whether a specific bit position is set at the pointed value.\n" ^bool [^{:tag (* uint32)} addr ^int pos]
  (== (bit-and (>> (conv int @addr) pos) 1) 1))




^{:go/end 20} (go/func Set "Set modifies the pointed value by setting an individual bit at the position\nargument.\n" [^{:tag (* uint32)} addr ^int pos]
  (set! @addr bit-or ^uint32 (<< 1 pos)))




^{:go/end 30} (go/func SetTo "SetTo modifies the pointed value by setting an individual bit at the\nposition argument.\n" [^{:tag (* uint32)} addr ^int pos ^bool val]
  (if val
    (Set addr pos)

    (Clear addr pos)))





^{:go/end 36} (go/func Clear "Clear modifies the pointed value by clearing an individual bit at the\nposition argument.\n" [^{:tag (* uint32)} addr ^int pos]
  (set! @addr bit-and (bit-not ^uint32 (<< 1 pos))))




^{:go/end 42} (go/func GetN "GetN returns the pointed value at a specific bit position and with a bitmask\napplied.\n" ^uint32 [^{:tag (* uint32)} addr ^int pos ^int mask]
  (conv uint32 (bit-and (>> (conv int @addr) pos) mask)))




^{:go/end 48} (go/func SetN "SetN modifies the pointed value by setting a value at a specific bit\nposition and with a bitmask applied.\n" [^{:tag (* uint32)} addr ^int pos ^int mask ^uint32 val]
  (set! @addr (bit-or (bit-and @addr (bit-not (<< (conv uint32 mask) pos))) (<< val pos))))

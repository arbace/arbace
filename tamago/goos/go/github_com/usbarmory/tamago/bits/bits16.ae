(in-ns 'go.github_com.usbarmory.tamago.bits) (go/file "bits16.go" :imports [])


^{:go/end 13} (go/func Get16 "Get16 returns whether a specific bit position is set at the pointed value.\n" ^bool [^{:tag (* uint16)} addr ^int pos]
  (== (bit-and (>> (conv int @addr) pos) 1) 1))




^{:go/end 19} (go/func Set16 "Set16 modifies the pointed value by setting an individual bit at the\nposition argument.\n" [^{:tag (* uint16)} addr ^int pos]
  (set! @addr bit-or ^uint16 (<< 1 pos)))




^{:go/end 29} (go/func SetTo16 "SetTo16 modifies the pointed value by setting an individual bit at the\nposition argument.\n" [^{:tag (* uint16)} addr ^int pos ^bool val]
  (if val
    (Set16 addr pos)

    (Clear16 addr pos)))





^{:go/end 35} (go/func Clear16 "Clear16 modifies the pointed value by clearing an individual bit at the\nposition argument.\n" [^{:tag (* uint16)} addr ^int pos]
  (set! @addr bit-and (bit-not ^uint16 (<< 1 pos))))




^{:go/end 41} (go/func GetN16 "GetN16 returns the pointed value at a specific bit position and with a\nbitmask applied.\n" ^uint16 [^{:tag (* uint16)} addr ^int pos ^int mask]
  (conv uint16 (bit-and (>> (conv int @addr) pos) mask)))




^{:go/end 47} (go/func SetN16 "SetN16 modifies the pointed value by setting a value at a specific bit\nposition and with a bitmask applied.\n" [^{:tag (* uint16)} addr ^int pos ^int mask ^uint16 val]
  (set! @addr (bit-or (bit-and @addr (bit-not (<< (conv uint16 mask) pos))) (<< val pos))))

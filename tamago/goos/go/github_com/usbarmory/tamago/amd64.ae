(ns go.github_com.usbarmory.tamago.amd64
  (:require [arbace.go :as go]))

(go/package amd64
  :path "github.com/usbarmory/tamago/amd64"
  :files ["amd64.go" "exception.go" "features.go" "init.go" "irq.go" "mem.go" "mmu.go" "rng.go" "smp.go" "timer.go"]
  :other-files ["amd64.h" "amd64.s" "exception.s" "features.s" "init.s" "irq.s" "mmu.s" "rng.s" "smp.s" "timer.s"]
  :positions :lines)

(load "amd64/amd64")
(load "amd64/exception")
(load "amd64/features")
(load "amd64/init")
(load "amd64/irq")
(load "amd64/mem")
(load "amd64/mmu")
(load "amd64/rng")
(load "amd64/smp")
(load "amd64/timer")

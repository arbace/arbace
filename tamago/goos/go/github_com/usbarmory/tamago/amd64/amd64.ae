;; Package amd64 provides support for AMD/Intel 64-bit architecture specific
;; operations.
;;
;; The following architectures/cores are supported/tested:
;;   - AMD64 (multiprocessor)
;;
;; This package is only meant to be used with `GOOS=tamago GOARCH=amd64` as
;; supported by the TamaGo framework for bare metal Go, see
;; https://github.com/usbarmory/tamago.
(in-ns 'go.github_com.usbarmory.tamago.amd64) (go/file "amd64.go" :doc "Package amd64 provides support for AMD/Intel 64-bit architecture specific\noperations.\n\nThe following architectures/cores are supported/tested:\n  - AMD64 (multiprocessor)\n\nThis package is only meant to be used with `GOOS=tamago GOARCH=amd64` as\nsupported by the TamaGo framework for bare metal Go, see\nhttps://github.com/usbarmory/tamago.\n" :imports [


    ^{:line 21} [math "math"]
    ^{:line 22} [runtime "runtime"]
    ^{:line 23} [goos "runtime/goos"]
    ^{:line 24} [_ "unsafe"]

    ^{:line 26} [lapic "github.com/usbarmory/tamago/amd64/lapic"]
    ^{:line 27} [reg "github.com/usbarmory/tamago/internal/reg"]])



(go/const "Peripheral registers\n"

  ^{:line 33} [^{:val 100 :doc "Keyboard controller port\n"} KBD_PORT 0x64]

  ^{:line 35} [^{:val 4276092928 :doc "Intel Local Advanced Programmable Interrupt Controller\n"} LAPIC_BASE 0xfee00000])



(go/const "aliased constants\n"
  ^{:line 40} [^{:val 4276093104} LAPIC_EOI (+ LAPIC_BASE lapic/LAPIC_EOI)]
  ^{:line 41} [^{:val 4276093168} LAPIC_SVR (+ LAPIC_BASE lapic/LAPIC_SVR)]
  ^{:line 42} [^{:val 4276093696} LAPIC_ICRL (+ LAPIC_BASE lapic/LAPIC_ICRL)]

  ^{:line 44} [^{:val 8} SVR_ENABLE lapic/SVR_ENABLE]

  ^{:line 46} [^{:val 18} ICR_DST lapic/ICR_DST]
  ^{:line 47} [^{:val 786432} ICR_DST_REST lapic/ICR_DST_REST])



(go/var ^{:tag uint64 :go/linkname "ramStackOffset runtime/goos.RamStackOffset"} ramStackOffset 0x100000) ; 1 MB


(go/type CPU "CPU represents the Bootstrap Processor (BSP) instance.\n" (struct

    ^{:line 56 :tag float64 :doc "Timer multiplier\n"} TimerMultiplier

    ^{:line 58 :tag int64 :doc "Timer offset in nanoseconds\n"} TimerOffset


    ^{:line 61 :tag (* lapic/LAPIC) :doc "LAPIC represents the Local APIC instance\n"} LAPIC


    ^{:line 64 :tag int :doc "init represents the last initialized CPU index\n"} init

    ^{:line 66 :tag Features :doc "features\n"} features

    ^{:line 68 :tag uint32 :doc "core frequency in Hz\n"} freq))



(go/func ^:extern exit "defined in amd64.s\n" [int32])
(go/func ^:extern halt [])


(go/func ^:extern Fault "Fault generates a triple fault.\n" [])


^{:go/end 84} (go/method DefaultIdleGovernor "DefaultIdleGovernor is the default CPU idle time management function\n" [^{:tag (* CPU)} cpu ^int64 pollUntil]
  ;; we have nothing to do forever
  (when (== pollUntil math/MaxInt64)
    (.WaitInterrupt cpu)))





^{:go/end 108} (go/method Init "Init performs initialization of an AMD64 bootstrap processor (BSP) instance\n(see [CPU.InitSMP] for AP initialization).\n" [^{:tag (* CPU)} cpu]
  (set! goos/Exit exit)
  (set! goos/Idle (.-DefaultIdleGovernor cpu))

  (set! goos/ProcID ^{:go/breaks [2] :go/end 94} (fn ^uint64 []
      0))


  ;; Local APIC
  (set! (.-LAPIC cpu) (addr ^{:go/breaks [2]} (lit lapic/LAPIC
        :Base LAPIC_BASE)))


  (.initFeatures cpu)
  (.initTimers cpu)

  ;; reset SMP semaphore/task
  (reg/Write64 (+ taskAddress 0x00) 0)
  (reg/Write64 (+ taskAddress 0x08) 0)
  (reg/Write64 (+ taskAddress 0x10) 0))



^{:go/end 113} (go/method Name "Name returns the CPU identifier.\n" ^string [^{:tag (* CPU)} cpu]
  (runtime/CPU))



^{:go/end 118} (go/method Reset "Reset resets the CPU pin via 8042 keyboard controller pulse.\n" [^{:tag (* CPU)} cpu]
  (reg/Out8 KBD_PORT 0xfe))

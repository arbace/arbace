;; Package lapic implements a driver for the Intel Local (LAPIC) Advanced
;; Programmable Interrupt Controllers adopting the following reference
;; specifications:
;;   - Intel® 64 and IA-32 Architectures Software Developer’s Manual - Volume 3A - Chapter 10
;;
;; This package is only meant to be used with `GOOS=tamago` as
;; supported by the TamaGo framework for bare metal Go, see
;; https://github.com/usbarmory/tamago.
(in-ns 'go.github_com.usbarmory.tamago.amd64.lapic) (go/file "lapic.go" :doc "Package lapic implements a driver for the Intel Local (LAPIC) Advanced\nProgrammable Interrupt Controllers adopting the following reference\nspecifications:\n  - Intel® 64 and IA-32 Architectures Software Developer’s Manual - Volume 3A - Chapter 10\n\nThis package is only meant to be used with `GOOS=tamago` as\nsupported by the TamaGo framework for bare metal Go, see\nhttps://github.com/usbarmory/tamago.\n" :imports [


    ^{:line 20} [bits "github.com/usbarmory/tamago/bits"]
    ^{:line 21} [reg "github.com/usbarmory/tamago/internal/reg"]])



(go/const "LAPIC registers\n"
  ^{:line 26} [^{:val 32} LAPIC_ID 0x20]
  ^{:line 27} [^{:val 24} ID 24]

  ^{:line 29} [^{:val 48} LAPIC_VER 0x30]
  ^{:line 30} [^{:val 16} VER_ENTRIES 16]

  ^{:line 32} [^{:val 176} LAPIC_EOI 0xb0]

  ^{:line 34} [^{:val 240} LAPIC_SVR 0xf0]
  ^{:line 35} [^{:val 8} SVR_ENABLE 8]

  ^{:line 37} [^{:val 768} LAPIC_ICRL 0x300]
  ^{:line 38} [^{:val 784} LAPIC_ICRH 0x310]

  ^{:line 40} [^{:val 18} ICR_DST 18]
  ^{:line 41} [^{:val 262144} ICR_DST_SELF (<< 2r01 ICR_DST)]
  ^{:line 42} [^{:val 524288} ICR_DST_ALL (<< 2r10 ICR_DST)]
  ^{:line 43} [^{:val 786432} ICR_DST_REST (<< 2r11 ICR_DST)]

  ^{:line 45} [^{:val 14} ICR_INIT 14]
  ^{:line 46} [^{:val 12} ICR_DLV_STATUS 12]
  ^{:line 47} [^{:val 8} ICR_DLV 8]

  ^{:line 49} [^{:val 1536} ICR_DLV_SIPI (<< 2r110 ICR_DLV)]
  ^{:line 50} [^{:val 1280} ICR_DLV_INIT (<< 2r101 ICR_DLV)]
  ^{:line 51} [^{:val 1024} ICR_DLV_NMI (<< 2r100 ICR_DLV)]
  ^{:line 52} [^{:val 512} ICR_DLV_SMI (<< 2r010 ICR_DLV)]
  ^{:line 53} [^{:val 256} ICR_DLV_LOW (<< 2r001 ICR_DLV)]
  ^{:line 54} [^{:val 0} ICR_DLV_IRQ (<< 2r000 ICR_DLV)]

  ^{:line 56} [^{:val 800} LAPIC_LVT_TIMER 0x320]
  ^{:line 57} [^{:val 17} TIMER_MODE 17]
  ^{:line 58} [^{:val 0} TIMER_IRQ 0]

  ^{:line 60} [^{:val 0} TIMER_MODE_ONE_SHOT 2r00]
  ^{:line 61} [^{:val 1} TIMER_MODE_PERIODIC 2r01]
  ^{:line 62} [^{:val 2} TIMER_MODE_TSC_DEADLINE 2r10])



(go/type LAPIC "LAPIC represents a Local APIC instance.\n" (struct

    ^{:line 68 :tag uint32 :doc "Base register\n"} Base))



^{:go/end 74} (go/method ID "ID returns the LAPIC identification register.\n" ^uint32 [^{:tag (* LAPIC)} io]
  (reg/GetN (+ (.-Base io) LAPIC_ID) ID 0xf))



^{:go/end 79} (go/method Version "Version returns the LAPIC version register.\n" ^uint32 [^{:tag (* LAPIC)} io]
  (reg/Read (+ (.-Base io) LAPIC_VER)))



^{:go/end 85} (go/method Entries "Entries returns the size of the LAPIC local vector table.\n" ^int [^{:tag (* LAPIC)} io]
  (let [maxIndex (reg/GetN (+ (.-Base io) LAPIC_VER) VER_ENTRIES 0xff)]
    (+ (conv int maxIndex) 1)))



^{:go/end 94} (go/method Enable "Enable enables the Local APIC.\n" [^{:tag (* LAPIC)} io]
  (let [svr (reg/Read (+ (.-Base io) LAPIC_SVR))]
    (bits/Set (addr svr) SVR_ENABLE)

    ;; no reg.Set as we do not emulate atomic MMIO ops under SEV-SNP
    (reg/Write (+ (.-Base io) LAPIC_SVR) svr)))



^{:go/end 99} (go/method Disable "Disable disables the Local APIC.\n" [^{:tag (* LAPIC)} io]
  (reg/Clear (+ (.-Base io) LAPIC_SVR) SVR_ENABLE))



^{:go/end 104} (go/method ClearInterrupt "ClearInterrupt signals the end of an interrupt handling routine.\n" [^{:tag (* LAPIC)} io]
  (reg/Write (+ (.-Base io) LAPIC_EOI) 0))



^{:go/end 115} (go/method IPI "IPI sends an Inter-Processor Interrupt (IPI).\n" [^{:tag (* LAPIC)} io ^int apicid ^int id ^int flags]
  (let [icrh (reg/Read (+ (.-Base io) LAPIC_ICRH))]
    (bits/SetN (addr icrh) ID 0xff (conv uint32 apicid))

    ;; no reg.Set as we do not emulate atomic MMIO ops under SEV-SNP
    (reg/Write (+ (.-Base io) LAPIC_ICRH) icrh)
    (reg/Write (+ (.-Base io) LAPIC_ICRL) (bit-or (conv uint32 (bit-and flags 0xffffff00)) (conv uint32 (bit-and id 0xff))))
    (reg/Wait (+ (.-Base io) LAPIC_ICRL) ICR_DLV_STATUS 1 0)))



^{:go/end 125} (go/method SetTimer "SetTimer configures the LAPIC LVT Timer with the argument vector and mode.\n" [^{:tag (* LAPIC)} io ^int id ^int mode]
  (let [^uint32 val (zero uint32)]

    (bits/SetN (addr val) TIMER_IRQ 0xff (conv uint32 id))
    (bits/SetN (addr val) TIMER_MODE 2r11 (conv uint32 mode))

    (reg/Write (+ (.-Base io) LAPIC_LVT_TIMER) val)))

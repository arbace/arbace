(in-ns 'go.github_com.usbarmory.tamago.amd64) (go/file "exception.go" :imports [


    ^{:line 12} [goos "runtime/goos"]

    ^{:line 14} [exception "github.com/usbarmory/tamago/internal/exception"]])


(go/var
  ^{:line 18} [^uintptr isr]
  ^{:line 19} [^uintptr eip]
  ^{:line 20} [^bool isThrowing])


^{:go/end 31} (go/func currentVectorNumber [] :results [^int id]
  (set! id (conv int (- isr irqHandlerAddr)))

  (when (>= id 0)
    (set! id (/ id callSize)))


  (return))




^{:go/end 44} (go/func DefaultExceptionHandler "DefaultExceptionHandler handles an exception by printing its vector and\nprocessor mode before panicking.\n" []
  (when isThrowing
    (goos/Exit 1))


  (set! isThrowing true)

  (print "exception: vector " (currentVectorNumber) " \n")
  (exception/Throw eip))






(go/var ^{:doc "SystemExceptionHandler allows to override the default exception handler\nexecuted at any exception by the table returned by SystemVectorTable(),\nwhich is used by default when initializing the CPU instance (e.g.\nCPU.Init()).\n"} SystemExceptionHandler DefaultExceptionHandler)



^{:go/end 61} (go/method EnableExceptions "EnableExceptions initializes handling of processor exceptions through\nDefaultExceptionHandler().\n" [^{:tag (* CPU)} cpu]
  ;; Handle processor exceptions, stop before VMM Communication to
  ;; preserve original handler if present (e.g. under UEFI+SEV-SNP).
  (setIDT 0 28)

  ;; user defined interrupts
  (setIDT 32 255))

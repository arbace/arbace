(go/const "CPUID function numbers\n\n(Intel® Architecture Instruction Set Extensions\nand Future Features Programming Reference\n1.5 CPUID INSTRUCTION).\n"
  ^{:line 24} [^{:val 0} CPUID_VENDOR 0x00]
  ^{:line 25} [^{:val 1818588270} CPUID_VENDOR_ECX_INTEL 0x6c65746e] ; GenuineI(ntel)
  ^{:line 26} [^{:val 1145913699} CPUID_VENDOR_ECX_AMD 0x444d4163] ; Authenti(cAMD)


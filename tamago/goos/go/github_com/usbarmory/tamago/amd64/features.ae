  ^{:line 78} [^{:val 1263947009} MSR_KVM_SYSTEM_TIME_NEW 0x4b564d01])




(go/type Features "Features represents the processor capabilities detected through the CPUID\ninstruction.\n" (struct


    ^{:line 86 :tag bool :doc "HwPstate indicates whether Hardware P-State control MSRs are\nsupported.\n"} HwPstate



    ^{:line 90 :tag bool :doc "TSCInvariant indicates whether the Time Stamp Counter is guaranteed\nto be at constant rate.\n"} TSCInvariant


    ^{:line 93 :tag bool :doc "TSCDeadline indicates whether TSC-Deadline Mode of operation is\navailable for the local-APIC timer to support [CPU.SetAlarm].\n"} TSCDeadline


    ^{:line 96 :tag bool :doc "KVM indicates whether a Kernel-base Virtual Machine is detected.\n"} KVM

    ^{:line 98 :tag uint32 :doc "KVMClockMSR returns the kvmclock Model Specific Register.\n"} KVMClockMSR))



(go/func ^:extern cpuid "defined in features.s\n" [^uint32 eaxArg ^uint32 ecxArg] :results [^uint32 eax ^uint32 ebx ^uint32 ecx ^uint32 edx])


^{:go/end 107} (go/method CPUID "CPUID returns the processor capabilities.\n" [^{:tag (* CPU)} cpu ^uint32 leaf ^uint32 subleaf] :results [^uint32 eax ^uint32 ebx ^uint32 ecx ^uint32 edx]
  (cpuid leaf subleaf))



^{:go/end 112} (go/method MSR "MSR returns a machine-specific register.\n" [^{:tag (* CPU)} cpu ^uint64 addr] :results [^uint64 val]
  (reg/ReadMSR addr))


^{:go/end 136} (go/method initFeatures [^{:tag (* CPU)} cpu]
  (let [(values _ _ _ apmFeatures) (cpuid CPUID_APM 0)]
    (set! (.-HwPstate (.-features cpu)) (bits/Get (addr apmFeatures) APM_HW_PSTATE))
    (set! (.-TSCInvariant (.-features cpu)) (bits/Get (addr apmFeatures) APM_TSC_INVARIANT))

    (let [(values _ _ cpuFeatures _) (cpuid CPUID_INFO 0)]
      (set! (.-TSCDeadline (.-features cpu)) (bits/Get (addr cpuFeatures) INFO_TSC_DEADLINE))

      (when [(values _ kvmk _ _) (cpuid CPUID_KVM_SIGNATURE 0)] (!= kvmk KVM_SIGNATURE)
        (return))


      (set! (.-KVM (.-features cpu)) true)
      (let [(values kvmFeatures _ _ _) (cpuid CPUID_KVM_FEATURES 0)]

        (when (bits/Get (addr kvmFeatures) FEATURES_CLOCKSOURCE)
          (set! (.-KVMClockMSR (.-features cpu)) MSR_KVM_SYSTEM_TIME))


        (when (bits/Get (addr kvmFeatures) FEATURES_CLOCKSOURCE2)
          (set! (.-KVMClockMSR (.-features cpu)) MSR_KVM_SYSTEM_TIME_NEW))))))




^{:go/end 141} (go/method Features "Features returns the processor capabilities.\n" ^{:tag (* Features)} [^{:tag (* CPU)} cpu]
  (addr (.-features cpu)))



^{:go/end 166} (go/func NumCPU "NumCPU returns the number of logical CPUs available on the platform.\n" [] :results [^int n]
  (let [(values _ _ ecx _) (cpuid CPUID_VENDOR 0)]

    (switch ecx
      (case [CPUID_VENDOR_ECX_AMD]
        ;; AMD64 Architecture Programmer’s Manual
        ;; Volume 3 - E4.7
        (let [(values _ _ ecx _) (cpuid CPUID_AMD_PROC 0)]
          (set! n (+ (conv int (bits/GetN (addr ecx) AMD_PROC_NC 0xff)) 1))))
      (case [CPUID_VENDOR_ECX_INTEL]
        ;; Intel® Architecture Instruction Set Extensions and Future
        ;; Features Programming Reference
        ;; 5.1.12 x2APIC Features / Processor Topology (Function 0Bh)
        (let [(values _ ebx _ _) (cpuid CPUID_INTEL_APIC 1)] ; core sublevel
          (set! n (conv int (bits/GetN (addr ebx) INTEL_APIC_LP 0xffff))))))


    (when (== n 0)
      (set! n (runtime/NumCPU)))


    (return)))

  ^{:line 42} [^{:val 7} APM_HW_PSTATE 7])






(go/const "CPUID function numbers\n\n(AMD64 Architecture Programmer’s Manual\nVolume 3 - Appendix E.4 Extended Feature Function Numbers.\n"
  ^{:line 50} [^{:val 2147483656} CPUID_AMD_PROC 0x80000008]
  ^{:line 51} [^{:val 0} AMD_PROC_NC 0]

  ^{:line 53} [^{:val 2147483679} CPUID_AMD_ENCM 0x8000001f])





(go/const "KVM CPUID function numbers\n\n(https://docs.kernel.org/virt/kvm/x86/cpuid.html)\n"
  ^{:line 60} [^{:val 1073741824} CPUID_KVM_SIGNATURE 0x40000000]
  ^{:line 61} [^{:val 1263359563} KVM_SIGNATURE 0x4b4d564b] ; "KVMK"

  ^{:line 63} [^{:val 1073741825} CPUID_KVM_FEATURES 0x40000001]
  ^{:line 64} [^{:val 0} FEATURES_CLOCKSOURCE 0]
  ^{:line 65} [^{:val 3} FEATURES_CLOCKSOURCE2 3]

  ^{:line 67} [^{:val 1073741840} CPUID_KVM_TSC_KHZ 0x40000010])




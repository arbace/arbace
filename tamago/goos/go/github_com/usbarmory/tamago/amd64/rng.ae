(in-ns 'go.github_com.usbarmory.tamago.amd64) (go/file "rng.go" :imports [


    ^{:line 12} [_ "unsafe"]

    ^{:line 14} [rng "github.com/usbarmory/tamago/internal/rng"]])



(go/func ^:extern rdrand "defined in rng.s\n" ^uint32 [])


^{:go/end 28} (go/func GetRandomData "GetRandomData returns len(b) random bytes gathered from the RDRAND instruction.\n" [^{:tag (slice byte)} b]
  (let [read 0
      ^{:line 23} need (len b)]

    (while (< read need)
      (set! read (rng/Fill b read (rdrand))))))




^{:go/end 33} (go/func ^{:go/linkname "initRNG runtime/goos.InitRNG"} initRNG []
  (set! rng/GetRandomDataFn GetRandomData))

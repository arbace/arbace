(in-ns 'go.github_com.usbarmory.tamago.arm64) (go/file "exception.go" :imports [


    ^{:line 12} [goos "runtime/goos"]
    ^{:line 13} [unsafe "unsafe"]

    ^{:line 15} [exception "github.com/usbarmory/tamago/internal/exception"]
    ^{:line 16} [reg "github.com/usbarmory/tamago/internal/reg"]])


(go/const
  ^{:line 20} [^{:val 1476395090} vecTableLoad 0x58000052] ; ldr x18, #8
  ^{:line 21} [^{:val 3592356416} vecTableJump 0xd61f0240]) ; br x18



(go/func ^:extern set_vbar "defined in exception.s\n" [^uint64 addr])
(go/func ^:extern read_el ^uint64 [])
(go/func ^:extern handleException [])
(go/func ^:extern handleInterrupt [])

(go/type exceptionHandler (func []))

^{:go/end 34} (go/method vector ^uint64 [^exceptionHandler fn]
  ^{:line 33} @@(conv (* (* uint64)) (conv unsafe/Pointer (addr fn))))


(go/var ^bool isThrowing)



^{:go/end 49} (go/func DefaultExceptionHandler "DefaultExceptionHandler handles an exception by printing its vector and\nprocessor mode before panicking.\n" [^uintptr pc]
  (when isThrowing
    (goos/Exit 1))


  (set! isThrowing true)

  (print "EL" (>> (conv int (bit-and (read_el) 2r1100)) 2) " exception\n")
  (exception/Throw pc))



(go/var ^{:doc "SystemExceptionHandler allows to override the default exception handler.\n"} SystemExceptionHandler DefaultExceptionHandler)

^{:go/end 56} (go/func systemException [^uintptr pc]
  (SystemExceptionHandler pc))


^{:go/end 62} (go/func addJump [^uint64 addr ^exceptionHandler fn]
  (reg/Write64 addr vecTableLoad)
  (reg/Write64 (+ addr 4) vecTableJump)
  (reg/Write64 (+ addr 8) (.vector fn)))


^{:go/end 79} (go/func addJumps [^uint64 addr]
  ;; Synchronous Exception
  (addJump addr handleException)

  ;; IRQ or vIRQ
  (set! addr + 0x80)
  (addJump addr handleInterrupt)

  ;; FIQ or vFIQ
  (set! addr + 0x80)
  (addJump addr handleInterrupt)

  ;; SError or vSError
  (set! addr + 0x80)
  (addJump addr handleException))



^{:go/end 96} (go/method ^:go/nosplit initVectorTable [^{:tag (* CPU)} cpu]
  ;; 2048-bytes alignment is required
  (let [vectorTable (conv uint64 goos/RamStart)]

    ;; initialize jump tables
    ;; Table D1-7 ARM Architecture Reference Manual ARMv8

    ;; EL0
    (addJumps vectorTable)
    ;; ELx, x>0
    (addJumps (+ vectorTable 0x200))

    ;; set vector base address register
    (set_vbar vectorTable)))

(in-ns 'go.github_com.usbarmory.tamago.arm64) (go/file "irq.go" :imports [


    ^{:line 12} [os "os"]
    ^{:line 13} [signal "os/signal"]
    ^{:line 14} [syscall "syscall"]])




(go/const ^{:val 4 :doc "IRQ_SIGNAL represents the `os/signal` used to signal and service\ninterrupts.\n"} IRQ_SIGNAL syscall/SIGTRAP)


(go/func ^:extern irq_enable "defined in irq.s\n" [])
(go/func ^:extern irq_disable [])
(go/func ^:extern wfi [])


^{:go/end 29} (go/method EnableInterrupts "EnableInterrupts unmasks IRQ interrupts.\n" [^{:tag (* CPU)} cpu]
  (irq_enable))



^{:go/end 34} (go/method DisableInterrupts "DisableInterrupts masks IRQ interrupts.\n" [^{:tag (* CPU)} cpu]
  (irq_disable))



^{:go/end 39} (go/method WaitInterrupt "WaitInterrupt suspends execution until an interrupt is received.\n" [^{:tag (* CPU)} cpu]
  (wfi))





^{:go/end 59} (go/method ServiceInterrupts "ServiceInterrupts puts the calling goroutine in wait state, its execution is\nresumed when an IRQ exception is received, an argument function can be set\nto service signaled interrupts (see gic package).\n" [^{:tag (* CPU)} cpu ^{:tag (func [])} isr]
  (when (== isr nil)
    (set! isr ^{:go/end 46} (fn [] (return))))


  (let [c (make (chan os/Signal) 1)]
    (signal/Notify c IRQ_SIGNAL)

    (while true
      ;; To avoid losing interrupts, re-enabling must happen only after we
      ;; are waiting.
      (go (irq_enable))
      (<! c)
      (isr))))

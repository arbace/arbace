;; Package gic implements a driver for the ARM Generic Interrupt Controller
;; (GICv3).
;;
;; The driver is based on the following reference specifications:
;;   - ARM IHI 0069G - ARM GIC Architecture Specification (v3 and v4)
;;
;; This package is only meant to be used with `GOOS=tamago GOARCH=arm` as
;; supported by the TamaGo framework for bare metal Go, see
;; https://github.com/usbarmory/tamago.
(in-ns 'go.github_com.usbarmory.tamago.arm64.gic) (go/file "gic.go" :doc "Package gic implements a driver for the ARM Generic Interrupt Controller\n(GICv3).\n\nThe driver is based on the following reference specifications:\n  - ARM IHI 0069G - ARM GIC Architecture Specification (v3 and v4)\n\nThis package is only meant to be used with `GOOS=tamago GOARCH=arm` as\nsupported by the TamaGo framework for bare metal Go, see\nhttps://github.com/usbarmory/tamago.\n" :imports [


    ^{:line 23} [time "time"]

    ^{:line 25} [reg "github.com/usbarmory/tamago/internal/reg"]])




(go/const "GIC Distributor register map\n(p519, Table 12-25 Distributor register map, ARM IHI 0069G).\n"
  ^{:line 31} [^{:val 0} GICD_CTLR 0x000]
  ^{:line 32} [^{:val 5} CTLR_ARE_NS 5]
  ^{:line 33} [^{:val 4} CTLR_ARE_S 4]
  ^{:line 34} [^{:val 0} CTLR_ENABLEGRP0 0]

  ^{:line 36} [^{:val 4} GICD_TYPER 0x004]
  ^{:line 37} [^{:val 0} TYPER_ITLINES 0]

  ^{:line 39} [^{:val 128} GICD_IGROUPR 0x0080]
  ^{:line 40} [^{:val 256} GICD_ISENABLER 0x0100]
  ^{:line 41} [^{:val 384} GICD_ICENABLER 0x0180]
  ^{:line 42} [^{:val 640} GICD_ICPENDR 0x0280]
  ^{:line 43} [^{:val 24832} GICD_IROUTER 0x6100])




(go/const "GIC Redistributor register map\n(p615, Table 12-27 Redistributor register map, ARM IHI 0069G).\n"

  ^{:line 50} [^{:val 0 :doc "Redistributor frames\n"} RD_BASE 0x00000]
  ^{:line 51} [^{:val 65536} SGI_BASE 0x10000]

  ^{:line 53} [^{:val 20} GICR_WAKER (+ RD_BASE 0x0014)]
  ^{:line 54} [^{:val 2} WAKER_CHILDREN_ASLEEP 2]
  ^{:line 55} [^{:val 1} WAKER_PROCESSOR_SLEEP 1]

  ^{:line 57} [^{:val 65664} GICR_IGROUPR (+ SGI_BASE 0x0080)])


(go/const
  ^{:line 61} [^{:val 0} firstSGI 0] ; Software Generated Interrupts (SGI)
  ^{:line 62} [^{:val 16} firstPPI 16] ; Private Peripheral Interrupts (PPI)
  ^{:line 63} [^{:val 32} firstSPI 32] ;  Shared Peripheral Interrupts (SPI)
  ^{:line 64} [^{:val 1020} firstSIN 1020]) ;     Special Interrupt Numbers



(go/type GIC "GIC represents a Generic Interrupt Controller (GICv3) instance.\n" (struct

    ^{:line 70 :tag uint32 :doc "GIC Distributor base address\n"} GICD

    ^{:line 72 :tag uint32 :doc "GIC Redistributor base address\n"} GICR


    ^{:line 75 :tag uint64 :doc "core identifier\n"} mpidr))



(go/func ^:extern write_icc_sre_el1 "defined in gic.s\n" [^uint64 val])
(go/func ^:extern write_icc_igrpen0_el1 [^uint64 val])
(go/func ^:extern write_icc_pmr_el1 [^uint64 val])
(go/func ^:extern read_icc_iar0 ^uint64 [])
(go/func ^:extern read_mpidr_el1 ^uint64 [])
(go/func ^:extern write_icc_eoir0 [^uint64 val])


^{:go/end 133} (go/method Init "InitGIC initializes an ARM Generic Interrupt Controller (GICv3) instance.\n" [^{:tag (* GIC)} hw]
  (when (or (== (.-GICD hw) 0) (== (.-GICR hw) 0))
    (panic "invalid GIC instance"))


  ;; Mark CPU as being online
  (reg/Clear (+ (.-GICR hw) GICR_WAKER) WAKER_PROCESSOR_SLEEP)

  (when (not (reg/WaitFor (* 1 time/Second) (+ (.-GICR hw) GICR_WAKER) WAKER_CHILDREN_ASLEEP 1 0))
    (panic "could not wake GICR"))


  ;; Get the maximum number of external interrupt lines
  (let [itLinesNum (reg/GetN (+ (.-GICD hw) GICD_TYPER) TYPER_ITLINES 0x1f)]

    ;; Add a line for the 32 internal interrupts
    (set! itLinesNum + 1)

    (for [n (conv uint32 0)] (< n itLinesNum) (inc! n)
      ;; Disable interrupts
      (let [addr (+ (.-GICD hw) GICD_ICENABLER (* 4 n))]
        (reg/Write addr 0xffffffff)

        ;; Clear pending interrupts
        (set! addr (+ (.-GICD hw) GICD_ICPENDR (* 4 n)))
        (reg/Write addr 0xffffffff)))


    ;; Enable system register interface
    (write_icc_sre_el1 1)

    ;; Unmask all interrupt priorities
    (write_icc_pmr_el1 0xff)

    ;; Enable Group0 interrupts (CPU interface)
    (write_icc_igrpen0_el1 1)

    ;; Enable Group0 interrupts (Distributor)
    (reg/Set (+ (.-GICD hw) GICD_CTLR) CTLR_ENABLEGRP0)

    ;; Enable affinity routing
    (reg/Set (+ (.-GICD hw) GICD_CTLR) CTLR_ARE_NS)
    (reg/Set (+ (.-GICD hw) GICD_CTLR) CTLR_ARE_S)

    ;; Cache core identifier
    (set! (.-mpidr hw) (read_mpidr_el1))))


^{:go/end 164} (go/method irq [^{:tag (* GIC)} hw ^int m ^bool enable]
  (when (== (.-GICD hw) 0)
    (return))


  (let [^uint32 off (zero uint32)
      ^{:line 141} n (conv uint32 (/ m 32))
      ^{:line 142} i (% m 32)]

    (if enable (do
        (if (< m firstSPI)
          (reg/Clear (+ (.-GICR hw) GICR_IGROUPR (* 4 n)) i)
          (do
            ;; route to core identified at initialization
            (reg/Write64 (+ (conv uint64 (+ (.-GICD hw) GICD_IROUTER)) (conv uint64 (* 8 m))) (.-mpidr hw))
            ;; assign to Group0
            (reg/Clear (+ (.-GICD hw) GICD_IGROUPR (* 4 n)) i)))


        (set! off + GICD_ISENABLER))

      (set! off + GICD_ICENABLER))


    (if (< m firstSPI)
      (reg/SetTo (+ (.-GICR hw) SGI_BASE off (* 4 n)) i true)

      (reg/SetTo (+ (.-GICD hw) off (* 4 n)) i true))))





^{:go/end 170} (go/method EnableInterrupt "EnableInterrupt enables forwarding of the corresponding interrupt to the CPU\nand configures its group status (Secure: Group 0, Non-Secure: Group 1).\n" [^{:tag (* GIC)} hw ^int id]
  (.irq hw id true))




^{:go/end 176} (go/method DisableInterrupt "DisableInterrupt disables forwarding of the corresponding interrupt to the\nCPU.\n" [^{:tag (* GIC)} hw ^int id]
  (.irq hw id false))



^{:go/end 191} (go/method GetInterrupt "GetInterrupt obtains and acknowledges a signaled interrupt.\n" [^{:tag (* GIC)} hw] :results [^int id]
  (when (== (.-GICD hw) 0)
    (return))


  (let [m (bit-and (read_icc_iar0) 0xffffff)]

    (when (< m firstSIN)
      (write_icc_eoir0 m))


    (conv int m)))

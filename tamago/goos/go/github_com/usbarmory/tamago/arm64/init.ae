(in-ns 'go.github_com.usbarmory.tamago.arm64) (go/file "init.go" :imports [


    ^{:line 12} [_ "unsafe"]])






^{:go/end 29} (go/func ^{:go/linkname "Init runtime/goos.Hwinit0"} Init "Init takes care of the lower level initialization triggered before runtime\nsetup (pre World start).\n" []
  (fp_enable)

  ;; At start all memory is mapped as device memory, causing LDP/STP
  ;; instructions to require 8-byte alignment.
  ;;
  ;; To prevent faults, MMU initialization is done as soon as possible in
  ;; hwinit0, rather than in hwinit1.
  (let [cpu (addr (lit CPU))]
    (.InitMMU cpu)))

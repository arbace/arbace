(in-ns 'go.github_com.usbarmory.tamago.arm64) (go/file "cache.go" :imports [])


(go/func ^:extern cache_enable "defined in cache.s\n" [])
(go/func ^:extern cache_disable [])


^{:go/end 18} (go/method EnableCache "EnableCache activates the ARM instruction and data caches.\n" [^{:tag (* CPU)} cpu]
  (cache_enable))



^{:go/end 23} (go/method DisableCache "DisableCache disables the ARM instruction and data caches.\n" [^{:tag (* CPU)} cpu]
  (cache_disable))



^{:go/end 28} (go/method FlushTLBs "FlushTLBs flushes the ARM Translation Lookaside Buffers.\n" [^{:tag (* CPU)} cpu]
  (flush_tlb))

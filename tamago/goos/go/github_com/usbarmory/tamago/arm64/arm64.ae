;; Package arm64 provides support for ARM 64-bit architecture specific
;; operations.
;;
;; The following architectures/cores are supported/tested:
;;   - ARMv8-A / Cortex-A53 (single-core)
;;
;; This package is only meant to be used with `GOOS=tamago GOARCH=arm64` as
;; supported by the TamaGo framework for bare metal Go, see
;; https://github.com/usbarmory/tamago.
(in-ns 'go.github_com.usbarmory.tamago.arm64) (go/file "arm64.go" :doc "Package arm64 provides support for ARM 64-bit architecture specific\noperations.\n\nThe following architectures/cores are supported/tested:\n  - ARMv8-A / Cortex-A53 (single-core)\n\nThis package is only meant to be used with `GOOS=tamago GOARCH=arm64` as\nsupported by the TamaGo framework for bare metal Go, see\nhttps://github.com/usbarmory/tamago.\n" :imports [


    ^{:line 21} [math "math"]
    ^{:line 22} [goos "runtime/goos"]])



(go/type CPU "CPU instance\n" (struct

    ^{:line 28 :tag float64 :doc "Timer multiplier\n"} TimerMultiplier

    ^{:line 30 :tag int64 :doc "Timer offset in nanoseconds\n"} TimerOffset


    ^{:line 33 :tag uint64 :doc "see [CPU.Idle] and [CPU.IdleTime]\n"} idle))



(go/func ^:extern exit "defined in arm64.s\n" [int32])


^{:go/end 45} (go/method DefaultIdleGovernor "DefaultIdleGovernor is the default CPU idle time management function\n" [^{:tag (* CPU)} cpu ^int64 pollUntil]
  ;; we have nothing to do forever
  (when (== pollUntil math/MaxInt64)
    (.WaitInterrupt cpu)))




^{:go/end 53} (go/method Init "Init performs initialization of an ARM64 core instance.\n" [^{:tag (* CPU)} cpu]
  (set! goos/Exit exit)
  (set! goos/Idle (.-DefaultIdleGovernor cpu))

  (.initVectorTable cpu))

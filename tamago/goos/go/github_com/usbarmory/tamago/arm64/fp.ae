(in-ns 'go.github_com.usbarmory.tamago.arm64) (go/file "fp.go" :imports [])


(go/func ^:extern fp_enable "defined in fp.s\n" [])


^{:go/end 17} (go/method EnableFP "EnableFP activates floating-point operations.\n" [^{:tag (* CPU)} cpu]
  (fp_enable))

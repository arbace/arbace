^{:go/end 241} (go/method initL1Table "ARM Architecture Reference Manual ARMv8, for ARMv8-A architecture profile\nD5.3.1 Translation table level 0, level 1, and level 2 descriptor formats.\n" [^{:tag (* mmuMap)} m ^int entry ^uint64 ttbr ^uint64 section]

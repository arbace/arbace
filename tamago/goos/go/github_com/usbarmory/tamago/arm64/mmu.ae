  ^{:line 164} [^{:val 1} memoryAttributeIndex 1]

  ^{:line 166} [^{:val 1536} deviceAttributes (bit-or (<< 1 TTE_AF) TTE_OUTER_SH (<< TTE_AP_00 TTE_AP) (<< deviceAttributeIndex TTE_ATTR))]
  ^{:line 167} [^{:val 1796} memoryAttributes (bit-or (<< 1 TTE_AF) TTE_INNER_SH (<< TTE_AP_00 TTE_AP) (<< memoryAttributeIndex TTE_ATTR))])







^{:go/end 48} (go/func alignDown ^uint64 [^uint64 addr ^uint64 align]
  (bit-and-not addr (- align 1)))


^{:go/end 52} (go/func alignUp ^uint64 [^uint64 addr ^uint64 align]
  (alignDown (- (+ addr align) 1) align))


^{:go/end 79} (go/method init [^{:tag (* mmuMap)} m]
  (let [(values ramStart ramEnd) (runtime/MemRegion)
      (values textStart textEnd) (runtime/TextRegion)]

    (when (or (!= (bit-and ramStart (- pageTableSize 1)) 0) (!= (bit-and ramEnd (- pageTableSize 1)) 0))
      (panic "RAM region not 4KB aligned"))


    (set! (.-ramStart m) ramStart)
    (set! (.-ramEnd m) ramEnd)
    (set! (.-textStart m) (alignDown textStart pageTableSize))
    (set! (.-textEnd m) (alignUp textEnd pageTableSize))

    (when (or (< (.-textStart m) ramStart) (> (.-textEnd m) ramEnd))
      (panic "text region outside RAM"))


    (set! (.-arenaNext m) (+ ramStart pageTableArenaOffset))
    (set! (.-arenaEnd m) (.-textStart m))

    (when (>= (.-arenaNext m) (.-arenaEnd m))
      (panic "empty early page table space; link binary higher in RAM"))


    (return)))


^{:go/end 91} (go/method alloc [^{:tag (* mmuMap)} m] :results [^uint64 addr]
  (set! addr (.-arenaNext m))

  (when (> (+ addr pageTableSize) (.-arenaEnd m))
    (panic "out of early page table space; link binary higher in RAM"))


  (set! (.-arenaNext m) + pageTableSize)

  (return))


^{:go/end 112} (go/method classifyBlock [^{:tag (* mmuMap)} m ^uint64 addr ^uint64 end] :results [^mappingAction action]
  (switch
    (case [(and (>= addr (.-ramStart m)) (<= end (.-textEnd m)))]
      ;; exception vector table
      (set! action mappingMemoryExec))
    (case [(and (>= addr (.-textEnd m)) (<= end (.-ramEnd m)))]
      ;; runtime memory
      (set! action mappingMemoryXN))
    (case [(and (>= addr (.-ramStart m)) (<= end (.-ramEnd m)))]
      ;; text/runtime boundary cross
      (set! action mappingSplit))
    (case [(and (< addr (.-ramEnd m)) (> end (.-ramStart m)))]
      ;; RAM boundary cross
      (set! action mappingSplit))
    (default
      (set! action mappingDevice)))


  (return))


^{:go/end 123} (go/method classifyPage [^{:tag (* mmuMap)} m ^uint64 addr] :results [^mappingAction action]
  (let [end (+ addr pageTableSize)]
    (set! action (.classifyBlock m addr end))

    (when (== action mappingSplit)
      (panic "MMU boundary is not 4KB aligned"))


    (return)))


^{:go/end 136} (go/func writeMapping [^uint64 page ^uint64 addr ^uint64 memoryRegion ^uint64 deviceRegion ^mappingAction action]
  (switch action
    (case [mappingMemoryExec]
      (reg/Write64 page (bit-or addr memoryRegion)))
    (case [mappingMemoryXN]
      (reg/Write64 page (bit-or addr memoryRegion TTE_EXECUTE_NEVER)))
    (case [mappingDevice]
      (reg/Write64 page (bit-or addr deviceRegion TTE_EXECUTE_NEVER)))
    (default
      (panic "invalid MMU mapping action"))))








(go/const "ARM Architecture Reference Manual ARMv8, for ARMv8-A architecture profile\nD12.2.103 TCR_EL1, Translation Control Register (EL1).\n"
  ^{:line 188} [^{:val 32} TCR_IPS 32]
  ^{:line 189} [^{:val 29} TCR_TBID 29]
  ^{:line 190} [^{:val 23} TCR_EPD1 23]

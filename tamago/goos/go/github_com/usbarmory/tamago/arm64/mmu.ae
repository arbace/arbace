^{:go/end 328} (go/method InitMMU "InitMMU initializes translation tables for all available memory with a flat\nmapping.\n\nThe first 4096 bytes (0x00000000 - 0x00001000) are flagged as invalid to\ntrap null pointers.\n\nAll available memory is marked as non-executable except for the range\nreturned by runtime.TextRegion().\n" [^{:tag (* CPU)} cpu]
  (let [m (addr (lit mmuMap))]
    (.init m)

    (let [l1pageTableStart (+ (.-ramStart m) l1pageTableOffset)
        ^{:line 296} l2pageTableStart (+ (.-ramStart m) l2pageTableOffset)
        ^{:line 297} l3pageTableStart (+ (.-ramStart m) l3pageTableOffset)

        ;; Map the first L1 entry to an L2 table.
        ^{:line 300} tte (bit-or l2pageTableStart TTE_TABLE)]
      (reg/Write64 l1pageTableStart tte)

      ;; Map the first L2 entry to an L3 table to trap null pointers within
      ;; the smallest possible section (4KB starting from 0x00000000).
      (set! tte (bit-or l3pageTableStart TTE_TABLE))
      (reg/Write64 l2pageTableStart tte)

      ;; set first L3 entry as invalid
      (reg/Write64 l3pageTableStart 0)

      ;; set remaining entries with flat mapping
      (.initL1Table m 1 l1pageTableStart 0)
      (.initL2Table m 1 l2pageTableStart 0)
      (.initL3Table m 1 l3pageTableStart 0)

      ;; set memory region attributes
      ;;   * attr0: device
      ;;   * attr1: memory
      (write_mair_el1
        (bit-or (<< MemoryRegion (* 8 memoryAttributeIndex))
          (<< DeviceRegion (* 8 deviceAttributeIndex))))


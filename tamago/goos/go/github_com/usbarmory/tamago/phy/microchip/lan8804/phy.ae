;; Package lan8804 implements a driver for the Microchip LAN8804/LAN8814
;; Gigabit Ethernet PHYs adopting the following reference specifications:
;;   - Microchip - LAN8804D/LAN8814D GPHY Register Definitions - DS00004286D
;;   - Microchip - LAN8804D Datasheet - DS00003591K
(in-ns 'go.github_com.usbarmory.tamago.phy.microchip.lan8804) (go/file "phy.go" :doc "Package lan8804 implements a driver for the Microchip LAN8804/LAN8814\nGigabit Ethernet PHYs adopting the following reference specifications:\n  - Microchip - LAN8804D/LAN8814D GPHY Register Definitions - DS00004286D\n  - Microchip - LAN8804D Datasheet - DS00003591K\n" :imports [


    ^{:line 16} [errors "errors"]
    ^{:line 17} [fmt "fmt"]
    ^{:line 18} [time "time"]

    ^{:line 20} [bits "github.com/usbarmory/tamago/bits"]
    ^{:line 21} [phy "github.com/usbarmory/tamago/phy"]])



(go/const "PHY registers\n"
  ^{:line 26} [^{:val 0} BASIC_CONTROL 0x00]
  ^{:line 27} [^{:val 1} BASIC_STATUS 0x01]
  ^{:line 28} [^{:val 2} PHY_ID_1 0x02]
  ^{:line 29} [^{:val 3} PHY_ID_2 0x03]
  ^{:line 30} [^{:val 22} EP_ACCESS_CTRL 0x16]
  ^{:line 31} [^{:val 23} EP_ACCESS_DATA 0x17]
  ^{:line 32} [^{:val 31} CONTROL 0x1f]

  ^{:line 34} [^{:val 15} CTRL_RESET 15]
  ^{:line 35} [^{:val 12} CTRL_ANEG_ENABLE 12]
  ^{:line 36} [^{:val 9} CTRL_ANEG_RESTART 9]

  ^{:line 38} [^{:val 2} STATUS_LINK 2]
  ^{:line 39} [^{:val 5} STATUS_ANEG_COMPLETE 5]

  ^{:line 41} [^{:val 14} EP_FUNCTION 14]
  ^{:line 42} [^{:val 0} EP_INDEX 0]

  ^{:line 44} [^{:val 0} EP_ADDRESS 0]
  ^{:line 45} [^{:val 1} EP_DATA 1]

  ^{:line 47} [^{:val 6} CONTROL_SPEED_1000 6]
  ^{:line 48} [^{:val 5} CONTROL_SPEED_100 5]
  ^{:line 49} [^{:val 4} CONTROL_SPEED_10 4]
  ^{:line 50} [^{:val 3} CONTROL_DUPLEX 3])



(go/const ^{:val 100000000 :doc "Timeout is the default timeout for PHY operations.\n"} Timeout (* 100 time/Millisecond))


(go/type Status "Status represents the resolved PHY link state.\n" (struct
    ^{:line 58 :tag bool} Link
    ^{:line 59 :tag bool} AutoNegotiationComplete
    ^{:line 60 :tag int} Speed
    ^{:line 61 :tag bool} FullDuplex))



(go/type PHY "PHY represents a LAN8804/LAN8814 PHY port.\n" (struct

    ^{:line 67 :tag time/Duration :doc "Timeout for PHY operations\n"} Timeout

    ^{:line 69 :tag phy/MIIM} miim
    ^{:line 70 :tag int} pa
    ^{:line 71 :tag int} speed))



^{:go/end 89} (go/method Init "Init initializes a LAN8804/LAN8814 PHY instance for register access.\n" [^{:tag (* PHY)} hw ^int addr ^phy/MIIM miim] :results [^error err]
  (when (or (== miim nil) (< addr 0) (> addr 0x1f))
    (return (errors/New "invalid PHY instance")))


  (set! (.-miim hw) miim)
  (set! (.-pa hw) addr)
  (set! (.-speed hw) 0)

  (when (== (.-Timeout hw) 0)
    (set! (.-Timeout hw) Timeout))


  (return))


^{:go/end 97} (go/method read [^{:tag (* PHY)} hw ^int address] :results [^uint16 data ^error err]
  (when (== (.-miim hw) nil)
    (return 0 (errors/New "invalid PHY instance")))


  (.ReadPHYRegister (.-miim hw) (.-pa hw) address))


^{:go/end 105} (go/method write [^{:tag (* PHY)} hw ^int address ^uint16 data] :results [^error err]
  (when (== (.-miim hw) nil)
    (return (errors/New "invalid PHY instance")))


  (.WritePHYRegister (.-miim hw) (.-pa hw) address data))


^{:go/end 125} (go/method selectExtended [^{:tag (* PHY)} hw ^int page ^uint16 address] :results [^error err]
  (when (or (< page 0) (> page 0x1f))
    (return (errors/New "invalid extended page")))


  (let [ctrl (bit-or (<< EP_ADDRESS EP_FUNCTION) (<< page EP_INDEX))]

    (when [(set! err (.write hw EP_ACCESS_CTRL (conv uint16 ctrl)))] (!= err nil)
      (return))


    (when [(set! err (.write hw EP_ACCESS_DATA address))] (!= err nil)
      (return))


    (set! ctrl (bit-or (<< EP_DATA EP_FUNCTION) (<< page EP_INDEX)))

    (.write hw EP_ACCESS_CTRL (conv uint16 ctrl))))



^{:go/end 134} (go/method ReadExtendedRegister "ReadExtendedRegister reads a vendor-specific Extended Page register.\n" [^{:tag (* PHY)} hw ^int page ^uint16 address] :results [^uint16 data ^error err]
  (when [(set! err (.selectExtended hw page address))] (!= err nil)
    (return))


  (.read hw EP_ACCESS_DATA))



^{:go/end 143} (go/method WriteExtendedRegister "WriteExtendedRegister writes a vendor-specific Extended Page register.\n" [^{:tag (* PHY)} hw ^int page ^uint16 address ^uint16 data] :results [^error err]
  (when [(set! err (.selectExtended hw page address))] (!= err nil)
    (return))


  (.write hw EP_ACCESS_DATA data))



^{:go/end 170} (go/method Reset "Reset performs a software hard reset and waits for its completion.\n" [^{:tag (* PHY)} hw] :results [^error err]
  (let [^uint16 control (zero uint16)]

    (when [(set! err (.write hw BASIC_CONTROL (<< 1 CTRL_RESET)))] (!= err nil)
      (return))


    (let [deadline (.Add (time/Now) (.-Timeout hw))]

      (while true
        (when [(set! (values control err) (.read hw BASIC_CONTROL))] (!= err nil)
          (return))


        (when (not (bits/Get16 (addr control) CTRL_RESET))
          (return))


        (when (.After (time/Now) deadline)
          (return (errors/New "reset timeout")))


        (time/Sleep time/Millisecond)))))




^{:go/end 185} (go/method Negotiate "Negotiate enables and restarts auto-negotiation.\n" [^{:tag (* PHY)} hw] :results [^error err]
  (let [^uint16 control (zero uint16)]

    (set! (.-speed hw) 0)

    (when [(set! (values control err) (.read hw BASIC_CONTROL))] (!= err nil)
      (return))


    (set! control bit-or (bit-or (<< 1 CTRL_ANEG_ENABLE) (<< 1 CTRL_ANEG_RESTART)))

    (.write hw BASIC_CONTROL control)))



^{:go/end 200} (go/method Identifier "Identifier returns the PHY identifier registers as one 32-bit value.\n" [^{:tag (* PHY)} hw] :results [^uint32 id ^error err]
  (let [(values ^uint16 high ^uint16 low) (zero uint16)]

    (when [(set! (values high err) (.read hw PHY_ID_1))] (!= err nil)
      (return))


    (when [(set! (values low err) (.read hw PHY_ID_2))] (!= err nil)
      (return))


    (return (bit-or (<< (conv uint32 high) 16) (conv uint32 low)) nil)))


^{:go/end 209} (go/method link [^{:tag (* PHY)} hw] :results [^uint16 basic ^error err]
  ;; STATUS_LINK is latch-low; the first read clears stale link state.
  (when [(set! (values _ err) (.read hw BASIC_STATUS))] (!= err nil)
    (return))


  (.read hw BASIC_STATUS))




^{:go/end 221} (go/method Link "Link reports whether the PHY link is up. The status register is read twice\nbecause its link bit is latched low.\n" [^{:tag (* PHY)} hw] :results [^bool up ^error err]
  (let [^uint16 basic (zero uint16)]

    (when [(set! (values basic err) (.link hw))] (!= err nil)
      (return))


    (return (bits/Get16 (addr basic) STATUS_LINK) nil)))



^{:go/end 260} (go/method Status "Status returns link, auto-negotiation, speed, and duplex state.\n" [^{:tag (* PHY)} hw] :results [^Status status ^error err]
  (let [(values ^uint16 basic ^uint16 control) (zero uint16)]

    (when [(set! (values basic err) (.link hw))] (!= err nil)
      (return))


    (set! (.-speed hw) 0)

    (set! (.-Link status) (bits/Get16 (addr basic) STATUS_LINK))
    (set! (.-AutoNegotiationComplete status) (bits/Get16 (addr basic) STATUS_ANEG_COMPLETE))

    (when (not (.-Link status))
      (return))


    (when [(set! (values control err) (.read hw CONTROL))] (!= err nil)
      (return))


    (set! (.-FullDuplex status) (bits/Get16 (addr control) CONTROL_DUPLEX))

    (switch
      (case [(bits/Get16 (addr control) CONTROL_SPEED_1000)]
        (set! (.-Speed status) 1000))
      (case [(bits/Get16 (addr control) CONTROL_SPEED_100)]
        (set! (.-Speed status) 100))
      (case [(bits/Get16 (addr control) CONTROL_SPEED_10)]
        (set! (.-Speed status) 10))
      (default
        (set! err (fmt/Errorf "invalid speed status %#x" control))))


    (set! (.-speed hw) (.-Speed status))

    (return)))



^{:go/end 265} (go/method Address "Address returns the PHY address passed at [PHY.Init].\n" ^int [^{:tag (* PHY)} hw]
  (.-pa hw))



^{:go/end 270} (go/method Speed "Speed returns the last resolved PHY link speed.\n" ^int [^{:tag (* PHY)} hw]
  (.-speed hw))

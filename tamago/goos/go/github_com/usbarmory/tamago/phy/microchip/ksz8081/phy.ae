;; Package ksz8081 implements a driver for the Microchip KSZ8081RNB Ethernet
;; Transceiver adopting the following specifications:
;;   - DS000002202C (01-09-18)
(in-ns 'go.github_com.usbarmory.tamago.phy.microchip.ksz8081) (go/file "phy.go" :doc "Package ksz8081 implements a driver for the Microchip KSZ8081RNB Ethernet\nTransceiver adopting the following specifications:\n  - DS000002202C (01-09-18)\n" :imports [


    ^{:line 15} [errors "errors"]

    ^{:line 17} [phy "github.com/usbarmory/tamago/phy"]])



(go/const "PHY registers\n"
  ^{:line 22} [^{:val 0} KSZ_CTRL 0x00]
  ^{:line 23} [^{:val 15} CTRL_RESET 15]
  ^{:line 24} [^{:val 13} CTRL_SPEED 13]
  ^{:line 25} [^{:val 8} CTRL_DUPLEX 8]

  ^{:line 27} [^{:val 27} KSZ_INT 0x1b]

  ^{:line 29} [^{:val 31} KSZ_PHYCTRL2 0x1f]
  ^{:line 30} [^{:val 15} CTRL2_HP_MDIX 15]
  ^{:line 31} [^{:val 7} CTRL2_RMII 7]
  ^{:line 32} [^{:val 4} CTRL2_LED 4])



(go/type PHY "PHY represents the KSZ8081 Ethernet PHY instance.\n" (struct
    ^{:line 37 :tag phy/MIIM} miim
    ^{:line 38 :tag int} pa
    ^{:line 39 :tag int} speed))



^{:go/end 58} (go/method Init "Init initializes the PHY and performs [PHY.Negotiate].\n" [^{:tag (* PHY)} hw ^int addr ^phy/MIIM miim] :results [^error err]
  (when (== miim nil)
    (return (errors/New "invalid PHY instance")))


  (set! (.-miim hw) miim)
  (set! (.-pa hw) addr)
  (set! (.-speed hw) 0)

  ;; software reset
  (when [(set! err (.WritePHYRegister (.-miim hw) (.-pa hw) KSZ_CTRL (<< 1 CTRL_RESET)))] (!= err nil)
    (return))


  (.Negotiate hw))




^{:go/end 86} (go/method Negotiate "Negotiate refreshes the PHY auto-negotiation status, currently only 100 Mbps\nAuto-Negotiation (Full-duplex) is supported.\n" [^{:tag (* PHY)} hw] :results [^error err]
  (set! (.-speed hw) 0)

  (when (== (.-miim hw) nil)
    (return (errors/New "invalid PHY instance")))


  ;; HP Auto MDI/MDI-X mode, RMII 50MHz, LEDs: Activity/Link
  (let [ctrl (bit-or (<< 1 CTRL2_HP_MDIX) (<< 1 CTRL2_RMII) (<< 1 CTRL2_LED))]

    (when [(set! err (.WritePHYRegister (.-miim hw) (.-pa hw) KSZ_PHYCTRL2 (conv uint16 ctrl)))] (!= err nil)
      (return))


    ;; 100 Mbps, Full-duplex
    (set! ctrl (bit-or (<< 1 CTRL_SPEED) (<< 1 CTRL_DUPLEX)))

    (when [(set! err (.WritePHYRegister (.-miim hw) (.-pa hw) KSZ_CTRL (conv uint16 ctrl)))] (!= err nil)
      (return))


    (set! (.-speed hw) 100)

    (return)))



^{:go/end 91} (go/method Address "Address returns the PHY address passed at [PHY.Init].\n" ^int [^{:tag (* PHY)} hw]
  (.-pa hw))



^{:go/end 96} (go/method Speed "Speed returns the PHY auto-negotiated speed.\n" ^int [^{:tag (* PHY)} hw]
  (.-speed hw))



^{:go/end 105} (go/method EnableInterrupts "EnableInterrupts enables all available transceiver interrupts.\n" [^{:tag (* PHY)} hw] :results [^error err]
  (when (== (.-miim hw) nil)
    (return (errors/New "invalid PHY instance")))


  (.WritePHYRegister (.-miim hw) (.-pa hw) KSZ_INT 0xff00))

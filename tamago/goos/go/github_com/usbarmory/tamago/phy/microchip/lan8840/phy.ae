;; Package lan8840 implements a driver for the Microchip LAN8840 Gigabit
;; Ethernet Transceiver adopting the following specifications:
;;   - DS00004727A (09-30-22)
(in-ns 'go.github_com.usbarmory.tamago.phy.microchip.lan8840) (go/file "phy.go" :doc "Package lan8840 implements a driver for the Microchip LAN8840 Gigabit\nEthernet Transceiver adopting the following specifications:\n  - DS00004727A (09-30-22)\n" :imports [


    ^{:line 15} [errors "errors"]
    ^{:line 16} [fmt "fmt"]
    ^{:line 17} [time "time"]

    ^{:line 19} [bits "github.com/usbarmory/tamago/bits"]
    ^{:line 20} [phy "github.com/usbarmory/tamago/phy"]])



(go/const "PHY registers\n"
  ^{:line 25} [^{:val 0} BASIC_CONTROL 0x00]
  ^{:line 26} [^{:val 1} BASIC_STATUS 0x01]
  ^{:line 27} [^{:val 2} PHY_ID_1 0x02]
  ^{:line 28} [^{:val 3} PHY_ID_2 0x03]
  ^{:line 29} [^{:val 4} PHY_ANEG_ADV 0x04]
  ^{:line 30} [^{:val 5} PHY_ANEG_LPA 0x05]
  ^{:line 31} [^{:val 9} PHY_1000_CTRL 0x09]
  ^{:line 32} [^{:val 10} PHY_1000_STATUS 0x0a]

  ^{:line 34} [^{:val 15} CTRL_RESET 15]
  ^{:line 35} [^{:val 12} CTRL_ANEG_ENABLE 12]
  ^{:line 36} [^{:val 9} CTRL_ANEG_RESTART 9]

  ^{:line 38} [^{:val 5} STATUS_ANEG_COMPLETE 5]
  ^{:line 39} [^{:val 2} STATUS_LINK 2]

  ^{:line 41} [^{:val 10} ANEG_LPA_1000_HALF 10]
  ^{:line 42} [^{:val 11} ANEG_LPA_1000_FULL 11]
  ^{:line 43} [^{:val 9} ANEG_ADV_1000_FULL 9]
  ^{:line 44} [^{:val 8} ANEG_ADV_1000_HALF 8]
  ^{:line 45} [^{:val 8} ANEG_ADV_100_FULL 8]
  ^{:line 46} [^{:val 7} ANEG_ADV_100_HALF 7]
  ^{:line 47} [^{:val 6} ANEG_ADV_10_FULL 6]
  ^{:line 48} [^{:val 5} ANEG_ADV_10_HALF 5])



(go/const ^{:val 100000000 :doc "Timeout is the default timeout for PHY operations.\n"} Timeout (* 100 time/Millisecond))


(go/type Status "Status represents the resolved PHY link state.\n" (struct
    ^{:line 56 :tag bool} Link
    ^{:line 57 :tag bool} AutoNegotiationComplete
    ^{:line 58 :tag int} Speed
    ^{:line 59 :tag bool} FullDuplex))



(go/type PHY "PHY represents a LAN8840 PHY port.\n" (struct

    ^{:line 65 :tag time/Duration :doc "Timeout for PHY operations\n"} Timeout

    ^{:line 67 :tag phy/MIIM} miim
    ^{:line 68 :tag int} pa
    ^{:line 69 :tag int} speed))



^{:go/end 87} (go/method Init "Init initializes a LAN8840 PHY instance for register access.\n" [^{:tag (* PHY)} hw ^int addr ^phy/MIIM miim] :results [^error err]
  (when (or (== miim nil) (< addr 0) (> addr 0x07))
    (return (errors/New "invalid PHY instance")))


  (set! (.-miim hw) miim)
  (set! (.-pa hw) addr)
  (set! (.-speed hw) 0)

  (when (== (.-Timeout hw) 0)
    (set! (.-Timeout hw) Timeout))


  (return))


^{:go/end 95} (go/method read [^{:tag (* PHY)} hw ^int address] :results [^uint16 data ^error err]
  (when (== (.-miim hw) nil)
    (return 0 (errors/New "invalid PHY instance")))


  (.ReadPHYRegister (.-miim hw) (.-pa hw) address))


^{:go/end 103} (go/method write [^{:tag (* PHY)} hw ^int address ^uint16 data] :results [^error err]
  (when (== (.-miim hw) nil)
    (return (errors/New "invalid PHY instance")))


  (.WritePHYRegister (.-miim hw) (.-pa hw) address data))



^{:go/end 130} (go/method Reset "Reset performs a software hard reset and waits for its completion.\n" [^{:tag (* PHY)} hw] :results [^error err]
  (let [^uint16 control (zero uint16)]

    (when [(set! err (.write hw BASIC_CONTROL (<< 1 CTRL_RESET)))] (!= err nil)
      (return))


    (let [deadline (.Add (time/Now) (.-Timeout hw))]

      (while true
        (when [(set! (values control err) (.read hw BASIC_CONTROL))] (!= err nil)
          (return))


        (when (not (bits/Get16 (addr control) CTRL_RESET))
          (return))


        (when (.After (time/Now) deadline)
          (return (errors/New "reset timeout")))


        (time/Sleep time/Millisecond)))))




^{:go/end 145} (go/method Negotiate "Negotiate enables and restarts auto-negotiation.\n" [^{:tag (* PHY)} hw] :results [^error err]
  (let [^uint16 control (zero uint16)]

    (set! (.-speed hw) 0)

    (when [(set! (values control err) (.read hw BASIC_CONTROL))] (!= err nil)
      (return))


    (set! control bit-or (bit-or (<< 1 CTRL_ANEG_ENABLE) (<< 1 CTRL_ANEG_RESTART)))

    (.write hw BASIC_CONTROL control)))



^{:go/end 160} (go/method Identifier "Identifier returns the PHY identifier registers as one 32-bit value.\n" [^{:tag (* PHY)} hw] :results [^uint32 id ^error err]
  (let [(values ^uint16 high ^uint16 low) (zero uint16)]

    (when [(set! (values high err) (.read hw PHY_ID_1))] (!= err nil)
      (return))


    (when [(set! (values low err) (.read hw PHY_ID_2))] (!= err nil)
      (return))


    (return (bit-or (<< (conv uint32 high) 16) (conv uint32 low)) nil)))


^{:go/end 169} (go/method link [^{:tag (* PHY)} hw] :results [^uint16 basic ^error err]
  ;; STATUS_LINK is latch-low; the first read clears stale link state.
  (when [(set! (values _ err) (.read hw BASIC_STATUS))] (!= err nil)
    (return))


  (.read hw BASIC_STATUS))




^{:go/end 181} (go/method Link "Link reports whether the PHY link is up. The status register is read twice\nbecause its link bit is latched low.\n" [^{:tag (* PHY)} hw] :results [^bool up ^error err]
  (let [^uint16 basic (zero uint16)]

    (when [(set! (values basic err) (.link hw))] (!= err nil)
      (return))


    (return (bits/Get16 (addr basic) STATUS_LINK) nil)))



^{:go/end 244} (go/method Status "Status returns link, auto-negotiation, speed, and duplex state.\n" [^{:tag (* PHY)} hw] :results [^Status status ^error err]
  (let [(values ^uint16 basic ^uint16 local ^uint16 partner) (zero uint16)]

    (when [(set! (values basic err) (.link hw))] (!= err nil)
      (return))


    (set! (.-speed hw) 0)

    (set! (.-Link status) (bits/Get16 (addr basic) STATUS_LINK))
    (set! (.-AutoNegotiationComplete status) (bits/Get16 (addr basic) STATUS_ANEG_COMPLETE))

    (when (or (not (.-Link status)) (not (.-AutoNegotiationComplete status)))
      (return))


    (when [(set! (values local err) (.read hw PHY_1000_CTRL))] (!= err nil)
      (return status (fmt/Errorf "could not read 1000BASE-T control register, %w" err)))


    (when [(set! (values partner err) (.read hw PHY_1000_STATUS))] (!= err nil)
      (return status (fmt/Errorf "could not read 1000BASE-T status register, %w" err)))


    (switch
      (case [(and (bits/Get16 (addr local) ANEG_ADV_1000_FULL) (bits/Get16 (addr partner) ANEG_LPA_1000_FULL))]
        (set! (.-Speed status) 1000)
        (set! (.-FullDuplex status) true))
      (case [(and (bits/Get16 (addr local) ANEG_ADV_1000_HALF) (bits/Get16 (addr partner) ANEG_LPA_1000_HALF))]
        (set! (.-Speed status) 1000))
      (default
        (when [(set! (values local err) (.read hw PHY_ANEG_ADV))] (!= err nil)
          (return status (fmt/Errorf "could not read auto-negotiation advertisement register, %w" err)))


        (when [(set! (values partner err) (.read hw PHY_ANEG_LPA))] (!= err nil)
          (return status (fmt/Errorf "could not read auto-negotiation link partner ability register, %w" err)))


        (let [common (bit-and local partner)]

          (switch
            (case [(bits/Get16 (addr common) ANEG_ADV_100_FULL)]
              (set! (.-Speed status) 100)
              (set! (.-FullDuplex status) true))
            (case [(bits/Get16 (addr common) ANEG_ADV_100_HALF)]
              (set! (.-Speed status) 100))
            (case [(bits/Get16 (addr common) ANEG_ADV_10_FULL)]
              (set! (.-Speed status) 10)
              (set! (.-FullDuplex status) true))
            (case [(bits/Get16 (addr common) ANEG_ADV_10_HALF)]
              (set! (.-Speed status) 10))
            (default
              (return status (errors/New "PHY has no common advertised mode")))))))



    (set! (.-speed hw) (.-Speed status))

    (return)))



^{:go/end 249} (go/method Address "Address returns the PHY address passed at [PHY.Init].\n" ^int [^{:tag (* PHY)} hw]
  (.-pa hw))



^{:go/end 254} (go/method Speed "Speed returns the last resolved PHY link speed.\n" ^int [^{:tag (* PHY)} hw]
  (.-speed hw))

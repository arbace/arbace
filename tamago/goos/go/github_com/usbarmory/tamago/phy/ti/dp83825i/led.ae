(in-ns 'go.github_com.usbarmory.tamago.phy.ti.dp83825i) (go/file "led.go" :imports [

    ^{:line 11} [errors "errors"]])


(go/const "PHY LED control registers\n"
  ^{:line 15} [^{:val 24} DP_LEDCR1 0x18]
  ^{:line 16} [^{:val 4} LEDCR1_LINK_LED_DRV 4]
  ^{:line 17} [^{:val 1} LEDCR1_LINK_LED_OFF 1]

  ^{:line 19} [^{:val 1129} DP_LEDCR2 0x469]
  ^{:line 20} [^{:val 5} LEDCR2_LED2_DRV_VAL 5]
  ^{:line 21} [^{:val 4} LEDCR2_LED2_DRV_EN 4])



(go/const "Table 22–9, MMD access control register bit definitions, 802.3-2008\n"
  ^{:line 26} [^{:val 0} MMD_FN_ADDR 2r00]
  ^{:line 27} [^{:val 1} MMD_FN_DATA 2r01])



^{:go/end 73} (go/method LED "LED controls the PHY connected LED state.\n" [^{:tag (* PHY)} hw ^int n ^bool on] :results [^error err]
  (switch n
    (case [0 1]
      (let [val (conv uint16 (<< 1 LEDCR1_LINK_LED_DRV))]

        (when (not on)
          (set! val bit-or (<< 1 LEDCR1_LINK_LED_OFF)))


        (return (.WritePHYRegister (.-miim hw) (.-pa hw) DP_LEDCR1 val))))
    (case [2]
      (let [val (conv uint16 (<< 1 LEDCR2_LED2_DRV_EN))]

        (when (not on)
          (set! val bit-or (<< 1 LEDCR2_LED2_DRV_VAL)))


        ;; Clause 22 access to Clause 45 MMD registers (802.3-2008)

        ;; set general MMD registers access
        (let [devad (conv uint16 0x1f)]

          ;; set address function
          (when [(set! err (.WritePHYRegister (.-miim hw) (.-pa hw) DP_REGCR (bit-or (conv uint16 (<< MMD_FN_ADDR 14)) devad)))] (!= err nil)
            (return))


          ;; write address value
          (when [(set! err (.WritePHYRegister (.-miim hw) (.-pa hw) DP_ADDAR DP_LEDCR2))] (!= err nil)
            (return))


          ;; set data function
          (when [(set! err (.WritePHYRegister (.-miim hw) (.-pa hw) DP_REGCR (bit-or (conv uint16 (<< MMD_FN_DATA 14)) devad)))] (!= err nil)
            (return))


          ;; write data value
          (return (.WritePHYRegister (.-miim hw) (.-pa hw) DP_ADDAR val))))))


  (errors/New "invalid LED"))

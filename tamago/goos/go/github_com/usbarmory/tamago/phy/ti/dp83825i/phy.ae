;; Package dp83825i implements a driver for the Texas Instruments DP83825I
;; Ethernet Transceiver adopting the following specifications:
;;   - SNLS638C – DECEMBER 2018 – REVISED APRIL 2026
(in-ns 'go.github_com.usbarmory.tamago.phy.ti.dp83825i) (go/file "phy.go" :doc "Package dp83825i implements a driver for the Texas Instruments DP83825I\nEthernet Transceiver adopting the following specifications:\n  - SNLS638C – DECEMBER 2018 – REVISED APRIL 2026\n" :imports [


    ^{:line 15} [errors "errors"]
    ^{:line 16} [fmt "fmt"]

    ^{:line 18} [phy "github.com/usbarmory/tamago/phy"]])



(go/const "PHY registers\n"
  ^{:line 23} [^{:val 0} DP_CTRL 0x00]
  ^{:line 24} [^{:val 15} CTRL_RESET 15]
  ^{:line 25} [^{:val 13} CTRL_SPEED 13]
  ^{:line 26} [^{:val 12} CTRL_ANEG 12]
  ^{:line 27} [^{:val 8} CTRL_DUPLEX 8]

  ^{:line 29} [^{:val 13} DP_REGCR 0xd]
  ^{:line 30} [^{:val 14} DP_ADDAR 0xe]

  ^{:line 32} [^{:val 23} DP_RCSR 0x17]
  ^{:line 33} [^{:val 7} RCSR_RMII_CS 7]
  ^{:line 34} [^{:val 0} RCSR_RX_BUF 0])



(go/type PHY "PHY represents the DP83825I Ethernet PHY instance.\n" (struct
    ^{:line 39 :tag phy/MIIM} miim
    ^{:line 40 :tag int} pa
    ^{:line 41 :tag int} speed))



^{:go/end 60} (go/method Init "Init initializes the PHY and performs [PHY.Negotiate].\n" [^{:tag (* PHY)} hw ^int addr ^phy/MIIM miim] :results [^error err]
  (when (== miim nil)
    (return (errors/New "invalid PHY instance")))


  (set! (.-miim hw) miim)
  (set! (.-pa hw) addr)
  (set! (.-speed hw) 0)

  ;; software reset
  (when [(set! err (.WritePHYRegister (.-miim hw) (.-pa hw) DP_CTRL (<< 1 CTRL_RESET)))] (!= err nil)
    (return))


  (.Negotiate hw))




^{:go/end 88} (go/method Negotiate "Negotiate refreshes the PHY auto-negotiation status, currently only 100 Mbps\nAuto-Negotiation (Full-duplex) is supported.\n" [^{:tag (* PHY)} hw] :results [^error err]
  (set! (.-speed hw) 0)

  (when (== (.-miim hw) nil)
    (return (errors/New "invalid PHY instance")))


  ;; 100 Mbps, Auto-Negotiation, Full-duplex
  (let [ctrl (bit-or (<< 1 CTRL_SPEED) (<< 1 CTRL_ANEG) (<< 1 CTRL_DUPLEX))]

    (when [(set! err (.WritePHYRegister (.-miim hw) (.-pa hw) DP_CTRL (conv uint16 ctrl)))] (!= err nil)
      (return (fmt/Errorf "could not configure auto-negotiation, %v" err)))


    ;; 50MHz RMII Reference Clock Select, 2 bit tolerance Receive Elasticity Buffer Size
    (let [rcsr (bit-or (<< 1 RCSR_RMII_CS) (<< 1 RCSR_RX_BUF))]

      (when [(set! err (.WritePHYRegister (.-miim hw) (.-pa hw) DP_RCSR (conv uint16 rcsr)))] (!= err nil)
        (return (fmt/Errorf "could not select reference clock, %v" err)))


      (set! (.-speed hw) 100)

      (return))))



^{:go/end 93} (go/method Address "Address returns the PHY address passed at [PHY.Init].\n" ^int [^{:tag (* PHY)} hw]
  (.-pa hw))



^{:go/end 98} (go/method Speed "Speed returns the PHY auto-negotiated speed.\n" ^int [^{:tag (* PHY)} hw]
  (.-speed hw))

;; Package phy provides abstraction for Ethernet PHY driver support.
(in-ns 'go.github_com.usbarmory.tamago.phy) (go/file "phy.go" :doc "Package phy provides abstraction for Ethernet PHY driver support.\n" :imports [])





(go/type MIIM "MIIM is the common interface used by sub-packages to access Media\nIndependent Interface Management (MIIM) buses.\n\nThe bus is expected to be already initialized when passed to a PHY driver.\n" (interface


    (^{:doc "ReadPHYRegister reads a standard management register of a connected Ethernet\nPHY (IEEE 802.3-2008 Clause 22).\n"} ReadPHYRegister [^int pa ^int ra] :results [^uint16 data ^error err])



    (^{:doc "WritePHYRegister writes a standard management register of a connected\nEthernet PHY (IEEE 802.3-2008 Clause 22).\n"} WritePHYRegister [^int pa ^int ra ^uint16 data] :results [^error err])))




(go/type PHY "PHY is the common interface used by sub-packages to implement Ethernet PHY\ndrivers.\n" (interface

    (^{:doc "Init represents the PHY initialization function.\n"} Init ^error [^int addr ^MIIM miim])


    (^{:doc "Negotiate represents the PHY auto-negotiation function.\n"} Negotiate ^error [])


    (^{:doc "Address reports the PHY address.\n"} Address ^int [])


    (^{:doc "Speed reports the PHY auto-negotiated speed.\n"} Speed ^int [])))

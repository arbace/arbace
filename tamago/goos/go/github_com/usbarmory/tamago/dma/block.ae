(in-ns 'go.github_com.usbarmory.tamago.dma) (go/file "block.go" :imports [

    ^{:line 11} [unsafe "unsafe"]])

(go/type block (struct

    ^{:line 15 :tag uint :doc "pointer address\n"} addr

    ^{:line 17 :tag uint :doc "buffer size\n"} size


    ^{:line 20 :tag bool :doc "distinguish regular (`Alloc`/`Free`) and reserved\n(`Reserve`/`Release`) blocks.\n"} res))


^{:go/end 30} (go/method read [^{:tag (* block)} b ^uint off ^{:tag (slice byte)} buf]
  (let [^unsafe/Pointer ptr (zero unsafe/Pointer)]

    (set! ptr (unsafe/Add ptr (+ (.-addr b) off)))
    (let [mem (unsafe/Slice (conv (* byte) ptr) (len buf))]

      (copy buf mem))))


^{:go/end 39} (go/method write [^{:tag (* block)} b ^uint off ^{:tag (slice byte)} buf]
  (let [^unsafe/Pointer ptr (zero unsafe/Pointer)]

    (set! ptr (unsafe/Add ptr (+ (.-addr b) off)))
    (let [mem (unsafe/Slice (conv (* byte) ptr) (len buf))]

      (copy mem buf))))


^{:go/end 48} (go/method slice [^{:tag (* block)} b] :results [^{:tag (slice byte)} buf]
  (let [^unsafe/Pointer ptr (zero unsafe/Pointer)]

    (set! ptr (unsafe/Add ptr (.-addr b)))
    (set! buf (unsafe/Slice (conv (* byte) ptr) (.-size b)))

    (return)))

^{:go/end 79} (go/method FreeBlocks "FreeBlocks returns the DMA region free blocks addresses and size.\n" ^{:tag (map uint uint)} [^{:tag (* Region)} r]
  (let [m (make (map uint uint))]

    (for [e (.Front (.-freeBlocks r))] (!= e nil) (set! e (.Next e))
      (let [b (assert (* block) (.-Value e))]
        (aset m (.-addr b) (.-size b))))


    ^{:line 78} m))



^{:go/end 90} (go/method UsedBlocks "UsedBlocks returns the DMA region allocated blocks addresses and size.\n" ^{:tag (map uint uint)} [^{:tag (* Region)} r]
  (let [m (make (map uint uint))]

    (range [addr b (.-usedBlocks r)]
      (aset m addr (.-size b)))



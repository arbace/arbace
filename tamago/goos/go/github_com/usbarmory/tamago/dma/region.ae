  (.freeBlock r addr false))




^{:go/end 241} (go/method Release "Release frees the memory region stored at the passed address, the region\nmust have been previously allocated with Reserve().\n" [^{:tag (* Region)} r ^uint addr]
  (.freeBlock r addr true))


^{:go/end 260} (go/method defrag [^{:tag (* Region)} r]
  (let [^{:tag (* block)} prevBlock (zero (* block))]

    ;; find contiguous free blocks and combine them
    (for [e (.Front (.-freeBlocks r))] (!= e nil) (set! e (.Next e))
      (let [b (assert (* block) (.-Value e))]

        (when (!= prevBlock nil)
          (when (== (+ (.-addr prevBlock) (.-size prevBlock)) (.-addr b))
            (set! (.-size prevBlock) + (.-size b))
            (defer (.Remove (.-freeBlocks r) e))
            (continue)))



        (set! prevBlock (assert (* block) (.-Value e)))))))



^{:go/end 316} (go/method alloc ^{:tag (* block)} [^{:tag (* Region)} r ^uint size ^uint align]
  (let [^{:tag (* list/Element)} e (zero (* list/Element))
      ^{:line 264 :tag (* block)} freeBlock (zero (* block))
      ^{:line 265 :tag uint} pad (zero uint)]

    (when (or (== align 0) (!= (bit-and align (- align 1)) 0))
      (set! align DefaultAlignment))


    ;; find suitable block
    (for [(set! e (.Front (.-freeBlocks r)))] (!= e nil) (set! e (.Next e))
      (let [b (assert (* block) (.-Value e))]

        ;; pad to required alignment
        (set! pad (bit-and (- (.-addr b)) (- align 1)))

        (when (>= (.-size b) (+ size pad))
          (set! freeBlock b)
          (set! size + pad)
          (break))))



    (when (== freeBlock nil)
      (panic "out of memory"))


    ;; allocate block from free linked list

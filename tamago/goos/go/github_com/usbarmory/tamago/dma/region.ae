^{:go/end 122} (go/method Reserve "Reserve allocates a Slice of bytes for DMA purposes, by placing its data\nwithin the DMA region, with optional alignment. It returns the slice along\nwith its data allocation address. The buffer can be freed up with Release().\n\nReserving buffers with Reserve() allows applications to pre-allocate DMA\nregions, avoiding unnecessary memory copy operations when performance is a\nconcern. Reserved buffers cause Alloc() and Read() to return without any\nallocation or memory copy.\n\nGreat care must be taken on reserved buffer as:\n  - buf contents are uninitialized (unlike when using Alloc())\n  - buf slices remain in reserved space but only the original buf\n    can be subject of Release()\n\nThe optional alignment must be a power of 2 and word alignment is always\nenforced, 0 means 4 on 32-bit platforms and 8 on 64-bit ones.\n" [^{:tag (* Region)} r ^int size ^int align] :results [^uint addr ^{:tag (slice byte)} buf]
  (when (== size 0)
    (return))


  ^{:go/via [Mutex]} (.Lock r)
  (defer ^{:go/via [Mutex]} (.Unlock r))

  (let [b (.alloc r (conv uint size) (conv uint align))]
    (set! (.-res b) true)

    (aset (.-usedBlocks r) (.-addr b) b)

    (return (.-addr b) (.slice b))))





^{:go/end 132} (go/method Reserved "Reserved returns whether a slice of bytes data is allocated within the DMA\nbuffer region, it is used to determine whether the passed buffer has been\npreviously allocated by this package with Reserve().\n" [^{:tag (* Region)} r ^{:tag (slice byte)} buf] :results [^bool res ^uint addr]
  (set! addr (conv uint (conv uintptr (conv unsafe/Pointer (addr (aget buf 0))))))
  (set! res (and (>= addr (.-start r)) (<= (+ addr (conv uint (len buf))) (+ (.-start r) (.-size r)))))

  (return))











^{:go/end 163} (go/method Alloc "Alloc reserves a memory region for DMA purposes, copying over a buffer and\nreturning its allocation address, with optional alignment. The region can be\nfreed up with Free().\n\nIf the argument is a buffer previously created with Reserve(), then its\naddress is return without any re-allocation.\n\nThe optional alignment must be a power of 2 and word alignment is always\nenforced, 0 means 4 on 32-bit platforms and 8 on 64-bit ones.\n" [^{:tag (* Region)} r ^{:tag (slice byte)} buf ^int align] :results [^uint addr]
  (let [size (len buf)]

    (when (== size 0)
      (return 0))


    (when [(values res addr) (.Reserved r buf)] res
      (return addr))


    ^{:go/via [Mutex]} (.Lock r)
    (defer ^{:go/via [Mutex]} (.Unlock r))

    (let [b (.alloc r (conv uint size) (conv uint align))]
      (.write b 0 buf)

      (aset (.-usedBlocks r) (.-addr b) b)

      (.-addr b))))












^{:go/end 200} (go/method Read "Read reads exactly len(buf) bytes from a memory region address into a\nbuffer, the region must have been previously allocated with Alloc().\n\nThe offset and buffer size are used to retrieve a slice of the memory\nregion, a panic occurs if these parameters are not compatible with the\ninitial allocation for the address.\n\nIf the argument is a buffer previously created with Reserve(), then the\nfunction returns without modifying it, as it is assumed for the buffer to be\nalready updated.\n" [^{:tag (* Region)} r ^uint addr ^int off ^{:tag (slice byte)} buf]
  (let [size (len buf)]

    (when (or (== addr 0) (== size 0))
      (return))


    (when [(values res _) (.Reserved r buf)] res
      (return))


    ^{:go/via [Mutex]} (.Lock r)
    (defer ^{:go/via [Mutex]} (.Unlock r))

    (let [(values b ok) (aget (.-usedBlocks r) addr)]

      (when (not ok)
        (panic "read of unallocated pointer"))


      (when (> (conv uint (+ off size)) (.-size b))
        (panic "invalid read parameters"))


      (.read b (conv uint off) buf))))








^{:go/end 229} (go/method Write "Write writes buffer contents to a memory region address, the region must\nhave been previously allocated with Alloc().\n\nAn offset can be passed to write a slice of the memory region, a panic\noccurs if the offset is not compatible with the initial allocation for the\naddress.\n" [^{:tag (* Region)} r ^uint addr ^int off ^{:tag (slice byte)} buf]
  (let [size (len buf)]

    (when (or (== addr 0) (== size 0))
      (return))


    ^{:go/via [Mutex]} (.Lock r)
    (defer ^{:go/via [Mutex]} (.Unlock r))

    (let [(values b ok) (aget (.-usedBlocks r) addr)]

      (when (not ok)
        (return))


      (when (> (conv uint (+ off size)) (.-size b))
        (panic "invalid write parameters"))


      (.write b (conv uint off) buf))))





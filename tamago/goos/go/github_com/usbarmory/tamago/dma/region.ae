^{:go/end 52} (go/method Init "Init initializes a memory region with a single block that fits it.\n" [^{:tag (* Region)} r ^uint start ^uint size]
  (set! (.-start r) start)
  (set! (.-size r) size)

  (let [b (addr ^{:go/breaks [2 4]} (lit block
          :addr start
          :size size))]


    (set! (.-freeBlocks r) (list/New))
    (.PushFront (.-freeBlocks r) b)

    (set! (.-usedBlocks r) (make (map uint (* block))))))



^{:go/end 57} (go/method Start "Start returns the DMA region start address.\n" ^uint [^{:tag (* Region)} r]

              :addr (+ (.-addr freeBlock) size)
              :size n))]


        (set! (.-size freeBlock) size)
        (.InsertAfter (.-freeBlocks r) newBlockAfter e)))


    (when (!= pad 0)
      ;; claim padding space
      (let [newBlockBefore (addr ^{:go/breaks [2 4]} (lit block
              :addr (.-addr freeBlock)
              :size pad))]


        (set! (.-addr freeBlock) + pad)
        (set! (.-size freeBlock) - pad)
        (.InsertBefore (.-freeBlocks r) newBlockBefore e)))


    ^{:line 315} freeBlock))


^{:go/end 331} (go/method free [^{:tag (* Region)} r ^{:tag (* block)} usedBlock]
  (defer (.defrag r))

  (for [e (.Front (.-freeBlocks r))] (!= e nil) (set! e (.Next e))
    (let [b (assert (* block) (.-Value e))]

      (when (> (.-addr b) (.-addr usedBlock))
        (.InsertBefore (.-freeBlocks r) usedBlock e)
        (return))))



  (.PushBack (.-freeBlocks r) usedBlock))


^{:go/end 353} (go/method freeBlock [^{:tag (* Region)} r ^uint addr ^bool res]
  (when (== addr 0)
    (return))


  ^{:go/via [Mutex]} (.Lock r)
  (defer ^{:go/via [Mutex]} (.Unlock r))

  (let [(values b ok) (aget (.-usedBlocks r) addr)]

    (when (not ok)
      (return))


    (when (!= (.-res b) res)
      (return))


    (.free r b)
    (delete (.-usedBlocks r) addr)))

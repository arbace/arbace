;; Package dma provides primitives for direct memory allocation and alignment,
;; it is primarily used in bare metal device driver operation to avoid passing
;; Go pointers for DMA purposes.
;;
;; This package is only meant to be used with `GOOS=tamago` as supported by the
;; TamaGo framework for bare metal Go, see https://github.com/usbarmory/tamago.
(in-ns 'go.github_com.usbarmory.tamago.dma) (go/file "dma.go" :doc "Package dma provides primitives for direct memory allocation and alignment,\nit is primarily used in bare metal device driver operation to avoid passing\nGo pointers for DMA purposes.\n\nThis package is only meant to be used with `GOOS=tamago` as supported by the\nTamaGo framework for bare metal Go, see https://github.com/usbarmory/tamago.\n" :imports [


    ^{:line 18} [fmt "fmt"]
    ^{:line 19} [runtime "runtime"]])









^{:go/end 46} (go/func NewRegion "NewRegion initializes a memory region for DMA buffer allocation.\n\nTo avoid unforseen consequences the caller must ensure that allocated\nregions do not overlap among themselves or with the global one (see Init()).\n\nTo allow allocation of DMA buffers within Go runtime memory the unsafe flag\nmust be set.\n" [^uint addr ^int size ^bool unsafe] :results [^{:tag (* Region)} r ^error err]
  (let [start (conv uint addr)
      ^{:line 31} end (+ (conv uint start) (conv uint size))

      ;; returns uint32/uint64 depending on platform
      (values rs re) (runtime/MemRegion)
      ^{:line 35} ramStart (conv uint rs)
      ^{:line 36} ramEnd (conv uint re)]

    (when (and (not unsafe) (not (or (>= start ramEnd) ^:go/paren (and (< start ramStart) (<= end ramStart)))))
      (return nil (fmt/Errorf "DMA within Go runtime memory (%#x-%#x) is not allowed" ramStart ramEnd)))


    (set! r (addr (lit Region)))
    (.Init r start (conv uint size))

    (return)))







^{:go/end 56} (go/func Init "Init initializes the global memory region for DMA buffer allocation, used\nthroughout the tamago package for all DMA allocations.\n\nAdditional DMA regions for application use can be allocated through\nNewRegion().\n" [^uint start ^int size] :results [^error err]
  (set! (values dma err) (NewRegion start size false))
  (return))



^{:go/end 61} (go/func Reserve "Reserve is the equivalent of Region.Reserve() on the global DMA region.\n" [^int size ^int align] :results [^uint addr ^{:tag (slice byte)} buf]
  (.Reserve dma size align))



^{:go/end 66} (go/func Reserved "Reserved is the equivalent of Region.Reserved() on the global DMA region.\n" [^{:tag (slice byte)} buf] :results [^bool res ^uint addr]
  (.Reserved dma buf))



^{:go/end 71} (go/func Alloc "Alloc is the equivalent of Region.Alloc() on the global DMA region.\n" [^{:tag (slice byte)} buf ^int align] :results [^uint addr]
  (.Alloc dma buf align))



^{:go/end 76} (go/func Read "Read is the equivalent of Region.Read() on the global DMA region.\n" [^uint addr ^int off ^{:tag (slice byte)} buf]
  (.Read dma addr off buf))



^{:go/end 81} (go/func Write "Write is the equivalent of Region.Write() on the global DMA region.\n" [^uint addr ^int off ^{:tag (slice byte)} buf]
  (.Write dma addr off buf))



^{:go/end 86} (go/func Free "Free is the equivalent of Region.Free() on the global DMA region.\n" [^uint addr]
  (.Free dma addr))



^{:go/end 91} (go/func Release "Release is the equivalent of Region.Release() on the global DMA region.\n" [^uint addr]
  (.Release dma addr))

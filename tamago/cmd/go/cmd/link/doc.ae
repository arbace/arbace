;; /*
;; Link, typically invoked as “go tool link”, reads the Go archive or object
;; for a package main, along with its dependencies, and combines them
;; into an executable binary.
;; 
;; # Command Line
;; 
;; Usage:
;; 
;; go tool link [flags] main.a
;; 
;; Flags:
;; 
;; -B note
;; Add an ELF_NT_GNU_BUILD_ID note when using ELF.
;; The value should start with 0x and be an even number of hex digits.
;; Alternatively, you can pass "gobuildid" in order to derive the
;; GNU build ID from the Go build ID.
;; -E entry
;; Set entry symbol name.
;; -H type
;; Set executable format type.
;; The default format is inferred from GOOS and GOARCH.
;; On Windows, -H windowsgui writes a "GUI binary" instead of a "console binary."
;; -I interpreter
;; Set the ELF dynamic linker to use.
;; -L dir1 -L dir2
;; Search for imported packages in dir1, dir2, etc,
;; after consulting $GOROOT/pkg/$GOOS_$GOARCH.
;; -R quantum
;; Set address rounding quantum.
;; -T address
;; Set the start address of text symbols.
;; -V
;; Print linker version and exit.
;; -X importpath.name=value
;; Set the value of the string variable in importpath named name to value.
;; This is only effective if the variable is declared in the source code either uninitialized
;; or initialized to a constant string expression. -X will not work if the initializer makes
;; a function call or refers to other variables.
;; Note that before Go 1.5 this option took two separate arguments.
;; -asan
;; Link with C/C++ address sanitizer support.
;; -aslr
;; Enable ASLR for buildmode=c-shared on windows (default true).
;; -bindnow
;; Mark a dynamically linked ELF object for immediate function binding (default false).
;; -buildid id
;; Record id as Go toolchain build id.
;; -buildmode mode
;; Set build mode (default exe).
;; -c
;; Dump call graphs.
;; -checklinkname=value
;; If value is 0, all go:linkname directives are permitted.
;; If value is 1 (the default), only a known set of widely-used
;; linknames are permitted.
;; -compressdwarf
;; Compress DWARF if possible (default true).
;; -cpuprofile file
;; Write CPU profile to file.
;; -d
;; Disable generation of dynamic executables.
;; The emitted code is the same in either case; the option
;; controls only whether a dynamic header is included.
;; The dynamic header is on by default, even without any
;; references to dynamic libraries, because many common
;; system tools now assume the presence of the header.
;; -dumpdep
;; Dump symbol dependency graph.
;; -e
;; No limit on number of errors reported.
;; -extar ar
;; Set the external archive program (default "ar").
;; Used only for -buildmode=c-archive.
;; -extld linker
;; Set the external linker (default "clang" or "gcc").
;; -extldflags flags
;; Set space-separated flags to pass to the external linker.
;; -f
;; Ignore version mismatch in the linked archives.
;; -funcalign N
;; Set function alignment to N bytes
;; -g
;; Disable Go package data checks.
;; -importcfg file
;; Read import configuration from file.
;; In the file, set packagefile, packageshlib to specify import resolution.
;; -installsuffix suffix
;; Look for packages in $GOROOT/pkg/$GOOS_$GOARCH_suffix
;; instead of $GOROOT/pkg/$GOOS_$GOARCH.
;; -k symbol
;; Set field tracking symbol. Use this flag when GOEXPERIMENT=fieldtrack is set.
;; -libgcc file
;; Set name of compiler support library.
;; This is only used in internal link mode.
;; If not set, default value comes from running the compiler,
;; which may be set by the -extld option.
;; Set to "none" to use no support library.
;; -linkmode mode
;; Set link mode (internal, external, auto).
;; This sets the linking mode as described in cmd/cgo/doc.go.
;; -linkshared
;; Link against installed Go shared libraries (experimental).
;; -memprofile file
;; Write memory profile to file.
;; -memprofilerate rate
;; Set runtime.MemProfileRate to rate.
;; -msan
;; Link with C/C++ memory sanitizer support.
;; -o file
;; Write output to file (default a.out, or a.out.exe on Windows).
;; -pluginpath path
;; The path name used to prefix exported plugin symbols.
;; -r dir1:dir2:...
;; Set the ELF dynamic linker search path.
;; -race
;; Link with race detection libraries.
;; -s
;; Omit the symbol table and debug information.
;; Implies the -w flag, which can be negated with -w=0.
;; -tmpdir dir
;; Write temporary files to dir.
;; Temporary files are only used in external linking mode.
;; -v
;; Print trace of linker operations.
;; -w
;; Omit the DWARF symbol table.
;; */
(in-ns 'go.cmd.link) (go/file "doc.go" :doc "Link, typically invoked as “go tool link”, reads the Go archive or object\nfor a package main, along with its dependencies, and combines them\ninto an executable binary.\n\n# Command Line\n\nUsage:\n\n\tgo tool link [flags] main.a\n\nFlags:\n\n\t-B note\n\t\tAdd an ELF_NT_GNU_BUILD_ID note when using ELF.\n\t\tThe value should start with 0x and be an even number of hex digits.\n\t\tAlternatively, you can pass \"gobuildid\" in order to derive the\n\t\tGNU build ID from the Go build ID.\n\t-E entry\n\t\tSet entry symbol name.\n\t-H type\n\t\tSet executable format type.\n\t\tThe default format is inferred from GOOS and GOARCH.\n\t\tOn Windows, -H windowsgui writes a \"GUI binary\" instead of a \"console binary.\"\n\t-I interpreter\n\t\tSet the ELF dynamic linker to use.\n\t-L dir1 -L dir2\n\t\tSearch for imported packages in dir1, dir2, etc,\n\t\tafter consulting $GOROOT/pkg/$GOOS_$GOARCH.\n\t-R quantum\n\t\tSet address rounding quantum.\n\t-T address\n\t\tSet the start address of text symbols.\n\t-V\n\t\tPrint linker version and exit.\n\t-X importpath.name=value\n\t\tSet the value of the string variable in importpath named name to value.\n\t\tThis is only effective if the variable is declared in the source code either uninitialized\n\t\tor initialized to a constant string expression. -X will not work if the initializer makes\n\t\ta function call or refers to other variables.\n\t\tNote that before Go 1.5 this option took two separate arguments.\n\t-asan\n\t\tLink with C/C++ address sanitizer support.\n\t-aslr\n\t\tEnable ASLR for buildmode=c-shared on windows (default true).\n\t-bindnow\n\t\tMark a dynamically linked ELF object for immediate function binding (default false).\n\t-buildid id\n\t\tRecord id as Go toolchain build id.\n\t-buildmode mode\n\t\tSet build mode (default exe).\n\t-c\n\t\tDump call graphs.\n\t-checklinkname=value\n\t\tIf value is 0, all go:linkname directives are permitted.\n\t\tIf value is 1 (the default), only a known set of widely-used\n\t\tlinknames are permitted.\n\t-compressdwarf\n\t\tCompress DWARF if possible (default true).\n\t-cpuprofile file\n\t\tWrite CPU profile to file.\n\t-d\n\t\tDisable generation of dynamic executables.\n\t\tThe emitted code is the same in either case; the option\n\t\tcontrols only whether a dynamic header is included.\n\t\tThe dynamic header is on by default, even without any\n\t\treferences to dynamic libraries, because many common\n\t\tsystem tools now assume the presence of the header.\n\t-dumpdep\n\t\tDump symbol dependency graph.\n\t-e\n\t\tNo limit on number of errors reported.\n\t-extar ar\n\t\tSet the external archive program (default \"ar\").\n\t\tUsed only for -buildmode=c-archive.\n\t-extld linker\n\t\tSet the external linker (default \"clang\" or \"gcc\").\n\t-extldflags flags\n\t\tSet space-separated flags to pass to the external linker.\n\t-f\n\t\tIgnore version mismatch in the linked archives.\n\t-funcalign N\n\t\tSet function alignment to N bytes\n\t-g\n\t\tDisable Go package data checks.\n\t-importcfg file\n\t\tRead import configuration from file.\n\t\tIn the file, set packagefile, packageshlib to specify import resolution.\n\t-installsuffix suffix\n\t\tLook for packages in $GOROOT/pkg/$GOOS_$GOARCH_suffix\n\t\tinstead of $GOROOT/pkg/$GOOS_$GOARCH.\n\t-k symbol\n\t\tSet field tracking symbol. Use this flag when GOEXPERIMENT=fieldtrack is set.\n\t-libgcc file\n\t\tSet name of compiler support library.\n\t\tThis is only used in internal link mode.\n\t\tIf not set, default value comes from running the compiler,\n\t\twhich may be set by the -extld option.\n\t\tSet to \"none\" to use no support library.\n\t-linkmode mode\n\t\tSet link mode (internal, external, auto).\n\t\tThis sets the linking mode as described in cmd/cgo/doc.go.\n\t-linkshared\n\t\tLink against installed Go shared libraries (experimental).\n\t-memprofile file\n\t\tWrite memory profile to file.\n\t-memprofilerate rate\n\t\tSet runtime.MemProfileRate to rate.\n\t-msan\n\t\tLink with C/C++ memory sanitizer support.\n\t-o file\n\t\tWrite output to file (default a.out, or a.out.exe on Windows).\n\t-pluginpath path\n\t\tThe path name used to prefix exported plugin symbols.\n\t-r dir1:dir2:...\n\t\tSet the ELF dynamic linker search path.\n\t-race\n\t\tLink with race detection libraries.\n\t-s\n\t\tOmit the symbol table and debug information.\n\t\tImplies the -w flag, which can be negated with -w=0.\n\t-tmpdir dir\n\t\tWrite temporary files to dir.\n\t\tTemporary files are only used in external linking mode.\n\t-v\n\t\tPrint trace of linker operations.\n\t-w\n\t\tOmit the DWARF symbol table.\n" :imports [])

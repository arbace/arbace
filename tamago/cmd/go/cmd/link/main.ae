(in-ns 'go.cmd.link) (go/file "main.go" :imports [


    ^{:line 8} [sys "cmd/internal/sys"]
    ^{:line 9} [amd64 "cmd/link/internal/amd64"]
    ^{:line 10} [arm "cmd/link/internal/arm"]
    ^{:line 11} [arm64 "cmd/link/internal/arm64"]
    ^{:line 12} [ld "cmd/link/internal/ld"]
    ^{:line 13} [loong64 "cmd/link/internal/loong64"]
    ^{:line 14} [mips "cmd/link/internal/mips"]
    ^{:line 15} [mips64 "cmd/link/internal/mips64"]
    ^{:line 16} [ppc64 "cmd/link/internal/ppc64"]
    ^{:line 17} [riscv64 "cmd/link/internal/riscv64"]
    ^{:line 18} [s390x "cmd/link/internal/s390x"]
    ^{:line 19} [wasm "cmd/link/internal/wasm"]
    ^{:line 20} [x86 "cmd/link/internal/x86"]
    ^{:line 21} [fmt "fmt"]
    ^{:line 22} [buildcfg "internal/buildcfg"]
    ^{:line 23} [os "os"]])


;; The bulk of the linker implementation lives in cmd/link/internal/ld.
;; Architecture-specific code lives in cmd/link/internal/GOARCH.
;;
;; Program initialization:
;;
;; Before any argument parsing is done, the Init function of relevant
;; architecture package is called. The only job done in Init is
;; configuration of the architecture-specific variables.
;;
;; Then control flow passes to ld.Main, which parses flags, makes
;; some configuration decisions, and then gives the architecture
;; packages a second chance to modify the linker's configuration
;; via the ld.Arch.Archinit function.

^{:go/end 73} (go/func main []
  (let [^{:tag (* sys/Arch)} arch (zero (* sys/Arch))
      ^{:line 42 :tag ld/Arch} theArch (zero ld/Arch)]

    (buildcfg/Check)
    (switch buildcfg/GOARCH
      (default
        (fmt/Fprintf os/Stderr "link: unknown architecture %q\n" buildcfg/GOARCH)
        (os/Exit 2))
      (case ["386"]
        (set! (values arch theArch) (x86/Init)))
      (case ["amd64"]
        (set! (values arch theArch) (amd64/Init)))
      (case ["arm"]
        (set! (values arch theArch) (arm/Init)))
      (case ["arm64"]
        (set! (values arch theArch) (arm64/Init)))
      (case ["loong64"]
        (set! (values arch theArch) (loong64/Init)))
      (case ["mips" "mipsle"]
        (set! (values arch theArch) (mips/Init)))
      (case ["mips64" "mips64le"]
        (set! (values arch theArch) (mips64/Init)))
      (case ["ppc64" "ppc64le"]
        (set! (values arch theArch) (ppc64/Init)))
      (case ["riscv64"]
        (set! (values arch theArch) (riscv64/Init)))
      (case ["s390x"]
        (set! (values arch theArch) (s390x/Init)))
      (case ["wasm"]
        (set! (values arch theArch) (wasm/Init))))

    (ld/Main arch theArch)))

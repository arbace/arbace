(in-ns 'go.cmd.link.internal.wasm) (go/file "obj.go" :imports [


    ^{:line 8} [sys "cmd/internal/sys"]
    ^{:line 9} [ld "cmd/link/internal/ld"]])


^{:go/end 26} (go/func Init [] :results [(* sys/Arch) ld/Arch]
  (let [theArch ^{:go/breaks [2 4 6 [8 18] 10 12 14 16]} (lit ld/Arch
        :Funcalign 16
        :Maxalign 32
        :Minalign 1

        :Archinit archinit
        :AssignAddress assignAddress
        :Asmb asmb
        :Asmb2 asmb2
        :Gentext gentext)]


    (return sys/ArchWasm theArch)))


^{:go/end 35} (go/func archinit [^{:tag (* ld/Link)} ctxt]
  (when (== @ld/FlagRound -1)
    (set! @ld/FlagRound 4096))

  (when (== @ld/FlagTextAddr -1)
    (set! @ld/FlagTextAddr 0)))

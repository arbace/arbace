^{:go/end 72} (go/func gentext [^{:tag (* ld/Link)} ctxt ^{:tag (* loader/Loader)} ldr]
  (let [(values initfunc addmoduledata) (ld/PrepareAddmoduledata ctxt)]
    (when (== initfunc nil)
      (return))


    (let [o ^{:go/end 52} (fn [^uint32 op]
          (.AddUint32 initfunc ^{:go/via [Target]} (.-Arch ctxt) op))]

      ;; 0000000000000000 <local.dso_init>:
      ;; 0:	90000000 	adrp	x0, 0 <runtime.firstmoduledata>
      ;; 	0: R_AARCH64_ADR_PREL_PG_HI21	local.moduledata
      ;; 4:	91000000 	add	x0, x0, #0x0
      ;; 	4: R_AARCH64_ADD_ABS_LO12_NC	local.moduledata
      (o 0x90000000)
      (o 0x91000000)

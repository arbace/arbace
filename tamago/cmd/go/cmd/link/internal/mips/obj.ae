(in-ns 'go.cmd.link.internal.mips) (go/file "obj.go" :imports [


    ^{:line 34} [objabi "cmd/internal/objabi"]
    ^{:line 35} [sys "cmd/internal/sys"]
    ^{:line 36} [ld "cmd/link/internal/ld"]
    ^{:line 37} [loader "cmd/link/internal/loader"]
    ^{:line 38} [buildcfg "internal/buildcfg"]])


^{:go/end 85} (go/func Init [] :results [(* sys/Arch) ld/Arch]
  (let [arch sys/ArchMIPS
      ^{:line 43} musl "/lib/ld-musl-mips.so.1"]
    (when (== buildcfg/GOARCH "mipsle")
      (set! arch sys/ArchMIPSLE)
      (set! musl "/lib/ld-musl-mipsel.so.1"))


    (let [theArch ^{:go/breaks [2 4 6 8 10 [12 56] 14 16 18 20 22 24 [26 64]]} (lit ld/Arch
          :Funcalign FuncAlign
          :Maxalign MaxAlign
          :Minalign MinAlign
          :Dwarfregsp DWARFREGSP
          :Dwarfreglr DWARFREGLR

          :Adddynrel adddynrel
          :Archinit archinit
          :Archreloc archreloc
          :Archrelocvariant archrelocvariant
          :Extreloc extreloc
          :Gentext gentext
          :Machoreloc1 machoreloc1

          :ELF ^{:go/breaks [2 4 [6 68] 8 10 12 14 [16 74] 18 20 [22 80]]} (lit ld/ELFArch
            :Linuxdynld "/lib/ld.so.1"
            :LinuxdynldMusl musl

            :Freebsddynld "XXX"
            :Openbsddynld "XXX"
            :Netbsddynld "XXX"
            :Dragonflydynld "XXX"
            :Solarisdynld "XXX"

            :Reloc1 elfreloc1
            :RelocSize 8
            :SetupPLT elfsetupplt

            ;; Historically GNU ld creates a read-only
            ;; .dynamic section.
            :DynamicReadOnly true))]



      (return arch theArch))))


^{:go/end 101} (go/func archinit [^{:tag (* ld/Link)} ctxt]
  (switch ^{:go/via [Target]} (.-HeadType ctxt)
    (default
      (ld/Exitf "unknown -H option: %v" ^{:go/via [Target]} (.-HeadType ctxt)))
    (case [objabi/Hlinux] ; /* mips elf */
      (ld/Elfinit ctxt)
      (set! ld/HEADR ld/ELFRESERVE)
      (when (== @ld/FlagRound -1)
        (set! @ld/FlagRound 0x10000))

      (when (== @ld/FlagTextAddr -1)
        (set! @ld/FlagTextAddr (+ (ld/Rnd 0x10000 @ld/FlagRound) (conv int64 ld/HEADR)))))))




^{:go/breaks [4] :go/end 106} (go/func adddynrel ^bool [^{:tag (* ld/Target)} target ^{:tag (* loader/Loader)} ldr ^{:tag (* ld/ArchSyms)} syms ^loader/Sym s ^loader/Reloc r ^int rIdx]
  (ld/Exitf "adddynrel currently unimplemented for MIPS")
  false)

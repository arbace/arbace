(in-ns 'go.cmd.link.internal.mips) (go/file "asm.go" :imports [


    ^{:line 34} [objabi "cmd/internal/objabi"]
    ^{:line 35} [sys "cmd/internal/sys"]
    ^{:line 36} [ld "cmd/link/internal/ld"]
    ^{:line 37} [loader "cmd/link/internal/loader"]
    ^{:line 38} [sym "cmd/link/internal/sym"]
    ^{:line 39} [elf "debug/elf"]])


^{:go/end 44} (go/func gentext [^{:tag (* ld/Link)} ctxt ^{:tag (* loader/Loader)} ldr]
  (return))


^{:go/end 69} (go/func elfreloc1 ^bool [^{:tag (* ld/Link)} ctxt ^{:tag (* ld/OutBuf)} out ^{:tag (* loader/Loader)} ldr ^loader/Sym s ^loader/ExtReloc r ^int ri ^int64 sectoff]
  (.Write32 out (conv uint32 sectoff))

  ^{:go/breaks [[3 68]]} (let [elfsym (ld/ElfSymForReloc ctxt (.-Xsym r))]
    (switch (.-Type r)
      (default
        (return false))
      (case [objabi/R_ADDR objabi/R_DWARFSECREF]
        (when (!= (.-Size r) 4)
          (return false))

        (.Write32 out (bit-or (conv uint32 elf/R_MIPS_32) (<< (conv uint32 elfsym) 8))))
      (case [objabi/R_ADDRMIPS]
        (.Write32 out (bit-or (conv uint32 elf/R_MIPS_LO16) (<< (conv uint32 elfsym) 8))))
      (case [objabi/R_ADDRMIPSU]
        (.Write32 out (bit-or (conv uint32 elf/R_MIPS_HI16) (<< (conv uint32 elfsym) 8))))
      (case [objabi/R_ADDRMIPSTLS]
        (.Write32 out (bit-or (conv uint32 elf/R_MIPS_TLS_TPREL_LO16) (<< (conv uint32 elfsym) 8))))
      (case [objabi/R_CALLMIPS objabi/R_JMPMIPS]
        (.Write32 out (bit-or (conv uint32 elf/R_MIPS_26) (<< (conv uint32 elfsym) 8)))))


    true))


^{:go/end 73} (go/func elfsetupplt [^{:tag (* ld/Link)} ctxt ^{:tag (* loader/Loader)} ldr ^{:tag (* loader/SymbolBuilder)} plt ^{:tag (* loader/SymbolBuilder)} gotplt ^loader/Sym dynamic]
  (return))


^{:go/breaks [3] :go/end 77} (go/func machoreloc1 ^bool [(* sys/Arch) (* ld/OutBuf) (* loader/Loader) loader/Sym loader/ExtReloc int64]
  false)


^{:go/end 91} (go/func applyrel ^int64 [^{:tag (* sys/Arch)} arch ^{:tag (* loader/Loader)} ldr ^objabi/RelocType rt ^int32 off ^loader/Sym s ^int64 val ^int64 t]
  (let [o (conv uint32 val)]
    (switch rt
      (case [objabi/R_ADDRMIPS objabi/R_ADDRMIPSTLS]
        (return (conv int64 (bit-or (bit-and o 0xffff0000) (bit-and (conv uint32 t) 0xffff)))))
      (case [objabi/R_ADDRMIPSU]
        (return (conv int64 (bit-or (bit-and o 0xffff0000) (bit-and (conv uint32 (>> (+ t (<< 1 15)) 16)) 0xffff)))))
      (case [objabi/R_CALLMIPS objabi/R_JMPMIPS]
        (return (conv int64 (bit-or (bit-and o 0xfc000000) (bit-and-not (conv uint32 (>> t 2)) 0xfc000000)))))
      (default
        (return val)))))



^{:go/end 140} (go/func archreloc [^{:tag (* ld/Target)} target ^{:tag (* loader/Loader)} ldr ^{:tag (* ld/ArchSyms)} syms ^loader/Reloc r ^loader/Sym s ^int64 val] :results [^int64 o ^int nExtReloc ^bool ok]
  (let [rs (.Sym r)]
    (when (.IsExternal target)
      (switch (.Type r)
        (default
          (return val 0 false))

        (case [objabi/R_ADDRMIPS objabi/R_ADDRMIPSU]
          ;; set up addend for eventual relocation via outer symbol.
          (let [(values _ off) (ld/FoldSubSymbolOffset ldr rs)
              ^{:line 103} xadd (+ ^{:go/via [Reloc]} (.Add r) off)]
            (return (applyrel (.-Arch target) ldr (.Type r) ^{:go/via [Reloc]} (.Off r) s val xadd) 1 true)))

        (case [objabi/R_ADDRMIPSTLS objabi/R_CALLMIPS objabi/R_JMPMIPS]
          (return (applyrel (.-Arch target) ldr (.Type r) ^{:go/via [Reloc]} (.Off r) s val ^{:go/via [Reloc]} (.Add r)) 1 true))))



    (let [^:const ^{:val true} isOk true
        ^:const ^{:line 112 :val 0} noExtReloc 0]
      (switch [rt (.Type r)] rt
        (case [objabi/R_ADDRMIPS objabi/R_ADDRMIPSU]
          (let [t (+ (.SymValue ldr rs) ^{:go/via [Reloc]} (.Add r))]
            (return (applyrel (.-Arch target) ldr rt ^{:go/via [Reloc]} (.Off r) s val t) noExtReloc isOk)))
        (case [objabi/R_CALLMIPS objabi/R_JMPMIPS]
          (let [t (+ (.SymValue ldr rs) ^{:go/via [Reloc]} (.Add r))]

            (when (!= (bit-and t 3) 0)
              (.Errorf ldr s "direct call is not aligned: %s %x" (.SymName ldr rs) t))


            ;; check if target address is in the same 256 MB region as the next instruction
            (when (!= (bit-and (+ (.SymValue ldr s) (conv int64 ^{:go/via [Reloc]} (.Off r)) 4) 0xf0000000) (bit-and t 0xf0000000))
              (.Errorf ldr s "direct call too far: %s %x" (.SymName ldr rs) t))


            (return (applyrel (.-Arch target) ldr rt ^{:go/via [Reloc]} (.Off r) s val t) noExtReloc isOk)))
        (case [objabi/R_ADDRMIPSTLS]
          ;; thread pointer is at 0x7000 offset from the start of TLS data area
          (let [t (- (+ (.SymValue ldr rs) ^{:go/via [Reloc]} (.Add r)) 0x7000)]
            (when (or (< t -32768) (>= t 32678))
              (.Errorf ldr s "TLS offset out of range %d" t))

            (return (applyrel (.-Arch target) ldr rt ^{:go/via [Reloc]} (.Off r) s val t) noExtReloc isOk))))


      (return val 0 false))))


^{:go/breaks [3] :go/end 144} (go/func archrelocvariant ^int64 [(* ld/Target) (* loader/Loader) loader/Reloc sym/RelocVariant loader/Sym int64 (slice byte)]
  -1)


^{:go/end 155} (go/func extreloc [^{:tag (* ld/Target)} target ^{:tag (* loader/Loader)} ldr ^loader/Reloc r ^loader/Sym s] :results [loader/ExtReloc bool]
  (switch (.Type r)
    (case [objabi/R_ADDRMIPS objabi/R_ADDRMIPSU]
      (return (ld/ExtrelocViaOuterSym ldr r s) true))

    (case [objabi/R_ADDRMIPSTLS objabi/R_CALLMIPS objabi/R_JMPMIPS]
      (return (ld/ExtrelocSimple ldr r) true)))

  (return (lit loader/ExtReloc) false))

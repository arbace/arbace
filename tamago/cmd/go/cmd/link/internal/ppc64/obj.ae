(in-ns 'go.cmd.link.internal.ppc64) (go/file "obj.go" :imports [


    ^{:line 34} [objabi "cmd/internal/objabi"]
    ^{:line 35} [sys "cmd/internal/sys"]
    ^{:line 36} [ld "cmd/link/internal/ld"]
    ^{:line 37} [buildcfg "internal/buildcfg"]])


^{:go/end 86} (go/func Init [] :results [(* sys/Arch) ld/Arch]
  (let [arch sys/ArchPPC64LE
      ^{:line 42} dynld "/lib64/ld64.so.2"
      ^{:line 43} musl "/lib/ld-musl-powerpc64le.so.1"]

    (when (== buildcfg/GOARCH "ppc64")
      (set! arch sys/ArchPPC64)
      (set! dynld "/lib64/ld64.so.2")
      (set! musl "/lib/ld-musl-powerpc64.so.1"))


    (let [theArch ^{:go/breaks [2 4 6 8 10 12 [14 59] 16 18 20 22 24 26 28 30 [32 69]]} (lit ld/Arch
          :Funcalign funcAlign
          :Maxalign maxAlign
          :Minalign minAlign
          :Dwarfregsp dwarfRegSP
          :Dwarfreglr dwarfRegLR
          :TrampLimit 0x1c00000

          :Adddynrel adddynrel
          :Archinit archinit
          :Archreloc archreloc
          :Archrelocvariant archrelocvariant
          :Extreloc extreloc
          :Gentext gentext
          :Trampoline trampoline
          :Machoreloc1 machoreloc1
          :Xcoffreloc1 xcoffreloc1

          :ELF ^{:go/breaks [2 4 [6 73] 8 10 12 14 [16 79] 18 20]} (lit ld/ELFArch
            :Linuxdynld dynld
            :LinuxdynldMusl musl

            :Freebsddynld "XXX"
            :Openbsddynld "/usr/libexec/ld.so"
            :Netbsddynld "XXX"
            :Dragonflydynld "XXX"
            :Solarisdynld "XXX"

            :Reloc1 elfreloc1
            :RelocSize 24
            :SetupPLT elfsetupplt))]



      (return arch theArch))))


^{:go/end 116} (go/func archinit [^{:tag (* ld/Link)} ctxt]
  (switch ^{:go/via [Target]} (.-HeadType ctxt)
    (default
      (ld/Exitf "unknown -H option: %v" ^{:go/via [Target]} (.-HeadType ctxt)))

    (case [objabi/Hplan9] ; /* plan 9 */
      (set! ld/HEADR 32)
      (when (== @ld/FlagRound -1)
        (set! @ld/FlagRound 4096))

      (when (== @ld/FlagTextAddr -1)
        (set! @ld/FlagTextAddr (+ (ld/Rnd 4096 @ld/FlagRound) (conv int64 ld/HEADR)))))


    (case [objabi/Hlinux ; /* ppc64 elf */
        ^{:line 103} objabi/Hopenbsd]
      (ld/Elfinit ctxt)
      (set! ld/HEADR ld/ELFRESERVE)
      (when (== @ld/FlagRound -1)
        (set! @ld/FlagRound 0x10000))

      (when (== @ld/FlagTextAddr -1)
        (set! @ld/FlagTextAddr (+ (ld/Rnd 0x10000 @ld/FlagRound) (conv int64 ld/HEADR)))))


    (case [objabi/Haix]
      (ld/Xcoffinit ctxt))))

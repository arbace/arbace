    (.SetUint32 su (.-Arch target) offset newinsn)))




^{:go/end 567} (go/func rewritetonop "Rewrite the instruction at offset into a hardware nop instruction. Also, verify the\nexisting instruction under mask matches the check value.\n" [^{:tag (* ld/Target)} target ^{:tag (* loader/Loader)} ldr ^{:tag (* loader/SymbolBuilder)} su ^int64 offset ^uint32 mask ^uint32 check]
  (rewritetoinsn target ldr su offset mask check OP_NOP))



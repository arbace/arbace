^{:go/end 1755} (go/func ensureglinkresolver "Generate the glink resolver stub if necessary and return the .glink section.\n" ^{:tag (* loader/SymbolBuilder)} [^{:tag (* ld/Link)} ctxt ^{:tag (* loader/Loader)} ldr]

            (.AddSymRef stub ^{:go/via [Target]} (.-Arch ctxt) plt (conv int64 (.SymPlt ldr targ)) objabi/R_ADDRPOWER_PCREL34 8)
            (.SetUint32 stub ^{:go/via [Target]} (.-Arch ctxt) (- (.Size stub) 8) OP_PLD_PFX_PCREL)
            (.SetUint32 stub ^{:go/via [Target]} (.-Arch ctxt) (- (.Size stub) 4) OP_PLD_SFX_R12)) ; pld r12, targ@plt
          (not (isLinkingPIC ctxt)) (do
            ;; This stub doesn't need to be PIC. Load targ address from the PLT via its absolute address.
            (.AddSymRef stub ^{:go/via [Target]} (.-Arch ctxt) plt (conv int64 (.SymPlt ldr targ)) objabi/R_ADDRPOWER_DS 8)
            (.SetUint32 stub ^{:go/via [Target]} (.-Arch ctxt) (- (.Size stub) 8) OP_LIS_R12) ; lis r12,targ@plt@ha
            (.SetUint32 stub ^{:go/via [Target]} (.-Arch ctxt) (- (.Size stub) 4) OP_LD_R12_R12)) :else ; ld r12,targ@plt@l(r12)

^{:go/end 436} (go/func genaddmoduledata [^{:tag (* ld/Link)} ctxt ^{:tag (* loader/Loader)} ldr]
  (let [(values initfunc addmoduledata) (ld/PrepareAddmoduledata ctxt)]
    (when (== initfunc nil)
      (return))


    (let [o ^{:go/end 384} (fn [^uint32 op]
          (.AddUint32 initfunc ^{:go/via [Target]} (.-Arch ctxt) op))]


      ;; Write a function to load this module's local.moduledata. This is shared code.
      ;;
      ;; package link
      ;; void addmoduledata() {
      ;;	runtime.addmoduledata(local.moduledata)
      ;; }

      (when (not hasPCrel)
        ;; Regenerate TOC from R12 (the address of this function).
        (let [sz (.AddSymRef initfunc ^{:go/via [Target]} (.-Arch ctxt) (aget ^{:go/via [ArchSyms]} (.-DotTOC ctxt) 0) 0 objabi/R_ADDRPOWER_PCREL 8)]
          (.SetUint32 initfunc ^{:go/via [Target]} (.-Arch ctxt) (- sz 8) 0x3c4c0000) ; addis r2, r12, .TOC.-func@ha
          (.SetUint32 initfunc ^{:go/via [Target]} (.-Arch ctxt) (- sz 4) 0x38420000))) ; addi r2, r2, .TOC.-func@l


      ;; This is Go ABI. Stack a frame and save LR.
      (o OP_MFLR_R0) ; mflr r0
      (o 0xf801ffe1) ; stdu r0, -32(r1)

      ;; Get the moduledata pointer from GOT and put into R3.
      (let [^loader/Sym tgt (zero loader/Sym)]
        (if [s (.Lookup ldr "local.moduledata" 0)] (!= s 0)
          (set! tgt s)
          (if [s (.Lookup ldr "local.pluginmoduledata" 0)] (!= s 0)
            (set! tgt s)

            (set! tgt (.LookupOrCreateSym ldr "runtime.firstmoduledata" 0))))


        (if (not hasPCrel)
          (let [sz (.AddSymRef initfunc ^{:go/via [Target]} (.-Arch ctxt) tgt 0 objabi/R_ADDRPOWER_GOT 8)]
            (.SetUint32 initfunc ^{:go/via [Target]} (.-Arch ctxt) (- sz 8) 0x3c620000) ; addis r3, r2, local.moduledata@got@ha
            (.SetUint32 initfunc ^{:go/via [Target]} (.-Arch ctxt) (- sz 4) 0xe8630000)) ; ld r3, local.moduledata@got@l(r3)


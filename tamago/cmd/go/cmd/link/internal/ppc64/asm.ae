            (.AddUint32 stub ^{:go/via [Target]} (.-Arch ctxt) OP_MFLR_R0) ; mflr r0
            (.AddUint32 stub ^{:go/via [Target]} (.-Arch ctxt) OP_BCL_NIA) ; bcl 20,31,1f
            (.AddUint32 stub ^{:go/via [Target]} (.-Arch ctxt) OP_MFLR_R12) ; 1: mflr r12  (r12 is the address of this instruction)
            (.AddUint32 stub ^{:go/via [Target]} (.-Arch ctxt) OP_MTLR_R0) ; mtlr r0
            (.AddSymRef stub ^{:go/via [Target]} (.-Arch ctxt) plt (+ (conv int64 (.SymPlt ldr targ)) 8) objabi/R_ADDRPOWER_PCREL 8)
            (.SetUint32 stub ^{:go/via [Target]} (.-Arch ctxt) (- (.Size stub) 8) OP_ADDIS_R12_R12) ; addis r12,(targ@plt - 1b) + 8
            (.SetUint32 stub ^{:go/via [Target]} (.-Arch ctxt) (- (.Size stub) 4) OP_ADDI_R12_R12) ; addi  r12,(targ@plt - 1b) + 12
            (.AddUint32 stub ^{:go/via [Target]} (.-Arch ctxt) OP_LD_R12_R12)))) ; ld r12, 0(r12)

      (default

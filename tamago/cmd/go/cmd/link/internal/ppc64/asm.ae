                (case [(.IsText t)]
                  (let [targ (.Sym r)]
                    (if (or ^:go/paren (and (.AttrExternal ldr targ) (!= (.SymLocalentry ldr targ) 1)) (not (.AttrExternal ldr targ))) (do)
                      ;; All local symbols share the same TOC pointer. This caller has a valid TOC
                      ;; pointer in R2. Calls into a Go symbol preserve R2. No call stub is needed.
                      (do
                        ;; This caller has a TOC pointer. The callee might clobber it. R2 needs to be saved
                        ;; and restored.
                        (when [(values sym firstUse) (genstub ctxt ldr r i s STUB_TOC)] firstUse
                          (set! stubs (append stubs sym)))))))))




            (case [(+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_PPC64_REL24_P9NOTOC))]
              ;; This can be treated identically to R_PPC64_REL24_NOTOC, as stubs are determined by
              ;; GOPPC64 and -buildmode.
              (fallthrough))
            (case [(+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_PPC64_REL24_NOTOC))]
              (switch [rt (.SymType ldr (.Sym r))]
                (case [(== rt sym/SDYNIMPORT)]
                  ;; This call goes through the PLT, generate and call through a PLT stub.
                  (when [(values sym firstUse) (genpltstub ctxt ldr r i s)] firstUse
                    (set! stubs (append stubs sym))))


                (case [(== rt sym/SXREF)]
                  ;; TODO: This is not supported yet.
                  (.Errorf ldr s "Unsupported NOTOC external reference call into %s" (.SymName ldr (.Sym r))))

                (case [(.IsText rt)]
                  (let [targ (.Sym r)]
                    (if (or ^:go/paren (and (.AttrExternal ldr targ) (<= (.SymLocalentry ldr targ) 1)) ^:go/paren (and (not (.AttrExternal ldr targ)) ^:go/paren (or (not (.AttrShared ldr targ)) hasPCrel))) (do)
                      ;; This is NOTOC to NOTOC call (st_other is 0 or 1). No call stub is needed.
                      (do
                        ;; This is a NOTOC to TOC function. Generate a calling stub.
                        (when [(values sym firstUse) (genstub ctxt ldr r i s STUB_PCREL)] firstUse
                          (set! stubs (append stubs sym)))))))))




            ;; Handle objects compiled with -fno-plt. Rewrite local calls to avoid indirect calling.
            ;; These are 0 sized relocs. They mark the mtctr r12, or bctrl + ld r2,24(r1).
            (case [(+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_PPC64_PLTSEQ))]
              (when (.IsText (.SymType ldr (.Sym r)))
                ;; This should be an mtctr instruction. Turn it into a nop.
                (let [su (.MakeSymbolUpdater ldr s)
                    ^:const ^{:line 340 :val 4229954558} MASK_OP_MTCTR (bit-or (<< 63 26) (<< 0x3FF 11) (<< 0x1FF 1))]
                  (rewritetonop (addr (.-Target ctxt)) ldr su (conv int64 ^{:go/via [Reloc]} (.Off r)) MASK_OP_MTCTR OP_MTCTR))))

            (case [(+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_PPC64_PLTCALL))]
              (when (.IsText (.SymType ldr (.Sym r)))
                ;; This relocation should point to a bctrl followed by a ld r2, 24(41)
                ;; Convert the bctrl into a bl.
                (let [su (.MakeSymbolUpdater ldr s)]
                  (rewritetoinsn (addr (.-Target ctxt)) ldr su (conv int64 ^{:go/via [Reloc]} (.Off r)) 0xFFFFFFFF OP_BCTRL OP_BL)

                  ;; Turn this reloc into an R_CALLPOWER, and convert the TOC restore into a nop.
                  (.SetRelocType su i objabi/R_CALLPOWER)
                  (let [localEoffset (conv int64 (.SymLocalentry ldr (.Sym r)))]
                    (when (== localEoffset 1)
                      (.Errorf ldr s "Unsupported NOTOC call to %s" (.SymName ldr (.Sym r))))

                    (.SetRelocAdd su i (+ ^{:go/via [Reloc]} (.Add r) localEoffset))

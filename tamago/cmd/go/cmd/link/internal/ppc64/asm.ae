^{:go/end 161} (go/func genstub "Generate a stub to call between TOC and NOTOC functions. See genpltstub for more details about calling stubs.\nThis is almost identical to genpltstub, except the location of the target symbol is known at link time.\n" [^{:tag (* ld/Link)} ctxt ^{:tag (* loader/Loader)} ldr ^loader/Reloc r ^int ri ^loader/Sym s ^int stubType] :results [^loader/Sym ssym ^bool firstUse]
  (let [addendStr ""]
    (when (!= ^{:go/via [Reloc]} (.Add r) 0)
      (set! addendStr (fmt/Sprintf "%+d" ^{:go/via [Reloc]} (.Add r))))


    (let [stubName (fmt/Sprintf "%s%s.%s" (aget stubStrs stubType) addendStr (.SymName ldr (.Sym r)))
        ^{:line 115} stub (.CreateSymForUpdate ldr stubName 0)]
      (set! firstUse (== (.Size stub) 0))
      (when firstUse
        (switch stubType
          ;; A call from a function using a TOC pointer.
          (case [STUB_TOC]
            (.AddUint32 stub ^{:go/via [Target]} (.-Arch ctxt) OP_TOCSAVE) ; std r2,24(r1)
            (.AddSymRef stub ^{:go/via [Target]} (.-Arch ctxt) (.Sym r) ^{:go/via [Reloc]} (.Add r) objabi/R_ADDRPOWER_TOCREL_DS 8)
            (.SetUint32 stub ^{:go/via [Target]} (.-Arch ctxt) (- (.Size stub) 8) OP_ADDIS_R12_R2) ; addis r12,r2,targ@toc@ha
            (.SetUint32 stub ^{:go/via [Target]} (.-Arch ctxt) (- (.Size stub) 4) OP_ADDI_R12_R12)) ; addi  r12,targ@toc@l(r12)

          ;; A call from PC relative function.
          (case [STUB_PCREL]
            (if (>= buildcfg/GOPPC64 10) (do
                ;; Set up address of targ in r12, PCrel
                (.AddSymRef stub ^{:go/via [Target]} (.-Arch ctxt) (.Sym r) ^{:go/via [Reloc]} (.Add r) objabi/R_ADDRPOWER_PCREL34 8)
                (.SetUint32 stub ^{:go/via [Target]} (.-Arch ctxt) (- (.Size stub) 8) OP_PLA_PFX)
                (.SetUint32 stub ^{:go/via [Target]} (.-Arch ctxt) (- (.Size stub) 4) OP_PLA_SFX_R12)) ; pla r12, r
              (do
                ;; The target may not be a P10. Generate a P8 compatible stub.
                (.AddUint32 stub ^{:go/via [Target]} (.-Arch ctxt) OP_MFLR_R0) ; mflr r0
                (.AddUint32 stub ^{:go/via [Target]} (.-Arch ctxt) OP_BCL_NIA) ; bcl 20,31,1f
                (.AddUint32 stub ^{:go/via [Target]} (.-Arch ctxt) OP_MFLR_R12) ; 1: mflr r12  (r12 is the address of this instruction)
                (.AddUint32 stub ^{:go/via [Target]} (.-Arch ctxt) OP_MTLR_R0) ; mtlr r0
                (.AddSymRef stub ^{:go/via [Target]} (.-Arch ctxt) (.Sym r) (+ ^{:go/via [Reloc]} (.Add r) 8) objabi/R_ADDRPOWER_PCREL 8)
                (.SetUint32 stub ^{:go/via [Target]} (.-Arch ctxt) (- (.Size stub) 8) OP_ADDIS_R12_R12) ; addis r12,(r - 1b) + 8
                (.SetUint32 stub ^{:go/via [Target]} (.-Arch ctxt) (- (.Size stub) 4) OP_ADDI_R12_R12))))) ; addi  r12,(r - 1b) + 12


        ;; Jump to the loaded pointer
        (.AddUint32 stub ^{:go/via [Target]} (.-Arch ctxt) OP_MTCTR_R12) ; mtctr r12
        (.AddUint32 stub ^{:go/via [Target]} (.-Arch ctxt) OP_BCTR) ; bctr
        (.SetType stub sym/STEXT))


      ;; Update the relocation to use the call stub
      (let [su (.MakeSymbolUpdater ldr s)]
        (.SetRelocSym su ri (.Sym stub))


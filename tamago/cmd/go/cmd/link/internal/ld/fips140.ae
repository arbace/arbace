                          (set! data (subslice data (* 2 (.-PtrSize ^{:go/via [Target]} (.-Arch ctxt)))))
                          (range [_ sect (.-Sections pf)]
                            (when (and (<= (conv int64 ^{:go/via [SectionHeader]} (.-VirtualAddress sect)) start) (<= start end) (<= end (+ (conv int64 ^{:go/via [SectionHeader]} (.-VirtualAddress sect)) (conv int64 ^{:go/via [SectionHeader]} (.-Size sect)))))
                              (let [off (- (conv int64 ^{:go/via [SectionHeader]} (.-Offset sect)) (conv int64 ^{:go/via [SectionHeader]} (.-VirtualAddress sect)))]
                                (when [err (.addSection f (+ start off) (+ end off))] (!= err nil)
                                  (return err))

                                (continue :Addrs))))


                          (return (fmt/Errorf "invalid pointers found in go:fipsinfo")))))


                    ;; Overwrite the go:fipsinfo sum field with the calculated sum.
                    (when [(values _ err) (.WriteAt wf (.sum f) (+ (conv int64 ^{:go/via [SectionHeader]} (.-Offset sect)) off fipsMagicLen))] (!= err nil)
                      (return err))

                    (when [err (.Close wf)] (!= err nil)
                      (return err))

                    (.Close f)))))))))))

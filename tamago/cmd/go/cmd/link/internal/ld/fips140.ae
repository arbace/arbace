      (return (elffips ctxt exe fipso)))
    (case [(== ^{:go/via [Target]} (.-HeadType ctxt) objabi/Hdarwin)]
      (return (machofips ctxt exe fipso)))
    (case [(== ^{:go/via [Target]} (.-HeadType ctxt) objabi/Hwindows)]
      (return (pefips ctxt exe fipso))))



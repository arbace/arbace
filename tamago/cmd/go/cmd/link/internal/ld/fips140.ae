;; /*
;; FIPS-140 Verification Support
;; 
;; See ../../../internal/obj/fips.go for a basic overview.
;; This file is concerned with computing the hash of the FIPS code+data.
;; Package obj has taken care of marking the FIPS symbols with the
;; special types STEXTFIPS, SRODATAFIPS, SNOPTRDATAFIPS, and SDATAFIPS.
;; 
;; # FIPS Symbol Layout
;; 
;; The first order of business is collecting the FIPS symbols into
;; contiguous sections of the final binary and identifying the start and
;; end of those sections. The linker already tracks the start and end of
;; the text section as runtime.text and runtime.etext, and similarly for
;; other sections, but the implementation of those symbols is tricky and
;; platform-specific. The problem is that they are zero-length
;; pseudo-symbols that share addresses with other symbols, which makes
;; everything harder. For the FIPS sections, we avoid that subtlety by
;; defining actual non-zero-length symbols bracketing each section and
;; use those symbols as the boundaries.
;; 
;; Specifically, we define a 1-byte symbol go:textfipsstart of type
;; STEXTFIPSSTART and a 1-byte symbol go:textfipsend of type STEXTFIPSEND,
;; and we place those two symbols immediately before and after the
;; STEXTFIPS symbols. We do the same for SRODATAFIPS, SNOPTRDATAFIPS,
;; and SDATAFIPS. Because the symbols are real (but otherwise unused) data,
;; they can be treated as normal symbols for symbol table purposes and
;; don't need the same kind of special handling that runtime.text and
;; friends do.
;; 
;; Note that treating the FIPS text as starting at &go:textfipsstart and
;; ending at &go:textfipsend means that go:textfipsstart is included in
;; the verified data while go:textfipsend is not. That's fine: they are
;; only framing and neither strictly needs to be in the hash.
;; 
;; The new special symbols are created by [loadfips].
;; 
;; # FIPS Info Layout
;; 
;; Having collated the FIPS symbols, we need to compute the hash
;; and then leave both the expected hash and the FIPS address ranges
;; for the run-time check in crypto/internal/fips140/check.
;; We do that by creating a special symbol named go:fipsinfo of the form
;; 
;; struct {
;; sum   [32]byte
;; self  uintptr // points to start of struct
;; sects [4]struct{
;; start uintptr
;; end   uintptr
;; }
;; }
;; 
;; The crypto/internal/fips140/check uses linkname to access this symbol,
;; which is of course not included in the hash.
;; 
;; # FIPS Info Calculation
;; 
;; When using internal linking, [asmbfips] runs after writing the output
;; binary but before code-signing it. It reads the relevant sections
;; back from the output file, hashes them, and then writes the go:fipsinfo
;; content into the output file.
;; 
;; When using external linking, especially with -buildmode=pie, we cannot
;; predict the specific PLT index references that the linker will insert
;; into the FIPS code sections, so we must read the final linked executable
;; after external linking, compute the hash, and then write it back to the
;; executable in the go:fipsinfo sum field. [hostlinkfips] does this.
;; It finds go:fipsinfo easily because that symbol is given its own section
;; (.go.fipsinfo on ELF, __go_fipsinfo on Mach-O), and then it can use the
;; sections field to find the relevant parts of the executable, hash them,
;; and fill in sum.
;; 
;; Both [asmbfips] and [hostlinkfips] need the same hash calculation code.
;; The [fipsObj] type provides that calculation.
;; 
;; # Debugging
;; 
;; It is of course impossible to debug a mismatched hash directly:
;; two random 32-byte strings differ. For debugging, the linker flag
;; -fipso can be set to the name of a file (such as /tmp/fips.o)
;; where the linker will write the “FIPS object” that is being hashed.
;; 
;; There is also commented-out code in crypto/internal/fips140/check that
;; will write /tmp/fipscheck.o during the run-time verification.
;; 
;; When the hashes differ, the first step is to uncomment the
;; /tmp/fipscheck.o-writing code and then rebuild with
;; -ldflags=-fipso=/tmp/fips.o. Then when the hash check fails,
;; compare /tmp/fips.o and /tmp/fipscheck.o to find the differences.
;; */

(in-ns 'go.cmd.link.internal.ld) (go/file "fips140.go" :imports [


    ^{:line 100} [bufio "bufio"]
    ^{:line 101} [bytes "bytes"]
    ^{:line 102} [obj "cmd/internal/obj"]
    ^{:line 103} [objabi "cmd/internal/objabi"]
    ^{:line 104} [loader "cmd/link/internal/loader"]
    ^{:line 105} [sym "cmd/link/internal/sym"]
    ^{:line 106} [hmac "crypto/hmac"]
    ^{:line 107} [sha256 "crypto/sha256"]
    ^{:line 108} [elf "debug/elf"]
    ^{:line 109} [macho "debug/macho"]
    ^{:line 110} [pe "debug/pe"]
    ^{:line 111} [binary "encoding/binary"]
    ^{:line 112} [fmt "fmt"]
    ^{:line 113} [hash "hash"]
    ^{:line 114} [io "io"]
    ^{:line 115} [os "os"]])


(go/const ^{:val true} enableFIPS true)


(go/var ^{:doc "fipsSyms are the special FIPS section bracketing symbols.\n"} fipsSyms (lit (slice (struct
        ^{:line 122 :tag string} name
        ^{:line 123 :tag sym/SymKind} kind
        ^{:line 124 :tag loader/Sym} sym
        ^{:line 125 :tag (* sym/Segment)} seg))

    (lit _ :name "go:textfipsstart" :kind sym/STEXTFIPSSTART :seg (addr Segtext))
    (lit _ :name "go:textfipsend" :kind sym/STEXTFIPSEND)
    (lit _ :name "go:rodatafipsstart" :kind sym/SRODATAFIPSSTART :seg (addr Segrodata))
    (lit _ :name "go:rodatafipsend" :kind sym/SRODATAFIPSEND)
    (lit _ :name "go:noptrdatafipsstart" :kind sym/SNOPTRDATAFIPSSTART :seg (addr Segdata))
    (lit _ :name "go:noptrdatafipsend" :kind sym/SNOPTRDATAFIPSEND)
    (lit _ :name "go:datafipsstart" :kind sym/SDATAFIPSSTART :seg (addr Segdata))
    (lit _ :name "go:datafipsend" :kind sym/SDATAFIPSEND)))



(go/var ^{:tag loader/Sym :doc "fipsinfo is the loader symbol for go:fipsinfo.\n"} fipsinfo)

(go/const
  ^{:line 141} [^{:val (byte-string 0xff " Go fipsinfo " 0xff "\u0000")} fipsMagic (byte-string 0xff " Go fipsinfo " 0xff "\u0000")]
  ^{:line 142} [^{:val 16} fipsMagicLen 16]
  ^{:line 143} [^{:val 32} fipsSumLen 32])



^{:go/end 180} (go/func loadfips "loadfips creates the special bracketing symbols and go:fipsinfo.\n" [^{:tag (* Link)} ctxt]
  (when (not (obj/EnableFIPS))
    (return))

  (when (== ^{:go/via [Target]} (.-BuildMode ctxt) BuildModePlugin) ; not sure why this doesn't work
    (return))

  ;; Write the fipsinfo symbol, which crypto/internal/fips140/check uses.
  (let [ldr (.-loader ctxt)
      ;; TODO lock down linkname
      ^{:line 157} info (.CreateSymForUpdate ldr "go:fipsinfo" 0)]
    (.SetType info sym/SFIPSINFO)

    (let [data (make (slice byte) (+ fipsMagicLen fipsSumLen))]
      (copy data fipsMagic)
      (.SetData info data)
      (.SetSize info (conv int64 (len data))) ; magic + checksum, to be filled in
      (.AddAddr info ^{:go/via [Target]} (.-Arch ctxt) (.Sym info)) ; self-reference

      (range [i fipsSyms]
        (let [s (addr (aget fipsSyms i))
            ^{:line 168} sb (.CreateSymForUpdate ldr (.-name s) 0)]
          (.SetType sb (.-kind s))
          (.SetLocal sb true)
          (.SetSize sb 1)
          (set! (.-sym s) (.Sym sb))
          (.AddAddr info ^{:go/via [Target]} (.-Arch ctxt) (.-sym s))
          (when (or (== (.-kind s) sym/STEXTFIPSSTART) (== (.-kind s) sym/STEXTFIPSEND))
            (set! (.-Textp ctxt) (append (.-Textp ctxt) (.-sym s))))))



      (set! fipsinfo (.Sym info)))))




(go/type fipsObj "fipsObj calculates the fips object hash and optionally writes\nthe hashed content to a file for debugging.\n" (struct
    ^{:line 185 :tag io/ReaderAt} r
    ^{:line 186 :tag io/Writer} w
    ^{:line 187 :tag (* os/File)} wf
    ^{:line 188 :tag hash/Hash} h
    ^{:line 189 :tag (array 8 byte)} tmp))





^{:go/end 213} (go/func newFipsObj "newFipsObj creates a fipsObj reading from r and writing to fipso\n(unless fipso is the empty string, in which case it writes nowhere\nand only computes the hash).\n" [^io/ReaderAt r ^string fipso] :results [(* fipsObj) error]
  (let [f (addr (lit fipsObj :r r))]
    (set! (.-h f) (hmac/New sha256/New (make (slice byte) 32)))
    (set! (.-w f) (.-h f))
    (when (!= fipso "")
      (let [(values wf err) (os/Create fipso)]
        (when (!= err nil)
          (return nil err))

        (set! (.-wf f) wf)
        (set! (.-w f) (io/MultiWriter (.-h f) wf))))


    (when [(values _ err) (.Write (.-w f) (conv (slice byte) "go fips object v1\n"))] (!= err nil)
      (.Close f)
      (return nil err))

    (return f nil)))





^{:go/end 224} (go/method addSection "addSection adds the section of r (passed to newFipsObj)\nstarting at byte offset start and ending before byte offset end\nto the fips object file.\n" ^error [^{:tag (* fipsObj)} f ^int64 start ^int64 end]
  (let [n (- end start)]
    (.PutUint64 binary/BigEndian (subslice (.-tmp f)) (conv uint64 n))
    (.Write (.-w f) (subslice (.-tmp f)))
    (let [(values _ err) (io/Copy (.-w f) (io/NewSectionReader (.-r f) start n))]
      ^{:line 223} err)))



^{:go/end 229} (go/method sum "sum returns the hash of the fips object file.\n" ^{:tag (slice byte)} [^{:tag (* fipsObj)} f]
  (.Sum (.-h f) nil))




^{:go/breaks [[5 237]] :go/end 238} (go/method Close "Close closes the fipsObj. In particular it closes the output\nobject file specified by fipso in the call to [newFipsObj].\n" ^error [^{:tag (* fipsObj)} f]
  (when (!= (.-wf f) nil)
    (return (.Close (.-wf f))))

  nil)





^{:go/end 299} (go/func asmbfips "asmbfips is called from [asmb] to update go:fipsinfo\nwhen using internal linking.\nSee [hostlinkfips] for external linking.\n" [^{:tag (* Link)} ctxt ^string fipso]
  (when (not (obj/EnableFIPS))
    (return))

  (when (== ^{:go/via [Target]} (.-LinkMode ctxt) LinkExternal)
    (return))

  (when (== ^{:go/via [Target]} (.-BuildMode ctxt) BuildModePlugin) ; not sure why this doesn't work

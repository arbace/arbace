^{:go/end 324} (go/func hostlinkfips "hostlinkfips is called from [hostlink] to update go:fipsinfo\nwhen using external linking.\nSee [asmbfips] for internal linking.\n" ^error [^{:tag (* Link)} ctxt ^string exe ^string fipso]
  (when (not (obj/EnableFIPS))
    (return nil))

  (when (== ^{:go/via [Target]} (.-BuildMode ctxt) BuildModePlugin) ; not sure why this doesn't work
    (return nil))

  (switch

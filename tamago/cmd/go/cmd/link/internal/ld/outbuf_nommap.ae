(in-ns 'go.cmd.link.internal.ld) (go/file "outbuf_nommap.go" :build ["//go:build !unix && !windows"] :imports [])



^{:go/end 20} (go/method Mmap "Mmap allocates an in-heap output buffer with the given size. It copies\nany old data (if any) to the new buffer.\n" ^error [^{:tag (* OutBuf)} out ^uint64 filesize]
  ;; We need space to put all the symbols before we apply relocations.
  ^{:go/breaks [5]} (let [oldheap (.-heap out)]
    (when (< filesize (conv uint64 (len oldheap)))
      (panic "mmap size too small"))

    (set! (.-heap out) (make (slice byte) filesize))
    (copy (.-heap out) oldheap)
    nil))


^{:go/end 22} (go/method munmap [^{:tag (* OutBuf)} out] (panic "unreachable"))

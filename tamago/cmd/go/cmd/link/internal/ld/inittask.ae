^{:go/end 78} (go/method inittasks "Inittasks finds inittask records, figures out a good\norder to execute them in, and emits that order for the\nruntime to use.\n\nAn inittask represents the initialization code that needs\nto be run for a package. For package p, the p..inittask\nsymbol contains a list of init functions to run, both\nexplicit user init functions and implicit compiler-generated\ninit functions for initializing global variables like maps.\n\nIn addition, inittask records have dependencies between each\nother, mirroring the import dependencies. So if package p\nimports package q, then there will be a dependency p -> q.\nWe can't initialize package p until after package q has\nalready been initialized.\n\nPackage dependencies are encoded with relocations. If package\np imports package q, then package p's inittask record will\nhave a R_INITORDER relocation pointing to package q's inittask\nrecord. See cmd/compile/internal/pkginit/init.go.\n\nThis function computes an ordering of all of the inittask\nrecords so that the order respects all the dependencies,\nand given that restriction, orders the inittasks in\nlexicographic order.\n" [^{:tag (* Link)} ctxt]
  (switch ^{:go/via [Target]} (.-BuildMode ctxt)
    (case [BuildModeExe BuildModePIE BuildModeCArchive BuildModeCShared]
      ;; Normally the inittask list will be run on program startup.
      (set! ^{:go/via [ArchSyms]} (.-mainInittasks ctxt) (.inittaskSym ctxt (lit (slice string) "main..inittask") "go:main.inittasks")))
    (case [BuildModePlugin]
      ;; For plugins, the list will be run on plugin load.
      (set! ^{:go/via [ArchSyms]} (.-mainInittasks ctxt) (.inittaskSym ctxt (lit (slice string) (fmt/Sprintf "%s..inittask" (objabi/PathToPrefix @flagPluginPath))) "go:plugin.inittasks"))
      ;; Make symbol local so multiple plugins don't clobber each other's inittask list.
      (.SetAttrLocal (.-loader ctxt) ^{:go/via [ArchSyms]} (.-mainInittasks ctxt) true))
    (case [BuildModeShared]
      ;; For a shared library, all packages are roots.
      (let [^{:tag (slice string)} roots (zero (slice string))]
        (range [_ lib (.-Library ctxt)]
          (set! roots (append roots (fmt/Sprintf "%s..inittask" (objabi/PathToPrefix (.-Pkg lib))))))

        (set! ^{:go/via [ArchSyms]} (.-mainInittasks ctxt) (.inittaskSym ctxt roots "go:shlib.inittasks"))
        ;; Make symbol local so multiple plugins don't clobber each other's inittask list.
        (.SetAttrLocal (.-loader ctxt) ^{:go/via [ArchSyms]} (.-mainInittasks ctxt) true)))
    (default
      (Exitf "unhandled build mode %d" ^{:go/via [Target]} (.-BuildMode ctxt))))


  ;; If the runtime is one of the packages we are building,
  ;; initialize the runtime_inittasks variable.
  (let [ldr (.-loader ctxt)]
    (when (!= (.Lookup ldr "runtime.runtime_inittasks" 0) 0)
      (let [t (.inittaskSym ctxt (lit (slice string) "runtime..inittask") "go:runtime.inittasks")

          ;; This slice header is already defined in runtime/proc.go, so we update it here with new contents.
          ^{:line 70} sh (.Lookup ldr "runtime.runtime_inittasks" 0)
          ^{:line 71} sb (.MakeSymbolUpdater ldr sh)]
        (.SetSize sb 0)
        (.SetType sb sym/SNOPTRDATA) ; Could be SRODATA, but see issue 58857.
        (.AddAddr sb ^{:go/via [Target]} (.-Arch ctxt) t)
        (.AddUint sb ^{:go/via [Target]} (.-Arch ctxt) (conv uint64 (/ (.SymSize ldr t) (conv int64 (.-PtrSize ^{:go/via [Target]} (.-Arch ctxt))))))
        (.AddUint sb ^{:go/via [Target]} (.-Arch ctxt) (conv uint64 (/ (.SymSize ldr t) (conv int64 (.-PtrSize ^{:go/via [Target]} (.-Arch ctxt))))))))))





^{:go/end 189} (go/method inittaskSym "inittaskSym builds a symbol containing pointers to all the inittasks\nthat need to be run, given a list of root inittask symbols.\n" ^loader/Sym [^{:tag (* Link)} ctxt ^{:tag (slice string)} rootNames ^string symName]
  (let [ldr (.-loader ctxt)
      ^{:line 84 :tag (slice loader/Sym)} roots (zero (slice loader/Sym))]
    (range [_ n rootNames]
      (let [p (.Lookup ldr n 0)]
        (when (!= p 0)
          (set! roots (append roots p)))))


    (when (== (len roots) 0)
      ;; Nothing to do
      (return 0))


    ;; Edges record dependencies between packages.
    ;; {from,to} is in edges if from's package imports to's package.
    ;; This list is used to implement reverse edge lookups.
    (let-type [edge (struct
          ^{:line 100 :tag loader/Sym} from ^loader/Sym to)]

      (let [^{:tag (slice edge)} edges (zero (slice edge))

          ;; List of packages that are ready to schedule. We use a lexicographic
          ;; ordered heap to pick the lexically earliest uninitialized but
          ;; inititalizeable package at each step.
          ^{:line 107 :tag lexHeap} h (zero lexHeap)

          ;; m maps from an inittask symbol for package p to the number of
          ;; p's direct imports that have not yet been scheduled.
          ^{:line 111} m (lit (map loader/Sym int))

          ;; Find all reachable inittask records from the roots.
          ;; Keep track of the dependency edges between them in edges.
          ;; Keep track of how many imports each package has in m.
          ;; q is the list of found but not yet explored packages.
          ^{:line 117 :tag (slice loader/Sym)} q (zero (slice loader/Sym))]
        (range [_ p roots]
          (aset m p 0)
          (set! q (append q p)))

        (while (> (len q) 0)
          (let [x (aget q (- (len q) 1))]
            (set! q (subslice q _ (- (len q) 1)))
            (let [relocs (.Relocs ldr x)
                ^{:line 126} n (.Count relocs)
                ^{:line 127} ndeps 0]
              (for [i 0] (< i n) (inc! i)
                (let [r (.At relocs i)]
                  (when (!= (.Type r) objabi/R_INITORDER)
                    (continue))

                  (inc! ndeps)
                  (let [s (.Sym r)]
                    (set! edges (append edges (lit edge :from x :to s)))
                    (when [(values _ ok) (aget m s)] ok
                      (continue)) ; already found

                    (set! q (append q s))
                    (aset m s 0)))) ; mark as found

              (aset m x ndeps)
              (when (== ndeps 0)
                (.push h ldr x)))))



        ;; Sort edges so we can look them up by edge destination.
        (sort/Slice edges ^{:go/end 151} (fn ^bool [^int i ^int j]
            (< (.-to (aget edges i)) (.-to (aget edges j)))))


        ;; Figure out the schedule.
        (let [sched (.MakeSymbolBuilder ldr symName)]
          (.SetType sched sym/SNOPTRDATA) ; Could be SRODATA, but see issue 58857.
          (while (not (.empty h))
            ;; Pick the lexicographically first initializable package.
            (let [s (.pop h ldr)]

              ;; Add s to the schedule.
              (when (> (.SymSize ldr s) 8)
                ;; Note: don't add s if it has no functions to run. We need
                ;; s during linking to compute an ordering, but the runtime
                ;; doesn't need to know about it. About 1/2 of stdlib packages
                ;; fit in this bucket.
                (.AddAddr sched ^{:go/via [Target]} (.-Arch ctxt) s))


              ;; Find all incoming edges into s.
              (let [a (sort/Search (len edges) ^{:go/end 170} (fn ^bool [^int i] (>= (.-to (aget edges i)) s)))
                  ^{:line 171} b (sort/Search (len edges) ^{:go/end 171} (fn ^bool [^int i] (> (.-to (aget edges i)) s)))]

                ;; Decrement the import count for all packages that import s.
                ;; If the count reaches 0, that package is now ready to schedule.
                (range [_ e (subslice edges a b)]
                  (dec! (aget m (.-from e)))
                  (when (== (aget m (.-from e)) 0)
                    (.push h ldr (.-from e)))))))




          (range [s n m]
            (when (!= n 0)
              (Exitf "inittask for %s is not schedulable %d" (.SymName ldr s) n)))


          (.Sym sched))))))

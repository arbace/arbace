(in-ns 'go.cmd.link.internal.ld) (go/file "sym.go" :imports [


    ^{:line 35} [objabi "cmd/internal/objabi"]
    ^{:line 36} [sys "cmd/internal/sys"]
    ^{:line 37} [loader "cmd/link/internal/loader"]
    ^{:line 38} [sym "cmd/link/internal/sym"]
    ^{:line 39} [buildcfg "internal/buildcfg"]
    ^{:line 40} [log "log"]
    ^{:line 41} [runtime "runtime"]])


^{:go/end 69} (go/func linknew ^{:tag (* Link)} [^{:tag (* sys/Arch)} arch]
  (let [ler (lit loader/ErrorReporter :AfterErrorAction afterErrorAction)
      ^{:line 46} ctxt (addr ^{:go/breaks [2 4 6 8 10 12 14 16]} (lit Link
          :Target (lit Target :Arch arch)
          :version sym/SymVerStatic
          :outSem (make (chan int) (* 2 (runtime/GOMAXPROCS 0)))
          :Out (NewOutBuf arch)
          :LibraryByPkg (make (map string (* sym/Library)))
          :numelfsym 1
          :ErrorReporter (lit ErrorReporter :ErrorReporter ler)
          :generatorSyms (make (map loader/Sym generatorFunc))))]


    (when (!= buildcfg/GOARCH (.-Name arch))
      (log/Fatalf "invalid buildcfg.GOARCH %s (want %s)" buildcfg/GOARCH (.-Name arch)))


    (AtExit ^{:go/end 66} (fn []
        (when (> nerrors 0)
          (.ErrorClose (.-Out ctxt))
          (mayberemoveoutfile))))



    ^{:line 68} ctxt))




^{:go/end 118} (go/method computeTLSOffset "computeTLSOffset records the thread-local storage offset.\nNot used for Android where the TLS offset is determined at runtime.\n" [^{:tag (* Link)} ctxt]
  (switch ^{:go/via [Target]} (.-HeadType ctxt)
    (default
      (log/Fatalf "unknown thread-local storage offset for %v" ^{:go/via [Target]} (.-HeadType ctxt)))

    (case [objabi/Hplan9 objabi/Hwindows objabi/Hjs objabi/Hwasip1 objabi/Haix]
      (break))

    (case [objabi/Hlinux
        ^{:line 82} objabi/Hfreebsd
        ^{:line 83} objabi/Hnetbsd
        ^{:line 84} objabi/Hopenbsd
        ^{:line 85} objabi/Hdragonfly
        ^{:line 86} objabi/Hsolaris
        ^{:line 87} objabi/Htamago]
      ;; /*
      ;; * ELF uses TLS offset negative from FS.
      ;; * Translate 0(FS) and 8(FS) into -16(FS) and -8(FS).
      ;; * Known to low-level assembly in package runtime and runtime/cgo.
      ;; */
      (set! ^{:go/via [ArchSyms]} (.-Tlsoffset ctxt) (* -1 (.-PtrSize ^{:go/via [Target]} (.-Arch ctxt)))))

    (case [objabi/Hdarwin]
      ;; /*
      ;; * OS X system constants - offset from 0(GS) to our TLS.
      ;; */
      (switch (.-Family ^{:go/via [Target]} (.-Arch ctxt))
        (default
          (log/Fatalf "unknown thread-local storage offset for darwin/%s" (.-Name ^{:go/via [Target]} (.-Arch ctxt))))

        ;; /*
        ;; * For x86, Apple has reserved a slot in the TLS for Go. See issue 23617.
        ;; * That slot is at offset 0x30 on amd64.
        ;; * The slot will hold the G pointer.
        ;; * These constants should match those in runtime/sys_darwin_amd64.s
        ;; * and runtime/cgo/gcc_darwin_amd64.c.
        ;; */
        (case [sys/AMD64]
          (set! ^{:go/via [ArchSyms]} (.-Tlsoffset ctxt) 0x30))

        (case [sys/ARM64]
          (set! ^{:go/via [ArchSyms]} (.-Tlsoffset ctxt) 0)))))) ; dummy value, not needed

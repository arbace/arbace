              ;; We need to generate a trampoline when an address is
              ;; currently unknown.
              (when (not (.IsRISCV64 (.-Target ctxt)))
                (continue)))


            ;; Runtime packages are laid out together.
            (when (and (isRuntimeDepPkg (.SymPkg ldr s)) (isRuntimeDepPkg (.SymPkg ldr rs)) (== @flagRandLayout 0))
              (continue)))


          ((.-Trampoline thearch) ctxt ldr ri rs s))))))





^{:go/end 163} (go/func isPLTCall "whether rt is a (host object) relocation that will be turned into\na call to PLT.\n" ^bool [^{:tag (* sys/Arch)} arch ^objabi/RelocType rt]

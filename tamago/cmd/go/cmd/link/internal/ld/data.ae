^{:go/end 94} (go/func maxSizeTrampolines "Estimate the max size needed to hold any new trampolines created for this function. This\nis used to determine when the section can be split if it becomes too large, to ensure that\nthe trampolines are in the same section as the function that uses them.\n" ^uint64 [^{:tag (* Link)} ctxt ^{:tag (* loader/Loader)} ldr ^loader/Sym s ^bool isTramp]
  ;; If thearch.Trampoline is nil, then trampoline support is not available on this arch.
  ;; A trampoline does not need any dependent trampolines.
  (when (or (== (.-Trampoline thearch) nil) isTramp)
    (return 0))


  (let [n (conv uint64 0)
      ^{:line 73} relocs (.Relocs ldr s)]
    (for [ri 0] (< ri (.Count relocs)) (inc! ri)
      (let [r (.At relocs ri)]
        (when (.IsDirectCallOrJump (.Type r))
          (inc! n))))



    (switch
      (case [^{:go/via [Target]} (.IsARM ctxt)]
        (return (* n 20))) ; Trampolines in ARM range from 3 to 5 instructions.
      (case [^{:go/via [Target]} (.IsARM64 ctxt)]
        (return (* n 12))) ; Trampolines in ARM64 are 3 instructions.
      (case [^{:go/via [Target]} (.IsLOONG64 ctxt)]
        (return (* n 12))) ; Trampolines in LOONG64 are 3 instructions.
      (case [^{:go/via [Target]} (.IsPPC64 ctxt)]
        (return (* n 16))) ; Trampolines in PPC64 are 4 instructions.
      (case [^{:go/via [Target]} (.IsRISCV64 ctxt)]
        (return (* n 8)))) ; Trampolines in RISCV64 are 2 instructions.

    (panic "unreachable")))






^{:go/end 138} (go/func trampoline "Detect too-far jumps in function s, and add trampolines if necessary.\nARM, LOONG64, PPC64, PPC64LE and RISCV64 support trampoline insertion for internal\nand external linking. On PPC64 and PPC64LE the text sections might be split\nbut will still insert trampolines where necessary.\n" [^{:tag (* Link)} ctxt ^loader/Sym s]

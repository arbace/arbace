      (case [(bit-or (conv uint32 sys/ARM64) (<< (conv uint32 (+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_AARCH64_CALL26))) 8))
          (bit-or (conv uint32 sys/ARM64) (<< (conv uint32 (+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_AARCH64_JUMP26))) 8))
          (bit-or (conv uint32 sys/ARM64) (<< (conv uint32 (+ objabi/MachoRelocOffset (* MACHO_ARM64_RELOC_BRANCH26 2) pcrel)) 8))]
        (return true))

      ;; ARM
      (case [(bit-or (conv uint32 sys/ARM) (<< (conv uint32 (+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_ARM_CALL))) 8))
          (bit-or (conv uint32 sys/ARM) (<< (conv uint32 (+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_ARM_PC24))) 8))
          (bit-or (conv uint32 sys/ARM) (<< (conv uint32 (+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_ARM_JUMP24))) 8))]
        (return true))

      ;; Loong64
      (case [(bit-or (conv uint32 sys/Loong64) (<< (conv uint32 (+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_LARCH_B26))) 8))]
        (return true)))

    ;; TODO: other architectures.
    false))






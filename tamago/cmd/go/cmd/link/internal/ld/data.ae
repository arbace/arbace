          (.Bytes buf))))))










^{:go/breaks [[6 3460]] :go/end 3461} (go/func writeUleb128FixedLength "writeUleb128FixedLength writes out value v in LEB128 encoded\nformat, ensuring that the space written takes up length bytes. When\nextra space is needed, we write initial bytes with just the\ncontinuation bit set. For example, if val is 1 and length is 3,\nwe'll write 0x80 0x80 0x1 (first two bytes with zero val but\ncontinuation bit set). NB: this function adapted from a similar\nfunction in cmd/link/internal/wasm, they could be commoned up if\nneeded.\n" ^error [^{:tag (slice byte)} b ^uint64 v ^int length]
  (for [i 0] (< i length) (inc! i)
    (let [c (conv uint8 (bit-and v 0x7f))]
      (set! v >> 7)
      (when (< i (- length 1))
        (set! c bit-or 0x80))

      (aset b i c)))

  (when (!= v 0)
    (return (fmt/Errorf "writeUleb128FixedLength: length too small")))

  nil)

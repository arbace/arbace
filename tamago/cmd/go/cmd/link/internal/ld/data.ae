            ;; which may call an external symbol via PLT.
            (when (and (!= (.SymPkg ldr s) "") (== (.SymPkg ldr rs) (.SymPkg ldr s)) (== (.SymType ldr rs) (.SymType ldr s)) (== @flagRandLayout 0))

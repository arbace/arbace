      ^{:line 106} relocs (.Relocs ldr s)]
    (for [ri 0] (< ri (.Count relocs)) (inc! ri)
      (let [r (.At relocs ri)
          ^{:line 109} rt (.Type r)]
        (when (and (not (.IsDirectCallOrJump rt)) (not (isPLTCall ^{:go/via [Target]} (.-Arch ctxt) rt)))
          (continue))

        (let [rs (.Sym r)]
          (when (or (not (.AttrReachable ldr rs)) (== (.SymType ldr rs) sym/Sxxx))
            (continue)) ; something is wrong. skip it here and we'll emit a better error later


          (when (and (== (.SymValue ldr rs) 0) (!= (.SymType ldr rs) sym/SDYNIMPORT) (!= (.SymType ldr rs) sym/SUNDEFEXT))
            ;; Symbols in the same package are laid out together (if we
            ;; don't randomize the function order).

^{:go/end 3358} (go/method AddTramp "add a trampoline with symbol s (to be laid down after the current function)\n" [^{:tag (* Link)} ctxt ^{:tag (* loader/SymbolBuilder)} s ^sym/SymKind typ]
  (.SetType s typ)
  (.SetReachable s true)
  (.SetOnList s true)
  (set! (.-tramps ctxt) (append (.-tramps ctxt) (.Sym s)))
  (when (and (> @FlagDebugTramp 0) (> (.-Debugvlog ctxt) 0))
    (.Logf ctxt "trampoline %s inserted\n" (.Name s))))





^{:go/end 3438} (go/func compressSyms "compressSyms compresses syms and returns the contents of the\ncompressed section. If the section would get larger, it returns nil.\n" ^{:tag (slice byte)} [^{:tag (* Link)} ctxt ^{:tag (slice loader/Sym)} syms]

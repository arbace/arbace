(in-ns 'go.cmd.link.internal.ld) (go/file "macho_update_uuid.go" :imports [

    ;; This file provides helper functions for updating/rewriting the UUID
    ;; load command within a Go go binary generated on Darwin using
    ;; external linking. Why is it necessary to update the UUID load
    ;; command? See issue #64947 for more detail, but the short answer is
    ;; that newer versions of the Macos toolchain (the newer linker in
    ;; particular) appear to compute the UUID based not just on the
    ;; content of the object files being linked but also on things like
    ;; the timestamps/paths of the objects; this makes it
    ;; difficult/impossible to support reproducible builds. Since we try
    ;; hard to maintain build reproducibility for Go, the APIs here
    ;; compute a new UUID (based on the Go build ID) and write it to the
    ;; final executable generated by the external linker.


    ^:alias ^{:line 21} [imacho "cmd/internal/macho"]

    ^{:line 23} [macho "debug/macho"]
    ^{:line 24} [io "io"]
    ^{:line 25} [os "os"]])




^{:go/end 43} (go/func uuidFromHash "uuidFromHash converts a hash to a UUID\nsuitable for use in the Macho LC_UUID load command.\n" ^{:tag (slice byte)} [^{:tag (array 32 byte)} hashed]
  (let [rv (make (slice byte) 16)]
    (copy rv (subslice hashed _ 16))

    ;; Mark the UUID as version 3, variant 1, which is an MD5-hash-based UUID.
    ;; We are not actually using MD5, but we're also not using SHA1 (version 5),
    ;; and LLVM also uses version 3 [1] so this seems good enough.
    ;;
    ;; [1] https://github.com/llvm/llvm-project/blob/2a3a79ce4c2149d7787d56f9841b66cacc9061d0/lld/MachO/Writer.cpp#L524
    (aset rv 6 (bit-or (bit-and-not (aget rv 6) 0xF0) 0x30)) ; version 3
    (aset rv 8 (bit-or (bit-and-not (aget rv 8) 0xC0) 0x80)) ; variant 1

    ^{:line 42} rv))





^{:go/end 91} (go/func machoRewriteUuid "machoRewriteUuid copies over the contents of the Macho executable\nexef into the output file outexe, and in the process updates the\nLC_UUID command to a new value recomputed from the Go build id.\n" ^error [^{:tag (* Link)} ctxt ^{:tag (* os/File)} exef ^{:tag (* macho/File)} exem ^string outexe]
  (let [(values outf err) (os/OpenFile outexe (bit-or os/O_RDWR os/O_CREATE os/O_TRUNC) 0755)]
    (when (!= err nil)
      (return err))

    (defer (.Close outf))

    ;; Copy over the file.
    (when [(values _ err) (io/Copy outf exef)] (!= err nil)
      (return err))


    ;; Locate the portion of the binary containing the load commands.
    (let [cmdOffset (imacho/FileHeaderSize exem)]
      (when [(values _ err) (.Seek outf cmdOffset 0)] (!= err nil)
        (return err))


      ;; Read the load commands, looking for the LC_UUID cmd. If/when we
      ;; locate it, overwrite it with a new value produced by
      ;; uuidFromHash.
      ^{:go/breaks [[3 90]]} (let [reader (imacho/NewLoadCmdUpdater outf (.-ByteOrder exem) cmdOffset)]
        (for [i (conv uint32 0)] (< i ^{:go/via [FileHeader]} (.-Ncmd exem)) (inc! i)
          (let [(values cmd err) ^{:go/via [LoadCmdReader]} (.Next reader)]
            (when (!= err nil)
              (return err))

            (when (== (.-Cmd cmd) imacho/LC_UUID)
              (let [^uuidCmd u (zero uuidCmd)]
                (when [err ^{:go/via [LoadCmdReader]} (.ReadAt reader 0 (addr u))] (!= err nil)
                  (return err))

                (clear (subslice (.-Uuid u)))
                (copy (subslice (.-Uuid u)) buildinfo)
                (when [err (.WriteAt reader 0 (addr u))] (!= err nil)
                  (return err))

                (break)))))



        ;; We're done
        nil))))

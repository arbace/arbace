(in-ns 'go.cmd.link.internal.ld) (go/file "execarchive.go" :build ["//go:build !wasm && !windows && !tamago"] :imports [


    ^{:line 10} [os "os"]
    ^{:line 11} [exec "os/exec"]
    ^{:line 12} [filepath "path/filepath"]
    ^{:line 13} [syscall "syscall"]])


(go/const ^{:val true} syscallExecSupported true)




^{:go/end 37} (go/method execArchive "execArchive invokes the archiver tool with syscall.Exec(), with\nthe expectation that this is the last thing that takes place\nin the linking operation.\n" [^{:tag (* Link)} ctxt ^{:tag (slice string)} argv]
  (let [^error err (zero error)
      ^{:line 23} argv0 (aget argv 0)]
    (when (== (filepath/Base argv0) argv0)
      (set! (values argv0 err) (exec/LookPath argv0))
      (when (!= err nil)
        (Exitf "cannot find %s: %v" (aget argv 0) err)))


    (when (!= (.-Debugvlog ctxt) 0)
      (.Logf ctxt "invoking archiver with syscall.Exec()\n"))

    (set! err (syscall/Exec argv0 argv (os/Environ)))
    (when (!= err nil)
      (Exitf "running %s failed: %v" (aget argv 0) err))))

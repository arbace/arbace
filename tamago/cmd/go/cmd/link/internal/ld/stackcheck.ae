(go/const ^{:tag int16 :val 32767 :doc "stackCheckCycle is a sentinel stored in the height map to detect if\nwe've found a cycle. This is effectively an \"infinite\" stack\nheight, so we use the closest value to infinity that we can.\n"} stackCheckCycle (- (<< 1 15) 1))




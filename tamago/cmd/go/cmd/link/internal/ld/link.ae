^{:go/end 136} (go/method Logf [^{:tag (* Link)} ctxt ^string format & ^{:tag (slice any)} args]
  (fmt/Fprintf (.-Bso ctxt) format (spread args))
  (.Flush (.-Bso ctxt)))


^{:go/end 147} (go/func addImports [^{:tag (* Link)} ctxt ^{:tag (* sym/Library)} l ^string pn]
  (let [pkg (objabi/PathToPrefix (.-Pkg l))]
    (range [_ imp (.-Autolib l)]
      (let [lib (addlib ctxt pkg pn (.-Pkg imp) (.-Fingerprint imp))]
        (when (!= lib nil)
          (set! (.-Imports l) (append (.-Imports l) lib)))))


    (set! (.-Autolib l) nil)))



^{:go/end 153} (go/method IncVersion "Allocate a new version (i.e. symbol namespace).\n" ^int [^{:tag (* Link)} ctxt]
  (inc! (.-version ctxt))
  (- (.-version ctxt) 1))



^{:go/end 158} (go/method MaxVersion "returns the maximum version number\n" ^int [^{:tag (* Link)} ctxt]
  (.-version ctxt))


















(go/type generatorFunc "generatorFunc is a convenience type.\nSome linker-created Symbols are large and shouldn't really live in the heap.\nSuch Symbols can define a generator function. Their bytes can be generated\ndirectly in the output mmap.\n\nRelocations are applied prior to emitting generator Symbol contents.\nGenerator Symbols that require relocations can be written in two passes.\nThe first pass, at Symbol creation time, adds only relocations.\nThe second pass, at content generation time, adds the rest.\nSee generateFunctab for an example.\n\nGenerator functions shouldn't grow the Symbol size.\nGenerator functions must be safe for concurrent use.\n\nGenerator Symbols have their Data set to the mmapped area when the\ngenerator is called.\n" (func [(* Link) loader/Sym]))



^{:go/end 189} (go/method createGeneratorSymbol "createGeneratorSymbol is a convenience method for creating a generator\nsymbol.\n" ^loader/Sym [^{:tag (* Link)} ctxt ^string name ^int version ^sym/SymKind t ^int64 size ^generatorFunc gen]
  (let [ldr (.-loader ctxt)
      ^{:line 182} s (.LookupOrCreateSym ldr name version)]
    (.SetIsGeneratedSym ldr s true)
    (let [sb (.MakeSymbolUpdater ldr s)]
      (.SetType sb t)
      (.SetSize sb size)
      (aset (.-generatorSyms ctxt) s gen)
      ^{:line 188} s)))

(in-ns 'go.cmd.link.internal.ld) (go/file "heap.go" :imports [

    ^{:line 7} [loader "cmd/link/internal/loader"]])

;; Min-heap implementation, for the deadcode pass.
;; Specialized for loader.Sym elements.

(go/type heap (slice loader/Sym))

^{:go/end 26} (go/method push [^{:tag (* heap)} h ^loader/Sym s]
  (set! @h (append @h s))
  ;; sift up
  (let [n (- (len @h) 1)]
    (while (> n 0)
      (let [p (/ (- n 1) 2)] ; parent
        (when (<= (aget @h p) (aget @h n))
          (break))

        (set! (values (aget @h n) (aget @h p)) (values (aget @h p) (aget @h n)))
        (set! n p)))))



^{:go/end 52} (go/method pop ^loader/Sym [^{:tag (* heap)} h]
  (let [r (aget @h 0)
      ^{:line 30} n (- (len @h) 1)]
    (aset @h 0 (aget @h n))
    (set! @h (subslice @h _ n))

    ;; sift down
    (let [i 0]
      (while true
        (let [c (+ (* 2 i) 1)] ; left child
          (when (>= c n)
            (break))

          (when [c1 (+ c 1)] (and (< c1 n) (< (aget @h c1) (aget @h c)))
            (set! c c1)) ; right child

          (when (<= (aget @h i) (aget @h c))
            (break))

          (set! (values (aget @h i) (aget @h c)) (values (aget @h c) (aget @h i)))
          (set! i c)))


      ^{:line 51} r)))


^{:go/end 54} (go/method empty ^bool [^{:tag (* heap)} h] (== (len @h) 0))




(go/type lexHeap "Same as heap, but sorts alphabetically instead of by index.\n(Note that performance is not so critical here, as it is\nin the case above. Some simplification might be in order.)\n" (slice loader/Sym))

^{:go/end 73} (go/method push [^{:tag (* lexHeap)} h ^{:tag (* loader/Loader)} ldr ^loader/Sym s]
  (set! @h (append @h s))
  ;; sift up
  (let [n (- (len @h) 1)]
    (while (> n 0)
      (let [p (/ (- n 1) 2)] ; parent
        (when (<= (.SymName ldr (aget @h p)) (.SymName ldr (aget @h n)))
          (break))

        (set! (values (aget @h n) (aget @h p)) (values (aget @h p) (aget @h n)))
        (set! n p)))))



^{:go/end 99} (go/method pop ^loader/Sym [^{:tag (* lexHeap)} h ^{:tag (* loader/Loader)} ldr]
  (let [r (aget @h 0)
      ^{:line 77} n (- (len @h) 1)]
    (aset @h 0 (aget @h n))
    (set! @h (subslice @h _ n))

    ;; sift down
    (let [i 0]
      (while true
        (let [c (+ (* 2 i) 1)] ; left child
          (when (>= c n)
            (break))

          (when [c1 (+ c 1)] (and (< c1 n) (< (.SymName ldr (aget @h c1)) (.SymName ldr (aget @h c))))
            (set! c c1)) ; right child

          (when (<= (.SymName ldr (aget @h i)) (.SymName ldr (aget @h c)))
            (break))

          (set! (values (aget @h i) (aget @h c)) (values (aget @h c) (aget @h i)))
          (set! i c)))


      ^{:line 98} r)))


^{:go/end 101} (go/method empty ^bool [^{:tag (* lexHeap)} h] (== (len @h) 0))

(go/var viewCloseError (errors/New "cannot Close OutBuf from View"))

^{:go/breaks [9] :go/end 130} (go/method Close ^error [^{:tag (* OutBuf)} out]
  (when (.-isView out)
    (return viewCloseError))

  (when (.isMmapped out)
    (.copyHeap out)
    (.purgeSignatureCache out)
    (.munmap out))

  (when (== (.-f out) nil)
    (return nil))

  (when (!= (len (.-heap out)) 0)
    (when [(values _ err) (.Write (.-f out) (.-heap out))] (!= err nil)
      (return err)))


  (when [err (.Close (.-f out))] (!= err nil)
    (return err))

  (set! (.-f out) nil)
  nil)





^{:go/end 144} (go/method ErrorClose "ErrorClose closes the output file (if any).\nIt is supposed to be called only at exit on error, so it doesn't do\nany clean up or buffer flushing, just closes the file.\n" [^{:tag (* OutBuf)} out]
  (when (.-isView out)
    (panic viewCloseError))

  (when (== (.-f out) nil)
    (return))

  (.Close (.-f out)) ; best effort, ignore error
  (set! (.-f out) nil))



^{:go/end 149} (go/method isMmapped "isMmapped returns true if the OutBuf is mmaped.\n" ^bool [^{:tag (* OutBuf)} out]
  (!= (len (.-buf out)) 0))




  (.-heap out))




^{:go/end 179} (go/method copyHeap "copyHeap copies the heap to the mmapped section of memory, returning true if\na copy takes place.\n" ^bool [^{:tag (* OutBuf)} out]
  (when (not (.isMmapped out)) ; only valuable for mmapped OutBufs.
    (return false))

  (when (.-isView out)
    (panic "can't copyHeap a view"))


  ^{:go/breaks [[3 178]]} (let [bufLen (len (.-buf out))

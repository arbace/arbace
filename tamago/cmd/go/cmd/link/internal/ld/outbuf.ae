    true))



(go/const ^{:val 10485760 :doc "maxOutBufHeapLen limits the growth of the heap area.\n"} maxOutBufHeapLen (<< 10 20))





^{:go/end 215} (go/method writeLoc "writeLoc determines the write location if a buffer is mmaped.\nWe maintain two write buffers, an mmapped section, and a heap section for\nwriting. When the mmapped section is full, we switch over the heap memory\nfor writing.\n" [^{:tag (* OutBuf)} out ^int64 lenToWrite] :results [int64 (slice byte)]
  ;; See if we have enough space in the mmaped area.
  (let [bufLen (conv int64 (len (.-buf out)))]
    (when (<= (+ (.-off out) lenToWrite) bufLen)
      (return (.-off out) (.-buf out)))


    ;; Not enough space in the mmaped area, write to heap area instead.
    (let [heapPos (- (.-off out) bufLen)
        ^{:line 197} heapLen (conv int64 (len (.-heap out)))
        ^{:line 198} lenNeeded (+ heapPos lenToWrite)]
      (when (> lenNeeded heapLen) ; do we need to grow the heap storage?
        ;; The heap variables aren't protected by a mutex. For now, just bomb if you
        ;; try to use OutBuf in parallel. (Note this probably could be fixed.)
        (when (.-isView out)
          (panic "cannot write to heap in parallel"))

        ;; See if our heap would grow to be too large, and if so, copy it to the end
        ;; of the mmapped area.
        (when (and (> heapLen maxOutBufHeapLen) (.copyHeap out))
          (set! heapPos - heapLen)
          (set! lenNeeded (+ heapPos lenToWrite))
          (set! heapLen 0))

        (set! (.-heap out) (append (.-heap out) (spread (make (slice byte) (- lenNeeded heapLen))))))

      (return heapPos (.-heap out)))))



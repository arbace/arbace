^{:go/end 57} (go/func putelfstr ^int [^string s]
  (when (and (== (len elfstrdat) 0) (!= s ""))
    ;; first entry must be empty string
    (putelfstr ""))


  (let [off (len elfstrdat)]
    (set! elfstrdat (append elfstrdat (spread s)))
    (set! elfstrdat (append elfstrdat 0))
    ^{:line 56} off))


^{:go/end 77} (go/func putelfsyment [^{:tag (* OutBuf)} out ^int off ^int64 addr ^int64 size ^uint8 info ^elf/SectionIndex shndx ^int other]
  (if elf64 (do
      (.Write32 out (conv uint32 off))
      (.Write8 out info)
      (.Write8 out (conv uint8 other))
      (.Write16 out (conv uint16 shndx))
      (.Write64 out (conv uint64 addr))
      (.Write64 out (conv uint64 size))
      (set! symSize + ELF64SYMSIZE))
    (do
      (.Write32 out (conv uint32 off))
      (.Write32 out (conv uint32 addr))
      (.Write32 out (conv uint32 size))
      (.Write8 out info)
      (.Write8 out (conv uint8 other))
      (.Write16 out (conv uint16 shndx))
      (set! symSize + ELF32SYMSIZE))))




                          (machoUpdateDwarfHeader (addr reader) compressedSects dwarfsize dwarfstart realdwarf))))))))))))))





^{:go/end 268} (go/func machoCompressSections "machoCompressSections tries to compress the DWARF segments in dwarfm,\nreturning the updated sections and segment contents, nils if the sections\nweren't compressed, or an error if there was a problem reading dwarfm.\n" [^{:tag (* Link)} ctxt ^{:tag (* macho/File)} dwarfm] :results [(slice (* macho/Section)) (slice byte) error]

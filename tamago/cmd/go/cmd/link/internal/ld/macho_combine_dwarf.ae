^{:go/end 221} (go/func machoCombineDwarf "machoCombineDwarf merges dwarf info generated by dsymutil into a macho executable.\n\nWith internal linking, DWARF is embedded into the executable, this lets us do the\nsame for external linking.\nexef is the file of the executable with no DWARF. It must have enough room in the macho\nheader to add the DWARF sections. (Use ld's -headerpad option)\nexem is the macho representation of exef.\ndsym is the path to the macho file containing DWARF from dsymutil.\noutexe is the path where the combined executable should be saved.\n" ^error [^{:tag (* Link)} ctxt ^{:tag (* os/File)} exef ^{:tag (* macho/File)} exem ^string dsym ^string outexe]
  (let [(values dwarff err) (os/Open dsym)]
    (when (!= err nil)
      (return err))

    (defer (.Close dwarff))
    (let [(values outf ^:assign err) (os/OpenFile outexe (bit-or os/O_RDWR os/O_CREATE os/O_TRUNC) 0755)]
      (when (!= err nil)
        (return err))

      (defer (.Close outf))
      (let [(values dwarfm ^:assign err) (macho/NewFile dwarff)]
        (when (!= err nil)
          (return err))

        (defer (.Close dwarfm))

        ;; The string table needs to be the last thing in the file
        ;; for code signing to work. So we'll need to move the
        ;; linkedit section, but all the others can be copied directly.
        (let [linkseg (.Segment exem "__LINKEDIT")]
          (when (== linkseg nil)
            (return (fmt/Errorf "missing __LINKEDIT segment")))


          (when [(values _ err) (.Seek exef 0 0)] (!= err nil)
            (return err))

          (when [(values _ err) (io/CopyN outf exef (conv int64 ^{:go/via [SegmentHeader]} (.-Offset linkseg)))] (!= err nil)
            (return err))


          (let [realdwarf (.Segment dwarfm "__DWARF")]
            (when (== realdwarf nil)
              (return (fmt/Errorf "missing __DWARF segment")))


            ;; Try to compress the DWARF sections. This includes some Apple
            ;; proprietary sections like __apple_types.
            (let [(values compressedSects compressedBytes ^:assign err) (machoCompressSections ctxt dwarfm)]
              (when (!= err nil)
                (return err))


              ;; Now copy the dwarf data into the output.
              ;; Kernel requires all loaded segments to be page-aligned in the file,
              ;; even though we mark this one as being 0 bytes of virtual address space.
              (let [dwarfstart (Rnd (conv int64 ^{:go/via [SegmentHeader]} (.-Offset linkseg)) @FlagRound)]
                (when [(values _ err) (.Seek outf dwarfstart 0)] (!= err nil)
                  (return err))


                (when [(values _ err) (.Seek dwarff (conv int64 ^{:go/via [SegmentHeader]} (.-Offset realdwarf)) 0)] (!= err nil)
                  (return err))


                ;; Write out the compressed sections, or the originals if we gave up
                ;; on compressing them.

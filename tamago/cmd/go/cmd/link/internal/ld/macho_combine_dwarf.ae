                    (return err))

                  (let [linkstart (Rnd (+ dwarfstart (conv int64 dwarfsize)) @FlagRound)]
                    (when [(values _ err) (.Seek outf linkstart 0)] (!= err nil)
                      (return err))

                    (when [(values _ err) (io/Copy outf exef)] (!= err nil)
                      (return err))


                    ;; Now we need to update the headers.
                    (let [textsect (.Section exem "__text")]
                      (when (== textsect nil)
                        (return (fmt/Errorf "missing __text section")))


                      (let [cmdOffset (imacho/FileHeaderSize exem)
                          ^{:line 149} dwarfCmdOffset (+ (conv uint32 cmdOffset) (.-Cmdsz (.-FileHeader exem)))

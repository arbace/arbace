                          (return err))


                        (let [reader (imacho/NewLoadCmdUpdater outf (.-ByteOrder exem) cmdOffset)]
                          (for [i (conv uint32 0)] (< i ^{:go/via [FileHeader]} (.-Ncmd exem)) (inc! i)

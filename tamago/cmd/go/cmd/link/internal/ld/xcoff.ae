^{:go/end 442} (go/method size "size returns size of string table t.\n" ^int [^{:tag (* xcoffStringTable)} t]
  ;; string table starts with 4-byte length at the beginning
  (+ (.-stringsLen t) 4))



^{:go/end 450} (go/method add "add adds string str to string table t.\n" ^int [^{:tag (* xcoffStringTable)} t ^string str]
  (let [off (.size t)]
    (set! (.-strings t) (append (.-strings t) str))
    (set! (.-stringsLen t) + (+ (len str) 1)) ; each string will have 0 appended to it
    ^{:line 449} off))



^{:go/end 459} (go/method write "write writes string table t into the output file.\n" [^{:tag (* xcoffStringTable)} t ^{:tag (* OutBuf)} out]
  (.Write32 out (conv uint32 (.size t)))
  (range [_ s (.-strings t)]
    (.WriteString out s)
    (.Write8 out 0)))




^{:go/end 465} (go/method write "write writes XCOFF section sect into the output file.\n" [^{:tag (* XcoffScnHdr64)} sect ^{:tag (* Link)} ctxt]
  (binary/Write (.-Out ctxt) binary/BigEndian sect)
  (.Write32 (.-Out ctxt) 0)) ; Add 4 empty bytes at the end to match alignment



^{:go/end 480} (go/method addSection "addSection adds section to the XCOFF file f.\n" ^{:tag (* XcoffScnHdr64)} [^{:tag (* xcoffFile)} f ^string name ^uint64 addr ^uint64 size ^uint64 fileoff ^uint32 flags]
  (let [sect (addr ^{:go/breaks [2 4 6 8 10]} (lit XcoffScnHdr64
          :Spaddr addr
          :Svaddr addr
          :Ssize size
          :Sscnptr fileoff

      (case [sym/SGOSTRING]
        (aset outerSymSize "go:string.*" size))
      (case [sym/SGOFUNC]
        (when (not (.DynlinkingGo ctxt))
          (aset outerSymSize "go:funcdesc" size)))

      (case [sym/SGCBITS]
        (aset outerSymSize "runtime.gcbits.*" size))
      (case [sym/SPCLNTAB]

^{:go/end 611} (go/func xcoffUpdateOuterSize "xcoffUpdateOuterSize stores the size of outer symbols in order to have it\nin the symbol table.\n" [^{:tag (* Link)} ctxt ^int64 size ^sym/SymKind stype]
  (when (== size 0)
    (return))

  ;; TODO: use CarrierSymByType

  (let [ldr (.-loader ctxt)]
    (switch stype
      (default
        (Errorf "unknown XCOFF outer symbol for type %s" (.String stype)))
      (case [sym/SRODATA sym/SRODATARELRO sym/SSTRING])

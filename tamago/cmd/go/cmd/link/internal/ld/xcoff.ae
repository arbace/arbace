^{:go/end 515} (go/func xcoffGetDwarfSubtype "xcoffGetDwarfSubtype returns the XCOFF name of the DWARF section str\nand its subtype constant.\n" [^string str] :results [string uint32]
  (switch str
    (default
      (Exitf "unknown DWARF section name for XCOFF: %s" str))
    (case [".debug_abbrev"]
      (return ".dwabrev" SSUBTYP_DWABREV))
    (case [".debug_info"]
      (return ".dwinfo" SSUBTYP_DWINFO))
    (case [".debug_frame"]
      (return ".dwframe" SSUBTYP_DWFRAME))
    (case [".debug_line"]
      (return ".dwline" SSUBTYP_DWLINE))
    (case [".debug_loc"]
      (return ".dwloc" SSUBTYP_DWLOC))
    (case [".debug_pubnames"]
      (return ".dwpbnms" SSUBTYP_DWPBNMS))
    (case [".debug_pubtypes"]
      (return ".dwpbtyp" SSUBTYP_DWPBTYP))

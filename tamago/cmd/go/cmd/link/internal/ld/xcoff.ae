^{:go/breaks [6] :go/end 538} (go/method getXCOFFscnum "getXCOFFscnum returns the XCOFF section number of a Go section.\n" ^int16 [^{:tag (* xcoffFile)} f ^{:tag (* sym/Section)} sect]
  (switch (.-Seg sect)
    (case [(addr Segtext)]
      (return (aget (.-sectNameToScnum f) ".text")))
    (case [(addr Segdata)]
      (when (or (== (.-Name sect) ".noptrbss") (== (.-Name sect) ".bss"))
        (return (aget (.-sectNameToScnum f) ".bss")))

      (when (== (.-Name sect) ".tbss")
        (return (aget (.-sectNameToScnum f) ".tbss")))

      (return (aget (.-sectNameToScnum f) ".data")))
    (case [(addr Segdwarf)]
      (let [(values name _) (xcoffGetDwarfSubtype (.-Name sect))]
        (return (aget (.-sectNameToScnum f) name))))
    (case [(addr Segrelrodata)]
      (return (aget (.-sectNameToScnum f) ".data"))))

  (Errorf "getXCOFFscnum not implemented for section %s" (.-Name sect))
  -1)





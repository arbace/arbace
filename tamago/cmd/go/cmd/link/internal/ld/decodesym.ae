^{:go/end 299} (go/func decodeTargetSym "decodeTargetSym finds the symbol pointed to by the pointer slot at offset off in s.\n" ^loader/Sym [^{:tag (* Link)} ctxt ^{:tag (* sys/Arch)} arch ^loader/Sym s ^int64 off]
  (let [ldr (.-loader ctxt)]
    (when (== (.SymType ldr s) sym/SDYNIMPORT)
      ;; In this case, relocations are not associated with a
      ;; particular symbol. Instead, they are all listed together
      ;; in the containing shared library. Find the relocation
      ;; in that shared library record.
      (let [name (.SymName ldr s)]
        (range [_ sh (.-Shlibs ctxt)]
          (let [(values addr ok) (aget (.-symAddr sh) name)]
            (when (not ok)
              (continue))

            (set! addr + (conv uint64 off))
            (let [target (aget (.-relocTarget sh) addr)]
              (when (== target "")
                (Exitf "can't find relocation in %s at offset %d" name off))

              (let [t (.Lookup ldr target 0)]
                (when (== t 0)
                  (Exitf "can't find target of relocation in %s at offset %d: %s" name off target))

                (return t)))))))



    ;; For the normal case, just find the relocation within the symbol that
    ;; lives at the requested offset.
    (let [relocs (.Relocs ldr s)]
      (decodeRelocSym ldr s (addr relocs) (conv int32 off)))))

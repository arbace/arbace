^{:go/end 33} (go/func decodeInuxi ^uint64 [^{:tag (* sys/Arch)} arch ^{:tag (slice byte)} p ^int sz]
  (switch sz
    (case [2]
      (return (conv uint64 (.Uint16 (.-ByteOrder arch) p))))
    (case [4]
      (return (conv uint64 (.Uint32 (.-ByteOrder arch) p))))
    (case [8]
      (return (.Uint64 (.-ByteOrder arch) p)))
    (default
      (Exitf "dwarf: decode inuxi %d" sz)
      (panic "unreachable"))))




            (when [(values inv ok) (assert hex/InvalidByteError err)] ok
              (Exitf "-B argument contains invalid hex digit %c: %s" (conv byte inv) ov))

            (Exitf "-B argument contains invalid hex: %s" ov))


          (set! buildinfo b))))))




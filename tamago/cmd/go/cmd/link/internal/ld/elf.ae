    (set! (.-Off e) - (conv uint64 frag))
    (set! (.-Vaddr e) - (conv uint64 frag))
    (set! (.-Paddr e) - (conv uint64 frag))
    (set! (.-Filesz e) + (conv uint64 frag))
    (set! (.-Memsz e) + (conv uint64 frag))))



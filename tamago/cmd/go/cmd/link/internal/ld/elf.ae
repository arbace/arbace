        (if (== st sym/SDYNIMPORT)
          (.AddUint32 d (.-Arch target) 0)

          (.AddAddrPlus d (.-Arch target) s 0))


        ;; size of object
        (.AddUint32 d (.-Arch target) (conv uint32 (len (.Data ldr s))))


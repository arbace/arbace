^{:go/end 232} (go/func Elfinit "Elfinit initializes the global ehdr variable that holds the ELF header.\nIt will be updated as write section and program headers.\n" [^{:tag (* Link)} ctxt]
  (set! ^{:go/via [Target]} (.-IsELF ctxt) true)

  (if (.InFamily ^{:go/via [Target]} (.-Arch ctxt) sys/AMD64 sys/ARM64 sys/Loong64 sys/MIPS64 sys/PPC64 sys/RISCV64 sys/S390X)
    (set! elfRelType ".rela")

    (set! elfRelType ".rel"))


  (switch (.-Family ^{:go/via [Target]} (.-Arch ctxt))
    ;; 64-bit architectures
    (case [sys/AMD64 sys/ARM64 sys/Loong64 sys/MIPS64 sys/PPC64 sys/RISCV64 sys/S390X]
      (when (== (.-Family ^{:go/via [Target]} (.-Arch ctxt)) sys/MIPS64)
        (set! (.-Flags ehdr) 0x20000004)) ; MIPS 3 CPIC

      (when (== (.-Family ^{:go/via [Target]} (.-Arch ctxt)) sys/Loong64)
        (set! (.-Flags ehdr) 0x43)) ; DOUBLE_FLOAT, OBJABI_V1

      (when (== (.-Family ^{:go/via [Target]} (.-Arch ctxt)) sys/RISCV64)
        (set! (.-Flags ehdr) 0x4)) ; RISCV Float ABI Double

      (when (== (.-Family ^{:go/via [Target]} (.-Arch ctxt)) sys/S390X)
        (set! (.-Flags ehdr) 1)) ; Version 1 ABI

      (when (== (.-Family ^{:go/via [Target]} (.-Arch ctxt)) sys/PPC64)
        (set! (.-Flags ehdr) 2)) ; Version 2 ABI

      (set! elf64 true)

      (set! (.-Phoff ehdr) ELF64HDRSIZE) ; Must be ELF64HDRSIZE: first PHdr must follow ELF header
      (set! (.-Shoff ehdr) ELF64HDRSIZE) ; Will move as we add PHeaders
      (set! (.-Ehsize ehdr) ELF64HDRSIZE) ; Must be ELF64HDRSIZE
      (set! (.-Phentsize ehdr) ELF64PHDRSIZE) ; Must be ELF64PHDRSIZE
      (set! (.-Shentsize ehdr) ELF64SHDRSIZE)) ; Must be ELF64SHDRSIZE

    ;; 32-bit architectures
    (case [sys/ARM sys/MIPS]
      (cond (== (.-Family ^{:go/via [Target]} (.-Arch ctxt)) sys/ARM)
        ;; we use EABI on linux/arm, freebsd/arm, netbsd/arm, tamago/arm.
        (when (or (== ^{:go/via [Target]} (.-HeadType ctxt) objabi/Hlinux) (== ^{:go/via [Target]} (.-HeadType ctxt) objabi/Hfreebsd) (== ^{:go/via [Target]} (.-HeadType ctxt) objabi/Hnetbsd) (== ^{:go/via [Target]} (.-HeadType ctxt) objabi/Htamago))
          ;; We set a value here that makes no indication of which
          ;; float ABI the object uses, because this is information
          ;; used by the dynamic linker to compare executables and
          ;; shared libraries -- so it only matters for cgo calls, and
          ;; the information properly comes from the object files
          ;; produced by the host C compiler. parseArmAttributes in
          ;; ldelf.go reads that information and updates this field as
          ;; appropriate.
          (set! (.-Flags ehdr) 0x5000002)) ; has entry point, Version5 EABI

        (== (.-Family ^{:go/via [Target]} (.-Arch ctxt)) sys/MIPS)
        (set! (.-Flags ehdr) 0x50001004)) ; MIPS 32 CPIC O32

      (fallthrough))
    (default
      (set! (.-Phoff ehdr) ELF32HDRSIZE)
      ;; Must be ELF32HDRSIZE: first PHdr must follow ELF header
      (set! (.-Shoff ehdr) ELF32HDRSIZE) ; Will move as we add PHeaders
      (set! (.-Ehsize ehdr) ELF32HDRSIZE) ; Must be ELF32HDRSIZE
      (set! (.-Phentsize ehdr) ELF32PHDRSIZE) ; Must be ELF32PHDRSIZE
      (set! (.-Shentsize ehdr) ELF32SHDRSIZE)))) ; Must be ELF32SHDRSIZE







^{:go/end 246} (go/func fixElfPhdr "fixElfPhdr makes sure PT_LOAD is aligned properly and that there is no gap.\nCorrect ELF loaders will do this implicitly,\nbut buggy ELF loaders like the one in some\nversions of QEMU and UPX won't.\n" [^{:tag (* ElfPhdr)} e]

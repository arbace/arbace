            (set! windowsgui true))
          (default
            (when [err (.Set ^{:go/via [Target]} (.-HeadType ctxt) @flagHeadType)] (!= err nil)
              (Errorf "%v" err)
              (usage))))


        (when (== ^{:go/via [Target]} (.-HeadType ctxt) objabi/Hunknown)
          (.Set ^{:go/via [Target]} (.-HeadType ctxt) buildcfg/GOOS))


        (when (and (not @flagAslr) (!= ^{:go/via [Target]} (.-BuildMode ctxt) BuildModeCShared))
          (Errorf "-aslr=false is only allowed for -buildmode=c-shared")
          (usage))


        (when (and @FlagD ^{:go/via [Target]} (.UsesLibc ctxt))
          (Exitf "dynamic linking required on %s; -d flag cannot be used" buildcfg/GOOS))


        (let [isPowerOfTwo ^{:go/end 258} (fn ^bool [^int64 n]
              (and (> n 0) (== (bit-and n (- n 1)) 0)))]

          (when (and (!= @FlagRound -1) ^:go/paren (or (< @FlagRound 4096) (not (isPowerOfTwo @FlagRound))))
            (Exitf "invalid -R value 0x%x" @FlagRound))

          (when (and (!= @FlagFuncAlign 0) (not (isPowerOfTwo (conv int64 @FlagFuncAlign))))
            (Exitf "invalid -funcalign value %d" @FlagFuncAlign))


          (set! checkStrictDups @FlagStrictDups)

          (switch flagW
            (case [ternaryFlagFalse]
              (set! @FlagW false))
            (case [ternaryFlagTrue]
              (set! @FlagW true))
            (case [ternaryFlagUnset]
              (set! @FlagW @FlagS) ; -s implies -w if not explicitly set
              (when (and ^{:go/via [Target]} (.IsDarwin ctxt) (== ^{:go/via [Target]} (.-BuildMode ctxt) BuildModeCShared))
                (set! @FlagW true)))) ; default to -w in c-shared mode on darwin, see #61229



          (when (not ^{:go/via [Flags]} (.-RegabiWrappers buildcfg/Experiment))
            (set! abiInternalVer 0))


          (startProfile)
          (when (== ^{:go/via [Target]} (.-BuildMode ctxt) BuildModeUnset)

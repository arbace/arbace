      ;; so omit it from the binary even if cmd/link itself has an
      ;; embedded GOROOT value reported by runtime.GOROOT.

      (addstrdata1 ctxt (+ "runtime.defaultGOROOT=" buildcfg/GOROOT)))


    (let [buildVersion buildcfg/Version]
      (when [goexperiment (.String buildcfg/Experiment)] (!= goexperiment "")
        (let [sep " "]
          (when (not (strings/Contains buildVersion "-")) ; See go.dev/issue/75953.
            (set! sep "-"))

          (set! buildVersion + (+ sep "X:" goexperiment))))

      (addstrdata1 ctxt (+ "runtime.buildVersion=" buildVersion))


^{:go/end 551} (go/func startProfile []
  (when (!= @cpuprofile "")
    (let [(values f err) (os/Create @cpuprofile)]
      (when (!= err nil)
        (log/Fatalf "%v" err))

      (when [err (pprof/StartCPUProfile f)] (!= err nil)
        (log/Fatalf "%v" err))

      (AtExit ^{:go/end 525} (fn []
          (pprof/StopCPUProfile)
          (when [(set! err (.Close f))] (!= err nil)
            (log/Fatalf "error closing cpu profile: %v" err))))))



  (when (!= @memprofile "")
    (when (!= @memprofilerate 0)
      (set! runtime/MemProfileRate (conv int @memprofilerate)))

    (let [(values f err) (os/Create @memprofile)]
      (when (!= err nil)
        (log/Fatalf "%v" err))

      (AtExit ^{:go/end 549} (fn []
          ;; Profile all outstanding allocations.
          (runtime/GC)
          ;; compilebench parses the memory profile to extract memstats,
          ;; which are only written in the legacy pprof format.
          ;; See golang.org/issue/18641 and runtime/pprof/pprof.go:writeHeap.
          (let [^:const ^{:val 1} writeLegacyFormat 1]
            (when [err (.WriteTo (pprof/Lookup "heap") f writeLegacyFormat)] (!= err nil)
              (log/Fatalf "%v" err))

            ;; Close the file after writing the profile.
            (when [err (.Close f)] (!= err nil)
              (log/Fatalf "could not close %v: %v" @memprofile err))))))))

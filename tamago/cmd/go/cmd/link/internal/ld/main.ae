      (when (and (== (.-Family ^{:go/via [Target]} (.-Arch ctxt)) sys/AMD64) (== buildcfg/GOOS "plan9"))
        (flag/BoolVar (addr flag8) "8" false "use 64-bit addresses in symbol table"))

      (let [flagHeadType (flag/String "H" "" "set header `type`")]
        (flag/BoolVar (addr ^{:go/via [Target]} (.-linkShared ctxt)) "linkshared" false "link against installed Go shared libraries")
        (flag/Var (addr ^{:go/via [Target]} (.-LinkMode ctxt)) "linkmode" "set link `mode`")
        (flag/Var (addr ^{:go/via [Target]} (.-BuildMode ctxt)) "buildmode" "set build `mode`")
        (flag/BoolVar (addr (.-compressDWARF ctxt)) "compressdwarf" true "compress DWARF if possible")
        (objabi/Flagfn1 "L" "add specified `directory` to library path" ^{:go/end 210} (fn [^string a] (Lflag ctxt a)))
        (objabi/AddVersionFlag) ; -V
        (objabi/Flagfn1 "X" "add string value `definition` of the form importpath.name=value" ^{:go/end 212} (fn [^string s] (addstrdata1 ctxt s)))
        (objabi/Flagcount "v" "print link trace" (addr (.-Debugvlog ctxt)))
        (objabi/Flagfn1 "importcfg" "read import configuration from `file`" (.-readImportCfg ctxt))

        (objabi/Flagparse usage)
        (counter/CountFlags "link/flag:" @flag/CommandLine)

        (when (> (.-Debugvlog ctxt) 0)
          ;; dump symbol info on crash
          (defer (^{:go/end 221} (fn [] (.Dump (.-loader ctxt))))))

        (when (> (.-Debugvlog ctxt) 1)
          ;; dump symbol info on error
          (AtExit ^{:go/end 229} (fn []

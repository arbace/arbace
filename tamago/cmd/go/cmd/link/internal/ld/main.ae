                (.Logf ctxt "HEADER = -H%d -T0x%x -R0x%x\n" ^{:go/via [Target]} (.-HeadType ctxt) (conv uint64 @FlagTextAddr) (conv uint32 @FlagRound))))


            (let [zerofp (lit goobj/FingerprintType)]

                (default
                  (addlibpath ctxt "command line" "command line" (flag/Arg 0) "main" "" zerofp)))

              (.Start bench "loadlib")
              (.loadlib ctxt)

              (.Start bench "inittasks")
              (.inittasks ctxt)

              (.Start bench "deadcode")
              (deadcode ctxt)

              (.Start bench "linksetup")
              (.linksetup ctxt)

              (.Start bench "dostrdata")
              (.dostrdata ctxt)
              (when ^{:go/via [Flags]} (.-FieldTrack buildcfg/Experiment)
                (.Start bench "fieldtrack")
                (fieldtrack ^{:go/via [Target]} (.-Arch ctxt) (.-loader ctxt)))


              (.Start bench "dwarfGenerateDebugInfo")
              (dwarfGenerateDebugInfo ctxt)

              (.Start bench "callgraph")
              (.callgraph ctxt)

              (.Start bench "doStackCheck")
              (.doStackCheck ctxt)

              (.Start bench "mangleTypeSym")
              (.mangleTypeSym ctxt)

              (when ^{:go/via [Target]} (.-IsELF ctxt)
                (.Start bench "doelf")
                (.doelf ctxt))

              (when ^{:go/via [Target]} (.IsDarwin ctxt)
                (.Start bench "domacho")
                (.domacho ctxt))

              (when ^{:go/via [Target]} (.IsWindows ctxt)
                (.Start bench "dope")
                (.dope ctxt)
                (.Start bench "windynrelocsyms")
                (.windynrelocsyms ctxt))

              (when ^{:go/via [Target]} (.IsAIX ctxt)

    (set! (.-Bso ctxt) (bufio/NewWriter os/Stdout))

    ;; For testing behavior of go command when tools crash silently.
    ;; Undocumented, not in standard flag parser to avoid
    ;; exposing in usage message.
    (range [_ arg os/Args]

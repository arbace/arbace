              (.setArchSyms ctxt)
              (.addexport ctxt)
              (.Start bench "Gentext")
              ((.-Gentext thearch) ctxt (.-loader ctxt)) ; trampolines, call stubs, etc.

              (.Start bench "textaddress")
              (.textaddress ctxt)
              (.Start bench "buildinfo")
              (.buildinfo ctxt)
              (.Start bench "pclntab")
              (let [containers (.findContainerSyms ctxt)

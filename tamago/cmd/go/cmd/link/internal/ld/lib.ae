      (case [1 2]
        (set! flags bit-or loader/FlagStrictDups))
      (default
        (log/Fatalf "invalid -strictdups flag value %d" @FlagStrictDups)))

    (set! (.-loader ctxt) (loader/NewLoader flags (addr (.-ErrorReporter (.-ErrorReporter ctxt)))))
    (set! (.-SymName (.-ErrorReporter ctxt)) ^{:go/end 542} (fn ^string [^loader/Sym s]

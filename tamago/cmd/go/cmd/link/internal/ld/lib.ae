  (if (!= @FlagFuncAlign 0)
    (set! Funcalign @FlagFuncAlign)

    (set! Funcalign (.-Funcalign thearch)))


  ;; add goroot to the end of the libdir list.
  (let [suffix ""

      ^{:line 391} suffixsep ""]
    (cond (!= @flagInstallSuffix "") (do
        (set! suffixsep "_")
        (set! suffix @flagInstallSuffix))
      ^{:line 395} @flagRace (do
        (set! suffixsep "_")
        (set! suffix "race"))
      ^{:line 398} @flagMsan (do
        (set! suffixsep "_")
        (set! suffix "msan"))
      ^{:line 401} @flagAsan (do
        (set! suffixsep "_")
        (set! suffix "asan")))


    (when (!= buildcfg/GOROOT "")
      (Lflag ctxt (filepath/Join buildcfg/GOROOT "pkg" (fmt/Sprintf "%s_%s%s%s" buildcfg/GOOS buildcfg/GOARCH suffixsep suffix))))


    (mayberemoveoutfile)

    (when [err (.Open (.-Out ctxt) @flagOutfile)] (!= err nil)
      (Exitf "cannot create %s: %v" @flagOutfile err))


    (when (== @flagEntrySymbol "")
      (switch ^{:go/via [Target]} (.-BuildMode ctxt)
        (case [BuildModeCShared BuildModeCArchive]
          (set! @flagEntrySymbol (fmt/Sprintf "_rt0_%s_%s_lib" buildcfg/GOARCH buildcfg/GOOS)))
        (case [BuildModeExe BuildModePIE]
          (set! @flagEntrySymbol (fmt/Sprintf "_rt0_%s_%s" buildcfg/GOARCH buildcfg/GOOS)))
        (case [BuildModeShared BuildModePlugin])
        ;; No *flagEntrySymbol for -buildmode=shared and plugin
        (default
          (Errorf "unknown *flagEntrySymbol for buildmode %v" ^{:go/via [Target]} (.-BuildMode ctxt)))))))




^{:go/end 436} (go/func exitIfErrors []
  (when (or (!= nerrors 0) (and (> checkStrictDups 1) (> strictDupMsgCount 0)))

^{:go/end 518} (go/method findLibPathCmd "findLibPathCmd uses cmd command to find gcc library libname.\nIt returns library full path if found, or \"none\" if not found.\n" ^string [^{:tag (* Link)} ctxt ^string cmd ^string libname]
  (let [extld (.extld ctxt)
      (values name args) (values (aget extld 0) (subslice extld 1))]
    (set! args (append args (spread (hostlinkArchArgs ^{:go/via [Target]} (.-Arch ctxt)))))
    (set! args (append args cmd))
    (when (!= (.-Debugvlog ctxt) 0)
      (.Logf ctxt "%s %v\n" extld args))

    (let [(values out err) (.Output (exec/Command name (spread args)))]
      (when (!= err nil)
        (when (!= (.-Debugvlog ctxt) 0)
          (.Logf ctxt "not using a %s file because compiler failed\n%v\n%s\n" libname err out))

        (return "none"))

      (strings/TrimSpace (conv string out)))))





(in-ns 'go.cmd.link.internal.ld) (go/file "outbuf_linux.go" :imports [

    ^{:line 7} [syscall "syscall"]])

^{:go/end 11} (go/method fallocate ^error [^{:tag (* OutBuf)} out ^uint64 size]
  (syscall/Fallocate (conv int (.Fd (.-f out))) 0 0 (conv int64 size)))

(in-ns 'go.cmd.link.internal.ld) (go/file "target.go" :imports [


    ^{:line 8} [objabi "cmd/internal/objabi"]
    ^{:line 9} [sys "cmd/internal/sys"]
    ^{:line 10} [binary "encoding/binary"]])



(go/type Target "Target holds the configuration we're building for.\n" (struct
    ^{:line 15 :tag (* sys/Arch)} Arch

    ^{:line 17 :tag objabi/HeadType} HeadType

    ^{:line 19 :tag LinkMode} LinkMode
    ^{:line 20 :tag BuildMode} BuildMode

    ^{:line 22 :tag bool} linkShared
    ^{:line 23 :tag bool} canUsePlugins
    ^{:line 24 :tag bool} IsELF))


;;
;; Target type functions
;;

^{:go/end 33} (go/method IsExe ^bool [^{:tag (* Target)} t]
  (== (.-BuildMode t) BuildModeExe))


^{:go/end 37} (go/method IsShared ^bool [^{:tag (* Target)} t]
  (== (.-BuildMode t) BuildModeShared))


^{:go/end 41} (go/method IsPlugin ^bool [^{:tag (* Target)} t]
  (== (.-BuildMode t) BuildModePlugin))


^{:go/end 45} (go/method IsInternal ^bool [^{:tag (* Target)} t]
  (== (.-LinkMode t) LinkInternal))


^{:go/end 49} (go/method IsExternal ^bool [^{:tag (* Target)} t]
  (== (.-LinkMode t) LinkExternal))


^{:go/end 53} (go/method IsPIE ^bool [^{:tag (* Target)} t]
  (== (.-BuildMode t) BuildModePIE))


^{:go/end 57} (go/method IsSharedGoLink ^bool [^{:tag (* Target)} t]
  (.-linkShared t))


^{:go/end 61} (go/method CanUsePlugins ^bool [^{:tag (* Target)} t]
  (.-canUsePlugins t))


^{:go/end 66} (go/method IsElf ^bool [^{:tag (* Target)} t]
  (.mustSetHeadType t)
  (.-IsELF t))


^{:go/end 70} (go/method IsDynlinkingGo ^bool [^{:tag (* Target)} t]
  (or (.IsShared t) (.IsSharedGoLink t) (.IsPlugin t) (.CanUsePlugins t)))




^{:go/end 85} (go/method UseRelro "UseRelro reports whether to make use of \"read only relocations\" aka\nrelro.\n" ^bool [^{:tag (* Target)} t]
  (switch (.-BuildMode t)
    (case [BuildModeCArchive BuildModeCShared BuildModeShared BuildModePIE BuildModePlugin]
      (return (or (.-IsELF t) (== (.-HeadType t) objabi/Haix) (== (.-HeadType t) objabi/Hdarwin))))
    (default
      (when (and (== (.-HeadType t) objabi/Hdarwin) (.IsARM64 t))
        ;; On darwin/ARM64, everything is PIE.
        (return true))

      (return (or (.-linkShared t) ^:go/paren (and (== (.-HeadType t) objabi/Haix) (== (.-LinkMode t) LinkExternal)))))))



;;
;; Processor functions
;;

^{:go/end 93} (go/method Is386 ^bool [^{:tag (* Target)} t]
  (== (.-Family (.-Arch t)) sys/I386))


^{:go/end 97} (go/method IsARM ^bool [^{:tag (* Target)} t]
  (== (.-Family (.-Arch t)) sys/ARM))


^{:go/end 101} (go/method IsARM64 ^bool [^{:tag (* Target)} t]
  (== (.-Family (.-Arch t)) sys/ARM64))


^{:go/end 105} (go/method IsAMD64 ^bool [^{:tag (* Target)} t]
  (== (.-Family (.-Arch t)) sys/AMD64))


^{:go/end 109} (go/method IsMIPS ^bool [^{:tag (* Target)} t]
  (== (.-Family (.-Arch t)) sys/MIPS))


^{:go/end 113} (go/method IsMIPS64 ^bool [^{:tag (* Target)} t]
  (== (.-Family (.-Arch t)) sys/MIPS64))


^{:go/end 117} (go/method IsLOONG64 ^bool [^{:tag (* Target)} t]
  (== (.-Family (.-Arch t)) sys/Loong64))


^{:go/end 121} (go/method IsPPC64 ^bool [^{:tag (* Target)} t]
  (== (.-Family (.-Arch t)) sys/PPC64))


^{:go/end 125} (go/method IsRISCV64 ^bool [^{:tag (* Target)} t]
  (== (.-Family (.-Arch t)) sys/RISCV64))


^{:go/end 129} (go/method IsS390X ^bool [^{:tag (* Target)} t]
  (== (.-Family (.-Arch t)) sys/S390X))


^{:go/end 133} (go/method IsWasm ^bool [^{:tag (* Target)} t]
  (== (.-Family (.-Arch t)) sys/Wasm))


;;
;; OS Functions
;;

^{:go/end 142} (go/method IsLinux ^bool [^{:tag (* Target)} t]
  (.mustSetHeadType t)
  (== (.-HeadType t) objabi/Hlinux))


^{:go/end 147} (go/method IsDarwin ^bool [^{:tag (* Target)} t]
  (.mustSetHeadType t)
  (== (.-HeadType t) objabi/Hdarwin))


^{:go/end 152} (go/method IsWindows ^bool [^{:tag (* Target)} t]
  (.mustSetHeadType t)
  (== (.-HeadType t) objabi/Hwindows))


^{:go/end 157} (go/method IsPlan9 ^bool [^{:tag (* Target)} t]
  (.mustSetHeadType t)
  (== (.-HeadType t) objabi/Hplan9))


^{:go/end 162} (go/method IsAIX ^bool [^{:tag (* Target)} t]
  (.mustSetHeadType t)
  (== (.-HeadType t) objabi/Haix))


^{:go/end 167} (go/method IsSolaris ^bool [^{:tag (* Target)} t]
  (.mustSetHeadType t)
  (== (.-HeadType t) objabi/Hsolaris))


^{:go/end 172} (go/method IsNetbsd ^bool [^{:tag (* Target)} t]
  (.mustSetHeadType t)
  (== (.-HeadType t) objabi/Hnetbsd))


^{:go/end 177} (go/method IsOpenbsd ^bool [^{:tag (* Target)} t]
  (.mustSetHeadType t)
  (== (.-HeadType t) objabi/Hopenbsd))


^{:go/end 182} (go/method IsFreebsd ^bool [^{:tag (* Target)} t]
  (.mustSetHeadType t)
  (== (.-HeadType t) objabi/Hfreebsd))


^{:go/end 188} (go/method mustSetHeadType [^{:tag (* Target)} t]
  (when (== (.-HeadType t) objabi/Hunknown)
    (panic "HeadType is not set")))



;;
;; MISC
;;

^{:go/end 196} (go/method IsBigEndian ^bool [^{:tag (* Target)} t]
  (== (.-ByteOrder (.-Arch t)) binary/BigEndian))


^{:go/breaks [[5 205]] :go/end 206} (go/method UsesLibc ^bool [^{:tag (* Target)} t]
  (.mustSetHeadType t)
  (switch (.-HeadType t)
    (case [objabi/Haix objabi/Hdarwin objabi/Hopenbsd objabi/Hsolaris objabi/Hwindows]
      ;; platforms where we use libc for syscalls.
      (return true)))

  false)

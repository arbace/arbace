(in-ns 'go.cmd.link.internal.ld) (go/file "util.go" :imports [


    ^{:line 8} [loader "cmd/link/internal/loader"]
    ^{:line 9} [binary "encoding/binary"]
    ^{:line 10} [fmt "fmt"]
    ^{:line 11} [os "os"]])


(go/var ^{:tag (slice (func []))} atExitFuncs)

^{:go/end 18} (go/func AtExit [^{:tag (func [])} f]
  (set! atExitFuncs (append atExitFuncs f)))



^{:go/end 26} (go/func runAtExitFuncs "runAtExitFuncs runs the queued set of AtExit functions.\n" []
  (for [i (- (len atExitFuncs) 1)] (>= i 0) (dec! i)
    ((aget atExitFuncs i)))

  (set! atExitFuncs nil))



^{:go/end 32} (go/func Exit "Exit exits with code after executing all atExitFuncs.\n" [^int code]
  (runAtExitFuncs)
  (os/Exit code))



^{:go/end 42} (go/func Exitf "Exitf logs an error message then calls Exit(2).\n" [^string format & ^{:tag (slice any)} a]
  (fmt/Fprintf os/Stderr (+ (aget os/Args 0) ": " format "\n") (spread a))
  (inc! nerrors)
  (when @flagH
    (panic "error"))

  (Exit 2))




^{:go/end 54} (go/func afterErrorAction "afterErrorAction updates 'nerrors' on error and invokes exit or\npanics in the proper circumstances.\n" []
  (inc! nerrors)
  (when @flagH
    (panic "error"))

  (when (and (> nerrors 20) (not @flagAllErrors))
    (Exitf "too many errors")))










^{:go/end 67} (go/func Errorf "Errorf logs an error message without a specific symbol for context.\nUse ctxt.Errorf when possible.\n\nIf more than 20 errors have been printed, exit with an error.\n\nLogging an error means that on exit cmd/link will delete any\noutput file and return a non-zero error code.\n" [^string format & ^{:tag (slice any)} args]
  (set! format + "\n")
  (fmt/Fprintf os/Stderr format (spread args))
  (afterErrorAction))








^{:go/end 85} (go/method Errorf "Errorf method logs an error message.\n\nIf more than 20 errors have been printed, exit with an error.\n\nLogging an error means that on exit cmd/link will delete any\noutput file and return a non-zero error code.\n" [^{:tag (* Link)} ctxt ^loader/Sym s ^string format & ^{:tag (slice any)} args]
  (when (!= (.-loader ctxt) nil)
    (.Errorf (.-loader ctxt) s format (spread args))
    (return))

  ;; Note: this is not expected to happen very often.
  (set! format (fmt/Sprintf "sym %d: %s" s format))
  (set! format + "\n")
  (fmt/Fprintf os/Stderr format (spread args))
  (afterErrorAction))


^{:go/end 97} (go/func artrim ^string [^{:tag (slice byte)} x]
  (let [i 0
      ^{:line 89} j (len x)]
    (while (and (< i (len x)) (== (aget x i) \space))
      (inc! i))

    (while (and (> j i) (== (aget x (- j 1)) \space))
      (dec! j))

    (conv string (subslice x i j))))


^{:go/end 105} (go/func stringtouint32 [^{:tag (slice uint32)} x ^string s]
  (for [i 0] (> (len s) 0) (inc! i)
    (let [^{:tag (array 4 byte)} buf (zero (array 4 byte))]
      (set! s (subslice s (copy (subslice buf) s)))
      (aset x i (.Uint32 binary/LittleEndian (subslice buf))))))

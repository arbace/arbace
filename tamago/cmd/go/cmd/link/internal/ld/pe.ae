            (continue))

          (when (.IsFileLocal ldr s)
            (continue)) ; Only export non-static symbols

          ;; Retrieve the name of the initial symbol
          ;; exported by cgo.
          ;; The corresponding Go symbol is:
          ;; _cgoexp_hashcode_symname.
          (let [name (aget (strings/SplitN extname "_" 4) 3)]
            (set! exports (append exports name)))))

      (when (== (len exports) 0)
        ;; See runtime/cgo/windows.go for details.
        (set! exports (append exports "_cgo_stub_export")))

      (sort/Strings exports)
      (.WriteString buf (strings/Join exports "\n"))

      (let [err (os/WriteFile fname (.Bytes buf) 0666)]
        (when (!= err nil)
          (Errorf "WriteFile %s failed: %v" fname err))


        ^{:line 1956} fname))))

^{:go/end 1957} (go/func peCreateExportFile "peCreateExportFile creates a file with exported symbols for Windows .def files.\nld will export all symbols, even those not marked for export, unless a .def file is provided.\n" [^{:tag (* Link)} ctxt ^string libName] :results [^string fname]
  (set! fname (filepath/Join @flagTmpdir "export_file.def"))
  (let [^bytes/Buffer buf (zero bytes/Buffer)]

    (when (== ^{:go/via [Target]} (.-BuildMode ctxt) BuildModeCShared)
      (fmt/Fprintf (addr buf) "LIBRARY %q\n" libName))

    (.WriteString buf "EXPORTS\n")

    (let [ldr (.-loader ctxt)
        ^{:line 1928 :tag (slice string)} exports (zero (slice string))]
      (range [s (.ForAllCgoExportStatic ldr)]
        (let [extname (.SymExtname ldr s)]

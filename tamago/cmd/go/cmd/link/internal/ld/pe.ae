(go/type peStringTable "peStringTable is a COFF string table.\n" (struct
    ^{:line 450 :tag (slice string)} strings
    ^{:line 451 :tag int} stringsLen))



^{:go/end 458} (go/method size "size returns size of string table t.\n" ^int [^{:tag (* peStringTable)} t]
  ;; string table starts with 4-byte length at the beginning
  (+ (.-stringsLen t) 4))



^{:go/end 466} (go/method add "add adds string str to string table t.\n" ^int [^{:tag (* peStringTable)} t ^string str]
  (let [off (.size t)]
    (set! (.-strings t) (append (.-strings t) str))
    (set! (.-stringsLen t) + (+ (len str) 1)) ; each string will have 0 appended to it
    ^{:line 465} off))



^{:go/end 475} (go/method write "write writes string table t into the output file.\n" [^{:tag (* peStringTable)} t ^{:tag (* OutBuf)} out]
  (.Write32 out (conv uint32 (.size t)))
  (range [_ s (.-strings t)]
    (.WriteString out s)
    (.Write8 out 0)))




(go/type peSection "peSection represents section from COFF section table.\n" (struct
    ^{:line 479 :tag string} name
    ^{:line 480 :tag string} shortName
    ^{:line 481 :tag int} index ; one-based index into the Section Table

^{:go/end 497} (go/method checkOffset "checkOffset verifies COFF section sect offset in the file.\n" [^{:tag (* peSection)} sect ^int64 off]
  (when (!= off (conv int64 (.-pointerToRawData sect)))
    (Errorf "%s.PointerToRawData = %#x, want %#x" (.-name sect) (conv uint64 (conv int64 (.-pointerToRawData sect))) (conv uint64 off))
    (errorexit)))





^{:go/end 510} (go/method checkSegment "checkSegment verifies COFF section sect matches address\nand file offset provided in segment seg.\n" [^{:tag (* peSection)} sect ^{:tag (* sym/Segment)} seg]
  (when (!= (- (.-Vaddr seg) (conv uint64 PEBASE)) (conv uint64 (.-virtualAddress sect)))
    (Errorf "%s.VirtualAddress = %#x, want %#x" (.-name sect) (conv uint64 (conv int64 (.-virtualAddress sect))) (conv uint64 (conv int64 (- (.-Vaddr seg) (conv uint64 PEBASE)))))
    (errorexit))

  (when (!= (.-Fileoff seg) (conv uint64 (.-pointerToRawData sect)))
    (Errorf "%s.PointerToRawData = %#x, want %#x" (.-name sect) (conv uint64 (conv int64 (.-pointerToRawData sect))) (conv uint64 (conv int64 (.-Fileoff seg))))
    (errorexit)))






^{:go/end 517} (go/method pad "pad adds zeros to the section sect. It writes as many bytes\nas necessary to make section sect.SizeOfRawData bytes long.\nIt assumes that n bytes are already written to the file.\n" [^{:tag (* peSection)} sect ^{:tag (* OutBuf)} out ^uint32 n]
  (.WriteStringN out "" (conv int (- (.-sizeOfRawData sect) n))))



^{:go/end 534} (go/method write "write writes COFF section sect into the output file.\n" ^error [^{:tag (* peSection)} sect ^{:tag (* OutBuf)} out ^LinkMode linkmode]
  (let [h ^{:go/breaks [2 4 6 8 10 12]} (lit pe/SectionHeader32
        :VirtualSize (.-virtualSize sect)
        :SizeOfRawData (.-sizeOfRawData sect)
        :PointerToRawData (.-pointerToRawData sect)
        :PointerToRelocations (.-pointerToRelocations sect)
        :NumberOfRelocations (.-numberOfRelocations sect)
        :Characteristics (.-characteristics sect))]

    (when (!= linkmode LinkExternal)
      (set! (.-VirtualAddress h) (.-virtualAddress sect)))

    (copy (subslice (.-Name h)) (.-shortName sect))

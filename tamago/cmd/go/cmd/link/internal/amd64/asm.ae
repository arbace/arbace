            (.SetRelocSym su rIdx (.-PLT syms))
            (.SetRelocAdd su rIdx (+ ^{:go/via [Reloc]} (.Add r) (conv int64 (.SymPlt ldr targ)))))


          (return true)))

      (case [(+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_X86_64_GOTPCREL))
          (+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_X86_64_GOTPCRELX))
          (+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_X86_64_REX_GOTPCRELX))]
        (let [su (.MakeSymbolUpdater ldr s)]
          (when (!= targType sym/SDYNIMPORT)

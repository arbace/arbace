            (return true))))

      ;; We only need to handle external linking mode, as R_GOTPCREL can
      ;; only occur in plugin or shared build modes.


      false)))


^{:go/end 505} (go/func elfreloc1 ^bool [^{:tag (* ld/Link)} ctxt ^{:tag (* ld/OutBuf)} out ^{:tag (* loader/Loader)} ldr ^loader/Sym s ^loader/ExtReloc r ^int ri ^int64 sectoff]
  (.Write64 out (conv uint64 sectoff))

  ^{:go/breaks [4]} (let [elfsym (ld/ElfSymForReloc ctxt (.-Xsym r))
      ^{:line 451} siz (.-Size r)]

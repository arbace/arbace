        (let [su (.MakeSymbolUpdater ldr s)]
          (.SetRelocType su rIdx objabi/R_PCREL)
          (.SetRelocAdd su rIdx (+ ^{:go/via [Reloc]} (.Add r) 4))
          (return true)))

      (case [(+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_X86_64_PC64))]
        (when (== targType sym/SDYNIMPORT)
          (.Errorf ldr s "unexpected R_X86_64_PC64 relocation for dynamic symbol %s" (.SymName ldr targ)))

        (when (or (== targType 0) (== targType sym/SXREF))
          (.Errorf ldr s "unknown symbol %s in pcrel" (.SymName ldr targ)))

        (let [su (.MakeSymbolUpdater ldr s)]
          (.SetRelocType su rIdx objabi/R_PCREL)

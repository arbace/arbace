^{:go/end 66} (go/func gentext [^{:tag (* ld/Link)} ctxt ^{:tag (* loader/Loader)} ldr]
  (let [(values initfunc addmoduledata) (ld/PrepareAddmoduledata ctxt)]
    (when (== initfunc nil)
      (return))


    (let [o ^{:go/end 53} (fn [& ^{:tag (slice uint8)} op]
          (range [_ op1 op]
            (.AddUint8 initfunc op1)))]



      ;; 0000000000000000 <local.dso_init>:
      ;;    0:	48 8d 3d 00 00 00 00 	lea    0x0(%rip),%rdi        # 7 <local.dso_init+0x7>
      ;; 			3: R_X86_64_PC32	runtime.firstmoduledata-0x4
      (o 0x48 0x8d 0x3d)
      (.AddPCRelPlus initfunc ^{:go/via [Target]} (.-Arch ctxt) (.-Moduledata ctxt) 0)
      ;;    7:	e8 00 00 00 00       	callq  c <local.dso_init+0xc>
      ;; 			8: R_X86_64_PLT32	runtime.addmoduledata-0x4
      (o 0xe8)
      (.AddSymRef initfunc ^{:go/via [Target]} (.-Arch ctxt) addmoduledata 0 objabi/R_CALL 4)
      ;;    c:	c3                   	retq
      (o 0xc3))))


^{:go/end 445} (go/func adddynrel ^bool [^{:tag (* ld/Target)} target ^{:tag (* loader/Loader)} ldr ^{:tag (* ld/ArchSyms)} syms ^loader/Sym s ^loader/Reloc r ^int rIdx]
  (let [targ (.Sym r)

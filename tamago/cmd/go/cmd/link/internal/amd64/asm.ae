      (default
        (return false))
      (case [objabi/R_ADDR objabi/R_DWARFSECREF]
        (cond (== siz 4)
          (.Write64 out (bit-or (conv uint64 elf/R_X86_64_32) (<< (conv uint64 elfsym) 32)))
          (== siz 8)
          (.Write64 out (bit-or (conv uint64 elf/R_X86_64_64) (<< (conv uint64 elfsym) 32))) :else

          (return false)))

      (case [objabi/R_TLS_LE]
        (if (== siz 4)
          (.Write64 out (bit-or (conv uint64 elf/R_X86_64_TPOFF32) (<< (conv uint64 elfsym) 32)))

          (return false)))

      (case [objabi/R_TLS_IE]
        (if (== siz 4)
          (.Write64 out (bit-or (conv uint64 elf/R_X86_64_GOTTPOFF) (<< (conv uint64 elfsym) 32)))

          (return false)))

      (case [objabi/R_CALL]
        (if (== siz 4)
          (if (== (.SymType ldr (.-Xsym r)) sym/SDYNIMPORT)
            (.Write64 out (bit-or (conv uint64 elf/R_X86_64_PLT32) (<< (conv uint64 elfsym) 32)))

            (.Write64 out (bit-or (conv uint64 elf/R_X86_64_PC32) (<< (conv uint64 elfsym) 32))))


          (return false)))

      (case [objabi/R_PCREL]
        (if (== siz 4)
          (if (and (== (.SymType ldr (.-Xsym r)) sym/SDYNIMPORT) (== (.SymElfType ldr (.-Xsym r)) elf/STT_FUNC))
            (.Write64 out (bit-or (conv uint64 elf/R_X86_64_PLT32) (<< (conv uint64 elfsym) 32)))

            (.Write64 out (bit-or (conv uint64 elf/R_X86_64_PC32) (<< (conv uint64 elfsym) 32))))


          (return false)))

      (case [objabi/R_GOTPCREL]
        (if (== siz 4)
          (.Write64 out (bit-or (conv uint64 elf/R_X86_64_GOTPCREL) (<< (conv uint64 elfsym) 32)))

          (return false))))



    (.Write64 out (conv uint64 (.-Xadd r)))
    true))


^{:go/end 569} (go/func machoreloc1 ^bool [^{:tag (* sys/Arch)} arch ^{:tag (* ld/OutBuf)} out ^{:tag (* loader/Loader)} ldr ^loader/Sym s ^loader/ExtReloc r ^int64 sectoff]
  ^{:go/breaks [7]} (let [^uint32 v (zero uint32)


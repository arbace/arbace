(ns go.cmd.link.internal.sym
  (:require [arbace.go :as go]))

(go/package sym
  :path "cmd/link/internal/sym"
  :files ["compilation_unit.go" "library.go" "reloc.go" "segment.go" "symbol.go" "symkind.go" "symkind_string.go"]
  :positions :lines)

(load "sym/compilation_unit")
(load "sym/library")
(load "sym/reloc")
(load "sym/segment")
(load "sym/symbol")
(load "sym/symkind")
(load "sym/symkind_string")

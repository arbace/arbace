(in-ns 'go.cmd.link.internal.arm) (go/file "obj.go" :imports [


    ^{:line 34} [objabi "cmd/internal/objabi"]
    ^{:line 35} [sys "cmd/internal/sys"]
    ^{:line 36} [ld "cmd/link/internal/ld"]])


^{:go/end 78} (go/func Init [] :results [(* sys/Arch) ld/Arch]
  (let [arch sys/ArchARM

      ^{:line 42} theArch ^{:go/breaks [2 4 6 8 10 12 [14 50] [16 52] 18 20 22 24 26 28 30 32 [34 62]]} (lit ld/Arch
        :Funcalign funcAlign
        :Maxalign maxAlign
        :Minalign minAlign
        :Dwarfregsp dwarfRegSP
        :Dwarfreglr dwarfRegLR
        :TrampLimit 0x1c00000 ; 24-bit signed offset * 4, leave room for PLT etc.

        :Plan9Magic 0x647

        :Adddynrel adddynrel
        :Archinit archinit
        :Archreloc archreloc
        :Archrelocvariant archrelocvariant
        :Extreloc extreloc
        :Trampoline trampoline
        :Gentext gentext
        :Machoreloc1 machoreloc1
        :PEreloc1 pereloc1

        :ELF ^{:go/breaks [2 4 6 8 10 12 14 [16 71] 18 20]} (lit ld/ELFArch
          :Linuxdynld "/lib/ld-linux.so.3" ; 2 for OABI, 3 for EABI
          :LinuxdynldMusl "/lib/ld-musl-arm.so.1"
          :Freebsddynld "/usr/libexec/ld-elf.so.1"
          :Openbsddynld "/usr/libexec/ld.so"
          :Netbsddynld "/libexec/ld.elf_so"
          :Dragonflydynld "XXX"
          :Solarisdynld "XXX"

          :Reloc1 elfreloc1
          :RelocSize 8
          :SetupPLT elfsetupplt))]



    (return arch theArch)))


^{:go/end 110} (go/func archinit [^{:tag (* ld/Link)} ctxt]
  (switch ^{:go/via [Target]} (.-HeadType ctxt)
    (default
      (ld/Exitf "unknown -H option: %v" ^{:go/via [Target]} (.-HeadType ctxt)))

    (case [objabi/Hplan9] ; /* plan 9 */
      (set! ld/HEADR 32)
      (when (== @ld/FlagRound -1)
        (set! @ld/FlagRound 4096))

      (when (== @ld/FlagTextAddr -1)
        (set! @ld/FlagTextAddr (+ (ld/Rnd 4096 @ld/FlagRound) (conv int64 ld/HEADR)))))


    (case [objabi/Hlinux ; /* arm elf */
        ^{:line 95} objabi/Hfreebsd
        ^{:line 96} objabi/Hnetbsd
        ^{:line 97} objabi/Hopenbsd
        ^{:line 98} objabi/Htamago]
      (set! @ld/FlagD false)
      ;; with dynamic linking
      (ld/Elfinit ctxt)
      (set! ld/HEADR ld/ELFRESERVE)
      (when (== @ld/FlagRound -1)
        (set! @ld/FlagRound 0x10000))

      (when (== @ld/FlagTextAddr -1)
        (set! @ld/FlagTextAddr (+ (ld/Rnd 0x10000 @ld/FlagRound) (conv int64 ld/HEADR)))))))

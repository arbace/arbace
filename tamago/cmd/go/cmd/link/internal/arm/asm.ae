^{:go/end 330} (go/func elfsetupplt [^{:tag (* ld/Link)} ctxt ^{:tag (* loader/Loader)} ldr ^{:tag (* loader/SymbolBuilder)} plt ^{:tag (* loader/SymbolBuilder)} got ^loader/Sym dynamic]
  (when (== (.Size plt) 0)
    ;; str lr, [sp, #-4]!
    (.AddUint32 plt ^{:go/via [Target]} (.-Arch ctxt) 0xe52de004)

    ;; ldr lr, [pc, #4]
    (.AddUint32 plt ^{:go/via [Target]} (.-Arch ctxt) 0xe59fe004)

    ;; add lr, pc, lr
    (.AddUint32 plt ^{:go/via [Target]} (.-Arch ctxt) 0xe08fe00e)

    ;; ldr pc, [lr, #8]!
    (.AddUint32 plt ^{:go/via [Target]} (.-Arch ctxt) 0xe5bef008)

    ;; .word &GLOBAL_OFFSET_TABLE[0] - .
    (.AddPCRelPlus plt ^{:go/via [Target]} (.-Arch ctxt) (.Sym got) 4)

    ;; the first .plt entry requires 3 .plt.got entries
    (.AddUint32 got ^{:go/via [Target]} (.-Arch ctxt) 0)

    (.AddUint32 got ^{:go/via [Target]} (.-Arch ctxt) 0)
    (.AddUint32 got ^{:go/via [Target]} (.-Arch ctxt) 0)))




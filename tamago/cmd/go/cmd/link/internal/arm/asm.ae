^{:go/end 451} (go/func trampoline "Convert the direct jump relocation r to refer to a trampoline if the target is too far.\n" [^{:tag (* ld/Link)} ctxt ^{:tag (* loader/Loader)} ldr ^int ri ^loader/Sym rs ^loader/Sym s]

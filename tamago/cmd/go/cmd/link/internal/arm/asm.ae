          (return true)))

      (case [(+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_ARM_GOTPC))] ; R_ARM_BASE_PREL
        (let [su (.MakeSymbolUpdater ldr s)]
          (.SetRelocType su rIdx objabi/R_PCREL)
          (.SetRelocSym su rIdx (.-GOT syms))
          (.SetRelocAdd su rIdx (+ ^{:go/via [Reloc]} (.Add r) 4))
          (return true)))

      (case [(+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_ARM_CALL))]
        (let [su (.MakeSymbolUpdater ldr s)]
          (.SetRelocType su rIdx objabi/R_CALLARM)
          (when (== targType sym/SDYNIMPORT)
            (addpltsym target ldr syms targ)
            (.SetRelocSym su rIdx (.-PLT syms))
            (.SetRelocAdd su rIdx (conv int64 (braddoff (conv int32 ^{:go/via [Reloc]} (.Add r)) (/ (.SymPlt ldr targ) 4)))))

          (return true)))

      (case [(+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_ARM_REL32))] ; R_ARM_REL32
        (let [su (.MakeSymbolUpdater ldr s)]
          (.SetRelocType su rIdx objabi/R_PCREL)
          (.SetRelocAdd su rIdx (+ ^{:go/via [Reloc]} (.Add r) 4))
          (return true)))

      (case [(+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_ARM_ABS32))]
        (when (== targType sym/SDYNIMPORT)
          (.Errorf ldr s "unexpected R_ARM_ABS32 relocation for dynamic symbol %s" (.SymName ldr targ)))

        (let [su (.MakeSymbolUpdater ldr s)]
          (.SetRelocType su rIdx objabi/R_ADDR)
          (return true)))

      (case [(+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_ARM_PC24))
          (+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_ARM_JUMP24))]
        (let [su (.MakeSymbolUpdater ldr s)]
          (.SetRelocType su rIdx objabi/R_CALLARM)
          (when (== targType sym/SDYNIMPORT)

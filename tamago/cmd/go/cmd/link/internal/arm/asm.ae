;; This assembler:
;;
;;         .align 2
;; local.dso_init:
;;         ldr r0, .Lmoduledata
;; .Lloadfrom:
;;         ldr r0, [r0]
;;         b runtime.addmoduledata@plt
;; .align 2
;; .Lmoduledata:
;;         .word local.moduledata(GOT_PREL) + (. - (.Lloadfrom + 4))
;; assembles to:
;;
;; 00000000 <local.dso_init>:
;;    0:        e59f0004        ldr     r0, [pc, #4]    ; c <local.dso_init+0xc>
;;    4:        e5900000        ldr     r0, [r0]
;;    8:        eafffffe        b       0 <runtime.addmoduledata>
;;                      8: R_ARM_JUMP24 runtime.addmoduledata
;;    c:        00000004        .word   0x00000004
;;                      c: R_ARM_GOT_PREL       local.moduledata

^{:go/end 91} (go/func gentext [^{:tag (* ld/Link)} ctxt ^{:tag (* loader/Loader)} ldr]
  (let [(values initfunc addmoduledata) (ld/PrepareAddmoduledata ctxt)]
    (when (== initfunc nil)
      (return))


    (let [o ^{:go/end 73} (fn [^uint32 op]
          (.AddUint32 initfunc ^{:go/via [Target]} (.-Arch ctxt) op))]

      (o 0xe59f0004)
      (o 0xe08f0000)

      (o 0xeafffffe)
      (let [(values rel _) (.AddRel initfunc objabi/R_CALLARM)]
        ^{:go/via [Reloc]} (.SetOff rel 8)
        ^{:go/via [Reloc]} (.SetSiz rel 4)
        (.SetSym rel addmoduledata)
        ^{:go/via [Reloc]} (.SetAdd rel 0xeafffffe) ; vomit

        (o 0x00000000)

        (let [(values rel2 _) (.AddRel initfunc objabi/R_PCREL)]
          ^{:go/via [Reloc]} (.SetOff rel2 12)
          ^{:go/via [Reloc]} (.SetSiz rel2 4)
          (.SetSym rel2 (.-Moduledata ctxt))
          ^{:go/via [Reloc]} (.SetAdd rel2 4))))))




^{:go/end 97} (go/func braddoff "Preserve highest 8 bits of a, and do addition to lower 24-bit\nof a and b; used to adjust ARM branch instruction's target.\n" ^int32 [^int32 a ^int32 b]
  (conv int32 (bit-or (bit-and (conv uint32 a) 0xff000000) (bit-and 0x00ffffff (conv uint32 (+ a b))))))


^{:go/end 258} (go/func adddynrel ^bool [^{:tag (* ld/Target)} target ^{:tag (* loader/Loader)} ldr ^{:tag (* ld/ArchSyms)} syms ^loader/Sym s ^loader/Reloc r ^int rIdx]


            (.SetRelocAdd su rIdx (conv int64 (braddoff (conv int32 ^{:go/via [Reloc]} (.Add r)) (/ (.SymPlt ldr targ) 4)))) ; TODO: don't use r.Add for instruction bytes (issue 19811)
            (return true)))


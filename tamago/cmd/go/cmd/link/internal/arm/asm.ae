        (let [su (.MakeSymbolUpdater ldr s)]
          (.SetRelocType su rIdx objabi/R_CONST) ; write r->add during relocsym
          (.SetRelocSym su rIdx 0)
          (.SetRelocAdd su rIdx (+ ^{:go/via [Reloc]} (.Add r) (conv int64 (.SymGot ldr targ))))
          (return true)))

      (case [(+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_ARM_GOT_PREL))] ; GOT(nil) + A - nil
        (if (!= targType sym/SDYNIMPORT)
          (addgotsyminternal target ldr syms targ)


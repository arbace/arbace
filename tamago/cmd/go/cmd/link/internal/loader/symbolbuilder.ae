  (let [symIdx (.CreateStaticSym l name)
      ^{:line 29} sb (addr (lit SymbolBuilder :l l :symIdx symIdx))]
    (set! (.-extSymPayload sb) (.getPayload l symIdx))
    ^{:line 31} sb))







^{:go/end 52} (go/method MakeSymbolUpdater "MakeSymbolUpdater creates a symbol builder helper for an existing\nsymbol 'symIdx'. If 'symIdx' is not an external symbol, then create\na clone of it (copy name, properties, etc) fix things up so that\nthe lookup tables and caches point to the new version, not the old\nversion.\n" ^{:tag (* SymbolBuilder)} [^{:tag (* Loader)} l ^Sym symIdx]
  (when (== symIdx 0)
    (panic "can't update the null symbol"))

  (when (not (.IsExternal l symIdx))
    ;; Create a clone with the same name/version/kind etc.
    (.cloneToExternal l symIdx))


  ;; Construct updater and return.
  (let [sb (addr (lit SymbolBuilder :l l :symIdx symIdx))]
    (set! (.-extSymPayload sb) (.getPayload l symIdx))
    ^{:line 51} sb))






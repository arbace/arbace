    (return ^{:go/end 412} (fn ^int64 [^{:tag (* SymbolBuilder)} s ^{:tag (* sys/Arch)} arch ^Sym tgt ^int64 add]
        (when [v (.SymValue (.-l s) tgt)] (!= v 0)
          (return (.AddUint s arch (conv uint64 (+ v add)))))

        (.AddAddrPlus s arch tgt add)))


    (return (method-expr (* SymbolBuilder) AddAddrPlus))))




^{:go/end 441} (go/method AddUleb [^{:tag (* SymbolBuilder)} sb ^uint64 v]
  (when (< v 128) ; common case: 1 byte
    (.AddUint8 sb (conv uint8 v))
    (return))

  (while true
    (let [c (conv uint8 (bit-and v 0x7f))]
      (set! v >> 7)
      (when (!= v 0)
        (set! c bit-or 0x80))

      (.AddUint8 sb c)
      (when (== (bit-and c 0x80) 0)
        (break)))))

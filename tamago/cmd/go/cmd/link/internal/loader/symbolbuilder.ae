^{:go/end 32} (go/method MakeSymbolBuilder "MakeSymbolBuilder creates a symbol builder for use in constructing\nan entirely new symbol.\n" ^{:tag (* SymbolBuilder)} [^{:tag (* Loader)} l ^string name]

^{:go/end 559} (go/method newExtSym "newExtSym creates a new external sym with the specified\nname/version.\n" ^Sym [^{:tag (* Loader)} l ^string name ^int ver]
  (let [i (conv Sym (len (.-objSyms l)))]
    (when (!= (conv int i) (len (.-objSyms l))) ; overflow
      (panic "too many symbols"))

    (when (== (.-extStart l) 0)
      (set! (.-extStart l) i))

    (.growValues l (+ (conv int i) 1))
    (.growOuter l (+ (conv int i) 1))
    (.growAttrBitmaps l (+ (conv int i) 1))

      (fmt/Println (.-Lib (.-unit r)))))


  (fmt/Println "extStart:" (.-extStart l))
  (fmt/Println "Nsyms:" (len (.-objSyms l)))
  (fmt/Println "syms")
  (for [i (conv Sym 1)] (< i (conv Sym (len (.-objSyms l)))) (inc! i)
    (let [pi ""]
      (when (.IsExternal l i)
        (set! pi (fmt/Sprintf "<ext %d>" (.extIndex l i))))

      (let [sect ""]
        (when (!= (.SymSect l i) nil)
          (set! sect (.-Name (.SymSect l i))))

        (fmt/Printf "%v %v %v %v %x %v\n" i (.SymName l i) (.SymType l i) pi (.SymValue l i) sect))))

  (fmt/Println "symsByName")
  (range [name i (aget (.-symsByName l) 0)]
    (fmt/Println i name 0))

  (range [name i (aget (.-symsByName l) 1)]
    (fmt/Println i name 1))

  (fmt/Println "payloads:")
  (range [i (.-payloads l)]
    (let [pp (aget (.-payloads l) i)]
      (fmt/Println i (.-name pp) (.-ver pp) (.-kind pp)))))

(in-ns 'go.cmd.link.internal.s390x) (go/file "obj.go" :imports [


    ^{:line 34} [objabi "cmd/internal/objabi"]
    ^{:line 35} [sys "cmd/internal/sys"]
    ^{:line 36} [ld "cmd/link/internal/ld"]])


^{:go/end 75} (go/func Init [] :results [(* sys/Arch) ld/Arch]
  (let [arch sys/ArchS390X

      ^{:line 42} theArch ^{:go/breaks [2 4 6 8 10 [12 49] 14 16 18 20 22 24 [26 57]]} (lit ld/Arch
        :Funcalign funcAlign
        :Maxalign maxAlign
        :Minalign minAlign
        :Dwarfregsp dwarfRegSP
        :Dwarfreglr dwarfRegLR

        :Adddynrel adddynrel
        :Archinit archinit
        :Archreloc archreloc
        :Archrelocvariant archrelocvariant
        :Gentext gentext
        :Machoreloc1 machoreloc1
        :TLSIEtoLE tlsIEtoLE

        :ELF ^{:go/breaks [2 4 [6 62] 8 10 12 14 [16 68] 18 20]} (lit ld/ELFArch
          :Linuxdynld "/lib/ld64.so.1"
          :LinuxdynldMusl "/lib/ld-musl-s390x.so.1"

          ;; not relevant for s390x
          :Freebsddynld "XXX"
          :Openbsddynld "XXX"
          :Netbsddynld "XXX"
          :Dragonflydynld "XXX"
          :Solarisdynld "XXX"

          :Reloc1 elfreloc1
          :RelocSize 24
          :SetupPLT elfsetupplt))]



    (return arch theArch)))


^{:go/end 92} (go/func archinit [^{:tag (* ld/Link)} ctxt]
  (switch ^{:go/via [Target]} (.-HeadType ctxt)
    (default
      (ld/Exitf "unknown -H option: %v" ^{:go/via [Target]} (.-HeadType ctxt)))

    (case [objabi/Hlinux] ; s390x ELF
      (ld/Elfinit ctxt)
      (set! ld/HEADR ld/ELFRESERVE)
      (when (== @ld/FlagRound -1)
        (set! @ld/FlagRound 0x10000))

      (when (== @ld/FlagTextAddr -1)
        (set! @ld/FlagTextAddr (+ (ld/Rnd 0x10000 @ld/FlagRound) (conv int64 ld/HEADR)))))))

^{:go/end 75} (go/func gentext "gentext generates assembly to append the local moduledata to the global\nmoduledata linked list at initialization time. This is only done if the runtime\nis in a different module.\n\n\t<go.link.addmoduledata>:\n\t\tlarl  %r2, <local.moduledata>\n\t\tjg    <runtime.addmoduledata@plt>\n\t\tundef\n\nThe job of appending the moduledata is delegated to runtime.addmoduledata.\n" [^{:tag (* ld/Link)} ctxt ^{:tag (* loader/Loader)} ldr]
  (let [(values initfunc addmoduledata) (ld/PrepareAddmoduledata ctxt)]
    (when (== initfunc nil)
      (return))


    ;; larl %r2, <local.moduledata>
    (.AddUint8 initfunc 0xc0)
    (.AddUint8 initfunc 0x20)
    (.AddSymRef initfunc ^{:go/via [Target]} (.-Arch ctxt) (.-Moduledata ctxt) 6 objabi/R_PCREL 4)
    (let [r1 (.Relocs initfunc)]
      (.SetRelocVariant ldr (.Sym initfunc) (- (.Count r1) 1) sym/RV_390_DBL)

      ;; jg <runtime.addmoduledata[@plt]>
      (.AddUint8 initfunc 0xc0)
      (.AddUint8 initfunc 0xf4)
      (.AddSymRef initfunc ^{:go/via [Target]} (.-Arch ctxt) addmoduledata 6 objabi/R_CALL 4)
      (let [r2 (.Relocs initfunc)]
        (.SetRelocVariant ldr (.Sym initfunc) (- (.Count r2) 1) sym/RV_390_DBL)

        ;; undef (for debugging)
        (.AddUint32 initfunc ^{:go/via [Target]} (.-Arch ctxt) 0)))))


^{:go/end 315} (go/func adddynrel ^bool [^{:tag (* ld/Target)} target ^{:tag (* loader/Loader)} ldr ^{:tag (* ld/ArchSyms)} syms ^loader/Sym s ^loader/Reloc r ^int rIdx]
  (let [targ (.Sym r)
      ^{:line 79 :tag sym/SymKind} targType (zero sym/SymKind)]
    (when (!= targ 0)
      (set! targType (.SymType ldr targ)))


    (switch (.Type r)
      (default
        (when (>= (.Type r) objabi/ElfRelocOffset)
          (.Errorf ldr s "unexpected relocation type %d" (.Type r))
          (return false)))


      ;; Handle relocations found in ELF object files.
      (case [(+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_390_12))
          (+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_390_GOT12))]
        (.Errorf ldr s "s390x 12-bit relocations have not been implemented (relocation type %d)" (- (.Type r) objabi/ElfRelocOffset))
        (return false))

      (case [(+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_390_8))
          (+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_390_16))
          (+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_390_32))
          (+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_390_64))]
        (when (== targType sym/SDYNIMPORT)
          (.Errorf ldr s "unexpected R_390_nn relocation for dynamic symbol %s" (.SymName ldr targ)))

        (let [su (.MakeSymbolUpdater ldr s)]
          (.SetRelocType su rIdx objabi/R_ADDR)
          (when (and (.IsPIE target) (.IsInternal target))
            ;; For internal linking PIE, this R_ADDR relocation cannot
            ;; be resolved statically. We need to generate a dynamic
            ;; relocation. Let the code below handle it.
            (break))

          (return true)))

      (case [(+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_390_PC16))
          (+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_390_PC32))
          (+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_390_PC64))]
        (when (== targType sym/SDYNIMPORT)
          (.Errorf ldr s "unexpected R_390_PCnn relocation for dynamic symbol %s" (.SymName ldr targ)))

        (when (or (== targType 0) (== targType sym/SXREF))
          (.Errorf ldr s "unknown symbol %s in pcrel" (.SymName ldr targ)))

        (let [su (.MakeSymbolUpdater ldr s)]
          (.SetRelocType su rIdx objabi/R_PCREL)
          (.SetRelocAdd su rIdx (+ ^{:go/via [Reloc]} (.Add r) (conv int64 ^{:go/via [Reloc]} (.Siz r))))
          (return true)))

      (case [(+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_390_GOT16))
          (+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_390_GOT32))
          (+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_390_GOT64))]
        (.Errorf ldr s "unimplemented S390x relocation: %v" (- (.Type r) objabi/ElfRelocOffset))
        (return true))

      (case [(+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_390_PLT16DBL))
          (+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_390_PLT32DBL))]
        (let [su (.MakeSymbolUpdater ldr s)]
          (.SetRelocType su rIdx objabi/R_PCREL)
          (.SetRelocVariant ldr s rIdx sym/RV_390_DBL)
          (.SetRelocAdd su rIdx (+ ^{:go/via [Reloc]} (.Add r) (conv int64 ^{:go/via [Reloc]} (.Siz r))))
          (when (== targType sym/SDYNIMPORT)
            (addpltsym target ldr syms targ)
            (.SetSym r (.-PLT syms))
            (.SetRelocAdd su rIdx (+ ^{:go/via [Reloc]} (.Add r) (conv int64 (.SymPlt ldr targ)))))

          (return true)))

      (case [(+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_390_PLT32))
          (+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_390_PLT64))]
        (let [su (.MakeSymbolUpdater ldr s)]
          (.SetRelocType su rIdx objabi/R_PCREL)
          (.SetRelocAdd su rIdx (+ ^{:go/via [Reloc]} (.Add r) (conv int64 ^{:go/via [Reloc]} (.Siz r))))
          (when (== targType sym/SDYNIMPORT)
            (addpltsym target ldr syms targ)
            (.SetSym r (.-PLT syms))
            (.SetRelocAdd su rIdx (+ ^{:go/via [Reloc]} (.Add r) (conv int64 (.SymPlt ldr targ)))))

          (return true)))

      (case [(+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_390_COPY))]
        (.Errorf ldr s "unimplemented S390x relocation: %v" (- (.Type r) objabi/ElfRelocOffset))
        (return false))

      (case [(+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_390_GLOB_DAT))]
        (.Errorf ldr s "unimplemented S390x relocation: %v" (- (.Type r) objabi/ElfRelocOffset))
        (return false))

      (case [(+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_390_JMP_SLOT))]
        (.Errorf ldr s "unimplemented S390x relocation: %v" (- (.Type r) objabi/ElfRelocOffset))
        (return false))

      (case [(+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_390_RELATIVE))]
        (.Errorf ldr s "unimplemented S390x relocation: %v" (- (.Type r) objabi/ElfRelocOffset))
        (return false))

      (case [(+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_390_GOTOFF))]
        (when (== targType sym/SDYNIMPORT)
          (.Errorf ldr s "unexpected R_390_GOTOFF relocation for dynamic symbol %s" (.SymName ldr targ)))

        (let [su (.MakeSymbolUpdater ldr s)]
          (.SetRelocType su rIdx objabi/R_GOTOFF)
          (return true)))

      (case [(+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_390_GOTPC))]
        (let [su (.MakeSymbolUpdater ldr s)]
          (.SetRelocType su rIdx objabi/R_PCREL)
          (.SetSym r (.-GOT syms))
          (.SetRelocAdd su rIdx (+ ^{:go/via [Reloc]} (.Add r) (conv int64 ^{:go/via [Reloc]} (.Siz r))))
          (return true)))

      (case [(+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_390_PC16DBL))
          (+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_390_PC32DBL))]
        (let [su (.MakeSymbolUpdater ldr s)]
          (.SetRelocType su rIdx objabi/R_PCREL)
          (.SetRelocVariant ldr s rIdx sym/RV_390_DBL)
          (.SetRelocAdd su rIdx (+ ^{:go/via [Reloc]} (.Add r) (conv int64 ^{:go/via [Reloc]} (.Siz r))))
          (when (== targType sym/SDYNIMPORT)
            (.Errorf ldr s "unexpected R_390_PCnnDBL relocation for dynamic symbol %s" (.SymName ldr targ)))

          (return true)))

      (case [(+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_390_GOTPCDBL))]
        (let [su (.MakeSymbolUpdater ldr s)]
          (.SetRelocType su rIdx objabi/R_PCREL)
          (.SetRelocVariant ldr s rIdx sym/RV_390_DBL)
          (.SetSym r (.-GOT syms))
          (.SetRelocAdd su rIdx (+ ^{:go/via [Reloc]} (.Add r) (conv int64 ^{:go/via [Reloc]} (.Siz r))))
          (return true)))

      (case [(+ objabi/ElfRelocOffset (conv objabi/RelocType elf/R_390_GOTENT))]
        (ld/AddGotSym target ldr syms targ (conv uint32 elf/R_390_GLOB_DAT))
        (let [su (.MakeSymbolUpdater ldr s)]
          (.SetRelocType su rIdx objabi/R_PCREL)
          (.SetRelocVariant ldr s rIdx sym/RV_390_DBL)
          (.SetSym r (.-GOT syms))
          (.SetRelocAdd su rIdx (+ ^{:go/via [Reloc]} (.Add r) (conv int64 (.SymGot ldr targ)) (conv int64 ^{:go/via [Reloc]} (.Siz r))))
          (return true))))


    ;; Reread the reloc to incorporate any changes in type above.
    (let [relocs (.Relocs ldr s)]
      (set! r (.At relocs rIdx))

      (switch (.Type r)
        (case [objabi/R_CALL objabi/R_PCRELDBL]
          (when (!= targType sym/SDYNIMPORT)
            ;; nothing to do, the relocation will be laid out in reloc
            (return true))

          (when (.IsExternal target)
            ;; External linker will do this relocation.
            (return true))

          ;; Internal linking: build a PLT entry and redirect to it.
          (addpltsym target ldr syms targ)
          (let [su (.MakeSymbolUpdater ldr s)]
            (.SetRelocSym su rIdx (.-PLT syms))
            (.SetRelocAdd su rIdx (+ ^{:go/via [Reloc]} (.Add r) (conv int64 (.SymPlt ldr targ))))
            (return true)))

        (case [objabi/R_ADDR]
          (when (and (.IsText (.SymType ldr s)) (.IsElf target))
            ;; The code is asking for the address of an external
            ;; function. We provide it with the address of the
            ;; correspondent GOT symbol.
            (ld/AddGotSym target ldr syms targ (conv uint32 elf/R_390_GLOB_DAT))
            (let [su (.MakeSymbolUpdater ldr s)]
              (.SetRelocSym su rIdx (.-GOT syms))
              (.SetRelocAdd su rIdx (+ ^{:go/via [Reloc]} (.Add r) (conv int64 (.SymGot ldr targ))))
              (return true)))


          ;; Process dynamic relocations for the data sections.
          (if (and (.IsPIE target) (.IsInternal target))
            ;; When internally linking, generate dynamic relocations
            ;; for all typical R_ADDR relocations. The exception
            ;; are those R_ADDR that are created as part of generating
            ;; the dynamic relocations and must be resolved statically.
            ;;
            ;; These synthetic static R_ADDR relocs must be skipped
            ;; now, or else we will be caught in an infinite loop
            ;; of generating synthetic relocs for our synthetic
            ;; relocs.
            (switch (.SymName ldr s)
              (case [".dynsym" ".rela" ".rela.plt" ".got.plt" ".dynamic"]
                (return false)))

            (do
              ;; Either internally linking a static executable,
              ;; in which case we can resolve these relocations
              ;; statically in the 'reloc' phase, or externally
              ;; linking, in which case the relocation will be
              ;; prepared in the 'reloc' phase and passed to the
              ;; external linker in the 'asmb' phase.
              (when [t (.SymType ldr s)] (and (not (.IsDATA t)) (not (.IsRODATA t)))
                (break))))



          (when (.IsElf target)
            ;; Generate R_390_RELATIVE relocations for best
            ;; efficiency in the dynamic linker.
            ;;
            ;; As noted above, symbol addresses have not been
            ;; assigned yet, so we can't generate the final reloc
            ;; entry yet. We ultimately want:
            ;;
            ;; r_offset = s + r.Off
            ;; r_info = R_390_RELATIVE
            ;; r_addend = targ + r.Add
            ;;
            ;; The dynamic linker will set *offset = base address +
            ;; addend.
            ;;
            ;; AddAddrPlus is used for r_offset and r_addend to
            ;; generate new R_ADDR relocations that will update
            ;; these fields in the 'reloc' phase.
            (let [rela (.MakeSymbolUpdater ldr (.-Rela syms))]
              (.AddAddrPlus rela (.-Arch target) s (conv int64 ^{:go/via [Reloc]} (.Off r)))
              (if (== ^{:go/via [Reloc]} (.Siz r) 8)
                (.AddUint64 rela (.-Arch target) (elf/R_INFO 0 (conv uint32 elf/R_390_RELATIVE)))

                (.Errorf ldr s "unexpected relocation for dynamic symbol %s" (.SymName ldr targ)))

              (.AddAddrPlus rela (.-Arch target) targ ^{:go/via [Reloc]} (.Add r))
              ;; Not mark r done here. So we still apply it statically,
              ;; so in the file content we'll also have the right offset
              ;; to the relocation target. So it can be examined statically
              ;; (e.g. go version).
              (return true)))))



      ;; Handle references to ELF symbols from our own object files.
      (!= targType sym/SDYNIMPORT))))


^{:go/end 411} (go/func elfreloc1 ^bool [^{:tag (* ld/Link)} ctxt ^{:tag (* ld/OutBuf)} out ^{:tag (* loader/Loader)} ldr ^loader/Sym s ^loader/ExtReloc r ^int ri ^int64 sectoff]
  (.Write64 out (conv uint64 sectoff))

  ^{:go/breaks [4]} (let [elfsym (ld/ElfSymForReloc ctxt (.-Xsym r))
      ^{:line 321} siz (.-Size r)]
    (switch (.-Type r)
      (default
        (return false))
      (case [objabi/R_TLS_LE]
        (switch siz
          (default
            (return false))
          (case [4]
            ;; WARNING - silently ignored by linker in ELF64
            (.Write64 out (bit-or (conv uint64 elf/R_390_TLS_LE32) (<< (conv uint64 elfsym) 32))))
          (case [8]
            ;; WARNING - silently ignored by linker in ELF32
            (.Write64 out (bit-or (conv uint64 elf/R_390_TLS_LE64) (<< (conv uint64 elfsym) 32))))))

      (case [objabi/R_TLS_IE]
        (switch siz
          (default
            (return false))
          (case [4]
            (.Write64 out (bit-or (conv uint64 elf/R_390_TLS_IEENT) (<< (conv uint64 elfsym) 32))))))

      (case [objabi/R_ADDR objabi/R_DWARFSECREF]
        (switch siz
          (default
            (return false))
          (case [4]
            (.Write64 out (bit-or (conv uint64 elf/R_390_32) (<< (conv uint64 elfsym) 32))))
          (case [8]
            (.Write64 out (bit-or (conv uint64 elf/R_390_64) (<< (conv uint64 elfsym) 32))))))

      (case [objabi/R_GOTPCREL]
        (if (== siz 4)
          (.Write64 out (bit-or (conv uint64 elf/R_390_GOTENT) (<< (conv uint64 elfsym) 32)))

          (return false)))

      (case [objabi/R_PCREL objabi/R_PCRELDBL objabi/R_CALL]
        (let [elfrel elf/R_390_NONE
            ^{:line 360} rVariant (.RelocVariant ldr s ri)
            ^{:line 361} isdbl (== (bit-and rVariant sym/RV_TYPE_MASK) sym/RV_390_DBL)]
          ;; TODO(mundaym): all DBL style relocations should be
          ;; signalled using the variant - see issue 14218.
          (switch (.-Type r)
            (case [objabi/R_PCRELDBL objabi/R_CALL]
              (set! isdbl true)))

          (if (and (== (.SymType ldr (.-Xsym r)) sym/SDYNIMPORT) ^:go/paren (or (== (.SymElfType ldr (.-Xsym r)) elf/STT_FUNC) (== (.-Type r) objabi/R_CALL)))
            (if isdbl
              (switch siz
                (case [2]
                  (set! elfrel elf/R_390_PLT16DBL))
                (case [4]
                  (set! elfrel elf/R_390_PLT32DBL)))


              (switch siz
                (case [4]
                  (set! elfrel elf/R_390_PLT32))
                (case [8]
                  (set! elfrel elf/R_390_PLT64))))


            (do
              (if isdbl
                (switch siz
                  (case [2]
                    (set! elfrel elf/R_390_PC16DBL))
                  (case [4]
                    (set! elfrel elf/R_390_PC32DBL)))


                (switch siz
                  (case [2]
                    (set! elfrel elf/R_390_PC16))
                  (case [4]
                    (set! elfrel elf/R_390_PC32))
                  (case [8]
                    (set! elfrel elf/R_390_PC64))))))



          (when (== elfrel elf/R_390_NONE)
            (return false)) ; unsupported size/dbl combination

          (.Write64 out (bit-or (conv uint64 elfrel) (<< (conv uint64 elfsym) 32))))))


    (.Write64 out (conv uint64 (.-Xadd r)))
    true))


^{:go/end 459} (go/func elfsetupplt [^{:tag (* ld/Link)} ctxt ^{:tag (* loader/Loader)} ldr ^{:tag (* loader/SymbolBuilder)} plt ^{:tag (* loader/SymbolBuilder)} gotplt ^loader/Sym dynamic]
  (when (== (.Size plt) 0)
    ;; stg     %r1,56(%r15)
    (.AddUint8 plt 0xe3)
    (.AddUint8 plt 0x10)
    (.AddUint8 plt 0xf0)
    (.AddUint8 plt 0x38)
    (.AddUint8 plt 0x00)
    (.AddUint8 plt 0x24)
    ;; larl    %r1,_GLOBAL_OFFSET_TABLE_
    (.AddUint8 plt 0xc0)
    (.AddUint8 plt 0x10)
    (.AddSymRef plt ^{:go/via [Target]} (.-Arch ctxt) (.Sym gotplt) 6 objabi/R_PCRELDBL 4)
    ;; mvc     48(8,%r15),8(%r1)
    (.AddUint8 plt 0xd2)
    (.AddUint8 plt 0x07)
    (.AddUint8 plt 0xf0)
    (.AddUint8 plt 0x30)
    (.AddUint8 plt 0x10)
    (.AddUint8 plt 0x08)
    ;; lg      %r1,16(%r1)
    (.AddUint8 plt 0xe3)
    (.AddUint8 plt 0x10)
    (.AddUint8 plt 0x10)
    (.AddUint8 plt 0x10)
    (.AddUint8 plt 0x00)
    (.AddUint8 plt 0x04)
    ;; br      %r1
    (.AddUint8 plt 0x07)
    (.AddUint8 plt 0xf1)
    ;; nopr    %r0
    (.AddUint8 plt 0x07)
    (.AddUint8 plt 0x00)
    ;; nopr    %r0
    (.AddUint8 plt 0x07)
    (.AddUint8 plt 0x00)
    ;; nopr    %r0
    (.AddUint8 plt 0x07)
    (.AddUint8 plt 0x00)

    ;; assume gotplt.size == 0 too
    (.AddAddrPlus gotplt ^{:go/via [Target]} (.-Arch ctxt) dynamic 0)

    (.AddUint64 gotplt ^{:go/via [Target]} (.-Arch ctxt) 0)
    (.AddUint64 gotplt ^{:go/via [Target]} (.-Arch ctxt) 0)))



^{:go/breaks [3] :go/end 463} (go/func machoreloc1 ^bool [(* sys/Arch) (* ld/OutBuf) (* loader/Loader) loader/Sym loader/ExtReloc int64]

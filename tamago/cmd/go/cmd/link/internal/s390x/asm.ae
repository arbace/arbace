^{:go/end 484} (go/func archrelocvariant ^int64 [^{:tag (* ld/Target)} target ^{:tag (* loader/Loader)} ldr ^loader/Reloc r ^sym/RelocVariant rv ^loader/Sym s ^int64 t ^{:tag (slice byte)} p]
  (switch (bit-and rv sym/RV_TYPE_MASK)
    (default
      (.Errorf ldr s "unexpected relocation variant %d" rv)
      (return t))

    (case [sym/RV_NONE]
      (return t))

    (case [sym/RV_390_DBL]
      (when (!= (bit-and t 1) 0)
        (.Errorf ldr s "%s+%v is not 2-byte aligned" (.SymName ldr (.Sym r)) (.SymValue ldr (.Sym r))))

      (return (>> t 1)))))



^{:go/end 550} (go/func addpltsym [^{:tag (* ld/Target)} target ^{:tag (* loader/Loader)} ldr ^{:tag (* ld/ArchSyms)} syms ^loader/Sym s]
  (when (>= (.SymPlt ldr s) 0)
    (return))


  (ld/Adddynsym ldr target syms s)

  (if (.IsElf target)
    (let [plt (.MakeSymbolUpdater ldr (.-PLT syms))
        ^{:line 495} gotplt (.MakeSymbolUpdater ldr (.-GOTPLT syms))
        ^{:line 496} rela (.MakeSymbolUpdater ldr (.-RelaPLT syms))]
      (when (== (.Size plt) 0)
        (panic "plt is not set up"))

      ;; larl    %r1,_GLOBAL_OFFSET_TABLE_+index

      (.AddUint8 plt 0xc0)
      (.AddUint8 plt 0x10)
      (.AddPCRelPlus plt (.-Arch target) (.Sym gotplt) (+ (.Size gotplt) 6))
      (let [pltrelocs (.Relocs plt)]
        (.SetRelocVariant ldr (.Sym plt) (- (.Count pltrelocs) 1) sym/RV_390_DBL)

        ;; add to gotplt: pointer to current pos in plt
        (.AddAddrPlus gotplt (.-Arch target) (.Sym plt) (+ (.Size plt) 8)) ; weird but correct
        ;; lg      %r1,0(%r1)
        (.AddUint8 plt 0xe3)
        (.AddUint8 plt 0x10)
        (.AddUint8 plt 0x10)
        (.AddUint8 plt 0x00)
        (.AddUint8 plt 0x00)
        (.AddUint8 plt 0x04)
        ;; br      %r1
        (.AddUint8 plt 0x07)
        (.AddUint8 plt 0xf1)
        ;; basr    %r1,%r0
        (.AddUint8 plt 0x0d)
        (.AddUint8 plt 0x10)
        ;; lgf     %r1,12(%r1)
        (.AddUint8 plt 0xe3)
        (.AddUint8 plt 0x10)
        (.AddUint8 plt 0x10)
        (.AddUint8 plt 0x0c)
        (.AddUint8 plt 0x00)
        (.AddUint8 plt 0x14)
        ;; jg .plt
        (.AddUint8 plt 0xc0)
        (.AddUint8 plt 0xf4)

        (.AddUint32 plt (.-Arch target) (conv uint32 (- (>> (- (.Size plt) 2) 1)))) ; roll-your-own relocation
        ;;.plt index
        (.AddUint32 plt (.-Arch target) (conv uint32 (.Size rela))) ; rela size before current entry

        ;; rela
        (.AddAddrPlus rela (.-Arch target) (.Sym gotplt) (- (.Size gotplt) 8))

        (let [sDynid (.SymDynid ldr s)]
          (.AddUint64 rela (.-Arch target) (elf/R_INFO (conv uint32 sDynid) (conv uint32 elf/R_390_JMP_SLOT)))
          (.AddUint64 rela (.-Arch target) 0)

          (.SetPlt ldr s (conv int32 (- (.Size plt) 32))))))


    (.Errorf ldr s "addpltsym: unsupported binary format")))


















^{:go/end 600} (go/func tlsIEtoLE "tlsIEtoLE converts TLS Initial Exec (IE) relocation to TLS Local Exec (LE).\n\nOn s390x, the TLS IE sequence is:\n\n\tLARL %rN, <var>@INDNTPOFF   ; 6 bytes - load address of GOT entry\n\tLG   %rN, 0(%rN)            ; 6 bytes - load offset from GOT\n\nWe convert this to TLS LE by replacing it with:\n\n\tLGFI %rN, <offset>          ; 6 bytes - load 32-bit sign-extended immediate\n\tBCR  0,0                    ; 2 bytes - NOP\n\tBCR  0,0                    ; 2 bytes - NOP\n\tBCR  0,0                    ; 2 bytes - NOP\n\nThe relocation offset points to byte 2 of the LARL instruction (the immediate field).\n" [^{:tag (slice byte)} P ^int off ^int size]
  ;; off is the offset of the relocation within the instruction sequence,
  ;; which is at byte 2 of the LARL instruction (the 4-byte immediate).
  ;; We need to work with the beginning of LARL (off-2) through LG (off+10).

  (when (< off 2)
    (log/Fatalf "R_390_TLS_IEENT relocation at offset %d is too small" off))


  ;; Verify we have a LARL instruction (opcode 0xC0, second nibble 0x0)
  ;; LARL format: C0 R0 I2 I2 I2 I2 (where R is register, I2 is 32-bit immediate)
  (when (or (!= (aget P (- off 2)) 0xc0) (!= (bit-and (aget P (- off 1)) 0x0f) 0x00))
    (log/Fatalf "R_390_TLS_IEENT relocation not preceded by LARL instruction: %02x %02x" (aget P (- off 2)) (aget P (- off 1))))


  ;; Extract the register from LARL (upper nibble of second byte)
  (let [reg (>> (aget P (- off 1)) 4)]

    ;; Convert LARL to LGFI: change opcode from C0x0 to C0x1
    ;; LGFI format: C0 R1 I2 I2 I2 I2
    (aset P (- off 1) (bit-or (<< reg 4) 0x01))

    ;; The immediate field (bytes off to off+3) will be filled in by the linker
    ;; with the TLS offset value.

    ;; Replace the LG instruction (6 bytes starting at off+4) with NOPs
    ;; BCR 0,0 = 0x07 0x00 (2 bytes each, need 3 of them)
    (aset P (+ off 4) 0x07)
    (aset P (+ off 5) 0x00)
    (aset P (+ off 6) 0x07)
    (aset P (+ off 7) 0x00)
    (aset P (+ off 8) 0x07)
    (aset P (+ off 9) 0x00)))

^{:go/end 34} (go/func processSEH "processSEH walks host-object pdata relocations and returns the set of\nper-entry pdata symbols created from the input section.\n" [^{:tag (* loader/Loader)} ldr ^{:tag (* sys/Arch)} arch ^sym/LoaderSym pdata] :results [(slice loader/Sym) error]
  (switch (.-Family arch)

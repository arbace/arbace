^{:go/end 689} (go/func PostProcessImports "PostProcessImports works to resolve inconsistencies with DLL import\nsymbols; it is needed when building with more \"modern\" C compilers\nwith internal linkage.\n\nBackground: DLL import symbols are data (SNOPTRDATA) symbols whose\nname is of the form \"__imp_XXX\", which contain a pointer/reference\nto symbol XXX. It's possible to have import symbols for both data\nsymbols (\"__imp__fmode\") and text symbols (\"__imp_CreateEventA\").\nIn some case import symbols are just references to some external\nthing, and in other cases we see actual definitions of import\nsymbols when reading host objects.\n\nPrevious versions of the linker would in most cases immediately\n\"forward\" import symbol references, e.g. treat a references to\n\"__imp_XXX\" a references to \"XXX\", however this doesn't work well\nwith more modern compilers, where you can sometimes see import\nsymbols that are defs (as opposed to external refs).\n\nThe main actions taken below are to search for references to\nSDYNIMPORT symbols in host object text/data sections and flag the\nsymbols for later fixup. When we see a reference to an import\nsymbol __imp_XYZ where XYZ corresponds to some SDYNIMPORT symbol,\nwe flag the symbol (via GOT setting) so that it can be redirected\nto XYZ later in windynrelocsym. When we see a direct reference to\nan SDYNIMPORT symbol XYZ, we also flag the symbol (via PLT setting)\nto indicated that the reference will need to be redirected to a\nstub.\n" ^error []
  ^{:go/breaks [5]} (let [ldr (.-l importSymsState)
      ^{:line 642} arch (.-arch importSymsState)
      ^{:line 643} keeprelocneeded (make (map loader/Sym loader/Sym))]
    (range [_ s (.-secSyms importSymsState)]
      (let [isText (.IsText (.SymType ldr s))
          ^{:line 646} relocs (.Relocs ldr s)]
        (for [i 0] (< i (.Count relocs)) (inc! i)
          (let [r (.At relocs i)
              ^{:line 649} rs (.Sym r)]
            (when (== (.SymType ldr rs) sym/SDYNIMPORT)
              ;; Tag the symbol for later stub generation.
              (.SetPlt ldr rs CreateImportStubPltToken)
              (continue))

            (let [(values isym err) (LookupBaseFromImport rs ldr arch)]
              (when (!= err nil)
                (return err))

              (when (== isym 0)
                (continue))

              (when (!= (.SymType ldr isym) sym/SDYNIMPORT)
                (continue))

              ;; For non-text symbols, forward the reference from __imp_X to
              ;; X immediately.
              (when (not isText)
                (.SetSym r isym)
                (continue))

              ;; Flag this imp symbol to be processed later in windynrelocsym.
              (.SetGot ldr rs RedirectToDynImportGotToken)
              ;; Consistency check: should be no PLT token here.
              (let [splt (.SymPlt ldr rs)]
                (when (!= splt -1)
                  (return (fmt/Errorf "internal error: import symbol %q has invalid PLT setting %d" (.SymName ldr rs) splt)))

                ;; Flag for dummy relocation.
                (aset keeprelocneeded rs isym)))))))


    (range [k v keeprelocneeded]
      (let [sb (.MakeSymbolUpdater ldr k)
          (values r _) (.AddRel sb objabi/R_KEEP)]
        (.SetSym r v)))

    (set! importSymsState nil)
    nil))


^{:go/end 693} (go/func issehsect ^bool [^{:tag (* sys/Arch)} arch ^{:tag (* pe/Section)} s]
  (and (== (.-Family arch) sys/AMD64) ^:go/paren (or (== ^{:go/via [SectionHeader]} (.-Name s) ".pdata") (== ^{:go/via [SectionHeader]} (.-Name s) ".xdata"))))


^{:go/end 697} (go/func issect ^bool [^{:tag (* pe/COFFSymbol)} s]
  (and (== (.-StorageClass s) IMAGE_SYM_CLASS_STATIC) (== (.-Type s) 0) (== (aget (.-Name s) 0) \.)))


^{:go/end 755} (go/method readpesym [^{:tag (* peLoaderState)} state ^{:tag (* pe/COFFSymbol)} pesym] :results [(* loader/SymbolBuilder) loader/Sym error]
  (let [(values symname err) (.FullName pesym (.-StringTable (.-f state)))]
    (when (!= err nil)
      (return nil 0 err))

    (let [^string name (zero string)]
      (if (issect pesym)
        (set! name (.SymName (.-l state) (aget (.-sectsyms state) (aget (.-Sections (.-f state)) (- (.-SectionNumber pesym) 1)))))
        (do
          (set! name symname)
          ;; A note on the "_main" exclusion below: the main routine
          ;; defined by the Go runtime is named "_main", not "main", so
          ;; when reading references to _main from a host object we want
          ;; to avoid rewriting "_main" to "main" in this specific
          ;; instance. See #issuecomment-1143698749 on #35006 for more
          ;; details on this problem.
          (when (and (== (.-Family (.-arch state)) sys/I386) (== (aget name 0) \_) (!= name "_main") (not (strings/HasPrefix name "__imp_")))
            (set! name (subslice name 1))))) ; _Name => Name



      ;; remove last @XXX
      (when [i (strings/LastIndex name "@")] (>= i 0)
        (set! name (subslice name _ i)))


      (let [^loader/Sym s (zero loader/Sym)
          ^{:line 726 :tag (* loader/SymbolBuilder)} bld (zero (* loader/SymbolBuilder))]
        ;; Microsoft's PE documentation is contradictory. It says that the symbol's complex type
        ;; is stored in the pesym.Type most significant byte, but MSVC, LLVM, and mingw store it
        ;; in the 4 high bits of the less significant byte.
        (switch (>> (conv uint8 (bit-and (.-Type pesym) 0xf0)) 4)
          (default
            (return nil 0 (fmt/Errorf "%s: invalid symbol type %d" symname (.-Type pesym))))

          (case [IMAGE_SYM_DTYPE_FUNCTION IMAGE_SYM_DTYPE_NULL]
            (switch (.-StorageClass pesym)
              (case [IMAGE_SYM_CLASS_EXTERNAL] ;global
                (set! s (.LookupOrCreateCgoExport (.-l state) name 0)))

              (case [IMAGE_SYM_CLASS_NULL IMAGE_SYM_CLASS_STATIC IMAGE_SYM_CLASS_LABEL]
                (set! s (.LookupOrCreateCgoExport (.-l state) name (.-localSymVersion state)))
                (set! bld (makeUpdater (.-l state) bld s))
                (.SetDuplicateOK bld true))

              (default
                (return nil 0 (fmt/Errorf "%s: invalid symbol binding %d" symname (.-StorageClass pesym)))))))



        (when (and (!= s 0) (== (.SymType (.-l state) s) 0) ^:go/paren (or (!= (.-StorageClass pesym) IMAGE_SYM_CLASS_STATIC) (!= (.-Value pesym) 0)))
          (set! bld (makeUpdater (.-l state) bld s))
          (.SetType bld sym/SXREF))


        (return bld s nil)))))









^{:go/breaks [[7 809]] :go/end 810} (go/method preprocessSymbols "preprocessSymbols walks the COFF symbols for the PE file we're\nreading and looks for cases where we have both a symbol definition\nfor \"XXX\" and an \"__imp_XXX\" symbol, recording these cases in a map\nin the state struct. This information will be used in readpesym()\nabove to give such symbols special treatment. This function also\ngathers information about COMDAT sections/symbols for later use\nin readpesym().\n" ^error [^{:tag (* peLoaderState)} state]

  ;; Locate comdat sections.
  (set! (.-comdats state) (make (map uint16 int64)))
  (range [i s (.-Sections (.-f state))]
    (when (!= (bit-and ^{:go/via [SectionHeader]} (.-Characteristics s) (conv uint32 pe/IMAGE_SCN_LNK_COMDAT)) 0)
      (aset (.-comdats state) (conv uint16 i) (conv int64 ^{:go/via [SectionHeader]} (.-Size s)))))



  ;; Examine symbol defs.
  (for [(values i numaux) (values 0 0)] (< i (len (.-COFFSymbols (.-f state)))) (set! i + (+ numaux 1))
    (let [pesym (addr (aget (.-COFFSymbols (.-f state)) i))]
      (set! numaux (conv int (.-NumberOfAuxSymbols pesym)))
      (when (== (.-SectionNumber pesym) 0) ; extern
        (continue))

      (let [(values symname err) (.FullName pesym (.-StringTable (.-f state)))]
        (when (!= err nil)
          (return err))

        (when [(values _ isc) (aget (.-comdats state) (conv uint16 (- (.-SectionNumber pesym) 1)))] (not isc)
          (continue))

        (when (!= (.-StorageClass pesym) (conv uint8 IMAGE_SYM_CLASS_STATIC))
          (continue))

        ;; This symbol corresponds to a COMDAT section. Read the
        ;; aux data for it.
        (let [(values auxsymp ^:assign err) (.COFFSymbolReadSectionDefAux (.-f state) i)]
          (when (!= err nil)
            (return (fmt/Errorf "unable to read aux info for section def symbol %d %s: pe.COFFSymbolReadComdatInfo returns %v" i symname err)))

          (cond (== (.-Selection auxsymp) pe/IMAGE_COMDAT_SELECT_SAME_SIZE) (do)
            ;; This is supported.
            (== (.-Selection auxsymp) pe/IMAGE_COMDAT_SELECT_ANY)
            ;; Also supported.
            (aset (.-comdats state) (conv uint16 (- (.-SectionNumber pesym) 1)) (conv int64 -1)) :else

            ;; We don't support any of the other strategies at the
            ;; moment. I suspect that we may need to also support
            ;; "associative", we'll see.
            (return (fmt/Errorf "internal error: unsupported COMDAT selection strategy found in path=%s sec=%d strategy=%d idx=%d, please file a bug" (.-pn state) (.-SecNum auxsymp) (.-Selection auxsymp) i)))))))


  nil)







^{:go/end 831} (go/func LookupBaseFromImport "LookupBaseFromImport examines the symbol \"s\" to see if it\ncorresponds to an import symbol (name of the form \"__imp_XYZ\") and\nif so, it looks up the underlying target of the import symbol and\nreturns it. An error is returned if the symbol is of the form\n\"__imp_XYZ\" but no XYZ can be found.\n" [^loader/Sym s ^{:tag (* loader/Loader)} ldr ^{:tag (* sys/Arch)} arch] :results [loader/Sym error]
  (let [sname (.SymName ldr s)]
    (when (not (strings/HasPrefix sname "__imp_"))
      (return 0 nil))

    (let [basename (subslice sname (len "__imp_"))]
      (when (and (== (.-Family arch) sys/I386) (== (aget basename 0) \_))
        (set! basename (subslice basename 1))) ; _Name => Name

      (let [isym (.Lookup ldr basename 0)]
        (when (== isym 0)
          (return 0 (fmt/Errorf "internal error: import symbol %q with no underlying sym" sname)))

        (return isym nil)))))

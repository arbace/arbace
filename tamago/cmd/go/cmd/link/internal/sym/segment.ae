(in-ns 'go.cmd.link.internal.sym) (go/file "segment.go" :imports [])

;; Terrible but standard terminology.
;; A segment describes a block of file to load into memory.
;; A section further describes the pieces of that block for
;; use in debuggers and such.

(go/type Segment (struct
    ^{:line 39 :tag uint8} Rwx ; permission as usual unix bits (5 = r-x etc)
    ^{:line 40 :tag uint64} Vaddr ; virtual address
    ^{:line 41 :tag uint64} Length ; length in memory
    ^{:line 42 :tag uint64} Fileoff ; file offset
    ^{:line 43 :tag uint64} Filelen ; length on disk
    ^{:line 44 :tag (slice (* Section))} Sections))


(go/type Section (struct
    ^{:line 48 :tag uint8} Rwx
    ^{:line 49 :tag int16} Extnum
    ^{:line 50 :tag int32} Align
    ^{:line 51 :tag string} Name
    ^{:line 52 :tag uint64} Vaddr
    ^{:line 53 :tag uint64} Length
    ^{:line 54 :tag (* Segment)} Seg
    ^{:line 55 :tag any} Elfsect ; an *ld.ElfShdr
    ^{:line 56 :tag uint64} Reloff
    ^{:line 57 :tag uint64} Rellen





    ^{:line 63 :tag uint32 :doc "Relcount is the number of *host* relocations applied to this section\n(when external linking).\nIncremented atomically on multiple goroutines.\nNote: this may differ from number of Go relocations, as one Go relocation\nmay turn into multiple host relocations.\n"} Relcount
    ^{:line 64 :tag LoaderSym} Sym ; symbol for the section, if any
    ^{:line 65 :tag uint16} Index ; each section has a unique index, used internally

    ^{:line 67 :tag bool} Compressed))

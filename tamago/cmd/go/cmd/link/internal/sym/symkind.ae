  ^{:line 78} [^{:val 18 :doc "Read-only, non-executable, dynamically relocatable segment.\n\nThis segment holds read-only data that contains pointers to\nother parts of the program. When generating a position\nindependent executable or a shared library, these sections\nare \"relro\", meaning that they start as writable, and are\nchanged to be read-only after dynamic relocations are applied.\n\nWhen no dynamic relocations are required, as when generating\nan executable that is not position independent, this is just\npart of the normal read-only segment.\n"} SRODATARELRO]
  ^{:line 79} [^{:val 19} STYPE]
  ^{:line 80} [^{:val 20} SGOFUNC]
  ^{:line 81} [^{:val 21} SELFRELROSECT] ; ELF-specific read-only relocatable: PLT, etc.
  ^{:line 82} [^{:val 22} SMACHORELROSECT] ; Mach-O specific read-only relocatable.


  ^{:line 85} [^{:val 23 :doc "Allocated writable segment.\n"} SFirstWritable]
  ^{:line 86} [^{:val 24} SBUILDINFO] ; debug/buildinfo data (why is this writable?).
  ^{:line 87} [^{:val 25} SFIPSINFO] ; go:fipsinfo aka crypto/internal/fips140/check.Linkinfo (why is this writable)?
  ^{:line 88} [^{:val 26} SELFSECT] ; .got.plt, .plt, .dynamic where appropriate.

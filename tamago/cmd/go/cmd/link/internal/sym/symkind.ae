^{:go/end 193} (go/method IsText "IsText returns true if t is a text type.\n" ^bool [^SymKind t]
  (and (<= STEXT t) (<= t STEXTEND)))



^{:go/end 198} (go/method IsData "IsData returns true if t is any kind of data type.\n" ^bool [^SymKind t]
  (and (<= SNOPTRDATA t) (<= t SNOPTRBSS)))



^{:go/end 203} (go/method IsDATA "IsDATA returns true if t is one of the SDATA types.\n" ^bool [^SymKind t]
  (and (<= SDATA t) (<= t SDATAEND)))



^{:go/end 208} (go/method IsRODATA "IsRODATA returns true if t is one of the SRODATA types.\n" ^bool [^SymKind t]
  (and (<= SRODATA t) (<= t SRODATAEND)))



^{:go/end 213} (go/method IsNOPTRDATA "IsNOPTRDATA returns true if t is one of the SNOPTRDATA types.\n" ^bool [^SymKind t]
  (and (<= SNOPTRDATA t) (<= t SNOPTRDATAEND)))


^{:go/end 217} (go/method IsDWARF ^bool [^SymKind t]
  (and (<= SDWARFSECT t) (<= t SDWARFADDR)))

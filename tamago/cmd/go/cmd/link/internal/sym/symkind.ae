(go/var ^{:doc "ReadOnly are the symbol kinds that form read-only sections\nthat never require runtime relocations.\n"} ReadOnly (lit (slice SymKind)
    ^{:line 180} SSTRING
    ^{:line 181} SGOSTRING
    ^{:line 182} SGCBITS
    ^{:line 183} SRODATA
    ^{:line 184} SRODATAFIPSSTART

(in-ns 'go.cmd.link.internal.sym) (go/file "symbol.go" :imports [


    ^{:line 8} [obj "cmd/internal/obj"]
    ^{:line 9} [buildcfg "internal/buildcfg"]])


(go/const
  ^{:line 13} [^{:val 0} SymVerABI0 0]
  ^{:line 14} [^{:val 1} SymVerABIInternal 1]
  ^{:line 15} [^{:val 2} SymVerABICount 2] ; Number of internal ABIs
  ^{:line 16} [^{:val 10} SymVerStatic 10]) ; Minimum version used by static (file-local) syms


^{:go/breaks [[4 31]] :go/end 32} (go/func ABIToVersion ^int [^obj/ABI abi]
  (switch abi
    (case [obj/ABI0]
      (return SymVerABI0))
    (case [obj/ABIInternal]
      (when (not ^{:go/via [Flags]} (.-RegabiWrappers buildcfg/Experiment))
        ;; If wrappers are not enabled, ABI0 and ABIInternal are actually same
        ;; so we normalize everything to ABI0.
        (return SymVerABI0))

      (return SymVerABIInternal)))

  -1)


^{:go/end 42} (go/func VersionToABI [^int v] :results [obj/ABI bool]
  (switch v
    (case [SymVerABI0]
      (return obj/ABI0 true))
    (case [SymVerABIInternal]
      (return obj/ABIInternal true)))

  (return (bit-not (conv obj/ABI 0)) false))

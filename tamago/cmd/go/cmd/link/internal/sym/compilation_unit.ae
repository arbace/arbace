(in-ns 'go.cmd.link.internal.sym) (go/file "compilation_unit.go" :imports [

    ^{:line 7} [dwarf "cmd/internal/dwarf"]])



(go/type LoaderSym "LoaderSym holds a loader.Sym value. We can't refer to this\ntype from the sym package since loader imports sym.\n" uint32)










(go/type CompilationUnit "A CompilationUnit represents a set of source files that are compiled\ntogether. Since all Go sources in a Go package are compiled together,\nthere's one CompilationUnit per package that represents all Go sources in\nthat package, plus one for each assembly file.\n\nEquivalently, there's one CompilationUnit per object file in each Library\nloaded by the linker.\n\nThese are used for both DWARF and pclntab generation.\n" (struct
    ^{:line 23 :tag (* Library)} Lib ; Our library
    ^{:line 24 :tag int} PclnIndex ; Index of this CU in pclntab
    ^{:line 25 :tag (slice dwarf/Range)} PCs ; PC ranges, relative to Textp[0]
    ^{:line 26 :tag (* dwarf/DWDie)} DWInfo ; CU root DIE
    ^{:line 27 :tag (slice string)} FileTable ; The file table used in this compilation unit.

    ^{:line 29 :tag LoaderSym} Consts ; Package constants DIEs
    ^{:line 30 :tag (slice LoaderSym)} FuncDIEs ; Function DIE subtrees
    ^{:line 31 :tag (slice LoaderSym)} VarDIEs ; Global variable DIEs
    ^{:line 32 :tag (slice LoaderSym)} AbsFnDIEs ; Abstract function DIE subtrees
    ^{:line 33 :tag (slice LoaderSym)} RangeSyms ; Symbols for debug_range
    ^{:line 34 :tag (slice LoaderSym)} Textp ; Text symbols in this CU
    ^{:line 35 :tag (map LoaderSym uint32)} Addrs)) ; slot in .debug_addr for fn sym (DWARF5)

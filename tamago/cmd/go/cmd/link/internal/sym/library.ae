(in-ns 'go.cmd.link.internal.sym) (go/file "library.go" :imports [

    ^{:line 7} [goobj "cmd/internal/goobj"]])

(go/type Library (struct
    ^{:line 10 :tag string} Objref
    ^{:line 11 :tag string} Srcref
    ^{:line 12 :tag string} File
    ^{:line 13 :tag string} Pkg
    ^{:line 14 :tag string} Shlib
    ^{:line 15 :tag goobj/FingerprintType} Fingerprint
    ^{:line 16 :tag (slice goobj/ImportedPkg)} Autolib
    ^{:line 17 :tag (slice (* Library))} Imports
    ^{:line 18 :tag bool} Main
    ^{:line 19 :tag (slice (* CompilationUnit))} Units

    ^{:line 21 :tag (slice LoaderSym)} Textp ; text syms defined in this library
    ^{:line 22 :tag (slice LoaderSym)} DupTextSyms)) ; dupok text syms defined in this library


^{:go/end 27} (go/method String ^string [^Library l]

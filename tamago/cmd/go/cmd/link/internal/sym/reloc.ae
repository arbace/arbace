(in-ns 'go.cmd.link.internal.sym) (go/file "reloc.go" :imports [


    ^{:line 8} [objabi "cmd/internal/objabi"]
    ^{:line 9} [sys "cmd/internal/sys"]
    ^{:line 10} [elf "debug/elf"]
    ^{:line 11} [macho "debug/macho"]])



(go/type RelocVariant "RelocVariant is a linker-internal variation on a relocation.\n" uint8)

(go/const
  ^{:line 18} [^{:tag RelocVariant :val 0} RV_NONE iota]
  ^{:line 19} [^{:val 1} RV_POWER_LO]
  ^{:line 20} [^{:val 2} RV_POWER_HI]
  ^{:line 21} [^{:val 3} RV_POWER_HA]
  ^{:line 22} [^{:val 4} RV_POWER_DS]




  ^{:line 27} [^{:val 5 :doc "RV_390_DBL is a s390x-specific relocation variant that indicates that\nthe value to be placed into the relocatable field should first be\ndivided by 2.\n"} RV_390_DBL]

  ^{:line 29} [^{:tag RelocVariant :val 128} RV_CHECK_OVERFLOW (<< 1 7)]
  ^{:line 30} [^{:tag RelocVariant :val 127} RV_TYPE_MASK (- RV_CHECK_OVERFLOW 1)])


^{:go/end 72} (go/func RelocName ^string [^{:tag (* sys/Arch)} arch ^objabi/RelocType r]
  (switch
    (case [(>= r objabi/MachoRelocOffset)] ; Mach-O
      (let [nr (>> (- r objabi/MachoRelocOffset) 1)]
        (switch (.-Family arch)
          (case [sys/AMD64]
            (return (.String (conv macho/RelocTypeX86_64 nr))))
          (case [sys/ARM64]
            (return (.String (conv macho/RelocTypeARM64 nr))))
          (default
            (panic "unreachable")))))

    (case [(>= r objabi/ElfRelocOffset)] ; ELF
      (let [nr (- r objabi/ElfRelocOffset)]
        (switch (.-Family arch)
          (case [sys/AMD64]
            (return (.String (conv elf/R_X86_64 nr))))
          (case [sys/ARM]
            (return (.String (conv elf/R_ARM nr))))
          (case [sys/ARM64]
            (return (.String (conv elf/R_AARCH64 nr))))
          (case [sys/I386]
            (return (.String (conv elf/R_386 nr))))
          (case [sys/Loong64]
            (return (.String (conv elf/R_LARCH nr))))
          (case [sys/MIPS sys/MIPS64]
            (return (.String (conv elf/R_MIPS nr))))
          (case [sys/PPC64]
            (return (.String (conv elf/R_PPC64 nr))))
          (case [sys/S390X]
            (return (.String (conv elf/R_390 nr))))
          (case [sys/RISCV64]
            (return (.String (conv elf/R_RISCV nr))))
          (default
            (panic "unreachable"))))))



  (.String r))

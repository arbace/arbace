^{:go/end 389} (go/func elfsetupplt [^{:tag (* ld/Link)} ctxt ^{:tag (* loader/Loader)} ldr ^{:tag (* loader/SymbolBuilder)} plt ^{:tag (* loader/SymbolBuilder)} gotplt ^loader/Sym dynamic]
  (when (!= (.Size plt) 0)
    (return))

  (when (!= (.Size gotplt) 0)
    (.Errorf ctxt (.Sym gotplt) "got.plt is not empty"))


  ;; See section 8.4.6 of the RISC-V ABIs Specification:
  ;;
  ;;  https://github.com/riscv-non-isa/riscv-elf-psabi-doc/releases/download/v1.0/riscv-abi.pdf
  ;;
  ;; 1:   auipc  t2, %pcrel_hi(.got.plt)
  ;;      sub    t1, t1, t3               # shifted .got.plt offset + hdr size + 12
  ;;      l[w|d] t3, %pcrel_lo(1b)(t2)    # _dl_runtime_resolve
  ;;      addi   t1, t1, -(hdr size + 12) # shifted .got.plt offset
  ;;      addi   t0, t2, %pcrel_lo(1b)    # &.got.plt
  ;;      srli   t1, t1, log2(16/PTRSIZE) # .got.plt offset
  ;;      l[w|d] t0, PTRSIZE(t0)          # link map
  ;;      jr     t3


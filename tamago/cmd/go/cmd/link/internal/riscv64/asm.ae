        (for [ri 0] (< ri (.Count relocs)) (inc! ri)
          (let [r (.At relocs ri)]
            (when (and (!= (.Type r) objabi/R_RISCV_CALL)
                (!= (.Type r) objabi/R_RISCV_PCREL_ITYPE)
                (!= (.Type r) objabi/R_RISCV_PCREL_STYPE)
                (!= (.Type r) objabi/R_RISCV_TLS_IE)
                (!= (.Type r) objabi/R_RISCV_GOT_PCREL_ITYPE))

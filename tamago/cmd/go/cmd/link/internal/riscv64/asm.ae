^{:go/end 249} (go/func genSymsLate [^{:tag (* ld/Link)} ctxt ^{:tag (* loader/Loader)} ldr]
  (when (!= ^{:go/via [Target]} (.-LinkMode ctxt) ld/LinkExternal)

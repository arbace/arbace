    (.AddSymRef plt ^{:go/via [Target]} (.-Arch ctxt) (.Sym sb) 0 objabi/R_RISCV_PCREL_LO12_I 4)
    (.SetUint32 plt ^{:go/via [Target]} (.-Arch ctxt) (- (.Size plt) 4) 0x0003be03) ; ld      t3,0(t2)

    (.AddUint32 plt ^{:go/via [Target]} (.-Arch ctxt) 0xfd430313) ; addi    t1,t1,-44

    (.AddSymRef plt ^{:go/via [Target]} (.-Arch ctxt) (.Sym sb) 0 objabi/R_RISCV_PCREL_LO12_I 4)
    (.SetUint32 plt ^{:go/via [Target]} (.-Arch ctxt) (- (.Size plt) 4) 0x00038293) ; addi    t0,t2,0

    (.AddUint32 plt ^{:go/via [Target]} (.-Arch ctxt) 0x00135313) ; srli    t1,t1,0x1
    (.AddUint32 plt ^{:go/via [Target]} (.-Arch ctxt) 0x0082b283) ; ld      t0,8(t0)
    (.AddUint32 plt ^{:go/via [Target]} (.-Arch ctxt) 0x00008e02) ; jr      t3


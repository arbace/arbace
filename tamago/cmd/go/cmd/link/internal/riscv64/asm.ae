      (.SetUint32 initfunc ^{:go/via [Target]} (.-Arch ctxt) (- sz 4) 0x00050513) ; addi  a0, %pcrel_lo(local.moduledata)

      (set! sz (.AddSymRef initfunc ^{:go/via [Target]} (.-Arch ctxt) addmoduledata 0 objabi/R_RISCV_JAL 4))
      (.SetUint32 initfunc ^{:go/via [Target]} (.-Arch ctxt) (- sz 4) 0x0000006f)))) ; j runtime.addmoduledata



      (.SetType sb sym/STEXT)
      (.SetValue sb (- (+ (.SymValue ldr (.Sym plt)) (.Size plt)) 4))
      (.SetLocal sb true)
      (.SetReachable sb true)
      (.SetVisibilityHidden sb true)
      (.AddInteriorSym plt (.Sym sb))

      (.AddSymRef plt (.-Arch target) (.Sym sb) 0 objabi/R_RISCV_PCREL_LO12_I 4)
      (.SetUint32 plt (.-Arch target) (- (.Size plt) 4) 0x000e3e03) ; ld      t3,0(t3)
      (.AddUint32 plt (.-Arch target) 0x000e0367) ; jalr    t1,t3
      (.AddUint32 plt (.-Arch target) 0x00000001) ; nop

      (.SetPlt ldr s (conv int32 (- (.Size plt) 16)))

      ;; add to got.plt: pointer to plt[0]
      (.AddAddrPlus gotplt (.-Arch target) (.Sym plt) 0)

      ;; rela
      (.AddAddrPlus rela (.-Arch target) (.Sym gotplt) (- (.Size gotplt) 8))

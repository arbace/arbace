    (.AddUint64 gotplt ^{:go/via [Target]} (.-Arch ctxt) 0))) ; got.plt[1] = link map


^{:go/end 441} (go/func addpltsym [^{:tag (* ld/Target)} target ^{:tag (* loader/Loader)} ldr ^{:tag (* ld/ArchSyms)} syms ^loader/Sym s]
  (when (>= (.SymPlt ldr s) 0)
    (return))


  (ld/Adddynsym ldr target syms s)

  (let [plt (.MakeSymbolUpdater ldr (.-PLT syms))
      ^{:line 399} gotplt (.MakeSymbolUpdater ldr (.-GOTPLT syms))
      ^{:line 400} rela (.MakeSymbolUpdater ldr (.-RelaPLT syms))]
    (when (== (.Size plt) 0)
      (panic "plt is not set up"))


    ;; See section 8.4.6 of the RISC-V ABIs Specification:
    ;;
    ;;  https://github.com/riscv-non-isa/riscv-elf-psabi-doc/releases/download/v1.0/riscv-abi.pdf
    ;;
    ;; 1:  auipc   t3, %pcrel_hi(function@.got.plt)
    ;;     l[w|d]  t3, %pcrel_lo(1b)(t3)
    ;;     jalr    t1, t3
    ;;     nop


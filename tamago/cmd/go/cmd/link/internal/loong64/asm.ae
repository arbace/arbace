    (let [o ^{:go/end 26} (fn [^uint32 op]
          (.AddUint32 initfunc ^{:go/via [Target]} (.-Arch ctxt) op))]


      ;; Emit the following function:
      ;;
      ;;	local.dso_init:
      ;;		la.pcrel $a0, local.moduledata
      ;;		b runtime.addmoduledata

      ;;	0000000000000000 <local.dso_init>:
      ;;	0:	1a000004	pcalau12i	$a0, 0
      ;;				0: R_LARCH_PCALA_HI20	local.moduledata
      (o 0x1a000004)
      (let [(values rel _) (.AddRel initfunc objabi/R_LOONG64_ADDR_HI)]
        ^{:go/via [Reloc]} (.SetOff rel 0)
        ^{:go/via [Reloc]} (.SetSiz rel 4)
        (.SetSym rel (.-Moduledata ctxt))

        ;;	4:	02c00084	addi.d	$a0, $a0, 0
        ;;				4: R_LARCH_PCALA_LO12	local.moduledata
        (o 0x02c00084)

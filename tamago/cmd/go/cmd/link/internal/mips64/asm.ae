^{:go/end 329} (go/func extreloc [^{:tag (* ld/Target)} target ^{:tag (* loader/Loader)} ldr ^loader/Reloc r ^loader/Sym s] :results [loader/ExtReloc bool]
  (switch (.Type r)
    (case [objabi/R_ADDRMIPS
        ^{:line 320} objabi/R_ADDRMIPSU]
      (return (ld/ExtrelocViaOuterSym ldr r s) true))

    (case [objabi/R_ADDRMIPSTLS
        ^{:line 324} objabi/R_CALLMIPS
        ^{:line 325} objabi/R_JMPMIPS]
      (return (ld/ExtrelocSimple ldr r) true)))

  (return (lit loader/ExtReloc) false))

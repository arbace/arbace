^{:go/end 405} (go/func elfsetupplt [^{:tag (* ld/Link)} ctxt ^{:tag (* loader/Loader)} ldr ^{:tag (* loader/SymbolBuilder)} plt ^{:tag (* loader/SymbolBuilder)} got ^loader/Sym dynamic]
  (when (== (.Size plt) 0)
    ;; pushl got+4
    (.AddUint8 plt 0xff)

    (.AddUint8 plt 0x35)
    (.AddAddrPlus plt ^{:go/via [Target]} (.-Arch ctxt) (.Sym got) 4)

    ;; jmp *got+8
    (.AddUint8 plt 0xff)

    (.AddUint8 plt 0x25)
    (.AddAddrPlus plt ^{:go/via [Target]} (.-Arch ctxt) (.Sym got) 8)

    ;; zero pad
    (.AddUint32 plt ^{:go/via [Target]} (.-Arch ctxt) 0)

    ;; assume got->size == 0 too
    (.AddAddrPlus got ^{:go/via [Target]} (.-Arch ctxt) dynamic 0)

    (.AddUint32 got ^{:go/via [Target]} (.-Arch ctxt) 0)
    (.AddUint32 got ^{:go/via [Target]} (.-Arch ctxt) 0)))



^{:go/end 451} (go/func addpltsym [^{:tag (* ld/Target)} target ^{:tag (* loader/Loader)} ldr ^{:tag (* ld/ArchSyms)} syms ^loader/Sym s]
  (when (>= (.SymPlt ldr s) 0)
    (return))


  (ld/Adddynsym ldr target syms s)

  (if (.IsElf target)
    (let [plt (.MakeSymbolUpdater ldr (.-PLT syms))
        ^{:line 416} got (.MakeSymbolUpdater ldr (.-GOTPLT syms))
        ^{:line 417} rel (.MakeSymbolUpdater ldr (.-RelPLT syms))]
      (when (== (.Size plt) 0)
        (panic "plt is not set up"))


      ;; jmpq *got+size
      (.AddUint8 plt 0xff)

      (.AddUint8 plt 0x25)
      (.AddAddrPlus plt (.-Arch target) (.Sym got) (.Size got))

      ;; add to got: pointer to current pos in plt
      (.AddAddrPlus got (.-Arch target) (.Sym plt) (.Size plt))

      ;; pushl $x
      (.AddUint8 plt 0x68)

      (.AddUint32 plt (.-Arch target) (conv uint32 (.Size rel)))

      ;; jmp .plt
      (.AddUint8 plt 0xe9)

      (.AddUint32 plt (.-Arch target) (conv uint32 (- (+ (.Size plt) 4))))

      ;; rel
      (.AddAddrPlus rel (.-Arch target) (.Sym got) (- (.Size got) 4))

      (let [sDynid (.SymDynid ldr s)]
        (.AddUint32 rel (.-Arch target) (elf/R_INFO32 (conv uint32 sDynid) (conv uint32 elf/R_386_JMP_SLOT)))

        (.SetPlt ldr s (conv int32 (- (.Size plt) 16)))))

    (.Errorf ldr s "addpltsym: unsupported binary format")))

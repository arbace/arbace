;; This package is a lightly modified version of the mmap code
;; in github.com/google/codesearch/index.

;; The mmap package provides an abstraction for memory mapping files
;; on different platforms.
(in-ns 'go.cmd.vendor.golang_org.x.telemetry.internal.mmap) (go/file "mmap.go" :doc "The mmap package provides an abstraction for memory mapping files\non different platforms.\n" :imports [


    ^{:line 13} [os "os"]])




(go/type Data "The backing file is never closed, so Data\nremains valid for the lifetime of the process.\n" (struct


    ^{:line 21 :tag (* os/File) :doc "TODO(pjw): might be better to define versions of Data\nfor the 3 specializations\n"} f
    ^{:line 22 :tag (slice byte)} Data

    ^{:line 24 :tag (interface) :doc "Some windows magic\n"} Windows))




^{:go/end 31} (go/func Mmap "Mmap maps the given file into memory.\nWhen remapping a file, pass the most recently returned Data.\n" [^{:tag (* os/File)} f] :results [(* Data) error]
  (mmapFile f))



^{:go/end 36} (go/func Munmap "Munmap unmaps the given file from memory.\n" ^error [^{:tag (* Data)} d]
  (munmapFile d))

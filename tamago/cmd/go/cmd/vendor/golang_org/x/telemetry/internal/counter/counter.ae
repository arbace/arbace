^{:go/end 325} (go/func Read "Read reads the given counter.\nThis is the implementation of x/telemetry/counter/countertest.ReadCounter.\n" [^{:tag (* Counter)} c] :results [uint64 error]
  (when (== (.Load (.-current (.-file c))) nil)
    (return (.extra (.load (.-state c))) nil))

  (let [(values pf err) (readFile (.-file c))]
    (when (!= err nil)
      (return 0 err))

    (let [(values v ok) (aget (.-Count pf) (DecodeStack (.Name c)))]
      (when (not ok)
        (return v (fmt/Errorf "not found:%q" (DecodeStack (.Name c)))))

      (return v nil))))


^{:go/end 353} (go/func readFile [^{:tag (* file)} f] :results [(* File) error]
  (when (== f nil)
    (debugPrintf "No file")
    (return nil (fmt/Errorf "counter is not initialized - was Open called?")))


  ;; Note: don't call f.rotate here as this will enqueue a follow-up rotation.
  (.rotate1 f)

  (when (!= (.-err f) nil)
    (return nil (fmt/Errorf "failed to rotate mapped file - %v" (.-err f))))

  (let [current (.Load (.-current f))]
    (when (== current nil)
      (return nil (fmt/Errorf "counter has no mapped file")))

    (let [name (.Name (.-f current))
        (values data err) (ReadMapped name)]
      (when (!= err nil)
        (return nil (fmt/Errorf "failed to read from file: %v" err)))

      (let [(values pf ^:assign err) (Parse name data)]
        (when (!= err nil)
          (return nil (fmt/Errorf "failed to parse: %v" err)))

        (return pf nil)))))




^{:go/end 378} (go/func ReadFile "ReadFile reads the counters and stack counters from the given file.\nThis is the implementation of x/telemetry/counter/countertest.ReadFile.\n" [^string name] :results [^{:tag (map string uint64)} counters ^{:tag (map string uint64)} stackCounters ^error _]
  ;; TODO: Document the format of the stackCounters names.

  (let [(values data err) (ReadMapped name)]
    (when (!= err nil)
      (return nil nil (fmt/Errorf "failed to read from file: %v" err)))

    (let [(values pf ^:assign err) (Parse name data)]
      (when (!= err nil)
        (return nil nil (fmt/Errorf "failed to parse: %v" err)))

      (set! counters (make (map string uint64)))
      (set! stackCounters (make (map string uint64)))
      (range [k v (.-Count pf)]
        (if (IsStackCounter k)
          (aset stackCounters (DecodeStack k) v)

          (aset counters k v)))


      (return counters stackCounters nil))))





^{:go/end 401} (go/func ReadMapped "ReadMapped reads the contents of the given file by memory mapping.\n\nThis avoids file synchronization issues.\n" [^string name] :results [(slice byte) error]
  (let [(values f err) (os/OpenFile name os/O_RDWR 0666)]
    (when (!= err nil)
      (return nil err))

    (defer (.Close f))
    (let [(values fi ^:assign err) (.Stat f)]
      (when (!= err nil)
        (return nil err))

      (let [(values mapping ^:assign err) (memmap f)]
        (when (!= err nil)
          (return nil err))

        (let [data (make (slice byte) (.Size fi))]
          (copy data (.-Data mapping))
          (munmap mapping)
          (return data nil))))))

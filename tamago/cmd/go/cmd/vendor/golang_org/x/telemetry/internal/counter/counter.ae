^{:go/end 198} (go/method Add "Add adds n to the counter. n cannot be negative, as counts cannot decrease.\n" [^{:tag (* Counter)} c ^int64 n]
  (debugPrintf "Add %q += %d" (.-name c) n)

  (when (< n 0)
    (panic "Counter.Add negative"))

  (when (== n 0)
    (return))

  (.register (.-file c) c)

  (let [state (.load (.-state c))]
    (for [] _ (set! state (.load (.-state c)))
      (switch
        (case [(and (not (.locked state)) (.havePtr state))]
          (when (not (.update (.-state c) (addr state) (.incReader state)))
            (continue))

          ;; Counter unlocked or counter shared; has an initialized count pointer; acquired shared lock.
          (if (== (.-count (.-ptr c)) nil) (do
              (while (not (.update (.-state c) (addr state) (.addExtra state (conv uint64 n))))
                ;; keep trying - we already took the reader lock
                (set! state (.load (.-state c))))

              (debugPrintf "Add %q += %d: nil extra=%d\n" (.-name c) n (.extra state)))

            (let [sum (.add c (conv uint64 n))]
              (debugPrintf "Add %q += %d: count=%d\n" (.-name c) n sum)))

          (.releaseReader c state)
          (return))

        (case [(.locked state)]
          (when (not (.update (.-state c) (addr state) (.addExtra state (conv uint64 n))))
            (continue))

          (debugPrintf "Add %q += %d: locked extra=%d\n" (.-name c) n (.extra state))
          (return))

        (case [(not (.havePtr state))]
          (when (not (.update (.-state c) (addr state) (.setLocked (.addExtra state (conv uint64 n)))))
            (continue))

          (debugPrintf "Add %q += %d: noptr extra=%d\n" (.-name c) n (.extra state))
          (.releaseLock c state)
          (return))))))




^{:go/end 224} (go/method releaseReader [^{:tag (* Counter)} c ^counterStateBits state]
  (for [] _ (set! state (.load (.-state c)))
    ;; If we are the last reader and havePtr was cleared
    ;; while this batch of readers was using c.ptr,
    ;; it's our job to update c.ptr by upgrading to a full lock
    ;; and letting releaseLock do the work.
    ;; Note: no new reader will attempt to add itself now that havePtr is clear,
    ;; so we are only racing against possible additions to extra.
    (when (and (== (.readers state) 1) (not (.havePtr state)))
      (when (not (.update (.-state c) (addr state) (.setLocked state)))
        (continue))

      (debugPrintf "releaseReader %s: last reader, need ptr\n" (.-name c))
      (.releaseLock c state)
      (return))


    ;; Release reader.
    (when (not (.update (.-state c) (addr state) (.decReader state)))
      (continue))

    (debugPrintf "releaseReader %s: released (%d readers now)\n" (.-name c) (.readers state))
    (return)))



^{:go/end 263} (go/method releaseLock [^{:tag (* Counter)} c ^counterStateBits state]
  (for [] _ (set! state (.load (.-state c)))
    (when (not (.havePtr state))
      ;; Set havePtr before updating ptr,
      ;; to avoid race with the next clear of havePtr.
      (when (not (.update (.-state c) (addr state) (.setHavePtr state)))
        (continue))

      (debugPrintf "releaseLock %s: reset havePtr (extra=%d)\n" (.-name c) (.extra state))

      ;; Optimization: only bother loading a new pointer
      ;; if we have a value to add to it.
      (set! (.-ptr c) (lit counterPtr nil nil))
      (when (!= (.extra state) 0)
        (set! (.-ptr c) (.lookup (.-file c) (.-name c)))
        (debugPrintf "releaseLock %s: ptr=%v\n" (.-name c) (.-ptr c))))



    (when [extra (.extra state)] (and (!= extra 0) (!= (.-count (.-ptr c)) nil))
      (when (not (.update (.-state c) (addr state) (.clearExtra state)))
        (continue))

      (let [sum (.add c extra)]
        (debugPrintf "releaseLock %s: flush extra=%d -> count=%d\n" (.-name c) extra sum)))


    ;; Took care of refreshing ptr and flushing extra.
    ;; Now we can release the lock, unless of course
    ;; another goroutine cleared havePtr or added to extra,
    ;; in which case we go around again.
    (when (not (.update (.-state c) (addr state) (.clearLocked state)))
      (continue))

    (debugPrintf "releaseLock %s: unlocked\n" (.-name c))
    (return)))




^{:go/end 279} (go/method add "add wraps the atomic.Uint64.Add operation to handle integer overflow.\n" ^uint64 [^{:tag (* Counter)} c ^uint64 n]
  (let [count (.-count (.-ptr c))]

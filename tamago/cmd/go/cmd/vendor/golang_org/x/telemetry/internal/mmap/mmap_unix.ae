(in-ns 'go.cmd.vendor.golang_org.x.telemetry.internal.mmap) (go/file "mmap_unix.go" :build ["//go:build unix"] :imports [


    ^{:line 10} [fmt "fmt"]
    ^{:line 11} [fs "io/fs"]
    ^{:line 12} [os "os"]
    ^{:line 13} [syscall "syscall"]])


^{:go/end 36} (go/func mmapFile [^{:tag (* os/File)} f] :results [(* Data) error]
  (let [(values st err) (.Stat f)]
    (when (!= err nil)
      (return nil err))

    (let [size (.Size st)
        ^{:line 22} pagesize (conv int64 (os/Getpagesize))]
      (when (!= (conv int64 (conv int (+ size (- pagesize 1)))) (+ size (- pagesize 1)))
        (return nil (fmt/Errorf "%s: too large for mmap" (.Name f))))

      (let [n (conv int size)]
        (when (== n 0)
          (return (addr (lit Data f nil nil)) nil))

        (let [mmapLength (conv int (* (/ (- (+ size pagesize) 1) pagesize) pagesize)) ; round up to page size
            (values data ^:assign err) (syscall/Mmap (conv int (.Fd f)) 0 mmapLength (bit-or syscall/PROT_READ syscall/PROT_WRITE) syscall/MAP_SHARED)]
          (when (!= err nil)
            (return nil (addr (lit fs/PathError :Op "mmap" :Path (.Name f) :Err err))))

          (return (addr (lit Data f (subslice data _ n) nil)) nil))))))


^{:go/end 47} (go/func munmapFile ^error [^{:tag (* Data)} d]
  (when (== (len (.-Data d)) 0)
    (return nil))

  ^{:go/breaks [[3 46]]} (let [err (syscall/Munmap (.-Data d))]
    (when (!= err nil)
      (return (addr (lit fs/PathError :Op "munmap" :Path (.Name (.-f d)) :Err err))))

    nil))

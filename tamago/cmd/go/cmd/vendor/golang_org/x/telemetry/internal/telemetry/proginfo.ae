(in-ns 'go.cmd.vendor.golang_org.x.telemetry.internal.telemetry) (go/file "proginfo.go" :imports [


    ^{:line 8} [version "go/version"]
    ^{:line 9} [os "os"]
    ^{:line 10} [filepath "path/filepath"]
    ^{:line 11} [debug "runtime/debug"]
    ^{:line 12} [strings "strings"]])




^{:go/end 19} (go/func IsToolchainProgram "IsToolchainProgram reports whether a program with the given path is a Go\ntoolchain program.\n" ^bool [^string progPath]
  (strings/HasPrefix progPath "cmd/"))









^{:go/end 57} (go/func ProgramInfo "ProgramInfo extracts the go version, program package path, and program\nversion to use for counter files.\n\nFor programs in the Go toolchain, the program version will be the same as\nthe Go version, and will typically be of the form \"go1.2.3\", not a semantic\nversion of the form \"v1.2.3\". Go versions may also include spaces and\nspecial characters.\n" [^{:tag (* debug/BuildInfo)} info] :results [^string goVers ^string progPath ^string progVers]
  (set! goVers (.-GoVersion info))
  (when (or (strings/Contains goVers "devel") (strings/Contains goVers "-") (not (version/IsValid goVers)))
    (set! goVers "devel"))


  (set! progPath (.-Path info))
  (when (== progPath "")
    (set! progPath (strings/TrimSuffix (filepath/Base (aget os/Args 0)) ".exe")))


  ;; Main module version information is not populated for the cmd module, but
  ;; we can re-use the Go version here.
  (if (IsToolchainProgram progPath)
    (set! progVers goVers)
    (do
      (set! progVers (.-Version (.-Main info)))
      (when (or (strings/Contains progVers "devel") (> (strings/Count progVers "-") 1))
        ;; Heuristically mark all pseudo-version-like version strings as "devel"
        ;; to avoid creating too many counter files.
        ;; We should not use regexp that pulls in large dependencies.
        ;; Pseudo-versions have at least three parts (https://go.dev/ref/mod#pseudo-versions).
        ;; This heuristic still allows use to track prerelease
        ;; versions (e.g. gopls@v0.16.0-pre.1, vscgo@v0.42.0-rc.1).
        (set! progVers "devel"))))



  (return goVers progPath progVers))

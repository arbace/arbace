(in-ns 'go.cmd.vendor.golang_org.x.telemetry.internal.telemetry) (go/file "types.go" :imports [])

;; Common types and directories used by multiple packages.


(go/type UploadConfig "An UploadConfig controls what data is uploaded.\n" (struct
    ^{:line 11 :tag (slice string)} GOOS
    ^{:line 12 :tag (slice string)} GOARCH
    ^{:line 13 :tag (slice string)} GoVersion
    ^{:line 14 :tag float64} SampleRate
    ^{:line 15 :tag (slice (* ProgramConfig))} Programs))


(go/type ProgramConfig (struct



    ^{:line 22 :tag string :doc "the counter names may have to be\nrepeated for each program. (e.g., if the counters are in a package\nthat is used in more than one program.)\n"} Name
    ^{:line 23 :tag (slice string)} Versions ; versions present in a counterconfig
    ^{:line 24 :tag (slice CounterConfig) :go/tag "json:\",omitempty\""} Counters
    ^{:line 25 :tag (slice CounterConfig) :go/tag "json:\",omitempty\""} Stacks))


(go/type CounterConfig (struct
    ^{:line 29 :tag string} Name ; The "collapsed" counter: <chart>:{<bucket1>,<bucket2>,...}
    ^{:line 30 :tag float64} Rate ; If X <= Rate, report this counter
    ^{:line 31 :tag int :go/tag "json:\",omitempty\""} Depth)) ; for stack counters



(go/type Report "A Report is the weekly aggregate of counters.\n" (struct
    ^{:line 36 :tag string} Week ; End day this report covers (YYYY-MM-DD)
    ^{:line 37 :tag string} LastWeek ; Week field from latest previous report uploaded
    ^{:line 38 :tag float64} X ; A random probability used to determine which counters are uploaded
    ^{:line 39 :tag (slice (* ProgramReport))} Programs
    ^{:line 40 :tag string} Config)) ; version of UploadConfig used


(go/type ProgramReport (struct
    ^{:line 44 :tag string} Program ; Package path of the program.
    ^{:line 45 :tag string} Version ; Program version. Go version if the program is part of the go distribution. Module version, otherwise.
    ^{:line 46 :tag string} GoVersion ; Go version used to build the program.
    ^{:line 47 :tag string} GOOS
    ^{:line 48 :tag string} GOARCH
    ^{:line 49 :tag (map string int64)} Counters
    ^{:line 50 :tag (map string int64)} Stacks))

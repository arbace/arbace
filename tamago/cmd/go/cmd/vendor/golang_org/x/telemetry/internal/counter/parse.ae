        (return nil (fmt/Errorf "%s: corrupt counter file" filename)))


      ^{:line 33} f (addr ^{:go/breaks [2 4]} (lit File
          :Meta (make (map string string))
          :Count (make (map string uint64))))

      ^{:line 37} np (^{:inst [int]} round (len hdrPrefix) 4)
      ^{:line 38} hdrLen @(conv (* uint32) (conv unsafe/Pointer (addr (aget data np))))]
    (when (> hdrLen pageSize)

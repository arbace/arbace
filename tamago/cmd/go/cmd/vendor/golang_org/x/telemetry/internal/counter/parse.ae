^{:go/end 82} (go/func Parse [^string filename ^{:tag (slice byte)} data] :results [(* File) error]
  (when (or (not (bytes/HasPrefix data (conv (slice byte) hdrPrefix))) (< (len data) pageSize))
    (when (< (len data) pageSize)
      (return nil (fmt/Errorf "%s: file too short (%d<%d)" filename (len data) pageSize)))

    (return nil (fmt/Errorf "%s: wrong hdr (not %q)" filename hdrPrefix)))

  (let [corrupt ^{:go/end 31} (fn [] :results [(* File) error]

(in-ns 'go.cmd.vendor.golang_org.x.telemetry.counter) (go/file "counter.go" :imports [

    ;; The implementation of this package and tests are located in
    ;; internal/counter, which can be shared with the upload package.
    ;; TODO(hyangah): use of type aliases prevents nice documentation
    ;; rendering in go doc or pkgsite. Fix this either by avoiding
    ;; type aliasing or restructuring the internal/counter package.

    ^{:line 13} [flag "flag"]
    ^{:line 14} [path "path"]
    ^{:line 15} [debug "runtime/debug"]

    ^{:line 17} [counter "golang.org/x/telemetry/internal/counter"]
    ^{:line 18} [telemetry "golang.org/x/telemetry/internal/telemetry"]])



^{:go/end 24} (go/func Inc "Inc increments the counter with the given name.\n" [^string name]
  (.Inc (New name)))



^{:go/end 29} (go/func Add "Add adds n to the counter with the given name.\n" [^string name ^int64 n]
  (.Add (New name) n))









^{:go/end 44} (go/func New "New returns a counter with the given name.\nNew can be called in global initializers and will be compiled down to\nlinker-initialized data. That is, calling New to initialize a global\nhas no cost at program startup.\n\nSee \"Counter Naming\" in the package doc for a description of counter naming\nconventions.\n" ^{:tag (* Counter)} [^string name]
  ;; Note: not calling DefaultFile.New in order to keep this
  ;; function something the compiler can inline and convert
  ;; into static data initializations, with no init-time footprint.
  ;; TODO(hyangah): is it trivial enough for the compiler to inline?
  (counter/New name))






















(go/type ^:alias Counter "A Counter is a single named event counter.\nA Counter is safe for use by multiple goroutines simultaneously.\n\nCounters should typically be created using New\nand stored as global variables, like:\n\n\tpackage mypackage\n\tvar errorCount = counter.New(\"mypackage/errors\")\n\n(The initialization of errorCount in this example is handled\nentirely by the compiler and linker; this line executes no code\nat program startup.)\n\nThen code can call Add to increment the counter\neach time the corresponding event is observed.\n\nAlthough it is possible to use New to create\na Counter each time a particular event needs to be recorded,\nthat usage fails to amortize the construction cost over\nmultiple calls to Add, so it is more expensive and not recommended.\n" counter/Counter)




(go/type ^:alias StackCounter "A StackCounter is the in-memory knowledge about a stack counter.\nStackCounters are more expensive to use than regular Counters,\nrequiring, at a minimum, a call to runtime.Callers.\n" counter/StackCounter)





^{:go/end 79} (go/func NewStack "NewStack returns a new stack counter with the given name and depth.\n\nSee \"Counter Naming\" in the package doc for a description of counter naming\nconventions.\n" ^{:tag (* StackCounter)} [^string name ^int depth]
  (counter/NewStack name depth))










^{:go/end 91} (go/func Open "Open prepares telemetry counters for recording to the file system.\n\nIf the telemetry mode is \"off\", Open is a no-op. Otherwise, it opens the\ncounter file on disk and starts to mmap telemetry counters to the file.\nOpen also persists any counters already created in the current process.\n\nOpen should only be called from short-lived processes such as command line\ntools. If your process is long-running, use [OpenAndRotate].\n" []
  (counter/Open false))








^{:go/end 101} (go/func OpenAndRotate "OpenAndRotate is like [Open], but also schedules a rotation of the counter\nfile when it expires.\n\nSee golang/go#68497 for background on why [OpenAndRotate] is a separate API.\n\nTODO(rfindley): refactor Open and OpenAndRotate for Go 1.24.\n" []
  (counter/Open true))








^{:go/end 114} (go/func OpenDir "OpenDir prepares telemetry counters for recording to the file system, using\nthe specified telemetry directory, if it is not the empty string.\n\nIf the telemetry mode is \"off\", Open is a no-op. Otherwise, it opens the\ncounter file on disk and starts to mmap telemetry counters to the file.\nOpen also persists any counters already created in the current process.\n" [^string telemetryDir]
  (when (!= telemetryDir "")
    (set! telemetry/Default (telemetry/NewDir telemetryDir)))

  (counter/Open false))







^{:go/end 125} (go/func CountFlags "CountFlags creates a counter for every flag that is set\nand increments the counter. The name of the counter is\nthe concatenation of prefix and the flag name.\n\n\tFor instance, CountFlags(\"gopls/flag:\", *flag.CommandLine)\n" [^string prefix ^flag/FlagSet fs]
  (.Visit fs ^{:go/end 124} (fn [^{:tag (* flag/Flag)} f]
      (.Inc (New (+ prefix (.-Name f)))))))
















^{:go/end 146} (go/func CountCommandLineFlags "CountCommandLineFlags creates a counter for every flag\nthat is set in the default flag.CommandLine FlagSet using\nthe counter name binaryName+\"/flag:\"+flagName where\nbinaryName is the base name of the Path embedded in the\nbinary's build info. If the binary does not have embedded build\ninfo, the \"flag:\"+flagName counter will be incremented.\n\nCountCommandLineFlags must be called after flags are parsed\nwith flag.Parse.\n\nFor instance, if the -S flag is passed to cmd/compile and\nCountCommandLineFlags is called after flags are parsed,\nthe \"compile/flag:S\" counter will be incremented.\n" []
  (let [prefix "flag:"]
    (when [(values buildInfo ok) (debug/ReadBuildInfo)] (and ok (!= (.-Path buildInfo) ""))
      (set! prefix (+ (path/Base (.-Path buildInfo)) "/" prefix)))

    (CountFlags prefix @flag/CommandLine)))

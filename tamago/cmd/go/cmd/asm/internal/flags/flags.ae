;; Package flags implements top-level flags and the usage message for the assembler.
(in-ns 'go.cmd.asm.internal.flags) (go/file "flags.go" :doc "Package flags implements top-level flags and the usage message for the assembler.\n" :imports [


    ^{:line 9} [obj "cmd/internal/obj"]
    ^{:line 10} [objabi "cmd/internal/objabi"]
    ^{:line 11} [flag "flag"]
    ^{:line 12} [fmt "fmt"]
    ^{:line 13} [os "os"]
    ^{:line 14} [filepath "path/filepath"]
    ^{:line 15} [strings "strings"]])


(go/var
  ^{:line 19} [Debug (flag/Bool "debug" false "dump instructions as they are parsed")]
  ^{:line 20} [OutputFile (flag/String "o" "" "output file; default foo.o for /a/b/c/foo.s as first argument")]
  ^{:line 21} [TrimPath (flag/String "trimpath" "" "remove prefix from recorded source file paths")]
  ^{:line 22} [Shared (flag/Bool "shared" false "generate code that can be linked into a shared library")]
  ^{:line 23} [Dynlink (flag/Bool "dynlink" false "support references to Go symbols defined in other shared libraries")]
  ^{:line 24} [Linkshared (flag/Bool "linkshared" false "generate code that will be linked against Go shared libraries")]
  ^{:line 25} [AllErrors (flag/Bool "e" false "no limit on number of errors reported")]
  ^{:line 26} [SymABIs (flag/Bool "gensymabis" false "write symbol ABI information to output file, don't assemble")]
  ^{:line 27} [Importpath (flag/String "p" obj/UnlinkablePkg "set expected package import to path")]
  ^{:line 28} [Spectre (flag/String "spectre" "" "enable spectre mitigations in `list` (all, ret)")]
  ^{:line 29} [Std (flag/Bool "std" false "building standard library")])


(go/var ^{:tag (struct ^{:tag int :go/tag "help:\"use compressed instructions when possible (if supported by architecture)\""} CompressInstructions ^{:tag string :go/tag "help:\"call named function before all stack growth checks\""} MayMoreStack ^{:tag string :go/tag "help:\"print named pc-value table\\nOne of: pctospadj, pctofile, pctoline, pctoinline, pctopcdata\""} PCTab)} DebugFlags)





(go/var
  ^{:line 39} [^MultiFlag D]
  ^{:line 40} [^MultiFlag I]
  ^{:line 41} [^int PrintOut]
  ^{:line 42} [^bool DebugV])


^{:go/end 54} (go/func init []
  (flag/Var (addr D) "D" "predefined symbol with optional simple value -D=identifier=value; can be set multiple times")
  (flag/Var (addr I) "I" "include directory; can be set multiple times")
  (flag/BoolVar (addr DebugV) "v" false "print debug output")
  (flag/Var (objabi/NewDebugFlag (addr DebugFlags) nil) "d" "enable debugging settings; try -d help")
  (objabi/AddVersionFlag) ; -V
  (objabi/Flagcount "S" "print assembly and machine code" (addr PrintOut))

  (set! (.-CompressInstructions DebugFlags) 1))



(go/type MultiFlag "MultiFlag allows setting a value multiple times to collect a list, as in -I=dir1 -I=dir2.\n" (slice string))

^{:go/end 64} (go/method String ^string [^{:tag (* MultiFlag)} m]
  (when (== (len @m) 0)
    (return ""))

  (fmt/Sprint @m))


^{:go/breaks [4] :go/end 69} (go/method Set ^error [^{:tag (* MultiFlag)} m ^string val]
  (set! @m (append @m val))
  nil)


^{:go/end 76} (go/func Usage []
  (fmt/Fprintf os/Stderr "usage: asm [options] file.s ...\n")
  (fmt/Fprintf os/Stderr "Flags:\n")
  (flag/PrintDefaults)
  (os/Exit 2))


^{:go/end 93} (go/func Parse []
  (objabi/Flagparse Usage)
  (when (== (flag/NArg) 0)
    (flag/Usage))


  ;; Flag refinement.
  (when (== @OutputFile "")
    (when (!= (flag/NArg) 1)
      (flag/Usage))

    (let [input (filepath/Base (flag/Arg 0))]
      (set! input (strings/TrimSuffix input ".s"))
      (set! @OutputFile (fmt/Sprintf "%s.o" input)))))

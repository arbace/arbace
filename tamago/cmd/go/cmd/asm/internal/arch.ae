(ns go.cmd.asm.internal.arch
  (:require [arbace.go :as go]))

(go/package arch
  :path "cmd/asm/internal/arch"
  :files ["arch.go" "arm.go" "arm64.go" "loong64.go" "mips.go" "ppc64.go" "riscv64.go" "s390x.go"]
  :positions :lines)

(load "arch/arch")
(load "arch/arm")
(load "arch/arm64")
(load "arch/loong64")
(load "arch/mips")
(load "arch/ppc64")
(load "arch/riscv64")
(load "arch/s390x")

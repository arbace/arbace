(in-ns 'go.cmd.asm.internal.lex) (go/file "slice.go" :imports [


    ^{:line 8} [scanner "text/scanner"]

    ^{:line 10} [src "cmd/internal/src"]])



(go/type Slice "A Slice reads from a slice of Tokens.\n" (struct
    ^{:line 15 :tag (slice Token)} tokens
    ^{:line 16 :tag (* src/PosBase)} base
    ^{:line 17 :tag int} line
    ^{:line 18 :tag int} pos))


^{:go/end 28} (go/func NewSlice ^{:tag (* Slice)} [^{:tag (* src/PosBase)} base ^int line ^{:tag (slice Token)} tokens]
  (addr ^{:go/breaks [2 4 6 8]} (lit Slice
      :tokens tokens
      :base base
      :line line
      :pos -1))) ; Next will advance to zero.



^{:go/end 36} (go/method Next ^ScanToken [^{:tag (* Slice)} s]
  (inc! (.-pos s))
  (when (>= (.-pos s) (len (.-tokens s)))
    (return scanner/EOF))

  (.-ScanToken (aget (.-tokens s) (.-pos s))))


^{:go/end 40} (go/method Text ^string [^{:tag (* Slice)} s]
  (.-text (aget (.-tokens s) (.-pos s))))


^{:go/end 44} (go/method File ^string [^{:tag (* Slice)} s]
  (.Filename (.-base s)))


^{:go/end 48} (go/method Base ^{:tag (* src/PosBase)} [^{:tag (* Slice)} s]
  (.-base s))


^{:go/end 54} (go/method SetBase [^{:tag (* Slice)} s ^{:tag (* src/PosBase)} base]
  ;; Cannot happen because we only have slices of already-scanned text,
  ;; but be prepared.
  (set! (.-base s) base))


^{:go/end 58} (go/method Line ^int [^{:tag (* Slice)} s]
  (.-line s))


^{:go/end 71} (go/method Col ^int [^{:tag (* Slice)} s]
  ;; TODO: Col is only called when defining a macro and all it cares about is increasing
  ;; position to discover whether there is a blank before the parenthesis.
  ;; We only get here if defining a macro inside a macro.
  ;; This imperfect implementation means we cannot tell the difference between
  ;;	#define A #define B(x) x
  ;; and
  ;;	#define A #define B (x) x
  ;; The first definition of B has an argument, the second doesn't. Because we let
  ;; text/scanner strip the blanks for us, this is extremely rare, hard to fix, and not worth it.
  (.-pos s))


^{:go/end 74} (go/method Close [^{:tag (* Slice)} s])

(go/type ScanToken "A ScanToken represents an input item. It is a simple wrapping of rune, as\nreturned by text/scanner.Scanner, plus a couple of extra values.\n" rune)

(go/const


  ^{:line 25} [^{:tag ScanToken :val -1000 :doc "Asm defines some two-character lexemes. We make up\na rune/ScanToken value for them - ugly but simple.\n"} LSH (- -1000 iota)] ; << Left shift.
  ^{:line 26} [^{:val -1001} RSH] ; >> Logical right shift.
  ^{:line 27} [^{:val -1002} ARR] ; -> Used on ARM for shift type 3, arithmetic right shift.
  ^{:line 28} [^{:val -1003} ROT] ; @> Used on ARM for shift type 4, rotate right.
  ^{:line 29} [^{:val -1004} Include] ; included file started here
  ^{:line 30} [^{:val -1005} BuildComment] ; //go:build or +build comment
  ^{:line 31} [^{:val -1006} macroName]) ; name of macro that should not be expanded



^{:go/end 37} (go/func IsRegisterShift "IsRegisterShift reports whether the token is one of the ARM register shift operators.\n" ^bool [^ScanToken r]
  (and (<= ROT r) (<= r LSH))) ; Order looks backwards because these are negative.


^{:go/end 60} (go/method String ^string [^ScanToken t]
  (switch t
    (case [scanner/EOF]
      (return "EOF"))
    (case [scanner/Ident]
      (return "identifier"))
    (case [scanner/Int]
      (return "integer constant"))
    (case [scanner/Float]
      (return "float constant"))
    (case [scanner/Char]
      (return "rune constant"))
    (case [scanner/String]
      (return "string constant"))
    (case [scanner/RawString]
      (return "raw string constant"))
    (case [scanner/Comment]
      (return "comment"))
    (default
      (return (fmt/Sprintf "%q" (conv rune t))))))




^{:go/end 71} (go/func NewLexer "NewLexer returns a lexer for the named file and the given link context.\n" ^TokenReader [^string name]
  (let [input (NewInput name)
      (values fd err) (os/Open name)]
    (when (!= err nil)
      (log/Fatalf "%s\n" err))

    (.Push input (NewTokenizer name fd fd))
    ^{:line 70} input))


;; The other files in this directory each contain an implementation of TokenReader.





(go/type TokenReader "A TokenReader is like a reader, but returns lex tokens of type Token. It also can tell you what\nthe text of the most recently returned token is, and where it was found.\nThe underlying scanner elides all spaces except newline, so the input looks like a stream of\nTokens; original spacing is lost but we don't need it.\n" (interface

    (^{:doc "Next returns the next token.\n"} Next ^ScanToken [])


    (^{:doc "The following methods all refer to the most recent token returned by Next.\nText returns the original string representation of the token.\n"} Text ^string [])

    (^{:doc "File reports the source file name of the token.\n"} File ^string [])

    (^{:doc "Base reports the position base of the token.\n"} Base ^{:tag (* src/PosBase)} [])

    (^{:doc "SetBase sets the position base.\n"} SetBase [(* src/PosBase)])

    (^{:doc "Line reports the source line number of the token.\n"} Line ^int [])

    (^{:doc "Col reports the source column number of the token.\n"} Col ^int [])

    (^{:doc "Close does any teardown required.\n"} Close [])))




(go/type Token "A Token is a scan token plus its string value.\nA macro is stored as a sequence of Tokens with spaces stripped.\n" (struct
    ^{:line 102} ScanToken
    ^{:line 103 :tag string} text))



^{:go/end 112} (go/func Make "Make returns a Token with the given rune (ScanToken) and text representation.\n" ^Token [^ScanToken token ^string text]
  ;; Substitute the substitutes for . and /.
  (set! text (strings/ReplaceAll text "·" "."))
  (set! text (strings/ReplaceAll text "∕" "/"))
  (lit Token :ScanToken token :text text))


^{:go/end 116} (go/method String ^string [^Token l]
  (.-text l))



(go/type Macro "A Macro represents the definition of a #defined macro.\n" (struct
    ^{:line 120 :tag string} name ; The #define name.
    ^{:line 121 :tag (slice string)} args ; Formal arguments.
    ^{:line 122 :tag (slice Token)} tokens)) ; Body of macro.



^{:go/end 137} (go/func Tokenize "Tokenize turns a string into a list of Tokens; used to parse the -D flag and in tests.\n" ^{:tag (slice Token)} [^string str]
  (let [t (NewTokenizer "command line" (strings/NewReader str) nil)
      ^{:line 128 :tag (slice Token)} tokens (zero (slice Token))]
    (while true
      (let [tok (.Next t)]
        (when (== tok scanner/EOF)
          (break))

        (set! tokens (append tokens (Make tok (.Text t))))))

    ^{:line 136} tokens))

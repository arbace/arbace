            (.Error in "#include:" err)))


        (.Push in (NewTokenizer name fd fd))))))



^{:go/end 454} (go/method line "#line processing.\n" [^{:tag (* Input)} in]
  ;; Only need to handle Plan 9 format: #line 337 "filename"

                  (let [arg (.Text (.-Stack in))]
                    (when (^{:inst [(slice string) string]} slices/Contains args arg)
                      (.Error in "duplicate argument" arg "in definition for macro:" name))

                    (set! args (append args arg))
                    (set! acceptArg false)))
                (default

^{:go/breaks [6] :go/end 140} (go/method Next ^ScanToken [^{:tag (* Input)} in]
  (when (.-peek in)
    (set! (.-peek in) false)
    (let [tok (.-peekToken in)]
      (set! (.-text in) (.-peekText in))
      (return tok)))

  ;; If we cannot generate a token after 100 macro invocations, we're in trouble.
  ;; The usual case is caught by Push, below, but be safe.
  (for [nesting 0] (< nesting 100) _
    (let [tok (.Next (.-Stack in))]
      (switch tok
        (case [\#]
          (when (not (.-beginningOfLine in))
            (.Error in "'#' must be first item on line"))

          (set! (.-beginningOfLine in) (.hash in))
          (set! (.-text in) "#")
          (return \#))

        (case [scanner/Ident]
          ;; Is it a macro name?
          (let [name (.Text (.-Stack in))
              ^{:line 119} macro (aget (.-macros in) name)]
            (when (!= macro nil)
              (inc! nesting)
              (.invokeMacro in macro)
              (continue))

            (fallthrough)))
        (default
          (when (and (== tok scanner/EOF) (> (len (.-ifdefStack in)) 0))
            ;; We're skipping text but have run out of input with no #endif.
            (.Error in "unclosed #ifdef or #ifndef"))

          (set! (.-beginningOfLine in) (== tok \newline))
          (when (.enabled in)
            (set! (.-text in) (.Text (.-Stack in)))
            (return tok))))))



  (.Error in "recursive macro invocation")
  0)


^{:go/end 144} (go/method Text ^string [^{:tag (* Input)} in]
  (.-text in))



^{:go/end 185} (go/method hash "hash processes a # preprocessor directive. It reports whether it completes.\n" ^bool [^{:tag (* Input)} in]
  ;; We have a '#'; it must be followed by a known word (define, include, etc.).
  ^{:go/breaks [[5 184]]} (let [tok (.Next (.-Stack in))]
    (when (!= tok scanner/Ident)
      (.expectText in "expected identifier after '#'"))

    (when (not (.enabled in))
      ;; Can only start including again if we are at #else or #endif but also
      ;; need to keep track of nested #if[n]defs.
      ;; We let #line through because it might affect errors.
      (switch (.Text (.-Stack in))
        (case ["else" "endif" "ifdef" "ifndef" "line"])
        ;; Press on.
        (default
          (return false))))


    (switch (.Text (.-Stack in))
      (case ["define"]
        (.define in))
      (case ["else"]
        (.else_ in))
      (case ["endif"]
        (.endif in))
      (case ["ifdef"]
        (.ifdef in true))
      (case ["ifndef"]
        (.ifdef in false))
      (case ["include"]
        (.include in))
      (case ["line"]
        (.line in))
      (case ["undef"]
        (.undef in))
      (default
        (.Error in "unexpected token after '#':" (.Text (.-Stack in)))))

    true))



^{:go/end 196} (go/method macroName "macroName returns the name for the macro being referenced.\n" ^string [^{:tag (* Input)} in]

^{:go/end 367} (go/method collectArgument "collectArgument returns the actual tokens for a single argument of a macro.\nIt also returns the token that terminated the argument, which will always\nbe either ',' or ')'. The starting '(' has been scanned.\n" [^{:tag (* Input)} in ^{:tag (* Macro)} macro] :results [(slice Token) ScanToken]

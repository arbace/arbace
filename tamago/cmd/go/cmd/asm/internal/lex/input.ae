^{:go/end 318} (go/method invokeMacro "invokeMacro pushes onto the input Stack a Slice that holds the macro definition with the actual\nparameters substituted for the formals.\nInvoking a macro does not touch the PC/line history.\n" [^{:tag (* Input)} in ^{:tag (* Macro)} macro]
  ;; If the macro has no arguments, just substitute the text.
  (when (== (.-args macro) nil)
    (.Push in (NewSlice ^{:go/via [Stack]} (.Base in) ^{:go/via [Stack]} (.Line in) (.-tokens macro)))

^{:go/end 343} (go/method argsFor "argsFor returns a map from formal name to actual value for this argumented macro invocation.\nThe opening parenthesis has been absorbed.\n" ^{:tag (map string (slice Token))} [^{:tag (* Input)} in ^{:tag (* Macro)} macro]

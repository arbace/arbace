^{:go/end 282} (go/method macroDefinition "macroDefinition returns the list of formals and the tokens of the definition.\nThe argument list is nil for no parens on the definition; otherwise a list of\nformal argument names.\n" [^{:tag (* Input)} in ^string name] :results [(slice string) (slice Token)]
  (let [prevCol (.Col (.-Stack in))
      ^{:line 222} tok (.Next (.-Stack in))]
    (when (or (== tok \newline) (== tok scanner/EOF))
      (return nil nil)) ; No definition for macro

    (let [^{:tag (slice string)} args (zero (slice string))]
      ;; The C preprocessor treats
      ;;	#define A(x)
      ;; and
      ;;	#define A (x)
      ;; distinctly: the first is a macro with arguments, the second without.
      ;; Distinguish these cases using the column number, since we don't
      ;; see the space itself. Note that text/scanner reports the position at the
      ;; end of the token. It's where you are now, and you just read this token.
      (when (and (== tok \() (== (.Col (.-Stack in)) (+ prevCol 1)))
        ;; Macro has arguments. Scan list of formals.
        (let [acceptArg true]
          (set! args (lit (slice string))) ; Zero length but not nil.
          (label :Loop
            (while true
              (set! tok (.Next (.-Stack in)))
              (switch tok
                (case [\)]
                  (set! tok (.Next (.-Stack in))) ; First token of macro definition.
                  (break :Loop))
                (case [\,]

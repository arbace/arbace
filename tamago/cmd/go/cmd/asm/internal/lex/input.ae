    ^{:line 66} macros))


(go/var ^bool panicOnError) ; For testing.

^{:go/end 77} (go/method Error [^{:tag (* Input)} in & ^{:tag (slice any)} args]
  (when panicOnError
    (panic (fmt/Errorf "%s:%d: %s" ^{:go/via [Stack]} (.File in) ^{:go/via [Stack]} (.Line in) (fmt/Sprintln (spread args)))))

  (fmt/Fprintf os/Stderr "%s:%d: %s" ^{:go/via [Stack]} (.File in) ^{:go/via [Stack]} (.Line in) (fmt/Sprintln (spread args)))
  (os/Exit 1))



^{:go/end 82} (go/method expectText "expectText is like Error but adds \"got XXX\" where XXX is a quoted representation of the most recent token.\n" [^{:tag (* Input)} in & ^{:tag (slice any)} args]

    ;; One macro argument per iteration. Collect them all and check counts afterwards.
    (for [argNum 0] _ (inc! argNum)
      (let [(values tokens tok) (.collectArgument in macro)]
        (set! args (append args tokens))
        (when (== tok \))
          (break))))


    ;; Zero-argument macros are tricky.
    (cond (and (== (len (.-args macro)) 0) (== (len args) 1) (== (aget args 0) nil))

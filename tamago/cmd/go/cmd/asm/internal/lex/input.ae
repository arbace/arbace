            (when (and (!= tok \newline) (!= tok \\))
              (.Error in "can only escape \\ or \\n in definition for macro:" name)))


          (set! tokens (append tokens (Make tok (.Text (.-Stack in)))))
          (set! tok (.Next (.-Stack in))))


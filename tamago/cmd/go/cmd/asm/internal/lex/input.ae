^{:go/end 44} (go/func NewInput "NewInput returns an Input from the given path.\n" ^{:tag (* Input)} [^string name]
  (addr ^{:go/breaks [[2 40] 4 6]} (lit Input
      ;; include directories: look in source dir, then -I directories.
      :includes (append (lit (slice string) (filepath/Dir name)) (spread flags/I))
      :beginningOfLine true
      :macros (predefine flags/D))))




^{:go/end 67} (go/func predefine "predefine installs the macros set by the -D flag on the command line.\n" ^{:tag (map string (* Macro))} [^flags/MultiFlag defines]
  (let [macros (make (map string (* Macro)))]
    (range [_ name defines]
      (let [value "1"
          ^{:line 51} i (strings/IndexRune name \=)]
        (when (> i 0)
          (set! (values name value) (values (subslice name _ i) (subslice name (+ i 1)))))

        (let [tokens (Tokenize name)]

(in-ns 'go.cmd.asm.internal.lex) (go/file "stack.go" :imports [


    ^{:line 8} [scanner "text/scanner"]

    ^{:line 10} [src "cmd/internal/src"]])




(go/type Stack "A Stack is a stack of TokenReaders. As the top TokenReader hits EOF,\nit resumes reading the next one down.\n" (struct
    ^{:line 16 :tag (slice TokenReader)} tr))



^{:go/end 22} (go/method Push "Push adds tr to the top (end) of the input stack. (Popping happens automatically.)\n" [^{:tag (* Stack)} s ^TokenReader tr]
  (set! (.-tr s) (append (.-tr s) tr)))


^{:go/end 34} (go/method Next ^ScanToken [^{:tag (* Stack)} s]
  (let [tos (aget (.-tr s) (- (len (.-tr s)) 1))
      ^{:line 26} tok (.Next tos)]
    (while (and (== tok scanner/EOF) (> (len (.-tr s)) 1))
      (.Close tos)
      ;; Pop the topmost item from the stack and resume with the next one down.
      (set! (.-tr s) (subslice (.-tr s) _ (- (len (.-tr s)) 1)))
      (set! tok (.Next s)))

    ^{:line 33} tok))


^{:go/end 38} (go/method Text ^string [^{:tag (* Stack)} s]
  (.Text (aget (.-tr s) (- (len (.-tr s)) 1))))


^{:go/end 42} (go/method File ^string [^{:tag (* Stack)} s]
  (.Filename (.Base s)))


^{:go/end 46} (go/method Base ^{:tag (* src/PosBase)} [^{:tag (* Stack)} s]
  (.Base (aget (.-tr s) (- (len (.-tr s)) 1))))


^{:go/end 50} (go/method SetBase [^{:tag (* Stack)} s ^{:tag (* src/PosBase)} base]
  (.SetBase (aget (.-tr s) (- (len (.-tr s)) 1)) base))


^{:go/end 54} (go/method Line ^int [^{:tag (* Stack)} s]
  (.Line (aget (.-tr s) (- (len (.-tr s)) 1))))


^{:go/end 58} (go/method Col ^int [^{:tag (* Stack)} s]
  (.Col (aget (.-tr s) (- (len (.-tr s)) 1))))


^{:go/end 61} (go/method Close [^{:tag (* Stack)} s]) ; Unused.

^{:go/end 717} (go/func archRISCV64 ^{:tag (* Arch)} [^bool shared]
  (let [register (make (map string int16))]

    ;; Standard register names.
    (for [i riscv/REG_X0] (<= i riscv/REG_X31) (inc! i)
      ;; Disallow X3 in shared mode, as this will likely be used as the
      ;; GP register, which could result in problems in non-Go code,
      ;; including signal handlers.
      (when (and shared (== i riscv/REG_GP))
        (continue))

      (when (or (== i riscv/REG_TP) (== i riscv/REG_G))
        (continue))

      (let [name (fmt/Sprintf "X%d" (- i riscv/REG_X0))]
        (aset register name (conv int16 i))))

    (for [i riscv/REG_F0] (<= i riscv/REG_F31) (inc! i)
      (let [name (fmt/Sprintf "F%d" (- i riscv/REG_F0))]
        (aset register name (conv int16 i))))

    (for [i riscv/REG_V0] (<= i riscv/REG_V31) (inc! i)
      (let [name (fmt/Sprintf "V%d" (- i riscv/REG_V0))]
        (aset register name (conv int16 i))))


    ;; General registers with ABI names.
    (aset register "ZERO" riscv/REG_ZERO)
    (aset register "RA" riscv/REG_RA)
    (aset register "SP" riscv/REG_SP)
    (aset register "GP" riscv/REG_GP)
    (aset register "TP" riscv/REG_TP)
    (aset register "T0" riscv/REG_T0)
    (aset register "T1" riscv/REG_T1)
    (aset register "T2" riscv/REG_T2)
    (aset register "S0" riscv/REG_S0)
    (aset register "S1" riscv/REG_S1)
    (aset register "A0" riscv/REG_A0)
    (aset register "A1" riscv/REG_A1)
    (aset register "A2" riscv/REG_A2)
    (aset register "A3" riscv/REG_A3)
    (aset register "A4" riscv/REG_A4)
    (aset register "A5" riscv/REG_A5)
    (aset register "A6" riscv/REG_A6)
    (aset register "A7" riscv/REG_A7)
    (aset register "S2" riscv/REG_S2)
    (aset register "S3" riscv/REG_S3)
    (aset register "S4" riscv/REG_S4)
    (aset register "S5" riscv/REG_S5)
    (aset register "S6" riscv/REG_S6)
    (aset register "S7" riscv/REG_S7)
    (aset register "S8" riscv/REG_S8)
    (aset register "S9" riscv/REG_S9)
    (aset register "S10" riscv/REG_S10)
    ;; Skip S11 as it is the g register.
    (aset register "T3" riscv/REG_T3)
    (aset register "T4" riscv/REG_T4)
    (aset register "T5" riscv/REG_T5)
    (aset register "T6" riscv/REG_T6)

    ;; Go runtime register names.
    (aset register "g" riscv/REG_G)
    (aset register "CTXT" riscv/REG_CTXT)
    (aset register "TMP" riscv/REG_TMP)

    ;; ABI names for floating point register.
    (aset register "FT0" riscv/REG_FT0)
    (aset register "FT1" riscv/REG_FT1)
    (aset register "FT2" riscv/REG_FT2)
    (aset register "FT3" riscv/REG_FT3)
    (aset register "FT4" riscv/REG_FT4)
    (aset register "FT5" riscv/REG_FT5)
    (aset register "FT6" riscv/REG_FT6)
    (aset register "FT7" riscv/REG_FT7)
    (aset register "FS0" riscv/REG_FS0)
    (aset register "FS1" riscv/REG_FS1)
    (aset register "FA0" riscv/REG_FA0)
    (aset register "FA1" riscv/REG_FA1)
    (aset register "FA2" riscv/REG_FA2)
    (aset register "FA3" riscv/REG_FA3)
    (aset register "FA4" riscv/REG_FA4)
    (aset register "FA5" riscv/REG_FA5)
    (aset register "FA6" riscv/REG_FA6)
    (aset register "FA7" riscv/REG_FA7)
    (aset register "FS2" riscv/REG_FS2)
    (aset register "FS3" riscv/REG_FS3)
    (aset register "FS4" riscv/REG_FS4)
    (aset register "FS5" riscv/REG_FS5)
    (aset register "FS6" riscv/REG_FS6)
    (aset register "FS7" riscv/REG_FS7)
    (aset register "FS8" riscv/REG_FS8)
    (aset register "FS9" riscv/REG_FS9)
    (aset register "FS10" riscv/REG_FS10)
    (aset register "FS11" riscv/REG_FS11)
    (aset register "FT8" riscv/REG_FT8)
    (aset register "FT9" riscv/REG_FT9)
    (aset register "FT10" riscv/REG_FT10)
    (aset register "FT11" riscv/REG_FT11)

    ;; Pseudo-registers.
    (aset register "SB" RSB)
    (aset register "FP" RFP)
    (aset register "PC" RPC)

    (let [instructions (make (map string obj/As))]
      (range [i s obj/Anames]
        (aset instructions s (conv obj/As i)))

      (range [i s riscv/Anames]
        (when (>= (conv obj/As i) obj/A_ARCHSPECIFIC)
          (aset instructions s (+ (conv obj/As i) obj/ABaseRISCV))))



      (addr ^{:go/breaks [2 4 6 8 10 12]} (lit Arch
          :LinkArch (addr riscv/LinkRISCV64)
          :Instructions instructions
          :Register register
          :RegisterPrefix nil
          :RegisterNumber nilRegisterNumber
          :IsJump jumpRISCV)))))



^{:go/end 770} (go/func archS390x ^{:tag (* Arch)} []
  (let [register (make (map string int16))]
    ;; Create maps for easy lookup of instruction names etc.
    ;; Note that there is no list of names as there is for x86.
    (for [i s390x/REG_R0] (<= i s390x/REG_R15) (inc! i)
      (aset register (obj/Rconv i) (conv int16 i)))

    (for [i s390x/REG_F0] (<= i s390x/REG_F15) (inc! i)
      (aset register (obj/Rconv i) (conv int16 i)))

    (for [i s390x/REG_V0] (<= i s390x/REG_V31) (inc! i)
      (aset register (obj/Rconv i) (conv int16 i)))

    (for [i s390x/REG_AR0] (<= i s390x/REG_AR15) (inc! i)
      (aset register (obj/Rconv i) (conv int16 i)))

    (aset register "LR" s390x/REG_LR)
    ;; Pseudo-registers.
    (aset register "SB" RSB)
    (aset register "FP" RFP)
    (aset register "PC" RPC)
    ;; Avoid unintentionally clobbering g using R13.
    (delete register "R13")
    (aset register "g" s390x/REG_R13)
    (let [registerPrefix (lit (map string bool)
          ^{:line 744} ["AR" true]
          ^{:line 745} ["F" true]
          ^{:line 746} ["R" true])


        ^{:line 749} instructions (make (map string obj/As))]
      (range [i s obj/Anames]
        (aset instructions s (conv obj/As i)))

      (range [i s s390x/Anames]
        (when (>= (conv obj/As i) obj/A_ARCHSPECIFIC)
          (aset instructions s (+ (conv obj/As i) obj/ABaseS390X))))


      ;; Annoying aliases.
      (aset instructions "BR" s390x/ABR)
      (aset instructions "BL" s390x/ABL)

      (addr ^{:go/breaks [2 4 6 8 10 12]} (lit Arch
          :LinkArch (addr s390x/Links390x)
          :Instructions instructions
          :Register register
          :RegisterPrefix registerPrefix
          :RegisterNumber s390xRegisterNumber
          :IsJump jumpS390x)))))



^{:go/end 791} (go/func archWasm ^{:tag (* Arch)} []
  (let [instructions (make (map string obj/As))]
    (range [i s obj/Anames]
      (aset instructions s (conv obj/As i)))

    (range [i s wasm/Anames]
      (when (>= (conv obj/As i) obj/A_ARCHSPECIFIC)
        (aset instructions s (+ (conv obj/As i) obj/ABaseWasm))))



    (addr ^{:go/breaks [2 4 6 8 10 12]} (lit Arch
        :LinkArch (addr wasm/Linkwasm)
        :Instructions instructions
        :Register wasm/Register
        :RegisterPrefix nil
        :RegisterNumber nilRegisterNumber
        :IsJump jumpWasm))))

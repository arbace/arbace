^{:go/end 50} (go/func nilRegisterNumber "nilRegisterNumber is the register number function for architectures\nthat do not accept the R(N) notation. It always returns failure.\n" [^string name ^int16 n] :results [int16 bool]
  (return 0 false))




^{:go/breaks [[5 85]] :go/end 86} (go/func Set "Set configures the architecture specified by GOARCH and returns its representation.\nIt returns nil if GOARCH is not recognized.\n" ^{:tag (* Arch)} [^string GOARCH ^bool shared]
  (switch GOARCH
    (case ["386"]
      (return (archX86 (addr x86/Link386))))
    (case ["amd64"]
      (return (archX86 (addr x86/Linkamd64))))
    (case ["arm"]
      (return (archArm)))
    (case ["arm64"]
      (return (archArm64)))
    (case ["loong64"]
      (return (archLoong64 (addr loong64/Linkloong64))))
    (case ["mips"]
      (return (archMips (addr mips/Linkmips))))
    (case ["mipsle"]
      (return (archMips (addr mips/Linkmipsle))))
    (case ["mips64"]
      (return (archMips64 (addr mips/Linkmips64))))
    (case ["mips64le"]
      (return (archMips64 (addr mips/Linkmips64le))))
    (case ["ppc64"]
      (return (archPPC64 (addr ppc64/Linkppc64))))
    (case ["ppc64le"]
      (return (archPPC64 (addr ppc64/Linkppc64le))))
    (case ["riscv64"]
      (return (archRISCV64 shared)))
    (case ["s390x"]
      (return (archS390x)))
    (case ["wasm"]
      (return (archWasm))))

  nil)


^{:go/end 90} (go/func jumpX86 ^bool [^string word]
  (or (== (aget word 0) \J) (== word "CALL") (strings/HasPrefix word "LOOP") (== word "XBEGIN")))


^{:go/breaks [[4 99]] :go/end 100} (go/func jumpRISCV ^bool [^string word]
  (switch word
    (case ^{:go/breaks [11 22]} ["BEQ" "BEQZ" "BGE" "BGEU" "BGEZ" "BGT" "BGTU" "BGTZ" "BLE" "BLEU" "BLEZ"
        "BLT" "BLTU" "BLTZ" "BNE" "BNEZ" "CALL" "CBEQZ" "CBNEZ" "CJ" "CJALR" "CJR"
        "JAL" "JALR" "JMP"]
      (return true)))

  false)


^{:go/end 104} (go/func jumpWasm ^bool [^string word]
  (or (== word "JMP") (== word "CALL") (== word "Call") (== word "Br") (== word "BrIf")))


^{:go/end 198} (go/func archX86 ^{:tag (* Arch)} [^{:tag (* obj/LinkArch)} linkArch]
  (let [register (make (map string int16))]
    ;; Create maps for easy lookup of instruction names etc.
    (range [i s x86/Register]
      (aset register s (conv int16 (+ i x86/REG_AL))))

    ;; Pseudo-registers.
    (aset register "SB" RSB)
    (aset register "FP" RFP)
    (aset register "PC" RPC)
    (when (== linkArch (addr x86/Linkamd64))
      ;; Alias g to R14
      (aset register "g" x86/REGG))

    ;; Register prefix not used on this architecture.

    (let [instructions (make (map string obj/As))]
      (range [i s obj/Anames]
        (aset instructions s (conv obj/As i)))

      (range [i s x86/Anames]
        (when (>= (conv obj/As i) obj/A_ARCHSPECIFIC)
          (aset instructions s (+ (conv obj/As i) obj/ABaseAMD64))))


      ;; Annoying aliases.
      (aset instructions "JA" x86/AJHI) ; /* alternate */
      (aset instructions "JAE" x86/AJCC) ; /* alternate */
      (aset instructions "JB" x86/AJCS) ; /* alternate */
      (aset instructions "JBE" x86/AJLS) ; /* alternate */
      (aset instructions "JC" x86/AJCS) ; /* alternate */
      (aset instructions "JCC" x86/AJCC) ; /* carry clear (CF = 0) */
      (aset instructions "JCS" x86/AJCS) ; /* carry set (CF = 1) */
      (aset instructions "JE" x86/AJEQ) ; /* alternate */
      (aset instructions "JEQ" x86/AJEQ) ; /* equal (ZF = 1) */
      (aset instructions "JG" x86/AJGT) ; /* alternate */
      (aset instructions "JGE" x86/AJGE) ; /* greater than or equal (signed) (SF = OF) */
      (aset instructions "JGT" x86/AJGT) ; /* greater than (signed) (ZF = 0 && SF = OF) */
      (aset instructions "JHI" x86/AJHI) ; /* higher (unsigned) (CF = 0 && ZF = 0) */
      (aset instructions "JHS" x86/AJCC) ; /* alternate */
      (aset instructions "JL" x86/AJLT) ; /* alternate */
      (aset instructions "JLE" x86/AJLE) ; /* less than or equal (signed) (ZF = 1 || SF != OF) */
      (aset instructions "JLO" x86/AJCS) ; /* alternate */
      (aset instructions "JLS" x86/AJLS) ; /* lower or same (unsigned) (CF = 1 || ZF = 1) */
      (aset instructions "JLT" x86/AJLT) ; /* less than (signed) (SF != OF) */
      (aset instructions "JMI" x86/AJMI) ; /* negative (minus) (SF = 1) */
      (aset instructions "JNA" x86/AJLS) ; /* alternate */
      (aset instructions "JNAE" x86/AJCS) ; /* alternate */
      (aset instructions "JNB" x86/AJCC) ; /* alternate */
      (aset instructions "JNBE" x86/AJHI) ; /* alternate */
      (aset instructions "JNC" x86/AJCC) ; /* alternate */
      (aset instructions "JNE" x86/AJNE) ; /* not equal (ZF = 0) */
      (aset instructions "JNG" x86/AJLE) ; /* alternate */
      (aset instructions "JNGE" x86/AJLT) ; /* alternate */
      (aset instructions "JNL" x86/AJGE) ; /* alternate */
      (aset instructions "JNLE" x86/AJGT) ; /* alternate */
      (aset instructions "JNO" x86/AJOC) ; /* alternate */
      (aset instructions "JNP" x86/AJPC) ; /* alternate */
      (aset instructions "JNS" x86/AJPL) ; /* alternate */
      (aset instructions "JNZ" x86/AJNE) ; /* alternate */
      (aset instructions "JO" x86/AJOS) ; /* alternate */
      (aset instructions "JOC" x86/AJOC) ; /* overflow clear (OF = 0) */
      (aset instructions "JOS" x86/AJOS) ; /* overflow set (OF = 1) */
      (aset instructions "JP" x86/AJPS) ; /* alternate */
      (aset instructions "JPC" x86/AJPC) ; /* parity clear (PF = 0) */
      (aset instructions "JPE" x86/AJPS) ; /* alternate */
      (aset instructions "JPL" x86/AJPL) ; /* non-negative (plus) (SF = 0) */
      (aset instructions "JPO" x86/AJPC) ; /* alternate */
      (aset instructions "JPS" x86/AJPS) ; /* parity set (PF = 1) */
      (aset instructions "JS" x86/AJMI) ; /* alternate */
      (aset instructions "JZ" x86/AJEQ) ; /* alternate */
      (aset instructions "MASKMOVDQU" x86/AMASKMOVOU)
      (aset instructions "MOVD" x86/AMOVQ)
      (aset instructions "MOVDQ2Q" x86/AMOVQ)
      (aset instructions "MOVNTDQ" x86/AMOVNTO)
      (aset instructions "MOVOA" x86/AMOVO)
      (aset instructions "PSLLDQ" x86/APSLLO)
      (aset instructions "PSRLDQ" x86/APSRLO)
      (aset instructions "PADDD" x86/APADDL)
      ;; Spellings originally used in CL 97235.
      (aset instructions "MOVBELL" x86/AMOVBEL)
      (aset instructions "MOVBEQQ" x86/AMOVBEQ)
      (aset instructions "MOVBEWW" x86/AMOVBEW)

      (addr ^{:go/breaks [2 4 6 8 10 12]} (lit Arch
          :LinkArch linkArch
          :Instructions instructions
          :Register register
          :RegisterPrefix nil
          :RegisterNumber nilRegisterNumber
          :IsJump jumpX86)))))



^{:go/end 259} (go/func archArm ^{:tag (* Arch)} []
  (let [register (make (map string int16))]
    ;; Create maps for easy lookup of instruction names etc.
    ;; Note that there is no list of names as there is for x86.
    (for [i arm/REG_R0] (< i arm/REG_SPSR) (inc! i)
      (aset register (obj/Rconv i) (conv int16 i)))

    ;; Avoid unintentionally clobbering g using R10.
    (delete register "R10")
    (aset register "g" arm/REG_R10)
    (for [i 0] (< i 16) (inc! i)
      (aset register (fmt/Sprintf "C%d" i) (conv int16 i)))


    ;; Pseudo-registers.
    (aset register "SB" RSB)
    (aset register "FP" RFP)
    (aset register "PC" RPC)
    (aset register "SP" RSP)
    (let [registerPrefix (lit (map string bool)
          ^{:line 220} ["F" true]
          ^{:line 221} ["R" true])]


      ;; special operands for DMB/DSB instructions
      (aset register "MB_SY" arm/REG_MB_SY)
      (aset register "MB_ST" arm/REG_MB_ST)
      (aset register "MB_ISH" arm/REG_MB_ISH)
      (aset register "MB_ISHST" arm/REG_MB_ISHST)
      (aset register "MB_NSH" arm/REG_MB_NSH)
      (aset register "MB_NSHST" arm/REG_MB_NSHST)
      (aset register "MB_OSH" arm/REG_MB_OSH)
      (aset register "MB_OSHST" arm/REG_MB_OSHST)

      (let [instructions (make (map string obj/As))]
        (range [i s obj/Anames]
          (aset instructions s (conv obj/As i)))

        (range [i s arm/Anames]
          (when (>= (conv obj/As i) obj/A_ARCHSPECIFIC)
            (aset instructions s (+ (conv obj/As i) obj/ABaseARM))))


        ;; Annoying aliases.
        (aset instructions "B" obj/AJMP)
        (aset instructions "BL" obj/ACALL)
        ;; MCR differs from MRC by the way fields of the word are encoded.
        ;; (Details in arm.go). Here we add the instruction so parse will find
        ;; it, but give it an opcode number known only to us.
        (aset instructions "MCR" aMCR)

        (addr ^{:go/breaks [2 4 6 8 10 12]} (lit Arch
            :LinkArch (addr arm/Linkarm)
            :Instructions instructions
            :Register register
            :RegisterPrefix registerPrefix
            :RegisterNumber armRegisterNumber
            :IsJump jumpArm))))))



^{:go/end 334} (go/func archArm64 ^{:tag (* Arch)} []
  (let [register (make (map string int16))]
    ;; Create maps for easy lookup of instruction names etc.
    ;; Note that there is no list of names as there is for 386 and amd64.
    (aset register (obj/Rconv arm64/REGSP) (conv int16 arm64/REGSP))
    (for [i arm64/REG_R0] (<= i arm64/REG_R31) (inc! i)
      (aset register (obj/Rconv i) (conv int16 i)))

    ;; Rename R18 to R18_PLATFORM to avoid accidental use.
    (aset register "R18_PLATFORM" (aget register "R18"))
    (delete register "R18")
    (for [i arm64/REG_F0] (<= i arm64/REG_F31) (inc! i)
      (aset register (obj/Rconv i) (conv int16 i)))

    (for [i arm64/REG_V0] (<= i arm64/REG_V31) (inc! i)
      (aset register (obj/Rconv i) (conv int16 i)))

    (for [i arm64/REG_Z0] (<= i arm64/REG_Z31) (inc! i)
      (aset register (obj/Rconv i) (conv int16 i)))

    (for [i arm64/REG_P0] (<= i arm64/REG_P15) (inc! i)
      (aset register (obj/Rconv i) (conv int16 i)))

    (for [i arm64/REG_PN0] (<= i arm64/REG_PN15) (inc! i)
      (aset register (obj/Rconv i) (conv int16 i)))


    ;; System registers.
    (for [i 0] (< i (len arm64/SystemReg)) (inc! i)
      (aset register (.-Name (aget arm64/SystemReg i)) (.-Reg (aget arm64/SystemReg i))))


    (aset register "LR" arm64/REGLINK)

    ;; Pseudo-registers.
    (aset register "SB" RSB)
    (aset register "FP" RFP)
    (aset register "PC" RPC)
    (aset register "SP" RSP)
    ;; Avoid unintentionally clobbering g using R28.
    (delete register "R28")
    (aset register "g" arm64/REG_R28)
    (let [registerPrefix (lit (map string bool)
          ^{:line 304} ["F" true]
          ^{:line 305} ["R" true]
          ^{:line 306} ["V" true]
          ^{:line 307} ["Z" true]
          ^{:line 308} ["P" true]
          ^{:line 309} ["PN" true])


        ^{:line 312} instructions (make (map string obj/As))]
      (range [i s obj/Anames]
        (aset instructions s (conv obj/As i)))

      (range [i s arm64/Anames]
        (when (>= (conv obj/As i) obj/A_ARCHSPECIFIC)
          (aset instructions s (+ (conv obj/As i) obj/ABaseARM64))))


      ;; Annoying aliases.
      (aset instructions "B" arm64/AB)
      (aset instructions "BL" arm64/ABL)

      (addr ^{:go/breaks [2 4 6 8 10 12]} (lit Arch

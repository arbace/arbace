;; This file encapsulates some of the odd characteristics of the
;; MIPS (MIPS64) instruction set, to minimize its interaction
;; with the core of the assembler.

(in-ns 'go.cmd.asm.internal.arch) (go/file "mips.go" :imports [


    ^{:line 12} [obj "cmd/internal/obj"]
    ^{:line 13} [mips "cmd/internal/obj/mips"]])


^{:go/breaks [[4 21]] :go/end 22} (go/func jumpMIPS ^bool [^string word]
  (switch word
    (case ["BEQ" "BFPF" "BFPT" "BGEZ" "BGEZAL" "BGTZ" "BLEZ" "BLTZ" "BLTZAL" "BNE" "JMP" "JAL" "CALL"]
      (return true)))

  false)




^{:go/breaks [[5 32]] :go/end 33} (go/func IsMIPSCMP "IsMIPSCMP reports whether the op (as defined by an mips.A* constant) is\none of the CMP instructions that require special handling.\n" ^bool [^obj/As op]
  (switch op
    (case [mips/ACMPEQF mips/ACMPEQD mips/ACMPGEF mips/ACMPGED
        ^{:line 29} mips/ACMPGTF mips/ACMPGTD]
      (return true)))

  false)




^{:go/breaks [[5 45]] :go/end 46} (go/func IsMIPSMUL "IsMIPSMUL reports whether the op (as defined by an mips.A* constant) is\none of the MUL/DIV/REM/MADD/MSUB instructions that require special handling.\n" ^bool [^obj/As op]
  (switch op
    (case [mips/AMUL mips/AMULU mips/AMULV mips/AMULVU
        ^{:line 40} mips/ADIV mips/ADIVU mips/ADIVV mips/ADIVVU
        ^{:line 41} mips/AREM mips/AREMU mips/AREMV mips/AREMVU
        ^{:line 42} mips/AMADD mips/AMSUB]
      (return true)))

  false)


^{:go/end 72} (go/func mipsRegisterNumber [^string name ^int16 n] :results [int16 bool]
  (switch name
    (case ["F"]
      (when (and (<= 0 n) (<= n 31))
        (return (+ mips/REG_F0 n) true)))

    (case ["FCR"]
      (when (and (<= 0 n) (<= n 31))
        (return (+ mips/REG_FCR0 n) true)))

    (case ["M"]
      (when (and (<= 0 n) (<= n 31))
        (return (+ mips/REG_M0 n) true)))

    (case ["R"]
      (when (and (<= 0 n) (<= n 31))
        (return (+ mips/REG_R0 n) true)))

    (case ["W"]
      (when (and (<= 0 n) (<= n 31))
        (return (+ mips/REG_W0 n) true))))


  (return 0 false))

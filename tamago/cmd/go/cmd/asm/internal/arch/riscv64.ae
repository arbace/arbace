;; This file encapsulates some of the odd characteristics of the RISCV64
;; instruction set, to minimize its interaction with the core of the
;; assembler.

(in-ns 'go.cmd.asm.internal.arch) (go/file "riscv64.go" :imports [


    ^{:line 12} [obj "cmd/internal/obj"]
    ^{:line 13} [riscv "cmd/internal/obj/riscv"]
    ^{:line 14} [fmt "fmt"]])




^{:go/breaks [[5 27]] :go/end 28} (go/func IsRISCV64AMO "IsRISCV64AMO reports whether op is an AMO instruction that requires\nspecial handling.\n" ^bool [^obj/As op]
  (switch op
    (case [riscv/ASCW riscv/ASCD riscv/AAMOSWAPW riscv/AAMOSWAPD riscv/AAMOADDW riscv/AAMOADDD
        ^{:line 22} riscv/AAMOANDW riscv/AAMOANDD riscv/AAMOORW riscv/AAMOORD riscv/AAMOXORW riscv/AAMOXORD
        ^{:line 23} riscv/AAMOMINW riscv/AAMOMIND riscv/AAMOMINUW riscv/AAMOMINUD
        ^{:line 24} riscv/AAMOMAXW riscv/AAMOMAXD riscv/AAMOMAXUW riscv/AAMOMAXUD]
      (return true)))

  false)




^{:go/end 34} (go/func IsRISCV64VTypeI "IsRISCV64VTypeI reports whether op is a vtype immediate instruction that\nrequires special handling.\n" ^bool [^obj/As op]
  (or (== op riscv/AVSETVLI) (== op riscv/AVSETIVLI)))





^{:go/end 48} (go/func IsRISCV64CSRO "IsRISCV64CSRO reports whether the op is an instruction that uses\nCSR symbolic names and whether that instruction expects a register\nor an immediate source operand.\n" [^obj/As op] :results [^bool imm ^bool ok]
  (switch op
    (case [riscv/ACSRRCI riscv/ACSRRSI riscv/ACSRRWI]
      (set! imm true)
      (fallthrough))
    (case [riscv/ACSRRC riscv/ACSRRS riscv/ACSRRW]
      (set! ok true)))

  (return))






^{:go/end 64} (go/func IsRISCV64PseudoCSRO "IsRISCV64PseudoCSRO reports whether the op is a pseudo instruction\nthat uses CSR symbolic names, whether that instruction expects a register\nor an immediate source operand and what the expected index of the operand\ncontaining the CSR name should be.\n" [^obj/As op] :results [^bool imm ^int index ^bool ok]
  (switch op
    (case [riscv/ACSRCI riscv/ACSRSI riscv/ACSRWI]
      (set! (values imm index ok) (values true 1 true)))
    (case [riscv/ACSRC riscv/ACSRS riscv/ACSRW]
      (set! (values imm index ok) (values false 1 true)))
    (case [riscv/ACSRR]
      (set! (values imm index ok) (values false 0 true))))

  (return))


(go/var ^{:tag (map string riscv/SpecialOperand)} riscv64SpecialOperand)


^{:go/end 97} (go/func RISCV64SpecialOperand "RISCV64SpecialOperand returns the internal representation of a special operand.\n" ^riscv/SpecialOperand [^string name]
  (when (== riscv64SpecialOperand nil)
    ;; Generate mapping when function is first called.
    (set! riscv64SpecialOperand (lit (map string riscv/SpecialOperand)))
    (for [opd riscv/SPOP_RVV_BEGIN] (< opd riscv/SPOP_RVV_END) (inc! opd)
      (aset riscv64SpecialOperand (.String opd) opd))

    ;; Add the CSRs
    (range [csrCode csrName riscv/CSRs]
      ;; The set of RVV special operand names and the set of CSR special operands
      ;; names are disjoint and so can safely share a single namespace. However,
      ;; it's possible that a future update to the CSRs in inst.go could introduce
      ;; a conflict. This check ensures that such a conflict does not go
      ;; unnoticed.
      (when [(values _ ok) (aget riscv64SpecialOperand csrName)] ok
        (panic (fmt/Sprintf "riscv64 special operand %q redefined" csrName)))

      (aset riscv64SpecialOperand csrName (conv riscv/SpecialOperand (+ (conv int csrCode) (conv int riscv/SPOP_CSR_BEGIN)))))

    ;; Add the FENCE operands
    (for [opd (+ riscv/SPOP_FENCE_BEGIN 1)] (< opd riscv/SPOP_FENCE_END) (inc! opd)
      (aset riscv64SpecialOperand (.String opd) opd)))


  (when [(values opd ok) (aget riscv64SpecialOperand name)] ok
    (return opd))

  ^{:line 96} riscv/SPOP_END)




^{:go/end 104} (go/func RISCV64ValidateVectorType "RISCV64ValidateVectorType reports whether the given configuration is a\nvalid vector type.\n" ^error [^int64 vsew ^int64 vlmul ^int64 vtail ^int64 vmask]
  (let [(values _ err) (riscv/EncodeVectorType vsew vlmul vtail vmask)]
    ^{:line 103} err))

;; This file encapsulates some of the odd characteristics of the
;; Loong64 (LoongArch64) instruction set, to minimize its interaction
;; with the core of the assembler.

(in-ns 'go.cmd.asm.internal.arch) (go/file "loong64.go" :imports [


    ^{:line 12} [obj "cmd/internal/obj"]
    ^{:line 13} [loong64 "cmd/internal/obj/loong64"]
    ^{:line 14} [errors "errors"]
    ^{:line 15} [fmt "fmt"]])


^{:go/breaks [[4 23]] :go/end 24} (go/func jumpLoong64 ^bool [^string word]
  (switch word
    (case ["BEQ" "BFPF" "BFPT" "BLTZ" "BGEZ" "BLEZ" "BGTZ" "BLT" "BLTU" "JIRL" "BNE" "BGE" "BGEU" "JMP" "JAL" "CALL"]
      (return true)))

  false)





^{:go/breaks [[5 34]] :go/end 35} (go/func IsLoong64RDTIME "IsLoong64RDTIME reports whether the op (as defined by an loong64.A*\nconstant) is one of the RDTIMELW/RDTIMEHW/RDTIMED instructions that\nrequire special handling.\n" ^bool [^obj/As op]
  (switch op
    (case [loong64/ARDTIMELW loong64/ARDTIMEHW loong64/ARDTIMED]
      (return true)))

  false)


^{:go/breaks [[4 42]] :go/end 43} (go/func IsLoong64PRELD ^bool [^obj/As op]
  (switch op
    (case [loong64/APRELD loong64/APRELDX]
      (return true)))

  false)


^{:go/end 47} (go/func IsLoong64AMO ^bool [^obj/As op]
  (loong64/IsAtomicInst op))


(go/var loong64ElemExtMap (lit (map string int16)
    ^{:line 50} ["B" loong64/ARNG_B]
    ^{:line 51} ["H" loong64/ARNG_H]
    ^{:line 52} ["W" loong64/ARNG_W]
    ^{:line 53} ["V" loong64/ARNG_V]
    ^{:line 54} ["BU" loong64/ARNG_BU]
    ^{:line 55} ["HU" loong64/ARNG_HU]
    ^{:line 56} ["WU" loong64/ARNG_WU]
    ^{:line 57} ["VU" loong64/ARNG_VU]))


(go/var loong64LsxArngExtMap (lit (map string int16)
    ^{:line 61} ["B16" loong64/ARNG_16B]
    ^{:line 62} ["H8" loong64/ARNG_8H]
    ^{:line 63} ["W4" loong64/ARNG_4W]
    ^{:line 64} ["V2" loong64/ARNG_2V]))


(go/var loong64LasxArngExtMap (lit (map string int16)
    ^{:line 68} ["B32" loong64/ARNG_32B]
    ^{:line 69} ["H16" loong64/ARNG_16H]
    ^{:line 70} ["W8" loong64/ARNG_8W]
    ^{:line 71} ["V4" loong64/ARNG_4V]
    ^{:line 72} ["Q2" loong64/ARNG_2Q]))



^{:go/end 126} (go/func Loong64RegisterExtension "Loong64RegisterExtension constructs an Loong64 register with extension or arrangement.\n" ^error [^{:tag (* obj/Addr)} a ^string ext ^int16 reg ^int16 num ^bool isAmount ^bool isIndex]
  ^{:go/breaks [[4 125]]} (let [^bool ok (zero bool)
      ^{:line 78 :tag int16} arngType (zero int16)
      ^{:line 79 :tag int16} simdType (zero int16)
      ^{:line 80 :tag int16} simdReg (zero int16)]

    (switch
      (case [(and (>= reg loong64/REG_V0) (<= reg loong64/REG_V31))]
        (set! simdType loong64/LSX)
        (set! simdReg (- reg loong64/REG_V0)))
      (case [(and (>= reg loong64/REG_X0) (<= reg loong64/REG_X31))]
        (set! simdType loong64/LASX)
        (set! simdReg (- reg loong64/REG_X0)))
      (default
        (return (errors/New (+ "Loong64 extension: invalid LSX/LASX register: " (fmt/Sprintf "%d" reg))))))


    (if isIndex (do
        (set! (values arngType ok) (aget loong64ElemExtMap ext))
        (when (not ok)
          (return (errors/New (+ "Loong64 extension: invalid LSX/LASX arrangement type: " ext))))


        (set! (.-Reg a) loong64/REG_ELEM)
        (set! (.-Reg a) + (<< (bit-and simdReg loong64/EXT_REG_MASK) loong64/EXT_REG_SHIFT))
        (set! (.-Reg a) + (<< (bit-and arngType loong64/EXT_TYPE_MASK) loong64/EXT_TYPE_SHIFT))
        (set! (.-Reg a) + (<< (bit-and simdType loong64/EXT_SIMDTYPE_MASK) loong64/EXT_SIMDTYPE_SHIFT))
        (set! (.-Index a) num))
      (do
        (switch simdType
          (case [loong64/LSX]
            (set! (values arngType ok) (aget loong64LsxArngExtMap ext))
            (when (not ok)
              (return (errors/New (+ "Loong64 extension: invalid LSX arrangement type: " ext)))))


          (case [loong64/LASX]
            (set! (values arngType ok) (aget loong64LasxArngExtMap ext))
            (when (not ok)
              (return (errors/New (+ "Loong64 extension: invalid LASX arrangement type: " ext))))))



        (set! (.-Reg a) loong64/REG_ARNG)
        (set! (.-Reg a) + (<< (bit-and simdReg loong64/EXT_REG_MASK) loong64/EXT_REG_SHIFT))
        (set! (.-Reg a) + (<< (bit-and arngType loong64/EXT_TYPE_MASK) loong64/EXT_TYPE_SHIFT))
        (set! (.-Reg a) + (<< (bit-and simdType loong64/EXT_SIMDTYPE_MASK) loong64/EXT_SIMDTYPE_SHIFT))))


    nil))


^{:go/end 156} (go/func loong64RegisterNumber [^string name ^int16 n] :results [int16 bool]
  (switch name
    (case ["F"]
      (when (and (<= 0 n) (<= n 31))
        (return (+ loong64/REG_F0 n) true)))

    (case ["FCSR"]
      (when (and (<= 0 n) (<= n 31))
        (return (+ loong64/REG_FCSR0 n) true)))

    (case ["FCC"]
      (when (and (<= 0 n) (<= n 31))
        (return (+ loong64/REG_FCC0 n) true)))

    (case ["R"]
      (when (and (<= 0 n) (<= n 31))
        (return (+ loong64/REG_R0 n) true)))

    (case ["V"]
      (when (and (<= 0 n) (<= n 31))
        (return (+ loong64/REG_V0 n) true)))

    (case ["X"]
      (when (and (<= 0 n) (<= n 31))
        (return (+ loong64/REG_X0 n) true))))


  (return 0 false))

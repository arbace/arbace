;; This file encapsulates some of the odd characteristics of the
;; 64-bit PowerPC (PPC64) instruction set, to minimize its interaction
;; with the core of the assembler.

(in-ns 'go.cmd.asm.internal.arch) (go/file "ppc64.go" :imports [


    ^{:line 12} [obj "cmd/internal/obj"]
    ^{:line 13} [ppc64 "cmd/internal/obj/ppc64"]])


^{:go/breaks [[4 21]] :go/end 22} (go/func jumpPPC64 ^bool [^string word]
  (switch word
    (case ["BC" "BCL" "BEQ" "BGE" "BGT" "BL" "BLE" "BLT" "BNE" "BR" "BVC" "BVS" "BDNZ" "BDZ" "CALL" "JMP"]
      (return true)))

  false)




^{:go/breaks [[5 31]] :go/end 32} (go/func IsPPC64CMP "IsPPC64CMP reports whether the op (as defined by an ppc64.A* constant) is\none of the CMP instructions that require special handling.\n" ^bool [^obj/As op]
  (switch op
    (case [ppc64/ACMP ppc64/ACMPU ppc64/ACMPW ppc64/ACMPWU ppc64/AFCMPO ppc64/AFCMPU ppc64/ADCMPO ppc64/ADCMPU ppc64/ADCMPOQ ppc64/ADCMPUQ]
      (return true)))

  false)




^{:go/breaks [[5 49]] :go/end 50} (go/func IsPPC64NEG "IsPPC64NEG reports whether the op (as defined by an ppc64.A* constant) is\none of the NEG-like instructions that require special handling.\n" ^bool [^obj/As op]
  (switch op
    (case [ppc64/AADDMECC ppc64/AADDMEVCC ppc64/AADDMEV ppc64/AADDME
        ^{:line 39} ppc64/AADDZECC ppc64/AADDZEVCC ppc64/AADDZEV ppc64/AADDZE
        ^{:line 40} ppc64/ACNTLZDCC ppc64/ACNTLZD ppc64/ACNTLZWCC ppc64/ACNTLZW
        ^{:line 41} ppc64/AEXTSBCC ppc64/AEXTSB ppc64/AEXTSHCC ppc64/AEXTSH
        ^{:line 42} ppc64/AEXTSWCC ppc64/AEXTSW ppc64/ANEGCC ppc64/ANEGVCC
        ^{:line 43} ppc64/ANEGV ppc64/ANEG ppc64/ASLBMFEE ppc64/ASLBMFEV
        ^{:line 44} ppc64/ASLBMTE ppc64/ASUBMECC ppc64/ASUBMEVCC ppc64/ASUBMEV
        ^{:line 45} ppc64/ASUBME ppc64/ASUBZECC ppc64/ASUBZEVCC ppc64/ASUBZEV
        ^{:line 46} ppc64/ASUBZE]
      (return true)))

  false)


^{:go/end 84} (go/func ppc64RegisterNumber [^string name ^int16 n] :results [int16 bool]
  (switch name
    (case ["CR"]
      (when (and (<= 0 n) (<= n 7))
        (return (+ ppc64/REG_CR0 n) true)))

    (case ["A"]
      (when (and (<= 0 n) (<= n 8))
        (return (+ ppc64/REG_A0 n) true)))

    (case ["VS"]
      (when (and (<= 0 n) (<= n 63))
        (return (+ ppc64/REG_VS0 n) true)))

    (case ["V"]
      (when (and (<= 0 n) (<= n 31))
        (return (+ ppc64/REG_V0 n) true)))

    (case ["F"]
      (when (and (<= 0 n) (<= n 31))
        (return (+ ppc64/REG_F0 n) true)))

    (case ["R"]
      (when (and (<= 0 n) (<= n 31))
        (return (+ ppc64/REG_R0 n) true)))

    (case ["SPR"]
      (when (and (<= 0 n) (<= n 1024))
        (return (+ ppc64/REG_SPR0 n) true))))


  (return 0 false))

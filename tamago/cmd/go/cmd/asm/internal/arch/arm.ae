;; This file encapsulates some of the odd characteristics of the ARM
;; instruction set, to minimize its interaction with the core of the
;; assembler.

(in-ns 'go.cmd.asm.internal.arch) (go/file "arm.go" :imports [


    ^{:line 12} [strings "strings"]

    ^{:line 14} [obj "cmd/internal/obj"]
    ^{:line 15} [arm "cmd/internal/obj/arm"]])


(go/var armLS (lit (map string uint8)
    ^{:line 19} ["U" arm/C_UBIT]
    ^{:line 20} ["S" arm/C_SBIT]
    ^{:line 21} ["W" arm/C_WBIT]
    ^{:line 22} ["P" arm/C_PBIT]
    ^{:line 23} ["PW" (bit-or arm/C_WBIT arm/C_PBIT)]
    ^{:line 24} ["WP" (bit-or arm/C_WBIT arm/C_PBIT)]))


(go/var armSCOND (lit (map string uint8)
    ^{:line 28} ["EQ" arm/C_SCOND_EQ]
    ^{:line 29} ["NE" arm/C_SCOND_NE]
    ^{:line 30} ["CS" arm/C_SCOND_HS]
    ^{:line 31} ["HS" arm/C_SCOND_HS]
    ^{:line 32} ["CC" arm/C_SCOND_LO]
    ^{:line 33} ["LO" arm/C_SCOND_LO]
    ^{:line 34} ["MI" arm/C_SCOND_MI]
    ^{:line 35} ["PL" arm/C_SCOND_PL]
    ^{:line 36} ["VS" arm/C_SCOND_VS]
    ^{:line 37} ["VC" arm/C_SCOND_VC]
    ^{:line 38} ["HI" arm/C_SCOND_HI]
    ^{:line 39} ["LS" arm/C_SCOND_LS]
    ^{:line 40} ["GE" arm/C_SCOND_GE]
    ^{:line 41} ["LT" arm/C_SCOND_LT]
    ^{:line 42} ["GT" arm/C_SCOND_GT]
    ^{:line 43} ["LE" arm/C_SCOND_LE]
    ^{:line 44} ["AL" arm/C_SCOND_NONE]
    ^{:line 45} ["U" arm/C_UBIT]
    ^{:line 46} ["S" arm/C_SBIT]
    ^{:line 47} ["W" arm/C_WBIT]
    ^{:line 48} ["P" arm/C_PBIT]
    ^{:line 49} ["PW" (bit-or arm/C_WBIT arm/C_PBIT)]
    ^{:line 50} ["WP" (bit-or arm/C_WBIT arm/C_PBIT)]
    ^{:line 51} ["F" arm/C_FBIT]
    ^{:line 52} ["IBW" (bit-or arm/C_WBIT arm/C_PBIT arm/C_UBIT)]
    ^{:line 53} ["IAW" (bit-or arm/C_WBIT arm/C_UBIT)]
    ^{:line 54} ["DBW" (bit-or arm/C_WBIT arm/C_PBIT)]
    ^{:line 55} ["DAW" arm/C_WBIT]
    ^{:line 56} ["IB" (bit-or arm/C_PBIT arm/C_UBIT)]
    ^{:line 57} ["IA" arm/C_UBIT]
    ^{:line 58} ["DB" arm/C_PBIT]
    ^{:line 59} ["DA" 0]))


(go/var armJump (lit (map string bool)
    ^{:line 63} ["B" true]
    ^{:line 64} ["BL" true]
    ^{:line 65} ["BX" true]
    ^{:line 66} ["BEQ" true]
    ^{:line 67} ["BNE" true]
    ^{:line 68} ["BCS" true]
    ^{:line 69} ["BHS" true]
    ^{:line 70} ["BCC" true]
    ^{:line 71} ["BLO" true]
    ^{:line 72} ["BMI" true]
    ^{:line 73} ["BPL" true]
    ^{:line 74} ["BVS" true]
    ^{:line 75} ["BVC" true]
    ^{:line 76} ["BHI" true]
    ^{:line 77} ["BLS" true]
    ^{:line 78} ["BGE" true]
    ^{:line 79} ["BLT" true]
    ^{:line 80} ["BGT" true]
    ^{:line 81} ["BLE" true]
    ^{:line 82} ["CALL" true]
    ^{:line 83} ["JMP" true]))


^{:go/end 88} (go/func jumpArm ^bool [^string word]
  (aget armJump word))




^{:go/breaks [[5 97]] :go/end 98} (go/func IsARMCMP "IsARMCMP reports whether the op (as defined by an arm.A* constant) is\none of the comparison instructions that require special handling.\n" ^bool [^obj/As op]
  (switch op
    (case [arm/ACMN arm/ACMP arm/ATEQ arm/ATST]
      (return true)))

  false)




^{:go/breaks [[5 107]] :go/end 108} (go/func IsARMSTREX "IsARMSTREX reports whether the op (as defined by an arm.A* constant) is\none of the STREX-like instructions that require special handling.\n" ^bool [^obj/As op]
  (switch op
    (case [arm/ASTREX arm/ASTREXD arm/ASTREXB arm/ASWPW arm/ASWPBU]
      (return true)))

  false)





(go/const ^{:val 4249 :doc "MCR is not defined by the obj/arm; instead we define it privately here.\nIt is encoded as an MRC with a bit inside the instruction word,\npassed to arch.ARMMRCOffset.\n"} aMCR (+ arm/ALAST 1))



^{:go/breaks [[5 122]] :go/end 123} (go/func IsARMMRC "IsARMMRC reports whether the op (as defined by an arm.A* constant) is\nMRC or MCR.\n" ^bool [^obj/As op]
  (switch op
    (case [arm/AMRC aMCR] ; Note: aMCR is defined in this package.
      (return true)))

  false)




^{:go/breaks [[5 132]] :go/end 133} (go/func IsARMBFX "IsARMBFX reports whether the op (as defined by an arm.A* constant) is one the\nBFX-like instructions which are in the form of \"op $width, $LSB, (Reg,) Reg\".\n" ^bool [^obj/As op]
  (switch op
    (case [arm/ABFX arm/ABFXU arm/ABFC arm/ABFI]
      (return true)))

  false)



^{:go/breaks [[5 141]] :go/end 142} (go/func IsARMFloatCmp "IsARMFloatCmp reports whether the op is a floating comparison instruction.\n" ^bool [^obj/As op]
  (switch op
    (case [arm/ACMPF arm/ACMPD]
      (return true)))

  false)






^{:go/end 168} (go/func ARMMRCOffset "ARMMRCOffset implements the peculiar encoding of the MRC and MCR instructions.\nThe difference between MRC and MCR is represented by a bit high in the word, not\nin the usual way by the opcode itself. Asm must use AMRC for both instructions, so\nwe return the opcode for MRC so that asm doesn't need to import obj/arm.\n" [^obj/As op ^string cond ^int64 x0 ^int64 x1 ^int64 x2 ^int64 x3 ^int64 x4 ^int64 x5] :results [^int64 offset ^obj/As op0 ^bool ok]
  (let [op1 (conv int64 0)]
    (when (== op arm/AMRC)
      (set! op1 1))

    (let [(values bits ^:assign ok) (ParseARMCondition cond)]
      (when (not ok)
        (return))

      (set! offset (bit-or (<< 0xe 24) ; opcode
          (<< op1 20) ; MCR/MRC
          (<< (bit-xor (conv int64 bits) arm/C_SCOND_XOR) 28) ; scond
          (<< (bit-and x0 15) 8) ;coprocessor number
          (<< (bit-and x1 7) 21) ; coprocessor operation
          (<< (bit-and x2 15) 12) ; ARM register
          (<< (bit-and x3 15) 16) ; Crn
          (<< (bit-and x4 15) 0) ; Crm
          (<< (bit-and x5 7) 5) ; coprocessor information
          (<< 1 4))) ; /* must be set */
      (return offset arm/AMRC true))))




^{:go/breaks [[5 177]] :go/end 178} (go/func IsARMMULA "IsARMMULA reports whether the op (as defined by an arm.A* constant) is\nMULA, MULS, MMULA, MMULS, MULABB, MULAWB or MULAWT, the 4-operand instructions.\n" ^bool [^obj/As op]
  (switch op
    (case [arm/AMULA arm/AMULS arm/AMMULA arm/AMMULS arm/AMULABB arm/AMULAWB arm/AMULAWT]
      (return true)))

  false)


(go/var bcode (lit (slice obj/As)
    ^{:line 181} arm/ABEQ
    ^{:line 182} arm/ABNE
    ^{:line 183} arm/ABCS
    ^{:line 184} arm/ABCC
    ^{:line 185} arm/ABMI
    ^{:line 186} arm/ABPL
    ^{:line 187} arm/ABVS
    ^{:line 188} arm/ABVC
    ^{:line 189} arm/ABHI
    ^{:line 190} arm/ABLS
    ^{:line 191} arm/ABGE
    ^{:line 192} arm/ABLT
    ^{:line 193} arm/ABGT
    ^{:line 194} arm/ABLE
    ^{:line 195} arm/AB
    ^{:line 196} obj/ANOP))




^{:go/end 216} (go/func ARMConditionCodes "ARMConditionCodes handles the special condition code situation for the ARM.\nIt returns a boolean to indicate success; failure means cond was unrecognized.\n" ^bool [^{:tag (* obj/Prog)} prog ^string cond]
  (when (== cond "")
    (return true))

  ^{:go/breaks [5]} (let [(values bits ok) (ParseARMCondition cond)]
    (when (not ok)
      (return false))

    ;; /* hack to make B.NE etc. work: turn it into the corresponding conditional */
    (when (== (.-As prog) arm/AB)
      (set! (.-As prog) (aget bcode (bit-and (bit-xor bits arm/C_SCOND_XOR) 0xf)))
      (set! bits (bit-or (bit-and-not bits 0xf) arm/C_SCOND_NONE)))

    (set! (.-Scond prog) bits)
    true))





^{:go/end 223} (go/func ParseARMCondition "ParseARMCondition parses the conditions attached to an ARM instruction.\nThe input is a single string consisting of period-separated condition\ncodes, such as \".P.W\". An initial period is ignored.\n" [^string cond] :results [uint8 bool]
  (parseARMCondition cond armLS armSCOND))


^{:go/end 244} (go/func parseARMCondition [^string cond ^{:tag (map string uint8)} ls ^{:tag (map string uint8)} scond] :results [uint8 bool]
  (set! cond (strings/TrimPrefix cond "."))
  (when (== cond "")
    (return arm/C_SCOND_NONE true))

  (let [names (strings/Split cond ".")
      ^{:line 231} bits (conv uint8 0)]
    (range [_ name names]
      (when [(values b present) (aget ls name)] present
        (set! bits bit-or b)
        (continue))

      (when [(values b present) (aget scond name)] present
        (set! bits (bit-or (bit-and-not bits arm/C_SCOND) b))
        (continue))

      (return 0 false))

    (return bits true)))


^{:go/end 257} (go/func armRegisterNumber [^string name ^int16 n] :results [int16 bool]
  (when (or (< n 0) (< 15 n))
    (return 0 false))

  (switch name
    (case ["R"]
      (return (+ arm/REG_R0 n) true))
    (case ["F"]
      (return (+ arm/REG_F0 n) true)))

  (return 0 false))

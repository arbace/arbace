;; Package asm implements the parser and instruction generator for the assembler.
;; TODO: Split apart?
(in-ns 'go.cmd.asm.internal.asm) (go/file "parse.go" :doc "Package asm implements the parser and instruction generator for the assembler.\nTODO: Split apart?\n" :imports [


    ^{:line 10} [fmt "fmt"]
    ^{:line 11} [io "io"]
    ^{:line 12} [log "log"]
    ^{:line 13} [os "os"]
    ^{:line 14} [strconv "strconv"]
    ^{:line 15} [strings "strings"]
    ^{:line 16} [scanner "text/scanner"]
    ^{:line 17} [utf8 "unicode/utf8"]

    ^{:line 19} [arch "cmd/asm/internal/arch"]
    ^{:line 20} [flags "cmd/asm/internal/flags"]
    ^{:line 21} [lex "cmd/asm/internal/lex"]
    ^{:line 22} [obj "cmd/internal/obj"]
    ^{:line 23} [arm64 "cmd/internal/obj/arm64"]
    ^{:line 24} [riscv "cmd/internal/obj/riscv"]
    ^{:line 25} [x86 "cmd/internal/obj/x86"]
    ^{:line 26} [objabi "cmd/internal/objabi"]
    ^{:line 27} [src "cmd/internal/src"]
    ^{:line 28} [sys "cmd/internal/sys"]])


(go/type Parser (struct
    ^{:line 32 :tag lex/TokenReader} lex
    ^{:line 33 :tag int} lineNum ; Line number in source file.
    ^{:line 34 :tag int} errorLine ; Line number of last error.
    ^{:line 35 :tag int} errorCount ; Number of errors.
    ^{:line 36 :tag bool} sawCode ; saw code in this file (as opposed to comments and blank lines)
    ^{:line 37 :tag int64} pc ; virtual PC; count of Progs; doesn't advance for GLOBL or DATA.
    ^{:line 38 :tag (slice lex/Token)} input
    ^{:line 39 :tag int} inputPos
    ^{:line 40 :tag (slice string)} pendingLabels ; Labels to attach to next instruction.
    ^{:line 41 :tag (map string (* obj/Prog))} labels
    ^{:line 42 :tag (slice Patch)} toPatch
    ^{:line 43 :tag (slice obj/Addr)} addr
    ^{:line 44 :tag (* arch/Arch)} arch
    ^{:line 45 :tag (* obj/Link)} ctxt
    ^{:line 46 :tag (* obj/Prog)} firstProg
    ^{:line 47 :tag (* obj/Prog)} lastProg
    ^{:line 48 :tag (map string int64)} dataAddr ; Most recent address for DATA for this symbol.
    ^{:line 49 :tag bool} isJump ; Instruction being assembled is a jump.
    ^{:line 50 :tag bool} allowABI ; Whether ABI selectors are allowed.
    ^{:line 51 :tag string} pkgPrefix ; Prefix to add to local symbols.
    ^{:line 52 :tag io/Writer} errorWriter))


(go/type Patch (struct
    ^{:line 56 :tag (* obj/Addr)} addr
    ^{:line 57 :tag string} label))


^{:go/end 75} (go/func NewParser ^{:tag (* Parser)} [^{:tag (* obj/Link)} ctxt ^{:tag (* arch/Arch)} ar ^lex/TokenReader lexer]
  (let [pkgPrefix obj/UnlinkablePkg]
    (when (!= ctxt nil)
      (set! pkgPrefix (objabi/PathToPrefix (.-Pkgpath ctxt))))

    (addr ^{:go/breaks [2 4 6 8 10 12 14 16]} (lit Parser
        :ctxt ctxt
        :arch ar
        :lex lexer
        :labels (make (map string (* obj/Prog)))
        :dataAddr (make (map string int64))
        :errorWriter os/Stderr
        :allowABI (and (!= ctxt nil) (.-AllowAsmABI (objabi/LookupPkgSpecial (.-Pkgpath ctxt))))
        :pkgPrefix pkgPrefix))))





(go/var ^{:tag bool :doc "panicOnError is enabled when testing to abort execution on the first error\nand turn it into a recoverable panic.\n"} panicOnError)

^{:go/end 100} (go/method errorf [^{:tag (* Parser)} p ^string format & ^{:tag (slice any)} args]
  (when panicOnError
    (panic (fmt/Errorf format (spread args))))

  (when (== (.-lineNum p) (.-errorLine p))
    ;; Only one error per line.
    (return))

  (set! (.-errorLine p) (.-lineNum p))
  (when (!= (.-lex p) nil)
    ;; Put file and line information on head of message.
    (set! format (+ "%s:%d: " format "\n"))
    (set! args (append (lit (slice any) (.File (.-lex p)) (.-lineNum p)) (spread args))))

  (fmt/Fprintf (.-errorWriter p) format (spread args))
  (inc! (.-errorCount p))
  (when (and (> (.-errorCount p) 10) (not @flags/AllErrors))
    (log/Fatal "too many errors")))



^{:go/end 104} (go/method pos ^src/XPos [^{:tag (* Parser)} p]
  (.XPos (.-PosTable (.-ctxt p)) (src/MakePos (.Base (.-lex p)) (conv uint (.-lineNum p)) 0)))


^{:go/end 130} (go/method Parse [^{:tag (* Parser)} p] :results [(* obj/Prog) bool]
  (let [scratch (make (slice (slice lex/Token)) 0 3)]
    (while true
      (let [(values word cond operands ok) (.line p scratch)]
        (when (not ok)
          (break))

        (set! scratch operands)

        (when (.pseudo p word operands)
          (continue))

        (let [(values i present) (aget (.-Instructions (.-arch p)) word)]
          (when present
            (.instruction p i word cond operands)
            (continue))

          (.errorf p "unrecognized instruction %q" word))))

    (when (> (.-errorCount p) 0)
      (return nil false))

    (.patch p)
    (return (.-firstProg p) true)))




^{:go/end 146} (go/method ParseSymABIs "ParseSymABIs parses p's assembly code to find text symbol\ndefinitions and references and writes a symabis file to w.\n" ^bool [^{:tag (* Parser)} p ^io/Writer w]
  (let [operands (make (slice (slice lex/Token)) 0 3)]
    (while true
      (let [(values word _ operands1 ok) (.line p operands)]
        (when (not ok)
          (break))

        (set! operands operands1)

        (.symDefRef p w word operands)))

    (== (.-errorCount p) 0)))




^{:go/end 170} (go/method nextToken "nextToken returns the next non-build-comment token from the lexer.\nIt reports misplaced //go:build comments but otherwise discards them.\n" ^lex/ScanToken [^{:tag (* Parser)} p]
  (while true
    (let [tok (.Next (.-lex p))]
      (when (== tok lex/BuildComment)
        (when (.-sawCode p)
          (.errorf p "misplaced //go:build comment"))

        (continue))

      (when (!= tok \newline)
        (set! (.-sawCode p) true))

      (when (== tok \#)
        ;; A leftover wisp of a #include/#define/etc,
        ;; to let us know that p.sawCode should be true now.
        ;; Otherwise ignored.
        (continue))

      (return tok))))












^{:go/end 275} (go/method line "line consumes a single assembly line from p.lex of the form\n\n\t{label:} WORD[.cond] [ arg {, arg} ] (';' | '\\n')\n\nIt adds any labels to p.pendingLabels and returns the word, cond,\noperand list, and true. If there is an error or EOF, it returns\nok=false.\n\nline may reuse the memory from scratch.\n" [^{:tag (* Parser)} p ^{:tag (slice (slice lex/Token))} scratch] :results [^string word ^string cond ^{:tag (slice (slice lex/Token))} operands ^bool ok]
  (let [
      ;; Skip newlines.
      ^{:line 184 :tag lex/ScanToken :go/label :next :go/label-line 182} tok (zero lex/ScanToken)]
    (while true
      (set! tok (.nextToken p))
      ;; We save the line number here so error messages from this instruction
      ;; are labeled with this line. Otherwise we complain after we've absorbed
      ;; the terminating newline and the line numbers are off by one in errors.
      (set! (.-lineNum p) (.Line (.-lex p)))
      (switch tok
        (case [\newline \;]
          (continue))
        (case [scanner/EOF]
          (return "" "" nil false)))

      (break))

    ;; First item must be an identifier.
    (when (!= tok scanner/Ident)
      (.errorf p "expected identifier, found %q" (.Text (.-lex p)))
      (return "" "" nil false)) ; Might as well stop now.

    (set! (values word cond) (values (.Text (.-lex p)) ""))
    (set! operands (subslice scratch _ 0))
    ;; Zero or more comma-separated operands, one per loop.
    (let [nesting 0
        ^{:line 208} colon -1]
      (while (and (!= tok \newline) (!= tok \;))
        ;; Process one operand.
        (let [^{:tag (slice lex/Token)} items (zero (slice lex/Token))]
          (if (> (cap operands) (len operands))
            ;; Reuse scratch items slice.
            (set! items (subslice (aget (subslice operands _ (cap operands)) (len operands)) _ 0))

            (set! items (make (slice lex/Token) 0 3)))

          (while true
            (set! tok (.nextToken p))
            (when (and (== (len operands) 0) (== (len items) 0))
              (when (and ^{:go/via [LinkArch Arch]} (.InFamily (.-arch p) sys/ARM sys/ARM64 sys/AMD64 sys/I386 sys/Loong64 sys/RISCV64) (== tok \.))
                ;; Suffixes: ARM conditionals, Loong64 vector instructions, RISCV rounding mode or x86 modifiers.
                (set! tok (.nextToken p))
                (let [str (.Text (.-lex p))]
                  (when (!= tok scanner/Ident)
                    (.errorf p "instruction suffix expected identifier, found %s" str))

                  (set! cond (+ cond "." str))
                  (continue)))

              (when (== tok \:)
                ;; Labels.
                (set! (.-pendingLabels p) (append (.-pendingLabels p) word))
                (goto :next)))


            (when (== tok scanner/EOF)
              (.errorf p "unexpected EOF")
              (return "" "" nil false))

            ;; Split operands on comma. Also, the old syntax on x86 for a "register pair"
            ;; was AX:DX, for which the new syntax is DX, AX. Note the reordering.
            (when (or (== tok \newline) (== tok \;) ^:go/paren (and (== nesting 0) ^:go/paren (or (== tok \,) (== tok \:))))
              (when (== tok \:)
                ;; Remember this location so we can swap the operands below.
                (when (>= colon 0)
                  (.errorf p "invalid ':' in operand")
                  (return word cond operands true))

                (set! colon (len operands)))

              (break))

            (when (or (== tok \() (== tok \[))
              (inc! nesting))

            (when (or (== tok \)) (== tok \]))
              (dec! nesting))

            (set! items (append items (lex/Make tok (.Text (.-lex p))))))

          (cond (> (len items) 0) (do
              (set! operands (append operands items))
              (when (and (>= colon 0) (== (len operands) (+ colon 2)))
                ;; AX:DX becomes DX, AX.
                (set! (values (aget operands colon) (aget operands (+ colon 1))) (values (aget operands (+ colon 1)) (aget operands colon)))
                (set! colon -1)))

            (or (> (len operands) 0) (== tok \,) (>= colon 0))
            ;; Had a separator with nothing after.
            (.errorf p "missing operand"))))


      (return word cond operands true))))


^{:go/end 292} (go/method instruction [^{:tag (* Parser)} p ^obj/As op ^string word ^string cond ^{:tag (slice (slice lex/Token))} operands]
  (set! (.-addr p) (subslice (.-addr p) 0 0))
  (set! (.-isJump p) ((.-IsJump (.-arch p)) word))
  (range [_ op operands]
    (let [addr (.address p op)]
      (when (and (not (.-isJump p)) (< (.-Reg addr) 0)) ; Jumps refer to PC, a pseudo.
        (.errorf p "illegal use of pseudo-register in %s" word))

      (set! (.-addr p) (append (.-addr p) addr))))

  (when (.-isJump p)
    (.asmJump p op cond (.-addr p))
    (return))

  (.asmInstruction p op cond (.-addr p)))


^{:go/breaks [[4 311]] :go/end 312} (go/method pseudo ^bool [^{:tag (* Parser)} p ^string word ^{:tag (slice (slice lex/Token))} operands]
  (switch word
    (case ["DATA"]
      (.asmData p operands))
    (case ["FUNCDATA"]
      (.asmFuncData p operands))
    (case ["GLOBL"]
      (.asmGlobl p operands))
    (case ["PCDATA"]
      (.asmPCData p operands))
    (case ["PCALIGN"]
      (.asmPCAlign p operands))
    (case ["TEXT"]
      (.asmText p operands))
    (default
      (return false)))

  true)







^{:go/end 348} (go/method symDefRef "symDefRef scans a line for potential text symbol definitions and\nreferences and writes symabis information to w.\n\nThe symabis format is documented at\ncmd/compile/internal/ssagen.ReadSymABIs.\n" [^{:tag (* Parser)} p ^io/Writer w ^string word ^{:tag (slice (slice lex/Token))} operands]
  (switch word
    (case ["TEXT"]
      ;; Defines text symbol in operands[0].
      (when (> (len operands) 0)
        (.start p (aget operands 0))
        (when [(values name abi ok) (.funcAddress p)] ok
          (fmt/Fprintf w "def %s %s\n" name abi)))


      (return))
    (case ["GLOBL" "PCDATA"])
    ;; No text definitions or symbol references.
    (case ["DATA" "FUNCDATA"]
      ;; For DATA, operands[0] is defined symbol.
      ;; For FUNCDATA, operands[0] is an immediate constant.
      ;; Remaining operands may have references.
      (when (< (len operands) 2)
        (return))

      (set! operands (subslice operands 1))))

  ;; Search for symbol references.
  (range [_ op operands]
    (.start p op)
    (when [(values name abi ok) (.funcAddress p)] ok
      (fmt/Fprintf w "ref %s %s\n" name abi))))




^{:go/end 353} (go/method start [^{:tag (* Parser)} p ^{:tag (slice lex/Token)} operand]
  (set! (.-input p) operand)
  (set! (.-inputPos p) 0))



^{:go/end 361} (go/method address "address parses the operand into a link address structure.\n" ^obj/Addr [^{:tag (* Parser)} p ^{:tag (slice lex/Token)} operand]
  (.start p operand)
  (let [addr (lit obj/Addr)]
    (.operand p (addr addr))
    ^{:line 360} addr))



^{:go/breaks [6] :go/end 371} (go/method parseScale "parseScale converts a decimal string into a valid scale factor.\n" ^int8 [^{:tag (* Parser)} p ^string s]
  (switch s
    (case ["1" "2" "4" "8"]
      (return (conv int8 (- (aget s 0) \0)))))

  (.errorf p "bad scale: %s" s)
  0)



^{:go/end 632} (go/method operand "operand parses a general operand and stores the result in *a.\n" [^{:tag (* Parser)} p ^{:tag (* obj/Addr)} a]
  ;;fmt.Printf("Operand: %v\n", p.input)
  (when (== (len (.-input p)) 0)
    (.errorf p "empty operand: cannot happen")
    (return))

  ;; General address (with a few exceptions) looks like
  ;;	$sym±offset(SB)(reg)(index*scale)
  ;; Exceptions are:
  ;;
  ;;	R1
  ;;	offset
  ;;	$offset
  ;; Every piece is optional, so we scan left to right and what
  ;; we discover tells us where we are.

  ;; Prefix: $.
  (let [^rune prefix (zero rune)]
    (switch [tok (.peek p)] tok
      (case [\$ \*]
        (set! prefix (conv rune tok))
        (.next p)))


    ;; Symbol: sym±offset(SB)
    (let [tok (.next p)
        ^{:line 400} name (.String tok)]
      (when (and (== (.-ScanToken tok) scanner/Ident) (not (.atStartOfRegister p name)))
        ;; See if this is an architecture specific special operand.
        (switch ^{:go/via [LinkArch Arch]} (.-Family (.-arch p))
          (case [sys/ARM64]
            (when [opd (arch/ARM64SpecialOperand name)] (!= opd arm64/SPOP_END)
              (set! (.-Type a) obj/TYPE_SPECIAL)
              (set! (.-Offset a) (conv int64 opd))))

          (case [sys/RISCV64]
            (when [opd (arch/RISCV64SpecialOperand name)] (!= opd riscv/SPOP_END)
              (set! (.-Type a) obj/TYPE_SPECIAL)
              (set! (.-Offset a) (conv int64 opd)))))



        (when (!= (.-Type a) obj/TYPE_SPECIAL)
          ;; We have a symbol. Parse $sym±offset(symkind)
          (.symbolReference p a (.qualifySymbol p name) prefix))

        ;; fmt.Printf("SYM %s\n", obj.Dconv(&emptyProg, 0, a))
        (when (== (.peek p) scanner/EOF)
          (return)))



      ;; Detect AC_PREGSEL operand syntax: [selreg, $idximm](preg.T2)
      (when (and (== (.-ScanToken tok) \[) (== ^{:go/via [LinkArch Arch]} (.-Family (.-arch p)) sys/ARM64))
        (let [pos (.-inputPos p)]
          (when (and (< (+ pos 5) (len (.-input p))) (== (.-ScanToken (aget (.-input p) pos)) scanner/Ident)
              (== (.-ScanToken (aget (.-input p) (+ pos 1))) \,) (== (.-ScanToken (aget (.-input p) (+ pos 2))) \$)
              (== (.-ScanToken (aget (.-input p) (+ pos 3))) scanner/Int) (== (.-ScanToken (aget (.-input p) (+ pos 4))) \])
              (== (.-ScanToken (aget (.-input p) (+ pos 5))) \())

            (let [selregStr (.String (aget (.-input p) pos))
                ^{:line 435} immStr (.String (aget (.-input p) (+ pos 3)))]

              (set! pos + 6) ; past '('
              (when (and (< pos (len (.-input p))) (== (.-ScanToken (aget (.-input p) pos)) scanner/Ident))
                (let [pregStr (.String (aget (.-input p) pos))]
                  (inc! pos)
                  (let [ext ""]
                    (when (and (< pos (len (.-input p))) (== (.-ScanToken (aget (.-input p) pos)) \.))
                      (inc! pos)
                      (when (and (< pos (len (.-input p))) (== (.-ScanToken (aget (.-input p) pos)) scanner/Ident))
                        (set! ext (.String (aget (.-input p) pos)))
                        (inc! pos)))


                    (when (and (< pos (len (.-input p))) (== (.-ScanToken (aget (.-input p) pos)) \)))
                      ;; Matches AC_PREGSEL syntax!
                      (set! (.-inputPos p) (+ pos 1)) ; consume the parsed tokens

                      ;; Encode components
                      (let [(values selreg ok1) (.registerReference p selregStr)
                          (values preg ok2) (.registerReference p pregStr)
                          ^{:line 456} idximm (conv int64 (.atoi p immStr))]

                        (when (or (not ok1) (not ok2))
                          (.errorf p "invalid registers in pregsel operand")
                          (return))


                        (let [^int arng2 (zero int)]
                          (switch ext
                            (case ["B"]
                              (set! arng2 arm64/ARNG_B))
                            (case ["H"]
                              (set! arng2 arm64/ARNG_H))
                            (case ["S"]
                              (set! arng2 arm64/ARNG_S))
                            (case ["D"]
                              (set! arng2 arm64/ARNG_D))
                            (case ["Q"]
                              (set! arng2 arm64/ARNG_Q))
                            (default
                              (.errorf p "invalid P register arrangement: %s" ext)
                              (return)))


                          ;; Pack values into a.Offset
                          (set! (.-Type a) obj/TYPE_REG)
                          (set! (.-Offset a) (bit-or (conv int64 (bit-and preg 31)) (conv int64 (<< (bit-and arng2 15) 5)) (conv int64 (<< (bit-and selreg 31) 9)) (<< idximm 14) (<< (conv int64 1) 62)))
                          (.expectOperandEnd p)
                          (return)))))))))))





      ;; Special register list syntax for arm: [R1,R3-R7]
      (when (== (.-ScanToken tok) \[)
        (when (!= prefix 0)
          (.errorf p "illegal use of register list"))

        (.registerList p a)
        (.expectOperandEnd p)
        (return))


      ;; Register: R1
      (when (and (== (.-ScanToken tok) scanner/Ident) (.atStartOfRegister p name))
        (if (.atRegisterShift p) (do
            ;; ARM shifted register such as R1<<R2 or R1>>2.
            (set! (.-Type a) obj/TYPE_SHIFT)
            (set! (.-Offset a) (.registerShift p (.String tok) prefix))
            (when (== (.peek p) \()
              ;; Can only be a literal register here.
              (.next p)
              (let [tok (.next p)
                  ^{:line 510} name (.String tok)]
                (when (not (.atStartOfRegister p name))
                  (.errorf p "expected register; found %s" name))

                (set! (values (.-Reg a) _) (.registerReference p name))
                (.get p \)))))

          (if (.atRegisterExtension p) (do
              (set! (.-Type a) obj/TYPE_REG)
              (.registerExtension p a (.String tok) prefix)
              (.expectOperandEnd p)
              (return))
            (when [(values r1 r2 scale ok) (.register p (.String tok) prefix)] ok
              (when (!= scale 0)
                (.errorf p "expected simple register reference"))

              (set! (.-Type a) obj/TYPE_REG)
              (set! (.-Reg a) r1)
              (when (!= r2 0)
                ;; Form is R1:R2. It is on RHS and the second register
                ;; needs to go into the LHS.
                (panic "cannot happen (Addr.Reg2)")))))


        ;; fmt.Printf("REG %s\n", obj.Dconv(&emptyProg, 0, a))
        (.expectOperandEnd p)
        (return))


      ;; Detect (VL*imm) or (-VL*imm) pattern in ARM64
      (when (and (== ^{:go/via [LinkArch Arch]} (.-Family (.-arch p)) sys/ARM64) (>= (len (.-input p)) 5) (== (.-ScanToken (aget (.-input p) 0)) \())
        (let [pos 1
            ^{:line 542} sign (conv int64 1)]
          (cond (== (.-ScanToken (aget (.-input p) pos)) \-) (do
              (set! sign -1)
              (inc! pos))
            (== (.-ScanToken (aget (.-input p) pos)) \+)
            (inc! pos))

          (when (and (< (+ pos 3) (len (.-input p))) (== (.String (aget (.-input p) pos)) "VL") (== (.-ScanToken (aget (.-input p) (+ pos 1))) \*) (== (.-ScanToken (aget (.-input p) (+ pos 2))) scanner/Int) (== (.-ScanToken (aget (.-input p) (+ pos 3))) \)))
            (let [imm (conv int64 (.atoi p (.String (aget (.-input p) (+ pos 2)))))]
              (set! imm * sign)
              (set! (.-Offset a) imm)
              (set! (.-Scale a) -32768) ; bit 15 signals multiple of Vector Length

              ;; Remove the (VL*imm) tokens and let operand parse the remaining sequence (reg.T)
              (set! (.-input p) (subslice (.-input p) (+ pos 4)))
              (set! (.-inputPos p) 0)
              (.operand p a)
              (return)))))



      ;; Constant.
      (let [haveConstant false]
        (switch (.-ScanToken tok)
          (case [scanner/Int scanner/Float scanner/String scanner/Char \+ \- \~]
            (set! haveConstant true))
          (case [\(]
            ;; Could be parenthesized expression or (R). Must be something, though.
            (let [tok (.next p)]
              (when (== (.-ScanToken tok) scanner/EOF)
                (.errorf p "missing right parenthesis")
                (return))

              (let [rname (.String tok)]
                (.back p)
                (set! haveConstant (not (.atStartOfRegister p rname)))
                (when (not haveConstant)
                  (.back p)))))) ; Put back the '('.


        (when haveConstant
          (.back p)
          (when (.have p scanner/Float)
            (when (!= prefix \$)
              (.errorf p "floating-point constant must be an immediate"))

            (set! (.-Type a) obj/TYPE_FCONST)
            (set! (.-Val a) (.floatExpr p))
            ;; fmt.Printf("FCONST %s\n", obj.Dconv(&emptyProg, 0, a))
            (.expectOperandEnd p)
            (return))

          (when (.have p scanner/String)
            (when (!= prefix \$)
              (.errorf p "string constant must be an immediate")
              (return))

            (let [(values str err) (strconv/Unquote (.String (.get p scanner/String)))]
              (when (!= err nil)
                (.errorf p "string parse error: %s" err))

              (set! (.-Type a) obj/TYPE_SCONST)
              (set! (.-Val a) str)
              ;; fmt.Printf("SCONST %s\n", obj.Dconv(&emptyProg, 0, a))
              (.expectOperandEnd p)
              (return)))

          (set! (.-Offset a) (conv int64 (.expr p)))
          (when (!= (.peek p) \()
            (switch prefix
              (case [\$]
                (set! (.-Type a) obj/TYPE_CONST))
              (case [\*]
                (set! (.-Type a) obj/TYPE_INDIR)) ; Can appear but is illegal, will be rejected by the linker.
              (default
                (set! (.-Type a) obj/TYPE_MEM)))

            ;; fmt.Printf("CONST %d %s\n", a.Offset, obj.Dconv(&emptyProg, 0, a))
            (.expectOperandEnd p)
            (return)))

        ;; fmt.Printf("offset %d \n", a.Offset)


        ;; Register indirection: (reg) or (index*scale). We are on the opening paren.
        (.registerIndirect p a prefix)
        ;; fmt.Printf("DONE %s\n", p.arch.Dconv(&emptyProg, 0, a))

        (.expectOperandEnd p)
        (return)))))



^{:go/end 643} (go/method atStartOfRegister "atStartOfRegister reports whether the parser is at the start of a register definition.\n" ^bool [^{:tag (* Parser)} p ^string name]
  ;; Simple register: R10.
  (let [(values _ present) (aget (.-Register (.-arch p)) name)]
    (when present
      (return true))

    ;; Parenthesized register: R(10).
    (and (aget (.-RegisterPrefix (.-arch p)) name) (== (.peek p) \())))




^{:go/end 662} (go/method atRegisterShift "atRegisterShift reports whether we are at the start of an ARM shifted register.\nWe have consumed the register or R prefix.\n" ^bool [^{:tag (* Parser)} p]
  ;; ARM only.
  (when (not ^{:go/via [LinkArch Arch]} (.InFamily (.-arch p) sys/ARM sys/ARM64))
    (return false))

  ;; R1<<...
  (when (lex/IsRegisterShift (.peek p))
    (return true))


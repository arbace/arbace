          (.next p)
          (set! value + (.term p)))
        (case [\-]
          (.next p)
          (set! value - (.term p)))
        (case [\|]
          (.next p)
          (set! value bit-or (.term p)))
        (case [\^]
          (.next p)
          (set! value bit-xor (.term p)))
        (default
          (return value))))))






^{:go/end 575} (go/method asmJump "asmJump assembles a jump instruction.\nJMP\tR1\nJMP\texit\nJMP\t3(PC)\n" [^{:tag (* Parser)} p ^obj/As op ^string cond ^{:tag (slice obj/Addr)} a]
  (let [^{:tag (* obj/Addr)} target (zero (* obj/Addr))
      ^{:line 399} prog (addr ^{:go/breaks [2 4 6]} (lit obj/Prog
          :Ctxt (.-ctxt p)
          :Pos (.pos p)
          :As op))


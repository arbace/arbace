          ;; The first and second cases demonstrate a symbol name which is
          ;; effectively discarded. In these cases, the offset determines
          ;; the CR bit.
          (set! (.-Reg prog) (.-Reg (aget a 1)))
          (when (!= (.-Type (aget a 1)) obj/TYPE_REG)

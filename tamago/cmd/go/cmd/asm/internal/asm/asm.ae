^{:go/breaks [[5 112]] :go/end 113} (go/method validImmediate "validImmediate checks that addr represents an immediate constant.\n" ^bool [^{:tag (* Parser)} p ^string pseudo ^{:tag (* obj/Addr)} addr]
  (when (or (!= (.-Type addr) obj/TYPE_CONST) (!= (.-Name addr) 0) (!= (.-Reg addr) 0) (!= (.-Index addr) 0))
    (.errorf p "%s: expected immediate constant; found %s" pseudo (obj/Dconv (addr emptyProg) addr))
    (return false))

  true)




^{:go/end 202} (go/method asmText "asmText assembles a TEXT pseudo-op.\nTEXT runtime·sigtramp(SB),4,$0-0\n" [^{:tag (* Parser)} p ^{:tag (slice (slice lex/Token))} operands]
  (when (and (!= (len operands) 2) (!= (len operands) 3))
    (.errorf p "expect two or three operands for TEXT")
    (return))


  ;; Labels are function scoped. Patch existing labels and
  ;; create a new label space for this TEXT.
  (.patch p)
  (set! (.-labels p) (make (map string (* obj/Prog))))

  ;; Operand 0 is the symbol name in the form foo(SB).
  ;; That means symbol plus indirect on SB and no offset.
  (let [nameAddr (.address p (aget operands 0))]
    (when (not (.validSymbol p "TEXT" (addr nameAddr) false))
      (return))

    (let [name (symbolName (addr nameAddr))
        ^{:line 135} next 1

        ;; Next operand is the optional text flag, a literal integer.
        ^:var ^{:line 138} flag (conv int64 0)]
      (when (== (len operands) 3)
        (set! flag (.evalInteger p "TEXT" (aget operands 1)))
        (inc! next))


      ;; Issue an error if we see a function defined as ABIInternal
      ;; without NOSPLIT. In ABIInternal, obj needs to know the function
      ;; signature in order to construct the morestack path, so this
      ;; currently isn't supported for asm functions.
      (when (and (== ^{:go/via [Attribute]} (.ABI (.-Sym nameAddr)) obj/ABIInternal) (== (bit-and flag obj/NOSPLIT) 0))
        (.errorf p "TEXT %q: ABIInternal requires NOSPLIT" name))


      ;; Next operand is the frame and arg size.
      ;; Bizarre syntax: $frameSize-argSize is two words, not subtraction.
      ;; Both frameSize and argSize must be simple integers; only frameSize
      ;; can be negative.
      ;; The "-argSize" may be missing; if so, set it to objabi.ArgsSizeUnknown.
      ;; Parse left to right.
      (let [op (aget operands next)]
        (when (or (< (len op) 2) (!= (.-ScanToken (aget op 0)) \$))
          (.errorf p "TEXT %s: frame size must be an immediate constant" name)
          (return))

        (set! op (subslice op 1))
        (let [negative false]
          (when (== (.-ScanToken (aget op 0)) \-)
            (set! negative true)
            (set! op (subslice op 1)))

          (when (or (== (len op) 0) (!= (.-ScanToken (aget op 0)) scanner/Int))
            (.errorf p "TEXT %s: frame size must be an immediate constant" name)
            (return))

          (let [frameSize (.positiveAtoi p (.String (aget op 0)))]
            (when negative
              (set! frameSize (- frameSize)))

            (set! op (subslice op 1))
            (let [argSize (conv int64 abi/ArgsSizeUnknown)]
              (when (> (len op) 0)
                ;; There is an argument size. It must be a minus sign followed by a non-negative integer literal.
                (when (or (!= (len op) 2) (!= (.-ScanToken (aget op 0)) \-) (!= (.-ScanToken (aget op 1)) scanner/Int))
                  (.errorf p "TEXT %s: argument size must be of form -integer" name)
                  (return))

                (set! argSize (.positiveAtoi p (.String (aget op 1)))))

              (.InitTextSym (.-ctxt p) (.-Sym nameAddr) (conv int flag) (.pos p))
              (let [prog (addr ^{:go/breaks [2 4 6 8 10]} (lit obj/Prog
                      :Ctxt (.-ctxt p)
                      :As obj/ATEXT
                      :Pos (.pos p)
                      :From nameAddr
                      :To ^{:go/breaks [2 4]} (lit obj/Addr
                        :Type obj/TYPE_TEXTSIZE
                        :Offset frameSize)))]
                ;; Argsize set below.


                (set! (.-Text (.Func (.-Sym nameAddr))) prog)
                (set! (.-Val (.-To prog)) (conv int32 argSize))
                (.append p prog "" true)))))))))




^{:go/end 274} (go/method asmData "asmData assembles a DATA pseudo-op.\nDATA masks<>+0x00(SB)/4, $0x00000000\n" [^{:tag (* Parser)} p ^{:tag (slice (slice lex/Token))} operands]
  (when (!= (len operands) 2)
    (.errorf p "expect two operands for DATA")
    (return))


  ;; Operand 0 has the general form foo<>+0x04(SB)/4.
  (let [op (aget operands 0)
      ^{:line 214} n (len op)]
    (when (or (< n 3) (!= (.-ScanToken (aget op (- n 2))) \/) (!= (.-ScanToken (aget op (- n 1))) scanner/Int))
      (.errorf p "expect /size for DATA argument")
      (return))

    (let [szop (.String (aget op (- n 1)))
        (values sz err) (strconv/Atoi szop)]
      (when (!= err nil)
        (.errorf p "bad size for DATA argument: %q" szop))

      (set! op (subslice op _ (- n 2)))
      (let [nameAddr (.address p op)]
        (when (not (.validSymbol p "DATA" (addr nameAddr) true))
          (return))

        (let [name (symbolName (addr nameAddr))

            ;; Operand 1 is an immediate constant or address.
            ^{:line 232} valueAddr (.address p (aget operands 1))]
          (switch (.-Type valueAddr)
            (case [obj/TYPE_CONST obj/TYPE_FCONST obj/TYPE_SCONST obj/TYPE_ADDR])
            ;; OK
            (default
              (.errorf p "DATA value must be an immediate constant or address")
              (return)))


          ;; The addresses must not overlap. Easiest test: require monotonicity.
          (when [(values lastAddr ok) (aget (.-dataAddr p) name)] (and ok (< (.-Offset nameAddr) lastAddr))
            (.errorf p "overlapping DATA entry for %s" name)
            (return))

          (aset (.-dataAddr p) name (+ (.-Offset nameAddr) (conv int64 sz)))

          (switch (.-Type valueAddr)
            (case [obj/TYPE_CONST]
              (switch sz
                (case [1 2 4 8]
                  (.WriteInt (.-Sym nameAddr) (.-ctxt p) (.-Offset nameAddr) sz (.-Offset valueAddr)))
                (default
                  (.errorf p "bad int size for DATA argument: %d" sz))))

            (case [obj/TYPE_FCONST]
              (switch sz
                (case [4]
                  (.WriteFloat32 (.-Sym nameAddr) (.-ctxt p) (.-Offset nameAddr) (conv float32 (assert float64 (.-Val valueAddr)))))
                (case [8]
                  (.WriteFloat64 (.-Sym nameAddr) (.-ctxt p) (.-Offset nameAddr) (assert float64 (.-Val valueAddr))))
                (default
                  (.errorf p "bad float size for DATA argument: %d" sz))))

            (case [obj/TYPE_SCONST]
              (.WriteString (.-Sym nameAddr) (.-ctxt p) (.-Offset nameAddr) sz (assert string (.-Val valueAddr))))
            (case [obj/TYPE_ADDR]
              (if (== sz ^{:go/via [LinkArch Arch]} (.-PtrSize (.-arch p)))
                (.WriteAddr (.-Sym nameAddr) (.-ctxt p) (.-Offset nameAddr) sz (.-Sym valueAddr) (.-Offset valueAddr))

                (.errorf p "bad addr size for DATA argument: %d" sz)))))))))







^{:go/end 307} (go/method asmGlobl "asmGlobl assembles a GLOBL pseudo-op.\nGLOBL shifts<>(SB),8,$256\nGLOBL shifts<>(SB),$256\n" [^{:tag (* Parser)} p ^{:tag (slice (slice lex/Token))} operands]

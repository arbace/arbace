(go/var ^{:tag (* strings/Builder)} testOut) ; Gathers output when testing.



^{:go/end 85} (go/method append "append adds the Prog to the end of the program-thus-far.\nIf doLabel is set, it also defines the labels collect for this Prog.\n" [^{:tag (* Parser)} p ^{:tag (* obj/Prog)} prog ^string cond ^bool doLabel]
  (when (!= cond "")
    (switch ^{:go/via [LinkArch Arch]} (.-Family (.-arch p))
      (case [sys/ARM]
        (when (not (arch/ARMConditionCodes prog cond))
          (.errorf p "unrecognized condition code .%q" cond)
          (return)))


      (case [sys/ARM64]
        (when (not (arch/ARM64Suffix prog cond))
          (.errorf p "unrecognized suffix .%q" cond)
          (return)))


      (case [sys/AMD64 sys/I386]
        (when [err (x86/ParseSuffix prog cond)] (!= err nil)
          (.errorf p "%v" err)
          (return)))

      (case [sys/RISCV64]
        (when [err (riscv/ParseSuffix prog cond)] (!= err nil)
          (.errorf p "unrecognized suffix .%q" cond)
          (return)))

      (default
        (.errorf p "unrecognized suffix .%q" cond)
        (return))))


  (if (== (.-firstProg p) nil)
    (set! (.-firstProg p) prog)

    (set! (.-Link (.-lastProg p)) prog))

  (set! (.-lastProg p) prog)
  (when doLabel
    (inc! (.-pc p))
    (range [_ label (.-pendingLabels p)]
      (when (!= (aget (.-labels p) label) nil)
        (.errorf p "label %q multiply defined" label)
        (return))

      (aset (.-labels p) label prog))

    (set! (.-pendingLabels p) (subslice (.-pendingLabels p) 0 0)))

  (set! (.-Pc prog) (.-pc p))
  (when @flags/Debug
    (fmt/Println (.-lineNum p) prog))

  (when (!= testOut nil)
    (fmt/Fprintln testOut prog)))




^{:go/breaks [[6 97]] :go/end 98} (go/method validSymbol "validSymbol checks that addr represents a valid name for a pseudo-op.\n" ^bool [^{:tag (* Parser)} p ^string pseudo ^{:tag (* obj/Addr)} addr ^bool offsetOk]
  (when (or (== (.-Sym addr) nil) (and (!= (.-Name addr) obj/NAME_EXTERN) (!= (.-Name addr) obj/NAME_STATIC)) (!= (.-Scale addr) 0) (!= (.-Reg addr) 0))
    (.errorf p "%s symbol %q must be a symbol(SB)" pseudo (symbolName addr))
    (return false))

  (when (and (not offsetOk) (!= (.-Offset addr) 0))
    (.errorf p "%s symbol %q must not be offset from SB" pseudo (symbolName addr))
    (return false))

  true)



^{:go/end 104} (go/method evalInteger "evalInteger evaluates an integer constant for a pseudo-op.\n" ^int64 [^{:tag (* Parser)} p ^string pseudo ^{:tag (slice lex/Token)} operands]

^{:go/end 587} (go/method patch [^{:tag (* Parser)} p]
  (range [_ patch (.-toPatch p)]
    (let [targetProg (aget (.-labels p) (.-label patch))]
      (when (== targetProg nil)
        (.errorf p "undefined label %s" (.-label patch))
        (return))

      (.branch p (.-addr patch) targetProg)))

  (set! (.-toPatch p) (subslice (.-toPatch p) _ 0)))


^{:go/end 595} (go/method branch [^{:tag (* Parser)} p ^{:tag (* obj/Addr)} addr ^{:tag (* obj/Prog)} target]
  (set! @addr ^{:go/breaks [2 4]} (lit obj/Addr
      :Type obj/TYPE_BRANCH
      :Index 0))

  (set! (.-Val addr) target))


^{:go/end 599} (go/func isARM64SVE ^bool [^obj/As op]
  (> op arm64/ASVESTART))




^{:go/end 1014} (go/method asmInstruction "asmInstruction assembles an instruction.\nMOVW R9, (R10)\n" [^{:tag (* Parser)} p ^obj/As op ^string cond ^{:tag (slice obj/Addr)} a]
  ;; fmt.Printf("%s %+v\n", op, a)
  (let [prog (addr ^{:go/breaks [2 4 6]} (lit obj/Prog
          :Ctxt (.-ctxt p)
          :Pos (.pos p)
          :As op))]

    (switch (len a)
      (case [0])
      ;; Nothing to do.
      (case [1]
        (if (or (aget ^{:go/via [LinkArch]} (.-UnaryDst (.-arch p)) op) (== op obj/ARET) (== op obj/AGETCALLERPC))
          ;; prog.From is no address.
          (set! (.-To prog) (aget a 0))

          (set! (.-From prog) (aget a 0)))
        ;; prog.To is no address.

        (when (and (== ^{:go/via [LinkArch Arch]} (.-Family (.-arch p)) sys/PPC64) (arch/IsPPC64NEG op))
          ;; NEG: From and To are both a[0].
          (set! (.-To prog) (aget a 0))
          (set! (.-From prog) (aget a 0))
          (break)))

      (case [2]
        (cond (== ^{:go/via [LinkArch Arch]} (.-Family (.-arch p)) sys/ARM) (do
            (when (arch/IsARMCMP op)
              (set! (.-From prog) (aget a 0))
              (set! (.-Reg prog) (.getRegister p prog op (addr (aget a 1))))
              (break))


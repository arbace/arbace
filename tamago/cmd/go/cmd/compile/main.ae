(in-ns 'go.cmd.compile) (go/file "main.go" :imports [


    ^{:line 8} [amd64 "cmd/compile/internal/amd64"]
    ^{:line 9} [arm "cmd/compile/internal/arm"]
    ^{:line 10} [arm64 "cmd/compile/internal/arm64"]
    ^{:line 11} [base "cmd/compile/internal/base"]
    ^{:line 12} [gc "cmd/compile/internal/gc"]
    ^{:line 13} [loong64 "cmd/compile/internal/loong64"]
    ^{:line 14} [mips "cmd/compile/internal/mips"]
    ^{:line 15} [mips64 "cmd/compile/internal/mips64"]
    ^{:line 16} [ppc64 "cmd/compile/internal/ppc64"]
    ^{:line 17} [riscv64 "cmd/compile/internal/riscv64"]
    ^{:line 18} [s390x "cmd/compile/internal/s390x"]
    ^{:line 19} [ssagen "cmd/compile/internal/ssagen"]
    ^{:line 20} [wasm "cmd/compile/internal/wasm"]
    ^{:line 21} [x86 "cmd/compile/internal/x86"]
    ^{:line 22} [fmt "fmt"]
    ^{:line 23} [buildcfg "internal/buildcfg"]
    ^{:line 24} [log "log"]
    ^{:line 25} [os "os"]])


(go/var archInits (lit (map string (func [(* ssagen/ArchInfo)]))
    ^{:line 29} ["386" x86/Init]
    ^{:line 30} ["amd64" amd64/Init]
    ^{:line 31} ["arm" arm/Init]
    ^{:line 32} ["arm64" arm64/Init]
    ^{:line 33} ["loong64" loong64/Init]
    ^{:line 34} ["mips" mips/Init]
    ^{:line 35} ["mipsle" mips/Init]
    ^{:line 36} ["mips64" mips64/Init]
    ^{:line 37} ["mips64le" mips64/Init]
    ^{:line 38} ["ppc64" ppc64/Init]
    ^{:line 39} ["ppc64le" ppc64/Init]
    ^{:line 40} ["riscv64" riscv64/Init]
    ^{:line 41} ["s390x" s390x/Init]
    ^{:line 42} ["wasm" wasm/Init]))


^{:go/end 59} (go/func main []
  ;; disable timestamps for reproducible output
  (log/SetFlags 0)
  (log/SetPrefix "compile: ")

  (buildcfg/Check)
  (let [(values archInit ok) (aget archInits buildcfg/GOARCH)]
    (when (not ok)
      (fmt/Fprintf os/Stderr "compile: unknown architecture %q\n" buildcfg/GOARCH)
      (os/Exit 2))


    (gc/Main archInit)
    (base/Exit 0)))

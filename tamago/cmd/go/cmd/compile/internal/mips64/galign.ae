(in-ns 'go.cmd.compile.internal.mips64) (go/file "galign.go" :imports [


    ^{:line 8} [ssa "cmd/compile/internal/ssa"]
    ^{:line 9} [ssagen "cmd/compile/internal/ssagen"]
    ^{:line 10} [mips "cmd/internal/obj/mips"]
    ^{:line 11} [buildcfg "internal/buildcfg"]])


^{:go/end 28} (go/func Init [^{:tag (* ssagen/ArchInfo)} arch]
  (set! (.-LinkArch arch) (addr mips/Linkmips64))
  (when (== buildcfg/GOARCH "mips64le")
    (set! (.-LinkArch arch) (addr mips/Linkmips64le)))

  (set! (.-REGSP arch) mips/REGSP)
  (set! (.-MAXWIDTH arch) (<< 1 50))
  (set! (.-SoftFloat arch) (== buildcfg/GOMIPS64 "softfloat"))
  (set! (.-ZeroRange arch) zerorange)
  (set! (.-Ginsnop arch) ginsnop)

  (set! (.-SSAMarkMoves arch) ^{:go/end 25} (fn [^{:tag (* ssagen/State)} s ^{:tag (* ssa/Block)} b]))
  (set! (.-SSAGenValue arch) ssaGenValue)
  (set! (.-SSAGenBlock arch) ssaGenBlock))

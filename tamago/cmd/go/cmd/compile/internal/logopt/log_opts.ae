^{:go/end 253} (go/func LogJsonOption "LogJsonOption parses and validates the version,directory value attached to the -json compiler flag.\n" [^string flagValue]
  (let [(values version directory) (parseLogFlag "json" flagValue)]
    (when (!= version 0)
      (log/Fatal "-json version must be 0"))

    (set! dest (checkLogPath directory))
    (set! Format Json0)))




^{:go/end 272} (go/func parseLogFlag "parseLogFlag checks the flag passed to -json\nfor version,destination format and returns the two parts.\n" [^string flag ^string value] :results [^int version ^string directory]
  (when (!= Format None)
    (log/Fatal "Cannot repeat -json flag"))

  (let [commaAt (strings/Index value ",")]
    (when (<= commaAt 0)
      (log/Fatalf "-%s option should be '<version>,<destination>' where <version> is a number" flag))

    (let [(values v err) (strconv/Atoi (subslice value _ commaAt))]
      (when (!= err nil)
        (log/Fatalf "-%s option should be '<version>,<destination>' where <version> is a number: err=%v" flag err))

      (set! version v)
      (set! directory (subslice value (+ commaAt 1)))
      (return))))







^{:go/end 284} (go/func isWindowsDriveURIPath "isWindowsDriveURIPath returns true if the file URI is of the format used by\nWindows URIs. The url.Parse package does not specially handle Windows paths\n(see golang/go#6027), so we check if the URI path has a drive prefix (e.g. \"/C:\").\n(copied from tools/internal/span/uri.go)\nthis is less comprehensive that the processing in filepath.IsAbs on Windows.\n" ^bool [^string uri]
  (when (< (len uri) 4)
    (return false))

  (and (== (aget uri 0) \/) (unicode/IsLetter (conv rune (aget uri 1))) (== (aget uri 2) \:)))


^{:go/end 304} (go/func parseLogPath [^string destination] :results [string string]
  (when (filepath/IsAbs destination)
    (return (filepath/Clean destination) ""))

  (when (strings/HasPrefix destination "file://") ; IKWIAD, or Windows C:\foo\bar\baz
    (let [(values uri err) (url/Parse destination)]
      (when (!= err nil)
        (return "" (fmt/Sprintf "optimizer logging destination looked like file:// URI but failed to parse: err=%v" err)))

      (set! destination (+ (.-Host uri) (.-Path uri)))
      (when (isWindowsDriveURIPath destination)
        ;; strip leading / from /C:
        ;; unlike tools/internal/span/uri.go, do not uppercase the drive letter -- let filepath.Clean do what it does.
        (set! destination (subslice destination 1)))

      (return (filepath/Clean destination) "")))

  (return "" (fmt/Sprintf "optimizer logging destination %s was neither %s-prefixed directory nor file://-prefixed file URI" destination (conv string filepath/Separator))))





^{:go/end 319} (go/func checkLogPath "checkLogPath does superficial early checking of the string specifying\nthe directory to which optimizer logging is directed, and if\nit passes the test, stores the string in LO_dir.\n" ^string [^string destination]
  (let [(values path complaint) (parseLogPath destination)]
    (when (!= complaint "")
      (log/Fatal complaint))

    (let [err (os/MkdirAll path 0755)]
      (when (!= err nil)
        (log/Fatalf "optimizer logging destination '<version>,<directory>' but could not create <directory>: err=%v" err))

      ^{:line 318} path)))


(go/var ^{:tag (slice (* LoggedOpt))} loggedOpts)
(go/var mu (lit sync/Mutex)) ; mu protects loggedOpts.





^{:go/end 331} (go/func NewLoggedOpt "NewLoggedOpt allocates a new LoggedOpt, to later be passed to either NewLoggedOpt or LogOpt as \"args\".\nPos is the source position (including inlining), what is the message, pass is which pass created the message,\nfuncName is the name of the function\nA typical use for this to accumulate an explanation for a missed optimization, for example, why did something escape?\n" ^{:tag (* LoggedOpt)} [^src/XPos pos ^src/XPos lastPos ^string what ^string pass ^string funcName & ^{:tag (slice any)} args]
  (set! pass (strings/ReplaceAll pass " " "_"))
  (addr (lit LoggedOpt pos lastPos pass funcName what args)))





^{:go/end 345} (go/func LogOpt "LogOpt logs information about a (usually missed) optimization performed by the compiler.\nPos is the source position (including inlining), what is the message, pass is which pass created the message,\nfuncName is the name of the function.\n" [^src/XPos pos ^string what ^string pass ^string funcName & ^{:tag (slice any)} args]
  (when (== Format None)
    (return))

  (let [lo (NewLoggedOpt pos pos what pass funcName (spread args))]
    (.Lock mu)
    (defer (.Unlock mu))
    ;; Because of concurrent calls from back end, no telling what the order will be, but is stable-sorted by outer Pos before use.
    (set! loggedOpts (append loggedOpts lo))))





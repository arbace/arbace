(go/const



  ^{:line 172} [^{:tag DiagnosticSeverity :val 3 :doc "SeverityInformation defined:\n\t * Reports an information.\n"} SeverityInformation 3])



(go/type DiagnosticTag "DiagnosticTag defines constants\n" uint)





(go/type Diagnostic "Diagnostic defined:\n * Represents a diagnostic, such as a compiler error or warning. Diagnostic objects\n * are only valid in the scope of a resource.\n" (struct




    ^{:line 187 :tag Range :go/tag "json:\"range\"" :doc "Range defined:\n\t * The range at which the message applies\n"} Range





    ^{:line 193 :tag DiagnosticSeverity :go/tag "json:\"severity,omitempty\"" :doc "Severity defined:\n\t * The diagnostic's severity. Can be omitted. If omitted it is up to the\n\t * client to interpret diagnostics as error, warning, info or hint.\n"} Severity ; always SeverityInformation for optimizer logging.




    ^{:line 198 :tag string :go/tag "json:\"code,omitempty\"" :doc "Code defined:\n\t * The diagnostic's code, which usually appear in the user interface.\n"} Code ; LSP uses 'number | string' = gopls interface{}, but only string here, e.g. "boundsCheck", "nilcheck", etc.






    ^{:line 205 :tag string :go/tag "json:\"source,omitempty\"" :doc "Source defined:\n\t * A human-readable string describing the source of this\n\t * diagnostic, e.g. 'typescript' or 'super lint'. It usually\n\t * appears in the user interface.\n"} Source ; "go compiler"




    ^{:line 210 :tag string :go/tag "json:\"message\"" :doc "Message defined:\n\t * The diagnostic's message. It usually appears in the user interface\n"} Message ; sometimes used, provides additional information.




    ^{:line 215 :tag (slice DiagnosticTag) :go/tag "json:\"tags,omitempty\"" :doc "Tags defined:\n\t * Additional metadata about the diagnostic.\n"} Tags ; always empty for logging optimizations.





    ^{:line 221 :tag (slice DiagnosticRelatedInformation) :go/tag "json:\"relatedInformation,omitempty\"" :doc "RelatedInformation defined:\n\t * An array of related diagnostic information, e.g. when symbol-names within\n\t * a scope collide all definitions can be marked via this property.\n"} RelatedInformation))




(go/type LoggedOpt "A LoggedOpt is what the compiler produces and accumulates,\nto be converted to JSON for human or IDE consumption.\n" (struct
    ^{:line 227 :tag src/XPos} pos ; Source code position at which the event occurred. If it is inlined, outer and all inlined locations will appear in JSON.
    ^{:line 228 :tag src/XPos} lastPos ; Usually the same as pos; current exception is for reporting entire range of transformed loops
    ^{:line 229 :tag string} compilerPass ; Compiler pass.  For human/adhoc consumption; does not appear in JSON (yet)
    ^{:line 230 :tag string} functionName ; Function name.  For human/adhoc consumption; does not appear in JSON (yet)
    ^{:line 231 :tag string} what ; The (non) optimization; "nilcheck", "boundsCheck", "inline", "noInline"
    ^{:line 232 :tag (slice any)} target)) ; Optional target(s) or parameter(s) of "what" -- what was inlined, why it was not, size of copy, etc. 1st is most important/relevant.



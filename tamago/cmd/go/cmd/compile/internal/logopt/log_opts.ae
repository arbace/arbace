    ^{:line 118 :tag uint :go/tag "json:\"line\""} Line ; gopls uses float64, but json output is the same for integers
    ^{:line 119 :tag uint :go/tag "json:\"character\""} Character)) ; gopls uses float64, but json output is the same for integers






(go/type Range "A Range in a text document expressed as (zero-based) start and end positions.\nA range is comparable to a selection in an editor. Therefore the end position is exclusive.\nIf you want to specify a range that contains a line including the line ending character(s)\nthen use an end position denoting the start of the next line.\n" (struct



    ^{:line 130 :tag Position :go/tag "json:\"start\"" :doc "Start defined:\n\t * The range's start position\n"} Start




    ^{:line 135 :tag Position :go/tag "json:\"end\"" :doc "End defined:\n\t * The range's end position\n"} End)) ; exclusive



(go/type Location "A Location represents a location inside a resource, such as a line inside a text file.\n" (struct

    ^{:line 141 :tag DocumentURI :go/tag "json:\"uri\"" :doc "URI is\n"} URI


    ^{:line 144 :tag Range :go/tag "json:\"range\"" :doc "Range is\n"} Range))







(go/type DiagnosticRelatedInformation " DiagnosticRelatedInformation defined:\n * Represents a related message and source code location for a diagnostic. This should be\n * used to point to code locations that cause or related to a diagnostics, e.g when duplicating\n * a symbol in a scope.\n" (struct




    ^{:line 157 :tag Location :go/tag "json:\"location\"" :doc "Location defined:\n\t * The location of this related diagnostic information.\n"} Location




    ^{:line 162 :tag string :go/tag "json:\"message\"" :doc "Message defined:\n\t * The message of this related diagnostic information.\n"} Message))




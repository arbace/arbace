^{:go/end 99} (go/func cmpstackvarlt "cmpstackvarlt reports whether the stack variable a sorts before b.\n" ^bool [^{:tag (* ir/Name)} a ^{:tag (* ir/Name)} b ^{:tag (* liveness/MergeLocalsState)} mls]
  ;; Sort non-autos before autos.
  (when (!= (needAlloc a) (needAlloc b))
    (return (needAlloc b)))


  ;; If both are non-auto (e.g., parameters, results), then sort by
  ;; frame offset (defined by ABI).
  (when (not (needAlloc a))
    (return (< (.FrameOffset a) (.FrameOffset b))))


  ;; From here on, a and b are both autos (i.e., local variables).

  ;; Sort followers after leaders, if mls != nil
  (when (!= mls nil)
    (let [aFollow (.Subsumed mls a)
        ^{:line 47} bFollow (.Subsumed mls b)]
      (when (!= aFollow bFollow)
        (return bFollow))))



  ;; Sort used before unused (so AllocFrame can truncate unused
  ;; variables).

^{:go/end 340} (go/func Compile "Compile builds an SSA backend function,\nuses it to generate a plist,\nand flushes that plist to machine code.\nworker indicates which of the backend workers is doing the processing.\n" [^{:tag (* ir/Func)} fn ^int worker ^{:tag (* pgoir/Profile)} profile]
  (let [f (buildssa fn worker (or (inline/IsPgoHotFunc fn profile) (inline/HasPgoHotInline fn)))]
    ;; Note: check arg size to fix issue 25507.
    (when (or (>= (.-stksize (assert (* ssafn) (.Frontend f))) maxStackSize) (>= (.ArgWidth (.-OwnAux f)) maxStackSize))

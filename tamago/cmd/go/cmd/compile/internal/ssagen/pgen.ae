^{:go/end 423} (go/func fieldtrack "fieldtrack adds R_USEFIELD relocations to fnsym to record any\nstruct fields that it used.\n" [^{:tag (* obj/LSym)} fnsym ^{:tag (map (* obj/LSym) (struct))} tracked]

        ^{:go/via [miniExpr]} (.SetType call (.ResultsTuple ft)))

      (let [n (ir/NewReturnStmt base/Pos nil)]
        (set! (.-Results n) (lit (slice ir/Node) call))
        (set! ret n)))

    (.Append (.-Body fn) ret)


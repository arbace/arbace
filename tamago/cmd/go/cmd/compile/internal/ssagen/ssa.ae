^{:go/end 228} (go/func AbiForBodylessFuncStackMap "AbiForBodylessFuncStackMap returns the ABI for a bodyless function's stack map.\nThis is not necessarily the ABI used to call it.\nCurrently (1.17 dev) such a stack map is always ABI0;\nany ABI wrapper that is present is nosplit, hence a precise\nstack map is not needed there (the parameters survive only long\nenough to call the wrapped assembly function).\n" ^{:tag (* abi/ABIConfig)} [^{:tag (* ir/Func)} fn]
  (.-ABI0 ssaConfig))




^{:go/end 257} (go/func abiForFunc "abiForFunc implements ABI policy for a function.\nPassing a nil function returns the default ABI based on experiment configuration.\n" ^{:tag (* abi/ABIConfig)} [^{:tag (* ir/Func)} fn ^{:tag (* abi/ABIConfig)} abi0 ^{:tag (* abi/ABIConfig)} abi1]
  (when ^{:go/via [Flags]} (.-RegabiArgs buildcfg/Experiment)
    ;; Select the ABI based on the function's defining ABI.
    (when (== fn nil)
      (return abi1))

    (switch (.-ABI fn)
      (case [obj/ABI0]
        (return abi0))
      (case [obj/ABIInternal]
        ;; TODO(austin): Clean up the nomenclature here.
        ;; It's not clear that "abi1" is ABIInternal.
        (return abi1)))

    (base/Fatalf "function %v has unknown ABI %v" fn (.-ABI fn))
    (panic "not reachable"))


  (let [a abi0]
    (when (!= fn nil)
      (when (!= (bit-and (.-Pragma fn) ir/RegisterParams) 0) ; TODO(register args) remove after register abi is working
        (set! a abi1)))


    ^{:line 256} a))













^{:go/end 290} (go/method emitOpenDeferInfo "emitOpenDeferInfo emits FUNCDATA information about the defers in a function\nthat is using open-coded defers.  This funcdata is used to determine the active\ndefers in a function and execute those defers during panic processing.\n\nThe funcdata is all encoded in varints (since values will almost always be less than\n128, but stack offsets could potentially be up to 2Gbyte). All \"locations\" (offsets)\nfor stack variables are specified as the number of bytes below varp (pointer to the\ntop of the local variables) for their starting address. The format is:\n\n  - Offset of the deferBits variable\n  - Offset of the first closure slot (the rest are laid out consecutively).\n" [^{:tag (* state)} s]
  (let [firstOffset (.FrameOffset (.-closureNode (aget (.-openDefers s) 0)))]

    ;; Verify that cmpstackvarlt laid out the slots in order.
    (range [i r (.-openDefers s)]
      (let [have (.FrameOffset (.-closureNode r))
          ^{:line 276} want (+ firstOffset (* (conv int64 i) (conv int64 types/PtrSize)))]
        (when (!= have want)
          (base/FatalfAt ^{:go/via [miniNode]} (.Pos (.-curfn s)) "unexpected frame offset for open-coded defer slot #%v: have %v, want %v" i have want))))



    (let [x (.Lookup base/Ctxt (+ (.-Name (.-LSym (.-curfn s))) ".opendefer"))]
      ^{:go/via [Attribute]} (.Set x obj/AttrContentAddressable true)
      (set! (.-Align x) 1)
      (set! (.-OpenCodedDeferInfo (.Func (.-LSym (.-curfn s)))) x)

      (let [off 0]
        (set! off (objw/Uvarint x off (conv uint64 (- (.FrameOffset (.-deferBitsTemp s))))))
        (set! off (objw/Uvarint x off (conv uint64 (- firstOffset))))))))




^{:go/end 620} (go/func buildssa "buildssa builds an SSA function for fn.\nworker indicates which of the backend workers is doing the processing.\n" ^{:tag (* ssa/Func)} [^{:tag (* ir/Func)} fn ^int worker ^bool isPgoHot]
  (let [name (ir/FuncName fn)

      ^{:line 297} abiSelf (abiForFunc fn (.-ABI0 ssaConfig) (.-ABI1 ssaConfig))

      ^{:line 299} printssa false]
    ;; match either a simple name e.g. "(*Reader).Reset", package.name e.g. "compress/gzip.(*Reader).Reset", or subpackage name "gzip.(*Reader).Reset"
    ;; optionally allows an ABI suffix specification in the GOSSAHASH, e.g. "(*Reader).Reset<0>" etc
    (when (strings/Contains ssaDump name) ; in all the cases the function name is entirely contained within the GOSSAFUNC string.
      (let [nameOptABI name]
        (if [l (len ssaDump)] (and (> l 1) (== (aget ssaDump (- l 2)) \,)) ; ABI specification
          (set! nameOptABI (ssa/FuncNameABI name (.Which abiSelf)))
          (when (strings/HasSuffix ssaDump ">") ; if they use the linker syntax instead....
            (let [l (len ssaDump)]
              (when (and (>= l 3) (== (aget ssaDump (- l 3)) \<))
                (set! nameOptABI (ssa/FuncNameABI name (.Which abiSelf)))
                (set! ssaDump (+ (subslice ssaDump _ (- l 3)) "," (subslice ssaDump (- l 2) (- l 1))))))))


        (let [pkgDotName (+ (.-Pkgpath base/Ctxt) "." nameOptABI)]
          (set! printssa (or (== nameOptABI ssaDump) ; "(*Reader).Reset"
              (== pkgDotName ssaDump) ; "compress/gzip.(*Reader).Reset"
              (and (strings/HasSuffix pkgDotName ssaDump) (strings/HasSuffix pkgDotName (+ "/" ssaDump)))))))) ; "gzip.(*Reader).Reset"


    (let [^{:tag (* bytes/Buffer)} astBuf (zero (* bytes/Buffer))]
      (when printssa
        (set! astBuf (addr (lit bytes/Buffer)))
        (ir/FDumpList astBuf "buildssa-body" (.-Body fn))
        (when ssaDumpStdout
          (fmt/Println "generating SSA for" name)
          (fmt/Print (.String astBuf))))



      (let [^state s (zero state)]
        (.pushLine s ^{:go/via [miniNode]} (.Pos fn))
        (defer (.popLine s))

        (set! (.-hasdefer s) (.HasDefer fn))
        (when (!= (bit-and (.-Pragma fn) ir/CgoUnsafeArgs) 0)
          (set! (.-cgoUnsafeArgs s) true))

        (set! (.-checkPtrEnabled s) (ir/ShouldCheckPtr fn 1))

        (when (and (.-Instrumenting (.-Cfg base/Flag)) (== (bit-and (.-Pragma fn) ir/Norace) 0) (not ^{:go/via [Attribute]} (.ABIWrapper (.Linksym fn))))
          (when (or (not (.-Race base/Flag)) (not (.-NoRaceFunc (objabi/LookupPkgSpecial (.-Path (.-Pkg (.Sym fn)))))))
            (set! (.-instrumentMemory s) true)
            (when (.-Race base/Flag)
              (set! (.-instrumentEnterExit s) true))))




        (let [fe ^{:go/breaks [2 4]} (lit ssafn
              :curfn fn
              :log (and printssa ssaDumpStdout))]

          (set! (.-curfn s) fn)

          (let [cache (addr (aget ssaCaches worker))]
            (.Reset cache)

            (set! (.-f s) (.NewFunc ssaConfig (addr fe) cache))
            (set! (.-config s) ssaConfig)
            (set! (.-Type (.-f s)) (.Type fn))
            (set! (.-Name (.-f s)) name)
            (set! (.-PrintOrHtmlSSA (.-f s)) printssa)
            (when (!= (bit-and (.-Pragma fn) ir/Nosplit) 0)
              (set! (.-NoSplit (.-f s)) true))

            (set! (.-ABI0 (.-f s)) (.-ABI0 ssaConfig))
            (set! (.-ABI1 (.-f s)) (.-ABI1 ssaConfig))
            (set! (.-ABIDefault (.-f s)) (abiForFunc nil (.-ABI0 ssaConfig) (.-ABI1 ssaConfig)))
            (set! (.-ABISelf (.-f s)) abiSelf)

            (set! (.-panics s) (lit (map funcLine (* ssa/Block))))
            (set! (.-softFloat s) (.-SoftFloat (.-config s)))

            ;; Allocate starting block
            (set! (.-Entry (.-f s)) (.NewBlock (.-f s) ssa/BlockPlain))
            (set! (.-Pos (.-Entry (.-f s))) ^{:go/via [miniNode]} (.Pos fn))
            (set! (.-IsPgoHot (.-f s)) isPgoHot)

            (when printssa
              (let [ssaDF ssaDumpFile]
                (when (!= ssaDir "")
                  (set! ssaDF (filepath/Join ssaDir (+ (.-Pkgpath base/Ctxt) "." (.NameABI (.-f s)) ".html")))
                  (let [ssaD (filepath/Dir ssaDF)]
                    (os/MkdirAll ssaD 0755)))

                (set! (.-HTMLWriter (.-f s)) (ssa/NewHTMLWriter ssaDF (.-f s) ssaDumpCFG))
                ;; TODO: generate and print a mapping from nodes to values and blocks
                (dumpSourcesColumn (.-HTMLWriter (.-f s)) fn)
                (.WriteAST (.-HTMLWriter (.-f s)) "AST" astBuf)))


            ;; Allocate starting values
            (set! (.-labels s) (lit (map string (* ssaLabel))))
            (set! (.-fwdVars s) (lit (map ir/Node (* ssa/Value))))
            (set! (.-startmem s) (.entryNewValue0 s ssa/OpInitMem types/TypeMem))

            (set! (.-hasOpenDefers s) (and (== (.-N base/Flag) 0) (.-hasdefer s) (not (.OpenCodedDeferDisallowed (.-curfn s)))))
            (switch
              (case [(!= (.-NoOpenDefer base/Debug) 0)]
                (set! (.-hasOpenDefers s) false))
              (case [(and (.-hasOpenDefers s) ^:go/paren (or (.-Flag_shared base/Ctxt) (.-Flag_dynlink base/Ctxt)) (== ^{:go/via [Arch]} (.-Name (.-Arch base/Ctxt)) "386"))]
                ;; Don't support open-coded defers for 386 ONLY when using shared
                ;; libraries, because there is extra code (added by rewriteToUseGot())
                ;; preceding the deferreturn/ret code that we don't track correctly.
                ;;
                ;; TODO this restriction can be removed given adjusted offset in computeDeferReturn in cmd/link/internal/ld/pcln.go
                (set! (.-hasOpenDefers s) false)))

            (when (and (.-hasOpenDefers s) (.-instrumentEnterExit s))
              ;; Skip doing open defers if we need to instrument function
              ;; returns for the race detector, since we will not generate that
              ;; code in the case of the extra deferreturn/ret segment.
              (set! (.-hasOpenDefers s) false))

            (when (.-hasOpenDefers s)
              ;; Similarly, skip if there are any heap-allocated result
              ;; parameters that need to be copied back to their stack slots.
              (range [_ f (.Results (.Type (.-curfn s)))]
                (when (not (.OnStack (assert (* ir/Name) (.-Nname f))))
                  (set! (.-hasOpenDefers s) false)
                  (break))))



            (when (and (.-hasOpenDefers s)
                (> (* (.-NumReturns (.-curfn s)) (.-NumDefers (.-curfn s))) 15))
              ;; Since we are generating defer calls at every exit for
              ;; open-coded defers, skip doing open-coded defers if there are
              ;; too many returns (especially if there are multiple defers).

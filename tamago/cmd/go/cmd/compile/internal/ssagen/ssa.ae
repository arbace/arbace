^{:go/end 78} (go/func InitEnv []
  (set! ssaDump (os/Getenv "GOSSAFUNC"))
  (set! ssaDir (os/Getenv "GOSSADIR"))
  (when (!= ssaDump "")
    (when (strings/HasSuffix ssaDump "+")
      (set! ssaDump (subslice ssaDump _ (- (len ssaDump) 1)))
      (set! ssaDumpStdout true))

    (let [spl (strings/Split ssaDump ":")]
      (when (> (len spl) 1)
        (set! ssaDump (aget spl 0))
        (set! ssaDumpCFG (aget spl 1))))))





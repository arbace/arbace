^{:go/end 2637} (go/method concreteEtype ^types/Kind [^{:tag (* state)} s ^{:tag (* types/Type)} t]
  (let [e (.Kind t)]
    (switch e
      (default
        (return e))
      (case [types/TINT]
        (when (== (.-PtrSize (.-config s)) 8)
          (return types/TINT64))

        (return types/TINT32))
      (case [types/TUINT]
        (when (== (.-PtrSize (.-config s)) 8)
          (return types/TUINT64))

        (return types/TUINT32))
      (case [types/TUINTPTR]
        (when (== (.-PtrSize (.-config s)) 8)
          (return types/TUINT64))

        (return types/TUINT32)))))




  (set! (.-reachable s) (ssa/ReachableBlocks (.-f s)))

  ;; Find FwdRef ops.
  (range [_ b (.-Blocks (.-f s))]
    (range [_ v (.-Values b)]
      (when (!= (.-Op v) ssa/OpFwdRef)
        (continue))

      (set! (.-fwdrefs s) (append (.-fwdrefs s) v))
      (let [var_ (.-N (assert fwdRefAux (.-Aux v)))]
        (when [(values _ ok) (aget (aget (.-defvars s) (.-ID b)) var_)] (not ok)
          (aset (aget (.-defvars s) (.-ID b)) var_ v))))) ; treat FwdDefs as definitions.




  (let [^{:tag (slice (* ssa/Value))} args (zero (slice (* ssa/Value)))]

    (label :loop
      (while (> (len (.-fwdrefs s)) 0)
        (let [v (aget (.-fwdrefs s) (- (len (.-fwdrefs s)) 1))]
          (set! (.-fwdrefs s) (subslice (.-fwdrefs s) _ (- (len (.-fwdrefs s)) 1)))

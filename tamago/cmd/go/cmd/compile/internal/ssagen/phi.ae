^{:go/end 50} (go/method insertPhis "insertPhis finds all the places in the function where a phi is\nnecessary and inserts them.\nUses FwdRef ops to find all uses of variables, and s.defvars to find\nall definitions.\nPhi values are inserted, and all FwdRefs are changed to a Copy\nof the appropriate phi or definition.\nTODO: make this part of cmd/compile/internal/ssa somehow?\n" [^{:tag (* state)} s]
  (when (<= (len (.-Blocks (.-f s))) smallBlocks)
    (let [sps (lit simplePhiState :s s :f (.-f s) :defvars (.-defvars s))]
      (.insertPhis sps)
      (return)))

  (let [ps (lit phiState :s s :f (.-f s) :defvars (.-defvars s))]
    (.insertPhis ps)))


(go/type phiState (struct
    ^{:line 53 :tag (* state)} s ; SSA state
    ^{:line 54 :tag (* ssa/Func)} f ; function to work on
    ^{:line 55 :tag (slice (map ir/Node (* ssa/Value)))} defvars ; defined variables at end of each block

    ^{:line 57 :tag (map ir/Node int32)} varnum ; variable numbering


    ^{:line 60 :tag (slice (* ssa/Block)) :doc "properties of the dominator tree\n"} idom ; dominator parents
    ^{:line 61 :tag (slice domBlock)} tree ; dominator child+sibling
    ^{:line 62 :tag (slice int32)} level ; level in dominator tree (0 = root or unreachable, 1 = children of root, ...)


    ^{:line 65 :tag blockHeap :doc "scratch locations\n"} priq ; priority queue of blocks, higher level (toward leaves) = higher priority
    ^{:line 66 :tag (slice (* ssa/Block))} q ; inner loop queue
    ^{:line 67 :tag (* sparseSet)} queued ; has been put in q
    ^{:line 68 :tag (* sparseSet)} hasPhi ; has a phi
    ^{:line 69 :tag (* sparseSet)} hasDef ; has a write of the variable we're processing


    ^{:line 72 :tag (* ssa/Value) :doc "miscellaneous\n"} placeholder)) ; value to use as a "not set yet" placeholder.


^{:go/end 199} (go/method insertPhis [^{:tag (* phiState)} s]
  (when debugPhi
    (fmt/Println (.String (.-f s))))


  ;; Find all the variables for which we need to match up reads & writes.
  ;; This step prunes any basic-block-only variables from consideration.
  ;; Generate a numbering for these variables.
  (set! (.-varnum s) (lit (map ir/Node int32)))
  (let [^{:tag (slice ir/Node)} vars (zero (slice ir/Node))
      ^{:line 85 :tag (slice (* types/Type))} vartypes (zero (slice (* types/Type)))]
    (range [_ b (.-Blocks (.-f s))]
      (range [_ v (.-Values b)]
        (when (!= (.-Op v) ssa/OpFwdRef)
          (continue))

        (let [var_ (.-N (assert fwdRefAux (.-Aux v)))]

          ;; Optimization: look back 1 block for the definition.
          (when (== (len (.-Preds b)) 1)
            (let [c (.Block (aget (.-Preds b) 0))]
              (when [w (aget (aget (.-defvars s) (.-ID c)) var_)] (!= w nil)
                (set! (.-Op v) ssa/OpCopy)
                (set! (.-Aux v) nil)
                (.AddArg v w)
                (continue))))



          (when [(values _ ok) (aget (.-varnum s) var_)] ok
            (continue))

          (aset (.-varnum s) var_ (conv int32 (len vartypes)))
          (when debugPhi
            (fmt/Printf "var%d = %v\n" (len vartypes) var_))

          (set! vars (append vars var_))
          (set! vartypes (append vartypes (.-Type v))))))



    (when (== (len vartypes) 0)
      (return))


    ;; Find all definitions of the variables we need to process.
    ;; defs[n] contains all the blocks in which variable number n is assigned.
    (let [defs (make (slice (slice (* ssa/Block))) (len vartypes))]
      (range [_ b (.-Blocks (.-f s))]
        (range [var_ (aget (.-defvars s) (.-ID b))] ; TODO: encode defvars some other way (explicit ops)? make defvars[n] a slice instead of a map.
          (when [(values n ok) (aget (.-varnum s) var_)] ok
            (aset defs n (append (aget defs n) b)))))




      ;; Make dominator tree.
      (set! (.-idom s) (.Idom (.-f s)))
      (set! (.-tree s) (make (slice domBlock) (.NumBlocks (.-f s))))
      (range [_ b (.-Blocks (.-f s))]
        (let [p (aget (.-idom s) (.-ID b))]
          (when (!= p nil)
            (set! (.-sibling (aget (.-tree s) (.-ID b))) (.-firstChild (aget (.-tree s) (.-ID p))))
            (set! (.-firstChild (aget (.-tree s) (.-ID p))) b))))


      ;; Compute levels in dominator tree.
      ;; With parent pointers we can do a depth-first walk without
      ;; any auxiliary storage.
      (set! (.-level s) (make (slice int32) (.NumBlocks (.-f s))))
      (let [b (.-Entry (.-f s))]
        (label :levels
          (while true
            (when [p (aget (.-idom s) (.-ID b))] (!= p nil)
              (aset (.-level s) (.-ID b) (+ (aget (.-level s) (.-ID p)) 1))
              (when debugPhi
                (fmt/Printf "level %s = %d\n" b (aget (.-level s) (.-ID b)))))


            (when [c (.-firstChild (aget (.-tree s) (.-ID b)))] (!= c nil)
              (set! b c)
              (continue))

            (while true
              (when [c (.-sibling (aget (.-tree s) (.-ID b)))] (!= c nil)
                (set! b c)
                (continue :levels))

              (set! b (aget (.-idom s) (.-ID b)))
              (when (== b nil)
                (break :levels)))))




        ;; Allocate scratch locations.
        (set! (.-level (.-priq s)) (.-level s))
        (set! (.-q s) (make (slice (* ssa/Block)) 0 (.NumBlocks (.-f s))))
        (set! (.-queued s) (newSparseSet (.NumBlocks (.-f s))))
        (set! (.-hasPhi s) (newSparseSet (.NumBlocks (.-f s))))
        (set! (.-hasDef s) (newSparseSet (.NumBlocks (.-f s))))
        (set! (.-placeholder s) (.entryNewValue0 (.-s s) ssa/OpUnknown types/TypeInvalid))

        ;; Generate phi ops for each variable.
        (range [n vartypes]
          (.insertVarPhis s n (aget vars n) (aget defs n) (aget vartypes n)))


        ;; Resolve FwdRefs to the correct write or phi.
        (.resolveFwdRefs s)

        ;; Erase variable numbers stored in AuxInt fields of phi ops. They are no longer needed.
        (range [_ b (.-Blocks (.-f s))]
          (range [_ v (.-Values b)]
            (when (== (.-Op v) ssa/OpPhi)
              (set! (.-AuxInt v) 0))

            ;; Any remaining FwdRefs are dead code.
            (when (== (.-Op v) ssa/OpFwdRef)
              (set! (.-Op v) ssa/OpUnknown)
              (set! (.-Aux v) nil))))))))





^{:go/end 284} (go/method insertVarPhis [^{:tag (* phiState)} s ^int n ^ir/Node var_ ^{:tag (slice (* ssa/Block))} defs ^{:tag (* types/Type)} typ]
  (let [priq (addr (.-priq s))
      ^{:line 203} q (.-q s)
      ^{:line 204} queued (.-queued s)]
    (.clear queued)
    (let [hasPhi (.-hasPhi s)]
      (.clear hasPhi)
      (let [hasDef (.-hasDef s)]
        (.clear hasDef)

        ;; Add defining blocks to priority queue.
        (range [_ b defs]
          (set! (.-a priq) (append (.-a priq) b))
          (.add hasDef (.-ID b))
          (when debugPhi
            (fmt/Printf "def of var%d in %s\n" n b)))


        (heap/Init priq)

        ;; Visit blocks defining variable n, from deepest to shallowest.
        (while (> (len (.-a priq)) 0)
          (let [currentRoot (assert (* ssa/Block) (heap/Pop priq))]
            (when debugPhi
              (fmt/Printf "currentRoot %s\n" currentRoot))

            ;; Walk subtree below definition.
            ;; Skip subtrees we've done in previous iterations.
            ;; Find edges exiting tree dominated by definition (the dominance frontier).
            ;; Insert phis at target blocks.
            (when (.contains queued (.-ID currentRoot))
              (.Fatalf (.-s s) "root already in queue"))

            (set! q (append q currentRoot))
            (.add queued (.-ID currentRoot))
            (while (> (len q) 0)
              (let [b (aget q (- (len q) 1))]
                (set! q (subslice q _ (- (len q) 1)))
                (when debugPhi
                  (fmt/Printf "  processing %s\n" b))


                (let [currentRootLevel (aget (.-level s) (.-ID currentRoot))]
                  (range [_ e (.-Succs b)]
                    (let [c (.Block e)]
                      ;; TODO: if the variable is dead at c, skip it.
                      (when (> (aget (.-level s) (.-ID c)) currentRootLevel)
                        ;; a D-edge, or an edge whose target is in currentRoot's subtree.
                        (continue))

                      (when (.contains hasPhi (.-ID c))
                        (continue))

                      ;; Add a phi to block c for variable n.
                      (.add hasPhi (.-ID c))
                      (let [v (.NewValue0I c (aget (.-blockStarts (.-s s)) (.-ID b)) ssa/OpPhi typ (conv int64 n))]
                        ;; Note: we store the variable number in the phi's AuxInt field. Used temporarily by phi building.
                        (when (== (.Op var_) ir/ONAME)
                          (.addNamedValue (.-s s) (assert (* ir/Name) var_) v))

                        (range [(.-Preds c)]
                          (.AddArg v (.-placeholder s))) ; Actual args will be filled in by resolveFwdRefs.

                        (when debugPhi
                          (fmt/Printf "new phi for var%d in %s: %s\n" n c v))

                        (when (not (.contains hasDef (.-ID c)))
                          ;; There's now a new definition of this variable in block c.
                          ;; Add it to the priority queue to explore.
                          (heap/Push priq c)
                          (.add hasDef (.-ID c))))))



                  ;; Visit children if they have not been visited yet.
                  (for [c (.-firstChild (aget (.-tree s) (.-ID b)))] (!= c nil) (set! c (.-sibling (aget (.-tree s) (.-ID c))))
                    (when (not (.contains queued (.-ID c)))
                      (set! q (append q c))
                      (.add queued (.-ID c)))))))))))))







^{:go/end 379} (go/method resolveFwdRefs "resolveFwdRefs links all FwdRef uses up to their nearest dominating definition.\n" [^{:tag (* phiState)} s]
  ;; Do a depth-first walk of the dominator tree, keeping track
  ;; of the most-recently-seen value for each variable.

  ;; Map from variable ID to SSA value at the current point of the walk.
  (let [values (make (slice (* ssa/Value)) (len (.-varnum s)))]
    (range [i values]
      (aset values i (.-placeholder s)))


    ;; Stack of work to do.
    (let-type [stackEntry (struct
          ^{:line 299 :tag (* ssa/Block)} b ; block to explore


          ^{:line 302 :tag int32 :doc "variable/value pair to reinstate on exit\n"} n ; variable ID
          ^{:line 303 :tag (* ssa/Value)} v)]

      ;; Note: only one of b or n,v will be set.

      (let [^{:tag (slice stackEntry)} stk (zero (slice stackEntry))]

        (set! stk (append stk (lit stackEntry :b (.-Entry (.-f s)))))
        (while (> (len stk) 0)
          (let [work (aget stk (- (len stk) 1))]
            (set! stk (subslice stk _ (- (len stk) 1)))

            (let [b (.-b work)]
              (when (== b nil)
                ;; On exit from a block, this case will undo any assignments done below.
                (aset values (.-n work) (.-v work))
                (continue))


              ;; Process phis as new defs. They come before FwdRefs in this block.
              (range [_ v (.-Values b)]
                (when (!= (.-Op v) ssa/OpPhi)
                  (continue))

                (let [n (conv int32 (.-AuxInt v))]
                  ;; Remember the old assignment so we can undo it when we exit b.
                  (set! stk (append stk (lit stackEntry :n n :v (aget values n))))
                  ;; Record the new assignment.
                  (aset values n v)))


              ;; Replace a FwdRef op with the current incoming value for its variable.
              (range [_ v (.-Values b)]
                (when (!= (.-Op v) ssa/OpFwdRef)
                  (continue))

                (let [n (aget (.-varnum s) (.-N (assert fwdRefAux (.-Aux v))))]
                  (set! (.-Op v) ssa/OpCopy)
                  (set! (.-Aux v) nil)
                  (.AddArg v (aget values n))))


              ;; Establish values for variables defined in b.
              (range [var_ v (aget (.-defvars s) (.-ID b))]
                (let [(values n ok) (aget (.-varnum s) var_)]
                  (when (not ok)
                    ;; some variable not live across a basic block boundary.
                    (continue))

                  ;; Remember the old assignment so we can undo it when we exit b.
                  (set! stk (append stk (lit stackEntry :n n :v (aget values n))))
                  ;; Record the new assignment.
                  (aset values n v)))


              ;; Replace phi args in successors with the current incoming value.
              (range [_ e (.-Succs b)]
                (let [(values c i) (values (.Block e) (.Index e))]
                  (for [j (- (len (.-Values c)) 1)] (>= j 0) (dec! j)
                    (let [v (aget (.-Values c) j)]
                      (when (!= (.-Op v) ssa/OpPhi)
                        (break)) ; All phis will be at the end of the block during phi building.

                      ;; Only set arguments that have been resolved.
                      ;; For very wide CFGs, this significantly speeds up phi resolution.
                      ;; See golang.org/issue/8225.
                      (when [w (aget values (.-AuxInt v))] (!= (.-Op w) ssa/OpUnknown)
                        (.SetArg v i w))))))




              ;; Walk children in dominator tree.
              (for [c (.-firstChild (aget (.-tree s) (.-ID b)))] (!= c nil) (set! c (.-sibling (aget (.-tree s) (.-ID c))))
                (set! stk (append stk (lit stackEntry :b c)))))))))))






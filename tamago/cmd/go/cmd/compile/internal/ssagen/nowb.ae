(in-ns 'go.cmd.compile.internal.ssagen) (go/file "nowb.go" :imports [


    ^{:line 8} [fmt "fmt"]
    ^{:line 9} [strings "strings"]

    ^{:line 11} [base "cmd/compile/internal/base"]
    ^{:line 12} [ir "cmd/compile/internal/ir"]
    ^{:line 13} [typecheck "cmd/compile/internal/typecheck"]
    ^{:line 14} [types "cmd/compile/internal/types"]
    ^{:line 15} [obj "cmd/internal/obj"]
    ^{:line 16} [src "cmd/internal/src"]])


^{:go/end 21} (go/func EnableNoWriteBarrierRecCheck []
  (set! nowritebarrierrecCheck (newNowritebarrierrecChecker)))


^{:go/end 28} (go/func NoWriteBarrierRecCheck []
  ;; Write barriers are now known. Check the
  ;; call graph.
  (.check nowritebarrierrecCheck)
  (set! nowritebarrierrecCheck nil))


(go/var ^{:tag (* nowritebarrierrecChecker)} nowritebarrierrecCheck)

(go/type nowritebarrierrecChecker (struct



    ^{:line 36 :tag (map (* ir/Func) (slice nowritebarrierrecCall)) :doc "extraCalls contains extra function calls that may not be\nvisible during later analysis. It maps from the ODCLFUNC of\nthe caller to a list of callees.\n"} extraCalls


    ^{:line 39 :tag (* ir/Func) :doc "curfn is the current function during AST walks.\n"} curfn))


(go/type nowritebarrierrecCall (struct
    ^{:line 43 :tag (* ir/Func)} target ; caller or callee
    ^{:line 44 :tag src/XPos} lineno)) ; line of call




^{:go/end 71} (go/func newNowritebarrierrecChecker "newNowritebarrierrecChecker creates a nowritebarrierrecChecker. It\nmust be called before walk.\n" ^{:tag (* nowritebarrierrecChecker)} []
  (let [c (addr ^{:go/breaks [2]} (lit nowritebarrierrecChecker
          :extraCalls (make (map (* ir/Func) (slice nowritebarrierrecCall)))))]


    ;; Find all systemstack calls and record their targets. In
    ;; general, flow analysis can't see into systemstack, but it's
    ;; important to handle it for this check, so we model it
    ;; directly. This has to happen before transforming closures in walk since
    ;; it's a lot harder to work out the argument after.
    (range [_ n (.-Funcs typecheck/Target)]
      (set! (.-curfn c) n)
      (when (.ABIWrapper (.-curfn c))
        ;; We only want "real" calls to these
        ;; functions, not the generated ones within
        ;; their own ABI wrappers.
        (continue))

      (ir/Visit n (.-findExtraCalls c)))

    (set! (.-curfn c) nil)
    ^{:line 70} c))


^{:go/end 102} (go/method findExtraCalls [^{:tag (* nowritebarrierrecChecker)} c ^ir/Node nn]
  (when (!= (.Op nn) ir/OCALLFUNC)
    (return))

  (let [n (assert (* ir/CallExpr) nn)]
    (when (or (== (.-Fun n) nil) (!= (.Op (.-Fun n)) ir/ONAME))
      (return))

    (let [fn (assert (* ir/Name) (.-Fun n))]
      (when (or (!= (.-Class fn) ir/PFUNC) (== (.-Defn fn) nil))
        (return))

      (when (!= (types/RuntimeSymName (.Sym fn)) "systemstack")
        (return))


      (let [^{:tag (* ir/Func)} callee (zero (* ir/Func))
          ^{:line 90} arg (aget (.-Args n) 0)]
        (switch (.Op arg)
          (case [ir/ONAME]
            (let [arg (assert (* ir/Name) arg)]
              (set! callee (assert (* ir/Func) (.-Defn arg)))))
          (case [ir/OCLOSURE]
            (let [arg (assert (* ir/ClosureExpr) arg)]
              (set! callee (.-Func arg))))
          (default
            (base/Fatalf "expected ONAME or OCLOSURE node, got %+v" arg)))

        (aset (.-extraCalls c) (.-curfn c) (append (aget (.-extraCalls c) (.-curfn c)) (lit nowritebarrierrecCall callee ^{:go/via [miniExpr miniNode]} (.Pos n))))))))










^{:go/end 118} (go/method recordCall "recordCall records a call from ODCLFUNC node \"from\", to function\nsymbol \"to\" at position pos.\n\nThis should be done as late as possible during compilation to\ncapture precise call graphs. The target of the call is an LSym\nbecause that's all we know after we start SSA.\n\nThis can be called concurrently for different from Nodes.\n" [^{:tag (* nowritebarrierrecChecker)} c ^{:tag (* ir/Func)} fn ^{:tag (* obj/LSym)} to ^src/XPos pos]
  ;; We record this information on the *Func so this is concurrent-safe.
  (when (== (.-NWBRCalls fn) nil)
    (set! (.-NWBRCalls fn) (new (slice ir/SymAndPos))))

  (set! @(.-NWBRCalls fn) (append @(.-NWBRCalls fn) (lit ir/SymAndPos :Sym to :Pos pos))))


^{:go/end 203} (go/method check [^{:tag (* nowritebarrierrecChecker)} c]
  ;; We walk the call graph as late as possible so we can
  ;; capture all calls created by lowering, but this means we
  ;; only get to see the obj.LSyms of calls. symToFunc lets us
  ;; get back to the ODCLFUNCs.
  (let [symToFunc (make (map (* obj/LSym) (* ir/Func)))
      ;; funcs records the back-edges of the BFS call graph walk. It
      ;; maps from the ODCLFUNC of each function that must not have
      ;; write barriers to the call that inhibits them. Functions
      ;; that are directly marked go:nowritebarrierrec are in this
      ;; map with a zero-valued nowritebarrierrecCall. This also
      ;; acts as the set of marks for the BFS of the call graph.
      ^{:line 132} funcs (make (map (* ir/Func) nowritebarrierrecCall))
      ;; q is the queue of ODCLFUNC Nodes to visit in BFS order.
      ^{:line 134 :tag ir/NameQueue} q (zero ir/NameQueue)]

    (range [_ fn (.-Funcs typecheck/Target)]
      (aset symToFunc (.-LSym fn) fn)

      ;; Make nowritebarrierrec functions BFS roots.
      (when (!= (bit-and (.-Pragma fn) ir/Nowritebarrierrec) 0)
        (aset funcs fn (lit nowritebarrierrecCall))
        (.PushRight q (.-Nname fn)))

      ;; Check go:nowritebarrier functions.
      (when (and (!= (bit-and (.-Pragma fn) ir/Nowritebarrier) 0) (.IsKnown (.-WBPos fn)))
        (base/ErrorfAt (.-WBPos fn) 0 "write barrier prohibited")))



    ;; Perform a BFS of the call graph from all
    ;; go:nowritebarrierrec functions.
    (let [enqueue ^{:go/end 165} (fn [^{:tag (* ir/Func)} src ^{:tag (* ir/Func)} target ^src/XPos pos]
          (when (!= (bit-and (.-Pragma target) ir/Yeswritebarrierrec) 0)
            ;; Don't flow into this function.
            (return))

          (when [(values _ ok) (aget funcs target)] ok
            ;; Already found a path to target.
            (return))


          ;; Record the path.
          (aset funcs target (lit nowritebarrierrecCall :target src :lineno pos))
          (.PushRight q (.-Nname target)))]

      (while (not (.Empty q))
        (let [fn (.-Func (.PopLeft q))]

          ;; Check fn.
          (when (.IsKnown (.-WBPos fn))
            (let [^strings/Builder err (zero strings/Builder)
                ^{:line 172} call (aget funcs fn)]
              (while (!= (.-target call) nil)
                (fmt/Fprintf (addr err) "\n\t%v: called by %v" (base/FmtPos (.-lineno call)) (.-Nname (.-target call)))
                (set! call (aget funcs (.-target call))))

              ;; Seeing this error in a failed CI run? It indicates that
              ;; a function in the runtime package marked nowritebarrierrec
              ;; (the outermost stack element) was found, by a static
              ;; reachability analysis over the fully lowered optimized code,
              ;; to call a function (fn) that involves a write barrier.
              ;;
              ;; Even if the call path is infeasable,
              ;; you will need to reorganize the code to avoid it.
              (base/ErrorfAt (.-WBPos fn) 0 "write barrier prohibited by caller; %v%s" (.-Nname fn) (.String err))
              (continue)))


          ;; Enqueue fn's calls.
          (range [_ callee (aget (.-extraCalls c) fn)]
            (enqueue fn (.-target callee) (.-lineno callee)))

          (when (== (.-NWBRCalls fn) nil)
            (continue))

          (range [_ callee @(.-NWBRCalls fn)]
            (let [target (aget symToFunc (.-Sym callee))]
              (when (!= target nil)
                (enqueue fn target (.-Pos callee))))))))))

      ;; Example:
      ;;
      ;; 	//go:wasmimport a_module add
      ;; 	func importedAdd(a, b uint) uint
      ;;
      ;; will roughly become
      ;;
      ;; 	(import "a_module" "add" (func (param i32 i32) (result i32)))

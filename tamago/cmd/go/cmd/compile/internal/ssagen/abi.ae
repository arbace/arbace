^{:go/end 100} (go/method ReadSymABIs "ReadSymABIs reads a symabis file that specifies definitions and\nreferences of text symbols by ABI.\n\nThe symabis format is a set of lines, where each line is a sequence\nof whitespace-separated fields. The first field is a verb and is\neither \"def\" for defining a symbol ABI or \"ref\" for referencing a\nsymbol using an ABI. For both \"def\" and \"ref\", the second field is\nthe symbol name and the third field is the ABI name, as one of the\nnamed cmd/internal/obj.ABI constants.\n" [^{:tag (* SymABIs)} s ^string file]
  (let [(values data err) (os/ReadFile file)]
    (when (!= err nil)
      (log/Fatalf "-symabis: %v" err))


    (range [lineNum line (strings/Split (conv string data) "\n")]
      (inc! lineNum) ; 1-based
      (set! line (strings/TrimSpace line))
      (when (or (== line "") (strings/HasPrefix line "#"))
        (continue))


      (let [parts (strings/Fields line)]
        (switch (aget parts 0)
          (case ["def" "ref"]
            ;; Parse line.
            (when (!= (len parts) 3)
              (log/Fatalf "%s:%d: invalid symabi: syntax is \"%s sym abi\"" file lineNum (aget parts 0)))

            (let [(values sym abistr) (values (aget parts 1) (aget parts 2))
                (values abi valid) (obj/ParseABI abistr)]
              (when (not valid)
                (log/Fatalf "%s:%d: invalid symabi: unknown abi \"%s\"" file lineNum abistr))


              (set! sym (.canonicalize s sym))

              ;; Record for later.
              (if (== (aget parts 0) "def") (do
                  (aset (.-defs s) sym abi)
                  (inc! (.-DwTextCount base/Ctxt)))

                (set! (aget (.-refs s) sym) bit-or (obj/ABISetOf abi)))))

          (default
            (log/Fatalf "%s:%d: invalid symabi type \"%s\"" file lineNum (aget parts 0))))))))






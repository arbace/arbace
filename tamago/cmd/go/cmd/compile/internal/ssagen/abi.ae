                  (set! (.-ABIRefs fn) bit-or obj/ABISetCallable))


                ;; Double check that cgo-exported symbols don't get
                ;; any wrappers.
                (when (and (> (len cgoExport) 0) (!= (bit-and-not (.-ABIRefs fn) (obj/ABISetOf (.-ABI fn))) 0))

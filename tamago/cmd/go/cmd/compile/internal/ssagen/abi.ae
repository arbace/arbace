                (forEachWrapperABI fn makeABIWrapper)))))))))



^{:go/end 248} (go/func forEachWrapperABI [^{:tag (* ir/Func)} fn ^{:tag (func [^{:tag (* ir/Func)} fn ^obj/ABI wrapperABI])} cb]
  (let [need (bit-and-not (.-ABIRefs fn) (obj/ABISetOf (.-ABI fn)))]

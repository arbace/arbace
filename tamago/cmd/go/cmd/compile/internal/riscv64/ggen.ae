(in-ns 'go.cmd.compile.internal.riscv64) (go/file "ggen.go" :imports [


    ^{:line 8} [base "cmd/compile/internal/base"]
    ^{:line 9} [objw "cmd/compile/internal/objw"]
    ^{:line 10} [types "cmd/compile/internal/types"]
    ^{:line 11} [obj "cmd/internal/obj"]
    ^{:line 12} [riscv "cmd/internal/obj/riscv"]])


^{:go/end 31} (go/func zeroRange ^{:tag (* obj/Prog)} [^{:tag (* objw/Progs)} pp ^{:tag (* obj/Prog)} p ^int64 off ^int64 cnt ^{:tag (* uint32)} _]

  (when (!= (% cnt (conv int64 types/PtrSize)) 0)
    (panic "zeroed region not aligned"))


  ;; Adjust the frame to account for LR.
  (set! off + ^{:go/via [Arch]} (.-FixedFrameSize (.-Arch base/Ctxt)))

  (while (!= cnt 0)
    (set! p (.Append pp p riscv/AMOV obj/TYPE_REG riscv/REG_ZERO 0 obj/TYPE_MEM riscv/REG_SP off))
    (set! cnt - (conv int64 types/PtrSize))
    (set! off + (conv int64 types/PtrSize)))


  ^{:line 30} p)

(in-ns 'go.cmd.compile.internal.riscv64) (go/file "gsubr.go" :imports [


    ^{:line 8} [objw "cmd/compile/internal/objw"]
    ^{:line 9} [obj "cmd/internal/obj"]
    ^{:line 10} [riscv "cmd/internal/obj/riscv"]])


^{:go/end 20} (go/func ginsnop ^{:tag (* obj/Prog)} [^{:tag (* objw/Progs)} pp]
  ;; Hardware nop is ADD $0, ZERO
  (let [p (.Prog pp riscv/AADD)]
    (set! (.-Type (.-From p)) obj/TYPE_CONST)
    (set! (.-Reg p) riscv/REG_ZERO)
    (set! (.-To p) (lit obj/Addr :Type obj/TYPE_REG :Reg riscv/REG_ZERO))
    ^{:line 19} p))

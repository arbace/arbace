        (set! (.-Type (.-From p)) obj/TYPE_SPECIAL)
        (set! (.-Offset (.-From p)) (conv int64 riscv/SPOP_FENCE_W))
        (set! (.-Type (.-To p)) obj/TYPE_SPECIAL)
        (set! (.-Offset (.-To p)) (conv int64 riscv/SPOP_FENCE_W))))

    (case [ssa/OpRISCV64LoweredRound32F ssa/OpRISCV64LoweredRound64F])
    ;; input is already rounded

    (case [ssa/OpClobber ssa/OpClobberReg])
    ;; TODO: implement for clobberdead experiment. Nop is ok for now.

    (default
      (.Fatalf v "Unhandled op %v" (.-Op v)))))



(go/var blockBranch (lit (array ... obj/As)
    ^{:line 1003} [ssa/BlockRISCV64BEQ riscv/ABEQ]
    ^{:line 1004} [ssa/BlockRISCV64BEQZ riscv/ABEQZ]
    ^{:line 1005} [ssa/BlockRISCV64BGE riscv/ABGE]
    ^{:line 1006} [ssa/BlockRISCV64BGEU riscv/ABGEU]
    ^{:line 1007} [ssa/BlockRISCV64BGEZ riscv/ABGEZ]
    ^{:line 1008} [ssa/BlockRISCV64BGTZ riscv/ABGTZ]
    ^{:line 1009} [ssa/BlockRISCV64BLEZ riscv/ABLEZ]
    ^{:line 1010} [ssa/BlockRISCV64BLT riscv/ABLT]
    ^{:line 1011} [ssa/BlockRISCV64BLTU riscv/ABLTU]
    ^{:line 1012} [ssa/BlockRISCV64BLTZ riscv/ABLTZ]
    ^{:line 1013} [ssa/BlockRISCV64BNE riscv/ABNE]
    ^{:line 1014} [ssa/BlockRISCV64BNEZ riscv/ABNEZ]))


^{:go/end 1072} (go/func ssaGenBlock [^{:tag (* ssagen/State)} s ^{:tag (* ssa/Block)} b ^{:tag (* ssa/Block)} next]
  (.SetPos s (.-Pos b))

  (switch (.-Kind b)
    (case [ssa/BlockPlain ssa/BlockDefer]
      (when (!= (.Block (aget (.-Succs b) 0)) next)
        (let [p (.Prog s obj/AJMP)]
          (set! (.-Type (.-To p)) obj/TYPE_BRANCH)
          (set! (.-Branches s) (append (.-Branches s) (lit ssagen/Branch :P p :B (.Block (aget (.-Succs b) 0))))))))

    (case [ssa/BlockExit ssa/BlockRetJmp])
    (case [ssa/BlockRet]
      (.Prog s obj/ARET))
    (case [ssa/BlockRISCV64BEQ ssa/BlockRISCV64BEQZ ssa/BlockRISCV64BNE ssa/BlockRISCV64BNEZ
        ^{:line 1031} ssa/BlockRISCV64BLT ssa/BlockRISCV64BLEZ ssa/BlockRISCV64BGE ssa/BlockRISCV64BGEZ
        ^{:line 1032} ssa/BlockRISCV64BLTZ ssa/BlockRISCV64BGTZ ssa/BlockRISCV64BLTU ssa/BlockRISCV64BGEU]

      (let [as (aget blockBranch (.-Kind b))
          ^{:line 1035} invAs (riscv/InvertBranch as)

          ^{:line 1037 :tag (* obj/Prog)} p (zero (* obj/Prog))]
        (switch next
          (case [(.Block (aget (.-Succs b) 0))]
            (set! p (.Br s invAs (.Block (aget (.-Succs b) 1)))))
          (case [(.Block (aget (.-Succs b) 1))]
            (set! p (.Br s as (.Block (aget (.-Succs b) 0)))))
          (default
            (if (!= (.-Likely b) ssa/BranchUnlikely) (do
                (set! p (.Br s as (.Block (aget (.-Succs b) 0))))
                (.Br s obj/AJMP (.Block (aget (.-Succs b) 1))))
              (do
                (set! p (.Br s invAs (.Block (aget (.-Succs b) 1))))
                (.Br s obj/AJMP (.Block (aget (.-Succs b) 0)))))))



        (set! (.-Type (.-From p)) obj/TYPE_REG)
        (switch (.-Kind b)
          (case [ssa/BlockRISCV64BEQ ssa/BlockRISCV64BNE ssa/BlockRISCV64BLT ssa/BlockRISCV64BGE ssa/BlockRISCV64BLTU ssa/BlockRISCV64BGEU]
            (when (!= (.NumControls b) 2)
              (.Fatalf b "Unexpected number of controls (%d != 2): %s" (.NumControls b) (.LongString b)))

            (set! (.-Reg (.-From p)) (.Reg (aget (.-Controls b) 0)))
            (set! (.-Reg p) (.Reg (aget (.-Controls b) 1))))

          (case [ssa/BlockRISCV64BEQZ ssa/BlockRISCV64BNEZ ssa/BlockRISCV64BGEZ ssa/BlockRISCV64BLEZ ssa/BlockRISCV64BLTZ ssa/BlockRISCV64BGTZ]
            (when (!= (.NumControls b) 1)
              (.Fatalf b "Unexpected number of controls (%d != 1): %s" (.NumControls b) (.LongString b)))

            (set! (.-Reg (.-From p)) (.Reg (aget (.-Controls b) 0)))))))


    (default
      (.Fatalf b "Unhandled block: %s" (.LongString b)))))



^{:go/end 1083} (go/func loadRegResult ^{:tag (* obj/Prog)} [^{:tag (* ssagen/State)} s ^{:tag (* ssa/Func)} f ^{:tag (* types/Type)} t ^int16 reg ^{:tag (* ir/Name)} n ^int64 off]
  (let [p (.Prog s (loadByType t))]
    (set! (.-Type (.-From p)) obj/TYPE_MEM)
    (set! (.-Name (.-From p)) obj/NAME_AUTO)
    (set! (.-Sym (.-From p)) (.Linksym n))
    (set! (.-Offset (.-From p)) (+ (.FrameOffset n) off))
    (set! (.-Type (.-To p)) obj/TYPE_REG)
    (set! (.-Reg (.-To p)) reg)
    ^{:line 1082} p))


^{:go/end 1091} (go/func spillArgReg ^{:tag (* obj/Prog)} [^{:tag (* objw/Progs)} pp ^{:tag (* obj/Prog)} p ^{:tag (* ssa/Func)} f ^{:tag (* types/Type)} t ^int16 reg ^{:tag (* ir/Name)} n ^int64 off]
  (set! p (.Append pp p (storeByType t) obj/TYPE_REG reg 0 obj/TYPE_MEM 0 (+ (.FrameOffset n) off)))
  (set! (.-Name (.-To p)) obj/NAME_PARAM)
  (set! (.-Sym (.-To p)) (.Linksym n))
  (set! (.-Pos p) (.WithNotStmt (.-Pos p)))
  ^{:line 1090} p)


^{:go/end 1101} (go/func zeroOp [^{:tag (* ssagen/State)} s ^obj/As mov ^int16 reg ^int64 off]
  (let [p (.Prog s mov)]
    (set! (.-Type (.-From p)) obj/TYPE_REG)
    (set! (.-Reg (.-From p)) riscv/REG_ZERO)
    (set! (.-Type (.-To p)) obj/TYPE_MEM)
    (set! (.-Reg (.-To p)) reg)
    (set! (.-Offset (.-To p)) off)
    (return)))


^{:go/end 1119} (go/func moveOp [^{:tag (* ssagen/State)} s ^obj/As mov ^int16 dst ^int16 src ^int16 tmp ^int64 off]
  (let [p (.Prog s mov)]
    (set! (.-Type (.-From p)) obj/TYPE_MEM)
    (set! (.-Reg (.-From p)) src)
    (set! (.-Offset (.-From p)) off)
    (set! (.-Type (.-To p)) obj/TYPE_REG)
    (set! (.-Reg (.-To p)) tmp)

    (let [p1 (.Prog s mov)]
      (set! (.-Type (.-From p1)) obj/TYPE_REG)
      (set! (.-Reg (.-From p1)) tmp)
      (set! (.-Type (.-To p1)) obj/TYPE_MEM)
      (set! (.-Reg (.-To p1)) dst)
      (set! (.-Offset (.-To p1)) off)

      (return))))

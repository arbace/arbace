^{:go/end 129} (go/func loadByType ^obj/As [^{:tag (* types/Type)} t]
  (let [width (.Size t)]

    (when (.IsFloat t)
      (switch width
        (case [4]
          (return riscv/AMOVF))
        (case [8]
          (return riscv/AMOVD))
        (default
          (base/Fatalf "unknown float width for load %d in type %v" width t)
          (return 0))))



    (switch width
      (case [1]
        (if (.IsSigned t)
          (return riscv/AMOVB)

          (return riscv/AMOVBU)))

      (case [2]
        (if (.IsSigned t)
          (return riscv/AMOVH)

          (return riscv/AMOVHU)))

      (case [4]
        (if (.IsSigned t)
          (return riscv/AMOVW)

          (return riscv/AMOVWU)))

      (case [8]
        (return riscv/AMOV))
      (default
        (base/Fatalf "unknown width for load %d in type %v" width t)
        (return 0)))))




^{:go/end 160} (go/func storeByType "storeByType returns the store instruction of the given type.\n" ^obj/As [^{:tag (* types/Type)} t]
  (let [width (.Size t)]

    (when (.IsFloat t)
      (switch width
        (case [4]
          (return riscv/AMOVF))
        (case [8]
          (return riscv/AMOVD))
        (default
          (base/Fatalf "unknown float width for store %d in type %v" width t)
          (return 0))))



    (switch width
      (case [1]
        (return riscv/AMOVB))
      (case [2]
        (return riscv/AMOVH))
      (case [4]
        (return riscv/AMOVW))
      (case [8]
        (return riscv/AMOV))
      (default
        (base/Fatalf "unknown width for store %d in type %v" width t)
        (return 0)))))












^{:go/end 182} (go/func largestMove "largestMove returns the largest move instruction possible and its size,\ngiven the alignment of the total size of the move.\n\ne.g., a 16-byte move may use MOV, but an 11-byte move must use MOVB.\n\nNote that the moves may not be on naturally aligned addresses depending on\nthe source and destination.\n\nThis matches the calculation in ssa.moveSize.\n" [^int64 alignment] :results [obj/As int64]
  (switch
    (case [(== (% alignment 8) 0)]
      (return riscv/AMOV 8))
    (case [(== (% alignment 4) 0)]
      (return riscv/AMOVW 4))
    (case [(== (% alignment 2) 0)]
      (return riscv/AMOVH 2))
    (default
      (return riscv/AMOVB 1))))



(go/var fracMovOps (lit (slice obj/As) riscv/AMOVB riscv/AMOVH riscv/AMOVW riscv/AMOV))




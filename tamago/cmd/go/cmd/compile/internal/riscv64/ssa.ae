        ^{:line 424} ssa/OpRISCV64FABSS ssa/OpRISCV64FABSD
        ^{:line 425} ssa/OpRISCV64FMVSX ssa/OpRISCV64FMVXS ssa/OpRISCV64FMVDX ssa/OpRISCV64FMVXD
        ^{:line 426} ssa/OpRISCV64FCVTSW ssa/OpRISCV64FCVTSL ssa/OpRISCV64FCVTWS ssa/OpRISCV64FCVTLS
        ^{:line 427} ssa/OpRISCV64FCVTDW ssa/OpRISCV64FCVTDL ssa/OpRISCV64FCVTWD ssa/OpRISCV64FCVTLD ssa/OpRISCV64FCVTDS ssa/OpRISCV64FCVTSD

^{:go/end 1000} (go/func ssaGenValue [^{:tag (* ssagen/State)} s ^{:tag (* ssa/Value)} v]
  (.SetPos s (.-Pos v))

  (switch (.-Op v)
    (case [ssa/OpInitMem])
    ;; memory arg needs no code
    (case [ssa/OpArg])
    ;; input args need no code
    (case [ssa/OpPhi]
      (ssagen/CheckLoweredPhi v))
    (case [ssa/OpCopy ssa/OpRISCV64MOVDreg]
      (when (.IsMemory (.-Type v))
        (return))

      (let [rs (.Reg (aget (.-Args v) 0))
          ^{:line 205} rd (.Reg v)]
        (when (== rs rd)
          (return))

        (let [as riscv/AMOV]
          (when (.IsFloat (.-Type v))
            (set! as riscv/AMOVD))

          (let [p (.Prog s as)]
            (set! (.-Type (.-From p)) obj/TYPE_REG)
            (set! (.-Reg (.-From p)) rs)
            (set! (.-Type (.-To p)) obj/TYPE_REG)
            (set! (.-Reg (.-To p)) rd)))))
    (case [ssa/OpRISCV64MOVDnop])
    ;; nothing to do
    (case [ssa/OpLoadReg]
      (when (.IsFlags (.-Type v))
        (.Fatalf v "load flags not implemented: %v" (.LongString v))
        (return))

      (let [p (.Prog s (loadByType (.-Type v)))]
        (ssagen/AddrAuto (addr (.-From p)) (aget (.-Args v) 0))
        (set! (.-Type (.-To p)) obj/TYPE_REG)
        (set! (.-Reg (.-To p)) (.Reg v))))
    (case [ssa/OpStoreReg]
      (when (.IsFlags (.-Type v))
        (.Fatalf v "store flags not implemented: %v" (.LongString v))
        (return))

      (let [p (.Prog s (storeByType (.-Type v)))]
        (set! (.-Type (.-From p)) obj/TYPE_REG)
        (set! (.-Reg (.-From p)) (.Reg (aget (.-Args v) 0)))
        (ssagen/AddrAuto (addr (.-To p)) v)))
    (case [ssa/OpArgIntReg ssa/OpArgFloatReg]
      ;; The assembler needs to wrap the entry safepoint/stack growth code with spill/unspill
      ;; The loop only runs once.
      (range [_ a (.-RegArgs (.-Func (.-Block v)))]
        ;; Pass the spill/unspill information along to the assembler, offset by size of
        ;; the saved LR slot.
        (let [addr (ssagen/SpillSlotAddr a riscv/REG_SP ^{:go/via [Arch]} (.-FixedFrameSize (.-Arch base/Ctxt)))]
          (.AddSpill (.FuncInfo s)
            (lit obj/RegSpill :Reg (.-Reg a) :Addr addr :Unspill (loadByType (.-Type a)) :Spill (storeByType (.-Type a))))))

      (set! (.-RegArgs (.-Func (.-Block v))) nil)

      (ssagen/CheckArgReg v))
    (case [ssa/OpSP ssa/OpSB ssa/OpGetG])
    ;; nothing to do
    (case [ssa/OpRISCV64MOVBreg ssa/OpRISCV64MOVHreg ssa/OpRISCV64MOVWreg
        ^{:line 254} ssa/OpRISCV64MOVBUreg ssa/OpRISCV64MOVHUreg ssa/OpRISCV64MOVWUreg]
      (let [a (aget (.-Args v) 0)]
        (while (or (== (.-Op a) ssa/OpCopy) (== (.-Op a) ssa/OpRISCV64MOVDreg))
          (set! a (aget (.-Args a) 0)))

        (let [as (.Asm (.-Op v))
            ^{:line 260} rs (.Reg (aget (.-Args v) 0))
            ^{:line 261} rd (.Reg v)]
          (when (== (.-Op a) ssa/OpLoadReg)
            (let [t (.-Type a)]
              (switch
                (case [(and (== (.-Op v) ssa/OpRISCV64MOVBreg) (== (.Size t) 1) (.IsSigned t))
                    (and (== (.-Op v) ssa/OpRISCV64MOVHreg) (== (.Size t) 2) (.IsSigned t))
                    (and (== (.-Op v) ssa/OpRISCV64MOVWreg) (== (.Size t) 4) (.IsSigned t))
                    (and (== (.-Op v) ssa/OpRISCV64MOVBUreg) (== (.Size t) 1) (not (.IsSigned t)))
                    (and (== (.-Op v) ssa/OpRISCV64MOVHUreg) (== (.Size t) 2) (not (.IsSigned t)))
                    (and (== (.-Op v) ssa/OpRISCV64MOVWUreg) (== (.Size t) 4) (not (.IsSigned t)))]
                  ;; arg is a proper-typed load and already sign/zero-extended
                  (when (== rs rd)
                    (return))

                  (set! as riscv/AMOV))
                (default))))


          (let [p (.Prog s as)]
            (set! (.-Type (.-From p)) obj/TYPE_REG)
            (set! (.-Reg (.-From p)) rs)
            (set! (.-Type (.-To p)) obj/TYPE_REG)
            (set! (.-Reg (.-To p)) rd)))))
    (case [ssa/OpRISCV64ADD ssa/OpRISCV64SUB ssa/OpRISCV64SUBW ssa/OpRISCV64XNOR ssa/OpRISCV64XOR
        ^{:line 285} ssa/OpRISCV64OR ssa/OpRISCV64ORN ssa/OpRISCV64AND ssa/OpRISCV64ANDN
        ^{:line 286} ssa/OpRISCV64SLL ssa/OpRISCV64SLLW ssa/OpRISCV64SRA ssa/OpRISCV64SRAW ssa/OpRISCV64SRL ssa/OpRISCV64SRLW
        ^{:line 287} ssa/OpRISCV64SLT ssa/OpRISCV64SLTU ssa/OpRISCV64MUL ssa/OpRISCV64MULW ssa/OpRISCV64MULH
        ^{:line 288} ssa/OpRISCV64MULHU ssa/OpRISCV64DIV ssa/OpRISCV64DIVU ssa/OpRISCV64DIVW
        ^{:line 289} ssa/OpRISCV64DIVUW ssa/OpRISCV64REM ssa/OpRISCV64REMU ssa/OpRISCV64REMW
        ^{:line 290} ssa/OpRISCV64REMUW
        ^{:line 291} ssa/OpRISCV64ROL ssa/OpRISCV64ROLW ssa/OpRISCV64ROR ssa/OpRISCV64RORW
        ^{:line 292} ssa/OpRISCV64FADDS ssa/OpRISCV64FSUBS ssa/OpRISCV64FMULS ssa/OpRISCV64FDIVS
        ^{:line 293} ssa/OpRISCV64FEQS ssa/OpRISCV64FNES ssa/OpRISCV64FLTS ssa/OpRISCV64FLES
        ^{:line 294} ssa/OpRISCV64FADDD ssa/OpRISCV64FSUBD ssa/OpRISCV64FMULD ssa/OpRISCV64FDIVD
        ^{:line 295} ssa/OpRISCV64FEQD ssa/OpRISCV64FNED ssa/OpRISCV64FLTD ssa/OpRISCV64FLED ssa/OpRISCV64FSGNJD
        ^{:line 296} ssa/OpRISCV64MIN ssa/OpRISCV64MAX ssa/OpRISCV64MINU ssa/OpRISCV64MAXU
        ^{:line 297} ssa/OpRISCV64SH1ADD ssa/OpRISCV64SH2ADD ssa/OpRISCV64SH3ADD
        ^{:line 298} ssa/OpRISCV64CZEROEQZ ssa/OpRISCV64CZERONEZ]
      (let [r (.Reg v)
          ^{:line 300} r1 (.Reg (aget (.-Args v) 0))
          ^{:line 301} r2 (.Reg (aget (.-Args v) 1))
          ^{:line 302} p (.Prog s (.Asm (.-Op v)))]
        (set! (.-Type (.-From p)) obj/TYPE_REG)
        (set! (.-Reg (.-From p)) r2)
        (set! (.-Reg p) r1)
        (set! (.-Type (.-To p)) obj/TYPE_REG)
        (set! (.-Reg (.-To p)) r)))

    (case [ssa/OpRISCV64LoweredFMAXD ssa/OpRISCV64LoweredFMIND ssa/OpRISCV64LoweredFMAXS ssa/OpRISCV64LoweredFMINS]
      ;; Most of FMIN/FMAX result match Go's required behaviour, unless one of the
      ;; inputs is a NaN. As such, we need to explicitly test for NaN
      ;; before using FMIN/FMAX.

      ;; FADD Rarg0, Rarg1, Rout // FADD is used to propagate a NaN to the result in these cases.
      ;; FEQ  Rarg0, Rarg0, Rtmp
      ;; BEQZ Rtmp, end
      ;; FEQ  Rarg1, Rarg1, Rtmp
      ;; BEQZ Rtmp, end
      ;; F(MIN | MAX)

      (let [r0 (.Reg (aget (.-Args v) 0))
          ^{:line 322} r1 (.Reg (aget (.-Args v) 1))
          ^{:line 323} out (.Reg v)
          (values add feq) (values riscv/AFADDD riscv/AFEQD)]
        (when (or (== (.-Op v) ssa/OpRISCV64LoweredFMAXS) (== (.-Op v) ssa/OpRISCV64LoweredFMINS))
          (set! add riscv/AFADDS)
          (set! feq riscv/AFEQS))


        (let [p1 (.Prog s add)]
          (set! (.-Type (.-From p1)) obj/TYPE_REG)
          (set! (.-Reg (.-From p1)) r0)
          (set! (.-Reg p1) r1)
          (set! (.-Type (.-To p1)) obj/TYPE_REG)
          (set! (.-Reg (.-To p1)) out)

          (let [p2 (.Prog s feq)]
            (set! (.-Type (.-From p2)) obj/TYPE_REG)
            (set! (.-Reg (.-From p2)) r0)
            (set! (.-Reg p2) r0)
            (set! (.-Type (.-To p2)) obj/TYPE_REG)
            (set! (.-Reg (.-To p2)) riscv/REG_TMP)

            (let [p3 (.Prog s riscv/ABEQ)]
              (set! (.-Type (.-From p3)) obj/TYPE_REG)
              (set! (.-Reg (.-From p3)) riscv/REG_ZERO)
              (set! (.-Reg p3) riscv/REG_TMP)
              (set! (.-Type (.-To p3)) obj/TYPE_BRANCH)

              (let [p4 (.Prog s feq)]
                (set! (.-Type (.-From p4)) obj/TYPE_REG)
                (set! (.-Reg (.-From p4)) r1)
                (set! (.-Reg p4) r1)
                (set! (.-Type (.-To p4)) obj/TYPE_REG)
                (set! (.-Reg (.-To p4)) riscv/REG_TMP)

                (let [p5 (.Prog s riscv/ABEQ)]
                  (set! (.-Type (.-From p5)) obj/TYPE_REG)
                  (set! (.-Reg (.-From p5)) riscv/REG_ZERO)
                  (set! (.-Reg p5) riscv/REG_TMP)
                  (set! (.-Type (.-To p5)) obj/TYPE_BRANCH)

                  (let [p6 (.Prog s (.Asm (.-Op v)))]
                    (set! (.-Type (.-From p6)) obj/TYPE_REG)
                    (set! (.-Reg (.-From p6)) r1)
                    (set! (.-Reg p6) r0)
                    (set! (.-Type (.-To p6)) obj/TYPE_REG)
                    (set! (.-Reg (.-To p6)) out)

                    (let [nop (.Prog s obj/ANOP)]
                      (.SetTarget (.-To p3) nop)
                      (.SetTarget (.-To p5) nop))))))))))

    (case [ssa/OpRISCV64LoweredMuluhilo]
      (let [r0 (.Reg (aget (.-Args v) 0))
          ^{:line 376} r1 (.Reg (aget (.-Args v) 1))
          ^{:line 377} p (.Prog s riscv/AMULHU)]
        (set! (.-Type (.-From p)) obj/TYPE_REG)
        (set! (.-Reg (.-From p)) r1)
        (set! (.-Reg p) r0)
        (set! (.-Type (.-To p)) obj/TYPE_REG)
        (set! (.-Reg (.-To p)) (.Reg0 v))
        (let [p1 (.Prog s riscv/AMUL)]
          (set! (.-Type (.-From p1)) obj/TYPE_REG)
          (set! (.-Reg (.-From p1)) r1)
          (set! (.-Reg p1) r0)
          (set! (.-Type (.-To p1)) obj/TYPE_REG)
          (set! (.-Reg (.-To p1)) (.Reg1 v)))))
    (case [ssa/OpRISCV64LoweredMuluover]
      (let [r0 (.Reg (aget (.-Args v) 0))
          ^{:line 391} r1 (.Reg (aget (.-Args v) 1))
          ^{:line 392} p (.Prog s riscv/AMULHU)]
        (set! (.-Type (.-From p)) obj/TYPE_REG)
        (set! (.-Reg (.-From p)) r1)
        (set! (.-Reg p) r0)
        (set! (.-Type (.-To p)) obj/TYPE_REG)
        (set! (.-Reg (.-To p)) (.Reg1 v))
        (let [p1 (.Prog s riscv/AMUL)]
          (set! (.-Type (.-From p1)) obj/TYPE_REG)
          (set! (.-Reg (.-From p1)) r1)
          (set! (.-Reg p1) r0)
          (set! (.-Type (.-To p1)) obj/TYPE_REG)
          (set! (.-Reg (.-To p1)) (.Reg0 v))
          (let [p2 (.Prog s riscv/ASNEZ)]
            (set! (.-Type (.-From p2)) obj/TYPE_REG)
            (set! (.-Reg (.-From p2)) (.Reg1 v))
            (set! (.-Type (.-To p2)) obj/TYPE_REG)
            (set! (.-Reg (.-To p2)) (.Reg1 v))))))
    (case [ssa/OpRISCV64FMADDD ssa/OpRISCV64FMSUBD ssa/OpRISCV64FNMADDD ssa/OpRISCV64FNMSUBD
        ^{:line 410} ssa/OpRISCV64FMADDS ssa/OpRISCV64FMSUBS ssa/OpRISCV64FNMADDS ssa/OpRISCV64FNMSUBS]
      (let [r (.Reg v)
          ^{:line 412} r1 (.Reg (aget (.-Args v) 0))
          ^{:line 413} r2 (.Reg (aget (.-Args v) 1))
          ^{:line 414} r3 (.Reg (aget (.-Args v) 2))
          ^{:line 415} p (.Prog s (.Asm (.-Op v)))]

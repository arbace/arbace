(in-ns 'go.cmd.compile.internal.noder) (go/file "export.go" :imports [


    ^{:line 8} [bytes "bytes"]
    ^{:line 9} [fmt "fmt"]
    ^{:line 10} [io "io"]

    ^{:line 12} [base "cmd/compile/internal/base"]
    ^{:line 13} [bio "cmd/internal/bio"]])


^{:go/end 30} (go/func WriteExports [^{:tag (* bio/Writer)} out]
  (let [^bytes/Buffer data (zero bytes/Buffer)]

    (.WriteByte data \u)
    (writeUnifiedExport (addr data))

    ;; The linker also looks for the $$ marker - use char after $$ to distinguish format.
    ^{:go/via [Writer]} (.WriteString out "\n$$B\n") ; indicate binary export format
    (io/Copy out (addr data))
    ^{:go/via [Writer]} (.WriteString out "\n$$\n")

    (when (!= (.-Export base/Debug) 0)
      (fmt/Printf "BenchmarkExportSize:%s 1 %d bytes\n" (.-Pkgpath base/Ctxt) (.Len data)))))

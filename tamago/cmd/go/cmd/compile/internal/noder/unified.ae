^{:go/end 234} (go/func unified "unified constructs the local package's Internal Representation (IR)\nfrom its syntax tree (AST).\n\nThe pipeline contains 2 steps:\n\n 1. Generate the export data \"stub\".\n\n 2. Generate the IR from the export data above.\n\nThe package data \"stub\" at step (1) contains everything from the local package,\nbut nothing that has been imported. When we're actually writing out export data\nto the output files (see writeNewExport), we run the \"linker\", which:\n\n  - Updates compiler extensions data (e.g. inlining cost, escape analysis results).\n\n  - Handles re-exporting any transitive dependencies.\n\n  - Prunes out any unnecessary details (e.g. non-inlineable functions, because any\n    downstream importers only care about inlinable functions).\n\nThe source files are typechecked twice: once before writing the export data\nusing types2, and again after reading the export data using gc/typecheck.\nThe duplication of work will go away once we only use the types2 type checker,\nremoving the gc/typecheck step. For now, it is kept because:\n\n  - It reduces the engineering costs in maintaining a fork of typecheck\n    (e.g. no need to backport fixes like CL 327651).\n\n  - It makes it easier to pass toolstash -cmp.\n\n  - Historically, we would always re-run the typechecker after importing a package,\n    even though we know the imported data is valid. It's not ideal, but it's\n    not causing any problems either.\n\n  - gc/typecheck is still in charge of some transformations, such as rewriting\n    multi-valued function calls or transforming ir.OINDEX to ir.OINDEXMAP.\n\nUsing the syntax tree with types2, which has a complete representation of generics,\nthe unified IR has the full typed AST needed for introspection during step (1).\nIn other words, we have all the necessary information to build the generic IR form\n(see writer.captureVars for an example).\n" [^posMap m ^{:tag (slice (* noder))} noders]
  (set! inline/InlineCall unifiedInlineCall)
  (set! typecheck/HaveInlineBody unifiedHaveInlineBody)
  (set! pgoir/LookupFunc LookupFunc)
  (set! pgoir/PostLookupCleanup PostLookupCleanup)

  (let [data (writePkgStub m noders)

      ^{:line 200} target typecheck/Target]

    (set! localPkgReader (newPkgReader (pkgbits/NewPkgDecoder (.-Path types/LocalPkg) data)))
    (readPackage localPkgReader types/LocalPkg true)

    (let [r (.newReader localPkgReader pkgbits/SectionMeta pkgbits/PrivateRootIdx pkgbits/SyncPrivate)]
      (.pkgInit r types/LocalPkg target)

      (readBodies target false nil)

      ;; Check that nothing snuck past typechecking.
      (range [_ fn (.-Funcs target)]
        (when (== ^{:go/via [miniNode]} (.Typecheck fn) 0)
          (base/FatalfAt ^{:go/via [miniNode]} (.Pos fn) "missed typecheck: %v" fn))


        ;; For functions, check that at least their first statement (if
        ;; any) was typechecked too.
        (when (!= (len (.-Body fn)) 0)
          (when [stmt (aget (.-Body fn) 0)] (== (.Typecheck stmt) 0)
            (base/FatalfAt (.Pos stmt) "missed typecheck: %v" stmt))))




      ;; For functions originally came from package runtime,
      ;; mark as norace to prevent instrumenting, see issue #60439.
      (range [_ fn (.-Funcs target)]
        (when (and (not (.-CompilingRuntime base/Flag)) (!= (types/RuntimeSymName (.Sym fn)) ""))
          (set! (.-Pragma fn) bit-or ir/Norace)))



      (base/ExitIfErrors)))) ; just in case








^{:go/end 316} (go/func readBodies "readBodies iteratively expands all pending dictionaries and\nfunction bodies.\n\nIf duringInlining is true, then the inline.InlineDecls is called as\nnecessary on instantiations of imported generic functions, so their\ninlining costs can be computed.\n" [^{:tag (* ir/Package)} target ^bool duringInlining ^{:tag (* pgoir/Profile)} profile]
  (let [^{:tag (slice (* ir/Func))} inlDecls (zero (slice (* ir/Func)))]

    ;; Don't use range--bodyIdx can add closures to todoBodies.
    (while true
      ;; The order we expand dictionaries and bodies doesn't matter, so
      ;; pop from the end to reduce todoBodies reallocations if it grows
      ;; further.
      ;;
      ;; However, we do at least need to flush any pending dictionaries
      ;; before reading bodies, because bodies might reference the
      ;; dictionaries.

      (when (> (len todoDicts) 0)
        (let [fn (aget todoDicts (- (len todoDicts) 1))]
          (set! todoDicts (subslice todoDicts _ (- (len todoDicts) 1)))
          (go/call fn)
          (continue)))


      (when (> (len todoBodies) 0)
        (let [fn (aget todoBodies (- (len todoBodies) 1))]
          (set! todoBodies (subslice todoBodies _ (- (len todoBodies) 1)))

          (let [(values pri ok) (aget bodyReader fn)]
            (go/call assert ok)
            (.funcBody pri fn)

            ;; Instantiated generic function: add to Decls for typechecking
            ;; and compilation.
            (when (and (== (.-OClosure fn) nil) (!= (len (.-targs (.-dict pri))) 0))
              ;; cmd/link does not support a type symbol referencing a method symbol
              ;; across DSO boundary, so force re-compiling methods on a generic type
              ;; even it was seen from imported package in linkshared mode, see #58966.
              (let [canSkipNonGenericMethod (not (and (.-Flag_linkshared base/Ctxt) (ir/IsMethod fn)))]
                (if (and duringInlining canSkipNonGenericMethod)
                  (set! inlDecls (append inlDecls fn))

                  (set! (.-Funcs target) (append (.-Funcs target) fn)))))



            (continue))))


      (break))


    (set! todoDicts nil)
    (set! todoBodies nil)

    (when (!= (len inlDecls) 0)
      ;; If we instantiated any generic functions during inlining, we need
      ;; to call CanInline on them so they'll be transitively inlined
      ;; correctly (#56280).
      ;;
      ;; We know these functions were already compiled in an imported
      ;; package though, so we don't need to actually apply InlineCalls or
      ;; save the function bodies any further than this.

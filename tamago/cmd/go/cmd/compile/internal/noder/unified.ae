^{:go/end 76} (go/func LookupFunc "LookupFunc returns the ir.Func for an arbitrary full symbol name if\nthat function exists in the set of available export data.\n\nThis allows lookup of arbitrary functions and methods that aren't otherwise\nreferenced by the local package and thus haven't been read yet.\n\nTODO(prattmic): Does not handle instantiation of generic types. Currently\nprofiles don't contain the original type arguments, so we won't be able to\ncreate the runtime dictionaries.\n\nTODO(prattmic): Hit rate of this function is usually fairly low, and errors\nare only used when debug logging is enabled. Consider constructing cheaper\nerrors by default.\n" [^string fullName] :results [(* ir/Func) error]
  (let [(values pkgPath symName err) (ir/ParseLinkFuncName fullName)]
    (when (!= err nil)
      (return nil (fmt/Errorf "error parsing symbol name %q: %v" fullName err)))


    (let [(values pkg ok) (aget (types/PkgMap) pkgPath)]
      (when (not ok)
        (return nil (fmt/Errorf "pkg %s doesn't exist in %v" pkgPath (types/PkgMap))))


      ;; Symbol naming is ambiguous. We can't necessarily distinguish between
      ;; a method and a closure. e.g., is foo.Bar.func1 a closure defined in
      ;; function Bar, or a method on type Bar? Thus we must simply attempt
      ;; to lookup both.

      (let [(values fn ^:assign err) (lookupFunction pkg symName)]
        (when (== err nil)
          (return fn nil))


        (let [(values ^:assign fn mErr) (lookupMethod pkg symName)]
          (when (== mErr nil)
            (return fn nil))


          (return nil (fmt/Errorf "%s is not a function (%v) or method (%v)" fullName err mErr)))))))







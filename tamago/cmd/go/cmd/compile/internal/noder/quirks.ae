(in-ns 'go.cmd.compile.internal.noder) (go/file "quirks.go" :imports [


    ^{:line 8} [fmt "fmt"]

    ^{:line 10} [syntax "cmd/compile/internal/syntax"]])








^{:go/end 72} (go/func typeExprEndPos "typeExprEndPos returns the position that noder would leave base.Pos\nafter parsing the given type expression.\n\nDeprecated: This function exists to emulate position semantics from\nGo 1.17, necessary for compatibility with the backend DWARF\ngeneration logic that assigns variables to their appropriate scope.\n" ^syntax/Pos [^syntax/Expr expr0]
  (while true
    (type-switch [expr expr0]
      (case [(* syntax/Name)]
        (return ^{:go/via [expr node]} (.Pos expr)))
      (case [(* syntax/SelectorExpr)]
        (return (.Pos (.-X expr))))

      (case [(* syntax/ParenExpr)]
        (set! expr0 (.-X expr)))

      (case [(* syntax/Operation)]
        (go/call assert (== (.-Op expr) syntax/Mul))
        (go/call assert (== (.-Y expr) nil))
        (set! expr0 (.-X expr)))

      (case [(* syntax/ArrayType)]
        (set! expr0 (.-Elem expr)))
      (case [(* syntax/ChanType)]
        (set! expr0 (.-Elem expr)))
      (case [(* syntax/DotsType)]
        (set! expr0 (.-Elem expr)))
      (case [(* syntax/MapType)]
        (set! expr0 (.-Value expr)))
      (case [(* syntax/SliceType)]
        (set! expr0 (.-Elem expr)))

      (case [(* syntax/StructType)]
        (return ^{:go/via [expr node]} (.Pos expr)))

      (case [(* syntax/InterfaceType)]
        (set! expr0 (lastFieldType (.-MethodList expr)))
        (when (== expr0 nil)
          (return ^{:go/via [expr node]} (.Pos expr))))


      (case [(* syntax/FuncType)]
        (set! expr0 (lastFieldType (.-ResultList expr)))
        (when (== expr0 nil)
          (set! expr0 (lastFieldType (.-ParamList expr)))
          (when (== expr0 nil)
            (return ^{:go/via [expr node]} (.Pos expr)))))



      (case [(* syntax/IndexExpr)] ; explicit type instantiation
        (let [targs (syntax/UnpackListExpr (.-Index expr))]
          (set! expr0 (aget targs (- (len targs) 1)))))

      (default
        (panic (fmt/Sprintf "%s: unexpected type expression %v" (.Pos expr) (syntax/String expr)))))))




^{:go/end 79} (go/func lastFieldType ^syntax/Expr [^{:tag (slice (* syntax/Field))} fields]
  (when (== (len fields) 0)
    (return nil))

  (.-Type (aget fields (- (len fields) 1))))

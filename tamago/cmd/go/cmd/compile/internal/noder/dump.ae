(in-ns 'go.cmd.compile.internal.noder) (go/file "dump.go" :imports [


    ^{:line 8} [sync "sync"]

    ^{:line 10} [base "cmd/compile/internal/base"]
    ^{:line 11} [ir "cmd/compile/internal/ir"]
    ^{:line 12} [syntax "cmd/compile/internal/syntax"]
    ^{:line 13} [types2 "cmd/compile/internal/types2"]])




^{:go/end 26} (go/func MatchASTDump "MatchASTDump returns true if the fn matches the value\nof the astdump debug flag.\n" ^bool [^{:tag (* syntax/FuncDecl)} fn]
  (when (== (len (.-AstDump base/Debug)) 0)
    (return false))

  (when (== (.-Name fn) nil)
    (return false))

  (matchForDump fn (.-Pkgpath base/Ctxt)))







^{:go/end 35} (go/func ^:go/noinline matchForDump "matchForDump is marked noinline to ensure that the exported\nfunction MatchAstDump IS inlineable and is also small, because\ncommon case is AstDump is not set.\n" ^bool [^{:tag (* syntax/FuncDecl)} fn ^string pkgPath]
  (ir/MatchPkgFn pkgPath (.-Value (.-Name fn)) (.-AstDump base/Debug)))


^{:go/end 39} (go/func escapedFileName ^string [^{:tag (* syntax/FuncDecl)} fn ^string suffix]
  (ir/EscapedFileName (+ (.-Pkgpath base/Ctxt) "." (.-Value (.-Name fn))) suffix))


(go/var ^sync/Mutex mu)
(go/var htmlWriters (make (map (* syntax/FuncDecl) (* HTMLWriter))))
(go/var orderedFuncs (lit (slice (* syntax/FuncDecl))))


^{:go/end 57} (go/func DumpNodeHTML "DumpNodeHTML dumps the node n to the HTML writer for fn.\n" [^{:tag (* types2/Package)} pkg ^{:tag (* syntax/File)} file ^{:tag (* types2/Info)} info ^{:tag (* syntax/FuncDecl)} fn ^string why ^syntax/Node n]
  (.Lock mu)
  (defer (.Unlock mu))
  (let [(values w ok) (aget htmlWriters fn)]
    (when (not ok)
      (let [name (escapedFileName fn ".syntax.html")]
        (set! w (NewHTMLWriter pkg file info name fn ""))
        (aset htmlWriters fn w)
        (set! orderedFuncs (append orderedFuncs fn))))

    ^{:go/via [HTMLWriterBase]} (.WritePhase w why why)))



^{:go/end 70} (go/func CloseHTMLWriters "CloseHTMLWriters closes the HTML writer for fn, if one exists.\n" []
  (.Lock mu)
  (defer (.Unlock mu))
  (range [_ fn orderedFuncs]
    (when [(values w ok) (aget htmlWriters fn)] ok
      ^{:go/via [HTMLWriterBase]} (.Close w "Writing html syntax output for %s to %s\n" (.pkgFuncName w) ^{:go/via [HTMLWriterBase]} (.Path w))
      (delete htmlWriters fn)))


  (set! orderedFuncs nil))

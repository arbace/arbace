(in-ns 'go.cmd.compile.internal.noder) (go/file "posmap.go" :imports [


    ^{:line 8} [base "cmd/compile/internal/base"]
    ^{:line 9} [syntax "cmd/compile/internal/syntax"]
    ^{:line 10} [src "cmd/internal/src"]])



(go/type posMap "A posMap handles mapping from syntax.Pos to src.XPos.\n" (struct
    ^{:line 15 :tag (map (* syntax/PosBase) (* src/PosBase))} bases
    ^{:line 16 :tag (struct ^{:tag (* syntax/PosBase)} last ^{:tag (* src/PosBase)} base)} cache))





(go/type poser (interface (Pos ^syntax/Pos [])))
(go/type ender (interface (End ^syntax/Pos [])))

^{:go/end 25} (go/method pos ^src/XPos [^{:tag (* posMap)} m ^poser p] (.makeXPos m (.Pos p)))

^{:go/end 36} (go/method makeXPos ^src/XPos [^{:tag (* posMap)} m ^syntax/Pos pos]
  ;; Predeclared objects (e.g., the result parameter for error.Error)
  ;; do not have a position.
  (when (not (.IsKnown pos))
    (return src/NoXPos))


  (let [posBase (.makeSrcPosBase m (.Base pos))]
    (.XPos (.-PosTable base/Ctxt) (src/MakePos posBase (.Line pos) (.Col pos)))))



^{:go/end 73} (go/method makeSrcPosBase "makeSrcPosBase translates from a *syntax.PosBase to a *src.PosBase.\n" ^{:tag (* src/PosBase)} [^{:tag (* posMap)} m ^{:tag (* syntax/PosBase)} b0]
  ;; fast path: most likely PosBase hasn't changed
  (when (== (.-last (.-cache m)) b0)
    (return (.-base (.-cache m))))


  (let [(values b1 ok) (aget (.-bases m) b0)]
    (when (not ok)
      (let [fn (.Filename b0)
          ^{:line 48} absfn (trimFilename b0)]

        (if (.IsFileBase b0)
          (set! b1 (src/NewFileBase fn absfn))

          ;; line directive base
          (let [p0 (.Pos b0)
              ^{:line 55} p0b (.Base p0)]
            (when (== p0b b0)
              (panic "infinite recursion in makeSrcPosBase"))

            (let [p1 (src/MakePos (.makeSrcPosBase m p0b) (.Line p0) (.Col p0))]
              (set! b1 (src/NewLinePragmaBase p1 fn absfn (.Line b0) (.Col b0))))))

        (when (== (.-bases m) nil)
          (set! (.-bases m) (make (map (* syntax/PosBase) (* src/PosBase)))))

        (aset (.-bases m) b0 b1)))


    ;; update cache
    (set! (.-last (.-cache m)) b0)
    (set! (.-base (.-cache m)) b1)

    ^{:line 72} b1))

            (when (and (not (.-CompilingRuntime base/Flag)) (!= (bit-and flag runtimePragmas) 0))
              (.error p (lit syntax/Error :Pos pos :Msg (fmt/Sprintf "//%s only allowed in runtime" verb))))

            (when (and (== flag ir/UintptrKeepAlive) (not (.-Std base/Flag)))
              (.error p (lit syntax/Error :Pos pos :Msg (fmt/Sprintf "//%s is only allowed in the standard library" verb))))

            (when (and (== flag 0) (not (aget allowedStdPragmas verb)) (.-Std base/Flag))
              (.error p (lit syntax/Error :Pos pos :Msg (fmt/Sprintf "//%s is not allowed in the standard library" verb))))

            (set! (.-Flag pragma) bit-or flag)
            (set! (.-Pos pragma) (append (.-Pos pragma) (lit pragmaPos flag pos)))))))


    ^{:line 358} pragma))












^{:go/end 375} (go/func isCgoGeneratedFile "isCgoGeneratedFile reports whether pos is in a file\ngenerated by cgo, which is to say a file with name\nbeginning with \"_cgo_\". Such files are allowed to\ncontain cgo directives, and for security reasons\n(primarily misuse of linker flags), other files are not.\nSee golang.org/issue/23672.\nNote that cmd/go ignores files whose names start with underscore,\nso the only _cgo_ files we will see from cmd/go are generated by cgo.\nIt's easy to bypass this check by calling the compiler directly;\nwe only protect against uses by cmd/go.\n" ^bool [^syntax/Pos pos]
  ;; We need the absolute file, independent of //line directives,
  ;; so we call pos.Base().Pos().
  (strings/HasPrefix (filepath/Base (trimFilename (.Base (.Pos (.Base pos))))) "_cgo_"))






^{:go/end 387} (go/func safeArg "safeArg reports whether arg is a \"safe\" command-line argument,\nmeaning that when it appears in a command-line, it probably\ndoesn't have some special meaning other than its own name.\nThis is copied from SafeArg in cmd/go/internal/load/pkg.go.\n" ^bool [^string name]
  (when (== name "")
    (return false))

  (let [c (aget name 0)]
    (or (and (<= \0 c) (<= c \9)) (and (<= \A c) (<= c \Z)) (and (<= \a c) (<= c \z)) (== c \.) (== c \_) (== c \/) (>= c utf8/RuneSelf))))





^{:go/end 448} (go/func parseGoEmbed "parseGoEmbed parses the text following \"//go:embed\" to extract the glob patterns.\nIt accepts unquoted space-separated patterns as well as double-quoted and back-quoted Go strings.\ngo/build/read.go also processes these strings and contains similar logic.\n" [^string args] :results [(slice string) error]
  (let [^{:tag (slice string)} list (zero (slice string))]
    (for [(set! args (strings/TrimSpace args))] (!= args "") (set! args (strings/TrimSpace args))
      (let [^string path (zero string)]
        (label :Switch
          (switch (aget args 0)
            (default
              (let [i (len args)]
                (range [j c args]
                  (when (unicode/IsSpace c)
                    (set! i j)
                    (break)))


                (set! path (subslice args _ i))
                (set! args (subslice args i))))

            (case [\`]
              (let [i (strings/Index (subslice args 1) "`")]
                (when (< i 0)
                  (return nil (fmt/Errorf "invalid quoted string in //go:embed: %s" args)))

                (set! path (subslice args 1 (+ 1 i)))
                (set! args (subslice args (+ 1 i 1)))))

            (case [\"]
              (let [i 1]
                (for [] (< i (len args)) (inc! i)
                  (when (== (aget args i) \\)
                    (inc! i)
                    (continue))

                  (when (== (aget args i) \")
                    (let [(values q err) (strconv/Unquote (subslice args _ (+ i 1)))]
                      (when (!= err nil)
                        (return nil (fmt/Errorf "invalid quoted string in //go:embed: %s" (subslice args _ (+ i 1)))))

                      (set! path q)
                      (set! args (subslice args (+ i 1)))
                      (break :Switch))))


                (when (>= i (len args))
                  (return nil (fmt/Errorf "invalid quoted string in //go:embed: %s" args)))))))



        (when (!= args "")
          (let [(values r _) (utf8/DecodeRuneInString args)]
            (when (not (unicode/IsSpace r))
              (return nil (fmt/Errorf "invalid quoted string in //go:embed: %s" args)))))


        (set! list (append list path))))

    (return list nil)))







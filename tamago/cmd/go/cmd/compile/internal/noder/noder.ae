^{:go/end 77} (go/func LoadPackage [^{:tag (slice string)} filenames]
  (.Start base/Timer "fe" "parse")

  ;; Limit the number of simultaneously open files.
  (let [sem (make (chan (struct)) (+ (runtime/GOMAXPROCS 0) 10))

      ^{:line 33} noders (make (slice (* noder)) (len filenames))]
    (range [i noders]
      (let [p ^{:go/breaks [2]} (lit noder
            :err (make (chan syntax/Error)))]

        (aset noders i (addr p))))


    ;; Move the entire syntax processing logic into a separate goroutine to avoid blocking on the "sem".
    (go (^{:go/end 61} (fn []
          (range [i filename filenames]
            (let [p (aget noders i)]
              (>! sem (lit (struct)))
              (go (^{:go/end 59} (fn []
                    (defer (^{:go/end 47} (fn [] (<! sem))))
                    (defer (close (.-err p)))
                    (let [fbase (syntax/NewFileBase filename)

                        (values f err) (os/Open filename)]
                      (when (!= err nil)
                        (.error p (lit syntax/Error :Msg (.Error err)))
                        (return))

                      (defer (.Close f))

                      (set! (values (.-file p) _) (syntax/Parse fbase f (.-error p) (.-pragma p) syntax/CheckBranches))))))))))) ; errors are tracked via p.error




    (let [^uint lines (zero uint)
        ^{:line 64 :tag posMap} m (zero posMap)]
      (range [_ p noders]
        (range [e (.-err p)]
          (base/ErrorfAt (.makeXPos m (.-Pos e)) 0 "%s" (.-Msg e)))

        (when (== (.-file p) nil)
          (base/ErrorExit))

        (set! lines + (.Line (.-EOF (.-file p)))))

      (.AddEvent base/Timer (conv int64 lines) "lines")

      (unified m noders))))










^{:go/end 222} (go/method checkUnusedDuringParse [^{:tag (* noder)} p ^{:tag (* pragmas)} pragma]
  (range [_ pos (.-Pos pragma)]
    (when (!= (bit-and (.-Flag pos) (.-Flag pragma)) 0)
      (.error p (lit syntax/Error :Pos (.-Pos pos) :Msg "misplaced compiler directive"))))


  (when (> (len (.-Embeds pragma)) 0)
    (range [_ e (.-Embeds pragma)]
      (.error p (lit syntax/Error :Pos (.-Pos e) :Msg "misplaced go:embed directive"))))


  (when (!= (.-WasmImport pragma) nil)
    (.error p (lit syntax/Error :Pos (.-Pos (.-WasmImport pragma)) :Msg "misplaced go:wasmimport directive")))

  (when (!= (.-WasmExport pragma) nil)
    (.error p (lit syntax/Error :Pos (.-Pos (.-WasmExport pragma)) :Msg "misplaced go:wasmexport directive"))))




^{:go/end 359} (go/method pragma "pragma is called concurrently if files are parsed concurrently.\n" ^syntax/Pragma [^{:tag (* noder)} p ^syntax/Pos pos ^bool blankLine ^string text ^syntax/Pragma old]
  (let [(values pragma _) (assert (* pragmas) old)]
    (when (== pragma nil)
      (set! pragma (new pragmas)))


    (when (== text "")
      ;; unused pragma; only called with old != nil.
      (.checkUnusedDuringParse p pragma)
      (return nil))


    (when (strings/HasPrefix text "line ")
      ;; line directives are handled by syntax package
      (panic "unreachable"))


    (when (not blankLine)
      ;; directive must be on line by itself
      (.error p (lit syntax/Error :Pos pos :Msg "misplaced compiler directive"))
      (return pragma))


    (switch
      (case [(strings/HasPrefix text "go:wasmimport ")]
        (let [f (strings/Fields text)]
          (when (!= (len f) 3)
            (.error p (lit syntax/Error :Pos pos :Msg "usage: //go:wasmimport importmodule importname"))
            (break))


          (when (== buildcfg/GOARCH "wasm")
            ;; Only actually use them if we're compiling to WASM though.
            (set! (.-WasmImport pragma) (addr ^{:go/breaks [2 4 6]} (lit WasmImport
                  :Pos pos
                  :Module (aget f 1)
                  :Name (aget f 2)))))))



      (case [(strings/HasPrefix text "go:wasmexport ")]
        (let [f (strings/Fields text)]
          (when (!= (len f) 2)
            ;; TODO: maybe make the name optional? It was once mentioned on proposal 65199.
            (.error p (lit syntax/Error :Pos pos :Msg "usage: //go:wasmexport exportname"))
            (break))


          (when (== buildcfg/GOARCH "wasm")
            ;; Only actually use them if we're compiling to WASM though.
            (set! (.-WasmExport pragma) (addr ^{:go/breaks [2 4]} (lit WasmExport
                  :Pos pos
                  :Name (aget f 1)))))))



      (case [(strings/HasPrefix text "go:linkname ") (strings/HasPrefix text "go:linknamestd ")]
        (let [f (strings/Fields text)]
          (when (not (and (<= 2 (len f)) (<= (len f) 3)))
            (.error p (lit syntax/Error :Pos pos :Msg (fmt/Sprintf "usage: //%s localname [linkname]" (aget f 0))))
            (break))

          ;; The second argument is optional. If omitted, we use
          ;; the default object symbol name for this and
          ;; linkname only serves to mark this symbol as
          ;; something that may be referenced via the object
          ;; symbol name from another package.
          (let [^string target (zero string)]
            (cond (== (len f) 3)
              (set! target (aget f 2))
              (!= (.-Pkgpath base/Ctxt) "")
              ;; Use the default object symbol name if the
              ;; user didn't provide one.
              (set! target (+ (objabi/PathToPrefix (.-Pkgpath base/Ctxt)) "." (aget f 1))) :else

              (panic "missing pkgpath"))

            (set! (.-linknames p) (append (.-linknames p) (lit linkname pos (== (aget f 0) "go:linknamestd") (aget f 1) target))))))

      (case [(== text "go:embed") (strings/HasPrefix text "go:embed ")]
        (let [(values args err) (parseGoEmbed (subslice text (len "go:embed")))]
          (when (!= err nil)
            (.error p (lit syntax/Error :Pos pos :Msg (.Error err))))

          (when (== (len args) 0)
            (.error p (lit syntax/Error :Pos pos :Msg "usage: //go:embed pattern..."))
            (break))

          (set! (.-Embeds pragma) (append (.-Embeds pragma) (lit pragmaEmbed pos args)))))

      (case [(strings/HasPrefix text "go:cgo_import_dynamic ")]
        ;; This is permitted for general use because Solaris
        ;; code relies on it in golang.org/x/sys/unix and others.
        (let [fields (pragmaFields text)]
          (when (>= (len fields) 4)
            (let [lib (strings/Trim (aget fields 3) "\"")]
              (when (and (!= lib "") (not (safeArg lib)) (not (isCgoGeneratedFile pos)))
                (.error p (lit syntax/Error :Pos pos :Msg (fmt/Sprintf "invalid library name %q in cgo_import_dynamic directive" lib))))

              (.pragcgo p pos text)
              (set! (.-Flag pragma) bit-or (pragmaFlag "go:cgo_import_dynamic"))
              (break)))

          (fallthrough)))
      (case [(strings/HasPrefix text "go:cgo_")]

^{:go/breaks [[5 3399]] :go/end 3400} (go/method terminates "terminates reports whether stmt terminates normal control flow\n(i.e., does not merely advance to the following statement).\n" ^bool [^{:tag (* pkgWriter)} pw ^syntax/Stmt stmt]
  (type-switch [stmt stmt]
    (case [(* syntax/BranchStmt)]
      (when (== (.-Tok stmt) syntax/Goto)
        (return true)))

    (case [(* syntax/ReturnStmt)]
      (return true))
    (case [(* syntax/ExprStmt)]
      (when [(values call ok) (assert (* syntax/CallExpr) (syntax/Unparen (.-X stmt)))] ok
        (when (.isBuiltin pw (.-Fun call) "panic")
          (return true))))



    ;; The handling of BlockStmt here is approximate, but it serves to
    ;; allow dead-code elimination for:
    ;;
    ;;	if true {
    ;;		return x
    ;;	}
    ;;	unreachable
    (case [(* syntax/IfStmt)]
      (let [cond (.staticBool pw (addr (.-Cond stmt)))]
        (return (and ^:go/paren (or (< cond 0) (.terminates pw (.-Then stmt))) ^:go/paren (or (> cond 0) (.terminates pw (.-Else stmt)))))))
    (case [(* syntax/BlockStmt)]
      (return (.terminates pw (lastNonEmptyStmt (.-List stmt))))))


  false)

(go/type cycleFinder "A cycleFinder detects anonymous interface cycles (go.dev/issue/56103).\n" (struct
    ^{:line 237 :tag (map (* types2/Interface) bool)} cyclic))



^{:go/breaks [[5 251]] :go/end 252} (go/method hasCycle "hasCycle reports whether typ is part of an anonymous interface cycle.\n" ^bool [^{:tag (* cycleFinder)} f ^{:tag (* types2/Interface)} typ]
  ;; We use Method instead of ExplicitMethod to implicitly expand any
  ;; embedded interfaces. Then we just need to walk any anonymous
  ;; types, keeping track of *types2.Interface types we visit along
  ;; the way.
  (for [i 0] (< i (.NumMethods typ)) (inc! i)
    (when (.visit f ^{:go/via [object]} (.Type (.Method typ i)))
      (return true)))


  false)



^{:go/end 321} (go/method visit "visit recursively walks typ0 to check any referenced interface types.\n" ^bool [^{:tag (* cycleFinder)} f ^types2/Type typ0]
  (while true ; loop for tail recursion
    (type-switch [typ (types2/Unalias typ0)]
      (default
        (base/Fatalf "unexpected type: %T" typ))

      (case [(* types2/Basic) (* types2/Named) (* types2/TypeParam)]
        (return false)) ; named types cannot be part of an anonymous cycle
      (case [(* types2/Pointer)]
        (set! typ0 (.Elem typ)))
      (case [(* types2/Array)]
        (set! typ0 (.Elem typ)))
      (case [(* types2/Chan)]
        (set! typ0 (.Elem typ)))
      (case [(* types2/Map)]
        (when (.visit f (.Key typ))
          (return true))

        (set! typ0 (.Elem typ)))
      (case [(* types2/Slice)]
        (set! typ0 (.Elem typ)))

      (case [(* types2/Struct)]
        (for [i 0] (< i (.NumFields typ)) (inc! i)
          (when (.visit f ^{:go/via [object]} (.Type (.Field typ i)))
            (return true)))


        (return false))

      (case [(* types2/Interface)]
        ;; The empty interface (e.g., "any") cannot be part of a cycle.
        (when (and (== (.NumExplicitMethods typ) 0) (== (.NumEmbeddeds typ) 0))
          (return false))


        ;; As an optimization, we wait to allocate cyclic here, after
        ;; we've found at least one other (non-empty) anonymous
        ;; interface. This means when a cycle is present, we need to
        ;; make an extra recursive call to actually detect it. But for
        ;; most packages, it allows skipping the map allocation

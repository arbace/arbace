        (when [(values x ok) (aget (.-cyclic f) typ)] ok
          (return x))

        (when (== (.-cyclic f) nil)
          (set! (.-cyclic f) (make (map (* types2/Interface) bool))))

        (aset (.-cyclic f) typ true)

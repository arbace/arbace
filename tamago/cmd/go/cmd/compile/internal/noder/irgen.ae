        (aset (.-cyclic f) typ false)
        (return false))

      (case [(* types2/Signature)]
        (return (or (.visit f (.Params typ)) (.visit f (.Results typ)))))
      (case [(* types2/Tuple)]
        (for [i 0] (< i (.Len typ)) (inc! i)
          (when (.visit f ^{:go/via [object]} (.Type (.At typ i)))

    ^{:go/via [HTMLWriterBase]} (.Print h indentString)))








^{:go/end 201} (go/method dumpScopeHTML "dumpScopeHTML writes a string representation of the scope to w,\nwith the scope elements sorted by name.\nThe level of indentation is controlled by n >= 0, with\nn == 0 for no indentation.\nIf recurse is set, it also writes nested (children) scopes.\n" [^{:tag (* HTMLWriter)} h ^{:tag (* types2/Scope)} s ^int depth ^bool recur]

    ^{:go/via [HTMLWriterBase]} (.Print w "</h1>")
    ^{:go/via [HTMLWriterBase]} (.Print w (+ "\n<a href=\"#\" onclick=\"toggle_visibility('help');return false;\" id=\"helplink\">help</a>\n<div id=\"help\">\n\n<p>\nClick anywhere on a node (with \"cell\" cursor) to outline a node and all of its subtrees.\n</p>\n<p>\nClick on a name (with \"crosshair\" cursor) to highlight every occurrence of a name.\n(Note that all the name nodes are the same node, so those also all outline together).\n</p>\n<p>\nClick on a file, line, or column (with \"crosshair\" cursor) to highlight positions\nin that file, at that file:line, or at that file:line:column, respectively.<br>Inlined\nlocations are not treated as a single location, but as a sequence of locations that\ncan be independently highlighted.\n</p>\n<p>\nClick on a "

















        ^{:line 102} ir/DownArrow " to collapse a subtree, or on a " ir/RightArrow " to expand a subtree.\n</p>\n<p>\nNon-tree attributes, like scope and type lookups, are displayed in italics.  Those may\nalso be clicked to highlight identity relationships within and between phases.\n</p>\n\n</div>\n<label for=\"dark-mode-button\" style=\"margin-left: 15px; cursor: pointer;\">darkmode</label>\n<input type=\"checkbox\" onclick=\"toggleDarkMode();\" id=\"dark-mode-button\" style=\"cursor: pointer\" />\n"))










    ^{:go/via [HTMLWriterBase]} (.Print w "<table>")

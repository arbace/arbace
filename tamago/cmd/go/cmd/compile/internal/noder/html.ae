      (when (isValid (.TypeOf (.-info h) x))
        (return true))))



  ^{:go/breaks [[3 372]]} (let [v (.Elem (reflect/ValueOf n))
      ^{:line 349} t (.Elem (reflect/TypeOf n))
      ^{:line 350} nf (.NumField t)]
    (for [i 0] (< i nf) (inc! i)
      (let [tf (.Field t i)
          ^{:line 353} vf (.Field v i)]
        (when (!= (.-PkgPath tf) "")
          (continue))

        (switch (.Kind (.-Type tf))
          (case [reflect/Interface reflect/Ptr reflect/Slice]
            (when (.IsNil vf)
              (continue))))


        (type-switch (.Interface vf)
          (case [syntax/Node]
            (return true))
          (default

      ^{:go/via [HTMLWriterBase]} (.Print h (+ "<span class=\"toggle\" onclick=\"toggle_node(this)\">" ir/DownArrow "</span> ")))

    ^{:go/via [HTMLWriterBase]} (.Printf h "scope %s %p" (html/EscapeString (.Comment s)) s)

    (when hasChildren
      ^{:go/via [HTMLWriterBase]} (.Print h "<span class=\"node-body\">")

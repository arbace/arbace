^{:go/end 373} (go/method nodeHasChildren ^bool [^{:tag (* HTMLWriter)} h ^syntax/Node n]
  (when (== n nil)
    (return false))

  (type-switch [x n]
    (case [(* syntax/BasicLit)]
      (return false))
    (case [(* syntax/Name)]
      (return (or (!= (.ObjectOf (.-info h) x) nil) (isValid (.TypeOf (.-info h) x)))))

^{:go/end 56} (go/func NewHTMLWriter ^{:tag (* HTMLWriter)} [^{:tag (* types2/Package)} pkg ^{:tag (* syntax/File)} file ^{:tag (* types2/Info)} info ^string path ^{:tag (* syntax/FuncDecl)} decl ^string cfgMask]
  (set! path (strings/ReplaceAll path "/" (conv string filepath/Separator)))
  (let [(values out err) (os/OpenFile path (bit-or os/O_WRONLY os/O_CREATE os/O_TRUNC) 0644)]
    (when (!= err nil)
      (panic err))

    (let [reportPath path]
      (when (not (filepath/IsAbs reportPath))
        (let [(values pwd err) (os/Getwd)]
          (when (!= err nil)
            (panic err))

          (set! reportPath (filepath/Join pwd path))))

      (let [h ^{:go/breaks [2 4 6 8]} (lit HTMLWriter
            :pkg pkg
            :file file
            :info info
            :Decl decl)]

        ^{:go/via [HTMLWriterBase]} (.Init h out reportPath (.-DeclHTML h))
        (.start h)
        (addr h)))))


^{:go/end 64} (go/method pkgFuncName ^string [^{:tag (* HTMLWriter)} w]
  (let [p (.Path (.-pkg w))]

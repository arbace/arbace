      ^{:go/via [HTMLWriterBase]} (.Printf h "<span class=\"n%d scope\">" ^{:go/via [HTMLWriterBase]} (.CanonId h s))
      (defer ^{:go/via [HTMLWriterBase]} (.Printf h "</span>"))

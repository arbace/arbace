(in-ns 'go.cmd.compile.internal.syntax) (go/file "printer.go" :imports [


    ^{:line 10} [fmt "fmt"]
    ^{:line 11} [io "io"]
    ^{:line 12} [strings "strings"]])



(go/type Form "Form controls print formatting.\n" uint)

(go/const
  ^{:line 19} [^{:tag Form :val 0} _ iota] ; default
  ^{:line 20} [^{:val 1} LineForm] ; use spaces instead of linebreaks where possible
  ^{:line 21} [^{:val 2} ShortForm]) ; like LineForm but print "…" for non-empty function or composite literal bodies




^{:go/end 44} (go/func Fprint "Fprint prints node x to w in the specified form.\nIt returns the number of bytes written, and whether there was an error.\n" [^io/Writer w ^Node x ^Form form] :results [^int n ^error err]
  (let [p ^{:go/breaks [2 4 6]} (lit printer
        :output w
        :form form
        :linebreaks (== form 0))]


    (defer (^{:go/end 38} (fn []
          (set! n (.-written p))
          (when [e (recover)] (!= e nil)
            (set! err (.-err (assert writeError e))))))) ; re-panics if it's not a writeError



    (.print p x)
    (.flush p _EOF)

    (return)))




^{:go/end 55} (go/func String "String is a convenience function that prints n in ShortForm\nand returns the printed string.\n" ^string [^Node n]
  (let [^strings/Builder buf (zero strings/Builder)
      (values _ err) (Fprint (addr buf) n ShortForm)]
    (when (!= err nil)
      (fmt/Fprintf (addr buf) "<<< ERROR: %s" err))

    (.String buf)))


(go/type ctrlSymbol int)

(go/const
  ^{:line 60} [^{:tag ctrlSymbol :val 0} none iota]
  ^{:line 61} [^{:val 1} semi]
  ^{:line 62} [^{:val 2} blank]
  ^{:line 63} [^{:val 3} newline]
  ^{:line 64} [^{:val 4} indent]
  ^{:line 65} [^{:val 5} outdent])
;; comment
;; eolComment


(go/type whitespace (struct
    ^{:line 71 :tag token} last
    ^{:line 72 :tag ctrlSymbol} kind))
;;text string // comment text (possibly ""); valid if kind == comment


(go/type printer (struct
    ^{:line 77 :tag io/Writer} output
    ^{:line 78 :tag int} written ; number of bytes written
    ^{:line 79 :tag Form} form
    ^{:line 80 :tag bool} linebreaks ; print linebreaks instead of semis

    ^{:line 82 :tag int} indent ; current indentation level
    ^{:line 83 :tag int} nlcount ; number of consecutive newlines

    ^{:line 85 :tag (slice whitespace)} pending ; pending whitespace
    ^{:line 86 :tag token} lastTok)) ; last token (after any pending semi) processed by print




^{:go/end 97} (go/method write "write is a thin wrapper around p.output.Write\nthat takes care of accounting and error handling.\n" [^{:tag (* printer)} p ^{:tag (slice byte)} data]
  (let [(values n err) (.Write (.-output p) data)]
    (set! (.-written p) + n)
    (when (!= err nil)
      (panic (lit writeError err)))))



(go/var
  ^{:line 100} [tabBytes (conv (slice byte) "\t\t\t\t\t\t\t\t")]
  ^{:line 101} [newlineByte (conv (slice byte) "\n")]
  ^{:line 102} [blankByte (conv (slice byte) " ")])


^{:go/end 120} (go/method writeBytes [^{:tag (* printer)} p ^{:tag (slice byte)} data]
  (when (== (len data) 0)
    (panic "expected non-empty []byte"))

  (when (and (> (.-nlcount p) 0) (> (.-indent p) 0))
    ;; write indentation
    (let [n (.-indent p)]
      (while (> n (len tabBytes))
        (.write p tabBytes)
        (set! n - (len tabBytes)))

      (.write p (subslice tabBytes _ n))))

  (.write p data)
  (set! (.-nlcount p) 0))


^{:go/end 124} (go/method writeString [^{:tag (* printer)} p ^string s]
  (.writeBytes p (conv (slice byte) s)))





^{:go/breaks [[5 136]] :go/end 137} (go/func impliesSemi "If impliesSemi returns true for a non-blank line's final token tok,\na semicolon is automatically inserted. Vice versa, a semicolon may\nbe omitted in those cases.\n" ^bool [^token tok]
  (switch tok
    (case [_Name
        ^{:line 132} _Break _Continue _Fallthrough _Return
        ^{:line 133} _Rparen _Rbrack _Rbrace] ; /*_Inc, _Dec,*/ ; TODO(gri) fix this
      (return true)))

  false)


;; TODO(gri) provide table of []byte values for all tokens to avoid repeated string conversion

^{:go/end 150} (go/method addWhitespace [^{:tag (* printer)} p ^ctrlSymbol kind ^string text]
  (set! (.-pending p) (append (.-pending p) (lit whitespace (.-lastTok p) kind))) ; /*text*/
  (switch kind
    (case [semi]
      (set! (.-lastTok p) _Semi))
    (case [newline]
      (set! (.-lastTok p) 0))))
;; TODO(gri) do we need to handle /*-style comments containing newlines here?



^{:go/end 229} (go/method flush [^{:tag (* printer)} p ^token next]
  ;; eliminate semis and redundant whitespace
  (let [sawNewline (== next _EOF)
      ^{:line 155} sawParen (or (== next _Rparen) (== next _Rbrace))]
    (for [i (- (len (.-pending p)) 1)] (>= i 0) (dec! i)
      (switch (.-kind (aget (.-pending p) i))
        (case [semi]
          (let [k semi]
            (cond sawParen (do
                (set! sawParen false)
                (set! k none)) ; eliminate semi
              (and sawNewline (impliesSemi (.-last (aget (.-pending p) i)))) (do
                (set! sawNewline false)
                (set! k none))) ; eliminate semi

            (set! (.-kind (aget (.-pending p) i)) k)))
        (case [newline]
          (set! sawNewline true))
        (case [blank indent outdent])
        ;; nothing to do
        ;; case comment:
        ;; 	// A multi-line comment acts like a newline; and a ""
        ;; 	// comment implies by definition at least one newline.
        ;; 	if text := p.pending[i].text; strings.HasPrefix(text, "/*") && strings.ContainsRune(text, '\n') {
        ;; 		sawNewline = true
        ;; 	}
        ;; case eolComment:
        ;; 	// TODO(gri) act depending on sawNewline
        (default
          (panic "unreachable"))))



    ;; print pending
    (let [prev none]
      (range [i (.-pending p)]
        (switch (.-kind (aget (.-pending p) i))
          (case [none])
          ;; nothing to do
          (case [semi]
            (.writeString p ";")
            (set! (.-nlcount p) 0)
            (set! prev semi))
          (case [blank]
            (when (!= prev blank)
              ;; at most one blank
              (.writeBytes p blankByte)
              (set! (.-nlcount p) 0)
              (set! prev blank)))

          (case [newline]
            (let [^:const ^{:val 1} maxEmptyLines 1]
              (when (<= (.-nlcount p) maxEmptyLines)
                (.write p newlineByte)
                (inc! (.-nlcount p))
                (set! prev newline))))

          (case [indent]
            (inc! (.-indent p)))
          (case [outdent]
            (dec! (.-indent p))
            (when (< (.-indent p) 0)
              (panic "negative indentation")))

          ;; case comment:
          ;; 	if text := p.pending[i].text; text != "" {
          ;; 		p.writeString(text)
          ;; 		p.nlcount = 0
          ;; 		prev = comment
          ;; 	}
          ;; 	// TODO(gri) should check that line comments are always followed by newline
          (default
            (panic "unreachable"))))



      (set! (.-pending p) (subslice (.-pending p) _ 0))))) ; re-use underlying array



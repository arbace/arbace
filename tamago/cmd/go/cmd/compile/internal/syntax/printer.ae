^{:go/end 1005} (go/method printCaseClause [^{:tag (* printer)} p ^{:tag (* CaseClause)} c ^bool braces]
  (if (!= (.-Cases c) nil)
    (.print p _Case blank (.-Cases c))

    (.print p _Default))

  (.print p _Colon)
  (when (> (len (.-Body c)) 0)
    (.print p newline indent)
    (.printStmtList p (.-Body c) braces)
    (.print p outdent)))



^{:go/end 1020} (go/method printCommClause [^{:tag (* printer)} p ^{:tag (* CommClause)} c ^bool braces]
  (if (!= (.-Comm c) nil) (do
      (.print p _Case blank)
      (.print p (.-Comm c)))

    (.print p _Default))

  (.print p _Colon)
  (when (> (len (.-Body c)) 0)
    (.print p newline indent)
    (.printStmtList p (.-Body c) braces)
    (.print p outdent)))

^{:go/end 726} (go/method printRawNode [^{:tag (* printer)} p ^Node n]
  (type-switch [n n]
    (case [nil])
    ;; we should not reach here but don't crash

    ;; expressions and types
    (case [(* BadExpr)]
      (.print p _Name "<bad expr>"))

    (case [(* Name)]
      (.print p _Name (.-Value n))) ; _Name requires actual value following immediately

    (case [(* BasicLit)]
      (.print p _Name (.-Value n))) ; _Name requires actual value following immediately

    (case [(* FuncLit)]
      (.print p (.-Type n) blank)
      (when (!= (.-Body n) nil)
        (if (== (.-form p) ShortForm) (do
            (.print p _Lbrace)
            (when (> (len (.-List (.-Body n))) 0)
              (.print p _Name "…"))

            (.print p _Rbrace))

          (.print p (.-Body n)))))



    (case [(* CompositeLit)]
      (when (!= (.-Type n) nil)
        (.print p (.-Type n)))

      (.print p _Lbrace)
      (if (== (.-form p) ShortForm)
        (when (> (len (.-ElemList n)) 0)
          (.print p _Name "…"))

        (do
          (if (and (> (.-NKeys n) 0) (== (.-NKeys n) (len (.-ElemList n))))
            (.printExprLines p (.-ElemList n))

            (.printExprList p (.-ElemList n)))))


      (.print p _Rbrace))

    (case [(* ParenExpr)]
      (.print p _Lparen (.-X n) _Rparen))

    (case [(* SelectorExpr)]
      (.print p (.-X n) _Dot (.-Sel n)))

    (case [(* IndexExpr)]
      (.print p (.-X n) _Lbrack (.-Index n) _Rbrack))

    (case [(* SliceExpr)]
      (.print p (.-X n) _Lbrack)
      (when [i (aget (.-Index n) 0)] (!= i nil)
        (.printNode p i))

      (.print p _Colon)
      (when [j (aget (.-Index n) 1)] (!= j nil)
        (.printNode p j))

      (when [k (aget (.-Index n) 2)] (!= k nil)
        (.print p _Colon k))

      (.print p _Rbrack))

    (case [(* AssertExpr)]
      (.print p (.-X n) _Dot _Lparen (.-Type n) _Rparen))

    (case [(* TypeSwitchGuard)]
      (when (!= (.-Lhs n) nil)
        (.print p (.-Lhs n) blank _Define blank))

      (.print p (.-X n) _Dot _Lparen _Type _Rparen))

    (case [(* CallExpr)]
      (.print p (.-Fun n) _Lparen)
      (.printExprList p (.-ArgList n))
      (when (.-HasDots n)
        (.print p _DotDotDot))

      (.print p _Rparen))

    (case [(* Operation)]
      (if (== (.-Y n) nil) (do
          ;; unary expr
          (.print p (.-Op n))
          ;; if n.Op == lexical.Range {
          ;; 	p.print(blank)
          ;; }
          (.print p (.-X n)))

        ;; binary expr
        ;; TODO(gri) eventually take precedence into account
        ;; to control possibly missing parentheses
        (.print p (.-X n) blank (.-Op n) blank (.-Y n))))


    (case [(* KeyValueExpr)]
      (.print p (.-Key n) _Colon blank (.-Value n)))

    (case [(* ListExpr)]
      (.printExprList p (.-ElemList n)))

    (case [(* ArrayType)]
      (let [^any len _DotDotDot]
        (when (!= (.-Len n) nil)
          (set! len (.-Len n)))

        (.print p _Lbrack len _Rbrack (.-Elem n))))

    (case [(* SliceType)]
      (.print p _Lbrack _Rbrack (.-Elem n)))

    (case [(* DotsType)]
      (.print p _DotDotDot (.-Elem n)))

    (case [(* StructType)]
      (.print p _Struct)
      (when (and (> (len (.-FieldList n)) 0) (.-linebreaks p))
        (.print p blank))

      (.print p _Lbrace)
      (when (> (len (.-FieldList n)) 0)
        (if (.-linebreaks p) (do
            (.print p newline indent)
            (.printFieldList p (.-FieldList n) (.-TagList n) _Semi)
            (.print p outdent newline))

          (.printFieldList p (.-FieldList n) (.-TagList n) _Semi)))


      (.print p _Rbrace))

    (case [(* FuncType)]
      (.print p _Func)
      (.printSignature p n))

    (case [(* InterfaceType)]
      (.print p _Interface)
      (if (and (.-linebreaks p) (> (len (.-MethodList n)) 1)) (do
          (.print p blank)
          (.print p _Lbrace)
          (.print p newline indent)
          (.printMethodList p (.-MethodList n))
          (.print p outdent newline))
        (do
          (.print p _Lbrace)
          (.printMethodList p (.-MethodList n))))

      (.print p _Rbrace))

    (case [(* MapType)]
      (.print p _Map _Lbrack (.-Key n) _Rbrack (.-Value n)))

    (case [(* ChanType)]
      (when (== (.-Dir n) RecvOnly)
        (.print p _Arrow))

      (.print p _Chan)
      (when (== (.-Dir n) SendOnly)
        (.print p _Arrow))

      (.print p blank)
      (if [(values e _) (assert (* ChanType) (.-Elem n))] (and (== (.-Dir n) 0) (!= e nil) (== (.-Dir e) RecvOnly)) (do
          ;; don't print chan (<-chan T) as chan <-chan T
          (.print p _Lparen)
          (.print p (.-Elem n))
          (.print p _Rparen))

        (.print p (.-Elem n))))


    ;; statements
    (case [(* DeclStmt)]
      (.printDecl p (.-DeclList n)))

    (case [(* EmptyStmt)])
    ;; nothing to print

    (case [(* LabeledStmt)]
      (.print p outdent (.-Label n) _Colon indent newline (.-Stmt n)))

    (case [(* ExprStmt)]
      (.print p (.-X n)))

    (case [(* SendStmt)]
      (.print p (.-Chan n) blank _Arrow blank (.-Value n)))

    (case [(* AssignStmt)]
      (.print p (.-Lhs n))
      (if (== (.-Rhs n) nil)
        ;; TODO(gri) This is going to break the mayCombine
        ;;           check once we enable that again.
        (.print p (.-Op n) (.-Op n)) ; ++ or --
        (do
          (.print p blank (.-Op n) _Assign blank)
          (.print p (.-Rhs n)))))


    (case [(* CallStmt)]
      (.print p (.-Tok n) blank (.-Call n)))

    (case [(* ReturnStmt)]
      (.print p _Return)
      (when (!= (.-Results n) nil)
        (.print p blank (.-Results n))))


    (case [(* BranchStmt)]
      (.print p (.-Tok n))
      (when (!= (.-Label n) nil)
        (.print p blank (.-Label n))))


    (case [(* BlockStmt)]
      (.print p _Lbrace)
      (when (> (len (.-List n)) 0)
        (.print p newline indent)
        (.printStmtList p (.-List n) true)
        (.print p outdent newline))

      (.print p _Rbrace))

    (case [(* IfStmt)]
      (.print p _If blank)
      (when (!= (.-Init n) nil)
        (.print p (.-Init n) _Semi blank))

      (.print p (.-Cond n) blank (.-Then n))
      (when (!= (.-Else n) nil)
        (.print p blank _Else blank (.-Else n))))


    (case [(* SwitchStmt)]
      (.print p _Switch blank)
      (when (!= (.-Init n) nil)
        (.print p (.-Init n) _Semi blank))

      (when (!= (.-Tag n) nil)
        (.print p (.-Tag n) blank))

      (.printSwitchBody p (.-Body n)))

    (case [(* SelectStmt)]
      (.print p _Select blank) ; for now
      (.printSelectBody p (.-Body n)))

    (case [(* RangeClause)]
      (when (!= (.-Lhs n) nil)
        (let [tok _Assign]
          (when (.-Def n)
            (set! tok _Define))

          (.print p (.-Lhs n) blank tok blank)))

      (.print p _Range blank (.-X n)))

    (case [(* ForStmt)]
      (.print p _For blank)
      (if (and (== (.-Init n) nil) (== (.-Post n) nil))
        (when (!= (.-Cond n) nil)
          (.print p (.-Cond n) blank))

        (do
          (when (!= (.-Init n) nil)
            (.print p (.-Init n))
            ;; TODO(gri) clean this up
            (when [(values _ ok) (assert (* RangeClause) (.-Init n))] ok
              (.print p blank (.-Body n))
              (break)))


          (.print p _Semi blank)
          (when (!= (.-Cond n) nil)
            (.print p (.-Cond n)))

          (.print p _Semi blank)
          (when (!= (.-Post n) nil)
            (.print p (.-Post n) blank))))


      (.print p (.-Body n)))

    (case [(* ImportDecl)]
      (when (== (.-Group n) nil)
        (.print p _Import blank))

      (when (!= (.-LocalPkgName n) nil)
        (.print p (.-LocalPkgName n) blank))

      (.print p (.-Path n)))

    (case [(* ConstDecl)]
      (when (== (.-Group n) nil)
        (.print p _Const blank))

      (.printNameList p (.-NameList n))
      (when (!= (.-Type n) nil)
        (.print p blank (.-Type n)))

      (when (!= (.-Values n) nil)
        (.print p blank _Assign blank (.-Values n))))


    (case [(* TypeDecl)]
      (when (== (.-Group n) nil)
        (.print p _Type blank))

      (.print p (.-Name n))
      (when (!= (.-TParamList n) nil)
        (.printParameterList p (.-TParamList n) _Type))

      (.print p blank)
      (when (.-Alias n)
        (.print p _Assign blank))

      (.print p (.-Type n)))

    (case [(* VarDecl)]
      (when (== (.-Group n) nil)
        (.print p _Var blank))

      (.printNameList p (.-NameList n))
      (when (!= (.-Type n) nil)
        (.print p blank (.-Type n)))

      (when (!= (.-Values n) nil)
        (.print p blank _Assign blank (.-Values n))))


    (case [(* FuncDecl)]
      (.print p _Func blank)
      (when [r (.-Recv n)] (!= r nil)
        (.print p _Lparen)
        (when (!= (.-Name r) nil)
          (.print p (.-Name r) blank))

        (.printNode p (.-Type r))
        (.print p _Rparen blank))

      (.print p (.-Name n))
      (when (!= (.-TParamList n) nil)
        (.printParameterList p (.-TParamList n) _Func))

      (.printSignature p (.-Type n))
      (when (!= (.-Body n) nil)
        (.print p blank (.-Body n))))


    (case [(* printGroup)]
      (.print p (.-Tok n) blank _Lparen)
      (when (> (len (.-Decls n)) 0)
        (.print p newline indent)
        (range [_ d (.-Decls n)]
          (.printNode p d)
          (.print p _Semi newline))

        (.print p outdent))

      (.print p _Rparen))

    ;; files
    (case [(* File)]
      (.print p _Package blank (.-PkgName n))
      (when (> (len (.-DeclList n)) 0)
        (.print p _Semi newline newline)
        (.printDeclList p (.-DeclList n))))


    (default
      (panic (fmt/Sprintf "syntax.Iterate: unexpected node type %T" n)))))



^{:go/end 746} (go/method printFields [^{:tag (* printer)} p ^{:tag (slice (* Field))} fields ^{:tag (slice (* BasicLit))} tags ^int i ^int j]
  (if (and (== (+ i 1) j) (== (.-Name (aget fields i)) nil))
    ;; anonymous field
    (.printNode p (.-Type (aget fields i)))
    (do
      (range [k f (subslice fields i j)]
        (when (> k 0)
          (.print p _Comma blank))

        (.printNode p (.-Name f)))

      (.print p blank)
      (.printNode p (.-Type (aget fields i)))))

  (when (and (< i (len tags)) (!= (aget tags i) nil))
    (.print p blank)
    (.printNode p (aget tags i))))



^{:go/end 762} (go/method printFieldList [^{:tag (* printer)} p ^{:tag (slice (* Field))} fields ^{:tag (slice (* BasicLit))} tags ^token sep]
  (let [i0 0
      ^{:line 750 :tag Expr} typ (zero Expr)]
    (range [i f fields]
      (when (or (== (.-Name f) nil) (!= (.-Type f) typ))
        (when (< i0 i)
          (.printFields p fields tags i0 i)
          (.print p sep newline)
          (set! i0 i))

        (set! typ (.-Type f))))


    (.printFields p fields tags i0 (len fields))))


^{:go/end 776} (go/method printMethodList [^{:tag (* printer)} p ^{:tag (slice (* Field))} methods]
  (range [i m methods]
    (when (> i 0)
      (.print p _Semi newline))

    (if (!= (.-Name m) nil) (do
        (.printNode p (.-Name m))
        (.printSignature p (assert (* FuncType) (.-Type m))))

      (.printNode p (.-Type m)))))




^{:go/end 785} (go/method printNameList [^{:tag (* printer)} p ^{:tag (slice (* Name))} list]
  (range [i x list]
    (when (> i 0)
      (.print p _Comma blank))

    (.printNode p x)))



^{:go/end 794} (go/method printExprList [^{:tag (* printer)} p ^{:tag (slice Expr)} list]
  (range [i x list]
    (when (> i 0)
      (.print p _Comma blank))

    (.printNode p x)))



^{:go/end 804} (go/method printExprLines [^{:tag (* printer)} p ^{:tag (slice Expr)} list]
  (when (> (len list) 0)
    (.print p newline indent)
    (range [_ x list]
      (.print p x _Comma newline))

    (.print p outdent)))



^{:go/end 821} (go/func groupFor [^Decl d] :results [token (* Group)]
  (type-switch [d d]
    (case [(* ImportDecl)]
      (return _Import (.-Group d)))
    (case [(* ConstDecl)]
      (return _Const (.-Group d)))
    (case [(* TypeDecl)]
      (return _Type (.-Group d)))
    (case [(* VarDecl)]
      (return _Var (.-Group d)))
    (case [(* FuncDecl)]
      (return _Func nil))
    (default
      (panic "unreachable"))))



(go/type printGroup (struct
    ^{:line 824} node
    ^{:line 825 :tag token} Tok

    (.print p close)))







^{:go/breaks [[5 950]] :go/end 951} (go/func combinesWithName "combinesWithName reports whether a name followed by the expression x\nsyntactically combines to another valid (value) expression. For instance\nusing *T for x, \"name *T\" syntactically appears as the expression x*T.\nOn the other hand, using  P|Q or *P|~Q for x, \"name P|Q\" or \"name *P|~Q\"\ncannot be combined into a valid (value) expression.\n" ^bool [^Expr x]
  (type-switch [x x]
    (case [(* Operation)]
      (when (== (.-Y x) nil)
        ;; name *x.X combines to name*x.X if x.X is not a type element
        (return (and (== (.-Op x) Mul) (not (isTypeElem (.-X x))))))

      ;; binary expressions
      (return (and (combinesWithName (.-X x)) (not (isTypeElem (.-Y x))))))
    (case [(* ParenExpr)]
      ;; Note that the parser strips parentheses in these cases
      ;; (see extractName, parser.typeOrNil) unless keep_parens
      ;; is set, so we should never reach here.
      ;; Do the right thing (rather than panic) for testing and
      ;; in case we change parser behavior.
      ;; See also go.dev/issues/69206.
      (return (not (isTypeElem (.-X x))))))

  false)


^{:go/end 967} (go/method printStmtList [^{:tag (* printer)} p ^{:tag (slice Stmt)} list ^bool braces]
  (range [i x list]
    (.print p x _Semi)
    (cond (< (+ i 1) (len list))
      (.print p newline)
      ^{:line 958} braces

^{:go/end 925} (go/method printParameterList "If tok != 0 print a type parameter list: tok == _Type means\na type parameter list for a type, tok == _Func means a type\nparameter list for a func.\n" [^{:tag (* printer)} p ^{:tag (slice (* Field))} list ^token tok]
  (let [(values open close) (values _Lparen _Rparen)]
    (when (!= tok 0)
      (set! (values open close) (values _Lbrack _Rbrack)))

    (.print p open)
    (range [i f list]
      (when (> i 0)
        (.print p _Comma blank))

      (when (!= (.-Name f) nil)
        (.printNode p (.-Name f))
        (when (< (+ i 1) (len list))
          (let [f1 (aget list (+ i 1))]
            (when (and (!= (.-Name f1) nil) (== (.-Type f1) (.-Type f)))
              (continue)))) ; no need to print type


        (.print p blank))

      (.printNode p (.-Type f)))

    ;; A type parameter list [P T] where the name P and the type expression T syntactically
    ;; combine to another valid (value) expression requires a trailing comma, as in [P *T,]
    ;; (or an enclosing interface as in [P interface(*T)]), so that the type parameter list
    ;; is not parsed as an array length [P*T].
    (when (and (== tok _Type) (== (len list) 1) (combinesWithName (.-Type (aget list 0))))

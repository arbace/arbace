^{:go/end 314} (go/method print [^{:tag (* printer)} p & ^{:tag (slice any)} args]
  (for [i 0] (< i (len args)) (inc! i)
    (type-switch [x (aget args i)]
      (case [nil])
      ;; we should not reach here but don't crash

      (case [Node]
        (.printNode p x))

      (case [token]
        ;; _Name implies an immediately following string
        ;; argument which is the actual value to print.
        (let [^string s (zero string)]
          (if (== x _Name) (do
              (inc! i)
              (when (>= i (len args))
                (panic "missing string argument after _Name"))

              (set! s (assert string (aget args i))))

            (set! s (.String x)))


          ;; TODO(gri) This check seems at the wrong place since it doesn't
          ;;           take into account pending white space.
          (when (mayCombine (.-lastTok p) (aget s 0))
            (panic "adjacent tokens combine without whitespace"))


          (if (== x _Semi)
            ;; delay printing of semi
            (.addWhitespace p semi "")
            (do
              (.flush p x)
              (.writeString p s)
              (set! (.-nlcount p) 0)
              (set! (.-lastTok p) x)))))


      (case [Operator]
        (when (!= x 0)
          (.flush p _Operator)
          (.writeString p (.String x))))


      (case [ctrlSymbol]
        (switch x
          (case [none semi] ; /*, comment*/
            (panic "unreachable"))
          (case [newline]
            ;; TODO(gri) need to handle mandatory newlines after a //-style comment
            (when (not (.-linebreaks p))
              (set! x blank))))


        (.addWhitespace p x ""))

      ;; case *Comment: // comments are not Nodes
      ;; 	p.addWhitespace(comment, x.Text)

      (default
        (panic (fmt/Sprintf "unexpected argument %v (%T)" x x))))))





(in-ns 'go.cmd.compile.internal.syntax) (go/file "syntax.go" :imports [


    ^{:line 8} [fmt "fmt"]
    ^{:line 9} [io "io"]
    ^{:line 10} [os "os"]])



(go/type Mode "Mode describes the parser mode.\n" uint)


(go/const "Modes supported by the parser.\n"
  ^{:line 18} [^{:tag Mode :val 1} CheckBranches (<< 1 iota)]) ; check correct use of labels, break, continue, and goto statements



(go/type Error "Error describes a syntax error. Error implements the error interface.\n" (struct
    ^{:line 23 :tag Pos} Pos
    ^{:line 24 :tag string} Msg))


^{:go/end 29} (go/method Error ^string [^Error err]
  (fmt/Sprintf "%s: %s" (.-Pos err) (.-Msg err)))


(go/var ^error _ (lit Error)) ; verify that Error implements error


(go/type ErrorHandler "An ErrorHandler is called for each error encountered reading a .go file.\n" (func [^error err]))




(go/type Pragma "A Pragma value augments a package, import, const, func, type, or var declaration.\nIts meaning is entirely up to the PragmaHandler,\nexcept that nil is used to mean “no pragma seen.”\n" any)













(go/type PragmaHandler "A PragmaHandler is used to process //go: directives while scanning.\nIt is passed the current pragma value, which starts out being nil,\nand it returns an updated pragma value.\nThe text is the directive, with the \"//\" prefix stripped.\nThe current pragma is saved at each package, import, const, func, type, or var\ndeclaration, into the File, ImportDecl, ConstDecl, FuncDecl, TypeDecl, or VarDecl node.\n\nIf text is the empty string, the pragma is being returned\nto the handler unused, meaning it appeared before a non-declaration.\nThe handler may wish to report an error. In this case, pos is the\ncurrent parser position, not the position of the pragma itself.\nBlank specifies whether the line is blank before the pragma.\n" (func [^Pos pos ^bool blank ^string text ^Pragma current] [Pragma]))












^{:go/end 81} (go/func Parse "Parse parses a single Go source file from src and returns the corresponding\nsyntax tree. If there are errors, Parse will return the first error found,\nand a possibly partially constructed syntax tree, or nil.\n\nIf errh != nil, it is called with each error encountered, and Parse will\nprocess as much source as possible. In this case, the returned syntax tree\nis only nil if no correct package clause was found.\nIf errh is nil, Parse will terminate immediately upon encountering the first\nerror, and the returned syntax tree is nil.\n\nIf pragh != nil, it is called with each pragma encountered.\n" [^{:tag (* PosBase)} base ^io/Reader src ^ErrorHandler errh ^PragmaHandler pragh ^Mode mode] :results [^{:tag (* File)} _ ^error first]
  (defer (^{:go/end 75} (fn []
        (when [p (recover)] (!= p nil)
          (when [(values err ok) (assert Error p)] ok
            (set! first err)
            (return))

          (panic p)))))



  (let [^parser p (zero parser)]
    (.init p base src errh pragh mode)
    ^{:go/via [scanner]} (.next p)
    (return (.fileOrNil p) (.-first p))))



^{:go/end 94} (go/func ParseFile "ParseFile behaves like Parse but it reads the source from the named file.\n" [^string filename ^ErrorHandler errh ^PragmaHandler pragh ^Mode mode] :results [(* File) error]
  (let [(values f err) (os/Open filename)]
    (when (!= err nil)
      (when (!= errh nil)
        (errh err))

      (return nil err))

    (defer (.Close f))
    (Parse (NewFileBase filename) f errh pragh mode)))

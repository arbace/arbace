      ^{:line 23} fwdGotos (.blockBranches ls nil (lit targets) nil ^{:go/via [stmt node]} (.Pos body) (.-List body))]

    ;; If there are any forward gotos left, no matching label was
    ;; found for them. Either those labels were never defined, or
    ;; they are inside blocks and not reachable from the gotos.
    (range [_ fwd fwdGotos]
      (let [name (.-Value (.-Label fwd))]
        (if [l (aget (.-labels ls) name)] (!= l nil) (do
            (set! (.-used l) true) ; avoid "defined and not used" error
            (.errf ls ^{:go/via [expr node]} (.Pos (.-Label fwd)) "goto %s jumps into block starting at %s" name (.-start (.-parent l))))

          (.errf ls ^{:go/via [expr node]} (.Pos (.-Label fwd)) "label %s not defined" name))))



    ;; spec: "It is illegal to define a label that is never used."
    (range [_ l (.-labels ls)]
      (when (not (.-used l))
        (let [l (.-Label (.-lstmt l))]
          (.errf ls ^{:go/via [expr node]} (.Pos l) "label %s defined and not used" (.-Value l)))))))





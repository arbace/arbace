;; This file implements helper functions for scope position computations.

(in-ns 'go.cmd.compile.internal.syntax) (go/file "positions.go" :imports [])


^{:go/end 113} (go/func StartPos "StartPos returns the start position of n.\n" ^Pos [^Node n]
  ;; Cases for nodes which don't need a correction are commented out.
  (for [m n] _ _
    (type-switch [n m]
      (case [nil]
        (panic "nil node"))

      ;; packages
      (case [(* File)]
        ;; file block starts at the beginning of the file
        (return (MakePos (.Base ^{:go/via [node]} (.Pos n)) 1 1)))

      ;; declarations
      ;; case *ImportDecl:
      ;; case *ConstDecl:
      ;; case *TypeDecl:
      ;; case *VarDecl:
      ;; case *FuncDecl:

      ;; expressions
      ;; case *BadExpr:
      ;; case *Name:
      ;; case *BasicLit:
      (case [(* CompositeLit)]
        (when (!= (.-Type n) nil)
          (set! m (.-Type n))
          (continue))

        (return ^{:go/via [expr node]} (.Pos n)))
      (case [(* KeyValueExpr)]
        (set! m (.-Key n)))
      ;; case *FuncLit:
      ;; case *ParenExpr:
      (case [(* SelectorExpr)]
        (set! m (.-X n)))
      (case [(* IndexExpr)]
        (set! m (.-X n)))
      ;; case *SliceExpr:
      (case [(* AssertExpr)]
        (set! m (.-X n)))
      (case [(* TypeSwitchGuard)]
        (when (!= (.-Lhs n) nil)
          (set! m (.-Lhs n))
          (continue))

        (set! m (.-X n)))
      (case [(* Operation)]
        (when (!= (.-Y n) nil)
          (set! m (.-X n))
          (continue))

        (return ^{:go/via [expr node]} (.Pos n)))
      (case [(* CallExpr)]
        (set! m (.-Fun n)))
      (case [(* ListExpr)]
        (when (> (len (.-ElemList n)) 0)
          (set! m (aget (.-ElemList n) 0))
          (continue))

        (return ^{:go/via [expr node]} (.Pos n)))
      ;; types
      ;; case *ArrayType:
      ;; case *SliceType:
      ;; case *DotsType:
      ;; case *StructType:
      ;; case *Field:
      ;; case *InterfaceType:
      ;; case *FuncType:
      ;; case *MapType:
      ;; case *ChanType:

      ;; statements
      ;; case *EmptyStmt:
      ;; case *LabeledStmt:
      ;; case *BlockStmt:
      ;; case *ExprStmt:
      (case [(* SendStmt)]
        (set! m (.-Chan n)))
      ;; case *DeclStmt:
      (case [(* AssignStmt)]
        (set! m (.-Lhs n)))
      ;; case *BranchStmt:
      ;; case *CallStmt:
      ;; case *ReturnStmt:
      ;; case *IfStmt:
      ;; case *ForStmt:
      ;; case *SwitchStmt:
      ;; case *SelectStmt:

      ;; helper nodes
      (case [(* RangeClause)]
        (when (!= (.-Lhs n) nil)
          (set! m (.-Lhs n))
          (continue))

        (set! m (.-X n)))
      ;; case *CaseClause:
      ;; case *CommClause:

      (default
        (return (.Pos n))))))













^{:go/end 337} (go/func EndPos "EndPos returns the approximate end position of n in the source.\nFor some nodes (*Name, *BasicLit) it returns the position immediately\nfollowing the node; for others (*BlockStmt, *SwitchStmt, etc.) it\nreturns the position of the closing '}'; and for some (*ParenExpr)\nthe returned position is the end position of the last enclosed\nexpression.\nThus, EndPos should not be used for exact demarcation of the\nend of a node in the source; it is mostly useful to determine\nscope ranges where there is some leeway.\n" ^Pos [^Node n]
  (for [m n] _ _
    (type-switch [n m]
      (case [nil]
        (panic "nil node"))

      ;; packages
      (case [(* File)]
        (return (.-EOF n)))

      ;; declarations
      (case [(* ImportDecl)]
        (set! m (.-Path n)))
      (case [(* ConstDecl)]
        (when (!= (.-Values n) nil)
          (set! m (.-Values n))
          (continue))

        (when (!= (.-Type n) nil)
          (set! m (.-Type n))
          (continue))

        (when [l (len (.-NameList n))] (> l 0)
          (set! m (aget (.-NameList n) (- l 1)))
          (continue))

        (return ^{:go/via [decl node]} (.Pos n)))
      (case [(* TypeDecl)]
        (set! m (.-Type n)))
      (case [(* VarDecl)]
        (when (!= (.-Values n) nil)
          (set! m (.-Values n))
          (continue))

        (when (!= (.-Type n) nil)
          (set! m (.-Type n))
          (continue))

        (when [l (len (.-NameList n))] (> l 0)
          (set! m (aget (.-NameList n) (- l 1)))
          (continue))

        (return ^{:go/via [decl node]} (.Pos n)))
      (case [(* FuncDecl)]
        (when (!= (.-Body n) nil)
          (set! m (.-Body n))
          (continue))

        (set! m (.-Type n)))

      ;; expressions
      (case [(* BadExpr)]
        (return ^{:go/via [expr node]} (.Pos n)))
      (case [(* Name)]
        (let [p ^{:go/via [expr node]} (.Pos n)]
          (return (MakePos (.Base p) (.Line p) (+ (.Col p) (conv uint (len (.-Value n))))))))
      (case [(* BasicLit)]
        (let [p ^{:go/via [expr node]} (.Pos n)]
          (return (MakePos (.Base p) (.Line p) (+ (.Col p) (conv uint (len (.-Value n))))))))
      (case [(* CompositeLit)]
        (return (.-Rbrace n)))
      (case [(* KeyValueExpr)]
        (set! m (.-Value n)))
      (case [(* FuncLit)]
        (set! m (.-Body n)))
      (case [(* ParenExpr)]
        (set! m (.-X n)))
      (case [(* SelectorExpr)]
        (set! m (.-Sel n)))
      (case [(* IndexExpr)]
        (set! m (.-Index n)))
      (case [(* SliceExpr)]
        (for [i (- (len (.-Index n)) 1)] (>= i 0) (dec! i)
          (when [x (aget (.-Index n) i)] (!= x nil)
            (set! m x)
            (continue)))


        (set! m (.-X n)))
      (case [(* AssertExpr)]
        (set! m (.-Type n)))
      (case [(* TypeSwitchGuard)]
        (set! m (.-X n)))
      (case [(* Operation)]
        (when (!= (.-Y n) nil)
          (set! m (.-Y n))
          (continue))

        (set! m (.-X n)))
      (case [(* CallExpr)]
        (when [l (lastExpr (.-ArgList n))] (!= l nil)
          (set! m l)
          (continue))

        (set! m (.-Fun n)))
      (case [(* ListExpr)]
        (when [l (lastExpr (.-ElemList n))] (!= l nil)
          (set! m l)
          (continue))

        (return ^{:go/via [expr node]} (.Pos n)))

      ;; types
      (case [(* ArrayType)]
        (set! m (.-Elem n)))
      (case [(* SliceType)]
        (set! m (.-Elem n)))
      (case [(* DotsType)]
        (set! m (.-Elem n)))
      (case [(* StructType)]
        (when [l (lastField (.-FieldList n))] (!= l nil)
          (set! m l)
          (continue))

        (return ^{:go/via [expr node]} (.Pos n)))
      ;; TODO(gri) need to take TagList into account
      (case [(* Field)]
        (when (!= (.-Type n) nil)
          (set! m (.-Type n))
          (continue))

        (set! m (.-Name n)))
      (case [(* InterfaceType)]
        (when [l (lastField (.-MethodList n))] (!= l nil)
          (set! m l)
          (continue))

        (return ^{:go/via [expr node]} (.Pos n)))
      (case [(* FuncType)]
        (when [l (lastField (.-ResultList n))] (!= l nil)
          (set! m l)
          (continue))

        (when [l (lastField (.-ParamList n))] (!= l nil)
          (set! m l)
          (continue))

        (return ^{:go/via [expr node]} (.Pos n)))
      (case [(* MapType)]
        (set! m (.-Value n)))
      (case [(* ChanType)]
        (set! m (.-Elem n)))

      ;; statements
      (case [(* EmptyStmt)]
        (return ^{:go/via [simpleStmt stmt node]} (.Pos n)))
      (case [(* LabeledStmt)]
        (set! m (.-Stmt n)))
      (case [(* BlockStmt)]
        (return (.-Rbrace n)))
      (case [(* ExprStmt)]
        (set! m (.-X n)))
      (case [(* SendStmt)]
        (set! m (.-Value n)))
      (case [(* DeclStmt)]
        (when [l (lastDecl (.-DeclList n))] (!= l nil)
          (set! m l)
          (continue))

        (return ^{:go/via [stmt node]} (.Pos n)))
      (case [(* AssignStmt)]
        (set! m (.-Rhs n))
        (when (== m nil)
          (let [p (EndPos (.-Lhs n))]
            (return (MakePos (.Base p) (.Line p) (+ (.Col p) 2))))))

      (case [(* BranchStmt)]
        (when (!= (.-Label n) nil)
          (set! m (.-Label n))
          (continue))

        (return ^{:go/via [stmt node]} (.Pos n)))
      (case [(* CallStmt)]
        (set! m (.-Call n)))
      (case [(* ReturnStmt)]
        (when (!= (.-Results n) nil)
          (set! m (.-Results n))
          (continue))

        (return ^{:go/via [stmt node]} (.Pos n)))
      (case [(* IfStmt)]
        (when (!= (.-Else n) nil)
          (set! m (.-Else n))
          (continue))

        (set! m (.-Then n)))
      (case [(* ForStmt)]
        (set! m (.-Body n)))
      (case [(* SwitchStmt)]
        (return (.-Rbrace n)))
      (case [(* SelectStmt)]
        (return (.-Rbrace n)))

      ;; helper nodes
      (case [(* RangeClause)]
        (set! m (.-X n)))
      (case [(* CaseClause)]
        (when [l (lastStmt (.-Body n))] (!= l nil)
          (set! m l)
          (continue))

        (return (.-Colon n)))
      (case [(* CommClause)]
        (when [l (lastStmt (.-Body n))] (!= l nil)
          (set! m l)
          (continue))

        (return (.-Colon n)))

      (default
        (return (.Pos n))))))




^{:go/breaks [[4 343]] :go/end 344} (go/func lastDecl ^Decl [^{:tag (slice Decl)} list]
  (when [l (len list)] (> l 0)
    (return (aget list (- l 1))))

  nil)


^{:go/breaks [[4 350]] :go/end 351} (go/func lastExpr ^Expr [^{:tag (slice Expr)} list]
  (when [l (len list)] (> l 0)
    (return (aget list (- l 1))))

  nil)


^{:go/breaks [[4 357]] :go/end 358} (go/func lastStmt ^Stmt [^{:tag (slice Stmt)} list]
  (when [l (len list)] (> l 0)
    (return (aget list (- l 1))))

  nil)


^{:go/breaks [[4 364]] :go/end 365} (go/func lastField ^{:tag (* Field)} [^{:tag (slice (* Field))} list]
  (when [l (len list)] (> l 0)
    (return (aget list (- l 1))))

  nil)

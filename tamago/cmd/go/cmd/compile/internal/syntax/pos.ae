(in-ns 'go.cmd.compile.internal.syntax) (go/file "pos.go" :imports [

    ^{:line 7} [fmt "fmt"]])





(go/const ^{:val 1073741824 :doc "PosMax is the largest line or column value that can be represented without loss.\nIncoming values (arguments) larger than PosMax will be set to PosMax.\n\nKeep this consistent with maxLineCol in go/scanner.\n"} PosMax (<< 1 30))






(go/type Pos "A Pos represents an absolute (line, col) source position\nwith a reference to position base for computing relative\n(to a file, or line directive) position information.\nPos values are intentionally light-weight so that they\ncan be created without too much concern about space use.\n" (struct
    ^{:line 21 :tag (* PosBase)} base
    ^{:line 22 :tag uint32} line ^uint32 col))



^{:go/end 26} (go/func MakePos "MakePos returns a new Pos for the given PosBase, line and column.\n" ^Pos [^{:tag (* PosBase)} base ^uint line ^uint col] (lit Pos base (sat32 line) (sat32 col)))

;; TODO(gri) IsKnown makes an assumption about linebase < 1.
;; Maybe we should check for Base() != nil instead.

^{:go/end 31} (go/method Pos ^Pos [^Pos pos] pos)
^{:go/end 32} (go/method IsKnown ^bool [^Pos pos] (> (.-line pos) 0))
^{:go/end 33} (go/method Base ^{:tag (* PosBase)} [^Pos pos] (.-base pos))
^{:go/end 34} (go/method Line ^uint [^Pos pos] (conv uint (.-line pos)))
^{:go/end 35} (go/method Col ^uint [^Pos pos] (conv uint (.-col pos)))




^{:go/end 47} (go/method FileBase "FileBase returns the PosBase of the file containing pos,\nskipping over intermediate PosBases from //line directives.\nThe result is nil if pos doesn't have a file base.\n" ^{:tag (* PosBase)} [^Pos pos]
  (let [b (.-base pos)]
    (while (and (!= b nil) (!= b (.-base (.-pos b))))
      (set! b (.-base (.-pos b))))

    ;; b == nil || b == b.pos.base
    ^{:line 46} b))


^{:go/end 49} (go/method RelFilename ^string [^Pos pos] (.Filename (.-base pos)))

^{:go/end 58} (go/method RelLine ^uint [^Pos pos]
  (let [b (.-base pos)]
    (when (== (.Line b) 0)
      ;; base line is unknown => relative line is unknown
      (return 0))

    (+ (.Line b) (- (.Line pos) (.Line (.Pos b))))))


^{:go/end 74} (go/method RelCol ^uint [^Pos pos]
  (let [b (.-base pos)]
    (when (== (.Col b) 0)
      ;; base column is unknown => relative column is unknown
      ;; (the current specification for line directives requires
      ;; this to apply until the next PosBase/line directive,
      ;; not just until the new newline)
      (return 0))

    (when (== (.Line pos) (.Line (.Pos b)))
      ;; pos on same line as pos base => column is relative to pos base
      (return (+ (.Col b) (- (.Col pos) (.Col (.Pos b))))))

    (.Col pos)))










^{:go/end 113} (go/method Cmp "Cmp compares the positions p and q and returns a result r as follows:\n\n\tr <  0: p is before q\n\tr == 0: p and q are the same position (but may not be identical)\n\tr >  0: p is after q\n\nIf p and q are in different files, p is before q if the filename\nof p sorts lexicographically before the filename of q.\n" ^int [^Pos p ^Pos q]
  (let [pname (.RelFilename p)
      ^{:line 86} qname (.RelFilename q)]
    (switch
      (case [(< pname qname)]
        (return -1))
      (case [(> pname qname)]
        (return (+ 1))))


    (let [pline (.Line p)
        ^{:line 95} qline (.Line q)]
      (switch
        (case [(< pline qline)]
          (return -1))
        (case [(> pline qline)]
          (return (+ 1))))


      ^{:go/breaks [[3 112]]} (let [pcol (.Col p)
          ^{:line 104} qcol (.Col q)]
        (switch
          (case [(< pcol qcol)]
            (return -1))
          (case [(> pcol qcol)]
            (return (+ 1))))


        0))))


^{:go/end 123} (go/method String ^string [^Pos pos]
  (let [rel (lit position_ (.RelFilename pos) (.RelLine pos) (.RelCol pos))
      ^{:line 117} abs (lit position_ (.RelFilename (.Pos (.Base pos))) (.Line pos) (.Col pos))
      ^{:line 118} s (.String rel)]
    (when (!= rel abs)
      (set! s + (+ "[" (.String abs) "]")))

    ^{:line 122} s))



(go/type position_ "TODO(gri) cleanup: find better name, avoid conflict with position in error_test.go\n" (struct
    ^{:line 127 :tag string} filename
    ^{:line 128 :tag uint} line ^uint col))


^{:go/end 142} (go/method String ^string [^position_ p]
  (when (== (.-line p) 0)
    (when (== (.-filename p) "")
      (return "<unknown position>"))

    (return (.-filename p)))

  (when (== (.-col p) 0)
    (return (fmt/Sprintf "%s:%d" (.-filename p) (.-line p))))

  (fmt/Sprintf "%s:%d:%d" (.-filename p) (.-line p) (.-col p)))




(go/type PosBase "A PosBase represents the base for relative position information:\nAt position pos, the relative position is filename:line:col.\n" (struct
    ^{:line 147 :tag Pos} pos
    ^{:line 148 :tag string} filename
    ^{:line 149 :tag uint32} line ^uint32 col
    ^{:line 150 :tag bool} trimmed)) ; whether -trimpath has been applied





^{:go/end 158} (go/func NewFileBase "NewFileBase returns a new PosBase for the given filename.\nA file PosBase's position is relative to itself, with the\nposition being filename:1:1.\n" ^{:tag (* PosBase)} [^string filename]
  (NewTrimmedFileBase filename false))



^{:go/end 165} (go/func NewTrimmedFileBase "NewTrimmedFileBase is like NewFileBase, but allows specifying Trimmed.\n" ^{:tag (* PosBase)} [^string filename ^bool trimmed]
  (let [base (addr (lit PosBase (MakePos nil linebase colbase) filename linebase colbase trimmed))]
    (set! (.-base (.-pos base)) base)
    ^{:line 164} base))







^{:go/end 174} (go/func NewLineBase "NewLineBase returns a new PosBase for a line directive \"line filename:line:col\"\nrelative to pos, which is the position of the character immediately following\nthe comment containing the line directive. For a directive in a line comment,\nthat position is the beginning of the next line (i.e., the newline character\nbelongs to the line comment).\n" ^{:tag (* PosBase)} [^Pos pos ^string filename ^bool trimmed ^uint line ^uint col]
  (addr (lit PosBase pos filename (sat32 line) (sat32 col) trimmed)))


^{:go/end 181} (go/method IsFileBase ^bool [^{:tag (* PosBase)} base]
  (when (== base nil)
    (return false))

  (== (.-base (.-pos base)) base))


^{:go/end 188} (go/method Pos [^{:tag (* PosBase)} base] :results [^Pos _]
  (when (== base nil)
    (return))

  (.-pos base))


^{:go/end 195} (go/method Filename ^string [^{:tag (* PosBase)} base]
  (when (== base nil)
    (return ""))

  (.-filename base))


^{:go/end 202} (go/method Line ^uint [^{:tag (* PosBase)} base]
  (when (== base nil)
    (return 0))

  (conv uint (.-line base)))


^{:go/end 209} (go/method Col ^uint [^{:tag (* PosBase)} base]
  (when (== base nil)
    (return 0))

  (conv uint (.-col base)))


^{:go/end 216} (go/method Trimmed ^bool [^{:tag (* PosBase)} base]
  (when (== base nil)
    (return false))

  (.-trimmed base))


^{:go/end 223} (go/func sat32 ^uint32 [^uint x]
  (when (> x PosMax)
    (return PosMax))

  (conv uint32 x))

(in-ns 'go.cmd.compile.internal.syntax) (go/file "type.go" :imports [

    ^{:line 7} [constant "go/constant"]])






(go/type Type "A Type represents a type of Go.\nAll types implement the Type interface.\n(This type originally lived in types2. We moved it here\nso we could depend on it from other packages without\nintroducing an import cycle.)\n" (interface




    (^{:doc "Underlying returns the underlying type of a type.\nUnderlying types are never Named, TypeParam, or Alias types.\n\nSee https://go.dev/ref/spec#Underlying_types.\n"} Underlying ^Type [])


    (^{:doc "String returns a string representation of a type.\n"} String ^string [])))






(go/type typeInfo "Expressions in the syntax package provide storage for\nthe typechecker to record its results. This interface\nis the mechanism the typechecker uses to record results,\nand clients use to retrieve those results.\n" (interface
    (SetTypeInfo [TypeAndValue])
    (GetTypeInfo ^TypeAndValue [])))







(go/type TypeAndValue "A TypeAndValue records the type information, constant\nvalue if known, and various other flags associated with\nan expression.\nThis type is similar to types2.TypeAndValue, but exposes\nnone of types2's internals.\n" (struct
    ^{:line 40 :tag Type} Type
    ^{:line 41 :tag constant/Value} Value
    ^{:line 42} exprFlags))


(go/type exprFlags uint16)

^{:go/end 47} (go/method IsVoid ^bool [^exprFlags f] (!= (bit-and f 1) 0))
^{:go/end 48} (go/method IsType ^bool [^exprFlags f] (!= (bit-and f 2) 0))
^{:go/end 49} (go/method IsBuiltin ^bool [^exprFlags f] (!= (bit-and f 4) 0)) ; a language builtin that resembles a function call, e.g., "make, append, new"
^{:go/end 50} (go/method IsValue ^bool [^exprFlags f] (!= (bit-and f 8) 0))
^{:go/end 51} (go/method IsNil ^bool [^exprFlags f] (!= (bit-and f 16) 0))
^{:go/end 52} (go/method Addressable ^bool [^exprFlags f] (!= (bit-and f 32) 0))
^{:go/end 53} (go/method Assignable ^bool [^exprFlags f] (!= (bit-and f 64) 0))
^{:go/end 54} (go/method HasOk ^bool [^exprFlags f] (!= (bit-and f 128) 0))
^{:go/end 55} (go/method IsRuntimeHelper ^bool [^exprFlags f] (!= (bit-and f 256) 0)) ; a runtime function called from transformed syntax

^{:go/end 57} (go/method SetIsVoid [^{:tag (* exprFlags)} f] (set! @f bit-or 1))
^{:go/end 58} (go/method SetIsType [^{:tag (* exprFlags)} f] (set! @f bit-or 2))
^{:go/end 59} (go/method SetIsBuiltin [^{:tag (* exprFlags)} f] (set! @f bit-or 4))
^{:go/end 60} (go/method SetIsValue [^{:tag (* exprFlags)} f] (set! @f bit-or 8))
^{:go/end 61} (go/method SetIsNil [^{:tag (* exprFlags)} f] (set! @f bit-or 16))
^{:go/end 62} (go/method SetAddressable [^{:tag (* exprFlags)} f] (set! @f bit-or 32))
^{:go/end 63} (go/method SetAssignable [^{:tag (* exprFlags)} f] (set! @f bit-or 64))
^{:go/end 64} (go/method SetHasOk [^{:tag (* exprFlags)} f] (set! @f bit-or 128))
^{:go/end 65} (go/method SetIsRuntimeHelper [^{:tag (* exprFlags)} f] (set! @f bit-or 256))



(go/type typeAndValue "a typeAndValue contains the results of typechecking an expression.\nIt is embedded in expression nodes.\n" (struct
    ^{:line 70 :tag TypeAndValue} tv))


^{:go/end 75} (go/method SetTypeInfo [^{:tag (* typeAndValue)} x ^TypeAndValue tv]
  (set! (.-tv x) tv))

^{:go/end 78} (go/method GetTypeInfo ^TypeAndValue [^{:tag (* typeAndValue)} x]
  (.-tv x))

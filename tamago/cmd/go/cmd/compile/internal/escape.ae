(ns go.cmd.compile.internal.escape
  (:require [arbace.go :as go]))

(go/package escape
  :path "cmd/compile/internal/escape"
  :files ["alias.go" "assign.go" "call.go" "escape.go" "expr.go" "graph.go" "leaks.go" "solve.go" "stmt.go" "utils.go"]
  :positions :lines)

(load "escape/alias")
(load "escape/assign")
(load "escape/call")
(load "escape/escape")
(load "escape/expr")
(load "escape/graph")
(load "escape/leaks")
(load "escape/solve")
(load "escape/stmt")
(load "escape/utils")

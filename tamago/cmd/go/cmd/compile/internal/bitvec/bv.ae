(in-ns 'go.cmd.compile.internal.bitvec) (go/file "bv.go" :imports [


    ^{:line 8} [bits "math/bits"]

    ^{:line 10} [base "cmd/compile/internal/base"]])


(go/const
  ^{:line 14} [^{:val 32} wordBits 32]
  ^{:line 15} [^{:val 31} wordMask (- wordBits 1)]
  ^{:line 16} [^{:val 5} wordShift 5])



(go/type BitVec "A BitVec is a bit vector.\n" (struct
    ^{:line 21 :tag int32} N ; number of bits in vector
    ^{:line 22 :tag (slice uint32)} B)) ; words holding bits


^{:go/end 28} (go/func New ^BitVec [^int32 n]
  (let [nword (/ (- (+ n wordBits) 1) wordBits)]
    (lit BitVec n (make (slice uint32) nword))))


(go/type Bulk (struct
    ^{:line 31 :tag (slice uint32)} words
    ^{:line 32 :tag int32} nbit
    ^{:line 33 :tag int32} nword))


^{:go/end 44} (go/func NewBulk ^Bulk [^int32 nbit ^int32 count]
  (let [nword (/ (- (+ nbit wordBits) 1) wordBits)
      ^{:line 38} size (* (conv int64 nword) (conv int64 count))]
    ^{:go/breaks [2 4 6]} (lit Bulk
      :words (make (slice uint32) size)
      :nbit nbit
      :nword nword)))



^{:go/end 50} (go/method Next ^BitVec [^{:tag (* Bulk)} b]
  (let [out (lit BitVec (.-nbit b) (subslice (.-words b) _ (.-nword b)))]
    (set! (.-words b) (subslice (.-words b) (.-nword b)))
    ^{:line 49} out))


^{:go/breaks [[5 61]] :go/end 62} (go/method Eq ^bool [^BitVec bv1 ^BitVec bv2]
  (when (!= (.-N bv1) (.-N bv2))
    (base/Fatalf "bvequal: lengths %d and %d are not equal" (.-N bv1) (.-N bv2)))

  (range [i x (.-B bv1)]
    (when (!= x (aget (.-B bv2) i))
      (return false)))


  true)


^{:go/end 66} (go/method Copy [^BitVec dst ^BitVec src]
  (copy (.-B dst) (.-B src)))


^{:go/end 74} (go/method Get ^bool [^BitVec bv ^int32 i]
  (when (or (< i 0) (>= i (.-N bv)))
    (base/Fatalf "bvget: index %d is out of bounds with length %d\n" i (.-N bv)))

  (let [mask (conv uint32 ^uint32 (<< 1 (conv uint (% i wordBits))))]
    (!= (bit-and (aget (.-B bv) (>> i wordShift)) mask) 0)))


^{:go/end 82} (go/method Set [^BitVec bv ^int32 i]
  (when (or (< i 0) (>= i (.-N bv)))
    (base/Fatalf "bvset: index %d is out of bounds with length %d\n" i (.-N bv)))

  (let [mask (conv uint32 ^uint32 (<< 1 (conv uint (% i wordBits))))]
    (set! (aget (.-B bv) (/ i wordBits)) bit-or mask)))


^{:go/end 90} (go/method Unset [^BitVec bv ^int32 i]
  (when (or (< i 0) (>= i (.-N bv)))
    (base/Fatalf "bvunset: index %d is out of bounds with length %d\n" i (.-N bv)))

  (let [mask (conv uint32 ^uint32 (<< 1 (conv uint (% i wordBits))))]
    (set! (aget (.-B bv) (/ i wordBits)) bit-and-not mask)))




^{:go/end 117} (go/method Next "Next returns the smallest index >= i for which bvget(bv, i) == 1.\nIf there is no such index, bvnext returns -1.\n" ^int32 [^BitVec bv ^int32 i]
  (when (>= i (.-N bv))
    (return -1))


  ;; Jump i ahead to next word with bits.
  (when (== (>> (aget (.-B bv) (>> i wordShift)) (conv uint (bit-and i wordMask))) 0)
    (set! i bit-and-not wordMask)
    (set! i + wordBits)
    (while (and (< i (.-N bv)) (== (aget (.-B bv) (>> i wordShift)) 0))
      (set! i + wordBits)))



  (when (>= i (.-N bv))
    (return -1))


  ;; Find 1 bit.
  (let [w (>> (aget (.-B bv) (>> i wordShift)) (conv uint (bit-and i wordMask)))]
    (set! i + (conv int32 (bits/TrailingZeros32 w)))

    ^{:line 116} i))


^{:go/breaks [[4 125]] :go/end 126} (go/method IsEmpty ^bool [^BitVec bv]
  (range [_ x (.-B bv)]
    (when (!= x 0)
      (return false)))


  true)


^{:go/end 134} (go/method Count ^int [^BitVec bv]
  (let [n 0]
    (range [_ x (.-B bv)]
      (set! n + (bits/OnesCount32 x)))

    ^{:line 133} n))


^{:go/end 143} (go/method Not [^BitVec bv]
  (range [i x (.-B bv)]
    (aset (.-B bv) i (bit-not x)))

  (when (!= (% (.-N bv) wordBits) 0)
    (set! (aget (.-B bv) (- (len (.-B bv)) 1)) bit-and (- ^uint32 (<< 1 (conv uint (% (.-N bv) wordBits))) 1)))) ; clear bits past N in the last word




^{:go/end 155} (go/method Or "union\n" [^BitVec dst ^BitVec src1 ^BitVec src2]
  (when (== (len (.-B src1)) 0)
    (return))

  (set! (values _ _) (values (aget (.-B dst) (- (len (.-B src1)) 1)) (aget (.-B src2) (- (len (.-B src1)) 1)))) ; hoist bounds checks out of the loop

  (range [i x (.-B src1)]
    (aset (.-B dst) i (bit-or x (aget (.-B src2) i)))))




^{:go/end 167} (go/method And "intersection\n" [^BitVec dst ^BitVec src1 ^BitVec src2]
  (when (== (len (.-B src1)) 0)
    (return))

  (set! (values _ _) (values (aget (.-B dst) (- (len (.-B src1)) 1)) (aget (.-B src2) (- (len (.-B src1)) 1)))) ; hoist bounds checks out of the loop

  (range [i x (.-B src1)]
    (aset (.-B dst) i (bit-and x (aget (.-B src2) i)))))




^{:go/end 179} (go/method AndNot "difference\n" [^BitVec dst ^BitVec src1 ^BitVec src2]
  (when (== (len (.-B src1)) 0)
    (return))

  (set! (values _ _) (values (aget (.-B dst) (- (len (.-B src1)) 1)) (aget (.-B src2) (- (len (.-B src1)) 1)))) ; hoist bounds checks out of the loop

  (range [i x (.-B src1)]
    (aset (.-B dst) i (bit-and-not x (aget (.-B src2) i)))))



^{:go/end 192} (go/method String ^string [^BitVec bv]
  (let [s (make (slice byte) (+ 2 (.-N bv)))]
    (copy s "#*")
    (for [i (conv int32 0)] (< i (.-N bv)) (inc! i)
      (let [ch (conv byte \0)]
        (when (.Get bv i)
          (set! ch \1))

        (aset s (+ 2 i) ch)))

    (conv string s)))


^{:go/end 196} (go/method Clear [^BitVec bv]
  (clear (.-B bv)))

^{:go/end 664} (go/func RecordPackageName "RecordPackageName records the name of the package being\ncompiled, so that the linker can save it in the compile unit's DIE.\n" []
  (let [s (.Lookup base/Ctxt (+ dwarf/CUInfoPrefix "packagename." (.-Pkgpath base/Ctxt)))]
    (set! (.-Type s) objabi/SDWARFCUINFO)
    ;; Sometimes (for example when building tests) we can link
    ;; together two package main archives. So allow dups.
    ^{:go/via [Attribute]} (.Set s obj/AttrDuplicateOK true)
    (set! (.-Data base/Ctxt) (append (.-Data base/Ctxt) s))
    (set! (.-P s) (conv (slice byte) (.-Name types/LocalPkg)))))





^{:go/end 674} (go/func shouldEmitDwarfVar "shouldEmitDwarfVar reports whether n should have a DWARF variable entry.\nThis consolidates filtering that was previously spread across IR (AutoTemp),\nSSA (IsVarWantedForDebug), and dwarfgen (symbol name checks).\n" ^bool [^{:tag (* ir/Name)} n]
  (when (ir/IsAutoTmp n)
    (return false))

  (shouldEmitDwarfVarSafe n))







^{:go/breaks [[7 691]] :go/end 692} (go/func shouldEmitDwarfVarSafe "shouldEmitDwarfVarSafe is like shouldEmitDwarfVar but omits the ir.IsAutoTmp\ncheck, making it safe to call during parallel compilation on shared ir.Name\nnodes (e.g., in preInliningDcls). ir.IsAutoTmp reads the mutable flags bitset,\nwhich can race with other goroutines writing different flags during compilation.\nAuto temps have names starting with \".\" so callers must filter those separately.\n" ^bool [^{:tag (* ir/Name)} n]
  (when (not (ssa/IsVarWantedForDebug n))
    (return false))

  (when (== (.-Name (.Sym n)) "_")
    (return false))

  (when (.IsUntyped ^{:go/via [miniExpr]} (.Type n))
    (return false))

  true)


^{:go/end 696} (go/func closureOffset ^int64 [^{:tag (* ir/Name)} n ^{:tag (map (* ir/Name) int64)} closureVars]

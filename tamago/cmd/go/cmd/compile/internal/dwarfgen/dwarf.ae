^{:go/end 652} (go/func RecordFlags "RecordFlags records the specified command-line flags to be placed\nin the DWARF info.\n" [& ^{:tag (slice string)} flags]
  (when (== (.-Pkgpath base/Ctxt) "")
    (base/Fatalf "missing pkgpath"))


  (let-type [BoolFlag (interface
        (IsBoolFlag ^bool []))

      ^{:line 603} CountFlag (interface
        (IsCountFlag ^bool []))]

    (let [^bytes/Buffer cmd (zero bytes/Buffer)]
      (range [_ name flags]
        (let [f (flag/Lookup name)]
          (when (== f nil)
            (continue))

          (let [getter (assert flag/Getter (.-Value f))]
            (when (== (.String getter) (.-DefValue f))
              ;; Flag has default value, so omit it.
              (continue))

            (when [(values bf ok) (assert BoolFlag (.-Value f))] (and ok (.IsBoolFlag bf))
              (let [(values val ok) (assert bool (.Get getter))]
                (when (and ok val)
                  (fmt/Fprintf (addr cmd) " -%s" (.-Name f))
                  (continue))))


            (when [(values cf ok) (assert CountFlag (.-Value f))] (and ok (.IsCountFlag cf))
              (let [(values val ok) (assert int (.Get getter))]
                (when (and ok (== val 1))
                  (fmt/Fprintf (addr cmd) " -%s" (.-Name f))
                  (continue))))


            (fmt/Fprintf (addr cmd) " -%s=%v" (.-Name f) (.Get getter)))))



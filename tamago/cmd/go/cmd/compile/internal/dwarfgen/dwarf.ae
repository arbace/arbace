      (let [s (.Lookup base/Ctxt (+ dwarf/CUInfoPrefix "producer." (.-Pkgpath base/Ctxt)))]
        (set! (.-Type s) objabi/SDWARFCUINFO)
        ;; Sometimes (for example when building tests) we can link
        ;; together two package main archives. So allow dups.
        ^{:go/via [Attribute]} (.Set s obj/AttrDuplicateOK true)
        (set! (.-Data base/Ctxt) (append (.-Data base/Ctxt) s))

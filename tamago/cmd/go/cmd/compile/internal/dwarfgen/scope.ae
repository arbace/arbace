^{:go/end 65} (go/func scopeVariables "scopeVariables assigns DWARF variable records to their scopes.\n" [^{:tag (slice (* dwarf/Var))} dwarfVars ^{:tag (slice ir/ScopeID)} varScopes ^{:tag (slice dwarf/Scope)} dwarfScopes ^bool regabi]

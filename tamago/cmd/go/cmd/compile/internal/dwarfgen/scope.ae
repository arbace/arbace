^{:go/end 97} (go/func compactScopes ^{:tag (slice dwarf/Scope)} [^{:tag (slice dwarf/Scope)} dwarfScopes]
  ;; Reverse pass to propagate PC ranges to parent scopes.
  (for [i (- (len dwarfScopes) 1)] (> i 0) (dec! i)
    (let [s (addr (aget dwarfScopes i))]

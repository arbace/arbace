^{:go/end 87} (go/func scopePCs "scopePCs assigns PC ranges to their scopes.\n" [^{:tag (* obj/LSym)} fnsym ^{:tag (slice ir/Mark)} marks ^{:tag (slice dwarf/Scope)} dwarfScopes]
  ;; If there aren't any child scopes (in particular, when scope
  ;; tracking is disabled), we can skip a whole lot of work.
  (when (== (len marks) 0)

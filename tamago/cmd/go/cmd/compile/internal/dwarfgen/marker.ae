(in-ns 'go.cmd.compile.internal.dwarfgen) (go/file "marker.go" :imports [


    ^{:line 8} [base "cmd/compile/internal/base"]
    ^{:line 9} [ir "cmd/compile/internal/ir"]
    ^{:line 10} [src "cmd/internal/src"]])




(go/type ScopeMarker "A ScopeMarker tracks scope nesting and boundaries for later use\nduring DWARF generation.\n" (struct
    ^{:line 16 :tag (slice ir/ScopeID)} parents
    ^{:line 17 :tag (slice ir/Mark)} marks))



^{:go/end 35} (go/method checkPos "checkPos validates the given position and returns the current scope.\n" ^ir/ScopeID [^{:tag (* ScopeMarker)} m ^src/XPos pos]
  (when (not (.IsKnown pos))
    (base/Fatalf "unknown scope position, pos=%v" pos))


  (when (== (len (.-marks m)) 0)
    (return 0))


  (let [last (addr (aget (.-marks m) (- (len (.-marks m)) 1)))]
    (when (xposBefore pos (.-Pos last))
      (base/FatalfAt pos "non-monotonic scope positions\n\t%v: previous scope position" (base/FmtPos (.-Pos last))))

    (.-Scope last)))



^{:go/end 45} (go/method Push "Push records a transition to a new child scope of the current scope.\n" [^{:tag (* ScopeMarker)} m ^src/XPos pos]
  (let [current (.checkPos m pos)]

    (set! (.-parents m) (append (.-parents m) current))
    (let [child (conv ir/ScopeID (len (.-parents m)))]

      (set! (.-marks m) (append (.-marks m) (lit ir/Mark :Pos pos :Scope child))))))



^{:go/end 54} (go/method Pop "Pop records a transition back to the current scope's parent.\n" [^{:tag (* ScopeMarker)} m ^src/XPos pos]
  (let [current (.checkPos m pos)

      ^{:line 51} parent (aget (.-parents m) (- current 1))]

    (set! (.-marks m) (append (.-marks m) (lit ir/Mark :Pos pos :Scope parent)))))



^{:go/end 67} (go/method Unpush "Unpush removes the current scope, which must be empty.\n" [^{:tag (* ScopeMarker)} m]
  (let [i (- (len (.-marks m)) 1)
      ^{:line 59} current (.-Scope (aget (.-marks m) i))]

    (when (!= current (conv ir/ScopeID (len (.-parents m))))
      (base/FatalfAt (.-Pos (aget (.-marks m) i)) "current scope is not empty"))


    (set! (.-parents m) (subslice (.-parents m) _ (- current 1)))
    (set! (.-marks m) (subslice (.-marks m) _ i))))




^{:go/end 81} (go/method WriteTo "WriteTo writes the recorded scope marks to the given function,\nand resets the marker for reuse.\n" [^{:tag (* ScopeMarker)} m ^{:tag (* ir/Func)} fn]
  (.compactMarks m)

  (set! (.-Parents fn) (make (slice ir/ScopeID) (len (.-parents m))))
  (copy (.-Parents fn) (.-parents m))
  (set! (.-parents m) (subslice (.-parents m) _ 0))

  (set! (.-Marks fn) (make (slice ir/Mark) (len (.-marks m))))
  (copy (.-Marks fn) (.-marks m))
  (set! (.-marks m) (subslice (.-marks m) _ 0)))


^{:go/end 94} (go/method compactMarks [^{:tag (* ScopeMarker)} m]
  (let [n 0]
    (range [_ next (.-marks m)]
      (when (and (> n 0) (== (.-Pos next) (.-Pos (aget (.-marks m) (- n 1)))))
        (set! (.-Scope (aget (.-marks m) (- n 1))) (.-Scope next))
        (continue))

      (aset (.-marks m) n next)
      (inc! n))

    (set! (.-marks m) (subslice (.-marks m) _ n))))

                            (base/WarnfAt pos "loop variable %v now per-iteration, stack-allocated" n))


                          (let [innerXPos (trueInlinedPos inner)]
                            (if (== ^{:go/via [miniExpr miniNode]} (.Esc n) ir/EscHeap)
                              (base/WarnfAt innerXPos "loop variable %v now per-iteration, heap-allocated (loop inlined into %s:%d)" n (.Filename outer) ^{:go/via [lico]} (.Line outer))

                              (base/WarnfAt innerXPos "loop variable %v now per-iteration, stack-allocated (loop inlined into %s:%d)" n (.Filename outer) ^{:go/via [lico]} (.Line outer)))))))))




                (range [_ l loops]
                  (let [pos (.Pos (.-loop l))
                      ^{:line 594} last (.-last l)
                      ^{:line 595} loopKind "range"]
                    (when [(values _ ok) (assert (* ir/ForStmt) (.-loop l))] ok
                      (set! loopKind "for"))

                    (when (logopt/Enabled)
                      ;; Intended to help with performance debugging, we record whole loop ranges
                      (logopt/LogOptRange pos last (+ "loop-modified-" loopKind) "loopvar" (ir/FuncName (.-curfn l))))

                    (when (and print (<= 4 (.-LoopVar base/Debug)))
                      ;; TODO decide if we want to keep this, or not.  It was helpful for validating logopt, otherwise, eh.
                      (let [inner (.InnermostPos base/Ctxt pos)
                          ^{:line 606} outer (.OutermostPos base/Ctxt pos)]

                        (if (== inner outer)
                          (base/WarnfAt pos "%s loop ending at %d:%d was modified" loopKind ^{:go/via [lico]} (.Line last) ^{:go/via [lico]} (.Col last))
                          (do
                            (set! pos (trueInlinedPos inner))
                            (set! last (trueInlinedPos (.InnermostPos base/Ctxt last)))
                            (base/WarnfAt pos "%s loop ending at %d:%d was modified (loop inlined into %s:%d)" loopKind ^{:go/via [lico]} (.Line last) ^{:go/via [lico]} (.Col last) (.Filename outer) ^{:go/via [lico]} (.Line outer))))))))))))))))

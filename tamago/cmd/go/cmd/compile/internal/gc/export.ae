(in-ns 'go.cmd.compile.internal.gc) (go/file "export.go" :imports [


    ^{:line 8} [fmt "fmt"]
    ^{:line 9} [constant "go/constant"]

    ^{:line 11} [base "cmd/compile/internal/base"]
    ^{:line 12} [ir "cmd/compile/internal/ir"]
    ^{:line 13} [typecheck "cmd/compile/internal/typecheck"]
    ^{:line 14} [types "cmd/compile/internal/types"]
    ^{:line 15} [bio "cmd/internal/bio"]])


^{:go/end 53} (go/func dumpasmhdr []
  (let [(values b err) (bio/Create (.-AsmHdr base/Flag))]
    (when (!= err nil)
      (base/Fatalf "%v" err))

    (fmt/Fprintf b "// generated by compile -asmhdr from package %s\n\n" (.-Name types/LocalPkg))
    (range [_ n (.-AsmHdrDecls typecheck/Target)]
      (when (.IsBlank (.Sym n))
        (continue))

      (switch ^{:go/via [miniExpr miniNode]} (.Op n)
        (case [ir/OLITERAL]
          (let [t (.Kind (.Val n))]
            (when (or (== t constant/Float) (== t constant/Complex))
              (break))

            (fmt/Fprintf b "#define const_%s %v\n" (.-Name (.Sym n)) (.ExactString (.Val n)))))

        (case [ir/OTYPE]
          (let [t ^{:go/via [miniExpr]} (.Type n)]
            (when (or (not (.IsStruct t)) (!= (.-Map (.StructType t)) nil) (.IsFuncArgStruct t))
              (break))

            (fmt/Fprintf b "#define %s__size %d\n" (.-Name (.Sym n)) (conv int (.Size t)))
            (range [_ f (.Fields t)]
              (when (not (.IsBlank (.-Sym f)))
                (fmt/Fprintf b "#define %s_%s %d\n" (.-Name (.Sym n)) (.-Name (.-Sym f)) (conv int (.-Offset f)))))))))





    (when [err (.Close b)] (!= err nil)
      (base/Fatalf "%v" err))))

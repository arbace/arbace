(in-ns 'go.cmd.compile.internal.gc) (go/file "util.go" :imports [


    ^{:line 8} [url "net/url"]
    ^{:line 9} [os "os"]
    ^{:line 10} [filepath "path/filepath"]
    ^{:line 11} [runtime "runtime"]
    ^{:line 12} [pprof "runtime/pprof"]
    ^:alias ^{:line 13} [tracepkg "runtime/trace"]
    ^{:line 14} [strings "strings"]

    ^{:line 16} [base "cmd/compile/internal/base"]])


^{:go/end 30} (go/func profileName ^string [^string fn ^string suffix]
  (when (strings/HasSuffix fn (conv string os/PathSeparator))
    (let [err (os/MkdirAll fn 0755)]
      (when (!= err nil)
        (base/Fatalf "%v" err))))


  (when [(values fi statErr) (os/Stat fn)] (and (== statErr nil) (.IsDir fi))
    (set! fn (filepath/Join fn (+ (url/PathEscape (.-Pkgpath base/Ctxt)) suffix))))

  ^{:line 29} fn)


^{:go/end 130} (go/func startProfile []
  (when (!= (.-CPUProfile base/Flag) "")
    (let [fn (profileName (.-CPUProfile base/Flag) ".cpuprof")
        (values f err) (os/Create fn)]
      (when (!= err nil)
        (base/Fatalf "%v" err))

      (when [err (pprof/StartCPUProfile f)] (!= err nil)
        (base/Fatalf "%v" err))

      (base/AtExit ^{:go/end 47} (fn []
          (pprof/StopCPUProfile)
          (when [(set! err (.Close f))] (!= err nil)
            (base/Fatalf "error closing cpu profile: %v" err))))))



  (if (!= (.-MemProfile base/Flag) "") (do
      (when (!= (.-MemProfileRate base/Flag) 0)
        (set! runtime/MemProfileRate (.-MemProfileRate base/Flag)))

      (let [
          ^:const ^{:line 54 :val 0} gzipFormat 0
          ^:const ^:go/grouped ^{:line 55 :val 1} textFormat 1

          ;; compilebench parses the memory profile to extract memstats,
          ;; which are only written in the legacy (text) pprof format.
          ;; See golang.org/issue/18641 and runtime/pprof/pprof.go:writeHeap.
          ;; gzipFormat is what most people want, otherwise
          ^:var ^{:line 61} format textFormat
          ^{:line 62} fn (.-MemProfile base/Flag)]
        (when (strings/HasSuffix fn (conv string os/PathSeparator))
          (let [err (os/MkdirAll fn 0755)]
            (when (!= err nil)
              (base/Fatalf "%v" err))))


        (when [(values fi statErr) (os/Stat fn)] (and (== statErr nil) (.IsDir fi))
          (set! fn (filepath/Join fn (+ (url/PathEscape (.-Pkgpath base/Ctxt)) ".memprof")))
          (set! format gzipFormat))


        (let [(values f err) (os/Create fn)]

          (when (!= err nil)
            (base/Fatalf "%v" err))

          (base/AtExit ^{:go/end 88} (fn []
              ;; Profile all outstanding allocations.
              (runtime/GC)
              (when [err (.WriteTo (pprof/Lookup "heap") f format)] (!= err nil)
                (base/Fatalf "%v" err))

              (when [(set! err (.Close f))] (!= err nil)
                (base/Fatalf "error closing memory profile: %v" err)))))))



    ;; Not doing memory profiling; disable it entirely.
    (set! runtime/MemProfileRate 0))

  (when (!= (.-BlockProfile base/Flag) "")
    (let [(values f err) (os/Create (profileName (.-BlockProfile base/Flag) ".blockprof"))]
      (when (!= err nil)
        (base/Fatalf "%v" err))

      (runtime/SetBlockProfileRate 1)
      (base/AtExit ^{:go/end 102} (fn []
          (.WriteTo (pprof/Lookup "block") f 0)
          (.Close f)))))


  (when (!= (.-MutexProfile base/Flag) "")
    (let [(values f err) (os/Create (profileName (.-MutexProfile base/Flag) ".mutexprof"))]
      (when (!= err nil)
        (base/Fatalf "%v" err))

      (runtime/SetMutexProfileFraction 1)
      (base/AtExit ^{:go/end 113} (fn []
          (.WriteTo (pprof/Lookup "mutex") f 0)
          (.Close f)))))


  (when (!= (.-TraceProfile base/Flag) "")
    (let [(values f err) (os/Create (profileName (.-TraceProfile base/Flag) ".trace"))]
      (when (!= err nil)
        (base/Fatalf "%v" err))

      (when [err (tracepkg/Start f)] (!= err nil)
        (base/Fatalf "%v" err))

      (base/AtExit ^{:go/end 128} (fn []
          (tracepkg/Stop)
          (when [(set! err (.Close f))] (!= err nil)
            (base/Fatalf "error closing trace profile: %v" err)))))))

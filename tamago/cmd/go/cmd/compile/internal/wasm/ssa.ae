        ^{:line 498} ssa/OpWasmF64Eq ssa/OpWasmF64Ne ssa/OpWasmF64Lt ssa/OpWasmF64Gt ssa/OpWasmF64Le ssa/OpWasmF64Ge
        ^{:line 499} ssa/OpWasmI8x16ExtractLaneS ssa/OpWasmI16x8ExtractLaneS ssa/OpWasmI32x4ExtractLane
        ^{:line 500} ssa/OpWasmI8x16ExtractLaneU ssa/OpWasmI16x8ExtractLaneU]
      (return true))

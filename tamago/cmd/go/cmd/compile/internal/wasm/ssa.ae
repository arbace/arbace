^{:go/end 625} (go/func loadOp ^obj/As [^{:tag (* types/Type)} t]
  (when (.IsFloat t)
    (switch (.Size t)
      (case [4]
        (return wasm/AF32Load))
      (case [8]
        (return wasm/AF64Load))
      (default
        (panic "bad load type"))))



  (switch (.Size t)
    (case [1]
      (when (.IsSigned t)
        (return wasm/AI64Load8S))

      (return wasm/AI64Load8U))
    (case [2]
      (when (.IsSigned t)
        (return wasm/AI64Load16S))

      (return wasm/AI64Load16U))
    (case [4]
      (when (.IsSigned t)
        (return wasm/AI64Load32S))

      (return wasm/AI64Load32U))
    (case [8]
      (return wasm/AI64Load))
    (case [16]
      (return wasm/AV128Load))
    (default
      (panic "bad load type"))))



^{:go/end 653} (go/func storeOp ^obj/As [^{:tag (* types/Type)} t]
  (when (.IsFloat t)
    (switch (.Size t)
      (case [4]
        (return wasm/AF32Store))
      (case [8]
        (return wasm/AF64Store))
      (default
        (panic "bad store type"))))



  (switch (.Size t)
    (case [1]
      (return wasm/AI64Store8))
    (case [2]
      (return wasm/AI64Store16))
    (case [4]
      (return wasm/AI64Store32))
    (case [8]
      (return wasm/AI64Store))
    (case [16]
      (return wasm/AV128Store))
    (default
      (panic "bad store type"))))

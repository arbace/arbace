      (.Prog s (.Asm (.-Op v))))

    (case [ssa/OpWasmF64PromoteF32]
      (getValue64 s (aget (.-Args v) 0))
      (.Prog s (.Asm (.-Op v))))

    (case [ssa/OpWasmF32ConvertI64S ssa/OpWasmF32ConvertI64U

^{:go/end 522} (go/func getValue32 [^{:tag (* ssagen/State)} s ^{:tag (* ssa/Value)} v]
  (when (.-OnWasmStack v)
    (dec! (.-OnWasmStackSkipped s))
    (ssaGenValueOnStack s v false)
    (when (not (isAlready32 v))
      (.Prog s wasm/AI32WrapI64))

    (return))


  (let [reg (.Reg v)]
    (getReg s reg)
    (when (!= reg wasm/REG_SP)
      (.Prog s wasm/AI32WrapI64))))



^{:go/end 536} (go/func getValue64 [^{:tag (* ssagen/State)} s ^{:tag (* ssa/Value)} v]
  (when (.-OnWasmStack v)
    (dec! (.-OnWasmStackSkipped s))
    (ssaGenValueOnStack s v true)
    (return))


  (let [reg (.Reg v)]
    (getReg s reg)
    (when (== reg wasm/REG_SP)
      (.Prog s wasm/AI64ExtendI32U))))



^{:go/end 547} (go/func getValue128 [^{:tag (* ssagen/State)} s ^{:tag (* ssa/Value)} v]
  (when (.-OnWasmStack v)
    (dec! (.-OnWasmStackSkipped s))
    (ssaGenValueOnStack s v true)
    (return))


  (let [reg (.Reg v)]
    (getReg s reg)))


^{:go/end 558} (go/func getValueFxx [^{:tag (* ssagen/State)} s ^{:tag (* ssa/Value)} v]
  (when (.-OnWasmStack v)
    (dec! (.-OnWasmStackSkipped s))
    (ssaGenValueOnStack s v true)
    (return))


  (let [reg (.Reg v)]
    (getReg s reg)))



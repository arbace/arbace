^{:go/end 150} (go/func getBFC "find a (lsb, width) pair for BFC\nlsb must be in [0, 31], width must be in [1, 32 - lsb]\nreturn (0xffffffff, 0) if v is not a binary like 0...01...10...0\n" [^uint32 v] :results [uint32 uint32]
  (let [(values ^uint32 m ^uint32 l) (zero uint32)]
    ;; BFC is not applicable with zero
    (when (== v 0)
      (return 0xffffffff 0))

    ;; find the lowest set bit, for example l=2 for 0x3ffffffc
    (set! l (conv uint32 (bits/TrailingZeros32 v)))
    ;; m-1 represents the highest set bit index, for example m=30 for 0x3ffffffc
    (set! m (- 32 (conv uint32 (bits/LeadingZeros32 v))))
    ;; check if v is a binary like 0...01...10...0
    (when (== (- ^uint32 (<< 1 m) ^uint32 (<< 1 l)) v)
      ;; it must be m > l for non-zero v
      (return l (- m l)))

    ;; invalid
    (return 0xffffffff 0)))



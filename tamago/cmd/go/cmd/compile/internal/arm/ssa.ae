^{:go/end 52} (go/func loadByType "loadByType returns the load instruction of the given type.\n" ^obj/As [^{:tag (* types/Type)} t]
  (if (.IsFloat t)
    (switch (.Size t)
      (case [4]
        (return arm/AMOVF))
      (case [8]
        (return arm/AMOVD)))


    (switch (.Size t)
      (case [1]
        (if (.IsSigned t)
          (return arm/AMOVB)

          (return arm/AMOVBU)))

      (case [2]
        (if (.IsSigned t)
          (return arm/AMOVH)

          (return arm/AMOVHU)))

      (case [4]
        (return arm/AMOVW))))


  (panic "bad load type"))



^{:go/end 74} (go/func storeByType "storeByType returns the store instruction of the given type.\n" ^obj/As [^{:tag (* types/Type)} t]
  (if (.IsFloat t)
    (switch (.Size t)
      (case [4]
        (return arm/AMOVF))
      (case [8]
        (return arm/AMOVD)))


    (switch (.Size t)
      (case [1]
        (return arm/AMOVB))
      (case [2]
        (return arm/AMOVH))
      (case [4]
        (return arm/AMOVW))))


  (panic "bad store type"))



(go/type shift "shift type is used as Offset in obj.TYPE_SHIFT operands to encode shifted register operands.\n" int64)


^{:go/end 89} (go/method String "copied from ../../../internal/obj/util.go:/TYPE_SHIFT\n" ^string [^shift v]
  (let [op (subslice "<<>>->@>" (<< (bit-and (>> v 5) 3) 1))]
    (if (!= (bit-and v (<< 1 4)) 0)
      ;; register shift
      (return (fmt/Sprintf "R%d%c%cR%d" (bit-and v 15) (aget op 0) (aget op 1) (bit-and (>> v 8) 15)))

      ;; constant shift
      (return (fmt/Sprintf "R%d%c%c%d" (bit-and v 15) (aget op 0) (aget op 1) (bit-and (>> v 7) 31))))))




^{:go/end 97} (go/func makeshift "makeshift encodes a register shifted by a constant.\n" ^shift [^{:tag (* ssa/Value)} v ^int16 reg ^int64 typ ^int64 s]
  (when (or (< s 0) (>= s 32))
    (.Fatalf v "shift out of range: %d" s))

  (conv shift (bit-or (conv int64 (bit-and reg 0xf)) typ (<< (bit-and s 31) 7))))



^{:go/end 110} (go/func genshift "genshift generates a Prog for r = r0 op (r1 shifted by n).\n" ^{:tag (* obj/Prog)} [^{:tag (* ssagen/State)} s ^{:tag (* ssa/Value)} v ^obj/As as ^int16 r0 ^int16 r1 ^int16 r ^int64 typ ^int64 n]
  (let [p (.Prog s as)]
    (set! (.-Type (.-From p)) obj/TYPE_SHIFT)
    (set! (.-Offset (.-From p)) (conv int64 (makeshift v r1 typ n)))
    (set! (.-Reg p) r0)
    (when (!= r 0)
      (set! (.-Type (.-To p)) obj/TYPE_REG)

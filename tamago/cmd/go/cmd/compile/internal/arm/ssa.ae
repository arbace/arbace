    (lit _ (lit _ :Jump arm/ABMI :Index 0) (lit _ :Jump arm/ABEQ :Index 0)))) ; next == b.Succs[1]



(go/var ^{:doc "To model a 'GTnoov' ('>' without overflow checking) branching.\n"} gtJumps (lit (array 2 (array 2 ssagen/IndexJump))
    (lit _ (lit _ :Jump arm/ABMI :Index 1) (lit _ :Jump arm/ABEQ :Index 1)) ; next == b.Succs[0]
    (lit _ (lit _ :Jump arm/ABEQ :Index 1) (lit _ :Jump arm/ABPL :Index 0)))) ; next == b.Succs[1]


^{:go/end 1115} (go/func ssaGenBlock [^{:tag (* ssagen/State)} s ^{:tag (* ssa/Block)} b ^{:tag (* ssa/Block)} next]
  (switch (.-Kind b)
    (case [ssa/BlockPlain ssa/BlockDefer]
      (when (!= (.Block (aget (.-Succs b) 0)) next)
        (let [p (.Prog s obj/AJMP)]
          (set! (.-Type (.-To p)) obj/TYPE_BRANCH)
          (set! (.-Branches s) (append (.-Branches s) (lit ssagen/Branch :P p :B (.Block (aget (.-Succs b) 0))))))))


    (case [ssa/BlockExit ssa/BlockRetJmp])

    (case [ssa/BlockRet]
      (.Prog s obj/ARET))

    (case [ssa/BlockARMEQ ssa/BlockARMNE
        ^{:line 1085} ssa/BlockARMLT ssa/BlockARMGE
        ^{:line 1086} ssa/BlockARMLE ssa/BlockARMGT
        ^{:line 1087} ssa/BlockARMULT ssa/BlockARMUGT
        ^{:line 1088} ssa/BlockARMULE ssa/BlockARMUGE
        ^{:line 1089} ssa/BlockARMLTnoov ssa/BlockARMGEnoov]
      (let [jmp (aget blockJump (.-Kind b))]
        (switch next
          (case [(.Block (aget (.-Succs b) 0))]
            (.Br s (.-invasm jmp) (.Block (aget (.-Succs b) 1))))
          (case [(.Block (aget (.-Succs b) 1))]
            (.Br s (.-asm jmp) (.Block (aget (.-Succs b) 0))))

(in-ns 'go.cmd.compile.internal.arm) (go/file "galign.go" :imports [


    ^{:line 8} [ssa "cmd/compile/internal/ssa"]
    ^{:line 9} [ssagen "cmd/compile/internal/ssagen"]
    ^{:line 10} [arm "cmd/internal/obj/arm"]
    ^{:line 11} [buildcfg "internal/buildcfg"]])


^{:go/end 25} (go/func Init [^{:tag (* ssagen/ArchInfo)} arch]
  (set! (.-LinkArch arch) (addr arm/Linkarm))
  (set! (.-REGSP arch) arm/REGSP)
  (set! (.-MAXWIDTH arch) (- (<< 1 32) 1))
  (set! (.-SoftFloat arch) (.-SoftFloat buildcfg/GOARM))
  (set! (.-ZeroRange arch) zerorange)
  (set! (.-Ginsnop arch) ginsnop)

  (set! (.-SSAMarkMoves arch) ^{:go/end 22} (fn [^{:tag (* ssagen/State)} s ^{:tag (* ssa/Block)} b]))
  (set! (.-SSAGenValue arch) ssaGenValue)
  (set! (.-SSAGenBlock arch) ssaGenBlock))

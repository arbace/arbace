(in-ns 'go.cmd.compile.internal.arm) (go/file "ggen.go" :imports [


    ^{:line 8} [ir "cmd/compile/internal/ir"]
    ^{:line 9} [objw "cmd/compile/internal/objw"]
    ^{:line 10} [types "cmd/compile/internal/types"]
    ^{:line 11} [obj "cmd/internal/obj"]
    ^{:line 12} [arm "cmd/internal/obj/arm"]])


^{:go/end 50} (go/func zerorange ^{:tag (* obj/Prog)} [^{:tag (* objw/Progs)} pp ^{:tag (* obj/Prog)} p ^int64 off ^int64 cnt ^{:tag (* uint32)} r0]
  (when (== cnt 0)
    (return p))

  (when (== @r0 0)
    (set! p (.Append pp p arm/AMOVW obj/TYPE_CONST 0 0 obj/TYPE_REG arm/REG_R0 0))
    (set! @r0 1))


  (cond (< cnt (conv int64 (* 4 types/PtrSize)))
    (for [i (conv int64 0)] (< i cnt) (set! i + (conv int64 types/PtrSize))
      (set! p (.Append pp p arm/AMOVW obj/TYPE_REG arm/REG_R0 0 obj/TYPE_MEM arm/REGSP (+ 4 off i))))

    (<= cnt (conv int64 (* 128 types/PtrSize))) (do
      (set! p (.Append pp p arm/AADD obj/TYPE_CONST 0 (+ 4 off) obj/TYPE_REG arm/REG_R1 0))
      (set! (.-Reg p) arm/REGSP)
      (set! p (.Append pp p obj/ADUFFZERO obj/TYPE_NONE 0 0 obj/TYPE_MEM 0 0))
      (set! (.-Name (.-To p)) obj/NAME_EXTERN)
      (set! (.-Sym (.-To p)) (.-Duffzero ir/Syms))
      (set! (.-Offset (.-To p)) (* 4 (- 128 (/ cnt (conv int64 types/PtrSize)))))) :else
    (do
      (set! p (.Append pp p arm/AADD obj/TYPE_CONST 0 (+ 4 off) obj/TYPE_REG arm/REG_R1 0))
      (set! (.-Reg p) arm/REGSP)
      (set! p (.Append pp p arm/AADD obj/TYPE_CONST 0 cnt obj/TYPE_REG arm/REG_R2 0))
      (set! (.-Reg p) arm/REG_R1)
      (set! p (.Append pp p arm/AMOVW obj/TYPE_REG arm/REG_R0 0 obj/TYPE_MEM arm/REG_R1 4))
      (let [p1 p]
        (set! (.-Scond p) bit-or arm/C_PBIT)
        (set! p (.Append pp p arm/ACMP obj/TYPE_REG arm/REG_R1 0 obj/TYPE_NONE 0 0))
        (set! (.-Reg p) arm/REG_R2)
        (set! p (.Append pp p arm/ABNE obj/TYPE_NONE 0 0 obj/TYPE_BRANCH 0 0))
        (.SetTarget (.-To p) p1))))


  ^{:line 49} p)


^{:go/end 60} (go/func ginsnop ^{:tag (* obj/Prog)} [^{:tag (* objw/Progs)} pp]
  (let [p (.Prog pp arm/AAND)]
    (set! (.-Type (.-From p)) obj/TYPE_REG)
    (set! (.-Reg (.-From p)) arm/REG_R0)
    (set! (.-Type (.-To p)) obj/TYPE_REG)
    (set! (.-Reg (.-To p)) arm/REG_R0)
    (set! (.-Scond p) arm/C_SCOND_EQ)
    ^{:line 59} p))

(ns go.cmd.compile.internal.typecheck
  (:require [arbace.go :as go]))

(go/package typecheck
  :path "cmd/compile/internal/typecheck"
  :files ["bexport.go" "builtin.go" "const.go" "dcl.go" "export.go" "expr.go" "func.go" "iexport.go" "iimport.go" "stmt.go" "subr.go" "syms.go" "target.go" "type.go" "typecheck.go" "universe.go"]
  :positions :lines)

(load "typecheck/bexport")
(load "typecheck/builtin")
(load "typecheck/const")
(load "typecheck/dcl")
(load "typecheck/export")
(load "typecheck/expr")
(load "typecheck/func")
(load "typecheck/iexport")
(load "typecheck/iimport")
(load "typecheck/stmt")
(load "typecheck/subr")
(load "typecheck/syms")
(load "typecheck/target")
(load "typecheck/type")
(load "typecheck/typecheck")
(load "typecheck/universe")

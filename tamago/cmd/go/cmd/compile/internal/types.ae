(ns go.cmd.compile.internal.types
  (:require [arbace.go :as go]))

(go/package types
  :path "cmd/compile/internal/types"
  :files ["alg.go" "algkind_string.go" "fmt.go" "goversion.go" "identity.go" "kind_string.go" "pkg.go" "size.go" "sym.go" "type.go" "universe.go" "utils.go"]
  :positions :lines)

(load "types/alg")
(load "types/algkind_string")
(load "types/fmt")
(load "types/goversion")
(load "types/identity")
(load "types/kind_string")
(load "types/pkg")
(load "types/size")
(load "types/sym")
(load "types/type")
(load "types/universe")
(load "types/utils")

(ns go.cmd.compile.internal.ir
  (:require [arbace.go :as go]))

(go/package ir
  :path "cmd/compile/internal/ir"
  :files ["abi.go" "bitset.go" "cfg.go" "check_reassign_no.go" "class_string.go" "const.go" "copy.go" "dump.go" "expr.go" "fmt.go" "func.go" "html.go" "ir.go" "mini.go" "name.go" "node.go" "node_gen.go" "op_string.go" "package.go" "reassign_consistency_check.go" "reassignment.go" "scc.go" "stmt.go" "symtab.go" "type.go" "val.go" "visit.go"]
  :positions :lines)

(load "ir/abi")
(load "ir/bitset")
(load "ir/cfg")
(load "ir/check_reassign_no")
(load "ir/class_string")
(load "ir/const")
(load "ir/copy")
(load "ir/dump")
(load "ir/expr")
(load "ir/fmt")
(load "ir/func")
(load "ir/html")
(load "ir/ir")
(load "ir/mini")
(load "ir/name")
(load "ir/node")
(load "ir/node_gen")
(load "ir/op_string")
(load "ir/package")
(load "ir/reassign_consistency_check")
(load "ir/reassignment")
(load "ir/scc")
(load "ir/stmt")
(load "ir/symtab")
(load "ir/type")
(load "ir/val")
(load "ir/visit")

(ns go.cmd.compile.internal.noder
  (:require [arbace.go :as go]))

(go/package noder
  :path "cmd/compile/internal/noder"
  :files ["codes.go" "doc.go" "dump.go" "export.go" "helpers.go" "html.go" "import.go" "irgen.go" "lex.go" "linker.go" "noder.go" "posmap.go" "quirks.go" "reader.go" "types.go" "unified.go" "writer.go"]
  :positions :lines)

(load "noder/codes")
(load "noder/doc")
(load "noder/dump")
(load "noder/export")
(load "noder/helpers")
(load "noder/html")
(load "noder/import")
(load "noder/irgen")
(load "noder/lex")
(load "noder/linker")
(load "noder/noder")
(load "noder/posmap")
(load "noder/quirks")
(load "noder/reader")
(load "noder/types")
(load "noder/unified")
(load "noder/writer")

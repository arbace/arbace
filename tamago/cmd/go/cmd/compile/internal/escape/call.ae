^{:go/end 270} (go/method goDeferStmt "goDeferStmt analyzes a \"go\" or \"defer\" statement.\n" [^{:tag (* escape)} e ^{:tag (* ir/GoDeferStmt)} n]
  (let [k ^{:go/via [batch]} (.heapHole e)]
    (when (and (== ^{:go/via [miniStmt miniNode]} (.Op n) ir/ODEFER) (== (.-loopDepth e) 1) (== (.-DeferAt n) nil))

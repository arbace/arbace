(go/type leaks "A leaks represents a set of assignment flows from a parameter to\nthe heap, mutator, callee, or to any of its function's (first\nnumEscResults) result parameters.\n" (array 8 uint8))

(go/const
  ^{:line 19} [^{:val 0} leakHeap iota]
  ^{:line 20} [^{:val 1} leakMutator]
  ^{:line 21} [^{:val 2} leakCallee]
  ^{:line 22} [^{:val 3} leakResult0])


(go/const ^{:val 5} numEscResults (- (len (lit leaks)) leakResult0))



^{:go/end 29} (go/method Heap "Heap returns the minimum deref count of any assignment flow from l\nto the heap. If no such flows exist, Heap returns -1.\n" ^int [^leaks l] (.get l leakHeap))




^{:go/end 34} (go/method Mutator "Mutator returns the minimum deref count of any assignment flow from\nl to the pointer operand of an indirect assignment statement. If no\nsuch flows exist, Mutator returns -1.\n" ^int [^leaks l] (.get l leakMutator))




^{:go/end 39} (go/method Callee "Callee returns the minimum deref count of any assignment flow from\nl to the callee operand of call expression. If no such flows exist,\nCallee returns -1.\n" ^int [^leaks l] (.get l leakCallee))




^{:go/end 44} (go/method Result "Result returns the minimum deref count of any assignment flow from\nl to its function's i'th result parameter. If no such flows exist,\nResult returns -1.\n" ^int [^leaks l ^int i] (.get l (+ leakResult0 i)))


^{:go/end 47} (go/method AddHeap "AddHeap adds an assignment flow from l to the heap.\n" [^{:tag (* leaks)} l ^int derefs] (.add l leakHeap derefs))



^{:go/end 51} (go/method AddMutator "AddMutator adds a flow from l to the mutator (i.e., a pointer\noperand of an indirect assignment statement).\n" [^{:tag (* leaks)} l ^int derefs] (.add l leakMutator derefs))



^{:go/end 55} (go/method AddCallee "AddCallee adds an assignment flow from l to the callee operand of a\ncall expression.\n" [^{:tag (* leaks)} l ^int derefs] (.add l leakCallee derefs))



^{:go/end 59} (go/method AddResult "AddResult adds an assignment flow from l to its function's i'th\nresult parameter.\n" [^{:tag (* leaks)} l ^int i ^int derefs] (.add l (+ leakResult0 i) derefs))

^{:go/end 61} (go/method get ^int [^leaks l ^int i] (- (conv int (aget l i)) 1))

^{:go/end 67} (go/method add [^{:tag (* leaks)} l ^int i ^int derefs]
  (when [old (.get l i)] (or (< old 0) (< derefs old))
    (.set l i derefs)))



^{:go/end 79} (go/method set [^{:tag (* leaks)} l ^int i ^int derefs]
  (let [v (+ derefs 1)]
    (when (< v 0)
      (base/Fatalf "invalid derefs count: %v" derefs))

    (when (> v math/MaxUint8)

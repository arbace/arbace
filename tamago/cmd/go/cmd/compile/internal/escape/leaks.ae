    (aset l i (conv uint8 v))))




^{:go/end 93} (go/method Optimize "Optimize removes result flow paths that are equal in length or\nlonger than the shortest heap flow path.\n" [^{:tag (* leaks)} l]
  ;; If we have a path to the heap, then there's no use in
  ;; keeping equal or longer paths elsewhere.
  (when [x (.Heap l)] (>= x 0)
    (for [i 1] (< i (len @l)) (inc! i)
      (when (>= (.get l i) x)
        (.set l i -1)))))





(go/var leakTagCache (lit (map leaks string)))


^{:go/end 115} (go/method Encode "Encode converts l into a binary string for export data.\n" ^string [^leaks l]
  (when (== (.Heap l) 0)
    ;; Space optimization: empty string encodes more
    ;; efficiently in export data.
    (return ""))

  (when [(values s ok) (aget leakTagCache l)] ok
    (return s))


  (let [n (len l)]
    (while (and (> n 0) (== (aget l (- n 1)) 0))
      (dec! n))

    (let [s (+ "esc:" (conv string (subslice l _ n)))]
      (aset leakTagCache l s)
      ^{:line 114} s)))



^{:go/end 126} (go/func parseLeaks "parseLeaks parses a binary string representing a leaks.\n" ^leaks [^string s]
  (let [^leaks l (zero leaks)]
    (when (not (strings/HasPrefix s "esc:"))
      (.AddHeap l 0)
      (return l))

    (copy (subslice l) (subslice s 4))
    ^{:line 125} l))


^{:go/end 130} (go/func ParseLeaks ^leaks [^string s]
  (parseLeaks s))



^{:go/breaks [[6 143]] :go/end 144} (go/method Any "Any reports whether the value flows anywhere at all.\n" ^bool [^leaks l]

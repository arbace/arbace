^{:go/end 388} (go/method finish [^{:tag (* batch)} b ^{:tag (slice (* ir/Func))} fns]
  ;; Record parameter tags for package export data.
  (range [_ fn fns]
    ^{:go/via [miniNode]} (.SetEsc fn escFuncTagged)


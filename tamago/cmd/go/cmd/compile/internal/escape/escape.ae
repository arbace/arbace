;; Escape analysis.
;;
;; Here we analyze functions to determine which Go variables
;; (including implicit allocations such as calls to "new" or "make",
;; composite literals, etc.) can be allocated on the stack. The two
;; key invariants we have to ensure are: (1) pointers to stack objects
;; cannot be stored in the heap, and (2) pointers to a stack object
;; cannot outlive that object (e.g., because the declaring function
;; returned and destroyed the object's stack frame, or its space is
;; reused across loop iterations for logically distinct variables).
;;
;; We implement this with a static data-flow analysis of the AST.
;; First, we construct a directed weighted graph where vertices
;; (termed "locations") represent variables allocated by statements
;; and expressions, and edges represent assignments between variables
;; (with weights representing addressing/dereference counts).
;;
;; Next we walk the graph looking for assignment paths that might
;; violate the invariants stated above. If a variable v's address is
;; stored in the heap or elsewhere that may outlive it, then v is
;; marked as requiring heap allocation.
;;
;; To support interprocedural analysis, we also record data-flow from
;; each function's parameters to the heap and to its result
;; parameters. This information is summarized as "parameter tags",
;; which are used at static call sites to improve escape analysis of
;; function arguments.

;; Constructing the location graph.
;;
;; Every allocating statement (e.g., variable declaration) or
;; expression (e.g., "new" or "make") is first mapped to a unique
;; "location."
;;
;; We also model every Go assignment as a directed edges between
;; locations. The number of dereference operations minus the number of
;; addressing operations is recorded as the edge's weight (termed
;; "derefs"). For example:
;;
;;     p = &q    // -1
;;     p = q     //  0
;;     p = *q    //  1
;;     p = **q   //  2
;;
;;     p = **&**&q  // 2
;;
;; Note that the & operator can only be applied to addressable
;; expressions, and the expression &x itself is not addressable, so
;; derefs cannot go below -1.
;;
;; Every Go language construct is lowered into this representation,
;; generally without sensitivity to flow, path, or context; and
;; without distinguishing elements within a compound variable. For
;; example:
;;
;;     var x struct { f, g *int }
;;     var u []*int
;;
;;     x.f = u[0]
;;
;; is modeled simply as
;;
;;     x = *u
;;
;; That is, we don't distinguish x.f from x.g, or u[0] from u[1],
;; u[2], etc. However, we do record the implicit dereference involved
;; in indexing a slice.



(go/type batch "A batch holds escape analysis state that's shared across an entire\nbatch of functions being analyzed at once.\n" (struct
    ^{:line 92 :tag (slice (* location))} allLocs
    ^{:line 93 :tag (slice closure)} closures
    ^{:line 94 :tag (map (* ir/Func) (* ir/ReassignOracle))} reassignOracles

    ^{:line 96 :tag location} heapLoc
    ^{:line 97 :tag location} mutatorLoc
    ^{:line 98 :tag location} calleeLoc
    ^{:line 99 :tag location} blankLoc))




(go/type closure "A closure holds a closure expression and its spill hole (i.e.,\nwhere the hole representing storing into its closure record).\n" (struct
    ^{:line 105 :tag hole} k
    ^{:line 106 :tag (* ir/ClosureExpr)} clo))




(go/type escape "An escape holds state specific to a single function being analyzed\nwithin a batch.\n" (struct
    (* batch)

    ^{:line 114 :tag (* ir/Func)} curfn ; function being analyzed

    ^{:line 116 :tag (map (* types/Sym) labelState)} labels ; known labels





    ^{:line 122 :tag int :doc "loopDepth counts the current loop nesting depth within\ncurfn. It increments within each \"for\" loop and at each\nlabel with a corresponding backwards \"goto\" (i.e.,\nunstructured loop).\n"} loopDepth))


^{:go/end 134} (go/func Funcs [^{:tag (slice (* ir/Func))} all]
  ;; Make a cache of ir.ReassignOracles. The cache is lazily populated.
  ;; TODO(thepudds): consider adding a field on ir.Func instead. We might also be able
  ;; to use that field elsewhere, like in walk. See discussion in https://go.dev/cl/688075.
  (let [reassignOracles (make (map (* ir/Func) (* ir/ReassignOracle)))]

    (ir/VisitFuncsBottomUp all ^{:go/end 133} (fn [^{:tag (slice (* ir/Func))} list ^bool recursive]
        (Batch list reassignOracles)))))





^{:go/end 181} (go/func Batch "Batch performs escape analysis on a minimal batch of\nfunctions.\n" [^{:tag (slice (* ir/Func))} fns ^{:tag (map (* ir/Func) (* ir/ReassignOracle))} reassignOracles]
  (let [^batch b (zero batch)]
    (set! (.-attrs (.-heapLoc b)) (bit-or attrEscapes attrPersists attrMutates attrCalls))
    (set! (.-attrs (.-mutatorLoc b)) attrMutates)
    (set! (.-attrs (.-calleeLoc b)) attrCalls)
    (set! (.-reassignOracles b) reassignOracles)

    ;; Construct data-flow graph from syntax trees.
    (range [_ fn fns]
      (when (> (.-W base/Flag) 1)
        (let [s (fmt/Sprintf "\nbefore escape %v" fn)]
          (ir/Dump s fn)))

      (.initFunc b fn))

    (range [_ fn fns]
      (when (not (.IsClosure fn))
        (.walkFunc b fn)))



    ;; We've walked the function bodies, so we've seen everywhere a
    ;; variable might be reassigned or have its address taken. Now we
    ;; can decide whether closures should capture their free variables
    ;; by value or reference.
    (range [_ closure (.-closures b)]
      (.flowClosure b (.-k closure) (.-clo closure)))

    (set! (.-closures b) nil)

    (range [_ loc (.-allLocs b)]
      ;; Try to replace some non-constant expressions with literals.
      (.rewriteWithLiterals b (.-n loc) (.-curfn loc))

      ;; Check if the node must be heap allocated for certain reasons
      ;; such as OMAKESLICE for a large slice.
      (when [why (HeapAllocReason (.-n loc))] (!= why "")
        (.flow b (.addr (.heapHole b) (.-n loc) why) loc)))



    (.walkAll b)
    (.finish b fns)))



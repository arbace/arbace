                (fmt/Fprintf os/Stderr "=-= add indirectUE(%s) count=%d on %s\n" (.-Name (.Sym (.-n nc))) (.-count nc) (.LongString v)))

              (aset blockIndirectUE (.-ID v) (append (aget blockIndirectUE (.-ID v)) (.-n nc)))
              (dec! (.-count nc))

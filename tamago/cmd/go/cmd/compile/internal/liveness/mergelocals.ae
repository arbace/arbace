^{:go/end 360} (go/method collectMergeCandidates "collectMergeCandidates visits all of the AUTO vars declared in\nfunction fn and identifies a list of candidate variables for\nmerging / overlapping. On return the \"cands\" field of cs will be\nfilled in with our set of potentially overlappable candidate\nvariables, the \"regions\" field will hold regions/sequence of\ncompatible vars within the candidates list, \"nameToSlot\" field will\nbe populated, and the \"indirectUE\" field will be filled in with\ninformation about indirect upwards-exposed uses in the func.\n" [^{:tag (* cstate)} cs]
  (let [^{:tag (slice (* ir/Name))} cands (zero (slice (* ir/Name)))]

    ;; Collect up the available set of appropriate AUTOs in the
    ;; function as a first step, and bail if we have fewer than
    ;; two candidates.
    (range [_ n (.-Dcl (.-fn cs))]
      (when (not (.Used n))
        (continue))

      (when (not (ssa/IsMergeCandidate n))
        (continue))

      (set! cands (append cands n)))

    (when (< (len cands) 2)
      (return))


    ;; Sort by pointerness, size, and then name.
    (sort/SliceStable cands ^{:go/end 318} (fn ^bool [^int i ^int j]
        (nameLess (aget cands i) (aget cands j))))


    (when (> (.-trace cs) 1)
      (fmt/Fprintf os/Stderr "=-= raw cand list for func %v:\n" (.-fn cs))
      (range [i cands]
        (dumpCand (aget cands i) i)))



    ;; Now generate an initial pruned candidate list and regions list.
    ;; This may be empty if we don't have enough compatible candidates.
    (let [(values initial _) (.genRegions cs cands)]
      (when (< (len initial) 2)
        (return))


      ;; Set up for hash bisection if enabled.
      (.setupHashBisection cs initial)

      ;; Create and populate an indirect use table that we'll use
      ;; during interval construction. As part of this process we may
      ;; wind up tossing out additional candidates, so check to make
      ;; sure we still have something to work with.
      (set! (values (.-cands cs) (.-regions cs)) (.populateIndirectUseTable cs initial))
      (when (< (len (.-cands cs)) 2)
        (return))


      ;; At this point we have a final pruned set of candidates and a
      ;; corresponding set of regions for the candidates. Build a
      ;; name-to-slot map for the candidates.
      (set! (.-nameToSlot cs) (make (map (* ir/Name) int32)))
      (range [i n (.-cands cs)]
        (aset (.-nameToSlot cs) n (conv int32 i)))


      (when (> (.-trace cs) 1)
        (fmt/Fprintf os/Stderr "=-= pruned candidate list for fn %v:\n" (.-fn cs))
        (range [i (.-cands cs)]
          (dumpCand (aget (.-cands cs) i) i))))))






^{:go/end 393} (go/method genRegions "genRegions generates a set of regions within cands corresponding\nto potentially overlappable/mergeable variables.\n" [^{:tag (* cstate)} cs ^{:tag (slice (* ir/Name))} cands] :results [(slice (* ir/Name)) (slice candRegion)]

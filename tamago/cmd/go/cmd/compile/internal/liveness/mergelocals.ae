    (^{:inst [(slice (* ir/Name)) (* ir/Name)]} slices/SortStableFunc tmp ^{:go/end 166} (fn ^int [^{:tag (* ir/Name)} a ^{:tag (* ir/Name)} b]
        (strings/Compare (.-Name (.Sym a)) (.-Name (.Sym b)))))

    ^{:line 167} tmp))




^{:go/end 186} (go/method EstSavings "EstSavings returns the estimated reduction in stack size (number of bytes) for\nthe given merge locals state via a pair of ints, the first for non-pointer types and the second for pointer types.\n" [^{:tag (* MergeLocalsState)} mls] :results [int int]
  (let [totnp 0
      ^{:line 174} totp 0]
    (range [n (.-partition mls)]
      (when (.Subsumed mls n)
        (let [sz (conv int (.Size ^{:go/via [miniExpr]} (.Type n)))]
          (if (.HasPointers ^{:go/via [miniExpr]} (.Type n))
            (set! totp + sz)

            (set! totnp + sz)))))



    (return totnp totp)))




^{:go/end 263} (go/method check "check tests for various inconsistencies and problems in mls,\nreturning an error if any problems are found.\n" ^error [^{:tag (* MergeLocalsState)} mls]

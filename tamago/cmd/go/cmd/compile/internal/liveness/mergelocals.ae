      (let [en (nextRegion cands st)]
        (when (== en -1)
          (break))

        (when (== st en)
          ;; region has just one element, we can skip it
          (inc! st)
          (continue))

        (let [pst (len pruned)
            ^{:line 379} pen (+ pst (- en st))]
          (when (> (.-trace cs) 1)
            (fmt/Fprintf os/Stderr "=-= addregion st=%d en=%d: add part %d -> %d\n" st en pst pen))


          ;; non-empty region, add to pruned
          (set! pruned (append pruned (spread (subslice cands st (+ en 1)))))
          (set! regions (append regions (lit candRegion :st pst :en pen)))
          (set! st (+ en 1)))))

    (when (< (len pruned) 2)
      (return nil nil))

    (return pruned regions)))



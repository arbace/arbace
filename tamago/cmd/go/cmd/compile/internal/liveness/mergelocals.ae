(go/type MergeLocalsState "MergeLocalsState encapsulates information about which AUTO\n(stack-allocated) variables within a function can be safely\nmerged/overlapped, e.g. share a stack slot with some other auto).\nAn instance of MergeLocalsState is produced by MergeLocals() below\nand then consumed in ssagen.AllocFrame. The map 'partition'\ncontains entries of the form <N,SL> where N is an *ir.Name and SL\nis a slice holding the indices (within 'vars') of other variables\nthat share the same slot, specifically the slot of the first\nelement in the partition, which we'll call the \"leader\". For\nexample, if a function contains five variables where v1/v2/v3 are\nsafe to overlap and v4/v5 are safe to overlap, the MergeLocalsState\ncontent might look like\n\n\tvars: [v1, v2, v3, v4, v5]\n\tpartition: v1 -> [1, 0, 2], v2 -> [1, 0, 2], v3 -> [1, 0, 2]\n\t           v4 -> [3, 4], v5 -> [3, 4]\n\nA nil MergeLocalsState indicates that no local variables meet the\nnecessary criteria for overlap.\n" (struct

    ^{:line 42 :tag (slice (* ir/Name)) :doc "contains auto vars that participate in overlapping\n"} vars

    ^{:line 44 :tag (map (* ir/Name) (slice int)) :doc "maps auto variable to overlap partition\n"} partition))




(go/type candRegion "candRegion is a sub-range (start, end) corresponding to an interval\n[st,en] within the list of candidate variables.\n" (struct
    ^{:line 50 :tag int} st ^int en))





(go/type cstate "cstate holds state information we'll need during the analysis\nphase of stack slot merging but can be discarded when the analysis\nis done.\n" (struct
    ^{:line 57 :tag (* ir/Func)} fn
    ^{:line 58 :tag (* ssa/Func)} f
    ^{:line 59 :tag (* Liveness)} lv
    ^{:line 60 :tag (slice (* ir/Name))} cands
    ^{:line 61 :tag (map (* ir/Name) int32)} nameToSlot
    ^{:line 62 :tag (slice candRegion)} regions
    ^{:line 63 :tag (map ssa/ID (slice (* ir/Name)))} indirectUE
    ^{:line 64 :tag (slice Intervals)} ivs
    ^{:line 65 :tag (map (* ir/Name) bool)} hashDeselected
    ^{:line 66 :tag int} trace)) ; debug trace level





^{:go/end 120} (go/func MergeLocals "MergeLocals analyzes the specified ssa function f to determine which\nof its auto variables can safely share the same stack slot, returning\na state object that describes how the overlap should be done.\n" ^{:tag (* MergeLocalsState)} [^{:tag (* ir/Func)} fn ^{:tag (* ssa/Func)} f]

  ;; Create a container object for useful state info and then
  ;; call collectMergeCandidates to see if there are vars suitable
  ;; for stack slot merging.
  (let [cs (addr ^{:go/breaks [2 4 6]} (lit cstate
          :fn fn
          :f f
          :trace (.-MergeLocalsTrace base/Debug)))]

    (.collectMergeCandidates cs)
    (when (== (len (.-regions cs)) 0)
      (return nil))


    ;; Kick off liveness analysis.
    ;;
    ;; If we have a local variable such as "r2" below that's written
    ;; but then not read, something like:
    ;;
    ;;      vardef r1
    ;;      r1.x = ...
    ;;      vardef r2
    ;;      r2.x = 0
    ;;      r2.y = ...
    ;;      <call foo>
    ;;      // no subsequent use of r2
    ;;      ... = r1.x
    ;;
    ;; then for the purpose of calculating stack maps at the call, we
    ;; can ignore "r2" completely during liveness analysis for stack
    ;; maps, however for stack slock merging we most definitely want
    ;; to treat the writes as "uses".
    (set! (.-lv cs) (newliveness fn f (.-cands cs) (.-nameToSlot cs) 0))
    (set! (.-conservativeWrites (.-lv cs)) true)
    (.prologue (.-lv cs))
    (.solve (.-lv cs))

    ;; Compute intervals for each candidate based on the liveness and
    ;; on block effects.
    (.computeIntervals cs)

    ;; Perform merging within each region of the candidates list.
    (let [rv (.performMerging cs)]
      (when [err (.check rv)] (!= err nil)
        (base/FatalfAt ^{:go/via [miniNode]} (.Pos fn) "invalid mergelocals state: %v" err))

      ^{:line 119} rv)))




^{:go/breaks [[5 128]] :go/end 129} (go/method Subsumed "Subsumed returns whether variable n is subsumed, e.g. appears\nin an overlap position but is not the leader in that partition.\n" ^bool [^{:tag (* MergeLocalsState)} mls ^{:tag (* ir/Name)} n]
  (when [(values sl ok) (aget (.-partition mls) n)] (and ok (!= (aget (.-vars mls) (aget sl 0)) n))
    (return true))

  false)




^{:go/breaks [[5 137]] :go/end 138} (go/method IsLeader "IsLeader returns whether a variable n is the leader (first element)\nin a sharing partition.\n" ^bool [^{:tag (* MergeLocalsState)} mls ^{:tag (* ir/Name)} n]
  (when [(values sl ok) (aget (.-partition mls) n)] (and ok (== (aget (.-vars mls) (aget sl 0)) n))
    (return true))

  false)



^{:go/end 149} (go/method Leader "Leader returns the leader variable for subsumed var n.\n" ^{:tag (* ir/Name)} [^{:tag (* MergeLocalsState)} mls ^{:tag (* ir/Name)} n]

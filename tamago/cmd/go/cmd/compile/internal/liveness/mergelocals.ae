      ;; this map holds the current set of candidates; the set may
      ;; shrink if we have to evict any candidates.
      ^{:line 477} rawcands (make (map (* ir/Name) (struct)))

      ;; maps ssa value V to the ir.Name it is taking the addr of,
      ;; plus a count of the uses we've seen of V during a block walk.
      ^{:line 481} pendingUses (make (map ssa/ID nameCount))

      ;; A temporary indirect UE tab just for the current block
      ;; being processed; used to help with evictions.
      ^{:line 485} blockIndirectUE (make (map ssa/ID (slice (* ir/Name))))

      ;; temporary map used to record evictions in a given block.
      ^{:line 488} evicted (make (map (* ir/Name) bool))]
    (range [_ n cands]
      (aset rawcands n (lit (struct))))

    (for [k 0] (< k (len (.-Blocks (.-f cs)))) (inc! k)
      (clear pendingUses)
      (clear blockIndirectUE)
      (let [b (aget (.-Blocks (.-f cs)) k)]
        (range [_ v (.-Values b)]
          (when [(values n e) (affectedVar v)] (!= n nil)
            (when [(values _ ok) (aget rawcands n)] ok
              (when (and (!= (bit-and e ssa/SymAddr) 0) (!= (.-Uses v) 0))
                ;; we're taking the address of candidate var n
                (when [(values _ ok) (aget pendingUses (.-ID v))] ok
                  ;; should never happen
                  (base/FatalfAt (.-Pos v) "internal error: apparent multiple defs for SSA value %d" (.-ID v)))

                ;; Stash an entry in pendingUses recording
                ;; that we took the address of "n" via this
                ;; val.
                (aset pendingUses (.-ID v) (lit nameCount :n n :count (.-Uses v)))

^{:go/end 1126} (go/method showlive [^{:tag (* Liveness)} lv ^{:tag (* ssa/Value)} v ^bitvec/BitVec live]
  (when (or (== (.-Live base/Flag) 0) (== (ir/FuncName (.-fn lv)) "init") (strings/HasPrefix (ir/FuncName (.-fn lv)) "."))
    (return))

  (when (or (.Wrapper (.-fn lv)) (.Dupok (.-fn lv)))
    ;; Skip reporting liveness information for compiler-generated wrappers.
    (return))

  (when (not (or (== v nil) (.IsCall (.-Op v))))

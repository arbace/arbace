      ;; effects with the each prog effects.
      (for [j (- (len (.-Values b)) 1)] (>= j 0) (dec! j)
        (let [(values pos e) (.valueEffects lv (aget (.-Values b) j))]
          (when (!= (bit-and e varkill) 0)

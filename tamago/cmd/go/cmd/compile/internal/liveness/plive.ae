    (return printed))

  (if (not printed)
    (fmt/Printf "\t")

    (fmt/Printf " "))

  (fmt/Printf "%s=" name)
  (when x
    (fmt/Printf "%s" (.-Name (.Sym (aget (.-vars lv) pos)))))


  true)





^{:go/end 1324} (go/method printDebug "Prints the computed liveness information and inputs, for debugging.\nThis format synthesizes the information used during the multiple passes\ninto a single presentation.\n" [^{:tag (* Liveness)} lv]

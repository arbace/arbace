          ;; if it is used by this block, or live on output from this block and
          ;; not set by the code in this block.
          ;;
          ;; in[b] = uevar[b] \cup (out[b] \setminus varkill[b])
          (.AndNot newlivein (.-liveout be) (.-varkill be))
          (.Or (.-livein be) newlivein (.-uevar be)))))))






^{:go/end 900} (go/method epilogue "Visits all instructions in a basic block and computes a bit vector of live\nvariables at each safe point locations.\n" [^{:tag (* Liveness)} lv]

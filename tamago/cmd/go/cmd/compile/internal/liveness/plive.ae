      (when (== b (.-Entry (.-f lv)))
        (let [live (aget (.-stackMaps lv) 0)]
          (fmt/Printf "(%s) function entry\n" (base/FmtPos ^{:go/via [miniExpr miniNode]} (.Pos (.-Nname (.-fn lv)))))

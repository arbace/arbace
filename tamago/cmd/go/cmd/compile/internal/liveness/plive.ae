        (continue))

      (fmt/Printf "%s%s" comma (.-Name (.Sym n)))
      (set! comma ","))

    true))



^{:go/breaks [[8 1212]] :go/end 1213} (go/method printeffect "printeffect is like printbvec, but for valueEffects.\n" ^bool [^{:tag (* Liveness)} lv ^bool printed ^string name ^int32 pos ^bool x]

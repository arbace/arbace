            (values pos effect) (.valueEffects lv v)]
          (set! printed false)
          (set! printed (.printeffect lv printed "uevar" pos (!= (bit-and effect uevar) 0)))
          (set! printed (.printeffect lv printed "varkill" pos (!= (bit-and effect varkill) 0)))
          (when printed
            (fmt/Printf "\n"))


          (when (.StackMapValid pcdata)
            (fmt/Printf "\tlive=")
            (set! printed false)
            (when (.StackMapValid pcdata)

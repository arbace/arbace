      ^{:line 693} newlivein (bitvec/New nvars)
      ^{:line 694} newliveout (bitvec/New nvars)

      ;; Walk blocks in postorder ordering. This improves convergence.
      ^{:line 697} po (.Postorder (.-f lv))]

    ;; Iterate through the blocks in reverse round-robin fashion. A work
    ;; queue might be slightly faster. As is, the number of iterations is
    ;; so low that it hardly seems to be worth the complexity.

    (for [change true] change _
      (set! change false)
      (range [_ b po]
        (let [be (.blockEffects lv b)]

          (.Clear newliveout)
          (switch (.-Kind b)
            (case [ssa/BlockRet]
              (range [_ pos (.-retuevar (.-cache lv))]
                (.Set newliveout pos)))

            (case [ssa/BlockRetJmp]
              (range [_ pos (.-tailuevar (.-cache lv))]
                (.Set newliveout pos)))

            (case [ssa/BlockExit])
            ;; panic exit - nothing to do
            (default
              ;; A variable is live on output from this block
              ;; if it is live on input to some successor.
              ;;
              ;; out[b] = \bigcup_{s \in succ[b]} in[s]
              (.Copy newliveout (.-livein (.blockEffects lv (.Block (aget (.-Succs b) 0)))))
              (range [_ succ (subslice (.-Succs b) 1)]
                (.Or newliveout newliveout (.-livein (.blockEffects lv (.Block succ)))))))




    (return))

  (switch (.Kind t)
    (case [types/TPTR
        ^{:line 1064} types/TUNSAFEPTR
        ^{:line 1065} types/TFUNC
        ^{:line 1066} types/TCHAN
        ^{:line 1067} types/TMAP]
      (clobberPtr b v offset))

    (case [types/TSTRING]
      ;; struct { byte *str; int len; }
      (clobberPtr b v offset))

    (case [types/TINTER]
      ;; struct { Itab *tab; void *data; }
      ;; or, when isnilinter(t)==true:
      ;; struct { Type *type; void *data; }
      (clobberPtr b v offset)
      (clobberPtr b v (+ offset (conv int64 types/PtrSize))))

    (case [types/TSLICE]
      ;; struct { byte *array; int len; int cap; }
      (clobberPtr b v offset))

    (case [types/TARRAY]
      (for [i (conv int64 0)] (< i (.NumElem t)) (inc! i)

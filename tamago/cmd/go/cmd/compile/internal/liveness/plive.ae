^{:go/end 1098} (go/func clobberWalk "b = block to which we append instructions\nv = variable\noffset = offset of (sub-portion of) variable to clobber (in bytes)\nt = type of sub-portion of v.\n" [^{:tag (* ssa/Block)} b ^{:tag (* ir/Name)} v ^int64 offset ^{:tag (* types/Type)} t]

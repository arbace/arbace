      (return s)))

  "")


^{:go/end 1172} (go/method format [^{:tag (* Liveness)} lv ^{:tag (* ssa/Value)} v ^bitvec/BitVec live] :results [src/XPos string]
  (let [pos ^{:go/via [miniExpr miniNode]} (.Pos (.-Nname (.-fn lv)))]
    (when (!= v nil)
      (set! pos (.-Pos v)))


    (let [s "live at "]
      (if (== v nil)
        (set! s + (fmt/Sprintf "entry to %s:" (ir/FuncName (.-fn lv))))
        (if [(values sym ok) (assert (* ssa/AuxCall) (.-Aux v))] (and ok (!= (.-Fn sym) nil))
          (let [fn (.-Name (.-Fn sym))]
            (when [pos (strings/Index fn ".")] (>= pos 0)
              (set! fn (subslice fn (+ pos 1))))

            (set! s + (fmt/Sprintf "call to %s:" fn)))

          (set! s + "indirect call:")))


      ;; Sort variable names for display. Variables aren't in any particular order, and
      ;; the order can change by architecture, particularly with differences in regabi.
      (let [^{:tag (slice string)} names (zero (slice string))]
        (range [j n (.-vars lv)]
          (when (.Get live (conv int32 j))
            (set! names (append names (.-Name (.Sym n))))))


        (sort/Strings names)
        (range [_ v names]
          (set! s + (+ " " v)))

        (return pos s)))))


^{:go/end 1195} (go/method printbvec ^bool [^{:tag (* Liveness)} lv ^bool printed ^string name ^bitvec/BitVec live]
  (when (.IsEmpty live)
    (return printed))


  (if (not printed)
    (fmt/Printf "\t")

    (fmt/Printf " "))

  (fmt/Printf "%s=" name)


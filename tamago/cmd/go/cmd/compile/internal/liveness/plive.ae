    (default
      (base/Fatalf "clobberWalk: unexpected type, %v" t))))





^{:go/end 1104} (go/func clobberPtr "clobberPtr generates a clobber of the pointer at offset offset in v.\nThe clobber instruction is added at the end of b.\n" [^{:tag (* ssa/Block)} b ^{:tag (* ir/Name)} v ^int64 offset]

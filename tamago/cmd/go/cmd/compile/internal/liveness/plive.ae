  (range [i b (.-Blocks (.-f lv))]
    (when (> i 0)
      (fmt/Printf "\n"))


    ;; bb#0 pred=1,2 succ=3,4
    (fmt/Printf "bb#%d pred=" (.-ID b))
    (range [j pred (.-Preds b)]
      (when (> j 0)
        (fmt/Printf ","))

      (fmt/Printf "%d" (.-ID (.Block pred))))

    (fmt/Printf " succ=")
    (range [j succ (.-Succs b)]
      (when (> j 0)
        (fmt/Printf ","))

      (fmt/Printf "%d" (.-ID (.Block succ))))

    (fmt/Printf "\n")


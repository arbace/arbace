^{:go/end 941} (go/method compact "Compact coalesces identical bitmaps from lv.livevars into the sets\nlv.stackMapSet.\n\nCompact clears lv.livevars.\n\nThere are actually two lists of bitmaps, one list for the local variables and one\nlist for the function arguments. Both lists are indexed by the same PCDATA\nindex, so the corresponding pairs must be considered together when\nmerging duplicates. The argument bitmaps change much less often during\nfunction execution than the local variable bitmaps, so it is possible that\nwe could introduce a separate PCDATA index for arguments vs locals and\nthen compact the set of argument bitmaps separately from the set of\nlocal variable bitmaps. As of 2014-04-02, doing this to the godoc binary\nis actually a net loss: we save about 50k of argument bitmaps but the new\nPCDATA tables cost about 100k. So for now we keep using a single index for\nboth bitmap lists.\n" [^{:tag (* Liveness)} lv ^{:tag (* ssa/Block)} b]
  (let [pos 0]
    (when (== b (.-Entry (.-f lv)))
      ;; Handle entry stack map.
      (.add (.-stackMapSet lv) (aget (.-livevars lv) 0))
      (inc! pos))

    (range [_ v (.-Values b)]
      (when (.hasStackMap lv v)
        (let [(values idx _) (.add (.-stackMapSet lv) (aget (.-livevars lv) pos))]
          (inc! pos)
          (.set (.-livenessMap lv) v (conv objw/StackMapIndex idx))))

      (when (or (.-allUnsafe lv) (and (!= (.-Op v) ssa/OpClobber) (.Get (.-unsafePoints lv) (conv int32 (.-ID v)))))
        (.setUnsafeVal (.-livenessMap lv) v)))


    (when (or (.-allUnsafe lv) (.Get (.-unsafeBlocks lv) (conv int32 (.-ID b))))
      (.setUnsafeBlock (.-livenessMap lv) b))



^{:go/end 98} (go/func hashbitmap ^uint32 [^uint32 h ^bitvec/BitVec bv]
  (let [n (conv int (/ (+ (.-N bv) 31) 32))]
    (for [i 0] (< i n) (inc! i)
      (let [w (aget (.-B bv) i)]
        (set! h (bit-xor (* h hp) (bit-and w 0xff)))
        (set! h (bit-xor (* h hp) (bit-and (>> w 8) 0xff)))
        (set! h (bit-xor (* h hp) (bit-and (>> w 16) 0xff)))
        (set! h (bit-xor (* h hp) (bit-and (>> w 24) 0xff)))))



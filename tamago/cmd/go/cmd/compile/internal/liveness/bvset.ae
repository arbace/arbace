^{:go/end 48} (go/method grow [^{:tag (* bvecSet)} m]
  ;; Allocate new index.
  (let [n (* (len (.-index m)) 2)]
    (when (== n 0)
      (set! n 32))

    (let [newIndex (make (slice int) n)]
      (range [i newIndex]
        (aset newIndex i -1))


      ;; Rehash into newIndex.
      (range [i bv (.-uniq m)]
        (let [h (% (hashbitmap h0 bv) (conv uint32 (len newIndex)))]
          (while true
            (let [j (aget newIndex h)]
              (when (< j 0)
                (aset newIndex h i)
                (break))

              (inc! h)
              (when (== h (conv uint32 (len newIndex)))
                (set! h 0))))))



      (set! (.-index m) newIndex))))





^{:go/end 79} (go/method add "add adds bv to the set and returns its index in m.extractUnique,\nand whether it is newly added.\nIf it is newly added, the caller must not modify bv after this.\n" [^{:tag (* bvecSet)} m ^bitvec/BitVec bv] :results [int bool]
  (when (>= (* (len (.-uniq m)) 4) (len (.-index m)))
    (.grow m))


  (let [index (.-index m)
      ^{:line 59} h (% (hashbitmap h0 bv) (conv uint32 (len index)))]
    (while true
      (let [j (aget index h)]
        (when (< j 0)
          ;; New bvec.
          (aset index h (len (.-uniq m)))
          (set! (.-uniq m) (append (.-uniq m) bv))
          (return (- (len (.-uniq m)) 1) true))

        (let [jlive (aget (.-uniq m) j)]
          (when (.Eq bv jlive)

^{:go/end 1349} (go/func ssaGenBlock [^{:tag (* ssagen/State)} s ^{:tag (* ssa/Block)} b ^{:tag (* ssa/Block)} next]
  (switch (.-Kind b)
    (case [ssa/BlockPlain ssa/BlockDefer]
      (when (!= (.Block (aget (.-Succs b) 0)) next)
        (let [p (.Prog s obj/AJMP)]
          (set! (.-Type (.-To p)) obj/TYPE_BRANCH)
          (set! (.-Branches s) (append (.-Branches s) (lit ssagen/Branch :P p :B (.Block (aget (.-Succs b) 0))))))))

    (case [ssa/BlockExit ssa/BlockRetJmp])
    (case [ssa/BlockRet]
      (.Prog s obj/ARET))
    (case [ssa/BlockLOONG64EQZ ssa/BlockLOONG64NEZ
        ^{:line 1285} ssa/BlockLOONG64LTZ ssa/BlockLOONG64GEZ
        ^{:line 1286} ssa/BlockLOONG64LEZ ssa/BlockLOONG64GTZ
        ^{:line 1287} ssa/BlockLOONG64BEQ ssa/BlockLOONG64BNE
        ^{:line 1288} ssa/BlockLOONG64BLT ssa/BlockLOONG64BGE
        ^{:line 1289} ssa/BlockLOONG64BLTU ssa/BlockLOONG64BGEU
        ^{:line 1290} ssa/BlockLOONG64FPT ssa/BlockLOONG64FPF]
      (let [jmp (aget blockJump (.-Kind b))
          ^{:line 1292 :tag (* obj/Prog)} p (zero (* obj/Prog))]
        (switch next
          (case [(.Block (aget (.-Succs b) 0))]
            (set! p (.Br s (.-invasm jmp) (.Block (aget (.-Succs b) 1)))))
          (case [(.Block (aget (.-Succs b) 1))]
            (set! p (.Br s (.-asm jmp) (.Block (aget (.-Succs b) 0)))))
          (default
            (if (!= (.-Likely b) ssa/BranchUnlikely) (do
                (set! p (.Br s (.-asm jmp) (.Block (aget (.-Succs b) 0))))
                (.Br s obj/AJMP (.Block (aget (.-Succs b) 1))))
              (do
                (set! p (.Br s (.-invasm jmp) (.Block (aget (.-Succs b) 1))))
                (.Br s obj/AJMP (.Block (aget (.-Succs b) 0)))))))


        (switch (.-Kind b)
          (case [ssa/BlockLOONG64BEQ ssa/BlockLOONG64BNE
              ^{:line 1309} ssa/BlockLOONG64BGE ssa/BlockLOONG64BLT
              ^{:line 1310} ssa/BlockLOONG64BGEU ssa/BlockLOONG64BLTU]
            (set! (.-Type (.-From p)) obj/TYPE_REG)

^{:go/end 25} (go/func isFPreg "isFPreg reports whether r is an FP register.\n" ^bool [^int16 r]
  (and (<= loong64/REG_F0 r) (<= r loong64/REG_F31)))



^{:go/end 60} (go/func loadByType "loadByType returns the load instruction of the given type.\n" ^obj/As [^{:tag (* types/Type)} t ^int16 r]
  (if (isFPreg r)
    (if (== (.Size t) 4)
      (return loong64/AMOVF)

      (return loong64/AMOVD))


    (switch (.Size t)
      (case [1]
        (if (.IsSigned t)
          (return loong64/AMOVB)

          (return loong64/AMOVBU)))

      (case [2]
        (if (.IsSigned t)
          (return loong64/AMOVH)

          (return loong64/AMOVHU)))

      (case [4]
        (if (.IsSigned t)
          (return loong64/AMOVW)

          (return loong64/AMOVWU)))

      (case [8]
        (return loong64/AMOVV))))


  (panic "bad load type"))



^{:go/end 83} (go/func storeByType "storeByType returns the store instruction of the given type.\n" ^obj/As [^{:tag (* types/Type)} t ^int16 r]
  (if (isFPreg r)
    (if (== (.Size t) 4)
      (return loong64/AMOVF)

      (return loong64/AMOVD))


    (switch (.Size t)
      (case [1]
        (return loong64/AMOVB))
      (case [2]
        (return loong64/AMOVH))
      (case [4]
        (return loong64/AMOVW))
      (case [8]
        (return loong64/AMOVV))))


  (panic "bad store type"))











^{:go/end 105} (go/func largestMove "largestMove returns the largest move instruction possible and its size,\ngiven the alignment of the total size of the move.\n\ne.g., a 16-byte move may use MOVV, but an 11-byte move must use MOVB.\n\nNote that the moves may not be on naturally aligned addresses depending on\nthe source and destination.\n\nThis matches the calculation in ssa.moveSize.\n" [^int64 alignment] :results [obj/As int64]
  (switch
    (case [(== (% alignment 8) 0)]
      (return loong64/AMOVV 8))
    (case [(== (% alignment 4) 0)]
      (return loong64/AMOVW 4))
    (case [(== (% alignment 2) 0)]
      (return loong64/AMOVH 2))
    (default
      (return loong64/AMOVB 1))))




(in-ns 'go.cmd.compile.internal.loong64) (go/file "galign.go" :imports [


    ^{:line 8} [ssa "cmd/compile/internal/ssa"]
    ^{:line 9} [ssagen "cmd/compile/internal/ssagen"]
    ^{:line 10} [loong64 "cmd/internal/obj/loong64"]])


^{:go/end 25} (go/func Init [^{:tag (* ssagen/ArchInfo)} arch]
  (set! (.-LinkArch arch) (addr loong64/Linkloong64))
  (set! (.-REGSP arch) loong64/REGSP)
  (set! (.-MAXWIDTH arch) (<< 1 50))
  (set! (.-ZeroRange arch) zerorange)
  (set! (.-Ginsnop arch) ginsnop)

  (set! (.-SSAMarkMoves arch) ^{:go/end 20} (fn [^{:tag (* ssagen/State)} s ^{:tag (* ssa/Block)} b]))
  (set! (.-SSAGenValue arch) ssaGenValue)
  (set! (.-SSAGenBlock arch) ssaGenBlock)
  (set! (.-LoadRegResult arch) loadRegResult)
  (set! (.-SpillArgReg arch) spillArgReg))

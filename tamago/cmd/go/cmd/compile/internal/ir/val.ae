(in-ns 'go.cmd.compile.internal.ir) (go/file "val.go" :imports [


    ^{:line 8} [constant "go/constant"]

    ^{:line 10} [base "cmd/compile/internal/base"]
    ^{:line 11} [types "cmd/compile/internal/types"]])


^{:go/end 19} (go/func ConstType ^constant/Kind [^Node n]
  (when (or (== n nil) (!= (.Op n) OLITERAL))
    (return constant/Unknown))

  (.Kind (.Val n)))




^{:go/end 35} (go/func IntVal "IntVal returns v converted to int64.\nNote: if t is uint64, very large values will be converted to negative int64.\n" ^int64 [^{:tag (* types/Type)} t ^constant/Value v]
  (if (.IsUnsigned t)
    (when [(values x ok) (constant/Uint64Val v)] ok
      (return (conv int64 x)))

    (do
      (when [(values x ok) (constant/Int64Val v)] ok
        (return x))))


  (base/Fatalf "%v out of range for %v" v t)
  (panic "unreachable"))


^{:go/end 41} (go/func AssertValidTypeForConst [^{:tag (* types/Type)} t ^constant/Value v]
  (when (not (ValidTypeForConst t v))
    (base/Fatalf "%v (%v) does not represent %v (%v)" t (.Kind t) v (.Kind v))))



^{:go/end 61} (go/func ValidTypeForConst ^bool [^{:tag (* types/Type)} t ^constant/Value v]
  (switch (.Kind v)
    (case [constant/Unknown]
      (return (aget OKForConst (.Kind t))))
    (case [constant/Bool]
      (return (.IsBoolean t)))
    (case [constant/String]
      (return (.IsString t)))
    (case [constant/Int]
      (return (.IsInteger t)))
    (case [constant/Float]
      (return (.IsFloat t)))
    (case [constant/Complex]
      (return (.IsComplex t))))


  (base/Fatalf "unexpected constant kind: %v" v)
  (panic "unreachable"))


(go/var ^{:tag (array types/NTYPE bool)} OKForConst)



^{:go/end 76} (go/func Int64Val "Int64Val returns n as an int64.\nn must be an integer or rune constant.\n" ^int64 [^Node n]
  (when (not (IsConst n constant/Int))
    (base/Fatalf "Int64Val(%v)" n))

  (let [(values x ok) (constant/Int64Val (.Val n))]
    (when (not ok)
      (base/Fatalf "Int64Val(%v)" n))

    ^{:line 75} x))




^{:go/end 89} (go/func Uint64Val "Uint64Val returns n as a uint64.\nn must be an integer or rune constant.\n" ^uint64 [^Node n]
  (when (not (IsConst n constant/Int))
    (base/Fatalf "Uint64Val(%v)" n))

  (let [(values x ok) (constant/Uint64Val (.Val n))]
    (when (not ok)
      (base/Fatalf "Uint64Val(%v)" n))

    ^{:line 88} x))




^{:go/end 98} (go/func BoolVal "BoolVal returns n as a bool.\nn must be a boolean constant.\n" ^bool [^Node n]
  (when (not (IsConst n constant/Bool))
    (base/Fatalf "BoolVal(%v)" n))

  (constant/BoolVal (.Val n)))




^{:go/end 107} (go/func StringVal "StringVal returns the value of a literal string Node as a string.\nn must be a string constant.\n" ^string [^Node n]
  (when (not (IsConst n constant/String))
    (base/Fatalf "StringVal(%v)" n))

  (constant/StringVal (.Val n)))

(in-ns 'go.cmd.compile.internal.ir) (go/file "abi.go" :imports [


    ^{:line 8} [base "cmd/compile/internal/base"]
    ^{:line 9} [obj "cmd/internal/obj"]])










^{:go/end 34} (go/func InitLSym "InitLSym defines f's obj.LSym and initializes it based on the\nproperties of f. This includes setting the symbol flags and ABI and\ncreating and initializing related DWARF symbols.\n\nInitLSym must be called exactly once per function and must be\ncalled for both functions with bodies and functions without bodies.\nFor body-less functions, we only create the LSym; for functions\nwith bodies call a helper to setup up / populate the LSym.\n" [^{:tag (* Func)} f ^bool hasBody]
  (when (!= (.-LSym f) nil)
    (base/FatalfAt ^{:go/via [miniNode]} (.Pos f) "InitLSym called twice on %v" f))


  (when [nam (.-Nname f)] (not (IsBlank nam))
    (set! (.-LSym f) (.LinksymABI nam (.-ABI f)))
    (when (!= (bit-and (.-Pragma f) Systemstack) 0)
      ^{:go/via [Attribute]} (.Set (.-LSym f) obj/AttrCFunc true)))


  (when hasBody
    (setupTextLSym f 0)))




^{:go/end 78} (go/func setupTextLSym "setupTextLSym initializes the LSym for a with-body text symbol.\n" [^{:tag (* Func)} f ^int flag]
  (when (.Dupok f)
    (set! flag bit-or obj/DUPOK))

  (when (.Wrapper f)
    (set! flag bit-or obj/WRAPPER))

  (when (.ABIWrapper f)
    (set! flag bit-or obj/ABIWRAPPER))

  (when (.Needctxt f)
    (set! flag bit-or obj/NEEDCTXT))

  (when (!= (bit-and (.-Pragma f) Nosplit) 0)
    (set! flag bit-or obj/NOSPLIT))

  (when (.IsPackageInit f)
    (set! flag bit-or obj/PKGINIT))


  ;; Clumsy but important.
  ;; For functions that could be on the path of invoking a deferred
  ;; function that can recover (runtime.reflectcall, reflect.callReflect,
  ;; and reflect.callMethod), we want the panic+recover special handling.
  ;; See test/recover.go for test cases and src/reflect/value.go
  ;; for the actual functions being considered.
  ;;
  ;; runtime.reflectcall is an assembly function which tailcalls
  ;; WRAPPER functions (runtime.callNN). Its ABI wrapper needs WRAPPER
  ;; flag as well.
  (let [fnname (.-Name (.Sym f))]
    (cond (and (== (.-Pkgpath base/Ctxt) "runtime") (== fnname "reflectcall"))
      (set! flag bit-or obj/WRAPPER)
      (== (.-Pkgpath base/Ctxt) "reflect")
      (switch fnname
        (case ["callReflect" "callMethod"]
          (set! flag bit-or obj/WRAPPER))))



    (.InitTextSym base/Ctxt (.-LSym f) flag ^{:go/via [miniNode]} (.Pos f))))

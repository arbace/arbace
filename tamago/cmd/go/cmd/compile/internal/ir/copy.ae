(in-ns 'go.cmd.compile.internal.ir) (go/file "copy.go" :imports [


    ^{:line 8} [src "cmd/internal/src"]])



^{:go/end 14} (go/func Copy "Copy returns a shallow copy of n.\n" ^Node [^Node n]
  (.copy n))





^{:go/end 34} (go/func DeepCopy "DeepCopy returns a “deep” copy of n, with its entire structure copied\n(except for shared nodes like ONAME, ONONAME, OLITERAL, and OTYPE).\nIf pos.IsKnown(), it sets the source position of newly allocated Nodes to pos.\n" ^Node [^src/XPos pos ^Node n]
  (let [^{:tag (func [Node] [Node])} edit (zero (func [Node] [Node]))]
    (set! edit ^{:go/end 32} (fn ^Node [^Node x]
        (switch (.Op x)
          (case [ONAME ONONAME OLITERAL ONIL OTYPE]
            (return x)))

        (set! x (Copy x))
        (when (.IsKnown pos)
          (.SetPos x pos))

        (EditChildren x edit)
        ^{:line 31} x))

    (edit n)))

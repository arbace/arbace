(go/const


  ^{:line 93} [^{:val 512 :doc "Maximum size in bits for big.Ints before signaling\noverflow and also mantissa precision for big.Floats.\n"} ConstPrec 512])


^{:go/end 112} (go/func BigFloat ^{:tag (* big/Float)} [^constant/Value v]
  (let [f (new big/Float)]
    (.SetPrec f ConstPrec)
    (type-switch [u (constant/Val v)]
      (case [int64]
        (.SetInt64 f u))
      (case [(* big/Int)]
        (.SetInt f u))
      (case [(* big/Float)]
        (.Set f u))
      (case [(* big/Rat)]
        (.SetRat f u))
      (default
        (base/Fatalf "unexpected: %v" u)))

    ^{:line 111} f))




^{:go/end 144} (go/func ConstOverflow "ConstOverflow reports whether constant value v is too large\nto represent with type t.\n" ^bool [^constant/Value v ^{:tag (* types/Type)} t]
  (switch
    (case [(.IsInteger t)]
      (let [bits (conv uint (* 8 (.Size t)))]
        (when (.IsUnsigned t)
          (let [(values x ok) (constant/Uint64Val v)]
            (return (or (not ok) (!= (>> x bits) 0)))))

        (let [(values x ok) (constant/Int64Val v)]
          (when (< x 0)
            (set! x (bit-not x)))

          (return (or (not ok) (!= (>> x (- bits 1)) 0))))))
    (case [(.IsFloat t)]
      (switch (.Size t)
        (case [4]
          (let [(values f _) (constant/Float32Val v)]
            (return (math/IsInf (conv float64 f) 0))))
        (case [8]
          (let [(values f _) (constant/Float64Val v)]
            (return (math/IsInf f 0))))))

    (case [(.IsComplex t)]
      (let [ft (types/FloatForComplex t)]
        (return (or (ConstOverflow (constant/Real v) ft) (ConstOverflow (constant/Imag v) ft))))))

  (base/Fatalf "ConstOverflow: %v, %v" v t)
  (panic "unreachable"))







^{:go/end 153} (go/func IsConstNode "IsConstNode reports whether n is a Go language constant (as opposed to a\ncompile-time constant).\n\nExpressions derived from nil, like string([]byte(nil)), while they\nmay be known at compile time, are not Go language constants.\n" ^bool [^Node n]
  (== (.Op n) OLITERAL))


^{:go/breaks [[4 160]] :go/end 161} (go/func IsSmallIntConst ^bool [^Node n]
  (when (== (.Op n) OLITERAL)
    (let [(values v ok) (constant/Int64Val (.Val n))]
      (return (and ok (== (conv int64 (conv int32 v)) v)))))

  false)

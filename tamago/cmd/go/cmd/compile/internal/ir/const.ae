  ^{:line 63} [floatZero (constant/ToFloat intZero)]
  ^{:line 64} [complexZero (constant/ToComplex intZero)])



^{:go/end 82} (go/func NewOne "NewOne returns an OLITERAL representing 1 with the given type.\n" ^Node [^src/XPos pos ^{:tag (* types/Type)} typ]
  (let [^constant/Value val (zero constant/Value)]
    (switch
      (case [(.IsInteger typ)]
        (set! val intOne))
      (case [(.IsFloat typ)]
        (set! val floatOne))
      (case [(.IsComplex typ)]
        (set! val complexOne))
      (default
        (base/FatalfAt pos "%v cannot represent 1" typ)))


    (NewBasicLit pos typ val)))



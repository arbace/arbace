(go/var ^{:doc "safePhaseNameString is a very conservative limit on phase names\nthat can safely be encoded as JavaScript strings by wrapping with\ndouble-quotes.\n"} safePhaseNameString (regexp/MustCompile "^[a-zA-Z0-9_ .]+$"))

^{:go/end 813} (go/func JS ^string [& ^{:tag (slice string)} opened]
  (let [^strings/Builder middle (zero strings/Builder)]

    ;; "bloop",
    ;; "loopvar",
    ;; "escape",
    ;; "slice",
    ;; "walk",

    ;; This is only for default-display purposes, and the expected strings
    ;; are the names of compiler phases. If a wonky name is rejected, the
    ;; "harm" is that a pane in the debugging display is not pre-opened.
    (range [_ s opened]
      (when (not (.MatchString safePhaseNameString s))
        (continue))

      (.WriteString middle "\t\"")
      (.WriteString middle s)
      (.WriteString middle "\",\n"))

    (+ JS1 (.String middle) JS2)))



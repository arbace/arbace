(in-ns 'go.cmd.compile.internal.ir) (go/file "mini.go" :directives ["//go:generate go run mknode.go"] :imports [


    ^{:line 10} [types "cmd/compile/internal/types"]
    ^{:line 11} [src "cmd/internal/src"]
    ^{:line 12} [fmt "fmt"]
    ^{:line 13} [constant "go/constant"]])
















(go/type miniNode "A miniNode is a minimal node implementation,\nmeant to be embedded as the first field in a larger node implementation,\nat a cost of 12 bytes.\n\nA miniNode is NOT a valid Node by itself: the embedding struct\nmust at the least provide:\n\n\tfunc (n *MyNode) String() string { return fmt.Sprint(n) }\n\tfunc (n *MyNode) rawCopy() Node { c := *n; return &c }\n\tfunc (n *MyNode) Format(s fmt.State, verb rune) { FmtNode(n, s, verb) }\n\nThe embedding struct should also fill in n.op in its constructor,\nfor more useful panic messages when invalid methods are called,\ninstead of implementing Op itself.\n" (struct
    ^{:line 31 :tag src/XPos} pos
    ^{:line 32 :tag Op} op
    ^{:line 33 :tag bitset8} bits
    ^{:line 34 :tag uint16} esc))





^{:go/end 40} (go/method Op "op can be read, but not written.\nAn embedding implementation can provide a SetOp if desired.\n(The panicking SetOp is with the other panics below.)\n" ^Op [^{:tag (* miniNode)} n] (.-op n))
^{:go/end 41} (go/method Pos ^src/XPos [^{:tag (* miniNode)} n] (.-pos n))
^{:go/end 42} (go/method SetPos [^{:tag (* miniNode)} n ^src/XPos x] (set! (.-pos n) x))
^{:go/end 43} (go/method Esc ^uint16 [^{:tag (* miniNode)} n] (.-esc n))
^{:go/end 44} (go/method SetEsc [^{:tag (* miniNode)} n ^uint16 x] (set! (.-esc n) x))

(go/const
  ^{:line 47} [^{:val 0} miniTypecheckShift 0]
  ^{:line 48} [^{:val 4} miniWalked (<< 1 2)]) ; to prevent/catch re-walking


^{:go/end 51} (go/method Typecheck ^uint8 [^{:tag (* miniNode)} n] (.get2 (.-bits n) miniTypecheckShift))
^{:go/end 57} (go/method SetTypecheck [^{:tag (* miniNode)} n ^uint8 x]
  (when (> x 2)
    (panic (fmt/Sprintf "cannot SetTypecheck %d" x)))

  (.set2 (.-bits n) miniTypecheckShift x))


^{:go/end 59} (go/method Walked ^bool [^{:tag (* miniNode)} n] (!= (bit-and (.-bits n) miniWalked) 0))
^{:go/end 60} (go/method SetWalked [^{:tag (* miniNode)} n ^bool x] (.set (.-bits n) miniWalked x))

;; Empty, immutable graph structure.

^{:go/end 64} (go/method Init ^Nodes [^{:tag (* miniNode)} n] (lit Nodes))

;; Additional functionality unavailable.

^{:go/end 68} (go/method no ^string [^{:tag (* miniNode)} n ^string name] (+ "cannot " name " on " (.String (.-op n))))

^{:go/end 70} (go/method Type ^{:tag (* types/Type)} [^{:tag (* miniNode)} n] nil)
^{:go/end 71} (go/method SetType [^{:tag (* miniNode)} n (* types/Type)] (panic (.no n "SetType")))
^{:go/end 72} (go/method Name ^{:tag (* Name)} [^{:tag (* miniNode)} n] nil)
^{:go/end 73} (go/method Sym ^{:tag (* types/Sym)} [^{:tag (* miniNode)} n] nil)
^{:go/end 74} (go/method Val ^constant/Value [^{:tag (* miniNode)} n] (panic (.no n "Val")))
^{:go/end 75} (go/method SetVal [^{:tag (* miniNode)} n ^constant/Value v] (panic (.no n "SetVal")))
^{:go/end 76} (go/method NonNil ^bool [^{:tag (* miniNode)} n] false)
^{:go/end 77} (go/method MarkNonNil [^{:tag (* miniNode)} n] (panic (.no n "MarkNonNil")))

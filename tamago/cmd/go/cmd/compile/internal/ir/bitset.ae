(in-ns 'go.cmd.compile.internal.ir) (go/file "bitset.go" :imports [])

(go/type bitset8 uint8)

^{:go/end 15} (go/method set [^{:tag (* bitset8)} f ^uint8 mask ^bool b]
  (if b
    (set! @(conv (* uint8) f) bit-or mask)

    (set! @(conv (* uint8) f) bit-and-not mask)))



^{:go/end 19} (go/method get2 ^uint8 [^bitset8 f ^uint8 shift]
  (bit-and (conv uint8 (>> f shift)) 3))



^{:go/end 27} (go/method set2 "set2 sets two bits in f using the bottom two bits of b.\n" [^{:tag (* bitset8)} f ^uint8 shift ^uint8 b]
  ;; Clear old bits.
  (set! @(conv (* uint8) f) bit-and-not ^uint8 (<< 3 shift))
  ;; Set new bits.
  (set! @(conv (* uint8) f) bit-or (<< (bit-and b 3) shift)))


(go/type bitset16 uint16)

^{:go/end 37} (go/method set [^{:tag (* bitset16)} f ^uint16 mask ^bool b]
  (if b
    (set! @(conv (* uint16) f) bit-or mask)

    (set! @(conv (* uint16) f) bit-and-not mask)))

;; IR visitors for walking the IR tree.
;;
;; The lowest level helpers are DoChildren and EditChildren, which
;; nodes help implement and provide control over whether and when
;; recursion happens during the walk of the IR.
;;
;; Although these are both useful directly, two simpler patterns
;; are fairly common and also provided: Visit and Any.

(in-ns 'go.cmd.compile.internal.ir) (go/file "visit.go" :imports [])











































































^{:go/end 95} (go/func DoChildren "DoChildren calls do(x) on each of n's non-nil child nodes x.\nIf any call returns true, DoChildren stops and returns true.\nOtherwise, DoChildren returns false.\n\nNote that DoChildren(n, do) only calls do(x) for n's immediate children.\nIf x's children should be processed, then do(x) must call DoChildren(x, do).\n\nDoChildren allows constructing general traversals of the IR graph\nthat can stop early if needed. The most general usage is:\n\n\tvar do func(ir.Node) bool\n\tdo = func(x ir.Node) bool {\n\t\t... processing BEFORE visiting children ...\n\t\tif ... should visit children ... {\n\t\t\tir.DoChildren(x, do)\n\t\t\t... processing AFTER visiting children ...\n\t\t}\n\t\tif ... should stop parent DoChildren call from visiting siblings ... {\n\t\t\treturn true\n\t\t}\n\t\treturn false\n\t}\n\tdo(root)\n\nSince DoChildren does not return true itself, if the do function\nnever wants to stop the traversal, it can assume that DoChildren\nitself will always return false, simplifying to:\n\n\tvar do func(ir.Node) bool\n\tdo = func(x ir.Node) bool {\n\t\t... processing BEFORE visiting children ...\n\t\tif ... should visit children ... {\n\t\t\tir.DoChildren(x, do)\n\t\t}\n\t\t... processing AFTER visiting children ...\n\t\treturn false\n\t}\n\tdo(root)\n\nThe Visit function illustrates a further simplification of the pattern,\nonly processing before visiting children and never stopping:\n\n\tfunc Visit(n ir.Node, visit func(ir.Node)) {\n\t\tif n == nil {\n\t\t\treturn\n\t\t}\n\t\tvar do func(ir.Node) bool\n\t\tdo = func(x ir.Node) bool {\n\t\t\tvisit(x)\n\t\t\treturn ir.DoChildren(x, do)\n\t\t}\n\t\tdo(n)\n\t}\n\nThe Any function illustrates a different simplification of the pattern,\nvisiting each node and then its children, recursively, until finding\na node x for which cond(x) returns true, at which point the entire\ntraversal stops and returns true.\n\n\tfunc Any(n ir.Node, cond(ir.Node) bool) bool {\n\t\tif n == nil {\n\t\t\treturn false\n\t\t}\n\t\tvar do func(ir.Node) bool\n\t\tdo = func(x ir.Node) bool {\n\t\t\treturn cond(x) || ir.DoChildren(x, do)\n\t\t}\n\t\treturn do(n)\n\t}\n\nVisit and Any are presented above as examples of how to use\nDoChildren effectively, but of course, usage that fits within the\nsimplifications captured by Visit or Any will be best served\nby directly calling the ones provided by this package.\n" ^bool [^Node n ^{:tag (func [Node] [bool])} do]
  (when (== n nil)
    (return false))

  (.doChildren n do))







^{:go/end 107} (go/func DoChildrenWithHidden "DoChildrenWithHidden is like DoChildren, but also visits\nNode-typed fields tagged with `mknode:\"-\"`.\n\nTODO(mdempsky): Remove the `mknode:\"-\"` tags so this function can\ngo away.\n" ^bool [^Node n ^{:tag (func [Node] [bool])} do]
  (when (== n nil)
    (return false))

  (.doChildrenWithHidden n do))




^{:go/end 121} (go/func Visit "Visit visits each non-nil node x in the IR tree rooted at n\nin a depth-first preorder traversal, calling visit on each node visited.\n" [^Node n ^{:tag (func [Node])} visit]
  (when (== n nil)
    (return))

  (let [^{:tag (func [Node] [bool])} do (zero (func [Node] [bool]))]
    (set! do ^{:go/end 119} (fn ^bool [^Node x]
        (visit x)
        (DoChildren x do)))

    (go/call do n)))



^{:go/end 128} (go/func VisitList "VisitList calls Visit(x, visit) for each node x in the list.\n" [^Nodes list ^{:tag (func [Node])} visit]
  (range [_ x list]
    (Visit x visit)))





^{:go/end 139} (go/func VisitFuncAndClosures "VisitFuncAndClosures calls visit on each non-nil node in fn.Body,\nincluding any nested closure bodies.\n" [^{:tag (* Func)} fn ^{:tag (func [^Node n])} visit]
  (VisitList (.-Body fn) ^{:go/end 138} (fn [^Node n]
      (visit n)
      (when [(values n ok) (assert (* ClosureExpr) n)] (and ok (== ^{:go/via [miniExpr miniNode]} (.Op n) OCLOSURE))
        (VisitFuncAndClosures (.-Func n) visit)))))










^{:go/end 156} (go/func Any "Any looks for a non-nil node x in the IR tree rooted at n\nfor which cond(x) returns true.\nAny considers nodes in a depth-first, preorder traversal.\nWhen Any finds a node x such that cond(x) is true,\nAny ends the traversal and returns true immediately.\nOtherwise Any returns false after completing the entire traversal.\n" ^bool [^Node n ^{:tag (func [Node] [bool])} cond]
  (when (== n nil)
    (return false))

  (let [^{:tag (func [Node] [bool])} do (zero (func [Node] [bool]))]
    (set! do ^{:go/end 154} (fn ^bool [^Node x]
        (or (go/call cond x) (DoChildren x do))))

    (go/call do n)))



































^{:go/end 196} (go/func EditChildren "EditChildren edits the child nodes of n, replacing each child x with edit(x).\n\nNote that EditChildren(n, edit) only calls edit(x) for n's immediate children.\nIf x's children should be processed, then edit(x) must call EditChildren(x, edit).\n\nEditChildren allows constructing general editing passes of the IR graph.\nThe most general usage is:\n\n\tvar edit func(ir.Node) ir.Node\n\tedit = func(x ir.Node) ir.Node {\n\t\t... processing BEFORE editing children ...\n\t\tif ... should edit children ... {\n\t\t\tEditChildren(x, edit)\n\t\t\t... processing AFTER editing children ...\n\t\t}\n\t\t... return x ...\n\t}\n\tn = edit(n)\n\nEditChildren edits the node in place. To edit a copy, call Copy first.\nAs an example, a simple deep copy implementation would be:\n\n\tfunc deepCopy(n ir.Node) ir.Node {\n\t\tvar edit func(ir.Node) ir.Node\n\t\tedit = func(x ir.Node) ir.Node {\n\t\t\tx = ir.Copy(x)\n\t\t\tir.EditChildren(x, edit)\n\t\t\treturn x\n\t\t}\n\t\treturn edit(n)\n\t}\n\nOf course, in this case it is better to call ir.DeepCopy than to build one anew.\n" [^Node n ^{:tag (func [Node] [Node])} edit]
  (when (== n nil)
    (return))

  (.editChildren n edit))







^{:go/end 208} (go/func EditChildrenWithHidden "EditChildrenWithHidden is like EditChildren, but also edits\nNode-typed fields tagged with `mknode:\"-\"`.\n\nTODO(mdempsky): Remove the `mknode:\"-\"` tags so this function can\ngo away.\n" [^Node n ^{:tag (func [Node] [Node])} edit]
  (when (== n nil)
    (return))

  (.editChildrenWithHidden n edit))

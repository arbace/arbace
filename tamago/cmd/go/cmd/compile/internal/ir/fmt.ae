^{:go/end 102} (go/method GoString "GoString returns the Go syntax for the Op, or else its name.\n" ^string [^Op o]
  (when (and (< (conv int o) (len OpNames)) (!= (aget OpNames o) ""))
    (return (aget OpNames o)))

  (.String o))







^{:go/end 121} (go/method Format "Format implements formatting for an Op.\nThe valid formats are:\n\n\t%v\tGo syntax (\"+\", \"<-\", \"print\")\n\t%+v\tDebug syntax (\"ADD\", \"RECV\", \"PRINT\")\n" [^Op o ^fmt/State s ^rune verb]
  (switch verb
    (default
      (fmt/Fprintf s "%%!%c(Op=%d)" verb (conv int o)))
    (case [\v]
      (when (.Flag s \+)
        ;; %+v is OMUL instead of "*"
        (io/WriteString s (.String o))
        (return))

      (io/WriteString s (.GoString o)))))



;; Node








^{:go/end 170} (go/func fmtNode "fmtNode implements formatting for a Node n.\nEvery Node implementation must define a Format method that calls fmtNode.\nThe valid formats are:\n\n\t%v\tGo syntax\n\t%L\tGo syntax followed by \" (type T)\" if type is known.\n\t%+v\tDebug syntax, as in Dump.\n" [^Node n ^fmt/State s ^rune verb]
  ;; %+v prints Dump.
  ;; Otherwise we print Go syntax.
  (when (and (.Flag s \+) (== verb \v))
    (dumpNode s n 1)
    (return))


  (when (and (!= verb \v) (!= verb \S) (!= verb \L))
    (fmt/Fprintf s "%%!%c(*Node=%p)" verb n)
    (return))


  (when (== n nil)
    (fmt/Fprint s "<nil>")
    (return))


  (let [t (.Type n)]
    (when (and (== verb \L) (!= t nil))
      (cond (== (.Kind t) types/TNIL)
        (fmt/Fprint s "nil")
        (and (== (.Op n) ONAME) (.AutoTemp (.Name n)))
        (fmt/Fprintf s "%v value" t) :else

        (fmt/Fprintf s "%v (type %v)" n t))

      (return))


    ;; TODO inlining produces expressions with ninits. we can't print these yet.

    (when (< (aget OpPrec (.Op n)) 0)
      (stmtFmt n s)
      (return))


    (exprFmt n s 0)))



^{:go/breaks [[5 300]] :go/end 301} (go/func StmtWithInit "StmtWithInit reports whether op is a statement with an explicit init list.\n" ^bool [^Op op]
  (switch op
    (case [OIF OFOR OSWITCH]
      (return true)))

  false)


^{:go/end 505} (go/func stmtFmt [^Node n ^fmt/State s]
  ;; NOTE(rsc): This code used to support the text-based
  ;; which was more aggressive about printing full Go syntax
  ;; (for example, an actual loop instead of "for loop").
  ;; The code is preserved for now in case we want to expand
  ;; any of those shortenings later. Or maybe we will delete
  ;; the code. But for now, keep it.
  (let [^:const ^{:val false} exportFormat false

      ;; some statements allow for an init, but at most one,
      ;; but we may have an arbitrary number added, eg by typecheck
      ;; and inlining. If it doesn't fit the syntax, emit an enclosing
      ;; block starting with the init statements.

      ;; if we can just say "for" n->ninit; ... then do so
      ^{:line 318} simpleinit (and (== (len (.Init n)) 1) (== (len (.Init (aget (.Init n) 0))) 0) (StmtWithInit (.Op n)))

      ;; otherwise, print the inits as separate statements
      ^{:line 321} complexinit (and (!= (len (.Init n)) 0) (not simpleinit) exportFormat)

      ;; but if it was for if/for/switch, put in an extra surrounding block to limit the scope
      ^{:line 324} extrablock (and complexinit (StmtWithInit (.Op n)))]

    (when extrablock
      (fmt/Fprint s "{"))


    (when complexinit
      (fmt/Fprintf s " %v; " (.Init n)))


    (switch (.Op n)
      (case [ODCL]
        (let [n (assert (* Decl) n)]
          (fmt/Fprintf s "var %v %v" (.Sym (.-X n)) ^{:go/via [miniExpr]} (.Type (.-X n)))))

      ;; Don't export "v = <N>" initializing statements, hope they're always
      ;; preceded by the DCL which will be re-parsed and typechecked to reproduce
      ;; the "v = <N>" again.
      (case [OAS]
        (let [n (assert (* AssignStmt) n)]
          (if (and (.-Def n) (not complexinit))
            (fmt/Fprintf s "%v := %v" (.-X n) (.-Y n))

            (fmt/Fprintf s "%v = %v" (.-X n) (.-Y n)))))


      (case [OASOP]
        (let [n (assert (* AssignOpStmt) n)]
          (when (.-IncDec n)
            (if (== (.-AsOp n) OADD)
              (fmt/Fprintf s "%v++" (.-X n))

              (fmt/Fprintf s "%v--" (.-X n)))

            (break))


          (fmt/Fprintf s "%v %v= %v" (.-X n) (.-AsOp n) (.-Y n))))

      (case [OAS2 OAS2DOTTYPE OAS2FUNC OAS2MAPR OAS2RECV]
        (let [n (assert (* AssignListStmt) n)]
          (if (and (.-Def n) (not complexinit))
            (fmt/Fprintf s "%.v := %.v" (.-Lhs n) (.-Rhs n))

            (fmt/Fprintf s "%.v = %.v" (.-Lhs n) (.-Rhs n)))))


      (case [OBLOCK]
        (let [n (assert (* BlockStmt) n)]
          (when (!= (len (.-List n)) 0)
            (fmt/Fprintf s "%v" (.-List n)))))


      (case [ORETURN]
        (let [n (assert (* ReturnStmt) n)]
          (fmt/Fprintf s "return %.v" (.-Results n))))

      (case [OTAILCALL]
        (let [n (assert (* TailCallStmt) n)]
          (fmt/Fprintf s "tailcall %v" (.-Call n))))

      (case [OINLMARK]
        (let [n (assert (* InlineMarkStmt) n)]
          (fmt/Fprintf s "inlmark %d" (.-Index n))))

      (case [OGO]
        (let [n (assert (* GoDeferStmt) n)]
          (fmt/Fprintf s "go %v" (.-Call n))))

      (case [ODEFER]
        (let [n (assert (* GoDeferStmt) n)]
          (fmt/Fprintf s "defer %v" (.-Call n))))

      (case [OIF]
        (let [n (assert (* IfStmt) n)]
          (if simpleinit
            (fmt/Fprintf s "if %v; %v { %v }" (aget ^{:go/via [miniStmt]} (.Init n) 0) (.-Cond n) (.-Body n))

            (fmt/Fprintf s "if %v { %v }" (.-Cond n) (.-Body n)))

          (when (!= (len (.-Else n)) 0)
            (fmt/Fprintf s " else { %v }" (.-Else n)))))


      (case [OFOR]
        (let [n (assert (* ForStmt) n)]
          (when (not exportFormat) ; TODO maybe only if FmtShort, same below
            (fmt/Fprintf s "for loop")
            (break))


          (fmt/Fprint s "for")
          (when (.-DistinctVars n)
            (fmt/Fprint s " /* distinct */"))

          (cond simpleinit
            (fmt/Fprintf s " %v;" (aget ^{:go/via [miniStmt]} (.Init n) 0))
            (!= (.-Post n) nil)
            (fmt/Fprint s " ;"))


          (when (!= (.-Cond n) nil)
            (fmt/Fprintf s " %v" (.-Cond n)))


          (cond (!= (.-Post n) nil)
            (fmt/Fprintf s "; %v" (.-Post n))
            ^{:line 431} simpleinit
            (fmt/Fprint s ";"))


          (fmt/Fprintf s " { %v }" (.-Body n))))

      (case [ORANGE]
        (let [n (assert (* RangeStmt) n)]
          (when (not exportFormat)
            (fmt/Fprint s "for loop")
            (break))


          (fmt/Fprint s "for")
          (when (!= (.-Key n) nil)
            (fmt/Fprintf s " %v" (.-Key n))
            (when (!= (.-Value n) nil)
              (fmt/Fprintf s ", %v" (.-Value n)))

            (fmt/Fprint s " ="))

          (fmt/Fprintf s " range %v { %v }" (.-X n) (.-Body n))
          (when (.-DistinctVars n)
            (fmt/Fprint s " /* distinct vars */"))))


      (case [OSELECT]
        (let [n (assert (* SelectStmt) n)]
          (when (not exportFormat)
            (fmt/Fprintf s "%v statement" ^{:go/via [miniStmt miniNode]} (.Op n))
            (break))

          (fmt/Fprintf s "select { %v }" (.-Cases n))))

      (case [OSWITCH]
        (let [n (assert (* SwitchStmt) n)]
          (when (not exportFormat)
            (fmt/Fprintf s "%v statement" ^{:go/via [miniStmt miniNode]} (.Op n))
            (break))

          (fmt/Fprintf s "switch")
          (when simpleinit
            (fmt/Fprintf s " %v;" (aget ^{:go/via [miniStmt]} (.Init n) 0)))

          (when (!= (.-Tag n) nil)
            (fmt/Fprintf s " %v " (.-Tag n)))

          (fmt/Fprintf s " { %v }" (.-Cases n))))

      (case [OCASE]
        (let [n (assert (* CaseClause) n)]
          (if (!= (len (.-List n)) 0)
            (fmt/Fprintf s "case %.v" (.-List n))

            (fmt/Fprint s "default"))

          (fmt/Fprintf s ": %v" (.-Body n))))

      (case [OBREAK OCONTINUE OGOTO OFALL]
        (let [n (assert (* BranchStmt) n)]
          (if (!= (.-Label n) nil)
            (fmt/Fprintf s "%v %v" ^{:go/via [miniStmt miniNode]} (.Op n) (.-Label n))

            (fmt/Fprintf s "%v" ^{:go/via [miniStmt miniNode]} (.Op n)))))


      (case [OLABEL]
        (let [n (assert (* LabelStmt) n)]
          (fmt/Fprintf s "%v: " (.-Label n)))))


    (when extrablock
      (fmt/Fprint s "}"))))



^{:go/end 855} (go/func exprFmt [^Node n ^fmt/State s ^int prec]
  ;; NOTE(rsc): This code used to support the text-based
  ;; which was more aggressive about printing full Go syntax
  ;; (for example, an actual loop instead of "for loop").
  ;; The code is preserved for now in case we want to expand
  ;; any of those shortenings later. Or maybe we will delete
  ;; the code. But for now, keep it.
  (let [^:const ^{:val false} exportFormat false]

    (while true
      (when (== n nil)
        (fmt/Fprint s "<nil>")
        (return))


      ;; Skip implicit operations introduced during typechecking.
      (switch [nn n] (.Op nn)
        (case [OADDR]
          (let [nn (assert (* AddrExpr) nn)]
            (when (.Implicit nn)
              (set! n (.-X nn))
              (continue))))

        (case [ODEREF]
          (let [nn (assert (* StarExpr) nn)]
            (when (.Implicit nn)
              (set! n (.-X nn))
              (continue))))

        (case [OCONV OCONVNOP OCONVIFACE]
          (let [nn (assert (* ConvExpr) nn)]
            (when (.Implicit nn)
              (set! n (.-X nn))
              (continue)))))



      (break))


    (let [nprec (aget OpPrec (.Op n))]
      (when (and (== (.Op n) OTYPE) (!= (.Type n) nil) (.IsPtr (.Type n)))
        (set! nprec (aget OpPrec ODEREF)))


      (when (> prec nprec)
        (fmt/Fprintf s "(%v)" n)
        (return))


      (switch (.Op n)
        (case [OPAREN]
          (let [n (assert (* ParenExpr) n)]
            (fmt/Fprintf s "(%v)" (.-X n))))

        (case [ONIL]
          (fmt/Fprint s "nil"))

        (case [OLITERAL]
          (when (!= (.Sym n) nil)
            (fmt/Fprint s (.Sym n))
            (return))


          (let [typ (.Type n)
              ^{:line 572} val (.Val n)]

            ;; Special case for rune constants.
            (when (or (== typ types/RuneType) (== typ types/UntypedRune))
              (when [(values x ok) (constant/Uint64Val val)] (and ok (<= x utf8/MaxRune))
                (fmt/Fprintf s "%q" (conv rune x))
                (return)))



            ;; Only include typ if it's neither the default nor untyped type
            ;; for the constant value.
            (if [k (.Kind val)] (or (== typ (aget types/Types (aget types/DefaultKinds k))) (== typ (aget types/UntypedTypes k)))
              (fmt/Fprint s val)

              (fmt/Fprintf s "%v(%v)" typ val))))


        (case [ODCLFUNC]
          (let [n (assert (* Func) n)]
            (when [sym (.Sym n)] (!= sym nil)
              (fmt/Fprint s sym)
              (return))

            (fmt/Fprintf s "<unnamed Func>")))

        (case [ONAME]
          (let [n (assert (* Name) n)]
            ;; Special case: name used as local variable in export.
            ;; _ becomes ~b%d internally; print as _ for export
            (when (and (not exportFormat) (!= (.Sym n) nil) (== (aget (.-Name (.Sym n)) 0) \~) (== (aget (.-Name (.Sym n)) 1) \b))
              (fmt/Fprint s "_")
              (return))

            (fallthrough)))
        (case [ONONAME]
          (fmt/Fprint s (.Sym n)))

        (case [OLINKSYMOFFSET]
          (let [n (assert (* LinksymOffsetExpr) n)]
            (fmt/Fprintf s "(%v)(%s@%d)" ^{:go/via [miniExpr]} (.Type n) (.-Name (.-Linksym n)) (.-Offset_ n))))

        (case [OTYPE]
          (when (and (== (.Type n) nil) (!= (.Sym n) nil))
            (fmt/Fprint s (.Sym n))
            (return))

          (fmt/Fprintf s "%v" (.Type n)))

        (case [OCLOSURE]
          (let [n (assert (* ClosureExpr) n)]
            (when (not exportFormat)
              (fmt/Fprint s "func literal")
              (return))

            (fmt/Fprintf s "%v { %v }" ^{:go/via [miniExpr]} (.Type n) (.-Body (.-Func n)))))

        (case [OPTRLIT]
          (let [n (assert (* AddrExpr) n)]
            (fmt/Fprintf s "&%v" (.-X n))))

        (case [OCOMPLIT OSTRUCTLIT OARRAYLIT OSLICELIT OMAPLIT]
          (let [n (assert (* CompLitExpr) n)]
            (when (.Implicit n)
              (fmt/Fprintf s "... argument")
              (return))

            (fmt/Fprintf s "%v{%s}" ^{:go/via [miniExpr]} (.Type n) (ellipsisIf (!= (len (.-List n)) 0)))))

        (case [OKEY]
          (let [n (assert (* KeyExpr) n)]
            (when (and (!= (.-Key n) nil) (!= (.-Value n) nil))
              (fmt/Fprintf s "%v:%v" (.-Key n) (.-Value n))
              (return))


            (when (and (== (.-Key n) nil) (!= (.-Value n) nil))
              (fmt/Fprintf s ":%v" (.-Value n))
              (return))

            (when (and (!= (.-Key n) nil) (== (.-Value n) nil))
              (fmt/Fprintf s "%v:" (.-Key n))
              (return))

            (fmt/Fprint s ":")))

        (case [OSTRUCTKEY]
          (let [n (assert (* StructKeyExpr) n)]
            (fmt/Fprintf s "%v:%v" (.-Field n) (.-Value n))))

        (case [OXDOT ODOT ODOTPTR ODOTINTER ODOTMETH OMETHVALUE OMETHEXPR]
          (let [n (assert (* SelectorExpr) n)]
            (exprFmt (.-X n) s nprec)
            (when (== (.-Sel n) nil)
              (fmt/Fprint s ".<nil>")
              (return))

            (fmt/Fprintf s ".%s" (.-Name (.-Sel n)))))

        (case [ODOTTYPE ODOTTYPE2]
          (let [n (assert (* TypeAssertExpr) n)]
            (exprFmt (.-X n) s nprec)
            (fmt/Fprintf s ".(%v)" ^{:go/via [miniExpr]} (.Type n))))

        (case [OINDEX OINDEXMAP]
          (let [n (assert (* IndexExpr) n)]
            (exprFmt (.-X n) s nprec)
            (fmt/Fprintf s "[%v]" (.-Index n))))

        (case [OSLICE OSLICESTR OSLICEARR OSLICE3 OSLICE3ARR]
          (let [n (assert (* SliceExpr) n)]
            (exprFmt (.-X n) s nprec)
            (fmt/Fprint s "[")
            (when (!= (.-Low n) nil)
              (fmt/Fprint s (.-Low n)))

            (fmt/Fprint s ":")
            (when (!= (.-High n) nil)
              (fmt/Fprint s (.-High n)))

            (when (.IsSlice3 ^{:go/via [miniExpr miniNode]} (.Op n))
              (fmt/Fprint s ":")

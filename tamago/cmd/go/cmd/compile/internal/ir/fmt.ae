;; Nodes







^{:go/end 895} (go/method Format "Format implements formatting for a Nodes.\nThe valid formats are:\n\n\t%v\tGo syntax, semicolon-separated\n\t%.v\tGo syntax, comma-separated\n\t%+v\tDebug syntax, as in DumpList.\n" [^Nodes l ^fmt/State s ^rune verb]
  (when (and (.Flag s \+) (== verb \v))
    ;; %+v is DumpList output
    (dumpNodes s l 1)
    (return))


  (when (!= verb \v)
    (fmt/Fprintf s "%%!%c(Nodes)" verb)
    (return))


  (let [sep "; "]
    (when [(values _ ok) (.Precision s)] ok ; %.v is expr list
      (set! sep ", "))


    (range [i n l]
      (fmt/Fprint s n)
      (when (< (+ i 1) (len l))
        (fmt/Fprint s sep)))))




;; Dump



^{:go/end 903} (go/func Dump "Dump prints the message s followed by a debug dump of n.\nThis includes all the recursive structure under n.\n" [^string s ^Node n]
  (fmt/Printf "%s%+v\n" s n))




^{:go/end 909} (go/func FDump "FDump prints to w the message s followed by a debug dump of n.\nThis includes all the recursive structure under n.\n" [^io/Writer w ^string s ^Node n]
  (fmt/Fprintf w "%s%+v\n" s n))




^{:go/end 917} (go/func DumpList "DumpList prints the message s followed by a debug dump of each node in the list.\nThis includes all the recursive structure under each node in the list.\n" [^string s ^Nodes list]
  (let [^bytes/Buffer buf (zero bytes/Buffer)]
    (FDumpList (addr buf) s list)
    (.Write os/Stdout (.Bytes buf))))




^{:go/end 925} (go/func FDumpList "FDumpList prints to w the message s followed by a debug dump of each node in the list.\nThis includes all the recursive structure under each node in the list.\n" [^io/Writer w ^string s ^Nodes list]
  (io/WriteString w s)
  (dumpNodes w list 1)
  (io/WriteString w "\n"))



^{:go/end 933} (go/func indent "indent prints indentation to w.\n" [^io/Writer w ^int depth]
  (fmt/Fprint w "\n")
  (for [i 0] (< i depth) (inc! i)
    (fmt/Fprint w ".   ")))




(go/var ^{:tag (func [^Node n] [string]) :doc "EscFmt is set by the escape analysis code to add escape analysis details to the node print.\n"} EscFmt)


^{:go/end 1058} (go/func dumpNodeHeader "dumpNodeHeader prints the debug-format node header line to w.\n" [^io/Writer w ^Node n]
  ;; Useful to see which nodes in an AST printout are actually identical
  (when (!= (.-DumpPtrs base/Debug) 0)
    (fmt/Fprintf w " p(%p)" n))


  (when (and (!= (.-DumpPtrs base/Debug) 0) (!= (.Name n) nil) (!= (.-Defn (.Name n)) nil))
    ;; Useful to see where Defn is set and what node it points to
    (fmt/Fprintf w " defn(%p)" (.-Defn (.Name n))))


  (when (and (!= (.-DumpPtrs base/Debug) 0) (!= (.Name n) nil) (!= (.-Curfn (.Name n)) nil))
    ;; Useful to see where Defn is set and what node it points to
    (fmt/Fprintf w " curfn(%p)" (.-Curfn (.Name n))))

  (when (and (!= (.-DumpPtrs base/Debug) 0) (!= (.Name n) nil) (!= (.-Outer (.Name n)) nil))
    ;; Useful to see where Defn is set and what node it points to
    (fmt/Fprintf w " outer(%p)" (.-Outer (.Name n))))


  (when (!= EscFmt nil)
    (when [esc (EscFmt n)] (!= esc "")
      (fmt/Fprintf w " %s" esc)))



  (when (and (!= (.Sym n) nil) (!= (.Op n) ONAME) (!= (.Op n) ONONAME) (!= (.Op n) OTYPE))
    (fmt/Fprintf w " %+v" (.Sym n)))


  ;; Print Node-specific fields of basic type in header line.
  (let [v (.Elem (reflect/ValueOf n))
      ^{:line 971} t (.Type v)
      ^{:line 972} nf (.NumField t)]
    (for [i 0] (< i nf) (inc! i)
      (let [tf (.Field t i)]
        (when (!= (.-PkgPath tf) "")
          ;; skip unexported field - Interface will fail
          (continue))

        (let [k (.Kind (.-Type tf))]
          (when (and (<= reflect/Bool k) (<= k reflect/Complex128))
            (let [name (strings/TrimSuffix (.-Name tf) "_")
                ^{:line 982} vf (.Field v i)
                ^{:line 983} vfi (.Interface vf)]
              (when (or (and (== name "Offset") (== vfi types/BADWIDTH)) (and (!= name "Offset") (.IsZero vf)))
                (continue))

              (if (== vfi true)
                (fmt/Fprintf w " %s" name)

                (fmt/Fprintf w " %s:%+v" name (.Interface vf))))))))




    ;; Print Node-specific booleans by looking for methods.
    ;; Different v, t from above - want *Struct not Struct, for methods.
    (set! v (reflect/ValueOf n))
    (set! t (.Type v))
    (let [nm (.NumMethod t)]
      (for [i 0] (< i nm) (inc! i)
        (let [tm (.Method t i)]
          (when (!= (.-PkgPath tm) "")
            ;; skip unexported method - call will fail
            (continue))

          (let [m (.Method v i)
              ^{:line 1007} mt (.Type m)]
            (when (and (== (.NumIn mt) 0) (== (.NumOut mt) 1) (== (.Kind (.Out mt 0)) reflect/Bool))
              ;; TODO(rsc): Remove the func/defer/recover wrapping,
              ;; which is guarding against panics in miniExpr,
              ;; once we get down to the simpler state in which
              ;; nodes have no getter methods that aren't allowed to be called.
              (^{:go/end 1019} (fn []
                  (defer (^{:go/end 1014} (fn [] (recover))))
                  (when (.Bool (aget (.Call m nil) 0))
                    (let [name (strings/TrimSuffix (.-Name tm) "_")]
                      (fmt/Fprintf w " %s" name)))))))))





      (when (== (.Op n) OCLOSURE)
        (let [n (assert (* ClosureExpr) n)]
          (when [fn (.-Func n)] (and (!= fn nil) (!= (.Sym (.-Nname fn)) nil))
            (fmt/Fprintf w " fnName(%+v)" (.Sym (.-Nname fn))))))



      (when (!= (.Type n) nil)
        (when (== (.Op n) OTYPE)
          (fmt/Fprintf w " type"))

        (fmt/Fprintf w " %+v" (.Type n)))

      (when (!= (.Typecheck n) 0)
        (fmt/Fprintf w " tc(%d)" (.Typecheck n)))


      (when (.IsKnown (.Pos n))
        (fmt/Fprint w " # ")
        (switch ^{:go/via [lico]} (.IsStmt (.Pos n))
          (case [src/PosNotStmt]
            (fmt/Fprint w "_")) ; "-" would be confusing
          (case [src/PosIsStmt]
            (fmt/Fprint w "+")))

        (let [sep ""]
          (.AllPos base/Ctxt (.Pos n) ^{:go/end 1056} (fn [^src/Pos pos]
              (fmt/Fprint w sep)
              (set! sep " ")
              ;; TODO(mdempsky): Print line pragma details too.
              (let [file (filepath/Base (.Filename pos))]
                ;; Note: this output will be parsed by ssa/html.go:(*HTMLWriter).WriteAST. Keep in sync.
                (fmt/Fprintf w "%s:%d:%d" file ^{:go/via [lico]} (.Line pos) ^{:go/via [lico]} (.Col pos))))))))))




^{:go/end 1204} (go/func dumpNode [^io/Writer w ^Node n ^int depth]
  (indent w depth)
  (when (> depth 40)
    (fmt/Fprint w "...")
    (return))


  (when (== n nil)
    (fmt/Fprint w "NilIrNode")
    (return))


  (when (!= (len (.Init n)) 0)
    (fmt/Fprintf w "%+v-init" (.Op n))
    (dumpNodes w (.Init n) (+ depth 1))
    (indent w depth))


  (switch (.Op n)
    (default
      (fmt/Fprintf w "%+v" (.Op n))
      (dumpNodeHeader w n))

    (case [OLITERAL]
      (fmt/Fprintf w "%+v-%v" (.Op n) (.Val n))
      (dumpNodeHeader w n)
      (return))

    (case [ONAME ONONAME]
      (if (!= (.Sym n) nil)
        (fmt/Fprintf w "%+v-%+v" (.Op n) (.Sym n))

        (fmt/Fprintf w "%+v" (.Op n)))

      (dumpNodeHeader w n)
      (return))

    (case [OLINKSYMOFFSET]
      (let [n (assert (* LinksymOffsetExpr) n)]
        (fmt/Fprintf w "%+v-%v" ^{:go/via [miniExpr miniNode]} (.Op n) (.-Linksym n))
        ;; Offset is almost always 0, so only print when it's interesting.
        (when (!= (.-Offset_ n) 0)
          (fmt/Fprintf w "%+v" (.-Offset_ n)))

        (dumpNodeHeader w n)))

    (case [OASOP]
      (let [n (assert (* AssignOpStmt) n)]
        (fmt/Fprintf w "%+v-%+v" ^{:go/via [miniStmt miniNode]} (.Op n) (.-AsOp n))
        (dumpNodeHeader w n)))

    (case [OTYPE]
      (fmt/Fprintf w "%+v %+v" (.Op n) (.Sym n))
      (dumpNodeHeader w n)
      (return))

    (case [OCLOSURE]
      (fmt/Fprintf w "%+v" (.Op n))
      (dumpNodeHeader w n))

    (case [ODCLFUNC]
      ;; Func has many fields we don't want to print.
      ;; Bypass reflection and just print what we want.
      (let [n (assert (* Func) n)]
        (fmt/Fprintf w "%+v" ^{:go/via [miniNode]} (.Op n))
        (dumpNodeHeader w n)
        (let [fn n]
          (when (> (len (.-Dcl fn)) 0)
            (indent w depth)
            (fmt/Fprintf w "%+v-Dcl" ^{:go/via [miniNode]} (.Op n))
            (range [_ dcl (.-Dcl n)]
              (dumpNode w dcl (+ depth 1))))


          (when (> (len (.-ClosureVars fn)) 0)
            (indent w depth)
            (fmt/Fprintf w "%+v-ClosureVars" ^{:go/via [miniNode]} (.Op n))
            (range [_ cv (.-ClosureVars fn)]
              (dumpNode w cv (+ depth 1))))


          (when (> (len (.-Body fn)) 0)
            (indent w depth)
            (fmt/Fprintf w "%+v-body" ^{:go/via [miniNode]} (.Op n))
            (dumpNodes w (.-Body fn) (+ depth 1)))

          (return)))))


  (let [v (.Elem (reflect/ValueOf n))
      ^{:line 1150} t (.Elem (reflect/TypeOf n))
      ^{:line 1151} nf (.NumField t)]
    (for [i 0] (< i nf) (inc! i)
      (let [tf (.Field t i)
          ^{:line 1154} vf (.Field v i)]
        (when (!= (.-PkgPath tf) "")
          ;; skip unexported field - Interface will fail
          (continue))

        (switch (.Kind (.-Type tf))
          (case [reflect/Interface reflect/Ptr reflect/Slice]
            (when (.IsNil vf)
              (continue))))


        (let [name (strings/TrimSuffix (.-Name tf) "_")]
          ;; Do not bother with field name header lines for the
          ;; most common positional arguments: unary, binary expr,
          ;; index expr, send stmt, go and defer call expression.
          (switch name
            (case ["X" "Y" "Index" "Chan" "Value" "Call"]
              (set! name "")))

          (type-switch [val (.Interface vf)]
            (case [Node]
              (when (!= name "")
                (indent w depth)
                (fmt/Fprintf w "%+v-%s" (.Op n) name))

              (dumpNode w val (+ depth 1)))
            (case [Nodes]
              (when (== (len val) 0)
                (continue))

              (when (!= name "")
                (indent w depth)
                (fmt/Fprintf w "%+v-%s" (.Op n) name))

              (dumpNodes w val (+ depth 1)))
            (default
              (when (and (== (.Kind vf) reflect/Slice) (.Implements (.Elem (.Type vf)) nodeType))
                (when (== (.Len vf) 0)
                  (continue))

                (when (!= name "")
                  (indent w depth)
                  (fmt/Fprintf w "%+v-%s" (.Op n) name))

                (for [(values i n) (values 0 (.Len vf))] (< i n) (inc! i)
                  (dumpNode w (assert Node (.Interface (.Index vf i))) (+ depth 1)))))))))))






(go/var nodeType ((inst reflect/TypeFor Node)))

^{:go/end 1217} (go/func dumpNodes [^io/Writer w ^Nodes list ^int depth]
  (when (== (len list) 0)
    (fmt/Fprintf w " <nil>")
    (return))


  (range [_ n list]
    (dumpNode w n depth)))

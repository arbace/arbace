          (set! n (.-X nn))
          (continue)))
      (case [OPAREN]
        (let [nn (assert (* ParenExpr) nn)]
          (set! n (.-X nn))
          (continue)))
      (case [OCONVNOP]
        (let [nn (assert (* ConvExpr) nn)]
          (set! n (.-X nn))
          (continue)))
      (case [OINDEX]
        (let [nn (assert (* IndexExpr) nn)]
          (when (== (.Type (.-X nn)) nil)
            (base/Fatalf "OuterValue needs type for %v" (.-X nn)))

          (when (.IsArray (.Type (.-X nn)))
            (set! n (.-X nn))
            (continue)))))



    (return n)))




(in-ns 'go.cmd.compile.internal.ir) (go/file "cfg.go" :imports [])

(go/var



  ^{:line 11} [^{:doc "MaxStackVarSize is the maximum size variable which we will allocate on the stack.\nThis limit is for explicit variable declarations like \"var x T\" or \"x := ...\".\nNote: the flag smallframes can update this value.\n"} MaxStackVarSize (conv int64 (* 128 1024))]







  ^{:line 19} [^{:doc "MaxImplicitStackVarSize is the maximum size of implicit variables that we will allocate on the stack.\n  p := new(T)          allocating T on the stack\n  p := &T{}            allocating T on the stack\n  s := make([]T, n)    allocating [n]T on the stack\n  s := []byte(\"...\")   allocating [n]byte on the stack\nNote: the flag smallframes can update this value.\n"} MaxImplicitStackVarSize (conv int64 (* 64 1024))]





  ^{:line 25} [^{:doc "MaxSmallArraySize is the maximum size of an array which is considered small.\nSmall arrays will be initialized directly with a sequence of constant stores.\nLarge arrays will be initialized by copying from a static temp.\n256 bytes was chosen to minimize generated code + statictmp size.\n"} MaxSmallArraySize (conv int64 256)])

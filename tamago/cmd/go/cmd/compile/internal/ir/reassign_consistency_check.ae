(in-ns 'go.cmd.compile.internal.ir) (go/file "reassign_consistency_check.go" :imports [


    ^{:line 8} [base "cmd/compile/internal/base"]
    ^{:line 9} [src "cmd/internal/src"]
    ^{:line 10} [fmt "fmt"]
    ^{:line 11} [filepath "path/filepath"]
    ^{:line 12} [strings "strings"]])





^{:go/end 23} (go/func checkStaticValueResult "checkStaticValueResult compares the result from ReassignOracle.StaticValue\nwith the corresponding result from ir.StaticValue to make sure they agree.\nThis method is called only when turned on via build tag.\n" [^Node n ^Node newres]
  (let [oldres (StaticValue n)]
    (when (!= oldres newres)
      (base/Fatalf "%s: new/old static value disagreement on %v:\nnew=%v\nold=%v" (fmtFullPos (.Pos n)) n newres oldres))))






^{:go/end 33} (go/func checkReassignedResult "checkReassignedResult compares the result from ReassignOracle.Reassigned\nwith the corresponding result from ir.Reassigned to make sure they agree.\nThis method is called only when turned on via build tag.\n" [^{:tag (* Name)} n ^bool newres]
  (let [origres (Reassigned n)]
    (when (!= newres origres)
      (base/Fatalf "%s: new/old reassigned disagreement on %v (class %s) newres=%v oldres=%v" (fmtFullPos ^{:go/via [miniExpr miniNode]} (.Pos n)) n (.String (.-Class n)) newres origres))))




^{:go/end 46} (go/func fmtFullPos "fmtFullPos returns a verbose dump for pos p, including inlines.\n" ^string [^src/XPos p]
  (let [^strings/Builder sb (zero strings/Builder)
      ^{:line 38} sep ""]
    (.AllPos base/Ctxt p ^{:go/end 44} (fn [^src/Pos pos]
        (.WriteString sb sep)
        (set! sep "|")
        (let [file (filepath/Base (.Filename pos))]
          (fmt/Fprintf (addr sb) "%s:%d:%d" file ^{:go/via [lico]} (.Line pos) ^{:go/via [lico]} (.Col pos)))))

    (.String sb)))

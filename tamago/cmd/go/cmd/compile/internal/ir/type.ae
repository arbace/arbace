(in-ns 'go.cmd.compile.internal.ir) (go/file "type.go" :imports [


    ^{:line 8} [base "cmd/compile/internal/base"]
    ^{:line 9} [types "cmd/compile/internal/types"]
    ^{:line 10} [src "cmd/internal/src"]])


;; Calling TypeNode converts a *types.Type to a Node shell.


(go/type typeNode "A typeNode is a Node wrapper for type t.\n" (struct
    ^{:line 17} miniNode
    ^{:line 18 :tag (* types/Type)} typ))


^{:go/end 27} (go/func newTypeNode ^{:tag (* typeNode)} [^{:tag (* types/Type)} typ]
  (let [n (addr (lit typeNode :typ typ))]
    (set! ^{:go/via [miniNode]} (.-pos n) src/NoXPos)
    (set! ^{:go/via [miniNode]} (.-op n) OTYPE)
    ^{:go/via [miniNode]} (.SetTypecheck n 1)
    ^{:line 26} n))


^{:go/end 29} (go/method Type ^{:tag (* types/Type)} [^{:tag (* typeNode)} n] (.-typ n))
^{:go/end 30} (go/method Sym ^{:tag (* types/Sym)} [^{:tag (* typeNode)} n] (.Sym (.-typ n)))


^{:go/end 41} (go/func TypeNode "TypeNode returns the Node representing the type t.\n" ^Node [^{:tag (* types/Type)} t]
  (when [n (.Obj t)] (!= n nil)
    (when (!= (.Type n) t)
      (base/Fatalf "type skew: %v has type %v, but expected %v" n (.Type n) t))

    (return (assert (* Name) n)))

  (newTypeNode t))








(go/type DynamicType "A DynamicType represents a type expression whose exact type must be\ncomputed dynamically.\n\nTODO(adonovan): I think \"dynamic\" is a misnomer here; it's really a\ntype with free type parameters that needs to be instantiated to obtain\na ground type for which an rtype can exist.\n" (struct
    ^{:line 50} miniExpr





    ^{:line 56 :tag Node :doc "RType is an expression that yields a *runtime._type value\nrepresenting the asserted type.\n\nBUG(mdempsky): If ITab is non-nil, RType may be nil.\n"} RType








    ^{:line 65 :tag Node :doc "ITab is an expression that yields a *runtime.itab value\nrepresenting the asserted type within the assertee expression's\noriginal interface type.\n\nITab is only used for assertions (including type switches) from\nnon-empty interface type to a concrete (i.e., non-interface)\ntype. For all other assertions, ITab is nil.\n"} ITab))


^{:go/end 73} (go/func NewDynamicType ^{:tag (* DynamicType)} [^src/XPos pos ^Node rtype]
  (let [n (addr (lit DynamicType :RType rtype))]
    (set! ^{:go/via [miniExpr miniNode]} (.-pos n) pos)
    (set! ^{:go/via [miniExpr miniNode]} (.-op n) ODYNAMICTYPE)
    ^{:line 72} n))



^{:go/breaks [[7 92]] :go/end 93} (go/method ToStatic "ToStatic returns static type of dt if it is actually static.\n" ^Node [^{:tag (* DynamicType)} dt]
  (when (== ^{:go/via [miniExpr miniNode]} (.Typecheck dt) 0)
    (base/Fatalf "missing typecheck: %v" dt))

  (when (and (!= (.-RType dt) nil) (== (.Op (.-RType dt)) OADDR))
    (let [addr (assert (* AddrExpr) (.-RType dt))]
      (when (== (.Op (.-X addr)) OLINKSYMOFFSET)
        (return (TypeNode ^{:go/via [miniExpr]} (.Type dt))))))


  (when (and (!= (.-ITab dt) nil) (== (.Op (.-ITab dt)) OADDR))
    (let [addr (assert (* AddrExpr) (.-ITab dt))]
      (when (== (.Op (.-X addr)) OLINKSYMOFFSET)
        (return (TypeNode ^{:go/via [miniExpr]} (.Type dt))))))


  nil)

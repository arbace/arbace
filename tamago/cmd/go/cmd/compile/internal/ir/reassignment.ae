                (range [i lhs (.-Lhs defn)]
                  (when (== lhs n)
                    (set! rhs (aget (.-Rhs defn) i))
                    (break :FindRHS)))


                (base/FatalfAt ^{:go/via [miniStmt miniNode]} (.Pos defn) "%v missing from LHS of %v" n defn)))
            (default
              (return nil))))

        (when (== rhs nil)
          (base/FatalfAt (.Pos defn) "RHS is nil: %v" defn))


        (when [(values _ ok) (aget (.-singleDef ro) n)] (not ok)
          (return nil))


        ^{:line 231} rhs))))




^{:go/end 243} (go/method Reassigned "Reassigned method has the same semantics as the ir package function\nof the same name; see comments on [Reassigned] for more info.\n" ^bool [^{:tag (* ReassignOracle)} ro ^{:tag (* Name)} n]
  (let [(values _ ok) (aget (.-singleDef ro) n)
      ^{:line 238} result (not ok)]
    (when consistencyCheckEnabled
      (checkReassignedResult n result))

    ^{:line 242} result))









^{:go/end 254} (go/method FuncAssignments "FuncAssignments returns all known simple assignments to a func-typed\nvariable. For variables defined with := and a non-zero value, the\ndefining assignment is included. Returns nil if the variable is not\nfunc-typed, was invalidated (addr-taken, non-simple assignment,\ntoo many assignments), or has no tracked assignments. Assignments\ninside nested closures are accepted because the only alternative\nvalue is nil, which panics on call.\n" ^{:tag (slice (* AssignStmt))} [^{:tag (* ReassignOracle)} ro ^{:tag (* Name)} name]
  (aget (.-funcAssigns ro) (.Canonical name)))



^{:go/end 266} (go/func isNilAssign "isNilAssign reports whether as has a nil or absent RHS.\n" ^bool [^{:tag (* AssignStmt)} as]
  (when (== (.-Y as) nil)
    (return true))

  (let [y (.-Y as)]
    (while (== (.Op y) OCONVNOP)
      (set! y (.-X (assert (* ConvExpr) y))))

    (IsNil y)))

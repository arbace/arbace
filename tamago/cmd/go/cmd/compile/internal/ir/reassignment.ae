            false))

        (Any fn do)))))




^{:go/end 189} (go/method StaticValue "StaticValue method has the same semantics as the ir package function\nof the same name; see comments on [StaticValue].\n" ^Node [^{:tag (* ReassignOracle)} ro ^Node n]
  (let [arg n]
    (while true
      (when (== (.Op n) OCONVNOP)
        (set! n (.-X (assert (* ConvExpr) n)))
        (continue))


      (when (== (.Op n) OINLCALL)
        (set! n (.SingleResult (assert (* InlinedCallExpr) n)))
        (continue))


      (when (== (.Op n) OPAREN)
        (set! n (.-X (assert (* ParenExpr) n)))
        (continue))


      (let [n1 (.staticValue1 ro n)]
        (when (== n1 nil)
          (when consistencyCheckEnabled
            (checkStaticValueResult arg n))

          (return n))

        (set! n n1)))))



^{:go/end 232} (go/method staticValue1 ^Node [^{:tag (* ReassignOracle)} ro ^Node nn]
  (when (!= (.Op nn) ONAME)
    (return nil))

  (let [n (.Canonical (assert (* Name) nn))]
    (when (!= (.-Class n) PAUTO)
      (return nil))


    (let [defn (.-Defn n)]

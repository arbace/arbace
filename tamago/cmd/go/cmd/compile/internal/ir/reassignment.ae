(go/type ReassignOracle "A ReassignOracle efficiently answers queries about whether local\nvariables are reassigned. This helper works by looking for function\nparams and short variable declarations (e.g.\nhttps://go.dev/ref/spec#Short_variable_declarations) that are\nneither address taken nor subsequently re-assigned. It is intended\nto operate much like \"ir.StaticValue\" and \"ir.Reassigned\", but in a\nway that does just a single walk of the containing function (as\nopposed to a new walk on every call).\n" (struct
    ^{:line 21 :tag (* Func)} fn


    ^{:line 24 :tag (map (* Name) Node) :doc "maps candidate name to its defining assignment (or\nfor params, defining func).\n"} singleDef








    ^{:line 33 :tag (map (* Name) (slice (* AssignStmt))) :doc "funcAssigns tracks all known simple assignments (OAS) to\nfunc-typed PAUTO variables. Only func-typed variables are\ntracked because this data is used exclusively for callee\nresolution in escape analysis. Deletion means the candidate was\ninvalidated (e.g., addr-taken, non-simple assignment form, or too\nmany assignments). Assignments inside nested closures are accepted\nbecause the only alternative value is nil, which panics on call.\n"} funcAssigns))






^{:go/end 158} (go/method Init "Init initializes the oracle based on the IR in function fn, laying\nthe groundwork for future calls to the StaticValue and Reassigned\nmethods. If the fn's IR is subsequently modified, Init must be\ncalled again.\n" [^{:tag (* ReassignOracle)} ro ^{:tag (* Func)} fn]
  (set! (.-fn ro) fn)

  ;; Collect candidate map. Start by adding function parameters
  ;; explicitly.
  (set! (.-singleDef ro) (make (map (* Name) Node)))
  (set! (.-funcAssigns ro) (make (map (* Name) (slice (* AssignStmt)))))
  (let [sig (.Type fn)
      ^{:line 48} numParams (+ (.NumRecvs sig) (.NumParams sig))]
    (range [_ param (subslice (.-Dcl fn) _ numParams)]
      (when (IsBlank param)
        (continue))

      ;; For params, use func itself as defining node.
      (aset (.-singleDef ro) param fn))


    ;; Walk the function body to discover any locals assigned
    ;; via ":=" syntax (e.g. "a := <expr>").
    (let [^{:tag (func [^Node n] [bool])} findLocals (zero (func [^Node n] [bool]))]
      (set! findLocals ^{:go/breaks [[3 81]] :go/end 82} (fn ^bool [^Node n]
          (if [(values nn ok) (assert (* Name) n)] ok
            (when (and (== (.-Class nn) PAUTO) (not (.Addrtaken nn)))
              (let [isFunc (== (.Kind ^{:go/via [miniExpr]} (.Type nn)) types/TFUNC)]
                (if (== (.-Defn nn) nil)
                  ;; Bare declaration (e.g., "var f func()").
                  (when isFunc
                    (aset (.-funcAssigns ro) nn nil))

                  (if [(values _ ok) (assert (* AssignStmt) (.-Defn nn))] ok (do
                      (aset (.-singleDef ro) nn (.-Defn nn))
                      (when isFunc
                        (aset (.-funcAssigns ro) nn nil)))


                    (aset (.-singleDef ro) nn (.-Defn nn))))))


            (when [(values nn ok) (assert (* ClosureExpr) n)] ok
              (Any (.-Func nn) findLocals)))

          false))

      (Any fn findLocals)

      (let [outerName ^{:go/end 94} (fn ^{:tag (* Name)} [^Node x]
            (when (== x nil)
              (return nil))

            ^{:go/breaks [[3 93]]} (let [(values n ok) (assert (* Name) (OuterValue x))]
              (when ok
                (return (.Canonical n)))

              nil))


          ;; pruneIfNeeded examines node nn appearing on the left hand side
          ;; of assignment statement asn to see if it contains a reassignment
          ;; to any nodes in our candidate maps; if a reassignment is found,
          ;; the corresponding name is deleted.
          ^{:line 100} pruneIfNeeded ^{:go/end 128} (fn [^Node nn ^Node asn]
            (let [oname (outerName nn)]
              (when (== oname nil)
                (return))

              (when [(values defn ok) (aget (.-singleDef ro) oname)] ok
                ;; any assignment to a param invalidates the entry.
                (let [paramAssigned (== (.-Class oname) PPARAM)
                    ;; assignment to local ok iff assignment is its orig def.
                    ^{:line 109} localAssigned (and (== (.-Class oname) PAUTO) (!= asn defn))]
                  (when (or paramAssigned localAssigned)
                    ;; We found an assignment to name N that doesn't
                    ;; correspond to its original definition; remove
                    ;; from candidates.
                    (delete (.-singleDef ro) oname))))


              (when [(values _ ok) (aget (.-funcAssigns ro) oname)] ok
                (let [(values as isOAS) (assert (* AssignStmt) asn)]
                  (cond (and isOAS (isNilAssign as)) (do)
                    ;; Zero-value assignment (nil, bare decl), skip.
                    (not isOAS)
                    ;; Not a simple assignment: invalidate.
                    (delete (.-funcAssigns ro) oname) :else

                    (aset (.-funcAssigns ro) oname (append (aget (.-funcAssigns ro) oname) as)))))))




          ;; Prune away anything that looks assigned. This code modeled after
          ;; similar code in ir.Reassigned; any changes there should be made
          ;; here as well.
          ^{:line 133 :tag (func [^Node n] [bool])} do (zero (func [^Node n] [bool]))]
        (set! do ^{:go/breaks [[3 155]] :go/end 156} (fn ^bool [^Node n]
            (switch (.Op n)
              (case [OAS]

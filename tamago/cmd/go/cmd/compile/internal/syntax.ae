(ns go.cmd.compile.internal.syntax
  (:require [arbace.go :as go]))

(go/package syntax
  :path "cmd/compile/internal/syntax"
  :files ["branches.go" "dumper.go" "nodes.go" "operator_string.go" "parser.go" "pos.go" "positions.go" "printer.go" "scanner.go" "source.go" "syntax.go" "testing.go" "token_string.go" "tokens.go" "type.go" "walk.go"]
  :positions :lines)

(load "syntax/branches")
(load "syntax/dumper")
(load "syntax/nodes")
(load "syntax/operator_string")
(load "syntax/parser")
(load "syntax/pos")
(load "syntax/positions")
(load "syntax/printer")
(load "syntax/scanner")
(load "syntax/source")
(load "syntax/syntax")
(load "syntax/testing")
(load "syntax/token_string")
(load "syntax/tokens")
(load "syntax/type")
(load "syntax/walk")

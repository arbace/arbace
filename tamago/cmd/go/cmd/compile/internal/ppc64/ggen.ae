(in-ns 'go.cmd.compile.internal.ppc64) (go/file "ggen.go" :imports [


    ^{:line 8} [base "cmd/compile/internal/base"]
    ^{:line 9} [ir "cmd/compile/internal/ir"]
    ^{:line 10} [objw "cmd/compile/internal/objw"]
    ^{:line 11} [types "cmd/compile/internal/types"]
    ^{:line 12} [obj "cmd/internal/obj"]
    ^{:line 13} [ppc64 "cmd/internal/obj/ppc64"]])


^{:go/end 46} (go/func zerorange ^{:tag (* obj/Prog)} [^{:tag (* objw/Progs)} pp ^{:tag (* obj/Prog)} p ^int64 off ^int64 cnt ^{:tag (* uint32)} _]
  (when (== cnt 0)
    (return p))

  (cond (< cnt (conv int64 (* 4 types/PtrSize)))
    (for [i (conv int64 0)] (< i cnt) (set! i + (conv int64 types/PtrSize))
      (set! p (.Append pp p ppc64/AMOVD obj/TYPE_REG ppc64/REGZERO 0 obj/TYPE_MEM ppc64/REGSP (+ ^{:go/via [Arch]} (.-FixedFrameSize (.-Arch base/Ctxt)) off i))))

    (<= cnt (conv int64 (* 128 types/PtrSize))) (do
      (set! p (.Append pp p ppc64/AADD obj/TYPE_CONST 0 (- (+ ^{:go/via [Arch]} (.-FixedFrameSize (.-Arch base/Ctxt)) off) 8) obj/TYPE_REG ppc64/REGRT1 0))
      (set! (.-Reg p) ppc64/REGSP)
      (set! p (.Append pp p obj/ADUFFZERO obj/TYPE_NONE 0 0 obj/TYPE_MEM 0 0))
      (set! (.-Name (.-To p)) obj/NAME_EXTERN)
      (set! (.-Sym (.-To p)) (.-Duffzero ir/Syms))
      (set! (.-Offset (.-To p)) (* 4 (- 128 (/ cnt (conv int64 types/PtrSize)))))) :else
    (do
      (set! p (.Append pp p ppc64/AMOVD obj/TYPE_CONST 0 (- (+ ^{:go/via [Arch]} (.-FixedFrameSize (.-Arch base/Ctxt)) off) 8) obj/TYPE_REG ppc64/REGTMP 0))
      (set! p (.Append pp p ppc64/AADD obj/TYPE_REG ppc64/REGTMP 0 obj/TYPE_REG ppc64/REGRT1 0))
      (set! (.-Reg p) ppc64/REGSP)
      (set! p (.Append pp p ppc64/AMOVD obj/TYPE_CONST 0 cnt obj/TYPE_REG ppc64/REGTMP 0))
      (set! p (.Append pp p ppc64/AADD obj/TYPE_REG ppc64/REGTMP 0 obj/TYPE_REG ppc64/REGRT2 0))
      (set! (.-Reg p) ppc64/REGRT1)
      (set! p (.Append pp p ppc64/AMOVDU obj/TYPE_REG ppc64/REGZERO 0 obj/TYPE_MEM ppc64/REGRT1 (conv int64 types/PtrSize)))
      (let [p1 p]
        (set! p (.Append pp p ppc64/ACMP obj/TYPE_REG ppc64/REGRT1 0 obj/TYPE_REG ppc64/REGRT2 0))
        (set! p (.Append pp p ppc64/ABNE obj/TYPE_NONE 0 0 obj/TYPE_BRANCH 0 0))
        (.SetTarget (.-To p) p1))))


  ^{:line 45} p)


^{:go/end 54} (go/func ginsnop ^{:tag (* obj/Prog)} [^{:tag (* objw/Progs)} pp]
  ;; Generate the preferred hardware nop: ori 0,0,0
  (let [p (.Prog pp ppc64/AOR)]
    (set! (.-From p) (lit obj/Addr :Type obj/TYPE_CONST :Offset 0))
    (set! (.-To p) (lit obj/Addr :Type obj/TYPE_REG :Reg ppc64/REG_R0))
    ^{:line 53} p))

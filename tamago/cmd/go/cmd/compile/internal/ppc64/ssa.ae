    ^{:line 2080} [ssa/BlockPPC64NE (lit _ ppc64/ABNE ppc64/ABEQ false false)]

    ^{:line 2082} [ssa/BlockPPC64LT (lit _ ppc64/ABLT ppc64/ABGE false false)]
    ^{:line 2083} [ssa/BlockPPC64GE (lit _ ppc64/ABGE ppc64/ABLT false false)]
    ^{:line 2084} [ssa/BlockPPC64LE (lit _ ppc64/ABLE ppc64/ABGT false false)]
    ^{:line 2085} [ssa/BlockPPC64GT (lit _ ppc64/ABGT ppc64/ABLE false false)]

    ;; TODO: need to work FP comparisons into block jumps
    ^{:line 2088} [ssa/BlockPPC64FLT (lit _ ppc64/ABLT ppc64/ABGE false false)]
    ^{:line 2089} [ssa/BlockPPC64FGE (lit _ ppc64/ABGT ppc64/ABLT true true)] ; GE = GT or EQ; !GE = LT or UN
    ^{:line 2090} [ssa/BlockPPC64FLE (lit _ ppc64/ABLT ppc64/ABGT true true)] ; LE = LT or EQ; !LE = GT or UN
    ^{:line 2091} [ssa/BlockPPC64FGT (lit _ ppc64/ABGT ppc64/ABLE false false)]))


^{:go/end 2143} (go/func ssaGenBlock [^{:tag (* ssagen/State)} s ^{:tag (* ssa/Block)} b ^{:tag (* ssa/Block)} next]
  (switch (.-Kind b)
    (case [ssa/BlockPlain ssa/BlockDefer]
      (when (!= (.Block (aget (.-Succs b) 0)) next)
        (let [p (.Prog s obj/AJMP)]
          (set! (.-Type (.-To p)) obj/TYPE_BRANCH)
          (set! (.-Branches s) (append (.-Branches s) (lit ssagen/Branch :P p :B (.Block (aget (.-Succs b) 0))))))))

    (case [ssa/BlockExit ssa/BlockRetJmp])
    (case [ssa/BlockRet]
      (.Prog s obj/ARET))

    (case [ssa/BlockPPC64EQ ssa/BlockPPC64NE
        ^{:line 2107} ssa/BlockPPC64LT ssa/BlockPPC64GE
        ^{:line 2108} ssa/BlockPPC64LE ssa/BlockPPC64GT
        ^{:line 2109} ssa/BlockPPC64FLT ssa/BlockPPC64FGE
        ^{:line 2110} ssa/BlockPPC64FLE ssa/BlockPPC64FGT]
      (let [jmp (aget blockJump (.-Kind b))]
        (switch next
          (case [(.Block (aget (.-Succs b) 0))]
            (.Br s (.-invasm jmp) (.Block (aget (.-Succs b) 1)))
            (when (.-invasmun jmp)
              ;; TODO: The second branch is probably predict-not-taken since it is for FP unordered
              (.Br s ppc64/ABVS (.Block (aget (.-Succs b) 1)))))

          (case [(.Block (aget (.-Succs b) 1))]
            (.Br s (.-asm jmp) (.Block (aget (.-Succs b) 0)))
            (when (.-asmeq jmp)
              (.Br s ppc64/ABEQ (.Block (aget (.-Succs b) 0)))))

          (default
            (if (!= (.-Likely b) ssa/BranchUnlikely) (do
                (.Br s (.-asm jmp) (.Block (aget (.-Succs b) 0)))
                (when (.-asmeq jmp)
                  (.Br s ppc64/ABEQ (.Block (aget (.-Succs b) 0))))

                (.Br s obj/AJMP (.Block (aget (.-Succs b) 1))))
              (do
                (.Br s (.-invasm jmp) (.Block (aget (.-Succs b) 1)))
                (when (.-invasmun jmp)
                  ;; TODO: The second branch is probably predict-not-taken since it is for FP unordered
                  (.Br s ppc64/ABVS (.Block (aget (.-Succs b) 1))))

                (.Br s obj/AJMP (.Block (aget (.-Succs b) 0)))))))))


    (default
      (.Fatalf b "branch not implemented: %s" (.LongString b)))))



^{:go/end 2154} (go/func loadRegResult ^{:tag (* obj/Prog)} [^{:tag (* ssagen/State)} s ^{:tag (* ssa/Func)} f ^{:tag (* types/Type)} t ^int16 reg ^{:tag (* ir/Name)} n ^int64 off]
  (let [p (.Prog s (loadByType t))]
    (set! (.-Type (.-From p)) obj/TYPE_MEM)
    (set! (.-Name (.-From p)) obj/NAME_AUTO)
    (set! (.-Sym (.-From p)) (.Linksym n))
    (set! (.-Offset (.-From p)) (+ (.FrameOffset n) off))
    (set! (.-Type (.-To p)) obj/TYPE_REG)
    (set! (.-Reg (.-To p)) reg)
    ^{:line 2153} p))


^{:go/end 2162} (go/func spillArgReg ^{:tag (* obj/Prog)} [^{:tag (* objw/Progs)} pp ^{:tag (* obj/Prog)} p ^{:tag (* ssa/Func)} f ^{:tag (* types/Type)} t ^int16 reg ^{:tag (* ir/Name)} n ^int64 off]
  (set! p (.Append pp p (storeByType t) obj/TYPE_REG reg 0 obj/TYPE_MEM 0 (+ (.FrameOffset n) off)))
  (set! (.-Name (.-To p)) obj/NAME_PARAM)
  (set! (.-Sym (.-To p)) (.Linksym n))
  (set! (.-Pos p) (.WithNotStmt (.-Pos p)))
  ^{:line 2161} p)

^{:go/end 80} (go/func loadByType "loadByType returns the load instruction of the given type.\n" ^obj/As [^{:tag (* types/Type)} t]
  (if (.IsFloat t)
    (switch (.Size t)
      (case [4]
        (return ppc64/AFMOVS))
      (case [8]
        (return ppc64/AFMOVD)))


    (switch (.Size t)
      (case [1]
        (if (.IsSigned t)
          (return ppc64/AMOVB)

          (return ppc64/AMOVBZ)))

      (case [2]
        (if (.IsSigned t)
          (return ppc64/AMOVH)

          (return ppc64/AMOVHZ)))

      (case [4]
        (if (.IsSigned t)
          (return ppc64/AMOVW)

          (return ppc64/AMOVWZ)))

      (case [8]
        (return ppc64/AMOVD))))


  (panic "bad load type"))



^{:go/end 104} (go/func storeByType "storeByType returns the store instruction of the given type.\n" ^obj/As [^{:tag (* types/Type)} t]
  (if (.IsFloat t)
    (switch (.Size t)
      (case [4]
        (return ppc64/AFMOVS))
      (case [8]
        (return ppc64/AFMOVD)))


    (switch (.Size t)
      (case [1]
        (return ppc64/AMOVB))
      (case [2]
        (return ppc64/AMOVH))
      (case [4]
        (return ppc64/AMOVW))
      (case [8]
        (return ppc64/AMOVD))))


  (panic "bad store type"))



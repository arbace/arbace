(in-ns 'go.cmd.compile.internal.ppc64) (go/file "opt.go" :imports [])



(go/const "Many Power ISA arithmetic and logical instructions come in four\nstandard variants. These bits let us map between variants.\n"
  ^{:line 10} [^{:val 1} V_CC (<< 1 0)] ; xCC (affect CR field 0 flags)
  ^{:line 11} [^{:val 2} V_V (<< 1 1)]) ; xV (affect SO and OV flags)

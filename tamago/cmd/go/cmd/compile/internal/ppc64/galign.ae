(in-ns 'go.cmd.compile.internal.ppc64) (go/file "galign.go" :imports [


    ^{:line 8} [ssagen "cmd/compile/internal/ssagen"]
    ^{:line 9} [ppc64 "cmd/internal/obj/ppc64"]
    ^{:line 10} [buildcfg "internal/buildcfg"]])


^{:go/end 29} (go/func Init [^{:tag (* ssagen/ArchInfo)} arch]
  (set! (.-LinkArch arch) (addr ppc64/Linkppc64))
  (when (== buildcfg/GOARCH "ppc64le")
    (set! (.-LinkArch arch) (addr ppc64/Linkppc64le)))

  (set! (.-REGSP arch) ppc64/REGSP)
  (set! (.-MAXWIDTH arch) (<< 1 50))

  (set! (.-ZeroRange arch) zerorange)
  (set! (.-Ginsnop arch) ginsnop)

  (set! (.-SSAMarkMoves arch) ssaMarkMoves)
  (set! (.-SSAGenValue arch) ssaGenValue)
  (set! (.-SSAGenBlock arch) ssaGenBlock)
  (set! (.-LoadRegResult arch) loadRegResult)
  (set! (.-SpillArgReg arch) spillArgReg))

            ;; Check all the children.
            (ir/DoChildren n do)
            false))


        ;; Run the analysis over the whole body.
        (range [_ stmt (.-Body fn)]
          (go/call do stmt))


        ;; Process accumulated info to find slice variables
        ;; that we can allocate on the stack.
        (range [_ s (.-Dcl fn)]

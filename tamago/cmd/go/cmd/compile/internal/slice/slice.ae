^{:go/end 481} (go/func argLeak "argLeak reports if the idx'th argument to the call n escapes anywhere\n(to the heap, another argument, return value, etc.)\nIf unknown returns true.\n" ^bool [^{:tag (* ir/CallExpr)} n ^int idx]

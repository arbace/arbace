            (let [move (ir/NewMoveToHeapExpr (.Pos (.-transition i)) (.-s i))]
              (when (.-capUsed i)
                (set! (.-PreserveCapacity move) true))

              (set! (.-RType move) (reflectdata/AppendElemRType (.Pos (.-transition i)) (aget (.-appends i) 0)))
              ^{:go/via [miniExpr]} (.SetType move ^{:go/via [miniExpr]} (.Type (.-s i)))
              ^{:go/via [miniExpr miniNode]} (.SetTypecheck move 1)
              (let [as (ir/NewAssignStmt (.Pos (.-transition i)) (.-s i) move)]

    (.WriteUintptr (.Field c "KeysOff") (conv uint64 keysOff))
    (.WriteUintptr (.Field c "KeyStride") (conv uint64 keyStride))
    (.WriteUintptr (.Field c "ElemsOff") (conv uint64 elemsOff))
    (.WriteUintptr (.Field c "ElemStride") (conv uint64 elemStride))

^{:go/end 111} (go/func MapGroupType "MapGroupType makes the map slot group type given the type of the map.\n" ^{:tag (* types/Type)} [^{:tag (* types/Type)} t]
  (when (!= (.-Group (.MapType t)) nil)
    (return (.-Group (.MapType t))))


  ;; Builds a type representing a group structure for the given map type.
  ;; This type is not visible to users, we include it so we can generate
  ;; a correct GC program for it.
  ;;
  ;; Make sure this stays in sync with internal/runtime/maps/group.go.

  (let [keytype (.Key t)
      ^{:line 32} elemtype (.Elem t)]
    (types/CalcSize keytype)
    (types/CalcSize elemtype)
    (when (> (.Size keytype) abi/MapMaxKeyBytes)
      (set! keytype (types/NewPtr keytype)))

    (when (> (.Size elemtype) abi/MapMaxElemBytes)
      (set! elemtype (types/NewPtr elemtype)))


    (let [^{:tag (slice (* types/Field))} fields (zero (slice (* types/Field)))]
      (if ^{:go/via [Flags]} (.-MapSplitGroup buildcfg/Experiment)
        ;; Split layout (KKKKVVVV):
        ;; type group struct {
        ;;     ctrl  uint64
        ;;     keys  [abi.MapGroupSlots]keyType
        ;;     elems [abi.MapGroupSlots]elemType
        ;; }
        (let [keyArr (types/NewArray keytype abi/MapGroupSlots)]
          (.SetNoalg keyArr true)

          (let [elemArr (types/NewArray elemtype abi/MapGroupSlots)]
            (.SetNoalg elemArr true)

            (set! fields (lit (slice (* types/Field))
                (makefield "ctrl" (aget types/Types types/TUINT64))
                (makefield "keys" keyArr)
                (makefield "elems" elemArr)))))


        ;; Interleaved slot layout (KVKVKVKV):
        ;; type group struct {
        ;;     ctrl  uint64
        ;;     slots [abi.MapGroupSlots]struct {
        ;;         key  keyType
        ;;         elem elemType
        ;;     }
        ;; }
        (let [slotFields (lit (slice (* types/Field))
              (makefield "key" keytype)
              (makefield "elem" elemtype))

            ^{:line 74} slot (types/NewStruct slotFields)]
          (.SetNoalg slot true)

          (let [slotArr (types/NewArray slot abi/MapGroupSlots)]
            (.SetNoalg slotArr true)

            (set! fields (lit (slice (* types/Field))
                (makefield "ctrl" (aget types/Types types/TUINT64))
                (makefield "slots" slotArr))))))



      (let [group (types/NewStruct fields)]
        (.SetNoalg group true)
        (types/CalcSize group)


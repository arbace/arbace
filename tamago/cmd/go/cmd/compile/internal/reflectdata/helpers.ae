(in-ns 'go.cmd.compile.internal.reflectdata) (go/file "helpers.go" :imports [


    ^{:line 8} [base "cmd/compile/internal/base"]
    ^{:line 9} [ir "cmd/compile/internal/ir"]
    ^{:line 10} [types "cmd/compile/internal/types"]
    ^{:line 11} [src "cmd/internal/src"]])


^{:go/breaks [[4 19]] :go/end 20} (go/func hasRType ^bool [^ir/Node n ^ir/Node rtype ^string fieldName]
  (when (!= rtype nil)
    (return true))


  false)



^{:go/end 25} (go/func assertOp "assertOp asserts that n is an op.\n" [^ir/Node n ^ir/Op op]
  (base/AssertfAt (== (.Op n) op) (.Pos n) "want %v, have %v" op n))



^{:go/end 30} (go/func assertOp2 "assertOp2 asserts that n is an op1 or op2.\n" [^ir/Node n ^ir/Op op1 ^ir/Op op2]
  (base/AssertfAt (or (== (.Op n) op1) (== (.Op n) op2)) (.Pos n) "want %v or %v, have %v" op1 op2 n))




^{:go/end 37} (go/func kindRType "kindRType asserts that typ has the given kind, and returns an\nexpression that yields the *runtime._type value representing typ.\n" ^ir/Node [^src/XPos pos ^{:tag (* types/Type)} typ ^types/Kind k]
  (base/AssertfAt (== (.Kind typ) k) pos "want %v type, have %v" k typ)
  (TypePtrAt pos typ))




^{:go/end 43} (go/func mapRType "mapRType asserts that typ is a map type, and returns an expression\nthat yields the *runtime._type value representing typ.\n" ^ir/Node [^src/XPos pos ^{:tag (* types/Type)} typ]
  (kindRType pos typ types/TMAP))




^{:go/end 49} (go/func chanRType "chanRType asserts that typ is a map type, and returns an expression\nthat yields the *runtime._type value representing typ.\n" ^ir/Node [^src/XPos pos ^{:tag (* types/Type)} typ]
  (kindRType pos typ types/TCHAN))





^{:go/end 57} (go/func sliceElemRType "sliceElemRType asserts that typ is a slice type, and returns an\nexpression that yields the *runtime._type value representing typ's\nelement type.\n" ^ir/Node [^src/XPos pos ^{:tag (* types/Type)} typ]
  (base/AssertfAt (.IsSlice typ) pos "want slice type, have %v" typ)
  (TypePtrAt pos (.Elem typ)))





^{:go/end 65} (go/func concreteRType "concreteRType asserts that typ is not an interface type, and\nreturns an expression that yields the *runtime._type value\nrepresenting typ.\n" ^ir/Node [^src/XPos pos ^{:tag (* types/Type)} typ]
  (base/AssertfAt (not (.IsInterface typ)) pos "want non-interface type, have %v" typ)
  (TypePtrAt pos typ))





^{:go/end 76} (go/func AppendElemRType "AppendElemRType asserts that n is an \"append\" operation, and\nreturns an expression that yields the *runtime._type value\nrepresenting the result slice type's element type.\n" ^ir/Node [^src/XPos pos ^{:tag (* ir/CallExpr)} n]
  (assertOp n ir/OAPPEND)
  (when (hasRType n (.-RType n) "RType")
    (return (.-RType n)))

  (sliceElemRType pos ^{:go/via [miniExpr]} (.Type n)))






^{:go/end 93} (go/func CompareRType "CompareRType asserts that n is a comparison (== or !=) operation\nbetween expressions of interface and non-interface type, and\nreturns an expression that yields the *runtime._type value\nrepresenting the non-interface type.\n" ^ir/Node [^src/XPos pos ^{:tag (* ir/BinaryExpr)} n]
  (assertOp2 n ir/OEQ ir/ONE)
  (base/AssertfAt (!= (.IsInterface (.Type (.-X n))) (.IsInterface (.Type (.-Y n)))) ^{:go/via [miniExpr miniNode]} (.Pos n) "expect mixed interface and non-interface, have %L and %L" (.-X n) (.-Y n))
  (when (hasRType n (.-RType n) "RType")
    (return (.-RType n)))

  (let [typ (.Type (.-X n))]
    (when (.IsInterface typ)
      (set! typ (.Type (.-Y n))))

    (concreteRType pos typ)))









^{:go/end 116} (go/func ConvIfaceTypeWord "ConvIfaceTypeWord asserts that n is conversion to interface type,\nand returns an expression that yields the *runtime._type or\n*runtime.itab value necessary for implementing the conversion.\n\n  - *runtime._type for the destination type, for I2I conversions\n  - *runtime.itab, for T2I conversions\n  - *runtime._type for the source type, for T2E conversions\n" ^ir/Node [^src/XPos pos ^{:tag (* ir/ConvExpr)} n]
  (assertOp n ir/OCONVIFACE)
  (let [(values src dst) (values (.Type (.-X n)) ^{:go/via [miniExpr]} (.Type n))]
    (base/AssertfAt (.IsInterface dst) ^{:go/via [miniExpr miniNode]} (.Pos n) "want interface type, have %L" n)
    (when (hasRType n (.-TypeWord n) "TypeWord")
      (return (.-TypeWord n)))

    (when (.IsEmptyInterface dst)
      (return (concreteRType pos src))) ; direct eface construction

    (when (not (.IsInterface src))
      (return (ITabAddrAt pos src dst))) ; direct iface construction

    (TypePtrAt pos dst))) ; convI2I






^{:go/end 128} (go/func ConvIfaceSrcRType "ConvIfaceSrcRType asserts that n is a conversion from\nnon-interface type to interface type, and\nreturns an expression that yields the *runtime._type for copying\nthe convertee value to the heap.\n" ^ir/Node [^src/XPos pos ^{:tag (* ir/ConvExpr)} n]
  (assertOp n ir/OCONVIFACE)
  (when (hasRType n (.-SrcRType n) "SrcRType")
    (return (.-SrcRType n)))

  (concreteRType pos (.Type (.-X n))))





^{:go/end 139} (go/func CopyElemRType "CopyElemRType asserts that n is a \"copy\" operation, and returns an\nexpression that yields the *runtime._type value representing the\ndestination slice type's element type.\n" ^ir/Node [^src/XPos pos ^{:tag (* ir/BinaryExpr)} n]
  (assertOp n ir/OCOPY)
  (when (hasRType n (.-RType n) "RType")
    (return (.-RType n)))

  (sliceElemRType pos (.Type (.-X n))))





^{:go/end 150} (go/func DeleteMapRType "DeleteMapRType asserts that n is a \"delete\" operation, and returns\nan expression that yields the *runtime._type value representing the\nmap type.\n" ^ir/Node [^src/XPos pos ^{:tag (* ir/CallExpr)} n]
  (assertOp n ir/ODELETE)
  (when (hasRType n (.-RType n) "RType")
    (return (.-RType n)))

  (mapRType pos (.Type (aget (.-Args n) 0))))





^{:go/end 161} (go/func IndexMapRType "IndexMapRType asserts that n is a map index operation, and returns\nan expression that yields the *runtime._type value representing the\nmap type.\n" ^ir/Node [^src/XPos pos ^{:tag (* ir/IndexExpr)} n]
  (assertOp n ir/OINDEXMAP)
  (when (hasRType n (.-RType n) "RType")
    (return (.-RType n)))

  (mapRType pos (.Type (.-X n))))





^{:go/end 172} (go/func MakeChanRType "MakeChanRType asserts that n is a \"make\" operation for a channel\ntype, and returns an expression that yields the *runtime._type\nvalue representing that channel type.\n" ^ir/Node [^src/XPos pos ^{:tag (* ir/MakeExpr)} n]
  (assertOp n ir/OMAKECHAN)
  (when (hasRType n (.-RType n) "RType")
    (return (.-RType n)))

  (chanRType pos ^{:go/via [miniExpr]} (.Type n)))





^{:go/end 183} (go/func MakeMapRType "MakeMapRType asserts that n is a \"make\" operation for a map type,\nand returns an expression that yields the *runtime._type value\nrepresenting that map type.\n" ^ir/Node [^src/XPos pos ^{:tag (* ir/MakeExpr)} n]
  (assertOp n ir/OMAKEMAP)
  (when (hasRType n (.-RType n) "RType")
    (return (.-RType n)))

  (mapRType pos ^{:go/via [miniExpr]} (.Type n)))





^{:go/end 194} (go/func MakeSliceElemRType "MakeSliceElemRType asserts that n is a \"make\" operation for a slice\ntype, and returns an expression that yields the *runtime._type\nvalue representing that slice type's element type.\n" ^ir/Node [^src/XPos pos ^{:tag (* ir/MakeExpr)} n]
  (assertOp2 n ir/OMAKESLICE ir/OMAKESLICECOPY)
  (when (hasRType n (.-RType n) "RType")
    (return (.-RType n)))

  (sliceElemRType pos ^{:go/via [miniExpr]} (.Type n)))





^{:go/end 205} (go/func RangeMapRType "RangeMapRType asserts that n is a \"range\" loop over a map value,\nand returns an expression that yields the *runtime._type value\nrepresenting that map type.\n" ^ir/Node [^src/XPos pos ^{:tag (* ir/RangeStmt)} n]
  (assertOp n ir/ORANGE)
  (when (hasRType n (.-RType n) "RType")
    (return (.-RType n)))

  (mapRType pos (.Type (.-X n))))





^{:go/end 216} (go/func UnsafeSliceElemRType "UnsafeSliceElemRType asserts that n is an \"unsafe.Slice\" operation,\nand returns an expression that yields the *runtime._type value\nrepresenting the result slice type's element type.\n" ^ir/Node [^src/XPos pos ^{:tag (* ir/BinaryExpr)} n]
  (assertOp n ir/OUNSAFESLICE)
  (when (hasRType n (.-RType n) "RType")
    (return (.-RType n)))

  (sliceElemRType pos ^{:go/via [miniExpr]} (.Type n)))

            (case [(* syntax/FuncLit)]
              (let [(values sig _) (assert (* types2/Signature) (.-Type (aget (.-Types info) n)))]
                (when (== sig nil)
                  (let [tv ^{:go/via [expr typeAndValue]} (.GetTypeInfo n)]
                    (set! sig (assert (* types2/Signature) (.-Type tv)))))

                (rewriteFunc pkg info (.-Type n) (.-Body n) sig ri)

        (case [(* syntax/CaseClause)]
          (range [i s (.-Body n)]
            (aset (.-Body n) i (.editStmt r s))))

        (case [(* syntax/CommClause)]
          (range [i s (.-Body n)]
            (aset (.-Body n) i (.editStmt r s))))

        (case [(* syntax/LabeledStmt)]
          (set! (.-Stmt n) (.editStmt r (.-Stmt n)))))


      ;; Pop n.
      (when (and (> (len (.-forStack r)) 0) (== (aget (.-stack r) (- (len (.-stack r)) 1)) (.-nfor (aget (.-forStack r) (- (len (.-forStack r)) 1)))))

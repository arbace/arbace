(in-ns 'go.cmd.compile.internal.arm64) (go/file "ggen.go" :imports [


    ^{:line 8} [objw "cmd/compile/internal/objw"]
    ^{:line 9} [obj "cmd/internal/obj"]
    ^{:line 10} [arm64 "cmd/internal/obj/arm64"]])


^{:go/end 20} (go/func padframe ^int64 [^int64 frame]
  ;; arm64 requires that the frame size (not counting saved FP&LR)
  ;; be 16 bytes aligned. If not, pad it.
  (when (!= (% frame 16) 0)
    (set! frame + (- 16 (% frame 16))))

  ^{:line 19} frame)


^{:go/end 38} (go/func zerorange ^{:tag (* obj/Prog)} [^{:tag (* objw/Progs)} pp ^{:tag (* obj/Prog)} p ^int64 off ^int64 cnt ^{:tag (* uint32)} _]
  (when (!= (% cnt 8) 0)
    (panic "zeroed region not aligned"))

  (set! off + 8) ; return address was ignored in offset calculation
  (while (and (>= cnt 16) (< off 512))
    (set! p (.Append pp p arm64/ASTP obj/TYPE_REGREG arm64/REGZERO arm64/REGZERO obj/TYPE_MEM arm64/REGSP off))
    (set! off + 16)
    (set! cnt - 16))

  (while (!= cnt 0)
    (set! p (.Append pp p arm64/AMOVD obj/TYPE_REG arm64/REGZERO 0 obj/TYPE_MEM arm64/REGSP off))
    (set! off + 8)
    (set! cnt - 8))

  ^{:line 37} p)


^{:go/end 44} (go/func ginsnop ^{:tag (* obj/Prog)} [^{:tag (* objw/Progs)} pp]
  (let [p (.Prog pp arm64/AHINT)]
    (set! (.-Type (.-From p)) obj/TYPE_CONST)
    ^{:line 43} p))

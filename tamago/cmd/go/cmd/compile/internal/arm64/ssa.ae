    (set! (.-Reg (.-To p)) (simdRegArng (.Reg v) (allLanes arrangement)))
    ^{:line 330} p))



^{:go/end 341} (go/func simdV11Scalar "simdV11Scalar generates vector-to-scalar reduction operations, e.g. VUADDLV V1.B8, V0\n" ^{:tag (* obj/Prog)} [^{:tag (* ssagen/State)} s ^{:tag (* ssa/Value)} v ^int16 arrangement]

^{:go/end 60} (go/func loadByType "loadByType returns the load instruction of the given type.\n" ^obj/As [^{:tag (* types/Type)} t]
  (cond (.IsSIMD t)
    (when (== (.Size t) 16)
      (return arm64/AFMOVQ)) ; Use FMOVQ (LDR Q) for 128-bit SIMD loads

    (.IsFloat t)
    (switch (.Size t)
      (case [4]
        (return arm64/AFMOVS))
      (case [8]
        (return arm64/AFMOVD))) :else


    (switch (.Size t)
      (case [1]
        (if (.IsSigned t)
          (return arm64/AMOVB)

          (return arm64/AMOVBU)))

      (case [2]
        (if (.IsSigned t)
          (return arm64/AMOVH)

          (return arm64/AMOVHU)))

      (case [4]
        (if (.IsSigned t)
          (return arm64/AMOVW)

          (return arm64/AMOVWU)))

      (case [8]
        (return arm64/AMOVD))))


  (panic "bad load type"))



^{:go/end 88} (go/func storeByType "storeByType returns the store instruction of the given type.\n" ^obj/As [^{:tag (* types/Type)} t]
  (cond (.IsSIMD t)
    (when (== (.Size t) 16)
      (return arm64/AFMOVQ)) ; Use FMOVQ (STR Q) for 128-bit SIMD stores

    (.IsFloat t)
    (switch (.Size t)
      (case [4]
        (return arm64/AFMOVS))
      (case [8]
        (return arm64/AFMOVD))) :else


    (switch (.Size t)
      (case [1]
        (return arm64/AMOVB))
      (case [2]
        (return arm64/AMOVH))
      (case [4]
        (return arm64/AMOVW))
      (case [8]
        (return arm64/AMOVD))))


  (panic "bad store type"))




^{:go/end 109} (go/func loadByType2 "loadByType2 returns an opcode that can load consecutive memory locations into 2 registers with type t.\nreturns obj.AXXX if no such opcode exists.\n" ^obj/As [^{:tag (* types/Type)} t]
  (if (.IsFloat t)
    (switch (.Size t)
      (case [4]
        (return arm64/AFLDPS))
      (case [8]
        (return arm64/AFLDPD)))


    (switch (.Size t)
      (case [4]
        (return arm64/ALDPW))
      (case [8]
        (return arm64/ALDP))))


  ^{:line 108} obj/AXXX)




^{:go/end 130} (go/func storeByType2 "storeByType2 returns an opcode that can store registers with type t into 2 consecutive memory locations.\nreturns obj.AXXX if no such opcode exists.\n" ^obj/As [^{:tag (* types/Type)} t]
  (if (.IsFloat t)
    (switch (.Size t)

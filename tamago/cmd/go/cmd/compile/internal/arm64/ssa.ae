      (ssagen/CheckLoweredGetClosurePtr v))
    (case [ssa/OpARM64LoweredGetCallerSP]
      ;; caller's SP is FixedFrameSize below the address of the first arg
      (let [p (.Prog s arm64/AMOVD)]
        (set! (.-Type (.-From p)) obj/TYPE_ADDR)
        (set! (.-Offset (.-From p)) (- ^{:go/via [Arch]} (.-FixedFrameSize (.-Arch base/Ctxt))))
        (set! (.-Name (.-From p)) obj/NAME_PARAM)
        (set! (.-Type (.-To p)) obj/TYPE_REG)
        (set! (.-Reg (.-To p)) (.Reg v))))
    (case [ssa/OpARM64LoweredGetCallerPC]
      (let [p (.Prog s obj/AGETCALLERPC)]
        (set! (.-Type (.-To p)) obj/TYPE_REG)
        (set! (.-Reg (.-To p)) (.Reg v))))
    (case [ssa/OpARM64DMB]
      (let [p (.Prog s (.Asm (.-Op v)))]
        (set! (.-Type (.-From p)) obj/TYPE_CONST)
        (set! (.-Offset (.-From p)) (.-AuxInt v))))
    (case [ssa/OpARM64FlagConstant]
      (.Fatalf v "FlagConstant op should never make it to codegen %v" (.LongString v)))
    (case [ssa/OpARM64InvertFlags]
      (.Fatalf v "InvertFlags should never make it to codegen %v" (.LongString v)))
    (case [ssa/OpClobber]
      ;; MOVW	$0xdeaddead, REGTMP
      ;; MOVW	REGTMP, (slot)
      ;; MOVW	REGTMP, 4(slot)
      (let [p (.Prog s arm64/AMOVW)]
        (set! (.-Type (.-From p)) obj/TYPE_CONST)
        (set! (.-Offset (.-From p)) 0xdeaddead)
        (set! (.-Type (.-To p)) obj/TYPE_REG)
        (set! (.-Reg (.-To p)) arm64/REGTMP)
        (set! p (.Prog s arm64/AMOVW))
        (set! (.-Type (.-From p)) obj/TYPE_REG)
        (set! (.-Reg (.-From p)) arm64/REGTMP)
        (set! (.-Type (.-To p)) obj/TYPE_MEM)
        (set! (.-Reg (.-To p)) arm64/REGSP)
        (ssagen/AddAux (addr (.-To p)) v)
        (set! p (.Prog s arm64/AMOVW))
        (set! (.-Type (.-From p)) obj/TYPE_REG)
        (set! (.-Reg (.-From p)) arm64/REGTMP)
        (set! (.-Type (.-To p)) obj/TYPE_MEM)
        (set! (.-Reg (.-To p)) arm64/REGSP)
        (ssagen/AddAux2 (addr (.-To p)) v (+ (.-AuxInt v) 4))))
    (case [ssa/OpClobberReg]
      (let [x (conv uint64 0xdeaddeaddeaddead)
          ^{:line 1930} p (.Prog s arm64/AMOVD)]
        (set! (.-Type (.-From p)) obj/TYPE_CONST)
        (set! (.-Offset (.-From p)) (conv int64 x))
        (set! (.-Type (.-To p)) obj/TYPE_REG)
        (set! (.-Reg (.-To p)) (.Reg v))))
    (default
      (when (not (ssaGenSIMDValue s v))
        (.Fatalf v "genValue not implemented: %s" (.LongString v))))))




(go/var condBits (lit (map ssa/Op arm64/SpecialOperand)
    ^{:line 1943} [ssa/OpARM64Equal arm64/SPOP_EQ]
    ^{:line 1944} [ssa/OpARM64NotEqual arm64/SPOP_NE]
    ^{:line 1945} [ssa/OpARM64LessThan arm64/SPOP_LT]
    ^{:line 1946} [ssa/OpARM64LessThanU arm64/SPOP_LO]
    ^{:line 1947} [ssa/OpARM64LessEqual arm64/SPOP_LE]
    ^{:line 1948} [ssa/OpARM64LessEqualU arm64/SPOP_LS]
    ^{:line 1949} [ssa/OpARM64GreaterThan arm64/SPOP_GT]
    ^{:line 1950} [ssa/OpARM64GreaterThanU arm64/SPOP_HI]
    ^{:line 1951} [ssa/OpARM64GreaterEqual arm64/SPOP_GE]
    ^{:line 1952} [ssa/OpARM64GreaterEqualU arm64/SPOP_HS]
    ^{:line 1953} [ssa/OpARM64LessThanF arm64/SPOP_MI] ; Less than
    ^{:line 1954} [ssa/OpARM64LessEqualF arm64/SPOP_LS] ; Less than or equal to
    ^{:line 1955} [ssa/OpARM64GreaterThanF arm64/SPOP_GT] ; Greater than
    ^{:line 1956} [ssa/OpARM64GreaterEqualF arm64/SPOP_GE] ; Greater than or equal to

    ;; The following condition codes have unordered to handle comparisons related to NaN.
    ^{:line 1959} [ssa/OpARM64NotLessThanF arm64/SPOP_PL] ; Greater than, equal to, or unordered
    ^{:line 1960} [ssa/OpARM64NotLessEqualF arm64/SPOP_HI] ; Greater than or unordered
    ^{:line 1961} [ssa/OpARM64NotGreaterThanF arm64/SPOP_LE] ; Less than, equal to or unordered
    ^{:line 1962} [ssa/OpARM64NotGreaterEqualF arm64/SPOP_LT] ; Less than or unordered

    ^{:line 1964} [ssa/OpARM64LessThanNoov arm64/SPOP_MI] ; Less than but without honoring overflow
    ^{:line 1965} [ssa/OpARM64GreaterEqualNoov arm64/SPOP_PL])) ; Greater than or equal to but without honoring overflow


(go/var blockJump (lit (map ssa/BlockKind (struct
        ^{:line 1969 :tag obj/As} asm ^obj/As invasm))

    ^{:line 1971} [ssa/BlockARM64EQ (lit _ arm64/ABEQ arm64/ABNE)]
    ^{:line 1972} [ssa/BlockARM64NE (lit _ arm64/ABNE arm64/ABEQ)]
    ^{:line 1973} [ssa/BlockARM64LT (lit _ arm64/ABLT arm64/ABGE)]
    ^{:line 1974} [ssa/BlockARM64GE (lit _ arm64/ABGE arm64/ABLT)]
    ^{:line 1975} [ssa/BlockARM64LE (lit _ arm64/ABLE arm64/ABGT)]
    ^{:line 1976} [ssa/BlockARM64GT (lit _ arm64/ABGT arm64/ABLE)]
    ^{:line 1977} [ssa/BlockARM64ULT (lit _ arm64/ABLO arm64/ABHS)]
    ^{:line 1978} [ssa/BlockARM64UGE (lit _ arm64/ABHS arm64/ABLO)]
    ^{:line 1979} [ssa/BlockARM64UGT (lit _ arm64/ABHI arm64/ABLS)]
    ^{:line 1980} [ssa/BlockARM64ULE (lit _ arm64/ABLS arm64/ABHI)]
    ^{:line 1981} [ssa/BlockARM64Z (lit _ arm64/ACBZ arm64/ACBNZ)]
    ^{:line 1982} [ssa/BlockARM64NZ (lit _ arm64/ACBNZ arm64/ACBZ)]
    ^{:line 1983} [ssa/BlockARM64ZW (lit _ arm64/ACBZW arm64/ACBNZW)]
    ^{:line 1984} [ssa/BlockARM64NZW (lit _ arm64/ACBNZW arm64/ACBZW)]
    ^{:line 1985} [ssa/BlockARM64TBZ (lit _ arm64/ATBZ arm64/ATBNZ)]
    ^{:line 1986} [ssa/BlockARM64TBNZ (lit _ arm64/ATBNZ arm64/ATBZ)]
    ^{:line 1987} [ssa/BlockARM64FLT (lit _ arm64/ABMI arm64/ABPL)]
    ^{:line 1988} [ssa/BlockARM64FGE (lit _ arm64/ABGE arm64/ABLT)]
    ^{:line 1989} [ssa/BlockARM64FLE (lit _ arm64/ABLS arm64/ABHI)]
    ^{:line 1990} [ssa/BlockARM64FGT (lit _ arm64/ABGT arm64/ABLE)]
    ^{:line 1991} [ssa/BlockARM64LTnoov (lit _ arm64/ABMI arm64/ABPL)]
    ^{:line 1992} [ssa/BlockARM64GEnoov (lit _ arm64/ABPL arm64/ABMI)]))



(go/var ^{:doc "To model a 'LEnoov' ('<=' without overflow checking) branching.\n"} leJumps (lit (array 2 (array 2 ssagen/IndexJump))
    (lit _ (lit _ :Jump arm64/ABEQ :Index 0) (lit _ :Jump arm64/ABPL :Index 1)) ; next == b.Succs[0]
    (lit _ (lit _ :Jump arm64/ABMI :Index 0) (lit _ :Jump arm64/ABEQ :Index 0)))) ; next == b.Succs[1]



(go/var ^{:doc "To model a 'GTnoov' ('>' without overflow checking) branching.\n"} gtJumps (lit (array 2 (array 2 ssagen/IndexJump))
    (lit _ (lit _ :Jump arm64/ABMI :Index 1) (lit _ :Jump arm64/ABEQ :Index 1)) ; next == b.Succs[0]
    (lit _ (lit _ :Jump arm64/ABEQ :Index 1) (lit _ :Jump arm64/ABPL :Index 0)))) ; next == b.Succs[1]


^{:go/end 2093} (go/func ssaGenBlock [^{:tag (* ssagen/State)} s ^{:tag (* ssa/Block)} b ^{:tag (* ssa/Block)} next]
  (switch (.-Kind b)
    (case [ssa/BlockPlain ssa/BlockDefer]
      (when (!= (.Block (aget (.-Succs b) 0)) next)
        (let [p (.Prog s obj/AJMP)]
          (set! (.-Type (.-To p)) obj/TYPE_BRANCH)
          (set! (.-Branches s) (append (.-Branches s) (lit ssagen/Branch :P p :B (.Block (aget (.-Succs b) 0))))))))


    (case [ssa/BlockExit ssa/BlockRetJmp])

    (case [ssa/BlockRet]
      (.Prog s obj/ARET))

    (case [ssa/BlockARM64EQ ssa/BlockARM64NE
        ^{:line 2022} ssa/BlockARM64LT ssa/BlockARM64GE
        ^{:line 2023} ssa/BlockARM64LE ssa/BlockARM64GT
        ^{:line 2024} ssa/BlockARM64ULT ssa/BlockARM64UGT
        ^{:line 2025} ssa/BlockARM64ULE ssa/BlockARM64UGE
        ^{:line 2026} ssa/BlockARM64Z ssa/BlockARM64NZ
        ^{:line 2027} ssa/BlockARM64ZW ssa/BlockARM64NZW
        ^{:line 2028} ssa/BlockARM64FLT ssa/BlockARM64FGE
        ^{:line 2029} ssa/BlockARM64FLE ssa/BlockARM64FGT
        ^{:line 2030} ssa/BlockARM64LTnoov ssa/BlockARM64GEnoov]
      (let [jmp (aget blockJump (.-Kind b))
          ^{:line 2032 :tag (* obj/Prog)} p (zero (* obj/Prog))]
        (switch next
          (case [(.Block (aget (.-Succs b) 0))]
            (set! p (.Br s (.-invasm jmp) (.Block (aget (.-Succs b) 1)))))
          (case [(.Block (aget (.-Succs b) 1))]
            (set! p (.Br s (.-asm jmp) (.Block (aget (.-Succs b) 0)))))
          (default
            (if (!= (.-Likely b) ssa/BranchUnlikely) (do
                (set! p (.Br s (.-asm jmp) (.Block (aget (.-Succs b) 0))))
                (.Br s obj/AJMP (.Block (aget (.-Succs b) 1))))
              (do
                (set! p (.Br s (.-invasm jmp) (.Block (aget (.-Succs b) 1))))
                (.Br s obj/AJMP (.Block (aget (.-Succs b) 0)))))))


        (when (not (.IsFlags (.-Type (aget (.-Controls b) 0))))
          (set! (.-Type (.-From p)) obj/TYPE_REG)
          (set! (.-Reg (.-From p)) (.Reg (aget (.-Controls b) 0))))))

    (case [ssa/BlockARM64TBZ ssa/BlockARM64TBNZ]
      (let [jmp (aget blockJump (.-Kind b))
          ^{:line 2053 :tag (* obj/Prog)} p (zero (* obj/Prog))]
        (switch next
          (case [(.Block (aget (.-Succs b) 0))]
            (set! p (.Br s (.-invasm jmp) (.Block (aget (.-Succs b) 1)))))
          (case [(.Block (aget (.-Succs b) 1))]
            (set! p (.Br s (.-asm jmp) (.Block (aget (.-Succs b) 0)))))
          (default
            (if (!= (.-Likely b) ssa/BranchUnlikely) (do
                (set! p (.Br s (.-asm jmp) (.Block (aget (.-Succs b) 0))))
                (.Br s obj/AJMP (.Block (aget (.-Succs b) 1))))
              (do
                (set! p (.Br s (.-invasm jmp) (.Block (aget (.-Succs b) 1))))
                (.Br s obj/AJMP (.Block (aget (.-Succs b) 0)))))))


        (set! (.-Offset (.-From p)) (.-AuxInt b))
        (set! (.-Type (.-From p)) obj/TYPE_CONST)
        (set! (.-Reg p) (.Reg (aget (.-Controls b) 0)))))

    (case [ssa/BlockARM64LEnoov]
      (.CombJump s b next (addr leJumps)))
    (case [ssa/BlockARM64GTnoov]
      (.CombJump s b next (addr gtJumps)))

    (case [ssa/BlockARM64JUMPTABLE]
      ;; MOVD	(TABLE)(IDX<<3), Rtmp
      ;; JMP	(Rtmp)
      (let [p (.Prog s arm64/AMOVD)]
        (set! (.-From p) (genIndexedOperand ssa/OpARM64MOVDloadidx8 (.Reg (aget (.-Controls b) 1)) (.Reg (aget (.-Controls b) 0))))
        (set! (.-Type (.-To p)) obj/TYPE_REG)
        (set! (.-Reg (.-To p)) arm64/REGTMP)
        (set! p (.Prog s obj/AJMP))
        (set! (.-Type (.-To p)) obj/TYPE_MEM)
        (set! (.-Reg (.-To p)) arm64/REGTMP)
        ;; Save jump tables for later resolution of the target blocks.
        (set! (.-JumpTables s) (append (.-JumpTables s) b))))

    (default
      (.Fatalf b "branch not implemented: %s" (.LongString b)))))



^{:go/end 2104} (go/func loadRegResult ^{:tag (* obj/Prog)} [^{:tag (* ssagen/State)} s ^{:tag (* ssa/Func)} f ^{:tag (* types/Type)} t ^int16 reg ^{:tag (* ir/Name)} n ^int64 off]
  (let [p (.Prog s (loadByType t))]
    (set! (.-Type (.-From p)) obj/TYPE_MEM)
    (set! (.-Name (.-From p)) obj/NAME_AUTO)
    (set! (.-Sym (.-From p)) (.Linksym n))
    (set! (.-Offset (.-From p)) (+ (.FrameOffset n) off))
    (set! (.-Type (.-To p)) obj/TYPE_REG)
    (set! (.-Reg (.-To p)) reg)
    ^{:line 2103} p))


^{:go/end 2112} (go/func spillArgReg ^{:tag (* obj/Prog)} [^{:tag (* objw/Progs)} pp ^{:tag (* obj/Prog)} p ^{:tag (* ssa/Func)} f ^{:tag (* types/Type)} t ^int16 reg ^{:tag (* ir/Name)} n ^int64 off]
  (set! p (.Append pp p (storeByType t) obj/TYPE_REG reg 0 obj/TYPE_MEM 0 (+ (.FrameOffset n) off)))
  (set! (.-Name (.-To p)) obj/NAME_PARAM)
  (set! (.-Sym (.-To p)) (.Linksym n))
  (set! (.-Pos p) (.WithNotStmt (.-Pos p)))
  ^{:line 2111} p)




^{:go/end 2133} (go/func zero16 "zero16 zeroes 16 bytes at reg+off.\nIf postInc is true, increment reg by 16.\n" [^{:tag (* ssagen/State)} s ^int16 reg ^int64 off ^bool postInc]
  ;;   STP     (ZR, ZR), off(reg)
  (let [p (.Prog s arm64/ASTP)]
    (set! (.-Type (.-From p)) obj/TYPE_REGREG)
    (set! (.-Reg (.-From p)) arm64/REGZERO)
    (set! (.-Offset (.-From p)) (conv int64 arm64/REGZERO))
    (set! (.-Type (.-To p)) obj/TYPE_MEM)
    (set! (.-Reg (.-To p)) reg)
    (set! (.-Offset (.-To p)) off)
    (when postInc
      (when (!= off 0)
        (panic "can't postinc with non-zero offset"))

      ;;   STP.P  (ZR, ZR), 16(reg)
      (set! (.-Scond p) arm64/C_XPOST)
      (set! (.-Offset (.-To p)) 16))))




^{:go/end 2144} (go/func zero8 "zero8 zeroes 8 bytes at reg+off.\n" [^{:tag (* ssagen/State)} s ^int16 reg ^int64 off]
  ;;   MOVD     ZR, off(reg)
  (let [p (.Prog s arm64/AMOVD)]
    (set! (.-Type (.-From p)) obj/TYPE_REG)
    (set! (.-Reg (.-From p)) arm64/REGZERO)
    (set! (.-Type (.-To p)) obj/TYPE_MEM)
    (set! (.-Reg (.-To p)) reg)
    (set! (.-Offset (.-To p)) off)))





^{:go/end 2175} (go/func move32 "move32 copies 32 bytes at src+off to dst+off.\nUses registers tmp1 and tmp2.\nIf postInc is true, increment src and dst by 32.\n" [^{:tag (* ssagen/State)} s ^int16 src ^int16 dst ^int16 tmp1 ^int16 tmp2 ^int64 off ^bool postInc]
  ;; FLDPQ   off(src), (tmp1, tmp2)
  (let [ld (.Prog s arm64/AFLDPQ)]
    (set! (.-Type (.-From ld)) obj/TYPE_MEM)
    (set! (.-Reg (.-From ld)) src)
    (set! (.-Offset (.-From ld)) off)
    (set! (.-Type (.-To ld)) obj/TYPE_REGREG)
    (set! (.-Reg (.-To ld)) tmp1)
    (set! (.-Offset (.-To ld)) (conv int64 tmp2))
    ;; FSTPQ   (tmp1, tmp2), off(dst)
    (let [st (.Prog s arm64/AFSTPQ)]
      (set! (.-Type (.-From st)) obj/TYPE_REGREG)
      (set! (.-Reg (.-From st)) tmp1)
      (set! (.-Offset (.-From st)) (conv int64 tmp2))
      (set! (.-Type (.-To st)) obj/TYPE_MEM)
      (set! (.-Reg (.-To st)) dst)
      (set! (.-Offset (.-To st)) off)
      (when postInc
        (when (!= off 0)
          (panic "can't postinc with non-zero offset"))

        (set! (.-Scond ld) arm64/C_XPOST)
        (set! (.-Scond st) arm64/C_XPOST)
        (set! (.-Offset (.-From ld)) 32)
        (set! (.-Offset (.-To st)) 32)))))






^{:go/end 2204} (go/func move16 "move16 copies 16 bytes at src+off to dst+off.\nUses register tmp1\nIf postInc is true, increment src and dst by 16.\n" [^{:tag (* ssagen/State)} s ^int16 src ^int16 dst ^int16 tmp1 ^int64 off ^bool postInc]
  ;; FMOVQ     off(src), tmp1
  (let [ld (.Prog s arm64/AFMOVQ)]
    (set! (.-Type (.-From ld)) obj/TYPE_MEM)
    (set! (.-Reg (.-From ld)) src)
    (set! (.-Offset (.-From ld)) off)
    (set! (.-Type (.-To ld)) obj/TYPE_REG)
    (set! (.-Reg (.-To ld)) tmp1)
    ;; FMOVQ     tmp1, off(dst)
    (let [st (.Prog s arm64/AFMOVQ)]
      (set! (.-Type (.-From st)) obj/TYPE_REG)
      (set! (.-Reg (.-From st)) tmp1)
      (set! (.-Type (.-To st)) obj/TYPE_MEM)
      (set! (.-Reg (.-To st)) dst)
      (set! (.-Offset (.-To st)) off)
      (when postInc
        (when (!= off 0)
          (panic "can't postinc with non-zero offset"))

        (set! (.-Scond ld) arm64/C_XPOST)
        (set! (.-Scond st) arm64/C_XPOST)
        (set! (.-Offset (.-From ld)) 16)
        (set! (.-Offset (.-To st)) 16)))))





^{:go/end 2223} (go/func move8 "move8 copies 8 bytes at src+off to dst+off.\nUses register tmp.\n" [^{:tag (* ssagen/State)} s ^int16 src ^int16 dst ^int16 tmp ^int64 off]
  ;; MOVD    off(src), tmp
  (let [ld (.Prog s arm64/AMOVD)]
    (set! (.-Type (.-From ld)) obj/TYPE_MEM)
    (set! (.-Reg (.-From ld)) src)
    (set! (.-Offset (.-From ld)) off)
    (set! (.-Type (.-To ld)) obj/TYPE_REG)
    (set! (.-Reg (.-To ld)) tmp)
    ;; MOVD    tmp, off(dst)
    (let [st (.Prog s arm64/AMOVD)]
      (set! (.-Type (.-From st)) obj/TYPE_REG)
      (set! (.-Reg (.-From st)) tmp)
      (set! (.-Type (.-To st)) obj/TYPE_MEM)
      (set! (.-Reg (.-To st)) dst)
      (set! (.-Offset (.-To st)) off))))

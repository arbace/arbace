^{:go/end 138} (go/func makeshift "makeshift encodes a register shifted by a constant, used as an Offset in Prog.\n" ^int64 [^{:tag (* ssa/Value)} v ^int16 reg ^int64 typ ^int64 s]
  (when (or (< s 0) (>= s 64))
    (.Fatalf v "shift out of range: %d" s))

  (bit-or (<< (conv int64 (bit-and reg 31)) 16) typ (<< (bit-and s 63) 10)))



^{:go/end 151} (go/func genshift "genshift generates a Prog for r = r0 op (r1 shifted by n).\n" ^{:tag (* obj/Prog)} [^{:tag (* ssagen/State)} s ^{:tag (* ssa/Value)} v ^obj/As as ^int16 r0 ^int16 r1 ^int16 r ^int64 typ ^int64 n]
  (let [p (.Prog s as)]
    (set! (.-Type (.-From p)) obj/TYPE_SHIFT)
    (set! (.-Offset (.-From p)) (makeshift v r1 typ n))
    (set! (.-Reg p) r0)
    (when (!= r 0)
      (set! (.-Type (.-To p)) obj/TYPE_REG)
      (set! (.-Reg (.-To p)) r))

    ^{:line 150} p))




^{:go/end 171} (go/func genIndexedOperand "generate the memory operand for the indexed load/store instructions.\nbase and idx are registers.\n" ^obj/Addr [^ssa/Op op ^int16 base ^int16 idx]
  ;; Reg: base register, Index: (shifted) index register
  (let [mop (lit obj/Addr :Type obj/TYPE_MEM :Reg base)]
    (switch op
      (case [ssa/OpARM64MOVDloadidx8 ssa/OpARM64MOVDstoreidx8
          ^{:line 160} ssa/OpARM64FMOVDloadidx8 ssa/OpARM64FMOVDstoreidx8]
        (set! (.-Index mop) (bit-or arm64/REG_LSL (<< 3 5) (bit-and idx 31))))
      (case [ssa/OpARM64MOVWloadidx4 ssa/OpARM64MOVWUloadidx4 ssa/OpARM64MOVWstoreidx4
          ^{:line 163} ssa/OpARM64FMOVSloadidx4 ssa/OpARM64FMOVSstoreidx4]
        (set! (.-Index mop) (bit-or arm64/REG_LSL (<< 2 5) (bit-and idx 31))))
      (case [ssa/OpARM64MOVHloadidx2 ssa/OpARM64MOVHUloadidx2 ssa/OpARM64MOVHstoreidx2]
        (set! (.-Index mop) (bit-or arm64/REG_LSL (<< 1 5) (bit-and idx 31))))
      (default ; not shifted
        (set! (.-Index mop) idx)))

    ^{:line 170} mop))



^{:go/end 183} (go/func simdRegArng "simdRegArng encodes ssa value's register with specified simd arrangement\n" ^int16 [^int16 reg ^int16 arng]
  (when (or (< reg arm64/REG_F0) (< arm64/REG_F31 reg))
    (base/Fatalf "expected fp register: r%d" reg))

  (let [^error err (zero error)]
    (when [(set! (values reg err) (arm64/RegisterArrangement reg arng false))] (!= err nil)
      (base/Fatalf "bad simd register arrangement: %v" err))

    ^{:line 182} reg))



^{:go/end 199} (go/func simdRegElem "simdRegElem encodes ssa value's reference to a vector register element\n" [^int16 reg ^int16 arng ^int16 idx] :results [^obj/Addr res]
  (when (or (< reg arm64/REG_F0) (< arm64/REG_F31 reg))
    (base/Fatalf "expected fp register: r%d" reg))

  (let [(values elem err) (arm64/RegisterArrangement reg arng true)] ; /*indexing*/
    (when (!= err nil)
      (base/Fatalf "bad simd register indexing arrangement: %v" err))

    (set! (.-Type res) obj/TYPE_REG)
    (set! (.-Class res) arm64/C_ELEM)
    (set! (.-Index res) idx)
    (set! (.-Reg res) elem)
    (return)))




^{:go/end 217} (go/func allLanes "allLanes converts an element arrangement to its 128-bit vector arrangement.\ne.g., ARNG_B -> ARNG_16B, ARNG_S -> ARNG_4S\n" ^int16 [^int16 arng]
  (switch arng
    (case [arm64/ARNG_B]
      (return arm64/ARNG_16B))
    (case [arm64/ARNG_H]
      (return arm64/ARNG_8H))
    (case [arm64/ARNG_S]
      (return arm64/ARNG_4S))
    (case [arm64/ARNG_D]
      (return arm64/ARNG_2D))
    (default
      (base/Fatalf "unsupported element arrangement: %d" arng)
      (return 0))))




^{:go/end 232} (go/func arngNarrow "arngNarrow converts arng to its narrow (halved element width and vector width) arrangement.\n" ^int16 [^int16 arng]
  (switch arng
    (case [arm64/ARNG_8H]
      (return arm64/ARNG_8B))
    (case [arm64/ARNG_4S]
      (return arm64/ARNG_4H))
    (case [arm64/ARNG_2D]
      (return arm64/ARNG_2S))
    (default
      (base/Fatalf "unsupported narrow input arrangement: %d" arng)
      (return 0))))




^{:go/end 249} (go/func arngLong "arngLong converts a half-lane arrangement to its long (doubled element width and vector width) arrangement.\n" ^int16 [^int16 arng]
  (switch arng
    (case [arm64/ARNG_8B]
      (return arm64/ARNG_8H))
    (case [arm64/ARNG_4H]
      (return arm64/ARNG_4S))
    (case [arm64/ARNG_2S]
      (return arm64/ARNG_2D))
    (case [arm64/ARNG_1D]
      (return arm64/ARNG_1Q))
    (default
      (base/Fatalf "unsupported long input arrangement: %d" arng)
      (return 0))))





^{:go/end 267} (go/func arngHalfLanes "arngHalfLanes converts a full-width arrangement to its half-lane (64-bit) arrangement.\nSame element width, half the lanes. Used for long base variant sources.\n" ^int16 [^int16 arng]
  (switch arng
    (case [arm64/ARNG_16B]
      (return arm64/ARNG_8B))
    (case [arm64/ARNG_8H]
      (return arm64/ARNG_4H))
    (case [arm64/ARNG_4S]
      (return arm64/ARNG_2S))
    (case [arm64/ARNG_2D]
      (return arm64/ARNG_1D))
    (default
      (base/Fatalf "unsupported halfLanes input arrangement: %d" arng)
      (return 0))))





^{:go/end 283} (go/func arngTwiceLanes "arngTwiceLanes converts a half-lane (64-bit) arrangement to its full-width arrangement.\nSame element width, double the lanes. Inverse of arngHalfLanes.\n" ^int16 [^int16 arng]
  (switch arng
    (case [arm64/ARNG_8B]
      (return arm64/ARNG_16B))
    (case [arm64/ARNG_4H]
      (return arm64/ARNG_8H))
    (case [arm64/ARNG_2S]
      (return arm64/ARNG_4S))
    (default
      (base/Fatalf "unsupported twiceLanes input arrangement: %d" arng)
      (return 0))))




^{:go/end 293} (go/func simdV01Imm "simdV01Imm generates a VMOVI-like instruction, e.g. VMOVI $0, V0.B16\n" ^{:tag (* obj/Prog)} [^{:tag (* ssagen/State)} s ^{:tag (* ssa/Value)} v ^int16 arrangement]
  (let [p (.Prog s (.Asm (.-Op v)))]
    (set! (.-Type (.-From p)) obj/TYPE_CONST)
    (set! (.-Offset (.-From p)) (conv int64 (.AuxUInt8 v)))
    (set! (.-Type (.-To p)) obj/TYPE_REG)
    (set! (.-Reg (.-To p)) (simdRegArng (.Reg v) arrangement))
    ^{:line 292} p))



^{:go/end 303} (go/func simdV11Asm "simdV11Asm generates element-wise unary vector operations with explicit asm, e.g. VMOV V1.B16, V0.B16\n" ^{:tag (* obj/Prog)} [^{:tag (* ssagen/State)} s ^obj/As asm ^int16 src ^int16 dst ^int16 arrangement]
  (let [p (.Prog s asm)]
    (set! (.-Type (.-From p)) obj/TYPE_REG)
    (set! (.-Reg (.-From p)) (simdRegArng src arrangement))
    (set! (.-Type (.-To p)) obj/TYPE_REG)
    (set! (.-Reg (.-To p)) (simdRegArng dst arrangement))
    ^{:line 302} p))



^{:go/end 308} (go/func simdV11 "simdV11 generates element-wise unary vector operations, e.g. VCNT V1.B8, V0.B8\n" ^{:tag (* obj/Prog)} [^{:tag (* ssagen/State)} s ^{:tag (* ssa/Value)} v ^int16 arrangement]
  (simdV11Asm s (.Asm (.-Op v)) (.Reg (aget (.-Args v) 0)) (.Reg v) arrangement))




^{:go/end 320} (go/func simdV11Imm "simdV11Imm generates a unary vector operation with immediate constant,\ne.g. VUSHR $3, V1.B16, V0.B16\n" ^{:tag (* obj/Prog)} [^{:tag (* ssagen/State)} s ^{:tag (* ssa/Value)} v ^int16 arrangement]

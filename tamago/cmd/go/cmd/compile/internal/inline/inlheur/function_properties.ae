(in-ns 'go.cmd.compile.internal.inline.inlheur) (go/file "function_properties.go" :imports [])

;; This file defines a set of Go function "properties" intended to
;; guide inlining heuristics; these properties may apply to the
;; function as a whole, or to one or more function return values or
;; parameters.
;;
;; IMPORTANT: function properties are produced on a "best effort"
;; basis, meaning that the code that computes them doesn't verify that
;; the properties are guaranteed to be true in 100% of cases. For this
;; reason, properties should only be used to drive always-safe
;; optimization decisions (e.g. "should I inline this call", or
;; "should I unroll this loop") as opposed to potentially unsafe IR
;; alterations that could change program semantics (e.g. "can I delete
;; this variable" or "can I move this statement to a new location").
;;
;;----------------------------------------------------------------










(go/type FuncProps "FuncProps describes a set of function or method properties that may\nbe useful for inlining heuristics. Here 'Flags' are properties that\nwe think apply to the entire function; 'RecvrParamFlags' are\nproperties of specific function params (or the receiver), and\n'ResultFlags' are things properties we think will apply to values\nof specific results. Note that 'ParamFlags' includes and entry for\nthe receiver if applicable, and does include etries for blank\nparams; for a function such as \"func foo(_ int, b byte, _ float32)\"\nthe length of ParamFlags will be 3.\n" (struct
    ^{:line 33 :tag FuncPropBits} Flags
    ^{:line 34 :tag (slice ParamPropBits)} ParamFlags ; slot 0 receiver if applicable
    ^{:line 35 :tag (slice ResultPropBits)} ResultFlags))


(go/type FuncPropBits uint32)

(go/const


  ^{:line 43} [^{:tag FuncPropBits :val 1 :doc "Function always panics or invokes os.Exit() or a func that does\nlikewise.\n"} FuncPropNeverReturns (<< 1 iota)])


(go/type ParamPropBits uint32)

(go/const

  ^{:line 50} [^{:tag ParamPropBits :val 0 :doc "No info about this param\n"} ParamNoInfo 0]



  ^{:line 54} [^{:tag ParamPropBits :val 2 :doc "Parameter value feeds unmodified into a top-level interface\ncall (this assumes the parameter is of interface type).\n"} ParamFeedsInterfaceMethodCall (<< 1 iota)]




  ^{:line 59} [^{:tag ParamPropBits :val 4 :doc "Parameter value feeds unmodified into an interface call that\nmay be conditional/nested and not always executed (this assumes\nthe parameter is of interface type).\n"} ParamMayFeedInterfaceMethodCall (<< 1 iota)]



  ^{:line 63} [^{:val 8 :doc "Parameter value feeds unmodified into a top level indirect\nfunction call (assumes parameter is of function type).\n"} ParamFeedsIndirectCall]




  ^{:line 68} [^{:val 16 :doc "Parameter value feeds unmodified into an indirect function call\nthat is conditional/nested (not guaranteed to execute). Assumes\nparameter is of function type.\n"} ParamMayFeedIndirectCall]




  ^{:line 73} [^{:val 32 :doc "Parameter value feeds unmodified into a top level \"switch\"\nstatement or \"if\" statement simple expressions (see more on\n\"simple\" expression classification below).\n"} ParamFeedsIfOrSwitch]





  ^{:line 79} [^{:val 64 :doc "Parameter value feeds unmodified into a \"switch\" or \"if\"\nstatement simple expressions (see more on \"simple\" expression\nclassification below), where the if/switch is\nconditional/nested.\n"} ParamMayFeedIfOrSwitch])


(go/type ResultPropBits uint32)

(go/const

  ^{:line 86} [^{:tag ResultPropBits :val 0 :doc "No info about this result\n"} ResultNoInfo 0]

  ^{:line 88} [^{:tag ResultPropBits :val 2 :doc "This result always contains allocated memory.\n"} ResultIsAllocatedMem (<< 1 iota)]


  ^{:line 91} [^{:val 4 :doc "This result is always a single concrete type that is\nimplicitly converted to interface.\n"} ResultIsConcreteTypeConvertedToInterface]

  ^{:line 93} [^{:val 8 :doc "Result is always the same non-composite compile time constant.\n"} ResultAlwaysSameConstant]

  ^{:line 95} [^{:val 16 :doc "Result is always the same function or closure.\n"} ResultAlwaysSameFunc]

  ^{:line 97} [^{:val 32 :doc "Result is always the same (potentially) inlinable function or closure.\n"} ResultAlwaysSameInlinableFunc])

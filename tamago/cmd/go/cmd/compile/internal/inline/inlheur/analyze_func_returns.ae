^{:go/end 52} (go/func addResultsAnalyzer "addResultsAnalyzer creates a new resultsAnalyzer helper object for\nthe function fn, appends it to the analyzers list, and returns the\nnew list. If the function in question doesn't have any returns (or\nany interesting returns) then the analyzer list is left as is, and\nthe result flags in \"fp\" are updated accordingly.\n" ^{:tag (slice propAnalyzer)} [^{:tag (* ir/Func)} fn ^{:tag (slice propAnalyzer)} analyzers ^{:tag (* FuncProps)} fp ^int inlineMaxBudget ^{:tag (* nameFinder)} nf]
  (let [(values ra props) (makeResultsAnalyzer fn inlineMaxBudget nf)]
    (if (!= ra nil)
      (set! analyzers (append analyzers ra))

      (set! (.-ResultFlags fp) props))

    ^{:line 51} analyzers))






^{:go/end 91} (go/func makeResultsAnalyzer "makeResultsAnalyzer creates a new helper object to analyze results\nin function fn. If the function doesn't have any interesting\nresults, a nil helper is returned along with a set of default\nresult flags for the func.\n" [^{:tag (* ir/Func)} fn ^int inlineMaxBudget ^{:tag (* nameFinder)} nf] :results [(* resultsAnalyzer) (slice ResultPropBits)]
  (let [results (.Results (.Type fn))]
    (when (== (len results) 0)
      (return nil nil))

    (let [props (make (slice ResultPropBits) (len results))]
      (when (== (.-Inl fn) nil)
        (return nil props))

      (let [vals (make (slice resultVal) (len results))
          ^{:line 68} interestingToAnalyze false]
        (range [i results]
          (let [rt (.-Type (aget results i))]
            (when (and (not (.IsScalar rt)) (not (.HasNil rt)))
              ;; existing properties not applicable here (for things
              ;; like structs, arrays, slices, etc).
              (continue))

            ;; set the "top" flag (as in "top element of data flow lattice")
            ;; meaning "we have no info yet, but we might later on".
            (set! (.-top (aget vals i)) true)
            (set! interestingToAnalyze true)))

        (when (not interestingToAnalyze)
          (return nil props))

        (let [ra (addr ^{:go/breaks [2 4 6 8]} (lit resultsAnalyzer
                :props props
                :values vals
                :inlineMaxBudget inlineMaxBudget
                :nameFinder nf))]

          (return ra nil))))))




^{:go/end 113} (go/method setResults "setResults transfers the calculated result properties for this\nfunction to 'funcProps'.\n" [^{:tag (* resultsAnalyzer)} ra ^{:tag (* FuncProps)} funcProps]
  ;; Promote ResultAlwaysSameFunc to ResultAlwaysSameInlinableFunc
  (range [i (.-values ra)]
    (when (and (== (aget (.-props ra) i) ResultAlwaysSameFunc) (not (.-derived (aget (.-values ra) i))))
      (let [f (.-Func (.-fn (aget (.-values ra) i)))]
        ;; HACK: in order to allow for call site score
        ;; adjustments, we used a relaxed inline budget in
        ;; determining inlinability. For the check below, however,
        ;; we want to know is whether the func in question is
        ;; likely to be inlined, as opposed to whether it might
        ;; possibly be inlined if all the right score adjustments
        ;; happened, so do a simple check based on the cost.
        (when (and (!= (.-Inl f) nil) (<= (.-Cost (.-Inl f)) (conv int32 (.-inlineMaxBudget ra))))
          (aset (.-props ra) i ResultAlwaysSameInlinableFunc)))))



  (set! (.-ResultFlags funcProps) (.-props ra)))


^{:go/end 119} (go/method pessimize [^{:tag (* resultsAnalyzer)} ra]
  (range [i (.-props ra)]
    (aset (.-props ra) i ResultNoInfo)))



^{:go/end 122} (go/method nodeVisitPre [^{:tag (* resultsAnalyzer)} ra ^ir/Node n])


^{:go/end 146} (go/method nodeVisitPost [^{:tag (* resultsAnalyzer)} ra ^ir/Node n]
  (when (== (len (.-values ra)) 0)
    (return))

  (when (!= (.Op n) ir/ORETURN)
    (return))

  (when (!= (bit-and debugTrace debugTraceResults) 0)
    (fmt/Fprintf os/Stderr "=+= returns nodevis %v %s\n"
      (ir/Line n) (.String (.Op n))))


  ;; No support currently for named results, so if we see an empty
  ;; "return" stmt, be conservative.
  (let [rs (assert (* ir/ReturnStmt) n)]
    (when (!= (len (.-Results rs)) (len (.-values ra)))
      (.pessimize ra)
      (return))

    (range [i r (.-Results rs)]
      (.analyzeResult ra i r))))









^{:go/end 235} (go/method analyzeResult "analyzeResult examines the expression 'n' being returned as the\n'ii'th argument in some return statement to see whether has\ninteresting characteristics (for example, returns a constant), then\napplies a dataflow \"meet\" operation to combine this result with any\nprevious result (for the given return slot) that we've already\nprocessed.\n" [^{:tag (* resultsAnalyzer)} ra ^int ii ^ir/Node n]
  (let [isAllocMem ^{:go/via [nameFinder]} (.isAllocatedMem ra n)
      ^{:line 156} isConcConvItf ^{:go/via [nameFinder]} (.isConcreteConvIface ra n)
      ^{:line 157} constVal ^{:go/via [nameFinder]} (.constValue ra n)
      ^{:line 158} isConst (!= constVal nil)
      ^{:line 159} isNil ^{:go/via [nameFinder]} (.isNil ra n)
      ^{:line 160} rfunc ^{:go/via [nameFinder]} (.funcName ra n)
      ^{:line 161} isFunc (!= rfunc nil)
      ^{:line 162} isClo (and (!= rfunc nil) (!= (.-OClosure (.-Func rfunc)) nil))
      ^{:line 163} curp (aget (.-props ra) ii)
      (values dprops isDerivedFromCall) (.deriveReturnFlagsFromCallee ra n)
      ^{:line 165} newp ResultNoInfo
      ^{:line 166 :tag constant/Value} newcval (zero constant/Value)
      ^{:line 167 :tag (* ir/Name)} newfunc (zero (* ir/Name))]

    (when (!= (bit-and debugTrace debugTraceResults) 0)
      (fmt/Fprintf os/Stderr "=-= %v: analyzeResult n=%s ismem=%v isconcconv=%v isconst=%v isnil=%v isfunc=%v isclo=%v\n" (ir/Line n) (.String (.Op n)) isAllocMem isConcConvItf isConst isNil isFunc isClo))


    (if (.-top (aget (.-values ra) ii)) (do
        (set! (.-top (aget (.-values ra) ii)) false)
        ;; this is the first return we've seen; record
        ;; whatever properties it has.
        (switch
          (case [isAllocMem]
            (set! newp ResultIsAllocatedMem))
          (case [isConcConvItf]
            (set! newp ResultIsConcreteTypeConvertedToInterface))
          (case [isFunc]

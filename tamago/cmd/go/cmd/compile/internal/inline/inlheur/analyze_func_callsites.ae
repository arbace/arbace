        (when (!= (bit-and (.-Flags oldcs) CallSiteOnPanicPath) 0)
          (set! icp psCallsPanic))

        (let [^int loopNestLevel (zero int)]
          (when (!= (bit-and (.-Flags oldcs) CallSiteInLoop) 0)
            (set! loopNestLevel 1))

          (let [ptab (lit (map ir/Node pstate) [ic icp])
              ^{:line 394} nf (newNameFinder nil)
              ^{:line 395} icstab (computeCallSiteTable callerfn (.-Body ic) nil ptab loopNestLevel nf)]

            ;; Record parent callsite. This is primarily for debug output.
            (range [_ cs icstab]
              (set! (.-parent cs) oldcs))


            ;; Score the calls in the inlined body. Note the setting of
            ;; "doCallResults" to false here: at the moment there isn't any
            ;; easy way to localize or region-ize the work done by
            ;; "rescoreBasedOnCallResultUses", which currently does a walk
            ;; over the entire function to look for uses of a given set of

            ;; so as to run name finding without the use of static value &
            ;; friends.
            (let [csa (makeCallSiteAnalyzer nil)
                ^:const ^{:line 411 :val false} doCallResults false]
              (.scoreCallsRegion csa callerfn (.-Body ic) icstab doCallResults ic))))))))

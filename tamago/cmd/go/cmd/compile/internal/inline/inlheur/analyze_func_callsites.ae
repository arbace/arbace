      ;; assignsOnlyAutoTemps returns TRUE of the specified OAS2FUNC
      ;; node assigns only auto-temps.
      ^{:line 302} assignsOnlyAutoTemps ^{:go/end 315} (fn ^bool [^ir/Node x]
        ^{:go/breaks [[4 314]]} (let [alst (assert (* ir/AssignListStmt) x)
            ^{:line 304} oa2init ^{:go/via [miniStmt]} (.Init alst)]
          (when (== (len oa2init) 0)
            (return false))

          (range [_ v oa2init]
            (let [d (assert (* ir/Decl) v)]
              (when (not (ir/IsAutoTmp (.-X d)))
                (return false))))


          true))]


    ;; Simple case: x := foo()

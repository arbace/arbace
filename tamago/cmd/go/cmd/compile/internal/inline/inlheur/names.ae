(in-ns 'go.cmd.compile.internal.inline.inlheur) (go/file "names.go" :imports [


    ^{:line 8} [ir "cmd/compile/internal/ir"]
    ^{:line 9} [constant "go/constant"]])





















(go/type nameFinder "nameFinder provides a set of \"isXXX\" query methods for clients to\nask whether a given AST node corresponds to a function, a constant\nvalue, and so on. These methods use an underlying ir.ReassignOracle\nto return more precise results in cases where an \"interesting\"\nvalue is assigned to a singly-defined local temp. Example:\n\n\tconst q = 101\n\tfq := func() int { return q }\n\tcopyOfConstant := q\n\tcopyOfFunc := f\n\tinterestingCall(copyOfConstant, copyOfFunc)\n\nA name finder query method invoked on the arguments being passed to\n\"interestingCall\" will be able detect that 'copyOfConstant' always\nevaluates to a constant (even though it is in fact a PAUTO local\nvariable). A given nameFinder can also operate without using\nir.ReassignOracle (in cases where it is not practical to look\nat the entire function); in such cases queries will still work\nfor explicit constant values and functions.\n" (struct
    ^{:line 32 :tag (* ir/ReassignOracle)} ro))





^{:go/end 45} (go/func newNameFinder "newNameFinder returns a new nameFinder object with a reassignment\noracle initialized based on the function fn, or if fn is nil,\nwithout an underlying ReassignOracle.\n" ^{:tag (* nameFinder)} [^{:tag (* ir/Func)} fn]
  (let [^{:tag (* ir/ReassignOracle)} ro (zero (* ir/ReassignOracle))]
    (when (!= fn nil)
      (set! ro (addr (lit ir/ReassignOracle)))
      (.Init ro fn))

    (addr (lit nameFinder :ro ro))))





^{:go/end 59} (go/method funcName "funcName returns the *ir.Name for the func or method\ncorresponding to node 'n', or nil if n can't be proven\nto contain a function value.\n" ^{:tag (* ir/Name)} [^{:tag (* nameFinder)} nf ^ir/Node n]
  ^{:go/breaks [[4 58]]} (let [sv n]
    (when (!= (.-ro nf) nil)
      (set! sv (.StaticValue (.-ro nf) n)))

    (when [name (ir/StaticCalleeName sv)] (!= name nil)
      (return name))

    nil))




^{:go/end 73} (go/method isAllocatedMem "isAllocatedMem returns true if node n corresponds to a memory\nallocation expression (make, new, or equivalent).\n" ^bool [^{:tag (* nameFinder)} nf ^ir/Node n]
  ^{:go/breaks [[4 72]]} (let [sv n]
    (when (!= (.-ro nf) nil)
      (set! sv (.StaticValue (.-ro nf) n)))

    (switch (.Op sv)
      (case [ir/OMAKESLICE ir/ONEW ir/OPTRLIT ir/OSLICELIT]
        (return true)))

    false))





^{:go/end 87} (go/method constValue "constValue returns the underlying constant.Value for an AST node n\nif n is itself a constant value/expr, or if n is a singly assigned\nlocal containing constant expr/value (or nil not constant).\n" ^constant/Value [^{:tag (* nameFinder)} nf ^ir/Node n]
  ^{:go/breaks [[4 86]]} (let [sv n]
    (when (!= (.-ro nf) nil)
      (set! sv (.StaticValue (.-ro nf) n)))

    (when (== (.Op sv) ir/OLITERAL)
      (return (.Val sv)))

    nil))




^{:go/end 97} (go/method isNil "isNil returns whether n is nil (or singly\nassigned local containing nil).\n" ^bool [^{:tag (* nameFinder)} nf ^ir/Node n]
  (let [sv n]
    (when (!= (.-ro nf) nil)
      (set! sv (.StaticValue (.-ro nf) n)))

    (== (.Op sv) ir/ONIL)))


^{:go/end 104} (go/method staticValue ^ir/Node [^{:tag (* nameFinder)} nf ^ir/Node n]
  (when (== (.-ro nf) nil)
    (return n))

  (.StaticValue (.-ro nf) n))


^{:go/end 111} (go/method reassigned ^bool [^{:tag (* nameFinder)} nf ^{:tag (* ir/Name)} n]
  (when (== (.-ro nf) nil)
    (return true))

  (.Reassigned (.-ro nf) n))


^{:go/end 122} (go/method isConcreteConvIface ^bool [^{:tag (* nameFinder)} nf ^ir/Node n]
  (let [sv n]
    (when (!= (.-ro nf) nil)
      (set! sv (.StaticValue (.-ro nf) n)))

    (when (!= (.Op sv) ir/OCONVIFACE)
      (return false))

    (not (.IsInterface (.Type (.-X (assert (* ir/ConvExpr) sv)))))))


^{:go/end 129} (go/func isSameFuncName ^bool [^{:tag (* ir/Name)} v1 ^{:tag (* ir/Name)} v2]
  ;; NB: there are a few corner cases where pointer equality
  ;; doesn't work here, but this should be good enough for
  ;; our purposes here.
  (== v1 v2))

(in-ns 'go.cmd.compile.internal.inline.inlheur) (go/file "serialize.go" :imports [

    ^{:line 7} [strings "strings"]])

^{:go/end 24} (go/method SerializeToString ^string [^{:tag (* FuncProps)} funcProps]
  (when (== funcProps nil)
    (return ""))

  (let [^strings/Builder sb (zero strings/Builder)]
    (writeUleb128 (addr sb) (conv uint64 (.-Flags funcProps)))
    (writeUleb128 (addr sb) (conv uint64 (len (.-ParamFlags funcProps))))
    (range [_ pf (.-ParamFlags funcProps)]
      (writeUleb128 (addr sb) (conv uint64 pf)))

    (writeUleb128 (addr sb) (conv uint64 (len (.-ResultFlags funcProps))))
    (range [_ rf (.-ResultFlags funcProps)]
      (writeUleb128 (addr sb) (conv uint64 rf)))

    (.String sb)))


^{:go/end 48} (go/func DeserializeFromString ^{:tag (* FuncProps)} [^string s]
  (when (== (len s) 0)
    (return nil))

  (let [^FuncProps funcProps (zero FuncProps)
      ^{:line 31 :tag uint64} v (zero uint64)
      ^{:line 32} sl (conv (slice byte) s)]
    (set! (values v sl) (readULEB128 sl))
    (set! (.-Flags funcProps) (conv FuncPropBits v))
    (set! (values v sl) (readULEB128 sl))
    (set! (.-ParamFlags funcProps) (make (slice ParamPropBits) v))
    (range [i (.-ParamFlags funcProps)]
      (set! (values v sl) (readULEB128 sl))
      (aset (.-ParamFlags funcProps) i (conv ParamPropBits v)))

    (set! (values v sl) (readULEB128 sl))
    (set! (.-ResultFlags funcProps) (make (slice ResultPropBits) v))
    (range [i (.-ResultFlags funcProps)]
      (set! (values v sl) (readULEB128 sl))
      (aset (.-ResultFlags funcProps) i (conv ResultPropBits v)))

    (addr funcProps)))


^{:go/end 63} (go/func readULEB128 [^{:tag (slice byte)} sl] :results [^uint64 value ^{:tag (slice byte)} rsl]
  (let [^uint shift (zero uint)]

    (while true
      (let [b (aget sl 0)]
        (set! sl (subslice sl 1))
        (set! value bit-or (<< (conv uint64 (bit-and b 0x7F)) shift))
        (when (== (bit-and b 0x80) 0)
          (break))

        (set! shift + 7)))

    (return value sl)))


^{:go/end 80} (go/func writeUleb128 [^{:tag (* strings/Builder)} sb ^uint64 v]
  (when (< v 128)
    (.WriteByte sb (conv uint8 v))
    (return))

  (let [more true]
    (while more
      (let [c (conv uint8 (bit-and v 0x7f))]
        (set! v >> 7)
        (set! more (!= v 0))
        (when more
          (set! c bit-or 0x80))

        (.WriteByte sb c)))))

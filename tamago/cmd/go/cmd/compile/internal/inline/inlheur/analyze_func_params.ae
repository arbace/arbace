^{:go/end 303} (go/method nodeVisitPost [^{:tag (* paramsAnalyzer)} pa ^ir/Node n]
  (when (== (len (.-values pa)) 0)
    (return))

  (.post (.-condLevelTracker pa) n)
  (switch (.Op n)
    (case [ir/OCALLFUNC]
      (let [ce (assert (* ir/CallExpr) n)]
        (.callCheckParams pa ce)))
    (case [ir/OCALLINTER]
      (let [ce (assert (* ir/CallExpr) n)]
        (.callCheckParams pa ce)))
    (case [ir/OIF]
      (let [ifst (assert (* ir/IfStmt) n)]
        (.foldCheckParams pa (.-Cond ifst))))
    (case [ir/OSWITCH]
      (let [swst (assert (* ir/SwitchStmt) n)]
        (when (!= (.-Tag swst) nil)
          (.foldCheckParams pa (.-Tag swst)))))))




^{:go/end 310} (go/method nodeVisitPre [^{:tag (* paramsAnalyzer)} pa ^ir/Node n]
  (when (== (len (.-values pa)) 0)
    (return))

  (.pre (.-condLevelTracker pa) n))




















(go/type condLevelTracker "condLevelTracker helps keeps track very roughly of \"level of conditional\nnesting\", e.g. how many \"if\" statements you have to go through to\nget to the point where a given stmt executes. Example:\n\n\t                      cond nesting level\n\tfunc foo() {\n\t G = 1                   0\n\t if x < 10 {             0\n\t  if y < 10 {            1\n\t   G = 0                 2\n\t  }\n\t }\n\t}\n\nThe intent here is to provide some sort of very abstract relative\nhotness metric, e.g. \"G = 1\" above is expected to be executed more\noften than \"G = 0\" (in the aggregate, across large numbers of\nfunctions).\n" (struct
    ^{:line 331 :tag int} condLevel))


^{:go/end 344} (go/method pre [^{:tag (* condLevelTracker)} c ^ir/Node n]
  ;; Increment level of "conditional testing" if we see
  ;; an "if" or switch statement, and decrement if in
  ;; a loop.
  (switch (.Op n)
    (case [ir/OIF ir/OSWITCH]
      (inc! (.-condLevel c)))
    (case [ir/OFOR ir/ORANGE]
      (dec! (.-condLevel c)))))



^{:go/end 355} (go/method post [^{:tag (* condLevelTracker)} c ^ir/Node n]
  (switch (.Op n)
    (case [ir/OFOR ir/ORANGE]
      (inc! (.-condLevel c)))
    (case [ir/OIF]
      (dec! (.-condLevel c)))
    (case [ir/OSWITCH]
      (dec! (.-condLevel c)))))

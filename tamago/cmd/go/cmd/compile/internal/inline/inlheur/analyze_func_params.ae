      (continue))

    (let [(values result may) (testf x p idx)]
      (when (!= (bit-and debugTrace debugTraceParams) 0)
        (fmt/Fprintf os/Stderr "=-= test expr %v param %s result=%v flag=%s\n" x (.-Name (.Sym p)) result (.String flag)))


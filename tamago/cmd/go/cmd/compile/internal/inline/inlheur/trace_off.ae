(in-ns 'go.cmd.compile.internal.inline.inlheur) (go/file "trace_off.go" :build ["//go:build !debugtrace"] :imports [])

(go/const ^{:val 0} debugTrace 0)

^{:go/end 12} (go/func enableDebugTrace [^int x])


^{:go/end 15} (go/func enableDebugTraceIfEnv [])


^{:go/end 18} (go/func disableDebugTrace [])

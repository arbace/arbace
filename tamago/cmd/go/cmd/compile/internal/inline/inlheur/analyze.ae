^{:go/end 246} (go/func DumpFuncProps "DumpFuncProps computes and caches function properties for the func\n'fn', writing out a description of the previously computed set of\nproperties to the file given in 'dumpfile'. Used for the\n\"-d=dumpinlfuncprops=...\" command line flag, intended for use\nprimarily in unit testing.\n" [^{:tag (* ir/Func)} fn ^string dumpfile]
  (if (!= fn nil) (do
      (when (!= (.-OClosure fn) nil)
        ;; closures will be processed along with their outer enclosing func.
        (return))

      (captureFuncDumpEntry fn)
      (ir/VisitFuncAndClosures fn ^{:go/end 242} (fn [^ir/Node n]
          (when [(values clo ok) (assert (* ir/ClosureExpr) n)] ok
            (captureFuncDumpEntry (.-Func clo))))))



    (emitDumpToFile dumpfile)))







^{:go/end 292} (go/func emitDumpToFile "emitDumpToFile writes out the buffer function property dump entries\nto a file, for unit testing. Dump entries need to be sorted by\ndefinition line, and due to generics we need to account for the\npossibility that several ir.Func's will have the same def line.\n" [^string dumpfile]
  (let [mode (bit-or os/O_WRONLY os/O_CREATE os/O_TRUNC)]
    (when (== (aget dumpfile 0) \+)
      (set! dumpfile (subslice dumpfile 1))
      (set! mode (bit-or os/O_WRONLY os/O_APPEND os/O_CREATE)))

    (when (== (aget dumpfile 0) \%)
      (set! dumpfile (subslice dumpfile 1))
      (let [(values d b) (values (filepath/Dir dumpfile) (filepath/Base dumpfile))
          ^{:line 261} ptag (strings/ReplaceAll (.-Path types/LocalPkg) "/" ":")]
        (set! dumpfile (+ d "/" ptag "." b))))

    (let [(values outf err) (os/OpenFile dumpfile mode 0644)]
      (when (!= err nil)
        (base/Fatalf "opening function props dump file %q: %v\n" dumpfile err))

      (defer (.Close outf))
      (dumpFilePreamble outf)

      (let [atline (lit (map uint uint))
          ^{:line 272} sl (make (slice fnInlHeur) 0 (len dumpBuffer))]
        (range [_ e dumpBuffer]
          (set! sl (append sl e))
          (aset atline (.-line e) (+ (aget atline (.-line e)) 1)))

        (set! sl (sortFnInlHeurSlice sl))

        (let [prevline (conv uint 0)]
          (range [_ entry sl]
            (let [idx (conv uint 0)]
              (when (== prevline (.-line entry))
                (inc! idx))

              (set! prevline (.-line entry))
              (let [atl (aget atline (.-line entry))]
                (when [err (dumpFnPreamble outf (addr entry) nil idx atl)] (!= err nil)
                  (base/Fatalf "function props dump: %v\n" err)))))


          (set! dumpBuffer nil))))))






^{:go/end 320} (go/func captureFuncDumpEntry "captureFuncDumpEntry grabs the function properties object for 'fn'\nand enqueues it for later dumping. Used for the\n\"-d=dumpinlfuncprops=...\" command line flag, intended for use\nprimarily in unit testing.\n" [^{:tag (* ir/Func)} fn]
  ;; avoid capturing compiler-generated equality funcs.
  (when (strings/HasPrefix (.-Name (.Sym fn)) ".eq.")
    (return))

  (let [(values funcInlHeur ok) (aget fpmap fn)]
    (when (not ok)
      ;; Missing entry is expected for functions that are too large
      ;; to inline. We still want to write out call site scores in
      ;; this case however.
      (set! funcInlHeur (lit fnInlHeur :cstab callSiteTab)))

    (when (== dumpBuffer nil)
      (set! dumpBuffer (make (map (* ir/Func) fnInlHeur))))

    (when [(values _ ok) (aget dumpBuffer fn)] ok
      (return))

    (when (!= (bit-and debugTrace debugTraceFuncs) 0)
      (fmt/Fprintf os/Stderr "=-= capturing dump for %v:\n" fn))

    (aset dumpBuffer fn funcInlHeur)))




^{:go/end 329} (go/func dumpFilePreamble "dumpFilePreamble writes out a file-level preamble for a given\nGo function as part of a function properties dump.\n" [^io/Writer w]
  (fmt/Fprintf w "// DO NOT EDIT (use 'go test -v -update-expected' instead.)\n")
  (fmt/Fprintf w "// See cmd/compile/internal/inline/inlheur/testdata/props/README.txt\n")
  (fmt/Fprintf w "// for more information on the format of this file.\n")
  (fmt/Fprintf w "// %s\n" preambleDelimiter))






^{:go/end 348} (go/func dumpFnPreamble "dumpFnPreamble writes out a function-level preamble for a given\nGo function as part of a function properties dump. See the\nREADME.txt file in testdata/props for more on the format of\nthis preamble.\n" ^error [^io/Writer w ^{:tag (* fnInlHeur)} funcInlHeur ^encodedCallSiteTab ecst ^uint idx ^uint atl]
  (fmt/Fprintf w "// %s %s %d %d %d\n"
    (.-file funcInlHeur) (.-fname funcInlHeur) (.-line funcInlHeur) idx atl)
  ;; emit props as comments, followed by delimiter
  (fmt/Fprintf w "%s// %s\n" (.ToString (.-props funcInlHeur) "// ") comDelimiter)
  ^{:go/breaks [6]} (let [(values data err) (json/Marshal (.-props funcInlHeur))]
    (when (!= err nil)
      (return (fmt/Errorf "marshal error %v\n" err)))

    (fmt/Fprintf w "// %s\n" (conv string data))
    (dumpCallSiteComments w (.-cstab funcInlHeur) ecst)
    (fmt/Fprintf w "// %s\n" fnDelimiter)
    nil))




^{:go/end 360} (go/func sortFnInlHeurSlice "sortFnInlHeurSlice sorts a slice of fnInlHeur based on\nthe starting line of the function definition, then by name.\n" ^{:tag (slice fnInlHeur)} [^{:tag (slice fnInlHeur)} sl]
  (^{:inst [(slice fnInlHeur) fnInlHeur]} slices/SortStableFunc sl ^{:go/end 358} (fn ^int [^fnInlHeur a ^fnInlHeur b]
      (when (!= (.-line a) (.-line b))
        (return (^{:inst [uint]} cmp/Compare (.-line a) (.-line b))))

      (strings/Compare (.-fname a) (.-fname b))))

  ^{:line 359} sl)





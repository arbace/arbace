(go/type propAnalyzer "propAnalyzer interface is used for defining one or more analyzer\nhelper objects, each tasked with computing some specific subset of\nthe properties we're interested in. The assumption is that\nproperties are independent, so each new analyzer that implements\nthis interface can operate entirely on its own. For a given analyzer\nthere will be a sequence of calls to nodeVisitPre and nodeVisitPost\nas the nodes within a function are visited, then a followup call to\nsetResults so that the analyzer can transfer its results into the\nfinal properties object.\n" (interface
    (nodeVisitPre [^ir/Node n])
    (nodeVisitPost [^ir/Node n])
    (setResults [^{:tag (* FuncProps)} funcProps])))









(go/type fnInlHeur "fnInlHeur contains inline heuristics state information about a\nspecific Go function being analyzed/considered by the inliner. Note\nthat in addition to constructing a fnInlHeur object by analyzing a\nspecific *ir.Func, there is also code in the test harness\n(funcprops_test.go) that builds up fnInlHeur's by reading in and\nparsing a dump. This is the reason why we have file/fname/line\nfields below instead of just an *ir.Func field.\n" (struct
    ^{:line 55 :tag (* FuncProps)} props
    ^{:line 56 :tag CallSiteTab} cstab
    ^{:line 57 :tag string} fname
    ^{:line 58 :tag string} file
    ^{:line 59 :tag uint} line))


(go/var fpmap (lit (map (* ir/Func) fnInlHeur)))







^{:go/end 115} (go/func AnalyzeFunc "AnalyzeFunc computes function properties for fn and its contained\nclosures, updating the global 'fpmap' table. It is assumed that\n\"CanInline\" has been run on fn and on the closures that feed\ndirectly into calls; other closures not directly called will also\nbe checked inlinability for inlinability here in case they are\nreturned as a result.\n" [^{:tag (* ir/Func)} fn ^{:tag (func [(* ir/Func)])} canInline ^{:tag (func [(* ir/Func)] [int32])} budgetForFunc ^int inlineMaxBudget]
  (when (== fpmap nil)
    ;; If fpmap is nil this indicates that the main inliner pass is
    ;; complete and we're doing inlining of wrappers (no heuristics
    ;; used here).
    (return))

  (when (!= (.-OClosure fn) nil)
    ;; closures will be processed along with their outer enclosing func.
    (return))

  (enableDebugTraceIfEnv)
  (when (!= (bit-and debugTrace debugTraceFuncs) 0)
    (fmt/Fprintf os/Stderr "=-= AnalyzeFunc(%v)\n" fn))

  ;; Build up a list containing 'fn' and any closures it contains. Along
  ;; the way, test to see whether each closure is inlinable in case
  ;; we might be returning it.
  (let [funcs (lit (slice (* ir/Func)) fn)]
    (ir/VisitFuncAndClosures fn ^{:go/end 93} (fn [^ir/Node n]
        (when [(values clo ok) (assert (* ir/ClosureExpr) n)] ok
          (set! funcs (append funcs (.-Func clo))))))



    ;; Analyze the list of functions. We want to visit a given func
    ;; only after the closures it contains have been processed, so
    ;; iterate through the list in reverse order. Once a function has
    ;; been analyzed, revisit the question of whether it should be
    ;; inlinable; if it is over the default hairiness limit and it
    ;; doesn't have any interesting properties, then we don't want
    ;; the overhead of writing out its inline body.
    (let [nameFinder (newNameFinder fn)]
      (for [i (- (len funcs) 1)] (>= i 0) (dec! i)
        (let [f (aget funcs i)]
          (when (and (!= (.-OClosure f) nil) (not (.InlinabilityChecked f)))
            (canInline f))

          (let [funcProps (analyzeFunc f inlineMaxBudget nameFinder)]
            (revisitInlinability f funcProps budgetForFunc)
            (when (!= (.-Inl f) nil)
              (set! (.-Properties (.-Inl f)) (.SerializeToString funcProps))))))


      (disableDebugTrace))))






^{:go/end 125} (go/func TearDown "TearDown is invoked at the end of the main inlining pass; doing\nfunction analysis and call site scoring is unlikely to help a lot\nafter this point, so nil out fpmap and other globals to reclaim\nstorage.\n" []
  (set! fpmap nil)
  (set! (.-tab scoreCallsCache) nil)
  (set! (.-csl scoreCallsCache) nil))


^{:go/end 146} (go/func analyzeFunc ^{:tag (* FuncProps)} [^{:tag (* ir/Func)} fn ^int inlineMaxBudget ^{:tag (* nameFinder)} nf]
  (when [(values funcInlHeur ok) (aget fpmap fn)] ok
    (return (.-props funcInlHeur)))

  (let [(values funcProps fcstab) (computeFuncProps fn inlineMaxBudget nf)
      (values file line) (fnFileLine fn)
      ^{:line 133} entry ^{:go/breaks [2 4 6 8 10]} (lit fnInlHeur
        :fname (.-Name (.Sym fn))
        :file file
        :line line
        :props funcProps
        :cstab fcstab)]

    (.SetNeverReturns fn (!= (bit-and (.-Flags (.-props entry)) FuncPropNeverReturns) 0))
    (aset fpmap fn entry)
    (when (and (!= (.-Inl fn) nil) (== (.-Properties (.-Inl fn)) ""))
      (set! (.-Properties (.-Inl fn)) (.SerializeToString (.-props entry))))

    ^{:line 145} funcProps))








^{:go/end 163} (go/func revisitInlinability "revisitInlinability revisits the question of whether to continue to\ntreat function 'fn' as an inline candidate based on the set of\nproperties we've computed for it. If (for example) it has an\ninitial size score of 150 and no interesting properties to speak\nof, then there isn't really any point to moving ahead with it as an\ninline candidate.\n" [^{:tag (* ir/Func)} fn ^{:tag (* FuncProps)} funcProps ^{:tag (func [(* ir/Func)] [int32])} budgetForFunc]
  (when (== (.-Inl fn) nil)
    (return))

  (let [maxAdj (conv int32 (LargestNegativeScoreAdjustment fn funcProps))
      ^{:line 159} budget (budgetForFunc fn)]
    (when (> (+ (.-Cost (.-Inl fn)) maxAdj) budget)
      (set! (.-Inl fn) nil))))






^{:go/end 184} (go/func computeFuncProps "computeFuncProps examines the Go function 'fn' and computes for it\na function \"properties\" object, to be used to drive inlining\nheuristics. See comments on the FuncProps type for more info.\n" [^{:tag (* ir/Func)} fn ^int inlineMaxBudget ^{:tag (* nameFinder)} nf] :results [(* FuncProps) CallSiteTab]
  (when (!= (bit-and debugTrace debugTraceFuncs) 0)
    (fmt/Fprintf os/Stderr "=-= starting analysis of func %v:\n%+v\n"
      ^{:line 171} fn fn))

  (let [funcProps (new FuncProps)
      ^{:line 174} ffa (makeFuncFlagsAnalyzer fn)
      ^{:line 175} analyzers (lit (slice propAnalyzer) ffa)]
    (set! analyzers (addResultsAnalyzer fn analyzers funcProps inlineMaxBudget nf))
    (set! analyzers (addParamsAnalyzer fn analyzers funcProps nf))
    (runAnalyzersOnFunction fn analyzers)
    (range [_ a analyzers]
      (.setResults a funcProps))

    (let [cstab (computeCallSiteTable fn (.-Body fn) nil (.panicPathTable ffa) 0 nf)]
      (return funcProps cstab))))


^{:go/end 199} (go/func runAnalyzersOnFunction [^{:tag (* ir/Func)} fn ^{:tag (slice propAnalyzer)} analyzers]
  (let [^{:tag (func [ir/Node] [bool])} doNode (zero (func [ir/Node] [bool]))]
    (set! doNode ^{:go/breaks [[5 196]] :go/end 197} (fn ^bool [^ir/Node n]
        (range [_ a analyzers]
          (.nodeVisitPre a n))

        (ir/DoChildren n doNode)
        (range [_ a analyzers]
          (.nodeVisitPost a n))

        false))

    (doNode fn)))


^{:go/breaks [[4 209]] :go/end 210} (go/func propsForFunc ^{:tag (* FuncProps)} [^{:tag (* ir/Func)} fn]
  (if [(values funcInlHeur ok) (aget fpmap fn)] ok
    (return (.-props funcInlHeur))
    (when (and (!= (.-Inl fn) nil) (!= (.-Properties (.-Inl fn)) ""))
      ;; FIXME: considering adding some sort of cache or table
      ;; for deserialized properties of imported functions.
      (return (DeserializeFromString (.-Properties (.-Inl fn))))))

  nil)


^{:go/end 215} (go/func fnFileLine [^{:tag (* ir/Func)} fn] :results [string uint]
  (let [p (.InnermostPos base/Ctxt ^{:go/via [miniNode]} (.Pos fn))]
    (return (filepath/Base (.Filename p)) ^{:go/via [lico]} (.Line p))))


^{:go/end 219} (go/func Enabled ^bool []
  (or ^{:go/via [Flags]} (.-NewInliner buildcfg/Experiment) (UnitTesting)))


^{:go/end 224} (go/func UnitTesting ^bool []
  (or (!= (.-DumpInlFuncProps base/Debug) "")

(in-ns 'go.cmd.compile.internal.inline.inlheur) (go/file "funcprop_string.go" :imports [


    ^{:line 8} [fmt "fmt"]
    ^{:line 9} [strings "strings"]])


^{:go/end 14} (go/method String ^string [^{:tag (* FuncProps)} fp]
  (.ToString fp ""))


^{:go/end 26} (go/method ToString ^string [^{:tag (* FuncProps)} fp ^string prefix]
  (let [^strings/Builder sb (zero strings/Builder)]
    (when (!= (.-Flags fp) 0)
      (fmt/Fprintf (addr sb) "%sFlags %s\n" prefix (.-Flags fp)))

    ((inst flagSliceToSB ParamPropBits) (addr sb) (.-ParamFlags fp)
      ^{:line 22} prefix "ParamFlags")
    ((inst flagSliceToSB ResultPropBits) (addr sb) (.-ResultFlags fp)
      ^{:line 24} prefix "ResultFlags")
    (.String sb)))


^{:go/end 44} (go/func flagSliceToSB :type-params [^{:tag (interface (tilde uint32) (String ^string []))} T]


  ^{:line 31} [^{:tag (* strings/Builder)} sb ^{:tag (slice T)} sl ^string prefix ^{:go/grouped false :tag string} tag]
  (let [^strings/Builder sb2 (zero strings/Builder)
      ^{:line 33} foundnz false]
    (fmt/Fprintf (addr sb2) "%s%s\n" prefix tag)
    (range [i e sl]
      (when (!= e 0)
        (set! foundnz true))

      (fmt/Fprintf (addr sb2) "%s  %d %s\n" prefix i (.String e)))

    (when foundnz
      (.WriteString sb (.String sb2)))))

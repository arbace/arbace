^{:go/end 67} (go/method setResults "setResults transfers func flag results to 'funcProps'.\n" [^{:tag (* funcFlagsAnalyzer)} ffa ^{:tag (* FuncProps)} funcProps]
  (let [^FuncPropBits rv (zero FuncPropBits)]
    (when (and (not (.-noInfo ffa)) (== (.stateForList ffa (.-Body (.-fn ffa))) psCallsPanic))
      (set! rv FuncPropNeverReturns))

    ;; This is slightly hacky and not at all required, but include a
    ;; special case for main.main, which often ends in a call to
    ;; os.Exit. People who write code like this (very common I
    ;; imagine)
    ;;
    ;;   func main() {
    ;;     rc = perform()
    ;;     ...
    ;;     foo()
    ;;     os.Exit(rc)
    ;;   }
    ;;
    ;; will be constantly surprised when foo() is inlined in many
    ;; other spots in the program but not in main().
    (when (isMainMain (.-fn ffa))
      (set! rv bit-and-not FuncPropNeverReturns))

    (set! (.-Flags funcProps) rv)))


^{:go/end 71} (go/method getState ^pstate [^{:tag (* funcFlagsAnalyzer)} ffa ^ir/Node n]
  (aget (.-nstate ffa) n))


^{:go/end 77} (go/method setState [^{:tag (* funcFlagsAnalyzer)} ffa ^ir/Node n ^pstate st]
  (when (!= st psNoInfo)
    (aset (.-nstate ffa) n st)))



^{:go/end 85} (go/method updateState [^{:tag (* funcFlagsAnalyzer)} ffa ^ir/Node n ^pstate st]
  (if (== st psNoInfo)
    (delete (.-nstate ffa) n)

    (aset (.-nstate ffa) n st)))



^{:go/end 89} (go/method panicPathTable ^{:tag (map ir/Node pstate)} [^{:tag (* funcFlagsAnalyzer)} ffa]
  (.-nstate ffa))















^{:go/end 122} (go/func blockCombine "blockCombine merges together states as part of a linear sequence of\nstatements, where 'pred' and 'succ' are analysis results for a pair\nof consecutive statements. Examples:\n\n\tcase 1:             case 2:\n\t    panic(\"foo\")      if q { return x }        <-pred\n\t    return x          panic(\"boo\")             <-succ\n\nIn case 1, since the pred state is \"always panic\" it doesn't matter\nwhat the succ state is, hence the state for the combination of the\ntwo blocks is \"always panics\". In case 2, because there is a path\nto return that avoids the panic in succ, the state for the\ncombination of the two statements is \"may return\".\n" ^pstate [^pstate pred ^pstate succ]
  (switch succ
    (case [psTop]
      (return pred))
    (case [psMayReturn]
      (when (== pred psCallsPanic)
        (return psCallsPanic))

      (return psMayReturn))
    (case [psNoInfo]
      (return pred))
    (case [psCallsPanic]
      (when (== pred psMayReturn)
        (return psMayReturn))

      (return psCallsPanic)))

  (panic "should never execute"))




^{:go/end 134} (go/func branchCombine "branchCombine combines two states at a control flow branch point where\neither p1 or p2 executes (as in an \"if\" statement).\n" ^pstate [^pstate p1 ^pstate p2]
  (when (and (== p1 psCallsPanic) (== p2 psCallsPanic))
    (return psCallsPanic))

  (when (or (== p1 psMayReturn) (== p2 psMayReturn))
    (return psMayReturn))

  ^{:line 133} psNoInfo)





^{:go/end 169} (go/method stateForList "stateForList walks through a list of statements and computes the\nstate/disposition for the entire list as a whole, as well\nas updating disposition of intermediate nodes.\n" ^pstate [^{:tag (* funcFlagsAnalyzer)} ffa ^ir/Nodes list]
  (let [st psTop]
    ;; Walk the list backwards so that we can update the state for
    ;; earlier list elements based on what we find out about their
    ;; successors. Example:
    ;;
    ;;        if ... {
    ;;  L10:    foo()
    ;;  L11:    <stmt>
    ;;  L12:    panic(...)
    ;;        }
    ;;
    ;; After combining the dispositions for line 11 and 12, we want to
    ;; update the state for the call at line 10 based on that combined
    ;; disposition (if L11 has no path to "return", then the call at
    ;; line 10 will be on a panic path).
    (for [i (- (len list) 1)] (>= i 0) (dec! i)
      (let [n (aget list i)
          ^{:line 157} psi (.getState ffa n)]
        (when (!= (bit-and debugTrace debugTraceFuncFlags) 0)
          (fmt/Fprintf os/Stderr "=-= %v: stateForList n=%s ps=%s\n"
            (ir/Line n) (.String (.Op n)) (.String psi)))

        (set! st (blockCombine psi st))
        (.updateState ffa n st)))

    (when (== st psTop)
      (set! st psNoInfo))

    ^{:line 168} st))


^{:go/end 174} (go/func isMainMain ^bool [^{:tag (* ir/Func)} fn]
  (let [s (.Sym fn)]
    (and (== (.-Name (.-Pkg s)) "main") (== (.-Name s) "main"))))


^{:go/end 178} (go/func isWellKnownFunc ^bool [^{:tag (* types/Sym)} s ^string pkg ^string name]
  (and (== (.-Path (.-Pkg s)) pkg) (== (.-Name s) name)))




^{:go/end 202} (go/func isExitCall "isExitCall reports TRUE if the node itself is an unconditional\ncall to os.Exit(), a panic, or a function that does likewise.\n" ^bool [^ir/Node n]
  (when (!= (.Op n) ir/OCALLFUNC)
    (return false))

  (let [cx (assert (* ir/CallExpr) n)
      ^{:line 187} name (ir/StaticCalleeName (.-Fun cx))]
    (when (== name nil)
      (return false))

    (let [s (.Sym name)]
      (when (or (isWellKnownFunc s "os" "Exit")
          (isWellKnownFunc s "runtime" "throw"))
        (return true))

      (when [funcProps (propsForFunc (.-Func name))] (!= funcProps nil)
        (when (!= (bit-and (.-Flags funcProps) FuncPropNeverReturns) 0)
          (return true)))


      (.NeverReturns (.-Func name)))))




^{:go/end 208} (go/method pessimize "pessimize is called to record the fact that we saw something in the\nfunction that renders it entirely impossible to analyze.\n" [^{:tag (* funcFlagsAnalyzer)} ffa]
  (set! (.-noInfo ffa) true))







^{:go/end 219} (go/func shouldVisit "shouldVisit reports TRUE if this is an interesting node from the\nperspective of computing function flags. NB: due to the fact that\nir.CallExpr implements the Stmt interface, we wind up visiting\na lot of nodes that we don't really need to, but these can\nsimply be screened out as part of the visit.\n" ^bool [^ir/Node n]

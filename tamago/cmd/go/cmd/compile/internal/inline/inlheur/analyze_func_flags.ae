          (set! st (.stateForList ffa (.-Body ccst)))
          (if [(values ccst ok) (assert (* ir/CommClause) n)] ok
            (set! st (.stateForList ffa (.-Body ccst)))

            (panic "unexpected"))))

      (case [ir/OIF]
        (let [n (assert (* ir/IfStmt) n)]
          (set! st (branchCombine (.stateForList ffa (.-Body n)) (.stateForList ffa (.-Else n))))))
      (case [ir/OFOR]
        ;; Treat for { XXX } like a block.
        ;; Treat for <cond> { XXX } like an if statement with no else.
        (let [n (assert (* ir/ForStmt) n)
            ^{:line 281} bst (.stateForList ffa (.-Body n))]
          (if (== (.-Cond n) nil)

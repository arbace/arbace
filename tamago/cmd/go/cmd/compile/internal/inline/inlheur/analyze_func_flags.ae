(go/type funcFlagsAnalyzer "funcFlagsAnalyzer computes the \"Flags\" value for the FuncProps\nobject we're computing. The main item of interest here is \"nstate\",\nwhich stores the disposition of a given ir Node with respect to the\nflags/properties we're trying to compute.\n" (struct
    ^{:line 20 :tag (* ir/Func)} fn
    ^{:line 21 :tag (map ir/Node pstate)} nstate
    ^{:line 22 :tag bool} noInfo)) ; set if we see something inscrutable/un-analyzable




(go/type pstate "pstate keeps track of the disposition of a given node and its\nchildren with respect to panic/exit calls.\n" int)

(go/const
  ^{:line 30} [^{:tag pstate :val 0} psNoInfo iota] ; nothing interesting about this node
  ^{:line 31} [^{:val 1} psCallsPanic] ; node causes call to panic or os.Exit
  ^{:line 32} [^{:val 2} psMayReturn] ; executing node may trigger a "return" stmt
  ^{:line 33} [^{:val 3} psTop]) ; dataflow lattice "top" element


^{:go/end 41} (go/func makeFuncFlagsAnalyzer ^{:tag (* funcFlagsAnalyzer)} [^{:tag (* ir/Func)} fn]
  (addr ^{:go/breaks [2 4]} (lit funcFlagsAnalyzer

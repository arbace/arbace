      (case [ir/OSWITCH]
        (let [n (assert (* ir/SwitchStmt) n)]
          (when (!= (len (.-Cases n)) 0)
            (set! st psTop)
            (range [_ c (.-Cases n)]
              (set! st (branchCombine (.stateForList ffa (.-Body c)) st))))



          (let [(values st fall) (values psTop psNoInfo)]
            (for [i (- (len (.-Cases n)) 1)] (>= i 0) (dec! i)
              (let [cas (aget (.-Cases n) i)
                  ^{:line 321} cst (.stateForList ffa (.-Body cas))
                  ^{:line 322} endsInFallthrough false]
                (when (!= (len (.-Body cas)) 0)
                  (set! endsInFallthrough (== (.Op (aget (.-Body cas) 0)) ir/OFALL)))

                (when endsInFallthrough
                  (set! cst (blockCombine cst fall)))

                (set! st (branchCombine st cst))
                (set! fall cst))))))

      (case [ir/OFALL])
      ;; Not important.
      (case [ir/ODCLFUNC ir/ORECOVER ir/OAS ir/OAS2 ir/OAS2FUNC ir/OASOP
          ^{:line 335} ir/OPRINTLN ir/OPRINT ir/OLABEL ir/OCALLINTER ir/ODEFER
          ^{:line 336} ir/OSEND ir/ORECV ir/OSELRECV2 ir/OGO ir/OAPPEND ir/OAS2DOTTYPE
          ^{:line 337} ir/OAS2MAPR ir/OGETG ir/ODELETE ir/OINLMARK ir/OAS2RECV
          ^{:line 338} ir/OMIN ir/OMAX ir/OMAKE ir/OGETCALLERSP])

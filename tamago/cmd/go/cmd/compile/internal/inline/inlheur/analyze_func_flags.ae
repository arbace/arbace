      (default
        (base/Fatalf "%v: unhandled op %s in func %v"
          (ir/Line n) (.String (.Op n)) (ir/FuncName (.-fn ffa)))))

    (when (!= (bit-and debugTrace debugTraceFuncFlags) 0)
      (fmt/Fprintf os/Stderr "=-= %v: visit n=%s returns %s\n"
        (ir/Line n) (.String (.Op n)) (.String st)))

    (.setState ffa n st)))



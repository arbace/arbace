^{:go/end 353} (go/method nodeVisitPost "nodeVisitPost helps implement the propAnalyzer interface; when\ncalled on a given node, it decides the disposition of that node\nbased on the state(s) of the node's children.\n" [^{:tag (* funcFlagsAnalyzer)} ffa ^ir/Node n]
  (when (!= (bit-and debugTrace debugTraceFuncFlags) 0)
    (fmt/Fprintf os/Stderr "=+= nodevis %v %s should=%v\n"
      (ir/Line n) (.String (.Op n)) (shouldVisit n)))

  (when (not (shouldVisit n))
    (return))

  (let [^pstate st (zero pstate)]
    (switch (.Op n)
      (case [ir/OCALLFUNC]
        (when (isExitCall n)
          (set! st psCallsPanic)))

      (case [ir/OPANIC]
        (set! st psCallsPanic))
      (case [ir/ORETURN]
        (set! st psMayReturn))
      (case [ir/OBREAK ir/OCONTINUE]
        ;; FIXME: this handling of break/continue is sub-optimal; we
        ;; have them as "mayReturn" in order to help with this case:
        ;;
        ;;   for {
        ;;     if q() { break }
        ;;     panic(...)
        ;;   }
        ;;
        ;; where the effect of the 'break' is to cause the subsequent
        ;; panic to be skipped. One possible improvement would be to
        ;; track whether the currently enclosing loop is a "for {" or
        ;; a for/range with condition, then use mayReturn only for the
        ;; former. Note also that "break X" or "continue X" is treated
        ;; the same as "goto", since we don't have a good way to track
        ;; the target of the branch.
        (set! st psMayReturn)
        (let [n (assert (* ir/BranchStmt) n)]
          (when (!= (.-Label n) nil)
            (.pessimize ffa))))

      (case [ir/OBLOCK]
        (let [n (assert (* ir/BlockStmt) n)]
          (set! st (.stateForList ffa (.-List n)))))
      (case [ir/OCASE]

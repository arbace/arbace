^{:go/end 143} (go/func parseScoreAdj ^error [^string val]
  ^{:go/breaks [[4 142]]} (let [clauses (strings/Split val "/")]
    (when (== (len clauses) 0)
      (return (fmt/Errorf "no clauses")))

    (range [_ clause clauses]
      (let [elems (strings/Split clause ":")]
        (when (< (len elems) 2)
          (return (fmt/Errorf "clause %q: expected colon" clause)))

        (when (!= (len elems) 2)
          (return (fmt/Errorf "clause %q has %d elements, wanted 2" clause
              (len elems))))

        (let [(values adj ok) (adjStringToVal (aget elems 0))]
          (when (not ok)
            (return (fmt/Errorf "clause %q: unknown adjustment" clause)))

          (let [(values val err) (strconv/Atoi (aget elems 1))]
            (when (!= err nil)
              (return (fmt/Errorf "clause %q: malformed value: %v" clause err)))

            (aset adjValues adj val)))))

    nil))



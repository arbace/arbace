^{:go/end 107} (go/func SetupScoreAdjustments "SetupScoreAdjustments interprets the value of the -d=inlscoreadj\ndebugging option, if set. The value of this flag is expected to be\na series of \"/\"-separated clauses of the form adj1:value1. Example:\n-d=inlscoreadj=inLoopAdj=0/passConstToIfAdj=-99\n" []
  (when (== (.-InlScoreAdj base/Debug) "")
    (return))


^{:go/end 339} (go/func adjustScore [^scoreAdjustTyp typ ^int score ^scoreAdjustTyp mask] :results [int scoreAdjustTyp]

  (cond (isMust typ) (do
      (when (!= (bit-and mask typ) 0)
        (return score mask))

      (let [may (mustToMay typ)]
        (when (!= (bit-and mask may) 0)
          ;; promote may to must, so undo may
          (set! score - (adjValue may))
          (set! mask bit-and-not may))))

    (isMay typ)
    (let [must (mayToMust typ)]
      (when (!= (bit-and mask (bit-or must typ)) 0)
        (return score mask))))


  (when (== (bit-and mask typ) 0)
    (when (!= (bit-and debugTrace debugTraceScoring) 0)
      (fmt/Fprintf os/Stderr "=-= applying adj %d for %s\n"
        (adjValue typ) (.String typ)))

    (set! score + (adjValue typ))
    (set! mask bit-or typ))

  (return score mask))



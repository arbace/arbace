            (panic "missing call to ScoreCallsCleanup"))

          (when (== (.-tab scoreCallsCache) nil)
            (set! (.-tab scoreCallsCache) (make CallSiteTab)))

          (when (!= (bit-and debugTrace debugTraceScoring) 0)
            (fmt/Fprintf os/Stderr "=-= building cstab for non-inl func %s\n"
              (ir/FuncName fn)))

          (set! cstab (computeCallSiteTable fn (.-Body fn) (.-tab scoreCallsCache) nil 0
              ^{:line 472} nameFinder))))


      (let [csa (makeCallSiteAnalyzer fn)
          ^:const ^{:line 476 :val true} doCallResults true]
        (.scoreCallsRegion csa fn (.-Body fn) cstab doCallResults nil)

        (disableDebugTrace)))))







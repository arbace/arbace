    ;; Single return case.
    (when (== (len (.-ResultFlags (.-props funcInlHeur))) 1)
      (let [(values asgn ok) (assert (* ir/AssignStmt) (.-Assign cs))]
        (when (not ok)
          (return nil nil nil))


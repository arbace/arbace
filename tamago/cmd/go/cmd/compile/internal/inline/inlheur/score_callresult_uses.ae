        (let [(values aname ^:assign ok) (assert (* ir/Name) (.-X asgn))]
          (when (not ok)
            (return nil nil nil))

          (return (lit (slice (* ir/Name)) aname) (lit (slice (* ir/Name)) nil) (.-props funcInlHeur)))))


    ;; Multi-return case
    (let [(values asgn ^:assign ok) (assert (* ir/AssignListStmt) (.-Assign cs))]
      (when (or (not ok) (not (.-Def asgn)))
        (return nil nil nil))

      (let [userVars (make (slice (* ir/Name)) (len (.-ResultFlags (.-props funcInlHeur))))
          ^{:line 182} autoTemps (make (slice (* ir/Name)) (len (.-ResultFlags (.-props funcInlHeur))))]
        (range [idx x (.-Lhs asgn)]
          (if [(values n ok) (assert (* ir/Name) x)] ok (do
              (aset userVars idx n)
              (let [r (aget (.-Rhs asgn) idx)]
                (when (== (.Op r) ir/OCONVNOP)
                  (set! r (.-X (assert (* ir/ConvExpr) r))))

                (when (ir/IsAutoTmp r)

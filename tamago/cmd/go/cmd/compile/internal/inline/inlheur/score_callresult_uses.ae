^{:go/end 294} (go/method callTargetCheckResults "callTargetCheckResults examines a given call to see whether the\ncallee expression is potentially an inlinable function returned\nfrom a potentially inlinable call. Examples:\n\n\tScenario 1: named intermediate\n\n\t   fn1 := foo()         conc := bar()\n\t   fn1(\"blah\")          conc.MyMethod()\n\n\tScenario 2: returned func or concrete object feeds directly to call\n\n\t   foo()(\"blah\")        bar().MyMethod()\n\nIn the second case although at the source level the result of the\ndirect call feeds right into the method call or indirect call,\nwe're relying on the front end having inserted an auto-temp to\ncapture the value.\n" [^{:tag (* resultUseAnalyzer)} rua ^ir/Node call]
  (let [ce (assert (* ir/CallExpr) call)
      ^{:line 252} rname (.getCallResultName rua ce)]
    (when (== rname nil)
      (return))

    (when (!= (bit-and debugTrace debugTraceScoring) 0)
      (fmt/Fprintf os/Stderr "=-= staticvalue returns %v:\n"
        ^{:line 258} rname))

    (when (!= (.-Class rname) ir/PAUTO)
      (return))

    (switch (.Op call)
      (case [ir/OCALLINTER]
        (when (!= (bit-and debugTrace debugTraceScoring) 0)
          (fmt/Fprintf os/Stderr "=-= in %s checking %v for cci prop:\n"
            (.-Name (.Sym (.-fn rua))) rname))


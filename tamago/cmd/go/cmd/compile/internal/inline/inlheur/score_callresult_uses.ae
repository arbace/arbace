  (when (== (.-Assign cs) nil)
    (return nil nil nil))

  (let [(values funcInlHeur ok) (aget fpmap (.-Callee cs))]
    (when (not ok)
      ;; TODO: add an assert/panic here.
      (return nil nil nil))

    (when (== (len (.-ResultFlags (.-props funcInlHeur))) 0)

^{:go/end 206} (go/method nodeVisitPost [^{:tag (* resultUseAnalyzer)} rua ^ir/Node n]
  (.post (.-condLevelTracker rua) n))


^{:go/end 231} (go/method nodeVisitPre [^{:tag (* resultUseAnalyzer)} rua ^ir/Node n]
  (.pre (.-condLevelTracker rua) n)
  (switch (.Op n)
    (case [ir/OCALLINTER]
      (when (!= (bit-and debugTrace debugTraceScoring) 0)
        (fmt/Fprintf os/Stderr "=-= rescore examine iface call %v:\n" n))

      (.callTargetCheckResults rua n))
    (case [ir/OCALLFUNC]
      (when (!= (bit-and debugTrace debugTraceScoring) 0)
        (fmt/Fprintf os/Stderr "=-= rescore examine call %v:\n" n))

      (.callTargetCheckResults rua n))
    (case [ir/OIF]
      (let [ifst (assert (* ir/IfStmt) n)]
        (.foldCheckResults rua (.-Cond ifst))))
    (case [ir/OSWITCH]

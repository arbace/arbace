;; This file contains code to re-score callsites based on how the
;; results of the call were used.  Example:
;;
;;    func foo() {
;;       x, fptr := bar()
;;       switch x {
;;         case 10: fptr = baz()
;;         default: blix()
;;       }
;;       fptr(100)
;;     }
;;
;; The initial scoring pass will assign a score to "bar()" based on
;; various criteria, however once the first pass of scoring is done,
;; we look at the flags on the result from bar, and check to see
;; how those results are used. If bar() always returns the same constant
;; for its first result, and if the variable receiving that result
;; isn't redefined, and if that variable feeds into an if/switch
;; condition, then we will try to adjust the score for "bar" (on the
;; theory that if we inlined, we can constant fold / deadcode).

(go/type resultPropAndCS (struct
    ^{:line 35 :tag (* CallSite)} defcs
    ^{:line 36 :tag ResultPropBits} props))


(go/type resultUseAnalyzer (struct
    ^{:line 40 :tag (map (* ir/Name) resultPropAndCS)} resultNameTab
    ^{:line 41 :tag (* ir/Func)} fn
    ^{:line 42 :tag CallSiteTab} cstab
    (* condLevelTracker)))





^{:go/end 66} (go/method rescoreBasedOnCallResultUses "rescoreBasedOnCallResultUses examines how call results are used,\nand tries to update the scores of calls based on how their results\nare used in the function.\n" [^{:tag (* callSiteAnalyzer)} csa ^{:tag (* ir/Func)} fn ^{:tag (map (* ir/Name) resultPropAndCS)} resultNameTab ^CallSiteTab cstab]
  (enableDebugTraceIfEnv)
  (let [rua (addr ^{:go/breaks [2 4 6 8]} (lit resultUseAnalyzer
          :resultNameTab resultNameTab
          :fn fn
          :cstab cstab
          :condLevelTracker (new condLevelTracker)))

      ^{:line 57 :tag (func [ir/Node] [bool])} doNode (zero (func [ir/Node] [bool]))]
    (set! doNode ^{:go/breaks [5] :go/end 63} (fn ^bool [^ir/Node n]
        (.nodeVisitPre rua n)
        (ir/DoChildren n doNode)
        (.nodeVisitPost rua n)
        false))

    (doNode fn)
    (disableDebugTrace)))


^{:go/end 127} (go/method examineCallResults ^{:tag (map (* ir/Name) resultPropAndCS)} [^{:tag (* callSiteAnalyzer)} csa ^{:tag (* CallSite)} cs ^{:tag (map (* ir/Name) resultPropAndCS)} resultNameTab]
  (when (!= (bit-and debugTrace debugTraceScoring) 0)
    (fmt/Fprintf os/Stderr "=-= examining call results for %q\n"
      (EncodeCallSiteKey cs)))


  ;; Invoke a helper to pick out the specific ir.Name's the results
  ;; from this call are assigned into, e.g. "x, y := fooBar()". If
  ;; the call is not part of an assignment statement, or if the
  ;; variables in question are not newly defined, then we'll receive
  ;; an empty list here.
  ;;
  (let [(values names autoTemps props) (namesDefined cs)]
    (when (== (len names) 0)
      (return resultNameTab))


    (when (!= (bit-and debugTrace debugTraceScoring) 0)
      (fmt/Fprintf os/Stderr "=-= %d names defined\n" (len names)))


    ;; For each returned value, if the value has interesting
    ;; properties (ex: always returns the same constant), and the name
    ;; in question is never redefined, then make an entry in the
    ;; result table for it.
    (let [^:const ^{:val 60} interesting (bit-or ResultIsConcreteTypeConvertedToInterface
          ^{:line 94} ResultAlwaysSameConstant ResultAlwaysSameInlinableFunc ResultAlwaysSameFunc)]
      (range [idx n names]
        (let [rprop (aget (.-ResultFlags props) idx)]

          (when (!= (bit-and debugTrace debugTraceScoring) 0)
            (fmt/Fprintf os/Stderr "=-= props for ret %d %q: %s\n"
              ^{:line 100} idx (.-Name (.Sym n)) (.String rprop)))


          (when (== (bit-and rprop interesting) 0)
            (continue))

          (when (.reassigned (.-nameFinder csa) n)
            (continue))

          (if (== resultNameTab nil)
            (set! resultNameTab (make (map (* ir/Name) resultPropAndCS)))
            (when [(values _ ok) (aget resultNameTab n)] ok
              (panic "should never happen")))

          (let [entry ^{:go/breaks [2 4]} (lit resultPropAndCS
                :defcs cs
                :props rprop)]

            (aset resultNameTab n entry)
            (when (!= (aget autoTemps idx) nil)
              (aset resultNameTab (aget autoTemps idx) entry))

            (when (!= (bit-and debugTrace debugTraceScoring) 0)
              (fmt/Fprintf os/Stderr "=-= add resultNameTab table entry n=%v autotemp=%v props=%s\n" n (aget autoTemps idx) (.String rprop))))))


      ^{:line 126} resultNameTab)))




















^{:go/end 202} (go/func namesDefined "namesDefined returns a list of ir.Name's corresponding to locals\nthat receive the results from the call at site 'cs', plus the\nproperties object for the called function. If a given result\nisn't cleanly assigned to a newly defined local, the\nslot for that result in the returned list will be nil. Example:\n\n\tcall                             returned name list\n\n\tx := foo()                       [ x ]\n\tz, y := bar()                    [ nil, nil ]\n\t_, q := baz()                    [ nil, q ]\n\nIn the case of a multi-return call, such as \"x, y := foo()\",\nthe pattern we see from the front end will be a call op\nassigning to auto-temps, and then an assignment of the auto-temps\nto the user-level variables. In such cases we return\nfirst the user-level variable (in the first func result)\nand then the auto-temp name in the second result.\n" [^{:tag (* CallSite)} cs] :results [(slice (* ir/Name)) (slice (* ir/Name)) (* FuncProps)]

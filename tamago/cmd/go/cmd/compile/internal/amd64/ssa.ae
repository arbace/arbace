^{:go/end 1952} (go/func simdV21 "Example instruction: VPSUBD X1, X2, X3\n" ^{:tag (* obj/Prog)} [^{:tag (* ssagen/State)} s ^{:tag (* ssa/Value)} v]
  (let [p (.Prog s (.Asm (.-Op v)))]
    (set! (.-Type (.-From p)) obj/TYPE_REG)
    ;; Vector registers operands follows a right-to-left order.
    ;; e.g. VPSUBD X1, X2, X3 means X3 = X2 - X1.
    (set! (.-Reg (.-From p)) (simdReg (aget (.-Args v) 1)))
    (.AddRestSourceReg p (simdReg (aget (.-Args v) 0)))
    (set! (.-Type (.-To p)) obj/TYPE_REG)
    (set! (.-Reg (.-To p)) (simdReg v))
    ^{:line 1951} p))






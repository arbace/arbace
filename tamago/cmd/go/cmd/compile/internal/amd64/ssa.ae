^{:go/end 44} (go/func ssaMarkMoves "ssaMarkMoves marks any MOVXconst ops that need to avoid clobbering flags.\n" [^{:tag (* ssagen/State)} s ^{:tag (* ssa/Block)} b]
  (let [flive (.-FlagsLiveAtEnd b)]
    (range [_ c (.ControlValues b)]
      (set! flive (or (.IsFlags (.-Type c)) flive)))

    (for [i (- (len (.-Values b)) 1)] (>= i 0) (dec! i)
      (let [v (aget (.-Values b) i)]
        (when (and flive ^:go/paren (or (== (.-Op v) ssa/OpAMD64MOVLconst) (== (.-Op v) ssa/OpAMD64MOVQconst)))
          ;; The "mark" is any non-nil Aux value.
          (set! (.-Aux v) ssa/AuxMark))

        (when (.IsFlags (.-Type v))
          (set! flive false))

        (range [_ a (.-Args v)]
          (when (.IsFlags (.-Type a))
            (set! flive true)))))))





^{:go/end 48} (go/func isGPReg ^bool [^int16 r]
  (and (<= x86/REG_AL r) (<= r x86/REG_R15)))


^{:go/end 52} (go/func isFPReg ^bool [^int16 r]
  (and (<= x86/REG_X0 r) (<= r x86/REG_Z31)))


^{:go/end 56} (go/func isKReg ^bool [^int16 r]
  (and (<= x86/REG_K0 r) (<= r x86/REG_K7)))


^{:go/end 60} (go/func isLowFPReg ^bool [^int16 r]
  (and (<= x86/REG_X0 r) (<= r x86/REG_X15)))


^{:go/end 64} (go/func isHighFPReg ^bool [^int16 r]
  (or (and (<= x86/REG_X16 r) (<= r x86/REG_X31)) (and (<= x86/REG_Y16 r) (<= r x86/REG_Y31)) (and (<= x86/REG_Z16 r) (<= r x86/REG_Z31))))



^{:go/end 79} (go/func loadByRegWidth "loadByRegWidth returns the load instruction of the given register of a given width.\n" ^obj/As [^int16 r ^int64 width]
  ;; Avoid partial register write for GPR
  (when (and (not (isFPReg r)) (not (isKReg r)))
    (switch width
      (case [1]
        (return x86/AMOVBLZX))
      (case [2]
        (return x86/AMOVWLZX))))


  ;; Otherwise, there's no difference between load and store opcodes.
  (storeByRegWidth r width))




^{:go/end 118} (go/func storeByRegWidth "storeByRegWidth returns the store instruction of the given register of a given width.\nIt's also used for loading const to a reg.\n" ^obj/As [^int16 r ^int64 width]
  (when (isHighFPReg r)
    ;; High registers require AVX512 instruction
    (return x86/AVMOVDQU64))

  (when (isFPReg r)
    (switch width
      (case [4]
        (return x86/AMOVSS))
      (case [8]
        (return x86/AMOVSD))
      (case [16]
        ;; int128s are in SSE registers
        (return x86/AMOVUPS))
      (case [32]
        (return x86/AVMOVDQU))
      (case [64]
        (return x86/AVMOVDQU64))))


  (when (isKReg r)
    (return x86/AKMOVQ))

  ;; gp
  (switch width
    (case [1]
      (return x86/AMOVB))
    (case [2]
      (return x86/AMOVW))
    (case [4]
      (return x86/AMOVL))
    (case [8]
      (return x86/AMOVQ)))

  (panic (fmt/Sprintf "bad store reg=%v, width=%d" r width)))



^{:go/end 167} (go/func moveByRegsWidth "moveByRegsWidth returns the reg->reg move instruction of the given dest/src registers of a given width.\n" ^obj/As [^int16 dest ^int16 src ^int64 width]
  ;; fp -> fp
  (when (and (isFPReg dest) (isFPReg src))
    (when (or (isHighFPReg src) (isHighFPReg dest))
      ;; High registers require AVX512 instruction
      (return x86/AVMOVDQU64))

    ;; Moving the whole sse2 register is faster
    ;; than moving just the correct low portion of it.
    ;; There is no xmm->xmm move with 1 byte opcode,
    ;; so use movups, which has 2 byte opcode.
    (when (<= width 16)
      (return x86/AMOVUPS))

    (when (<= width 32)
      (return x86/AVMOVDQU))

    (return x86/AVMOVDQU64))

  ;; k -> gp, gp -> k, k -> k
  (when (or (isKReg dest) (isKReg src))
    (when (or (isFPReg dest) (isFPReg src))
      (panic (fmt/Sprintf "bad move, src=%v, dest=%v, width=%d" src dest width)))

    (return x86/AKMOVQ))

  ;; gp -> fp, fp -> gp, gp -> gp
  (switch width
    (case [1]
      ;; Avoids partial register write
      (return x86/AMOVL))
    (case [2]
      (return x86/AMOVL))
    (case [4]
      (return x86/AMOVL))
    (case [8]
      (return x86/AMOVQ))
    (case [16]
      ;; int128s are in SSE registers
      (return x86/AMOVUPS))
    (case [32]
      (return x86/AVMOVDQU))
    (case [64]
      (return x86/AVMOVDQU64)))

  (panic (fmt/Sprintf "bad move, src=%v, dest=%v, width=%d" src dest width)))








^{:go/end 182} (go/func opregreg "opregreg emits instructions for\n\n\tdest := dest(To) op src(From)\n\nand also returns the created obj.Prog so it\nmay be further adjusted (offset, scale, etc).\n" ^{:tag (* obj/Prog)} [^{:tag (* ssagen/State)} s ^obj/As op ^int16 dest ^int16 src]
  (let [p (.Prog s op)]
    (set! (.-Type (.-From p)) obj/TYPE_REG)
    (set! (.-Type (.-To p)) obj/TYPE_REG)
    (set! (.-Reg (.-To p)) dest)
    (set! (.-Reg (.-From p)) src)
    ^{:line 181} p))






^{:go/end 197} (go/func memIdx "memIdx fills out a as an indexed memory reference for v.\nIt assumes that the base register and the index register\nare v.Args[0].Reg() and v.Args[1].Reg(), respectively.\nThe caller must still use gc.AddAux/gc.AddAux2 to handle v.Aux as necessary.\n" [^{:tag (* obj/Addr)} a ^{:tag (* ssa/Value)} v]
  (let [(values r i) (values (.Reg (aget (.-Args v) 0)) (.Reg (aget (.-Args v) 1)))]
    (set! (.-Type a) obj/TYPE_MEM)
    (set! (.-Scale a) (.Scale (.-Op v)))
    (when (and (== (.-Scale a) 1) (== i x86/REG_SP))
      (set! (values r i) (values i r)))

    (set! (.-Reg a) r)
    (set! (.-Index a) i)))


^{:go/end 225} (go/func getgFromTLS [^{:tag (* ssagen/State)} s ^int16 r]
  ;; See the comments in cmd/internal/obj/x86/obj6.go
  ;; near CanUse1InsnTLS for a detailed explanation of these instructions.
  (if (x86/CanUse1InsnTLS base/Ctxt)
    ;; MOVQ (TLS), r
    (let [p (.Prog s x86/AMOVQ)]
      (set! (.-Type (.-From p)) obj/TYPE_MEM)
      (set! (.-Reg (.-From p)) x86/REG_TLS)
      (set! (.-Type (.-To p)) obj/TYPE_REG)
      (set! (.-Reg (.-To p)) r))

    ;; MOVQ TLS, r
    ;; MOVQ (r)(TLS*1), r
    (let [p (.Prog s x86/AMOVQ)]
      (set! (.-Type (.-From p)) obj/TYPE_REG)
      (set! (.-Reg (.-From p)) x86/REG_TLS)
      (set! (.-Type (.-To p)) obj/TYPE_REG)
      (set! (.-Reg (.-To p)) r)
      (let [q (.Prog s x86/AMOVQ)]
        (set! (.-Type (.-From q)) obj/TYPE_MEM)
        (set! (.-Reg (.-From q)) r)
        (set! (.-Index (.-From q)) x86/REG_TLS)
        (set! (.-Scale (.-From q)) 1)
        (set! (.-Type (.-To q)) obj/TYPE_REG)
        (set! (.-Reg (.-To q)) r)))))




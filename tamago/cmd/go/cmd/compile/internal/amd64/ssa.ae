(go/var blockJump (lit (array ... (struct
        ^{:line 2443 :tag obj/As} asm ^obj/As invasm))

    ^{:line 2445} [ssa/BlockAMD64EQ (lit _ x86/AJEQ x86/AJNE)]
    ^{:line 2446} [ssa/BlockAMD64NE (lit _ x86/AJNE x86/AJEQ)]
    ^{:line 2447} [ssa/BlockAMD64LT (lit _ x86/AJLT x86/AJGE)]
    ^{:line 2448} [ssa/BlockAMD64GE (lit _ x86/AJGE x86/AJLT)]
    ^{:line 2449} [ssa/BlockAMD64LE (lit _ x86/AJLE x86/AJGT)]
    ^{:line 2450} [ssa/BlockAMD64GT (lit _ x86/AJGT x86/AJLE)]
    ^{:line 2451} [ssa/BlockAMD64OS (lit _ x86/AJOS x86/AJOC)]
    ^{:line 2452} [ssa/BlockAMD64OC (lit _ x86/AJOC x86/AJOS)]
    ^{:line 2453} [ssa/BlockAMD64ULT (lit _ x86/AJCS x86/AJCC)]
    ^{:line 2454} [ssa/BlockAMD64UGE (lit _ x86/AJCC x86/AJCS)]
    ^{:line 2455} [ssa/BlockAMD64UGT (lit _ x86/AJHI x86/AJLS)]
    ^{:line 2456} [ssa/BlockAMD64ULE (lit _ x86/AJLS x86/AJHI)]
    ^{:line 2457} [ssa/BlockAMD64ORD (lit _ x86/AJPC x86/AJPS)]
    ^{:line 2458} [ssa/BlockAMD64NAN (lit _ x86/AJPS x86/AJPC)]))


(go/var eqfJumps (lit (array 2 (array 2 ssagen/IndexJump))
    (lit _ (lit _ :Jump x86/AJNE :Index 1) (lit _ :Jump x86/AJPS :Index 1)) ; next == b.Succs[0]
    (lit _ (lit _ :Jump x86/AJNE :Index 1) (lit _ :Jump x86/AJPC :Index 0)))) ; next == b.Succs[1]

(go/var nefJumps (lit (array 2 (array 2 ssagen/IndexJump))
    (lit _ (lit _ :Jump x86/AJNE :Index 0) (lit _ :Jump x86/AJPC :Index 1)) ; next == b.Succs[0]
    (lit _ (lit _ :Jump x86/AJNE :Index 0) (lit _ :Jump x86/AJPS :Index 0)))) ; next == b.Succs[1]


^{:go/end 2523} (go/func ssaGenBlock [^{:tag (* ssagen/State)} s ^{:tag (* ssa/Block)} b ^{:tag (* ssa/Block)} next]
  (switch (.-Kind b)
    (case [ssa/BlockPlain ssa/BlockDefer]
      (when (!= (.Block (aget (.-Succs b) 0)) next)
        (let [p (.Prog s obj/AJMP)]
          (set! (.-Type (.-To p)) obj/TYPE_BRANCH)
          (set! (.-Branches s) (append (.-Branches s) (lit ssagen/Branch :P p :B (.Block (aget (.-Succs b) 0))))))))

    (case [ssa/BlockExit ssa/BlockRetJmp])
    (case [ssa/BlockRet]
      (.Prog s obj/ARET))

    (case [ssa/BlockAMD64EQF]
      (.CombJump s b next (addr eqfJumps)))

    (case [ssa/BlockAMD64NEF]
      (.CombJump s b next (addr nefJumps)))

    (case [ssa/BlockAMD64EQ ssa/BlockAMD64NE
        ^{:line 2489} ssa/BlockAMD64LT ssa/BlockAMD64GE
        ^{:line 2490} ssa/BlockAMD64LE ssa/BlockAMD64GT
        ^{:line 2491} ssa/BlockAMD64OS ssa/BlockAMD64OC
        ^{:line 2492} ssa/BlockAMD64ULT ssa/BlockAMD64UGT
        ^{:line 2493} ssa/BlockAMD64ULE ssa/BlockAMD64UGE]
      (let [jmp (aget blockJump (.-Kind b))]
        (switch next
          (case [(.Block (aget (.-Succs b) 0))]
            (.Br s (.-invasm jmp) (.Block (aget (.-Succs b) 1))))
          (case [(.Block (aget (.-Succs b) 1))]
            (.Br s (.-asm jmp) (.Block (aget (.-Succs b) 0))))
          (default
            (if (!= (.-Likely b) ssa/BranchUnlikely) (do
                (.Br s (.-asm jmp) (.Block (aget (.-Succs b) 0)))
                (.Br s obj/AJMP (.Block (aget (.-Succs b) 1))))
              (do
                (.Br s (.-invasm jmp) (.Block (aget (.-Succs b) 1)))
                (.Br s obj/AJMP (.Block (aget (.-Succs b) 0)))))))))



    (case [ssa/BlockAMD64JUMPTABLE]
      ;; JMP      *(TABLE)(INDEX*8)
      (let [p (.Prog s obj/AJMP)]
        (set! (.-Type (.-To p)) obj/TYPE_MEM)
        (set! (.-Reg (.-To p)) (.Reg (aget (.-Controls b) 1)))
        (set! (.-Index (.-To p)) (.Reg (aget (.-Controls b) 0)))
        (set! (.-Scale (.-To p)) 8)
        ;; Save jump tables for later resolution of the target blocks.
        (set! (.-JumpTables s) (append (.-JumpTables s) b))))

    (default
      (.Fatalf b "branch not implemented: %s" (.LongString b)))))



^{:go/end 2534} (go/func loadRegResult ^{:tag (* obj/Prog)} [^{:tag (* ssagen/State)} s ^{:tag (* ssa/Func)} f ^{:tag (* types/Type)} t ^int16 reg ^{:tag (* ir/Name)} n ^int64 off]
  (let [p (.Prog s (loadByRegWidth reg (.Size t)))]
    (set! (.-Type (.-From p)) obj/TYPE_MEM)
    (set! (.-Name (.-From p)) obj/NAME_AUTO)
    (set! (.-Sym (.-From p)) (.Linksym n))
    (set! (.-Offset (.-From p)) (+ (.FrameOffset n) off))
    (set! (.-Type (.-To p)) obj/TYPE_REG)
    (set! (.-Reg (.-To p)) reg)
    ^{:line 2533} p))


^{:go/end 2542} (go/func spillArgReg ^{:tag (* obj/Prog)} [^{:tag (* objw/Progs)} pp ^{:tag (* obj/Prog)} p ^{:tag (* ssa/Func)} f ^{:tag (* types/Type)} t ^int16 reg ^{:tag (* ir/Name)} n ^int64 off]
  (set! p (.Append pp p (storeByRegWidth reg (.Size t)) obj/TYPE_REG reg 0 obj/TYPE_MEM 0 (+ (.FrameOffset n) off)))
  (set! (.-Name (.-To p)) obj/NAME_PARAM)
  (set! (.-Sym (.-To p)) (.Linksym n))
  (set! (.-Pos p) (.WithNotStmt (.-Pos p)))
  ^{:line 2541} p)



^{:go/end 2553} (go/func zero16 "zero 16 bytes at reg+off.\n" [^{:tag (* ssagen/State)} s ^int16 reg ^int64 off]
  ;;   MOVUPS  X15, off(ptrReg)
  (let [p (.Prog s x86/AMOVUPS)]
    (set! (.-Type (.-From p)) obj/TYPE_REG)
    (set! (.-Reg (.-From p)) x86/REG_X15)
    (set! (.-Type (.-To p)) obj/TYPE_MEM)
    (set! (.-Reg (.-To p)) reg)
    (set! (.-Offset (.-To p)) off)))



^{:go/end 2571} (go/func move16 "move 16 bytes from src+off to dst+off using temporary register tmp.\n" [^{:tag (* ssagen/State)} s ^int16 src ^int16 dst ^int16 tmp ^int64 off]
  ;;   MOVUPS  off(srcReg), tmpReg
  ;;   MOVUPS  tmpReg, off(dstReg)
  (let [p (.Prog s x86/AMOVUPS)]
    (set! (.-Type (.-From p)) obj/TYPE_MEM)
    (set! (.-Reg (.-From p)) src)
    (set! (.-Offset (.-From p)) off)
    (set! (.-Type (.-To p)) obj/TYPE_REG)
    (set! (.-Reg (.-To p)) tmp)
    (set! p (.Prog s x86/AMOVUPS))
    (set! (.-Type (.-From p)) obj/TYPE_REG)
    (set! (.-Reg (.-From p)) tmp)
    (set! (.-Type (.-To p)) obj/TYPE_MEM)
    (set! (.-Reg (.-To p)) dst)
    (set! (.-Offset (.-To p)) off)))




^{:go/end 2581} (go/func simdReg "XXX maybe make this part of v.Reg?\nOn the other hand, it is architecture-specific.\n" ^int16 [^{:tag (* ssa/Value)} v]
  (let [t (.-Type v)]
    (when (not (.IsSIMD t))
      (base/Fatalf "simdReg: not a simd type; v=%s, b=b%d, f=%s" (.LongString v) (.-ID (.-Block v)) (.-Name (.-Func (.-Block v)))))

    (simdRegBySize (.Reg v) (.Size t))))


^{:go/end 2593} (go/func simdRegBySize ^int16 [^int16 reg ^int64 size]
  (switch size
    (case [16]
      (return reg))
    (case [32]
      (return (+ reg (- x86/REG_Y0 x86/REG_X0))))
    (case [64]
      (return (+ reg (- x86/REG_Z0 x86/REG_X0)))))

  (panic "simdRegBySize: bad size"))



^{:go/end 2606} (go/func maskReg "XXX k mask\n" ^int16 [^{:tag (* ssa/Value)} v]
  (let [t (.-Type v)]
    (when (not (.IsSIMD t))
      (base/Fatalf "maskReg: not a simd type; v=%s, b=b%d, f=%s" (.LongString v) (.-ID (.-Block v)) (.-Name (.-Func (.-Block v)))))

    (switch (.Size t)
      (case [8]
        (return (.Reg v))))

    (panic "unreachable")))



^{:go/end 2615} (go/func simdOrMaskReg "XXX k mask + vec\n" ^int16 [^{:tag (* ssa/Value)} v]
  (let [t (.-Type v)]
    (when (<= (.Size t) 8)
      (return (maskReg v)))

    (simdReg v)))






^{:go/end 2626} (go/func simdCheckRegOnly "XXX this is used for shift operations only.\nregalloc will issue OpCopy with incorrect type, but the assigned\nregister should be correct, and this function is merely checking\nthe sanity of this part.\n" ^int16 [^{:tag (* ssa/Value)} v ^int16 regStart ^int16 regEnd]
  (when (or (> (.Reg v) regEnd) (< (.Reg v) regStart))
    (panic "simdCheckRegOnly: not the desired register"))

  (.Reg v))

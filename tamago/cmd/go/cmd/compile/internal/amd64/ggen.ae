(in-ns 'go.cmd.compile.internal.amd64) (go/file "ggen.go" :imports [


    ^{:line 8} [objw "cmd/compile/internal/objw"]
    ^{:line 9} [obj "cmd/internal/obj"]
    ^{:line 10} [x86 "cmd/internal/obj/x86"]])


^{:go/end 26} (go/func zerorange ^{:tag (* obj/Prog)} [^{:tag (* objw/Progs)} pp ^{:tag (* obj/Prog)} p ^int64 off ^int64 cnt ^{:tag (* uint32)} state]
  (when (!= (% cnt 8) 0)
    (panic "zeroed region not aligned"))

  (while (>= cnt 16)
    (set! p (.Append pp p x86/AMOVUPS obj/TYPE_REG x86/REG_X15 0 obj/TYPE_MEM x86/REG_SP off))
    (set! off + 16)
    (set! cnt - 16))

  (when (!= cnt 0)
    (set! p (.Append pp p x86/AMOVQ obj/TYPE_REG x86/REG_X15 0 obj/TYPE_MEM x86/REG_SP off)))

  ^{:line 25} p)


^{:go/end 41} (go/func ginsnop ^{:tag (* obj/Prog)} [^{:tag (* objw/Progs)} pp]
  ;; This is a hardware nop (1-byte 0x90) instruction,
  ;; even though we describe it as an explicit XCHGL here.
  ;; Particularly, this does not zero the high 32 bits
  ;; like typical *L opcodes.
  ;; (gas assembles "xchg %eax,%eax" to 0x87 0xc0, which
  ;; does zero the high 32 bits.)
  (let [p (.Prog pp x86/AXCHGL)]
    (set! (.-Type (.-From p)) obj/TYPE_REG)
    (set! (.-Reg (.-From p)) x86/REG_AX)
    (set! (.-Type (.-To p)) obj/TYPE_REG)
    (set! (.-Reg (.-To p)) x86/REG_AX)
    ^{:line 40} p))

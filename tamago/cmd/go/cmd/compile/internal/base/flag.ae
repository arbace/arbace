^{:go/end 155} (go/func addEnv [^string s]
  (let [i (strings/Index s "=")]
    (when (< i 0)
      (log/Fatal "-env argument must be of the form key=value"))

    (os/Setenv (subslice s _ i) (subslice s (+ i 1)))))



^{:go/end 390} (go/func ParseFlags "ParseFlags parses the command-line flags into Flag.\n" []
  (set! (.-I Flag) addImportDir)

  (set! (.-LowerC Flag) (runtime/GOMAXPROCS 0))
  (set! (.-LowerD Flag) (objabi/NewDebugFlag (addr Debug) DebugSSA))
  (set! (.-LowerP Flag) (addr (.-Pkgpath Ctxt)))
  (set! (.-LowerV Flag) (addr (.-Debugvlog Ctxt)))

  (set! (.-Dwarf Flag) (!= buildcfg/GOARCH "wasm"))
  (set! (.-DwarfBASEntries Flag) (addr (.-UseBASEntries Ctxt)))
  (set! (.-DwarfLocationLists Flag) (addr (.-Flag_locationlists Ctxt)))
  (set! @(.-DwarfLocationLists Flag) true)
  (set! (.-Dynlink Flag) (addr (.-Flag_dynlink Ctxt)))
  (set! (.-EmbedCfg Flag) readEmbedCfg)
  (set! (.-Env Flag) addEnv)
  (set! (.-GenDwarfInl Flag) 2)
  (set! (.-ImportCfg Flag) readImportCfg)
  (set! (.-CoverageCfg Flag) readCoverageCfg)
  (set! (.-LinkShared Flag) (addr (.-Flag_linkshared Ctxt)))
  (set! (.-Shared Flag) (addr (.-Flag_shared Ctxt)))
  (set! (.-WB Flag) true)

  (set! (.-ConcurrentOk Debug) true)
  (set! (.-CompressInstructions Debug) 1)
  (set! (.-MaxShapeLen Debug) 500)
  (set! (.-AlignHot Debug) 1)
  (set! (.-InlFuncsWithClosures Debug) 1)
  (set! (.-InlStaticInit Debug) 1)
  (set! (.-FreeAppend Debug) 1)
  (set! (.-PGOInline Debug) 1)
  (set! (.-PGODevirtualize Debug) 2)
  (set! (.-SyncFrames Debug) -1) ; disable sync markers by default
  (set! (.-VariableMakeThreshold Debug) 32) ; 32 byte default for stack allocated make results
  (set! (.-ZeroCopy Debug) 1)
  (set! (.-RangeFuncCheck Debug) 1)
  (set! (.-MergeLocals Debug) 1)

  (set! (.-Checkptr Debug) -1) ; so we can tell whether it is set explicitly

  (set! (.-ImportMap (.-Cfg Flag)) (make (map string string)))

  (objabi/AddVersionFlag) ; -V
  (registerFlags)
  (objabi/Flagparse usage)
  (counter/CountFlags "compile/flag:" @flag/CommandLine)

  (when [gcd (os/Getenv "GOCOMPILEDEBUG")] (!= gcd "")
    ;; This will only override the flags set in gcd;
    ;; any others set on the command line remain set.
    (.Set (.-LowerD Flag) gcd))


  (when (!= (.-Gossahash Debug) "")
    (set! hashDebug (NewHashDebug "gossahash" (.-Gossahash Debug) nil)))

  (obj/SetFIPSDebugHash (.-FIPSHash Debug))

  ;; Compute whether we're compiling the runtime from the package path. Test
  ;; code can also use the flag to set this explicitly.
  (when (and (.-Std Flag) (.-Runtime (objabi/LookupPkgSpecial (.-Pkgpath Ctxt))))
    (set! (.-CompilingRuntime Flag) true))


  (set! (.-Std Ctxt) (.-Std Flag))

  ;; Three inputs govern loop iteration variable rewriting, hash, experiment, flag.
  ;; The loop variable rewriting is:
  ;; IF non-empty hash, then hash determines behavior (function+line match) (*)
  ;; ELSE IF experiment and flag==0, then experiment (set flag=1)
  ;; ELSE flag (note that build sets flag per-package), with behaviors:
  ;;  -1 => no change to behavior.
  ;;   0 => no change to behavior (unless non-empty hash, see above)
  ;;   1 => apply change to likely-iteration-variable-escaping loops
  ;;   2 => apply change, log results
  ;;   11 => apply change EVERYWHERE, do not log results (for debugging/benchmarking)
  ;;   12 => apply change EVERYWHERE, log results (for debugging/benchmarking)
  ;;
  ;; The expected uses of the these inputs are, in believed most-likely to least likely:
  ;;  GOEXPERIMENT=loopvar -- apply change to entire application
  ;;  -gcflags=some_package=-d=loopvar=1 -- apply change to some_package (**)
  ;;  -gcflags=some_package=-d=loopvar=2 -- apply change to some_package, log it
  ;;  GOEXPERIMENT=loopvar -gcflags=some_package=-d=loopvar=-1 -- apply change to all but one package
  ;;  GOCOMPILEDEBUG=loopvarhash=... -- search for failure cause
  ;;
  ;;  (*) For debugging purposes, providing loopvar flag >= 11 will expand the hash-eligible set of loops to all.
  ;; (**) Loop semantics, changed or not, follow code from a package when it is inlined; that is, the behavior
  ;;      of an application compiled with partially modified loop semantics does not depend on inlining.

  (cond (!= (.-LoopVarHash Debug) "")
    ;; This first little bit controls the inputs for debug-hash-matching.
    (let [mostInlineOnly true]
      (when (strings/HasPrefix (.-LoopVarHash Debug) "IL")
        ;; When hash-searching on a position that is an inline site, default is to use the
        ;; most-inlined position only.  This makes the hash faster, plus there's no point
        ;; reporting a problem with all the inlining; there's only one copy of the source.
        ;; However, if for some reason you wanted it per-site, you can get this.  (The default
        ;; hash-search behavior for compiler debugging is at an inline site.)
        (set! (.-LoopVarHash Debug) (subslice (.-LoopVarHash Debug) 2))
        (set! mostInlineOnly false))

      ;; end of testing trickiness
      (set! LoopVarHash (NewHashDebug "loopvarhash" (.-LoopVarHash Debug) nil))
      (when (< (.-LoopVar Debug) 11) ; >= 11 means all loops are rewrite-eligible
        (set! (.-LoopVar Debug) 1)) ; 1 means those loops that syntactically escape their dcl vars are eligible.

      (.SetInlineSuffixOnly LoopVarHash mostInlineOnly))
    (and ^{:go/via [Flags]} (.-LoopVar buildcfg/Experiment) (== (.-LoopVar Debug) 0))
    (set! (.-LoopVar Debug) 1))


  (if (!= (.-Converthash Debug) "")
    (set! ConvertHash (NewHashDebug "converthash" (.-Converthash Debug) nil))

    ;; quietly disable the convert hash changes
    (set! ConvertHash (NewHashDebug "converthash" "qn" nil)))

  (when (!= (.-Fmahash Debug) "")
    (set! FmaHash (NewHashDebug "fmahash" (.-Fmahash Debug) nil)))

  (when (!= (.-PGOHash Debug) "")
    (set! PGOHash (NewHashDebug "pgohash" (.-PGOHash Debug) nil)))

  (when (!= (.-LiteralAllocHash Debug) "")
    (set! LiteralAllocHash (NewHashDebug "literalalloc" (.-LiteralAllocHash Debug) nil)))


  (when (!= (.-MergeLocalsHash Debug) "")
    (set! MergeLocalsHash (NewHashDebug "mergelocals" (.-MergeLocalsHash Debug) nil)))

  (when (!= (.-VariableMakeHash Debug) "")
    (set! VariableMakeHash (NewHashDebug "variablemake" (.-VariableMakeHash Debug) nil)))


  (when (and (.-MSan Flag) (not (platform/MSanSupported buildcfg/GOOS buildcfg/GOARCH)))
    (log/Fatalf "%s/%s does not support -msan" buildcfg/GOOS buildcfg/GOARCH))

  (when (and (.-ASan Flag) (not (platform/ASanSupported buildcfg/GOOS buildcfg/GOARCH)))
    (log/Fatalf "%s/%s does not support -asan" buildcfg/GOOS buildcfg/GOARCH))

  (when (and (.-Race Flag) (not (platform/RaceDetectorSupported buildcfg/GOOS buildcfg/GOARCH)))
    (log/Fatalf "%s/%s does not support -race" buildcfg/GOOS buildcfg/GOARCH))

  (when (and ^:go/paren (or @(.-Shared Flag) @(.-Dynlink Flag) @(.-LinkShared Flag)) (not ^{:go/via [Arch]} (.InFamily (.-Arch Ctxt) sys/AMD64 sys/ARM sys/ARM64 sys/I386 sys/Loong64 sys/MIPS64 sys/PPC64 sys/RISCV64 sys/S390X)))
    (log/Fatalf "%s/%s does not support -shared" buildcfg/GOOS buildcfg/GOARCH))

  (parseSpectre (.-Spectre Flag)) ; left as string for RecordFlags

  (set! (.-CompressInstructions Ctxt) (!= (.-CompressInstructions Debug) 0))
  (set! (.-Flag_shared Ctxt) (or (.-Flag_dynlink Ctxt) (.-Flag_shared Ctxt)))
  (set! (.-Flag_optimize Ctxt) (== (.-N Flag) 0))
  (set! (.-Debugasm Ctxt) (conv int (.-S Flag)))
  (set! (.-Flag_maymorestack Ctxt) (.-MayMoreStack Debug))
  (set! (.-Flag_noRefName Ctxt) (!= (.-NoRefName Debug) 0))

  (when (< (flag/NArg) 1)
    (usage))


  (when (and (!= (.-GoVersion Flag) "") (!= (.-GoVersion Flag) (runtime/Version)))
    (fmt/Printf "compile: version %q does not match go tool version %q\n" (runtime/Version) (.-GoVersion Flag))
    (Exit 2))


  (when (== @(.-LowerP Flag) "")
    (set! @(.-LowerP Flag) obj/UnlinkablePkg))


  (when (== (.-LowerO Flag) "")
    (let [p (flag/Arg 0)]
      (when [i (strings/LastIndex p "/")] (>= i 0)
        (set! p (subslice p (+ i 1))))

      (when (== runtime/GOOS "windows")
        (when [i (strings/LastIndex p "\\")] (>= i 0)
          (set! p (subslice p (+ i 1)))))


      (when [i (strings/LastIndex p ".")] (>= i 0)
        (set! p (subslice p _ i)))

      (let [suffix ".o"]
        (when (.-Pack Flag)
          (set! suffix ".a"))

        (set! (.-LowerO Flag) (+ p suffix)))))

  (switch
    (case [(and (.-Race Flag) (.-MSan Flag))]
      (log/Fatal "cannot use both -race and -msan"))
    (case [(and (.-Race Flag) (.-ASan Flag))]
      (log/Fatal "cannot use both -race and -asan"))
    (case [(and (.-MSan Flag) (.-ASan Flag))]
      (log/Fatal "cannot use both -msan and -asan")))

  (when (or (.-Race Flag) (.-MSan Flag) (.-ASan Flag))
    ;; -race, -msan and -asan imply -d=checkptr for now.
    (when (== (.-Checkptr Debug) -1) ; if not set explicitly
      (set! (.-Checkptr Debug) 1)))



  (when (< (.-LowerC Flag) 1)
    (log/Fatalf "-c must be at least 1, got %d" (.-LowerC Flag)))

  (when (not (concurrentBackendAllowed))
    (set! (.-LowerC Flag) 1))


  (when (.-CompilingRuntime Flag)
    ;; It is not possible to build the runtime with no optimizations,
    ;; because the compiler cannot eliminate enough write barriers.
    (set! (.-N Flag) 0)
    (set! (.-Flag_optimize Ctxt) true)

    ;; Runtime can't use -d=checkptr, at least not yet.
    (set! (.-Checkptr Debug) 0)

    ;; Fuzzing the runtime isn't interesting either.
    (set! (.-Libfuzzer Debug) 0))


  (when (== (.-Checkptr Debug) -1) ; if not set explicitly
    (set! (.-Checkptr Debug) 0))


  ;; set via a -d flag
  (set! (.-Debugpcln Ctxt) (.-PCTab Debug))

  ;; https://golang.org/issue/67502
  (when (and (== buildcfg/GOOS "plan9") (== buildcfg/GOARCH "386"))
    (set! (.-AlignHot Debug) 0)))





^{:go/end 468} (go/func registerFlags "registerFlags adds flag registrations for all the fields in Flag.\nSee the comment on type CmdFlags for the rules.\n" []
  (let [
      ^:var ^{:line 396} boolType ((inst reflect/TypeFor bool))
      ^:var ^{:line 397} intType ((inst reflect/TypeFor int))
      ^:var ^{:line 398} stringType ((inst reflect/TypeFor string))
      ^:var ^{:line 399} ptrBoolType ((inst reflect/TypeFor (* bool)))
      ^:var ^{:line 400} ptrIntType ((inst reflect/TypeFor (* int)))
      ^:var ^{:line 401} ptrStringType ((inst reflect/TypeFor (* string)))
      ^:var ^{:line 402} countType ((inst reflect/TypeFor CountFlag))
      ^:var ^{:line 403} funcType ((inst reflect/TypeFor (func [string])))


      ^{:line 406} v (.Elem (reflect/ValueOf (addr Flag)))
      ^{:line 407} t (.Type v)]
    (for [i 0] (< i (.NumField t)) (inc! i)
      (let [f (.Field t i)]
        (when (== (.-Name f) "Cfg")
          (continue))


        (let [^string name (zero string)]
          (cond (== (len (.-Name f)) 1)
            (set! name (.-Name f))
            (and (== (len (.-Name f)) 6) (== (subslice (.-Name f) _ 5) "Lower") (<= \A (aget (.-Name f) 5)) (<= (aget (.-Name f) 5) \Z))
            (set! name (conv string (conv rune (- (+ (aget (.-Name f) 5) \a) \A)))) :else

            (set! name (strings/ToLower (.-Name f))))

          (when [tag (.Get (.-Tag f) "flag")] (!= tag "")
            (set! name tag))


          (let [help (.Get (.-Tag f) "help")]
            (when (== help "")
              (panic (fmt/Sprintf "base.Flag.%s is missing help text" (.-Name f))))


            (when [k (.Kind (.-Type f))] (and ^:go/paren (or (== k reflect/Ptr) (== k reflect/Func)) (.IsNil (.Field v i)))
              (panic (fmt/Sprintf "base.Flag.%s is uninitialized %v" (.-Name f) (.-Type f))))


            (switch (.-Type f)
              (case [boolType]
                (let [p (assert (* bool) (.Interface (.Addr (.Field v i))))]
                  (flag/BoolVar p name @p help)))
              (case [intType]
                (let [p (assert (* int) (.Interface (.Addr (.Field v i))))]
                  (flag/IntVar p name @p help)))
              (case [stringType]
                (let [p (assert (* string) (.Interface (.Addr (.Field v i))))]
                  (flag/StringVar p name @p help)))
              (case [ptrBoolType]
                (let [p (assert (* bool) (.Interface (.Field v i)))]
                  (flag/BoolVar p name @p help)))
              (case [ptrIntType]
                (let [p (assert (* int) (.Interface (.Field v i)))]
                  (flag/IntVar p name @p help)))
              (case [ptrStringType]
                (let [p (assert (* string) (.Interface (.Field v i)))]
                  (flag/StringVar p name @p help)))
              (case [countType]
                (let [p (conv (* int) (assert (* CountFlag) (.Interface (.Addr (.Field v i)))))]
                  (objabi/Flagcount name help p)))
              (case [funcType]
                (let [f (assert (func [string]) (.Interface (.Field v i)))]
                  (objabi/Flagfn1 name help f)))
              (default
                (if [(values val ok) (assert flag/Value (.Interface (.Field v i)))] ok
                  (flag/Var val name help)

                  (panic (fmt/Sprintf "base.Flag.%s has unexpected type %s" (.-Name f) (.-Type f))))))))))))







^{:go/end 481} (go/func concurrentFlagOk "concurrentFlagOk reports whether the current compiler flags\nare compatible with concurrent compilation.\n" ^bool []
  ;; TODO(rsc): Many of these are fine. Remove them.
  (and (== (.-Percent Flag) 0)
    (== (.-E Flag) 0)
    (== (.-K Flag) 0)
    (== (.-L Flag) 0)
    (== (.-LowerJ Flag) 0)
    (== (.-LowerM Flag) 0)
    (== (.-LowerR Flag) 0)))


^{:go/breaks [[7 503]] :go/end 504} (go/func concurrentBackendAllowed ^bool []
  (when (not (concurrentFlagOk))
    (return false))


  ;; Debug.S by itself is ok, because all printing occurs
  ;; while writing the object file, and that is non-concurrent.
  ;; Adding Debug_vlog, however, causes Debug.S to also print
  ;; while flushing the plist, which happens concurrently.
  (when (or (.-Debugvlog Ctxt) (not (.-ConcurrentOk Debug)) (> (.-Live Flag) 0))
    (return false))

  ;; TODO: Test and delete this condition.
  (when ^{:go/via [Flags]} (.-FieldTrack buildcfg/Experiment)
    (return false))

  ;; TODO: fix races and enable the following flags
  (when (or (.-Flag_dynlink Ctxt) (.-Race Flag))
    (return false))

  true)


^{:go/end 510} (go/func addImportDir [^string dir]
  (when (!= dir "")
    (set! (.-ImportDirs (.-Cfg Flag)) (append (.-ImportDirs (.-Cfg Flag)) dir))))



^{:go/end 550} (go/func readImportCfg [^string file]
  (when (== (.-ImportMap (.-Cfg Flag)) nil)
    (set! (.-ImportMap (.-Cfg Flag)) (make (map string string))))

  (set! (.-PackageFile (.-Cfg Flag)) (lit (map string string)))
  (let [(values data err) (os/ReadFile file)]
    (when (!= err nil)
      (log/Fatalf "-importcfg: %v" err))


    (range [lineNum line (strings/Split (conv string data) "\n")]
      (inc! lineNum) ; 1-based
      (set! line (strings/TrimSpace line))
      (when (or (== line "") (strings/HasPrefix line "#"))
        (continue))


      (let [(values verb args found) (strings/Cut line " ")]
        (when found
          (set! args (strings/TrimSpace args)))

        (let [(values before after hasEq) (strings/Cut args "=")]

          (switch verb
            (default
              (log/Fatalf "%s:%d: unknown directive %q" file lineNum verb))
            (case ["importmap"]
              (when (or (not hasEq) (== before "") (== after ""))
                (log/Fatalf "%s:%d: invalid importmap: syntax is \"importmap old=new\"" file lineNum))

              (aset (.-ImportMap (.-Cfg Flag)) before after))
            (case ["packagefile"]
              (when (or (not hasEq) (== before "") (== after ""))
                (log/Fatalf "%s:%d: invalid packagefile: syntax is \"packagefile path=filename\"" file lineNum))

              (aset (.-PackageFile (.-Cfg Flag)) before after))))))))




^{:go/end 562} (go/func readCoverageCfg [^string file]
  (let [^covcmd/CoverFixupConfig cfg (zero covcmd/CoverFixupConfig)
      (values data err) (os/ReadFile file)]
    (when (!= err nil)
      (log/Fatalf "-coveragecfg: %v" err))

    (when [err (json/Unmarshal data (addr cfg))] (!= err nil)
      (log/Fatalf "error reading -coveragecfg file %q: %v" file err))

    (set! (.-CoverageInfo (.-Cfg Flag)) (addr cfg))))


^{:go/end 578} (go/func readEmbedCfg [^string file]
  (let [(values data err) (os/ReadFile file)]
    (when (!= err nil)
      (log/Fatalf "-embedcfg: %v" err))

    (when [err (json/Unmarshal data (addr (.-Embed (.-Cfg Flag))))] (!= err nil)
      (log/Fatalf "%s: %v" file err))

    (when (== (.-Patterns (.-Embed (.-Cfg Flag))) nil)
      (log/Fatalf "%s: invalid embedcfg: missing Patterns" file))

    (when (== (.-Files (.-Embed (.-Cfg Flag))) nil)
      (log/Fatalf "%s: invalid embedcfg: missing Files" file))))




^{:go/end 607} (go/func parseSpectre "parseSpectre parses the spectre configuration from the string s.\n" [^string s]
  (range [f (strings/SplitSeq s ",")]
    (set! f (strings/TrimSpace f))
    (switch f
      (default
        (log/Fatalf "unknown setting -spectre=%s" f))
      (case [""])
      ;; nothing
      (case ["all"]
        (set! (.-SpectreIndex (.-Cfg Flag)) true)
        (set! (.-Retpoline Ctxt) true))
      (case ["index"]
        (set! (.-SpectreIndex (.-Cfg Flag)) true))
      (case ["ret"]
        (set! (.-Retpoline Ctxt) true))))



  (when (.-SpectreIndex (.-Cfg Flag))
    (switch buildcfg/GOARCH
      (case ["amd64"])
      ;; ok
      (default
        (log/Fatalf "GOARCH=%s does not support -spectre=index" buildcfg/GOARCH)))))

(in-ns 'go.cmd.compile.internal.base) (go/file "mapfile_mmap.go" :build ["//go:build unix"] :imports [


    ^{:line 10} [unsafeheader "internal/unsafeheader"]
    ^{:line 11} [os "os"]
    ^{:line 12} [runtime "runtime"]
    ^{:line 13} [syscall "syscall"]
    ^{:line 14} [unsafe "unsafe"]])


;; TODO(mdempsky): Is there a higher-level abstraction that still
;; works well for iimport?



^{:go/end 45} (go/func MapFile "MapFile returns length bytes from the file starting at the\nspecified offset as a string.\n" [^{:tag (* os/File)} f ^int64 offset ^int64 length] :results [string error]
  ;; POSIX mmap: "The implementation may require that off is a
  ;; multiple of the page size."
  (let [x (bit-and offset (conv int64 (- (os/Getpagesize) 1)))]
    (set! offset - x)
    (set! length + x)

    (let [(values buf err) (syscall/Mmap (conv int (.Fd f)) offset (conv int length) syscall/PROT_READ syscall/MAP_SHARED)]
      (runtime/KeepAlive f)
      (when (!= err nil)
        (return "" err))


      (set! buf (subslice buf x))
      (let [pSlice (conv (* unsafeheader/Slice) (conv unsafe/Pointer (addr buf)))

          ^{:line 38 :tag string} res (zero string)
          ^{:line 39} pString (conv (* unsafeheader/String) (conv unsafe/Pointer (addr res)))]

        (set! (.-Data pString) (.-Data pSlice))
        (set! (.-Len pString) (.-Len pSlice))

        (return res nil)))))

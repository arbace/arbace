;; Debug arguments, set by -d flag.

(in-ns 'go.cmd.compile.internal.base) (go/file "debug.go" :imports [])


(go/var ^{:tag DebugFlags :doc "Debug holds the parsed debugging configuration values.\n"} Debug)









(go/type DebugFlags "DebugFlags defines the debugging configuration values (see var Debug).\nEach struct field is a different value, named for the lower-case of the field name.\nEach field must be an int or string and must have a `help` struct tag.\nDon't forget to note that concurrency is \"ok\" when it is,\nelse the compiler will serialize for that flag.\n\nThe -d option takes a comma-separated list of settings.\nEach setting is name=value; for ints, name is short for name=1.\n" (struct
    ^{:line 21 :tag int :go/tag "help:\"enable hot block alignment (currently requires -pgo)\" concurrent:\"ok\""} AlignHot
    ^{:line 22 :tag int :go/tag "help:\"print information about append compilation\""} Append
    ^{:line 23 :tag string :go/tag "help:\"for specified function/method, dump AST/IR at interesting points in compilation, to file pkg.func.ast. Use leading ~ for regular expression match.\""} AstDump
    ^{:line 24 :tag int :go/tag "help:\"instrument unsafe pointer conversions\\n0: instrumentation disabled\\n1: conversions involving unsafe.Pointer are instrumented\\n2: conversions to unsafe.Pointer force heap allocation\" concurrent:\"ok\""} Checkptr
    ^{:line 25 :tag int :go/tag "help:\"print information about closure compilation\""} Closure
    ^{:line 26 :tag int :go/tag "help:\"use compressed instructions when possible (if supported by architecture)\" concurrent:\"ok\""} CompressInstructions
    ^{:line 27 :tag string :go/tag "help:\"hash value for use in debugging changes to platform-dependent float-to-[u]int conversion\" concurrent:\"ok\""} Converthash
    ^{:line 28 :tag int :go/tag "help:\"print information about defer compilation\""} Defer
    ^{:line 29 :tag int :go/tag "help:\"disable nil checks\" concurrent:\"ok\""} DisableNil
    ^{:line 30 :tag string :go/tag "help:\"dump function properties from inl heuristics to specified file\""} DumpInlFuncProps
    ^{:line 31 :tag int :go/tag "help:\"dump scored callsites during inlining\""} DumpInlCallSiteScores
    ^{:line 32 :tag string :go/tag "help:\"set inliner score adjustments (ex: -d=inlscoreadj=panicPathAdj:10/passConstToNestedIfAdj:-90)\" concurrent:\"ok\""} InlScoreAdj
    ^{:line 33 :tag int :go/tag "help:\"amount to expand the initial inline budget when new inliner enabled. Defaults to 80 if option not set.\" concurrent:\"ok\""} InlBudgetSlack
    ^{:line 34 :tag int :go/tag "help:\"show Node pointers values in dump output\""} DumpPtrs
    ^{:line 35 :tag int :go/tag "help:\"print information about DWARF inlined function creation\""} DwarfInl
    ^{:line 36 :tag int :go/tag "help:\"print extra escape analysis diagnostics about mutations and calls\" concurrent:\"ok\""} EscapeMutationsCalls
    ^{:line 37 :tag int :go/tag "help:\"print information about escape analysis and resulting optimizations\" concurrent:\"ok\""} EscapeDebug
    ^{:line 38 :tag int :go/tag "help:\"print information about alias analysis\" concurrent:\"ok\""} EscapeAlias
    ^{:line 39 :tag int :go/tag "help:\"enable additional validation for alias analysis\" concurrent:\"ok\""} EscapeAliasCheck
    ^{:line 40 :tag int :go/tag "help:\"print export data\""} Export
    ^{:line 41 :tag string :go/tag "help:\"hash value for FIPS debugging\" concurrent:\"ok\""} FIPSHash
    ^{:line 42 :tag string :go/tag "help:\"hash value for use in debugging platform-dependent multiply-add use\" concurrent:\"ok\""} Fmahash
    ^{:line 43 :tag int :go/tag "help:\"insert frees of append results when proven safe (0 disabled, 1 enabled, 2 enabled + log)\" concurrent:\"ok\""} FreeAppend
    ^{:line 44 :tag int :go/tag "help:\"log adjustments to GOGC\" concurrent:\"ok\""} GCAdjust
    ^{:line 45 :tag int :go/tag "help:\"check heap/gc use by compiler\" concurrent:\"ok\""} GCCheck
    ^{:line 46 :tag int :go/tag "help:\"print dump of GC programs\""} GCProg
    ^{:line 47 :tag int :go/tag "help:\"specify \\\"starting\\\" compiler's heap size in MiB\" concurrent:\"ok\""} GCStart
    ^{:line 48 :tag string :go/tag "help:\"hash value for use in debugging the compiler\""} Gossahash
    ^{:line 49 :tag int :go/tag "help:\"allow functions with closures to be inlined\" concurrent:\"ok\""} InlFuncsWithClosures
    ^{:line 50 :tag int :go/tag "help:\"allow static initialization of inlined calls\" concurrent:\"ok\""} InlStaticInit
    ^{:line 51 :tag int :go/tag "help:\"allow anonymous interface cycles\" concurrent:\"ok\""} InterfaceCycles
    ^{:line 52 :tag int :go/tag "help:\"enable coverage instrumentation for libfuzzer\""} Libfuzzer
    ^{:line 53 :tag string :go/tag "help:\"hash value for use in debugging literal allocation optimizations\" concurrent:\"ok\""} LiteralAllocHash
    ^{:line 54 :tag int :go/tag "help:\"shared (0), 1 (private loop variables, default), 2, private + log\" concurrent:\"ok\""} LoopVar
    ^{:line 55 :tag string :go/tag "help:\"for debugging changes in loop behavior. Overrides experiment and loopvar flag.\" concurrent:\"ok\""} LoopVarHash
    ^{:line 56 :tag int :go/tag "help:\"print information about DWARF location list creation\""} LocationLists
    ^{:line 57 :tag int :go/tag "help:\"hash shape names longer than this threshold (default 500)\" concurrent:\"ok\""} MaxShapeLen
    ^{:line 58 :tag int :go/tag "help:\"merge together non-interfering local stack slots\" concurrent:\"ok\""} MergeLocals
    ^{:line 59 :tag string :go/tag "help:\"dump specified func in merge locals\""} MergeLocalsDumpFunc
    ^{:line 60 :tag string :go/tag "help:\"hash value for debugging stack slot merging of local variables\" concurrent:\"ok\""} MergeLocalsHash
    ^{:line 61 :tag int :go/tag "help:\"trace debug output for locals merging\""} MergeLocalsTrace
    ^{:line 62 :tag int :go/tag "help:\"hash-selected trace debug output for locals merging\""} MergeLocalsHTrace
    ^{:line 63 :tag int :go/tag "help:\"print information about nil checks\""} Nil
    ^{:line 64 :tag int :go/tag "help:\"disable deadlocals pass\" concurrent:\"ok\""} NoDeadLocals
    ^{:line 65 :tag int :go/tag "help:\"disable open-coded defers\" concurrent:\"ok\""} NoOpenDefer
    ^{:line 66 :tag int :go/tag "help:\"do not include referenced symbol names in object file\" concurrent:\"ok\""} NoRefName
    ^{:line 67 :tag string :go/tag "help:\"print named pc-value table\\nOne of: pctospadj, pctofile, pctoline, pctoinline, pctopcdata\""} PCTab
    ^{:line 68 :tag int :go/tag "help:\"show all compiler panics\""} Panic
    ^{:line 69 :tag int :go/tag "help:\"print information about expression reshaping\""} Reshape
    ^{:line 70 :tag int :go/tag "help:\"print information about shaping recursive types\""} Shapify
    ^{:line 71 :tag int :go/tag "help:\"print information about simd analysis and code transformation\" concurrent:\"ok\""} Simd
    ^{:line 72 :tag int :go/tag "help:\"print information about slice compilation\""} Slice
    ^{:line 73 :tag int :go/tag "help:\"force compiler to emit soft-float code\" concurrent:\"ok\""} SoftFloat
    ^{:line 74 :tag int :go/tag "help:\"print information about missed static copies\" concurrent:\"ok\""} StaticCopy
    ^{:line 75 :tag int :go/tag "help:\"how many writer stack frames to include at sync points in unified export data\" concurrent:\"ok\""} SyncFrames
    ^{:line 76 :tag int :go/tag "help:\"print information about tail calls\""} TailCall
    ^{:line 77 :tag int :go/tag "help:\"print information about type assertion inlining\""} TypeAssert
    ^{:line 78 :tag int :go/tag "help:\"print information about write barriers\""} WB
    ^{:line 79 :tag int :go/tag "help:\"print information about ABI wrapper generation\""} ABIWrap
    ^{:line 80 :tag string :go/tag "help:\"call named function before all stack growth checks\" concurrent:\"ok\""} MayMoreStack
    ^{:line 81 :tag int :go/tag "help:\"debug profile-guided optimizations\""} PGODebug
    ^{:line 82 :tag string :go/tag "help:\"hash value for debugging profile-guided optimizations\" concurrent:\"ok\""} PGOHash
    ^{:line 83 :tag int :go/tag "help:\"enable profile-guided inlining\" concurrent:\"ok\""} PGOInline
    ^{:line 84 :tag string :go/tag "help:\"cumulative threshold percentage for determining call sites as hot candidates for inlining\" concurrent:\"ok\""} PGOInlineCDFThreshold
    ^{:line 85 :tag int :go/tag "help:\"inline budget for hot functions\" concurrent:\"ok\""} PGOInlineBudget
    ^{:line 86 :tag int :go/tag "help:\"enable profile-guided devirtualization; 0 to disable, 1 to enable interface devirtualization, 2 to enable function devirtualization\" concurrent:\"ok\""} PGODevirtualize
    ^{:line 87 :tag int :go/tag "help:\"insert code to check behavior of range iterator functions\" concurrent:\"ok\""} RangeFuncCheck
    ^{:line 88 :tag string :go/tag "help:\"hash value for debugging stack allocation of variable-sized make results\" concurrent:\"ok\""} VariableMakeHash
    ^{:line 89 :tag int :go/tag "help:\"threshold in bytes for possible stack allocation of variable-sized make results\" concurrent:\"ok\""} VariableMakeThreshold
    ^{:line 90 :tag int :go/tag "help:\"debug trace output for global map init wrapping\""} WrapGlobalMapDbg
    ^{:line 91 :tag int :go/tag "help:\"global map init wrap control (0 => default, 1 => off, 2 => stress mode, no size cutoff)\" concurrent:\"ok\""} WrapGlobalMapCtl
    ^{:line 92 :tag int :go/tag "help:\"enable zero-copy string->[]byte conversions\" concurrent:\"ok\""} ZeroCopy

    ^{:line 94 :tag bool} ConcurrentOk)) ; true if only concurrentOk flags seen





(go/var ^{:tag (func [^string phase ^string flag ^int val ^string valString] [string]) :doc "DebugSSA is called to set a -d ssa/... option.\nIf nil, those options are reported as invalid options.\nIf DebugSSA returns a non-empty string, that text is reported as a compiler error.\n"} DebugSSA)

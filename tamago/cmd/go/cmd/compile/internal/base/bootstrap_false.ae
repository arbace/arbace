(in-ns 'go.cmd.compile.internal.base) (go/file "bootstrap_false.go" :build ["//go:build !compiler_bootstrap"] :imports [])



(go/const ^{:val false :doc "CompilerBootstrap reports whether the current compiler binary was\nbuilt with -tags=compiler_bootstrap.\n"} CompilerBootstrap false)

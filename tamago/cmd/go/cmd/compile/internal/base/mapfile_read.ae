(in-ns 'go.cmd.compile.internal.base) (go/file "mapfile_read.go" :build ["//go:build !unix"] :imports [


    ^{:line 10} [io "io"]
    ^{:line 11} [os "os"]])


^{:go/end 21} (go/func MapFile [^{:tag (* os/File)} f ^int64 offset ^int64 length] :results [string error]
  (let [buf (make (slice byte) length)
      (values _ err) (io/ReadFull (io/NewSectionReader f offset length) buf)]
    (when (!= err nil)
      (return "" err))

    (return (conv string buf) nil)))

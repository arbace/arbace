      (finalizer (new T)))))































^{:go/end 272} (go/func AdjustStartingHeap "AdjustStartingHeap modifies GOGC so that GC should not occur until the heap\ngrows to the requested size.  This is intended but not promised, though it\nis true-mostly, depending on when the adjustment occurs and on the\ncompiler's input and behavior.  Once the live heap is approximately half\nthis size, GOGC is reset to its value when AdjustStartingHeap was called;\nsubsequent GCs may reduce the heap below the requested size, but this\nfunction does not affect that.\n\nlogHeapTweaks (-d=gcadjust=1) enables logging of GOGC adjustment events.\n\nThe temporarily requested GOGC is derated from what would be the \"obvious\"\nvalue necessary to hit the starting heap goal because the obvious\n(goal/live-1)*100 value seems to grow RSS a little more than it \"should\"\n(compared to GOMEMLIMIT, e.g.) and the assumption is that the GC's control\nalgorithms are tuned for GOGC near 100, and not tuned for huge values of\nGOGC.  Different derating factors apply for \"lo\" and \"hi\" values of GOGC;\nlo is below derateBreak, hi is above derateBreak.  The derating factors,\nexpressed as integer percentages, are derateLoPct and derateHiPct.\n60-75 is an okay value for derateLoPct, 30-65 seems like a good value for\nderateHiPct, and 600 seems like a good value for derateBreak.  If these\nare zero, defaults are used instead.\n\nNOTE: If you think this code would help startup time in your own\napplication and you decide to use it, please benchmark first to see if it\nactually works for you (it may not: the Go compiler is not typical), and\nwhatever the outcome, please leave a comment on bug #56546.  This code\nuses supported interfaces, but depends more than we like on\ncurrent+observed behavior of the garbage collector, so if many people need\nthis feature, we should consider/propose a better way to accomplish it.\n" [^uint64 requestedHeapGoal ^uint64 derateBreak ^uint64 derateLoPct ^uint64 derateHiPct ^bool logHeapTweaks]
  (let [mp (runtime/GOMAXPROCS 0)


      ^:const ^{:line 63 :val "/gc/heap/goal:bytes"} SHgoal "/gc/heap/goal:bytes"
      ^:const ^:go/grouped ^{:line 64 :val "/gc/cycles/total:gc-cycles"} SHcount "/gc/cycles/total:gc-cycles"
      ^:const ^:go/grouped ^{:line 65 :val "/gc/heap/allocs:bytes"} SHallocs "/gc/heap/allocs:bytes"
      ^:const ^:go/grouped ^{:line 66 :val "/gc/heap/frees:bytes"} SHfrees "/gc/heap/frees:bytes"


      ^:var ^{:line 69} sample (lit (slice metrics/Sample) (lit _ :Name SHgoal) (lit _ :Name SHcount) (lit _ :Name SHallocs) (lit _ :Name SHfrees))


      ^:const ^{:line 72 :val 0} SH_GOAL 0
      ^:const ^:go/grouped ^{:line 73 :val 1} SH_COUNT 1
      ^:const ^:go/grouped ^{:line 74 :val 2} SH_ALLOCS 2
      ^:const ^:go/grouped ^{:line 75 :val 3} SH_FREES 3

      ^:const ^:go/grouped ^{:line 77 :val 1000000} MB 1000000]


    ;; These particular magic numbers are designed to make the RSS footprint of -d=-gcstart=2000
    ;; resemble that of GOMEMLIMIT=2000MiB GOGC=10000 when building large projects
    ;; (e.g. the Go compiler itself, and the microsoft's typescript AST package),
    ;; with the further restriction that these magic numbers did a good job of reducing user-cpu
    ;; for builds at either gcstart=2000 or gcstart=128.
    ;;
    ;; The benchmarking to obtain this was (a version of):
    ;;
    ;; for i in {1..50} ; do
    ;;     for what in std cmd/compile cmd/fix cmd/go github.com/microsoft/typescript-go/internal/ast ; do
    ;;       whatbase=`basename ${what}`
    ;;       for sh in 128 2000 ; do
    ;;         for br in 500 600 ; do
    ;;           for shlo in 65 70; do
    ;;             for shhi in 55 60 ; do
    ;;               benchcmd -n=2 ${whatbase} go build -a \
    ;;               -gcflags=all=-d=gcstart=${sh},gcstartloderate=${shlo},gcstarthiderate=${shhi},gcstartbreak=${br} \
    ;;               ${what} | tee -a startheap${sh}_${br}_${shhi}_${shlo}.bench
    ;;             done
    ;;           done
    ;;         done
    ;;       done
    ;;     done
    ;; done
    ;;
    ;; benchcmd is "go install github.com/aclements/go-misc/benchcmd@latest"

    (when (== derateBreak 0)
      (set! derateBreak 600))

    (when (== derateLoPct 0)
      (set! derateLoPct 70))

    (when (== derateHiPct 0)
      (set! derateHiPct 55))


    (let [gogcDerate ^{:go/end 122} (fn ^uint64 [^uint64 myGogc]
          (when (< myGogc derateBreak)
            (return (/ (* myGogc derateLoPct) 100)))

          (/ (* myGogc derateHiPct) 100))]


      ;; Assumptions and observations of Go's garbage collector, as of Go 1.17-1.20:

      ;; - the initial heap goal is 4MiB, by fiat.  It is possible for Go to start
      ;;   with a heap as small as 512k, so this may change in the future.

      ;; - except for the first heap goal, heap goal is a function of
      ;;   observed-live at the previous GC and current GOGC.  After the first
      ;;   GC, adjusting GOGC immediately updates GOGC; before the first GC,
      ;;   adjusting GOGC does not modify goal (but the change takes effect after
      ;;   the first GC).

      ;; - the before/after first GC behavior is not guaranteed anywhere, it's
      ;;   just behavior, and it's a bad idea to rely on it.

      ;; - we don't know exactly when GC will run, even after we adjust GOGC; the
      ;;   first GC may not have happened yet, may have already happened, or may
      ;;   be currently in progress, and GCs can start for several reasons.

      ;; - forEachGC above will run the provided function at some delay after each
      ;;   GC's mark phase terminates; finalizers are run after marking as the
      ;;   spans containing finalizable objects are swept, driven by GC
      ;;   background activity and allocation demand.

      ;; - "live at last GC" is not available through the current metrics
      ;;    interface. Instead, live is estimated by knowing the adjusted value of
      ;;    GOGC and the new heap goal following a GC (this requires knowing that
      ;;    at least one GC has occurred):
      ;;		  estLive = 100 * newGoal / (100 + currentGogc)
      ;;    this new value of GOGC
      ;;		  newGogc = 100*requestedHeapGoal/estLive - 100
      ;;    will result in the desired goal. The logging code checks that the
      ;;    resulting goal is correct.

      ;; There's a small risk that the finalizer will be slow to run after a GC
      ;; that expands the goal to a huge value, and that this will lead to
      ;; out-of-memory.  This doesn't seem to happen; in experiments on a variety
      ;; of machines with a variety of extra loads to disrupt scheduling, the
      ;; worst overshoot observed was 50% past requestedHeapGoal.

      (metrics/Read sample)
      (range [_ s sample]
        (when (== (.Kind (.-Value s)) metrics/KindBad)
          ;; Just return, a slightly slower compilation is a tolerable outcome.
          (when logHeapTweaks
            (fmt/Fprintf os/Stderr "GCAdjust: Regret unexpected KindBad for metric %s\n" (.-Name s)))

          (return)))



      ;; Tinker with GOGC to make the heap grow rapidly at first.
      (let [currentGoal (.Uint64 (.-Value (aget sample SH_GOAL))) ; Believe this will be 4MByte or less, perhaps 512k
          ^{:line 176} myGogc (/ (* 100 requestedHeapGoal) currentGoal)]
        (set! myGogc (gogcDerate myGogc))
        (when (<= myGogc 125)

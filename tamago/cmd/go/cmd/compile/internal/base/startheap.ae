        (when logHeapTweaks
          (let [sample (append (conv (slice metrics/Sample) nil) (spread sample))] ; avoid races with GC callback
            (AtExit ^{:go/end 199} (fn []
                (metrics/Read sample)
                (let [goal (.Uint64 (.-Value (aget sample SH_GOAL)))
                    ^{:line 187} count (.Uint64 (.-Value (aget sample SH_COUNT)))
                    ^{:line 188} oldGogc (debug/SetGCPercent 100)]

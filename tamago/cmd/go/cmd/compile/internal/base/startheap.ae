^{:go/end 28} (go/func forEachGC "forEachGC calls fn each GC cycle until it returns false.\n" [^{:tag (func [] [bool])} fn]
  (let-type [T (array 32 byte)] ; large enough to avoid runtime's tiny object allocator
    (let [^{:tag (func [(* T)])} finalizer (zero (func [(* T)]))]
      (set! finalizer ^{:go/end 25} (fn [^{:tag (* T)} p]

          (when (go/call fn)

(in-ns 'go.cmd.compile.internal.base) (go/file "base.go" :imports [


    ^{:line 8} [os "os"]])


(go/var ^{:tag (slice (func []))} atExitFuncs)

^{:go/end 15} (go/func AtExit [^{:tag (func [])} f]
  (set! atExitFuncs (append atExitFuncs f)))


^{:go/end 24} (go/func Exit [^int code]
  (for [i (- (len atExitFuncs) 1)] (>= i 0) (dec! i)
    (let [f (aget atExitFuncs i)]
      (set! atExitFuncs (subslice atExitFuncs _ i))
      (f)))

  (os/Exit code))



(go/const ^{:val false :doc "To enable tracing support (-t flag), set EnableTrace to true.\n"} EnableTrace false)

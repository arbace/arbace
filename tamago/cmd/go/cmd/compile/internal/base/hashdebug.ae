          (set! (.-matches hd) (append (.-matches hd) (toHashAndMask "1" (fmt/Sprintf "%s1" ev))))
          (break))

        (if (== i 0)
          (set! (.-matches hd) (append (.-matches hd) (toHashAndMask s ev)))

          (set! (.-matches hd) (append (.-matches hd) (toHashAndMask s (fmt/Sprintf "%s%d" ev (- i 1))))))


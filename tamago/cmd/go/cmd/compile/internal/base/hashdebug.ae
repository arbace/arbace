^{:go/breaks [[7 350]] :go/end 351} (go/method matchAndLog "matchAndLog is the core matcher. It reports whether the hash matches the pattern.\nIf a report needs to be printed, match prints that report to the log file.\nThe text func must be non-nil and should return a user-readable\nrepresentation of what was hashed. The note func may be nil; if non-nil,\nit should return additional information to display to the user when this\nchange is selected.\n" ^bool [^{:tag (* HashDebug)} d ^uint64 hash ^{:tag (func [] [string])} text ^{:tag (func [] [string])} note]
  (when (!= (.-bisect d) nil)
    (let [enabled (.ShouldEnable (.-bisect d) hash)]
      (when (.ShouldPrint (.-bisect d) hash)
        (let [disabled ""]
          (when (not enabled)
            (set! disabled " [DISABLED]"))

          (let [^string t (zero string)]
            (when (not (.MarkerOnly (.-bisect d)))
              (set! t (text))
              (when (!= note nil)
                (when [n (note)] (!= n "")
                  (set! t + (+ ": " n disabled))
                  (set! disabled ""))))



            (.log d (.-name d) hash (strings/TrimSpace (+ t disabled))))))

      (return enabled)))


  ;; TODO: Delete rest of function body when we switch to bisect-only.
  (when (.excluded d hash)
    (return false))

  (when [m (.match d hash)] (!= m nil)
    (.log d (.-name m) hash (text))
    (return true))

  false)






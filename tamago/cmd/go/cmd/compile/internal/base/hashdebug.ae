^{:go/end 158} (go/func toHashAndMask "TODO: Delete when we switch to bisect-only.\n" ^hashAndMask [^string s ^string varname]
  (let [l (len s)]
    (when (> l 64)
      (set! s (subslice s (- l 64)))
      (set! l 64))

    (let [m (bit-not (<< (bit-not (conv uint64 0)) l))
        (values h err) (strconv/ParseUint s 2 64)]
      (when (!= err nil)
        (Fatalf "Could not parse %s (=%s) as a binary number" varname s))


      (lit hashAndMask :name varname :hash h :mask m))))





^{:go/end 211} (go/func NewHashDebug "NewHashDebug returns a new hash-debug tester for the\nenvironment variable ev.  If ev is not set, it returns\nnil, allowing a lightweight check for normal-case behavior.\n" ^{:tag (* HashDebug)} [^string ev ^string s ^io/Writer file]

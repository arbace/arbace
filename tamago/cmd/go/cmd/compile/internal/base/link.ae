(in-ns 'go.cmd.compile.internal.base) (go/file "link.go" :imports [


    ^{:line 8} [obj "cmd/internal/obj"]])










(go/var ^{:doc "ReservedImports are import paths used internally for generated\nsymbols by the compiler.\n\nThe linker uses the magic symbol prefixes \"go:\" and \"type:\".\nAvoid potential confusion between import paths and symbols\nby rejecting these reserved imports for now. Also, people\n\"can do weird things in GOPATH and we'd prefer they didn't\ndo _that_ weird thing\" (per rsc). See also #4257.\n"} ReservedImports (lit (map string bool)
    ^{:line 20} ["go" true]
    ^{:line 21} ["type" true]))


(go/var ^{:tag (* obj/Link)} Ctxt)

;; TODO(mdempsky): These should probably be obj.Link methods.




^{:go/end 41} (go/func PkgLinksym "PkgLinksym returns the linker symbol for name within the given\npackage prefix. For user packages, prefix should be the package\npath encoded with objabi.PathToPrefix.\n" ^{:tag (* obj/LSym)} [^string prefix ^string name ^obj/ABI abi]
  (when (== name "_")
    ;; TODO(mdempsky): Cleanup callers and Fatalf instead.
    (return (linksym prefix "_" abi)))

  (let [sep "."]
    (when (aget ReservedImports prefix)
      (set! sep ":"))

    (linksym prefix (+ prefix sep name) abi)))




^{:go/end 47} (go/func Linkname "Linkname returns the linker symbol for the given name as it might\nappear within a //go:linkname directive.\n" ^{:tag (* obj/LSym)} [^string name ^obj/ABI abi]
  (linksym "_" name abi))




^{:go/end 53} (go/func linksym "linksym is an internal helper function for implementing the above\nexported APIs.\n" ^{:tag (* obj/LSym)} [^string pkg ^string name ^obj/ABI abi]
  (.LookupABIInit Ctxt name abi ^{:go/end 52} (fn [^{:tag (* obj/LSym)} r] (set! (.-Pkg r) pkg))))

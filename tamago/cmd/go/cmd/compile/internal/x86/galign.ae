(in-ns 'go.cmd.compile.internal.x86) (go/file "galign.go" :imports [


    ^{:line 8} [base "cmd/compile/internal/base"]
    ^{:line 9} [ssagen "cmd/compile/internal/ssagen"]
    ^{:line 10} [x86 "cmd/internal/obj/x86"]
    ^{:line 11} [fmt "fmt"]
    ^{:line 12} [buildcfg "internal/buildcfg"]
    ^{:line 13} [os "os"]])


^{:go/end 39} (go/func Init [^{:tag (* ssagen/ArchInfo)} arch]
  (set! (.-LinkArch arch) (addr x86/Link386))
  (set! (.-REGSP arch) x86/REGSP)
  (set! (.-SSAGenValue arch) ssaGenValue)
  (set! (.-SSAGenBlock arch) ssaGenBlock)
  (set! (.-MAXWIDTH arch) (- (<< 1 32) 1))
  (switch [v buildcfg/GO386] v
    (case ["sse2"])
    (case ["softfloat"]
      (set! (.-SoftFloat arch) true))
    (case ["387"]
      (fmt/Fprintf os/Stderr "unsupported setting GO386=387. Consider using GO386=softfloat instead.\n")
      (base/Exit 1))
    (default
      (fmt/Fprintf os/Stderr "unsupported setting GO386=%s\n" v)
      (base/Exit 1)))



  (set! (.-ZeroRange arch) zerorange)
  (set! (.-Ginsnop arch) ginsnop)

  (set! (.-SSAMarkMoves arch) ssaMarkMoves))

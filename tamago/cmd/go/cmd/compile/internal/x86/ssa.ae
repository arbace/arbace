        (return x86/AMOVBLZX))
      (case [2]
        (return x86/AMOVWLZX))))


  ;; Otherwise, there's no difference between load and store opcodes.
  (storeByType t))



^{:go/end 81} (go/func storeByType "storeByType returns the store instruction of the given type.\n" ^obj/As [^{:tag (* types/Type)} t]
  (let [width (.Size t)]
    (if (.IsFloat t)
      (switch width
        (case [4]
          (return x86/AMOVSS))
        (case [8]
          (return x86/AMOVSD)))


      (switch width
        (case [1]
          (return x86/AMOVB))
        (case [2]
          (return x86/AMOVW))
        (case [4]
          (return x86/AMOVL))))


    (panic "bad store type")))



^{:go/end 107} (go/func moveByType "moveByType returns the reg->reg move instruction of the given type.\n" ^obj/As [^{:tag (* types/Type)} t]
  (if (.IsFloat t)
    (switch (.Size t)
      (case [4]
        (return x86/AMOVSS))
      (case [8]
        (return x86/AMOVSD))
      (default
        (panic (fmt/Sprintf "bad float register width %d:%s" (.Size t) t))))



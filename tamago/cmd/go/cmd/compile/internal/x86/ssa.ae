    (case [ssa/Op386REPMOVSL]
      (.Prog s x86/AREP)
      (.Prog s x86/AMOVSL))
    (case [ssa/Op386LoweredNilCheck]
      ;; Issue a load which will fault if the input is nil.
      ;; TODO: We currently use the 2-byte instruction TESTB AX, (reg).
      ;; Should we use the 3-byte TESTB $0, (reg) instead? It is larger
      ;; but it doesn't have false dependency on AX.
      ;; Or maybe allocate an output register and use MOVL (reg),reg2 ?
      ;; That trades clobbering flags for clobbering a register.
      (let [p (.Prog s x86/ATESTB)]
        (set! (.-Type (.-From p)) obj/TYPE_REG)
        (set! (.-Reg (.-From p)) x86/REG_AX)
        (set! (.-Type (.-To p)) obj/TYPE_MEM)
        (set! (.-Reg (.-To p)) (.Reg (aget (.-Args v) 0)))
        (ssagen/AddAux (addr (.-To p)) v)
        (when (logopt/Enabled)
          (logopt/LogOpt (.-Pos v) "nilcheck" "genssa" (.-Name (.-Func (.-Block v)))))

        (when (and (!= (.-Nil base/Debug) 0) (> ^{:go/via [lico]} (.Line (.-Pos v)) 1)) ; v.Pos.Line()==1 in generated wrappers
          (base/WarnfAt (.-Pos v) "generated nil check"))))

    (case [ssa/Op386LoweredCtz32]
      ;; BSFL in, out
      (let [p (.Prog s x86/ABSFL)]
        (set! (.-Type (.-From p)) obj/TYPE_REG)
        (set! (.-Reg (.-From p)) (.Reg (aget (.-Args v) 0)))
        (set! (.-Type (.-To p)) obj/TYPE_REG)
        (set! (.-Reg (.-To p)) (.Reg v))

        ;; JNZ 2(PC)
        (let [p1 (.Prog s x86/AJNE)]
          (set! (.-Type (.-To p1)) obj/TYPE_BRANCH)

          ;; MOVL $32, out
          (let [p2 (.Prog s x86/AMOVL)]
            (set! (.-Type (.-From p2)) obj/TYPE_CONST)
            (set! (.-Offset (.-From p2)) 32)
            (set! (.-Type (.-To p2)) obj/TYPE_REG)
            (set! (.-Reg (.-To p2)) (.Reg v))

            ;; NOP (so the JNZ has somewhere to land)
            (let [nop (.Prog s obj/ANOP)]
              (.SetTarget (.-To p1) nop))))))
    (case [ssa/Op386LoweredCtz64]
      (when (== (.Reg (aget (.-Args v) 0)) (.Reg v))
        (.Fatalf v "input[0] and output in the same register %s" (.LongString v)))

      (when (== (.Reg (aget (.-Args v) 1)) (.Reg v))
        (.Fatalf v "input[1] and output in the same register %s" (.LongString v)))


      ;; BSFL arg0, out
      (let [p (.Prog s x86/ABSFL)]
        (set! (.-Type (.-From p)) obj/TYPE_REG)
        (set! (.-Reg (.-From p)) (.Reg (aget (.-Args v) 0)))
        (set! (.-Type (.-To p)) obj/TYPE_REG)
        (set! (.-Reg (.-To p)) (.Reg v))

        ;; JNZ 5(PC)
        (let [p1 (.Prog s x86/AJNE)]
          (set! (.-Type (.-To p1)) obj/TYPE_BRANCH)

          ;; BSFL arg1, out
          (let [p2 (.Prog s x86/ABSFL)]
            (set! (.-Type (.-From p2)) obj/TYPE_REG)
            (set! (.-Reg (.-From p2)) (.Reg (aget (.-Args v) 1)))
            (set! (.-Type (.-To p2)) obj/TYPE_REG)
            (set! (.-Reg (.-To p2)) (.Reg v))

            ;; JNZ 2(PC)
            (let [p3 (.Prog s x86/AJNE)]
              (set! (.-Type (.-To p3)) obj/TYPE_BRANCH)

              ;; MOVL $32, out
              (let [p4 (.Prog s x86/AMOVL)]
                (set! (.-Type (.-From p4)) obj/TYPE_CONST)
                (set! (.-Offset (.-From p4)) 32)
                (set! (.-Type (.-To p4)) obj/TYPE_REG)
                (set! (.-Reg (.-To p4)) (.Reg v))

                ;; ADDL $32, out
                (let [p5 (.Prog s x86/AADDL)]
                  (set! (.-Type (.-From p5)) obj/TYPE_CONST)
                  (set! (.-Offset (.-From p5)) 32)
                  (set! (.-Type (.-To p5)) obj/TYPE_REG)
                  (set! (.-Reg (.-To p5)) (.Reg v))
                  (.SetTarget (.-To p3) p5)

                  ;; NOP (so the JNZ has somewhere to land)
                  (let [nop (.Prog s obj/ANOP)]
                    (.SetTarget (.-To p1) nop)))))))))

    (case [ssa/OpClobber]
      (let [p (.Prog s x86/AMOVL)]
        (set! (.-Type (.-From p)) obj/TYPE_CONST)
        (set! (.-Offset (.-From p)) 0xdeaddead)
        (set! (.-Type (.-To p)) obj/TYPE_MEM)
        (set! (.-Reg (.-To p)) x86/REG_SP)
        (ssagen/AddAux (addr (.-To p)) v)))
    (case [ssa/OpClobberReg])
    ;; TODO: implement for clobberdead experiment. Nop is ok for now.
    (default
      (.Fatalf v "genValue not implemented: %s" (.LongString v)))))



(go/var blockJump (lit (array ... (struct
        ^{:line 1067 :tag obj/As} asm ^obj/As invasm))

    ^{:line 1069} [ssa/Block386EQ (lit _ x86/AJEQ x86/AJNE)]
    ^{:line 1070} [ssa/Block386NE (lit _ x86/AJNE x86/AJEQ)]
    ^{:line 1071} [ssa/Block386LT (lit _ x86/AJLT x86/AJGE)]
    ^{:line 1072} [ssa/Block386GE (lit _ x86/AJGE x86/AJLT)]
    ^{:line 1073} [ssa/Block386LE (lit _ x86/AJLE x86/AJGT)]
    ^{:line 1074} [ssa/Block386GT (lit _ x86/AJGT x86/AJLE)]
    ^{:line 1075} [ssa/Block386OS (lit _ x86/AJOS x86/AJOC)]
    ^{:line 1076} [ssa/Block386OC (lit _ x86/AJOC x86/AJOS)]
    ^{:line 1077} [ssa/Block386ULT (lit _ x86/AJCS x86/AJCC)]
    ^{:line 1078} [ssa/Block386UGE (lit _ x86/AJCC x86/AJCS)]
    ^{:line 1079} [ssa/Block386UGT (lit _ x86/AJHI x86/AJLS)]
    ^{:line 1080} [ssa/Block386ULE (lit _ x86/AJLS x86/AJHI)]
    ^{:line 1081} [ssa/Block386ORD (lit _ x86/AJPC x86/AJPS)]
    ^{:line 1082} [ssa/Block386NAN (lit _ x86/AJPS x86/AJPC)]))


(go/var eqfJumps (lit (array 2 (array 2 ssagen/IndexJump))
    (lit _ (lit _ :Jump x86/AJNE :Index 1) (lit _ :Jump x86/AJPS :Index 1)) ; next == b.Succs[0]
    (lit _ (lit _ :Jump x86/AJNE :Index 1) (lit _ :Jump x86/AJPC :Index 0)))) ; next == b.Succs[1]

(go/var nefJumps (lit (array 2 (array 2 ssagen/IndexJump))
    (lit _ (lit _ :Jump x86/AJNE :Index 0) (lit _ :Jump x86/AJPC :Index 1)) ; next == b.Succs[0]
    (lit _ (lit _ :Jump x86/AJNE :Index 0) (lit _ :Jump x86/AJPS :Index 0)))) ; next == b.Succs[1]


^{:go/end 1136} (go/func ssaGenBlock [^{:tag (* ssagen/State)} s ^{:tag (* ssa/Block)} b ^{:tag (* ssa/Block)} next]
  (switch (.-Kind b)
    (case [ssa/BlockPlain ssa/BlockDefer]
      (when (!= (.Block (aget (.-Succs b) 0)) next)
        (let [p (.Prog s obj/AJMP)]
          (set! (.-Type (.-To p)) obj/TYPE_BRANCH)
          (set! (.-Branches s) (append (.-Branches s) (lit ssagen/Branch :P p :B (.Block (aget (.-Succs b) 0))))))))

    (case [ssa/BlockExit ssa/BlockRetJmp])
    (case [ssa/BlockRet]
      (.Prog s obj/ARET))

    (case [ssa/Block386EQF]
      (.CombJump s b next (addr eqfJumps)))

    (case [ssa/Block386NEF]
      (.CombJump s b next (addr nefJumps)))

    (case [ssa/Block386EQ ssa/Block386NE
        ^{:line 1113} ssa/Block386LT ssa/Block386GE
        ^{:line 1114} ssa/Block386LE ssa/Block386GT
        ^{:line 1115} ssa/Block386OS ssa/Block386OC
        ^{:line 1116} ssa/Block386ULT ssa/Block386UGT
        ^{:line 1117} ssa/Block386ULE ssa/Block386UGE]
      (let [jmp (aget blockJump (.-Kind b))]
        (switch next
          (case [(.Block (aget (.-Succs b) 0))]
            (.Br s (.-invasm jmp) (.Block (aget (.-Succs b) 1))))
          (case [(.Block (aget (.-Succs b) 1))]
            (.Br s (.-asm jmp) (.Block (aget (.-Succs b) 0))))
          (default
            (if (!= (.-Likely b) ssa/BranchUnlikely) (do
                (.Br s (.-asm jmp) (.Block (aget (.-Succs b) 0)))
                (.Br s obj/AJMP (.Block (aget (.-Succs b) 1))))
              (do
                (.Br s (.-invasm jmp) (.Block (aget (.-Succs b) 1)))
                (.Br s obj/AJMP (.Block (aget (.-Succs b) 0)))))))))


    (default
      (.Fatalf b "branch not implemented: %s" (.LongString b)))))

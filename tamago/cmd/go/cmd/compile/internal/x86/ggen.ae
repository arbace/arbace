(in-ns 'go.cmd.compile.internal.x86) (go/file "ggen.go" :imports [


    ^{:line 8} [ir "cmd/compile/internal/ir"]
    ^{:line 9} [objw "cmd/compile/internal/objw"]
    ^{:line 10} [types "cmd/compile/internal/types"]
    ^{:line 11} [obj "cmd/internal/obj"]
    ^{:line 12} [x86 "cmd/internal/obj/x86"]])


^{:go/end 40} (go/func zerorange ^{:tag (* obj/Prog)} [^{:tag (* objw/Progs)} pp ^{:tag (* obj/Prog)} p ^int64 off ^int64 cnt ^{:tag (* uint32)} ax]
  (when (== cnt 0)
    (return p))

  (when (== @ax 0)
    (set! p (.Append pp p x86/AMOVL obj/TYPE_CONST 0 0 obj/TYPE_REG x86/REG_AX 0))
    (set! @ax 1))


  (cond (<= cnt (conv int64 (* 4 types/RegSize)))
    (for [i (conv int64 0)] (< i cnt) (set! i + (conv int64 types/RegSize))
      (set! p (.Append pp p x86/AMOVL obj/TYPE_REG x86/REG_AX 0 obj/TYPE_MEM x86/REG_SP (+ off i))))

    (<= cnt (conv int64 (* 128 types/RegSize))) (do
      (set! p (.Append pp p x86/ALEAL obj/TYPE_MEM x86/REG_SP off obj/TYPE_REG x86/REG_DI 0))
      (set! p (.Append pp p obj/ADUFFZERO obj/TYPE_NONE 0 0 obj/TYPE_ADDR 0 (* 1 (- 128 (/ cnt (conv int64 types/RegSize))))))
      (set! (.-Sym (.-To p)) (.-Duffzero ir/Syms))) :else
    (do
      (set! p (.Append pp p x86/AMOVL obj/TYPE_CONST 0 (/ cnt (conv int64 types/RegSize)) obj/TYPE_REG x86/REG_CX 0))
      (set! p (.Append pp p x86/ALEAL obj/TYPE_MEM x86/REG_SP off obj/TYPE_REG x86/REG_DI 0))
      (set! p (.Append pp p x86/AREP obj/TYPE_NONE 0 0 obj/TYPE_NONE 0 0))
      (set! p (.Append pp p x86/ASTOSL obj/TYPE_NONE 0 0 obj/TYPE_NONE 0 0))))


  ^{:line 39} p)


^{:go/end 50} (go/func ginsnop ^{:tag (* obj/Prog)} [^{:tag (* objw/Progs)} pp]
  ;; See comment in ../amd64/ggen.go.
  (let [p (.Prog pp x86/AXCHGL)]
    (set! (.-Type (.-From p)) obj/TYPE_REG)
    (set! (.-Reg (.-From p)) x86/REG_AX)
    (set! (.-Type (.-To p)) obj/TYPE_REG)
    (set! (.-Reg (.-To p)) x86/REG_AX)
    ^{:line 49} p))

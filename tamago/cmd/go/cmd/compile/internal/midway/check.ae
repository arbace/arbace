(in-ns 'go.cmd.compile.internal.midway) (go/file "check.go" :imports [


    ^{:line 8} [base "cmd/compile/internal/base"]
    ^{:line 9} [syntax "cmd/compile/internal/syntax"]])





^{:go/end 27} (go/func CheckPositions "CheckPositions checks that all nodes in the files have known positions.\nThis converts lack-of-Pos into an early fatal error instead of a later\nweird downstream error (e.g., in the linker, in debugging information).\n" [^{:tag (slice (* syntax/File))} files ^string phase]
  (range [_ file files]
    (syntax/Inspect file ^{:go/breaks [[4 24]] :go/end 25} (fn ^bool [^syntax/Node n]
        (when (== n nil)
          (return true))

        (when (not (.IsKnown (.Pos n)))
          (base/Fatalf "Phase %s, Node without known position: %T\n" phase n))

        true))))

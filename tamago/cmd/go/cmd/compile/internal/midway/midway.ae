(in-ns 'go.cmd.compile.internal.midway) (go/file "midway.go" :imports [


    ^{:line 8} [buildcfg "internal/buildcfg"]])


^{:go/breaks [[4 20]] :go/end 21} (go/func rewriteSizes ^{:tag (slice int)} []
  (switch buildcfg/GOARCH
    (case ["wasm"]
      (return (lit (slice int) 0 128)))
    (case ["amd64"]
      (return (lit (slice int) 0 128 256 512)))
    (case ["arm64"]
      (return (lit (slice int) 0 128)))) ; this will change for SVE and cannot just be a size-based choice.

  nil)


(go/const ^{:val "simd"} simdPkg "simd")
(go/const ^{:val "simd/internal/bridge"} archFullPkg "simd/internal/bridge")
(go/const ^{:val "bridge"} archPkg "bridge")
(go/const ^{:val "VectorBitSize"} vectorSizeFn "VectorBitSize")
(go/const ^{:val "Emulated"} emulatedFn "Emulated")

^{:go/breaks [[4 37]] :go/end 38} (go/func isSimdTypeName ^bool [^string s]
  (switch s
    (case ^{:go/breaks [4 8 12]} ["Int8s" "Int16s" "Int32s" "Int64s"
        "Uint8s" "Uint16s" "Uint32s" "Uint64s"
        "Mask8s" "Mask16s" "Mask32s" "Mask64s"
        "Float32s" "Float64s"]
      (return true)))

  false)

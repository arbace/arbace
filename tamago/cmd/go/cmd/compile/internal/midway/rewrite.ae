^{:go/end 195} (go/method Rewrite [^{:tag (* Rewriter)} r ^{:tag (slice (* syntax/File))} files]

  ;; First duplicate and specialize all dependent functions and variables.
  (range [_ fileAST files]

    (let [^{:tag (slice syntax/Decl)} newDecls (zero (slice syntax/Decl))]
      (range [_ k (.-sizes r)]

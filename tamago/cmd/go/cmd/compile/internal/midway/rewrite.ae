                (when (> (.-Simd base/Debug) 0)
                  (base/Warn "%s: removing body of dependent-sig original function %v" (.String ^{:go/via [decl node]} (.Pos d)) (.-Value (.-Name d))))

                (set! (.-Body d) (.blockOf r ^{:go/via [decl node]} (.Pos d) ^{:go/breaks [3]} (.panicStmt r ^{:go/via [decl node]} (.Pos d)

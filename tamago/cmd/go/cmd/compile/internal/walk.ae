(ns go.cmd.compile.internal.walk
  (:require [arbace.go :as go]))

(go/package walk
  :path "cmd/compile/internal/walk"
  :files ["assign.go" "builtin.go" "closure.go" "compare.go" "complit.go" "convert.go" "expr.go" "order.go" "range.go" "select.go" "stmt.go" "switch.go" "temp.go" "walk.go"]
  :positions :lines)

(load "walk/assign")
(load "walk/builtin")
(load "walk/closure")
(load "walk/compare")
(load "walk/complit")
(load "walk/convert")
(load "walk/expr")
(load "walk/order")
(load "walk/range")
(load "walk/select")
(load "walk/stmt")
(load "walk/switch")
(load "walk/temp")
(load "walk/walk")

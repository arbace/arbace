(in-ns 'go.cmd.compile.internal.objw) (go/file "prog.go" :imports [


    ^{:line 34} [base "cmd/compile/internal/base"]
    ^{:line 35} [ir "cmd/compile/internal/ir"]
    ^{:line 36} [obj "cmd/internal/obj"]
    ^{:line 37} [src "cmd/internal/src"]
    ^{:line 38} [abi "internal/abi"]])


(go/var sharedProgArray (new (array 10000 obj/Prog))) ; *T instead of T to work around issue 19839



^{:go/end 64} (go/func NewProgs "NewProgs returns a new Progs for fn.\nworker indicates which of the backend workers will use the Progs.\n" ^{:tag (* Progs)} [^{:tag (* ir/Func)} fn ^int worker]
  (let [pp (new Progs)]
    (when (.CanReuseProgs base/Ctxt)
      (let [sz (/ (len sharedProgArray) (.-LowerC base/Flag))]
        (set! (.-Cache pp) (subslice sharedProgArray (* sz worker) (* sz (+ worker 1))))))

    (set! (.-CurFunc pp) fn)

    ;; prime the pump
    (set! (.-Next pp) (.NewProg pp))
    (.Clear pp (.-Next pp))

    (set! (.-Pos pp) ^{:go/via [miniNode]} (.Pos fn))
    (.SetText pp fn)
    ;; PCDATA tables implicitly start with index -1.
    (set! (.-PrevLive pp) -1)
    (set! (.-NextLive pp) (.-PrevLive pp))
    (set! (.-NextUnsafe pp) (.-PrevUnsafe pp))
    ^{:line 63} pp))



(go/type Progs "Progs accumulates Progs for a function and converts them into machine code.\n" (struct
    ^{:line 68 :tag (* obj/Prog)} Text ; ATEXT Prog for this function
    ^{:line 69 :tag (* obj/Prog)} Next ; next Prog
    ^{:line 70 :tag int64} PC ; virtual PC; count of Progs
    ^{:line 71 :tag src/XPos} Pos ; position to use for new Progs
    ^{:line 72 :tag (* ir/Func)} CurFunc ; fn these Progs are for
    ^{:line 73 :tag (slice obj/Prog)} Cache ; local progcache
    ^{:line 74 :tag int} CacheIndex ; first free element of progcache

    ^{:line 76 :tag StackMapIndex} NextLive ; liveness index for the next Prog
    ^{:line 77 :tag StackMapIndex} PrevLive ; last emitted liveness index

    ^{:line 79 :tag bool} NextUnsafe ; unsafe mark for the next Prog
    ^{:line 80 :tag bool} PrevUnsafe)) ; last emitted unsafe mark


(go/type StackMapIndex int)







(go/const ^{:tag StackMapIndex :val -1000 :doc "StackMapDontCare indicates that the stack map index at a Value\ndoesn't matter.\n\nThis is a sentinel value that should never be emitted to the PCDATA\nstream. We use -1000 because that's obviously never a valid stack\nindex (but -1 is).\n"} StackMapDontCare -1000)

^{:go/end 95} (go/method StackMapValid ^bool [^StackMapIndex s]
  (!= s StackMapDontCare))


^{:go/end 107} (go/method NewProg ^{:tag (* obj/Prog)} [^{:tag (* Progs)} pp]
  (let [^{:tag (* obj/Prog)} p (zero (* obj/Prog))]
    (if (< (.-CacheIndex pp) (len (.-Cache pp))) (do
        (set! p (addr (aget (.-Cache pp) (.-CacheIndex pp))))
        (inc! (.-CacheIndex pp)))

      (set! p (new obj/Prog)))

    (set! (.-Ctxt p) base/Ctxt)
    ^{:line 106} p))



^{:go/end 113} (go/method Flush "Flush converts from pp to machine code.\n" [^{:tag (* Progs)} pp]
  (let [plist (addr (lit obj/Plist :Firstpc (.-Text pp) :Curfn (.-CurFunc pp)))]
    (obj/Flushplist base/Ctxt plist (.-NewProg pp))))



^{:go/end 123} (go/method Free "Free clears pp and any associated resources.\n" [^{:tag (* Progs)} pp]
  (when (.CanReuseProgs base/Ctxt)
    ;; Clear progs to enable GC and avoid abuse.
    (clear (subslice (.-Cache pp) _ (.-CacheIndex pp))))

  ;; Clear pp to avoid abuse.
  (set! @pp (lit Progs)))



^{:go/end 166} (go/method Prog "Prog adds a Prog with instruction As to pp.\n" ^{:tag (* obj/Prog)} [^{:tag (* Progs)} pp ^obj/As as]
  (when (and (!= (.-NextLive pp) StackMapDontCare) (!= (.-NextLive pp) (.-PrevLive pp)))
    ;; Emit stack map index change.
    (let [idx (.-NextLive pp)]
      (set! (.-PrevLive pp) idx)
      (let [p (.Prog pp obj/APCDATA)]
        (.SetConst (.-From p) abi/PCDATA_StackMapIndex)
        (.SetConst (.-To p) (conv int64 idx)))))

  (when (!= (.-NextUnsafe pp) (.-PrevUnsafe pp))
    ;; Emit unsafe-point marker.
    (set! (.-PrevUnsafe pp) (.-NextUnsafe pp))
    (let [p (.Prog pp obj/APCDATA)]
      (.SetConst (.-From p) abi/PCDATA_UnsafePoint)
      (if (.-NextUnsafe pp)
        (.SetConst (.-To p) abi/UnsafePointUnsafe)

        (.SetConst (.-To p) abi/UnsafePointSafe))))



  (let [p (.-Next pp)]
    (set! (.-Next pp) (.NewProg pp))
    (.Clear pp (.-Next pp))
    (set! (.-Link p) (.-Next pp))

    (when (and (not (.IsKnown (.-Pos pp))) (!= (.-K base/Flag) 0))
      (base/Warn "prog: unknown position (line 0)"))


    (set! (.-As p) as)
    (set! (.-Pos p) (.-Pos pp))
    (when (== ^{:go/via [lico]} (.IsStmt (.-Pos pp)) src/PosIsStmt)
      ;; Clear IsStmt for later Progs at this pos provided that as can be marked as a stmt
      (when (LosesStmtMark as)
        (return p))

      (set! (.-Pos pp) (.WithNotStmt (.-Pos pp))))

    ^{:line 165} p))


^{:go/end 173} (go/method Clear [^{:tag (* Progs)} pp ^{:tag (* obj/Prog)} p]
  (obj/Nopout p)
  (set! (.-As p) obj/AEND)
  (set! (.-Pc p) (.-PC pp))
  (inc! (.-PC pp)))


^{:go/end 189} (go/method Append ^{:tag (* obj/Prog)} [^{:tag (* Progs)} pp ^{:tag (* obj/Prog)} p ^obj/As as ^obj/AddrType ftype ^int16 freg ^int64 foffset ^obj/AddrType ttype ^int16 treg ^int64 toffset]
  (let [q (.NewProg pp)]
    (.Clear pp q)
    (set! (.-As q) as)
    (set! (.-Pos q) (.-Pos p))
    (set! (.-Type (.-From q)) ftype)
    (set! (.-Reg (.-From q)) freg)
    (set! (.-Offset (.-From q)) foffset)
    (set! (.-Type (.-To q)) ttype)
    (set! (.-Reg (.-To q)) treg)
    (set! (.-Offset (.-To q)) toffset)
    (set! (.-Link q) (.-Link p))
    (set! (.-Link p) q)
    ^{:line 188} q))


^{:go/end 202} (go/method SetText [^{:tag (* Progs)} pp ^{:tag (* ir/Func)} fn]
  (when (!= (.-Text pp) nil)
    (base/Fatalf "Progs.SetText called twice"))

  (let [ptxt (.Prog pp obj/ATEXT)]
    (set! (.-Text pp) ptxt)

    (set! (.-Text (.Func (.-LSym fn))) ptxt)
    (set! (.-Type (.-From ptxt)) obj/TYPE_MEM)
    (set! (.-Name (.-From ptxt)) obj/NAME_EXTERN)
    (set! (.-Sym (.-From ptxt)) (.-LSym fn))))






^{:go/end 211} (go/func LosesStmtMark "LosesStmtMark reports whether a prog with op as loses its statement mark on the way to DWARF.\nThe attributes from some opcodes are lost in translation.\nTODO: this is an artifact of how funcpctab combines information for instructions at a single PC.\nShould try to fix it there.\n" ^bool [^obj/As as]
  ;; is_stmt does not work for these; it DOES for ANOP even though that generates no code.
  (or (== as obj/APCDATA) (== as obj/AFUNCDATA)))

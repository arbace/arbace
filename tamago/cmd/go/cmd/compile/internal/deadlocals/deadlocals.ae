;; The deadlocals pass removes assignments to unused local variables.
(in-ns 'go.cmd.compile.internal.deadlocals) (go/file "deadlocals.go" :doc "The deadlocals pass removes assignments to unused local variables.\n" :imports [


    ^{:line 9} [base "cmd/compile/internal/base"]
    ^{:line 10} [ir "cmd/compile/internal/ir"]
    ^{:line 11} [types "cmd/compile/internal/types"]
    ^{:line 12} [src "cmd/internal/src"]
    ^{:line 13} [fmt "fmt"]
    ^{:line 14} [constant "go/constant"]])



^{:go/end 61} (go/func Funcs "Funcs applies the deadlocals pass to fns.\n" [^{:tag (slice (* ir/Func))} fns]
  (when (or (!= (.-N base/Flag) 0) (!= (.-NoDeadLocals base/Debug) 0))
    (return))


  (let [zero (ir/NewBasicLit base/AutogeneratedPos (aget types/Types types/TINT) (constant/MakeInt64 0))]

    (range [_ fn fns]

      (when (.IsClosure fn)
        (when (ir/MatchAstDump fn "deadlocals closure")
          (ir/AstDump fn (+ "deadlocals closure skipped, " (ir/FuncName fn))))

        (continue))


      (let [v (newVisitor fn)]
        (.nodes v (.-Body fn))

        (range [_ k (.-defsKeys v)]
          (let [assigns (aget (.-defs v) k)]
            (range [_ as assigns]
              ;; Kludge for "missing func info" linker panic.
              ;; See also closureInitLSym in inline/inl.go.
              (when [(values clo ok) (assert (* ir/ClosureExpr) @(.-rhs as))] (and ok (== ^{:go/via [miniExpr miniNode]} (.Op clo) ir/OCLOSURE))
                (when (.IsClosure (.-Func clo))
                  (ir/InitLSym (.-Func clo) true)))



              (set! @(.-lhs as) ir/BlankNode)
              (set! @(.-rhs as) zero))

            (when (> (len assigns) 0)
              ;; k.Defn might be pointing at one of the
              ;; assignments we're overwriting.
              (set! (.-Defn k) nil))))


        (when (ir/MatchAstDump fn "deadlocals")
          (ir/AstDump fn (+ "deadLocals, " (ir/FuncName fn))))))))




(go/type visitor (struct
    ^{:line 64 :tag (* ir/Func)} curfn


    ^{:line 67 :tag (map (* ir/Name) (slice assign)) :doc "defs[name] contains assignments that can be discarded if name can be discarded.\nif defs[name] is defined nil, then name is actually used.\n"} defs
    ^{:line 68 :tag (slice (* ir/Name))} defsKeys ; insertion order of keys, for reproducible iteration (and builds)

    ^{:line 70 :tag (func [ir/Node] [bool])} doNode))


(go/type assign (struct
    ^{:line 74 :tag src/XPos} pos
    ^{:line 75 :tag (* ir/Node)} lhs ^{:tag (* ir/Node)} rhs))


^{:go/end 88} (go/func newVisitor ^{:tag (* visitor)} [^{:tag (* ir/Func)} fn]
  (let [v (addr ^{:go/breaks [2 4]} (lit visitor
          :curfn fn
          :defs (make (map (* ir/Name) (slice assign)))))]

    (set! (.-doNode v) ^{:go/breaks [3] :go/end 86} (fn ^bool [^ir/Node n]
        (.node v n)
        false))

    ^{:line 87} v))


^{:go/end 144} (go/method node [^{:tag (* visitor)} v ^ir/Node n]
  (when (== n nil)
    (return))


  (switch (.Op n)
    (default
      (ir/DoChildrenWithHidden n (.-doNode v)))
    (case [ir/OCLOSURE]
      (let [n (assert (* ir/ClosureExpr) n)]
        (.nodes v ^{:go/via [miniExpr]} (.Init n))
        (range [_ cv (.-ClosureVars (.-Func n))]
          (.node v cv))

        (.nodes v (.-Body (.-Func n)))))

    (case [ir/ODCL])
    ;; ignore
    (case [ir/ONAME]
      (let [n (assert (* ir/Name) n)]
        (set! n (.Canonical n))
        (when (isLocal n false)
          ;; Force any lazy definitions.
          (let [(values s ok) (aget (.-defs v) n)]
            (when (not ok)
              (set! (.-defsKeys v) (append (.-defsKeys v) n)))

            (aset (.-defs v) n nil)
            (range [_ as s]
              ;; do the visit that was skipped in v.assign when as was appended to v.defs[n]
              (.node v @(.-rhs as)))))))



    (case [ir/OAS]
      (let [n (assert (* ir/AssignStmt) n)]
        (.assign v ^{:go/via [miniStmt miniNode]} (.Pos n) (addr (.-X n)) (addr (.-Y n)) false)))
    (case [ir/OAS2]
      (let [n (assert (* ir/AssignListStmt) n)

          ;; If all LHS vars are blank, treat them as intentional
          ;; uses of corresponding RHS vars.  If any are non-blank
          ;; then any blanks are discards.
          ^{:line 133} hasNonBlank false]
        (range [i (.-Lhs n)]
          (when (not (ir/IsBlank (aget (.-Lhs n) i)))
            (set! hasNonBlank true)
            (break)))


        (range [i (.-Lhs n)]
          (.assign v ^{:go/via [miniStmt miniNode]} (.Pos n) (addr (aget (.-Lhs n) i)) (addr (aget (.-Rhs n) i)) hasNonBlank))))))




^{:go/end 150} (go/method nodes [^{:tag (* visitor)} v ^ir/Nodes list]
  (range [_ n list]
    (.node v n)))



^{:go/breaks [[6 165]] :go/end 166} (go/func hasEffects ^bool [^ir/Node n]
  (when (== n nil)
    (return false))

  (when (!= (len (.Init n)) 0)
    (return true))


  (switch (.Op n)
    ;; TODO(mdempsky): More.
    (case [ir/ONAME ir/OLITERAL ir/ONIL ir/OCLOSURE]
      (return false)))

  true)


^{:go/end 189} (go/method assign [^{:tag (* visitor)} v ^src/XPos pos ^{:tag (* ir/Node)} lhs ^{:tag (* ir/Node)} rhs ^bool blankIsNotUse]
  (let [(values name ok) (assert (* ir/Name) @lhs)]
    (when (not ok)
      (.node v @lhs) ; XXX: Interpret as variable, not value.
      (.node v @rhs)
      (return))

    (set! name (.Canonical name))

    (when (and (isLocal name blankIsNotUse) (not (hasEffects @rhs)))
      (when [(values s ok) (aget (.-defs v) name)] (or (not ok) (!= s nil))
        ;; !ok || s != nil is FALSE if previously "v.defs[name] = nil" -- that marks a use.
        (when (not ok)
          (set! (.-defsKeys v) (append (.-defsKeys v) name)))

        (aset (.-defs v) name (append s (lit assign pos lhs rhs)))
        (return))) ; don't visit rhs unless that node ends up live, later.



    (.node v @rhs)))


^{:go/end 206} (go/func isLocal ^bool [^{:tag (* ir/Name)} n ^bool blankIsNotUse]
  (when (ir/IsBlank n)
    ;; Treat single assignments as intentional use (false), anything else is a discard (true).
    (return blankIsNotUse))


  (switch (.-Class n)
    (case [ir/PAUTO ir/PPARAM]
      (return true))
    (case [ir/PPARAMOUT]
      (return false))
    (case [ir/PEXTERN ir/PFUNC]
      (return false)))

  (panic (fmt/Sprintf "unexpected Class: %+v" n)))

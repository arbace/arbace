(in-ns 'go.cmd.compile.internal.pkginit) (go/file "init.go" :imports [


    ^{:line 8} [base "cmd/compile/internal/base"]
    ^{:line 9} [ir "cmd/compile/internal/ir"]
    ^{:line 10} [noder "cmd/compile/internal/noder"]
    ^{:line 11} [objw "cmd/compile/internal/objw"]
    ^{:line 12} [staticinit "cmd/compile/internal/staticinit"]
    ^{:line 13} [typecheck "cmd/compile/internal/typecheck"]
    ^{:line 14} [types "cmd/compile/internal/types"]
    ^{:line 15} [obj "cmd/internal/obj"]
    ^{:line 16} [objabi "cmd/internal/objabi"]
    ^{:line 17} [src "cmd/internal/src"]])








^{:go/end 146} (go/func MakeTask "MakeTask makes an initialization record for the package, if necessary.\nSee runtime/proc.go:initTask for its layout.\nThe 3 tasks for initialization are:\n 1. Initialize all of the packages the current package depends on.\n 2. Initialize all the variables that have initializers.\n 3. Run any init functions.\n" []
  (let [^{:tag (slice (* obj/LSym))} deps (zero (slice (* obj/LSym))) ; initTask records for packages the current package depends on
      ^{:line 28 :tag (slice (* obj/LSym))} fns (zero (slice (* obj/LSym)))] ; functions to call for package initialization

    ;; Find imported packages with init tasks.
    (range [_ pkg (.-Imports typecheck/Target)]
      (let [(values n ok) (assert (* ir/Name) (.-Def (.Lookup pkg ".inittask")))]
        (when (not ok)
          (continue))

        (when (or (!= ^{:go/via [miniExpr miniNode]} (.Op n) ir/ONAME) (!= (.-Class n) ir/PEXTERN))
          (base/Fatalf "bad inittask: %v" n))

        (set! deps (append deps (.Linksym n)))))

    (when (.-ASan base/Flag)
      ;; Make an initialization function to call runtime.asanregisterglobals to register an
      ;; array of instrumented global variables when -asan is enabled. An instrumented global
      ;; variable is described by a structure.
      ;; See the _asan_global structure declared in src/runtime/asan/asan.go.
      ;;
      ;; func init {
      ;; 		var globals []_asan_global {...}
      ;; 		asanregisterglobals(&globals[0], len(globals))
      ;; }
      (range [_ n (.-Externs typecheck/Target)]
        (when (canInstrumentGlobal n)
          (let [name (.-Name (.Sym n))]
            (aset InstrumentGlobalsMap name n)
            (set! InstrumentGlobalsSlice (append InstrumentGlobalsSlice n)))))


      (let [ni (len InstrumentGlobalsMap)]
        (when (!= ni 0)
          ;; Make an init._ function.
          (let [pos base/AutogeneratedPos]
            (set! base/Pos pos)

            (let [sym (noder/Renameinit)
                ^{:line 65} fnInit (ir/NewFunc pos pos sym (types/NewSignature nil nil nil))]
              (typecheck/DeclFunc fnInit)

              ;; Get an array of instrumented global variables.
              (let [globals (instrumentGlobals fnInit)

                  ;; Call runtime.asanregisterglobals function to poison redzones.
                  ;; runtime.asanregisterglobals(unsafe.Pointer(&globals[0]), ni)
                  ^{:line 73} asancall (ir/NewCallExpr base/Pos ir/OCALL (typecheck/LookupRuntime "asanregisterglobals") nil)]
                (.Append (.-Args asancall) (typecheck/ConvNop (typecheck/NodAddr
                      (ir/NewIndexExpr base/Pos globals (ir/NewInt base/Pos 0))) (aget types/Types types/TUNSAFEPTR)))
                (.Append (.-Args asancall) (typecheck/DefaultLit (ir/NewInt base/Pos (conv int64 ni)) (aget types/Types types/TUINTPTR)))

                (.Append (.-Body fnInit) asancall)
                (typecheck/FinishFuncBody)
                (set! ir/CurFunc fnInit)
                (typecheck/Stmts (.-Body fnInit))
                (set! ir/CurFunc nil)

                (set! (.-Inits typecheck/Target) (append (.-Inits typecheck/Target) fnInit))))))))



    ;; Record user init functions.
    (range [_ fn (.-Inits typecheck/Target)]
      (when (== (.-Name (.Sym fn)) "init")
        ;; Synthetic init function for initialization of package-scope
        ;; variables. We can use staticinit to optimize away static
        ;; assignments.
        (let [s ^{:go/breaks [2 4]} (lit staticinit/Schedule
              :Plans (make (map ir/Node (* staticinit/Plan)))
              :Temps (make (map ir/Node (* ir/Name))))]

          (range [_ n (.-Body fn)]
            (.StaticInit s n))

          (set! (.-Body fn) (.-Out s))
          (ir/WithFunc fn ^{:go/end 104} (fn []
              (typecheck/Stmts (.-Body fn))))


          (when (== (len (.-Body fn)) 0)
            (set! (.-Body fn) (lit (slice ir/Node) (ir/NewBlockStmt src/NoXPos nil))))))



      ;; Skip init functions with empty bodies.
      (when (== (len (.-Body fn)) 1)
        (when [stmt (aget (.-Body fn) 0)] (and (== (.Op stmt) ir/OBLOCK) (== (len (.-List (assert (* ir/BlockStmt) stmt))) 0))
          (continue)))


      (set! fns (append fns (.Linksym (.-Nname fn)))))


    (when (and (== (len deps) 0) (== (len fns) 0) (!= (.-Path types/LocalPkg) "main") (!= (.-Path types/LocalPkg) "runtime"))
      (return)) ; nothing to initialize


    ;; Make an .inittask structure.
    (let [sym (typecheck/Lookup ".inittask")
        ^{:line 126} task (ir/NewNameAt base/Pos sym (aget types/Types types/TUINT8))] ; fake type
      (set! (.-Class task) ir/PEXTERN)
      (set! (.-Def sym) task)
      (let [lsym (.Linksym task)
          ^{:line 130} ot 0]
        (set! ot (objw/Uint32 lsym ot 0)) ; state: not initialized yet
        (set! ot (objw/Uint32 lsym ot (conv uint32 (len fns))))
        (range [_ f fns]
          (set! ot (objw/SymPtr lsym ot f 0)))


        ;; Add relocations which tell the linker all of the packages
        ;; that this package depends on (and thus, all of the packages
        ;; that need to be initialized before this one).
        (range [_ d deps]
          (.AddRel lsym base/Ctxt (lit obj/Reloc :Type objabi/R_INITORDER :Sym d)))

        ;; An initTask has pointers, but none into the Go heap.
        ;; It's not quite read only, the state field must be modifiable.
        (objw/Global lsym (conv int32 ot) obj/NOPTR)))))

^{:go/end 24} (go/func isFPreg "isFPreg reports whether r is an FP register.\n" ^bool [^int16 r]
  (and (<= mips/REG_F0 r) (<= r mips/REG_F31)))



^{:go/end 29} (go/func isHILO "isHILO reports whether r is HI or LO register.\n" ^bool [^int16 r]
  (or (== r mips/REG_HI) (== r mips/REG_LO)))



^{:go/end 58} (go/func loadByType "loadByType returns the load instruction of the given type.\n" ^obj/As [^{:tag (* types/Type)} t ^int16 r]
  (if (isFPreg r)
    (if (== (.Size t) 4) ; float32 or int32
      (return mips/AMOVF)
      ;; float64 or int64
      (return mips/AMOVD))


    (switch (.Size t)
      (case [1]
        (if (.IsSigned t)
          (return mips/AMOVB)

          (return mips/AMOVBU)))

      (case [2]
        (if (.IsSigned t)
          (return mips/AMOVH)

          (return mips/AMOVHU)))

      (case [4]
        (return mips/AMOVW))))


  (panic "bad load type"))



^{:go/end 79} (go/func storeByType "storeByType returns the store instruction of the given type.\n" ^obj/As [^{:tag (* types/Type)} t ^int16 r]
  (if (isFPreg r)
    (if (== (.Size t) 4) ; float32 or int32
      (return mips/AMOVF)
      ;; float64 or int64
      (return mips/AMOVD))


    (switch (.Size t)
      (case [1]
        (return mips/AMOVB))
      (case [2]
        (return mips/AMOVH))
      (case [4]
        (return mips/AMOVW))))


  (panic "bad store type"))


^{:go/end 978} (go/func ssaGenValue [^{:tag (* ssagen/State)} s ^{:tag (* ssa/Value)} v]
  (switch (.-Op v)

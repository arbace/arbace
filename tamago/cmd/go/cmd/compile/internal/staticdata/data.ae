                ;; and then fix up length and content to use file.
                (set! symdata (slicedata pos ""))
                (set! (.-Size symdata) size)
                (set! (.-Type symdata) objabi/SNOPTRDATA)
                (let [info (.NewFileInfo symdata)]
                  (set! (.-Name info) file)
                  (set! (.-Size info) size))))


            (return symdata size nil)))))))



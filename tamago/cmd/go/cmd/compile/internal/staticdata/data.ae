^{:go/end 206} (go/func fileStringSym "fileStringSym returns a symbol for the contents and the size of file.\nIf readonly is true, the symbol shares storage with any literal string\nor other file with the same content and is placed in a read-only section.\nIf readonly is false, the symbol is a read-write copy separate from any other,\nfor use as the backing store of a []byte.\nThe content hash of file is copied into hashBytes. (If hash is nil, nothing is copied.)\nThe returned symbol contains the data itself, not a string header.\n" [^src/XPos pos ^string file ^bool readonly ^{:tag (slice byte)} hashBytes] :results [(* obj/LSym) int64 error]
  (let [(values f err) (os/Open file)]
    (when (!= err nil)
      (return nil 0 err))

    (defer (.Close f))
    (let [(values info ^:assign err) (.Stat f)]
      (when (!= err nil)
        (return nil 0 err))

      (when (not (.IsRegular (.Mode info)))
        (return nil 0 (fmt/Errorf "not a regular file")))

      (let [size (.Size info)]
        (when (<= size (* 1 1024))
          (let [(values data err) (io/ReadAll f)]
            (when (!= err nil)
              (return nil 0 err))

            (when (!= (conv int64 (len data)) size)
              (return nil 0 (fmt/Errorf "file changed between reads")))

            (let [^{:tag (* obj/LSym)} sym (zero (* obj/LSym))]
              (if readonly
                (set! sym (StringSym pos (conv string data)))

                (set! sym (slicedata pos (conv string data))))

              (when (> (len hashBytes) 0)
                (let [sum (hash/Sum32 data)]
                  (copy hashBytes (subslice sum))))

              (return sym size nil))))

        (when (> size maxFileSize)
          ;; ggloblsym takes an int32,
          ;; and probably the rest of the toolchain
          ;; can't handle such big symbols either.
          ;; See golang.org/issue/9862.
          (return nil 0 (fmt/Errorf "file too large (%d bytes > %d bytes)" size maxFileSize)))


        ;; File is too big to read and keep in memory.
        ;; Compute hashBytes if needed for read-only content hashing or if the caller wants it.
        (let [^{:tag (slice byte)} sum (zero (slice byte))]
          (when (or readonly (> (len hashBytes) 0))
            (let [h (hash/New32)
                (values n err) (io/Copy h f)]
              (when (!= err nil)
                (return nil 0 err))

              (when (!= n size)
                (return nil 0 (fmt/Errorf "file changed between reads")))

              (set! sum (.Sum h nil))
              (copy hashBytes sum)))


          (let [^{:tag (* obj/LSym)} symdata (zero (* obj/LSym))]
            (if readonly
              (let [symname (fmt/Sprintf stringSymPattern size (shortHashString sum))]
                (set! symdata (.Lookup base/Ctxt (+ stringSymPrefix symname)))
                (when (not ^{:go/via [Attribute]} (.OnList symdata))
                  (let [info (.NewFileInfo symdata)]
                    (set! (.-Name info) file)
                    (set! (.-Size info) size)
                    (objw/Global symdata (conv int32 size) (bit-or obj/DUPOK obj/RODATA obj/LOCAL))
                    (set! (.-Align symdata) 1))))
              ;; Note: AttrContentAddressable cannot be set here,
              ;; because the content-addressable-handling code
              ;; does not know about file symbols.


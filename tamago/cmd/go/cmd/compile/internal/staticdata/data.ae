  ^{:line 236} [^{:tag (slice (* ir/Name))} funcsyms]) ; functions that need function value symbols



^{:go/end 261} (go/func FuncLinksym "FuncLinksym returns n·f, the function value symbol for n.\n" ^{:tag (* obj/LSym)} [^{:tag (* ir/Name)} n]
  (when (or (!= ^{:go/via [miniExpr miniNode]} (.Op n) ir/ONAME) (!= (.-Class n) ir/PFUNC))
    (base/Fatalf "expected func name: %v" n))

  (let [s (.Sym n)]

    ;; funcsymsmu here serves to protect not just mutations of funcsyms (below),
    ;; but also the package lookup of the func sym name,
    ;; since this function gets called concurrently from the backend.
    ;; There are no other concurrent package lookups in the backend,
    ;; except for the types package, which is protected separately.
    ;; Reusing funcsymsmu to also cover this package lookup
    ;; avoids a general, broader, expensive package lookup mutex.
    (.Lock funcsymsmu)
    (let [(values sf existed) (.LookupOK (.-Pkg s) (ir/FuncSymName s))]
      (when (not existed)
        (set! funcsyms (append funcsyms n)))

      (.Unlock funcsymsmu)

      (.Linksym sf))))


^{:go/end 268} (go/func GlobalLinksym ^{:tag (* obj/LSym)} [^{:tag (* ir/Name)} n]

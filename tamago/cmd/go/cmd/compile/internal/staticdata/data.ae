^{:go/end 232} (go/func dstringdata ^int [^{:tag (* obj/LSym)} s ^int off ^string t ^src/XPos pos ^string what]
  ;; Objects that are too large will cause the data section to overflow right away,
  ;; causing a cryptic error message by the linker. Check for oversize objects here
  ;; and provide a useful error message instead.
  (when (> (conv int64 (len t)) 2.0E9)
    (base/ErrorfAt pos 0 "%v with length %v is too big" what (len t))
    (return 0))


  (.WriteString s base/Ctxt (conv int64 off) (len t) t)
  (+ off (len t)))



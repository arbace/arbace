^{:go/end 99} (go/func StringSym "StringSym returns a symbol containing the string s.\nThe symbol contains the string data, not a string header.\n" [^src/XPos pos ^string s] :results [^{:tag (* obj/LSym)} data]
  (let [^string symname (zero string)]
    (if (> (len s) 100)
      ;; Huge strings are hashed to avoid long names in object files.
      ;; Indulge in some paranoia by writing the length of s, too,
      ;; as protection against length extension attacks.
      ;; Same pattern is known to fileStringSym below.
      (let [h (hash/New32)]
        (io/WriteString h s)
        (set! symname (fmt/Sprintf stringSymPattern (len s) (shortHashString (.Sum h nil)))))

      ;; Small strings get named directly by their contents.
      (set! symname (strconv/Quote s)))


    (let [symdata (.Lookup base/Ctxt (+ stringSymPrefix symname))]
      (when (not ^{:go/via [Attribute]} (.OnList symdata))
        (let [off (dstringdata symdata 0 s pos "string")]
          (objw/Global symdata (conv int32 off) (bit-or obj/DUPOK obj/RODATA obj/LOCAL))
          ^{:go/via [Attribute]} (.Set symdata obj/AttrContentAddressable true)
          (set! (.-Align symdata) 1)))


      ^{:line 98} symdata)))






    (base/Fatalf "InitAddr n op %v" ^{:go/via [miniExpr miniNode]} (.Op n)))

  (when (== (.Sym n) nil)
    (base/Fatalf "InitAddr nil n sym"))

  (let [s (.Linksym n)]
    (.WriteAddr s base/Ctxt noff types/PtrSize lsym off)))




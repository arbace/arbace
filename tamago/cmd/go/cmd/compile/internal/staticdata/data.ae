^{:go/end 350} (go/func InitConst "InitConst writes the static literal c to n.\nNeither n nor c is modified.\n" [^{:tag (* ir/Name)} n ^int64 noff ^ir/Node c ^int wid]
  (when (!= ^{:go/via [miniExpr miniNode]} (.Op n) ir/ONAME)
    (base/Fatalf "InitConst n op %v" ^{:go/via [miniExpr miniNode]} (.Op n)))

  (when (== (.Sym n) nil)
    (base/Fatalf "InitConst nil n sym"))

  (when (== (.Op c) ir/ONIL)
    (return))

  (when (!= (.Op c) ir/OLITERAL)
    (base/Fatalf "InitConst c op %v" (.Op c)))

  (let [s (.Linksym n)]
    (switch [u (.Val c)] (.Kind u)
      (case [constant/Bool]
        (let [i (conv int64 (obj/Bool2int (constant/BoolVal u)))]
          (.WriteInt s base/Ctxt noff wid i)))

      (case [constant/Int]
        (.WriteInt s base/Ctxt noff wid (ir/IntVal (.Type c) u)))

      (case [constant/Float]
        (let [(values f _) (constant/Float64Val u)]
          (switch (.Kind (.Type c))
            (case [types/TFLOAT32]
              (.WriteFloat32 s base/Ctxt noff (conv float32 f)))
            (case [types/TFLOAT64]
              (.WriteFloat64 s base/Ctxt noff f)))))


      (case [constant/Complex]
        (let [(values re _) (constant/Float64Val (constant/Real u))
            (values im _) (constant/Float64Val (constant/Imag u))]
          (switch (.Kind (.Type c))
            (case [types/TCOMPLEX64]
              (.WriteFloat32 s base/Ctxt noff (conv float32 re))
              (.WriteFloat32 s base/Ctxt (+ noff 4) (conv float32 im)))
            (case [types/TCOMPLEX128]
              (.WriteFloat64 s base/Ctxt noff re)
              (.WriteFloat64 s base/Ctxt (+ noff 8) im)))))


      (case [constant/String]
        (let [i (constant/StringVal u)
            ^{:line 343} symdata (StringSym ^{:go/via [miniExpr miniNode]} (.Pos n) i)]
          (.WriteAddr s base/Ctxt noff types/PtrSize symdata 0)
          (.WriteInt s base/Ctxt (+ noff (conv int64 types/PtrSize)) types/PtrSize (conv int64 (len i)))))

      (default
        (base/Fatalf "InitConst unhandled OLITERAL %v" c)))))

                      (set! off (objw/Uintptr slicedata off (conv uint64 size)))
                      (set! off (conv int (.WriteBytes slicedata base/Ctxt (conv int64 off) hash))))))


                (objw/Global slicedata (conv int32 off) (bit-or obj/RODATA obj/LOCAL))
                (let [sym (.Linksym v)]

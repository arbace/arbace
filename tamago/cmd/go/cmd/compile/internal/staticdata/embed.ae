                (set! off (objw/SymPtr sym off fsym 0)) ; data string
                (set! off (objw/Uintptr sym off (conv uint64 size))) ; len
                (when (== kind embedBytes)
                  (objw/Uintptr sym off (conv uint64 size)))))) ; cap for slice


          (case [embedFiles]
            (let [slicedata (.Linksym (.Lookup (.-Pkg (.Sym v)) (+ (.-Name (.Sym v)) ".files")))
                ^{:line 136} off 0]
              ;; []files pointed at by Files
              (set! off (objw/SymPtr slicedata off slicedata (* 3 types/PtrSize))) ; []file, pointing just past slice
              (set! off (objw/Uintptr slicedata off (conv uint64 (len files))))
              (set! off (objw/Uintptr slicedata off (conv uint64 (len files))))

              ;; embed/embed.go type file is:
              ;;	name string
              ;;	data string
              ;;	hash [16]byte
              ;; Emit one of these per file in the set.
              (let [^:const ^{:val 16} hashSize 16
                  ^{:line 148} hash (make (slice byte) hashSize)]
                (range [_ file files]
                  (set! off (objw/SymPtr slicedata off (StringSym ^{:go/via [miniExpr miniNode]} (.Pos v) file) 0)) ; file string
                  (set! off (objw/Uintptr slicedata off (conv uint64 (len file))))
                  (if (strings/HasSuffix file "/") (do
                      ;; entry for directory - no data
                      (set! off (objw/Uintptr slicedata off 0))
                      (set! off (objw/Uintptr slicedata off 0))
                      (set! off + hashSize))

                    (let [(values fsym size err) (fileStringSym ^{:go/via [miniExpr miniNode]} (.Pos v) (aget (.-Files (.-Embed (.-Cfg base/Flag))) file) true hash)]
                      (when (!= err nil)

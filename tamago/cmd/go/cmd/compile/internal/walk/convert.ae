^{:go/end 559} (go/func walkSliceToArray "walkSliceToArray walks an OSLICE2ARR expression.\n" ^ir/Node [^{:tag (* ir/ConvExpr)} n ^{:tag (* ir/Nodes)} init]
  ;; Replace T(x) with *(*T)(x).
  (let [conv (assert (* ir/ConvExpr) (typecheck/Expr (ir/NewConvExpr base/Pos ir/OCONV (types/NewPtr ^{:go/via [miniExpr]} (.Type n)) (.-X n))))

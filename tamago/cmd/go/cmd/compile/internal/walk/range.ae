          ;; hn = len(a) * sizeof(elem(a))
          (let [hn (typecheck/TempAt base/Pos ir/CurFunc (aget types/Types types/TUINTPTR))
              ^{:line 586} mul (typecheck/Conv (ir/NewBinaryExpr base/Pos ir/OMUL ln (ir/NewInt base/Pos elemsize)) (aget types/Types types/TUINTPTR))]
            (.Append (.-Body n) (ir/NewAssignStmt base/Pos hn mul))

            (let [^ir/Node fn (zero ir/Node)]
              (if (.HasPointers (.Elem (.Type a))) (do
                  ;; memclrHasPointers(hp, hn)
                  (.SetWBPos ir/CurFunc wbPos)
                  (set! fn (mkcallstmt "memclrHasPointers" hp hn)))

                ;; memclrNoHeapPointers(hp, hn)
                (set! fn (mkcallstmt "memclrNoHeapPointers" hp hn)))


              (.Append (.-Body n) fn)

              ;; For array range clear, also set "i = len(a) - 1"
              (when (!= nrange nil)
                (let [idx (ir/NewAssignStmt base/Pos (.-Key nrange) (typecheck/Conv (ir/NewBinaryExpr base/Pos ir/OSUB ln (ir/NewInt base/Pos 1)) (.Type (.-Key nrange))))]
                  (.Append (.-Body n) idx)))


              (set! (.-Cond n) (typecheck/Expr (.-Cond n)))
              (set! (.-Cond n) (typecheck/DefaultLit (.-Cond n) nil))
              (typecheck/Stmts (.-Body n))
              (walkStmt n))))))))

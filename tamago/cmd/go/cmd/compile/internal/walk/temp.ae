(in-ns 'go.cmd.compile.internal.walk) (go/file "temp.go" :imports [


    ^{:line 8} [base "cmd/compile/internal/base"]
    ^{:line 9} [ir "cmd/compile/internal/ir"]
    ^{:line 10} [typecheck "cmd/compile/internal/typecheck"]
    ^{:line 11} [types "cmd/compile/internal/types"]])




^{:go/end 22} (go/func initStackTemp "initStackTemp appends statements to init to initialize the given\ntemporary variable to val, and then returns the expression &tmp.\n" ^{:tag (* ir/AddrExpr)} [^{:tag (* ir/Nodes)} init ^{:tag (* ir/Name)} tmp ^ir/Node val]
  (when (and (!= val nil) (not (types/Identical ^{:go/via [miniExpr]} (.Type tmp) (.Type val))))
    (base/Fatalf "bad initial value for %L: %L" tmp val))

  (appendWalkStmt init (ir/NewAssignStmt base/Pos tmp val))
  (assert (* ir/AddrExpr) (typecheck/Expr (typecheck/NodAddr tmp))))





^{:go/end 31} (go/func stackTempAddr "stackTempAddr returns the expression &tmp, where tmp is a newly\nallocated temporary variable of the given type. Statements to\nzero-initialize tmp are appended to init.\n" ^{:tag (* ir/AddrExpr)} [^{:tag (* ir/Nodes)} init ^{:tag (* types/Type)} typ]
  (let [n (typecheck/TempAt base/Pos ir/CurFunc typ)]
    (.SetNonMergeable n true)
    (initStackTemp init n nil)))





^{:go/end 42} (go/func stackBufAddr "stackBufAddr returns the expression &tmp, where tmp is a newly\nallocated temporary variable of type [len]elem. This variable is\ninitialized, and elem must not contain pointers.\n" ^{:tag (* ir/AddrExpr)} [^int64 len ^{:tag (* types/Type)} elem]
  (when (.HasPointers elem)
    (base/FatalfAt base/Pos "%v has pointers" elem))

  (let [tmp (typecheck/TempAt base/Pos ir/CurFunc (types/NewArray elem len))]
    (assert (* ir/AddrExpr) (typecheck/Expr (typecheck/NodAddr tmp)))))

^{:go/end 53} (go/func Walk [^{:tag (* ir/Func)} fn]
  (set! ir/CurFunc fn)

  ;; Build pre-walk analysis caches with a single AST traversal.
  ;; (At some point, it might be worthwhile to have a walkState structure
  ;; that gets passed everywhere where things like this can go.)
  (analyzePreWalk fn)
  (defer (^{:go/end 30} (fn [] (set! staticValues nil) (set! shapeConvSources nil))))

  (let [errorsBefore (base/Errors)]
    (order fn)
    (when (> (base/Errors) errorsBefore)
      (return))


    (when (!= (.-W base/Flag) 0)
      (let [s (fmt/Sprintf "\nbefore walk %v" (.Sym ir/CurFunc))]
        (ir/DumpList s (.-Body ir/CurFunc))))


    (walkStmtList (.-Body ir/CurFunc))
    (when (!= (.-W base/Flag) 0)
      (let [s (fmt/Sprintf "after walk %v" (.Sym ir/CurFunc))]
        (ir/DumpList s (.-Body ir/CurFunc))))


    ;; Eagerly compute sizes of all variables for SSA.
    (range [_ n (.-Dcl fn)]
      (types/CalcSize ^{:go/via [miniExpr]} (.Type n)))))




^{:go/end 65} (go/func walkRecv "walkRecv walks an ORECV node.\n" ^ir/Node [^{:tag (* ir/UnaryExpr)} n]
  (when (== ^{:go/via [miniExpr miniNode]} (.Typecheck n) 0)
    (base/Fatalf "missing typecheck: %+v" n))

  (let [init (ir/TakeInit n)]

    (set! (.-X n) (walkExpr (.-X n) (addr init)))
    (let [call (walkExpr (mkcall1 (chanfn "chanrecv1" 2 (.Type (.-X n))) nil (addr init) (.-X n) (typecheck/NodNil)) (addr init))]
      (ir/InitExpr init call))))



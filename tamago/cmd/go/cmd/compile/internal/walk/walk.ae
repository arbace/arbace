    (set! ptr (ir/NewUnaryExpr base/Pos ir/OSPTR n))
    (if (.IsString (.Type n))
      (.SetType ptr (.PtrTo (aget types/Types types/TUINT8)))

      (.SetType ptr (.PtrTo (.Elem (.Type n)))))

    (.SetTypecheck ptr 1)
    (set! length (ir/NewUnaryExpr base/Pos ir/OLEN n))
    (.SetType length (aget types/Types types/TINT))
    (.SetTypecheck length 1)

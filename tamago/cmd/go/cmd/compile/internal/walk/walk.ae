^{:go/end 382} (go/func mayCall "mayCall reports whether evaluating expression n may require\nfunction calls, which could clobber function call arguments/results\ncurrently on the stack.\n" ^bool [^ir/Node n]
  ;; This is intended to avoid putting constants
  ;; into temporaries with the race detector (or other
  ;; instrumentation) which interferes with simple
  ;; "this is a constant" tests in ssagen.
  ;; Also, it will generally lead to better code.
  (when (== (.Op n) ir/OLITERAL)
    (return false))


  ;; When instrumenting, any expression might require function calls.
  (when (.-Instrumenting (.-Cfg base/Flag))
    (return true))


  (let [isSoftFloat ^{:go/end 322} (fn ^bool [^{:tag (* types/Type)} typ]
        (or (aget types/IsFloat (.Kind typ)) (aget types/IsComplex (.Kind typ))))]


    (ir/Any n ^{:go/breaks [[4 380]] :go/end 381} (fn ^bool [^ir/Node n]
        ;; walk should have already moved any Init blocks off of
        ;; expressions.
        (when (!= (len (.Init n)) 0)
          (base/FatalfAt (.Pos n) "mayCall %+v" n))


        (switch (.Op n)
          (default
            (base/FatalfAt (.Pos n) "mayCall %+v" n))

          (case [ir/OCALLFUNC ir/OCALLINTER
              ^{:line 336} ir/OUNSAFEADD ir/OUNSAFESLICE]
            (return true))

          (case [ir/OINDEX ir/OSLICE ir/OSLICEARR ir/OSLICE3 ir/OSLICE3ARR ir/OSLICESTR
              ^{:line 340} ir/ODEREF ir/ODOTPTR ir/ODOTTYPE ir/ODYNAMICDOTTYPE ir/ODIV ir/OMOD
              ^{:line 341} ir/OSLICE2ARR ir/OSLICE2ARRPTR]
            ;; These ops might panic, make sure they are done
            ;; before we start marshaling args for a call. See issue 16760.
            (return true))

          (case [ir/OANDAND ir/OOROR]
            (let [n (assert (* ir/LogicalExpr) n)]
              ;; The RHS expression may have init statements that
              ;; should only execute conditionally, and so cannot be
              ;; pulled out to the top-level init list. We could try
              ;; to be more precise here.
              (return (!= (len (.Init (.-Y n))) 0))))

          ;; When using soft-float, these ops might be rewritten to function calls
          ;; so we ensure they are evaluated first.
          (case [ir/OADD ir/OSUB ir/OMUL ir/ONEG]
            (return (and (.-SoftFloat ssagen/Arch) (isSoftFloat (.Type n)))))
          (case [ir/OLT ir/OEQ ir/ONE ir/OLE ir/OGE ir/OGT]
            (let [n (assert (* ir/BinaryExpr) n)]
              (return (and (.-SoftFloat ssagen/Arch) (isSoftFloat (.Type (.-X n)))))))
          (case [ir/OCONV]
            (let [n (assert (* ir/ConvExpr) n)]
              (return (and (.-SoftFloat ssagen/Arch) ^:go/paren (or (isSoftFloat ^{:go/via [miniExpr]} (.Type n)) (isSoftFloat (.Type (.-X n))))))))

          (case [ir/OMIN ir/OMAX]

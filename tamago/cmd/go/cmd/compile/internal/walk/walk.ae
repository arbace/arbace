  (when (!= ^{:go/via [miniStmt miniNode]} (.Op n) ir/OAS)
    (base/Fatalf "convas: not OAS %v" ^{:go/via [miniStmt miniNode]} (.Op n)))

  ^{:go/via [miniStmt miniNode]} (.SetTypecheck n 1)

  (when (or (== (.-X n) nil) (== (.-Y n) nil))
    (return n))


  (let [lt (.Type (.-X n))
      ^{:line 78} rt (.Type (.-Y n))]
    (when (or (== lt nil) (== rt nil))
      (return n))


    (when (ir/IsBlank (.-X n))
      (set! (.-Y n) (typecheck/DefaultLit (.-Y n) nil))
      (return n))


    (when (not (types/Identical lt rt))
      (set! (.-Y n) (typecheck/AssignConv (.-Y n) lt "assignment"))

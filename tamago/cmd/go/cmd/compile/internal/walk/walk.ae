^{:go/end 300} (go/func backingArrayPtrLen "backingArrayPtrLen extracts the pointer and length from a slice or string.\nThis constructs two nodes referring to n, so n must be a cheapExpr.\n" [^ir/Node n] :results [^ir/Node ptr ^ir/Node length]
  (let [^ir/Nodes init (zero ir/Nodes)
      ^{:line 285} c (cheapExpr n (addr init))]

            (return (or (.IsString (.Type n)) (.IsFloat (.Type n)))))

          (case [ir/OLITERAL ir/ONIL ir/ONAME ir/OLINKSYMOFFSET ir/OMETHEXPR
              ^{:line 370} ir/OAND ir/OANDNOT ir/OLSH ir/OOR ir/ORSH ir/OXOR ir/OCOMPLEX ir/OMAKEFACE
              ^{:line 371} ir/OADDR ir/OBITNOT ir/ONOT ir/OPLUS
              ^{:line 372} ir/OCAP ir/OIMAG ir/OLEN ir/OREAL
              ^{:line 373} ir/OCONVNOP ir/ODOT
              ^{:line 374} ir/OCFUNC ir/OIDATA ir/OITAB ir/OSPTR
              ^{:line 375} ir/OBYTES2STRTMP ir/OGETG ir/OGETCALLERSP ir/OSLICEHEADER ir/OSTRINGHEADER]))
        ;; ok: operations that don't require function calls.

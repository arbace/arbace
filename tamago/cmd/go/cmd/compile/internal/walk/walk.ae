^{:go/end 218} (go/func mapfast ^int [^{:tag (* types/Type)} t]
  (when (> (.Size (.Elem t)) abi/MapMaxElemBytes)
    (return mapslow))

  (switch (algType (.Key t))
    (case [types/AMEM32]
      (when (not (.HasPointers (.Key t)))
        (return mapfast32))

      (when (== types/PtrSize 4)
        (return mapfast32ptr))

      (base/Fatalf "small pointer %v" (.Key t)))
    (case [types/AMEM64]
      (when (not (.HasPointers (.Key t)))
        (return mapfast64))

      (when (== types/PtrSize 8)
        (return mapfast64ptr)))

    ;; Two-word object, at least one of which is a pointer.
    ;; Use the slow path.
    (case [types/ASTRING]
      (return mapfaststr)))

  ^{:line 217} mapslow)




^{:go/end 247} (go/func algType "algType returns the fixed-width AMEMxx variants instead of the general\nAMEM kind when possible.\n" ^types/AlgKind [^{:tag (* types/Type)} t]
  (let [a (types/AlgType t)]
    (when (== a types/AMEM)
      (when (and (< (.Alignment t) (conv int64 ^{:go/via [Arch]} (.-Alignment (.-Arch base/Ctxt)))) (< (.Alignment t) (.Size t)))
        ;; For example, we can't treat [2]int16 as an int32 if int32s require
        ;; 4-byte alignment. See issue 46283.
        (return a))

      (switch (.Size t)
        (case [0]
          (return types/AMEM0))
        (case [1]
          (return types/AMEM8))
        (case [2]
          (return types/AMEM16))
        (case [4]
          (return types/AMEM32))
        (case [8]
          (return types/AMEM64))
        (case [16]
          (return types/AMEM128))))



    ^{:line 246} a))


^{:go/end 259} (go/func walkAppendArgs [^{:tag (* ir/CallExpr)} n ^{:tag (* ir/Nodes)} init]
  (walkExprListSafe (.-Args n) init)

  ;; walkExprListSafe will leave OINDEX (s[n]) alone if both s
  ;; and n are name or literal, but those may index the slice we're
  ;; modifying here. Fix explicitly.
  (let [ls (.-Args n)]
    (range [i1 n1 ls]
      (aset ls i1 (cheapExpr n1 init)))))




^{:go/end 275} (go/func appendWalkStmt "appendWalkStmt typechecks and walks stmt and then appends it to init.\n" [^{:tag (* ir/Nodes)} init ^ir/Node stmt]
  (let [op (.Op stmt)
      ^{:line 264} n (typecheck/Stmt stmt)]
    (if (or (== op ir/OAS) (== op ir/OAS2))
      ;; If the assignment has side effects, walkExpr will append them
      ;; directly to init for us, while walkStmt will wrap it in an OBLOCK.
      ;; We need to append them directly.
      ;; TODO(rsc): Clean this up.
      (set! n (walkExpr n init))

      (set! n (walkStmt n)))

    (.Append init n)))





      (case [(* ir/UnaryExpr)]
        (set! (.-X n) (.expr o (.-X n) nil)))
      (case [(* ir/ConvExpr)]
        (set! (.-X n) (.expr o (.-X n) nil)))
      (case [(* ir/BinaryExpr)]
        (set! (.-X n) (.expr o (.-X n) nil))
        (set! (.-Y n) (.expr o (.-Y n) nil)))
      (case [(* ir/MakeExpr)]
        (set! (.-Len n) (.expr o (.-Len n) nil))
        (set! (.-Cap n) (.expr o (.-Cap n) nil)))
      (case [(* ir/CallExpr)]
        (.exprList o (.-Args n))))

    (return))


  (let [n (assert (* ir/CallExpr) nn)]
    (typecheck/AssertFixedCall n)

    (when (and (ir/IsFuncPCIntrinsic n) (!= (ir/IsIfaceOfFunc (aget (.-Args n) 0)) nil))

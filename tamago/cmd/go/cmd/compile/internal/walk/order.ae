;; Rewrite tree to use separate statements to enforce
;; order of evaluation. Makes walk easier, because it
;; can (after this runs) reorder at will within an expression.
;;
;; Rewrite m[k] op= r into m[k] = m[k] op r if op is / or %.
;;
;; Introduce temporaries as needed by runtime routines.
;; For example, the map runtime routines take the map key
;; by reference, so make sure all map keys are addressable
;; by copying them to temporaries as needed.
;; The same is true for channel operations.
;;
;; Arrange that map index expressions only appear in direct
;; assignments x = m[k] or m[k] = x, never in larger expressions.
;;
;; Arrange that receive expressions only appear in direct assignments
;; x = <-c or as standalone statements <-c, never in larger expressions.


(go/type orderState "orderState holds state during the ordering process.\n" (struct
    ^{:line 43 :tag (slice ir/Node)} out ; list of generated statements
    ^{:line 44 :tag (slice (* ir/Name))} temp ; stack of temporary variables
    ^{:line 45 :tag (map string (slice (* ir/Name)))} free ; free list of unused temporaries, by type.LinkString().
    ^{:line 46 :tag (func [ir/Node] [ir/Node])} edit)) ; cached closure of o.exprNoLHS




^{:go/end 58} (go/func order "order rewrites fn.Nbody to apply the ordering constraints\ndescribed in the comment at the top of the file.\n" [^{:tag (* ir/Func)} fn]
  (when (> (.-W base/Flag) 1)
    (let [s (fmt/Sprintf "\nbefore order %v" (.Sym fn))]
      (ir/DumpList s (.-Body fn))))

  (ir/SetPos fn) ; Set reasonable position for instrumenting code. See issue 53688.
  (orderBlock (addr (.-Body fn)) (lit (map string (slice (* ir/Name))))))



^{:go/end 63} (go/method append "append typechecks stmt and appends it to out.\n" [^{:tag (* orderState)} o ^ir/Node stmt]
  (set! (.-out o) (append (.-out o) (typecheck/Stmt stmt))))





^{:go/end 86} (go/method newTemp "newTemp allocates a new temporary with the given type,\npushes it onto the temp stack, and returns it.\nIf clear is true, newTemp emits code to zero the temporary.\n" ^{:tag (* ir/Name)} [^{:tag (* orderState)} o ^{:tag (* types/Type)} t ^bool clear]
  (let [^{:tag (* ir/Name)} v (zero (* ir/Name))
      ^{:line 70} key (.LinkString t)]
    (if [a (aget (.-free o) key)] (> (len a) 0) (do
        (set! v (aget a (- (len a) 1)))
        (when (not (types/Identical t ^{:go/via [miniExpr]} (.Type v)))
          (base/Fatalf "expected %L to have type %v" v t))

        (aset (.-free o) key (subslice a _ (- (len a) 1))))

      (set! v (typecheck/TempAt base/Pos ir/CurFunc t)))

    (when clear
      (.append o (ir/NewAssignStmt base/Pos v nil)))


    (set! (.-temp o) (append (.-temp o) v))
    ^{:line 85} v))





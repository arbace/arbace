          (case [mapfast64]
            (set! kt (aget types/Types types/TUINT64)))
          (case [mapfast32ptr mapfast64ptr]
            (set! kt (aget types/Types types/TUNSAFEPTR)))
          (case [mapfaststr]
            (set! kt (aget types/Types types/TSTRING))))

        (let [nt (.Type n)]

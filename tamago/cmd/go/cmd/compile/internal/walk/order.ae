    (case [ir/ONAME ir/OLITERAL ir/ONIL]
      (return n))
    (case [ir/OLEN ir/OCAP]
      (let [n (assert (* ir/UnaryExpr) n)
          ^{:line 129} l (.cheapExpr o (.-X n))]

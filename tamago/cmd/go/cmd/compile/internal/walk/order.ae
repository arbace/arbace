          (let [zeroVal (ir/NewLinksymExpr (.Pos v) (.-ZeroVal ir/Syms) (.Type n))
              ^{:line 256} vstat (assert (* ir/LinksymOffsetExpr) (typecheck/Expr zeroVal))]
            (return vstat)))


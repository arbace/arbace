(in-ns 'go.cmd.compile.internal.walk) (go/file "closure.go" :imports [


    ^{:line 8} [base "cmd/compile/internal/base"]
    ^{:line 9} [ir "cmd/compile/internal/ir"]
    ^{:line 10} [typecheck "cmd/compile/internal/typecheck"]
    ^{:line 11} [types "cmd/compile/internal/types"]

  ;; Ugly hack to avoid "constant -1 overflows uintptr" errors, etc.
  (when (and (== (.Op n) ir/OLITERAL) (.IsSigned (.Type n)) (< (ir/Int64Val n) 0))
    (set! n (copyExpr n (.Type n) init)))


  (typecheck/Conv n t))

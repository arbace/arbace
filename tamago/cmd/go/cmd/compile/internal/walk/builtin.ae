    (aset (.-Args n) 0 (safeExpr (aget (.-Args n) 0) init))
    (aset (.-Args n) 0 (walkExpr (aget (.-Args n) 0) init)))

  (walkExprListSafe (subslice (.-Args n) 1) init)

  (let [nsrc (aget (.-Args n) 0)

      ;; walkExprListSafe will leave OINDEX (s[n]) alone if both s

^{:go/end 31} (go/func walkSelect [^{:tag (* ir/SelectStmt)} sel]
  (let [lno (ir/SetPos sel)]
    (when ^{:go/via [miniStmt miniNode]} (.Walked sel)
      (base/Fatalf "double walkSelect"))

    ^{:go/via [miniStmt miniNode]} (.SetWalked sel true)

    (let [init (ir/TakeInit sel)]

      (set! init (append init (spread (walkSelectCases (.-Cases sel)))))
      (set! (.-Cases sel) nil)

      (set! (.-Compiled sel) init)
      (walkStmtList (.-Compiled sel))

      (set! base/Pos lno))))



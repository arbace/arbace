(ns go.cmd.compile.internal.midway
  (:require [arbace.go :as go]))

(go/package midway
  :path "cmd/compile/internal/midway"
  :files ["analysis.go" "check.go" "deepcopy.go" "midway.go" "rewrite.go"]
  :positions :lines)

(load "midway/analysis")
(load "midway/check")
(load "midway/deepcopy")
(load "midway/midway")
(load "midway/rewrite")

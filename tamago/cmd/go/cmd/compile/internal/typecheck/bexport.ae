(in-ns 'go.cmd.compile.internal.typecheck) (go/file "bexport.go" :imports [])


(go/const "Tags. Must be < 0.\n"

  ^{:line 10} [^{:val -1 :doc "Objects\n"} packageTag (- (+ iota 1))]
  ^{:line 11} [^{:val -2} constTag]
  ^{:line 12} [^{:val -3} typeTag]
  ^{:line 13} [^{:val -4} varTag]
  ^{:line 14} [^{:val -5} funcTag]
  ^{:line 15} [^{:val -6} endTag])

(in-ns 'go.cmd.compile.internal.typecheck) (go/file "export.go" :imports [


    ^{:line 8} [base "cmd/compile/internal/base"]
    ^{:line 9} [ir "cmd/compile/internal/ir"]
    ^{:line 10} [types "cmd/compile/internal/types"]
    ^{:line 11} [src "cmd/internal/src"]])



^{:go/end 18} (go/func importfunc "importfunc declares symbol s as an imported function with type t.\n" [^{:tag (* types/Sym)} s ^{:tag (* types/Type)} t]
  (let [fn (ir/NewFunc src/NoXPos src/NoXPos s t)]
    (importsym (.-Nname fn))))



^{:go/end 25} (go/func importvar "importvar declares symbol s as an imported variable with type t.\n" [^{:tag (* types/Sym)} s ^{:tag (* types/Type)} t]
  (let [n (ir/NewNameAt src/NoXPos s t)]
    (set! (.-Class n) ir/PEXTERN)
    (importsym n)))


^{:go/end 33} (go/func importsym [^{:tag (* ir/Name)} name]
  (let [sym (.Sym name)]
    (when (!= (.-Def sym) nil)
      (base/Fatalf "importsym of symbol that already exists: %v" (.-Def sym)))

    (set! (.-Def sym) name)))

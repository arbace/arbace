  (roundFloat v (.Size t)))





^{:go/end 53} (go/func trunccmplxlit "truncate Real and Imag parts of Mpcplx to 32-bit or 64-bit\nprecision, according to type; return truncated value. In case of\noverflow, calls Errorf but does not truncate the input value.\n" ^constant/Value [^constant/Value v ^{:tag (* types/Type)} t]
  (when (.IsUntyped t)
    (return v))


  (let [fsz (/ (.Size t) 2)]
    (makeComplex (roundFloat (constant/Real v) fsz) (roundFloat (constant/Imag v) fsz))))




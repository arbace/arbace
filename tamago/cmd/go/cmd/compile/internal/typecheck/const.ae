^{:go/end 201} (go/func convlit1 "convlit1 converts an untyped expression n to type t. If n already\nhas a type, convlit1 has no effect.\n\nFor explicit conversions, t must be non-nil, and integer-to-string\nconversions are allowed.\n\nFor implicit conversions (e.g., assignments), t may be nil; if so,\nn is converted to its default type.\n\nIf there's an error converting n to t, context is used in the error\nmessage.\n" ^ir/Node [^ir/Node n ^{:tag (* types/Type)} t ^bool explicit ^{:tag (func [] [string])} context]
  (when (and explicit (== t nil))
    (base/Fatalf "explicit conversion missing type"))

  (when (and (!= t nil) (.IsUntyped t))
    (base/Fatalf "bad conversion to untyped: %v" t))


  (when (or (== n nil) (== (.Type n) nil))
    ;; Allow sloppy callers.
    (return n))

  (when (not (.IsUntyped (.Type n)))
    ;; Already typed; nothing to do.
    (return n))


  ;; Nil is technically not a constant, so handle it specially.
  (when (== (.Kind (.Type n)) types/TNIL)
    (when (!= (.Op n) ir/ONIL)
      (base/Fatalf "unexpected op: %v (%v)" n (.Op n)))

    (set! n (ir/Copy n))
    (when (== t nil)
      (base/Fatalf "use of untyped nil"))


    (when (not (.HasNil t))
      ;; Leave for caller to handle.
      (return n))


    (.SetType n t)
    (return n))


  (when (or (== t nil) (not (aget ir/OKForConst (.Kind t))))
    (set! t (defaultType (.Type n))))


  (switch (.Op n)
    (default
      (base/Fatalf "unexpected untyped expression: %v" n))

    (case [ir/OLITERAL]
      (let [v (ConvertVal (.Val n) t explicit)]
        (when (== (.Kind v) constant/Unknown)
          (set! n (ir/NewConstExpr (.Val n) n))
          (break))

        (set! n (ir/NewConstExpr v n))
        (.SetType n t)
        (return n)))

    (case [ir/OPLUS ir/ONEG ir/OBITNOT ir/ONOT ir/OREAL ir/OIMAG]
      (let [ot (operandType (.Op n) t)]
        (when (== ot nil)
          (set! n (DefaultLit n nil))
          (break))


        (let [n (assert (* ir/UnaryExpr) n)]
          (set! (.-X n) (convlit (.-X n) ot))
          (when (== (.Type (.-X n)) nil)
            ^{:go/via [miniExpr]} (.SetType n nil)
            (return n))

          ^{:go/via [miniExpr]} (.SetType n t)
          (return n))))

    (case [ir/OADD ir/OSUB ir/OMUL ir/ODIV ir/OMOD ir/OOR ir/OXOR ir/OAND ir/OANDNOT ir/OOROR ir/OANDAND ir/OCOMPLEX]
      (let [ot (operandType (.Op n) t)]
        (when (== ot nil)
          (set! n (DefaultLit n nil))
          (break))


        (let [(values ^ir/Node l ^ir/Node r) (zero ir/Node)]
          (type-switch [n n]
            (case [(* ir/BinaryExpr)]
              (set! (.-X n) (convlit (.-X n) ot))
              (set! (.-Y n) (convlit (.-Y n) ot))
              (set! (values l r) (values (.-X n) (.-Y n))))
            (case [(* ir/LogicalExpr)]
              (set! (.-X n) (convlit (.-X n) ot))
              (set! (.-Y n) (convlit (.-Y n) ot))
              (set! (values l r) (values (.-X n) (.-Y n)))))


          (when (or (== (.Type l) nil) (== (.Type r) nil))
            (.SetType n nil)
            (return n))

          (when (not (types/Identical (.Type l) (.Type r)))
            (base/Errorf "invalid operation: %v (mismatched types %v and %v)" n (.Type l) (.Type r))
            (.SetType n nil)
            (return n))


          (.SetType n t)
          (return n))))

    (case [ir/OEQ ir/ONE ir/OLT ir/OLE ir/OGT ir/OGE]
      (let [n (assert (* ir/BinaryExpr) n)]
        (when (not (.IsBoolean t))
          (break))

        ^{:go/via [miniExpr]} (.SetType n t)
        (return n)))

    (case [ir/OLSH ir/ORSH]
      (let [n (assert (* ir/BinaryExpr) n)]
        (set! (.-X n) (convlit1 (.-X n) t explicit nil))
        ^{:go/via [miniExpr]} (.SetType n (.Type (.-X n)))
        (when (and (!= ^{:go/via [miniExpr]} (.Type n) nil) (not (.IsInteger ^{:go/via [miniExpr]} (.Type n))))
          (base/Errorf "invalid operation: %v (shift of type %v)" n ^{:go/via [miniExpr]} (.Type n))
          ^{:go/via [miniExpr]} (.SetType n nil))

        (return n))))


  (cond explicit
    (base/Fatalf "cannot convert %L to type %v" n t)
    (!= context nil)
    (base/Fatalf "cannot use %L as type %v in %s" n t (context)) :else

    (base/Fatalf "cannot use %L as type %v" n t))


  (.SetType n nil)
  ^{:line 200} n)


^{:go/breaks [[4 218]] :go/end 219} (go/func operandType ^{:tag (* types/Type)} [^ir/Op op ^{:tag (* types/Type)} t]
  (switch op
    (case [ir/OCOMPLEX]
      (when (.IsComplex t)
        (return (types/FloatForComplex t))))

    (case [ir/OREAL ir/OIMAG]
      (when (.IsFloat t)
        (return (types/ComplexForFloat t))))

    (default
      (when (aget (aget okfor op) (.Kind t))
        (return t))))


  nil)








^{:go/end 261} (go/func ConvertVal "ConvertVal converts v into a representation appropriate for t. If\nno such representation exists, it returns constant.MakeUnknown()\ninstead.\n\nIf explicit is true, then conversions from integer to string are\nalso allowed.\n" ^constant/Value [^constant/Value v ^{:tag (* types/Type)} t ^bool explicit]
  (switch [ct (.Kind v)] ct
    (case [constant/Bool]
      (when (.IsBoolean t)
        (return v)))


    (case [constant/String]
      (when (.IsString t)
        (return v)))


    (case [constant/Int]
      (when (and explicit (.IsString t))
        (return (tostr v)))

      (fallthrough))
    (case [constant/Float constant/Complex]
      (switch
        (case [(.IsInteger t)]
          (set! v (toint v))
          (return v))
        (case [(.IsFloat t)]
          (set! v (toflt v))
          (set! v (truncfltlit v t))
          (return v))
        (case [(.IsComplex t)]
          (set! v (tocplx v))
          (set! v (trunccmplxlit v t))
          (return v)))))



  (constant/MakeUnknown))


^{:go/end 265} (go/func tocplx ^constant/Value [^constant/Value v]
  (constant/ToComplex v))


^{:go/end 273} (go/func toflt ^constant/Value [^constant/Value v]
  (when (== (.Kind v) constant/Complex)

^{:go/end 308} (go/func toint ^constant/Value [^constant/Value v]
  (when (== (.Kind v) constant/Complex)
    (set! v (constant/Real v)))


  (when [v (constant/ToInt v)] (== (.Kind v) constant/Int)
    (return v))


  ;; The value of v cannot be represented as an integer;
  ;; so we need to print an error message.
  ;; Unfortunately some float values cannot be
  ;; reasonably formatted for inclusion in an error
  ;; message (example: 1 + 1e-100), so first we try to
  ;; format the float; if the truncation resulted in
  ;; something that looks like an integer we omit the
  ;; value from the error message.
  ;; (See issue #11371).
  (let [f (ir/BigFloat v)]
    (if (> (.MantExp f nil) (* 2 ir/ConstPrec))
      (base/Errorf "integer too large")

      (let [^big/Float t (zero big/Float)]
        (.Parse t (fmt/Sprint v) 0)
        (if (.IsInt t)
          (base/Errorf "constant truncated to integer")

          (base/Errorf "constant %v truncated to integer" v))))



    ;; Prevent follow-on errors.
    (constant/MakeUnknown)))


^{:go/end 319} (go/func tostr ^constant/Value [^constant/Value v]
  (when (== (.Kind v) constant/Int)
    (let [r unicode/ReplacementChar]
      (when [(values x ok) (constant/Uint64Val v)] (and ok (<= x unicode/MaxRune))
        (set! r (conv rune x)))

      (set! v (constant/MakeString (conv string r)))))

  ^{:line 318} v)



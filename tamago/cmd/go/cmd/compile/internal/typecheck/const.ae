^{:go/end 376} (go/func defaultlit2 "DefaultLit on both nodes simultaneously;\nif they're both ideal going in they better\nget the same type going out.\nforce means must assign concrete (non-ideal) type.\nThe results of defaultlit2 MUST be assigned back to l and r, e.g.\n\n\tn.Left, n.Right = defaultlit2(n.Left, n.Right, force)\n" [^ir/Node l ^ir/Node r ^bool force] :results [ir/Node ir/Node]
  (when (or (== (.Type l) nil) (== (.Type r) nil))
    (return l r))


  (when (and (not (.IsInterface (.Type l))) (not (.IsInterface (.Type r))))
    ;; Can't mix bool with non-bool, string with non-string.
    (when (!= (.IsBoolean (.Type l)) (.IsBoolean (.Type r)))
      (return l r))

    (when (!= (.IsString (.Type l)) (.IsString (.Type r)))
      (return l r)))



  (when (not (.IsUntyped (.Type l)))
    (set! r (convlit r (.Type l)))
    (return l r))


  (when (not (.IsUntyped (.Type r)))
    (set! l (convlit l (.Type r)))
    (return l r))


  (when (not force)
    (return l r))


  ;; Can't mix nil with anything untyped.
  (when (or (ir/IsNil l) (ir/IsNil r))
    (return l r))

  (let [t (defaultType (mixUntyped (.Type l) (.Type r)))]
    (set! l (convlit l t))
    (set! r (convlit r t))
    (return l r)))


^{:go/end 402} (go/func mixUntyped ^{:tag (* types/Type)} [^{:tag (* types/Type)} t1 ^{:tag (* types/Type)} t2]
  (when (== t1 t2)
    (return t1))


  (let [rank ^{:go/end 396} (fn ^int [^{:tag (* types/Type)} t]
        (switch t
          (case [types/UntypedInt]
            (return 0))
          (case [types/UntypedRune]
            (return 1))
          (case [types/UntypedFloat]
            (return 2))
          (case [types/UntypedComplex]
            (return 3)))

        (base/Fatalf "bad type %v" t)
        (panic "unreachable"))]


    (when (> (rank t2) (rank t1))
      (return t2))

    ^{:line 401} t1))


^{:go/breaks [6] :go/end 426} (go/func defaultType ^{:tag (* types/Type)} [^{:tag (* types/Type)} t]
  (when (or (not (.IsUntyped t)) (== (.Kind t) types/TNIL))
    (return t))


  (switch t
    (case [types/UntypedBool]
      (return (aget types/Types types/TBOOL)))
    (case [types/UntypedString]
      (return (aget types/Types types/TSTRING)))
    (case [types/UntypedInt]
      (return (aget types/Types types/TINT)))
    (case [types/UntypedRune]
      (return types/RuneType))
    (case [types/UntypedFloat]
      (return (aget types/Types types/TFLOAT64)))
    (case [types/UntypedComplex]
      (return (aget types/Types types/TCOMPLEX128))))


  (base/Fatalf "bad type %v" t)
  nil)




^{:go/end 31} (go/func roundFloat ^constant/Value [^constant/Value v ^int64 sz]
  (switch sz
    (case [4]
      (let [(values f _) (constant/Float32Val v)]
        (return (makeFloat64 (conv float64 f)))))
    (case [8]
      (let [(values f _) (constant/Float64Val v)]
        (return (makeFloat64 f)))))

  (base/Fatalf "unexpected size: %v" sz)
  (panic "unreachable"))




^{:go/end 41} (go/func truncfltlit "truncate float literal fv to 32-bit or 64-bit precision\naccording to type; return truncated value.\n" ^constant/Value [^constant/Value v ^{:tag (* types/Type)} t]

(in-ns 'go.cmd.compile.internal.typecheck) (go/file "syms.go" :imports [


    ^{:line 8} [base "cmd/compile/internal/base"]
    ^{:line 9} [ir "cmd/compile/internal/ir"]
    ^{:line 10} [types "cmd/compile/internal/types"]
    ^{:line 11} [obj "cmd/internal/obj"]])





^{:go/end 27} (go/func LookupRuntime "LookupRuntime returns a function or variable declared in\n_builtin/runtime.go. If types_ is non-empty, successive occurrences\nof the \"any\" placeholder type will be substituted.\n" ^{:tag (* ir/Name)} [^string name & ^{:tag (slice (* types/Type))} types_]
  (let [s (.Lookup (.-Runtime ir/Pkgs) name)]
    (when (or (== s nil) (== (.-Def s) nil))
      (base/Fatalf "LookupRuntime: can't find runtime.%s" name))

    (let [n (assert (* ir/Name) (.-Def s))]
      (when (!= (len types_) 0)
        (set! n (substArgTypes n (spread types_))))

      ^{:line 26} n)))





^{:go/end 43} (go/func substArgTypes "SubstArgTypes substitutes the given list of types for\nsuccessive occurrences of the \"any\" placeholder in the\ntype syntax expression n.Type.\n" ^{:tag (* ir/Name)} [^{:tag (* ir/Name)} old & ^{:tag (slice (* types/Type))} types_]
  (range [_ t types_]
    (types/CalcSize t))

  (let [n (ir/NewNameAt ^{:go/via [miniExpr miniNode]} (.Pos old) (.Sym old) (types/SubstAny ^{:go/via [miniExpr]} (.Type old) (addr types_)))]
    (set! (.-Class n) (.-Class old))
    (set! (.-Func n) (.-Func old))
    (when (> (len types_) 0)
      (base/Fatalf "SubstArgTypes: too many argument types"))

    ^{:line 42} n))








^{:go/end 62} (go/func AutoLabel "AutoLabel generates a new Name node for use with\nan automatically generated label.\nprefix is a short mnemonic (e.g. \".s\" for switch)\nto help with debugging.\nIt should begin with \".\" to avoid conflicts with\nuser labels.\n" ^{:tag (* types/Sym)} [^string prefix]
  (when (!= (aget prefix 0) \.)
    (base/Fatalf "autolabel prefix must start with '.', have %q" prefix))

  (let [fn ir/CurFunc]
    (when (== ir/CurFunc nil)
      (base/Fatalf "autolabel outside function"))

    (let [n (.-Label fn)]
      (inc! (.-Label fn))
      (LookupNum prefix (conv int n)))))


^{:go/end 66} (go/func Lookup ^{:tag (* types/Sym)} [^string name]
  (.Lookup types/LocalPkg name))





^{:go/end 87} (go/func InitRuntime "InitRuntime loads the definitions for the low-level runtime functions,\nso that the compiler can generate calls to them,\nbut does not make them visible to user code.\n" []
  (.Start base/Timer "fe" "loadsys")

  (let [typs (runtimeTypes)]
    (range [_ d (addr runtimeDecls)]
      (let [sym (.Lookup (.-Runtime ir/Pkgs) (.-name d))
          ^{:line 77} typ (aget typs (.-typ d))]
        (switch (.-tag d)
          (case [funcTag]
            (importfunc sym typ))
          (case [varTag]
            (importvar sym typ))
          (default
            (base/Fatalf "unhandled declaration tag %v" (.-tag d))))))))






^{:go/end 93} (go/func LookupRuntimeFunc "LookupRuntimeFunc looks up Go function name in package runtime. This function\nmust follow the internal calling convention.\n" ^{:tag (* obj/LSym)} [^string name]
  (LookupRuntimeABI name obj/ABIInternal))





^{:go/end 100} (go/func LookupRuntimeVar "LookupRuntimeVar looks up a variable (or assembly function) name in package\nruntime. If this is a function, it may have a special calling\nconvention.\n" ^{:tag (* obj/LSym)} [^string name]
  (LookupRuntimeABI name obj/ABI0))



^{:go/end 105} (go/func LookupRuntimeABI "LookupRuntimeABI looks up a name in package runtime using the given ABI.\n" ^{:tag (* obj/LSym)} [^string name ^obj/ABI abi]
  (base/PkgLinksym "runtime" name abi))




^{:go/end 123} (go/func InitCoverage "InitCoverage loads the definitions for routines called\nby code coverage instrumentation (similar to InitRuntime above).\n" []
  (let [typs (coverageTypes)]
    (range [_ d (addr coverageDecls)]
      (let [sym (.Lookup (.-Coverage ir/Pkgs) (.-name d))
          ^{:line 113} typ (aget typs (.-typ d))]
        (switch (.-tag d)
          (case [funcTag]
            (importfunc sym typ))
          (case [varTag]
            (importvar sym typ))
          (default
            (base/Fatalf "unhandled declaration tag %v" (.-tag d))))))))







^{:go/end 134} (go/func LookupCoverage "LookupCoverage looks up the Go function 'name' in package\nruntime/coverage. This function must follow the internal calling\nconvention.\n" ^{:tag (* ir/Name)} [^string name]
  (let [sym (.Lookup (.-Coverage ir/Pkgs) name)]
    (when (== sym nil)
      (base/Fatalf "LookupCoverage: can't find runtime/coverage.%s" name))

    (assert (* ir/Name) (.-Def sym))))

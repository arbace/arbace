(in-ns 'go.cmd.compile.internal.typecheck) (go/file "universe.go" :imports [


    ^{:line 8} [constant "go/constant"]

    ^{:line 10} [ir "cmd/compile/internal/ir"]
    ^{:line 11} [types "cmd/compile/internal/types"]
    ^{:line 12} [src "cmd/internal/src"]])


(go/var
  ^{:line 16} [^{:tag (array ir/OEND (slice bool))} okfor])


(go/var
  ^{:line 20} [^{:tag (array types/NTYPE bool)} okforeq]
  ^{:line 21} [^{:tag (array types/NTYPE bool)} okforadd]
  ^{:line 22} [^{:tag (array types/NTYPE bool)} okforand]
  ^{:line 23} [^{:tag (array types/NTYPE bool)} okfornone]
  ^{:line 24} [^{:tag (array types/NTYPE bool)} okforbool]
  ^{:line 25} [^{:tag (array types/NTYPE bool)} okforcap]
  ^{:line 26} [^{:tag (array types/NTYPE bool)} okforlen]
  ^{:line 27} [^{:tag (array types/NTYPE bool)} okforarith])


(go/var builtinFuncs (lit (array ... (struct
        ^{:line 31 :tag string} name
        ^{:line 32 :tag ir/Op} op))

    (lit _ "append" ir/OAPPEND)
    (lit _ "cap" ir/OCAP)
    (lit _ "clear" ir/OCLEAR)
    (lit _ "close" ir/OCLOSE)
    (lit _ "complex" ir/OCOMPLEX)
    (lit _ "copy" ir/OCOPY)
    (lit _ "delete" ir/ODELETE)
    (lit _ "imag" ir/OIMAG)
    (lit _ "len" ir/OLEN)
    (lit _ "make" ir/OMAKE)
    (lit _ "max" ir/OMAX)
    (lit _ "min" ir/OMIN)
    (lit _ "new" ir/ONEW)
    (lit _ "panic" ir/OPANIC)
    (lit _ "print" ir/OPRINT)
    (lit _ "println" ir/OPRINTLN)
    (lit _ "real" ir/OREAL)
    (lit _ "recover" ir/ORECOVER)))


(go/var unsafeFuncs (lit (array ... (struct
        ^{:line 55 :tag string} name
        ^{:line 56 :tag ir/Op} op))

    (lit _ "Add" ir/OUNSAFEADD)
    (lit _ "Slice" ir/OUNSAFESLICE)
    (lit _ "SliceData" ir/OUNSAFESLICEDATA)
    (lit _ "String" ir/OUNSAFESTRING)
    (lit _ "StringData" ir/OUNSAFESTRINGDATA)))



^{:go/end 197} (go/func InitUniverse "InitUniverse initializes the universe block.\n" []
  (types/InitTypes ^{:go/end 73} (fn ^types/Object [^{:tag (* types/Sym)} sym ^{:tag (* types/Type)} typ]
      (let [n (ir/NewDeclNameAt src/NoXPos ir/OTYPE sym)]
        ^{:go/via [miniExpr]} (.SetType n typ)
        ^{:go/via [miniExpr miniNode]} (.SetTypecheck n 1)
        (set! (.-Def sym) n)
        ^{:line 72} n)))


  (range [_ s (addr builtinFuncs)]
    (ir/NewBuiltin (.Lookup types/BuiltinPkg (.-name s)) (.-op s)))


  (range [_ s (addr unsafeFuncs)]
    (ir/NewBuiltin (.Lookup types/UnsafePkg (.-name s)) (.-op s)))


  (let [s (.Lookup types/BuiltinPkg "true")]
    (set! (.-Def s) (ir/NewConstAt src/NoXPos s types/UntypedBool (constant/MakeBool true)))

    (set! s (.Lookup types/BuiltinPkg "false"))
    (set! (.-Def s) (ir/NewConstAt src/NoXPos s types/UntypedBool (constant/MakeBool false)))

    (set! s (Lookup "_"))
    (set! types/BlankSym s)
    (set! ir/BlankNode (ir/NewNameAt src/NoXPos s (aget types/Types types/TBLANK)))
    (set! (.-Def s) ir/BlankNode)

    (set! s (.Lookup types/BuiltinPkg "_"))
    (set! (.-Def s) (ir/NewNameAt src/NoXPos s (aget types/Types types/TBLANK)))

    (set! s (.Lookup types/BuiltinPkg "nil"))
    (set! (.-Def s) (NodNil))

    ;; initialize okfor
    (for [et (conv types/Kind 0)] (< et types/NTYPE) (inc! et)
      (when (or (aget types/IsInt et) (== et types/TIDEAL))
        (aset okforeq et true)
        (aset types/IsOrdered et true)
        (aset okforarith et true)
        (aset okforadd et true)
        (aset okforand et true)
        (aset ir/OKForConst et true)
        (aset types/IsSimple et true))


      (when (aget types/IsFloat et)
        (aset okforeq et true)
        (aset types/IsOrdered et true)
        (aset okforadd et true)
        (aset okforarith et true)
        (aset ir/OKForConst et true)
        (aset types/IsSimple et true))


      (when (aget types/IsComplex et)
        (aset okforeq et true)
        (aset okforadd et true)
        (aset okforarith et true)
        (aset ir/OKForConst et true)
        (aset types/IsSimple et true)))



    (aset types/IsSimple types/TBOOL true)

    (aset okforadd types/TSTRING true)

    (aset okforbool types/TBOOL true)

    (aset okforcap types/TARRAY true)
    (aset okforcap types/TCHAN true)
    (aset okforcap types/TSLICE true)

    (aset ir/OKForConst types/TBOOL true)
    (aset ir/OKForConst types/TSTRING true)

    (aset okforlen types/TARRAY true)
    (aset okforlen types/TCHAN true)
    (aset okforlen types/TMAP true)
    (aset okforlen types/TSLICE true)
    (aset okforlen types/TSTRING true)

    (aset okforeq types/TPTR true)
    (aset okforeq types/TUNSAFEPTR true)
    (aset okforeq types/TINTER true)
    (aset okforeq types/TCHAN true)
    (aset okforeq types/TSTRING true)
    (aset okforeq types/TBOOL true)
    (aset okforeq types/TMAP true) ; nil only; refined in typecheck
    (aset okforeq types/TFUNC true) ; nil only; refined in typecheck
    (aset okforeq types/TSLICE true) ; nil only; refined in typecheck
    (aset okforeq types/TARRAY true) ; only if element type is comparable; refined in typecheck
    (aset okforeq types/TSTRUCT true) ; only if all struct fields are comparable; refined in typecheck

    (aset types/IsOrdered types/TSTRING true)

    (range [i okfor]
      (aset okfor i (subslice okfornone)))


    ;; binary
    (aset okfor ir/OADD (subslice okforadd))
    (aset okfor ir/OAND (subslice okforand))
    (aset okfor ir/OANDAND (subslice okforbool))
    (aset okfor ir/OANDNOT (subslice okforand))
    (aset okfor ir/ODIV (subslice okforarith))
    (aset okfor ir/OEQ (subslice okforeq))
    (aset okfor ir/OGE (subslice types/IsOrdered))
    (aset okfor ir/OGT (subslice types/IsOrdered))
    (aset okfor ir/OLE (subslice types/IsOrdered))
    (aset okfor ir/OLT (subslice types/IsOrdered))
    (aset okfor ir/OMOD (subslice okforand))
    (aset okfor ir/OMUL (subslice okforarith))
    (aset okfor ir/ONE (subslice okforeq))
    (aset okfor ir/OOR (subslice okforand))
    (aset okfor ir/OOROR (subslice okforbool))
    (aset okfor ir/OSUB (subslice okforarith))
    (aset okfor ir/OXOR (subslice okforand))
    (aset okfor ir/OLSH (subslice okforand))
    (aset okfor ir/ORSH (subslice okforand))

    ;; unary
    (aset okfor ir/OBITNOT (subslice okforand))
    (aset okfor ir/ONEG (subslice okforarith))
    (aset okfor ir/ONOT (subslice okforbool))
    (aset okfor ir/OPLUS (subslice okforarith))

    ;; special
    (aset okfor ir/OCAP (subslice okforcap))
    (aset okfor ir/OLEN (subslice okforlen))))

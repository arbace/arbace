;; Indexed package import.
;; See iexport.go for the export data format.

(in-ns 'go.cmd.compile.internal.typecheck) (go/file "iimport.go" :imports [


    ^{:line 11} [base "cmd/compile/internal/base"]
    ^{:line 12} [ir "cmd/compile/internal/ir"]
    ^{:line 13} [types "cmd/compile/internal/types"]])







(go/var ^{:doc "HaveInlineBody reports whether we have fn's inline body available\nfor inlining.\n\nIt's a function literal so that it can be overridden for\nGOEXPERIMENT=unified.\n"} HaveInlineBody ^{:go/end 24} (fn ^bool [^{:tag (* ir/Func)} fn]
    (base/Fatalf "HaveInlineBody not overridden")
    (panic "unreachable")))


^{:go/end 33} (go/func SetBaseTypeIndex [^{:tag (* types/Type)} t ^int64 i ^int64 pi]
  (when (== (.Obj t) nil)
    (base/Fatalf "SetBaseTypeIndex on non-defined type %v" t))

  (when (and (!= i -1) (!= pi -1))
    (aset typeSymIdx t (lit (array 2 int64) i pi))))






(go/var ^{:doc "Map imported type T to the index of type descriptor symbols of T and *T,\nso we can use index to reference the symbol.\nTODO(mdempsky): Store this information directly in the Type's Name.\n"} typeSymIdx (make (map (* types/Type) (array 2 int64))))

^{:go/end 53} (go/func BaseTypeIndex ^int64 [^{:tag (* types/Type)} t]
  (let [tbase t]
    (when (and (.IsPtr t) (== (.Sym t) nil) (!= (.Sym (.Elem t)) nil))
      (set! tbase (.Elem t)))

    (let [(values i ok) (aget typeSymIdx tbase)]
      (when (not ok)
        (return -1))

      (when (!= t tbase)
        (return (aget i 1)))

      (aget i 0))))

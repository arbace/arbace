^{:go/end 521} (go/func dotpath "dotpath computes the unique shortest explicit selector path to fully qualify\na selection expression x.f, where x is of type t and f is the symbol s.\nIf no such path exists, dotpath returns nil.\nIf there are multiple shortest paths to the same depth, ambig is true.\n" [^{:tag (* types/Sym)} s ^{:tag (* types/Type)} t ^{:tag (* (* types/Field))} save ^bool ignorecase] :results [^{:tag (slice dlist)} path ^bool ambig]

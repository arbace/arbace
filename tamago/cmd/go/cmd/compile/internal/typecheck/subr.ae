^{:go/end 209} (go/func adddot1 "adddot1 returns the number of fields or methods named s at depth d in Type t.\nIf exactly one exists, it will be returned in *save (if save is not nil),\nand dotlist will contain the path of embedded fields traversed to find it,\nin reverse order. If none exist, more will indicate whether t contains any\nembedded fields at depth d, so callers can decide whether to retry at\na greater depth.\n" [^{:tag (* types/Sym)} s ^{:tag (* types/Type)} t ^int d ^{:tag (* (* types/Field))} save ^bool ignorecase] :results [^int c ^bool more]

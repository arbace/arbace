    (return ir/OCONVNOP ""))

  (when (or (== src nil) (== dst nil) (== (.Kind src) types/TFORW) (== (.Kind dst) types/TFORW) (== (.Underlying src) nil) (== (.Underlying dst) nil))
    (return ir/OXXX ""))


  ;; 1. src type is identical to dst.
  (when (types/Identical src dst)
    (return ir/OCONVNOP ""))


  ;; 2. src and dst have identical underlying types and
  ;;   a. either src or dst is not a named type, or
  ;;   b. both are empty interface types, or

    (when (.IsPtr u)
      (set! u (.Elem u)))

    (when (and (not (.IsStruct u)) (not (.IsInterface u)))
      (return c false))


    (let [^{:tag (slice (* types/Field))} fields (zero (slice (* types/Field)))]

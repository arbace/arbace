                (when (ir/IsNil n1) ; case nil:
                  (if (!= nilCase nil)
                    (base/ErrorfAt ^{:go/via [miniStmt miniNode]} (.Pos ncase) errors/DuplicateCase "multiple nil cases in type switch (first at %v)" (ir/Line nilCase))

                    (set! nilCase ncase))

                  (continue))

                (when (== (.Op n1) ir/ODYNAMICTYPE)
                  (continue))

                (when (!= (.Op n1) ir/OTYPE)
                  (base/ErrorfAt ^{:go/via [miniStmt miniNode]} (.Pos ncase) errors/NotAType "%L is not a type" n1)
                  (continue))

                (when (not (.IsInterface (.Type n1)))
                  (let [why (ImplementsExplain (.Type n1) t)]
                    (when (!= why "")
                      (base/ErrorfAt ^{:go/via [miniStmt miniNode]} (.Pos ncase) errors/ImpossibleAssert "impossible type switch case: %L cannot have dynamic type %v (%s)" (.-X guard) (.Type n1) why))

                    (continue)))


                (.add ts ^{:go/via [miniStmt miniNode]} (.Pos ncase) (.Type n1))))


            (when (!= (.-Var ncase) nil)
              ;; Assign the clause variable's type.
              (let [vt t]
                (when (== (len ls) 1)
                  (cond (or (== (.Op (aget ls 0)) ir/OTYPE) (== (.Op (aget ls 0)) ir/ODYNAMICTYPE))
                    (set! vt (.Type (aget ls 0)))
                    (not (ir/IsNil (aget ls 0)))
                    ;; Invalid single-type case;
                    ;; mark variable as broken.
                    (set! vt nil)))



                (let [nvar (.-Var ncase)]
                  ^{:go/via [miniExpr]} (.SetType nvar vt)
                  (if (!= vt nil)
                    (set! nvar (assert (* ir/Name) (AssignExpr nvar)))

                    ;; Clause variable is broken; prevent typechecking.
                    ^{:go/via [miniExpr miniNode]} (.SetTypecheck nvar 1))

                  (set! (.-Var ncase) nvar))))


            (Stmts (.-Body ncase))))))))



(go/type typeSet (struct
    ^{:line 710 :tag (map string src/XPos)} m))


^{:go/end 724} (go/method add [^{:tag (* typeSet)} s ^src/XPos pos ^{:tag (* types/Type)} typ]
  (when (== (.-m s) nil)
    (set! (.-m s) (make (map string src/XPos))))


  (let [ls (.LinkString typ)]
    (when [(values prev ok) (aget (.-m s) ls)] ok
      (base/ErrorfAt pos errors/DuplicateCase "duplicate case %v in type switch\n\tprevious case at %s" typ (base/FmtPos prev))
      (return))

    (aset (.-m s) ls pos)))

^{:go/end 118} (go/func ClosureType "ClosureType returns the struct type used to hold all the information\nneeded in the closure for clo (clo must be a OCLOSURE node).\nThe address of a variable of the returned type can be cast to a func.\n" ^{:tag (* types/Type)} [^{:tag (* ir/ClosureExpr)} clo]
  ;; Create closure in the form of a composite literal.
  ;; supposing the closure captures an int i and a string s
  ;; and has one float64 argument and no results,
  ;; the generated code looks like:
  ;;
  ;;	clos = &struct{F uintptr; X0 *int; X1 *string}{func.1, &i, &s}
  ;;
  ;; The use of the struct provides type information to the garbage
  ;; collector so that it can walk the closure. We could use (in this
  ;; case) [3]unsafe.Pointer instead, but that would leave the gc in
  ;; the dark. The information appears in the binary in the form of
  ;; type descriptors; the struct is unnamed and uses exported field
  ;; names so that closures in multiple packages with the same struct
  ;; type can share the descriptor.

  (let [fields (make (slice (* types/Field)) (+ 1 (len (.-ClosureVars (.-Func clo)))))]
    (aset fields 0 (types/NewField base/AutogeneratedPos (.Lookup types/LocalPkg "F") (aget types/Types types/TUINTPTR)))
    (let [it (NewClosureStructIter (.-ClosureVars (.-Func clo)))
        ^{:line 106} i 0]
      (while true
        (let [(values n typ _) (.Next it)]
          (when (== n nil)
            (break))

          (aset fields (+ 1 i) (types/NewField base/AutogeneratedPos (.LookupNum types/LocalPkg "X" i) typ))
          (inc! i)))

      (let [typ (types/NewStruct fields)]
        (.SetNoalg typ true)
        ^{:line 117} typ))))






;; This file implements the Import function for tests to use gc-generated object files.

(in-ns 'go.cmd.compile.internal.importer) (go/file "gcimporter.go" :imports [


    ^{:line 10} [bufio "bufio"]
    ^{:line 11} [fmt "fmt"]
    ^{:line 12} [exportdata "internal/exportdata"]
    ^{:line 13} [pkgbits "internal/pkgbits"]
    ^{:line 14} [io "io"]
    ^{:line 15} [os "os"]

    ^{:line 17} [types2 "cmd/compile/internal/types2"]])







^{:go/end 87} (go/func Import "Import imports a gc-generated package given its import path and srcDir, adds\nthe corresponding package object to the packages map, and returns the object.\nThe packages map must contain all packages already imported.\n\nThis function should only be used in tests.\n" [^{:tag (map string (* types2/Package))} packages ^string path ^string srcDir ^{:tag (func [^string path] [io/ReadCloser error])} lookup] :results [^{:tag (* types2/Package)} pkg ^error err]
  (let [^io/ReadCloser rc (zero io/ReadCloser)
      ^{:line 27 :tag string} id (zero string)]
    (if (!= lookup nil) (do
        ;; With custom lookup specified, assume that caller has
        ;; converted path to a canonical import path for use in the map.
        (when (== path "unsafe")
          (return types2/Unsafe nil))

        (set! id path)

        ;; No need to re-import if the package was imported completely before.
        (when [(set! pkg (aget packages id))] (and (!= pkg nil) (.Complete pkg))
          (return))

        (let [(values f err) (lookup path)]
          (when (!= err nil)
            (return nil err))

          (set! rc f)))

      (let [^string filename (zero string)]
        (set! (values filename id err) (exportdata/FindPkg path srcDir))
        (when (== filename "")
          (when (== path "unsafe")
            (return types2/Unsafe nil))

          (return nil err))


        ;; no need to re-import if the package was imported completely before
        (when [(set! pkg (aget packages id))] (and (!= pkg nil) (.Complete pkg))
          (return))


        ;; open file
        (let [(values f err) (os/Open filename)]
          (when (!= err nil)
            (return nil err))

          (defer (^{:go/end 70} (fn []
                (when (!= err nil)
                  ;; add file name to error
                  (set! err (fmt/Errorf "%s: %v" filename err))))))


          (set! rc f))))

    (defer (.Close rc))

    (let [buf (bufio/NewReader rc)
        (values data ^:assign err) (exportdata/ReadUnified buf)]
      (when (!= err nil)
        (set! err (fmt/Errorf "import %q: %v" path err))
        (return))

      (let [s (conv string data)

          ^{:line 83} input (pkgbits/NewPkgDecoder id s)]
        (set! pkg (ReadPackage nil packages input))

        (return)))))

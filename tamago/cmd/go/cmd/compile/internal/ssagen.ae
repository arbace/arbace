(ns go.cmd.compile.internal.ssagen
  (:require [arbace.go :as go]))

(go/package ssagen
  :path "cmd/compile/internal/ssagen"
  :files ["abi.go" "arch.go" "intrinsics.go" "nowb.go" "pgen.go" "phi.go" "simdAMD64intrinsics.go" "simdARM64intrinsics.go" "simdWasmintrinsics.go" "ssa.go"]
  :positions :lines)

(load "ssagen/abi")
(load "ssagen/arch")
(load "ssagen/intrinsics")
(load "ssagen/nowb")
(load "ssagen/pgen")
(load "ssagen/phi")
(load "ssagen/simdAMD64intrinsics")
(load "ssagen/simdARM64intrinsics")
(load "ssagen/simdWasmintrinsics")
(load "ssagen/ssa")

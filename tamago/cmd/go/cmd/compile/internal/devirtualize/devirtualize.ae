;; Package devirtualize implements two "devirtualization" optimization passes:
;;
;;   - "Static" devirtualization which replaces interface method calls with
;;     direct concrete-type method calls where possible.
;;   - "Profile-guided" devirtualization which replaces indirect calls with a
;;     conditional direct call to the hottest concrete callee from a profile, as
;;     well as a fallback using the original indirect call.
(in-ns 'go.cmd.compile.internal.devirtualize) (go/file "devirtualize.go" :doc "Package devirtualize implements two \"devirtualization\" optimization passes:\n\n  - \"Static\" devirtualization which replaces interface method calls with\n    direct concrete-type method calls where possible.\n  - \"Profile-guided\" devirtualization which replaces indirect calls with a\n    conditional direct call to the hottest concrete callee from a profile, as\n    well as a fallback using the original indirect call.\n" :imports [


    ^{:line 15} [base "cmd/compile/internal/base"]
    ^{:line 16} [ir "cmd/compile/internal/ir"]
    ^{:line 17} [typecheck "cmd/compile/internal/typecheck"]
    ^{:line 18} [types "cmd/compile/internal/types"]])



              (when [(values _ ok) (aget (.-analyzedFuncs s) (.-Func n))] (not ok)
                (aset (.-analyzedFuncs s) (.-Func n) (lit (struct)))
                (ir/Visit (.-Func n) do)))))))



    (ir/VisitList nodes do)))

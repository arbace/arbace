                  (return n))


                (let [^ir/Node newNode (zero ir/Node)
                    ^{:line 158 :tag (* ir/Func)} callee (zero (* ir/Func))
                    ^{:line 159 :tag int64} weight (zero int64)]
                  (switch op
                    (case [ir/OCALLFUNC]
                      (set! (values newNode callee weight) (maybeDevirtualizeFunctionCall p fn call)))
                    (case [ir/OCALLINTER]
                      (set! (values newNode callee weight) (maybeDevirtualizeInterfaceCall p fn call)))
                    (default
                      (panic "unreachable")))



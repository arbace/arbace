(ns go.cmd.compile.internal.base
  (:require [arbace.go :as go]))

(go/package base
  :path "cmd/compile/internal/base"
  :files ["base.go" "bootstrap_false.go" "debug.go" "flag.go" "hashdebug.go" "link.go" "mapfile_mmap.go" "mapfile_read.go" "print.go" "startheap.go" "timings.go"]
  :positions :lines)

(load "base/base")
(load "base/bootstrap_false")
(load "base/debug")
(load "base/flag")
(load "base/hashdebug")
(load "base/link")
(load "base/mapfile_mmap")
(load "base/mapfile_read")
(load "base/print")
(load "base/startheap")
(load "base/timings")

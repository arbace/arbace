^{:go/end 43} (go/func ssaMarkMoves "ssaMarkMoves marks any MOVXconst ops that need to avoid clobbering flags.\n" [^{:tag (* ssagen/State)} s ^{:tag (* ssa/Block)} b]
  (let [flive (.-FlagsLiveAtEnd b)]
    (range [_ c (.ControlValues b)]
      (set! flive (or (.IsFlags (.-Type c)) flive)))

    (for [i (- (len (.-Values b)) 1)] (>= i 0) (dec! i)
      (let [v (aget (.-Values b) i)]
        (when (and flive (== (.-Op v) ssa/OpS390XMOVDconst))
          ;; The "mark" is any non-nil Aux value.
          (set! (.-Aux v) ssa/AuxMark))

        (when (.IsFlags (.-Type v))
          (set! flive false))

        (range [_ a (.-Args v)]
          (when (.IsFlags (.-Type a))
            (set! flive true)))))))






^{:go/end 79} (go/func loadByType "loadByType returns the load instruction of the given type.\n" ^obj/As [^{:tag (* types/Type)} t]
  (if (.IsFloat t)
    (switch (.Size t)
      (case [4]
        (return s390x/AFMOVS))
      (case [8]
        (return s390x/AFMOVD)))


    (switch (.Size t)
      (case [1]
        (if (.IsSigned t)
          (return s390x/AMOVB)

          (return s390x/AMOVBZ)))

      (case [2]
        (if (.IsSigned t)
          (return s390x/AMOVH)

          (return s390x/AMOVHZ)))

      (case [4]
        (if (.IsSigned t)
          (return s390x/AMOVW)

          (return s390x/AMOVWZ)))

      (case [8]
        (return s390x/AMOVD))))


  (panic "bad load type"))



^{:go/end 104} (go/func storeByType "storeByType returns the store instruction of the given type.\n" ^obj/As [^{:tag (* types/Type)} t]
  (let [width (.Size t)]
    (if (.IsFloat t)
      (switch width
        (case [4]
          (return s390x/AFMOVS))
        (case [8]
          (return s390x/AFMOVD)))


      (switch width
        (case [1]
          (return s390x/AMOVB))
        (case [2]
          (return s390x/AMOVH))
        (case [4]
          (return s390x/AMOVW))
        (case [8]
          (return s390x/AMOVD))))


    (panic "bad store type")))



^{:go/end 135} (go/func moveByType "moveByType returns the reg->reg move instruction of the given type.\n" ^obj/As [^{:tag (* types/Type)} t]
  (if (.IsFloat t)
    (return s390x/AFMOVD)

    (switch (.Size t)
      (case [1]
        (if (.IsSigned t)
          (return s390x/AMOVB)

          (return s390x/AMOVBZ)))

      (case [2]
        (if (.IsSigned t)
          (return s390x/AMOVH)

          (return s390x/AMOVHZ)))

      (case [4]
        (if (.IsSigned t)
          (return s390x/AMOVW)

          (return s390x/AMOVWZ)))

      (case [8]
        (return s390x/AMOVD))))


  (panic "bad move type"))








^{:go/end 150} (go/func opregreg "opregreg emits instructions for\n\n\tdest := dest(To) op src(From)\n\nand also returns the created obj.Prog so it\nmay be further adjusted (offset, scale, etc).\n" ^{:tag (* obj/Prog)} [^{:tag (* ssagen/State)} s ^obj/As op ^int16 dest ^int16 src]

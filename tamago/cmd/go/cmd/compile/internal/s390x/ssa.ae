^{:go/end 166} (go/func opregregimm "opregregimm emits instructions for\n\n\tdest := src(From) op off\n\nand also returns the created obj.Prog so it\nmay be further adjusted (offset, scale, etc).\n" ^{:tag (* obj/Prog)} [^{:tag (* ssagen/State)} s ^obj/As op ^int16 dest ^int16 src ^int64 off]

            (set! (.-Type (.-From movd)) obj/TYPE_CONST)
            (set! (.-Offset (.-From movd)) 1)
            (set! (.-Type (.-To movd)) obj/TYPE_REG)
            (set! (.-Reg (.-To movd)) (.Reg0 v))

            ;; NOP (so the BNE has somewhere to land)
            (let [nop (.Prog s obj/ANOP)]
              (.SetTarget (.-To bne) nop))))))
    (case [ssa/OpS390XLoweredAtomicExchange32 ssa/OpS390XLoweredAtomicExchange64]
      ;; Loop until the CS{,G} succeeds.
      ;;     MOV{WZ,D} arg0, ret
      ;; cs: CS{,G}    ret, arg1, arg0
      ;;     BNE       cs

      ;; MOV{WZ,D} arg0, ret
      (let [load (.Prog s (loadByType (.FieldType (.-Type v) 0)))]
        (set! (.-Type (.-From load)) obj/TYPE_MEM)
        (set! (.-Reg (.-From load)) (.Reg (aget (.-Args v) 0)))
        (set! (.-Type (.-To load)) obj/TYPE_REG)
        (set! (.-Reg (.-To load)) (.Reg0 v))
        (ssagen/AddAux (addr (.-From load)) v)

        ;; CS{,G} ret, arg1, arg0
        (let [cs (.Prog s (.Asm (.-Op v)))]
          (set! (.-Type (.-From cs)) obj/TYPE_REG)
          (set! (.-Reg (.-From cs)) (.Reg0 v)) ; old
          (set! (.-Reg cs) (.Reg (aget (.-Args v) 1))) ; new
          (set! (.-Type (.-To cs)) obj/TYPE_MEM)
          (set! (.-Reg (.-To cs)) (.Reg (aget (.-Args v) 0)))
          (ssagen/AddAux (addr (.-To cs)) v)

          ;; BNE cs
          (let [bne (.Prog s s390x/ABNE)]
            (set! (.-Type (.-To bne)) obj/TYPE_BRANCH)
            (.SetTarget (.-To bne) cs)))))
    (case [ssa/OpS390XSYNC]
      (.Prog s s390x/ASYNC))
    (case [ssa/OpClobber ssa/OpClobberReg])
    ;; TODO: implement for clobberdead experiment. Nop is ok for now.
    (default
      (.Fatalf v "genValue not implemented: %s" (.LongString v)))))



^{:go/end 984} (go/func blockAsm ^obj/As [^{:tag (* ssa/Block)} b]
  (switch (.-Kind b)
    (case [ssa/BlockS390XBRC]
      (return s390x/ABRC))
    (case [ssa/BlockS390XCRJ]
      (return s390x/ACRJ))
    (case [ssa/BlockS390XCGRJ]
      (return s390x/ACGRJ))
    (case [ssa/BlockS390XCLRJ]
      (return s390x/ACLRJ))
    (case [ssa/BlockS390XCLGRJ]
      (return s390x/ACLGRJ))
    (case [ssa/BlockS390XCIJ]
      (return s390x/ACIJ))
    (case [ssa/BlockS390XCGIJ]
      (return s390x/ACGIJ))
    (case [ssa/BlockS390XCLIJ]
      (return s390x/ACLIJ))
    (case [ssa/BlockS390XCLGIJ]
      (return s390x/ACLGIJ)))

  (.Fatalf b "blockAsm not implemented: %s" (.LongString b))
  (panic "unreachable"))


^{:go/end 1045} (go/func ssaGenBlock [^{:tag (* ssagen/State)} s ^{:tag (* ssa/Block)} b ^{:tag (* ssa/Block)} next]
  ;; Handle generic blocks first.
  (switch (.-Kind b)
    (case [ssa/BlockPlain ssa/BlockDefer]
      (when (!= (.Block (aget (.-Succs b) 0)) next)
        (let [p (.Prog s s390x/ABR)]
          (set! (.-Type (.-To p)) obj/TYPE_BRANCH)
          (set! (.-Branches s) (append (.-Branches s) (lit ssagen/Branch :P p :B (.Block (aget (.-Succs b) 0)))))))

      (return))
    (case [ssa/BlockExit ssa/BlockRetJmp]
      (return))
    (case [ssa/BlockRet]
      (.Prog s obj/ARET)
      (return)))


  ;; Handle s390x-specific blocks. These blocks all have a
  ;; condition code mask in the Aux value and 2 successors.
  (let [succs (lit (array ... (* ssa/Block)) (.Block (aget (.-Succs b) 0)) (.Block (aget (.-Succs b) 1)))
      ^{:line 1006} mask (assert s390x/CCMask (.-Aux b))]

    ;; TODO: take into account Likely property for forward/backward
    ;; branches. We currently can't do this because we don't know
    ;; whether a block has already been emitted. In general forward
    ;; branches are assumed 'not taken' and backward branches are
    ;; assumed 'taken'.
    (when (== next (aget succs 0))
      (set! (values (aget succs 0) (aget succs 1)) (values (aget succs 1) (aget succs 0)))
      (set! mask (.Inverse mask)))


    (let [p (.Br s (blockAsm b) (aget succs 0))]
      (switch (.-Kind b)
        (case [ssa/BlockS390XBRC]
          (set! (.-Type (.-From p)) obj/TYPE_CONST)
          (set! (.-Offset (.-From p)) (conv int64 mask)))
        (case [ssa/BlockS390XCGRJ ssa/BlockS390XCRJ
            ^{:line 1024} ssa/BlockS390XCLGRJ ssa/BlockS390XCLRJ]
          (set! (.-Type (.-From p)) obj/TYPE_CONST)
          (set! (.-Offset (.-From p)) (conv int64 (bit-and mask s390x/NotUnordered))) ; unordered is not possible
          (set! (.-Reg p) (.Reg (aget (.-Controls b) 0)))
          (.AddRestSourceReg p (.Reg (aget (.-Controls b) 1))))
        (case [ssa/BlockS390XCGIJ ssa/BlockS390XCIJ]
          (set! (.-Type (.-From p)) obj/TYPE_CONST)
          (set! (.-Offset (.-From p)) (conv int64 (bit-and mask s390x/NotUnordered))) ; unordered is not possible
          (set! (.-Reg p) (.Reg (aget (.-Controls b) 0)))
          (.AddRestSourceConst p (conv int64 (conv int8 (.-AuxInt b)))))
        (case [ssa/BlockS390XCLGIJ ssa/BlockS390XCLIJ]
          (set! (.-Type (.-From p)) obj/TYPE_CONST)
          (set! (.-Offset (.-From p)) (conv int64 (bit-and mask s390x/NotUnordered))) ; unordered is not possible
          (set! (.-Reg p) (.Reg (aget (.-Controls b) 0)))
          (.AddRestSourceConst p (conv int64 (conv uint8 (.-AuxInt b)))))
        (default
          (.Fatalf b "branch not implemented: %s" (.LongString b))))

      (when (!= next (aget succs 1))
        (.Br s s390x/ABR (aget succs 1))))))



^{:go/end 1056} (go/func loadRegResult ^{:tag (* obj/Prog)} [^{:tag (* ssagen/State)} s ^{:tag (* ssa/Func)} f ^{:tag (* types/Type)} t ^int16 reg ^{:tag (* ir/Name)} n ^int64 off]
  (let [p (.Prog s (loadByType t))]
    (set! (.-Type (.-From p)) obj/TYPE_MEM)
    (set! (.-Name (.-From p)) obj/NAME_AUTO)
    (set! (.-Sym (.-From p)) (.Linksym n))
    (set! (.-Offset (.-From p)) (+ (.FrameOffset n) off))
    (set! (.-Type (.-To p)) obj/TYPE_REG)
    (set! (.-Reg (.-To p)) reg)
    ^{:line 1055} p))


^{:go/end 1064} (go/func spillArgReg ^{:tag (* obj/Prog)} [^{:tag (* objw/Progs)} pp ^{:tag (* obj/Prog)} p ^{:tag (* ssa/Func)} f ^{:tag (* types/Type)} t ^int16 reg ^{:tag (* ir/Name)} n ^int64 off]
  (set! p (.Append pp p (storeByType t) obj/TYPE_REG reg 0 obj/TYPE_MEM 0 (+ (.FrameOffset n) off)))
  (set! (.-Name (.-To p)) obj/NAME_PARAM)
  (set! (.-Sym (.-To p)) (.Linksym n))
  (set! (.-Pos p) (.WithNotStmt (.-Pos p)))
  ^{:line 1063} p)

    (set! (.-Type (.-From p)) obj/TYPE_CONST)
    (set! (.-Offset (.-From p)) off)
    (set! (.-Reg p) src)
    (set! (.-Reg (.-To p)) dest)
    (set! (.-Type (.-To p)) obj/TYPE_REG)
    ^{:line 165} p))



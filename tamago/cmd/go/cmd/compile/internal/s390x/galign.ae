(in-ns 'go.cmd.compile.internal.s390x) (go/file "galign.go" :imports [


    ^{:line 8} [ssagen "cmd/compile/internal/ssagen"]
    ^{:line 9} [s390x "cmd/internal/obj/s390x"]])


^{:go/end 25} (go/func Init [^{:tag (* ssagen/ArchInfo)} arch]
  (set! (.-LinkArch arch) (addr s390x/Links390x))
  (set! (.-REGSP arch) s390x/REGSP)
  (set! (.-MAXWIDTH arch) (<< 1 50))

  (set! (.-ZeroRange arch) zerorange)
  (set! (.-Ginsnop arch) ginsnop)

  (set! (.-SSAMarkMoves arch) ssaMarkMoves)
  (set! (.-SSAGenValue arch) ssaGenValue)
  (set! (.-SSAGenBlock arch) ssaGenBlock)
  (set! (.-LoadRegResult arch) loadRegResult)
  (set! (.-SpillArgReg arch) spillArgReg))

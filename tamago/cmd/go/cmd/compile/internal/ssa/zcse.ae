(in-ns 'go.cmd.compile.internal.ssa) (go/file "zcse.go" :imports [

    ^{:line 7} [types "cmd/compile/internal/types"]])






^{:go/end 54} (go/func zcse "zcse does an initial pass of common-subexpression elimination on the\nfunction for values with zero arguments to allow the more expensive cse\nto begin with a reduced number of values. Values are just relinked,\nnothing is deleted. A subsequent deadcode pass is required to actually\nremove duplicate expressions.\n" [^{:tag (* Func)} f]
  (let [vals (make (map vkey (* Value)))]

    (range [_ b (.-Blocks f)]
      (for [i 0] (< i (len (.-Values b))) (inc! i)
        (let [v (aget (.-Values b) i)]
          (when (== (.-argLen (aget opcodeTable (.-Op v))) 0)
            (let [key (lit vkey (.-Op v) (keyFor v) (.-Aux v) (.-Type v))]
              (when (== (aget vals key) nil)
                (aset vals key v)
                (when (!= b (.-Entry f))
                  ;; Move v to the entry block so it will dominate every block
                  ;; where we might use it. This prevents the need for any dominator
                  ;; calculations in this pass.
                  (set! (.-Block v) (.-Entry f))
                  (set! (.-Values (.-Entry f)) (append (.-Values (.-Entry f)) v))
                  (let [last (- (len (.-Values b)) 1)]
                    (aset (.-Values b) i (aget (.-Values b) last))
                    (aset (.-Values b) last nil)
                    (set! (.-Values b) (subslice (.-Values b) _ last))

                    (dec! i))))))))) ; process b.Values[i] again






    (range [_ b (.-Blocks f)]
      (range [_ v (.-Values b)]
        (range [i a (.-Args v)]
          (when (== (.-argLen (aget opcodeTable (.-Op a))) 0)
            (let [key (lit vkey (.-Op a) (keyFor a) (.-Aux a) (.-Type a))]
              (when [(values rv ok) (aget vals key)] ok
                (.SetArg v i rv)))))))))








(go/type vkey "vkey is a type used to uniquely identify a zero arg value.\n" (struct
    ^{:line 58 :tag Op} op
    ^{:line 59 :tag int64} ai ; aux int
    ^{:line 60 :tag Aux} ax ; aux
    ^{:line 61 :tag (* types/Type)} t)) ; type




^{:go/end 79} (go/func keyFor "keyFor returns the AuxInt portion of a  key structure uniquely identifying a\nzero arg value for the supported ops.\n" ^int64 [^{:tag (* Value)} v]
  (switch (.-Op v)
    (case [OpConst64 OpConst64F OpConst32F]
      (return (.-AuxInt v)))
    (case [OpConst32]
      (return (conv int64 (conv int32 (.-AuxInt v)))))
    (case [OpConst16]
      (return (conv int64 (conv int16 (.-AuxInt v)))))
    (case [OpConst8 OpConstBool]
      (return (conv int64 (conv int8 (.-AuxInt v)))))
    (default
      (return (.-AuxInt v)))))

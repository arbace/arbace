                      (inc! pidx))))))))))))







^{:go/end 1888} (go/func IsVarWantedForDebug "IsVarWantedForDebug returns true if the debug info for the node should\nbe generated.\nFor example, internal variables for range-over-func loops have little\nvalue to users, so we don't generate debug info for them.\n" ^bool [^ir/Node n]
  ^{:go/breaks [[4 1887]]} (let [name (.-Name (.Sym n))]
    (when (and (> (len name) 0) (== (aget name 0) \&))
      (set! name (subslice name 1)))

    (when (and (> (len name) 0) (== (aget name 0) \#))
      ;; #yield is used by delve.
      (return (strings/HasPrefix name "#yield")))

    true))

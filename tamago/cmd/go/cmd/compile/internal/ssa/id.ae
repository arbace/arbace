(in-ns 'go.cmd.compile.internal.ssa) (go/file "id.go" :imports [])

(go/type ID int32)


(go/type idAlloc "idAlloc provides an allocator for unique integers.\n" (struct
    ^{:line 11 :tag ID} last))



^{:go/end 23} (go/method get "get allocates an ID and returns it. IDs are always > 0.\n" ^ID [^{:tag (* idAlloc)} a]
  (let [x (.-last a)]
    (inc! x)
    (when (== x (- (<< 1 31) 1))
      (panic "too many ids for this function"))

    (set! (.-last a) x)
    ^{:line 22} x))



^{:go/end 28} (go/method num "num returns the maximum ID ever returned + 1.\n" ^int [^{:tag (* idAlloc)} a]
  (conv int (+ (.-last a) 1)))

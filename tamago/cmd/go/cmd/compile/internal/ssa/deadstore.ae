^{:go/end 238} (go/method add [^{:tag (* shadowRanges)} sr ^int64 lo ^int64 hi]
  ;; Ignore the store if:
  ;; - the range doesn't fit in 16 bits, or
  ;; - we already track maxShadowRanges intervals.
  ;; The cap prevents a theoretical O(n^2) blow-up.
  (when (or (< lo 0) (> hi 0xffff) (>= (len (.-ranges sr)) maxShadowRanges))
    (return))

  (let [nlo lo
      ^{:line 222} nhi hi
      ^{:line 223} out (subslice (.-ranges sr) _ 0)]

    (range [_ r (.-ranges sr)]
      (when (or (< nhi (conv int64 (.-lo r))) (> nlo (conv int64 (.-hi r))))
        (set! out (append out r))
        (continue))

      (when (< (conv int64 (.-lo r)) nlo)
        (set! nlo (conv int64 (.-lo r))))

      (when (> (conv int64 (.-hi r)) nhi)
        (set! nhi (conv int64 (.-hi r)))))


    (set! (.-ranges sr) (append out (lit shadowRange (conv uint16 nlo) (conv uint16 nhi))))))







^{:go/end 484} (go/func elimUnreadAutos "elimUnreadAutos deletes stores (and associated bookkeeping ops VarDef and VarKill)\nto autos that are never read from.\n" [^{:tag (* Func)} f]
  ;; Loop over all ops that affect autos taking note of which
  ;; autos we need and also stores that we might be able to
  ;; eliminate.
  (let [^ir/NameSet seen (zero ir/NameSet)
      ^{:line 438 :tag (slice (* Value))} stores (zero (slice (* Value)))]

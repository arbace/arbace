            (continue))

          (when (and (!= (.-Class n) ir/PAUTO) (not (isABIInternalParam f n)))
            (continue))


          (let [effect (.SymEffect (.-Op v))]
            (switch effect
              (case [SymNone SymWrite]
                ;; If we haven't seen the auto yet
                ;; then this might be a store we can
                ;; eliminate.
                (when (not (.Has seen n))
                  (set! stores (append stores v))))

              (default
                ;; Assume the auto is needed (loaded,
                ;; has its address taken, etc.).
                ;; Note we have to check the uses
                ;; because dead loads haven't been
                ;; eliminated yet.
                (when (> (.-Uses v) 0)

            (.clear storeUse)
            (clear localAddrs)
            (set! stores (subslice stores _ 0))
            (range [_ v (.-Values b)]
              (when (== (.-Op v) OpPhi)
                ;; Ignore phis - they will always be first and can't be eliminated
                (continue))

              (if (.IsMemory (.-Type v)) (do
                  (set! stores (append stores v))
                  (range [_ a (.-Args v)]
                    (when (and (== (.-Block a) b) (.IsMemory (.-Type a)))
                      (.add storeUse (.-ID a))
                      (switch (.-Op v)
                        (case [OpStore OpZero OpVarDef])
                        ;; These ops never read from their memory input.
                        (case [OpMove]
                          ;; This op reads from its memory argument, but
                          ;; we can treat it as not doing so if we know
                          ;; the read is from read-only memory.
                          (when (and (== (.-Op (aget (.-Args v) 1)) OpAddr) (symIsRO (auxToSym (.-Aux (aget (.-Args v) 1)))))
                            (break))

                          (fallthrough))

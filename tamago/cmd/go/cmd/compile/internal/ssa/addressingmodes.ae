(in-ns 'go.cmd.compile.internal.ssa) (go/file "addressingmodes.go" :imports [])



^{:go/end 101} (go/func addressingModes "addressingModes combines address calculations into memory operations\nthat can perform complicated addressing modes.\n" [^{:tag (* Func)} f]
  (let [isInImmediateRange is32Bit]
    (switch (.-arch (.-Config f))
      (default
        ;; Most architectures can't do this.
        (return))
      (case ["amd64" "386"])
      (case ["s390x"]
        (set! isInImmediateRange is20Bit)))


    (let [^{:tag (slice (* Value))} tmp (zero (slice (* Value)))]
      (range [_ b (.-Blocks f)]
        (range [_ v (.-Values b)]
          (when (not (aget combineFirst (.-Op v)))
            (continue))

          ;; All matched operations have the pointer in arg[0].
          ;; All results have the pointer in arg[0] and the index in arg[1].
          ;; *Except* for operations which update a register,
          ;; which are marked with resultInArg0. Those have
          ;; the pointer in arg[1], and the corresponding result op
          ;; has the pointer in arg[1] and the index in arg[2].
          (let [ptrIndex 0]
            (when (.-resultInArg0 (aget opcodeTable (.-Op v)))
              (set! ptrIndex 1))

            (let [p (aget (.-Args v) ptrIndex)
                (values c ok) (aget combine (lit (array 2 Op) (.-Op v) (.-Op p)))]
              (when (not ok)
                (continue))

              ;; See if we can combine the Aux/AuxInt values.
              (switch (lit (array 2 auxType) (.-auxType (aget opcodeTable (.-Op v))) (.-auxType (aget opcodeTable (.-Op p))))
                (case [(lit (array 2 auxType) auxSymOff auxInt32)]
                  ;; TODO: introduce auxSymOff32
                  (when (not (isInImmediateRange (+ (.-AuxInt v) (.-AuxInt p))))
                    (continue))

                  (set! (.-AuxInt v) + (.-AuxInt p)))
                (case [(lit (array 2 auxType) auxSymOff auxSymOff)]
                  (when (and (!= (.-Aux v) nil) (!= (.-Aux p) nil))
                    (continue))

                  (when (not (isInImmediateRange (+ (.-AuxInt v) (.-AuxInt p))))
                    (continue))

                  (when (!= (.-Aux p) nil)
                    (set! (.-Aux v) (.-Aux p)))

                  (set! (.-AuxInt v) + (.-AuxInt p)))
                (case [(lit (array 2 auxType) auxSymValAndOff auxInt32)]
                  (let [vo (conv ValAndOff (.-AuxInt v))]
                    (when (not (.canAdd64 vo (.-AuxInt p)))
                      (continue))

                    (set! (.-AuxInt v) (conv int64 (.addOffset64 vo (.-AuxInt p))))))
                (case [(lit (array 2 auxType) auxSymValAndOff auxSymOff)]
                  (let [vo (conv ValAndOff (.-AuxInt v))]
                    (when (and (!= (.-Aux v) nil) (!= (.-Aux p) nil))
                      (continue))

                    (when (not (.canAdd64 vo (.-AuxInt p)))
                      (continue))

                    (when (!= (.-Aux p) nil)
                      (set! (.-Aux v) (.-Aux p)))

                    (set! (.-AuxInt v) (conv int64 (.addOffset64 vo (.-AuxInt p))))))
                (case [(lit (array 2 auxType) auxSymOff auxNone)])
                ;; nothing to do
                (case [(lit (array 2 auxType) auxSymValAndOff auxNone)])
                ;; nothing to do
                (default
                  (.Fatalf f "unknown aux combining for %s and %s\n" (.-Op v) (.-Op p))))

              ;; Combine the operations.
              (set! tmp (append (subslice tmp _ 0) (spread (subslice (.-Args v) _ ptrIndex))))
              (set! tmp (append tmp (spread (.-Args p))))
              (set! tmp (append tmp (spread (subslice (.-Args v) (+ ptrIndex 1)))))
              (.resetArgs v)
              (set! (.-Op v) c)
              (.AddArgs v (spread tmp))
              (when (aget needSplit c)
                ;; It turns out that some of the combined instructions have faster two-instruction equivalents,
                ;; but not the two instructions that led to them being combined here.  For example
                ;; (CMPBconstload c (ADDQ x y)) -> (CMPBconstloadidx1 c x y) -> (CMPB c (MOVBloadidx1 x y))
                ;; The final pair of instructions turns out to be notably faster, at least in some benchmarks.
                ((.-splitLoad (.-Config f)) v)))))))))







(go/var ^{:doc "combineFirst contains ops which appear in combine as the\nfirst part of the key.\n"} combineFirst (lit (map Op bool)))

^{:go/end 111} (go/func init []
  (range [k combine]
    (aset combineFirst (aget k 0) true)))





(go/var ^{:doc "needSplit contains instructions that should be postprocessed by splitLoad\ninto a more-efficient two-instruction form.\n"} needSplit (lit (map Op bool)
    ^{:line 116} [OpAMD64CMPBloadidx1 true]
    ^{:line 117} [OpAMD64CMPWloadidx1 true]
    ^{:line 118} [OpAMD64CMPLloadidx1 true]
    ^{:line 119} [OpAMD64CMPQloadidx1 true]
    ^{:line 120} [OpAMD64CMPWloadidx2 true]
    ^{:line 121} [OpAMD64CMPLloadidx4 true]
    ^{:line 122} [OpAMD64CMPQloadidx8 true]

    ^{:line 124} [OpAMD64CMPBconstloadidx1 true]

^{:go/end 103} (go/method String ^string [^{:tag (* regInfo)} r]
  (let [s ""]
    (set! s + "INS:\n")
    (range [_ i (.-inputs r)]
      (let [mask (fmt/Sprintf "%64b" (.-regs i))]
        (set! mask (strings/ReplaceAll mask "0" "."))
        (set! s + (fmt/Sprintf "%2d |%s|\n" (.-idx i) mask))))

    (set! s + "OUTS:\n")
    (range [_ i (.-outputs r)]
      (let [mask (fmt/Sprintf "%64b" (.-regs i))]
        (set! mask (strings/ReplaceAll mask "0" "."))
        (set! s + (fmt/Sprintf "%2d |%s|\n" (.-idx i) mask))))

    (set! s + "CLOBBERS:\n")
    (let [mask (fmt/Sprintf "%64b" (.-clobbers r))]
      (set! mask (strings/ReplaceAll mask "0" "."))
      (set! s + (fmt/Sprintf "   |%s|\n" mask))
      ^{:line 102} s)))



^{:go/end 168} (go/method Reg "Reg returns the regInfo for a given call, combining the derived in/out register masks\nwith the machine-specific register information in the input i.  (The machine-specific\nregInfo is much handier at the call site than it is when the AuxCall is being constructed,\ntherefore do this lazily).\n\nTODO: there is a Clever Hack that allows pre-generation of a small-ish number of the slices\nof inputInfo and outputInfo used here, provided that we are willing to reorder the inputs\nand outputs from calls, so that all integer registers come first, then all floating registers.\nAt this point (active development of register ABI) that is very premature,\nbut if this turns out to be a cost, we could do it.\n" ^{:tag (* regInfo)} [^{:tag (* AuxCall)} a ^{:tag (* regInfo)} i ^{:tag (* Config)} c]
  (when (not (.empty (.-clobbers (.-reg a))))
    ;; Already updated
    (return (.-reg a)))

  (when (== (+ (.InRegistersUsed (.-abiInfo a)) (.OutRegistersUsed (.-abiInfo a))) 0)
    ;; Shortcut for zero case, also handles old ABI.
    (set! (.-reg a) i)
    (return (.-reg a)))


  (let [k (len (.-inputs i))]
    (range [_ p (.InParams (.-abiInfo a))]
      (range [_ r (.-Registers p)]
        (let [m (archRegForAbiReg r c)]
          (set! (.-inputs (.-reg a)) (append (.-inputs (.-reg a)) (lit inputInfo :idx k :regs (regMaskAt (conv register m)))))
          (inc! k))))


    (set! (.-inputs (.-reg a)) (append (.-inputs (.-reg a)) (spread (.-inputs i)))) ; These are less constrained, thus should come last
    (set! k (len (.-outputs i)))
    (range [_ p (.OutParams (.-abiInfo a))]
      (range [_ r (.-Registers p)]
        (let [m (archRegForAbiReg r c)]
          (set! (.-outputs (.-reg a)) (append (.-outputs (.-reg a)) (lit outputInfo :idx k :regs (regMaskAt (conv register m)))))
          (inc! k))))


    (set! (.-outputs (.-reg a)) (append (.-outputs (.-reg a)) (spread (.-outputs i))))
    (set! (.-clobbers (.-reg a)) (.-clobbers i))
    (.-reg a)))


    ^{:line 31 :tag obj/As} asm
    ^{:line 32 :tag bool} generic ; this is a generic (arch-independent) opcode
    ^{:line 33 :tag bool} rematerializeable ; this op is rematerializeable
    ^{:line 34 :tag bool} commutative ; this operation is commutative (e.g. addition)
    ^{:line 35 :tag bool} resultInArg0 ; (first, if a tuple) output of v and v.Args[0] must be allocated to the same register
    ^{:line 36 :tag bool} resultNotInArgs ; outputs must not be allocated to the same registers as inputs
    ^{:line 37 :tag bool} clobberFlags ; this op clobbers flags register
    ^{:line 38 :tag bool} needIntTemp ; need a temporary free integer register
    ^{:line 39 :tag bool} call ; is a function call
    ^{:line 40 :tag bool} tailCall ; is a tail call
    ^{:line 41 :tag bool} nilCheck ; this op is a nil check on arg0
    ^{:line 42 :tag bool} faultOnNilArg0 ; this op will fault if arg0 is nil (and aux encodes a small offset)
    ^{:line 43 :tag bool} faultOnNilArg1 ; this op will fault if arg1 is nil (and aux encodes a small offset)
    ^{:line 44 :tag bool} usesScratch ; this op requires scratch memory space
    ^{:line 45 :tag bool} hasSideEffects ; for "reasons", not to be eliminated.  E.g., atomic store, #19182.
    ^{:line 46 :tag bool} zeroWidth ; op never translates into any machine code. example: copy, which may sometimes translate to machine code, is not zero-width.
    ^{:line 47 :tag bool} unsafePoint ; this op is an unsafe point, i.e. not safe for async preemption
    ^{:line 48 :tag bool} fixedReg ; this op will be assigned a fixed register
    ^{:line 49 :tag bool} earlyOk ; executing this op in an earlier block is ok
    ^{:line 50 :tag bool} addrSinkArg0 ; the address in arg0 does not propagate to the result
    ^{:line 51 :tag bool} addrSinkArg1 ; the address in arg1 does not propagate to the result

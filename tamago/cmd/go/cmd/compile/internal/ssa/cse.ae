^{:go/end 458} (go/func cmpVal ^types/Cmp [^{:tag (* Value)} v ^{:tag (* Value)} w ^auxmap auxIDs]
  ;; Try to order these comparison by cost (cheaper first)
  (when (!= (.-Op v) (.-Op w))
    (return (lt2Cmp (< (.-Op v) (.-Op w)))))

  (when (!= (.-AuxInt v) (.-AuxInt w))
    (return (lt2Cmp (< (.-AuxInt v) (.-AuxInt w)))))

  (when (!= (len (.-Args v)) (len (.-Args w)))
    (return (lt2Cmp (< (len (.-Args v)) (len (.-Args w))))))

  (when (and (== (.-Op v) OpPhi) (!= (.-Block v) (.-Block w)))
    (return (lt2Cmp (< (.-ID (.-Block v)) (.-ID (.-Block w))))))

  (when (.IsMemory (.-Type v))
    ;; We will never be able to CSE two values
    ;; that generate memory.
    (return (lt2Cmp (< (.-ID v) (.-ID w)))))

  ;; OpSelect is a pseudo-op. We need to be more aggressive
  ;; regarding CSE to keep multiple OpSelect's of the same
  ;; argument from existing.
  (when (and (!= (.-Op v) OpSelect0) (!= (.-Op v) OpSelect1) (!= (.-Op v) OpSelectN))
    (when [tc (.Compare (.-Type v) (.-Type w))] (!= tc types/CMPeq)
      (return tc)))



  (when (!= (.-Aux v) (.-Aux w))
    (when (== (.-Aux v) nil)
      (return types/CMPlt))

    (when (== (.-Aux w) nil)
      (return types/CMPgt))

    (return (lt2Cmp (< (aget auxIDs (.-Aux v)) (aget auxIDs (.-Aux w))))))



^{:go/end 357} (go/func storeOrdering "storeOrdering computes the order for stores by iterate over the store\nchain, assigns a score to each store. The scores only make sense for\nstores within the same block, and the first store by store order has\nthe lowest score. The cache was used to ensure only compute once.\n" ^int32 [^{:tag (* Value)} v ^{:tag (slice int32)} cache]
  (let [^:const ^{:tag int32 :val 1} minScore 1
      ^{:line 330} score minScore
      ^{:line 331} w v]
    (while true
      (when [s (aget cache (.-ID w))] (>= s minScore)
        (set! score + s)
        (break))

      (when (or (== (.-Op w) OpPhi) (== (.-Op w) OpInitMem))
        (break))

      (let [a (.MemoryArg w)]
        (when (!= (.-Block a) (.-Block w))
          (break))

        (set! w a)
        (inc! score)))

    (set! w v)
    (while (== (aget cache (.-ID w)) 0)
      (aset cache (.-ID w) score)
      (when (== score minScore)
        (break))

      (set! w (.MemoryArg w))
      (dec! score))

    (aget cache (.-ID v))))





(go/type eqclass "An eqclass approximates an equivalence class. During the\nalgorithm it may represent the union of several of the\nfinal equivalence classes.\n" (slice (* Value)))

















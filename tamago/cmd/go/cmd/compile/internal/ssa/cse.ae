        (let [^ID pNum 1]
          (range [_ e partition]
            (when (and (> (.-debug (.-pass f)) 1) (> (len e) 500))
              (fmt/Printf "CSE.large partition (%d): " (len e))
              (for [j 0] (< j 3) (inc! j)

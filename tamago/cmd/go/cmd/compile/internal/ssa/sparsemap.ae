(in-ns 'go.cmd.compile.internal.ssa) (go/file "sparsemap.go" :imports [])

;; from https://research.swtch.com/sparse
;; in turn, from Briggs and Torczon


(go/type sparseKey "sparseKey needs to be something we can index a slice with.\n" (interface (| (tilde int) (tilde int32))))

(go/type sparseEntry :type-params [^sparseKey K V] (struct
    ^{:line 14 :tag K} key
    ^{:line 15 :tag V} val))


(go/type genericSparseMap :type-params [^sparseKey K V] (struct
    ^{:line 19 :tag (slice (sparseEntry K V))} dense
    ^{:line 20 :tag (slice int32)} sparse))




^{:go/end 27} (go/func newGenericSparseMap "newGenericSparseMap returns a sparseMap that can map\nintegers between 0 and n-1 to a value type.\n" :type-params [^sparseKey K V] ^{:tag (* (genericSparseMap K V))} [^int n]
  (addr (lit (genericSparseMap K V) :dense nil :sparse (make (slice int32) n))))


^{:go/end 31} (go/method cap ^int [^{:tag (* (genericSparseMap K V))} s]
  (len (.-sparse s)))


^{:go/end 35} (go/method size ^int [^{:tag (* (genericSparseMap K V))} s]
  (len (.-dense s)))


^{:go/end 40} (go/method contains ^bool [^{:tag (* (genericSparseMap K V))} s ^K k]
  (let [i (aget (.-sparse s) k)]
    (and (< i (conv int32 (len (.-dense s)))) (== (.-key (aget (.-dense s) i)) k))))




^{:go/end 51} (go/method get "get returns the value for key k, or the zero V\nif k does not appear in the map.\n" [^{:tag (* (genericSparseMap K V))} s ^K k] :results [V bool]
  (let [i (aget (.-sparse s) k)]
    (when (and (< i (conv int32 (len (.-dense s)))) (== (.-key (aget (.-dense s) i)) k))
      (return (.-val (aget (.-dense s) i)) true))

    (let [^V v (zero V)]
      (return v false))))


^{:go/end 61} (go/method set [^{:tag (* (genericSparseMap K V))} s ^K k ^V v]
  (let [i (aget (.-sparse s) k)]
    (when (and (< i (conv int32 (len (.-dense s)))) (== (.-key (aget (.-dense s) i)) k))
      (set! (.-val (aget (.-dense s) i)) v)
      (return))

    (set! (.-dense s) (append (.-dense s) (lit (sparseEntry K V) k v)))
    (aset (.-sparse s) k (- (conv int32 (len (.-dense s))) 1))))


^{:go/end 71} (go/method remove [^{:tag (* (genericSparseMap K V))} s ^K k]
  (let [i (aget (.-sparse s) k)]
    (when (and (< i (conv int32 (len (.-dense s)))) (== (.-key (aget (.-dense s) i)) k))
      (let [y (aget (.-dense s) (- (len (.-dense s)) 1))]
        (aset (.-dense s) i y)
        (aset (.-sparse s) (.-key y) i)
        (set! (.-dense s) (subslice (.-dense s) _ (- (len (.-dense s)) 1)))))))



^{:go/end 75} (go/method clear [^{:tag (* (genericSparseMap K V))} s]
  (set! (.-dense s) (subslice (.-dense s) _ 0)))


^{:go/end 79} (go/method contents ^{:tag (slice (sparseEntry K V))} [^{:tag (* (genericSparseMap K V))} s]
  (.-dense s))


(go/type ^:alias sparseMap (genericSparseMap ID int32))



^{:go/end 87} (go/func newSparseMap "newSparseMap returns a sparseMap that can map\nintegers between 0 and n-1 to int32s.\n" ^{:tag (* sparseMap)} [^int n]
  ((inst newGenericSparseMap ID int32) n))

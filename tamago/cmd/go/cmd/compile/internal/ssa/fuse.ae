^{:go/end 68} (go/func fuse "fuse simplifies control flow by joining basic blocks.\n" [^{:tag (* Func)} f ^fuseType typ]
  (for [changed true] changed _
    (set! changed false)
    ;; Be sure to avoid quadratic behavior in fuseBlockPlain. See issue 13554.
    ;; Previously this was dealt with using backwards iteration, now fuseBlockPlain
    ;; handles large runs of blocks.
    (for [i (- (len (.-Blocks f)) 1)] (>= i 0) (dec! i)
      (let [b (aget (.-Blocks f) i)]
        (when (!= (bit-and typ fuseTypeIf) 0)
          (set! changed (or (fuseBlockIf b) changed)))

        (when (!= (bit-and typ fuseTypeIntInRange) 0)
          (set! changed (or (fuseIntInRange b) changed)))

        (when (!= (bit-and typ fuseTypeSingleBitDifference) 0)
          (set! changed (or (fuseSingleBitDifference b) changed)))

        (when (!= (bit-and typ fuseTypeNanCheck) 0)
          (set! changed (or (fuseNanCheck b) changed)))

        (when (!= (bit-and typ fuseTypePlain) 0)
          (set! changed (or (fuseBlockPlain b) changed)))

        (when (!= (bit-and typ fuseTypeShortCircuit) 0)
          (set! changed (or (shortcircuitBlock b) changed)))))



    (when (!= (bit-and typ fuseTypeBranchRedirect) 0)
      (set! changed (or (fuseBranchRedirect f) changed)))

    (when changed
      (.invalidateCFG f))))























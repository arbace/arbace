              (when [(values pl ok) (.get pendingLines (.-Pos b))] (and ok (== pl (conv int32 (.-ID b))))
                (set! (.-Pos b) (.WithIsStmt (.-Pos b)))
                (.remove pendingLines (.-Pos b)))

              (.truncateValues b j))))))))




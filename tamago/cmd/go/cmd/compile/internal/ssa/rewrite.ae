                          ;; If value changed to a poor choice for a statement boundary, move the boundary
                          (when (== ^{:go/via [lico]} (.IsStmt (.-Pos v)) src/PosIsStmt)
                            (when [k (nextGoodStatementIndex v j b)] (!= k j)
                              (set! (.-Pos v) (.WithNotStmt (.-Pos v)))
                              (set! (.-Pos (aget (.-Values b) k)) (.WithIsStmt (.-Pos (aget (.-Values b) k)))))))




                        (set! change (or change vchange))
                        (when (and vchange (> debug 1))

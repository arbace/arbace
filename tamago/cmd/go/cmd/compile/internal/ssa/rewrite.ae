^{:go/end 2530} (go/func isARM64bitcon "isARM64bitcon reports whether a constant can be encoded into a logical instruction.\n" ^bool [^uint64 x]
  (when (or (== x (- (<< 1 64) 1)) (== x 0))
    (return false))

  ;; determine the period and sign-extend a unit to 64 bits
  (switch
    (case [(!= x (bit-or (>> x 32) (<< x 32)))])
    ;; period is 64
    ;; nothing to do
    (case [(!= x (bit-or (>> x 16) (<< x 48)))]
      ;; period is 32
      (set! x (conv uint64 (conv int64 (conv int32 x)))))
    (case [(!= x (bit-or (>> x 8) (<< x 56)))]
      ;; period is 16
      (set! x (conv uint64 (conv int64 (conv int16 x)))))
    (case [(!= x (bit-or (>> x 4) (<< x 60)))]
      ;; period is 8
      (set! x (conv uint64 (conv int64 (conv int8 x)))))
    (default
      ;; period is 4 or 2, always true
      ;; 0001, 0010, 0100, 1000 -- 0001 rotate
      ;; 0011, 0110, 1100, 1001 -- 0011 rotate
      ;; 0111, 1011, 1101, 1110 -- 0111 rotate
      ;; 0101, 1010             -- 01   rotate, repeat
      (return true)))

  (or (sequenceOfOnes x) (sequenceOfOnes (bit-not x))))




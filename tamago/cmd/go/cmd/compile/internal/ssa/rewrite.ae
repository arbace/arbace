^{:go/end 232} (go/func applyRewrite "deadcode indicates whether rewrite should try to remove any values that become dead.\n" [^{:tag (* Func)} f ^blockRewriter rb ^valueRewriter rv ^deadValueChoice deadcode]
  ;; repeat rewrites until we find no more rewrites
  (let [pendingLines (.-cachedLineStarts f)] ; Holds statement boundaries that need to be moved to a new value/block
    (.clear pendingLines)
    (let [debug (.-debug (.-pass f))]
      (when (> debug 1)
        (fmt/Printf "%s: rewriting for %s\n" (.-name (.-pass f)) (.-Name f)))

      ;; if the number of rewrite iterations reaches itersLimit we will
      ;; at that point turn on cycle detection. Instead of a fixed limit,
      ;; size the limit according to func size to allow for cases such
      ;; as the one in issue #66773.
      (let [itersLimit (.NumBlocks f)]
        (when (< itersLimit 20)
          (set! itersLimit 20))

        (let [^int iters (zero int)
            ^{:line 58 :tag (map string bool)} states (zero (map string bool))]
          (while true
            (when (> debug 1)
              (fmt/Printf "%s: iter %d\n" (.-name (.-pass f)) iters))

            (let [change false
                ^{:line 64} deadChange false]
              (range [_ b (.-Blocks f)]
                (let [^{:tag (* Block)} b0 (zero (* Block))]
                  (when (> debug 1)
                    (fmt/Printf "%s: start block\n" (.-name (.-pass f)))
                    (set! b0 (new Block))
                    (set! @b0 @b)
                    (set! (.-Succs b0) (append (lit (slice Edge)) (spread (.-Succs b))))) ; make a new copy, not aliasing

                  (range [i c (.ControlValues b)]
                    (while (== (.-Op c) OpCopy)
                      (set! c (aget (.-Args c) 0))
                      (.ReplaceControl b i c)))


                  (when (rb b)
                    (set! change true)
                    (when (> debug 1)
                      (fmt/Printf "rewriting %s  ->  %s\n" (.LongString b0) (.LongString b))))


                  (range [j v (.-Values b)]
                    (when (> debug 1)
                      (fmt/Printf "%s: consider %v\n" (.-name (.-pass f)) (.LongString v)))

                    (let [^{:tag (* Value)} v0 (zero (* Value))]
                      (when (> debug 1)
                        (set! v0 (new Value))
                        (set! @v0 @v)
                        (set! (.-Args v0) (append (lit (slice (* Value))) (spread (.-Args v))))) ; make a new copy, not aliasing

                      (when (and (== (.-Uses v) 0) (.removeable v))
                        (when (and (!= (.-Op v) OpInvalid) (== deadcode removeDeadValues))
                          ;; Reset any values that are now unused, so that we decrement
                          ;; the use count of all of its arguments.
                          ;; Not quite a deadcode pass, because it does not handle cycles.
                          ;; But it should help Uses==1 rules to fire.
                          (.reset v OpInvalid)

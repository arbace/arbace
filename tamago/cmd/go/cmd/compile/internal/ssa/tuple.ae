(in-ns 'go.cmd.compile.internal.ssa) (go/file "tuple.go" :imports [])








^{:go/end 71} (go/func tightenTupleSelectors "tightenTupleSelectors ensures that tuple selectors (Select0, Select1,\nand SelectN ops) are in the same block as their tuple generator. The\nfunction also ensures that there are no duplicate tuple selectors.\nThese properties are expected by the scheduler but may not have\nbeen maintained by the optimization pipeline up to this point.\n\nSee issues 16741 and 39472.\n" [^{:tag (* Func)} f]
  (let [selectors (make (map (struct
            ^{:line 16 :tag ID} id
            ^{:line 17 :tag int} which)
          (* Value)))]
    (range [_ b (.-Blocks f)]
      (range [_ selector (.-Values b)]
        ;; Key fields for de-duplication
        (let [^{:tag (* Value)} tuple (zero (* Value))
            ^{:line 23} idx 0]
          (switch (.-Op selector)
            (default
              (continue))
            (case [OpSelect1]
              (set! idx 1)
              (fallthrough))
            (case [OpSelect0]
              (set! tuple (aget (.-Args selector) 0))
              (when (not (.IsTuple (.-Type tuple)))
                (.Fatalf f "arg of tuple selector %s is not a tuple: %s" (.String selector) (.LongString tuple))))

            (case [OpSelectN]
              (set! tuple (aget (.-Args selector) 0))
              (set! idx (conv int (.-AuxInt selector)))
              (when (not (.IsResults (.-Type tuple)))
                (.Fatalf f "arg of result selector %s is not a results: %s" (.String selector) (.LongString tuple)))))



          ;; If there is a pre-existing selector in the target block then
          ;; use that. Do this even if the selector is already in the
          ;; target block to avoid duplicate tuple selectors.
          (let [key (lit (struct
                  ^{:line 47 :tag ID} id
                  ^{:line 48 :tag int} which)
                (.-ID tuple) idx)]
            (when [t (aget selectors key)] (!= t nil)
              (when (!= selector t)
                (.copyOf selector t))

              (continue))


            ;; If the selector is in the wrong block copy it into the target
            ;; block.
            (when (!= (.-Block selector) (.-Block tuple))
              (let [t (.copyInto selector (.-Block tuple))]
                (.copyOf selector t)
                (aset selectors key t)
                (continue)))


            ;; The selector is in the target block. Add it to the map so it
            ;; cannot be duplicated.
            (aset selectors key selector)))))))

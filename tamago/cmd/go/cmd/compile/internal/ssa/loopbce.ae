(in-ns 'go.cmd.compile.internal.ssa) (go/file "loopbce.go" :imports [


    ^{:line 8} [base "cmd/compile/internal/base"]
    ^{:line 9} [types "cmd/compile/internal/types"]
    ^{:line 10} [fmt "fmt"]])


(go/type indVarFlags uint8)

(go/const
  ^{:line 16} [^{:tag indVarFlags :val 1} indVarMinExc (<< 1 iota)] ; minimum value is exclusive (default: inclusive)
  ^{:line 17} [^{:val 2} indVarMaxInc]) ; maximum value is inclusive (default: exclusive)


(go/type indVar (struct
    ^{:line 21 :tag (* Value)} ind ; induction variable
    ^{:line 22 :tag (* Value)} nxt ; the incremented variable
    ^{:line 23 :tag (* Value)} min ; minimum value, inclusive/exclusive depends on flags
    ^{:line 24 :tag (* Value)} max ; maximum value, inclusive/exclusive depends on flags
    ^{:line 25 :tag (* Block)} entry ; the block where the edge from the succeeded comparison of the induction variable goes to, means when the bound check has passed.
    ^{:line 26 :tag int64} step ; it will always be positive.
    ^{:line 27 :tag indVarFlags} flags))
;; Invariant: for all blocks dominated by entry:
;;	min <= ind <  max    [if flags == 0]
;;	min <  ind <  max    [if flags == indVarMinExc]
;;	min <= ind <= max    [if flags == indVarMaxInc]
;;	min <  ind <= max    [if flags == indVarMinExc|indVarMaxInc]












^{:go/end 68} (go/func parseIndVar "parseIndVar checks whether the SSA value passed as argument is a valid induction\nvariable, and, if so, extracts:\n  - the minimum bound\n  - the increment value\n  - the \"next\" value (SSA value that is Phi'd into the induction variable every loop)\n  - the header's edge returning from the body\n\nCurrently, we detect induction variables that match (Phi min nxt),\nwith nxt being (Add inc ind).\nIf it can't parse the induction variable correctly, it returns (nil, nil, nil).\n" [^{:tag (* Value)} ind] :results [^{:tag (* Value)} min ^{:tag (* Value)} inc ^{:tag (* Value)} nxt ^Edge loopReturn]
  (when (!= (.-Op ind) OpPhi)
    (return))


  (if [n (aget (.-Args ind) 0)] (and ^:go/paren (or (== (.-Op n) OpAdd64) (== (.-Op n) OpAdd32) (== (.-Op n) OpAdd16) (== (.-Op n) OpAdd8)) ^:go/paren (or (== (aget (.-Args n) 0) ind) (== (aget (.-Args n) 1) ind)))
    (set! (values min nxt loopReturn) (values (aget (.-Args ind) 1) n (aget (.-Preds (.-Block ind)) 0)))
    (if [n (aget (.-Args ind) 1)] (and ^:go/paren (or (== (.-Op n) OpAdd64) (== (.-Op n) OpAdd32) (== (.-Op n) OpAdd16) (== (.-Op n) OpAdd8)) ^:go/paren (or (== (aget (.-Args n) 0) ind) (== (aget (.-Args n) 1) ind)))
      (set! (values min nxt loopReturn) (values (aget (.-Args ind) 0) n (aget (.-Preds (.-Block ind)) 1)))

      ;; Not a recognized induction variable.
      (return)))


  (cond (== (aget (.-Args nxt) 0) ind) ; nxt = ind + inc
    (set! inc (aget (.-Args nxt) 1))
    (== (aget (.-Args nxt) 1) ind) ; nxt = inc + ind
    (set! inc (aget (.-Args nxt) 0)) :else

    (panic "unreachable")) ; one of the cases must be true from the above.


  (return))

















































^{:go/end 358} (go/func findIndVar "findIndVar finds induction variables in a function.\n\nLook for variables and blocks that satisfy the following\n\n\t loop:\n\t   ind = (Phi min nxt),\n\t   if ind < max\n\t     then goto enter_loop\n\t     else goto exit_loop\n\n\t   enter_loop:\n\t\tdo something\n\t      nxt = inc + ind\n\t\tgoto loop\n\n\t exit_loop:\n\nWe may have more than one induction variables, the loop in the go\nsource code may looks like this:\n\n\tfor i >= 0 && j >= 0 {\n\t\t// use i and j\n\t\ti--\n\t\tj--\n\t}\n\nSo, also look for variables and blocks that satisfy the following\n\n\tloop:\n\t  i = (Phi maxi nxti)\n\t  j = (Phi maxj nxtj)\n\t  if i >= mini\n\t    then goto check_j\n\t    else goto exit_loop\n\n\tcheck_j:\n\t  if j >= minj\n\t    then goto enter_loop\n\t    else goto exit_loop\n\n\tenter_loop:\n\t  do something\n\t  nxti = i - di\n\t  nxtj = j - dj\n\t  goto loop\n\n\texit_loop:\n" ^{:tag (slice indVar)} [^{:tag (* Func)} f]
  (let [^{:tag (slice indVar)} iv (zero (slice indVar))
      ^{:line 119} sdom (.Sdom f)]

    (label :nextblock
      (range [_ b (.-Blocks f)]
        (when (!= (.-Kind b) BlockIf)
          (continue))

        (let [c (aget (.-Controls b) 0)]
          (range [idx 2]
            ;; Check that the control if it either ind </<= limit or limit </<= ind.
            ;; TODO: Handle unsigned comparisons?
            (let [inclusive false]
              (switch (.-Op c)
                (case [OpLeq64 OpLeq32 OpLeq16 OpLeq8]
                  (set! inclusive true))
                (case [OpLess64 OpLess32 OpLess16 OpLess8])
                (default
                  (continue :nextblock)))


              (let [less (== idx 0)
                  ;; induction variable, ending value
                  (values ind limit) (values (aget (.-Args c) idx) (aget (.-Args c) (- 1 idx)))
                  ;; starting value, increment value, next value, loop return edge
                  (values init inc nxt loopReturn) (parseIndVar ind)]
                (when (== init nil)
                  (continue)) ; this is not an induction variable


                ;; This is ind.Block.Preds, not b.Preds. That's a restriction on the loop header,
                ;; not the comparison block.
                (when (!= (len (.-Preds (.-Block ind))) 2)
                  (continue))


                ;; Expect the increment to be a nonzero constant.
                (when (not (.isGenericIntConst inc))
                  (continue))

                (let [step (.-AuxInt inc)]
                  (when (== step 0)
                    (continue))

                  ;; step == minInt64 cannot be safely negated below, because -step
                  ;; overflows back to minInt64. The later underflow checks need a
                  ;; positive magnitude, so reject this case here.
                  (when (== step (minSignedValue (.-Type ind)))
                    (continue))


                  ;; startBody is the edge that eventually returns to the loop header.
                  (let [^Edge startBody (zero Edge)]
                    (switch
                      (case [(.IsAncestorEq sdom (.-b (aget (.-Succs b) 0)) (.-b loopReturn))]
                        (set! startBody (aget (.-Succs b) 0)))
                      (case [(.IsAncestorEq sdom (.-b (aget (.-Succs b) 1)) (.-b loopReturn))]
                        ;; if x { goto exit } else { goto entry } is identical to if !x { goto entry } else { goto exit }
                        (set! startBody (aget (.-Succs b) 1))
                        (set! less (not less))
                        (set! inclusive (not inclusive)))
                      (default
                        (continue)))


                    ;; Increment sign must match comparison direction.
                    ;; When incrementing, the termination comparison must be ind </<= limit.
                    ;; When decrementing, the termination comparison must be ind >/>= limit.
                    ;; See issue 26116.
                    (when (and (> step 0) (not less))
                      (continue))

                    (when (and (< step 0) less)
                      (continue))


                    ;; Up to now we extracted the induction variable (ind),
                    ;; the increment delta (inc), the temporary sum (nxt),
                    ;; the initial value (init) and the limiting value (limit).
                    ;;
                    ;; We also know that ind has the form (Phi init nxt) where
                    ;; nxt is (Add inc nxt) which means: 1) inc dominates nxt
                    ;; and 2) there is a loop starting at inc and containing nxt.
                    ;;
                    ;; We need to prove that the induction variable is incremented
                    ;; only when it's smaller than the limiting value.
                    ;; Two conditions must happen listed below to accept ind
                    ;; as an induction variable.

                    ;; First condition: the entry block has a single predecessor.
                    ;; The entry now means the in-loop edge where the induction variable
                    ;; comparison succeeded. Its predecessor is not necessarily the header
                    ;; block. This implies that b.Succs[0] is reached iff ind < limit.
                    (when (!= (len (.-Preds (.-b startBody))) 1)
                      ;; the other successor must exit the loop.
                      (continue))


                    ;; Second condition: startBody.b dominates nxt so that
                    ;; nxt is computed when inc < limit.
                    (when (not (.IsAncestorEq sdom (.-b startBody) (.-Block nxt)))
                      ;; inc+ind can only be reached through the branch that confirmed the
                      ;; induction variable is in bounds.
                      (continue))


                    ;; Check for overflow/underflow. We need to make sure that inc never causes
                    ;; the induction variable to wrap around.
                    ;; We use a function wrapper here for easy return true / return false / keep going logic.
                    ;; This function returns true if the increment will never overflow/underflow.
                    (let [ok ^{:go/breaks [[3 315]] :go/end 316} (fn ^bool []
                          (if (> step 0) (do
                              (when (.isGenericIntConst limit)
                                ;; Figure out the actual largest value.
                                (let [v (.-AuxInt limit)]
                                  (when (not inclusive)
                                    (when (== v (minSignedValue (.-Type limit)))
                                      (return false)) ; < minint is never satisfiable.

                                    (dec! v))

                                  (when (.isGenericIntConst init)
                                    ;; Use stride to compute a better lower limit.
                                    (when (> (.-AuxInt init) v)
                                      (return false))

                                    ;; TODO(1.27): investigate passing a smaller-magnitude overflow limit to addU
                                    ;; for addWillOverflow.
                                    (set! v (addU (.-AuxInt init) (* (/ (diff v (.-AuxInt init)) (conv uint64 step)) (conv uint64 step)))))

                                  (when (addWillOverflow v step (maxSignedValue (.-Type ind)))
                                    (return false))

                                  (when (or (and inclusive (!= v (.-AuxInt limit))) (and (not inclusive) (!= (+ v 1) (.-AuxInt limit))))
                                    ;; We know a better limit than the programmer did. Use our limit instead.
                                    (set! limit (.constVal f (.-Op limit) (.-Type limit) v true))
                                    (set! inclusive true))

                                  (return true)))

                              (when (and (== step 1) (not inclusive))
                                ;; Can't overflow because maxint is never a possible value.
                                (return true))

                              ;; If the limit is not a constant, check to see if it is a
                              ;; negative offset from a known non-negative value.
                              (let [(values knn k) (findKNN limit)]
                                (when (or (== knn nil) (< k 0))
                                  (return false))

                                ;; limit == (something nonnegative) - k. That subtraction can't underflow, so
                                ;; we can trust it.
                                (when inclusive
                                  ;; ind <= knn - k cannot overflow if step is at most k
                                  (return (<= step k)))

                                ;; ind < knn - k cannot overflow if step is at most k+1
                                (return (and (<= step (+ k 1)) (!= k (maxSignedValue (.-Type limit)))))))

                            ;; TODO: other unrolling idioms
                            ;; for i := 0; i < KNN - KNN % k ; i += k
                            ;; for i := 0; i < KNN&^(k-1) ; i += k // k a power of 2
                            ;; for i := 0; i < KNN&(-k) ; i += k // k a power of 2
                            (do ; step < 0
                              (when (.isGenericIntConst limit)
                                ;; Figure out the actual smallest value.
                                (let [v (.-AuxInt limit)]
                                  (when (not inclusive)
                                    (when (== v (maxSignedValue (.-Type limit)))
                                      (return false)) ; > maxint is never satisfiable.

                                    (inc! v))

                                  (when (.isGenericIntConst init)
                                    ;; Use stride to compute a better lower limit.
                                    (when (< (.-AuxInt init) v)
                                      (return false))

                                    ;; TODO(1.27): investigate passing a smaller-magnitude underflow limit to subU
                                    ;; for subWillUnderflow.
                                    (set! v (subU (.-AuxInt init) (* (/ (diff (.-AuxInt init) v) (conv uint64 (- step))) (conv uint64 (- step))))))

                                  (when (subWillUnderflow v (- step) (minSignedValue (.-Type ind)))
                                    (return false))

                                  (when (or (and inclusive (!= v (.-AuxInt limit))) (and (not inclusive) (!= (- v 1) (.-AuxInt limit))))
                                    ;; We know a better limit than the programmer did. Use our limit instead.
                                    (set! limit (.constVal f (.-Op limit) (.-Type limit) v true))
                                    (set! inclusive true))

                                  (return true)))

                              (when (and (== step -1) (not inclusive))
                                ;; Can't underflow because minint is never a possible value.
                                (return true))))


                          false)]


                      (when (ok)
                        (let [flags (conv indVarFlags 0)
                            (values ^{:tag (* Value)} min ^{:tag (* Value)} max) (zero (* Value))]
                          (if (> step 0) (do
                              (set! min init)
                              (set! max limit)
                              (when inclusive
                                (set! flags bit-or indVarMaxInc)))

                            (do
                              (set! min limit)
                              (set! max init)
                              (set! flags bit-or indVarMaxInc)
                              (when (not inclusive)
                                (set! flags bit-or indVarMinExc))

                              (set! step (- step))))

                          (when (>= (.-debug (.-pass f)) 1)
                            (printIndVar b ind min max step flags))


                          (set! iv (append iv ^{:go/breaks [2 4 6 8 [10 348] 12 14]} (lit indVar
                                :ind ind
                                :nxt nxt
                                :min min
                                :max max
                                ;; This is startBody.b, where startBody is the edge from the comparison for the
                                ;; induction variable, not necessarily the in-loop edge from the loop header.
                                ;; Induction variable bounds are not valid in the loop before this edge.
                                :entry (.-b startBody)
                                :step step
                                :flags flags)))

                          (.Logf b "found induction variable %v (inc = %v, min = %v, max = %v)\n" ind inc min max))))))))))))




    ^{:line 357} iv))




^{:go/end 367} (go/func subWillUnderflow "subWillUnderflow checks if x - y underflows the min value.\ny must be positive.\n" ^bool [^int64 x ^int64 y ^int64 min]
  (when (< y 0)
    (base/Fatalf "expecting positive value"))

  (< x (+ min y)))




^{:go/end 376} (go/func addWillOverflow "addWillOverflow checks if x + y overflows the max value.\ny must be positive.\n" ^bool [^int64 x ^int64 y ^int64 max]
  (when (< y 0)
    (base/Fatalf "expecting positive value"))

  (> x (- max y)))



^{:go/end 384} (go/func diff "diff returns x-y as a uint64. Requires x>=y.\n" ^uint64 [^int64 x ^int64 y]
  (when (< x y)
    (base/Fatalf "diff %d - %d underflowed" x y))

  (conv uint64 (- x y)))



^{:go/end 401} (go/func addU "addU returns x+y. Requires that x+y does not overflow an int64.\n" ^int64 [^int64 x ^uint64 y]
  (when (>= y (<< 1 63))
    (when (>= x 0)
      (base/Fatalf "addU overflowed %d + %d" x y))

    (set! x + (- (<< 1 63) 1))
    (set! x + 1)
    (set! y - (<< 1 63)))

  ;; TODO(1.27): investigate passing a smaller-magnitude overflow limit in here.
  (when (addWillOverflow x (conv int64 y) (maxSignedValue (aget types/Types types/TINT64)))
    (base/Fatalf "addU overflowed %d + %d" x y))

  (+ x (conv int64 y)))



^{:go/end 418} (go/func subU "subU returns x-y. Requires that x-y does not underflow an int64.\n" ^int64 [^int64 x ^uint64 y]
  (when (>= y (<< 1 63))
    (when (< x 0)
      (base/Fatalf "subU underflowed %d - %d" x y))

    (set! x - (- (<< 1 63) 1))
    (set! x - 1)
    (set! y - (<< 1 63)))

  ;; TODO(1.27): investigate passing a smaller-magnitude underflow limit in here.
  (when (subWillUnderflow x (conv int64 y) (minSignedValue (aget types/Types types/TINT64)))
    (base/Fatalf "subU underflowed %d - %d" x y))

  (- x (conv int64 y)))




^{:go/end 452} (go/func findKNN "if v is known to be x - c, where x is known to be nonnegative and c is a\nconstant, return x, c. Otherwise return nil, 0.\n" [^{:tag (* Value)} v] :results [(* Value) int64]
  (let [(values ^{:tag (* Value)} x ^{:tag (* Value)} y) (zero (* Value))]
    (set! x v)
    (switch (.-Op v)
      (case [OpSub64 OpSub32 OpSub16 OpSub8]
        (set! x (aget (.-Args v) 0))
        (set! y (aget (.-Args v) 1)))

      (case [OpAdd64 OpAdd32 OpAdd16 OpAdd8]
        (set! x (aget (.-Args v) 0))
        (set! y (aget (.-Args v) 1))
        (when (.isGenericIntConst x)
          (set! (values x y) (values y x)))))


    (switch (.-Op x)
      (case [OpSliceLen OpStringLen OpSliceCap])
      (default
        (return nil 0)))

    (when (== y nil)
      (return x 0))

    (when (not (.isGenericIntConst y))
      (return nil 0))

    (when (or (== (.-Op v) OpAdd64) (== (.-Op v) OpAdd32) (== (.-Op v) OpAdd16) (== (.-Op v) OpAdd8))
      (return x (- (.-AuxInt y))))

    (return x (.-AuxInt y))))


^{:go/end 483} (go/func printIndVar [^{:tag (* Block)} b ^{:tag (* Value)} i ^{:tag (* Value)} min ^{:tag (* Value)} max ^int64 inc ^indVarFlags flags]
  (let [(values mb1 mb2) (values "[" "]")]
    (when (!= (bit-and flags indVarMinExc) 0)
      (set! mb1 "("))

    (when (== (bit-and flags indVarMaxInc) 0)
      (set! mb2 ")"))


    (let [(values mlim1 mlim2) (values (fmt/Sprint (.-AuxInt min)) (fmt/Sprint (.-AuxInt max)))]
      (when (not (.isGenericIntConst min))
        (if (>= (.-debug (.-pass (.-Func b))) 2)
          (set! mlim1 (fmt/Sprint min))

          (set! mlim1 "?")))


      (when (not (.isGenericIntConst max))
        (if (>= (.-debug (.-pass (.-Func b))) 2)
          (set! mlim2 (fmt/Sprint max))

          (set! mlim2 "?")))


      (let [extra ""]
        (when (>= (.-debug (.-pass (.-Func b))) 2)
          (set! extra (fmt/Sprintf " (%s)" i)))

        (.Warnl (.-Func b) (.-Pos b) "Induction variable: limits %v%v,%v%v, increment %d%s" mb1 mlim1 mlim2 mb2 inc extra)))))


^{:go/end 487} (go/func minSignedValue ^int64 [^{:tag (* types/Type)} t]
  ^int64 (<< -1 (- (* (.Size t) 8) 1)))


^{:go/end 491} (go/func maxSignedValue ^int64 [^{:tag (* types/Type)} t]
  (- ^int64 (<< 1 (- (* (.Size t) 8) 1)) 1))

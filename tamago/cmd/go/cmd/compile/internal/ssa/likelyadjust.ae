^{:go/end 204} (go/func likelyadjust [^{:tag (* Func)} f]
  ;; The values assigned to certain and local only matter
  ;; in their rank order.  0 is default, more positive
  ;; is less likely. It's possible to assign a negative
  ;; unlikeliness (though not currently the case).
  (let [certain (.allocInt8Slice (.-Cache f) (.NumBlocks f))] ; In the long run, all outcomes are at least this bad. Mainly for Exit
    (defer (.freeInt8Slice (.-Cache f) certain))
    (let [local (.allocInt8Slice (.-Cache f) (.NumBlocks f))] ; for our immediate predecessors.
      (defer (.freeInt8Slice (.-Cache f) local))

      (let [po (.postorder f)
          ^{:line 94} nest (.loopnest f)
          ^{:line 95} b2l (.-b2l nest)]

        (range [_ b po]
          (switch (.-Kind b)
            (case [BlockExit]
              ;; Very unlikely.
              (aset local (.-ID b) blEXIT)
              (aset certain (.-ID b) blEXIT))

            ;; Ret, it depends.
            (case [BlockRet BlockRetJmp]
              (aset local (.-ID b) blRET)
              (aset certain (.-ID b) blRET))

            ;; Calls. TODO not all calls are equal, names give useful clues.
            ;; Any name-based heuristics are only relative to other calls,
            ;; and less influential than inferences from loop structure.
            (case [BlockDefer]
              (aset local (.-ID b) blCALL)
              (aset certain (.-ID b) (max blCALL (aget certain (.-ID (.-b (aget (.-Succs b) 0)))))))

            (default
              (cond (== (len (.-Succs b)) 1)
                (aset certain (.-ID b) (aget certain (.-ID (.-b (aget (.-Succs b) 0)))))
                (== (len (.-Succs b)) 2)
                ;; If successor is an unvisited backedge, it's in loop and we don't care.
                ;; Its default unlikely is also zero which is consistent with favoring loop edges.
                ;; Notice that this can act like a "reset" on unlikeliness at loops; the
                ;; default "everything returns" unlikeliness is erased by min with the
                ;; backedge likeliness; however a loop with calls on every path will be
                ;; tagged with call cost. Net effect is that loop entry is favored.
                (let [b0 (.-ID (.-b (aget (.-Succs b) 0)))
                    ^{:line 127} b1 (.-ID (.-b (aget (.-Succs b) 1)))]
                  (aset certain (.-ID b) (min (aget certain b0) (aget certain b1)))

                  (let [l (aget b2l (.-ID b))
                      ^{:line 131} l0 (aget b2l b0)
                      ^{:line 132} l1 (aget b2l b1)

                      ^{:line 134} prediction (.-Likely b)]
                    ;; Weak loop heuristic -- both source and at least one dest are in loops,
                    ;; and there is a difference in the destinations.
                    ;; TODO what is best arrangement for nested loops?
                    (if (and (!= l nil) (!= l0 l1))
                      (let [noprediction false]
                        (switch
                          ;; prefer not to exit loops
                          (case [(== l1 nil)]
                            (set! prediction BranchLikely))
                          (case [(== l0 nil)]
                            (set! prediction BranchUnlikely))

                          ;; prefer to stay in loop, not exit to outer.
                          (case [(== l l0)]
                            (set! prediction BranchLikely))
                          (case [(== l l1)]
                            (set! prediction BranchUnlikely))
                          (default
                            (set! noprediction true)))

                        (when (and (> (.-debug (.-pass f)) 0) (not noprediction))
                          (.Warnl f (.-Pos b) "Branch prediction rule stay in loop%s"
                            (describePredictionAgrees b prediction))))


                      (do
                        ;; Lacking loop structure, fall back on heuristics.
                        (cond (> (aget certain b1) (aget certain b0)) (do
                            (set! prediction BranchLikely)
                            (when (> (.-debug (.-pass f)) 0)
                              (describeBranchPrediction f b (aget certain b0) (aget certain b1) prediction)))

                          (> (aget certain b0) (aget certain b1)) (do
                            (set! prediction BranchUnlikely)
                            (when (> (.-debug (.-pass f)) 0)
                              (describeBranchPrediction f b (aget certain b1) (aget certain b0) prediction)))

                          (> (aget local b1) (aget local b0)) (do
                            (set! prediction BranchLikely)
                            (when (> (.-debug (.-pass f)) 0)
                              (describeBranchPrediction f b (aget local b0) (aget local b1) prediction)))

                          (> (aget local b0) (aget local b1)) (do
                            (set! prediction BranchUnlikely)
                            (when (> (.-debug (.-pass f)) 0)
                              (describeBranchPrediction f b (aget local b1) (aget local b0) prediction))))))



                    (when (!= (.-Likely b) prediction)
                      (when (== (.-Likely b) BranchUnknown)
                        (set! (.-Likely b) prediction))))))



              ;; Look for calls in the block.  If there is one, make this block unlikely.
              (range [_ v (.-Values b)]
                (when (.-call (aget opcodeTable (.-Op v)))
                  (aset local (.-ID b) blCALL)
                  (aset certain (.-ID b) (max blCALL (aget certain (.-ID (.-b (aget (.-Succs b) 0))))))
                  (break)))))



          (when (> (.-debug (.-pass f)) 2)
            (.Warnl f (.-Pos b) "BP: Block %s, local=%s, certain=%s" b (aget bllikelies (- (aget local (.-ID b)) blMin)) (aget bllikelies (- (aget certain (.-ID b)) blMin)))))))))





^{:go/end 208} (go/method String ^string [^{:tag (* loop)} l]

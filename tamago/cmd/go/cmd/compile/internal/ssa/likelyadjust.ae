^{:go/end 47} (go/method outerinner "outerinner records that outer contains inner\n" [^SparseTree sdom ^{:tag (* loop)} outer ^{:tag (* loop)} inner]
  ;; There could be other outer loops found in some random order,
  ;; locate the new outer loop appropriately among them.

  ;; Outer loop headers dominate inner loop headers.
  ;; Use this to put the "new" "outer" loop in the right place.
  (let [oldouter (.-outer inner)]
    (while (and (!= oldouter nil) (.isAncestor sdom (.-header outer) (.-header oldouter)))
      (set! inner oldouter)
      (set! oldouter (.-outer inner)))

    (when (== outer oldouter)
      (return))

    (when (!= oldouter nil)
      (.outerinner sdom oldouter outer))


    (set! (.-outer inner) outer)
    (set! (.-isInner outer) false)))



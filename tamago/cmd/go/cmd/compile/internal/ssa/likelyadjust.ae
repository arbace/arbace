^{:go/end 220} (go/method LongString ^string [^{:tag (* loop)} l]
  (let [i ""
      ^{:line 212} o ""]
    (when (.-isInner l)
      (set! i ", INNER"))

    (when (!= (.-outer l) nil)
      (set! o (+ ", o=" (.String (.-header (.-outer l))))))

    (fmt/Sprintf "hdr:%s%s%s" (.-header l) i o)))


^{:go/breaks [[5 231]] :go/end 232} (go/method isWithinOrEq ^bool [^{:tag (* loop)} l ^{:tag (* loop)} ll]
  (when (== ll nil) ; nil means whole program
    (return true))

  (for [] (!= l nil) (set! l (.-outer l))
    (when (== l ll)
      (return true)))


  false)






^{:go/end 243} (go/method nearestOuterLoop "nearestOuterLoop returns the outer loop of loop most nearly\ncontaining block b; the header must dominate b.  loop itself\nis assumed to not be that loop. For acceptable performance,\nwe're relying on loop nests to not be terribly deep.\n" ^{:tag (* loop)} [^{:tag (* loop)} l ^SparseTree sdom ^{:tag (* Block)} b]
  (let [^{:tag (* loop)} o (zero (* loop))]
    (for [(set! o (.-outer l))] (and (!= o nil) (not (.IsAncestorEq sdom (.-header o) b))) (set! o (.-outer o)))

    ^{:line 242} o))


^{:go/end 416} (go/func loopnestfor ^{:tag (* loopnest)} [^{:tag (* Func)} f]
  (let [po (.postorder f)
      ^{:line 247} sdom (.Sdom f)
      ^{:line 248} b2l (make (slice (* loop)) (.NumBlocks f))
      ^{:line 249} loops (make (slice (* loop)) 0)
      ^{:line 250} visited (.allocBoolSlice (.-Cache f) (.NumBlocks f))]
    (defer (.freeBoolSlice (.-Cache f) visited))
    (let [sawIrred false]

      (when (> (.-debug (.-pass f)) 2)
        (fmt/Printf "loop finding in %s\n" (.-Name f)))


      ;; Reducible-loop-nest-finding.
      (range [_ b po]
        (when (and (!= (.-pass f) nil) (> (.-debug (.-pass f)) 3))
          (fmt/Printf "loop finding at %s\n" b))


        (let [^{:tag (* loop)} innermost (zero (* loop))] ; innermost header reachable from this block

          ;; IF any successor s of b is in a loop headed by h
          ;; AND h dominates b
          ;; THEN b is in the loop headed by h.
          ;;
          ;; Choose the first/innermost such h.
          ;;
          ;; IF s itself dominates b, then s is a loop header;
          ;; and there may be more than one such s.
          ;; Since there's at most 2 successors, the inner/outer ordering
          ;; between them can be established with simple comparisons.
          (range [_ e (.-Succs b)]
            (let [bb (.-b e)
                ^{:line 278} l (aget b2l (.-ID bb))]

              (cond (.IsAncestorEq sdom bb b) (do ; Found a loop header
                  (when (and (!= (.-pass f) nil) (> (.-debug (.-pass f)) 4))
                    (fmt/Printf "loop finding    succ %s of %s is header\n" (.String bb) (.String b)))

                  (when (== l nil)
                    (set! l (addr (lit loop :header bb :isInner true)))
                    (set! loops (append loops l))
                    (aset b2l (.-ID bb) l)))

                (not (aget visited (.-ID bb))) (do ; Found an irreducible loop
                  (set! sawIrred true)
                  (when (and (!= (.-pass f) nil) (> (.-debug (.-pass f)) 4))
                    (fmt/Printf "loop finding    succ %s of %s is IRRED, in %s\n" (.String bb) (.String b) (.-Name f))))

                (!= l nil) (do
                  ;; TODO handle case where l is irreducible.
                  ;; Perhaps a loop header is inherited.
                  ;; is there any loop containing our successor whose
                  ;; header dominates b?
                  (when (not (.IsAncestorEq sdom (.-header l) b))
                    (set! l (.nearestOuterLoop l sdom b)))

                  (when (and (!= (.-pass f) nil) (> (.-debug (.-pass f)) 4))
                    (if (== l nil)
                      (fmt/Printf "loop finding    succ %s of %s has no loop\n" (.String bb) (.String b))

                      (fmt/Printf "loop finding    succ %s of %s provides loop with header %s\n" (.String bb) (.String b) (.String (.-header l)))))) :else


                (do ; No loop
                  (when (and (!= (.-pass f) nil) (> (.-debug (.-pass f)) 4))
                    (fmt/Printf "loop finding    succ %s of %s has no loop\n" (.String bb) (.String b)))))




              (when (or (== l nil) (== innermost l))
                (continue))


              (when (== innermost nil)
                (set! innermost l)
                (continue))


              (cond (.isAncestor sdom (.-header innermost) (.-header l)) (do
                  (.outerinner sdom innermost l)
                  (set! innermost l))
                (.isAncestor sdom (.-header l) (.-header innermost))
                (.outerinner sdom l innermost))))



          (when (!= innermost nil)
            (aset b2l (.-ID b) innermost)
            (inc! (.-nBlocks innermost)))

          (aset visited (.-ID b) true)))


      ;; Compute depths.
      (range [_ l loops]
        (when (!= (.-depth l) 0)
          ;; Already computed because it is an ancestor of
          ;; a previous loop.
          (continue))

        ;; Find depth by walking up the loop tree.
        (let [d (conv int16 0)]
          (for [x l] (!= x nil) (set! x (.-outer x))
            (when (!= (.-depth x) 0)
              (set! d + (.-depth x))
              (break))

            (inc! d))

          ;; Set depth for every ancestor.
          (for [x l] (!= x nil) (set! x (.-outer x))
            (when (!= (.-depth x) 0)
              (break))

            (set! (.-depth x) d)
            (dec! d))))


      ;; Double-check depths.
      (range [_ l loops]
        (let [want (conv int16 1)]
          (when (!= (.-outer l) nil)
            (set! want (+ (.-depth (.-outer l)) 1)))

          (when (!= (.-depth l) want)
            (.Fatalf (.-header l) "bad depth calculation for loop %s: got %d want %d" (.-header l) (.-depth l) want))))



      (let [ln (addr (lit loopnest :f f :b2l b2l :po po :sdom sdom :loops loops :hasIrreducible sawIrred))]

        ;; Curious about the loopiness? "-d=ssa/likelyadjust/stats"
        (when (and (!= (.-pass f) nil) (> (.-stats (.-pass f)) 0) (> (len loops) 0))

          ;; Note stats for non-innermost loops are slightly flawed because
          ;; they don't account for inner loop exits that span multiple levels.

          (range [_ l loops]
            (let [inner 0]
              (when (.-isInner l)
                (inc! inner))


              (.LogStat f (+ "loopstats in " (.-Name f) ":")
                (.-depth l) "depth"
                ^{:line 392} inner "is_inner" (.-nBlocks l) "n_blocks"))))



        (when (and (!= (.-pass f) nil) (> (.-debug (.-pass f)) 1) (> (len loops) 0))
          (fmt/Printf "Loops in %s:\n" (.-Name f))
          (range [_ l loops]
            (fmt/Printf "%s, b=" (.LongString l))
            (range [_ b (.-Blocks f)]
              (when (== (aget b2l (.-ID b)) l)
                (fmt/Printf " %s" b)))


            (fmt/Print "\n"))

          (fmt/Printf "Nonloop blocks in %s:" (.-Name f))
          (range [_ b (.-Blocks f)]
            (when (== (aget b2l (.-ID b)) nil)
              (fmt/Printf " %s" b)))


          (fmt/Print "\n"))

        ^{:line 415} ln))))



^{:go/breaks [[5 423]] :go/end 424} (go/method depth "depth returns the loop nesting level of block b.\n" ^int16 [^{:tag (* loopnest)} ln ^ID b]

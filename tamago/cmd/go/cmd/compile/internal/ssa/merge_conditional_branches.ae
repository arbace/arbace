          (isIfBlock thenBlock)
          (canValuesBeMoved thenBlock))
        ;; True branch contains a valid nested condition
        (set! outerSuccIndex TrueConditionSuccIndex)
        (and (== (len (.-Preds elseBlock)) 1)
          (isIfBlock elseBlock)
          (canValuesBeMoved elseBlock))

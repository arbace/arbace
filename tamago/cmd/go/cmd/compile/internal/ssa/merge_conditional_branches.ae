              ;; that means False branch leads to b2 (target)
              (set! innerSuccIndex FalseConditionSuccIndex))
            (default
              ;; No pattern are matched
              (return InvalidIndex InvalidIndex)))


          ;; Critical check: ensure phi nodes in merge blocks have consistent values
          ;; This guarantees semantic preservation after transformation
          (let [outToCommonIndex (bit-xor outerSuccIndex 1) ; index of the outedge from outerBlock to commonBothBlock
              ^{:line 220} inToCommonIndex (bit-xor innerSuccIndex 1)] ; index of the outedge from innerBlock to commonBothBlock
            (when (not (checkSameValuesInPhiNodes outerBlock innerBlock outToCommonIndex inToCommonIndex))
              (return InvalidIndex InvalidIndex))


            (return outerSuccIndex innerSuccIndex)))))))






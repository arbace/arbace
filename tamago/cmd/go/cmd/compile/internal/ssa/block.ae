^{:go/end 298} (go/method removePred "removePred removes the ith input edge from b.\nIt is the responsibility of the caller to remove\nthe corresponding successor edge, and adjust any\nphi values by calling b.removePhiArg(v, i).\n" [^{:tag (* Block)} b ^int i]
  (let [n (- (len (.-Preds b)) 1)]
    (when (!= i n)
      (let [e (aget (.-Preds b) n)]
        (aset (.-Preds b) i e)
        ;; Update the other end of the edge we moved.
        (set! (.-i (aget (.-Succs (.-b e)) (.-i e))) i)))

    (aset (.-Preds b) n (lit Edge))
    (set! (.-Preds b) (subslice (.-Preds b) _ n))
    (.invalidateCFG (.-Func b))))








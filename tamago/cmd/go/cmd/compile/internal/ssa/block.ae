^{:go/end 153} (go/method LongString "long form print\n" ^string [^{:tag (* Block)} b]
  (let [s (.String (.-Kind b))]
    (when (!= (.-Aux b) nil)
      (set! s + (fmt/Sprintf " {%s}" (.-Aux b))))

    (when [t (.AuxIntString b)] (!= t "")
      (set! s + (fmt/Sprintf " [%s]" t)))

    (range [_ c (.ControlValues b)]
      (set! s + (fmt/Sprintf " %s" c)))

    (when (> (len (.-Succs b)) 0)
      (set! s + " ->")
      (range [_ c (.-Succs b)]
        (set! s + (+ " " (.String (.-b c))))))


    (switch (.-Likely b)
      (case [BranchUnlikely]
        (set! s + " (unlikely)"))
      (case [BranchLikely]
        (set! s + " (likely)")))

    ^{:line 152} s))





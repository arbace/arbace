    (.invalidateCFG (.-Func b))))


^{:go/end 329} (go/method swapSuccessors [^{:tag (* Block)} b]
  (when (!= (len (.-Succs b)) 2)
    (.Fatalf b "swapSuccessors with len(Succs)=%d" (len (.-Succs b))))

  (let [e0 (aget (.-Succs b) 0)
      ^{:line 323} e1 (aget (.-Succs b) 1)]

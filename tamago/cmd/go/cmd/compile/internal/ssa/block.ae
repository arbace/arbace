^{:go/end 214} (go/method ReplaceControl "ReplaceControl exchanges the existing control value at the index provided\nfor the new value. The index must refer to a valid control value.\n" [^{:tag (* Block)} b ^int i ^{:tag (* Value)} v]
  (dec! (.-Uses (aget (.-Controls b) i)))

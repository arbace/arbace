^{:go/end 249} (go/method resetWithControl "resetWithControl resets b and adds control v.\nIt is equivalent to b.Reset(kind); b.AddControl(v),\nexcept that it is one call instead of two and avoids a bounds check.\nIt is intended for use by rewrite rules, where this matters.\n" [^{:tag (* Block)} b ^BlockKind kind ^{:tag (* Value)} v]
  (set! (.-Kind b) kind)
  (.ResetControls b)
  (set! (.-Aux b) nil)
  (set! (.-AuxInt b) 0)
  (aset (.-Controls b) 0 v)
  (inc! (.-Uses v)))






^{:go/end 264} (go/method resetWithControl2 "resetWithControl2 resets b and adds controls v and w.\nIt is equivalent to b.Reset(kind); b.AddControl(v); b.AddControl(w),\nexcept that it is one call instead of three and avoids two bounds checks.\nIt is intended for use by rewrite rules, where this matters.\n" [^{:tag (* Block)} b ^BlockKind kind ^{:tag (* Value)} v ^{:tag (* Value)} w]
  (set! (.-Kind b) kind)
  (.ResetControls b)
  (set! (.-Aux b) nil)
  (set! (.-AuxInt b) 0)
  (aset (.-Controls b) 0 v)
  (aset (.-Controls b) 1 w)
  (inc! (.-Uses v))
  (inc! (.-Uses w)))






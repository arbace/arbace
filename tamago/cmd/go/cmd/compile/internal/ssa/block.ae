^{:go/end 179} (go/method ControlValues "ControlValues returns a slice containing the non-nil control\nvalues of the block. The index of each control value will be\nthe same as it is in the Controls property and can be used\nin ReplaceControl calls.\n" ^{:tag (slice (* Value))} [^{:tag (* Block)} b]
  (when (== (aget (.-Controls b) 0) nil)
    (return (subslice (.-Controls b) _ 0)))

  (when (== (aget (.-Controls b) 1) nil)
    (return (subslice (.-Controls b) _ 1)))

  (subslice (.-Controls b) _ 2))





^{:go/end 188} (go/method SetControl "SetControl removes all existing control values and then adds\nthe control value provided. The number of control values after\na call to SetControl will always be 1.\n" [^{:tag (* Block)} b ^{:tag (* Value)} v]
  (.ResetControls b)

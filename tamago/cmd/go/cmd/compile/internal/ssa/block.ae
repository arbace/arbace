    (set! (.-i (aget (.-Preds (.-b ex)) (.-i ex))) y)
    (set! (.-i (aget (.-Preds (.-b ey)) (.-i ey))) x)))















^{:go/end 367} (go/method removePhiArg "removePhiArg removes the ith arg from phi.\nIt must be called after calling b.removePred(i) to\nadjust the corresponding phi value of the block:\n\nb.removePred(i)\nfor _, v := range b.Values {\n\n\tif v.Op != OpPhi {\n\t    continue\n\t}\n\tb.removePhiArg(v, i)\n\n}\n" [^{:tag (* Block)} b ^{:tag (* Value)} phi ^int i]
  (let [n (len (.-Preds b))]
    (when [numPhiArgs (len (.-Args phi))] (!= (- numPhiArgs 1) n)
      (.Fatalf b "inconsistent state for %v, num predecessors: %d, num phi args: %d" phi n numPhiArgs))

    (dec! (.-Uses (aget (.-Args phi) i)))
    (aset (.-Args phi) i (aget (.-Args phi) n))
    (aset (.-Args phi) n nil)
    (set! (.-Args phi) (subslice (.-Args phi) _ n))
    (phielimValue phi)))





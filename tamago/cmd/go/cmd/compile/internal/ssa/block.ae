    (set! (.-i (aget (.-Preds (.-b e0)) (.-i e0))) 1)
    (set! (.-i (aget (.-Preds (.-b e1)) (.-i e1))) 0)
    (set! (.-Likely b) * -1)))



^{:go/end 342} (go/method swapSuccessorsByIdx "Swaps b.Succs[x] and b.Succs[y].\n" [^{:tag (* Block)} b ^int x ^int y]

            ;; ensures that the sets of Values never contain duplicates.
            ;; (Duplicates would create less-efficient code, not incorrect code.)
            ^{:line 120} combine ^{:go/end 147} (fn [^{:tag (array 3 (* Value))} a ^{:tag (array 3 (* Value))} b] :results [(array 3 (* Value)) bool]
              (let [^{:tag (array 3 (* Value))} c (zero (array 3 (* Value)))
                  ^{:line 122} i 0]
                (range [_ v a]
                  (when (== v nil)
                    (break))

                  (aset c i v)
                  (inc! i))

                (label :bloop
                  (range [_ v b]
                    (when (== v nil)
                      (break))

                    (range [_ u a]
                      (when (== v u)
                        (continue :bloop)))


                    (when (== i 3)
                      (return (lit (array 3 (* Value))) false))

                    (aset c i v)
                    (inc! i)))

                (return c true)))]


          (set! computeTT ^{:go/end 171} (fn ^uint8 [^{:tag (* Value)} v ^{:tag (array 3 (* Value))} vars]
              (let [i 0]
                (for [] (< i (len vars)) (inc! i)
                  (when (== (aget vars i) v)
                    (return (aget truthTableValues i))))


                (let [slo (bit-and-not (aget boolExprTrees v) sloInterior)

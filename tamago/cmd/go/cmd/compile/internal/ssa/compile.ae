^{:go/end 186} (go/method DumpFileForPhase "DumpFileForPhase creates a file from the function name and phase name,\nwarning and returning nil if this is not possible.\n" ^io/WriteCloser [^{:tag (* Func)} f ^string phaseName]
  (inc! (.-dumpFileSeq f))
  (let [fname (fmt/Sprintf "%s_%02d__%s.dump" (.-Name f) (conv int (.-dumpFileSeq f)) phaseName)]
    (set! fname (strings/ReplaceAll fname " " "_"))
    (set! fname (strings/ReplaceAll fname "/" "_"))
    (set! fname (strings/ReplaceAll fname ":" "_"))

    (when [ssaDir (os/Getenv "GOSSADIR")] (!= ssaDir "")
      (set! fname (filepath/Join ssaDir fname)))


    (let [(values fi err) (os/Create fname)]

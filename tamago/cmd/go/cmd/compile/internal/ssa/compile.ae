        (.Warnl f src/NoXPos "Unable to create after-phase dump file %s" fname)
        (return nil))

      ^{:line 185} fi)))





^{:go/end 198} (go/method dumpFile "dumpFile creates a file from the phase name and function name\nDumping is done to files to avoid buffering huge strings before\noutput.\n" [^{:tag (* Func)} f ^string phaseName]
  (let [fi (.DumpFileForPhase f phaseName)]
    (when (!= fi nil)
      (let [p (lit stringFuncPrinter :w fi)]
        (fprintFunc p f)
        (.Close fi)))))




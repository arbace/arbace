(in-ns 'go.cmd.compile.internal.ssa) (go/file "cache.go" :imports [


    ^{:line 8} [obj "cmd/internal/obj"]
    ^{:line 9} [sort "sort"]])




(go/type Cache "A Cache holds reusable compiler state.\nIt is intended to be re-used for multiple Func compilations.\n" (struct

    ^{:line 16 :tag (array 2000 Value) :doc "Storage for low-numbered values and blocks.\n"} values
    ^{:line 17 :tag (array 200 Block)} blocks
    ^{:line 18 :tag (array 2000 Location)} locs



    ^{:line 22 :tag (* stackAllocState) :doc "Reusable stackAllocState.\nSee stackalloc.go's {new,put}StackAllocState.\n"} stackAllocState

    ^{:line 24 :tag (slice (* poset))} scrPoset ; scratch poset to be reused


    ^{:line 27 :tag (slice valState) :doc "Reusable regalloc state.\n"} regallocValues

    ^{:line 29 :tag (slice (* obj/Prog))} ValueToProgAfter
    ^{:line 30 :tag debugState} debugState

    ^{:line 32 :tag any} Liveness ; *gc.livenessFuncCache



    ^{:line 36 :tag (slice (* (slice (* Value)))) :doc "Free \"headers\" for use by the allocators in allocators.go.\nUsed to put slices in sync.Pools without allocation.\n"} hdrValueSlice
    ^{:line 37 :tag (slice (* (slice limit)))} hdrLimitSlice))


^{:go/end 51} (go/method Reset [^{:tag (* Cache)} c]
  (let [nv (sort/Search (len (.-values c)) ^{:go/end 41} (fn ^bool [^int i] (== (.-ID (aget (.-values c) i)) 0)))]
    (clear (subslice (.-values c) _ nv))
    (let [nb (sort/Search (len (.-blocks c)) ^{:go/end 43} (fn ^bool [^int i] (== (.-ID (aget (.-blocks c) i)) 0)))]
      (clear (subslice (.-blocks c) _ nb))
      (let [nl (sort/Search (len (.-locs c)) ^{:go/end 45} (fn ^bool [^int i] (== (aget (.-locs c) i) nil)))]
        (clear (subslice (.-locs c) _ nl))

        ;; regalloc sets the length of c.regallocValues to whatever it may use,
        ;; so clear according to length.
        (clear (.-regallocValues c))))))

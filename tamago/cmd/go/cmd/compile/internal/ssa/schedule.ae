              ;; add it to the schedule, add any of its uses that are now scheduleable
              ;; to the queue, and repeat.
              (let [nv (len (.-Values b))]
                (set! (.-Values b) (subslice (.-Values b) _ 0))
                (while (> (.Len priq) 0)
                  ;; Schedule the next schedulable value in priority order.
                  (let [v (assert (* Value) (heap/Pop priq))]
                    (set! (.-Values b) (append (.-Values b) v))

                    ;; Find all the scheduling edges out from this value.
                    (let [i (sort/Search (len edges) ^{:go/end 310} (fn ^bool [^int i]
                            (>= (.-ID (.-x (aget edges i))) (.-ID v))))

                        ^{:line 311} j (sort/Search (len edges) ^{:go/end 313} (fn ^bool [^int i]
                            (> (.-ID (.-x (aget edges i))) (.-ID v))))]


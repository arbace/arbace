        (defer (.freeBoolSlice (.-Cache f) inBlockUses))
        (when (.-optimize (.-Config f))
          (range [_ b (.-Blocks f)]
            (range [_ v (.-Values b)]
              (range [_ a (.-Args v)]
                (when (== (.-Block a) b)
                  (aset inBlockUses (.-ID a) true))))))





        (set! (.-inBlockUses priq) inBlockUses)

        (range [_ b (.-Blocks f)]
          ;; Compute score. Larger numbers are scheduled closer to the end of the block.
          (range [_ v (.-Values b)]
            (switch
              (case [(.isLoweredGetClosurePtr (.-Op v))]
                ;; We also score GetLoweredClosurePtr as early as possible to ensure that the
                ;; context register is not stomped. GetLoweredClosurePtr should only appear
                ;; in the entry block where there are no phi functions, so there is no
                ;; conflict or ambiguity here.
                (when (!= b (.-Entry f))
                  (.Fatalf f "LoweredGetClosurePtr appeared outside of entry block, b=%s" (.String b)))

                (aset score (.-ID v) ScorePhi))
              (case [(.-nilCheck (aget opcodeTable (.-Op v)))]
                ;; Nil checks must come before loads from the same address.
                (aset score (.-ID v) ScoreNilCheck))
              (case [(== (.-Op v) OpPhi)]
                ;; We want all the phis first.
                (aset score (.-ID v) ScorePhi))
              (case [(or (== (.-Op v) OpArgIntReg) (== (.-Op v) OpArgFloatReg))]
                ;; In-register args must be scheduled as early as possible to ensure that they
                ;; are not stomped (similar to the closure pointer above).
                ;; In particular, they need to come before regular OpArg operations because
                ;; of how regalloc places spill code (see regalloc.go:placeSpills:mustBeFirst).
                (when (!= b (.-Entry f))
                  (.Fatalf f "%s appeared outside of entry block, b=%s" (.-Op v) (.String b)))

                (aset score (.-ID v) ScorePhi))
              (case [(or (== (.-Op v) OpArg) (== (.-Op v) OpSP) (== (.-Op v) OpSB))]
                ;; We want all the args as early as possible, for better debugging.
                (aset score (.-ID v) ScoreArg))
              (case [(== (.-Op v) OpInitMem)]
                ;; Early, but after args. See debug.go:buildLocationLists
                (aset score (.-ID v) ScoreInitMem))
              (case [(.IsMemory (.-Type v))]
                ;; Schedule stores as early as possible. This tends to
                ;; reduce register pressure.
                (aset score (.-ID v) ScoreMemory))
              (case [(or (== (.-Op v) OpSelect0) (== (.-Op v) OpSelect1) (== (.-Op v) OpSelectN))]
                ;; Tuple selectors need to appear immediately after the instruction
                ;; that generates the tuple.
                (aset score (.-ID v) ScoreReadTuple))
              (case [(.hasFlagInput v)]
                ;; Schedule flag-reading ops earlier, to minimize the lifetime
                ;; of flag values.
                (aset score (.-ID v) ScoreReadFlags))
              (case [(.isFlagOp v)]
                ;; Schedule flag register generation as late as possible.
                ;; This makes sure that we only have one live flags
                ;; value at a time.
                ;; Note that this case is after the case above, so values
                ;; which both read and generate flags are given ScoreReadFlags.
                (aset score (.-ID v) ScoreFlags))
              (case [(and (== (len (.-Args v)) 1)
                    (== (.-Op (aget (.-Args v) 0)) OpPhi)
                    (> (.-Uses (aget (.-Args v) 0)) 1)
                    (== (len (.-Succs b)) 1)
                    (== (.-b (aget (.-Succs b) 0)) (.-Block (aget (.-Args v) 0)))

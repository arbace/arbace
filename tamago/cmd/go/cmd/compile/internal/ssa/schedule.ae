^{:go/end 559} (go/func storeOrder "storeOrder orders values with respect to stores. That is,\nif v transitively depends on store s, v is ordered after s,\notherwise v is ordered before s.\nSpecifically, values are ordered like\n\n\tstore1\n\tNilCheck that depends on store1\n\tother values that depends on store1\n\tstore2\n\tNilCheck that depends on store2\n\tother values that depends on store2\n\t...\n\nThe order of non-store and non-NilCheck values are undefined\n(not necessarily dependency order). This should be cheaper\nthan a full scheduling as done above.\nNote that simple dependency order won't work: there is no\ndependency between NilChecks and values like IsNonNil.\nAuxiliary data structures are passed in as arguments, so\nthat they can be allocated in the caller and be reused.\nThis function takes care of reset them.\n" ^{:tag (slice (* Value))} [^{:tag (slice (* Value))} values ^{:tag (* sparseSet)} sset ^{:tag (slice int32)} storeNumber]
  (when (== (len values) 0)
    (return values))


  (let [f (.-Func (.-Block (aget values 0)))

      ;; find all stores

      ;; Members of values that are store values.
      ;; A constant bound allows this to be stack-allocated. 64 is
      ;; enough to cover almost every storeOrder call.
      ^{:line 409} stores (make (slice (* Value)) 0 64)
      ^{:line 410} hasNilCheck false]
    (.clear sset) ; sset is the set of stores that are used in other values
    (range [_ v values]
      (when (.IsMemory (.-Type v))
        (set! stores (append stores v))
        (when (or (== (.-Op v) OpInitMem) (== (.-Op v) OpPhi))
          (continue))

        (.add sset (.-ID (.MemoryArg v)))) ; record that v's memory arg is used

      (when (== (.-Op v) OpNilCheck)
        (set! hasNilCheck true)))


    (when (or (== (len stores) 0) (and (not hasNilCheck) (== (.-name (.-pass f)) "nilcheckelim")))
      ;; there is no store, the order does not matter
      (return values))


    ;; find last store, which is the one that is not used by other stores
    (let [^{:tag (* Value)} last (zero (* Value))]
      (range [_ v stores]
        (when (not (.contains sset (.-ID v)))
          (when (!= last nil)
            (.Fatalf f "two stores live simultaneously: %v and %v" v last))

          (set! last v)))



      ;; We assign a store number to each value. Store number is the
      ;; index of the latest store that this value transitively depends.
      ;; The i-th store in the current block gets store number 3*i. A nil
      ;; check that depends on the i-th store gets store number 3*i+1.
      ;; Other values that depends on the i-th store gets store number 3*i+2.
      ;; Special case: 0 -- unassigned, 1 or 2 -- the latest store it depends
      ;; is in the previous block (or no store at all, e.g. value is Const).
      ;; First we assign the number to all stores by walking back the store chain,
      ;; then assign the number to other values in DFS order.
      (let [count (make (slice int32) (* 3 (+ (len stores) 1)))]
        (.clear sset) ; reuse sparse set to ensure that a value is pushed to stack only once
        (for [(values n w) (values (len stores) last)] (> n 0) (dec! n)
          (aset storeNumber (.-ID w) (conv int32 (* 3 n)))
          (inc! (aget count (* 3 n)))
          (.add sset (.-ID w))
          (when (or (== (.-Op w) OpInitMem) (== (.-Op w) OpPhi))
            (when (!= n 1)
              (.Fatalf f "store order is wrong: there are stores before %v" w))

            (break))

          (set! w (.MemoryArg w)))

        (let [^{:tag (slice (* Value))} stack (zero (slice (* Value)))]
          (range [_ v values]
            (when (.contains sset (.-ID v))
              ;; in sset means v is a store, or already pushed to stack, or already assigned a store number
              (continue))

            (set! stack (append stack v))
            (.add sset (.-ID v))

            (while (> (len stack) 0)
              (let [w (aget stack (- (len stack) 1))]
                (when (!= (aget storeNumber (.-ID w)) 0)
                  (set! stack (subslice stack _ (- (len stack) 1)))
                  (continue))

                (when (== (.-Op w) OpPhi)
                  ;; Phi value doesn't depend on store in the current block.
                  ;; Do this early to avoid dependency cycle.
                  (aset storeNumber (.-ID w) 2)
                  (inc! (aget count 2))
                  (set! stack (subslice stack _ (- (len stack) 1)))
                  (continue))


                (let [max (conv int32 0) ; latest store dependency
                    ^{:line 488} argsdone true]
                  (range [_ a (.-Args w)]
                    (when (!= (.-Block a) (.-Block w))
                      (continue))

                    (when (not (.contains sset (.-ID a)))
                      (set! stack (append stack a))
                      (.add sset (.-ID a))
                      (set! argsdone false)
                      (break))

                    (when (> (/ (aget storeNumber (.-ID a)) 3) max)
                      (set! max (/ (aget storeNumber (.-ID a)) 3))))


                  (when (not argsdone)
                    (continue))


                  (let [n (+ (* 3 max) 2)]
                    (when (== (.-Op w) OpNilCheck)
                      (set! n (+ (* 3 max) 1)))

                    (aset storeNumber (.-ID w) n)
                    (inc! (aget count n))
                    (set! stack (subslice stack _ (- (len stack) 1))))))))



          ;; convert count to prefix sum of counts: count'[i] = sum_{j<=i} count[i]
          (range [i count]
            (when (== i 0)
              (continue))

            (set! (aget count i) + (aget count (- i 1))))

          (when (!= (aget count (- (len count) 1)) (conv int32 (len values)))
            (.Fatalf f "storeOrder: value is missing, total count = %d, values = %v" (aget count (- (len count) 1)) values))


          ;; place values in count-indexed bins, which are in the desired store order
          (let [order (make (slice (* Value)) (len values))]
            (range [_ v values]
              (let [s (aget storeNumber (.-ID v))]
                (aset order (aget count (- s 1)) v)
                (inc! (aget count (- s 1)))))


            ;; Order nil checks in source order. We want the first in source order to trigger.
            ;; If two are on the same line, we don't really care which happens first.
            ;; See issue 18169.
            (when hasNilCheck
              (let [start -1]
                (range [i v order]
                  (if (== (.-Op v) OpNilCheck)
                    (when (== start -1)
                      (set! start i))

                    (do
                      (when (!= start -1)
                        (^{:inst [(slice (* Value)) (* Value)]} slices/SortFunc (subslice order start i) valuePosCmp)
                        (set! start -1)))))



                (when (!= start -1)
                  (^{:inst [(slice (* Value)) (* Value)]} slices/SortFunc (subslice order start) valuePosCmp))))



            ^{:line 558} order))))))



^{:go/breaks [[6 572]] :go/end 573} (go/method isFlagOp "isFlagOp reports if v is an OP with the flag type.\n" ^bool [^{:tag (* Value)} v]
  (when (or (.IsFlags (.-Type v)) (and (.IsTuple (.-Type v)) (.IsFlags (.FieldType (.-Type v) 1))))
    (return true))

  ;; PPC64 carry generators put their carry in a non-flag-typed register
  ;; in their output.
  (switch (.-Op v)
    (case [OpPPC64SUBC OpPPC64ADDC OpPPC64SUBCconst OpPPC64ADDCconst]
      (return true)))

  false)



^{:go/breaks [[6 588]] :go/end 589} (go/method hasFlagInput "hasFlagInput reports whether v has a flag value as any of its inputs.\n" ^bool [^{:tag (* Value)} v]
  (range [_ a (.-Args v)]
    (when (.isFlagOp a)
      (return true)))


  ;; PPC64 carry dependencies are conveyed through their final argument,
  ;; so we treat those operations as taking flags as well.
  (switch (.-Op v)
    (case [OpPPC64SUBE OpPPC64ADDE OpPPC64SUBZEzero OpPPC64ADDZE OpPPC64ADDZEzero]
      (return true)))

  false)


^{:go/breaks [[5 598]] :go/end 599} (go/func valuePosCmp ^int [^{:tag (* Value)} a ^{:tag (* Value)} b]
  (when (.Before (.-Pos a) (.-Pos b))
    (return -1))

  (when (.After (.-Pos a) (.-Pos b))
    (return (+ 1)))

  0)

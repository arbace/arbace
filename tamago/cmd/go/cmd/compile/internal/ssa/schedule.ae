^{:go/end 374} (go/func schedule "Schedule the Values in each Block. After this phase returns, the\norder of b.Values matters and is the order in which those values\nwill appear in the assembly output. For now it generates a\nreasonable valid schedule using a priority queue. TODO(khr):\nschedule smarter.\n" [^{:tag (* Func)} f]
  ;; reusable priority queue
  (let [priq (new ValHeap)

      ;; "priority" for a value
      ^{:line 112} score (.allocInt8Slice (.-Cache f) (.NumValues f))]
    (defer (.freeInt8Slice (.-Cache f) score))

    ;; maps mem values to the next live memory value

              ;; Store chains for different blocks overwrite each other, so
              ;; the calculated store chain is good only for this block.
              (range [_ v (.-Values b)]
                (when (and (!= (.-Op v) OpPhi) (!= (.-Op v) OpInitMem) (.IsMemory (.-Type v)))
                  (aset nextMem (.-ID (.MemoryArg v)) v)))



              ;; Add edges to enforce that any load must come before the following store.
              (range [_ v (.-Values b)]
                (when (or (== (.-Op v) OpPhi) (.IsMemory (.-Type v)))
                  (continue))

                (let [w (.MemoryArg v)]
                  (when (== w nil)
                    (continue))

                  (when [s (aget nextMem (.-ID w))] (and (!= s nil) (== (.-Block s) b))
                    (set! edges (append edges (lit edge v s))))))



              ;; Sort all the edges by source Value ID.
              (^{:inst [(slice edge) edge]} slices/SortFunc edges ^{:go/end 283} (fn ^int [^edge a ^edge b]
                  (^{:inst [ID]} cmp/Compare (.-ID (.-x a)) (.-ID (.-x b)))))

              ;; Compute inEdges for values in this block.
              (range [_ e edges]

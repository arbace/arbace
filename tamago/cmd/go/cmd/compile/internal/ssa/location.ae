(in-ns 'go.cmd.compile.internal.ssa) (go/file "location.go" :imports [


    ^{:line 8} [ir "cmd/compile/internal/ir"]
    ^{:line 9} [types "cmd/compile/internal/types"]
    ^{:line 10} [fmt "fmt"]])



(go/type Location "A place that an ssa variable can reside.\n" (interface
    (String ^string []))) ; name to use in assembly templates: AX, 16(SP), ...




(go/type Register "A Register is a machine register, like AX.\nThey are numbered densely from 0 (for each architecture).\n" (struct
    ^{:line 21 :tag int32} num ; dense numbering
    ^{:line 22 :tag int16} objNum ; register number from cmd/internal/obj/$ARCH
    ^{:line 23 :tag string} name))


^{:go/end 28} (go/method String ^string [^{:tag (* Register)} r]
  (.-name r))




^{:go/end 34} (go/method ObjNum "ObjNum returns the register number from cmd/internal/obj/$ARCH that\ncorresponds to this register.\n" ^int16 [^{:tag (* Register)} r]
  (.-objNum r))





















(go/type LocalSlot "A LocalSlot is a location in the stack frame, which identifies and stores\npart or all of a PPARAM, PPARAMOUT, or PAUTO ONAME node.\nIt can represent a whole variable, part of a larger stack slot, or part of a\nvariable that has been decomposed into multiple stack slots.\nAs an example, a string could have the following configurations:\n\n\t          stack layout              LocalSlots\n\n\tOptimizations are disabled. s is on the stack and represented in its entirety.\n\t[ ------- s string ---- ] { N: s, Type: string, Off: 0 }\n\n\ts was not decomposed, but the SSA operates on its parts individually, so\n\tthere is a LocalSlot for each of its fields that points into the single stack slot.\n\t[ ------- s string ---- ] { N: s, Type: *uint8, Off: 0 }, {N: s, Type: int, Off: 8}\n\n\ts was decomposed. Each of its fields is in its own stack slot and has its own LocalSLot.\n\t[ ptr *uint8 ] [ len int] { N: ptr, Type: *uint8, Off: 0, SplitOf: parent, SplitOffset: 0},\n\t                          { N: len, Type: int, Off: 0, SplitOf: parent, SplitOffset: 8}\n\t                          parent = &{N: s, Type: string}\n" (struct
    ^{:line 56 :tag (* ir/Name)} N ; an ONAME *ir.Name representing a stack location.
    ^{:line 57 :tag (* types/Type)} Type ; type of slot
    ^{:line 58 :tag int64} Off ; offset of slot in N

    ^{:line 60 :tag (* LocalSlot)} SplitOf ; slot is a decomposition of SplitOf
    ^{:line 61 :tag int64} SplitOffset)) ; .. at this offset.


^{:go/end 69} (go/method String ^string [^LocalSlot s]
  (when (== (.-Off s) 0)
    (return (fmt/Sprintf "%v[%v]" (.-N s) (.-Type s))))

  (fmt/Sprintf "%v+%d[%v]" (.-N s) (.-Off s) (.-Type s)))


(go/type LocPair (array 2 Location))

^{:go/end 82} (go/method String ^string [^LocPair t]
  (let [(values n0 n1) (values "nil" "nil")]
    (when (!= (aget t 0) nil)
      (set! n0 (.String (aget t 0))))

    (when (!= (aget t 1) nil)
      (set! n1 (.String (aget t 1))))

    (fmt/Sprintf "<%s,%s>" n0 n1)))


(go/type LocResults (slice Location))

^{:go/end 96} (go/method String ^string [^LocResults t]
  (let [s ""
      ^{:line 88} a "<"]
    (range [_ r t]
      (set! a + s)
      (set! s ",")
      (set! a + (.String r)))

    (set! a + ">")
    ^{:line 95} a))


(go/type Spill (struct
    ^{:line 99 :tag (* types/Type)} Type
    ^{:line 100 :tag int64} Offset
    ^{:line 101 :tag int16} Reg))

^{:go/end 661} (go/func memCheck [^{:tag (* Func)} f]
  ;; Check that if a tuple has a memory type, it is second.
  (range [_ b (.-Blocks f)]
    (range [_ v (.-Values b)]
      (when (and (.IsTuple (.-Type v)) (.IsMemory (.FieldType (.-Type v) 0)))
        (.Fatalf f "memory is first in a tuple: %s\n" (.LongString v)))))




  ;; Single live memory checks.
  ;; These checks only work if there are no memory copies.
  ;; (Memory copies introduce ambiguity about which mem value is really live.
  ;; probably fixable, but it's easier to avoid the problem.)
  ;; For the same reason, disable this check if some memory ops are unused.
  (range [_ b (.-Blocks f)]
    (range [_ v (.-Values b)]
      (when (and ^:go/paren (or (== (.-Op v) OpCopy) (== (.-Uses v) 0)) (.IsMemory (.-Type v)))
        (return)))


    (when (and (!= b (.-Entry f)) (== (len (.-Preds b)) 0))
      (return)))



  ;; Compute live memory at the end of each block.
  (let [lastmem (make (slice (* Value)) (.NumBlocks f))
      ^{:line 541} ss (newSparseSet (.NumValues f))]
    (range [_ b (.-Blocks f)]
      ;; Mark overwritten memory values. Those are args of other
      ;; ops that generate memory values.
      (.clear ss)
      (range [_ v (.-Values b)]
        (when (or (== (.-Op v) OpPhi) (not (.IsMemory (.-Type v))))
          (continue))

        (when [m (.MemoryArg v)] (!= m nil)
          (.add ss (.-ID m))))


      ;; There should be at most one remaining unoverwritten memory value.
      (range [_ v (.-Values b)]
        (when (not (.IsMemory (.-Type v)))
          (continue))

        (when (.contains ss (.-ID v))
          (continue))

        (when (!= (aget lastmem (.-ID b)) nil)
          (.Fatalf f "two live memory values in %s: %s and %s" b (aget lastmem (.-ID b)) v))

        (aset lastmem (.-ID b) v))

      ;; If there is no remaining memory value, that means there was no memory update.
      ;; Take any memory arg.
      (when (== (aget lastmem (.-ID b)) nil)
        (range [_ v (.-Values b)]
          (when (== (.-Op v) OpPhi)
            (continue))

          (let [m (.MemoryArg v)]
            (when (== m nil)
              (continue))

            (when (and (!= (aget lastmem (.-ID b)) nil) (!= (aget lastmem (.-ID b)) m))
              (.Fatalf f "two live memory values in %s: %s and %s" b (aget lastmem (.-ID b)) m))

            (aset lastmem (.-ID b) m)))))



    ;; Propagate last live memory through storeless blocks.
    (while true
      (let [changed false]
        (range [_ b (.-Blocks f)]
          (when (!= (aget lastmem (.-ID b)) nil)
            (continue))

          (range [_ e (.-Preds b)]
            (let [p (.-b e)]
              (when (!= (aget lastmem (.-ID p)) nil)

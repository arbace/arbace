    ;; Check merge points.
    (range [_ b (.-Blocks f)]
      (range [_ v (.-Values b)]
        (when (and (== (.-Op v) OpPhi) (.IsMemory (.-Type v)))
          (range [i a (.-Args v)]
            (when (!= a (aget lastmem (.-ID (.-b (aget (.-Preds b) i)))))
              (.Fatalf f "inconsistent memory phi %s %d %s %s" (.LongString v) i a (aget lastmem (.-ID (.-b (aget (.-Preds b) i))))))))))






    ;; Check that only one memory is live at any point.
    (when (.-scheduled f)
      (range [_ b (.-Blocks f)]
        (let [^{:tag (* Value)} mem (zero (* Value))] ; the current live memory in the block
          (range [_ v (.-Values b)]
            (when (== (.-Op v) OpPhi)
              (when (.IsMemory (.-Type v))
                (set! mem v))

              (continue))

            (when (and (== mem nil) (> (len (.-Preds b)) 0))
              ;; If no mem phi, take mem of any predecessor.
              (set! mem (aget lastmem (.-ID (.-b (aget (.-Preds b) 0))))))

            (range [_ a (.-Args v)]
              (when (and (.IsMemory (.-Type a)) (!= a mem))
                (.Fatalf f "two live mems @ %s: %s and %s" v mem a)))


            (when (.IsMemory (.-Type v))
              (set! mem v))))))





    ;; Check that after scheduling, phis are always first in the block.
    (when (.-scheduled f)
      (range [_ b (.-Blocks f)]
        (let [seenNonPhi false]
          (range [_ v (.-Values b)]
            (switch (.-Op v)
              (case [OpPhi]
                (when seenNonPhi
                  (.Fatalf f "phi after non-phi @ %s: %s" b v)))

              (default
                (set! seenNonPhi true)))))))))







^{:go/end 670} (go/func domCheck "domCheck reports whether x dominates y (including x==y).\n" ^bool [^{:tag (* Func)} f ^SparseTree sdom ^{:tag (* Block)} x ^{:tag (* Block)} y]
  (when (not (.IsAncestorEq sdom (.-Entry f) y))
    ;; unreachable - ignore
    (return true))

  (.IsAncestorEq sdom x y))



^{:go/end 680} (go/func isExactFloat32 "isExactFloat32 reports whether x can be exactly represented as a float32.\n" ^bool [^float64 x]
  ;; Check the mantissa is in range.
  (when (< (bits/TrailingZeros64 (math/Float64bits x)) (- 52 23))
    (return false))

  ;; Check the exponent is in range. The mantissa check above is sufficient for NaN values.
  (or (math/IsNaN x) (== x (conv float64 (conv float32 x)))))

                    ^{:line 366} OpEq16 OpNeq16 OpLess16 OpLeq16
                    ^{:line 367} OpNeg16 OpCom16
                    ^{:line 368} OpSignExt16to32 OpSignExt16to64
                    ^{:line 369} OpZeroExt16to32 OpZeroExt16to64
                    ^{:line 370} OpTrunc16to8]
                  (set! argSize 2))
                (case [OpAdd32 OpSub32 OpMul32 OpDiv32 OpDiv32u OpMod32 OpMod32u

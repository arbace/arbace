                    ^{:line 374} OpEq32 OpNeq32 OpLess32 OpLeq32
                    ^{:line 375} OpNeg32 OpCom32
                    ^{:line 376} OpSignExt32to64 OpZeroExt32to64
                    ^{:line 377} OpTrunc32to8 OpTrunc32to16]
                  (set! argSize 4))
                (case [OpAdd64 OpSub64 OpMul64 OpDiv64 OpDiv64u OpMod64 OpMod64u

^{:go/end 511} (go/func checkFunc "checkFunc checks invariants of f.\n" [^{:tag (* Func)} f]
  (let [blockMark (make (slice bool) (.NumBlocks f))
      ^{:line 17} valueMark (make (slice bool) (.NumValues f))]

    (range [_ b (.-Blocks f)]
      (when (aget blockMark (.-ID b))

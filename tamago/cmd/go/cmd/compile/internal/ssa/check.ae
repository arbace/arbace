                    ^{:line 360} OpNeg8 OpCom8
                    ^{:line 361} OpSignExt8to16 OpSignExt8to32 OpSignExt8to64
                    ^{:line 362} OpZeroExt8to16 OpZeroExt8to32 OpZeroExt8to64]
                  (set! argSize 1))
                (case [OpAdd16 OpSub16 OpMul16 OpDiv16 OpDiv16u OpMod16 OpMod16u

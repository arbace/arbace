    (panic "empty undo stack"))

  (when debugPoset
    (defer (.CheckIntegrity po)))


  (while (> (len (.-undo po)) 0)
    (let [pass (aget (.-undo po) (- (len (.-undo po)) 1))]
      (set! (.-undo po) (subslice (.-undo po) _ (- (len (.-undo po)) 1)))

      (switch (.-typ pass)
        (case [undoCheckpoint]
          (return))

        (case [undoSetChl]
          (.setchl po (.-idx pass) (.-edge pass)))

        (case [undoSetChr]
          (.setchr po (.-idx pass) (.-edge pass)))


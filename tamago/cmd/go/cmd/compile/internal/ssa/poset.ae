          ;; Already aliased, ignore
          (return true))


        ;; If we recorded that n1!=n2, this is a contradiction.
        (when (.isnoneq po i1 i2)
          (return false))


        ;; If we already knew that n1<=n2, we can collapse the path to
        ;; record n1==n2 (and vice versa).
        (when (.reaches po i1 i2 false)
          (return (.collapsepath po n1 n2)))

        (when (.reaches po i2 i1 false)
          (return (.collapsepath po n2 n1)))


        (let [r1 (.findroot po i1)
            ^{:line 992} r2 (.findroot po i2)]
          (when (!= r1 r2)
            ;; Merge the two DAGs so we can record relations between the nodes
            (.mergeroot po r1 r2))


          ;; Set n2 as alias of n1. This will also update all the references
          ;; to n2 to become references to n1
          (let [i2s (newBitset (+ (conv int (.-lastidx po)) 1))]
            (.Set i2s i2)
            (.aliasnodes po n1 i2s)))))

    true))





^{:go/end 1054} (go/method SetNonEqual "SetNonEqual records that n1!=n2. Returns false if this is a contradiction\n(that is, if it is already recorded that n1==n2).\nComplexity is O(n).\n" ^bool [^{:tag (* poset)} po ^{:tag (* Value)} n1 ^{:tag (* Value)} n2]
  (when debugPoset
    (defer (.CheckIntegrity po)))

  (when (== (.-ID n1) (.-ID n2))
    (panic "should not call SetNonEqual with n1==n2"))


  ;; Check whether the nodes are already in the poset
  ^{:go/breaks [[8 1053]]} (let [(values i1 f1) (.lookup po n1)
      (values i2 f2) (.lookup po n2)]

    ;; If either node wasn't present, we just record the new relation
    ;; and exit.
    (when (or (not f1) (not f2))
      (.setnoneq po n1 n2)

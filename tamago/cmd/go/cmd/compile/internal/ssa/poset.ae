^{:go/end 340} (go/method aliasnodes "aliasnodes records that all the nodes i2s are aliases of a single master node n1.\naliasnodes takes care of rearranging the DAG, changing references of parent/children\nof nodes in i2s, so that they point to n1 instead.\nComplexity is O(n) (with n being the total number of nodes in the poset, not just\nthe number of nodes being aliased).\n" [^{:tag (* poset)} po ^{:tag (* Value)} n1 ^bitset i2s]
  (let [i1 (aget (.-values po) (.-ID n1))]
    (when (== i1 0)
      (panic "aliasnode for non-existing node"))

    (when (.Test i2s i1)
      (panic "aliasnode i2s contains n1 node"))


    ;; Go through all the nodes to adjust parent/chidlren of nodes in i2s
    (range [idx n (.-nodes po)]
      ;; Do not touch i1 itself, otherwise we can create useless self-loops
      (when (== (conv uint32 idx) i1)
        (continue))

      (let [(values l r) (values (.-l n) (.-r n))]

        ;; Rename all references to i2s into i1
        (when (.Test i2s (.Target l))
          (.setchl po (conv uint32 idx) (newedge i1 (.Strict l)))
          (.upush po undoSetChl (conv uint32 idx) l))

        (when (.Test i2s (.Target r))
          (.setchr po (conv uint32 idx) (newedge i1 (.Strict r)))
          (.upush po undoSetChr (conv uint32 idx) r))


        ;; Connect all children of i2s to i1 (unless those children
        ;; are in i2s as well, in which case it would be useless)
        (when (.Test i2s (conv uint32 idx))
          (when (and (!= l 0) (not (.Test i2s (.Target l))))
            (.addchild po i1 (.Target l) (.Strict l)))

          (when (and (!= r 0) (not (.Test i2s (.Target r))))
            (.addchild po i1 (.Target r) (.Strict r)))

          (.setchl po (conv uint32 idx) 0)
          (.setchr po (conv uint32 idx) 0)
          (.upush po undoSetChl (conv uint32 idx) l)
          (.upush po undoSetChr (conv uint32 idx) r))))



    ;; Reassign all existing IDs that point to i2 to i1.
    ;; This includes n2.ID.
    (range [k v (.-values po)]
      (when (.Test i2s v)
        (aset (.-values po) k i1)
        (.upushalias po k v)))))





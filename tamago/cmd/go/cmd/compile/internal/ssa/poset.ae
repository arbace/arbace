          (.addchild po i1 i2 strict))))


    true))




^{:go/end 933} (go/method SetOrder "SetOrder records that n1<n2. Returns false if this is a contradiction\nComplexity is O(1) if n2 was never seen before, or O(n) otherwise.\n" ^bool [^{:tag (* poset)} po ^{:tag (* Value)} n1 ^{:tag (* Value)} n2]
  (when debugPoset
    (defer (.CheckIntegrity po)))

  (when (== (.-ID n1) (.-ID n2))
    (panic "should not call SetOrder with n1==n2"))

  (.setOrder po n1 n2 true))




^{:go/end 945} (go/method SetOrderOrEqual "SetOrderOrEqual records that n1<=n2. Returns false if this is a contradiction\nComplexity is O(1) if n2 was never seen before, or O(n) otherwise.\n" ^bool [^{:tag (* poset)} po ^{:tag (* Value)} n1 ^{:tag (* Value)} n2]
  (when debugPoset
    (defer (.CheckIntegrity po)))

  (when (== (.-ID n1) (.-ID n2))
    (panic "should not call SetOrder with n1==n2"))

  (.setOrder po n1 n2 false))





^{:go/end 1005} (go/method SetEqual "SetEqual records that n1==n2. Returns false if this is a contradiction\n(that is, if it is already recorded that n1<n2 or n2<n1).\nComplexity is O(1) if n2 was never seen before, or O(n) otherwise.\n" ^bool [^{:tag (* poset)} po ^{:tag (* Value)} n1 ^{:tag (* Value)} n2]
  (when debugPoset
    (defer (.CheckIntegrity po)))

  (when (== (.-ID n1) (.-ID n2))
    (panic "should not call Add with n1==n2"))


  ^{:go/breaks [[3 1004]]} (let [(values i1 f1) (.lookup po n1)
      (values i2 f2) (.lookup po n2)]

    (switch
      (case [(and (not f1) (not f2))]
        (set! i1 (.newnode po n1))
        (set! (.-roots po) (append (.-roots po) i1))
        (.upush po undoNewRoot i1 0)
        (.aliasnewnode po n1 n2))
      (case [(and f1 (not f2))]
        (.aliasnewnode po n1 n2))
      (case [(and (not f1) f2)]
        (.aliasnewnode po n2 n1))

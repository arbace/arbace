        (case [undoNewRoot]
          (let [i (.-idx pass)
              (values l r) (.children po i)]
            (when (!= (bit-or l r) 0)
              (panic "non-empty root in undo newroot"))

            (.removeroot po i)))

        (case [undoChangeRoot]
          (let [i (.-idx pass)
              (values l r) (.children po i)]

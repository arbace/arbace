^{:go/end 246} (go/method addchild "addchild adds i2 as direct child of i1.\n" [^{:tag (* poset)} po ^uint32 i1 ^uint32 i2 ^bool strict]
  (let [(values i1l i1r) (.children po i1)
      ^{:line 212} e2 (newedge i2 strict)]

    (cond (== i1l 0) (do
        (.setchl po i1 e2)
        (.upush po undoSetChl i1 0))
      (== i1r 0) (do
        (.setchr po i1 e2)
        (.upush po undoSetChr i1 0)) :else

      ;; If n1 already has two children, add an intermediate extra
      ;; node to record the relation correctly (without relating
      ;; n2 to other existing nodes). Use a non-deterministic value
      ;; to decide whether to append on the left or the right, to avoid
      ;; creating degenerated chains.
      ;;
      ;;      n1
      ;;     /  \
      ;;   i1l  extra
      ;;        /   \
      ;;      i1r   n2
      ;;
      (let [extra (.newnode po nil)]
        (if (!= (bit-and (bit-xor i1 i2) 1) 0) (do ; non-deterministic
            (.setchl po extra i1r)
            (.setchr po extra e2)
            (.setchr po i1 (newedge extra false))
            (.upush po undoSetChr i1 i1r))
          (do
            (.setchl po extra i1l)
            (.setchr po extra e2)
            (.setchl po i1 (newedge extra false))
            (.upush po undoSetChl i1 i1l)))))))







    ;; otherwise there cannot be an existing relation.
    (when (and (.reaches po i1 i2 false) (not (.reaches po i1 i2 true)))
      (.addchild po i1 i2 true))

    (when (and (.reaches po i2 i1 false) (not (.reaches po i2 i1 true)))
      (.addchild po i2 i1 true))


    true))





^{:go/end 1061} (go/method Checkpoint "Checkpoint saves the current state of the DAG so that it's possible\nto later undo this state.\nComplexity is O(1).\n" [^{:tag (* poset)} po]
  (set! (.-undo po) (append (.-undo po) (lit posetUndo :typ undoCheckpoint))))






^{:go/end 1151} (go/method Undo "Undo restores the state of the poset to the previous checkpoint.\nComplexity depends on the type of operations that were performed\nsince the last checkpoint; each Set* operation creates an undo\npass which Undo has to revert with a worst-case complexity of O(n).\n" [^{:tag (* poset)} po]

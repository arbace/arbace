^{:go/end 623} (go/method CheckIntegrity "CheckIntegrity verifies internal integrity of a poset. It is intended\nfor debugging purposes.\n" [^{:tag (* poset)} po]
  ;; Verify that each node appears in a single DAG
  (let [seen (newBitset (conv int (+ (.-lastidx po) 1)))]
    (range [_ r (.-roots po)]
      (when (== r 0)
        (panic "empty root"))


      (.dfs po r false ^{:go/breaks [4] :go/end 602} (fn ^bool [^uint32 i]
          (when (.Test seen i)
            (panic "duplicate node"))

          (.Set seen i)
          false)))



    ;; Verify that values contain the minimum set
    (range [id idx (.-values po)]
      (when (not (.Test seen idx))
        (panic (fmt/Errorf "spurious value [%d]=%d" id idx))))



    ;; Verify that only existing nodes have non-zero children
    (range [i n (.-nodes po)]
      (when (!= (bit-or (.-l n) (.-r n)) 0)
        (when (not (.Test seen (conv uint32 i)))
          (panic (fmt/Errorf "children of unknown node %d->%v" i n)))

        (when (or (== (.Target (.-l n)) (conv uint32 i)) (== (.Target (.-r n)) (conv uint32 i)))
          (panic (fmt/Errorf "self-loop on node %d" i)))))))








^{:go/breaks [[10 651]] :go/end 652} (go/method CheckEmpty "CheckEmpty checks that a poset is completely empty.\nIt can be used for debugging purposes, as a poset is supposed to\nbe empty after it's fully rolled back through Undo.\n" ^error [^{:tag (* poset)} po]
  (when (!= (len (.-nodes po)) 1)
    (return (fmt/Errorf "non-empty nodes list: %v" (.-nodes po))))

  (when (!= (len (.-values po)) 0)
    (return (fmt/Errorf "non-empty value map: %v" (.-values po))))

  (when (!= (len (.-roots po)) 0)
    (return (fmt/Errorf "non-empty root list: %v" (.-roots po))))

  (when (!= (len (.-undo po)) 0)
    (return (fmt/Errorf "non-empty undo list: %v" (.-undo po))))

  (when (!= (.-lastidx po) 0)
    (return (fmt/Errorf "lastidx index is not zero: %v" (.-lastidx po))))

  (range [_ bs (.-noneq po)]
    (range [_ x bs]
      (when (!= x 0)
        (return (fmt/Errorf "non-empty noneq map")))))




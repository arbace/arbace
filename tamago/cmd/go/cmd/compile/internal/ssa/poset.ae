^{:go/end 282} (go/method aliasnewnode "aliasnewnode records that a single node n2 (not in the poset yet) is an alias\nof the master node n1.\n" [^{:tag (* poset)} po ^{:tag (* Value)} n1 ^{:tag (* Value)} n2]

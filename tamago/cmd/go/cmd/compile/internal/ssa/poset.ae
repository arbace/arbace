                  (if (.Strict l)
                    (set! next (append next (.Target l)))

                    (set! open (append open (.Target l)))))


                (when (!= r 0)
                  (if (.Strict r)
                    (set! next (append next (.Target r)))

                    (set! open (append open (.Target r)))))))))




        (set! open next)
        (.Reset closed)))


    (while (> (len open) 0)
      (let [i (aget open (- (len open) 1))]
        (set! open (subslice open _ (- (len open) 1)))

        (when (not (.Test closed i))
          (when (f i)
            (return true))

          (.Set closed i)
          (let [(values l r) (.children po i)]
            (when (!= l 0)
              (set! open (append open (.Target l))))

            (when (!= r 0)
              (set! open (append open (.Target r))))))))



    false))







^{:go/end 699} (go/method DotDump "DotDump dumps the poset in graphviz format to file fn, with the specified title.\n" ^error [^{:tag (* poset)} po ^string fn ^string title]
  (let [(values f err) (os/Create fn)]
    (when (!= err nil)
      (return err))

    (defer (.Close f))

    ;; Create reverse index mapping (taking aliases into account)
    ^{:go/breaks [10]} (let [names (make (map uint32 string))]
      (range [id i (.-values po)]
        (let [s (aget names i)]
          (if (== s "")
            (set! s (fmt/Sprintf "v%d" id))

            (set! s + (fmt/Sprintf ", v%d" id)))

          (aset names i s)))


      (fmt/Fprintf f "digraph poset {\n")
      (fmt/Fprintf f "\tedge [ fontsize=10 ]\n")
      (range [ridx r (.-roots po)]
        (fmt/Fprintf f "\tsubgraph root%d {\n" ridx)
        (.dfs po r false ^{:go/end 691} (fn ^bool [^uint32 i]
            (fmt/Fprintf f "\t\tnode%d [label=<%s <font point-size=\"6\">[%d]</font>>]\n" i (aget names i) i)
            ^{:go/breaks [[3 690]]} (let [(values chl chr) (.children po i)]
              (range [_ ch (lit (slice posetEdge) chl chr)]
                (when (!= ch 0)
                  (if (.Strict ch)
                    (fmt/Fprintf f "\t\tnode%d -> node%d [label=\" <\" color=\"red\"]\n" i (.Target ch))

                    (fmt/Fprintf f "\t\tnode%d -> node%d [label=\" <=\" color=\"green\"]\n" i (.Target ch)))))



              false)))

        (fmt/Fprintf f "\t}\n"))

      (fmt/Fprintf f "\tlabelloc=\"t\"\n")
      (fmt/Fprintf f "\tlabeldistance=\"3.0\"\n")
      (fmt/Fprintf f "\tlabel=%q\n" title)
      (fmt/Fprintf f "}\n")
      nil)))






^{:go/end 720} (go/method Ordered "Ordered reports whether n1<n2. It returns false either when it is\ncertain that n1<n2 is false, or if there is not enough information\nto tell.\nComplexity is O(n).\n" ^bool [^{:tag (* poset)} po ^{:tag (* Value)} n1 ^{:tag (* Value)} n2]
  (when debugPoset
    (defer (.CheckIntegrity po)))

  (when (== (.-ID n1) (.-ID n2))
    (panic "should not call Ordered with n1==n2"))


  (let [(values i1 f1) (.lookup po n1)
      (values i2 f2) (.lookup po n2)]
    (when (or (not f1) (not f2))
      (return false))


    (and (!= i1 i2) (.reaches po i1 i2 true))))






^{:go/end 741} (go/method OrderedOrEqual "OrderedOrEqual reports whether n1<=n2. It returns false either when it is\ncertain that n1<=n2 is false, or if there is not enough information\nto tell.\nComplexity is O(n).\n" ^bool [^{:tag (* poset)} po ^{:tag (* Value)} n1 ^{:tag (* Value)} n2]
  (when debugPoset
    (defer (.CheckIntegrity po)))

  (when (== (.-ID n1) (.-ID n2))
    (panic "should not call Ordered with n1==n2"))


  (let [(values i1 f1) (.lookup po n1)
      (values i2 f2) (.lookup po n2)]
    (when (or (not f1) (not f2))
      (return false))


    (or (== i1 i2) (.reaches po i1 i2 false))))






^{:go/end 758} (go/method Equal "Equal reports whether n1==n2. It returns false either when it is\ncertain that n1==n2 is false, or if there is not enough information\nto tell.\nComplexity is O(1).\n" ^bool [^{:tag (* poset)} po ^{:tag (* Value)} n1 ^{:tag (* Value)} n2]
  (when debugPoset
    (defer (.CheckIntegrity po)))

  (when (== (.-ID n1) (.-ID n2))
    (panic "should not call Equal with n1==n2"))


  (let [(values i1 f1) (.lookup po n1)
      (values i2 f2) (.lookup po n2)]
    (and f1 f2 (== i1 i2))))







^{:go/end 792} (go/method NonEqual "NonEqual reports whether n1!=n2. It returns false either when it is\ncertain that n1!=n2 is false, or if there is not enough information\nto tell.\nComplexity is O(n) (because it internally calls Ordered to see if we\ncan infer n1!=n2 from n1<n2 or n2<n1).\n" ^bool [^{:tag (* poset)} po ^{:tag (* Value)} n1 ^{:tag (* Value)} n2]
  (when debugPoset
    (defer (.CheckIntegrity po)))

  (when (== (.-ID n1) (.-ID n2))
    (panic "should not call NonEqual with n1==n2"))


  ;; If we never saw the nodes before, we don't
  ;; have a recorded non-equality.
  ^{:go/breaks [[5 791]]} (let [(values i1 f1) (.lookup po n1)
      (values i2 f2) (.lookup po n2)]
    (when (or (not f1) (not f2))
      (return false))


    ;; Check if we recorded inequality
    (when (.isnoneq po i1 i2)
      (return true))


    ;; Check if n1<n2 or n2<n1, in which case we can infer that n1!=n2
    (when (or (.Ordered po n1 n2) (.Ordered po n2 n1))
      (return true))


    false))





^{:go/end 921} (go/method setOrder "setOrder records that n1<n2 or n1<=n2 (depending on strict). Returns false\nif this is a contradiction.\nImplements SetOrder() and SetOrderOrEqual()\n" ^bool [^{:tag (* poset)} po ^{:tag (* Value)} n1 ^{:tag (* Value)} n2 ^bool strict]
  ^{:go/breaks [[3 920]]} (let [(values i1 f1) (.lookup po n1)
      (values i2 f2) (.lookup po n2)]

    (switch
      (case [(and (not f1) (not f2))]
        ;; Neither n1 nor n2 are in the poset, so they are not related
        ;; in any way to existing nodes.
        ;; Create a new DAG to record the relation.
        (set! (values i1 i2) (values (.newnode po n1) (.newnode po n2)))
        (set! (.-roots po) (append (.-roots po) i1))
        (.upush po undoNewRoot i1 0)
        (.addchild po i1 i2 strict))

      (case [(and f1 (not f2))]
        ;; n1 is in one of the DAGs, while n2 is not. Add n2 as children
        ;; of n1.
        (set! i2 (.newnode po n2))
        (.addchild po i1 i2 strict))

      (case [(and (not f1) f2)]
        ;; n1 is not in any DAG but n2 is. If n2 is a root, we can put
        ;; n1 in its place as a root; otherwise, we need to create a new
        ;; extra root to record the relation.
        (set! i1 (.newnode po n1))

        (when (.isroot po i2)
          (.changeroot po i2 i1)
          (.upush po undoChangeRoot i1 (newedge i2 strict))
          (.addchild po i1 i2 strict)
          (return true))


        ;; Search for i2's root; this requires a O(n) search on all
        ;; DAGs
        (let [r (.findroot po i2)

            ;; Re-parent as follows:
            ;;
            ;;                  extra
            ;;     r            /   \
            ;;      \   ===>   r    i1
            ;;      i2          \   /
            ;;                    i2
            ;;
            ^{:line 842} extra (.newnode po nil)]
          (.changeroot po r extra)
          (.upush po undoChangeRoot extra (newedge r false))
          (.addchild po extra r false)
          (.addchild po extra i1 false)
          (.addchild po i1 i2 strict)))

      (case [(and f1 f2)]
        ;; If the nodes are aliased, fail only if we're setting a strict order
        ;; (that is, we cannot set n1<n2 if n1==n2).
        (when (== i1 i2)
          (return (not strict)))


        ;; If we are trying to record n1<=n2 but we learned that n1!=n2,
        ;; record n1<n2, as it provides more information.
        (when (and (not strict) (.isnoneq po i1 i2))
          (set! strict true))


        ;; Both n1 and n2 are in the poset. This is the complex part of the algorithm
        ;; as we need to find many different cases and DAG shapes.

        ;; Check if n1 somehow reaches n2
        (when (.reaches po i1 i2 false)
          ;; This is the table of all cases we need to handle:
          ;;
          ;;      DAG          New      Action
          ;;      ---------------------------------------------------
          ;; #1:  N1<=X<=N2 |  N1<=N2 | do nothing
          ;; #2:  N1<=X<=N2 |  N1<N2  | add strict edge (N1<N2)
          ;; #3:  N1<X<N2   |  N1<=N2 | do nothing (we already know more)
          ;; #4:  N1<X<N2   |  N1<N2  | do nothing

          ;; Check if we're in case #2
          (when (and strict (not (.reaches po i1 i2 true)))
            (.addchild po i1 i2 true)
            (return true))


          ;; Case #1, #3, or #4: nothing to do
          (return true))


        ;; Check if n2 somehow reaches n1
        (when (.reaches po i2 i1 false)
          ;; This is the table of all cases we need to handle:
          ;;
          ;;      DAG           New      Action
          ;;      ---------------------------------------------------
          ;; #5:  N2<=X<=N1  |  N1<=N2 | collapse path (learn that N1=X=N2)
          ;; #6:  N2<=X<=N1  |  N1<N2  | contradiction
          ;; #7:  N2<X<N1    |  N1<=N2 | contradiction in the path
          ;; #8:  N2<X<N1    |  N1<N2  | contradiction

          (when strict
            ;; Cases #6 and #8: contradiction
            (return false))


          ;; We're in case #5 or #7. Try to collapse path, and that will
          ;; fail if it realizes that we are in case #7.
          (return (.collapsepath po n2 n1)))


        ;; We don't know of any existing relation between n1 and n2. They could
        ;; be part of the same DAG or not.
        ;; Find their roots to check whether they are in the same DAG.
        (let [(values r1 r2) (values (.findroot po i1) (.findroot po i2))]
          (when (!= r1 r2)
            ;; We need to merge the two DAGs to record a relation between the nodes
            (.mergeroot po r1 r2))



(in-ns 'go.cmd.compile.internal.ssa) (go/file "uses.go" :imports [])



























(go/type useInfo "useInfo provides a map from a value to the users of that value.\nWe do not keep track of this data in the IR directly, as it is\nexpensive to keep updated. But sometimes we need to compute it\ntemporarily.\n\nA useInfo is only valid until the next modification of the IR.\n\nNote that block control uses are not reported. (TODO: add\nif needed.)\nAlso, index of use is not reported. (TODO: add if needed.)\n\nWe keep track of all uses in a single array, and use a\nstarts array to tell us where to find the sub-array for\neach value.\n\nFor a function with 10 values, we would have:\n\n\tstarts[0]    starts[1]  starts[2] starts[9]   len(uses)\n\t    |            |            |     |            |\n\t    v            v            v     v            v\n\t    +------------+------------+-...-+------------+\n\t    | uses of v0 | uses of v1 | ... | uses of v9 |\n\t    +------------+------------+-...-+------------+\n\nWe can find all the uses of v by listing all entries\nof uses between starts[v.ID] and starts[v.ID+1].\n" (struct
    ^{:line 34 :tag (slice int32)} starts
    ^{:line 35 :tag (slice (* Value))} uses))




^{:go/end 84} (go/func uses "build useInfo for a function. Result only valid until\nthe next modification of f.\n" ^useInfo [^{:tag (* Func)} f]
  ;; Write down number of uses of each value.
  (let [idx (.allocInt32Slice (.-Cache f) (.NumValues f))]
    (range [_ b (.-Blocks f)]
      (range [_ v (.-Values b)]
        (aset idx (.-ID v) (.-Uses v))))



    ;; Compute cumulative sum of uses up to and
    ;; including each value ID.
    (let [^int32 cum (zero int32)]
      (range [vid uses idx]
        (set! cum + uses)
        (aset idx vid cum))


      ;; Compute uses.
      (let [uses (.allocValueSlice (.-Cache f) (conv int cum))]
        (range [_ b (.-Blocks f)]
          (range [_ v (.-Values b)]
            (range [_ a (.-Args v)]
              (dec! (aget idx (.-ID a)))
              (aset uses (aget idx (.-ID a)) v))))



        (range [_ b (.-Blocks f)]
          (range [_ c (.ControlValues b)]
            ;; We don't track block control uses, but
            ;; we have to decrement idx values here
            ;; so that the accounting comes out right.
            ;; Each value will have, at the start of its
            ;; use list, a bunch of nils that represent
            ;; the number of Block.Control uses.
            (dec! (aget idx (.-ID c)))))



        ;; The loop above decremented each idx entry
        ;; by the number of uses. It now contains
        ;; the sum of uses up to, but not including,
        ;; each value ID.
        (lit useInfo :starts idx :uses uses)))))






^{:go/end 104} (go/method get "get returns a list of uses of v.\nEvery use in an argument slot is listed (e.g. for\nw=(Add v v), w is listed twice in the uses of v).\nUses by Block.Controls are not reported.\n" ^{:tag (slice (* Value))} [^useInfo u ^{:tag (* Value)} v]
  (let [i (aget (.-starts u) (.-ID v))
      ^{:line 92 :tag int32} j (zero int32)]
    (if (< (conv int (.-ID v)) (- (len (.-starts u)) 1))
      (set! j (aget (.-starts u) (+ (.-ID v) 1)))

      (set! j (conv int32 (len (.-uses u)))))

    (let [r (subslice (.-uses u) i j)]
      ;; skip nil entries from block control uses
      (while (and (> (len r) 0) (== (aget r 0) nil))
        (set! r (subslice r 1)))

      ^{:line 103} r)))


^{:go/end 109} (go/method free [^useInfo u ^{:tag (* Func)} f]
  (.freeInt32Slice (.-Cache f) (.-starts u))
  (.freeValueSlice (.-Cache f) (.-uses u)))

(in-ns 'go.cmd.compile.internal.ssa) (go/file "checkbce.go" :imports [

    ^{:line 7} [logopt "cmd/compile/internal/logopt"]])





^{:go/end 38} (go/func checkbce "checkbce prints all bounds checks that are present in the function.\nUseful to find regressions. checkbce is only activated when with\ncorresponding debug options, so it's off by default.\nSee test/checkbce.go\n" [^{:tag (* Func)} f]
  (when (and (<= (.-debug (.-pass f)) 0) (not (logopt/Enabled)))
    (return))


  (range [_ b (.-Blocks f)]
    (when (== (.-Kind b) BlockInvalid)
      (continue))

    (range [_ v (.-Values b)]
      (when (or (== (.-Op v) OpIsInBounds) (== (.-Op v) OpIsSliceInBounds))
        (when (> (.-debug (.-pass f)) 0)
          (.Warnl f (.-Pos v) "Found %v" (.-Op v)))

        (when (logopt/Enabled)
          (when (== (.-Op v) OpIsInBounds)
            (logopt/LogOpt (.-Pos v) "isInBounds" "checkbce" (.-Name f)))

          (when (== (.-Op v) OpIsSliceInBounds)
            (logopt/LogOpt (.-Pos v) "isSliceInBounds" "checkbce" (.-Name f))))))))

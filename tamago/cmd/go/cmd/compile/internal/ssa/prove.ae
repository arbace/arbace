    (set! score (max score (+ (getDependencyScore scores a) 1))))

  ^{:line 3144} score)





^{:go/end 3177} (go/method topoSortValuesInBlock "topoSortValuesInBlock ensure ranging over b.Values visit values before they are being used.\nIt does not consider dependencies with other blocks; thus Phi nodes are considered to not have any dependencies.\nThe result is always deterministic and does not depend on the previous slice ordering.\n" [^{:tag (* factsTable)} ft ^{:tag (* Block)} b]

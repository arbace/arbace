^{:go/end 3108} (go/func isConstDelta "isConstDelta returns non-nil if v is equivalent to w+delta (signed).\n" [^{:tag (* Value)} v] :results [^{:tag (* Value)} w ^int64 delta]
  (let [cop OpConst64]
    (switch (.-Op v)
      (case [OpAdd32 OpSub32]
        (set! cop OpConst32))
      (case [OpAdd16 OpSub16]
        (set! cop OpConst16))
      (case [OpAdd8 OpSub8]
        (set! cop OpConst8)))

    (switch (.-Op v)
      (case [OpAdd64 OpAdd32 OpAdd16 OpAdd8]
        (when (== (.-Op (aget (.-Args v) 0)) cop)
          (return (aget (.-Args v) 1) (.-AuxInt (aget (.-Args v) 0))))

        (when (== (.-Op (aget (.-Args v) 1)) cop)
          (return (aget (.-Args v) 0) (.-AuxInt (aget (.-Args v) 1)))))

      (case [OpSub64 OpSub32 OpSub16 OpSub8]
        (when (== (.-Op (aget (.-Args v) 1)) cop)
          (let [aux (.-AuxInt (aget (.-Args v) 1))]
            (when (!= aux (- aux)) ; Overflow; too bad
              (return (aget (.-Args v) 0) (- aux)))))))



    (return nil 0)))




^{:go/breaks [[5 3124]] :go/end 3125} (go/func isCleanExt "isCleanExt reports whether v is the result of a value-preserving\nsign or zero extension.\n" ^bool [^{:tag (* Value)} v]
  (switch (.-Op v)
    (case [OpSignExt8to16 OpSignExt8to32 OpSignExt8to64
        ^{:line 3115} OpSignExt16to32 OpSignExt16to64 OpSignExt32to64]
      ;; signed -> signed is the only value-preserving sign extension
      (return (and (.IsSigned (.-Type (aget (.-Args v) 0))) (.IsSigned (.-Type v)))))

    (case [OpZeroExt8to16 OpZeroExt8to32 OpZeroExt8to64
        ^{:line 3120} OpZeroExt16to32 OpZeroExt16to64 OpZeroExt32to64]
      ;; unsigned -> signed/unsigned are value-preserving zero extensions
      (return (not (.IsSigned (.-Type (aget (.-Args v) 0)))))))

  false)


^{:go/end 3145} (go/func getDependencyScore [^{:tag (slice uint)} scores ^{:tag (* Value)} v] :results [^uint score]
  (when [(set! score (aget scores (.-ID v)))] (!= score 0)
    (return score))

  (defer (^{:go/end 3133} (fn []
        (aset scores (.-ID v) score))))

  (when (== (.-Op v) OpPhi)
    (return 1))

  (set! score 2) ; NIT(@Jorropo): always order phis first to make GOSSAFUNC pretty.
  (range [_ a (.-Args v)]
    (when (!= (.-Block a) (.-Block v))

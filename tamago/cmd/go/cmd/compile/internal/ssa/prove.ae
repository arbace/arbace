  ;; Look for phis that implement min/max.
  ;;   z:
  ;;      c = Less64 x y (or other Less/Leq operation)
  ;;      If c -> bx by
  ;;   bx: <- z
  ;;       -> b ...
  ;;   by: <- z
  ;;      -> b ...
  ;;   b: <- bx by
  ;;      v = Phi x y
  ;; Then v is either min or max of x,y.
  ;; If it is the min, then we deduce v <= x && v <= y.
  ;; If it is the max, then we deduce v >= x && v >= y.
  ;; The min case is useful for the copy builtin, see issue 16833.
  (when (!= (len (.-Args v)) 2)
    (return))

  (let [b (.-Block v)
      ^{:line 2592} x (aget (.-Args v) 0)
      ^{:line 2593} y (aget (.-Args v) 1)
      ^{:line 2594} bx (.-b (aget (.-Preds b) 0))
      ^{:line 2595} by (.-b (aget (.-Preds b) 1))
      ^{:line 2596 :tag (* Block)} z (zero (* Block))] ; branch point
    (switch
      (case [(== bx by)] ; bx == by == z case
        (set! z bx))
      (case [(== (.uniquePred by) bx)] ; bx == z case
        (set! z bx))
      (case [(== (.uniquePred bx) by)] ; by == z case
        (set! z by))
      (case [(== (.uniquePred bx) (.uniquePred by))]
        (set! z (.uniquePred bx))))

    (when (or (== z nil) (!= (.-Kind z) BlockIf))
      (return))

    (let [c (aget (.-Controls z) 0)]

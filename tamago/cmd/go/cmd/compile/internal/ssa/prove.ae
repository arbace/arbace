^{:go/end 3016} (go/method constantFoldArguments [^{:tag (* factsTable)} ft ^{:tag (* Value)} v]
  (range [i arg (.-Args v)]
    (let [lim (aget (.-limits ft) (.-ID arg))
        (values constValue ok) (.constValue lim)]
      (when (not ok)
        (continue))

      (switch (.-Op arg)
        (case [OpConst64 OpConst32 OpConst16 OpConst8 OpConstBool OpConstNil]
          (continue)))

      (let [typ (.-Type arg)
          ^{:line 2984} f (.-Func (.-Block v))
          ^{:line 2985 :tag (* Value)} c (zero (* Value))]
        (switch
          (case [(.IsBoolean typ)]
            (set! c (.ConstBool f typ (!= constValue 0))))
          (case [(and (.IsInteger typ) (== (.Size typ) 1))]
            (set! c (.ConstInt8 f typ (conv int8 constValue))))
          (case [(and (.IsInteger typ) (== (.Size typ) 2))]
            (set! c (.ConstInt16 f typ (conv int16 constValue))))
          (case [(and (.IsInteger typ) (== (.Size typ) 4))]
            (set! c (.ConstInt32 f typ (conv int32 constValue))))
          (case [(and (.IsInteger typ) (== (.Size typ) 8))]
            (set! c (.ConstInt64 f typ constValue)))
          (case [(.IsPtrShaped typ)]
            (if (== constValue 0)
              (set! c (.ConstNil f typ))

              ;; Not sure how this might happen, but if it
              ;; does, just skip it.
              (continue)))

          (default
            ;; Not sure how this might happen, but if it
            ;; does, just skip it.
            (continue)))

        (.SetArg v i c)
        (.initLimitForNewValue ft c)
        (when (> (.-debug (.-pass f)) 1)
          (.Warnl f (.-Pos v) "Proved %v's arg %d (%v) is constant %d" v i arg constValue))))))




^{:go/end 3050} (go/method simplifyBlock [^{:tag (* factsTable)} ft ^SparseTree sdom ^{:tag (* Block)} b]
  (when (!= (.-Kind b) BlockIf)
    (return))


  ;; Consider outgoing edges from this block.
  (let [parent b]
    (range [i branch (lit (array ... branch) positive negative)]
      (let [child (.-b (aget (.-Succs parent) i))]
        (when (!= (getBranch sdom parent child) unknown)
          ;; For edges to uniquely dominated blocks, we
          ;; already did this when we visited the child.
          (continue))

        ;; For edges to other blocks, this can trim a branch
        ;; even if we couldn't get rid of the child itself.
        (.checkpoint ft)
        (addBranchRestrictions ft parent branch)
        (let [unsat (.-unsat ft)]
          (.restore ft)
          (when unsat
            ;; This branch is impossible, so remove it
            ;; from the block.
            (removeBranch parent branch)
            ;; No point in considering the other branch.
            ;; (It *is* possible for both to be
            ;; unsatisfiable since the fact table is
            ;; incomplete. We could turn this into a
            ;; BlockExit, but it doesn't seem worth it.)
            (break)))))))




^{:go/end 3078} (go/func removeBranch [^{:tag (* Block)} b ^branch branch]
  (let [c (aget (.-Controls b) 0)]
    (when (and (!= c nil) (> (.-debug (.-pass (.-Func b))) 0))
      (let [verb "Proved"]
        (when (== branch positive)
          (set! verb "Disproved"))

        (if (> (.-debug (.-pass (.-Func b))) 1)
          (.Warnl (.-Func b) (.-Pos b) "%s %s (%s)" verb (.-Op c) c)

          (.Warnl (.-Func b) (.-Pos b) "%s %s" verb (.-Op c)))))


    (when (and (!= c nil) (== ^{:go/via [lico]} (.IsStmt (.-Pos c)) src/PosIsStmt) (.SameFileAndLine (.-Pos c) (.-Pos b)))
      ;; attempt to preserve statement marker.
      (set! (.-Pos b) (.WithIsStmt (.-Pos b))))

    (if (or (== branch positive) (== branch negative)) (do
        (set! (.-Kind b) BlockFirst)
        (.ResetControls b)
        (when (== branch positive)
          (.swapSuccessors b)))

      (do))))

(in-ns 'go.cmd.compile.internal.ssa) (go/file "lower.go" :imports [])


^{:go/end 11} (go/func lower "convert to machine-dependent ops.\n" [^{:tag (* Func)} f]
  ;; repeat rewrites until we find no more rewrites
  (applyRewrite f (.-lowerBlock (.-Config f)) (.-lowerValue (.-Config f)) removeDeadValues))



^{:go/end 19} (go/func lateLower "lateLower applies those rules that need to be run after the general lower rules.\n" [^{:tag (* Func)} f]
  ;; repeat rewrites until we find no more rewrites
  (when (!= (.-lateLowerValue (.-Config f)) nil)
    (applyRewrite f (.-lateLowerBlock (.-Config f)) (.-lateLowerValue (.-Config f)) removeDeadValues)))




^{:go/end 52} (go/func checkLower "checkLower checks for unlowered opcodes and fails if we find one.\n" [^{:tag (* Func)} f]
  ;; Needs to be a separate phase because it must run after both
  ;; lowering and a subsequent dead code elimination (because lowering
  ;; rules may leave dead generic ops behind).
  (range [_ b (.-Blocks f)]
    (range [_ v (.-Values b)]
      (when (not (.-generic (aget opcodeTable (.-Op v))))
        (continue)) ; lowered

      (switch (.-Op v)
        (case [OpSP OpSPanchored OpSB OpInitMem OpArg OpArgIntReg OpArgFloatReg OpPhi OpVarDef OpVarLive OpKeepAlive OpSelect0 OpSelect1 OpSelectN OpConvert OpInlMark OpWBend]
          (continue)) ; ok not to lower
        (case [OpMakeResult]
          (when (== (aget (.-Controls b) 0) v)
            (continue)))

        (case [OpGetG]
          (when (.-hasGReg (.-Config f))
            ;; has hardware g register, regalloc takes care of it
            (continue)))) ; ok not to lower


      (let [s (+ "not lowered: " (.String v) ", " (.String (.-Op v)) " " (.SimpleString (.-Type v)))]

        (range [_ a (.-Args v)]
          (set! s + (+ " " (.SimpleString (.-Type a)))))

        (.Fatalf f "%s" s)))))

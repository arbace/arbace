(in-ns 'go.cmd.compile.internal.ssa) (go/file "sparseset.go" :imports [])

;; from https://research.swtch.com/sparse
;; in turn, from Briggs and Torczon

(go/type sparseSet (struct
    ^{:line 11 :tag (slice ID)} dense
    ^{:line 12 :tag (slice int32)} sparse))




^{:go/end 19} (go/func newSparseSet "newSparseSet returns a sparseSet that can represent\nintegers between 0 and n-1.\n" ^{:tag (* sparseSet)} [^int n]
  (addr (lit sparseSet :dense nil :sparse (make (slice int32) n))))


^{:go/end 23} (go/method cap ^int [^{:tag (* sparseSet)} s]
  (len (.-sparse s)))


^{:go/end 27} (go/method size ^int [^{:tag (* sparseSet)} s]
  (len (.-dense s)))


^{:go/end 32} (go/method contains ^bool [^{:tag (* sparseSet)} s ^ID x]
  (let [i (aget (.-sparse s) x)]
    (and (< i (conv int32 (len (.-dense s)))) (== (aget (.-dense s) i) x))))


^{:go/end 41} (go/method add [^{:tag (* sparseSet)} s ^ID x]
  (let [i (aget (.-sparse s) x)]
    (when (and (< i (conv int32 (len (.-dense s)))) (== (aget (.-dense s) i) x))
      (return))

    (set! (.-dense s) (append (.-dense s) x))
    (aset (.-sparse s) x (- (conv int32 (len (.-dense s))) 1))))


^{:go/end 47} (go/method addAll [^{:tag (* sparseSet)} s ^{:tag (slice ID)} a]
  (range [_ x a]
    (.add s x)))



^{:go/end 53} (go/method addAllValues [^{:tag (* sparseSet)} s ^{:tag (slice (* Value))} a]
  (range [_ v a]
    (.add s (.-ID v))))



^{:go/end 63} (go/method remove [^{:tag (* sparseSet)} s ^ID x]
  (let [i (aget (.-sparse s) x)]
    (when (and (< i (conv int32 (len (.-dense s)))) (== (aget (.-dense s) i) x))
      (let [y (aget (.-dense s) (- (len (.-dense s)) 1))]
        (aset (.-dense s) i y)
        (aset (.-sparse s) y i)
        (set! (.-dense s) (subslice (.-dense s) _ (- (len (.-dense s)) 1)))))))





^{:go/end 71} (go/method pop "pop removes an arbitrary element from the set.\nThe set must be nonempty.\n" ^ID [^{:tag (* sparseSet)} s]
  (let [x (aget (.-dense s) (- (len (.-dense s)) 1))]
    (set! (.-dense s) (subslice (.-dense s) _ (- (len (.-dense s)) 1)))
    ^{:line 70} x))


^{:go/end 75} (go/method clear [^{:tag (* sparseSet)} s]
  (set! (.-dense s) (subslice (.-dense s) _ 0)))


^{:go/end 79} (go/method contents ^{:tag (slice ID)} [^{:tag (* sparseSet)} s]
  (.-dense s))

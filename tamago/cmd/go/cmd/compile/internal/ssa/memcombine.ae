^{:go/end 380} (go/func memcombineStores [^{:tag (* Func)} f]
  (let [mark (.newSparseSet f (.NumValues f))]
    (defer (.retSparseSet f mark))
    (let [^{:tag (slice (* Value))} order (zero (slice (* Value)))]

      (range [_ b (.-Blocks f)]
        ;; Mark all stores which are not last in a store sequence.
        (.clear mark)
        (range [_ v (.-Values b)]
          (when (== (.-Op v) OpStore)
            (.add mark (.-ID (.MemoryArg v)))))



        ;; pick an order for visiting stores such that
        ;; later stores come earlier in the ordering.
        (set! order (subslice order _ 0))
        (range [_ v (.-Values b)]
          (when (!= (.-Op v) OpStore)
            (continue))

          (when (.contains mark (.-ID v))
            (continue)) ; not last in a chain of stores

          (while true
            (set! order (append order v))
            (set! v (aget (.-Args v) 2))
            (when (or (!= (.-Block v) b) (!= (.-Op v) OpStore))
              (break))))




        ;; Look for combining opportunities at each store in queue order.
        (range [_ v order]
          (when (!= (.-Op v) OpStore) ; already rewritten
            (continue))


          (let [size (.Size (assert (* types/Type) (.-Aux v)))]
            (when (or (>= size (.-RegSize (.-Config f))) (== size 0))
              (continue))


            (combineStores v)))))))






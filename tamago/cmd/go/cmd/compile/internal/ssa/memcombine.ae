^{:go/end 27} (go/func memcombine "memcombine combines smaller loads and stores into larger ones.\nWe ensure this generates good code for encoding/binary operations.\nIt may help other cases also.\n" [^{:tag (* Func)} f]
  ;; This optimization requires that the architecture has
  ;; unaligned loads and unaligned stores.
  (when (not (.-unalignedOK (.-Config f)))
    (return))


  (memcombineLoads f)
  (memcombineStores f))


^{:go/end 86} (go/func memcombineLoads [^{:tag (* Func)} f]
  ;; Find "OR trees" to start with.
  (let [mark (.newSparseSet f (.NumValues f))]
    (defer (.retSparseSet f mark))
    (let [^{:tag (slice (* Value))} order (zero (slice (* Value)))]

      ;; Mark all values that are the argument of an OR.
      (range [_ b (.-Blocks f)]
        (range [_ v (.-Values b)]
          (when (or (== (.-Op v) OpOr16) (== (.-Op v) OpOr32) (== (.-Op v) OpOr64))
            (.add mark (.-ID (aget (.-Args v) 0)))
            (.add mark (.-ID (aget (.-Args v) 1))))))



      (range [_ b (.-Blocks f)]
        (set! order (subslice order _ 0))
        (range [_ v (.-Values b)]
          (when (and (!= (.-Op v) OpOr16) (!= (.-Op v) OpOr32) (!= (.-Op v) OpOr64))
            (continue))

          (when (.contains mark (.-ID v))
            ;; marked - means it is not the root of an OR tree
            (continue))

          ;; Add the OR tree rooted at v to the order.
          ;; We use BFS here, but any walk that puts roots before leaves would work.
          (let [i (len order)]
            (set! order (append order v))
            (for [] (< i (len order)) (inc! i)
              (let [x (aget order i)]
                (for [j 0] (< j 2) (inc! j)
                  (let [a (aget (.-Args x) j)]
                    (when (or (== (.-Op a) OpOr16) (== (.-Op a) OpOr32) (== (.-Op a) OpOr64))
                      (set! order (append order a)))))))))




        (range [_ v order]
          (let [max (.-RegSize (.-Config f))]
            (switch (.-Op v)
              (case [OpOr64])
              (case [OpOr32]
                (set! max 4))
              (case [OpOr16]
                (set! max 2))
              (default
                (continue)))

            (for [n max] (> n 1) (set! n / 2)
              (when (combineLoads v n)
                (break)))))))))










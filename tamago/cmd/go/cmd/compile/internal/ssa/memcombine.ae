                (set! off + (.-AuxInt (aget (.-Args idx) 0)))
                (set! idx (aget (.-Args idx) 1)))
              (or (== (.-Op (aget (.-Args idx) 1)) OpConst32) (== (.-Op (aget (.-Args idx) 1)) OpConst64)) (do
                (set! off + (.-AuxInt (aget (.-Args idx) 1)))
                (set! idx (aget (.-Args idx) 0)))))


          (set! ptr (aget (.-Args ptr) 0))) :else


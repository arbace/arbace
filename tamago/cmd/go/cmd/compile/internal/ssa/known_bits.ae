^{:go/end 215} (go/func knownBits "knownBits does constant folding across bitfields\n" [^{:tag (* Func)} f]
  (let [kb (addr ^{:go/breaks [2 4 6]} (lit knownBitsState
          :entries (.allocKnownBitsEntriesSlice (.-Cache f) (.NumValues f))
          :seenValues (.allocBitset (.-Cache f) (.NumValues f))
          :reachableBlocks (.allocBitset (.-Cache f) (.NumBlocks f))))]

    (defer (.freeKnownBitsEntriesSlice (.-Cache f) (.-entries kb)))
    (defer (.freeBitset (.-Cache f) (.-seenValues kb)))
    (defer (.freeBitset (.-Cache f) (.-reachableBlocks kb)))
    (clear (.-seenValues kb))
    (clear (.-entries kb))
    (clear (.-reachableBlocks kb))

    (let [blocks (.postorder f)]
      (range [_ b blocks]
        (.Set (.-reachableBlocks kb) (conv uint32 (.-ID b))))


      (range [_ b (^{:inst [(slice (* Block)) (* Block)]} slices/Backward blocks)]
        (range [_ v (.-Values b)]
          (when (or (== (.-Uses v) 0) (not (or (.IsInteger (.-Type v)) (.IsBoolean (.-Type v)))))
            (continue))

          (switch (.-Op v)
            (case [OpConst64 OpConst32 OpConst16 OpConst8 OpConstBool]
              (continue)))

          (let [(values val k) (.fold kb v)]
            (when (!= k -1)
              (continue))

            (when (> (.-debug (.-pass f)) 0)
              (let [^any pval val]
                (when (.IsBoolean (.-Type v))
                  (set! pval (!= val 0)))

                (.Warnl f (.-Pos v) "known value of %v (%v): %v" v (.-Op v) pval)))

            (let [^{:tag (* Value)} c (zero (* Value))]
              (switch (.Size (.-Type v))
                (case [1]
                  (when (.IsBoolean (.-Type v))
                    (set! c (.ConstBool f (.-Type v) (!= val 0)))
                    (break))

                  (set! c (.ConstInt8 f (.-Type v) (conv int8 val))))
                (case [2]
                  (set! c (.ConstInt16 f (.-Type v) (conv int16 val))))
                (case [4]
                  (set! c (.ConstInt32 f (.-Type v) (conv int32 val))))
                (case [8]
                  (set! c (.ConstInt64 f (.-Type v) val)))
                (default
                  (panic "unreachable; unknown integer size")))

              (.copyOf v c))))))))





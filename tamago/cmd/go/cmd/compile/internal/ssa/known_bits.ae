    (.isLiveOutEdge kb (.-b inEdge) (conv uint (.-i inEdge)))))


^{:go/end 268} (go/method isLiveOutEdge ^bool [^{:tag (* knownBitsState)} kb ^{:tag (* Block)} b ^uint index]
  (when (not (.Test (.-reachableBlocks kb) (conv uint32 (.-ID b))))
    (return false))


  (switch (.-Kind b)
    (case [BlockFirst]
      (return (== index 0)))
    (case [BlockPlain BlockIf BlockDefer BlockRet BlockRetJmp BlockExit BlockJumpTable]
      (return true))
    (default
      (panic "unreachable; unknown block kind"))))




























^{:go/end 329} (go/method computeKnownBitsForShift "computeKnownBitsForShift computes the known bits for a shift operation.\nConsidering the following piece of code x = x << uint8(i)\nThe algorithm is based on two observations:\n\n 1. computing a shift of a lattice by a constant (i) is easy:\n    value, known = x<<i, xk<<i|(1<<i-1)\n    each point in the lattice is shifted by the constant, all new shifted in bits are known zeros.\n\n 2. x = uint8(x) << i is equivalent to\n\n    switch i {\n    case 0:  x0 = x << 0\n    case 1:  x1 = x << 1\n    case 2:  x2 = x << 2\n    case 3:  x3 = x << 3\n    case 4:  x4 = x << 4\n    case 5:  x5 = x << 5\n    case 6:  x6 = x << 6\n    case 7:  x7 = x << 7\n    default: xd = x << 8\n    }\n    x = phi(x0, x1, x2, x3, x4, x5, x6, x7, xd)\n\nThe algorithm below then models the phi in the equivalence above using same intersection algorithm phi uses.\nWe also leverage known bits of the shift amount to remove \"branches\" in the switch that are proved to be impossible.\n" [^{:tag (* knownBitsState)} kb ^{:tag (* Value)} v ^{:tag (func [^int64 x ^int64 xk ^int64 xSize ^int64 shift] [^int64 value ^int64 known])} doShiftByAConst] :results [^int64 value ^int64 known]
  (let [xSize (* (.Size (.-Type (aget (.-Args v) 0))) 8)
      (values x xk) (.fold kb (aget (.-Args v) 0))
      (values y yk) (.fold kb (aget (.-Args v) 1))]
    (when (>= (conv uint64 y) (conv uint64 xSize))
      (return (doShiftByAConst x xk xSize 64)))


    (let [set false]
      (when (and (== (.-AuxInt v) 0) (>= (conv uint64 (bit-not yk)) (conv uint64 xSize)))
        ;; this implement the default case of the equivalent switch above.
        ;; if the shift isn't bounded and there are unknown bits above the shift size we might completely stomp all bits.

        (set! (values value known) (doShiftByAConst x xk xSize 64))
        (set! set true))


      (set! yk bit-or (bit-not (- xSize 1)))

      (range [i (allPossibleValues y yk)]
        (let [(values a k) (doShiftByAConst x xk xSize i)]
          (if (not set) (do
              (set! (values value known) (values a k))
              (set! set true))
            (do
              (set! known bit-and-not (bit-xor value a))
              (set! known bit-and k)))

          (when (== known 0)
            (break))))



      (return (bit-and value known) known))))






^{:go/end 359} (go/func allPossibleValues "allPossibleValues iterates over all values that could exist.\nIt scales exponentially with the number of unknown bits,\nthe exact number of iterations will be uint128(1)<<bits.OnesCount64(^known)\nthus be careful with what values you pass to it.\n" ^{:tag (func [^{:tag (func [^int64 v] [bool])} yield])} [^int64 value ^int64 known]
  (let [unknown (bit-not known)]
    ^{:go/end 358} (fn [^{:tag (func [^int64 v] [bool])} yield]
      ;; This finds the next valid value for the variable bits.
      ;; It is equivalent to (s|known + 1) & unknown.
      ;; The s|known step creates blocks of 1s in all the known bits.
      ;; +1 finds the next possible value, the blocks of 1s set in the previous step allows it to skip over blocks of known bits.
      ;; & unknown clears garbage generated by the blocks of ones and overflow.
      ;;
      ;; You can transform (s|known + 1) & unknown into (s - unknown) & unknown through:
      ;; (s +  known   + 1) & unknown: s | known → s + known (since s & known == 0)
      ;; (s + ^unknown + 1) & unknown: known → ^unknown (definition of unknown)
      ;; (s + -unknown)     & unknown: ^unknown + 1 → -unknown (two's complement negation)
      ;; (s -  unknown)     & unknown: s + -unknown → s - unknown (arithmetic)
      (for [s (conv int64 0)] _ (set! s (bit-and (- s unknown) unknown))
        ;; fixed bits | current variable bits gives the current iteration
        (when (not (yield (bit-or value s)))
          (return))

        (when (== s unknown)
          (break))))))

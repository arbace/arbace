(go/type knownBitsEntry (struct







    ^{:line 231 :tag int64 :doc "Two invariants:\n1. unknown bits are always set to 0 inside value\n2. all values are sign-extended to int64 (inspired by RISC-V's xlen=64)\n   This means let's say you know an 8 bits value is 0b10??????,\n   known = int64(int8(0b11000000))\n   value = int64(int8(0b10000000))\n3. booleans are stored as 1 byte values who are either 0 or 1.\n"} known ^{:tag int64 :doc "Two invariants:\n1. unknown bits are always set to 0 inside value\n2. all values are sign-extended to int64 (inspired by RISC-V's xlen=64)\n   This means let's say you know an 8 bits value is 0b10??????,\n   known = int64(int8(0b11000000))\n   value = int64(int8(0b10000000))\n3. booleans are stored as 1 byte values who are either 0 or 1.\n"} value))


^{:go/end 248} (go/method String ^string [^knownBitsEntry kbe]
  (let [lut (lit (slice rune) ; indexed by knownBit<<1 | valueBit
        ^{:line 236} [2r00 \?]
        ^{:line 237} [2r01 \¿] ; violates invariant 1
        ^{:line 238} [2r10 \0]
        ^{:line 239} [2r11 \1])

      ^{:line 241 :tag strings/Builder} sb (zero strings/Builder)]
    (.Grow sb 64)
    (for [i 63] (>= i 0) (dec! i)
      (let [bits (bit-or (<< (bit-and (>> (.-known kbe) i) 1) 1) (bit-and (>> (.-value kbe) i) 1))]

(in-ns 'go.cmd.compile.internal.ssa) (go/file "xposmap.go" :imports [


    ^{:line 8} [src "cmd/internal/src"]
    ^{:line 9} [fmt "fmt"]])


(go/type lineRange (struct
    ^{:line 13 :tag uint32} first ^uint32 last))






(go/type xposmap "An xposmap is a map from fileindex and line of src.XPos to int32,\nimplemented sparsely to save space (column and statement status are ignored).\nThe sparse skeleton is constructed once, and then reused by ssa phases\nthat (re)move values with statements attached.\n" (struct

    ^{:line 22 :tag (map int32 (* biasedSparseMap)) :doc "A map from file index to maps from line range to integers (block numbers)\n"} maps

    ^{:line 24 :tag int32 :doc "The next two fields provide a single-item cache for common case of repeated lines from same file.\n"} lastIndex ; -1 means no entry in cache
    ^{:line 25 :tag (* biasedSparseMap)} lastMap)) ; map found at maps[lastIndex]





^{:go/end 37} (go/func newXposmap "newXposmap constructs an xposmap valid for inputs which have a file index in the keys of x,\nand line numbers in the range x[file index].\nThe resulting xposmap will panic if a caller attempts to set or add an XPos not in that range.\n" ^{:tag (* xposmap)} [^{:tag (map int lineRange)} x]
  (let [maps (make (map int32 (* biasedSparseMap)))]
    (range [i p x]
      (aset maps (conv int32 i) (newBiasedSparseMap (conv int (.-first p)) (conv int (.-last p)))))

    (addr (lit xposmap :maps maps :lastIndex -1)))) ; zero for the rest is okay



^{:go/end 48} (go/method clear "clear removes data from the map but leaves the sparse skeleton.\n" [^{:tag (* xposmap)} m]
  (range [_ l (.-maps m)]
    (when (!= l nil)
      (.clear l)))


  (set! (.-lastIndex m) -1)
  (set! (.-lastMap m) nil))



^{:go/end 59} (go/method mapFor "mapFor returns the line range map for a given file index.\n" ^{:tag (* biasedSparseMap)} [^{:tag (* xposmap)} m ^int32 index]
  (when (== index (.-lastIndex m))
    (return (.-lastMap m)))

  (let [mf (aget (.-maps m) index)]
    (set! (.-lastIndex m) index)
    (set! (.-lastMap m) mf)
    ^{:line 58} mf))




^{:go/end 69} (go/method set "set inserts p->v into the map.\nIf p does not fall within the set of fileindex->lineRange used to construct m, this will panic.\n" [^{:tag (* xposmap)} m ^src/XPos p ^int32 v]
  (let [s (.mapFor m (.FileIndex p))]
    (when (== s nil)
      (panic (fmt/Sprintf "xposmap.set(%d), file index not found in map\n" (.FileIndex p))))

    (.set s ^{:go/via [lico]} (.Line p) v)))



^{:go/end 78} (go/method get "get returns the int32 associated with the file index and line of p.\n" [^{:tag (* xposmap)} m ^src/XPos p] :results [int32 bool]
  (let [s (.mapFor m (.FileIndex p))]
    (when (== s nil)
      (return 0 false))

    (.get s ^{:go/via [lico]} (.Line p))))





^{:go/end 85} (go/method add "add adds p to m, treating m as a set instead of as a map.\nIf p does not fall within the set of fileindex->lineRange used to construct m, this will panic.\nUse clear() in between set/map interpretations of m.\n" [^{:tag (* xposmap)} m ^src/XPos p]
  (.set m p 0))




^{:go/end 95} (go/method contains "contains returns whether the file index and line of p are in m,\ntreating m as a set instead of as a map.\n" ^bool [^{:tag (* xposmap)} m ^src/XPos p]
  (let [s (.mapFor m (.FileIndex p))]
    (when (== s nil)
      (return false))

    (.contains s ^{:go/via [lico]} (.Line p))))




^{:go/end 105} (go/method remove "remove removes the file index and line for p from m,\nwhether m is currently treated as a map or set.\n" [^{:tag (* xposmap)} m ^src/XPos p]
  (let [s (.mapFor m (.FileIndex p))]
    (when (== s nil)
      (return))

    (.remove s ^{:go/via [lico]} (.Line p))))



^{:go/end 116} (go/method foreachEntry "foreachEntry applies f to each (fileindex, line, value) triple in m.\n" [^{:tag (* xposmap)} m ^{:tag (func [^int32 j ^uint l ^int32 v])} f]
  (range [j mm (.-maps m)]
    (let [s (.size mm)]
      (for [i 0] (< i s) (inc! i)
        (let [(values l v) (.getEntry mm i)]
          (f j l v))))))

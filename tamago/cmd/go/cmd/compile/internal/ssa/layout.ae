(in-ns 'go.cmd.compile.internal.ssa) (go/file "layout.go" :imports [])




^{:go/end 12} (go/func layout "layout orders basic blocks in f with the goal of minimizing control flow instructions.\nAfter this phase returns, the order of f.Blocks matters and is the order\nin which those blocks will appear in the assembly output.\n" [^{:tag (* Func)} f]
  (set! (.-Blocks f) (layoutOrder f)))




^{:go/end 19} (go/func layoutRegallocOrder "Register allocation may use a different order which has constraints\nimposed by the linear-scan algorithm.\n" ^{:tag (slice (* Block))} [^{:tag (* Func)} f]
  ;; remnant of an experiment; perhaps there will be another.
  (.-Blocks f))


^{:go/end 185} (go/func layoutOrder ^{:tag (slice (* Block))} [^{:tag (* Func)} f]
  (let [order (make (slice (* Block)) 0 (.NumBlocks f))
      ^{:line 23} scheduled (.allocBoolSlice (.-Cache f) (.NumBlocks f))]
    (defer (.freeBoolSlice (.-Cache f) scheduled))
    (let [idToBlock (.allocBlockSlice (.-Cache f) (.NumBlocks f))]
      (defer (.freeBlockSlice (.-Cache f) idToBlock))
      (let [indegree (.allocIntSlice (.-Cache f) (.NumBlocks f))]
        (defer (.freeIntSlice (.-Cache f) indegree))
        (let [posdegree (.newSparseSet f (.NumBlocks f))] ; blocks with positive remaining degree
          (defer (.retSparseSet f posdegree))
          ;; blocks with zero remaining degree. Use slice to simulate a LIFO queue to implement
          ;; the depth-first topology sorting algorithm.
          (let [^{:tag (slice ID)} zerodegree (zero (slice ID))
              ;; LIFO queue. Track the successor blocks of the scheduled block so that when we
              ;; encounter loops, we choose to schedule the successor block of the most recently
              ;; scheduled block.
              ^{:line 37 :tag (slice ID)} succs (zero (slice ID))
              ^{:line 38} exit (.newSparseSet f (.NumBlocks f))] ; exit blocks
            (defer (.retSparseSet f exit))

            ;; Populate idToBlock and find exit blocks.
            (range [_ b (.-Blocks f)]
              (aset idToBlock (.-ID b) b)
              (when (== (.-Kind b) BlockExit)
                (.add exit (.-ID b))))



            ;; Expand exit to include blocks post-dominated by exit blocks.
            (while true
              (let [changed false]
                (range [_ id (.contents exit)]
                  (let [b (aget idToBlock id)]
                    (label :NextPred
                      (range [_ pe (.-Preds b)]
                        (let [p (.-b pe)]
                          (when (.contains exit (.-ID p))
                            (continue))

                          (range [_ s (.-Succs p)]
                            (when (not (.contains exit (.-ID (.-b s))))
                              (continue :NextPred)))


                          ;; All Succs are in exit; add p.
                          (.add exit (.-ID p))
                          (set! changed true))))))


                (when (not changed)
                  (break))))



            ;; Initialize indegree of each block
            (range [_ b (.-Blocks f)]
              (when (.contains exit (.-ID b))
                ;; exit blocks are always scheduled last
                (continue))

              (aset indegree (.-ID b) (len (.-Preds b)))
              (if (== (len (.-Preds b)) 0)
                ;; Push an element to the tail of the queue.
                (set! zerodegree (append zerodegree (.-ID b)))

                (.add posdegree (.-ID b))))



            (let [bid (.-ID (.-Entry f))]
              (label :blockloop
                (while true
                  ;; add block to schedule
                  (let [b (aget idToBlock bid)]
                    (set! order (append order b))
                    (aset scheduled bid true)
                    (when (== (len order) (len (.-Blocks f)))
                      (break))


                    ;; Here, the order of traversing the b.Succs affects the direction in which the topological
                    ;; sort advances in depth. Take the following cfg as an example, regardless of other factors.
                    ;;           b1
                    ;;         0/ \1
                    ;;        b2   b3
                    ;; Traverse b.Succs in order, the right child node b3 will be scheduled immediately after
                    ;; b1, traverse b.Succs in reverse order, the left child node b2 will be scheduled
                    ;; immediately after b1. The test results show that reverse traversal performs a little
                    ;; better.
                    ;; Note: You need to consider both layout and register allocation when testing performance.
                    (for [i (- (len (.-Succs b)) 1)] (>= i 0) (dec! i)
                      (let [c (.-b (aget (.-Succs b) i))]
                        (dec! (aget indegree (.-ID c)))
                        (if (== (aget indegree (.-ID c)) 0) (do
                            (.remove posdegree (.-ID c))
                            (set! zerodegree (append zerodegree (.-ID c))))

                          (set! succs (append succs (.-ID c))))))



                    ;; Pick the next block to schedule
                    ;; Pick among the successor blocks that have not been scheduled yet.

                    ;; Use likely direction if we have it.
                    (let [^{:tag (* Block)} likely (zero (* Block))]
                      (switch (.-Likely b)
                        (case [BranchLikely]
                          (set! likely (.-b (aget (.-Succs b) 0))))
                        (case [BranchUnlikely]
                          (set! likely (.-b (aget (.-Succs b) 1)))))

                      (when (and (!= likely nil) (not (aget scheduled (.-ID likely))))
                        (set! bid (.-ID likely))
                        (continue))


                      ;; Use degree for now.
                      (set! bid 0)
                      ;; TODO: improve this part
                      ;; No successor of the previously scheduled block works.
                      ;; Pick a zero-degree block if we can.
                      (while (> (len zerodegree) 0)
                        ;; Pop an element from the tail of the queue.
                        (let [cid (aget zerodegree (- (len zerodegree) 1))]
                          (set! zerodegree (subslice zerodegree _ (- (len zerodegree) 1)))
                          (when (not (aget scheduled cid))
                            (set! bid cid)
                            (continue :blockloop))))



                      ;; Still nothing, pick the unscheduled successor block encountered most recently.
                      (while (> (len succs) 0)
                        ;; Pop an element from the tail of the queue.
                        (let [cid (aget succs (- (len succs) 1))]
                          (set! succs (subslice succs _ (- (len succs) 1)))
                          (when (not (aget scheduled cid))
                            (set! bid cid)
                            (continue :blockloop))))



                      ;; Still nothing, pick any non-exit block.
                      (while (> (.size posdegree) 0)
                        (let [cid (.pop posdegree)]
                          (when (not (aget scheduled cid))
                            (set! bid cid)
                            (continue :blockloop))))


                      ;; Pick any exit block.
                      ;; TODO: Order these to minimize jump distances?
                      (while true
                        (let [cid (.pop exit)]
                          (when (not (aget scheduled cid))
                            (set! bid cid)
                            (continue :blockloop))))))))



              (set! (.-laidout f) true)
              ^{:line 183} order)))))))
;;f.Blocks = order

                  (continue))

                (aset (.-NamedValues f) @typeName (append (aget (.-NamedValues f) @typeName) (aget (.-Args v) 0)))
                (aset (.-NamedValues f) @dataName (append (aget (.-NamedValues f) @dataName) (aget (.-Args v) 1)))

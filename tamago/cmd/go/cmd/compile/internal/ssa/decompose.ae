^{:go/end 219} (go/func decomposeComplexPhi [^{:tag (* Value)} v]
  (let [cfgtypes (addr (.-Types (.-Config (.-Func (.-Block v)))))
      ^{:line 200 :tag (* types/Type)} partType (zero (* types/Type))]

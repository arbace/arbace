^{:go/end 141} (go/func decomposeBuiltinPhi [^{:tag (* Value)} v]
  (switch
    (case [(and (.IsInteger (.-Type v)) (> (.Size (.-Type v)) (.-RegSize (.-Config (.-Func (.-Block v))))))]
      (decomposeInt64Phi v))
    (case [(.IsComplex (.-Type v))]
      (decomposeComplexPhi v))
    (case [(.IsString (.-Type v))]
      (decomposeStringPhi v))
    (case [(.IsSlice (.-Type v))]
      (decomposeSlicePhi v))
    (case [(.IsInterface (.-Type v))]
      (decomposeInterfacePhi v))
    (case [(.IsFloat (.-Type v))])
    ;; floats are never decomposed, even ones bigger than RegSize
    (case [(and (> (.Size (.-Type v)) (.-RegSize (.-Config (.-Func (.-Block v))))) (not (.IsSIMD (.-Type v))))]
      (.Fatalf v "%v undecomposed type %v" v (.-Type v)))))




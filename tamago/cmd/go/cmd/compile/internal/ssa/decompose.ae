^{:go/end 122} (go/func maybeAppend2 ^{:tag (slice (* LocalSlot))} [^{:tag (* Func)} f ^{:tag (slice (* LocalSlot))} ss ^{:tag (* LocalSlot)} s1 ^{:tag (* LocalSlot)} s2]

^{:go/end 386} (go/func decomposeStructPhi "decomposeStructPhi replaces phi-of-struct with structmake(phi-for-each-field),\nand then recursively decomposes the phis for each field.\n" [^{:tag (* Value)} v]
  (let [t (.-Type v)]
    (when (== (.Size t) 0)
      (.reset v OpEmpty)
      (return))

    (let [n (.NumFields t)
        ^{:line 370} fields (make (slice (* Value)) 0 MaxStruct)]
      (for [i 0] (< i n) (inc! i)
        (set! fields (append fields (.NewValue0 (.-Block v) (.-Pos v) OpPhi (.FieldType t i)))))

      (range [_ a (.-Args v)]
        (for [i 0] (< i n) (inc! i)
          (.AddArg (aget fields i) (.NewValue1I (.-Block a) (.-Pos v) OpStructSelect (.FieldType t i) (conv int64 i) a))))


      (.reset v OpStructMake)
      (.AddArgs v (spread fields))

      ;; Recursively decompose phis for each field.
      (range [_ f fields]
        (decomposeUserPhi f)))))





^{:go/end 408} (go/func decomposeArrayPhi "decomposeArrayPhi replaces phi-of-array with arraymake(phi-of-array-element),\nand then recursively decomposes the element phi.\n" [^{:tag (* Value)} v]
  (let [t (.-Type v)]
    (when (== (.Size t) 0)
      (.reset v OpEmpty)

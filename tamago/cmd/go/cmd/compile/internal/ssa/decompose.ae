^{:go/end 110} (go/func decomposeBuiltin "decompose converts phi ops on compound builtin types into phi\nops on simple types, then invokes rewrite rules to decompose\nother ops on those types.\n" [^{:tag (* Func)} f]
  ;; Decompose phis
  (range [_ b (.-Blocks f)]
    (range [_ v (.-Values b)]
      (when (!= (.-Op v) OpPhi)
        (continue))

      (decomposeBuiltinPhi v)))



  ;; Decompose other values
  ;; Note: Leave dead values because we need to keep the original
  ;; values around so the name component resolution below can still work.
  (applyRewrite f rewriteBlockdec rewriteValuedec leaveDeadValues)
  (when (== (.-RegSize (.-Config f)) 4)
    (applyRewrite f rewriteBlockdec64 rewriteValuedec64 leaveDeadValues))


  ;; Split up named values into their components.
  ;; accumulate old names for aggregates (that are decomposed) in toDelete for efficient bulk deletion,
  ;; accumulate new LocalSlots in newNames for addition after the iteration.  This decomposition is for
  ;; builtin types with leaf components, and thus there is no need to reprocess the newly create LocalSlots.
  (let [^{:tag (slice namedVal)} toDelete (zero (slice namedVal))
      ^{:line 40 :tag (slice (* LocalSlot))} newNames (zero (slice (* LocalSlot)))]
    (range [i name (.-Names f)]
      (let [t (.-Type name)]
        (switch
          (case [(and (.IsInteger t) (> (.Size t) (.-RegSize (.-Config f))))]
            (let [(values hiName loName) (.SplitInt64 f name)]
              (set! newNames (maybeAppend2 f newNames hiName loName))
              (range [j v (aget (.-NamedValues f) @name)]
                (when (!= (.-Op v) OpInt64Make)
                  (continue))

                (aset (.-NamedValues f) @hiName (append (aget (.-NamedValues f) @hiName) (aget (.-Args v) 0)))
                (aset (.-NamedValues f) @loName (append (aget (.-NamedValues f) @loName) (aget (.-Args v) 1)))
                (set! toDelete (append toDelete (lit namedVal i j))))))

          (case [(.IsComplex t)]
            (let [(values rName iName) (.SplitComplex f name)]
              (set! newNames (maybeAppend2 f newNames rName iName))
              (range [j v (aget (.-NamedValues f) @name)]
                (when (!= (.-Op v) OpComplexMake)
                  (continue))

                (aset (.-NamedValues f) @rName (append (aget (.-NamedValues f) @rName) (aget (.-Args v) 0)))
                (aset (.-NamedValues f) @iName (append (aget (.-NamedValues f) @iName) (aget (.-Args v) 1)))
                (set! toDelete (append toDelete (lit namedVal i j))))))

          (case [(.IsString t)]
            (let [(values ptrName lenName) (.SplitString f name)]
              (set! newNames (maybeAppend2 f newNames ptrName lenName))
              (range [j v (aget (.-NamedValues f) @name)]
                (when (!= (.-Op v) OpStringMake)
                  (continue))

                (aset (.-NamedValues f) @ptrName (append (aget (.-NamedValues f) @ptrName) (aget (.-Args v) 0)))
                (aset (.-NamedValues f) @lenName (append (aget (.-NamedValues f) @lenName) (aget (.-Args v) 1)))
                (set! toDelete (append toDelete (lit namedVal i j))))))

          (case [(.IsSlice t)]
            (let [(values ptrName lenName capName) (.SplitSlice f name)]
              (set! newNames (maybeAppend2 f newNames ptrName lenName))
              (set! newNames (maybeAppend f newNames capName))
              (range [j v (aget (.-NamedValues f) @name)]
                (when (!= (.-Op v) OpSliceMake)
                  (continue))

                (aset (.-NamedValues f) @ptrName (append (aget (.-NamedValues f) @ptrName) (aget (.-Args v) 0)))
                (aset (.-NamedValues f) @lenName (append (aget (.-NamedValues f) @lenName) (aget (.-Args v) 1)))
                (aset (.-NamedValues f) @capName (append (aget (.-NamedValues f) @capName) (aget (.-Args v) 2)))
                (set! toDelete (append toDelete (lit namedVal i j))))))

          (case [(.IsInterface t)]
            (let [(values typeName dataName) (.SplitInterface f name)]
              (set! newNames (maybeAppend2 f newNames typeName dataName))
              (range [j v (aget (.-NamedValues f) @name)]

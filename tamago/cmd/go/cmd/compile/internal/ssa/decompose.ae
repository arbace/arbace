^{:go/end 196} (go/func decomposeInt64Phi [^{:tag (* Value)} v]
  (let [cfgtypes (addr (.-Types (.-Config (.-Func (.-Block v)))))
      ^{:line 180 :tag (* types/Type)} partType (zero (* types/Type))]

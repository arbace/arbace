        ;; there's no need to record a name
        (when (and (not (.IsArray (.-Type fs))) (not (isStructNotSIMD (.-Type fs))))
          (set! slots (maybeAppend f slots fs)))))



    (let [^{:tag (slice (* Value))} keep (zero (slice (* Value)))]

^{:go/end 262} (go/func decomposeUser [^{:tag (* Func)} f]
  (range [_ b (.-Blocks f)]
    (range [_ v (.-Values b)]
      (when (!= (.-Op v) OpPhi)
        (continue))

      (decomposeUserPhi v)))


  ;; Split up named values into their components.
  (let [i 0
      ^{:line 247 :tag (slice (* LocalSlot))} newNames (zero (slice (* LocalSlot)))]
    (range [_ name (.-Names f)]
      (let [t (.-Type name)]
        (switch
          (case [(isStructNotSIMD t)]
            (set! newNames (decomposeUserStructInto f name newNames)))
          (case [(.IsArray t)]
            (set! newNames (decomposeUserArrayInto f name newNames)))
          (default
            (aset (.-Names f) i name)
            (inc! i)))))


    (set! (.-Names f) (subslice (.-Names f) _ i))
    (set! (.-Names f) (append (.-Names f) (spread newNames)))))





^{:go/end 301} (go/func decomposeUserArrayInto "decomposeUserArrayInto creates names for the element(s) of arrays referenced\nby name where possible, and appends those new names to slots, which is then\nreturned.\n" ^{:tag (slice (* LocalSlot))} [^{:tag (* Func)} f ^{:tag (* LocalSlot)} name ^{:tag (slice (* LocalSlot))} slots]
  (let [t (.-Type name)]
    (when (== (.Size t) 0)
      ;; TODO(khr): Not sure what to do here.  Probably nothing.
      ;; Names for empty arrays aren't important.
      (return slots))

    (when (!= (.NumElem t) 1)
      ;; shouldn't get here due to CanSSA
      (.Fatalf f "array not of size 1"))

    (let [elemName (.SplitArray f name)
        ^{:line 279 :tag (slice (* Value))} keep (zero (slice (* Value)))]
      (range [_ v (aget (.-NamedValues f) @name)]
        (when (!= (.-Op v) OpArrayMake1)
          (set! keep (append keep v))
          (continue))

        (aset (.-NamedValues f) @elemName (append (aget (.-NamedValues f) @elemName) (aget (.-Args v) 0))))

      (if (== (len keep) 0)
        ;; delete the name for the array as a whole
        (delete (.-NamedValues f) @name)

        (aset (.-NamedValues f) @name keep))


      (cond (.IsArray (.Elem t))
        (return (decomposeUserArrayInto f elemName slots))
        (isStructNotSIMD (.Elem t))
        (return (decomposeUserStructInto f elemName slots)))


      (append slots elemName))))





^{:go/end 351} (go/func decomposeUserStructInto "decomposeUserStructInto creates names for the fields(s) of structs referenced\nby name where possible, and appends those new names to slots, which is then\nreturned.\n" ^{:tag (slice (* LocalSlot))} [^{:tag (* Func)} f ^{:tag (* LocalSlot)} name ^{:tag (slice (* LocalSlot))} slots]
  (let [fnames (lit (slice (* LocalSlot))) ; slots for struct in name
      ^{:line 308} t (.-Type name)
      ^{:line 309} n (.NumFields t)]

    (for [i 0] (< i n) (inc! i)
      (let [fs (.SplitStruct f name i)]
        (set! fnames (append fnames fs))

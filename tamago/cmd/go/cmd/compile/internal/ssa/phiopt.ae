(in-ns 'go.cmd.compile.internal.ssa) (go/file "phiopt.go" :imports [])






















^{:go/end 286} (go/func phiopt "phiopt eliminates boolean Phis based on the previous if.\n\nMain use case is to transform:\n\n\tx := false\n\tif b {\n\t  x = true\n\t}\n\ninto x = b.\n\nIn SSA code this appears as\n\n\tb0\n\t  If b -> b1 b2\n\tb1\n\t  Plain -> b2\n\tb2\n\t  x = (OpPhi (ConstBool [true]) (ConstBool [false]))\n\nIn this case we can replace x with a copy of b.\n" [^{:tag (* Func)} f]
  (let [sdom (.Sdom f)]
    (range [_ b (.-Blocks f)]
      (when (or (!= (len (.-Preds b)) 2) (== (len (.-Values b)) 0))
        ;; TODO: handle more than 2 predecessors, e.g. a || b || c.
        (continue))


      (let [(values pb0 b0) (values b (.-b (aget (.-Preds b) 0)))]
        (while (and (== (len (.-Succs b0)) 1) (== (len (.-Preds b0)) 1))
          (set! (values pb0 b0) (values b0 (.-b (aget (.-Preds b0) 0)))))

        (when (!= (.-Kind b0) BlockIf)
          (continue))

        (let [(values pb1 b1) (values b (.-b (aget (.-Preds b) 1)))]
          (while (and (== (len (.-Succs b1)) 1) (== (len (.-Preds b1)) 1))
            (set! (values pb1 b1) (values b1 (.-b (aget (.-Preds b1) 0)))))

          (when (!= b1 b0)
            (continue))

          ;; b0 is the if block giving the boolean value.
          ;; reverse is the predecessor from which the truth value comes.
          (let [^int reverse (zero int)]
            (cond (and (== (.-b (aget (.-Succs b0) 0)) pb0) (== (.-b (aget (.-Succs b0) 1)) pb1))
              (set! reverse 0)
              (and (== (.-b (aget (.-Succs b0) 0)) pb1) (== (.-b (aget (.-Succs b0) 1)) pb0))
              (set! reverse 1) :else

              (.Fatalf b "invalid predecessors\n"))


            (range [_ v (.-Values b)]
              (when (!= (.-Op v) OpPhi)
                (continue))


              ;; Look for conversions from bool to 0/1.
              (when (.IsInteger (.-Type v))
                (phioptint v b0 reverse))


              (when (not (.IsBoolean (.-Type v)))
                (continue))


              ;; Replaces
              ;;   if a { x = true } else { x = false } with x = a
              ;; and
              ;;   if a { x = false } else { x = true } with x = !a
              (when (and (== (.-Op (aget (.-Args v) 0)) OpConstBool) (== (.-Op (aget (.-Args v) 1)) OpConstBool))
                (when (!= (.-AuxInt (aget (.-Args v) reverse)) (.-AuxInt (aget (.-Args v) (- 1 reverse))))
                  (let [ops (lit (array 2 Op) OpNot OpCopy)]
                    (.reset v (aget ops (.-AuxInt (aget (.-Args v) reverse))))
                    (.AddArg v (aget (.-Controls b0) 0))
                    (when (> (.-debug (.-pass f)) 0)
                      (.Warnl f (.-Pos b) "converted OpPhi to %v" (.-Op v)))

                    (continue))))



              ;; Replaces
              ;;   if a { x = true } else { x = value } with x = a || value.
              ;; Requires that value dominates x, meaning that regardless of a,
              ;; value is always computed. This guarantees that the side effects
              ;; of value are not seen if a is false.
              (when (and (== (.-Op (aget (.-Args v) reverse)) OpConstBool) (== (.-AuxInt (aget (.-Args v) reverse)) 1))
                (when [tmp (aget (.-Args v) (- 1 reverse))] (.IsAncestorEq sdom (.-Block tmp) b)
                  (.reset v OpOrB)
                  (.SetArgs2 v (aget (.-Controls b0) 0) tmp)
                  (when (> (.-debug (.-pass f)) 0)
                    (.Warnl f (.-Pos b) "converted OpPhi to %v" (.-Op v)))

                  (continue)))



              ;; Replaces
              ;;   if a { x = value } else { x = false } with x = a && value.
              ;; Requires that value dominates x, meaning that regardless of a,
              ;; value is always computed. This guarantees that the side effects
              ;; of value are not seen if a is false.
              (when (and (== (.-Op (aget (.-Args v) (- 1 reverse))) OpConstBool) (== (.-AuxInt (aget (.-Args v) (- 1 reverse))) 0))
                (when [tmp (aget (.-Args v) reverse)] (.IsAncestorEq sdom (.-Block tmp) b)
                  (.reset v OpAndB)
                  (.SetArgs2 v (aget (.-Controls b0) 0) tmp)
                  (when (> (.-debug (.-pass f)) 0)
                    (.Warnl f (.-Pos b) "converted OpPhi to %v" (.-Op v)))

                  (continue)))


              ;; Replaces
              ;;   if a { x = value } else { x = a } with x = a && value.
              ;; Requires that value dominates x.
              (when (== (aget (.-Args v) (- 1 reverse)) (aget (.-Controls b0) 0))
                (when [tmp (aget (.-Args v) reverse)] (.IsAncestorEq sdom (.-Block tmp) b)
                  (.reset v OpAndB)
                  (.SetArgs2 v (aget (.-Controls b0) 0) tmp)
                  (when (> (.-debug (.-pass f)) 0)
                    (.Warnl f (.-Pos b) "converted OpPhi to %v" (.-Op v)))

                  (continue)))



              ;; Replaces
              ;;   if a { x = a } else { x = value } with x = a || value.
              ;; Requires that value dominates x.
              (when (== (aget (.-Args v) reverse) (aget (.-Controls b0) 0))
                (when [tmp (aget (.-Args v) (- 1 reverse))] (.IsAncestorEq sdom (.-Block tmp) b)
                  (.reset v OpOrB)
                  (.SetArgs2 v (aget (.-Controls b0) 0) tmp)
                  (when (> (.-debug (.-pass f)) 0)
                    (.Warnl f (.-Pos b) "converted OpPhi to %v" (.-Op v)))

                  (continue))))))))




    ;; strengthen phi optimization.
    ;; Main use case is to transform:
    ;;   x := false
    ;;   if c {
    ;;     x = true
    ;;     ...
    ;;   }
    ;; into
    ;;   x := c
    ;;   if x { ... }
    ;;
    ;; For example, in SSA code a case appears as
    ;; b0
    ;;   If c -> b, sb0
    ;; sb0
    ;;   If d -> sd0, sd1
    ;; sd1
    ;;   ...
    ;; sd0
    ;;   Plain -> b
    ;; b
    ;;   x = (OpPhi (ConstBool [true]) (ConstBool [false]))
    ;;
    ;; In this case we can also replace x with a copy of c.
    ;;
    ;; The optimization idea:
    ;; 1. block b has a phi value x, x = OpPhi (ConstBool [true]) (ConstBool [false]),
    ;;    and len(b.Preds) is equal to 2.
    ;; 2. find the common dominator(b0) of the predecessors(pb0, pb1) of block b, and the
    ;;    dominator(b0) is a If block.
    ;;    Special case: one of the predecessors(pb0 or pb1) is the dominator(b0).
    ;; 3. the successors(sb0, sb1) of the dominator need to dominate the predecessors(pb0, pb1)
    ;;    of block b respectively.
    ;; 4. replace this boolean Phi based on dominator block.
    ;;
    ;;     b0(pb0)            b0(pb1)          b0
    ;;    |  \               /  |             /  \
    ;;    |  sb1           sb0  |           sb0  sb1
    ;;    |  ...           ...  |           ...   ...
    ;;    |  pb1           pb0  |           pb0  pb1
    ;;    |  /               \  |            \   /
    ;;     b                   b               b
    ;;
    (let [^{:tag (* lcaRange)} lca (zero (* lcaRange))]
      (range [_ b (.-Blocks f)]
        (when (or (!= (len (.-Preds b)) 2) (== (len (.-Values b)) 0))
          ;; TODO: handle more than 2 predecessors, e.g. a || b || c.
          (continue))


        (range [_ v (.-Values b)]
          ;; find a phi value v = OpPhi (ConstBool [true]) (ConstBool [false]).
          ;; TODO: v = OpPhi (ConstBool [true]) (Arg <bool> {value})
          (when (!= (.-Op v) OpPhi)
            (continue))

          (when (or (!= (.-Op (aget (.-Args v) 0)) OpConstBool) (!= (.-Op (aget (.-Args v) 1)) OpConstBool))
            (continue))

          (when (== (.-AuxInt (aget (.-Args v) 0)) (.-AuxInt (aget (.-Args v) 1)))
            (continue))


          (let [pb0 (.-b (aget (.-Preds b) 0))
              ^{:line 215} pb1 (.-b (aget (.-Preds b) 1))]
            (cond (and (== (.-Kind pb0) BlockIf) (== pb0 (.Parent sdom b)))
              ;; special case: pb0 is the dominator block b0.
              ;;     b0(pb0)
              ;;    |  \
              ;;    |  sb1
              ;;    |  ...
              ;;    |  pb1
              ;;    |  /
              ;;     b
              ;; if another successor sb1 of b0(pb0) dominates pb1, do replace.
              (let [ei (.-i (aget (.-Preds b) 0))
                  ^{:line 227} sb1 (.-b (aget (.-Succs pb0) (- 1 ei)))]
                (when (.IsAncestorEq sdom sb1 pb1)
                  (convertPhi pb0 v ei)
                  (break)))

              (and (== (.-Kind pb1) BlockIf) (== pb1 (.Parent sdom b)))
              ;; special case: pb1 is the dominator block b0.
              ;;       b0(pb1)
              ;;     /   |
              ;;    sb0  |
              ;;    ...  |
              ;;    pb0  |
              ;;      \  |
              ;;        b
              ;; if another successor sb0 of b0(pb0) dominates pb0, do replace.
              (let [ei (.-i (aget (.-Preds b) 1))
                  ^{:line 243} sb0 (.-b (aget (.-Succs pb1) (- 1 ei)))]
                (when (.IsAncestorEq sdom sb0 pb0)
                  (convertPhi pb1 v (- 1 ei))
                  (break))) :else

              (do
                ;;      b0
                ;;     /   \
                ;;    sb0  sb1
                ;;    ...  ...
                ;;    pb0  pb1
                ;;      \   /
                ;;        b
                ;;
                ;; Build data structure for fast least-common-ancestor queries.
                (when (== lca nil)
                  (set! lca (makeLCArange f)))

                (let [b0 (.find lca pb0 pb1)]
                  (when (!= (.-Kind b0) BlockIf)
                    (break))

                  (let [sb0 (.-b (aget (.-Succs b0) 0))
                      ^{:line 266} sb1 (.-b (aget (.-Succs b0) 1))
                      ^{:line 267 :tag int} reverse (zero int)]
                    (cond (and (.IsAncestorEq sdom sb0 pb0) (.IsAncestorEq sdom sb1 pb1))
                      (set! reverse 0)
                      (and (.IsAncestorEq sdom sb1 pb0) (.IsAncestorEq sdom sb0 pb1))
                      (set! reverse 1) :else

                      (break))

                    (when (or (!= (len (.-Preds sb0)) 1) (!= (len (.-Preds sb1)) 1))
                      ;; we can not replace phi value x in the following case.
                      ;;   if gp == nil || sp < lo { x = true}
                      ;;   if a || b { x = true }
                      ;; so the if statement can only have one condition.
                      (break))

                    (convertPhi b0 v reverse)))))))))))





^{:go/end 339} (go/func phioptint [^{:tag (* Value)} v ^{:tag (* Block)} b0 ^int reverse]
  (let [a0 (aget (.-Args v) 0)
      ^{:line 290} a1 (aget (.-Args v) 1)]
    (when (!= (.-Op a0) (.-Op a1))
      (return))


    (switch (.-Op a0)
      (case [OpConst8 OpConst16 OpConst32 OpConst64])
      (default
        (return)))


    (let [negate false]
      (switch
        (case [(and (== (.-AuxInt a0) 0) (== (.-AuxInt a1) 1))]
          (set! negate true))
        (case [(and (== (.-AuxInt a0) 1) (== (.-AuxInt a1) 0))])
        (default
          (return)))


      (when (== reverse 1)
        (set! negate (not negate)))


      (let [a (aget (.-Controls b0) 0)]
        (when negate
          (set! a (.NewValue1 (.-Block v) (.-Pos v) OpNot (.-Type a) a)))

        (.AddArg v a)

        (let [cvt (.NewValue1 (.-Block v) (.-Pos v) OpCvtBoolToUint8 (.-UInt8 (.-Types (.-Config (.-Func (.-Block v))))) a)]
          (switch (.Size (.-Type v))
            (case [1]
              (.reset v OpCopy))
            (case [2]
              (.reset v OpZeroExt8to16))
            (case [4]
              (.reset v OpZeroExt8to32))
            (case [8]
              (.reset v OpZeroExt8to64))
            (default
              (.Fatalf v "bad int size %d" (.Size (.-Type v)))))

          (.AddArg v cvt)

          (let [f (.-Func b0)]
            (when (> (.-debug (.-pass f)) 0)
              (.Warnl f (.-Pos (.-Block v)) "converted OpPhi bool -> int%d" (* (.Size (.-Type v)) 8)))))))))






^{:go/end 352} (go/func convertPhi "b is the If block giving the boolean value.\nv is the phi value v = (OpPhi (ConstBool [true]) (ConstBool [false])).\nreverse is the predecessor from which the truth value comes.\n" [^{:tag (* Block)} b ^{:tag (* Value)} v ^int reverse]
  (let [f (.-Func b)
      ^{:line 346} ops (lit (array 2 Op) OpNot OpCopy)]
    (.reset v (aget ops (.-AuxInt (aget (.-Args v) reverse))))
    (.AddArg v (aget (.-Controls b) 0))
    (when (> (.-debug (.-pass f)) 0)
      (.Warnl f (.-Pos b) "converted OpPhi to %v" (.-Op v)))))

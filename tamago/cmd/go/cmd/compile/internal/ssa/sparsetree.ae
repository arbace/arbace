(go/type SparseTreeNode (struct
    ^{:line 13 :tag (* Block)} child
    ^{:line 14 :tag (* Block)} sibling
    ^{:line 15 :tag (* Block)} parent









    ^{:line 25 :tag int32 :doc "Every block has 6 numbers associated with it:\nentry-1, entry, entry+1, exit-1, and exit, exit+1.\nentry and exit are conceptually the top of the block (phi functions)\nentry+1 and exit-1 are conceptually the bottom of the block (ordinary defs)\nentry-1 and exit+1 are conceptually \"just before\" the block (conditions flowing in)\n\nThis simplifies life if we wish to query information about x\nwhen x is both an input to and output of a block.\n"} entry ^{:tag int32 :doc "Every block has 6 numbers associated with it:\nentry-1, entry, entry+1, exit-1, and exit, exit+1.\nentry and exit are conceptually the top of the block (phi functions)\nentry+1 and exit-1 are conceptually the bottom of the block (ordinary defs)\nentry-1 and exit+1 are conceptually \"just before\" the block (conditions flowing in)\n\nThis simplifies life if we wish to query information about x\nwhen x is both an input to and output of a block.\n"} exit))


^{:go/end 30} (go/method String ^string [^{:tag (* SparseTreeNode)} s]
  (fmt/Sprintf "[%d,%d]" (.-entry s) (.-exit s)))


^{:go/end 34} (go/method Entry ^int32 [^{:tag (* SparseTreeNode)} s]
  (.-entry s))


^{:go/end 38} (go/method Exit ^int32 [^{:tag (* SparseTreeNode)} s]

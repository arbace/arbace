                  ^{:line 710} cost (+ (.-cost first) (.-cost second) (.-cost third))
                  ^{:line 711} old (aget (.-mulRecipes c) x)]
                (when (and ^:go/paren (or (== (.-build old) nil) (< cost (.-cost old))) (< cost mulCost))
                  (aset (.-mulRecipes c) x (lit mulRecipe :cost cost :build ^{:go/end 717} (fn ^{:tag (* Value)} [^{:tag (* Value)} m ^{:tag (* Value)} v]
                        (let [v1 ((.-build first) m v v)
                            ^{:line 715} v2 ((.-build second) m v v)]
                          ((.-build third) m v1 v2))))))))))






        ;; E
        (range [_ first linearCombos]
          (range [_ second linearCombos]
            (range [_ third linearCombos]
              (let [x (+ (* (.-a third) (+ (* (.-a second) (+ (.-a first) (.-b first))) (.-b second))) (.-b third))
                  ^{:line 728} cost (+ (.-cost first) (.-cost second) (.-cost third))
                  ^{:line 729} old (aget (.-mulRecipes c) x)]
                (when (and ^:go/paren (or (== (.-build old) nil) (< cost (.-cost old))) (< cost mulCost))
                  (aset (.-mulRecipes c) x (lit mulRecipe :cost cost :build ^{:go/end 735} (fn ^{:tag (* Value)} [^{:tag (* Value)} m ^{:tag (* Value)} v]
                        (let [v1 ((.-build first) m v v)
                            ^{:line 733} v2 ((.-build second) m v1 v)]
                          ((.-build third) m v2 v)))))))))))







      ;; These cases should be handled specially by rewrite rules.
      ;; (Otherwise v * 1 == (neg (neg v)))
      (delete (.-mulRecipes c) 0)
      (delete (.-mulRecipes c) 1))))


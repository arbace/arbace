          ;; ADDshiftLLV
          (for [i 1] (< i 5) (inc! i)
            (let [c 10]
              (r 1 ^int64 (<< 1 i) c
                ^{:go/end 631} (fn ^{:tag (* Value)} [^{:tag (* Value)} m ^{:tag (* Value)} x ^{:tag (* Value)} y]

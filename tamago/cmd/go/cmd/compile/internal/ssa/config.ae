        (set! (.-hasGReg c) false)
        (set! (.-unalignedOK c) true)
        (set! (.-haveBswap32 c) true)
        (set! (.-haveBswap16 c) true))
      (case ["arm"]
        (set! (.-PtrSize c) 4)

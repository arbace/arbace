      ;; B
      (range [_ inner linearCombos]
        (range [_ outer linearCombos]
          (let [x (+ (.-a outer) (* (.-b outer) (+ (.-a inner) (.-b inner))))
              ^{:line 675} cost (+ (.-cost inner) (.-cost outer))
              ^{:line 676} old (aget (.-mulRecipes c) x)]
            (when (and ^:go/paren (or (== (.-build old) nil) (< cost (.-cost old))) (< cost mulCost))
              (aset (.-mulRecipes c) x (lit mulRecipe :cost cost :build ^{:go/end 680} (fn ^{:tag (* Value)} [^{:tag (* Value)} m ^{:tag (* Value)} v]
                    ((.-build outer) m v ((.-build inner) m v v)))))))))





      ;; C
      (range [_ inner linearCombos]
        (range [_ outer linearCombos]
          (let [x (+ (* (.-a outer) (+ (.-a inner) (.-b inner))) (.-b outer))
              ^{:line 689} cost (+ (.-cost inner) (.-cost outer))
              ^{:line 690} old (aget (.-mulRecipes c) x)]

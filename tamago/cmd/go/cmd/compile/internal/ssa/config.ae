^{:go/end 416} (go/method haveByteSwap ^bool [^{:tag (* Config)} c ^int64 size]
  (switch size
    (case [8]
      (return (.-haveBswap64 c)))
    (case [4]
      (return (.-haveBswap32 c)))
    (case [2]
      (return (.-haveBswap16 c)))
    (default
      (base/Fatalf "bad size %d\n" size)
      (return false))))




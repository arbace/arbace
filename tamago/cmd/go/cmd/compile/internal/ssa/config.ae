          (let [x (* (+ (.-a inner) (.-b inner)) (+ (.-a outer) (.-b outer)))
              ^{:line 660} cost (+ (.-cost inner) (.-cost outer))
              ^{:line 661} old (aget (.-mulRecipes c) x)]
            (when (and ^:go/paren (or (== (.-build old) nil) (< cost (.-cost old))) (< cost mulCost))

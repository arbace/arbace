            (let [c 20]
              (when (> i 4)
                (inc! c))

              (r ^int64 (<< -1 i) 0 c
                ^{:go/end 574} (fn ^{:tag (* Value)} [^{:tag (* Value)} m ^{:tag (* Value)} x ^{:tag (* Value)} y]

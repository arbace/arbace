    ^{:line 390 :tag uint64} m ; m * (c>>k) mod 2^n == 1 multiplicative inverse of odd portion modulo 2^n
    ^{:line 391 :tag uint64} a ; ⎣(2^(n-1) - 1)/ (c>>k)⎦ & -(1<<k) additive constant
    ^{:line 392 :tag uint64} max)) ; ⎣(2 a) / (1<<k)⎦ max value to for divisibility


^{:go/end 421} (go/func sdivisible ^sdivisibleData [^uint n ^int64 c]
  (let [d (conv uint64 c)
      ^{:line 397} k (bits/TrailingZeros64 d)
      ^{:line 398} d0 (>> d (conv uint k)) ; the odd portion of the divisor

      ^{:line 400} mask (>> (bit-not (conv uint64 0)) (- 64 n))

      ;; Calculate the multiplicative inverse via Newton's method.
      ;; Quadratic convergence doubles the number of correct bits per iteration.
      ^{:line 404} m d0] ; initial guess correct to 3-bits d0*d0 mod 8 == 1
    (set! m (* m (- 2 (* m d0)))) ; 6-bits
    (set! m (* m (- 2 (* m d0)))) ; 12-bits
    (set! m (* m (- 2 (* m d0)))) ; 24-bits
    (set! m (* m (- 2 (* m d0)))) ; 48-bits
    (set! m (* m (- 2 (* m d0)))) ; 96-bits >= 64-bits
    (set! m (bit-and m mask))

    (let [a (bit-and (/ (>> mask 1) d0) (- ^uint64 (<< 1 (conv uint k))))

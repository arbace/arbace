(in-ns 'go.cmd.compile.internal.ssa) (go/file "sparsemappos.go" :imports [

    ^{:line 7} [src "cmd/internal/src"]])

;; from https://research.swtch.com/sparse
;; in turn, from Briggs and Torczon

(go/type sparseEntryPos (struct
    ^{:line 13 :tag ID} key
    ^{:line 14 :tag int32} val
    ^{:line 15 :tag src/XPos} pos))


(go/type sparseMapPos (struct
    ^{:line 19 :tag (slice sparseEntryPos)} dense
    ^{:line 20 :tag (slice int32)} sparse))




^{:go/end 27} (go/func newSparseMapPos "newSparseMapPos returns a sparseMapPos that can map\nintegers between 0 and n-1 to the pair <int32,src.XPos>.\n" ^{:tag (* sparseMapPos)} [^int n]
  (addr (lit sparseMapPos :dense nil :sparse (make (slice int32) n))))


^{:go/end 31} (go/method cap ^int [^{:tag (* sparseMapPos)} s]
  (len (.-sparse s)))


^{:go/end 35} (go/method size ^int [^{:tag (* sparseMapPos)} s]
  (len (.-dense s)))


^{:go/end 40} (go/method contains ^bool [^{:tag (* sparseMapPos)} s ^ID k]
  (let [i (aget (.-sparse s) k)]
    (and (< i (conv int32 (len (.-dense s)))) (== (.-key (aget (.-dense s) i)) k))))




^{:go/end 50} (go/method get "get returns the value for key k, or -1 if k does\nnot appear in the map.\n" ^int32 [^{:tag (* sparseMapPos)} s ^ID k]
  ^{:go/breaks [[3 49]]} (let [i (aget (.-sparse s) k)]
    (when (and (< i (conv int32 (len (.-dense s)))) (== (.-key (aget (.-dense s) i)) k))
      (return (.-val (aget (.-dense s) i))))

    -1))


^{:go/end 61} (go/method set [^{:tag (* sparseMapPos)} s ^ID k ^int32 v ^src/XPos a]
  (let [i (aget (.-sparse s) k)]
    (when (and (< i (conv int32 (len (.-dense s)))) (== (.-key (aget (.-dense s) i)) k))
      (set! (.-val (aget (.-dense s) i)) v)
      (set! (.-pos (aget (.-dense s) i)) a)
      (return))

    (set! (.-dense s) (append (.-dense s) (lit sparseEntryPos k v a)))
    (aset (.-sparse s) k (- (conv int32 (len (.-dense s))) 1))))


^{:go/end 71} (go/method remove [^{:tag (* sparseMapPos)} s ^ID k]
  (let [i (aget (.-sparse s) k)]
    (when (and (< i (conv int32 (len (.-dense s)))) (== (.-key (aget (.-dense s) i)) k))
      (let [y (aget (.-dense s) (- (len (.-dense s)) 1))]
        (aset (.-dense s) i y)
        (aset (.-sparse s) (.-key y) i)
        (set! (.-dense s) (subslice (.-dense s) _ (- (len (.-dense s)) 1)))))))



^{:go/end 75} (go/method clear [^{:tag (* sparseMapPos)} s]
  (set! (.-dense s) (subslice (.-dense s) _ 0)))


^{:go/end 79} (go/method contents ^{:tag (slice sparseEntryPos)} [^{:tag (* sparseMapPos)} s]
  (.-dense s))

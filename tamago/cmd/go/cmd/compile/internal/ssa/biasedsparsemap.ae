(in-ns 'go.cmd.compile.internal.ssa) (go/file "biasedsparsemap.go" :imports [


    ^{:line 8} [math "math"]])







(go/type biasedSparseMap "A biasedSparseMap is a sparseMap for integers between J and K inclusive,\nwhere J might be somewhat larger than zero (and K-J is probably much smaller than J).\n(The motivating use case is the line numbers of statements for a single function.)\nNot all features of a SparseMap are exported, and it is also easy to treat a\nbiasedSparseMap like a SparseSet.\n" (struct
    ^{:line 17 :tag (* sparseMap)} s
    ^{:line 18 :tag int} first))



^{:go/end 27} (go/func newBiasedSparseMap "newBiasedSparseMap returns a new biasedSparseMap for values between first and last, inclusive.\n" ^{:tag (* biasedSparseMap)} [^int first ^int last]
  (when (> first last)
    (return (addr (lit biasedSparseMap :first math/MaxInt32 :s nil))))

  (addr (lit biasedSparseMap :first first :s (newSparseMap (- (+ 1 last) first)))))



^{:go/end 35} (go/method cap "cap returns one more than the largest key valid for s\n" ^int [^{:tag (* biasedSparseMap)} s]
  (when (or (== s nil) (== (.-s s) nil))
    (return 0))

  (+ (.cap (.-s s)) (.-first s)))



^{:go/end 43} (go/method size "size returns the number of entries stored in s\n" ^int [^{:tag (* biasedSparseMap)} s]
  (when (or (== s nil) (== (.-s s) nil))
    (return 0))

  (.size (.-s s)))



^{:go/end 57} (go/method contains "contains reports whether x is a key in s\n" ^bool [^{:tag (* biasedSparseMap)} s ^uint x]
  (when (or (== s nil) (== (.-s s) nil))
    (return false))

  (when (< (conv int x) (.-first s))
    (return false))

  (when (>= (conv int x) (.cap s))
    (return false))

  (.contains (.-s s) (conv ID (- (conv int x) (.-first s)))))




^{:go/end 76} (go/method get "get returns the value s maps for key x and true, or\n0/false if x is not mapped or is out of range for s.\n" [^{:tag (* biasedSparseMap)} s ^uint x] :results [int32 bool]
  (when (or (== s nil) (== (.-s s) nil))
    (return 0 false))

  (when (< (conv int x) (.-first s))
    (return 0 false))

  (when (>= (conv int x) (.cap s))
    (return 0 false))

  (let [k (conv ID (- (conv int x) (.-first s)))]
    (when (not (.contains (.-s s) k))
      (return 0 false))

    (.get (.-s s) k)))




^{:go/end 85} (go/method getEntry "getEntry returns the i'th key and value stored in s,\nwhere 0 <= i < s.size()\n" [^{:tag (* biasedSparseMap)} s ^int i] :results [^uint x ^int32 v]
  (let [e (aget (.contents (.-s s)) i)]
    (set! x (conv uint (+ (conv int (.-key e)) (.-first s))))
    (set! v (.-val e))
    (return)))



^{:go/end 93} (go/method set "add inserts x->v into s, provided that x is in the range of keys stored in s.\n" [^{:tag (* biasedSparseMap)} s ^uint x ^int32 v]
  (when (or (< (conv int x) (.-first s)) (>= (conv int x) (.cap s)))
    (return))

  (.set (.-s s) (conv ID (- (conv int x) (.-first s))) v))



^{:go/end 101} (go/method remove "remove removes key x from s.\n" [^{:tag (* biasedSparseMap)} s ^uint x]
  (when (or (< (conv int x) (.-first s)) (>= (conv int x) (.cap s)))
    (return))

  (.remove (.-s s) (conv ID (- (conv int x) (.-first s)))))


^{:go/end 107} (go/method clear [^{:tag (* biasedSparseMap)} s]
  (when (!= (.-s s) nil)
    (.clear (.-s s))))

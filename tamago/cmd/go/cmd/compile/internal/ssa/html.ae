^{:go/end 53} (go/func NewHTMLWriter ^{:tag (* HTMLWriter)} [^string path ^{:tag (* Func)} f ^string cfgMask]
  (set! path (strings/ReplaceAll path "/" (conv string filepath/Separator)))
  (let [(values out err) (os/OpenFile path (bit-or os/O_WRONLY os/O_CREATE os/O_TRUNC) 0644)]
    (when (!= err nil)
      (.Fatalf f "%v" err))

    (let [reportPath path]
      (when (not (filepath/IsAbs reportPath))
        (let [(values pwd err) (os/Getwd)]
          (when (!= err nil)
            (.Fatalf f "%v" err))

          (set! reportPath (filepath/Join pwd path))))

      (let [html ^{:go/breaks [2 4 6 8]} (lit HTMLWriter
            :w out
            :Func f
            :path reportPath
            :dot (newDotWriter cfgMask))]

        (.start html)
        (addr html)))))



^{:go/end 59} (go/method Fatalf "Fatalf reports an error and exits.\n" [^{:tag (* HTMLWriter)} w ^string msg & ^{:tag (slice any)} args]
  (let [fe (.Frontend (.-Func w))]
    (.Fatalf fe src/NoXPos msg (spread args))))



^{:go/end 64} (go/method Logf "Logf calls the (w *HTMLWriter).Func's Logf method passing along a msg and args.\n" [^{:tag (* HTMLWriter)} w ^string msg & ^{:tag (slice any)} args]
  (.Logf (.-Func w) msg (spread args)))


^{:go/end 777} (go/method start [^{:tag (* HTMLWriter)} w]
  (when (== w nil)

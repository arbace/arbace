^{:go/end 321} (go/func memoryBarrierTest ^bool [^{:tag (* Block)} b]
  (when (!= (.-Kind b) BlockARM64NZW)
    (return false))

  ^{:go/breaks [[4 320]]} (let [c (aget (.-Controls b) 0)]
    (when (!= (.-Op c) OpARM64MOVWUload)
      (return false))

    (when [(values globl ok) (assert (* obj/LSym) (.-Aux c))] ok
      (return (== (.-Name globl) "runtime.writeBarrier")))

    false))







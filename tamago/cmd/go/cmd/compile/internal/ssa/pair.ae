^{:go/end 25} (go/func pair "The pair pass finds memory operations that can be paired up\ninto single 2-register memory instructions.\n" [^{:tag (* Func)} f]
  ;; Only arm64 for now. This pass is fairly arch-specific.
  (switch (.-arch (.-Config f))
    (case ["arm64"])
    (default
      (return)))

  (pairLoads f)
  (pairStores f))



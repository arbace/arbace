    ^{:line 35} [OpARM64MOVDload (lit _ 8 OpARM64LDP)]
    ^{:line 36} [OpARM64MOVWUload (lit _ 4 OpARM64LDPW)]
    ^{:line 37} [OpARM64MOVWload (lit _ 4 OpARM64LDPSW)]
    ;; TODO: conceivably we could pair a signed and unsigned load
    ;; if we knew the upper bits of one of them weren't being used.
    ^{:line 40} [OpARM64FMOVDload (lit _ 8 OpARM64FLDPD)]
    ^{:line 41} [OpARM64FMOVSload (lit _ 4 OpARM64FLDPS)]))



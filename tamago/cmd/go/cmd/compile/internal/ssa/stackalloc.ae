  (aset (.-RegAlloc f) (.-ID v) loc))


^{:go/end 480} (go/method buildInterferenceGraph [^{:tag (* stackAllocState)} s]
  (let [f (.-f s)]
    (if [n (.NumValues f)] (>= (cap (.-interfere s)) n)
      (set! (.-interfere s) (subslice (.-interfere s) _ n))

      (set! (.-interfere s) (make (slice (slice ID)) n)))

    (let [live (.newSparseSet f (.NumValues f))]
      (defer (.retSparseSet f live))
      (range [_ b (.-Blocks f)]
        ;; Propagate liveness backwards to the start of the block.
        ;; Two values interfere if one is defined while the other is live.
        (.clear live)
        (.addAll live (aget (.-live s) (.-ID b)))
        (for [i (- (len (.-Values b)) 1)] (>= i 0) (dec! i)
          (let [v (aget (.-Values b) i)]
            (when (.-needSlot (aget (.-values s) (.-ID v)))
              (.remove live (.-ID v))
              (range [_ id (.contents live)]
                ;; Note: args can have different types and still interfere
                ;; (with each other or with other values). See issue 23522.
                (when (or (== (.Compare (.-typ (aget (.-values s) (.-ID v))) (.-typ (aget (.-values s) id))) types/CMPeq) (hasAnyArgOp v) (.-isArg (aget (.-values s) id)))
                  (aset (.-interfere s) (.-ID v) (append (aget (.-interfere s) (.-ID v)) id))
                  (aset (.-interfere s) id (append (aget (.-interfere s) id) (.-ID v))))))



            (range [_ a (.-Args v)]
              (when (.-needSlot (aget (.-values s) (.-ID a)))
                (.add live (.-ID a))))


            (when (and (hasAnyArgOp v) (.-needSlot (aget (.-values s) (.-ID v))))
              ;; OpArg is an input argument which is pre-spilled.
              ;; We add back v.ID here because we want this value
              ;; to appear live even before this point. Being live
              ;; all the way to the start of the entry block prevents other
              ;; values from being allocated to the same slot and clobbering
              ;; the input value before we have a chance to load it.

              ;; TODO(register args) this is apparently not wrong for register args -- is it necessary?
              (.add live (.-ID v))))))



      (when (> (.-debug (.-pass f)) stackDebug)
        (range [vid i (.-interfere s)]
          (when (> (len i) 0)
            (fmt/Printf "v%d interferes with" vid)
            (range [_ x i]

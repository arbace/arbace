            (range [_ b (.-Blocks (.-f s))]
              (fmt/Printf "stacklive %s %v\n" b (aget (.-live s) (.-ID b))))))))))




^{:go/end 415} (go/method getHome ^Location [^{:tag (* Func)} f ^ID vid]

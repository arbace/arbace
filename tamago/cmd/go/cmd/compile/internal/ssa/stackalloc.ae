                        (fmt/Printf "stackalloc %s to %s\n" v loc))

                      (.setHome f v loc)
                      (aset slots (.-ID v) i))))))))))))






^{:go/end 408} (go/method computeLive "computeLive computes a map from block ID to a list of\nstack-slot-needing value IDs live at the end of that block.\n" [^{:tag (* stackAllocState)} s ^{:tag (slice (slice ID))} spillLive]

  ;; Because values using stack slots are few and far inbetween
  ;; (compared to the set of all values), we use a path exploration
  ;; algorithm to calculate liveness here.
  (let [f (.-f s)]
    (range [_ b (.-Blocks f)]
      (range [_ spillvid (aget spillLive (.-ID b))]
        (let [val (addr (aget (.-values s) spillvid))]
          (.addUseBlock val b true)))

      (range [_ v (.-Values b)]
        (range [i a (.-Args v)]
          (let [val (addr (aget (.-values s) (.-ID a)))
              ^{:line 334} useBlock b
              ^{:line 335} forceLiveout false]
            (when (== (.-Op v) OpPhi)
              (set! useBlock (.-b (aget (.-Preds b) i)))
              (set! forceLiveout true)
              (when [spill (.-spill val)] (!= spill nil)
                ;;TODO: remove?  Subsumed by SpillUse?
                (.addUseBlock (aget (.-values s) (.-ID spill)) useBlock true)))


            (when (not (.-needSlot val))
              (continue))

            (.addUseBlock val useBlock forceLiveout)))))




    (set! (.-live s) (make (slice (slice ID)) (.NumBlocks f)))
    (let [push ^{:go/end 359} (fn [^ID bid ^ID vid]
          (let [l (aget (.-live s) bid)]
            (when (or (== l nil) (!= (aget l (- (len l) 1)) vid))
              (set! l (append l vid))
              (aset (.-live s) bid l))))


        ;; TODO: If we can help along the interference graph by calculating livein sets,
        ;; we can do so trivially by turning this sparse set into an array of arrays
        ;; and checking the top for the current value instead of inclusion in the sparse set.
        ^{:line 363} seen (.newSparseSet f (.NumBlocks f))]
      (defer (.retSparseSet f seen))

^{:go/end 111} (go/func stackalloc "stackalloc allocates storage in the stack frame for\nall Values that did not get a register.\nReturns a map from block ID to the stack values live at the end of that block.\n" ^{:tag (slice (slice ID))} [^{:tag (* Func)} f ^{:tag (slice (slice ID))} spillLive]

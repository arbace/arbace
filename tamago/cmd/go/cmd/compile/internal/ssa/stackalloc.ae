                (when (> (.-debug (.-pass f)) stackDebug)
                  (fmt/Printf "stackalloc register arg %s skipping name %s\n" v name))

                (continue)))

            (and (== (.-Class (.-N name)) ir/PPARAM) (!= (.-Op v) OpArg)) (do

^{:go/end 509} (go/func backedges "backedges returns a slice of successor edges that are back\nedges.  For reducible loops, edge.b is the header.\n" ^{:tag (slice Edge)} [^{:tag (* Func)} f]
  (let [edges (lit (slice Edge))
      ^{:line 484} mark (make (slice markKind) (.NumBlocks f))
      ^{:line 485} stack (lit (slice backedgesState))]

    (aset mark (.-ID (.-Entry f)) notExplored)
    (set! stack (append stack (lit backedgesState (.-Entry f) 0)))

    (while (> (len stack) 0)
      (let [l (len stack)
          ^{:line 492} x (aget stack (- l 1))]
        (if (< (.-i x) (len (.-Succs (.-b x))))
          (let [e (aget (.-Succs (.-b x)) (.-i x))]
            (inc! (.-i (aget stack (- l 1))))

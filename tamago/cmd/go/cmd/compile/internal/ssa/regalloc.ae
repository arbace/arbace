                    (when (.contains found (.-ID nb))
                      ;; Already found via another path.
                      (continue))

                    (let [nl (aget (.-b2l loopnest) (.-ID nb))]
                      (when (or (== nl nil) ^:go/paren (and (<= (.-depth nl) (.-depth l)) (!= nl l)))
                        ;; Left the loop.
                        (continue))

                      (set! tovisit (append tovisit nb))
                      (.add found (.-ID nb)))))))


            ;; No call-free path was found.
            (set! (.-containsUnavoidableCall l) true)))))))



^{:go/breaks [[5 3622]] :go/end 3623} (go/method containsCall ^bool [^{:tag (* Block)} b]
  (when (== (.-Kind b) BlockDefer)
    (return true))

  (range [_ v (.-Values b)]
    (when (.-call (aget opcodeTable (.-Op v)))
      (return true)))


  false)

^{:go/breaks [[8 596]] :go/end 597} (go/method removeable "removeable reports whether the value v can be removed from the SSA graph entirely\nif its use count drops to 0.\n" ^bool [^{:tag (* Value)} v]
  (when (.IsVoid (.-Type v))
    ;; Void ops (inline marks), must stay.
    (return false))

  (when (.-nilCheck (aget opcodeTable (.-Op v)))
    ;; Nil pointer checks must stay.
    (return false))

  (when (.IsMemory (.-Type v))
    ;; We don't need to preserve all memory ops, but we do need
    ;; to keep calls at least (because they might have
    ;; synchronization operations we can't see).
    (return false))

  (when (.HasSideEffects (.-Op v))
    ;; These are mostly synchronization operations.
    (return false))

  true)




^{:go/end 611} (go/func AutoVar "AutoVar returns a *Name and int64 representing the auto variable and offset within it\nwhere v should be spilled.\n" [^{:tag (* Value)} v] :results [(* ir/Name) int64]
  (when [(values loc ok) (assert LocalSlot (aget (.-RegAlloc (.-Func (.-Block v))) (.-ID v)))] ok
    (when (> (.Size (.-Type v)) (.Size (.-Type loc)))
      (.Fatalf v "v%d: spill/restore type %v doesn't fit in slot type %v" (.-ID v) (.-Type v) (.-Type loc)))

    (return (.-N loc) (.-Off loc)))

  ;; Assume it is a register, return its spill slot, which needs to be live
  (let [nameOff (assert (* AuxNameOffset) (.-Aux v))]
    (return (.-Name nameOff) (.-Offset nameOff))))



^{:go/end 667} (go/func CanSSA "CanSSA reports whether values of type t can be represented as a Value.\n" ^bool [^{:tag (* types/Type)} t]
  (types/CalcSize t)
  (when (.IsSIMD t)
    (return true))

  (when (== (.Size t) 0)
    (return true))

  (let [sizeLimit (conv int64 (* MaxStruct types/PtrSize))]
    (when (> (.Size t) sizeLimit)
      ;; 4*Widthptr is an arbitrary constant. We want it
      ;; to be at least 3*Widthptr so slices can be registerized.
      ;; Too big and we'll introduce too much register pressure.
      (when (not ^{:go/via [Flags]} (.-SIMD buildcfg/Experiment))
        (return false)))


    (switch (.Kind t)
      (case [types/TARRAY]
        ;; We can't do larger arrays because dynamic indexing is
        ;; not supported on SSA variables.
        ;; TODO: allow if all indexes are constant.
        (when (<= (.NumElem t) 1)
          (return (CanSSA (.Elem t))))

        (return false))
      (case [types/TSTRUCT]
        (when (types/IsDirectIface t)
          ;; Note: even if t.NumFields()>MaxStruct! See issue 77534.
          (return true))

        (when (> (.NumFields t) MaxStruct)
          (return false))

        (range [_ t1 (.Fields t)]
          (when (not (CanSSA (.-Type t1)))
            (return false)))


        ;; Special check for SIMD. If the composite type
        ;; contains SIMD vectors we can return true
        ;; if it pass the checks below.
        (when (not ^{:go/via [Flags]} (.-SIMD buildcfg/Experiment))
          (return true))

        (when (<= (.Size t) sizeLimit)
          (return true))

        (let [(values i f) (.Registers t)]
          (return (<= (+ i f) MaxStruct))))
      (default
        (return true)))))





^{:go/breaks [[6 678]] :go/end 679} (go/method AddrSinkArg "AddrSinkArg reports whether the idx'th argument is known\nto not propagate to the output value.\n" ^bool [^{:tag (* Value)} v ^int idx]
  (when (== idx 0)
    (return (.-addrSinkArg0 (aget opcodeTable (.-Op v)))))

  (when (== idx 1)
    (return (.-addrSinkArg1 (aget opcodeTable (.-Op v)))))

  false)

^{:go/end 190} (go/method LongString "long form print.  v# = opcode <type> [aux] args [: reg] (names)\n" ^string [^{:tag (* Value)} v]
  (when (== v nil)
    (return "<NIL VALUE>"))

  (let [s (fmt/Sprintf "v%d = %s" (.-ID v) (.-Op v))]
    (set! s + (+ " <" (.String (.-Type v)) ">"))
    (set! s + (.auxString v))
    (range [_ a (.-Args v)]
      (set! s + (fmt/Sprintf " %v" a)))

    (when (== (.-Block v) nil)
      (return s))

    (let [r (.-RegAlloc (.-Func (.-Block v)))]
      (when (and (< (conv int (.-ID v)) (len r)) (!= (aget r (.-ID v)) nil))
        (set! s + (+ " : " (.String (aget r (.-ID v))))))

      (when [reg (aget (.-tempRegs (.-Func (.-Block v))) (.-ID v))] (!= reg nil)
        (set! s + (+ " tmp=" (.String reg))))

      (let [^{:tag (slice string)} names (zero (slice string))]
        (range [name values (.-NamedValues (.-Func (.-Block v)))]
          (range [_ value values]
            (when (== value v)
              (set! names (append names (.String name)))
              (break)))) ; drop duplicates.



        (when (!= (len names) 0)
          (sort/Strings names) ; Otherwise a source of variation in debugging output.
          (set! s + (+ " (" (strings/Join names ", ") ")")))

        ^{:line 189} s))))


^{:go/end 259} (go/method auxString ^string [^{:tag (* Value)} v]
  (switch (.-auxType (aget opcodeTable (.-Op v)))
    (case [auxBool]
      (if (== (.-AuxInt v) 0)
        (return " [false]")

        (return " [true]")))

    (case [auxInt8]
      (return (fmt/Sprintf " [%d]" (.AuxInt8 v))))
    (case [auxInt16]
      (return (fmt/Sprintf " [%d]" (.AuxInt16 v))))
    (case [auxInt32]
      (return (fmt/Sprintf " [%d]" (.AuxInt32 v))))
    (case [auxInt64 auxInt128]
      (return (fmt/Sprintf " [%d]" (.-AuxInt v))))
    (case [auxUInt8]
      (return (fmt/Sprintf " [%d]" (.AuxUInt8 v))))
    (case [auxARM64BitField]
      (let [lsb (.lsb (.AuxArm64BitField v))
          ^{:line 212} width (.width (.AuxArm64BitField v))]
        (return (fmt/Sprintf " [lsb=%d,width=%d]" lsb width))))
    (case [auxARM64ConditionalParams]
      (let [params (.AuxArm64ConditionalParams v)
          ^{:line 216} cond (.Cond params)
          ^{:line 217} nzcv (.Nzcv params)
          (values imm ok) (.ConstValue params)]
        (when ok
          (return (fmt/Sprintf " [cond=%s,nzcv=%d,imm=%d]" cond nzcv imm)))

        (return (fmt/Sprintf " [cond=%s,nzcv=%d]" cond nzcv))))
    (case [auxFloat32 auxFloat64]
      (return (fmt/Sprintf " [%g]" (.AuxFloat v))))
    (case [auxString]
      (return (fmt/Sprintf " {%q}" (.-Aux v))))
    (case [auxSym auxCall auxTyp]
      (when (!= (.-Aux v) nil)
        (return (fmt/Sprintf " {%v}" (.-Aux v))))

      (return ""))
    (case [auxSymOff auxCallOff auxTypSize auxNameOffsetInt8]
      (let [s ""]
        (when (!= (.-Aux v) nil)
          (set! s (fmt/Sprintf " {%v}" (.-Aux v))))

        (when (or (!= (.-AuxInt v) 0) (== (.-auxType (aget opcodeTable (.-Op v))) auxNameOffsetInt8))
          (set! s + (fmt/Sprintf " [%v]" (.-AuxInt v))))

        (return s)))
    (case [auxSymValAndOff]
      (let [s ""]
        (when (!= (.-Aux v) nil)
          (set! s (fmt/Sprintf " {%v}" (.-Aux v))))

        (return (+ s (fmt/Sprintf " [%s]" (.AuxValAndOff v))))))
    (case [auxCCop]
      (return (fmt/Sprintf " [%s]" (conv Op (.-AuxInt v)))))
    (case [auxS390XCCMask auxS390XRotateParams]
      (return (fmt/Sprintf " {%v}" (.-Aux v))))
    (case [auxFlagConstant]
      (return (fmt/Sprintf "[%s]" (conv flagConstant (.-AuxInt v)))))
    (case [auxNone]
      (return ""))
    (default
      ;; If you see this, add a case above instead.
      (return (fmt/Sprintf "[auxtype=%d AuxInt=%d Aux=%v]" (.-auxType (aget opcodeTable (.-Op v))) (.-AuxInt v) (.-Aux v))))))








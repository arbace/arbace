(in-ns 'go.cmd.compile.internal.types) (go/file "alg.go" :imports [

    ^{:line 7} [base "cmd/compile/internal/base"]])



(go/type AlgKind "AlgKind describes the kind of algorithms used for comparing and\nhashing a Type.\n" int8)

(go/directive "//go:generate stringer -type AlgKind -trimprefix A alg.go")

(go/const
  ^{:line 16} [^{:tag AlgKind :val 0} AUNK iota]
  ^{:line 17} [^{:val 1} ANOEQ] ; Types cannot be compared
  ^{:line 18} [^{:val 2} ANOALG] ; implies ANOEQ, and in addition has a part that is marked Noalg
  ^{:line 19} [^{:val 3} AMEM] ; Type can be compared/hashed as regular memory.
  ^{:line 20} [^{:val 4} AMEM0] ; Specific subvariants of AMEM (TODO: move to ../reflectdata?)
  ^{:line 21} [^{:val 5} AMEM8]
  ^{:line 22} [^{:val 6} AMEM16]
  ^{:line 23} [^{:val 7} AMEM32]
  ^{:line 24} [^{:val 8} AMEM64]
  ^{:line 25} [^{:val 9} AMEM128]
  ^{:line 26} [^{:val 10} ASTRING]
  ^{:line 27} [^{:val 11} AINTER]
  ^{:line 28} [^{:val 12} ANILINTER]
  ^{:line 29} [^{:val 13} AFLOAT32]
  ^{:line 30} [^{:val 14} AFLOAT64]
  ^{:line 31} [^{:val 15} ACPLX64]
  ^{:line 32} [^{:val 16} ACPLX128]
  ^{:line 33} [^{:val 17} ASPECIAL]) ; Type needs special comparison/hashing functions.




(go/var ^{:doc "Most kinds are priority 0. Higher numbers are higher priority, in that\nthe higher priority kinds override lower priority kinds.\n"} algPriority (lit (array (+ ASPECIAL 1) int8) [ASPECIAL 1] [ANOEQ 2] [ANOALG 3] [AMEM -1]))



^{:go/end 51} (go/method setAlg "setAlg sets the algorithm type of t to a, if it is of higher\npriority to the current algorithm type.\n" [^{:tag (* Type)} t ^AlgKind a]
  (when (== (.-alg t) AUNK)
    (base/Fatalf "setAlg(%v,%s) starting with unknown priority" t a))

  (cond (> (aget algPriority a) (aget algPriority (.-alg t)))
    (set! (.-alg t) a)
    (and (!= a (.-alg t)) (== (aget algPriority a) (aget algPriority (.-alg t))))
    (base/Fatalf "ambiguous priority %s and %s" a (.-alg t))))




^{:go/end 57} (go/func AlgType "AlgType returns the AlgKind used for comparing and hashing Type t.\n" ^AlgKind [^{:tag (* Type)} t]
  (CalcSize t)
  (.-alg t))




^{:go/end 63} (go/func TypeHasNoAlg "TypeHasNoAlg reports whether t does not have any associated hash/eq\nalgorithms because t, or some component of t, is marked Noalg.\n" ^bool [^{:tag (* Type)} t]
  (== (AlgType t) ANOALG))



^{:go/end 69} (go/func IsComparable "IsComparable reports whether t is a comparable type.\n" ^bool [^{:tag (* Type)} t]
  (let [a (AlgType t)]
    (and (!= a ANOEQ) (!= a ANOALG))))



^{:go/breaks [[5 78]] :go/end 79} (go/func IncomparableField "IncomparableField returns an incomparable Field of struct Type t, if any.\n" ^{:tag (* Field)} [^{:tag (* Type)} t]
  (range [_ f (.Fields t)]
    (when (not (IsComparable (.-Type f)))
      (return f)))


  nil)




^{:go/end 92} (go/func IsPaddedField "IsPaddedField reports whether the i'th field of struct type t is followed\nby padding.\n" ^bool [^{:tag (* Type)} t ^int i]
  (when (not (.IsStruct t))
    (base/Fatalf "IsPaddedField called non-struct %v" t))

  (let [end (.-width t)]
    (when (< (+ i 1) (.NumFields t))
      (set! end (.-Offset (.Field t (+ i 1)))))

    (!= (.End (.Field t i)) end)))

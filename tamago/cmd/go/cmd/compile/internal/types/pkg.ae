  ^{:line 119} [internedStrings (lit (map string string))])


^{:go/end 131} (go/func InternString ^string [^{:tag (slice byte)} b]
  (.Lock internedStringsmu)
  (let [(values s ok) (aget internedStrings (conv string b))] ; string(b) here doesn't allocate
    (when (not ok)
      (set! s (conv string b))
      (aset internedStrings s s))

    (.Unlock internedStringsmu)
    ^{:line 130} s))

^{:go/end 55} (go/func NewPkg "NewPkg returns a new Pkg for the given package path and name.\nUnless name is the empty string, if the package exists already,\nthe existing package name and the provided name must match.\n" ^{:tag (* Pkg)} [^string path ^string name]
  (when [p (aget pkgMap path)] (!= p nil)
    (when (and (!= name "") (!= (.-Name p) name))
      (panic (fmt/Sprintf "conflicting package names %s and %s for path %q" (.-Name p) name path)))

    (return p))


  (let [p (new Pkg)]
    (set! (.-Path p) path)
    (set! (.-Name p) name)
    (if (== path "go.shape")
      ;; Don't escape "go.shape", since it's not needed (it's a builtin
      ;; package), and we don't want escape codes showing up in shape type
      ;; names, which also appear in names of function/method
      ;; instantiations.
      (set! (.-Prefix p) path)

      (set! (.-Prefix p) (objabi/PathToPrefix path)))

    (set! (.-Syms p) (make (map string (* Sym))))
    (aset pkgMap path p)

    ^{:line 54} p))



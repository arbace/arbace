  ^{:line 58} pkgMap)


(go/var nopkg (addr ^{:go/breaks [2]} (lit Pkg
      :Syms (make (map string (* Sym))))))


^{:go/end 68} (go/method Lookup ^{:tag (* Sym)} [^{:tag (* Pkg)} pkg ^string name]

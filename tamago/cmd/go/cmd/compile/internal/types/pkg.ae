    ^{:line 67} s))



^{:go/end 86} (go/method LookupOK "LookupOK looks up name in pkg and reports whether it previously existed.\n" [^{:tag (* Pkg)} pkg ^string name] :results [^{:tag (* Sym)} s ^bool existed]
  ;; TODO(gri) remove this check in favor of specialized lookup
  (when (== pkg nil)
    (set! pkg nopkg))

  (when [s (aget (.-Syms pkg) name)] (!= s nil)
    (return s true))


  (set! s (addr ^{:go/breaks [2 4]} (lit Sym
        :Name name
        :Pkg pkg)))

  (aset (.-Syms pkg) name s)
  (return s false))


^{:go/end 98} (go/method LookupBytes ^{:tag (* Sym)} [^{:tag (* Pkg)} pkg ^{:tag (slice byte)} name]
  ;; TODO(gri) remove this check in favor of specialized lookup
  (when (== pkg nil)
    (set! pkg nopkg))

  (when [s (aget (.-Syms pkg) (conv string name))] (!= s nil)
    (return s))

  (let [str (InternString name)]
    (.Lookup pkg str)))




^{:go/end 107} (go/method LookupNum "LookupNum looks up the symbol starting with prefix and ending with\nthe decimal n. If prefix is too long, LookupNum panics.\n" ^{:tag (* Sym)} [^{:tag (* Pkg)} pkg ^string prefix ^int n]
  (let [^{:tag (array 20 byte)} buf (zero (array 20 byte))] ; plenty long enough for all current users
    (copy (subslice buf) prefix)
    (let [b (strconv/AppendInt (subslice buf _ (len prefix)) (conv int64 n) 10)]
      (.LookupBytes pkg b))))



^{:go/end 115} (go/method Selector "Selector looks up a selector identifier.\n" ^{:tag (* Sym)} [^{:tag (* Pkg)} pkg ^string name]
  (when (IsExported name)
    (set! pkg LocalPkg))

  (.Lookup pkg name))



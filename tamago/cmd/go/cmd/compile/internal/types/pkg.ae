(go/var ^{:doc "pkgMap maps a package path to a package.\n"} pkgMap (make (map string (* Pkg))))

(go/type Pkg (struct
    ^{:line 19 :tag string} Path ; string literal used in import statement, e.g. "internal/runtime/sys"
    ^{:line 20 :tag string} Name ; package name, e.g. "sys"
    ^{:line 21 :tag string} Prefix ; escaped path for use in symbol table

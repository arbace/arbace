(in-ns 'go.cmd.compile.internal.types) (go/file "goversion.go" :imports [


    ^{:line 8} [fmt "fmt"]
    ^{:line 9} [goversion "internal/goversion"]
    ^{:line 10} [lazyregexp "internal/lazyregexp"]
    ^{:line 11} [log "log"]
    ^{:line 12} [strconv "strconv"]

    ^{:line 14} [base "cmd/compile/internal/base"]])



(go/type lang "A lang is a language version broken into major and minor numbers.\n" (struct
    ^{:line 19 :tag int} major ^int minor))





(go/var ^{:tag lang :doc "langWant is the desired language version set by the -lang flag.\nIf the -lang flag is not set, this is the zero value, meaning that\nany language version is supported.\n"} langWant)



^{:go/end 34} (go/func AllowsGoVersion "AllowsGoVersion reports whether local package is allowed\nto use Go version major.minor.\n" ^bool [^int major ^int minor]
  (when (and (== (.-major langWant) 0) (== (.-minor langWant) 0))
    (return true))

  (or (> (.-major langWant) major) ^:go/paren (and (== (.-major langWant) major) (>= (.-minor langWant) minor))))




^{:go/end 58} (go/func ParseLangFlag "ParseLangFlag verifies that the -lang flag holds a valid value, and\nexits if not. It initializes data used by AllowsGoVersion.\n" []
  (when (== (.-Lang base/Flag) "")
    (return))


  (let [^error err (zero error)]
    (set! (values langWant err) (parseLang (.-Lang base/Flag)))
    (when (!= err nil)
      (log/Fatalf "invalid value %q for -lang: %v" (.-Lang base/Flag) err))


    (when [def (currentLang)] (!= (.-Lang base/Flag) def)
      (let [(values defVers err) (parseLang def)]
        (when (!= err nil)
          (log/Fatalf "internal error parsing default lang %q: %v" def err))

        (when (or (> (.-major langWant) (.-major defVers)) ^:go/paren (and (== (.-major langWant) (.-major defVers)) (> (.-minor langWant) (.-minor defVers))))
          (log/Fatalf "invalid value %q for -lang: max known version is %q" (.-Lang base/Flag) def))))))





^{:go/end 79} (go/func parseLang "parseLang parses a -lang option into a langVer.\n" [^string s] :results [lang error]
  (when (== s "go1") ; cmd/go's new spelling of "go1.0" (#65528)
    (set! s "go1.0"))


  (let [matches (.FindStringSubmatch goVersionRE s)]
    (when (== matches nil)
      (return (lit lang) (fmt/Errorf "should be something like \"go1.12\"")))

    (let [(values major err) (strconv/Atoi (aget matches 1))]
      (when (!= err nil)
        (return (lit lang) err))

      (let [(values minor ^:assign err) (strconv/Atoi (aget matches 2))]
        (when (!= err nil)
          (return (lit lang) err))

        (return (lit lang :major major :minor minor) nil)))))



^{:go/end 84} (go/func currentLang "currentLang returns the current language version.\n" ^string []
  (fmt/Sprintf "go1.%d" goversion/Version))




(go/var ^{:doc "goVersionRE is a regular expression that matches the valid\narguments to the -lang flag.\n"} goVersionRE (lazyregexp/New "^go([1-9]\\d*)\\.(0|[1-9]\\d*)$"))

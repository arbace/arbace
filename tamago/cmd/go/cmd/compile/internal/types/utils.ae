(in-ns 'go.cmd.compile.internal.types) (go/file "utils.go" :imports [])

(go/const ^{:val -1000000000} BADWIDTH -1000000000)

(go/type bitset8 uint8)

^{:go/end 17} (go/method set [^{:tag (* bitset8)} f ^uint8 mask ^bool b]
  (if b
    (set! @(conv (* uint8) f) bit-or mask)

    (set! @(conv (* uint8) f) bit-and-not mask)))

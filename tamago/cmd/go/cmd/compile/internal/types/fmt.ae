(go/var ^{:tag (* Pkg) :doc "BuiltinPkg is a fake package that declares the universe block.\n"} BuiltinPkg)


(go/var ^{:tag (* Pkg) :doc "LocalPkg is the package being compiled.\n"} LocalPkg)


(go/var ^{:tag (* Pkg) :doc "UnsafePkg is package unsafe.\n"} UnsafePkg)


(go/var ^{:tag (* Sym) :doc "BlankSym is the blank (_) symbol.\n"} BlankSym)





(go/var ^{:doc "numImport tracks how often a package with a given name is imported.\nIt is used to provide a better error message (by using the package\npath to disambiguate) if a package that appears multiple times with\nthe same name appears in an error message.\n"} NumImport (make (map string int)))






(go/type fmtMode "fmtMode represents the kind of printing being done.\nThe default is regular Go syntax (fmtGo).\nfmtDebug is like fmtGo but for debugging dumps and prints the type kind too.\nfmtTypeID and fmtTypeIDName are for generating various unique representations\nof types used in hashes, the linker, and function/method instantiations.\n" int)

(go/const
  ^{:line 45} [^{:tag fmtMode :val 0} fmtGo iota]
  ^{:line 46} [^{:val 1} fmtDebug]
  ^{:line 47} [^{:val 2} fmtTypeID]
  ^{:line 48} [^{:val 3} fmtTypeIDName])


;; Sym







^{:go/end 71} (go/method Format "Format implements formatting for a Sym.\nThe valid formats are:\n\n\t%v\tGo syntax: Name for symbols in the local package, PkgName.Name for imported symbols.\n\t%+v\tDebug syntax: always include PkgName. prefix even for local names.\n\t%S\tShort syntax: Name only, no matter what.\n" [^{:tag (* Sym)} s ^fmt/State f ^rune verb]
  (let [mode fmtGo]
    (switch verb
      (case [\v \S]
        (when (and (== verb \v) (.Flag f \+))
          (set! mode fmtDebug))

        (fmt/Fprint f (sconv s verb mode)))

      (default
        (fmt/Fprintf f "%%!%c(*types.Sym=%p)" verb s)))))



^{:go/end 75} (go/method String ^string [^{:tag (* Sym)} s]
  (sconv s 0 fmtGo))




^{:go/end 101} (go/func sconv "See #16897 for details about performance implications\nbefore changing the implementation of sconv.\n" ^string [^{:tag (* Sym)} s ^rune verb ^fmtMode mode]
  (when (== verb \L)
    (panic "linksymfmt"))


  (when (== s nil)
    (return "<S>"))


  (let [q (pkgqual (.-Pkg s) verb mode)]
    (when (== q "")
      (return (.-Name s)))


    (let [buf (assert (* bytes/Buffer) (.Get fmtBufferPool))]
      (.Reset buf)
      (defer (.Put fmtBufferPool buf))

      (.WriteString buf q)
      (.WriteByte buf \.)
      (.WriteString buf (.-Name s))
      (InternString (.Bytes buf)))))


^{:go/end 113} (go/func sconv2 [^{:tag (* bytes/Buffer)} b ^{:tag (* Sym)} s ^rune verb ^fmtMode mode]
  (when (== verb \L)
    (panic "linksymfmt"))

  (when (== s nil)
    (.WriteString b "<S>")
    (return))


  (symfmt b s verb mode))


^{:go/end 122} (go/func symfmt [^{:tag (* bytes/Buffer)} b ^{:tag (* Sym)} s ^rune verb ^fmtMode mode]
  (let [name (.-Name s)]
    (when [q (pkgqual (.-Pkg s) verb mode)] (!= q "")
      (.WriteString b q)
      (.WriteByte b \.))

    (.WriteString b name)))





^{:go/breaks [[6 157]] :go/end 158} (go/func pkgqual "pkgqual returns the qualifier that should be used for printing\nsymbols from the given package in the given mode.\nIf it returns the empty string, no qualification is needed.\n" ^string [^{:tag (* Pkg)} pkg ^rune verb ^fmtMode mode]
  (when (== pkg nil)
    (return ""))

  (when (!= verb \S)
    (switch mode
      (case [fmtGo] ; This is for the user
        (when (or (== pkg BuiltinPkg) (== pkg LocalPkg))
          (return ""))


        ;; If the name was used by multiple packages, display the full path,
        (when (and (!= (.-Name pkg) "") (> (aget NumImport (.-Name pkg)) 1))
          (return (strconv/Quote (.-Path pkg))))

        (return (.-Name pkg)))

      (case [fmtDebug]
        (return (.-Name pkg)))

      (case [fmtTypeIDName]
        ;; dcommontype, typehash
        (return (.-Name pkg)))

      (case [fmtTypeID]
        ;; (methodsym), typesym, weaksym
        (return (.-Prefix pkg)))))



  "")



    ^{:line 312 :tag Cursor} c ; cursor pointing at first element
    ^{:line 313 :tag int} n)) ; number of elements



^{:go/end 322} (go/func NewArrayCursor "NewArrayCursor returns a cursor starting at lsym+off and having n copies of type t.\n" ^ArrayCursor [^{:tag (* obj/LSym)} lsym ^int64 off ^{:tag (* types/Type)} t ^int n]
  ^{:go/breaks [2 4]} (lit ArrayCursor
    :c (NewCursor lsym off t)
    :n n))




^{:go/end 330} (go/method Elem "Elem selects element i of the array pointed to by c.\n" ^Cursor [^ArrayCursor a ^int i]
  (when (or (< i 0) (>= i (.-n a)))
    (base/Fatalf "element index %d out of range [0:%d]" i (.-n a)))

  (lit Cursor :lsym (.-lsym (.-c a)) :offset (+ (.-offset (.-c a)) (* (conv int64 i) (.Size (.-typ (.-c a))))) :typ (.-typ (.-c a))))





^{:go/end 341} (go/method ModifyArray "ModifyArray converts a cursor pointing at a type [k]T to a cursor pointing\nat a type [n]T.\nAlso returns the size delta, aka (n-k)*sizeof(T).\n" [^Cursor c ^int n] :results [ArrayCursor int64]
  (when (!= (.Kind (.-typ c)) types/TARRAY)
    (base/Fatalf "can't call ModifyArray on non-array %v" (.-typ c)))

  (let [k (.NumElem (.-typ c))]
    (return (lit ArrayCursor :c (lit Cursor :lsym (.-lsym c) :offset (.-offset c) :typ (.Elem (.-typ c))) :n n) (* (- (conv int64 n) k) (.Size (.Elem (.-typ c)))))))

;; Package rttype allows the compiler to share type information with
;; the runtime. The shared type information is stored in
;; internal/abi. This package translates those types from the host
;; machine on which the compiler runs to the target machine on which
;; the compiled program will run. In particular, this package handles
;; layout differences between e.g. a 64 bit compiler and 32 bit
;; target.
(in-ns 'go.cmd.compile.internal.rttype) (go/file "rttype.go" :doc "Package rttype allows the compiler to share type information with\nthe runtime. The shared type information is stored in\ninternal/abi. This package translates those types from the host\nmachine on which the compiler runs to the target machine on which\nthe compiled program will run. In particular, this package handles\nlayout differences between e.g. a 64 bit compiler and 32 bit\ntarget.\n" :imports [


    ^{:line 15} [base "cmd/compile/internal/base"]
    ^{:line 16} [objw "cmd/compile/internal/objw"]
    ^{:line 17} [types "cmd/compile/internal/types"]
    ^{:line 18} [obj "cmd/internal/obj"]
    ^{:line 19} [abi "internal/abi"]
    ^{:line 20} [reflect "reflect"]])



(go/var ^{:tag (* types/Type) :doc "The type structures shared with the runtime.\n"} Type)

(go/var ^{:tag (* types/Type)} ArrayType)
(go/var ^{:tag (* types/Type)} ChanType)
(go/var ^{:tag (* types/Type)} FuncType)
(go/var ^{:tag (* types/Type)} InterfaceType)
(go/var ^{:tag (* types/Type)} MapType)
(go/var ^{:tag (* types/Type)} PtrType)
(go/var ^{:tag (* types/Type)} SliceType)
(go/var ^{:tag (* types/Type)} StructType)


(go/var ^{:tag (* types/Type) :doc "Types that are parts of the types above.\n"} IMethod)
(go/var ^{:tag (* types/Type)} Method)
(go/var ^{:tag (* types/Type)} StructField)
(go/var ^{:tag (* types/Type)} UncommonType)


(go/var ^{:tag (* types/Type) :doc "Type switches and asserts\n"} InterfaceSwitch)
(go/var ^{:tag (* types/Type)} TypeAssert)


(go/var ^{:tag (* types/Type) :doc "Interface tables (itabs)\n"} ITab)

^{:go/end 109} (go/func Init []
  ;; Note: this has to be called explicitly instead of being
  ;; an init function so it runs after the types package has
  ;; been properly initialized.
  (set! Type (FromReflect ((inst reflect/TypeFor abi/Type))))
  (set! ArrayType (FromReflect ((inst reflect/TypeFor abi/ArrayType))))
  (set! ChanType (FromReflect ((inst reflect/TypeFor abi/ChanType))))
  (set! FuncType (FromReflect ((inst reflect/TypeFor abi/FuncType))))
  (set! InterfaceType (FromReflect ((inst reflect/TypeFor abi/InterfaceType))))
  (set! MapType (FromReflect ((inst reflect/TypeFor abi/MapType))))
  (set! PtrType (FromReflect ((inst reflect/TypeFor abi/PtrType))))
  (set! SliceType (FromReflect ((inst reflect/TypeFor abi/SliceType))))
  (set! StructType (FromReflect ((inst reflect/TypeFor abi/StructType))))

  (set! IMethod (FromReflect ((inst reflect/TypeFor abi/Imethod))))
  (set! Method (FromReflect ((inst reflect/TypeFor abi/Method))))
  (set! StructField (FromReflect ((inst reflect/TypeFor abi/StructField))))
  (set! UncommonType (FromReflect ((inst reflect/TypeFor abi/UncommonType))))

  (set! InterfaceSwitch (FromReflect ((inst reflect/TypeFor abi/InterfaceSwitch))))
  (set! TypeAssert (FromReflect ((inst reflect/TypeFor abi/TypeAssert))))

  (set! ITab (FromReflect ((inst reflect/TypeFor abi/ITab))))

  ;; Make sure abi functions are correct. These functions are used
  ;; by the linker which doesn't have the ability to do type layout,
  ;; so we check the functions it uses here.
  (let [ptrSize types/PtrSize]
    (when [(values got want) (values (conv int64 (abi/CommonSize ptrSize)) (.Size Type))] (!= got want)
      (base/Fatalf "abi.CommonSize() == %d, want %d" got want))

    (when [(values got want) (values (conv int64 (abi/StructFieldSize ptrSize)) (.Size StructField))] (!= got want)
      (base/Fatalf "abi.StructFieldSize() == %d, want %d" got want))

    (when [(values got want) (values (conv int64 (abi/UncommonSize)) (.Size UncommonType))] (!= got want)
      (base/Fatalf "abi.UncommonSize() == %d, want %d" got want))

    (when [(values got want) (values (conv int64 (abi/TFlagOff ptrSize)) (.OffsetOf Type "TFlag"))] (!= got want)
      (base/Fatalf "abi.TFlagOff() == %d, want %d" got want))

    (when [(values got want) (values (conv int64 (abi/ITabTypeOff ptrSize)) (.OffsetOf ITab "Type"))] (!= got want)
      (base/Fatalf "abi.ITabTypeOff() == %d, want %d" got want))

    (range [_ test (lit (slice (struct
              ^{:line 92 :tag abi/Kind} kind
              ^{:line 93 :tag (* types/Type)} typ
              ^{:line 94 :tag string} name))

          (lit _ abi/Struct StructType "Struct")
          (lit _ abi/Pointer PtrType "Pointer")
          (lit _ abi/Func FuncType "Func")
          (lit _ abi/Slice SliceType "Slice")
          (lit _ abi/Array ArrayType "Array")
          (lit _ abi/Chan ChanType "Chan")
          (lit _ abi/Map MapType "Map")
          (lit _ abi/Interface InterfaceType "Interface"))]

      (when [(values got want) (values (conv int64 (abi/RTypeSize (.-kind test) ptrSize)) (.Size (.-typ test)))] (!= got want)
        (base/Fatalf "abi.RTypeSize(%s) == %d, want %d" (.-name test) got want)))))





^{:go/end 116} (go/func FromReflect "FromReflect translates from a host type to the equivalent target type.\n" ^{:tag (* types/Type)} [^reflect/Type rt]
  (let [t (reflectToType rt)]
    (types/CalcSize t)
    ^{:line 115} t))





^{:go/end 173} (go/func reflectToType "reflectToType converts from a reflect.Type (which is a compiler\nhost type) to a *types.Type, which is a target type.  The result\nmust be CalcSize'd before using.\n" ^{:tag (* types/Type)} [^reflect/Type rt]
  (switch (.Kind rt)
    (case [reflect/Bool]
      (return (aget types/Types types/TBOOL)))
    (case [reflect/Int]
      (return (aget types/Types types/TINT)))
    (case [reflect/Int8]
      (return (aget types/Types types/TINT8)))
    (case [reflect/Int16]
      (return (aget types/Types types/TINT16)))
    (case [reflect/Int32]
      (return (aget types/Types types/TINT32)))
    (case [reflect/Uint8]
      (return (aget types/Types types/TUINT8)))
    (case [reflect/Uint16]
      (return (aget types/Types types/TUINT16)))
    (case [reflect/Uint32]
      (return (aget types/Types types/TUINT32)))
    (case [reflect/Float32]
      (return (aget types/Types types/TFLOAT32)))
    (case [reflect/Float64]
      (return (aget types/Types types/TFLOAT64)))
    (case [reflect/Uintptr]
      (return (aget types/Types types/TUINTPTR)))
    (case [reflect/Ptr]
      (return (types/NewPtr (reflectToType (.Elem rt)))))
    (case [reflect/Func reflect/UnsafePointer]
      ;; TODO: there's no mechanism to distinguish different pointer types,
      ;; so we treat them all as unsafe.Pointer.
      (return (aget types/Types types/TUNSAFEPTR)))
    (case [reflect/Slice]
      (return (types/NewSlice (reflectToType (.Elem rt)))))
    (case [reflect/Array]
      (return (types/NewArray (reflectToType (.Elem rt)) (conv int64 (.Len rt)))))
    (case [reflect/Struct]
      (let [fields (make (slice (* types/Field)) (.NumField rt))]
        (for [i 0] (< i (.NumField rt)) (inc! i)
          (let [f (.Field rt i)
              ^{:line 159} ft (reflectToType (.-Type f))]
            (aset fields i (addr (lit types/Field :Sym (addr (lit types/Sym :Name (.-Name f))) :Type ft)))))

        (return (types/NewStruct fields))))
    (case [reflect/Chan]
      (return (types/NewChan (reflectToType (.Elem rt)) (conv types/ChanDir (.ChanDir rt)))))
    (case [reflect/String]
      (return (aget types/Types types/TSTRING)))
    (case [reflect/Complex128]
      (return (aget types/Types types/TCOMPLEX128)))
    (default
      (base/Fatalf "unhandled kind %s" (.Kind rt))
      (return nil))))





(go/type Cursor "A Cursor represents a typed location inside a static variable where we\nare going to write.\n" (struct
    ^{:line 178 :tag (* obj/LSym)} lsym
    ^{:line 179 :tag int64} offset
    ^{:line 180 :tag (* types/Type)} typ))



^{:go/end 186} (go/func NewCursor "NewCursor returns a cursor starting at lsym+off and having type t.\n" ^Cursor [^{:tag (* obj/LSym)} lsym ^int64 off ^{:tag (* types/Type)} t]
  (lit Cursor :lsym lsym :offset off :typ t))



^{:go/end 198} (go/method WritePtr "WritePtr writes a pointer \"target\" to the component at the location specified by c.\n" [^Cursor c ^{:tag (* obj/LSym)} target]
  (when (and (!= (.Kind (.-typ c)) types/TUNSAFEPTR) (!= (.Kind (.-typ c)) types/TPTR))
    (base/Fatalf "can't write ptr, it has kind %s" (.Kind (.-typ c))))

  (if (== target nil)
    (objw/Uintptr (.-lsym c) (conv int (.-offset c)) 0)

    (objw/SymPtr (.-lsym c) (conv int (.-offset c)) target 0)))


^{:go/end 204} (go/method WritePtrWeak [^Cursor c ^{:tag (* obj/LSym)} target]
  (when (!= (.Kind (.-typ c)) types/TUINTPTR)
    (base/Fatalf "can't write ptr, it has kind %s" (.Kind (.-typ c))))

  (objw/SymPtrWeak (.-lsym c) (conv int (.-offset c)) target 0))

^{:go/end 210} (go/method WriteUintptr [^Cursor c ^uint64 val]
  (when (!= (.Kind (.-typ c)) types/TUINTPTR)
    (base/Fatalf "can't write uintptr, it has kind %s" (.Kind (.-typ c))))

  (objw/Uintptr (.-lsym c) (conv int (.-offset c)) val))

^{:go/end 216} (go/method WriteUint32 [^Cursor c ^uint32 val]
  (when (!= (.Kind (.-typ c)) types/TUINT32)
    (base/Fatalf "can't write uint32, it has kind %s" (.Kind (.-typ c))))

  (objw/Uint32 (.-lsym c) (conv int (.-offset c)) val))

^{:go/end 222} (go/method WriteUint16 [^Cursor c ^uint16 val]
  (when (!= (.Kind (.-typ c)) types/TUINT16)
    (base/Fatalf "can't write uint16, it has kind %s" (.Kind (.-typ c))))

  (objw/Uint16 (.-lsym c) (conv int (.-offset c)) val))

^{:go/end 228} (go/method WriteUint8 [^Cursor c ^uint8 val]
  (when (!= (.Kind (.-typ c)) types/TUINT8)
    (base/Fatalf "can't write uint8, it has kind %s" (.Kind (.-typ c))))

  (objw/Uint8 (.-lsym c) (conv int (.-offset c)) val))

^{:go/end 234} (go/method WriteInt [^Cursor c ^int64 val]
  (when (!= (.Kind (.-typ c)) types/TINT)
    (base/Fatalf "can't write int, it has kind %s" (.Kind (.-typ c))))

  (objw/Uintptr (.-lsym c) (conv int (.-offset c)) (conv uint64 val)))

^{:go/end 240} (go/method WriteInt32 [^Cursor c ^int32 val]
  (when (!= (.Kind (.-typ c)) types/TINT32)
    (base/Fatalf "can't write int32, it has kind %s" (.Kind (.-typ c))))

  (objw/Uint32 (.-lsym c) (conv int (.-offset c)) (conv uint32 val)))

^{:go/end 246} (go/method WriteBool [^Cursor c ^bool val]
  (when (!= (.Kind (.-typ c)) types/TBOOL)
    (base/Fatalf "can't write bool, it has kind %s" (.Kind (.-typ c))))

  (objw/Bool (.-lsym c) (conv int (.-offset c)) val))




^{:go/end 261} (go/method WriteSymPtrOff "WriteSymPtrOff writes a \"pointer\" to the given symbol. The symbol\nis encoded as a uint32 offset from the start of the section.\n" [^Cursor c ^{:tag (* obj/LSym)} target ^bool weak]
  (when (and (!= (.Kind (.-typ c)) types/TINT32) (!= (.Kind (.-typ c)) types/TUINT32))
    (base/Fatalf "can't write SymPtr, it has kind %s" (.Kind (.-typ c))))

  (cond (== target nil)
    (objw/Uint32 (.-lsym c) (conv int (.-offset c)) 0)
    ^{:line 256} weak
    (objw/SymPtrWeakOff (.-lsym c) (conv int (.-offset c)) target) :else

    (objw/SymPtrOff (.-lsym c) (conv int (.-offset c)) target)))




^{:go/end 276} (go/method WriteSlice "WriteSlice writes a slice header to c. The pointer is target+off, the len and cap fields are given.\n" [^Cursor c ^{:tag (* obj/LSym)} target ^int64 off ^int64 len ^int64 cap]
  (when (!= (.Kind (.-typ c)) types/TSLICE)
    (base/Fatalf "can't write slice, it has kind %s" (.Kind (.-typ c))))

  (objw/SymPtr (.-lsym c) (conv int (.-offset c)) target (conv int off))
  (objw/Uintptr (.-lsym c) (+ (conv int (.-offset c)) types/PtrSize) (conv uint64 len))
  (objw/Uintptr (.-lsym c) (+ (conv int (.-offset c)) (* 2 types/PtrSize)) (conv uint64 cap))
  ;; TODO: ability to switch len&cap. Maybe not needed here, as every caller
  ;; passes the same thing for both?
  (when (!= len cap)
    (base/Fatalf "len != cap (%d != %d)" len cap)))





^{:go/end 284} (go/method Reloc "Reloc adds a relocation from the current cursor position.\nReloc fills in Off and Siz fields. Caller should fill in the rest (Type, others).\n" [^Cursor c ^obj/Reloc rel]
  (set! (.-Off rel) (conv int32 (.-offset c)))
  (set! (.-Siz rel) (conv uint8 (.Size (.-typ c))))
  (.AddRel (.-lsym c) base/Ctxt rel))



^{:go/end 298} (go/method Field "Field selects the field with the given name from the struct pointed to by c.\n" ^Cursor [^Cursor c ^string name]
  (when (!= (.Kind (.-typ c)) types/TSTRUCT)
    (base/Fatalf "can't call Field on non-struct %v" (.-typ c)))

  (range [_ f (.Fields (.-typ c))]
    (when (== (.-Name (.-Sym f)) name)
      (return (lit Cursor :lsym (.-lsym c) :offset (+ (.-offset c) (.-Offset f)) :typ (.-Type f)))))


  (base/Fatalf "couldn't find field %s in %v" name (.-typ c))
  (lit Cursor))


^{:go/end 309} (go/method Elem ^Cursor [^Cursor c ^int64 i]
  (when (!= (.Kind (.-typ c)) types/TARRAY)
    (base/Fatalf "can't call Elem on non-array %v" (.-typ c)))

  (when (or (< i 0) (>= i (.NumElem (.-typ c))))
    (base/Fatalf "element access out of bounds [%d] in [0:%d]" i (.NumElem (.-typ c))))

  (let [elem (.Elem (.-typ c))]
    (lit Cursor :lsym (.-lsym c) :offset (+ (.-offset c) (* i (.Size elem))) :typ elem)))



;; A note on line numbers: when working with line numbers, we always use the
;; binary-visible relative line number. i.e., the line number as adjusted by
;; //line directives (ctxt.InnermostPos(ir.Node.Pos()).RelLine()). Use
;; NodeLineOffset to compute line offsets.
;;
;; If you are thinking, "wait, doesn't that just make things more complex than
;; using the real line number?", then you are 100% correct. Unfortunately,
;; pprof profiles generated by the runtime always contain line numbers as
;; adjusted by //line directives (because that is what we put in pclntab). Thus
;; for the best behavior when attempting to match the source with the profile
;; it makes sense to use the same line number space.
;;
;; Some of the effects of this to keep in mind:
;;
;;  - For files without //line directives there is no impact, as RelLine() ==
;;    Line().
;;  - For functions entirely covered by the same //line directive (i.e., a
;;    directive before the function definition and no directives within the
;;    function), there should also be no impact, as line offsets within the
;;    function should be the same as the real line offsets.
;;  - Functions containing //line directives may be impacted. As fake line
;;    numbers need not be monotonic, we may compute negative line offsets. We
;;    should accept these and attempt to use them for best-effort matching, as
;;    these offsets should still match if the source is unchanged, and may
;;    continue to match with changed source depending on the impact of the
;;    changes on fake line numbers.
;;  - Functions containing //line directives may also contain duplicate lines,
;;    making it ambiguous which call the profile is referencing. This is a
;;    similar problem to multiple calls on a single real line, as we don't
;;    currently track column numbers.
;;
;; Long term it would be best to extend pprof profiles to include real line
;; numbers. Until then, we have to live with these complexities. Luckily,
;; //line directives that change line numbers in strange ways should be rare,
;; and failing PGO matching on these files is not too big of a loss.

;; Package pgoir associates a PGO profile with the IR of the current package
;; compilation.
(in-ns 'go.cmd.compile.internal.pgoir) (go/file "irgraph.go" :doc "Package pgoir associates a PGO profile with the IR of the current package\ncompilation.\n" :imports [


    ^{:line 46} [bufio "bufio"]
    ^{:line 47} [base "cmd/compile/internal/base"]
    ^{:line 48} [ir "cmd/compile/internal/ir"]
    ^{:line 49} [typecheck "cmd/compile/internal/typecheck"]
    ^{:line 50} [types "cmd/compile/internal/types"]
    ^{:line 51} [pgo "cmd/internal/pgo"]
    ^{:line 52} [fmt "fmt"]
    ^{:line 53} [maps "maps"]
    ^{:line 54} [os "os"]])












(go/type IRGraph "IRGraph is a call graph with nodes pointing to IRs of functions and edges\ncarrying weights and callsite information.\n\nNodes for indirect calls may have missing IR (IRNode.AST == nil) if the node\nis not visible from this package (e.g., not in the transitive deps). Keeping\nthese nodes allows determining the hottest edge from a call even if that\ncallee is not available.\n\nTODO(prattmic): Consider merging this data structure with Graph. This is\neffectively a copy of Graph aggregated to line number and pointing to IR.\n" (struct


    ^{:line 70 :tag (map string (* IRNode)) :doc "Nodes of the graph. Each node represents a function, keyed by linker\nsymbol name.\n"} IRNodes))



(go/type IRNode "IRNode represents a node (function) in the IRGraph.\n" (struct

    ^{:line 76 :tag (* ir/Func) :doc "Pointer to the IR of the Function represented by this node.\n"} AST


    ^{:line 79 :tag string :doc "Linker symbol name of the Function represented by this node.\nPopulated only if AST == nil.\n"} LinkerSymbolName



    ^{:line 83 :tag (map pgo/NamedCallEdge (* IREdge)) :doc "Set of out-edges in the callgraph. The map uniquely identifies each\nedge based on the callsite and callee, for fast lookup.\n"} OutEdges))



^{:go/end 92} (go/method Name "Name returns the symbol name of this function.\n" ^string [^{:tag (* IRNode)} i]
  (when (!= (.-AST i) nil)
    (return (ir/LinkFuncName (.-AST i))))

  (.-LinkerSymbolName i))




(go/type IREdge "IREdge represents a call edge in the IRGraph with source, destination,\nweight, callsite, and line number information.\n" (struct

    ^{:line 98 :tag (* IRNode) :doc "Source and destination of the edge in IRNode.\n"} Src ^{:tag (* IRNode) :doc "Source and destination of the edge in IRNode.\n"} Dst
    ^{:line 99 :tag int64} Weight
    ^{:line 100 :tag int} CallSiteOffset)) ; Line offset from function start line.



(go/type CallSiteInfo "CallSiteInfo captures call-site information and its caller/callee.\n" (struct
    ^{:line 105 :tag int} LineOffset ; Line offset from function start line.
    ^{:line 106 :tag (* ir/Func)} Caller
    ^{:line 107 :tag (* ir/Func)} Callee))




(go/type Profile "Profile contains the processed PGO profile and weighted call graph used for\nPGO optimizations.\n" (struct

    ^{:doc "Profile is the base data from the raw profile, without IR attribution.\n"} (* pgo/Profile)



    ^{:line 118 :tag (* IRGraph) :doc "WeightedCG represents the IRGraph built from profile, which we will\nupdate as part of inlining.\n"} WeightedCG))



^{:go/end 159} (go/func New "New generates a profile-graph from the profile or pre-processed profile.\n" [^string profileFile] :results [(* Profile) error]
  (let [(values f err) (os/Open profileFile)]
    (when (!= err nil)
      (return nil (fmt/Errorf "error opening profile: %w" err)))

    (defer (.Close f))
    (let [r (bufio/NewReader f)

        (values isSerialized ^:assign err) (pgo/IsSerialized r)]
      (when (!= err nil)
        (return nil (fmt/Errorf "error processing profile header: %w" err)))


      (let [^{:tag (* pgo/Profile)} base (zero (* pgo/Profile))]
        (if isSerialized (do
            (set! (values base err) (pgo/FromSerialized r))
            (when (!= err nil)
              (return nil (fmt/Errorf "error processing serialized PGO profile: %w" err))))

          (do
            (set! (values base err) (pgo/FromPProf r))
            (when (!= err nil)
              (return nil (fmt/Errorf "error processing pprof PGO profile: %w" err)))))



        (when (== (.-TotalWeight base) 0)
          (return nil nil)) ; accept but ignore profile with no samples.


        ;; Create package-level call graph with weights from profile and IR.
        (let [wg (createIRGraph (.-NamedEdgeMap base))]

          ^{:go/breaks [2]} (return (addr ^{:go/breaks [2 4]} (lit Profile
                :Profile base
                :WeightedCG wg))
            nil))))))




^{:go/end 188} (go/func createIRGraph "createIRGraph builds the IRGraph by visiting all the ir.Func in decl list\nof a package.\n" ^{:tag (* IRGraph)} [^pgo/NamedEdgeMap namedEdgeMap]
  (let [g (addr ^{:go/breaks [2]} (lit IRGraph
          :IRNodes (make (map string (* IRNode)))))]


    ;; Bottomup walk over the function to create IRGraph.
    (ir/VisitFuncsBottomUp (.-Funcs typecheck/Target) ^{:go/end 173} (fn [^{:tag (slice (* ir/Func))} list ^bool recursive]
        (range [_ fn list]
          (visitIR fn namedEdgeMap g))))



    ;; Add additional edges for indirect calls. This must be done second so
    ;; that IRNodes is fully populated (see the dummy node TODO in
    ;; addIndirectEdges).
    ;;
    ;; TODO(prattmic): visitIR above populates the graph via direct calls
    ;; discovered via the IR. addIndirectEdges populates the graph via
    ;; calls discovered via the profile. This combination of opposite
    ;; approaches is a bit awkward, particularly because direct calls are
    ;; discoverable via the profile as well. Unify these into a single
    ;; approach.
    (addIndirectEdges g namedEdgeMap)

    ^{:line 187} g))




^{:go/end 204} (go/func visitIR "visitIR traverses the body of each ir.Func adds edges to g from ir.Func to\nany called function in the body.\n" [^{:tag (* ir/Func)} fn ^pgo/NamedEdgeMap namedEdgeMap ^{:tag (* IRGraph)} g]
  (let [name (ir/LinkFuncName fn)
      (values node ok) (aget (.-IRNodes g) name)]
    (when (not ok)
      (set! node (addr ^{:go/breaks [2]} (lit IRNode
            :AST fn)))

      (aset (.-IRNodes g) name node))


    ;; Recursively walk over the body of the function to create IRGraph edges.
    (createIRGraphEdge fn node name namedEdgeMap g)))





^{:go/end 226} (go/func createIRGraphEdge "createIRGraphEdge traverses the nodes in the body of ir.Func and adds edges\nbetween the callernode which points to the ir.Func and the nodes in the\nbody.\n" [^{:tag (* ir/Func)} fn ^{:tag (* IRNode)} callernode ^string name ^pgo/NamedEdgeMap namedEdgeMap ^{:tag (* IRGraph)} g]
  (ir/VisitList (.-Body fn) ^{:go/end 225} (fn [^ir/Node n]
      (switch (.Op n)
        (case [ir/OCALLFUNC]
          (let [call (assert (* ir/CallExpr) n)
              ;; Find the callee function from the call site and add the edge.
              ^{:line 215} callee (DirectCallee (.-Fun call))]
            (when (!= callee nil)
              (addIREdge callernode name n callee namedEdgeMap g))))

        (case [ir/OCALLMETH]
          (let [call (assert (* ir/CallExpr) n)
              ;; Find the callee method from the call site and add the edge.
              ^{:line 222} callee (.-Func (ir/MethodExprName (.-Fun call)))]
            (addIREdge callernode name n callee namedEdgeMap g)))))))





^{:go/end 234} (go/func NodeLineOffset "NodeLineOffset returns the line offset of n in fn.\n" ^int [^ir/Node n ^{:tag (* ir/Func)} fn]
  ;; See "A note on line numbers" at the top of the file.
  (let [line (conv int (.RelLine (.InnermostPos base/Ctxt (.Pos n))))
      ^{:line 232} startLine (conv int (.RelLine (.InnermostPos base/Ctxt ^{:go/via [miniNode]} (.Pos fn))))]
    (- line startLine)))




^{:go/end 266} (go/func addIREdge "addIREdge adds an edge between caller and new node that points to `callee`\nbased on the profile-graph and NodeMap.\n" [^{:tag (* IRNode)} callerNode ^string callerName ^ir/Node call ^{:tag (* ir/Func)} callee ^pgo/NamedEdgeMap namedEdgeMap ^{:tag (* IRGraph)} g]
  (let [calleeName (ir/LinkFuncName callee)
      (values calleeNode ok) (aget (.-IRNodes g) calleeName)]
    (when (not ok)
      (set! calleeNode (addr ^{:go/breaks [2]} (lit IRNode
            :AST callee)))

      (aset (.-IRNodes g) calleeName calleeNode))


    (let [namedEdge ^{:go/breaks [2 4 6]} (lit pgo/NamedCallEdge
          :CallerName callerName
          :CalleeName calleeName
          :CallSiteOffset (NodeLineOffset call (.-AST callerNode)))


        ;; Add edge in the IRGraph from caller to callee.
        ^{:line 255} edge (addr ^{:go/breaks [2 4 6 8]} (lit IREdge
            :Src callerNode
            :Dst calleeNode
            :Weight (aget (.-Weight namedEdgeMap) namedEdge)
            :CallSiteOffset (.-CallSiteOffset namedEdge)))]


      (when (== (.-OutEdges callerNode) nil)
        (set! (.-OutEdges callerNode) (make (map pgo/NamedCallEdge (* IREdge)))))

      (aset (.-OutEdges callerNode) namedEdge edge))))




(go/var ^{:doc "LookupFunc looks up a function or method in export data. It is expected to\nbe overridden by package noder, to break a dependency cycle.\n"} LookupFunc ^{:go/end 273} (fn [^string fullName] :results [(* ir/Func) error]
    (base/Fatalf "pgoir.LookupMethodFunc not overridden")
    (panic "unreachable")))






(go/var ^{:doc "PostLookupCleanup performs any remaining cleanup operations needed\nafter a series of calls to LookupFunc, specifically reading in the\nbodies of functions that may have been delayed due being encountered\nin a stage where the reader's curfn state was not set up.\n"} PostLookupCleanup ^{:go/end 282} (fn []
    (base/Fatalf "pgoir.PostLookupCleanup not overridden")
    (panic "unreachable")))













^{:go/end 398} (go/func addIndirectEdges "addIndirectEdges adds indirect call edges found in the profile to the graph,\nto be used for devirtualization.\n\nN.B. despite the name, addIndirectEdges will add any edges discovered via\nthe profile. We don't know for sure that they are indirect, but assume they\nare since direct calls would already be added. (e.g., direct calls that have\nbeen deleted from source since the profile was taken would be added here).\n\nTODO(prattmic): Devirtualization runs before inlining, so we can't devirtualize\ncalls inside inlined call bodies. If we did add that, we'd need edges from\ninlined bodies as well.\n" [^{:tag (* IRGraph)} g ^pgo/NamedEdgeMap namedEdgeMap]
  ;; g.IRNodes is populated with the set of functions in the local
  ;; package build by VisitIR. We want to filter for local functions
  ;; below, but we also add unknown callees to IRNodes as we go. So make
  ;; an initial copy of IRNodes to recall just the local functions.
  (let [localNodes (^{:inst [(map string (* IRNode)) string (* IRNode)]} maps/Clone (.-IRNodes g))]

    ;; N.B. We must consider edges in a stable order because export data
    ;; lookup order (LookupMethodFunc, below) can impact the export data of
    ;; this package, which must be stable across different invocations for
    ;; reproducibility.
    ;;
    ;; The weight ordering of ByWeight is irrelevant, it just happens to be
    ;; an ordered list of edges that is already available.
    (range [_ key (.-ByWeight namedEdgeMap)]
      (let [weight (aget (.-Weight namedEdgeMap) key)
          ;; All callers in the local package build were added to IRNodes
          ;; in VisitIR. If a caller isn't in the local package build we
          ;; can skip adding edges, since we won't be devirtualizing in
          ;; them anyway. This keeps the graph smaller.
          (values callerNode ok) (aget localNodes (.-CallerName key))]
        (when (not ok)
          (continue))


        ;; Already handled this edge?
        (when [(values _ ok) (aget (.-OutEdges callerNode) key)] ok
          (continue))


        (let [(values calleeNode ^:assign ok) (aget (.-IRNodes g) (.-CalleeName key))]
          (when (not ok)
            ;; IR is missing for this callee. VisitIR populates
            ;; IRNodes with all functions discovered via local
            ;; package function declarations and calls. This
            ;; function may still be available from export data of
            ;; a transitive dependency.
            ;;
            ;; TODO(prattmic): Parameterized types/functions are
            ;; not supported.
            ;;
            ;; TODO(prattmic): This eager lookup during graph load
            ;; is simple, but wasteful. We are likely to load many
            ;; functions that we never need. We could delay load
            ;; until we actually need the method in
            ;; devirtualization. Instantiation of generic functions
            ;; will likely need to be done at the devirtualization
            ;; site, if at all.
            (when (>= (.-PGODebug base/Debug) 3)
              (fmt/Printf "addIndirectEdges: %s attempting export data lookup\n" (.-CalleeName key)))

            (let [(values fn err) (LookupFunc (.-CalleeName key))]
              (if (== err nil) (do
                  (when (>= (.-PGODebug base/Debug) 3)
                    (fmt/Printf "addIndirectEdges: %s found in export data\n" (.-CalleeName key)))

                  (set! calleeNode (addr (lit IRNode :AST fn))))

                ;; N.B. we could call createIRGraphEdge to add
                ;; direct calls in this newly-imported
                ;; function's body to the graph. Similarly, we
                ;; could add to this function's queue to add
                ;; indirect calls. However, those would be
                ;; useless given the visit order of inlining,
                ;; and the ordering of PGO devirtualization and
                ;; inlining. This function can only be used as
                ;; an inlined body. We will never do PGO
                ;; devirtualization inside an inlined call. Nor
                ;; will we perform inlining inside an inlined
                ;; call.
                (do
                  ;; Still not found. Most likely this is because
                  ;; the callee isn't in the transitive deps of
                  ;; this package.
                  ;;
                  ;; Record this call anyway. If this is the hottest,
                  ;; then we want to skip devirtualization rather than
                  ;; devirtualizing to the second most common callee.
                  (when (>= (.-PGODebug base/Debug) 3)
                    (fmt/Printf "addIndirectEdges: %s not found in export data: %v\n" (.-CalleeName key) err))

                  (set! calleeNode (addr (lit IRNode :LinkerSymbolName (.-CalleeName key))))))


              ;; Add dummy node back to IRNodes. We don't need this
              ;; directly, but PrintWeightedCallGraphDOT uses these
              ;; to print nodes.
              (aset (.-IRNodes g) (.-CalleeName key) calleeNode)))

          (let [edge (addr ^{:go/breaks [2 4 6 8]} (lit IREdge
                  :Src callerNode
                  :Dst calleeNode
                  :Weight weight
                  :CallSiteOffset (.-CallSiteOffset key)))]


            (when (== (.-OutEdges callerNode) nil)
              (set! (.-OutEdges callerNode) (make (map pgo/NamedCallEdge (* IREdge)))))

            (aset (.-OutEdges callerNode) key edge)))))


    (PostLookupCleanup)))



^{:go/end 473} (go/method PrintWeightedCallGraphDOT "PrintWeightedCallGraphDOT prints IRGraph in DOT format.\n" [^{:tag (* Profile)} p ^float64 edgeThreshold]
  (fmt/Printf "\ndigraph G {\n")
  (fmt/Printf "forcelabels=true;\n")

  ;; List of functions in this package.
  (let [funcs (make (map string (struct)))]
    (ir/VisitFuncsBottomUp (.-Funcs typecheck/Target) ^{:go/end 412} (fn [^{:tag (slice (* ir/Func))} list ^bool recursive]
        (range [_ f list]
          (let [name (ir/LinkFuncName f)]
            (aset funcs name (lit (struct)))))))



    ;; Determine nodes of DOT.
    ;;
    ;; Note that ir.Func may be nil for functions not visible from this
    ;; package.
    (let [nodes (make (map string (* ir/Func)))]
      (range [name funcs]
        (when [(values n ok) (aget (.-IRNodes (.-WeightedCG p)) name)] ok
          (range [_ e (.-OutEdges n)]
            (when [(values _ ok) (aget nodes (.Name (.-Src e)))] (not ok)
              (aset nodes (.Name (.-Src e)) (.-AST (.-Src e))))

            (when [(values _ ok) (aget nodes (.Name (.-Dst e)))] (not ok)
              (aset nodes (.Name (.-Dst e)) (.-AST (.-Dst e)))))


          (when [(values _ ok) (aget nodes (.Name n))] (not ok)
            (aset nodes (.Name n) (.-AST n)))))




      ;; Print nodes.
      (range [name ast nodes]
        (when [(values _ ok) (aget (.-IRNodes (.-WeightedCG p)) name)] ok
          (let [style "solid"]
            (when (== ast nil)
              (set! style "dashed"))


            (if (and (!= ast nil) (!= (.-Inl ast) nil))
              (fmt/Printf "\"%v\" [color=black, style=%s, label=\"%v,inl_cost=%d\"];\n" name style name (.-Cost (.-Inl ast)))

              (fmt/Printf "\"%v\" [color=black, style=%s, label=\"%v\"];\n" name style name)))))



      ;; Print edges.
      (ir/VisitFuncsBottomUp (.-Funcs typecheck/Target) ^{:go/end 471} (fn [^{:tag (slice (* ir/Func))} list ^bool recursive]
          (range [_ f list]
            (let [name (ir/LinkFuncName f)]
              (when [(values n ok) (aget (.-IRNodes (.-WeightedCG p)) name)] ok
                (range [_ e (.-OutEdges n)]
                  (let [style "solid"]
                    (when (== (.-AST (.-Dst e)) nil)
                      (set! style "dashed"))

                    (let [color "black"
                        ^{:line 461} edgepercent (pgo/WeightInPercentage (.-Weight e) ^{:go/via [Profile]} (.-TotalWeight p))]
                      (when (> edgepercent edgeThreshold)
                        (set! color "red"))


                      (fmt/Printf "edge [color=%s, style=%s];\n" color style)
                      (fmt/Printf "\"%v\" -> \"%v\" [label=\"%.2f\"];\n" (.Name n) (.Name (.-Dst e)) edgepercent)))))))))




      (fmt/Printf "}\n"))))






^{:go/breaks [[6 502]] :go/end 503} (go/func DirectCallee "DirectCallee takes a function-typed expression and returns the underlying\nfunction that it refers to if statically known. Otherwise, it returns nil.\n\nEquivalent to inline.inlCallee without calling CanInline on closures.\n" ^{:tag (* ir/Func)} [^ir/Node fn]
  (set! fn (ir/StaticValue fn))
  (switch (.Op fn)
    (case [ir/OMETHEXPR]
      (let [fn (assert (* ir/SelectorExpr) fn)
          ^{:line 484} n (ir/MethodExprName fn)]
        ;; Check that receiver type matches fn.X.
        ;; TODO(mdempsky): Handle implicit dereference
        ;; of pointer receiver argument?
        (when (or (== n nil) (not (types/Identical (.-Type (.Recv ^{:go/via [miniExpr]} (.Type n))) (.Type (.-X fn)))))
          (return nil))

        (return (.-Func n))))
    (case [ir/ONAME]
      (let [fn (assert (* ir/Name) fn)]
        (when (== (.-Class fn) ir/PFUNC)
          (return (.-Func fn)))))

    (case [ir/OCLOSURE]
      (let [fn (assert (* ir/ClosureExpr) fn)
          ^{:line 499} c (.-Func fn)]
        (return c))))

  nil)

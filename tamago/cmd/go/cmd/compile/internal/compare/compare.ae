  (return (- (.End (.Field t (- next 1))) (.-Offset (.Field t start))) next))




^{:go/end 79} (go/func EqCanPanic "EqCanPanic reports whether == on type t could panic (has an interface somewhere).\nt must be comparable.\n" ^bool [^{:tag (* types/Type)} t]

(in-ns 'go.cmd.compile.internal.types2) (go/file "tuple.go" :imports [])




(go/type Tuple "A Tuple represents an ordered list of variables; a nil *Tuple is a valid (empty) tuple.\nTuples are used as components of signatures and to represent the type of multiple\nassignments; they are not first class types of Go.\n" (struct
    ^{:line 11 :tag (slice (* Var))} vars))



^{:go/breaks [[5 19]] :go/end 20} (go/func NewTuple "NewTuple returns a new tuple for the given variables.\n" ^{:tag (* Tuple)} [& ^{:tag (slice (* Var))} x]
  (when (> (len x) 0)
    (return (addr (lit Tuple :vars x))))

  nil)



^{:go/breaks [[5 27]] :go/end 28} (go/method Len "Len returns the number variables of tuple t.\n" ^int [^{:tag (* Tuple)} t]
  (when (!= t nil)
    (return (len (.-vars t))))

  0)



^{:go/end 31} (go/method At "At returns the i'th variable of tuple t.\n" ^{:tag (* Var)} [^{:tag (* Tuple)} t ^int i] (aget (.-vars t) i))

^{:go/end 33} (go/method Underlying ^Type [^{:tag (* Tuple)} t] t)
^{:go/end 34} (go/method String ^string [^{:tag (* Tuple)} t] (TypeString t nil))

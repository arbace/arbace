(in-ns 'go.cmd.compile.internal.types2) (go/file "gcsizes.go" :imports [])

(go/type gcSizes (struct
    ^{:line 8 :tag int64} WordSize ; word size in bytes - must be >= 4 (32bits)
    ^{:line 9 :tag int64} MaxAlign)) ; maximum alignment in bytes - must be >= 1


^{:go/end 74} (go/method Alignof [^{:tag (* gcSizes)} s ^Type T] :results [^int64 result]
  (defer (^{:go/end 15} (fn []
        (go/call assert (>= result 1)))))


  ;; For arrays and structs, alignment is defined in terms
  ;; of alignment of the elements and fields, respectively.
  (type-switch [t (.Underlying T)]
    (case [(* Array)]
      ;; spec: "For a variable x of array type: unsafe.Alignof(x)
      ;; is the same as unsafe.Alignof(x[0]), but at least 1."
      (return (.Alignof s (.-elem t))))
    (case [(* Struct)]
      (when (and (== (len (.-fields t)) 0) (IsSyncAtomicAlign64 T))
        ;; Special case: sync/atomic.align64 is an
        ;; empty struct we recognize as a signal that
        ;; the struct it contains must be
        ;; 64-bit-aligned.
        ;;
        ;; This logic is equivalent to the logic in
        ;; cmd/compile/internal/types/size.go:calcStructOffset
        (return 8))


      ;; spec: "For a variable x of struct type: unsafe.Alignof(x)
      ;; is the largest of the values unsafe.Alignof(x.f) for each
      ;; field f of x, but at least 1."
      (let [max (conv int64 1)]
        (range [_ f (.-fields t)]
          (when [a (.Alignof s ^{:go/via [object]} (.-typ f))] (> a max)
            (set! max a)))


        (return max)))
    (case [(* Slice) (* Interface)]
      ;; Multiword data structures are effectively structs
      ;; in which each element has size WordSize.
      ;; Type parameters lead to variable sizes/alignments;
      ;; StdSizes.Alignof won't be called for them.
      (go/call assert (not (isTypeParam T)))
      (return (.-WordSize s)))
    (case [(* Basic)]
      ;; Strings are like slices and interfaces.
      (when (!= (bit-and (.Info t) IsString) 0)
        (return (.-WordSize s))))

    (case [(* TypeParam) (* Union)]
      (panic "unreachable")))

  (let [a (.Sizeof s T)] ; may be 0 or negative
    ;; spec: "For a variable x of any type: unsafe.Alignof(x) is at least 1."
    (when (< a 1)
      (return 1))

    ;; complex{64,128} are aligned like [2]float{32,64}.
    (when (isComplex T)
      (set! a / 2))

    (when (> a (.-MaxAlign s))
      (return (.-MaxAlign s)))

    ^{:line 73} a))


^{:go/end 96} (go/method Offsetsof ^{:tag (slice int64)} [^{:tag (* gcSizes)} s ^{:tag (slice (* Var))} fields]
  (let [offsets (make (slice int64) (len fields))
      ^{:line 78 :tag int64} offs (zero int64)]
    (range [i f fields]
      (when (< offs 0)
        ;; all remaining offsets are too large
        (aset offsets i -1)
        (continue))

      ;; offs >= 0
      (let [a (.Alignof s ^{:go/via [object]} (.-typ f))]
        (set! offs (align offs a)) ; possibly < 0 if align overflows
        (aset offsets i offs)
        (if [d (.Sizeof s ^{:go/via [object]} (.-typ f))] (and (>= d 0) (>= offs 0))
          (set! offs + d) ; ok to overflow to < 0

          (set! offs -1)))) ; f.typ or offs is too large


    ^{:line 95} offsets))


^{:go/end 160} (go/method Sizeof ^int64 [^{:tag (* gcSizes)} s ^Type T]
  (type-switch [t (.Underlying T)]
    (case [(* Basic)]
      (go/call assert (isTyped T))
      (let [k (.-kind t)]
        (when (< (conv int k) (len basicSizes))
          (when [s (aget basicSizes k)] (> s 0)
            (return (conv int64 s))))


        (when (== k String)
          (return (* (.-WordSize s) 2)))))

    (case [(* Array)]
      (let [n (.-len t)]
        (when (<= n 0)
          (return 0))

        ;; n > 0
        (let [esize (.Sizeof s (.-elem t))]
          (when (< esize 0)
            (return -1)) ; element too large

          (when (== esize 0)
            (return 0)) ; 0-size element

          ;; esize > 0
          ;; Final size is esize * n; and size must be <= maxInt64.
          (let [^:const ^{:val 9223372036854775807} maxInt64 (- (<< 1 63) 1)]
            (when (> esize (/ maxInt64 n))
              (return -1)) ; esize * n overflows

            (return (* esize n))))))
    (case [(* Slice)]
      (return (* (.-WordSize s) 3)))
    (case [(* Struct)]
      (let [n (.NumFields t)]
        (when (== n 0)
          (return 0))

        (let [offsets (.Offsetsof s (.-fields t))
            ^{:line 139} offs (aget offsets (- n 1))
            ^{:line 140} size (.Sizeof s ^{:go/via [object]} (.-typ (aget (.-fields t) (- n 1))))]
          (when (or (< offs 0) (< size 0))
            (return -1)) ; type too large

          ;; gc: The last field of a non-zero-sized struct is not allowed to
          ;; have size 0.
          (when (and (> offs 0) (== size 0))
            (set! size 1))

          ;; gc: Size includes alignment padding.
          (return (align (+ offs size) (.Alignof s t)))))) ; may overflow to < 0 which is ok
    (case [(* Interface)]
      ;; Type parameters lead to variable sizes/alignments;
      ;; StdSizes.Sizeof won't be called for them.
      (go/call assert (not (isTypeParam T)))
      (return (* (.-WordSize s) 2)))
    (case [(* TypeParam) (* Union)]
      (panic "unreachable")))

  (.-WordSize s)) ; catch-all





^{:go/end 170} (go/func gcSizesFor "gcSizesFor returns the Sizes used by gc for an architecture.\nThe result is a nil *gcSizes pointer (which is not a valid types.Sizes)\nif a compiler/architecture pair is not known.\n" ^{:tag (* gcSizes)} [^string compiler ^string arch]
  (when (!= compiler "gc")
    (return nil))

  (aget gcArchSizes arch))

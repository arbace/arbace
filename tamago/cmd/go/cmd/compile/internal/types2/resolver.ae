  ;; add new methods to already type-checked types (from a prior Checker.Files call)
  (range [_ obj (.-objList check)]
    (when [(values obj _) (assert (* TypeName) obj)] (and (!= obj nil) (!= ^{:go/via [object]} (.-typ obj) nil))
      (.collectMethods check obj)))



  (if false

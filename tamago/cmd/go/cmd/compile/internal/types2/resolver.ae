    ;; the time the unified export data is written out,
    ;; its Type is Invalid.
    ;;
    ;; Investigate and reenable this branch.
    (range [_ obj (.-objList check)]
      (.objDecl check obj))


    ;; To avoid problems with cycles, process non-alias type declarations first, followed by
    ;; alias declarations, and then everything else. This appears to avoid most situations
    ;; where the type of an alias is needed before it is available.
    ;; There may still be cases where this is not good enough (see also go.dev/issue/25838).
    ;; In those cases Checker.ident will report an error ("invalid use of type alias").
    (let [^{:tag (slice (* TypeName))} aliasList (zero (slice (* TypeName)))
        ^{:line 680 :tag (slice Object)} othersList (zero (slice Object))] ; everything that's not a type
      ;; phase 1: non-alias type declarations
      (range [_ obj (.-objList check)]
        (if [(values tname _) (assert (* TypeName) obj)] (!= tname nil)
          (if (.-Alias (.-tdecl (aget (.-objMap check) tname)))
            (set! aliasList (append aliasList tname))

            (.objDecl check obj))


          (set! othersList (append othersList obj))))


      ;; phase 2: alias type declarations
      (range [_ obj aliasList]
        (.objDecl check obj))

      ;; phase 3: all other declarations
      (range [_ obj othersList]
        (.objDecl check obj))))



  ;; At this point we may have a non-empty check.methods map; this means that not all
  ;; entries were deleted at the end of typeDecl because the respective receiver base

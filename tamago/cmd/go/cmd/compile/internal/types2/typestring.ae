;; This file implements printing of types.

(in-ns 'go.cmd.compile.internal.types2) (go/file "typestring.go" :imports [


    ^{:line 10} [bytes "bytes"]
    ^{:line 11} [fmt "fmt"]
    ^{:line 12} [slices "slices"]
    ^{:line 13} [strconv "strconv"]
    ^{:line 14} [strings "strings"]
    ^{:line 15} [utf8 "unicode/utf8"]])












(go/type Qualifier "A Qualifier controls how named package-level objects are printed in\ncalls to [TypeString], [ObjectString], and [SelectionString].\n\nThese three formatting routines call the Qualifier for each\npackage-level object O, and if the Qualifier returns a non-empty\nstring p, the object is printed in the form p.O.\nIf it returns an empty string, only the object name O is printed.\n\nUsing a nil Qualifier is equivalent to using (*[Package]).Path: the\nobject is qualified by the import path, e.g., \"encoding/json.Marshal\".\n" (func [(* Package)] [string]))



^{:go/end 42} (go/func RelativeTo "RelativeTo returns a [Qualifier] that fully qualifies members of\nall packages other than pkg.\n" ^Qualifier [^{:tag (* Package)} pkg]
  (when (== pkg nil)
    (return nil))

  ^{:go/end 41} (fn ^string [^{:tag (* Package)} other]
    (when (== pkg other)
      (return "")) ; same package; unqualified

    (.Path other)))






^{:go/end 51} (go/func TypeString "TypeString returns the string representation of typ.\nThe [Qualifier] controls the printing of\npackage-level objects, and may be nil.\n" ^string [^Type typ ^Qualifier qf]
  (let [^bytes/Buffer buf (zero bytes/Buffer)]
    (WriteType (addr buf) typ qf)
    (.String buf)))





^{:go/end 58} (go/func WriteType "WriteType writes the string representation of typ to buf.\nThe [Qualifier] controls the printing of\npackage-level objects, and may be nil.\n" [^{:tag (* bytes/Buffer)} buf ^Type typ ^Qualifier qf]
  (.typ (newTypeWriter buf qf) typ))





^{:go/end 65} (go/func WriteSignature "WriteSignature writes the representation of the signature sig to buf,\nwithout a leading \"func\" keyword. The [Qualifier] controls the printing\nof package-level objects, and may be nil.\n" [^{:tag (* bytes/Buffer)} buf ^{:tag (* Signature)} sig ^Qualifier qf]
  (.signature (newTypeWriter buf qf) sig))


(go/type typeWriter (struct
    ^{:line 68 :tag (* bytes/Buffer)} buf
    ^{:line 69 :tag (map Type bool)} seen
    ^{:line 70 :tag Qualifier} qf
    ^{:line 71 :tag (* Context)} ctxt ; if non-nil, we are type hashing
    ^{:line 72 :tag (* TypeParamList)} tparams ; local type parameters
    ^{:line 73 :tag bool} paramNames ; if set, write function parameter names, otherwise, write types only
    ^{:line 74 :tag bool} tpSubscripts ; if set, write type parameter indices as subscripts
    ^{:line 75 :tag bool} pkgInfo)) ; package-annotate first unexported-type field to avoid confusing type description


^{:go/end 80} (go/func newTypeWriter ^{:tag (* typeWriter)} [^{:tag (* bytes/Buffer)} buf ^Qualifier qf]
  (addr (lit typeWriter buf (make (map Type bool)) qf nil nil true false false)))


^{:go/end 85} (go/func newTypeHasher ^{:tag (* typeWriter)} [^{:tag (* bytes/Buffer)} buf ^{:tag (* Context)} ctxt]
  (go/call assert (!= ctxt nil))
  (addr (lit typeWriter buf (make (map Type bool)) nil ctxt nil false false false)))


^{:go/end 99} (go/method byte [^{:tag (* typeWriter)} w ^byte b]
  (when (!= (.-ctxt w) nil)
    (when (== b \space)
      (set! b \#))

    (.WriteByte (.-buf w) b)
    (return))

  (.WriteByte (.-buf w) b)
  (when (or (== b \,) (== b \;))
    (.WriteByte (.-buf w) \space)))



^{:go/end 103} (go/method string [^{:tag (* typeWriter)} w ^string s]
  (.WriteString (.-buf w) s))


^{:go/end 110} (go/method error [^{:tag (* typeWriter)} w ^string msg]
  (when (!= (.-ctxt w) nil)
    (panic msg))

  (.WriteString (.-buf w) (+ "<" msg ">")))


^{:go/end 351} (go/method typ [^{:tag (* typeWriter)} w ^Type typ]
  (when (aget (.-seen w) typ)
    (.error w (+ "cycle to " (goTypeName typ)))
    (return))

  (aset (.-seen w) typ true)
  (defer (delete (.-seen w) typ))

  (type-switch [t typ]
    (case [nil]
      (.error w "nil"))

    (case [(* Basic)]
      ;; exported basic types go into package unsafe
      ;; (currently this is just unsafe.Pointer)
      (when (isExported (.-name t))
        (when [(values obj _) (assert (* TypeName) (.Lookup (.-scope Unsafe) (.-name t)))] (!= obj nil)
          (.typeName w obj)
          (break)))


      (.string w (.-name t)))

    (case [(* Array)]
      (.byte w \[)
      (.string w (strconv/FormatInt (.-len t) 10))
      (.byte w \])
      (.typ w (.-elem t)))

    (case [(* Slice)]
      (.string w "[]")
      (.typ w (.-elem t)))

    (case [(* Struct)]
      (.string w "struct{")
      (range [i f (.-fields t)]
        (when (> i 0)
          (.byte w \;))


        ;; If disambiguating one struct for another, look for the first unexported field.
        ;; Do this first in case of nested structs; tag the first-outermost field.
        (let [pkgAnnotate false]
          (when (and (== (.-qf w) nil) (.-pkgInfo w) (not (isExported ^{:go/via [object]} (.-name f))))
            ;; note for embedded types, type name is field name, and "string" etc are lower case hence unexported.
            (set! pkgAnnotate true)
            (set! (.-pkgInfo w) false)) ; only tag once


          ;; This doesn't do the right thing for embedded type
          ;; aliases where we should print the alias name, not
          ;; the aliased type (see go.dev/issue/44410).
          (when (not (.-embedded f))
            (.string w ^{:go/via [object]} (.-name f))
            (.byte w \space))

          (.typ w ^{:go/via [object]} (.-typ f))
          (when pkgAnnotate
            (.string w " /* package ")
            (.string w (.Path ^{:go/via [object]} (.-pkg f)))
            (.string w " */ "))

          (when [tag (.Tag t i)] (!= tag "")
            (.byte w \space)
            ;; TODO(gri) If tag contains blanks, replacing them with '#'
            ;;           in Context.TypeHash may produce another tag
            ;;           accidentally.
            (.string w (strconv/Quote tag)))))


      (.byte w \}))

    (case [(* Pointer)]
      (.byte w \*)
      (.typ w (.-base t)))

    (case [(* Tuple)]
      (.tuple w t false))

    (case [(* Signature)]
      (.string w "func")
      (.signature w t))

    (case [(* Union)]
      ;; Unions only appear as (syntactic) embedded elements
      ;; in interfaces and syntactically cannot be empty.
      (when (== (.Len t) 0)
        (.error w "empty union")
        (break))

      (range [i t (.-terms t)]
        (when (> i 0)
          (.string w termSep))

        (when (.-tilde t)
          (.byte w \~))

        (.typ w (.-typ t))))


    (case [(* Interface)]
      (when (== (.-ctxt w) nil)
        (when (== t (.-underlying (asNamed (.Type universeComparable))))
          (.string w "interface{comparable}")
          (break)))


      (when (.-implicit t)
        (when (and (== (len (.-methods t)) 0) (== (len (.-embeddeds t)) 1))
          (.typ w (aget (.-embeddeds t) 0))
          (break))

        ;; Something's wrong with the implicit interface.
        ;; Print it as such and continue.
        (.string w "/* implicit */ "))

      (.string w "interface{")
      (let [first true]
        (if (!= (.-ctxt w) nil)
          (.typeSet w (.typeSet t))
          (do
            (range [_ m (.-methods t)]
              (when (not first)
                (.byte w \;))

              (set! first false)
              (.string w ^{:go/via [object]} (.-name m))
              (.signature w (assert (* Signature) ^{:go/via [object]} (.-typ m))))

            (range [_ typ (.-embeddeds t)]
              (when (not first)
                (.byte w \;))

              (set! first false)
              (.typ w typ))))


        (.byte w \})))

    (case [(* Map)]
      (.string w "map[")
      (.typ w (.-key t))
      (.byte w \])
      (.typ w (.-elem t)))

    (case [(* Chan)]
      (let [^string s (zero string)
          ^{:line 259 :tag bool} parens (zero bool)]
        (switch (.-dir t)
          (case [SendRecv]
            (set! s "chan ")
            ;; chan (<-chan T) requires parentheses
            (when [(values c _) (assert (* Chan) (.-elem t))] (and (!= c nil) (== (.-dir c) RecvOnly))
              (set! parens true)))

          (case [SendOnly]
            (set! s "chan<- "))
          (case [RecvOnly]
            (set! s "<-chan "))
          (default
            (.error w "unknown channel direction")))

        (.string w s)
        (when parens
          (.byte w \())

        (.typ w (.-elem t))
        (when parens
          (.byte w \)))))


    (case [(* Named)]
      ;; If hashing, write a unique prefix for t to represent its identity, since
      ;; named type identity is pointer identity.
      (when (!= (.-ctxt w) nil)
        (.string w (strconv/Itoa (.getID (.-ctxt w) t))))

      (.typeName w (.-obj t)) ; when hashing written for readability of the hash only
      (cond (!= (.-inst t) nil)
        ;; instantiated type
        (.typeList w (.list (.-targs (.-inst t))))
        (and (== (.-ctxt w) nil) (!= (.Len (.TypeParams t)) 0)) ; For type hashing, don't need to format the TypeParams
        ;; parameterized type
        (.tParamList w (.list (.TypeParams t)))))


    (case [(* TypeParam)]
      (when (== (.-obj t) nil)
        (.error w "unnamed type parameter")
        (break))

      (if [i (^{:inst [(slice (* TypeParam)) (* TypeParam)]} slices/Index (.list (.-tparams w)) t)] (>= i 0)
        ;; The names of type parameters that are declared by the type being
        ;; hashed are not part of the type identity. Replace them with a
        ;; placeholder indicating their index.
        (.string w (fmt/Sprintf "$%d" i))
        (do
          (.string w ^{:go/via [object]} (.-name (.-obj t)))
          (when (or (.-tpSubscripts w) (!= (.-ctxt w) nil))
            (.string w (subscript (.-id t))))

          ;; If the type parameter name is the same as a predeclared object
          ;; (say int), point out where it is declared to avoid confusing
          ;; error messages. This doesn't need to be super-elegant; we just
          ;; need a clear indication that this is not a predeclared name.
          (when (and (== (.-ctxt w) nil) (!= (.Lookup Universe ^{:go/via [object]} (.-name (.-obj t))) nil))
            (if isTypes2
              (.string w (fmt/Sprintf " /* with %s declared at %v */" ^{:go/via [object]} (.-name (.-obj t)) ^{:go/via [object]} (.Pos (.-obj t))))

              ;; Can't print position information because
              ;; we don't have a token.FileSet accessible.
              (.string w "/* type parameter */"))))))




    (case [(* Alias)]
      (.typeName w (.-obj t))
      (if [list (.list (.-targs t))] (!= (len list) 0)
        ;; instantiated type
        (.typeList w list)
        (when (and (== (.-ctxt w) nil) (!= (.Len (.TypeParams t)) 0)) ; For type hashing, don't need to format the TypeParams
          ;; parameterized type
          (.tParamList w (.list (.TypeParams t)))))

      (when (!= (.-ctxt w) nil)
        ;; TODO(gri) do we need to print the alias type name, too?
        (let [typ (Unalias ^{:go/via [object]} (.-typ (.-obj t)))]
          (when (== typ nil)
            (panic "known implementation limitation: encountered an incomplete alias (see go.dev/issue/78296)"))

          (.typ w typ))))


    (default
      ;; For externally defined implementations of Type.
      ;; Note: In this case cycles won't be caught.
      (.string w (.String t)))))




^{:go/end 387} (go/method typeSet "typeSet writes a canonical hash for an interface type set.\n" [^{:tag (* typeWriter)} w ^{:tag (* _TypeSet)} s]
  (go/call assert (!= (.-ctxt w) nil))
  (let [first true]
    (range [_ m (.-methods s)]
      (when (not first)
        (.byte w \;))

      (set! first false)
      (.string w ^{:go/via [object]} (.-name m))
      (.signature w (assert (* Signature) ^{:go/via [object]} (.-typ m))))

    (switch
      (case [(.isAll (.-terms s))])
      ;; nothing to do
      (case [(.isEmpty (.-terms s))]
        (.string w (.String (.-terms s))))
      (default
        (let [^{:tag (slice string)} termHashes (zero (slice string))]
          (range [_ term (.-terms s)]
            ;; terms are not canonically sorted, so we sort their hashes instead.
            (let [^bytes/Buffer buf (zero bytes/Buffer)]
              (when (.-tilde term)
                (.WriteByte buf \~))

              (.typ (newTypeHasher (addr buf) (.-ctxt w)) (.-typ term))
              (set! termHashes (append termHashes (.String buf)))))

          (^{:inst [(slice string) string]} slices/Sort termHashes)
          (when (not first)
            (.byte w \;))

          (.string w (strings/Join termHashes "|")))))))



^{:go/end 398} (go/method typeList [^{:tag (* typeWriter)} w ^{:tag (slice Type)} list]
  (.byte w \[)
  (range [i typ list]
    (when (> i 0)
      (.byte w \,))

    (.typ w typ))

  (.byte w \]))


^{:go/end 427} (go/method tParamList [^{:tag (* typeWriter)} w ^{:tag (slice (* TypeParam))} list]
  (.byte w \[)
  (let [^Type prev (zero Type)]
    (range [i tpar list]
      ;; Determine the type parameter and its constraint.
      ;; list is expected to hold type parameter names,
      ;; but don't crash if that's not the case.
      (when (== tpar nil)
        (.error w "nil type parameter")
        (continue))

      (when (> i 0)
        (when (!= (.-bound tpar) prev)
          ;; bound changed - write previous one before advancing
          (.byte w \space)
          (.typ w prev))

        (.byte w \,))

      (set! prev (.-bound tpar))
      (.typ w tpar))

    (when (!= prev nil)
      (.byte w \space)
      (.typ w prev))

    (.byte w \])))


^{:go/end 432} (go/method typeName [^{:tag (* typeWriter)} w ^{:tag (* TypeName)} obj]
  (.string w (packagePrefix ^{:go/via [object]} (.-pkg obj) (.-qf w)))
  (.string w ^{:go/via [object]} (.-name obj)))


^{:go/end 470} (go/method tuple [^{:tag (* typeWriter)} w ^{:tag (* Tuple)} tup ^bool variadic]
  (.byte w \()
  (when (!= tup nil)
    (range [i v (.-vars tup)]
      (when (> i 0)
        (.byte w \,))

      ;; parameter names are ignored for type identity and thus type hashes
      (when (and (== (.-ctxt w) nil) (!= ^{:go/via [object]} (.-name v) "") (.-paramNames w))
        (.string w ^{:go/via [object]} (.-name v))
        (.byte w \space))

      (let [typ ^{:go/via [object]} (.-typ v)]
        (if (and variadic (== i (- (len (.-vars tup)) 1)))
          (if [(values slice ok) (assert (* Slice) typ)] ok (do
              (.string w "...")
              (.typ w (.-elem slice)))
            (do
              ;; append(slice, str...) entails various special
              ;; cases, especially in conjunction with generics.
              ;; str may be:
              ;; - a string,
              ;; - a TypeParam whose typeset includes string, or
              ;; - a named []byte slice type B resulting from
              ;;   a client instantiating append([]byte, T) at T=B.
              ;; For such cases we use the irregular notation
              ;; func([]byte, T...), with the dots after the type.
              (.typ w typ)
              (.string w "...")))


          (.typ w typ)))))



  (.byte w \)))


^{:go/end 501} (go/method signature [^{:tag (* typeWriter)} w ^{:tag (* Signature)} sig]
  (when (!= (.Len (.TypeParams sig)) 0)
    (when (!= (.-ctxt w) nil)
      (go/call assert (== (.-tparams w) nil))
      (set! (.-tparams w) (.TypeParams sig))
      (defer (^{:go/end 479} (fn []
            (set! (.-tparams w) nil)))))


    (.tParamList w (.list (.TypeParams sig))))


  (.tuple w (.-params sig) (.-variadic sig))

  (let [n (.Len (.-results sig))]
    (when (== n 0)
      ;; no result
      (return))


    (.byte w \space)
    (when (and (== n 1) ^:go/paren (or (!= (.-ctxt w) nil) (== ^{:go/via [object]} (.-name (aget (.-vars (.-results sig)) 0)) "")))
      ;; single unnamed result (if type hashing, name must be ignored)
      (.typ w ^{:go/via [object]} (.-typ (aget (.-vars (.-results sig)) 0)))
      (return))


    ;; multiple or named result(s)
    (.tuple w (.-results sig) false)))



^{:go/end 517} (go/func subscript "subscript returns the decimal (utf8) representation of x using subscript digits.\n" ^string [^uint64 x]
  (let [^:const ^{:val 3} w (len "₀") ; all digits 0...9 have the same utf8 width
      ^{:line 506 :tag (array (* 32 w) byte)} buf (zero (array (* 32 w) byte))
      ^{:line 507} i (len buf)]
    (while true
      (set! i - w)
      (utf8/EncodeRune (subslice buf i) (+ \₀ (conv rune (% x 10)))) ; '₀' == U+2080
      (set! x / 10)
      (when (== x 0)
        (break)))


    (conv string (subslice buf i))))

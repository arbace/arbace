^{:go/end 224} (go/func defPredeclaredFuncs []
  (range [i predeclaredFuncs]
    (let [id (conv builtinId i)]
      (when (or (== id _Assert) (== id _Trace))
        (continue)) ; only define these in testing environment

      (def (newBuiltin id)))))






^{:go/end 235} (go/func DefPredeclaredTestFuncs "DefPredeclaredTestFuncs defines the assert and trace built-ins.\nThese built-ins are intended for debugging and testing of this\npackage only.\n" []
  (when (!= (.Lookup Universe "assert") nil)
    (return)) ; already defined

  (def (newBuiltin _Assert))
  (def (newBuiltin _Trace)))


^{:go/end 254} (go/func init []
  (set! Universe (NewScope nil nopos nopos "universe"))
  (set! Unsafe (NewPackage "unsafe" "unsafe"))
  (set! (.-complete Unsafe) true)

  (defPredeclaredTypes)
  (defPredeclaredConsts)
  (defPredeclaredNil)
  (defPredeclaredFuncs)

  (set! universeIota (.Lookup Universe "iota"))
  (set! universeBool (.Type (.Lookup Universe "bool")))
  (set! universeByte (.Type (.Lookup Universe "byte")))
  (set! universeRune (.Type (.Lookup Universe "rune")))
  (set! universeError (.Type (.Lookup Universe "error")))
  (set! universeAny (.Lookup Universe "any"))
  (set! universeComparable (.Lookup Universe "comparable")))





^{:go/end 286} (go/func def "Objects with names containing blanks are internal and not entered into\na scope. Objects with exported names are inserted in the unsafe package\nscope; other objects are inserted in the universe scope.\n" [^Object obj]
  (go/call assert (!= (.Type obj) nil))
  (let [name (.Name obj)]
    (when (strings/Contains name " ")
      (return)) ; nothing to do

    ;; fix Obj link for named types
    (when [typ (asNamed (.Type obj))] (!= typ nil)
      (set! (.-obj typ) (assert (* TypeName) obj)))

    ;; exported identifiers go into package unsafe
    (let [scope Universe]
      (when (.Exported obj)
        (set! scope (.-scope Unsafe))
        ;; set Pkg field
        (type-switch [obj obj]
          (case [(* TypeName)]
            (set! ^{:go/via [object]} (.-pkg obj) Unsafe))
          (case [(* Builtin)]
            (set! ^{:go/via [object]} (.-pkg obj) Unsafe))
          (default
            (panic "unreachable"))))


      (when (!= (.Insert scope obj) nil)
        (panic "double declaration of predeclared identifier")))))

^{:go/end 116} (go/func defPredeclaredTypes []
  (range [_ t Typ]
    (def (NewTypeName nopos nil (.-name t) t)))


  (range [_ t basicAliases]
    (def (NewTypeName nopos nil (.-name t) t)))


  ;; type error interface{ Error() string }
  (do
    (let [obj (NewTypeName nopos nil "error" nil)
        ^{:line 86} typ (NewNamed obj nil nil)

        ;; error.Error() string
        ^{:line 89} recv (newVar RecvVar nopos nil "" typ)
        ^{:line 90} res (newVar ResultVar nopos nil "" (aget Typ String))
        ^{:line 91} sig (NewSignatureType recv nil nil nil (NewTuple res) false)
        ^{:line 92} err (NewFunc nopos nil "Error" sig)

        ;; interface{ Error() string }
        ^{:line 95} ityp (addr (lit Interface :methods (lit (slice (* Func)) err) :complete true))]
      (computeInterfaceTypeSet nil nopos ityp) ; prevent races due to lazy computation of tset

      (set! (.-fromRHS typ) ityp)
      (.Underlying typ)
      (def obj)))


  ;; type any = interface{}
  (do
    (let [obj (NewTypeName nopos nil "any" nil)]
      (NewAlias obj (addr emptyInterface))
      (def obj)))


  ;; type comparable interface{} // marked as comparable
  (do
    (let [obj (NewTypeName nopos nil "comparable" nil)]
      (NewNamed obj (addr (lit Interface :complete true :tset (addr (lit _TypeSet nil allTermlist true)))) nil)
      (def obj))))




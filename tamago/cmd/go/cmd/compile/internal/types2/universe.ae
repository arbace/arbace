(go/var ^{:tag (* Scope) :doc "The Universe scope contains all predeclared objects of Go.\nIt is the outermost scope of any chain of nested scopes.\n"} Universe)



(go/var ^{:tag (* Package) :doc "The Unsafe package is the package returned by an importer\nfor the import path \"unsafe\".\n"} Unsafe)


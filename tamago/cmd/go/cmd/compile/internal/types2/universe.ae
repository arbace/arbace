    (lit _ "false" UntypedBool (constant/MakeBool false))
    (lit _ "iota" UntypedInt (constant/MakeInt64 0))))


^{:go/end 132} (go/func defPredeclaredConsts []
  (range [_ c predeclaredConsts]
    (def (NewConst nopos nil (.-name c) (aget Typ (.-kind c)) (.-val c)))))



^{:go/end 136} (go/func defPredeclaredNil []

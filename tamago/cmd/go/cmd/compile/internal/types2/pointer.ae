(in-ns 'go.cmd.compile.internal.types2) (go/file "pointer.go" :imports [])


(go/type Pointer "A Pointer represents a pointer type.\n" (struct
    ^{:line 9 :tag Type} base)) ; element type



^{:go/end 13} (go/func NewPointer "NewPointer returns a new pointer type for the given element (base) type.\n" ^{:tag (* Pointer)} [^Type elem] (addr (lit Pointer :base elem)))


^{:go/end 16} (go/method Elem "Elem returns the element type for the given pointer p.\n" ^Type [^{:tag (* Pointer)} p] (.-base p))

^{:go/end 18} (go/method Underlying ^Type [^{:tag (* Pointer)} p] p)
^{:go/end 19} (go/method String ^string [^{:tag (* Pointer)} p] (TypeString p nil))

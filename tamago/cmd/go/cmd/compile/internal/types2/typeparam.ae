^{:go/end 60} (go/method newTypeParam "check may be nil\n" ^{:tag (* TypeParam)} [^{:tag (* Checker)} check ^{:tag (* TypeName)} obj ^Type constraint]
  ;; Always increment lastID, even if it is not used.
  (let [id (nextID)]
    (when (!= check nil)
      (inc! (.-nextID check))
      (set! id (.-nextID check)))

    (let [typ (addr (lit TypeParam :check check :id id :obj obj :index -1 :bound constraint))]
      (when (== ^{:go/via [object]} (.-typ obj) nil)
        (set! ^{:go/via [object]} (.-typ obj) typ))

      ;; iface may mutate typ.bound, so we must ensure that iface() is called
      ;; at least once before the resulting TypeParam escapes.
      (cond (!= check nil)
        (.needsCleanup check typ)
        (!= constraint nil)
        (.iface typ))

      ^{:line 59} typ)))




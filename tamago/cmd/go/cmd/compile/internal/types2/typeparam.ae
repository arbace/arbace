^{:go/end 149} (go/method iface "iface returns the constraint interface of t.\n" ^{:tag (* Interface)} [^{:tag (* TypeParam)} t]
  (let [bound (.-bound t)

      ;; determine constraint interface
      ^{:line 115 :tag (* Interface)} ityp (zero (* Interface))]
    (type-switch [u (.Underlying bound)]
      (case [(* Basic)]

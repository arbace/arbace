  ^{:line 210} [^{:val "invalid argument: "} invalidArg "invalid argument: "]
  ^{:line 211} [^{:val "invalid operation: "} invalidOp "invalid operation: "])



(go/type poser "The poser interface is used to extract the position of type-checker errors.\n" (interface
    (Pos ^syntax/Pos [])))


^{:go/end 223} (go/method error [^{:tag (* Checker)} check ^poser at ^Code code ^string msg]
  (let [err (.newError check code)]
    (.addf err at "%s" msg)
    (.report err)))


^{:go/end 229} (go/method errorf [^{:tag (* Checker)} check ^poser at ^Code code ^string format & ^{:tag (slice any)} args]
  (let [err (.newError check code)]
    (.addf err at format (spread args))
    (.report err)))


^{:go/end 236} (go/method softErrorf [^{:tag (* Checker)} check ^poser at ^Code code ^string format & ^{:tag (slice any)} args]
  (let [err (.newError check code)]
    (.addf err at format (spread args))
    (set! (.-soft err) true)
    (.report err)))


^{:go/end 243} (go/method versionErrorf [^{:tag (* Checker)} check ^poser at ^goVersion v ^string format & ^{:tag (slice any)} args]
  (let [msg (.sprintf check format (spread args))
      ^{:line 240} err (.newError check UnsupportedFeature)]
    (.addf err at "%s requires %s or later" msg v)
    (.report err)))



^{:go/end 256} (go/func atPos "atPos reports the left (= start) position of at.\n" ^syntax/Pos [^poser at]
  (type-switch [x at]
    (case [(* operand)]
      (when (!= (.-expr x) nil)
        (return (syntax/StartPos (.-expr x)))))

    (case [syntax/Node]
      (return (syntax/StartPos x))))

  (.Pos at))

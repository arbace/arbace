            (.assignment check (addr key) (.-key typ) "map index")
            ;; ok to continue even if indexing failed - map element type is known
            (set! (.-mode_ x) mapindex)
            (set! (.-typ_ x) (.-elem typ))
            (set! (.-expr x) e)
            (return false))))

      (case [(* Interface)]

          (set! (.-typ_ x) universeByte))) ; use 'byte' name


      (case [(* Array)]
        (set! valid true)
        (set! length (.-len typ))
        (when (!= (.mode x) variable)
          (set! (.-mode_ x) value))

        (set! (.-typ_ x) (.-elem typ)))

      (case [(* Pointer)]
        (when [(values typ _) (assert (* Array) (.Underlying (.-base typ)))] (!= typ nil)

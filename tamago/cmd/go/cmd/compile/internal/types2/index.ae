^{:go/end 229} (go/method indexExpr "If e is a valid function instantiation, indexExpr returns true.\nIn that case x represents the uninstantiated function value and\nit is the caller's responsibility to instantiate the function.\n" [^{:tag (* Checker)} check ^{:tag (* operand)} x ^{:tag (* syntax/IndexExpr)} e] :results [^bool isFuncInst]
  (.exprOrType check x (.-X e) true)
  ;; x may be generic

  (switch (.mode x)
    (case [invalid]
      (.use check (.-Index e))
      (return false))

    (case [typexpr]
      ;; type instantiation
      (.invalidate x)
      ;; TODO(gri) here we re-evaluate e.X - try to avoid this
      (set! (.-typ_ x) (.varType check e))
      (when (isValid (.typ x))
        (set! (.-mode_ x) typexpr))

      (return false))

    (case [value]
      (when [(values sig _) (assert (* Signature) (.Underlying (.typ x)))] (and (!= sig nil) (> (.Len (.TypeParams sig)) 0))
        ;; function instantiation
        (return true))))



  ;; x should not be generic at this point, but be safe and check
  (.nonGeneric check nil x)
  (when (not (.isValid x))
    (return false))


  ;; We cannot index on an incomplete type; make sure it's complete.
  (when (not (.isComplete check (.typ x)))
    (.invalidate x)
    (return false))

  (type-switch [typ (.Underlying (.typ x))]
    (case [(* Pointer)]
      ;; Additionally, if x.typ is a pointer to an array type, indexing implicitly dereferences the value, meaning
      ;; its base type must also be complete.
      (when (not (.isComplete check (.-base typ)))

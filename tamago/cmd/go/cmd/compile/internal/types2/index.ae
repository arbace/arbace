^{:go/end 393} (go/method sliceExpr [^{:tag (* Checker)} check ^{:tag (* operand)} x ^{:tag (* syntax/SliceExpr)} e]
  (.expr check nil x (.-X e))
  (when (not (.isValid x))
    (.use check (spread (subslice (.-Index e))))
    (return))


  ;; determine common underlying type cu
  (let [(values ^Type ct ^Type cu) (zero Type) ; type and respective common underlying type
      ^{:line 240 :tag bool} hasString (zero bool)]
    (range [t u (typeset (.typ x))]
      (when (== u nil)
        (.errorf check x NonSliceableOperand "cannot slice %s: no specific type in %s" x (.typ x))
        (set! cu nil)
        (break))


      ;; Treat strings like byte slices but remember that we saw a string.
      (when (isString u)
        (set! u (NewSlice universeByte))
        (set! hasString true))


      ;; If this is the first type we're seeing, we're done.
      (when (== cu nil)
        (set! (values ct cu) (values t u))
        (continue))


      ;; Otherwise, the current type must have the same underlying type as all previous types.
      (when (not (Identical cu u))
        (.errorf check x NonSliceableOperand "cannot slice %s: %s and %s have different underlying types" x ct t)
        (set! cu nil)
        (break)))


    (when hasString
      ;; If we saw a string, proceed with string type,
      ;; but don't go from untyped string to string.
      (set! cu (aget Typ String))
      (when (not (isTypeParam (.typ x)))
        (set! cu (.Underlying (.typ x))))) ; untyped string remains untyped



    ;; Note that we don't permit slice expressions where x is a type expression, so we don't check for that here.
    ;; However, if x.typ is a pointer to an array type, slicing implicitly dereferences the value, meaning
    ;; its base type must also be complete.
    (when [(values p ok) (assert (* Pointer) (.Underlying (.typ x)))] (and ok (not (.isComplete check (.-base p))))
      (.invalidate x)
      (return))


    (let [valid false
        ^{:line 285} length (conv int64 -1)] ; valid if >= 0
      (type-switch [u cu]

^{:go/end 414} (go/method singleIndex "singleIndex returns the (single) index from the index expression e.\nIf the index is missing, or if there are multiple indices, an error\nis reported and the result is nil.\n" ^syntax/Expr [^{:tag (* Checker)} check ^{:tag (* syntax/IndexExpr)} e]
  (let [index (.-Index e)]
    (when (== index nil)
      (.errorf check e InvalidSyntaxTree "missing index for %s" (.-X e))
      (return nil))

    (when [(values l _) (assert (* syntax/ListExpr) index)] (!= l nil)
      (when [n (len (.-ElemList l))] (<= n 1)
        (.errorf check e InvalidSyntaxTree "invalid use of ListExpr for index expression %v with %d indices" e n)
        (return nil))

      ;; len(l.ElemList) > 1
      (.error check (aget (.-ElemList l) 1) InvalidIndex (+ invalidOp "more than one index"))
      (set! index (aget (.-ElemList l) 0))) ; continue with first index

    ^{:line 413} index))






^{:go/end 447} (go/method index "index checks an index expression for validity.\nIf max >= 0, it is the upper bound for index.\nIf the result typ is != Typ[Invalid], index is valid and typ is its (possibly named) integer type.\nIf the result val >= 0, index is valid and val is its constant int value.\n" [^{:tag (* Checker)} check ^syntax/Expr index ^int64 max] :results [^Type typ ^int64 val]
  (set! typ (aget Typ Invalid))
  (set! val -1)

  (let [^operand x (zero operand)]
    (.expr check nil (addr x) index)
    (when (not (.isValidIndex check (addr x) InvalidIndex "index" false))
      (return))


    (when (!= (.mode x) constant_)
      (return (.typ x) -1))


    (when (== (.Kind (.-val x)) constant/Unknown)
      (return))


    (let [(values v ok) (constant/Int64Val (.-val x))]
      (go/call assert ok)
      (when (and (>= max 0) (>= v max))
        (.errorf check (addr x) InvalidIndex (+ invalidArg "index %s out of bounds [0:%d]") (.String (.-val x)) max)
        (return))


      ;; 0 <= v [ && v < max ]
      (return (.typ x) v))))






^{:go/breaks [[9 484]] :go/end 485} (go/method isValidIndex "isValidIndex checks whether operand x satisfies the criteria for integer\nindex values. If allowNegative is set, a constant operand may be negative.\nIf the operand is not valid, an error is reported (using what as context)\nand the result is false.\n" ^bool [^{:tag (* Checker)} check ^{:tag (* operand)} x ^Code code ^string what ^bool allowNegative]

      ^{:line 74} length (conv int64 -1)] ; valid if >= 0
    (type-switch [typ (.Underlying (.typ x))]
      (case [(* Basic)]
        (when (isString typ)
          (set! valid true)
          (when (== (.mode x) constant_)

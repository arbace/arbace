;; This file implements functions for untyped constant operands.

(in-ns 'go.cmd.compile.internal.types2) (go/file "const.go" :imports [


    ^{:line 10} [syntax "cmd/compile/internal/syntax"]
    ^{:line 11} [constant "go/constant"]
    ^{:line 12} [token "go/token"]
    ^{:line 13} [. "internal/types/errors"]

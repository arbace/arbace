;; Helper functions exported for the compiler.
;; Do not use internally.

(in-ns 'go.cmd.compile.internal.types2) (go/file "compilersupport.go" :imports [])


^{:go/end 14} (go/func AsPointer "If t is a pointer, AsPointer returns that type, otherwise it returns nil.\n" ^{:tag (* Pointer)} [^Type t]
  (let [(values u _) (assert (* Pointer) (.Underlying t))]
    ^{:line 13} u))








^{:go/end 25} (go/func CoreType "If typ is a type parameter, CoreType returns the single underlying\ntype of all types in the corresponding type constraint if it exists, or\nnil otherwise. If the type set contains only unrestricted and restricted\nchannel types (with identical element types), the single underlying type\nis the restricted channel type if the restrictions are always the same.\nIf typ is not a type parameter, CoreType returns the underlying type.\n" ^Type [^Type t]
  (let [(values u _) (commonUnder t nil)]
    ^{:line 24} u))




^{:go/end 33} (go/func RangeKeyVal "RangeKeyVal returns the key and value types for a range over typ.\nIt panics if range over typ is invalid.\n" [^Type typ] :results [Type Type]
  (let [(values key val _ ok) (rangeKeyVal nil typ nil)]
    (go/call assert ok)
    (return key val)))

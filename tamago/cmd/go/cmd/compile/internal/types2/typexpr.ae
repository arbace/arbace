^{:go/end 461} (go/method instantiatedType [^{:tag (* Checker)} check ^syntax/Expr x ^{:tag (slice syntax/Expr)} xlist] :results [^Type res]
  (when (.-Trace (.-conf check))
    (.trace check (.Pos x) "-- instantiating type %s with %s" x xlist)
    (inc! (.-indent check))
    (defer (^{:go/end 403} (fn []

                (.softErrorf check pos MisplacedConstraintIface "cannot use type %s outside a type constraint: interface is (or embeds) comparable" typ)

                (.softErrorf check pos MisplacedConstraintIface "cannot use type %s outside a type constraint: interface contains type constraints" typ)))))))



    ^{:line 176} e "check var type %s" typ))






^{:go/end 192} (go/method declaredType "declaredType is like typ but also accepts a type name def.\nIf def != nil, e is the type specification for the [Alias] or [Named] type\nnamed def, and def.typ.fromRHS will be set to the [Type] of e immediately\nafter its creation.\n" ^Type [^{:tag (* Checker)} check ^syntax/Expr e ^{:tag (* TypeName)} def]

^{:go/end 213} (go/method genericType "genericType is like typ but the type must be an (uninstantiated) generic\ntype. If cause is non-nil and the type expression was a valid type but not\ngeneric, cause will be populated with a message describing the error.\n\nNote: If the type expression was invalid and an error was reported before,\ncause will not be populated; thus cause alone cannot be used to determine\nif an error occurred.\n" ^Type [^{:tag (* Checker)} check ^syntax/Expr e ^{:tag (* string)} cause]
  (let [typ (.typInternal check e nil)]
    (go/call assert (isTyped typ))
    (when (and (isValid typ) (not (isGeneric typ)))
      (when (!= cause nil)
        (set! @cause (.sprintf check "%s is not a generic type" typ)))

      (set! typ (aget Typ Invalid)))

    ;; TODO(gri) what is the correct call below?
    (.recordTypeAndValue check e typexpr typ nil)

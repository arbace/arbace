^{:go/end 136} (go/method ident "ident type-checks identifier e and initializes x with the value or type of e.\nIf an error occurred, x.mode is set to invalid.\nIf wantType is set, the identifier e is expected to denote a type.\n" [^{:tag (* Checker)} check ^{:tag (* operand)} x ^{:tag (* syntax/Name)} e ^bool wantType]
  (.invalidate x)
  (set! (.-expr x) e)

  (let [(values scope obj) ^{:go/via [environment]} (.lookupScope check (.-Value e))]
    (switch obj
      (case [nil]
        (cond (== (.-Value e) "_")
          (.error check e InvalidBlank "cannot use _ as value or type")
          (isValidName (.-Value e))
          (.errorf check e UndeclaredName "undefined: %s" (.-Value e)))

        (return))
      (case [universeAny universeComparable]
        (when (not (.verifyVersionf check e go1_18 "predeclared %s" (.-Value e)))
          (return)))) ; avoid follow-on errors



    (.recordUse check e obj)

    ;; If we want a type but don't have one, stop right here and avoid potential problems
    ;; with missing underlying types. This also gives better error messages in some cases
    ;; (see go.dev/issue/65344).
    (let [(values _ gotType) (assert (* TypeName) obj)]
      (when (and (not gotType) wantType)
        (.errorf check e NotAType "%s (%s) is not a type" (.Name obj) (objectKind obj))

        ;; avoid "declared but not used" errors
        ;; (don't use Checker.use - we don't want to evaluate too much)
        (when [(values v _) (assert (* Var) obj)] (and (!= v nil) (== ^{:go/via [object]} (.-pkg v) (.-pkg check))) ; /* see Checker.use1 */
          (aset (.-usedVars check) v true))

        (return))


      ;; Type-check the object.
      ;; Only call Checker.objDecl if the object doesn't have a type yet
      ;; (in which case we must actually determine it) or the object is a
      ;; TypeName from the current package and we also want a type (in which case
      ;; we might detect a cycle which needs to be reported). Otherwise we can skip
      ;; the call and avoid a possible cycle error in favor of the more informative
      ;; "not a type/value" error that this function's caller will issue (see
      ;; go.dev/issue/25790).
      ;;
      ;; Note that it is important to avoid calling objDecl on objects from other
      ;; packages, to avoid races: see issue #69912.
      (let [typ (.Type obj)]
        (when (or (== typ nil) ^:go/paren (and gotType wantType (== (.Pkg obj) (.-pkg check))))
          (.objDecl check obj)
          (set! typ (.Type obj))) ; type must have been assigned by Checker.objDecl

        (go/call assert (!= typ nil))

        ;; The object may have been dot-imported.
        ;; If so, mark the respective package as used.
        ;; (This code is only needed for dot-imports. Without them,
        ;; we only have to mark variables, see *Var case below).
        (when [pkgName (aget (.-dotImportMap check) (lit dotImportKey scope (.Name obj)))] (!= pkgName nil)
          (aset (.-usedPkgNames check) pkgName true))


        (type-switch [obj obj]
          (case [(* PkgName)]
            (.errorf check e InvalidPkgUse "use of package %s not in selector" ^{:go/via [object]} (.-name obj))
            (return))

          (case [(* Const)]
            (.addDeclDep check obj)
            (when (not (isValid typ))
              (return))

            (if (== obj universeIota) (do
                (when (== ^{:go/via [environment]} (.-iota check) nil)
                  (.error check e InvalidIota "cannot use iota outside constant declaration")
                  (return))

                (set! (.-val x) ^{:go/via [environment]} (.-iota check)))

              (set! (.-val x) (.-val obj)))

            (go/call assert (!= (.-val x) nil))
            (set! (.-mode_ x) constant_))

          (case [(* TypeName)]
            (set! (.-mode_ x) typexpr))

          (case [(* Var)]
            ;; It's ok to mark non-local variables, but ignore variables
            ;; from other packages to avoid potential race conditions with
            ;; dot-imported variables.
            (when (== ^{:go/via [object]} (.-pkg obj) (.-pkg check))
              (aset (.-usedVars check) obj true))

            (.addDeclDep check obj)
            (when (not (isValid typ))
              (return))

            (set! (.-mode_ x) variable))

          (case [(* Func)]
            (.addDeclDep check obj)
            (set! (.-mode_ x) value))

          (case [(* Builtin)]
            (set! (.-id x) (.-id obj))
            (set! (.-mode_ x) builtin))

          (case [(* Nil)]
            (set! (.-mode_ x) nilvalue))

          (default
            (panic "unreachable")))


        (set! (.-typ_ x) typ)))))





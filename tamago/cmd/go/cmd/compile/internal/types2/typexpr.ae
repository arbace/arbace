^{:go/end 177} (go/method validVarType "validVarType reports an error if typ is a constraint interface.\nThe expression e is used for error reporting, if any.\n" [^{:tag (* Checker)} check ^syntax/Expr e ^Type typ]
  ;; If we have a type parameter there's nothing to do.
  (when (isTypeParam typ)
    (return))


  ;; We don't want to call typ.Underlying() or complete interfaces while we are in
  ;; the middle of type-checking parameter declarations that might belong
  ;; to interface methods. Delay this check to the end of type-checking.

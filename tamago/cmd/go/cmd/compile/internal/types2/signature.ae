(go/var ^{:doc "sentinel value for detecting method expressions\n"} methodExprSentinel (addr (lit Var)))















^{:go/end 115} (go/func NewSignatureType "NewSignatureType creates a new function type for the given receiver,\nreceiver type parameters, type parameters, parameters, and results.\n\nIf variadic is set, params must hold at least one parameter and the\nlast parameter must be an unnamed slice or a type parameter whose\ntype set has an unnamed slice as common underlying type.\n\nAs a special case, to support append([]byte, str...), for variadic\nsignatures the last parameter may also be a string type, or a type\nparameter containing a mix of byte slices and string types in its\ntype set. It may even be a named []byte slice type resulting from\nsubstitution of such a type parameter.\n\nIf recvTypeParams is non-empty, recv must be non-nil.\n" ^{:tag (* Signature)} [^{:tag (* Var)} recv ^{:tag (slice (* TypeParam))} recvTypeParams ^{:tag (slice (* TypeParam))} typeParams ^{:tag (* Tuple)} params ^{:tag (* Tuple)} results ^bool variadic]
  (when variadic
    (let [n (.Len params)]
      (when (== n 0)
        (panic "variadic function must have at least one parameter"))

      (let [last ^{:go/via [object]} (.-typ (.At params (- n 1)))
          ^{:line 70 :tag (* Slice)} S (zero (* Slice))]
        (range [t (typeset last)]
          (when (== t nil)
            (break))

          (let [^{:tag (* Slice)} s (zero (* Slice))]
            (if (isString t)
              (set! s (NewSlice universeByte))

              ;; Variadic Go functions have a last parameter of type []T,
              ;; suggesting we should reject a named slice type B here.
              ;;
              ;; However, a call to built-in append(slice, x...)
              ;; where x has a TypeParam type [T ~string | ~[]byte],
              ;; has the type func([]byte, T). Since a client may
              ;; instantiate this type at T=B, we must permit
              ;; named slice types, even when this results in a
              ;; signature func([]byte, B) where type B []byte.
              ;;
              ;; (The caller of NewSignatureType may have no way to
              ;; know that it is dealing with the append special case.)
              (set! (values s _) (assert (* Slice) (.Underlying t))))

            (cond (== S nil)
              (set! S s)
              (or (== s nil) (not (Identical S s))) (do
                (set! S nil)
                (break)))))


        (when (== S nil)
          (panic (fmt/Sprintf "got %s, want variadic parameter of slice or string type" last))))))


  (let [sig (addr (lit Signature :recv recv :params params :results results :variadic variadic))]
    (when (!= (len recvTypeParams) 0)
      (when (== recv nil)
        (panic "function with receiver type parameters must have a receiver"))

      (set! (.-rparams sig) (bindTParams recvTypeParams)))

    (when (!= (len typeParams) 0)
      (set! (.-tparams sig) (bindTParams typeParams)))

    ^{:line 114} sig))









^{:go/end 133} (go/method Params "Params returns the parameters of signature s, or nil.\nSee [NewSignatureType] for details of variadic functions.\n" ^{:tag (* Tuple)} [^{:tag (* Signature)} s] (.-params s))


^{:go/end 136} (go/method Results "Results returns the results of signature s, or nil.\n" ^{:tag (* Tuple)} [^{:tag (* Signature)} s] (.-results s))



;; This file contains various functionality that is
;; different between go/types and types2. Factoring
;; out this code allows more of the rest of the code
;; to be shared.

(in-ns 'go.cmd.compile.internal.types2) (go/file "util.go" :imports [


    ^{:line 13} [syntax "cmd/compile/internal/syntax"]
    ^{:line 14} [constant "go/constant"]
    ^{:line 15} [token "go/token"]])


(go/const ^{:val true} isTypes2 true)









^{:go/end 28} (go/func cmpPos "cmpPos compares the positions p and q and returns a result r as follows:\n\nr <  0: p is before q\nr == 0: p and q are the same position (but may not be identical)\nr >  0: p is after q\n\nIf p and q are in different files, p is before q if the filename\nof p sorts lexicographically before the filename of q.\n" ^int [^syntax/Pos p ^syntax/Pos q] (.Cmp p q))


^{:go/end 31} (go/func hasDots "hasDots reports whether the last argument in the call is followed by ...\n" ^bool [^{:tag (* syntax/CallExpr)} call] (.-HasDots call))


^{:go/end 37} (go/func dddErrPos "dddErrPos returns the node (poser) for reporting an invalid ... use in a call.\n" ^{:tag (* syntax/CallExpr)} [^{:tag (* syntax/CallExpr)} call]
  ;; TODO(gri) should use "..." instead of call position
  ^{:line 36} call)



^{:go/end 40} (go/func isdddArray "isdddArray reports whether atyp is of the form [...]E.\n" ^bool [^{:tag (* syntax/ArrayType)} atyp] (== (.-Len atyp) nil))


^{:go/end 43} (go/func argErrPos "argErrPos returns the node (poser) for reporting an invalid argument count.\n" ^{:tag (* syntax/CallExpr)} [^{:tag (* syntax/CallExpr)} call] call)


^{:go/end 46} (go/func ExprString "ExprString returns a string representation of x.\n" ^string [^syntax/Node x] (syntax/String x))


^{:go/end 49} (go/func startPos "startPos returns the start position of node n.\n" ^syntax/Pos [^syntax/Node n] (syntax/StartPos n))


^{:go/end 52} (go/func endPos "endPos returns the position of the first character immediately after node n.\n" ^syntax/Pos [^syntax/Node n] (syntax/EndPos n))


^{:go/end 55} (go/func inNode "inNode is a dummy function returning pos.\n" ^syntax/Pos [^syntax/Node _ ^syntax/Pos pos] pos)


^{:go/end 60} (go/func makeFromLiteral "makeFromLiteral returns the constant value for the given literal string and kind.\n" ^constant/Value [^string lit ^syntax/LitKind kind]
  (constant/MakeFromLiteral lit (aget kind2tok kind) 0))


(go/var kind2tok (lit (array ... token/Token)
    ^{:line 63} [syntax/IntLit token/INT]
    ^{:line 64} [syntax/FloatLit token/FLOAT]
    ^{:line 65} [syntax/ImagLit token/IMAG]
    ^{:line 66} [syntax/RuneLit token/CHAR]
    ^{:line 67} [syntax/StringLit token/STRING]))

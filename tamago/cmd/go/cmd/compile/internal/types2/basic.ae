(in-ns 'go.cmd.compile.internal.types2) (go/file "basic.go" :imports [])


(go/type BasicKind "BasicKind describes the kind of basic type.\n" int)

(go/const
  ^{:line 11} [^{:tag BasicKind :val 0} Invalid iota] ; type is invalid


  ^{:line 14} [^{:val 1 :doc "predeclared types\n"} Bool]
  ^{:line 15} [^{:val 2} Int]
  ^{:line 16} [^{:val 3} Int8]
  ^{:line 17} [^{:val 4} Int16]
  ^{:line 18} [^{:val 5} Int32]
  ^{:line 19} [^{:val 6} Int64]
  ^{:line 20} [^{:val 7} Uint]
  ^{:line 21} [^{:val 8} Uint8]
  ^{:line 22} [^{:val 9} Uint16]
  ^{:line 23} [^{:val 10} Uint32]
  ^{:line 24} [^{:val 11} Uint64]
  ^{:line 25} [^{:val 12} Uintptr]
  ^{:line 26} [^{:val 13} Float32]
  ^{:line 27} [^{:val 14} Float64]
  ^{:line 28} [^{:val 15} Complex64]
  ^{:line 29} [^{:val 16} Complex128]
  ^{:line 30} [^{:val 17} String]
  ^{:line 31} [^{:val 18} UnsafePointer]


  ^{:line 34} [^{:val 19 :doc "types for untyped values\n"} UntypedBool]
  ^{:line 35} [^{:val 20} UntypedInt]
  ^{:line 36} [^{:val 21} UntypedRune]
  ^{:line 37} [^{:val 22} UntypedFloat]
  ^{:line 38} [^{:val 23} UntypedComplex]
  ^{:line 39} [^{:val 24} UntypedString]
  ^{:line 40} [^{:val 25} UntypedNil]


  ^{:line 43} [^{:val 8 :doc "aliases\n"} Byte Uint8]
  ^{:line 44} [^{:val 5} Rune Int32])



(go/type BasicInfo "BasicInfo is a set of flags describing properties of a basic type.\n" int)


(go/const "Properties of basic types.\n"
  ^{:line 52} [^{:tag BasicInfo :val 1} IsBoolean (<< 1 iota)]
  ^{:line 53} [^{:val 2} IsInteger]
  ^{:line 54} [^{:val 4} IsUnsigned]
  ^{:line 55} [^{:val 8} IsFloat]
  ^{:line 56} [^{:val 16} IsComplex]
  ^{:line 57} [^{:val 32} IsString]
  ^{:line 58} [^{:val 64} IsUntyped]

  ^{:line 60} [^{:val 42} IsOrdered (bit-or IsInteger IsFloat IsString)]
  ^{:line 61} [^{:val 26} IsNumeric (bit-or IsInteger IsFloat IsComplex)]
  ^{:line 62} [^{:val 59} IsConstType (bit-or IsBoolean IsNumeric IsString)])



(go/type Basic "A Basic represents a basic type.\n" (struct
    ^{:line 67 :tag BasicKind} kind
    ^{:line 68 :tag BasicInfo} info
    ^{:line 69 :tag string} name))



^{:go/end 73} (go/method Kind "Kind returns the kind of basic type b.\n" ^BasicKind [^{:tag (* Basic)} b] (.-kind b))


^{:go/end 76} (go/method Info "Info returns information about properties of basic type b.\n" ^BasicInfo [^{:tag (* Basic)} b] (.-info b))


^{:go/end 79} (go/method Name "Name returns the name of basic type b.\n" ^string [^{:tag (* Basic)} b] (.-name b))

^{:go/end 81} (go/method Underlying ^Type [^{:tag (* Basic)} b] b)
^{:go/end 82} (go/method String ^string [^{:tag (* Basic)} b] (TypeString b nil))

        ;; we don't want to use the same variable for all scopes and change the
        ;; variable type underfoot.)
        (when (!= lhs nil)
          (let [^bool used (zero bool)]
            (range [_ v lhsVars]
              (when (aget (.-usedVars check) v)
                (set! used true))

              (aset (.-usedVars check) v true)) ; avoid usage error when checking entire function

            (when (not used)

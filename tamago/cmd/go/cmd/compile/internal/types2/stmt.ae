        ;; declaration, but the post statement must not."
        (when [(values s _) (assert (* syntax/AssignStmt) (.-Post s))] (and (!= s nil) (== (.-Op s) syntax/Def))
          ;; The parser already reported an error.
          (.use check (.-Lhs s))) ; avoid follow-up errors

        (.stmt check inner (.-Body s)))

      (default
        (.error check s InvalidSyntaxTree "invalid statement")))))



^{:go/end 761} (go/method switchStmt [^{:tag (* Checker)} check ^stmtContext inner ^{:tag (* syntax/SwitchStmt)} s]
  ;; init statement already handled

  (let [^operand x (zero operand)]
    (if (!= (.-Tag s) nil) (do
        (.expr check nil (addr x) (.-Tag s))
        ;; By checking assignment of x to an invisible temporary
        ;; (as a compiler would), we get all the relevant checks.
        (.assignment check (addr x) nil "switch expression")
        (when (and (.isValid x) (not (Comparable (.typ x))) (not (hasNil (.typ x))))
          (.errorf check (addr x) InvalidExprSwitch "cannot switch on %s (%s is not comparable)" (addr x) (.typ x))
          (.invalidate x)))

      (do
        ;; spec: "A missing switch expression is
        ;; equivalent to the boolean value true."
        (set! (.-mode_ x) constant_)
        (set! (.-typ_ x) (aget Typ Bool))
        (set! (.-val x) (constant/MakeBool true))
        ;; TODO(gri) should have a better position here
        (let [pos (.-Rbrace s)]
          (when (> (len (.-Body s)) 0)
            (set! pos ^{:go/via [node]} (.Pos (aget (.-Body s) 0))))

          (set! (.-expr x) (syntax/NewName pos "true")))))


    (.multipleSwitchDefaults check (.-Body s))

    (let [seen (make valueMap)] ; map of seen case values to positions and types
      (range [i clause (.-Body s)]
        (when (== clause nil)
          (.error check clause InvalidSyntaxTree "incorrect expression switch case")
          (continue))

        (let [inner inner]
          (if (< (+ i 1) (len (.-Body s)))
            (set! inner bit-or fallthroughOk)

            (set! inner bit-or finalSwitchCase))

          (.caseValues check (addr x) (syntax/UnpackListExpr (.-Cases clause)) seen)
          (.openScope check clause "case")
          (.stmtList check inner (.-Body clause))
          (.closeScope check))))))



^{:go/end 842} (go/method typeSwitchStmt [^{:tag (* Checker)} check ^stmtContext inner ^{:tag (* syntax/SwitchStmt)} s ^{:tag (* syntax/TypeSwitchGuard)} guard]
  ;; init statement already handled

  ;; A type switch guard must be of the form:
  ;;
  ;;     TypeSwitchGuard = [ identifier ":=" ] PrimaryExpr "." "(" "type" ")" .
  ;;                          \__lhs__/        \___rhs___/

  ;; check lhs, if any
  (let [lhs (.-Lhs guard)]
    (when (!= lhs nil)
      (if (== (.-Value lhs) "_") (do
          ;; _ := x.(type) is an invalid short variable declaration
          (.softErrorf check lhs NoNewVar "no new variable on left side of :=")
          (set! lhs nil)) ; avoid declared and not used error below

        (.recordDef check lhs nil))) ; lhs variable is implicitly declared in each cause clause



    ;; check rhs
    (let [^{:tag (* operand)} sx (zero (* operand))] ; switch expression against which cases are compared against; nil if invalid
      (do
        (let [^operand x (zero operand)]
          (.expr check nil (addr x) (.-X guard))
          (when (.isValid x)
            (cond (isTypeParam (.typ x))
              (.errorf check (addr x) InvalidTypeSwitch "cannot use type switch on type parameter value %s" (addr x))
              (IsInterface (.typ x))
              (set! sx (addr x)) :else

              (.errorf check (addr x) InvalidTypeSwitch "%s is not an interface" (addr x))))))




      (.multipleSwitchDefaults check (.-Body s))

      (let [^{:tag (slice (* Var))} lhsVars (zero (slice (* Var))) ; list of implicitly declared lhs variables
          ^{:line 802} seen (make (map Type syntax/Expr))] ; map of seen types to positions
        (range [_ clause (.-Body s)]
          (when (== clause nil)
            (.error check s InvalidSyntaxTree "incorrect type switch case")
            (continue))

          ;; Check each type in this type switch case.
          (let [cases (syntax/UnpackListExpr (.-Cases clause))
              ^{:line 810} T (.caseTypes check sx cases seen)]

^{:go/end 397} (go/method updateExprType "updateExprType updates the type of x to typ and invokes itself\nrecursively for the operands of x, depending on expression kind.\nIf typ is still an untyped and not the final type, updateExprType\nonly updates the recorded untyped type for x and possibly its\noperands. Otherwise (i.e., typ is not an untyped type anymore,\nor it is the final type for x), the type and value are recorded.\nAlso, if x is a constant, it must be representable as a value of typ,\nand if x is the (formerly untyped) lhs operand of a non-constant\nshift, it must be an integer value.\n" [^{:tag (* Checker)} check ^syntax/Expr x ^Type typ ^bool final]
  (let [(values old found) (aget (.-untyped check) x)]
    (when (not found)
      (return)) ; nothing to do


    ;; update operands of x if necessary
    (type-switch [x x]
      (case [(* syntax/BadExpr)
          (* syntax/FuncLit)
          (* syntax/CompositeLit)
          (* syntax/IndexExpr)
          (* syntax/SliceExpr)
          (* syntax/AssertExpr)
          (* syntax/ListExpr)
          ;;*syntax.StarExpr,
          (* syntax/KeyValueExpr)
          (* syntax/ArrayType)
          (* syntax/StructType)
          (* syntax/FuncType)
          (* syntax/InterfaceType)
          (* syntax/MapType)
          (* syntax/ChanType)]
        ;; These expression are never untyped - nothing to do.
        ;; The respective sub-expressions got their final types
        ;; upon assignment or use.
        (when debug
          (.dump check "%v: found old type(%s): %s (new: %s)" (atPos x) x (.-typ old) typ)
          (panic "unreachable"))

        (return))

      (case [(* syntax/CallExpr)])
      ;; Resulting in an untyped constant (e.g., built-in complex).
      ;; The respective calls take care of calling updateExprType
      ;; for the arguments if necessary.

      (case [(* syntax/Name) (* syntax/BasicLit) (* syntax/SelectorExpr)])

        (default
          (panic "unreachable")))

      (.errorf check x code msg x)
      (.invalidate x))))




^{:go/end 1433} (go/method singleValue "singleValue reports an error if x describes a tuple and sets x.mode to invalid.\n" [^{:tag (* Checker)} check ^{:tag (* operand)} x]
  (when (== (.mode x) value)
    ;; tuple types are never named - no need for underlying type below
    (when [(values t ok) (assert (* Tuple) (.typ x))] ok
      (go/call assert (!= (.Len t) 1))
      (.errorf check x TooManyValues "multiple-value %s in single-value context" x)
      (.invalidate x))))






      ;; or a qualified identifier (imported untyped constant).
      ;; No operands to take care of.

      (case [(* syntax/ParenExpr)]
        (.updateExprType check (.-X x) typ final))

      ;; case *syntax.UnaryExpr:
      ;; 	// If x is a constant, the operands were constants.
      ;; 	// The operands don't need to be updated since they
      ;; 	// never get "materialized" into a typed value. If
      ;; 	// left in the untyped map, they will be processed
      ;; 	// at the end of the type check.
      ;; 	if old.val != nil {
      ;; 		break
      ;; 	}
      ;; 	check.updateExprType(x.X, typ, final)

      (case [(* syntax/Operation)]
        (when (== (.-Y x) nil)
          ;; unary expression
          (when (== (.-Op x) syntax/Mul)
            ;; see commented out code for StarExpr above
            ;; TODO(gri) needs cleanup
            (when debug
              (panic "unimplemented"))

            (return))

          ;; If x is a constant, the operands were constants.
          ;; The operands don't need to be updated since they
          ;; never get "materialized" into a typed value. If
          ;; left in the untyped map, they will be processed
          ;; at the end of the type check.
          (when (!= (.-val old) nil)
            (break))

          (.updateExprType check (.-X x) typ final)
          (break))


        ;; binary expression
        (when (!= (.-val old) nil)
          (break)) ; see comment for unary expressions

        (cond (isComparison (.-Op x)) (do)
          ;; The result type is independent of operand types
          ;; and the operand types must have final types.
          (isShift (.-Op x))
          ;; The result type depends only on lhs operand.
          ;; The rhs type was updated when checking the shift.
          (.updateExprType check (.-X x) typ final) :else
          (do
            ;; The operand types match the result type.
            (.updateExprType check (.-X x) typ final)
            (.updateExprType check (.-Y x) typ final))))


      (default
        (panic "unreachable")))


    ;; If the new type is not final and still untyped, just
    ;; update the recorded type.
    (when (and (not final) (isUntyped typ))
      (set! (.-typ old) (assert (* Basic) (.Underlying typ)))
      (aset (.-untyped check) x old)
      (return))


    ;; Otherwise we have the final (typed or untyped type).
    ;; Remove it from the map of yet untyped expressions.

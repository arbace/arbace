(go/type Initializer "An Initializer describes a package-level variable, or a list of variables in case\nof a multi-valued initialization expression, and the corresponding initialization\nexpression.\n" (struct
    ^{:line 448 :tag (slice (* Var))} Lhs ; var Lhs = Rhs

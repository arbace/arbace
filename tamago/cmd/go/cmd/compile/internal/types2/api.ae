;; Package types2 declares the data types and implements
;; the algorithms for type-checking of Go packages. Use
;; Config.Check to invoke the type checker for a package.
;; Alternatively, create a new type checker with NewChecker
;; and invoke it incrementally by calling Checker.Files.
;;
;; Type-checking consists of several interdependent phases:
;;
;; Name resolution maps each identifier (syntax.Name) in the program to the
;; language object (Object) it denotes.
;; Use Info.{Defs,Uses,Implicits} for the results of name resolution.
;;
;; Constant folding computes the exact constant value (constant.Value)
;; for every expression (syntax.Expr) that is a compile-time constant.
;; Use Info.Types[expr].Value for the results of constant folding.
;;
;; Type inference computes the type (Type) of every expression (syntax.Expr)
;; and checks for compliance with the language specification.
;; Use Info.Types[expr].Type for the results of type inference.
(in-ns 'go.cmd.compile.internal.types2) (go/file "api.go" :doc "Package types2 declares the data types and implements\nthe algorithms for type-checking of Go packages. Use\nConfig.Check to invoke the type checker for a package.\nAlternatively, create a new type checker with NewChecker\nand invoke it incrementally by calling Checker.Files.\n\nType-checking consists of several interdependent phases:\n\nName resolution maps each identifier (syntax.Name) in the program to the\nlanguage object (Object) it denotes.\nUse Info.{Defs,Uses,Implicits} for the results of name resolution.\n\nConstant folding computes the exact constant value (constant.Value)\nfor every expression (syntax.Expr) that is a compile-time constant.\nUse Info.Types[expr].Value for the results of constant folding.\n\nType inference computes the type (Type) of every expression (syntax.Expr)\nand checks for compliance with the language specification.\nUse Info.Types[expr].Type for the results of type inference.\n" :imports [


    ^{:line 27} [syntax "cmd/compile/internal/syntax"]
    ^{:line 28} [fmt "fmt"]
    ^{:line 29} [constant "go/constant"]
    ^{:line 30} [. "internal/types/errors"]
    ^{:line 31} [strings "strings"]])






(go/type Error "An Error describes a type-checking error; it implements the error interface.\nA \"soft\" error is an error that still permits a valid interpretation of a\npackage (such as \"unused variable\"); \"hard\" errors may lead to unpredictable\nbehavior if ignored.\n" (struct
    ^{:line 39 :tag syntax/Pos} Pos ; error position
    ^{:line 40 :tag string} Msg ; default error message, user-friendly
    ^{:line 41 :tag string} Full ; full error message, for debugging (may contain internal details)
    ^{:line 42 :tag bool} Soft ; if set, error is "soft"
    ^{:line 43 :tag Code} Code)) ; error code




^{:go/end 50} (go/method Error "Error returns an error string formatted as follows:\nfilename:line:column: message\n" ^string [^Error err]
  (fmt/Sprintf "%s: %s" (.-Pos err) (.-Msg err)))





^{:go/end 57} (go/method FullError "FullError returns an error string like Error, buy it may contain\ntype-checker internal details such as subscript indices for type\nparameters and more. Useful for debugging.\n" ^string [^Error err]
  (fmt/Sprintf "%s: %s" (.-Pos err) (.-Full err)))



(go/type ArgumentError "An ArgumentError holds an error associated with an argument index.\n" (struct
    ^{:line 61 :tag int} Index
    ^{:line 62 :tag error} Err))


^{:go/end 65} (go/method Error ^string [^{:tag (* ArgumentError)} e] (.Error (.-Err e)))
^{:go/end 66} (go/method Unwrap ^error [^{:tag (* ArgumentError)} e] (.-Err e))






(go/type Importer "An Importer resolves import paths to Packages.\n\nCAUTION: This interface does not support the import of locally\nvendored packages. See https://golang.org/s/go15vendor.\nIf possible, external implementations should implement ImporterFrom.\n" (interface



    (^{:doc "Import returns the imported package for the given import path.\nThe semantics is like for ImporterFrom.ImportFrom except that\ndir and mode are ignored (since they are not present).\n"} Import [^string path] :results [(* Package) error])))



(go/type ImportMode "ImportMode is reserved for future use.\n" int)




(go/type ImporterFrom "An ImporterFrom resolves import paths to packages; it\nsupports vendoring per https://golang.org/s/go15vendor.\nUse go/importer to obtain an ImporterFrom implementation.\n" (interface





    ^{:line 92 :doc "Importer is present for backward-compatibility. Calling\nImport(path) is the same as calling ImportFrom(path, \"\", 0);\ni.e., locally vendored packages may not be found.\nThe types package does not call Import if an ImporterFrom\nis present.\n"} Importer










    (^{:doc "ImportFrom returns the imported package for the given import\npath when imported by a package file located in dir.\nIf the import failed, besides returning an error, ImportFrom\nis encouraged to cache and return a package anyway, if one\nwas created. This will reduce package inconsistencies and\nfollow-on type checker errors due to the missing package.\nThe mode value must be 0; it is reserved for future use.\nTwo calls to ImportFrom with the same path and dir must\nreturn the same package.\n"} ImportFrom [^string path ^string dir ^ImportMode mode] :results [(* Package) error])))




(go/type Config "A Config specifies the configuration for type checking.\nThe zero value for Config is a ready-to-use default configuration.\n" (struct


    ^{:line 111 :tag (* Context) :doc "Context is the context used for resolving global identifiers. If nil, the\ntype checker will initialize this field with a newly created context.\n"} Context






    ^{:line 118 :tag string :doc "GoVersion describes the accepted Go language version. The string must\nstart with a prefix of the form \"go%d.%d\" (e.g. \"go1.20\", \"go1.21rc1\", or\n\"go1.21.0\") or it must be empty; an empty string disables Go language\nversion checks. If the format is invalid, invoking the type checker will\nresult in an error.\n"} GoVersion



    ^{:line 122 :tag bool :doc "If IgnoreFuncBodies is set, function bodies are not\ntype-checked.\n"} IgnoreFuncBodies








    ^{:line 131 :tag bool :doc "If FakeImportC is set, `import \"C\"` (for packages requiring Cgo)\ndeclares an empty \"C\" package and errors are omitted for qualified\nidentifiers referring to package C (which won't find an object).\nThis feature is intended for the standard library cmd/api tool.\n\nCaution: Effects may be unpredictable due to follow-on errors.\n         Do not use casually!\n"} FakeImportC


    ^{:line 134 :tag bool :doc "If IgnoreBranchErrors is set, branch/label errors are ignored.\n"} IgnoreBranchErrors








    ^{:line 143 :tag bool :doc "If go115UsesCgo is set, the type checker expects the\n_cgo_gotypes.go file generated by running cmd/cgo to be\nprovided as a package source file. Qualified identifiers\nreferring to package C will be resolved to cgo-provided\ndeclarations within _cgo_gotypes.go.\n\nIt is an error to set both FakeImportC and go115UsesCgo.\n"} go115UsesCgo


    ^{:line 146 :tag bool :doc "If Trace is set, a debug trace is printed to stdout.\n"} Trace








    ^{:line 155 :tag (func [^error err]) :doc "If Error != nil, it is called with each error found\nduring type checking; err has dynamic type Error.\nSecondary errors (for instance, to enumerate all types\ninvolved in an invalid recursive type declaration) have\nerror strings that start with a '\\t' character.\nIf Error == nil, type-checking stops with the first\nerror found.\n"} Error







    ^{:line 163 :tag Importer :doc "An importer is used to import packages referred to from\nimport declarations.\nIf the installed importer implements ImporterFrom, the type\nchecker calls ImportFrom instead of Import.\nThe type checker reports an error if an importer is needed\nbut none was installed.\n"} Importer



    ^{:line 167 :tag Sizes :doc "If Sizes != nil, it provides the sizing functions for package unsafe.\nOtherwise SizesFor(\"gc\", \"amd64\") is used instead.\n"} Sizes



    ^{:line 171 :tag bool :doc "If DisableUnusedImportCheck is set, packages are not checked\nfor unused imports.\n"} DisableUnusedImportCheck





    ^{:line 177 :tag string :doc "If a non-empty ErrorURL format string is provided, it is used\nto format an error URL link that is appended to the first line\nof an error message. ErrorURL must be a format string containing\nexactly one \"%s\" format, e.g. \"[go.dev/e/%s]\".\n"} ErrorURL))






(go/type Info "Info holds result type information for a type-checked package.\nOnly the information for which a map is provided is collected.\nIf the package has type errors, the collected information may\nbe incomplete.\n" (struct

























    ^{:line 210 :tag (map syntax/Expr TypeAndValue) :doc "Types maps expressions to their types, and for constant\nexpressions, also their values. Invalid expressions are\nomitted.\n\nFor (possibly parenthesized) identifiers denoting built-in\nfunctions, the recorded signatures are call-site specific:\nif the call result is not a constant, the recorded type is\nan argument-specific signature. Otherwise, the recorded type\nis invalid.\n\nThe Types map does not record the type of every identifier,\nonly those that appear where an arbitrary expression is\npermitted. For instance:\n- an identifier f in a selector expression x.f is found\n  only in the Selections map;\n- an identifier z in a variable declaration 'var z int'\n  is found only in the Defs map;\n- an identifier p denoting a package in a qualified\n  identifier p.X is found only in the Uses map.\n\nSimilarly, no type is recorded for the (synthetic) FuncType\nnode in a FuncDecl.Type field, since there is no corresponding\nsyntactic function type expression in the source in this case\nInstead, the function type is found in the Defs.map entry for\nthe corresponding function declaration.\n"} Types





    ^{:line 216 :tag bool :doc "If StoreTypesInSyntax is set, type information identical to\nthat which would be put in the Types map, will be set in\nsyntax.Expr.TypeAndValue (independently of whether Types\nis nil or not).\n"} StoreTypesInSyntax













    ^{:line 230 :tag (map (* syntax/Name) Instance) :doc "Instances maps identifiers denoting generic types or functions to their\ntype arguments and instantiated type.\n\nFor example, Instances will map the identifier for 'T' in the type\ninstantiation T[int, string] to the type arguments [int, string] and\nresulting instantiated *Named type. Given a generic function\nfunc F[A any](A), Instances will map the identifier for 'F' in the call\nexpression F(int(1)) to the inferred type arguments [int], and resulting\ninstantiated *Signature.\n\nInvariant: Instantiating Uses[id].Type() with Instances[id].TypeArgs\nresults in an equivalent of Instances[id].Type.\n"} Instances










    ^{:line 241 :tag (map (* syntax/Name) Object) :doc "Defs maps identifiers to the objects they define (including\npackage names, dots \".\" of dot-imports, and blank \"_\" identifiers).\nFor identifiers that do not denote objects (e.g., the package name\nin package clauses, or symbolic variables t in t := x.(type) of\ntype switch headers), the corresponding objects are nil.\n\nFor an embedded field, Defs returns the field *Var it defines.\n\nInvariant: Defs[id] == nil || Defs[id].Pos() == id.Pos()\n"} Defs






    ^{:line 248 :tag (map (* syntax/Name) Object) :doc "Uses maps identifiers to the objects they denote.\n\nFor an embedded field, Uses returns the *TypeName it denotes.\n\nInvariant: Uses[id].Pos() != id.Pos()\n"} Uses










    ^{:line 259 :tag (map syntax/Node Object) :doc "Implicits maps nodes to their implicitly declared objects, if any.\nThe following node and object types may appear:\n\n    node               declared object\n\n    *syntax.ImportDecl    *PkgName for imports without renames\n    *syntax.CaseClause    type-specific *Var for each type switch case clause (incl. default)\n    *syntax.Field         anonymous parameter *Var (incl. unnamed results)\n"} Implicits



    ^{:line 263 :tag (map (* syntax/SelectorExpr) (* Selection)) :doc "Selections maps selector expressions (excluding qualified identifiers)\nto their corresponding selections.\n"} Selections
































    ^{:line 296 :tag (map syntax/Node (* Scope)) :doc "Scopes maps syntax.Nodes to the scopes they define. Package scopes are not\nassociated with a specific node but with all files belonging to a package.\nThus, the package scope can be found in the type-checked Package object.\nScopes nest, with the Universe scope being the outermost scope, enclosing\nthe package scope, which contains (one or more) files scopes, which enclose\nfunction scopes which in turn enclose statement and function literal scopes.\nNote that even though package-level functions are declared in the package\nscope, the function scopes are embedded in the file scope of the file\ncontaining the function declaration.\n\nThe Scope of a function contains the declarations of any\ntype parameters, parameters, and named results, plus any\nlocal declarations in the body block.\nIt is coextensive with the complete extent of the\nfunction's syntax ([*ast.FuncDecl] or [*ast.FuncLit]).\nThe Scopes mapping does not contain an entry for the\nfunction body ([*ast.BlockStmt]); the function's scope is\nassociated with the [*ast.FuncType].\n\nThe following node types may appear in Scopes:\n\n    *syntax.File\n    *syntax.FuncType\n    *syntax.TypeDecl\n    *syntax.BlockStmt\n    *syntax.IfStmt\n    *syntax.SwitchStmt\n    *syntax.CaseClause\n    *syntax.CommClause\n    *syntax.ForStmt\n"} Scopes






    ^{:line 303 :tag (slice (* Initializer)) :doc "InitOrder is the list of package-level initializers in the order in which\nthey must be executed. Initializers referring to variables related by an\ninitialization dependency appear in topological order, the others appear\nin source order. Variables without an initialization expression do not\nappear in this list.\n"} InitOrder






    ^{:line 310 :tag (map (* syntax/PosBase) string) :doc "FileVersions maps a file to its Go version string.\nIf the file doesn't specify a version, the reported\nstring is Config.GoVersion.\nVersion strings begin with “go”, like “go1.21”, and\nare suitable for use with the [go/version] package.\n"} FileVersions))


^{:go/end 315} (go/method recordTypes ^bool [^{:tag (* Info)} info]
  (or (!= (.-Types info) nil) (.-StoreTypesInSyntax info)))





^{:go/breaks [[6 336]] :go/end 337} (go/method TypeOf "TypeOf returns the type of expression e, or nil if not found.\nPrecondition 1: the Types map is populated or StoreTypesInSyntax is set.\nPrecondition 2: Uses and Defs maps are populated.\n" ^Type [^{:tag (* Info)} info ^syntax/Expr e]
  (cond (!= (.-Types info) nil)
    (when [(values t ok) (aget (.-Types info) e)] ok
      (return (.-Type t)))

    (.-StoreTypesInSyntax info)
    (when [tv (.GetTypeInfo e)] (!= (.-Type tv) nil)
      (return (.-Type tv))))



  (when [(values id _) (assert (* syntax/Name) e)] (!= id nil)
    (when [obj (.ObjectOf info id)] (!= obj nil)
      (return (.Type obj))))


  nil)









^{:go/end 351} (go/method ObjectOf "ObjectOf returns the object denoted by the specified id,\nor nil if not found.\n\nIf id is an embedded struct field, ObjectOf returns the field (*Var)\nit defines, not the type (*TypeName) it uses.\n\nPrecondition: the Uses and Defs maps are populated.\n" ^Object [^{:tag (* Info)} info ^{:tag (* syntax/Name)} id]
  (when [obj (aget (.-Defs info) id)] (!= obj nil)
    (return obj))

  (aget (.-Uses info) id))








^{:go/end 368} (go/method PkgNameOf "PkgNameOf returns the local package name defined by the import,\nor nil if not found.\n\nFor dot-imports, the package name is \".\".\n\nPrecondition: the Defs and Implicts maps are populated.\n" ^{:tag (* PkgName)} [^{:tag (* Info)} info ^{:tag (* syntax/ImportDecl)} imp]
  (let [^Object obj (zero Object)]
    (if (!= (.-LocalPkgName imp) nil)
      (set! obj (aget (.-Defs info) (.-LocalPkgName imp)))

      (set! obj (aget (.-Implicits info) imp)))

    (let [(values pkgname _) (assert (* PkgName) obj)]
      ^{:line 367} pkgname)))





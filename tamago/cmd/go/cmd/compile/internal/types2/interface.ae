;; API


(go/type Interface "An Interface represents an interface type.\n" (struct
    ^{:line 17 :tag (* Checker)} check ; for error reporting; nil once type set is computed
    ^{:line 18 :tag (slice (* Func))} methods ; ordered list of explicitly declared methods
    ^{:line 19 :tag (slice Type)} embeddeds ; ordered list of explicitly embedded elements
    ^{:line 20 :tag (* (slice syntax/Pos))} embedPos ; positions of embedded elements; or nil (for error messages) - use pointer to save space
    ^{:line 21 :tag bool} implicit ; interface is wrapper for type set literal (non-interface T, ~T, or A|B)
    ^{:line 22 :tag bool} complete ; indicates that all fields (except for tset) are set up

    ^{:line 24 :tag (* _TypeSet)} tset)) ; type set described by this interface, computed lazily



^{:go/end 28} (go/method typeSet "typeSet returns the type set for interface t.\n" ^{:tag (* _TypeSet)} [^{:tag (* Interface)} t] (computeInterfaceTypeSet (.-check t) nopos t))


(go/var ^{:doc "emptyInterface represents the empty interface\n"} emptyInterface (lit Interface :complete true :tset (addr topTypeSet)))




^{:go/end 57} (go/func NewInterfaceType "NewInterfaceType returns a new interface for the given methods and embedded types.\nNewInterfaceType takes ownership of the provided methods and may modify their types\nby setting missing receivers.\n" ^{:tag (* Interface)} [^{:tag (slice (* Func))} methods ^{:tag (slice Type)} embeddeds]
  (when (and (== (len methods) 0) (== (len embeddeds) 0))
    (return (addr emptyInterface)))


  ;; set method receivers if necessary
  (let [typ (.newInterface (conv (* Checker) nil))]
    (range [_ m methods]
      (when [sig (assert (* Signature) ^{:go/via [object]} (.-typ m))] (== (.-recv sig) nil)
        (set! (.-recv sig) (newVar RecvVar ^{:go/via [object]} (.-pos m) ^{:go/via [object]} (.-pkg m) "" typ))))



    ;; sort for API stability
    (sortMethods methods)

    (set! (.-methods typ) methods)
    (set! (.-embeddeds typ) embeddeds)
    (set! (.-complete typ) true)

    ^{:line 56} typ))



^{:go/end 66} (go/method newInterface "check may be nil\n" ^{:tag (* Interface)} [^{:tag (* Checker)} check]
  (let [typ (addr (lit Interface :check check))]
    (when (!= check nil)
      (.needsCleanup check typ))

    ^{:line 65} typ))






^{:go/end 74} (go/method MarkImplicit "MarkImplicit marks the interface t as implicit, meaning this interface\ncorresponds to a constraint literal such as ~T or A|B without explicit\ninterface embedding. MarkImplicit should be called before any concurrent use\nof implicit interfaces.\n" [^{:tag (* Interface)} t]
  (set! (.-implicit t) true))



^{:go/end 77} (go/method NumExplicitMethods "NumExplicitMethods returns the number of explicitly declared methods of interface t.\n" ^int [^{:tag (* Interface)} t] (len (.-methods t)))



^{:go/end 81} (go/method ExplicitMethod "ExplicitMethod returns the i'th explicitly declared method of interface t for 0 <= i < t.NumExplicitMethods().\nThe methods are ordered by their unique Id.\n" ^{:tag (* Func)} [^{:tag (* Interface)} t ^int i] (aget (.-methods t) i))


^{:go/end 84} (go/method NumEmbeddeds "NumEmbeddeds returns the number of embedded types in interface t.\n" ^int [^{:tag (* Interface)} t] (len (.-embeddeds t)))


^{:go/end 87} (go/method EmbeddedType "EmbeddedType returns the i'th embedded type of interface t for 0 <= i < t.NumEmbeddeds().\n" ^Type [^{:tag (* Interface)} t ^int i] (aget (.-embeddeds t) i))


^{:go/end 90} (go/method NumMethods "NumMethods returns the total number of methods of interface t.\n" ^int [^{:tag (* Interface)} t] (.NumMethods (.typeSet t)))



^{:go/end 94} (go/method Method "Method returns the i'th method of interface t for 0 <= i < t.NumMethods().\nThe methods are ordered by their unique Id.\n" ^{:tag (* Func)} [^{:tag (* Interface)} t ^int i] (.Method (.typeSet t) i))


^{:go/end 97} (go/method Empty "Empty reports whether t is the empty interface.\n" ^bool [^{:tag (* Interface)} t] (.IsAll (.typeSet t)))


^{:go/end 100} (go/method IsComparable "IsComparable reports whether each type in interface t's type set is comparable.\n" ^bool [^{:tag (* Interface)} t] (.IsComparable (.typeSet t) nil))


^{:go/end 103} (go/method IsMethodSet "IsMethodSet reports whether the interface t is fully described by its method set.\n" ^bool [^{:tag (* Interface)} t] (.IsMethodSet (.typeSet t)))


^{:go/end 106} (go/method IsImplicit "IsImplicit reports whether the interface t is a wrapper for a type set literal.\n" ^bool [^{:tag (* Interface)} t] (.-implicit t))

^{:go/end 108} (go/method Underlying ^Type [^{:tag (* Interface)} t] t)

;; Implementation

^{:go/end 118} (go/method cleanup [^{:tag (* Interface)} t]
  (.typeSet t) ; any interface that escapes type checking must be safe for concurrent use
  (set! (.-check t) nil)
  (set! (.-embedPos t) nil))


^{:go/end 186} (go/method interfaceType [^{:tag (* Checker)} check ^{:tag (* Interface)} ityp ^{:tag (* syntax/InterfaceType)} iface ^{:tag (* TypeName)} def]
  (let [addEmbedded ^{:go/end 127} (fn [^syntax/Pos pos ^Type typ]
        (set! (.-embeddeds ityp) (append (.-embeddeds ityp) typ))
        (when (== (.-embedPos ityp) nil)
          (set! (.-embedPos ityp) (new (slice syntax/Pos))))

        (set! @(.-embedPos ityp) (append @(.-embedPos ityp) pos)))]


    (range [_ f (.-MethodList iface)]
      (when (== (.-Name f) nil)
        (addEmbedded (atPos (.-Type f)) (parseUnion check (.-Type f)))
        (continue))

      ;; f.Name != nil

      ;; We have a method with name f.Name.
      (let [name (.-Value (.-Name f))]
        (when (== name "_")
          (.error check (.-Name f) BlankIfaceMethod "methods must have a unique non-blank name")
          (continue)) ; ignore


        (let [typ (.typ check (.-Type f))
            (values sig _) (assert (* Signature) typ)]
          (when (== sig nil)
            (when (isValid typ)
              (.errorf check (.-Type f) InvalidSyntaxTree "%s is not a method signature" typ))

            (continue)) ; ignore


          ;; use named receiver type if available (for better error messages)
          (let [^Type recvTyp ityp]
            (when (!= def nil)
              (when [named (asNamed ^{:go/via [object]} (.-typ def))] (!= named nil)
                (set! recvTyp named)))


            (set! (.-recv sig) (newVar RecvVar ^{:go/via [expr node]} (.Pos (.-Name f)) (.-pkg check) "" recvTyp))

            (let [m (NewFunc ^{:go/via [expr node]} (.Pos (.-Name f)) (.-pkg check) name sig)]
              (.recordDef check (.-Name f) m)
              (set! (.-methods ityp) (append (.-methods ityp) m)))))))


    ;; All methods and embedded elements for this interface are collected;
    ;; i.e., this interface may be used in a type set computation.
    (set! (.-complete ityp) true)

    (when (and (== (len (.-methods ityp)) 0) (== (len (.-embeddeds ityp)) 0))
      ;; empty interface
      (set! (.-tset ityp) (addr topTypeSet))
      (return))


    ;; sort for API stability
    ;; (don't sort embeddeds: they must correspond to *embedPos entries)
    (sortMethods (.-methods ityp))

    ;; Compute type set as soon as possible to report any errors.
    ;; Subsequent uses of type sets will use this computed type
    ;; set and won't need to pass in a *Checker.
    (.describef (.later check ^{:go/end 185} (fn []
          (computeInterfaceTypeSet check ^{:go/via [expr node]} (.Pos iface) ityp)))
      ^{:line 185} iface "compute type set for %s" ityp)))

;; This file implements exported type predicates.

(in-ns 'go.cmd.compile.internal.types2) (go/file "api_predicates.go" :imports [])








^{:go/end 23} (go/func AssertableTo "AssertableTo reports whether a value of type V can be asserted to have type T.\n\nThe behavior of AssertableTo is unspecified in three cases:\n  - if T is Typ[Invalid]\n  - if V is a generalized interface; i.e., an interface that may only be used\n    as a type constraint in Go code\n  - if T is an uninstantiated generic type\n" ^bool [^{:tag (* Interface)} V ^Type T]
  ;; Checker.newAssertableTo suppresses errors for invalid types, so we need special
  ;; handling here.
  (when (not (isValid (.Underlying T)))
    (return false))

  (.newAssertableTo (conv (* Checker) nil) V T nil))







^{:go/end 34} (go/func AssignableTo "AssignableTo reports whether a value of type V is assignable to a variable\nof type T.\n\nThe behavior of AssignableTo is unspecified if V or T is Typ[Invalid] or an\nuninstantiated generic type.\n" ^bool [^Type V ^Type T]
  (let [x (lit operand :mode_ value :typ_ V)
      (values ok _) (.assignableTo x nil T nil)] ; check not needed for non-constant x
    ^{:line 33} ok))







^{:go/end 44} (go/func ConvertibleTo "ConvertibleTo reports whether a value of type V is convertible to a value of\ntype T.\n\nThe behavior of ConvertibleTo is unspecified if V or T is Typ[Invalid] or an\nuninstantiated generic type.\n" ^bool [^Type V ^Type T]
  (let [x (lit operand :mode_ value :typ_ V)]
    (.convertibleTo x nil T nil))) ; check not needed for non-constant x






^{:go/end 61} (go/func Implements "Implements reports whether type V implements interface T.\n\nThe behavior of Implements is unspecified if V is Typ[Invalid] or an uninstantiated\ngeneric type.\n" ^bool [^Type V ^{:tag (* Interface)} T]
  (when (.Empty T)
    ;; All types (even Typ[Invalid]) implement the empty interface.
    (return true))

  ;; Checker.implements suppresses errors for invalid types, so we need special
  ;; handling here.
  (when (not (isValid (.Underlying V)))
    (return false))

  (.implements (conv (* Checker) nil) V T false nil))






^{:go/end 69} (go/func Satisfies "Satisfies reports whether type V satisfies the constraint T.\n\nThe behavior of Satisfies is unspecified if V is Typ[Invalid] or an uninstantiated\ngeneric type.\n" ^bool [^Type V ^{:tag (* Interface)} T]
  (.implements (conv (* Checker) nil) V T true nil))
















^{:go/end 88} (go/func Identical "Identical reports whether x and y are identical types.\nReceivers of [Signature] types are ignored.\n\nPredicates such as [Identical], [Implements], and\n[Satisfies] assume that both operands belong to a\nconsistent collection of symbols ([Object] values).\nFor example, two [Named] types can be identical only if their\n[Named.Obj] methods return the same [TypeName] symbol.\nA collection of symbols is consistent if, for each logical\npackage whose path is P, the creation of those symbols\ninvolved at most one call to [NewPackage](P, ...).\nTo ensure consistency, use a single [Importer] for\nall loaded packages and their dependencies.\nFor more information, see https://github.com/golang/go/issues/57497.\n" ^bool [^Type x ^Type y]
  (let [^comparer c (zero comparer)]
    (.identical c x y nil)))




^{:go/end 96} (go/func IdenticalIgnoreTags "IdenticalIgnoreTags reports whether x and y are identical types if tags are ignored.\nReceivers of [Signature] types are ignored.\n" ^bool [^Type x ^Type y]
  (let [^comparer c (zero comparer)]
    (set! (.-ignoreTags c) true)
    (.identical c x y nil)))

^{:go/end 50} (go/method RenameResult "RenameResult takes an array of (result) fields and an index, and if the indexed field\ndoes not have a name and if the result in the signature also does not have a name,\nthen the signature and field are renamed to\n\n\tfmt.Sprintf(\"#rv%d\", i+1)\n\nthe newly named object is inserted into the signature's scope,\nand the object and new field name are returned.\n\nThe intended use for RenameResult is to allow rangefunc to assign results within a closure.\nThis is a hack, as narrowly targeted as possible to discourage abuse.\n" [^{:tag (* Signature)} s ^{:tag (slice (* syntax/Field))} results ^int i] :results [(* Var) (* syntax/Name)]
  (let [a (aget results i)
      ^{:line 27} obj (.At (.Results s) i)]

    (when (not (or (== ^{:go/via [object]} (.-name obj) "") (and (== ^{:go/via [object]} (.-name obj) "_") (== (.-Name a) nil)) (== (.-Value (.-Name a)) "_")))
      (panic "Cannot change an existing name"))


    (let [pos ^{:go/via [node]} (.Pos a)
        ^{:line 34} typ (.-Type (.GetTypeInfo (.-Type a)))

        ^{:line 36} name (fmt/Sprintf "#rv%d" (+ i 1))]
      (set! ^{:go/via [object]} (.-name obj) name)
      (.Insert (.-scope s) obj)
      ^{:go/via [object]} (.setScopePos obj pos)

      (let [tv (lit syntax/TypeAndValue :Type typ)]
        ^{:go/via [exprFlags]} (.SetIsValue tv)

        (let [n (syntax/NewName pos ^{:go/via [object]} (.Name obj))]
          ^{:go/via [expr typeAndValue]} (.SetTypeInfo n tv)

          (set! (.-Name a) n)

          (return obj n))))))




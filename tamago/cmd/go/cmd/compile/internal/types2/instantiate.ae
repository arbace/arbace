^{:go/breaks [[5 404]] :go/end 405} (go/func mentions "mentions reports whether type T \"mentions\" typ in an (embedded) element or term\nof T (whether typ is in the type set of T or not). For better error messages.\n" ^bool [^Type T ^Type typ]
  (type-switch [T T]
    (case [(* Interface)]
      (range [_ e (.-embeddeds T)]
        (when (mentions e typ)
          (return true))))


    (case [(* Union)]
      (range [_ t (.-terms T)]
        (when (mentions (.-typ t) typ)
          (return true))))


    (default
      (when (Identical T typ)
        (return true))))


  false)

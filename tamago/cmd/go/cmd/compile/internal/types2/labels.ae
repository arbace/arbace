        (if [alt (.Lookup all name)] (!= alt nil) (do
            (set! msg "goto %s jumps into block")
            (set! code JumpIntoBlock)
            (set! (.-used (assert (* Label) alt)) true)) ; avoid another error
          (do
            (set! msg "label %s not declared")
            (set! code UndeclaredLabel)))

        (.errorf check (.-Label jmp) code msg name)))



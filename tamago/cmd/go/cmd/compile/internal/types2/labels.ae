    ^{:line 52 :tag (map string (* syntax/LabeledStmt))} labels)) ; allocated lazily




^{:go/end 68} (go/method insert "insert records a new label declaration for the current block.\nThe label must not have been declared before in any block.\n" [^{:tag (* block)} b ^{:tag (* syntax/LabeledStmt)} s]
  (let [name (.-Value (.-Label s))]
    (when debug
      (go/call assert (== (.gotoTarget b name) nil)))

    (let [labels (.-labels b)]
      (when (== labels nil)
        (set! labels (make (map string (* syntax/LabeledStmt))))
        (set! (.-labels b) labels))

      (aset labels name s))))




^{:go/breaks [[5 78]] :go/end 79} (go/method gotoTarget "gotoTarget returns the labeled statement in the current\nor an enclosing block with the given label name, or nil.\n" ^{:tag (* syntax/LabeledStmt)} [^{:tag (* block)} b ^string name]
  (for [s b] (!= s nil) (set! s (.-parent s))
    (when [t (aget (.-labels s) name)] (!= t nil)
      (return t)))


  nil)




^{:go/breaks [[5 89]] :go/end 90} (go/method enclosingTarget "enclosingTarget returns the innermost enclosing labeled\nstatement with the given label name, or nil.\n" ^{:tag (* syntax/LabeledStmt)} [^{:tag (* block)} b ^string name]

;; This file implements objsets.
;;
;; An objset is similar to a Scope but objset elements
;; are identified by their unique id, instead of their
;; object name.

(in-ns 'go.cmd.compile.internal.types2) (go/file "objset.go" :imports [])



(go/type objset "An objset is a set of objects identified by their unique id.\nThe zero value for objset is a ready-to-use empty objset.\n" (map string Object)) ; initialized lazily





^{:go/end 31} (go/method insert "insert attempts to insert an object obj into objset s.\nIf s already contains an alternative object alt with\nthe same name, insert leaves s unchanged and returns alt.\nOtherwise it inserts obj and returns nil.\n" ^Object [^{:tag (* objset)} s ^Object obj]
  ^{:go/breaks [5]} (let [id (.Id obj)]
    (when [alt (aget @s id)] (!= alt nil)
      (return alt))

    (when (== @s nil)
      (set! @s (make (map string Object))))

    (aset @s id obj)
    nil))

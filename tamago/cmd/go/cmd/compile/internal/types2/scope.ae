^{:go/end 105} (go/method Insert "Insert attempts to insert an object obj into scope s.\nIf s already contains an alternative object alt with\nthe same name, Insert leaves s unchanged and returns alt.\nOtherwise it inserts obj, sets the object's parent scope\nif not already set, and returns nil.\n" ^Object [^{:tag (* Scope)} s ^Object obj]
  ^{:go/breaks [[5 104]]} (let [name (.Name obj)]
    (when [alt (.Lookup s name)] (!= alt nil)
      (return alt))

    (.insert s name obj)
    ;; TODO(gri) Can we always set the parent to s (or is there
    ;; a need to keep the original parent or some race condition)?
    ;; If we can, than we may not need environment.lookupScope
    ;; which is only there so that we get the correct scope for
    ;; marking "used" dot-imported packages.
    (when (== (.Parent obj) nil)
      (.setParent obj s))

    nil))









^{:go/breaks [6] :go/end 120} (go/method InsertLazy "InsertLazy is like Insert, but allows deferring construction of the\ninserted object until it's accessed with Lookup. The Object\nreturned by resolve must have the same name as given to InsertLazy.\nIf s already contains an alternative object with the same name,\nInsertLazy leaves s unchanged and returns false. Otherwise it\nrecords the binding and returns true. The object's parent scope\nwill be set to s after resolve is called.\n" ^bool [^{:tag (* Scope)} s ^string name ^{:tag (func [] [Object])} resolve]
  (when (!= (aget (.-elems s) name) nil)
    (return false))

  (.insert s name (addr (lit lazyObject :parent s :resolve resolve)))
  true)


^{:go/end 127} (go/method insert [^{:tag (* Scope)} s ^string name ^Object obj]
  (when (== (.-elems s) nil)
    (set! (.-elems s) (make (map string Object))))

  (aset (.-elems s) name obj))







^{:go/end 152} (go/method WriteTo "WriteTo writes a string representation of the scope to w,\nwith the scope elements sorted by name.\nThe level of indentation is controlled by n >= 0, with\nn == 0 for no indentation.\nIf recurse is set, it also writes nested (children) scopes.\n" [^{:tag (* Scope)} s ^io/Writer w ^int n ^bool recurse]
  (let [^:const ^{:val ".  "} ind ".  "
      ^{:line 136} indn (strings/Repeat ind n)]

    (fmt/Fprintf w "%s%s scope %p {\n" indn (.-comment s) s)

    (let [indn1 (+ indn ind)]
      (range [_ name (.Names s)]
        (fmt/Fprintf w "%s%s\n" indn1 (.Lookup s name)))


      (when recurse
        (range [_ s (.-children s)]
          (.WriteTo s w (+ n 1) recurse)))



      (fmt/Fprintf w "%s}\n" indn))))



^{:go/end 159} (go/method String "String returns a string representation of the scope, for debugging.\n" ^string [^{:tag (* Scope)} s]
  (let [^strings/Builder buf (zero strings/Builder)]
    (.WriteTo s (addr buf) 0 false)
    (.String buf)))





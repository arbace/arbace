^{:go/end 193} (go/func resolve "resolve returns the Object represented by obj, resolving lazy\nobjects as appropriate.\n" ^Object [^string name ^Object obj]
  (when [(values lazy ok) (assert (* lazyObject) obj)] ok
    (.Do (.-once lazy) ^{:go/end 188} (fn []
        (let [obj ((.-resolve lazy))]

          (when [(values _ ok) (assert (* lazyObject) obj)] ok
            (panic "recursive lazy object"))

          (when (!= (.Name obj) name)
            (panic "lazy object has unexpected name"))


          (when (== (.Parent obj) nil)
            (.setParent obj (.-parent lazy)))

          (set! (.-obj lazy) obj))))


    (set! obj (.-obj lazy)))

  ^{:line 192} obj)





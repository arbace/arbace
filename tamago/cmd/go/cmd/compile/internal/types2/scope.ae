^{:go/end 83} (go/method lookupIgnoringCase "lookupIgnoringCase returns the objects in scope s whose names match\nthe given name ignoring case. If exported is set, only exported names\nare returned.\n" ^{:tag (slice Object)} [^{:tag (* Scope)} s ^string name ^bool exported]

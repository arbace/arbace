    (for [i top] (< i (len (.-delayed check))) (inc! i)
      (let [a (addr (aget (.-delayed check) i))]
        (when (.-Trace (.-conf check))
          (if (!= (.-desc a) nil)
            (.trace check (.Pos (.-pos (.-desc a))) (+ "-- " (.-format (.-desc a))) (spread (.-args (.-desc a))))

            (.trace check nopos "-- delayed %p" (.-f a))))


        (set! ^{:go/via [environment]} (.-version check) (.-version a)) ; reestablish the effective Go version captured earlier
        ((.-f a)) ; may append to check.delayed
        (when (.-Trace (.-conf check))
          (fmt/Println))))


    (go/call assert (<= top (len (.-delayed check)))) ; stack must not have shrunk
    (set! (.-delayed check) (subslice (.-delayed check) _ top))
    (set! ^{:go/via [environment]} (.-version check) savedVersion)))




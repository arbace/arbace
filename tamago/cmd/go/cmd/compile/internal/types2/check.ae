^{:go/end 177} (go/method addDeclDep "addDeclDep adds the dependency edge (check.decl -> to) if check.decl exists\n" [^{:tag (* Checker)} check ^Object to]
  (let [from ^{:go/via [environment]} (.-decl check)]
    (when (== from nil)
      (return)) ; not in a package-level init expression

    (when [(values _ found) (aget (.-objMap check) to)] (not found)
      (return)) ; to is not a package-level object

    (.addDep from to)))



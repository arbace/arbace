      (when (.IsType tv)
        ^{:go/via [exprFlags]} (.SetIsType stv))

      (when (.IsBuiltin tv)
        ^{:go/via [exprFlags]} (.SetIsBuiltin stv))

      (when (.IsValue tv)
        ^{:go/via [exprFlags]} (.SetIsValue stv))

      (when (.IsNil tv)
        ^{:go/via [exprFlags]} (.SetIsNil stv))

      (when (.Addressable tv)
        ^{:go/via [exprFlags]} (.SetAddressable stv))

      (when (.Assignable tv)
        ^{:go/via [exprFlags]} (.SetAssignable stv))

      (when (.HasOk tv)

    (go/call print "== directCycles ==")
    (.directCycles check)

    (go/call print "== packageObjects ==")
    (.packageObjects check)

    (go/call print "== processDelayed ==")
    (.processDelayed check 0) ; incl. all functions

    (go/call print "== cleanup ==")
    (.cleanup check)

    (go/call print "== initOrder ==")
    (.initOrder check)


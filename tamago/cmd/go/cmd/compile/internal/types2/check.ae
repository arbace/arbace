^{:go/end 257} (go/func NewChecker "NewChecker returns a new Checker instance for a given package.\nPackage files may be added incrementally via checker.Files.\n" ^{:tag (* Checker)} [^{:tag (* Config)} conf ^{:tag (* Package)} pkg ^{:tag (* Info)} info]
  ;; make sure we have a configuration
  (when (== conf nil)
    (set! conf (new Config)))


  ;; make sure we have an info struct
  (when (== info nil)
    (set! info (new Info)))


  ;; Note: clients may call NewChecker with the Unsafe package, which is
  ;; globally shared and must not be mutated. Therefore NewChecker must not
  ;; mutate *pkg.
  ;;
  ;; (previously, pkg.goVersion was mutated here: go.dev/issue/61212)

  (addr ^{:go/breaks [2 4 6 8 10 12 14 16]} (lit Checker
      :conf conf
      :ctxt (.-Context conf)
      :pkg pkg
      :Info info
      :objMap (make (map Object (* declInfo)))
      :impMap (make (map importKey (* Package)))
      :usedVars (make (map (* Var) bool))
      :usedPkgNames (make (map (* PkgName) bool)))))





^{:go/end 349} (go/method initFiles "initFiles initializes the files-specific portion of checker.\nThe provided files must all belong to the same package.\n" [^{:tag (* Checker)} check ^{:tag (slice (* syntax/File))} files]
  ;; start with a clean slate (check.Files may be called multiple times)
  ;; TODO(gri): what determines which fields are zeroed out here, vs at the end
  ;; of checkFiles?
  (set! (.-files check) nil)
  (set! (.-imports check) nil)
  (set! (.-dotImportMap check) nil)

  (set! (.-firstErr check) nil)
  (set! (.-methods check) nil)
  (set! (.-untyped check) nil)
  (set! (.-delayed check) nil)
  (set! (.-objPath check) nil)
  (set! (.-objPathIdx check) nil)
  (set! (.-cleaners check) nil)

  ;; We must initialize usedVars and usedPkgNames both here and in NewChecker,
  ;; because initFiles is not called in the CheckExpr or Eval codepaths, yet we
  ;; want to free this memory at the end of Files ('used' predicates are
  ;; only needed in the context of a given file).
  (set! (.-usedVars check) (make (map (* Var) bool)))
  (set! (.-usedPkgNames check) (make (map (* PkgName) bool)))

  ;; determine package name and collect valid files
  (let [pkg (.-pkg check)]
    (range [_ file files]
      (switch [name (.-Value (.-PkgName file))] (.-name pkg)
        (case [""]
          (if (!= name "_")
            (set! (.-name pkg) name)

            (.error check (.-PkgName file) BlankPkgName "invalid package name _"))

          (fallthrough))

        (case [name]
          (set! (.-files check) (append (.-files check) file)))

        (default
          (.errorf check file MismatchedPkgName "package %s; expected package %s" name (.-name pkg)))))
    ;; ignore this file



    ;; reuse Info.FileVersions if provided
    (let [versions (.-FileVersions (.-Info check))]
      (when (== versions nil)
        (set! versions (make (map (* syntax/PosBase) string))))

      (set! (.-versions check) versions)

      (let [pkgVersion (asGoVersion (.-GoVersion (.-conf check)))]
        (when (and (.isValid pkgVersion) (> (len files) 0) (> (.cmp pkgVersion go_current) 0))
          (.errorf check (aget files 0) TooNew "package requires newer Go version %v (application built with %v)"
            ^{:line 315} pkgVersion go_current))


        ;; determine Go version for each file
        (range [_ file (.-files check)]
          ;; use unaltered Config.GoVersion by default
          ;; (This version string may contain dot-release numbers as in go1.20.1,
          ;; unlike file versions which are Go language versions only, if valid.)
          (let [v (.-GoVersion (.-conf check))]

            ;; If the file specifies a version, use max(fileVersion, go1.21).
            (when [fileVersion (asGoVersion (.-GoVersion file))] (.isValid fileVersion)
              ;; Go 1.21 introduced the feature of allowing //go:build lines
              ;; to sometimes set the Go version in a given file. Versions Go 1.21 and later
              ;; can be set backwards compatibly as that was the first version
              ;; files with go1.21 or later build tags could be built with.
              ;;
              ;; Set the version to max(fileVersion, go1.21): That will allow a
              ;; downgrade to a version before go1.22, where the for loop semantics
              ;; change was made, while being backwards compatible with versions of
              ;; go before the new //go:build semantics were introduced.
              (set! v (conv string (versionMax fileVersion go1_21)))

              ;; Report a specific error for each tagged file that's too new.
              ;; (Normally the build system will have filtered files by version,
              ;; but clients can present arbitrary files to the type checker.)
              (when (> (.cmp fileVersion go_current) 0)
                ;; Use position of 'package [p]' for types/types2 consistency.
                ;; (Ideally we would use the //build tag itself.)
                (.errorf check (.-PkgName file) TooNew "file requires newer Go version %v" fileVersion)))


            (aset versions (.FileBase ^{:go/via [node]} (.Pos file)) v))))))) ; file.Pos().FileBase() may be nil for tests




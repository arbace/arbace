(go/type bailout "A bailout panic is used for early termination.\n" (struct))

^{:go/end 398} (go/method handleBailout [^{:tag (* Checker)} check ^{:tag (* error)} err]
  (type-switch [p (recover)]
    (case [nil bailout]
      ;; normal return or early exit
      (set! @err (.-firstErr check)))
    (default
      (when (> (len (.-posStack check)) 0)
        (let [doPrint ^{:go/end 382} (fn [^{:tag (slice syntax/Pos)} ps]
              (for [i (- (len ps) 1)] (>= i 0) (dec! i)
                (fmt/Fprintf os/Stderr "\t%v\n" (aget ps i))))]



          (fmt/Fprintln os/Stderr "The following panic happened checking types near:")
          (if (<= (len (.-posStack check)) 10)
            (doPrint (.-posStack check))
            (do
              ;; if it's long, truncate the middle; it's least likely to help
              (doPrint (subslice (.-posStack check) (- (len (.-posStack check)) 5)))
              (fmt/Fprintln os/Stderr "\t...")
              (doPrint (subslice (.-posStack check) _ 5))))))



      ;; re-panic
      (panic p))))




^{:go/end 416} (go/method Files "Files checks the provided files as part of the checker's package.\n" [^{:tag (* Checker)} check ^{:tag (slice (* syntax/File))} files] :results [^error err]
  (when (== (.-pkg check) Unsafe)
    ;; Defensive handling for Unsafe, which cannot be type checked, and must
    ;; not be mutated. See https://go.dev/issue/61212 for an example of where
    ;; Unsafe is passed to NewChecker.
    (return nil))


  ;; Avoid early returns here! Nearly all errors can be
  ;; localized to a piece of syntax and needn't prevent
  ;; type-checking of the rest of the package.

  (defer (.handleBailout check (addr err)))
  (.checkFiles check files)
  (return))







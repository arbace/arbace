^{:go/end 115} (go/method assignment "assignment reports whether x can be assigned to a variable of type T,\nif necessary by attempting to convert untyped values to the appropriate\ntype. context describes the context in which the assignment takes place.\nUse T == nil to indicate assignment to an untyped blank identifier.\nIf the assignment check fails, x.mode is set to invalid.\n" [^{:tag (* Checker)} check ^{:tag (* operand)} x ^Type T ^string context]
  (.singleValue check x)

  (switch (.mode x)
    (case [invalid]
      (return)) ; error reported before
    (case [nilvalue]
      (go/call assert isTypes2))
    ;; ok
    (case [constant_ variable mapindex value commaok commaerr])

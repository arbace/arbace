(in-ns 'go.cmd.compile.internal.types2) (go/file "slice.go" :imports [])


(go/type Slice "A Slice represents a slice type.\n" (struct
    ^{:line 9 :tag Type} elem))



^{:go/end 13} (go/func NewSlice "NewSlice returns a new slice type for the given element type.\n" ^{:tag (* Slice)} [^Type elem] (addr (lit Slice :elem elem)))


^{:go/end 16} (go/method Elem "Elem returns the element type of slice s.\n" ^Type [^{:tag (* Slice)} s] (.-elem s))

^{:go/end 18} (go/method Underlying ^Type [^{:tag (* Slice)} s] s)
^{:go/end 19} (go/method String ^string [^{:tag (* Slice)} s] (TypeString s nil))

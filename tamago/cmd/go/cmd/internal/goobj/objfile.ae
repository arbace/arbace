^{:go/end 245} (go/method Read ^error [^{:tag (* Header)} h ^{:tag (* Reader)} r]
  (let [b (.BytesAt r 0 (len Magic))]
    (set! (.-Magic h) (conv string b))
    (when (!= (.-Magic h) Magic)
      (return (errors/New "wrong magic, not a Go object file")))

    ^{:go/breaks [[7 244]]} (let [off (conv uint32 (len (.-Magic h)))]
      (copy (subslice (.-Fingerprint h)) (.BytesAt r off (len (.-Fingerprint h))))
      (set! off + 8)
      (set! (.-Flags h) (.uint32At r off))
      (set! off + 4)
      (range [i (.-Offsets h)]
        (aset (.-Offsets h) i (.uint32At r off))
        (set! off + 4))

      nil)))



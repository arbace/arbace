(in-ns 'go.cmd.internal.goobj) (go/file "builtin.go" :imports [

    ^{:line 7} [buildcfg "internal/buildcfg"]])

;; Builtin (compiler-generated) function references appear
;; frequently. We assign special indices for them, so they
;; don't need to be referenced by name.



^{:go/end 17} (go/func NBuiltin "NBuiltin returns the number of listed builtin\nsymbols.\n" ^int []
  (len builtins))




^{:go/end 23} (go/func BuiltinName "BuiltinName returns the name and ABI of the i-th\nbuiltin symbol.\n" [^int i] :results [string int]
  (return (.-name (aget builtins i)) (.-abi (aget builtins i))))




^{:go/end 36} (go/func BuiltinIdx "BuiltinIdx returns the index of the builtin with the\ngiven name and abi, or -1 if it is not a builtin.\n" ^int [^string name ^int abi]
  (let [(values i ok) (aget builtinMap name)]
    (when (not ok)
      (return -1))

    (when (and ^{:go/via [Flags]} (.-RegabiWrappers buildcfg/Experiment) (!= (.-abi (aget builtins i)) abi))
      (return -1))

    ^{:line 35} i))


(go/directive "//go:generate go run mkbuiltin.go")

(go/var ^{:tag (map string int)} builtinMap)

^{:go/end 47} (go/func init []
  (set! builtinMap (make (map string int) (len builtins)))
  (range [i b builtins]
    (aset builtinMap (.-name b) i)))

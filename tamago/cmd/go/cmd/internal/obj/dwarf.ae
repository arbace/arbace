(go/const "Generate a sequence of opcodes that is as short as possible.\nSee section 6.2.5\n"
  ^{:line 22} [^{:val -4} LINE_BASE -4]
  ^{:line 23} [^{:val 10} LINE_RANGE 10]
  ^{:line 24} [^{:val 24} PC_RANGE (/ (- 255 OPCODE_BASE) LINE_RANGE)]
  ^{:line 25} [^{:val 11} OPCODE_BASE 11])










^{:go/end 113} (go/method generateDebugLinesSymbol "generateDebugLinesSymbol fills the debug lines symbol of a given function.\n\nIt's worth noting that this function doesn't generate the full debug_lines\nDWARF section, saving that for the linker. This function just generates the\nstate machine part of debug_lines. The full table is generated by the\nlinker.  Also, we use the file numbers from the full package (not just the\nfunction in question) when generating the state machine. We do this so we\ndon't have to do a fixup on the indices when writing the full section.\n" [^{:tag (* Link)} ctxt ^{:tag (* LSym)} s ^{:tag (* LSym)} lines]
  (let [dctxt (lit dwCtxt ctxt)]

    ;; Emit a LNE_set_address extended opcode, so as to establish the
    ;; starting text address of this function.
    (.AddUint8 dctxt lines 0)
    (dwarf/Uleb128put dctxt lines (+ 1 (conv int64 ^{:go/via [Arch]} (.-PtrSize (.-Arch ctxt)))))
    (.AddUint8 dctxt lines dwarf/DW_LNE_set_address)
    (.AddAddress dctxt lines s 0)

    ;; Set up the debug_lines state machine to the default values
    ;; we expect at the start of a new sequence.
    (let [stmt true
        ^{:line 49} line (conv int64 1)
        ^{:line 50} pc (.-Pc (.-Text (.Func s)))
        ^{:line 51 :tag int64} lastpc (zero int64) ; last PC written to line table, not last PC in func
        ^{:line 52} fileIndex 1
        (values prologue wrotePrologue) (values false false)]
      ;; Walk the progs, generating the DWARF table.
      (for [p (.-Text (.Func s))] (!= p nil) (set! p (.-Link p))
        (set! prologue (or prologue ^:go/paren (== ^{:go/via [lico]} (.Xlogue (.-Pos p)) src/PosPrologueEnd)))
        ;; If we're not at a real instruction, keep looping!
        (when (or (== ^{:go/via [lico]} (.Line (.-Pos p)) 0) ^:go/paren (and (!= (.-Link p) nil) (== (.-Pc (.-Link p)) (.-Pc p))))
          (continue))

        (let [newStmt (!= ^{:go/via [lico]} (.IsStmt (.-Pos p)) src/PosNotStmt)
            (values newFileIndex newLine) (.getFileIndexAndLine ctxt (.-Pos p))]
          (inc! newFileIndex) ; 1 indexing for the table

          ;; Output debug info.
          (let [wrote false]
            (when (!= newFileIndex fileIndex)
              (.AddUint8 dctxt lines dwarf/DW_LNS_set_file)
              (dwarf/Uleb128put dctxt lines (conv int64 newFileIndex))
              (set! fileIndex newFileIndex)
              (set! wrote true))

            (when (and prologue (not wrotePrologue))
              (.AddUint8 dctxt lines (conv uint8 dwarf/DW_LNS_set_prologue_end))
              (set! wrotePrologue true)
              (set! wrote true))

            (when (!= stmt newStmt)
              (.AddUint8 dctxt lines (conv uint8 dwarf/DW_LNS_negate_stmt))
              (set! stmt newStmt)
              (set! wrote true))


            (when (or (!= line (conv int64 newLine)) wrote)
              (let [pcdelta (- (.-Pc p) pc)]
                (set! lastpc (.-Pc p))
                (putpclcdelta ctxt dctxt lines (conv uint64 pcdelta) (- (conv int64 newLine) line))
                (set! (values line pc) (values (conv int64 newLine) (.-Pc p))))))))



      ;; Because these symbols will be concatenated together by the
      ;; linker, we need to reset the state machine that controls the
      ;; debug symbols. Do this using an end-of-sequence operator.
      ;;
      ;; Note: at one point in time, Delve did not support multiple end
      ;; sequence ops within a compilation unit (bug for this:
      ;; https://github.com/go-delve/delve/issues/1694), however the bug
      ;; has since been fixed (Oct 2019).
      ;;
      ;; Issue 38192: the DWARF standard specifies that when you issue
      ;; an end-sequence op, the PC value should be one past the last
      ;; text address in the translation unit, so apply a delta to the
      ;; text address before the end sequence op. If this isn't done,
      ;; GDB will assign a line number of zero the last row in the line
      ;; table, which we don't want.
      (let [lastlen (conv uint64 (- (.-Size s) (- lastpc (.-Pc (.-Text (.Func s))))))]
        (.AddUint8 dctxt lines dwarf/DW_LNS_advance_pc)
        (dwarf/Uleb128put dctxt lines (conv int64 lastlen))
        (.AddUint8 dctxt lines 0) ; start extended opcode
        (dwarf/Uleb128put dctxt lines 1)
        (.AddUint8 dctxt lines dwarf/DW_LNE_end_sequence)))))


^{:go/end 203} (go/func putpclcdelta [^{:tag (* Link)} linkctxt ^dwCtxt dctxt ^{:tag (* LSym)} s ^uint64 deltaPC ^int64 deltaLC]
  ;; Choose a special opcode that minimizes the number of bytes needed to
  ;; encode the remaining PC delta and LC delta.
  (let [^int64 opcode (zero int64)]
    (cond (< deltaLC LINE_BASE)
      (if (>= deltaPC PC_RANGE)
        (set! opcode (+ OPCODE_BASE (* LINE_RANGE PC_RANGE)))

        (set! opcode (+ OPCODE_BASE (* LINE_RANGE (conv int64 deltaPC)))))

      (< deltaLC (+ LINE_BASE LINE_RANGE))
      (if (>= deltaPC PC_RANGE) (do
          (set! opcode (+ OPCODE_BASE (- deltaLC LINE_BASE) (* LINE_RANGE PC_RANGE)))
          (when (> opcode 255)
            (set! opcode - LINE_RANGE)))


        (set! opcode (+ OPCODE_BASE (- deltaLC LINE_BASE) (* LINE_RANGE (conv int64 deltaPC))))) :else

      (do
        (if (<= deltaPC PC_RANGE) (do
            (set! opcode (+ OPCODE_BASE (- LINE_RANGE 1) (* LINE_RANGE (conv int64 deltaPC))))
            (when (> opcode 255)
              (set! opcode 255)))


          ;; Use opcode 249 (pc+=23, lc+=5) or 255 (pc+=24, lc+=1).
          ;;
          ;; Let x=deltaPC-PC_RANGE.  If we use opcode 255, x will be the remaining
          ;; deltaPC that we need to encode separately before emitting 255.  If we
          ;; use opcode 249, we will need to encode x+1.  If x+1 takes one more
          ;; byte to encode than x, then we use opcode 255.
          ;;
          ;; In all other cases x and x+1 take the same number of bytes to encode,
          ;; so we use opcode 249, which may save us a byte in encoding deltaLC,
          ;; for similar reasons.
          (switch (- deltaPC PC_RANGE)
            ;; PC_RANGE is the largest deltaPC we can encode in one byte, using
            ;; DW_LNS_const_add_pc.
            ;;
            ;; (1<<16)-1 is the largest deltaPC we can encode in three bytes, using
            ;; DW_LNS_fixed_advance_pc.
            ;;
            ;; (1<<(7n))-1 is the largest deltaPC we can encode in n+1 bytes for
            ;; n=1,3,4,5,..., using DW_LNS_advance_pc.
            (case [PC_RANGE (- (<< 1 7) 1) (- (<< 1 16) 1) (- (<< 1 21) 1) (- (<< 1 28) 1)
                (- (<< 1 35) 1) (- (<< 1 42) 1) (- (<< 1 49) 1) (- (<< 1 56) 1) (- (<< 1 63) 1)]
              (set! opcode 255))
            (default
              (set! opcode (- (+ OPCODE_BASE (* LINE_RANGE PC_RANGE)) 1))))))) ; 249



    (when (or (< opcode OPCODE_BASE) (> opcode 255))
      (panic (fmt/Sprintf "produced invalid special opcode %d" opcode)))


    ;; Subtract from deltaPC and deltaLC the amounts that the opcode will add.
    (set! deltaPC - (conv uint64 (/ (- opcode OPCODE_BASE) LINE_RANGE)))
    (set! deltaLC - (+ (% (- opcode OPCODE_BASE) LINE_RANGE) LINE_BASE))

    ;; Encode deltaPC.
    (when (!= deltaPC 0)
      (cond (<= deltaPC PC_RANGE) (do
          ;; Adjust the opcode so that we can use the 1-byte DW_LNS_const_add_pc
          ;; instruction.
          (set! opcode - (* LINE_RANGE (conv int64 (- PC_RANGE deltaPC))))
          (when (< opcode OPCODE_BASE)
            (panic (fmt/Sprintf "produced invalid special opcode %d" opcode)))

          (.AddUint8 dctxt s dwarf/DW_LNS_const_add_pc))
        (and (<= (<< 1 14) deltaPC) (< deltaPC (<< 1 16))) (do
          (.AddUint8 dctxt s dwarf/DW_LNS_fixed_advance_pc)
          (.AddUint16 dctxt s (conv uint16 deltaPC))) :else
        (do
          (.AddUint8 dctxt s dwarf/DW_LNS_advance_pc)
          (dwarf/Uleb128put dctxt s (conv int64 deltaPC)))))



    ;; Encode deltaLC.
    (when (!= deltaLC 0)
      (.AddUint8 dctxt s dwarf/DW_LNS_advance_line)
      (dwarf/Sleb128put dctxt s deltaLC))


    ;; Output the special opcode.
    (.AddUint8 dctxt s (conv uint8 opcode))))




    (aset (.-precursor ft) s (lit fnState :precursor fn :absfn absfn))))




^{:go/end 593} (go/method ReferenceChildDIE "Make a note of a child DIE reference: relocation 'ridx' within symbol 's'\nis targeting child 'c' of DIE with symbol 'tgt'.\n" [^{:tag (* DwarfFixupTable)} ft ^{:tag (* LSym)} s ^int ridx ^{:tag (* LSym)} tgt ^int dclidx ^int inlIndex]
  ;; Protect against concurrent access if multiple backend workers
  (.Lock (.-mu ft))
  (defer (.Unlock (.-mu ft)))

  ;; Create entry for symbol if not already present.
  (let [(values idx found) (aget (.-symtab ft) tgt)]
    (when (not found)
      (set! (.-svec ft) (append (.-svec ft) (lit symFixups :inlIndex (conv int32 inlIndex))))
      (set! idx (- (len (.-svec ft)) 1))
      (aset (.-symtab ft) tgt idx))


    ;; Do we have child DIE offsets available? If so, then apply them,
    ;; otherwise create a fixup record.
    (let [sf (addr (aget (.-svec ft) idx))]
      (if (> (len (.-doffsets sf)) 0)
        (let [found false]
          (range [_ do (.-doffsets sf)]
            (when (== (.-dclIdx do) (conv int32 dclidx))
              (let [off (.-offset do)]
                (set! (.-Add (aget (.-R s) ridx)) + (conv int64 off))
                (set! found true)
                (break))))


          (when (not found)
            (.Diag (.-ctxt ft) "internal error: DwarfFixupTable.ReferenceChildDIE unable to locate child DIE offset for dclIdx=%d src=%v tgt=%v" dclidx s tgt)))


        (set! (.-fixups sf) (append (.-fixups sf) (lit relFixup s (conv int32 ridx) (conv int32 dclidx))))))))








^{:go/end 628} (go/method RegisterChildDIEOffsets "Called once DWARF generation is complete for a given abstract function,\nwhose children might have been referenced via a call above. Stores\nthe offsets for any child DIEs (vars, params) so that they can be\nconsumed later in on DwarfFixupTable.Finalize, which applies any\noutstanding fixups.\n" [^{:tag (* DwarfFixupTable)} ft ^{:tag (* LSym)} s ^{:tag (slice (* dwarf/Var))} vars ^{:tag (slice int32)} coffsets]
  ;; Length of these two slices should agree
  (when (!= (len vars) (len coffsets))
    (.Diag (.-ctxt ft) "internal error: RegisterChildDIEOffsets vars/offsets length mismatch")
    (return))


  ;; Generate the slice of declOffset's based in vars/coffsets
  (let [doffsets (make (slice declOffset) (len coffsets))]
    (range [i coffsets]
      (set! (.-dclIdx (aget doffsets i)) (.-ChildIndex (aget vars i)))
      (set! (.-offset (aget doffsets i)) (aget coffsets i)))


    (.Lock (.-mu ft))
    (defer (.Unlock (.-mu ft)))

    ;; Store offsets for this symbol.
    (let [(values idx found) (aget (.-symtab ft) s)]
      (if (not found)
        (let [sf (lit symFixups :inlIndex -1 :defseen true :doffsets doffsets)]
          (set! (.-svec ft) (append (.-svec ft) sf))
          (aset (.-symtab ft) s (- (len (.-svec ft)) 1)))

        (let [sf (addr (aget (.-svec ft) idx))]
          (set! (.-doffsets sf) doffsets)
          (set! (.-defseen sf) true))))))



^{:go/end 645} (go/method processFixups [^{:tag (* DwarfFixupTable)} ft ^int slot ^{:tag (* LSym)} s]
  (let [sf (addr (aget (.-svec ft) slot))]
    (range [_ f (.-fixups sf)]
      (let [dfound false]
        (range [_ doffset (.-doffsets sf)]
          (when (== (.-dclIdx doffset) (.-dclidx f))
            (set! (.-Add (aget (.-R (.-refsym f)) (.-relidx f))) + (conv int64 (.-offset doffset)))
            (set! dfound true)
            (break)))


        (when (not dfound)
          (.Diag (.-ctxt ft) "internal error: DwarfFixupTable has orphaned fixup on %v targeting %v relidx=%d dclidx=%d" (.-refsym f) s (.-relidx f) (.-dclidx f)))))))






^{:go/breaks [8] :go/end 659} (go/method AbsFuncDwarfSym "return the LSym corresponding to the 'abstract subprogram' DWARF\ninfo entry for a function.\n" ^{:tag (* LSym)} [^{:tag (* DwarfFixupTable)} ft ^{:tag (* LSym)} fnsym]
  ;; Protect against concurrent access if multiple backend workers
  (.Lock (.-mu ft))
  (defer (.Unlock (.-mu ft)))

  (when [(values fnstate found) (aget (.-precursor ft) fnsym)] found
    (return (.-absfn fnstate)))

  (.Diag (.-ctxt ft) "internal error: AbsFuncDwarfSym requested for %v, not seen during inlining" fnsym)
  nil)








^{:go/end 708} (go/method Finalize "Called after all functions have been compiled; the main job of this\nfunction is to identify cases where there are outstanding fixups.\nThis scenario crops up when we have references to variables of an\ninlined routine, but that routine is defined in some other package.\nThis helper walks through and locate these fixups, then invokes a\nhelper to create an abstract subprogram DIE for each one.\n" [^{:tag (* DwarfFixupTable)} ft ^string myimportpath ^bool trace]
  (when trace
    (.Logf (.-ctxt ft) "DwarfFixupTable.Finalize invoked for %s\n" myimportpath))


  ;; Collect up the keys from the precursor map, then sort the
  ;; resulting list (don't want to rely on map ordering here).
  (let [fns (make (slice (* LSym)) (len (.-precursor ft)))
      ^{:line 675} idx 0]
    (range [fn (.-precursor ft)]
      (aset fns idx fn)
      (inc! idx))

    (^{:inst [(slice (* LSym)) (* LSym)]} slices/SortFunc fns ^{:go/end 682} (fn ^int [^{:tag (* LSym)} a ^{:tag (* LSym)} b]
        (strings/Compare (.-Name a) (.-Name b))))


    ;; Should not be called during parallel portion of compilation.
    (when (.-InParallel (.-ctxt ft))
      (.Diag (.-ctxt ft) "internal error: DwarfFixupTable.Finalize call during parallel backend"))


    ;; Generate any missing abstract functions.
    (range [_ s fns]
      (let [absfn (.AbsFuncDwarfSym ft s)
          (values slot found) (aget (.-symtab ft) absfn)]
        (when (or (not found) (not (.-defseen (aget (.-svec ft) slot))))
          ((.-GenAbstractFunc (.-ctxt ft)) s))))



    ;; Apply fixups.
    (range [_ s fns]
      (let [absfn (.AbsFuncDwarfSym ft s)
          (values slot found) (aget (.-symtab ft) absfn)]
        (if (not found)
          (.Diag (.-ctxt ft) "internal error: DwarfFixupTable.Finalize orphan abstract function for %v" s)

          (.processFixups ft slot s))))))

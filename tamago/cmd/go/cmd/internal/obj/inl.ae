(in-ns 'go.cmd.internal.obj) (go/file "inl.go" :imports [

    ^{:line 7} [src "cmd/internal/src"]])




































(go/type InlTree "InlTree is a collection of inlined calls. The Parent field of an\nInlinedCall is the index of another InlinedCall in InlTree.\n\nThe compiler maintains a global inlining tree and adds a node to it\nevery time a function is inlined. For example, suppose f() calls g()\nand g has two calls to h(), and that f, g, and h are inlineable:\n\n\t 1 func main() {\n\t 2     f()\n\t 3 }\n\t 4 func f() {\n\t 5     g()\n\t 6 }\n\t 7 func g() {\n\t 8     h()\n\t 9     h()\n\t10 }\n\t11 func h() {\n\t12     println(\"H\")\n\t13 }\n\nAssuming the global tree starts empty, inlining will produce the\nfollowing tree:\n\n\t[]InlinedCall{\n\t  {Parent: -1, Func: \"f\", Pos: <line 2>},\n\t  {Parent:  0, Func: \"g\", Pos: <line 5>},\n\t  {Parent:  1, Func: \"h\", Pos: <line 8>},\n\t  {Parent:  1, Func: \"h\", Pos: <line 9>},\n\t}\n\nThe nodes of h inlined into main will have inlining indexes 2 and 3.\n\nEventually, the compiler extracts a per-function inlining tree from\nthe global inlining tree (see pcln.go).\n" (struct
    ^{:line 45 :tag (slice InlinedCall)} nodes))



(go/type InlinedCall "InlinedCall is a node in an InlTree.\n" (struct
    ^{:line 50 :tag int} Parent ; index of the parent in the InlTree or < 0 if outermost call
    ^{:line 51 :tag src/XPos} Pos ; position of the inlined call
    ^{:line 52 :tag (* LSym)} Func ; function that was inlined
    ^{:line 53 :tag string} Name ; bare name of the function (w/o package prefix)
    ^{:line 54 :tag int32} ParentPC)) ; PC of instruction just before inlined body. Only valid in local trees.



^{:go/end 68} (go/method Add "Add adds a new call to the tree, returning its index.\n" ^int [^{:tag (* InlTree)} tree ^int parent ^src/XPos pos ^{:tag (* LSym)} func_ ^string name]
  (let [r (len (.-nodes tree))
      ^{:line 60} call ^{:go/breaks [2 4 6 8]} (lit InlinedCall
        :Parent parent
        :Pos pos
        :Func func_
        :Name name)]

    (set! (.-nodes tree) (append (.-nodes tree) call))
    ^{:line 67} r))








^{:go/end 82} (go/method AllParents "AllParents invokes do on each InlinedCall in the inlining call\nstack, from outermost to innermost.\n\nThat is, if inlIndex corresponds to f inlining g inlining h,\nAllParents invokes do with the call for inlining g into f, and then\ninlining h into g.\n" [^{:tag (* InlTree)} tree ^int inlIndex ^{:tag (func [InlinedCall])} do]
  (when (>= inlIndex 0)
    (let [call (aget (.-nodes tree) inlIndex)]
      (.AllParents tree (.-Parent call) do)
      (go/call do call))))



^{:go/end 86} (go/method Parent ^int [^{:tag (* InlTree)} tree ^int inlIndex]
  (.-Parent (aget (.-nodes tree) inlIndex)))


^{:go/end 90} (go/method InlinedFunction ^{:tag (* LSym)} [^{:tag (* InlTree)} tree ^int inlIndex]
  (.-Func (aget (.-nodes tree) inlIndex)))


^{:go/end 94} (go/method InlinedFuncName ^string [^{:tag (* InlTree)} tree ^int inlIndex]
  (.-Name (aget (.-nodes tree) inlIndex)))


^{:go/end 98} (go/method InlinedFuncPkg ^string [^{:tag (* InlTree)} tree ^int inlIndex]
  (.-Pkg (.-Func (aget (.-nodes tree) inlIndex))))


^{:go/end 102} (go/method CallPos ^src/XPos [^{:tag (* InlTree)} tree ^int inlIndex]
  (.-Pos (aget (.-nodes tree) inlIndex)))


^{:go/end 106} (go/method setParentPC [^{:tag (* InlTree)} tree ^int inlIndex ^int32 pc]
  (set! (.-ParentPC (aget (.-nodes tree) inlIndex)) pc))






^{:go/end 122} (go/method OutermostPos "OutermostPos returns the outermost position corresponding to xpos,\nwhich is where xpos was ultimately inlined to. In the example for\nInlTree, main() contains inlined AST nodes from h(), but the\noutermost position for those nodes is line 2.\n" ^src/Pos [^{:tag (* Link)} ctxt ^src/XPos xpos]
  (let [pos (.InnermostPos ctxt xpos)

      ^{:line 115} outerxpos xpos]
    (for [ix (.InliningIndex (.Base pos))] (>= ix 0) _
      (let [call (aget (.-nodes (.-InlTree ctxt)) ix)]
        (set! ix (.-Parent call))
        (set! outerxpos (.-Pos call))))

    (.Pos (.-PosTable ctxt) outerxpos)))









^{:go/end 133} (go/method InnermostPos "InnermostPos returns the innermost position corresponding to xpos,\nthat is, the code that is inlined and that inlines nothing else.\nIn the example for InlTree above, the code for println within h\nwould have an innermost position with line number 12, whether\nh was not inlined, inlined into g, g-then-f, or g-then-f-then-main.\nThis corresponds to what someone debugging main, f, g, or h might\nexpect to see while single-stepping.\n" ^src/Pos [^{:tag (* Link)} ctxt ^src/XPos xpos]
  (.Pos (.-PosTable ctxt) xpos))





^{:go/end 144} (go/method AllPos "AllPos invokes do with every position in the inlining call stack for xpos,\nfrom outermost to innermost. That is, xpos corresponds to f inlining g inlining h,\nAllPos invokes do with the position in f, then the position in g, then the position in h.\n" [^{:tag (* Link)} ctxt ^src/XPos xpos ^{:tag (func [src/Pos])} do]
  (let [pos (.InnermostPos ctxt xpos)]
    (.AllParents (.-InlTree ctxt) (.InliningIndex (.Base pos)) ^{:go/end 142} (fn [^InlinedCall call]
        (go/call do (.InnermostPos ctxt (.-Pos call)))))

    (go/call do pos)))


^{:go/end 151} (go/func dumpInlTree [^{:tag (* Link)} ctxt ^InlTree tree]
  (range [i call (.-nodes tree)]
    (let [pos (.Pos (.-PosTable ctxt) (.-Pos call))]
      (.Logf ctxt "%0d | %0d | %s (%s) pc=%d\n" i (.-Parent call) (.-Func call) pos (.-ParentPC call)))))

    ^{:line 39} [math "math"]
    ^{:line 40} [slices "slices"]])





(go/type ctxt5 "ctxt5 holds state while assembling a single function.\nEach function gets a fresh ctxt5.\nThis allows for multiple functions to be safely concurrently assembled.\n" (struct
    ^{:line 47 :tag (* obj/Link)} ctxt
    ^{:line 48 :tag obj/ProgAlloc} newprog
    ^{:line 49 :tag (* obj/LSym)} cursym
    ^{:line 50 :tag (* obj/Prog)} printp
    ^{:line 51 :tag (* obj/Prog)} blitrl

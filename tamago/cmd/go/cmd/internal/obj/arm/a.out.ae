^{:go/end 124} (go/func init []
  ;; f assigns dwarfregisters[from:to] = (base):(step*(to-from)+base)
  (let [f ^{:go/end 121} (fn [^int16 from ^int16 to ^int16 base ^int16 step]
        (for [r from] (<= r to) (inc! r)
          (aset ARMDWARFRegisters r (+ (* step (- r from)) base))))]



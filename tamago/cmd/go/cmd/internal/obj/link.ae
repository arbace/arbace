^{:go/end 1268} (go/method SpillRegisterArgs "SpillRegisterArgs emits the code to spill register args into whatever\nlocations the spill records specify.\n" ^{:tag (* Prog)} [^{:tag (* FuncInfo)} fi ^{:tag (* Prog)} last ^ProgAlloc pa]
  ;; Spill register args.
  (range [_ ra (.-spills fi)]
    (let [spill (Appendp last pa)]
      (set! (.-As spill) (.-Spill ra))
      (set! (.-Type (.-From spill)) TYPE_REG)
      (set! (.-Reg (.-From spill)) (.-Reg ra))
      (when (!= (.-Reg2 ra) 0)
        (set! (.-Type (.-From spill)) TYPE_REGREG)
        (set! (.-Offset (.-From spill)) (conv int64 (.-Reg2 ra))))

      (set! (.-To spill) (.-Addr ra))
      (set! last spill)))

  ^{:line 1267} last)




^{:go/end 1287} (go/method UnspillRegisterArgs "UnspillRegisterArgs emits the code to restore register args from whatever\nlocations the spill records specify.\n" ^{:tag (* Prog)} [^{:tag (* FuncInfo)} fi ^{:tag (* Prog)} last ^ProgAlloc pa]
  ;; Unspill any spilled register args
  (range [_ ra (.-spills fi)]
    (let [unspill (Appendp last pa)]
      (set! (.-As unspill) (.-Unspill ra))
      (set! (.-From unspill) (.-Addr ra))
      (set! (.-Type (.-To unspill)) TYPE_REG)
      (set! (.-Reg (.-To unspill)) (.-Reg ra))
      (when (!= (.-Reg2 ra) 0)
        (set! (.-Type (.-To unspill)) TYPE_REGREG)
        (set! (.-Offset (.-To unspill)) (conv int64 (.-Reg2 ra))))

      (set! last unspill)))


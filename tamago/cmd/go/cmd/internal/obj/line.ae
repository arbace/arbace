(in-ns 'go.cmd.internal.obj) (go/file "line.go" :imports [


    ^{:line 8} [goobj "cmd/internal/goobj"]
    ^{:line 9} [src "cmd/internal/src"]])



^{:go/end 15} (go/method AddImport "AddImport adds a package to the list of imported packages.\n" [^{:tag (* Link)} ctxt ^string pkg ^goobj/FingerprintType fingerprint]
  (set! (.-Imports ctxt) (append (.-Imports ctxt) (lit goobj/ImportedPkg :Pkg pkg :Fingerprint fingerprint))))






^{:go/end 27} (go/method getFileIndexAndLine "getFileIndexAndLine returns the relative file index (local to the CU), and\nthe relative line number for a position (i.e., as adjusted by a //line\ndirective). This is the file/line visible in the final binary (pcfile, pcln,\netc).\n" [^{:tag (* Link)} ctxt ^src/XPos xpos] :results [int int32]
  (let [pos (.InnermostPos ctxt xpos)]
    (when (not (.IsKnown pos))
      (set! pos (lit src/Pos)))

    (return (.FileIndex pos) (conv int32 (.RelLine pos)))))

  ^{:line 74} [^{:val 2 :doc "branchShort marks branches those target is close,\nwith offset is in -128..127 range.\n"} branchShort]


  ^{:line 77} [^{:val 4 :doc "branchLoopHead marks loop entry.\nUsed to insert padding for misaligned loops.\n"} branchLoopHead])








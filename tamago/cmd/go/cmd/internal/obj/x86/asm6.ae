                            (.asmandsz ab ctxt cursym p (addr (.-To p)) (aget reg (.-Reg (.GetFrom3 p))) (aget regrex (.-Reg (.GetFrom3 p))) 0))))))



                  ;; NOTE: The systems listed here are the ones that use the "TLS initial exec" model,
                  ;; where you load the TLS base register into a register and then index off that
                  ;; register to access the actual TLS variables. Systems that allow direct TLS access
                  ;; are handled in prefixof above and should not be listed here.
                  (case [movTLSReg]
                    (when (or (and (== ^{:go/via [Arch]} (.-Family (.-Arch ctxt)) sys/AMD64) (!= (.-As p) AMOVQ)) (and (== ^{:go/via [Arch]} (.-Family (.-Arch ctxt)) sys/I386) (!= (.-As p) AMOVL)))
                      (.Diag ctxt "invalid load of TLS: %v" p))


                    (when (== ^{:go/via [Arch]} (.-Family (.-Arch ctxt)) sys/I386)
                      ;; NOTE: The systems listed here are the ones that use the "TLS initial exec" model,
                      ;; where you load the TLS base register into a register and then index off that
                      ;; register to access the actual TLS variables. Systems that allow direct TLS access
                      ;; are handled in prefixof above and should not be listed here.
                      (switch (.-Headtype ctxt)
                        (default
                          (log/Fatalf "unknown TLS base location for %v" (.-Headtype ctxt)))

                        (case [objabi/Hlinux objabi/Hfreebsd objabi/Htamago]
                          (if (.-Flag_shared ctxt)
                            ;; Note that this is not generating the same insns as the other cases.
                            ;;     MOV TLS, dst
                            ;; becomes
                            ;;     call __x86.get_pc_thunk.dst
                            ;;     movl (gotpc + g@gotntpoff)(dst), dst
                            ;; which is encoded as
                            ;;     call __x86.get_pc_thunk.dst
                            ;;     movq 0(dst), dst
                            ;; and R_CALL & R_TLS_IE relocs. This all assumes the only tls variable we access
                            ;; is g, which we can't check here, but will when we assemble the second
                            ;; instruction.
                            (let [dst (.-Reg (.-To p))]
                              (.Put1 ab 0xe8)
                              (.AddRel cursym ctxt ^{:go/breaks [2 4 6 8]} (lit obj/Reloc
                                  :Type objabi/R_CALL
                                  :Off (conv int32 (+ (.-Pc p) (conv int64 (.Len ab))))
                                  :Siz 4
                                  :Sym (.Lookup ctxt (+ "__x86.get_pc_thunk." (strings/ToLower (rconv (conv int dst)))))))

                              (.PutInt32 ab 0)

                              (.Put2 ab 0x8B (conv byte (bit-or (<< 2 6) (aget reg dst) (<< (aget reg dst) 3))))
                              (.AddRel cursym ctxt ^{:go/breaks [2 4 6 8]} (lit obj/Reloc
                                  :Type objabi/R_TLS_IE
                                  :Off (conv int32 (+ (.-Pc p) (conv int64 (.Len ab))))
                                  :Siz 4
                                  :Add 2))

                              (.PutInt32 ab 0))
                            (do
                              ;; ELF TLS base is 0(GS).
                              (set! (.-From pp) (.-From p))

                              (set! (.-Type (.-From pp)) obj/TYPE_MEM)
                              (set! (.-Reg (.-From pp)) REG_GS)
                              (set! (.-Offset (.-From pp)) 0)
                              (set! (.-Index (.-From pp)) REG_NONE)
                              (set! (.-Scale (.-From pp)) 0)
                              ^{:go/breaks [3]} (.Put2 ab 0x65 ; GS
                                0x8B)
                              (.asmand ab ctxt cursym p (addr (.-From pp)) (addr (.-To p))))))

                        (case [objabi/Hplan9]
                          (set! (.-From pp) (lit obj/Addr))
                          (set! (.-Type (.-From pp)) obj/TYPE_MEM)
                          (set! (.-Name (.-From pp)) obj/NAME_EXTERN)
                          (set! (.-Sym (.-From pp)) plan9privates)
                          (set! (.-Offset (.-From pp)) 0)
                          (set! (.-Index (.-From pp)) REG_NONE)
                          (.Put1 ab 0x8B)
                          (.asmand ab ctxt cursym p (addr (.-From pp)) (addr (.-To p)))))

                      (break))


                    (switch (.-Headtype ctxt)
                      (default
                        (log/Fatalf "unknown TLS base location for %v" (.-Headtype ctxt)))

                      (case [objabi/Hlinux objabi/Hfreebsd objabi/Htamago]
                        (when (not (.-Flag_shared ctxt))
                          (log/Fatalf "unknown TLS base location for linux/freebsd without -shared"))

                        ;; Note that this is not generating the same insn as the other cases.
                        ;;     MOV TLS, R_to
                        ;; becomes
                        ;;     movq g@gottpoff(%rip), R_to
                        ;; which is encoded as
                        ;;     movq 0(%rip), R_to
                        ;; and a R_TLS_IE reloc. This all assumes the only tls variable we access
                        ;; is g, which we can't check here, but will when we assemble the second
                        ;; instruction.
                        (set! (.-rexflag ab) (bit-or Pw (bit-and (aget regrex (.-Reg (.-To p))) Rxr)))

                        (.Put2 ab 0x8B (conv byte (bit-or 0x05 (<< (aget reg (.-Reg (.-To p))) 3))))
                        (.AddRel cursym ctxt ^{:go/breaks [2 4 6 8]} (lit obj/Reloc
                            :Type objabi/R_TLS_IE
                            :Off (conv int32 (+ (.-Pc p) (conv int64 (.Len ab))))
                            :Siz 4
                            :Add -4))

                        (.PutInt32 ab 0))

                      (case [objabi/Hplan9]
                        (set! (.-From pp) (lit obj/Addr))
                        (set! (.-Type (.-From pp)) obj/TYPE_MEM)
                        (set! (.-Name (.-From pp)) obj/NAME_EXTERN)
                        (set! (.-Sym (.-From pp)) plan9privates)
                        (set! (.-Offset (.-From pp)) 0)
                        (set! (.-Index (.-From pp)) REG_NONE)
                        (set! (.-rexflag ab) bit-or Pw)
                        (.Put1 ab 0x8B)
                        (.asmand ab ctxt cursym p (addr (.-From pp)) (addr (.-To p))))

                      (case [objabi/Hsolaris] ; TODO(rsc): Delete Hsolaris from list. Should not use this code. See progedit in obj6.c.
                        ;; TLS base is 0(FS).
                        (set! (.-From pp) (.-From p))

                        (set! (.-Type (.-From pp)) obj/TYPE_MEM)
                        (set! (.-Name (.-From pp)) obj/NAME_NONE)
                        (set! (.-Reg (.-From pp)) REG_NONE)
                        (set! (.-Offset (.-From pp)) 0)
                        (set! (.-Index (.-From pp)) REG_NONE)
                        (set! (.-Scale (.-From pp)) 0)
                        (set! (.-rexflag ab) bit-or Pw)
                        ^{:go/breaks [3]} (.Put2 ab 0x64 ; FS
                          0x8B)
                        (.asmand ab ctxt cursym p (addr (.-From pp)) (addr (.-To p)))))))


                (return)))))



        (goto :bad)

        (label :bad
          (when (!= ^{:go/via [Arch]} (.-Family (.-Arch ctxt)) sys/AMD64)
            ;; here, the assembly has failed.
            ;; if it's a byte instruction that has
            ;; unaddressable registers, try to
            ;; exchange registers and reissue the
            ;; instruction with the operands renamed.
            (let [pp @p]

              (unbytereg (addr (.-From pp)) (addr (.-Ft pp)))
              (unbytereg (addr (.-To pp)) (addr (.-Tt pp)))

              (let [z (conv int (.-Reg (.-From p)))]
                (when (and (== (.-Type (.-From p)) obj/TYPE_REG) (>= z REG_BP) (<= z REG_DI))
                  ;; TODO(rsc): Use this code for x86-64 too. It has bug fixes not present in the amd64 code base.
                  ;; For now, different to keep bit-for-bit compatibility.
                  (when (== ^{:go/via [Arch]} (.-Family (.-Arch ctxt)) sys/I386)
                    (let [breg (byteswapreg ctxt (addr (.-To p)))]
                      (if (!= breg REG_AX) (do
                          (.Put1 ab 0x87) ; xchg lhs,bx
                          (.asmando ab ctxt cursym p (addr (.-From p)) (aget reg breg))
                          (subreg (addr pp) z breg)
                          (.doasm ab ctxt cursym (addr pp))
                          (.Put1 ab 0x87) ; xchg lhs,bx
                          (.asmando ab ctxt cursym p (addr (.-From p)) (aget reg breg)))
                        (do
                          (.Put1 ab (conv byte (+ 0x90 (aget reg z)))) ; xchg lsh,ax
                          (subreg (addr pp) z REG_AX)
                          (.doasm ab ctxt cursym (addr pp))
                          (.Put1 ab (conv byte (+ 0x90 (aget reg z)))))) ; xchg lsh,ax

                      (return)))


                  (if (or (isax (addr (.-To p))) (== (.-Type (.-To p)) obj/TYPE_NONE)) (do
                      ;; We certainly don't want to exchange
                      ;; with AX if the op is MUL or DIV.
                      (.Put1 ab 0x87) ; xchg lhs,bx
                      (.asmando ab ctxt cursym p (addr (.-From p)) (aget reg REG_BX))
                      (subreg (addr pp) z REG_BX)
                      (.doasm ab ctxt cursym (addr pp))
                      (.Put1 ab 0x87) ; xchg lhs,bx
                      (.asmando ab ctxt cursym p (addr (.-From p)) (aget reg REG_BX)))
                    (do
                      (.Put1 ab (conv byte (+ 0x90 (aget reg z)))) ; xchg lsh,ax
                      (subreg (addr pp) z REG_AX)
                      (.doasm ab ctxt cursym (addr pp))
                      (.Put1 ab (conv byte (+ 0x90 (aget reg z)))))) ; xchg lsh,ax

                  (return))


                (set! z (conv int (.-Reg (.-To p))))
                (when (and (== (.-Type (.-To p)) obj/TYPE_REG) (>= z REG_BP) (<= z REG_DI))
                  ;; TODO(rsc): Use this code for x86-64 too. It has bug fixes not present in the amd64 code base.
                  ;; For now, different to keep bit-for-bit compatibility.
                  (when (== ^{:go/via [Arch]} (.-Family (.-Arch ctxt)) sys/I386)
                    (let [breg (byteswapreg ctxt (addr (.-From p)))]
                      (if (!= breg REG_AX) (do
                          (.Put1 ab 0x87) ;xchg rhs,bx
                          (.asmando ab ctxt cursym p (addr (.-To p)) (aget reg breg))
                          (subreg (addr pp) z breg)
                          (.doasm ab ctxt cursym (addr pp))
                          (.Put1 ab 0x87) ; xchg rhs,bx
                          (.asmando ab ctxt cursym p (addr (.-To p)) (aget reg breg)))
                        (do
                          (.Put1 ab (conv byte (+ 0x90 (aget reg z)))) ; xchg rsh,ax
                          (subreg (addr pp) z REG_AX)
                          (.doasm ab ctxt cursym (addr pp))
                          (.Put1 ab (conv byte (+ 0x90 (aget reg z)))))) ; xchg rsh,ax

                      (return)))


                  (if (isax (addr (.-From p))) (do
                      (.Put1 ab 0x87) ; xchg rhs,bx
                      (.asmando ab ctxt cursym p (addr (.-To p)) (aget reg REG_BX))
                      (subreg (addr pp) z REG_BX)
                      (.doasm ab ctxt cursym (addr pp))
                      (.Put1 ab 0x87) ; xchg rhs,bx
                      (.asmando ab ctxt cursym p (addr (.-To p)) (aget reg REG_BX)))
                    (do
                      (.Put1 ab (conv byte (+ 0x90 (aget reg z)))) ; xchg rsh,ax
                      (subreg (addr pp) z REG_AX)
                      (.doasm ab ctxt cursym (addr pp))
                      (.Put1 ab (conv byte (+ 0x90 (aget reg z)))))) ; xchg rsh,ax

                  (return))))))



        (.Diag ctxt "%s: invalid instruction: %v" (.-Name cursym) p)))))






^{:go/end 5354} (go/func byteswapreg "byteswapreg returns a byte-addressable register (AX, BX, CX, DX)\nwhich is not referenced in a.\nIf a is empty, it returns BX to account for MULB-like instructions\nthat might use DX and AX.\n" ^int [^{:tag (* obj/Link)} ctxt ^{:tag (* obj/Addr)} a]
  (let [(values cana canb canc cand) (values true true true true)]
    (when (== (.-Type a) obj/TYPE_NONE)
      (set! (values cana cand) (values false false)))


    (when (or (== (.-Type a) obj/TYPE_REG) ^:go/paren (and ^:go/paren (or (== (.-Type a) obj/TYPE_MEM) (== (.-Type a) obj/TYPE_ADDR)) (== (.-Name a) obj/NAME_NONE)))
      (switch (.-Reg a)
        (case [REG_NONE]
          (set! (values cana cand) (values false false)))
        (case [REG_AX REG_AL REG_AH]
          (set! cana false))
        (case [REG_BX REG_BL REG_BH]
          (set! canb false))
        (case [REG_CX REG_CL REG_CH]
          (set! canc false))
        (case [REG_DX REG_DL REG_DH]
          (set! cand false))))



    (when (or (== (.-Type a) obj/TYPE_MEM) (== (.-Type a) obj/TYPE_ADDR))
      (switch (.-Index a)
        (case [REG_AX]
          (set! cana false))
        (case [REG_BX]
          (set! canb false))
        (case [REG_CX]
          (set! canc false))
        (case [REG_DX]
          (set! cand false))))



    (switch
      (case [cana]
        (return REG_AX))
      (case [canb]
        (return REG_BX))
      (case [canc]
        (return REG_CX))
      (case [cand]
        (return REG_DX))
      (default
        (.Diag ctxt "impossible byte register")
        ((.-DiagFlush ctxt))
        (log/Fatalf "bad code")
        (return 0)))))



^{:go/end 5358} (go/func isbadbyte ^bool [^{:tag (* obj/Addr)} a]
  (and (== (.-Type a) obj/TYPE_REG) ^:go/paren (or (and (<= REG_BP (.-Reg a)) (<= (.-Reg a) REG_DI)) (and (<= REG_BPB (.-Reg a)) (<= (.-Reg a) REG_DIB)))))


^{:go/end 5421} (go/method asmins [^{:tag (* AsmBuf)} ab ^{:tag (* obj/Link)} ctxt ^{:tag (* obj/LSym)} cursym ^{:tag (* obj/Prog)} p]
  (.Reset ab)

  (set! (.-rexflag ab) 0)
  (set! (.-vexflag ab) false)
  (set! (.-evexflag ab) false)
  (let [mark (.Len ab)]
    (.doasm ab ctxt cursym p)
    (when (and (!= (.-rexflag ab) 0) (not (.-vexflag ab)) (not (.-evexflag ab)))
      ;; as befits the whole approach of the architecture,
      ;; the rex prefix must appear before the first opcode byte
      ;; (and thus after any 66/67/f2/f3/26/2e/3e prefix bytes, but
      ;; before the 0f opcode escape!), or it might be ignored.
      ;; note that the handbook often misleadingly shows 66/f2/f3 in `opcode'.
      (when (!= ^{:go/via [Arch]} (.-Family (.-Arch ctxt)) sys/AMD64)
        (.Diag ctxt "asmins: illegal in mode %d: %v (%d %d)" (* ^{:go/via [Arch]} (.-RegSize (.-Arch ctxt)) 8) p (.-Ft p) (.-Tt p)))

      (let [n (.Len ab)
          ^{:line 5378 :tag int} np (zero int)]
        (for [(set! np mark)] (< np n) (inc! np)
          (let [c (.At ab np)]
            (when (and (!= c 0xf2) (!= c 0xf3) ^:go/paren (or (< c 0x64) (> c 0x67)) (!= c 0x2e) (!= c 0x3e) (!= c 0x26))
              (break))))


        (.Insert ab np (conv byte (bit-or 0x40 (.-rexflag ab))))))


    (let [n (.Len ab)]
      (for [i (- (len (.-R cursym)) 1)] (>= i 0) (dec! i)
        (let [r (addr (aget (.-R cursym) i))]
          (when (< (conv int64 (.-Off r)) (.-Pc p))
            (break))

          (when (and (!= (.-rexflag ab) 0) (not (.-vexflag ab)) (not (.-evexflag ab)))
            (inc! (.-Off r)))

          (when (== (.-Type r) objabi/R_PCREL)
            (cond (or (== ^{:go/via [Arch]} (.-Family (.-Arch ctxt)) sys/AMD64) (== (.-As p) obj/AJMP) (== (.-As p) obj/ACALL))
              ;; PC-relative addressing is relative to the end of the instruction,
              ;; but the relocations applied by the linker are relative to the end
              ;; of the relocation. Because immediate instruction
              ;; arguments can follow the PC-relative memory reference in the
              ;; instruction encoding, the two may not coincide. In this case,
              ;; adjust addend so that linker can keep relocating relative to the
              ;; end of the relocation.
              (set! (.-Add r) - (- (+ (.-Pc p) (conv int64 n)) (+ (conv int64 (.-Off r)) (conv int64 (.-Siz r)))))
              (== ^{:go/via [Arch]} (.-Family (.-Arch ctxt)) sys/I386)
              ;; On 386 PC-relative addressing (for non-call/jmp instructions)
              ;; assumes that the previous instruction loaded the PC of the end
              ;; of that instruction into CX, so the adjustment is relative to
              ;; that.
              (set! (.-Add r) + (+ (- (conv int64 (.-Off r)) (.-Pc p)) (conv int64 (.-Siz r))))))


          (when (and (== (.-Type r) objabi/R_GOTPCREL) (== ^{:go/via [Arch]} (.-Family (.-Arch ctxt)) sys/I386))
            ;; On 386, R_GOTPCREL makes the same assumptions as R_PCREL.
            (set! (.-Add r) + (+ (- (conv int64 (.-Off r)) (.-Pc p)) (conv int64 (.-Siz r))))))))))






^{:go/end 5426} (go/func unpackOps4 "unpackOps4 extracts 4 operands from p.\n" [^{:tag (* obj/Prog)} p] :results [^{:tag (* obj/Addr)} arg0 ^{:tag (* obj/Addr)} arg1 ^{:tag (* obj/Addr)} arg2 ^{:tag (* obj/Addr)} dst]
  (return (addr (.-From p)) (addr (.-Addr (aget (.-RestArgs p) 0))) (addr (.-Addr (aget (.-RestArgs p) 1))) (addr (.-To p))))



^{:go/end 5431} (go/func unpackOps5 "unpackOps5 extracts 5 operands from p.\n" [^{:tag (* obj/Prog)} p] :results [^{:tag (* obj/Addr)} arg0 ^{:tag (* obj/Addr)} arg1 ^{:tag (* obj/Addr)} arg2 ^{:tag (* obj/Addr)} arg3 ^{:tag (* obj/Addr)} dst]
  (return (addr (.-From p)) (addr (.-Addr (aget (.-RestArgs p) 0))) (addr (.-Addr (aget (.-RestArgs p) 1))) (addr (.-Addr (aget (.-RestArgs p) 2))) (addr (.-To p))))

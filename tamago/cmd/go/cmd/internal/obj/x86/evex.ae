^{:go/end 161} (go/func compressedDisp8 "compressedDisp8 calculates EVEX compressed displacement, if applicable.\n" [^int32 disp ^int32 elemSize] :results [^byte disp8 ^bool ok]
  (when (== (% disp elemSize) 0)
    (let [v (/ disp elemSize)]
      (when (and (>= v -128) (<= v 127))
        (return (conv byte v) true))))


  (return 0 false))




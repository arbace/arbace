^{:go/end 228} (go/func init []
  ;; Decode all valid suffixes for later use.
  (range [i opSuffixTable]
    (let [suffix (newEVEXSuffix)
        ^{:line 206} parts (strings/Split (aget opSuffixTable i) ".")]
      (range [j parts]
        (switch (aget parts j)
          (case ["Z"]
            (set! (.-zeroing suffix) true))
          (case ["BCST"]
            (set! (.-broadcast suffix) true))
          (case ["SAE"]
            (set! (.-sae suffix) true))

          (case ["RN_SAE"]
            (set! (.-rounding suffix) rcRNSAE))
          (case ["RD_SAE"]
            (set! (.-rounding suffix) rcRDSAE))
          (case ["RU_SAE"]
            (set! (.-rounding suffix) rcRUSAE))
          (case ["RZ_SAE"]
            (set! (.-rounding suffix) rcRZSAE))))


      (aset evexSuffixMap i suffix))))





^{:go/end 320} (go/func inferSuffixError "inferSuffixError returns non-nil error that describes what could be\nthe cause of suffix parse failure.\n\nAt the point this function is executed there is already assembly error,\nso we can burn some clocks to construct good error message.\n\nReported issues:\n  - duplicated suffixes\n  - illegal rounding/SAE+broadcast combinations\n  - unknown suffixes\n  - misplaced suffix (e.g. wrong Z suffix position)\n" ^error [^string cond]
  (let [suffixSet (make (map string bool)) ; Set for duplicates detection.
      ^{:line 283} unknownSet (make (map string bool)) ; Set of unknown suffixes.
      ^{:line 284} hasBcst false
      ^{:line 285} hasRoundSae false
      ^{:line 286 :tag (slice string)} msg (zero (slice string)) ; Error message parts

      ^{:line 288} suffixes (strings/Split cond ".")]
    (range [i suffix suffixes]
      (switch suffix
        (case ["Z"]
          (when (!= i (- (len suffixes) 1))
            (set! msg (append msg "Z suffix should be the last"))))

        (case ["BCST"]
          (set! hasBcst true))
        (case ["SAE" "RN_SAE" "RZ_SAE" "RD_SAE" "RU_SAE"]
          (set! hasRoundSae true))
        (default
          (when (not (aget unknownSet suffix))
            (set! msg (append msg (fmt/Sprintf "unknown suffix %q" suffix))))

          (aset unknownSet suffix true)))


      (when (aget suffixSet suffix)
        (set! msg (append msg (fmt/Sprintf "duplicate suffix %q" suffix))))

      (aset suffixSet suffix true))


    (when (and hasBcst hasRoundSae)
      (set! msg (append msg "can't combine rounding/SAE and broadcast")))


    (when (== (len msg) 0)
      (return (errors/New "bad suffix combination")))

    (errors/New (strings/Join msg "; "))))






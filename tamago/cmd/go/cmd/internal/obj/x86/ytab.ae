(in-ns 'go.cmd.internal.obj.x86) (go/file "ytab.go" :imports [])



(go/const ^{:tag int :val 6 :doc "argListMax specifies upper arg count limit expected to be carried by obj.Prog.\nMax len(obj.Prog.RestArgs) can be inferred from this to be 4.\n"} argListMax 6)

(go/type argList (array argListMax uint8))

(go/type ytab (struct
    ^{:line 14 :tag uint8} zcase
    ^{:line 15 :tag uint8} zoffset




    ^{:line 20 :tag argList :doc "Last arg is usually destination.\nFor unary instructions unaryDst is used to determine\nif single argument is a source or destination.\n"} args))








^{:go/breaks [[6 43]] :go/end 44} (go/method match "Returns true if yt is compatible with args.\n\nElements from args and yt.args are used\nto index ycover table like `ycover[args[i]+yt.args[i]]`.\nThis means that args should contain values that already\nmultiplied by Ymax.\n" ^bool [^{:tag (* ytab)} yt ^{:tag (slice int)} args]
  ;; Trailing Yxxx check is required to avoid a case
  ;; where shorter arg list is matched.
  ;; If we had exact yt.args length, it could be `yt.argc != len(args)`.
  (when (and (< (len args) (len (.-args yt))) (!= (aget (.-args yt) (len args)) Yxxx))
    (return false))


  (range [i args]
    (when (== (aget ycover (+ (aget args i) (conv int (aget (.-args yt) i)))) 0)
      (return false)))



  true)

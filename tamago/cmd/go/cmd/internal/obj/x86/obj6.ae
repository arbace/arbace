      (return true))

    (when (and (!= (bit-and m readTo) 0) (== (.-Type (.-To p)) obj/TYPE_REG) (isR15 (.-Reg (.-To p))))
      (return true))

    (when (and (!= (bit-and m readReg) 0) (isR15 (.-Reg p)))
      (return true))

    (when (and (!= (bit-and m readFrom3) 0) (== (.-Type (.GetFrom3 p)) obj/TYPE_REG) (isR15 (.-Reg (.GetFrom3 p))))
      (return true))


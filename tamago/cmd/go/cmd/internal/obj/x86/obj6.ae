    (case [ACMPPD ACMPPS ACMPSD ACMPSS]
      (when (and (== (.-Type (.-To p)) obj/TYPE_MEM) (== (.-Name (.-To p)) obj/NAME_NONE) (== (.-Reg (.-To p)) REG_NONE) (== (.-Index (.-To p)) REG_NONE) (== (.-Sym (.-To p)) nil))
        (set! (.-Type (.-To p)) obj/TYPE_CONST))))



  ;; Rewrite CALL/JMP/RET to symbol as TYPE_BRANCH.
  (switch (.-As p)
    (case [obj/ACALL obj/AJMP obj/ARET]
      (when (and (== (.-Type (.-To p)) obj/TYPE_MEM) ^:go/paren (or (== (.-Name (.-To p)) obj/NAME_EXTERN) (== (.-Name (.-To p)) obj/NAME_STATIC)) (!= (.-Sym (.-To p)) nil))

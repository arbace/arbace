    (when (!= (.-Type (.-To p)) obj/TYPE_NONE)
      ;; Most x86 instructions update the To value
      (set! m bit-or (bit-or readTo writeTo)))

    (when (!= (.-Reg p) 0)
      (set! m bit-or readReg))

    (when (!= (.GetFrom3 p) nil)
      (set! m bit-or readFrom3))


    ;; Lots of exceptions to the above defaults.

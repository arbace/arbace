    (when (and (== (.-Type (.-To p)) obj/TYPE_MEM) ^:go/paren (or (isR15 (.-Reg (.-To p))) (isR15 (.-Index (.-To p)))))
      (return true))

    (when [f3 (.GetFrom3 p)] (and (!= f3 nil) (== (.-Type f3) obj/TYPE_MEM) ^:go/paren (or (isR15 (.-Reg f3)) (isR15 (.-Index f3))))

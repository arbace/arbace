    (when (and (!= (bit-and m writeFrom) 0) (== (.-Type (.-From p)) obj/TYPE_REG) (isR15 (.-Reg (.-From p))))
      (return true))

    (when (and (!= (bit-and m writeTo) 0) (== (.-Type (.-To p)) obj/TYPE_REG) (isR15 (.-Reg (.-To p))))
      (return true))

    (when (and (!= (bit-and m writeReg) 0) (isR15 (.-Reg p)))
      (return true))

    (when (and (!= (bit-and m writeFrom3) 0) (== (.-Type (.GetFrom3 p)) obj/TYPE_REG) (isR15 (.-Reg (.GetFrom3 p))))
      (return true))

    false))


^{:go/end 1323} (go/func errorCheck [^{:tag (* obj/Link)} ctxt ^{:tag (* obj/LSym)} s]
  ;; When dynamic linking, R15 is used to access globals. Reject code that
  ;; uses R15 after a global variable access.

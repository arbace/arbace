  (when (and (== (.-Type (.-From p)) obj/TYPE_ADDR) ^:go/paren (or (== ^{:go/via [Arch]} (.-Family (.-Arch ctxt)) sys/AMD64) (and (!= (.-Name (.-From p)) obj/NAME_EXTERN) (!= (.-Name (.-From p)) obj/NAME_STATIC))))

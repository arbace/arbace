        (set! m bit-and-not readTo))

      (switch (.-As p)
        (case [APOPW APOPL APOPQ
            ^{:line 1206} ALEAL ALEAQ
            ^{:line 1207} AIMUL3W AIMUL3L AIMUL3Q
            ^{:line 1208} APEXTRB APEXTRW APEXTRD APEXTRQ AVPEXTRB AVPEXTRW AVPEXTRD AVPEXTRQ AEXTRACTPS
            ^{:line 1209} ABSFW ABSFL ABSFQ ABSRW ABSRL ABSRQ APOPCNTW APOPCNTL APOPCNTQ ALZCNTW ALZCNTL ALZCNTQ
            ^{:line 1210} ASHLXL ASHLXQ ASHRXL ASHRXQ ASARXL ASARXQ]

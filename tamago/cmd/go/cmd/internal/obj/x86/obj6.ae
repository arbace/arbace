^{:go/end 1134} (go/func isR15 ^bool [^int16 r]
  (or (== r REG_R15) (== r REG_R15B)))

^{:go/end 1140} (go/func addrMentionsR15 ^bool [^{:tag (* obj/Addr)} a]
  (when (== a nil)
    (return false))

  (or (isR15 (.-Reg a)) (isR15 (.-Index a))))

^{:go/end 1143} (go/func progMentionsR15 ^bool [^{:tag (* obj/Prog)} p]
  (or (addrMentionsR15 (addr (.-From p))) (addrMentionsR15 (addr (.-To p))) (isR15 (.-Reg p)) (addrMentionsR15 (.GetFrom3 p))))


^{:go/end 1150} (go/func addrUsesGlobal ^bool [^{:tag (* obj/Addr)} a]
  (when (== a nil)
    (return false))

  (and (== (.-Name a) obj/NAME_EXTERN) (not ^{:go/via [Attribute]} (.Local (.-Sym a)))))

^{:go/end 1162} (go/func progUsesGlobal ^bool [^{:tag (* obj/Prog)} p]
  (when (or (== (.-As p) obj/ACALL) (== (.-As p) obj/ATEXT) (== (.-As p) obj/AFUNCDATA) (== (.-As p) obj/ARET) (== (.-As p) obj/AJMP))

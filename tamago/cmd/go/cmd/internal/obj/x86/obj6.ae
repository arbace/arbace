        (set! (.-Scale (.-From p)) 0)
        (set! (.-Index (.-From p)) REG_NONE))


      (when (and (== (.-Type (.-To p)) obj/TYPE_MEM) (== (.-Index (.-To p)) REG_TLS) (<= REG_AX (.-Reg (.-To p))) (<= (.-Reg (.-To p)) REG_R15))

      (when (and ^:go/paren (or (== (.-As p) AMOVQ) (== (.-As p) AMOVL)) (== (.-Type (.-From p)) obj/TYPE_MEM) (== (.-Reg (.-From p)) REG_TLS) (== (.-Type (.-To p)) obj/TYPE_REG) (<= REG_AX (.-Reg (.-To p))) (<= (.-Reg (.-To p)) REG_R15))
        (let [q (obj/Appendp p newprog)]

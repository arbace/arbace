          (when [q (.-Link p)] (and (!= q nil) (== (bit-and (.-Mark q) markBit) 0))
            (set! (.-Mark q) bit-or markBit)
            (set! work (append work q))))))




    ;; Clean up.
    (for [p (.-Text (.Func s))] (!= p nil) (set! p (.-Link p))
      (set! (.-Mark p) bit-and-not markBit))))




      ;; TODO(rsc): Remove the Hsolaris special case. It exists only to
      ;; guarantee we are producing byte-identical binaries as before this code.
      ;; But it should be unnecessary.
      (when (and ^:go/paren (or (== (.-As p) AMOVQ) (== (.-As p) AMOVL)) (== (.-Type (.-From p)) obj/TYPE_REG) (== (.-Reg (.-From p)) REG_TLS) (== (.-Type (.-To p)) obj/TYPE_REG) (<= REG_AX (.-Reg (.-To p))) (<= (.-Reg (.-To p)) REG_R15) (!= (.-Headtype ctxt) objabi/Hsolaris))

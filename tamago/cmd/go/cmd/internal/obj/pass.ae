(in-ns 'go.cmd.internal.obj) (go/file "pass.go" :imports [])

;; Code and data passes.



^{:go/end 50} (go/func brloop "brloop returns the ultimate destination of the series of unconditional jumps beginning at p.\nIn the case of an infinite loop, brloop returns nil.\n" ^{:tag (* Prog)} [^{:tag (* Prog)} p]
  (let [c 0]
    (for [q p] (!= q nil) (set! q (.Target (.-To q)))
      (when (or (!= (.-As q) AJMP) (== (.Target (.-To q)) nil))
        (return q))

      (inc! c)
      (when (>= c 5000)
        ;; infinite loop
        (return nil)))


    (panic "unreachable")))



^{:go/end 123} (go/func checkaddr "checkaddr checks that a has an expected encoding, especially TYPE_CONST vs TYPE_ADDR.\n" [^{:tag (* Link)} ctxt ^{:tag (* Prog)} p ^{:tag (* Addr)} a]
  (switch (.-Type a)
    (case [TYPE_NONE TYPE_REGREG2 TYPE_REGLIST]
      (return))

    (case [TYPE_BRANCH TYPE_TEXTSIZE]
      (when (or (!= (.-Reg a) 0) (!= (.-Index a) 0) (!= (.-Scale a) 0) (!= (.-Name a) 0))
        (break))

      (return))

    (case [TYPE_MEM]
      (return))

    (case [TYPE_CONST]
      ;; TODO(rsc): After fixing SHRQ, check a.Index != 0 too.
      (when (or (!= (.-Name a) 0) (!= (.-Sym a) nil) (!= (.-Reg a) 0))
        (.Diag ctxt "argument is TYPE_CONST, should be TYPE_ADDR, in %v" p)
        (return))


      (when (or (!= (.-Reg a) 0) (!= (.-Scale a) 0) (!= (.-Name a) 0) (!= (.-Sym a) nil) (!= (.-Val a) nil))
        (break))

      (return))

    (case [TYPE_FCONST TYPE_SCONST]
      (when (or (!= (.-Reg a) 0) (!= (.-Index a) 0) (!= (.-Scale a) 0) (!= (.-Name a) 0) (!= (.-Offset a) 0) (!= (.-Sym a) nil))
        (break))

      (return))

    (case [TYPE_REG]
      ;; TODO(rsc): After fixing PINSRQ, check a.Offset != 0 too.
      ;; TODO(rsc): After fixing SHRQ, check a.Index != 0 too.
      (when (or (!= (.-Scale a) 0) (!= (.-Name a) 0) (!= (.-Sym a) nil))
        (break))

      (return))

    (case [TYPE_ADDR]
      (when (!= (.-Val a) nil)
        (break))

      (when (and (== (.-Reg a) 0) (== (.-Index a) 0) (== (.-Scale a) 0) (== (.-Name a) 0) (== (.-Sym a) nil))
        (.Diag ctxt "argument is TYPE_ADDR, should be TYPE_CONST, in %v" p))

      (return))

    (case [TYPE_SHIFT TYPE_REGREG]
      (when (or (!= (.-Index a) 0) (!= (.-Scale a) 0) (!= (.-Name a) 0) (!= (.-Sym a) nil) (!= (.-Val a) nil))
        (break))

      (return))

    (case [TYPE_INDIR]
      ;; Expect sym and name to be set, nothing else.
      ;; Technically more is allowed, but this is only used for *name(SB).
      (when (or (!= (.-Reg a) 0) (!= (.-Index a) 0) (!= (.-Scale a) 0) (== (.-Name a) 0) (!= (.-Offset a) 0) (== (.-Sym a) nil) (!= (.-Val a) nil))
        (break))

      (return))
    (case [TYPE_SPECIAL]
      (when (or (!= (.-Reg a) 0) (!= (.-Index a) 0) (!= (.-Scale a) 0) (!= (.-Name a) 0) (!= (.-Class a) 0) (!= (.-Sym a) nil))
        (break))

      (return)))


  (.Diag ctxt "invalid encoding for argument %v" p))


^{:go/end 181} (go/func linkpatch [^{:tag (* Link)} ctxt ^{:tag (* LSym)} sym ^ProgAlloc newprog]
  (for [p (.-Text (.Func sym))] (!= p nil) (set! p (.-Link p))
    (checkaddr ctxt p (addr (.-From p)))
    (range [_ v (.-RestArgs p)]
      (checkaddr ctxt p (addr (.-Addr v))))

    (checkaddr ctxt p (addr (.-To p)))

    (when (!= (.-Progedit (.-Arch ctxt)) nil)
      ((.-Progedit (.-Arch ctxt)) ctxt p newprog))

    (when (!= (.-Type (.-To p)) TYPE_BRANCH)
      (continue))

    (when (!= (.-Val (.-To p)) nil)
      (continue))


    (when (!= (.-Sym (.-To p)) nil)
      (continue))

    (let [q (.-Text (.Func sym))]
      (while (and (!= q nil) (!= (.-Offset (.-To p)) (.-Pc q)))
        (if (and (!= (.-Forwd q) nil) (>= (.-Offset (.-To p)) (.-Pc (.-Forwd q))))
          (set! q (.-Forwd q))

          (set! q (.-Link q))))



      (when (== q nil)
        (let [name "<nil>"]
          (when (!= (.-Sym (.-To p)) nil)
            (set! name (.-Name (.-Sym (.-To p)))))

          (.Diag ctxt "branch out of range (%#x)\n%v [%s]" (conv uint32 (.-Offset (.-To p))) p name)
          (set! (.-Type (.-To p)) TYPE_NONE)))


      (.SetTarget (.-To p) q)))


  (when (not (.-Flag_optimize ctxt))
    (return))


  ;; Collapse series of jumps to jumps.
  (for [p (.-Text (.Func sym))] (!= p nil) (set! p (.-Link p))
    (when (== (.Target (.-To p)) nil)
      (continue))

    (.SetTarget (.-To p) (brloop (.Target (.-To p))))
    (when (and (!= (.Target (.-To p)) nil) (== (.-Type (.-To p)) TYPE_BRANCH))
      (set! (.-Offset (.-To p)) (.-Pc (.Target (.-To p)))))))

        ^{:line 379} objabi/R_POWER_TLS_LE_TPREL34
        ^{:line 380} objabi/R_RISCV_JAL
        ^{:line 381} objabi/R_RISCV_PCREL_ITYPE
        ^{:line 382} objabi/R_RISCV_PCREL_STYPE
        ^{:line 383} objabi/R_RISCV_TLS_IE
        ^{:line 384} objabi/R_RISCV_TLS_LE
        ^{:line 385} objabi/R_RISCV_GOT_HI20

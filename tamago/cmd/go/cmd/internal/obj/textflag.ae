;; This file defines flags attached to various functions
;; and data objects. The compilers, assemblers, and linker must
;; all agree on these values.

(in-ns 'go.cmd.internal.obj) (go/file "textflag.go" :imports [])

(go/const



  ^{:line 15} [^{:val 1 :doc "Don't profile the marked routine.\n\nDeprecated: Not implemented, do not use.\n"} NOPROF 1]



  ^{:line 19} [^{:val 2 :doc "It is ok for the linker to get multiple of these symbols. It will\npick one of the duplicates to use.\n"} DUPOK 2]


  ^{:line 22} [^{:val 4 :doc "Don't insert stack check preamble.\n"} NOSPLIT 4]


  ^{:line 25} [^{:val 8 :doc "Put this data in a read-only section.\n"} RODATA 8]


  ^{:line 28} [^{:val 16 :doc "This data contains no pointers.\n"} NOPTR 16]



  ^{:line 32} [^{:val 32 :doc "This is a wrapper function and should not count as\ndisabling 'recover' or appear in tracebacks by default.\n"} WRAPPER 32]


  ^{:line 35} [^{:val 64 :doc "This function uses its incoming context register.\n"} NEEDCTXT 64]


  ^{:line 38} [^{:val 128 :doc "When passed to objw.Global, causes Local to be set to true on the LSym it creates.\n"} LOCAL 128]



  ^{:line 42} [^{:val 256 :doc "Allocate a word of thread local storage and store the offset from the\nthread local base to the thread local storage in this variable.\n"} TLSBSS 256]



  ^{:line 46} [^{:val 512 :doc "Do not insert instructions to allocate a stack frame for this function.\nOnly valid on functions that declare a frame size of 0.\n"} NOFRAME 512]


  ^{:line 49} [^{:val 1024 :doc "Function can call reflect.Type.Method or reflect.Type.MethodByName.\n"} REFLECTMETHOD 1024]



  ^{:line 53} [^{:val 2048 :doc "Function is the outermost frame of the call stack. Call stack unwinders\nshould stop at this function.\n"} TOPFRAME 2048]


  ^{:line 56} [^{:val 4096 :doc "Function is an ABI wrapper.\n"} ABIWRAPPER 4096]


  ^{:line 59} [^{:val 8192 :doc "Function is a compiler-generated package init function.\n"} PKGINIT 8192])

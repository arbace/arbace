;; Values for use in branch instruction BC
;; BC B0,BI,label
;; BO is type of branch + likely bits described below
;; BI is CR value + branch type
;; ex: BEQ CR2,label is BC 12,10,label
;;   12 = BO_BCR
;;   10 = BI_CR2 + BI_EQ

(go/const
  ^{:line 368} [^{:val 0} BI_CR0 0]

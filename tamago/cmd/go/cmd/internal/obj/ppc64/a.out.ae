(go/var ^{:doc "OpenPOWER ABI for Linux Supplement Power Architecture 64-Bit ELF V2 ABI\nhttps://openpowerfoundation.org/?resource_lib=64-bit-elf-v2-abi-specification-power-architecture\n"} PPC64DWARFRegisters (lit (map int16 int16)))

^{:go/end 328} (go/func init []
  ;; f assigns dwarfregister[from:to] = (base):(to-from+base)
  (let [f ^{:go/end 317} (fn [^int16 from ^int16 to ^int16 base]
        (for [r from] (<= r to) (inc! r)
          (aset PPC64DWARFRegisters r (+ (- r from) base))))]


    (f REG_R0 REG_R31 0)
    (f REG_F0 REG_F31 32)
    (f REG_V0 REG_V31 77)
    (f REG_CR0 REG_CR7 68)

    (f REG_VS0 REG_VS31 32) ; overlaps F0-F31
    (f REG_VS32 REG_VS63 77) ; overlaps V0-V31
    (aset PPC64DWARFRegisters REG_LR 65)
    (aset PPC64DWARFRegisters REG_CTR 66)
    (aset PPC64DWARFRegisters REG_XER 76)))













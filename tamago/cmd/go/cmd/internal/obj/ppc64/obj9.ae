^{:go/end 58} (go/func isPPC64DoublewordRotateMask "Test if this value can encoded as a mask for\nli -1, rx; rlic rx,rx,sh,mb.\nMasks can also extend from the msb and wrap to\nthe lsb too. That is, the valid masks are 32 bit strings\nof the form: 0..01..10..0 or 1..10..01..1 or 1...1\n" ^bool [^int64 v64]
  ;; Isolate rightmost 1 (if none 0) and add.
  (let [v (conv uint64 v64)
      ^{:line 53} vp (+ (bit-and v (- v)) v)
      ;; Likewise, for the wrapping case.
      ^{:line 55} vn (bit-not v)
      ^{:line 56} vpn (+ (bit-and vn (- vn)) vn)]
    (and ^:go/paren (or (== (bit-and v vp) 0) (== (bit-and vn vpn) 0)) (!= v 0))))





^{:go/end 76} (go/func encodePPC64RLDCMask "Encode a doubleword rotate mask into mb (mask begin) and\nme (mask end, inclusive). Note, POWER ISA labels bits in\nbig endian order.\n" [^int64 mask] :results [^int mb ^int me]
  ;; Determine boundaries and then decode them
  (set! mb (bits/LeadingZeros64 (conv uint64 mask)))
  (set! me (- 64 (bits/TrailingZeros64 (conv uint64 mask))))
  (let [mbn (bits/LeadingZeros64 (bit-not (conv uint64 mask)))
      ^{:line 68} men (- 64 (bits/TrailingZeros64 (bit-not (conv uint64 mask))))]
    ;; Check for a wrapping mask (e.g bits at 0 and 63)
    (when (and (== mb 0) (== me 64))
      ;; swap the inverted values
      (set! (values mb me) (values men mbn)))

    ;; Note, me is inclusive.
    (return mb (- me 1))))





^{:go/end 92} (go/func isNOTOCfunc "Is this a symbol which should never have a TOC prologue generated?\nThese are special functions which should not have a TOC regeneration\nprologue.\n" ^bool [^string name]
  (switch
    (case [(== name "runtime.duffzero")]
      (return true))
    (case [(== name "runtime.duffcopy")]
      (return true))
    (case [(strings/HasPrefix name "runtime.elf_")]
      (return true))
    (default
      (return false))))





^{:go/end 115} (go/func convertFMOVtoXXSPLTIDP "Try converting FMOVD/FMOVS to XXSPLTIDP. If it is converted,\nreturn true.\n" ^bool [^{:tag (* obj/Prog)} p]
  (when (or (!= (.-Type (.-From p)) obj/TYPE_FCONST) (< buildcfg/GOPPC64 10))
    (return false))

  (let [v (assert float64 (.-Val (.-From p)))]
    (when (!= (conv float64 (conv float32 v)) v)
      (return false))

    ;; Secondly, is this value a normal value?
    (let [ival (conv int64 (math/Float32bits (conv float32 v)))
        ^{:line 106} isDenorm (and (== (bit-and ival 0x7F800000) 0) (!= (bit-and ival 0x007FFFFF) 0))]
      (when (not isDenorm)
        (set! (.-As p) AXXSPLTIDP)
        (set! (.-Type (.-From p)) obj/TYPE_CONST)
        (set! (.-Offset (.-From p)) ival)
        ;; Convert REG_Fx into equivalent REG_VSx
        (set! (.-Reg (.-To p)) (+ REG_VS0 (bit-and (.-Reg (.-To p)) 31))))

      (not isDenorm))))


^{:go/end 326} (go/func progedit [^{:tag (* obj/Link)} ctxt ^{:tag (* obj/Prog)} p ^obj/ProgAlloc newprog]
  (set! (.-Class (.-From p)) 0)
  (set! (.-Class (.-To p)) 0)

  (let [c (lit ctxt9 :ctxt ctxt :newprog newprog)]

    ;; Rewrite BR/BL to symbol as TYPE_BRANCH.
    (switch (.-As p)
      (case [ABR
          ^{:line 126} ABL
          ^{:line 127} obj/ARET
          ^{:line 128} obj/ADUFFZERO
          ^{:line 129} obj/ADUFFCOPY]
        (when (!= (.-Sym (.-To p)) nil)
          (set! (.-Type (.-To p)) obj/TYPE_BRANCH))))



    ;; Rewrite float constants to values stored in memory.
    (switch (.-As p)
      (case [AFMOVS]
        (when (and (== (.-Type (.-From p)) obj/TYPE_FCONST) (not (convertFMOVtoXXSPLTIDP p)))
          (let [f32 (conv float32 (assert float64 (.-Val (.-From p))))]
            (set! (.-Type (.-From p)) obj/TYPE_MEM)
            (set! (.-Sym (.-From p)) (.Float32Sym ctxt f32))
            (set! (.-Name (.-From p)) obj/NAME_EXTERN)
            (set! (.-Offset (.-From p)) 0))))


      (case [AFMOVD]
        (when (== (.-Type (.-From p)) obj/TYPE_FCONST)
          (let [f64 (assert float64 (.-Val (.-From p)))]
            ;; Constant not needed in memory for float +/- 0
            (when (and (!= f64 0) (not (convertFMOVtoXXSPLTIDP p)))
              (set! (.-Type (.-From p)) obj/TYPE_MEM)
              (set! (.-Sym (.-From p)) (.Float64Sym ctxt f64))
              (set! (.-Name (.-From p)) obj/NAME_EXTERN)
              (set! (.-Offset (.-From p)) 0)))))



      (case [AMOVW AMOVWZ]
        ;; Note, for backwards compatibility, MOVW $const, Rx and MOVWZ $const, Rx are identical.
        (when (and (== (.-Type (.-From p)) obj/TYPE_CONST) (!= (.-Offset (.-From p)) 0) (== (bit-and (.-Offset (.-From p)) 0xFFFF) 0))
          ;; This is a constant shifted 16 bits to the left, convert it to ADDIS/ORIS $const,...
          (set! (.-As p) AADDIS)
          ;; Use ORIS for large constants which should not be sign extended.
          (when (>= (.-Offset (.-From p)) 0x80000000)
            (set! (.-As p) AORIS))

          (set! (.-Reg p) REG_R0)
          (set! (.-Offset (.-From p)) >> 16)))


      (case [AMOVD]
        ;; Skip this opcode if it is not a constant load.
        (when (or (!= (.-Type (.-From p)) obj/TYPE_CONST) (!= (.-Name (.-From p)) obj/NAME_NONE) (!= (.-Reg (.-From p)) 0))
          (break))


        ;; 32b constants (signed and unsigned) can be generated via 1 or 2 instructions. They can be assembled directly.
        (let [isS32 (== (conv int64 (conv int32 (.-Offset (.-From p)))) (.-Offset (.-From p)))
            ^{:line 179} isU32 (== (conv uint64 (conv uint32 (.-Offset (.-From p)))) (conv uint64 (.-Offset (.-From p))))
            ;; If prefixed instructions are supported, a 34b signed constant can be generated by one pli instruction.
            ^{:line 181} isS34 (and pfxEnabled (== (>> (<< (.-Offset (.-From p)) 30) 30) (.-Offset (.-From p))))]

          ;; Try converting MOVD $const,Rx into ADDIS/ORIS $s32>>16,R0,Rx
          (switch
            (case [(and isS32 (== (bit-and (.-Offset (.-From p)) 0xFFFF) 0) (!= (.-Offset (.-From p)) 0))]
              (set! (.-As p) AADDIS)
              (set! (.-Offset (.-From p)) >> 16)
              (set! (.-Reg p) REG_R0))

            (case [(and isU32 (== (bit-and (.-Offset (.-From p)) 0xFFFF) 0) (!= (.-Offset (.-From p)) 0))]
              (set! (.-As p) AORIS)
              (set! (.-Offset (.-From p)) >> 16)
              (set! (.-Reg p) REG_R0))

            (case [(or isS32 isU32 isS34)])
            ;; The assembler can generate this opcode in 1 (on Power10) or 2 opcodes.

            ;; Otherwise, see if the large constant can be generated with 2 instructions. If not, load it from memory.
            (default
              ;; Is this a shifted 16b constant? If so, rewrite it to avoid a creating and loading a constant.
              (let [val (.-Offset (.-From p))
                  ^{:line 202} shift (bits/TrailingZeros64 (conv uint64 val))
                  ^{:line 203} mask (<< (conv int64 0xFFFF) shift)]
                (cond (or (== (bit-and val mask) val) ^:go/paren (and (== (>> val (+ shift 16)) -1) (== (<< (>> val shift) shift) val)))
                  ;; Rewrite this value into MOVD $const>>shift, Rto; SLD $shift, Rto
                  (let [q (obj/Appendp p (.-newprog c))]
                    (set! (.-As q) ASLD)
                    (.SetConst (.-From q) (conv int64 shift))
                    (set! (.-To q) (.-To p))
                    (set! (.-Offset (.-From p)) >> shift)
                    (set! p q))
                  (isPPC64DoublewordRotateMask val)
                  ;; This constant is a mask value, generate MOVD $-1, Rto; RLDIC Rto, ^me, mb, Rto
                  (let [(values mb me) (encodePPC64RLDCMask val)
                      ^{:line 215} q (obj/Appendp p (.-newprog c))]
                    (set! (.-As q) ARLDC)
                    (.AddRestSourceConst q (bit-and (bit-not (conv int64 me)) 0x3F))
                    (.AddRestSourceConst q (conv int64 mb))
                    (set! (.-From q) (.-To p))
                    (set! (.-To q) (.-To p))
                    (set! (.-Offset (.-From p)) -1)
                    (set! p q)) :else
                  (do
                    ;; Load the constant from memory.
                    (set! (.-Type (.-From p)) obj/TYPE_MEM)
                    (set! (.-Sym (.-From p)) (.Int64Sym ctxt (.-Offset (.-From p))))
                    (set! (.-Name (.-From p)) obj/NAME_EXTERN)
                    (set! (.-Offset (.-From p)) 0)))))))))




    (switch (.-As p)
      ;; Rewrite SUB constants into ADD.
      (case [ASUBC]
        (when (== (.-Type (.-From p)) obj/TYPE_CONST)
          (set! (.-Offset (.-From p)) (- (.-Offset (.-From p))))
          (set! (.-As p) AADDC)))


      (case [ASUBCCC]
        (when (== (.-Type (.-From p)) obj/TYPE_CONST)
          (set! (.-Offset (.-From p)) (- (.-Offset (.-From p))))
          (set! (.-As p) AADDCCC)))


      (case [ASUB]
        (when (!= (.-Type (.-From p)) obj/TYPE_CONST)
          (break))

        ;; Rewrite SUB $const,... into ADD $-const,...
        (set! (.-Offset (.-From p)) (- (.-Offset (.-From p))))
        (set! (.-As p) AADD)
        ;; This is now an ADD opcode, try simplifying it below.
        (fallthrough))

      ;; Rewrite ADD/OR/XOR/ANDCC $const,... forms into ADDIS/ORIS/XORIS/ANDISCC
      (case [AADD]
        ;; Don't rewrite if this is not adding a constant value, or is not an int32
        (when (or (!= (.-Type (.-From p)) obj/TYPE_CONST) (== (.-Offset (.-From p)) 0) (!= (conv int64 (conv int32 (.-Offset (.-From p)))) (.-Offset (.-From p))))
          (break))

        (cond (== (bit-and (.-Offset (.-From p)) 0xFFFF) 0) (do
            ;; The constant can be added using ADDIS
            (set! (.-As p) AADDIS)
            (set! (.-Offset (.-From p)) >> 16))
          (>= buildcfg/GOPPC64 10)
          ;; Let the assembler generate paddi for large constants.
          (break)
          (or ^:go/paren (and (< (.-Offset (.-From p)) -0x8000) (== (conv int64 (conv int32 (.-Offset (.-From p)))) (.-Offset (.-From p)))) ^:go/paren (and (> (.-Offset (.-From p)) 0xFFFF) (< (.-Offset (.-From p)) 0x7FFF8000)))
          ;; For a constant x, 0xFFFF (UINT16_MAX) < x < 0x7FFF8000 or -0x80000000 (INT32_MIN) <= x < -0x8000 (INT16_MIN)
          ;; This is not done for 0x7FFF < x < 0x10000; the assembler will generate a slightly faster instruction sequence.
          ;;
          ;; The constant x can be rewritten as ADDIS + ADD as follows:
          ;;     ADDIS $x>>16 + (x>>15)&1, rX, rY
          ;;     ADD   $int64(int16(x)), rY, rY
          ;; The range is slightly asymmetric as 0x7FFF8000 and above overflow the sign bit, whereas for
          ;; negative values, this would happen with constant values between -1 and -32768 which can
          ;; assemble into a single addi.
          (let [is (+ (>> (.-Offset (.-From p)) 16) (bit-and (>> (.-Offset (.-From p)) 15) 1))
              ^{:line 281} i (conv int64 (conv int16 (.-Offset (.-From p))))]
            (set! (.-As p) AADDIS)
            (set! (.-Offset (.-From p)) is)
            (let [q (obj/Appendp p (.-newprog c))]
              (set! (.-As q) AADD)
              (.SetConst (.-From q) i)
              (set! (.-Reg q) (.-Reg (.-To p)))
              (set! (.-To q) (.-To p))
              (set! p q)))))

      (case [AOR]
        (when (and (== (.-Type (.-From p)) obj/TYPE_CONST) (== (bit-and (conv uint64 (.-Offset (.-From p))) 0xFFFFFFFF0000FFFF) 0) (!= (.-Offset (.-From p)) 0))
          (set! (.-As p) AORIS)
          (set! (.-Offset (.-From p)) >> 16)))

      (case [AXOR]
        (when (and (== (.-Type (.-From p)) obj/TYPE_CONST) (== (bit-and (conv uint64 (.-Offset (.-From p))) 0xFFFFFFFF0000FFFF) 0) (!= (.-Offset (.-From p)) 0))
          (set! (.-As p) AXORIS)
          (set! (.-Offset (.-From p)) >> 16)))

      (case [AANDCC]
        (when (and (== (.-Type (.-From p)) obj/TYPE_CONST) (== (bit-and (conv uint64 (.-Offset (.-From p))) 0xFFFFFFFF0000FFFF) 0) (!= (.-Offset (.-From p)) 0))
          (set! (.-As p) AANDISCC)
          (set! (.-Offset (.-From p)) >> 16)))


      ;; To maintain backwards compatibility, we accept some 4 argument usage of
      ;; several opcodes which was likely not intended, but did work. These are not
      ;; added to optab to avoid the chance this behavior might be used with newer
      ;; instructions.
      ;;
      ;; Rewrite argument ordering like "ADDEX R3, $3, R4, R5" into
      ;;                                "ADDEX R3, R4, $3, R5"
      (case [AVSHASIGMAW AVSHASIGMAD AADDEX AXXSLDWI AXXPERMDI]
        (when (and (== (len (.-RestArgs p)) 2) (== (.-Reg p) 0) (== (.-Type (.-Addr (aget (.-RestArgs p) 0))) obj/TYPE_CONST) (== (.-Type (.-Addr (aget (.-RestArgs p) 1))) obj/TYPE_REG))
          (set! (.-Reg p) (.-Reg (.-Addr (aget (.-RestArgs p) 1))))
          (set! (.-RestArgs p) (subslice (.-RestArgs p) _ 1)))))



    (cond (== (.-Headtype (.-ctxt c)) objabi/Haix)
      (.rewriteToUseTOC c p)
      (.-Flag_dynlink (.-ctxt c))
      (.rewriteToUseGot c p))))





^{:go/end 494} (go/method rewriteToUseTOC "Rewrite p, if necessary, to access a symbol using its TOC anchor.\nThis code is for AIX only.\n" [^{:tag (* ctxt9)} c ^{:tag (* obj/Prog)} p]
  (when (or (== (.-As p) obj/ATEXT) (== (.-As p) obj/AFUNCDATA) (== (.-As p) obj/ACALL) (== (.-As p) obj/ARET) (== (.-As p) obj/AJMP))
    (return))


  (when (or (== (.-As p) obj/ADUFFCOPY) (== (.-As p) obj/ADUFFZERO))
    ;; ADUFFZERO/ADUFFCOPY is considered as an ABL except in dynamic
    ;; link where it should be an indirect call.
    (when (not (.-Flag_dynlink (.-ctxt c)))
      (return))

    ;;     ADUFFxxx $offset
    ;; becomes
    ;;     MOVD runtime.duffxxx@TOC, R12
    ;;     ADD $offset, R12
    ;;     MOVD R12, LR
    ;;     BL (LR)
    (let [^{:tag (* obj/LSym)} sym (zero (* obj/LSym))]
      (if (== (.-As p) obj/ADUFFZERO)
        (set! sym (.Lookup (.-ctxt c) "runtime.duffzero"))

        (set! sym (.Lookup (.-ctxt c) "runtime.duffcopy")))

      ;; Retrieve or create the TOC anchor.
      (let [symtoc (.LookupInit (.-ctxt c) (+ "TOC." (.-Name sym)) ^{:go/end 360} (fn [^{:tag (* obj/LSym)} s]
              (set! (.-Type s) objabi/SDATA)
              ^{:go/via [Attribute]} (.Set s obj/AttrDuplicateOK true)
              ^{:go/via [Attribute]} (.Set s obj/AttrStatic true)
              (set! (.-Data (.-ctxt c)) (append (.-Data (.-ctxt c)) s))
              (.WriteAddr s (.-ctxt c) 0 8 sym 0)))


          ^{:line 362} offset (.-Offset (.-To p))]
        (set! (.-As p) AMOVD)
        (set! (.-Type (.-From p)) obj/TYPE_MEM)
        (set! (.-Name (.-From p)) obj/NAME_TOCREF)
        (set! (.-Sym (.-From p)) symtoc)
        (set! (.-Type (.-To p)) obj/TYPE_REG)
        (set! (.-Reg (.-To p)) REG_R12)
        (set! (.-Name (.-To p)) obj/NAME_NONE)
        (set! (.-Offset (.-To p)) 0)
        (set! (.-Sym (.-To p)) nil)
        (let [p1 (obj/Appendp p (.-newprog c))]
          (set! (.-As p1) AADD)
          (set! (.-Type (.-From p1)) obj/TYPE_CONST)
          (set! (.-Offset (.-From p1)) offset)
          (set! (.-Type (.-To p1)) obj/TYPE_REG)
          (set! (.-Reg (.-To p1)) REG_R12)
          (let [p2 (obj/Appendp p1 (.-newprog c))]
            (set! (.-As p2) AMOVD)
            (set! (.-Type (.-From p2)) obj/TYPE_REG)
            (set! (.-Reg (.-From p2)) REG_R12)
            (set! (.-Type (.-To p2)) obj/TYPE_REG)
            (set! (.-Reg (.-To p2)) REG_LR)
            (let [p3 (obj/Appendp p2 (.-newprog c))]
              (set! (.-As p3) obj/ACALL)
              (set! (.-Type (.-To p3)) obj/TYPE_REG)
              (set! (.-Reg (.-To p3)) REG_LR)))))))


  (let [^{:tag (* obj/Addr)} source (zero (* obj/Addr))]
    (cond (or (== (.-Name (.-From p)) obj/NAME_EXTERN) (== (.-Name (.-From p)) obj/NAME_STATIC)) (do
        (cond (== (.-Type (.-From p)) obj/TYPE_ADDR) (do
            (when (== (.-As p) ADWORD)
              ;; ADWORD $sym doesn't need TOC anchor
              (return))

            (when (!= (.-As p) AMOVD)
              (.Diag (.-ctxt c) "do not know how to handle TYPE_ADDR in %v" p)
              (return))

            (when (!= (.-Type (.-To p)) obj/TYPE_REG)
              (.Diag (.-ctxt c) "do not know how to handle LEAQ-type insn to non-register in %v" p)
              (return)))

          (!= (.-Type (.-From p)) obj/TYPE_MEM) (do
            (.Diag (.-ctxt c) "do not know how to handle %v without TYPE_MEM" p)
            (return)))

        (set! source (addr (.-From p))))

      (or (== (.-Name (.-To p)) obj/NAME_EXTERN) (== (.-Name (.-To p)) obj/NAME_STATIC)) (do
        (when (!= (.-Type (.-To p)) obj/TYPE_MEM)
          (.Diag (.-ctxt c) "do not know how to handle %v without TYPE_MEM" p)
          (return))

        (when (!= source nil)
          (.Diag (.-ctxt c) "cannot handle symbols on both sides in %v" p)
          (return))

        (set! source (addr (.-To p)))) :else

      (return))



    (when (== (.-Sym source) nil)
      (.Diag (.-ctxt c) "do not know how to handle nil symbol in %v" p)
      (return))


    (when (== (.-Type (.-Sym source)) objabi/STLSBSS)
      (return))


    ;; Retrieve or create the TOC anchor.
    (let [symtoc (.LookupInit (.-ctxt c) (+ "TOC." (.-Name (.-Sym source))) ^{:go/end 442} (fn [^{:tag (* obj/LSym)} s]
            (set! (.-Type s) objabi/SDATA)
            ^{:go/via [Attribute]} (.Set s obj/AttrDuplicateOK true)
            ^{:go/via [Attribute]} (.Set s obj/AttrStatic true)
            (set! (.-Data (.-ctxt c)) (append (.-Data (.-ctxt c)) s))
            (.WriteAddr s (.-ctxt c) 0 8 (.-Sym source) 0)))]


      (when (== (.-Type source) obj/TYPE_ADDR)
        ;; MOVD $sym, Rx becomes MOVD symtoc, Rx
        ;; MOVD $sym+<off>, Rx becomes MOVD symtoc, Rx; ADD <off>, Rx
        (set! (.-Type (.-From p)) obj/TYPE_MEM)
        (set! (.-Sym (.-From p)) symtoc)
        (set! (.-Name (.-From p)) obj/NAME_TOCREF)

        (when (!= (.-Offset (.-From p)) 0)
          (let [q (obj/Appendp p (.-newprog c))]
            (set! (.-As q) AADD)
            (set! (.-Type (.-From q)) obj/TYPE_CONST)
            (set! (.-Offset (.-From q)) (.-Offset (.-From p)))
            (set! (.-Offset (.-From p)) 0)
            (set! (.-To q) (.-To p))))

        (return))



      ;; MOVx sym, Ry becomes MOVD symtoc, REGTMP; MOVx (REGTMP), Ry
      ;; MOVx Ry, sym becomes MOVD symtoc, REGTMP; MOVx Ry, (REGTMP)
      ;; An addition may be inserted between the two MOVs if there is an offset.

      (let [q (obj/Appendp p (.-newprog c))]
        (set! (.-As q) AMOVD)
        (set! (.-Type (.-From q)) obj/TYPE_MEM)
        (set! (.-Sym (.-From q)) symtoc)
        (set! (.-Name (.-From q)) obj/NAME_TOCREF)
        (set! (.-Type (.-To q)) obj/TYPE_REG)
        (set! (.-Reg (.-To q)) REGTMP)

        (set! q (obj/Appendp q (.-newprog c)))
        (set! (.-As q) (.-As p))
        (set! (.-From q) (.-From p))
        (set! (.-To q) (.-To p))
        (cond (!= (.-Name (.-From p)) obj/NAME_NONE) (do
            (set! (.-Type (.-From q)) obj/TYPE_MEM)
            (set! (.-Reg (.-From q)) REGTMP)
            (set! (.-Name (.-From q)) obj/NAME_NONE)
            (set! (.-Sym (.-From q)) nil))
          (!= (.-Name (.-To p)) obj/NAME_NONE) (do
            (set! (.-Type (.-To q)) obj/TYPE_MEM)
            (set! (.-Reg (.-To q)) REGTMP)
            (set! (.-Name (.-To q)) obj/NAME_NONE)
            (set! (.-Sym (.-To q)) nil)) :else

          (.Diag (.-ctxt c) "unreachable case in rewriteToUseTOC with %v" p))


        (obj/Nopout p)))))



^{:go/end 613} (go/method rewriteToUseGot "Rewrite p, if necessary, to access global data via the global offset table.\n" [^{:tag (* ctxt9)} c ^{:tag (* obj/Prog)} p]
  (when (or (== (.-As p) obj/ADUFFCOPY) (== (.-As p) obj/ADUFFZERO))
    ;;     ADUFFxxx $offset
    ;; becomes
    ;;     MOVD runtime.duffxxx@GOT, R12
    ;;     ADD $offset, R12
    ;;     MOVD R12, LR
    ;;     BL (LR)
    (let [^{:tag (* obj/LSym)} sym (zero (* obj/LSym))]
      (if (== (.-As p) obj/ADUFFZERO)
        (set! sym (.LookupABI (.-ctxt c) "runtime.duffzero" obj/ABIInternal))

        (set! sym (.LookupABI (.-ctxt c) "runtime.duffcopy" obj/ABIInternal)))

      (let [offset (.-Offset (.-To p))]
        (set! (.-As p) AMOVD)
        (set! (.-Type (.-From p)) obj/TYPE_MEM)
        (set! (.-Name (.-From p)) obj/NAME_GOTREF)
        (set! (.-Sym (.-From p)) sym)
        (set! (.-Type (.-To p)) obj/TYPE_REG)
        (set! (.-Reg (.-To p)) REG_R12)

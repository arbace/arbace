^{:go/end 899} (go/func type_brw "brw RA,RS\n" [^{:tag (* ctxt9)} c ^{:tag (* obj/Prog)} p ^{:tag (* Optab)} t ^{:tag (* (array 5 uint32))} out]
  (let [o0 (aget GenOpcodes (- (.-As p) AXXSETACCZ))]
    (set! o0 bit-or (<< (conv uint32 (bit-and (.-Reg (.-To p)) 0x1f)) 16)) ; RA
    (set! o0 bit-or (<< (conv uint32 (bit-and (.-Reg (.-From p)) 0x1f)) 21)) ; RS
    (aset out 0 o0)))



^{:go/end 912} (go/func type_hashchkp "hashchkp RB,offset(RA)\n" [^{:tag (* ctxt9)} c ^{:tag (* obj/Prog)} p ^{:tag (* Optab)} t ^{:tag (* (array 5 uint32))} out]
  (let [o0 (aget GenOpcodes (- (.-As p) AXXSETACCZ))]
    (set! o0 bit-or (<< (conv uint32 (bit-and (.-Reg (.-To p)) 0x1f)) 11)) ; RB
    (set! o0 bit-or (<< (conv uint32 (bit-and (>> (.-Offset (.-From p)) 8) 0x1)) 0)) ; DX
    (set! o0 bit-or (<< (conv uint32 (bit-and (>> (.-Offset (.-From p)) 3) 0x1f)) 21)) ; D
    (set! o0 bit-or (<< (conv uint32 (bit-and (.-Reg (.-From p)) 0x1f)) 16)) ; RA
    (when (!= (bit-and (.-Offset (.-From p)) 0xfffffe07) 0xfffffe00)
      (.Diag (.-ctxt c) "Constant(%d) must within the range of [-512,-8] in steps of 8\n%v" (.-Offset (.-From p)) p))

    (aset out 0 o0)))




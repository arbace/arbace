        (let [r (conv int (.-Reg (.-From p)))]

          (set! o1 (AOP_RRR (.oploadx c (.-As p)) (conv uint32 (.-Reg (.-To p))) (conv uint32 (.-Index (.-From p))) (conv uint32 r)))

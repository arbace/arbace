            (case [ADIVW] ; /* op Rb[,Ra],Rd */
              (opset AMULHW r0)

              (opset AMULHWCC r0)
              (opset AMULHWU r0)
              (opset AMULHWUCC r0)
              (opset AMULLWCC r0)

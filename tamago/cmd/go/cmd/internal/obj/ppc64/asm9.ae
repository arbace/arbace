      (case [101]
        (set! o1 (AOP_XX2 (.oprrr c (.-As p)) (conv uint32 (.-Reg (.-To p))) (conv uint32 0) (conv uint32 (.-Reg (.-From p))))))

      (case [104] ; /* VSX mtvsr* instructions, XX1-form RA,RB,XT */
        (set! o1 (AOP_XX1 (.oprrr c (.-As p)) (conv uint32 (.-Reg (.-To p))) (conv uint32 (.-Reg (.-From p))) (conv uint32 (.-Reg p)))))

      (case [106] ; /* MOVD spr, soreg */
        (let [v (conv int32 (.-Reg (.-From p)))]
          (set! o1 (OPVCC 31 339 0 0)) ; /* mfspr */
          (set! o1 (bit-or (AOP_RRR o1 (conv uint32 REGTMP) 0 0) (<< (bit-and (conv uint32 v) 0x1f) 16) (<< (bit-and (>> (conv uint32 v) 5) 0x1f) 11)))
          (let [so (.regoff c (addr (.-To p)))]
            (set! o2 (AOP_IRR (.opstore c AMOVD) (conv uint32 REGTMP) (conv uint32 (.-Reg (.-To p))) (conv uint32 so)))
            (when (!= (bit-and so 0x3) 0)

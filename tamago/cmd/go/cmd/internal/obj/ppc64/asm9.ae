        ;; /* reg none reg OR reg imm reg */
        ;; /* 2-register operand order: XB, XT or XB, UIM, XT*/
        (let [uim (conv int (.regoff c (.GetFrom3 p)))]
          (set! o1 (AOP_XX2 (.oprrr c (.-As p)) (conv uint32 (.-Reg (.-To p))) (conv uint32 uim) (conv uint32 (.-Reg (.-From p)))))))

      (case [90] ; /* VSX instructions, XX3-form */
        (cond (== (.From3Type p) obj/TYPE_NONE)
          ;; /* reg reg reg */
          ;; /* 3-register operand order: XA, XB, XT */
          (set! o1 (AOP_XX3 (.oprrr c (.-As p)) (conv uint32 (.-Reg (.-To p))) (conv uint32 (.-Reg (.-From p))) (conv uint32 (.-Reg p))))
          (== (.From3Type p) obj/TYPE_CONST)
          ;; /* reg reg reg imm */
          ;; /* operand order: XA, XB, DM, XT */
          (let [dm (conv int (.regoff c (.GetFrom3 p)))]
            (set! o1 (AOP_XX3I (.oprrr c (.-As p)) (conv uint32 (.-Reg (.-To p))) (conv uint32 (.-Reg (.-From p))) (conv uint32 (.-Reg p)) (conv uint32 dm))))))


      (case [91] ; /* VSX instructions, XX4-form */
        ;; /* reg reg reg reg */
        ;; /* 3-register operand order: XA, XB, XC, XT */
        (set! o1 (AOP_XX4 (.oprrr c (.-As p)) (conv uint32 (.-Reg (.-To p))) (conv uint32 (.-Reg (.-From p))) (conv uint32 (.-Reg p)) (conv uint32 (.-Reg (.GetFrom3 p))))))

      (case [92] ; /* X-form instructions, 3-operands */
        (cond (== (.-Type (.-To p)) obj/TYPE_CONST)
          ;; /* imm reg reg */
          (let [xf (conv int32 (.-Reg (.-From p)))]
            (if (and (<= REG_F0 xf) (<= xf REG_F31))
              ;; /* operand order: FRA, FRB, BF */
              (let [bf (<< (conv int (.regoff c (addr (.-To p)))) 2)]
                (set! o1 (AOP_RRR (.opirr c (.-As p)) (conv uint32 bf) (conv uint32 (.-Reg (.-From p))) (conv uint32 (.-Reg p)))))

              ;; /* operand order: RA, RB, L */
              (let [l (conv int (.regoff c (addr (.-To p))))]
                (set! o1 (AOP_RRR (.opirr c (.-As p)) (conv uint32 l) (conv uint32 (.-Reg (.-From p))) (conv uint32 (.-Reg p)))))))

          (== (.From3Type p) obj/TYPE_CONST)
          ;; /* reg reg imm */
          ;; /* operand order: RB, L, RA */
          (let [l (conv int (.regoff c (.GetFrom3 p)))]
            (set! o1 (AOP_RRR (.opirr c (.-As p)) (conv uint32 l) (conv uint32 (.-Reg (.-To p))) (conv uint32 (.-Reg (.-From p))))))
          (== (.-Type (.-To p)) obj/TYPE_REG)
          (let [cr (conv int32 (.-Reg (.-To p)))]
            (cond (and (<= REG_CR0 cr) (<= cr REG_CR7))
              ;; /* cr reg reg */
              ;; /* operand order: RA, RB, BF */
              (let [bf (<< (bit-and (conv int (.-Reg (.-To p))) 7) 2)]
                (set! o1 (AOP_RRR (.opirr c (.-As p)) (conv uint32 bf) (conv uint32 (.-Reg (.-From p))) (conv uint32 (.-Reg p)))))
              (== (.-Type (.-From p)) obj/TYPE_CONST)
              ;; /* reg imm */
              ;; /* operand order: L, RT */
              (let [l (conv int (.regoff c (addr (.-From p))))]
                (set! o1 (AOP_RRR (.opirr c (.-As p)) (conv uint32 (.-Reg (.-To p))) (conv uint32 l) (conv uint32 (.-Reg p))))) :else


(go/type PrefixableOptab "These are opcodes above which may generate different sequences depending on whether prefix opcode support\nis available\n" (struct
    ^{:line 526} Optab
    ^{:line 527 :tag int} minGOPPC64 ; Minimum GOPPC64 required to support this.
    ^{:line 528 :tag int8} pfxsize)) ; Instruction sequence size when prefixed opcodes are used
















(go/var ^{:doc "The prefixable optab entry contains the pseudo-opcodes which generate relocations, or may generate\na more efficient sequence of instructions if a prefixed version exists (ex. paddi instead of oris/ori/add).\n\nThis table is meant to transform all sequences which might be TOC-relative into an equivalent PC-relative\nsequence. It also encompasses several transformations which do not involve relocations, those could be\nseparated and applied to AIX and other non-ELF targets. Likewise, the prefixed forms do not have encoding\nrestrictions on the offset, so they are also used for static binary to allow better code generation. e.x\n\n\tMOVD something-byte-aligned(Rx), Ry\n\tMOVD 3(Rx), Ry\n\nis allowed when the prefixed forms are used.\n\nThis requires an ISA 3.1 compatible cpu (e.g Power10), and when linking externally an ELFv2 1.5 compliant.\n"} prefixableOptab (lit (slice PrefixableOptab)
    (lit _ :Optab (lit Optab :as AMOVD :a1 C_S34CON :a6 C_REG :type_ 19 :size 8) :minGOPPC64 10 :pfxsize 8)
    (lit _ :Optab (lit Optab :as AMOVD :a1 C_ADDR :a6 C_REG :type_ 75 :size 8) :minGOPPC64 10 :pfxsize 8)
    (lit _ :Optab (lit Optab :as AMOVD :a1 C_TLS_LE :a6 C_REG :type_ 79 :size 8) :minGOPPC64 10 :pfxsize 8)
    (lit _ :Optab (lit Optab :as AMOVD :a1 C_TLS_IE :a6 C_REG :type_ 80 :size 12) :minGOPPC64 10 :pfxsize 12)
    (lit _ :Optab (lit Optab :as AMOVD :a1 C_LACON :a6 C_REG :type_ 26 :size 8) :minGOPPC64 10 :pfxsize 8)
    (lit _ :Optab (lit Optab :as AMOVD :a1 C_LOREG :a6 C_REG :type_ 36 :size 8) :minGOPPC64 10 :pfxsize 8)
    (lit _ :Optab (lit Optab :as AMOVD :a1 C_REG :a6 C_LOREG :type_ 35 :size 8) :minGOPPC64 10 :pfxsize 8)
    (lit _ :Optab (lit Optab :as AMOVD :a1 C_REG :a6 C_ADDR :type_ 74 :size 8) :minGOPPC64 10 :pfxsize 8)

    (lit _ :Optab (lit Optab :as AMOVW :a1 C_32CON :a6 C_REG :type_ 19 :size 8) :minGOPPC64 10 :pfxsize 8)
    (lit _ :Optab (lit Optab :as AMOVW :a1 C_LACON :a6 C_REG :type_ 26 :size 8) :minGOPPC64 10 :pfxsize 8)
    (lit _ :Optab (lit Optab :as AMOVW :a1 C_LOREG :a6 C_REG :type_ 36 :size 8) :minGOPPC64 10 :pfxsize 8)
    (lit _ :Optab (lit Optab :as AMOVW :a1 C_ADDR :a6 C_REG :type_ 75 :size 8) :minGOPPC64 10 :pfxsize 8)
    (lit _ :Optab (lit Optab :as AMOVW :a1 C_REG :a6 C_LOREG :type_ 35 :size 8) :minGOPPC64 10 :pfxsize 8)
    (lit _ :Optab (lit Optab :as AMOVW :a1 C_REG :a6 C_ADDR :type_ 74 :size 8) :minGOPPC64 10 :pfxsize 8)

    (lit _ :Optab (lit Optab :as AMOVB :a1 C_REG :a6 C_LOREG :type_ 35 :size 8) :minGOPPC64 10 :pfxsize 8)
    (lit _ :Optab (lit Optab :as AMOVB :a1 C_LOREG :a6 C_REG :type_ 36 :size 12) :minGOPPC64 10 :pfxsize 12)
    (lit _ :Optab (lit Optab :as AMOVB :a1 C_ADDR :a6 C_REG :type_ 75 :size 12) :minGOPPC64 10 :pfxsize 12)
    (lit _ :Optab (lit Optab :as AMOVB :a1 C_REG :a6 C_ADDR :type_ 74 :size 8) :minGOPPC64 10 :pfxsize 8)

    (lit _ :Optab (lit Optab :as AMOVBZ :a1 C_LOREG :a6 C_REG :type_ 36 :size 8) :minGOPPC64 10 :pfxsize 8)
    (lit _ :Optab (lit Optab :as AMOVBZ :a1 C_ADDR :a6 C_REG :type_ 75 :size 8) :minGOPPC64 10 :pfxsize 8)
    (lit _ :Optab (lit Optab :as AMOVBZ :a1 C_REG :a6 C_LOREG :type_ 35 :size 8) :minGOPPC64 10 :pfxsize 8)
    (lit _ :Optab (lit Optab :as AMOVBZ :a1 C_REG :a6 C_ADDR :type_ 74 :size 8) :minGOPPC64 10 :pfxsize 8)


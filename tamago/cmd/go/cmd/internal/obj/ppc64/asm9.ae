      ;; This happens in the cmd/asm tests,
      ;; each of which re-initializes the arch.
      (return))

    (set! buildOpCfg cfg)

    ;; Configure the optab entries which may generate prefix opcodes.
    (let [prefixOptab (make (slice Optab) 0 (len prefixableOptab))]
      (range [_ entry prefixableOptab]
        (let [entry entry]
          (when (and pfxEnabled (>= buildcfg/GOPPC64 (.-minGOPPC64 entry)))
            ;; Enable prefix opcode generation and resize.
            (set! ^{:go/via [Optab]} (.-ispfx entry) true)
            (set! ^{:go/via [Optab]} (.-size entry) (.-pfxsize entry)))

          (set! prefixOptab (append prefixOptab (.-Optab entry)))))



      (for [i 0] (< i C_NCLASS) (inc! i)
        (for [n 0] (< n C_NCLASS) (inc! n)
          (when (cmp n i)
            (aset (aget xcmp i) n true))))




      ;; Append the generated entries, sort, and fill out oprange.
      (set! optab (make (slice Optab) 0 (+ (len optabBase) (len optabGen) (len prefixOptab))))
      (set! optab (append optab (spread optabBase)))
      (set! optab (append optab (spread optabGen)))
      (set! optab (append optab (spread prefixOptab)))
      (sort/Slice optab optabLess)

      (range [i optab]
        ;; Use the legacy assembler function if none provided.
        (when (== (.-asmout (aget optab i)) nil)
          (set! (.-asmout (aget optab i)) asmout)))



      (for [i 0] (< i (len optab)) _
        (let [r (.-as (aget optab i))
            ^{:line 1304} r0 (bit-and r obj/AMask)
            ^{:line 1305} start i]
          (while (and (< i (len optab)) (== (.-as (aget optab i)) r))
            (inc! i))

          (aset oprange r0 (subslice optab start i))

          (switch r
            (default
              (when (not (opsetGen r))
                (.Diag ctxt "unknown op in build: %v" r)
                (log/Fatalf "instruction missing from switch in asm9.go:buildop: %v" r)))


            (case [ADCBF] ; /* unary indexed: op (b+a); op (b) */
              (opset ADCBI r0)

              (opset ADCBST r0)
              (opset ADCBT r0)
              (opset ADCBTST r0)
              (opset ADCBZ r0)
              (opset AICBI r0))

            (case [ASTDCCC] ; /* indexed store: op s,(b+a); op s,(b) */

                  ;; /* reg reg reg */
                  ;; /* operand order: RS, RB, RA */
                  (set! o1 (AOP_RRR (.oprrr c (.-As p)) (conv uint32 (.-Reg (.-From p))) (conv uint32 (.-Reg (.-To p))) (conv uint32 (.-Reg p))))))))))




      (case [93] ; /* X-form instructions, 2-operands */
        (cond (== (.-Type (.-To p)) obj/TYPE_CONST)
          ;; /* imm reg */
          ;; /* operand order: FRB, BF */
          (let [bf (<< (conv int (.regoff c (addr (.-To p)))) 2)]

^{:go/breaks [[5 607]] :go/end 608} (go/func addpad "padding bytes to add to align code as requested.\n" ^int [^int64 pc ^int64 a ^{:tag (* obj/Link)} ctxt ^{:tag (* obj/LSym)} cursym]
  (switch a
    (case [8 16 32 64]
      ;; By default function alignment is 16. If an alignment > 16 is
      ;; requested then the function alignment must also be promoted.
      ;; The function alignment is not promoted on AIX at this time.
      ;; TODO: Investigate AIX function alignment.
      (when (and (!= (.-Headtype ctxt) objabi/Haix) (< (.-Align cursym) (conv int16 a)))
        (set! (.-Align cursym) (conv int16 a)))

      (when (!= (bit-and pc (- a 1)) 0)

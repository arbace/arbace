          (set! o1 (AOP_DQ (.opstore c (.-As p)) (conv uint32 (.-Reg (.-From p))) (conv uint32 (.-Reg (.-To p))) (conv uint32 dq)))))
      (case [98] ; /* VSX indexed load or load with length (also left-justified), x-form */
        ;; /* vsreg, reg, reg */
        (set! o1 (AOP_XX1 (.opload c (.-As p)) (conv uint32 (.-Reg (.-To p))) (conv uint32 (.-Reg (.-From p))) (conv uint32 (.-Reg p)))))
      (case [99] ; /* VSX store with length (also left-justified) x-form */
        ;; /* reg, reg, vsreg */

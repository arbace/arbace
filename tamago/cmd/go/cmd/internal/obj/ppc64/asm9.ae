    (lit _ :Optab (lit Optab :as AFMOVD :a1 C_FREG :a6 C_ADDR :type_ 74 :size 8) :minGOPPC64 10 :pfxsize 8)

    (lit _ :Optab (lit Optab :as AADD :a1 C_32CON :a2 C_REG :a6 C_REG :type_ 22 :size 12) :minGOPPC64 10 :pfxsize 8)

      (case [108] ; /* mov r, xoreg ==> stwx rx,ry */
        (let [r (conv int (.-Reg (.-To p)))]
          (set! o1 (AOP_RRR (.opstorex c (.-As p)) (conv uint32 (.-Reg (.-From p))) (conv uint32 (.-Index (.-To p))) (conv uint32 r)))))


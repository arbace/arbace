    (aset out 1 o2)
    (aset out 2 o3)
    (aset out 3 o4)
    (aset out 4 o5)))


^{:go/end 3918} (go/method vregoff ^int64 [^{:tag (* ctxt9)} c ^{:tag (* obj/Addr)} a]

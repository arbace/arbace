            (when (== (.-Reg (.-To p)) REGTMP)
              (log/Fatalf "SPR move to memory will clobber R31 %v" p)))))


      (case [107] ; /* MOVD soreg, spr */
        (let [v (conv int32 (.-Reg (.-From p)))
            ^{:line 3879} so (.regoff c (addr (.-From p)))]
          (set! o1 (AOP_IRR (.opload c AMOVD) (conv uint32 REGTMP) (conv uint32 v) (conv uint32 so)))
          (set! o2 (OPVCC 31 467 0 0)) ; /* mtspr */
          (set! v (conv int32 (.-Reg (.-To p))))
          (set! o2 (bit-or (AOP_RRR o2 (conv uint32 REGTMP) 0 0) (<< (bit-and (conv uint32 v) 0x1f) 16) (<< (bit-and (>> (conv uint32 v) 5) 0x1f) 11)))

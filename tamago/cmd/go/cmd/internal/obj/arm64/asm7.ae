    (lit _ AFMOVD C_ROFF C_NONE C_NONE C_FREG C_NONE 98 4 0 0 0)

    ;; /* store with extended register offset */
    (lit _ AMOVD C_ZREG C_NONE C_NONE C_ROFF C_NONE 99 4 0 0 0)
    (lit _ AMOVW C_ZREG C_NONE C_NONE C_ROFF C_NONE 99 4 0 0 0)
    (lit _ AMOVH C_ZREG C_NONE C_NONE C_ROFF C_NONE 99 4 0 0 0)

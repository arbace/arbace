    (lit _ AFMOVQ C_NSAUTO C_NONE C_NONE C_FREG C_NONE 21 4 REGSP 0 0)
    (lit _ AFMOVQ C_NSOREG C_NONE C_NONE C_FREG C_NONE 21 4 0 0 0)

    ;; /* long displacement store */
    (lit _ AMOVB C_ZREG C_NONE C_NONE C_LAUTO C_NONE 30 8 REGSP 0 0)
    (lit _ AMOVB C_ZREG C_NONE C_NONE C_LAUTOPOOL C_NONE 30 8 REGSP LTO 0)
    (lit _ AMOVB C_ZREG C_NONE C_NONE C_LOREG C_NONE 30 8 0 0 0)
    (lit _ AMOVB C_ZREG C_NONE C_NONE C_LOREGPOOL C_NONE 30 8 0 LTO 0)
    (lit _ AMOVH C_ZREG C_NONE C_NONE C_LAUTO C_NONE 30 8 REGSP 0 0)
    (lit _ AMOVH C_ZREG C_NONE C_NONE C_LAUTOPOOL C_NONE 30 8 REGSP LTO 0)
    (lit _ AMOVH C_ZREG C_NONE C_NONE C_LOREG C_NONE 30 8 0 0 0)
    (lit _ AMOVH C_ZREG C_NONE C_NONE C_LOREGPOOL C_NONE 30 8 0 LTO 0)
    (lit _ AMOVW C_ZREG C_NONE C_NONE C_LAUTO C_NONE 30 8 REGSP 0 0)
    (lit _ AMOVW C_ZREG C_NONE C_NONE C_LAUTOPOOL C_NONE 30 8 REGSP LTO 0)
    (lit _ AMOVW C_ZREG C_NONE C_NONE C_LOREG C_NONE 30 8 0 0 0)
    (lit _ AMOVW C_ZREG C_NONE C_NONE C_LOREGPOOL C_NONE 30 8 0 LTO 0)
    (lit _ AMOVD C_ZREG C_NONE C_NONE C_LAUTO C_NONE 30 8 REGSP 0 0)
    (lit _ AMOVD C_ZREG C_NONE C_NONE C_LAUTOPOOL C_NONE 30 8 REGSP LTO 0)
    (lit _ AMOVD C_ZREG C_NONE C_NONE C_LOREG C_NONE 30 8 0 0 0)
    (lit _ AMOVD C_ZREG C_NONE C_NONE C_LOREGPOOL C_NONE 30 8 0 LTO 0)

    (lit _ AFMOVS C_FREG C_NONE C_NONE C_LAUTO C_NONE 30 8 REGSP 0 0)
    (lit _ AFMOVS C_FREG C_NONE C_NONE C_LAUTOPOOL C_NONE 30 8 REGSP LTO 0)
    (lit _ AFMOVS C_FREG C_NONE C_NONE C_LOREG C_NONE 30 8 0 0 0)
    (lit _ AFMOVS C_FREG C_NONE C_NONE C_LOREGPOOL C_NONE 30 8 0 LTO 0)
    (lit _ AFMOVD C_FREG C_NONE C_NONE C_LAUTO C_NONE 30 8 REGSP 0 0)
    (lit _ AFMOVD C_FREG C_NONE C_NONE C_LAUTOPOOL C_NONE 30 8 REGSP LTO 0)
    (lit _ AFMOVD C_FREG C_NONE C_NONE C_LOREG C_NONE 30 8 0 0 0)
    (lit _ AFMOVD C_FREG C_NONE C_NONE C_LOREGPOOL C_NONE 30 8 0 LTO 0)
    (lit _ AFMOVQ C_FREG C_NONE C_NONE C_LAUTO C_NONE 30 8 REGSP 0 0)
    (lit _ AFMOVQ C_FREG C_NONE C_NONE C_LAUTOPOOL C_NONE 30 8 REGSP LTO 0)
    (lit _ AFMOVQ C_FREG C_NONE C_NONE C_LOREG C_NONE 30 8 0 0 0)
    (lit _ AFMOVQ C_FREG C_NONE C_NONE C_LOREGPOOL C_NONE 30 8 0 LTO 0)

    ;; /* long displacement load */
    (lit _ AMOVB C_LAUTO C_NONE C_NONE C_ZREG C_NONE 31 8 REGSP 0 0)
    (lit _ AMOVB C_LAUTOPOOL C_NONE C_NONE C_ZREG C_NONE 31 8 REGSP LFROM 0)
    (lit _ AMOVB C_LOREG C_NONE C_NONE C_ZREG C_NONE 31 8 0 0 0)

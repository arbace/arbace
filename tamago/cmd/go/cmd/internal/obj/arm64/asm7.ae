            (if (== (.-Type a) obj/TYPE_MEM)
              (set! (.-Index a) (+ REG_ZARNG (bit-and reg 31) (conv int16 (<< (bit-and arng 15) 5))))

              (set! (.-Reg a) (+ REG_ZARNG (bit-and reg 31) (conv int16 (<< (bit-and arng 15) 5))))))))


      (and (<= REG_P0 reg) (<= reg REG_PN15))
      (let [^int arng (zero int)]
        (switch ext
          (case ["B"]
            (set! arng ARNG_B))
          (case ["H"]
            (set! arng ARNG_H))
          (case ["S"]
            (set! arng ARNG_S))
          (case ["D"]
            (set! arng ARNG_D))
          (case ["Q"]
            (set! arng ARNG_Q))
          (case ["Z"]
            (set! arng PRED_Z))
          (case ["M"]
            (set! arng PRED_M))
          (default
            (when (and isIndex (== ext ""))
              (set! (.-Reg a) (+ REG_PZELEM (bit-and reg 31) (<< 1 5)))
              (set! (.-Index a) num)
              (return nil))

            (return (errors/New (+ "invalid P register arrangement: " ext)))))

        (set! (.-Reg a) (+ REG_PARNGZM (bit-and reg 31) (conv int16 (<< (bit-and arng 15) 5)))))
      (and (<= reg REG_V31) (>= reg REG_V0))
      (let [(values arng elem) (readArrangement ext)]
        (when (== arng -1)
          (return (errors/New (+ "unsupported simd register extension type: " ext))))

        (when (and elem (not isIndex))
          (return nil))

        (let [^error err (zero error)]
          (when [(set! (values reg err) (RegisterArrangement reg arng isIndex))] (!= err nil)
            (return err))

          (set! (.-Reg a) reg)
          (when isIndex
            (set! (.-Index a) num)))) :else


      (return (errors/New "invalid register and extension combination")))

    nil))




^{:go/end 8750} (go/func readArrangement "readArrangement returns arrangement constant (or -1 for unknown arrangement)\nand a boolean flag specifying whether it refers to a vector element.\n" [^string name] :results [^int16 arng ^bool elem]
  (switch name
    (case ["B8"]
      (return ARNG_8B false))
    (case ["B16"]
      (return ARNG_16B false))
    (case ["H4"]
      (return ARNG_4H false))
    (case ["H8"]
      (return ARNG_8H false))
    (case ["S2"]
      (return ARNG_2S false))
    (case ["S4"]
      (return ARNG_4S false))
    (case ["D1"]
      (return ARNG_1D false))
    (case ["D2"]
      (return ARNG_2D false))
    (case ["B"]
      (return ARNG_B true))
    (case ["H"]
      (return ARNG_H true))
    (case ["S"]
      (return ARNG_S true))
    (case ["D"]
      (return ARNG_D true))
    (case ["Q1"]
      (return ARNG_1Q false))
    (default
      (return -1 false))))




^{:go/end 8770} (go/func RegisterArrangement "RegisterArrangement encodes specified simd register number and arrangement.\n" [^int16 reg ^int16 arng ^bool isIndex] :results [int16 error]
  (set! arng bit-and 15)
  (let [arrangement (<< arng 5)]
    (switch arng
      (case [ARNG_B ARNG_H ARNG_S ARNG_D]
        (when (not isIndex)
          (return reg nil))

        (return (+ REG_ELEM (bit-and reg 31) arrangement) nil))
      (case [ARNG_16B ARNG_8H ARNG_4S ARNG_2D
          ^{:line 8763} ARNG_8B ARNG_4H ARNG_2S ARNG_1D ARNG_1Q]
        (when isIndex
          (return 0 (errors/New "invalid register extension")))

        (return (+ REG_ARNG (bit-and reg 31) arrangement) nil)))

    (return 0 (errors/New (+ "unsupported simd register arrangement: " (fmt/Sprint arng))))))



^{:go/end 8795} (go/func RegisterListOffset "RegisterListOffset generates offset encoding according to AArch64 specification.\n" [^int firstReg ^int regCnt ^int64 arrangement ^int16 scale] :results [int64 error]
  (let [offset (conv int64 firstReg)]
    (if (== scale 0)
      (switch regCnt
        (case [1]
          (set! offset bit-or (<< 0x7 12)))
        (case [2]
          (set! offset bit-or (<< 0xa 12)))
        (case [3]
          (set! offset bit-or (<< 0x6 12)))
        (case [4]
          (set! offset bit-or (<< 0x2 12)))
        (default
          (return 0 (errors/New "invalid register numbers in ARM64 register list"))))


      ;; scale is either 1 or 3.
      (set! offset bit-or (<< (conv int64 scale) 12)))

    (set! offset bit-or arrangement)
    (set! offset bit-or obj/RegListARM64Lo)
    (return offset nil)))

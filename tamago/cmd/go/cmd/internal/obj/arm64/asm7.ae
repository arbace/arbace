  (when (!= (.-as p1) (.-as p2))
    (return (- (conv int (.-as p1)) (conv int (.-as p2)))))

  (when (!= (.-a1 p1) (.-a1 p2))
    (return (- (conv int (.-a1 p1)) (conv int (.-a1 p2)))))

  (when (!= (.-a2 p1) (.-a2 p2))
    (return (- (conv int (.-a2 p1)) (conv int (.-a2 p2)))))

  (when (!= (.-a3 p1) (.-a3 p2))

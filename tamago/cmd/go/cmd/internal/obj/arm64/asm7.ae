    (lit _ AFMOVS C_FREG C_NONE C_NONE C_ROFF C_NONE 99 4 0 0 0)
    (lit _ AFMOVD C_FREG C_NONE C_NONE C_ROFF C_NONE 99 4 0 0 0)

    ;; /* pre/post-indexed/signed-offset load/store register pair
    ;; (unscaled, signed 10-bit quad-aligned and long offset).

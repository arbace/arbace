    (lit _ AMOVH C_LAUTO C_NONE C_NONE C_ZREG C_NONE 31 8 REGSP 0 0)
    (lit _ AMOVH C_LAUTOPOOL C_NONE C_NONE C_ZREG C_NONE 31 8 REGSP LFROM 0)
    (lit _ AMOVH C_LOREG C_NONE C_NONE C_ZREG C_NONE 31 8 0 0 0)
    (lit _ AMOVH C_LOREGPOOL C_NONE C_NONE C_ZREG C_NONE 31 8 0 LFROM 0)
    (lit _ AMOVW C_LAUTO C_NONE C_NONE C_ZREG C_NONE 31 8 REGSP 0 0)
    (lit _ AMOVW C_LAUTOPOOL C_NONE C_NONE C_ZREG C_NONE 31 8 REGSP LFROM 0)
    (lit _ AMOVW C_LOREG C_NONE C_NONE C_ZREG C_NONE 31 8 0 0 0)
    (lit _ AMOVW C_LOREGPOOL C_NONE C_NONE C_ZREG C_NONE 31 8 0 LFROM 0)
    (lit _ AMOVD C_LAUTO C_NONE C_NONE C_ZREG C_NONE 31 8 REGSP 0 0)
    (lit _ AMOVD C_LAUTOPOOL C_NONE C_NONE C_ZREG C_NONE 31 8 REGSP LFROM 0)
    (lit _ AMOVD C_LOREG C_NONE C_NONE C_ZREG C_NONE 31 8 0 0 0)
    (lit _ AMOVD C_LOREGPOOL C_NONE C_NONE C_ZREG C_NONE 31 8 0 LFROM 0)

    (lit _ AFMOVS C_LAUTO C_NONE C_NONE C_FREG C_NONE 31 8 REGSP 0 0)
    (lit _ AFMOVS C_LAUTOPOOL C_NONE C_NONE C_FREG C_NONE 31 8 REGSP LFROM 0)
    (lit _ AFMOVS C_LOREG C_NONE C_NONE C_FREG C_NONE 31 8 0 0 0)
    (lit _ AFMOVS C_LOREGPOOL C_NONE C_NONE C_FREG C_NONE 31 8 0 LFROM 0)
    (lit _ AFMOVD C_LAUTO C_NONE C_NONE C_FREG C_NONE 31 8 REGSP 0 0)
    (lit _ AFMOVD C_LAUTOPOOL C_NONE C_NONE C_FREG C_NONE 31 8 REGSP LFROM 0)
    (lit _ AFMOVD C_LOREG C_NONE C_NONE C_FREG C_NONE 31 8 0 0 0)
    (lit _ AFMOVD C_LOREGPOOL C_NONE C_NONE C_FREG C_NONE 31 8 0 LFROM 0)
    (lit _ AFMOVQ C_LAUTO C_NONE C_NONE C_FREG C_NONE 31 8 REGSP 0 0)
    (lit _ AFMOVQ C_LAUTOPOOL C_NONE C_NONE C_FREG C_NONE 31 8 REGSP LFROM 0)
    (lit _ AFMOVQ C_LOREG C_NONE C_NONE C_FREG C_NONE 31 8 0 0 0)
    (lit _ AFMOVQ C_LOREGPOOL C_NONE C_NONE C_FREG C_NONE 31 8 0 LFROM 0)

    ;; /* pre/post-indexed load (unscaled, signed 9-bit offset) */
    (lit _ AMOVD C_LOREG C_NONE C_NONE C_ZREG C_NONE 22 4 0 0 C_XPOST)
    (lit _ AMOVW C_LOREG C_NONE C_NONE C_ZREG C_NONE 22 4 0 0 C_XPOST)
    (lit _ AMOVH C_LOREG C_NONE C_NONE C_ZREG C_NONE 22 4 0 0 C_XPOST)
    (lit _ AMOVB C_LOREG C_NONE C_NONE C_ZREG C_NONE 22 4 0 0 C_XPOST)
    (lit _ AFMOVS C_LOREG C_NONE C_NONE C_FREG C_NONE 22 4 0 0 C_XPOST)
    (lit _ AFMOVD C_LOREG C_NONE C_NONE C_FREG C_NONE 22 4 0 0 C_XPOST)
    (lit _ AFMOVQ C_LOREG C_NONE C_NONE C_FREG C_NONE 22 4 0 0 C_XPOST)

    (lit _ AMOVD C_LOREG C_NONE C_NONE C_ZREG C_NONE 22 4 0 0 C_XPRE)
    (lit _ AMOVW C_LOREG C_NONE C_NONE C_ZREG C_NONE 22 4 0 0 C_XPRE)
    (lit _ AMOVH C_LOREG C_NONE C_NONE C_ZREG C_NONE 22 4 0 0 C_XPRE)
    (lit _ AMOVB C_LOREG C_NONE C_NONE C_ZREG C_NONE 22 4 0 0 C_XPRE)
    (lit _ AFMOVS C_LOREG C_NONE C_NONE C_FREG C_NONE 22 4 0 0 C_XPRE)
    (lit _ AFMOVD C_LOREG C_NONE C_NONE C_FREG C_NONE 22 4 0 0 C_XPRE)
    (lit _ AFMOVQ C_LOREG C_NONE C_NONE C_FREG C_NONE 22 4 0 0 C_XPRE)

    ;; /* pre/post-indexed store (unscaled, signed 9-bit offset) */
    (lit _ AMOVD C_ZREG C_NONE C_NONE C_LOREG C_NONE 23 4 0 0 C_XPOST)
    (lit _ AMOVW C_ZREG C_NONE C_NONE C_LOREG C_NONE 23 4 0 0 C_XPOST)
    (lit _ AMOVH C_ZREG C_NONE C_NONE C_LOREG C_NONE 23 4 0 0 C_XPOST)
    (lit _ AMOVB C_ZREG C_NONE C_NONE C_LOREG C_NONE 23 4 0 0 C_XPOST)
    (lit _ AFMOVS C_FREG C_NONE C_NONE C_LOREG C_NONE 23 4 0 0 C_XPOST)
    (lit _ AFMOVD C_FREG C_NONE C_NONE C_LOREG C_NONE 23 4 0 0 C_XPOST)
    (lit _ AFMOVQ C_FREG C_NONE C_NONE C_LOREG C_NONE 23 4 0 0 C_XPOST)

    (lit _ AMOVD C_ZREG C_NONE C_NONE C_LOREG C_NONE 23 4 0 0 C_XPRE)
    (lit _ AMOVW C_ZREG C_NONE C_NONE C_LOREG C_NONE 23 4 0 0 C_XPRE)
    (lit _ AMOVH C_ZREG C_NONE C_NONE C_LOREG C_NONE 23 4 0 0 C_XPRE)
    (lit _ AMOVB C_ZREG C_NONE C_NONE C_LOREG C_NONE 23 4 0 0 C_XPRE)
    (lit _ AFMOVS C_FREG C_NONE C_NONE C_LOREG C_NONE 23 4 0 0 C_XPRE)
    (lit _ AFMOVD C_FREG C_NONE C_NONE C_LOREG C_NONE 23 4 0 0 C_XPRE)
    (lit _ AFMOVQ C_FREG C_NONE C_NONE C_LOREG C_NONE 23 4 0 0 C_XPRE)

    ;; /* load with shifted or extended register offset */
    (lit _ AMOVD C_ROFF C_NONE C_NONE C_ZREG C_NONE 98 4 0 0 0)
    (lit _ AMOVW C_ROFF C_NONE C_NONE C_ZREG C_NONE 98 4 0 0 0)
    (lit _ AMOVH C_ROFF C_NONE C_NONE C_ZREG C_NONE 98 4 0 0 0)
    (lit _ AMOVB C_ROFF C_NONE C_NONE C_ZREG C_NONE 98 4 0 0 0)

    (lit _ AFLDPQ C_PQOREG_16 C_NONE C_NONE C_PAIR C_NONE 66 4 0 0 C_XPOST)
    (lit _ AFLDPQ C_UOREG4K C_NONE C_NONE C_PAIR C_NONE 74 8 0 0 0)
    (lit _ AFLDPQ C_NOREG4K C_NONE C_NONE C_PAIR C_NONE 74 8 0 0 0)
    (lit _ AFLDPQ C_LOREG C_NONE C_NONE C_PAIR C_NONE 75 12 0 0 0)
    (lit _ AFLDPQ C_LOREGPOOL C_NONE C_NONE C_PAIR C_NONE 75 12 0 LFROM 0)
    (lit _ AFLDPQ C_ADDR C_NONE C_NONE C_PAIR C_NONE 88 12 0 0 0)

    (lit _ AFSTPQ C_PAIR C_NONE C_NONE C_NQAUTO_16 C_NONE 67 4 REGSP 0 0)
    (lit _ AFSTPQ C_PAIR C_NONE C_NONE C_PQAUTO_16 C_NONE 67 4 REGSP 0 0)

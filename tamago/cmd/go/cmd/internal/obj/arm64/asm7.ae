      ^{:line 3472} l (conv uint32 (conv int32 ei))
      ^{:line 3473} h (conv uint32 (conv int32 (>> ei 32)))]

    (when (or (!= l 0) (!= (bit-and h 0xffff) 0))
      (return -1))

    (let [h1 (bit-and h 0x7fc00000)]
      (when (and (!= h1 0x40000000) (!= h1 0x3fc00000))
        (return -1))

      (let [n 0]

        ;; sign bit (a)
        (when (!= (bit-and h 0x80000000) 0)
          (set! n bit-or (<< 1 7)))


        ;; exp sign bit (b)
        (when (== h1 0x3fc00000)
          (set! n bit-or (<< 1 6)))


        ;; rest of exp and mantissa (cd-efgh)
        (set! n bit-or (conv int (bit-and (>> h 16) 0x3f)))

        ;;print("match %.8lux %.8lux %d\n", l, h, n);
        ^{:line 3498} n))))




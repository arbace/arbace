    (lit _ ALDP C_NPAUTO C_NONE C_NONE C_PAIR C_NONE 66 4 REGSP 0 0)
    (lit _ ALDP C_PPAUTO C_NONE C_NONE C_PAIR C_NONE 66 4 REGSP 0 0)
    (lit _ ALDP C_UAUTO4K C_NONE C_NONE C_PAIR C_NONE 74 8 REGSP 0 0)
    (lit _ ALDP C_NAUTO4K C_NONE C_NONE C_PAIR C_NONE 74 8 REGSP 0 0)
    (lit _ ALDP C_LAUTO C_NONE C_NONE C_PAIR C_NONE 75 12 REGSP 0 0)

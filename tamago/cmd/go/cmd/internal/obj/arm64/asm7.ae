^{:go/end 1140} (go/method size "size returns the size of the sequence of machine instructions when p is encoded with o.\nUsually it just returns o.size directly, in some cases it checks whether the optimization\nconditions are met, and if so returns the size of the optimized instruction sequence.\nThese optimizations need to be synchronized with the asmout function.\n" ^int [^{:tag (* Optab)} o ^{:tag (* obj/Link)} ctxt ^{:tag (* obj/Prog)} p]
  ;; Optimize adrp+add+ld/st to adrp+ld/st(offset).
  (let [sz (movesize (.-As p))]
    (when (and (<= 0 sz) (<= sz 3))
      ;; Relocations R_AARCH64_LDST{64,32,16,8}_ABS_LO12_NC can only generate 8-byte, 4-byte,
      ;; 2-byte and 1-byte aligned addresses, so the address of load/store must be aligned.
      ;; Also symbols with prefix of "go:string." are Go strings, which will go into
      ;; the symbol table, their addresses are not necessary aligned, rule this out.
      ;;
      ;; Note that the code generation routines for these addressing forms call o.size
      ;; to decide whether to use the unaligned/aligned forms, so o.size's result is always
      ;; in sync with the code generation decisions, because it *is* the code generation decision.
      (let [align (conv int64 ^int64 (<< 1 sz))
          ^{:line 1120} ok ^{:go/end 1134} (fn ^bool [^{:tag (* obj/Addr)} a]
            (when (!= (% (.-Offset a) align) 0)
              (return false))

            ^{:go/breaks [[3 1133]]} (let [s (.-Sym a)]
              (when (!= (.-Align s) 0)
                (return (>= (conv int64 (.-Align s)) align)))

              ;; When Align==0, the linker chooses a big enough alignment that this will
              ;; always be ok. (It chooses the biggest alignment that fits in the object
              ;; size. See cmd/link/internal/ld/data.go:symalign. That alignment will
              ;; always be at least as big as this operation is, because this operation
              ;; must fit in the object.) See issue 78585.
              true))]

        (when (or (and (== (.-a1 o) C_ADDR) (ok (addr (.-From p)))) (and (== (.-a4 o) C_ADDR) (ok (addr (.-To p)))))
          (return 8))))


    (conv int (.-size_ o))))


^{:go/end 1227} (go/func span7 [^{:tag (* obj/Link)} ctxt ^{:tag (* obj/LSym)} cursym ^obj/ProgAlloc newprog]
  (when (.-Retpoline ctxt)
    (.Diag ctxt "-spectre=ret not supported on arm64")
    (set! (.-Retpoline ctxt) false)) ; don't keep printing


  (let [p (.-Text (.Func cursym))]
    (when (or (== p nil) (== (.-Link p) nil)) ; handle external functions and ELF section symbols
      (return))


    (when (== (aget oprange (bit-and AAND obj/AMask)) nil)
      (.Diag ctxt "arm64 ops not initialized, call arm64.buildop first"))


    (let [c (lit ctxt7 :ctxt ctxt :newprog newprog :cursym cursym :autosize (conv int32 (bit-and (.-Offset (.-To p)) 0xffffffff)) :extrasize (conv int32 (>> (.-Offset (.-To p)) 32)))]
      (set! (.-Offset (.-To p)) bit-and 0xffffffff) ; extrasize is no longer needed

      ;; Process literal pool and allocate initial program counter for each Prog, before
      ;; generating branch veneers.
      (let [pc (conv int64 0)]
        (set! (.-Pc p) pc)
        (for [(set! p (.-Link p))] (!= p nil) (set! p (.-Link p))
          (set! (.-Pc p) pc)
          (.addLiteralsToPool c p)
          (set! pc + (conv int64 (.asmsizeBytes c p))))


        ;; /*
        ;; * if any procedure is large enough to
        ;; * generate a large SBRA branch, then

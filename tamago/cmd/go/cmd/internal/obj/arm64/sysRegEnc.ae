^{:go/end 895} (go/func SysRegEnc [^int16 r] :results [string uint32 uint8]
  ;; The automatic generator guarantees that the order
  ;; of Reg in SystemReg struct is consistent with the
  ;; order of system register declarations
  (when (or (<= r SYSREG_BEGIN) (>= r SYSREG_END))
    (return "" 0 0))

  (let [v (aget SystemReg (- r SYSREG_BEGIN 1))]
    (return (.-Name v) (.-Enc v) (.-AccessFlags v))))

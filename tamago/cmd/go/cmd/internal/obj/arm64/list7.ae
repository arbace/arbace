^{:go/end 102} (go/func arrange ^string [^int a]
  (switch a
    (case [ARNG_8B]
      (return "B8"))
    (case [ARNG_16B]
      (return "B16"))
    (case [ARNG_4H]
      (return "H4"))
    (case [ARNG_8H]
      (return "H8"))
    (case [ARNG_2S]
      (return "S2"))
    (case [ARNG_4S]
      (return "S4"))
    (case [ARNG_1D]
      (return "D1"))
    (case [ARNG_2D]
      (return "D2"))
    (case [ARNG_B]
      (return "B"))
    (case [ARNG_H]
      (return "H"))
    (case [ARNG_S]
      (return "S"))
    (case [ARNG_D]
      (return "D"))
    (case [ARNG_1Q]
      (return "Q1"))
    (case [ARNG_Q]
      (return "Q"))
    (case [PRED_M]
      (return "M"))
    (case [PRED_Z]
      (return "Z"))
    (default
      (return ""))))



^{:go/end 212} (go/func rconv ^string [^int r]
  (let [ext (bit-and (>> r 5) 7)]
    (when (== r REGG)
      (return "g"))

    (switch
      (case [(and (<= REG_R0 r) (<= r REG_R30))]
        (return (fmt/Sprintf "R%d" (- r REG_R0))))
      (case [(== r REG_R31)]
        (return "ZR"))
      (case [(and (<= REG_F0 r) (<= r REG_F31))]
        (return (fmt/Sprintf "F%d" (- r REG_F0))))
      (case [(and (<= REG_V0 r) (<= r REG_V31))]
        (return (fmt/Sprintf "V%d" (- r REG_V0))))
      (case [(and (<= REG_Z0 r) (<= r REG_Z31))]
        (return (fmt/Sprintf "Z%d" (- r REG_Z0))))
      (case [(and (<= REG_P0 r) (<= r REG_P15))]
        (return (fmt/Sprintf "P%d" (- r REG_P0))))
      (case [(and (<= REG_PN0 r) (<= r REG_PN15))]
        (return (fmt/Sprintf "PN%d" (- r REG_PN0))))
      (case [(== r REGSP)]
        (return "RSP"))
      (case [(and (<= REG_UXTB r) (< r REG_UXTH))]
        (if (!= ext 0)
          (return (fmt/Sprintf "%s.UXTB<<%d" (regname r) ext))

          (return (fmt/Sprintf "%s.UXTB" (regname r)))))

      (case [(and (<= REG_UXTH r) (< r REG_UXTW))]
        (if (!= ext 0)
          (return (fmt/Sprintf "%s.UXTH<<%d" (regname r) ext))

          (return (fmt/Sprintf "%s.UXTH" (regname r)))))

      (case [(and (<= REG_UXTW r) (< r REG_UXTX))]
        (if (!= ext 0)
          (return (fmt/Sprintf "%s.UXTW<<%d" (regname r) ext))

          (return (fmt/Sprintf "%s.UXTW" (regname r)))))

      (case [(and (<= REG_UXTX r) (< r REG_SXTB))]
        (if (!= ext 0)
          (return (fmt/Sprintf "%s.UXTX<<%d" (regname r) ext))

          (return (fmt/Sprintf "%s.UXTX" (regname r)))))

      (case [(and (<= REG_SXTB r) (< r REG_SXTH))]
        (if (!= ext 0)
          (return (fmt/Sprintf "%s.SXTB<<%d" (regname r) ext))

          (return (fmt/Sprintf "%s.SXTB" (regname r)))))

      (case [(and (<= REG_SXTH r) (< r REG_SXTW))]
        (if (!= ext 0)
          (return (fmt/Sprintf "%s.SXTH<<%d" (regname r) ext))

          (return (fmt/Sprintf "%s.SXTH" (regname r)))))

      (case [(and (<= REG_SXTW r) (< r REG_SXTX))]
        (if (!= ext 0)
          (return (fmt/Sprintf "%s.SXTW<<%d" (regname r) ext))

          (return (fmt/Sprintf "%s.SXTW" (regname r)))))

      (case [(and (<= REG_SXTX r) (< r REG_SPECIAL))]
        (if (!= ext 0)
          (return (fmt/Sprintf "%s.SXTX<<%d" (regname r) ext))

          (return (fmt/Sprintf "%s.SXTX" (regname r)))))

      ;; bits 0-4 indicate register, bits 5-7 indicate shift amount, bit 8 equals to 0.
      (case [(and (<= REG_LSL r) (< r (+ REG_LSL (<< 1 8))))]
        (return (fmt/Sprintf "R%d<<%d" (bit-and r 31) (bit-and (>> r 5) 7))))
      (case [(and (<= REG_ARNG r) (< r REG_ELEM))]
        (return (fmt/Sprintf "V%d.%s" (bit-and r 31) (arrange (bit-and (>> r 5) 15)))))
      (case [(and (<= REG_ELEM r) (< r REG_ZARNG))]
        (return (fmt/Sprintf "V%d.%s" (bit-and r 31) (arrange (bit-and (>> r 5) 15)))))
      (case [(and (<= REG_ZARNG r) (< r REG_PZELEM))]
        (return (fmt/Sprintf "Z%d.%s" (bit-and r 31) (arrange (bit-and (>> r 5) 15)))))
      (case [(and (<= REG_PZELEM r) (< r REG_PARNGZM))]
        (let [regPrefix "Z"
            ^{:line 185} reg (bit-and r 31)]
          (when (!= (bit-and r (<< 1 5)) 0)
            (set! regPrefix "P")
            (when (>= reg 16)
              (set! regPrefix "PN")
              (set! reg - 16)))


          (return (fmt/Sprintf "%s%d" regPrefix reg))))
      (case [(and (<= REG_PARNGZM r) (< r REG_PARNGZM_END))]
        ;; SVE predicate register with arrangement.
        ;; Pn.<T> or Pn/M, Pn/Z.
        (let [arng (bit-and (>> r 5) 15)
            ^{:line 198} suffix (arrange arng)
            ^{:line 199} reg (bit-and r 31)]
          (when (>= reg 16)
            ;; PN registers
            (return (fmt/Sprintf "PN%d.%s" (- reg 16) suffix)))

          (return (fmt/Sprintf "P%d.%s" reg suffix)))))

    ;; Return system register name.
    (let [(values name _ _) (SysRegEnc (conv int16 r))]
      (when (!= name "")
        (return name))

      (fmt/Sprintf "badreg(%d)" r))))


^{:go/breaks [[4 218]] :go/end 219} (go/func DRconv ^string [^int a]
  (when (and (>= a C_NONE) (<= a C_NCLASS))
    (return (aget cnames7 a)))

  "C_??")


^{:go/end 227} (go/func SPCconv ^string [^int64 a]
  ^{:go/breaks [[3 226]]} (let [spc (conv SpecialOperand a)]
    (when (and (>= spc SPOP_BEGIN) (< spc SPOP_END))
      (return (fmt/Sprintf "%s" spc)))

    "SPC_??"))


^{:go/end 322} (go/func rlconv ^string [^int64 list]
  (let [str ""

      ;; For SIMD&FP register list in ARM64, the conv
      ;; follows the ARM64 instruction decode schema
      ;; | 31 | 30 | ... | 15 - 12 | 11 - 10 | ... |
      ;; +----+----+-----+---------+---------+-----+
      ;; |    | Q  | ... | opcode  |   size  | ... |

      ;; For Scalable Vector register lists, the conv
      ;; follows:
      ;; | 33 - 32 | 31 - 30 | ... | 15 - 12 | 11 - 10 | ... | 5 - 0 |
      ;; +----+----+----+----+-----+---------+---------+-----+-------+
      ;; |regprefix| class 1 | ... | reg cnt | class 2 | ... |  reg  |

      ^{:line 244} firstReg (conv int (bit-and list 31))
      ^{:line 245} opcode (bit-and (>> list 12) 15)
      ^{:line 246 :tag int} regCnt (zero int)
      ^{:line 247 :tag string} t (zero string)]
    (switch opcode
      (case [0x7]
        (set! regCnt 1))
      (case [0xa]
        (set! regCnt 2))
      (case [0x6]
        (set! regCnt 3))
      (case [0x2]
        (set! regCnt 4))
      (case [0x1]
        ;; 5 is the specifier for register range list, size is 1 register
        (set! regCnt 5))
      (case [0x3]
        ;; 6 is the specifier for register range list, size is 4 register
        (set! regCnt 6))
      (default
        (set! regCnt -1)))

    ;; Q:size
    (let [^string regPrefix (zero string)
        ^{:line 268} regType (bit-and (>> list 32) 3)]
      (switch regType
        (case [0]
          (set! regPrefix "V"))
        (case [1]
          (set! regPrefix "Z"))
        (case [2]
          (set! regPrefix "P")))

      (let [arng (bit-or (<< (bit-and (>> list 30) 3) 2) (bit-and (>> list 10) 3))]
        (switch arng
          (case [0]
            (set! t "B8"))
          (case [4]
            (set! t "B16"))
          (case [1]
            (set! t "H4"))
          (case [5]
            (set! t "H8"))
          (case [2]
            (set! t "S2"))
          (case [6]
            (set! t "S4"))
          (case [3]
            (set! t "D1"))
          (case [7]
            (set! t "D2"))
          (case [9]
            (set! t "B"))
          (case [10]
            (set! t "H"))
          (case [11]
            (set! t "S"))
          (case [13]
            (set! t "D"))
          (case [14]
            (set! t "Q")))

        (if (> regCnt 4)
          (let [rangeSize ^int (<< 2 (- regCnt 5))]
            (set! str (fmt/Sprintf "[%s%d.%s-%s%d.%s]" regPrefix firstReg t regPrefix (bit-and (- (+ firstReg rangeSize) 1) 31) t)))
          (do
            (for [i 0] (< i regCnt) (inc! i)
              (if (== str "")
                (set! str + "[")

                (set! str + ","))

              (set! str + (fmt/Sprintf "%s%d." regPrefix (bit-and (+ firstReg i) 31)))
              (set! str + t))

            (set! str + "]")))

        ^{:line 321} str))))


^{:go/end 329} (go/func regname ^string [^int r]
  (when (== (bit-and r 31) 31)
    (return "ZR"))

  (fmt/Sprintf "R%d" (bit-and r 31)))

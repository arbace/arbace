  ^{:line 619} [^{:val 32} C_XPOST (<< 1 5)]) ; match arm.C_PBIT, so Prog.String know how to print it


(go/type AClass uint16) ; operand type


(go/const "[insts] is sorted based on the order of these constants and the first match is chosen.\n"
  ^{:line 626} [^{:tag AClass :val 0} AC_NONE iota]

  ^{:line 628} [^{:val 1 :doc "TODO: probably make this AClass split into AC_REG (R0...R30), AC_RSP (R0...R30, RSP), AC_ZR (R0...R30, ZR).\n"} AC_SPZGREG] ; general purpose registers R0..R30 and RSP and ZR
  ^{:line 629} [^{:val 2} AC_VREG] ; vector registers, such as V1
  ^{:line 630} [^{:val 3} AC_ZREG] ; the scalable vector registers, such as Z1
  ^{:line 631} [^{:val 4} AC_PREG] ; the scalable predicate registers, such as P1
  ^{:line 632} [^{:val 5} AC_PREGZM] ; Pg.Z or Pg.M
  ^{:line 633} [^{:val 6} AC_PREGIDX] ; P8[1] or PN1[1] or Z1[1]
  ^{:line 634} [^{:val 7} AC_ZREGIDX] ; P8[1] or PN1[1] or Z1[1]
  ^{:line 635} [^{:val 8} AC_PREGSEL] ; P0[R1, 1], index is calculated as R1 + 1
  ^{:line 636} [^{:val 9} AC_ARNG] ; vector register with arrangement, such as Z1.D
  ^{:line 637} [^{:val 10} AC_ARNGIDX] ; vector register with arrangement and index, such as Z1.D[1]

  ^{:line 639} [^{:val 11} AC_IMM] ; constants

  ^{:line 641} [^{:val 12} AC_REGLIST1] ; list of 1 vector register, such as [Z1]
  ^{:line 642} [^{:val 13} AC_REGLIST2] ; list of 2 vector registers, such as [Z0, Z8]
  ^{:line 643} [^{:val 14} AC_REGLIST3] ; list of 3 vector registers, such as [Z1, Z2, Z3]
  ^{:line 644} [^{:val 15} AC_REGLIST4] ; list of 4 vector registers, such as [Z0, Z4, Z8, Z12]
  ^{:line 645} [^{:val 16} AC_REGLIST_RANGE] ; list of vector register lists in range format, such as [Z0-Z4].

  ^{:line 647} [^{:val 17} AC_MEMOFF] ; address with optional constant offset, the offset is an immediate, such as 4(Z1.D)
  ^{:line 648} [^{:val 18} AC_MEMOFFMULVL] ; address with optional constant offset, the offset is an immediate multiplied by the vector's in-memory size, such as (2*VL)(Z1.D)
  ^{:line 649} [^{:val 19} AC_MEMEXT] ; address with register offset with extensions, such as (Z2.D.UXTW<<3)(RSP)

  ^{:line 651} [^{:val 20} AC_PREG_PATTERN] ; register with pattern, such as VL1*3(P1.D)
  ^{:line 652} [^{:val 21} AC_REG_PATTERN] ; register with pattern, such as VL1*3(R1)
  ^{:line 653} [^{:val 22} AC_ZREG_PATTERN] ; register with pattern, such as VL1*3(Z1.D)

  ^{:line 655} [^{:val 23} AC_SPECIAL]) ; VL*i pattern, one of: VL*2, VL*4, or prefetch pattern, such as PLDL1KEEP, more patterns might come in the future.



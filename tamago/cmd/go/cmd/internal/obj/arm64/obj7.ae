^{:go/end 304} (go/method stacksplit ^{:tag (* obj/Prog)} [^{:tag (* ctxt7)} c ^{:tag (* obj/Prog)} p ^int32 framesize]
  (when (!= (.-Flag_maymorestack (.-ctxt c)) "")
    (set! p (.SpillRegisterArgs (.Func (.-cursym c)) p (.-newprog c)))

    ;; Save LR and make room for FP, REGCTXT. Leave room
    ;; for caller's saved FP.
    (let [^:const ^{:val 32} frameSize 32]
      (set! p (obj/Appendp p (.-newprog c)))
      (set! (.-As p) AMOVD)
      (set! (.-Type (.-From p)) obj/TYPE_REG)
      (set! (.-Reg (.-From p)) REGLINK)
      (set! (.-Type (.-To p)) obj/TYPE_MEM)
      (set! (.-Scond p) C_XPRE)
      (set! (.-Offset (.-To p)) (- frameSize))
      (set! (.-Reg (.-To p)) REGSP)
      (set! (.-Spadj p) frameSize)

      ;; Save FP.
      (set! p (obj/Appendp p (.-newprog c)))
      (set! (.-As p) AMOVD)
      (set! (.-Type (.-From p)) obj/TYPE_REG)
      (set! (.-Reg (.-From p)) REGFP)
      (set! (.-Type (.-To p)) obj/TYPE_MEM)
      (set! (.-Reg (.-To p)) REGSP)
      (set! (.-Offset (.-To p)) -8)

      (set! p (obj/Appendp p (.-newprog c)))
      (set! (.-As p) ASUB)
      (set! (.-Type (.-From p)) obj/TYPE_CONST)
      (set! (.-Offset (.-From p)) 8)
      (set! (.-Reg p) REGSP)
      (set! (.-Type (.-To p)) obj/TYPE_REG)
      (set! (.-Reg (.-To p)) REGFP)

      ;; Save REGCTXT (for simplicity we do this whether or
      ;; not we need it.)
      (set! p (obj/Appendp p (.-newprog c)))
      (set! (.-As p) AMOVD)
      (set! (.-Type (.-From p)) obj/TYPE_REG)
      (set! (.-Reg (.-From p)) REGCTXT)
      (set! (.-Type (.-To p)) obj/TYPE_MEM)
      (set! (.-Reg (.-To p)) REGSP)
      (set! (.-Offset (.-To p)) 8)

      ;; BL maymorestack
      (set! p (obj/Appendp p (.-newprog c)))
      (set! (.-As p) ABL)
      (set! (.-Type (.-To p)) obj/TYPE_BRANCH)
      ;; See ../x86/obj6.go
      (set! (.-Sym (.-To p)) (.LookupABI (.-ctxt c) (.-Flag_maymorestack (.-ctxt c)) ^{:go/via [Attribute]} (.ABI (.-cursym c))))

      ;; Restore REGCTXT.
      (set! p (obj/Appendp p (.-newprog c)))
      (set! (.-As p) AMOVD)
      (set! (.-Type (.-From p)) obj/TYPE_MEM)
      (set! (.-Reg (.-From p)) REGSP)
      (set! (.-Offset (.-From p)) 8)
      (set! (.-Type (.-To p)) obj/TYPE_REG)
      (set! (.-Reg (.-To p)) REGCTXT)

      ;; Restore FP.
      (set! p (obj/Appendp p (.-newprog c)))
      (set! (.-As p) AMOVD)
      (set! (.-Type (.-From p)) obj/TYPE_MEM)
      (set! (.-Reg (.-From p)) REGSP)
      (set! (.-Offset (.-From p)) -8)
      (set! (.-Type (.-To p)) obj/TYPE_REG)
      (set! (.-Reg (.-To p)) REGFP)

      ;; Restore LR and SP.
      (set! p (obj/Appendp p (.-newprog c)))
      (set! (.-As p) AMOVD)
      (set! (.-Type (.-From p)) obj/TYPE_MEM)
      (set! (.-Scond p) C_XPOST)
      (set! (.-Offset (.-From p)) frameSize)
      (set! (.-Reg (.-From p)) REGSP)
      (set! (.-Type (.-To p)) obj/TYPE_REG)
      (set! (.-Reg (.-To p)) REGLINK)
      (set! (.-Spadj p) (- frameSize))

      (set! p (.UnspillRegisterArgs (.Func (.-cursym c)) p (.-newprog c)))))


  ;; Jump back to here after morestack returns.
  (let [startPred p]

    ;; MOV	g_stackguard(g), RT1
    (set! p (obj/Appendp p (.-newprog c)))

    (set! (.-As p) AMOVD)
    (set! (.-Type (.-From p)) obj/TYPE_MEM)
    (set! (.-Reg (.-From p)) REGG)
    (set! (.-Offset (.-From p)) (* 2 (conv int64 ^{:go/via [Arch]} (.-PtrSize (.-Arch (.-ctxt c)))))) ; G.stackguard0
    (when ^{:go/via [Attribute]} (.CFunc (.-cursym c))
      (set! (.-Offset (.-From p)) (* 3 (conv int64 ^{:go/via [Arch]} (.-PtrSize (.-Arch (.-ctxt c))))))) ; G.stackguard1

    (set! (.-Type (.-To p)) obj/TYPE_REG)
    (set! (.-Reg (.-To p)) REGRT1)

    ;; Mark the stack bound check and morestack call async nonpreemptible.
    ;; If we get preempted here, when resumed the preemption request is
    ;; cleared, but we'll still call morestack, which will double the stack
    ;; unnecessarily. See issue #35470.
    (set! p (.StartUnsafePoint (.-ctxt c) p (.-newprog c)))

    (let [q (conv (* obj/Prog) nil)]
      (cond (<= framesize abi/StackSmall) (do
          ;; small stack: SP < stackguard
          ;;	CMP	stackguard, SP

          (set! p (obj/Appendp p (.-newprog c)))
          (set! (.-As p) ACMP)
          (set! (.-Type (.-From p)) obj/TYPE_REG)
          (set! (.-Reg (.-From p)) REGRT1)
          (set! (.-Reg p) REGSP))
        (<= framesize abi/StackBig) (do
          ;; large stack: SP-framesize < stackguard-StackSmall
          ;;	SUB	$(framesize-StackSmall), SP, RT2
          ;;	CMP	stackguard, RT2
          (set! p (obj/Appendp p (.-newprog c)))

          (set! (.-As p) ASUB)
          (set! (.-Type (.-From p)) obj/TYPE_CONST)
          (set! (.-Offset (.-From p)) (- (conv int64 framesize) abi/StackSmall))
          (set! (.-Reg p) REGSP)
          (set! (.-Type (.-To p)) obj/TYPE_REG)
          (set! (.-Reg (.-To p)) REGRT2)

          (set! p (obj/Appendp p (.-newprog c)))
          (set! (.-As p) ACMP)
          (set! (.-Type (.-From p)) obj/TYPE_REG)
          (set! (.-Reg (.-From p)) REGRT1)
          (set! (.-Reg p) REGRT2)) :else
        (do
          ;; Such a large stack we need to protect against underflow.
          ;; The runtime guarantees SP > objabi.StackBig, but
          ;; framesize is large enough that SP-framesize may
          ;; underflow, causing a direct comparison with the
          ;; stack guard to incorrectly succeed. We explicitly
          ;; guard against underflow.
          ;;
          ;;	SUBS	$(framesize-StackSmall), SP, RT2
          ;;	// On underflow, jump to morestack
          ;;	BLO	label_of_call_to_morestack
          ;;	CMP	stackguard, RT2

          (set! p (obj/Appendp p (.-newprog c)))
          (set! (.-As p) ASUBS)
          (set! (.-Type (.-From p)) obj/TYPE_CONST)
          (set! (.-Offset (.-From p)) (- (conv int64 framesize) abi/StackSmall))
          (set! (.-Reg p) REGSP)
          (set! (.-Type (.-To p)) obj/TYPE_REG)
          (set! (.-Reg (.-To p)) REGRT2)

          (set! p (obj/Appendp p (.-newprog c)))
          (set! q p)
          (set! (.-As p) ABLO)
          (set! (.-Type (.-To p)) obj/TYPE_BRANCH)

          (set! p (obj/Appendp p (.-newprog c)))
          (set! (.-As p) ACMP)
          (set! (.-Type (.-From p)) obj/TYPE_REG)
          (set! (.-Reg (.-From p)) REGRT1)
          (set! (.-Reg p) REGRT2)))


      ;; BLS	do-morestack
      (let [bls (obj/Appendp p (.-newprog c))]
        (set! (.-As bls) ABLS)
        (set! (.-Type (.-To bls)) obj/TYPE_BRANCH)

        (let [end (.EndUnsafePoint (.-ctxt c) bls (.-newprog c) -1)

            ^{:line 240 :tag (* obj/Prog)} last (zero (* obj/Prog))]
          (for [(set! last (.-Text (.Func (.-cursym c))))] (!= (.-Link last) nil) (set! last (.-Link last)))


          ;; Now we are at the end of the function, but logically
          ;; we are still in function prologue. We need to fix the
          ;; SP data and PCDATA.
          (let [spfix (obj/Appendp last (.-newprog c))]
            (set! (.-As spfix) obj/ANOP)
            (set! (.-Spadj spfix) (- framesize))

            (let [pcdata (.EmitEntryStackMap (.-ctxt c) (.-cursym c) spfix (.-newprog c))]
              (set! pcdata (.StartUnsafePoint (.-ctxt c) pcdata (.-newprog c)))

              (when (!= q nil)
                (.SetTarget (.-To q) pcdata))

              (.SetTarget (.-To bls) pcdata)

              (let [spill (.SpillRegisterArgs (.Func (.-cursym c)) pcdata (.-newprog c))

                  ;; MOV	LR, R3
                  ^{:line 262} movlr (obj/Appendp spill (.-newprog c))]
                (set! (.-As movlr) AMOVD)
                (set! (.-Type (.-From movlr)) obj/TYPE_REG)
                (set! (.-Reg (.-From movlr)) REGLINK)
                (set! (.-Type (.-To movlr)) obj/TYPE_REG)
                (set! (.-Reg (.-To movlr)) REG_R3)

                (let [debug movlr]
                  (when false
                    (set! debug (obj/Appendp debug (.-newprog c)))
                    (set! (.-As debug) AMOVD)
                    (set! (.-Type (.-From debug)) obj/TYPE_CONST)
                    (set! (.-Offset (.-From debug)) (conv int64 framesize))
                    (set! (.-Type (.-To debug)) obj/TYPE_REG)
                    (set! (.-Reg (.-To debug)) REGTMP))


                  ;; BL	runtime.morestack(SB)
                  (let [call (obj/Appendp debug (.-newprog c))]
                    (set! (.-As call) ABL)
                    (set! (.-Type (.-To call)) obj/TYPE_BRANCH)
                    (let [morestack "runtime.morestack"]
                      (switch
                        (case [^{:go/via [Attribute]} (.CFunc (.-cursym c))]
                          (set! morestack "runtime.morestackc"))
                        (case [(not ^{:go/via [Attribute]} (.NeedCtxt (.-Sym (.-From (.-Text (.Func (.-cursym c)))))))]
                          (set! morestack "runtime.morestack_noctxt")))

                      (set! (.-Sym (.-To call)) (.Lookup (.-ctxt c) morestack))

                      ;; The instructions which unspill regs should be preemptible.
                      (set! pcdata (.EndUnsafePoint (.-ctxt c) call (.-newprog c) -1))
                      (let [unspill (.UnspillRegisterArgs (.Func (.-cursym c)) pcdata (.-newprog c))

                          ;; B	start
                          ^{:line 297} jmp (obj/Appendp unspill (.-newprog c))]
                        (set! (.-As jmp) AB)
                        (set! (.-Type (.-To jmp)) obj/TYPE_BRANCH)
                        (.SetTarget (.-To jmp) (.-Link startPred))
                        (set! (.-Spadj jmp) (+ framesize))

                        ^{:line 303} end))))))))))))


^{:go/end 395} (go/func progedit [^{:tag (* obj/Link)} ctxt ^{:tag (* obj/Prog)} p ^obj/ProgAlloc newprog]
  (let [c (lit ctxt7 :ctxt ctxt :newprog newprog)]

    (set! (.-Class (.-From p)) 0)
    (set! (.-Class (.-To p)) 0)

    ;; Previously we rewrote $0 to ZR, but we have now removed this change.
    ;; In order to be compatible with some previous legal instruction formats,
    ;; reserve the previous conversion for some specific instructions.
    (when (and (== (.-Type (.-From p)) obj/TYPE_CONST) (== (.-Offset (.-From p)) 0) (aget zrReplace (.-As p)))
      (set! (.-Type (.-From p)) obj/TYPE_REG)
      (set! (.-Reg (.-From p)) REGZERO))


    ;; Rewrite BR/BL to symbol as TYPE_BRANCH.
    (switch (.-As p)
      (case [AB ABL obj/ARET]
        (when (!= (.-Sym (.-To p)) nil)
          (set! (.-Type (.-To p)) obj/TYPE_BRANCH))

        (break)))


    ;; Rewrite float and vector constants to values stored in memory.
    (switch (.-As p)
      (case [AVMOVS]
        (when (== (.-Type (.-From p)) obj/TYPE_CONST)
          (set! (.-Type (.-From p)) obj/TYPE_MEM)
          (set! (.-Sym (.-From p)) (.Int32Sym (.-ctxt c) (.-Offset (.-From p))))
          (set! (.-Name (.-From p)) obj/NAME_EXTERN)
          (set! (.-Offset (.-From p)) 0)))


      (case [AVMOVD]
        (when (== (.-Type (.-From p)) obj/TYPE_CONST)
          (set! (.-Type (.-From p)) obj/TYPE_MEM)
          (set! (.-Sym (.-From p)) (.Int64Sym (.-ctxt c) (.-Offset (.-From p))))
          (set! (.-Name (.-From p)) obj/NAME_EXTERN)
          (set! (.-Offset (.-From p)) 0)))


      (case [AVMOVQ]
        (when (== (.-Type (.-From p)) obj/TYPE_CONST)
          (set! (.-Type (.-From p)) obj/TYPE_MEM)
          (set! (.-Sym (.-From p)) (.Int128Sym (.-ctxt c) (.-Offset (.GetFrom3 p)) (.-Offset (.-From p))))
          (set! (.-Name (.-From p)) obj/NAME_EXTERN)
          (set! (.-Offset (.-From p)) 0)
          (set! (.-RestArgs p) nil)))


      (case [AFMOVS]
        (when (== (.-Type (.-From p)) obj/TYPE_FCONST)
          (let [f64 (assert float64 (.-Val (.-From p)))
              ^{:line 359} f32 (conv float32 f64)]
            (when (> (.chipfloat7 c f64) 0)
              (break))

            (when (== (math/Float32bits f32) 0)
              (set! (.-Type (.-From p)) obj/TYPE_REG)
              (set! (.-Reg (.-From p)) REGZERO)
              (break))

            (set! (.-Type (.-From p)) obj/TYPE_MEM)
            (set! (.-Sym (.-From p)) (.Float32Sym (.-ctxt c) f32))
            (set! (.-Name (.-From p)) obj/NAME_EXTERN)
            (set! (.-Offset (.-From p)) 0))))


      (case [AFMOVD]
        (when (== (.-Type (.-From p)) obj/TYPE_FCONST)
          (let [f64 (assert float64 (.-Val (.-From p)))]
            (when (> (.chipfloat7 c f64) 0)
              (break))

            (when (== (math/Float64bits f64) 0)
              (set! (.-Type (.-From p)) obj/TYPE_REG)
              (set! (.-Reg (.-From p)) REGZERO)
              (break))

            (set! (.-Type (.-From p)) obj/TYPE_MEM)
            (set! (.-Sym (.-From p)) (.Float64Sym (.-ctxt c) f64))
            (set! (.-Name (.-From p)) obj/NAME_EXTERN)
            (set! (.-Offset (.-From p)) 0)))))



    (when (.-Flag_dynlink (.-ctxt c))

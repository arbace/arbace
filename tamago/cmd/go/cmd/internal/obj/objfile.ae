^{:go/end 249} (go/method init "prepare package index list\n" [^{:tag (* writer)} w]
  (set! (.-pkglist w) (make (slice string) (+ (len (.-pkgIdx (.-ctxt w))) 1)))
  (aset (.-pkglist w) 0 "") ; dummy invalid package for index 0
  (range [pkg i (.-pkgIdx (.-ctxt w))]
    (aset (.-pkglist w) i pkg)))



^{:go/end 278} (go/method writeFile [^{:tag (* writer)} w ^{:tag (* Link)} ctxt ^{:tag (* FileInfo)} file]
  (let [(values f err) (os/Open (.-Name file))]
    (when (!= err nil)
      (.Diag ctxt "%v" err)
      (return))

    (defer (.Close f))
    (when (== (.-filebuf w) nil)
      (set! (.-filebuf w) (make (slice byte) 1024)))

    (let [buf (.-filebuf w)
        ^{:line 262} written (conv int64 0)]
      (while true
        (let [(values n err) (.Read f buf)]
          ^{:go/via [Writer]} (.Bytes w (subslice buf _ n))
          (set! written + (conv int64 n))
          (when (== err io/EOF)
            (break))

          (when (!= err nil)
            (.Diag ctxt "%v" err)
            (return))))


      (when (!= written (.-Size file))
        (.Diag ctxt "copy %s: unexpected length %d != %d" (.-Name file) written (.-Size file))))))



(go/var inlHashLen (.EncodedLen base64/StdEncoding 8))


^{:go/end 294} (go/func TrimInlineHash "TrimInlineHash strips the content hash of inlined call stacks from a symbol name.\n" ^string [^string name]
  ;; The inline hash is in the form of #NNNN#, where NNNN is
  ;; the base64 encoding of a 8-byte hash value.
  (let [(values a b ok) (strings/Cut name "#")]
    (when (not ok)
      (return name))

    (when (or (< (len b) (+ inlHashLen 1)) (!= (aget b inlHashLen) \#))
      (return name))

    (+ a (subslice b (+ inlHashLen 1)))))


^{:go/end 327} (go/method StringTable [^{:tag (* writer)} w]

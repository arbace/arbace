    ;; In this case, if the smaller symbol is alive, the larger is not kept unless
    ;; needed.
    (.PutUint64 binary/LittleEndian (subslice tmp _ 8) (conv uint64 (.-Size s)))
    ;; Some symbols require being in separate sections.
    (aset tmp 8 (contentHashSection s))
    (.Write h (subslice tmp _ 9))

    (when (or (== (.-Type s) objabi/STEXT) (== (.-Type s) objabi/STEXTFIPS))

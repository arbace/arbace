^{:go/end 762} (go/func nAuxSym "return the number of aux symbols s have.\n" ^int [^{:tag (* LSym)} s]
  (let [n 0]
    (when (!= (.-Gotype s) nil)
      (inc! n))

    (if [fn (.Func s)] (!= fn nil) (do
        ;; FuncInfo is an aux symbol, each Funcdata is an aux symbol
        (set! n + (+ 1 (len (.-Funcdata (.-Pcln fn)))))
        (when (and (!= (.-dwarfInfoSym fn) nil) (!= (.-Size (.-dwarfInfoSym fn)) 0))
          (inc! n))

        (when (and (!= (.-dwarfLocSym fn) nil) (!= (.-Size (.-dwarfLocSym fn)) 0))
          (inc! n))

        (when (and (!= (.-dwarfRangesSym fn) nil) (!= (.-Size (.-dwarfRangesSym fn)) 0))
          (inc! n))

        (when (and (!= (.-dwarfDebugLinesSym fn) nil) (!= (.-Size (.-dwarfDebugLinesSym fn)) 0))
          (inc! n))

        (when (and (!= (.-Pcsp (.-Pcln fn)) nil) (!= (.-Size (.-Pcsp (.-Pcln fn))) 0))
          (inc! n))

        (when (and (!= (.-Pcfile (.-Pcln fn)) nil) (!= (.-Size (.-Pcfile (.-Pcln fn))) 0))
          (inc! n))

        (when (and (!= (.-Pcline (.-Pcln fn)) nil) (!= (.-Size (.-Pcline (.-Pcln fn))) 0))
          (inc! n))

        (when (and (!= (.-Pcinline (.-Pcln fn)) nil) (!= (.-Size (.-Pcinline (.-Pcln fn))) 0))
          (inc! n))

        (when (and (!= (.-sehUnwindInfoSym fn) nil) (!= (.-Size (.-sehUnwindInfoSym fn)) 0))
          (inc! n))

        (set! n + (len (.-Pcdata (.-Pcln fn))))
        (when (!= (.-WasmImport fn) nil)
          (when (or (== (.-AuxSym (.-WasmImport fn)) nil) (== (.-Size (.-AuxSym (.-WasmImport fn))) 0))
            (panic "wasmimport aux sym must exist and have non-zero size"))

          (inc! n))

        (when (!= (.-WasmExport fn) nil)
          (inc! n)))

      (when [v (.VarInfo s)] (!= v nil)
        (when (and (!= (.-dwarfInfoSym v) nil) (!= (.-Size (.-dwarfInfoSym v)) 0))
          (inc! n))))


    ^{:line 761} n))




        (fmt/Fprintf (.-Bso ctxt) "\n")))


    (^{:inst [(slice Reloc) Reloc]} slices/SortFunc (.-R s) relocByOffCmp) ; generate stable output
    (range [_ r (.-R s)]
      (let [name ""
          ^{:line 948} ver ""]

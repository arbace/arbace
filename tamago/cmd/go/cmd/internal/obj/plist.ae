^{:go/end 407} (go/func MarkUnsafePoints "MarkUnsafePoints inserts PCDATAs to mark nonpreemptible and restartable\ninstruction sequences, based on isUnsafePoint and isRestartable predicate.\np0 is the start of the instruction stream.\nisUnsafePoint(p) returns true if p is not safe for async preemption.\nisRestartable(p) returns true if we can restart at the start of p (this Prog)\nupon async preemption. (Currently multi-Prog restartable sequence is not\nsupported.)\nisRestartable can be nil. In this case it is treated as always returning false.\nIf isUnsafePoint(p) and isRestartable(p) are both true, it is treated as\nan unsafe point.\n" [^{:tag (* Link)} ctxt ^{:tag (* Prog)} p0 ^ProgAlloc newprog ^{:tag (func [(* Prog)] [bool])} isUnsafePoint ^{:tag (func [(* Prog)] [bool])} isRestartable]
  (when (== isRestartable nil)
    ;; Default implementation: nothing is restartable.
    (set! isRestartable ^{:go/end 347} (fn ^bool [(* Prog)] false)))

  (let [prev p0
      ^{:line 350} prevPcdata (conv int64 -1) ; entry PC data value
      ^{:line 351} prevRestart (conv int64 0)]
    (for [p (.-Link prev)] (!= p nil) (set! (values p prev) (values (.-Link p) p))
      (when (and (== (.-As p) APCDATA) (== (.-Offset (.-From p)) abi/PCDATA_UnsafePoint))
        (set! prevPcdata (.-Offset (.-To p)))
        (continue))

      (when (== prevPcdata abi/UnsafePointUnsafe)
        (continue)) ; already unsafe

      (when (isUnsafePoint p)
        (let [q (.StartUnsafePoint ctxt prev newprog)]
          (set! (.-Pc q) (.-Pc p))
          (set! (.-Link q) p)
          ;; Advance to the end of unsafe point.
          (while (and (!= (.-Link p) nil) (isUnsafePoint (.-Link p)))
            (set! p (.-Link p)))

          (when (== (.-Link p) nil)
            (break)) ; Reached the end, don't bother marking the end

          (set! p (.EndUnsafePoint ctxt p newprog prevPcdata))
          (set! (.-Pc p) (.-Pc (.-Link p)))
          (continue)))

      (when (isRestartable p)
        (let [val (conv int64 abi/UnsafePointRestart1)]
          (when (== val prevRestart)
            (set! val abi/UnsafePointRestart2))

          (set! prevRestart val)
          (let [q (Appendp prev newprog)]
            (set! (.-As q) APCDATA)
            (set! (.-Type (.-From q)) TYPE_CONST)
            (set! (.-Offset (.-From q)) abi/PCDATA_UnsafePoint)
            (set! (.-Type (.-To q)) TYPE_CONST)
            (set! (.-Offset (.-To q)) val)
            (set! (.-Pc q) (.-Pc p))
            (set! (.-Link q) p)

            (when (== (.-Link p) nil)
              (break)) ; Reached the end, don't bother marking the end

            (when (isRestartable (.-Link p))
              ;; Next Prog is also restartable. No need to mark the end
              ;; of this sequence. We'll just go ahead mark the next one.
              (continue))

            (set! p (Appendp p newprog))
            (set! (.-As p) APCDATA)
            (set! (.-Type (.-From p)) TYPE_CONST)
            (set! (.-Offset (.-From p)) abi/PCDATA_UnsafePoint)
            (set! (.-Type (.-To p)) TYPE_CONST)
            (set! (.-Offset (.-To p)) prevPcdata)
            (set! (.-Pc p) (.-Pc (.-Link p)))))))))

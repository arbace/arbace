^{:go/end 332} (go/method EndUnsafePoint "EndUnsafePoint generates PCDATA Progs after p to mark the end of an\nunsafe point, restoring the register map index to oldval.\nThe unsafe point ends right after p.\nIt returns the last Prog generated.\n" ^{:tag (* Prog)} [^{:tag (* Link)} ctxt ^{:tag (* Prog)} p ^ProgAlloc newprog ^int64 oldval]

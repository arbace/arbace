    (set! pcdata (.EmitEntryUnsafePoint ctxt s pcdata newprog))
    ^{:line 275} pcdata))



^{:go/end 289} (go/method EmitEntryStackMap "Similar to EmitEntryLiveness, but just emit stack map.\n" ^{:tag (* Prog)} [^{:tag (* Link)} ctxt ^{:tag (* LSym)} s ^{:tag (* Prog)} p ^ProgAlloc newprog]
  (let [pcdata (Appendp p newprog)]
    (set! (.-Pos pcdata) (.-Pos (.-Text (.Func s))))
    (set! (.-As pcdata) APCDATA)
    (set! (.-Type (.-From pcdata)) TYPE_CONST)
    (set! (.-Offset (.-From pcdata)) abi/PCDATA_StackMapIndex)
    (set! (.-Type (.-To pcdata)) TYPE_CONST)
    (set! (.-Offset (.-To pcdata)) -1) ; pcdata starts at -1 at function entry

    ^{:line 288} pcdata))



^{:go/end 302} (go/method EmitEntryUnsafePoint "Similar to EmitEntryLiveness, but just emit unsafe point map.\n" ^{:tag (* Prog)} [^{:tag (* Link)} ctxt ^{:tag (* LSym)} s ^{:tag (* Prog)} p ^ProgAlloc newprog]

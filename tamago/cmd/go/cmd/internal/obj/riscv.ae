(ns go.cmd.internal.obj.riscv
  (:require [arbace.go :as go]))

(go/package riscv
  :path "cmd/internal/obj/riscv"
  :files ["anames.go" "cpu.go" "doc.go" "inst.go" "list.go" "obj.go"]
  :positions :lines)

(load "riscv/anames")
(load "riscv/cpu")
(load "riscv/doc")
(load "riscv/inst")
(load "riscv/list")
(load "riscv/obj")

(in-ns 'go.cmd.internal.obj) (go/file "ld.go" :imports [])

;; /*
;; * add library to library list.
;; *	srcref: src file referring to package
;; *	objref: object file referring to package
;; *	file: object file, e.g., /home/rsc/go/pkg/container/vector.a
;; *	pkg: package import path, e.g. container/vector
;; */

(go/const
  ^{:line 43} [^{:val 5} LOG 5])


^{:go/end 77} (go/func mkfwd [^{:tag (* LSym)} sym]
  (let [^{:tag (array LOG int32)} dwn (zero (array LOG int32))
      ^{:line 48 :tag (array LOG int32)} cnt (zero (array LOG int32))
      ^{:line 49 :tag (array LOG (* Prog))} lst (zero (array LOG (* Prog)))]

    (for [i 0] (< i LOG) (inc! i)
      (if (== i 0)
        (aset cnt i 1)

        (aset cnt i (* LOG (aget cnt (- i 1)))))

      (aset dwn i 1)
      (aset lst i nil))


    (let [i 0]
      (for [p (.-Text (.Func sym))] (and (!= p nil) (!= (.-Link p) nil)) (set! p (.-Link p))
        (dec! i)
        (when (< i 0)
          (set! i (- LOG 1)))

        (set! (.-Forwd p) nil)
        (dec! (aget dwn i))
        (when (<= (aget dwn i) 0)
          (aset dwn i (aget cnt i))
          (when (!= (aget lst i) nil)
            (set! (.-Forwd (aget lst i)) p))

          (aset lst i p))))))




^{:go/end 85} (go/func Appendp ^{:tag (* Prog)} [^{:tag (* Prog)} q ^ProgAlloc newprog]
  (let [p (newprog)]
    (set! (.-Link p) (.-Link q))
    (set! (.-Link q) p)
    (set! (.-Pos p) (.-Pos q))
    ^{:line 84} p))

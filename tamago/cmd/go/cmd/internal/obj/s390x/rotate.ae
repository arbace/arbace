(in-ns 'go.cmd.internal.obj.s390x) (go/file "rotate.go" :imports [


    ^{:line 8} [bits "math/bits"]])





















(go/type RotateParams "RotateParams represents the immediates required for a \"rotate\nthen ... selected bits instruction\".\n\nThe Start and End values are the indexes that represent\nthe masked region. They are inclusive and are in big-\nendian order (bit 0 is the MSB, bit 63 is the LSB). They\nmay wrap around.\n\nSome examples:\n\nMasked region             | Start | End\n--------------------------+-------+----\n0x00_00_00_00_00_00_00_0f | 60    | 63\n0xf0_00_00_00_00_00_00_00 | 0     | 3\n0xf0_00_00_00_00_00_00_0f | 60    | 3\n\nThe Amount value represents the amount to rotate the\ninput left by. Note that this rotation is performed\nbefore the masked region is used.\n" (struct
    ^{:line 31 :tag uint8} Start ; big-endian start bit index [0..63]
    ^{:line 32 :tag uint8} End ; big-endian end bit index [0..63]
    ^{:line 33 :tag uint8} Amount)) ; amount to rotate left








^{:go/end 57} (go/func NewRotateParams "NewRotateParams creates a set of parameters representing a\nrotation left by the amount provided and a selection of the bits\nbetween the provided start and end indexes (inclusive).\n\nThe start and end indexes and the rotation amount must all\nbe in the range 0-63 inclusive or this function will panic.\n" ^RotateParams [^uint8 start ^uint8 end ^uint8 amount]
  (when (!= (bit-and-not start 63) 0)
    (panic "start out of bounds"))

  (when (!= (bit-and-not end 63) 0)
    (panic "end out of bounds"))

  (when (!= (bit-and-not amount 63) 0)
    (panic "amount out of bounds"))

  ^{:go/breaks [2 4 6]} (lit RotateParams
    :Start start
    :End end
    :Amount amount))





^{:go/end 65} (go/method RotateLeft "RotateLeft generates a new set of parameters with the rotation amount\nincreased by the given value. The selected bits are left unchanged.\n" ^RotateParams [^RotateParams r ^uint8 amount]
  (set! (.-Amount r) + amount)
  (set! (.-Amount r) bit-and 63)
  ^{:line 64} r)



^{:go/end 72} (go/method OutMask "OutMask provides a mask representing the selected bits.\n" ^uint64 [^RotateParams r]
  ;; Note: z must be unsigned for bootstrap compiler
  (let [z (bit-and (+ (- 63 (.-End r)) (.-Start r)) 63)] ; number of zero bits in mask
    (bits/RotateLeft64 (<< (bit-not (conv uint64 0)) z) (- (conv int (.-Start r))))))




^{:go/end 78} (go/method InMask "InMask provides a mask representing the selected bits relative\nto the source value (i.e. pre-rotation).\n" ^uint64 [^RotateParams r]
  (bits/RotateLeft64 (.OutMask r) (- (conv int (.-Amount r)))))






^{:go/end 106} (go/method OutMerge "OutMerge tries to generate a new set of parameters representing\nthe intersection between the selected bits and the provided mask.\nIf the intersection is unrepresentable (0 or not contiguous) nil\nwill be returned.\n" ^{:tag (* RotateParams)} [^RotateParams r ^uint64 mask]
  (set! mask bit-and (.OutMask r))
  (when (== mask 0)
    (return nil))


  ;; normalize the mask so that the set bits are left aligned
  (let [o (bits/LeadingZeros64 (bit-not mask))]
    (set! mask (bits/RotateLeft64 mask o))
    (let [z (bits/LeadingZeros64 mask)]
      (set! mask (bits/RotateLeft64 mask z))

      ;; check that the normalized mask is contiguous
      (let [l (bits/LeadingZeros64 (bit-not mask))]
        (when (!= (+ l (bits/TrailingZeros64 mask)) 64)
          (return nil))


        ;; update start and end positions (rotation amount remains the same)
        (set! (.-Start r) (bit-and (conv uint8 (+ o z)) 63))
        (set! (.-End r) (bit-and (- (+ (.-Start r) (conv uint8 l)) 1) 63))
        (addr r)))))







^{:go/end 115} (go/method InMerge "InMerge tries to generate a new set of parameters representing\nthe intersection between the selected bits and the provided mask\nas applied to the source value (i.e. pre-rotation).\nIf the intersection is unrepresentable (0 or not contiguous) nil\nwill be returned.\n" ^{:tag (* RotateParams)} [^RotateParams r ^uint64 mask]
  (.OutMerge r (bits/RotateLeft64 mask (conv int (.-Amount r)))))


^{:go/end 117} (go/method CanBeAnSSAAux [RotateParams])

(in-ns 'go.cmd.internal.obj.s390x) (go/file "listz.go" :imports [


    ^{:line 33} [obj "cmd/internal/obj"]
    ^{:line 34} [fmt "fmt"]])


^{:go/end 40} (go/func init []
  (obj/RegisterRegister obj/RBaseS390X (+ REG_R0 1024) rconv)
  (obj/RegisterOpcode obj/ABaseS390X Anames))


^{:go/end 63} (go/func rconv ^string [^int r]
  (when (== r 0)
    (return "NONE"))

  (when (== r REGG)
    ;; Special case.
    (return "g"))

  (when (and (<= REG_R0 r) (<= r REG_R15))
    (return (fmt/Sprintf "R%d" (- r REG_R0))))

  (when (and (<= REG_F0 r) (<= r REG_F15))
    (return (fmt/Sprintf "F%d" (- r REG_F0))))

  (when (and (<= REG_AR0 r) (<= r REG_AR15))
    (return (fmt/Sprintf "AR%d" (- r REG_AR0))))

  (when (and (<= REG_V0 r) (<= r REG_V31))
    (return (fmt/Sprintf "V%d" (- r REG_V0))))

  (fmt/Sprintf "Rgok(%d)" (- r obj/RBaseS390X)))


^{:go/end 73} (go/func DRconv ^string [^int a]
  (let [s "C_??"]
    (when (and (>= a C_NONE) (<= a C_NCLASS))
      (set! s (aget cnamesz a)))

    (let [^string fp (zero string)]
      (set! fp + s)
      ^{:line 72} fp)))

  ^{:line 209} [^{:val 15} C_SBRA] ; short branch
  ^{:line 210} [^{:val 16} C_LBRA] ; long branch
  ^{:line 211} [^{:val 17} C_SAUTO] ; short auto
  ^{:line 212} [^{:val 18} C_LAUTO] ; long auto
  ^{:line 213} [^{:val 19} C_ZOREG] ; heap address, register-based, displacement == 0
  ^{:line 214} [^{:val 20} C_SOREG] ; heap address, register-based, int16 displacement
  ^{:line 215} [^{:val 21} C_LOREG] ; heap address, register-based, int32 displacement
  ^{:line 216} [^{:val 22} C_TLS_LE] ; TLS - local exec model (for executables)
  ^{:line 217} [^{:val 23} C_TLS_IE] ; TLS - initial exec model (for shared libraries loaded at program startup)

  ^{:line 200} [^{:val 6} C_SCON] ; 0 <= constant <= 0x7fff (positive int16)
  ^{:line 201} [^{:val 7} C_UCON] ; constant & 0xffff == 0 (int16 or uint16)
  ^{:line 202} [^{:val 8} C_ADDCON] ; 0 > constant >= -0x8000 (negative int16)
  ^{:line 203} [^{:val 9} C_ANDCON] ; constant <= 0xffff
  ^{:line 204} [^{:val 10} C_LCON] ; constant (int32 or uint32)
  ^{:line 205} [^{:val 11} C_DCON] ; constant (int64 or uint64)
  ^{:line 206} [^{:val 12} C_SACON] ; computed address, 16-bit displacement, possibly SP-relative
  ^{:line 207} [^{:val 13} C_LACON] ; computed address, 32-bit displacement, possibly SP-relative

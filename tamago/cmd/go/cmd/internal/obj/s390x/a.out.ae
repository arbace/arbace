(go/var ^{:doc "LINUX for zSeries ELF Application Binary Interface Supplement\nhttps://refspecs.linuxfoundation.org/ELF/zSeries/lzsabi0_zSeries/x1472.html\n"} S390XDWARFRegisters (lit (map int16 int16)))

^{:go/end 176} (go/func init []
  ;; f assigns dwarfregisters[from:to by step] = (base):((to-from)/step+base)
  (let [f ^{:go/end 162} (fn [^int16 from ^int16 step ^int16 to ^int16 base]
        (for [r from] (<= r to) (set! r + step)
          (aset S390XDWARFRegisters r (+ (/ (- r from) step) base))))]


    (f REG_R0 1 REG_R15 0)

    (f REG_F0 2 REG_F6 16)
    (f REG_F1 2 REG_F7 20)
    (f REG_F8 2 REG_F14 24)
    (f REG_F9 2 REG_F15 28)

    (f REG_V0 2 REG_V6 16) ; V0:15 aliased to F0:15
    (f REG_V1 2 REG_V7 20) ; TODO what about V16:31?
    (f REG_V8 2 REG_V14 24)
    (f REG_V9 2 REG_V15 28)

    (f REG_AR0 1 REG_AR15 48)))



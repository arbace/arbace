      (bit-or (<< (conv uint8 r1_m1) 4) (bit-and (conv uint8 op) 0x0F))
      (conv uint8 (>> i2_ri2 24))
      (conv uint8 (>> i2_ri2 16))
      (conv uint8 (>> i2_ri2 8))
      (conv uint8 i2_ri2))))



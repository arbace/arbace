    (default
      (set! @asm (append @asm (conv uint8 (>> i2_ri4_ri2 8)) (conv uint8 i2_ri4_ri2))))
    (case [_f]
      (set! @asm (append @asm (conv uint8 i3) (conv uint8 i4)))))



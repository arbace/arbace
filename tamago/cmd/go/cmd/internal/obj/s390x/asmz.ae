      (conv uint8 i2_ri2))))













^{:go/end 4787} (go/func zRIE "Expected argument values for the instruction formats.\n\nFormat    a1  a2   a3  a4  a5  a6  a7\n------------------------------------\na         r1,  0,  i2,  0,  0, m3,  0\nb         r1, r2, ri4,  0,  0, m3,  0\nc         r1, m3, ri4,  0,  0,  0, i2\nd         r1, r3,  i2,  0,  0,  0,  0\ne         r1, r3, ri2,  0,  0,  0,  0\nf         r1, r2,   0, i3, i4,  0, i5\ng         r1, m3,  i2,  0,  0,  0,  0\n" [^form f ^uint32 op ^uint32 r1 ^uint32 r2_m3_r3 ^uint32 i2_ri4_ri2 ^uint32 i3 ^uint32 i4 ^uint32 m3 ^uint32 i2_i5 ^{:tag (* (slice byte))} asm]

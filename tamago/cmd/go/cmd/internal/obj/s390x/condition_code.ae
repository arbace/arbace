(in-ns 'go.cmd.internal.obj.s390x) (go/file "condition_code.go" :imports [


    ^{:line 8} [fmt "fmt"]])

















(go/type CCMask "CCMask represents a 4-bit condition code mask. Bits that\nare not part of the mask should be 0.\n\nCondition code masks represent the 4 possible values of\nthe 2-bit condition code as individual bits. Since IBM Z\nis a big-endian platform bits are numbered from left to\nright. The lowest value, 0, is represented by 8 (0b1000)\nand the highest value, 3, is represented by 1 (0b0001).\n\nNote that condition code values have different semantics\ndepending on the instruction that set the condition code.\nThe names given here assume that the condition code was\nset by an integer or floating point comparison. Other\ninstructions may use these same codes to indicate\ndifferent results such as a carry or overflow.\n" uint8)

(go/const
  ^{:line 29} [^{:tag CCMask :val 0} Never 0] ; no-op


  ^{:line 32} [^{:tag CCMask :val 8 :doc "1-bit masks\n"} Equal (<< 1 3)]
  ^{:line 33} [^{:tag CCMask :val 4} Less (<< 1 2)]
  ^{:line 34} [^{:tag CCMask :val 2} Greater (<< 1 1)]
  ^{:line 35} [^{:tag CCMask :val 1} Unordered (<< 1 0)]


  ^{:line 38} [^{:tag CCMask :val 9 :doc "2-bit masks\n"} EqualOrUnordered (bit-or Equal Unordered)] ; not less and not greater
  ^{:line 39} [^{:tag CCMask :val 12} LessOrEqual (bit-or Less Equal)] ; ordered and not greater
  ^{:line 40} [^{:tag CCMask :val 6} LessOrGreater (bit-or Less Greater)] ; ordered and not equal
  ^{:line 41} [^{:tag CCMask :val 5} LessOrUnordered (bit-or Less Unordered)] ; not greater and not equal
  ^{:line 42} [^{:tag CCMask :val 10} GreaterOrEqual (bit-or Greater Equal)] ; ordered and not less
  ^{:line 43} [^{:tag CCMask :val 3} GreaterOrUnordered (bit-or Greater Unordered)] ; not less and not equal


  ^{:line 46} [^{:tag CCMask :val 7 :doc "3-bit masks\n"} NotEqual (bit-xor Always Equal)]
  ^{:line 47} [^{:tag CCMask :val 11} NotLess (bit-xor Always Less)]
  ^{:line 48} [^{:tag CCMask :val 13} NotGreater (bit-xor Always Greater)]
  ^{:line 49} [^{:tag CCMask :val 14} NotUnordered (bit-xor Always Unordered)]


  ^{:line 52} [^{:tag CCMask :val 15 :doc "4-bit mask\n"} Always (bit-or Equal Less Greater Unordered)]


  ^{:line 55} [^{:tag CCMask :val 3 :doc "useful aliases\n"} Carry GreaterOrUnordered]
  ^{:line 56} [^{:tag CCMask :val 12} NoCarry LessOrEqual]
  ^{:line 57} [^{:tag CCMask :val 12} Borrow NoCarry]
  ^{:line 58} [^{:tag CCMask :val 3} NoBorrow Carry])



^{:go/end 64} (go/method Inverse "Inverse returns the complement of the condition code mask.\n" ^CCMask [^CCMask c]
  (bit-xor c Always))




^{:go/end 77} (go/method ReverseComparison "ReverseComparison swaps the bits at 0b0100 and 0b0010 in the mask,\nreversing the behavior of greater than and less than conditions.\n" ^CCMask [^CCMask c]
  (let [r (bit-and c EqualOrUnordered)]
    (when (!= (bit-and c Less) 0)
      (set! r bit-or Greater))

    (when (!= (bit-and c Greater) 0)
      (set! r bit-or Less))

    ^{:line 76} r))


^{:go/end 126} (go/method String ^string [^CCMask c]
  (switch c
    ;; 0-bit mask
    (case [Never]
      (return "Never"))

    ;; 1-bit masks
    (case [Equal]
      (return "Equal"))
    (case [Less]
      (return "Less"))
    (case [Greater]
      (return "Greater"))
    (case [Unordered]
      (return "Unordered"))

    ;; 2-bit masks
    (case [EqualOrUnordered]
      (return "EqualOrUnordered"))
    (case [LessOrEqual]
      (return "LessOrEqual"))
    (case [LessOrGreater]
      (return "LessOrGreater"))
    (case [LessOrUnordered]
      (return "LessOrUnordered"))
    (case [GreaterOrEqual]
      (return "GreaterOrEqual"))
    (case [GreaterOrUnordered]
      (return "GreaterOrUnordered"))

    ;; 3-bit masks
    (case [NotEqual]
      (return "NotEqual"))
    (case [NotLess]
      (return "NotLess"))
    (case [NotGreater]
      (return "NotGreater"))
    (case [NotUnordered]
      (return "NotUnordered"))

    ;; 4-bit mask
    (case [Always]
      (return "Always")))


  ;; invalid
  (fmt/Sprintf "Invalid (%#x)" (conv uint8 c)))


^{:go/end 128} (go/method CanBeAnSSAAux [CCMask])

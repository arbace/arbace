^{:go/end 1207} (go/func wantFloatReg "wantFloatReg checks that r is a floating-point register.\n" [^{:tag (* obj/Link)} ctxt ^{:tag (* instruction)} ins ^string pos ^uint32 r]
  (wantReg ctxt ins pos "float" r REG_F0 REG_F31))


^{:go/end 1211} (go/func isFloatPrimeReg ^bool [^uint32 r]
  (and (>= r REG_F8) (<= r REG_F15)))




^{:go/end 1217} (go/func wantFloatPrimeReg "wantFloatPrimeReg checks that r is an floating-point register that can\nbe used in a prime register field of a compressed instruction.\n" [^{:tag (* obj/Link)} ctxt ^{:tag (* instruction)} ins ^string pos ^uint32 r]
  (wantReg ctxt ins pos "float prime" r REG_F8 REG_F15))



^{:go/end 1222} (go/func wantVectorReg "wantVectorReg checks that r is a vector register.\n" [^{:tag (* obj/Link)} ctxt ^{:tag (* instruction)} ins ^string pos ^uint32 r]
  (wantReg ctxt ins pos "vector" r REG_V0 REG_V31))



^{:go/end 1229} (go/func wantEvenOffset "wantEvenOffset checks that the offset is a multiple of two.\n" [^{:tag (* obj/Link)} ctxt ^{:tag (* instruction)} ins ^int64 offset]
  (when [err (immEven offset)] (!= err nil)
    (.Diag ctxt "%v: %v" ins err)))



^{:go/end 1237} (go/func validateCA [^{:tag (* obj/Link)} ctxt ^{:tag (* instruction)} ins]
  (wantIntPrimeReg ctxt ins "rd" (.-rd ins))
  (when (!= (.-rd ins) (.-rs1 ins))
    (.Diag ctxt "%v: rd must be the same as rs1" ins))

  (wantIntPrimeReg ctxt ins "rs2" (.-rs2 ins)))


^{:go/end 1259} (go/func validateCB [^{:tag (* obj/Link)} ctxt ^{:tag (* instruction)} ins]
  (cond (and ^:go/paren (or (== (.-as ins) ACSRAI) (== (.-as ins) ACSRLI)) (== (.-imm ins) 0))
    (.Diag ctxt "%v: immediate cannot be zero" ins)
    (or (== (.-as ins) ACSRAI) (== (.-as ins) ACSRLI))
    (wantImmU ctxt ins (.-imm ins) 6)
    (or (== (.-as ins) ACBEQZ) (== (.-as ins) ACBNEZ))
    (wantImmI ctxt ins (.-imm ins) 9) :else

    (wantImmI ctxt ins (.-imm ins) 6))

  (if (or (== (.-as ins) ACBEQZ) (== (.-as ins) ACBNEZ)) (do
      (wantNoneReg ctxt ins "rd" (.-rd ins))
      (wantIntPrimeReg ctxt ins "rs1" (.-rs1 ins)))
    (do
      (wantIntPrimeReg ctxt ins "rd" (.-rd ins))
      (when (!= (.-rd ins) (.-rs1 ins))
        (.Diag ctxt "%v: rd must be the same as rs1" ins))))


  (wantNoneReg ctxt ins "rs2" (.-rs2 ins)))


^{:go/end 1312} (go/func validateCI [^{:tag (* obj/Link)} ctxt ^{:tag (* instruction)} ins]
  (when (and (!= (.-as ins) ACNOP) (== (.-rd ins) REG_X0))
    (.Diag ctxt "%v: cannot use register X0 in rd" ins))

  (when (and (== (.-as ins) ACLUI) (== (.-rd ins) REG_X2))
    (.Diag ctxt "%v: cannot use register SP/X2 in rd" ins))

  (when (and (!= (.-as ins) ACLI) (!= (.-as ins) ACLUI) (!= (.-as ins) ACLWSP) (!= (.-as ins) ACLDSP) (!= (.-as ins) ACFLDSP) (!= (.-rd ins) (.-rs1 ins)))
    (.Diag ctxt "%v: rd must be the same as rs1" ins))

  (when (and (== (.-as ins) ACADDI16SP) (!= (.-rd ins) REG_SP))
    (.Diag ctxt "%v: rd must be SP/X2" ins))

  (when (and ^:go/paren (or (== (.-as ins) ACLWSP) (== (.-as ins) ACLDSP) (== (.-as ins) ACFLDSP)) (!= (.-rs2 ins) REG_SP))
    (.Diag ctxt "%v: rs2 must be SP/X2" ins))

  (cond (and ^:go/paren (or (== (.-as ins) ACADDI) (== (.-as ins) ACADDI16SP) (== (.-as ins) ACLUI) (== (.-as ins) ACSLLI)) (== (.-imm ins) 0))
    (.Diag ctxt "%v: immediate cannot be zero" ins)
    (== (.-as ins) ACSLLI)
    (wantImmU ctxt ins (.-imm ins) 6)
    (== (.-as ins) ACLWSP)
    (wantScaledImmU ctxt ins (.-imm ins) 8 4)
    (or (== (.-as ins) ACLDSP) (== (.-as ins) ACFLDSP))
    (wantScaledImmU ctxt ins (.-imm ins) 9 8)
    (== (.-as ins) ACADDI16SP)
    (wantScaledImmI ctxt ins (.-imm ins) 10 16) :else

    (wantImmI ctxt ins (.-imm ins) 6))

  (switch (.-as ins)
    (case [ACNOP ACADDI ACADDIW ACSLLI]
      (wantIntReg ctxt ins "rd" (.-rd ins))
      (wantIntReg ctxt ins "rs1" (.-rs1 ins))
      (wantNoneReg ctxt ins "rs2" (.-rs2 ins)))
    (case [ACLWSP ACLDSP]
      (wantIntReg ctxt ins "rd" (.-rd ins))
      (wantNoneReg ctxt ins "rs1" (.-rs1 ins))
      (wantIntReg ctxt ins "rs2" (.-rs2 ins)))
    (case [ACFLDSP]
      (wantFloatReg ctxt ins "rd" (.-rd ins))
      (wantNoneReg ctxt ins "rs1" (.-rs1 ins))
      (wantIntReg ctxt ins "rs2" (.-rs2 ins)))
    (case [ACADDI16SP]
      (wantIntReg ctxt ins "rd" (.-rd ins))
      (wantIntReg ctxt ins "rs1" (.-rs1 ins))
      (wantNoneReg ctxt ins "rs2" (.-rs2 ins)))
    (default
      (wantIntReg ctxt ins "rd" (.-rd ins))
      (wantNoneReg ctxt ins "rs1" (.-rs1 ins))
      (wantNoneReg ctxt ins "rs2" (.-rs2 ins)))))



^{:go/end 1325} (go/func validateCIW [^{:tag (* obj/Link)} ctxt ^{:tag (* instruction)} ins]
  (wantScaledImmU ctxt ins (.-imm ins) 10 4)
  (wantIntPrimeReg ctxt ins "rd" (.-rd ins))
  (wantIntReg ctxt ins "rs1" (.-rs1 ins))
  (wantNoneReg ctxt ins "rs2" (.-rs2 ins))
  (when (== (.-imm ins) 0)
    (.Diag ctxt "%v: immediate cannot be zero" ins))

  (when (!= (.-rs1 ins) REG_SP)
    (.Diag ctxt "%v: SP/X2 must be in rs1" ins)))



^{:go/end 1338} (go/func validateCJ [^{:tag (* obj/Link)} ctxt ^{:tag (* instruction)} ins]
  (wantEvenOffset ctxt ins (.-imm ins))
  (wantImmI ctxt ins (.-imm ins) 12)
  (when (!= (.-as ins) ACJ)
    (wantNoneReg ctxt ins "rd" (.-rd ins))
    (wantIntReg ctxt ins "rs1" (.-rs1 ins))
    (wantIntReg ctxt ins "rs2" (.-rs2 ins))
    (when (== (.-rs1 ins) REG_X0)
      (.Diag ctxt "%v: cannot use register X0 in rs1" ins))))




^{:go/end 1355} (go/func validateCL [^{:tag (* obj/Link)} ctxt ^{:tag (* instruction)} ins]
  (cond (== (.-as ins) ACLW)
    (wantScaledImmU ctxt ins (.-imm ins) 7 4)
    (or (== (.-as ins) ACLD) (== (.-as ins) ACFLD))
    (wantScaledImmU ctxt ins (.-imm ins) 8 8) :else

    (wantImmI ctxt ins (.-imm ins) 5))

  (if (== (.-as ins) ACFLD)
    (wantFloatPrimeReg ctxt ins "rd" (.-rd ins))

    (wantIntPrimeReg ctxt ins "rd" (.-rd ins)))

  (wantIntPrimeReg ctxt ins "rs1" (.-rs1 ins))
  (wantNoneReg ctxt ins "rs2" (.-rs2 ins)))


^{:go/end 1393} (go/func validateCR [^{:tag (* obj/Link)} ctxt ^{:tag (* instruction)} ins]
  (switch (.-as ins)
    (case [ACJR ACJALR]
      (wantNoneReg ctxt ins "rd" (.-rd ins))
      (wantIntReg ctxt ins "rs1" (.-rs1 ins))
      (wantNoneReg ctxt ins "rs2" (.-rs2 ins))
      (when (== (.-rs1 ins) REG_X0)
        (.Diag ctxt "%v: cannot use register X0 in rs1" ins)))

    (case [ACMV]
      (wantIntReg ctxt ins "rd" (.-rd ins))
      (wantNoneReg ctxt ins "rs1" (.-rs1 ins))
      (wantIntReg ctxt ins "rs2" (.-rs2 ins))
      (when (== (.-rd ins) REG_X0)
        (.Diag ctxt "%v: cannot use register X0 in rd" ins))

      (when (== (.-rs2 ins) REG_X0)
        (.Diag ctxt "%v: cannot use register X0 in rs2" ins)))

    (case [ACEBREAK]
      (wantNoneReg ctxt ins "rd" (.-rd ins))
      (wantNoneReg ctxt ins "rs1" (.-rs1 ins))
      (wantNoneReg ctxt ins "rs2" (.-rs2 ins)))
    (case [ACADD]
      (wantIntReg ctxt ins "rd" (.-rd ins))
      (when (== (.-rd ins) REG_X0)
        (.Diag ctxt "%v: cannot use register X0 in rd" ins))

      (when (!= (.-rd ins) (.-rs1 ins))
        (.Diag ctxt "%v: rd must be the same as rs1" ins))

      (wantIntReg ctxt ins "rs2" (.-rs2 ins))
      (when (== (.-rs2 ins) REG_X0)
        (.Diag ctxt "%v: cannot use register X0 in rs2" ins)))))




^{:go/end 1410} (go/func validateCS [^{:tag (* obj/Link)} ctxt ^{:tag (* instruction)} ins]
  (cond (== (.-as ins) ACSW)
    (wantScaledImmU ctxt ins (.-imm ins) 7 4)
    (or (== (.-as ins) ACSD) (== (.-as ins) ACFSD))
    (wantScaledImmU ctxt ins (.-imm ins) 8 8) :else

    (wantImmI ctxt ins (.-imm ins) 5))

  (wantNoneReg ctxt ins "rd" (.-rd ins))
  (wantIntPrimeReg ctxt ins "rs1" (.-rs1 ins))
  (if (== (.-as ins) ACFSD)
    (wantFloatPrimeReg ctxt ins "rs2" (.-rs2 ins))

    (wantIntPrimeReg ctxt ins "rs2" (.-rs2 ins))))



^{:go/end 1429} (go/func validateCSS [^{:tag (* obj/Link)} ctxt ^{:tag (* instruction)} ins]
  (when (!= (.-rd ins) REG_SP)
    (.Diag ctxt "%v: rd must be SP/X2" ins))

  (cond (== (.-as ins) ACSWSP)
    (wantScaledImmU ctxt ins (.-imm ins) 8 4)
    (or (== (.-as ins) ACSDSP) (== (.-as ins) ACFSDSP))
    (wantScaledImmU ctxt ins (.-imm ins) 9 8) :else

    (wantImmI ctxt ins (.-imm ins) 6))

  (wantNoneReg ctxt ins "rs1" (.-rs1 ins))
  (if (== (.-as ins) ACFSDSP)
    (wantFloatReg ctxt ins "rs2" (.-rs2 ins))

    (wantIntReg ctxt ins "rs2" (.-rs2 ins))))




^{:go/end 52} (go/func jalToSym [^{:tag (* obj/Link)} ctxt ^{:tag (* obj/Prog)} p ^int16 lr]
  (switch (.-As p)
    (case [obj/ACALL obj/AJMP obj/ARET])
    (default
      (.Diag ctxt "unexpected Prog in jalToSym: %v" p)
      (return)))


  (set! (.-As p) AJAL)
  (set! (.-Mark p) bit-or NEED_JAL_RELOC)
  (set! (.-Type (.-From p)) obj/TYPE_REG)
  (set! (.-Reg (.-From p)) lr)
  (set! (.-Reg p) obj/REG_NONE))




^{:go/end 186} (go/func progedit "progedit is called individually for each *obj.Prog. It normalizes instruction\nformats and eliminates as many pseudo-instructions as possible.\n" [^{:tag (* obj/Link)} ctxt ^{:tag (* obj/Prog)} p ^obj/ProgAlloc newprog]
  (let [(values insData err) (instructionDataForAs (.-As p))]
    (when (!= err nil)
      (panic (fmt/Sprintf "failed to lookup instruction data for %v: %v" (.-As p) err)))


    ;; Expand binary instructions to ternary ones.
    (when (== (.-Reg p) obj/REG_NONE)
      (when (.-ternary insData)
        (set! (.-Reg p) (.-Reg (.-To p)))))



    ;; Rewrite instructions with constant operands to refer to the immediate
    ;; form of the instruction.
    (when (== (.-Type (.-From p)) obj/TYPE_CONST)
      (switch (.-As p)
        (case [ACSUB]
          (set! (values (.-As p) (.-Offset (.-From p))) (values ACADDI (- (.-Offset (.-From p))))))
        (case [ACSUBW]
          (set! (values (.-As p) (.-Offset (.-From p))) (values ACADDIW (- (.-Offset (.-From p))))))
        (case [ASUB]
          (set! (values (.-As p) (.-Offset (.-From p))) (values AADDI (- (.-Offset (.-From p))))))
        (case [ASUBW]
          (set! (values (.-As p) (.-Offset (.-From p))) (values AADDIW (- (.-Offset (.-From p))))))
        (default
          (when (!= (.-immForm insData) obj/AXXX)
            (set! (.-As p) (.-immForm insData))))))




    (switch (.-As p)
      (case [obj/AJMP]
        ;; Turn JMP into JAL ZERO or JALR ZERO.
        (set! (.-Type (.-From p)) obj/TYPE_REG)
        (set! (.-Reg (.-From p)) REG_ZERO)

        (switch (.-Type (.-To p))
          (case [obj/TYPE_BRANCH]
            (set! (.-As p) AJAL))
          (case [obj/TYPE_MEM]
            (switch (.-Name (.-To p))
              (case [obj/NAME_NONE]
                (set! (.-As p) AJALR))
              (case [obj/NAME_EXTERN obj/NAME_STATIC])
              ;; Handled in preprocess.
              (default
                (.Diag ctxt "unsupported name %d for %v" (.-Name (.-To p)) p))))

          (default
            (panic (fmt/Sprintf "unhandled type %+v" (.-Type (.-To p)))))))


      (case [obj/ACALL]
        (switch (.-Type (.-To p))
          (case [obj/TYPE_MEM])
          ;; Handled in preprocess.
          (case [obj/TYPE_REG]
            (set! (.-As p) AJALR)
            (set! (.-Type (.-From p)) obj/TYPE_REG)
            (set! (.-Reg (.-From p)) REG_LR))
          (default
            (.Diag ctxt "unknown destination type %+v in CALL: %v" (.-Type (.-To p)) p))))


      (case [obj/AUNDEF]
        (set! (.-As p) AEBREAK))

      (case [AFMVXS]
        ;; FMVXS is the old name for FMVXW.
        (set! (.-As p) AFMVXW))

      (case [AFMVSX]
        ;; FMVSX is the old name for FMVWX.
        (set! (.-As p) AFMVWX))

      (case [ASCALL]
        ;; SCALL is the old name for ECALL.
        (set! (.-As p) AECALL))

      (case [ASBREAK]
        ;; SBREAK is the old name for EBREAK.
        (set! (.-As p) AEBREAK))

      (case [AMOV]
        (when (and (== (.-Type (.-From p)) obj/TYPE_CONST) (== (.-Name (.-From p)) obj/NAME_NONE) (== (.-Reg (.-From p)) obj/REG_NONE))
          (when (isMaterialisableConst (.-Offset (.-From p)))
            (break))

          ;; Put non-materialisable constants in memory and load them.
          (set! (.-Type (.-From p)) obj/TYPE_MEM)
          (set! (.-Sym (.-From p)) (.Int64Sym ctxt (.-Offset (.-From p))))
          (set! (.-Name (.-From p)) obj/NAME_EXTERN)
          (set! (.-Offset (.-From p)) 0)))


      (case [AMOVF]
        (when (and (== (.-Type (.-From p)) obj/TYPE_FCONST) (== (.-Name (.-From p)) obj/NAME_NONE) (== (.-Reg (.-From p)) obj/REG_NONE))
          (let [f64 (assert float64 (.-Val (.-From p)))
              ^{:line 156} f32 (conv float32 f64)]
            (when (== (math/Float32bits f32) 0)
              (set! (.-Type (.-From p)) obj/TYPE_REG)
              (set! (.-Reg (.-From p)) REG_ZERO)
              (break))

            (set! (.-Type (.-From p)) obj/TYPE_MEM)
            (set! (.-Sym (.-From p)) (.Float32Sym ctxt f32))
            (set! (.-Name (.-From p)) obj/NAME_EXTERN)
            (set! (.-Offset (.-From p)) 0))))


      (case [AMOVD]
        (when (and (== (.-Type (.-From p)) obj/TYPE_FCONST) (== (.-Name (.-From p)) obj/NAME_NONE) (== (.-Reg (.-From p)) obj/REG_NONE))
          (let [f64 (assert float64 (.-Val (.-From p)))]
            (when (== (math/Float64bits f64) 0)
              (set! (.-Type (.-From p)) obj/TYPE_REG)
              (set! (.-Reg (.-From p)) REG_ZERO)
              (break))

            (set! (.-Type (.-From p)) obj/TYPE_MEM)
            (set! (.-Sym (.-From p)) (.Float64Sym ctxt f64))
            (set! (.-Name (.-From p)) obj/NAME_EXTERN)
            (set! (.-Offset (.-From p)) 0)))))



    (when (.-Flag_dynlink ctxt)
      (rewriteToUseGot ctxt p newprog))))




^{:go/end 267} (go/func rewriteToUseGot "Rewrite p, if necessary, to access global data via the global offset table.\n" [^{:tag (* obj/Link)} ctxt ^{:tag (* obj/Prog)} p ^obj/ProgAlloc newprog]
  ;; We only care about global data: NAME_EXTERN means a global
  ;; symbol in the Go sense and p.Sym.Local is true for a few internally
  ;; defined symbols.
  (when (and (== (.-Type (.-From p)) obj/TYPE_ADDR) (== (.-Name (.-From p)) obj/NAME_EXTERN) (not ^{:go/via [Attribute]} (.Local (.-Sym (.-From p)))))
    ;; MOV $sym, Rx becomes MOV sym@GOT, Rx
    ;; MOV $sym+<off>, Rx becomes MOV sym@GOT, Rx; ADD <off>, Rx
    (when (!= (.-As p) AMOV)
      (.Diag ctxt "don't know how to handle TYPE_ADDR in %v with -dynlink" p))

    (when (!= (.-Type (.-To p)) obj/TYPE_REG)
      (.Diag ctxt "don't know how to handle LD instruction to non-register in %v with -dynlink" p))

    (set! (.-Type (.-From p)) obj/TYPE_MEM)
    (set! (.-Name (.-From p)) obj/NAME_GOTREF)
    (when (!= (.-Offset (.-From p)) 0)
      (let [q (obj/Appendp p newprog)]
        (set! (.-As q) AADD)
        (set! (.-Type (.-From q)) obj/TYPE_CONST)
        (set! (.-Offset (.-From q)) (.-Offset (.-From p)))
        (set! (.-To q) (.-To p))
        (set! (.-Offset (.-From p)) 0))))




  (when (and (!= (.GetFrom3 p) nil) (== (.-Name (.GetFrom3 p)) obj/NAME_EXTERN))
    (.Diag ctxt "don't know how to handle %v with -dynlink" p))


  (let [^{:tag (* obj/Addr)} source (zero (* obj/Addr))]
    ;; MOVx sym, Ry becomes MOV sym@GOT, X31; MOVx (X31), Ry
    ;; MOVx Ry, sym becomes MOV sym@GOT, X31; MOV Ry, (X31)
    ;; An addition may be inserted between the two MOVs if there is an offset.
    (cond (and (== (.-Name (.-From p)) obj/NAME_EXTERN) (not ^{:go/via [Attribute]} (.Local (.-Sym (.-From p))))) (do
        (when (and (== (.-Name (.-To p)) obj/NAME_EXTERN) (not ^{:go/via [Attribute]} (.Local (.-Sym (.-To p)))))
          (.Diag ctxt "cannot handle NAME_EXTERN on both sides in %v with -dynlink" p))

        (set! source (addr (.-From p))))
      (and (== (.-Name (.-To p)) obj/NAME_EXTERN) (not ^{:go/via [Attribute]} (.Local (.-Sym (.-To p)))))
      (set! source (addr (.-To p))) :else

      (return))

    (when (or (== (.-As p) obj/ATEXT) (== (.-As p) obj/AFUNCDATA) (== (.-As p) obj/ACALL) (== (.-As p) obj/ARET) (== (.-As p) obj/AJMP))
      (return))

    (when (== (.-Type (.-Sym source)) objabi/STLSBSS)
      (return))

    (when (!= (.-Type source) obj/TYPE_MEM)
      (.Diag ctxt "don't know how to handle %v with -dynlink" p))

    (let [p1 (obj/Appendp p newprog)]
      (set! (.-As p1) AMOV)
      (set! (.-Type (.-From p1)) obj/TYPE_MEM)
      (set! (.-Sym (.-From p1)) (.-Sym source))
      (set! (.-Name (.-From p1)) obj/NAME_GOTREF)
      (set! (.-Type (.-To p1)) obj/TYPE_REG)
      (set! (.-Reg (.-To p1)) REG_TMP)

      (let [p2 (obj/Appendp p1 newprog)]
        (set! (.-As p2) (.-As p))
        (set! (.-From p2) (.-From p))
        (set! (.-To p2) (.-To p))
        (cond (== (.-Name (.-From p)) obj/NAME_EXTERN) (do
            (set! (.-Reg (.-From p2)) REG_TMP)
            (set! (.-Name (.-From p2)) obj/NAME_NONE)
            (set! (.-Sym (.-From p2)) nil))
          (== (.-Name (.-To p)) obj/NAME_EXTERN) (do
            (set! (.-Reg (.-To p2)) REG_TMP)
            (set! (.-Name (.-To p2)) obj/NAME_NONE)
            (set! (.-Sym (.-To p2)) nil)) :else

          (return))

        (obj/Nopout p)))))




^{:go/end 276} (go/func addrToReg "addrToReg extracts the register from an Addr, handling special Addr.Names.\n" ^int16 [^obj/Addr a]
  (switch (.-Name a)
    (case [obj/NAME_PARAM obj/NAME_AUTO]
      (return REG_SP)))

  (.-Reg a))



^{:go/end 302} (go/func movToLoad "movToLoad converts a MOV mnemonic into the corresponding load instruction.\n" ^obj/As [^obj/As mnemonic]
  (switch mnemonic
    (case [AMOV]
      (return ALD))
    (case [AMOVB]
      (return ALB))
    (case [AMOVH]
      (return ALH))
    (case [AMOVW]
      (return ALW))
    (case [AMOVBU]
      (return ALBU))
    (case [AMOVHU]
      (return ALHU))
    (case [AMOVWU]
      (return ALWU))
    (case [AMOVF]
      (return AFLW))
    (case [AMOVD]
      (return AFLD))
    (default
      (panic (fmt/Sprintf "%+v is not a MOV" mnemonic)))))




^{:go/end 322} (go/func movToStore "movToStore converts a MOV mnemonic into the corresponding store instruction.\n" ^obj/As [^obj/As mnemonic]
  (switch mnemonic
    (case [AMOV]
      (return ASD))
    (case [AMOVB]
      (return ASB))
    (case [AMOVH]
      (return ASH))
    (case [AMOVW]
      (return ASW))
    (case [AMOVF]
      (return AFSW))
    (case [AMOVD]
      (return AFSD))
    (default
      (panic (fmt/Sprintf "%+v is not a MOV" mnemonic)))))





^{:go/end 351} (go/func markRelocs "markRelocs marks an obj.Prog that specifies a MOV pseudo-instruction and\nrequires relocation.\n" [^{:tag (* obj/Prog)} p]
  (switch (.-As p)
    (case [AMOV AMOVB AMOVH AMOVW AMOVBU AMOVHU AMOVWU AMOVF AMOVD]
      (switch
        (case [(and (== (.-Type (.-From p)) obj/TYPE_ADDR) (== (.-Type (.-To p)) obj/TYPE_REG))]
          (switch (.-Name (.-From p))
            (case [obj/NAME_EXTERN obj/NAME_STATIC]
              (set! (.-Mark p) bit-or NEED_PCREL_ITYPE_RELOC))
            (case [obj/NAME_GOTREF]
              (set! (.-Mark p) bit-or NEED_GOT_PCREL_ITYPE_RELOC))))

        (case [(and (== (.-Type (.-From p)) obj/TYPE_MEM) (== (.-Type (.-To p)) obj/TYPE_REG))]
          (switch (.-Name (.-From p))
            (case [obj/NAME_EXTERN obj/NAME_STATIC]
              (set! (.-Mark p) bit-or NEED_PCREL_ITYPE_RELOC))
            (case [obj/NAME_GOTREF]
              (set! (.-Mark p) bit-or NEED_GOT_PCREL_ITYPE_RELOC))))

        (case [(and (== (.-Type (.-From p)) obj/TYPE_REG) (== (.-Type (.-To p)) obj/TYPE_MEM))]
          (switch (.-Name (.-To p))
            (case [obj/NAME_EXTERN obj/NAME_STATIC]
              (set! (.-Mark p) bit-or NEED_PCREL_STYPE_RELOC))))))))






^{:go/end 395} (go/func InvertBranch "InvertBranch inverts the condition of a conditional branch.\n" ^obj/As [^obj/As as]
  (switch as
    (case [ABEQ]
      (return ABNE))
    (case [ABEQZ]
      (return ABNEZ))
    (case [ABGE]
      (return ABLT))
    (case [ABGEU]
      (return ABLTU))
    (case [ABGEZ]
      (return ABLTZ))
    (case [ABGT]
      (return ABLE))
    (case [ABGTU]
      (return ABLEU))
    (case [ABGTZ]
      (return ABLEZ))
    (case [ABLE]
      (return ABGT))
    (case [ABLEU]
      (return ABGTU))
    (case [ABLEZ]
      (return ABGTZ))
    (case [ABLT]
      (return ABGE))
    (case [ABLTU]
      (return ABGEU))
    (case [ABLTZ]
      (return ABGEZ))
    (case [ABNE]
      (return ABEQ))
    (case [ABNEZ]
      (return ABEQZ))
    (case [ACBEQZ]
      (return ACBNEZ))
    (case [ACBNEZ]
      (return ACBEQZ))
    (default
      (panic "InvertBranch: not a branch"))))





^{:go/breaks [[5 412]] :go/end 413} (go/func containsCall "containsCall reports whether the symbol contains a CALL (or equivalent)\ninstruction. Must be called after progedit.\n" ^bool [^{:tag (* obj/LSym)} sym]
  ;; CALLs are CALL or JAL(R) with link register LR.
  (for [p (.-Text (.Func sym))] (!= p nil) (set! p (.-Link p))
    (switch (.-As p)
      (case [obj/ACALL]
        (return true))
      (case [ACJALR AJAL AJALR]
        (when (and (== (.-Type (.-From p)) obj/TYPE_REG) (== (.-Reg (.-From p)) REG_LR))
          (return true)))))




  false)




^{:go/end 431} (go/func setPCs "setPCs sets the Pc field in all instructions reachable from p.\nIt uses pc as the initial value and returns the next available pc.\n" ^int64 [^{:tag (* obj/Prog)} p ^int64 pc ^bool compress]
  (for [] (!= p nil) (set! p (.-Link p))
    (set! (.-Pc p) pc)
    (range [_ ins (instructionsForProg p compress)]
      (set! pc + (conv int64 (.length ins))))


    (when (== (.-As p) obj/APCALIGN)
      (let [alignedValue (.-Offset (.-From p))
          ^{:line 426} v (pcAlignPadLength pc alignedValue)]
        (set! pc + (conv int64 v)))))


  ^{:line 430} pc)


























^{:go/end 466} (go/func stackOffset "stackOffset updates Addr offsets based on the current stack size.\n\nThe stack looks like:\n-------------------\n|                 |\n|      PARAMs     |\n|                 |\n|                 |\n-------------------\n|    Parent RA    |   SP on function entry\n-------------------\n|                 |\n|                 |\n|       AUTOs     |\n|                 |\n|                 |\n-------------------\n|        RA       |   SP during function execution\n-------------------\n\nFixedFrameSize makes other packages aware of the space allocated for RA.\n\nA nicer version of this diagram can be found on slide 21 of the presentation\nattached to https://golang.org/issue/16922#issuecomment-243748180.\n" [^{:tag (* obj/Addr)} a ^int64 stacksize]
  (switch (.-Name a)
    (case [obj/NAME_AUTO]
      ;; Adjust to the top of AUTOs.
      (set! (.-Offset a) + stacksize))
    (case [obj/NAME_PARAM]
      ;; Adjust to the bottom of PARAMs.
      (set! (.-Offset a) + (+ stacksize 8)))))











^{:go/end 811} (go/func preprocess "preprocess generates prologue and epilogue code, computes PC-relative branch\nand jump offsets, and resolves pseudo-registers.\n\npreprocess is called once per linker symbol.\n\nWhen preprocess finishes, all instructions in the symbol are either\nconcrete, real RISC-V instructions or directive pseudo-ops like TEXT,\nPCDATA, and FUNCDATA.\n" [^{:tag (* obj/Link)} ctxt ^{:tag (* obj/LSym)} cursym ^obj/ProgAlloc newprog]
  (when (or (== (.-Text (.Func cursym)) nil) (== (.-Link (.-Text (.Func cursym))) nil))
    (return))


  ;; Generate the prologue.
  (let [text (.-Text (.Func cursym))]
    (when (!= (.-As text) obj/ATEXT)
      (.Diag ctxt "preprocess: found symbol that does not start with TEXT directive")
      (return))


    (let [stacksize (.-Offset (.-To text))]
      (when (== stacksize -8)
        ;; Historical way to mark NOFRAME.
        ^{:go/via [Attribute]} (.Set (.-Sym (.-From text)) obj/AttrNoFrame true)
        (set! stacksize 0))

      (when (< stacksize 0)
        (.Diag ctxt "negative frame size %d - did you mean NOFRAME?" stacksize))

      (when ^{:go/via [Attribute]} (.NoFrame (.-Sym (.-From text)))
        (when (!= stacksize 0)
          (.Diag ctxt "NOFRAME functions must have a frame size of 0, not %d" stacksize)))



      (when (not (containsCall cursym))
        ^{:go/via [Attribute]} (.Set (.-Sym (.-From text)) obj/AttrLeaf true)
        (when (== stacksize 0)
          ;; A leaf function with no locals has no frame.
          ^{:go/via [Attribute]} (.Set (.-Sym (.-From text)) obj/AttrNoFrame true)))



      ;; Save LR unless there is no frame.
      (when (not ^{:go/via [Attribute]} (.NoFrame (.-Sym (.-From text))))
        (set! stacksize + ^{:go/via [Arch]} (.-FixedFrameSize (.-Arch ctxt))))


      (set! (.-Args (.Func cursym)) (assert int32 (.-Val (.-To text))))
      (set! (.-Locals (.Func cursym)) (conv int32 stacksize))

      (let [prologue text]

        (when (not ^{:go/via [Attribute]} (.NoSplit (.-Sym (.-From (.-Text (.Func cursym))))))
          (set! prologue (stacksplit ctxt prologue cursym newprog stacksize))) ; emit split check


        (let [q prologue]

          (when (!= stacksize 0)
            (set! prologue (.StartUnsafePoint ctxt prologue newprog))

            ;; Actually save LR.
            (set! prologue (obj/Appendp prologue newprog))
            (set! (.-As prologue) AMOV)
            (set! (.-Pos prologue) (.-Pos q))
            (set! (.-From prologue) (lit obj/Addr :Type obj/TYPE_REG :Reg REG_LR))
            (set! (.-To prologue) (lit obj/Addr :Type obj/TYPE_MEM :Reg REG_SP :Offset (- stacksize)))

            ;; Insert stack adjustment.
            (set! prologue (obj/Appendp prologue newprog))
            (set! (.-As prologue) AADDI)
            (set! (.-Pos prologue) (.-Pos q))
            (set! (.-Pos prologue) (.WithXlogue (.-Pos prologue) src/PosPrologueEnd))
            (set! (.-From prologue) (lit obj/Addr :Type obj/TYPE_CONST :Offset (- stacksize)))
            (set! (.-Reg prologue) REG_SP)
            (set! (.-To prologue) (lit obj/Addr :Type obj/TYPE_REG :Reg REG_SP))
            (set! (.-Spadj prologue) (conv int32 stacksize))

            (set! prologue (.EndUnsafePoint ctxt prologue newprog -1))

            ;; On Linux, in a cgo binary we may get a SIGSETXID signal early on
            ;; before the signal stack is set, as glibc doesn't allow us to block
            ;; SIGSETXID. So a signal may land on the current stack and clobber
            ;; the content below the SP. We store the LR again after the SP is
            ;; decremented.
            (set! prologue (obj/Appendp prologue newprog))
            (set! (.-As prologue) AMOV)
            (set! (.-From prologue) (lit obj/Addr :Type obj/TYPE_REG :Reg REG_LR))
            (set! (.-To prologue) (lit obj/Addr :Type obj/TYPE_MEM :Reg REG_SP :Offset 0)))


          ;; Update stack-based offsets.
          (for [p (.-Text (.Func cursym))] (!= p nil) (set! p (.-Link p))
            (stackOffset (addr (.-From p)) stacksize)
            (stackOffset (addr (.-To p)) stacksize))


          ;; Additional instruction rewriting.
          (for [p (.-Text (.Func cursym))] (!= p nil) (set! p (.-Link p))
            (switch (.-As p)
              (case [obj/AGETCALLERPC]
                (if ^{:go/via [Attribute]} (.Leaf cursym) (do
                    ;; MOV LR, Rd
                    (set! (.-As p) AMOV)
                    (set! (.-Type (.-From p)) obj/TYPE_REG)
                    (set! (.-Reg (.-From p)) REG_LR))
                  (do
                    ;; MOV (RSP), Rd
                    (set! (.-As p) AMOV)
                    (set! (.-Type (.-From p)) obj/TYPE_MEM)
                    (set! (.-Reg (.-From p)) REG_SP))))


              (case [obj/ACALL]
                (switch (.-Type (.-To p))
                  (case [obj/TYPE_MEM]
                    (jalToSym ctxt p REG_LR))))


              (case [obj/AJMP]
                (switch (.-Type (.-To p))
                  (case [obj/TYPE_MEM]
                    (switch (.-Name (.-To p))
                      (case [obj/NAME_EXTERN obj/NAME_STATIC]
                        (jalToSym ctxt p REG_ZERO))))))



              (case [obj/ARET]
                ;; Replace RET with epilogue.
                (let [(values retJMP retReg) (values (.-Sym (.-To p)) (.-Reg (.-To p)))]
                  (when (== retReg obj/REG_NONE)
                    (set! retReg REG_LR))


                  (when (!= stacksize 0)
                    ;; Restore LR.
                    (set! (.-As p) AMOV)
                    (set! (.-From p) (lit obj/Addr :Type obj/TYPE_MEM :Reg REG_SP :Offset 0))
                    (set! (.-To p) (lit obj/Addr :Type obj/TYPE_REG :Reg REG_LR))
                    (set! p (obj/Appendp p newprog))

                    (set! (.-As p) AADDI)
                    (set! (.-From p) (lit obj/Addr :Type obj/TYPE_CONST :Offset stacksize))
                    (set! (.-Reg p) REG_SP)
                    (set! (.-To p) (lit obj/Addr :Type obj/TYPE_REG :Reg REG_SP))
                    (set! (.-Spadj p) (conv int32 (- stacksize)))
                    (set! p (obj/Appendp p newprog)))


                  (if (!= retJMP nil) (do
                      (set! (.-As p) obj/ARET)
                      (set! (.-Sym (.-To p)) retJMP)
                      (jalToSym ctxt p REG_ZERO))
                    (do
                      (set! (.-As p) AJALR)
                      (set! (.-From p) (lit obj/Addr :Type obj/TYPE_REG :Reg REG_ZERO))
                      (set! (.-Reg p) obj/REG_NONE)
                      (set! (.-To p) (lit obj/Addr :Type obj/TYPE_REG :Reg retReg))))



    (return 0 0 err))


  ;; Nothing special needs to be done if the immediate fits in 12 bits.
  (when [err (immIFits imm 12)] (== err nil)
    (return imm 0 nil))


  (set! high (>> imm 12))

  ;; The bottom 12 bits will be treated as signed.
  ;;

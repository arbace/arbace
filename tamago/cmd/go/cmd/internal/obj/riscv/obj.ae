  (wantImmU ctxt ins (.-imm ins) 32))




^{:go/end 1775} (go/func compressedEncoding "compressedEncoding returns the fixed instruction encoding for a compressed\ninstruction.\n" ^uint32 [^obj/As as]
  (let [enc (encode as)]
    (when (== enc nil)
      (panic "compressedEncoding: could not encode instruction"))


    ;; TODO: this can be removed once encode is reworked to return the
    ;; necessary bits.
    (let [op (conv uint32 0)]
      (switch as
        (case [ACSUB]
          (set! op (bit-or (<< 2r100011 10) (<< 2r00 5))))
        (case [ACXOR]
          (set! op (bit-or (<< 2r100011 10) (<< 2r01 5))))
        (case [ACOR]
          (set! op (bit-or (<< 2r100011 10) (<< 2r10 5))))
        (case [ACAND]
          (set! op (bit-or (<< 2r100011 10) (<< 2r11 5))))
        (case [ACSUBW]
          (set! op (bit-or (<< 2r100111 10) (<< 2r00 5))))
        (case [ACADDW]
          (set! op (bit-or (<< 2r100111 10) (<< 2r01 5))))
        (case [ACBEQZ]
          (set! op (<< 2r110 13)))

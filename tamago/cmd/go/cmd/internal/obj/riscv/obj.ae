^{:go/end 1642} (go/func validateB [^{:tag (* obj/Link)} ctxt ^{:tag (* instruction)} ins]
  ;; Offsets are multiples of two, so accept 13 bit immediates for the
  ;; 12 bit slot. We implicitly drop the least significant bit in encodeB.
  (wantEvenOffset ctxt ins (.-imm ins))
  (wantImmI ctxt ins (.-imm ins) 13)
  (wantNoneReg ctxt ins "rd" (.-rd ins))
  (wantIntReg ctxt ins "rs1" (.-rs1 ins))
  (wantIntReg ctxt ins "rs2" (.-rs2 ins))
  (wantNoneReg ctxt ins "rs3" (.-rs3 ins)))



(go/var ^{:doc "opSuffix encoding to uint8 which fit into p.Scond\n"} rmSuffixSet (lit (map string uint8)
    ^{:line 1578} ["RNE" RM_RNE]
    ^{:line 1579} ["RTZ" RM_RTZ]
    ^{:line 1580} ["RDN" RM_RDN]
    ^{:line 1581} ["RUP" RM_RUP]
    ^{:line 1582} ["RMM" RM_RMM]))


(go/const
  ^{:line 1586} [^{:tag uint8 :val 1} fenceTsoSuffixBit (<< 1 0)]
  ^{:line 1587} [^{:tag uint8 :val 128} rmSuffixBit (<< 1 7)])


^{:go/end 1599} (go/func rmSuffixEncode [^string s] :results [uint8 error]
  (when (== s "")
    (return 0 (errors/New "empty suffix")))

  (let [(values enc ok) (aget rmSuffixSet s)]
    (when (not ok)
      (return 0 (fmt/Errorf "invalid encoding for unknown suffix:%q" s)))

    (return (bit-or enc rmSuffixBit) nil)))


^{:go/end 1613} (go/func rmSuffixString [^uint8 u] :results [string error]
  (when (== (bit-and u rmSuffixBit) 0)
    (return "" (fmt/Errorf "invalid suffix, require round mode bit:%x" u)))


  (set! u bit-and-not rmSuffixBit)
  (range [k v rmSuffixSet]
    (when (== v u)
      (return k nil)))


  (return "" (fmt/Errorf "unknown suffix:%x" u)))


(go/const
  ^{:line 1616} [^{:tag uint8 :val 0} RM_RNE iota] ; Round to Nearest, ties to Even
  ^{:line 1617} [^{:val 1} RM_RTZ] ; Round towards Zero
  ^{:line 1618} [^{:val 2} RM_RDN] ; Round Down
  ^{:line 1619} [^{:val 3} RM_RUP] ; Round Up
  ^{:line 1620} [^{:val 4} RM_RMM]) ; Round to Nearest, ties to Max Magnitude



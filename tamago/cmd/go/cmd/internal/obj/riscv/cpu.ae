  ^{:line 316} [^{:val 8 :doc "NEED_PCREL_ITYPE_RELOC is set on AUIPC instructions to indicate that\nit is the first instruction in an AUIPC + I-type pair that needs a\nR_RISCV_PCREL_ITYPE relocation.\n"} NEED_PCREL_ITYPE_RELOC]




  ^{:line 321} [^{:val 16 :doc "NEED_PCREL_STYPE_RELOC is set on AUIPC instructions to indicate that\nit is the first instruction in an AUIPC + S-type pair that needs a\nR_RISCV_PCREL_STYPE relocation.\n"} NEED_PCREL_STYPE_RELOC]




  ^{:line 326} [^{:val 32 :doc "NEED_GOT_PCREL_ITYPE_RELOC is set on AUIPC instructions to indicate that\nit is the first instruction in an AUIPC + I-type pair that needs a\nR_RISCV_GOT_PCREL_ITYPE relocation.\n"} NEED_GOT_PCREL_ITYPE_RELOC])



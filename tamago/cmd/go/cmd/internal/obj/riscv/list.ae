(in-ns 'go.cmd.internal.obj.riscv) (go/file "list.go" :imports [


    ^{:line 8} [fmt "fmt"]

    ^{:line 10} [obj "cmd/internal/obj"]])


^{:go/end 18} (go/func init []
  (obj/RegisterRegister obj/RBaseRISCV REG_END RegName)
  (obj/RegisterOpcode obj/ABaseRISCV Anames)
  (obj/RegisterOpSuffix "riscv64" opSuffixString)
  (obj/RegisterSpecialOperands (conv int64 SPOP_BEGIN) (conv int64 SPOP_END) specialOperandConv))


^{:go/end 37} (go/func RegName ^string [^int r]
  (switch
    (case [(== r 0)]
      (return "NONE"))
    (case [(== r REG_G)]
      (return "g"))
    (case [(== r REG_SP)]
      (return "SP"))
    (case [(and (<= REG_X0 r) (<= r REG_X31))]
      (return (fmt/Sprintf "X%d" (- r REG_X0))))
    (case [(and (<= REG_F0 r) (<= r REG_F31))]
      (return (fmt/Sprintf "F%d" (- r REG_F0))))
    (case [(and (<= REG_V0 r) (<= r REG_V31))]
      (return (fmt/Sprintf "V%d" (- r REG_V0))))
    (default
      (return (fmt/Sprintf "Rgok(%d)" (- r obj/RBaseRISCV))))))



^{:go/end 55} (go/func opSuffixString ^string [^uint8 s]
  (when (== s fenceTsoSuffixBit)
    (return ".TSO"))

  (when (== (bit-and s rmSuffixBit) 0)
    (return ""))


  (let [(values ss err) (rmSuffixString s)]
    (when (!= err nil)
      (set! ss (fmt/Sprintf "<invalid 0x%x>" s)))

    (when (== ss "")
      (return ss))

    (fmt/Sprintf ".%s" ss)))


^{:go/end 68} (go/func specialOperandConv ^string [^int64 a]
  (let [^string s (zero string)

      ^{:line 60} spc (conv SpecialOperand a)]
    (when (and (>= spc SPOP_BEGIN) (< spc SPOP_END))
      (set! s (.String spc)))

    (when (== s "")
      (return "SPC_??"))

    ^{:line 67} s))

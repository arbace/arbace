(in-ns 'go.cmd.internal.obj) (go/file "go.go" :imports [])

;; go-specific code shared across loaders (5l, 6l, 8l).

^{:go/end 16} (go/func Nopout [^{:tag (* Prog)} p]
  (set! (.-As p) ANOP)
  (set! (.-Scond p) 0)
  (set! (.-From p) (lit Addr))
  (set! (.-RestArgs p) nil)
  (set! (.-Reg p) 0)
  (set! (.-To p) (lit Addr)))

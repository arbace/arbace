      (case [ARNG_V]
        (set! arngName "V"))
      (case [ARNG_BU]
        (set! arngName "BU"))
      (case [ARNG_HU]
        (set! arngName "HU"))
      (case [ARNG_WU]
        (set! arngName "WU"))
      (case [ARNG_VU]
        (set! arngName "VU"))
      (default
        (set! arngName "ARNG_???")))


    (fmt/Sprintf "%s%d.%s" regPrefix simdReg arngName)))


^{:go/end 105} (go/func RegName ^string [^int r]
  (switch
    (case [(== r 0)]
      (return "NONE"))
    (case [(== r REGG)]
      ;; Special case.
      (return "g"))
    (case [(and (<= REG_R0 r) (<= r REG_R31))]
      (return (fmt/Sprintf "R%d" (- r REG_R0))))
    (case [(and (<= REG_F0 r) (<= r REG_F31))]
      (return (fmt/Sprintf "F%d" (- r REG_F0))))
    (case [(and (<= REG_FCSR0 r) (<= r REG_FCSR31))]
      (return (fmt/Sprintf "FCSR%d" (- r REG_FCSR0))))
    (case [(and (<= REG_FCC0 r) (<= r REG_FCC31))]
      (return (fmt/Sprintf "FCC%d" (- r REG_FCC0))))
    (case [(and (<= REG_V0 r) (<= r REG_V31))]
      (return (fmt/Sprintf "V%d" (- r REG_V0))))
    (case [(and (<= REG_X0 r) (<= r REG_X31))]
      (return (fmt/Sprintf "X%d" (- r REG_X0))))
    (case [(and (<= REG_ARNG r) (< r REG_ELEM))]
      (return (arrange (conv int16 (- r REG_ARNG)))))
    (case [(and (<= REG_ELEM r) (< r REG_ELEM_END))]
      (return (arrange (conv int16 (- r REG_ELEM))))))


  (fmt/Sprintf "badreg(%d)" (- r obj/RBaseLOONG64)))


^{:go/end 113} (go/func DRconv ^string [^int a]
  (let [s "C_??"]
    (when (and (>= a C_NONE) (<= a C_NCLASS))
      (set! s (aget cnames0 a)))


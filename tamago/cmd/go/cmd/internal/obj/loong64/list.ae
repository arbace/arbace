^{:go/end 77} (go/func arrange ^string [^int16 valid]
  (let [^string regPrefix (zero string)
      ^{:line 19 :tag string} arngName (zero string)

      ;; bits 0-4 indicates register: Vn or Xn
      ;; bits 5-9 indicates arrangement: <T>
      ;; bits 10 indicates SMID type: 0: LSX, 1: LASX
      ^{:line 24} simdType (bit-and (>> valid EXT_SIMDTYPE_SHIFT) EXT_SIMDTYPE_MASK)
      ^{:line 25} simdReg (bit-and (>> valid EXT_REG_SHIFT) EXT_REG_MASK)
      ^{:line 26} arngType (bit-and (>> valid EXT_TYPE_SHIFT) EXT_TYPE_MASK)]

    (switch simdType
      (case [LSX]
        (set! regPrefix "V"))
      (case [LASX]
        (set! regPrefix "X"))
      (default
        (set! regPrefix "#")))


    (switch arngType
      (case [ARNG_32B]
        (set! arngName "B32"))
      (case [ARNG_16H]
        (set! arngName "H16"))
      (case [ARNG_8W]
        (set! arngName "W8"))
      (case [ARNG_4V]
        (set! arngName "V4"))
      (case [ARNG_2Q]
        (set! arngName "Q2"))
      (case [ARNG_16B]
        (set! arngName "B16"))
      (case [ARNG_8H]
        (set! arngName "H8"))
      (case [ARNG_4W]
        (set! arngName "W4"))
      (case [ARNG_2V]
        (set! arngName "V2"))
      (case [ARNG_B]
        (set! arngName "B"))
      (case [ARNG_H]
        (set! arngName "H"))
      (case [ARNG_W]

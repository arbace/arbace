      (set! (.-Type (.-From p1)) obj/TYPE_MEM)
      (set! (.-Sym (.-From p1)) (.-Sym source))
      (set! (.-Name (.-From p1)) obj/NAME_GOTREF)
      (set! (.-Type (.-To p1)) obj/TYPE_REG)
      (set! (.-Reg (.-To p1)) REGTMP)

      (set! (.-As p2) (.-As p))
      (set! (.-From p2) (.-From p))
      (set! (.-To p2) (.-To p))
      (cond (== (.-Name (.-From p)) obj/NAME_EXTERN) (do
          (set! (.-Reg (.-From p2)) REGTMP)
          (set! (.-Name (.-From p2)) obj/NAME_NONE)
          (set! (.-Sym (.-From p2)) nil))
        (== (.-Name (.-To p)) obj/NAME_EXTERN) (do
          (set! (.-Reg (.-To p2)) REGTMP)
          (set! (.-Name (.-To p2)) obj/NAME_NONE)
          (set! (.-Sym (.-To p2)) nil)) :else

        (return))


      (obj/Nopout p))))



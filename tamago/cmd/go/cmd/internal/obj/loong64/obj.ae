      (let [^{:tag (* obj/Prog)} q (zero (* obj/Prog))]
        (if (<= framesize abi/StackSmall) (do
            ;; small stack: SP < stackguard
            ;;	SGTU	SP, stackguard, R20
            (set! p (obj/Appendp p (.-newprog c)))

            (set! (.-As p) ASGTU)
            (set! (.-Type (.-From p)) obj/TYPE_REG)
            (set! (.-Reg (.-From p)) REGSP)
            (set! (.-Reg p) REG_R20)
            (set! (.-Type (.-To p)) obj/TYPE_REG)
            (set! (.-Reg (.-To p)) REG_R20))

          ;; large stack: SP-framesize < stackguard-StackSmall
          (let [offset (- (conv int64 framesize) abi/StackSmall)]
            (when (> framesize abi/StackBig)
              ;; Such a large stack we need to protect against underflow.
              ;; The runtime guarantees SP > objabi.StackBig, but
              ;; framesize is large enough that SP-framesize may
              ;; underflow, causing a direct comparison with the
              ;; stack guard to incorrectly succeed. We explicitly
              ;; guard against underflow.
              ;;
              ;;      SGTU    $(framesize-StackSmall), SP, R24
              ;;      BNE     R24, label-of-call-to-morestack

              (set! p (obj/Appendp p (.-newprog c)))
              (set! (.-As p) ASGTU)
              (set! (.-Type (.-From p)) obj/TYPE_CONST)
              (set! (.-Offset (.-From p)) offset)
              (set! (.-Reg p) REGSP)
              (set! (.-Type (.-To p)) obj/TYPE_REG)
              (set! (.-Reg (.-To p)) REG_R24)

              (set! p (obj/Appendp p (.-newprog c)))
              (set! q p)
              (set! (.-As p) ABNE)
              (set! (.-Type (.-From p)) obj/TYPE_REG)
              (set! (.-Reg (.-From p)) REG_R24)
              (set! (.-Type (.-To p)) obj/TYPE_BRANCH)
              (set! (.-Mark p) bit-or BRANCH))


            (set! p (obj/Appendp p (.-newprog c)))

            (set! (.-As p) add)
            (set! (.-Type (.-From p)) obj/TYPE_CONST)
            (set! (.-Offset (.-From p)) (- offset))
            (set! (.-Reg p) REGSP)
            (set! (.-Type (.-To p)) obj/TYPE_REG)
            (set! (.-Reg (.-To p)) REG_R24)

            (set! p (obj/Appendp p (.-newprog c)))
            (set! (.-As p) ASGTU)
            (set! (.-Type (.-From p)) obj/TYPE_REG)
            (set! (.-Reg (.-From p)) REG_R24)
            (set! (.-Reg p) REG_R20)
            (set! (.-Type (.-To p)) obj/TYPE_REG)
            (set! (.-Reg (.-To p)) REG_R20)))


        ;; q1: BEQ	R20, morestack
        (set! p (obj/Appendp p (.-newprog c)))
        (let [q1 p]

          (set! (.-As p) ABEQ)
          (set! (.-Type (.-From p)) obj/TYPE_REG)
          (set! (.-Reg (.-From p)) REG_R20)
          (set! (.-Type (.-To p)) obj/TYPE_BRANCH)
          (set! (.-Mark p) bit-or BRANCH)

          (let [end (.EndUnsafePoint (.-ctxt c) p (.-newprog c) -1)

              ^{:line 670 :tag (* obj/Prog)} last (zero (* obj/Prog))]
            (for [(set! last (.-Text (.Func (.-cursym c))))] (!= (.-Link last) nil) (set! last (.-Link last)))


            ;; Now we are at the end of the function, but logically
            ;; we are still in function prologue. We need to fix the
            ;; SP data and PCDATA.
            (let [spfix (obj/Appendp last (.-newprog c))]
              (set! (.-As spfix) obj/ANOP)
              (set! (.-Spadj spfix) (- framesize))

              (let [pcdata (.EmitEntryStackMap (.-ctxt c) (.-cursym c) spfix (.-newprog c))]
                (set! pcdata (.StartUnsafePoint (.-ctxt c) pcdata (.-newprog c)))

                (when (!= q nil)
                  (.SetTarget (.-To q) pcdata))

                (.SetTarget (.-To q1) pcdata)

                (set! p (.SpillRegisterArgs (.Func (.-cursym c)) pcdata (.-newprog c)))

                ;; MOV  LINK, R31
                (set! p (obj/Appendp p (.-newprog c)))
                (set! (.-As p) mov)
                (set! (.-Type (.-From p)) obj/TYPE_REG)
                (set! (.-Reg (.-From p)) REGLINK)
                (set! (.-Type (.-To p)) obj/TYPE_REG)
                (set! (.-Reg (.-To p)) REG_R31)
                (when (!= q nil)
                  (.SetTarget (.-To q) p)
                  (set! (.-Mark p) bit-or LABEL))


                ;; JAL runtime.morestack(SB)
                (let [call (obj/Appendp p (.-newprog c))]
                  (set! (.-As call) AJAL)
                  (set! (.-Type (.-To call)) obj/TYPE_BRANCH)

                  (cond ^{:go/via [Attribute]} (.CFunc (.-cursym c))
                    (set! (.-Sym (.-To call)) (.Lookup (.-ctxt c) "runtime.morestackc"))
                    (not ^{:go/via [Attribute]} (.NeedCtxt (.-Sym (.-From (.-Text (.Func (.-cursym c)))))))
                    (set! (.-Sym (.-To call)) (.Lookup (.-ctxt c) "runtime.morestack_noctxt")) :else

                    (set! (.-Sym (.-To call)) (.Lookup (.-ctxt c) "runtime.morestack")))

                  (set! (.-Mark call) bit-or BRANCH)

                  ;; The instructions which unspill regs should be preemptible.
                  (set! pcdata (.EndUnsafePoint (.-ctxt c) call (.-newprog c) -1))
                  (let [unspill (.UnspillRegisterArgs (.Func (.-cursym c)) pcdata (.-newprog c))

                      ;; JMP start
                      ^{:line 722} jmp (obj/Appendp unspill (.-newprog c))]
                    (set! (.-As jmp) AJMP)
                    (set! (.-Type (.-To jmp)) obj/TYPE_BRANCH)
                    (.SetTarget (.-To jmp) (.-Link startPred))
                    (set! (.-Spadj jmp) (+ framesize))

                    ^{:line 728} end))))))))))



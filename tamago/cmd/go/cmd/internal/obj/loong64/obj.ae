    ;; MOVV $sym+<off>, Rx becomes MOVV sym@GOT, Rx; ADD <off>, Rx
    (when (!= (.-As p) AMOVV)
      (.Diag ctxt "do not know how to handle TYPE_ADDR in %v with -shared" p))

    (when (!= (.-Type (.-To p)) obj/TYPE_REG)
      (.Diag ctxt "do not know how to handle LEAQ-type insn to non-register in %v with -shared" p))

    (set! (.-Type (.-From p)) obj/TYPE_MEM)
    (set! (.-Name (.-From p)) obj/NAME_GOTREF)

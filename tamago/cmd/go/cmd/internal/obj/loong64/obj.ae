    (when (!= (.-Type source) obj/TYPE_MEM)
      (.Diag ctxt "don't know how to handle %v with -shared" p))

    (let [p1 (obj/Appendp p newprog)
        ^{:line 137} p2 (obj/Appendp p1 newprog)]

^{:go/end 83} (go/func progedit [^{:tag (* obj/Link)} ctxt ^{:tag (* obj/Prog)} p ^obj/ProgAlloc newprog]
  ;; Rewrite JMP/JAL to symbol as TYPE_BRANCH.
  (switch (.-As p)
    (case [AJMP AJAL ARET]
      (when (!= (.-Sym (.-To p)) nil)
        (set! (.-Type (.-To p)) obj/TYPE_BRANCH))))



  ;; Rewrite float constants to values stored in memory.
  (switch (.-As p)
    (case [AMOVF]
      (when (== (.-Type (.-From p)) obj/TYPE_FCONST)
        (let [f32 (conv float32 (assert float64 (.-Val (.-From p))))]
          (when (== (math/Float32bits f32) 0)
            (set! (.-As p) AMOVW)
            (set! (.-Type (.-From p)) obj/TYPE_REG)
            (set! (.-Reg (.-From p)) REGZERO)
            (break))

          (set! (.-Type (.-From p)) obj/TYPE_MEM)
          (set! (.-Sym (.-From p)) (.Float32Sym ctxt f32))
          (set! (.-Name (.-From p)) obj/NAME_EXTERN)
          (set! (.-Offset (.-From p)) 0))))


    (case [AMOVD]
      (when (== (.-Type (.-From p)) obj/TYPE_FCONST)
        (let [f64 (assert float64 (.-Val (.-From p)))]
          (when (== (math/Float64bits f64) 0)
            (set! (.-As p) AMOVV)
            (set! (.-Type (.-From p)) obj/TYPE_REG)
            (set! (.-Reg (.-From p)) REGZERO)
            (break))

          (set! (.-Type (.-From p)) obj/TYPE_MEM)
          (set! (.-Sym (.-From p)) (.Float64Sym ctxt f64))
          (set! (.-Name (.-From p)) obj/NAME_EXTERN)
          (set! (.-Offset (.-From p)) 0)))))




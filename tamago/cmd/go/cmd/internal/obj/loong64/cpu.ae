^{:go/end 249} (go/func init []
  ;; f assigns dwarfregisters[from:to] = (base):(to-from+base)
  (let [f ^{:go/end 242} (fn [^int16 from ^int16 to ^int16 base]
        (for [r from] (<= r to) (inc! r)
          (aset LOONG64DWARFRegisters r (+ (- r from) base))))]



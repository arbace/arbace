(go/var ^{:doc "https://llvm.org/svn/llvm-project/llvm/trunk/lib/Target/Mips/MipsRegisterInfo.td search for DwarfRegNum\nhttps://gcc.gnu.org/viewcvs/gcc/trunk/gcc/config/mips/mips.c?view=co&revision=258099&content-type=text%2Fplain search for mips_dwarf_regno\nFor now, this is adequate for both 32 and 64 bit.\n"} MIPSDWARFRegisters (lit (map int16 int16)))

^{:go/end 258} (go/func init []
  ;; f assigns dwarfregisters[from:to] = (base):(to-from+base)
  (let [f ^{:go/end 251} (fn [^int16 from ^int16 to ^int16 base]
        (for [r from] (<= r to) (inc! r)
          (aset MIPSDWARFRegisters r (+ (- r from) base))))]


    (f REG_R0 REG_R31 0)
    (f REG_F0 REG_F31 32) ; For 32-bit MIPS, compiler only uses even numbered registers --  see cmd/compile/internal/ssa/gen/MIPSOps.go
    (aset MIPSDWARFRegisters REG_HI 64)
    (aset MIPSDWARFRegisters REG_LO 65)
    ;; The lower bits of W registers are alias to F registers
    (f REG_W0 REG_W31 32)))



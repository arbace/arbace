(in-ns 'go.cmd.internal.obj.mips) (go/file "list0.go" :imports [


    ^{:line 33} [obj "cmd/internal/obj"]
    ^{:line 34} [fmt "fmt"]])


^{:go/end 40} (go/func init []
  (obj/RegisterRegister obj/RBaseMIPS (+ REG_LAST 1) rconv)
  (obj/RegisterOpcode obj/ABaseMIPS Anames))


^{:go/end 73} (go/func rconv ^string [^int r]
  (when (== r 0)
    (return "NONE"))

  (when (== r REGG)
    ;; Special case.
    (return "g"))

  (when (and (<= REG_R0 r) (<= r REG_R31))
    (return (fmt/Sprintf "R%d" (- r REG_R0))))

  (when (and (<= REG_F0 r) (<= r REG_F31))
    (return (fmt/Sprintf "F%d" (- r REG_F0))))

  (when (and (<= REG_M0 r) (<= r REG_M31))
    (return (fmt/Sprintf "M%d" (- r REG_M0))))

  (when (and (<= REG_FCR0 r) (<= r REG_FCR31))
    (return (fmt/Sprintf "FCR%d" (- r REG_FCR0))))

  (when (and (<= REG_W0 r) (<= r REG_W31))
    (return (fmt/Sprintf "W%d" (- r REG_W0))))

  (when (== r REG_HI)
    (return "HI"))

  (when (== r REG_LO)
    (return "LO"))


  (fmt/Sprintf "Rgok(%d)" (- r obj/RBaseMIPS)))


^{:go/end 83} (go/func DRconv ^string [^int a]
  (let [s "C_??"]
    (when (and (>= a C_NONE) (<= a C_NCLASS))
      (set! s (aget cnames0 a)))

    (let [^string fp (zero string)]
      (set! fp + s)
      ^{:line 82} fp)))

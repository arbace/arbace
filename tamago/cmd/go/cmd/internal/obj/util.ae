            (fmt/Fprintf w "%s%s" sep s)
            (set! sep ", "))))


      (when (!= (.-Type (.-To p)) TYPE_NONE)
        (io/WriteString w sep)
        (WriteDconv w p (addr (.-To p)))
        (set! sep ", "))

      (when (!= (.-RegTo2 p) REG_NONE)
        (fmt/Fprintf w "%s%v" sep (Rconv (conv int (.-RegTo2 p)))))

      (range [i (.-RestArgs p)]
        (when (== (.-Pos (aget (.-RestArgs p) i)) Destination)
          (io/WriteString w sep)
          (WriteDconv w p (addr (.-Addr (aget (.-RestArgs p) i))))
          (set! sep ", "))))))





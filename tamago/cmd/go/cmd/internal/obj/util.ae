    (io/WriteString w (.String (.-As p)))
    (io/WriteString w sc)
    (let [sep "\t"]

      (when (!= (.-Type (.-From p)) TYPE_NONE)
        (io/WriteString w sep)
        (WriteDconv w p (addr (.-From p)))
        (set! sep ", "))

      (when (!= (.-Reg p) REG_NONE)

^{:go/end 115} (go/func CConvARM "CConvARM formats ARM opcode suffix bits (mostly condition codes).\n" ^string [^uint8 s]
  ;; TODO: could be great to move suffix-related things into
  ;; ARM asm backends some day.
  ;; obj/x86 can be used as an example.

  (let [sc (aget armCondCode (bit-xor (bit-and s C_SCOND) C_SCOND_XOR))]
    (when (!= (bit-and s C_SBIT) 0)
      (set! sc + ".S"))

    (when (!= (bit-and s C_PBIT) 0)
      (set! sc + ".P"))

    (when (!= (bit-and s C_WBIT) 0)
      (set! sc + ".W"))

    (when (!= (bit-and s C_UBIT) 0) ; /* ambiguous with FBIT */
      (set! sc + ".U"))


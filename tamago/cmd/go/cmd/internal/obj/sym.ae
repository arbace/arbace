          (go/call fn s)))


      ^{:line 429} lists (lit (slice (slice (* LSym))) (.-Text ctxt) (.-Data ctxt))
      ^{:line 430} files (.FileTable (.-PosTable ctxt))]
    (range [_ list lists]
      (range [_ s list]
        (when (!= (bit-and flag traverseDefs) 0)
          (go/call fn s))

        (when (!= (bit-and flag traverseRefs) 0)
          (range [_ r (.-R s)]
            (fnNoNil (.-Sym r))))


        (when (!= (bit-and flag traverseAux) 0)
          (fnNoNil (.-Gotype s))
          (if (.IsText (.-Type s))

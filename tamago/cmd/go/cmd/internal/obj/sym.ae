                  (go/call fn aux))]

              (.traverseFuncAux ctxt flag s f files))
            (when [v (.VarInfo s)] (!= v nil)
              (fnNoNil (.-dwarfInfoSym v)))))


        (when (and (!= (bit-and flag traversePcdata) 0) (.IsText (.-Type s)))
          (let [fi (.-Pcln (.Func s))]
            (fnNoNil (.-Pcsp fi))
            (fnNoNil (.-Pcfile fi))
            (fnNoNil (.-Pcline fi))
            (fnNoNil (.-Pcinline fi))
            (range [_ d (.-Pcdata fi)]
              (fnNoNil d))))))))






^{:go/end 515} (go/method traverseFuncAux [^{:tag (* Link)} ctxt ^traverseFlag flag ^{:tag (* LSym)} fsym ^{:tag (func [^{:tag (* LSym)} parent ^{:tag (* LSym)} aux])} fn ^{:tag (slice string)} files]
  (let [fninfo (.Func fsym)

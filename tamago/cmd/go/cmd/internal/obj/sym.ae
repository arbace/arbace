        (panic "unknown ABI")))


    (let [(values c _) (.Load hash name)]
      (when (== c nil)
        (let [once (addr ^{:go/breaks [2]} (lit symOnce
                :sym (lit LSym :Name name)))]

          ^{:go/via [Attribute]} (.SetABI (.-sym once) abi)
          (set! (values c _) (.LoadOrStore hash name once))))

      (let [once (assert (* symOnce) c)]

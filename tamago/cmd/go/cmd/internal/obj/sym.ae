            (inc! ipkg)))))))





^{:go/breaks [[8 403]] :go/end 404} (go/func isNonPkgSym "Returns whether s is a non-package symbol, which needs to be referenced\nby name instead of by index.\n" ^bool [^{:tag (* Link)} ctxt ^{:tag (* LSym)} s]
  (when (and (.-IsAsm ctxt) (not ^{:go/via [Attribute]} (.Static s)))
    ;; asm symbols are referenced by name only, except static symbols
    ;; which are file-local and can be referenced by index.
    (return true))

  (when (.-Flag_linkshared ctxt)
    ;; The referenced symbol may be in a different shared library so
    ;; the linker cannot see its index.
    (return true))

  (when (== (.-Pkg s) "_")
    ;; The frontend uses package "_" to mark symbols that should not
    ;; be referenced by index, e.g. linkname'd symbols.
    (return true))

  (when ^{:go/via [Attribute]} (.DuplicateOK s)
    ;; Dupok symbol needs to be dedup'd by name.
    (return true))

  false)






^{:go/end 157} (go/method LookupInit "LookupInit looks up the symbol with name name.\nIf it does not exist, it creates it and\npasses it to init for one-time initialization.\n" ^{:tag (* LSym)} [^{:tag (* Link)} ctxt ^string name ^{:tag (func [^{:tag (* LSym)} s])} init]
  (let [(values c _) (.Load (.-hash ctxt) name)]
    (when (== c nil)
      (let [once (addr ^{:go/breaks [2]} (lit symOnce
              :sym (lit LSym :Name name)))]

        (set! (values c _) (.LoadOrStore (.-hash ctxt) name once))))

    (let [once (assert (* symOnce) c)]
      (when (and (!= init nil) (not (.Load (.-inited once))))
        ;; TODO(dmo): some of our init functions modify other fields
        ;; in the symbol table. They are only implicitly protected since
        ;; we serialize all inits under the hashmu lock.
        ;; Consider auditing the functions and have them lock their
        ;; concurrent access values explicitly. This would make it possible
        ;; to have more than one than one init going at a time (although this might
        ;; be a theoretical concern, I have yet to catch this lock actually being waited
        ;; on).
        (.Lock (.-hashmu ctxt))
        (when (not (.Load (.-inited once)))
          (init (addr (.-sym once)))
          (.Store (.-inited once) true))

        (.Unlock (.-hashmu ctxt)))

      (addr (.-sym once)))))



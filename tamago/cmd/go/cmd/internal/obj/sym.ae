          (.Lock (.-hashmu ctxt))
          (when (not (.Load (.-inited once)))
            (init (addr (.-sym once)))
            (.Store (.-inited once) true))

          (.Unlock (.-hashmu ctxt)))

        (addr (.-sym once))))))





            (when (!= idx (conv int32 (len (.-defs ctxt))))
              (panic "bad index"))

            (set! (.-defs ctxt) (append (.-defs ctxt) s))
            (inc! idx)))

        ^{:go/via [Attribute]} (.Set s AttrIndexed true)))


    (let [ipkg (conv int32 1) ; 0 is invalid index
        ^{:line 339} nonpkgdef nonpkgidx]
      (.traverseSyms ctxt (bit-or traverseRefs traverseAux) ^{:go/end 378} (fn [^{:tag (* LSym)} rs]
          (when (!= (.-PkgIdx rs) goobj/PkgIdxInvalid)
            (return))

          (when (not (.-Flag_linkshared ctxt))

                (panic "bad index"))

              (set! (.-hashed64defs ctxt) (append (.-hashed64defs ctxt) s))
              (inc! hashed64idx))
            (do
              (set! (.-PkgIdx s) goobj/PkgIdxHashed)
              (set! (.-SymIdx s) hashedidx)
              (when (!= hashedidx (conv int32 (len (.-hasheddefs ctxt))))
                (panic "bad index"))

              (set! (.-hasheddefs ctxt) (append (.-hasheddefs ctxt) s))
              (inc! hashedidx)))

          (isNonPkgSym ctxt s) (do
            (set! (.-PkgIdx s) goobj/PkgIdxNone)
            (set! (.-SymIdx s) nonpkgidx)
            (when (!= nonpkgidx (conv int32 (len (.-nonpkgdefs ctxt))))
              (panic "bad index"))

            (set! (.-nonpkgdefs ctxt) (append (.-nonpkgdefs ctxt) s))
            (inc! nonpkgidx)) :else
          (do
            (set! (.-PkgIdx s) goobj/PkgIdxSelf)

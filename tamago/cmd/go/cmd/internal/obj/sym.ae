^{:go/end 120} (go/method LookupABIInit "LookupABIInit looks up a symbol with the given ABI.\nIf it does not exist, it creates it and\npasses it to init for one-time initialization.\n" ^{:tag (* LSym)} [^{:tag (* Link)} ctxt ^string name ^ABI abi ^{:tag (func [^{:tag (* LSym)} s])} init]

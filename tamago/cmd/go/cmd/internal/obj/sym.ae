^{:go/end 379} (go/method NumberSyms "Assign index to symbols.\nasm is set to true if this is called by the assembler (i.e. not the compiler),\nin which case all the symbols are non-package (for now).\n" [^{:tag (* Link)} ctxt]
  (when (== (.-Pkgpath ctxt) "")
    (panic "NumberSyms called without package path"))


  (when (== (.-Headtype ctxt) objabi/Haix)
    ;; Data must be in a reliable order for reproducible builds.
    ;; The original entries are in a reliable order, but the TOC symbols
    ;; that are added in Progedit are added by different goroutines
    ;; that can be scheduled independently. We need to reorder those
    ;; symbols reliably. Sort by name but use a stable sort, so that
    ;; any original entries with the same name (all DWARFVAR symbols
    ;; have empty names but different relocation sets) are not shuffled.
    ;; TODO: Find a better place and optimize to only sort TOC symbols.
    (sort/SliceStable (.-Data ctxt) ^{:go/end 271} (fn ^bool [^int i ^int j]
        (< (.-Name (aget (.-Data ctxt) i)) (.-Name (aget (.-Data ctxt) j))))))



  ;; Constant symbols are created late in the concurrent phase. Sort them
  ;; to ensure a deterministic order.
  (sort/Slice (.-constSyms ctxt) ^{:go/end 278} (fn ^bool [^int i ^int j]
      (< (.-Name (aget (.-constSyms ctxt) i)) (.-Name (aget (.-constSyms ctxt) j)))))

  (set! (.-Data ctxt) (append (.-Data ctxt) (spread (.-constSyms ctxt))))
  (set! (.-constSyms ctxt) nil)

  ;; So are SEH symbols.
  (sort/Slice (.-SEHSyms ctxt) ^{:go/end 285} (fn ^bool [^int i ^int j]
      (< (.-Name (aget (.-SEHSyms ctxt) i)) (.-Name (aget (.-SEHSyms ctxt) j)))))

  (set! (.-Data ctxt) (append (.-Data ctxt) (spread (.-SEHSyms ctxt))))
  (set! (.-SEHSyms ctxt) nil)

  (set! (.-pkgIdx ctxt) (make (map string int32)))
  (set! (.-defs ctxt) (lit (slice (* LSym))))
  (set! (.-hashed64defs ctxt) (lit (slice (* LSym))))
  (set! (.-hasheddefs ctxt) (lit (slice (* LSym))))
  (set! (.-nonpkgdefs ctxt) (lit (slice (* LSym))))

  (let [(values ^int32 idx ^int32 hashedidx ^int32 hashed64idx ^int32 nonpkgidx) (zero int32)]
    (.traverseSyms ctxt (bit-or traverseDefs traversePcdata) ^{:go/end 336} (fn [^{:tag (* LSym)} s]
        (cond ^{:go/via [Attribute]} (.ContentAddressable s)
          (if (and (<= (.-Size s) 8) (== (len (.-R s)) 0) (== (contentHashSection s) 0)) (do
              ;; We can use short hash only for symbols without relocations.
              ;; Don't use short hash for symbols that belong in a particular section
              ;; or require special handling (such as type symbols).
              (set! (.-PkgIdx s) goobj/PkgIdxHashed64)
              (set! (.-SymIdx s) hashed64idx)

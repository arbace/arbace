              (when (!= nonpkgidx (+ nonpkgdef (conv int32 (len (.-nonpkgrefs ctxt)))))
                (panic "bad index"))

              (set! (.-nonpkgrefs ctxt) (append (.-nonpkgrefs ctxt) rs))
              (inc! nonpkgidx)

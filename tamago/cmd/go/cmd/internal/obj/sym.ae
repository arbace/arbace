^{:go/end 464} (go/method traverseSyms "Traverse symbols based on flag, call fn for each symbol.\n" [^{:tag (* Link)} ctxt ^traverseFlag flag ^{:tag (func [(* LSym)])} fn]
  (let [fnNoNil ^{:go/end 428} (fn [^{:tag (* LSym)} s]

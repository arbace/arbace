            ;; Don't do it when linking against shared libraries, as the runtime
            ;; may be in a different library.
            (when [i (goobj/BuiltinIdx (.-Name rs) (conv int ^{:go/via [Attribute]} (.ABI rs)))] (and (!= i -1) (not ^{:go/via [Attribute]} (.IsLinkname rs)))
              (set! (.-PkgIdx rs) goobj/PkgIdxBuiltin)
              (set! (.-SymIdx rs) (conv int32 i))

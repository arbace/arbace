    (return oldval))

  (when (!= (conv int64 (conv int32 (.-Offset (.-To p)))) (.-Offset (.-To p)))
    (.Diag ctxt "overflow in PCDATA instruction: %v" p)
    ((.-DiagFlush ctxt))
    (log/Fatalf "bad code"))


  (conv int32 (.-Offset (.-To p))))


^{:go/end 359} (go/func linkpcln [^{:tag (* Link)} ctxt ^{:tag (* LSym)} cursym]
  (let [pcln (addr (.-Pcln (.Func cursym)))]
    (set! (.-UsedFiles pcln) (make (map goobj/CUFileIndex (struct))))

    (let [npcdata 0
        ^{:line 267} nfuncdata 0]
      (for [p (.-Text (.Func cursym))] (!= p nil) (set! p (.-Link p))
        ;; Find the highest ID of any used PCDATA table. This ignores PCDATA table
        ;; that consist entirely of "-1", since that's the assumed default value.
        ;;   From.Offset is table ID
        ;;   To.Offset is data
        (when (and (== (.-As p) APCDATA) (>= (.-Offset (.-From p)) (conv int64 npcdata)) (!= (.-Offset (.-To p)) -1)) ; ignore -1 as we start at -1, if we only see -1, nothing changed
          (set! npcdata (conv int (+ (.-Offset (.-From p)) 1))))

        ;; Find the highest ID of any FUNCDATA table.
        ;;   From.Offset is table ID
        (when (and (== (.-As p) AFUNCDATA) (>= (.-Offset (.-From p)) (conv int64 nfuncdata)))
          (set! nfuncdata (conv int (+ (.-Offset (.-From p)) 1)))))



      (set! (.-Pcdata pcln) (make (slice (* LSym)) npcdata))
      (set! (.-Funcdata pcln) (make (slice (* LSym)) nfuncdata))

      (set! (.-Pcsp pcln) (funcpctab ctxt cursym "pctospadj" pctospadj nil))
      (set! (.-Pcfile pcln) (funcpctab ctxt cursym "pctofile" pctofileline pcln))
      (set! (.-Pcline pcln) (funcpctab ctxt cursym "pctoline" pctofileline nil))

      ;; Check that all the Progs used as inline markers are still reachable.
      ;; See issue #40473.
      (let [fn (.Func cursym)
          ^{:line 293} inlMarkProgs (make (map (* Prog) (struct)) (len (.-InlMarks fn)))]
        (range [_ inlMark (.-InlMarks fn)]
          (aset inlMarkProgs (.-p inlMark) (lit (struct))))

        (for [p (.-Text fn)] (!= p nil) (set! p (.-Link p))
          (delete inlMarkProgs p))

        (when (> (len inlMarkProgs) 0)
          (.Diag ctxt "one or more instructions used as inline markers are no longer reachable"))


        (let [pcinlineState (new pcinlineState)]
          (set! (.-Pcinline pcln) (funcpctab ctxt cursym "pctoinline" (.-pctoinline pcinlineState) nil))
          (range [_ inlMark (.-InlMarks fn)]
            (.setParentPC pcinlineState ctxt (conv int (.-id inlMark)) (conv int32 (.-Pc (.-p inlMark)))))

          (set! (.-InlTree pcln) (.-localTree pcinlineState))
          (when (and (== (.-Debugpcln ctxt) "pctoinline") (> (len (.-nodes (.-InlTree pcln))) 0))
            (.Logf ctxt "-- inlining tree for %s:\n" cursym)
            (dumpInlTree ctxt (.-InlTree pcln))
            (.Logf ctxt "--\n"))


          ;; tabulate which pc and func data we have.
          (let [havepc (make (slice uint32) (/ (+ npcdata 31) 32))
              ^{:line 318} havefunc (make (slice uint32) (/ (+ nfuncdata 31) 32))]
            (for [p (.-Text fn)] (!= p nil) (set! p (.-Link p))
              (when (== (.-As p) AFUNCDATA)
                (when (!= (bit-and (>> (aget havefunc (/ (.-Offset (.-From p)) 32)) (conv uint64 (% (.-Offset (.-From p)) 32))) 1) 0)
                  (.Diag ctxt "multiple definitions for FUNCDATA $%d" (.-Offset (.-From p))))

                (set! (aget havefunc (/ (.-Offset (.-From p)) 32)) bit-or ^uint32 (<< 1 (conv uint64 (% (.-Offset (.-From p)) 32)))))


              (when (and (== (.-As p) APCDATA) (!= (.-Offset (.-To p)) -1))
                (set! (aget havepc (/ (.-Offset (.-From p)) 32)) bit-or ^uint32 (<< 1 (conv uint64 (% (.-Offset (.-From p)) 32))))))



            ;; pcdata.
            (for [i 0] (< i npcdata) (inc! i)
              (if (== (bit-and (>> (aget havepc (/ i 32)) (conv uint (% i 32))) 1) 0)
                ;; use an empty symbol.
                (aset (.-Pcdata pcln) i (addr ^{:go/breaks [2 4 6]} (lit LSym
                      :Type objabi/SRODATA
                      :Attribute (bit-or AttrContentAddressable AttrPcdata)
                      :Align 1)))


                (aset (.-Pcdata pcln) i (funcpctab ctxt cursym "pctopcdata" pctopcdata (conv any (conv uint32 i))))))



            ;; funcdata
            (when (> nfuncdata 0)
              (for [p (.-Text fn)] (!= p nil) (set! p (.-Link p))

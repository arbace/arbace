                  (continue))

                (let [i (conv int (.-Offset (.-From p)))]
                  (when (or (!= (.-Type (.-To p)) TYPE_MEM) (!= (.-Offset (.-To p)) 0))
                    (panic (fmt/Sprintf "bad funcdata: %v" p)))

                  (aset (.-Funcdata pcln) i (.-Sym (.-To p))))))))))))





(go/type PCIter "PCIter iterates over encoded pcdata tables.\n" (struct
    ^{:line 363 :tag (slice byte)} p
    ^{:line 364 :tag uint32} PC
    ^{:line 365 :tag uint32} NextPC
    ^{:line 366 :tag uint32} PCScale
    ^{:line 367 :tag int32} Value
    ^{:line 368 :tag bool} start
    ^{:line 369 :tag bool} Done))



^{:go/end 377} (go/func NewPCIter "NewPCIter creates a PCIter with a scale factor for the PC step size.\n" ^{:tag (* PCIter)} [^uint32 pcScale]
  (let [it (new PCIter)]
    (set! (.-PCScale it) pcScale)
    ^{:line 376} it))



^{:go/end 413} (go/method Next "Next advances it to the Next pc.\n" [^{:tag (* PCIter)} it]
  (set! (.-PC it) (.-NextPC it))
  (when (.-Done it)
    (return))

  (when (== (len (.-p it)) 0)
    (set! (.-Done it) true)
    (return))


  ;; Value delta
  (let [(values val n) (binary/Varint (.-p it))]
    (when (<= n 0)
      (log/Fatalf "bad Value varint in pciterNext: read %v" n))

    (set! (.-p it) (subslice (.-p it) n))

    (when (and (== val 0) (not (.-start it)))
      (set! (.-Done it) true)
      (return))


    (set! (.-start it) false)
    (set! (.-Value it) + (conv int32 val))

    ;; pc delta
    (let [(values pc ^:assign n) (binary/Uvarint (.-p it))]
      (when (<= n 0)
        (log/Fatalf "bad pc varint in pciterNext: read %v" n))

      (set! (.-p it) (subslice (.-p it) n))

      (set! (.-NextPC it) (+ (.-PC it) (* (conv uint32 pc) (.-PCScale it)))))))




^{:go/end 425} (go/method Init "init prepares it to iterate over p,\nand advances it to the first pc.\n" [^{:tag (* PCIter)} it ^{:tag (slice byte)} p]
  (set! (.-p it) p)
  (set! (.-PC it) 0)
  (set! (.-NextPC it) 0)
  (set! (.-Value it) -1)
  (set! (.-start it) true)
  (set! (.-Done it) false)
  (.Next it))

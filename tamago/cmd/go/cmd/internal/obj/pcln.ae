^{:go/end 153} (go/func pctofileline "pctofileline computes either the file number (arg == 0)\nor the line number (arg == 1) to use at p.\nBecause p.Pos applies to p, phase == 0 (before p)\ntakes care of the update.\n" ^int32 [^{:tag (* Link)} ctxt ^{:tag (* LSym)} sym ^int32 oldval ^{:tag (* Prog)} p ^int32 phase ^any arg]
  (when (or (== (.-As p) ATEXT) (== (.-As p) ANOP) (== ^{:go/via [lico]} (.Line (.-Pos p)) 0) (== phase 1))
    (return oldval))

  (let [(values f l) (.getFileIndexAndLine ctxt (.-Pos p))]
    (when (== arg nil)
      (return l))

    (let [pcln (assert (* Pcln) arg)]
      (aset (.-UsedFiles pcln) (conv goobj/CUFileIndex f) (lit (struct)))
      (conv int32 f))))




(go/type pcinlineState "pcinlineState holds the state used to create a function's inlining\ntree and the PC-value table that maps PCs to nodes in that tree.\n" (struct
    ^{:line 158 :tag (map int int)} globalToLocal
    ^{:line 159 :tag InlTree} localTree))




^{:go/end 184} (go/method addBranch "addBranch adds a branch from the global inlining tree in ctxt to\nthe function's local inlining tree, returning the index in the local tree.\n" ^int [^{:tag (* pcinlineState)} s ^{:tag (* Link)} ctxt ^int globalIndex]
  (when (< globalIndex 0)
    (return -1))


  (let [(values localIndex ok) (aget (.-globalToLocal s) globalIndex)]
    (when ok
      (return localIndex))


    ;; Since tracebacks don't include column information, we could
    ;; use one node for multiple calls of the same function on the
    ;; same line (e.g., f(x) + f(y)). For now, we use one node for
    ;; each inlined call.
    (let [call (aget (.-nodes (.-InlTree ctxt)) globalIndex)]
      (set! (.-Parent call) (.addBranch s ctxt (.-Parent call)))
      (set! localIndex (len (.-nodes (.-localTree s))))
      (set! (.-nodes (.-localTree s)) (append (.-nodes (.-localTree s)) call))
      (aset (.-globalToLocal s) globalIndex localIndex)
      ^{:line 183} localIndex)))


^{:go/end 197} (go/method setParentPC [^{:tag (* pcinlineState)} s ^{:tag (* Link)} ctxt ^int globalIndex ^int32 pc]
  (let [(values localIndex ok) (aget (.-globalToLocal s) globalIndex)]
    (when (not ok)
      ;; We know where to unwind to when we need to unwind a body identified
      ;; by globalIndex. But there may be no instructions generated by that
      ;; body (it's empty, or its instructions were CSEd with other things, etc.).
      ;; In that case, we don't need an unwind entry.
      ;; TODO: is this really right? Seems to happen a whole lot...
      (return))

    (.setParentPC (.-localTree s) localIndex pc)))





^{:go/end 222} (go/method pctoinline "pctoinline computes the index into the local inlining tree to use at p.\nIf p is not the result of inlining, pctoinline returns -1. Because p.Pos\napplies to p, phase == 0 (before p) takes care of the update.\n" ^int32 [^{:tag (* pcinlineState)} s ^{:tag (* Link)} ctxt ^{:tag (* LSym)} sym ^int32 oldval ^{:tag (* Prog)} p ^int32 phase ^any arg]
  (when (== phase 1)
    (return oldval))


  (let [posBase (.Base (.Pos (.-PosTable ctxt) (.-Pos p)))]
    (when (== posBase nil)
      (return -1))


    (let [globalIndex (.InliningIndex posBase)]
      (when (< globalIndex 0)
        (return -1))


      (when (== (.-globalToLocal s) nil)
        (set! (.-globalToLocal s) (make (map int int))))


      (conv int32 (.addBranch s ctxt globalIndex)))))






^{:go/end 242} (go/func pctospadj "pctospadj computes the sp adjustment in effect.\nIt is oldval plus any adjustment made by p itself.\nThe adjustment by p takes effect only after p, so we\napply the change during phase == 1.\n" ^int32 [^{:tag (* Link)} ctxt ^{:tag (* LSym)} sym ^int32 oldval ^{:tag (* Prog)} p ^int32 phase ^any arg]
  (when (== oldval -1) ; starting
    (set! oldval 0))

  (when (== phase 0)
    (return oldval))

  (when (or (< (+ oldval (.-Spadj p)) -10000) (> (+ oldval (.-Spadj p)) 1100000000))
    (.Diag ctxt "overflow in spadj: %d + %d = %d" oldval (.-Spadj p) (+ oldval (.-Spadj p)))
    ((.-DiagFlush ctxt))
    (log/Fatalf "bad code"))


  (+ oldval (.-Spadj p)))







^{:go/end 260} (go/func pctopcdata "pctopcdata computes the pcdata value in effect at p.\nA PCDATA instruction sets the value in effect at future\nnon-PCDATA instructions.\nSince PCDATA instructions have no width in the final code,\nit does not matter which phase we use for the update.\n" ^int32 [^{:tag (* Link)} ctxt ^{:tag (* LSym)} sym ^int32 oldval ^{:tag (* Prog)} p ^int32 phase ^any arg]

^{:go/end 136} (go/func funcpctab "funcpctab writes to dst a pc-value table mapping the code in func to the values\nreturned by valfunc parameterized by arg. The invocation of valfunc to update the\ncurrent value is, for each p,\n\n\tsym = valfunc(func, p, 0, arg);\n\trecord sym.P as value at p->pc;\n\tsym = valfunc(func, p, 1, arg);\n\nwhere func is the function, val is the current value, p is the instruction being\nconsidered, and arg can be used to further parameterize valfunc.\n" ^{:tag (* LSym)} [^{:tag (* Link)} ctxt ^{:tag (* LSym)} func_ ^string desc ^{:tag (func [(* Link) (* LSym) int32 (* Prog) int32 any] [int32])} valfunc ^any arg]
  (let [dbg (== desc (.-Debugpcln ctxt))
      ^{:line 27} dst (lit (slice byte))
      ^{:line 28} sym (addr ^{:go/breaks [2 4 6]} (lit LSym
          :Type objabi/SRODATA
          :Attribute (bit-or AttrContentAddressable AttrPcdata)
          :Align 1))]


    (when dbg
      (.Logf ctxt "funcpctab %s [valfunc=%s]\n" (.-Name func_) desc))


    (let [val (conv int32 -1)
        ^{:line 39} oldval val
        ^{:line 40} fn (.Func func_)]
      (when (== (.-Text fn) nil)
        ;; Return the empty symbol we've built so far.
        (return sym))


      (let [pc (.-Pc (.-Text fn))]

        (when dbg
          (.Logf ctxt "%6x %6d %v\n" (conv uint64 pc) val (.-Text fn)))


        (let [buf (make (slice byte) binary/MaxVarintLen32)
            ^{:line 53} started false]
          (for [p (.-Text fn)] (!= p nil) (set! p (.-Link p))
            ;; Update val. If it's not changing, keep going.
            (set! val (valfunc ctxt func_ val p 0 arg))

            (when (and (== val oldval) started)
              (set! val (valfunc ctxt func_ val p 1 arg))
              (when dbg
                (.Logf ctxt "%6x %6s %v\n" (conv uint64 (.-Pc p)) "" p))

              (continue))


            ;; If the pc of the next instruction is the same as the
            ;; pc of this instruction, this instruction is not a real
            ;; instruction. Keep going, so that we only emit a delta
            ;; for a true instruction boundary in the program.
            (when (and (!= (.-Link p) nil) (== (.-Pc (.-Link p)) (.-Pc p)))
              (set! val (valfunc ctxt func_ val p 1 arg))
              (when dbg
                (.Logf ctxt "%6x %6s %v\n" (conv uint64 (.-Pc p)) "" p))

              (continue))


            ;; The table is a sequence of (value, pc) pairs, where each
            ;; pair states that the given value is in effect from the current position
            ;; up to the given pc, which becomes the new current position.
            ;; To generate the table as we scan over the program instructions,
            ;; we emit a "(value" when pc == func->value, and then
            ;; each time we observe a change in value we emit ", pc) (value".
            ;; When the scan is over, we emit the closing ", pc)".
            ;;
            ;; The table is delta-encoded. The value deltas are signed and
            ;; transmitted in zig-zag form, where a complement bit is placed in bit 0,
            ;; and the pc deltas are unsigned. Both kinds of deltas are sent
            ;; as variable-length little-endian base-128 integers,
            ;; where the 0x80 bit indicates that the integer continues.

            (when dbg
              (.Logf ctxt "%6x %6d %v\n" (conv uint64 (.-Pc p)) val p))


            (when started
              (let [pcdelta (/ (- (.-Pc p) pc) (conv int64 ^{:go/via [Arch]} (.-MinLC (.-Arch ctxt))))
                  ^{:line 98} n (binary/PutUvarint buf (conv uint64 pcdelta))]
                (set! dst (append dst (spread (subslice buf _ n))))
                (set! pc (.-Pc p))))


            (let [delta (- val oldval)
                ^{:line 104} n (binary/PutVarint buf (conv int64 delta))]
              (set! dst (append dst (spread (subslice buf _ n))))
              (set! oldval val)
              (set! started true)
              (set! val (valfunc ctxt func_ val p 1 arg))))


          (when started
            (when dbg
              (.Logf ctxt "%6x done\n" (conv uint64 (+ (.-Pc (.-Text fn)) (.-Size func_)))))

            (let [v (/ (- (.-Size func_) pc) (conv int64 ^{:go/via [Arch]} (.-MinLC (.-Arch ctxt))))]
              (when (< v 0)
                (.Diag ctxt "negative pc offset: %v" v))

              (let [n (binary/PutUvarint buf (conv uint64 v))]
                (set! dst (append dst (spread (subslice buf _ n))))
                ;; add terminating varint-encoded 0, which is just 0

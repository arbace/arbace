;; Package quoted provides string manipulation utilities.
(in-ns 'go.cmd.internal.quoted) (go/file "quoted.go" :doc "Package quoted provides string manipulation utilities.\n" :imports [


    ^{:line 9} [flag "flag"]
    ^{:line 10} [fmt "fmt"]
    ^{:line 11} [strings "strings"]
    ^{:line 12} [unicode "unicode"]])


^{:go/end 17} (go/func isSpaceByte ^bool [^byte c]
  (or (== c \space) (== c \tab) (== c \newline) (== c \return)))








^{:go/end 59} (go/func Split "Split splits s into a list of fields,\nallowing single or double quotes around elements.\nThere is no unescaping or other processing within\nquoted fields.\n\nKeep in sync with cmd/dist/quoted.go\n" [^string s] :results [(slice string) error]
  ;; Split fields allowing '' or "" around elements.
  ;; Quotes further inside the string do not count.
  (let [^{:tag (slice string)} f (zero (slice string))]
    (while (> (len s) 0)
      (while (and (> (len s) 0) (isSpaceByte (aget s 0)))
        (set! s (subslice s 1)))

      (when (== (len s) 0)
        (break))

      ;; Accepted quoted string. No unescaping inside.
      (when (or (== (aget s 0) \") (== (aget s 0) \'))
        (let [quote (aget s 0)]
          (set! s (subslice s 1))
          (let [i 0]
            (while (and (< i (len s)) (!= (aget s i) quote))
              (inc! i))

            (when (>= i (len s))
              (return nil (fmt/Errorf "unterminated %c string" quote)))

            (set! f (append f (subslice s _ i)))
            (set! s (subslice s (+ i 1)))
            (continue))))

      (let [i 0]
        (while (and (< i (len s)) (not (isSpaceByte (aget s i))))
          (inc! i))

        (set! f (append f (subslice s _ i)))
        (set! s (subslice s i))))

    (return f nil)))






^{:go/end 103} (go/func Join "Join joins a list of arguments into a string that can be parsed\nwith Split. Arguments are quoted only if necessary; arguments\nwithout spaces or quotes are kept as-is. No argument may contain both\nsingle and double quotes.\n" [^{:tag (slice string)} args] :results [string error]
  (let [^{:tag (slice byte)} buf (zero (slice byte))]
    (range [i arg args]
      (when (> i 0)
        (set! buf (append buf \space)))

      (let [(values ^bool sawSpace ^bool sawSingleQuote ^bool sawDoubleQuote) (zero bool)]
        (range [_ c arg]
          (switch
            (case [(> c unicode/MaxASCII)]
              (continue))
            (case [(isSpaceByte (conv byte c))]
              (set! sawSpace true))
            (case [(== c \')]
              (set! sawSingleQuote true))
            (case [(== c \")]
              (set! sawDoubleQuote true))))


        (switch
          (case [(and (not sawSpace) (not sawSingleQuote) (not sawDoubleQuote))]
            (set! buf (append buf (spread arg))))

          (case [(not sawSingleQuote)]
            (set! buf (append buf \'))
            (set! buf (append buf (spread arg)))
            (set! buf (append buf \')))

          (case [(not sawDoubleQuote)]
            (set! buf (append buf \"))
            (set! buf (append buf (spread arg)))
            (set! buf (append buf \")))

          (default
            (return "" (fmt/Errorf "argument %q contains both single and double quotes and cannot be quoted" arg))))))


    (return (conv string buf) nil)))




(go/type Flag "A Flag parses a list of string arguments encoded with Join.\nIt is useful for flags like cmd/link's -extldflags.\n" (slice string))

(go/var ^flag/Value _ (conv (* Flag) nil))

^{:go/end 118} (go/method Set ^error [^{:tag (* Flag)} f ^string v]
  ^{:go/breaks [4]} (let [(values fs err) (Split v)]
    (when (!= err nil)
      (return err))

    (set! @f (subslice fs _ (len fs) (len fs)))
    nil))


^{:go/end 129} (go/method String ^string [^{:tag (* Flag)} f]
  (when (== f nil)
    (return ""))

  (let [(values s err) (Join @f)]
    (when (!= err nil)
      (return (strings/Join @f " ")))

    ^{:line 128} s))

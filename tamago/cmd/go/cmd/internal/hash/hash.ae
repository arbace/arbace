;; Package hash implements hash functions used in the compiler toolchain.
(in-ns 'go.cmd.internal.hash) (go/file "hash.go" :doc "Package hash implements hash functions used in the compiler toolchain.\n" :imports [


    ^{:line 9} [sha256 "crypto/sha256"]
    ^{:line 10} [hash "hash"]])



(go/const ^{:val 32 :doc "Size32 is the size of the 32-byte hash functions [New32] and [Sum32].\n"} Size32 32)



^{:go/end 22} (go/func New32 "New32 returns a new [hash.Hash] computing the 32-byte hash checksum.\nNote that New32 and [Sum32] compute different hashes.\n" ^hash/Hash []
  (let [h (sha256/New)]
    (set! (values _ _) (.Write h (lit (slice byte) 1))) ; make this hash different from sha256
    ^{:line 21} h))




^{:go/end 30} (go/func Sum32 "Sum32 returns a 32-byte checksum of the data.\nNote that Sum32 and [New32] compute different hashes.\n" ^{:tag (array 32 byte)} [^{:tag (slice byte)} data]
  (let [sum (sha256/Sum256 data)]
    (set! (aget sum 0) bit-xor 0xff) ; make this hash different from sha256
    ^{:line 29} sum))

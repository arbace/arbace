(in-ns 'go.cmd.internal.objabi) (go/file "head.go" :imports [

    ^{:line 33} [fmt "fmt"]])


(go/type HeadType "HeadType is the executable header type.\n" uint8)

(go/const
  ^{:line 39} [^{:tag HeadType :val 0} Hunknown iota]
  ^{:line 40} [^{:val 1} Hdarwin]
  ^{:line 41} [^{:val 2} Hdragonfly]
  ^{:line 42} [^{:val 3} Hfreebsd]
  ^{:line 43} [^{:val 4} Hjs]
  ^{:line 44} [^{:val 5} Hlinux]
  ^{:line 45} [^{:val 6} Hnetbsd]
  ^{:line 46} [^{:val 7} Hopenbsd]
  ^{:line 47} [^{:val 8} Hplan9]
  ^{:line 48} [^{:val 9} Hsolaris]
  ^{:line 49} [^{:val 10} Hwasip1]
  ^{:line 50} [^{:val 11} Hwindows]
  ^{:line 51} [^{:val 12} Haix]
  ^{:line 52} [^{:val 13} Htamago])


^{:go/breaks [[4 86]] :go/end 87} (go/method Set ^error [^{:tag (* HeadType)} h ^string s]
  (switch s
    (case ["aix"]
      (set! @h Haix))
    (case ["darwin" "ios"]
      (set! @h Hdarwin))
    (case ["dragonfly"]
      (set! @h Hdragonfly))
    (case ["freebsd"]
      (set! @h Hfreebsd))
    (case ["js"]
      (set! @h Hjs))
    (case ["linux" "android"]
      (set! @h Hlinux))
    (case ["netbsd"]
      (set! @h Hnetbsd))
    (case ["openbsd"]
      (set! @h Hopenbsd))
    (case ["plan9"]
      (set! @h Hplan9))
    (case ["illumos" "solaris"]
      (set! @h Hsolaris))
    (case ["tamago"]
      (set! @h Htamago))
    (case ["wasip1"]
      (set! @h Hwasip1))
    (case ["windows"]
      (set! @h Hwindows))
    (default
      (return (fmt/Errorf "invalid headtype: %q" s))))

  nil)


^{:go/end 119} (go/method String ^string [^HeadType h]
  (switch h
    (case [Haix]
      (return "aix"))
    (case [Hdarwin]
      (return "darwin"))
    (case [Hdragonfly]
      (return "dragonfly"))
    (case [Hfreebsd]
      (return "freebsd"))
    (case [Hjs]
      (return "js"))
    (case [Hlinux]
      (return "linux"))
    (case [Hnetbsd]
      (return "netbsd"))
    (case [Hopenbsd]
      (return "openbsd"))
    (case [Hplan9]
      (return "plan9"))
    (case [Hsolaris]
      (return "solaris"))
    (case [Htamago]
      (return "tamago"))
    (case [Hwasip1]
      (return "wasip1"))
    (case [Hwindows]
      (return "windows")))

  (fmt/Sprintf "HeadType(%d)" h))

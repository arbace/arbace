^{:go/end 25} (go/func WorkingDir "WorkingDir returns the current working directory\n(or \"/???\" if the directory cannot be identified),\nwith \"/\" as separator.\n" ^string []
  (let [^string path (zero string)]
    (set! (values path _) (os/Getwd))
    (when (== path "")
      (set! path "/???"))

    (filepath/ToSlash path)))











^{:go/end 58} (go/func AbsFile "AbsFile returns the absolute filename for file in the given directory,\nas rewritten by the rewrites argument.\nFor unrewritten paths, AbsFile rewrites a leading $GOROOT prefix to the literal \"$GOROOT\".\nIf the resulting path is the empty string, the result is \"??\".\n\nThe rewrites argument is a ;-separated list of rewrites.\nEach rewrite is of the form \"prefix\" or \"prefix=>replace\",\nwhere prefix must match a leading sequence of path elements\nand is either removed entirely or replaced by the replacement.\n" ^string [^string dir ^string file ^string rewrites]
  (let [abs file]
    (when (and (!= dir "") (not (filepath/IsAbs file)))
      (set! abs (filepath/Join dir file)))


    (let [(values ^:assign abs rewritten) (ApplyRewrites abs rewrites)]
      (when (and (not rewritten) (!= buildcfg/GOROOT "") (hasPathPrefix abs buildcfg/GOROOT))
        (set! abs (+ "$GOROOT" (subslice abs (len buildcfg/GOROOT)))))


      ;; Rewrite paths to match the slash convention of the target.
      ;; This helps ensure that cross-compiled distributions remain
      ;; bit-for-bit identical to natively compiled distributions.
      (when (== runtime/GOOS "windows")
        (set! abs (strings/ReplaceAll abs "\\" "/")))


      (when (== abs "")
        (set! abs "??"))

      ^{:line 57} abs)))









^{:go/end 79} (go/func ApplyRewrites "ApplyRewrites returns the filename for file in the given directory,\nas rewritten by the rewrites argument.\n\nThe rewrites argument is a ;-separated list of rewrites.\nEach rewrite is of the form \"prefix\" or \"prefix=>replace\",\nwhere prefix must match a leading sequence of path elements\nand is either removed entirely or replaced by the replacement.\n" [^string file ^string rewrites] :results [string bool]
  (let [start 0]
    (for [i 0] (<= i (len rewrites)) (inc! i)
      (when (or (== i (len rewrites)) (== (aget rewrites i) \;))
        (when [(values new ok) (applyRewrite file (subslice rewrites start i))] ok
          (return new true))

        (set! start (+ i 1))))



    (return file false)))





^{:go/end 100} (go/func applyRewrite "applyRewrite applies the rewrite to the path,\nreturning the rewritten path and a boolean\nindicating whether the rewrite applied at all.\n" [^string path ^string rewrite] :results [string bool]
  (let [(values prefix replace) (values rewrite "")]
    (when [j (strings/LastIndex rewrite "=>")] (>= j 0)
      (set! (values prefix replace) (values (subslice rewrite _ j) (subslice rewrite (+ j (len "=>"))))))


    (when (or (== prefix "") (not (hasPathPrefix path prefix)))
      (return path false))

    (when (== (len path) (len prefix))
      (return replace true))

    (when (== replace "")
      (return (subslice path (+ (len prefix) 1)) true))

    (return (+ replace (subslice path (len prefix))) true)))









^{:go/end 134} (go/func hasPathPrefix "Does s have t as a path prefix?\nThat is, does s == t or does s begin with t followed by a slash?\nFor portability, we allow ASCII case folding, so that hasPathPrefix(\"a/b/c\", \"A/B\") is true.\nSimilarly, we allow slash folding, so that hasPathPrefix(\"a/b/c\", \"a\\\\b\") is true.\nWe do not allow full Unicode case folding, for fear of causing more confusion\nor harm than good. (For an example of the kinds of things that can go wrong,\nsee http://article.gmane.org/gmane.linux.kernel/1853266.)\n" ^bool [^string s ^string t]
  (when (> (len t) (len s))
    (return false))

  (let [^int i (zero int)]
    (for [(set! i 0)] (< i (len t)) (inc! i)
      (let [cs (conv int (aget s i))
          ^{:line 116} ct (conv int (aget t i))]
        (when (and (<= \A cs) (<= cs \Z))
          (set! cs + (- \a \A)))

        (when (and (<= \A ct) (<= ct \Z))
          (set! ct + (- \a \A)))

        (when (== cs \\)
          (set! cs \/))

        (when (== ct \\)
          (set! ct \/))

        (when (!= cs ct)
          (return false))))


    (or (>= i (len s)) (== (aget s i) \/) (== (aget s i) \\))))

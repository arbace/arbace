^{:go/end 52} (go/func GetFuncID "Get the function ID for the named function in the named file.\nThe function should be package-qualified.\n" ^abi/FuncID [^string name ^bool isWrapper]
  (when isWrapper
    (return abi/FuncIDWrapper))

  (when (strings/HasPrefix name "runtime.")
    (when [(values id ok) (aget funcIDs (subslice name (len "runtime.")))] ok
      (return id)))



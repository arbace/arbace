(in-ns 'go.cmd.internal.objabi) (go/file "symkind.go" :imports [])


(go/type SymKind "A SymKind describes the kind of memory represented by a symbol.\n" uint8)






(go/directive "//go:generate stringer -type=SymKind")
(go/const "Defined SymKind values.\nThese are used to index into cmd/link/internal/sym/AbiSymKindToSymKind\n\nTODO(rsc): Give idiomatic Go names.\n"

  ^{:line 44} [^{:tag SymKind :val 0 :doc "An otherwise invalid zero value for the type\n"} Sxxx iota]

  ^{:line 46} [^{:val 1 :doc "Executable instructions\n"} STEXT]
  ^{:line 47} [^{:val 2} STEXTFIPS]

  ^{:line 49} [^{:val 3 :doc "Read only static data\n"} SRODATA]
  ^{:line 50} [^{:val 4} SRODATAFIPS]

  ^{:line 52} [^{:val 5 :doc "Static data that does not contain any pointers\n"} SNOPTRDATA]
  ^{:line 53} [^{:val 6} SNOPTRDATAFIPS]

  ^{:line 55} [^{:val 7 :doc "Static data\n"} SDATA]
  ^{:line 56} [^{:val 8} SDATAFIPS]

  ^{:line 58} [^{:val 9 :doc "Statically data that is initially all 0s\n"} SBSS]

  ^{:line 60} [^{:val 10 :doc "Statically data that is initially all 0s and does not contain pointers\n"} SNOPTRBSS]

  ^{:line 62} [^{:val 11 :doc "Thread-local data that is initially all 0s\n"} STLSBSS]

  ^{:line 64} [^{:val 12 :doc "Debugging data\n"} SDWARFCUINFO]
  ^{:line 65} [^{:val 13} SDWARFCONST]
  ^{:line 66} [^{:val 14} SDWARFFCN]
  ^{:line 67} [^{:val 15} SDWARFABSFCN]
  ^{:line 68} [^{:val 16} SDWARFTYPE]
  ^{:line 69} [^{:val 17} SDWARFVAR]
  ^{:line 70} [^{:val 18} SDWARFRANGE]
  ^{:line 71} [^{:val 19} SDWARFLOC]
  ^{:line 72} [^{:val 20} SDWARFLINES]
  ^{:line 73} [^{:val 21} SDWARFADDR]

  ^{:line 75} [^{:val 22 :doc "Coverage instrumentation counter for libfuzzer.\n"} SLIBFUZZER_8BIT_COUNTER]

  ^{:line 77} [^{:val 23 :doc "Coverage instrumentation counter, aux variable for cmd/cover\n"} SCOVERAGE_COUNTER]
  ^{:line 78} [^{:val 24} SCOVERAGE_AUXVAR]

  ^{:line 80} [^{:val 25} SSEHUNWINDINFO])
;; Update cmd/link/internal/sym/AbiSymKindToSymKind for new SymKind values.



^{:go/end 87} (go/method IsText "IsText reports whether t is one of the text kinds.\n" ^bool [^SymKind t]
  (or (== t STEXT) (== t STEXTFIPS)))




^{:go/end 93} (go/method IsDATA "IsDATA reports whether t is one of the DATA kinds (SDATA or SDATAFIPS,\nexcluding NOPTRDATA, RODATA, BSS, and so on).\n" ^bool [^SymKind t]
  (or (== t SDATA) (== t SDATAFIPS)))



^{:go/end 98} (go/method IsFIPS "IsFIPS reports whether t is one fo the FIPS kinds.\n" ^bool [^SymKind t]
  (or (== t STEXTFIPS) (== t SRODATAFIPS) (== t SNOPTRDATAFIPS) (== t SDATAFIPS)))

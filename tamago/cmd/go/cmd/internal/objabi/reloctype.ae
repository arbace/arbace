  ^{:line 158} [^{:val 38 :doc "R_ARM64_PCREL_LDST16 resolves a PC-relative addresses instruction sequence, usually an\nadrp followed by a LD16 or ST16 instruction.\n"} R_ARM64_PCREL_LDST16]



  ^{:line 162} [^{:val 39 :doc "R_ARM64_PCREL_LDST32 resolves a PC-relative addresses instruction sequence, usually an\nadrp followed by a LD32 or ST32 instruction.\n"} R_ARM64_PCREL_LDST32]



  ^{:line 166} [^{:val 40 :doc "R_ARM64_PCREL_LDST64 resolves a PC-relative addresses instruction sequence, usually an\nadrp followed by a LD64 or ST64 instruction.\n"} R_ARM64_PCREL_LDST64]


  ^{:line 169} [^{:val 41 :doc "R_ARM64_LDST8 sets a LD/ST immediate value to bits [11:0] of a local address.\n"} R_ARM64_LDST8]


  ^{:line 172} [^{:val 42 :doc "R_ARM64_LDST16 sets a LD/ST immediate value to bits [11:1] of a local address.\n"} R_ARM64_LDST16]



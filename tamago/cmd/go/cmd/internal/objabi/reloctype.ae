  ^{:line 119} [^{:val 31 :doc "R_DWARFSECREF resolves to the offset of the symbol from its section.\nTarget of relocation must be size 4 (in current implementation).\n"} R_DWARFSECREF]

  ;; Platform dependent relocations. Architectures with fixed width instructions
  ;; have the inherent issue that a 32-bit (or 64-bit!) displacement cannot be
  ;; stuffed into a 32-bit instruction, so an address needs to be spread across
  ;; several instructions, and in turn this requires a sequence of relocations, each
  ;; updating a part of an instruction. This leads to relocation codes that are
  ;; inherently processor specific.

  ;; Arm64.




  ^{:line 133} [^{:val 32 :doc "Set a MOV[NZ] immediate field to bits [15:0] of the offset from the thread\nlocal base to the thread local variable defined by the referenced (thread\nlocal) symbol. Error if the offset does not fit into 16 bits.\n"} R_ARM64_TLS_LE]




  ^{:line 138} [^{:val 33 :doc "Relocates an ADRP; LD64 instruction sequence to load the offset between\nthe thread local base and the thread local variable defined by the\nreferenced (thread local) symbol from the GOT.\n"} R_ARM64_TLS_IE]



  ^{:line 142} [^{:val 34 :doc "R_ARM64_GOTPCREL relocates an adrp, ld64 pair to compute the address of the GOT\nslot of the referenced symbol.\n"} R_ARM64_GOTPCREL]




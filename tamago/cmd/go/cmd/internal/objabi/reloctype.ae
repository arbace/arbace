^{:go/breaks [[5 462]] :go/end 463} (go/method IsDirectCall "IsDirectCall reports whether r is a relocation for a direct call.\nA direct call is a CALL instruction that takes the target address\nas an immediate. The address is embedded into the instruction(s), possibly\nwith limited width. An indirect call is a CALL instruction that takes\nthe target address in register or memory.\n" ^bool [^RelocType r]
  (switch r
    (case [R_CALL R_CALLARM R_CALLARM64 R_CALLLOONG64 R_CALLMIPS R_CALLPOWER
        ^{:line 459} R_RISCV_CALL R_RISCV_JAL R_RISCV_JAL_TRAMP]
      (return true)))

  false)







^{:go/breaks [[5 475]] :go/end 476} (go/method IsDirectJump "IsDirectJump reports whether r is a relocation for a direct jump.\nA direct jump is a JMP instruction that takes the target address\nas an immediate. The address is embedded into the instruction, possibly\nwith limited width. An indirect jump is a JMP instruction that takes\nthe target address in register or memory.\n" ^bool [^RelocType r]
  (switch r
    (case [R_JMPMIPS]
      (return true)))

  false)




^{:go/end 482} (go/method IsDirectCallOrJump "IsDirectCallOrJump reports whether r is a relocation for a direct\ncall or a direct jump.\n" ^bool [^RelocType r]
  (or (.IsDirectCall r) (.IsDirectJump r)))




^{:go/end 493} (go/method IsDwTxtAddr "IsDwTxtAddr reports whether r is one of the several DWARF\n.debug_addr section indirect relocations.\n" ^bool [^RelocType r]
  (switch r
    (case [R_DWTXTADDR_U1 R_DWTXTADDR_U2 R_DWTXTADDR_U3 R_DWTXTADDR_U4]
      (return true))
    (default
      (return false))))







^{:go/end 512} (go/func FuncCountToDwTxtAddrFlavor "FuncCountToDwTxtAddrFlavor returns the correct DWARF .debug_addr\nsection relocation to use when compiling a package with a total of\nfncount functions, along with the size of the ULEB128-encoded blob\nneeded to store the eventual .debug_addr index.\n" [^int fncount] :results [RelocType int]
  (switch
    (case [(<= fncount 127)]
      (return R_DWTXTADDR_U1 1))
    (case [(<= fncount 16383)]
      (return R_DWTXTADDR_U2 2))
    (case [(<= fncount 2097151)]
      (return R_DWTXTADDR_U3 3))
    (case [(<= fncount 268435455)]
      (return R_DWTXTADDR_U4 4))
    (default
      (panic "package has more than 268435455 functions"))))























^{:go/breaks [4] :go/end 536} (go/func DummyDwarfFunctionCountForAssembler "DummyDwarfFunctionCountForAssembler returns a dummy value to be\nused for \"total number of functions in the package\" for use in the\nassembler (compiler does not call this function).\n\nBackground/motivation: let's say we have a package P with some\nassembly functions (in \"a.s\") and some Go functions (in\n\"b.go\"). The compilation sequence used by the Go command will be:\n\n1. run the assembler on a.s to generate a \"symabis\" file\n2. run the compiler on b.go passing it the symabis file and generating a \"go_defs.h\" asm header\n3. run the assembler on a.s passing it an include dir with the generated \"go_defs.h\" file\n\nWhen the compiler runs, it can easily determine the total function\ncount for the package (for use with FuncCountToDwTxtAddrFlavor\nabove) by counting defined Go funcs and looking at the symabis\nfile. With the assembler however there is no easy way for it to\nfigure out the total number of Go source funcs. To keep things\nsimple, we instead just use a dummy total function count while\nrunning the assembler that will guarantee we pick a relocation\nflavor that will work for any package size.\n" ^int []
  9999999)





^{:go/end 554} (go/method DwTxtAddrRelocParams "DwTxtAddrRelocParams returns the maximum number of functions per\npackage supported for the DWARF .debug_addr relocation variant r,\nalong with the number of bytes it takes up in encoded form.\n" [^RelocType r] :results [int int]
  (switch r
    (case [R_DWTXTADDR_U1]
      (return 0x7f 1))
    (case [R_DWTXTADDR_U2]
      (return 0x3fff 2))
    (case [R_DWTXTADDR_U3]
      (return 0x1fffff 3))
    (case [R_DWTXTADDR_U4]
      (return 0xfffffff 4))
    (default
      (panic "not a dwtxtaddr relocation"))))

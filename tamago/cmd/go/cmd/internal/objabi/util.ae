(in-ns 'go.cmd.internal.objabi) (go/file "util.go" :imports [


    ^{:line 8} [fmt "fmt"]
    ^{:line 9} [strings "strings"]

    ^{:line 11} [buildcfg "internal/buildcfg"]])


(go/const
  ^{:line 15} [^{:val 256} ElfRelocOffset 256]
  ^{:line 16} [^{:val 2048} MachoRelocOffset 2048] ; reserve enough space for ELF relocations
  ^{:line 17} [^{:val ".dict"} GlobalDictPrefix ".dict"]) ; prefix for names of global dictionaries






^{:go/end 33} (go/func HeaderString "HeaderString returns the toolchain configuration string written in\nGo object headers. This string ensures we don't attempt to import\nor link object files that are incompatible with each other. This\nstring always starts with \"go object \".\n" ^string []
  (let [archExtra ""]
    (when [(values k v) (buildcfg/GOGOARCH)] (and (!= k "") (!= v ""))
      (set! archExtra (+ " " k "=" v)))

    (fmt/Sprintf "go object %s %s %s%s X:%s\n"
      ^{:line 30} buildcfg/GOOS buildcfg/GOARCH
      ^{:line 31} buildcfg/Version archExtra
      (strings/Join (.Enabled buildcfg/Experiment) ","))))

(in-ns 'go.cmd.internal.objabi) (go/file "path.go" :imports [


    ^{:line 8} [fmt "fmt"]
    ^{:line 9} [strconv "strconv"]
    ^{:line 10} [strings "strings"]])







^{:go/end 45} (go/func PathToPrefix "PathToPrefix converts raw string to the prefix that will be used in the\nsymbol table. All control characters, space, '%' and '\"', as well as\nnon-7-bit clean bytes turn into %xx. The period needs escaping only in the\nlast segment of the path, and it makes for happier users if we escape that as\nlittle as possible.\n" ^string [^string s]
  (let [slash (strings/LastIndex s "/")
      ;; check for chars that need escaping
      ^{:line 21} n 0]
    (for [r 0] (< r (len s)) (inc! r)
      (when [c (aget s r)] (or (<= c \space) ^:go/paren (and (== c \.) (> r slash)) (== c \%) (== c \") (>= c 0x7F))
        (inc! n)))



    ;; quick exit
    (when (== n 0)
      (return s))


    ;; escape
    (let [^:const ^{:val "0123456789abcdef"} hex "0123456789abcdef"
        ^{:line 35} p (make (slice byte) 0 (+ (len s) (* 2 n)))]
      (for [r 0] (< r (len s)) (inc! r)
        (if [c (aget s r)] (or (<= c \space) ^:go/paren (and (== c \.) (> r slash)) (== c \%) (== c \") (>= c 0x7F))
          (set! p (append p \% (aget hex (>> c 4)) (aget hex (bit-and c 0xF))))

          (set! p (append p c))))



      (conv string p))))




^{:go/end 78} (go/func PrefixToPath "PrefixToPath is the inverse of PathToPrefix, replacing escape sequences with\nthe original character.\n" [^string s] :results [string error]
  (let [percent (strings/IndexByte s \%)]
    (when (== percent -1)
      (return s nil))


    (let [p (make (slice byte) 0 (len s))]
      (for [i 0] (< i (len s)) _
        (when (!= (aget s i) \%)
          (set! p (append p (aget s i)))
          (inc! i)
          (continue))

        (when (>= (+ i 2) (len s))
          ;; Not enough characters remaining to be a valid escape
          ;; sequence.
          (return "" (fmt/Errorf "malformed prefix %q: escape sequence must contain two hex digits" s)))


        (let [(values b err) (strconv/ParseUint (subslice s (+ i 1) (+ i 3)) 16 8)]
          (when (!= err nil)
            ;; Not a valid escape sequence.
            (return "" (fmt/Errorf "malformed prefix %q: escape sequence %q must contain two hex digits" s (subslice s i (+ i 3)))))


          (set! p (append p (conv byte b)))
          (set! i + 3)))

      (return (conv string p) nil))))

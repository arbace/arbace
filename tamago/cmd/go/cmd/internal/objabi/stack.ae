(in-ns 'go.cmd.internal.objabi) (go/file "stack.go" :imports [


    ^{:line 8} [abi "internal/abi"]
    ^{:line 9} [buildcfg "internal/buildcfg"]])


^{:go/end 15} (go/func StackNosplit ^int [^bool race]
  ;; This arithmetic must match that in runtime/stack.go:stackNosplit.
  (* abi/StackNosplitBase (stackGuardMultiplier race)))





^{:go/end 32} (go/func stackGuardMultiplier "stackGuardMultiplier returns a multiplier to apply to the default\nstack guard size. Larger multipliers are used for non-optimized\nbuilds that have larger stack frames or for specific targets.\n" ^int [^bool race]
  ;; This arithmetic must match that in internal/runtime/sys/consts.go:StackGuardMultiplier.
  (let [n 1]
    ;; On AIX and OpenBSD, a larger stack is needed for syscalls.
    (when (or (== buildcfg/GOOS "aix") (== buildcfg/GOOS "openbsd"))
      (set! n + 1))

    ;; The race build also needs more stack.
    (when race
      (set! n + 1))

    ^{:line 31} n))

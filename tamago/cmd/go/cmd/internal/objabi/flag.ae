^{:go/end 75} (go/func expandArgs "expandArgs expands \"response files\" arguments in the provided slice.\n\nA \"response file\" argument starts with '@' and the rest of that\nargument is a filename with arguments. Arguments are separated by\nwhitespace, and can use single quotes (literal) or double quotes\n(with escape sequences). Each argument in the named files can also\ncontain response file arguments. See Issue 77177.\n\nThe returned slice 'out' aliases 'in' if the input did not contain\nany response file arguments.\n\nTODO: handle relative paths of recursive expansions in different directories?\nIs there a spec for this? Are relative paths allowed?\n" [^{:tag (slice string)} in] :results [^{:tag (slice string)} out]
  ;; out is nil until we see a "@" argument.
  (range [i s in]
    (cond (strings/HasPrefix s "@") (do
        (when (== out nil)
          (set! out (make (slice string) 0 (* (len in) 2)))
          (set! out (append out (spread (subslice in _ i)))))

        (let [(values slurp err) (os/ReadFile (subslice s 1))]
          (when (!= err nil)
            (log/Fatal err))

          (let [args (ParseArgs slurp)]
            (set! out (append out (spread (expandArgs args)))))))
      (!= out nil)
      (set! out (append out s))))


  (when (== out nil)
    (return in))

  (return))













^{:go/end 199} (go/func ParseArgs "ParseArgs parses response file content into arguments using GCC-compatible rules.\nArguments are separated by whitespace. Single quotes preserve content literally.\nDouble quotes allow escape sequences: \\\\, \\\", \\$, \\`, and backslash-newline\nfor line continuation (both LF and CRLF). Outside quotes, backslash escapes the\nnext character, backslash-newline is line continuation (both LF and CRLF).\nWe aim to follow GCC's buildargv implementation.\nSource code: https://github.com/gcc-mirror/gcc/blob/releases/gcc-15.2.0/libiberty/argv.c#L167\nKnown deviations from GCC:\n- CRLF is treated as line continuation to be Windows-friendly; GCC only recognizes LF.\n- Obsolete \\f and \\v are not treated as whitespaces\nThis function is public to test with cmd/go/internal/work.encodeArg\n" ^{:tag (slice string)} [^{:tag (slice byte)} s]
  (let [^{:tag (slice string)} args (zero (slice string))
      ^{:line 90 :tag strings/Builder} arg (zero strings/Builder)
      ^{:line 91} hasArg false ; tracks if we've started an argument (for empty quotes)
      ^{:line 92} inSingleQuote false
      ^{:line 93} inDoubleQuote false
      ^{:line 94} i 0]

    (while (< i (len s))
      (let [c (aget s i)]

        (when inSingleQuote
          (if (== c \')
            (set! inSingleQuote false)

            (.WriteByte arg c)) ; No escape processing in single quotes

          (inc! i)
          (continue))


        (when inDoubleQuote
          (cond (and (== c \\) (< (+ i 1) (len s)))
            (let [next (aget s (+ i 1))]
              (switch next
                (case [\\]
                  (.WriteByte arg \\)
                  (set! i + 2))
                (case [\"]
                  (.WriteByte arg \")
                  (set! i + 2))
                (case [\$]
                  (.WriteByte arg \$)
                  (set! i + 2))
                (case [\`]
                  (.WriteByte arg \`)
                  (set! i + 2))
                (case [\newline]
                  ;; Line continuation - skip backslash and newline
                  (set! i + 2))
                (case [\return]
                  ;; Line continuation for CRLF - skip backslash, CR, and LF
                  (if (and (< (+ i 2) (len s)) (== (aget s (+ i 2)) \newline))
                    (set! i + 3)
                    (do
                      (.WriteByte arg c)
                      (inc! i))))

                (default
                  ;; Unknown escape - keep backslash and char
                  (.WriteByte arg c)
                  (inc! i))))

            (== c \") (do
              (set! inDoubleQuote false)
              (inc! i)) :else
            (do
              (.WriteByte arg c)
              (inc! i)))

          (continue))


        ;; Normal mode (outside quotes)
        (switch c
          (case [\space \tab \newline \return]
            (when (or (> (.Len arg) 0) hasArg)
              (set! args (append args (.String arg)))
              (.Reset arg)
              (set! hasArg false)))

          (case [\']
            (set! inSingleQuote true)
            (set! hasArg true)) ; Empty quotes still produce an arg
          (case [\"]
            (set! inDoubleQuote true)
            (set! hasArg true)) ; Empty quotes still produce an arg
          (case [\\]
            ;; Backslash escapes the next character outside quotes.
            ;; Backslash-newline is line continuation (handles both LF and CRLF).
            (when (< (+ i 1) (len s))
              (let [next (aget s (+ i 1))]
                (when (== next \newline)
                  (set! i + 2)
                  (continue))

                (when (and (== next \return) (< (+ i 2) (len s)) (== (aget s (+ i 2)) \newline))
                  (set! i + 3)
                  (continue))

                ;; Backslash escapes the next character
                (.WriteByte arg next)
                (set! hasArg true)
                (set! i + 2)
                (continue)))

            ;; Trailing backslash at end of input — consumed and discarded
            (inc! i)
            (continue))
          (default
            (.WriteByte arg c)))

        (inc! i)))


    ;; Don't forget the last argument
    (when (or (> (.Len arg) 0) hasArg)
      (set! args (append args (.String arg))))


    ^{:line 198} args))



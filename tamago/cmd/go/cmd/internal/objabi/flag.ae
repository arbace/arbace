^{:go/breaks [[5 451]] :go/end 452} (go/method Set ^error [^{:tag (* DebugFlag)} f ^string debugstr]
  (when (== debugstr "")
    (return nil))

  (range [name (strings/SplitSeq debugstr ",")]
    (when (== name "")
      (continue))

    ;; display help about the debug option itself and quit
    (when (== name "help")
      (fmt/Print debugHelpHeader)
      (let [(values maxLen names) (values 0 (lit (slice string)))]
        (when (!= (.-debugSSA f) nil)

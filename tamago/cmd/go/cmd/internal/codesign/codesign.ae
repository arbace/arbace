;; Package codesign provides basic functionalities for
;; ad-hoc code signing of Mach-O files.
;;
;; This is not a general tool for code-signing. It is made
;; specifically for the Go toolchain. It uses the same
;; ad-hoc signing algorithm as the Darwin linker.
(in-ns 'go.cmd.internal.codesign) (go/file "codesign.go" :doc "Package codesign provides basic functionalities for\nad-hoc code signing of Mach-O files.\n\nThis is not a general tool for code-signing. It is made\nspecifically for the Go toolchain. It uses the same\nad-hoc signing algorithm as the Darwin linker.\n" :imports [


    ^{:line 14} [bytes "bytes"]
    ^{:line 15} [sha256 "crypto/sha256"]
    ^{:line 16} [macho "debug/macho"]
    ^{:line 17} [binary "encoding/binary"]
    ^{:line 18} [io "io"]

    ^{:line 20} [hash "cmd/internal/hash"]])


;; Code signature layout.
;;
;; The code signature is a block of bytes that contains
;; a SuperBlob, which contains one or more Blobs. For ad-hoc
;; signing, a single CodeDirectory Blob suffices.
;;
;; A SuperBlob starts with its header (the binary representation
;; of the SuperBlob struct), followed by a list of (in our case,
;; one) Blobs (offset and size). A CodeDirectory Blob starts
;; with its head (the binary representation of CodeDirectory struct),
;; followed by the identifier (as a C string) and the hashes, at
;; the corresponding offsets.
;;
;; The signature data must be included in the __LINKEDIT segment.
;; In the Mach-O file header, an LC_CODE_SIGNATURE load command
;; points to the data.

(go/const
  ^{:line 41} [^{:val 12} pageSizeBits 12]
  ^{:line 42} [^{:val 4096} pageSize (<< 1 pageSizeBits)])


(go/const ^{:val 29} LC_CODE_SIGNATURE 0x1d)

;; Constants and struct layouts are from
;; https://opensource.apple.com/source/xnu/xnu-4903.270.47/osfmk/kern/cs_blobs.h

(go/const
  ^{:line 51} [^{:val 4208856064} CSMAGIC_REQUIREMENT 0xfade0c00] ; single Requirement blob
  ^{:line 52} [^{:val 4208856065} CSMAGIC_REQUIREMENTS 0xfade0c01] ; Requirements vector (internal requirements)
  ^{:line 53} [^{:val 4208856066} CSMAGIC_CODEDIRECTORY 0xfade0c02] ; CodeDirectory blob
  ^{:line 54} [^{:val 4208856256} CSMAGIC_EMBEDDED_SIGNATURE 0xfade0cc0] ; embedded form of signature data
  ^{:line 55} [^{:val 4208856257} CSMAGIC_DETACHED_SIGNATURE 0xfade0cc1] ; multi-arch collection of embedded signatures

  ^{:line 57} [^{:val 0} CSSLOT_CODEDIRECTORY 0]) ; slot index for CodeDirectory


(go/const
  ^{:line 61} [^{:val 1} CS_HASHTYPE_SHA1 1]
  ^{:line 62} [^{:val 2} CS_HASHTYPE_SHA256 2]
  ^{:line 63} [^{:val 3} CS_HASHTYPE_SHA256_TRUNCATED 3]
  ^{:line 64} [^{:val 4} CS_HASHTYPE_SHA384 4])


(go/const
  ^{:line 68} [^{:val 1} CS_EXECSEG_MAIN_BINARY 0x1] ; executable segment denotes main binary
  ^{:line 69} [^{:val 16} CS_EXECSEG_ALLOW_UNSIGNED 0x10] ; allow unsigned pages (for debugging)
  ^{:line 70} [^{:val 32} CS_EXECSEG_DEBUGGER 0x20] ; main binary is debugger
  ^{:line 71} [^{:val 64} CS_EXECSEG_JIT 0x40] ; JIT enabled
  ^{:line 72} [^{:val 128} CS_EXECSEG_SKIP_LV 0x80] ; skip library validation
  ^{:line 73} [^{:val 256} CS_EXECSEG_CAN_LOAD_CDHASH 0x100] ; can bless cdhash for execution
  ^{:line 74} [^{:val 512} CS_EXECSEG_CAN_EXEC_CDHASH 0x200]) ; can execute blessed cdhash



  (set! out (put32be out (.-length c)))
  (set! out (put32be out (.-version c)))
  (set! out (put32be out (.-flags c)))
  (set! out (put32be out (.-hashOffset c)))
  (set! out (put32be out (.-identOffset c)))
  (set! out (put32be out (.-nSpecialSlots c)))
  (set! out (put32be out (.-nCodeSlots c)))
  (set! out (put32be out (.-codeLimit c)))
  (set! out (put8 out (.-hashSize c)))
  (set! out (put8 out (.-hashType c)))
  (set! out (put8 out (.-_pad1 c)))
  (set! out (put8 out (.-pageSize c)))
  (set! out (put32be out (.-_pad2 c)))
  (set! out (put32be out (.-scatterOffset c)))
  (set! out (put32be out (.-teamOffset c)))
  (set! out (put32be out (.-_pad3 c)))
  (set! out (put64be out (.-codeLimit64 c)))

    ^{:line 78 :tag uint32} typ ; type of entry
    ^{:line 79 :tag uint32} offset)) ; offset of entry
;; data follows


^{:go/end 87} (go/method put ^{:tag (slice byte)} [^{:tag (* Blob)} b ^{:tag (slice byte)} out]
  (set! out (put32be out (.-typ b)))
  (set! out (put32be out (.-offset b)))
  ^{:line 86} out)


(go/const ^{:val 8} blobSize (* 2 4))

(go/type SuperBlob (struct
    ^{:line 92 :tag uint32} magic ; magic number
    ^{:line 93 :tag uint32} length ; total length of SuperBlob

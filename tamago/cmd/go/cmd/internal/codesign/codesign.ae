  (set! out (put64be out (.-execSegFlags c)))
  ^{:line 154} out)


(go/const ^{:val 88} codeDirectorySize (+ (* 13 4) 4 (* 4 8)))


(go/type CodeSigCmd "CodeSigCmd is Mach-O LC_CODE_SIGNATURE load command.\n" (struct
    ^{:line 161 :tag uint32} Cmd ; LC_CODE_SIGNATURE
    ^{:line 162 :tag uint32} Cmdsize ; sizeof this command (16)
    ^{:line 163 :tag uint32} Dataoff ; file offset of data in __LINKEDIT segment
    ^{:line 164 :tag uint32} Datasize)) ; file size of data in __LINKEDIT segment


^{:go/end 182} (go/func FindCodeSigCmd [^{:tag (* macho/File)} f] :results [CodeSigCmd bool]
  (let [get32 (.-Uint32 (.-ByteOrder f))]
    (range [_ l (.-Loads f)]
      (let [data (.Raw l)
          ^{:line 171} cmd (get32 data)]
        (when (== cmd LC_CODE_SIGNATURE)
          ^{:go/breaks [2]} (return (lit CodeSigCmd
              ^{:line 174} cmd
              (get32 (subslice data 4))
              (get32 (subslice data 8))
              (get32 (subslice data 12)))
            true))))


    (return (lit CodeSigCmd) false)))


^{:go/end 184} (go/func put32be ^{:tag (slice byte)} [^{:tag (slice byte)} b ^uint32 x] (.PutUint32 binary/BigEndian b x) (subslice b 4))
^{:go/end 185} (go/func put64be ^{:tag (slice byte)} [^{:tag (slice byte)} b ^uint64 x] (.PutUint64 binary/BigEndian b x) (subslice b 8))
^{:go/end 186} (go/func put8 ^{:tag (slice byte)} [^{:tag (slice byte)} b ^uint8 x] (aset b 0 x) (subslice b 1))
^{:go/end 187} (go/func puts ^{:tag (slice byte)} [^{:tag (slice byte)} b ^{:tag (slice byte)} s] (let [n (copy b s)] (subslice b n)))




^{:go/end 198} (go/func Size "Size computes the size of the code signature.\nid is the identifier used for signing (a field in CodeDirectory blob, which\nhas no significance in ad-hoc signing).\n" ^int64 [^int64 codeSize ^string id]
  (let [nhashes (/ (- (+ codeSize pageSize) 1) pageSize)
      ^{:line 194} idOff (conv int64 codeDirectorySize)
      ^{:line 195} hashOff (+ idOff (conv int64 (+ (len id) 1)))

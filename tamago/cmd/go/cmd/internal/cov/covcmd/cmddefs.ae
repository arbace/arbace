(in-ns 'go.cmd.internal.cov.covcmd) (go/file "cmddefs.go" :imports [


    ^{:line 8} [sha256 "crypto/sha256"]
    ^{:line 9} [fmt "fmt"]
    ^{:line 10} [coverage "internal/coverage"]])







(go/type CoverPkgConfig "CoverPkgConfig is a bundle of information passed from the Go\ncommand to the cover command during \"go build -cover\" runs. The\nGo command creates and fills in a struct as below, then passes\nfile containing the encoded JSON for the struct to the \"cover\"\ntool when instrumenting the source files in a Go package.\n" (struct


    ^{:line 21 :tag string :doc "File into which cmd/cover should emit summary info\nwhen instrumentation is complete.\n"} OutConfig


    ^{:line 24 :tag string :doc "Import path for the package being instrumented.\n"} PkgPath


    ^{:line 27 :tag string :doc "Package name.\n"} PkgName


    ^{:line 30 :tag string :doc "Instrumentation granularity: one of \"perfunc\" or \"perblock\" (default)\n"} Granularity


    ^{:line 33 :tag string :doc "Module path for this package (empty if no go.mod in use)\n"} ModulePath






    ^{:line 40 :tag bool :doc "Local mode indicates we're doing a coverage build or test of a\npackage selected via local import path, e.g. \"./...\" or\n\"./foo/bar\" as opposed to a non-relative import path. See the\ncorresponding field in cmd/go's PackageInternal struct for more\ninfo.\n"} Local






    ^{:line 47 :tag string :doc "EmitMetaFile if non-empty is the path to which the cover tool should\ndirectly emit a coverage meta-data file for the package, if the\npackage has any functions in it. The go command will pass in a value\nhere if we've been asked to run \"go test -cover\" on a package that\ndoesn't have any *_test.go files.\n"} EmitMetaFile))








(go/type CoverFixupConfig "CoverFixupConfig contains annotations/notes generated by the\ncmd/cover tool (during instrumentation) to be passed on to the\ncompiler when the instrumented code is compiled. The cmd/cover tool\ncreates a struct of this type, JSON-encodes it, and emits the\nresult to a file, which the Go command then passes to the compiler\nwhen the instrumented package is built.\n" (struct


    ^{:line 59 :tag string :doc "Name of the variable (created by cmd/cover) containing the\nencoded meta-data for the package.\n"} MetaVar


    ^{:line 62 :tag int :doc "Length of the meta-data.\n"} MetaLen


    ^{:line 65 :tag string :doc "Hash computed by cmd/cover of the meta-data.\n"} MetaHash





    ^{:line 71 :tag string :doc "Instrumentation strategy. For now this is always set to\n\"normal\", but in the future we may add new values (for example,\nif panic paths are instrumented, or if the instrumenter\neliminates redundant counters).\n"} Strategy



    ^{:line 75 :tag string :doc "Prefix assigned to the names of counter variables generated\nduring instrumentation by cmd/cover.\n"} CounterPrefix



    ^{:line 79 :tag string :doc "Name chosen for the package ID variable generated during\ninstrumentation.\n"} PkgIdVar


    ^{:line 82 :tag string :doc "Counter mode (e.g. set/count/atomic)\n"} CounterMode


    ^{:line 85 :tag string :doc "Counter granularity (perblock or perfunc).\n"} CounterGranularity))






^{:go/end 97} (go/func MetaFileForPackage "MetaFileForPackage returns the expected name of the meta-data file\nfor the package whose import path is 'importPath' in cases where\nwe're using meta-data generated by the cover tool, as opposed to a\nmeta-data file created at runtime.\n" ^string [^string importPath]
  (let [^{:tag (array 32 byte)} r (zero (array 32 byte))
      ^{:line 94} sum (sha256/Sum256 (conv (slice byte) importPath))]
    (copy (subslice r) (subslice sum))
    (+ coverage/MetaFilePref (fmt/Sprintf ".%x" r))))

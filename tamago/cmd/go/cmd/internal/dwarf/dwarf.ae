^{:go/breaks [[4 997]] :go/end 998} (go/func putattr ^error [^Context ctxt ^Sym s ^int abbrev ^int form ^int cls ^int64 value ^any data]
  (switch form
    (case [DW_FORM_addr] ; address
      ;; Allow nil addresses for DW_AT_go_runtime_type.
      (when (and (== data nil) (== value 0))
        (.AddInt ctxt s (.PtrSize ctxt) 0)
        (break))

      (when (== cls DW_CLS_GO_TYPEREF)
        (.AddSectionOffset ctxt s (.PtrSize ctxt) data value)
        (break))

      (.AddAddress ctxt s data value))

    (case [DW_FORM_block1] ; block
      (when (== cls DW_CLS_ADDRESS)
        (.AddInt ctxt s 1 (conv int64 (+ 1 (.PtrSize ctxt))))
        (.AddInt ctxt s 1 DW_OP_addr)
        (.AddAddress ctxt s data 0)
        (break))


      (set! value bit-and 0xff)
      (.AddInt ctxt s 1 value)
      (let [p (subslice (assert (slice byte) data) _ value)]
        (.AddBytes ctxt s p)))

    (case [DW_FORM_block2] ; block
      (set! value bit-and 0xffff)

      (.AddInt ctxt s 2 value)
      (let [p (subslice (assert (slice byte) data) _ value)]
        (.AddBytes ctxt s p)))

    (case [DW_FORM_block4] ; block
      (set! value bit-and 0xffffffff)

      (.AddInt ctxt s 4 value)
      (let [p (subslice (assert (slice byte) data) _ value)]
        (.AddBytes ctxt s p)))

    (case [DW_FORM_block] ; block
      (Uleb128put ctxt s value)

      (let [p (subslice (assert (slice byte) data) _ value)]
        (.AddBytes ctxt s p)))

    (case [DW_FORM_data1] ; constant
      (.AddInt ctxt s 1 value))

    (case [DW_FORM_data2] ; constant
      (.AddInt ctxt s 2 value))

    (case [DW_FORM_data4] ; constant, {line,loclist,mac,rangelist}ptr

^{:go/end 1109} (go/method PutRanges "PutRanges writes a range table to s.Ranges.\nAll addresses in ranges are relative to s.base.\n" [^{:tag (* FnState)} s ^Context ctxt ^{:tag (slice Range)} ranges]
  (let [ps (.PtrSize ctxt)
      (values sym base) (values (.-Ranges s) (.-StartPC s))]

    (when ^{:go/via [Flags]} (.-Dwarf5 buildcfg/Experiment)
      (PutRngListRanges ctxt sym base ranges)
      (return))


    (when (.-UseBASEntries s)

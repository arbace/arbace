      (.AddDWARFAddrSectionOffset ctxt s data value))

    (case [DW_FORM_addrx] ; index into .debug_addr section
      (.AddIndirectTextRef ctxt s data))

    (case [DW_FORM_ref1 ; reference within the compilation unit

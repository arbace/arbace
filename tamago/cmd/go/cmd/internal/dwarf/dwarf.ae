^{:go/end 222} (go/func AppendUleb128 "AppendUleb128 appends v to b using DWARF's unsigned LEB128 encoding.\n" ^{:tag (slice byte)} [^{:tag (slice byte)} b ^uint64 v]
  (while true
    (let [c (conv uint8 (bit-and v 0x7f))]
      (set! v >> 7)
      (when (!= v 0)
        (set! c bit-or 0x80))

      (set! b (append b c))
      (when (== (bit-and c 0x80) 0)
        (break))))


  ^{:line 221} b)



^{:go/end 239} (go/func AppendSleb128 "AppendSleb128 appends v to b using DWARF's signed LEB128 encoding.\n" ^{:tag (slice byte)} [^{:tag (slice byte)} b ^int64 v]

      (.AddCURelativeAddress ctxt sym base (.-Start r))
      (.AddCURelativeAddress ctxt sym base (.-End r)))

    ;; Write trailer.
    (.AddInt ctxt sym ps 0)
    (.AddInt ctxt sym ps 0)))





^{:go/end 1132} (go/func isEmptyInlinedCall "Return TRUE if the inlined call in the specified slot is empty,\nmeaning it has a zero-length range (no instructions), and all\nof its children are empty.\n" ^bool [^int slot ^{:tag (* InlCalls)} calls]

^{:go/end 141} (go/func MergeRanges "MergeRanges creates a new range list by merging the ranges from\nits two arguments, then returns the new list.\n" ^{:tag (slice Range)} [^{:tag (slice Range)} in1 ^{:tag (slice Range)} in2]
  (let [out (make (slice Range) 0 (+ (len in1) (len in2)))
      (values i j) (values 0 0)]
    (while true
      (let [^Range cur (zero Range)]
        (cond (and (< i (len in2)) (< j (len in1)))
          (if (< (.-Start (aget in2 i)) (.-Start (aget in1 j))) (do
              (set! cur (aget in2 i))
              (inc! i))
            (do
              (set! cur (aget in1 j))
              (inc! j)))

          (< i (len in2)) (do
            (set! cur (aget in2 i))
            (inc! i))
          (< j (len in1)) (do
            (set! cur (aget in1 j))
            (inc! j)) :else

          (break))


        (if [n (len out)] (and (> n 0) (<= (.-Start cur) (.-End (aget out (- n 1)))))
          (set! (.-End (aget out (- n 1))) (.-End cur))

          (set! out (append out cur)))))



    ^{:line 140} out))



^{:go/end 146} (go/method UnifyRanges "UnifyRanges merges the ranges from 'c' into the list of ranges for 's'.\n" [^{:tag (* Scope)} s ^{:tag (* Scope)} c]
  (set! (.-Ranges s) (MergeRanges (.-Ranges s) (.-Ranges c))))




^{:go/end 160} (go/method AppendRange "AppendRange adds r to s, if r is non-empty.\nIf possible, it extends the last Range in s.Ranges; if not, it creates a new one.\n" [^{:tag (* Scope)} s ^Range r]
  (when (<= (.-End r) (.-Start r))
    (return))

  (let [i (len (.-Ranges s))]
    (when (and (> i 0) (== (.-End (aget (.-Ranges s) (- i 1))) (.-Start r)))
      (set! (.-End (aget (.-Ranges s) (- i 1))) (.-End r))
      (return))

    (set! (.-Ranges s) (append (.-Ranges s) r))))



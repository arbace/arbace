      (.AddInt ctxt sym ps (.-End r)))

    ;; Write trailer.
    (.AddInt ctxt sym ps 0)
    (.AddInt ctxt sym ps 0)))




^{:go/end 1079} (go/func PutRngListRanges "PutRngListRanges writes a DWARF5-style set of rangelist entries to sym,\nusing base as a starting/base address.\n" [^Context ctxt ^Sym sym ^Sym base ^{:tag (slice Range)} ranges]

^{:go/end 1695} (go/func IsDWARFEnabledOnAIXLd "IsDWARFEnabledOnAIXLd returns true if DWARF is possible on the\ncurrent extld.\nAIX ld doesn't support DWARF with -bnoobjreorder with version\nprior to 7.2.2.\n" [^{:tag (slice string)} extld] :results [bool error]
  (let [(values name args) (values (aget extld 0) (subslice extld 1))]
    (set! args (append args "-Wl,-V"))
    (let [(values out err) (.CombinedOutput (exec/Command name (spread args)))]
      (when (!= err nil)
        ;; The normal output should display ld version and
        ;; then fails because ".main" is not defined:
        ;; ld: 0711-317 ERROR: Undefined symbol: .main
        (when (not (bytes/Contains out (conv (slice byte) "0711-317")))
          (return false (fmt/Errorf "%s -Wl,-V failed: %v\n%s" extld err out))))


      ;; gcc -Wl,-V output should be:
      ;;   /usr/bin/ld: LD X.X.X(date)
      ;;   ...
      (set! out (bytes/TrimPrefix out (conv (slice byte) "/usr/bin/ld: LD ")))
      (let [vers (conv string (aget (bytes/Split out (conv (slice byte) "(")) 0))
          ^{:line 1677} subvers (strings/Split vers ".")]
        (when (!= (len subvers) 3)
          (return false (fmt/Errorf "cannot parse %s -Wl,-V (%s): %v\n" extld out err)))

        (if [(values v err) (strconv/Atoi (aget subvers 0))] (or (!= err nil) (< v 7))
          (return false nil)
          (when (> v 7)
            (return true nil)))

        (if [(values v err) (strconv/Atoi (aget subvers 1))] (or (!= err nil) (< v 2))
          (return false nil)
          (when (> v 2)
            (return true nil)))

        (when [(values v err) (strconv/Atoi (aget subvers 2))] (or (!= err nil) (< v 2))
          (return false nil))

        (return true nil)))))

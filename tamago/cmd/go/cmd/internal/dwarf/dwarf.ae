^{:go/end 400} (go/func expandPseudoForm "expandPseudoForm takes an input DW_FORM_xxx value and translates it\ninto a version- and platform-appropriate concrete form. Existing\nconcrete/real DW_FORM values are left untouched. For the moment the\nonly platform-specific pseudo-form is DW_FORM_udata_pseudo, which\ngets expanded to DW_FORM_data4 on Darwin and DW_FORM_udata\neverywhere else. See issue #31459 for more context. Then we have a\npair of pseudo-forms for lo and hi PC attributes, which are\nexpanded differently depending on whether we're generating DWARF\nversion 4 or 5.\n" ^uint8 [^uint8 form]
  (switch form
    (case [DW_FORM_udata_pseudo]
      (let [expandedForm DW_FORM_udata]
        (when (or (== buildcfg/GOOS "darwin") (== buildcfg/GOOS "ios"))
          (set! expandedForm DW_FORM_data4))

        (return (conv uint8 expandedForm))))
    (case [DW_FORM_lo_pc_pseudo]
      (when ^{:go/via [Flags]} (.-Dwarf5 buildcfg/Experiment)
        (return DW_FORM_addrx))

      (return DW_FORM_addr))
    (case [DW_FORM_hi_pc_pseudo]
      (when ^{:go/via [Flags]} (.-Dwarf5 buildcfg/Experiment)
        (return DW_FORM_udata))

      (return DW_FORM_addr))
    (default
      (return form))))





^{:go/end 435} (go/func Abbrevs "Abbrevs returns the finalized abbrev array for the platform,\nexpanding any DW_FORM pseudo-ops to real values.\n" ^{:tag (slice dwAbbrev)} []
  (when abbrevsFinalized
    (return abbrevs))

  (set! abbrevs (append abbrevs (spread putvarAbbrevs)))
  (for [i 1] (< i (len abbrevs)) (inc! i)
    (for [j 0] (< j (len (.-attr (aget abbrevs i)))) (inc! j)
      (set! (.-form (aget (.-attr (aget abbrevs i)) j)) (expandPseudoForm (.-form (aget (.-attr (aget abbrevs i)) j))))))


  (when ^{:go/via [Flags]} (.-Dwarf5 buildcfg/Experiment)

^{:go/breaks [[5 259]] :go/end 260} (go/func sevenBitU "sevenBitU returns the unsigned LEB128 encoding of v if v is seven bits and nil otherwise.\nThe contents of the returned slice must not be modified.\n" ^{:tag (slice byte)} [^int64 v]
  (when (< (conv uint64 v) (conv uint64 (len sevenbits)))
    (return (subslice sevenbits v (+ v 1))))

  nil)




^{:go/breaks [[6 271]] :go/end 272} (go/func sevenBitS "sevenBitS returns the signed LEB128 encoding of v if v is seven bits and nil otherwise.\nThe contents of the returned slice must not be modified.\n" ^{:tag (slice byte)} [^int64 v]
  (when (<= (conv uint64 v) 63)
    (return (subslice sevenbits v (+ v 1))))

  (when (<= (conv uint64 (- v)) 64)
    (return (subslice sevenbits (+ 128 v) (+ 128 v 1))))

  nil)




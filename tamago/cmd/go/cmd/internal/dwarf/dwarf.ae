^{:go/end 1055} (go/func PutBasedRanges "PutBasedRanges writes a range table to sym. All addresses in ranges are\nrelative to some base address, which must be arranged by the caller\n(e.g., with a DW_AT_low_pc attribute, or in a BASE-prefixed range).\n" [^Context ctxt ^Sym sym ^{:tag (slice Range)} ranges]

        (.AddDWARFAddrSectionOffset ctxt s data value)
        (break))

      (.AddInt ctxt s 4 value))

    (case [DW_FORM_data8] ; constant, {line,loclist,mac,rangelist}ptr
      (.AddInt ctxt s 8 value))

    (case [DW_FORM_sdata] ; constant

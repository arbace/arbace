(go/type ^:alias ArchFamily "TODO: just use goarch.ArchFamilyType directly\n" goarch/ArchFamilyType)

(go/const
  ^{:line 16} [^{:val 0} AMD64 goarch/AMD64]
  ^{:line 17} [^{:val 1} ARM goarch/ARM]
  ^{:line 18} [^{:val 2} ARM64 goarch/ARM64]
  ^{:line 19} [^{:val 3} I386 goarch/I386]

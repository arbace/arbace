(in-ns 'go.cmd.internal.sys) (go/file "args.go" :imports [])







(go/const ^{:val 30720 :doc "ExecArgLengthLimit is the number of bytes we can safely\npass as arguments to an exec.Command.\n\nWindows has a limit of 32 KB. To be conservative and not worry about whether\nthat includes spaces or not, just use 30 KB. Darwin's limit is less clear.\nThe OS claims 256KB, but we've seen failures with arglen as small as 50KB.\n"} ExecArgLengthLimit (<< 30 10))

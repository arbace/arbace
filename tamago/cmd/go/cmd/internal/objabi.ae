(ns go.cmd.internal.objabi
  (:require [arbace.go :as go]))

(go/package objabi
  :path "cmd/internal/objabi"
  :files ["autotype.go" "flag.go" "funcid.go" "head.go" "line.go" "path.go" "pkgspecial.go" "reloctype.go" "reloctype_string.go" "stack.go" "symkind.go" "symkind_string.go" "util.go" "zbootstrap.go"]
  :positions :lines)

(load "objabi/autotype")
(load "objabi/flag")
(load "objabi/funcid")
(load "objabi/head")
(load "objabi/line")
(load "objabi/path")
(load "objabi/pkgspecial")
(load "objabi/reloctype")
(load "objabi/reloctype_string")
(load "objabi/stack")
(load "objabi/symkind")
(load "objabi/symkind_string")
(load "objabi/util")
(load "objabi/zbootstrap")

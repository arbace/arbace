(in-ns 'go.cmd.internal.pgo) (go/file "serialize.go" :imports [


    ^{:line 8} [bufio "bufio"]
    ^{:line 9} [fmt "fmt"]
    ^{:line 10} [io "io"]])


;; Serialization of a Profile allows go tool preprofile to construct the edge
;; map only once (rather than once per compile process). The compiler processes
;; then parse the pre-processed data directly from the serialized format.
;;
;; The format of the serialized output is as follows.
;;
;;      GO PREPROFILE V1
;;      caller_name
;;      callee_name
;;      "call site offset" "call edge weight"
;;      ...
;;      caller_name
;;      callee_name
;;      "call site offset" "call edge weight"
;;
;; Entries are sorted by "call edge weight", from highest to lowest.

(go/const ^{:val "GO PREPROFILE V1\n"} serializationHeader "GO PREPROFILE V1\n")






^{:go/end 79} (go/method WriteTo "WriteTo writes a serialized representation of Profile to w.\n\nFromSerialized can parse the format back to Profile.\n\nWriteTo implements io.WriterTo.Write.\n" [^{:tag (* Profile)} d ^io/Writer w] :results [int64 error]
  (let [bw (bufio/NewWriter w)

      ^{:line 40 :tag int64} written (zero int64)

      ;; Header
      (values n err) (.WriteString bw serializationHeader)]
    (set! written + (conv int64 n))
    (when (!= err nil)
      (return written err))


    (range [_ edge (.-ByWeight (.-NamedEdgeMap d))]
      (let [weight (aget (.-Weight (.-NamedEdgeMap d)) edge)]

        (set! (values n err) (fmt/Fprintln bw (.-CallerName edge)))
        (set! written + (conv int64 n))
        (when (!= err nil)
          (return written err))


        (set! (values n err) (fmt/Fprintln bw (.-CalleeName edge)))
        (set! written + (conv int64 n))
        (when (!= err nil)
          (return written err))


        (set! (values n err) (fmt/Fprintf bw "%d %d\n" (.-CallSiteOffset edge) weight))
        (set! written + (conv int64 n))
        (when (!= err nil)
          (return written err))))



    (when [err (.Flush bw)] (!= err nil)
      (return written err))


    ;; No need to serialize TotalWeight, it can be trivially recomputed
    ;; during parsing.

    (return written nil)))

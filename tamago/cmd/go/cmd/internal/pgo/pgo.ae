;; Package pgo contains the compiler-agnostic portions of PGO profile handling.
;; Notably, parsing pprof profiles and serializing/deserializing from a custom
;; intermediate representation.
(in-ns 'go.cmd.internal.pgo) (go/file "pgo.go" :doc "Package pgo contains the compiler-agnostic portions of PGO profile handling.\nNotably, parsing pprof profiles and serializing/deserializing from a custom\nintermediate representation.\n" :imports [])


(go/type Profile "Profile contains the processed data from the PGO profile.\n" (struct



    ^{:line 15 :tag int64 :doc "TotalWeight is the aggregated edge weights across the profile. This\nhelps us determine the percentage threshold for hot/cold\npartitioning.\n"} TotalWeight



    ^{:line 19 :tag NamedEdgeMap :doc "NamedEdgeMap contains all unique call edges in the profile and their\nedge weight.\n"} NamedEdgeMap))




(go/type NamedCallEdge "NamedCallEdge identifies a call edge by linker symbol names and call site\noffset.\n" (struct
    ^{:line 25 :tag string} CallerName
    ^{:line 26 :tag string} CalleeName
    ^{:line 27 :tag int} CallSiteOffset)) ; Line offset from function start line.




(go/type NamedEdgeMap "NamedEdgeMap contains all unique call edges in the profile and their\nedge weight.\n" (struct
    ^{:line 33 :tag (map NamedCallEdge int64)} Weight



    ^{:line 37 :tag (slice NamedCallEdge) :doc "ByWeight lists all keys in Weight, sorted by edge weight from\nhighest to lowest.\n"} ByWeight))


^{:go/end 49} (go/func emptyProfile ^{:tag (* Profile)} []
  ;; Initialize empty maps/slices for easier use without a requiring a
  ;; nil check.
  (addr ^{:go/breaks [2]} (lit Profile
      :NamedEdgeMap ^{:go/breaks [2 4]} (lit NamedEdgeMap
        :ByWeight (make (slice NamedCallEdge) 0)
        :Weight (make (map NamedCallEdge int64))))))





^{:go/end 54} (go/func WeightInPercentage "WeightInPercentage converts profile weights to a percentage.\n" ^float64 [^int64 value ^int64 total]
  (* (/ (conv float64 value) (conv float64 total)) 100))

(ns go.cmd.internal.obj
  (:require [arbace.go :as go]))

(go/package obj
  :path "cmd/internal/obj"
  :files ["abi_string.go" "addrtype_string.go" "data.go" "dwarf.go" "fips140.go" "go.go" "inl.go" "ld.go" "line.go" "link.go" "objfile.go" "pass.go" "pcln.go" "plist.go" "sym.go" "textflag.go" "util.go"]
  :positions :lines)

(load "obj/abi_string")
(load "obj/addrtype_string")
(load "obj/data")
(load "obj/dwarf")
(load "obj/fips140")
(load "obj/go")
(load "obj/inl")
(load "obj/ld")
(load "obj/line")
(load "obj/link")
(load "obj/objfile")
(load "obj/pass")
(load "obj/pcln")
(load "obj/plist")
(load "obj/sym")
(load "obj/textflag")
(load "obj/util")

(in-ns 'go.cmd.internal.telemetry.counter) (go/file "counter.go" :build ["//go:build !cmd_go_bootstrap && !compiler_bootstrap"] :imports [


    ^{:line 10} [flag "flag"]
    ^{:line 11} [os "os"]

    ^{:line 13} [counter "golang.org/x/telemetry/counter"]])


(go/var ^bool openCalled)

^{:go/end 18} (go/func OpenCalled ^bool [] openCalled)



^{:go/end 25} (go/func Open "Open opens the counter files for writing if telemetry is supported\non the current platform (and does nothing otherwise).\n" []
  (set! openCalled true)
  (counter/OpenDir (os/Getenv "TEST_TELEMETRY_DIR")))



^{:go/end 30} (go/func Inc "Inc increments the counter with the given name.\n" [^string name]
  (counter/Inc name))



^{:go/end 35} (go/func New "New returns a counter with the given name.\n" ^{:tag (* counter/Counter)} [^string name]
  (counter/New name))



^{:go/end 40} (go/func NewStack "NewStack returns a new stack counter with the given name and depth.\n" ^{:tag (* counter/StackCounter)} [^string name ^int depth]
  (counter/NewStack name depth))





^{:go/end 47} (go/func CountFlags "CountFlags creates a counter for every flag that is set\nand increments the counter. The name of the counter is\nthe concatenation of prefix and the flag name.\n" [^string prefix ^flag/FlagSet flagSet]
  (counter/CountFlags prefix flagSet))






^{:go/end 62} (go/func CountFlagValue "CountFlagValue creates a counter for the flag value\nif it is set and increments the counter. The name of the\ncounter is the concatenation of prefix, the flagName, \":\",\nand value.String() for the flag's value.\n" [^string prefix ^flag/FlagSet flagSet ^string flagName]
  ;; TODO(matloob): Maybe pass in a list of flagNames if we end up counting
  ;; values for more than one?
  ;; TODO(matloob): Add this to x/telemetry?
  (.Visit flagSet ^{:go/end 61} (fn [^{:tag (* flag/Flag)} f]
      (when (== (.-Name f) flagName)
        (.Inc (counter/New (+ prefix (.-Name f) ":" (.String (.-Value f)))))))))

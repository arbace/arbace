^{:go/end 82} (go/method WithBogusLine "WithBogusLine returns a bogus line that won't match any recorded for the source code.\nIts use is to disrupt the statements within an infinite loop so that the debugger\nwill not itself loop infinitely waiting for the line number to change.\ngdb chooses not to display the bogus line; delve shows it with a complaint, but the\nalternative behavior is to hang.\n" ^XPos [^XPos p]
  (when (== (.-index p) 0)
    ;; See #35652
    (panic "Assigning a bogus line to XPos with no file will cause mysterious downstream failures."))

  (set! (.-lico p) (makeBogusLico))
  ^{:line 81} p)



^{:go/end 88} (go/method WithXlogue "WithXlogue returns the same location but marked with DWARF function prologue/epilogue\n" ^XPos [^XPos p ^PosXlogue x]
  (set! (.-lico p) (.withXlogue (.-lico p) x))
  ^{:line 87} p)



^{:go/end 96} (go/method LineNumber "LineNumber returns a string for the line number, \"?\" if it is not known.\n" ^string [^XPos p]
  (when (not (.IsKnown p))
    (return "?"))

  (.lineNumber (.-lico p)))



^{:go/end 104} (go/method ColumnNumber "ColumnNumber returns a string for the column number, \"?\" if it is not known.\n" ^string [^XPos p]
  (when (not (.IsKnown p))
    (return "?"))

  (fmt/Sprintf "%d" (.Col (.-lico p))))





^{:go/end 111} (go/method FileIndex "FileIndex returns a smallish non-negative integer corresponding to the\nfile for this source position.  Smallish is relative; it can be thousands\nlarge, but not millions.\n" ^int32 [^XPos p]
  (.-index p))


^{:go/end 118} (go/method LineNumberHTML ^string [^XPos p]
  (when (not (.IsKnown p))

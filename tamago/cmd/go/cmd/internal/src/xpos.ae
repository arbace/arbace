(go/type XPos "XPos is a more compact representation of Pos.\n" (struct
    ^{:line 14 :tag int32} index
    ^{:line 15} lico))



(go/var ^{:tag XPos :doc "NoXPos is a valid unknown position.\n"} NoXPos)




^{:go/end 26} (go/method IsKnown "IsKnown reports whether the position p is known.\nXPos.IsKnown() matches Pos.IsKnown() for corresponding\npositions.\n" ^bool [^XPos p]
  (or (!= (.-index p) 0) (!= ^{:go/via [lico]} (.Line p) 0)))




^{:go/end 33} (go/method Before "Before reports whether the position p comes before q in the source.\nFor positions with different bases, ordering is by base index.\n" ^bool [^XPos p ^XPos q]
  (let [(values n m) (values (.-index p) (.-index q))]
    (or (< n m) (and (== n m) (< (.-lico p) (.-lico q))))))



^{:go/end 38} (go/method SameFile "SameFile reports whether p and q are positions in the same file.\n" ^bool [^XPos p ^XPos q]
  (== (.-index p) (.-index q)))



^{:go/end 43} (go/method SameFileAndLine "SameFileAndLine reports whether p and q are positions on the same line in the same file.\n" ^bool [^XPos p ^XPos q]
  (and (== (.-index p) (.-index q)) (.SameLine (.-lico p) (.-lico q))))




^{:go/end 50} (go/method After "After reports whether the position p comes after q in the source.\nFor positions with different bases, ordering is by base index.\n" ^bool [^XPos p ^XPos q]
  (let [(values n m) (values (.-index p) (.-index q))]
    (or (> n m) (and (== n m) (> (.-lico p) (.-lico q))))))



^{:go/end 56} (go/method WithNotStmt "WithNotStmt returns the same location to be marked with DWARF is_stmt=0\n" ^XPos [^XPos p]
  (set! (.-lico p) (.withNotStmt (.-lico p)))

  ^{:line 123} p)




(go/type PosTable "A PosTable tracks Pos -> XPos conversions and vice versa.\nIts zero value is a ready-to-use PosTable.\n" (struct
    ^{:line 129 :tag (slice (* PosBase))} baseList
    ^{:line 130 :tag (map (* PosBase) int)} indexMap
    ^{:line 131 :tag (map string int)} nameMap)) ; Maps file symbol name to index for debug information.




^{:go/end 138} (go/method XPos "XPos returns the corresponding XPos for the given pos,\nadding pos to t if necessary.\n" ^XPos [^{:tag (* PosTable)} t ^Pos pos]
  (lit XPos (.baseIndex t (.-base pos)) (.-lico pos)))


^{:go/end 171} (go/method baseIndex ^int32 [^{:tag (* PosTable)} t ^{:tag (* PosBase)} base]
  (when (== base nil)
    (return 0))


  (when [(values i ok) (aget (.-indexMap t) base)] ok
    (return (conv int32 i)))


  (when (>= (.-fileIndex base) 0)
    (panic "PosBase already registered with a PosTable"))


  (when (== (.-indexMap t) nil)
    (set! (.-baseList t) (append (.-baseList t) nil))
    (set! (.-indexMap t) (make (map (* PosBase) int)))
    (set! (.-nameMap t) (make (map string int))))


  (let [i (len (.-baseList t))]
    (aset (.-indexMap t) base i)
    (set! (.-baseList t) (append (.-baseList t) base))

    (let [(values fileIndex ok) (aget (.-nameMap t) (.-absFilename base))]
      (when (not ok)
        (set! fileIndex (len (.-nameMap t)))
        (aset (.-nameMap t) (.-absFilename base) fileIndex))

      (set! (.-fileIndex base) fileIndex)

      (conv int32 i))))




^{:go/end 181} (go/method Pos "Pos returns the corresponding Pos for the given p.\nIf p cannot be translated via t, the function panics.\n" ^Pos [^{:tag (* PosTable)} t ^XPos p]
  (let [^{:tag (* PosBase)} base (zero (* PosBase))]
    (when (!= (.-index p) 0)
      (set! base (aget (.-baseList t) (.-index p))))

    (lit Pos base (.-lico p))))



^{:go/end 193} (go/method FileTable "FileTable returns a slice of all files used to build this package.\n" ^{:tag (slice string)} [^{:tag (* PosTable)} t]
  ;; Create a LUT of the global package level file indices. This table is what
  ;; is written in the debug_lines header, the file[N] will be referenced as
  ;; N+1 in the debug_lines table.
  (let [fileLUT (make (slice string) (len (.-nameMap t)))]
    (range [str i (.-nameMap t)]
      (aset fileLUT i str))

    ^{:line 192} fileLUT))

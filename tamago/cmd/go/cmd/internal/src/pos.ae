(go/const ^{:val "gofile.." :doc "FileSymPrefix is the linker symbol prefix that used to be used for\nlinker pseudo-symbols representing file names.\n"} FileSymPrefix "gofile..")




^{:go/breaks [[5 284]] :go/end 285} (go/method FileIndex "FileIndex returns the index of the base's absolute filename within\nits PosTable's FileTable. It panics if it hasn't been registered\nwith a PosTable. If b == nil, the result is -1.\n" ^int [^{:tag (* PosBase)} b]
  (when (!= b nil)
    (when (< (.-fileIndex b) 0)

;; ----------------------------------------------------------------------------
;; lico


(go/type lico "A lico is a compact encoding of a LIne and COlumn number.\n" uint32)











(go/const "Layout constants: 20 bits for line, 8 bits for column, 2 for isStmt, 2 for pro/epilogue\n(If this is too tight, we can either make lico 64b wide,\nor we can introduce a tiered encoding where we remove column\ninformation as line numbers grow bigger; similar to what gcc\ndoes.)\nThe bitfield order is chosen to make IsStmt be the least significant\npart of a position; its use is to communicate statement edges through\ninstruction scrambling in code generation, not to impose an order.\nTODO: Prologue and epilogue are perhaps better handled as pseudo-ops for the assembler,\nbecause they have almost no interaction with other uses of the position.\n"
  ^{:line 332} [(values ^{:val 20} lineBits ^{:val 1048574} lineMax) (values 20 (- (<< 1 lineBits) 2))]
  ^{:line 333} [^{:val 1} bogusLine 1] ; Used to disrupt infinite loops to prevent debugger looping
  ^{:line 334} [(values ^{:val 2} isStmtBits ^{:val 3} isStmtMax) (values 2 (- (<< 1 isStmtBits) 1))]
  ^{:line 335} [(values ^{:val 2} xlogueBits ^{:val 3} xlogueMax) (values 2 (- (<< 1 xlogueBits) 1))]
  ^{:line 336} [(values ^{:val 8} colBits ^{:val 255} colMax) (values (- 32 lineBits xlogueBits isStmtBits) (- (<< 1 colBits) 1))]

  ^{:line 338} [^{:val 0} isStmtShift 0]
  ^{:line 339} [^{:val 3} isStmtMask (<< isStmtMax isStmtShift)]
  ^{:line 340} [^{:val 2} xlogueShift (+ isStmtBits isStmtShift)]
  ^{:line 341} [^{:val 12} xlogueMask (<< xlogueMax xlogueShift)]
  ^{:line 342} [^{:val 4} colShift (+ xlogueBits xlogueShift)]
  ^{:line 343} [^{:val 12} lineShift (+ colBits colShift)])

(go/const



























  ^{:line 373} [^{:tag uint :val 0 :doc "It is expected that the front end or a phase in SSA will usually generate positions tagged with\nPosDefaultStmt, but note statement boundaries with PosIsStmt.  Simple statements will have a single\nboundary; for loops with initialization may have one for their entry and one for their back edge\n(this depends on exactly how the loop is compiled; the intent is to provide a good experience to a\nuser debugging a program; the goal is that a breakpoint set on the loop line fires both on entry\nand on iteration).  Proper treatment of non-gofmt input with multiple simple statements on a single\nline is TBD.\n\nOptimizing compilation will move instructions around, and some of these will become known-bad as\nstep targets for debugging purposes (examples: register spills and reloads; code generated into\nthe entry block; invariant code hoisted out of loops) but those instructions will still have interesting\npositions for profiling purposes. To reflect this these positions will be changed to PosNotStmt.\n\nWhen the optimizer removes an instruction marked PosIsStmt; it should attempt to find a nearby\ninstruction with the same line marked PosDefaultStmt to be the new statement boundary.  I.e., the\noptimizer should make a best-effort to conserve statement boundary positions, and might be enhanced\nto note when a statement boundary is not conserved.\n\nCode cloning, e.g. loop unrolling or loop unswitching, is an exception to the conservation rule\nbecause a user running a debugger would expect to see breakpoints active in the copies of the code.\n\nIn non-optimizing compilation there is still a role for PosNotStmt because of code generation\ninto the entry block.  PosIsStmt statement positions should be conserved.\n\nWhen code generation occurs any remaining default-marked positions are replaced with not-statement\npositions.\n"} PosDefaultStmt iota] ; Default; position is not a statement boundary, but might be if optimization removes the designated statement boundary
  ^{:line 374} [^{:val 1} PosIsStmt] ; Position is a statement boundary; if optimization removes the corresponding instruction, it should attempt to find a new instruction to be the boundary.
  ^{:line 375} [^{:val 2} PosNotStmt]) ; Position should not be a statement boundary, but line should be preserved for profiling and low-level debugging purposes.


(go/type PosXlogue uint)

(go/const
  ^{:line 381} [^{:tag PosXlogue :val 0} PosDefaultLogue iota]
  ^{:line 382} [^{:val 1} PosPrologueEnd]
  ^{:line 383} [^{:val 2} PosEpilogueBegin])


^{:go/end 388} (go/func makeLicoRaw ^lico [^uint line ^uint col]
  (conv lico (bit-or (<< line lineShift) (<< col colShift))))




^{:go/end 394} (go/func makeBogusLico "This is a not-position that will not be elided.\nDepending on the debugger (gdb or delve) it may or may not be displayed.\n" ^lico []
  (.withIsStmt (makeLicoRaw bogusLine 0)))


^{:go/end 410} (go/func makeLico ^lico [^uint line ^uint col]
  (when (>= line lineMax)
    ;; cannot represent line, use max. line so we have some information
    (set! line lineMax)
    ;; Drop column information if line number saturates.
    ;; Ensures line+col is monotonic. See issue 51193.
    (set! col 0))

  (when (> col colMax)
    ;; cannot represent column, use max. column so we have some information
    (set! col colMax))

  ;; default is not-sure-if-statement
  (makeLicoRaw line col))


^{:go/end 412} (go/method Line ^uint [^lico x] (>> (conv uint x) lineShift))
^{:go/end 413} (go/method SameLine ^bool [^lico x ^lico y] (== 0 (bit-and-not (bit-xor x y) (conv lico (- (<< 1 lineShift) 1)))))
^{:go/end 414} (go/method Col ^uint [^lico x] (bit-and (>> (conv uint x) colShift) colMax))
^{:go/end 420} (go/method IsStmt ^uint [^lico x]
  (when (== x 0)
    (return PosNotStmt))

  (bit-and (>> (conv uint x) isStmtShift) isStmtMax))

^{:go/end 423} (go/method Xlogue ^PosXlogue [^lico x]
  (conv PosXlogue (bit-and (>> (conv uint x) xlogueShift) xlogueMax)))



^{:go/end 428} (go/method withNotStmt "withNotStmt returns a lico for the same location, but not a statement\n" ^lico [^lico x]
  (.withStmt x PosNotStmt))



^{:go/end 433} (go/method withDefaultStmt "withDefaultStmt returns a lico for the same location, with default isStmt\n" ^lico [^lico x]
  (.withStmt x PosDefaultStmt))



^{:go/end 438} (go/method withIsStmt "withIsStmt returns a lico for the same location, tagged as definitely a statement\n" ^lico [^lico x]
  (.withStmt x PosIsStmt))



^{:go/end 450} (go/method withXlogue "withXlogue attaches a prologue/epilogue attribute to a lico\n" ^lico [^lico x ^PosXlogue xlogue]
  (when (== x 0)
    (when (== xlogue 0)
      (return x))

    ;; Normalize 0 to "not a statement"
    (set! x (conv lico (<< PosNotStmt isStmtShift))))

  (conv lico (bit-or (bit-and (conv uint x) (bit-not (conv uint (<< xlogueMax xlogueShift)))) (<< (conv uint xlogue) xlogueShift))))



^{:go/end 458} (go/method withStmt "withStmt returns a lico for the same location with specified is_stmt attribute\n" ^lico [^lico x ^uint stmt]
  (when (== x 0)
    (return (conv lico 0)))

  (conv lico (bit-or (bit-and (conv uint x) (bit-not (conv uint (<< isStmtMax isStmtShift)))) (<< stmt isStmtShift))))


^{:go/end 462} (go/method lineNumber ^string [^lico x]
  (fmt/Sprintf "%d" (.Line x)))


^{:go/end 474} (go/method lineNumberHTML ^string [^lico x]
  (when (== (.IsStmt x) PosDefaultStmt)
    (return (fmt/Sprintf "%d" (.Line x))))

  (let [(values style pfx) (values "b" "+")]
    (when (== (.IsStmt x) PosNotStmt)
      (set! style "s") ; /strike not supported in HTML5
      (set! pfx ""))

    (fmt/Sprintf "<%s>%s%d</%s>" style pfx (.Line x) style)))


^{:go/end 478} (go/method atColumn1 ^lico [^lico x]
  (.withIsStmt (makeLico (.Line x) 1)))

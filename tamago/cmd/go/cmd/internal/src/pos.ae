(go/type PosBase "A PosBase encodes a filename and base position.\nTypically, each file and line directive introduce a PosBase.\n" (struct
    ^{:line 193 :tag Pos} pos ; position at which the relative position is (line, col)
    ^{:line 194 :tag string} filename ; file name used to open source file, for error messages
    ^{:line 195 :tag string} absFilename ; absolute file name, for PC-Line tables
    ^{:line 196 :tag uint} line ^uint col ; relative line, column number at pos
    ^{:line 197 :tag int} inl ; inlining index (see cmd/internal/obj/inl.go)
    ^{:line 198 :tag int} fileIndex)) ; index of absFilename within PosTable.FileTable




^{:go/end 214} (go/func NewFileBase "NewFileBase returns a new *PosBase for a file with the given (relative and\nabsolute) filenames.\n" ^{:tag (* PosBase)} [^string filename ^string absFilename]
  (let [base (addr ^{:go/breaks [2 4 6 8 10 12]} (lit PosBase
          :filename filename
          :absFilename absFilename
          :line 1
          :col 1
          :inl -1
          :fileIndex -1))]

    (set! (.-pos base) (MakePos base 1 1))
    ^{:line 213} base))








^{:go/end 224} (go/func NewLinePragmaBase "NewLinePragmaBase returns a new *PosBase for a line directive of the form\n\n\t//line filename:line:col\n\t/*line filename:line:col*/\n\nat position pos.\n" ^{:tag (* PosBase)} [^Pos pos ^string filename ^string absFilename ^uint line ^uint col]
  (addr (lit PosBase pos filename absFilename line col -1 -1)))




^{:go/end 239} (go/func NewInliningBase "NewInliningBase returns a copy of the orig PosBase with the given inlining\nindex. If orig == nil, NewInliningBase panics.\n" ^{:tag (* PosBase)} [^{:tag (* PosBase)} orig ^int inlTreeIndex]
  (when (== orig nil)
    (panic "no old PosBase"))

  (let [base @orig]
    (set! (.-inl base) inlTreeIndex)
    (set! (.-fileIndex base) -1)
    (when (== orig (.-base (.-pos orig)))
      (set! (.-base (.-pos base)) (addr base)))

    (addr base)))


(go/var ^Pos noPos)



^{:go/end 250} (go/method Pos "Pos returns the position at which base is located.\nIf b == nil, the result is the zero position.\n" ^{:tag (* Pos)} [^{:tag (* PosBase)} b]
  (when (!= b nil)
    (return (addr (.-pos b))))

  (addr noPos))




^{:go/breaks [[5 258]] :go/end 259} (go/method Filename "Filename returns the filename recorded with the base.\nIf b == nil, the result is the empty string.\n" ^string [^{:tag (* PosBase)} b]

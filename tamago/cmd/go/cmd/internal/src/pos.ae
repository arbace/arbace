(go/type Pos "A Pos encodes a source position consisting of a (line, column) number pair\nand a position base. A zero Pos is a ready to use \"unknown\" position (nil\nposition base and zero line number).\n\nThe (line, column) values refer to a position in a file independent of any\nposition base (\"absolute\" file position).\n\nThe position base is used to determine the \"relative\" position, that is the\nfilename and line number relative to the position base. If the base refers\nto the current file, there is no difference between absolute and relative\npositions. If it refers to a //line directive, a relative position is relative\nto that directive. A position base in turn contains the position at which it\nwas introduced in the current file.\n" (struct
    ^{:line 29 :tag (* PosBase)} base
    ^{:line 30} lico))



(go/var ^{:tag Pos :doc "NoPos is a valid unknown position.\n"} NoPos)



^{:go/end 40} (go/func MakePos "MakePos creates a new Pos value with the given base, and (file-absolute)\nline and column.\n" ^Pos [^{:tag (* PosBase)} base ^uint line ^uint col]
  (lit Pos base (makeLico line col)))





^{:go/end 47} (go/method IsKnown "IsKnown reports whether the position p is known.\nA position is known if it either has a non-nil\nposition base, or a non-zero line number.\n" ^bool [^Pos p]
  (or (!= (.-base p) nil) (!= ^{:go/via [lico]} (.Line p) 0)))




^{:go/end 54} (go/method Before "Before reports whether the position p comes before q in the source.\nFor positions in different files, ordering is by filename.\n" ^bool [^Pos p ^Pos q]
  (let [(values n m) (values (.Filename p) (.Filename q))]
    (or (< n m) (and (== n m) (< (.-lico p) (.-lico q))))))




^{:go/end 61} (go/method After "After reports whether the position p comes after q in the source.\nFor positions in different files, ordering is by filename.\n" ^bool [^Pos p ^Pos q]
  (let [(values n m) (values (.Filename p) (.Filename q))]
    (or (> n m) (and (== n m) (> (.-lico p) (.-lico q))))))


^{:go/end 68} (go/method LineNumber ^string [^Pos p]
  (when (not (.IsKnown p))
    (return "?"))

  (.lineNumber (.-lico p)))


^{:go/end 75} (go/method LineNumberHTML ^string [^Pos p]
  (when (not (.IsKnown p))
    (return "?"))

  (.lineNumberHTML (.-lico p)))



^{:go/end 78} (go/method Filename "Filename returns the name of the actual file containing this position.\n" ^string [^Pos p] (.RelFilename (.Pos (.-base p))))


^{:go/end 81} (go/method Base "Base returns the position base.\n" ^{:tag (* PosBase)} [^Pos p] (.-base p))


^{:go/end 84} (go/method SetBase "SetBase sets the position base.\n" [^{:tag (* Pos)} p ^{:tag (* PosBase)} base] (set! (.-base p) base))


^{:go/end 87} (go/method RelFilename "RelFilename returns the filename recorded with the position's base.\n" ^string [^Pos p] (.Filename (.-base p)))


^{:go/end 97} (go/method RelLine "RelLine returns the line number relative to the position's base.\n" ^uint [^Pos p]
  (let [b (.-base p)]
    (when (== (.Line b) 0)
      ;; base line is unknown => relative line is unknown
      (return 0))

    (+ (.Line b) (- ^{:go/via [lico]} (.Line p) ^{:go/via [lico]} (.Line (.Pos b))))))



^{:go/end 114} (go/method RelCol "RelCol returns the column number relative to the position's base.\n" ^uint [^Pos p]
  (let [b (.-base p)]
    (when (== (.Col b) 0)
      ;; base column is unknown => relative column is unknown
      ;; (the current specification for line directives requires
      ;; this to apply until the next PosBase/line directive,
      ;; not just until the new newline)
      (return 0))

    (when (== ^{:go/via [lico]} (.Line p) ^{:go/via [lico]} (.Line (.Pos b)))
      ;; p on same line as p's base => column is relative to p's base
      (return (+ (.Col b) (- ^{:go/via [lico]} (.Col p) ^{:go/via [lico]} (.Col (.Pos b))))))

    ^{:go/via [lico]} (.Col p)))



^{:go/end 117} (go/method AbsFilename "AbsFilename() returns the absolute filename recorded with the position's base.\n" ^string [^Pos p] (.AbsFilename (.-base p)))



^{:go/end 121} (go/method FileIndex "FileIndex returns the file index of the position's base's absolute\nfilename within the PosTable that it was registered.\n" ^int [^Pos p] (.FileIndex (.-base p)))

^{:go/end 125} (go/method String ^string [^Pos p]
  (.Format p true true))







^{:go/end 136} (go/method Format "Format formats a position as \"filename:line\" or \"filename:line:column\",\ncontrolled by the showCol flag and if the column is known (!= 0).\nFor positions relative to line directives, the original position is\nshown as well, as in \"filename:line[origfile:origline:origcolumn]\" if\nshowOrig is set.\n" ^string [^Pos p ^bool showCol ^bool showOrig]
  (let [buf (new bytes/Buffer)]
    (.WriteTo p buf showCol showOrig)
    (.String buf)))



^{:go/end 165} (go/method WriteTo "WriteTo a position to w, formatted as Format does.\n" [^Pos p ^io/Writer w ^bool showCol ^bool showOrig]
  (when (not (.IsKnown p))
    (io/WriteString w "<unknown line number>")
    (return))


  (when [b (.-base p)] (== b (.-base (.Pos b)))
    ;; base is file base (incl. nil)
    (format w (.Filename p) ^{:go/via [lico]} (.Line p) ^{:go/via [lico]} (.Col p) showCol)
    (return))


  ;; base is relative
  ;; Print the column only for the original position since the
  ;; relative position's column information may be bogus (it's
  ;; typically generated code and we can't say much about the
  ;; original source at that point but for the file:line info
  ;; that's provided via a line directive).
  ;; TODO(gri) This may not be true if we have an inlining base.
  ;; We may want to differentiate at some point.
  (format w (.RelFilename p) (.RelLine p) (.RelCol p) showCol)
  (when showOrig
    (io/WriteString w "[")
    (format w (.Filename p) ^{:go/via [lico]} (.Line p) ^{:go/via [lico]} (.Col p) showCol)
    (io/WriteString w "]")))





^{:go/end 178} (go/func format "format formats a (filename, line, col) tuple as \"filename:line\" (showCol\nis false or col == 0) or \"filename:line:column\" (showCol is true and col != 0).\n" [^io/Writer w ^string filename ^uint line ^uint col ^bool showCol]
  (io/WriteString w filename)
  (io/WriteString w ":")
  (fmt/Fprint w line)
  ;; col == 0 and col == colMax are interpreted as unknown column values
  (when (and showCol (< 0 col) (< col colMax))
    (io/WriteString w ":")
    (fmt/Fprint w col)))




^{:go/end 185} (go/func formatstr "formatstr wraps format to return a string.\n" ^string [^string filename ^uint line ^uint col ^bool showCol]
  (let [buf (new bytes/Buffer)]
    (format buf filename line col showCol)
    (.String buf)))



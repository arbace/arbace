(go/var ^{:tag int :doc "MaxLen is the maximum length of the string to be searched for (argument b) in Index.\nIf MaxLen is not 0, make sure MaxLen >= 4.\n"} MaxLen)


(go/const ^{:val 16777619 :doc "primeRK is the prime base used in Rabin-Karp algorithm.\n"} primeRK 16777619)



^{:go/end 50} (go/func hashStr "hashStr returns the hash and the appropriate multiplicative\nfactor for use in Rabin-Karp algorithm.\n" :type-params [^{:tag (| string (slice byte))} T] [^T sep] :results [uint32 uint32]
  (let [hash (conv uint32 0)]
    (for [i 0] (< i (len sep)) (inc! i)
      (set! hash (+ (* hash primeRK) (conv uint32 (aget sep i)))))

    (let [(values ^uint32 pow ^uint32 sq) (values 1 primeRK)]
      (for [i (len sep)] (> i 0) (set! i >> 1)
        (when (!= (bit-and i 1) 0)
          (set! pow * sq))

        (set! sq * sq))

      (return hash pow))))




^{:go/end 67} (go/func hashStrRev "hashStrRev returns the hash of the reverse of sep and the\nappropriate multiplicative factor for use in Rabin-Karp algorithm.\n" :type-params [^{:tag (| string (slice byte))} T] [^T sep] :results [uint32 uint32]
  (let [hash (conv uint32 0)]
    (for [i (- (len sep) 1)] (>= i 0) (dec! i)
      (set! hash (+ (* hash primeRK) (conv uint32 (aget sep i)))))

    (let [(values ^uint32 pow ^uint32 sq) (values 1 primeRK)]
      (for [i (len sep)] (> i 0) (set! i >> 1)
        (when (!= (bit-and i 1) 0)
          (set! pow * sq))

        (set! sq * sq))

      (return hash pow))))




^{:go/end 92} (go/func IndexRabinKarp "IndexRabinKarp uses the Rabin-Karp search algorithm to return the index of the\nfirst occurrence of sep in s, or -1 if not present.\n" :type-params [^{:tag (| string (slice byte))} T] ^int [^T s ^:go/grouped ^T sep]
  ;; Rabin-Karp search
  ^{:go/breaks [[5 91]]} (let [(values hashss pow) (^{:inst [T]} hashStr sep)
      ^{:line 74} n (len sep)
      ^{:line 75 :tag uint32} h (zero uint32)]
    (for [i 0] (< i n) (inc! i)
      (set! h (+ (* h primeRK) (conv uint32 (aget s i)))))

    (when (and (== h hashss) (== (conv string (subslice s _ n)) (conv string sep)))
      (return 0))

    (for [i n] (< i (len s)) _
      (set! h * primeRK)
      (set! h + (conv uint32 (aget s i)))
      (set! h - (* pow (conv uint32 (aget s (- i n)))))
      (inc! i)
      (when (and (== h hashss) (== (conv string (subslice s (- i n) i)) (conv string sep)))
        (return (- i n))))


    -1))




^{:go/end 117} (go/func LastIndexRabinKarp "LastIndexRabinKarp uses the Rabin-Karp search algorithm to return the last index of the\noccurrence of sep in s, or -1 if not present.\n" :type-params [^{:tag (| string (slice byte))} T] ^int [^T s ^:go/grouped ^T sep]
  ;; Rabin-Karp search from the end of the string
  ^{:go/breaks [[5 116]]} (let [(values hashss pow) (^{:inst [T]} hashStrRev sep)
      ^{:line 99} n (len sep)
      ^{:line 100} last (- (len s) n)
      ^{:line 101 :tag uint32} h (zero uint32)]
    (for [i (- (len s) 1)] (>= i last) (dec! i)
      (set! h (+ (* h primeRK) (conv uint32 (aget s i)))))

    (when (and (== h hashss) (== (conv string (subslice s last)) (conv string sep)))
      (return last))

    (for [i (- last 1)] (>= i 0) (dec! i)
      (set! h * primeRK)
      (set! h + (conv uint32 (aget s i)))
      (set! h - (* pow (conv uint32 (aget s (+ i n)))))
      (when (and (== h hashss) (== (conv string (subslice s i (+ i n))) (conv string sep)))
        (return i)))


    -1))






(go/func ^:extern MakeNoZero "MakeNoZero makes a slice of length n and capacity of at least n Bytes\nwithout zeroing the bytes (including the bytes between len and cap).\nIt is the caller's responsibility to ensure uninitialized bytes\ndo not leak to the end user.\n" ^{:tag (slice byte)} [^int n])

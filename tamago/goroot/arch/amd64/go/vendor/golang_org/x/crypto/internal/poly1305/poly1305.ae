;; Package poly1305 implements Poly1305 one-time message authentication code as
;; specified in https://cr.yp.to/mac/poly1305-20050329.pdf.
;;
;; Poly1305 is a fast, one-time authentication function. It is infeasible for an
;; attacker to generate an authenticator for a message without the key. However, a
;; key must only be used for a single message. Authenticating two different
;; messages with the same key allows an attacker to forge authenticators for other
;; messages with the same key.
;;
;; Poly1305 was originally coupled with AES in order to make Poly1305-AES. AES was
;; used with a fixed key in order to generate one-time keys from an nonce.
;; However, in this package AES isn't used and the one-time key is specified
;; directly.
(in-ns 'go.vendor.golang_org.x.crypto.internal.poly1305) (go/file "poly1305.go" :doc "Package poly1305 implements Poly1305 one-time message authentication code as\nspecified in https://cr.yp.to/mac/poly1305-20050329.pdf.\n\nPoly1305 is a fast, one-time authentication function. It is infeasible for an\nattacker to generate an authenticator for a message without the key. However, a\nkey must only be used for a single message. Authenticating two different\nmessages with the same key allows an attacker to forge authenticators for other\nmessages with the same key.\n\nPoly1305 was originally coupled with AES in order to make Poly1305-AES. AES was\nused with a fixed key in order to generate one-time keys from an nonce.\nHowever, in this package AES isn't used and the one-time key is specified\ndirectly.\n" :imports [

    ^{:line 20} [subtle "crypto/subtle"]])


(go/const ^{:val 16 :doc "TagSize is the size, in bytes, of a poly1305 authenticator.\n"} TagSize 16)




^{:go/end 32} (go/func Sum "Sum generates an authenticator for msg using a one-time key and puts the\n16-byte result into out. Authenticating two different messages with the same\nkey allows an attacker to forge messages at will.\n" [^{:tag (* (array 16 byte))} out ^{:tag (slice byte)} m ^{:tag (* (array 32 byte))} key]
  (let [h (New key)]
    (.Write h m)
    (.Sum h (subslice out _ 0))))



^{:go/end 39} (go/func Verify "Verify returns true if mac is a valid authenticator for m with the given key.\n" ^bool [^{:tag (* (array 16 byte))} mac ^{:tag (slice byte)} m ^{:tag (* (array 32 byte))} key]
  (let [^{:tag (array 16 byte)} tmp (zero (array 16 byte))]
    (Sum (addr tmp) m key)
    (== (subtle/ConstantTimeCompare (subslice tmp) (subslice mac)) 1)))











^{:go/end 54} (go/func New "New returns a new MAC computing an authentication\ntag of all data written to it with the given key.\nThis allows writing the message progressively instead\nof passing it as a single slice. Common users should use\nthe Sum function instead.\n\nThe key must be unique for each message, as authenticating\ntwo different messages with the same key allows an attacker\nto forge messages at will.\n" ^{:tag (* MAC)} [^{:tag (* (array 32 byte))} key]
  (let [m (addr (lit MAC))]
    (initialize key (addr ^{:go/via [mac macGeneric]} (.-macState m)))
    ^{:line 53} m))









(go/type MAC "MAC is an io.Writer computing an authentication tag\nof the data written to it.\n\nMAC cannot be used like common hash.Hash implementations,\nbecause using a poly1305 key twice breaks its security.\nTherefore writing data to a running MAC after calling\nSum or Verify causes it to panic.\n" (struct
    ^{:line 64} mac ; platform-dependent implementation

    ^{:line 66 :tag bool} finalized))



^{:go/end 70} (go/method Size "Size returns the number of bytes Sum will return.\n" ^int [^{:tag (* MAC)} h] TagSize)





^{:go/end 81} (go/method Write "Write adds more data to the running message authentication code.\nIt never returns an error.\n\nIt must not be called after the first call of Sum or Verify.\n" [^{:tag (* MAC)} h ^{:tag (slice byte)} p] :results [^int n ^error err]
  (when (.-finalized h)
    (panic "poly1305: write to MAC after Sum or Verify"))

  (.Write (.-mac h) p))




^{:go/end 90} (go/method Sum "Sum computes the authenticator of all data written to the\nmessage authentication code.\n" ^{:tag (slice byte)} [^{:tag (* MAC)} h ^{:tag (slice byte)} b]
  (let [^{:tag (array TagSize byte)} mac (zero (array TagSize byte))]
    (.Sum (.-mac h) (addr mac))
    (set! (.-finalized h) true)
    (append b (spread (subslice mac)))))




^{:go/end 99} (go/method Verify "Verify returns whether the authenticator of all data written to\nthe message authentication code matches the expected value.\n" ^bool [^{:tag (* MAC)} h ^{:tag (slice byte)} expected]
  (let [^{:tag (array TagSize byte)} mac (zero (array TagSize byte))]
    (.Sum (.-mac h) (addr mac))
    (set! (.-finalized h) true)
    (== (subtle/ConstantTimeCompare expected (subslice mac)) 1)))

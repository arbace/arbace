;; The code in this file implements stack trace walking for all architectures.
;; The most important fact about a given architecture is whether it uses a link register.
;; On systems with link registers, the prologue for a non-leaf function stores the
;; incoming value of LR at the bottom of the newly allocated stack frame.
;; On systems without link registers (x86), the architecture pushes a return PC during
;; the call instruction, so the return PC ends up above the stack frame.
;; In this file, the return PC is always called LR, no matter how it was found.

(go/const ^{:val true} usesLR (> sys/MinFrameSize 0))

(go/const



  ^{:line 31} [^{:val 50 :doc "tracebackInnerFrames is the number of innermost frames to print in a\nstack trace. The total maximum frames is tracebackInnerFrames +\ntracebackOuterFrames.\n"} tracebackInnerFrames 50]



  ^{:line 35} [^{:val 50 :doc "tracebackOuterFrames is the number of outermost frames to print in a\nstack trace.\n"} tracebackOuterFrames 50])



(go/type unwindFlags "unwindFlags control the behavior of various unwinders.\n" uint8)

(go/const












  ^{:line 54} [^{:tag unwindFlags :val 1 :doc "unwindPrintErrors indicates that if unwinding encounters an error, it\nshould print a message and stop without throwing. This is used for things\nlike stack printing, where it's better to get incomplete information than\nto crash. This is also used in situations where everything may not be\nstopped nicely and the stack walk may not be able to complete, such as\nduring profiling signals or during a crash.\n\nIf neither unwindPrintErrors or unwindSilentErrors are set, unwinding\nperforms extra consistency checks and throws on any error.\n\nNote that there are a small number of fatal situations that will throw\nregardless of unwindPrintErrors or unwindSilentErrors.\n"} unwindPrintErrors (<< 1 iota)]


  ^{:line 57} [^{:val 2 :doc "unwindSilentErrors silently ignores errors during unwinding.\n"} unwindSilentErrors]











  ^{:line 69} [^{:val 4 :doc "unwindTrap indicates that the initial PC and SP are from a trap, not a\nreturn PC from a call.\n\nThe unwindTrap flag is updated during unwinding. If set, frame.pc is the\naddress of a faulting instruction instead of the return address of a\ncall. It also means the liveness at pc may not be known.\n\nTODO: Distinguish frame.continpc, which is really the stack map PC, from\nthe actual continuation PC, which is computed differently depending on\nthis flag and a few other things.\n"} unwindTrap]




  ^{:line 74} [^{:val 8 :doc "unwindJumpStack indicates that, if the traceback is on a system stack, it\nshould resume tracing at the user stack when the system stack is\nexhausted.\n"} unwindJumpStack])





















(go/type unwinder "An unwinder iterates the physical stack frames of a Go sack.\n\nTypical use of an unwinder looks like:\n\n\tvar u unwinder\n\tfor u.init(gp, 0); u.valid(); u.next() {\n\t\t// ... use frame info in u ...\n\t}\n\nImplementation note: This is carefully structured to be pointer-free because\ntracebacks happen in places that disallow write barriers (e.g., signals).\nEven if this is stack-allocated, its pointer-receiver methods don't know that\ntheir receiver is on the stack, so they still emit write barriers. Here we\naddress that by carefully avoiding any pointers in this type. Another\napproach would be to split this into a mutable part that's passed by pointer\nbut contains no pointers itself and an immutable part that's passed and\nreturned by value and can contain pointers. We could potentially hide that\nwe're doing that in trivial methods that are inlined into the caller that has\nthe stack allocation, but that's fragile.\n" (struct


    ^{:line 99 :tag stkframe :doc "frame is the current physical stack frame, or all 0s if\nthere is no frame.\n"} frame




    ^{:line 104 :tag guintptr :doc "g is the G who's stack is being unwound. If the\nunwindJumpStack flag is set and the unwinder jumps stacks,\nthis will be different from the initial G.\n"} g



    ^{:line 108 :tag int :doc "cgoCtxt is the index into g.cgoCtxt of the next frame on the cgo stack.\nThe cgo stack is unwound in tandem with the Go stack as we find marker frames.\n"} cgoCtxt



    ^{:line 112 :tag abi/FuncID :doc "calleeFuncID is the function ID of the caller of the current\nframe.\n"} calleeFuncID



    ^{:line 116 :tag unwindFlags :doc "flags are the flags to this unwind. Some of these are updated as we\nunwind (see the flags documentation).\n"} flags))






^{:go/end 131} (go/method init "init initializes u to start unwinding gp's stack and positions the\niterator on gp's innermost frame. gp must not be the current G.\n\nA single unwinder can be reused for multiple unwinds.\n" [^{:tag (* unwinder)} u ^{:tag (* g)} gp ^unwindFlags flags]
  ;; Implementation note: This starts the iterator on the first frame and we
  ;; provide a "valid" method. Alternatively, this could start in a "before
  ;; the first frame" state and "next" could return whether it was able to
  ;; move to the next frame, but that's both more awkward to use in a "for"
  ;; loop and is harder to implement because we have to do things differently
  ;; for the first frame.
  (.initAt u (bit-not (conv uintptr 0)) (bit-not (conv uintptr 0)) (bit-not (conv uintptr 0)) gp flags))



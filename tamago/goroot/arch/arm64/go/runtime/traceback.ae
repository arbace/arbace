^{:go/end 520} (go/method next [^{:tag (* unwinder)} u]
  (let [frame (addr (.-frame u))
      ^{:line 447} f (.-fn frame)
      ^{:line 448} gp (.ptr (.-g u))]

    ;; Do not unwind past the bottom of the stack.

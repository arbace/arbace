^{:go/end 230} (go/method valid ^bool [^{:tag (* unwinder)} u]
  (!= (.-pc (.-frame u)) 0))























^{:go/end 439} (go/method resolveInternal "resolveInternal fills in u.frame based on u.frame.fn, pc, and sp.\n\ninnermost indicates that this is the first resolve on this stack. If\ninnermost is set, isSyscall indicates that the PC/SP was retrieved from\ngp.syscall*; this is otherwise ignored.\n\nOn entry, u.frame contains:\n  - fn is the running function.\n  - pc is the PC in the running function.\n  - sp is the stack pointer at that program counter.\n  - For the innermost frame on LR machines, lr is the program counter that called fn.\n\nOn return, u.frame contains:\n  - fp is the stack pointer of the caller.\n  - lr is the program counter that called fn.\n  - varp, argp, and continpc are populated for the current frame.\n\nIf fn is a stack-jumping function, resolveInternal can change the entire\nframe state to follow that stack jump.\n\nThis is internal to unwinder.\n" [^{:tag (* unwinder)} u ^bool innermost ^bool isSyscall]
  (let [frame (addr (.-frame u))
      ^{:line 255} gp (.ptr (.-g u))

      ^{:line 257} f (.-fn frame)]
    (when (== ^{:go/via [_func]} (.-pcsp f) 0)
      ;; No frame information, must be external function, like race support.
      ;; See golang.org/issue/13568.

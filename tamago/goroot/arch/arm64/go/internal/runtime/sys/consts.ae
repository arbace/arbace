(in-ns 'go.internal.runtime.sys) (go/file "consts.go" :imports [


    ^{:line 8} [goarch "internal/goarch"]
    ^{:line 9} [goos "internal/goos"]])





(go/const ^{:val 1 :doc "AIX and OpenBSD require a larger stack for syscalls.\nThe race build also needs more stack. See issue 54291.\nThis arithmetic must match that in cmd/internal/objabi/stack.go:stackGuardMultiplier.\n"} StackGuardMultiplier (+ 1 goos/IsAix goos/IsOpenbsd isRace))


(go/const ^{:val 65536 :doc "DefaultPhysPageSize is the default physical page size.\n"} DefaultPhysPageSize goarch/DefaultPhysPageSize)



(go/const ^{:val 4 :doc "PCQuantum is the minimal unit for a program counter (1 on x86, 4 on most other systems).\nThe various PC tables record PC deltas pre-divided by PCQuantum.\n"} PCQuantum goarch/PCQuantum)


(go/const ^{:val 8 :doc "Int64Align is the required alignment for a 64-bit integer (4 on 32-bit systems, 8 on 64-bit).\n"} Int64Align goarch/PtrSize)






(go/const ^{:val 8 :doc "MinFrameSize is the size of the system-reserved words at the bottom\nof a frame (just above the architectural stack pointer).\nIt is zero on x86 and PtrSize on most non-x86 (LR-based) systems.\nOn PowerPC it is larger, to cover three more reserved words:\nthe compiler word, the link editor word, and the TOC save word.\n"} MinFrameSize goarch/MinFrameSize)



(go/const ^{:val 16 :doc "StackAlign is the required alignment of the SP register.\nThe stack must be at least word aligned, but some architectures require more.\n"} StackAlign goarch/StackAlign)

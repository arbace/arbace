;; package goarch contains GOARCH-specific constants.
(in-ns 'go.internal.goarch) (go/file "goarch.go" :doc "package goarch contains GOARCH-specific constants.\n" :imports [])

;; The next line makes 'go generate' write the zgoarch*.go files with
;; per-arch information, including constants named $GOARCH for every
;; GOARCH. The constant is 1 on the current system, 0 otherwise; multiplying
;; by them is useful for defining GOARCH-specific constants.
;;
(go/directive "//go:generate go run gengoarch.go")



(go/type ArchFamilyType "ArchFamilyType represents a family of one or more related architectures.\nFor example, ppc64 and ppc64le are both members of the PPC64 family.\n" int)

(go/const
  ^{:line 20} [^{:tag ArchFamilyType :val 0} AMD64 iota]
  ^{:line 21} [^{:val 1} ARM]
  ^{:line 22} [^{:val 2} ARM64]
  ^{:line 23} [^{:val 3} I386]
  ^{:line 24} [^{:val 4} LOONG64]
  ^{:line 25} [^{:val 5} MIPS]
  ^{:line 26} [^{:val 6} MIPS64]
  ^{:line 27} [^{:val 7} PPC64]
  ^{:line 28} [^{:val 8} RISCV64]
  ^{:line 29} [^{:val 9} S390X]
  ^{:line 30} [^{:val 10} WASM])




(go/const ^{:val 8 :doc "PtrSize is the size of a pointer in bytes - unsafe.Sizeof(uintptr(0)) but as an ideal constant.\nIt is also the size of the machine's native word size (that is, 4 on 32-bit systems, 8 on 64-bit).\n"} PtrSize (<< 4 (>> (bit-not (conv uintptr 0)) 63)))


(go/const ^{:val 64 :doc "PtrBits is bit width of a pointer.\n"} PtrBits (* PtrSize 8))


(go/const ^{:tag ArchFamilyType :val 2 :doc "ArchFamily is the architecture family (AMD64, ARM, ...)\n"} ArchFamily _ArchFamily)


(go/const ^{:val false :doc "BigEndian reports whether the architecture is big-endian.\n"} BigEndian (== (bit-or IsArmbe IsArm64be IsMips IsMips64 IsPpc IsPpc64 IsS390 IsS390x IsSparc IsSparc64) 1))


(go/const ^{:val 65536 :doc "DefaultPhysPageSize is the default physical page size.\n"} DefaultPhysPageSize _DefaultPhysPageSize)



(go/const ^{:val 4 :doc "PCQuantum is the minimal unit for a program counter (1 on x86, 4 on most other systems).\nThe various PC tables record PC deltas pre-divided by PCQuantum.\n"} PCQuantum _PCQuantum)


(go/const ^{:val 8 :doc "Int64Align is the required alignment for a 64-bit integer (4 on 32-bit systems, 8 on 64-bit).\n"} Int64Align PtrSize)






(go/const ^{:val 8 :doc "MinFrameSize is the size of the system-reserved words at the bottom\nof a frame (just above the architectural stack pointer).\nIt is zero on x86 and PtrSize on most non-x86 (LR-based) systems.\nOn PowerPC it is larger, to cover three more reserved words:\nthe compiler word, the link editor word, and the TOC save word.\n"} MinFrameSize _MinFrameSize)



(go/const ^{:val 16 :doc "StackAlign is the required alignment of the SP register.\nThe stack must be at least word aligned, but some architectures require more.\n"} StackAlign _StackAlign)

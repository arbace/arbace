(ns go.image
  (:require [arbace.go :as go]))

(go/package image
  :path "image"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["format.go" "geom.go" "image.go" "names.go" "ycbcr.go"]
  :init-order [ErrFormat Black White Transparent Opaque]
  :positions :lines)

(load "image/format")
(load "image/geom")
(load "image/image")
(load "image/names")
(load "image/ycbcr")

^{:go/end 64} (go/func Register "Register makes a database driver available by the provided name.\nIf Register is called twice with the same name or if driver is nil,\nit panics.\n" [^string name ^driver/Driver driver]
  (.Lock driversMu)
  (defer (.Unlock driversMu))
  (when (== driver nil)
    (panic "sql: Register driver is nil"))

  (when [(values _ dup) (aget drivers name)] dup
    (panic (+ "sql: Register called twice for driver " name)))

  (aset drivers name driver))



(in-ns 'go.database.sql) (go/file "ctxutil.go" :imports [


    ^{:line 8} [context "context"]
    ^{:line 9} [driver "database/sql/driver"]
    ^{:line 10} [errors "errors"]])


^{:go/end 27} (go/func ctxDriverPrepare [^context/Context ctx ^driver/Conn ci ^string query] :results [driver/Stmt error]
  (when [(values ciCtx is) (assert driver/ConnPrepareContext ci)] is
    (return (.PrepareContext ciCtx ctx query)))

  (let [(values si err) (.Prepare ci query)]
    (when (== err nil)
      (select
        (default)
        (case (<! (.Done ctx))
          (.Close si)
          (return nil (.Err ctx)))))


    (return si err)))


^{:go/end 44} (go/func ctxDriverExec [^context/Context ctx ^driver/ExecerContext execerCtx ^driver/Execer execer ^string query ^{:tag (slice driver/NamedValue)} nvdargs] :results [driver/Result error]
  (when (!= execerCtx nil)
    (return (.ExecContext execerCtx ctx query nvdargs)))

  (let [(values dargs err) (namedValueToValue nvdargs)]
    (when (!= err nil)
      (return nil err))


    (select
      (default)
      (case (<! (.Done ctx))
        (return nil (.Err ctx))))

    (.Exec execer query dargs)))


^{:go/end 61} (go/func ctxDriverQuery [^context/Context ctx ^driver/QueryerContext queryerCtx ^driver/Queryer queryer ^string query ^{:tag (slice driver/NamedValue)} nvdargs] :results [driver/Rows error]
  (when (!= queryerCtx nil)
    (return (.QueryContext queryerCtx ctx query nvdargs)))

  (let [(values dargs err) (namedValueToValue nvdargs)]
    (when (!= err nil)
      (return nil err))


    (select
      (default)
      (case (<! (.Done ctx))
        (return nil (.Err ctx))))

    (.Query queryer query dargs)))


^{:go/end 78} (go/func ctxDriverStmtExec [^context/Context ctx ^driver/Stmt si ^{:tag (slice driver/NamedValue)} nvdargs] :results [driver/Result error]
  (when [(values siCtx is) (assert driver/StmtExecContext si)] is
    (return (.ExecContext siCtx ctx nvdargs)))

  (let [(values dargs err) (namedValueToValue nvdargs)]
    (when (!= err nil)
      (return nil err))


    (select
      (default)
      (case (<! (.Done ctx))
        (return nil (.Err ctx))))

    (.Exec si dargs)))


^{:go/end 95} (go/func ctxDriverStmtQuery [^context/Context ctx ^driver/Stmt si ^{:tag (slice driver/NamedValue)} nvdargs] :results [driver/Rows error]
  (when [(values siCtx is) (assert driver/StmtQueryContext si)] is
    (return (.QueryContext siCtx ctx nvdargs)))

  (let [(values dargs err) (namedValueToValue nvdargs)]
    (when (!= err nil)
      (return nil err))


    (select
      (default)
      (case (<! (.Done ctx))
        (return nil (.Err ctx))))

    (.Query si dargs)))


^{:go/end 135} (go/func ctxDriverBegin [^context/Context ctx ^{:tag (* TxOptions)} opts ^driver/Conn ci] :results [driver/Tx error]
  (when [(values ciCtx is) (assert driver/ConnBeginTx ci)] is
    (let [dopts (lit driver/TxOptions)]
      (when (!= opts nil)
        (set! (.-Isolation dopts) (conv driver/IsolationLevel (.-Isolation opts)))
        (set! (.-ReadOnly dopts) (.-ReadOnly opts)))

      (return (.BeginTx ciCtx ctx dopts))))


  (when (!= opts nil)
    ;; Check the transaction level. If the transaction level is non-default
    ;; then return an error here as the BeginTx driver value is not supported.
    (when (!= (.-Isolation opts) LevelDefault)
      (return nil (errors/New "sql: driver does not support non-default isolation level")))


    ;; If a read-only transaction is requested return an error as the
    ;; BeginTx driver value is not supported.
    (when (.-ReadOnly opts)
      (return nil (errors/New "sql: driver does not support read-only transactions"))))



  (when (== (.Done ctx) nil)
    (return (.Begin ci)))


  (let [(values txi err) (.Begin ci)]
    (when (== err nil)
      (select
        (default)
        (case (<! (.Done ctx))
          (.Rollback txi)
          (return nil (.Err ctx)))))


    (return txi err)))


^{:go/end 146} (go/func namedValueToValue [^{:tag (slice driver/NamedValue)} named] :results [(slice driver/Value) error]
  (let [dargs (make (slice driver/Value) (len named))]
    (range [n param named]
      (when (> (len (.-Name param)) 0)
        (return nil (errors/New "sql: driver does not support the use of Named Parameters")))

      (aset dargs n (.-Value param)))

    (return dargs nil)))

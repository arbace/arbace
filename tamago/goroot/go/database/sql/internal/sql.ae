;; Package internal contains internal symbols shared between
;; database/sql and database/sql/driver.
(in-ns 'go.database.sql.internal) (go/file "sql.go" :doc "Package internal contains internal symbols shared between\ndatabase/sql and database/sql/driver.\n" :imports [])




(go/type ScanContext "ScanContext is database/sql/driver.ScanContext.\nWe define it here so driver.ScanContext can be opaque to users but\nvisible to database/sql.\n" (struct
    ^{:line 13 :tag any} v))


^{:go/end 18} (go/func NewScanContext ^ScanContext [^any v]
  (lit ScanContext v))


^{:go/end 22} (go/func ScanContextValue ^any [^ScanContext c]
  (.-v c))

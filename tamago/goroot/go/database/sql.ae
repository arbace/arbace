(ns go.database.sql
  (:require [arbace.go :as go]))

(go/package sql
  :path "database/sql"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["closemu.go" "convert.go" "ctxutil.go" "sql.go"]
  :init-order [errNilPtr valuerReflectType drivers ["sql.go" 165 5] ErrNoRows connectionRequestQueueSize errDBClosed ErrConnDone ErrTxDone ["sql.go" 2595 2] ["sql.go" 2596 2] bypassRowsAwaitDone errRowsClosed errNoRows rowsCloseHook]
  :positions :lines)

(load "sql/closemu")
(load "sql/convert")
(load "sql/ctxutil")
(load "sql/sql")

^{:go/end 427} (go/func ScanWords "ScanWords is a split function for a [Scanner] that returns each\nspace-separated word of text, with surrounding spaces deleted. It will\nnever return an empty string. The definition of space is set by\nunicode.IsSpace.\n" [^{:tag (slice byte)} data ^bool atEOF] :results [^int advance ^{:tag (slice byte)} token ^error err]

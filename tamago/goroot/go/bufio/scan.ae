^{:go/end 302} (go/func ScanBytes "ScanBytes is a split function for a [Scanner] that returns each byte as a token.\n" [^{:tag (slice byte)} data ^bool atEOF] :results [^int advance ^{:tag (slice byte)} token ^error err]

^{:go/end 372} (go/func ScanLines "ScanLines is a split function for a [Scanner] that returns each line of\ntext, stripped of any trailing end-of-line marker. The returned line may\nbe empty. The end-of-line marker is one optional carriage return followed\nby one mandatory newline. In regular expression notation, it is `\\r?\\n`.\nThe last non-empty line of input will be returned even if it has no\nnewline.\n" [^{:tag (slice byte)} data ^bool atEOF] :results [^int advance ^{:tag (slice byte)} token ^error err]
  (when (and atEOF (== (len data) 0))
    (return 0 nil nil))

  (when [i (bytes/IndexByte data \newline)] (>= i 0)
    ;; We have a full newline-terminated line.
    (return (+ i 1) (dropCR (subslice data 0 i)) nil))

  ;; If we're at EOF, we have a final, non-terminated line. Return it.
  (when atEOF
    (return (len data) (dropCR data) nil))

  ;; Request more data.
  (return 0 nil nil))





^{:go/breaks [[7 396]] :go/end 397} (go/func isSpace "isSpace reports whether the character is a Unicode white space character.\nWe avoid dependency on the unicode package, but check validity of the implementation\nin the tests.\n" ^bool [^rune r]

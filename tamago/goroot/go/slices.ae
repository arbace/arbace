(ns go.slices
  (:require [arbace.go :as go]))

(go/package slices
  :path "slices"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["iter.go" "slices.go" "sort.go" "zsortanyfunc.go" "zsortordered.go"]
  :init-order []
  :positions :lines)

(load "slices/iter")
(load "slices/slices")
(load "slices/sort")
(load "slices/zsortanyfunc")
(load "slices/zsortordered")

(ns go.slices
  (:require [arbace.go :as go]))

(go/package slices
  :path "slices"
  :files ["iter.go" "slices.go" "sort.go" "zsortanyfunc.go" "zsortordered.go"]
  :positions :lines)

(load "slices/iter")
(load "slices/slices")
(load "slices/sort")
(load "slices/zsortanyfunc")
(load "slices/zsortordered")

(in-ns 'go.syscall) (go/file "timestruct.go" :build ["//go:build unix || (js && wasm) || wasip1 || tamago"] :imports [])


^{:go/end 10} (go/func TimespecToNsec "TimespecToNsec returns the time stored in ts as nanoseconds.\n" ^int64 [^Timespec ts] (.Nano ts))


^{:go/end 21} (go/func NsecToTimespec "NsecToTimespec converts a number of nanoseconds into a [Timespec].\n" ^Timespec [^int64 nsec]
  (let [sec (/ nsec 1.0E9)]
    (set! nsec (% nsec 1.0E9))
    (when (< nsec 0)
      (set! nsec + 1.0E9)
      (dec! sec))

    (setTimespec sec nsec)))



^{:go/end 24} (go/func TimevalToNsec "TimevalToNsec returns the time stored in tv as nanoseconds.\n" ^int64 [^Timeval tv] (.Nano tv))


^{:go/end 36} (go/func NsecToTimeval "NsecToTimeval converts a number of nanoseconds into a [Timeval].\n" ^Timeval [^int64 nsec]
  (set! nsec + 999) ; round up to microsecond
  (let [usec (/ (% nsec 1.0E9) 1000.0)
      ^{:line 30} sec (/ nsec 1.0E9)]
    (when (< usec 0)
      (set! usec + 1000000.0)
      (dec! sec))

    (setTimeval sec usec)))

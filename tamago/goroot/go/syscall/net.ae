(in-ns 'go.syscall) (go/file "net.go" :imports [])


(go/type RawConn "A RawConn is a raw network connection.\n" (interface




    (^{:doc "Control invokes f on the underlying connection's file\ndescriptor or handle.\nThe file descriptor fd is guaranteed to remain valid while\nf executes but not after f returns.\n"} Control ^error [^{:tag (func [^uintptr fd])} f])









    (^{:doc "Read invokes f on the underlying connection's file\ndescriptor or handle; f is expected to try to read from the\nfile descriptor.\nIf f returns true, Read returns. Otherwise Read blocks\nwaiting for the connection to be ready for reading and\ntries again repeatedly.\nThe file descriptor is guaranteed to remain valid while f\nexecutes but not after f returns.\n"} Read ^error [^{:tag (func [^uintptr fd] [^bool done])} f])


    (^{:doc "Write is like Read but for writing.\n"} Write ^error [^{:tag (func [^uintptr fd] [^bool done])} f])))




(go/type Conn "Conn is implemented by some types in the net and os packages to provide\naccess to the underlying file descriptor or handle.\n" (interface

    (^{:doc "SyscallConn returns a raw network connection.\n"} SyscallConn [] :results [RawConn error])))

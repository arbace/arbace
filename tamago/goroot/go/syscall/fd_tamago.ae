(go/type pipeFile "A pipeFile is an in-memory implementation of a pipe.\nThe byteq implementation is in net_tamago.go.\n" (struct
    ^{:line 219} defaultFileImpl
    ^{:line 220 :tag (* byteq)} rd
    ^{:line 221 :tag (* byteq)} wr))


^{:go/breaks [[5 231]] :go/end 232} (go/method close ^error [^{:tag (* pipeFile)} f]
  (when (!= (.-rd f) nil)
    ^{:go/via [queue]} (.close (.-rd f)))

  (when (!= (.-wr f) nil)
    ^{:go/via [queue]} (.close (.-wr f)))

  nil)


^{:go/end 243} (go/method read [^{:tag (* pipeFile)} f ^{:tag (slice byte)} b] :results [int error]
  (when (== (.-rd f) nil)
    (return 0 EINVAL))

  (let [(values n err) (.read (.-rd f) b 0)]
    (when (== err EAGAIN)
      (set! err nil))

    (return n err)))


^{:go/end 254} (go/method write [^{:tag (* pipeFile)} f ^{:tag (slice byte)} b] :results [int error]
  (when (== (.-wr f) nil)
    (return 0 EINVAL))

  (let [(values n err) (.write (.-wr f) b 0)]
    (when (== err EAGAIN)
      (set! err EPIPE))

    (return n err)))


^{:go/end 261} (go/func Pipe ^error [^{:tag (slice int)} fd]

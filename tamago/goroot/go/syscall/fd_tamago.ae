    (.pread (.-impl f) b offset)))


^{:go/end 194} (go/func Pwrite [^int fd ^{:tag (slice byte)} b ^int64 offset] :results [int error]
  (let [(values f err) (fdToFile fd)]
    (when (!= err nil)
      (return 0 err))

    (.pwrite (.-impl f) b offset)))


^{:go/end 202} (go/func Seek [^int fd ^int64 offset ^int whence] :results [int64 error]
  (let [(values f err) (fdToFile fd)]
    (when (!= err nil)

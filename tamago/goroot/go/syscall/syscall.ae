;; Package syscall contains an interface to the low-level operating system
;; primitives. The details vary depending on the underlying system, and
;; by default, godoc will display the syscall documentation for the current
;; system. If you want godoc to display syscall documentation for another
;; system, set $GOOS and $GOARCH to the desired system. For example, if
;; you want to view documentation for freebsd/arm on linux/amd64, set $GOOS
;; to freebsd and $GOARCH to arm.
;; The primary use of syscall is inside other packages that provide a more
;; portable interface to the system, such as "os", "time" and "net".  Use
;; those packages rather than this one if you can.
;; For details of the functions and data types in this package consult
;; the manuals for the appropriate operating system.
;; These calls return err == nil to indicate success; otherwise
;; err is an operating system error describing the failure.
;; On most systems, that error has type [Errno].
;;
;; NOTE: Most of the functions, types, and constants defined in
;; this package are also available in the [golang.org/x/sys] package.
;; That package has more system call support than this one,
;; and most new code should prefer that package where possible.
;; See https://golang.org/s/go1.4-syscall for more information.
(in-ns 'go.syscall) (go/file "syscall.go" :doc "Package syscall contains an interface to the low-level operating system\nprimitives. The details vary depending on the underlying system, and\nby default, godoc will display the syscall documentation for the current\nsystem. If you want godoc to display syscall documentation for another\nsystem, set $GOOS and $GOARCH to the desired system. For example, if\nyou want to view documentation for freebsd/arm on linux/amd64, set $GOOS\nto freebsd and $GOARCH to arm.\nThe primary use of syscall is inside other packages that provide a more\nportable interface to the system, such as \"os\", \"time\" and \"net\".  Use\nthose packages rather than this one if you can.\nFor details of the functions and data types in this package consult\nthe manuals for the appropriate operating system.\nThese calls return err == nil to indicate success; otherwise\nerr is an operating system error describing the failure.\nOn most systems, that error has type [Errno].\n\nNOTE: Most of the functions, types, and constants defined in\nthis package are also available in the [golang.org/x/sys] package.\nThat package has more system call support than this one,\nand most new code should prefer that package where possible.\nSee https://golang.org/s/go1.4-syscall for more information.\n" :imports [

    ^{:line 28} [bytealg "internal/bytealg"]])

(go/directive "//go:generate go run ./mksyscall_windows.go -systemdll -output zsyscall_windows.go syscall_windows.go security_windows.go")






^{:go/end 43} (go/func StringByteSlice "StringByteSlice converts a string to a NUL-terminated []byte,\nIf s contains a NUL byte this function panics instead of\nreturning an error.\n\nDeprecated: Use ByteSliceFromString instead.\n" ^{:tag (slice byte)} [^string s]
  (let [(values a err) (ByteSliceFromString s)]
    (when (!= err nil)
      (panic "syscall: string with NUL passed to StringByteSlice"))

    ^{:line 42} a))





^{:go/end 55} (go/func ByteSliceFromString "ByteSliceFromString returns a NUL-terminated slice of bytes\ncontaining the text of s. If s contains a NUL byte at any\nlocation, it returns (nil, [EINVAL]).\n" [^string s] :results [(slice byte) error]
  (when (!= (bytealg/IndexByteString s 0) -1)
    (return nil EINVAL))

  (let [a (make (slice byte) (+ (len s) 1))]
    (copy a s)
    (return a nil)))







^{:go/end 62} (go/func StringBytePtr "StringBytePtr returns a pointer to a NUL-terminated array of bytes.\nIf s contains a NUL byte this function panics instead of returning\nan error.\n\nDeprecated: Use [BytePtrFromString] instead.\n" ^{:tag (* byte)} [^string s] (addr (aget (StringByteSlice s) 0)))




^{:go/end 73} (go/func BytePtrFromString "BytePtrFromString returns a pointer to a NUL-terminated array of\nbytes containing the text of s. If s contains a NUL byte at any\nlocation, it returns (nil, [EINVAL]).\n" [^string s] :results [(* byte) error]
  (let [(values a err) (ByteSliceFromString s)]
    (when (!= err nil)
      (return nil err))

    (return (addr (aget a 0)) nil)))




(go/var ^{:tag uintptr :doc "Single-word zero for use when we need a valid pointer to 0 bytes.\nSee mksyscall.pl.\n"} _zero)


^{:go/end 82} (go/method Unix "Unix returns the time stored in ts as seconds plus nanoseconds.\n" [^{:tag (* Timespec)} ts] :results [^int64 sec ^int64 nsec]
  (return (conv int64 (.-Sec ts)) (conv int64 (.-Nsec ts))))



^{:go/end 87} (go/method Unix "Unix returns the time stored in tv as seconds plus nanoseconds.\n" [^{:tag (* Timeval)} tv] :results [^int64 sec ^int64 nsec]
  (return (conv int64 (.-Sec tv)) (* (conv int64 (.-Usec tv)) 1000)))



^{:go/end 92} (go/method Nano "Nano returns the time stored in ts as nanoseconds.\n" ^int64 [^{:tag (* Timespec)} ts]
  (+ (* (conv int64 (.-Sec ts)) 1.0E9) (conv int64 (.-Nsec ts))))



^{:go/end 97} (go/method Nano "Nano returns the time stored in tv as nanoseconds.\n" ^int64 [^{:tag (* Timeval)} tv]
  (+ (* (conv int64 (.-Sec tv)) 1.0E9) (* (conv int64 (.-Usec tv)) 1000)))


;; Getpagesize and Exit are provided by the runtime.

(go/func ^:extern Getpagesize ^int [])
(go/func ^:extern Exit [^int code])


(go/func ^:extern runtimeSetenv "runtimeSetenv and runtimeUnsetenv are provided by the runtime.\n" [^string k ^string v])
(go/func ^:extern runtimeUnsetenv [^string k])



(go/func ^:extern runtimeClearenv "runtimeClearenv is provided by the runtime (on platforms without\nclearenv(3), it is just a wrapper around runtimeUnsetenv).\n" [^{:tag (map string int)} env])

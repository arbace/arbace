(go/var "Do the interface allocations only once for common\nErrno values.\n"
  ^{:line 350} [^error errEAGAIN EAGAIN]
  ^{:line 351} [^error errEINVAL EINVAL]
  ^{:line 352} [^error errENOENT ENOENT])




^{:go/end 369} (go/func errnoErr "errnoErr returns common boxed Errno values, to prevent\nallocations at runtime.\n" ^error [^Errno e]
  (switch e
    (case [0]
      (return nil))
    (case [EAGAIN]
      (return errEAGAIN))
    (case [EINVAL]
      (return errEINVAL))
    (case [ENOENT]
      (return errENOENT)))

  ^{:line 368} e)



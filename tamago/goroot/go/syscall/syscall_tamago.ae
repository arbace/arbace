(go/type Errno "An Errno is an unsigned number describing an error condition.\nIt implements the error interface. The zero Errno is by convention\na non-error, so code to convert from Errno to error should use:\n\n\terr = nil\n\tif errno != 0 {\n\t\terr = errno\n\t}\n\nErrno values can be tested against error values using [errors.Is].\nFor example:\n\n\t_, _, err := syscall.Syscall(...)\n\tif errors.Is(err, fs.ErrNotExist) ...\n" uintptr)

^{:go/end 70} (go/method Error ^string [^Errno e]
  (when (and (<= 0 (conv int e)) (< (conv int e) (len errorstr)))
    (let [s (aget errorstr e)]
      (when (!= s "")
        (return s))))


  (+ "errno " (strconv/Itoa (conv int e))))


^{:go/breaks [[4 83]] :go/end 84} (go/method Is ^bool [^Errno e ^error target]
  (switch target
    (case [oserror/ErrPermission]
      (return (or (== e EACCES) (== e EPERM))))
    (case [oserror/ErrExist]
      (return (or (== e EEXIST) (== e ENOTEMPTY))))
    (case [oserror/ErrNotExist]
      (return (== e ENOENT)))
    (case [errorspkg/ErrUnsupported]
      (return (or (== e ENOSYS) (== e ENOTSUP) (== e EOPNOTSUPP)))))

  false)


^{:go/end 88} (go/method Temporary ^bool [^Errno e]
  (or (== e EINTR) (== e EMFILE) (.Timeout e)))


^{:go/end 92} (go/method Timeout ^bool [^Errno e]
  (or (== e EAGAIN) (== e EWOULDBLOCK) (== e ETIMEDOUT)))




(go/type Signal "A Signal is a number describing a process signal.\nIt implements the [os.Signal] interface.\n" int)

(go/const
  ^{:line 99} [^{:tag Signal :val 0} _ iota]
  ^{:line 100} [^{:val 1} SIGCHLD]
  ^{:line 101} [^{:val 2} SIGINT]
  ^{:line 102} [^{:val 3} SIGKILL]
  ^{:line 103} [^{:val 4} SIGTRAP]
  ^{:line 104} [^{:val 5} SIGQUIT]
  ^{:line 105} [^{:val 6} SIGTERM]
  ^{:line 106} [^{:val 7} SIGABRT]
  ^{:line 107} [^{:val 8} SIGIO])


^{:go/end 110} (go/method Signal [^Signal s])

^{:go/end 120} (go/method String ^string [^Signal s]
  (when (and (<= 0 s) (< (conv int s) (len signals)))
    (let [str (aget signals s)]
      (when (!= str "")
        (return str))))


  (+ "signal " (strconv/Itoa (conv int s))))


(go/var signals (lit (array ... string)))


^{:go/end 34} (go/func direntReclen [^{:tag (slice byte)} buf] :results [uint64 bool]
  (readInt buf (unsafe/Offsetof (.-Reclen (lit Dirent))) (unsafe/Sizeof (.-Reclen (lit Dirent)))))


^{:go/end 42} (go/func direntNamlen [^{:tag (slice byte)} buf] :results [uint64 bool]
  (let [(values reclen ok) (direntReclen buf)]
    (when (not ok)
      (return 0 false))

    (return (- reclen (conv uint64 (unsafe/Offsetof (.-Name (lit Dirent))))) true)))



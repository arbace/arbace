^{:go/end 1409} (go/func CutPrefix "CutPrefix returns s without the provided leading prefix byte slice\nand reports whether it found the prefix.\nIf s doesn't start with prefix, CutPrefix returns s, false.\nIf prefix is the empty byte slice, CutPrefix returns s, true.\n\nCutPrefix returns slices of the original slice s, not copies.\n" [^{:tag (slice byte)} s ^{:tag (slice byte)} prefix] :results [^{:tag (slice byte)} after ^bool found]
  (when (not (HasPrefix s prefix))
    (return s false))

  (return (subslice s (len prefix)) true))








^{:go/end 1422} (go/func CutSuffix "CutSuffix returns s without the provided ending suffix byte slice\nand reports whether it found the suffix.\nIf s doesn't end with suffix, CutSuffix returns s, false.\nIf suffix is the empty byte slice, CutSuffix returns s, true.\n\nCutSuffix returns slices of the original slice s, not copies.\n" [^{:tag (slice byte)} s ^{:tag (slice byte)} suffix] :results [^{:tag (slice byte)} before ^bool found]
  (when (not (HasSuffix s suffix))
    (return s false))

  (return (subslice s _ (- (len s) (len suffix))) true))








^{:go/end 1435} (go/func CutLast "CutLast slices s around the last instance of sep,\nreturning the text before and after sep.\nThe found result reports whether sep appears in s.\nIf sep does not appear in s, CutLast returns s, nil, false.\n\nCutLast returns slices of the original slice s, not copies.\n" [^{:tag (slice byte)} s ^{:tag (slice byte)} sep] :results [^{:tag (slice byte)} before ^{:tag (slice byte)} after ^bool found]
  (when [i (LastIndex s sep)] (>= i 0)
    (return (subslice s _ i) (subslice s (+ i (len sep))) true))

  (return s nil false))

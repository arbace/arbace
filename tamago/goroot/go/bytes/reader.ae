(in-ns 'go.bytes) (go/file "reader.go" :imports [


    ^{:line 8} [errors "errors"]
    ^{:line 9} [io "io"]
    ^{:line 10} [utf8 "unicode/utf8"]])







(go/type Reader "A Reader implements the [io.Reader], [io.ReaderAt], [io.WriterTo], [io.Seeker],\n[io.ByteScanner], and [io.RuneScanner] interfaces by reading from\na byte slice.\nUnlike a [Buffer], a Reader is read-only and supports seeking.\nThe zero value for Reader operates like a Reader of an empty slice.\n" (struct
    ^{:line 19 :tag (slice byte)} s
    ^{:line 20 :tag int64} i ; current reading index
    ^{:line 21 :tag int} prevRune)) ; index of previous rune; or < 0




^{:go/end 31} (go/method Len "Len returns the number of bytes of the unread portion of the\nslice.\n" ^int [^{:tag (* Reader)} r]
  (when (>= (.-i r) (conv int64 (len (.-s r))))
    (return 0))

  (conv int (- (conv int64 (len (.-s r))) (.-i r))))





^{:go/end 36} (go/method Size "Size returns the original length of the underlying byte slice.\nSize is the number of bytes available for reading via [Reader.ReadAt].\nThe result is unaffected by any method calls except [Reader.Reset].\n" ^int64 [^{:tag (* Reader)} r] (conv int64 (len (.-s r))))


^{:go/end 47} (go/method Read "Read implements the [io.Reader] interface.\n" [^{:tag (* Reader)} r ^{:tag (slice byte)} b] :results [^int n ^error err]
  (when (>= (.-i r) (conv int64 (len (.-s r))))
    (return 0 io/EOF))

  (set! (.-prevRune r) -1)
  (set! n (copy b (subslice (.-s r) (.-i r))))
  (set! (.-i r) + (conv int64 n))
  (return))



^{:go/end 63} (go/method ReadAt "ReadAt implements the [io.ReaderAt] interface.\n" [^{:tag (* Reader)} r ^{:tag (slice byte)} b ^int64 off] :results [^int n ^error err]
  ;; cannot modify state - see io.ReaderAt
  (when (< off 0)
    (return 0 (errors/New "bytes.Reader.ReadAt: negative offset")))

  (when (>= off (conv int64 (len (.-s r))))
    (return 0 io/EOF))

  (set! n (copy b (subslice (.-s r) off)))
  (when (< n (len b))
    (set! err io/EOF))

  (return))



^{:go/end 74} (go/method ReadByte "ReadByte implements the [io.ByteReader] interface.\n" [^{:tag (* Reader)} r] :results [byte error]
  (set! (.-prevRune r) -1)
  (when (>= (.-i r) (conv int64 (len (.-s r))))
    (return 0 io/EOF))

  (let [b (aget (.-s r) (.-i r))]
    (inc! (.-i r))
    (return b nil)))



^{:go/breaks [7] :go/end 84} (go/method UnreadByte "UnreadByte complements [Reader.ReadByte] in implementing the [io.ByteScanner] interface.\n" ^error [^{:tag (* Reader)} r]
  (when (<= (.-i r) 0)
    (return (errors/New "bytes.Reader.UnreadByte: at beginning of slice")))

  (set! (.-prevRune r) -1)
  (dec! (.-i r))
  nil)



^{:go/end 100} (go/method ReadRune "ReadRune implements the [io.RuneReader] interface.\n" [^{:tag (* Reader)} r] :results [^rune ch ^int size ^error err]
  (when (>= (.-i r) (conv int64 (len (.-s r))))
    (set! (.-prevRune r) -1)
    (return 0 0 io/EOF))

  (set! (.-prevRune r) (conv int (.-i r)))
  (when [c (aget (.-s r) (.-i r))] (< c utf8/RuneSelf)
    (inc! (.-i r))
    (return (conv rune c) 1 nil))

  (set! (values ch size) (utf8/DecodeRune (subslice (.-s r) (.-i r))))
  (set! (.-i r) + (conv int64 size))
  (return))



^{:go/breaks [8] :go/end 113} (go/method UnreadRune "UnreadRune complements [Reader.ReadRune] in implementing the [io.RuneScanner] interface.\n" ^error [^{:tag (* Reader)} r]
  (when (<= (.-i r) 0)
    (return (errors/New "bytes.Reader.UnreadRune: at beginning of slice")))

  (when (< (.-prevRune r) 0)
    (return (errors/New "bytes.Reader.UnreadRune: previous operation was not ReadRune")))

  (set! (.-i r) (conv int64 (.-prevRune r)))
  (set! (.-prevRune r) -1)
  nil)



^{:go/end 134} (go/method Seek "Seek implements the [io.Seeker] interface.\n" [^{:tag (* Reader)} r ^int64 offset ^int whence] :results [int64 error]
  (set! (.-prevRune r) -1)
  (let [^int64 abs (zero int64)]
    (switch whence
      (case [io/SeekStart]
        (set! abs offset))
      (case [io/SeekCurrent]
        (set! abs (+ (.-i r) offset)))
      (case [io/SeekEnd]
        (set! abs (+ (conv int64 (len (.-s r))) offset)))
      (default
        (return 0 (errors/New "bytes.Reader.Seek: invalid whence"))))

    (when (< abs 0)
      (return 0 (errors/New "bytes.Reader.Seek: negative position")))

    (set! (.-i r) abs)
    (return abs nil)))



^{:go/end 153} (go/method WriteTo "WriteTo implements the [io.WriterTo] interface.\n" [^{:tag (* Reader)} r ^io/Writer w] :results [^int64 n ^error err]
  (set! (.-prevRune r) -1)
  (when (>= (.-i r) (conv int64 (len (.-s r))))
    (return 0 nil))

  (let [b (subslice (.-s r) (.-i r))
      (values m ^:assign err) (.Write w b)]
    (when (> m (len b))
      (panic "bytes.Reader.WriteTo: invalid Write count"))

    (set! (.-i r) + (conv int64 m))
    (set! n (conv int64 m))
    (when (and (!= m (len b)) (== err nil))
      (set! err io/ErrShortWrite))

    (return)))



^{:go/end 156} (go/method Reset "Reset resets the [Reader] to be reading from b.\n" [^{:tag (* Reader)} r ^{:tag (slice byte)} b] (set! @r (lit Reader b 0 -1)))


^{:go/end 159} (go/func NewReader "NewReader returns a new [Reader] reading from b.\n" ^{:tag (* Reader)} [^{:tag (slice byte)} b] (addr (lit Reader b 0 -1)))

(go/type Buffer "A Buffer is a variable-sized buffer of bytes with [Buffer.Read] and [Buffer.Write] methods.\nThe zero value for Buffer is an empty buffer ready to use.\n" (struct
    ^{:line 21 :tag (slice byte)} buf ; contents are the bytes buf[off : len(buf)]
    ^{:line 22 :tag int} off ; read at &buf[off], write at &buf[len(buf)]
    ^{:line 23 :tag readOp} lastRead)) ; last read operation, so that Unread* can work correctly.

;; Copying and modifying a non-zero Buffer is prone to error,
;; but we cannot employ the noCopy trick used by WaitGroup and Mutex,
;; which causes vet's copylocks checker to report misuse, as vet
;; cannot reliably distinguish the zero and non-zero cases.
;; See #26462, #25907, #47276, #48398 for history.






(go/type readOp "The readOp constants describe the last action performed on\nthe buffer, so that UnreadRune and UnreadByte can check for\ninvalid usage. opReadRuneX constants are chosen such that\nconverted to int they correspond to the rune size that was read.\n" int8)



(go/const "Don't use iota for these, as the values need to correspond with the\nnames and comments, which is easier to see when being explicit.\n"
  ^{:line 41} [^{:tag readOp :val -1} opRead -1] ; Any other read operation.
  ^{:line 42} [^{:tag readOp :val 0} opInvalid 0] ; Non-read operation.
  ^{:line 43} [^{:tag readOp :val 1} opReadRune1 1] ; Read rune of size 1.
  ^{:line 44} [^{:tag readOp :val 2} opReadRune2 2] ; Read rune of size 2.
  ^{:line 45} [^{:tag readOp :val 3} opReadRune3 3] ; Read rune of size 3.
  ^{:line 46} [^{:tag readOp :val 4} opReadRune4 4]) ; Read rune of size 4.




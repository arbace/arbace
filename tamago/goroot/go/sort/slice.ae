(in-ns 'go.sort) (go/file "slice.go" :imports [


    ^{:line 8} [reflectlite "internal/reflectlite"]
    ^{:line 9} [bits "math/bits"]])














^{:go/end 30} (go/func Slice "Slice sorts the slice x given the provided less function.\nIt panics if x is not a slice.\n\nThe sort is not guaranteed to be stable: equal elements\nmay be reversed from their original order.\nFor a stable sort, use [SliceStable].\n\nThe less function must satisfy the same requirements as\nthe Interface type's Less method.\n\nNote: in many situations, the newer [slices.SortFunc] function is more\nergonomic and runs faster.\n" [^any x ^{:tag (func [^int i ^int j] [bool])} less]
  (let [rv (reflectlite/ValueOf x)
      ^{:line 26} swap (reflectlite/Swapper x)
      ^{:line 27} length (.Len rv)
      ^{:line 28} limit (bits/Len (conv uint length))]
    (pdqsort_func (lit lessSwap less swap) 0 length limit)))











^{:go/end 45} (go/func SliceStable "SliceStable sorts the slice x using the provided less\nfunction, keeping equal elements in their original order.\nIt panics if x is not a slice.\n\nThe less function must satisfy the same requirements as\nthe Interface type's Less method.\n\nNote: in many situations, the newer [slices.SortStableFunc] function is more\nergonomic and runs faster.\n" [^any x ^{:tag (func [^int i ^int j] [bool])} less]
  (let [rv (reflectlite/ValueOf x)
      ^{:line 43} swap (reflectlite/Swapper x)]
    (stable_func (lit lessSwap less swap) (.Len rv))))







^{:go/end 61} (go/func SliceIsSorted "SliceIsSorted reports whether the slice x is sorted according to the provided less function.\nIt panics if x is not a slice.\n\nNote: in many situations, the newer [slices.IsSortedFunc] function is more\nergonomic and runs faster.\n" ^bool [^any x ^{:tag (func [^int i ^int j] [bool])} less]
  ^{:go/breaks [[3 60]]} (let [rv (reflectlite/ValueOf x)
      ^{:line 54} n (.Len rv)]
    (for [i (- n 1)] (> i 0) (dec! i)
      (when (less i (- i 1))
        (return false)))


    true))

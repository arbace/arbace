;; Package sort provides primitives for sorting slices and user-defined collections.
(in-ns 'go.sort) (go/file "sort.go" :directives ["//go:generate go run gen_sort_variants.go"] :doc "Package sort provides primitives for sorting slices and user-defined collections.\n" :imports [


    ^{:line 11} [bits "math/bits"]
    ^{:line 12} [slices "slices"]])




(go/type Interface "An implementation of Interface can be sorted by the routines in this package.\nThe methods refer to elements of the underlying collection by integer index.\n" (interface

    (^{:doc "Len is the number of elements in the collection.\n"} Len ^int [])


















    (^{:doc "Less reports whether the element with index i\nmust sort before the element with index j.\n\nIf both Less(i, j) and Less(j, i) are false,\nthen the elements at index i and j are considered equal.\nSort may place equal elements in any order in the final result,\nwhile Stable preserves the original input order of equal elements.\n\nLess must describe a [Strict Weak Ordering]. For example:\n - if both Less(i, j) and Less(j, k) are true, then Less(i, k) must be true as well.\n - if both Less(i, j) and Less(j, k) are false, then Less(i, k) must be false as well.\n\nNote that floating-point comparison (the < operator on float32 or float64 values)\nis not a strict weak ordering when not-a-number (NaN) values are involved.\nSee Float64Slice.Less for a correct implementation for floating-point values.\n\n[Strict Weak Ordering]: https://en.wikipedia.org/wiki/Weak_ordering#Strict_weak_orderings\n"} Less ^bool [^int i ^int j])


    (^{:doc "Swap swaps the elements with indexes i and j.\n"} Swap [^int i ^int j])))








^{:go/end 57} (go/func Sort "Sort sorts data in ascending order as determined by the Less method.\nIt makes one call to data.Len to determine n and O(n*log(n)) calls to\ndata.Less and data.Swap. The sort is not guaranteed to be stable.\n\nNote: in many situations, the newer [slices.SortFunc] function is more\nergonomic and runs faster.\n" [^Interface data]
  (let [n (.Len data)]
    (when (<= n 1)
      (return))

    (let [limit (bits/Len (conv uint n))]
      (pdqsort data 0 n limit))))


(go/type sortedHint int) ; hint for pdqsort when choosing the pivot

(go/const
  ^{:line 62} [^{:tag sortedHint :val 0} unknownHint iota]
  ^{:line 63} [^{:val 1} increasingHint]
  ^{:line 64} [^{:val 2} decreasingHint])



(go/type xorshift "xorshift paper: https://www.jstatsoft.org/article/view/v008i14/xorshift.pdf\n" uint64)

^{:go/end 75} (go/method Next ^uint64 [^{:tag (* xorshift)} r]
  (set! @r bit-xor (<< @r 13))
  (set! @r bit-xor (>> @r 7))
  (set! @r bit-xor (<< @r 17))
  (conv uint64 @r))


^{:go/end 80} (go/func nextPowerOfTwo ^uint [^int length]
  (let [shift (conv uint (bits/Len (conv uint length)))]
    (conv uint ^uint (<< 1 shift))))





(go/type lessSwap "lessSwap is a pair of Less and Swap function for use with the\nauto-generated func-optimized variant of sort.go in\nzfuncversion.go.\n" (struct
    ^{:line 86 :tag (func [^int i ^int j] [bool])} Less
    ^{:line 87 :tag (func [^int i ^int j])} Swap))


(go/type reverse (struct


    ^{:line 93 :doc "This embedded Interface permits Reverse to use the methods of\nanother Interface implementation.\n"} Interface))



^{:go/end 99} (go/method Less "Less returns the opposite of the embedded implementation's Less method.\n" ^bool [^reverse r ^int i ^int j]
  (.Less (.-Interface r) j i))



^{:go/end 104} (go/func Reverse "Reverse returns the reverse order for data.\n" ^Interface [^Interface data]
  (addr (lit reverse data)))






^{:go/end 118} (go/func IsSorted "IsSorted reports whether data is sorted.\n\nNote: in many situations, the newer [slices.IsSortedFunc] function is more\nergonomic and runs faster.\n" ^bool [^Interface data]
  ^{:go/breaks [[3 117]]} (let [n (.Len data)]
    (for [i (- n 1)] (> i 0) (dec! i)
      (when (.Less data i (- i 1))
        (return false)))


    true))


;; Convenience types for common cases


(go/type IntSlice "IntSlice attaches the methods of Interface to []int, sorting in increasing order.\n" (slice int))

^{:go/end 125} (go/method Len ^int [^IntSlice x] (len x))
^{:go/end 126} (go/method Less ^bool [^IntSlice x ^int i ^int j] (< (aget x i) (aget x j)))
^{:go/end 127} (go/method Swap [^IntSlice x ^int i ^int j] (set! (values (aget x i) (aget x j)) (values (aget x j) (aget x i))))


^{:go/end 130} (go/method Sort "Sort is a convenience method: x.Sort() calls Sort(x).\n" [^IntSlice x] (Sort x))



(go/type Float64Slice "Float64Slice implements Interface for a []float64, sorting in increasing order,\nwith not-a-number (NaN) values ordered before other values.\n" (slice float64))

^{:go/end 136} (go/method Len ^int [^Float64Slice x] (len x))







^{:go/end 144} (go/method Less "Less reports whether x[i] should be ordered before x[j], as required by the sort Interface.\nNote that floating-point comparison by itself is not a transitive relation: it does not\nreport a consistent ordering for not-a-number (NaN) values.\nThis implementation of Less places NaN values before any others, by using:\n\n\tx[i] < x[j] || (math.IsNaN(x[i]) && !math.IsNaN(x[j]))\n" ^bool [^Float64Slice x ^int i ^int j] (or (< (aget x i) (aget x j)) ^:go/paren (and (isNaN (aget x i)) (not (isNaN (aget x j))))))
^{:go/end 145} (go/method Swap [^Float64Slice x ^int i ^int j] (set! (values (aget x i) (aget x j)) (values (aget x j) (aget x i))))


^{:go/end 150} (go/func isNaN "isNaN is a copy of math.IsNaN to avoid a dependency on the math package.\n" ^bool [^float64 f]
  (!= f f))



^{:go/end 153} (go/method Sort "Sort is a convenience method: x.Sort() calls Sort(x).\n" [^Float64Slice x] (Sort x))


(go/type StringSlice "StringSlice attaches the methods of Interface to []string, sorting in increasing order.\n" (slice string))

^{:go/end 158} (go/method Len ^int [^StringSlice x] (len x))
^{:go/end 159} (go/method Less ^bool [^StringSlice x ^int i ^int j] (< (aget x i) (aget x j)))
^{:go/end 160} (go/method Swap [^StringSlice x ^int i ^int j] (set! (values (aget x i) (aget x j)) (values (aget x j) (aget x i))))


^{:go/end 163} (go/method Sort "Sort is a convenience method: x.Sort() calls Sort(x).\n" [^StringSlice x] (Sort x))

;; Convenience wrappers for common cases




^{:go/end 170} (go/func Ints "Ints sorts a slice of ints in increasing order.\n\nNote: as of Go 1.22, this function simply calls [slices.Sort].\n" [^{:tag (slice int)} x] (^{:inst [(slice int) int]} slices/Sort x))





^{:go/end 176} (go/func Float64s "Float64s sorts a slice of float64s in increasing order.\nNot-a-number (NaN) values are ordered before other values.\n\nNote: as of Go 1.22, this function simply calls [slices.Sort].\n" [^{:tag (slice float64)} x] (^{:inst [(slice float64) float64]} slices/Sort x))




^{:go/end 181} (go/func Strings "Strings sorts a slice of strings in increasing order.\n\nNote: as of Go 1.22, this function simply calls [slices.Sort].\n" [^{:tag (slice string)} x] (^{:inst [(slice string) string]} slices/Sort x))




^{:go/end 186} (go/func IntsAreSorted "IntsAreSorted reports whether the slice x is sorted in increasing order.\n\nNote: as of Go 1.22, this function simply calls [slices.IsSorted].\n" ^bool [^{:tag (slice int)} x] (^{:inst [(slice int) int]} slices/IsSorted x))





^{:go/end 192} (go/func Float64sAreSorted "Float64sAreSorted reports whether the slice x is sorted in increasing order,\nwith not-a-number (NaN) values before any other values.\n\nNote: as of Go 1.22, this function simply calls [slices.IsSorted].\n" ^bool [^{:tag (slice float64)} x] (^{:inst [(slice float64) float64]} slices/IsSorted x))




^{:go/end 197} (go/func StringsAreSorted "StringsAreSorted reports whether the slice x is sorted in increasing order.\n\nNote: as of Go 1.22, this function simply calls [slices.IsSorted].\n" ^bool [^{:tag (slice string)} x] (^{:inst [(slice string) string]} slices/IsSorted x))

;; Notes on stable sorting:
;; The used algorithms are simple and provably correct on all input and use
;; only logarithmic additional stack space. They perform well if compared
;; experimentally to other stable in-place sorting algorithms.
;;
;; Remarks on other algorithms evaluated:
;;  - GCC's 4.6.3 stable_sort with merge_without_buffer from libstdc++:
;;    Not faster.
;;  - GCC's __rotate for block rotations: Not faster.
;;  - "Practical in-place mergesort" from  Jyrki Katajainen, Tomi A. Pasanen
;;    and Jukka Teuhola; Nordic Journal of Computing 3,1 (1996), 27-40:
;;    The given algorithms are in-place, number of Swap and Assignments
;;    grow as n log n but the algorithm is not stable.
;;  - "Fast Stable In-Place Sorting with O(n) Data Moves" J.I. Munro and
;;    V. Raman in Algorithmica (1996) 16, 115-160:
;;    This algorithm either needs additional 2n bits or works only if there
;;    are enough different elements available to encode some permutations
;;    which have to be undone later (so not stable on any input).
;;  - All the optimal in-place sorting/merging algorithms I found are either
;;    unstable or rely on enough different elements in each step to encode the
;;    performed block rearrangements. See also "In-Place Merging Algorithms",
;;    Denham Coates-Evely, Department of Computer Science, Kings College,
;;    January 2004 and the references in there.
;;  - Often "optimal" algorithms are optimal in the number of assignments
;;    but Interface has only Swap as operation.









^{:go/end 235} (go/func Stable "Stable sorts data in ascending order as determined by the Less method,\nwhile keeping the original order of equal elements.\n\nIt makes one call to data.Len to determine n, O(n*log(n)) calls to\ndata.Less and O(n*log(n)*log(n)) calls to data.Swap.\n\nNote: in many situations, the newer slices.SortStableFunc function is more\nergonomic and runs faster.\n" [^Interface data]
  (stable data (.Len data)))


;; /*
;; Complexity of Stable Sorting
;; 
;; 
;; Complexity of block swapping rotation
;; 
;; Each Swap puts one new element into its correct, final position.
;; Elements which reach their final position are no longer moved.
;; Thus block swapping rotation needs |u|+|v| calls to Swaps.
;; This is best possible as each element might need a move.
;; 
;; Pay attention when comparing to other optimal algorithms which
;; typically count the number of assignments instead of swaps:
;; E.g. the optimal algorithm of Dudzinski and Dydek for in-place
;; rotations uses O(u + v + gcd(u,v)) assignments which is
;; better than our O(3 * (u+v)) as gcd(u,v) <= u.
;; 
;; 
;; Stable sorting by SymMerge and BlockSwap rotations
;; 
;; SymMerg complexity for same size input M = N:
;; Calls to Less:  O(M*log(N/M+1)) = O(N*log(2)) = O(N)
;; Calls to Swap:  O((M+N)*log(M)) = O(2*N*log(N)) = O(N*log(N))
;; 
;; (The following argument does not fuzz over a missing -1 or
;; other stuff which does not impact the final result).
;; 
;; Let n = data.Len(). Assume n = 2^k.
;; 
;; Plain merge sort performs log(n) = k iterations.
;; On iteration i the algorithm merges 2^(k-i) blocks, each of size 2^i.
;; 
;; Thus iteration i of merge sort performs:
;; Calls to Less  O(2^(k-i) * 2^i) = O(2^k) = O(2^log(n)) = O(n)
;; Calls to Swap  O(2^(k-i) * 2^i * log(2^i)) = O(2^k * i) = O(n*i)
;; 
;; In total k = log(n) iterations are performed; so in total:
;; Calls to Less O(log(n) * n)
;; Calls to Swap O(n + 2*n + 3*n + ... + (k-1)*n + k*n)
;; = O((k/2) * k * n) = O(n * k^2) = O(n * log^2(n))
;; 
;; 
;; Above results should generalize to arbitrary n = 2^k + p
;; and should not be influenced by the initial insertion sort phase:
;; Insertion sort is O(n^2) on Swap and Less, thus O(bs^2) per block of
;; size bs at n/bs blocks:  O(bs*n) Swaps and Less during insertion sort.
;; Merge sort iterations start at i = log(bs). With t = log(bs) constant:
;; Calls to Less O((log(n)-t) * n + bs*n) = O(log(n)*n + (bs-t)*n)
;; = O(n * log(n))
;; Calls to Swap O(n * log^2(n) - (t^2+t)/2*n) = O(n * log^2(n))
;; 
;; */

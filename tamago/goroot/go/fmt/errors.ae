^{:go/end 68} (go/func errorf "errorf formats and returns an error value, or nil if no formatting is required.\n" ^error [^string format & ^{:tag (slice any)} a]
  (when (and (== (len a) 0) (== (stringslite/IndexByte format \%) -1))

(ns go.strings
  (:require [arbace.go :as go]))

(go/package strings
  :path "strings"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["builder.go" "clone.go" "compare.go" "iter.go" "reader.go" "replace.go" "search.go" "strings.go"]
  :init-order [asciiSpace]
  :positions :lines)

(load "strings/builder")
(load "strings/clone")
(load "strings/compare")
(load "strings/iter")
(load "strings/reader")
(load "strings/replace")
(load "strings/search")
(load "strings/strings")

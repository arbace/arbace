(ns go.regexp
  (:require [arbace.go :as go]))

(go/package regexp
  :path "regexp"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["backtrack.go" "exec.go" "onepass.go" "regexp.go"]
  :init-order [noRune noNext anyRuneNotNL anyRune matchSize]
  :positions :lines)

(load "regexp/backtrack")
(load "regexp/exec")
(load "regexp/onepass")
(load "regexp/regexp")

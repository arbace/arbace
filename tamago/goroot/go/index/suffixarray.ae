(ns go.index.suffixarray
  (:require [arbace.go :as go]))

(go/package suffixarray
  :path "index/suffixarray"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["sais.go" "sais2.go" "suffixarray.go"]
  :init-order [maxData32 errCorrupted]
  :positions :lines)

(load "suffixarray/sais")
(load "suffixarray/sais2")
(load "suffixarray/suffixarray")

(ns go.hash.crc32
  (:require [arbace.go :as go]))

(go/package crc32
  :path "hash/crc32"
  :files ["crc32.go" "crc32_amd64.go" "crc32_arm64.go" "crc32_generic.go" "gen.go"]
  :other-files ["crc32_amd64.s" "crc32_arm64.s"]
  :positions :lines)

(load "crc32/crc32")
(load "crc32/crc32_amd64")
(load "crc32/crc32_arm64")
(load "crc32/crc32_generic")
(load "crc32/gen")

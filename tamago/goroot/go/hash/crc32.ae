(ns go.hash.crc32
  (:require [arbace.go :as go]))

(go/package crc32
  :path "hash/crc32"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["crc32.go" "crc32_amd64.go" "crc32_generic.go" "gen.go"]
  :other-files ["crc32_amd64.s"]
  :init-order [IEEETable castagnoliInitOnce ieeeInitOnce]
  :positions :lines)

(load "crc32/crc32")
(load "crc32/crc32_amd64")
(load "crc32/crc32_generic")
(load "crc32/gen")

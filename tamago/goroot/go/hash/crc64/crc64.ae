            (aget (aget helperTable 5) (bit-and (>> crc 16) 0xff))
            (aget (aget helperTable 4) (bit-and (>> crc 24) 0xff))
            (aget (aget helperTable 3) (bit-and (>> crc 32) 0xff))
            (aget (aget helperTable 2) (bit-and (>> crc 40) 0xff))
            (aget (aget helperTable 1) (bit-and (>> crc 48) 0xff))

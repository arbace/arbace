^{:go/end 178} (go/func update ^uint64 [^uint64 crc ^{:tag (* Table)} tab ^{:tag (slice byte)} p]
  (buildSlicing8TablesOnce)
  (set! crc (bit-not crc))
  ;; Table comparison is somewhat expensive, so avoid it for small sizes
  (while (>= (len p) 64)

;; Package hash provides interfaces for hash functions.
(in-ns 'go.hash) (go/file "hash.go" :doc "Package hash provides interfaces for hash functions.\n" :imports [

    ^{:line 8} [io "io"]])

















(go/type Hash "Hash is the common interface implemented by all hash functions.\n\nHash implementations in the standard library (e.g. [hash/crc32] and\n[crypto/sha256]) implement the [encoding.BinaryMarshaler], [encoding.BinaryAppender],\n[encoding.BinaryUnmarshaler] and [Cloner] interfaces. Marshaling a hash implementation\nallows its internal state to be saved and used for additional processing\nlater, without having to re-write the data previously written to the hash.\nThe hash state may contain portions of the input in its original form,\nwhich users are expected to handle for any possible security implications.\n\nCompatibility: Any future changes to hash or crypto packages will endeavor\nto maintain compatibility with state encoded using previous versions.\nThat is, any released versions of the packages should be able to\ndecode data written with any previously released version,\nsubject to issues such as security fixes.\nSee the Go compatibility document for background: https://golang.org/doc/go1compat\n" (interface


    ^{:line 29 :doc "Write (via the embedded io.Writer interface) adds more data to the running hash.\nIt never returns an error.\n"} io/Writer



    (^{:doc "Sum appends the current hash to b and returns the resulting slice.\nIt does not change the underlying hash state.\n"} Sum ^{:tag (slice byte)} [^{:tag (slice byte)} b])


    (^{:doc "Reset resets the Hash to its initial state.\n"} Reset [])


    (^{:doc "Size returns the number of bytes Sum will return.\n"} Size ^int [])





    (^{:doc "BlockSize returns the hash's underlying block size.\nThe Write method must be able to accept any amount\nof data, but it may operate more efficiently if all writes\nare a multiple of the block size.\n"} BlockSize ^int [])))



(go/type Hash32 "Hash32 is the common interface implemented by all 32-bit hash functions.\n" (interface
    ^{:line 50} Hash
    (Sum32 ^uint32 [])))



(go/type Hash64 "Hash64 is the common interface implemented by all 64-bit hash functions.\n" (interface
    ^{:line 56} Hash
    (Sum64 ^uint64 [])))











(go/type Cloner "A Cloner is a hash function whose state can be cloned, returning a value with\nequivalent and independent state.\n\nAll [Hash] implementations in the standard library implement this interface,\nunless GOFIPS140=v1.0.0 is set.\n\nIf a hash can only determine at runtime if it can be cloned (e.g. if it wraps\nanother hash), Clone may return an error wrapping [errors.ErrUnsupported].\nOtherwise, Clone must always return a nil error.\n" (interface
    ^{:line 70} Hash
    (Clone [] :results [Cloner error])))



(go/type XOF "XOF (extendable output function) is a hash function with arbitrary or unlimited output length.\n" (interface


    ^{:line 78 :doc "Write absorbs more data into the XOF's state. It panics if called\nafter Read.\n"} io/Writer



    ^{:line 82 :doc "Read reads more output from the XOF. It may return io.EOF if there\nis a limit to the XOF output length.\n"} io/Reader


    (^{:doc "Reset resets the XOF to its initial state.\n"} Reset [])





    (^{:doc "BlockSize returns the XOF's underlying block size.\nThe Write method must be able to accept any amount\nof data, but it may operate more efficiently if all writes\nare a multiple of the block size.\n"} BlockSize ^int [])))

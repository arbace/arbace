;; ARM64-specific hardware-assisted CRC32 algorithms. See crc32.go for a
;; description of the interface that each architecture-specific file
;; implements.

(in-ns 'go.hash.crc32) (go/file "crc32_arm64.go" :imports [

    ^{:line 11} [cpu "internal/cpu"]])

(go/func ^:extern castagnoliUpdate ^uint32 [^uint32 crc ^{:tag (slice byte)} p])
(go/func ^:extern ieeeUpdate ^uint32 [^uint32 crc ^{:tag (slice byte)} p])

^{:go/end 18} (go/func archAvailableCastagnoli ^bool []
  (.-HasCRC32 cpu/ARM64))


^{:go/end 24} (go/func archInitCastagnoli []
  (when (not (.-HasCRC32 cpu/ARM64))
    (panic "arch-specific crc32 instruction for Castagnoli not available")))



^{:go/end 32} (go/func archUpdateCastagnoli ^uint32 [^uint32 crc ^{:tag (slice byte)} p]
  (when (not (.-HasCRC32 cpu/ARM64))
    (panic "arch-specific crc32 instruction for Castagnoli not available"))


  (bit-not (castagnoliUpdate (bit-not crc) p)))


^{:go/end 36} (go/func archAvailableIEEE ^bool []
  (.-HasCRC32 cpu/ARM64))


^{:go/end 42} (go/func archInitIEEE []
  (when (not (.-HasCRC32 cpu/ARM64))
    (panic "arch-specific crc32 instruction for IEEE not available")))



^{:go/end 50} (go/func archUpdateIEEE ^uint32 [^uint32 crc ^{:tag (slice byte)} p]
  (when (not (.-HasCRC32 cpu/ARM64))
    (panic "arch-specific crc32 instruction for IEEE not available"))


  (bit-not (ieeeUpdate (bit-not crc) p)))

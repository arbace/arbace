  ^{:line 40} [^{:val 3945912366 :doc "Koopman's polynomial.\nAlso has better error detection characteristics than IEEE.\nhttps://dx.doi.org/10.1109/DSN.2002.1028931\n"} Koopman 0xeb31d82e])



(go/type Table "Table is a 256-word table representing the polynomial for efficient processing.\n" (array 256 uint32))

;; This file makes use of functions implemented in architecture-specific files.
;; The interface that they implement is as follows:
;;
;;    // archAvailableIEEE reports whether an architecture-specific CRC32-IEEE
;;    // algorithm is available.
;;    archAvailableIEEE() bool
;;
;;    // archInitIEEE initializes the architecture-specific CRC3-IEEE algorithm.
;;    // It can only be called if archAvailableIEEE() returns true.
;;    archInitIEEE()
;;
;;    // archUpdateIEEE updates the given CRC32-IEEE. It can only be called if
;;    // archInitIEEE() was previously called.
;;    archUpdateIEEE(crc uint32, p []byte) uint32
;;
;;    // archAvailableCastagnoli reports whether an architecture-specific
;;    // CRC32-C algorithm is available.
;;    archAvailableCastagnoli() bool
;;
;;    // archInitCastagnoli initializes the architecture-specific CRC32-C
;;    // algorithm. It can only be called if archAvailableCastagnoli() returns
;;    // true.
;;    archInitCastagnoli()
;;
;;    // archUpdateCastagnoli updates the given CRC32-C. It can only be called
;;    // if archInitCastagnoli() was previously called.
;;    archUpdateCastagnoli(crc uint32, p []byte) uint32





(go/var ^{:tag (* Table) :doc "castagnoliTable points to a lazily initialized Table for the Castagnoli\npolynomial. MakeTable will always return this value when asked to make a\nCastagnoli table so we can compare against it to find when the caller is\nusing this polynomial.\n"} castagnoliTable)
(go/var ^{:tag (* slicing8Table)} castagnoliTable8)
(go/var ^{:tag (func [^uint32 crc ^{:tag (slice byte)} p] [uint32])} updateCastagnoli)
(go/var ^atomic/Bool haveCastagnoli)

(go/var castagnoliInitOnce (sync/OnceFunc ^{:go/end 98} (fn []
      (set! castagnoliTable (simpleMakeTable Castagnoli))

      (if (archAvailableCastagnoli) (do
          (archInitCastagnoli)
          (set! updateCastagnoli archUpdateCastagnoli))
        (do
          ;; Initialize the slicing-by-8 table.
          (set! castagnoliTable8 (slicingMakeTable Castagnoli))
          (set! updateCastagnoli ^{:go/end 94} (fn ^uint32 [^uint32 crc ^{:tag (slice byte)} p]
              (slicingUpdate crc castagnoliTable8 p)))))



      (.Store haveCastagnoli true))))



(go/var ^{:doc "IEEETable is the table for the [IEEE] polynomial.\n"} IEEETable (simpleMakeTable IEEE))


(go/var ^{:tag (* slicing8Table) :doc "ieeeTable8 is the slicing8Table for IEEE\n"} ieeeTable8)
(go/var ^{:tag (func [^uint32 crc ^{:tag (slice byte)} p] [uint32])} updateIEEE)

(go/var ieeeInitOnce (sync/OnceFunc ^{:go/end 118} (fn []
      (if (archAvailableIEEE) (do
          (archInitIEEE)
          (set! updateIEEE archUpdateIEEE))
        (do
          ;; Initialize the slicing-by-8 table.
          (set! ieeeTable8 (slicingMakeTable IEEE))
          (set! updateIEEE ^{:go/end 116} (fn ^uint32 [^uint32 crc ^{:tag (slice byte)} p]
              (slicingUpdate crc ieeeTable8 p))))))))






^{:go/end 133} (go/func MakeTable "MakeTable returns a [Table] constructed from the specified polynomial.\nThe contents of this [Table] must not be modified.\n" ^{:tag (* Table)} [^uint32 poly]
  (switch poly
    (case [IEEE]
      (ieeeInitOnce)
      (return IEEETable))
    (case [Castagnoli]
      (castagnoliInitOnce)
      (return castagnoliTable))
    (default
      (return (simpleMakeTable poly)))))





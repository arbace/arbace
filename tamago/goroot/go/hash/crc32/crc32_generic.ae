;; This file contains CRC32 algorithms that are not specific to any architecture
;; and don't use hardware acceleration.
;;
;; The simple (and slow) CRC32 implementation only uses a 256*4 bytes table.
;;
;; The slicing-by-8 algorithm is a faster implementation that uses a bigger
;; table (8*256*4 bytes).

(in-ns 'go.hash.crc32) (go/file "crc32_generic.go" :imports [

    ^{:line 15} [byteorder "internal/byteorder"]])




^{:go/end 24} (go/func simpleMakeTable "simpleMakeTable allocates and constructs a Table for the specified\npolynomial. The table is suitable for use with the simple algorithm\n(simpleUpdate).\n" ^{:tag (* Table)} [^uint32 poly]
  (let [t (new Table)]
    (simplePopulateTable poly t)
    ^{:line 23} t))




^{:go/end 40} (go/func simplePopulateTable "simplePopulateTable constructs a Table for the specified polynomial, suitable\nfor use with simpleUpdate.\n" [^uint32 poly ^{:tag (* Table)} t]
  (for [i 0] (< i 256) (inc! i)
    (let [crc (conv uint32 i)]
      (for [j 0] (< j 8) (inc! j)
        (if (== (bit-and crc 1) 1)
          (set! crc (bit-xor (>> crc 1) poly))

          (set! crc >> 1)))


      (aset t i crc))))





^{:go/end 50} (go/func simpleUpdate "simpleUpdate uses the simple algorithm to update the CRC, given a table that\nwas previously computed using simpleMakeTable.\n" ^uint32 [^uint32 crc ^{:tag (* Table)} tab ^{:tag (slice byte)} p]
  (set! crc (bit-not crc))
  (range [_ v p]
    (set! crc (bit-xor (aget tab (bit-xor (conv byte crc) v)) (>> crc 8))))

  (bit-not crc))



(go/const ^{:val 16 :doc "Use slicing-by-8 when payload >= this value.\n"} slicing8Cutoff 16)


(go/type slicing8Table "slicing8Table is array of 8 Tables, used by the slicing-by-8 algorithm.\n" (array 8 Table))



^{:go/end 71} (go/func slicingMakeTable "slicingMakeTable constructs a slicing8Table for the specified polynomial. The\ntable is suitable for use with the slicing-by-8 algorithm (slicingUpdate).\n" ^{:tag (* slicing8Table)} [^uint32 poly]
  (let [t (new slicing8Table)]
    (simplePopulateTable poly (addr (aget t 0)))
    (for [i 0] (< i 256) (inc! i)
      (let [crc (aget (aget t 0) i)]
        (for [j 1] (< j 8) (inc! j)
          (set! crc (bit-xor (aget (aget t 0) (bit-and crc 0xFF)) (>> crc 8)))
          (aset (aget t j) i crc))))


    ^{:line 70} t))




^{:go/end 91} (go/func slicingUpdate "slicingUpdate uses the slicing-by-8 algorithm to update the CRC, given a\ntable that was previously computed using slicingMakeTable.\n" ^uint32 [^uint32 crc ^{:tag (* slicing8Table)} tab ^{:tag (slice byte)} p]
  (when (>= (len p) slicing8Cutoff)
    (set! crc (bit-not crc))
    (while (> (len p) 8)
      (set! crc bit-xor (byteorder/LEUint32 p))
      (set! crc (bit-xor (aget (aget tab 0) (aget p 7)) (aget (aget tab 1) (aget p 6)) (aget (aget tab 2) (aget p 5)) (aget (aget tab 3) (aget p 4))
          (aget (aget tab 4) (>> crc 24)) (aget (aget tab 5) (bit-and (>> crc 16) 0xFF))
          (aget (aget tab 6) (bit-and (>> crc 8) 0xFF)) (aget (aget tab 7) (bit-and crc 0xFF))))
      (set! p (subslice p 8)))

    (set! crc (bit-not crc)))

  (when (== (len p) 0)
    (return crc))

  (simpleUpdate crc (addr (aget tab 0)) p))

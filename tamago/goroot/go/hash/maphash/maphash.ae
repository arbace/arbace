^{:go/end 339} (go/func rthash ^uint64 [^{:tag (slice byte)} buf ^uint64 seed]
  (when (== (len buf) 0)
    (return seed))

  (let [len (len buf)]
    ;; The runtime hasher only works on uintptr. For 64-bit
    ;; architectures, we use the hasher directly. Otherwise,
    ;; we use two parallel hashers on the lower and upper 32 bits.
    (when maps/Use64BitHash
      (return (conv uint64 (runtime_memhash (conv unsafe/Pointer (addr (aget buf 0))) (conv uintptr seed) (conv uintptr len)))))

    (let [lo (runtime_memhash (conv unsafe/Pointer (addr (aget buf 0))) (conv uintptr (conv uint32 seed)) (conv uintptr len))
        ^{:line 337} hi (runtime_memhash (conv unsafe/Pointer (addr (aget buf 0))) (conv uintptr (>> seed 32)) (conv uintptr len))]
      (bit-or (<< (conv uint64 hi) 32) (conv uint64 lo)))))


^{:go/end 344} (go/func rthashString ^uint64 [^string s ^uint64 state]
  (let [buf (unsafe/Slice (unsafe/StringData s) (len s))]
    (rthash buf state)))


^{:go/end 348} (go/func randUint64 ^uint64 []
  (runtime_rand))


^{:go/end 361} (go/func comparableHash :type-params [^comparable T] ^uint64 [^T v ^Seed seed]
  (let [s (.-s seed)
      ^{:line 352 :tag (map T (struct))} m (zero (map T (struct)))
      ^{:line 353} mTyp (abi/TypeOf m)
      ^{:line 354} hasher (.-Hasher (conv (* abi/MapType) (conv unsafe/Pointer mTyp)))]
    (when maps/Use64BitHash
      (return (conv uint64 (hasher (abi/NoEscape (conv unsafe/Pointer (addr v))) (conv uintptr s)))))

    (let [lo (hasher (abi/NoEscape (conv unsafe/Pointer (addr v))) (conv uintptr (conv uint32 s)))
        ^{:line 359} hi (hasher (abi/NoEscape (conv unsafe/Pointer (addr v))) (conv uintptr (>> s 32)))]
      (bit-or (<< (conv uint64 hi) 32) (conv uint64 lo)))))


^{:go/end 365} (go/func writeComparable :type-params [^comparable T] [^{:tag (* Hash)} h ^T v]
  (set! (.-s (.-state h)) (^{:inst [T]} comparableHash v (.-state h))))

;; Package adler32 implements the Adler-32 checksum.
;;
;; It is defined in RFC 1950:
;;
;;	Adler-32 is composed of two sums accumulated per byte: s1 is
;;	the sum of all bytes, s2 is the sum of all s1 values. Both sums
;;	are done modulo 65521. s1 is initialized to 1, s2 to zero.  The
;;	Adler-32 checksum is stored as s2*65536 + s1 in most-
;;	significant-byte first (network) order.
(in-ns 'go.hash.adler32) (go/file "adler32.go" :doc "Package adler32 implements the Adler-32 checksum.\n\nIt is defined in RFC 1950:\n\n\tAdler-32 is composed of two sums accumulated per byte: s1 is\n\tthe sum of all bytes, s2 is the sum of all s1 values. Both sums\n\tare done modulo 65521. s1 is initialized to 1, s2 to zero.  The\n\tAdler-32 checksum is stored as s2*65536 + s1 in most-\n\tsignificant-byte first (network) order.\n" :imports [


    ^{:line 17} [errors "errors"]
    ^{:line 18} [hash "hash"]
    ^{:line 19} [byteorder "internal/byteorder"]])


(go/const

  ^{:line 24} [^{:val 65521 :doc "mod is the largest prime that is less than 65536.\n"} mod 65521]



  ^{:line 28} [^{:val 5552 :doc "nmax is the largest n such that\n255 * n * (n+1) / 2 + (n+1) * (mod-1) <= 2^32-1.\nIt is mentioned in RFC 1950 (search for \"5552\").\n"} nmax 5552])



(go/const ^{:val 4 :doc "The size of an Adler-32 checksum in bytes.\n"} Size 4)



(go/type digest "digest represents the partial evaluation of a checksum.\nThe low 16 bits are s1, the high 16 bits are s2.\n" uint32)

^{:go/end 38} (go/method Reset [^{:tag (* digest)} d] (set! @d 1))






^{:go/end 49} (go/func New "New returns a new hash.Hash32 computing the Adler-32 checksum. Its\nSum method will lay the value out in big-endian byte order. The\nreturned Hash32 also implements [encoding.BinaryMarshaler] and\n[encoding.BinaryUnmarshaler] to marshal and unmarshal the internal\nstate of the hash.\n" ^hash/Hash32 []
  (let [d (new digest)]
    (.Reset d)
    ^{:line 48} d))


^{:go/end 51} (go/method Size ^int [^{:tag (* digest)} d] Size)

^{:go/end 53} (go/method BlockSize ^int [^{:tag (* digest)} d] 4)

(go/const
  ^{:line 56} [^{:val "adl\u0001"} magic "adl\u0001"]
  ^{:line 57} [^{:val 8} marshaledSize (+ (len magic) 4)])


^{:go/end 64} (go/method AppendBinary [^{:tag (* digest)} d ^{:tag (slice byte)} b] :results [(slice byte) error]
  (set! b (append b (spread magic)))
  (set! b (byteorder/BEAppendUint32 b (conv uint32 @d)))
  (return b nil))


^{:go/end 68} (go/method MarshalBinary [^{:tag (* digest)} d] :results [(slice byte) error]
  (.AppendBinary d (make (slice byte) 0 marshaledSize)))


^{:go/breaks [6] :go/end 79} (go/method UnmarshalBinary ^error [^{:tag (* digest)} d ^{:tag (slice byte)} b]
  (when (or (< (len b) (len magic)) (!= (conv string (subslice b _ (len magic))) magic))
    (return (errors/New "hash/adler32: invalid hash state identifier")))

  (when (!= (len b) marshaledSize)
    (return (errors/New "hash/adler32: invalid hash state size")))

  (set! @d (conv digest (byteorder/BEUint32 (subslice b (len magic)))))
  nil)


^{:go/end 84} (go/method Clone [^{:tag (* digest)} d] :results [hash/Cloner error]
  (let [r @d]
    (return (addr r) nil)))



^{:go/end 114} (go/func update "Add p to the running checksum d.\n" ^digest [^digest d ^{:tag (slice byte)} p]
  (let [(values s1 s2) (values (conv uint32 (bit-and d 0xffff)) (conv uint32 (>> d 16)))]
    (while (> (len p) 0)
      (let [^{:tag (slice byte)} q (zero (slice byte))]
        (when (> (len p) nmax)
          (set! (values p q) (values (subslice p _ nmax) (subslice p nmax))))

        (while (>= (len p) 4)
          (set! s1 + (conv uint32 (aget p 0)))
          (set! s2 + s1)
          (set! s1 + (conv uint32 (aget p 1)))
          (set! s2 + s1)
          (set! s1 + (conv uint32 (aget p 2)))
          (set! s2 + s1)
          (set! s1 + (conv uint32 (aget p 3)))
          (set! s2 + s1)
          (set! p (subslice p 4)))

        (range [_ x p]
          (set! s1 + (conv uint32 x))
          (set! s2 + s1))

        (set! s1 % mod)
        (set! s2 % mod)
        (set! p q)))

    (conv digest (bit-or (<< s2 16) s1))))


^{:go/end 119} (go/method Write [^{:tag (* digest)} d ^{:tag (slice byte)} p] :results [^int nn ^error err]
  (set! @d (update @d p))
  (return (len p) nil))


^{:go/end 121} (go/method Sum32 ^uint32 [^{:tag (* digest)} d] (conv uint32 @d))

^{:go/end 126} (go/method Sum ^{:tag (slice byte)} [^{:tag (* digest)} d ^{:tag (slice byte)} in]
  (let [s (conv uint32 @d)]
    (append in (conv byte (>> s 24)) (conv byte (>> s 16)) (conv byte (>> s 8)) (conv byte s))))



^{:go/end 129} (go/func Checksum "Checksum returns the Adler-32 checksum of data.\n" ^uint32 [^{:tag (slice byte)} data] (conv uint32 (update 1 data)))

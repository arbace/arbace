^{:go/end 108} (go/method Write [^{:tag (* sum32)} s ^{:tag (slice byte)} data] :results [int error]
  (let [hash @s]
    (range [_ c data]
      (set! hash * prime32)
      (set! hash bit-xor (conv sum32 c)))

    (set! @s hash)
    (return (len data) nil)))



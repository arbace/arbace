^{:go/end 151} (go/method Write [^{:tag (* sum128)} s ^{:tag (slice byte)} data] :results [int error]
  (range [_ c data]
    ;; Compute the multiplication
    (let [(values s0 s1) (bits/Mul64 prime128Lower (aget s 1))]
      (set! s0 + (+ (<< (aget s 1) prime128Shift) (* prime128Lower (aget s 0))))
      ;; Update the values
      (aset s 1 s1)
      (aset s 0 s0)
      (set! (aget s 1) bit-xor (conv uint64 c))))

  (return (len data) nil))


^{:go/end 164} (go/method Write [^{:tag (* sum128a)} s ^{:tag (slice byte)} data] :results [int error]
  (range [_ c data]
    (set! (aget s 1) bit-xor (conv uint64 c))
    ;; Compute the multiplication
    (let [(values s0 s1) (bits/Mul64 prime128Lower (aget s 1))]
      (set! s0 + (+ (<< (aget s 1) prime128Shift) (* prime128Lower (aget s 0))))
      ;; Update the values
      (aset s 1 s1)
      (aset s 0 s0)))

  (return (len data) nil))



(ns go.log.slog
  (:require [arbace.go :as go]))

(go/package slog
  :path "log/slog"
  :files ["attr.go" "doc.go" "handler.go" "json_handler.go" "level.go" "logger.go" "multi_handler.go" "record.go" "text_handler.go" "value.go"]
  :positions :lines)

(load "slog/attr")
(load "slog/doc")
(load "slog/handler")
(load "slog/json_handler")
(load "slog/level")
(load "slog/logger")
(load "slog/multi_handler")
(load "slog/record")
(load "slog/text_handler")
(load "slog/value")

(go/type Priority "The Priority is a combination of the syslog facility and\nseverity. For example, [LOG_ALERT] | [LOG_FTP] sends an alert severity\nmessage from the FTP facility. The default severity is [LOG_EMERG];\nthe default facility is [LOG_KERN].\n" int)

(go/const ^{:val 7} severityMask 0x07)
(go/const ^{:val 248} facilityMask 0xf8)


^{:go/end 109} (go/func New "New establishes a new connection to the system log daemon. Each\nwrite to the returned writer sends a log message with the given\npriority (a combination of the syslog facility and severity) and\nprefix tag. If tag is empty, the [os.Args][0] is used.\n" [^Priority priority ^string tag] :results [(* Writer) error]
  (Dial "" "" priority tag))









^{:go/end 144} (go/func Dial "Dial establishes a connection to a log daemon by connecting to\naddress raddr on the specified network. Each write to the returned\nwriter sends a log message with the facility and severity\n(from priority) and tag. If tag is empty, the [os.Args][0] is used.\nIf network is empty, Dial will connect to the local syslog server.\nOtherwise, see the documentation for net.Dial for valid values\nof network and raddr.\n" [^string network ^string raddr ^Priority priority ^string tag] :results [(* Writer) error]
  (when (or (< priority 0) (> priority (bit-or LOG_LOCAL7 LOG_DEBUG)))
    (return nil (errors/New "log/syslog: invalid priority")))


  (when (== tag "")
    (set! tag (aget os/Args 0)))

  (let [(values hostname _) (os/Hostname)

      ^{:line 128} w (addr ^{:go/breaks [2 4 6 8 10]} (lit Writer
          :priority priority
          :tag tag
          :hostname hostname
          :network network
          :raddr raddr))]


    (.Lock (.-mu w))
    (defer (.Unlock (.-mu w)))

    (let [err (.connect w)]
      (when (!= err nil)
        (return nil err))

      (return w nil))))




^{:go/end 174} (go/method connect "connect makes a connection to the syslog server.\nIt must be called with w.mu held.\n" [^{:tag (* Writer)} w] :results [^error err]
  (when (!= (.-conn w) nil)
    ;; ignore err from close, it makes sense to continue anyway
    (.close (.-conn w))
    (set! (.-conn w) nil))


  (if (== (.-network w) "") (do
      (set! (values (.-conn w) err) (unixSyslog))
      (when (== (.-hostname w) "")
        (set! (.-hostname w) "localhost")))


    (let [^net/Conn c (zero net/Conn)]
      (set! (values c err) (net/Dial (.-network w) (.-raddr w)))
      (when (== err nil)
        (set! (.-conn w) (addr ^{:go/breaks [2 4]} (lit netConn
              :conn c
              :local (or (== (.-network w) "unixgram") (== (.-network w) "unix")))))

        (when (== (.-hostname w) "")
          (set! (.-hostname w) (.String (.LocalAddr c)))))))



  (return))




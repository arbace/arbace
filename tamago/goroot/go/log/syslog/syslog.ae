  ^{:line 36} [^{:val 2} LOG_CRIT]
  ^{:line 37} [^{:val 3} LOG_ERR]
  ^{:line 38} [^{:val 4} LOG_WARNING]
  ^{:line 39} [^{:val 5} LOG_NOTICE]
  ^{:line 40} [^{:val 6} LOG_INFO]
  ^{:line 41} [^{:val 7} LOG_DEBUG])


(go/const
  ;; Facility.



  ^{:line 49} [^{:tag Priority :val 0 :doc "From /usr/include/sys/syslog.h.\nThese are the same up to LOG_FTP on Linux, BSD, and OS X.\n"} LOG_KERN (<< iota 3)]
  ^{:line 50} [^{:val 8} LOG_USER]

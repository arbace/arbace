      (values _ err) (fmt/Fprintf (.-conn n) "<%d>%s %s %s[%d]: %s%s"
        ^{:line 299} p timestamp hostname
        ^{:line 300} tag (os/Getpid) msg nl)]
    ^{:line 301} err))



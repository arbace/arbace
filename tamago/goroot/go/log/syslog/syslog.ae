^{:go/end 265} (go/method writeAndRetry [^{:tag (* Writer)} w ^Priority p ^string s] :results [int error]
  (let [pr (bit-or (bit-and (.-priority w) facilityMask) (bit-and p severityMask))]

    (.Lock (.-mu w))
    (defer (.Unlock (.-mu w)))

    (when (!= (.-conn w) nil)
      (when [(values n err) (.write w pr s)] (== err nil)
        (return n nil)))


    (when [err (.connect w)] (!= err nil)
      (return 0 err))

    (.write w pr s)))




^{:go/end 284} (go/method write "write generates and writes a syslog formatted string. The\nformat is as follows: <PRI>TIMESTAMP HOSTNAME TAG[PID]: MSG\n" [^{:tag (* Writer)} w ^Priority p ^string msg] :results [int error]
  ;; ensure it ends in a \n
  (let [nl ""]
    (when (not (strings/HasSuffix msg "\n"))
      (set! nl "\n"))


    (let [err (.writeString (.-conn w) p (.-hostname w) (.-tag w) msg nl)]
      (when (!= err nil)
        (return 0 err))

      ;; Note: return the length of the input, not the number of
      ;; bytes printed by Fprintf, because this must behave like
      ;; an io.Writer.
      (return (len msg) nil))))



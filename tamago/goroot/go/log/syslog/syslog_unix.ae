(in-ns 'go.log.syslog) (go/file "syslog_unix.go" :build ["//go:build !windows && !plan9"] :imports [


    ^{:line 10} [errors "errors"]
    ^{:line 11} [net "net"]])


;; unixSyslog opens a connection to the syslog daemon running on the
;; local machine using a Unix domain socket.

^{:go/end 29} (go/func unixSyslog [] :results [^serverConn conn ^error err]
  (let [logTypes (lit (slice string) "unixgram" "unix")
      ^{:line 19} logPaths (lit (slice string) "/dev/log" "/var/run/syslog" "/var/run/log")]
    (range [_ network logTypes]
      (range [_ path logPaths]
        (let [(values conn err) (net/Dial network path)]
          (when (== err nil)
            (return (addr (lit netConn :conn conn :local true)) nil)))))



    (return nil (errors/New "Unix syslog delivery error"))))

(ns go.log.syslog
  (:require [arbace.go :as go]))

(go/package syslog
  :path "log/syslog"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["doc.go" "syslog.go" "syslog_unix.go"]
  :init-order []
  :positions :lines)

(load "syslog/doc")
(load "syslog/syslog")
(load "syslog/syslog_unix")

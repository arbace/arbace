;; Package log implements a simple logging package. It defines a type, [Logger],
;; with methods for formatting output. It also has a predefined 'standard'
;; Logger accessible through helper functions Print[f|ln], Fatal[f|ln], and
;; Panic[f|ln], which are easier to use than creating a Logger manually.
;; That logger writes to standard error and prints the date and time
;; of each logged message.
;; Every log message is output on a separate line: if the message being
;; printed does not end in a newline, the logger will add one.
;; The Fatal functions call [os.Exit](1) after writing the log message.
;; The Panic functions call panic after writing the log message.
(in-ns 'go.log) (go/file "log.go" :doc "Package log implements a simple logging package. It defines a type, [Logger],\nwith methods for formatting output. It also has a predefined 'standard'\nLogger accessible through helper functions Print[f|ln], Fatal[f|ln], and\nPanic[f|ln], which are easier to use than creating a Logger manually.\nThat logger writes to standard error and prints the date and time\nof each logged message.\nEvery log message is output on a separate line: if the message being\nprinted does not end in a newline, the logger will add one.\nThe Fatal functions call [os.Exit](1) after writing the log message.\nThe Panic functions call panic after writing the log message.\n" :imports [


    ^{:line 18} [fmt "fmt"]
    ^{:line 19} [io "io"]
    ^{:line 20} [internal "log/internal"]
    ^{:line 21} [os "os"]
    ^{:line 22} [runtime "runtime"]
    ^{:line 23} [sync "sync"]
    ^{:line 24} [atomic "sync/atomic"]
    ^{:line 25} [time "time"]])
















(go/const "These flags define which text to prefix to each log entry generated by the [Logger].\nBits are or'ed together to control what's printed.\nWith the exception of the Lmsgprefix flag, there is no\ncontrol over the order they appear (the order listed here)\nor the format they present (as described in the comments).\nThe prefix is followed by a colon only when Llongfile or Lshortfile\nis specified.\nFor example, flags Ldate | Ltime (or LstdFlags) produce,\n\n\t2009/01/23 01:23:23 message\n\nwhile flags Ldate | Ltime | Lmicroseconds | Llongfile produce,\n\n\t2009/01/23 01:23:23.123123 /a/b/c/d.go:23: message\n"
  ^{:line 43} [^{:val 1} Ldate (<< 1 iota)] ; the date in the local time zone: 2009/01/23
  ^{:line 44} [^{:val 2} Ltime] ; the time in the local time zone: 01:23:23
  ^{:line 45} [^{:val 4} Lmicroseconds] ; microsecond resolution: 01:23:23.123123.  assumes Ltime.
  ^{:line 46} [^{:val 8} Llongfile] ; full file name and line number: /a/b/c/d.go:23
  ^{:line 47} [^{:val 16} Lshortfile] ; final file name element and line number: d.go:23. overrides Llongfile
  ^{:line 48} [^{:val 32} LUTC] ; if Ldate or Ltime is set, use UTC rather than the local time zone
  ^{:line 49} [^{:val 64} Lmsgprefix] ; move the "prefix" from the beginning of the line to before the message
  ^{:line 50} [^{:val 3} LstdFlags (bit-or Ldate Ltime)]) ; initial values for the standard logger






(go/type Logger "A Logger represents an active logging object that generates lines of\noutput to an [io.Writer]. Each logging operation makes a single call to\nthe Writer's Write method. A Logger can be used simultaneously from\nmultiple goroutines; it guarantees to serialize access to the Writer.\n" (struct
    ^{:line 58 :tag sync/Mutex} outMu
    ^{:line 59 :tag io/Writer} out ; destination for output

    ^{:line 61 :tag (atomic/Pointer string)} prefix ; prefix on each line to identify the logger (but see Lmsgprefix)
    ^{:line 62 :tag atomic/Int32} flag ; properties
    ^{:line 63 :tag atomic/Bool} isDiscard))







^{:go/end 77} (go/func New "New creates a new [Logger]. The out variable sets the\ndestination to which log data will be written.\nThe prefix appears at the beginning of each generated log line, or\nafter the log header if the [Lmsgprefix] flag is provided.\nThe flag argument defines the logging properties.\n" ^{:tag (* Logger)} [^io/Writer out ^string prefix ^int flag]
  (let [l (new Logger)]
    (.SetOutput l out)
    (.SetPrefix l prefix)
    (.SetFlags l flag)
    ^{:line 76} l))



^{:go/end 85} (go/method SetOutput "SetOutput sets the output destination for the logger.\n" [^{:tag (* Logger)} l ^io/Writer w]
  (.Lock (.-outMu l))
  (defer (.Unlock (.-outMu l)))
  (set! (.-out l) w)
  (.Store (.-isDiscard l) (== w io/Discard)))


(go/var std (New os/Stderr "" LstdFlags))


^{:go/end 90} (go/func Default "Default returns the standard logger used by the package-level output functions.\n" ^{:tag (* Logger)} [] std)


^{:go/end 107} (go/func itoa "Cheap integer to fixed-width decimal ASCII. Give a negative width to avoid zero-padding.\n" [^{:tag (* (slice byte))} buf ^int i ^int wid]
  ;; Assemble decimal in reverse order.
  (let [^{:tag (array 20 byte)} b (zero (array 20 byte))
      ^{:line 96} bp (- (len b) 1)]
    (while (or (>= i 10) (> wid 1))
      (dec! wid)
      (let [q (/ i 10)]
        (aset b bp (conv byte (- (+ \0 i) (* q 10))))
        (dec! bp)
        (set! i q)))

    ;; i < 10
    (aset b bp (conv byte (+ \0 i)))
    (set! @buf (append @buf (spread (subslice b bp))))))







^{:go/end 164} (go/func formatHeader "formatHeader writes log header to buf in following order:\n  - l.prefix (if it's not blank and Lmsgprefix is unset),\n  - date and/or time (if corresponding flags are provided),\n  - file and line number (if corresponding flags are provided),\n  - l.prefix (if it's not blank and Lmsgprefix is set).\n" [^{:tag (* (slice byte))} buf ^time/Time t ^string prefix ^int flag ^string file ^int line]
  (when (== (bit-and flag Lmsgprefix) 0)
    (set! @buf (append @buf (spread prefix))))

  (when (!= (bit-and flag (bit-or Ldate Ltime Lmicroseconds)) 0)
    (when (!= (bit-and flag LUTC) 0)
      (set! t (.UTC t)))

    (when (!= (bit-and flag Ldate) 0)
      (let [(values year month day) (.Date t)]
        (itoa buf year 4)
        (set! @buf (append @buf \/))
        (itoa buf (conv int month) 2)
        (set! @buf (append @buf \/))
        (itoa buf day 2)
        (set! @buf (append @buf \space))))

    (when (!= (bit-and flag (bit-or Ltime Lmicroseconds)) 0)
      (let [(values hour min sec) (.Clock t)]
        (itoa buf hour 2)
        (set! @buf (append @buf \:))
        (itoa buf min 2)
        (set! @buf (append @buf \:))
        (itoa buf sec 2)
        (when (!= (bit-and flag Lmicroseconds) 0)
          (set! @buf (append @buf \.))
          (itoa buf (/ (.Nanosecond t) 1000.0) 6))

        (set! @buf (append @buf \space)))))


  (when (!= (bit-and flag (bit-or Lshortfile Llongfile)) 0)
    (when (!= (bit-and flag Lshortfile) 0)
      (let [short file]
        (for [i (- (len file) 1)] (> i 0) (dec! i)
          (when (== (aget file i) \/)
            (set! short (subslice file (+ i 1)))
            (break)))


        (set! file short)))

    (set! @buf (append @buf (spread file)))
    (set! @buf (append @buf \:))
    (itoa buf line -1)
    (set! @buf (append @buf (spread ": "))))

  (when (!= (bit-and flag Lmsgprefix) 0)
    (set! @buf (append @buf (spread prefix)))))



(go/var bufferPool (lit sync/Pool :New ^{:go/end 166} (fn ^any [] (new (slice byte)))))

^{:go/end 172} (go/func getBuffer ^{:tag (* (slice byte))} []
  (let [p (assert (* (slice byte)) (.Get bufferPool))]
    (set! @p (subslice @p _ 0))
    ^{:line 171} p))


^{:go/end 185} (go/func putBuffer [^{:tag (* (slice byte))} p]
  ;; Proper usage of a sync.Pool requires each entry to have approximately
  ;; the same memory cost. To obtain this property when the stored type
  ;; contains a variably-sized buffer, we add a hard limit on the maximum buffer
  ;; to place back in the pool.
  ;;
  ;; See https://go.dev/issue/23199
  (when (> (cap @p) (<< 64 10))
    (set! @p nil))

  (.Put bufferPool p))








^{:go/end 197} (go/method Output "Output writes the output for a logging event. The string s contains\nthe text to print after the prefix specified by the flags of the\nLogger. A newline is appended if the last character of s is not\nalready a newline. Calldepth is used to recover the PC and is\nprovided for generality, although at the moment on all pre-defined\npaths it will be 2.\n" ^error [^{:tag (* Logger)} l ^int calldepth ^string s]
  (.output l 0 (+ calldepth 1) ^{:go/end 196} (fn ^{:tag (slice byte)} [^{:tag (slice byte)} b] ; +1 for this frame.
      (append b (spread s)))))





^{:go/end 246} (go/method output "output can take either a calldepth or a pc to get source line information.\nIt uses the pc if it is non-zero.\n" ^error [^{:tag (* Logger)} l ^uintptr pc ^int calldepth ^{:tag (func [(slice byte)] [(slice byte)])} appendOutput]
  (when (.Load (.-isDiscard l))
    (return nil))


  (let [now (time/Now) ; get this early.

      ;; Load prefix and flag once so that their value is consistent within
      ;; this call regardless of any concurrent changes to their value.
      ^{:line 210} prefix (.Prefix l)
      ^{:line 211} flag (.Flags l)

      ^{:line 213 :tag string} file (zero string)
      ^{:line 214 :tag int} line (zero int)]
    (when (!= (bit-and flag (bit-or Lshortfile Llongfile)) 0)
      (if (== pc 0)
        (let [^bool ok (zero bool)]
          (set! (values _ file line ok) (runtime/Caller calldepth))
          (when (not ok)
            (set! file "???")
            (set! line 0)))


        (let [fs (runtime/CallersFrames (lit (slice uintptr) pc))
            (values f _) (.Next fs)]
          (set! file (.-File f))
          (when (== file "")
            (set! file "???"))

          (set! line (.-Line f)))))



    (let [buf (getBuffer)]
      (defer (putBuffer buf))
      (formatHeader buf now prefix flag file line)
      (set! @buf (appendOutput @buf))
      (when (or (== (len @buf) 0) (!= (aget @buf (- (len @buf) 1)) \newline))
        (set! @buf (append @buf \newline)))


      (.Lock (.-outMu l))
      (defer (.Unlock (.-outMu l)))
      (let [(values _ err) (.Write (.-out l) @buf)]
        ^{:line 245} err))))



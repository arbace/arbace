;; Package internal contains definitions used by both log and log/slog.
(in-ns 'go.log.internal) (go/file "internal.go" :doc "Package internal contains definitions used by both log and log/slog.\n" :imports [])





(go/var ^{:tag (func [^uintptr pc ^{:tag (slice byte)} data] [error]) :doc "DefaultOutput holds a function which calls the default log.Logger's\noutput function.\nIt allows slog.defaultHandler to call into an unexported function of\nthe log package.\n"} DefaultOutput)

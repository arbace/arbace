^{:go/end 124} (go/method AddAttrs "AddAttrs appends the given Attrs to the [Record]'s list of Attrs.\nIt omits empty groups.\n" [^{:tag (* Record)} r & ^{:tag (slice Attr)} attrs]
  (let [^int i (zero int)]
    (for [(set! i 0)] (and (< i (len attrs)) (< (.-nFront r) (len (.-front r)))) (inc! i)
      (let [a (aget attrs i)]

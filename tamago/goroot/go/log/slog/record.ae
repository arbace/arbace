      (range [_ a (subslice attrs i)]
        (when (not (.isEmptyGroup (.-Value a)))
          (set! (.-back r) (append (.-back r) a)))))))







^{:go/end 146} (go/method Add "Add converts the args to Attrs as described in [Logger.Log],\nthen appends the Attrs to the [Record]'s list of Attrs.\nIt omits empty groups.\n" [^{:tag (* Record)} r & ^{:tag (slice any)} args]
  (let [^Attr a (zero Attr)]
    (while (> (len args) 0)

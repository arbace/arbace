^{:go/end 93} (go/method Attrs "Attrs calls f on each Attr in the [Record].\nIteration stops if f returns false.\n" [^Record r ^{:tag (func [Attr] [bool])} f]
  (for [i 0] (< i (.-nFront r)) (inc! i)

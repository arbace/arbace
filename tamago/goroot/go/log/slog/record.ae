(go/const ^{:val "!BADKEY"} badKey "!BADKEY")







^{:go/end 182} (go/func argsToAttr "argsToAttr turns a prefix of the nonempty args slice into an Attr\nand returns the unconsumed portion of the slice.\nIf args[0] is an Attr, it returns it.\nIf args[0] is a string, it treats the first two elements as\na key-value pair.\nOtherwise, it treats args[0] as a value with a missing key.\n" [^{:tag (slice any)} args] :results [Attr (slice any)]
  (type-switch [x (aget args 0)]
    (case [string]
      (when (== (len args) 1)
        (return (String badKey x) nil))

      (return (Any x (aget args 1)) (subslice args 2)))

    (case [Attr]
      (return x (subslice args 1)))

    (default
      (return (Any badKey x) (subslice args 1)))))





(go/type JSONHandler "JSONHandler is a [Handler] that writes Records to an [io.Writer] as\nline-delimited JSON objects.\n" (struct
    (* commonHandler)))





^{:go/end 43} (go/func NewJSONHandler "NewJSONHandler creates a [JSONHandler] that writes to w,\nusing the given options.\nIf opts is nil, the default options are used.\n" ^{:tag (* JSONHandler)} [^io/Writer w ^{:tag (* HandlerOptions)} opts]
  (when (== opts nil)
    (set! opts (addr (lit HandlerOptions))))

  (addr (lit JSONHandler
      (addr ^{:go/breaks [2 4 6 8]} (lit commonHandler
          :json true
          :w w
          :opts @opts
          :mu (addr (lit sync/Mutex)))))))






^{:go/end 49} (go/method Enabled "Enabled reports whether the handler handles records at the given level.\nThe handler ignores records whose level is lower.\n" ^bool [^{:tag (* JSONHandler)} h ^context/Context _ ^Level level]
  (.enabled (.-commonHandler h) level))




^{:go/end 55} (go/method WithAttrs "WithAttrs returns a new [JSONHandler] whose attributes consists\nof h's attributes followed by attrs.\n" ^Handler [^{:tag (* JSONHandler)} h ^{:tag (slice Attr)} attrs]
  (addr (lit JSONHandler :commonHandler (.withAttrs (.-commonHandler h) attrs))))


^{:go/end 59} (go/method WithGroup ^Handler [^{:tag (* JSONHandler)} h ^string name]
  (addr (lit JSONHandler :commonHandler (.withGroup (.-commonHandler h) name))))






























^{:go/end 91} (go/method Handle "Handle formats its argument [Record] as a JSON object on a single line.\n\nIf the Record's time is zero, the time is omitted.\nOtherwise, the key is \"time\"\nand the value is output as with json.Marshal.\n\nThe level's key is \"level\" and its value is the result of calling [Level.String].\n\nIf the AddSource option is set and source information is available,\nthe key is \"source\", and the value is a record of type [Source].\n\nThe message's key is \"msg\".\n\nTo modify these or other attributes, or remove them from the output, use\n[HandlerOptions.ReplaceAttr].\n\nValues are formatted as with an [encoding/json.Encoder] with SetEscapeHTML(false),\nwith two exceptions.\n\nFirst, an Attr whose Value is of type error is formatted as a string, by\ncalling its Error method. Only errors in Attrs receive this special treatment,\nnot errors embedded in structs, slices, maps or other data structures that\nare processed by the [encoding/json] package.\n\nSecond, an encoding failure does not cause Handle to return an error.\nInstead, the error message is formatted as a string.\n\nEach call to Handle results in a single serialized call to io.Writer.Write.\n" ^error [^{:tag (* JSONHandler)} h ^context/Context _ ^Record r]
  (.handle (.-commonHandler h) r))



^{:go/end 104} (go/func appendJSONTime "Adapted from time.Time.MarshalJSON to avoid allocation.\n" [^{:tag (* handleState)} s ^time/Time t]
  (when [y (.Year t)] (or (< y 0) (>= y 10000))
    ;; RFC 3339 is clear that years are 4 digits exactly.
    ;; See golang.org/issue/4556#c15 for more discussion.
    (.appendError s (errors/New "time.Time year outside of range [0,9999]"))
    (return))

  (.WriteByte (.-buf s) \")
  (set! @(.-buf s) (.AppendFormat t @(.-buf s) time/RFC3339Nano))
  (.WriteByte (.-buf s) \"))


^{:go/breaks [[4 139]] :go/end 140} (go/func appendJSONValue ^error [^{:tag (* handleState)} s ^Value v]
  (switch (.Kind v)
    (case [KindString]
      (.appendString s (.str v)))
    (case [KindInt64]
      (set! @(.-buf s) (strconv/AppendInt @(.-buf s) (.Int64 v) 10)))
    (case [KindUint64]
      (set! @(.-buf s) (strconv/AppendUint @(.-buf s) (.Uint64 v) 10)))
    (case [KindFloat64]
      ;; json.Marshal is funny about floats; it doesn't
      ;; always match strconv.AppendFloat. So just call it.
      ;; That's expensive, but floats are rare.
      (when [err (appendJSONMarshal (.-buf s) (.Float64 v))] (!= err nil)
        (return err)))

    (case [KindBool]
      (set! @(.-buf s) (strconv/AppendBool @(.-buf s) (.Bool v))))
    (case [KindDuration]
      ;; Do what json.Marshal does.
      (set! @(.-buf s) (strconv/AppendInt @(.-buf s) (conv int64 (.Duration v)) 10)))
    (case [KindTime]
      (.appendTime s (.Time v)))
    (case [KindAny]
      (let [a (.Any v)
          (values _ jm) (assert json/Marshaler a)]
        (if [(values err ok) (assert error a)] (and ok (not jm))
          (.appendString s (.Error err))

          (return (appendJSONMarshal (.-buf s) a)))))

    (default
      (panic (fmt/Sprintf "bad kind: %s" (.Kind v)))))

  nil)


(go/type jsonEncoder (struct
    ^{:line 143 :tag (* bytes/Buffer)} buf

    ^{:line 145 :tag (* json/Encoder) :doc "Use a json.Encoder to avoid escaping HTML.\n"} json))


(go/var jsonEncoderPool (addr ^{:go/breaks [2]} (lit sync/Pool
      :New ^{:go/end 156} (fn ^any []
        (let [enc (addr ^{:go/breaks [2]} (lit jsonEncoder
                :buf (new bytes/Buffer)))]

          (set! (.-json enc) (json/NewEncoder (.-buf enc)))
          (.SetEscapeHTML (.-json enc) false)
          ^{:line 155} enc)))))



^{:go/end 178} (go/func appendJSONMarshal ^error [^{:tag (* buffer/Buffer)} buf ^any v]
  (let [j (assert (* jsonEncoder) (.Get jsonEncoderPool))]
    (defer (^{:go/end 169} (fn []
          ;; To reduce peak allocation, return only smaller buffers to the pool.
          (let [^:const ^{:val 16384} maxBufferSize (<< 16 10)]
            (when (> (.Cap (.-buf j)) maxBufferSize)
              (return))

            (.Reset (.-buf j))
            (.Put jsonEncoderPool j)))))


    (when [err (.Encode (.-json j) v)] (!= err nil)
      (return err))


    ^{:go/breaks [3]} (let [bs (.Bytes (.-buf j))]
      (.Write buf (subslice bs _ (- (len bs) 1))) ; remove final newline
      nil)))







^{:go/end 256} (go/func appendEscapedJSONString "appendEscapedJSONString escapes s for JSON and appends it to buf.\nIt does not surround the string in quotation marks.\n\nModified from encoding/json/encode.go:encodeState.string,\nwith escapeHTML set to false.\n" ^{:tag (slice byte)} [^{:tag (slice byte)} buf ^string s]
  (let [char ^{:go/end 186} (fn [^byte b] (set! buf (append buf b)))
      ^{:line 187} str ^{:go/end 187} (fn [^string s] (set! buf (append buf (spread s))))

      ^{:line 189} start 0]
    (for [i 0] (< i (len s)) _
      (when [b (aget s i)] (< b utf8/RuneSelf)
        (when (aget safeSet b)
          (inc! i)
          (continue))

        (when (< start i)
          (str (subslice s start i)))

        (char \\)
        (switch b
          (case [\\ \"]
            (char b))
          (case [\newline]
            (char \n))
          (case [\return]
            (char \r))
          (case [\tab]
            (char \t))
          (default
            ;; This encodes bytes < 0x20 except for \t, \n and \r.
            (str "u00")
            (char (aget hex (>> b 4)))
            (char (aget hex (bit-and b 0xF)))))

        (inc! i)
        (set! start i)
        (continue))

      (let [(values c size) (utf8/DecodeRuneInString (subslice s i))]
        (when (and (== c utf8/RuneError) (== size 1))
          (when (< start i)
            (str (subslice s start i)))

          (if goexperiment/JSONv2
            (str "\ufffd") ; see https://go.dev/cl/687116

            (str "\\ufffd"))

          (set! i + size)
          (set! start i)
          (continue))

        ;; U+2028 is LINE SEPARATOR.
        ;; U+2029 is PARAGRAPH SEPARATOR.
        ;; They are both technically valid characters in JSON strings,
        ;; but don't work in JSONP, which has to be evaluated as JavaScript,
        ;; and can lead to security holes there. It is valid JSON to
        ;; escape them, so we do so unconditionally.
        ;; See http://timelessrepo.com/json-isnt-a-javascript-subset for discussion.
        (when (or (== c \u2028) (== c \u2029))
          (when (< start i)
            (str (subslice s start i)))

          (str "\\u202")
          (char (aget hex (bit-and c 0xF)))
          (set! i + size)
          (set! start i)
          (continue))

        (set! i + size)))

    (when (< start (len s))
      (str (subslice s start)))

    ^{:line 255} buf))



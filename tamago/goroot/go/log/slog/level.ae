(go/type LevelVar "A LevelVar is a [Level] variable, to allow a [Handler] level to change\ndynamically.\nIt implements [Leveler] as well as a Set method,\nand it is safe for use by multiple goroutines.\nThe zero LevelVar corresponds to [LevelInfo].\n" (struct
    ^{:line 168 :tag atomic/Int64} val))



^{:go/end 174} (go/method Level "Level returns v's level.\n" ^Level [^{:tag (* LevelVar)} v]
  (conv Level (conv int (.Load (.-val v)))))



^{:go/end 179} (go/method Set "Set sets v's level to l.\n" [^{:tag (* LevelVar)} v ^Level l]
  (.Store (.-val v) (conv int64 l)))


^{:go/end 183} (go/method String ^string [^{:tag (* LevelVar)} v]
  (fmt/Sprintf "LevelVar(%s)" (.Level v)))




^{:go/end 189} (go/method AppendText "AppendText implements [encoding.TextAppender]\nby calling [Level.AppendText].\n" [^{:tag (* LevelVar)} v ^{:tag (slice byte)} b] :results [(slice byte) error]
  (.AppendText (.Level v) b))




^{:go/end 195} (go/method MarshalText "MarshalText implements [encoding.TextMarshaler]\nby calling [LevelVar.AppendText].\n" [^{:tag (* LevelVar)} v] :results [(slice byte) error]
  (.AppendText v nil))





(go/type Level "A Level is the importance or severity of a log event.\nThe higher the level, the more important or severe the event.\n" int)

























(go/const "Names for common levels.\n\nLevel numbers are inherently arbitrary,\nbut we picked them to satisfy three constraints.\nAny system can map them to another numbering scheme if it wishes.\n\nFirst, we wanted the default level to be Info, Since Levels are ints, Info is\nthe default value for int, zero.\n\nSecond, we wanted to make it easy to use levels to specify logger verbosity.\nSince a larger level means a more severe event, a logger that accepts events\nwith smaller (or more negative) level means a more verbose logger. Logger\nverbosity is thus the negation of event severity, and the default verbosity\nof 0 accepts all events at least as severe as INFO.\n\nThird, we wanted some room between levels to accommodate schemes with named\nlevels between ours. For example, Google Cloud Logging defines a Notice level\nbetween Info and Warn. Since there are only a few of these intermediate\nlevels, the gap between the numbers need not be large. Our gap of 4 matches\nOpenTelemetry's mapping. Subtracting 9 from an OpenTelemetry level in the\nDEBUG, INFO, WARN and ERROR ranges converts it to the corresponding slog\nLevel range. OpenTelemetry also has the names TRACE and FATAL, which slog\ndoes not. But those OpenTelemetry levels can still be represented as slog\nLevels by using the appropriate integers.\n"
  ^{:line 44} [^{:tag Level :val -4} LevelDebug -4]
  ^{:line 45} [^{:tag Level :val 0} LevelInfo 0]
  ^{:line 46} [^{:tag Level :val 4} LevelWarn 4]
  ^{:line 47} [^{:tag Level :val 8} LevelError 8])











^{:go/end 81} (go/method String "String returns a name for the level.\nIf the level has a name, then that name\nin uppercase is returned.\nIf the level is between named values, then\nan integer is appended to the uppercased name.\nExamples:\n\n\tLevelWarn.String() => \"WARN\"\n\t(LevelInfo+2).String() => \"INFO+2\"\n" ^string [^Level l]
  (let [str ^{:go/end 69} (fn ^string [^string base ^Level val]
        (when (== val 0)
          (return base))

        (let [sval (strconv/Itoa (conv int val))]
          (when (> val 0)
            (set! sval (+ "+" sval)))

          (+ base sval)))]


    (switch
      (case [(< l LevelInfo)]
        (return (str "DEBUG" (- l LevelDebug))))
      (case [(< l LevelWarn)]
        (return (str "INFO" (- l LevelInfo))))
      (case [(< l LevelError)]
        (return (str "WARN" (- l LevelWarn))))
      (default
        (return (str "ERROR" (- l LevelError)))))))





^{:go/end 90} (go/method MarshalJSON "MarshalJSON implements [encoding/json.Marshaler]\nby quoting the output of [Level.String].\n" [^Level l] :results [(slice byte) error]
  ;; AppendQuote is sufficient for JSON-encoding all Level strings.
  ;; They don't contain any runes that would produce invalid JSON
  ;; when escaped.
  (return (strconv/AppendQuote nil (.String l)) nil))







^{:go/end 103} (go/method UnmarshalJSON "UnmarshalJSON implements [encoding/json.Unmarshaler]\nIt accepts any string produced by [Level.MarshalJSON],\nignoring case.\nIt also accepts numeric offsets that would result in a different string on\noutput. For example, \"Error-8\" would marshal as \"INFO\".\n" ^error [^{:tag (* Level)} l ^{:tag (slice byte)} data]
  (let [(values s err) (strconv/Unquote (conv string data))]
    (when (!= err nil)
      (return err))

    (.parse l s)))




^{:go/end 109} (go/method AppendText "AppendText implements [encoding.TextAppender]\nby calling [Level.String].\n" [^Level l ^{:tag (slice byte)} b] :results [(slice byte) error]
  (return (append b (spread (.String l))) nil))




^{:go/end 115} (go/method MarshalText "MarshalText implements [encoding.TextMarshaler]\nby calling [Level.AppendText].\n" [^Level l] :results [(slice byte) error]
  (.AppendText l nil))







^{:go/end 124} (go/method UnmarshalText "UnmarshalText implements [encoding.TextUnmarshaler].\nIt accepts any string produced by [Level.MarshalText],\nignoring case.\nIt also accepts numeric offsets that would result in a different string on\noutput. For example, \"Error-8\" would marshal as \"INFO\".\n" ^error [^{:tag (* Level)} l ^{:tag (slice byte)} data]
  (.parse l (conv string data)))


^{:go/end 156} (go/method parse [^{:tag (* Level)} l ^string s] :results [^error err]
  (defer (^{:go/end 131} (fn []
        (when (!= err nil)
          (set! err (fmt/Errorf "slog: level string %q: %w" s err))))))



  ^{:go/breaks [5]} (let [name s
      ^{:line 134} offset 0]
    (when [i (strings/IndexAny s "+-")] (>= i 0)
      (set! name (subslice s _ i))
      (set! (values offset err) (strconv/Atoi (subslice s i)))
      (when (!= err nil)
        (return err)))


    (switch (strings/ToUpper name)
      (case ["DEBUG"]
        (set! @l LevelDebug))
      (case ["INFO"]
        (set! @l LevelInfo))
      (case ["WARN"]
        (set! @l LevelWarn))
      (case ["ERROR"]
        (set! @l LevelError))
      (default
        (return (errors/New "unknown name"))))

    (set! @l + (conv Level offset))
    nil))





    nil))








(go/type Leveler "A Leveler provides a [Level] value.\n\nAs Level itself implements Leveler, clients typically supply\na Level value wherever a Leveler is needed, such as in [HandlerOptions].\nClients who need to vary the level dynamically can provide a more complex\nLeveler implementation such as *[LevelVar].\n" (interface
    (Level ^Level [])))

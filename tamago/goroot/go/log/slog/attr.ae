(in-ns 'go.log.slog) (go/file "attr.go" :imports [


    ^{:line 8} [time "time"]])



(go/type Attr "An Attr is a key-value pair.\n" (struct
    ^{:line 13 :tag string} Key
    ^{:line 14 :tag Value} Value))



^{:go/end 20} (go/func String "String returns an Attr for a string value.\n" ^Attr [^string key ^string value]
  (lit Attr key (StringValue value)))



^{:go/end 25} (go/func Int64 "Int64 returns an Attr for an int64.\n" ^Attr [^string key ^int64 value]
  (lit Attr key (Int64Value value)))




^{:go/end 31} (go/func Int "Int converts an int to an int64 and returns\nan Attr with that value.\n" ^Attr [^string key ^int value]
  (Int64 key (conv int64 value)))



^{:go/end 36} (go/func Uint64 "Uint64 returns an Attr for a uint64.\n" ^Attr [^string key ^uint64 v]
  (lit Attr key (Uint64Value v)))



^{:go/end 41} (go/func Float64 "Float64 returns an Attr for a floating-point number.\n" ^Attr [^string key ^float64 v]
  (lit Attr key (Float64Value v)))



^{:go/end 46} (go/func Bool "Bool returns an Attr for a bool.\n" ^Attr [^string key ^bool v]
  (lit Attr key (BoolValue v)))




^{:go/end 52} (go/func Time "Time returns an Attr for a [time.Time].\nIt discards the monotonic portion.\n" ^Attr [^string key ^time/Time v]
  (lit Attr key (TimeValue v)))



^{:go/end 57} (go/func Duration "Duration returns an Attr for a [time.Duration].\n" ^Attr [^string key ^time/Duration v]
  (lit Attr key (DurationValue v)))









^{:go/end 68} (go/func Group "Group returns an Attr for a Group [Value].\nThe first argument is the key; the remaining arguments\nare converted to Attrs as in [Logger.Log].\n\nUse Group to collect several key-value pairs under a single\nkey on a log line, or as the result of LogValue\nin order to log a single value as multiple Attrs.\n" ^Attr [^string key & ^{:tag (slice any)} args]
  (lit Attr key (GroupValue (spread (argsToAttrSlice args)))))







^{:go/end 77} (go/func GroupAttrs "GroupAttrs returns an Attr for a Group [Value]\nconsisting of the given Attrs.\n\nGroupAttrs is a more efficient version of [Group]\nthat accepts only [Attr] values.\n" ^Attr [^string key & ^{:tag (slice Attr)} attrs]
  (lit Attr key (GroupValue (spread attrs))))


^{:go/end 89} (go/func argsToAttrSlice ^{:tag (slice Attr)} [^{:tag (slice any)} args]
  (let [
      ^{:line 81 :tag Attr} attr (zero Attr)
      ^{:line 82 :tag (slice Attr)} attrs (zero (slice Attr))]

    (while (> (len args) 0)
      (set! (values attr args) (argsToAttr args))
      (set! attrs (append attrs attr)))

    ^{:line 88} attrs))




^{:go/end 95} (go/func Any "Any returns an Attr for the supplied value.\nSee [AnyValue] for how values are treated.\n" ^Attr [^string key ^any value]
  (lit Attr key (AnyValue value)))



^{:go/end 100} (go/method Equal "Equal reports whether a and b have equal keys and values.\n" ^bool [^Attr a ^Attr b]
  (and (== (.-Key a) (.-Key b)) (.Equal (.-Value a) (.-Value b))))


^{:go/end 104} (go/method String ^string [^Attr a]
  (+ (.-Key a) "=" (.String (.-Value a))))




^{:go/end 110} (go/method isEmpty "isEmpty reports whether a has an empty key and a nil value.\nThat can be written as Attr{} or Any(\"\", nil).\n" ^bool [^Attr a]
  (and (== (.-Key a) "") (== (.-num (.-Value a)) 0) (== (.-any (.-Value a)) nil)))

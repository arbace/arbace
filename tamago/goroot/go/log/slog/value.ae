    (case [uint]
      (return (Uint64Value (conv uint64 v))))
    (case [int64]
      (return (Int64Value v)))
    (case [uint64]
      (return (Uint64Value v)))
    (case [bool]
      (return (BoolValue v)))
    (case [time/Duration]
      (return (DurationValue v)))
    (case [time/Time]
      (return (TimeValue v)))
    (case [uint8]
      (return (Uint64Value (conv uint64 v))))
    (case [uint16]
      (return (Uint64Value (conv uint64 v))))
    (case [uint32]
      (return (Uint64Value (conv uint64 v))))
    (case [uintptr]
      (return (Uint64Value (conv uint64 v))))
    (case [int8]
      (return (Int64Value (conv int64 v))))
    (case [int16]
      (return (Int64Value (conv int64 v))))
    (case [int32]
      (return (Int64Value (conv int64 v))))
    (case [float64]
      (return (Float64Value v)))
    (case [float32]
      (return (Float64Value (conv float64 v))))
    (case [(slice Attr)]
      (return (GroupValue (spread v))))
    (case [Kind]
      (return (lit Value :any (conv kind v))))
    (case [Value]
      (return v))
    (default

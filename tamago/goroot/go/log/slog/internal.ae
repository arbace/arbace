(ns go.log.slog.internal
  (:require [arbace.go :as go]))

(go/package internal
  :path "log/slog/internal"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["ignorepc.go"]
  :init-order [IgnorePC]
  :positions :lines)

(load "internal/ignorepc")

(in-ns 'go.log.slog) (go/file "multi_handler.go" :imports [


    ^{:line 8} [context "context"]
    ^{:line 9} [errors "errors"]])



^{:go/end 17} (go/func NewMultiHandler "NewMultiHandler creates a [MultiHandler] with the given Handlers.\n" ^{:tag (* MultiHandler)} [& ^{:tag (slice Handler)} handlers]
  (let [h (make (slice Handler) (len handlers))]
    (copy h handlers)
    (addr (lit MultiHandler :multi h))))





(go/type MultiHandler "MultiHandler is a [Handler] that invokes all the given Handlers.\nIts Enabled method reports whether any of the handlers' Enabled methods return true.\nIts Handle, WithAttrs and WithGroup methods call the corresponding method on each of the enabled handlers.\n" (struct
    ^{:line 23 :tag (slice Handler)} multi))


^{:go/breaks [[4 32]] :go/end 33} (go/method Enabled ^bool [^{:tag (* MultiHandler)} h ^context/Context ctx ^Level l]
  (range [i (.-multi h)]
    (when (.Enabled (aget (.-multi h) i) ctx l)
      (return true)))


  false)


^{:go/end 45} (go/method Handle ^error [^{:tag (* MultiHandler)} h ^context/Context ctx ^Record r]
  (let [^{:tag (slice error)} errs (zero (slice error))]
    (range [i (.-multi h)]
      (when (.Enabled (aget (.-multi h) i) ctx (.-Level r))
        (when [err (.Handle (aget (.-multi h) i) ctx (.Clone r))] (!= err nil)
          (set! errs (append errs err)))))



    (errors/Join (spread errs))))


^{:go/end 53} (go/method WithAttrs ^Handler [^{:tag (* MultiHandler)} h ^{:tag (slice Attr)} attrs]
  (let [handlers (make (slice Handler) 0 (len (.-multi h)))]
    (range [i (.-multi h)]
      (set! handlers (append handlers (.WithAttrs (aget (.-multi h) i) attrs))))

    (addr (lit MultiHandler :multi handlers))))


^{:go/end 61} (go/method WithGroup ^Handler [^{:tag (* MultiHandler)} h ^string name]
  (let [handlers (make (slice Handler) 0 (len (.-multi h)))]
    (range [i (.-multi h)]
      (set! handlers (append handlers (.WithGroup (aget (.-multi h) i) name))))

    (addr (lit MultiHandler :multi handlers))))

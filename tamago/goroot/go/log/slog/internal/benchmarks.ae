(ns go.log.slog.internal.benchmarks
  (:require [arbace.go :as go]))

(go/package benchmarks
  :path "log/slog/internal/benchmarks"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["benchmarks.go" "handlers.go"]
  :init-order [testTime testString testInt testDuration testError testEvent testAttrs]
  :positions :lines)

(load "benchmarks/benchmarks")
(load "benchmarks/handlers")

(in-ns 'go.log.slog.internal.benchmarks) (go/file "handlers.go" :imports [

    ;; Handlers for benchmarking.


    ^{:line 10} [context "context"]
    ^{:line 11} [fmt "fmt"]
    ^{:line 12} [io "io"]
    ^{:line 13} [slog "log/slog"]
    ^{:line 14} [buffer "log/slog/internal/buffer"]
    ^{:line 15} [strconv "strconv"]
    ^{:line 16} [time "time"]])









(go/type fastTextHandler "A fastTextHandler writes a Record to an io.Writer in a format similar to\nslog.TextHandler, but without quoting or locking. It has a few other\nperformance-motivated shortcuts, like writing times as seconds since the\nepoch instead of strings.\n\nIt is intended to represent a high-performance Handler that synchronously\nwrites text (as opposed to binary).\n" (struct
    ^{:line 27 :tag io/Writer} w))


^{:go/end 32} (go/func newFastTextHandler ^slog/Handler [^io/Writer w]
  (addr (lit fastTextHandler :w w)))


^{:go/end 34} (go/method Enabled ^bool [^{:tag (* fastTextHandler)} h context/Context slog/Level] true)

^{:go/end 60} (go/method Handle ^error [^{:tag (* fastTextHandler)} h ^context/Context _ ^slog/Record r]
  (let [buf (buffer/New)]
    (defer (.Free buf))

    (when (not (.IsZero (.-Time r)))
      (.WriteString buf "time=")
      (.appendTime h buf (.-Time r))
      (.WriteByte buf \space))

    (.WriteString buf "level=")
    (set! @buf (strconv/AppendInt @buf (conv int64 (.-Level r)) 10))
    (.WriteByte buf \space)
    (.WriteString buf "msg=")
    (.WriteString buf (.-Message r))
    (.Attrs r ^{:go/breaks [6] :go/end 56} (fn ^bool [^slog/Attr a]
        (.WriteByte buf \space)
        (.WriteString buf (.-Key a))
        (.WriteByte buf \=)
        (.appendValue h buf (.-Value a))
        true))

    (.WriteByte buf \newline)
    (let [(values _ err) (.Write (.-w h) @buf)]
      ^{:line 59} err)))


^{:go/end 89} (go/method appendValue [^{:tag (* fastTextHandler)} h ^{:tag (* buffer/Buffer)} buf ^slog/Value v]
  (switch (.Kind v)
    (case [slog/KindString]
      (.WriteString buf (.String v)))
    (case [slog/KindInt64]
      (set! @buf (strconv/AppendInt @buf (.Int64 v) 10)))
    (case [slog/KindUint64]
      (set! @buf (strconv/AppendUint @buf (.Uint64 v) 10)))
    (case [slog/KindFloat64]
      (set! @buf (strconv/AppendFloat @buf (.Float64 v) \g -1 64)))
    (case [slog/KindBool]
      (set! @buf (strconv/AppendBool @buf (.Bool v))))
    (case [slog/KindDuration]
      (set! @buf (strconv/AppendInt @buf (.Nanoseconds (.Duration v)) 10)))
    (case [slog/KindTime]
      (.appendTime h buf (.Time v)))
    (case [slog/KindAny]
      (let [a (.Any v)]
        (type-switch [a a]
          (case [error]
            (.WriteString buf (.Error a)))
          (default
            (fmt/Fprint buf a)))))

    (default
      (panic (fmt/Sprintf "bad kind: %s" (.Kind v))))))



^{:go/end 93} (go/method appendTime [^{:tag (* fastTextHandler)} h ^{:tag (* buffer/Buffer)} buf ^time/Time t]
  (set! @buf (strconv/AppendInt @buf (.Unix t) 10)))


^{:go/end 97} (go/method WithAttrs ^slog/Handler [^{:tag (* fastTextHandler)} h (slice slog/Attr)]
  (panic "fastTextHandler: With unimplemented"))


^{:go/end 101} (go/method WithGroup ^slog/Handler [(* fastTextHandler) string]
  (panic "fastTextHandler: WithGroup unimplemented"))










(go/type asyncHandler "An asyncHandler simulates a Handler that passes Records to a\nbackground goroutine for processing.\nBecause sending to a channel can be expensive due to locking,\nwe simulate a lock-free queue by adding the Record to a ring buffer.\nOmitting the locking makes this little more than a copy of the Record,\nbut that is a worthwhile thing to measure because Records are on the large\nside. Since nothing actually reads from the ring buffer, it can handle an\narbitrary number of Records without either blocking or allocation.\n" (struct
    ^{:line 112 :tag (array 100 slog/Record)} ringBuffer
    ^{:line 113 :tag int} next))


^{:go/end 118} (go/func newAsyncHandler ^{:tag (* asyncHandler)} []
  (addr (lit asyncHandler)))


^{:go/end 120} (go/method Enabled ^bool [(* asyncHandler) context/Context slog/Level] true)

^{:go/breaks [5] :go/end 126} (go/method Handle ^error [^{:tag (* asyncHandler)} h ^context/Context _ ^slog/Record r]
  (aset (.-ringBuffer h) (.-next h) (.Clone r))
  (set! (.-next h) (% (+ (.-next h) 1) (len (.-ringBuffer h))))
  nil)


^{:go/end 130} (go/method WithAttrs ^slog/Handler [(* asyncHandler) (slice slog/Attr)]
  (panic "asyncHandler: With unimplemented"))


^{:go/end 134} (go/method WithGroup ^slog/Handler [(* asyncHandler) string]
  (panic "asyncHandler: WithGroup unimplemented"))



(go/type disabledHandler "A disabledHandler's Enabled method always returns false.\n" (struct))

^{:go/end 139} (go/method Enabled ^bool [disabledHandler context/Context slog/Level] false)
^{:go/end 140} (go/method Handle ^error [disabledHandler context/Context slog/Record] (panic "should not be called"))

^{:go/end 144} (go/method WithAttrs ^slog/Handler [disabledHandler (slice slog/Attr)]
  (panic "disabledHandler: With unimplemented"))


^{:go/end 148} (go/method WithGroup ^slog/Handler [disabledHandler string]
  (panic "disabledHandler: WithGroup unimplemented"))

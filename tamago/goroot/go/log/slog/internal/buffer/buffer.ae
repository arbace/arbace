;; Package buffer provides a pool-allocated byte buffer.
(in-ns 'go.log.slog.internal.buffer) (go/file "buffer.go" :doc "Package buffer provides a pool-allocated byte buffer.\n" :imports [

    ^{:line 8} [sync "sync"]])





(go/type Buffer "Buffer is a byte buffer.\n\nThis implementation is adapted from the unexported type buffer\nin go/src/fmt/print.go.\n" (slice byte))


(go/var ^{:doc "Having an initial size gives a dramatic speedup.\n"} bufPool ^{:go/breaks [2]} (lit sync/Pool
    :New ^{:go/end 21} (fn ^any []
      (let [b (make (slice byte) 0 1024)]
        (conv (* Buffer) (addr b))))))



^{:go/end 26} (go/func New ^{:tag (* Buffer)} []
  (assert (* Buffer) (.Get bufPool)))


^{:go/end 35} (go/method Free [^{:tag (* Buffer)} b]
  ;; To reduce peak allocation, return only smaller buffers to the pool.
  (let [^:const ^{:val 16384} maxBufferSize (<< 16 10)]
    (when (<= (cap @b) maxBufferSize)
      (set! @b (subslice @b _ 0))
      (.Put bufPool b))))



^{:go/end 39} (go/method Reset [^{:tag (* Buffer)} b]
  (.SetLen b 0))


^{:go/end 44} (go/method Write [^{:tag (* Buffer)} b ^{:tag (slice byte)} p] :results [int error]
  (set! @b (append @b (spread p)))
  (return (len p) nil))


^{:go/end 49} (go/method WriteString [^{:tag (* Buffer)} b ^string s] :results [int error]
  (set! @b (append @b (spread s)))
  (return (len s) nil))


^{:go/breaks [4] :go/end 54} (go/method WriteByte ^error [^{:tag (* Buffer)} b ^byte c]
  (set! @b (append @b c))
  nil)


^{:go/end 58} (go/method String ^string [^{:tag (* Buffer)} b]
  (conv string @b))


^{:go/end 62} (go/method Len ^int [^{:tag (* Buffer)} b]
  (len @b))


^{:go/end 66} (go/method SetLen [^{:tag (* Buffer)} b ^int n]
  (set! @b (subslice @b _ n)))

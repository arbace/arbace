(ns go.log.slog.internal.buffer
  (:require [arbace.go :as go]))

(go/package buffer
  :path "log/slog/internal/buffer"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["buffer.go"]
  :init-order [bufPool]
  :positions :lines)

(load "buffer/buffer")

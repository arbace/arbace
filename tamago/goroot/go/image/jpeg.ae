(ns go.image.jpeg
  (:require [arbace.go :as go]))

(go/package jpeg
  :path "image/jpeg"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["dct.go" "huffman.go" "reader.go" "scan.go" "writer.go"]
  :init-order [errShortHuffmanData errUnsupportedSubsamplingRatio unzig errMissingFF00 bitCount unscaledQuant theHuffmanSpec sosHeaderY sosHeaderYCbCr]
  :positions :lines)

(load "jpeg/dct")
(load "jpeg/huffman")
(load "jpeg/reader")
(load "jpeg/scan")
(load "jpeg/writer")

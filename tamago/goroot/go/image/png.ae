(ns go.image.png
  (:require [arbace.go :as go]))

(go/package png
  :path "image/png"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["paeth.go" "reader.go" "writer.go"]
  :init-order [interlacing chunkOrderError]
  :positions :lines)

(load "png/paeth")
(load "png/reader")
(load "png/writer")

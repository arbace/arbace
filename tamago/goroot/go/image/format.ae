      (return m (.-name f) err))))









^{:go/end 118} (go/func DecodeConfig "DecodeConfig decodes the color model and dimensions of an image that has\nbeen encoded in a registered format. The string returned is the format name\nused during format registration. Format registration is typically done by\nan init function in the codec-specific package.\n\nDecodeConfig reads only format headers and does not allocate a full-size\npixel buffer, so it can be used to check dimensions before calling [Decode].\n" [^io/Reader r] :results [Config string error]
  (let [rr (asReader r)

(ns go.image.color.palette
  (:require [arbace.go :as go]))

(go/package palette
  :path "image/color/palette"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["generate.go" "palette.go"]
  :init-order [Plan9 WebSafe]
  :positions :lines)

(load "palette/generate")
(load "palette/palette")

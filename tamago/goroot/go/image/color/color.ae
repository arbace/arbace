(go/type Palette "Palette is a palette of colors.\n" (slice Color))


^{:go/end 288} (go/method Convert "Convert returns the palette color closest to c in Euclidean R,G,B space.\n" ^Color [^Palette p ^Color c]
  (when (== (len p) 0)
    (return nil))

  (aget p (.Index p c)))




^{:go/end 308} (go/method Index "Index returns the index of the palette color closest to c in Euclidean\nR,G,B,A space.\n" ^int [^Palette p ^Color c]
  ;; A batch version of this computation is in image/draw/draw.go.

  (let [(values cr cg cb ca) (.RGBA c)
      (values ret bestSum) (values 0 (conv uint32 (- (<< 1 32) 1)))]
    (range [i v p]
      (let [(values vr vg vb va) (.RGBA v)
          ^{:line 299} sum (+ (sqDiff cr vr) (sqDiff cg vg) (sqDiff cb vb) (sqDiff ca va))]
        (when (< sum bestSum)
          (when (== sum 0)
            (return i))

          (set! (values ret bestSum) (values i sum)))))


    ^{:line 307} ret))






^{:go/end 339} (go/func sqDiff "sqDiff returns the squared-difference of x and y, shifted by 2 so that\nadding four of those won't overflow a uint32.\n\nx and y are both assumed to be in the range [0, 0xffff].\n" ^uint32 [^uint32 x ^uint32 y]
  ;; The canonical code of this function looks as follows:
  ;;
  ;;	var d uint32
  ;;	if x > y {
  ;;		d = x - y
  ;;	} else {
  ;;		d = y - x
  ;;	}
  ;;	return (d * d) >> 2
  ;;
  ;; Language spec guarantees the following properties of unsigned integer
  ;; values operations with respect to overflow/wrap around:
  ;;
  ;; > For unsigned integer values, the operations +, -, *, and << are
  ;; > computed modulo 2n, where n is the bit width of the unsigned
  ;; > integer's type. Loosely speaking, these unsigned integer operations
  ;; > discard high bits upon overflow, and programs may rely on ``wrap
  ;; > around''.
  ;;
  ;; Considering these properties and the fact that this function is
  ;; called in the hot paths (x,y loops), it is reduced to the below code
  ;; which is slightly faster. See TestSqDiff for correctness check.
  (let [d (- x y)]
    (>> (* d d) 2)))




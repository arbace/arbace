    ^{:line 157 :tag (func [Color] [Color])} f))


^{:go/end 162} (go/method Convert ^Color [^{:tag (* modelFunc)} m ^Color c]
  ((.-f m) c))



(go/var "Models for the standard color types.\n"
  ^{:line 166} [^Model RGBAModel (ModelFunc rgbaModel)]
  ^{:line 167} [^Model RGBA64Model (ModelFunc rgba64Model)]
  ^{:line 168} [^Model NRGBAModel (ModelFunc nrgbaModel)]
  ^{:line 169} [^Model NRGBA64Model (ModelFunc nrgba64Model)]
  ^{:line 170} [^Model AlphaModel (ModelFunc alphaModel)]
  ^{:line 171} [^Model Alpha16Model (ModelFunc alpha16Model)]
  ^{:line 172} [^Model GrayModel (ModelFunc grayModel)]
  ^{:line 173} [^Model Gray16Model (ModelFunc gray16Model)])


^{:go/end 182} (go/func rgbaModel ^Color [^Color c]
  (when [(values _ ok) (assert RGBA c)] ok
    (return c))

  (let [(values r g b a) (.RGBA c)]
    (lit RGBA (conv uint8 (>> r 8)) (conv uint8 (>> g 8)) (conv uint8 (>> b 8)) (conv uint8 (>> a 8)))))


^{:go/end 190} (go/func rgba64Model ^Color [^Color c]
  (when [(values _ ok) (assert RGBA64 c)] ok
    (return c))

  (let [(values r g b a) (.RGBA c)]
    (lit RGBA64 (conv uint16 r) (conv uint16 g) (conv uint16 b) (conv uint16 a))))


^{:go/end 208} (go/func nrgbaModel ^Color [^Color c]
  (when [(values _ ok) (assert NRGBA c)] ok
    (return c))

  (let [(values r g b a) (.RGBA c)]
    (when (== a 0xffff)
      (return (lit NRGBA (conv uint8 (>> r 8)) (conv uint8 (>> g 8)) (conv uint8 (>> b 8)) 0xff)))

    (when (== a 0)
      (return (lit NRGBA 0 0 0 0)))

    ;; Since Color.RGBA returns an alpha-premultiplied color, we should have r <= a && g <= a && b <= a.
    (set! r (/ (* r 0xffff) a))
    (set! g (/ (* g 0xffff) a))
    (set! b (/ (* b 0xffff) a))
    (lit NRGBA (conv uint8 (>> r 8)) (conv uint8 (>> g 8)) (conv uint8 (>> b 8)) (conv uint8 (>> a 8)))))


^{:go/end 226} (go/func nrgba64Model ^Color [^Color c]
  (when [(values _ ok) (assert NRGBA64 c)] ok
    (return c))

  (let [(values r g b a) (.RGBA c)]
    (when (== a 0xffff)
      (return (lit NRGBA64 (conv uint16 r) (conv uint16 g) (conv uint16 b) 0xffff)))

    (when (== a 0)
      (return (lit NRGBA64 0 0 0 0)))

    ;; Since Color.RGBA returns an alpha-premultiplied color, we should have r <= a && g <= a && b <= a.
    (set! r (/ (* r 0xffff) a))
    (set! g (/ (* g 0xffff) a))
    (set! b (/ (* b 0xffff) a))
    (lit NRGBA64 (conv uint16 r) (conv uint16 g) (conv uint16 b) (conv uint16 a))))



(go/type Model "Model can convert any [Color] to one from its own color model. The conversion\nmay be lossy.\n" (interface
    (Convert ^Color [^Color c])))



^{:go/end 154} (go/func ModelFunc "ModelFunc returns a [Model] that invokes f to implement the conversion.\n" ^Model [^{:tag (func [Color] [Color])} f]
  ;; Note: using *modelFunc as the implementation
  ;; means that callers can still use comparisons
  ;; like m == RGBAModel. This is not possible if
  ;; we use the func value directly, because funcs
  ;; are no longer comparable.
  (addr (lit modelFunc f)))



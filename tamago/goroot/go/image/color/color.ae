;; Package color implements a basic color library.
(in-ns 'go.image.color) (go/file "color.go" :doc "Package color implements a basic color library.\n" :imports [])



(go/type Color "Color can convert itself to alpha-premultiplied 16-bits per channel RGBA.\nThe conversion may be lossy.\n" (interface







    (^{:doc "RGBA returns the alpha-premultiplied red, green, blue and alpha values\nfor the color. Each value ranges within [0, 0xffff], but is represented\nby a uint32 so that multiplying by a blend factor up to 0xffff will not\noverflow.\n\nAn alpha-premultiplied color component c has been scaled by alpha (a),\nso has valid values 0 <= c <= a.\n"} RGBA [] :results [^uint32 r ^uint32 g ^uint32 b ^uint32 a])))







(go/type RGBA "RGBA represents a traditional 32-bit alpha-premultiplied color, having 8\nbits for each of red, green, blue and alpha.\n\nAn alpha-premultiplied color component C has been scaled by alpha (A), so\nhas valid values 0 <= C <= A.\n" (struct
    ^{:line 27 :tag uint8} R ^uint8 G ^uint8 B ^uint8 A))


^{:go/end 40} (go/method RGBA [^RGBA c] :results [^uint32 r ^uint32 g ^uint32 b ^uint32 a]
  (set! r (conv uint32 (.-R c)))
  (set! r bit-or (<< r 8))
  (set! g (conv uint32 (.-G c)))
  (set! g bit-or (<< g 8))
  (set! b (conv uint32 (.-B c)))
  (set! b bit-or (<< b 8))
  (set! a (conv uint32 (.-A c)))
  (set! a bit-or (<< a 8))
  (return))







(go/type RGBA64 "RGBA64 represents a 64-bit alpha-premultiplied color, having 16 bits for\neach of red, green, blue and alpha.\n\nAn alpha-premultiplied color component C has been scaled by alpha (A), so\nhas valid values 0 <= C <= A.\n" (struct
    ^{:line 48 :tag uint16} R ^uint16 G ^uint16 B ^uint16 A))


^{:go/end 53} (go/method RGBA [^RGBA64 c] :results [^uint32 r ^uint32 g ^uint32 b ^uint32 a]
  (return (conv uint32 (.-R c)) (conv uint32 (.-G c)) (conv uint32 (.-B c)) (conv uint32 (.-A c))))



(go/type NRGBA "NRGBA represents a non-alpha-premultiplied 32-bit color.\n" (struct
    ^{:line 57 :tag uint8} R ^uint8 G ^uint8 B ^uint8 A))


^{:go/end 76} (go/method RGBA [^NRGBA c] :results [^uint32 r ^uint32 g ^uint32 b ^uint32 a]
  (set! r (conv uint32 (.-R c)))
  (set! r bit-or (<< r 8))
  (set! r * (conv uint32 (.-A c)))
  (set! r / 0xff)
  (set! g (conv uint32 (.-G c)))
  (set! g bit-or (<< g 8))
  (set! g * (conv uint32 (.-A c)))
  (set! g / 0xff)
  (set! b (conv uint32 (.-B c)))
  (set! b bit-or (<< b 8))
  (set! b * (conv uint32 (.-A c)))
  (set! b / 0xff)
  (set! a (conv uint32 (.-A c)))
  (set! a bit-or (<< a 8))
  (return))




(go/type NRGBA64 "NRGBA64 represents a non-alpha-premultiplied 64-bit color,\nhaving 16 bits for each of red, green, blue and alpha.\n" (struct
    ^{:line 81 :tag uint16} R ^uint16 G ^uint16 B ^uint16 A))


^{:go/end 96} (go/method RGBA [^NRGBA64 c] :results [^uint32 r ^uint32 g ^uint32 b ^uint32 a]
  (set! r (conv uint32 (.-R c)))
  (set! r * (conv uint32 (.-A c)))
  (set! r / 0xffff)
  (set! g (conv uint32 (.-G c)))
  (set! g * (conv uint32 (.-A c)))
  (set! g / 0xffff)
  (set! b (conv uint32 (.-B c)))
  (set! b * (conv uint32 (.-A c)))
  (set! b / 0xffff)
  (set! a (conv uint32 (.-A c)))
  (return))




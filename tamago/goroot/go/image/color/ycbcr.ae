(in-ns 'go.image.color) (go/file "ycbcr.go" :imports [])


^{:go/end 55} (go/func RGBToYCbCr "RGBToYCbCr converts an RGB triple to a Y'CbCr triple.\n" [^uint8 r ^uint8 g ^uint8 b] :results [uint8 uint8 uint8]
  ;; The JFIF specification says:
  ;;	Y' =  0.2990*R + 0.5870*G + 0.1140*B
  ;;	Cb = -0.1687*R - 0.3313*G + 0.5000*B + 128
  ;;	Cr =  0.5000*R - 0.4187*G - 0.0813*B + 128
  ;; https://www.w3.org/Graphics/JPEG/jfif3.pdf says Y but means Y'.

  (let [r1 (conv int32 r)
      ^{:line 16} g1 (conv int32 g)
      ^{:line 17} b1 (conv int32 b)

      ;; yy is in range [0,0xff].
      ;;
      ;; Note that 19595 + 38470 + 7471 equals 65536.
      ^{:line 22} yy (>> (+ (* 19595 r1) (* 38470 g1) (* 7471 b1) (<< 1 15)) 16)

      ;; The bit twiddling below is equivalent to
      ;;
      ;; cb := (-11056*r1 - 21712*g1 + 32768*b1 + 257<<15) >> 16
      ;; if cb < 0 {
      ;;     cb = 0
      ;; } else if cb > 0xff {
      ;;     cb = ^int32(0)
      ;; }
      ;;
      ;; but uses fewer branches and is faster.
      ;; Note that the uint8 type conversion in the return
      ;; statement will convert ^int32(0) to 0xff.
      ;; The code below to compute cr uses a similar pattern.
      ;;
      ;; Note that -11056 - 21712 + 32768 equals 0.
      ^{:line 39} cb (+ (- (* -11056 r1) (* 21712 g1)) (* 32768 b1) (<< 257 15))]
    (if (== (bit-and (conv uint32 cb) 0xff000000) 0)
      (set! cb >> 16)

      (set! cb (bit-not (>> cb 31))))


    ;; Note that 32768 - 27440 - 5328 equals 0.
    (let [cr (+ (- (* 32768 r1) (* 27440 g1) (* 5328 b1)) (<< 257 15))]
      (if (== (bit-and (conv uint32 cr) 0xff000000) 0)
        (set! cr >> 16)

        (set! cr (bit-not (>> cr 31))))


      (return (conv uint8 yy) (conv uint8 cb) (conv uint8 cr)))))



^{:go/end 154} (go/func YCbCrToRGB "YCbCrToRGB converts a Y'CbCr triple to an RGB triple.\n" [^uint8 y ^uint8 cb ^uint8 cr] :results [uint8 uint8 uint8]
  ;; The JFIF specification says:
  ;;	R = Y' + 1.40200*(Cr-128)
  ;;	G = Y' - 0.34414*(Cb-128) - 0.71414*(Cr-128)
  ;;	B = Y' + 1.77200*(Cb-128)
  ;; https://www.w3.org/Graphics/JPEG/jfif3.pdf says Y but means Y'.
  ;;
  ;; Those formulae use non-integer multiplication factors. When computing,
  ;; integer math is generally faster than floating point math. We multiply
  ;; all of those factors by 1<<16 and round to the nearest integer:
  ;;	 91881 = roundToNearestInteger(1.40200 * 65536).
  ;;	 22554 = roundToNearestInteger(0.34414 * 65536).
  ;;	 46802 = roundToNearestInteger(0.71414 * 65536).
  ;;	116130 = roundToNearestInteger(1.77200 * 65536).
  ;;
  ;; Adding a rounding adjustment in the range [0, 1<<16-1] and then shifting
  ;; right by 16 gives us an integer math version of the original formulae.
  ;;	R = (65536*Y' +  91881 *(Cr-128)                  + adjustment) >> 16
  ;;	G = (65536*Y' -  22554 *(Cb-128) - 46802*(Cr-128) + adjustment) >> 16
  ;;	B = (65536*Y' + 116130 *(Cb-128)                  + adjustment) >> 16
  ;; A constant rounding adjustment of 1<<15, one half of 1<<16, would mean
  ;; round-to-nearest when dividing by 65536 (shifting right by 16).
  ;; Similarly, a constant rounding adjustment of 0 would mean round-down.
  ;;
  ;; Defining YY1 = 65536*Y' + adjustment simplifies the formulae and
  ;; requires fewer CPU operations:
  ;;	R = (YY1 +  91881 *(Cr-128)                 ) >> 16
  ;;	G = (YY1 -  22554 *(Cb-128) - 46802*(Cr-128)) >> 16
  ;;	B = (YY1 + 116130 *(Cb-128)                 ) >> 16
  ;;
  ;; The inputs (y, cb, cr) are 8 bit color, ranging in [0x00, 0xff]. In this
  ;; function, the output is also 8 bit color, but in the related YCbCr.RGBA
  ;; method, below, the output is 16 bit color, ranging in [0x0000, 0xffff].
  ;; Outputting 16 bit color simply requires changing the 16 to 8 in the "R =
  ;; etc >> 16" equation, and likewise for G and B.
  ;;
  ;; As mentioned above, a constant rounding adjustment of 1<<15 is a natural
  ;; choice, but there is an additional constraint: if c0 := YCbCr{Y: y, Cb:
  ;; 0x80, Cr: 0x80} and c1 := Gray{Y: y} then c0.RGBA() should equal
  ;; c1.RGBA(). Specifically, if y == 0 then "R = etc >> 8" should yield
  ;; 0x0000 and if y == 0xff then "R = etc >> 8" should yield 0xffff. If we
  ;; used a constant rounding adjustment of 1<<15, then it would yield 0x0080
  ;; and 0xff80 respectively.
  ;;
  ;; Note that when cb == 0x80 and cr == 0x80 then the formulae collapse to:
  ;;	R = YY1 >> n
  ;;	G = YY1 >> n
  ;;	B = YY1 >> n
  ;; where n is 16 for this function (8 bit color output) and 8 for the
  ;; YCbCr.RGBA method (16 bit color output).
  ;;
  ;; The solution is to make the rounding adjustment non-constant, and equal
  ;; to 257*Y', which ranges over [0, 1<<16-1] as Y' ranges over [0, 255].
  ;; YY1 is then defined as:
  ;;	YY1 = 65536*Y' + 257*Y'
  ;; or equivalently:
  ;;	YY1 = Y' * 0x10101
  (let [yy1 (* (conv int32 y) 0x10101)
      ^{:line 116} cb1 (- (conv int32 cb) 128)
      ^{:line 117} cr1 (- (conv int32 cr) 128)

      ;; The bit twiddling below is equivalent to
      ;;
      ;; r := (yy1 + 91881*cr1) >> 16
      ;; if r < 0 {
      ;;     r = 0
      ;; } else if r > 0xff {
      ;;     r = ^int32(0)
      ;; }
      ;;
      ;; but uses fewer branches and is faster.
      ;; Note that the uint8 type conversion in the return
      ;; statement will convert ^int32(0) to 0xff.
      ;; The code below to compute g and b uses a similar pattern.
      ^{:line 132} r (+ yy1 (* 91881 cr1))]
    (if (== (bit-and (conv uint32 r) 0xff000000) 0)
      (set! r >> 16)

      (set! r (bit-not (>> r 31))))


    (let [g (- yy1 (* 22554 cb1) (* 46802 cr1))]
      (if (== (bit-and (conv uint32 g) 0xff000000) 0)
        (set! g >> 16)

        (set! g (bit-not (>> g 31))))


      (let [b (+ yy1 (* 116130 cb1))]
        (if (== (bit-and (conv uint32 b) 0xff000000) 0)
          (set! b >> 16)

          (set! b (bit-not (>> b 31))))


        (return (conv uint8 r) (conv uint8 g) (conv uint8 b))))))













(go/type YCbCr "YCbCr represents a fully opaque 24-bit Y'CbCr color, having 8 bits each for\none luma and two chroma components.\n\nJPEG, VP8, the MPEG family and other codecs use this color model. Such\ncodecs often use the terms YUV and Y'CbCr interchangeably, but strictly\nspeaking, the term YUV applies only to analog video signals, and Y' (luma)\nis Y (luminance) after applying gamma correction.\n\nConversion between RGB and Y'CbCr is lossy and there are multiple, slightly\ndifferent formulae for converting between the two. This package follows\nthe JFIF specification at https://www.w3.org/Graphics/JPEG/jfif3.pdf.\n" (struct
    ^{:line 168 :tag uint8} Y ^uint8 Cb ^uint8 Cr))


^{:go/end 226} (go/method RGBA [^YCbCr c] :results [uint32 uint32 uint32 uint32]
  ;; This code is a copy of the YCbCrToRGB function above, except that it
  ;; returns values in the range [0, 0xffff] instead of [0, 0xff]. There is a
  ;; subtle difference between doing this and having YCbCr satisfy the Color
  ;; interface by first converting to an RGBA. The latter loses some
  ;; information by going to and from 8 bits per channel.
  ;;
  ;; For example, this code:
  ;;	const y, cb, cr = 0x7f, 0x7f, 0x7f
  ;;	r, g, b := color.YCbCrToRGB(y, cb, cr)
  ;;	r0, g0, b0, _ := color.YCbCr{y, cb, cr}.RGBA()
  ;;	r1, g1, b1, _ := color.RGBA{r, g, b, 0xff}.RGBA()
  ;;	fmt.Printf("0x%04x 0x%04x 0x%04x\n", r0, g0, b0)
  ;;	fmt.Printf("0x%04x 0x%04x 0x%04x\n", r1, g1, b1)
  ;; prints:
  ;;	0x7e18 0x808d 0x7db9
  ;;	0x7e7e 0x8080 0x7d7d

  (let [yy1 (* (conv int32 (.-Y c)) 0x10101)
      ^{:line 190} cb1 (- (conv int32 (.-Cb c)) 128)
      ^{:line 191} cr1 (- (conv int32 (.-Cr c)) 128)

      ;; The bit twiddling below is equivalent to
      ;;
      ;; r := (yy1 + 91881*cr1) >> 8
      ;; if r < 0 {
      ;;     r = 0
      ;; } else if r > 0xff {
      ;;     r = 0xffff
      ;; }
      ;;
      ;; but uses fewer branches and is faster.
      ;; The code below to compute g and b uses a similar pattern.
      ^{:line 204} r (+ yy1 (* 91881 cr1))]
    (if (== (bit-and (conv uint32 r) 0xff000000) 0)
      (set! r >> 8)

      (set! r (bit-and (bit-not (>> r 31)) 0xffff)))


    (let [g (- yy1 (* 22554 cb1) (* 46802 cr1))]
      (if (== (bit-and (conv uint32 g) 0xff000000) 0)
        (set! g >> 8)

        (set! g (bit-and (bit-not (>> g 31)) 0xffff)))


      (let [b (+ yy1 (* 116130 cb1))]
        (if (== (bit-and (conv uint32 b) 0xff000000) 0)
          (set! b >> 8)

          (set! b (bit-and (bit-not (>> b 31)) 0xffff)))


        (return (conv uint32 r) (conv uint32 g) (conv uint32 b) 0xffff)))))



(go/var ^{:tag Model :doc "YCbCrModel is the [Model] for Y'CbCr colors.\n"} YCbCrModel (ModelFunc yCbCrModel))

^{:go/end 238} (go/func yCbCrModel ^Color [^Color c]
  (when [(values _ ok) (assert YCbCr c)] ok
    (return c))

  (let [(values r g b _) (.RGBA c)
      (values y u v) (RGBToYCbCr (conv uint8 (>> r 8)) (conv uint8 (>> g 8)) (conv uint8 (>> b 8)))]
    (lit YCbCr y u v)))




(go/type NYCbCrA "NYCbCrA represents a non-alpha-premultiplied Y'CbCr-with-alpha color, having\n8 bits each for one luma, two chroma and one alpha component.\n" (struct
    ^{:line 243} YCbCr
    ^{:line 244 :tag uint8} A))


^{:go/end 288} (go/method RGBA [^NYCbCrA c] :results [uint32 uint32 uint32 uint32]
  ;; The first part of this method is the same as YCbCr.RGBA.
  (let [yy1 (* (conv int32 ^{:go/via [YCbCr]} (.-Y c)) 0x10101)
      ^{:line 250} cb1 (- (conv int32 ^{:go/via [YCbCr]} (.-Cb c)) 128)
      ^{:line 251} cr1 (- (conv int32 ^{:go/via [YCbCr]} (.-Cr c)) 128)

      ;; The bit twiddling below is equivalent to
      ;;
      ;; r := (yy1 + 91881*cr1) >> 8
      ;; if r < 0 {
      ;;     r = 0
      ;; } else if r > 0xff {
      ;;     r = 0xffff
      ;; }
      ;;
      ;; but uses fewer branches and is faster.
      ;; The code below to compute g and b uses a similar pattern.
      ^{:line 264} r (+ yy1 (* 91881 cr1))]
    (if (== (bit-and (conv uint32 r) 0xff000000) 0)
      (set! r >> 8)

      (set! r (bit-and (bit-not (>> r 31)) 0xffff)))


    (let [g (- yy1 (* 22554 cb1) (* 46802 cr1))]
      (if (== (bit-and (conv uint32 g) 0xff000000) 0)
        (set! g >> 8)

        (set! g (bit-and (bit-not (>> g 31)) 0xffff)))


      (let [b (+ yy1 (* 116130 cb1))]
        (if (== (bit-and (conv uint32 b) 0xff000000) 0)
          (set! b >> 8)

          (set! b (bit-and (bit-not (>> b 31)) 0xffff)))


        ;; The second part of this method applies the alpha.
        (let [a (* (conv uint32 (.-A c)) 0x101)]
          (return (/ (* (conv uint32 r) a) 0xffff) (/ (* (conv uint32 g) a) 0xffff) (/ (* (conv uint32 b) a) 0xffff) a))))))




(go/var ^{:tag Model :doc "NYCbCrAModel is the [Model] for non-alpha-premultiplied Y'CbCr-with-alpha\ncolors.\n"} NYCbCrAModel (ModelFunc nYCbCrAModel))

^{:go/end 312} (go/func nYCbCrAModel ^Color [^Color c]
  (type-switch [c c]
    (case [NYCbCrA]
      (return c))
    (case [YCbCr]
      (return (lit NYCbCrA c 0xff))))

  (let [(values r g b a) (.RGBA c)]

    ;; Convert from alpha-premultiplied to non-alpha-premultiplied.
    (when (!= a 0)
      (set! r (/ (* r 0xffff) a))
      (set! g (/ (* g 0xffff) a))
      (set! b (/ (* b 0xffff) a)))


    (let [(values y u v) (RGBToYCbCr (conv uint8 (>> r 8)) (conv uint8 (>> g 8)) (conv uint8 (>> b 8)))]
      (lit NYCbCrA (lit YCbCr :Y y :Cb u :Cr v) (conv uint8 (>> a 8))))))



^{:go/end 333} (go/func RGBToCMYK "RGBToCMYK converts an RGB triple to a CMYK quadruple.\n" [^uint8 r ^uint8 g ^uint8 b] :results [uint8 uint8 uint8 uint8]
  (let [rr (conv uint32 r)
      ^{:line 317} gg (conv uint32 g)
      ^{:line 318} bb (conv uint32 b)
      ^{:line 319} w rr]
    (when (< w gg)
      (set! w gg))

    (when (< w bb)
      (set! w bb))

    (when (== w 0)
      (return 0 0 0 0xff))

    (let [c (/ (* (- w rr) 0xff) w)
        ^{:line 330} m (/ (* (- w gg) 0xff) w)
        ^{:line 331} y (/ (* (- w bb) 0xff) w)]
      (return (conv uint8 c) (conv uint8 m) (conv uint8 y) (conv uint8 (- 0xff w))))))



^{:go/end 342} (go/func CMYKToRGB "CMYKToRGB converts a [CMYK] quadruple to an RGB triple.\n" [^uint8 c ^uint8 m ^uint8 y ^uint8 k] :results [uint8 uint8 uint8]
  (let [w (- 0xffff (* (conv uint32 k) 0x101))
      ^{:line 338} r (/ (* (- 0xffff (* (conv uint32 c) 0x101)) w) 0xffff)
      ^{:line 339} g (/ (* (- 0xffff (* (conv uint32 m) 0x101)) w) 0xffff)
      ^{:line 340} b (/ (* (- 0xffff (* (conv uint32 y) 0x101)) w) 0xffff)]
    (return (conv uint8 (>> r 8)) (conv uint8 (>> g 8)) (conv uint8 (>> b 8)))))






(go/type CMYK "CMYK represents a fully opaque CMYK color, having 8 bits for each of cyan,\nmagenta, yellow and black.\n\nIt is not associated with any particular color profile.\n" (struct
    ^{:line 349 :tag uint8} C ^uint8 M ^uint8 Y ^uint8 K))


^{:go/end 361} (go/method RGBA [^CMYK c] :results [uint32 uint32 uint32 uint32]
  ;; This code is a copy of the CMYKToRGB function above, except that it
  ;; returns values in the range [0, 0xffff] instead of [0, 0xff].

  (let [w (- 0xffff (* (conv uint32 (.-K c)) 0x101))
      ^{:line 357} r (/ (* (- 0xffff (* (conv uint32 (.-C c)) 0x101)) w) 0xffff)
      ^{:line 358} g (/ (* (- 0xffff (* (conv uint32 (.-M c)) 0x101)) w) 0xffff)
      ^{:line 359} b (/ (* (- 0xffff (* (conv uint32 (.-Y c)) 0x101)) w) 0xffff)]
    (return r g b 0xffff)))



(go/var ^{:tag Model :doc "CMYKModel is the [Model] for CMYK colors.\n"} CMYKModel (ModelFunc cmykModel))

^{:go/end 373} (go/func cmykModel ^Color [^Color c]
  (when [(values _ ok) (assert CMYK c)] ok
    (return c))

  (let [(values r g b _) (.RGBA c)
      (values cc mm yy kk) (RGBToCMYK (conv uint8 (>> r 8)) (conv uint8 (>> g 8)) (conv uint8 (>> b 8)))]
    (lit CMYK cc mm yy kk)))

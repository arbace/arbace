^{:go/end 57} (go/method makeImg "makeImg allocates and initializes the destination image.\n" [^{:tag (* decoder)} d ^int mxx ^int myy]
  (when (== (.-nComp d) 1)
    (let [m (image/NewGray (image/Rect 0 0 (* 8 mxx) (* 8 myy)))]
      (set! (.-img1 d) (assert (* image/Gray) (.SubImage m (image/Rect 0 0 (.-width d) (.-height d)))))

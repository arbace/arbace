                (aset b (aget unzig zig) z)))))))



    (when (> (.-eobRun d) 0)
      (dec! (.-eobRun d))
      (when [(values _ err) (.refineNonZeroes d b zig zigEnd -1 delta)] (!= err nil)
        (return err)))


    nil))




^{:go/end 450} (go/method refineNonZeroes "refineNonZeroes refines non-zero entries of b in zig-zag order. If nz >= 0,\nthe first nz zero entries are skipped over.\n" [^{:tag (* decoder)} d ^{:tag (* block)} b ^int32 zig ^int32 zigEnd ^int32 nz ^int32 delta] :results [int32 error]
  (for [] (<= zig zigEnd) (inc! zig)
    (let [u (aget unzig zig)]
      (when (== (aget b u) 0)
        (when (== nz 0)
          (break))

        (dec! nz)
        (continue))

      (let [(values bit err) (.decodeBit d)]
        (when (!= err nil)
          (return 0 err))

        (when (not bit)
          (continue))

        (if (>= (aget b u) 0)
          (set! (aget b u) + delta)

          (set! (aget b u) - delta)))))


  (return zig nil))



^{:go/end 580} (go/method findRST "findRST advances past the next RST restart marker that matches expectedRST.\nOther than I/O errors, it is also an error if we encounter an {0xFF, M}\ntwo-byte marker sequence where M is not 0x00, 0xFF or the expectedRST.\n\nThis is similar to libjpeg's jdmarker.c's next_marker function.\nhttps://github.com/libjpeg-turbo/libjpeg-turbo/blob/2dfe6c0fe9e18671105e94f7cbf044d4a1d157e6/jdmarker.c#L892-L935\n\nPrecondition: d.tmp[:2] holds the next two bytes of JPEG-encoded input\n(input in the d.readFull sense).\n" ^error [^{:tag (* decoder)} d ^uint8 expectedRST]
  (while true
    ;; i is the index such that, at the bottom of the loop, we read 2-i
    ;; bytes into d.tmp[i:2], maintaining the invariant that d.tmp[:2]
    ;; holds the next two bytes of JPEG-encoded input. It is either 0 or 1,
    ;; so that each iteration advances by 1 or 2 bytes (or returns).
    (let [i 0]

      (cond (== (aget (.-tmp d) 0) 0xff)
        (cond (== (aget (.-tmp d) 1) expectedRST)
          (return nil)
          (== (aget (.-tmp d) 1) 0xff)
          (set! i 1)
          (!= (aget (.-tmp d) 1) 0x00)
          ;; libjpeg's jdmarker.c's jpeg_resync_to_restart does something
          ;; fancy here, treating RST markers within two (modulo 8) of
          ;; expectedRST differently from RST markers that are 'more
          ;; distant'. Until we see evidence that recovering from such
          ;; cases is frequent enough to be worth the complexity, we take
          ;; a simpler approach for now. Any marker that's not 0x00, 0xff
          ;; or expectedRST is a fatal FormatError.
          (return (conv FormatError "bad RST marker")))


        (== (aget (.-tmp d) 1) 0xff) (do
          (aset (.-tmp d) 0 0xff)
          (set! i 1)))


      (when [err (.readFull d (subslice (.-tmp d) i 2))] (!= err nil)
        (return err)))))

^{:go/end 422} (go/method refine "refine decodes a successive approximation refinement block, as specified in\nsection G.1.2.\n" ^error [^{:tag (* decoder)} d ^{:tag (* block)} b ^{:tag (* huffman)} h ^int32 zigStart ^int32 zigEnd ^int32 delta]
  ;; Refining a DC component is trivial.
  (when (== zigStart 0)
    (when (!= zigEnd 0)
      (panic "unreachable"))

    (let [(values bit err) (.decodeBit d)]
      (when (!= err nil)
        (return err))

      (when bit
        (set! (aget b 0) bit-or delta))

      (return nil)))


  ;; Refining AC components is more complicated; see sections G.1.2.2 and G.1.2.3.
  ^{:go/breaks [[4 421]]} (let [zig zigStart]
    (when (== (.-eobRun d) 0)
      (label :loop
        (for [] (<= zig zigEnd) (inc! zig)
          (let [z (conv int32 0)
              (values value err) (.decodeHuffman d h)]
            (when (!= err nil)
              (return err))

            (let [val0 (>> value 4)
                ^{:line 375} val1 (bit-and value 0x0f)]

              (switch val1
                (case [0]

      (let [hRatio (/ (.-maxH d) (.-h (aget (.-comp d) 1)))
          ^{:line 30} vRatio (/ (.-maxV d) (.-v (aget (.-comp d) 1)))]
        (switch (bit-or (<< hRatio 4) vRatio)
          (case [0x11]
            (set! subsampleRatio image/YCbCrSubsampleRatio444))
          (case [0x12]
            (set! subsampleRatio image/YCbCrSubsampleRatio440))
          (case [0x21]
            (set! subsampleRatio image/YCbCrSubsampleRatio422))
          (case [0x22]
            (set! subsampleRatio image/YCbCrSubsampleRatio420))
          (case [0x41]
            (set! subsampleRatio image/YCbCrSubsampleRatio411))
          (case [0x42]
            (set! subsampleRatio image/YCbCrSubsampleRatio410))
          (default
            (set! (.-flex d) true)))))



    (let [m (image/NewYCbCr (image/Rect 0 0 (* 8 (.-maxH d) mxx) (* 8 (.-maxV d) myy)) subsampleRatio)]
      (set! (.-img3 d) (assert (* image/YCbCr) (.SubImage m (image/Rect 0 0 (.-width d) (.-height d)))))

      (when (== (.-nComp d) 4)
        (let [(values h3 v3) (values (.-h (aget (.-comp d) 3)) (.-v (aget (.-comp d) 3)))]

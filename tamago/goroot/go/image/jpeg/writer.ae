          (for [y (.-Y (.-Min bounds))] (< y (.-Y (.-Max bounds))) (set! y + 16)
            (for [x (.-X (.-Min bounds))] (< x (.-X (.-Max bounds))) (set! x + 16)
              (for [i 0] (< i 4) (inc! i)
                (let [xOff (* (bit-and i 1) 8)
                    ^{:line 542} yOff (* (bit-and i 2) 4)
                    ^{:line 543} p (image/Pt (+ x xOff) (+ y yOff))]
                  (cond (!= rgba nil)
                    (rgbaToYCbCr rgba p (addr b) (addr (aget cb i)) (addr (aget cr i)))
                    (!= ycbcr nil)
                    (yCbCrToYCbCr ycbcr p (addr b) (addr (aget cb i)) (addr (aget cr i))) :else

                    (toYCbCr m p (addr b) (addr (aget cb i)) (addr (aget cr i))))

                  (set! prevDCY (.writeBlock e (addr b) 0 prevDCY))))

              (scale (addr b) (addr cb))
              (set! prevDCCb (.writeBlock e (addr b) 1 prevDCCb))
              (scale (addr b) (addr cr))
              (set! prevDCCr (.writeBlock e (addr b) 1 prevDCCr)))))))



    ;; Pad the last byte with 1's.
    (.emit e 0x7f 7)))



(go/const ^{:val 75 :doc "DefaultQuality is the default quality encoding parameter.\n"} DefaultQuality 75)



(go/type Options "Options are the encoding parameters.\nQuality ranges from 1 to 100 inclusive, higher is better.\n" (struct
    ^{:line 570 :tag int} Quality))




^{:go/end 641} (go/func Encode "Encode writes the Image m to w in JPEG 4:2:0 baseline format with the given\noptions. Default parameters are used if a nil *[Options] is passed.\n" ^error [^io/Writer w ^image/Image m ^{:tag (* Options)} o]
  (let [b (.Bounds m)]
    (when (or (>= (.Dx b) (<< 1 16)) (>= (.Dy b) (<< 1 16)))
      (return (errors/New "jpeg: image is too large to encode")))

    (let [^encoder e (zero encoder)]
      (if [(values ww ok) (assert writer w)] ok
        (set! (.-w e) ww)

        (set! (.-w e) (bufio/NewWriter w)))

      ;; Clip quality to [1, 100].
      (let [quality DefaultQuality]
        (when (!= o nil)
          (set! quality (.-Quality o))
          (cond (< quality 1)
            (set! quality 1)
            (> quality 100)
            (set! quality 100)))


        ;; Convert from a quality rating to a scaling factor.
        (let [^int scale (zero int)]
          (if (< quality 50)
            (set! scale (/ 5000 quality))

            (set! scale (- 200 (* quality 2))))

          ;; Initialize the quantization tables.
          (range [i (.-quant e)]
            (range [j (aget (.-quant e) i)]
              (let [x (conv int (aget (aget unscaledQuant i) j))]
                (set! x (/ (+ (* x scale) 50) 100))
                (cond (< x 1)
                  (set! x 1)
                  (> x 255)
                  (set! x 255))

                (aset (aget (.-quant e) i) j (conv uint8 x)))))


          ;; Compute number of components based on input image type.
          (let [nComponent 3]
            (type-switch m
              ;; TODO(wathiede): switch on m.ColorModel() instead of type.
              (case [(* image/Gray)]
                (set! nComponent 1)))

            ;; Write the Start Of Image marker.
            (aset (.-buf e) 0 0xff)
            (aset (.-buf e) 1 0xd8)
            (.write e (subslice (.-buf e) _ 2))
            ;; Write the quantization tables.
            (.writeDQT e)
            ;; Write the image dimensions.
            (.writeSOF0 e (.Size b) nComponent)
            ;; Write the Huffman tables.
            (.writeDHT e nComponent)
            ;; Write the image data.
            (.writeSOS e m)
            ;; Write the End Of Image marker.
            (aset (.-buf e) 0 0xff)
            (aset (.-buf e) 1 0xd9)
            (.write e (subslice (.-buf e) _ 2))
            (.flush e)
            (.-err e)))))))

^{:go/end 655} (go/func DecodeConfig "DecodeConfig returns the global color model and dimensions of a GIF image\nwithout decoding the entire image.\n\nIt reads the logical screen descriptor and global color table only; it does\nnot allocate pixel buffers for frames. Use it to check width and height\nbefore calling [Decode] or [DecodeAll].\n" [^io/Reader r] :results [image/Config error]
  (let [^decoder d (zero decoder)]
    (when [err (.decode d r true false)] (!= err nil)
      (return (lit image/Config) err))


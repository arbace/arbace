^{:go/end 218} (go/func encodeColorTable [^{:tag (slice byte)} dst ^color/Palette p ^int size] :results [int error]
  (when (>= (conv uint size) 8)
    (return 0 (errors/New "gif: cannot encode color table with more than 256 entries")))

  (range [i c p]
    (when (== c nil)
      (return 0 (errors/New "gif: cannot encode color table with nil entries")))

    (let [(values ^uint8 r ^uint8 g ^uint8 b) (zero uint8)]
      ;; It is most likely that the palette is full of color.RGBAs, so they
      ;; get a fast path.
      (if [(values rgba ok) (assert color/RGBA c)] ok
        (set! (values r g b) (values (.-R rgba) (.-G rgba) (.-B rgba)))

        (let [(values rr gg bb _) (.RGBA c)]
          (set! (values r g b) (values (conv uint8 (>> rr 8)) (conv uint8 (>> gg 8)) (conv uint8 (>> bb 8))))))

      (aset dst (+ (* 3 i) 0) r)
      (aset dst (+ (* 3 i) 1) g)
      (aset dst (+ (* 3 i) 2) b)))

  (let [n ^int (<< 1 (+ size 1))]
    (when (> n (len p))
      ;; Pad with black.
      (clear (subslice dst (* 3 (len p)) (* 3 n))))

    (return (* 3 n) nil)))


^{:go/end 228} (go/method colorTablesMatch ^bool [^{:tag (* encoder)} e ^int localLen ^int transparentIndex]

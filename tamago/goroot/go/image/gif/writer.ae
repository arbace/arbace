    ;; in Go 1.5. Valid Go 1.4 code, such as when the Disposal field is omitted
    ;; in a GIF struct literal, should still produce valid GIFs.
    (when (and (!= (.-Disposal (.-g e)) nil) (!= (len (.-Image (.-g e))) (len (.-Disposal (.-g e)))))
      (return (errors/New "gif: mismatched image and disposal lengths")))

    (cond (== (.-Config (.-g e)) (lit image/Config))
      (let [p (.-Max (.Bounds (aget (.-Image g) 0)))]
        (set! (.-Width (.-Config (.-g e))) (.-X p))
        (set! (.-Height (.-Config (.-g e))) (.-Y p)))
      (!= (.-ColorModel (.-Config (.-g e))) nil)
      (when [(values _ ok) (assert color/Palette (.-ColorModel (.-Config (.-g e))))] (not ok)
        (return (errors/New "gif: GIF color model must be a color.Palette"))))




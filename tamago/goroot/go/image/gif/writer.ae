        (.writeImageBlock e pm (aget (.-Delay g) i) disposal)))

    (.writeByte e sTrailer)
    (.flush e)
    (.-err e)))



^{:go/end 466} (go/func Encode "Encode writes the Image m to w in GIF format.\n" ^error [^io/Writer w ^image/Image m ^{:tag (* Options)} o]
  ;; Check for bounds and size restrictions.
  (let [b (.Bounds m)]
    (when (or (>= (.Dx b) (<< 1 16)) (>= (.Dy b) (<< 1 16)))
      (return (errors/New "gif: image is too large to encode")))


    (let [opts (lit Options)]
      (when (!= o nil)
        (set! opts @o))

      (when (or (< (.-NumColors opts) 1) (< 256 (.-NumColors opts)))
        (set! (.-NumColors opts) 256))

      (when (== (.-Drawer opts) nil)
        (set! (.-Drawer opts) draw/FloydSteinberg))


      (let [(values pm _) (assert (* image/Paletted) m)]
        (when (== pm nil)
          (when [(values cp ok) (assert color/Palette (.ColorModel m))] ok
            (set! pm (image/NewPaletted b cp))
            (for [y (.-Y (.-Min b))] (< y (.-Y (.-Max b))) (inc! y)
              (for [x (.-X (.-Min b))] (< x (.-X (.-Max b))) (inc! x)

^{:go/end 404} (go/func EncodeAll "EncodeAll writes the images in g to w in GIF format with the\ngiven loop count and delay between frames.\n" ^error [^io/Writer w ^{:tag (* GIF)} g]
  (when (== (len (.-Image g)) 0)
    (return (errors/New "gif: must provide at least one image")))


  (when (!= (len (.-Image g)) (len (.-Delay g)))
    (return (errors/New "gif: mismatched image and delay lengths")))


  (let [e (lit encoder :g @g)]

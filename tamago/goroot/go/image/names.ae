(in-ns 'go.image) (go/file "names.go" :imports [


    ^{:line 8} [color "image/color"]])


(go/var

  ^{:line 13} [^{:doc "Black is an opaque black uniform image.\n"} Black (NewUniform color/Black)]

  ^{:line 15} [^{:doc "White is an opaque white uniform image.\n"} White (NewUniform color/White)]

  ^{:line 17} [^{:doc "Transparent is a fully transparent uniform image.\n"} Transparent (NewUniform color/Transparent)]

  ^{:line 19} [^{:doc "Opaque is a fully opaque uniform image.\n"} Opaque (NewUniform color/Opaque)])




(go/type Uniform "Uniform is an infinite-sized [Image] of uniform color.\nIt implements the [color.Color], [color.Model], and [Image] interfaces.\n" (struct
    ^{:line 25 :tag color/Color} C))


^{:go/end 30} (go/method RGBA [^{:tag (* Uniform)} c] :results [^uint32 r ^uint32 g ^uint32 b ^uint32 a]
  (.RGBA (.-C c)))


^{:go/end 34} (go/method ColorModel ^color/Model [^{:tag (* Uniform)} c]
  ^{:line 33} c)


^{:go/end 38} (go/method Convert ^color/Color [^{:tag (* Uniform)} c color/Color]
  (.-C c))


^{:go/end 40} (go/method Bounds ^Rectangle [^{:tag (* Uniform)} c] (lit Rectangle (lit Point -1.0E9 -1.0E9) (lit Point 1.0E9 1.0E9)))

^{:go/end 42} (go/method At ^color/Color [^{:tag (* Uniform)} c ^int x ^int y] (.-C c))

^{:go/end 47} (go/method RGBA64At ^color/RGBA64 [^{:tag (* Uniform)} c ^int x ^int y]
  (let [(values r g b a) (.RGBA (.-C c))]
    (lit color/RGBA64 (conv uint16 r) (conv uint16 g) (conv uint16 b) (conv uint16 a))))



^{:go/end 53} (go/method Opaque "Opaque scans the entire image and reports whether it is fully opaque.\n" ^bool [^{:tag (* Uniform)} c]
  (let [(values _ _ _ a) (.RGBA (.-C c))]
    (== a 0xffff)))



^{:go/end 58} (go/func NewUniform "NewUniform returns a new [Uniform] image of the given color.\n" ^{:tag (* Uniform)} [^color/Color c]
  (addr (lit Uniform c)))

(in-ns 'go.image.png) (go/file "paeth.go" :imports [])


(go/const ^{:val 64 :doc "intSize is either 32 or 64.\n"} intSize (<< 32 (>> (bit-not (conv uint 0)) 63)))

^{:go/end 20} (go/func abs ^int [^int x]
  ;; m := -1 if x < 0. m := 0 otherwise.
  (let [m (>> x (- intSize 1))]

    ;; In two's complement representation, the negative number
    ;; of any number (except the smallest one) can be computed
    ;; by flipping all the bits and add 1. This is faster than
    ;; code with a branch.
    ;; See Hacker's Delight, section 2-4.
    (- (bit-xor x m) m)))



^{:go/end 43} (go/func paeth "paeth implements the Paeth filter function, as per the PNG specification.\n" ^uint8 [^uint8 a ^uint8 b ^uint8 c]
  ;; This is an optimized version of the sample code in the PNG spec.
  ;; For example, the sample code starts with:
  ;;	p := int(a) + int(b) - int(c)
  ;;	pa := abs(p - int(a))
  ;; but the optimized form uses fewer arithmetic operations:
  ;;	pa := int(b) - int(c)
  ;;	pa = abs(pa)
  (let [pc (conv int c)
      ^{:line 32} pa (- (conv int b) pc)
      ^{:line 33} pb (- (conv int a) pc)]
    (set! pc (abs (+ pa pb)))
    (set! pa (abs pa))
    (set! pb (abs pb))
    (cond (and (<= pa pb) (<= pa pc))
      (return a)
      (<= pb pc)
      (return b))

    ^{:line 42} c))




^{:go/end 71} (go/func filterPaeth "filterPaeth applies the Paeth filter to the cdat slice.\ncdat is the current row's data, pdat is the previous row's data.\n" [^{:tag (slice byte)} cdat ^{:tag (slice byte)} pdat ^int bytesPerPixel]
  (let [(values ^int a ^int b ^int c ^int pa ^int pb ^int pc) (zero int)]
    (for [i 0] (< i bytesPerPixel) (inc! i)
      (set! (values a c) (values 0 0))
      (for [j i] (< j (len cdat)) (set! j + bytesPerPixel)
        (set! b (conv int (aget pdat j)))
        (set! pa (- b c))
        (set! pb (- a c))
        (set! pc (abs (+ pa pb)))
        (set! pa (abs pa))
        (set! pb (abs pb))
        (cond (and (<= pa pb) (<= pa pc)) (do)
          ;; No-op.
          (<= pb pc)
          (set! a b) :else

          (set! a c))

        (set! a + (conv int (aget cdat j)))
        (set! a bit-and 0xff)
        (aset cdat j (conv uint8 a))
        (set! c b)))))

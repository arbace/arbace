      (when (== e nil)
        (set! e (addr (lit encoder))))

      (when (!= (.-BufferPool enc) nil)
        (defer (.Put (.-BufferPool enc) (conv (* EncoderBuffer) e))))


      (set! (.-enc e) enc)
      (set! (.-w e) w)
      (set! (.-m e) m)

      (let [^color/Palette pal (zero color/Palette)]
        ;; cbP8 encoding needs PalettedImage's ColorIndexAt method.
        (when [(values _ ok) (assert image/PalettedImage m)] ok
          (set! (values pal _) (assert color/Palette (.ColorModel m))))

        (if (!= pal nil)
          (cond (<= (len pal) 2)
            (set! (.-cb e) cbP1)
            (<= (len pal) 4)
            (set! (.-cb e) cbP2)
            (<= (len pal) 16)
            (set! (.-cb e) cbP4) :else

            (set! (.-cb e) cbP8))


          (switch (.ColorModel m)
            (case [color/GrayModel]
              (set! (.-cb e) cbG8))
            (case [color/Gray16Model]
              (set! (.-cb e) cbG16))
            (case [color/RGBAModel color/NRGBAModel color/AlphaModel]
              (if (opaque m)
                (set! (.-cb e) cbTC8)

                (set! (.-cb e) cbTCA8)))

            (default
              (if (opaque m)
                (set! (.-cb e) cbTC16)

                (set! (.-cb e) cbTCA16)))))




        (set! (values _ (.-err e)) (io/WriteString w pngHeader))
        (.writeIHDR e)
        (when (!= pal nil)
          (.writePLTEAndTRNS e pal))

        (.writeIDATs e)
        (.writeIEND e)
        (.-err e)))))

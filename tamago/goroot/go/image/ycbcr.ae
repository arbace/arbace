^{:go/end 171} (go/func yCbCrSize [^Rectangle r ^YCbCrSubsampleRatio subsampleRatio] :results [^int w ^int h ^int cw ^int ch]
  (set! (values w h) (values (.Dx r) (.Dy r)))
  (switch subsampleRatio
    (case [YCbCrSubsampleRatio422]
      (set! cw (- (/ (+ (.-X (.-Max r)) 1) 2) (/ (.-X (.-Min r)) 2)))
      (set! ch h))
    (case [YCbCrSubsampleRatio420]
      (set! cw (- (/ (+ (.-X (.-Max r)) 1) 2) (/ (.-X (.-Min r)) 2)))
      (set! ch (- (/ (+ (.-Y (.-Max r)) 1) 2) (/ (.-Y (.-Min r)) 2))))
    (case [YCbCrSubsampleRatio440]
      (set! cw w)
      (set! ch (- (/ (+ (.-Y (.-Max r)) 1) 2) (/ (.-Y (.-Min r)) 2))))
    (case [YCbCrSubsampleRatio411]
      (set! cw (- (/ (+ (.-X (.-Max r)) 3) 4) (/ (.-X (.-Min r)) 4)))
      (set! ch h))
    (case [YCbCrSubsampleRatio410]
      (set! cw (- (/ (+ (.-X (.-Max r)) 3) 4) (/ (.-X (.-Min r)) 4)))
      (set! ch (- (/ (+ (.-Y (.-Max r)) 1) 2) (/ (.-Y (.-Min r)) 2))))
    (default
      ;; Default to 4:4:4 subsampling.
      (set! cw w)
      (set! ch h)))

  (return))





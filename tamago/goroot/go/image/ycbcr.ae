^{:go/end 91} (go/method YCbCrAt ^color/YCbCr [^{:tag (* YCbCr)} p ^int x ^int y]
  (when (not (.In (lit Point x y) (.-Rect p)))
    (return (lit color/YCbCr)))

  (let [yi (.YOffset p x y)
      ^{:line 85} ci (.COffset p x y)]
    (lit color/YCbCr
      (aget (.-Y p) yi)
      (aget (.-Cb p) ci)
      (aget (.-Cr p) ci))))





^{:go/end 97} (go/method YOffset "YOffset returns the index of the first element of Y that corresponds to\nthe pixel at (x, y).\n" ^int [^{:tag (* YCbCr)} p ^int x ^int y]
  (+ (* (- y (.-Y (.-Min (.-Rect p)))) (.-YStride p)) (- x (.-X (.-Min (.-Rect p))))))




^{:go/end 116} (go/method COffset "COffset returns the index of the first element of Cb or Cr that corresponds\nto the pixel at (x, y).\n" ^int [^{:tag (* YCbCr)} p ^int x ^int y]
  (switch (.-SubsampleRatio p)
    (case [YCbCrSubsampleRatio422]
      (return (+ (* (- y (.-Y (.-Min (.-Rect p)))) (.-CStride p)) (- (/ x 2) (/ (.-X (.-Min (.-Rect p))) 2)))))
    (case [YCbCrSubsampleRatio420]
      (return (+ (* (- (/ y 2) (/ (.-Y (.-Min (.-Rect p))) 2)) (.-CStride p)) (- (/ x 2) (/ (.-X (.-Min (.-Rect p))) 2)))))
    (case [YCbCrSubsampleRatio440]
      (return (+ (* (- (/ y 2) (/ (.-Y (.-Min (.-Rect p))) 2)) (.-CStride p)) (- x (.-X (.-Min (.-Rect p)))))))
    (case [YCbCrSubsampleRatio411]
      (return (+ (* (- y (.-Y (.-Min (.-Rect p)))) (.-CStride p)) (- (/ x 4) (/ (.-X (.-Min (.-Rect p))) 4)))))
    (case [YCbCrSubsampleRatio410]
      (return (+ (* (- (/ y 2) (/ (.-Y (.-Min (.-Rect p))) 2)) (.-CStride p)) (- (/ x 4) (/ (.-X (.-Min (.-Rect p))) 4))))))

  ;; Default to 4:4:4 subsampling.
  (+ (* (- y (.-Y (.-Min (.-Rect p)))) (.-CStride p)) (- x (.-X (.-Min (.-Rect p))))))




^{:go/end 141} (go/method SubImage "SubImage returns an image representing the portion of the image p visible\nthrough r. The returned value shares pixels with the original image.\n" ^Image [^{:tag (* YCbCr)} p ^Rectangle r]
  (set! r (.Intersect r (.-Rect p)))
  ;; If r1 and r2 are Rectangles, r1.Intersect(r2) is not guaranteed to be inside

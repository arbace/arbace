(ns go.strconv
  (:require [arbace.go :as go]))

(go/package strconv
  :path "strconv"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["bytealg.go" "doc.go" "isprint.go" "number.go" "quote.go"]
  :init-order [isPrint16 isNotPrint16 isPrint32 isNotPrint32 isGraphic ErrRange ErrSyntax]
  :positions :lines)

(load "strconv/bytealg")
(load "strconv/doc")
(load "strconv/isprint")
(load "strconv/number")
(load "strconv/quote")

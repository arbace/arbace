      ^:const ^:go/grouped ^{:line 88 :val 0.0156191029464890010492M} S01 0.0156191029464890010492M ; 0x3F8FFCE882C8C2A4
      ^:const ^:go/grouped ^{:line 89 :val 0.00011692678466333745026M} S02 0.00011692678466333745026M ; 0x3F1EA6D2DD57DBF4
      ^:const ^:go/grouped ^{:line 90 :val 5.13546550207318111446E-7M} S03 5.13546550207318111446E-7M ; 0x3EA13B54CE84D5A9
      ^:const ^:go/grouped ^{:line 91 :val 1.16614003333790000205E-9M} S04 1.16614003333790000205E-9M] ; 0x3E1408BCF4745D8F


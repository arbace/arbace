(in-ns 'go.math) (go/file "abs.go" :imports [])







^{:go/end 15} (go/func Abs "Abs returns the absolute value of x.\n\nSpecial cases are:\n\n\tAbs(±Inf) = +Inf\n\tAbs(NaN) = NaN\n" ^float64 [^float64 x]
  (Float64frombits (bit-and-not (Float64bits x) signMask)))

(in-ns 'go.math) (go/file "dim.go" :imports [])








^{:go/end 27} (go/func Dim "Dim returns the maximum of x-y or 0.\n\nSpecial cases are:\n\n\tDim(+Inf, +Inf) = NaN\n\tDim(-Inf, -Inf) = NaN\n\tDim(x, NaN) = Dim(NaN, x) = NaN\n" ^float64 [^float64 x ^float64 y]
  ;; The special cases result in NaN after the subtraction:
  ;;      +Inf - +Inf = NaN
  ;;      -Inf - -Inf = NaN
  ;;       NaN - y    = NaN
  ;;         x - NaN  = NaN
  (let [v (- x y)]
    (when (<= v 0)
      ;; v is negative or 0
      (return 0))

    ;; v is positive or NaN
    ^{:line 26} v))













^{:go/end 45} (go/func Max "Max returns the larger of x or y.\n\nSpecial cases are:\n\n\tMax(x, +Inf) = Max(+Inf, x) = +Inf\n\tMax(x, NaN) = Max(NaN, x) = NaN\n\tMax(+0, ±0) = Max(±0, +0) = +0\n\tMax(-0, -0) = -0\n\nNote that this differs from the built-in function max when called\nwith NaN and +Inf.\n" ^float64 [^float64 x ^float64 y]
  (when haveArchMax
    (return (archMax x y)))

  (go/call max x y))


^{:go/end 64} (go/func max ^float64 [^float64 x ^float64 y]
  ;; special cases
  (switch
    (case [(or (IsInf x 1) (IsInf y 1))]
      (return (Inf 1)))
    (case [(or (IsNaN x) (IsNaN y))]
      (return (NaN)))
    (case [(and (== x 0) (== x y))]
      (when (Signbit x)
        (return y))

      (return x)))

  (when (> x y)
    (return x))

  ^{:line 63} y)












^{:go/end 81} (go/func Min "Min returns the smaller of x or y.\n\nSpecial cases are:\n\n\tMin(x, -Inf) = Min(-Inf, x) = -Inf\n\tMin(x, NaN) = Min(NaN, x) = NaN\n\tMin(-0, ±0) = Min(±0, -0) = -0\n\nNote that this differs from the built-in function min when called\nwith NaN and -Inf.\n" ^float64 [^float64 x ^float64 y]
  (when haveArchMin
    (return (archMin x y)))

  (go/call min x y))


^{:go/end 100} (go/func min ^float64 [^float64 x ^float64 y]
  ;; special cases
  (switch
    (case [(or (IsInf x -1) (IsInf y -1))]
      (return (Inf -1)))
    (case [(or (IsNaN x) (IsNaN y))]
      (return (NaN)))
    (case [(and (== x 0) (== x y))]
      (when (Signbit x)
        (return x))

      (return y)))

  (when (< x y)
    (return x))

  ^{:line 99} y)

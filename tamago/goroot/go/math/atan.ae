(in-ns 'go.math) (go/file "atan.go" :imports [])

;; /*
;; Floating-point arctangent.
;; */

;; The original C code, the long comment, and the constants below were
;; from http://netlib.sandia.gov/cephes/cmath/atan.c, available from
;; http://www.netlib.org/cephes/cmath.tgz.
;; The go code is a version of the original C.
;;
;; atan.c
;; Inverse circular tangent (arctangent)
;;
;; SYNOPSIS:
;; double x, y, atan();
;; y = atan( x );
;;
;; DESCRIPTION:
;; Returns radian angle between -pi/2 and +pi/2 whose tangent is x.
;;
;; Range reduction is from three intervals into the interval from zero to 0.66.
;; The approximant uses a rational function of degree 4/5 of the form
;; x + x**3 P(x)/Q(x).
;;
;; ACCURACY:
;;                      Relative error:
;; arithmetic   domain    # trials  peak     rms
;;    DEC       -10, 10   50000     2.4e-17  8.3e-18
;;    IEEE      -10, 10   10^6      1.8e-16  5.0e-17
;;
;; Cephes Math Library Release 2.8:  June, 2000
;; Copyright 1984, 1987, 1989, 1992, 2000 by Stephen L. Moshier
;;
;; The readme file at http://netlib.sandia.gov/cephes/ says:
;;    Some software in this archive may be from the book _Methods and
;; Programs for Mathematical Functions_ (Prentice-Hall or Simon & Schuster
;; International, 1989) or from the Cephes Mathematical Library, a
;; commercial product. In either event, it is copyrighted by the author.
;; What you see here may be used freely but it comes with no support or
;; guarantee.
;;
;;   The two known misprints in the book are repaired here in the
;; source listings for the gamma function and the incomplete beta
;; integral.
;;
;;   Stephen L. Moshier
;;   moshier@na-net.ornl.gov


^{:go/end 72} (go/func xatan "xatan evaluates a series valid in the range [0, 0.66].\n" ^float64 [^float64 x]
  (let [
      ^:const ^{:line 57 :val -0.8750608600031904122785M} P0 -0.8750608600031904122785M
      ^:const ^:go/grouped ^{:line 58 :val -16.15753718733365076637M} P1 -16.15753718733365076637M
      ^:const ^:go/grouped ^{:line 59 :val -75.0085579231470466734M} P2 -75.0085579231470466734M
      ^:const ^:go/grouped ^{:line 60 :val -122.886668449013617341M} P3 -122.886668449013617341M
      ^:const ^:go/grouped ^{:line 61 :val -64.85021904942025371773M} P4 -64.85021904942025371773M
      ^:const ^:go/grouped ^{:line 62 :val 24.85846490142306297962M} Q0 (+ 24.85846490142306297962M)
      ^:const ^:go/grouped ^{:line 63 :val 165.0270098316988542046M} Q1 (+ 165.0270098316988542046M)
      ^:const ^:go/grouped ^{:line 64 :val 432.8810604912902668951M} Q2 (+ 432.8810604912902668951M)
      ^:const ^:go/grouped ^{:line 65 :val 485.3903996359136964868M} Q3 (+ 485.3903996359136964868M)
      ^:const ^:go/grouped ^{:line 66 :val 194.5506571482613964425M} Q4 (+ 194.5506571482613964425M)

      ^{:line 68} z (* x x)]
    (set! z (/ (* z (+ (* (+ (* (+ (* (+ (* P0 z) P1) z) P2) z) P3) z) P4)) (+ (* (+ (* (+ (* (+ (* (+ z Q0) z) Q1) z) Q2) z) Q3) z) Q4)))
    (set! z (+ (* x z) x))
    ^{:line 71} z))




^{:go/end 88} (go/func satan "satan reduces its argument (known to be positive)\nto the range [0, 0.66] and calls xatan.\n" ^float64 [^float64 x]
  (let [
      ^:const ^{:line 78 :val 6.12323399573676588613E-17M} Morebits 6.12323399573676588613E-17M ; pi/2 = PIO2 + Morebits
      ^:const ^:go/grouped ^{:line 79 :val 2.4142135623730950488M} Tan3pio8 2.4142135623730950488M] ; tan(3*pi/8)

    (when (<= x 0.66)
      (return (xatan x)))

    (when (> x Tan3pio8)
      (return (+ (- (/ Pi 2) (xatan (/ 1 x))) Morebits)))

    (+ (/ Pi 4) (xatan (/ (- x 1) (+ x 1))) (* 0.5 Morebits))))








^{:go/end 101} (go/func Atan "Atan returns the arctangent, in radians, of x.\n\nSpecial cases are:\n\n\tAtan(±0) = ±0\n\tAtan(±Inf) = ±Pi/2\n" ^float64 [^float64 x]
  (when haveArchAtan
    (return (archAtan x)))

  (atan x))


^{:go/end 111} (go/func atan ^float64 [^float64 x]
  (when (== x 0)
    (return x))

  (when (> x 0)
    (return (satan x)))

  (- (satan (- x))))

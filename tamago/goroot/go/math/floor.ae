(in-ns 'go.math) (go/file "floor.go" :imports [])








^{:go/end 19} (go/func Floor "Floor returns the greatest integer value less than or equal to x.\n\nSpecial cases are:\n\n\tFloor(±0) = ±0\n\tFloor(±Inf) = ±Inf\n\tFloor(NaN) = NaN\n" ^float64 [^float64 x]
  (when haveArchFloor
    (return (archFloor x)))

  (floor x))


^{:go/end 34} (go/func floor ^float64 [^float64 x]
  (when (or (== x 0) (IsNaN x) (IsInf x 0))
    (return x))

  (when (< x 0)
    (let [(values d fract) (Modf (- x))]
      (when (!= fract 0.0)
        (set! d (+ d 1)))

      (return (- d))))

  (let [(values d _) (Modf x)]
    ^{:line 33} d))









^{:go/end 48} (go/func Ceil "Ceil returns the least integer value greater than or equal to x.\n\nSpecial cases are:\n\n\tCeil(±0) = ±0\n\tCeil(±Inf) = ±Inf\n\tCeil(NaN) = NaN\n" ^float64 [^float64 x]
  (when haveArchCeil
    (return (archCeil x)))

  (ceil x))


^{:go/end 52} (go/func ceil ^float64 [^float64 x]
  (- (Floor (- x))))









^{:go/end 66} (go/func Trunc "Trunc returns the integer value of x.\n\nSpecial cases are:\n\n\tTrunc(±0) = ±0\n\tTrunc(±Inf) = ±Inf\n\tTrunc(NaN) = NaN\n" ^float64 [^float64 x]
  (when haveArchTrunc
    (return (archTrunc x)))

  (trunc x))


^{:go/end 81} (go/func trunc ^float64 [^float64 x]
  (when (< (Abs x) 1)
    (return (Copysign 0 x)))


  (let [b (Float64bits x)
      ^{:line 74} e (- (bit-and (conv uint (>> b shift)) mask) bias)]

    ;; Keep the top 12+e bits, the integer part; clear the rest.
    (when (< e (- 64 12))
      (set! b bit-and-not (- ^uint64 (<< 1 (- 64 12 e)) 1)))

    (Float64frombits b)))









^{:go/end 119} (go/func Round "Round returns the nearest integer, rounding half away from zero.\n\nSpecial cases are:\n\n\tRound(±0) = ±0\n\tRound(±Inf) = ±Inf\n\tRound(NaN) = NaN\n" ^float64 [^float64 x]
  ;; Round is a faster implementation of:
  ;;
  ;; func Round(x float64) float64 {
  ;;   t := Trunc(x)
  ;;   if Abs(x-t) >= 0.5 {
  ;;     return t + Copysign(1, x)
  ;;   }
  ;;   return t
  ;; }
  (let [bits (Float64bits x)
      ^{:line 101} e (bit-and (conv uint (>> bits shift)) mask)]
    (cond (< e bias) (do
        ;; Round abs(x) < 1 including denormals.
        (set! bits bit-and signMask) ; +-0
        (when (== e (- bias 1))
          (set! bits bit-or uvone))) ; +-1

      (< e (+ bias shift))
      ;; Round any abs(x) >= 1 containing a fractional component [0,1).
      ;;
      ;; Numbers with larger exponents are returned unchanged since they
      ;; must be either an integer, infinity, or NaN.
      (let [^:const ^{:val 2251799813685248} half (<< 1 (- shift 1))]
        (set! e - bias)
        (set! bits + ^uint64 (>> half e))
        (set! bits bit-and-not ^uint64 (>> fracMask e))))

    (Float64frombits bits)))









^{:go/end 158} (go/func RoundToEven "RoundToEven returns the nearest integer, rounding ties to even.\n\nSpecial cases are:\n\n\tRoundToEven(±0) = ±0\n\tRoundToEven(±Inf) = ±Inf\n\tRoundToEven(NaN) = NaN\n" ^float64 [^float64 x]
  ;; RoundToEven is a faster implementation of:
  ;;
  ;; func RoundToEven(x float64) float64 {
  ;;   t := math.Trunc(x)
  ;;   odd := math.Remainder(t, 2) != 0
  ;;   if d := math.Abs(x - t); d > 0.5 || (d == 0.5 && odd) {
  ;;     return t + math.Copysign(1, x)
  ;;   }
  ;;   return t
  ;; }
  (let [bits (Float64bits x)
      ^{:line 140} e (bit-and (conv uint (>> bits shift)) mask)]
    (cond (>= e bias)
      ;; Round abs(x) >= 1.
      ;; - Large numbers without fractional components, infinity, and NaN are unchanged.
      ;; - Add 0.499.. or 0.5 before truncating depending on whether the truncated
      ;;   number is even or odd (respectively).
      (let [^:const ^{:val 2251799813685247} halfMinusULP (- (<< 1 (- shift 1)) 1)]
        (set! e - bias)
        (set! bits + (>> (+ halfMinusULP (bit-and (>> bits (- shift e)) 1)) e))
        (set! bits bit-and-not ^uint64 (>> fracMask e)))
      (and (== e (- bias 1)) (!= (bit-and bits fracMask) 0))
      ;; Round 0.5 < abs(x) < 1.
      (set! bits (bit-or (bit-and bits signMask) uvone)) :else ; +-1

      ;; Round abs(x) <= 0.5 including denormals.
      (set! bits bit-and signMask)) ; +-0

    (Float64frombits bits)))

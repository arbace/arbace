(in-ns 'go.math) (go/file "floor_asm.go" :build ["//go:build 386 || amd64 || arm64 || loong64 || ppc64 || ppc64le || riscv64 || s390x || wasm"] :imports [])

(go/const ^{:val true} haveArchFloor true)

(go/func ^:extern archFloor ^float64 [^float64 x])

(go/const ^{:val true} haveArchCeil true)

(go/func ^:extern archCeil ^float64 [^float64 x])

(go/const ^{:val true} haveArchTrunc true)

(go/func ^:extern archTrunc ^float64 [^float64 x])

^{:go/end 191} (go/func RotateLeft8 "RotateLeft8 returns the value of x rotated left by (k mod 8) bits.\nTo rotate x right by k bits, call RotateLeft8(x, -k).\n\nThis function's execution time does not depend on the inputs.\n" ^uint8 [^uint8 x ^int k]

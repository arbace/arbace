;; Package bits implements bit counting and manipulation
;; functions for the predeclared unsigned integer types.
;;
;; Functions in this package may be implemented directly by
;; the compiler, for better performance. For those functions
;; the code in this package will not be used. Which
;; functions are implemented by the compiler depends on the
;; architecture and the Go release.
(in-ns 'go.math.bits) (go/file "bits.go" :directives ["//go:generate go run make_tables.go"] :doc "Package bits implements bit counting and manipulation\nfunctions for the predeclared unsigned integer types.\n\nFunctions in this package may be implemented directly by\nthe compiler, for better performance. For those functions\nthe code in this package will not be used. Which\nfunctions are implemented by the compiler depends on the\narchitecture and the Go release.\n" :imports [])

(go/const ^{:val 64} uintSize (<< 32 (>> (bit-not (conv uint 0)) 63))) ; 32 or 64


(go/const ^{:val 64 :doc "UintSize is the size of a uint in bits.\n"} UintSize uintSize)

;; --- LeadingZeros ---


^{:go/end 25} (go/func LeadingZeros "LeadingZeros returns the number of leading zero bits in x; the result is [UintSize] for x == 0.\n" ^int [^uint x] (- UintSize (Len x)))


^{:go/end 28} (go/func LeadingZeros8 "LeadingZeros8 returns the number of leading zero bits in x; the result is 8 for x == 0.\n" ^int [^uint8 x] (- 8 (Len8 x)))


^{:go/end 31} (go/func LeadingZeros16 "LeadingZeros16 returns the number of leading zero bits in x; the result is 16 for x == 0.\n" ^int [^uint16 x] (- 16 (Len16 x)))


^{:go/end 34} (go/func LeadingZeros32 "LeadingZeros32 returns the number of leading zero bits in x; the result is 32 for x == 0.\n" ^int [^uint32 x] (- 32 (Len32 x)))


^{:go/end 37} (go/func LeadingZeros64 "LeadingZeros64 returns the number of leading zero bits in x; the result is 64 for x == 0.\n" ^int [^uint64 x] (- 64 (Len64 x)))

;; --- TrailingZeros ---


(go/const ^{:val 125613361 :doc "See http://keithandkatie.com/keith/papers/debruijn.html\n"} deBruijn32 0x077CB531)

(go/var deBruijn32tab ^{:go/breaks [2 18]} (lit (array 32 byte)
    0 1 28 2 29 14 24 3 30 22 20 15 25 17 4 8
    31 27 13 23 21 19 16 7 26 12 18 6 11 5 10 9))


(go/const ^{:val 285870213051353865} deBruijn64 0x03f79d71b4ca8b09)

(go/var deBruijn64tab ^{:go/breaks [2 18 34 50]} (lit (array 64 byte)
    0 1 56 2 57 49 28 3 61 58 42 50 38 29 17 4
    62 47 59 36 45 43 51 22 53 39 33 30 24 18 12 5
    63 55 48 27 60 41 37 16 46 35 44 21 52 32 23 11
    54 26 40 15 34 20 31 10 25 14 19 9 13 8 7 6))



^{:go/end 64} (go/func TrailingZeros "TrailingZeros returns the number of trailing zero bits in x; the result is [UintSize] for x == 0.\n" ^int [^uint x]
  (when (== UintSize 32)
    (return (TrailingZeros32 (conv uint32 x))))

  (TrailingZeros64 (conv uint64 x)))



^{:go/end 69} (go/func TrailingZeros8 "TrailingZeros8 returns the number of trailing zero bits in x; the result is 8 for x == 0.\n" ^int [^uint8 x]
  (conv int (aget ntz8tab x)))



^{:go/end 78} (go/func TrailingZeros16 "TrailingZeros16 returns the number of trailing zero bits in x; the result is 16 for x == 0.\n" ^int [^uint16 x]
  (when (== x 0)
    (return 16))

  ;; see comment in TrailingZeros64
  (conv int (aget deBruijn32tab (>> (* (conv uint32 (bit-and x (- x))) deBruijn32) (- 32 5)))))



^{:go/end 87} (go/func TrailingZeros32 "TrailingZeros32 returns the number of trailing zero bits in x; the result is 32 for x == 0.\n" ^int [^uint32 x]
  (when (== x 0)
    (return 32))

  ;; see comment in TrailingZeros64
  (conv int (aget deBruijn32tab (>> (* (bit-and x (- x)) deBruijn32) (- 32 5)))))



^{:go/end 106} (go/func TrailingZeros64 "TrailingZeros64 returns the number of trailing zero bits in x; the result is 64 for x == 0.\n" ^int [^uint64 x]
  (when (== x 0)
    (return 64))

  ;; If popcount is fast, replace code below with return popcount(^x & (x - 1)).
  ;;
  ;; x & -x leaves only the right-most bit set in the word. Let k be the
  ;; index of that bit. Since only a single bit is set, the value is two
  ;; to the power of k. Multiplying by a power of two is equivalent to
  ;; left shifting, in this case by k bits. The de Bruijn (64 bit) constant
  ;; is such that all six bit, consecutive substrings are distinct.
  ;; Therefore, if we have a left shifted version of this constant we can
  ;; find by how many bits it was shifted by looking at which six bit
  ;; substring ended up at the top of the word.
  ;; (Knuth, volume 4, section 7.3.1)
  (conv int (aget deBruijn64tab (>> (* (bit-and x (- x)) deBruijn64) (- 64 6)))))


;; --- OnesCount ---

(go/const ^{:val 6148914691236517205} m0 0x5555555555555555) ; 01010101 ...
(go/const ^{:val 3689348814741910323} m1 0x3333333333333333) ; 00110011 ...
(go/const ^{:val 1085102592571150095} m2 0x0f0f0f0f0f0f0f0f) ; 00001111 ...
(go/const ^{:val 71777214294589695} m3 0x00ff00ff00ff00ff) ; etc.
(go/const ^{:val 281470681808895} m4 0x0000ffff0000ffff)


^{:go/end 122} (go/func OnesCount "OnesCount returns the number of one bits (\"population count\") in x.\n" ^int [^uint x]
  (when (== UintSize 32)
    (return (OnesCount32 (conv uint32 x))))

  (OnesCount64 (conv uint64 x)))



^{:go/end 127} (go/func OnesCount8 "OnesCount8 returns the number of one bits (\"population count\") in x.\n" ^int [^uint8 x]
  (conv int (aget pop8tab x)))



^{:go/end 132} (go/func OnesCount16 "OnesCount16 returns the number of one bits (\"population count\") in x.\n" ^int [^uint16 x]
  (conv int (+ (aget pop8tab (>> x 8)) (aget pop8tab (bit-and x 0xff)))))



^{:go/end 137} (go/func OnesCount32 "OnesCount32 returns the number of one bits (\"population count\") in x.\n" ^int [^uint32 x]
  (conv int (+ (aget pop8tab (>> x 24)) (aget pop8tab (bit-and (>> x 16) 0xff)) (aget pop8tab (bit-and (>> x 8) 0xff)) (aget pop8tab (bit-and x 0xff)))))



^{:go/end 168} (go/func OnesCount64 "OnesCount64 returns the number of one bits (\"population count\") in x.\n" ^int [^uint64 x]
  ;; Implementation: Parallel summing of adjacent bits.
  ;; See "Hacker's Delight", Chap. 5: Counting Bits.
  ;; The following pattern shows the general approach:
  ;;
  ;;   x = x>>1&(m0&m) + x&(m0&m)
  ;;   x = x>>2&(m1&m) + x&(m1&m)
  ;;   x = x>>4&(m2&m) + x&(m2&m)
  ;;   x = x>>8&(m3&m) + x&(m3&m)
  ;;   x = x>>16&(m4&m) + x&(m4&m)
  ;;   x = x>>32&(m5&m) + x&(m5&m)
  ;;   return int(x)
  ;;
  ;; Masking (& operations) can be left away when there's no
  ;; danger that a field's sum will carry over into the next
  ;; field: Since the result cannot be > 64, 8 bits is enough
  ;; and we can ignore the masks for the shifts by 8 and up.
  ;; Per "Hacker's Delight", the first line can be simplified
  ;; more, but it saves at best one instruction, so we leave
  ;; it alone for clarity.
  (let [^:const ^{:val 18446744073709551615N} m (- (<< 1 64) 1)]
    (set! x (+ (bit-and (>> x 1) (bit-and m0 m)) (bit-and x (bit-and m0 m))))
    (set! x (+ (bit-and (>> x 2) (bit-and m1 m)) (bit-and x (bit-and m1 m))))
    (set! x (bit-and (+ (>> x 4) x) (bit-and m2 m)))
    (set! x + (>> x 8))
    (set! x + (>> x 16))
    (set! x + (>> x 32))
    (bit-and (conv int x) (- (<< 1 7) 1))))



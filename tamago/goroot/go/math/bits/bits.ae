^{:go/end 409} (go/func Sub "Sub returns the difference of x, y and borrow: diff = x - y - borrow.\nThe borrow input must be 0 or 1; otherwise the behavior is undefined.\nThe borrowOut output is guaranteed to be 0 or 1.\n\nThis function's execution time does not depend on the inputs.\n" [^uint x ^uint y ^uint borrow] :results [^uint diff ^uint borrowOut]
  (when (== UintSize 32)
    (let [(values d32 b32) (Sub32 (conv uint32 x) (conv uint32 y) (conv uint32 borrow))]
      (return (conv uint d32) (conv uint b32))))

  (let [(values d64 b64) (Sub64 (conv uint64 x) (conv uint64 y) (conv uint64 borrow))]
    (return (conv uint d64) (conv uint b64))))







^{:go/end 424} (go/func Sub32 "Sub32 returns the difference of x, y and borrow, diff = x - y - borrow.\nThe borrow input must be 0 or 1; otherwise the behavior is undefined.\nThe borrowOut output is guaranteed to be 0 or 1.\n\nThis function's execution time does not depend on the inputs.\n" [^uint32 x ^uint32 y ^uint32 borrow] :results [^uint32 diff ^uint32 borrowOut]
  (set! diff (- x y borrow))
  ;; The difference will underflow if the top bit of x is not set and the top
  ;; bit of y is set (^x & y) or if they are the same (^(x ^ y)) and a borrow
  ;; from the lower place happens. If that borrow happens, the result will be
  ;; 1 - 1 - 1 = 0 - 0 - 1 = 1 (& diff).
  (set! borrowOut (>> (bit-or (bit-and (bit-not x) y) (bit-and (bit-not (bit-xor x y)) diff)) 31))
  (return))







^{:go/end 436} (go/func Sub64 "Sub64 returns the difference of x, y and borrow: diff = x - y - borrow.\nThe borrow input must be 0 or 1; otherwise the behavior is undefined.\nThe borrowOut output is guaranteed to be 0 or 1.\n\nThis function's execution time does not depend on the inputs.\n" [^uint64 x ^uint64 y ^uint64 borrow] :results [^uint64 diff ^uint64 borrowOut]

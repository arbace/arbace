;; --- Add with carry ---






^{:go/end 367} (go/func Add "Add returns the sum with carry of x, y and carry: sum = x + y + carry.\nThe carry input must be 0 or 1; otherwise the behavior is undefined.\nThe carryOut output is guaranteed to be 0 or 1.\n\nThis function's execution time does not depend on the inputs.\n" [^uint x ^uint y ^uint carry] :results [^uint sum ^uint carryOut]
  (when (== UintSize 32)
    (let [(values s32 c32) (Add32 (conv uint32 x) (conv uint32 y) (conv uint32 carry))]
      (return (conv uint s32) (conv uint c32))))

  (let [(values s64 c64) (Add64 (conv uint64 x) (conv uint64 y) (conv uint64 carry))]
    (return (conv uint s64) (conv uint c64))))







^{:go/end 379} (go/func Add32 "Add32 returns the sum with carry of x, y and carry: sum = x + y + carry.\nThe carry input must be 0 or 1; otherwise the behavior is undefined.\nThe carryOut output is guaranteed to be 0 or 1.\n\nThis function's execution time does not depend on the inputs.\n" [^uint32 x ^uint32 y ^uint32 carry] :results [^uint32 sum ^uint32 carryOut]
  (let [sum64 (+ (conv uint64 x) (conv uint64 y) (conv uint64 carry))]
    (set! sum (conv uint32 sum64))
    (set! carryOut (conv uint32 (>> sum64 32)))
    (return)))







^{:go/end 393} (go/func Add64 "Add64 returns the sum with carry of x, y and carry: sum = x + y + carry.\nThe carry input must be 0 or 1; otherwise the behavior is undefined.\nThe carryOut output is guaranteed to be 0 or 1.\n\nThis function's execution time does not depend on the inputs.\n" [^uint64 x ^uint64 y ^uint64 carry] :results [^uint64 sum ^uint64 carryOut]
  (set! sum (+ x y carry))
  ;; The sum will overflow if both top bits are set (x & y) or if one of them
  ;; is (x | y), and a carry from the lower place happened. If such a carry
  ;; happens, the top bit will be 1 + 0 + 1 = 0 (&^ sum).
  (set! carryOut (>> (bit-or (bit-and x y) (bit-and-not (bit-or x y) sum)) 63))
  (return))



^{:go/end 578} (go/func Rem "Rem returns the remainder of (hi, lo) divided by y. Rem panics for\ny == 0 (division by zero) but, unlike Div, it doesn't panic on a\nquotient overflow.\n" ^uint [^uint hi ^uint lo ^uint y]

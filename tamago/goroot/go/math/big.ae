(ns go.math.big
  (:require [arbace.go :as go]))

(go/package big
  :path "math/big"
  :files ["accuracy_string.go" "arith.go" "arith_amd64.go" "arith_decl.go" "decimal.go" "doc.go" "float.go" "floatconv.go" "floatmarsh.go" "ftoa.go" "int.go" "intconv.go" "intmarsh.go" "nat.go" "natconv.go" "natdiv.go" "natmul.go" "prime.go" "rat.go" "ratconv.go" "ratmarsh.go" "roundingmode_string.go" "sqrt.go"]
  :other-files ["arith_amd64.s" "arith_arm64.s"]
  :positions :lines)

(load "big/accuracy_string")
(load "big/arith")
(load "big/arith_amd64")
(load "big/arith_decl")
(load "big/decimal")
(load "big/doc")
(load "big/float")
(load "big/floatconv")
(load "big/floatmarsh")
(load "big/ftoa")
(load "big/int")
(load "big/intconv")
(load "big/intmarsh")
(load "big/nat")
(load "big/natconv")
(load "big/natdiv")
(load "big/natmul")
(load "big/prime")
(load "big/rat")
(load "big/ratconv")
(load "big/ratmarsh")
(load "big/roundingmode_string")
(load "big/sqrt")

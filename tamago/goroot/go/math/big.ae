(ns go.math.big
  (:require [arbace.go :as go]))

(go/package big
  :path "math/big"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["accuracy_string.go" "arith.go" "arith_amd64.go" "arith_decl.go" "decimal.go" "doc.go" "float.go" "floatconv.go" "floatmarsh.go" "ftoa.go" "int.go" "intconv.go" "intmarsh.go" "nat.go" "natconv.go" "natdiv.go" "natmul.go" "prime.go" "rat.go" "ratconv.go" "ratmarsh.go" "roundingmode_string.go" "sqrt.go"]
  :other-files ["arith_amd64.s"]
  :init-order [_Accuracy_index hasADX ["float.go" 81 5] pow5tab ["floatconv.go" 291 5] ["ftoa.go" 453 5] natOne intOne ["intconv.go" 68 5] ["intconv.go" 246 5] natTwo natFive natTen errNoDigits errInvalSep leafSize divRecursiveThreshold karatsubaThreshold basicSqrThreshold karatsubaSqrThreshold ["ratconv.go" 22 5] _RoundingMode_index]
  :positions :lines)

(load "big/accuracy_string")
(load "big/arith")
(load "big/arith_amd64")
(load "big/arith_decl")
(load "big/decimal")
(load "big/doc")
(load "big/float")
(load "big/floatconv")
(load "big/floatmarsh")
(load "big/ftoa")
(load "big/int")
(load "big/intconv")
(load "big/intmarsh")
(load "big/nat")
(load "big/natconv")
(load "big/natdiv")
(load "big/natmul")
(load "big/prime")
(load "big/rat")
(load "big/ratconv")
(load "big/ratmarsh")
(load "big/roundingmode_string")
(load "big/sqrt")

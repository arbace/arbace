(in-ns 'go.math) (go/file "unsafe.go" :imports [

    ^{:line 7} [unsafe "unsafe"]])

;; Despite being an exported symbol,
;; Float32bits is linknamed by widely used packages.
;; Notable members of the hall of shame include:
;;   - gitee.com/quant1x/num
;;
;; Do not remove or change the type signature.
;; See go.dev/issue/67401.
;;
;; Note that this comment is not part of the doc comment.
;;





^{:go/end 24} (go/func ^{:go/linkname "Float32bits"} Float32bits "Float32bits returns the IEEE 754 binary representation of f,\nwith the sign bit of f and the result in the same bit position.\nFloat32bits(Float32frombits(x)) == x.\n" ^uint32 [^float32 f] @(conv (* uint32) (conv unsafe/Pointer (addr f))))





^{:go/end 30} (go/func Float32frombits "Float32frombits returns the floating-point number corresponding\nto the IEEE 754 binary representation b, with the sign bit of b\nand the result in the same bit position.\nFloat32frombits(Float32bits(x)) == x.\n" ^float32 [^uint32 b] @(conv (* float32) (conv unsafe/Pointer (addr b))))




^{:go/end 35} (go/func Float64bits "Float64bits returns the IEEE 754 binary representation of f,\nwith the sign bit of f and the result in the same bit position,\nand Float64bits(Float64frombits(x)) == x.\n" ^uint64 [^float64 f] @(conv (* uint64) (conv unsafe/Pointer (addr f))))





^{:go/end 41} (go/func Float64frombits "Float64frombits returns the floating-point number corresponding\nto the IEEE 754 binary representation b, with the sign bit of b\nand the result in the same bit position.\nFloat64frombits(Float64bits(x)) == x.\n" ^float64 [^uint64 b] @(conv (* float64) (conv unsafe/Pointer (addr b))))

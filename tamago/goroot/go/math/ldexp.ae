(in-ns 'go.math) (go/file "ldexp.go" :imports [])









^{:go/end 20} (go/func Ldexp "Ldexp is the inverse of [Frexp].\nIt returns frac × 2**exp.\n\nSpecial cases are:\n\n\tLdexp(±0, exp) = ±0\n\tLdexp(±Inf, exp) = ±Inf\n\tLdexp(NaN, exp) = NaN\n" ^float64 [^float64 frac ^int exp]
  (when haveArchLdexp
    (return (archLdexp frac exp)))

  (ldexp frac exp))


^{:go/end 51} (go/func ldexp ^float64 [^float64 frac ^int exp]
  ;; special cases
  (switch
    (case [(== frac 0)]
      (return frac)) ; correctly return -0
    (case [(or (IsInf frac 0) (IsNaN frac))]
      (return frac)))

  (let [(values ^:assign frac e) (normalize frac)]
    (set! exp + e)
    (let [x (Float64bits frac)]
      (set! exp + (- (bit-and (conv int (>> x shift)) mask) bias))
      (when (< exp -1075)
        (return (Copysign 0 frac))) ; underflow

      (when (> exp 1023) ; overflow
        (when (< frac 0)
          (return (Inf -1)))

        (return (Inf 1)))

      (let [^float64 m 1]
        (when (< exp -1022) ; denormal
          (set! exp + 53)
          (set! m (/ 1.0 (<< 1 53)))) ; 2**-53

        (set! x bit-and-not (<< mask shift))
        (set! x bit-or (<< (conv uint64 (+ exp bias)) shift))
        (* m (Float64frombits x))))))

(ns go.math.cmplx
  (:require [arbace.go :as go]))

(go/package cmplx
  :path "math/cmplx"
  :files ["abs.go" "asin.go" "conj.go" "exp.go" "isinf.go" "isnan.go" "log.go" "phase.go" "polar.go" "pow.go" "rect.go" "sin.go" "sqrt.go" "tan.go"]
  :positions :lines)

(load "cmplx/abs")
(load "cmplx/asin")
(load "cmplx/conj")
(load "cmplx/exp")
(load "cmplx/isinf")
(load "cmplx/isnan")
(load "cmplx/log")
(load "cmplx/phase")
(load "cmplx/polar")
(load "cmplx/pow")
(load "cmplx/rect")
(load "cmplx/sin")
(load "cmplx/sqrt")
(load "cmplx/tan")

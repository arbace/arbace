(ns go.math.cmplx
  (:require [arbace.go :as go]))

(go/package cmplx
  :path "math/cmplx"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["abs.go" "asin.go" "conj.go" "exp.go" "isinf.go" "isnan.go" "log.go" "phase.go" "polar.go" "pow.go" "rect.go" "sin.go" "sqrt.go" "tan.go"]
  :init-order []
  :positions :lines)

(load "cmplx/abs")
(load "cmplx/asin")
(load "cmplx/conj")
(load "cmplx/exp")
(load "cmplx/isinf")
(load "cmplx/isnan")
(load "cmplx/log")
(load "cmplx/phase")
(load "cmplx/polar")
(load "cmplx/pow")
(load "cmplx/rect")
(load "cmplx/sin")
(load "cmplx/sqrt")
(load "cmplx/tan")

(in-ns 'go.math) (go/file "hypot.go" :imports [])

;; /*
;; Hypot -- sqrt(p*p + q*q), but overflows only if the result does.
;; */










^{:go/end 25} (go/func Hypot "Hypot returns [Sqrt](p*p + q*q), taking care to avoid\nunnecessary overflow and underflow.\n\nSpecial cases are:\n\n\tHypot(±Inf, q) = +Inf\n\tHypot(p, ±Inf) = +Inf\n\tHypot(NaN, q) = NaN\n\tHypot(p, NaN) = NaN\n" ^float64 [^float64 p ^float64 q]
  (when haveArchHypot
    (return (archHypot p q)))

  (hypot p q))


^{:go/end 44} (go/func hypot ^float64 [^float64 p ^float64 q]
  (set! (values p q) (values (Abs p) (Abs q)))
  ;; special cases
  (switch
    (case [(or (IsInf p 1) (IsInf q 1))]
      (return (Inf 1)))
    (case [(or (IsNaN p) (IsNaN q))]
      (return (NaN))))

  (when (< p q)
    (set! (values p q) (values q p)))

  (when (== p 0)
    (return 0))

  (set! q (/ q p))
  (* p (Sqrt (+ 1 (* q q)))))

(in-ns 'go.math) (go/file "modf.go" :imports [])








^{:go/end 18} (go/func Modf "Modf returns integer and fractional floating-point numbers\nthat sum to f. Both values have the same sign as f.\n\nSpecial cases are:\n\n\tModf(±Inf) = ±Inf, NaN\n\tModf(NaN) = NaN, NaN\n" [^float64 f] :results [^float64 integer ^float64 fractional]
  (set! integer (Trunc f))
  (set! fractional (Copysign (- f integer) f))
  (return))

(in-ns 'go.math) (go/file "copysign.go" :imports [])



^{:go/end 11} (go/func Copysign "Copysign returns a value with the magnitude of f\nand the sign of sign.\n" ^float64 [^float64 f ^float64 sign]
  (Float64frombits (bit-or (bit-and-not (Float64bits f) signMask) (bit-and (Float64bits sign) signMask))))

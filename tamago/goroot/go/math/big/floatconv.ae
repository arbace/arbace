^{:go/end 212} (go/method pow5 "pow5 sets z to 5**n and returns z.\nn must not be negative.\n" ^{:tag (* Float)} [^{:tag (* Float)} z ^uint64 n]
  (let [^:const ^{:val 27} m (conv uint64 (- (len pow5tab) 1))]
    (when (<= n m)
      (return (.SetUint64 z (aget pow5tab n))))

    ;; n > m

    (.SetUint64 z (aget pow5tab m))
    (set! n - m)

    ;; use more bits for f than for z
    ;; TODO(gri) what is the right number?
    (let [f (.SetUint64 (.SetPrec (new Float) (+ (.Prec z) 64)) 5)]

      (while (> n 0)
        (when (!= (bit-and n 1) 0)
          (.Mul z z f))

        (.Mul f f f)
        (set! n >> 1))


      ^{:line 211} z)))















































^{:go/end 283} (go/method Parse "Parse parses s which must contain a text representation of a floating-\npoint number with a mantissa in the given conversion base (the exponent\nis always a decimal number), or a string representing an infinite value.\n\nFor base 0, an underscore character “_” may appear between a base\nprefix and an adjacent digit, and between successive digits; such\nunderscores do not change the value of the number, or the returned\ndigit count. Incorrect placement of underscores is reported as an\nerror if there are no other errors. If base != 0, underscores are\nnot recognized and thus terminate scanning like any other character\nthat is not a valid radix point or digit.\n\nIt sets z to the (possibly rounded) value of the corresponding floating-\npoint value, and returns z, the actual base b, and an error err, if any.\nThe entire string (not just a prefix) must be consumed for success.\nIf z's precision is 0, it is changed to 64 before rounding takes effect.\nThe number must be of the form:\n\n\tnumber    = [ sign ] ( float | \"inf\" | \"Inf\" ) .\n\tsign      = \"+\" | \"-\" .\n\tfloat     = ( mantissa | prefix pmantissa ) [ exponent ] .\n\tprefix    = \"0\" [ \"b\" | \"B\" | \"o\" | \"O\" | \"x\" | \"X\" ] .\n\tmantissa  = digits \".\" [ digits ] | digits | \".\" digits .\n\tpmantissa = [ \"_\" ] digits \".\" [ digits ] | [ \"_\" ] digits | \".\" digits .\n\texponent  = ( \"e\" | \"E\" | \"p\" | \"P\" ) [ sign ] digits .\n\tdigits    = digit { [ \"_\" ] digit } .\n\tdigit     = \"0\" ... \"9\" | \"a\" ... \"z\" | \"A\" ... \"Z\" .\n\nThe base argument must be 0, 2, 8, 10, or 16. Providing an invalid base\nargument will lead to a run-time panic.\n\nFor base 0, the number prefix determines the actual base: A prefix of\n“0b” or “0B” selects base 2, “0o” or “0O” selects base 8, and\n“0x” or “0X” selects base 16. Otherwise, the actual base is 10 and\nno prefix is accepted. The octal prefix \"0\" is not supported (a leading\n\"0\" is simply considered a \"0\").\n\nA \"p\" or \"P\" exponent indicates a base 2 (rather than base 10) exponent;\nfor instance, \"0x1.fffffffffffffp1023\" (using base 0) represents the\nmaximum float64 value. For hexadecimal mantissae, the exponent character\nmust be one of 'p' or 'P', if present (an \"e\" or \"E\" exponent indicator\ncannot be distinguished from a mantissa digit).\n\nThe returned *Float f is nil and the value of z is valid but not\ndefined if an error is reported.\n" [^{:tag (* Float)} z ^string s ^int base] :results [^{:tag (* Float)} f ^int b ^error err]
  ;; scan doesn't handle ±Inf
  (when (and (== (len s) 3) ^:go/paren (or (== s "Inf") (== s "inf")))
    (set! f (.SetInf z false))
    (return))

  (when (and (== (len s) 4) ^:go/paren (or (== (aget s 0) \+) (== (aget s 0) \-)) ^:go/paren (or (== (subslice s 1) "Inf") (== (subslice s 1) "inf")))
    (set! f (.SetInf z (== (aget s 0) \-)))
    (return))


  (let [r (strings/NewReader s)]
    (when [(set! (values f b err) (.scan z r base))] (!= err nil)
      (return))


    ;; entire string must have been consumed
    (if [(values ch err2) (.ReadByte r)] (== err2 nil)
      (set! err (fmt/Errorf "expected end of string, found %q" ch))
      (when (!= err2 io/EOF)
        (set! err err2)))


    (return)))




^{:go/end 289} (go/func ParseFloat "ParseFloat is like f.Parse(s, base) with f set to the given precision\nand rounding mode.\n" [^string s ^int base ^uint prec ^RoundingMode mode] :results [^{:tag (* Float)} f ^int b ^error err]
  (.Parse (.SetMode (.SetPrec (new Float) prec) mode) s base))


(go/var ^fmt/Scanner _ (conv (* Float) nil)) ; *Float must implement fmt.Scanner






^{:go/end 302} (go/method Scan "Scan is a support routine for [fmt.Scanner]; it sets z to the value of\nthe scanned number. It accepts formats whose verbs are supported by\n[fmt.Scan] for floating point values, which are:\n'b' (binary), 'e', 'E', 'f', 'F', 'g' and 'G'.\nScan doesn't handle ±Inf.\n" ^error [^{:tag (* Float)} z ^fmt/ScanState s ^rune ch]
  (.SkipSpace s)
  (let [(values _ _ err) (.scan z (lit byteReader s) 0)]
    ^{:line 301} err))

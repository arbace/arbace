      (set! c (conv Word cc))))

  (return))















^{:go/end 131} (go/func ^{:go/linkname "addVW"} addVW "addVW sets z = x + y, returning the final carry c.\nThe behavior is undefined if len(x) != len(z).\nIf len(z) == 0, c = y; otherwise, c is 0 or 1.\n\naddVW should be an internal detail,\nbut widely used packages access it using linkname.\nNotable members of the hall of shame include:\n  - github.com/remyoudompheng/bigfft\n\nDo not remove or change the type signature.\nSee go.dev/issue/67401.\n" [^{:tag (slice Word)} z ^{:tag (slice Word)} x ^Word y] :results [^Word c]
  (when (!= (len x) (len z))
    (panic "addVW len"))


  (when (== (len z) 0)
    (return y))

  ^{:go/breaks [[5 130]]} (let [(values zi cc) (bits/Add (conv uint (aget x 0)) (conv uint y) 0)]
    (aset z 0 (conv Word zi))
    (when (== cc 0)
      (when (!= (addr (aget z 0)) (addr (aget x 0)))
        (copy (subslice z 1) (subslice x 1)))

      (return 0))

    (for [i 1] (< i (len z)) (inc! i)
      (let [xi (aget x i)]
        (when (!= xi (bit-not (conv Word 0)))
          (aset z i (+ xi 1))
          (when (!= (addr (aget z 0)) (addr (aget x 0)))
            (copy (subslice z (+ i 1)) (subslice x (+ i 1))))

          (return 0))

        (aset z i 0)))

    1))



^{:go/end 142} (go/func addVW_ref "addVW_ref is the reference implementation for addVW, used only for testing.\n" [^{:tag (slice Word)} z ^{:tag (slice Word)} x ^Word y] :results [^Word c]
  (set! c y)
  (range [i z]
    (let [(values zi cc) (bits/Add (conv uint (aget x i)) (conv uint c) 0)]
      (aset z i (conv Word zi))
      (set! c (conv Word cc))))

  (return))















^{:go/end 185} (go/func ^{:go/linkname "subVW"} subVW "subVW sets z = x - y, returning the final carry c.\nThe behavior is undefined if len(x) != len(z).\nIf len(z) == 0, c = y; otherwise, c is 0 or 1.\n\nsubVW should be an internal detail,\nbut widely used packages access it using linkname.\nNotable members of the hall of shame include:\n  - github.com/remyoudompheng/bigfft\n\nDo not remove or change the type signature.\nSee go.dev/issue/67401.\n" [^{:tag (slice Word)} z ^{:tag (slice Word)} x ^Word y] :results [^Word c]
  (when (!= (len x) (len z))
    (panic "subVW len"))


  (when (== (len z) 0)
    (return y))

  ^{:go/breaks [[5 184]]} (let [(values zi cc) (bits/Sub (conv uint (aget x 0)) (conv uint y) 0)]
    (aset z 0 (conv Word zi))
    (when (== cc 0)
      (when (!= (addr (aget z 0)) (addr (aget x 0)))
        (copy (subslice z 1) (subslice x 1)))

      (return 0))

    (for [i 1] (< i (len z)) (inc! i)
      (let [xi (aget x i)]
        (when (!= xi 0)
          (aset z i (- xi 1))
          (when (!= (addr (aget z 0)) (addr (aget x 0)))
            (copy (subslice z (+ i 1)) (subslice x (+ i 1))))

          (return 0))

        (aset z i (bit-not (conv Word 0)))))

    1))




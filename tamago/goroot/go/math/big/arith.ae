^{:go/end 219} (go/func lshVU_g [^{:tag (slice Word)} z ^{:tag (slice Word)} x ^uint s] :results [^Word c]
  (when (!= (len x) (len z))
    (panic "lshVU len"))


  (when (== s 0)
    (copy z x)
    (return))

  (when (== (len z) 0)
    (return))

  (set! s bit-and (- _W 1)) ; hint to the compiler that shifts by s don't need guard code
  (let [ŝ (- _W s)]
    (set! ŝ bit-and (- _W 1)) ; ditto
    (set! c (>> (aget x (- (len z) 1)) ŝ))
    (for [i (- (len z) 1)] (> i 0) (dec! i)
      (aset z i (bit-or (<< (aget x i) s) (>> (aget x (- i 1)) ŝ))))

    (aset z 0 (<< (aget x 0) s))
    (return)))


^{:go/end 242} (go/func rshVU_g [^{:tag (slice Word)} z ^{:tag (slice Word)} x ^uint s] :results [^Word c]
  (when (!= (len x) (len z))
    (panic "rshVU len"))


  (when (== s 0)
    (copy z x)
    (return))

  (when (== (len z) 0)
    (return))

  (set! s bit-and (- _W 1)) ; hint to the compiler that shifts by s don't need guard code
  (let [ŝ (- _W s)]
    (set! ŝ bit-and (- _W 1)) ; ditto
    (set! c (<< (aget x 0) ŝ))
    (for [i 1] (< i (len z)) (inc! i)
      (aset z (- i 1) (bit-or (>> (aget x (- i 1)) s) (<< (aget x i) ŝ))))

    (aset z (- (len z) 1) (>> (aget x (- (len z) 1)) s))
    (return)))


^{:go/end 253} (go/func mulAddVWW_g [^{:tag (slice Word)} z ^{:tag (slice Word)} x ^Word y ^Word r] :results [^Word c]
  (when (!= (len x) (len z))
    (panic "mulAddVWW len"))

  (set! c r)
  (range [i z]
    (set! (values c (aget z i)) (mulAddWWW_g (aget x i) y c)))

  (return))


^{:go/end 268} (go/func addMulVVWW_g [^{:tag (slice Word)} z ^{:tag (slice Word)} x ^{:tag (slice Word)} y ^Word m ^Word a] :results [^Word c]
  (when (or (!= (len x) (len z)) (!= (len y) (len z)))
    (panic "addMulVVWW len"))


  (set! c a)
  (range [i z]
    (let [(values z1 z0) (mulAddWWW_g (aget y i) m (aget x i))
        (values lo cc) (bits/Add (conv uint z0) (conv uint c) 0)]
      (set! (values c (aget z i)) (values (conv Word cc) (conv Word lo)))
      (set! c + z1)))

  (return))





^{:go/end 330} (go/func divWW "q = ( x1 << _W + x0 - r)/y. m = floor(( _B^2 - 1 ) / d - _B). Requiring x1<y.\nAn approximate reciprocal with a reference to \"Improved Division by Invariant Integers\n(IEEE Transactions on Computers, 11 Jun. 2010)\"\n" [^Word x1 ^Word x0 ^Word y ^Word m] :results [^Word q ^Word r]
  (let [s (nlz y)]
    (when (!= s 0)
      (set! x1 (bit-or (<< x1 s) (>> x0 (- _W s))))
      (set! x0 << s)
      (set! y << s))

    (let [d (conv uint y)
        ;; We know that
        ;;   m = ⎣(B^2-1)/d⎦-B
        ;;   ⎣(B^2-1)/d⎦ = m+B
        ;;   (B^2-1)/d = m+B+delta1    0 <= delta1 <= (d-1)/d
        ;;   B^2/d = m+B+delta2        0 <= delta2 <= 1
        ;; The quotient we're trying to compute is
        ;;   quotient = ⎣(x1*B+x0)/d⎦
        ;;            = ⎣(x1*B*(B^2/d)+x0*(B^2/d))/B^2⎦
        ;;            = ⎣(x1*B*(m+B+delta2)+x0*(m+B+delta2))/B^2⎦
        ;;            = ⎣(x1*m+x1*B+x0)/B + x0*m/B^2 + delta2*(x1*B+x0)/B^2⎦
        ;; The latter two terms of this three-term sum are between 0 and 1.
        ;; So we can compute just the first term, and we will be low by at most 2.
        (values t1 t0) (bits/Mul (conv uint m) (conv uint x1))
        (values _ c) (bits/Add t0 (conv uint x0) 0)]
      (set! (values t1 _) (bits/Add t1 (conv uint x1) c))
      ;; The quotient is either t1, t1+1, or t1+2.
      ;; We'll try t1 and adjust if needed.
      (let [qq t1
          ;; compute remainder r=x-d*q.
          (values dq1 dq0) (bits/Mul d qq)
          (values r0 b) (bits/Sub (conv uint x0) dq0 0)
          (values r1 _) (bits/Sub (conv uint x1) dq1 b)]
        ;; The remainder we just computed is bounded above by B+d:
        ;; r = x1*B + x0 - d*q.
        ;;   = x1*B + x0 - d*⎣(x1*m+x1*B+x0)/B⎦
        ;;   = x1*B + x0 - d*((x1*m+x1*B+x0)/B-alpha)                                   0 <= alpha < 1
        ;;   = x1*B + x0 - x1*d/B*m                         - x1*d - x0*d/B + d*alpha
        ;;   = x1*B + x0 - x1*d/B*⎣(B^2-1)/d-B⎦             - x1*d - x0*d/B + d*alpha
        ;;   = x1*B + x0 - x1*d/B*⎣(B^2-1)/d-B⎦             - x1*d - x0*d/B + d*alpha
        ;;   = x1*B + x0 - x1*d/B*((B^2-1)/d-B-beta)        - x1*d - x0*d/B + d*alpha   0 <= beta < 1
        ;;   = x1*B + x0 - x1*B + x1/B + x1*d + x1*d/B*beta - x1*d - x0*d/B + d*alpha
        ;;   =        x0        + x1/B        + x1*d/B*beta        - x0*d/B + d*alpha
        ;;   = x0*(1-d/B) + x1*(1+d*beta)/B + d*alpha
        ;;   <  B*(1-d/B) +  d*B/B          + d          because x0<B (and 1-d/B>0), x1<d, 1+d*beta<=B, alpha<1
        ;;   =  B - d     +  d              + d
        ;;   = B+d
        ;; So r1 can only be 0 or 1. If r1 is 1, then we know q was too small.
        ;; Add 1 to q and subtract d from r. That guarantees that r is <B, so
        ;; we no longer need to keep track of r1.
        (when (!= r1 0)
          (inc! qq)
          (set! r0 - d))

        ;; If the remainder is still too large, increment q one more time.
        (when (>= r0 d)
          (inc! qq)
          (set! r0 - d))

        (return (conv Word qq) (conv Word (>> r0 s)))))))



^{:go/end 339} (go/func reciprocalWord "reciprocalWord return the reciprocal of the divisor. rec = floor(( _B^2 - 1 ) / u - _B). u = d1 << nlz(d1).\n" ^Word [^Word d1]
  (let [u (conv uint (<< d1 (nlz d1)))
      ^{:line 335} x1 (bit-not u)
      ^{:line 336} x0 (conv uint _M)
      (values rec _) (bits/Div x1 x0 u)] ; (_B^2-1)/U-_B = (_B*(_M-C)+_M)/U
    (conv Word rec)))

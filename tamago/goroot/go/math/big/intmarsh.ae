;; This file implements encoding/decoding of Ints.

(in-ns 'go.math.big) (go/file "intmarsh.go" :imports [


    ^{:line 10} [bytes "bytes"]
    ^{:line 11} [fmt "fmt"]])



(go/const ^{:tag byte :val 1 :doc "Gob codec version. Permits backward-compatible changes to the encoding.\n"} intGobVersion 1)


^{:go/end 30} (go/method GobEncode "GobEncode implements the [encoding/gob.GobEncoder] interface.\n" [^{:tag (* Int)} x] :results [(slice byte) error]
  (when (== x nil)
    (return nil nil))

  (let [buf (make (slice byte) (+ 1 (* (len (.-abs x)) _S))) ; extra byte for version and sign bit
      ^{:line 23} i (- (.bytes (.-abs x) buf) 1) ; i >= 0
      ^{:line 24} b (<< intGobVersion 1)] ; make space for sign bit
    (when (.-neg x)
      (set! b bit-or 1))

    (aset buf i b)
    (return (subslice buf i) nil)))



^{:go/end 46} (go/method GobDecode "GobDecode implements the [encoding/gob.GobDecoder] interface.\n" ^error [^{:tag (* Int)} z ^{:tag (slice byte)} buf]
  (when (== (len buf) 0)
    ;; Other side sent a nil or default value.
    (set! @z (lit Int))
    (return nil))

  ^{:go/breaks [5]} (let [b (aget buf 0)]
    (when (!= (>> b 1) intGobVersion)
      (return (fmt/Errorf "Int.GobDecode: encoding version %d not supported" (>> b 1))))

    (set! (.-neg z) (!= (bit-and b 1) 0))
    (set! (.-abs z) (.setBytes (.-abs z) (subslice buf 1)))
    nil))



^{:go/end 51} (go/method AppendText "AppendText implements the [encoding.TextAppender] interface.\n" [^{:tag (* Int)} x ^{:tag (slice byte)} b] :results [^{:tag (slice byte)} text ^error err]
  (return (.Append x b 10) nil))



^{:go/end 56} (go/method MarshalText "MarshalText implements the [encoding.TextMarshaler] interface.\n" [^{:tag (* Int)} x] :results [^{:tag (slice byte)} text ^error err]
  (.AppendText x nil))



^{:go/breaks [[5 63]] :go/end 64} (go/method UnmarshalText "UnmarshalText implements the [encoding.TextUnmarshaler] interface.\n" ^error [^{:tag (* Int)} z ^{:tag (slice byte)} text]
  (when [(values _ ok) (.setFromScanner z (bytes/NewReader text) 0)] (not ok)
    (return (fmt/Errorf "math/big: cannot unmarshal %q into a *big.Int" text)))

  nil)


;; The JSON marshalers are only here for API backward compatibility
;; (programs that explicitly look for these two methods). JSON works
;; fine with the TextMarshaler only.


^{:go/end 76} (go/method MarshalJSON "MarshalJSON implements the [encoding/json.Marshaler] interface.\n" [^{:tag (* Int)} x] :results [(slice byte) error]
  (when (== x nil)
    (return (conv (slice byte) "null") nil))

  (return (.itoa (.-abs x) (.-neg x) 10) nil))



^{:go/end 85} (go/method UnmarshalJSON "UnmarshalJSON implements the [encoding/json.Unmarshaler] interface.\n" ^error [^{:tag (* Int)} z ^{:tag (slice byte)} text]
  ;; Ignore null, like in the main JSON package.
  (when (== (conv string text) "null")
    (return nil))

  (.UnmarshalText z text))

;; This file implements encoding/decoding of Rats.

(in-ns 'go.math.big) (go/file "ratmarsh.go" :imports [


    ^{:line 10} [errors "errors"]
    ^{:line 11} [fmt "fmt"]
    ^{:line 12} [byteorder "internal/byteorder"]
    ^{:line 13} [math "math"]])



(go/const ^{:tag byte :val 1 :doc "Gob codec version. Permits backward-compatible changes to the encoding.\n"} ratGobVersion 1)


^{:go/end 40} (go/method GobEncode "GobEncode implements the [encoding/gob.GobEncoder] interface.\n" [^{:tag (* Rat)} x] :results [(slice byte) error]
  (when (== x nil)
    (return nil nil))

  (let [buf (make (slice byte) (+ 1 4 (* (+ (len (.-abs (.-a x))) (len (.-abs (.-b x)))) _S))) ; extra bytes for version and sign bit (1), and numerator length (4)
      ^{:line 25} i (.bytes (.-abs (.-b x)) buf)
      ^{:line 26} j (.bytes (.-abs (.-a x)) (subslice buf _ i))
      ^{:line 27} n (- i j)]
    (when (!= (conv int (conv uint32 n)) n)
      ;; this should never happen
      (return nil (errors/New "Rat.GobEncode: numerator too large")))

    (byteorder/BEPutUint32 (subslice buf (- j 4) j) (conv uint32 n))
    (set! j - (+ 1 4))
    (let [b (<< ratGobVersion 1)] ; make space for sign bit
      (when (.-neg (.-a x))
        (set! b bit-or 1))

      (aset buf j b)
      (return (subslice buf j) nil))))



^{:go/end 69} (go/method GobDecode "GobDecode implements the [encoding/gob.GobDecoder] interface.\n" ^error [^{:tag (* Rat)} z ^{:tag (slice byte)} buf]
  (when (== (len buf) 0)
    ;; Other side sent a nil or default value.
    (set! @z (lit Rat))
    (return nil))

  (when (< (len buf) 5)
    (return (errors/New "Rat.GobDecode: buffer too small")))

  (let [b (aget buf 0)]
    (when (!= (>> b 1) ratGobVersion)
      (return (fmt/Errorf "Rat.GobDecode: encoding version %d not supported" (>> b 1))))

    (let [^:const ^{:val 5} j (+ 1 4)
        ^{:line 57} ln (byteorder/BEUint32 (subslice buf (- j 4) j))]
      (when (> (conv uint64 ln) (- math/MaxInt j))
        (return (errors/New "Rat.GobDecode: invalid length")))

      ^{:go/breaks [6]} (let [i (+ j (conv int ln))]
        (when (< (len buf) i)
          (return (errors/New "Rat.GobDecode: buffer too small")))

        (set! (.-neg (.-a z)) (!= (bit-and b 1) 0))
        (set! (.-abs (.-a z)) (.setBytes (.-abs (.-a z)) (subslice buf j i)))
        (set! (.-abs (.-b z)) (.setBytes (.-abs (.-b z)) (subslice buf i)))
        nil))))



^{:go/end 77} (go/method AppendText "AppendText implements the [encoding.TextAppender] interface.\n" [^{:tag (* Rat)} x ^{:tag (slice byte)} b] :results [(slice byte) error]
  (when (.IsInt x)
    (return (.AppendText (.-a x) b)))

  (return (.marshal x b) nil))



^{:go/end 82} (go/method MarshalText "MarshalText implements the [encoding.TextMarshaler] interface.\n" [^{:tag (* Rat)} x] :results [^{:tag (slice byte)} text ^error err]
  (.AppendText x nil))



^{:go/breaks [[5 90]] :go/end 91} (go/method UnmarshalText "UnmarshalText implements the [encoding.TextUnmarshaler] interface.\n" ^error [^{:tag (* Rat)} z ^{:tag (slice byte)} text]
  ;; TODO(gri): get rid of the []byte/string conversion
  (when [(values _ ok) (.SetString z (conv string text))] (not ok)
    (return (fmt/Errorf "math/big: cannot unmarshal %q into a *big.Rat" text)))

  nil)

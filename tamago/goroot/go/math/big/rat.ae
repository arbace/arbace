  (let [b (.-abs (.-b x))]
    (when (== (len b) 0)
      (set! b natOne))

    (let [stk (getStack)]
      (defer (.free stk))
      (set! (values f exact) (quotToFloat64 stk (.-abs (.-a x)) b))
      (when (.-neg (.-a x))
        (set! f (- f)))

      (return))))




^{:go/end 319} (go/method SetFrac "SetFrac sets z to a/b and returns z.\nIf b == 0, SetFrac panics.\n" ^{:tag (* Rat)} [^{:tag (* Rat)} z ^{:tag (* Int)} a ^{:tag (* Int)} b]
  (set! (.-neg (.-a z)) (!= (.-neg a) (.-neg b)))
  (let [babs (.-abs b)]
    (when (== (len babs) 0)
      (panic "division by zero"))

    (when (or (== (addr (.-a z)) b) (alias (.-abs (.-a z)) babs))
      (set! babs (.set (conv nat nil) babs))) ; make a copy

    (set! (.-abs (.-a z)) (.set (.-abs (.-a z)) (.-abs a)))
    (set! (.-abs (.-b z)) (.set (.-abs (.-b z)) babs))
    (.norm z)))




^{:go/end 334} (go/method SetFrac64 "SetFrac64 sets z to a/b and returns z.\nIf b == 0, SetFrac64 panics.\n" ^{:tag (* Rat)} [^{:tag (* Rat)} z ^int64 a ^int64 b]
  (when (== b 0)
    (panic "division by zero"))

  (.SetInt64 (.-a z) a)
  (when (< b 0)
    (set! b (- b))
    (set! (.-neg (.-a z)) (not (.-neg (.-a z)))))

  (set! (.-abs (.-b z)) (.setUint64 (.-abs (.-b z)) (conv uint64 b)))
  (.norm z))




^{:go/end 285} (go/method Float32 "Float32 returns the nearest float32 value for x and a bool indicating\nwhether f represents x exactly. If the magnitude of x is too large to\nbe represented by a float32, f is an infinity and exact is false.\nThe sign of f always matches the sign of x, even if f == 0.\n" [^{:tag (* Rat)} x] :results [^float32 f ^bool exact]
  (let [b (.-abs (.-b x))]
    (when (== (len b) 0)
      (set! b natOne))

    (let [stk (getStack)]
      (defer (.free stk))
      (set! (values f exact) (quotToFloat32 stk (.-abs (.-a x)) b))
      (when (.-neg (.-a x))
        (set! f (- f)))

      (return))))







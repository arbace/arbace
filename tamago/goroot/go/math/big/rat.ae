^{:go/end 413} (go/method Num "Num returns the numerator of x; it may be <= 0.\nThe result is a reference to x's numerator; it\nmay change if a new value is assigned to x, and vice versa.\nThe sign of the numerator corresponds to the sign of x.\n" ^{:tag (* Int)} [^{:tag (* Rat)} x]
  (addr (.-a x)))









^{:go/end 431} (go/method Denom "Denom returns the denominator of x; it is always > 0.\nThe result is a reference to x's denominator, unless\nx is an uninitialized (zero value) [Rat], in which case\nthe result is a new [Int] of value 1. (To initialize x,\nany operation that sets x will do, including x.Set(x).)\nIf the result is a reference to x's denominator it\nmay change if a new value is assigned to x, and vice versa.\n" ^{:tag (* Int)} [^{:tag (* Rat)} x]
  ;; Note that x.b.neg is guaranteed false.
  (when (== (len (.-abs (.-b x))) 0)
    ;; Note: If this proves problematic, we could
    ;;       panic instead and require the Rat to
    ;;       be explicitly initialized.
    (return (addr (lit Int :abs (lit nat 1)))))

  (addr (.-b x)))


^{:go/end 456} (go/method norm ^{:tag (* Rat)} [^{:tag (* Rat)} z]
  (switch
    (case [(== (len (.-abs (.-a z))) 0)]
      ;; z == 0; normalize sign and denominator
      (set! (.-neg (.-a z)) false)
      (fallthrough))
    (case [(== (len (.-abs (.-b z))) 0)]
      ;; z is integer; normalize denominator
      (set! (.-abs (.-b z)) (.setWord (.-abs (.-b z)) 1)))
    (default
      ;; z is fraction; normalize numerator and denominator
      (let [stk (getStack)]
        (defer (.free stk))
        (let [neg (.-neg (.-a z))]
          (set! (.-neg (.-a z)) false)
          (set! (.-neg (.-b z)) false)
          (when [f (.lehmerGCD (NewInt 0) nil nil (addr (.-a z)) (addr (.-b z)))] (!= (.Cmp f intOne) 0)
            (set! (values (.-abs (.-a z)) _) (.div (.-abs (.-a z)) stk nil (.-abs (.-a z)) (.-abs f)))
            (set! (values (.-abs (.-b z)) _) (.div (.-abs (.-b z)) stk nil (.-abs (.-b z)) (.-abs f))))

          (set! (.-neg (.-a z)) neg)))))

  ^{:line 455} z)





^{:go/end 471} (go/func mulDenom "mulDenom sets z to the denominator product x*y (by taking into\naccount that 0 values for x or y must be interpreted as 1) and\nreturns z.\n" ^nat [^{:tag (* stack)} stk ^nat z ^nat x ^nat y]
  (switch
    (case [(and (== (len x) 0) (== (len y) 0))]
      (return (.setWord z 1)))
    (case [(== (len x) 0)]
      (return (.set z y)))
    (case [(== (len y) 0)]
      (return (.set z x))))

  (.mul z stk x y))




^{:go/end 482} (go/method scaleDenom "scaleDenom sets z to the product x*f.\nIf f == 0 (zero value of denominator), z is set to (a copy of) x.\n" [^{:tag (* Int)} z ^{:tag (* stack)} stk ^{:tag (* Int)} x ^nat f]
  (when (== (len f) 0)
    (.Set z x)
    (return))

  (set! (.-abs z) (.mul (.-abs z) stk (.-abs x) f))
  (set! (.-neg z) (.-neg x)))






^{:go/end 495} (go/method Cmp "Cmp compares x and y and returns:\n  - -1 if x < y;\n  - 0 if x == y;\n  - +1 if x > y.\n" ^int [^{:tag (* Rat)} x ^{:tag (* Rat)} y]
  (let [(values ^Int a ^Int b) (zero Int)
      ^{:line 490} stk (getStack)]
    (defer (.free stk))
    (.scaleDenom a stk (addr (.-a x)) (.-abs (.-b y)))
    (.scaleDenom b stk (addr (.-a y)) (.-abs (.-b x)))
    (.Cmp a (addr b))))



^{:go/end 508} (go/method Add "Add sets z to the sum x+y and returns z.\n" ^{:tag (* Rat)} [^{:tag (* Rat)} z ^{:tag (* Rat)} x ^{:tag (* Rat)} y]
  (let [stk (getStack)]
    (defer (.free stk))

    (let [(values ^Int a1 ^Int a2) (zero Int)]
      (.scaleDenom a1 stk (addr (.-a x)) (.-abs (.-b y)))
      (.scaleDenom a2 stk (addr (.-a y)) (.-abs (.-b x)))
      (.Add (.-a z) (addr a1) (addr a2))
      (set! (.-abs (.-b z)) (mulDenom stk (.-abs (.-b z)) (.-abs (.-b x)) (.-abs (.-b y))))
      (.norm z))))



^{:go/end 521} (go/method Sub "Sub sets z to the difference x-y and returns z.\n" ^{:tag (* Rat)} [^{:tag (* Rat)} z ^{:tag (* Rat)} x ^{:tag (* Rat)} y]
  (let [stk (getStack)]
    (defer (.free stk))

    (let [(values ^Int a1 ^Int a2) (zero Int)]
      (.scaleDenom a1 stk (addr (.-a x)) (.-abs (.-b y)))
      (.scaleDenom a2 stk (addr (.-a y)) (.-abs (.-b x)))
      (.Sub (.-a z) (addr a1) (addr a2))
      (set! (.-abs (.-b z)) (mulDenom stk (.-abs (.-b z)) (.-abs (.-b x)) (.-abs (.-b y))))
      (.norm z))))



^{:go/end 543} (go/method Mul "Mul sets z to the product x*y and returns z.\n" ^{:tag (* Rat)} [^{:tag (* Rat)} z ^{:tag (* Rat)} x ^{:tag (* Rat)} y]
  (let [stk (getStack)]
    (defer (.free stk))

    (when (== x y)
      ;; a squared Rat is positive and can't be reduced (no need to call norm())
      (set! (.-neg (.-a z)) false)
      (set! (.-abs (.-a z)) (.sqr (.-abs (.-a z)) stk (.-abs (.-a x))))
      (if (== (len (.-abs (.-b x))) 0)
        (set! (.-abs (.-b z)) (.setWord (.-abs (.-b z)) 1))

        (set! (.-abs (.-b z)) (.sqr (.-abs (.-b z)) stk (.-abs (.-b x)))))

      (return z))


    (.mul (.-a z) stk (addr (.-a x)) (addr (.-a y)))
    (set! (.-abs (.-b z)) (mulDenom stk (.-abs (.-b z)) (.-abs (.-b x)) (.-abs (.-b y))))
    (.norm z)))




^{:go/end 561} (go/method Quo "Quo sets z to the quotient x/y and returns z.\nIf y == 0, Quo panics.\n" ^{:tag (* Rat)} [^{:tag (* Rat)} z ^{:tag (* Rat)} x ^{:tag (* Rat)} y]
  (let [stk (getStack)]
    (defer (.free stk))

    (when (== (len (.-abs (.-a y))) 0)
      (panic "division by zero"))

    (let [(values ^Int a ^Int b) (zero Int)]
      (.scaleDenom a stk (addr (.-a x)) (.-abs (.-b y)))
      (.scaleDenom b stk (addr (.-a y)) (.-abs (.-b x)))
      (set! (.-abs (.-a z)) (.-abs a))
      (set! (.-abs (.-b z)) (.-abs b))
      (set! (.-neg (.-a z)) (!= (.-neg a) (.-neg b)))
      (.norm z))))

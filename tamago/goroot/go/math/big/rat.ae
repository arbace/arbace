^{:go/end 71} (go/method SetFloat64 "SetFloat64 sets z to exactly f and returns z.\nIf f is not finite, SetFloat returns nil.\n" ^{:tag (* Rat)} [^{:tag (* Rat)} z ^float64 f]
  (let [^:const ^{:val 2047} expMask (- (<< 1 11) 1)
      ^{:line 41} bits (math/Float64bits f)
      ^{:line 42} mantissa (bit-and bits (- (<< 1 52) 1))
      ^{:line 43} exp (conv int (bit-and (>> bits 52) expMask))]
    (switch exp
      (case [expMask] ; non-finite
        (return nil))
      (case [0] ; denormal
        (set! exp - 1022))
      (default ; normal
        (set! mantissa bit-or (<< 1 52))
        (set! exp - 1023)))


    (let [shift (- 52 exp)]

      ;; Optimization (?): partially pre-normalise.
      (while (and (== (bit-and mantissa 1) 0) (> shift 0))
        (set! mantissa >> 1)
        (dec! shift))


      (.SetUint64 (.-a z) mantissa)
      (set! (.-neg (.-a z)) (< f 0))
      (.Set (.-b z) intOne)
      (if (> shift 0)
        (.Lsh (.-b z) (addr (.-b z)) (conv uint shift))

        (.Lsh (.-a z) (addr (.-a z)) (conv uint (- shift))))

      (.norm z))))






^{:go/end 169} (go/func quotToFloat32 "quotToFloat32 returns the non-negative float32 value\nnearest to the quotient a/b, using round-to-even in\nhalfway cases. It does not mutate its arguments.\nPreconditions: b is non-zero; a and b have no common factors.\n" [^{:tag (* stack)} stk ^nat a ^nat b] :results [^float32 f ^bool exact]
  (let [
      ;; float size in bits
      ^:const ^{:line 80 :val 32} Fsize 32

      ;; mantissa
      ^:const ^:go/grouped ^{:line 83 :val 23} Msize 23
      ^:const ^:go/grouped ^{:line 84 :val 24} Msize1 (+ Msize 1) ; incl. implicit 1
      ^:const ^:go/grouped ^{:line 85 :val 25} Msize2 (+ Msize1 1)

      ;; exponent
      ^:const ^:go/grouped ^{:line 88 :val 8} Esize (- Fsize Msize1)
      ^:const ^:go/grouped ^{:line 89 :val 127} Ebias (- (<< 1 (- Esize 1)) 1)
      ^:const ^:go/grouped ^{:line 90 :val -126} Emin (- 1 Ebias)
      ^:const ^:go/grouped ^{:line 91 :val 127} Emax Ebias


      ;; TODO(adonovan): specialize common degenerate cases: 1.0, integers.
      ^{:line 95} alen (.bitLen a)]
    (when (== alen 0)
      (return 0 true))

    (let [blen (.bitLen b)]
      (when (== blen 0)
        (panic "division by zero"))


      ;; 1. Left-shift A or B such that quotient A/B is in [1<<Msize1, 1<<(Msize2+1)
      ;; (Msize2 bits if A < B when they are left-aligned, Msize2+1 bits if A >= B).
      ;; This is 2 or 3 more than the float32 mantissa field width of Msize:
      ;; - the optional extra bit is shifted away in step 3 below.
      ;; - the high-order 1 is omitted in "normal" representation;
      ;; - the low-order 1 will be used during rounding then discarded.
      (let [exp (- alen blen)
          (values ^nat a2 ^nat b2) (zero nat)]
        (set! a2 (.set a2 a))
        (set! b2 (.set b2 b))
        (if [shift (- Msize2 exp)] (> shift 0)
          (set! a2 (.lsh a2 a2 (conv uint shift)))
          (when (< shift 0)
            (set! b2 (.lsh b2 b2 (conv uint (- shift))))))


        ;; 2. Compute quotient and remainder (q, r).  NB: due to the
        ;; extra shift, the low-order bit of q is logically the
        ;; high-order bit of r.
        (let [^nat q (zero nat)
            (values ^:assign q r) (.div q stk a2 a2 b2) ; (recycle a2)
            ^{:line 125} mantissa (low32 q)
            ^{:line 126} haveRem (> (len r) 0)] ; mantissa&1 && !haveRem => remainder is exactly half

          ;; 3. If quotient didn't fit in Msize2 bits, redo division by b2<<1
          ;; (in effect---we accomplish this incrementally).
          (when (== (>> mantissa Msize2) 1)
            (when (== (bit-and mantissa 1) 1)
              (set! haveRem true))

            (set! mantissa >> 1)
            (inc! exp))

          (when (!= (>> mantissa Msize1) 1)
            (panic (fmt/Sprintf "expected exactly %d bits of result" Msize2)))


          ;; 4. Rounding.
          (when (and (<= (- Emin Msize) exp) (<= exp Emin))
            ;; Denormal case; lose 'shift' bits of precision.
            (let [shift (conv uint (- Emin (- exp 1))) ; [1..Esize1)
                ^{:line 145} lostbits (bit-and mantissa (- ^uint32 (<< 1 shift) 1))]
              (set! haveRem (or haveRem (!= lostbits 0)))
              (set! mantissa >> shift)
              (set! exp (- 2 Ebias)))) ; == exp + shift

          ;; Round q using round-half-to-even.
          (set! exact (not haveRem))
          (when (!= (bit-and mantissa 1) 0)
            (set! exact false)
            (when (or haveRem (!= (bit-and mantissa 2) 0))
              (when [(inc! mantissa)] (>= mantissa (<< 1 Msize2))
                ;; Complete rollover 11...1 => 100...0, so shift is safe
                (set! mantissa >> 1)
                (inc! exp))))



          (set! mantissa >> 1) ; discard rounding bit.  Mantissa now scaled by 1<<Msize1.

          (set! f (conv float32 (math/Ldexp (conv float64 mantissa) (- exp Msize1))))
          (when (math/IsInf (conv float64 f) 0)
            (set! exact false))

          (return))))))







;; Note: MaxBase = len(digits), but it must remain an untyped rune constant
;;       for API compatibility.


(go/const ^{:val \> :doc "MaxBase is the largest number base accepted for string conversions.\n"} MaxBase (+ 10 (+ (- \z \a) 1) (+ (- \Z \A) 1)))
(go/const ^{:val \$} maxBaseSmall (+ 10 (+ (- \z \a) 1)))





^{:go/end 41} (go/func maxPow "maxPow returns (b**n, n) such that b**n is the largest power b**n <= _M.\nFor instance maxPow(10) == (1e19, 19) for 19 decimal digits in a 64bit Word.\nIn other words, at most n digits in base b fit into a Word.\nTODO(gri) replace this with a table, generated at build time.\n" [^Word b] :results [^Word p ^int n]
  (set! (values p n) (values b 1)) ; assuming b <= _M
  (for [max (/ _M b)] (<= p max) _
    ;; p == b**n && p <= max
    (set! p * b)
    (inc! n))

  ;; p == b**n && p <= _M
  (return))



^{:go/end 57} (go/func pow "pow returns x**n for n > 0, and 1 otherwise.\n" [^Word x ^int n] :results [^Word p]
  ;; n == sum of bi * 2**i, for 0 <= i < imax, and bi is 0 or 1
  ;; thus x**n == product of x**(2**i) for all i where bi == 1
  ;; (Russian Peasant Method for exponentiation)
  (set! p 1)
  (while (> n 0)
    (when (!= (bit-and n 1) 0)
      (set! p * x))

    (set! x * x)
    (set! n >> 1))

  (return))




^{:go/end 548} (go/func divisors "construct table of powers of bb*leafSize to use in subdivisions.\n" ^{:tag (slice divisor)} [^{:tag (* stack)} stk ^int m ^Word b ^int ndigits ^Word bb]
  ;; only compute table when recursive conversion is enabled and x is large
  (when (or (== leafSize 0) (<= m leafSize))
    (return nil))


  ;; determine k where (bb**leafSize)**(2**k) >= sqrt(x)

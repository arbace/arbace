                (inc! (.-ndigits (aget table i))))


              (set! (.-nbits (aget table i)) (.bitLen (.-bbb (aget table i))))))))




      (when (== b 10)
        ^{:go/via [Mutex]} (.Unlock cacheBase10))


      ^{:line 547} table)))

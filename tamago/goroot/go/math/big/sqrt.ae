^{:go/end 82} (go/method Sqrt "Sqrt sets z to the rounded square root of x, and returns it.\n\nIf z's precision is 0, it is changed to x's precision before the\noperation. Rounding is performed according to z's precision and\nrounding mode, but z's accuracy is not computed. Specifically, the\nresult of z.Acc() is undefined.\n\nThe function panics if z < 0. The value of z is undefined in that\ncase.\n" ^{:tag (* Float)} [^{:tag (* Float)} z ^{:tag (* Float)} x]
  (when debugFloat
    (.validate x))


  (when (== (.-prec z) 0)
    (set! (.-prec z) (.-prec x)))


  (when (== (.Sign x) -1)
    ;; following IEEE754-2008 (section 7.2)
    (panic (lit ErrNaN "square root of negative operand")))


  ;; handle ±0 and +∞
  (when (!= (.-form x) finite)
    (set! (.-acc z) Exact)
    (set! (.-form z) (.-form x))
    (set! (.-neg z) (.-neg x)) ; IEEE754-2008 requires √±0 = ±0
    (return z))


  ;; MantExp sets the argument's precision to the receiver's, and
  ;; when z.prec > x.prec this will lower z.prec. Restore it after
  ;; the MantExp call.
  (let [prec (.-prec z)
      ^{:line 59} b (.MantExp x z)]
    (set! (.-prec z) prec)

    ;; Compute √(z·2**b) as
    ;;   √( z)·2**(½b)     if b is even
    ;;   √(2z)·2**(⌊½b⌋)   if b > 0 is odd
    ;;   √(½z)·2**(⌈½b⌉)   if b < 0 is odd
    (switch (% b 2)
      (case [0])
      ;; nothing to do
      (case [1]
        (inc! (.-exp z)))
      (case [-1]
        (dec! (.-exp z))))

    ;; 0.25 <= z < 2.0

    ;; Solving 1/x² - z = 0 avoids Quo calls and is faster, especially
    ;; for high precisions.
    (.sqrtInverse z z)

    ;; re-attach halved exponent
    (.SetMantExp z z (/ b 2))))







^{:go/end 121} (go/method sqrtInverse "Compute √x (to z.prec precision) by solving\n\n\t1/t² - x = 0\n\nfor t (using Newton's method), and then inverting.\n" [^{:tag (* Float)} z ^{:tag (* Float)} x]
  ;; let
  ;;   f(t) = 1/t² - x
  ;; then
  ;;   g(t) = f(t)/f'(t) = -½t(1 - xt²)
  ;; and the next guess is given by
  ;;   t2 = t - g(t) = ½t(3 - xt²)
  (let [u (newFloat (.-prec z))
      ^{:line 97} v (newFloat (.-prec z))
      ^{:line 98} three (three)
      ^{:line 99} ng ^{:go/end 108} (fn ^{:tag (* Float)} [^{:tag (* Float)} t]
        (set! (.-prec u) (.-prec t))
        (set! (.-prec v) (.-prec t))
        (.Mul u t t) ; u = t²
        (.Mul u x u) ;   = xt²
        (.Sub v three u) ; v = 3 - xt²
        (.Mul u t v) ; u = t(3 - xt²)
        (dec! (.-exp u)) ;   = ½t(3 - xt²)
        (.Set t u))


      (values xf _) (.Float64 x)
      ^{:line 111} sqi (newFloat (.-prec z))]
    (.SetFloat64 sqi (/ 1 (math/Sqrt xf)))
    (for [prec (+ (.-prec z) 32)] (< (.-prec sqi) prec) _
      (set! (.-prec sqi) * 2)
      (set! sqi (ng sqi)))

    ;; sqi = 1/√x

    ;; x/√x = √x
    (.Mul z x sqi)))




^{:go/end 130} (go/func newFloat "newFloat returns a new *Float with space for twice the given\nprecision.\n" ^{:tag (* Float)} [^uint32 prec2]
  (let [z (new Float)]
    ;; nat.make ensures the slice length is > 0
    (set! (.-mant z) (.make (.-mant z) (* (conv int (/ prec2 _W)) 2)))
    ^{:line 129} z))

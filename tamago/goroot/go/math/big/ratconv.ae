          (conv string buf))))))


;; Note: FloatPrec (below) is in this file rather than rat.go because
;;       its results are relevant for decimal representation/printing.















^{:go/end 468} (go/method FloatPrec "FloatPrec returns the number n of non-repeating digits immediately\nfollowing the decimal point of the decimal representation of x.\nThe boolean result indicates whether a decimal representation of x\nwith that many fractional digits is exact or rounded.\n\nExamples:\n\n\tx      n    exact    decimal representation n fractional digits\n\t0      0    true     0\n\t1      0    true     1\n\t1/2    1    true     0.5\n\t1/3    0    false    0       (0.333... rounded)\n\t1/4    2    true     0.25\n\t1/6    1    false    0.2     (0.166... rounded)\n" [^{:tag (* Rat)} x] :results [^int n ^bool exact]
  (let [stk (getStack)]
    (defer (.free stk))

    ;; Determine q and largest p2, p5 such that d = q·2^p2·5^p5.
    ;; The results n, exact are:
    ;;
    ;;     n = max(p2, p5)
    ;;     exact = q == 1
    ;;
    ;; For details see:
    ;; https://en.wikipedia.org/wiki/Repeating_decimal#Reciprocals_of_integers_not_coprime_to_10
    (let [d (.-abs (.Denom x)) ; d >= 1

        ;; Determine p2 by counting factors of 2.
        ;; p2 corresponds to the trailing zero bits in d.
        ;; Do this first to reduce q as much as possible.
        ^{:line 422 :tag nat} q (zero nat)
        ^{:line 423} p2 (.trailingZeroBits d)]
      (set! q (.rsh q d p2))

      ;; Determine p5 by counting factors of 5.
      ;; Build a table starting with an initial power of 5,
      ;; and use repeated squaring until the factor doesn't
      ;; divide q anymore. Then use the table to determine
      ;; the power of 5 in q.

^{:go/end 19} (go/func ratTok ^bool [^rune ch]
  (strings/ContainsRune "+-/0123456789.eE" ch))


(go/var ^Rat ratZero)
(go/var ^fmt/Scanner _ (addr ratZero)) ; *Rat must implement fmt.Scanner



^{:go/end 38} (go/method Scan "Scan is a support routine for fmt.Scanner. It accepts the formats\n'e', 'E', 'f', 'F', 'g', 'G', and 'v'. All formats are equivalent.\n" ^error [^{:tag (* Rat)} z ^fmt/ScanState s ^rune ch]
  ^{:go/breaks [[5 37]]} (let [(values tok err) (.Token s true ratTok)]
    (when (!= err nil)
      (return err))

    (when (not (strings/ContainsRune "efgEFGv" ch))
      (return (errors/New "Rat.Scan: invalid verb")))

    (when [(values _ ok) (.SetString z (conv string tok))] (not ok)
      (return (errors/New "Rat.Scan: invalid syntax")))

    nil))




















^{:go/end 208} (go/method SetString "SetString sets z to the value of s and returns z and a boolean indicating\nsuccess. s can be given as a (possibly signed) fraction \"a/b\", or as a\nfloating-point number optionally followed by an exponent.\nIf a fraction is provided, both the dividend and the divisor may be a\ndecimal integer or independently use a prefix of “0b”, “0” or “0o”,\nor “0x” (or their upper-case variants) to denote a binary, octal, or\nhexadecimal integer, respectively. The divisor may not be signed.\nIf a floating-point number is provided, it may be in decimal form or\nuse any of the same prefixes as above but for “0” to denote a non-decimal\nmantissa. A leading “0” is considered a decimal leading 0; it does not\nindicate octal representation in this case.\nAn optional base-10 “e” or base-2 “p” (or their upper-case variants)\nexponent may be provided as well, except for hexadecimal floats which\nonly accept an (optional) “p” exponent (because an “e” or “E” cannot\nbe distinguished from a mantissa digit). If the exponent's absolute value\nis too large, the operation may fail.\nThe entire string, not just a prefix, must be valid for success. If the\noperation failed, the value of z is undefined but the returned value is nil.\n" [^{:tag (* Rat)} z ^string s] :results [(* Rat) bool]
  (when (== (len s) 0)
    (return nil false))

  ;; len(s) > 0

  ;; parse fraction a/b, if any
  (when [sep (strings/Index s "/")] (>= sep 0)
    (when [(values _ ok) (.SetString (.-a z) (subslice s _ sep) 0)] (not ok)
      (return nil false))

    (let [r (strings/NewReader (subslice s (+ sep 1)))
        ^{:line 70 :tag error} err (zero error)]
      (when [(set! (values (.-abs (.-b z)) _ _ err) (.scan (.-abs (.-b z)) r 0 false))] (!= err nil)
        (return nil false))

      ;; entire string must have been consumed
      (when [(set! (values _ err) (.ReadByte r))] (!= err io/EOF)
        (return nil false))

      (when (== (len (.-abs (.-b z))) 0)
        (return nil false))

      (return (.norm z) true)))


  ;; parse floating-point number
  (let [r (strings/NewReader s)

      ;; sign
      (values neg err) (scanSign r)]
    (when (!= err nil)
      (return nil false))


    ;; mantissa
    (let [^int base (zero int)
        ^{:line 95 :tag int} fcount (zero int)] ; fractional digit count; valid if <= 0
      (set! (values (.-abs (.-a z)) base fcount err) (.scan (.-abs (.-a z)) r 0 true))
      (when (!= err nil)
        (return nil false))


      ;; exponent
      (let [^int64 exp (zero int64)
          ^{:line 103 :tag int} ebase (zero int)]
        (set! (values exp ebase err) (scanExponent r true true))
        (when (!= err nil)
          (return nil false))


        ;; there should be no unread characters left
        (when [(set! (values _ err) (.ReadByte r))] (!= err io/EOF)
          (return nil false))


        ;; special-case 0 (see also issue #16176)
        (when (== (len (.-abs (.-a z))) 0)
          (return (.norm z) true))

        ;; len(z.a.abs) > 0

        ;; The mantissa may have a radix point (fcount <= 0) and there
        ;; may be a nonzero exponent exp. The radix point amounts to a
        ;; division by base**(-fcount), which equals a multiplication by
        ;; base**fcount. An exponent means multiplication by ebase**exp.
        ;; Multiplications are commutative, so we can apply them in any
        ;; order. We only have powers of 2 and 10, and we split powers
        ;; of 10 into the product of the same powers of 2 and 5. This
        ;; may reduce the size of shift/multiplication factors or
        ;; divisors required to create the final fraction, depending
        ;; on the actual floating-point value.

        ;; determine binary or decimal exponent contribution of radix point
        (let [(values ^int64 exp2 ^int64 exp5) (zero int64)]
          (when (< fcount 0)
            ;; The mantissa has a radix point ddd.dddd; and
            ;; -fcount is the number of digits to the right
            ;; of '.'. Adjust relevant exponent accordingly.
            (let [d (conv int64 fcount)]
              (switch base
                (case [10]
                  (set! exp5 d)
                  (fallthrough)) ; 10**e == 5**e * 2**e
                (case [2]
                  (set! exp2 d))
                (case [8]
                  (set! exp2 (* d 3))) ; octal digits are 3 bits each
                (case [16]
                  (set! exp2 (* d 4))) ; hexadecimal digits are 4 bits each
                (default
                  (panic "unexpected mantissa base")))))

          ;; fcount consumed - not needed anymore


          ;; take actual exponent into account
          (switch ebase
            (case [10]
              (set! exp5 + exp)
              (fallthrough)) ; see fallthrough above
            (case [2]
              (set! exp2 + exp))
            (default
              (panic "unexpected exponent base")))

          ;; exp consumed - not needed anymore

          (let [stk (getStack)]
            (defer (.free stk))

            ;; apply exp5 contributions
            ;; (start with exp5 so the numbers to multiply are smaller)
            (if (!= exp5 0)
              (let [n exp5]
                (when (< n 0)
                  (set! n (- n))
                  (when (< n 0)
                    ;; This can occur if -n overflows. -(-1 << 63) would become
                    ;; -1 << 63, which is still negative.
                    (return nil false)))


                (when (> n 1000000.0)
                  (return nil false)) ; avoid excessively large exponents

                (let [pow5 (.expNN (.-abs (.-b z)) stk natFive (.setWord (conv nat nil) (conv Word n)) nil false)] ; use underlying array of z.b.abs
                  (if (> exp5 0) (do
                      (set! (.-abs (.-a z)) (.mul (.-abs (.-a z)) stk (.-abs (.-a z)) pow5))
                      (set! (.-abs (.-b z)) (.setWord (.-abs (.-b z)) 1)))

                    (set! (.-abs (.-b z)) pow5))))


              (set! (.-abs (.-b z)) (.setWord (.-abs (.-b z)) 1)))


            ;; apply exp2 contributions
            (when (or (< exp2 -1.0E7) (> exp2 1.0E7))
              (return nil false)) ; avoid excessively large exponents

            (cond (> exp2 0)
              (set! (.-abs (.-a z)) (.lsh (.-abs (.-a z)) (.-abs (.-a z)) (conv uint exp2)))

          ^{:line 432 :tag (slice nat)} tab (zero (slice nat)) ; tab[i] == (5^fp)^(2^i) == 5^(fp·2^i)
          ^{:line 433} f (lit nat 1220703125) ; == 5^fp (must fit into a uint32 Word)
          (values ^nat t ^nat r) (zero nat)] ; temporaries
        (while true
          (when [(set! (values _ r) (.div t stk r q f))] (!= (len r) 0)
            (break)) ; f doesn't divide q evenly

          (set! tab (append tab f))
          (set! f (.sqr (conv nat nil) stk f))) ; nat(nil) to ensure a new f for each table entry


        ;; Factor q using the table entries, if any.
        ;; We start with the largest factor f = tab[len(tab)-1]
        ;; that evenly divides q. It does so at most once because
        ;; otherwise f·f would also divide q. That can't be true
        ;; because f·f is the next higher table entry, contradicting
        ;; how f was chosen in the first place.
        ;; The same reasoning applies to the subsequent factors.
        (let [^uint p5 (zero uint)]
          (for [i (- (len tab) 1)] (>= i 0) (dec! i)
            (when [(set! (values t r) (.div t stk r q (aget tab i)))] (== (len r) 0)
              (set! p5 + (* fp ^uint (<< 1 i))) ; tab[i] == 5^(fp·2^i)
              (set! q (.set q t))))



          ;; If fp != 1, we may still have multiples of 5 left.
          (while true
            (when [(set! (values t r) (.div t stk r q natFive))] (!= (len r) 0)
              (break))

            (inc! p5)
            (set! q (.set q t)))


          (return (conv int (max p2 p5)) (== (.cmp q natOne) 0)))))))

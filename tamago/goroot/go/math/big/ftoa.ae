^{:go/end 57} (go/method Text "Text converts the floating-point number x to a string according\nto the given format and precision prec. The format is one of:\n\n\t'e'\t-d.dddde±dd, decimal exponent, at least two (possibly 0) exponent digits\n\t'E'\t-d.ddddE±dd, decimal exponent, at least two (possibly 0) exponent digits\n\t'f'\t-ddddd.dddd, no exponent\n\t'g'\tlike 'e' for large exponents, like 'f' otherwise\n\t'G'\tlike 'E' for large exponents, like 'f' otherwise\n\t'x'\t-0xd.dddddp±dd, hexadecimal mantissa, decimal power of two exponent\n\t'p'\t-0x.dddp±dd, hexadecimal mantissa, decimal power of two exponent (non-standard)\n\t'b'\t-ddddddp±dd, decimal mantissa, decimal power of two exponent (non-standard)\n\nFor the power-of-two exponent formats, the mantissa is printed in normalized form:\n\n\t'x'\thexadecimal mantissa in [1, 2), or 0\n\t'p'\thexadecimal mantissa in [½, 1), or 0\n\t'b'\tdecimal integer mantissa using x.Prec() bits, or 0\n\nNote that the 'x' form is the one used by most other languages and libraries.\n\nIf format is a different character, Text returns a \"%\" followed by the\nunrecognized format character.\n\nThe precision prec controls the number of digits (excluding the exponent)\nprinted by the 'e', 'E', 'f', 'g', 'G', and 'x' formats.\nFor 'e', 'E', 'f', and 'x', it is the number of digits after the decimal point.\nFor 'g' and 'G' it is the total number of digits. A negative precision selects\nthe smallest number of decimal digits necessary to identify the value x uniquely\nusing x.Prec() mantissa bits.\nThe prec value is ignored for the 'b' and 'p' formats.\n\nNote that Text may return a different result than strconv.FormatFloat for\ncorresponding arguments if the matching float32 or float64 number provided\nto strconv.FormatFloat is a denormalized number.\n" ^string [^{:tag (* Float)} x ^byte format ^int prec]
  (let [cap 10] ; TODO(gri) determine a good/better value here
    (when (> prec 0)
      (set! cap + prec))

    (conv string (.Append x (make (slice byte) 0 cap) format prec))))




^{:go/end 63} (go/method String "String formats x like x.Text('g', 10).\n(String must be called explicitly, [Float.Format] does not support %s verb.)\n" ^string [^{:tag (* Float)} x]
  (.Text x \g 10))




^{:go/end 171} (go/method Append "Append appends to buf the string form of the floating-point number x,\nas generated by x.Text, and returns the extended buffer.\n" ^{:tag (slice byte)} [^{:tag (* Float)} x ^{:tag (slice byte)} buf ^byte fmt ^int prec]
  ;; sign
  (when (.-neg x)
    (set! buf (append buf \-)))


  ;; Inf
  (when (== (.-form x) inf)
    (when (not (.-neg x))
      (set! buf (append buf \+)))

    (return (append buf (spread "Inf"))))


  ;; pick off easy formats
  (switch fmt
    (case [\b]
      (return (.fmtB x buf)))
    (case [\p]
      (return (.fmtP x buf)))
    (case [\x]
      (return (.fmtX x buf prec))))


  ;; Algorithm:
  ;;   1) convert Float to multiprecision decimal
  ;;   2) round to desired precision
  ;;   3) read digits out and format

  ;; 1) convert Float to multiprecision decimal
  (let [^decimal d (zero decimal)] ; == 0.0
    (when (== (.-form x) finite)
      ;; x != 0
      (.init d (.-mant x) (- (conv int (.-exp x)) (.bitLen (.-mant x)))))


    ;; 2) round to desired precision
    (let [shortest false]
      (if (< prec 0) (do
          (set! shortest true)
          (roundShortest (addr d) x)
          ;; Precision for shortest representation mode.
          (switch fmt
            (case [\e \E]
              (set! prec (- (len (.-mant d)) 1)))
            (case [\f]
              (set! prec (max (- (len (.-mant d)) (.-exp d)) 0)))
            (case [\g \G]
              (set! prec (len (.-mant d))))))


        ;; round appropriately
        (switch fmt
          (case [\e \E]
            ;; one digit before and number of digits after decimal point
            (.round d (+ 1 prec)))
          (case [\f]
            ;; number of digits before and after decimal point
            (.round d (+ (.-exp d) prec)))
          (case [\g \G]
            (when (== prec 0)
              (set! prec 1))

            (.round d prec))))



      ;; 3) read digits out and format
      (switch fmt
        (case [\e \E]
          (return (fmtE buf fmt prec d)))
        (case [\f]
          (return (fmtF buf prec d)))
        (case [\g \G]
          ;; trim trailing fractional zeros in %e format
          (let [eprec prec]
            (when (and (> eprec (len (.-mant d))) (>= (len (.-mant d)) (.-exp d)))
              (set! eprec (len (.-mant d))))

            ;; %e is used if the exponent from the conversion
            ;; is less than -4 or greater than or equal to the precision.
            ;; If precision was the shortest possible, use eprec = 6 for
            ;; this decision.
            (when shortest
              (set! eprec 6))

            (let [exp (- (.-exp d) 1)]
              (when (or (< exp -4) (>= exp eprec))
                (when (> prec (len (.-mant d)))
                  (set! prec (len (.-mant d))))

                (return (fmtE buf (- (+ fmt \e) \g) (- prec 1) d)))

              (when (> prec (.-exp d))
                (set! prec (len (.-mant d))))

              (return (fmtF buf (max (- prec (.-exp d)) 0) d))))))


      ;; unknown format
      (when (.-neg x)
        (set! buf (subslice buf _ (- (len buf) 1)))) ; sign was added prematurely - remove it again

      (append buf \% fmt))))


^{:go/end 247} (go/func roundShortest [^{:tag (* decimal)} d ^{:tag (* Float)} x]
  ;; if the mantissa is zero, the number is zero - stop now
  (when (== (len (.-mant d)) 0)
    (return))


  ;; Approach: All numbers in the interval [x - 1/2ulp, x + 1/2ulp]
  ;; (possibly exclusive) round to x for the given precision of x.
  ;; Compute the lower and upper bound in decimal form and find the
  ;; shortest decimal number d such that lower <= d <= upper.

  ;; 1) Compute normalized mantissa mant and exponent exp for x such
  ;; that the lsb of mant corresponds to 1/2 ulp for the precision of
  ;; x (i.e., for mant we want x.prec + 1 bits).
  (let [mant (.set (conv nat nil) (.-mant x))
      ^{:line 188} exp (- (conv int (.-exp x)) (.bitLen mant))
      ^{:line 189} s (- (.bitLen mant) (conv int (+ (.-prec x) 1)))]
    (switch
      (case [(< s 0)]
        (set! mant (.lsh mant mant (conv uint (- s)))))
      (case [(> s 0)]
        (set! mant (.rsh mant mant (conv uint (+ s))))))

    (set! exp + s)
    ;; x = mant * 2**exp with lsb(mant) == 1/2 ulp of x.prec

    ;; 2) Compute lower bound by subtracting 1/2 ulp.
    (let [^decimal lower (zero decimal)
        ^{:line 201 :tag nat} tmp (zero nat)]
      (.init lower (.sub tmp mant natOne) exp)

      ;; 3) Compute upper bound by adding 1/2 ulp.
      (let [^decimal upper (zero decimal)]
        (.init upper (.add tmp mant natOne) exp)

        ;; The upper and lower bounds are possible outputs only if
        ;; the original mantissa is even, so that ToNearestEven rounding
        ;; would round to the original mantissa and not the neighbors.
        (let [inclusive (== (bit-and (aget mant 0) 2) 0)] ; test bit 1 since original mantissa was shifted by 1

          ;; Now we can figure out the minimum number of digits required.
          ;; Walk along until d has distinguished itself from upper and lower.
          (range [i m (.-mant d)]
            (let [l (.at lower i)
                ^{:line 217} u (.at upper i)

                ;; Okay to round down (truncate) if lower has a different digit
                ;; or if lower is inclusive and is exactly the result of rounding
                ;; down (i.e., and we have reached the final digit of lower).
                ^{:line 222} okdown (or (!= l m) (and inclusive (== (+ i 1) (len (.-mant lower)))))

                ;; Okay to round up if upper has a different digit and either upper
                ;; is inclusive or upper is bigger than the result of rounding up.
                ;; The last clause handles digits past upper's trimmed mantissa:
                ;; upper.at(i) returns '0' there, but the true upper bound was
                ;; determined by earlier digits, so rounding up is valid unless
                ;; m == '9' (which would carry onto the exclusive upper bound).
                ;; See also go.dev/issue/80206.
                ^{:line 231} okup (and (!= m u) ^:go/paren (or inclusive (< (+ m 1) u) (< (+ i 1) (len (.-mant upper))) (and (>= i (len (.-mant upper))) (< m \9))))]

              ;; If it's okay to do either, then round to the nearest one.
              ;; If it's okay to do only one, do it.
              (switch
                (case [(and okdown okup)]
                  (.round d (+ i 1))
                  (return))
                (case [okdown]
                  (.roundDown d (+ i 1))
                  (return))
                (case [okup]
                  (.roundUp d (+ i 1))
                  (return))))))))))





^{:go/end 291} (go/func fmtE "%e: d.ddddde±dd\n" ^{:tag (slice byte)} [^{:tag (slice byte)} buf ^byte fmt ^int prec ^decimal d]
  ;; first digit
  (let [ch (conv byte \0)]
    (when (> (len (.-mant d)) 0)
      (set! ch (aget (.-mant d) 0)))

    (set! buf (append buf ch))

    ;; .moredigits
    (when (> prec 0)
      (set! buf (append buf \.))
      (let [i 1
          ^{:line 262} m (min (len (.-mant d)) (+ prec 1))]
        (when (< i m)
          (set! buf (append buf (spread (subslice (.-mant d) i m))))
          (set! i m))

        (for [] (<= i prec) (inc! i)
          (set! buf (append buf \0)))))



    ;; e±
    (set! buf (append buf fmt))
    (let [^int64 exp (zero int64)]
      (when (> (len (.-mant d)) 0)
        (set! exp (- (conv int64 (.-exp d)) 1))) ; -1 because first digit was printed before '.'

      (if (< exp 0) (do
          (set! ch \-)
          (set! exp (- exp)))

        (set! ch \+))

      (set! buf (append buf ch))

      ;; dd...d
      (when (< exp 10)
        (set! buf (append buf \0))) ; at least 2 exponent digits

      (strconv/AppendInt buf exp 10))))



^{:go/end 315} (go/func fmtF "%f: ddddddd.ddddd\n" ^{:tag (slice byte)} [^{:tag (slice byte)} buf ^int prec ^decimal d]
  ;; integer, padded with zeros as needed
  (if (> (.-exp d) 0)
    (let [m (min (len (.-mant d)) (.-exp d))]
      (set! buf (append buf (spread (subslice (.-mant d) _ m))))
      (for [] (< m (.-exp d)) (inc! m)
        (set! buf (append buf \0))))


    (set! buf (append buf \0)))


  ;; fraction
  (when (> prec 0)
    (set! buf (append buf \.))
    (for [i 0] (< i prec) (inc! i)
      (set! buf (append buf (.at d (+ (.-exp d) i))))))



  ^{:line 314} buf)









^{:go/end 350} (go/method fmtB "fmtB appends the string of x in the format mantissa \"p\" exponent\nwith a decimal mantissa and a binary exponent, or \"0\" if x is zero,\nand returns the extended buffer.\nThe mantissa is normalized such that is uses x.Prec() bits in binary\nrepresentation.\nThe sign of x is ignored, and x must not be an Inf.\n(The caller handles Inf before invoking fmtB.)\n" ^{:tag (slice byte)} [^{:tag (* Float)} x ^{:tag (slice byte)} buf]
  (when (== (.-form x) zero)
    (return (append buf \0)))


  (when (and debugFloat (!= (.-form x) finite))
    (panic "non-finite float"))

  ;; x != 0

  ;; adjust mantissa to use exactly x.prec bits
  (let [m (.-mant x)]
    (switch [w (* (conv uint32 (len (.-mant x))) _W)]
      (case [(< w (.-prec x))]
        (set! m (.lsh (conv nat nil) m (conv uint (- (.-prec x) w)))))
      (case [(> w (.-prec x))]
        (set! m (.rsh (conv nat nil) m (conv uint (- w (.-prec x)))))))


    (set! buf (append buf (spread (.utoa m 10))))
    (set! buf (append buf \p))
    (let [e (- (conv int64 (.-exp x)) (conv int64 (.-prec x)))]
      (when (>= e 0)
        (set! buf (append buf \+)))

      (strconv/AppendInt buf e 10))))








^{:go/end 417} (go/method fmtX "fmtX appends the string of x in the format \"0x1.\" mantissa \"p\" exponent\nwith a hexadecimal mantissa and a binary exponent, or \"0x0p0\" if x is zero,\nand returns the extended buffer.\nA non-zero mantissa is normalized such that 1.0 <= mantissa < 2.0.\nThe sign of x is ignored, and x must not be an Inf.\n(The caller handles Inf before invoking fmtX.)\n" ^{:tag (slice byte)} [^{:tag (* Float)} x ^{:tag (slice byte)} buf ^int prec]
  (when (== (.-form x) zero)
    (set! buf (append buf (spread "0x0")))
    (when (> prec 0)
      (set! buf (append buf \.))
      (for [i 0] (< i prec) (inc! i)
        (set! buf (append buf \0))))


    (set! buf (append buf (spread "p+00")))
    (return buf))


  (when (and debugFloat (!= (.-form x) finite))
    (panic "non-finite float"))


  ;; round mantissa to n bits
  (let [^uint n (zero uint)]
    (if (< prec 0)
      (set! n (+ 1 (* (/ (+ (- (.MinPrec x) 1) 3) 4) 4))) ; round MinPrec up to 1 mod 4

      (set! n (+ 1 (* 4 (conv uint prec)))))

    ;; n%4 == 1
    (set! x (.Set (.SetMode (.SetPrec (new Float) n) (.-mode x)) x))

    ;; adjust mantissa to use exactly n bits
    (let [m (.-mant x)]
      (switch [w (* (conv uint (len (.-mant x))) _W)]
        (case [(< w n)]
          (set! m (.lsh (conv nat nil) m (- n w))))
        (case [(> w n)]
          (set! m (.rsh (conv nat nil) m (- w n)))))

      (let [exp64 (- (conv int64 (.-exp x)) 1) ; avoid wrap-around

          ^{:line 395} hm (.utoa m 16)]
        (when (and debugFloat (!= (aget hm 0) \1))
          (panic (+ "incorrect mantissa: " (conv string hm))))

        (set! buf (append buf (spread "0x1")))
        (when (> (len hm) 1)
          (set! buf (append buf \.))
          (set! buf (append buf (spread (subslice hm 1)))))


        (set! buf (append buf \p))
        (if (>= exp64 0)
          (set! buf (append buf \+))
          (do
            (set! exp64 (- exp64))
            (set! buf (append buf \-))))

        ;; Force at least two exponent digits, to match fmt.
        (when (< exp64 10)
          (set! buf (append buf \0)))

        (strconv/AppendInt buf exp64 10)))))








^{:go/end 451} (go/method fmtP "fmtP appends the string of x in the format \"0x.\" mantissa \"p\" exponent\nwith a hexadecimal mantissa and a binary exponent, or \"0\" if x is zero,\nand returns the extended buffer.\nThe mantissa is normalized such that 0.5 <= 0.mantissa < 1.0.\nThe sign of x is ignored, and x must not be an Inf.\n(The caller handles Inf before invoking fmtP.)\n" ^{:tag (slice byte)} [^{:tag (* Float)} x ^{:tag (slice byte)} buf]
  (when (== (.-form x) zero)
    (return (append buf \0)))


  (when (and debugFloat (!= (.-form x) finite))
    (panic "non-finite float"))

  ;; x != 0

  ;; remove trailing 0 words early
  ;; (no need to convert to hex 0's and trim later)
  (let [m (.-mant x)
      ^{:line 438} i 0]
    (while (and (< i (len m)) (== (aget m i) 0))
      (inc! i))

    (set! m (subslice m i))

    (set! buf (append buf (spread "0x.")))
    (set! buf (append buf (spread (bytes/TrimRight (.utoa m 16) "0"))))
    (set! buf (append buf \p))
    (when (>= (.-exp x) 0)
      (set! buf (append buf \+)))

    (strconv/AppendInt buf (conv int64 (.-exp x)) 10)))


(go/var ^fmt/Formatter _ (addr floatZero)) ; *Float must implement fmt.Formatter










^{:go/end 535} (go/method Format "Format implements [fmt.Formatter]. It accepts all the regular\nformats for floating-point numbers ('b', 'e', 'E', 'f', 'F',\n'g', 'G', 'x') as well as 'p' and 'v'. See (*Float).Text for the\ninterpretation of 'p'. The 'v' format is handled like 'g'.\nFormat also supports specification of the minimum precision\nin digits, the output field width, as well as the format flags\n'+' and ' ' for sign control, '0' for space or zero padding,\nand '-' for left or right justification. See the fmt package\nfor details.\n" [^{:tag (* Float)} x ^fmt/State s ^rune format]
  (let [(values prec hasPrec) (.Precision s)]
    (when (not hasPrec)
      (set! prec 6)) ; default precision for 'e', 'f'


    (switch format
      (case [\e \E \f \b \p \x])
      ;; nothing to do
      (case [\F]
        ;; (*Float).Text doesn't support 'F'; handle like 'f'
        (set! format \f))
      (case [\v]
        ;; handle like 'g'
        (set! format \g)
        (fallthrough))
      (case [\g \G]
        (when (not hasPrec)
          (set! prec -1))) ; default precision for 'g', 'G'

      (default
        (fmt/Fprintf s "%%!%c(*big.Float=%s)" format (.String x))
        (return)))

    (let [^{:tag (slice byte)} buf (zero (slice byte))]
      (set! buf (.Append x buf (conv byte format) prec))
      (when (== (len buf) 0)
        (set! buf (conv (slice byte) "?"))) ; should never happen, but don't crash

      ;; len(buf) > 0

      (let [^string sign (zero string)]
        (switch
          (case [(== (aget buf 0) \-)]
            (set! sign "-")
            (set! buf (subslice buf 1)))
          (case [(== (aget buf 0) \+)]
            ;; +Inf
            (set! sign "+")
            (when (.Flag s \space)
              (set! sign " "))

            (set! buf (subslice buf 1)))
          (case [(.Flag s \+)]
            (set! sign "+"))
          (case [(.Flag s \space)]
            (set! sign " ")))


        (let [^int padding (zero int)]
          (when [(values width hasWidth) (.Width s)] (and hasWidth (> width (+ (len sign) (len buf))))
            (set! padding (- width (len sign) (len buf))))


          (switch
            (case [(and (.Flag s \0) (not (.IsInf x)))]
              ;; 0-padding on left
              (writeMultiple s sign 1)
              (writeMultiple s "0" padding)
              (.Write s buf))
            (case [(.Flag s \-)]
              ;; padding on right
              (writeMultiple s sign 1)
              (.Write s buf)
              (writeMultiple s " " padding))
            (default
              ;; padding on left
              (writeMultiple s " " padding)
              (writeMultiple s sign 1)
              (.Write s buf))))))))

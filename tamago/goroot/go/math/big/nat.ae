    (.norm z)))




^{:go/end 1131} (go/method sqrt "sqrt sets z = ⌊√x⌋\nThe caller may pass stk == nil to request that sqrt obtain and release one itself.\n" ^nat [^nat z ^{:tag (* stack)} stk ^nat x]

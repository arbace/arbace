    (set! i 0))

  (while (and (< i (len buf)) (== (aget buf i) 0))
    (inc! i))


  (return))



^{:go/end 1069} (go/func bigEndianWord "bigEndianWord returns the contents of buf interpreted as a big-endian encoded Word value.\n" ^Word [^{:tag (slice byte)} buf]

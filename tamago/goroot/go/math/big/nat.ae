    (return (conv Word (byteorder/BEUint64 buf))))

  (conv Word (byteorder/BEUint32 buf)))




^{:go/end 1091} (go/method setBytes "setBytes interprets buf as the bytes of a big-endian unsigned\ninteger, sets z to that value, and returns z.\n" ^nat [^nat z ^{:tag (slice byte)} buf]

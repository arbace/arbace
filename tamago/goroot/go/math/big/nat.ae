                (set! zz (.sqr zz stk z))
                (set! (values zz z) (values z zz))
                (set! z (.trunc z z logM))

                (set! zz (.sqr zz stk z))
                (set! (values zz z) (values z zz))
                (set! z (.trunc z z logM))

                (set! zz (.sqr zz stk z))
                (set! (values zz z) (values z zz))
                (set! z (.trunc z z logM)))


              (set! zz (.mul zz stk z (aget powers (>> yi (- _W n)))))
              (set! (values zz z) (values z zz))
              (set! z (.trunc z z logM))

              (set! yi << n)
              (set! advance true))))



        (.norm z)))))




^{:go/end 1030} (go/method expNNMontgomery "expNNMontgomery calculates x**y mod m using a fixed, 4-bit window.\nUses Montgomery representation.\n" ^nat [^nat z ^{:tag (* stack)} stk ^nat x ^nat y ^nat m]
  (let [numWords (len m)]

    ;; We want the lengths of x and m to be equal.
    ;; It is OK if x >= m as long as len(x) == len(m).
    (when (> (len x) numWords)
      (set! (values _ x) (.div (conv nat nil) stk nil x m)))

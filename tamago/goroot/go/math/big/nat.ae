^{:go/end 937} (go/method expNNWindowed "expNNWindowed calculates x**y mod m using a fixed, 4-bit window,\nwhere m = 2**logM.\n" ^nat [^nat z ^{:tag (* stack)} stk ^nat x ^nat y ^uint logM]

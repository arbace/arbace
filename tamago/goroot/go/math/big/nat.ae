          (copy zz RR)
          (set! RR zz))

        ;; one = 1, with equal length to that of m
        (let [one (make nat numWords)]
          (aset one 0 1)

          (let [^:const ^{:val 4} n 4
              ;; powers[i] contains x^i
              ^{:line 982 :tag (array (<< 1 n) nat)} powers (zero (array (<< 1 n) nat))]

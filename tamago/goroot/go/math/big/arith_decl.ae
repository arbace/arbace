^{:go/end 54} (go/func ^{:go/linkname "shlVU"} shlVU "shlVU should be an internal detail (and a stale one at that),\nbut widely used packages access it using linkname.\nNotable members of the hall of shame include:\n  - github.com/remyoudompheng/bigfft\n\nDo not remove or change the type signature.\nSee go.dev/issue/67401.\n" [^{:tag (slice Word)} z ^{:tag (slice Word)} x ^uint s] :results [^Word c]
  (when (== s 0)
    (copy z x)
    (return 0))

  (lshVU z x s))





(go/func ^:extern ^:go/noescape lshVU "lshVU sets z = x<<s, returning the high bits c. 1 ≤ s ≤ _B-1.\n" [^{:tag (slice Word)} z ^{:tag (slice Word)} x ^uint s] :results [^Word c])





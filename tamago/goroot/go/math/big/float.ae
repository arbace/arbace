  ^{:line 140} [^{:val 2} ToZero] ; == IEEE 754-2008 roundTowardZero
  ^{:line 141} [^{:val 3} AwayFromZero] ; no IEEE 754-2008 equivalent
  ^{:line 142} [^{:val 4} ToNegativeInf] ; == IEEE 754-2008 roundTowardNegative
  ^{:line 143} [^{:val 5} ToPositiveInf]) ; == IEEE 754-2008 roundTowardPositive



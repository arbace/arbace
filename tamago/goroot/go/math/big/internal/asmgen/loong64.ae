(in-ns 'go.math.big.internal.asmgen) (go/file "loong64.go" :imports [])

(go/var ArchLoong64 (addr ^{:go/breaks [2 4 6 8 [10 13] [12 26] 14 16 18 [20 31] 22 24 26 28 30 32 34 36 38 40 [42 43] [44 45] 46]} (lit Arch
      :Name "loong64"
      :WordBits 64
      :WordBytes 8
      :CarrySafeLoop true

      :regs ^{:go/breaks [[2 21] 8 18 25]} (lit (slice string)
        ;; R0 is set to 0.
        ;; R1 is LR.
        ;; R2 is ???
        ;; R3 is SP.
        ;; R22 is g.
        ;; R28 and R29 are our virtual carry flags.
        ;; R30 is the linker/assembler temp, which we use too.
        "R4" "R5" "R6" "R7" "R8" "R9"
        "R10" "R11" "R12" "R13" "R14" "R15" "R16" "R17" "R18" "R19"
        "R20" "R21" "R23" "R24" "R25" "R26" "R27"
        "R31")

      :reg0 "R0"
      :regCarry "R28"
      :regAltCarry "R29"
      :regTmp "R30"

      :mov "MOVV"
      :add "ADDVU"
      :sub "SUBVU"
      :sltu "SGTU"
      :mul "MULV"
      :mulhi "MULHVU"
      :lsh "SLLV"
      :rsh "SRLV"
      :and "AND"
      :or "OR"
      :xor "XOR"

      :addWords "ALSLV $3, %[1]s, %[2]s, %[3]s"

      :jmpZero "BEQ %s, %s"
      :jmpNonZero "BNE %s, %s")))

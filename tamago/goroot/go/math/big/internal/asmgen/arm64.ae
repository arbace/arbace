(in-ns 'go.math.big.internal.asmgen) (go/file "arm64.go" :imports [])

(go/var ArchARM64 (addr ^{:go/breaks [2 4 6 8 [10 13] [12 23] [14 25] 16 18 20 22 24 26 28 30 32 34 36 38 40 42 44 [46 42] [48 44] 50 [52 47] 54 56 58]} (lit Arch
      :Name "arm64"
      :WordBits 64
      :WordBytes 8
      :CarrySafeLoop true

      :regs ^{:go/breaks [[2 19] 12 21]} (lit (slice string)
        ;; R18 is the platform register.
        ;; R27 is the assembler/linker temporary (which we could potentially use but don't).
        ;; R28 is g.
        ;; R29 is FP.
        ;; R30 is LR.
        "R0" "R1" "R2" "R3" "R4" "R5" "R6" "R7" "R8" "R9"
        "R10" "R11" "R12" "R13" "R14" "R15" "R16" "R17" "R19"
        "R20" "R21" "R22" "R23" "R24" "R25" "R26")

      :reg0 "ZR"

      :mov "MOVD"
      :add "ADD"
      :adds "ADDS"
      :adc "ADC"
      :adcs "ADCS"
      :sub "SUB"
      :subs "SUBS"
      :sbc "SBC"
      :sbcs "SBCS"
      :mul "MUL"
      :mulhi "UMULH"
      :lsh "LSL"
      :rsh "LSR"
      :and "AND"
      :or "ORR"
      :xor "EOR"

      :addWords "ADD %[1]s<<3, %[2]s, %[3]s"

      :jmpZero "CBZ %s, %s"
      :jmpNonZero "CBNZ %s, %s"

      :loadIncN arm64LoadIncN
      :loadDecN arm64LoadDecN
      :storeIncN arm64StoreIncN
      :storeDecN arm64StoreDecN)))


^{:go/end 66} (go/func arm64LoadIncN [^{:tag (* Asm)} a ^RegPtr p ^{:tag (slice Reg)} regs]
  (when (== (len regs) 1)
    (.Printf a "\tMOVD.P %d(%s), %s\n" (.-WordBytes (.-Arch a)) p (aget regs 0))
    (return))

  (.Printf a "\tLDP.P %d(%s), (%s, %s)\n" (* (len regs) (.-WordBytes (.-Arch a))) p (aget regs 0) (aget regs 1))
  (let [^int i (zero int)]
    (for [(set! i 2)] (<= (+ i 2) (len regs)) (set! i + 2)
      (.Printf a "\tLDP %d(%s), (%s, %s)\n" (* (- i (len regs)) (.-WordBytes (.-Arch a))) p (aget regs i) (aget regs (+ i 1))))

    (when (< i (len regs))
      (.Printf a "\tMOVD %d(%s), %s\n" (* -1 (.-WordBytes (.-Arch a))) p (aget regs i)))))



^{:go/end 81} (go/func arm64LoadDecN [^{:tag (* Asm)} a ^RegPtr p ^{:tag (slice Reg)} regs]
  (when (== (len regs) 1)
    (.Printf a "\tMOVD.W -%d(%s), %s\n" (.-WordBytes (.-Arch a)) p (aget regs 0))
    (return))

  (.Printf a "\tLDP.W %d(%s), (%s, %s)\n" (* (- (len regs)) (.-WordBytes (.-Arch a))) p (aget regs (- (len regs) 1)) (aget regs (- (len regs) 2)))
  (let [^int i (zero int)]
    (for [(set! i 2)] (<= (+ i 2) (len regs)) (set! i + 2)
      (.Printf a "\tLDP %d(%s), (%s, %s)\n" (* i (.-WordBytes (.-Arch a))) p (aget regs (- (len regs) 1 i)) (aget regs (- (len regs) 2 i))))

    (when (< i (len regs))
      (.Printf a "\tMOVD %d(%s), %s\n" (* i (.-WordBytes (.-Arch a))) p (aget regs 0)))))



^{:go/end 96} (go/func arm64StoreIncN [^{:tag (* Asm)} a ^RegPtr p ^{:tag (slice Reg)} regs]
  (when (== (len regs) 1)
    (.Printf a "\tMOVD.P %s, %d(%s)\n" (aget regs 0) (.-WordBytes (.-Arch a)) p)
    (return))

  (.Printf a "\tSTP.P (%s, %s), %d(%s)\n" (aget regs 0) (aget regs 1) (* (len regs) (.-WordBytes (.-Arch a))) p)
  (let [^int i (zero int)]
    (for [(set! i 2)] (<= (+ i 2) (len regs)) (set! i + 2)
      (.Printf a "\tSTP (%s, %s), %d(%s)\n" (aget regs i) (aget regs (+ i 1)) (* (- i (len regs)) (.-WordBytes (.-Arch a))) p))

    (when (< i (len regs))
      (.Printf a "\tMOVD %s, %d(%s)\n" (aget regs i) (* -1 (.-WordBytes (.-Arch a))) p))))



^{:go/end 111} (go/func arm64StoreDecN [^{:tag (* Asm)} a ^RegPtr p ^{:tag (slice Reg)} regs]
  (when (== (len regs) 1)
    (.Printf a "\tMOVD.W %s, -%d(%s)\n" (aget regs 0) (.-WordBytes (.-Arch a)) p)
    (return))

  (.Printf a "\tSTP.W (%s, %s), %d(%s)\n" (aget regs (- (len regs) 1)) (aget regs (- (len regs) 2)) (* (- (len regs)) (.-WordBytes (.-Arch a))) p)
  (let [^int i (zero int)]
    (for [(set! i 2)] (<= (+ i 2) (len regs)) (set! i + 2)
      (.Printf a "\tSTP (%s, %s), %d(%s)\n" (aget regs (- (len regs) 1 i)) (aget regs (- (len regs) 2 i)) (* i (.-WordBytes (.-Arch a))) p))

    (when (< i (len regs))
      (.Printf a "\tMOVD %s, %d(%s)\n" (aget regs 0) (* i (.-WordBytes (.-Arch a))) p))))

(in-ns 'go.math.big.internal.asmgen) (go/file "arm.go" :imports [])

(go/var ArchARM (addr ^{:go/breaks [2 4 6 8 [10 13] [12 21] [14 23] 16 18 20 22 24 26 28 30 32 34 36 38 [40 37] [42 39] [44 41] 46 [48 44] 50 52 54]} (lit Arch
      :Name "arm"
      :WordBits 32
      :WordBytes 4
      :CarrySafeLoop true

      :regs ^{:go/breaks [[2 19]]} (lit (slice string)
        ;; R10 is g.
        ;; R11 is the assembler/linker temporary (but we use it as a regular register).
        ;; R13 is SP.
        ;; R14 is LR.
        ;; R15 is PC.
        "R0" "R1" "R2" "R3" "R4" "R5" "R6" "R7" "R8" "R9" "R11" "R12")

      :regShift true

      :mov "MOVW"
      :add "ADD"
      :adds "ADD.S"
      :adc "ADC"
      :adcs "ADC.S"
      :sub "SUB"
      :subs "SUB.S"
      :sbc "SBC"
      :sbcs "SBC.S"
      :rsb "RSB"
      :and "AND"
      :or "ORR"
      :xor "EOR"

      :mulWideF armMulWide

      :addWords "ADD %s<<2, %s, %s"

      :jmpZero "TEQ $0, %s; BEQ %s"
      :jmpNonZero "TEQ $0, %s; BNE %s"

      :loadIncN armLoadIncN
      :loadDecN armLoadDecN
      :storeIncN armStoreIncN
      :storeDecN armStoreDecN)))


^{:go/end 52} (go/func armMulWide [^{:tag (* Asm)} a ^Reg src1 ^Reg src2 ^Reg dstlo ^Reg dsthi]
  (.Printf a "\tMULLU %s, %s, (%s, %s)\n" src1 src2 dsthi dstlo))


^{:go/end 58} (go/func armLoadIncN [^{:tag (* Asm)} a ^RegPtr p ^{:tag (slice Reg)} regs]
  (range [_ r regs]
    (.Printf a "\tMOVW.P %d(%s), %s\n" (.-WordBytes (.-Arch a)) p r)))



^{:go/end 64} (go/func armLoadDecN [^{:tag (* Asm)} a ^RegPtr p ^{:tag (slice Reg)} regs]
  (range [_ r regs]
    (.Printf a "\tMOVW.W %d(%s), %s\n" (- (.-WordBytes (.-Arch a))) p r)))



^{:go/end 70} (go/func armStoreIncN [^{:tag (* Asm)} a ^RegPtr p ^{:tag (slice Reg)} regs]
  (range [_ r regs]
    (.Printf a "\tMOVW.P %s, %d(%s)\n" r (.-WordBytes (.-Arch a)) p)))



^{:go/end 76} (go/func armStoreDecN [^{:tag (* Asm)} a ^RegPtr p ^{:tag (slice Reg)} regs]
  (range [_ r regs]
    (.Printf a "\tMOVW.W %s, %d(%s)\n" r (- (.-WordBytes (.-Arch a))) p)))

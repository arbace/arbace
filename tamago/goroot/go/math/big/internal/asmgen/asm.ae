^{:go/end 290} (go/method AddWords "AddWords emits dst = src1*WordBytes + src2.\nIt does not set or use the carry flag.\n" [^{:tag (* Asm)} a ^Reg src1 ^RegPtr src2 ^RegPtr dst]

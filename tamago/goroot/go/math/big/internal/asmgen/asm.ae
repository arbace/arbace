^{:go/end 550} (go/method Add "Add emits dst = src1+src2, with the specified carry behavior.\n" [^{:tag (* Asm)} a ^Reg src1 ^Reg src2 ^Reg dst ^Carry carry]
  (switch
    (default
      (.Fatalf a "unsupported carry behavior"))
    (case [(and (!= (.-addF (.-Arch a)) nil) ((.-addF (.-Arch a)) a src1 src2 dst carry))])
    ;; handled
    (case [(and (!= (.-add (.-Arch a)) "") ^:go/paren (or (== carry KeepCarry) (== carry SmashCarry)))]
      (.op3 a (.-add (.-Arch a)) src1 src2 dst))
    (case [(and (!= (.-adds (.-Arch a)) "") ^:go/paren (or (== carry SetCarry) (== carry SmashCarry)))]
      (.op3 a (.-adds (.-Arch a)) src1 src2 dst))
    (case [(and (!= (.-adc (.-Arch a)) "") ^:go/paren (or (== carry UseCarry) (== carry (bit-or UseCarry SmashCarry))))]
      (.op3 a (.-adc (.-Arch a)) src1 src2 dst))
    (case [(and (!= (.-adcs (.-Arch a)) "") ^:go/paren (or (== carry (bit-or UseCarry SetCarry)) (== carry (bit-or UseCarry SmashCarry))))]
      (.op3 a (.-adcs (.-Arch a)) src1 src2 dst))
    (case [(and (!= (.-lea (.-Arch a)) "") ^:go/paren (or (== carry KeepCarry) (== carry SmashCarry)))]
      (if (.IsImm src1)
        (.Printf a "\t%s %s(%s), %s\n" (.-lea (.-Arch a)) (subslice (.-name src1) 1) src2 dst) ; name[1:] removes $

        (.Printf a "\t%s (%s)(%s), %s\n" (.-lea (.-Arch a)) src1 src2 dst))

      (if (== src2 dst)
        (.EOL a "ADD %s, %s" src1 dst)

        (.EOL a "ADD %s, %s, %s" src1 src2 dst)))


    (case [(and (!= (.-add (.-Arch a)) "") (!= (.-regCarry (.-Arch a)) ""))]
      ;; Machine has no carry flag; instead we've dedicated a register
      ;; and use SLTU/SGTU (set less-than/greater-than unsigned)
      ;; to compute the carry flags as needed.
      ;; For ADD x, y, z, SLTU x/y, z, c computes the carry (borrow) bit.
      ;; Either of x or y can be used as the second argument, provided
      ;; it is not aliased to z.
      ;; To make the output less of a wall of instructions,
      ;; we comment the “higher-level” operation, with ... marking
      ;; continued instructions implementing the operation.
      (let [cr (.Carry a)]
        (when (!= (bit-and carry AltCarry) 0)
          (set! cr (.AltCarry a))
          (when (not (.Valid cr))
            (.Fatalf a "alt carry not supported"))

          (set! carry bit-and-not AltCarry))

        (let [tmp (.tmp a)]
          (when (not (.Valid tmp))
            (.Fatalf a "cannot simulate sub carry without regTmp"))

          (switch carry
            (default
              (.Fatalf a "unsupported carry behavior"))
            (case [UseCarry (bit-or UseCarry SmashCarry)]
              ;; Easy case, just add the carry afterward.
              (when (.IsZero a src1)
                ;; Only here to use the carry.
                (.Add a cr src2 dst KeepCarry)
                (.EOL a "ADC $0, %s, %s" src2 dst)
                (break))

              (.Add a src1 src2 dst KeepCarry)
              (.EOL a "ADC %s, %s, %s (cr=%s)" src1 src2 dst cr)
              (.Add a cr dst dst KeepCarry)
              (.EOL a "..."))

            (case [SetCarry]
              (when (and (.IsZero a src1) (== src2 dst))
                ;; Only here to clear the carry flag. (Caller will comment.)
                (.Xor a cr cr cr)
                (break))

              (let [^Reg old (zero Reg)] ; old is a src distinct from dst
                (switch
                  (case [(!= dst src1)]
                    (set! old src1))
                  (case [(!= dst src2)]
                    (set! old src2))
                  (default
                    ;; src1 == src2 == dst.
                    ;; Overflows if and only if the high bit is set, so copy high bit to carry.
                    (.Rsh a (.Imm a (- (.-WordBits (.-Arch a)) 1)) src1 cr)
                    (.EOL a "ADDS %s, %s, %s (cr=%s)" src1 src2 dst cr)
                    (.Add a src1 src2 dst KeepCarry)
                    (.EOL a "...")
                    (return)))

                (.Add a src1 src2 dst KeepCarry)
                (.EOL a "ADDS %s, %s, %s (cr=%s)" src1 src2 dst cr)
                (.SLTU a old dst cr) ; dst < old (one of the src) implies carry
                (.EOL a "...")))

            (case [(bit-or UseCarry SetCarry)]
              (when (.IsZero a src1)
                ;; Only here to use and then set the carry.
                ;; Easy since carry is not aliased to dst.
                (.Add a cr src2 dst KeepCarry)
                (.EOL a "ADCS $0, %s, %s (cr=%s)" src2 dst cr)
                (.SLTU a cr dst cr) ; dst < cr implies carry
                (.EOL a "...")
                (break))

              ;; General case. Need to do two different adds (src1 + src2 + cr),
              ;; computing carry bits for both, and add'ing them together.
              ;; Start with src1+src2.
              (let [^Reg old (zero Reg)] ; old is a src distinct from dst
                (switch
                  (case [(!= dst src1)]
                    (set! old src1))
                  (case [(!= dst src2)]
                    (set! old src2)))

                (if (.Valid old) (do
                    (.Add a src1 src2 dst KeepCarry)
                    (.EOL a "ADCS %s, %s, %s (cr=%s)" src1 src2 dst cr)
                    (.SLTU a old dst tmp) ; // dst < old (one of the src) implies carry
                    (.EOL a "..."))
                  (do
                    ;; src1 == src2 == dst, like above. Sign bit is carry bit,
                    ;; but we copy it into tmp, not cr.
                    (.Rsh a (.Imm a (- (.-WordBits (.-Arch a)) 1)) src1 tmp)
                    (.EOL a "ADCS %s, %s, %s (cr=%s)" src1 src2 dst cr)
                    (.Add a src1 src2 dst KeepCarry)
                    (.EOL a "...")))

                ;; Add cr to dst.
                (.Add a cr dst dst KeepCarry)
                (.EOL a "...")
                (.SLTU a cr dst cr) ; sum < cr implies carry
                (.EOL a "...")
                ;; Add the two carry bits (at most one can be set, because (2⁶⁴-1)+(2⁶⁴-1)+1 < 2·2⁶⁴).
                (.Add a tmp cr cr KeepCarry)
                (.EOL a "...")))))))))





^{:go/end 661} (go/method Sub "Sub emits dst = src2-src1, with the specified carry behavior.\n" [^{:tag (* Asm)} a ^Reg src1 ^Reg src2 ^Reg dst ^Carry carry]
  (switch
    (default
      (.Fatalf a "unsupported carry behavior"))
    (case [(and (!= (.-subF (.-Arch a)) nil) ((.-subF (.-Arch a)) a src1 src2 dst carry))])
    ;; handled
    (case [(and (!= (.-sub (.-Arch a)) "") ^:go/paren (or (== carry KeepCarry) (== carry SmashCarry)))]
      (.op3 a (.-sub (.-Arch a)) src1 src2 dst))
    (case [(and (!= (.-subs (.-Arch a)) "") ^:go/paren (or (== carry SetCarry) (== carry SmashCarry)))]
      (.op3 a (.-subs (.-Arch a)) src1 src2 dst))
    (case [(and (!= (.-sbc (.-Arch a)) "") ^:go/paren (or (== carry UseCarry) (== carry (bit-or UseCarry SmashCarry))))]
      (.op3 a (.-sbc (.-Arch a)) src1 src2 dst))
    (case [(and (!= (.-sbcs (.-Arch a)) "") ^:go/paren (or (== carry (bit-or UseCarry SetCarry)) (== carry (bit-or UseCarry SmashCarry))))]
      (.op3 a (.-sbcs (.-Arch a)) src1 src2 dst))
    (case [(and (strings/HasPrefix (.-name src1) "$") ^:go/paren (or (== carry KeepCarry) (== carry SmashCarry)))]

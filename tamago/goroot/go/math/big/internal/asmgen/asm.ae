      ;; and we don't need to worry about carry semantics,
      ;; try adding the negation.
      (if (strings/HasPrefix (.-name src1) "$-")
        (set! (.-name src1) (+ "$" (subslice (.-name src1) 2)))

        (set! (.-name src1) (+ "$-" (subslice (.-name src1) 1))))

      (.Add a src1 src2 dst carry))

    (case [(and (!= (.-sub (.-Arch a)) "") (!= (.-regCarry (.-Arch a)) ""))]
      ;; Machine has no carry flag; instead we've dedicated a register
      ;; and use SLTU/SGTU (set less-than/greater-than unsigned)
      ;; to compute the carry bits as needed.
      ;; For SUB x, y, z, SLTU x, y, c computes the carry (borrow) bit.
      ;; To make the output less of a wall of instructions,
      ;; we comment the “higher-level” operation, with ... marking
      ;; continued instructions implementing the operation.
      ;; Be careful! Subtract and add have different overflow behaviors,
      ;; so the details here are NOT the same as in Add above.
      (let [cr (.Carry a)]
        (when (!= (bit-and carry AltCarry) 0)
          (.Fatalf a "alt carry not supported"))

        (let [tmp (.tmp a)]
          (when (not (.Valid tmp))
            (.Fatalf a "cannot simulate carry without regTmp"))

          (switch carry
            (default
              (.Fatalf a "unsupported carry behavior"))
            (case [UseCarry (bit-or UseCarry SmashCarry)]
              ;; Easy case, just subtract the carry afterward.
              (when (.IsZero a src1)
                ;; Only here to use the carry.
                (.Sub a cr src2 dst KeepCarry)
                (.EOL a "SBC $0, %s, %s" src2 dst)
                (break))

              (.Sub a src1 src2 dst KeepCarry)
              (.EOL a "SBC %s, %s, %s" src1 src2 dst)
              (.Sub a cr dst dst KeepCarry)
              (.EOL a "..."))

            (case [SetCarry]
              (when (and (.IsZero a src1) (== src2 dst))
                ;; Only here to clear the carry flag.
                (.Xor a cr cr cr)
                (break))

              ;; Compute the new carry first, in case dst is src1 or src2.
              (.SLTU a src1 src2 cr)
              (.EOL a "SUBS %s, %s, %s" src1 src2 dst)
              (.Sub a src1 src2 dst KeepCarry)
              (.EOL a "..."))

            (case [(bit-or UseCarry SetCarry)]
              (when (.IsZero a src1)
                ;; Only here to use and then set the carry.
                (when (== src2 dst)
                  ;; Unfortunate case. Using src2==dst is common (think x -= y)
                  ;; and also more efficient on two-operand machines (like x86),
                  ;; but here subtracting from dst will smash src2, making it
                  ;; impossible to recover the carry information after the SUB.
                  ;; But we want to use the carry, so we can't compute it before
                  ;; the SUB either. Compute into a temporary and MOV.
                  (.SLTU a cr src2 tmp)
                  (.EOL a "SBCS $0, %s, %s" src2 dst)
                  (.Sub a cr src2 dst KeepCarry)
                  (.EOL a "...")
                  (.Mov a tmp cr)
                  (.EOL a "...")
                  (break))

                (.Sub a cr src2 dst KeepCarry) ; src2 not dst, so src2 preserved
                (.SLTU a cr src2 cr)
                (break))

              ;; General case. Need to do two different subtracts (src2 - cr - src1),
              ;; computing carry bits for both, and add'ing them together.
              ;; Doing src2 - cr first frees up cr to store the carry from the sub of src1.
              (.SLTU a cr src2 tmp)
              (.EOL a "SBCS %s, %s, %s" src1 src2 dst)
              (.Sub a cr src2 dst KeepCarry)
              (.EOL a "...")
              (.SLTU a src1 dst cr)
              (.EOL a "...")
              (.Sub a src1 dst dst KeepCarry)
              (.EOL a "...")
              (.Add a tmp cr cr KeepCarry)
              (.EOL a "..."))))))))







^{:go/end 677} (go/method ClearCarry "ClearCarry clears the carry flag.\nThe ‘which’ parameter must be AddCarry or SubCarry to specify how the flag will be used.\n(On some systems, the sub carry's actual processor bit is inverted from its usual value.)\n" [^{:tag (* Asm)} a ^Carry which]
  (let [dst (lit Reg (aget (.-regs (.-Arch a)) 0))] ; not actually modified
    (switch (bit-and which (bit-or AddCarry SubCarry))
      (default
        (.Fatalf a "bad carry"))
      (case [AddCarry]
        (.Add a (.Imm a 0) dst dst (bit-or SetCarry (bit-and which AltCarry))))
      (case [SubCarry]
        (.Sub a (.Imm a 0) dst dst (bit-or SetCarry (bit-and which AltCarry)))))

    (.EOL a "clear carry")))





^{:go/end 695} (go/method SaveCarry "SaveCarry saves the carry flag into dst.\nThe meaning of the bits in dst is architecture-dependent.\nThe carry flag is left in an undefined state.\n" [^{:tag (* Asm)} a ^Reg dst]
  ;; Note: As implemented here, the carry flag is actually left unmodified,
  ;; but we say it is in an undefined state in case that changes in the future.
  ;; (The SmashCarry could be changed to SetCarry if so.)
  (if [cr (.Carry a)] (.Valid cr) (do
      (when (== cr dst)
        (return)) ; avoid EOL

      (.Mov a cr dst))

    (.Sub a dst dst dst (bit-or UseCarry SmashCarry)))

  (.EOL a "save carry"))




^{:go/end 715} (go/method RestoreCarry "RestoreCarry restores the carry flag from src.\nsrc is left in an undefined state.\n" [^{:tag (* Asm)} a ^Reg src]
  (if [cr (.Carry a)] (.Valid cr) (do
      (when (== cr src)
        (return)) ; avoid EOL

      (.Mov a src cr))
    (if (.-subCarryIsBorrow (.-Arch a))
      (.Add a src src src SetCarry)

      ;; SaveCarry saved the sub carry flag with an encoding of 0, 1 -> 0, ^0.
      ;; Restore it by subtracting from a value less than ^0, which will carry if src != 0.
      ;; If there is no zero register, the SP register is guaranteed to be less than ^0.
      ;; (This may seem too clever, but on GOARCH=arm we have no other good options.)
      (.Sub a src (^{:inst [Reg]} cmp/Or (.ZR a) (lit Reg "SP")) src SetCarry)))

  (.EOL a "restore carry"))




^{:go/end 735} (go/method ConvertCarry "ConvertCarry converts the carry flag in dst from the internal format to a 0 or 1.\nThe carry flag is left in an undefined state.\n" [^{:tag (* Asm)} a ^Carry which ^Reg dst]
  (when (.Valid (.Carry a)) ; already 0 or 1
    (return))

  (switch which
    (case [AddCarry]
      (if (.-subCarryIsBorrow (.-Arch a))
        (.Neg a dst dst)

        (.Add a (.Imm a 1) dst dst SmashCarry))

      (.EOL a "convert add carry"))
    (case [SubCarry]
      (.Neg a dst dst)
      (.EOL a "convert sub carry"))))





^{:go/end 754} (go/method SaveConvertCarry "SaveConvertCarry saves and converts the carry flag into dst: 0 unset, 1 set.\nThe carry flag is left in an undefined state.\n" [^{:tag (* Asm)} a ^Carry which ^Reg dst]
  (switch which
    (default
      (.Fatalf a "bad carry"))
    (case [AddCarry]
      (when (and ^:go/paren (or (!= (.-adc (.-Arch a)) "") (!= (.-adcs (.-Arch a)) "")) (.Valid (.ZR a)))
        (.Add a (.ZR a) (.ZR a) dst (bit-or UseCarry SmashCarry))
        (.EOL a "save & convert add carry")
        (return)))

    (case [SubCarry]))
  ;; no special cases

  (.SaveCarry a dst)
  (.ConvertCarry a which dst))





^{:go/end 776} (go/method MulWide "MulWide emits dstlo = src1 * src2 and dsthi = (src1 * src2) >> WordBits.\nThe carry flag is left in an undefined state.\nIf dstlo or dsthi is the zero Reg, then those outputs are discarded.\n" [^{:tag (* Asm)} a ^Reg src1 ^Reg src2 ^Reg dstlo ^Reg dsthi]
  (switch
    (default
      (.Fatalf a "mulwide not available"))
    (case [(!= (.-mulWideF (.-Arch a)) nil)]
      ((.-mulWideF (.-Arch a)) a src1 src2 dstlo dsthi))
    (case [(and (!= (.-mul (.-Arch a)) "") (not (.Valid dsthi)))]
      (.op3 a (.-mul (.-Arch a)) src1 src2 dstlo))
    (case [(and (!= (.-mulhi (.-Arch a)) "") (not (.Valid dstlo)))]
      (.op3 a (.-mulhi (.-Arch a)) src1 src2 dsthi))
    (case [(and (!= (.-mul (.-Arch a)) "") (!= (.-mulhi (.-Arch a)) "") (!= dstlo src1) (!= dstlo src2))]
      (.op3 a (.-mul (.-Arch a)) src1 src2 dstlo)
      (.op3 a (.-mulhi (.-Arch a)) src1 src2 dsthi))
    (case [(and (!= (.-mul (.-Arch a)) "") (!= (.-mulhi (.-Arch a)) "") (!= dsthi src1) (!= dsthi src2))]
      (.op3 a (.-mulhi (.-Arch a)) src1 src2 dsthi)
      (.op3 a (.-mul (.-Arch a)) src1 src2 dstlo))))




^{:go/end 782} (go/method Jmp "Jmp jumps to the label.\n" [^{:tag (* Asm)} a ^string label]
  ;; Note: Some systems prefer the spelling B or BR, but all accept JMP.
  (.Printf a "\tJMP %s\n" label))




^{:go/end 788} (go/method JmpZero "JmpZero jumps to the label if src is zero.\nIt may modify the carry flag unless a.Arch.CarrySafeLoop is true.\n" [^{:tag (* Asm)} a ^Reg src ^string label]
  (.Printf a (+ "\t" (.-jmpZero (.-Arch a)) "\n") src label))




^{:go/end 794} (go/method JmpNonZero "JmpNonZero jumps to the label if src is non-zero.\nIt may modify the carry flag unless a.Arch,CarrySafeLoop is true.\n" [^{:tag (* Asm)} a ^Reg src ^string label]
  (.Printf a (+ "\t" (.-jmpNonZero (.-Arch a)) "\n") src label))



^{:go/end 799} (go/method Label "Label emits a label with the given name.\n" [^{:tag (* Asm)} a ^string name]
  (.Printf a "%s:\n" name))



^{:go/end 804} (go/method Ret "Ret returns.\n" [^{:tag (* Asm)} a]
  (.Printf a "\tRET\n"))

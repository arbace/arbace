    (.Fatalf a "missing instruction"))

  (cond (== src2 dst)
    ;; src2 and dst are same; print as 2-op form.
    (.Printf a "\t%s %s, %s\n" op src1 dst)
    (and (!= (.-op3 (.-Arch a)) nil) (not ((.-op3 (.-Arch a)) op))) (do
      ;; Machine does not have 3-op form for op; convert to 2-op.
      (when (== src1 dst)
        (.Fatalf a "implicit mov %s, %s would smash src1" src2 dst))

      (.Mov a src2 dst)
      (.Printf a "\t%s %s, %s\n" op src1 dst)) :else

    ;; Full 3-op form.
    (.Printf a "\t%s %s, %s, %s\n" op src1 src2 dst)))





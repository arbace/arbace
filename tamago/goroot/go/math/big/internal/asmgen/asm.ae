  (when (and (== h HintAltCarry) (!= (.-regAltCarry (.-Arch a)) ""))
    (return (.-regAltCarry (.-Arch a))))

  (when (or (== h HintNone) (== (.-hint (.-Arch a)) nil))
    (return ""))

  ((.-hint (.-Arch a)) a h))





;; Asmgen generates math/big assembly.
;;
;; Usage:
;;
;;	cd go/src/math/big
;;	go test ./internal/asmgen -generate
;;
;; Or:
;;
;;	go generate math/big
(in-ns 'go.math.big.internal.asmgen) (go/file "main.go" :doc "Asmgen generates math/big assembly.\n\nUsage:\n\n\tcd go/src/math/big\n\tgo test ./internal/asmgen -generate\n\nOr:\n\n\tgo generate math/big\n" :imports [])

(go/var arches (lit (slice (* Arch))
    ^{:line 18} Arch386
    ^{:line 19} ArchAMD64
    ^{:line 20} ArchARM
    ^{:line 21} ArchARM64
    ^{:line 22} ArchLoong64
    ^{:line 23} ArchMIPS
    ^{:line 24} ArchMIPS64x
    ^{:line 25} ArchPPC64x
    ^{:line 26} ArchRISCV64
    ^{:line 27} ArchS390X))



^{:go/end 41} (go/func generate "generate returns the file name and content of the generated assembly for the given architecture.\n" [^{:tag (* Arch)} arch] :results [^string file ^{:tag (slice byte)} data]
  (set! file (+ "arith_" (.-Name arch) ".s"))
  (let [a (NewAsm arch)]
    (addOrSubVV a "addVV")
    (addOrSubVV a "subVV")
    (shiftVU a "lshVU")
    (shiftVU a "rshVU")
    (mulAddVWW a)
    (addMulVVWW a)
    (return file (.Bytes (.-out a)))))

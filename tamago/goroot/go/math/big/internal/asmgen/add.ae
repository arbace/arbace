(in-ns 'go.math.big.internal.asmgen) (go/file "add.go" :imports [])




^{:go/end 57} (go/func addOrSubVV "addOrSubVV generates addVV or subVV,\nwhich do z, c = x ± y.\nThe caller guarantees that len(z) == len(x) == len(y).\n" [^{:tag (* Asm)} a ^string name]
  (let [f (.Func a (+ "func " name "(z, x, y []Word) (c Word)"))

      ^{:line 13} add (.-Add a)
      ^{:line 14} which AddCarry]
    (when (== name "subVV")
      (set! add (.-Sub a))
      (set! which SubCarry))


    (let [n (.Arg f "z_len")
        ^{:line 21} p (.Pipe f)]
      (.SetHint p "y" HintMemOK) ; allow y to be used from memory on x86
      (.Start p n 1 4)
      (let [^Reg c (zero Reg)]
        (if (not (.-CarrySafeLoop (.-Arch a))) (do
            ;; Carry smashed by loop tests; allocate and save in register
            ;; around unrolled blocks.
            (set! c (.Reg a))
            (.Mov a (.Imm a 0) c)
            (.EOL a "clear saved carry")
            (.AtUnrollStart p ^{:go/end 31} (fn [] (.RestoreCarry a c) (.Free a c)))
            (.AtUnrollEnd p ^{:go/end 32} (fn [] (.Unfree a c) (.SaveCarry a c))))

          ;; Carry preserved by loop; clear now, ahead of loop
          ;; (but after Start, which may have modified it).
          (.ClearCarry a which))

        (.Loop p ^{:go/end 44} (fn [^{:tag (slice (slice Reg))} in ^{:tag (slice (slice Reg))} out]
            (range [i x (aget in 0)]
              (let [y (aget (aget in 1) i)]
                (add y x x (bit-or SetCarry UseCarry))))

            (.StoreN p (subslice in _ 1))))

        (.Done p)

        ;; Copy carry to output.
        (if (.Valid c)
          (.ConvertCarry a which c)
          (do
            (set! c (.RegHint a HintCarry))
            (.SaveConvertCarry a which c)))

        (.StoreArg f c "c")
        (.Free a c)
        (.Ret a)))))

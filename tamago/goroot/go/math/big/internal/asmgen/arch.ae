(go/type Reg "A Reg is an allocated register or other assembly operand.\n(For example, a constant might have name \"$123\"\nand a memory reference might have name \"0(R8)\".)\n" (struct ^string name))


^{:go/end 182} (go/method IsImm "IsImm reports whether r is an immediate value.\n" ^bool [^Reg r] (strings/HasPrefix (.-name r) "$"))



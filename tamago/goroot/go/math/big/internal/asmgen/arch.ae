(go/type Carry "A Carry is a flag field explaining how an instruction sets and uses the carry flags.\nDifferent operations expect different sets of bits.\nAdd and Sub expect: UseCarry or 0, SetCarry, KeepCarry, or SmashCarry; and AltCarry or 0.\nClearCarry, SaveCarry, and ConvertCarry expect: AddCarry or SubCarry; and AltCarry or 0.\n" uint)

(go/const
  ^{:line 214} [^{:tag Carry :val 1} SetCarry (<< 1 iota)] ; sets carry
  ^{:line 215} [^{:val 2} UseCarry] ; uses carry
  ^{:line 216} [^{:val 4} KeepCarry] ; must preserve carry
  ^{:line 217} [^{:val 8} SmashCarry] ; can modify carry or not, whatever is easiest

  ^{:line 219} [^{:val 16} AltCarry] ; use the secondary carry flag
  ^{:line 220} [^{:val 32} AddCarry] ; use add carry flag semantics (for ClearCarry, ConvertCarry)
  ^{:line 221} [^{:val 64} SubCarry]) ; use sub carry flag semantics (for ClearCarry, ConvertCarry)




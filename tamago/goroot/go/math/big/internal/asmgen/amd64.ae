(in-ns 'go.math.big.internal.asmgen) (go/file "amd64.go" :imports [])

(go/var ArchAMD64 (addr ^{:go/breaks [2 4 6 [8 12] [10 17] 12 14 16 [18 26] [20 30] 22 24 26 28 30 32 34 36 38 40 42 44 46 48 50 [52 47] [54 49] 56 58 60]} (lit Arch
      :Name "amd64"
      :WordBits 64
      :WordBytes 8

      :regs ^{:go/breaks [2 5 13]} (lit (slice string)
        "BX" "SI" "DI"
        "R8" "R9" "R10" "R11" "R12" "R13" "R14" "R15"
        "AX" "DX" "CX") ; last to leave available for hinted allocation

      :op3 x86Op3
      :hint x86Hint
      :memOK true
      :subCarryIsBorrow true

      ;; Note: Not setting memIndex, because code generally runs faster
      ;; if we avoid the use of scaled-index memory references,
      ;; particularly in ADX instructions.

      :options (lit (map Option (func [(* Asm) string]))
        ^{:line 27} [OptionAltCarry amd64JmpADX])


      :mov "MOVQ"
      :adds "ADDQ"
      :adcs "ADCQ"
      :subs "SUBQ"
      :sbcs "SBBQ"
      :lsh "SHLQ"
      :lshd "SHLQ"
      :rsh "SHRQ"
      :rshd "SHRQ"
      :and "ANDQ"
      :or "ORQ"
      :xor "XORQ"
      :neg "NEGQ"
      :lea "LEAQ"
      :addF amd64Add
      :mulWideF x86MulWide

      :addWords "LEAQ (%[2]s)(%[1]s*8), %[3]s"

      :jmpZero "TESTQ %[1]s, %[1]s; JZ %[2]s"
      :jmpNonZero "TESTQ %[1]s, %[1]s; JNZ %[2]s"
      :loopBottom "SUBQ $1, %[1]s; JNZ %[2]s"
      :loopBottomNeg "ADDQ $1, %[1]s; JNZ %[2]s")))


^{:go/end 57} (go/func amd64JmpADX [^{:tag (* Asm)} a ^string label]
  (.Printf a "\tCMPB ·hasADX(SB), $0; JNZ %s\n" label))


^{:go/breaks [[4 83]] :go/end 84} (go/func amd64Add ^bool [^{:tag (* Asm)} a ^Reg src1 ^Reg src2 ^Reg dst ^Carry carry]
  (when (.Enabled a OptionAltCarry)
    ;; If OptionAltCarry is enabled, the generator is emitting ADD instructions
    ;; both with and without the AltCarry flag set; the AltCarry flag means to
    ;; use ADOX. Otherwise we have to use ADCX.
    ;; Using regular ADD/ADC would smash both carry flags,
    ;; so we reject anything we can't handled with ADCX/ADOX.
    (when (and (!= (bit-and carry UseCarry) 0) (!= (bit-and carry (bit-or SetCarry SmashCarry)) 0))
      (if (!= (bit-and carry AltCarry) 0)
        (.op3 a "ADOXQ" src1 src2 dst)

        (.op3 a "ADCXQ" src1 src2 dst))

      (return true))

    (when (and (== (bit-and carry (bit-or SetCarry UseCarry)) SetCarry) (.IsZero a src1) (== src2 dst))
      ;; Clearing carry flag. Caller will add EOL comment.
      (.Printf a "\tTESTQ AX, AX\n")
      (return true))

    (when (!= carry KeepCarry)
      (.Fatalf a "unsupported carry")))


  false)


;; The x86-prefixed functions are shared with Arch386 in 386.go.

^{:go/breaks [[3 91]] :go/end 92} (go/func x86Op3 ^bool [^string name]
  ;; As far as a.op3 is concerned, there are no 3-op instructions.
  ;; (We print instructions like MULX ourselves.)
  false)


^{:go/breaks [[4 109]] :go/end 110} (go/func x86Hint ^string [^{:tag (* Asm)} a ^Hint h]
  (switch h
    (case [HintShiftCount]
      (return "CX"))
    (case [HintMulSrc]
      (when (.Enabled a OptionAltCarry) ; using MULX
        (return "DX"))

      (return "AX"))
    (case [HintMulHi]
      (when (.Enabled a OptionAltCarry) ; using MULX
        (return ""))

      (return "DX")))

  "")


^{:go/breaks [[4 117]] :go/end 118} (go/func x86Suffix ^string [^{:tag (* Asm)} a]
  ;; Note: Not using a.Arch == Arch386 to avoid init cycle.
  (when (== (.-Name (.-Arch a)) "386")
    (return "L"))

  "Q")


^{:go/end 146} (go/func x86MulWide [^{:tag (* Asm)} a ^Reg src1 ^Reg src2 ^Reg dstlo ^Reg dsthi]
  (when (.Enabled a OptionAltCarry)
    ;; Using ADCX/ADOX; use MULX to avoid clearing carry flag.
    (when (!= (.-name src1) "DX")
      (when (!= (.-name src2) "DX")
        (.Fatalf a "mul src1 or src2 must be DX"))

      (set! src2 src1))

    (.Printf a "\tMULXQ %s, %s, %s\n" src2 dstlo dsthi)
    (return))


  (when (!= (.-name src1) "AX")
    (when (!= (.-name src2) "AX")
      (.Fatalf a "mulwide src1 or src2 must be AX"))

    (set! src2 src1))

  (when (!= (.-name dstlo) "AX")
    (.Fatalf a "mulwide dstlo must be AX"))

  (when (!= (.-name dsthi) "DX")
    (.Fatalf a "mulwide dsthi must be DX"))

  (.Printf a "\tMUL%s %s\n" (x86Suffix a) src2))

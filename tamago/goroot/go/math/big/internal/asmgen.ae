(ns go.math.big.internal.asmgen
  (:require [arbace.go :as go]))

(go/package asmgen
  :path "math/big/internal/asmgen"
  :files ["386.go" "add.go" "amd64.go" "arch.go" "arm.go" "arm64.go" "asm.go" "func.go" "loong64.go" "main.go" "mips.go" "mips64.go" "mul.go" "pipe.go" "ppc64.go" "riscv64.go" "s390x.go" "shift.go"]
  :positions :lines)

(load "asmgen/386")
(load "asmgen/add")
(load "asmgen/amd64")
(load "asmgen/arch")
(load "asmgen/arm")
(load "asmgen/arm64")
(load "asmgen/asm")
(load "asmgen/func")
(load "asmgen/loong64")
(load "asmgen/main")
(load "asmgen/mips")
(load "asmgen/mips64")
(load "asmgen/mul")
(load "asmgen/pipe")
(load "asmgen/ppc64")
(load "asmgen/riscv64")
(load "asmgen/s390x")
(load "asmgen/shift")

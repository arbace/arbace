^{:go/end 26} (go/method Text "Text returns the string representation of x in the given base.\nBase must be between 2 and 62, inclusive. The result uses the\nlower-case letters 'a' to 'z' for digit values 10 to 35, and\nthe upper-case letters 'A' to 'Z' for digit values 36 to 61.\nNo prefix (such as \"0x\") is added to the string. If x is a nil\npointer it returns \"<nil>\".\n" ^string [^{:tag (* Int)} x ^int base]
  (when (== x nil)
    (return "<nil>"))

  (conv string (.itoa (.-abs x) (.-neg x) base)))




^{:go/end 35} (go/method Append "Append appends the string representation of x, as generated by\nx.Text(base), to buf and returns the extended buffer.\n" ^{:tag (slice byte)} [^{:tag (* Int)} x ^{:tag (slice byte)} buf ^int base]
  (when (== x nil)
    (return (append buf (spread "<nil>"))))

  (append buf (spread (.itoa (.-abs x) (.-neg x) base))))




^{:go/end 41} (go/method String "String returns the decimal representation of x as generated by\nx.Text(10).\n" ^string [^{:tag (* Int)} x]
  (.Text x 10))



^{:go/end 66} (go/func writeMultiple "write count copies of text to s.\n" [^fmt/State s ^string text ^int count]
  (when (or (<= (len text) 0) (<= count 0))
    (return))

  (when (== (len text) 1)
    (when [(values bw ok) (assert io/ByteWriter s)] ok
      (range [count]
        (.WriteByte bw (aget text 0)))

      (return)))


  (when [(values sw ok) (assert io/StringWriter s)] ok
    (range [count]
      (.WriteString sw text))

    (return))

  (let [b (conv (slice byte) text)]
    (range [count]
      (.Write s b))))



(go/var ^fmt/Formatter _ intOne) ; *Int must implement fmt.Formatter












^{:go/end 182} (go/method Format "Format implements [fmt.Formatter]. It accepts the formats\n'b' (binary), 'o' (octal with 0 prefix), 'O' (octal with 0o prefix),\n'd' (decimal), 'x' (lowercase hexadecimal), and\n'X' (uppercase hexadecimal).\nAlso supported are the full suite of package fmt's format\nflags for integral types, including '+' and ' ' for sign\ncontrol, '#' for leading zero in octal and for hexadecimal,\na leading \"0x\" or \"0X\" for \"%#x\" and \"%#X\" respectively,\nspecification of minimum digits precision, output field\nwidth, space or zero padding, and '-' for left or right\njustification.\n" [^{:tag (* Int)} x ^fmt/State s ^rune ch]
  ;; determine base
  (let [^int base (zero int)]
    (switch ch
      (case [\b]
        (set! base 2))
      (case [\o \O]
        (set! base 8))
      (case [\d \s \v]
        (set! base 10))
      (case [\x \X]
        (set! base 16))
      (default
        ;; unknown format
        (fmt/Fprintf s "%%!%c(big.Int=%s)" ch (.String x))
        (return)))


    (when (== x nil)
      (fmt/Fprint s "<nil>")
      (return))


    ;; determine sign character
    (let [sign ""]
      (switch
        (case [(.-neg x)]
          (set! sign "-"))
        (case [(.Flag s \+)] ; supersedes ' ' when both specified
          (set! sign "+"))
        (case [(.Flag s \space)]
          (set! sign " ")))


      ;; determine prefix characters for indicating output base
      (let [prefix ""]
        (when (.Flag s \#)
          (switch ch
            (case [\b] ; binary
              (set! prefix "0b"))
            (case [\o] ; octal
              (set! prefix "0"))
            (case [\x] ; hexadecimal
              (set! prefix "0x"))
            (case [\X]
              (set! prefix "0X"))))


        (when (== ch \O)
          (set! prefix "0o"))


        (let [digits (.utoa (.-abs x) base)]
          (when (== ch \X)
            ;; faster than bytes.ToUpper
            (range [i d digits]
              (when (and (<= \a d) (<= d \z))
                (aset digits i (+ \A (- d \a))))))




          ;; number of characters for the three classes of number padding
          (let [^int left (zero int) ; space characters to left of digits for right justification ("%8d")
              ^{:line 145 :tag int} zeros (zero int) ; zero characters (actually cs[0]) as left-most digits ("%.8d")
              ^{:line 146 :tag int} right (zero int) ; space characters to right of digits for left justification ("%-8d")

              ;; determine number padding from precision: the least number of digits to output
              (values precision precisionSet) (.Precision s)]
            (when precisionSet
              (switch
                (case [(< (len digits) precision)]
                  (set! zeros (- precision (len digits)))) ; count of zero padding
                (case [(and (== (len digits) 1) (== (aget digits 0) \0) (== precision 0))]
                  (return)))) ; print nothing if zero value (x == 0) and zero precision ("." or ".0")



            ;; determine field pad from width: the least number of characters to output
            (let [length (+ (len sign) (len prefix) zeros (len digits))]
              (when [(values width widthSet) (.Width s)] (and widthSet (< length width)) ; pad as specified
                (switch [d (- width length)]
                  (case [(.Flag s \-)]
                    ;; pad on the right with spaces; supersedes '0' when both specified
                    (set! right d))
                  (case [(and (.Flag s \0) (not precisionSet))]
                    ;; pad with zeros unless precision also specified
                    (set! zeros d))
                  (default
                    ;; pad on the left with spaces
                    (set! left d))))



              ;; print number as [left pad][sign][prefix][zero pad][digits][right pad]
              (writeMultiple s " " left)
              (writeMultiple s sign 1)
              (writeMultiple s prefix 1)
              (writeMultiple s "0" zeros)
              (.Write s digits)
              (writeMultiple s " " right))))))))













^{:go/end 210} (go/method scan "scan sets z to the integer value corresponding to the longest possible prefix\nread from r representing a signed integer number in a given conversion base.\nIt returns z, the actual conversion base used, and an error, if any. In the\nerror case, the value of z is undefined but the returned value is nil. The\nsyntax follows the syntax of integer literals in Go.\n\nThe base argument must be 0 or a value from 2 through MaxBase. If the base\nis 0, the string prefix determines the actual conversion base. A prefix of\n“0b” or “0B” selects base 2; a “0”, “0o”, or “0O” prefix selects\nbase 8, and a “0x” or “0X” prefix selects base 16. Otherwise the selected\nbase is 10.\n" [^{:tag (* Int)} z ^io/ByteScanner r ^int base] :results [(* Int) int error]
  ;; determine sign
  (let [(values neg err) (scanSign r)]
    (when (!= err nil)
      (return nil 0 err))


    ;; determine mantissa
    (set! (values (.-abs z) base _ err) (.scan (.-abs z) r base false))
    (when (!= err nil)
      (return nil base err))

    (set! (.-neg z) (and (> (len (.-abs z)) 0) neg)) ; 0 has no sign

    (return z base nil)))


^{:go/end 226} (go/func scanSign [^io/ByteScanner r] :results [^bool neg ^error err]
  (let [^byte ch (zero byte)]
    (when [(set! (values ch err) (.ReadByte r))] (!= err nil)
      (return false err))

    (switch ch
      (case [\-]
        (set! neg true))
      (case [\+])
      ;; nothing to do
      (default
        (.UnreadByte r)))

    (return)))




(go/type byteReader "byteReader is a local wrapper around fmt.ScanState;\nit implements the ByteReader interface.\n" (struct
    ^{:line 231} fmt/ScanState))


^{:go/end 240} (go/method ReadByte [^byteReader r] :results [byte error]
  (let [(values ch size err) ^{:go/via [ScanState]} (.ReadRune r)]
    (when (and (!= size 1) (== err nil))
      (set! err (fmt/Errorf "invalid rune %#U" ch)))

    (return (conv byte ch) err)))


^{:go/end 244} (go/method UnreadByte ^error [^byteReader r]
  ^{:go/via [ScanState]} (.UnreadRune r))


(go/var ^fmt/Scanner _ intOne) ; *Int must implement fmt.Scanner




^{:go/end 270} (go/method Scan "Scan is a support routine for [fmt.Scanner]; it sets z to the value of\nthe scanned number. It accepts the formats 'b' (binary), 'o' (octal),\n'd' (decimal), 'x' (lowercase hexadecimal), and 'X' (uppercase hexadecimal).\n" ^error [^{:tag (* Int)} z ^fmt/ScanState s ^rune ch]
  (.SkipSpace s) ; skip leading space characters
  (let [base 0]
    (switch ch
      (case [\b]
        (set! base 2))
      (case [\o]
        (set! base 8))
      (case [\d]
        (set! base 10))
      (case [\x \X]
        (set! base 16))
      (case [\s \v])
      ;; let scan determine the base
      (default
        (return (errors/New "Int.Scan: invalid verb"))))

    (let [(values _ _ err) (.scan z (lit byteReader s) base)]
      ^{:line 269} err)))

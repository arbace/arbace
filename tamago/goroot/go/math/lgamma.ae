^{:go/end 322} (go/func Lgamma "Lgamma returns the natural logarithm and sign (-1 or +1) of [Gamma](x).\n\nSpecial cases are:\n\n\tLgamma(+Inf) = +Inf\n\tLgamma(0) = +Inf\n\tLgamma(-integer) = +Inf\n\tLgamma(-Inf) = -Inf\n\tLgamma(NaN) = NaN\n" [^float64 x] :results [^float64 lgamma ^int sign]
  (let [
      ^:const ^{:line 177 :val 1.461632144968362245M} Ymin 1.461632144968362245M
      ^:const ^:go/grouped ^{:line 178 :val 4503599627370496} Two52 (<< 1 52) ; 0x4330000000000000 ~4.5036e+15
      ^:const ^:go/grouped ^{:line 179 :val 9007199254740992} Two53 (<< 1 53) ; 0x4340000000000000 ~9.0072e+15
      ^:const ^:go/grouped ^{:line 180 :val 288230376151711744} Two58 (<< 1 58) ; 0x4390000000000000 ~2.8823e+17
      ^:const ^:go/grouped ^{:line 181 :val 8.470329472543003390683225006796419620513916015625E-22M} Tiny (/ 1.0 (<< 1 70)) ; 0x3b90000000000000 ~8.47033e-22
      ^:const ^:go/grouped ^{:line 182 :val 1.46163214496836224576M} Tc 1.46163214496836224576M ; 0x3FF762D86356BE3F
      ^:const ^:go/grouped ^{:line 183 :val -0.121486290535849611461M} Tf -0.121486290535849611461M ; 0xBFBF19B9BCC38A42
      ;; Tt = -(tail of Tf)
      ^:const ^:go/grouped ^{:line 185 :val -3.63867699703950536541E-18M} Tt -3.63867699703950536541E-18M] ; 0xBC50C7CAA48A971F

    ;; special cases
    (set! sign 1)
    (switch
      (case [(IsNaN x)]
        (set! lgamma x)
        (return))
      (case [(IsInf x 0)]
        (set! lgamma x)
        (return))
      (case [(== x 0)]
        (set! lgamma (Inf 1))
        (return)))


    (let [neg false]
      (when (< x 0)
        (set! x (- x))
        (set! neg true))


      (when (< x Tiny) ; if |x| < 2**-70, return -log(|x|)
        (when neg
          (set! sign -1))

        (set! lgamma (- (Log x)))
        (return))

      (let [^float64 nadj (zero float64)]
        (when neg
          (when (>= x Two52) ; |x| >= 2**52, must be -integer
            (set! lgamma (Inf 1))
            (return))

          (let [t (sinPi x)]
            (when (== t 0)
              (set! lgamma (Inf 1)) ; -integer
              (return))

            (set! nadj (Log (/ Pi (Abs (* t x)))))
            (when (< t 0)
              (set! sign -1))))



        (switch
          (case [(or (== x 1) (== x 2))] ; purge off 1 and 2
            (set! lgamma 0)
            (return))
          (case [(< x 2)] ; use lgamma(x) = lgamma(x+1) - log(x)
            (let [^float64 y (zero float64)
                ^{:line 237 :tag int} i (zero int)]
              (if (<= x 0.9) (do
                  (set! lgamma (- (Log x)))
                  (switch
                    (case [(>= x (+ (- Ymin 1) 0.27))] ; 0.7316 <= x <=  0.9
                      (set! y (- 1 x))
                      (set! i 0))
                    (case [(>= x (- Ymin 1 0.27))] ; 0.2316 <= x < 0.7316
                      (set! y (- x (- Tc 1)))
                      (set! i 1))
                    (default ; 0 < x < 0.2316
                      (set! y x)
                      (set! i 2))))

                (do
                  (set! lgamma 0)
                  (switch
                    (case [(>= x (+ Ymin 0.27))] ; 1.7316 <= x < 2
                      (set! y (- 2 x))
                      (set! i 0))
                    (case [(>= x (- Ymin 0.27))] ; 1.2316 <= x < 1.7316
                      (set! y (- x Tc))
                      (set! i 1))
                    (default ; 0.9 < x < 1.2316
                      (set! y (- x 1))
                      (set! i 2)))))


              (switch i
                (case [0]
                  (let [z (* y y)
                      ^{:line 268} p1 (+ (aget _lgamA 0) (* z (+ (aget _lgamA 2) (* z (+ (aget _lgamA 4) (* z (+ (aget _lgamA 6) (* z (+ (aget _lgamA 8) (* z (aget _lgamA 10)))))))))))
                      ^{:line 269} p2 (* z (+ (aget _lgamA 1) (* z (+ (+ (aget _lgamA 3)) (* z (+ (aget _lgamA 5) (* z (+ (aget _lgamA 7) (* z (+ (aget _lgamA 9) (* z (aget _lgamA 11))))))))))))
                      ^{:line 270} p (+ (* y p1) p2)]
                    (set! lgamma + (- p (* 0.5 y)))))
                (case [1]
                  (let [z (* y y)
                      ^{:line 274} w (* z y)
                      ^{:line 275} p1 (+ (aget _lgamT 0) (* w (+ (aget _lgamT 3) (* w (+ (aget _lgamT 6) (* w (+ (aget _lgamT 9) (* w (aget _lgamT 12))))))))) ; parallel comp
                      ^{:line 276} p2 (+ (aget _lgamT 1) (* w (+ (aget _lgamT 4) (* w (+ (aget _lgamT 7) (* w (+ (aget _lgamT 10) (* w (aget _lgamT 13)))))))))
                      ^{:line 277} p3 (+ (aget _lgamT 2) (* w (+ (aget _lgamT 5) (* w (+ (aget _lgamT 8) (* w (+ (aget _lgamT 11) (* w (aget _lgamT 14)))))))))
                      ^{:line 278} p (- (* z p1) (- Tt (* w (+ p2 (* y p3)))))]
                    (set! lgamma + (+ Tf p))))
                (case [2]
                  (let [p1 (* y (+ (aget _lgamU 0) (* y (+ (aget _lgamU 1) (* y (+ (aget _lgamU 2) (* y (+ (aget _lgamU 3) (* y (+ (aget _lgamU 4) (* y (aget _lgamU 5))))))))))))
                      ^{:line 282} p2 (+ 1 (* y (+ (aget _lgamV 1) (* y (+ (aget _lgamV 2) (* y (+ (aget _lgamV 3) (* y (+ (aget _lgamV 4) (* y (aget _lgamV 5)))))))))))]
                    (set! lgamma + (+ (* -0.5 y) (/ p1 p2))))))))

          (case [(< x 8)] ; 2 <= x < 8
            (let [i (conv int x)
                ^{:line 287} y (- x (conv float64 i))
                ^{:line 288} p (* y (+ (aget _lgamS 0) (* y (+ (aget _lgamS 1) (* y (+ (aget _lgamS 2) (* y (+ (aget _lgamS 3) (* y (+ (aget _lgamS 4) (* y (+ (aget _lgamS 5) (* y (aget _lgamS 6))))))))))))))
                ^{:line 289} q (+ 1 (* y (+ (aget _lgamR 1) (* y (+ (aget _lgamR 2) (* y (+ (aget _lgamR 3) (* y (+ (aget _lgamR 4) (* y (+ (aget _lgamR 5) (* y (aget _lgamR 6)))))))))))))]
              (set! lgamma (+ (* 0.5 y) (/ p q)))
              (let [z 1.0] ; Lgamma(1+s) = Log(s) + Lgamma(s)
                (switch i
                  (case [7]
                    (set! z * (+ y 6))
                    (fallthrough))
                  (case [6]
                    (set! z * (+ y 5))
                    (fallthrough))
                  (case [5]
                    (set! z * (+ y 4))
                    (fallthrough))
                  (case [4]
                    (set! z * (+ y 3))
                    (fallthrough))
                  (case [3]
                    (set! z * (+ y 2))
                    (set! lgamma + (Log z)))))))

          (case [(< x Two58)] ; 8 <= x < 2**58
            (let [t (Log x)
                ^{:line 311} z (/ 1 x)
                ^{:line 312} y (* z z)
                ^{:line 313} w (+ (aget _lgamW 0) (* z (+ (aget _lgamW 1) (* y (+ (aget _lgamW 2) (* y (+ (aget _lgamW 3) (* y (+ (aget _lgamW 4) (* y (+ (aget _lgamW 5) (* y (aget _lgamW 6)))))))))))))]
              (set! lgamma (+ (* (- x 0.5) (- t 1)) w))))
          (default ; 2**58 <= x <= Inf
            (set! lgamma (* x (- (Log x) 1)))))

        (when neg
          (set! lgamma (- nadj lgamma)))

        (return)))))



^{:go/end 366} (go/func sinPi "sinPi(x) is a helper function for negative x\n" ^float64 [^float64 x]
  (let [
      ^:const ^{:line 327 :val 4503599627370496} Two52 (<< 1 52) ; 0x4330000000000000 ~4.5036e+15
      ^:const ^:go/grouped ^{:line 328 :val 9007199254740992} Two53 (<< 1 53)] ; 0x4340000000000000 ~9.0072e+15

    (when (< x 0.25)
      (return (- (Sin (* Pi x)))))


    ;; argument reduction
    (let [z (Floor x)
        ^{:line 336 :tag int} n (zero int)]
      (if (!= z x) (do ; inexact
          (set! x (Mod x 2))
          (set! n (conv int (* x 4))))
        (do
          (if (>= x Two53) (do ; x must be even
              (set! x 0)
              (set! n 0))
            (do
              (when (< x Two52)
                (set! z (+ x Two52))) ; exact

              (set! n (conv int (bit-and 1 (Float64bits z))))
              (set! x (conv float64 n))
              (set! n << 2)))))


      (switch n
        (case [0]
          (set! x (Sin (* Pi x))))
        (case [1 2]
          (set! x (Cos (* Pi (- 0.5 x)))))
        (case [3 4]
          (set! x (Sin (* Pi (- 1 x)))))
        (case [5 6]
          (set! x (- (Cos (* Pi (- x 1.5))))))
        (default
          (set! x (Sin (* Pi (- x 2))))))

      (- x))))

(in-ns 'go.math) (go/file "sincos.go" :imports [])

;; Coefficients _sin[] and _cos[] are found in pkg/math/sin.go.








^{:go/end 73} (go/func Sincos "Sincos returns Sin(x), Cos(x).\n\nSpecial cases are:\n\n\tSincos(±0) = ±0, 1\n\tSincos(±Inf) = NaN, NaN\n\tSincos(NaN) = NaN, NaN\n" [^float64 x] :results [^float64 sin ^float64 cos]
  (let [
      ^:const ^{:line 18 :val 0.785398125648498535156M} PI4A 0.785398125648498535156M ; 0x3fe921fb40000000, Pi/4 split into three parts
      ^:const ^:go/grouped ^{:line 19 :val 3.77489470793079817668E-8M} PI4B 3.77489470793079817668E-8M ; 0x3e64442d00000000,
      ^:const ^:go/grouped ^{:line 20 :val 2.69515142907905952645E-15M} PI4C 2.69515142907905952645E-15M] ; 0x3ce8469898cc5170,

    ;; special cases
    (switch
      (case [(== x 0)]
        (return x 1)) ; return ±0.0, 1.0
      (case [(or (IsNaN x) (IsInf x 0))]
        (return (NaN) (NaN))))


    ;; make argument positive
    (let [(values sinSign cosSign) (values false false)]
      (when (< x 0)
        (set! x (- x))
        (set! sinSign true))


      (let [^uint64 j (zero uint64)
          (values ^float64 y ^float64 z) (zero float64)]
        (if (>= x reduceThreshold)
          (set! (values j z) (trigReduce x))
          (do
            (set! j (conv uint64 (* x (/ 4 Pi)))) ; integer part of x/(Pi/4), as integer for tests on the phase angle
            (set! y (conv float64 j)) ; integer part of x/(Pi/4), as float

            (when (== (bit-and j 1) 1) ; map zeros to origin
              (inc! j)
              (inc! y))

            (set! j bit-and 7) ; octant modulo 2Pi radians (360 degrees)
            (set! z (- x (* y PI4A) (* y PI4B) (* y PI4C))))) ; Extended precision modular arithmetic

        (when (> j 3) ; reflect in x axis
          (set! j - 4)
          (set! (values sinSign cosSign) (values (not sinSign) (not cosSign))))

        (when (> j 1)
          (set! cosSign (not cosSign)))


        (let [zz (* z z)]
          (set! cos (+ (- 1.0 (* 0.5 zz)) (* zz zz (+ (* (+ (* (+ (* (+ (* (+ (* (aget _cos 0) zz) (aget _cos 1)) zz) (aget _cos 2)) zz) (aget _cos 3)) zz) (aget _cos 4)) zz) (aget _cos 5)))))
          (set! sin (+ z (* z zz (+ (* (+ (* (+ (* (+ (* (+ (* (aget _sin 0) zz) (aget _sin 1)) zz) (aget _sin 2)) zz) (aget _sin 3)) zz) (aget _sin 4)) zz) (aget _sin 5)))))
          (when (or (== j 1) (== j 2))
            (set! (values sin cos) (values cos sin)))

          (when cosSign
            (set! cos (- cos)))

          (when sinSign
            (set! sin (- sin)))

          (return))))))

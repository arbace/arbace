^{:go/end 117} (go/func Erfinv "Erfinv returns the inverse error function of x.\n\nSpecial cases are:\n\n\tErfinv(1) = +Inf\n\tErfinv(-1) = -Inf\n\tErfinv(x) = NaN if x < -1 or x > 1\n\tErfinv(NaN) = NaN\n" ^float64 [^float64 x]
  ;; special cases
  (when (or (IsNaN x) (<= x -1) (>= x 1))
    (when (or (== x -1) (== x 1))
      (return (Inf (conv int x))))

    (return (NaN)))


  (let [sign false]
    (when (< x 0)
      (set! x (- x))
      (set! sign true))


    (let [^float64 ans (zero float64)]
      (if (<= x 0.85) ; |x| <= 0.85
        (let [r (- 0.180625 (* 0.25 x x))
            ^{:line 95} z1 (+ (* (+ (* (+ (* (+ (* (+ (* (+ (* (+ (* a7 r) a6) r) a5) r) a4) r) a3) r) a2) r) a1) r) a0)
            ^{:line 96} z2 (+ (* (+ (* (+ (* (+ (* (+ (* (+ (* (+ (* b7 r) b6) r) b5) r) b4) r) b3) r) b2) r) b1) r) b0)]
          (set! ans (/ (* x z1) z2)))

        (let [(values ^float64 z1 ^float64 z2) (zero float64)
            ^{:line 100} r (Sqrt (- Ln2 (Log (- 1.0 x))))]
          (if (<= r 5.0) (do
              (set! r - 1.6)
              (set! z1 (+ (* (+ (* (+ (* (+ (* (+ (* (+ (* (+ (* c7 r) c6) r) c5) r) c4) r) c3) r) c2) r) c1) r) c0))
              (set! z2 (+ (* (+ (* (+ (* (+ (* (+ (* (+ (* (+ (* d7 r) d6) r) d5) r) d4) r) d3) r) d2) r) d1) r) d0)))
            (do
              (set! r - 5.0)
              (set! z1 (+ (* (+ (* (+ (* (+ (* (+ (* (+ (* (+ (* e7 r) e6) r) e5) r) e4) r) e3) r) e2) r) e1) r) e0))
              (set! z2 (+ (* (+ (* (+ (* (+ (* (+ (* (+ (* (+ (* f7 r) f6) r) f5) r) f4) r) f3) r) f2) r) f1) r) f0))))

          (set! ans (/ z1 z2))))


      (when sign
        (return (- ans)))

      ^{:line 116} ans)))










^{:go/end 129} (go/func Erfcinv "Erfcinv returns the inverse of [Erfc](x).\n\nSpecial cases are:\n\n\tErfcinv(0) = +Inf\n\tErfcinv(2) = -Inf\n\tErfcinv(x) = NaN if x < 0 or x > 2\n\tErfcinv(NaN) = NaN\n" ^float64 [^float64 x]
  (Erfinv (- 1 x)))

(in-ns 'go.math) (go/file "pow10.go" :imports [])


(go/var ^{:doc "pow10tab stores the pre-computed values 10**i for i < 32.\n"} pow10tab ^{:go/breaks [2 12 22 32]} (lit (array ... float64)
    1.0 10.0 100.0 1000.0 10000.0 100000.0 1000000.0 1.0E7 1.0E8 1.0E9
    1.0E10 1.0E11 1.0E12 1.0E13 1.0E14 1.0E15 1.0E16 1.0E17 1.0E18 1.0E19
    1.0E20 1.0E21 1.0E22 1.0E23 1.0E24 1.0E25 1.0E26 1.0E27 1.0E28 1.0E29
    1.0E30 1.0E31))



(go/var ^{:doc "pow10postab32 stores the pre-computed value for 10**(i*32) at index i.\n"} pow10postab32 ^{:go/breaks [2]} (lit (array ... float64)
    1.0 1.0E32 1.0E64 1.0E96 1.0E128 1.0E160 1.0E192 1.0E224 1.0E256 1.0E288))



(go/var ^{:doc "pow10negtab32 stores the pre-computed value for 10**(-i*32) at index i.\n"} pow10negtab32 ^{:go/breaks [2]} (lit (array ... float64)
    1.0 1.0E-32 1.0E-64 1.0E-96 1.0E-128 1.0E-160 1.0E-192 1.0E-224 1.0E-256 1.0E-288 1.0E-320))








^{:go/breaks [[7 46]] :go/end 47} (go/func Pow10 "Pow10 returns 10**n, the base-10 exponential of n.\n\nSpecial cases are:\n\n\tPow10(n) =    0 for n < -323\n\tPow10(n) = +Inf for n > 308\n" ^float64 [^int n]
  (when (and (<= 0 n) (<= n 308))
    (return (* (aget pow10postab32 (/ (conv uint n) 32)) (aget pow10tab (% (conv uint n) 32)))))


  (when (and (<= -323 n) (< n 0))
    (return (/ (aget pow10negtab32 (/ (conv uint (- n)) 32)) (aget pow10tab (% (conv uint (- n)) 32)))))


  ;; n < -323 || 308 < n
  (when (> n 0)
    (return (Inf 1)))


  ;; n < -323
  0)

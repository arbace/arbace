(in-ns 'go.math) (go/file "bits.go" :imports [])

(go/const
  ^{:line 8} [^{:val 9221120237041090561} uvnan 0x7FF8000000000001]
  ^{:line 9} [^{:val 9218868437227405312} uvinf 0x7FF0000000000000]
  ^{:line 10} [^{:val 18442240474082181120N} uvneginf 0xFFF0000000000000]
  ^{:line 11} [^{:val 4607182418800017408} uvone 0x3FF0000000000000]
  ^{:line 12} [^{:val 2047} mask 0x7FF]
  ^{:line 13} [^{:val 52} shift (- 64 11 1)]
  ^{:line 14} [^{:val 1023} bias 1023]
  ^{:line 15} [^{:val 9223372036854775808N} signMask (<< 1 63)]
  ^{:line 16} [^{:val 4503599627370495} fracMask (- (<< 1 shift) 1)])



^{:go/end 28} (go/func Inf "Inf returns positive infinity if sign >= 0, negative infinity if sign < 0.\n" ^float64 [^int sign]
  (let [^uint64 v (zero uint64)]
    (if (>= sign 0)
      (set! v uvinf)

      (set! v uvneginf))

    (Float64frombits v)))



^{:go/end 31} (go/func NaN "NaN returns an IEEE 754 “not-a-number” value.\n" ^float64 [] (Float64frombits uvnan))


^{:go/end 40} (go/func IsNaN "IsNaN reports whether f is an IEEE 754 “not-a-number” value.\n" [^float64 f] :results [^bool is]
  ;; IEEE 754 says that only NaNs satisfy f != f.
  ;; To avoid the floating-point hardware, could use:
  ;;	x := Float64bits(f);
  ;;	return uint32(x>>shift)&mask == mask && x != uvinf && x != uvneginf
  (!= f f))






^{:go/end 57} (go/func IsInf "IsInf reports whether f is an infinity, according to sign.\nIf sign > 0, IsInf reports whether f is positive infinity.\nIf sign < 0, IsInf reports whether f is negative infinity.\nIf sign == 0, IsInf reports whether f is either infinity.\n" ^bool [^float64 f ^int sign]
  ;; Test for infinity by comparing against maximum float.
  ;; To avoid the floating-point hardware, could use:
  ;;	x := Float64bits(f);
  ;;	return sign >= 0 && x == uvinf || sign <= 0 && x == uvneginf;
  (cond (== sign 0)
    (set! f (Abs f))
    (< sign 0)
    (set! f (- f)))

  (> f MaxFloat64))




^{:go/end 67} (go/func normalize "normalize returns a normal number y and exponent exp\nsatisfying x == y × 2**exp. It assumes x is finite and non-zero.\n" [^float64 x] :results [^float64 y ^int exp]
  (let [^:const ^{:val 2.2250738585072014E-308M} SmallestNormal 2.2250738585072014E-308] ; 2**-1022
    (when (< (Abs x) SmallestNormal)
      (return (* x (<< 1 52)) -52))

    (return x 0)))

(ns go.math.rand
  (:require [arbace.go :as go]))

(go/package rand
  :path "math/rand"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["exp.go" "normal.go" "rand.go" "rng.go" "zipf.go"]
  :init-order [ke we fe kn wn fn randautoseed randseednop rngCooked]
  :positions :lines)

(load "rand/exp")
(load "rand/normal")
(load "rand/rand")
(load "rand/rng")
(load "rand/zipf")

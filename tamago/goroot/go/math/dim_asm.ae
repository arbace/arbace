(in-ns 'go.math) (go/file "dim_asm.go" :build ["//go:build amd64 || arm64 || loong64 || riscv64 || s390x"] :imports [])

(go/const ^{:val true} haveArchMax true)

(go/func ^:extern archMax ^float64 [^float64 x ^float64 y])

(go/const ^{:val true} haveArchMin true)

(go/func ^:extern archMin ^float64 [^float64 x ^float64 y])

(ns go.math.bits
  (:require [arbace.go :as go]))

(go/package bits
  :path "math/bits"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["bits.go" "bits_errors.go" "bits_tables.go"]
  :init-order [deBruijn32tab deBruijn64tab]
  :positions :lines)

(load "bits/bits")
(load "bits/bits_errors")
(load "bits/bits_tables")

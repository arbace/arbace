      ^:const ^:go/grouped ^{:line 81 :val 0.00140705666955189706048M} R01 0.00140705666955189706048M ; 0x3F570D9F98472C61
      ^:const ^:go/grouped ^{:line 82 :val -0.000015995563108403559752M} R02 -0.000015995563108403559752M ; 0xBEF0C5C6BA169668
      ^:const ^:go/grouped ^{:line 83 :val 4.96727999609584448412E-8M} R03 4.96727999609584448412E-8M ; 0x3E6AAAFA46CA0BD9
      ^:const ^:go/grouped ^{:line 84 :val 0.0191537599538363460805M} S01 0.0191537599538363460805M ; 0x3F939D0B12637E53
      ^:const ^:go/grouped ^{:line 85 :val 0.00018594678558863091556M} S02 0.00018594678558863091556M ; 0x3F285F56B9CDF664
      ^:const ^:go/grouped ^{:line 86 :val 0.00000117718464042623683263M} S03 0.00000117718464042623683263M ; 0x3EB3BFF8333F8498
      ^:const ^:go/grouped ^{:line 87 :val 5.04636257076217042715E-9M} S04 5.04636257076217042715E-9M ; 0x3E35AC88C97DFF2C
      ^:const ^:go/grouped ^{:line 88 :val 1.23542274426137913908E-11M} S05 1.23542274426137913908E-11M] ; 0x3DAB2ACFCFB97ED8

    ;; special cases
    (switch
      (case [(IsNaN x)]
        (return x))
      (case [(or (IsInf x 0) (== x 0))]
        (return 0)))


    (let [sign false]
      (when (< x 0)
        (set! x (- x))
        (set! sign true))

      (when (>= x 2)
        (let [(values s c) (Sincos x)
            ^{:line 105} ss (- (- s) c)

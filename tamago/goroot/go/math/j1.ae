            (if (> x Two129)
              (set! z (/ (* (/ 1 SqrtPi) cc) (Sqrt x)))

              (let [u (pone x)
                  ^{:line 126} v (qone x)]
                (set! z (/ (* (/ 1 SqrtPi) (- (* u cc) (* v ss))) (Sqrt x)))))

            (when sign
              (return (- z)))

            (return z))))

      (when (< x TwoM27) ; |x|<2**-27
        (return (* 0.5 x))) ; inexact if x!=0 necessary

      (let [z (* x x)
          ^{:line 138} r (* z (+ R00 (* z (+ R01 (* z (+ R02 (* z R03)))))))
          ^{:line 139} s (+ 1.0 (* z (+ S01 (* z (+ S02 (* z (+ S03 (* z (+ S04 (* z S05))))))))))]

(in-ns 'go.math) (go/file "signbit.go" :imports [])


^{:go/end 10} (go/func Signbit "Signbit reports whether x is negative or negative zero.\n" ^bool [^float64 x]
  (< (conv int64 (Float64bits x)) 0))

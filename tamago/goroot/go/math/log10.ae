(in-ns 'go.math) (go/file "log10.go" :imports [])



^{:go/end 14} (go/func Log10 "Log10 returns the decimal logarithm of x.\nThe special cases are the same as for [Log].\n" ^float64 [^float64 x]
  (when haveArchLog10
    (return (archLog10 x)))

  (log10 x))


^{:go/end 18} (go/func log10 ^float64 [^float64 x]
  (* (Log x) (/ 1 Ln10)))




^{:go/end 27} (go/func Log2 "Log2 returns the binary logarithm of x.\nThe special cases are the same as for [Log].\n" ^float64 [^float64 x]
  (when haveArchLog2
    (return (archLog2 x)))

  (log2 x))


^{:go/end 37} (go/func log2 ^float64 [^float64 x]
  (let [(values frac exp) (Frexp x)]
    ;; Make sure exact powers of two give an exact answer.
    ;; Don't depend on Log(0.5)*(1/Ln2)+exp being exactly exp-1.
    (when (== frac 0.5)
      (return (conv float64 (- exp 1))))

    (+ (* (Log frac) (/ 1 Ln2)) (conv float64 exp))))

(in-ns 'go.math) (go/file "asin.go" :imports [])

;; /*
;; Floating-point arcsine and arccosine.
;; 
;; They are implemented by computing the arctangent
;; after appropriate range reduction.
;; */







^{:go/end 25} (go/func Asin "Asin returns the arcsine, in radians, of x.\n\nSpecial cases are:\n\n\tAsin(±0) = ±0\n\tAsin(x) = NaN if x < -1 or x > 1\n" ^float64 [^float64 x]
  (when haveArchAsin
    (return (archAsin x)))

  (asin x))


^{:go/end 51} (go/func asin ^float64 [^float64 x]
  (when (== x 0)
    (return x)) ; special case

  (let [sign false]
    (when (< x 0)
      (set! x (- x))
      (set! sign true))

    (when (> x 1)
      (return (NaN))) ; special case


    (let [temp (Sqrt (- 1 (* x x)))]
      (if (> x 0.7)
        (set! temp (- (/ Pi 2) (satan (/ temp x))))

        (set! temp (satan (/ x temp))))


      (when sign
        (set! temp (- temp)))

      ^{:line 50} temp)))







^{:go/end 63} (go/func Acos "Acos returns the arccosine, in radians, of x.\n\nSpecial case is:\n\n\tAcos(x) = NaN if x < -1 or x > 1\n" ^float64 [^float64 x]
  (when haveArchAcos
    (return (archAcos x)))

  (acos x))


^{:go/end 67} (go/func acos ^float64 [^float64 x]
  (- (/ Pi 2) (Asin x)))

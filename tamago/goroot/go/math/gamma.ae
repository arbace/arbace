(in-ns 'go.math) (go/file "gamma.go" :imports [])

;; The original C code, the long comment, and the constants
;; below are from http://netlib.sandia.gov/cephes/cprob/gamma.c.
;; The go code is a simplified version of the original C.
;;
;;      tgamma.c
;;
;;      Gamma function
;;
;; SYNOPSIS:
;;
;; double x, y, tgamma();
;; extern int signgam;
;;
;; y = tgamma( x );
;;
;; DESCRIPTION:
;;
;; Returns gamma function of the argument. The result is
;; correctly signed, and the sign (+1 or -1) is also
;; returned in a global (extern) variable named signgam.
;; This variable is also filled in by the logarithmic gamma
;; function lgamma().
;;
;; Arguments |x| <= 34 are reduced by recurrence and the function
;; approximated by a rational function of degree 6/7 in the
;; interval (2,3).  Large arguments are handled by Stirling's
;; formula. Large negative arguments are made positive using
;; a reflection formula.
;;
;; ACCURACY:
;;
;;                      Relative error:
;; arithmetic   domain     # trials      peak         rms
;;    DEC      -34, 34      10000       1.3e-16     2.5e-17
;;    IEEE    -170,-33      20000       2.3e-15     3.3e-16
;;    IEEE     -33,  33     20000       9.4e-16     2.2e-16
;;    IEEE      33, 171.6   20000       2.3e-15     3.2e-16
;;
;; Error for arguments outside the test range will be larger
;; owing to error amplification by the exponential function.
;;
;; Cephes Math Library Release 2.8:  June, 2000
;; Copyright 1984, 1987, 1989, 1992, 2000 by Stephen L. Moshier
;;
;; The readme file at http://netlib.sandia.gov/cephes/ says:
;;    Some software in this archive may be from the book _Methods and
;; Programs for Mathematical Functions_ (Prentice-Hall or Simon & Schuster
;; International, 1989) or from the Cephes Mathematical Library, a
;; commercial product. In either event, it is copyrighted by the author.
;; What you see here may be used freely but it comes with no support or
;; guarantee.
;;
;;   The two known misprints in the book are repaired here in the
;; source listings for the gamma function and the incomplete beta
;; integral.
;;
;;   Stephen L. Moshier
;;   moshier@na-net.ornl.gov

(go/var _gamP ^{:go/breaks [2 3 4 5 6 7 8]} (lit (array ... float64)
    0.000160119522476751861407M
    0.00119135147006586384913M
    0.0104213797561761569935M
    0.0476367800457137231464M
    0.20744822764843597515M
    0.494214826801497100753M
    0.999999999999999996796M))

(go/var _gamQ ^{:go/breaks [2 3 4 5 6 7 8 9]} (lit (array ... float64)
    -0.0000231581873324120129819M
    0.000539605580493303397842M
    -0.00445641913851797240494M
    0.0118139785222060435552M
    0.0358236398605498653373M
    -0.234591795718243348568M
    0.0714304917030273074085M
    1.0000000000000000032M))

(go/var _gamS ^{:go/breaks [2 3 4 5 6]} (lit (array ... float64)
    0.000787311395793093628397M
    -0.00022954996161337812638M
    -0.00268132617805781232825M
    0.0034722222160545866731M
    0.0833333333333482257126M))









^{:go/end 119} (go/func stirling "Gamma function computed by Stirling's formula.\nThe pair of results must be multiplied together to get the actual answer.\nThe multiplication is left to the caller so that, if careful, the caller can avoid\ninfinity for 172 <= x <= 180.\nThe polynomial is valid for 33 <= x <= 172; larger values are only used\nin reciprocal and produce denormalized floats. The lower precision there\nmasks any imprecision in the polynomial.\n" [^float64 x] :results [float64 float64]
  (when (> x 200)
    (return (Inf 1) 1))

  (let [
      ^:const ^{:line 105 :val 2.506628274631000502417M} SqrtTwoPi 2.506628274631000502417M
      ^:const ^:go/grouped ^{:line 106 :val 143.01608} MaxStirling 143.01608

      ^{:line 108} w (/ 1 x)]
    (set! w (+ 1 (* w (+ (* (+ (* (+ (* (+ (* (aget _gamS 0) w) (aget _gamS 1)) w) (aget _gamS 2)) w) (aget _gamS 3)) w) (aget _gamS 4)))))
    (let [y1 (Exp x)
        ^{:line 111} y2 1.0]
      (if (> x MaxStirling) ; avoid Pow() overflow
        (let [v (Pow x (- (* 0.5 x) 0.25))]
          (set! (values y1 y2) (values v (/ v y1))))

        (set! y1 (/ (Pow x (- x 0.5)) y1)))

      (return y1 (* SqrtTwoPi w y2)))))












^{:go/end 214} (go/func Gamma "Gamma returns the Gamma function of x.\n\nSpecial cases are:\n\n\tGamma(+Inf) = +Inf\n\tGamma(+0) = +Inf\n\tGamma(-0) = -Inf\n\tGamma(x) = NaN for integer x < 0\n\tGamma(-Inf) = NaN\n\tGamma(NaN) = NaN\n" ^float64 [^float64 x]
  (let [^:const ^{:val 0.57721566490153286060651209008240243104215933593992M} Euler 0.57721566490153286060651209008240243104215933593992M] ; A001620
    ;; special cases
    (switch
      (case [(or (isNegInt x) (IsInf x -1) (IsNaN x))]
        (return (NaN)))
      (case [(IsInf x 1)]
        (return (Inf 1)))
      (case [(== x 0)]
        (when (Signbit x)
          (return (Inf -1)))

        (return (Inf 1))))

    (let [q (Abs x)
        ^{:line 146} p (Floor q)]
      (when (> q 33)
        (when (>= x 0)
          (let [(values y1 y2) (stirling x)]
            (return (* y1 y2))))

        ;; Note: x is negative but (checked above) not a negative integer,
        ;; so x must be small enough to be in range for conversion to int64.
        ;; If |x| were >= 2⁶³ it would have to be an integer.
        (let [signgam 1]
          (when [ip (conv int64 p)] (== (bit-and ip 1) 0)
            (set! signgam -1))

          (let [z (- q p)]
            (when (> z 0.5)
              (set! p (+ p 1))
              (set! z (- q p)))

            (set! z (* q (Sin (* Pi z))))
            (when (== z 0)
              (return (Inf signgam)))

            (let [(values sq1 sq2) (stirling q)
                ^{:line 169} absz (Abs z)
                ^{:line 170} d (* absz sq1 sq2)]
              (if (IsInf d 0)
                (set! z (/ Pi absz sq1 sq2))

                (set! z (/ Pi d)))

              (return (* (conv float64 signgam) z))))))


      ;; Reduce argument
      (let [z 1.0]
        (while (>= x 3)
          (set! x (- x 1))
          (set! z (* z x)))

        (while (< x 0)
          (when (> x -1.0E-9)
            (goto :small))

          (set! z (/ z x))
          (set! x (+ x 1)))

        (while (< x 2)
          (when (< x 1.0E-9)
            (goto :small))

          (set! z (/ z x))
          (set! x (+ x 1)))


        (when (== x 2)
          (return z))


        (set! x (- x 2))
        (set! p (+ (* (+ (* (+ (* (+ (* (+ (* (+ (* x (aget _gamP 0)) (aget _gamP 1)) x) (aget _gamP 2)) x) (aget _gamP 3)) x) (aget _gamP 4)) x) (aget _gamP 5)) x) (aget _gamP 6)))
        (set! q (+ (* (+ (* (+ (* (+ (* (+ (* (+ (* (+ (* x (aget _gamQ 0)) (aget _gamQ 1)) x) (aget _gamQ 2)) x) (aget _gamQ 3)) x) (aget _gamQ 4)) x) (aget _gamQ 5)) x) (aget _gamQ 6)) x) (aget _gamQ 7)))
        (return (/ (* z p) q))

        (label :small
          (when (== x 0)
            (return (Inf 1))))

        (/ z (* (+ 1 (* Euler x)) x))))))


^{:go/breaks [[4 221]] :go/end 222} (go/func isNegInt ^bool [^float64 x]
  (when (< x 0)
    (let [(values _ xf) (Modf x)]
      (return (== xf 0))))

  false)

(in-ns 'go.math) (go/file "tan.go" :imports [])

;; /*
;; Floating-point tangent.
;; */

;; The original C code, the long comment, and the constants
;; below were from http://netlib.sandia.gov/cephes/cmath/sin.c,
;; available from http://www.netlib.org/cephes/cmath.tgz.
;; The go code is a simplified version of the original C.
;;
;;      tan.c
;;
;;      Circular tangent
;;
;; SYNOPSIS:
;;
;; double x, y, tan();
;; y = tan( x );
;;
;; DESCRIPTION:
;;
;; Returns the circular tangent of the radian argument x.
;;
;; Range reduction is modulo pi/4.  A rational function
;;       x + x**3 P(x**2)/Q(x**2)
;; is employed in the basic interval [0, pi/4].
;;
;; ACCURACY:
;;                      Relative error:
;; arithmetic   domain     # trials      peak         rms
;;    DEC      +-1.07e9      44000      4.1e-17     1.0e-17
;;    IEEE     +-1.07e9      30000      2.9e-16     8.1e-17
;;
;; Partial loss of accuracy begins to occur at x = 2**30 = 1.074e9.  The loss
;; is not gradual, but jumps suddenly to about 1 part in 10e7.  Results may
;; be meaningless for x > 2**49 = 5.6e14.
;; [Accuracy loss statement from sin.go comments.]
;;
;; Cephes Math Library Release 2.8:  June, 2000
;; Copyright 1984, 1987, 1989, 1992, 2000 by Stephen L. Moshier
;;
;; The readme file at http://netlib.sandia.gov/cephes/ says:
;;    Some software in this archive may be from the book _Methods and
;; Programs for Mathematical Functions_ (Prentice-Hall or Simon & Schuster
;; International, 1989) or from the Cephes Mathematical Library, a
;; commercial product. In either event, it is copyrighted by the author.
;; What you see here may be used freely but it comes with no support or
;; guarantee.
;;
;;   The two known misprints in the book are repaired here in the
;; source listings for the gamma function and the incomplete beta
;; integral.
;;
;;   Stephen L. Moshier
;;   moshier@na-net.ornl.gov


(go/var ^{:doc "tan coefficients\n"} _tanP ^{:go/breaks [2 3 4]} (lit (array ... float64)
    -13093.6939181383777646M ; 0xc0c992d8d24f3f38
    1153516.6483858741614M ; 0x413199eca5fc9ddd
    -17956525.1976484877988M)) ; 0xc1711fead3299176

(go/var _tanQ ^{:go/breaks [2 3 4 5 6]} (lit (array ... float64)
    1.0
    13681.2963470692954678M ; 0x40cab8a5eeb36572
    -1320892.34440210967447M ; 0xc13427bc582abc96
    25008380.1823357915839M ; 0x4177d98fc2ead8ef
    -53869575.5929454629881M)) ; 0xc189afe03cbe5a31









^{:go/end 88} (go/func Tan "Tan returns the tangent of the radian argument x.\n\nSpecial cases are:\n\n\tTan(±0) = ±0\n\tTan(±Inf) = NaN\n\tTan(NaN) = NaN\n" ^float64 [^float64 x]
  (when haveArchTan
    (return (archTan x)))

  (tan x))


^{:go/end 140} (go/func tan ^float64 [^float64 x]
  (let [
      ^:const ^{:line 92 :val 0.785398125648498535156M} PI4A 0.785398125648498535156M ; 0x3fe921fb40000000, Pi/4 split into three parts
      ^:const ^:go/grouped ^{:line 93 :val 3.77489470793079817668E-8M} PI4B 3.77489470793079817668E-8M ; 0x3e64442d00000000,
      ^:const ^:go/grouped ^{:line 94 :val 2.69515142907905952645E-15M} PI4C 2.69515142907905952645E-15M] ; 0x3ce8469898cc5170,

    ;; special cases
    (switch
      (case [(or (== x 0) (IsNaN x))]
        (return x)) ; return ±0 || NaN()
      (case [(IsInf x 0)]
        (return (NaN))))


    ;; make argument positive but save the sign
    (let [sign false]
      (when (< x 0)
        (set! x (- x))
        (set! sign true))

      (let [^uint64 j (zero uint64)
          (values ^float64 y ^float64 z) (zero float64)]
        (if (>= x reduceThreshold)
          (set! (values j z) (trigReduce x))
          (do
            (set! j (conv uint64 (* x (/ 4 Pi)))) ; integer part of x/(Pi/4), as integer for tests on the phase angle
            (set! y (conv float64 j)) ; integer part of x/(Pi/4), as float

            ;; /* map zeros and singularities to origin */
            (when (== (bit-and j 1) 1)
              (inc! j)
              (inc! y))


            (set! z (- x (* y PI4A) (* y PI4B) (* y PI4C)))))

        (let [zz (* z z)]

          (if (> zz 1.0E-14)
            (set! y (+ z (* z (/ (* zz (+ (* (+ (* (aget _tanP 0) zz) (aget _tanP 1)) zz) (aget _tanP 2))) (+ (* (+ (* (+ (* (+ zz (aget _tanQ 1)) zz) (aget _tanQ 2)) zz) (aget _tanQ 3)) zz) (aget _tanQ 4))))))

            (set! y z))

          (when (== (bit-and j 2) 2)
            (set! y (/ -1 y)))

          (when sign
            (set! y (- y)))

          ^{:line 139} y)))))

^{:go/end 31} (go/func Cbrt "Cbrt returns the cube root of x.\n\nSpecial cases are:\n\n\tCbrt(±0) = ±0\n\tCbrt(±Inf) = ±Inf\n\tCbrt(NaN) = NaN\n" ^float64 [^float64 x]
  (when haveArchCbrt
    (return (archCbrt x)))

  (cbrt x))


^{:go/end 85} (go/func cbrt ^float64 [^float64 x]
  (let [
      ^:const ^{:line 35 :val 715094163} B1 715094163 ; (682-0.03306235651)*2**20
      ^:const ^:go/grouped ^{:line 36 :val 696219795} B2 696219795 ; (664-0.03306235651)*2**20
      ^:const ^:go/grouped ^{:line 37 :val 0.542857142857142815906M} C 0.542857142857142815906M ; 19/35     = 0x3FE15F15F15F15F1
      ^:const ^:go/grouped ^{:line 38 :val -0.70530612244897961105M} D -0.70530612244897961105M ; -864/1225 = 0xBFE691DE2532C834
      ^:const ^:go/grouped ^{:line 39 :val 1.41428571428571436819M} E 1.41428571428571436819M ; 99/70     = 0x3FF6A0EA0EA0EA0F
      ^:const ^:go/grouped ^{:line 40 :val 1.6071428571428572063M} F 1.6071428571428572063M ; 45/28     = 0x3FF9B6DB6DB6DB6E
      ^:const ^:go/grouped ^{:line 41 :val 0.357142857142857150787M} G 0.357142857142857150787M ; 5/14      = 0x3FD6DB6DB6DB6DB7
      ^:const ^:go/grouped ^{:line 42 :val 2.22507385850720138309E-308M} SmallestNormal 2.22507385850720138309E-308M] ; 2**-1022  = 0x0010000000000000

    ;; special cases
    (switch
      (case [(or (== x 0) (IsNaN x) (IsInf x 0))]
        (return x)))


    (let [sign false]
      (when (< x 0)
        (set! x (- x))
        (set! sign true))


      ;; rough cbrt to 5 bits
      (let [t (Float64frombits (+ (/ (Float64bits x) 3) (<< B1 32)))]
        (when (< x SmallestNormal)
          ;; subnormal number
          (set! t (conv float64 (<< 1 54))) ; set t= 2**54
          (set! t * x)
          (set! t (Float64frombits (+ (/ (Float64bits t) 3) (<< B2 32)))))


        ;; new cbrt to 23 bits
        (let [r (/ (* t t) x)
            ^{:line 67} s (+ C (* r t))]
          (set! t * (+ G (/ F (+ s E (/ D s)))))

          ;; chop to 22 bits, make larger than cbrt(x)
          (set! t (Float64frombits (+ (bit-and (Float64bits t) (<< 0xFFFFFFFFC 28)) (<< 1 30))))

          ;; one step newton iteration to 53 bits with error less than 0.667ulps
          (set! s (* t t)) ; t*t is exact
          (set! r (/ x s))
          (let [w (+ t t)]
            (set! r (/ (- r t) (+ w r))) ; r-s is exact
            (set! t (+ t (* t r)))

            ;; restore the sign bit
            (when sign
              (set! t (- t)))

            ^{:line 84} t))))))

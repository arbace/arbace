(in-ns 'go.math) (go/file "jn.go" :imports [])

;; /*
;; Bessel function of the first and second kinds of order n.
;; */

;; The original C code and the long comment below are
;; from FreeBSD's /usr/src/lib/msun/src/e_jn.c and
;; came with this notice. The go code is a simplified
;; version of the original C.
;;
;; ====================================================
;; Copyright (C) 1993 by Sun Microsystems, Inc. All rights reserved.
;;
;; Developed at SunPro, a Sun Microsystems, Inc. business.
;; Permission to use, copy, modify, and distribute this
;; software is freely granted, provided that this notice
;; is preserved.
;; ====================================================
;;
;; __ieee754_jn(n, x), __ieee754_yn(n, x)
;; floating point Bessel's function of the 1st and 2nd kind
;; of order n
;;
;; Special cases:
;;      y0(0)=y1(0)=yn(n,0) = -inf with division by zero signal;
;;      y0(-ve)=y1(-ve)=yn(n,-ve) are NaN with invalid signal.
;; Note 2. About jn(n,x), yn(n,x)
;;      For n=0, j0(x) is called,
;;      for n=1, j1(x) is called,
;;      for n<x, forward recursion is used starting
;;      from values of j0(x) and j1(x).
;;      for n>x, a continued fraction approximation to
;;      j(n,x)/j(n-1,x) is evaluated and then backward
;;      recursion is used starting from a supposed value
;;      for j(n,x). The resulting value of j(0,x) is
;;      compared with the actual value to correct the
;;      supposed value of j(n,x).
;;
;;      yn(n,x) is similar in all respects, except
;;      that forward recursion is used for all
;;      values of n>1.







^{:go/end 224} (go/func Jn "Jn returns the order-n Bessel function of the first kind.\n\nSpecial cases are:\n\n\tJn(n, ±Inf) = 0\n\tJn(n, NaN) = NaN\n" ^float64 [^int n ^float64 x]
  (let [
      ^:const ^{:line 56 :val 1.86264514923095703125E-9M} TwoM29 (/ 1.0 (<< 1 29)) ; 2**-29 0x3e10000000000000
      ^:const ^:go/grouped ^{:line 57 :val 8148143905337944345073782753637512644205873574663745002544561797417525199053346824733589504N} Two302 (<< 1 302)] ; 2**302 0x52D0000000000000

    ;; special cases
    (switch
      (case [(IsNaN x)]
        (return x))
      (case [(IsInf x 0)]
        (return 0)))

    ;; J(-n, x) = (-1)**n * J(n, x), J(n, -x) = (-1)**n * J(n, x)
    ;; Thus, J(-n, x) = J(n, -x)

    (when (== n 0)
      (return (J0 x)))

    (when (== x 0)
      (return 0))

    (when (< n 0)
      (set! (values n x) (values (- n) (- x))))

    (when (== n 1)
      (return (J1 x)))

    (let [sign false]
      (when (< x 0)
        (set! x (- x))
        (when (== (bit-and n 1) 1)
          (set! sign true))) ; odd n and negative x


      (let [^float64 b (zero float64)]
        (if (<= (conv float64 n) x)
          ;; Safe to use J(n+1,x)=2n/x *J(n,x)-J(n-1,x)
          (if (>= x Two302) ; x > 2**302

            ;; (x >> n**2)
            ;;          Jn(x) = cos(x-(2n+1)*pi/4)*sqrt(2/x*pi)
            ;;          Yn(x) = sin(x-(2n+1)*pi/4)*sqrt(2/x*pi)
            ;;          Let s=sin(x), c=cos(x),
            ;;              xn=x-(2n+1)*pi/4, sqt2 = sqrt(2),then
            ;;
            ;;                 n    sin(xn)*sqt2    cos(xn)*sqt2
            ;;              ----------------------------------
            ;;                 0     s-c             c+s
            ;;                 1    -s-c            -c+s
            ;;                 2    -s+c            -c-s
            ;;                 3     s+c             c-s

            (let [^float64 temp (zero float64)]
              (switch [(values s c) (Sincos x)] (bit-and n 3)
                (case [0]
                  (set! temp (+ c s)))
                (case [1]
                  (set! temp (+ (- c) s)))
                (case [2]
                  (set! temp (- (- c) s)))
                (case [3]
                  (set! temp (- c s))))

              (set! b (/ (* (/ 1 SqrtPi) temp) (Sqrt x))))
            (do
              (set! b (J1 x))
              (for [(values i a) (values 1 (J0 x))] (< i n) (inc! i)
                (set! (values a b) (values b (- (* b (/ (conv float64 (+ i i)) x)) a)))))) ; avoid underflow


          (do
            (if (< x TwoM29) ; x < 2**-29
              ;; x is tiny, return the first Taylor expansion of J(n,x)
              ;; J(n,x) = 1/n!*(x/2)**n  - ...

              (if (> n 33) ; underflow
                (set! b 0)

                (let [temp (* x 0.5)]
                  (set! b temp)
                  (let [a 1.0]
                    (for [i 2] (<= i n) (inc! i)
                      (set! a * (conv float64 i)) ; a = n!
                      (set! b * temp)) ; b = (x/2)**n

                    (set! b / a))))


              ;; use backward recurrence
              ;;                      x      x**2      x**2
              ;;  J(n,x)/J(n-1,x) =  ----   ------   ------   .....
              ;;                      2n  - 2(n+1) - 2(n+2)
              ;;
              ;;                      1      1        1
              ;;  (for large x)   =  ----  ------   ------   .....
              ;;                      2n   2(n+1)   2(n+2)
              ;;                      -- - ------ - ------ -
              ;;                       x     x         x
              ;;
              ;; Let w = 2n/x and h=2/x, then the above quotient
              ;; is equal to the continued fraction:
              ;;                  1
              ;;      = -----------------------
              ;;                     1
              ;;         w - -----------------
              ;;                        1
              ;;              w+h - ---------
              ;;                     w+2h - ...
              ;;
              ;; To determine how many terms needed, let
              ;; Q(0) = w, Q(1) = w(w+h) - 1,
              ;; Q(k) = (w+k*h)*Q(k-1) - Q(k-2),
              ;; When Q(k) > 1e4	good for single
              ;; When Q(k) > 1e9	good for double
              ;; When Q(k) > 1e17	good for quadruple

              ;; determine k
              (let [w (/ (conv float64 (+ n n)) x)
                  ^{:line 172} h (/ 2 x)
                  ^{:line 173} q0 w
                  ^{:line 174} z (+ w h)
                  ^{:line 175} q1 (- (* w z) 1)
                  ^{:line 176} k 1]
                (while (< q1 1.0E9)
                  (inc! k)
                  (set! z + h)
                  (set! (values q0 q1) (values q1 (- (* z q1) q0))))

                (let [m (+ n n)
                    ^{:line 183} t 0.0]
                  (for [i (* 2 (+ n k))] (>= i m) (set! i - 2)
                    (set! t (/ 1 (- (/ (conv float64 i) x) t))))

                  (let [a t]
                    (set! b 1)
                    ;;  estimate log((2/x)**n*n!) = n*log(2/x)+n*ln(n)
                    ;;  Hence, if n*(log(2n/x)) > ...
                    ;;  single 8.8722839355e+01
                    ;;  double 7.09782712893383973096e+02
                    ;;  long double 1.1356523406294143949491931077970765006170e+04
                    ;;  then recurrent value may overflow and the result is
                    ;;  likely underflow to zero

                    (let [tmp (conv float64 n)
                        ^{:line 198} v (/ 2 x)]
                      (set! tmp (* tmp (Log (Abs (* v tmp)))))
                      (if (< tmp 709.782712893383973096M)
                        (for [i (- n 1)] (> i 0) (dec! i)
                          (let [di (conv float64 (+ i i))]
                            (set! (values a b) (values b (- (/ (* b di) x) a)))))


                        (for [i (- n 1)] (> i 0) (dec! i)
                          (let [di (conv float64 (+ i i))]
                            (set! (values a b) (values b (- (/ (* b di) x) a)))
                            ;; scale b to avoid spurious overflow
                            (when (> b 1.0E100)
                              (set! a / b)
                              (set! t / b)
                              (set! b 1)))))



                      (set! b (/ (* t (J0 x)) b)))))))))


        (when sign
          (return (- b)))

        ^{:line 223} b))))











^{:go/end 306} (go/func Yn "Yn returns the order-n Bessel function of the second kind.\n\nSpecial cases are:\n\n\tYn(n, +Inf) = 0\n\tYn(n ≥ 0, 0) = -Inf\n\tYn(n < 0, 0) = +Inf if n is odd, -Inf if n is even\n\tYn(n, x < 0) = NaN\n\tYn(n, NaN) = NaN\n" ^float64 [^int n ^float64 x]
  (let [^:const ^{:val 8148143905337944345073782753637512644205873574663745002544561797417525199053346824733589504N} Two302 (<< 1 302)] ; 2**302 0x52D0000000000000
    ;; special cases
    (switch
      (case [(or (< x 0) (IsNaN x))]
        (return (NaN)))
      (case [(IsInf x 1)]
        (return 0)))


    (when (== n 0)
      (return (Y0 x)))

    (when (== x 0)
      (when (and (< n 0) (== (bit-and n 1) 1))
        (return (Inf 1)))

      (return (Inf -1)))

    (let [sign false]
      (when (< n 0)
        (set! n (- n))
        (when (== (bit-and n 1) 1)
          (set! sign true))) ; sign true if n < 0 && |n| odd


      (when (== n 1)
        (when sign
          (return (- (Y1 x))))

        (return (Y1 x)))

      (let [^float64 b (zero float64)]
        (if (>= x Two302) ; x > 2**302
          ;; (x >> n**2)
          ;;	    Jn(x) = cos(x-(2n+1)*pi/4)*sqrt(2/x*pi)
          ;;	    Yn(x) = sin(x-(2n+1)*pi/4)*sqrt(2/x*pi)
          ;;	    Let s=sin(x), c=cos(x),
          ;;		xn=x-(2n+1)*pi/4, sqt2 = sqrt(2),then
          ;;
          ;;		   n	sin(xn)*sqt2	cos(xn)*sqt2
          ;;		----------------------------------
          ;;		   0	 s-c		 c+s
          ;;		   1	-s-c 		-c+s
          ;;		   2	-s+c		-c-s
          ;;		   3	 s+c		 c-s

          (let [^float64 temp (zero float64)]
            (switch [(values s c) (Sincos x)] (bit-and n 3)
              (case [0]
                (set! temp (- s c)))
              (case [1]
                (set! temp (- (- s) c)))
              (case [2]
                (set! temp (+ (- s) c)))
              (case [3]
                (set! temp (+ s c))))

            (set! b (/ (* (/ 1 SqrtPi) temp) (Sqrt x))))

          (let [a (Y0 x)]
            (set! b (Y1 x))
            ;; quit if b is -inf
            (for [i 1] (and (< i n) (not (IsInf b -1))) (inc! i)
              (set! (values a b) (values b (- (* (/ (conv float64 (+ i i)) x) b) a))))))


        (when sign
          (return (- b)))

        ^{:line 305} b))))

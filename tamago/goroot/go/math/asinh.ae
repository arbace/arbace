(in-ns 'go.math) (go/file "asinh.go" :imports [])

;; The original C code, the long comment, and the constants
;; below are from FreeBSD's /usr/src/lib/msun/src/s_asinh.c
;; and came with this notice. The go code is a simplified
;; version of the original C.
;;
;; ====================================================
;; Copyright (C) 1993 by Sun Microsystems, Inc. All rights reserved.
;;
;; Developed at SunPro, a Sun Microsystems, Inc. business.
;; Permission to use, copy, modify, and distribute this
;; software is freely granted, provided that this notice
;; is preserved.
;; ====================================================
;;
;;
;; asinh(x)
;; Method :
;;	Based on
;;	        asinh(x) = sign(x) * log [ |x| + sqrt(x*x+1) ]
;;	we have
;;	asinh(x) := x  if  1+x*x=1,
;;	         := sign(x)*(log(x)+ln2) for large |x|, else
;;	         := sign(x)*log(2|x|+1/(|x|+sqrt(x*x+1))) if|x|>2, else
;;	         := sign(x)*log1p(|x| + x**2/(1 + sqrt(1+x**2)))
;;








^{:go/end 45} (go/func Asinh "Asinh returns the inverse hyperbolic sine of x.\n\nSpecial cases are:\n\n\tAsinh(±0) = ±0\n\tAsinh(±Inf) = ±Inf\n\tAsinh(NaN) = NaN\n" ^float64 [^float64 x]
  (when haveArchAsinh
    (return (archAsinh x)))

  (asinh x))


^{:go/end 77} (go/func asinh ^float64 [^float64 x]
  (let [
      ^:const ^{:line 49 :val 0.693147180559945286227M} Ln2 0.693147180559945286227M ; 0x3FE62E42FEFA39EF
      ^:const ^:go/grouped ^{:line 50 :val 3.7252902984619140625E-9M} NearZero (/ 1.0 (<< 1 28)) ; 2**-28
      ^:const ^:go/grouped ^{:line 51 :val 268435456} Large (<< 1 28)] ; 2**28

    ;; special cases
    (when (or (IsNaN x) (IsInf x 0))
      (return x))

    (let [sign false]
      (when (< x 0)
        (set! x (- x))
        (set! sign true))

      (let [^float64 temp (zero float64)]
        (switch
          (case [(> x Large)]
            (set! temp (+ (Log x) Ln2))) ; |x| > 2**28
          (case [(> x 2)]
            (set! temp (Log (+ (* 2 x) (/ 1 (+ (Sqrt (+ (* x x) 1)) x)))))) ; 2**28 > |x| > 2.0
          (case [(< x NearZero)]
            (set! temp x)) ; |x| < 2**-28
          (default
            (set! temp (Log1p (+ x (/ (* x x) (+ 1 (Sqrt (+ 1 (* x x)))))))))) ; 2.0 > |x| > 2**-28

        (when sign
          (set! temp (- temp)))

        ^{:line 76} temp))))

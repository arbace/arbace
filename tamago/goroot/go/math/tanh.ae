(in-ns 'go.math) (go/file "tanh.go" :imports [])

;; The original C code, the long comment, and the constants
;; below were from http://netlib.sandia.gov/cephes/cmath/sin.c,
;; available from http://www.netlib.org/cephes/cmath.tgz.
;; The go code is a simplified version of the original C.
;;      tanh.c
;;
;;      Hyperbolic tangent
;;
;; SYNOPSIS:
;;
;; double x, y, tanh();
;;
;; y = tanh( x );
;;
;; DESCRIPTION:
;;
;; Returns hyperbolic tangent of argument in the range MINLOG to MAXLOG.
;;      MAXLOG = 8.8029691931113054295988e+01 = log(2**127)
;;      MINLOG = -8.872283911167299960540e+01 = log(2**-128)
;;
;; A rational function is used for |x| < 0.625.  The form
;; x + x**3 P(x)/Q(x) of Cody & Waite is employed.
;; Otherwise,
;;      tanh(x) = sinh(x)/cosh(x) = 1  -  2/(exp(2x) + 1).
;;
;; ACCURACY:
;;
;;                      Relative error:
;; arithmetic   domain     # trials      peak         rms
;;    IEEE      -2,2        30000       2.5e-16     5.8e-17
;;
;; Cephes Math Library Release 2.8:  June, 2000
;; Copyright 1984, 1987, 1989, 1992, 2000 by Stephen L. Moshier
;;
;; The readme file at http://netlib.sandia.gov/cephes/ says:
;;    Some software in this archive may be from the book _Methods and
;; Programs for Mathematical Functions_ (Prentice-Hall or Simon & Schuster
;; International, 1989) or from the Cephes Mathematical Library, a
;; commercial product. In either event, it is copyrighted by the author.
;; What you see here may be used freely but it comes with no support or
;; guarantee.
;;
;;   The two known misprints in the book are repaired here in the
;; source listings for the gamma function and the incomplete beta
;; integral.
;;
;;   Stephen L. Moshier
;;   moshier@na-net.ornl.gov
;;

(go/var tanhP ^{:go/breaks [2 3 4]} (lit (array ... float64)
    -0.964399179425052238628M
    -99.2877231001918586564M
    -1614.68768441708447952M))

(go/var tanhQ ^{:go/breaks [2 3 4]} (lit (array ... float64)
    112.811678491632931402M
    2235.48839060100448583M
    4844.06305325125486048M))









^{:go/end 80} (go/func Tanh "Tanh returns the hyperbolic tangent of x.\n\nSpecial cases are:\n\n\tTanh(±0) = ±0\n\tTanh(±Inf) = ±1\n\tTanh(NaN) = NaN\n" ^float64 [^float64 x]
  (when haveArchTanh
    (return (archTanh x)))

  (tanh x))


^{:go/end 105} (go/func tanh ^float64 [^float64 x]
  (let [^:const ^{:val 88.029691931113054295988M} MAXLOG 88.029691931113054295988M ; log(2**127)
      ^{:line 84} z (Abs x)]
    (switch
      (case [(> z (* 0.5 MAXLOG))]
        (when (< x 0)
          (return -1))

        (return 1))
      (case [(>= z 0.625)]
        (let [s (Exp (* 2 z))]
          (set! z (- 1 (/ 2 (+ s 1))))
          (when (< x 0)
            (set! z (- z)))))

      (default
        (when (== x 0)
          (return x))

        (let [s (* x x)]
          (set! z (+ x (/ (* x s (+ (* (+ (* (aget tanhP 0) s) (aget tanhP 1)) s) (aget tanhP 2))) (+ (* (+ (* (+ s (aget tanhQ 0)) s) (aget tanhQ 1)) s) (aget tanhQ 2))))))))

    ^{:line 104} z))

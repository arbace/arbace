(in-ns 'go.math) (go/file "logb.go" :imports [])








^{:go/end 25} (go/func Logb "Logb returns the binary exponent of x.\n\nSpecial cases are:\n\n\tLogb(±Inf) = +Inf\n\tLogb(0) = -Inf\n\tLogb(NaN) = NaN\n" ^float64 [^float64 x]
  ;; special cases
  (switch
    (case [(== x 0)]
      (return (Inf -1)))
    (case [(IsInf x 0)]
      (return (Inf 1)))
    (case [(IsNaN x)]
      (return x)))

  (conv float64 (ilogb x)))









^{:go/end 45} (go/func Ilogb "Ilogb returns the binary exponent of x as an integer.\n\nSpecial cases are:\n\n\tIlogb(±Inf) = MaxInt32\n\tIlogb(0) = MinInt32\n\tIlogb(NaN) = MaxInt32\n" ^int [^float64 x]
  ;; special cases
  (switch
    (case [(== x 0)]
      (return MinInt32))
    (case [(IsNaN x)]
      (return MaxInt32))
    (case [(IsInf x 0)]
      (return MaxInt32)))

  (ilogb x))




^{:go/end 52} (go/func ilogb "ilogb returns the binary exponent of x. It assumes x is finite and\nnon-zero.\n" ^int [^float64 x]
  (let [(values ^:assign x exp) (normalize x)]
    (+ (- (conv int (bit-and (>> (Float64bits x) shift) mask)) bias) exp)))

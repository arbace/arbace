(in-ns 'go.math) (go/file "mod.go" :imports [])

;; /*
;; Floating-point mod function.
;; */












^{:go/end 27} (go/func Mod "Mod returns the floating-point remainder of x/y.\nThe magnitude of the result is less than y and its\nsign agrees with that of x.\n\nSpecial cases are:\n\n\tMod(±Inf, y) = NaN\n\tMod(NaN, y) = NaN\n\tMod(x, 0) = NaN\n\tMod(x, ±Inf) = x\n\tMod(x, NaN) = NaN\n" ^float64 [^float64 x ^float64 y]
  (when haveArchMod
    (return (archMod x y)))

  (mod x y))


^{:go/end 52} (go/func mod ^float64 [^float64 x ^float64 y]
  (when (or (== y 0) (IsInf x 0) (IsNaN x) (IsNaN y))
    (return (NaN)))

  (set! y (Abs y))

  (let [(values yfr yexp) (Frexp y)
      ^{:line 36} r x]
    (when (< x 0)
      (set! r (- x)))


    (while (>= r y)
      (let [(values rfr rexp) (Frexp r)]
        (when (< rfr yfr)
          (set! rexp (- rexp 1)))

        (set! r (- r (Ldexp y (- rexp yexp))))))

    (when (< x 0)
      (set! r (- r)))

    ^{:line 51} r))

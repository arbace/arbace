(in-ns 'go.math) (go/file "sinh.go" :imports [])

;; /*
;; Floating-point hyperbolic sine and cosine.
;; 
;; The exponential func is called for arguments
;; greater in magnitude than 0.5.
;; 
;; A series is used for arguments smaller in magnitude than 0.5.
;; 
;; Cosh(x) is computed from the exponential func for
;; all arguments.
;; */








^{:go/end 31} (go/func Sinh "Sinh returns the hyperbolic sine of x.\n\nSpecial cases are:\n\n\tSinh(±0) = ±0\n\tSinh(±Inf) = ±Inf\n\tSinh(NaN) = NaN\n" ^float64 [^float64 x]
  (when haveArchSinh
    (return (archSinh x)))

  (sinh x))


^{:go/end 70} (go/func sinh ^float64 [^float64 x]
  ;; The coefficients are #2029 from Hart & Cheney. (20.36D)
  (let [
      ^:const ^{:line 36 :val -630767.3640497716991184787251M} P0 -630767.3640497716991184787251M
      ^:const ^:go/grouped ^{:line 37 :val -89912.72022039509355398013511M} P1 -89912.72022039509355398013511M
      ^:const ^:go/grouped ^{:line 38 :val -2894.211355989563807284660366M} P2 -2894.211355989563807284660366M
      ^:const ^:go/grouped ^{:line 39 :val -26.30563213397497062819489M} P3 -26.30563213397497062819489M
      ^:const ^:go/grouped ^{:line 40 :val -630767.3640497716991212077277M} Q0 -630767.3640497716991212077277M
      ^:const ^:go/grouped ^{:line 41 :val 15215.17378790019070696485176M} Q1 15215.17378790019070696485176M
      ^:const ^:go/grouped ^{:line 42 :val -173.678953558233699533450911M} Q2 -173.678953558233699533450911M


      ^{:line 45} sign false]
    (when (< x 0)
      (set! x (- x))
      (set! sign true))


    (let [^float64 temp (zero float64)]
      (switch
        (case [(> x 21)]
          (set! temp (* (Exp x) 0.5)))

        (case [(> x 0.5)]
          (let [ex (Exp x)]
            (set! temp (* (- ex (/ 1 ex)) 0.5))))

        (default
          (let [sq (* x x)]
            (set! temp (* (+ (* (+ (* (+ (* P3 sq) P2) sq) P1) sq) P0) x))
            (set! temp (/ temp (+ (* (+ (* (+ sq Q2) sq) Q1) sq) Q0))))))


      (when sign
        (set! temp (- temp)))

      ^{:line 69} temp)))









^{:go/end 84} (go/func Cosh "Cosh returns the hyperbolic cosine of x.\n\nSpecial cases are:\n\n\tCosh(±0) = 1\n\tCosh(±Inf) = +Inf\n\tCosh(NaN) = NaN\n" ^float64 [^float64 x]
  (when haveArchCosh
    (return (archCosh x)))

  (cosh x))


^{:go/end 93} (go/func cosh ^float64 [^float64 x]
  (set! x (Abs x))
  (when (> x 21)
    (return (* (Exp x) 0.5)))

  (let [ex (Exp x)]
    (* (+ ex (/ 1 ex)) 0.5)))

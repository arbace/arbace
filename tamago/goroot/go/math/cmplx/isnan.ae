(in-ns 'go.math.cmplx) (go/file "isnan.go" :imports [

    ^{:line 7} [math "math"]])



^{:go/breaks [[5 18]] :go/end 19} (go/func IsNaN "IsNaN reports whether either real(x) or imag(x) is NaN\nand neither is an infinity.\n" ^bool [^complex128 x]
  (switch
    (case [(or (math/IsInf (real x) 0) (math/IsInf (imag x) 0))]
      (return false))
    (case [(or (math/IsNaN (real x)) (math/IsNaN (imag x)))]
      (return true)))

  false)



^{:go/end 25} (go/func NaN "NaN returns a complex “not-a-number” value.\n" ^complex128 []
  (let [nan (math/NaN)]
    (complex nan nan)))

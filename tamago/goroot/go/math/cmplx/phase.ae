(in-ns 'go.math.cmplx) (go/file "phase.go" :imports [

    ^{:line 7} [math "math"]])



^{:go/end 11} (go/func Phase "Phase returns the phase (also called the argument) of x.\nThe returned value is in the range [-Pi, Pi].\n" ^float64 [^complex128 x] (math/Atan2 (imag x) (real x)))

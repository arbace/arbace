;; Package cmplx provides basic constants and mathematical functions for
;; complex numbers. Special case handling conforms to the C99 standard
;; Annex G IEC 60559-compatible complex arithmetic.
(in-ns 'go.math.cmplx) (go/file "abs.go" :doc "Package cmplx provides basic constants and mathematical functions for\ncomplex numbers. Special case handling conforms to the C99 standard\nAnnex G IEC 60559-compatible complex arithmetic.\n" :imports [

    ^{:line 10} [math "math"]])


^{:go/end 13} (go/func Abs "Abs returns the absolute value (also called the modulus) of x.\n" ^float64 [^complex128 x] (math/Hypot (real x) (imag x)))

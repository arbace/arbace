(in-ns 'go.math.cmplx) (go/file "sqrt.go" :imports [

    ^{:line 7} [math "math"]])

;; The original C code, the long comment, and the constants
;; below are from http://netlib.sandia.gov/cephes/c9x-complex/clog.c.
;; The go code is a simplified version of the original C.
;;
;; Cephes Math Library Release 2.8:  June, 2000
;; Copyright 1984, 1987, 1989, 1992, 2000 by Stephen L. Moshier
;;
;; The readme file at http://netlib.sandia.gov/cephes/ says:
;;    Some software in this archive may be from the book _Methods and
;; Programs for Mathematical Functions_ (Prentice-Hall or Simon & Schuster
;; International, 1989) or from the Cephes Mathematical Library, a
;; commercial product. In either event, it is copyrighted by the author.
;; What you see here may be used freely but it comes with no support or
;; guarantee.
;;
;;   The two known misprints in the book are repaired here in the
;; source listings for the gamma function and the incomplete beta
;; integral.
;;
;;   Stephen L. Moshier
;;   moshier@na-net.ornl.gov

;; Complex square root
;;
;; DESCRIPTION:
;;
;; If z = x + iy,  r = |z|, then
;;
;;                       1/2
;; Re w  =  [ (r + x)/2 ]   ,
;;
;;                       1/2
;; Im w  =  [ (r - x)/2 ]   .
;;
;; Cancellation error in r-x or r+x is avoided by using the
;; identity  2 Re w Im w  =  y.
;;
;; Note that -w is also a square root of z. The root chosen
;; is always in the right half plane and Im w has the same sign as y.
;;
;; ACCURACY:
;;
;;                      Relative error:
;; arithmetic   domain     # trials      peak         rms
;;    DEC       -10,+10     25000       3.2e-17     9.6e-18
;;    IEEE      -10,+10   1,000,000     2.9e-16     6.1e-17



^{:go/end 107} (go/func Sqrt "Sqrt returns the square root of x.\nThe result r is chosen so that real(r) ≥ 0 and imag(r) has the same sign as imag(x).\n" ^complex128 [^complex128 x]
  (cond (== (imag x) 0) (do
      ;; Ensure that imag(r) has the same sign as imag(x) for imag(x) == signed zero.
      (when (== (real x) 0)
        (return (complex 0 (imag x))))

      (when (< (real x) 0)
        (return (complex 0 (math/Copysign (math/Sqrt (- (real x))) (imag x)))))

      (return (complex (math/Sqrt (real x)) (imag x))))
    (math/IsInf (imag x) 0)
    (return (complex (math/Inf 1.0) (imag x))))

  (when (== (real x) 0)
    (when (< (imag x) 0)
      (let [r (math/Sqrt (* -0.5 (imag x)))]
        (return (complex r (- r)))))

    (let [r (math/Sqrt (* 0.5 (imag x)))]
      (return (complex r r))))

  (let [a (real x)
      ^{:line 80} b (imag x)
      ^{:line 81 :tag float64} scale (zero float64)]
    ;; Rescale to avoid internal overflow or underflow.
    (if (or (> (math/Abs a) 4) (> (math/Abs b) 4)) (do
        (set! a * 0.25)
        (set! b * 0.25)
        (set! scale 2))
      (do
        (set! a * 1.8014398509481984E16) ; 2**54
        (set! b * 1.8014398509481984E16)
        (set! scale 7.450580596923828125E-9M))) ; 2**-27

    (let [r (math/Hypot a b)
        ^{:line 93 :tag float64} t (zero float64)]
      (if (> a 0) (do
          (set! t (math/Sqrt (+ (* 0.5 r) (* 0.5 a))))
          (set! r (* scale (math/Abs (/ (* 0.5 b) t))))
          (set! t * scale))
        (do
          (set! r (math/Sqrt (- (* 0.5 r) (* 0.5 a))))
          (set! t (* scale (math/Abs (/ (* 0.5 b) r))))
          (set! r * scale)))

      (when (< b 0)
        (return (complex t (- r))))

      (complex t r))))

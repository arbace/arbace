(in-ns 'go.math.cmplx) (go/file "polar.go" :imports [])




^{:go/end 12} (go/func Polar "Polar returns the absolute value r and phase θ of x,\nsuch that x = r * e**θi.\nThe phase is in the range [-Pi, Pi].\n" [^complex128 x] :results [^float64 r ^float64 θ]
  (return (Abs x) (Phase x)))

(in-ns 'go.math.cmplx) (go/file "rect.go" :imports [

    ^{:line 7} [math "math"]])


^{:go/end 13} (go/func Rect "Rect returns the complex number x with polar coordinates r, θ.\n" ^complex128 [^float64 r ^float64 θ]
  (let [(values s c) (math/Sincos θ)]
    (complex (* r c) (* r s))))

(in-ns 'go.math.cmplx) (go/file "isinf.go" :imports [

    ^{:line 7} [math "math"]])


^{:go/breaks [[5 14]] :go/end 15} (go/func IsInf "IsInf reports whether either real(x) or imag(x) is an infinity.\n" ^bool [^complex128 x]
  (when (or (math/IsInf (real x) 0) (math/IsInf (imag x) 0))
    (return true))

  false)



^{:go/end 21} (go/func Inf "Inf returns a complex infinity, complex(+Inf, +Inf).\n" ^complex128 []
  (let [inf (math/Inf 1)]
    (complex inf inf)))

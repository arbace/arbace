(in-ns 'go.math.cmplx) (go/file "sin.go" :imports [

    ^{:line 7} [math "math"]])

;; The original C code, the long comment, and the constants
;; below are from http://netlib.sandia.gov/cephes/c9x-complex/clog.c.
;; The go code is a simplified version of the original C.
;;
;; Cephes Math Library Release 2.8:  June, 2000
;; Copyright 1984, 1987, 1989, 1992, 2000 by Stephen L. Moshier
;;
;; The readme file at http://netlib.sandia.gov/cephes/ says:
;;    Some software in this archive may be from the book _Methods and
;; Programs for Mathematical Functions_ (Prentice-Hall or Simon & Schuster
;; International, 1989) or from the Cephes Mathematical Library, a
;; commercial product. In either event, it is copyrighted by the author.
;; What you see here may be used freely but it comes with no support or
;; guarantee.
;;
;;   The two known misprints in the book are repaired here in the
;; source listings for the gamma function and the incomplete beta
;; integral.
;;
;;   Stephen L. Moshier
;;   moshier@na-net.ornl.gov

;; Complex circular sine
;;
;; DESCRIPTION:
;;
;; If
;;     z = x + iy,
;;
;; then
;;
;;     w = sin x  cosh y  +  i cos x sinh y.
;;
;; csin(z) = -i csinh(iz).
;;
;; ACCURACY:
;;
;;                      Relative error:
;; arithmetic   domain     # trials      peak         rms
;;    DEC       -10,+10      8400       5.3e-17     1.3e-17
;;    IEEE      -10,+10     30000       3.8e-16     1.0e-16
;; Also tested by csin(casin(z)) = z.


^{:go/end 70} (go/func Sin "Sin returns the sine of x.\n" ^complex128 [^complex128 x]
  (switch [(values re im) (values (real x) (imag x))]
    (case [(and (== im 0) ^:go/paren (or (math/IsInf re 0) (math/IsNaN re)))]
      (return (complex (math/NaN) im)))
    (case [(math/IsInf im 0)]
      (switch
        (case [(== re 0)]
          (return x))
        (case [(or (math/IsInf re 0) (math/IsNaN re))]
          (return (complex (math/NaN) im)))))

    (case [(and (== re 0) (math/IsNaN im))]
      (return x)))

  (let [(values s c) (math/Sincos (real x))
      (values sh ch) (sinhcosh (imag x))]
    (complex (* s ch) (* c sh))))


;; Complex hyperbolic sine
;;
;; DESCRIPTION:
;;
;; csinh z = (cexp(z) - cexp(-z))/2
;;         = sinh x * cos y  +  i cosh x * sin y .
;;
;; ACCURACY:
;;
;;                      Relative error:
;; arithmetic   domain     # trials      peak         rms
;;    IEEE      -10,+10     30000       3.1e-16     8.2e-17


^{:go/end 103} (go/func Sinh "Sinh returns the hyperbolic sine of x.\n" ^complex128 [^complex128 x]
  (switch [(values re im) (values (real x) (imag x))]
    (case [(and (== re 0) ^:go/paren (or (math/IsInf im 0) (math/IsNaN im)))]
      (return (complex re (math/NaN))))
    (case [(math/IsInf re 0)]
      (switch
        (case [(== im 0)]
          (return (complex re im)))
        (case [(or (math/IsInf im 0) (math/IsNaN im))]
          (return (complex re (math/NaN))))))

    (case [(and (== im 0) (math/IsNaN re))]
      (return (complex (math/NaN) im))))

  (let [(values s c) (math/Sincos (imag x))
      (values sh ch) (sinhcosh (real x))]
    (complex (* c sh) (* s ch))))


;; Complex circular cosine
;;
;; DESCRIPTION:
;;
;; If
;;     z = x + iy,
;;
;; then
;;
;;     w = cos x  cosh y  -  i sin x sinh y.
;;
;; ACCURACY:
;;
;;                      Relative error:
;; arithmetic   domain     # trials      peak         rms
;;    DEC       -10,+10      8400       4.5e-17     1.3e-17
;;    IEEE      -10,+10     30000       3.8e-16     1.0e-16


^{:go/end 141} (go/func Cos "Cos returns the cosine of x.\n" ^complex128 [^complex128 x]
  (switch [(values re im) (values (real x) (imag x))]
    (case [(and (== im 0) ^:go/paren (or (math/IsInf re 0) (math/IsNaN re)))]
      (return (complex (math/NaN) (* (- im) (math/Copysign 0 re)))))
    (case [(math/IsInf im 0)]
      (switch
        (case [(== re 0)]
          (return (complex (math/Inf 1) (* (- re) (math/Copysign 0 im)))))
        (case [(or (math/IsInf re 0) (math/IsNaN re))]
          (return (complex (math/Inf 1) (math/NaN))))))

    (case [(and (== re 0) (math/IsNaN im))]
      (return (complex (math/NaN) 0))))

  (let [(values s c) (math/Sincos (real x))
      (values sh ch) (sinhcosh (imag x))]
    (complex (* c ch) (* (- s) sh))))


;; Complex hyperbolic cosine
;;
;; DESCRIPTION:
;;
;; ccosh(z) = cosh x  cos y + i sinh x sin y .
;;
;; ACCURACY:
;;
;;                      Relative error:
;; arithmetic   domain     # trials      peak         rms
;;    IEEE      -10,+10     30000       2.9e-16     8.1e-17


^{:go/end 173} (go/func Cosh "Cosh returns the hyperbolic cosine of x.\n" ^complex128 [^complex128 x]
  (switch [(values re im) (values (real x) (imag x))]
    (case [(and (== re 0) ^:go/paren (or (math/IsInf im 0) (math/IsNaN im)))]
      (return (complex (math/NaN) (* re (math/Copysign 0 im)))))
    (case [(math/IsInf re 0)]
      (switch
        (case [(== im 0)]
          (return (complex (math/Inf 1) (* im (math/Copysign 0 re)))))
        (case [(or (math/IsInf im 0) (math/IsNaN im))]
          (return (complex (math/Inf 1) (math/NaN))))))

    (case [(and (== im 0) (math/IsNaN re))]
      (return (complex (math/NaN) im))))

  (let [(values s c) (math/Sincos (imag x))
      (values sh ch) (sinhcosh (real x))]
    (complex (* c ch) (* s sh))))



^{:go/end 184} (go/func sinhcosh "calculate sinh and cosh.\n" [^float64 x] :results [^float64 sh ^float64 ch]
  (when (<= (math/Abs x) 0.5)
    (return (math/Sinh x) (math/Cosh x)))

  (let [e (math/Exp x)
      ^{:line 181} ei (/ 0.5 e)]
    (set! e * 0.5)
    (return (- e ei) (+ e ei))))

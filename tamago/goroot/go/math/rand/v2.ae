(ns go.math.rand.v2
  (:require [arbace.go :as go]))

(go/package rand
  :path "math/rand/v2"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["chacha8.go" "exp.go" "normal.go" "pcg.go" "rand.go" "zipf.go"]
  :init-order [ke we fe kn wn fn errUnmarshalPCG globalRand]
  :positions :lines)

(load "v2/chacha8")
(load "v2/exp")
(load "v2/normal")
(load "v2/pcg")
(load "v2/rand")
(load "v2/zipf")

;; W.Hormann, G.Derflinger:
;; "Rejection-Inversion to Generate Variates
;; from Monotone Discrete Distributions"
;; http://eeyore.wu-wien.ac.at/papers/96-04-04.wh-der.ps.gz

(in-ns 'go.math.rand.v2) (go/file "zipf.go" :imports [

    ^{:line 12} [math "math"]])


(go/type Zipf "A Zipf generates Zipf distributed variates.\n" (struct
    ^{:line 16 :tag (* Rand)} r
    ^{:line 17 :tag float64} imax
    ^{:line 18 :tag float64} v
    ^{:line 19 :tag float64} q
    ^{:line 20 :tag float64} s
    ^{:line 21 :tag float64} oneminusQ
    ^{:line 22 :tag float64} oneminusQinv
    ^{:line 23 :tag float64} hxm
    ^{:line 24 :tag float64} hx0minusHxm))


^{:go/end 29} (go/method h ^float64 [^{:tag (* Zipf)} z ^float64 x]
  (* (math/Exp (* (.-oneminusQ z) (math/Log (+ (.-v z) x)))) (.-oneminusQinv z)))


^{:go/end 33} (go/method hinv ^float64 [^{:tag (* Zipf)} z ^float64 x]
  (- (math/Exp (* (.-oneminusQinv z) (math/Log (* (.-oneminusQ z) x)))) (.-v z)))






^{:go/end 54} (go/func NewZipf "NewZipf returns a Zipf variate generator.\nThe generator generates values k ∈ [0, imax]\nsuch that P(k) is proportional to (v + k) ** (-s).\nRequirements: s > 1 and v >= 1.\n" ^{:tag (* Zipf)} [^{:tag (* Rand)} r ^float64 s ^float64 v ^uint64 imax]
  (let [z (new Zipf)]
    (when (or (<= s 1.0) (< v 1))
      (return nil))

    (set! (.-r z) r)
    (set! (.-imax z) (conv float64 imax))
    (set! (.-v z) v)
    (set! (.-q z) s)
    (set! (.-oneminusQ z) (- 1.0 (.-q z)))
    (set! (.-oneminusQinv z) (/ 1.0 (.-oneminusQ z)))
    (set! (.-hxm z) (.h z (+ (.-imax z) 0.5)))
    (set! (.-hx0minusHxm z) (- (.h z 0.5) (math/Exp (* (math/Log (.-v z)) (- (.-q z)))) (.-hxm z)))
    (set! (.-s z) (- 1 (.hinv z (- (.h z 1.5) (math/Exp (* (- (.-q z)) (math/Log (+ (.-v z) 1.0))))))))
    ^{:line 53} z))




^{:go/end 77} (go/method Uint64 "Uint64 returns a value drawn from the Zipf distribution described\nby the Zipf object.\n" ^uint64 [^{:tag (* Zipf)} z]
  (when (== z nil)
    (panic "rand: nil Zipf"))

  (let [k 0.0]

    (while true
      (let [r (.Float64 (.-r z)) ; r on [0,1]
          ^{:line 66} ur (+ (.-hxm z) (* r (.-hx0minusHxm z)))
          ^{:line 67} x (.hinv z ur)]
        (set! k (math/Floor (+ x 0.5)))
        (when (<= (- k x) (.-s z))
          (break))

        (when (>= ur (- (.h z (+ k 0.5)) (math/Exp (* (- (math/Log (+ k (.-v z)))) (.-q z)))))
          (break))))


    (conv uint64 k)))

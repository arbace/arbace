(in-ns 'go.math.rand.v2) (go/file "normal.go" :imports [


    ^{:line 8} [math "math"]])


;; /*
;; * Normal distribution
;; *
;; * See "The Ziggurat Method for Generating Random Variables"
;; * (Marsaglia & Tsang, 2000)
;; * http://www.jstatsoft.org/v05/i08/paper [pdf]
;; */

(go/const
  ^{:line 20} [^{:val 3.442619855899} rn 3.442619855899])


^{:go/end 28} (go/func absInt32 ^uint32 [^int32 i]
  (when (< i 0)
    (return (conv uint32 (- i))))

  (conv uint32 i))









^{:go/end 66} (go/method NormFloat64 "NormFloat64 returns a normally distributed float64 in\nthe range -math.MaxFloat64 through +math.MaxFloat64 inclusive,\nwith standard normal distribution (mean = 0, stddev = 1).\nTo produce a different normal distribution, callers can\nadjust the output using:\n\n\tsample = NormFloat64() * desiredStdDev + desiredMean\n" ^float64 [^{:tag (* Rand)} r]
  (while true
    (let [u (.Uint64 r)
        ^{:line 40} j (conv int32 u) ; Possibly negative
        ^{:line 41} i (bit-and (>> u 32) 0x7F)
        ^{:line 42} x (* (conv float64 j) (conv float64 (aget wn i)))]
      (when (< (absInt32 j) (aget kn i))
        ;; This case should be hit better than 99% of the time.
        (return x))


      (when (== i 0)
        ;; This extra work is only required for the base strip.
        (while true
          (set! x (* (- (math/Log (.Float64 r))) (/ 1.0 rn)))
          (let [y (- (math/Log (.Float64 r)))]
            (when (>= (+ y y) (* x x))
              (break))))


        (when (> j 0)
          (return (+ rn x)))

        (return (- (- rn) x)))

      (when (< (+ (aget fn i) (* (conv float32 (.Float64 r)) (- (aget fn (- i 1)) (aget fn i)))) (conv float32 (math/Exp (* -0.5 x x))))
        (return x)))))





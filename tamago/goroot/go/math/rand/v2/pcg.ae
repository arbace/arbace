(go/var errUnmarshalPCG (errors/New "invalid PCG encoding"))


^{:go/breaks [7] :go/end 57} (go/method UnmarshalBinary "UnmarshalBinary implements the [encoding.BinaryUnmarshaler] interface.\n" ^error [^{:tag (* PCG)} p ^{:tag (slice byte)} data]
  (when (or (!= (len data) 20) (!= (conv string (subslice data _ 4)) "pcg:"))
    (return errUnmarshalPCG))

  (set! (.-hi p) (byteorder/BEUint64 (subslice data 4)))
  (set! (.-lo p) (byteorder/BEUint64 (subslice data (+ 4 8))))
  nil)


^{:go/end 83} (go/method next [^{:tag (* PCG)} p] :results [^uint64 hi ^uint64 lo]
  ;; https://github.com/imneme/pcg-cpp/blob/428802d1a5/include/pcg_random.hpp#L161
  ;;
  ;; Numpy's PCG multiplies by the 64-bit value cheapMul
  ;; instead of the 128-bit value used here and in the official PCG code.
  ;; This does not seem worthwhile, at least for Go: not having any high
  ;; bits in the multiplier reduces the effect of low bits on the highest bits,
  ;; and it only saves 1 multiply out of 3.
  ;; (On 32-bit systems, it saves 1 out of 6, since Mul64 is doing 4.)
  (let [
      ^:const ^{:line 69 :val 2549297995355413924} mulHi 2549297995355413924
      ^:const ^:go/grouped ^{:line 70 :val 4865540595714422341} mulLo 4865540595714422341
      ^:const ^:go/grouped ^{:line 71 :val 6364136223846793005} incHi 6364136223846793005
      ^:const ^:go/grouped ^{:line 72 :val 1442695040888963407} incLo 1442695040888963407]


    ;; state = state * mul + inc
    (set! (values hi lo) (bits/Mul64 (.-lo p) mulLo))
    (set! hi + (+ (* (.-hi p) mulLo) (* (.-lo p) mulHi)))
    (let [(values ^:assign lo c) (bits/Add64 lo incLo 0)]
      (set! (values hi _) (bits/Add64 hi incHi c))
      (set! (.-lo p) lo)
      (set! (.-hi p) hi)
      (return hi lo))))



^{:go/end 106} (go/method Uint64 "Uint64 return a uniformly-distributed random uint64 value.\n" ^uint64 [^{:tag (* PCG)} p]
  (let [(values hi lo) (.next p)

      ;; XSL-RR would be

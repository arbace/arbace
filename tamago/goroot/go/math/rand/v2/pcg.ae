      ;; and following comments.

      ;; DXSM "double xorshift multiply"
      ;; https://github.com/imneme/pcg-cpp/blob/428802d1a5/include/pcg_random.hpp#L1015

      ;; https://github.com/imneme/pcg-cpp/blob/428802d1a5/include/pcg_random.hpp#L176
      ^:const ^{:line 100 :val 15750249268501108917N} cheapMul 0xda942042e4dd58b5]
    (set! hi bit-xor (>> hi 32))
    (set! hi * cheapMul)
    (set! hi bit-xor (>> hi 48))
    (set! hi * (bit-or lo 1))
    ^{:line 105} hi))

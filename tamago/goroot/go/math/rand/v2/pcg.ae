(go/type PCG "A PCG is a PCG generator with 128 bits of internal state.\nA zero PCG is equivalent to NewPCG(0, 0).\n" (struct
    ^{:line 19 :tag uint64} hi
    ^{:line 20 :tag uint64} lo))



^{:go/end 26} (go/func NewPCG "NewPCG returns a new PCG seeded with the given values.\n" ^{:tag (* PCG)} [^uint64 seed1 ^uint64 seed2]
  (addr (lit PCG seed1 seed2)))



^{:go/end 32} (go/method Seed "Seed resets the PCG to behave the same way as NewPCG(seed1, seed2).\n" [^{:tag (* PCG)} p ^uint64 seed1 ^uint64 seed2]
  (set! (.-hi p) seed1)
  (set! (.-lo p) seed2))



^{:go/end 40} (go/method AppendBinary "AppendBinary implements the [encoding.BinaryAppender] interface.\n" [^{:tag (* PCG)} p ^{:tag (slice byte)} b] :results [(slice byte) error]
  (set! b (append b (spread "pcg:")))
  (set! b (byteorder/BEAppendUint64 b (.-hi p)))
  (set! b (byteorder/BEAppendUint64 b (.-lo p)))
  (return b nil))



^{:go/end 45} (go/method MarshalBinary "MarshalBinary implements the [encoding.BinaryMarshaler] interface.\n" [^{:tag (* PCG)} p] :results [(slice byte) error]

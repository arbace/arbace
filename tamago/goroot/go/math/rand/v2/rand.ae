^{:go/end 241} (go/method Perm "Perm returns, as a slice of n ints, a pseudo-random permutation of the integers\nin the half-open interval [0,n).\n" ^{:tag (slice int)} [^{:tag (* Rand)} r ^int n]
  (let [p (make (slice int) n)]
    (range [i p]
      (aset p i i))

    (.Shuffle r (len p) ^{:go/end 239} (fn [^int i ^int j] (set! (values (aget p i) (aget p j)) (values (aget p j) (aget p i)))))

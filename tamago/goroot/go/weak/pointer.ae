(in-ns 'go.weak) (go/file "pointer.go" :imports [


    ^{:line 8} [abi "internal/abi"]
    ^{:line 9} [runtime "runtime"]
    ^{:line 10} [unsafe "unsafe"]])

















































(go/type Pointer "Pointer is a weak pointer to a value of type T.\n\nJust like regular pointers, Pointer may reference any part of an\nobject, such as a field of a struct or an element of an array.\nObjects that are only pointed to by weak pointers are not considered\nreachable, and once the object becomes unreachable, [Pointer.Value]\nmay return nil.\n\nThe primary use-cases for weak pointers are for implementing caches,\ncanonicalization maps (like the unique package), and for tying together\nthe lifetimes of separate values (for example, through a map with weak\nkeys).\n\nTwo Pointer values compare equal if and only if the pointers from which they\nwere created compare equal.\nThis property is maintained even after the object referenced by the pointer\nused to create a weak reference is reclaimed.\nIf multiple weak pointers are made to different offsets within the same object\n(for example, pointers to different fields of the same struct), those pointers\nwill not compare equal.\nIn other words, weak pointers map to objects and offsets within those\nobjects, not plain addresses.\nIf a weak pointer is created from an object that becomes unreachable, but is\nthen resurrected due to a finalizer, that weak pointer will not compare equal\nwith weak pointers created after the resurrection.\n\nCalling [Make] with a nil pointer returns a weak pointer whose [Pointer.Value]\nalways returns nil. The zero value of a Pointer behaves as if it were created\nby passing nil to [Make] and compares equal with such pointers.\n\n[Pointer.Value] is not guaranteed to eventually return nil.\n[Pointer.Value] may return nil as soon as the object becomes\nunreachable.\nValues stored in global variables, or that can be found by tracing\npointers from a global variable, are reachable. A function argument or\nreceiver may become unreachable at the last point where the function\nmentions it. To ensure [Pointer.Value] does not return nil,\npass a pointer to the object to the [runtime.KeepAlive] function after\nthe last point where the object must remain reachable.\n\nNote that because [Pointer.Value] is not guaranteed to eventually return\nnil, even after an object is no longer referenced, the runtime is allowed to\nperform a space-saving optimization that batches objects together in a single\nallocation slot. The weak pointer for an unreferenced object in such an\nallocation may never become nil if it always exists in the same batch as a\nreferenced object. Typically, this batching only happens for tiny\n(on the order of 16 bytes or less) and pointer-free objects.\n" :type-params [T] (struct


    ^{:line 63 :tag (array 0 (* T)) :doc "Mention T in the type definition to prevent conversions\nbetween Pointer types, like we do for sync/atomic.Pointer.\n"} _
    ^{:line 64 :tag unsafe/Pointer} u))



^{:go/end 78} (go/func Make "Make creates a weak pointer from a pointer to some value of type T.\n" :type-params [T] ^{:tag (Pointer T)} [^{:tag (* T)} ptr]
  ;; Explicitly force ptr to escape to the heap.
  (set! ptr (^{:inst [(* T)]} abi/Escape ptr))

  (let [^unsafe/Pointer u (zero unsafe/Pointer)]
    (when (!= ptr nil)
      (set! u (runtime_registerWeakPointer (conv unsafe/Pointer ptr))))

    (runtime/KeepAlive ptr)
    (lit (Pointer T) :u u)))







^{:go/end 90} (go/method Value "Value returns the original pointer used to create the weak pointer.\nIt returns nil if the value pointed to by the original pointer was reclaimed by\nthe garbage collector.\nIf a weak pointer points to an object with a finalizer, then Value will\nreturn nil as soon as the object's finalizer is queued for execution.\n" ^{:tag (* T)} [^{:tag (Pointer T)} p]
  (when (== (.-u p) nil)
    (return nil))

  (conv (* T) (runtime_makeStrongFromWeak (.-u p))))


;; Implemented in runtime.


(go/func ^:extern ^{:go/linkname "runtime_registerWeakPointer"} runtime_registerWeakPointer ^unsafe/Pointer [unsafe/Pointer])


(go/func ^:extern ^{:go/linkname "runtime_makeStrongFromWeak"} runtime_makeStrongFromWeak ^unsafe/Pointer [unsafe/Pointer])

(ns go.math
  (:require [arbace.go :as go]))

(go/package math
  :path "math"
  :files ["abs.go" "acosh.go" "asin.go" "asinh.go" "atan.go" "atan2.go" "atanh.go" "bits.go" "cbrt.go" "const.go" "copysign.go" "dim.go" "dim_asm.go" "erf.go" "erfinv.go" "exp.go" "exp2_asm.go" "exp2_noasm.go" "exp_amd64.go" "exp_asm.go" "expm1.go" "floor.go" "floor_asm.go" "fma.go" "frexp.go" "gamma.go" "hypot.go" "hypot_asm.go" "hypot_noasm.go" "j0.go" "j1.go" "jn.go" "ldexp.go" "lgamma.go" "log.go" "log10.go" "log1p.go" "log_asm.go" "log_stub.go" "logb.go" "mod.go" "modf.go" "nextafter.go" "pow.go" "pow10.go" "remainder.go" "signbit.go" "sin.go" "sincos.go" "sinh.go" "sqrt.go" "stubs.go" "tan.go" "tanh.go" "trig_reduce.go" "unsafe.go"]
  :other-files ["dim_amd64.s" "dim_arm64.s" "exp_amd64.s" "exp_arm64.s" "floor_amd64.s" "floor_arm64.s" "hypot_amd64.s" "log_amd64.s"]
  :positions :lines)


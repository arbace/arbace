(ns go.compress.flate
  (:require [arbace.go :as go]))

(go/package flate
  :path "compress/flate"
  :files ["deflate.go" "deflatefast.go" "dict_decoder.go" "huffman_bit_writer.go" "huffman_code.go" "inflate.go" "level1.go" "level2.go" "level3.go" "level4.go" "level5.go" "level6.go" "load_store.go" "regmask_amd64.go" "regmask_other.go" "token.go"]
  :positions :lines)

(load "flate/deflate")
(load "flate/deflatefast")
(load "flate/dict_decoder")
(load "flate/huffman_bit_writer")
(load "flate/huffman_code")
(load "flate/inflate")
(load "flate/level1")
(load "flate/level2")
(load "flate/level3")
(load "flate/level4")
(load "flate/level5")
(load "flate/level6")
(load "flate/load_store")
(load "flate/regmask_amd64")
(load "flate/regmask_other")
(load "flate/token")

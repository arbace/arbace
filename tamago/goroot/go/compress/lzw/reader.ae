    ^{:line 261} r))


^{:go/end 290} (go/method init [^{:tag (* Reader)} r ^io/Reader src ^Order order ^int litWidth]
  (switch order
    (case [LSB]
      (set! (.-read r) (method-expr (* Reader) readLSB)))
    (case [MSB]
      (set! (.-read r) (method-expr (* Reader) readMSB)))
    (default
      (set! (.-err r) (errors/New "lzw: unknown order"))
      (return)))

  (when (or (< litWidth 2) (< 8 litWidth))
    (set! (.-err r) (fmt/Errorf "lzw: litWidth %d out of range" litWidth))
    (return))


  (let [(values br ok) (assert io/ByteReader src)]
    (when (and (not ok) (!= src nil))
      (set! br (bufio/NewReader src)))

    (set! (.-r r) br)
    (set! (.-litWidth r) litWidth)
    (set! (.-width r) (+ 1 (conv uint litWidth)))
    (set! (.-clear r) (<< (conv uint16 1) (conv uint litWidth)))
    (set! (values (.-eof r) (.-hi r)) (values (+ (.-clear r) 1) (+ (.-clear r) 1)))
    (set! (.-overflow r) (<< (conv uint16 1) (.-width r)))
    (set! (.-last r) decoderInvalidCode)))

;; Package lzw implements the Lempel-Ziv-Welch compressed data format,
;; described in T. A. Welch, “A Technique for High-Performance Data
;; Compression”, Computer, 17(6) (June 1984), pp 8-19.
;;
;; In particular, it implements LZW as used by the GIF and PDF file
;; formats, which means variable-width codes up to 12 bits and the first
;; two non-literal codes are a clear code and an EOF code.
;;
;; The TIFF file format uses a similar but incompatible version of the LZW
;; algorithm. See the [golang.org/x/image/tiff/lzw] package for an
;; implementation.
(in-ns 'go.compress.lzw) (go/file "reader.go" :doc "Package lzw implements the Lempel-Ziv-Welch compressed data format,\ndescribed in T. A. Welch, “A Technique for High-Performance Data\nCompression”, Computer, 17(6) (June 1984), pp 8-19.\n\nIn particular, it implements LZW as used by the GIF and PDF file\nformats, which means variable-width codes up to 12 bits and the first\ntwo non-literal codes are a clear code and an EOF code.\n\nThe TIFF file format uses a similar but incompatible version of the LZW\nalgorithm. See the [golang.org/x/image/tiff/lzw] package for an\nimplementation.\n" :imports [

    ;; TODO(nigeltao): check that PDF uses LZW in the same way as GIF,
    ;; modulo LSB/MSB packing order.


    ^{:line 22} [bufio "bufio"]
    ^{:line 23} [errors "errors"]
    ^{:line 24} [fmt "fmt"]
    ^{:line 25} [io "io"]])



(go/type Order "Order specifies the bit ordering in an LZW data stream.\n" int)

(go/const

  ^{:line 33} [^{:tag Order :val 0 :doc "LSB means Least Significant Bits first, as used in the GIF file format.\n"} LSB iota]


  ^{:line 36} [^{:val 1 :doc "MSB means Most Significant Bits first, as used in the TIFF and PDF\nfile formats.\n"} MSB])



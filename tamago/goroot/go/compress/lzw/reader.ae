^{:go/end 103} (go/method readLSB "readLSB returns the next code for \"Least Significant Bits first\" data.\n" [^{:tag (* Reader)} r] :results [uint16 error]
  (while (< (.-nBits r) (.-width r))
    (let [(values x err) (.ReadByte (.-r r))]
      (when (!= err nil)
        (return 0 err))

      (set! (.-bits r) bit-or (<< (conv uint32 x) (.-nBits r)))
      (set! (.-nBits r) + 8)))

  (let [code (conv uint16 (bit-and (.-bits r) (- ^uint32 (<< 1 (.-width r)) 1)))]
    (set! (.-bits r) >> (.-width r))
    (set! (.-nBits r) - (.-width r))
    (return code nil)))



^{:go/end 119} (go/method readMSB "readMSB returns the next code for \"Most Significant Bits first\" data.\n" [^{:tag (* Reader)} r] :results [uint16 error]
  (while (< (.-nBits r) (.-width r))
    (let [(values x err) (.ReadByte (.-r r))]
      (when (!= err nil)
        (return 0 err))

      (set! (.-bits r) bit-or (<< (conv uint32 x) (- 24 (.-nBits r))))
      (set! (.-nBits r) + 8)))

  (let [code (conv uint16 (>> (.-bits r) (- 32 (.-width r))))]
    (set! (.-bits r) << (.-width r))
    (set! (.-nBits r) - (.-width r))
    (return code nil)))



^{:go/end 134} (go/method Read "Read implements io.Reader, reading uncompressed bytes from its underlying reader.\n" [^{:tag (* Reader)} r ^{:tag (slice byte)} b] :results [int error]
  (while true
    (when (> (len (.-toRead r)) 0)
      (let [n (copy b (.-toRead r))]
        (set! (.-toRead r) (subslice (.-toRead r) n))
        (return n nil)))

    (when (!= (.-err r) nil)
      (return 0 (.-err r)))

    (.decode r)))






^{:go/end 224} (go/method decode "decode decompresses bytes from r and leaves them in d.toRead.\nread specifies how to decode bytes into codes.\nlitWidth is the width in bits of literal codes.\n" [^{:tag (* Reader)} r]
  ;; Loop over the code stream, converting codes into decompressed bytes.
  (label :loop
    (while true
      (let [(values code err) ((.-read r) r)]
        (when (!= err nil)
          (when (== err io/EOF)
            (set! err io/ErrUnexpectedEOF))

          (set! (.-err r) err)
          (break))

        (switch
          (case [(< code (.-clear r))]
            ;; We have a literal code.
            (aset (.-output r) (.-o r) (conv uint8 code))
            (inc! (.-o r))
            (when (!= (.-last r) decoderInvalidCode)
              ;; Save what the hi code expands to.
              (aset (.-suffix r) (.-hi r) (conv uint8 code))
              (aset (.-prefix r) (.-hi r) (.-last r))))

          (case [(== code (.-clear r))]
            (set! (.-width r) (+ 1 (conv uint (.-litWidth r))))
            (set! (.-hi r) (.-eof r))
            (set! (.-overflow r) ^uint16 (<< 1 (.-width r)))
            (set! (.-last r) decoderInvalidCode)
            (continue))
          (case [(== code (.-eof r))]
            (set! (.-err r) io/EOF)
            (break :loop))
          (case [(<= code (.-hi r))]
            (let [(values c i) (values code (- (len (.-output r)) 1))]
              (when (and (== code (.-hi r)) (!= (.-last r) decoderInvalidCode))
                ;; code == hi is a special case which expands to the last expansion
                ;; followed by the head of the last expansion. To find the head, we walk
                ;; the prefix chain until we find a literal code.
                (set! c (.-last r))
                (while (>= c (.-clear r))
                  (set! c (aget (.-prefix r) c)))

                (aset (.-output r) i (conv uint8 c))
                (dec! i)
                (set! c (.-last r)))

              ;; Copy the suffix chain into output and then write that to w.
              (while (>= c (.-clear r))
                (aset (.-output r) i (aget (.-suffix r) c))
                (dec! i)
                (set! c (aget (.-prefix r) c)))

              (aset (.-output r) i (conv uint8 c))
              (set! (.-o r) + (copy (subslice (.-output r) (.-o r)) (subslice (.-output r) i)))
              (when (!= (.-last r) decoderInvalidCode)
                ;; Save what the hi code expands to.
                (aset (.-suffix r) (.-hi r) (conv uint8 c))
                (aset (.-prefix r) (.-hi r) (.-last r)))))

          (default
            (set! (.-err r) (errors/New "lzw: invalid code"))
            (break :loop)))

        (set! (values (.-last r) (.-hi r)) (values code (+ (.-hi r) 1)))
        (when (>= (.-hi r) (.-overflow r))
          (when (> (.-hi r) (.-overflow r))
            (panic "unreachable"))

          (if (== (.-width r) maxWidth) (do
              (set! (.-last r) decoderInvalidCode)
              ;; Undo the d.hi++ a few lines above, so that (1) we maintain
              ;; the invariant that d.hi < d.overflow, and (2) d.hi does not
              ;; eventually overflow a uint16.
              (dec! (.-hi r)))
            (do
              (inc! (.-width r))
              (set! (.-overflow r) ^uint16 (<< 1 (.-width r))))))


        (when (>= (.-o r) flushBuffer)
          (break)))))


  ;; Flush pending output.
  (set! (.-toRead r) (subslice (.-output r) _ (.-o r)))
  (set! (.-o r) 0))


(go/var errClosed (errors/New "lzw: reader/writer is closed"))



^{:go/breaks [5] :go/end 233} (go/method Close "Close closes the [Reader] and returns an error for any future read operation.\nIt does not close the underlying [io.Reader].\n" ^error [^{:tag (* Reader)} r]

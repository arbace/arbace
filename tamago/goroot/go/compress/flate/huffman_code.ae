^{:go/end 393} (go/func histogram [^{:tag (slice byte)} b ^{:tag (slice uint16)} h]
  (when (>= (len b) (<< 8 10))
    (histogramSplit b h)
    (return))

  (set! h (subslice h _ 256))
  (range [_ t b]
    (inc! (aget h t))))



^{:go/end 417} (go/func histogramSplit [^{:tag (slice byte)} b ^{:tag (slice uint16)} h]
  ;; Walk four quarters in parallel.
  ;; Tested to be faster than walking halves.
  (set! h (subslice h _ 256))
  ;; Make size divisible by 4
  (while (!= (bit-and (len b) 3) 0)
    (inc! (aget h (aget b 0)))
    (set! b (subslice b 1)))

  (let [n (/ (len b) 4)
      (values x y z w) (values (subslice b _ n) (subslice b n) (subslice b (+ n n)) (subslice b (+ n n n)))]
    (set! (values y z w) (values (subslice y _ (len x)) (subslice z _ (len x)) (subslice w _ (len x))))
    (range [i t x]
      (let [v0 (addr (aget h t))
          ^{:line 409} v1 (addr (aget h (aget y i)))
          ^{:line 410} v2 (addr (aget h (aget z i)))
          ^{:line 411} v3 (addr (aget h (aget w i)))]
        (inc! @v0)
        (inc! @v1)
        (inc! @v2)
        (inc! @v3)))))

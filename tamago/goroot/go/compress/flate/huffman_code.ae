        ;; For every level, the first two items are the first two characters.
        ;; We initialize the levels as if we had already figured this out.
        (aset levels level ^{:go/breaks [2 4 6 8]} (lit levelInfo
            :level level
            :lastFreq (conv int32 (.-freq (aget list 1)))
            :nextCharFreq (conv int32 (.-freq (aget list 2)))
            :nextPairFreq (+ (conv int32 (.-freq (aget list 0))) (conv int32 (.-freq (aget list 1))))))

        (aset (aget leafCounts level) level 2)
        (when (== level 1)
          (set! (.-nextPairFreq (aget levels level)) math/MaxInt32)))



      ;; We need a total of 2*n - 2 items at top level and have already generated 2.
      (set! (.-needed (aget levels maxBits)) (- (* 2 n) 4))


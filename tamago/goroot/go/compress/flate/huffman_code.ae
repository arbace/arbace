          (inc! code))

        (set! list (subslice list 0 (- (len list) (conv int bits))))))))






^{:go/end 382} (go/method generate "generate rewrites h to be the Huffman code for the given frequency count.\nfreq[i] is the frequency of literal i, and maxBits is the maximum number\nof bits to use for any literal.\n" [^{:tag (* huffmanEncoder)} h ^{:tag (slice uint16)} freq ^int32 maxBits]

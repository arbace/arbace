(in-ns 'go.compress.flate) (go/file "load_store.go" :imports [])

;; This file contains functions for loading and storing integers in little endian format.
;; These can be replaced with unsafe versions if deemed necessary.

(go/type indexer (interface
    (| int int8 int16 int32 int64 uint uint8 uint16 uint32 uint64)))



^{:go/end 17} (go/func loadLE8 "loadLE8 will load from b at index i.\n" :type-params [^indexer I] ^byte [^{:tag (slice byte)} b ^I i]
  (aget b i))



^{:go/end 23} (go/func loadLE32 "loadLE32 will load from b at index i.\n" :type-params [^indexer I] ^uint32 [^{:tag (slice byte)} b ^I i]
  (set! b (subslice b i (+ i 4)))
  (bit-or (conv uint32 (aget b 0)) (<< (conv uint32 (aget b 1)) 8) (<< (conv uint32 (aget b 2)) 16) (<< (conv uint32 (aget b 3)) 24)))



^{:go/end 30} (go/func loadLE64 "loadLE64 will load from b at index i.\n" :type-params [^indexer I] ^uint64 [^{:tag (slice byte)} b ^I i]
  (set! b (subslice b i (+ i 8)))
  (bit-or (conv uint64 (aget b 0)) (<< (conv uint64 (aget b 1)) 8) (<< (conv uint64 (aget b 2)) 16) (<< (conv uint64 (aget b 3)) 24)
    (<< (conv uint64 (aget b 4)) 32) (<< (conv uint64 (aget b 5)) 40) (<< (conv uint64 (aget b 6)) 48) (<< (conv uint64 (aget b 7)) 56)))



^{:go/end 43} (go/func storeLE64 "storeLE64 will store v at start of b.\n" [^{:tag (slice byte)} b ^uint64 v]
  (set! _ (aget b 7)) ; early bounds check to guarantee safety of writes below
  (aset b 0 (conv byte v))
  (aset b 1 (conv byte (>> v 8)))
  (aset b 2 (conv byte (>> v 16)))
  (aset b 3 (conv byte (>> v 24)))
  (aset b 4 (conv byte (>> v 32)))
  (aset b 5 (conv byte (>> v 40)))
  (aset b 6 (conv byte (>> v 48)))
  (aset b 7 (conv byte (>> v 56))))

(in-ns 'go.compress.flate) (go/file "regmask_other.go" :build ["//go:build !amd64"] :imports [])



(go/const ^{:val 255 :doc "shiftMask is a no-op shift mask for non-x86-64.\nThe compiler will optimize it away.\n"} reg8SizeMask64 0xff)

^{:go/end 784} (go/func fixedHuffmanDecoderInit []
  (.Do fixedOnce ^{:go/end 783} (fn []
      ;; These come from the RFC section 3.2.6.
      (let [^{:tag (array 288 int)} bits (zero (array 288 int))]
        (for [i 0] (< i 144) (inc! i)
          (aset bits i 8))

        (for [i 144] (< i 256) (inc! i)
          (aset bits i 9))

        (for [i 256] (< i 280) (inc! i)
          (aset bits i 7))

        (for [i 280] (< i 288) (inc! i)
          (aset bits i 8))

        (.init fixedHuffmanDecoder (subslice bits))))))




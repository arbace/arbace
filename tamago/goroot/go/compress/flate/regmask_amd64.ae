(in-ns 'go.compress.flate) (go/file "regmask_amd64.go" :imports [])



(go/const ^{:val 63 :doc "shiftMask is a no-op shift mask for x86-64.\nUsing it lets the compiler omit the check for shift size >= 64.\n"} reg8SizeMask64 63)

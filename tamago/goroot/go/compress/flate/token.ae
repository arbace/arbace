(go/type token "A token is a token that will be written to output stream.\nIt is either a literal or a match with offset and length.\n" uint32)




(go/type tokens "tokens are compound values as described above.\nHistograms are created as tokens are added.\nA full block is allocated.\n" (struct
    ^{:line 132 :tag (array 32 uint16)} extraHist ; codes 256->maxnumlit
    ^{:line 133 :tag (array 32 uint16)} offHist ; offset codes
    ^{:line 134 :tag (array 256 uint16)} litHist ; codes 0->255
    ^{:line 135 :tag int} nFilled
    ^{:line 136 :tag uint16} n ; Must be able to contain maxStoreBlockSize
    ^{:line 137 :tag (array 65536 token)} tokens))



^{:go/end 150} (go/method Reset "Reset resets the tokens and histograms.\n" [^{:tag (* tokens)} t]
  (when (== (.-n t) 0)
    (return))

  (set! (.-n t) 0)
  (set! (.-nFilled t) 0)
  (clear (subslice (.-litHist t)))
  (clear (subslice (.-extraHist t)))
  (clear (subslice (.-offHist t))))



^{:go/end 157} (go/func indexTokens "indexTokens creates tokens from a slice of unindexed tokens.\n" ^tokens [^{:tag (slice token)} in]
  (let [^tokens t (zero tokens)]
    (.indexTokens t in)
    ^{:line 156} t))



^{:go/end 169} (go/method indexTokens "indexTokens clears and sets t from a slice of unindexed tokens.\n" [^{:tag (* tokens)} t ^{:tag (slice token)} in]
  (.Reset t)
  (range [_ tok in]
    (when (< tok matchType)
      (.AddLiteral t (.literal tok))
      (continue))

    (.AddMatch t (conv uint32 (.length tok)) (bit-and (.offset tok) matchOffsetOnlyMask))))




^{:go/end 178} (go/func emitLiterals "emitLiterals writes a literal chunk and returns the number of bytes written.\n" [^{:tag (* tokens)} dst ^{:tag (slice byte)} lit]
  (range [_ v lit]
    (aset (.-tokens dst) (.-n dst) (conv token v))
    (inc! (aget (.-litHist dst) v))
    (inc! (.-n dst))))




^{:go/end 185} (go/method AddLiteral "AddLiteral adds a single literal to the tokens.\n" [^{:tag (* tokens)} t ^byte lit]
  (aset (.-tokens t) (.-n t) (conv token lit))
  (inc! (aget (.-litHist t) lit))
  (inc! (.-n t)))




^{:go/end 197} (go/func mFastLog2 "mFastLog2 returns a fast approximation of log2(val).\nFrom https://stackoverflow.com/a/28730362.\n" ^float32 [^float32 val]
  (let [ux (conv int32 (math/Float32bits val))
      ^{:line 191} log2 (conv float32 (- (bit-and (>> ux 23) 255) 128))]
    (set! ux bit-and -0x7f800001)
    (set! ux + (<< 127 23))
    (let [uval (math/Float32frombits (conv uint32 ux))]
      (set! log2 + (- (* (+ (* -0.34484843 uval) 2.02466578) uval) 0.67487759))
      ^{:line 196} log2)))






^{:go/end 238} (go/method EstimatedBits "EstimatedBits returns an estimated minimum size for the\noptimal compression of t.\nMinimum 1 bit is assigned per symbol.\nMaximum 15 bits are assigned per symbol.\n" ^int [^{:tag (* tokens)} t]
  (let [shannon (conv float32 0)
      ^{:line 205} bits (conv int 0)
      ^{:line 206} nMatches 0
      ^{:line 207} total (+ (conv int (.-n t)) (.-nFilled t))]
    (when (> total 0)
      (let [invTotal (/ 1.0 (conv float32 total))]
        (range [_ v (subslice (.-litHist t))]
          (when (> v 0)
            (let [n (conv float32 v)]
              (set! shannon + (* (min 15 (max 1 (- (mFastLog2 (* n invTotal))))) n)))))


        ;; Just add 15 for EOB
        (set! shannon + 15)
        (range [i v (subslice (.-extraHist t) 1 (- literalCount 256))]
          (when (> v 0)
            (let [n (conv float32 v)]
              (set! shannon + (* (min 15 (max 1 (- (mFastLog2 (* n invTotal))))) n))
              (set! bits + (* (conv int (aget lengthExtraBits (bit-and i 31))) (conv int v)))
              (set! nMatches + (conv int v)))))))



    (when (> nMatches 0)
      (let [invTotal (/ 1.0 (conv float32 nMatches))]
        (range [i v (subslice (.-offHist t) _ offsetCodeCount)]
          (when (> v 0)
            (let [n (conv float32 v)]
              (set! shannon + (* (min 15 (max 1 (- (mFastLog2 (* n invTotal))))) n))
              (set! bits + (* (conv int (aget offsetExtraBits (bit-and i 31))) (conv int v))))))))



    (+ (conv int shannon) bits)))




^{:go/end 250} (go/method AddMatch "AddMatch adds a match to the tokens.\nThis function is very sensitive to inlining and right on the border.\n" [^{:tag (* tokens)} t ^uint32 xlength ^uint32 xoffset]
  (let [oCode (offsetCode xoffset)]
    (set! xoffset bit-or (<< oCode 16))

    (inc! (aget (.-extraHist t) (aget lengthCodes1 (conv uint8 xlength))))
    (inc! (aget (.-offHist t) (bit-and oCode 31)))
    (aset (.-tokens t) (.-n t) (conv token (bit-or matchType (<< xlength lengthShift) xoffset)))
    (inc! (.-n t))))




^{:go/end 274} (go/method AddMatchLong "AddMatchLong adds a match to the tokens, potentially longer than max match length.\nLength should NOT have the base subtracted, only offset should.\n" [^{:tag (* tokens)} t ^int32 xlength ^uint32 xoffset]
  (let [oc (offsetCode xoffset)]
    (set! xoffset bit-or (<< oc 16))
    (while (> xlength 0)
      (let [xl xlength]
        (when (> xl 258)
          ;; We need to have at least baseMatchLength left over for next loop.
          (if (> xl (+ 258 baseMatchLength))
            (set! xl 258)

            (set! xl (- 258 baseMatchLength))))


        (set! xlength - xl)
        (set! xl - baseMatchLength)
        (inc! (aget (.-extraHist t) (aget lengthCodes1 (conv uint8 xl))))
        (inc! (aget (.-offHist t) (bit-and oc 31)))
        (aset (.-tokens t) (.-n t) (conv token (bit-or matchType (<< (conv uint32 xl) lengthShift) xoffset)))
        (inc! (.-n t))))))




^{:go/end 281} (go/method AddEOB "AddEOB adds an end of block marker to the tokens.\n" [^{:tag (* tokens)} t]
  (aset (.-tokens t) (.-n t) (conv token endBlockMarker))
  (inc! (aget (.-extraHist t) 0))
  (inc! (.-n t)))



^{:go/end 286} (go/method Slice "Slice returns a slice of the tokens that references the tokens in t.\n" ^{:tag (slice token)} [^{:tag (* tokens)} t]
  (subslice (.-tokens t) _ (.-n t)))



^{:go/end 289} (go/method typ "typ returns the type of a token.\n" ^uint32 [^token t] (bit-and (conv uint32 t) typeMask))


^{:go/end 292} (go/method literal "literal returns the literal value of t.\n" ^uint8 [^token t] (conv uint8 t))


^{:go/end 295} (go/method offset "offset returns the offset of a match token.\n" ^uint32 [^token t] (bit-and (conv uint32 t) offsetMask))


^{:go/end 298} (go/method length "length returns the length of a match token.\n" ^uint8 [^token t] (conv uint8 (>> t lengthShift)))


^{:go/end 301} (go/func lengthCode "lengthCode converts a match length to its code.\n" ^uint8 [^uint8 len] (aget lengthCodes len))


^{:go/end 309} (go/func offsetCode "offsetCode returns the offset code corresponding to a specific offset.\n" ^uint32 [^uint32 off]
  (when (< off (conv uint32 (len offsetCodes)))
    (return (aget offsetCodes (conv uint8 off))))

  (aget offsetCodes14 (conv uint8 (>> off 7))))

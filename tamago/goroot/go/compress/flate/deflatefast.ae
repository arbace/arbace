^{:go/end 176} (go/func hashLen "hashLen returns a hash of the first n bytes of u, using b output bits.\nIt expects 3 <= n <= 8; other values are treated as n == 4.\nThe bit length b must be <= 32.\nb and n should be constants in speed-critical use.\n" ^uint32 [^uint64 u ^uint8 b ^uint8 n]
  (switch n
    (case [3]
      (return (>> (* (conv uint32 (<< u 8)) prime3bytes) (- 32 b))))
    (case [5]
      (return (conv uint32 (>> (* (<< u (- 64 40)) prime5bytes) (- 64 b)))))
    (case [6]
      (return (conv uint32 (>> (* (<< u (- 64 48)) prime6bytes) (- 64 b)))))
    (case [7]
      (return (conv uint32 (>> (* (<< u (- 64 56)) prime7bytes) (- 64 b)))))
    (case [8]
      (return (conv uint32 (>> (* u prime8bytes) (- 64 b)))))
    (default
      (return (>> (* (conv uint32 u) prime4bytes) (- 32 b))))))





^{:go/end 201} (go/func matchLen "matchLen returns the maximum common prefix length of a and b.\na must be the shortest of the two.\n" [^{:tag (slice byte)} a ^{:tag (slice byte)} b] :results [^int n]
  (let [left (len a)]
    (while (>= left 8)
      (let [diff (bit-xor (^{:inst [int]} loadLE64 a n) (^{:inst [int]} loadLE64 b n))]
        (when (!= diff 0)
          (return (+ n (>> (bits/TrailingZeros64 diff) 3))))

        (set! n + 8)
        (set! left - 8)))


    (set! a (subslice a n))
    (set! b (subslice b n))
    (set! b (subslice b _ (len a)))
    (range [i a]
      (when (!= (aget a i) (aget b i))
        (break))

      (inc! n))

    ^{:line 200} n))

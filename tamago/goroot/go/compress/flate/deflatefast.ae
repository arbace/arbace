;; fastEncL1 to fastEncL6 provides specialized encoders for levels 1-6
;; that each provide a different speed/size/memory strategies.
;;
;; Level 1: Single small table, 5 byte hashes, sparse indexing.
;; Level 2: Single big table, 5 byte hashes, indexing ~ every 2 bytes.
;; Level 3: Single medium table, 5 byte hashes, 2 candidates per table entry.
;; Level 4: Two tables, 4/7 byte hashes, 1 candidate per table entry.
;; Level 5: Two tables, 4/7 byte hashes, 2 candidates per 7-byte table entry.
;; Level 6: Two tables, 4/7 byte hashes, full indexing, checks for repeats.
;;
;; Skipping on contiguous non-matches also decreases as levels go up.


(go/type fastEnc "fastEnc is the interface implemented by the level 1-6 fast encoders.\n" (interface

    (^{:doc "encode src into dst.\n"} encode [^{:tag (* tokens)} dst ^{:tag (slice byte)} src])

    (^{:doc "reset the encoder so matches are not made with previous data.\n"} reset [])))



^{:go/end 75} (go/func newFastEnc "newFastEnc returns a fastEnc encoder for the given compression level (1-6).\n" ^fastEnc [^int level]
  (switch level
    (case [1]
      (return (addr (lit fastEncL1 :fastGen (lit fastGen :cur maxStoreBlockSize)))))
    (case [2]
      (return (addr (lit fastEncL2 :fastGen (lit fastGen :cur maxStoreBlockSize)))))
    (case [3]
      (return (addr (lit fastEncL3 :fastGen (lit fastGen :cur maxStoreBlockSize)))))
    (case [4]
      (return (addr (lit fastEncL4 :fastGen (lit fastGen :cur maxStoreBlockSize)))))
    (case [5]
      (return (addr (lit fastEncL5 :fastGen (lit fastGen :cur maxStoreBlockSize)))))
    (case [6]
      (return (addr (lit fastEncL6 :fastGen (lit fastGen :cur maxStoreBlockSize)))))
    (default
      (panic "invalid level specified"))))






(go/type fastGen "fastGen maintains the table for matches,\nand the previous byte block for level 1 and up.\nThis is the generic implementation.\n" (struct
    ^{:line 81 :tag (slice byte)} hist
    ^{:line 82 :tag int32} cur))



^{:go/end 105} (go/method addBlock "addBlock appends src to the history and returns the offset where src starts in e.hist.\n" ^int32 [^{:tag (* fastGen)} e ^{:tag (slice byte)} src]
  ;; check if we have space already
  (when (> (+ (len (.-hist e)) (len src)) (cap (.-hist e)))
    (if (== (cap (.-hist e)) 0)
      (set! (.-hist e) (make (slice byte) 0 allocHistory))
      (do
        (when (< (cap (.-hist e)) (* maxMatchOffset 2))
          (panic "unexpected buffer size"))

        ;; Move down
        (let [offset (- (conv int32 (len (.-hist e))) maxMatchOffset)]
          (copy (subslice (.-hist e) 0 maxMatchOffset) (subslice (.-hist e) offset (+ offset maxMatchOffset)))
          (set! (.-cur e) + offset)
          (set! (.-hist e) (subslice (.-hist e) _ maxMatchOffset))))))


  (let [s (conv int32 (len (.-hist e)))]
    (set! (.-hist e) (append (.-hist e) (spread src)))
    ^{:line 104} s))





^{:go/end 114} (go/method matchLenLimited "matchLenLimited returns the match length between offsets s and t in src.\nThe maximum length returned is maxMatchLength - 4.\nIt is assumed that s > t, that t >= 0 and s < len(src).\n" ^int32 [^{:tag (* fastGen)} e ^int s ^int t ^{:tag (slice byte)} src]
  (let [a (subslice src s (min (- (+ s maxMatchLength) 4) (len src)))
      ^{:line 112} b (subslice src t)]
    (conv int32 (matchLen a b))))




^{:go/end 120} (go/method matchLenLong "matchLenLong returns the match length between offsets s and t in src.\nIt is assumed that s > t, that t >= 0 and s < len(src).\n" ^int32 [^{:tag (* fastGen)} e ^int s ^int t ^{:tag (slice byte)} src]
  (conv int32 (matchLen (subslice src s) (subslice src t))))



^{:go/end 133} (go/method reset "reset resets the encoding table to prepare for a new compression stream.\n" [^{:tag (* fastGen)} e]
  (when (< (cap (.-hist e)) allocHistory)
    (set! (.-hist e) (make (slice byte) 0 allocHistory)))

  ;; We offset current position so everything will be out of reach.
  ;; If we are above the buffer reset it will be cleared anyway since len(hist) == 0.
  (when (<= (.-cur e) bufferReset)
    (set! (.-cur e) + (+ maxMatchOffset (conv int32 (len (.-hist e))))))

  (set! (.-hist e) (subslice (.-hist e) _ 0)))



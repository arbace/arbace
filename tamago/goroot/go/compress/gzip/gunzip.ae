;; Package gzip implements reading and writing of gzip format compressed files,
;; as specified in RFC 1952.
(in-ns 'go.compress.gzip) (go/file "gunzip.go" :doc "Package gzip implements reading and writing of gzip format compressed files,\nas specified in RFC 1952.\n" :imports [


    ^{:line 10} [bufio "bufio"]
    ^{:line 11} [flate "compress/flate"]
    ^{:line 12} [binary "encoding/binary"]
    ^{:line 13} [errors "errors"]
    ^{:line 14} [crc32 "hash/crc32"]
    ^{:line 15} [io "io"]
    ^{:line 16} [time "time"]])


(go/const
  ^{:line 20} [^{:val 31} gzipID1 0x1f]
  ^{:line 21} [^{:val 139} gzipID2 0x8b]
  ^{:line 22} [^{:val 8} gzipDeflate 8]
  ^{:line 23} [^{:val 1} flagText (<< 1 0)]
  ^{:line 24} [^{:val 2} flagHdrCrc (<< 1 1)]
  ^{:line 25} [^{:val 4} flagExtra (<< 1 2)]
  ^{:line 26} [^{:val 8} flagName (<< 1 3)]
  ^{:line 27} [^{:val 16} flagComment (<< 1 4)])


(go/var

  ^{:line 32} [^{:doc "ErrChecksum is returned when reading GZIP data that has an invalid checksum.\n"} ErrChecksum (errors/New "gzip: invalid checksum")]

  ^{:line 34} [^{:doc "ErrHeader is returned when reading GZIP data that has an invalid header.\n"} ErrHeader (errors/New "gzip: invalid header")])


(go/var le binary/LittleEndian)


^{:go/end 45} (go/func noEOF "noEOF converts io.EOF to io.ErrUnexpectedEOF.\n" ^error [^error err]
  (when (== err io/EOF)
    (return io/ErrUnexpectedEOF))

  ^{:line 44} err)







(go/type Header "The gzip file stores a header giving metadata about the compressed file.\nThat header is exposed as the fields of the [Writer] and [Reader] structs.\n\nStrings must be UTF-8 encoded and may only contain Unicode code points\nU+0001 through U+00FF, due to limitations of the GZIP file format.\n" (struct
    ^{:line 53 :tag string} Comment ; comment
    ^{:line 54 :tag (slice byte)} Extra ; "extra data"
    ^{:line 55 :tag time/Time} ModTime ; modification time
    ^{:line 56 :tag string} Name ; file name
    ^{:line 57 :tag byte} OS)) ; operating system type
















(go/type Reader "A Reader is an [io.Reader] that can be read to retrieve\nuncompressed data from a gzip-format compressed file.\n\nIn general, a gzip file can be a concatenation of gzip files,\neach with its own header. Reads from the Reader\nreturn the concatenation of the uncompressed data of each.\nOnly the first header is recorded in the Reader fields.\n\nGzip files store a length and checksum of the uncompressed data.\nThe Reader will return an [ErrChecksum] when [Reader.Read]\nreaches the end of the uncompressed data if it does not\nhave the expected length or checksum. Clients should treat data\nreturned by [Reader.Read] as tentative until they receive the [io.EOF]\nmarking the end of the data.\n" (struct
    ^{:line 75} Header ; valid after NewReader or Reader.Reset
    ^{:line 76 :tag flate/Reader} r
    ^{:line 77 :tag io/ReadCloser} decompressor
    ^{:line 78 :tag uint32} digest ; CRC-32, IEEE polynomial (section 8)
    ^{:line 79 :tag uint32} size ; Uncompressed size (section 2.3.1)
    ^{:line 80 :tag (array 512 byte)} buf
    ^{:line 81 :tag error} err
    ^{:line 82 :tag bool} multistream))









^{:go/end 98} (go/func NewReader "NewReader creates a new [Reader] reading the given reader.\nIf r does not also implement [io.ByteReader],\nthe decompressor may read more data than necessary from r.\n\nIt is the caller's responsibility to call [Reader.Close] when done.\n\nThe Reader.[Header] fields will be valid in the [Reader] returned.\n" [^io/Reader r] :results [(* Reader) error]
  (let [z (new Reader)]
    (when [err (.Reset z r)] (!= err nil)
      (return nil err))

    (return z nil)))





^{:go/end 115} (go/method Reset "Reset discards the [Reader] z's state and makes it equivalent to the\nresult of its original state from [NewReader], but reading from r instead.\nThis permits reusing a [Reader] rather than allocating a new one.\n" ^error [^{:tag (* Reader)} z ^io/Reader r]
  (set! @z ^{:go/breaks [2 4]} (lit Reader
      :decompressor (.-decompressor z)
      :multistream true))

  (if [(values rr ok) (assert flate/Reader r)] ok
    (set! (.-r z) rr)

    (set! (.-r z) (bufio/NewReader r)))

  (set! (values (.-Header z) (.-err z)) (.readHeader z))
  (.-err z))


















^{:go/end 135} (go/method Multistream "Multistream controls whether the reader supports multistream files.\n\nIf enabled (the default), the [Reader] expects the input to be a sequence\nof individually gzipped data streams, each with its own header and\ntrailer, ending at EOF. The effect is that the concatenation of a sequence\nof gzipped files is treated as equivalent to the gzip of the concatenation\nof the sequence. This is standard behavior for gzip readers.\n\nCalling Multistream(false) disables this behavior; disabling the behavior\ncan be useful when reading file formats that distinguish individual gzip\ndata streams or mix gzip data streams with other data streams.\nIn this mode, when the [Reader] reaches the end of the data stream,\n[Reader.Read] returns [io.EOF]. The underlying reader must implement [io.ByteReader]\nin order to be left positioned just after the gzip stream.\nTo start the next stream, call z.Reset(r) followed by z.Multistream(false).\nIf there is no next stream, z.Reset(r) will return [io.EOF].\n" [^{:tag (* Reader)} z ^bool ok]
  (set! (.-multistream z) ok))






^{:go/end 170} (go/method readString "readString reads a NUL-terminated string from z.r.\nIt treats the bytes read as being encoded as ISO 8859-1 (Latin-1) and\nwill output a string encoded using UTF-8.\nThis method always updates z.digest with the data read.\n" [^{:tag (* Reader)} z] :results [string error]
  (let [^error err (zero error)
      ^{:line 143} needConv false]
    (for [i 0] _ (inc! i)
      (when (>= i (len (.-buf z)))
        (return "" ErrHeader))

      (set! (values (aget (.-buf z) i) err) (.ReadByte (.-r z)))
      (when (!= err nil)
        (return "" err))

      (when (> (aget (.-buf z) i) 0x7f)
        (set! needConv true))

      (when (== (aget (.-buf z) i) 0)
        ;; Digest covers the NUL terminator.
        (set! (.-digest z) (crc32/Update (.-digest z) crc32/IEEETable (subslice (.-buf z) _ (+ i 1))))

        ;; Strings are ISO 8859-1, Latin-1 (RFC 1952, section 2.3.1).
        (when needConv
          (let [s (make (slice rune) 0 i)]
            (range [_ v (subslice (.-buf z) _ i)]
              (set! s (append s (conv rune v))))

            (return (conv string s) nil)))

        (return (conv string (subslice (.-buf z) _ i)) nil)))))






^{:go/end 243} (go/method readHeader "readHeader reads the GZIP header according to section 2.3.1.\nThis method does not set z.err.\n" [^{:tag (* Reader)} z] :results [^Header hdr ^error err]
  (when [(set! (values _ err) (io/ReadFull (.-r z) (subslice (.-buf z) _ 10)))] (!= err nil)
    ;; RFC 1952, section 2.2, says the following:
    ;;	A gzip file consists of a series of "members" (compressed data sets).
    ;;
    ;; Other than this, the specification does not clarify whether a
    ;; "series" is defined as "one or more" or "zero or more". To err on the
    ;; side of caution, Go interprets this to mean "zero or more".
    ;; Thus, it is okay to return io.EOF here.
    (return hdr err))

  (when (or (!= (aget (.-buf z) 0) gzipID1) (!= (aget (.-buf z) 1) gzipID2) (!= (aget (.-buf z) 2) gzipDeflate))
    (return hdr ErrHeader))

  (let [flg (aget (.-buf z) 3)]
    (when [t (conv int64 (.Uint32 le (subslice (.-buf z) 4 8)))] (> t 0)
      ;; Section 2.3.1, the zero value for MTIME means that the
      ;; modified time is not set.
      (set! (.-ModTime hdr) (time/Unix t 0)))

    ;; z.buf[8] is XFL and is currently ignored.
    (set! (.-OS hdr) (aget (.-buf z) 9))
    (set! (.-digest z) (crc32/ChecksumIEEE (subslice (.-buf z) _ 10)))

    (when (!= (bit-and flg flagExtra) 0)
      (when [(set! (values _ err) (io/ReadFull (.-r z) (subslice (.-buf z) _ 2)))] (!= err nil)
        (return hdr (noEOF err)))

      (set! (.-digest z) (crc32/Update (.-digest z) crc32/IEEETable (subslice (.-buf z) _ 2)))
      (let [data (make (slice byte) (.Uint16 le (subslice (.-buf z) _ 2)))]
        (when [(set! (values _ err) (io/ReadFull (.-r z) data))] (!= err nil)
          (return hdr (noEOF err)))

        (set! (.-digest z) (crc32/Update (.-digest z) crc32/IEEETable data))
        (set! (.-Extra hdr) data)))


    (let [^string s (zero string)]
      (when (!= (bit-and flg flagName) 0)
        (when [(set! (values s err) (.readString z))] (!= err nil)
          (return hdr (noEOF err)))

        (set! (.-Name hdr) s))


      (when (!= (bit-and flg flagComment) 0)
        (when [(set! (values s err) (.readString z))] (!= err nil)
          (return hdr (noEOF err)))

        (set! (.-Comment hdr) s))


      (when (!= (bit-and flg flagHdrCrc) 0)
        (when [(set! (values _ err) (io/ReadFull (.-r z) (subslice (.-buf z) _ 2)))] (!= err nil)
          (return hdr (noEOF err)))

        (let [digest (.Uint16 le (subslice (.-buf z) _ 2))]
          (when (!= digest (conv uint16 (.-digest z)))
            (return hdr ErrHeader))))



      (set! (.-digest z) 0)
      (if (== (.-decompressor z) nil)
        (set! (.-decompressor z) (flate/NewReader (.-r z)))

        (.Reset (assert flate/Resetter (.-decompressor z)) (.-r z) nil))

      (return hdr nil))))



^{:go/end 285} (go/method Read "Read implements [io.Reader], reading uncompressed bytes from its underlying reader.\n" [^{:tag (* Reader)} z ^{:tag (slice byte)} p] :results [^int n ^error err]
  (when (!= (.-err z) nil)
    (return 0 (.-err z)))


  (while (== n 0)
    (set! (values n (.-err z)) (.Read (.-decompressor z) p))
    (set! (.-digest z) (crc32/Update (.-digest z) crc32/IEEETable (subslice p _ n)))
    (set! (.-size z) + (conv uint32 n))
    (when (!= (.-err z) io/EOF)
      ;; In the normal case we return here.
      (return n (.-err z)))


    ;; Finished file; check checksum and size.
    (when [(values _ err) (io/ReadFull (.-r z) (subslice (.-buf z) _ 8))] (!= err nil)
      (set! (.-err z) (noEOF err))
      (return n (.-err z)))

    (let [digest (.Uint32 le (subslice (.-buf z) _ 4))
        ^{:line 266} size (.Uint32 le (subslice (.-buf z) 4 8))]
      (when (or (!= digest (.-digest z)) (!= size (.-size z)))
        (set! (.-err z) ErrChecksum)
        (return n (.-err z)))

      (set! (values (.-digest z) (.-size z)) (values 0 0))

      ;; File is ok; check if there is another.
      (when (not (.-multistream z))
        (return n io/EOF))

      (set! (.-err z) nil) ; Remove io.EOF

      (when [(set! (values _ (.-err z)) (.readHeader z))] (!= (.-err z) nil)
        (return n (.-err z)))))



  (return n nil))





^{:go/end 290} (go/method Close "Close closes the [Reader]. It does not close the underlying reader.\nIn order for the GZIP checksum to be verified, the reader must be\nfully consumed until the [io.EOF].\n" ^error [^{:tag (* Reader)} z] (.Close (.-decompressor z)))

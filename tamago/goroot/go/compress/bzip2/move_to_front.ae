(in-ns 'go.compress.bzip2) (go/file "move_to_front.go" :imports [])








(go/type moveToFrontDecoder "moveToFrontDecoder implements a move-to-front list. Such a list is an\nefficient way to transform a string with repeating elements into one with\nmany small valued numbers, which is suitable for entropy encoding. It works\nby starting with an initial list of symbols and references symbols by their\nindex into that list. When a symbol is referenced, it's moved to the front\nof the list. Thus, a repeated symbol ends up being encoded with many zeros,\nas the symbol will be at the front of the list after the first access.\n" (slice byte))



^{:go/end 23} (go/func newMTFDecoder "newMTFDecoder creates a move-to-front decoder with an explicit initial list\nof symbols.\n" ^moveToFrontDecoder [^{:tag (slice byte)} symbols]
  (when (> (len symbols) 256)
    (panic "too many symbols"))

  (conv moveToFrontDecoder symbols))




^{:go/end 37} (go/func newMTFDecoderWithRange "newMTFDecoderWithRange creates a move-to-front decoder with an initial\nsymbol list of 0...n-1.\n" ^moveToFrontDecoder [^int n]
  (when (> n 256)
    (panic "newMTFDecoderWithRange: cannot have > 256 symbols"))


  (let [m (make (slice byte) n)]
    (for [i 0] (< i n) (inc! i)
      (aset m i (conv byte i)))

    (conv moveToFrontDecoder m)))


^{:go/end 48} (go/method Decode [^moveToFrontDecoder m ^int n] :results [^byte b]
  ;; Implement move-to-front with a simple copy. This approach
  ;; beats more sophisticated approaches in benchmarking, probably
  ;; because it has high locality of reference inside of a
  ;; single cache line (most move-to-front operations have n < 64).
  (set! b (aget m n))
  (copy (subslice m 1) (subslice m _ n))
  (aset m 0 b)
  (return))



^{:go/end 53} (go/method First "First returns the symbol at the front of the list.\n" ^byte [^moveToFrontDecoder m]
  (aget m 0))

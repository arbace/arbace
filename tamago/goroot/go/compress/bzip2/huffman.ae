^{:go/end 142} (go/func newHuffmanTree "newHuffmanTree builds a Huffman tree from a slice containing the code\nlengths of each symbol. The maximum code length is 32 bits.\n" [^{:tag (slice uint8)} lengths] :results [huffmanTree error]

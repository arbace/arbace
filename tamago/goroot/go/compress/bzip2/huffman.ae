      ;; First we sort the code length assignments by ascending code length,
      ;; using the symbol value to break ties.
      ^{:line 100} pairs (make (slice huffmanSymbolLengthPair) (len lengths))]
    (range [i length lengths]
      (set! (.-value (aget pairs i)) (conv uint16 i))
      (set! (.-length (aget pairs i)) length))


    (^{:inst [(slice huffmanSymbolLengthPair) huffmanSymbolLengthPair]} slices/SortFunc pairs ^{:go/end 111} (fn ^int [^huffmanSymbolLengthPair a ^huffmanSymbolLengthPair b]
        (when [c (^{:inst [uint8]} cmp/Compare (.-length a) (.-length b))] (!= c 0)

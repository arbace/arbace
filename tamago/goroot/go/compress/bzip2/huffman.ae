^{:go/end 234} (go/func buildHuffmanNode "buildHuffmanNode takes a slice of sorted huffmanCodes and builds a node in\nthe Huffman tree at the given level. It returns the index of the newly\nconstructed node.\n" [^{:tag (* huffmanTree)} t ^{:tag (slice huffmanCode)} codes ^uint32 level] :results [^uint16 nodeIndex ^error err]

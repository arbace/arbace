        ;; like a |length| bit number.
        (set! code + ^uint32 (<< 1 (- 32 length))))


      ;; Now we can sort by the code so that the left half of each branch are
      ;; grouped together, recursively.
      (^{:inst [(slice huffmanCode) huffmanCode]} slices/SortFunc codes ^{:go/end 137} (fn ^int [^huffmanCode a ^huffmanCode b]
          (^{:inst [uint32]} cmp/Compare (.-code a) (.-code b))))


      (set! (.-nodes t) (make (slice huffmanNode) (len codes)))

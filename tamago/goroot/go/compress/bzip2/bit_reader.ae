(in-ns 'go.compress.bzip2) (go/file "bit_reader.go" :imports [


    ^{:line 8} [bufio "bufio"]
    ^{:line 9} [io "io"]])






(go/type bitReader "bitReader wraps an io.Reader and provides the ability to read values,\nbit-by-bit, from it. Its Read* methods don't return the usual error\nbecause the error handling was verbose. Instead, any error is kept and can\nbe checked afterwards.\n" (struct
    ^{:line 17 :tag io/ByteReader} r
    ^{:line 18 :tag uint64} n
    ^{:line 19 :tag uint} bits
    ^{:line 20 :tag error} err))




^{:go/end 31} (go/func newBitReader "newBitReader returns a new bitReader reading from r. If r is not\nalready an io.ByteReader, it will be converted via a bufio.Reader.\n" ^bitReader [^io/Reader r]
  (let [(values byter ok) (assert io/ByteReader r)]
    (when (not ok)
      (set! byter (bufio/NewReader r)))

    (lit bitReader :r byter)))





^{:go/end 68} (go/method ReadBits64 "ReadBits64 reads the given number of bits and returns them in the\nleast-significant part of a uint64. In the event of an error, it returns 0\nand the error can be obtained by calling bitReader.Err().\n" [^{:tag (* bitReader)} br ^uint bits] :results [^uint64 n]
  (while (> bits (.-bits br))
    (let [(values b err) (.ReadByte (.-r br))]
      (when (== err io/EOF)
        (set! err io/ErrUnexpectedEOF))

      (when (!= err nil)
        (set! (.-err br) err)
        (return 0))

      (set! (.-n br) << 8)
      (set! (.-n br) bit-or (conv uint64 b))
      (set! (.-bits br) + 8)))


  ;; br.n looks like this (assuming that br.bits = 14 and bits = 6):
  ;; Bit: 111111
  ;;      5432109876543210
  ;;
  ;;         (6 bits, the desired output)
  ;;        |-----|
  ;;        V     V
  ;;      0101101101001110
  ;;        ^            ^
  ;;        |------------|
  ;;           br.bits (num valid bits)
  ;;
  ;; The next line right shifts the desired bits into the
  ;; least-significant places and masks off anything above.
  (set! n (bit-and (>> (.-n br) (- (.-bits br) bits)) (- ^uint64 (<< 1 bits) 1)))
  (set! (.-bits br) - bits)
  (return))


^{:go/end 73} (go/method ReadBits [^{:tag (* bitReader)} br ^uint bits] :results [^int n]
  (let [n64 (.ReadBits64 br bits)]
    (conv int n64)))


^{:go/end 78} (go/method ReadBit ^bool [^{:tag (* bitReader)} br]
  (let [n (.ReadBits br 1)]
    (!= n 0)))


^{:go/end 82} (go/method Err ^error [^{:tag (* bitReader)} br]
  (.-err br))

    ^{:line 30 :tag bool} eof
    ^{:line 31 :tag int} blockSize ; blockSize in bytes, i.e. 900 * 1000.
    ^{:line 32 :tag (array 256 uint)} c ; the ``C'' array for the inverse BWT.
    ^{:line 33 :tag (slice uint32)} tt ; mirrors the ``tt'' array in the bzip2 source and contains the P array in the upper 24 bits.
    ^{:line 34 :tag uint32} tPos ; Index of the next output byte in tt.

    ^{:line 36 :tag (slice uint32)} preRLE ; contains the RLE data still to be processed.
    ^{:line 37 :tag int} preRLEUsed ; number of entries of preRLE used.
    ^{:line 38 :tag int} lastByte ; the last byte value seen.
    ^{:line 39 :tag uint} byteRepeats ; the number of repeats of lastByte seen.
    ^{:line 40 :tag uint} repeats)) ; the number of copies of lastByte to output.





^{:go/end 50} (go/func NewReader "NewReader returns an [io.Reader] which decompresses bzip2 data from r.\nIf r does not also implement [io.ByteReader],\nthe decompressor may read more data than necessary from r.\n" ^io/Reader [^io/Reader r]

    ^{:line 49} bz2))


(go/const ^{:val 16986} bzip2FileMagic 0x425a) ; "BZ"
(go/const ^{:val 54156738319193} bzip2BlockMagic 0x314159265359)
(go/const ^{:val 25779555029136} bzip2FinalMagic 0x177245385090)


^{:go/end 83} (go/method setup "setup parses the bzip2 header.\n" ^error [^{:tag (* reader)} bz2 ^bool needMagic]
  (let [br (addr (.-br bz2))]

    (when needMagic
      (let [magic (.ReadBits br 16)]
        (when (!= magic bzip2FileMagic)
          (return (conv StructuralError "bad magic value")))))



    (let [t (.ReadBits br 8)]
      (when (!= t \h)
        (return (conv StructuralError "non-Huffman entropy encoding")))


      ^{:go/breaks [[6 82]]} (let [level (.ReadBits br 8)]
        (when (or (< level \1) (> level \9))
          (return (conv StructuralError "invalid compression level")))


        (set! (.-fileCRC bz2) 0)
        (set! (.-blockSize bz2) (* 100 1000 (- level \0)))
        (when (> (.-blockSize bz2) (len (.-tt bz2)))
          (set! (.-tt bz2) (make (slice uint32) (.-blockSize bz2))))

        nil))))


^{:go/end 108} (go/method Read [^{:tag (* reader)} bz2 ^{:tag (slice byte)} buf] :results [^int n ^error err]
  (when (.-eof bz2)
    (return 0 io/EOF))


  (when (not (.-setupDone bz2))
    (set! err (.setup bz2 true))
    (let [brErr (.Err (.-br bz2))]
      (when (!= brErr nil)
        (set! err brErr))

      (when (!= err nil)
        (return 0 err))

      (set! (.-setupDone bz2) true)))


  (set! (values n err) (.read bz2 buf))
  (let [brErr (.Err (.-br bz2))]
    (when (!= brErr nil)
      (set! err brErr))

    (return)))


^{:go/end 161} (go/method readFromBlock ^int [^{:tag (* reader)} bz2 ^{:tag (slice byte)} buf]
  ;; bzip2 is a block based compressor, except that it has a run-length
  ;; preprocessing step. The block based nature means that we can
  ;; preallocate fixed-size buffers and reuse them. However, the RLE
  ;; preprocessing would require allocating huge buffers to store the
  ;; maximum expansion. Thus we process blocks all at once, except for
  ;; the RLE which we decompress as required.
  (let [n 0]
    (while (and ^:go/paren (or (> (.-repeats bz2) 0) (< (.-preRLEUsed bz2) (len (.-preRLE bz2)))) (< n (len buf)))
      ;; We have RLE data pending.

      ;; The run-length encoding works like this:
      ;; Any sequence of four equal bytes is followed by a length
      ;; byte which contains the number of repeats of that byte to
      ;; include. (The number of repeats can be zero.) Because we are
      ;; decompressing on-demand our state is kept in the reader
      ;; object.

      (when (> (.-repeats bz2) 0)
        (aset buf n (conv byte (.-lastByte bz2)))
        (inc! n)
        (dec! (.-repeats bz2))
        (when (== (.-repeats bz2) 0)
          (set! (.-lastByte bz2) -1))

        (continue))


      (set! (.-tPos bz2) (aget (.-preRLE bz2) (.-tPos bz2)))
      (let [b (conv byte (.-tPos bz2))]
        (set! (.-tPos bz2) >> 8)
        (inc! (.-preRLEUsed bz2))

        (when (== (.-byteRepeats bz2) 3)
          (set! (.-repeats bz2) (conv uint b))
          (set! (.-byteRepeats bz2) 0)
          (continue))


        (if (== (.-lastByte bz2) (conv int b))
          (inc! (.-byteRepeats bz2))

          (set! (.-byteRepeats bz2) 0))

        (set! (.-lastByte bz2) (conv int b))

        (aset buf n b)
        (inc! n)))


    ^{:line 160} n))


^{:go/end 233} (go/method read [^{:tag (* reader)} bz2 ^{:tag (slice byte)} buf] :results [int error]
  (while true
    (let [n (.readFromBlock bz2 buf)]
      (when (or (> n 0) (== (len buf) 0))
        (set! (.-blockCRC bz2) (updateCRC (.-blockCRC bz2) (subslice buf _ n)))
        (return n nil))


      ;; End of block. Check CRC.
      (when (!= (.-blockCRC bz2) (.-wantBlockCRC bz2))
        (set! (.-err (.-br bz2)) (conv StructuralError "block checksum mismatch"))
        (return 0 (.-err (.-br bz2))))


      ;; Find next block.
      (let [br (addr (.-br bz2))]
        (switch (.ReadBits64 br 48)
          (default
            (return 0 (conv StructuralError "bad magic value found")))

          (case [bzip2BlockMagic]
            ;; Start of block.
            (let [err (.readBlock bz2)]
              (when (!= err nil)
                (return 0 err))))


          (case [bzip2FinalMagic]
            ;; Check end-of-file CRC.
            (let [wantFileCRC (conv uint32 (.ReadBits64 br 32))]
              (when (!= (.-err br) nil)
                (return 0 (.-err br)))

              (when (!= (.-fileCRC bz2) wantFileCRC)
                (set! (.-err br) (conv StructuralError "file checksum mismatch"))
                (return 0 (.-err br)))


              ;; Skip ahead to byte boundary.
              ;; Is there a file concatenated to this one?
              ;; It would start with BZ.
              (when (!= (% (.-bits br) 8) 0)
                (.ReadBits br (% (.-bits br) 8)))

              (let [(values b err) (.ReadByte (.-r br))]
                (when (== err io/EOF)
                  (set! (.-err br) io/EOF)
                  (set! (.-eof bz2) true)
                  (return 0 io/EOF))

                (when (!= err nil)
                  (set! (.-err br) err)
                  (return 0 err))

                (let [(values z ^:assign err) (.ReadByte (.-r br))]
                  (when (!= err nil)
                    (when (== err io/EOF)
                      (set! err io/ErrUnexpectedEOF))

                    (set! (.-err br) err)
                    (return 0 err))

                  (when (or (!= b \B) (!= z \Z))
                    (return 0 (conv StructuralError "bad magic value in continuation file")))

                  (when [err (.setup bz2 false)] (!= err nil)

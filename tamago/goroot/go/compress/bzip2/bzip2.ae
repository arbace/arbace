^{:go/end 444} (go/method readBlock "readBlock reads a bzip2 block. The magic number should already have been consumed.\n" [^{:tag (* reader)} bz2] :results [^error err]
  (let [br (addr (.-br bz2))]
    (set! (.-wantBlockCRC bz2) (conv uint32 (.ReadBits64 br 32))) ; skip checksum. TODO: check it if we can figure out what it is.
    (set! (.-blockCRC bz2) 0)

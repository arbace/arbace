(ns go.compress.bzip2
  (:require [arbace.go :as go]))

(go/package bzip2
  :path "compress/bzip2"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["bit_reader.go" "bzip2.go" "huffman.go" "move_to_front.go"]
  :init-order []
  :positions :lines)

(load "bzip2/bit_reader")
(load "bzip2/bzip2")
(load "bzip2/huffman")
(load "bzip2/move_to_front")

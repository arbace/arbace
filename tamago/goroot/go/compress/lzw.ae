(ns go.compress.lzw
  (:require [arbace.go :as go]))

(go/package lzw
  :path "compress/lzw"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["reader.go" "writer.go"]
  :init-order [errClosed errOutOfCodes]
  :positions :lines)

(load "lzw/reader")
(load "lzw/writer")

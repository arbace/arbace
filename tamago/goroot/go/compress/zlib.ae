(ns go.compress.zlib
  (:require [arbace.go :as go]))

(go/package zlib
  :path "compress/zlib"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["reader.go" "writer.go"]
  :init-order [ErrChecksum ErrDictionary ErrHeader]
  :positions :lines)

(load "zlib/reader")
(load "zlib/writer")

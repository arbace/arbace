(ns go.compress.gzip
  (:require [arbace.go :as go]))

(go/package gzip
  :path "compress/gzip"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["gunzip.go" "gzip.go"]
  :init-order [ErrChecksum ErrHeader le]
  :positions :lines)

(load "gzip/gunzip")
(load "gzip/gzip")

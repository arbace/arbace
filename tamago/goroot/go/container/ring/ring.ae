;; Package ring implements operations on circular lists.
(in-ns 'go.container.ring) (go/file "ring.go" :doc "Package ring implements operations on circular lists.\n" :imports [])






(go/type Ring "A Ring is an element of a circular list, or ring.\nRings do not have a beginning or end; a pointer to any ring element\nserves as reference to the entire ring. Empty rings are represented\nas nil Ring pointers. The zero value for a Ring is a one-element\nring with a nil Value.\n" (struct
    ^{:line 14 :tag (* Ring)} next ^{:tag (* Ring)} prev
    ^{:line 15 :tag any} Value)) ; for use by client; untouched by this library


^{:go/end 22} (go/method init ^{:tag (* Ring)} [^{:tag (* Ring)} r]
  (set! (.-next r) r)
  (set! (.-prev r) r)
  ^{:line 21} r)



^{:go/end 30} (go/method Next "Next returns the next ring element. r must not be empty.\n" ^{:tag (* Ring)} [^{:tag (* Ring)} r]
  (when (== (.-next r) nil)
    (return (.init r)))

  (.-next r))



^{:go/end 38} (go/method Prev "Prev returns the previous ring element. r must not be empty.\n" ^{:tag (* Ring)} [^{:tag (* Ring)} r]
  (when (== (.-next r) nil)
    (return (.init r)))

  (.-prev r))




^{:go/end 57} (go/method Move "Move moves n % r.Len() elements backward (n < 0) or forward (n >= 0)\nin the ring and returns that ring element. r must not be empty.\n" ^{:tag (* Ring)} [^{:tag (* Ring)} r ^int n]
  (when (== (.-next r) nil)
    (return (.init r)))

  (switch
    (case [(< n 0)]
      (for [] (< n 0) (inc! n)
        (set! r (.-prev r))))

    (case [(> n 0)]
      (for [] (> n 0) (dec! n)
        (set! r (.-next r)))))


  ^{:line 56} r)



^{:go/end 73} (go/func New "New creates a ring of n elements.\n" ^{:tag (* Ring)} [^int n]
  (when (<= n 0)
    (return nil))

  (let [r (new Ring)
      ^{:line 65} p r]
    (for [i 1] (< i n) (inc! i)
      (set! (.-next p) (addr (lit Ring :prev p)))
      (set! p (.-next p)))

    (set! (.-next p) r)
    (set! (.-prev r) p)
    ^{:line 72} r))

















^{:go/end 102} (go/method Link "Link connects ring r with ring s such that r.Next()\nbecomes s and returns the original value for r.Next().\nr must not be empty.\n\nIf r and s point to the same ring, linking\nthem removes the elements between r and s from the ring.\nThe removed elements form a subring and the result is a\nreference to that subring (if no elements were removed,\nthe result is still the original value for r.Next(),\nand not nil).\n\nIf r and s point to different rings, linking\nthem creates a single ring with the elements of s inserted\nafter r. The result points to the element following the\nlast element of s after insertion.\n" ^{:tag (* Ring)} [^{:tag (* Ring)} r ^{:tag (* Ring)} s]
  (let [n (.Next r)]
    (when (!= s nil)
      (let [p (.Prev s)]
        ;; Note: Cannot use multiple assignment because
        ;; evaluation order of LHS is not specified.
        (set! (.-next r) s)
        (set! (.-prev s) r)
        (set! (.-prev n) p)
        (set! (.-next p) n)))

    ^{:line 101} n))





^{:go/end 112} (go/method Unlink "Unlink removes n % r.Len() elements from the ring r, starting\nat r.Next(). If n % r.Len() == 0, r remains unchanged.\nThe result is the removed subring. r must not be empty.\n" ^{:tag (* Ring)} [^{:tag (* Ring)} r ^int n]
  (when (<= n 0)
    (return nil))

  (.Link r (.Move r (+ n 1))))




^{:go/end 125} (go/method Len "Len computes the number of elements in ring r.\nIt executes in time proportional to the number of elements.\n" ^int [^{:tag (* Ring)} r]
  (let [n 0]
    (when (!= r nil)
      (set! n 1)
      (for [p (.Next r)] (!= p r) (set! p (.-next p))
        (inc! n)))


    ^{:line 124} n))




^{:go/end 136} (go/method Do "Do calls function f on each element of the ring, in forward order.\nThe behavior of Do is undefined if f changes *r.\n" [^{:tag (* Ring)} r ^{:tag (func [any])} f]
  (when (!= r nil)
    (f (.-Value r))
    (for [p (.Next r)] (!= p r) (set! p (.-next p))
      (f (.-Value p)))))

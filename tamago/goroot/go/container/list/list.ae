;; Package list implements a doubly linked list.
;;
;; To iterate over a list (where l is a *List):
;;
;;	for e := l.Front(); e != nil; e = e.Next() {
;;		// do something with e.Value
;;	}
(in-ns 'go.container.list) (go/file "list.go" :doc "Package list implements a doubly linked list.\n\nTo iterate over a list (where l is a *List):\n\n\tfor e := l.Front(); e != nil; e = e.Next() {\n\t\t// do something with e.Value\n\t}\n" :imports [])


(go/type Element "Element is an element of a linked list.\n" (struct





    ^{:line 21 :tag (* Element) :doc "Next and previous pointers in the doubly-linked list of elements.\nTo simplify the implementation, internally a list l is implemented\nas a ring, such that &l.root is both the next element of the last\nlist element (l.Back()) and the previous element of the first list\nelement (l.Front()).\n"} next ^{:tag (* Element) :doc "Next and previous pointers in the doubly-linked list of elements.\nTo simplify the implementation, internally a list l is implemented\nas a ring, such that &l.root is both the next element of the last\nlist element (l.Back()) and the previous element of the first list\nelement (l.Front()).\n"} prev


    ^{:line 24 :tag (* List) :doc "The list to which this element belongs.\n"} list


    ^{:line 27 :tag any :doc "The value stored with this element.\n"} Value))



^{:go/breaks [[5 35]] :go/end 36} (go/method Next "Next returns the next list element or nil.\n" ^{:tag (* Element)} [^{:tag (* Element)} e]
  (when [p (.-next e)] (and (!= (.-list e) nil) (!= p (addr (.-root (.-list e)))))
    (return p))

  nil)



^{:go/breaks [[5 43]] :go/end 44} (go/method Prev "Prev returns the previous list element or nil.\n" ^{:tag (* Element)} [^{:tag (* Element)} e]
  (when [p (.-prev e)] (and (!= (.-list e) nil) (!= p (addr (.-root (.-list e)))))
    (return p))

  nil)




(go/type List "List represents a doubly linked list.\nThe zero value for List is an empty list ready to use.\n" (struct
    ^{:line 49 :tag Element} root ; sentinel list element, only &root, root.prev, and root.next are used
    ^{:line 50 :tag int} len)) ; current list length excluding (this) sentinel element



^{:go/end 59} (go/method Init "Init initializes or clears list l.\n" ^{:tag (* List)} [^{:tag (* List)} l]
  (set! (.-next (.-root l)) (addr (.-root l)))
  (set! (.-prev (.-root l)) (addr (.-root l)))
  (set! (.-len l) 0)
  ^{:line 58} l)



^{:go/end 62} (go/func New "New returns an initialized list.\n" ^{:tag (* List)} [] (.Init (new List)))



^{:go/end 66} (go/method Len "Len returns the number of elements of list l.\nThe complexity is O(1).\n" ^int [^{:tag (* List)} l] (.-len l))


^{:go/end 74} (go/method Front "Front returns the first element of list l or nil if the list is empty.\n" ^{:tag (* Element)} [^{:tag (* List)} l]
  (when (== (.-len l) 0)
    (return nil))

  (.-next (.-root l)))



^{:go/end 82} (go/method Back "Back returns the last element of list l or nil if the list is empty.\n" ^{:tag (* Element)} [^{:tag (* List)} l]
  (when (== (.-len l) 0)
    (return nil))

  (.-prev (.-root l)))



^{:go/end 89} (go/method lazyInit "lazyInit lazily initializes a zero List value.\n" [^{:tag (* List)} l]
  (when (== (.-next (.-root l)) nil)
    (.Init l)))




^{:go/end 100} (go/method insert "insert inserts e after at, increments l.len, and returns e.\n" ^{:tag (* Element)} [^{:tag (* List)} l ^{:tag (* Element)} e ^{:tag (* Element)} at]
  (set! (.-prev e) at)
  (set! (.-next e) (.-next at))
  (set! (.-next (.-prev e)) e)
  (set! (.-prev (.-next e)) e)
  (set! (.-list e) l)
  (inc! (.-len l))
  ^{:line 99} e)



^{:go/end 105} (go/method insertValue "insertValue is a convenience wrapper for insert(&Element{Value: v}, at).\n" ^{:tag (* Element)} [^{:tag (* List)} l ^any v ^{:tag (* Element)} at]
  (.insert l (addr (lit Element :Value v)) at))



^{:go/end 115} (go/method remove "remove removes e from its list, decrements l.len\n" [^{:tag (* List)} l ^{:tag (* Element)} e]
  (set! (.-next (.-prev e)) (.-next e))
  (set! (.-prev (.-next e)) (.-prev e))
  (set! (.-next e) nil) ; avoid memory leaks
  (set! (.-prev e) nil) ; avoid memory leaks
  (set! (.-list e) nil)
  (dec! (.-len l)))



^{:go/end 129} (go/method move "move moves e to next to at.\n" [^{:tag (* List)} l ^{:tag (* Element)} e ^{:tag (* Element)} at]
  (when (== e at)
    (return))

  (set! (.-next (.-prev e)) (.-next e))
  (set! (.-prev (.-next e)) (.-prev e))

  (set! (.-prev e) at)
  (set! (.-next e) (.-next at))
  (set! (.-next (.-prev e)) e)
  (set! (.-prev (.-next e)) e))





^{:go/end 141} (go/method Remove "Remove removes e from l if e is an element of list l.\nIt returns the element value e.Value.\nThe element must not be nil.\n" ^any [^{:tag (* List)} l ^{:tag (* Element)} e]
  (when (== (.-list e) l)
    ;; if e.list == l, l must have been initialized when e was inserted
    ;; in l or l == nil (e is a zero Element) and l.remove will crash
    (.remove l e))

  (.-Value e))



^{:go/end 147} (go/method PushFront "PushFront inserts a new element e with value v at the front of list l and returns e.\n" ^{:tag (* Element)} [^{:tag (* List)} l ^any v]
  (.lazyInit l)
  (.insertValue l v (addr (.-root l))))



^{:go/end 153} (go/method PushBack "PushBack inserts a new element e with value v at the back of list l and returns e.\n" ^{:tag (* Element)} [^{:tag (* List)} l ^any v]
  (.lazyInit l)
  (.insertValue l v (.-prev (.-root l))))





^{:go/end 164} (go/method InsertBefore "InsertBefore inserts a new element e with value v immediately before mark and returns e.\nIf mark is not an element of l, the list is not modified.\nThe mark must not be nil.\n" ^{:tag (* Element)} [^{:tag (* List)} l ^any v ^{:tag (* Element)} mark]
  (when (!= (.-list mark) l)
    (return nil))

  ;; see comment in List.Remove about initialization of l
  (.insertValue l v (.-prev mark)))





^{:go/end 175} (go/method InsertAfter "InsertAfter inserts a new element e with value v immediately after mark and returns e.\nIf mark is not an element of l, the list is not modified.\nThe mark must not be nil.\n" ^{:tag (* Element)} [^{:tag (* List)} l ^any v ^{:tag (* Element)} mark]
  (when (!= (.-list mark) l)
    (return nil))

  ;; see comment in List.Remove about initialization of l
  (.insertValue l v mark))





^{:go/end 186} (go/method MoveToFront "MoveToFront moves element e to the front of list l.\nIf e is not an element of l, the list is not modified.\nThe element must not be nil.\n" [^{:tag (* List)} l ^{:tag (* Element)} e]
  (when (or (!= (.-list e) l) (== (.-next (.-root l)) e))
    (return))

  ;; see comment in List.Remove about initialization of l
  (.move l e (addr (.-root l))))





^{:go/end 197} (go/method MoveToBack "MoveToBack moves element e to the back of list l.\nIf e is not an element of l, the list is not modified.\nThe element must not be nil.\n" [^{:tag (* List)} l ^{:tag (* Element)} e]
  (when (or (!= (.-list e) l) (== (.-prev (.-root l)) e))
    (return))

  ;; see comment in List.Remove about initialization of l
  (.move l e (.-prev (.-root l))))





^{:go/end 207} (go/method MoveBefore "MoveBefore moves element e to its new position before mark.\nIf e or mark is not an element of l, or e == mark, the list is not modified.\nThe element and mark must not be nil.\n" [^{:tag (* List)} l ^{:tag (* Element)} e ^{:tag (* Element)} mark]
  (when (or (!= (.-list e) l) (== e mark) (!= (.-list mark) l))
    (return))

  (.move l e (.-prev mark)))





^{:go/end 217} (go/method MoveAfter "MoveAfter moves element e to its new position after mark.\nIf e or mark is not an element of l, or e == mark, the list is not modified.\nThe element and mark must not be nil.\n" [^{:tag (* List)} l ^{:tag (* Element)} e ^{:tag (* Element)} mark]
  (when (or (!= (.-list e) l) (== e mark) (!= (.-list mark) l))
    (return))

  (.move l e mark))




^{:go/end 226} (go/method PushBackList "PushBackList inserts a copy of another list at the back of list l.\nThe lists l and other may be the same. They must not be nil.\n" [^{:tag (* List)} l ^{:tag (* List)} other]
  (.lazyInit l)
  (for [(values i e) (values (.Len other) (.Front other))] (> i 0) (set! (values i e) (values (- i 1) (.Next e)))
    (.insertValue l (.-Value e) (.-prev (.-root l)))))





^{:go/end 235} (go/method PushFrontList "PushFrontList inserts a copy of another list at the front of list l.\nThe lists l and other may be the same. They must not be nil.\n" [^{:tag (* List)} l ^{:tag (* List)} other]
  (.lazyInit l)
  (for [(values i e) (values (.Len other) (.Back other))] (> i 0) (set! (values i e) (values (- i 1) (.Prev e)))
    (.insertValue l (.-Value e) (addr (.-root l)))))

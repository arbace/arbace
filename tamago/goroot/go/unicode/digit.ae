(in-ns 'go.unicode) (go/file "digit.go" :imports [])


^{:go/end 13} (go/func IsDigit "IsDigit reports whether the rune is a decimal digit.\n" ^bool [^rune r]
  (when (<= r MaxLatin1)
    (return (and (<= \0 r) (<= r \9))))

  (isExcludingLatin Digit r))

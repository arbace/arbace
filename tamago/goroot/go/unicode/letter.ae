^{:go/end 247} (go/func convertCase "convertCase converts r to _case using CaseRange cr.\n" ^rune [^int _case ^rune r ^{:tag (* CaseRange)} cr]
  (let [delta (aget (.-Delta cr) _case)]
    (when (> delta MaxRune)
      ;; In an Upper-Lower sequence, which always starts with
      ;; an UpperCase letter, the real deltas always look like:
      ;;	{0, 1, 0}    UpperCase (Lower is next)
      ;;	{-1, 0, -1}  LowerCase (Upper, Title are previous)
      ;; The characters at even offsets from the beginning of the
      ;; sequence are upper case; the ones at odd offsets are lower.
      ;; The correct mapping can be done by clearing or setting the low
      ;; bit in the sequence offset.
      ;; The constants UpperCase and TitleCase are even while LowerCase
      ;; is odd so we take the low bit from _case.
      (return (+ (conv rune (.-Lo cr)) (bit-or (bit-and-not (- r (conv rune (.-Lo cr))) 1) (conv rune (bit-and _case 1))))))

    (+ r delta)))




^{:go/end 259} (go/func to "to maps the rune using the specified case mapping.\nIt additionally reports whether caseRange contained a mapping for r.\n" [^int _case ^rune r ^{:tag (slice CaseRange)} caseRange] :results [^rune mappedRune ^bool foundMapping]
  (when (or (< _case 0) (<= MaxCase _case))
    (return ReplacementChar false)) ; as reasonable an error as any

  (when [cr (lookupCaseRange r caseRange)] (!= cr nil)
    (return (convertCase _case r cr) true))

  (return r false))




(in-ns 'go.unicode) (go/file "graphic.go" :imports [])


(go/const "Bit masks for each code point under U+0100, for fast lookup.\n"
  ^{:line 9} [^{:val 1} pC (<< 1 iota)] ; a control character.
  ^{:line 10} [^{:val 2} pP] ; a punctuation character.
  ^{:line 11} [^{:val 4} pN] ; a numeral.
  ^{:line 12} [^{:val 8} pS] ; a symbolic character.
  ^{:line 13} [^{:val 16} pZ] ; a spacing character.
  ^{:line 14} [^{:val 32} pLu] ; an upper-case letter.
  ^{:line 15} [^{:val 64} pLl] ; a lower-case letter.
  ^{:line 16} [^{:val 128} pp] ; a printable character according to Go's definition.
  ^{:line 17} [^{:val 144} pg (bit-or pp pZ)] ; a graphical character according to the Unicode definition.
  ^{:line 18} [^{:val 96} pLo (bit-or pLl pLu)] ; a letter that is neither upper nor lower case.
  ^{:line 19} [^{:val 96} pLmask pLo])



(go/var ^{:doc "GraphicRanges defines the set of graphic characters according to Unicode.\n"} GraphicRanges (lit (slice (* RangeTable))
    ^{:line 24} L M N P S Zs))




(go/var ^{:doc "PrintRanges defines the set of printable characters according to Go.\nASCII space, U+0020, is handled separately.\n"} PrintRanges (lit (slice (* RangeTable))
    ^{:line 30} L M N P S))





^{:go/end 43} (go/func IsGraphic "IsGraphic reports whether the rune is defined as a Graphic by Unicode.\nSuch characters include letters, marks, numbers, punctuation, symbols, and\nspaces, from categories [L], [M], [N], [P], [S], [Zs].\n" ^bool [^rune r]
  ;; We convert to uint32 to avoid the extra test for negative,
  ;; and in the index we convert to uint8 to avoid the range check.
  (when (<= (conv uint32 r) MaxLatin1)
    (return (!= (bit-and (aget properties (conv uint8 r)) pg) 0)))

  (In r (spread GraphicRanges)))







^{:go/end 55} (go/func IsPrint "IsPrint reports whether the rune is defined as printable by Go. Such\ncharacters include letters, marks, numbers, punctuation, symbols, and the\nASCII space character, from categories [L], [M], [N], [P], [S] and the ASCII space\ncharacter. This categorization is the same as [IsGraphic] except that the\nonly spacing character is ASCII space, U+0020.\n" ^bool [^rune r]
  (when (<= (conv uint32 r) MaxLatin1)
    (return (!= (bit-and (aget properties (conv uint8 r)) pp) 0)))

  (In r (spread PrintRanges)))




^{:go/breaks [[5 65]] :go/end 66} (go/func IsOneOf "IsOneOf reports whether the rune is a member of one of the ranges.\nThe function \"In\" provides a nicer signature and should be used in preference to IsOneOf.\n" ^bool [^{:tag (slice (* RangeTable))} ranges ^rune r]
  (range [_ inside ranges]
    (when (Is inside r)
      (return true)))


  false)



^{:go/breaks [[5 75]] :go/end 76} (go/func In "In reports whether the rune is a member of one of the ranges.\n" ^bool [^rune r & ^{:tag (slice (* RangeTable))} ranges]
  (range [_ inside ranges]
    (when (Is inside r)
      (return true)))


  false)





^{:go/breaks [[5 86]] :go/end 87} (go/func IsControl "IsControl reports whether the rune is a control character.\nThe [C] ([Other]) Unicode category includes more code points\nsuch as surrogates; use [Is](C, r) to test for them.\n" ^bool [^rune r]
  (when (<= (conv uint32 r) MaxLatin1)
    (return (!= (bit-and (aget properties (conv uint8 r)) pC) 0)))

  ;; All control characters are < MaxLatin1.
  false)



^{:go/end 95} (go/func IsLetter "IsLetter reports whether the rune is a letter (category [L]).\n" ^bool [^rune r]
  (when (<= (conv uint32 r) MaxLatin1)
    (return (!= (bit-and (aget properties (conv uint8 r)) pLmask) 0)))

  (isExcludingLatin Letter r))



^{:go/end 101} (go/func IsMark "IsMark reports whether the rune is a mark character (category [M]).\n" ^bool [^rune r]
  ;; There are no mark characters in Latin-1.
  (isExcludingLatin Mark r))



^{:go/end 109} (go/func IsNumber "IsNumber reports whether the rune is a number (category [N]).\n" ^bool [^rune r]
  (when (<= (conv uint32 r) MaxLatin1)
    (return (!= (bit-and (aget properties (conv uint8 r)) pN) 0)))

  (isExcludingLatin Number r))




^{:go/end 118} (go/func IsPunct "IsPunct reports whether the rune is a Unicode punctuation character\n(category [P]).\n" ^bool [^rune r]
  (when (<= (conv uint32 r) MaxLatin1)
    (return (!= (bit-and (aget properties (conv uint8 r)) pP) 0)))

  (Is Punct r))










^{:go/end 138} (go/func IsSpace "IsSpace reports whether the rune is a space character as defined\nby Unicode's White Space property; in the Latin-1 space\nthis is\n\n\t'\\t', '\\n', '\\v', '\\f', '\\r', ' ', U+0085 (NEL), U+00A0 (NBSP).\n\nOther definitions of spacing characters are set by category\nZ and property [Pattern_White_Space].\n" ^bool [^rune r]
  ;; This property isn't the same as Z; special-case it.
  (when (<= (conv uint32 r) MaxLatin1)
    (switch r
      (case [\tab \newline \u000b \formfeed \return \space 0x85 0xA0]
        (return true)))

    (return false))

  (isExcludingLatin White_Space r))



^{:go/end 146} (go/func IsSymbol "IsSymbol reports whether the rune is a symbolic character.\n" ^bool [^rune r]
  (when (<= (conv uint32 r) MaxLatin1)
    (return (!= (bit-and (aget properties (conv uint8 r)) pS) 0)))

  (isExcludingLatin Symbol r))

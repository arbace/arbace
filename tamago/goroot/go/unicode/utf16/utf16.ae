;; Package utf16 implements encoding and decoding of UTF-16 sequences.
(in-ns 'go.unicode.utf16) (go/file "utf16.go" :doc "Package utf16 implements encoding and decoding of UTF-16 sequences.\n" :imports [])

;; The conditions replacementChar==unicode.ReplacementChar and
;; maxRune==unicode.MaxRune are verified in the tests.
;; Defining them locally avoids this package depending on package unicode.

(go/const
  ^{:line 13} [^{:val \ufffd} replacementChar \ufffd] ; Unicode replacement character
  ^{:line 14} [^{:val (rune 0x10FFFF)} maxRune (rune 0x10FFFF)]) ; Maximum valid Unicode code point.


(go/const



  ^{:line 21} [^{:val 55296 :doc "0xd800-0xdc00 encodes the high 10 bits of a pair.\n0xdc00-0xe000 encodes the low 10 bits of a pair.\nthe value is those 20 bits plus 0x10000.\n"} surr1 0xd800]
  ^{:line 22} [^{:val 56320} surr2 0xdc00]
  ^{:line 23} [^{:val 57344} surr3 0xe000]

  ^{:line 25} [^{:val 65536} surrSelf 0x10000])




^{:go/end 32} (go/func IsSurrogate "IsSurrogate reports whether the specified Unicode code point\ncan appear in a surrogate pair.\n" ^bool [^rune r]
  (and (<= surr1 r) (< r surr3)))





^{:go/end 42} (go/func DecodeRune "DecodeRune returns the UTF-16 decoding of a surrogate pair.\nIf the pair is not a valid UTF-16 surrogate pair, DecodeRune returns\nthe Unicode replacement code point U+FFFD.\n" ^rune [^rune r1 ^rune r2]
  (when (and (<= surr1 r1) (< r1 surr2) (<= surr2 r2) (< r2 surr3))
    (return (+ (bit-or (<< (- r1 surr1) 10) (- r2 surr2)) surrSelf)))

  ^{:line 41} replacementChar)





^{:go/end 53} (go/func EncodeRune "EncodeRune returns the UTF-16 surrogate pair r1, r2 for the given rune.\nIf the rune is not a valid Unicode code point or does not need encoding,\nEncodeRune returns U+FFFD, U+FFFD.\n" [^rune r] :results [^rune r1 ^rune r2]
  (when (or (< r surrSelf) (> r maxRune))
    (return replacementChar replacementChar))

  (set! r - surrSelf)
  (return (+ surr1 (bit-and (>> r 10) 0x3ff)) (+ surr2 (bit-and r 0x3ff))))




^{:go/end 66} (go/func RuneLen "RuneLen returns the number of 16-bit words in the UTF-16 encoding of the rune.\nIt returns -1 if the rune is not a valid value to encode in UTF-16.\n" ^int [^rune r]
  (switch
    (case [(and (<= 0 r) (< r surr1)) (and (<= surr3 r) (< r surrSelf))]
      (return 1))
    (case [(and (<= surrSelf r) (<= r maxRune))]
      (return 2))
    (default
      (return -1))))




^{:go/end 95} (go/func Encode "Encode returns the UTF-16 encoding of the Unicode code point sequence s.\n" ^{:tag (slice uint16)} [^{:tag (slice rune)} s]
  (let [n (len s)]
    (range [_ v s]
      (when (>= v surrSelf)
        (inc! n)))



    (let [a (make (slice uint16) n)]
      (set! n 0)
      (range [_ v s]
        (switch (RuneLen v)
          (case [1] ; normal rune
            (aset a n (conv uint16 v))
            (inc! n))
          (case [2] ; needs surrogate sequence
            (let [(values r1 r2) (EncodeRune v)]
              (aset a n (conv uint16 r1))
              (aset a (+ n 1) (conv uint16 r2))
              (set! n + 2)))
          (default
            (aset a n (conv uint16 replacementChar))
            (inc! n))))


      (subslice a _ n))))





^{:go/end 112} (go/func AppendRune "AppendRune appends the UTF-16 encoding of the Unicode code point r\nto the end of p and returns the extended buffer. If the rune is not\na valid Unicode code point, it appends the encoding of U+FFFD.\n" ^{:tag (slice uint16)} [^{:tag (slice uint16)} a ^rune r]
  ;; This function is inlineable for fast handling of ASCII.
  (switch
    (case [(and (<= 0 r) (< r surr1)) (and (<= surr3 r) (< r surrSelf))]
      ;; normal rune
      (return (append a (conv uint16 r))))
    (case [(and (<= surrSelf r) (<= r maxRune))]
      ;; needs surrogate sequence
      (let [(values r1 r2) (EncodeRune r)]
        (return (append a (conv uint16 r1) (conv uint16 r2))))))

  (append a replacementChar))




^{:go/end 121} (go/func Decode "Decode returns the Unicode code point sequence represented\nby the UTF-16 encoding s.\n" ^{:tag (slice rune)} [^{:tag (slice uint16)} s]
  ;; Preallocate capacity to hold up to 64 runes.
  ;; Decode inlines, so the allocation can live on the stack.
  (let [buf (make (slice rune) 0 64)]
    (decode s buf)))




^{:go/end 144} (go/func decode "decode appends to buf the Unicode code point sequence represented\nby the UTF-16 encoding s and return the extended buffer.\n" ^{:tag (slice rune)} [^{:tag (slice uint16)} s ^{:tag (slice rune)} buf]
  (for [i 0] (< i (len s)) (inc! i)
    (let [^rune ar (zero rune)]
      (switch [r (aget s i)]
        (case [(< r surr1) (<= surr3 r)]
          ;; normal rune
          (set! ar (conv rune r)))
        (case [(and (<= surr1 r) (< r surr2) (< (+ i 1) (len s))
              (<= surr2 (aget s (+ i 1))) (< (aget s (+ i 1)) surr3))]
          ;; valid surrogate sequence
          (set! ar (DecodeRune (conv rune r) (conv rune (aget s (+ i 1)))))
          (inc! i))
        (default
          ;; invalid surrogate sequence
          (set! ar replacementChar)))

      (set! buf (append buf ar))))

  ^{:line 143} buf)

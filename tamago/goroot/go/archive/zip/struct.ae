    (set! mode bit-or fs/ModeDir))

  ^{:line 327} mode)



^{:go/end 342} (go/method SetMode "SetMode changes the permission and mode bits for the [FileHeader].\n" [^{:tag (* FileHeader)} h ^fs/FileMode mode]
  (set! (.-CreatorVersion h) (bit-or (bit-and (.-CreatorVersion h) 0xff) (<< creatorUnix 8)))
  (set! (.-ExternalAttrs h) (<< (fileModeToUnixMode mode) 16))

  ;; set MSDOS attributes too, as the original zip does.
  (when (!= (bit-and mode fs/ModeDir) 0)
    (set! (.-ExternalAttrs h) bit-or msdosDir))

  (when (== (bit-and mode 0200) 0)
    (set! (.-ExternalAttrs h) bit-or msdosReadOnly)))




^{:go/end 358} (go/func msdosModeToFileMode [^uint32 m] :results [^fs/FileMode mode]
  (if (!= (bit-and m msdosDir) 0)
    (set! mode (bit-or fs/ModeDir 0777))

    (set! mode 0666))

  (when (!= (bit-and m msdosReadOnly) 0)

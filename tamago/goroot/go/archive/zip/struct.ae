^{:go/end 328} (go/method Mode "Mode returns the permission and mode bits for the [FileHeader].\n" [^{:tag (* FileHeader)} h] :results [^fs/FileMode mode]
  (switch (>> (.-CreatorVersion h) 8)
    (case [creatorUnix creatorMacOSX]
      (set! mode (unixModeToFileMode (>> (.-ExternalAttrs h) 16))))
    (case [creatorNTFS creatorVFAT creatorFAT]

    ;; date bits 0-4: day of month; 5-8: month; 9-15: years since 1980
    (conv int (+ (>> dosDate 9) 1980))
    (conv time/Month (bit-and (>> dosDate 5) 0xf))
    (conv int (bit-and dosDate 0x1f))

    ;; time bits 0-4: second/2; 5-10: minute; 11-15: hour
    (conv int (>> dosTime 11))
    (conv int (bit-and (>> dosTime 5) 0x3f))
    (conv int (* (bit-and dosTime 0x1f) 2))
    0 ; nanoseconds

    ^{:line 266} time/UTC))






^{:go/end 277} (go/func timeToMsDosTime "timeToMsDosTime converts a time.Time to an MS-DOS date and time.\nThe resolution is 2s.\nSee: https://learn.microsoft.com/en-us/windows/win32/api/winbase/nf-winbase-filetimetodosdatetime\n" [^time/Time t] :results [^uint16 fDate ^uint16 fTime]
  (set! fDate (conv uint16 (+ (.Day t) (<< (conv int (.Month t)) 5) (<< (- (.Year t) 1980) 9))))
  (set! fTime (conv uint16 (+ (/ (.Second t) 2) (<< (.Minute t) 5) (<< (.Hour t) 11))))
  (return))







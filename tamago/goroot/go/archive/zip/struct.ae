  ^{:line 357} mode)


^{:go/end 388} (go/func fileModeToUnixMode ^uint32 [^fs/FileMode mode]
  (let [^uint32 m (zero uint32)]
    (switch (bit-and mode fs/ModeType)
      (default
        (set! m s_IFREG))
      (case [fs/ModeDir]
        (set! m s_IFDIR))
      (case [fs/ModeSymlink]
        (set! m s_IFLNK))
      (case [fs/ModeNamedPipe]
        (set! m s_IFIFO))
      (case [fs/ModeSocket]
        (set! m s_IFSOCK))
      (case [fs/ModeDevice]
        (set! m s_IFBLK))
      (case [(bit-or fs/ModeDevice fs/ModeCharDevice)]
        (set! m s_IFCHR)))

    (when (!= (bit-and mode fs/ModeSetuid) 0)
      (set! m bit-or s_ISUID))

    (when (!= (bit-and mode fs/ModeSetgid) 0)
      (set! m bit-or s_ISGID))

    (when (!= (bit-and mode fs/ModeSticky) 0)
      (set! m bit-or s_ISVTX))

    (bit-or m (conv uint32 (bit-and mode 0777)))))


^{:go/end 418} (go/func unixModeToFileMode ^fs/FileMode [^uint32 m]
  (let [mode (conv fs/FileMode (bit-and m 0777))]
    (switch (bit-and m s_IFMT)
      (case [s_IFBLK]
        (set! mode bit-or fs/ModeDevice))
      (case [s_IFCHR]
        (set! mode bit-or (bit-or fs/ModeDevice fs/ModeCharDevice)))
      (case [s_IFDIR]
        (set! mode bit-or fs/ModeDir))
      (case [s_IFIFO]
        (set! mode bit-or fs/ModeNamedPipe))
      (case [s_IFLNK]
        (set! mode bit-or fs/ModeSymlink))
      (case [s_IFREG])
      ;; nothing to do
      (case [s_IFSOCK]
        (set! mode bit-or fs/ModeSocket)))

    (when (!= (bit-and m s_ISGID) 0)
      (set! mode bit-or fs/ModeSetgid))

    (when (!= (bit-and m s_ISUID) 0)
      (set! mode bit-or fs/ModeSetuid))

    (when (!= (bit-and m s_ISVTX) 0)
      (set! mode bit-or fs/ModeSticky))

    ^{:line 417} mode))

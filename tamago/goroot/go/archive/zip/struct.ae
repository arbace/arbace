    (time/FixedZone "" (conv int (/ offset time/Second)))))





^{:go/end 268} (go/func msDosTimeToTime "msDosTimeToTime converts an MS-DOS date and time into a time.Time.\nThe resolution is 2s.\nSee: https://learn.microsoft.com/en-us/windows/win32/api/winbase/nf-winbase-dosdatetimetofiletime\n" ^time/Time [^uint16 dosDate ^uint16 dosTime]

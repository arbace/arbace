      ^{:line 210} fh (addr ^{:go/breaks [2 4]} (lit FileHeader
          :Name (.Name fi)
          :UncompressedSize64 (conv uint64 size)))]

    (.SetModTime fh (.ModTime fi))
    (.SetMode fh (.Mode fi))
    (if (> (.-UncompressedSize64 fh) uint32max)
      (set! (.-UncompressedSize fh) uint32max)

      (set! (.-UncompressedSize fh) (conv uint32 (.-UncompressedSize64 fh))))

    (return fh nil)))



(ns go.archive.tar
  (:require [arbace.go :as go]))

(go/package tar
  :path "archive/tar"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["common.go" "format.go" "reader.go" "strconv.go" "writer.go"]
  :init-order [tarinsecurepath ErrHeader ErrWriteTooLong ErrFieldTooLong ErrWriteAfterClose ErrInsecurePath errMissData errUnrefData errWriteHole errSparseTooLong basicKeys formatNames]
  :positions :lines)

(load "tar/common")
(load "tar/format")
(load "tar/reader")
(load "tar/strconv")
(load "tar/writer")

(ns go.archive.zip
  (:require [arbace.go :as go]))

(go/package zip
  :path "archive/zip"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["reader.go" "register.go" "struct.go" "writer.go"]
  :init-order [zipinsecurepath ErrFormat ErrAlgorithm ErrChecksum ErrInsecurePath dotFile errLongName errLongExtra]
  :positions :lines)

(load "zip/reader")
(load "zip/register")
(load "zip/struct")
(load "zip/writer")

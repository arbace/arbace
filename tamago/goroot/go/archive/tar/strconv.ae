^{:go/end 18} (go/func hasNUL "hasNUL reports whether the NUL character exists within s.\n" ^bool [^string s]
  (strings/Contains s "\u0000"))



^{:go/breaks [[5 27]] :go/end 28} (go/func isASCII "isASCII reports whether the input is an ASCII C-style string.\n" ^bool [^string s]
  (range [_ c s]
    (when (or (>= c 0x80) (== c 0x00))
      (return false)))


  true)




^{:go/end 43} (go/func toASCII "toASCII converts the input to an ASCII C-style string.\nThis is a best effort conversion, so invalid characters are dropped.\n" ^string [^string s]
  (when (isASCII s)
    (return s))

  (let [b (make (slice byte) 0 (len s))]
    (range [_ c s]
      (when (and (< c 0x80) (!= c 0x00))
        (set! b (append b (conv byte c)))))


    (conv string b)))



    (switch
      (case [(.IsRegular fm)]
        (set! (.-Typeflag h) TypeReg)
        (set! (.-Size h) (.Size fi)))
      (case [(.IsDir fi)]
        (set! (.-Typeflag h) TypeDir)
        (set! (.-Name h) + "/"))
      (case [(!= (bit-and fm fs/ModeSymlink) 0)]
        (set! (.-Typeflag h) TypeSymlink)
        (set! (.-Linkname h) link))
      (case [(!= (bit-and fm fs/ModeDevice) 0)]
        (if (!= (bit-and fm fs/ModeCharDevice) 0)
          (set! (.-Typeflag h) TypeChar)

          (set! (.-Typeflag h) TypeBlock)))


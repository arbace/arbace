^{:go/end 201} (go/method getFormat "getFormat checks that the block is a valid tar header based on the checksum.\nIt then attempts to guess the specific format based on magic values.\nIf the checksum fails, then FormatUnknown is returned.\n" ^Format [^{:tag (* block)} b]
  ;; Verify checksum.
  (let [^parser p (zero parser)
      ^{:line 181} value (.parseOctal p (.chksum (.toV7 b)))
      (values chksum1 chksum2) (.computeChecksum b)]
    (when (or (!= (.-err p) nil) ^:go/paren (and (!= value chksum1) (!= value chksum2)))
      (return FormatUnknown))


    ;; Guess the magic values.
    (let [magic (conv string (.magic (.toUSTAR b)))
        ^{:line 189} version (conv string (.version (.toUSTAR b)))
        ^{:line 190} trailer (conv string (.trailer (.toSTAR b)))]
      (switch
        (case [(and (== magic magicUSTAR) (== trailer trailerSTAR))]
          (return formatSTAR))
        (case [(== magic magicUSTAR)]
          (return (bit-or FormatUSTAR FormatPAX)))
        (case [(and (== magic magicGNU) (== version versionGNU))]
          (return FormatGNU))
        (default
          (return formatV7))))))





^{:go/end 231} (go/method setFormat "setFormat writes the magic values necessary for specified format\nand then updates the checksum accordingly.\n" [^{:tag (* block)} b ^Format format]
  ;; Set the magic values.
  (switch
    (case [(.has format formatV7)])
    ;; Do nothing.
    (case [(.has format FormatGNU)]
      (copy (.magic (.toGNU b)) magicGNU)
      (copy (.version (.toGNU b)) versionGNU))
    (case [(.has format formatSTAR)]
      (copy (.magic (.toSTAR b)) magicUSTAR)
      (copy (.version (.toSTAR b)) versionUSTAR)
      (copy (.trailer (.toSTAR b)) trailerSTAR))
    (case [(.has format (bit-or FormatUSTAR FormatPAX))]
      (copy (.magic (.toUSTAR b)) magicUSTAR)
      (copy (.version (.toUSTAR b)) versionUSTAR))
    (default
      (panic "invalid format")))


  ;; Update checksum.
  ;; This field is special in that it is terminated by a NULL then space.
  (let [^formatter f (zero formatter)
      ^{:line 227} field (.chksum (.toV7 b))
      (values chksum _) (.computeChecksum b)] ; Possible values are 256..128776
    (.formatOctal f (subslice field _ 7) chksum) ; Never fails since 128776 < 262143
    (aset field 7 \space)))






^{:go/end 246} (go/method computeChecksum "computeChecksum computes the checksum for the header block.\nPOSIX specifies a sum of the unsigned byte values, but the Sun tar used\nsigned byte values.\nWe compute and return both.\n" [^{:tag (* block)} b] :results [^int64 unsigned ^int64 signed]
  (range [i c b]
    (when (and (<= 148 i) (< i 156))
      (set! c \space)) ; Treat the checksum field itself as all spaces.

    (set! unsigned + (conv int64 c))
    (set! signed + (conv int64 (conv int8 c))))

  (return unsigned signed))



^{:go/end 251} (go/method reset "reset clears the block with all zeros.\n" [^{:tag (* block)} b]
  (set! @b (lit block)))



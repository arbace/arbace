^{:go/end 111} (go/method mustNotBe [^{:tag (* Format)} f ^Format f2] (set! @f bit-and-not f2))

(go/var formatNames (lit (map Format string)
    ^{:line 114} [formatV7 "V7"] [FormatUSTAR "USTAR"] [FormatPAX "PAX"] [FormatGNU "GNU"] [formatSTAR "STAR"]))


^{:go/end 132} (go/method String ^string [^Format f]
  (let [^{:tag (slice string)} ss (zero (slice string))]
    (for [f2 (conv Format 1)] (< f2 formatMax) (set! f2 << 1)
      (when (.has f f2)
        (set! ss (append ss (aget formatNames f2)))))


    (switch (len ss)
      (case [0]
        (return "<unknown>"))
      (case [1]
        (return (aget ss 0)))
      (default
        (return (+ "(" (strings/Join ss " | ") ")"))))))





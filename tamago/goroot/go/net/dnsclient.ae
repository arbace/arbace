      (return "" (addr (lit DNSError :Err "unrecognized address" :Name addr))))

    (when (!= (.To4 ip) nil)
      (return (+ (strconv/Itoa (conv int (aget ip 15))) "." (strconv/Itoa (conv int (aget ip 14))) "." (strconv/Itoa (conv int (aget ip 13))) "." (strconv/Itoa (conv int (aget ip 12))) ".in-addr.arpa.") nil))


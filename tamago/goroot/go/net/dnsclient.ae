^{:go/end 54} (go/func reverseaddr "reverseaddr returns the in-addr.arpa. or ip6.arpa. hostname of the IP\naddress addr suitable for rDNS (PTR) record lookup or an error if it fails\nto parse the IP address.\n" [^string addr] :results [^string arpa ^error err]

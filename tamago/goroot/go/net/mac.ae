(in-ns 'go.net) (go/file "mac.go" :imports [])

(go/const ^{:val "0123456789abcdef"} hexDigit "0123456789abcdef")


(go/type HardwareAddr "A HardwareAddr represents a physical hardware address.\n" (slice byte))

^{:go/end 25} (go/method String ^string [^HardwareAddr a]
  (when (== (len a) 0)
    (return ""))

  (let [buf (make (slice byte) 0 (- (* (len a) 3) 1))]
    (range [i b a]
      (when (> i 0)
        (set! buf (append buf \:)))

      (set! buf (append buf (aget hexDigit (>> b 4))))
      (set! buf (append buf (aget hexDigit (bit-and b 0xF)))))

    (conv string buf)))















^{:go/end 103} (go/func ParseMAC "ParseMAC parses s as an IEEE 802 MAC-48, EUI-48, EUI-64, or a 20-octet\nIP over InfiniBand link-layer address using one of the following formats:\n\n\t00:00:5e:00:53:01\n\t02:00:5e:10:00:00:00:01\n\t00:00:00:00:fe:80:00:00:00:00:00:00:02:00:5e:10:00:00:00:01\n\t00-00-5e-00-53-01\n\t02-00-5e-10-00-00-00-01\n\t00-00-00-00-fe-80-00-00-00-00-00-00-02-00-5e-10-00-00-00-01\n\t0000.5e00.5301\n\t0200.5e10.0000.0001\n\t0000.0000.fe80.0000.0000.0000.0200.5e10.0000.0001\n\t00005e005301\n" [^string s] :results [^HardwareAddr hw ^error err]
  (when (< (len s) 12)
    (goto :error))


  (cond (or (== (aget s 2) \:) (== (aget s 2) \-)) (do
      (when (!= (% (+ (len s) 1) 3) 0)
        (goto :error))

      (let [n (/ (+ (len s) 1) 3)]
        (when (and (!= n 6) (!= n 8) (!= n 20))
          (goto :error))

        (set! hw (make HardwareAddr n))
        (for [(values x i) (values 0 0)] (< i n) (inc! i)
          (let [^bool ok (zero bool)]
            (when [(set! (values (aget hw i) ok) (xtoi2 (subslice s x) (aget s 2)))] (not ok)
              (goto :error))

            (set! x + 3)))))

    (== (aget s 4) \.) (do
      (when (!= (% (+ (len s) 1) 5) 0)
        (goto :error))

      (let [n (/ (* 2 (+ (len s) 1)) 5)]
        (when (and (!= n 6) (!= n 8) (!= n 20))
          (goto :error))

        (set! hw (make HardwareAddr n))
        (for [(values x i) (values 0 0)] (< i n) (set! i + 2)
          (let [^bool ok (zero bool)]
            (when [(set! (values (aget hw i) ok) (xtoi2 (subslice s x (+ x 2)) 0))] (not ok)
              (goto :error))

            (when [(set! (values (aget hw (+ i 1)) ok) (xtoi2 (subslice s (+ x 2)) (aget s 4)))] (not ok)
              (goto :error))

            (set! x + 5))))) :else

    (do
      (when (!= (% (len s) 2) 0)
        (goto :error))


      (let [n (/ (len s) 2)]
        (when (and (!= n 6) (!= n 8) (!= n 20))
          (goto :error))


        (set! hw (make HardwareAddr (/ (len s) 2)))
        (for [(values x i) (values 0 0)] (< i n) (inc! i)
          (let [^bool ok (zero bool)]
            (when [(set! (values (aget hw i) ok) (xtoi2 (subslice s x (+ x 2)) 0))] (not ok)
              (goto :error))

            (set! x + 2))))))


  (return hw nil)

  (label :error
    (return nil (addr (lit AddrError :Err "invalid MAC address" :Addr s)))))

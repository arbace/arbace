^{:go/end 519} (go/func goDebugNetDNS "goDebugNetDNS parses the value of the GODEBUG \"netdns\" value.\nThe netdns value can be of the form:\n\n\t1       // debug level 1\n\t2       // debug level 2\n\tcgo     // use cgo for DNS lookups\n\tgo      // use go for DNS lookups\n\tcgo+1   // use cgo for DNS lookups + debug level 1\n\t1+cgo   // same\n\tcgo+2   // same, but debug level 2\n\netc.\n" [] :results [^string dnsMode ^int debugLevel]
  (let [goDebug (.Value netdns)
      ^{:line 502} parsePart ^{:go/end 511} (fn [^string s]
        (when (== s "")
          (return))

        (if (and (<= \0 (aget s 0)) (<= (aget s 0) \9))
          (set! (values debugLevel _ _) (dtoi s))

          (set! dnsMode s)))]


    (when [i (bytealg/IndexByteString goDebug \+)] (!= i -1)
      (parsePart (subslice goDebug _ i))
      (parsePart (subslice goDebug (+ i 1)))
      (return))

    (parsePart goDebug)
    (return)))




^{:go/end 525} (go/func isLocalhost "isLocalhost reports whether h should be considered a \"localhost\"\nname for the myhostname NSS module.\n" ^bool [^string h]

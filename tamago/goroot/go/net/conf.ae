^{:go/end 163} (go/func initConfVal "initConfVal initializes confVal based on the environment\nthat will not change during program execution.\n" []
  (let [(values dnsMode debugLevel) (goDebugNetDNS)]
    (set! (.-netGo confVal) (or netGoBuildTag (== dnsMode "go")))
    (set! (.-netCgo confVal) (or netCgoBuildTag (== dnsMode "cgo")))
    (set! (.-dnsDebugLevel confVal) debugLevel)

    (when (> (.-dnsDebugLevel confVal) 0)
      (defer (^{:go/end 121} (fn []
            (when (> (.-dnsDebugLevel confVal) 1)
              (println "go package net: confVal.netCgo =" (.-netCgo confVal) " netGo =" (.-netGo confVal)))

            (when (and (!= dnsMode "go") (!= dnsMode "cgo") (!= dnsMode ""))
              (println "go package net: GODEBUG=netdns contains an invalid dns mode, ignoring it"))

            (switch
              (case [(or netGoBuildTag (not cgoAvailable))]
                (if (== dnsMode "cgo")
                  (println "go package net: ignoring GODEBUG=netdns=cgo as the binary was compiled without support for the cgo resolver")

                  (println "go package net: using the Go DNS resolver")))

              (case [netCgoBuildTag]
                (if (== dnsMode "go")
                  (println "go package net: GODEBUG setting forcing use of the Go resolver")

                  (println "go package net: using the cgo DNS resolver")))

              (default
                (cond (== dnsMode "go")
                  (println "go package net: GODEBUG setting forcing use of the Go resolver")
                  (== dnsMode "cgo")
                  (println "go package net: GODEBUG setting forcing use of the cgo resolver") :else

                  (println "go package net: dynamic selection of DNS resolver"))))))))





    ;; The remainder of this function sets preferCgo based on
    ;; conditions that will not change during program execution.

    ;; By default, prefer the go resolver.
    (set! (.-preferCgo confVal) false)

    ;; If the cgo resolver is not available, we can't prefer it.
    (when (not cgoAvailable)
      (return))


    ;; Some operating systems always prefer the cgo resolver.
    (when (goosPrefersCgo)
      (set! (.-preferCgo confVal) true)
      (return))


    ;; The remaining checks are specific to Unix systems.
    (switch runtime/GOOS
      (case ["plan9" "windows" "js" "wasip1" "tamago"]
        (return)))


    ;; If any environment-specified resolver options are specified,
    ;; prefer the cgo resolver.
    ;; Note that LOCALDOMAIN can change behavior merely by being
    ;; specified with the empty string.
    (let [(values _ localDomainDefined) (os/LookupEnv "LOCALDOMAIN")]
      (when (or localDomainDefined (!= (os/Getenv "RES_OPTIONS") "") (!= (os/Getenv "HOSTALIASES") ""))
        (set! (.-preferCgo confVal) true)
        (return))


      ;; OpenBSD apparently lets you override the location of resolv.conf
      ;; with ASR_CONFIG. If we notice that, defer to libc.
      (when (and (== runtime/GOOS "openbsd") (!= (os/Getenv "ASR_CONFIG") ""))
        (set! (.-preferCgo confVal) true)
        (return)))))





^{:go/end 191} (go/func goosPrefersCgo "goosPrefersCgo reports whether the GOOS value passed in prefers\nthe cgo resolver.\n" ^bool []
  (switch runtime/GOOS
    ;; Historically on Windows and Plan 9 we prefer the
    ;; cgo resolver (which doesn't use the cgo tool) rather than
    ;; the go resolver. This is because originally these
    ;; systems did not support the go resolver.
    ;; Keep it this way for better compatibility.
    ;; Perhaps we can revisit this some day.
    (case ["windows" "plan9"]
      (return true))

    ;; Darwin pops up annoying dialog boxes if programs try to
    ;; do their own DNS requests, so prefer cgo.
    (case ["darwin" "ios"]
      (return true))

    ;; DNS requests don't work on Android, so prefer the cgo resolver.
    ;; Issue #10714.
    (case ["android"]
      (return true))

    (default
      (return false))))






^{:go/end 215} (go/method mustUseGoResolver "mustUseGoResolver reports whether a DNS lookup of any sort is\nrequired to use the go resolver. The provided Resolver is optional.\nThis will report true if the cgo resolver is not available.\n" ^bool [^{:tag (* conf)} c ^{:tag (* Resolver)} r]
  (when (not cgoAvailable)
    (return true))


  (when (== runtime/GOOS "plan9")
    ;; TODO(bradfitz): for now we only permit use of the PreferGo
    ;; implementation when there's a non-nil Resolver with a
    ;; non-nil Dialer. This is a sign that the code is trying
    ;; to use their DNS-speaking net.Conn (such as an in-memory
    ;; DNS cache) and they don't want to actually hit the network.
    ;; Once we add support for looking the default DNS servers
    ;; from plan9, though, then we can relax this.
    (when (or (== r nil) (== (.-Dial r) nil))
      (return false)))



  (or (.-netGo c) (.preferGo r)))





^{:go/end 227} (go/method addrLookupOrder "addrLookupOrder determines which strategy to use to resolve addresses.\nThe provided Resolver is optional. nil means to not consider its options.\nIt also returns dnsConfig when it was used to determine the lookup order.\n" [^{:tag (* conf)} c ^{:tag (* Resolver)} r ^string addr] :results [^hostLookupOrder ret ^{:tag (* dnsConfig)} dnsConf]

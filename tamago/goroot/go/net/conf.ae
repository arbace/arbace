^{:go/end 531} (go/func isGateway "isGateway reports whether h should be considered a \"gateway\"\nname for the myhostname NSS module.\n" ^bool [^string h]
  (stringsEqualFold h "_gateway"))




^{:go/end 537} (go/func isOutbound "isOutbound reports whether h should be considered an \"outbound\"\nname for the myhostname NSS module.\n" ^bool [^string h]
  (stringsEqualFold h "_outbound"))

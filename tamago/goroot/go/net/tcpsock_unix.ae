(in-ns 'go.net) (go/file "tcpsock_unix.go" :build ["//go:build (!windows && !solaris) || illumos"] :imports [

    ^{:line 9} [syscall "syscall"]])


^{:go/breaks [[9 30]] :go/end 31} (go/method SetKeepAliveConfig "SetKeepAliveConfig configures keep-alive messages sent by the operating system.\n" ^error [^{:tag (* TCPConn)} c ^KeepAliveConfig config]
  (when (not ^{:go/via [conn]} (.ok c))
    (return syscall/EINVAL))


  (when [err (setKeepAlive ^{:go/via [conn]} (.-fd c) (.-Enable config))] (!= err nil)
    (return (addr (lit OpError :Op "set" :Net (.-net ^{:go/via [conn]} (.-fd c)) :Source (.-laddr ^{:go/via [conn]} (.-fd c)) :Addr (.-raddr ^{:go/via [conn]} (.-fd c)) :Err err))))

  (when [err (setKeepAliveIdle ^{:go/via [conn]} (.-fd c) (.-Idle config))] (!= err nil)
    (return (addr (lit OpError :Op "set" :Net (.-net ^{:go/via [conn]} (.-fd c)) :Source (.-laddr ^{:go/via [conn]} (.-fd c)) :Addr (.-raddr ^{:go/via [conn]} (.-fd c)) :Err err))))

  (when [err (setKeepAliveInterval ^{:go/via [conn]} (.-fd c) (.-Interval config))] (!= err nil)
    (return (addr (lit OpError :Op "set" :Net (.-net ^{:go/via [conn]} (.-fd c)) :Source (.-laddr ^{:go/via [conn]} (.-fd c)) :Addr (.-raddr ^{:go/via [conn]} (.-fd c)) :Err err))))

  (when [err (setKeepAliveCount ^{:go/via [conn]} (.-fd c) (.-Count config))] (!= err nil)
    (return (addr (lit OpError :Op "set" :Net (.-net ^{:go/via [conn]} (.-fd c)) :Source (.-laddr ^{:go/via [conn]} (.-fd c)) :Addr (.-raddr ^{:go/via [conn]} (.-fd c)) :Err err))))


  nil)

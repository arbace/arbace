(ns go.net.internal.socktest
  (:require [arbace.go :as go]))

(go/package socktest
  :path "net/internal/socktest"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["switch.go" "switch_posix.go" "switch_unix.go" "sys_unix.go"]
  :init-order []
  :positions :lines)

(load "socktest/switch")
(load "socktest/switch_posix")
(load "socktest/switch_unix")
(load "socktest/sys_unix")

;; Package socktest provides utilities for socket testing.
(in-ns 'go.net.internal.socktest) (go/file "switch.go" :doc "Package socktest provides utilities for socket testing.\n" :imports [


    ^{:line 9} [fmt "fmt"]
    ^{:line 10} [sync "sync"]])




(go/type Switch "A Switch represents a callpath point switch for socket system\ncalls.\n" (struct
    ^{:line 16 :tag sync/Once} once

    ^{:line 18 :tag sync/RWMutex} fmu
    ^{:line 19 :tag (map FilterType Filter)} fltab

    ^{:line 21 :tag sync/RWMutex} smu
    ^{:line 22 :tag Sockets} sotab
    ^{:line 23 :tag stats} stats))


^{:go/end 30} (go/method init [^{:tag (* Switch)} sw]
  (set! (.-fltab sw) (make (map FilterType Filter)))
  (set! (.-sotab sw) (make Sockets))
  (set! (.-stats sw) (make stats)))



^{:go/end 42} (go/method Stats "Stats returns a list of per-cookie socket statistics.\n" ^{:tag (slice Stat)} [^{:tag (* Switch)} sw]
  (let [^{:tag (slice Stat)} st (zero (slice Stat))]
    (.RLock (.-smu sw))
    (range [_ s (.-stats sw)]
      (let [ns @s]
        (set! st (append st ns))))

    (.RUnlock (.-smu sw))
    ^{:line 41} st))



^{:go/end 53} (go/method Sockets "Sockets returns mappings of socket descriptor to socket status.\n" ^Sockets [^{:tag (* Switch)} sw]
  (.RLock (.-smu sw))
  (let [tab (make Sockets (len (.-sotab sw)))]
    (range [i s (.-sotab sw)]
      (aset tab i s))

    (.RUnlock (.-smu sw))
    ^{:line 52} tab))




(go/type Cookie "A Cookie represents a 3-tuple of a socket; address family, socket\ntype and protocol number.\n" uint64)


^{:go/end 60} (go/method Family "Family returns an address family.\n" ^int [^Cookie c] (conv int (>> c 48)))


^{:go/end 63} (go/method Type "Type returns a socket type.\n" ^int [^Cookie c] (conv int (>> (<< c 16) 32)))


^{:go/end 66} (go/method Protocol "Protocol returns a protocol number.\n" ^int [^Cookie c] (conv int (bit-and c 0xff)))

^{:go/end 70} (go/func cookie ^Cookie [^int family ^int sotype ^int proto]
  (bit-or (<< (conv Cookie family) 48) (<< (bit-and (conv Cookie sotype) 0xffffffff) 16) (bit-and (conv Cookie proto) 0xff)))



(go/type Status "A Status represents the status of a socket.\n" (struct
    ^{:line 74 :tag Cookie} Cookie
    ^{:line 75 :tag error} Err ; error status of socket system call
    ^{:line 76 :tag error} SocketErr)) ; error status of socket by SO_ERROR


^{:go/end 81} (go/method String ^string [^Status so]
  (fmt/Sprintf "(%s, %s, %s): syscallerr=%v socketerr=%v" (familyString (.Family (.-Cookie so))) (typeString (.Type (.-Cookie so))) (protocolString (.Protocol (.-Cookie so))) (.-Err so) (.-SocketErr so)))



(go/type Stat "A Stat represents a per-cookie socket statistics.\n" (struct
    ^{:line 85 :tag int} Family ; address family
    ^{:line 86 :tag int} Type ; socket type
    ^{:line 87 :tag int} Protocol ; protocol number

    ^{:line 89 :tag uint64} Opened ; number of sockets opened
    ^{:line 90 :tag uint64} Connected ; number of sockets connected
    ^{:line 91 :tag uint64} Listened ; number of sockets listened
    ^{:line 92 :tag uint64} Accepted ; number of sockets accepted
    ^{:line 93 :tag uint64} Closed ; number of sockets closed

    ^{:line 95 :tag uint64} OpenFailed ; number of sockets open failed
    ^{:line 96 :tag uint64} ConnectFailed ; number of sockets connect failed
    ^{:line 97 :tag uint64} ListenFailed ; number of sockets listen failed
    ^{:line 98 :tag uint64} AcceptFailed ; number of sockets accept failed
    ^{:line 99 :tag uint64} CloseFailed)) ; number of sockets close failed


^{:go/end 104} (go/method String ^string [^Stat st]
  (fmt/Sprintf "(%s, %s, %s): opened=%d connected=%d listened=%d accepted=%d closed=%d openfailed=%d connectfailed=%d listenfailed=%d acceptfailed=%d closefailed=%d" (familyString (.-Family st)) (typeString (.-Type st)) (protocolString (.-Protocol st)) (.-Opened st) (.-Connected st) (.-Listened st) (.-Accepted st) (.-Closed st) (.-OpenFailed st) (.-ConnectFailed st) (.-ListenFailed st) (.-AcceptFailed st) (.-CloseFailed st)))


(go/type stats (map Cookie (* Stat)))

^{:go/end 115} (go/method getLocked ^{:tag (* Stat)} [^stats st ^Cookie c]
  (let [(values s ok) (aget st c)]
    (when (not ok)
      (set! s (addr (lit Stat :Family (.Family c) :Type (.Type c) :Protocol (.Protocol c))))
      (aset st c s))

    ^{:line 114} s))



(go/type FilterType "A FilterType represents a filter type.\n" int)

(go/const
  ^{:line 121} [^{:tag FilterType :val 0} FilterSocket iota] ; for Socket
  ^{:line 122} [^{:val 1} FilterConnect] ; for Connect or ConnectEx
  ^{:line 123} [^{:val 2} FilterListen] ; for Listen
  ^{:line 124} [^{:val 3} FilterAccept] ; for Accept, Accept4 or AcceptEx
  ^{:line 125} [^{:val 4} FilterGetsockoptInt] ; for GetsockoptInt
  ^{:line 126} [^{:val 5} FilterClose]) ; for Close or Closesocket











(go/type Filter "A Filter represents a socket system call filter.\n\nIt will only be executed before a system call for a socket that has\nan entry in internal table.\nIf the filter returns a non-nil error, the execution of system call\nwill be canceled and the system call function returns the non-nil\nerror.\nIt can return a non-nil [AfterFilter] for filtering after the\nexecution of the system call.\n" (func [(* Status)] [AfterFilter error]))

^{:go/end 145} (go/method apply [^Filter f ^{:tag (* Status)} st] :results [AfterFilter error]
  (when (== f nil)
    (return nil nil))

  (f st))









(go/type AfterFilter "An AfterFilter represents a socket system call filter after an\nexecution of a system call.\n\nIt will only be executed after a system call for a socket that has\nan entry in internal table.\nIf the filter returns a non-nil error, the system call function\nreturns the non-nil error.\n" (func [(* Status)] [error]))

^{:go/end 161} (go/method apply ^error [^AfterFilter f ^{:tag (* Status)} st]
  (when (== f nil)
    (return nil))

  (f st))



^{:go/end 169} (go/method Set "Set deploys the socket system call filter f for the filter type t.\n" [^{:tag (* Switch)} sw ^FilterType t ^Filter f]
  (.Do (.-once sw) (.-init sw))
  (.Lock (.-fmu sw))
  (aset (.-fltab sw) t f)
  (.Unlock (.-fmu sw)))

^{:go/end 162} (go/method Accept "Accept wraps syscall.Accept.\n" [^{:tag (* Switch)} sw ^int s] :results [^int ns ^syscall/Sockaddr sa ^error err]
  (let [so (.sockso sw s)]
    (when (== so nil)
      (return (syscall/Accept s)))

    (.RLock (.-fmu sw))
    (let [f (aget (.-fltab sw) FilterAccept)]
      (.RUnlock (.-fmu sw))

      (let [(values af ^:assign err) (.apply f so)]
        (when (!= err nil)
          (return -1 nil err))

        (set! (values ns sa (.-Err so)) (syscall/Accept s))
        (when [(set! err (.apply af so))] (!= err nil)
          (when (== (.-Err so) nil)
            (syscall/Close ns))

          (return -1 nil err))


        (.Lock (.-smu sw))
        (defer (.Unlock (.-smu sw)))
        (when (!= (.-Err so) nil)
          (inc! (.-AcceptFailed (.getLocked (.-stats sw) (.-Cookie so))))
          (return -1 nil (.-Err so)))

        (let [nso (.addLocked sw ns (.Family (.-Cookie so)) (.Type (.-Cookie so)) (.Protocol (.-Cookie so)))]
          (inc! (.-Accepted (.getLocked (.-stats sw) (.-Cookie nso))))
          (return ns sa nil))))))



^{:go/end 193} (go/method GetsockoptInt "GetsockoptInt wraps syscall.GetsockoptInt.\n" [^{:tag (* Switch)} sw ^int s ^int level ^int opt] :results [^int soerr ^error err]
  (let [so (.sockso sw s)]
    (when (== so nil)
      (return (syscall/GetsockoptInt s level opt)))

    (.RLock (.-fmu sw))
    (let [f (aget (.-fltab sw) FilterGetsockoptInt)]
      (.RUnlock (.-fmu sw))

      (let [(values af ^:assign err) (.apply f so)]
        (when (!= err nil)
          (return -1 err))

        (set! (values soerr (.-Err so)) (syscall/GetsockoptInt s level opt))
        (set! (.-SocketErr so) (conv syscall/Errno soerr))
        (when [(set! err (.apply af so))] (!= err nil)
          (return -1 err))


        (when (!= (.-Err so) nil)
          (return -1 (.-Err so)))

        (when (and (== opt syscall/SO_ERROR) ^:go/paren (or (== (.-SocketErr so) (conv syscall/Errno 0)) (== (.-SocketErr so) syscall/EISCONN)))
          (.Lock (.-smu sw))
          (inc! (.-Connected (.getLocked (.-stats sw) (.-Cookie so))))
          (.Unlock (.-smu sw)))

        (return soerr nil)))))

      (.RUnlock (.-fmu sw))

      ^{:go/breaks [9]} (let [(values af ^:assign err) (.apply f so)]
        (when (!= err nil)
          (return err))

        (set! (.-Err so) (syscall/Connect s sa))
        (when [(set! err (.apply af so))] (!= err nil)

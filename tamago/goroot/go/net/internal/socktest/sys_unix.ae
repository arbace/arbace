        (.Lock (.-smu sw))
        (defer (.Unlock (.-smu sw)))
        (when (!= (.-Err so) nil)
          (inc! (.-ConnectFailed (.getLocked (.-stats sw) (.-Cookie so))))
          (return (.-Err so)))

        (inc! (.-Connected (.getLocked (.-stats sw) (.-Cookie so))))
        nil))))




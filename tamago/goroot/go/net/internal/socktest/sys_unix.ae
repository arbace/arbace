(in-ns 'go.net.internal.socktest) (go/file "sys_unix.go" :build ["//go:build unix || (js && wasm) || wasip1 || tamago"] :imports [

    ^{:line 9} [syscall "syscall"]])


^{:go/end 41} (go/method Socket "Socket wraps [syscall.Socket].\n" [^{:tag (* Switch)} sw ^int family ^int sotype ^int proto] :results [^int s ^error err]
  (.Do (.-once sw) (.-init sw))

  (let [so (addr (lit Status :Cookie (cookie family sotype proto)))]
    (.RLock (.-fmu sw))
    (let [f (aget (.-fltab sw) FilterSocket)]
      (.RUnlock (.-fmu sw))

      (let [(values af ^:assign err) (.apply f so)]
        (when (!= err nil)
          (return -1 err))

        (set! (values s (.-Err so)) (syscall/Socket family sotype proto))
        (when [(set! err (.apply af so))] (!= err nil)
          (when (== (.-Err so) nil)
            (syscall/Close s))

          (return -1 err))


        (.Lock (.-smu sw))
        (defer (.Unlock (.-smu sw)))
        (when (!= (.-Err so) nil)
          (inc! (.-OpenFailed (.getLocked (.-stats sw) (.-Cookie so))))
          (return -1 (.-Err so)))

        (let [nso (.addLocked sw s family sotype proto)]
          (inc! (.-Opened (.getLocked (.-stats sw) (.-Cookie nso))))
          (return s nil))))))



^{:go/end 71} (go/method Close "Close wraps syscall.Close.\n" [^{:tag (* Switch)} sw ^int s] :results [^error err]
  (let [so (.sockso sw s)]
    (when (== so nil)
      (return (syscall/Close s)))

    (.RLock (.-fmu sw))
    (let [f (aget (.-fltab sw) FilterClose)]
      (.RUnlock (.-fmu sw))

      ^{:go/breaks [10]} (let [(values af ^:assign err) (.apply f so)]
        (when (!= err nil)
          (return err))

        (set! (.-Err so) (syscall/Close s))
        (when [(set! err (.apply af so))] (!= err nil)
          (return err))


        (.Lock (.-smu sw))
        (defer (.Unlock (.-smu sw)))
        (when (!= (.-Err so) nil)
          (inc! (.-CloseFailed (.getLocked (.-stats sw) (.-Cookie so))))
          (return (.-Err so)))

        (delete (.-sotab sw) s)
        (inc! (.-Closed (.getLocked (.-stats sw) (.-Cookie so))))
        nil))))



^{:go/end 100} (go/method Connect "Connect wraps syscall.Connect.\n" [^{:tag (* Switch)} sw ^int s ^syscall/Sockaddr sa] :results [^error err]
  (let [so (.sockso sw s)]

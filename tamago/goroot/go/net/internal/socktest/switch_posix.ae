(in-ns 'go.net.internal.socktest) (go/file "switch_posix.go" :build ["//go:build !plan9"] :imports [


    ^{:line 10} [fmt "fmt"]
    ^{:line 11} [syscall "syscall"]])


^{:go/end 25} (go/func familyString ^string [^int family]
  (switch family
    (case [syscall/AF_INET]
      (return "inet4"))
    (case [syscall/AF_INET6]
      (return "inet6"))
    (case [syscall/AF_UNIX]
      (return "local"))
    (default
      (return (fmt/Sprintf "%d" family)))))



^{:go/end 45} (go/func typeString ^string [^int sotype]
  (let [^string s (zero string)]
    (switch (bit-and sotype 0xff)
      (case [syscall/SOCK_STREAM]
        (set! s "stream"))
      (case [syscall/SOCK_DGRAM]
        (set! s "datagram"))
      (case [syscall/SOCK_RAW]
        (set! s "raw"))
      (case [syscall/SOCK_SEQPACKET]
        (set! s "seqpacket"))
      (default
        (set! s (fmt/Sprintf "%d" (bit-and sotype 0xff)))))

    (when [flags (bit-and (conv uint sotype) (bit-not (conv uint 0xff)))] (!= flags 0)
      (set! s + (fmt/Sprintf "|%#x" flags)))

    ^{:line 44} s))


^{:go/end 58} (go/func protocolString ^string [^int proto]
  (switch proto
    (case [0]
      (return "default"))
    (case [syscall/IPPROTO_TCP]
      (return "tcp"))
    (case [syscall/IPPROTO_UDP]
      (return "udp"))
    (default
      (return (fmt/Sprintf "%d" proto)))))

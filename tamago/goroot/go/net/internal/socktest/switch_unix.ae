(in-ns 'go.net.internal.socktest) (go/file "switch_unix.go" :build ["//go:build unix || (js && wasm) || wasip1 || tamago"] :imports [])


(go/type Sockets "Sockets maps a socket descriptor to the status of socket.\n" (map int Status))

^{:go/end 20} (go/method sockso ^{:tag (* Status)} [^{:tag (* Switch)} sw ^int s]
  (.RLock (.-smu sw))
  (defer (.RUnlock (.-smu sw)))
  (let [(values so ok) (aget (.-sotab sw) s)]
    (when (not ok)
      (return nil))

    (addr so)))




^{:go/end 29} (go/method addLocked "addLocked returns a new Status without locking.\nsw.smu must be held before call.\n" ^{:tag (* Status)} [^{:tag (* Switch)} sw ^int s ^int family ^int sotype ^int proto]
  (.Do (.-once sw) (.-init sw))
  (let [so (lit Status :Cookie (cookie family sotype proto))]
    (aset (.-sotab sw) s so)
    (addr so)))

^{:go/end 664} (go/func LookupAddr "LookupAddr performs a reverse lookup for the given address, returning a list\nof names mapping to that address.\n\nThe returned names are validated to be properly formatted presentation-format\ndomain names. If the response contains invalid names, those records are filtered\nout and an error will be returned alongside the remaining results, if any.\n\nWhen using the host C library resolver, at most one result will be\nreturned. To bypass the host resolver, use a custom [Resolver].\n\nLookupAddr uses [context.Background] internally; to specify the context, use\n[Resolver.LookupAddr].\n" [^string addr] :results [^{:tag (slice string)} names ^error err]
  (.LookupAddr DefaultResolver (context/Background) addr))








^{:go/end 687} (go/method LookupAddr "LookupAddr performs a reverse lookup for the given address, returning a list\nof names mapping to that address.\n\nThe returned names are validated to be properly formatted presentation-format\ndomain names. If the response contains invalid names, those records are filtered\nout and an error will be returned alongside the remaining results, if any.\n" [^{:tag (* Resolver)} r ^context/Context ctx ^string addr] :results [(slice string) error]
  (let [(values names err) (.lookupAddr r ctx addr)]
    (when (!= err nil)
      (return nil err))

    (let [filteredNames (make (slice string) 0 (len names))]
      (range [_ name names]
        (when (isDomainName name)
          (set! filteredNames (append filteredNames name))))


      (when (!= (len names) (len filteredNames))
        (return filteredNames (addr (lit DNSError :Err errMalformedDNSRecordsDetail :Name addr))))

      (return filteredNames nil))))





(go/var ^{:doc "errMalformedDNSRecordsDetail is the DNSError detail which is returned when a Resolver.Lookup...\nmethod receives DNS records which contain invalid DNS names. This may be returned alongside\nresults which have had the malformed records filtered out.\n"} errMalformedDNSRecordsDetail "DNS response contained records which contain invalid names")




^{:go/end 715} (go/method dial "dial makes a new connection to the provided server (which must be\nan IP address) with the provided network type, using either r.Dial\n(if both r and r.Dial are non-nil) or else Dialer.DialContext.\n" [^{:tag (* Resolver)} r ^context/Context ctx ^string network ^string server] :results [Conn error]
  ;; Calling Dial here is scary -- we have to be sure not to
  ;; dial a name that will require a DNS lookup, or Dial will
  ;; call back here to translate it. The DNS config parser has
  ;; already checked that all the cfg.servers are IP
  ;; addresses, which Dial will use without a DNS lookup.
  (let [^Conn c (zero Conn)
      ^{:line 704 :tag error} err (zero error)]
    (if (and (!= r nil) (!= (.-Dial r) nil))
      (set! (values c err) ((.-Dial r) ctx network server))

      (let [^Dialer d (zero Dialer)]
        (set! (values c err) (.DialContext d ctx network server))))

    (when (!= err nil)
      (return nil (mapErr err)))

    (return c nil)))











^{:go/end 774} (go/method goLookupSRV "goLookupSRV returns the SRV records for a target name, built either\nfrom its component service (\"sip\"), protocol (\"tcp\"), and name\n(\"example.com.\"), or from name directly (if service and proto are\nboth empty).\n\nIn either case, the returned target name (\"_sip._tcp.example.com.\")\nis also returned on success.\n\nThe records are sorted by weight.\n" [^{:tag (* Resolver)} r ^context/Context ctx ^string service ^string proto ^string name] :results [^string target ^{:tag (slice (* SRV))} srvs ^error err]
  (if (and (== service "") (== proto ""))
    (set! target name)

    (set! target (+ "_" service "._" proto "." name)))

  (let [(values p server ^:assign err) (.lookup r ctx target dnsmessage/TypeSRV nil)]
    (when (!= err nil)
      (return "" nil err))

    (let [^dnsmessage/Name cname (zero dnsmessage/Name)]
      (while true
        (let [(values h err) (.AnswerHeader p)]
          (when (== err dnsmessage/ErrSectionDone)
            (break))

          (when (!= err nil)
            (return "" nil (addr ^{:go/breaks [2 4 6]} (lit DNSError
                  :Err "cannot unmarshal DNS message"
                  :Name name
                  :Server server))))


          (when (!= (.-Type h) dnsmessage/TypeSRV)
            (when [err (.SkipAnswer p)] (!= err nil)
              (return "" nil (addr ^{:go/breaks [2 4 6]} (lit DNSError
                    :Err "cannot unmarshal DNS message"
                    :Name name
                    :Server server))))


            (continue))

          (when (and (== (.-Length cname) 0) (!= (.-Length (.-Name h)) 0))
            (set! cname (.-Name h)))

          (let [(values srv ^:assign err) (.SRVResource p)]
            (when (!= err nil)
              (return "" nil (addr ^{:go/breaks [2 4 6]} (lit DNSError
                    :Err "cannot unmarshal DNS message"
                    :Name name
                    :Server server))))


            (set! srvs (append srvs (addr (lit SRV :Target (.String (.-Target srv)) :Port (.-Port srv) :Priority (.-Priority srv) :Weight (.-Weight srv))))))))

      (.sort (conv byPriorityWeight srvs))
      (return (.String cname) srvs nil))))



^{:go/end 818} (go/method goLookupMX "goLookupMX returns the MX records for name.\n" [^{:tag (* Resolver)} r ^context/Context ctx ^string name] :results [(slice (* MX)) error]
  (let [(values p server err) (.lookup r ctx name dnsmessage/TypeMX nil)]
    (when (!= err nil)
      (return nil err))

    (let [^{:tag (slice (* MX))} mxs (zero (slice (* MX)))]
      (while true
        (let [(values h err) (.AnswerHeader p)]
          (when (== err dnsmessage/ErrSectionDone)
            (break))

          (when (!= err nil)
            (return nil (addr ^{:go/breaks [2 4 6]} (lit DNSError
                  :Err "cannot unmarshal DNS message"
                  :Name name
                  :Server server))))


          (when (!= (.-Type h) dnsmessage/TypeMX)
            (when [err (.SkipAnswer p)] (!= err nil)
              (return nil (addr ^{:go/breaks [2 4 6]} (lit DNSError
                    :Err "cannot unmarshal DNS message"
                    :Name name
                    :Server server))))


            (continue))

          (let [(values mx ^:assign err) (.MXResource p)]
            (when (!= err nil)
              (return nil (addr ^{:go/breaks [2 4 6]} (lit DNSError
                    :Err "cannot unmarshal DNS message"
                    :Name name
                    :Server server))))


            (set! mxs (append mxs (addr (lit MX :Host (.String (.-MX mx)) :Pref (.-Pref mx))))))))


      (.sort (conv byPref mxs))
      (return mxs nil))))




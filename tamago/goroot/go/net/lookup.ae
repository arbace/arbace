^{:go/end 916} (go/method goLookupTXT "goLookupTXT returns the TXT records from name.\n" [^{:tag (* Resolver)} r ^context/Context ctx ^string name] :results [(slice string) error]
  (let [(values p server err) (.lookup r ctx name dnsmessage/TypeTXT nil)]
    (when (!= err nil)
      (return nil err))

    (let [^{:tag (slice string)} txts (zero (slice string))]
      (while true
        (let [(values h err) (.AnswerHeader p)]
          (when (== err dnsmessage/ErrSectionDone)
            (break))

          (when (!= err nil)
            (return nil (addr ^{:go/breaks [2 4 6]} (lit DNSError
                  :Err "cannot unmarshal DNS message"
                  :Name name
                  :Server server))))


          (when (!= (.-Type h) dnsmessage/TypeTXT)
            (when [err (.SkipAnswer p)] (!= err nil)
              (return nil (addr ^{:go/breaks [2 4 6]} (lit DNSError
                    :Err "cannot unmarshal DNS message"
                    :Name name
                    :Server server))))


            (continue))

          (let [(values txt ^:assign err) (.TXTResource p)]
            (when (!= err nil)
              (return nil (addr ^{:go/breaks [2 4 6]} (lit DNSError
                    :Err "cannot unmarshal DNS message"
                    :Name name
                    :Server server))))


            ;; Multiple strings in one TXT record need to be
            ;; concatenated without separator to be consistent
            ;; with previous Go resolver.
            (let [n 0]
              (range [_ s (.-TXT txt)]
                (set! n + (len s)))

              (let [txtJoin (make (slice byte) 0 n)]
                (range [_ s (.-TXT txt)]
                  (set! txtJoin (append txtJoin (spread s))))

                (when (== (len txts) 0)
                  (set! txts (make (slice string) 0 1)))

                (set! txts (append txts (conv string txtJoin))))))))

      (return txts nil))))


^{:go/end 927} (go/func parseCNAMEFromResources [^{:tag (slice dnsmessage/Resource)} resources] :results [string error]
  (when (== (len resources) 0)
    (return "" (errors/New "no CNAME record received")))

  (let [(values c ok) (assert (* dnsmessage/CNAMEResource) (.-Body (aget resources 0)))]
    (when (not ok)
      (return "" (errors/New "could not parse CNAME record")))

    (return (.String (.-CNAME c)) nil)))

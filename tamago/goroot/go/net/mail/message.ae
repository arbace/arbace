      ;; Generate layouts based on RFC 5322, section 3.3.

      (let [dows (lit (array ... string) "" "Mon, ") ; day-of-week
          ^{:line 122} days (lit (array ... string) "2" "02") ; day = 1*2DIGIT
          ^{:line 123} years (lit (array ... string) "2006" "06") ; year = 4*DIGIT / 2*DIGIT

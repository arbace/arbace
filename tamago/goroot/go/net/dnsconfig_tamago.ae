(in-ns 'go.net) (go/file "dnsconfig_tamago.go" :build ["//go:build tamago"] :imports [])



^{:go/end 13} (go/func SetDefaultNS "SetDefaultNS sets the default name servers to use in the absence of DNS\nconfiguration.\n" [^{:tag (slice string)} servers]
  (set! defaultNS servers))

^{:go/end 201} (go/method WriteMsgUnix "WriteMsgUnix writes a message to addr via c, copying the payload\nfrom b and the associated out-of-band data from oob. It returns the\nnumber of payload and out-of-band bytes written.\n\nNote that if len(b) == 0 and len(oob) > 0, this function will still\nwrite 1 byte to the connection.\n" [^{:tag (* UnixConn)} c ^{:tag (slice byte)} b ^{:tag (slice byte)} oob ^{:tag (* UnixAddr)} addr] :results [^int n ^int oobn ^error err]
  (when (not ^{:go/via [conn]} (.ok c))
    (return 0 0 syscall/EINVAL))

  (set! (values n oobn err) (.writeMsg c b oob addr))
  (when (!= err nil)
    (set! err (addr (lit OpError :Op "write" :Net (.-net ^{:go/via [conn]} (.-fd c)) :Source (.-laddr ^{:go/via [conn]} (.-fd c)) :Addr (.opAddr addr) :Err err))))

  (return))



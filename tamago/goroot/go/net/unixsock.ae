(go/type UnixAddr "UnixAddr represents the address of a Unix domain socket end point.\n\nOn Linux, a Name beginning with \"@\" denotes an abstract socket address:\nthe \"@\" is translated to a NUL byte when the address is passed to the\nkernel, placing the socket in the abstract namespace rather than the\nfilesystem. Abstract sockets are a Linux-specific feature; on other\nplatforms, a Name beginning with \"@\" is treated as a literal filesystem\npath.\n" (struct
    ^{:line 31 :tag string} Name
    ^{:line 32 :tag string} Net))




^{:go/end 39} (go/method Network "Network returns the address's network name, \"unix\", \"unixgram\" or\n\"unixpacket\".\n" ^string [^{:tag (* UnixAddr)} a]
  (.-Net a))


^{:go/end 46} (go/method String ^string [^{:tag (* UnixAddr)} a]
  (when (== a nil)
    (return "<nil>"))

  (.-Name a))


^{:go/end 50} (go/method isWildcard ^bool [^{:tag (* UnixAddr)} a]
  (or (== a nil) (== (.-Name a) "")))


^{:go/end 57} (go/method opAddr ^Addr [^{:tag (* UnixAddr)} a]
  (when (== a nil)
    (return nil))

  ^{:line 56} a)








^{:go/end 72} (go/func ResolveUnixAddr "ResolveUnixAddr returns an address of Unix domain socket end point.\n\nThe network must be a Unix network name.\n\nSee func [Dial] for a description of the network and address\nparameters.\n" [^string network ^string address] :results [(* UnixAddr) error]
  (switch network
    (case ["unix" "unixgram" "unixpacket"]
      (return (addr (lit UnixAddr :Name address :Net network)) nil))
    (default
      (return nil (conv UnknownNetworkError network)))))






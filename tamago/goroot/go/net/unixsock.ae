^{:go/end 347} (go/func ListenUnix "ListenUnix acts like [Listen] for Unix networks.\n\nThe network must be \"unix\" or \"unixpacket\".\n" [^string network ^{:tag (* UnixAddr)} laddr] :results [(* UnixListener) error]
  (switch network
    (case ["unix" "unixpacket"])
    (default
      (return nil (addr (lit OpError :Op "listen" :Net network :Source nil :Addr (.opAddr laddr) :Err (conv UnknownNetworkError network))))))

  (when (== laddr nil)
    (return nil (addr (lit OpError :Op "listen" :Net network :Source nil :Addr (.opAddr laddr) :Err errMissingAddress))))

  (let [sl (addr (lit sysListener :network network :address (.String laddr)))
      (values ln err) (.listenUnix sl (context/Background) laddr)]
    (when (!= err nil)
      (return nil (addr (lit OpError :Op "listen" :Net network :Source nil :Addr (.opAddr laddr) :Err err))))

    (return ln nil)))





^{:go/end 367} (go/func ListenUnixgram "ListenUnixgram acts like [ListenPacket] for Unix networks.\n\nThe network must be \"unixgram\".\n" [^string network ^{:tag (* UnixAddr)} laddr] :results [(* UnixConn) error]

^{:go/end 213} (go/func DialUnix "DialUnix acts like [Dial] for Unix networks.\n\nThe network must be a Unix network name; see func [Dial] for details.\n\nIf laddr is non-nil, it is used as the local address for the\nconnection.\n" [^string network ^{:tag (* UnixAddr)} laddr ^{:tag (* UnixAddr)} raddr] :results [(* UnixConn) error]

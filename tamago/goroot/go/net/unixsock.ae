^{:go/end 156} (go/method ReadMsgUnix "ReadMsgUnix reads a message from c, copying the payload into b and\nthe associated out-of-band data into oob. It returns the number of\nbytes copied into b, the number of bytes copied into oob, the flags\nthat were set on the message and the source address of the message.\n\nNote that if len(b) == 0 and len(oob) > 0, this function will still\nread (and discard) 1 byte from the connection.\n" [^{:tag (* UnixConn)} c ^{:tag (slice byte)} b ^{:tag (slice byte)} oob] :results [^int n ^int oobn ^int flags ^{:tag (* UnixAddr)} addr ^error err]

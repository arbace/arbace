^{:go/end 230} (go/func dialUnix [^context/Context ctx ^{:tag (* Dialer)} dialer ^string network ^{:tag (* UnixAddr)} laddr ^{:tag (* UnixAddr)} raddr] :results [(* UnixConn) error]
  (switch network
    (case ["unix" "unixgram" "unixpacket"])
    (default
      (return nil (addr (lit OpError :Op "dial" :Net network :Source (.opAddr laddr) :Addr (.opAddr raddr) :Err (conv UnknownNetworkError network))))))

  (let [sd (addr (lit sysDialer :network network :address (.String raddr)))]
    (when (!= dialer nil)
      (set! (.-Dialer sd) @dialer))

    (let [(values c err) (.dialUnix sd ctx laddr raddr)]
      (when (!= err nil)
        (return nil (addr (lit OpError :Op "dial" :Net network :Source (.opAddr laddr) :Addr (.opAddr raddr) :Err err))))

      (return c nil))))






(in-ns 'go.net) (go/file "lookup_unix.go" :build ["//go:build unix || js || wasip1 || tamago"] :imports [


    ^{:line 10} [context "context"]
    ^{:line 11} [bytealg "internal/bytealg"]
    ^{:line 12} [sync "sync"]])




(go/var ^{:doc "readProtocolsOnce loads contents of /etc/protocols into protocols map\nfor quick access.\n"} readProtocolsOnce (sync/OnceFunc ^{:go/end 44} (fn []
      (let [(values file err) (open "/etc/protocols")]
        (when (!= err nil)
          (return))

        (defer (.close file))

        (for [(values line ok) (.readLine file)] ok (set! (values line ok) (.readLine file))
          ;; tcp    6   TCP    # transmission control protocol
          (when [i (bytealg/IndexByteString line \#)] (>= i 0)
            (set! line (subslice line 0 i)))

          (let [f (getFields line)]
            (when (< (len f) 2)
              (continue))

            (when [(values proto _ ok) (dtoi (aget f 1))] ok
              (when [(values _ ok) (aget protocols (aget f 0))] (not ok)
                (aset protocols (aget f 0) proto))

              (range [_ alias (subslice f 2)]
                (when [(values _ ok) (aget protocols alias)] (not ok)
                  (aset protocols alias proto))))))))))








^{:go/end 51} (go/func lookupProtocol "lookupProtocol looks up IP protocol name in /etc/protocols and\nreturns correspondent protocol number.\n" [^context/Context _ ^string name] :results [int error]
  (readProtocolsOnce)
  (lookupProtocolMap name))


^{:go/end 59} (go/method lookupHost [^{:tag (* Resolver)} r ^context/Context ctx ^string host] :results [^{:tag (slice string)} addrs ^error err]
  (let [(values order conf) (.hostLookupOrder (systemConf) r host)]
    (when (== order hostLookupCgo)
      (return (cgoLookupHost ctx host)))

    (.goLookupHostOrder r ctx host order conf)))


^{:go/end 68} (go/method lookupIP [^{:tag (* Resolver)} r ^context/Context ctx ^string network ^string host] :results [^{:tag (slice IPAddr)} addrs ^error err]
  (let [(values order conf) (.hostLookupOrder (systemConf) r host)]
    (when (== order hostLookupCgo)
      (return (cgoLookupIP ctx network host)))

    (let [(values ips _ ^:assign err) (.goLookupIPCNAMEOrder r ctx network host order conf)]
      (return ips err))))


^{:go/end 85} (go/method lookupPort [^{:tag (* Resolver)} r ^context/Context ctx ^string network ^string service] :results [int error]
  ;; Port lookup is not a DNS operation.
  ;; Prefer the cgo resolver if possible.
  (when (not (.mustUseGoResolver (systemConf) r))
    (let [(values port err) (cgoLookupPort ctx network service)]
      (when (!= err nil)
        ;; Issue 18213: if cgo fails, first check to see whether we
        ;; have the answer baked-in to the net package.
        (when [(values port err) (goLookupPort network service)] (== err nil)
          (return port nil)))


      (return port err)))

  (goLookupPort network service))


^{:go/end 95} (go/method lookupCNAME [^{:tag (* Resolver)} r ^context/Context ctx ^string name] :results [string error]
  (let [(values order conf) (.hostLookupOrder (systemConf) r name)]
    (when (== order hostLookupCgo)
      (when [(values cname err) (cgoLookupCNAME ctx name)] (== err nil)
        (return cname nil)))


    (.goLookupCNAME r ctx name order conf)))


^{:go/end 99} (go/method lookupSRV [^{:tag (* Resolver)} r ^context/Context ctx ^string service ^string proto ^string name] :results [string (slice (* SRV)) error]
  (.goLookupSRV r ctx service proto name))


^{:go/end 103} (go/method lookupMX [^{:tag (* Resolver)} r ^context/Context ctx ^string name] :results [(slice (* MX)) error]
  (.goLookupMX r ctx name))


^{:go/end 107} (go/method lookupNS [^{:tag (* Resolver)} r ^context/Context ctx ^string name] :results [(slice (* NS)) error]
  (.goLookupNS r ctx name))


^{:go/end 111} (go/method lookupTXT [^{:tag (* Resolver)} r ^context/Context ctx ^string name] :results [(slice string) error]
  (.goLookupTXT r ctx name))


^{:go/end 119} (go/method lookupAddr [^{:tag (* Resolver)} r ^context/Context ctx ^string addr] :results [(slice string) error]
  (let [(values order conf) (.addrLookupOrder (systemConf) r addr)]
    (when (== order hostLookupCgo)
      (return (cgoLookupPTR ctx addr)))

    (.goLookupPTR r ctx addr order conf)))

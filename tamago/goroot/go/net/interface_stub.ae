(in-ns 'go.net) (go/file "interface_stub.go" :build ["//go:build js || wasip1 || tamago"] :imports [])




^{:go/end 14} (go/func interfaceTable "If the ifindex is zero, interfaceTable returns mappings of all\nnetwork interfaces. Otherwise it returns a mapping of a specific\ninterface.\n" [^int ifindex] :results [(slice Interface) error]
  (return nil nil))





^{:go/end 21} (go/func interfaceAddrTable "If the ifi is nil, interfaceAddrTable returns addresses for all\nnetwork interfaces. Otherwise it returns addresses for a specific\ninterface.\n" [^{:tag (* Interface)} ifi] :results [(slice Addr) error]
  (return nil nil))




^{:go/end 27} (go/func interfaceMulticastAddrTable "interfaceMulticastAddrTable returns addresses for a specific\ninterface.\n" [^{:tag (* Interface)} ifi] :results [(slice Addr) error]
  (return nil nil))

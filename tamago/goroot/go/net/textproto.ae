(ns go.net.textproto
  (:require [arbace.go :as go]))

(go/package textproto
  :path "net/textproto"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["header.go" "pipeline.go" "reader.go" "textproto.go" "writer.go"]
  :init-order [errMessageTooLarge colon nl crnl dotcrnl]
  :positions :lines)

(load "textproto/header")
(load "textproto/pipeline")
(load "textproto/reader")
(load "textproto/textproto")
(load "textproto/writer")

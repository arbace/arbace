(ns go.net.rpc
  (:require [arbace.go :as go]))

(go/package rpc
  :path "net/rpc"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["client.go" "debug.go" "server.go"]
  :init-order [ErrShutdown debug debugLog typeOfError DefaultServer invalidRequest connected]
  :positions :lines)

(load "rpc/client")
(load "rpc/debug")
(load "rpc/server")

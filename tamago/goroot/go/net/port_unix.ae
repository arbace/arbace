;; Read system port mappings from /etc/services

(in-ns 'go.net) (go/file "port_unix.go" :build ["//go:build unix || js || wasip1 || tamago"] :imports [


    ^{:line 12} [bytealg "internal/bytealg"]
    ^{:line 13} [sync "sync"]])


(go/var ^sync/Once onceReadServices)

^{:go/end 51} (go/func readServices []
  (let [(values file err) (open "/etc/services")]
    (when (!= err nil)
      (return))

    (defer (.close file))

    (for [(values line ok) (.readLine file)] ok (set! (values line ok) (.readLine file))
      ;; "http 80/tcp www www-http # World Wide Web HTTP"
      (when [i (bytealg/IndexByteString line \#)] (>= i 0)
        (set! line (subslice line _ i)))

      (let [f (getFields line)]
        (when (< (len f) 2)
          (continue))

        (let [portnet (aget f 1) ; "80/tcp"
            (values port j ok) (dtoi portnet)]
          (when (or (not ok) (<= port 0) (>= j (len portnet)) (!= (aget portnet j) \/))
            (continue))

          (let [netw (subslice portnet (+ j 1)) ; "tcp"
              (values m ok1) (aget services netw)]
            (when (not ok1)
              (set! m (make (map string int)))
              (aset services netw m))

            (for [i 0] (< i (len f)) (inc! i)
              (when (!= i 1) ; f[1] was port/net
                (aset m (aget f i) port)))))))))






^{:go/end 57} (go/func goLookupPort "goLookupPort is the native Go implementation of LookupPort.\n" [^string network ^string service] :results [^int port ^error err]
  (.Do onceReadServices readServices)
  (lookupPortMap network service))

^{:go/end 19} (go/func sortByRFC6724 [^{:tag (slice IPAddr)} addrs]
  (when (< (len addrs) 2)
    (return))

  (sortByRFC6724withSrcs addrs (srcAddrs addrs)))


^{:go/end 39} (go/func sortByRFC6724withSrcs [^{:tag (slice IPAddr)} addrs ^{:tag (slice netip/Addr)} srcs]
  (when (!= (len addrs) (len srcs))
    (panic "internal error"))

  (let [addrInfos (make (slice byRFC6724Info) (len addrs))]
    (range [i v addrs]
      (let [(values addrAttrIP _) (netip/AddrFromSlice (.-IP v))]
        (aset addrInfos i ^{:go/breaks [2 4 6 8]} (lit byRFC6724Info
            :addr (aget addrs i)
            :addrAttr (ipAttrOf addrAttrIP)
            :src (aget srcs i)
            :srcAttr (ipAttrOf (aget srcs i))))))


    (^{:inst [(slice byRFC6724Info) byRFC6724Info]} slices/SortStableFunc addrInfos compareByRFC6724)
    (range [i addrInfos]
      (aset addrs i (.-addr (aget addrInfos i))))))






^{:go/end 59} (go/func srcAddrs "srcAddrs tries to UDP-connect to each address to see if it has a\nroute. (This doesn't send any packets). The destination port\nnumber is irrelevant.\n" ^{:tag (slice netip/Addr)} [^{:tag (slice IPAddr)} addrs]
  (let [srcs (make (slice netip/Addr) (len addrs))
      ^{:line 46} dst (lit UDPAddr :Port 53)]
    (range [i addrs]
      (set! (.-IP dst) (.-IP (aget addrs i)))
      (set! (.-Zone dst) (.-Zone (aget addrs i)))
      (let [(values c err) (DialUDP "udp" nil (addr dst))]
        (when (== err nil)
          (when [(values src ok) (assert (* UDPAddr) ^{:go/via [conn]} (.LocalAddr c))] ok
            (set! (values (aget srcs i) _) (netip/AddrFromSlice (.-IP src))))

          ^{:go/via [conn]} (.Close c))))


    ^{:line 58} srcs))



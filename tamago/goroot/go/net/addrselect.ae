^{:go/end 294} (go/method Classify "Classify returns the policyTableEntry of the entry with the longest\nmatching prefix that contains ip.\nThe table t must be sorted from largest mask size to smallest.\n" ^policyTableEntry [^policyTable t ^netip/Addr ip]
  ;; Prefix.Contains() will not match an IPv6 prefix for an IPv4 address.
  (when (.Is4 ip)
    (set! ip (netip/AddrFrom16 (.As16 ip))))

  (range [_ ent t]
    (when (.Contains (.-Prefix ent) ip)
      (return ent)))


  (lit policyTableEntry))



(go/type scope "RFC 6724 section 3.1.\n" uint8)

(go/const
  ^{:line 300} [^{:tag scope :val 1} scopeInterfaceLocal 0x1]
  ^{:line 301} [^{:tag scope :val 2} scopeLinkLocal 0x2]
  ^{:line 302} [^{:tag scope :val 4} scopeAdminLocal 0x4]
  ^{:line 303} [^{:tag scope :val 5} scopeSiteLocal 0x5]
  ^{:line 304} [^{:tag scope :val 8} scopeOrgLocal 0x8]
  ^{:line 305} [^{:tag scope :val 14} scopeGlobal 0xe])


^{:go/end 323} (go/func classifyScope ^scope [^netip/Addr ip]
  (when (or (.IsLoopback ip) (.IsLinkLocalUnicast ip))
    (return scopeLinkLocal))

  (let [ipv6 (and (.Is6 ip) (not (.Is4In6 ip)))
      ^{:line 313} ipv6AsBytes (.As16 ip)]
    (when (and ipv6 (.IsMulticast ip))
      (return (conv scope (bit-and (aget ipv6AsBytes 1) 0xf))))

    ;; Site-local addresses are defined in RFC 3513 section 2.5.6
    ;; (and deprecated in RFC 3879).
    (when (and ipv6 (== (aget ipv6AsBytes 0) 0xfe) (== (bit-and (aget ipv6AsBytes 1) 0xc0) 0xc0))
      (return scopeSiteLocal))

    ^{:line 322} scopeGlobal))












^{:go/end 368} (go/func commonPrefixLen "commonPrefixLen reports the length of the longest prefix (looking\nat the most significant, or leftmost, bits) that the\ntwo addresses have in common, up to the length of a's prefix (i.e.,\nthe portion of the address not including the interface ID).\n\nIf a or b is an IPv4 address as an IPv6 address, the IPv4 addresses\nare compared (with max common prefix length of 32).\nIf a and b are different IP versions, 0 is returned.\n\nSee https://tools.ietf.org/html/rfc6724#section-2.2\n" [^netip/Addr a ^IP b] :results [^int cpl]
  (when [b4 (.To4 b)] (!= b4 nil)
    (set! b b4))

  (let [aAsSlice (.AsSlice a)]
    (when (!= (len aAsSlice) (len b))
      (return 0))

    ;; If IPv6, only up to the prefix (first 64 bits)
    (when (> (len aAsSlice) 8)
      (set! aAsSlice (subslice aAsSlice _ 8))
      (set! b (subslice b _ 8)))

    (while (> (len aAsSlice) 0)
      (when (== (aget aAsSlice 0) (aget b 0))
        (set! cpl + 8)
        (set! aAsSlice (subslice aAsSlice 1))
        (set! b (subslice b 1))
        (continue))

      (let [bits 8
          (values ab bb) (values (aget aAsSlice 0) (aget b 0))]
        (while true
          (set! ab >> 1)
          (set! bb >> 1)
          (dec! bits)
          (when (== ab bb)
            (set! cpl + bits)
            (return)))))



    (return)))

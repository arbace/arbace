    ^{:line 63 :tag uint8} Precedence
    ^{:line 64 :tag uint8} Label))


^{:go/end 77} (go/func ipAttrOf ^ipAttr [^netip/Addr ip]
  (when (not (.IsValid ip))
    (return (lit ipAttr)))

  (let [match (.Classify rfc6724policyTable ip)]
    ^{:go/breaks [2 4 6]} (lit ipAttr
      :Scope (classifyScope ip)
      :Precedence (.-Precedence match)
      :Label (.-Label match))))



(go/type byRFC6724Info (struct
    ^{:line 80 :tag IPAddr} addr
    ^{:line 81 :tag ipAttr} addrAttr

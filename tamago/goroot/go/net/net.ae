      (set! threadLimit (make (chan (struct)) (concurrentThreadsLimit)))))

  (select
    (case (>! threadLimit (lit (struct)))
      (return nil))
    (case (<! (.Done ctx))
      (return (.Err ctx)))))



^{:go/end 825} (go/func releaseThread []
  (<! threadLimit))







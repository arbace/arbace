  (return))





(go/type PacketConn "PacketConn is a generic packet-oriented network connection.\n\nMultiple goroutines may invoke methods on a PacketConn simultaneously.\n" (interface









    (^{:doc "ReadFrom reads a packet from the connection,\ncopying the payload into p. It returns the number of\nbytes copied into p and the return address that\nwas on the packet.\nIt returns the number of bytes read (0 <= n <= len(p))\nand any error encountered. Callers should always process\nthe n > 0 bytes returned before considering the error err.\nReadFrom can be made to time out and return an error after a\nfixed time limit; see SetDeadline and SetReadDeadline.\n"} ReadFrom [^{:tag (slice byte)} p] :results [^int n ^Addr addr ^error err])





    (^{:doc "WriteTo writes a packet with payload p to addr.\nWriteTo can be made to time out and return an Error after a\nfixed time limit; see SetDeadline and SetWriteDeadline.\nOn packet-oriented connections, write timeouts are rare.\n"} WriteTo [^{:tag (slice byte)} p ^Addr addr] :results [^int n ^error err])




^{:go/end 58} (go/method readFrom [^{:tag (* IPConn)} c ^{:tag (slice byte)} b] :results [int (* IPAddr) error]
  ;; TODO(cw,rsc): consider using readv if we know the family
  ;; type to avoid the header trim/copy
  (let [^{:tag (* IPAddr)} addr (zero (* IPAddr))
      (values n sa err) (.readFrom ^{:go/via [conn]} (.-fd c) b)]
    (type-switch [sa sa]
      (case [(* syscall/SockaddrInet4)]
        (set! addr (addr (lit IPAddr :IP (subslice (.-Addr sa) 0))))
        (set! n (stripIPv4Header n b)))
      (case [(* syscall/SockaddrInet6)]
        (set! addr (addr (lit IPAddr :IP (subslice (.-Addr sa) 0) :Zone (.name zoneCache (conv int (.-ZoneId sa))))))))

    (return n addr err)))


^{:go/end 73} (go/func stripIPv4Header ^int [^int n ^{:tag (slice byte)} b]
  (when (< (len b) 20)
    (return n))

  (let [l (<< (conv int (bit-and (aget b 0) 0x0f)) 2)]
    (when (or (> 20 l) (> l (len b)))
      (return n))

    (when (!= (>> (aget b 0) 4) 4)
      (return n))

    (copy b (subslice b l))
    (- n l)))


^{:go/end 85} (go/method readMsg [^{:tag (* IPConn)} c ^{:tag (slice byte)} b ^{:tag (slice byte)} oob] :results [^int n ^int oobn ^int flags ^{:tag (* IPAddr)} addr ^error err]
  (let [^syscall/Sockaddr sa (zero syscall/Sockaddr)]
    (set! (values n oobn flags sa err) (.readMsg ^{:go/via [conn]} (.-fd c) b oob 0))
    (type-switch [sa sa]
      (case [(* syscall/SockaddrInet4)]
        (set! addr (addr (lit IPAddr :IP (subslice (.-Addr sa) 0)))))
      (case [(* syscall/SockaddrInet6)]
        (set! addr (addr (lit IPAddr :IP (subslice (.-Addr sa) 0) :Zone (.name zoneCache (conv int (.-ZoneId sa))))))))

    (return)))


^{:go/end 99} (go/method writeTo [^{:tag (* IPConn)} c ^{:tag (slice byte)} b ^{:tag (* IPAddr)} addr] :results [int error]
  (when (.-isConnected ^{:go/via [conn]} (.-fd c))
    (return 0 ErrWriteToConnected))

  (when (== addr nil)
    (return 0 errMissingAddress))

  (let [(values sa err) (.sockaddr addr (.-family ^{:go/via [conn]} (.-fd c)))]
    (when (!= err nil)
      (return 0 err))

    (.writeTo ^{:go/via [conn]} (.-fd c) b sa)))


^{:go/end 113} (go/method writeMsg [^{:tag (* IPConn)} c ^{:tag (slice byte)} b ^{:tag (slice byte)} oob ^{:tag (* IPAddr)} addr] :results [^int n ^int oobn ^error err]

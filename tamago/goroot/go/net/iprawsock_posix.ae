^{:go/breaks [[4 21]] :go/end 22} (go/func sockaddrToIP ^Addr [^syscall/Sockaddr sa]
  (type-switch [sa sa]
    (case [(* syscall/SockaddrInet4)]
      (return (addr (lit IPAddr :IP (subslice (.-Addr sa) 0)))))
    (case [(* syscall/SockaddrInet6)]
      (return (addr (lit IPAddr :IP (subslice (.-Addr sa) 0) :Zone (.name zoneCache (conv int (.-ZoneId sa))))))))

  nil)


^{:go/end 32} (go/method family ^int [^{:tag (* IPAddr)} a]
  (when (or (== a nil) (<= (len (.-IP a)) IPv4len))

^{:go/end 136} (go/method dialIP [^{:tag (* sysDialer)} sd ^context/Context ctx ^{:tag (* IPAddr)} laddr ^{:tag (* IPAddr)} raddr] :results [(* IPConn) error]
  (let [(values network proto err) (parseNetwork ctx (.-network sd) true)]
    (when (!= err nil)
      (return nil err))

    (switch network
      (case ["ip" "ip4" "ip6"])
      (default

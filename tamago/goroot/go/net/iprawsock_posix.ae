    (let [ctrlCtxFn (.-ControlContext (.-Dialer sd))]
      (when (and (== ctrlCtxFn nil) (!= (.-Control (.-Dialer sd)) nil))
        (set! ctrlCtxFn ^{:go/end 129} (fn ^error [^context/Context ctx ^string network ^string address ^syscall/RawConn c]
            ((.-Control (.-Dialer sd)) network address c))))


      (let [(values fd ^:assign err) (internetSocket ctx network laddr raddr syscall/SOCK_RAW proto "dial" ctrlCtxFn)]
        (when (!= err nil)
          (return nil err))

        (return (newIPConn fd) nil)))))



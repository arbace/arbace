(ns go.net.url
  (:require [arbace.go :as go]))

(go/package url
  :path "net/url"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["encoding_table.go" "url.go"]
  :init-order [table urlstrictcolons urlmaxqueryparams]
  :positions :lines)

(load "url/encoding_table")
(load "url/url")

(ns go.net.http
  (:require [arbace.go :as go]))

(go/package http
  :path "net/http"
  :files ["client.go" "clientconn.go" "clone.go" "cookie.go" "csrf.go" "doc.go" "filetransport.go" "fs.go" "header.go" "http.go" "http2.go" "jar.go" "mapping.go" "method.go" "pattern.go" "request.go" "response.go" "responsecontroller.go" "roundtrip.go" "routing_index.go" "routing_tree.go" "servemux121.go" "server.go" "sniff.go" "socks_bundle.go" "status.go" "transfer.go" "transport.go" "transport_default_other.go"]
  :positions :lines)

(load "http/client")
(load "http/clientconn")
(load "http/clone")
(load "http/cookie")
(load "http/csrf")
(load "http/doc")
(load "http/filetransport")
(load "http/fs")
(load "http/header")
(load "http/http")
(load "http/http2")
(load "http/jar")
(load "http/mapping")
(load "http/method")
(load "http/pattern")
(load "http/request")
(load "http/response")
(load "http/responsecontroller")
(load "http/roundtrip")
(load "http/routing_index")
(load "http/routing_tree")
(load "http/servemux121")
(load "http/server")
(load "http/sniff")
(load "http/socks_bundle")
(load "http/status")
(load "http/transfer")
(load "http/transport")
(load "http/transport_default_other")

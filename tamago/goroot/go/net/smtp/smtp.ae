  (let [(values _ _ err) ^{:go/via [Reader]} (.ReadResponse (.-Text (.-c d)) 250)]
    ^{:line 284} err))






^{:go/end 297} (go/method Data "Data issues a DATA command to the server and returns a writer that\ncan be used to write the mail headers and body. The caller should\nclose the writer before calling any more methods on c. A call to\nData must be preceded by one or more calls to [Client.Rcpt].\n" [^{:tag (* Client)} c] :results [io/WriteCloser error]
  (let [(values _ _ err) (.cmd c 354 "DATA")]
    (when (!= err nil)
      (return nil err))

    (return (addr (lit dataCloser c ^{:go/via [Writer]} (.DotWriter (.-Text c)))) nil)))


(go/var ^{:tag (func [(* tls/Config)])} testHookStartTLS) ; nil, except for tests





















^{:go/end 376} (go/func SendMail "SendMail connects to the server at addr, switches to TLS if\npossible, authenticates with the optional mechanism a if possible,\nand then sends an email from address from, to addresses to, with\nmessage msg.\nThe addr must include a port, as in \"mail.example.com:smtp\".\n\nThe addresses in the to parameter are the SMTP RCPT addresses.\n\nThe msg parameter should be an RFC 822-style email with headers\nfirst, a blank line, and then the message body. The lines of msg\nshould be CRLF terminated. The msg headers should usually include\nfields such as \"From\", \"To\", \"Subject\", and \"Cc\".  Sending \"Bcc\"\nmessages is accomplished by including an email address in the to\nparameter but not including it in the msg headers.\n\nThe SendMail function and the net/smtp package are low-level\nmechanisms and provide no support for DKIM signing, MIME\nattachments (see the mime/multipart package), or other mail\nfunctionality. Higher-level packages exist outside of the standard\nlibrary.\n" ^error [^string addr ^Auth a ^string from ^{:tag (slice string)} to ^{:tag (slice byte)} msg]
  (when [err (validateLine from)] (!= err nil)
    (return err))

  (range [_ recp to]
    (when [err (validateLine recp)] (!= err nil)
      (return err)))


  (let [(values c err) (Dial addr)]
    (when (!= err nil)
      (return err))

    (defer (.Close c))
    (when [(set! err (.hello c))] (!= err nil)
      (return err))

    (when [(values ok _) (.Extension c "STARTTLS")] ok
      (let [config (addr (lit tls/Config :ServerName (.-serverName c)))]
        (when (!= testHookStartTLS nil)
          (testHookStartTLS config))

        (when [(set! err (.StartTLS c config))] (!= err nil)
          (return err))))


    (when (and (!= a nil) (!= (.-ext c) nil))
      (when [(values _ ok) (aget (.-ext c) "AUTH")] (not ok)
        (return (errors/New "smtp: server doesn't support AUTH")))

      (when [(set! err (.Auth c a))] (!= err nil)
        (return err)))


    (when [(set! err (.Mail c from))] (!= err nil)
      (return err))

    (range [_ addr to]
      (when [(set! err (.Rcpt c addr))] (!= err nil)
        (return err)))


    (let [(values w ^:assign err) (.Data c)]
      (when (!= err nil)
        (return err))

      (set! (values _ err) (.Write w msg))
      (when (!= err nil)
        (return err))

      (set! err (.Close w))
      (when (!= err nil)
        (return err))

      (.Quit c))))






^{:go/end 392} (go/method Extension "Extension reports whether an extension is support by the server.\nThe extension name is case-insensitive. If the extension is supported,\nExtension also returns a string that contains any parameters the\nserver specifies for the extension.\n" [^{:tag (* Client)} c ^string ext] :results [bool string]
  (when [err (.hello c)] (!= err nil)
    (return false ""))

  (when (== (.-ext c) nil)
    (return false ""))

  (set! ext (strings/ToUpper ext))
  (let [(values param ok) (aget (.-ext c) ext)]
    (return ok param)))





    (.Close (.-Text c))))



^{:go/breaks [[5 429]] :go/end 430} (go/func validateLine "validateLine checks to see if a line has CR or LF as per RFC 5321.\n" ^error [^string line]
  (when (strings/ContainsAny line "\n\r")

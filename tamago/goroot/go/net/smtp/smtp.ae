^{:go/end 422} (go/method Quit "Quit sends the QUIT command and closes the connection to the server.\n" ^error [^{:tag (* Client)} c]
  (.hello c) ; ignore error; we're quitting anyhow
  (let [(values _ _ err) (.cmd c 221 "QUIT")]
    (when (!= err nil)

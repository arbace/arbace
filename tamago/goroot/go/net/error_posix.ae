(in-ns 'go.net) (go/file "error_posix.go" :build ["//go:build unix || js || wasip1 || windows || tamago"] :imports [


    ^{:line 10} [os "os"]
    ^{:line 11} [syscall "syscall"]])




^{:go/end 21} (go/func wrapSyscallError "wrapSyscallError takes an error and a syscall name. If the error is\na syscall.Errno, it wraps it in an os.SyscallError using the syscall name.\n" ^error [^string name ^error err]
  (when [(values _ ok) (assert syscall/Errno err)] ok
    (set! err (os/NewSyscallError name err)))

  ^{:line 20} err)

;; This file holds stub versions of the cgo functions called on Unix systems.
;; We build this file:
;; - if using the netgo build tag on a Unix system
;; - on a Unix system without the cgo resolver functions
;;   (Darwin always provides the cgo functions, in cgo_unix_syscall.go)
;; - on wasip1, where cgo is never available



(in-ns 'go.net) (go/file "cgo_stub.go" :build ["//go:build (netgo && unix) || (unix && !cgo && !darwin) || js || wasip1 || tamago"] :imports [

    ^{:line 16} [context "context"]])



(go/const ^{:val false :doc "cgoAvailable set to false to indicate that the cgo resolver\nis not available on this system.\n"} cgoAvailable false)

^{:go/end 24} (go/func cgoLookupHost [^context/Context ctx ^string name] :results [^{:tag (slice string)} addrs ^error err]
  (panic "cgo stub: cgo not available"))


^{:go/end 28} (go/func cgoLookupPort [^context/Context ctx ^string network ^string service] :results [^int port ^error err]
  (panic "cgo stub: cgo not available"))


^{:go/end 32} (go/func cgoLookupIP [^context/Context ctx ^string network ^string name] :results [^{:tag (slice IPAddr)} addrs ^error err]
  (panic "cgo stub: cgo not available"))


^{:go/end 36} (go/func cgoLookupCNAME [^context/Context ctx ^string name] :results [^string cname ^error err]
  (panic "cgo stub: cgo not available"))


^{:go/end 40} (go/func cgoLookupPTR [^context/Context ctx ^string addr] :results [^{:tag (slice string)} ptrs ^error err]
  (panic "cgo stub: cgo not available"))

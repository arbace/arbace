  (let [a (make (slice string) (+ 1 (countAnyByte s t)))
      ^{:line 105} n 0
      ^{:line 106} last 0]
    (for [i 0] (< i (len s)) (inc! i)
      (when (>= (bytealg/IndexByteString t (aget s i)) 0)
        (when (< last i)
          (aset a n (subslice s last i))
          (inc! n))

        (set! last (+ i 1))))



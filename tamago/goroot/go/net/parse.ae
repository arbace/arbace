^{:go/breaks [[6 251]] :go/end 252} (go/func foreachField "foreachField runs fn on each non-empty run of non-space bytes in x.\nIt returns the first non-nil error returned by fn.\n" ^error [^string x ^{:tag (func [^string field] [error])} fn]
  (set! x (trimSpace x))

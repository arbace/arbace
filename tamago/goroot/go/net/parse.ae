^{:go/end 47} (go/method getLineFromData [^{:tag (* file)} f] :results [^string s ^bool ok]
  (let [data (.-data f)
      ^{:line 27} i 0]
    (for [(set! i 0)] (< i (len data)) (inc! i)
      (when (== (aget data i) \newline)
        (set! s (conv string (subslice data 0 i)))
        (set! ok true)
        ;; move data
        (inc! i)
        (let [n (- (len data) i)]
          (copy (subslice data 0) (subslice data i))
          (set! (.-data f) (subslice data 0 n))
          (return))))


    (when (and (.-atEOF f) (> (len (.-data f)) 0))
      ;; EOF, return all we have
      (set! s (conv string data))
      (set! (.-data f) (subslice (.-data f) 0 0))
      (set! ok true))

    (return)))


^{:go/end 65} (go/method readLine [^{:tag (* file)} f] :results [^string s ^bool ok]
  (when [(set! (values s ok) (.getLineFromData f))] ok
    (return))

  (when (< (len (.-data f)) (cap (.-data f)))
    (let [ln (len (.-data f))
        (values n err) (io/ReadFull (.-file f) (subslice (.-data f) ln (cap (.-data f))))]
      (when (>= n 0)
        (set! (.-data f) (subslice (.-data f) 0 (+ ln n))))

      (when (or (== err io/EOF) (== err io/ErrUnexpectedEOF))
        (set! (.-atEOF f) true))))


  (set! (values s ok) (.getLineFromData f))
  (return))


^{:go/end 73} (go/method stat [^{:tag (* file)} f] :results [^time/Time mtime ^int64 size ^error err]
  (let [(values st ^:assign err) (.Stat (.-file f))]
    (when (!= err nil)
      (return (lit time/Time) 0 err))

    (return (.ModTime st) (.Size st) nil)))


^{:go/end 81} (go/func open [^string name] :results [(* file) error]
  (let [(values fd err) (os/Open name)]

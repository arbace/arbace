(go/const ^{:val 16777215 :doc "Bigger than we need, not too big to worry about overflow\n"} big 0xFFFFFF)



^{:go/end 142} (go/func dtoi "Decimal to integer.\nReturns number, characters consumed, success.\n" [^string s] :results [^int n ^int i ^bool ok]
  (set! n 0)
  (for [(set! i 0)] (and (< i (len s)) (<= \0 (aget s i)) (<= (aget s i) \9)) (inc! i)
    (set! n (+ (* n 10) (conv int (- (aget s i) \0))))
    (when (>= n big)
      (return big i false)))


  (when (== i 0)
    (return 0 0 false))

  (return n i true))




^{:go/end 169} (go/func xtoi "Hexadecimal to integer.\nReturns number, characters consumed, success.\n" [^string s] :results [^int n ^int i ^bool ok]
  (set! n 0)
  (for [(set! i 0)] (< i (len s)) (inc! i)
    (cond (and (<= \0 (aget s i)) (<= (aget s i) \9)) (do
        (set! n * 16)
        (set! n + (conv int (- (aget s i) \0))))
      (and (<= \a (aget s i)) (<= (aget s i) \f)) (do
        (set! n * 16)
        (set! n + (+ (conv int (- (aget s i) \a)) 10)))
      (and (<= \A (aget s i)) (<= (aget s i) \F)) (do
        (set! n * 16)
        (set! n + (+ (conv int (- (aget s i) \A)) 10))) :else

      (break))

    (when (>= n big)
      (return 0 i false)))


  (when (== i 0)
    (return 0 i false))

  (return n i true))






^{:go/end 181} (go/func xtoi2 "xtoi2 converts the next two hex digits of s into a byte.\nIf s is longer than 2 bytes then the third byte must be e.\nIf the first two bytes of s are not hex digits or the third byte\ndoes not match e, false is returned.\n" [^string s ^byte e] :results [byte bool]
  (when (and (> (len s) 2) (!= (aget s 2) e))
    (return 0 false))

  (let [(values n ei ok) (xtoi (subslice s _ 2))]
    (return (conv byte n) (and ok (== ei 2)))))




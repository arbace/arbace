^{:go/breaks [[6 271]] :go/end 272} (go/func stringsEqualFold "stringsEqualFold is strings.EqualFold, ASCII only. It reports whether s and t\nare equal, ASCII-case-insensitively.\n" ^bool [^string s ^string t]

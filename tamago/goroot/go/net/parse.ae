      (return nil err))

    (return (addr (lit file fd (make (slice byte) 0 (* 64 1024)) false)) nil)))


^{:go/end 89} (go/func stat [^string name] :results [^time/Time mtime ^int64 size ^error err]
  (let [(values st ^:assign err) (os/Stat name)]

^{:go/end 127} (go/method readMsg [^{:tag (* UnixConn)} c ^{:tag (slice byte)} b ^{:tag (slice byte)} oob] :results [^int n ^int oobn ^int flags ^{:tag (* UnixAddr)} addr ^error err]

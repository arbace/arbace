    (when (!= (.-Control (.-ListenConfig sl)) nil)
      (set! ctrlCtxFn ^{:go/end 224} (fn ^error [^context/Context ctx ^string network ^string address ^syscall/RawConn c]
          ((.-Control (.-ListenConfig sl)) network address c))))


    (let [(values fd err) (unixSocket ctx (.-network sl) laddr nil "listen" ctrlCtxFn)]

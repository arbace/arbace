^{:go/end 50} (go/func unixSocket [^context/Context ctx ^string net ^sockaddr laddr ^sockaddr raddr ^string mode ^{:tag (func [context/Context string string syscall/RawConn] [error])} ctxCtrlFn] :results [(* netFD) error]
  (let [^int sotype (zero int)]
    (switch net
      (case ["unix"]
        (set! sotype syscall/SOCK_STREAM))
      (case ["unixgram"]
        (set! sotype syscall/SOCK_DGRAM))
      (case ["unixpacket"]
        (set! sotype syscall/SOCK_SEQPACKET))
      (default
        (return nil (conv UnknownNetworkError net))))


    (switch mode
      (case ["dial"]
        (when (and (!= laddr nil) (.isWildcard laddr))
          (set! laddr nil))

        (when (and (!= raddr nil) (.isWildcard raddr))
          (set! raddr nil))

        (when (and (== raddr nil) ^:go/paren (or (!= sotype syscall/SOCK_DGRAM) (== laddr nil)))
          (return nil errMissingAddress)))

      (case ["listen"])
      (default
        (return nil (errors/New (+ "unknown mode: " mode)))))


    (let [(values fd err) (socket ctx net syscall/AF_UNIX sotype 0 false laddr raddr ctxCtrlFn)]
      (when (!= err nil)
        (return nil err))

      (return fd nil))))



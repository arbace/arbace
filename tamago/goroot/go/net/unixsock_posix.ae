^{:go/end 141} (go/method writeTo [^{:tag (* UnixConn)} c ^{:tag (slice byte)} b ^{:tag (* UnixAddr)} addr] :results [int error]
  (when (.-isConnected ^{:go/via [conn]} (.-fd c))

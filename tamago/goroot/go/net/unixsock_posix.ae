^{:go/end 155} (go/method writeMsg [^{:tag (* UnixConn)} c ^{:tag (slice byte)} b ^{:tag (slice byte)} oob ^{:tag (* UnixAddr)} addr] :results [^int n ^int oobn ^error err]
  (when (and (== (.-sotype ^{:go/via [conn]} (.-fd c)) syscall/SOCK_DGRAM) (.-isConnected ^{:go/via [conn]} (.-fd c)))
    (return 0 0 ErrWriteToConnected))


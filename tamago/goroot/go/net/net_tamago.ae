^{:go/end 81} (go/func socket "socket returns a network file descriptor that uses SocketFunc, if set, as\nunderlying implementation.\n" [^context/Context ctx ^string net ^int family ^int sotype ^int proto ^bool _ ^sockaddr laddr ^sockaddr raddr ^{:tag (func [context/Context string string syscall/RawConn] [error])} ctrlCtxFn] :results [^{:tag (* netFD)} fd ^error err]
  (set! fd (addr (lit netFD :family family :sotype sotype :net net :laddr laddr :raddr raddr)))

  (when (and (!= laddr nil) (== raddr nil))
    (set! (.-listener fd) true))


  (when (and (!= laddr nil) (== (.String laddr) "<nil>"))
    (set! (.-laddr fd) (addr (lit TCPAddr)))
    (set! laddr nil))


  (when (and (!= raddr nil) (== (.String raddr) "<nil>"))
    (set! (.-raddr fd) (addr (lit TCPAddr)))
    (set! raddr nil))


  (when (== SocketFunc nil)
    (return nil (errors/New "net.SocketFunc is nil")))


  (when [(set! (values (.-c fd) err) (SocketFunc ctx net family sotype laddr raddr))] (!= err nil)
    (return))


  (type-switch (.-c fd)
    (case [Listener PacketConn Conn])
    (default
      (return nil syscall/EINVAL)))


  (return))



^{:go/end 114} (go/method accept [^{:tag (* netFD)} fd] :results [^{:tag (* netFD)} f ^error err]
  (set! f (addr (lit netFD :family (.-family fd) :sotype (.-sotype fd) :net (.-net fd))))

  (when [(set! (values (.-c f) err) (.Accept (assert Listener (.-c fd))))] (!= err nil)
    (return nil err))


  (set! (.-laddr f) (.LocalAddr (assert Conn (.-c f))))
  (set! (.-raddr f) (.RemoteAddr (assert Conn (.-c f))))

  (return))



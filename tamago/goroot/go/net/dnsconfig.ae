(in-ns 'go.net) (go/file "dnsconfig.go" :imports [


    ^{:line 8} [os "os"]
    ^{:line 9} [atomic "sync/atomic"]
    ^{:line 10} [time "time"]
    ^{:line 11} [_ "unsafe"]])














(go/var ^{:doc "defaultNS is the default name servers to use in the absence of DNS configuration.\n\ndefaultNS should be an internal detail,\nbut widely used packages access it using linkname.\nNotable members of the hall of shame include:\n  - github.com/pojntfx/hydrapp/hydrapp\n  - github.com/mtibben/androiddnsfix\n\nDo not remove or change the type signature.\nSee go.dev/issue/67401.\n" :go/linkname "defaultNS"} defaultNS (lit (slice string) "127.0.0.1:53" "[::1]:53"))



^{:go/end 32} (go/method isDefaultNS "isDefaultNS reports whether the c.servers field is set to [defaultNS], meaning that\nno nameservers were specified in /etc/resolv.conf, thus the default ones are used.\n" ^bool [^{:tag (* dnsConfig)} c]
  (and (== (len (.-servers c)) (len defaultNS)) (== (addr (aget (.-servers c) 0)) (addr (aget defaultNS 0)))))


(go/var getHostname os/Hostname) ; variable for testing

(go/type dnsConfig (struct
    ^{:line 37 :tag (slice string)} servers ; server addresses (in host:port form) to use
    ^{:line 38 :tag (slice string)} search ; rooted suffixes to append to local name
    ^{:line 39 :tag int} ndots ; number of dots in name to trigger absolute lookup
    ^{:line 40 :tag time/Duration} timeout ; wait before giving up on a query, including retries
    ^{:line 41 :tag int} attempts ; lost packets before giving up on server
    ^{:line 42 :tag bool} rotate ; round robin among servers
    ^{:line 43 :tag bool} unknownOpt ; anything unknown was encountered
    ^{:line 44 :tag (slice string)} lookup ; OpenBSD top-level database "lookup" order
    ^{:line 45 :tag error} err ; any error that occurs during open of resolv.conf
    ^{:line 46 :tag time/Time} mtime ; time of resolv.conf modification
    ^{:line 47 :tag uint32} soffset ; used by serverOffset
    ^{:line 48 :tag bool} singleRequest ; use sequential A and AAAA queries instead of parallel queries
    ^{:line 49 :tag bool} useTCP ; force usage of TCP for DNS resolutions
    ^{:line 50 :tag bool} trustAD ; add AD flag to queries
    ^{:line 51 :tag bool} noReload)) ; do not check for config file updates






^{:go/breaks [[5 62]] :go/end 63} (go/method serverOffset "serverOffset returns an offset that can be used to determine\nindices of servers in c.servers when making queries.\nWhen the rotate option is enabled, this offset increases.\nOtherwise it is always 0.\n" ^uint32 [^{:tag (* dnsConfig)} c]
  (when (.-rotate c)
    (return (- (atomic/AddUint32 (addr (.-soffset c)) 1) 1))) ; return 0 to start

  0)

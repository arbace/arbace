(ns go.net.mail
  (:require [arbace.go :as go]))

(go/package mail
  :path "net/mail"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["message.go"]
  :init-order [debug dateLayouts ErrHeaderNotPresent rfc2047Decoder]
  :positions :lines)

(load "mail/message")

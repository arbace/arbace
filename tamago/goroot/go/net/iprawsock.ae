^{:go/end 194} (go/method WriteTo "WriteTo implements the [PacketConn] WriteTo method.\n" [^{:tag (* IPConn)} c ^{:tag (slice byte)} b ^Addr addr] :results [int error]
  (when (not ^{:go/via [conn]} (.ok c))
    (return 0 syscall/EINVAL))

  (let [(values a ok) (assert (* IPAddr) addr)]
    (when (not ok)
      (return 0 (addr (lit OpError :Op "write" :Net (.-net ^{:go/via [conn]} (.-fd c)) :Source (.-laddr ^{:go/via [conn]} (.-fd c)) :Addr addr :Err syscall/EINVAL))))

    (let [(values n err) (.writeTo c b a)]
      (when (!= err nil)
        (set! err (addr (lit OpError :Op "write" :Net (.-net ^{:go/via [conn]} (.-fd c)) :Source (.-laddr ^{:go/via [conn]} (.-fd c)) :Addr (.opAddr a) :Err err))))

      (return n err))))








^{:go/end 211} (go/method WriteMsgIP "WriteMsgIP writes a message to addr via c, copying the payload from\nb and the associated out-of-band data from oob. It returns the\nnumber of payload and out-of-band bytes written.\n\nThe packages golang.org/x/net/ipv4 and golang.org/x/net/ipv6 can be\nused to manipulate IP-level socket options in oob.\n" [^{:tag (* IPConn)} c ^{:tag (slice byte)} b ^{:tag (slice byte)} oob ^{:tag (* IPAddr)} addr] :results [^int n ^int oobn ^error err]

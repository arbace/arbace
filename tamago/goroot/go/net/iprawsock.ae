^{:go/end 106} (go/func ResolveIPAddr "ResolveIPAddr returns an address of IP end point.\n\nThe network must be an IP network name.\n\nIf the host in the address parameter is not a literal IP address,\nResolveIPAddr resolves the address to an address of IP end point.\nOtherwise, it parses the address as a literal IP address.\nThe address parameter can use a host name, but this is not\nrecommended, because it will return at most one of the host name's\nIP addresses.\n\nSee func [Dial] for a description of the network and address\nparameters.\n" [^string network ^string address] :results [(* IPAddr) error]
  (when (== network "") ; a hint wildcard for Go 1.0 undocumented behavior
    (set! network "ip"))

  (let [(values afnet _ err) (parseNetwork (context/Background) network false)]
    (when (!= err nil)
      (return nil err))

    (switch afnet
      (case ["ip" "ip4" "ip6"])
      (default
        (return nil (conv UnknownNetworkError network))))

    (let [(values addrs ^:assign err) (.internetAddrList DefaultResolver (context/Background) afnet address)]
      (when (!= err nil)
        (return nil err))

      (return (assert (* IPAddr) (.forResolve addrs network address)) nil))))





  (set! (values n oobn err) (.writeMsg c b oob addr))
  (when (!= err nil)
    (set! err (addr (lit OpError :Op "write" :Net (.-net ^{:go/via [conn]} (.-fd c)) :Source (.-laddr ^{:go/via [conn]} (.-fd c)) :Addr (.opAddr addr) :Err err))))

  (return))



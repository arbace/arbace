(go/type nssCriterion "nssCriterion is the parsed structure of one of the criteria in brackets\nafter an NSS source name.\n" (struct
    ^{:line 121 :tag bool} negate ; if "!" was present
    ^{:line 122 :tag string} status ; e.g. "success", "unavail" (lowercase)
    ^{:line 123 :tag string} action)) ; e.g. "return", "continue" (lowercase)





^{:go/end 147} (go/method standardStatusAction "standardStatusAction reports whether c is equivalent to not\nspecifying the criterion at all. last is whether this criteria is the\nlast in the list.\n" ^bool [^nssCriterion c ^bool last]
  (when (.-negate c)
    (return false))

  (let [^string def (zero string)]
    (switch (.-status c)
      (case ["success"]
        (set! def "return"))
      (case ["notfound" "unavail" "tryagain"]
        (set! def "continue"))
      (default
        ;; Unknown status
        (return false)))

    (when (and last (== (.-action c) "return"))

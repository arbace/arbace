^{:go/end 219} (go/func parseNSSConf ^{:tag (* nssConf)} [^{:tag (* file)} f]
  (let [conf (new nssConf)]
    (for [(values line ok) (.readLine f)] ok (set! (values line ok) (.readLine f))
      (set! line (trimSpace (removeComment line)))
      (when (== (len line) 0)
        (continue))

      (let [colon (bytealg/IndexByteString line \:)]
        (when (== colon -1)
          (set! (.-err conf) (errors/New "no colon on line"))
          (return conf))

        (let [db (trimSpace (subslice line _ colon))
            ^{:line 178} srcs (subslice line (+ colon 1))]
          (while true
            (set! srcs (trimSpace srcs))
            (when (== (len srcs) 0)
              (break))

            (let [sp (bytealg/IndexByteString srcs \space)
                ^{:line 185 :tag string} src (zero string)]
              (if (== sp -1) (do
                  (set! src srcs)
                  (set! srcs "")) ; done
                (do
                  (set! src (subslice srcs _ sp))
                  (set! srcs (trimSpace (subslice srcs (+ sp 1))))))

              (let [^{:tag (slice nssCriterion)} criteria (zero (slice nssCriterion))]
                ;; See if there's a criteria block in brackets.
                (when (and (> (len srcs) 0) (== (aget srcs 0) \[))
                  (let [bclose (bytealg/IndexByteString srcs \])]
                    (when (== bclose -1)
                      (set! (.-err conf) (errors/New "unclosed criterion bracket"))
                      (return conf))

                    (let [^error err (zero error)]
                      (set! (values criteria err) (parseCriteria (subslice srcs 1 bclose)))
                      (when (!= err nil)
                        (set! (.-err conf) (errors/New (+ "invalid criteria: " (subslice srcs 1 bclose))))
                        (return conf))

                      (set! srcs (subslice srcs (+ bclose 1))))))

                (when (== (.-sources conf) nil)

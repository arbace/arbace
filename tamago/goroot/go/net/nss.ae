^{:go/end 39} (go/func getSystemNSS ^{:tag (* nssConf)} []
  (.tryUpdate nssConfig)
  (.Lock (.-mu nssConfig))
  (let [conf (.-nssConf nssConfig)]
    (.Unlock (.-mu nssConfig))

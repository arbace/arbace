^{:go/end 76} (go/method tryUpdate "tryUpdate tries to update conf.\n" [^{:tag (* nsswitchConfig)} conf]
  (.Do (.-initOnce conf) (.-init conf))

  ;; Ensure only one update at a time checks nsswitch.conf
  (when (not (.tryAcquireSema conf))
    (return))

  (defer (.releaseSema conf))

  (let [now (time/Now)]
    (when (.After (.-lastChecked conf) (.Add now (* -5 time/Second)))
      (return))

    (set! (.-lastChecked conf) now)

    (let [^time/Time mtime (zero time/Time)]
      (when [(values fi err) (os/Stat nssConfigPath)] (== err nil)
        (set! mtime (.ModTime fi)))

      (when (.Equal mtime (.-mtime (.-nssConf conf)))
        (return))


      (let [nssConf (parseNSSConfFile nssConfigPath)]
        (.Lock (.-mu conf))
        (set! (.-nssConf conf) nssConf)
        (.Unlock (.-mu conf))))))


^{:go/end 80} (go/method acquireSema [^{:tag (* nsswitchConfig)} conf]
  (>! (.-ch conf) (lit (struct))))


^{:go/end 89} (go/method tryAcquireSema ^bool [^{:tag (* nsswitchConfig)} conf]

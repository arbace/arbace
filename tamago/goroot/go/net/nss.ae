                (aset (.-sources conf) db (append (aget (.-sources conf) db) ^{:go/breaks [2 4]} (lit nssSource
                      :source src
                      :criteria criteria)))))))))



    ^{:line 218} conf))



^{:go/end 249} (go/func parseCriteria "parses \"foo=bar !foo=bar\"\n" [^string x] :results [^{:tag (slice nssCriterion)} c ^error err]
  (set! err (foreachField x ^{:go/end 247} (fn ^error [^string f]
        (let [not false]
          (when (and (> (len f) 0) (== (aget f 0) \!))

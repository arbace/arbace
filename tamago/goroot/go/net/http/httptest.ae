(ns go.net.http.httptest
  (:require [arbace.go :as go]))

(go/package httptest
  :path "net/http/httptest"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["httptest.go" "recorder.go" "server.go"]
  :init-order []
  :positions :lines)

(load "httptest/httptest")
(load "httptest/recorder")
(load "httptest/server")

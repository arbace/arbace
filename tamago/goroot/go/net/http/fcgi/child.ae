^{:go/end 71} (go/method parseParams "parseParams reads an encoded []byte into Params.\n" [^{:tag (* request)} r]
  (let [text (.-rawParams r)]
    (set! (.-rawParams r) nil)
    (while (> (len text) 0)
      (let [(values keyLen n) (readSize text)]
        (when (== n 0)
          (return))

        (set! text (subslice text n))
        (let [(values valLen ^:assign n) (readSize text)]
          (when (== n 0)
            (return))

          (set! text (subslice text n))
          (when (> (+ (conv int keyLen) (conv int valLen)) (len text))
            (return))

          (let [key (readString text keyLen)]
            (set! text (subslice text keyLen))
            (let [val (readString text valLen)]
              (set! text (subslice text valLen))
              (aset (.-params r) key val))))))))





^{:go/end 276} (go/method handleRecord ^error [^{:tag (* child)} c ^{:tag (* record)} rec]
  (let [(values req ok) (aget (.-requests c) (.-Id (.-h rec)))]
    (when (and (not ok) (!= (.-Type (.-h rec)) typeBeginRequest) (!= (.-Type (.-h rec)) typeGetValues))
      ;; The spec says to ignore unknown request IDs.
      (return nil))


    (switch (.-Type (.-h rec))
      (case [typeBeginRequest]
        (when (!= req nil)
          ;; The server is trying to begin a request with the same ID
          ;; as an in-progress request. This is an error.
          (return (errors/New "fcgi: received ID that is already in-flight")))


        (let [^beginRequest br (zero beginRequest)]
          (when [err (.read br (.content rec))] (!= err nil)
            (return err))

          (when (!= (.-role br) roleResponder)
            (.writeEndRequest (.-conn c) (.-Id (.-h rec)) 0 statusUnknownRole)
            (return nil))

          (set! req (newRequest (.-Id (.-h rec)) (.-flags br)))
          (aset (.-requests c) (.-Id (.-h rec)) req)
          (return nil)))
      (case [typeParams]
        ;; NOTE(eds): Technically a key-value pair can straddle the boundary
        ;; between two packets. We buffer until we've received all parameters.
        (when (> (len (.content rec)) 0)
          (set! (.-rawParams req) (append (.-rawParams req) (spread (.content rec))))
          (return nil))

        (.parseParams req)
        (return nil))
      (case [typeStdin]
        (let [content (.content rec)]
          (when (== (.-pw req) nil)
            (let [^io/ReadCloser body (zero io/ReadCloser)]
              (if (> (len content) 0)

                ;; as long as both sides are behaving.
                (set! (values body (.-pw req)) (io/Pipe))

                (set! body emptyBody))

              (go (.serveRequest c req body))))

          (if (> (len content) 0)
            ;; TODO(eds): This blocks until the handler reads from the pipe.
            ;; If the handler takes a long time, it might be a problem.
            (.Write (.-pw req) content)
            (do
              (delete (.-requests c) (.-reqId req))
              (when (!= (.-pw req) nil)
                (.Close (.-pw req)))))


          (return nil)))
      (case [typeGetValues]
        (let [values (lit (map string string) ["FCGI_MPXS_CONNS" "1"])]
          (.writePairs (.-conn c) typeGetValuesResult 0 values)
          (return nil)))
      (case [typeData]
        ;; If the filter role is implemented, read the data stream here.
        (return nil))
      (case [typeAbortRequest]
        (delete (.-requests c) (.-Id (.-h rec)))
        (.writeEndRequest (.-conn c) (.-Id (.-h rec)) 0 statusRequestComplete)

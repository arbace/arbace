^{:go/end 322} (go/method serveRequest [^{:tag (* child)} c ^{:tag (* request)} req ^io/ReadCloser body]
  (let [r (newResponse c req)
      (values httpReq err) (cgi/RequestFromMap (.-params req))]
    (if (!= err nil) (do
        ;; there was an error reading the request
        (.WriteHeader r http/StatusInternalServerError)
        (.writeRecord (.-conn c) typeStderr (.-reqId req) (conv (slice byte) (.Error err))))
      (do
        (set! (.-Body httpReq) body)
        (let [withoutUsedEnvVars (filterOutUsedEnvVars (.-params req))
            ^{:line 300} envVarCtx (context/WithValue (.Context httpReq) (lit envVarsContextKey) withoutUsedEnvVars)]
          (set! httpReq (.WithContext httpReq envVarCtx))
          (.ServeHTTP (.-handler c) r httpReq))))

    ;; Make sure we serve something even if nothing was written to r
    (.Write r nil)
    (.Close r)
    (.writeEndRequest (.-conn c) (.-reqId req) 0 statusRequestComplete)

    ;; Consume the entire body, so the host isn't still writing to
    ;; us when we close the socket below in the !keepConn case,
    ;; otherwise we'd send a RST. (golang.org/issue/4183)
    ;; TODO(bradfitz): also bound this copy in time. Or send
    ;; some sort of abort request to the host, so the host
    ;; can properly cut off the client sending all the data.
    ;; For now just bound it a little and
    (io/CopyN io/Discard body (<< 100 20))
    (.Close body)

    (when (not (.-keepConn req))
      (.Close (.-conn c)))))




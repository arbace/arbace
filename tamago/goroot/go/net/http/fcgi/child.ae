^{:go/end 359} (go/func Serve "Serve accepts incoming FastCGI connections on the listener l, creating a new\ngoroutine for each. The goroutine reads requests and then calls handler\nto reply to them.\nIf l is nil, Serve accepts connections from os.Stdin.\nIf handler is nil, [http.DefaultServeMux] is used.\n" ^error [^net/Listener l ^http/Handler handler]
  (when (== l nil)
    (let [^error err (zero error)]
      (set! (values l err) (net/FileListener os/Stdin))
      (when (!= err nil)
        (return err))

      (defer (.Close l))))

  (when (== handler nil)
    (set! handler http/DefaultServeMux))

  (while true
    (let [(values rw err) (.Accept l)]
      (when (!= err nil)
        (return err))

      (let [c (newChild rw handler)]
        (go (.serve c))))))








^{:go/end 369} (go/func ProcessEnv "ProcessEnv returns FastCGI environment variables associated with the request r\nfor which no effort was made to be included in the request itself - the data\nis hidden in the request's context. As an example, if REMOTE_USER is set for a\nrequest, it will not be found anywhere in r, but it will be included in\nProcessEnv's response (via r's context).\n" ^{:tag (map string string)} [^{:tag (* http/Request)} r]
  (let [(values env _) (assert (map string string) (.Value (.Context r) (lit envVarsContextKey)))]
    ^{:line 368} env))




^{:go/breaks [[7 394]] :go/end 395} (go/func addFastCGIEnvToContext "addFastCGIEnvToContext reports whether to include the FastCGI environment variable s\nin the http.Request.Context, accessible via ProcessEnv.\n" ^bool [^string s]
  ;; Exclude things supported by net/http natively:
  (switch s
    (case ^{:go/breaks [3 6 9]} ["CONTENT_LENGTH" "CONTENT_TYPE" "HTTPS"
        "PATH_INFO" "QUERY_STRING" "REMOTE_ADDR"
        "REMOTE_HOST" "REMOTE_PORT" "REQUEST_METHOD"
        "REQUEST_URI" "SCRIPT_NAME" "SERVER_PROTOCOL"]
      (return false)))

  (when (strings/HasPrefix s "HTTP_")
    (return false))

  ;; Explicitly include FastCGI-specific things.
  ;; This list is redundant with the default "return true" below.
  ;; Consider this documentation of the sorts of things we expect
  ;; to maybe see.
  (switch s
    (case ["REMOTE_USER"]
      (return true)))

  ;; Unknown, so include it to be safe.
  true)

(ns go.net.http.internal
  (:require [arbace.go :as go]))

(go/package internal
  :path "net/http/internal"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["chunked.go" "common.go" "sniff.go"]
  :init-order [ErrLineTooLong semi ErrAbortHandler ErrBodyNotAllowed ErrRequestCanceled ErrSkipAltProtocol sniffSignatures mp4ftype mp4]
  :positions :lines)

(load "internal/chunked")
(load "internal/common")
(load "internal/sniff")

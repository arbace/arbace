      (return (combineRelationships rel moreGeneral)))

    (when (and (< (len segs2) (len segs1)) (.-multi (.lastSegment p2)))
      (return (combineRelationships rel moreSpecific)))

    ^{:line 314} disjoint))



^{:go/end 349} (go/func compareSegments "compareSegments determines the relationship between two segments.\n" ^relationship [^segment s1 ^segment s2]
  (when (and (.-multi s1) (.-multi s2))
    (return equivalent))

  (when (.-multi s1)
    (return moreGeneral))

  (when (.-multi s2)
    (return moreSpecific))

  (when (and (.-wild s1) (.-wild s2))
    (return equivalent))

  (when (.-wild s1)
    (when (== (.-s s2) "/")
      ;; A single wildcard doesn't match a trailing slash.
      (return disjoint))

    (return moreGeneral))

  (when (.-wild s2)
    (when (== (.-s s1) "/")
      (return disjoint))

    (return moreSpecific))

  ;; Both literals.
  (when (== (.-s s1) (.-s s2))
    (return equivalent))

  ^{:line 348} disjoint)










^{:go/end 382} (go/func combineRelationships "combineRelationships determines the overall relationship of two patterns\ngiven the relationships of a partition of the patterns into two parts.\n\nFor example, if p1 is more general than p2 in one way but equivalent\nin the other, then it is more general overall.\n\nOr if p1 is more general in one way and more specific in the other, then\nthey overlap.\n" ^relationship [^relationship r1 ^relationship r2]
  (switch r1
    (case [equivalent]
      (return r2))
    (case [disjoint]
      (return disjoint))
    (case [overlaps]
      (when (== r2 disjoint)
        (return disjoint))

      (return overlaps))
    (case [moreGeneral moreSpecific]
      (switch r2
        (case [equivalent]
          (return r1))
        (case [(inverseRelationship r1)]
          (return overlaps))
        (default
          (return r2))))

    (default
      (panic (fmt/Sprintf "unknown relationship %q" r1)))))





^{:go/end 395} (go/func inverseRelationship "If p1 has relationship `r` to p2, then\np2 has inverseRelationship(r) to p1.\n" ^relationship [^relationship r]
  (switch r
    (case [moreSpecific]
      (return moreGeneral))
    (case [moreGeneral]
      (return moreSpecific))
    (default
      (return r))))




^{:go/end 422} (go/func describeConflict "describeConflict returns an explanation of why two patterns conflict.\n" ^string [^{:tag (* pattern)} p1 ^{:tag (* pattern)} p2]
  (let [mrel (.compareMethods p1 p2)
      ^{:line 400} prel (.comparePaths p1 p2)
      ^{:line 401} rel (combineRelationships mrel prel)]
    (when (== rel equivalent)
      (return (fmt/Sprintf "%s matches the same requests as %s" p1 p2)))

    (when (!= rel overlaps)
      (panic "describeConflict called with non-conflicting patterns"))

    (when (== prel overlaps)
      (return (fmt/Sprintf "%[1]s and %[2]s both match some paths, like %[3]q.\nBut neither is more specific than the other.\n%[1]s matches %[4]q, but %[2]s doesn't.\n%[2]s matches %[5]q, but %[1]s doesn't."



          ^{:line 413} p1 p2 (commonPath p1 p2) (differencePath p1 p2) (differencePath p2 p1))))

    (when (and (== mrel moreGeneral) (== prel moreSpecific))
      (return (fmt/Sprintf "%s matches more methods than %s, but has a more specific path pattern" p1 p2)))

    (when (and (== mrel moreSpecific) (== prel moreGeneral))
      (return (fmt/Sprintf "%s matches fewer methods than %s, but has a more general path pattern" p1 p2)))

    (fmt/Sprintf "bug: unexpected way for two patterns %s and %s to conflict: methods %s, paths %s" p1 p2 mrel prel)))



^{:go/end 429} (go/func writeMatchingPath "writeMatchingPath writes to b a path that matches the segments.\n" [^{:tag (* strings/Builder)} b ^{:tag (slice segment)} segs]

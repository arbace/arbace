(go/type relationship "relationship is a relationship between two patterns, p1 and p2.\n" string)

(go/const
  ^{:line 212} [^{:tag relationship :val "equivalent"} equivalent "equivalent"] ; both match the same requests
  ^{:line 213} [^{:tag relationship :val "moreGeneral"} moreGeneral "moreGeneral"] ; p1 matches everything p2 does & more
  ^{:line 214} [^{:tag relationship :val "moreSpecific"} moreSpecific "moreSpecific"] ; p2 matches everything p1 does & more
  ^{:line 215} [^{:tag relationship :val "disjoint"} disjoint "disjoint"] ; there is no request that both match
  ^{:line 216} [^{:tag relationship :val "overlaps"} overlaps "overlaps"]) ; there is a request that both match, but neither is more specific















^{:go/end 241} (go/method conflictsWith "conflictsWith reports whether p1 conflicts with p2, that is, whether\nthere is a request that both match but where neither is higher precedence\nthan the other.\n\n\tPrecedence is defined by two rules:\n\t1. Patterns with a host win over patterns without a host.\n\t2. Patterns whose method and path is more specific win. One pattern is more\n\t   specific than another if the second matches all the (method, path) pairs\n\t   of the first and more.\n\nIf rule 1 doesn't apply, then two patterns conflict if their relationship\nis either equivalence (they match the same set of requests) or overlap\n(they both match some requests, but neither is more specific than the other).\n" ^bool [^{:tag (* pattern)} p1 ^{:tag (* pattern)} p2]
  (when (!= (.-host p1) (.-host p2))
    ;; Either one host is empty and the other isn't, in which case the
    ;; one with the host wins by rule 1, or neither host is empty
    ;; and they differ, so they won't match the same paths.
    (return false))

  (let [rel (.comparePathsAndMethods p1 p2)]
    (or (== rel equivalent) (== rel overlaps))))


^{:go/end 251} (go/method comparePathsAndMethods ^relationship [^{:tag (* pattern)} p1 ^{:tag (* pattern)} p2]
  (let [mrel (.compareMethods p1 p2)]
    ;; Optimization: avoid a call to comparePaths.
    (when (== mrel disjoint)
      (return disjoint))

    (let [prel (.comparePaths p1 p2)]
      (combineRelationships mrel prel))))









^{:go/end 279} (go/method compareMethods "compareMethods determines the relationship between the method\npart of patterns p1 and p2.\n\nA method can either be empty, \"GET\", or something else.\nThe empty string matches any method, so it is the most general.\n\"GET\" matches both GET and HEAD.\nAnything else matches only itself.\n" ^relationship [^{:tag (* pattern)} p1 ^{:tag (* pattern)} p2]
  (when (== (.-method p1) (.-method p2))
    (return equivalent))

  (when (== (.-method p1) "")
    ;; p1 matches any method, but p2 does not, so p1 is more general.
    (return moreGeneral))

  (when (== (.-method p2) "")
    (return moreSpecific))

  (when (and (== (.-method p1) "GET") (== (.-method p2) "HEAD"))
    ;; p1 matches GET and HEAD; p2 matches only HEAD.
    (return moreGeneral))

  (when (and (== (.-method p2) "GET") (== (.-method p1) "HEAD"))
    (return moreSpecific))

  ^{:line 278} disjoint)




^{:go/end 315} (go/method comparePaths "comparePaths determines the relationship between the path\npart of two patterns.\n" ^relationship [^{:tag (* pattern)} p1 ^{:tag (* pattern)} p2]
  ;; Optimization: if a path pattern doesn't end in a multi ("...") wildcard, then it
  ;; can only match paths with the same number of segments.
  (when (and (!= (len (.-segments p1)) (len (.-segments p2))) (not (.-multi (.lastSegment p1))) (not (.-multi (.lastSegment p2))))
    (return disjoint))


  ;; Consider corresponding segments in the two path patterns.
  (let [(values ^{:tag (slice segment)} segs1 ^{:tag (slice segment)} segs2) (zero (slice segment))
      ^{:line 292} rel equivalent]
    (for [(set! (values segs1 segs2) (values (.-segments p1) (.-segments p2)))] (and (> (len segs1) 0) (> (len segs2) 0)) (set! (values segs1 segs2) (values (subslice segs1 1) (subslice segs2 1)))
      (set! rel (combineRelationships rel (compareSegments (aget segs1 0) (aget segs2 0))))
      (when (== rel disjoint)
        (return rel)))


    ;; We've reached the end of the corresponding segments of the patterns.
    ;; If they have the same number of segments, then we've already determined
    ;; their relationship.
    (when (and (== (len segs1) 0) (== (len segs2) 0))
      (return rel))

    ;; Otherwise, the only way they could fail to be disjoint is if the shorter
    ;; pattern ends in a multi. In that case, that multi is more general
    ;; than the remainder of the longer pattern, so combine those two relationships.

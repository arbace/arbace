(go/type segment "A segment is a pattern piece that matches one or more path segments, or\na trailing slash.\n\nIf wild is false, it matches a literal segment, or, if s == \"/\", a trailing slash.\nExamples:\n\n\t\"a\" => segment{s: \"a\"}\n\t\"/{$}\" => segment{s: \"/\"}\n\nIf wild is true and multi is false, it matches a single path segment.\nExample:\n\n\t\"{x}\" => segment{s: \"x\", wild: true}\n\nIf both wild and multi are true, it matches all remaining path segments.\nExample:\n\n\t\"{rest...}\" => segment{s: \"rest\", wild: true, multi: true}\n" (struct
    ^{:line 62 :tag string} s ; literal or wildcard name or "/" for "/{$}".
    ^{:line 63 :tag bool} wild
    ^{:line 64 :tag bool} multi)) ; "..." wildcard



















^{:go/end 184} (go/func parsePattern "parsePattern parses a string into a Pattern.\nThe string's syntax is\n\n\t[METHOD] [HOST]/[PATH]\n\nwhere:\n  - METHOD is an HTTP method\n  - HOST is a hostname\n  - PATH consists of slash-separated segments, where each segment is either\n    a literal or a wildcard of the form \"{name}\", \"{name...}\", or \"{$}\".\n\nMETHOD, HOST and PATH are all optional; that is, the string can be \"/\".\nIf METHOD is present, it must be followed by at least one space or tab.\nWildcard names must be valid Go identifiers.\nThe \"{$}\" and \"{name...}\" wildcard must occur at the end of PATH.\nPATH may end with a '/'.\nWildcard names in a path must be distinct.\n" [^string s] :results [^{:tag (* pattern)} _ ^error err]
  (when (== (len s) 0)
    (return nil (errors/New "empty pattern")))

  (let [off 0] ; offset into string
    (defer (^{:go/end 93} (fn []
          (when (!= err nil)
            (set! err (fmt/Errorf "at offset %d: %w" off err))))))



    (let [(values method rest found) (values s "" false)]
      (when [i (strings/IndexAny s " \t")] (>= i 0)
        (set! (values method rest found) (values (subslice s _ i) (strings/TrimLeft (subslice s (+ i 1)) " \t") true)))

      (when (not found)
        (set! rest method)
        (set! method ""))

      (when (and (!= method "") (not (validMethod method)))
        (return nil (fmt/Errorf "invalid method %q" method)))

      (let [p (addr (lit pattern :str s :method method))]

        (when found
          (set! off (+ (len method) 1)))

        (let [i (strings/IndexByte rest \/)]
          (when (< i 0)
            (return nil (errors/New "host/path missing /")))

          (set! (.-host p) (subslice rest _ i))
          (set! rest (subslice rest i))
          (when [j (strings/IndexByte (.-host p) \{)] (>= j 0)
            (set! off + j)
            (return nil (errors/New "host contains '{' (missing initial '/'?)")))

          ;; At this point, rest is the path.
          (set! off + i)

          ;; An unclean path with a method that is not CONNECT can never match,
          ;; because paths are cleaned before matching.
          (when (and (!= method "") (!= method "CONNECT") (!= rest (cleanPath rest)))
            (return nil (errors/New "non-CONNECT pattern with unclean path can never match")))


          (let [seenNames (lit (map string bool))] ; remember wildcard names to catch dups
            (while (> (len rest) 0)
              ;; Invariant: rest[0] == '/'.
              (set! rest (subslice rest 1))
              (set! off (- (len s) (len rest)))
              (when (== (len rest) 0)
                ;; Trailing slash.
                (set! (.-segments p) (append (.-segments p) (lit segment :wild true :multi true)))
                (break))

              (let [i (strings/IndexByte rest \/)]
                (when (< i 0)
                  (set! i (len rest)))

                (let [^string seg (zero string)]
                  (set! (values seg rest) (values (subslice rest _ i) (subslice rest i)))
                  (if [i (strings/IndexByte seg \{)] (< i 0) (do
                      ;; Literal.
                      (set! seg (pathUnescape seg))
                      (set! (.-segments p) (append (.-segments p) (lit segment :s seg))))
                    (do
                      ;; Wildcard.
                      (when (!= i 0)
                        (return nil (errors/New "bad wildcard segment (must start with '{')")))

                      (when (!= (aget seg (- (len seg) 1)) \})
                        (return nil (errors/New "bad wildcard segment (must end with '}')")))

                      (let [name (subslice seg 1 (- (len seg) 1))]
                        (when (== name "$")
                          (when (!= (len rest) 0)
                            (return nil (errors/New "{$} not at end")))

                          (set! (.-segments p) (append (.-segments p) (lit segment :s "/")))
                          (break))

                        (let [(values ^:assign name multi) (strings/CutSuffix name "...")]
                          (when (and multi (!= (len rest) 0))
                            (return nil (errors/New "{...} wildcard not at end")))

                          (when (== name "")
                            (return nil (errors/New "empty wildcard")))

                          (when (not (isValidWildcardName name))
                            (return nil (fmt/Errorf "bad wildcard name %q" name)))

                          (when (aget seenNames name)
                            (return nil (fmt/Errorf "duplicate wildcard name %q" name)))

                          (aset seenNames name true)
                          (set! (.-segments p) (append (.-segments p) (lit segment :s name :wild true :multi multi))))))))))


            (return p nil)))))))


^{:go/breaks [[5 196]] :go/end 197} (go/func isValidWildcardName ^bool [^string s]
  (when (== s "")
    (return false))

  ;; Valid Go identifier.
  (range [i c s]
    (when (and (not (unicode/IsLetter c)) (!= c \_) ^:go/paren (or (== i 0) (not (unicode/IsDigit c))))
      (return false)))


  true)


^{:go/end 206} (go/func pathUnescape ^string [^string path]
  (let [(values u err) (url/PathUnescape path)]
    (when (!= err nil)
      ;; Invalidly escaped path; use the original
      (return path))


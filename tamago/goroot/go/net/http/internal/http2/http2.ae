^{:go/end 341} (go/func writeWithByteTimeout "writeWithByteTimeout writes to conn.\nIf more than timeout passes without any bytes being written to the connection,\nthe write fails.\n" [^net/Conn conn ^time/Duration timeout ^{:tag (slice byte)} p] :results [^int n ^error err]

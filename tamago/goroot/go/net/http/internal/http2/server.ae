^{:go/end 3221} (go/method countError ^error [^{:tag (* serverConn)} sc ^string name ^error err]
  (when (or (== sc nil) (== (.-srv sc) nil))
    (return err))

  (let [f (.-countErrorFunc sc)]
    (when (== f nil)
      (return err))

    (let [^string typ (zero string)
        ^{:line 3204 :tag ErrCode} code (zero ErrCode)]
      (type-switch [e err]
        (case [ConnectionError]
          (set! typ "conn")
          (set! code (conv ErrCode e)))
        (case [StreamError]
          (set! typ "stream")
          (set! code (conv ErrCode (.-Code e))))
        (default
          (return err)))

      (let [codeStr (aget errCodeName code)]
        (when (== codeStr "")
          (set! codeStr (strconv/Itoa (conv int code))))

        (f (fmt/Sprintf "%s_%s_%s" typ codeStr name))
        ^{:line 3220} err))))

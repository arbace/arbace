^{:go/end 405} (go/func authorityAddr "authorityAddr returns a given authority (a host/IP, or host:port / ip:port)\nand returns a host:port. The port 443 is added if needed.\n" [^string scheme ^string authority] :results [^string addr]
  (let [(values host port err) (net/SplitHostPort authority)]
    (when (!= err nil) ; authority didn't have a port
      (set! host authority)
      (set! port ""))

    (when (== port "") ; authority's port was empty
      (set! port "443")
      (when (== scheme "http")
        (set! port "80")))


    (when [(values a err) (idna/ToASCII host)] (== err nil)
      (set! host a))

    ;; IPv6 address literal, without a port:
    (when (and (strings/HasPrefix host "[") (strings/HasSuffix host "]"))
      (return (+ host ":" port)))

    (net/JoinHostPort host port)))




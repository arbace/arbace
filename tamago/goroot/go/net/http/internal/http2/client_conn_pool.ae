  (when [(values call ok) (aget (.-dialing p) addr)] ok
    ;; A dial is already in-flight. Don't start another.
    (return call))

  (let [call (addr (lit dialCall :p p :done (make (chan (struct))) :ctx ctx))]
    (when (== (.-dialing p) nil)
      (set! (.-dialing p) (make (map string (* dialCall)))))

    (aset (.-dialing p) addr call)
    (go (.dial call (.-ctx call) addr))
    ^{:line 111} call))



^{:go/end 127} (go/method dial "run in its own goroutine.\n" [^{:tag (* dialCall)} c ^context/Context ctx ^string addr]
  (let [^:const ^{:val false} singleUse false] ; shared conn
    (set! (values (.-res c) (.-err c)) (.dialClientConn (.-t (.-p c)) ctx addr singleUse))

    (.Lock (.-mu (.-p c)))
    (delete (.-dialing (.-p c)) addr)
    (when (== (.-err c) nil)
      (.addConnLocked (.-p c) addr (.-res c)))

    (.Unlock (.-mu (.-p c)))

    (close (.-done c))))










^{:go/end 164} (go/method addConnIfNeeded "addConnIfNeeded makes a NewClientConn out of c if a connection for key doesn't\nalready exist. It coalesces concurrent calls with the same key.\nThis is used by the http1 Transport code when it creates a new connection. Because\nthe http1 Transport doesn't de-dup TCP dials to outbound hosts (because it doesn't know\nthe protocol), it can get into a situation where it has multiple TLS connections.\nThis code decides which ones live or die.\nThe return value used is whether c was used.\nc is never closed.\n" [^{:tag (* clientConnPool)} p ^string key ^{:tag (* Transport)} t ^net/Conn c] :results [^bool used ^error err]
  (.Lock (.-mu p))
  (range [_ cc (aget (.-conns p) key)]
    (when (.CanTakeNewRequest cc)
      (.Unlock (.-mu p))
      (return false nil)))


  (let [(values call dup) (aget (.-addConnCalls p) key)]
    (when (not dup)
      (when (== (.-addConnCalls p) nil)
        (set! (.-addConnCalls p) (make (map string (* addConnCall)))))

      (set! call (addr ^{:go/breaks [2 4]} (lit addConnCall
            :p p
            :done (make (chan (struct))))))

      (aset (.-addConnCalls p) key call)
      (go (.run call t key c)))

    (.Unlock (.-mu p))

    (<! (.-done call))
    (when (!= (.-err call) nil)
      (return false (.-err call)))

    (return (not dup) nil)))


(go/type addConnCall (struct
    ^{:line 167 :tag incomparable} _
    ^{:line 168 :tag (* clientConnPool)} p

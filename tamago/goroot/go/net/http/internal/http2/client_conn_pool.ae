    ^{:line 170 :tag error} err))


^{:go/end 187} (go/method run [^{:tag (* addConnCall)} c ^{:tag (* Transport)} t ^string key ^net/Conn nc]
  (let [(values cc err) (.newClientConn t nc (.disableKeepAlives t) nil)

      ^{:line 176} p (.-p c)]
    (.Lock (.-mu p))
    (if (!= err nil)
      (set! (.-err c) err)
      (do
        (set! (.-getConnCalled cc) true) ; already called by the net/http package
        (.addConnLocked p key cc)))

    (delete (.-addConnCalls p) key)
    (.Unlock (.-mu p))
    (close (.-done c))))



^{:go/end 202} (go/method addConnLocked "p.mu must be held\n" [^{:tag (* clientConnPool)} p ^string key ^{:tag (* ClientConn)} cc]
  (when (^{:inst [(slice (* ClientConn)) (* ClientConn)]} slices/Contains (aget (.-conns p) key) cc)
    (return))

  (when (== (.-conns p) nil)
    (set! (.-conns p) (make (map string (slice (* ClientConn))))))

  (when (== (.-keys p) nil)
    (set! (.-keys p) (make (map (* ClientConn) (slice string)))))

  (aset (.-conns p) key (append (aget (.-conns p) key) cc))
  (aset (.-keys p) cc (append (aget (.-keys p) cc) key)))


^{:go/end 220} (go/method MarkDead [^{:tag (* clientConnPool)} p ^{:tag (* ClientConn)} cc]
  (.Lock (.-mu p))
  (defer (.Unlock (.-mu p)))
  (range [_ key (aget (.-keys p) cc)]
    (let [(values vv ok) (aget (.-conns p) key)]
      (when (not ok)
        (continue))

      (let [newList (filterOutClientConn vv cc)]
        (if (> (len newList) 0)
          (aset (.-conns p) key newList)

          (delete (.-conns p) key)))))


  (delete (.-keys p) cc))


^{:go/end 236} (go/method closeIdleConnections [^{:tag (* clientConnPool)} p]
  (.Lock (.-mu p))
  (defer (.Unlock (.-mu p)))
  ;; TODO: don't close a cc if it was just added to the pool
  ;; milliseconds ago and has never been used. There's currently
  ;; a small race window with the HTTP/1 Transport's integration
  ;; where it can add an idle conn just before using it, and
  ;; somebody else can concurrently call CloseIdleConns and
  ;; break some caller's RoundTrip.
  (range [_ vv (.-conns p)]
    (range [_ cc vv]
      (.closeIfIdle cc))))




^{:go/end 251} (go/func filterOutClientConn ^{:tag (slice (* ClientConn))} [^{:tag (slice (* ClientConn))} in ^{:tag (* ClientConn)} exclude]
  (let [out (subslice in _ 0)]
    (range [_ v in]
      (when (!= v exclude)
        (set! out (append out v))))


    ;; If we filtered it out, zero out the last item to prevent
    ;; the GC from seeing it.
    (when (!= (len in) (len out))
      (aset in (- (len in) 1) nil))

    ^{:line 250} out))





(go/type noDialClientConnPool "noDialClientConnPool is an implementation of http2.ClientConnPool\nwhich never dials. We let the HTTP/1.1 client dial and use its TLS\nconnection instead.\n" (struct (* clientConnPool)))

^{:go/end 260} (go/method GetClientConn [^noDialClientConnPool p ^{:tag (* ClientRequest)} req ^string addr] :results [(* ClientConn) error]
  ^{:go/via [clientConnPool]} (.getClientConn p req addr noDialOnMiss))






^{:go/end 285} (go/func shouldRetryDial "shouldRetryDial reports whether the current request should\nretry dialing after the call finished unsuccessfully, for example\nif the dial was canceled because of a context cancellation or\ndeadline expiry.\n" ^bool [^{:tag (* dialCall)} call ^{:tag (* ClientRequest)} req]
  (when (== (.-err call) nil)
    ;; No error, no need to retry
    (return false))

  (when (== (.-ctx call) (.-Context req))
    ;; If the call has the same context as the request, the dial
    ;; should not be retried, since any cancellation will have come
    ;; from this request.
    (return false))

  (when (and (not (errors/Is (.-err call) context/Canceled)) (not (errors/Is (.-err call) context/DeadlineExceeded)))
    ;; If the call error is not because of a context cancellation or a deadline expiry,
    ;; the dial should not be retried.
    (return false))

  ;; Only retry if the error is a context cancellation error or deadline expiry
  ;; and the context associated with the call was canceled or expired.
  (!= (.Err (.-ctx call)) nil))

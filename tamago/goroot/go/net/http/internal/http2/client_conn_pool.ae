^{:go/end 85} (go/method getClientConn [^{:tag (* clientConnPool)} p ^{:tag (* ClientRequest)} req ^string addr ^bool dialOnMiss] :results [(* ClientConn) error]
  ;; TODO(dneil): Dial a new connection when t.DisableKeepAlives is set?
  (when (and (isConnectionCloseRequest req) dialOnMiss)
    ;; It gets its own connection.
    (traceGetConn req addr)
    (let [^:const ^{:val true} singleUse true
        (values cc err) (.dialClientConn (.-t p) (.-Context req) addr singleUse)]
      (when (!= err nil)
        (return nil err))

      (return cc nil)))

  (while true
    (.Lock (.-mu p))
    (range [_ cc (aget (.-conns p) addr)]
      (when (.ReserveNewRequest cc)
        ;; When a connection is presented to us by the net/http package,
        ;; the GetConn hook has already been called.
        ;; Don't call it a second time here.
        (when (not (.-getConnCalled cc))
          (traceGetConn req addr))

        (set! (.-getConnCalled cc) false)
        (.Unlock (.-mu p))
        (return cc nil)))


    (when (not dialOnMiss)
      (.Unlock (.-mu p))
      (return nil ErrNoCachedConn))

    (traceGetConn req addr)
    (let [call (.getStartDialLocked p (.-Context req) addr)]
      (.Unlock (.-mu p))
      (<! (.-done call))
      (when (shouldRetryDial call req)
        (continue))

      (let [(values cc err) (values (.-res call) (.-err call))]
        (when (!= err nil)
          (return nil err))

        (when (.ReserveNewRequest cc)
          (return cc nil))))))






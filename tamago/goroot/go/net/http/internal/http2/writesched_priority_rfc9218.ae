^{:go/end 85} (go/method OpenStream [^{:tag (* priorityWriteSchedulerRFC9218)} ws ^uint32 streamID ^OpenStreamOptions opt]
  (when (!= (.-location (aget (.-streams ws) streamID)) nil)
    (panic (fmt/Errorf "stream %d already opened" streamID)))

  (when (== streamID (.-streamID (.-priorityUpdateBuf ws)))
    (set! (.-streamID (.-priorityUpdateBuf ws)) 0)
    (set! (.-priority opt) (.-priority (.-priorityUpdateBuf ws))))

  (let [q (.get (.-queuePool ws))]
    (aset (.-streams ws) streamID ^{:go/breaks [2 4]} (lit streamMetadata
        :location q
        :priority (.-priority opt)))


    (let [(values u i) (values (.-urgency (.-priority opt)) (.-incremental (.-priority opt)))]
      (if (== (aget (aget (.-heads ws) u) i) nil) (do
          (aset (aget (.-heads ws) u) i q)
          (set! (.-next q) q)
          (set! (.-prev q) q))
        (do
          ;; Queues are stored in a ring.
          ;; Insert the new stream before ws.head, putting it at the end of the list.
          (set! (.-prev q) (.-prev (aget (aget (.-heads ws) u) i)))
          (set! (.-next q) (aget (aget (.-heads ws) u) i))
          (set! (.-next (.-prev q)) q)
          (set! (.-prev (.-next q)) q))))))



^{:go/end 105} (go/method CloseStream [^{:tag (* priorityWriteSchedulerRFC9218)} ws ^uint32 streamID]
  (let [metadata (aget (.-streams ws) streamID)
      (values q u i) (values (.-location metadata) (.-urgency (.-priority metadata)) (.-incremental (.-priority metadata)))]
    (when (== q nil)
      (return))

    (if (== (.-next q) q)
      ;; This was the only open stream.
      (aset (aget (.-heads ws) u) i nil)
      (do
        (set! (.-next (.-prev q)) (.-next q))
        (set! (.-prev (.-next q)) (.-prev q))
        (when (== (aget (aget (.-heads ws) u) i) q)
          (aset (aget (.-heads ws) u) i (.-next q)))))


    (delete (.-streams ws) streamID)
    (.put (.-queuePool ws) q)))


^{:go/end 148} (go/method AdjustStream [^{:tag (* priorityWriteSchedulerRFC9218)} ws ^uint32 streamID ^PriorityParam priority]
  (let [metadata (aget (.-streams ws) streamID)
      (values q u i) (values (.-location metadata) (.-urgency (.-priority metadata)) (.-incremental (.-priority metadata)))]
    (when (== q nil)
      (set! (.-streamID (.-priorityUpdateBuf ws)) streamID)
      (set! (.-priority (.-priorityUpdateBuf ws)) priority)
      (return))


    ;; Remove stream from current location.
    (if (== (.-next q) q)
      ;; This was the only open stream.
      (aset (aget (.-heads ws) u) i nil)
      (do
        (set! (.-next (.-prev q)) (.-next q))
        (set! (.-prev (.-next q)) (.-prev q))
        (when (== (aget (aget (.-heads ws) u) i) q)
          (aset (aget (.-heads ws) u) i (.-next q)))))



    ;; Insert stream to the new queue.
    (set! (values u i) (values (.-urgency priority) (.-incremental priority)))
    (if (== (aget (aget (.-heads ws) u) i) nil) (do
        (aset (aget (.-heads ws) u) i q)
        (set! (.-next q) q)
        (set! (.-prev q) q))
      (do
        ;; Queues are stored in a ring.
        ;; Insert the new stream before ws.head, putting it at the end of the list.
        (set! (.-prev q) (.-prev (aget (aget (.-heads ws) u) i)))
        (set! (.-next q) (aget (aget (.-heads ws) u) i))
        (set! (.-next (.-prev q)) q)
        (set! (.-prev (.-next q)) q)))


    ;; Update the metadata.
    (aset (.-streams ws) streamID ^{:go/breaks [2 4]} (lit streamMetadata
        :location q
        :priority priority))))



^{:go/end 167} (go/method Push [^{:tag (* priorityWriteSchedulerRFC9218)} ws ^FrameWriteRequest wr]
  (when (.isControl wr)
    (.push (.-control ws) wr)
    (return))

  (let [q (.-location (aget (.-streams ws) (.StreamID wr)))]
    (when (== q nil)
      ;; This is a closed stream.
      ;; wr should not be a HEADERS or DATA frame.
      ;; We push the request onto the control queue.
      (when (> (.DataSize wr) 0)
        (panic "add DATA on non-open stream"))

      (.push (.-control ws) wr)
      (return))

    (.push q wr)))


^{:go/end 224} (go/method Pop [^{:tag (* priorityWriteSchedulerRFC9218)} ws] :results [FrameWriteRequest bool]
  ;; Control and RST_STREAM frames first.
  (when (not (.empty (.-control ws)))
    (return (.shift (.-control ws)) true))


  ;; On the next Pop(), we want to prioritize incremental if we prioritized
  ;; non-incremental request of the same urgency this time. Vice-versa.
  ;; i.e. when there are incremental and non-incremental requests at the same
  ;; priority, we give 50% of our bandwidth to the incremental ones in
  ;; aggregate and 50% to the first non-incremental one (since
  ;; non-incremental streams do not use round-robin writes).
  (set! (.-prioritizeIncremental ws) (not (.-prioritizeIncremental ws)))

  ;; Always prioritize lowest u (i.e. highest urgency level).
  (range [u (.-heads ws)]
    (range [i (aget (.-heads ws) u)]
      ;; When we want to prioritize incremental, we try to pop i=true
      ;; first before i=false when u is the same.
      (when (.-prioritizeIncremental ws)
        (set! i (% (+ i 1) 2)))

      (let [q (aget (aget (.-heads ws) u) i)]
        (when (== q nil)
          (continue))

        (while true
          (when [(values wr ok) (.consume q math/MaxInt32)] ok
            (if (== i 1)
              ;; For incremental streams, we update head to q.next so
              ;; we can round-robin between multiple streams that can
              ;; immediately benefit from partial writes.
              (aset (aget (.-heads ws) u) i (.-next q))

              ;; For non-incremental streams, we try to finish one to
              ;; completion rather than doing round-robin. However,
              ;; we update head here so that if q.consume() is !ok
              ;; (e.g. the stream has no more frame to consume), head
              ;; is updated to the next q that has frames to consume
              ;; on future iterations. This way, we do not prioritize
              ;; writing to unavailable stream on next Pop() calls,
              ;; preventing head-of-line blocking.
              (aset (aget (.-heads ws) u) i q))

            (return wr true))

          (set! q (.-next q))
          (when (== q (aget (aget (.-heads ws) u) i))
            (break))))))





  (return (lit FrameWriteRequest) false))

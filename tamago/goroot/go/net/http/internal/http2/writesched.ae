              ;; this intermediate frame, so no need to wait.
              :done nil)

            ^{:line 141} rest ^{:go/breaks [2 4 [6 148]]} (lit FrameWriteRequest
              :stream (.-stream wr)
              :write (addr ^{:go/breaks [2 4 6]} (lit writeData
                  :streamID (.-streamID wd)
                  :p (subslice (.-p wd) allowed)
                  :endStream (.-endStream wd)))

              :done (.-done wr))]


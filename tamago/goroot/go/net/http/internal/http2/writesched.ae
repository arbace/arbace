^{:go/end 182} (go/method replyToWriter "replyToWriter sends err to wr.done and panics if the send must block\nThis does nothing if wr.done is nil.\n" [^{:tag (* FrameWriteRequest)} wr ^error err]
  (when (== (.-done wr) nil)
    (return))

  (select
    (case (>! (.-done wr) err))
    (default
      (panic (fmt/Sprintf "unbuffered done channel passed in for type %T" (.-write wr)))))

  (set! (.-write wr) nil)) ; prevent use (assume it's tainted after wr.done send)

















(go/type writeQueue "writeQueue is used by implementations of WriteScheduler.\n\nEach writeQueue contains a queue of FrameWriteRequests, meant to store all\nFrameWriteRequests associated with a given stream. This is implemented as a\ntwo-stage queue: currQueue[currPos:] and nextQueue. Removing an item is done\nby incrementing currPos of currQueue. Adding an item is done by appending it\nto the nextQueue. If currQueue is empty when trying to remove an item, we\ncan swap currQueue and nextQueue to remedy the situation.\nThis two-stage queue is analogous to the use of two lists in Okasaki's\npurely functional queue but without the overhead of reversing the list when\nswapping stages.\n\nwriteQueue also contains prev and next, this can be used by implementations\nof WriteScheduler to construct data structures that represent the order of\nwriting between different streams (e.g. circular linked list).\n" (struct
    ^{:line 200 :tag (slice FrameWriteRequest)} currQueue
    ^{:line 201 :tag (slice FrameWriteRequest)} nextQueue
    ^{:line 202 :tag int} currPos

    ^{:line 204 :tag (* writeQueue)} prev ^{:tag (* writeQueue)} next))


^{:go/end 209} (go/method empty ^bool [^{:tag (* writeQueue)} q]
  (== (+ (- (len (.-currQueue q)) (.-currPos q)) (len (.-nextQueue q))) 0))


^{:go/end 213} (go/method push [^{:tag (* writeQueue)} q ^FrameWriteRequest wr]
  (set! (.-nextQueue q) (append (.-nextQueue q) wr)))


^{:go/end 226} (go/method shift ^FrameWriteRequest [^{:tag (* writeQueue)} q]
  (when (.empty q)
    (panic "invalid use of queue"))

  (when (>= (.-currPos q) (len (.-currQueue q)))
    (set! (values (.-currQueue q) (.-currPos q) (.-nextQueue q)) (values (.-nextQueue q) 0 (subslice (.-currQueue q) _ 0))))

  (let [wr (aget (.-currQueue q) (.-currPos q))]
    (aset (.-currQueue q) (.-currPos q) (lit FrameWriteRequest))
    (inc! (.-currPos q))
    ^{:line 225} wr))


^{:go/breaks [[5 235]] :go/end 236} (go/method peek ^{:tag (* FrameWriteRequest)} [^{:tag (* writeQueue)} q]
  (when (< (.-currPos q) (len (.-currQueue q)))
    (return (addr (aget (.-currQueue q) (.-currPos q)))))

  (when (> (len (.-nextQueue q)) 0)
    (return (addr (aget (.-nextQueue q) 0))))

  nil)






^{:go/end 256} (go/method consume "consume consumes up to n bytes from q.s[0]. If the frame is\nentirely consumed, it is removed from the queue. If the frame\nis partially consumed, the frame is kept with the consumed\nbytes removed. Returns true iff any bytes were consumed.\n" [^{:tag (* writeQueue)} q ^int32 n] :results [FrameWriteRequest bool]
  (when (.empty q)
    (return (lit FrameWriteRequest) false))

  (let [(values consumed rest numresult) (.Consume (.peek q) n)]
    (switch numresult
      (case [0]
        (return (lit FrameWriteRequest) false))
      (case [1]
        (.shift q))
      (case [2]
        (set! @(.peek q) rest)))

    (return consumed true)))


(go/type writeQueuePool (slice (* writeQueue)))


^{:go/end 272} (go/method put "put inserts an unused writeQueue into the pool.\n" [^{:tag (* writeQueuePool)} p ^{:tag (* writeQueue)} q]
  (range [i (.-currQueue q)]
    (aset (.-currQueue q) i (lit FrameWriteRequest)))

  (range [i (.-nextQueue q)]
    (aset (.-nextQueue q) i (lit FrameWriteRequest)))

  (set! (.-currQueue q) (subslice (.-currQueue q) _ 0))
  (set! (.-nextQueue q) (subslice (.-nextQueue q) _ 0))
  (set! (.-currPos q) 0)
  (set! @p (append @p q)))




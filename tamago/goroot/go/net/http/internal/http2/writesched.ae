      (when (< (.-maxFrameSize (.-sc (.-stream wr))) allowed)
        (set! allowed (.-maxFrameSize (.-sc (.-stream wr)))))

      (when (<= allowed 0)
        (return empty empty 0))

      (when (> (len (.-p wd)) (conv int allowed))
        (.take (.-flow (.-stream wr)) allowed)

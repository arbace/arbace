    ^{:line 44 :tag uint32 :doc "PusherID is zero if the stream was initiated by the client. Otherwise,\nPusherID names the stream that pushed the newly opened stream.\n"} PusherID

    ^{:line 46 :tag PriorityParam :doc "priority is used to set the priority of the newly opened stream.\n"} priority))




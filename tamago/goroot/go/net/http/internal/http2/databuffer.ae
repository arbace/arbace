  (switch (len p)
    (case [(<< 1 10)]
      (.Put (aget dataChunkPools 0) (conv (* (array (<< 1 10) byte)) p)))
    (case [(<< 2 10)]
      (.Put (aget dataChunkPools 1) (conv (* (array (<< 2 10) byte)) p)))
    (case [(<< 4 10)]
      (.Put (aget dataChunkPools 2) (conv (* (array (<< 4 10) byte)) p)))
    (case [(<< 8 10)]
      (.Put (aget dataChunkPools 3) (conv (* (array (<< 8 10) byte)) p)))
    (case [(<< 16 10)]

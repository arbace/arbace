    (case [(<= size (<< 1 10))]
      (return (subslice (assert (* (array (<< 1 10) byte)) (.Get (aget dataChunkPools 0))))))
    (case [(<= size (<< 2 10))]
      (return (subslice (assert (* (array (<< 2 10) byte)) (.Get (aget dataChunkPools 1))))))
    (case [(<= size (<< 4 10))]
      (return (subslice (assert (* (array (<< 4 10) byte)) (.Get (aget dataChunkPools 2))))))
    (case [(<= size (<< 8 10))]
      (return (subslice (assert (* (array (<< 8 10) byte)) (.Get (aget dataChunkPools 3))))))
    (default
      (return (subslice (assert (* (array (<< 16 10) byte)) (.Get (aget dataChunkPools 4))))))))




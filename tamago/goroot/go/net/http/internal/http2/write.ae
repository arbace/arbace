^{:go/end 185} (go/func splitHeaderBlock "splitHeaderBlock splits headerBlock into fragments so that each fragment fits\nin a single frame, then calls fn for each fragment. firstFrag/lastFrag are true\nfor the first/last fragment, respectively.\n" ^error [^writeContext ctx ^{:tag (slice byte)} headerBlock ^{:tag (func [^writeContext ctx ^{:tag (slice byte)} frag ^bool firstFrag ^bool lastFrag] [error])} fn]
  ;; For now we're lazy and just pick the minimum MAX_FRAME_SIZE
  ;; that all peers must support (16KB). Later we could care
  ;; more and send larger frames if the peer advertised it, but
  ;; there's little point. Most headers are small anyway (so we
  ;; generally won't have CONTINUATION frames), and extra frames
  ;; only waste 9 bytes anyway.
  ^{:go/breaks [[3 184]]} (let [^:const ^{:val 16384} maxFrameSize 16384

      ^{:line 172} first true]
    (while (> (len headerBlock) 0)
      (let [frag headerBlock]
        (when (> (len frag) maxFrameSize)
          (set! frag (subslice frag _ maxFrameSize)))

        (set! headerBlock (subslice headerBlock (len frag)))
        (when [err (go/call fn ctx frag first (== (len headerBlock) 0))] (!= err nil)
          (return err))

        (set! first false)))

    nil))




(go/type writeResHeaders "writeResHeaders is a request to write a HEADERS and 0+ CONTINUATION frames\nfor HTTP response headers or trailers from a server handler.\n" (struct
    ^{:line 190 :tag uint32} streamID

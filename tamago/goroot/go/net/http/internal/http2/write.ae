(go/type writeContext "writeContext is the interface needed by the various frame writer\ntypes below. All the writeFrame methods below are scheduled via the\nframe writing scheduler (see writeScheduler in writesched.go).\n\nThis interface is implemented by *serverConn.\n\nTODO: decide whether to a) use this in the client code (which didn't\nend up using this yet, because it has a simpler design, not\ncurrently implementing priorities), or b) delete this and\nmake the server code a bit more concrete.\n" (interface
    (Framer ^{:tag (* Framer)} [])
    (Flush ^error [])
    (CloseConn ^error [])


    (^{:doc "HeaderEncoder returns an HPACK encoder that writes to the\nreturned buffer.\n"} HeaderEncoder [] :results [(* hpack/Encoder) (* bytes/Buffer)])))





^{:go/breaks [[5 62]] :go/end 63} (go/func writeEndsStream "writeEndsStream reports whether w writes a frame that will transition\nthe stream to a half-closed local state. This returns false for RST_STREAM,\nwhich closes the entire stream (not just the local half).\n" ^bool [^writeFramer w]
  (type-switch [v w]
    (case [(* writeData)]
      (return (.-endStream v)))
    (case [(* writeResHeaders)]
      (return (.-endStream v)))
    (case [nil]
      ;; This can only happen if the caller reuses w after it's
      ;; been intentionally nil'ed out to prevent use. Keep this
      ;; here to catch future refactoring breaking it.
      (panic "writeEndsStream called on nil writeFramer")))

  false)



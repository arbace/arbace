^{:go/end 206} (go/func encKV [^{:tag (* hpack/Encoder)} enc ^string k ^string v]
  (when VerboseLogs
    (log/Printf "http2: server encoding header %q = %q" k v))

  (.WriteField enc (lit hpack/HeaderField :Name k :Value v)))


^{:go/breaks [[3 216]] :go/end 217} (go/method staysWithinBuffer ^bool [^{:tag (* writeResHeaders)} w ^int max]
  ;; TODO: this is a common one. It'd be nice to return true
  ;; here and get into the fast path if we could be clever and
  ;; calculate the size fast enough, or at least a conservative
  ;; upper bound that usually fires. (Maybe if w.h and
  ;; w.trailers are nil, so we don't need to enumerate it.)
  ;; Otherwise I'm afraid that just calculating the length to
  ;; answer this question would be slower than the ~2µs benefit.
  false)


^{:go/end 245} (go/method writeFrame ^error [^{:tag (* writeResHeaders)} w ^writeContext ctx]
  (let [(values enc buf) (.HeaderEncoder ctx)]
    (.Reset buf)

    (when (!= (.-httpResCode w) 0)
      (encKV enc ":status" (httpCodeString (.-httpResCode w))))


    (encodeHeaders enc (.-h w) (.-trailers w))

    (when (!= (.-contentType w) "")
      (encKV enc "content-type" (.-contentType w)))

    (when (!= (.-contentLength w) "")
      (encKV enc "content-length" (.-contentLength w)))

    (when (!= (.-date w) "")
      (encKV enc "date" (.-date w)))


    (let [headerBlock (.Bytes buf)]
      (when (and (== (len headerBlock) 0) (== (.-trailers w) nil))
        (panic "unexpected empty hpack"))


      (splitHeaderBlock ctx headerBlock (.-writeHeaderBlock w)))))



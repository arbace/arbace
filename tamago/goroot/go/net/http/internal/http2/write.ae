^{:go/end 380} (go/func encodeHeaders "encodeHeaders encodes an http.Header. If keys is not nil, then (k, h[k])\nis encoded only if k is in keys.\n" [^{:tag (* hpack/Encoder)} enc ^Header h ^{:tag (slice string)} keys]
  (when (== keys nil)
    (let [sorter (assert (* sorter) (.Get sorterPool))]
      ;; Using defer here, since the returned keys from the
      ;; sorter.Keys method is only valid until the sorter
      ;; is returned:
      (defer (.Put sorterPool sorter))
      (set! keys (.Keys sorter h))))

  (range [_ k keys]
    (let [vv (aget h k)
        (values k ascii) (httpcommon/LowerHeader k)]
      (when (not ascii)
        ;; Skip writing invalid headers. Per RFC 7540, Section 8.1.2, header
        ;; field names have to be ASCII characters (just as in HTTP/1.x).
        (continue))

      (when (not (validWireHeaderFieldName k))
        ;; Skip it as backup paranoia. Per
        ;; golang.org/issue/14048, these should
        ;; already be rejected at a higher level.
        (continue))

      (let [isTE (== k "transfer-encoding")]
        (range [_ v vv]
          (when (not (httpguts/ValidHeaderFieldValue v))
            ;; TODO: return an error? golang.org/issue/14048
            ;; For now just omit it.
            (continue))

          ;; TODO: more of "8.1.2.2 Connection-Specific Header Fields"
          (when (and isTE (!= v "trailers"))
            (continue))

          (encKV enc k v))))))

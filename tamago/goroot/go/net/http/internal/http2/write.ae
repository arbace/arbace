  (if firstFrag
    (return (.WriteHeaders (.Framer ctx) ^{:go/breaks [2 4 6 8]} (lit HeadersFrameParam
          :StreamID (.-streamID w)
          :BlockFragment frag
          :EndStream (.-endStream w)
          :EndHeaders lastFrag)))


    (return (.WriteContinuation (.Framer ctx) (.-streamID w) lastFrag frag))))





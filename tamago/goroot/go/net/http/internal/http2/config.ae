(go/type Config "Config must be kept in sync with net/http.HTTP2Config.\n" (struct
    ^{:line 14 :tag int} MaxConcurrentStreams
    ^{:line 15 :tag bool} StrictMaxConcurrentRequests
    ^{:line 16 :tag int} MaxDecoderHeaderTableSize
    ^{:line 17 :tag int} MaxEncoderHeaderTableSize
    ^{:line 18 :tag int} MaxReadFrameSize
    ^{:line 19 :tag int} MaxReceiveBufferPerConnection

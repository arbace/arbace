^{:go/end 33} (go/func configFromServer ^Config [^ServerConfig h1]
  (let [conf (lit Config)]
    (fillNetHTTPConfig (addr conf) (.HTTP2Config h1))
    (setConfigDefaults (addr conf) true)
    ^{:line 32} conf))


^{:go/end 42} (go/func configFromTransport ^Config [^{:tag (* Transport)} h2]
  (let [conf (lit Config)]
    (when (!= (.-t1 h2) nil)
      (fillNetHTTPConfig (addr conf) (.HTTP2Config (.-t1 h2))))

    (setConfigDefaults (addr conf) false)
    ^{:line 41} conf))


^{:go/end 48} (go/func setDefault :type-params [^{:tag (| (tilde int) (tilde int32) (tilde uint32) (tilde int64))} T] [^{:tag (* T)} v ^T minval ^:go/grouped ^T maxval ^:go/grouped ^T defval]
  (when (or (< @v minval) (> @v maxval))
    (set! @v defval)))



^{:go/end 66} (go/func setConfigDefaults [^{:tag (* Config)} conf ^bool server]
  (^{:inst [int]} setDefault (addr (.-MaxConcurrentStreams conf)) 1 math/MaxInt32 defaultMaxStreams)
  (^{:inst [int]} setDefault (addr (.-MaxEncoderHeaderTableSize conf)) 1 math/MaxInt32 initialHeaderTableSize)
  (^{:inst [int]} setDefault (addr (.-MaxDecoderHeaderTableSize conf)) 1 math/MaxInt32 initialHeaderTableSize)
  (if server
    (^{:inst [int]} setDefault (addr (.-MaxReceiveBufferPerConnection conf)) initialWindowSize math/MaxInt32 (<< 1 20))

    (^{:inst [int]} setDefault (addr (.-MaxReceiveBufferPerConnection conf)) initialWindowSize math/MaxInt32 transportDefaultConnFlow))

  (if server
    (^{:inst [int]} setDefault (addr (.-MaxReceiveBufferPerStream conf)) 1 math/MaxInt32 (<< 1 20))

    (^{:inst [int]} setDefault (addr (.-MaxReceiveBufferPerStream conf)) 1 math/MaxInt32 transportDefaultStreamFlow))

  (^{:inst [int]} setDefault (addr (.-MaxReadFrameSize conf)) minMaxFrameSize maxFrameSize defaultMaxReadFrameSize)
  (^{:inst [time/Duration]} setDefault (addr (.-PingTimeout conf)) 1 math/MaxInt64 (* 15 time/Second)))




^{:go/end 76} (go/func adjustHTTP1MaxHeaderSize "adjustHTTP1MaxHeaderSize converts a limit in bytes on the size of an HTTP/1 header\nto an HTTP/2 MAX_HEADER_LIST_SIZE value.\n" ^int64 [^int64 n]
  ;; http2's count is in a slightly different unit and includes 32 bytes per pair.
  ;; So, take the net/http.Server value and pad it up a bit, assuming 10 headers.
  (let [^:const ^{:val 32} perFieldOverhead 32 ; per http2 spec
      ^:const ^{:line 74 :val 10} typicalHeaders 10] ; conservative
    (+ n (* typicalHeaders perFieldOverhead))))


^{:go/end 118} (go/func fillNetHTTPConfig [^{:tag (* Config)} conf ^Config h2]
  (when (!= (.-MaxConcurrentStreams h2) 0)
    (set! (.-MaxConcurrentStreams conf) (.-MaxConcurrentStreams h2)))

  (when (.-StrictMaxConcurrentRequests h2)
    (set! (.-StrictMaxConcurrentRequests conf) true))

  (when (!= (.-MaxEncoderHeaderTableSize h2) 0)
    (set! (.-MaxEncoderHeaderTableSize conf) (.-MaxEncoderHeaderTableSize h2)))

  (when (!= (.-MaxDecoderHeaderTableSize h2) 0)
    (set! (.-MaxDecoderHeaderTableSize conf) (.-MaxDecoderHeaderTableSize h2)))

  (when (!= (.-MaxConcurrentStreams h2) 0)
    (set! (.-MaxConcurrentStreams conf) (.-MaxConcurrentStreams h2)))

  (when (!= (.-MaxReadFrameSize h2) 0)
    (set! (.-MaxReadFrameSize conf) (.-MaxReadFrameSize h2)))

  (when (!= (.-MaxReceiveBufferPerConnection h2) 0)
    (set! (.-MaxReceiveBufferPerConnection conf) (.-MaxReceiveBufferPerConnection h2)))

  (when (!= (.-MaxReceiveBufferPerStream h2) 0)
    (set! (.-MaxReceiveBufferPerStream conf) (.-MaxReceiveBufferPerStream h2)))

  (when (!= (.-SendPingTimeout h2) 0)
    (set! (.-SendPingTimeout conf) (.-SendPingTimeout h2)))

  (when (!= (.-PingTimeout h2) 0)
    (set! (.-PingTimeout conf) (.-PingTimeout h2)))

  (when (!= (.-WriteByteTimeout h2) 0)
    (set! (.-WriteByteTimeout conf) (.-WriteByteTimeout h2)))

  (when (.-PermitProhibitedCipherSuites h2)
    (set! (.-PermitProhibitedCipherSuites conf) true))

  (when (!= (.-CountError h2) nil)
    (set! (.-CountError conf) (.-CountError h2))))

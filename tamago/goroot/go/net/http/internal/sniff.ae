    ;; TODO: do whatever the spec ends up doing.
    (addr (lit exactSig (conv (slice byte) "Rar!\u001a\u0007\u0000") "application/x-rar-compressed")) ; RAR v1.5-v4.0
    (addr (lit exactSig (conv (slice byte) "Rar!\u001a\u0007\u0001\u0000") "application/x-rar-compressed")) ; RAR v5+

    (addr (lit exactSig (conv (slice byte) "\u0000asm") "application/wasm"))

    (lit textSig))) ; should be last


(go/type exactSig (struct
    ^{:line 198 :tag (slice byte)} sig
    ^{:line 199 :tag string} ct))


^{:go/breaks [[4 206]] :go/end 207} (go/method match ^string [^{:tag (* exactSig)} e ^{:tag (slice byte)} data ^int firstNonWS]
  (when (bytes/HasPrefix data (.-sig e))
    (return (.-ct e)))

  "")


(go/type maskedSig (struct
    ^{:line 210 :tag (slice byte)} mask ^{:tag (slice byte)} pat
    ^{:line 211 :tag bool} skipWS
    ^{:line 212 :tag string} ct))


^{:go/end 235} (go/method match ^string [^{:tag (* maskedSig)} m ^{:tag (slice byte)} data ^int firstNonWS]
  ;; pattern matching algorithm section 6
  ;; https://mimesniff.spec.whatwg.org/#pattern-matching-algorithm

  (when (.-skipWS m)
    (set! data (subslice data firstNonWS)))

  (when (!= (len (.-pat m)) (len (.-mask m)))
    (return ""))

  (when (< (len data) (len (.-pat m)))
    (return ""))

  (range [i pb (.-pat m)]
    (let [maskedData (bit-and (aget data i) (aget (.-mask m) i))]
      (when (!= maskedData pb)
        (return ""))))


  (.-ct m))


(go/type htmlSig (slice byte))

^{:go/breaks [[7 257]] :go/end 258} (go/method match ^string [^htmlSig h ^{:tag (slice byte)} data ^int firstNonWS]
  (set! data (subslice data firstNonWS))
  (when (< (len data) (+ (len h) 1))
    (return ""))

  (range [i b h]
    (let [db (aget data i)]
      (when (and (<= \A b) (<= b \Z))
        (set! db bit-and 0xDF))

      (when (!= b db)
        (return ""))))


  ;; Next byte must be a tag-terminating byte(0xTT).
  (when (not (isTT (aget data (len h))))
    (return ""))

  "text/html; charset=utf-8")


(go/var mp4ftype (conv (slice byte) "ftyp"))
(go/var mp4 (conv (slice byte) "mp4"))

(go/type mp4Sig (struct))

^{:go/end 288} (go/method match ^string [mp4Sig ^{:tag (slice byte)} data ^int firstNonWS]
  ;; https://mimesniff.spec.whatwg.org/#signature-for-mp4
  ;; c.f. section 6.2.1
  (when (< (len data) 12)
    (return ""))

  ^{:go/breaks [[5 287]]} (let [boxSize (conv int (.Uint32 binary/BigEndian (subslice data _ 4)))]
    (when (or (< (len data) boxSize) (!= (% boxSize 4) 0))
      (return ""))

    (when (not (bytes/Equal (subslice data 4 8) mp4ftype))
      (return ""))

    (for [st 8] (< st boxSize) (set! st + 4)
      (when (== st 12)
        ;; Ignores the four bytes that correspond to the version number of the "major brand".
        (continue))

      (when (bytes/Equal (subslice data st (+ st 3)) mp4)
        (return "video/mp4")))


    ""))


(go/type textSig (struct))

^{:go/breaks [[4 303]] :go/end 304} (go/method match ^string [textSig ^{:tag (slice byte)} data ^int firstNonWS]
  ;; c.f. section 5, step 4.
  (range [_ b (subslice data firstNonWS)]
    (switch
      (case [(<= b 0x08)
          (== b 0x0B)
          (and (<= 0x0E b) (<= b 0x1A))
          (and (<= 0x1C b) (<= b 0x1F))]
        (return ""))))


  "text/plain; charset=utf-8")

    (addr ^{:go/breaks [2 4 6]} (lit maskedSig
        :mask (conv (slice byte) (byte-string 0xff 0xff 0xff 0xff "\u0000\u0000\u0000\u0000" 0xff 0xff 0xff 0xff))
        :pat (conv (slice byte) "RIFF\u0000\u0000\u0000\u0000WAVE")
        :ct "audio/wave"))

    ;; 6.2.0.2. video/mp4
    (lit mp4Sig)
    ;; 6.2.0.3. video/webm
    (addr (lit exactSig (conv (slice byte) "\u001aEߣ") "video/webm"))

    ;; Font types
    (addr ^{:go/breaks [[2 169] [4 171] 6]} (lit maskedSig
        ;; 34 NULL bytes followed by the string "LP"
        :pat (conv (slice byte) "\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000LP")
        ;; 34 NULL bytes followed by \xF\xF
        :mask (conv (slice byte) (byte-string "\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000" 0xff 0xff))
        :ct "application/vnd.ms-fontobject"))

    (addr (lit exactSig (conv (slice byte) "\u0000\u0001\u0000\u0000") "font/ttf"))
    (addr (lit exactSig (conv (slice byte) "OTTO") "font/otf"))
    (addr (lit exactSig (conv (slice byte) "ttcf") "font/collection"))
    (addr (lit exactSig (conv (slice byte) "wOFF") "font/woff"))
    (addr (lit exactSig (conv (slice byte) "wOF2") "font/woff2"))

    ;; Archive types
    (addr (lit exactSig (conv (slice byte) (byte-string "\u001f" 0x8b "\b")) "application/x-gzip"))
    (addr (lit exactSig (conv (slice byte) "PK\u0003\u0004") "application/zip"))
    ;; RAR's signatures are incorrectly defined by the MIME spec as per

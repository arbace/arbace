(go/const ^{:val 512 :doc "The algorithm uses at most SniffLen bytes to make its decision.\n"} SniffLen 512)







^{:go/end 38} (go/func DetectContentType "DetectContentType implements the algorithm described\nat https://mimesniff.spec.whatwg.org/ to determine the\nContent-Type of the given data. It considers at most the\nfirst 512 bytes of data. DetectContentType always returns\na valid MIME type: if it cannot determine a more specific one, it\nreturns \"application/octet-stream\".\n" ^string [^{:tag (slice byte)} data]
  (when (> (len data) SniffLen)
    (set! data (subslice data _ SniffLen)))


  ;; Index of the first non-whitespace byte in data.
  ^{:go/breaks [[4 37]]} (let [firstNonWS 0]
    (for [] (and (< firstNonWS (len data)) (isWS (aget data firstNonWS))) (inc! firstNonWS))


    (range [_ sig sniffSignatures]
      (when [ct (.match sig data firstNonWS)] (!= ct "")
        (return ct)))



    "application/octet-stream")) ; fallback




^{:go/breaks [[5 47]] :go/end 48} (go/func isWS "isWS reports whether the provided byte is a whitespace byte (0xWS)\nas defined in https://mimesniff.spec.whatwg.org/#terminology.\n" ^bool [^byte b]
  (switch b
    (case [\tab \newline \formfeed \return \space]
      (return true)))

  false)




^{:go/breaks [[5 57]] :go/end 58} (go/func isTT "isTT reports whether the provided byte is a tag-terminating byte (0xTT)\nas defined in https://mimesniff.spec.whatwg.org/#terminology.\n" ^bool [^byte b]
  (switch b
    (case [\space \>]
      (return true)))

  false)


(go/type sniffSig (interface

    (^{:doc "match returns the MIME type of the data, or \"\" if unknown.\n"} match ^string [^{:tag (slice byte)} data ^int firstNonWS])))



(go/var ^{:doc "Data matching the table in section 6.\n"} sniffSignatures (lit (slice sniffSig)
    (conv htmlSig "<!DOCTYPE HTML")
    (conv htmlSig "<HTML")
    (conv htmlSig "<HEAD")
    (conv htmlSig "<SCRIPT")
    (conv htmlSig "<IFRAME")
    (conv htmlSig "<H1")
    (conv htmlSig "<DIV")
    (conv htmlSig "<FONT")
    (conv htmlSig "<TABLE")
    (conv htmlSig "<A")
    (conv htmlSig "<STYLE")
    (conv htmlSig "<TITLE")
    (conv htmlSig "<B")
    (conv htmlSig "<BODY")
    (conv htmlSig "<BR")
    (conv htmlSig "<P")
    (conv htmlSig "<!--")
    (addr ^{:go/breaks [2 4 6 8]} (lit maskedSig
        :mask (conv (slice byte) (byte-string 0xff 0xff 0xff 0xff 0xff))
        :pat (conv (slice byte) "<?xml")
        :skipWS true
        :ct "text/xml; charset=utf-8"))
    (addr (lit exactSig (conv (slice byte) "%PDF-") "application/pdf"))
    (addr (lit exactSig (conv (slice byte) "%!PS-Adobe-") "application/postscript"))

    ;; UTF BOMs.
    (addr ^{:go/breaks [2 4 6]} (lit maskedSig
        :mask (conv (slice byte) (byte-string 0xff 0xff "\u0000\u0000"))
        :pat (conv (slice byte) (byte-string 0xfe 0xff "\u0000\u0000"))
        :ct "text/plain; charset=utf-16be"))

    (addr ^{:go/breaks [2 4 6]} (lit maskedSig
        :mask (conv (slice byte) (byte-string 0xff 0xff "\u0000\u0000"))
        :pat (conv (slice byte) (byte-string 0xff 0xfe "\u0000\u0000"))
        :ct "text/plain; charset=utf-16le"))

    (addr ^{:go/breaks [2 4 6]} (lit maskedSig
        :mask (conv (slice byte) (byte-string 0xff 0xff 0xff "\u0000"))
        :pat (conv (slice byte) "\ufeff\u0000")
        :ct "text/plain; charset=utf-8"))


    ;; Image types
    ;; For posterity, we originally returned "image/vnd.microsoft.icon" from
    ;; https://tools.ietf.org/html/draft-ietf-websec-mime-sniff-03#section-7
    ;; https://codereview.appspot.com/4746042
    ;; but that has since been replaced with "image/x-icon" in Section 6.2
    ;; of https://mimesniff.spec.whatwg.org/#matching-an-image-type-pattern
    (addr (lit exactSig (conv (slice byte) "\u0000\u0000\u0001\u0000") "image/x-icon"))
    (addr (lit exactSig (conv (slice byte) "\u0000\u0000\u0002\u0000") "image/x-icon"))
    (addr (lit exactSig (conv (slice byte) "BM") "image/bmp"))
    (addr (lit exactSig (conv (slice byte) "GIF87a") "image/gif"))
    (addr (lit exactSig (conv (slice byte) "GIF89a") "image/gif"))
    (addr ^{:go/breaks [2 4 6]} (lit maskedSig
        :mask (conv (slice byte) (byte-string 0xff 0xff 0xff 0xff "\u0000\u0000\u0000\u0000" 0xff 0xff 0xff 0xff 0xff 0xff))
        :pat (conv (slice byte) "RIFF\u0000\u0000\u0000\u0000WEBPVP")
        :ct "image/webp"))

    (addr (lit exactSig (conv (slice byte) (byte-string 0x89 "PNG\r\n\u001a\n")) "image/png"))
    (addr (lit exactSig (conv (slice byte) (byte-string 0xff 0xd8 0xff)) "image/jpeg"))

    ;; Audio and Video types
    ;; Enforce the pattern match ordering as prescribed in
    ;; https://mimesniff.spec.whatwg.org/#matching-an-audio-or-video-type-pattern

        :mask (conv (slice byte) (byte-string 0xff 0xff 0xff 0xff "\u0000\u0000\u0000\u0000" 0xff 0xff 0xff 0xff))
        :pat (conv (slice byte) "FORM\u0000\u0000\u0000\u0000AIFF")
        :ct "audio/aiff"))

    (addr ^{:go/breaks [2 4 6]} (lit maskedSig
        :mask (conv (slice byte) (byte-string 0xff 0xff 0xff))
        :pat (conv (slice byte) "ID3")
        :ct "audio/mpeg"))

    (addr ^{:go/breaks [2 4 6]} (lit maskedSig
        :mask (conv (slice byte) (byte-string 0xff 0xff 0xff 0xff 0xff))
        :pat (conv (slice byte) "OggS\u0000")
        :ct "application/ogg"))

    (addr ^{:go/breaks [2 4 6]} (lit maskedSig
        :mask (conv (slice byte) (byte-string 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff))
        :pat (conv (slice byte) "MThd\u0000\u0000\u0000\u0006")
        :ct "audio/midi"))

    (addr ^{:go/breaks [2 4 6]} (lit maskedSig
        :mask (conv (slice byte) (byte-string 0xff 0xff 0xff 0xff "\u0000\u0000\u0000\u0000" 0xff 0xff 0xff 0xff))
        :pat (conv (slice byte) "RIFF\u0000\u0000\u0000\u0000AVI ")

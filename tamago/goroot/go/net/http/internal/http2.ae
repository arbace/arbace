(ns go.net.http.internal.http2
  (:require [arbace.go :as go]))

(go/package http2
  :path "net/http/internal/http2"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["api.go" "ascii.go" "ciphers.go" "client_conn_pool.go" "config.go" "databuffer.go" "errors.go" "flow.go" "frame.go" "gotrack.go" "http2.go" "pipe.go" "server.go" "transport.go" "write.go" "writesched.go" "writesched_priority_rfc9218.go" "writesched_roundrobin.go"]
  :init-order [ErrAbortHandler ErrBodyNotAllowed ErrNotSupported ErrSkipAltProtocol dataChunkPools errReadEmpty errCodeName errFromPeer errMixPseudoHeaderTypes errPseudoAfterRegular padZeros frameNames flagName frameParsers fhBytes ErrFrameTooLarge errStreamID errDepStreamID errPadLength errPadBytes DebugGoroutines goroutineSpace littleBuf disableExtendedConnectProtocol inTests clientPreface stateName settingName bufWriterPool errTimeout sorterPool errClosedPipeWrite errUninitializedPipeWrite errClientDisconnected errClosedBody errHandlerComplete errStreamClosed responseWriterStatePool errChanPool NewConnContextKey ConnectionStateContextKey settingsTimerMsg idleTimerMsg readIdleTimerMsg shutdownTimerMsg gracefulShutdownMsg handlerDoneMsg errPrefaceTimeout writeDataPool errHandlerPanicked goAwayTimeout ErrRecursivePush ErrPushLimitReached connHeaders ErrNoCachedConn errClientConnClosed errClientConnUnusable errClientConnNotEstablished errClientConnGotGoAway errClientConnForceClosed shutdownEnterWaitStateHook errRequestCanceled errExtendedConnectNotSupported errStopReqBodyWrite errStopReqBodyWriteAndCancel errReqBodyTooLong errStopReadLoop errClosedResponseBody errResponseHeaderListSize errRequestHeaderListSize errConcurrentReadOnResBody gzipPool]
  :positions :lines)

(load "http2/api")
(load "http2/ascii")
(load "http2/ciphers")
(load "http2/client_conn_pool")
(load "http2/config")
(load "http2/databuffer")
(load "http2/errors")
(load "http2/flow")
(load "http2/frame")
(load "http2/gotrack")
(load "http2/http2")
(load "http2/pipe")
(load "http2/server")
(load "http2/transport")
(load "http2/write")
(load "http2/writesched")
(load "http2/writesched_priority_rfc9218")
(load "http2/writesched_roundrobin")

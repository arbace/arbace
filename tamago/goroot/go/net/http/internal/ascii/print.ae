(in-ns 'go.net.http.internal.ascii) (go/file "print.go" :imports [


    ^{:line 8} [strings "strings"]
    ^{:line 9} [unicode "unicode"]])




^{:go/breaks [[6 23]] :go/end 24} (go/func EqualFold "EqualFold is [strings.EqualFold], ASCII only. It reports whether s and t\nare equal, ASCII-case-insensitively.\n" ^bool [^string s ^string t]
  (when (!= (len s) (len t))
    (return false))

  (for [i 0] (< i (len s)) (inc! i)
    (when (!= (lower (aget s i)) (lower (aget t i)))
      (return false)))


  true)



^{:go/end 32} (go/func lower "lower returns the ASCII lowercase version of b.\n" ^byte [^byte b]
  (when (and (<= \A b) (<= b \Z))
    (return (+ b (- \a \A))))

  ^{:line 31} b)




^{:go/breaks [[5 42]] :go/end 43} (go/func IsPrint "IsPrint returns whether s is ASCII and printable according to\nhttps://tools.ietf.org/html/rfc20#section-4.2.\n" ^bool [^string s]
  (for [i 0] (< i (len s)) (inc! i)
    (when (or (< (aget s i) \space) (> (aget s i) \~))
      (return false)))


  true)



^{:go/breaks [[5 52]] :go/end 53} (go/func Is "Is returns whether s is ASCII.\n" ^bool [^string s]
  (for [i 0] (< i (len s)) (inc! i)
    (when (> (aget s i) unicode/MaxASCII)
      (return false)))


  true)



^{:go/end 61} (go/func ToLower "ToLower returns the lowercase version of s if s is ASCII and printable.\n" [^string s] :results [^string lower ^bool ok]
  (when (not (IsPrint s))
    (return "" false))

  (return (strings/ToLower s) true))

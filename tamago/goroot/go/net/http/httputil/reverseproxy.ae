^{:go/end 60} (go/method SetURL "SetURL routes the outbound request to the scheme, host, and base path\nprovided in target. If the target's path is \"/base\" and the incoming\nrequest was for \"/dir\", the target request will be for \"/base/dir\".\nTo route requests without joining the incoming path,\nset r.Out.URL directly.\n\nSetURL rewrites the outbound Host header to match the target's host.\nTo preserve the inbound request's Host header (the default behavior\nof [NewSingleHostReverseProxy]):\n\n\trewriteFunc := func(r *httputil.ProxyRequest) {\n\t\tr.SetURL(url)\n\t\tr.Out.Host = r.In.Host\n\t}\n" [^{:tag (* ProxyRequest)} r ^{:tag (* url/URL)} target]
  (rewriteRequestURL (.-Out r) target)
  (set! (.-Host (.-Out r)) ""))





















^{:go/end 98} (go/method SetXForwarded "SetXForwarded sets the X-Forwarded-For, X-Forwarded-Host, and\nX-Forwarded-Proto headers of the outbound request.\n\n  - The X-Forwarded-For header is set to the client IP address.\n  - The X-Forwarded-Host header is set to the host name requested\n    by the client.\n  - The X-Forwarded-Proto header is set to \"http\" or \"https\", depending\n    on whether the inbound request was made on a TLS-enabled connection.\n\nIf the outbound request contains an existing X-Forwarded-For header,\nSetXForwarded appends the client IP address to it. To append to the\ninbound request's X-Forwarded-For header (the default behavior of\n[ReverseProxy] when using a Director function), copy the header\nfrom the inbound request before calling SetXForwarded:\n\n\trewriteFunc := func(r *httputil.ProxyRequest) {\n\t\tr.Out.Header[\"X-Forwarded-For\"] = r.In.Header[\"X-Forwarded-For\"]\n\t\tr.SetXForwarded()\n\t}\n" [^{:tag (* ProxyRequest)} r]
  (let [(values clientIP _ err) (net/SplitHostPort (.-RemoteAddr (.-In r)))]
    (if (== err nil)
      (let [prior (aget (.-Header (.-Out r)) "X-Forwarded-For")]
        (when (> (len prior) 0)
          (set! clientIP (+ (strings/Join prior ", ") ", " clientIP)))

        (.Set (.-Header (.-Out r)) "X-Forwarded-For" clientIP))

      (.Del (.-Header (.-Out r)) "X-Forwarded-For"))

    (.Set (.-Header (.-Out r)) "X-Forwarded-Host" (.-Host (.-In r)))
    (if (== (.-TLS (.-In r)) nil)
      (.Set (.-Header (.-Out r)) "X-Forwarded-Proto" "http")

      (.Set (.-Header (.-Out r)) "X-Forwarded-Proto" "https"))))
















(go/type ReverseProxy "ReverseProxy is an HTTP Handler that takes an incoming request and\nsends it to another server, proxying the response back to the\nclient.\n\n1xx responses are forwarded to the client if the underlying\ntransport supports ClientTrace.Got1xxResponse.\n\nHop-by-hop headers (see RFC 9110, section 7.6.1), including\nConnection, Proxy-Connection, Keep-Alive, Proxy-Authenticate,\nProxy-Authorization, TE, Trailer, Transfer-Encoding, and Upgrade,\nare removed from client requests and backend responses.\nThe Rewrite function may be used to add hop-by-hop headers to the request,\nand the ModifyResponse function may be used to remove them from the response.\n" (struct





















    ^{:line 135 :tag (func [(* ProxyRequest)]) :doc "Rewrite must be a function which modifies\nthe request into a new request to be sent\nusing Transport. Its response is then copied\nback to the original client unmodified.\nRewrite must not access the provided ProxyRequest\nor its contents after returning.\n\nThe Forwarded, X-Forwarded, X-Forwarded-Host,\nand X-Forwarded-Proto headers are removed from the\noutbound request before Rewrite is called. See also\nthe ProxyRequest.SetXForwarded method.\n\nUnparsable query parameters are removed from the\noutbound request before Rewrite is called.\nThe Rewrite function may copy the inbound URL's\nRawQuery to the outbound URL to preserve the original\nparameter string. Note that this can lead to security\nissues if the proxy's interpretation of query parameters\ndoes not match that of the downstream server.\n\nAt most one of Rewrite or Director may be set.\n"} Rewrite



    ^{:line 139 :tag http/RoundTripper :doc "The transport used to perform proxy requests.\nIf nil, http.DefaultTransport is used.\n"} Transport











    ^{:line 151 :tag time/Duration :doc "FlushInterval specifies the flush interval\nto flush to the client while copying the\nresponse body.\nIf zero, no periodic flushing is done.\nA negative value means to flush immediately\nafter each write to the client.\nThe FlushInterval is ignored when ReverseProxy\nrecognizes a response as a streaming response, or\nif its ContentLength is -1; for such responses, writes\nare flushed to the client immediately.\n"} FlushInterval




    ^{:line 156 :tag (* log/Logger) :doc "ErrorLog specifies an optional logger for errors\nthat occur when attempting to proxy the request.\nIf nil, logging is done via the log package's standard logger.\n"} ErrorLog




    ^{:line 161 :tag BufferPool :doc "BufferPool optionally specifies a buffer pool to\nget byte slices for use by io.CopyBuffer when\ncopying HTTP response bodies.\n"} BufferPool














    ^{:line 176 :tag (func [(* http/Response)] [error]) :doc "ModifyResponse is an optional function that modifies the\nResponse from the backend. It is called if the backend\nreturns a response at all, with any HTTP status code.\nIf the backend is unreachable, the optional ErrorHandler is\ncalled without any call to ModifyResponse.\n\nHop-by-hop headers are removed from the response before\ncalling ModifyResponse. ModifyResponse may need to remove\nadditional headers to fit its deployment model, such as Alt-Svc.\n\nIf ModifyResponse returns an error, ErrorHandler is called\nwith its error value. If ErrorHandler is nil, its default\nimplementation is used.\n"} ModifyResponse






    ^{:line 183 :tag (func [http/ResponseWriter (* http/Request) error]) :doc "ErrorHandler is an optional function that handles errors\nreaching the backend or errors from ModifyResponse.\n\nIf nil, the default is to log the provided error and return\na 502 Status Bad Gateway response.\n"} ErrorHandler

















































































    ^{:line 265 :tag (func [(* http/Request)]) :doc "Director is deprecated. Use Rewrite instead.\n\nThis function is insecure:\n\n  - Hop-by-hop headers are removed from the request after Director\n    returns, which can remove headers added by Director.\n    A client can designate headers as hop-by-hop by listing them\n    in the Connection header, so this permits a malicious client\n    to remove any headers that may be added by Director.\n\n  - X-Forwarded-For, X-Forwarded-Host, and X-Forwarded-Proto\n    headers in inbound requests are preserved by default,\n    which can permit IP spoofing if the Director function is\n    not careful to remove these headers.\n\nRewrite addresses these issues.\n\nAs an example of converting a Director function to Rewrite:\n\n\t// ReverseProxy with a Director function.\n\tproxy := &httputil.ReverseProxy{\n\t\tDirector: func(req *http.Request) {\n\t\t\treq.URL.Scheme = \"https\"\n\t\t\treq.URL.Host = proxyHost\n\n\t\t\t// A malicious client can remove this header.\n\t\t\treq.Header.Set(\"Some-Header\", \"some-header-value\")\n\n\t\t\t// X-Forwarded-* headers sent by the client are preserved,\n\t\t\t// since Director did not remove them.\n\t\t},\n\t}\n\n\t// ReverseProxy with a Rewrite function.\n\tproxy := &httputil.ReverseProxy{\n\t\tRewrite: func(preq *httputil.ProxyRequest) {\n\t\t\t// See also ProxyRequest.SetURL.\n\t\t\tpreq.Out.URL.Scheme = \"https\"\n\t\t\tpreq.Out.URL.Host = proxyHost\n\n\t\t\t// This header cannot be affected by a malicious client.\n\t\t\tpreq.Out.Header.Set(\"Some-Header\", \"some-header-value\")\n\n\t\t\t// X-Forwarded- headers sent by the client have been\n\t\t\t// removed from preq.Out.\n\t\t\t// ProxyRequest.SetXForwarded optionally adds new ones.\n\t\t\tpreq.SetXForwarded()\n\t\t},\n\t}\n\nDirector is a function which modifies\nthe request into a new request to be sent\nusing Transport. Its response is then copied\nback to the original client unmodified.\nDirector must not access the provided Request\nafter returning.\n\nBy default, the X-Forwarded-For header is set to the\nvalue of the client IP address. If an X-Forwarded-For\nheader already exists, the client IP is appended to the\nexisting values. As a special case, if the header\nexists in the Request.Header map but has a nil value\n(such as when set by the Director func), the X-Forwarded-For\nheader is not modified.\n\nTo prevent IP spoofing, be sure to delete any pre-existing\nX-Forwarded-For header coming from the client or\nan untrusted proxy.\n\nHop-by-hop headers are removed from the request after\nDirector returns, which can remove headers added by\nDirector. Use a Rewrite function instead to ensure\nmodifications to the request are preserved.\n\nUnparsable query parameters are removed from the outbound\nrequest if Request.Form is set after Director returns.\n\nAt most one of Rewrite or Director may be set.\n\nDeprecated: Use Rewrite instead.\n"} Director))





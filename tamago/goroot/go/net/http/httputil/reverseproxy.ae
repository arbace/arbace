  (when (and (== (.-RawPath a) "") (== (.-RawPath b) ""))
    (return (singleJoiningSlash (.-Path a) (.-Path b)) ""))

  ;; Same as singleJoiningSlash, but uses EscapedPath to determine
  ;; whether a slash should be added
  (let [apath (.EscapedPath a)
      ^{:line 294} bpath (.EscapedPath b)

      ^{:line 296} aslash (strings/HasSuffix apath "/")
      ^{:line 297} bslash (strings/HasPrefix bpath "/")]

    (switch
      (case [(and aslash bslash)]
        (return (+ (.-Path a) (subslice (.-Path b) 1)) (+ apath (subslice bpath 1))))
      (case [(and (not aslash) (not bslash))]
        (return (+ (.-Path a) "/" (.-Path b)) (+ apath "/" bpath))))

    (return (+ (.-Path a) (.-Path b)) (+ apath bpath))))


























^{:go/end 337} (go/func NewSingleHostReverseProxy "NewSingleHostReverseProxy returns a new [ReverseProxy] that routes\nURLs to the scheme, host, and base path provided in target. If the\ntarget's path is \"/base\" and the incoming request was for \"/dir\",\nthe target request will be for /base/dir.\n\nNewSingleHostReverseProxy does not rewrite the Host header.\n\nFor backwards compatibility reasons, NewSingleHostReverseProxy\nreturns a ReverseProxy using the deprecated Director function.\nThis proxy preserves X-Forwarded-* headers sent by the client.\n\nTo customize the ReverseProxy behavior beyond what\nNewSingleHostReverseProxy provides, use ReverseProxy directly\nwith a Rewrite function. The ProxyRequest SetURL method\nmay be used to route the outbound request. (Note that SetURL,\nunlike NewSingleHostReverseProxy, rewrites the Host header\nof the outbound request by default.)\n\n\tproxy := &ReverseProxy{\n\t\tRewrite: func(r *ProxyRequest) {\n\t\t\tr.SetURL(target)\n\t\t\tr.Out.Host = r.In.Host // if desired\n\t\t},\n\t}\n" ^{:tag (* ReverseProxy)} [^{:tag (* url/URL)} target]
  (let [director ^{:go/end 335} (fn [^{:tag (* http/Request)} req]

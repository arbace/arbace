^{:go/end 285} (go/func singleJoiningSlash ^string [^string a ^string b]
  (let [aslash (strings/HasSuffix a "/")
      ^{:line 277} bslash (strings/HasPrefix b "/")]
    (switch
      (case [(and aslash bslash)]
        (return (+ a (subslice b 1))))
      (case [(and (not aslash) (not bslash))]
        (return (+ a "/" b))))

    (+ a b)))



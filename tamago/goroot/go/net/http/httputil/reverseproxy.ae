  ;; RFC 7230, section 6.1: Remove headers listed in the "Connection" header.
  (range [_ f (aget h "Connection")]
    (range [sf (strings/SplitSeq f ",")]
      (when [(set! sf (textproto/TrimString sf))] (!= sf "")
        (.Del h sf))))




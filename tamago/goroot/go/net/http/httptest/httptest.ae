;; Package httptest provides utilities for HTTP testing.
(in-ns 'go.net.http.httptest) (go/file "httptest.go" :doc "Package httptest provides utilities for HTTP testing.\n" :imports [


    ^{:line 9} [bufio "bufio"]
    ^{:line 10} [bytes "bytes"]
    ^{:line 11} [context "context"]
    ^{:line 12} [tls "crypto/tls"]
    ^{:line 13} [io "io"]
    ^{:line 14} [http "net/http"]
    ^{:line 15} [strings "strings"]])



^{:go/end 21} (go/func NewRequest "NewRequest wraps NewRequestWithContext using context.Background.\n" ^{:tag (* http/Request)} [^string method ^string target ^io/Reader body]
  (NewRequestWithContext (context/Background) method target body))

























^{:go/end 100} (go/func NewRequestWithContext "NewRequestWithContext returns a new incoming server Request, suitable\nfor passing to an [http.Handler] for testing.\n\nThe target is the RFC 7230 \"request-target\": it may be either a\npath or an absolute URL. If target is an absolute URL, the host name\nfrom the URL is used. Otherwise, \"example.com\" is used.\n\nThe TLS field is set to a non-nil dummy value if target has scheme\n\"https\".\n\nThe Request.Proto is always HTTP/1.1.\n\nAn empty method means \"GET\".\n\nThe provided body may be nil. If the body is of type [bytes.Reader],\n[strings.Reader], [bytes.Buffer], or the value [http.NoBody],\nthe Request.ContentLength is set.\n\nNewRequest panics on error for ease of use in testing, where a\npanic is acceptable.\n\nTo generate a client HTTP request instead of a server request, see\nthe NewRequest function in the net/http package.\n" ^{:tag (* http/Request)} [^context/Context ctx ^string method ^string target ^io/Reader body]
  (when (== method "")
    (set! method "GET"))

  (let [(values req err) (http/ReadRequest (bufio/NewReader (strings/NewReader (+ method " " target " HTTP/1.0\r\n\r\n"))))]
    (when (!= err nil)
      (panic (+ "invalid NewRequest arguments; " (.Error err))))

    (set! req (.WithContext req ctx))

    ;; HTTP/1.0 was used above to avoid needing a Host field. Change it to 1.1 here.
    (set! (.-Proto req) "HTTP/1.1")
    (set! (.-ProtoMinor req) 1)
    (set! (.-Close req) false)

    (when (!= body nil)
      (type-switch [v body]
        (case [(* bytes/Buffer)]
          (set! (.-ContentLength req) (conv int64 (.Len v))))
        (case [(* bytes/Reader)]
          (set! (.-ContentLength req) (conv int64 (.Len v))))
        (case [(* strings/Reader)]
          (set! (.-ContentLength req) (conv int64 (.Len v))))
        (default
          (set! (.-ContentLength req) -1)))

      (when (== body http/NoBody)
        (set! (.-ContentLength req) 0))

      (if [(values rc ok) (assert io/ReadCloser body)] ok
        (set! (.-Body req) rc)

        (set! (.-Body req) (io/NopCloser body))))



    ;; 192.0.2.0/24 is "TEST-NET" in RFC 5737 for use solely in
    ;; documentation and example source code and should not be
    ;; used publicly.
    (set! (.-RemoteAddr req) "192.0.2.1:1234")

    (when (== (.-Host req) "")
      (set! (.-Host req) "example.com"))


    (when (strings/HasPrefix target "https://")
      (set! (.-TLS req) (addr ^{:go/breaks [2 4 6]} (lit tls/ConnectionState
            :Version tls/VersionTLS12
            :HandshakeComplete true
            :ServerName (.-Host req)))))



    ^{:line 99} req))

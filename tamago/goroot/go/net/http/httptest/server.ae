^{:go/end 525} (go/method Close "Close shuts down the server and blocks until all outstanding\nrequests on this server have completed.\n" [^{:tag (* Server)} s]
  (.Lock (.-mu s))
  (when (not (.-closed s))
    (set! (.-closed s) true)
    (when (!= (.-Listener s) nil)
      (.Close (.-Listener s)))

    (when (!= (.-fakeListener s) nil)
      (.Close (.-fakeListener s))
      (.Close (.-fakeTLSListener s)))

    (.SetKeepAlivesEnabled (.-Config s) false)
    (range [c st (.-conns s)]
      ;; Force-close any idle connections (those between
      ;; requests) and new connections (those which connected
      ;; but never sent a request). StateNew connections are
      ;; super rare and have only been seen (in
      ;; previously-flaky tests) in the case of
      ;; socket-late-binding races from the http Client
      ;; dialing this server and then getting an idle
      ;; connection before the dial completed. There is thus
      ;; a connected connection in StateNew with no
      ;; associated Request. We only close StateIdle and
      ;; StateNew because they're not doing anything. It's
      ;; possible StateNew is about to do something in a few
      ;; milliseconds, but a previous CL to check again in a
      ;; few milliseconds wasn't liked (early versions of
      ;; https://golang.org/cl/15151) so now we just
      ;; forcefully close StateNew. The docs for Server.Close say
      ;; we wait for "outstanding requests", so we don't close things
      ;; in StateActive.
      (when (or (== st http/StateIdle) (== st http/StateNew))
        (.closeConn s c)))


    ;; If this server doesn't shut down in 5 seconds, tell the user why.
    (let [t (time/AfterFunc (* 5 time/Second) (.-logCloseHangDebugInfo s))]
      (defer (.Stop t))))

  (.Unlock (.-mu s))

  ;; Not part of httptest.Server's correctness, but assume most
  ;; users of httptest.Server will be using the standard
  ;; transport, so help them out and close any idle connections for them.
  (when [(values t ok) (assert closeIdleTransport http/DefaultTransport)] ok
    (.CloseIdleConnections t))


  ;; Also close the client idle connections.
  (when (!= (.-client s) nil)
    (when [(values t ok) (assert closeIdleTransport (.-Transport (.-client s)))] ok
      (.CloseIdleConnections t)))


  (.Wait (.-wg s)))


^{:go/end 536} (go/method logCloseHangDebugInfo [^{:tag (* Server)} s]
  (.Lock (.-mu s))
  (defer (.Unlock (.-mu s)))
  (let [^strings/Builder buf (zero strings/Builder)]
    (.WriteString buf "httptest.Server blocked in Close after 5 seconds, waiting for connections:\n")
    (range [c st (.-conns s)]
      (fmt/Fprintf (addr buf) "  %T %p %v in state %v\n" c c (.RemoteAddr c) st))

    (log/Print (.String buf))))



^{:go/end 564} (go/method CloseClientConnections "CloseClientConnections closes any open HTTP connections to the test Server.\n" [^{:tag (* Server)} s]
  (.Lock (.-mu s))
  (let [nconn (len (.-conns s))
      ^{:line 542} ch (make (chan (struct)) nconn)]
    (range [c (.-conns s)]
      (go (.closeConnChan s c ch)))

    (.Unlock (.-mu s))

    ;; Wait for outstanding closes to finish.
    ;;
    ;; Out of paranoia for making a late change in Go 1.6, we
    ;; bound how long this can wait, since golang.org/issue/14291
    ;; isn't fully understood yet. At least this should only be used
    ;; in tests.
    (let [timer (time/NewTimer (* 5 time/Second))]
      (defer (.Stop timer))
      (for [i 0] (< i nconn) (inc! i)
        (select
          (case (<! ch))
          (case (<! (.-C timer))
            ;; Too slow. Give up.
            (return)))))))







                ((.-DNSDone trace) ^{:go/breaks [2 4 6]} (lit DNSDoneInfo
                    :Addrs addrs
                    :Coalesced coalesced
                    :Err err))))))



        (set! ctx (context/WithValue ctx (lit nettrace/TraceKey) nt))))


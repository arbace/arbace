^{:go/end 67} (go/func WithClientTrace "WithClientTrace returns a new context based on the provided parent\nctx. HTTP client requests made with the returned context will use\nthe provided trace hooks, in addition to any previous hooks\nregistered with ctx. Any hooks defined in the provided trace will\nbe called first.\n" ^context/Context [^context/Context ctx ^{:tag (* ClientTrace)} trace]
  (when (== trace nil)
    (panic "nil trace"))

  (let [old (ContextClientTrace ctx)]
    (.compose trace old)

    (set! ctx (context/WithValue ctx (lit clientEventContextKey) trace))
    (when (.hasNetHooks trace)
      (let [nt (addr ^{:go/breaks [2 4]} (lit nettrace/Trace
              :ConnectStart (.-ConnectStart trace)
              :ConnectDone (.-ConnectDone trace)))]

        (when (!= (.-DNSStart trace) nil)
          (set! (.-DNSStart nt) ^{:go/end 49} (fn [^string name]
              ((.-DNSStart trace) (lit DNSStartInfo :Host name)))))


        (when (!= (.-DNSDone trace) nil)
          (set! (.-DNSDone nt) ^{:go/end 62} (fn [^{:tag (slice any)} netIPs ^bool coalesced ^error err]
              (let [addrs (make (slice net/IPAddr) (len netIPs))]

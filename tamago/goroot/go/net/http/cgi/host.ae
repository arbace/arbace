  (when (and (> (len (.-TransferEncoding req)) 0) (== (aget (.-TransferEncoding req) 0) "chunked"))
    (.WriteHeader rw http/StatusBadRequest)
    (.Write rw (conv (slice byte) "Chunked request bodies are not supported by CGI."))
    (return))


  (let [root (strings/TrimRight (.-Root h) "/")
      ^{:line 125} pathInfo (strings/TrimPrefix (.-Path (.-URL req)) root)

      ^{:line 127} port "80"]
    (when (!= (.-TLS req) nil)
      (set! port "443"))

    (when [matches (.FindStringSubmatch trailingPort (.-Host req))] (!= (len matches) 0)
      (set! port (aget matches 1)))



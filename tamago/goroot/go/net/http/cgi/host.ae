^{:go/end 391} (go/method handleInternalRedirect [^{:tag (* Handler)} h ^http/ResponseWriter rw ^{:tag (* http/Request)} req ^string path]
  (let [(values url err) (.Parse (.-URL req) path)]
    (when (!= err nil)
      (.WriteHeader rw http/StatusInternalServerError)
      (.printf h "cgi: error resolving local URI path %q: %v" path err)
      (return))

    ;; TODO: RFC 3875 isn't clear if only GET is supported, but it
    ;; suggests so: "Note that any message-body attached to the
    ;; request (such as for a POST request) may not be available
    ;; to the resource that is the target of the redirect."  We
    ;; should do some tests against Apache to see how it handles
    ;; POST, HEAD, etc. Does the internal redirect get the same
    ;; method or just GET? What about incoming headers?
    ;; (e.g. Cookies) Which headers, if any, are copied into the
    ;; second request?

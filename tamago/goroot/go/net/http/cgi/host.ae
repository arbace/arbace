          (set! env (append env (+ "HTTP_" k "=" (strings/Join v joinStr))))))


      (when (> (.-ContentLength req) 0)
        (set! env (append env (fmt/Sprintf "CONTENT_LENGTH=%d" (.-ContentLength req)))))

      (when [ctype (.Get (.-Header req) "Content-Type")] (!= ctype "")
        (set! env (append env (+ "CONTENT_TYPE=" ctype))))


      (let [envPath (os/Getenv "PATH")]
        (when (== envPath "")
          (set! envPath "/bin:/usr/bin:/usr/ucb:/usr/bsd:/usr/local/bin"))

        (set! env (append env (+ "PATH=" envPath)))

        (range [_ e (.-InheritEnv h)]
          (when [v (os/Getenv e)] (!= v "")
            (set! env (append env (+ e "=" v)))))



        (range [_ e osDefaultInheritEnv]
          (when [v (os/Getenv e)] (!= v "")
            (set! env (append env (+ e "=" v)))))



        (when (!= (.-Env h) nil)
          (set! env (append env (spread (.-Env h)))))



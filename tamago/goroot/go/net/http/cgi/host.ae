            :Method "GET"
            :URL url
            :Proto "HTTP/1.1"
            :ProtoMajor 1
            :ProtoMinor 1
            :Header (make http/Header)
            :Host (.-Host url)
            :RemoteAddr (.-RemoteAddr req)
            :TLS (.-TLS req)))]


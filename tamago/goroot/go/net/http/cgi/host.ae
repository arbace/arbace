          (+ "REQUEST_METHOD=" (.-Method req))
          (+ "QUERY_STRING=" (.-RawQuery (.-URL req)))
          (+ "REQUEST_URI=" (.RequestURI (.-URL req)))
          (+ "PATH_INFO=" pathInfo)
          (+ "SCRIPT_NAME=" root)

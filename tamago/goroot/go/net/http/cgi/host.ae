;; This file implements the host side of CGI (being the webserver
;; parent process).

;; Package cgi implements CGI (Common Gateway Interface) as specified
;; in RFC 3875.
;;
;; Note that using CGI means starting a new process to handle each
;; request, which is typically less efficient than using a
;; long-running server. This package is intended primarily for
;; compatibility with existing systems.
(in-ns 'go.net.http.cgi) (go/file "host.go" :doc "Package cgi implements CGI (Common Gateway Interface) as specified\nin RFC 3875.\n\nNote that using CGI means starting a new process to handle each\nrequest, which is typically less efficient than using a\nlong-running server. This package is intended primarily for\ncompatibility with existing systems.\n" :imports [


    ^{:line 18} [bufio "bufio"]
    ^{:line 19} [fmt "fmt"]
    ^{:line 20} [io "io"]
    ^{:line 21} [log "log"]
    ^{:line 22} [net "net"]
    ^{:line 23} [http "net/http"]
    ^{:line 24} [textproto "net/textproto"]
    ^{:line 25} [os "os"]
    ^{:line 26} [exec "os/exec"]
    ^{:line 27} [filepath "path/filepath"]
    ^{:line 28} [regexp "regexp"]
    ^{:line 29} [runtime "runtime"]
    ^{:line 30} [strconv "strconv"]
    ^{:line 31} [strings "strings"]

    ^{:line 33} [httpguts "golang.org/x/net/http/httpguts"]])


(go/var trailingPort (regexp/MustCompile ":([0-9]+)$"))

(go/var osDefaultInheritEnv (^{:go/breaks [[3 53]] :go/end 54} (fn ^{:tag (slice string)} []
      (switch runtime/GOOS
        (case ["darwin" "ios"]
          (return (lit (slice string) "DYLD_LIBRARY_PATH")))
        (case ["android" "linux" "freebsd" "netbsd" "openbsd"]
          (return (lit (slice string) "LD_LIBRARY_PATH")))
        (case ["hpux"]
          (return (lit (slice string) "LD_LIBRARY_PATH" "SHLIB_PATH")))
        (case ["irix"]
          (return (lit (slice string) "LD_LIBRARY_PATH" "LD_LIBRARYN32_PATH" "LD_LIBRARY64_PATH")))
        (case ["illumos" "solaris"]
          (return (lit (slice string) "LD_LIBRARY_PATH" "LD_LIBRARY_PATH_32" "LD_LIBRARY_PATH_64")))
        (case ["windows"]
          (return (lit (slice string) "SystemRoot" "COMSPEC" "PATHEXT" "WINDIR"))))

      nil)))



(go/type Handler "Handler runs an executable in a subprocess with a CGI environment.\n" (struct
    ^{:line 58 :tag string} Path ; path to the CGI executable
    ^{:line 59 :tag string} Root ; root URI prefix of handler or empty for "/"





    ^{:line 65 :tag string :doc "Dir specifies the CGI executable's working directory.\nIf Dir is empty, the base directory of Path is used.\nIf Path has no base directory, the current working\ndirectory is used.\n"} Dir

    ^{:line 67 :tag (slice string)} Env ; extra environment variables to set, if any, as "key=value"
    ^{:line 68 :tag (slice string)} InheritEnv ; environment variables to inherit from host, as "key"
    ^{:line 69 :tag (* log/Logger)} Logger ; optional log for errors or nil to use log.Print
    ^{:line 70 :tag (slice string)} Args ; optional arguments to pass to child process
    ^{:line 71 :tag io/Writer} Stderr ; optional stderr for the child process; nil means os.Stderr









    ^{:line 81 :tag http/Handler :doc "PathLocationHandler specifies the root http Handler that\nshould handle internal redirects when the CGI process\nreturns a Location header value starting with a \"/\", as\nspecified in RFC 3875 § 6.3.2. This will likely be\nhttp.DefaultServeMux.\n\nIf nil, a CGI response with a local URI path is instead sent\nback to the client and not redirected internally.\n"} PathLocationHandler))


^{:go/end 89} (go/method stderr ^io/Writer [^{:tag (* Handler)} h]
  (when (!= (.-Stderr h) nil)
    (return (.-Stderr h)))

  ^{:line 88} os/Stderr)









^{:go/end 115} (go/func removeLeadingDuplicates "removeLeadingDuplicates remove leading duplicate in environments.\nIt's possible to override environment like following.\n\n\tcgi.Handler{\n\t  ...\n\t  Env: []string{\"SCRIPT_FILENAME=foo.php\"},\n\t}\n" [^{:tag (slice string)} env] :results [^{:tag (slice string)} ret]
  (range [i e env]
    (let [found false]
      (when [eq (strings/IndexByte e \=)] (!= eq -1)
        (let [keq (subslice e _ (+ eq 1))] ; "key="
          (range [_ e2 (subslice env (+ i 1))]
            (when (strings/HasPrefix e2 keq)
              (set! found true)
              (break)))))



      (when (not found)
        (set! ret (append ret e)))))


  (return))



(ns go.net.http.httputil
  (:require [arbace.go :as go]))

(go/package httputil
  :path "net/http/httputil"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["dump.go" "httputil.go" "persist.go" "reverseproxy.go"]
  :init-order [reqWriteExcludeHeaderDump errNoBody emptyBody ErrLineTooLong ErrPersistEOF ErrClosed ErrPipeline errClosed hopHeaders errCopyDone urlmaxqueryparams]
  :positions :lines)

(load "httputil/dump")
(load "httputil/httputil")
(load "httputil/persist")
(load "httputil/reverseproxy")

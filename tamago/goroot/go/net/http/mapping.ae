(in-ns 'go.net.http) (go/file "mapping.go" :imports [])




(go/type mapping "A mapping is a collection of key-value pairs where the keys are unique.\nA zero mapping is empty and ready to use.\nA mapping tries to pick a representation that makes [mapping.find] most efficient.\n" :type-params [^comparable K V] (struct
    ^{:line 11 :tag (slice (entry K V))} s ; for few pairs
    ^{:line 12 :tag (map K V)} m)) ; for many pairs


(go/type entry :type-params [^comparable K V] (struct
    ^{:line 16 :tag K} key
    ^{:line 17 :tag V} value))




(go/var ^{:tag int :doc "maxSlice is the maximum number of pairs for which a slice is used.\nIt is a variable for benchmarking.\n"} maxSlice 8)


^{:go/end 38} (go/method add "add adds a key-value pair to the mapping.\n" [^{:tag (* (mapping K V))} h ^K k ^V v]
  (if (and (== (.-m h) nil) (< (len (.-s h)) maxSlice))
    (set! (.-s h) (append (.-s h) (lit (entry K V) k v)))
    (do
      (when (== (.-m h) nil)
        (set! (.-m h) (lit (map K V)))
        (range [_ e (.-s h)]
          (aset (.-m h) (.-key e) (.-value e)))

        (set! (.-s h) nil))

      (aset (.-m h) k v))))






^{:go/end 57} (go/method find "find returns the value corresponding to the given key.\nThe second return value is false if there is no value\nwith that key.\n" [^{:tag (* (mapping K V))} h ^K k] :results [^V v ^bool found]
  (when (== h nil)
    (return v false))

  (when (!= (.-m h) nil)
    (set! (values v found) (aget (.-m h) k))
    (return v found))

  (range [_ e (.-s h)]
    (when (== (.-key e) k)
      (return (.-value e) true)))


  (return v false))




^{:go/end 78} (go/method eachPair "eachPair calls f for each pair in the mapping.\nIf f returns false, pairs returns immediately.\n" [^{:tag (* (mapping K V))} h ^{:tag (func [^K k ^V v] [bool])} f]
  (when (== h nil)
    (return))

  (if (!= (.-m h) nil)
    (range [k v (.-m h)]
      (when (not (f k v))
        (return)))



    (range [_ e (.-s h)]
      (when (not (f (.-key e) (.-value e)))
        (return)))))

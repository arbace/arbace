        (continue))

      (let [(values fi err) (stat (strings/Join (subslice parts _ (+ i 1)) (conv string sep)))]
        (when (!= err nil)
          (return originalErr))

        (when (not (.IsDir fi))
          (return fs/ErrNotExist))))


    ^{:line 68} originalErr))






(in-ns 'go.net.http) (go/file "method.go" :imports [])




(go/const "Common HTTP methods.\n\nUnless otherwise noted, these are defined in RFC 7231 section 4.3.\n"
  ^{:line 11} [^{:val "GET"} MethodGet "GET"]
  ^{:line 12} [^{:val "HEAD"} MethodHead "HEAD"]
  ^{:line 13} [^{:val "POST"} MethodPost "POST"]
  ^{:line 14} [^{:val "PUT"} MethodPut "PUT"]
  ^{:line 15} [^{:val "PATCH"} MethodPatch "PATCH"] ; RFC 5789
  ^{:line 16} [^{:val "DELETE"} MethodDelete "DELETE"]
  ^{:line 17} [^{:val "CONNECT"} MethodConnect "CONNECT"]
  ^{:line 18} [^{:val "OPTIONS"} MethodOptions "OPTIONS"]
  ^{:line 19} [^{:val "TRACE"} MethodTrace "TRACE"])

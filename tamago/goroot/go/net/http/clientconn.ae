(go/type ClientConn "A ClientConn is a client connection to an HTTP server.\n\nUnlike a [Transport], a ClientConn represents a single connection.\nMost users should use a Transport rather than creating client connections directly.\n" (struct
    ^{:line 22 :tag genericClientConn} cc

    ^{:line 24 :tag sync/Mutex} stateHookMu
    ^{:line 25 :tag (func [(* ClientConn)])} userStateHook
    ^{:line 26 :tag bool} stateHookRunning
    ^{:line 27 :tag int} lastAvailable
    ^{:line 28 :tag int} lastInFlight
    ^{:line 29 :tag bool} lastClosed))
















(go/type newClientConner "newClientConner is the interface implemented by HTTP/2 transports to create new client conns.\n\nThe http package (this package) needs a way to ask the http2 package to\ncreate a client connection.\n\nTransport.TLSNextProto[\"h2\"] contains a function which appears to do this,\nbut for historical reasons it does not: The TLSNextProto function adds a\n*tls.Conn to the http2.Transport's connection pool and returns a RoundTripper\nwhich is backed by that connection pool. NewClientConn needs a way to get a\nsingle client connection out of the http2 package.\n\nThe http2 package registers a RoundTripper with Transport.RegisterProtocol.\nIf this RoundTripper implements newClientConner, then Transport.NewClientConn will use\nit to create new HTTP/2 client connections.\n" (interface





























    (^{:doc "NewClientConn creates a new client connection from a net.Conn.\n\nThe RoundTripper returned by NewClientConn must implement genericClientConn.\n(We don't define NewClientConn as returning genericClientConn,\nbecause either we'd need to make genericClientConn an exported type\nor define it as a type alias. Neither is particularly appealing.)\n\nThe state hook passed here is the internal state hook\n(ClientConn.maybeRunStateHook). The internal state hook calls\nthe user state hook (if any), which is set by the user with\nClientConn.SetStateHook.\n\nThe client connection should arrange to call the internal state hook\nwhen the connection closes, when requests complete, and when the\nconnection concurrency limit changes.\n\nThe client connection must call the internal state hook when the connection state\nchanges asynchronously, such as when a request completes.\n\nThe internal state hook need not be called after synchronous changes to the state:\nClose, Reserve, Release, and RoundTrip calls which don't start a request\ndo not need to call the hook.\n\nThe general idea is that if we call (for example) Close,\nwe know that the connection state has probably changed and we\ndon't need the state hook to tell us that.\nHowever, if the connection closes asynchronously\n(because, for example, the other end of the conn closed it),\nthe state hook needs to inform us.\n"} NewClientConn [^net/Conn nc ^{:tag (func [])} internalStateHook] :results [RoundTripper error])))






(go/type genericClientConn "genericClientConn is an interface implemented by HTTP/2 client conns\nreturned from newClientConner.NewClientConn.\n\nSee the newClientConner doc comment for more information.\n" (interface
    (Close ^error [])
    (Err ^error [])
    (RoundTrip [^{:tag (* Request)} req] :results [(* Response) error])
    (Reserve ^error [])
    (Release [])
    (Available ^int [])
    (InFlight ^int [])))






















^{:go/end 206} (go/method NewClientConn "NewClientConn creates a new client connection to the given address.\n\nIf scheme is \"http\", the connection is unencrypted.\nIf scheme is \"https\", the connection uses TLS.\n\nThe protocol used for the new connection is determined by the scheme,\nTransport.Protocols configuration field, and protocols supported by the\nserver. See Transport.Protocols for more details.\n\nIf Transport.Proxy is set and indicates that a request sent to the given\naddress should use a proxy, the new connection uses that proxy.\n\nNewClientConn always creates a new connection,\neven if the Transport has an existing cached connection to the given host.\n\nThe new connection is not added to the Transport's connection cache,\nand will not be used by [Transport.RoundTrip].\nIt does not count against the MaxIdleConns and MaxConnsPerHost limits.\n\nThe caller is responsible for closing the new connection.\n" [^{:tag (* Transport)} t ^context/Context ctx ^string scheme ^string address] :results [(* ClientConn) error]
  (.Do (.-nextProtoOnce t) (.-onceSetNextProtoDefaults t))

  (when (!= (.-h2Config t) nil)
    ;; Handle x/net/http2.Transport.NewClientConn passing us a net.Conn
    ;; to create a ClientConn from.
    (when [(values cc err) (.http2NewClientConnFromContext t ctx)] (!= err errors/ErrUnsupported)
      (return cc err)))



  (switch scheme
    (case ["http" "https"])
    (default
      (return nil (fmt/Errorf "net/http: invalid scheme %q" scheme))))


  (let [(values host port err) (net/SplitHostPort address)]
    (when (!= err nil)
      (return nil err))

    (when (== port "")
      (set! port (schemePort scheme)))


    (let [^{:tag (* url/URL)} proxyURL (zero (* url/URL))]
      (when (!= (.-Proxy t) nil)
        ;; Transport.Proxy takes a *Request, so create a fake one to pass it.
        (let [req (addr ^{:go/breaks [2 4 6 [8 149] 10 12 14 16 18]} (lit Request
                :ctx ctx
                :Method "GET"
                :URL (addr ^{:go/breaks [2 4 6]} (lit url/URL
                    :Scheme scheme
                    :Host host
                    :Path "/"))

                :Proto "HTTP/1.1"
                :ProtoMajor 1
                :ProtoMinor 1
                :Header (make Header)
                :Body NoBody
                :Host host))

            ^{:line 156 :tag error} err (zero error)]
          (set! (values proxyURL err) ((.-Proxy t) req))
          (when (!= err nil)
            (return nil err))))



      (let [cm ^{:go/breaks [2 4 6]} (lit connectMethod
            :targetScheme scheme
            :targetAddr (net/JoinHostPort host port)
            :proxyURL proxyURL)


          ;; The state hook is a bit tricky:
          ;; The persistConn has a state hook which calls ClientConn.maybeRunStateHook,
          ;; which in turn calls the user-provided state hook (if any).
          ;;
          ;; ClientConn.maybeRunStateHook handles debouncing hook calls for both
          ;; HTTP/1 and HTTP/2.
          ;;
          ;; Since there's no need to change the persistConn's hook, we set it at creation time.
          ^{:line 177} cc (addr (lit ClientConn))
          ^:const ^{:line 178 :val true} isClientConn true
          (values pconn ^:assign err) (.dialConn t ctx cm isClientConn (.-maybeRunStateHook cc))]
        (when (!= err nil)
          (return nil err))


        ;; Note that cc.maybeRunStateHook may have been called
        ;; in the short window between dialConn and now.
        ;; This is fine.
        (.Lock (.-stateHookMu cc))
        (defer (.Unlock (.-stateHookMu cc)))
        (if (!= (.-alt pconn) nil)
          ;; If pconn.alt is set, this is a connection implemented in another package
          ;; (probably x/net/http2) or the bundled copy in h2_bundle.go.
          (let [(values gc ok) (assert genericClientConn (.-alt pconn))]
            (when (not ok)
              (return nil (errors/New "http: NewClientConn returned something that is not a ClientConn")))

            (set! (.-cc cc) gc)
            (set! (.-lastAvailable cc) (.Available gc)))
          (do
            ;; This is an HTTP/1 connection.
            (set! (.-availch pconn) (make (chan (struct)) 1))
            (>! (.-availch pconn) (lit (struct)))
            (set! (.-cc cc) (lit http1ClientConn pconn))
            (set! (.-lastAvailable cc) 1)))

        (return cc nil)))))




^{:go/end 213} (go/method Close "Close closes the connection.\nOutstanding RoundTrip calls are interrupted.\n" ^error [^{:tag (* ClientConn)} cc]
  (defer (.maybeRunStateHook cc))

^{:go/end 304} (go/method Reserve "Reserve reserves a concurrency slot on the connection.\nIf Reserve returns nil, one additional RoundTrip call may be made\nwithout waiting for an existing request to complete.\n\nThe reserved concurrency slot is accounted as an in-flight request.\nA successful call to RoundTrip will decrement the Available count\nand increment the InFlight count.\n\nEach successful call to Reserve should be followed by exactly one call\nto RoundTrip or Release, which will consume or release the reservation.\n\nIf the connection is closed or at its concurrency limit,\nReserve returns an error.\n" ^error [^{:tag (* ClientConn)} cc]
  (defer (.maybeRunStateHook cc))
  (.Reserve (.-cc cc)))




^{:go/end 311} (go/method Release "Release releases an unused concurrency slot reserved by Reserve.\nIf there are no reserved concurrency slots, it has no effect.\n" [^{:tag (* ClientConn)} cc]
  (defer (.maybeRunStateHook cc))
  (.Release (.-cc cc)))




^{:go/end 344} (go/method shouldRunStateHook "shouldRunStateHook returns the user's state hook if we should call it,\nor nil if we don't need to call it at this time.\n" ^{:tag (func [(* ClientConn)])} [^{:tag (* ClientConn)} cc ^bool stopRunning]
  (.Lock (.-stateHookMu cc))
  (defer (.Unlock (.-stateHookMu cc)))
  (when (== (.-cc cc) nil)
    (return nil))

  (when stopRunning
    (set! (.-stateHookRunning cc) false))

  (when (== (.-userStateHook cc) nil)
    (return nil))

  (when (.-stateHookRunning cc)
    (return nil))

  (let [
      ^:var ^{:line 331} available (.Available cc)
      ^:var ^{:line 332} inFlight (.InFlight cc)
      ^:var ^{:line 333} closed (!= (.Err cc) nil)

      ^{:line 335 :tag (func [(* ClientConn)])} hook (zero (func [(* ClientConn)]))]
    (when (or (> available (.-lastAvailable cc)) (< inFlight (.-lastInFlight cc)) (!= closed (.-lastClosed cc)))
      (set! hook (.-userStateHook cc))
      (set! (.-stateHookRunning cc) true))

    (set! (.-lastAvailable cc) available)
    (set! (.-lastInFlight cc) inFlight)
    (set! (.-lastClosed cc) closed)
    ^{:line 343} hook))


^{:go/end 371} (go/method maybeRunStateHook [^{:tag (* ClientConn)} cc]
  (let [hook (.shouldRunStateHook cc false)]
    (when (== hook nil)
      (return))

    ;; Run the hook synchronously.
    ;;
    ;; This means that if, for example, the user calls resp.Body.Close to finish a request,
    ;; the Close call will synchronously run the hook, giving the hook the chance to
    ;; return the ClientConn to a connection pool before the next request is made.
    (hook cc)
    ;; The connection state may have changed while the hook was running,
    ;; in which case we need to run it again.
    ;;
    ;; If we do need to run the hook again, do so in a new goroutine to avoid blocking
    ;; the current goroutine indefinitely.
    (set! hook (.shouldRunStateHook cc true))
    (when (!= hook nil)
      (go (^{:go/end 369} (fn []
            (while (!= hook nil)
              (hook cc)
              (set! hook (.shouldRunStateHook cc true)))))))))

















^{:go/end 390} (go/method SetStateHook "SetStateHook arranges for f to be called when the state of the connection changes.\nAt most one call to f is made at a time.\nIf the connection's state has changed since it was created,\nf is called immediately in a separate goroutine.\nf may be called synchronously from RoundTrip or Response.Body.Close.\n\nIf SetStateHook is called multiple times, the new hook replaces the old one.\nIf f is nil, no further calls will be made to f after SetStateHook returns.\n\nf is called when Available increases (more requests may be sent on the connection),\nInFlight decreases (existing requests complete), or Err begins returning non-nil\n(the connection is no longer usable).\n" [^{:tag (* ClientConn)} cc ^{:tag (func [(* ClientConn)])} f]
  (.Lock (.-stateHookMu cc))
  (set! (.-userStateHook cc) f)
  (.Unlock (.-stateHookMu cc))
  (.maybeRunStateHook cc))





^{:go/end 220} (go/method Err "Err reports any fatal connection errors.\nIt returns nil if the connection is usable.\nIf it returns non-nil, the connection can no longer be used.\n" ^error [^{:tag (* ClientConn)} cc]
  (.Err (.-cc cc)))


^{:go/breaks [[9 243]] :go/end 244} (go/func validateClientConnRequest ^error [^{:tag (* Request)} req]
  (when (== (.-URL req) nil)
    (return (errors/New "http: nil Request.URL")))

  (when (== (.-Header req) nil)
    (return (errors/New "http: nil Request.Header")))

  ;; Validate the outgoing headers.
  (when [err (validateHeaders (.-Header req))] (!= err "")
    (return (fmt/Errorf "http: invalid header %s" err)))

  ;; Validate the outgoing trailers too.
  (when [err (validateHeaders (.-Trailer req))] (!= err "")
    (return (fmt/Errorf "http: invalid trailer %s" err)))

  (when (and (!= (.-Method req) "") (not (validMethod (.-Method req))))
    (return (fmt/Errorf "http: invalid method %q" (.-Method req))))

  (when (== (.-Host (.-URL req)) "")
    (return (errors/New "http: no Host in request URL")))

  nil)










^{:go/end 272} (go/method RoundTrip "RoundTrip implements the [RoundTripper] interface.\n\nThe request is sent on the client connection,\nregardless of the URL being requested or any proxy settings.\n\nIf the connection is at its concurrency limit,\nRoundTrip waits for the connection to become available\nbefore sending the request.\n" [^{:tag (* ClientConn)} cc ^{:tag (* Request)} req] :results [(* Response) error]
  (defer (.maybeRunStateHook cc))
  (when (and (== (.-URL req) nil) (== (.-Method req) ":ping"))
    ;; Undocumented feature for sending a PING frame to a HTTP/2 connection,
    ;; included to support x/net/http2.ClientConn.Ping.
    (let [(values pinger ok) (assert (interface
            (Ping ^error [context/Context])) ^{:line 259} (.-cc cc))]

      (when (not ok)
        (return nil (errors/New "http: ClientConn does not support PING")))

      (return nil (.Ping pinger (.Context req)))))

  (when [err (validateClientConnRequest req)] (!= err nil)
    (.Release cc)
    (return nil err))

  (.RoundTrip (.-cc cc) req))






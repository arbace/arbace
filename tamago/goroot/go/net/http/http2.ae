(go/type http2ExternalServerConfig "http2ExternalServerConfig is an HTTP/2 configuration provided by x/net/http2.\n\nWhen a x/net/http2.Server wraps a net/http.Server, we need to support the user\nsetting configuration settings on the x/net Server:\n\n\ts1 := &http.Server{}\n\ts2 := &http2.Server{}\n\thttp2.ConfigureServer(s1, s2)\n\n\t// This setting needs to affect s1:\n\ts2.MaxReadFrameSize = 10000\n\nWe handle this by having http2.ConfigureServer pass us an http2ExternalServerConfig\n(see http.Server.Serve) which we can use to query the current state of the http2.Server.\n" (interface

    (^{:doc "Various configuration settings:\n"} HTTP2Config ^HTTP2Config [])
    (IdleTimeout ^time/Duration [])



    (^{:doc "ServeConnFunc provides a function to the x/net/http2.Server which it\ncan use to serve a new connection.\n"} ServeConnFunc [(func [^context/Context ctx ^net/Conn nc ^Handler h ^bool sawClientPreface ^{:tag (* Request)} upgradeReq ^{:tag (slice byte)} settings])])))















(go/type http2ExternalTransportConfig "http2ExternalTransportConfig is an HTTP/2 configuration provided by x/net/http2.\n\nWhen a x/net/http2.Transport wraps a net/http.Transport, we need to support the user\nsetting configuration settings on the x/net Transport:\n\n\ttr1 := &http.Transport{}\n\ttr2 := http2.ConfigureTransports(t1)\n\n\t// This setting needs to affect tr1:\n\ttr2.MaxHeaderListSize = 10000\n\nWe handle this by having http2.ConfigureTransports pass us an http2ExternalTransportConfig,\nwhich we can use to query the current state of the http2.Transport.\n" (interface

    (^{:doc "Various configuration settings:\n"} HTTP2Config ^HTTP2Config [])
    (DisableCompression ^bool [])
    (MaxHeaderListSize ^int64 [])
    (IdleConnTimeout ^time/Duration [])



    (^{:doc "ConnFromContext is used to pass a net.Conn to Transport.NewClientConn\nvia a context value. See Transport.http2NewClientConnFromContext.\n"} ConnFromContext ^net/Conn [context/Context])




    (^{:doc "DialFromContext is used to dial new connections, overriding Transport.DialContext etc.\nThis is used when the user calls x/net/http2.Transport.RoundTrip directly,\nin which case the historical behavior is to use the http2.Transport's dial functions.\n"} DialFromContext [^context/Context ctx ^string network ^string addr] :results [net/Conn error])





    (^{:doc "ExternalRoundTrip reports whether Transport.RoundTrip should call the\nexternal transport's RoundTrip. This is used when x/net/http2.Transport.ConnPool\nis set, in which case the user-provided ClientConnPool has taken responsibility\nfor picking a connection to use.\n"} ExternalRoundTrip ^bool [])



    (^{:doc "RoundTrip performs a round trip.\nIt should only be used when ExternalRoundTrip requests it.\n"} RoundTrip [(* Request)] :results [(* Response) error])


    (^{:doc "Registered is called to report successful registration of the config.\n"} Registered [(* Transport)])))


^{:go/end 312} (go/method configureHTTP2 [^{:tag (* Transport)} t ^Protocols protocols]
  (when (== (.-TLSClientConfig t) nil)
    (set! (.-TLSClientConfig t) (addr (lit tls/Config))))

  (when (== (.-HTTP2 t) nil)
    (set! (.-HTTP2 t) (addr (lit HTTP2Config))))

  (let [t2 (http2/NewTransport (lit transportConfig t))]
    (set! (.-h2Transport t) t2)

    (.registerProtocol t "https" (lit http2RoundTripper t2 true))
    (when (== (.-TLSNextProto t) nil)
      (set! (.-TLSNextProto t) (make (map string (func [^string authority ^{:tag (* tls/Conn)} c] [RoundTripper])))))

    ;; Historically, the presence of a TLSNextProto["h2"] key has been the signal to
    ;; enable/disable HTTP/2 support. Set a value in the map, but we'll never use it.
    (aset (.-TLSNextProto t) "h2" ^{:go/end 304} (fn ^RoundTripper [^string authority ^{:tag (* tls/Conn)} c]
        (lit http2ErringRoundTripper
          (errors/New "unexpected use of stub RoundTripper"))))



    ;; Server.ServeTLS clones the tls.Config before modifying it.
    ;; Transport doesn't. We may want to make the two consistent some day.
    ;;
    ;; http2configureTransport will have already set NextProtos, but adjust it again
    ;; here to remove HTTP/1.1 if the user has disabled it.
    (set! (.-NextProtos (.-TLSClientConfig t)) (adjustNextProtos (.-NextProtos (.-TLSClientConfig t)) protocols))))



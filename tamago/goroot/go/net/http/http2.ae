^{:go/end 548} (go/func mergeHTTP2Config ^http2/Config [^{:tag (* HTTP2Config)} c1 ^http2Configer confer]
  (when (and (== c1 nil) (== confer nil))
    (return (lit http2/Config)))

  (let [^http2/Config c (zero http2/Config)]
    (when (!= c1 nil)
      (set! c (conv http2/Config @c1)))

    (let [^HTTP2Config c2 (zero HTTP2Config)]
      (when (!= confer nil)
        (set! c2 (.HTTP2Config confer)))

      (when (== (.-MaxConcurrentStreams c) 0)
        (set! (.-MaxConcurrentStreams c) (.-MaxConcurrentStreams c2)))

      (when (.-StrictMaxConcurrentRequests c2)
        (set! (.-StrictMaxConcurrentRequests c) true))

      (when (== (.-MaxDecoderHeaderTableSize c) 0)
        (set! (.-MaxDecoderHeaderTableSize c) (.-MaxDecoderHeaderTableSize c2)))

      (when (== (.-MaxEncoderHeaderTableSize c) 0)
        (set! (.-MaxEncoderHeaderTableSize c) (.-MaxEncoderHeaderTableSize c2)))

      (when (== (.-MaxReadFrameSize c) 0)
        (set! (.-MaxReadFrameSize c) (.-MaxReadFrameSize c2)))

      (when (== (.-MaxReceiveBufferPerConnection c) 0)
        (set! (.-MaxReceiveBufferPerConnection c) (.-MaxReceiveBufferPerConnection c2)))

      (when (== (.-MaxReceiveBufferPerStream c) 0)
        (set! (.-MaxReceiveBufferPerStream c) (.-MaxReceiveBufferPerStream c2)))

      (when (== (.-SendPingTimeout c) 0)
        (set! (.-SendPingTimeout c) (.-SendPingTimeout c2)))

      (when (== (.-PingTimeout c) 0)
        (set! (.-PingTimeout c) (.-PingTimeout c2)))

      (when (== (.-WriteByteTimeout c) 0)
        (set! (.-WriteByteTimeout c) (.-WriteByteTimeout c2)))

      (when (.-PermitProhibitedCipherSuites c2)
        (set! (.-PermitProhibitedCipherSuites c) true))

      (when (== (.-CountError c) nil)
        (set! (.-CountError c) (.-CountError c2)))

      ^{:line 547} c)))



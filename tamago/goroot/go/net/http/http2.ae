^{:go/end 412} (go/method http2NewClientConnFromContext "http2NewClientConnFromContext creates a *ClientConn from a net.Conn.\n\nTransport.NewClientConn takes an address and dials a new net.Conn.\nWe don't currently provide a simple way for the user to provide a net.Conn and get a\n*ClientConn out of it (although we do let the user provide their own Transport.DialContext,\nwhich can be used to effectively do this).\n\nx/net/http2.Transport.NewClientConn, in contrast, requires the user to provide a net.Conn.\nTo support implementing the x/net/http2 NewClientConn in terms of a net/http.Transport,\nwe permit x/net/http2 to pass us a net.Conn via a context key.\n\nhttp2NewClientConnFromContext handles extracting the net.Conn from the Context\n(when present) and creating a *ClientConn from it.\n" [^{:tag (* Transport)} t ^context/Context ctx] :results [(* ClientConn) error]
  (when (== (.-h2Config t) nil)
    (return nil errors/ErrUnsupported))

  (let [nc (.ConnFromContext (.-h2Config t) ctx)]
    (when (== nc nil)
      (return nil errors/ErrUnsupported))

    (when (== (.-h2Transport t) nil)
      (return nil (errors/New "http: Transport does not support HTTP/2")))

    (let [cc (addr (lit ClientConn))
        (values gc err) (.http2NewClientConn t nc (.-maybeRunStateHook cc))]
      (when (!= err nil)
        (return nil err))

      (.Lock (.-stateHookMu cc))
      (defer (.Unlock (.-stateHookMu cc)))
      (set! (.-cc cc) gc)
      (set! (.-lastAvailable cc) (.Available gc))
      (return cc nil))))









^{:go/end 430} (go/method http2ExternalDial "http2ExternalDial creates a new HTTP/2 connection,\nusing the x/net/http2.Transport's dial functions.\n\nThis is used when the user has called x/net/http2.Transport.RoundTrip.\nIf the RoundTrip needs to create a new connection,\nthe historical behavior is for it to use the http2.Transport's DialTLS or DialTLSContext\nfunctions, and not any dial functions on the http.Transport.\n" [^{:tag (* Transport)} t ^context/Context ctx ^connectMethod cm] :results [RoundTripper error]
  (when (== (.-h2Config t) nil)
    (return nil errors/ErrUnsupported))

  (let [(values nc err) (.DialFromContext (.-h2Config t) ctx "tcp" (.-targetAddr cm))]
    (when (!= err nil)
      (return nil err))

    (.http2AddConn t (.-targetScheme cm) (.-targetAddr cm) nc)))



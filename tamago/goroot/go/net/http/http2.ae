^{:go/end 83} (go/method configureHTTP2 [^{:tag (* Server)} s]
  (let [h2srv (addr (lit http2/Server))]

    ;; Historically, we've configured the HTTP/2 idle timeout in this fashion:
    ;; Set once at configuration time.
    (if (!= (.-IdleTimeout s) 0)
      (set! (.-h2IdleTimeout s) (.-IdleTimeout s))

      (set! (.-h2IdleTimeout s) (.-ReadTimeout s)))


    (when (== (.-TLSConfig s) nil)
      (set! (.-TLSConfig s) (addr (lit tls/Config))))

    (set! (.-nextProtoErr s) (.Configure h2srv (lit http2ServerConfig s) (.-TLSConfig s)))
    (when (!= (.-nextProtoErr s) nil)
      (return))


    (.RegisterOnShutdown s (.-GracefulShutdown h2srv))

    (when (== (.-TLSNextProto s) nil)
      (set! (.-TLSNextProto s) (make (map string (func [(* Server) (* tls/Conn) Handler])))))

    ;; Historically, the presence of a TLSNextProto["h2"] key has been the signal to
    ;; enable/disable HTTP/2 support. Set a value in the map, but we'll never use it.
    (aset (.-TLSNextProto s) "h2" ^{:go/end 80} (fn [^{:tag (* Server)} hs ^{:tag (* tls/Conn)} c ^Handler h]
        (.Close c)))


    (set! (.-h2 s) h2srv)))



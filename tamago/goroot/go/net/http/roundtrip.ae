(in-ns 'go.net.http) (go/file "roundtrip.go" :build ["//go:build !js || !tamago"] :imports [

    ^{:line 9} [_ "unsafe"]]) ; for linkname










(go/func ^:extern ^{:go/linkname "badRoundTrip net/http.(*Transport).RoundTrip"} badRoundTrip "RoundTrip should be an internal detail,\nbut widely used packages access it using linkname.\nNotable members of the hall of shame include:\n  - github.com/erda-project/erda-infra\n\nDo not remove or change the type signature.\nSee go.dev/issue/67401.\n" [(* Transport) (* Request)] :results [(* Response) error])








^{:go/end 34} (go/method RoundTrip "RoundTrip implements the [RoundTripper] interface.\n\nFor higher-level HTTP client support (such as handling of cookies\nand redirects), see [Get], [Post], and the [Client] type.\n\nLike the RoundTripper interface, the error types returned\nby RoundTrip are unspecified.\n" [^{:tag (* Transport)} t ^{:tag (* Request)} req] :results [(* Response) error]
  (when (== t nil)
    (panic "transport is nil"))

  (.roundTrip t req))

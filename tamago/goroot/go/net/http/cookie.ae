      (cond (> (.-MaxAge c) 0) (do
          (.WriteString b "; Max-Age=")
          (.Write b (strconv/AppendInt (subslice buf _ 0) (conv int64 (.-MaxAge c)) 10)))
        (< (.-MaxAge c) 0)
        (.WriteString b "; Max-Age=0"))

      (when (.-HttpOnly c)
        (.WriteString b "; HttpOnly"))

      (when (.-Secure c)
        (.WriteString b "; Secure"))

      (switch (.-SameSite c)
        (case [SameSiteDefaultMode])
        ;; Skip, default mode is obtained by not emitting the attribute.
        (case [SameSiteNoneMode]

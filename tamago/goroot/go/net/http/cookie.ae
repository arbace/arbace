^{:go/end 245} (go/func readSetCookies "readSetCookies parses all \"Set-Cookie\" values from\nthe header h and returns the successfully parsed Cookies.\n\nIf the amount of cookies exceeds CookieNumLimit, and httpcookielimitnum\nGODEBUG option is not explicitly turned off, this function will silently\nfail and return an empty slice.\n" ^{:tag (slice (* Cookie))} [^Header h]
  (let [cookieCount (len (aget h "Set-Cookie"))]
    (when (== cookieCount 0)
      (return (lit (slice (* Cookie)))))

    ;; Cookie limit was unfortunately introduced at a later point in time.
    ;; As such, we can only fail by returning an empty slice rather than
    ;; explicit error.
    (when (not (cookieNumWithinMax cookieCount))
      (return (lit (slice (* Cookie)))))

    (let [cookies (make (slice (* Cookie)) 0 cookieCount)]
      (range [_ line (aget h "Set-Cookie")]
        (when [(values cookie err) (ParseSetCookie line)] (== err nil)
          (set! cookies (append cookies cookie))))



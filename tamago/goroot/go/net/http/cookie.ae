      ^{:line 267 :tag strings/Builder} b (zero strings/Builder)]
    (.Grow b (+ (len (.-Name c)) (len (.-Value c)) (len (.-Domain c)) (len (.-Path c)) extraCookieLength))
    (.WriteString b (.-Name c))

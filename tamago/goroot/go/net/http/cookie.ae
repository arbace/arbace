  (when (> (len (.-Domain c)) 0)
    (when (not (validCookieDomain (.-Domain c)))
      (return (errors/New "http: invalid Cookie.Domain"))))


  (when (.-Partitioned c)
    (when (not (.-Secure c))
      (return (errors/New "http: partitioned cookies must be set with Secure"))))



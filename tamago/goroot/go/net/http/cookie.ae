^{:go/end 115} (go/func ParseCookie "ParseCookie parses a Cookie header value and returns all the cookies\nwhich were set in it. Since the same cookie name can appear multiple times\nthe returned Values can contain more than one value for a given key.\n" [^string line] :results [(slice (* Cookie)) error]
  (let [nparts (+ (strings/Count line ";") 1)]
    (cond (not (cookieNumWithinMax nparts))
      (return nil errCookieNumLimitExceeded)
      (and (== nparts 1) (== (textproto/TrimString line) ""))
      (return nil errBlankCookie))

    (let [cookies (make (slice (* Cookie)) 0 nparts)]
      (range [s (strings/SplitSeq line ";")]
        (set! s (textproto/TrimString s))
        (let [(values name value found) (strings/Cut s "=")]
          (when (not found)
            (return nil errEqualNotFoundInCookie))

          (when (not (isToken name))
            (return nil errInvalidCookieName))

          (let [(values ^:assign value quoted ^:assign found) (parseCookieValue value true)]
            (when (not found)
              (return nil errInvalidCookieValue))

            (set! cookies (append cookies (addr (lit Cookie :Name name :Value value :Quoted quoted)))))))

      (return cookies nil))))





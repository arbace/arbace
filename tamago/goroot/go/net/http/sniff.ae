(in-ns 'go.net.http) (go/file "sniff.go" :imports [

    ^{:line 7} [internal "net/http/internal"]])







^{:go/end 17} (go/func DetectContentType "DetectContentType implements the algorithm described\nat https://mimesniff.spec.whatwg.org/ to determine the\nContent-Type of the given data. It considers at most the\nfirst 512 bytes of data. DetectContentType always returns\na valid MIME type: if it cannot determine a more specific one, it\nreturns \"application/octet-stream\".\n" ^string [^{:tag (slice byte)} data]
  (internal/DetectContentType data))

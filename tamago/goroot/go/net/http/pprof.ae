(ns go.net.http.pprof
  (:require [arbace.go :as go]))

(go/package pprof
  :path "net/http/pprof"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["pprof.go"]
  :init-order [profileSupportsDelta profileDescriptions]
  :positions :lines)

(load "pprof/pprof")

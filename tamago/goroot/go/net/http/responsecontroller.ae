(in-ns 'go.net.http) (go/file "responsecontroller.go" :imports [


    ^{:line 8} [bufio "bufio"]
    ^{:line 9} [fmt "fmt"]
    ^{:line 10} [net "net"]
    ^{:line 11} [time "time"]])





(go/type ResponseController "A ResponseController is used by an HTTP handler to control the response.\n\nA ResponseController may not be used after the [Handler.ServeHTTP] method has returned.\n" (struct
    ^{:line 18 :tag ResponseWriter} rw))



















^{:go/end 40} (go/func NewResponseController "NewResponseController creates a [ResponseController] for a request.\n\nThe ResponseWriter should be the original value passed to the [Handler.ServeHTTP] method,\nor have an Unwrap method returning the original ResponseWriter.\n\nIf the ResponseWriter implements any of the following methods, the ResponseController\nwill call them as appropriate:\n\n\tFlush()\n\tFlushError() error // alternative Flush returning an error\n\tHijack() (net.Conn, *bufio.ReadWriter, error)\n\tSetReadDeadline(deadline time.Time) error\n\tSetWriteDeadline(deadline time.Time) error\n\tEnableFullDuplex() error\n\nIf the ResponseWriter does not support a method, ResponseController returns\nan error matching [ErrNotSupported].\n" ^{:tag (* ResponseController)} [^ResponseWriter rw]
  (addr (lit ResponseController rw)))


(go/type rwUnwrapper (interface
    (Unwrap ^ResponseWriter [])))



^{:go/end 62} (go/method Flush "Flush flushes buffered data to the client.\n" ^error [^{:tag (* ResponseController)} c]
  (let [rw (.-rw c)]
    (while true
      (type-switch [t rw]
        (case [(interface (FlushError ^error []))]
          (return (.FlushError t)))
        (case [Flusher]
          (.Flush t)
          (return nil))
        (case [rwUnwrapper]
          (set! rw (.Unwrap t)))
        (default
          (return (errNotSupported)))))))






^{:go/end 78} (go/method Hijack "Hijack lets the caller take over the connection.\nSee the [Hijacker] interface for details.\n" [^{:tag (* ResponseController)} c] :results [net/Conn (* bufio/ReadWriter) error]
  (let [rw (.-rw c)]
    (while true
      (type-switch [t rw]
        (case [Hijacker]
          (return (.Hijack t)))
        (case [rwUnwrapper]
          (set! rw (.Unwrap t)))
        (default
          (return nil nil (errNotSupported)))))))









^{:go/end 97} (go/method SetReadDeadline "SetReadDeadline sets the deadline for reading the entire request, including the body.\nReads from the request body after the deadline has been exceeded will return an error.\nA zero value means no deadline.\n\nSetting the read deadline after it has been exceeded will not extend it.\n" ^error [^{:tag (* ResponseController)} c ^time/Time deadline]
  (let [rw (.-rw c)]
    (while true
      (type-switch [t rw]
        (case [(interface (SetReadDeadline ^error [time/Time]))]
          (return (.SetReadDeadline t deadline)))
        (case [rwUnwrapper]
          (set! rw (.Unwrap t)))
        (default
          (return (errNotSupported)))))))










^{:go/end 117} (go/method SetWriteDeadline "SetWriteDeadline sets the deadline for writing the response.\nWrites to the response body after the deadline has been exceeded will not block,\nbut may succeed if the data has been buffered.\nA zero value means no deadline.\n\nSetting the write deadline after it has been exceeded will not extend it.\n" ^error [^{:tag (* ResponseController)} c ^time/Time deadline]
  (let [rw (.-rw c)]
    (while true
      (type-switch [t rw]
        (case [(interface (SetWriteDeadline ^error [time/Time]))]
          (return (.SetWriteDeadline t deadline)))
        (case [rwUnwrapper]
          (set! rw (.Unwrap t)))
        (default
          (return (errNotSupported)))))))














^{:go/end 141} (go/method EnableFullDuplex "EnableFullDuplex indicates that the request handler will interleave reads from [Request.Body]\nwith writes to the [ResponseWriter].\n\nFor HTTP/1 requests, the Go HTTP server by default consumes any unread portion of\nthe request body before beginning to write the response, preventing handlers from\nconcurrently reading from the request and writing the response.\nCalling EnableFullDuplex disables this behavior and permits handlers to continue to read\nfrom the request while concurrently writing the response.\n\nFor HTTP/2 requests, the Go HTTP server always permits concurrent reads and responses.\n" ^error [^{:tag (* ResponseController)} c]
  (let [rw (.-rw c)]
    (while true
      (type-switch [t rw]
        (case [(interface (EnableFullDuplex ^error []))]
          (return (.EnableFullDuplex t)))
        (case [rwUnwrapper]
          (set! rw (.Unwrap t)))
        (default
          (return (errNotSupported)))))))






^{:go/end 147} (go/func errNotSupported "errNotSupported returns an error that Is ErrNotSupported,\nbut is not == to it.\n" ^error []
  (fmt/Errorf "%w" ErrNotSupported))

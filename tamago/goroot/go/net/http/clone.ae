^{:go/end 30} (go/func ^{:go/linkname "cloneURLValues"} cloneURLValues "cloneURLValues should be an internal detail,\nbut widely used packages access it using linkname.\nNotable members of the hall of shame include:\n  - github.com/searKing/golang\n\nDo not remove or change the type signature.\nSee go.dev/issue/67401.\n" ^url/Values [^url/Values v]
  (when (== v nil)
    (return nil))

  ;; http.Header and url.Values have the same representation, so temporarily
  ;; treat it like http.Header, which does have a clone:
  (conv url/Values (.Clone (conv Header v))))











^{:go/end 43} (go/func ^{:go/linkname "cloneURL"} cloneURL "cloneURL should be an internal detail,\nbut widely used packages access it using linkname.\nNotable members of the hall of shame include:\n  - github.com/searKing/golang\n\nDo not remove or change the type signature.\nSee go.dev/issue/67401.\n" ^{:tag (* url/URL)} [^{:tag (* url/URL)} u]
  (.Clone u))











^{:go/end 73} (go/func ^{:go/linkname "cloneMultipartForm"} cloneMultipartForm "cloneMultipartForm should be an internal detail,\nbut widely used packages access it using linkname.\nNotable members of the hall of shame include:\n  - github.com/searKing/golang\n\nDo not remove or change the type signature.\nSee go.dev/issue/67401.\n" ^{:tag (* multipart/Form)} [^{:tag (* multipart/Form)} f]
  (when (== f nil)
    (return nil))

  (let [f2 (addr ^{:go/breaks [2]} (lit multipart/Form
          :Value (conv (map string (slice string)) (.Clone (conv Header (.-Value f))))))]

    (when (!= (.-File f) nil)
      (let [m (make (map string (slice (* multipart/FileHeader))) (len (.-File f)))]
        (range [k vv (.-File f)]
          (let [vv2 (make (slice (* multipart/FileHeader)) (len vv))]
            (range [i v vv]
              (aset vv2 i (cloneMultipartFileHeader v)))

            (aset m k vv2)))

        (set! (.-File f2) m)))

    ^{:line 72} f2))











^{:go/end 92} (go/func ^{:go/linkname "cloneMultipartFileHeader"} cloneMultipartFileHeader "cloneMultipartFileHeader should be an internal detail,\nbut widely used packages access it using linkname.\nNotable members of the hall of shame include:\n  - github.com/searKing/golang\n\nDo not remove or change the type signature.\nSee go.dev/issue/67401.\n" ^{:tag (* multipart/FileHeader)} [^{:tag (* multipart/FileHeader)} fh]
  (when (== fh nil)
    (return nil))

  (let [fh2 (new multipart/FileHeader)]
    (set! @fh2 @fh)
    (set! (.-Header fh2) (conv textproto/MIMEHeader (.Clone (conv Header (.-Header fh)))))
    ^{:line 91} fh2))














^{:go/end 112} (go/func ^{:go/linkname "cloneOrMakeHeader"} cloneOrMakeHeader "cloneOrMakeHeader invokes Header.Clone but if the\nresult is nil, it'll instead make and return a non-nil Header.\n\ncloneOrMakeHeader should be an internal detail,\nbut widely used packages access it using linkname.\nNotable members of the hall of shame include:\n  - github.com/searKing/golang\n\nDo not remove or change the type signature.\nSee go.dev/issue/67401.\n" ^Header [^Header hdr]
  (let [clone (.Clone hdr)]
    (when (== clone nil)
      (set! clone (make Header)))

    ^{:line 111} clone))

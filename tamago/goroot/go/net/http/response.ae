^{:go/end 362} (go/method isProtocolSwitch "isProtocolSwitch reports whether the response code and header\nindicate a successful protocol upgrade response.\n" ^bool [^{:tag (* Response)} r]
  (isProtocolSwitchResponse (.-StatusCode r) (.-Header r)))




^{:go/end 368} (go/func isProtocolSwitchResponse "isProtocolSwitchResponse reports whether the response code and\nresponse header indicate a successful protocol upgrade response.\n" ^bool [^int code ^Header h]
  (and (== code StatusSwitchingProtocols) (isProtocolSwitchHeader h)))




^{:go/end 375} (go/func isProtocolSwitchHeader "isProtocolSwitchHeader reports whether the request or response header\nis for a protocol switch.\n" ^bool [^Header h]
  (and (!= (.Get h "Upgrade") "")
    (httpguts/HeaderValuesContainsToken (aget h "Connection") "Upgrade")))

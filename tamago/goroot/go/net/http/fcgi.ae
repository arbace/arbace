(ns go.net.http.fcgi
  (:require [arbace.go :as go]))

(go/package fcgi
  :path "net/http/fcgi"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["child.go" "fcgi.go"]
  :init-order [errCloseConn emptyBody ErrRequestAborted ErrConnClosed]
  :positions :lines)

(load "fcgi/child")
(load "fcgi/fcgi")

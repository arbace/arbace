^{:go/end 127} (go/method match "match returns the leaf node under root that matches the arguments, and a list\nof values for pattern wildcards in the order that the wildcards appear.\nFor example, if the request path is \"/a/b/c\" and the pattern is \"/{x}/b/{y}\",\nthen the second return value will be []string{\"a\", \"c\"}.\n" [^{:tag (* routingNode)} root ^string host ^string method ^string path] :results [(* routingNode) (slice string)]
  (when (!= host "")
    ;; There is a host. If there is a pattern that specifies that host and it
    ;; matches, we are done. If the pattern doesn't match, fall through to
    ;; try patterns with no host.
    (when [(values l m) (.matchMethodAndPath (.findChild root host) method path)] (!= l nil)
      (return l m)))


  (.matchMethodAndPath (.-emptyChild root) method path))





^{:go/end 148} (go/method matchMethodAndPath "matchMethodAndPath matches the method and path.\nIts return values are the same as [routingNode.match].\nThe receiver should be a child of the root.\n" [^{:tag (* routingNode)} n ^string method ^string path] :results [(* routingNode) (slice string)]
  (when (== n nil)
    (return nil nil))

  (when [(values l m) (.matchPath (.findChild n method) path nil)] (!= l nil)
    ;; Exact match of method name.
    (return l m))

  (when (== method "HEAD")
    ;; GET matches HEAD too.
    (when [(values l m) (.matchPath (.findChild n "GET") path nil)] (!= l nil)
      (return l m)))


  ;; No exact match; try patterns with no method.
  (.matchPath (.-emptyChild n) path nil))






^{:go/end 199} (go/method matchPath "matchPath matches a path.\nIts return values are the same as [routingNode.match].\nmatchPath calls itself recursively. The matches argument holds the wildcard matches\nfound so far.\n" [^{:tag (* routingNode)} n ^string path ^{:tag (slice string)} matches] :results [(* routingNode) (slice string)]
  (when (== n nil)

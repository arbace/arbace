;; This file implements a decision tree for fast matching of requests to
;; patterns.
;;
;; The root of the tree branches on the host of the request.
;; The next level branches on the method.
;; The remaining levels branch on consecutive segments of the path.
;;
;; The "more specific wins" precedence rule can result in backtracking.
;; For example, given the patterns
;;     /a/b/z
;;     /a/{x}/c
;; we will first try to match the path "/a/b/c" with /a/b/z, and
;; when that fails we will try against /a/{x}/c.

(in-ns 'go.net.http) (go/file "routing_tree.go" :imports [


    ^{:line 22} [strings "strings"]])




(go/type routingNode "A routingNode is a node in the decision tree.\nThe same struct is used for leaf and interior nodes.\n" (struct


    ^{:line 30 :tag (* pattern) :doc "A leaf node holds a single pattern and the Handler it was registered\nwith.\n"} pattern
    ^{:line 31 :tag Handler} handler





    ^{:line 37 :tag (mapping string (* routingNode)) :doc "An interior node maps parts of the incoming request to child nodes.\nspecial children keys:\n    \"/\"\ttrailing slash (resulting from {$})\n\t   \"\"   single wildcard\n"} children
    ^{:line 38 :tag (* routingNode)} multiChild ; child with multi wildcard
    ^{:line 39 :tag (* routingNode)} emptyChild)) ; optimization: child with key ""




^{:go/end 51} (go/method addPattern "addPattern adds a pattern and its associated Handler to the tree\nat root.\n" [^{:tag (* routingNode)} root ^{:tag (* pattern)} p ^Handler h]
  ;; First level of tree is host.
  (let [n (.addChild root (.-host p))]
    ;; Second level of tree is method.
    (set! n (.addChild n (.-method p)))
    ;; Remaining levels are path.
    (.addSegments n (.-segments p) p h)))





^{:go/end 74} (go/method addSegments "addSegments adds the given segments to the tree rooted at n.\nIf there are no segments, then n is a leaf node that holds\nthe given pattern and handler.\n" [^{:tag (* routingNode)} n ^{:tag (slice segment)} segs ^{:tag (* pattern)} p ^Handler h]
  (when (== (len segs) 0)
    (.set n p h)
    (return))

  (let [seg (aget segs 0)]
    (cond (.-multi seg) (do
        (when (!= (len segs) 1)
          (panic "multi wildcard not last"))

        (let [c (addr (lit routingNode))]
          (set! (.-multiChild n) c)
          (.set c p h)))
      (.-wild seg)
      (.addSegments (.addChild n "") (subslice segs 1) p h) :else

      (.addSegments (.addChild n (.-s seg)) (subslice segs 1) p h))))





^{:go/end 84} (go/method set "set sets the pattern and handler for n, which\nmust be a leaf node.\n" [^{:tag (* routingNode)} n ^{:tag (* pattern)} p ^Handler h]
  (when (or (!= (.-pattern n) nil) (!= (.-handler n) nil))
    (panic "non-nil leaf fields"))

  (set! (.-pattern n) p)
  (set! (.-handler n) h))




^{:go/end 101} (go/method addChild "addChild adds a child node with the given key to n\nif one does not exist, and returns the child.\n" ^{:tag (* routingNode)} [^{:tag (* routingNode)} n ^string key]
  (when (== key "")
    (when (== (.-emptyChild n) nil)
      (set! (.-emptyChild n) (addr (lit routingNode))))

    (return (.-emptyChild n)))

  (when [c (.findChild n key)] (!= c nil)
    (return c))

  (let [c (addr (lit routingNode))]
    (.add (.-children n) key c)
    ^{:line 100} c))




^{:go/end 111} (go/method findChild "findChild returns the child of n with the given key, or nil\nif there is no child with that key.\n" ^{:tag (* routingNode)} [^{:tag (* routingNode)} n ^string key]
  (when (== key "")
    (return (.-emptyChild n)))

  (let [(values r _) (.find (.-children n) key)]

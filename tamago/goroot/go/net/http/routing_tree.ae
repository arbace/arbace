      ;; trailing slash in the pattern).
      (when (!= (.-s (.lastSegment (.-pattern c))) "")
        (set! matches (append matches (pathUnescape (subslice path 1))))) ; remove initial slash

      (return c matches))

    (return nil nil)))






^{:go/end 215} (go/func firstSegment "firstSegment splits path into its first segment, and the rest.\nThe path must begin with \"/\".\nIf path consists of only a slash, firstSegment returns (\"/\", \"\").\nThe segment is returned unescaped, if possible.\n" [^string path] :results [^string seg ^string rest]
  (when (== path "/")
    (return "/" ""))

  (set! path (subslice path 1)) ; drop initial slash
  (let [i (strings/IndexByte path \/)]
    (when (< i 0)
      (set! i (len path)))

    (return (pathUnescape (subslice path _ i)) (subslice path i))))




^{:go/end 227} (go/method matchingMethods "matchingMethods adds to methodSet all the methods that would result in a\nmatch if passed to routingNode.match with the given host and path.\n" [^{:tag (* routingNode)} root ^string host ^string path ^{:tag (map string bool)} methodSet]
  (when (!= host "")
    (.matchingMethodsPath (.findChild root host) path methodSet))

  (.matchingMethodsPath (.-emptyChild root) path methodSet)
  (when (aget methodSet "GET")
    (aset methodSet "HEAD" true)))



^{:go/end 242} (go/method matchingMethodsPath [^{:tag (* routingNode)} n ^string path ^{:tag (map string bool)} set]
  (when (== n nil)
    (return))

  (.eachPair (.-children n) ^{:go/breaks [[3 237]] :go/end 238} (fn ^bool [^string method ^{:tag (* routingNode)} c]
      (when [(values p _) (.matchPath c path nil)] (!= p nil)

(ns go.net.http.cgi
  (:require [arbace.go :as go]))

(go/package cgi
  :path "net/http/cgi"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["cgi_main.go" "child.go" "host.go"]
  :init-order [trailingPort osDefaultInheritEnv]
  :positions :lines)

(load "cgi/cgi_main")
(load "cgi/child")
(load "cgi/host")

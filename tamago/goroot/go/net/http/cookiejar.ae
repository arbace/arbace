(ns go.net.http.cookiejar
  (:require [arbace.go :as go]))

(go/package cookiejar
  :path "net/http/cookiejar"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["jar.go" "punycode.go"]
  :init-order [errIllegalDomain errMalformedDomain endOfTime]
  :positions :lines)

(load "cookiejar/jar")
(load "cookiejar/punycode")

;; Package pprof serves via its HTTP server runtime profiling data
;; in the format expected by the pprof visualization tool.
;;
;; The package is typically only imported for the side effect of
;; registering its HTTP handlers.
;; The handled paths all begin with /debug/pprof/.
;; As of Go 1.22, all the paths must be requested with GET.
;;
;; To use pprof, link this package into your program:
;;
;;	import _ "net/http/pprof"
;;
;; If your application is not already running an http server, you
;; need to start one. Add "net/http" and "log" to your imports and
;; the following code to your main function:
;;
;;	go func() {
;;		log.Println(http.ListenAndServe("localhost:6060", nil))
;;	}()
;;
;; By default, all the profiles listed in [runtime/pprof.Profile] are
;; available (via [Handler]), in addition to the [Cmdline], [Profile], [Symbol],
;; and [Trace] profiles defined in this package.
;; If you are not using DefaultServeMux, you will have to register handlers
;; with the mux you are using.
;;
;; # Parameters
;;
;; Parameters can be passed via GET query params:
;;
;;   - debug=N (all profiles): response format: N = 0: binary (default), N > 0: plaintext
;;   - gc=N (heap profile): N > 0: run a garbage collection cycle before profiling
;;   - seconds=N (allocs, block, goroutine, heap, mutex, threadcreate profiles): return a delta profile
;;   - seconds=N (cpu (profile), trace profiles): profile for the given duration
;;
;; # Usage examples
;;
;; Use the pprof tool to look at the heap profile:
;;
;;	go tool pprof http://localhost:6060/debug/pprof/heap
;;
;; Or to look at a 30-second CPU profile:
;;
;;	go tool pprof http://localhost:6060/debug/pprof/profile?seconds=30
;;
;; Or to look at the goroutine blocking profile, after calling
;; [runtime.SetBlockProfileRate] in your program:
;;
;;	go tool pprof http://localhost:6060/debug/pprof/block
;;
;; Or to look at the holders of contended mutexes, after calling
;; [runtime.SetMutexProfileFraction] in your program:
;;
;;	go tool pprof http://localhost:6060/debug/pprof/mutex
;;
;; The package also exports a handler that serves execution trace data
;; for the "go tool trace" command. To collect a 5-second execution trace:
;;
;;	curl -o trace.out http://localhost:6060/debug/pprof/trace?seconds=5
;;	go tool trace trace.out
;;
;; To view all available profiles, open http://localhost:6060/debug/pprof/
;; in your browser.
;;
;; For a study of the facility in action, visit
;; https://go.dev/blog/pprof.
(in-ns 'go.net.http.pprof) (go/file "pprof.go" :doc "Package pprof serves via its HTTP server runtime profiling data\nin the format expected by the pprof visualization tool.\n\nThe package is typically only imported for the side effect of\nregistering its HTTP handlers.\nThe handled paths all begin with /debug/pprof/.\nAs of Go 1.22, all the paths must be requested with GET.\n\nTo use pprof, link this package into your program:\n\n\timport _ \"net/http/pprof\"\n\nIf your application is not already running an http server, you\nneed to start one. Add \"net/http\" and \"log\" to your imports and\nthe following code to your main function:\n\n\tgo func() {\n\t\tlog.Println(http.ListenAndServe(\"localhost:6060\", nil))\n\t}()\n\nBy default, all the profiles listed in [runtime/pprof.Profile] are\navailable (via [Handler]), in addition to the [Cmdline], [Profile], [Symbol],\nand [Trace] profiles defined in this package.\nIf you are not using DefaultServeMux, you will have to register handlers\nwith the mux you are using.\n\n# Parameters\n\nParameters can be passed via GET query params:\n\n  - debug=N (all profiles): response format: N = 0: binary (default), N > 0: plaintext\n  - gc=N (heap profile): N > 0: run a garbage collection cycle before profiling\n  - seconds=N (allocs, block, goroutine, heap, mutex, threadcreate profiles): return a delta profile\n  - seconds=N (cpu (profile), trace profiles): profile for the given duration\n\n# Usage examples\n\nUse the pprof tool to look at the heap profile:\n\n\tgo tool pprof http://localhost:6060/debug/pprof/heap\n\nOr to look at a 30-second CPU profile:\n\n\tgo tool pprof http://localhost:6060/debug/pprof/profile?seconds=30\n\nOr to look at the goroutine blocking profile, after calling\n[runtime.SetBlockProfileRate] in your program:\n\n\tgo tool pprof http://localhost:6060/debug/pprof/block\n\nOr to look at the holders of contended mutexes, after calling\n[runtime.SetMutexProfileFraction] in your program:\n\n\tgo tool pprof http://localhost:6060/debug/pprof/mutex\n\nThe package also exports a handler that serves execution trace data\nfor the \"go tool trace\" command. To collect a 5-second execution trace:\n\n\tcurl -o trace.out http://localhost:6060/debug/pprof/trace?seconds=5\n\tgo tool trace trace.out\n\nTo view all available profiles, open http://localhost:6060/debug/pprof/\nin your browser.\n\nFor a study of the facility in action, visit\nhttps://go.dev/blog/pprof.\n" :imports [


    ^{:line 74} [bufio "bufio"]
    ^{:line 75} [bytes "bytes"]
    ^{:line 76} [context "context"]
    ^{:line 77} [fmt "fmt"]
    ^{:line 78} [html "html"]
    ^{:line 79} [godebug "internal/godebug"]
    ^{:line 80} [profile "internal/profile"]
    ^{:line 81} [io "io"]
    ^{:line 82} [log "log"]
    ^{:line 83} [http "net/http"]
    ^{:line 84} [url "net/url"]
    ^{:line 85} [os "os"]
    ^{:line 86} [runtime "runtime"]
    ^{:line 87} [pprof "runtime/pprof"]
    ^{:line 88} [trace "runtime/trace"]
    ^{:line 89} [slices "slices"]
    ^{:line 90} [strconv "strconv"]
    ^{:line 91} [strings "strings"]
    ^{:line 92} [time "time"]])


^{:go/end 105} (go/func init []
  (let [prefix ""]
    (when (!= (.Value (godebug/New "httpmuxgo121")) "1")
      (set! prefix "GET "))

    (http/HandleFunc (+ prefix "/debug/pprof/") Index)
    (http/HandleFunc (+ prefix "/debug/pprof/cmdline") Cmdline)
    (http/HandleFunc (+ prefix "/debug/pprof/profile") Profile)
    (http/HandleFunc (+ prefix "/debug/pprof/symbol") Symbol)
    (http/HandleFunc (+ prefix "/debug/pprof/trace") Trace)))





^{:go/end 114} (go/func Cmdline "Cmdline responds with the running program's\ncommand line, with arguments separated by NUL bytes.\nThe package initialization registers it as /debug/pprof/cmdline.\n" [^http/ResponseWriter w ^{:tag (* http/Request)} r]
  (.Set (.Header w) "X-Content-Type-Options" "nosniff")
  (.Set (.Header w) "Content-Type" "text/plain; charset=utf-8")
  (fmt/Fprint w (strings/Join os/Args "\u0000")))


^{:go/end 121} (go/func sleep [^{:tag (* http/Request)} r ^time/Duration d]
  (select
    (case (<! (time/After d)))
    (case (<! (.Done (.Context r))))))



^{:go/end 131} (go/func configureWriteDeadline [^http/ResponseWriter w ^{:tag (* http/Request)} r ^float64 seconds]
  (let [(values srv ok) (assert (* http/Server) (.Value (.Context r) http/ServerContextKey))]
    (when (and ok (> (.-WriteTimeout srv) 0))
      (let [timeout (+ (.-WriteTimeout srv) (conv time/Duration (* seconds (conv float64 time/Second))))

          ^{:line 128} rc (http/NewResponseController w)]
        (.SetWriteDeadline rc (.Add (time/Now) timeout))))))



^{:go/end 139} (go/func serveError [^http/ResponseWriter w ^int status ^string txt]
  (.Set (.Header w) "Content-Type" "text/plain; charset=utf-8")
  (.Set (.Header w) "X-Go-Pprof" "1")
  (.Del (.Header w) "Content-Disposition")
  (.WriteHeader w status)
  (fmt/Fprintln w txt))





^{:go/end 165} (go/func Profile "Profile responds with the pprof-formatted cpu profile.\nProfiling lasts for duration specified in seconds GET parameter, or for 30 seconds if not specified.\nThe package initialization registers it as /debug/pprof/profile.\n" [^http/ResponseWriter w ^{:tag (* http/Request)} r]
  (.Set (.Header w) "X-Content-Type-Options" "nosniff")
  (let [(values sec err) (strconv/ParseInt (.FormValue r "seconds") 10 64)]
    (when (or (<= sec 0) (!= err nil))
      (set! sec 30))


    (configureWriteDeadline w r (conv float64 sec))

    ;; Set Content Type assuming StartCPUProfile will work,
    ;; because if it does it starts writing.
    (.Set (.Header w) "Content-Type" "application/octet-stream")
    (.Set (.Header w) "Content-Disposition" "attachment; filename=\"profile\"")
    (when [err (pprof/StartCPUProfile w)] (!= err nil)
      ;; StartCPUProfile failed, so no writes yet.
      (serveError w http/StatusInternalServerError
        (fmt/Sprintf "Could not enable CPU profiling: %s" err))
      (return))

    (sleep r (* (conv time/Duration sec) time/Second))
    (pprof/StopCPUProfile)))





^{:go/end 191} (go/func Trace "Trace responds with the execution trace in binary form.\nTracing lasts for duration specified in seconds GET parameter, or for 1 second if not specified.\nThe package initialization registers it as /debug/pprof/trace.\n" [^http/ResponseWriter w ^{:tag (* http/Request)} r]
  (.Set (.Header w) "X-Content-Type-Options" "nosniff")
  (let [(values sec err) (strconv/ParseFloat (.FormValue r "seconds") 64)]
    (when (or (<= sec 0) (!= err nil))
      (set! sec 1))


    (configureWriteDeadline w r sec)

    ;; Set Content Type assuming trace.Start will work,
    ;; because if it does it starts writing.
    (.Set (.Header w) "Content-Type" "application/octet-stream")
    (.Set (.Header w) "Content-Disposition" "attachment; filename=\"trace\"")
    (when [err (trace/Start w)] (!= err nil)
      ;; trace.Start failed, so no writes yet.
      (serveError w http/StatusInternalServerError
        (fmt/Sprintf "Could not enable tracing: %s" err))
      (return))

    (sleep r (conv time/Duration (* sec (conv float64 time/Second))))
    (trace/Stop)))





^{:go/end 240} (go/func Symbol "Symbol looks up the program counters listed in the request,\nresponding with a table mapping program counters to function names.\nThe package initialization registers it as /debug/pprof/symbol.\n" [^http/ResponseWriter w ^{:tag (* http/Request)} r]
  (.Set (.Header w) "X-Content-Type-Options" "nosniff")
  (.Set (.Header w) "Content-Type" "text/plain; charset=utf-8")

  ;; We have to read the whole POST body before
  ;; writing any output. Buffer the output here.
  (let [^bytes/Buffer buf (zero bytes/Buffer)]

    ;; We don't know how many symbols we have, but we
    ;; do have symbol information. Pprof only cares whether
    ;; this number is 0 (no symbols available) or > 0.
    (fmt/Fprintf (addr buf) "num_symbols: 1\n")

    (let [^{:tag (* bufio/Reader)} b (zero (* bufio/Reader))]
      (if (== (.-Method r) "POST")
        (set! b (bufio/NewReader (.-Body r)))

        (set! b (bufio/NewReader (strings/NewReader (.-RawQuery (.-URL r))))))


      (while true
        (let [(values word err) (.ReadSlice b \+)]
          (when (== err nil)
            (set! word (subslice word 0 (- (len word) 1)))) ; trim +

          (let [(values pc _) (strconv/ParseUint (conv string word) 0 64)]
            (when (!= pc 0)
              (let [f (runtime/FuncForPC (conv uintptr pc))]
                (when (!= f nil)
                  (fmt/Fprintf (addr buf) "%#x %s\n" pc (.Name f)))))



            ;; Wait until here to check for err; the last
            ;; symbol will have an err because it doesn't end in +.
            (when (!= err nil)
              (when (!= err io/EOF)
                (fmt/Fprintf (addr buf) "reading request: %v\n" err))

              (break)))))



      (.Write w (.Bytes buf)))))




^{:go/end 246} (go/func Handler "Handler returns an HTTP handler that serves the named profile.\nAvailable profiles can be found in [runtime/pprof.Profile].\n" ^http/Handler [^string name]
  (conv handler name))


(go/type handler string)

^{:go/end 273} (go/method ServeHTTP [^handler name ^http/ResponseWriter w ^{:tag (* http/Request)} r]
  (.Set (.Header w) "X-Content-Type-Options" "nosniff")
  (let [p (pprof/Lookup (conv string name))]
    (when (== p nil)
      (serveError w http/StatusNotFound "Unknown profile")
      (return))

    (when [sec (.FormValue r "seconds")] (!= sec "")
      (.serveDeltaProfile name w r p sec)
      (return))

    (let [(values gc _) (strconv/Atoi (.FormValue r "gc"))]
      (when (and (== name "heap") (> gc 0))
        (runtime/GC))

      (let [(values debug _) (strconv/Atoi (.FormValue r "debug"))]
        (if (!= debug 0)
          (.Set (.Header w) "Content-Type" "text/plain; charset=utf-8")
          (do
            (.Set (.Header w) "Content-Type" "application/octet-stream")
            (.Set (.Header w) "Content-Disposition" (fmt/Sprintf "attachment; filename=\"%s\"" name))))

        (.WriteTo p w debug)))))


^{:go/end 337} (go/method serveDeltaProfile [^handler name ^http/ResponseWriter w ^{:tag (* http/Request)} r ^{:tag (* pprof/Profile)} p ^string secStr]
  (let [(values sec err) (strconv/ParseInt secStr 10 64)]
    (when (or (!= err nil) (<= sec 0))
      (serveError w http/StatusBadRequest "invalid value for \"seconds\" - must be a positive integer")
      (return))

    ;; 'name' should be a key in profileSupportsDelta.
    (when (not (aget profileSupportsDelta name))
      (serveError w http/StatusBadRequest "\"seconds\" parameter is not supported for this profile type")
      (return))


    (configureWriteDeadline w r (conv float64 sec))

    (let [(values debug _) (strconv/Atoi (.FormValue r "debug"))]
      (when (!= debug 0)
        (serveError w http/StatusBadRequest "seconds and debug params are incompatible")
        (return))

      (let [(values p0 ^:assign err) (collectProfile p)]
        (when (!= err nil)
          (serveError w http/StatusInternalServerError "failed to collect profile")
          (return))


        (let [t (time/NewTimer (* (conv time/Duration sec) time/Second))]
          (defer (.Stop t))

          (select
            (case (<! (.Done (.Context r)))
              (let [err (.Err (.Context r))]
                (if (== err context/DeadlineExceeded)
                  (serveError w http/StatusRequestTimeout (.Error err))
                  ;; TODO: what's a good status code for canceled requests? 400?
                  (serveError w http/StatusInternalServerError (.Error err)))

                (return)))
            (case (<! (.-C t))))


          (let [(values p1 ^:assign err) (collectProfile p)]
            (when (!= err nil)
              (serveError w http/StatusInternalServerError "failed to collect profile")
              (return))

            (let [ts (.-TimeNanos p1)
                ^{:line 321} dur (- (.-TimeNanos p1) (.-TimeNanos p0))]

              (.Scale p0 -1)

              (set! (values p1 err) (profile/Merge (lit (slice (* profile/Profile)) p0 p1)))
              (when (!= err nil)
                (serveError w http/StatusInternalServerError "failed to compute delta")
                (return))


              (set! (.-TimeNanos p1) ts) ; set since we don't know what profile.Merge set for TimeNanos.
              (set! (.-DurationNanos p1) dur)

              (.Set (.Header w) "Content-Type" "application/octet-stream")
              (.Set (.Header w) "Content-Disposition" (fmt/Sprintf "attachment; filename=\"%s-delta\"" name))
              (.Write p1 w))))))))


^{:go/end 351} (go/func collectProfile [^{:tag (* pprof/Profile)} p] :results [(* profile/Profile) error]
  (let [^bytes/Buffer buf (zero bytes/Buffer)]
    (when [err (.WriteTo p (addr buf) 0)] (!= err nil)
      (return nil err))

    (let [ts (.UnixNano (time/Now))
        (values p0 err) (profile/Parse (addr buf))]
      (when (!= err nil)
        (return nil err))

      (set! (.-TimeNanos p0) ts)
      (return p0 nil))))


(go/var profileSupportsDelta (lit (map handler bool)
    ^{:line 354} ["allocs" true]
    ^{:line 355} ["block" true]
    ^{:line 356} ["goroutineleak" true]
    ^{:line 357} ["goroutine" true]
    ^{:line 358} ["heap" true]
    ^{:line 359} ["mutex" true]
    ^{:line 360} ["threadcreate" true]))


(go/var profileDescriptions (lit (map string string)
    ^{:line 364} ["allocs" "A sampling of all past memory allocations"]
    ^{:line 365} ["block" "Stack traces that led to blocking on synchronization primitives"]
    ^{:line 366} ["cmdline" "The command line invocation of the current program"]
    ^{:line 367} ["goroutine" "Stack traces of all current goroutines. Use debug=2 as a query parameter to export in the same format as an unrecovered panic."]
    ^{:line 368} ["heap" "A sampling of memory allocations of live objects. You can specify the gc GET parameter to run GC before taking the heap sample."]
    ^{:line 369} ["mutex" "Stack traces of holders of contended mutexes"]
    ^{:line 370} ["profile" "CPU profile. You can specify the duration in the seconds GET parameter. After you get the profile file, use the go tool pprof command to investigate the profile."]
    ^{:line 371} ["symbol" "Maps given program counters to function names. Counters can be specified in a GET raw query or POST body, multiple counters are separated by '+'."]
    ^{:line 372} ["threadcreate" "Stack traces that led to the creation of new OS threads"]
    ^{:line 373} ["trace" "A trace of execution of the current program. You can specify the duration in the seconds GET parameter. After you get the trace file, use the go tool trace command to investigate the trace."]
    ^{:line 374} ["goroutineleak" "Stack traces of all leaked goroutines. Use debug=2 as a query parameter to export in the same format as an unrecovered panic."]))


(go/type profileEntry (struct
    ^{:line 378 :tag string} Name
    ^{:line 379 :tag string} Href
    ^{:line 380 :tag string} Desc
    ^{:line 381 :tag int} Count))






^{:go/end 425} (go/func Index "Index responds with the pprof-formatted profile named by the request.\nFor example, \"/debug/pprof/heap\" serves the \"heap\" profile.\nIndex responds to a request for \"/debug/pprof/\" with an HTML page\nlisting the available profiles.\n" [^http/ResponseWriter w ^{:tag (* http/Request)} r]
  (when [(values name found) (strings/CutPrefix (.-Path (.-URL r)) "/debug/pprof/")] found
    (when (!= name "")
      (.ServeHTTP (conv handler name) w r)
      (return)))



  (.Set (.Header w) "X-Content-Type-Options" "nosniff")
  (.Set (.Header w) "Content-Type" "text/html; charset=utf-8")

  (let [^{:tag (slice profileEntry)} profiles (zero (slice profileEntry))]
    (range [_ p (pprof/Profiles)]
      (set! profiles (append profiles ^{:go/breaks [2 4 6 8]} (lit profileEntry
            :Name (.Name p)
            :Href (.Name p)
            :Desc (aget profileDescriptions (.Name p))
            :Count (.Count p)))))



    ;; Adding other profiles exposed from within this package
    (range [_ p (lit (slice string) "cmdline" "profile" "symbol" "trace")]
      (set! profiles (append profiles ^{:go/breaks [2 4 6]} (lit profileEntry
            :Name p
            :Href p
            :Desc (aget profileDescriptions p)))))



    (^{:inst [(slice profileEntry) profileEntry]} slices/SortFunc profiles ^{:go/end 420} (fn ^int [^profileEntry a ^profileEntry b]
        (strings/Compare (.-Name a) (.-Name b))))


    (when [err (indexTmplExecute w profiles)] (!= err nil)
      (log/Print err))))



^{:go/end 471} (go/func indexTmplExecute ^error [^io/Writer w ^{:tag (slice profileEntry)} profiles]
  (let [^bytes/Buffer b (zero bytes/Buffer)]
    (.WriteString b "<html>\n<head>\n<title>/debug/pprof/</title>\n<style>\n.profile-name{\n\tdisplay:inline-block;\n\twidth:6rem;\n}\n</style>\n</head>\n<body>\n/debug/pprof/\n<br>\n<p>Set debug=1 as a query parameter to export in legacy text format</p>\n<br>\nTypes of profiles available:\n<table>\n<thead><td>Count</td><td>Profile</td></thead>\n")



















    (range [_ profile profiles]
      (let [link (addr (lit url/URL :Path (.-Href profile) :RawQuery "debug=1"))]
        (fmt/Fprintf (addr b) "<tr><td>%d</td><td><a href='%s'>%s</a></td></tr>\n" (.-Count profile) link (html/EscapeString (.-Name profile)))))


    (.WriteString b "</table>\n<a href=\"goroutine?debug=2\">full goroutine stack dump</a>\n<br>\n<p>\nProfile Descriptions:\n<ul>\n")






    (range [_ profile profiles]
      (fmt/Fprintf (addr b) "<li><div class=profile-name>%s: </div> %s</li>\n" (html/EscapeString (.-Name profile)) (html/EscapeString (.-Desc profile))))

    (.WriteString b "</ul>\n</p>\n</body>\n</html>")




    (let [(values _ err) (.Write w (.Bytes b))]
      ^{:line 470} err)))

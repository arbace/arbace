^{:go/end 418} (go/method Clone "Clone returns a deep copy of r with its context changed to ctx.\nThe provided ctx must be non-nil.\n\nClone only makes a shallow copy of the Body field.\n\nFor an outgoing client request, the context controls the entire\nlifetime of a request and its response: obtaining a connection,\nsending the request, and reading the response headers and body.\n" ^{:tag (* Request)} [^{:tag (* Request)} r ^context/Context ctx]
  (when (== ctx nil)
    (panic "nil context"))

  (let [r2 (new Request)]
    (set! @r2 @r)
    (set! (.-ctx r2) ctx)
    (set! (.-URL r2) (cloneURL (.-URL r)))
    (set! (.-Header r2) (.Clone (.-Header r)))
    (set! (.-Trailer r2) (.Clone (.-Trailer r)))
    (when [s (.-TransferEncoding r)] (!= s nil)
      (let [s2 (make (slice string) (len s))]
        (copy s2 s)
        (set! (.-TransferEncoding r2) s2)))

    (set! (.-Form r2) (cloneURLValues (.-Form r)))
    (set! (.-PostForm r2) (cloneURLValues (.-PostForm r)))
    (set! (.-MultipartForm r2) (cloneMultipartForm (.-MultipartForm r)))

    ;; Copy matches and otherValues. See issue 61410.
    (when [s (.-matches r)] (!= s nil)
      (let [s2 (make (slice string) (len s))]
        (copy s2 s)
        (set! (.-matches r2) s2)))


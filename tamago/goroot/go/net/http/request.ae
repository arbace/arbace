    (aset (.-matches r) i value)
    (do
      (when (== (.-otherValues r) nil)
        (set! (.-otherValues r) (lit (map string string))))

      (aset (.-otherValues r) name value))))





^{:go/end 1534} (go/method patIndex "patIndex returns the index of name in the list of named wildcards of the\nrequest's pattern, or -1 if there is no such name.\n" ^int [^{:tag (* Request)} r ^string name]
  ;; The linear search seems expensive compared to a map, but just creating the map
  ;; takes a lot of time, and most patterns will just have a couple of wildcards.
  (when (== (.-pat r) nil)
    (return -1))

  ^{:go/breaks [[3 1533]]} (let [i 0]
    (range [_ seg (.-segments (.-pat r))]
      (when (and (.-wild seg) (!= (.-s seg) ""))
        (when (== name (.-s seg))
          (return i))

        (inc! i)))


    -1))



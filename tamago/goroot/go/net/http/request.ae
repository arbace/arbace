    (return (errors/New "http: multipart handled by MultipartReader")))

  (let [^error parseFormErr (zero error)]
    (when (== (.-Form r) nil)
      ;; Let errors in ParseForm fall through, and just
      ;; return it at the end.
      (set! parseFormErr (.ParseForm r)))

    (when (!= (.-MultipartForm r) nil)
      (return nil))


    (let [(values mr err) (.multipartReader r false)]
      (when (!= err nil)
        (return err))


      (let [(values f ^:assign err) (.ReadForm mr maxMemory)]
        (when (!= err nil)
          (return err))


        (when (== (.-PostForm r) nil)
          (set! (.-PostForm r) (make url/Values)))

        (range [k v (.-Value f)]
          (aset (.-Form r) k (append (aget (.-Form r) k) (spread v)))
          ;; r.PostForm should also be populated. See Issue 9305.
          (aset (.-PostForm r) k (append (aget (.-PostForm r) k) (spread v))))


        (set! (.-MultipartForm r) f)

        ^{:line 1428} parseFormErr))))













^{:go/breaks [[6 1449]] :go/end 1450} (go/method FormValue "FormValue returns the first value for the named component of the query.\nThe precedence order:\n 1. application/x-www-form-urlencoded form body (POST, PUT, PATCH only)\n 2. query parameters (always)\n 3. multipart/form-data form body (always)\n\nFormValue calls [Request.ParseMultipartForm] and [Request.ParseForm]\nif necessary and ignores any errors returned by these functions.\nIf key is not present, FormValue returns the empty string.\nTo access multiple values of the same key, call ParseForm and\nthen inspect [Request.Form] directly.\n" ^string [^{:tag (* Request)} r ^string key]
  (when (== (.-Form r) nil)
    (.ParseMultipartForm r defaultMaxMemory))

  (when [vs (aget (.-Form r) key)] (> (len vs) 0)
    (return (aget vs 0)))

  "")








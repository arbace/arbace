^{:go/breaks [[7 269]] :go/end 270} (go/func hasToken "hasToken reports whether token appears with v, ASCII\ncase-insensitive, with space or comma boundaries.\ntoken must be all lowercase.\nv may contain mixed cased.\n" ^bool [^string v ^string token]
  (when (or (> (len token) (len v)) (== token ""))
    (return false))

  (when (== v token)

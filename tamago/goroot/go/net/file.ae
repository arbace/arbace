(in-ns 'go.net) (go/file "file.go" :imports [

    ^{:line 7} [os "os"]])

;; BUG(mikio): On JS, the FileConn, FileListener and
;; FilePacketConn functions are not implemented.

(go/type fileAddr string)

^{:go/end 14} (go/method Network ^string [fileAddr] "file+net")
^{:go/end 15} (go/method String ^string [^fileAddr f] (conv string f))





^{:go/end 27} (go/func FileConn "FileConn returns a copy of the network connection corresponding to\nthe open file f.\nIt is the caller's responsibility to close f when finished.\nClosing c does not affect f, and closing f does not affect c.\n" [^{:tag (* os/File)} f] :results [^Conn c ^error err]
  (set! (values c err) (fileConn f))
  (when (!= err nil)
    (set! err (addr (lit OpError :Op "file" :Net "file+net" :Source nil :Addr (conv fileAddr (.Name f)) :Err err))))

  (return))






^{:go/end 39} (go/func FileListener "FileListener returns a copy of the network listener corresponding\nto the open file f.\nIt is the caller's responsibility to close ln when finished.\nClosing ln does not affect f, and closing f does not affect ln.\n" [^{:tag (* os/File)} f] :results [^Listener ln ^error err]
  (set! (values ln err) (fileListener f))
  (when (!= err nil)
    (set! err (addr (lit OpError :Op "file" :Net "file+net" :Source nil :Addr (conv fileAddr (.Name f)) :Err err))))

  (return))






^{:go/end 51} (go/func FilePacketConn "FilePacketConn returns a copy of the packet network connection\ncorresponding to the open file f.\nIt is the caller's responsibility to close f when finished.\nClosing c does not affect f, and closing f does not affect c.\n" [^{:tag (* os/File)} f] :results [^PacketConn c ^error err]
  (set! (values c err) (filePacketConn f))
  (when (!= err nil)
    (set! err (addr (lit OpError :Op "file" :Net "file+net" :Source nil :Addr (conv fileAddr (.Name f)) :Err err))))

  (return))

(in-ns 'go.net) (go/file "sockaddr_posix.go" :build ["//go:build unix || js || wasip1 || windows || tamago"] :imports [


    ^{:line 10} [syscall "syscall"]])




(go/type sockaddr "A sockaddr represents a TCP, UDP, IP or Unix network endpoint\naddress that can be converted into a syscall.Sockaddr.\n" (interface
    ^{:line 16} Addr



    (^{:doc "family returns the platform-dependent address family\nidentifier.\n"} family ^int [])



    (^{:doc "isWildcard reports whether the address is a wildcard\naddress.\n"} isWildcard ^bool [])





    (^{:doc "sockaddr returns the address converted into a syscall\nsockaddr type that implements syscall.Sockaddr\ninterface. It returns a nil interface when the address is\nnil.\n"} sockaddr [^int family] :results [syscall/Sockaddr error])


    (^{:doc "toLocal maps the zero address to a local system address (127.0.0.1 or ::1)\n"} toLocal ^sockaddr [^string net])))


^{:go/end 58} (go/method addrFunc ^{:tag (func [syscall/Sockaddr] [Addr])} [^{:tag (* netFD)} fd]
  (switch (.-family fd)
    (case [syscall/AF_INET syscall/AF_INET6]
      (switch (.-sotype fd)
        (case [syscall/SOCK_STREAM]
          (return sockaddrToTCP))
        (case [syscall/SOCK_DGRAM]
          (return sockaddrToUDP))
        (case [syscall/SOCK_RAW]
          (return sockaddrToIP))))

    (case [syscall/AF_UNIX]
      (switch (.-sotype fd)
        (case [syscall/SOCK_STREAM]
          (return sockaddrToUnix))
        (case [syscall/SOCK_DGRAM]
          (return sockaddrToUnixgram))
        (case [syscall/SOCK_SEQPACKET]
          (return sockaddrToUnixpacket)))))


  ^{:go/end 57} (fn ^Addr [syscall/Sockaddr] nil))

^{:go/end 147} (go/method Read [^{:tag (* pipe)} p ^{:tag (slice byte)} b] :results [int error]
  (let [(values n err) (.read p b)]
    (when (and (!= err nil) (!= err io/EOF) (!= err io/ErrClosedPipe))
      (set! err (addr (lit OpError :Op "read" :Net "pipe" :Err err))))

    (return n err)))


^{:go/end 171} (go/method read [^{:tag (* pipe)} p ^{:tag (slice byte)} b] :results [^int n ^error err]
  (switch
    (case [(isClosedChan (.-localDone p))]
      (return 0 io/ErrClosedPipe))
    (case [(isClosedChan (.-remoteDone p))]
      (return 0 io/EOF))
    (case [(isClosedChan (.wait (.-readDeadline p)))]
      (return 0 os/ErrDeadlineExceeded)))


  (select
    (case [bw (<! (.-rdRx p))]
      (let [nr (copy b bw)]
        (>! (.-rdTx p) nr)
        (return nr nil)))
    (case (<! (.-localDone p))
      (return 0 io/ErrClosedPipe))
    (case (<! (.-remoteDone p))
      (return 0 io/EOF))
    (case (<! (.wait (.-readDeadline p)))
      (return 0 os/ErrDeadlineExceeded))))



^{:go/end 179} (go/method Write [^{:tag (* pipe)} p ^{:tag (slice byte)} b] :results [int error]
  (let [(values n err) (.write p b)]
    (when (and (!= err nil) (!= err io/ErrClosedPipe))
      (set! err (addr (lit OpError :Op "write" :Net "pipe" :Err err))))

    (return n err)))


^{:go/end 208} (go/method write [^{:tag (* pipe)} p ^{:tag (slice byte)} b] :results [^int n ^error err]
  (switch
    (case [(isClosedChan (.-localDone p))]
      (return 0 io/ErrClosedPipe))
    (case [(isClosedChan (.-remoteDone p))]
      (return 0 io/ErrClosedPipe))
    (case [(isClosedChan (.wait (.-writeDeadline p)))]
      (return 0 os/ErrDeadlineExceeded)))


  (.Lock (.-wrMu p)) ; Ensure entirety of b is written together
  (defer (.Unlock (.-wrMu p)))
  (for [once true] (or once (> (len b) 0)) (set! once false)
    (select
      (case (>! (.-wrTx p) b)
        (let [nw (<! (.-wrRx p))]
          (set! b (subslice b nw))
          (set! n + nw)))
      (case (<! (.-localDone p))
        (return n io/ErrClosedPipe))
      (case (<! (.-remoteDone p))
        (return n io/ErrClosedPipe))
      (case (<! (.wait (.-writeDeadline p)))
        (return n os/ErrDeadlineExceeded))))


  (return n nil))


^{:go/breaks [6] :go/end 217} (go/method SetDeadline ^error [^{:tag (* pipe)} p ^time/Time t]

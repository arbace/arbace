(go/type pipeDeadline "pipeDeadline is an abstraction for handling timeouts.\n" (struct
    ^{:line 16 :tag sync/Mutex} mu ; Guards timer and cancel
    ^{:line 17 :tag (* time/Timer)} timer
    ^{:line 18 :tag (chan (struct))} cancel)) ; Must be non-nil


^{:go/end 23} (go/func makePipeDeadline ^pipeDeadline []
  (lit pipeDeadline :cancel (make (chan (struct)))))








^{:go/end 64} (go/method set "set sets the point in time when the deadline will time out.\nA timeout event is signaled by closing the channel returned by waiter.\nOnce a timeout has occurred, the deadline can be refreshed by specifying a\nt value in the future.\n\nA zero value for t prevents timeout.\n" [^{:tag (* pipeDeadline)} d ^time/Time t]
  (.Lock (.-mu d))
  (defer (.Unlock (.-mu d)))

  (when (and (!= (.-timer d) nil) (not (.Stop (.-timer d))))
    (<! (.-cancel d))) ; Wait for the timer callback to finish and close cancel

  (set! (.-timer d) nil)

  ;; Time is zero, then there is no deadline.
  (let [closed (isClosedChan (.-cancel d))]
    (when (.IsZero t)
      (when closed
        (set! (.-cancel d) (make (chan (struct)))))

      (return))


    ;; Time in the future, setup a timer to cancel in the future.
    (when [dur (time/Until t)] (> dur 0)
      (when closed
        (set! (.-cancel d) (make (chan (struct)))))

      (set! (.-timer d) (time/AfterFunc dur ^{:go/end 56} (fn []
            (close (.-cancel d)))))

      (return))


    ;; Time in the past, so close immediately.
    (when (not closed)
      (close (.-cancel d)))))




^{:go/end 71} (go/method wait "wait returns a channel that is closed when the deadline is exceeded.\n" ^{:tag (chan (struct))} [^{:tag (* pipeDeadline)} d]
  (.Lock (.-mu d))
  (defer (.Unlock (.-mu d)))
  (.-cancel d))


^{:go/end 80} (go/func isClosedChan ^bool [^{:tag (chan :recv (struct))} c]
  (select

    ^{:line 93 :tag (chan :send int)} rdTx



    ^{:line 97 :tag (chan :send (slice byte)) :doc "Used by local Write to interact with remote Read.\nSuccessful send on wrTx is always followed by receive on wrRx.\n"} wrTx

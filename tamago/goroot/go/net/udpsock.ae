^{:go/end 139} (go/method ReadFromUDP "ReadFromUDP acts like [UDPConn.ReadFrom] but returns a UDPAddr.\n" [^{:tag (* UDPConn)} c ^{:tag (slice byte)} b] :results [^int n ^{:tag (* UDPAddr)} addr ^error err]

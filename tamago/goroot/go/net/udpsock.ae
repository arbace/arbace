  (return n addr err))









^{:go/end 193} (go/method ReadMsgUDP "ReadMsgUDP reads a message from c, copying the payload into b and\nthe associated out-of-band data into oob. It returns the number of\nbytes copied into b, the number of bytes copied into oob, the flags\nthat were set on the message and the source address of the message.\n\nThe packages [golang.org/x/net/ipv4] and [golang.org/x/net/ipv6] can be\nused to manipulate IP-level socket options in oob.\n" [^{:tag (* UDPConn)} c ^{:tag (slice byte)} b ^{:tag (slice byte)} oob] :results [^int n ^int oobn ^int flags ^{:tag (* UDPAddr)} addr ^error err]
  (let [^netip/AddrPort ap (zero netip/AddrPort)]
    (set! (values n oobn flags ap err) (.ReadMsgUDPAddrPort c b oob))
    (when (.IsValid ap)
      (set! addr (UDPAddrFromAddrPort ap)))

    (return)))



^{:go/end 205} (go/method ReadMsgUDPAddrPort "ReadMsgUDPAddrPort is like [UDPConn.ReadMsgUDP] but returns an [netip.AddrPort] instead of a [UDPAddr].\n" [^{:tag (* UDPConn)} c ^{:tag (slice byte)} b ^{:tag (slice byte)} oob] :results [^int n ^int oobn ^int flags ^netip/AddrPort addr ^error err]

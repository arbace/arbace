    (return n addr err)))



^{:go/end 161} (go/method ReadFrom "ReadFrom implements the [PacketConn] ReadFrom method.\n" [^{:tag (* UDPConn)} c ^{:tag (slice byte)} b] :results [int Addr error]
  (let [(values n addr err) (.readFromUDP c b (addr (lit UDPAddr)))]

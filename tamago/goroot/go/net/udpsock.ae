^{:go/end 39} (go/method AddrPort "AddrPort returns the [UDPAddr] a as a [netip.AddrPort].\n\nIf a.Port does not fit in a uint16, it's silently truncated.\n\nIf a is nil, a zero value is returned.\n" ^netip/AddrPort [^{:tag (* UDPAddr)} a]
  (when (== a nil)
    (return (lit netip/AddrPort)))

  (let [(values na _) (netip/AddrFromSlice (.-IP a))]
    (set! na (.WithZone na (.-Zone a)))
    (netip/AddrPortFrom na (conv uint16 (.-Port a)))))



^{:go/end 42} (go/method Network "Network returns the address's network name, \"udp\".\n" ^string [^{:tag (* UDPAddr)} a] "udp")

^{:go/end 53} (go/method String ^string [^{:tag (* UDPAddr)} a]
  (when (== a nil)
    (return "<nil>"))

  (let [ip (ipEmptyString (.-IP a))]
    (when (!= (.-Zone a) "")
      (return (JoinHostPort (+ ip "%" (.-Zone a)) (strconv/Itoa (.-Port a)))))

    (JoinHostPort ip (strconv/Itoa (.-Port a)))))


^{:go/end 60} (go/method isWildcard ^bool [^{:tag (* UDPAddr)} a]
  (when (or (== a nil) (== (.-IP a) nil))
    (return true))

  (.IsUnspecified (.-IP a)))


^{:go/end 67} (go/method opAddr ^Addr [^{:tag (* UDPAddr)} a]

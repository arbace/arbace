(in-ns 'go.net.netip) (go/file "uint128.go" :imports [

    ^{:line 7} [bits "math/bits"]])





(go/type uint128 "uint128 represents a uint128 using two uint64s.\n\nWhen the methods below mention a bit number, bit 0 is the most\nsignificant bit (in hi) and bit 127 is the lowest (lo&1).\n" (struct
    ^{:line 14 :tag uint64} hi
    ^{:line 15 :tag uint64} lo))




^{:go/end 22} (go/func mask6 "mask6 returns a uint128 bitmask with the topmost n bits of a\n128-bit number.\n" ^uint128 [^int n]
  (lit uint128 (bit-not (>> (bit-not (conv uint64 0)) n)) (<< (bit-not (conv uint64 0)) (- 128 n))))







^{:go/end 29} (go/method isZero "isZero reports whether u == 0.\n\nIt's faster than u == (uint128{}) because the compiler (as of Go\n1.15/1.16b1) doesn't do this trick and instead inserts a branch in\nits eq alg's generated code.\n" ^bool [^uint128 u] (== (bit-or (.-hi u) (.-lo u)) 0))


^{:go/end 34} (go/method and "and returns the bitwise AND of u and m (u&m).\n" ^uint128 [^uint128 u ^uint128 m]
  (lit uint128 (bit-and (.-hi u) (.-hi m)) (bit-and (.-lo u) (.-lo m))))



^{:go/end 39} (go/method xor "xor returns the bitwise XOR of u and m (u^m).\n" ^uint128 [^uint128 u ^uint128 m]
  (lit uint128 (bit-xor (.-hi u) (.-hi m)) (bit-xor (.-lo u) (.-lo m))))



^{:go/end 44} (go/method or "or returns the bitwise OR of u and m (u|m).\n" ^uint128 [^uint128 u ^uint128 m]
  (lit uint128 (bit-or (.-hi u) (.-hi m)) (bit-or (.-lo u) (.-lo m))))



^{:go/end 49} (go/method not "not returns the bitwise NOT of u.\n" ^uint128 [^uint128 u]
  (lit uint128 (bit-not (.-hi u)) (bit-not (.-lo u))))



^{:go/end 55} (go/method subOne "subOne returns u - 1.\n" ^uint128 [^uint128 u]
  (let [(values lo borrow) (bits/Sub64 (.-lo u) 1 0)]
    (lit uint128 (- (.-hi u) borrow) lo)))



^{:go/end 61} (go/method addOne "addOne returns u + 1.\n" ^uint128 [^uint128 u]
  (let [(values lo carry) (bits/Add64 (.-lo u) 1 0)]
    (lit uint128 (+ (.-hi u) carry) lo)))






^{:go/end 69} (go/method halves "halves returns the two uint64 halves of the uint128.\n\nLogically, think of it as returning two uint64s.\nIt only returns pointers for inlining reasons on 32-bit platforms.\n" ^{:tag (array 2 (* uint64))} [^{:tag (* uint128)} u]
  (lit (array 2 (* uint64)) (addr (.-hi u)) (addr (.-lo u))))




^{:go/end 75} (go/method bitsSetFrom "bitsSetFrom returns a copy of u with the given bit\nand all subsequent ones set.\n" ^uint128 [^uint128 u ^uint8 bit]
  (.or u (.not (mask6 (conv int bit)))))




^{:go/end 81} (go/method bitsClearedFrom "bitsClearedFrom returns a copy of u with the given bit\nand all subsequent ones cleared.\n" ^uint128 [^uint128 u ^uint8 bit]
  (.and u (mask6 (conv int bit))))

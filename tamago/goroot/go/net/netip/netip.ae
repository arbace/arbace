    (switch (aget s i)
      (case [\.]
        (return (parseIPv4 s)))
      (case [\:]
        (return (parseIPv6 s)))
      (case [\%]
        ;; Assume that this was trying to be an IPv6 address with
        ;; a zone specifier, but the address is missing.
        (return (lit Addr) (lit parseAddrError :in s :msg "missing IPv6 address")))))


  (return (lit Addr) (lit parseAddrError :in s :msg "unable to parse IP")))





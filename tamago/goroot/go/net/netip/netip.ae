^{:go/end 128} (go/func ParseAddr "ParseAddr parses s as an IP address, returning the result. The string\ns can be in dotted decimal (\"192.0.2.1\"), IPv6 (\"2001:db8::68\"),\nor IPv6 with a scoped addressing zone (\"fe80::1cc0:3e8c:119f:c2e1%ens18\").\n" [^string s] :results [Addr error]

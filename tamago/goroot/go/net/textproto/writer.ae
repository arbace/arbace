(in-ns 'go.net.textproto) (go/file "writer.go" :imports [


    ^{:line 8} [bufio "bufio"]
    ^{:line 9} [fmt "fmt"]
    ^{:line 10} [io "io"]])




(go/type Writer "A Writer implements convenience methods for writing\nrequests or responses to a text protocol network connection.\n" (struct
    ^{:line 16 :tag (* bufio/Writer)} W
    ^{:line 17 :tag (* dotWriter)} dot))



^{:go/end 23} (go/func NewWriter "NewWriter returns a new [Writer] writing to w.\n" ^{:tag (* Writer)} [^{:tag (* bufio/Writer)} w]
  (addr (lit Writer :W w)))


(go/var crnl (lit (slice byte) \return \newline))
(go/var dotcrnl (lit (slice byte) \. \return \newline))


^{:go/end 34} (go/method PrintfLine "PrintfLine writes the formatted output followed by \\r\\n.\n" ^error [^{:tag (* Writer)} w ^string format & ^{:tag (slice any)} args]
  (.closeDot w)
  (fmt/Fprintf (.-W w) format (spread args))
  (.Write (.-W w) crnl)
  (.Flush (.-W w)))









^{:go/end 47} (go/method DotWriter "DotWriter returns a writer that can be used to write a dot-encoding to w.\nIt takes care of inserting leading dots when necessary,\ntranslating line-ending \\n into \\r\\n, and adding the final .\\r\\n line\nwhen the DotWriter is closed. The caller should close the\nDotWriter before the next call to a method on w.\n\nSee the documentation for the [Reader.DotReader] method for details about dot-encoding.\n" ^io/WriteCloser [^{:tag (* Writer)} w]
  (.closeDot w)
  (set! (.-dot w) (addr (lit dotWriter :w w)))
  (.-dot w))


^{:go/end 53} (go/method closeDot [^{:tag (* Writer)} w]
  (when (!= (.-dot w) nil)
    (.Close (.-dot w)))) ; sets w.dot = nil



(go/type dotWriter (struct
    ^{:line 56 :tag (* Writer)} w
    ^{:line 57 :tag int} state))


(go/const
  ^{:line 61} [^{:val 0} wstateBegin iota] ; initial state; must be zero
  ^{:line 62} [^{:val 1} wstateBeginLine] ; beginning of line
  ^{:line 63} [^{:val 2} wstateCR] ; wrote \r (possibly at end of line)
  ^{:line 64} [^{:val 3} wstateData]) ; writing data in middle of line


^{:go/end 101} (go/method Write [^{:tag (* dotWriter)} d ^{:tag (slice byte)} b] :results [^int n ^error err]
  (let [bw (.-W (.-w d))]
    (while (< n (len b))
      (let [c (aget b n)]
        (switch (.-state d)
          (case [wstateBegin wstateBeginLine]
            (set! (.-state d) wstateData)
            (when (== c \.)
              ;; escape leading dot
              (.WriteByte bw \.))

            (fallthrough))

          (case [wstateData]
            (when (== c \return)
              (set! (.-state d) wstateCR))

            (when (== c \newline)
              (.WriteByte bw \return)
              (set! (.-state d) wstateBeginLine)))


          (case [wstateCR]
            (set! (.-state d) wstateData)
            (when (== c \newline)
              (set! (.-state d) wstateBeginLine))))


        (when [(set! err (.WriteByte bw c))] (!= err nil)
          (break))

        (inc! n)))

    (return)))


^{:go/end 119} (go/method Close ^error [^{:tag (* dotWriter)} d]
  (when (== (.-dot (.-w d)) d)
    (set! (.-dot (.-w d)) nil))

  (let [bw (.-W (.-w d))]
    (switch (.-state d)
      (default
        (.WriteByte bw \return)
        (fallthrough))
      (case [wstateCR]
        (.WriteByte bw \newline)
        (fallthrough))
      (case [wstateBeginLine]
        (.Write bw dotcrnl)))

    (.Flush bw)))

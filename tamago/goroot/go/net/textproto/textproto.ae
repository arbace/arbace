;; Package textproto implements generic support for text-based request/response
;; protocols in the style of HTTP, NNTP, and SMTP.
;;
;; This package enforces the HTTP/1.1 character set defined by
;; RFC 9112 for header keys and values.
;;
;; The package provides:
;;
;; [Error], which represents a numeric error response from
;; a server.
;;
;; [Pipeline], to manage pipelined requests and responses
;; in a client.
;;
;; [Reader], to read numeric response code lines,
;; key: value headers, lines wrapped with leading spaces
;; on continuation lines, and whole text blocks ending
;; with a dot on a line by itself.
;;
;; [Writer], to write dot-encoded text blocks.
;;
;; [Conn], a convenient packaging of [Reader], [Writer], and [Pipeline] for use
;; with a single network connection.
(in-ns 'go.net.textproto) (go/file "textproto.go" :doc "Package textproto implements generic support for text-based request/response\nprotocols in the style of HTTP, NNTP, and SMTP.\n\nThis package enforces the HTTP/1.1 character set defined by\nRFC 9112 for header keys and values.\n\nThe package provides:\n\n[Error], which represents a numeric error response from\na server.\n\n[Pipeline], to manage pipelined requests and responses\nin a client.\n\n[Reader], to read numeric response code lines,\nkey: value headers, lines wrapped with leading spaces\non continuation lines, and whole text blocks ending\nwith a dot on a line by itself.\n\n[Writer], to write dot-encoded text blocks.\n\n[Conn], a convenient packaging of [Reader], [Writer], and [Pipeline] for use\nwith a single network connection.\n" :imports [


    ^{:line 31} [bufio "bufio"]
    ^{:line 32} [fmt "fmt"]
    ^{:line 33} [io "io"]
    ^{:line 34} [net "net"]])



(go/type Error "An Error represents a numeric error response from a server.\n" (struct
    ^{:line 39 :tag int} Code
    ^{:line 40 :tag string} Msg))


^{:go/end 45} (go/method Error ^string [^{:tag (* Error)} e]
  (fmt/Sprintf "%03d %q" (.-Code e) (.-Msg e)))




(go/type ProtocolError "A ProtocolError describes a protocol violation such\nas an invalid response or a hung-up connection.\n" string)

^{:go/end 53} (go/method Error ^string [^ProtocolError p]
  (conv string p))







(go/type Conn "A Conn represents a textual network protocol connection.\nIt consists of a [Reader] and [Writer] to manage I/O\nand a [Pipeline] to sequence concurrent requests on the connection.\nThese embedded types carry methods with them;\nsee the documentation of those types for details.\n" (struct
    ^{:line 61} Reader
    ^{:line 62} Writer
    ^{:line 63} Pipeline
    ^{:line 64 :tag io/ReadWriteCloser} conn))



^{:go/end 74} (go/func NewConn "NewConn returns a new [Conn] using conn for I/O.\n" ^{:tag (* Conn)} [^io/ReadWriteCloser conn]
  (addr ^{:go/breaks [2 4 6]} (lit Conn
      :Reader (lit Reader :R (bufio/NewReader conn))
      :Writer (lit Writer :W (bufio/NewWriter conn))
      :conn conn)))




^{:go/end 79} (go/method Close "Close closes the connection.\n" ^error [^{:tag (* Conn)} c]
  (.Close (.-conn c)))




^{:go/end 89} (go/func Dial "Dial connects to the given address on the given network using [net.Dial]\nand then returns a new [Conn] for the connection.\n" [^string network ^string addr] :results [(* Conn) error]
  (let [(values c err) (net/Dial network addr)]
    (when (!= err nil)
      (return nil err))

    (return (NewConn c) nil)))


























^{:go/end 124} (go/method Cmd "Cmd is a convenience method that sends a command after\nwaiting its turn in the pipeline. The command text is the\nresult of formatting format with args and appending \\r\\n.\nCmd returns the id of the command, for use with StartResponse and EndResponse.\n\nFor example, a client might run a HELP command that returns a dot-body\nby using:\n\n\tid, err := c.Cmd(\"HELP\")\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\n\tc.StartResponse(id)\n\tdefer c.EndResponse(id)\n\n\tif _, _, err = c.ReadCodeLine(110); err != nil {\n\t\treturn nil, err\n\t}\n\ttext, err := c.ReadDotBytes()\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treturn c.ReadCodeLine(250)\n" [^{:tag (* Conn)} c ^string format & ^{:tag (slice any)} args] :results [^uint id ^error err]
  (set! id ^{:go/via [Pipeline]} (.Next c))
  ^{:go/via [Pipeline]} (.StartRequest c id)
  (set! err ^{:go/via [Writer]} (.PrintfLine c format (spread args)))
  ^{:go/via [Pipeline]} (.EndRequest c id)
  (when (!= err nil)
    (return 0 err))

  (return id nil))



^{:go/end 135} (go/func TrimString "TrimString returns s without leading and trailing ASCII space.\n" ^string [^string s]
  (while (and (> (len s) 0) (isASCIISpace (aget s 0)))
    (set! s (subslice s 1)))

  (while (and (> (len s) 0) (isASCIISpace (aget s (- (len s) 1))))
    (set! s (subslice s _ (- (len s) 1))))

  ^{:line 134} s)



^{:go/end 146} (go/func TrimBytes "TrimBytes returns b without leading and trailing ASCII space.\n" ^{:tag (slice byte)} [^{:tag (slice byte)} b]
  (while (and (> (len b) 0) (isASCIISpace (aget b 0)))
    (set! b (subslice b 1)))

  (while (and (> (len b) 0) (isASCIISpace (aget b (- (len b) 1))))
    (set! b (subslice b _ (- (len b) 1))))

  ^{:line 145} b)


^{:go/end 150} (go/func isASCIISpace ^bool [^byte b]
  (or (== b \space) (== b \tab) (== b \newline) (== b \return)))


^{:go/end 155} (go/func isASCIILetter ^bool [^byte b]
  (set! b bit-or 0x20) ; make lower case
  (and (<= \a b) (<= b \z)))

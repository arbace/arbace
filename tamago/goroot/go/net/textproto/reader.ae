        (set! upper (== c \-))) ; for next time

      (.Do commonHeaderOnce initCommonHeader)
      ;; The compiler recognizes m[string(byteSlice)] as a special
      ;; case, so a copy of a's bytes into a new string does not
      ;; happen in this map lookup:
      (when [v (aget commonHeader (conv string a))] (!= v "")
        (return v true))

      (return (conv string a) true))))



(go/var ^{:tag (map string string) :doc "commonHeader interns common header strings.\n"} commonHeader)

(go/var ^sync/Once commonHeaderOnce)


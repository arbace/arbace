(in-ns 'go.net.textproto) (go/file "header.go" :imports [])



(go/type MIMEHeader "A MIMEHeader represents a MIME-style header mapping\nkeys to sets of values.\n" (map string (slice string)))



^{:go/end 16} (go/method Add "Add adds the key, value pair to the header.\nIt appends to any existing values associated with key.\n" [^MIMEHeader h ^string key ^string value]
  (set! key (CanonicalMIMEHeaderKey key))
  (aset h key (append (aget h key) value)))





^{:go/end 23} (go/method Set "Set sets the header entries associated with key to\nthe single element value. It replaces any existing\nvalues associated with key.\n" [^MIMEHeader h ^string key ^string value]
  (aset h (CanonicalMIMEHeaderKey key) (lit (slice string) value)))







^{:go/end 39} (go/method Get "Get gets the first value associated with the given key.\nIt is case insensitive; [CanonicalMIMEHeaderKey] is used\nto canonicalize the provided key.\nIf there are no values associated with the key, Get returns \"\".\nTo use non-canonical keys, access the map directly.\n" ^string [^MIMEHeader h ^string key]
  (when (== h nil)
    (return ""))

  (let [v (aget h (CanonicalMIMEHeaderKey key))]
    (when (== (len v) 0)
      (return ""))

    (aget v 0)))







^{:go/end 51} (go/method Values "Values returns all values associated with the given key.\nIt is case insensitive; [CanonicalMIMEHeaderKey] is\nused to canonicalize the provided key. To use non-canonical\nkeys, access the map directly.\nThe returned slice is not a copy.\n" ^{:tag (slice string)} [^MIMEHeader h ^string key]
  (when (== h nil)
    (return nil))

  (aget h (CanonicalMIMEHeaderKey key)))



^{:go/end 56} (go/method Del "Del deletes the values associated with key.\n" [^MIMEHeader h ^string key]
  (delete h (CanonicalMIMEHeaderKey key)))

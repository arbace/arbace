  ;; We read the header successfully. If we see an error now,
  ;; we can still recover and move on to the next request.
  (set! keepReading true)

  (let [dot (strings/LastIndex (.-ServiceMethod req) ".")]
    (when (< dot 0)
      (set! err (errors/New (+ "rpc: service/method request ill-formed: " (.-ServiceMethod req))))
      (return))

    (let [serviceName (subslice (.-ServiceMethod req) _ dot)
        ^{:line 609} methodName (subslice (.-ServiceMethod req) (+ dot 1))

        ;; Look up the request.
        (values svci ok) (.Load (.-serviceMap server) serviceName)]
      (when (not ok)
        (set! err (errors/New (+ "rpc: can't find service " (.-ServiceMethod req))))
        (return))

      (set! svc (assert (* service) svci))
      (set! mtype (aget (.-method svc) methodName))
      (when (== mtype nil)
        (set! err (errors/New (+ "rpc: can't find method " (.-ServiceMethod req)))))

      (return))))






^{:go/end 638} (go/method Accept "Accept accepts connections on the listener and serves requests\nfor each incoming connection. Accept blocks until the listener\nreturns a non-nil error. The caller typically invokes Accept in a\ngo statement.\n" [^{:tag (* Server)} server ^net/Listener lis]
  (while true
    (let [(values conn err) (.Accept lis)]
      (when (!= err nil)
        (log/Print "rpc.Serve: accept:" (.Error err))
        (return))

      (go (.ServeConn server conn)))))




^{:go/end 641} (go/func Register "Register publishes the receiver's methods in the [DefaultServer].\n" ^error [^any rcvr] (.Register DefaultServer rcvr))



^{:go/end 647} (go/func RegisterName "RegisterName is like [Register] but uses the provided name for the type\ninstead of the receiver's concrete type.\n" ^error [^string name ^any rcvr]
  (.RegisterName DefaultServer name rcvr))










(go/type ServerCodec "A ServerCodec implements reading of RPC requests and writing of\nRPC responses for the server side of an RPC session.\nThe server calls [ServerCodec.ReadRequestHeader] and [ServerCodec.ReadRequestBody] in pairs\nto read requests from the connection, and it calls [ServerCodec.WriteResponse] to\nwrite a response back. The server calls [ServerCodec.Close] when finished with the\nconnection. ReadRequestBody may be called with a nil\nargument to force the body of the request to be read and discarded.\nSee [NewClient]'s comment for information about concurrent access.\n" (interface
    (ReadRequestHeader ^error [(* Request)])
    (ReadRequestBody ^error [any])
    (WriteResponse ^error [(* Response) any])


    (^{:doc "Close can be called multiple times and must be idempotent.\n"} Close ^error [])))








^{:go/end 674} (go/func ServeConn "ServeConn runs the [DefaultServer] on a single connection.\nServeConn blocks, serving the connection until the client hangs up.\nThe caller typically invokes ServeConn in a go statement.\nServeConn uses the gob wire format (see package gob) on the\nconnection. To use an alternate codec, use [ServeCodec].\nSee [NewClient]'s comment for information about concurrent access.\n" [^io/ReadWriteCloser conn]
  (.ServeConn DefaultServer conn))




^{:go/end 680} (go/func ServeCodec "ServeCodec is like [ServeConn] but uses the specified codec to\ndecode requests and encode responses.\n" [^ServerCodec codec]
  (.ServeCodec DefaultServer codec))




^{:go/end 686} (go/func ServeRequest "ServeRequest is like [ServeCodec] but synchronously serves a single request.\nIt does not close the codec upon completion.\n" ^error [^ServerCodec codec]
  (.ServeRequest DefaultServer codec))





^{:go/end 691} (go/func Accept "Accept accepts connections on the listener and serves requests\nto [DefaultServer] for each incoming connection.\nAccept blocks; the caller typically invokes it in a go statement.\n" [^net/Listener lis] (.Accept DefaultServer lis))


(go/var ^{:doc "Can connect to RPC service using HTTP CONNECT to rpcPath.\n"} connected "200 Connected to Go RPC")


^{:go/end 711} (go/method ServeHTTP "ServeHTTP implements an [http.Handler] that answers RPC requests.\n" [^{:tag (* Server)} server ^http/ResponseWriter w ^{:tag (* http/Request)} req]
  (when (!= (.-Method req) "CONNECT")
    (.Set (.Header w) "Content-Type" "text/plain; charset=utf-8")
    (.WriteHeader w http/StatusMethodNotAllowed)
    (io/WriteString w "405 must CONNECT\n")
    (return))

  (let [(values conn _ err) (.Hijack (assert http/Hijacker w))]
    (when (!= err nil)
      (log/Print "rpc hijacking " (.-RemoteAddr req) ": " (.Error err))
      (return))

    (io/WriteString conn (+ "HTTP/1.0 " connected "\n\n"))
    (.ServeConn server conn)))





^{:go/end 719} (go/method HandleHTTP "HandleHTTP registers an HTTP handler for RPC messages on rpcPath,\nand a debugging handler on debugPath.\nIt is still necessary to invoke [http.Serve](), typically in a go statement.\n" [^{:tag (* Server)} server ^string rpcPath ^string debugPath]
  (http/Handle rpcPath server)
  (http/Handle debugPath (lit debugHTTP server)))





^{:go/end 726} (go/func HandleHTTP "HandleHTTP registers an HTTP handler for RPC messages to [DefaultServer]\non [DefaultRPCPath] and a debugging handler on [DefaultDebugPath].\nIt is still necessary to invoke [http.Serve](), typically in a go statement.\n" []
  (.HandleHTTP DefaultServer DefaultRPCPath DefaultDebugPath))

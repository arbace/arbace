(in-ns 'go.net.rpc) (go/file "debug.go" :imports [

    ;; /*
    ;; Some HTML presented at http://machine:port/debug/rpc
    ;; Lists services, their methods, and some statistics, still rudimentary.
    ;; */


    ^{:line 13} [fmt "fmt"]
    ^{:line 14} [template "html/template"]
    ^{:line 15} [http "net/http"]
    ^{:line 16} [slices "slices"]
    ^{:line 17} [strings "strings"]])


(go/const ^{:val "<html>\n\t<body>\n\t<title>Services</title>\n\t{{range .}}\n\t<hr>\n\tService {{.Name}}\n\t<hr>\n\t\t<table>\n\t\t<th align=center>Method</th><th align=center>Calls</th>\n\t\t{{range .Method}}\n\t\t\t<tr>\n\t\t\t<td align=left font=fixed>{{.Name}}({{.Type.ArgType}}, {{.Type.ReplyType}}) error</td>\n\t\t\t<td align=center>{{.Type.NumCalls}}</td>\n\t\t\t</tr>\n\t\t{{end}}\n\t\t</table>\n\t{{end}}\n\t</body>\n\t</html>"} debugText "<html>\n\t<body>\n\t<title>Services</title>\n\t{{range .}}\n\t<hr>\n\tService {{.Name}}\n\t<hr>\n\t\t<table>\n\t\t<th align=center>Method</th><th align=center>Calls</th>\n\t\t{{range .Method}}\n\t\t\t<tr>\n\t\t\t<td align=left font=fixed>{{.Name}}({{.Type.ArgType}}, {{.Type.ReplyType}}) error</td>\n\t\t\t<td align=center>{{.Type.NumCalls}}</td>\n\t\t\t</tr>\n\t\t{{end}}\n\t\t</table>\n\t{{end}}\n\t</body>\n\t</html>")



















(go/var debug (template/Must (.Parse (template/New "RPC debug") debugText)))


(go/var ^{:doc "If set, print log statements for internal and I/O errors.\n"} debugLog false)

(go/type debugMethod (struct
    ^{:line 46 :tag (* methodType)} Type
    ^{:line 47 :tag string} Name))


(go/type methodArray (slice debugMethod))

(go/type debugService (struct
    ^{:line 53 :tag (* service)} Service
    ^{:line 54 :tag string} Name
    ^{:line 55 :tag (slice debugMethod)} Method))


(go/type serviceArray (slice debugService))

^{:go/end 60} (go/method Len ^int [^serviceArray s] (len s))
^{:go/end 61} (go/method Less ^bool [^serviceArray s ^int i ^int j] (< (.-Name (aget s i)) (.-Name (aget s j))))
^{:go/end 62} (go/method Swap [^serviceArray s ^int i ^int j] (set! (values (aget s i) (aget s j)) (values (aget s j) (aget s i))))

^{:go/end 64} (go/method Len ^int [^methodArray m] (len m))
^{:go/end 65} (go/method Less ^bool [^methodArray m ^int i ^int j] (< (.-Name (aget m i)) (.-Name (aget m j))))
^{:go/end 66} (go/method Swap [^methodArray m ^int i ^int j] (set! (values (aget m i) (aget m j)) (values (aget m j) (aget m i))))

(go/type debugHTTP (struct
    (* Server)))



^{:go/end 95} (go/method ServeHTTP "Runs at /debug/rpc\n" [^debugHTTP server ^http/ResponseWriter w ^{:tag (* http/Request)} req]
  ;; Build a sorted version of the data.
  (let [^serviceArray services (zero serviceArray)]
    (.Range ^{:go/via [Server]} (.-serviceMap server) ^{:go/end 87} (fn ^bool [^any snamei ^any svci]
        ^{:go/breaks [5]} (let [svc (assert (* service) svci)
            ^{:line 78} ds (lit debugService svc (assert string snamei) (make (slice debugMethod) 0 (len (.-method svc))))]
          (range [mname method (.-method svc)]
            (set! (.-Method ds) (append (.-Method ds) (lit debugMethod method mname))))

          (^{:inst [(slice debugMethod) debugMethod]} slices/SortFunc (.-Method ds) ^{:go/end 84} (fn ^int [^debugMethod a ^debugMethod b]
              (strings/Compare (.-Name a) (.-Name b))))

          (set! services (append services ds))
          true)))

    (^{:inst [serviceArray debugService]} slices/SortFunc services ^{:go/end 90} (fn ^int [^debugService a ^debugService b]
        (strings/Compare (.-Name a) (.-Name b))))

    (let [err (.Execute debug w services)]
      (when (!= err nil)
        (fmt/Fprintln w "rpc: error executing template:" (.Error err))))))

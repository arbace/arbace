(ns go.net.rpc.jsonrpc
  (:require [arbace.go :as go]))

(go/package jsonrpc
  :path "net/rpc/jsonrpc"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["client.go" "server.go"]
  :init-order [errMissingParams null]
  :positions :lines)

(load "jsonrpc/client")
(load "jsonrpc/server")

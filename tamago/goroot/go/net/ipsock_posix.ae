(in-ns 'go.net) (go/file "ipsock_posix.go" :build ["//go:build unix || js || wasip1 || windows || tamago"] :imports [


    ^{:line 10} [context "context"]
    ^{:line 11} [poll "internal/poll"]
    ^{:line 12} [netip "net/netip"]

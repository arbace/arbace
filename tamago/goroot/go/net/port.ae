(in-ns 'go.net) (go/file "port.go" :imports [])









^{:go/end 62} (go/func parsePort "parsePort parses service as a decimal integer and returns the\ncorresponding value as port. It is the caller's responsibility to\nparse service as a non-decimal integer when needsLookup is true.\n\nSome system resolvers will return a valid port number when given a number\nover 65536 (see https://golang.org/issues/11715). Alas, the parser\ncan't bail early on numbers > 65536. Therefore reasonably large/small\nnumbers are parsed in full and rejected if invalid.\n" [^string service] :results [^int port ^bool needsLookup]
  (when (== service "")
    ;; Lock in the legacy behavior that an empty string
    ;; means port 0. See golang.org/issue/13610.
    (return 0 false))

  (let [
      ^:const ^{:line 22 :val 4294967295} max (conv uint32 (- (<< 1 32) 1))
      ^:const ^:go/grouped ^{:line 23 :val 1073741824} cutoff (conv uint32 (<< 1 30))

      ^{:line 25} neg false]
    (cond (== (aget service 0) \+)
      (set! service (subslice service 1))
      (== (aget service 0) \-) (do
        (set! neg true)
        (set! service (subslice service 1))))

    (let [^uint32 n (zero uint32)]
      (range [_ d service]
        (if (and (<= \0 d) (<= d \9))
          (set! d - \0)

          (return 0 true))

        (when (>= n cutoff)
          (set! n max)
          (break))

        (set! n * 10)
        (let [nn (+ n (conv uint32 d))]
          (when (or (< nn n) (> nn max))
            (set! n max)
            (break))

          (set! n nn)))

      (cond (and (not neg) (>= n cutoff))
        (set! port (conv int (- cutoff 1)))
        (and neg (> n cutoff))
        (set! port (conv int cutoff)) :else

        (set! port (conv int n)))

      (when neg
        (set! port (- port)))

      (return port false))))

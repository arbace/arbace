(ns go.testing
  (:require [arbace.go :as go]))

(go/package testing
  :path "testing"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["allocs.go" "benchmark.go" "cover.go" "example.go" "fuzz.go" "match.go" "newcover.go" "run_example_tamago.go" "testing.go" "testing_other.go"]
  :init-order [benchTime hideStdoutForTesting minimizeDuration corpusDir ["fuzz.go" 86 5] supportedTypes testBinary ["testing.go" 1010 2] ["testing.go" 1011 2] errNilPanicOrGoexit errMain]
  :positions :lines)

(load "testing/allocs")
(load "testing/benchmark")
(load "testing/cover")
(load "testing/example")
(load "testing/fuzz")
(load "testing/match")
(load "testing/newcover")
(load "testing/run_example_tamago")
(load "testing/testing")
(load "testing/testing_other")

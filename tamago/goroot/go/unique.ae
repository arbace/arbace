(ns go.unique
  (:require [arbace.go :as go]))

(go/package unique
  :path "unique"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["canonmap.go" "clone.go" "doc.go" "handle.go"]
  :init-order [singleStringClone]
  :positions :lines)

(load "unique/canonmap")
(load "unique/clone")
(load "unique/doc")
(load "unique/handle")

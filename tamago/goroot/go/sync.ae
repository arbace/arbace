(ns go.sync
  (:require [arbace.go :as go]))

(go/package sync
  :path "sync"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["cond.go" "map.go" "mutex.go" "once.go" "oncefunc.go" "pool.go" "poolqueue.go" "runtime.go" "runtime2.go" "rwmutex.go" "waitgroup.go"]
  :init-order []
  :positions :lines)

(load "sync/cond")
(load "sync/map")
(load "sync/mutex")
(load "sync/once")
(load "sync/oncefunc")
(load "sync/pool")
(load "sync/poolqueue")
(load "sync/runtime")
(load "sync/runtime2")
(load "sync/rwmutex")
(load "sync/waitgroup")

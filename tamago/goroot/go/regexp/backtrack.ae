                (set! pos + advance)))


            (when (> (len (.-cap b)) 0)
              (aset (.-cap b) 0 pos))

            (when (.tryBacktrack re b i (conv uint32 (.-Start (.-prog re))) pos)
              ;; Match must be leftmost; done.
              (goto :Match))

            (set! (values _ width) (.step i pos)))

          (freeBitState b)
          (return nil)))


      (label :Match

^{:go/end 365} (go/method backtrack "backtrack runs a backtracking search of prog on the input starting at pos.\n" ^{:tag (slice int)} [^{:tag (* Regexp)} re ^{:tag (slice byte)} ib ^string is ^int pos ^int ncap ^{:tag (slice int)} dstCap]
  (let [startCond (.-cond re)]
    (when (== startCond (bit-not (conv syntax/EmptyOp 0))) ; impossible
      (return nil))

    (when (and (!= (bit-and startCond syntax/EmptyBeginText) 0) (!= pos 0))
      ;; Anchored match, past beginning of text.
      (return nil))


    (let [b (newBitState)
        (values i end) (.init (.-inputs b) nil ib is)]
      (.reset b (.-prog re) end ncap)

      ;; Anchored search must start at the beginning of the input

      (return false))

    (set! (aget (.-visited b) (/ n visitedBits)) bit-or ^uint32 (<< 1 (bit-and n (- visitedBits 1))))
    true))




^{:go/end 135} (go/method push "push pushes (pc, pos, arg) onto the job stack if it should be\nvisited.\n" [^{:tag (* bitState)} b ^{:tag (* Regexp)} re ^uint32 pc ^int pos ^bool arg]
  ;; Only check shouldVisit when arg is false.
  ;; When arg is true, we are continuing a previous visit.
  (when (and (!= (.-Op (aget (.-Inst (.-prog re)) pc)) syntax/InstFail) ^:go/paren (or arg (.shouldVisit b pc pos)))

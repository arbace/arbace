^{:go/end 302} (go/method tryBacktrack "tryBacktrack runs a backtracking search starting at pos.\n" ^bool [^{:tag (* Regexp)} re ^{:tag (* bitState)} b ^input i ^uint32 pc ^int pos]
  (let [longest (.-longest re)]

    (.push b re pc pos false)
    (while (> (len (.-jobs b)) 0)
      (let [l (- (len (.-jobs b)) 1)
          ;; Pop job off the stack.
          ^{:line 145} pc (.-pc (aget (.-jobs b) l))
          ^{:line 146} pos (.-pos (aget (.-jobs b) l))
          ^{:line 147} arg (.-arg (aget (.-jobs b) l))]

              (if arg (do
                  ;; Finished inst.Out; try inst.Arg.
                  (set! arg false)
                  (set! pc (.-Arg inst))
                  (goto :CheckAndLoop))
                (do
                  (.push b re pc pos true)
                  (set! pc (.-Out inst))
                  (goto :CheckAndLoop))))


            (case [syntax/InstAltMatch]
              ;; One opcode consumes runes; the other leads to match.
              (switch (.-Op (aget (.-Inst (.-prog re)) (.-Out inst)))
                (case [syntax/InstRune syntax/InstRune1 syntax/InstRuneAny syntax/InstRuneAnyNotNL]
                  ;; inst.Arg is the match.
                  (.push b re (.-Arg inst) pos false)
                  (set! pc (.-Arg inst))
                  (set! pos (.-end b))
                  (goto :CheckAndLoop)))

              ;; inst.Out is the match - non-greedy
              (.push b re (.-Out inst) (.-end b) false)
              (set! pc (.-Out inst))
              (goto :CheckAndLoop))

            (case [syntax/InstRune]
              (let [(values r width) (.step i pos)]
                (when (not (.MatchRune inst r))
                  (continue))

                (set! pos + width)
                (set! pc (.-Out inst))
                (goto :CheckAndLoop)))

            (case [syntax/InstRune1]
              (let [(values r width) (.step i pos)]
                (when (!= r (aget (.-Rune inst) 0))
                  (continue))

                (set! pos + width)
                (set! pc (.-Out inst))
                (goto :CheckAndLoop)))

            (case [syntax/InstRuneAnyNotNL]
              (let [(values r width) (.step i pos)]
                (when (or (== r \newline) (== r endOfText))
                  (continue))

                (set! pos + width)
                (set! pc (.-Out inst))
                (goto :CheckAndLoop)))

            (case [syntax/InstRuneAny]
              (let [(values r width) (.step i pos)]
                (when (== r endOfText)
                  (continue))

                (set! pos + width)
                (set! pc (.-Out inst))
                (goto :CheckAndLoop)))

            (case [syntax/InstCapture]

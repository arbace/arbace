;; backtrack is a regular expression search with submatch
;; tracking for small regular expressions and texts. It allocates
;; a bit vector with (length of input) * (length of prog) bits,
;; to make sure it never explores the same (character position, instruction)
;; state multiple times. This limits the search to run in time linear in
;; the length of the test.
;;
;; backtrack is a fast replacement for the NFA code on small
;; regexps when onepass cannot be used.

(in-ns 'go.regexp) (go/file "backtrack.go" :imports [


    ^{:line 18} [syntax "regexp/syntax"]
    ^{:line 19} [sync "sync"]])




(go/type job "A job is an entry on the backtracker's job stack. It holds\nthe instruction pc and the position in the input.\n" (struct
    ^{:line 25 :tag uint32} pc
    ^{:line 26 :tag bool} arg
    ^{:line 27 :tag int} pos))


(go/const
  ^{:line 31} [^{:val 32} visitedBits 32]
  ^{:line 32} [^{:val 500} maxBacktrackProg 500] ; len(prog.Inst) <= max
  ^{:line 33} [^{:val 262144} maxBacktrackVector (* 256 1024)]) ; bit vector size <= max (bits)



(go/type bitState "bitState holds state for the backtracker.\n" (struct
    ^{:line 38 :tag int} end
    ^{:line 39 :tag (slice int)} cap
    ^{:line 40 :tag (slice int)} matchcap
    ^{:line 41 :tag (slice job)} jobs
    ^{:line 42 :tag (slice uint32)} visited

    ^{:line 44 :tag inputs} inputs))


(go/var ^sync/Pool bitStatePool)

^{:go/end 55} (go/func newBitState ^{:tag (* bitState)} []
  (let [(values b ok) (assert (* bitState) (.Get bitStatePool))]
    (when (not ok)
      (set! b (new bitState)))

    ^{:line 54} b))


^{:go/end 60} (go/func freeBitState [^{:tag (* bitState)} b]
  (.clear (.-inputs b))
  (.Put bitStatePool b))




^{:go/end 69} (go/func maxBitStateLen "maxBitStateLen returns the maximum length of a string to search with\nthe backtracker using prog.\n" ^int [^{:tag (* syntax/Prog)} prog]
  (when (not (shouldBacktrack prog))
    (return 0))

  (/ maxBacktrackVector (len (.-Inst prog))))




^{:go/end 75} (go/func shouldBacktrack "shouldBacktrack reports whether the program is too\nlong for the backtracker to run.\n" ^bool [^{:tag (* syntax/Prog)} prog]
  (<= (len (.-Inst prog)) maxBacktrackProg))





^{:go/end 114} (go/method reset "reset resets the state of the backtracker.\nend is the end position in the input.\nncap is the number of captures.\n" [^{:tag (* bitState)} b ^{:tag (* syntax/Prog)} prog ^int end ^int ncap]
  (set! (.-end b) end)

  (if (== (cap (.-jobs b)) 0)
    (set! (.-jobs b) (make (slice job) 0 256))

    (set! (.-jobs b) (subslice (.-jobs b) _ 0)))


  (let [visitedSize (/ (- (+ (* (len (.-Inst prog)) (+ end 1)) visitedBits) 1) visitedBits)]
    (if (< (cap (.-visited b)) visitedSize)
      (set! (.-visited b) (make (slice uint32) visitedSize (/ maxBacktrackVector visitedBits)))
      (do
        (set! (.-visited b) (subslice (.-visited b) _ visitedSize))
        (clear (.-visited b)))) ; set to 0


    (if (< (cap (.-cap b)) ncap)
      (set! (.-cap b) (make (slice int) ncap))

      (set! (.-cap b) (subslice (.-cap b) _ ncap)))

    (range [i (.-cap b)]
      (aset (.-cap b) i -1))


    (if (< (cap (.-matchcap b)) ncap)
      (set! (.-matchcap b) (make (slice int) ncap))

      (set! (.-matchcap b) (subslice (.-matchcap b) _ ncap)))

    (range [i (.-matchcap b)]
      (aset (.-matchcap b) i -1))))





^{:go/end 125} (go/method shouldVisit "shouldVisit reports whether the combination of (pc, pos) has not\nbeen visited yet.\n" ^bool [^{:tag (* bitState)} b ^uint32 pc ^int pos]
  ^{:go/breaks [4]} (let [n (conv uint (+ (* (conv int pc) (+ (.-end b) 1)) pos))]

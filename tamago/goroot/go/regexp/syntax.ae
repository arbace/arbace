(ns go.regexp.syntax
  (:require [arbace.go :as go]))

(go/package syntax
  :path "regexp/syntax"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["compile.go" "doc.go" "op_string.go" "parse.go" "perl_groups.go" "prog.go" "regexp.go" "simplify.go"]
  :init-order [anyRuneNotNL anyRune _Op_index_0 anyTable asciiTable asciiFoldTable code1 code2 code3 perlGroup code4 code5 code6 code7 code8 code9 code10 code11 code12 code13 code14 code15 code16 code17 posixGroup instOpNames]
  :positions :lines)

(load "syntax/compile")
(load "syntax/doc")
(load "syntax/op_string")
(load "syntax/parse")
(load "syntax/perl_groups")
(load "syntax/prog")
(load "syntax/regexp")
(load "syntax/simplify")

(ns go.os
  (:require [arbace.go :as go]))

(go/package os
  :path "os"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["dir.go" "dir_unix.go" "dirent_tamago.go" "env.go" "error.go" "error_errno.go" "exec.go" "exec_nohandle.go" "exec_posix.go" "exec_unix.go" "executable.go" "executable_procfs.go" "file.go" "file_open_unix.go" "file_posix.go" "file_unix.go" "getwd.go" "path.go" "path_unix.go" "pidfd_other.go" "pipe_tamago.go" "proc.go" "rawconn.go" "removeall_noat.go" "root.go" "root_internal.go" "root_nonwindows.go" "root_noopenat.go" "stat.go" "stat_tamago.go" "stat_unix.go" "statat.go" "statat_other.go" "sticky_notbsd.go" "sys.go" "sys_tamago.go" "tempfile.go" "types.go" "types_unix.go" "wait_unimp.go" "zero_copy_stub.go"]
  :init-order [dirBufPool ErrInvalid ErrPermission ErrExist ErrNotExist ErrClosed ErrNoDeadline ErrDeadlineExceeded ErrProcessDone errProcessReleased ErrNoHandle Interrupt Kill Stdin Stdout Stderr errWriteAtInAppendMode errPathEscapes checkWrapErr ["file.go" 753 5] ["file.go" 754 5] ["file.go" 755 5] ["file.go" 756 5] errPatternHasSeparator]
  :positions :lines)

(load "os/dir")
(load "os/dir_unix")
(load "os/dirent_tamago")
(load "os/env")
(load "os/error")
(load "os/error_errno")
(load "os/exec.go")
(load "os/exec_nohandle")
(load "os/exec_posix")
(load "os/exec_unix")
(load "os/executable")
(load "os/executable_procfs")
(load "os/file")
(load "os/file_open_unix")
(load "os/file_posix")
(load "os/file_unix")
(load "os/getwd")
(load "os/path")
(load "os/path_unix")
(load "os/pidfd_other")
(load "os/pipe_tamago")
(load "os/proc")
(load "os/rawconn")
(load "os/removeall_noat")
(load "os/root")
(load "os/root_internal")
(load "os/root_nonwindows")
(load "os/root_noopenat")
(load "os/stat")
(load "os/stat_tamago")
(load "os/stat_unix")
(load "os/statat")
(load "os/statat_other")
(load "os/sticky_notbsd")
(load "os/sys")
(load "os/sys_tamago")
(load "os/tempfile")
(load "os/types")
(load "os/types_unix")
(load "os/wait_unimp")
(load "os/zero_copy_stub")

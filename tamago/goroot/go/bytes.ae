(ns go.bytes
  (:require [arbace.go :as go]))

(go/package bytes
  :path "bytes"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["buffer.go" "bytes.go" "iter.go" "reader.go"]
  :init-order [ErrTooLarge errNegativeRead errUnreadByte asciiSpace]
  :positions :lines)

(load "bytes/buffer")
(load "bytes/bytes")
(load "bytes/iter")
(load "bytes/reader")

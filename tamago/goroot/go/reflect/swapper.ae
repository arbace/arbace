(in-ns 'go.reflect) (go/file "swapper.go" :imports [


    ^{:line 8} [abi "internal/abi"]
    ^{:line 9} [goarch "internal/goarch"]
    ^{:line 10} [unsafeheader "internal/unsafeheader"]
    ^{:line 11} [unsafe "unsafe"]])






^{:go/end 79} (go/func Swapper "Swapper returns a function that swaps the elements in the provided\nslice.\n\nSwapper panics if the provided interface is not a slice.\n" ^{:tag (func [^int i ^int j])} [^any slice]
  (let [v (ValueOf slice)]
    (when (!= (.Kind v) Slice)
      (panic (addr (lit ValueError :Method "Swapper" :Kind (.Kind v)))))

    ;; Fast path for slices of size 0 and 1. Nothing to swap.
    (switch (.Len v)
      (case [0]
        (return ^{:go/end 26} (fn [^int i ^int j] (panic "reflect: slice index out of range"))))
      (case [1]
        (return ^{:go/end 32} (fn [^int i ^int j]
            (when (or (!= i 0) (!= j 0))
              (panic "reflect: slice index out of range"))))))




    (let [typ (.common (.Elem (.Type v)))
        ^{:line 36} size (.Size typ)
        ^{:line 37} hasPtr (.Pointers typ)]

      ;; Some common & small cases, without using memmove:
      (if hasPtr (do
          (when (== size goarch/PtrSize)
            (let [ps @(conv (* (slice unsafe/Pointer)) (.-ptr v))]
              (return ^{:go/end 43} (fn [^int i ^int j] (set! (values (aget ps i) (aget ps j)) (values (aget ps j) (aget ps i)))))))

          (when (== (.Kind typ) abi/String)
            (let [ss @(conv (* (slice string)) (.-ptr v))]
              (return ^{:go/end 47} (fn [^int i ^int j] (set! (values (aget ss i) (aget ss j)) (values (aget ss j) (aget ss i))))))))


        (switch size
          (case [8]
            (let [is @(conv (* (slice int64)) (.-ptr v))]
              (return ^{:go/end 53} (fn [^int i ^int j] (set! (values (aget is i) (aget is j)) (values (aget is j) (aget is i)))))))
          (case [4]
            (let [is @(conv (* (slice int32)) (.-ptr v))]
              (return ^{:go/end 56} (fn [^int i ^int j] (set! (values (aget is i) (aget is j)) (values (aget is j) (aget is i)))))))
          (case [2]
            (let [is @(conv (* (slice int16)) (.-ptr v))]
              (return ^{:go/end 59} (fn [^int i ^int j] (set! (values (aget is i) (aget is j)) (values (aget is j) (aget is i)))))))
          (case [1]
            (let [is @(conv (* (slice int8)) (.-ptr v))]
              (return ^{:go/end 62} (fn [^int i ^int j] (set! (values (aget is i) (aget is j)) (values (aget is j) (aget is i)))))))))



      (let [s (conv (* unsafeheader/Slice) (.-ptr v))
          ^{:line 67} tmp (unsafe_New typ)] ; swap scratch space

        ^{:go/end 78} (fn [^int i ^int j]
          (when (or (>= (conv uint i) (conv uint (.-Len s))) (>= (conv uint j) (conv uint (.-Len s))))
            (panic "reflect: slice index out of range"))

          (let [val1 (arrayAt (.-Data s) i size "i < s.Len")
              ^{:line 74} val2 (arrayAt (.-Data s) j size "j < s.Len")]
            (typedmemmove typ tmp val1)
            (typedmemmove typ val1 val2)
            (typedmemmove typ val2 tmp)))))))

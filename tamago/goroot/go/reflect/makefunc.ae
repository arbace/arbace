^{:go/end 183} (go/func ^:go/nosplit moveMakeFuncArgPtrs "moveMakeFuncArgPtrs uses ctxt.regPtrs to copy integer pointer arguments\nin args.Ints to args.Ptrs where the GC can see them.\n\nThis is similar to what reflectcallmove does in the runtime, except\nthat happens on the return path, whereas this happens on the call path.\n\nnosplit because pointers are being held in uintptr slots in args, so\nhaving our stack scanned now could lead to accidentally freeing\nmemory.\n" [^{:tag (* makeFuncCtxt)} ctxt ^{:tag (* abi/RegArgs)} args]
  (range [i arg (.-Ints args)]
    ;; Avoid write barriers! Because our write barrier enqueues what
    ;; was there before, we might enqueue garbage.
    ;; Also avoid bounds checks, we don't have the stack space for it.
    ;; (Normally the prove pass removes them, but for -N builds we
    ;; use too much stack.)
    ;; ptr := &args.Ptrs[i] (but cast from *unsafe.Pointer to *uintptr)
    (let [ptr (conv (* uintptr) (add (conv unsafe/Pointer (unsafe/SliceData (subslice (.-Ptrs args)))) (* (conv uintptr i) goarch/PtrSize) "always in [0:IntArgRegs]"))]
      (if (.Get (.-regPtrs ctxt) i)
        (set! @ptr arg)

        ;; We *must* zero this space ourselves because it's defined in
        ;; assembly code and the GC will scan these pointers. Otherwise,
        ;; there will be garbage here.
        (set! @ptr 0)))))

        (values _ _ abid) (funcLayout ftyp nil)
        ^{:line 115} fv (addr ^{:go/breaks [2 [4 122] 6]} (lit methodValue
            :makeFuncCtxt ^{:go/breaks [2 4 6 8]} (lit makeFuncCtxt

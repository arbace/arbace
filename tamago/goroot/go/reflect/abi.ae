      nil)))








^{:go/end 187} (go/method addRcvr "addRcvr extends the abiSeq with a new method call\nreceiver according to the interface calling convention.\n\nIf the receiver was stack-assigned, returns the single\nabiStep describing that translation, and nil otherwise.\nReturns true if the receiver is a pointer.\n" [^{:tag (* abiSeq)} a ^{:tag (* abi/Type)} rcvr] :results [(* abiStep) bool]
  ;; The receiver is always one word.

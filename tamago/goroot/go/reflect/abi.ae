        (set! kind abiStepPointer))

      (set! (.-steps a) (append (.-steps a) ^{:go/breaks [2 4 6 8]} (lit abiStep
            :kind kind
            :offset (+ offset (* (conv uintptr i) size))
            :size size
            :ireg (.-iregs a))))

      (inc! (.-iregs a))))

  true)








^{:go/breaks [[7 309]] :go/end 310} (go/method assignFloatN "assignFloatN assigns n values to registers, each \"size\" bytes large,\nfrom the data at [offset, offset+n*size) in memory. Each value at\n[offset+i*size, offset+(i+1)*size) for i < n is assigned to the\nnext n floating-point registers.\n\nReturns whether assignment succeeded.\n" ^bool [^{:tag (* abiSeq)} a ^uintptr offset ^uintptr size ^int n]

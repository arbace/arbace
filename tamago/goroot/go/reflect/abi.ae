^{:go/end 475} (go/func intFromReg "intFromReg loads an argSize sized integer from reg and places it at to.\n\nargSize must be non-zero, fit in a register, and a power-of-two.\n" [^{:tag (* abi/RegArgs)} r ^int reg ^uintptr argSize ^unsafe/Pointer to]
  (memmove to (.IntRegArgAddr r reg argSize) argSize))





^{:go/end 482} (go/func intToReg "intToReg loads an argSize sized integer and stores it into reg.\n\nargSize must be non-zero, fit in a register, and a power-of-two.\n" [^{:tag (* abi/RegArgs)} r ^int reg ^uintptr argSize ^unsafe/Pointer from]
  (memmove (.IntRegArgAddr r reg argSize) from argSize))





^{:go/end 496} (go/func floatFromReg "floatFromReg loads a float value from its register representation in r.\n\nargSize must be 4 or 8.\n" [^{:tag (* abi/RegArgs)} r ^int reg ^uintptr argSize ^unsafe/Pointer to]
  (switch argSize
    (case [4]
      (set! @(conv (* float32) to) (archFloat32FromReg (aget (.-Floats r) reg))))
    (case [8]
      (set! @(conv (* float64) to) @(conv (* float64) (conv unsafe/Pointer (addr (aget (.-Floats r) reg))))))
    (default
      (panic "bad argSize"))))






^{:go/end 510} (go/func floatToReg "floatToReg stores a float value in its register representation in r.\n\nargSize must be either 4 or 8.\n" [^{:tag (* abi/RegArgs)} r ^int reg ^uintptr argSize ^unsafe/Pointer from]
  (switch argSize
    (case [4]
      (aset (.-Floats r) reg (archFloat32ToReg @(conv (* float32) from))))
    (case [8]
      (aset (.-Floats r) reg @(conv (* uint64) from)))
    (default
      (panic "bad argSize"))))

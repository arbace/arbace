  (.dump (.-call a))
  (println "ret")
  (.dump (.-ret a))
  (println "stackCallArgsSize" (.-stackCallArgsSize a))
  (println "retOffset" (.-retOffset a))
  (println "spill" (.-spill a))
  (print "inRegPtrs:")
  (dumpPtrBitMap (.-inRegPtrs a))
  (println)
  (print "outRegPtrs:")
  (dumpPtrBitMap (.-outRegPtrs a))
  (println))



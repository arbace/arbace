^{:go/end 250} (go/method regAssign "regAssign attempts to reserve argument registers for a value of\ntype t, stored at some offset.\n\nIt returns whether or not the assignment succeeded, but\nleaves any changes it made to a.steps behind, so the caller\nmust undo that work by adjusting a.steps if it fails.\n\nThis method along with the assign* methods represent the\ncomplete register-assignment algorithm for the Go ABI.\n" ^bool [^{:tag (* abiSeq)} a ^{:tag (* abi/Type)} t ^uintptr offset]
  (switch (conv Kind (.Kind t))
    (case [UnsafePointer Pointer Chan Map Func]
      (return (.assignIntN a offset (.Size t) 1 2r1)))
    (case [Bool Int Uint Int8 Uint8 Int16 Uint16 Int32 Uint32 Uintptr]
      (return (.assignIntN a offset (.Size t) 1 2r0)))
    (case [Int64 Uint64]
      (switch goarch/PtrSize
        (case [4]
          (return (.assignIntN a offset 4 2 2r0)))
        (case [8]
          (return (.assignIntN a offset 8 1 2r0)))))

    (case [Float32 Float64]
      (return (.assignFloatN a offset (.Size t) 1)))
    (case [Complex64]
      (return (.assignFloatN a offset 4 2)))
    (case [Complex128]
      (return (.assignFloatN a offset 8 2)))
    (case [String]
      (return (.assignIntN a offset goarch/PtrSize 2 2r01)))
    (case [Interface]
      (return (.assignIntN a offset goarch/PtrSize 2 2r10)))
    (case [Slice]
      (return (.assignIntN a offset goarch/PtrSize 3 2r001)))
    (case [Array]
      (let [tt (conv (* arrayType) (conv unsafe/Pointer t))]
        (switch (.-Len tt)
          (case [0]
            ;; There's nothing to assign, so don't modify
            ;; a.steps but succeed so the caller doesn't
            ;; try to stack-assign this value.
            (return true))
          (case [1]
            (return (.regAssign a (.-Elem tt) offset)))
          (default
            (return false)))))

    (case [Struct]
      (let [st (conv (* structType) (conv unsafe/Pointer t))]
        (range [i ^{:go/via [StructType]} (.-Fields st)]
          (let [f (addr (aget ^{:go/via [StructType]} (.-Fields st) i))]
            (when (not (.regAssign a (.-Typ f) (+ offset (.-Offset f))))
              (return false))))


        (return true)))
    (default
      (print "t.Kind == " (.Kind t) "\n")
      (panic "unknown type kind")))

  (panic "unhandled register assignment path"))











^{:go/breaks [[8 284]] :go/end 285} (go/method assignIntN "assignIntN assigns n values to registers, each \"size\" bytes large,\nfrom the data at [offset, offset+n*size) in memory. Each value at\n[offset+i*size, offset+(i+1)*size) for i < n is assigned to the\nnext n integer registers.\n\nBit i in ptrMap indicates whether the i'th value is a pointer.\nn must be <= 8.\n\nReturns whether assignment succeeded.\n" ^bool [^{:tag (* abiSeq)} a ^uintptr offset ^uintptr size ^int n ^uint8 ptrMap]

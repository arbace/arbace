(ns go.fmt
  (:require [arbace.go :as go]))

(go/package fmt
  :path "fmt"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["doc.go" "errors.go" "format.go" "print.go" "scan.go"]
  :init-order [ppFree space ssFree errComplex errBool]
  :positions :lines)

(load "fmt/doc")
(load "fmt/errors")
(load "fmt/format")
(load "fmt/print")
(load "fmt/scan")

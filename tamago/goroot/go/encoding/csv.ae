(ns go.encoding.csv
  (:require [arbace.go :as go]))

(go/package csv
  :path "encoding/csv"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["reader.go" "writer.go"]
  :init-order [ErrBareQuote ErrQuote ErrFieldCount ErrTrailingComma errInvalidDelim]
  :positions :lines)

(load "csv/reader")
(load "csv/writer")

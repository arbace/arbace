(ns go.encoding.json
  (:require [arbace.go :as go]))

(go/package json
  :path "encoding/json"
  :files ["v2_decode.go" "v2_encode.go" "v2_indent.go" "v2_inject.go" "v2_options.go" "v2_scanner.go" "v2_stream.go"]
  :positions :lines)

(load "json/v2_decode")
(load "json/v2_encode")
(load "json/v2_indent")
(load "json/v2_inject")
(load "json/v2_options")
(load "json/v2_scanner")
(load "json/v2_stream")

;; BOOLEAN

^{:go/end 76} (go/func parseBool [^{:tag (slice byte)} bytes] :results [^bool ret ^error err]
  (when (!= (len bytes) 1)
    (set! err (lit SyntaxError "invalid boolean"))
    (return))


  ;; DER demands that "If the encoding represents the boolean value TRUE,
  ;; its single contents octet shall have all eight bits set to one."
  ;; Thus only 0 and 255 are valid encoded values.
  (switch (aget bytes 0)
    (case [0]
      (set! ret false))
    (case [0xff]
      (set! ret true))
    (default
      (set! err (lit SyntaxError "invalid boolean"))))


  (return))



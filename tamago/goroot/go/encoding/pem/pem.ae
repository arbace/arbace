      ;; See RFC 1421, section 4.6.1.1
      (when hasProcType
        (when [err (writeHeader out procType (aget (.-Headers b) procType))] (!= err nil)
          (return err)))


      ;; For consistency of output, write other headers sorted by key.
      (^{:inst [(slice string) string]} slices/Sort h)
      (range [_ k h]
        (when [err (writeHeader out k (aget (.-Headers b) k))] (!= err nil)
          (return err)))


      (when [(values _ err) (.Write out nl)] (!= err nil)
        (return err))))



  (let [^lineBreaker breaker (zero lineBreaker)]
    (set! (.-out breaker) out)

    (let [b64 (base64/NewEncoder base64/StdEncoding (addr breaker))]
      (when [(values _ err) (.Write b64 (.-Bytes b))] (!= err nil)
        (return err))

      (when [err (.Close b64)] (!= err nil)
        (return err))

      (when [err (.Close breaker)] (!= err nil)
        (return err))


      (when [(values _ err) (.Write out (subslice pemEnd 1))] (!= err nil)
        (return err))

      (let [(values _ err) (.Write out (conv (slice byte) (+ (.-Type b) "-----\n")))]
        ^{:line 321} err))))







^{:go/end 335} (go/func EncodeToMemory "EncodeToMemory returns the PEM encoding of b.\n\nIf b has invalid headers and cannot be encoded,\nEncodeToMemory returns nil. If it is important to\nreport details about this error case, use [Encode] instead.\n" ^{:tag (slice byte)} [^{:tag (* Block)} b]
  (let [^bytes/Buffer buf (zero bytes/Buffer)]
    (when [err (Encode (addr buf) b)] (!= err nil)
      (return nil))

    (.Bytes buf)))

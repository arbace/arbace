(go/var numberType ((inst reflect/TypeFor Number)))


^{:go/end 234} (go/method MarshalJSONTo "MarshalJSONTo implements [jsonv2.MarshalerTo].\n" ^error [^Number n ^{:tag (* jsontext/Encoder)} enc]
  (let [opts (.Options enc)
      (values stringify _) (^{:inst [bool]} jsonv2/GetOption opts jsonv2/StringifyNumbers)]
    (when [(values k n) (.StackIndex enc (.StackDepth enc))] (and (== k \{) (== (% n 2) 0))
      (set! stringify true)) ; expecting a JSON object name

    (set! n (^{:inst [Number]} cmp/Or n "0"))
    (let [^{:tag (slice byte)} num (zero (slice byte))
        ^{:line 220} val (.AvailableBuffer enc)]
      (if stringify (do
          (set! val (append val \"))
          (set! val (append val (spread n)))
          (set! val (append val \"))
          (set! num (subslice val (len "\"") (- (len val) (len "\"")))))
        (do
          (set! val (append val (spread n)))
          (set! num val)))

      (when [(values n err) (jsonwire/ConsumeNumber num)] (or (!= n (len num)) (!= err nil))
        (return (fmt/Errorf "cannot parse %q as JSON number: %w" val strconv/ErrSyntax)))

      (.WriteValue enc val))))




(in-ns 'go.encoding.json) (go/file "v2_indent.go" :build ["//go:build goexperiment.jsonv2"] :imports [


    ^{:line 10} [bytes "bytes"]
    ^{:line 11} [strings "strings"]

    ^{:line 13} [jsontext "encoding/json/jsontext"]])







^{:go/end 24} (go/func HTMLEscape "HTMLEscape appends to dst the JSON-encoded src with <, >, &, U+2028 and U+2029\ncharacters inside string literals changed to \\u003c, \\u003e, \\u0026, \\u2028, \\u2029\nso that the JSON will be safe to embed inside HTML <script> tags.\nFor historical reasons, web browsers don't honor standard HTML\nescaping within <script> tags, so an alternative JSON encoding must be used.\n" [^{:tag (* bytes/Buffer)} dst ^{:tag (slice byte)} src]
  (.Grow dst (len src))
  (.Write dst (appendHTMLEscape (.AvailableBuffer dst) src)))


^{:go/end 45} (go/func appendHTMLEscape ^{:tag (slice byte)} [^{:tag (slice byte)} dst ^{:tag (slice byte)} src]
  (let [^:const ^{:val "0123456789abcdef"} hex "0123456789abcdef"
      ;; The characters can only appear in string literals,
      ;; so just scan the string one byte at a time.
      ^{:line 30} start 0]
    (range [i c src]
      (when (or (== c \<) (== c \>) (== c \&))
        (set! dst (append dst (spread (subslice src start i))))
        (set! dst (append dst \\ \u \0 \0 (aget hex (>> c 4)) (aget hex (bit-and c 0xF))))
        (set! start (+ i 1)))

      ;; Convert U+2028 and U+2029 (E2 80 A8 and E2 80 A9).
      (when (and (== c 0xE2) (< (+ i 2) (len src)) (== (aget src (+ i 1)) 0x80) (== (bit-and-not (aget src (+ i 2)) 1) 0xA8))
        (set! dst (append dst (spread (subslice src start i))))
        (set! dst (append dst \\ \u \2 \0 \2 (aget hex (bit-and (aget src (+ i 2)) 0xF))))
        (set! start (+ i (len "\u2029")))))


    (append dst (spread (subslice src start)))))




^{:go/end 62} (go/func Compact "Compact appends to dst the JSON-encoded src with\ninsignificant space characters elided.\n" ^error [^{:tag (* bytes/Buffer)} dst ^{:tag (slice byte)} src]
  (.Grow dst (len src))
  ^{:go/breaks [4]} (let [b (.AvailableBuffer dst)
      (values ^:assign b err) (^{:inst [(slice byte)]} jsontext/AppendFormat b src
        (ReportErrorsWithLegacySemantics true)
        (jsontext/AllowDuplicateNames true)
        (jsontext/AllowInvalidUTF8 true)
        (jsontext/PreserveRawStrings true))]
    (when (!= err nil)
      (return (transformSyntacticError err)))

    (.Write dst b)
    nil))








(go/const ^{:val 2 :doc "indentGrowthFactor specifies the growth factor of indenting JSON input.\nEmpirically, the growth factor was measured to be between 1.4x to 1.8x\nfor some set of compacted JSON with the indent being a single tab.\nSpecify a growth factor slightly larger than what is observed\nto reduce probability of allocation in appendIndent.\nA factor no higher than 2 ensures that wasted space never exceeds 50%.\n"} indentGrowthFactor 2)












^{:go/end 89} (go/func Indent "Indent appends to dst an indented form of the JSON-encoded src.\nEach element in a JSON object or array begins on a new,\nindented line beginning with prefix followed by one or more\ncopies of indent according to the indentation nesting.\nThe data appended to dst does not begin with the prefix nor\nany indentation, to make it easier to embed inside other formatted JSON data.\nAlthough leading space characters (space, tab, carriage return, newline)\nat the beginning of src are dropped, trailing space characters\nat the end of src are preserved and copied to dst.\nFor example, if src has no trailing spaces, neither will dst;\nif src ends in a trailing newline, so will dst.\n" ^error [^{:tag (* bytes/Buffer)} dst ^{:tag (slice byte)} src ^string prefix ^string indent]
  (.Grow dst (* indentGrowthFactor (len src)))
  (let [b (.AvailableBuffer dst)
      (values ^:assign b err) (appendIndent b src prefix indent)]
    (.Write dst b)
    ^{:line 88} err))


^{:go/end 131} (go/func appendIndent [^{:tag (slice byte)} dst ^{:tag (slice byte)} src ^string prefix ^string indent] :results [(slice byte) error]
  ;; In v2, only spaces and tabs are allowed, while v1 allowed any character.
  (let [dstLen (len dst)]
    (when (> (+ (len (strings/Trim prefix " \t")) (len (strings/Trim indent " \t"))) 0)
      ;; Use placeholder spaces of correct length, and replace afterwards.
      (let [(values invalidPrefix invalidIndent) (values prefix indent)]
        (set! prefix (strings/Repeat " " (len prefix)))
        (set! indent (strings/Repeat " " (len indent)))
        (defer (^{:go/end 111} (fn []
              (let [b (subslice dst dstLen)]
                (for [i (bytes/IndexByte b \newline)] (>= i 0) (set! i (bytes/IndexByte b \newline))
                  (set! b (subslice b (+ i (len "\n"))))
                  (let [n (- (len b) (len (bytes/TrimLeft b " "))) ; len(prefix)+n*len(indent)
                      ^{:line 104} spaces (subslice b _ n)]
                    (set! spaces (subslice spaces (copy spaces invalidPrefix)))
                    (while (> (len spaces) 0)
                      (set! spaces (subslice spaces (copy spaces invalidIndent))))

                    (set! b (subslice b n))))))))))




    (let [(values ^:assign dst err) (^{:inst [(slice byte)]} jsontext/AppendFormat dst src
          (ReportErrorsWithLegacySemantics true)
          (jsontext/AllowDuplicateNames true)
          (jsontext/AllowInvalidUTF8 true)
          (jsontext/PreserveRawStrings true)
          (jsontext/Multiline true)
          (jsontext/WithIndentPrefix prefix)
          (jsontext/WithIndent indent))]
      (when (!= err nil)
        (return (subslice dst _ dstLen) (transformSyntacticError err)))


      ;; In v2, trailing whitespace is discarded, while v1 preserved it.
      (when [n (- (len src) (len (bytes/TrimRight src " \n\r\t")))] (> n 0)
        (set! dst (append dst (spread (subslice src (- (len src) n))))))

      (return dst nil))))

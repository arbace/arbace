    ;;	║ null   (raw)     ║ "null"     │ ""         │ 0          ║
    ;;	║ false  (raw)     ║ "false"    │ ""         │ 0          ║
    ;;	║ true   (raw)     ║ "true"     │ ""         │ 0          ║

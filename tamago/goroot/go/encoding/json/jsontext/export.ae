^{:go/end 58} (go/method Decoder "Decoder returns a pointer to the underlying decoderState.\n" ^{:tag (* decoderState)} [export ^{:tag (* Decoder)} d] (addr (.-s d)))

^{:go/end 62} (go/method GetBufferedEncoder ^{:tag (* Encoder)} [export & ^{:tag (slice Options)} o]
  (getBufferedEncoder (spread o)))

^{:go/end 65} (go/method PutBufferedEncoder [export ^{:tag (* Encoder)} e]
  (putBufferedEncoder e))



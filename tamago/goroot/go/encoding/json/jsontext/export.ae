(in-ns 'go.encoding.json.jsontext) (go/file "export.go" :build ["//go:build goexperiment.jsonv2"] :imports [


    ^{:line 10} [io "io"]

    ^{:line 12} [internal "encoding/json/internal"]])


;; TODO(https://go.dev/issue/73435): Remove the Internal symbol.
;;
;; The Go language lacks a 3rd category of visibility where
;; certain symbols can only be referenced from within the same module.
;; One solution to this is to put the entirety of a package with
;; both public and module-only symbols exposed as an internal package.
;; A separate, public package can re-export all of the public symbols
;; via type aliases and thus ensuring module-only symbols cannot be
;; referenced by the end-user. While this works, it unfortunately
;; leads to a poor user experience since the Go pkgsite is unable to
;; forward the documentation for symbols like methods and fields.
;; We need to improve the pkgsite experience before we can delete
;; the Internal symbol.



(go/var ^{:tag exporter :doc "Internal is for internal use only.\nThis is exempt from the Go compatibility agreement.\n"} Internal)

(go/type exporter (struct))




^{:go/end 43} (go/method Export "Export exposes internal functionality from \"jsontext\" to \"json\".\nThis cannot be dynamically called by other packages since\nthey cannot obtain a reference to the internal.AllowInternalUse value.\n" ^export [exporter ^{:tag (* internal/NotForPublicUse)} p]
  (when (!= p (addr internal/AllowInternalUse))
    (panic "unauthorized call to Export"))

  (lit export))









(go/type export "The export type exposes functionality to packages with visibility to\nthe internal.AllowInternalUse variable. The \"json\" package uses this\nto modify low-level state in the Encoder and Decoder types.\nIt mutates the state directly instead of calling ReadToken or WriteToken\nsince this is more performant. The public APIs need to track state to ensure\nthat users are constructing a valid JSON value, but the \"json\" implementation\nguarantees that it emits valid JSON by the structure of the code itself.\n" (struct))



(in-ns 'go.encoding.json.jsontext) (go/file "quote.go" :build ["//go:build goexperiment.jsonv2"] :imports [


    ^{:line 10} [jsonflags "encoding/json/internal/jsonflags"]
    ^{:line 11} [jsonwire "encoding/json/internal/jsonwire"]])








^{:go/end 26} (go/func AppendQuote "AppendQuote appends a double-quoted JSON string literal representing src\nto dst and returns the extended buffer.\nIt uses the minimal string representation per RFC 8785, section 3.2.2.2.\nInvalid UTF-8 bytes are replaced with the Unicode replacement character\nand an error is returned at the end indicating the presence of invalid UTF-8.\nThe dst must not overlap with the src.\n" :type-params [^{:tag (| (tilde (slice byte)) (tilde string))} Bytes] [^{:tag (slice byte)} dst ^Bytes src] :results [(slice byte) error]
  (let [(values ^:assign dst err) (jsonwire/AppendQuote dst (conv (slice byte) src) (addr (lit jsonflags/Flags)))]
    (when (!= err nil)
      (set! err (addr (lit SyntacticError :Err err))))

    (return dst err)))









^{:go/end 41} (go/func AppendUnquote "AppendUnquote appends the decoded interpretation of src as a\ndouble-quoted JSON string literal to dst and returns the extended buffer.\nThe input src must be a JSON string without any surrounding whitespace.\nInvalid UTF-8 bytes are replaced with the Unicode replacement character\nand an error is returned at the end indicating the presence of invalid UTF-8.\nAny trailing bytes after the JSON string literal results in an error.\nThe dst must not overlap with the src.\n" :type-params [^{:tag (| (tilde (slice byte)) (tilde string))} Bytes] [^{:tag (slice byte)} dst ^Bytes src] :results [(slice byte) error]
  (let [(values ^:assign dst err) (jsonwire/AppendUnquote dst (conv (slice byte) src))]
    (when (!= err nil)
      (set! err (addr (lit SyntacticError :Err err))))

    (return dst err)))

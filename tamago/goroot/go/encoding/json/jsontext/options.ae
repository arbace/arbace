(in-ns 'go.encoding.json.jsontext) (go/file "options.go" :build ["//go:build goexperiment.jsonv2"] :imports [


    ^{:line 10} [strings "strings"]

    ^{:line 12} [jsonflags "encoding/json/internal/jsonflags"]
    ^{:line 13} [jsonopts "encoding/json/internal/jsonopts"]
    ^{:line 14} [jsonwire "encoding/json/internal/jsonwire"]])






























(go/type ^:alias Options "Options configures [NewEncoder], [Encoder.Reset], [NewDecoder],\nand [Decoder.Reset] with specific features.\nEach function takes in a variadic list of options, where properties\nset in later options override the value of previously set properties.\n\nThere is a single Options type, which is used with both encoding and decoding.\nSome options affect both operations, while others only affect one operation:\n\n  - [AllowDuplicateNames] affects encoding and decoding\n  - [AllowInvalidUTF8] affects encoding and decoding\n  - [EscapeForHTML] affects encoding only\n  - [EscapeForJS] affects encoding only\n  - [PreserveRawStrings] affects encoding only\n  - [CanonicalizeRawInts] affects encoding only\n  - [CanonicalizeRawFloats] affects encoding only\n  - [ReorderRawObjects] affects encoding only\n  - [SpaceAfterColon] affects encoding only\n  - [SpaceAfterComma] affects encoding only\n  - [Multiline] affects encoding only\n  - [WithIndent] affects encoding only\n  - [WithIndentPrefix] affects encoding only\n\nOptions that do not affect a particular operation are ignored.\n\nThe Options type is identical to [encoding/json.Options] and\n[encoding/json/v2.Options]. Options from the other packages may\nbe passed to functionality in this package, but are ignored.\nOptions from this package may be used with the other packages.\n" jsonopts/Options)








^{:go/end 60} (go/func AllowDuplicateNames "AllowDuplicateNames specifies that JSON objects may contain\nduplicate member names. Disabling the duplicate name check may provide\nperformance benefits, but breaks compliance with RFC 7493, section 2.3.\nThe input or output will still be compliant with RFC 8259,\nwhich leaves the handling of duplicate names as unspecified behavior.\n\nThis affects either encoding or decoding.\n" ^Options [^bool v]
  (if v
    (return (bit-or jsonflags/AllowDuplicateNames 1))

    (return (bit-or jsonflags/AllowDuplicateNames 0))))









^{:go/end 74} (go/func AllowInvalidUTF8 "AllowInvalidUTF8 specifies that JSON strings may contain invalid UTF-8,\nwhich will be mangled as the Unicode replacement character, U+FFFD.\nThis causes the encoder or decoder to break compliance with\nRFC 7493, section 2.1, and RFC 8259, section 8.1.\n\nThis affects either encoding or decoding.\n" ^Options [^bool v]
  (if v
    (return (bit-or jsonflags/AllowInvalidUTF8 1))

    (return (bit-or jsonflags/AllowInvalidUTF8 0))))








^{:go/end 87} (go/func EscapeForHTML "EscapeForHTML specifies that '<', '>', and '&' characters within JSON strings\nshould be escaped as a hexadecimal Unicode codepoint (e.g., \\u003c) so that\nthe output is safe to embed within HTML.\n\nThis only affects encoding and is ignored when decoding.\n" ^Options [^bool v]
  (if v
    (return (bit-or jsonflags/EscapeForHTML 1))

    (return (bit-or jsonflags/EscapeForHTML 0))))








^{:go/end 100} (go/func EscapeForJS "EscapeForJS specifies that U+2028 and U+2029 characters within JSON strings\nshould be escaped as a hexadecimal Unicode codepoint (e.g., \\u2028) so that\nthe output is valid to embed within JavaScript. See RFC 8259, section 12.\n\nThis only affects encoding and is ignored when decoding.\n" ^Options [^bool v]
  (if v
    (return (bit-or jsonflags/EscapeForJS 1))

    (return (bit-or jsonflags/EscapeForJS 0))))












^{:go/end 117} (go/func PreserveRawStrings "PreserveRawStrings specifies that when encoding a raw JSON string in a\n[Token] or [Value], pre-escaped sequences\nin a JSON string are preserved to the output.\nHowever, raw strings still respect [EscapeForHTML] and [EscapeForJS]\nsuch that the relevant characters are escaped.\nIf [AllowInvalidUTF8] is enabled, bytes of invalid UTF-8\nare preserved to the output.\n\nThis only affects encoding and is ignored when decoding.\n" ^Options [^bool v]
  (if v
    (return (bit-or jsonflags/PreserveRawStrings 1))

    (return (bit-or jsonflags/PreserveRawStrings 0))))
















^{:go/end 138} (go/func CanonicalizeRawInts "CanonicalizeRawInts specifies that when encoding a raw JSON\ninteger number (i.e., a number without a fraction and exponent) in a\n[Token] or [Value], the number is canonicalized\naccording to RFC 8785, section 3.2.2.3. As a special case,\nthe number -0 is canonicalized as 0.\n\nJSON numbers are treated as IEEE 754 double precision numbers.\nAny numbers with precision beyond what is representable by that form\nwill lose their precision when canonicalized. For example,\ninteger values beyond ±2⁵³ will lose their precision.\nFor example, 1234567890123456789 is formatted as 1234567890123456800.\n\nThis only affects encoding and is ignored when decoding.\n" ^Options [^bool v]
  (if v
    (return (bit-or jsonflags/CanonicalizeRawInts 1))

    (return (bit-or jsonflags/CanonicalizeRawInts 0))))
















^{:go/end 159} (go/func CanonicalizeRawFloats "CanonicalizeRawFloats specifies that when encoding a raw JSON\nfloating-point number (i.e., a number with a fraction or exponent) in a\n[Token] or [Value], the number is canonicalized\naccording to RFC 8785, section 3.2.2.3. As a special case,\nthe number -0 is canonicalized as 0.\n\nJSON numbers are treated as IEEE 754 double precision numbers.\nIt is safe to canonicalize a serialized single precision number and\nparse it back as a single precision number and expect the same value.\nIf a number exceeds ±1.7976931348623157e+308, which is the maximum\nfinite number, then it is saturated at that value and formatted as such.\n\nThis only affects encoding and is ignored when decoding.\n" ^Options [^bool v]
  (if v
    (return (bit-or jsonflags/CanonicalizeRawFloats 1))

    (return (bit-or jsonflags/CanonicalizeRawFloats 0))))








^{:go/end 172} (go/func ReorderRawObjects "ReorderRawObjects specifies that when encoding a raw JSON object in a\n[Value], the object members are reordered according to\nRFC 8785, section 3.2.3.\n\nThis only affects encoding and is ignored when decoding.\n" ^Options [^bool v]
  (if v
    (return (bit-or jsonflags/ReorderRawObjects 1))

    (return (bit-or jsonflags/ReorderRawObjects 0))))








^{:go/end 185} (go/func SpaceAfterColon "SpaceAfterColon specifies that the JSON output should emit a space character\nafter each colon separator following a JSON object name.\nIf false, then no space character appears after the colon separator.\n\nThis only affects encoding and is ignored when decoding.\n" ^Options [^bool v]
  (if v
    (return (bit-or jsonflags/SpaceAfterColon 1))

    (return (bit-or jsonflags/SpaceAfterColon 0))))








^{:go/end 198} (go/func SpaceAfterComma "SpaceAfterComma specifies that the JSON output should emit a space character\nafter each comma separator following a JSON object value or array element.\nIf false, then no space character appears after the comma separator.\n\nThis only affects encoding and is ignored when decoding.\n" ^Options [^bool v]
  (if v
    (return (bit-or jsonflags/SpaceAfterComma 1))

    (return (bit-or jsonflags/SpaceAfterComma 0))))
















^{:go/end 219} (go/func Multiline "Multiline specifies that the JSON output should expand to multiple lines,\nwhere every JSON object member or JSON array element appears on\na new, indented line according to the nesting depth.\n\nIf [SpaceAfterColon] is not specified, then the default is true.\nIf [SpaceAfterComma] is not specified, then the default is false.\nIf [WithIndent] is not specified, then the default is \"\\t\".\n\nIf set to false, then the output is a single line,\nwhere the only whitespace emitted is determined by the current\nvalues of [SpaceAfterColon] and [SpaceAfterComma].\n\nThis only affects encoding and is ignored when decoding.\n" ^Options [^bool v]
  (if v
    (return (bit-or jsonflags/Multiline 1))

    (return (bit-or jsonflags/Multiline 0))))














^{:go/end 255} (go/func WithIndent "WithIndent specifies that the encoder should emit multiline output\nwhere each element in a JSON object or array begins on a new, indented line\nbeginning with the indent prefix (see [WithIndentPrefix])\nfollowed by one or more copies of indent according to the nesting depth.\nThe indent must be composed of only space and tab characters.\n\nIf the intent is to emit indented output without a preference for\nthe particular indent string, then use [Multiline] instead.\n\nThis only affects encoding and is ignored when decoding.\nUse of this option implies [Multiline] being set to true.\n" ^Options [^string indent]
  ;; Fast-path: Return a constant for common indents, which avoids allocating.
  ;; These are derived from analyzing the Go module proxy on 2023-07-01.
  (switch indent
    (case ["\t"]
      (return (conv jsonopts/Indent "\t"))) ; ~14k usages
    (case ["    "]
      (return (conv jsonopts/Indent "    "))) ; ~18k usages
    (case ["   "]
      (return (conv jsonopts/Indent "   "))) ; ~1.7k usages
    (case ["  "]
      (return (conv jsonopts/Indent "  "))) ; ~52k usages
    (case [" "]
      (return (conv jsonopts/Indent " "))) ; ~12k usages
    (case [""]
      (return (conv jsonopts/Indent "")))) ; ~1.5k usages


  ;; Otherwise, allocate for this unique value.
  (when [s (strings/Trim indent " \t")] (> (len s) 0)
    (panic (+ "json: invalid character " (jsonwire/QuoteRune (conv (slice byte) s)) " in indent")))

  (conv jsonopts/Indent indent))










^{:go/end 270} (go/func WithIndentPrefix "WithIndentPrefix specifies that the encoder should emit multiline output\nwhere each element in a JSON object or array begins on a new, indented line\nbeginning with the indent prefix followed by one or more copies of indent\n(see [WithIndent]) according to the nesting depth.\nThe prefix must be composed of only space and tab characters.\n\nThis only affects encoding and is ignored when decoding.\nUse of this option implies [Multiline] being set to true.\n" ^Options [^string prefix]
  (when [s (strings/Trim prefix " \t")] (> (len s) 0)
    (panic (+ "json: invalid character " (jsonwire/QuoteRune (conv (slice byte) s)) " in indent prefix")))

  (conv jsonopts/IndentPrefix prefix))


;; /*
;; TODO(https://go.dev/issue/56733): Implement WithByteLimit and WithDepthLimit.
;; Remember to also update the "Security Considerations" section.
;; 
;; WithByteLimit sets a limit on the number of bytes of input or output bytes
;; that may be consumed or produced for each top-level JSON value.
;; If a [Decoder] or [Encoder] method call would need to consume/produce
;; more than a total of n bytes to make progress on the top-level JSON value,
;; then the call will report an error.
;; Whitespace before and within the top-level value are counted against the limit.
;; Whitespace after a top-level value are counted against the limit
;; for the next top-level value.
;;
;; A non-positive limit is equivalent to no limit at all.
;; If unspecified, the default limit is no limit at all.
;; This affects either encoding or decoding.
;; func WithByteLimit(n int64) Options {
;; return jsonopts.ByteLimit(max(n, 0))
;; }
;; 
;; WithDepthLimit sets a limit on the maximum depth of JSON nesting
;; that may be consumed or produced for each top-level JSON value.
;; If a [Decoder] or [Encoder] method call would need to consume or produce
;; a depth greater than n to make progress on the top-level JSON value,
;; then the call will report an error.
;;
;; A non-positive limit is equivalent to no limit at all.
;; If unspecified, the default limit is 10000.
;; This affects either encoding or decoding.
;; func WithDepthLimit(n int) Options {
;; return jsonopts.DepthLimit(max(n, 0))
;; }
;; */

  (bytes/Clone v))



^{:go/end 79} (go/method String "String returns the string formatting of v.\n" ^string [^Value v]
  (when (== v nil)
    (return "null"))

  (conv string v))

















^{:go/end 103} (go/method IsValid "IsValid reports whether the raw JSON value is syntactically valid\naccording to the specified options.\n\nBy default (if no options are specified), it validates according to RFC 7493.\nIt verifies whether the input is properly encoded as UTF-8,\nthat escape sequences within strings decode to valid Unicode codepoints, and\nthat all names in each object are unique.\nIt does not verify whether numbers are representable within the limits\nof any common numeric type (e.g., float64, int64, or uint64).\n\nRelevant options include:\n  - [AllowDuplicateNames]\n  - [AllowInvalidUTF8]\n\nAll other options are ignored.\n" ^bool [^Value v & ^{:tag (slice Options)} opts]
  ;; TODO: Document support for [WithByteLimit] and [WithDepthLimit].
  (let [d (getBufferedDecoder v (spread opts))]
    (defer (putBufferedDecoder d))
    (let [(values _ errVal) (.ReadValue d)
        (values _ errEOF) (.ReadToken d)]
      (and (== errVal nil) (== errEOF io/EOF)))))



























^{:go/end 133} (go/method Format "Format formats the raw JSON value in place.\n\nBy default (if no options are specified), it validates according to RFC 7493\nand produces the minimal JSON representation, where\nall whitespace is elided and JSON strings use the shortest encoding.\n\nRelevant options include:\n  - [AllowDuplicateNames]\n  - [AllowInvalidUTF8]\n  - [EscapeForHTML]\n  - [EscapeForJS]\n  - [PreserveRawStrings]\n  - [CanonicalizeRawInts]\n  - [CanonicalizeRawFloats]\n  - [ReorderRawObjects]\n  - [SpaceAfterColon]\n  - [SpaceAfterComma]\n  - [Multiline]\n  - [WithIndent]\n  - [WithIndentPrefix]\n\nAll other options are ignored.\n\nIt is guaranteed to succeed if the value is valid according to the same options.\nIf the value is already formatted, then the buffer is not mutated.\n" ^error [^{:tag (* Value)} v & ^{:tag (slice Options)} opts]
  ;; TODO: Document support for [WithByteLimit] and [WithDepthLimit].
  (.format v opts nil))





  (let [e (getBufferedEncoder (spread opts))]
    (defer (putBufferedEncoder e))
    (.Set ^{:go/via [Struct]} (.-Flags (.-s e)) (bit-or jsonflags/OmitTopLevelNewline 1))
    (when [err (.WriteValue (.-s e) (conv Value src))] (!= err nil)
      (return (append dst (spread src)) err))

    (return (append dst (spread ^{:go/via [encodeBuffer]} (.-Buf (.-s e)))) nil)))


;; NOTE: Value is analogous to v1 json.RawMessage.










(go/type Value "Value represents a single raw JSON value, which may be one of the following:\n  - a JSON literal (i.e., null, true, or false)\n  - a JSON string (e.g., \"hello, world!\")\n  - a JSON number (e.g., 123.456)\n  - an entire JSON object (e.g., {\"fizz\":\"buzz\"} )\n  - an entire JSON array (e.g., [1,2,3] )\n\nValue can represent entire array or object values, while [Token] cannot.\nValue may contain leading and/or trailing whitespace.\n" (slice byte))



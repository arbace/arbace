(ns go.encoding.json.internal.jsonopts
  (:require [arbace.go :as go]))

(go/package jsonopts
  :path "encoding/json/internal/jsonopts"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["options.go" "options_format.go"]
  :init-order [DefaultOptionsV2 DefaultOptionsV1 GetUnknownOption JoinUnknownOption enableFormatTag disableFormatTag]
  :positions :lines)

(load "jsonopts/options")
(load "jsonopts/options_format")

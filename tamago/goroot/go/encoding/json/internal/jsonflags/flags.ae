(go/type Flags "Flags is a set of boolean flags.\nIf the presence bit is zero, then the value bit must also be zero.\nThe least-significant bit of both fields is always zero.\n\nUnlike Bools, which can represent a set of bools that are all true or false,\nFlags represents a set of bools, each individually may be true or false.\n" (struct ^uint64 Presence ^uint64 Values))


^{:go/end 185} (go/method Join "Join joins two sets of flags such that the latter takes precedence.\n" [^{:tag (* Flags)} dst ^Flags src]
  ;; Copy over all source presence bits over to the destination (using OR),
  ;; then invert the source presence bits to clear out source value (using AND-NOT),
  ;; then copy over source value bits over to the destination (using OR).
  ;;	e.g., dst := Flags{Presence: 0b_1100_0011, Values: 0b_1000_0011}
  ;;	e.g., src := Flags{Presence: 0b_0101_1010, Values: 0b_1001_0010}
  (set! (.-Presence dst) bit-or (.-Presence src)) ; e.g., 0b_1100_0011 | 0b_0101_1010 -> 0b_1101_1011
  (set! (.-Values dst) bit-and (bit-not (.-Presence src))) ; e.g., 0b_1000_0011 & 0b_1010_0101 -> 0b_1000_0001
  (set! (.-Values dst) bit-or (.-Values src))) ; e.g., 0b_1000_0001 | 0b_1001_0010 -> 0b_1001_0011



^{:go/end 199} (go/method Set "Set sets both the presence and value for the provided bool (or set of bools).\n" [^{:tag (* Flags)} fs ^Bools f]
  ;; Select out the bits for the flag identifiers (everything except LSB),
  ;; then set the presence for all the identifier bits (using OR),
  ;; then invert the identifier bits to clear out the values (using AND-NOT),
  ;; then copy over all the identifier bits to the value if LSB is 1.
  ;;	e.g., fs := Flags{Presence: 0b_0101_0010, Values: 0b_0001_0010}
  ;;	e.g., f := 0b_1001_0001
  (let [id (bit-and-not (conv uint64 f) (conv uint64 1))] ; e.g., 0b_1001_0001 & 0b_1111_1110 -> 0b_1001_0000
    (set! (.-Presence fs) bit-or id) ; e.g., 0b_0101_0010 | 0b_1001_0000 -> 0b_1101_0010
    (set! (.-Values fs) bit-and (bit-not id)) ; e.g., 0b_0001_0010 & 0b_0110_1111 -> 0b_0000_0010
    (set! (.-Values fs) bit-or (* (conv uint64 (bit-and f 1)) id)))) ; e.g., 0b_0000_0010 | 0b_1001_0000 -> 0b_1001_0010





^{:go/end 206} (go/method Get "Get reports whether the bool (or any of the bools) is true.\nThis is generally only used with a singular bool.\nThe value bit of f (i.e., the LSB) is ignored.\n" ^bool [^Flags fs ^Bools f]
  (> (bit-and (.-Values fs) (conv uint64 f)) 0))




^{:go/end 212} (go/method Has "Has reports whether the bool (or any of the bools) is set.\nThe value bit of f (i.e., the LSB) is ignored.\n" ^bool [^Flags fs ^Bools f]
  (> (bit-and (.-Presence fs) (conv uint64 f)) 0))




^{:go/end 223} (go/method Clear "Clear clears both the presence and value for the provided bool or bools.\nThe value bit of f (i.e., the LSB) is ignored.\n" [^{:tag (* Flags)} fs ^Bools f]
  ;; Invert f to produce a mask to clear all bits in f (using AND).
  ;;	e.g., fs := Flags{Presence: 0b_0101_0010, Values: 0b_0001_0010}
  ;;	e.g., f := 0b_0001_1000
  (let [mask (conv uint64 (bit-not f))] ; e.g., 0b_0001_1000 -> 0b_1110_0111
    (set! (.-Presence fs) bit-and mask) ; e.g., 0b_0101_0010 &  0b_1110_0111 -> 0b_0100_0010
    (set! (.-Values fs) bit-and mask))) ; e.g., 0b_0001_0010 &  0b_1110_0111 -> 0b_0000_0010

      (return dst n nil))


    ;; Under [jsonflags.PreserveRawStrings], any pre-escaped sequences
    ;; remain escaped, however we still need to respect the
    ;; [jsonflags.EscapeForHTML] and [jsonflags.EscapeForJS] options.
    (when (.Get flags jsonflags/PreserveRawStrings)
      (let [(values ^int i ^int lastAppendIndex) (zero int)]
        (while (< i n)
          (if [c (aget src i)] (< c utf8/RuneSelf) (do
              (when (and ^:go/paren (or (== c \<) (== c \>) (== c \&)) (.Get flags jsonflags/EscapeForHTML))
                (set! dst (append dst (spread (subslice src lastAppendIndex i))))
                (set! dst (appendEscapedASCII dst c))

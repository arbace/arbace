^{:go/end 290} (go/func ReformatNumber "ReformatNumber consumes a JSON number from src and appends it to dst,\ncanonicalizing it if specified.\nIt returns the appended output and the number of consumed input bytes.\n" [^{:tag (slice byte)} dst ^{:tag (slice byte)} src ^{:tag (* jsonflags/Flags)} flags] :results [(slice byte) int error]

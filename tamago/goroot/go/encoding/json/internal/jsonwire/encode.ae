      (return dst n nil))))













^{:go/end 236} (go/func AppendFloat "AppendFloat appends src to dst as a JSON number per RFC 7159, section 6.\nIt formats numbers similar to the ES6 number-to-string conversion.\nSee https://go.dev/issue/14135.\n\nThe output is identical to ECMA-262, 6th edition, section 7.1.12.1 and with\nRFC 8785, section 3.2.2.3 for 64-bit floating-point numbers except for -0,\nwhich is formatted as -0 instead of just 0.\n\nFor 32-bit floating-point numbers,\nthe output is a 32-bit equivalent of the algorithm.\nNote that ECMA-262 specifies no algorithm for 32-bit numbers.\n" ^{:tag (slice byte)} [^{:tag (slice byte)} dst ^float64 src ^int bits]

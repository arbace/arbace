              (when (and ^:go/paren (or (== r \u2028) (== r \u2029)) (.Get flags jsonflags/EscapeForJS))
                (set! dst (append dst (spread (subslice src lastAppendIndex i))))
                (set! dst (appendEscapedUnicode dst r))
                (set! lastAppendIndex (+ i rn)))


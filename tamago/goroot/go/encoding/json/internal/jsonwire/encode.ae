  (if [(values r1 r2) (utf16/EncodeRune r)] (and (!= r1 \ufffd) (!= r2 \ufffd)) (do
      (set! dst (appendEscapedUTF16 dst (conv uint16 r1)))
      (set! dst (appendEscapedUTF16 dst (conv uint16 r2))))

    (set! dst (appendEscapedUTF16 dst (conv uint16 r))))

  ^{:line 139} dst)


^{:go/end 145} (go/func appendEscapedUTF16 ^{:tag (slice byte)} [^{:tag (slice byte)} dst ^uint16 x]
  (let [^:const ^{:val "0123456789abcdef"} hex "0123456789abcdef"]
    (append dst \\ \u (aget hex (bit-and (>> x 12) 0xf)) (aget hex (bit-and (>> x 8) 0xf)) (aget hex (bit-and (>> x 4) 0xf)) (aget hex (bit-and (>> x 0) 0xf)))))





^{:go/end 200} (go/func ReformatString "ReformatString consumes a JSON string from src and appends it to dst,\nreformatting it if necessary according to the specified flags.\nIt returns the appended output and the number of consumed input bytes.\n" [^{:tag (slice byte)} dst ^{:tag (slice byte)} src ^{:tag (* jsonflags/Flags)} flags] :results [(slice byte) int error]
  ;; TODO: Should this update ValueFlags as input?
  (let [^ValueFlags valFlags (zero ValueFlags)
      (values n err) (ConsumeString (addr valFlags) src (not (.Get flags jsonflags/AllowInvalidUTF8)))]
    (when (!= err nil)
      (return dst n err))


    ;; If the output requires no special escapes, and the input
    ;; is already in canonical form or should be preserved verbatim,
    ;; then directly copy the input to the output.
    (when (and (not (.Get flags jsonflags/AnyEscape))
        ^:go/paren (or (.IsCanonical valFlags) (.Get flags jsonflags/PreserveRawStrings)))

;; Package jsonwire implements stateless functionality for handling JSON text.
(in-ns 'go.encoding.json.internal.jsonwire) (go/file "wire.go" :build ["//go:build goexperiment.jsonv2"] :doc "Package jsonwire implements stateless functionality for handling JSON text.\n" :imports [


    ^{:line 11} [cmp "cmp"]
    ^{:line 12} [errors "errors"]

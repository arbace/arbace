(ns go.encoding.json.internal.jsonwire
  (:require [arbace.go :as go]))

(go/package jsonwire
  :path "encoding/json/internal/jsonwire"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["decode.go" "encode.go" "wire.go"]
  :init-order [escapeASCII ErrInvalidUTF8]
  :positions :lines)

(load "jsonwire/decode")
(load "jsonwire/encode")
(load "jsonwire/wire")

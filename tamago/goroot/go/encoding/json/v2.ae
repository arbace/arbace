(ns go.encoding.json.v2
  (:require [arbace.go :as go]))

(go/package json
  :path "encoding/json/v2"
  :files ["arshal.go" "arshal_any.go" "arshal_default.go" "arshal_embedded.go" "arshal_funcs.go" "arshal_methods.go" "arshal_time.go" "doc.go" "errors.go" "fields.go" "fold.go" "intern.go" "options.go"]
  :positions :lines)

(load "v2/arshal")
(load "v2/arshal_any")
(load "v2/arshal_default")
(load "v2/arshal_embedded")
(load "v2/arshal_funcs")
(load "v2/arshal_methods")
(load "v2/arshal_time")
(load "v2/doc")
(load "v2/errors")
(load "v2/fields")
(load "v2/fold")
(load "v2/intern")
(load "v2/options")

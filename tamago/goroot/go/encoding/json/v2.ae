(ns go.encoding.json.v2
  (:require [arbace.go :as go]))

(go/package json
  :path "encoding/json/v2"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["arshal.go" "arshal_any.go" "arshal_default.go" "arshal_embedded.go" "arshal_funcs.go" "arshal_methods.go" "arshal_time.go" "doc.go" "errors.go" "fields.go" "fold.go" "intern.go" "options.go"]
  :init-order [errChangingDuplicateNames errChangingInvalidUTF8 errChangingWhitespace export stringsPools anyType boolType stringType float64Type mapStringAnyType sliceAnyType bytesType emptyStructType appendEncodeBase16 appendEncodeBase32 appendEncodeBase32Hex appendEncodeBase64 appendEncodeBase64URL encodedLenBase16 encodedLenBase32 encodedLenBase32Hex encodedLenBase64 encodedLenBase64URL appendDecodeBase16 appendDecodeBase32 appendDecodeBase32Hex appendDecodeBase64 appendDecodeBase64URL errNilField errInvalidStringTag errArrayUnderflow errArrayOverflow errRawEmbedNotObject jsontextValueType errUnsupportedMutation errNonSingularValue errNonStringValue jsonMarshalerType jsonMarshalerToType jsonUnmarshalerType jsonUnmarshalerFromType textAppenderType textMarshalerType textUnmarshalerType allMarshalerTypes allUnmarshalerTypes allMethodTypes timeDurationType timeTimeType errInaccurateDateUnits ErrUnknownName errAmbiguousName errorModalVerb isZeroerType errNoExportedFields]
  :positions :lines)

(load "v2/arshal")

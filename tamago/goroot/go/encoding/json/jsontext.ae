(ns go.encoding.json.jsontext
  (:require [arbace.go :as go]))

(go/package jsontext
  :path "encoding/json/jsontext"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["decode.go" "doc.go" "encode.go" "errors.go" "export.go" "options.go" "pools.go" "quote.go" "state.go" "token.go" "value.go"]
  :init-order [errBufferWriteAfterNext bufferedEncoderPool streamingEncoderPool bytesBufferEncoderPool bufferedDecoderPool streamingDecoderPool bytesBufferDecoderPool ErrDuplicateName ErrNonStringName errMissingValue errMismatchDelim errMaxDepth errInvalidNamespace errInvalidToken Null False True BeginObject EndObject BeginArray EndArray zeroString zeroNumber nanString pinfString ninfString normKind objectMemberPool]
  :positions :lines)

(load "jsontext/decode")
(load "jsontext/doc")
(load "jsontext/encode")
(load "jsontext/errors")
(load "jsontext/export")
(load "jsontext/options")
(load "jsontext/pools")
(load "jsontext/quote")
(load "jsontext/state")
(load "jsontext/token")
(load "jsontext/value")

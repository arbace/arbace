^{:go/end 266} (go/method Token "Token returns the next JSON token in the input stream.\nAt the end of the input stream, Token returns nil, [io.EOF].\n\nToken guarantees that the delimiters [ ] { } it returns are\nproperly nested and matched: if Token encounters an unexpected\ndelimiter in the input, it will return an error.\n\nThe input stream consists of basic JSON values—bool, string,\nnumber, and null—along with delimiters [ ] { } of type [Delim]\nto mark the start and end of arrays and objects.\nCommas and colons are elided.\n" [^{:tag (* Decoder)} dec] :results [Token error]
  (when (!= (.-err dec) nil)
    (return nil (.-err dec)))

  (let [(values tok err) (.ReadToken (.-dec dec))]
    (when (!= err nil)
      ;; Historically, v1 would report just [io.EOF] if
      ;; the stream is a prefix of a valid JSON value.
      ;; It reports an unwrapped [io.ErrUnexpectedEOF] if
      ;; truncated within a JSON token such as a literal, number, or string.
      ;; If the underlying [io.Reader] produced the [io.ErrUnexpectedEOF],
      ;; then return the error as-is (including any wrapping).
      (when (and (errors/Is err io/ErrUnexpectedEOF) (not (.IsIOError export err)))
        (when (== (len (bytes/Trim (.UnreadBuffer (.-dec dec)) " \r\n\t,:")) 0)
          (set! (.-hadEOF dec) true)
          (return nil io/EOF))

        (return nil io/ErrUnexpectedEOF))

      (return nil (transformSyntacticError err)))

    (set! (.-hadPeeked dec) false)
    (set! (.-hadEOF dec) false)
    (switch [k (.Kind tok)] k
      (case [\n]
        (return nil nil))
      (case [\f]
        (return false nil))
      (case [\t]
        (return true nil))
      (case [\"]
        (return (.String tok) nil))
      (case [\0]
        (when [(values useNumber _) (^{:inst [bool]} jsonv2/GetOption (.-opts dec) unmarshalAnyWithRawNumber)] useNumber
          (return (conv Number (.String tok)) nil))

        (let [(values v err) (.Float tok)]
          (when (!= err nil)
            (return nil (addr (lit UnmarshalTypeError :Value (+ "number " (.String tok)) :Type ((inst reflect/TypeFor float64)) :Offset (.InputOffset dec)))))

          (return v nil)))
      (case [\{ \} \[ \]]
        (return (conv Delim k) nil))
      (default
        (panic "unreachable")))))





^{:go/end 287} (go/method More "More reports whether there is another element in the\ncurrent array or object being parsed.\n" ^bool [^{:tag (* Decoder)} dec]
  (set! (.-hadPeeked dec) true)
  (let [k (.PeekKind (.-dec dec))]
    (when (== k 0)
      (when (== (.-err dec) nil)
        ;; PeekKind doesn't distinguish between EOF and error,
        ;; so read the next token to see which we get.
        (let [(values _ err) (.ReadToken (.-dec dec))]
          (when (== err nil)
            ;; This is only possible if jsontext violates its documentation.
            (set! err (errors/New "json: successful read after failed peek")))

          (set! (.-err dec) (transformSyntacticError err))))

      (return (!= (.-err dec) io/EOF)))

    (and (!= k \]) (!= k \}))))





^{:go/end 313} (go/method InputOffset "InputOffset returns the input stream byte offset of the current decoder position.\nThe offset gives the location of the end of the most recently returned token\nand the beginning of the next token.\n" ^int64 [^{:tag (* Decoder)} dec]

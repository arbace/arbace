(go/type Token "A Token holds a value of one of these types:\n\n  - [Delim], for the four JSON delimiters [ ] { }\n  - bool, for JSON booleans\n  - float64, for JSON numbers\n  - [Number], for JSON numbers\n  - string, for JSON string literals\n  - nil, for JSON null\n" any)



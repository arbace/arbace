(in-ns 'go.encoding.json.v2) (go/file "options.go" :build ["//go:build goexperiment.jsonv2"] :imports [


    ^{:line 10} [fmt "fmt"]

    ^{:line 12} [internal "encoding/json/internal"]
    ^{:line 13} [jsonflags "encoding/json/internal/jsonflags"]
    ^{:line 14} [jsonopts "encoding/json/internal/jsonopts"]])


























































(go/type ^:alias Options "Options configure [Marshal], [MarshalWrite], [MarshalEncode],\n[Unmarshal], [UnmarshalRead], and [UnmarshalDecode] with specific features.\nEach function takes in a variadic list of options, where properties\nset in later options override the value of previously set properties.\n\nThe Options type is identical to [encoding/json.Options] and\n[encoding/json/jsontext.Options]. Options from the other packages can\nbe used interchangeably with functionality in this package.\n\nAn Options value represents either a single option or a set of options.\nIt can be thought of as a Go map of option properties\n(even though the underlying implementation avoids Go maps for performance).\n\nThe constructors (e.g., [Deterministic]) return a value for a single option:\n\n\topt := Deterministic(true)\n\nwhich is analogous to creating a single entry map:\n\n\topt := Options{\"Deterministic\": true}\n\n[JoinOptions] composes multiple options values together:\n\n\tout := JoinOptions(opts...)\n\nwhich is analogous to making a new map and copying the options over:\n\n\tout := make(Options)\n\tfor _, m := range opts {\n\t\tfor k, v := range m {\n\t\t\tout[k] = v\n\t\t}\n\t}\n\n[GetOption] looks up the value of an options parameter:\n\n\tv, ok := GetOption(opts, Deterministic)\n\nwhich is analogous to a Go map lookup:\n\n\tv, ok := Options[\"Deterministic\"]\n\nThere is a single Options type, which is used with both marshal and unmarshal.\nSome options affect both operations, while others only affect one operation:\n\n  - [StringifyNumbers] affects marshaling and unmarshaling\n  - [Deterministic] affects marshaling only\n  - [FormatNilSliceAsNull] affects marshaling only\n  - [FormatNilMapAsNull] affects marshaling only\n  - [OmitZeroStructFields] affects marshaling only\n  - [MatchCaseInsensitiveNames] affects marshaling and unmarshaling\n  - [RejectUnknownMembers] affects unmarshaling only\n  - [WithMarshalers] affects marshaling only\n  - [WithUnmarshalers] affects unmarshaling only\n\nOptions that do not affect a particular operation are ignored.\n" jsonopts/Options)



^{:go/end 81} (go/func JoinOptions "JoinOptions coalesces the provided list of options into a single Options.\nProperties set in later options override the value of previously set properties.\n" ^Options [& ^{:tag (slice Options)} srcs]
  (let [^jsonopts/Struct dst (zero jsonopts/Struct)]
    (.Join dst (spread srcs))
    (addr dst)))














^{:go/end 97} (go/func GetOption "GetOption returns the value stored in opts with the provided setter,\nreporting whether the value is present.\nIf not present, the returned value is the zero value for type T.\n\nExample usage:\n\n\tv, ok := json.GetOption(opts, json.Deterministic)\n\nOptions are most commonly introspected to alter the JSON representation of\n[MarshalerTo.MarshalJSONTo] and [UnmarshalerFrom.UnmarshalJSONFrom] methods, and\n[MarshalToFunc] and [UnmarshalFromFunc] functions.\nIn such cases, the presence bit should generally be ignored.\n" :type-params [T] [^Options opts ^{:tag (func [T] [Options])} setter] :results [T bool]
  (^{:inst [T]} jsonopts/GetOption opts setter))





^{:go/end 104} (go/func DefaultOptionsV2 "DefaultOptionsV2 is the full set of all options that define v2 semantics.\nIt is equivalent to the set of options in [encoding/json.DefaultOptionsV1]\nall being set to false. All other options are not present.\n" ^Options []
  (addr jsonopts/DefaultOptionsV2))





























^{:go/end 139} (go/func StringifyNumbers "StringifyNumbers specifies that types that would normally be\nencoded as a JSON number instead be encoded as a JSON string\ncontaining the equivalent JSON number value.\nWhen unmarshaling, the value is parsed from a JSON string\ncontaining the JSON number without any surrounding whitespace.\n\nSpecifying the `string` tag option on a Go struct field applies this option\nto the top-level JSON value for that field. When applied via the `string`\ntag option, StringifyNumbers option does not recursively apply to nested\nJSON numbers within a JSON object or array.\n\nLike all options, explicitly specifying this option in a call to [Marshal],\n[Unmarshal], etc, will apply recursively.\n\nA Go type with custom marshal/unmarshal that represents a JSON number\nshould respect the StringifyNumbers option and if specified\nserialize as a JSON number within a JSON string.\nCustom marshal/unmarshal should handle nested JSON objects using\n[MarshalEncode]/[UnmarshalDecode], which will automatically apply the\nnon-recursive `string` tag option behavior.\n\nAccording to RFC 8259, section 6, a JSON implementation may choose to\nlimit the representation of a JSON number to an IEEE 754 binary64 value.\nThis may cause decoders to lose precision for int64 and uint64 types.\nQuoting JSON numbers as a JSON string preserves the exact precision.\n\nThis affects either marshaling or unmarshaling.\n" ^Options [^bool v]
  (if v
    (return (bit-or jsonflags/StringifyNumbers 1))

    (return (bit-or jsonflags/StringifyNumbers 0))))

















^{:go/end 161} (go/func Deterministic "Deterministic specifies that marshaling the same input value will always\nserialize as the same output bytes.\n\nFor example, Go maps are marshaled sorted by key.\n\nFor native Go types, Determinism is guaranteed across different instances of\nidentical binaries, but not across different builds of a program (such as\ndifferent source or toolchain version, different GOOS/GOARCH, different\nbuild flags).\n\nA Go type with a custom marshaler should also respect the Deterministic\noption and serialize deterministically if it is true.\n\nThis only affects marshaling and is ignored when unmarshaling.\n" ^Options [^bool v]
  (if v
    (return (bit-or jsonflags/Deterministic 1))

    (return (bit-or jsonflags/Deterministic 0))))








^{:go/end 174} (go/func FormatNilSliceAsNull "FormatNilSliceAsNull specifies that a nil Go slice should marshal as a\nJSON null instead of the default representation as an empty JSON array\n(or an empty JSON string in the case of ~[]byte).\n\nThis only affects marshaling and is ignored when unmarshaling.\n" ^Options [^bool v]
  (if v
    (return (bit-or jsonflags/FormatNilSliceAsNull 1))

    (return (bit-or jsonflags/FormatNilSliceAsNull 0))))







^{:go/end 186} (go/func FormatNilMapAsNull "FormatNilMapAsNull specifies that a nil Go map should marshal as a\nJSON null instead of the default representation as an empty JSON object.\n\nThis only affects marshaling and is ignored when unmarshaling.\n" ^Options [^bool v]
  (if v
    (return (bit-or jsonflags/FormatNilMapAsNull 1))

    (return (bit-or jsonflags/FormatNilMapAsNull 0))))











^{:go/end 202} (go/func OmitZeroStructFields "OmitZeroStructFields specifies that zero-valued fields of Go struct should be\nomitted from the marshaled output.\nA value is considered zero if its type has an \"IsZero() bool\" method that returns true,\nor if it lacks such a method and the value is a Go zero value.\nThis option is equivalent to specifying the `omitzero` tag option\non every field in a Go struct.\n\nThis only affects marshaling and is ignored when unmarshaling.\n" ^Options [^bool v]
  (if v
    (return (bit-or jsonflags/OmitZeroStructFields 1))

    (return (bit-or jsonflags/OmitZeroStructFields 0))))
























^{:go/end 231} (go/func MatchCaseInsensitiveNames "MatchCaseInsensitiveNames specifies that JSON object members are matched\nagainst Go struct fields using a case-insensitive match of the name.\nIf a name matches multiple fields, the field whose name matches exactly is chosen.\nIf there is none, an error is reported.\nGo struct fields explicitly marked with `case:strict` or `case:ignore`\nalways use case-sensitive (or case-insensitive) name matching,\nregardless of the value of this option.\n\nThis affects either marshaling or unmarshaling.\n\nMatching names case-insensitively also affects duplicate name detection\n(assuming [jsontext.AllowDuplicateNames] is false) since\nvariations of the same name may match the same Go struct field.\nFor example, when unmarshaling, the names \"foo\" and \"Foo\" may both\nmatch the same Go struct field and therefore be considered a duplicate name.\nWhen marshaling, normally it is impossible for any two Go struct fields to\nserialize in a way where they unmarshal into the same Go struct field\nsince they all have unique exact names.\nHowever, it is possible for an\nembedded fallback to contain a name that also matches the name for\na Go struct field, resulting in a duplicate name error.\n" ^Options [^bool v]
  (if v
    (return (bit-or jsonflags/MatchCaseInsensitiveNames 1))

    (return (bit-or jsonflags/MatchCaseInsensitiveNames 0))))







^{:go/end 243} (go/func RejectUnknownMembers "RejectUnknownMembers specifies that unknown members should be rejected\nwhen unmarshaling a JSON object.\n\nThis only affects unmarshaling and is ignored when marshaling.\n" ^Options [^bool v]
  (if v
    (return (bit-or jsonflags/RejectUnknownMembers 1))

    (return (bit-or jsonflags/RejectUnknownMembers 0))))








^{:go/end 252} (go/func WithMarshalers "WithMarshalers specifies a list of type-specific marshalers to use,\nwhich can be used to override the default marshal behavior for values\nof particular types.\n\nThis only affects marshaling and is ignored when unmarshaling.\n" ^Options [^{:tag (* Marshalers)} v]
  (conv (* marshalersOption) v))







^{:go/end 261} (go/func WithUnmarshalers "WithUnmarshalers specifies a list of type-specific unmarshalers to use,\nwhich can be used to override the default unmarshal behavior for values\nof particular types.\n\nThis only affects unmarshaling and is ignored when marshaling.\n" ^Options [^{:tag (* Unmarshalers)} v]
  (conv (* unmarshalersOption) v))




(go/type "These option types are declared here instead of \"jsonopts\"\nto avoid a dependency on \"reflect\" from \"jsonopts\".\n"
  ^{:line 266} [marshalersOption Marshalers]
  ^{:line 267} [unmarshalersOption Unmarshalers])


^{:go/end 270} (go/method JSONOptions [(* marshalersOption) internal/NotForPublicUse])
^{:go/end 271} (go/method JSONOptions [(* unmarshalersOption) internal/NotForPublicUse])


^{:go/end 304} (go/func init "Inject support into \"jsonopts\" to handle these types.\n" []
  (set! jsonopts/GetUnknownOption ^{:go/end 290} (fn [^jsonopts/Struct src ^jsonopts/Options zero] :results [any bool]
      (type-switch zero
        (case [(* marshalersOption)]
          (when (not (.Has (.-Flags src) jsonflags/Marshalers))
            (return (conv (* Marshalers) nil) false))

          (return (assert (* Marshalers) ^{:go/via [ArshalValues]} (.-Marshalers src)) true))
        (case [(* unmarshalersOption)]
          (when (not (.Has (.-Flags src) jsonflags/Unmarshalers))
            (return (conv (* Unmarshalers) nil) false))

          (return (assert (* Unmarshalers) ^{:go/via [ArshalValues]} (.-Unmarshalers src)) true))
        (default
          (panic (fmt/Sprintf "unknown option %T" zero))))))


  (set! jsonopts/JoinUnknownOption ^{:go/end 303} (fn ^jsonopts/Struct [^jsonopts/Struct dst ^jsonopts/Options src]
      (type-switch [src src]
        (case [(* marshalersOption)]
          (.Set (.-Flags dst) (bit-or jsonflags/Marshalers 1))
          (set! ^{:go/via [ArshalValues]} (.-Marshalers dst) (conv (* Marshalers) src)))
        (case [(* unmarshalersOption)]
          (.Set (.-Flags dst) (bit-or jsonflags/Unmarshalers 1))
          (set! ^{:go/via [ArshalValues]} (.-Unmarshalers dst) (conv (* Unmarshalers) src)))
        (default
          (panic (fmt/Sprintf "unknown option %T" src))))

      ^{:line 302} dst)))

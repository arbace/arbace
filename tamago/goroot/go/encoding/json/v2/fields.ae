                      (switch opt
                        (case ["ignore"]
                          (set! (.-casing out) bit-or caseIgnore))
                        (case ["strict"]
                          (set! (.-casing out) bit-or caseStrict))
                        (default
                          (set! err (^{:inst [error]} cmp/Or err (fmt/Errorf "Go struct field %s has unknown `case:%s` tag value" (.-Name sf) rawOpt))))))))

                (case ["embed"]
                  (set! (.-embed out) true))
                (case ["omitzero"]
                  (set! (.-omitzero out) true))
                (case ["omitempty"]
                  (set! (.-omitempty out) true))
                (case ["string"]
                  (set! (.-string out) true))
                (case ["format"]
                  (when (not (strings/HasPrefix tag ":"))
                    (set! err (^{:inst [error]} cmp/Or err (fmt/Errorf "Go struct field %s is missing value for `format` tag option" (.-Name sf))))
                    (break))

                  (set! tag (subslice tag (len ":")))
                  (let [(values opt n err2) (consumeTagOption tag true)]
                    (cond (!= err2 nil) (do
                        (set! err (^{:inst [error]} cmp/Or err (fmt/Errorf "Go struct field %s has malformed value for `format` tag option: %v" (.-Name sf) err2)))
                        (break))
                      (== opt "") (do
                        (set! err (^{:inst [error]} cmp/Or err (fmt/Errorf "Go struct field %s cannot have empty value for `format` tag option" (.-Name sf))))
                        (break)))

                    (set! tag (subslice tag n))
                    (set! (.-format out) opt)
                    (set! wasFormat true)))
                (default
                  ;; Reject keys that resemble one of the supported options.
                  ;; This catches invalid mutants such as "omitEmpty" or "omit_empty".
                  (let [normOpt (strings/ReplaceAll (strings/ToLower opt) "_" "")]
                    (switch normOpt
                      (case ["case" "embed" "omitzero" "omitempty" "string" "format"]
                        (set! err (^{:inst [error]} cmp/Or err (fmt/Errorf "Go struct field %s has invalid appearance of `%s` tag option; specify `%s` instead" (.-Name sf) opt normOpt))))))))


              ;; NOTE: Everything else is ignored. This does not mean it is
              ;; forward compatible to insert arbitrary tag options since
              ;; a future version of this package may understand that tag.


              ;; Reject duplicates.
              (switch
                (case [(== (.-casing out) (bit-or caseIgnore caseStrict))]
                  (set! err (^{:inst [error]} cmp/Or err (fmt/Errorf "Go struct field %s cannot have both `case:ignore` and `case:strict` tag options" (.-Name sf)))))
                (case [(aget seenOpts opt)]
                  (set! err (^{:inst [error]} cmp/Or err (fmt/Errorf "Go struct field %s has duplicate appearance of `%s` tag option" (.-Name sf) rawOpt)))))

              (aset seenOpts opt true))))

        (return out false err)))))






^{:go/end 640} (go/func consumeTagOption "consumeTagOption consumes the next option,\nwhich is either a Go identifier or a single-quoted string.\nIf the next option is invalid, it returns all of in until the next comma,\nand reports an error.\n" [^string in ^bool allowQuoted] :results [string int error]
  ;; For legacy compatibility with v1, assume options are comma-separated.
  (let [i (strings/IndexByte in \,)]
    (when (< i 0)
      (set! i (len in)))


    (switch [(values r _) (utf8/DecodeRuneInString in)]
      ;; Option as a Go identifier.
      (case [(or (== r \_) (unicode/IsLetter r))]
        (let [n (- (len in) (len (strings/TrimLeftFunc in isLetterOrDigit)))]
          (return (subslice in _ n) n nil)))
      ;; Option as a single-quoted string.
      (case [(== r \')]
        (when (not allowQuoted)
          (return (subslice in _ i) i (fmt/Errorf "invalid character %q at start of option (expecting Unicode letter)" r)))


        ;; The grammar is nearly identical to a double-quoted Go string literal,
        ;; but uses single quotes as the terminators. The reason for a custom
        ;; grammar is because both backtick and double quotes cannot be used
        ;; verbatim in a struct tag.
        ;;
        ;; Convert a single-quoted string to a double-quote string and rely on
        ;; strconv.Unquote to handle the rest.
        (let [^bool inEscape (zero bool)
            ^{:line 602} b (lit (slice byte) \")
            ^{:line 603} n (len "'")]
          (while (> (len in) n)
            (let [(values r rn) (utf8/DecodeRuneInString (subslice in n))]
              (switch
                (case [inEscape]
                  (when (== r \')
                    (set! b (subslice b _ (- (len b) 1)))) ; remove escape character: `\'` => `'`

                  (set! inEscape false))
                (case [(== r \\)]
                  (set! inEscape true))
                (case [(== r \")]
                  (set! b (append b \\))) ; insert escape character: `"` => `\"`
                (case [(== r \')]
                  (set! b (append b \"))
                  (set! n + (len "'"))
                  (let [(values out err) (strconv/Unquote (conv string b))]
                    (when (!= err nil)
                      (return (subslice in _ i) i (fmt/Errorf "invalid single-quoted string: %s" (subslice in _ n))))

                    (return out n nil))))

              (set! b (append b (spread (subslice (subslice in n) _ rn))))
              (set! n + rn)))

          (when (> n 10)
            (set! n 10)) ; limit the amount of context printed in the error

          (return (subslice in _ i) i (fmt/Errorf "single-quoted string not terminated: %s..." (subslice in _ n)))))
      (case [(== (len in) 0)]
        (return (subslice in _ i) i io/ErrUnexpectedEOF))
      (default
        (when (not allowQuoted)
          (return (subslice in _ i) i (fmt/Errorf "invalid character %q at start of option (expecting Unicode letter)" r)))

        (return (subslice in _ i) i (fmt/Errorf "invalid character %q at start of option (expecting Unicode letter or single quote)" r))))))



^{:go/end 644} (go/func isLetterOrDigit ^bool [^rune r]
  (or (== r \_) (unicode/IsLetter r) (unicode/IsNumber r)))



^{:go/end 656} (go/func boolsCompare "boolsCompare compares x and y, ordering false before true.\n" ^int [^bool x ^bool y]
  (switch
    (case [(and (not x) y)]
      (return -1))
    (default
      (return 0))
    (case [(and x (not y))]
      (return (+ 1)))))

(go/type ^:alias stringCache "stringCache is a cache for strings converted from a []byte.\n" (array 256 string)) ; 256*unsafe.Sizeof(string("")) => 4KiB




^{:go/end 55} (go/func makeString "makeString returns the string form of b.\nIt returns a pre-allocated string from c if present, otherwise\nit allocates a new string, inserts it into the cache, and returns it.\n" ^string [^{:tag (* stringCache)} c ^{:tag (slice byte)} b]

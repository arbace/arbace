      ^:const ^:go/grouped ^{:line 23 :val 256} maxCachedLen 256] ; large enough for UUIDs, IPv6 addresses, SHA-256 checksums, etc.

    (when (or (== c nil) (< (len b) minCachedLen) (> (len b) maxCachedLen))
      (return (conv string b)))


    ;; Compute a hash from the fixed-width prefix and suffix of the string.
    ;; This ensures hashing a string is a constant time operation.
    (let [^uint32 h (zero uint32)]
      (switch
        (case [(>= (len b) 8)]
          (let [lo (.Uint64 binary/LittleEndian (subslice b _ 8))
              ^{:line 35} hi (.Uint64 binary/LittleEndian (subslice b (- (len b) 8)))]

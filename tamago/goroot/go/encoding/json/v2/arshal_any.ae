    ^{:go/via [Value]} (.Set v (reflect/ValueOf val))
    (let [marshal (.-marshal (lookupArshaler ^{:go/via [Value]} (.Type v)))]
      (when (!= ^{:go/via [ArshalValues]} (.-Marshalers mo) nil)
        (set! (values marshal _) (.lookup (assert (* Marshalers) ^{:go/via [ArshalValues]} (.-Marshalers mo)) marshal ^{:go/via [Value]} (.Type v))))

      (marshal enc v mo))))







(ns go.encoding.asn1
  (:require [arbace.go :as go]))

(go/package asn1
  :path "encoding/asn1"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["asn1.go" "common.go" "marshal.go"]
  :init-order [bigOne NullRawValue NullBytes bitStringType objectIdentifierType enumeratedType flagType timeType rawValueType rawContentsType bigIntType byte00Encoder byteFFEncoder]
  :positions :lines)

(load "asn1/asn1")
(load "asn1/common")
(load "asn1/marshal")

(ns go.encoding.gob
  (:require [arbace.go :as go]))

(go/package gob
  :path "encoding/gob"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["dec_helpers.go" "decode.go" "decoder.go" "doc.go" "enc_helpers.go" "encode.go" "encoder.go" "error.go" "type.go"]
  :init-order [errBadUint decArrayHelper decSliceHelper errBadType errRange decOpTable maxIgnoreNestingDepth emptyStructType errBadCount encArrayHelper encSliceHelper encBufferPool encOpTable spaceForLength gobEncoderInterfaceType gobDecoderInterfaceType binaryMarshalerInterfaceType binaryUnmarshalerInterfaceType textMarshalerInterfaceType textUnmarshalerInterfaceType wireTypeType types idToTypeSlice tBool tInt tUint tFloat tBytes tString tComplex decIgnoreOpMap tInterface tReserved7 tReserved6 tReserved5 tReserved4 tReserved3 tReserved2 tReserved1 typeInfoMapInit tWireType]
  :positions :lines)

(load "gob/dec_helpers")
(load "gob/decode")
(load "gob/decoder")
(load "gob/doc")
(load "gob/enc_helpers")
(load "gob/encode")
(load "gob/encoder")
(load "gob/error")
(load "gob/type")

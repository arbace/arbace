(ns go.encoding.gob
  (:require [arbace.go :as go]))

(go/package gob
  :path "encoding/gob"
  :files ["dec_helpers.go" "decode.go" "decoder.go" "doc.go" "enc_helpers.go" "encode.go" "encoder.go" "error.go" "type.go"]
  :positions :lines)

(load "gob/dec_helpers")
(load "gob/decode")
(load "gob/decoder")
(load "gob/doc")
(load "gob/enc_helpers")
(load "gob/encode")
(load "gob/encoder")
(load "gob/error")
(load "gob/type")

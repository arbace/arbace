(ns go.encoding.binary
  (:require [arbace.go :as go]))

(go/package binary
  :path "encoding/binary"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["binary.go" "native_endian_little.go" "varint.go"]
  :init-order [errBufferTooSmall errOverflow]
  :positions :lines)

(load "binary/binary")
(load "binary/native_endian_little")
(load "binary/varint")

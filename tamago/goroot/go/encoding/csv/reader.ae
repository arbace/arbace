;; Package csv reads and writes comma-separated values (CSV) files.
;; There are many kinds of CSV files; this package supports the format
;; described in RFC 4180, except that [Writer] uses LF
;; instead of CRLF as newline character by default.
;;
;; A csv file contains zero or more records of one or more fields per record.
;; Each record is separated by the newline character. The final record may
;; optionally be followed by a newline character.
;;
;;	field1,field2,field3
;;
;; White space is considered part of a field.
;;
;; Carriage returns before newline characters are silently removed.
;;
;; Blank lines are ignored. A line with only whitespace characters (excluding
;; the ending newline character) is not considered a blank line.
;;
;; Fields which start and stop with the quote character " are called
;; quoted-fields. The beginning and ending quote are not part of the
;; field.
;;
;; The source:
;;
;;	normal string,"quoted-field"
;;
;; results in the fields
;;
;;	{`normal string`, `quoted-field`}
;;
;; Within a quoted-field a quote character followed by a second quote
;; character is considered a single quote.
;;
;;	"the ""word"" is true","a ""quoted-field"""
;;
;; results in
;;
;;	{`the "word" is true`, `a "quoted-field"`}
;;
;; Newlines and commas may be included in a quoted-field
;;
;;	"Multi-line
;;	field","comma is ,"
;;
;; results in
;;
;;	{`Multi-line
;;	field`, `comma is ,`}
(in-ns 'go.encoding.csv) (go/file "reader.go" :doc "Package csv reads and writes comma-separated values (CSV) files.\nThere are many kinds of CSV files; this package supports the format\ndescribed in RFC 4180, except that [Writer] uses LF\ninstead of CRLF as newline character by default.\n\nA csv file contains zero or more records of one or more fields per record.\nEach record is separated by the newline character. The final record may\noptionally be followed by a newline character.\n\n\tfield1,field2,field3\n\nWhite space is considered part of a field.\n\nCarriage returns before newline characters are silently removed.\n\nBlank lines are ignored. A line with only whitespace characters (excluding\nthe ending newline character) is not considered a blank line.\n\nFields which start and stop with the quote character \" are called\nquoted-fields. The beginning and ending quote are not part of the\nfield.\n\nThe source:\n\n\tnormal string,\"quoted-field\"\n\nresults in the fields\n\n\t{`normal string`, `quoted-field`}\n\nWithin a quoted-field a quote character followed by a second quote\ncharacter is considered a single quote.\n\n\t\"the \"\"word\"\" is true\",\"a \"\"quoted-field\"\"\"\n\nresults in\n\n\t{`the \"word\" is true`, `a \"quoted-field\"`}\n\nNewlines and commas may be included in a quoted-field\n\n\t\"Multi-line\n\tfield\",\"comma is ,\"\n\nresults in\n\n\t{`Multi-line\n\tfield`, `comma is ,`}\n" :imports [


    ^{:line 56} [bufio "bufio"]
    ^{:line 57} [bytes "bytes"]
    ^{:line 58} [errors "errors"]
    ^{:line 59} [fmt "fmt"]
    ^{:line 60} [io "io"]
    ^{:line 61} [unicode "unicode"]
    ^{:line 62} [utf8 "unicode/utf8"]])




(go/type ParseError "A ParseError is returned for parsing errors.\nLine and column numbers are 1-indexed.\n" (struct
    ^{:line 68 :tag int} StartLine ; Line where the record starts
    ^{:line 69 :tag int} Line ; Line where the error occurred
    ^{:line 70 :tag int} Column ; Column (1-based byte index) where the error occurred
    ^{:line 71 :tag error} Err)) ; The actual error


^{:go/end 82} (go/method Error ^string [^{:tag (* ParseError)} e]
  (when (== (.-Err e) ErrFieldCount)
    (return (fmt/Sprintf "record on line %d: %v" (.-Line e) (.-Err e))))

  (when (!= (.-StartLine e) (.-Line e))
    (return (fmt/Sprintf "record on line %d; parse error on line %d, column %d: %v" (.-StartLine e) (.-Line e) (.-Column e) (.-Err e))))

  (fmt/Sprintf "parse error on line %d, column %d: %v" (.-Line e) (.-Column e) (.-Err e)))


^{:go/end 84} (go/method Unwrap ^error [^{:tag (* ParseError)} e] (.-Err e))


(go/var "These are the errors that can be returned in [ParseError.Err].\n"
  ^{:line 88} [ErrBareQuote (errors/New "bare \" in non-quoted-field")]
  ^{:line 89} [ErrQuote (errors/New "extraneous or missing \" in quoted-field")]
  ^{:line 90} [ErrFieldCount (errors/New "wrong number of fields")]


  ^{:line 93} [^{:doc "Deprecated: ErrTrailingComma is no longer used.\n"} ErrTrailingComma (errors/New "extra delimiter at end of line")])


(go/var errInvalidDelim (errors/New "csv: invalid field or comment delimiter"))

^{:go/end 100} (go/func validDelim ^bool [^rune r]
  (and (!= r 0) (!= r \") (!= r \return) (!= r \newline) (utf8/ValidRune r) (!= r utf8/RuneError)))











(go/type Reader "A Reader reads records from a CSV-encoded file.\n\nAs returned by [NewReader], a Reader expects input conforming to RFC 4180.\nThe exported fields can be changed to customize the details before the\nfirst call to [Reader.Read] or [Reader.ReadAll].\n\nThe Reader converts all \\r\\n sequences in its input to plain \\n,\nincluding in multiline field values, so that the returned data does\nnot depend on which line-ending convention an input file uses.\n" (struct




    ^{:line 116 :tag rune :doc "Comma is the field delimiter.\nIt is set to comma (',') by NewReader.\nComma must be a valid rune and must not be \\r, \\n,\nor the Unicode replacement character (0xFFFD).\n"} Comma








    ^{:line 125 :tag rune :doc "Comment, if not 0, is the comment character. Lines beginning with the\nComment character without preceding whitespace are ignored.\nWith leading whitespace the Comment character becomes part of the\nfield, even if TrimLeadingSpace is true.\nComment must be a valid rune and must not be \\r, \\n,\nor the Unicode replacement character (0xFFFD).\nIt must also not be equal to Comma.\n"} Comment







    ^{:line 133 :tag int :doc "FieldsPerRecord is the number of expected fields per record.\nIf FieldsPerRecord is positive, Read requires each record to\nhave the given number of fields. If FieldsPerRecord is 0, Read sets it to\nthe number of fields in the first record, so that future records must\nhave the same field count. If FieldsPerRecord is negative, no check is\nmade and records may have a variable number of fields.\n"} FieldsPerRecord



    ^{:line 137 :tag bool :doc "If LazyQuotes is true, a quote may appear in an unquoted field and a\nnon-doubled quote may appear in a quoted field.\n"} LazyQuotes



    ^{:line 141 :tag bool :doc "If TrimLeadingSpace is true, leading white space in a field is ignored.\nThis is done even if the field delimiter, Comma, is white space.\n"} TrimLeadingSpace




    ^{:line 146 :tag bool :doc "ReuseRecord controls whether calls to Read may return a slice sharing\nthe backing array of the previous call's returned slice for performance.\nBy default, each call to Read returns newly allocated memory owned by the caller.\n"} ReuseRecord


    ^{:line 149 :tag bool :doc "Deprecated: TrailingComma is no longer used.\n"} TrailingComma

    ^{:line 151 :tag (* bufio/Reader)} r


    ^{:line 154 :tag int :doc "numLine is the current line being read in the CSV file.\n"} numLine


    ^{:line 157 :tag int64 :doc "offset is the input stream byte offset of the current reader position.\n"} offset


    ^{:line 160 :tag (slice byte) :doc "rawBuffer is a line buffer only used by the readLine method.\n"} rawBuffer





    ^{:line 166 :tag (slice byte) :doc "recordBuffer holds the unescaped fields, one after another.\nThe fields can be accessed by using the indexes in fieldIndexes.\nE.g., For the row `a,\"b\",\"c\"\"d\",e`, recordBuffer will contain `abc\"de`\nand fieldIndexes will contain the indexes [1, 2, 5, 6].\n"} recordBuffer



    ^{:line 170 :tag (slice int) :doc "fieldIndexes is an index of fields inside recordBuffer.\nThe i'th field ends at offset fieldIndexes[i] in recordBuffer.\n"} fieldIndexes



    ^{:line 174 :tag (slice position) :doc "fieldPositions is an index of field positions for the\nlast record returned by Read.\n"} fieldPositions


    ^{:line 177 :tag (slice string) :doc "lastRecord is a record cache and only used when ReuseRecord == true.\n"} lastRecord))



^{:go/end 186} (go/func NewReader "NewReader returns a new Reader that reads from r.\n" ^{:tag (* Reader)} [^io/Reader r]
  (addr ^{:go/breaks [2 4]} (lit Reader
      :Comma \,
      :r (bufio/NewReader r))))












^{:go/end 205} (go/method Read "Read reads one record (a slice of fields) from r.\nIf the record has an unexpected number of fields,\nRead returns the record along with the error [ErrFieldCount].\nIf the record contains a field that cannot be parsed,\nRead returns a partial record along with the parse error.\nThe partial record contains all fields read before the error.\nIf there is no data left to be read, Read returns nil, [io.EOF].\nIf [Reader.ReuseRecord] is true, the returned slice may be shared\nbetween multiple calls to Read.\n" [^{:tag (* Reader)} r] :results [^{:tag (slice string)} record ^error err]
  (if (.-ReuseRecord r) (do
      (set! (values record err) (.readRecord r (.-lastRecord r)))
      (set! (.-lastRecord r) record))

    (set! (values record err) (.readRecord r nil)))

  (return record err))








^{:go/end 219} (go/method FieldPos "FieldPos returns the line and column corresponding to\nthe start of the field with the given index in the slice most recently\nreturned by [Reader.Read]. Numbering of lines and columns starts at 1;\ncolumns are counted in bytes, not runes.\n\nIf this is called with an out-of-bounds index, it panics.\n" [^{:tag (* Reader)} r ^int field] :results [^int line ^int column]
  (when (or (< field 0) (>= field (len (.-fieldPositions r))))
    (panic "out of range index passed to FieldPos"))

  (let [p (addr (aget (.-fieldPositions r) field))]
    (return (.-line p) (.-col p))))





^{:go/end 226} (go/method InputOffset "InputOffset returns the input stream byte offset of the current reader\nposition. The offset gives the location of the end of the most recently\nread row and the beginning of the next row.\n" ^int64 [^{:tag (* Reader)} r]
  (.-offset r))



(go/type position "pos holds the position of a field in the current line.\n" (struct
    ^{:line 230 :tag int} line ^int col))







^{:go/end 249} (go/method ReadAll "ReadAll reads all the remaining records from r.\nEach record is a slice of fields.\nA successful call returns err == nil, not err == [io.EOF]. Because ReadAll is\ndefined to read until EOF, it does not treat end of file as an error to be\nreported.\n" [^{:tag (* Reader)} r] :results [^{:tag (slice (slice string))} records ^error err]
  (while true
    (let [(values record err) (.readRecord r nil)]
      (when (== err io/EOF)
        (return records nil))

      (when (!= err nil)
        (return nil err))

      (set! records (append records record)))))







^{:go/end 281} (go/method readLine "readLine reads the next line (with the trailing endline).\nIf EOF is hit without a trailing endline, it will be omitted.\nIf some bytes were read, then the error is never [io.EOF].\nThe result is only valid until the next call to readLine.\n" [^{:tag (* Reader)} r] :results [(slice byte) error]
  (let [(values line err) (.ReadSlice (.-r r) \newline)]
    (when (== err bufio/ErrBufferFull)
      (set! (.-rawBuffer r) (append (subslice (.-rawBuffer r) _ 0) (spread line)))
      (while (== err bufio/ErrBufferFull)
        (set! (values line err) (.ReadSlice (.-r r) \newline))
        (set! (.-rawBuffer r) (append (.-rawBuffer r) (spread line))))

      (set! line (.-rawBuffer r)))

    (let [readSize (len line)]
      (when (and (> readSize 0) (== err io/EOF))
        (set! err nil)
        ;; For backwards compatibility, drop trailing \r before EOF.
        (when (== (aget line (- readSize 1)) \return)
          (set! line (subslice line _ (- readSize 1)))))


      (inc! (.-numLine r))
      (set! (.-offset r) + (conv int64 readSize))
      ;; Normalize \r\n to \n on all input lines.
      (when [n (len line)] (and (>= n 2) (== (aget line (- n 2)) \return) (== (aget line (- n 1)) \newline))
        (aset line (- n 2) \newline)
        (set! line (subslice line _ (- n 1))))

      (return line err))))



^{:go/breaks [[5 288]] :go/end 289} (go/func lengthNL "lengthNL reports the number of bytes for the trailing \\n.\n" ^int [^{:tag (slice byte)} b]
  (when (and (> (len b) 0) (== (aget b (- (len b) 1)) \newline))
    (return 1))

  0)



^{:go/end 295} (go/func nextRune "nextRune returns the next rune in b or utf8.RuneError.\n" ^rune [^{:tag (slice byte)} b]
  (let [(values r _) (utf8/DecodeRune b)]

(in-ns 'go.encoding.csv) (go/file "writer.go" :imports [


    ^{:line 8} [bufio "bufio"]
    ^{:line 9} [io "io"]
    ^{:line 10} [strings "strings"]
    ^{:line 11} [unicode "unicode"]
    ^{:line 12} [utf8 "unicode/utf8"]])



















(go/type Writer "A Writer writes records using CSV encoding.\n\nAs returned by [NewWriter], a Writer writes records terminated by a\nnewline and uses ',' as the field delimiter. The exported fields can be\nchanged to customize the details before\nthe first call to [Writer.Write] or [Writer.WriteAll].\n\n[Writer.Comma] is the field delimiter.\n\nIf [Writer.UseCRLF] is true,\nthe Writer ends each output line with \\r\\n instead of \\n.\n\nThe writes of individual records are buffered.\nAfter all data has been written, the client should call the\n[Writer.Flush] method to guarantee all data has been forwarded to\nthe underlying [io.Writer].  Any errors that occurred should\nbe checked by calling the [Writer.Error] method.\n" (struct
    ^{:line 33 :tag rune} Comma ; Field delimiter (set to ',' by NewWriter)
    ^{:line 34 :tag bool} UseCRLF ; True to use \r\n as the line terminator
    ^{:line 35 :tag (* bufio/Writer)} w))



^{:go/end 44} (go/func NewWriter "NewWriter returns a new Writer that writes to w.\n" ^{:tag (* Writer)} [^io/Writer w]
  (addr ^{:go/breaks [2 4]} (lit Writer
      :Comma \,
      :w (bufio/NewWriter w))))







^{:go/end 121} (go/method Write "Write writes a single CSV record to w along with any necessary quoting.\nA record is a slice of strings with each string being one field.\nWrites are buffered, so [Writer.Flush] must eventually be called to ensure\nthat the record is written to the underlying [io.Writer].\n" ^error [^{:tag (* Writer)} w ^{:tag (slice string)} record]
  (when (not (validDelim (.-Comma w)))
    (return errInvalidDelim))


  (range [n field record]
    (when (> n 0)
      (when [(values _ err) (.WriteRune (.-w w) (.-Comma w))] (!= err nil)
        (return err)))



    ;; If we don't have to have a quoted field then just
    ;; write out the field and continue to the next field.
    (when (not (.fieldNeedsQuotes w field))
      (when [(values _ err) (.WriteString (.-w w) field)] (!= err nil)
        (return err))

      (continue))


    (when [err (.WriteByte (.-w w) \")] (!= err nil)
      (return err))

    (while (> (len field) 0)
      ;; Search for special characters.
      (let [i (strings/IndexAny field "\"\r\n")]
        (when (< i 0)
          (set! i (len field)))


        ;; Copy verbatim everything before the special character.
        (when [(values _ err) (.WriteString (.-w w) (subslice field _ i))] (!= err nil)
          (return err))

        (set! field (subslice field i))

        ;; Encode the special character.
        (when (> (len field) 0)
          (let [^error err (zero error)]
            (switch (aget field 0)
              (case [\"]
                (set! (values _ err) (.WriteString (.-w w) "\"\"")))
              (case [\return]
                (when (not (.-UseCRLF w))
                  (set! err (.WriteByte (.-w w) \return))))

              (case [\newline]
                (if (.-UseCRLF w)
                  (set! (values _ err) (.WriteString (.-w w) "\r\n"))

                  (set! err (.WriteByte (.-w w) \newline)))))


            (set! field (subslice field 1))
            (when (!= err nil)
              (return err))))))



    (when [err (.WriteByte (.-w w) \")] (!= err nil)
      (return err)))


  (let [^error err (zero error)]
    (if (.-UseCRLF w)
      (set! (values _ err) (.WriteString (.-w w) "\r\n"))

      (set! err (.WriteByte (.-w w) \newline)))

    ^{:line 120} err))




^{:go/end 127} (go/method Flush "Flush writes any buffered data to the underlying [io.Writer].\nTo check if an error occurred during Flush, call [Writer.Error].\n" [^{:tag (* Writer)} w]
  (.Flush (.-w w)))




^{:go/end 134} (go/method Error "Error reports any error that has occurred during\na previous [Writer.Write] or [Writer.Flush].\n" ^error [^{:tag (* Writer)} w]
  (let [(values _ err) (.Write (.-w w) nil)]
    ^{:line 133} err))




^{:go/end 146} (go/method WriteAll "WriteAll writes multiple CSV records to w using [Writer.Write] and\nthen calls [Writer.Flush], returning any error from the Flush.\n" ^error [^{:tag (* Writer)} w ^{:tag (slice (slice string))} records]
  (range [_ record records]
    (let [err (.Write w record)]
      (when (!= err nil)
        (return err))))


  (.Flush (.-w w)))














^{:go/end 184} (go/method fieldNeedsQuotes "fieldNeedsQuotes reports whether our field must be enclosed in quotes.\nFields with a Comma, fields with a quote or newline, and\nfields which start with a space must be enclosed in quotes.\nWe used to quote empty strings, but we do not anymore (as of Go 1.4).\nThe two representations should be equivalent, but Postgres distinguishes\nquoted vs non-quoted empty string during database imports, and it has\nan option to force the quoted behavior for non-quoted CSV but it has\nno option to force the non-quoted behavior for quoted CSV, making\nCSV with quoted empty strings strictly less useful.\nNot quoting the empty string also makes this package match the behavior\nof Microsoft Excel and Google Drive.\nFor Postgres, quote the data terminating string `\\.`.\n" ^bool [^{:tag (* Writer)} w ^string field]
  (when (== field "")
    (return false))


  (when (== field "\\.")
    (return true))


  (if (< (.-Comma w) utf8/RuneSelf)
    (for [i 0] (< i (len field)) (inc! i)
      (let [c (aget field i)]
        (when (or (== c \newline) (== c \return) (== c \") (== c (conv byte (.-Comma w))))
          (return true))))


    (do
      (when (or (strings/ContainsRune field (.-Comma w)) (strings/ContainsAny field "\"\r\n"))
        (return true))))



  (let [(values r1 _) (utf8/DecodeRuneInString field)]
    (unicode/IsSpace r1)))

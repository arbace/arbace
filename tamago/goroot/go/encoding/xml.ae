(ns go.encoding.xml
  (:require [arbace.go :as go]))

(go/package xml
  :path "encoding/xml"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["marshal.go" "read.go" "typeinfo.go" "xml.go"]
  :init-order [begComment endComment endProcInst ddBytes attrType errUnmarshalDepth nameType errRawToken entity first second htmlEntity HTMLEntity htmlAutoClose HTMLAutoClose escQuot escApos escAmp escLT escGT escTab escNL escCR escFFFD cdataStart cdataEnd cdataEscape]
  :positions :lines)

(load "xml/marshal")
(load "xml/read")
(load "xml/typeinfo")
(load "xml/xml")

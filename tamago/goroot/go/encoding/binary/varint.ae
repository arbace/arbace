(in-ns 'go.encoding.binary) (go/file "varint.go" :imports [

    ;; This file implements "varint" encoding of 64-bit integers.
    ;; The encoding is:
    ;; - unsigned integers are serialized 7 bits at a time, starting with the
    ;;   least significant bits
    ;; - the most significant bit (msb) in each output byte indicates if there
    ;;   is a continuation byte (msb = 1)
    ;; - signed integers are mapped to unsigned integers using "zig-zag"
    ;;   encoding: Positive values x are written as 2*x + 0, negative values
    ;;   are written as 2*(^x) + 1; that is, negative numbers are complemented
    ;;   and whether to complement is encoded in bit 0.
    ;;
    ;; Design note:
    ;; At most 10 bytes are needed for 64-bit values. The encoding could
    ;; be more dense: a full 64-bit value needs an extra byte just to hold bit 63.
    ;; Instead, the msb of the previous byte could be used to hold bit 63 since we
    ;; know there can't be more than 64 bits. This is a trivial improvement and
    ;; would reduce the maximum encoding length to 9 bytes. However, it breaks the
    ;; invariant that the msb is always the "continuation bit" and thus makes the
    ;; format incompatible with a varint encoding for larger numbers (say 128-bit).


    ^{:line 28} [errors "errors"]
    ^{:line 29} [io "io"]])



(go/const "MaxVarintLenN is the maximum length of a varint-encoded N-bit integer.\n"
  ^{:line 34} [^{:val 3} MaxVarintLen16 3]
  ^{:line 35} [^{:val 5} MaxVarintLen32 5]
  ^{:line 36} [^{:val 10} MaxVarintLen64 10])




^{:go/end 47} (go/func AppendUvarint "AppendUvarint appends the varint-encoded form of x,\nas generated by [PutUvarint], to buf and returns the extended buffer.\n" ^{:tag (slice byte)} [^{:tag (slice byte)} buf ^uint64 x]
  (while (>= x 0x80)
    (set! buf (append buf (bit-or (conv byte x) 0x80)))
    (set! x >> 7))

  (append buf (conv byte x)))




^{:go/end 60} (go/func PutUvarint "PutUvarint encodes a uint64 into buf and returns the number of bytes written.\nIf the buffer is too small, PutUvarint will panic.\n" ^int [^{:tag (slice byte)} buf ^uint64 x]
  (let [i 0]
    (while (>= x 0x80)
      (aset buf i (bit-or (conv byte x) 0x80))
      (set! x >> 7)
      (inc! i))

    (aset buf i (conv byte x))
    (+ i 1)))








^{:go/end 87} (go/func Uvarint "Uvarint decodes a uint64 from buf and returns that value and the\nnumber of bytes read (> 0). If an error occurred, the value is 0\nand the number of bytes n is <= 0 meaning:\n  - n == 0: buf too small;\n  - n < 0: value larger than 64 bits (overflow) and -n is the number of\n    bytes read.\n" [^{:tag (slice byte)} buf] :results [uint64 int]
  (let [^uint64 x (zero uint64)
      ^{:line 70 :tag uint} s (zero uint)]
    (range [i b buf]
      (when (== i MaxVarintLen64)
        ;; Catch byte reads past MaxVarintLen64.
        ;; See issue https://golang.org/issues/41185
        (return 0 (- (+ i 1)))) ; overflow

      (when (< b 0x80)
        (when (and (== i (- MaxVarintLen64 1)) (> b 1))
          (return 0 (- (+ i 1)))) ; overflow

        (return (bit-or x (<< (conv uint64 b) s)) (+ i 1)))

      (set! x bit-or (<< (conv uint64 (bit-and b 0x7f)) s))
      (set! s + 7))

    (return 0 0)))




^{:go/end 97} (go/func AppendVarint "AppendVarint appends the varint-encoded form of x,\nas generated by [PutVarint], to buf and returns the extended buffer.\n" ^{:tag (slice byte)} [^{:tag (slice byte)} buf ^int64 x]
  (let [ux (<< (conv uint64 x) 1)]
    (when (< x 0)
      (set! ux (bit-not ux)))

    (AppendUvarint buf ux)))




^{:go/end 107} (go/func PutVarint "PutVarint encodes an int64 into buf and returns the number of bytes written.\nIf the buffer is too small, PutVarint will panic.\n" ^int [^{:tag (slice byte)} buf ^int64 x]
  (let [ux (<< (conv uint64 x) 1)]
    (when (< x 0)
      (set! ux (bit-not ux)))

    (PutUvarint buf ux)))








^{:go/end 122} (go/func Varint "Varint decodes an int64 from buf and returns that value and the\nnumber of bytes read (> 0). If an error occurred, the value is 0\nand the number of bytes n is <= 0 with the following meaning:\n  - n == 0: buf too small;\n  - n < 0: value larger than 64 bits (overflow)\n    and -n is the number of bytes read.\n" [^{:tag (slice byte)} buf] :results [int64 int]
  (let [(values ux n) (Uvarint buf) ; ok to continue in presence of error
      ^{:line 117} x (conv int64 (>> ux 1))]
    (when (!= (bit-and ux 1) 0)
      (set! x (bit-not x)))

    (return x n)))


(go/var errOverflow (errors/New "binary: varint overflows a 64-bit integer"))





^{:go/end 151} (go/func ReadUvarint "ReadUvarint reads an encoded unsigned integer from r and returns it as a uint64.\nThe error is [io.EOF] only if no bytes were read.\nIf an [io.EOF] happens after reading some but not all the bytes,\nReadUvarint returns [io.ErrUnexpectedEOF].\n" [^io/ByteReader r] :results [uint64 error]
  (let [^uint64 x (zero uint64)
      ^{:line 132 :tag uint} s (zero uint)]
    (for [i 0] (< i MaxVarintLen64) (inc! i)
      (let [(values b err) (.ReadByte r)]
        (when (!= err nil)
          (when (and (> i 0) (== err io/EOF))
            (set! err io/ErrUnexpectedEOF))

          (return x err))

        (when (< b 0x80)
          (when (and (== i (- MaxVarintLen64 1)) (> b 1))
            (return x errOverflow))

          (return (bit-or x (<< (conv uint64 b) s)) nil))

        (set! x bit-or (<< (conv uint64 (bit-and b 0x7f)) s))
        (set! s + 7)))

    (return x errOverflow)))






^{:go/end 164} (go/func ReadVarint "ReadVarint reads an encoded signed integer from r and returns it as an int64.\nThe error is [io.EOF] only if no bytes were read.\nIf an [io.EOF] happens after reading some but not all the bytes,\nReadVarint returns [io.ErrUnexpectedEOF].\n" [^io/ByteReader r] :results [int64 error]
  (let [(values ux err) (ReadUvarint r) ; ok to continue in presence of error
      ^{:line 159} x (conv int64 (>> ux 1))]
    (when (!= (bit-and ux 1) 0)
      (set! x (bit-not x)))


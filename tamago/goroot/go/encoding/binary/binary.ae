(go/type ByteOrder "A ByteOrder specifies how to convert byte slices into\n16-, 32-, or 64-bit unsigned integers.\n\nIt is implemented by [LittleEndian], [BigEndian], and [NativeEndian].\n" (interface
    (Uint16 ^uint16 [(slice byte)])
    (Uint32 ^uint32 [(slice byte)])
    (Uint64 ^uint64 [(slice byte)])
    (PutUint16 [(slice byte) uint16])
    (PutUint32 [(slice byte) uint32])
    (PutUint64 [(slice byte) uint64])
    (String ^string [])))






(go/type AppendByteOrder "AppendByteOrder specifies how to append 16-, 32-, or 64-bit unsigned integers\ninto a byte slice.\n\nIt is implemented by [LittleEndian], [BigEndian], and [NativeEndian].\n" (interface
    (AppendUint16 ^{:tag (slice byte)} [(slice byte) uint16])
    (AppendUint32 ^{:tag (slice byte)} [(slice byte) uint32])
    (AppendUint64 ^{:tag (slice byte)} [(slice byte) uint64])
    (String ^string [])))




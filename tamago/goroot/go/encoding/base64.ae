(ns go.encoding.base64
  (:require [arbace.go :as go]))

(go/package base64
  :path "encoding/base64"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["base64.go"]
  :init-order [StdEncoding URLEncoding RawStdEncoding RawURLEncoding]
  :positions :lines)

(load "base64/base64")

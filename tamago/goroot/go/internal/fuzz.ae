(ns go.internal.fuzz
  (:require [arbace.go :as go]))

(go/package fuzz
  :path "internal/fuzz"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["counters_unsupported.go" "coverage.go" "encoding.go" "fuzz.go" "mem.go" "minimize.go" "mutator.go" "mutators_byteslice.go" "pcg.go" "queue.go" "sys_unimplemented.go" "trace.go" "worker.go"]
  :init-order [coverageEnabled coverageSnapshot encVersion1 zeroVals debugInfo interesting8 interesting16 interesting32 byteSliceMutators errSharedMemClosed]
  :positions :lines)

(load "fuzz/counters_unsupported")
(load "fuzz/coverage")
(load "fuzz/encoding")
(load "fuzz/fuzz")
(load "fuzz/mem")
(load "fuzz/minimize")
(load "fuzz/mutator")
(load "fuzz/mutators_byteslice")
(load "fuzz/pcg")
(load "fuzz/queue")
(load "fuzz/sys_unimplemented")
(load "fuzz/trace")
(load "fuzz/worker")

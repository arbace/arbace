(ns go.internal.fuzz
  (:require [arbace.go :as go]))

(go/package fuzz
  :path "internal/fuzz"
  :files ["counters_unsupported.go" "coverage.go" "encoding.go" "fuzz.go" "mem.go" "minimize.go" "mutator.go" "mutators_byteslice.go" "pcg.go" "queue.go" "sys_unimplemented.go" "trace.go" "worker.go"]
  :positions :lines)

(load "fuzz/counters_unsupported")
(load "fuzz/coverage")
(load "fuzz/encoding")
(load "fuzz/fuzz")
(load "fuzz/mem")
(load "fuzz/minimize")
(load "fuzz/mutator")
(load "fuzz/mutators_byteslice")
(load "fuzz/pcg")
(load "fuzz/queue")
(load "fuzz/sys_unimplemented")
(load "fuzz/trace")
(load "fuzz/worker")

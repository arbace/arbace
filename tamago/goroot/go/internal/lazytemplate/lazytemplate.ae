;; Package lazytemplate is a thin wrapper over text/template, allowing the use
;; of global template variables without forcing them to be parsed at init.
(in-ns 'go.internal.lazytemplate) (go/file "lazytemplate.go" :doc "Package lazytemplate is a thin wrapper over text/template, allowing the use\nof global template variables without forcing them to be parsed at init.\n" :imports [


    ^{:line 10} [io "io"]
    ^{:line 11} [os "os"]
    ^{:line 12} [strings "strings"]
    ^{:line 13} [sync "sync"]
    ^{:line 14} [template "text/template"]])




(go/type Template "Template is a wrapper around text/template.Template, where the underlying\ntemplate will be parsed the first time it is needed.\n" (struct
    ^{:line 20 :tag string} name ^string text

    ^{:line 22 :tag sync/Once} once
    ^{:line 23 :tag (* template/Template)} tmpl))


^{:go/end 29} (go/method tp ^{:tag (* template/Template)} [^{:tag (* Template)} r]
  (.Do (.-once r) (.-build r))
  (.-tmpl r))


^{:go/end 34} (go/method build [^{:tag (* Template)} r]
  (set! (.-tmpl r) (template/Must (.Parse (template/New (.-name r)) (.-text r))))
  (set! (values (.-name r) (.-text r)) (values "" "")))


^{:go/end 38} (go/method Execute ^error [^{:tag (* Template)} r ^io/Writer w ^any data]
  (.Execute (.tp r) w data))


(go/var inTest (and (> (len os/Args) 0) (strings/HasSuffix (strings/TrimSuffix (aget os/Args 0) ".exe") ".test")))




^{:go/end 52} (go/func New "New creates a new lazy template, delaying the parsing work until it is first\nneeded. If the code is being run as part of tests, the template parsing will\nhappen immediately.\n" ^{:tag (* Template)} [^string name ^string text]
  (let [lt (addr (lit Template :name name :text text))]
    (when inTest
      ;; In tests, always parse the templates early.
      (.tp lt))

    ^{:line 51} lt))

;; This file contains support functions for exportdata.

(in-ns 'go.internal.exportdata) (go/file "support.go" :imports [


    ^{:line 10} [bufio "bufio"]
    ^{:line 11} [io "io"]
    ^{:line 12} [strconv "strconv"]
    ^{:line 13} [strings "strings"]])



^{:go/end 32} (go/func readArchiveHeader "Copy of cmd/internal/archive.ReadHeader.\n" ^int [^{:tag (* bufio/Reader)} b ^string name]
  ;; architecture-independent object file output
  (let [^:const ^{:val 60} HeaderSize 60

      ^{:line 21 :tag (array HeaderSize byte)} buf (zero (array HeaderSize byte))]
    (when [(values _ err) (io/ReadFull b (subslice buf))] (!= err nil)
      (return -1))

    (let [aname (strings/Trim (conv string (subslice buf 0 16)) " ")]
      (when (not (strings/HasPrefix aname name))
        (return -1))

      (let [asize (strings/Trim (conv string (subslice buf 48 58)) " ")
          (values i _) (strconv/Atoi asize)]
        ^{:line 31} i))))

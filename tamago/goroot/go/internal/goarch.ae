(ns go.internal.goarch
  (:require [arbace.go :as go]))

(go/package goarch
  :path "internal/goarch"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["goarch.go" "goarch_amd64.go" "zgoarch_amd64.go"]
  :init-order []
  :positions :lines)

(load "goarch/goarch")
(load "goarch/goarch_amd64")
(load "goarch/zgoarch_amd64")

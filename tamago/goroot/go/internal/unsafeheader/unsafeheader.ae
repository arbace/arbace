;; Package unsafeheader contains header declarations for the Go runtime's slice
;; and string implementations.
;;
;; This package allows packages that cannot import "reflect" to use types that
;; are tested to be equivalent to reflect.SliceHeader and reflect.StringHeader.
(in-ns 'go.internal.unsafeheader) (go/file "unsafeheader.go" :doc "Package unsafeheader contains header declarations for the Go runtime's slice\nand string implementations.\n\nThis package allows packages that cannot import \"reflect\" to use types that\nare tested to be equivalent to reflect.SliceHeader and reflect.StringHeader.\n" :imports [


    ^{:line 13} [unsafe "unsafe"]])








(go/type Slice "Slice is the runtime representation of a slice.\nIt cannot be used safely or portably and its representation may\nchange in a later release.\n\nUnlike reflect.SliceHeader, its Data field is sufficient to guarantee the\ndata it references will not be garbage collected.\n" (struct
    ^{:line 23 :tag unsafe/Pointer} Data
    ^{:line 24 :tag int} Len
    ^{:line 25 :tag int} Cap))








(go/type String "String is the runtime representation of a string.\nIt cannot be used safely or portably and its representation may\nchange in a later release.\n\nUnlike reflect.StringHeader, its Data field is sufficient to guarantee the\ndata it references will not be garbage collected.\n" (struct
    ^{:line 35 :tag unsafe/Pointer} Data
    ^{:line 36 :tag int} Len))

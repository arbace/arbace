;; Package testlog provides a back-channel communication path
;; between tests and package os, so that cmd/go can see which
;; environment variables and files a test consults.
(in-ns 'go.internal.testlog) (go/file "log.go" :doc "Package testlog provides a back-channel communication path\nbetween tests and package os, so that cmd/go can see which\nenvironment variables and files a test consults.\n" :imports [

    ^{:line 10} [atomic "sync/atomic"]])





(go/type Interface "Interface is the interface required of test loggers.\nThe os package will invoke the interface's methods to indicate that\nit is inspecting the given environment variables or files.\nMultiple goroutines may call these methods simultaneously.\n" (interface
    (Getenv [^string key])
    (Stat [^string file])
    (Open [^string file])
    (Chdir [^string dir])))








(go/var ^{:tag (atomic/Pointer Interface) :doc "logger is the current logger Interface.\nWe use an atomic.Pointer in case test startup\nis racing with goroutines started during init.\nThat must not cause a race detector failure,\nalthough it will still result in limited visibility\ninto exactly what those goroutines do.\n"} logger)



^{:go/end 37} (go/func SetLogger "SetLogger sets the test logger implementation for the current process.\nIt must be called only once, at process startup.\n" [^Interface impl]
  (when (not (.CompareAndSwap logger nil (addr impl)))
    (panic "testlog: SetLogger must be called only once")))





^{:go/end 47} (go/func Logger "Logger returns the current test logger implementation.\nIt returns nil if there is no logger.\n" ^Interface []
  (let [impl (.Load logger)]
    (when (== impl nil)
      (return nil))

    ^{:line 46} @impl))



^{:go/end 54} (go/func Getenv "Getenv calls Logger().Getenv, if a logger has been set.\n" [^string name]
  (when [log (Logger)] (!= log nil)
    (.Getenv log name)))




^{:go/end 61} (go/func Open "Open calls Logger().Open, if a logger has been set.\n" [^string name]
  (when [log (Logger)] (!= log nil)
    (.Open log name)))




^{:go/end 68} (go/func Stat "Stat calls Logger().Stat, if a logger has been set.\n" [^string name]
  (when [log (Logger)] (!= log nil)
    (.Stat log name)))

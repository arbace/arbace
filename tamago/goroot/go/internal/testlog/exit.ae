(in-ns 'go.internal.testlog) (go/file "exit.go" :imports [


    ^{:line 8} [sync "sync"]
    ^{:line 9} [_ "unsafe"]]) ; for linkname







^{:go/end 21} (go/func PanicOnExit0 "PanicOnExit0 reports whether to panic on a call to os.Exit(0).\nThis is in the testlog package because, like other definitions in\npackage testlog, it is a hook between the testing package and the\nos package. This is used to ensure that an early call to os.Exit(0)\ndoes not cause a test to pass.\n" ^bool []
  (.Lock (.-mu panicOnExit0))
  (defer (.Unlock (.-mu panicOnExit0)))
  (.-val panicOnExit0))





(go/var ^{:tag (struct ^sync/Mutex mu ^bool val) :doc "panicOnExit0 is the flag used for PanicOnExit0. This uses a lock\nbecause the value can be cleared via a timer call that may race\nwith calls to os.Exit\n"} panicOnExit0)














^{:go/end 45} (go/func ^{:go/linkname "SetPanicOnExit0"} SetPanicOnExit0 "SetPanicOnExit0 sets panicOnExit0 to v.\n\nSetPanicOnExit0 should be an internal detail,\nbut alternate implementations of go test in other\nbuild systems may need to access it using linkname.\n\nDo not remove or change the type signature.\nSee go.dev/issue/67401.\n" [^bool v]
  (.Lock (.-mu panicOnExit0))
  (defer (.Unlock (.-mu panicOnExit0)))
  (set! (.-val panicOnExit0) v))

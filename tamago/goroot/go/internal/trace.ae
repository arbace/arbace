(ns go.internal.trace
  (:require [arbace.go :as go]))

(go/package trace
  :path "internal/trace"
  :files ["base.go" "batch.go" "batchcursor.go" "event.go" "gc.go" "generation.go" "mud.go" "order.go" "reader.go" "resources.go" "summary.go" "tracev1.go" "value.go"]
  :positions :lines)

(load "trace/base")
(load "trace/batch")
(load "trace/batchcursor")
(load "trace/event")
(load "trace/gc")
(load "trace/generation")
(load "trace/mud")
(load "trace/order")
(load "trace/reader")
(load "trace/resources")
(load "trace/summary")
(load "trace/tracev1")
(load "trace/value")

;; This file implements accept for platforms that do not provide a fast path for
;; setting SetNonblock and CloseOnExec.



(in-ns 'go.internal.poll) (go/file "sys_cloexec.go" :build ["//go:build aix || darwin || (js && wasm) || wasip1 || tamago"] :imports [


    ^{:line 13} [syscall "syscall"]])




^{:go/end 36} (go/func accept "Wrapper around the accept system call that marks the returned file\ndescriptor as nonblocking and close-on-exec.\n" [^int s] :results [int syscall/Sockaddr string error]
  ;; See ../syscall/exec_unix.go for description of ForkLock.
  ;; It is probably okay to hold the lock across syscall.Accept
  ;; because we have put fd.sysfd into non-blocking mode.
  ;; However, a call to the File method will put it back into
  ;; blocking mode. We can't take that risk, so no use of ForkLock here.
  (let [(values ns sa err) (AcceptFunc s)]
    (when (== err nil)
      (syscall/CloseOnExec ns))

    (when (!= err nil)
      (return -1 nil "accept" err))

    (when [(set! err (syscall/SetNonblock ns true))] (!= err nil)
      (CloseFunc ns)
      (return -1 nil "setnonblock" err))

    (return ns sa "" nil)))

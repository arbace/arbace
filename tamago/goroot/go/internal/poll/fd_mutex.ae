(go/func ^:extern runtime_Semrelease [^{:tag (* uint32)} sema])



^{:go/breaks [[5 216]] :go/end 217} (go/method incref "incref adds a reference to fd.\nIt returns an error when fd cannot be used.\n" ^error [^{:tag (* FD)} fd]

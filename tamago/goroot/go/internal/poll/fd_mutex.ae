^{:go/end 300} (go/method tryReadWriteLock "tryReadWriteLock tries to add a reference to fd and lock fd for reading and writing.\nIt returns (false, nil) when fd is not available for reading and writing but is not closing.\nIt returns (false, errClosing) when fd is closing.\n" [^{:tag (* FD)} fd] :results [bool error]

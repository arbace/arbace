^{:go/breaks [[6 277]] :go/end 278} (go/method readWriteLock "readWriteLock adds a reference to fd and locks fd for reading and writing.\nIt returns an error when fd cannot be used for reading and writing.\n" ^error [^{:tag (* FD)} fd]

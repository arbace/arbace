^{:go/end 748} (go/func ignoringEINTRIO "ignoringEINTRIO is like ignoringEINTR, but just for IO calls.\n" [^{:tag (func [^int fd ^{:tag (slice byte)} p] [int error])} fn ^int fd ^{:tag (slice byte)} p] :results [int error]
  (while true
    (let [(values n err) (go/call fn fd p)]
      (when (!= err syscall/EINTR)
        (return n err)))))

^{:go/end 73} (go/method Init "Init initializes the FD. The Sysfd field should already be set.\nThis can be called multiple times on a single FD.\nThe net argument is a network name from the net package (e.g., \"tcp\"),\nor \"file\".\nSet pollable to true if fd should be managed by runtime netpoll.\n" ^error [^{:tag (* FD)} fd ^string net ^bool pollable]
  (.init (.-SysFile fd))

  ;; We don't actually care about the various network types.
  (when (== net "file")
    (set! (.-isFile fd) true))

  (when (not pollable)
    (set! (.-isBlocking fd) 1)
    (return nil))

  (let [err (.init (.-pd fd) fd)]
    (when (!= err nil)
      ;; If we could not initialize the runtime poller,
      ;; assume we are using blocking mode.
      (set! (.-isBlocking fd) 1))

    ^{:line 72} err))





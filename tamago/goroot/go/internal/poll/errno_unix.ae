(in-ns 'go.internal.poll) (go/file "errno_unix.go" :build ["//go:build unix || wasip1 || tamago"] :imports [

    ^{:line 9} [syscall "syscall"]])



(go/var "Do the interface allocations only once for common\nErrno values.\n"
  ^{:line 14} [^error errEAGAIN syscall/EAGAIN]
  ^{:line 15} [^error errEINVAL syscall/EINVAL]
  ^{:line 16} [^error errENOENT syscall/ENOENT])




^{:go/end 33} (go/func errnoErr "errnoErr returns common boxed Errno values, to prevent\nallocations at runtime.\n" ^error [^syscall/Errno e]
  (switch e
    (case [0]
      (return nil))
    (case [syscall/EAGAIN]
      (return errEAGAIN))
    (case [syscall/EINVAL]
      (return errEINVAL))
    (case [syscall/ENOENT]
      (return errENOENT)))

  ^{:line 32} e)

(in-ns 'go.internal.poll) (go/file "hook_unix.go" :build ["//go:build unix || (js && wasm) || wasip1 || tamago"] :imports [

    ^{:line 9} [syscall "syscall"]])


(go/var ^{:tag (func [int] [error]) :doc "CloseFunc is used to hook the close call.\n"} CloseFunc syscall/Close)


(go/var ^{:tag (func [int] [int syscall/Sockaddr error]) :doc "AcceptFunc is used to hook the accept call.\n"} AcceptFunc syscall/Accept)

(in-ns 'go.internal.poll) (go/file "fd_posix.go" :build ["//go:build unix || (js && wasm) || wasip1 || windows || tamago"] :imports [


    ^{:line 10} [io "io"]
    ^{:line 11} [syscall "syscall"]])




^{:go/end 21} (go/method eofError "eofError returns io.EOF when fd is available for reading end of\nfile.\n" ^error [^{:tag (* FD)} fd ^int n ^error err]
  (when (and (== n 0) (== err nil) (.-ZeroReadIsEOF fd))
    (return io/EOF))

  ^{:line 20} err)



^{:go/end 30} (go/method Shutdown "Shutdown wraps syscall.Shutdown.\n" ^error [^{:tag (* FD)} fd ^int how]
  (when [err (.incref fd)] (!= err nil)
    (return err))

  (defer (.decref fd))
  (syscall/Shutdown (.-Sysfd fd) how))



^{:go/end 41} (go/method Fchown "Fchown wraps syscall.Fchown.\n" ^error [^{:tag (* FD)} fd ^int uid ^int gid]
  (when [err (.incref fd)] (!= err nil)
    (return err))

  (defer (.decref fd))
  (ignoringEINTR ^{:go/end 40} (fn ^error []
      (syscall/Fchown (.-Sysfd fd) uid gid))))




^{:go/end 52} (go/method Ftruncate "Ftruncate wraps syscall.Ftruncate.\n" ^error [^{:tag (* FD)} fd ^int64 size]
  (when [err (.incref fd)] (!= err nil)
    (return err))

  (defer (.decref fd))
  (ignoringEINTR ^{:go/end 51} (fn ^error []
      (syscall/Ftruncate (.-Sysfd fd) size))))





^{:go/breaks [7] :go/end 63} (go/method RawControl "RawControl invokes the user-defined function f for a non-IO\noperation.\n" ^error [^{:tag (* FD)} fd ^{:tag (func [uintptr])} f]
  (when [err (.incref fd)] (!= err nil)
    (return err))

  (defer (.decref fd))
  (f (conv uintptr (.-Sysfd fd)))
  nil)









^{:go/end 79} (go/func ignoringEINTR "ignoringEINTR makes a function call and repeats it if it returns\nan EINTR error. This appears to be required even though we install all\nsignal handlers with SA_RESTART: see #22838, #38033, #38836, #40846.\nAlso #20400 and #36644 are issues in which a signal handler is\ninstalled without setting SA_RESTART. None of these are the common case,\nbut there are enough of them that it seems that we can't avoid\nan EINTR loop.\n" ^error [^{:tag (func [] [error])} fn]
  (while true
    (let [err (go/call fn)]
      (when (!= err syscall/EINTR)
        (return err)))))





^{:go/end 89} (go/func ignoringEINTR2 "ignoringEINTR2 is ignoringEINTR, but returning an additional value.\n" :type-params [T] [^{:tag (func [] [T error])} fn] :results [T error]
  (while true
    (let [(values v err) (go/call fn)]
      (when (!= err syscall/EINTR)
        (return v err)))))

;; Package poll supports non-blocking I/O on file descriptors with polling.
;; This supports I/O operations that block only a goroutine, not a thread.
;; This is used by the net and os packages.
;; It uses a poller built into the runtime, with support from the
;; runtime scheduler.
(in-ns 'go.internal.poll) (go/file "fd.go" :doc "Package poll supports non-blocking I/O on file descriptors with polling.\nThis supports I/O operations that block only a goroutine, not a thread.\nThis is used by the net and os packages.\nIt uses a poller built into the runtime, with support from the\nruntime scheduler.\n" :imports [


    ^{:line 13} [errors "errors"]])




(go/type errNetClosing "errNetClosing is the type of the variable ErrNetClosing.\nThis is used to implement the net.Error interface.\n" (struct))





^{:go/end 24} (go/method Error "Error returns the error message for ErrNetClosing.\nKeep this string consistent because of issue #4373:\nsince historically programs have not been able to detect\nthis error, they look for the string.\n" ^string [^errNetClosing e] "use of closed network connection")

^{:go/end 26} (go/method Timeout ^bool [^errNetClosing e] false)
^{:go/end 27} (go/method Temporary ^bool [^errNetClosing e] false)



(go/var ^{:doc "ErrNetClosing is returned when a network descriptor is used after\nit has been closed.\n"} ErrNetClosing (lit errNetClosing))



(go/var ^{:doc "ErrFileClosing is returned when a file descriptor is used after it\nhas been closed.\n"} ErrFileClosing (errors/New "use of closed file"))



(go/var ^{:doc "ErrNoDeadline is returned when a request is made to set a deadline\non a file type that does not use the poller.\n"} ErrNoDeadline (errors/New "file type does not support deadline"))


^{:go/end 47} (go/func errClosing "Return the appropriate closing error based on isFile.\n" ^error [^bool isFile]
  (when isFile
    (return ErrFileClosing))

  ^{:line 46} ErrNetClosing)




(go/var ^{:tag error :doc "ErrDeadlineExceeded is returned for an expired deadline.\nThis is exported by the os package as os.ErrDeadlineExceeded.\n"} ErrDeadlineExceeded (addr (lit DeadlineExceededError)))


(go/type DeadlineExceededError "DeadlineExceededError is returned for an expired deadline.\n" (struct))





^{:go/end 60} (go/method Error "Implement the net.Error interface.\nThe string is \"i/o timeout\" because that is what was returned\nby earlier Go versions. Changing it may break programs that\nmatch on error strings.\n" ^string [^{:tag (* DeadlineExceededError)} e] "i/o timeout")
^{:go/end 61} (go/method Timeout ^bool [^{:tag (* DeadlineExceededError)} e] true)
^{:go/end 62} (go/method Temporary ^bool [^{:tag (* DeadlineExceededError)} e] true)



(go/var ^{:doc "ErrNotPollable is returned when the file or socket is not suitable\nfor event notification.\n"} ErrNotPollable (errors/New "not pollable"))


^{:go/end 80} (go/func consume "consume removes data from a slice of byte slices, for writev.\n" [^{:tag (* (slice (slice byte)))} v ^int64 n]
  (while (> (len @v) 0)
    (let [ln0 (conv int64 (len (aget @v 0)))]
      (when (> ln0 n)
        (aset @v 0 (subslice (aget @v 0) n))
        (return))

      (set! n - ln0)
      (aset @v 0 nil)
      (set! @v (subslice @v 1)))))




(go/var ^{:doc "TestHookDidWritev is a hook for testing writev.\n"} TestHookDidWritev ^{:go/end 83} (fn [^int wrote]))










(go/type String "String is an internal string definition for methods/functions\nthat is not intended for use outside the standard libraries.\n\nOther packages in std that import internal/poll and have some\nexported APIs (now we've got some in net.rawConn) which are only used\ninternally and are not intended to be used outside the standard libraries,\nTherefore, we make those APIs use internal types like poll.FD or poll.String\nin their function signatures to disable the usability of these APIs from\nexternal codebase.\n" string)

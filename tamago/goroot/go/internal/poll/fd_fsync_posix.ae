(in-ns 'go.internal.poll) (go/file "fd_fsync_posix.go" :build ["//go:build aix || dragonfly || freebsd || (js && wasm) || linux || netbsd || openbsd || solaris || wasip1 || tamago"] :imports [

    ^{:line 9} [syscall "syscall"]])


^{:go/end 20} (go/method Fsync "Fsync wraps syscall.Fsync.\n" ^error [^{:tag (* FD)} fd]
  (when [err (.incref fd)] (!= err nil)
    (return err))

  (defer (.decref fd))
  (ignoringEINTR ^{:go/end 19} (fn ^error []
      (syscall/Fsync (.-Sysfd fd)))))

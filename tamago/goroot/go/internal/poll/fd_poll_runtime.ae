    ^{:line 33 :tag uintptr} runtimeCtx))


(go/var ^sync/Once serverInit)

^{:go/end 46} (go/method init ^error [^{:tag (* pollDesc)} pd ^{:tag (* FD)} fd]
  (.Do serverInit runtime_pollServerInit)
  ^{:go/breaks [4]} (let [(values ctx errno) (runtime_pollOpen (conv uintptr (.-Sysfd fd)))]
    (when (!= errno 0)
      (return (errnoErr (conv syscall/Errno errno))))

    (set! (.-runtimeCtx pd) ctx)
    nil))


^{:go/end 54} (go/method close [^{:tag (* pollDesc)} pd]
  (when (== (.-runtimeCtx pd) 0)
    (return))

  (runtime_pollClose (.-runtimeCtx pd))
  (set! (.-runtimeCtx pd) 0))



^{:go/end 62} (go/method evict "Evict evicts fd from the pending list, unblocking any I/O running on fd.\n" [^{:tag (* pollDesc)} pd]
  (when (== (.-runtimeCtx pd) 0)
    (return))

  (runtime_pollUnblock (.-runtimeCtx pd)))


^{:go/end 70} (go/method prepare ^error [^{:tag (* pollDesc)} pd ^int mode ^bool isFile]
  (when (== (.-runtimeCtx pd) 0)
    (return nil))

  (let [res (runtime_pollReset (.-runtimeCtx pd) mode)]
    (convertErr res isFile)))


^{:go/end 74} (go/method prepareRead ^error [^{:tag (* pollDesc)} pd ^bool isFile]
  (.prepare pd \r isFile))


^{:go/end 78} (go/method prepareWrite ^error [^{:tag (* pollDesc)} pd ^bool isFile]
  (.prepare pd \w isFile))


^{:go/end 86} (go/method wait ^error [^{:tag (* pollDesc)} pd ^int mode ^bool isFile]
  (when (== (.-runtimeCtx pd) 0)
    (return (errors/New "waiting for unsupported file type")))

  (let [res (runtime_pollWait (.-runtimeCtx pd) mode)]
    (convertErr res isFile)))


^{:go/end 90} (go/method waitRead ^error [^{:tag (* pollDesc)} pd ^bool isFile]
  (.wait pd \r isFile))


^{:go/end 94} (go/method waitWrite ^error [^{:tag (* pollDesc)} pd ^bool isFile]
  (.wait pd \w isFile))


^{:go/end 101} (go/method waitCanceled [^{:tag (* pollDesc)} pd ^int mode]

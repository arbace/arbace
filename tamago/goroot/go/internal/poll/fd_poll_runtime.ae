(go/const "Error values returned by runtime_pollReset and runtime_pollWait.\nThese must match the values in runtime/netpoll.go.\n"
  ^{:line 110} [^{:val 0} pollNoError 0]
  ^{:line 111} [^{:val 1} pollErrClosing 1]
  ^{:line 112} [^{:val 2} pollErrTimeout 2]
  ^{:line 113} [^{:val 3} pollErrNotPollable 3])


^{:go/end 129} (go/func convertErr ^error [^int res ^bool isFile]
  (switch res
    (case [pollNoError]
      (return nil))
    (case [pollErrClosing]
      (return (errClosing isFile)))
    (case [pollErrTimeout]
      (return ErrDeadlineExceeded))
    (case [pollErrNotPollable]
      (return ErrNotPollable)))

  (println "unreachable: " res)
  (panic "unreachable"))



^{:go/end 134} (go/method SetDeadline "SetDeadline sets the read and write deadlines associated with fd.\n" ^error [^{:tag (* FD)} fd ^time/Time t]
  (setDeadlineImpl fd t (+ \r \w)))



^{:go/end 139} (go/method SetReadDeadline "SetReadDeadline sets the read deadline associated with fd.\n" ^error [^{:tag (* FD)} fd ^time/Time t]
  (setDeadlineImpl fd t \r))



^{:go/end 144} (go/method SetWriteDeadline "SetWriteDeadline sets the write deadline associated with fd.\n" ^error [^{:tag (* FD)} fd ^time/Time t]
  (setDeadlineImpl fd t \w))


^{:go/end 164} (go/func setDeadlineImpl ^error [^{:tag (* FD)} fd ^time/Time t ^int mode]
  ^{:go/breaks [7]} (let [^int64 d (zero int64)]
    (when (not (.IsZero t))
      (set! d (conv int64 (time/Until t)))
      (when (== d 0)
        (set! d -1))) ; don't confuse deadline right now with no deadline


    (when [err (.incref fd)] (!= err nil)
      (return err))

    (defer (.decref fd))

    (when (== (.-runtimeCtx (.-pd fd)) 0)
      (return ErrNoDeadline))

    (runtime_pollSetDeadline (.-runtimeCtx (.-pd fd)) d mode)
    nil))














^{:go/end 180} (go/func ^{:go/linkname "IsPollDescriptor"} IsPollDescriptor "IsPollDescriptor reports whether fd is the descriptor being used by the poller.\nThis is only used for testing.\n\nIsPollDescriptor should be an internal detail,\nbut widely used packages access it using linkname.\nNotable members of the hall of shame include:\n  - github.com/opencontainers/runc\n\nDo not remove or change the type signature.\nSee go.dev/issue/67401.\n" ^bool [^uintptr fd]
  (runtime_isPollServerDescriptor fd))

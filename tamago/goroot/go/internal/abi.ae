(ns go.internal.abi
  (:require [arbace.go :as go]))

(go/package abi
  :path "internal/abi"
  :files ["abi.go" "abi_amd64.go" "abi_arm64.go" "bounds.go" "compiletype.go" "escape.go" "funcpc.go" "iface.go" "map.go" "rangefuncconsts.go" "runtime.go" "stack.go" "switch.go" "symtab.go" "type.go"]
  :other-files ["abi_test.s" "stub.s"]
  :positions :lines)

(load "abi/abi")
(load "abi/abi_amd64")
(load "abi/abi_arm64")
(load "abi/bounds")
(load "abi/compiletype")
(load "abi/escape")
(load "abi/funcpc")
(load "abi/iface")
(load "abi/map")
(load "abi/rangefuncconsts")
(load "abi/runtime")
(load "abi/stack")
(load "abi/switch")
(load "abi/symtab")
(load "abi/type")

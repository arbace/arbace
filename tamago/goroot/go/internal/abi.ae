(ns go.internal.abi
  (:require [arbace.go :as go]))

(go/package abi
  :path "internal/abi"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["abi.go" "abi_amd64.go" "bounds.go" "compiletype.go" "escape.go" "funcpc.go" "iface.go" "map.go" "rangefuncconsts.go" "runtime.go" "stack.go" "switch.go" "symtab.go" "type.go"]
  :other-files ["abi_test.s" "stub.s"]
  :init-order [kindNames]
  :positions :lines)

(load "abi/abi")
(load "abi/abi_amd64")
(load "abi/bounds")
(load "abi/compiletype")
(load "abi/escape")
(load "abi/funcpc")
(load "abi/iface")
(load "abi/map")
(load "abi/rangefuncconsts")
(load "abi/runtime")
(load "abi/stack")
(load "abi/switch")
(load "abi/symtab")
(load "abi/type")

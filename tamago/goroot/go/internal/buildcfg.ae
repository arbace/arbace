(ns go.internal.buildcfg
  (:require [arbace.go :as go]))

(go/package buildcfg
  :path "internal/buildcfg"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["cfg.go" "exp.go" "zbootstrap.go"]
  :init-order [GOROOT GOARCH GOOS GO386 GO_LDSO Version GOAMD64 GOARM GOARM64 GOMIPS GOMIPS64 GOPPC64 GORISCV64 GOWASM GOFIPS140 Experiment ToolTags FramePointerEnabled]
  :positions :lines)

(load "buildcfg/cfg")
(load "buildcfg/exp")
(load "buildcfg/zbootstrap")

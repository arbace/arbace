(ns go.internal.testpty
  (:require [arbace.go :as go]))

(go/package testpty
  :path "internal/testpty"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["pty.go" "pty_none.go"]
  :init-order [ErrNotSupported]
  :positions :lines)

(load "testpty/pty")
(load "testpty/pty_none")

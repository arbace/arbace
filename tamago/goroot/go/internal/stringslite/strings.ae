;; Package stringslite implements a subset of strings,
;; only using packages that may be imported by "os".
;;
;; Tests for these functions are in the strings package.
(in-ns 'go.internal.stringslite) (go/file "strings.go" :doc "Package stringslite implements a subset of strings,\nonly using packages that may be imported by \"os\".\n\nTests for these functions are in the strings package.\n" :imports [


    ^{:line 12} [bytealg "internal/bytealg"]
    ^{:line 13} [unsafe "unsafe"]])


^{:go/end 18} (go/func HasPrefix ^bool [^string s ^string prefix]
  (and (>= (len s) (len prefix)) (== (subslice s _ (len prefix)) prefix)))


^{:go/end 22} (go/func HasSuffix ^bool [^string s ^string suffix]
  (and (>= (len s) (len suffix)) (== (subslice s (- (len s) (len suffix))) suffix)))


^{:go/end 26} (go/func IndexByte ^int [^string s ^byte c]
  (bytealg/IndexByteString s c))


^{:go/end 78} (go/func Index ^int [^string s ^string substr]
  (let [n (len substr)]
    (switch
      (case [(or (== n 0) (== substr s))]
        (return 0))
      (case [(== n 1)]
        (return (IndexByte s (aget substr 0))))
      (case [(>= n (len s))]
        (return -1))
      (case [(and (<= n bytealg/MaxLen) (<= (len s) bytealg/MaxBruteForce))]
        ;; Use brute force when s and substr both are small
        (return (bytealg/IndexString s substr))))

    ^{:go/breaks [[3 77]]} (let [c0 (aget substr 0)
        ^{:line 42} c1 (aget substr 1)
        ^{:line 43} i 0
        ^{:line 44} t (+ (- (len s) n) 1)
        ^{:line 45} fails 0]
      (while (< i t)
        (when (!= (aget s i) c0)
          ;; IndexByte is faster than bytealg.IndexString, so use it as long as
          ;; we're not getting lots of false positives.
          (let [o (IndexByte (subslice s (+ i 1) t) c0)]
            (when (< o 0)
              (return -1))

            (set! i + (+ o 1))))

        (when (and (== (aget s (+ i 1)) c1) (== (subslice s i (+ i n)) substr))
          (return i))

        (inc! i)
        (inc! fails)
        (cond (and (<= n bytealg/MaxLen) (> fails (bytealg/Cutover i)))
          ;; Switch to bytealg.IndexString when IndexByte produces too many false positives.
          (let [r (bytealg/IndexString (subslice s i) substr)]
            (when (>= r 0)
              (return (+ r i)))

            (return -1))
          (and (> n bytealg/MaxLen) (>= fails (+ 4 (>> i 4))) (< i t))
          ;; See comment in ../bytes/bytes.go.
          (let [j (^{:inst [string]} bytealg/IndexRabinKarp (subslice s i) substr)]
            (when (< j 0)
              (return -1))

            (return (+ i j)))))


      -1)))


^{:go/end 85} (go/func Cut [^string s ^string sep] :results [^string before ^string after ^bool found]
  (when [i (Index s sep)] (>= i 0)
    (return (subslice s _ i) (subslice s (+ i (len sep))) true))

  (return s "" false))


^{:go/end 92} (go/func CutPrefix [^string s ^string prefix] :results [^string after ^bool found]
  (when (not (HasPrefix s prefix))
    (return s false))

  (return (subslice s (len prefix)) true))


^{:go/end 99} (go/func CutSuffix [^string s ^string suffix] :results [^string before ^bool found]
  (when (not (HasSuffix s suffix))
    (return s false))

  (return (subslice s _ (- (len s) (len suffix))) true))


^{:go/end 106} (go/func TrimPrefix ^string [^string s ^string prefix]
  (when (HasPrefix s prefix)
    (return (subslice s (len prefix))))

  ^{:line 105} s)


^{:go/end 113} (go/func TrimSuffix ^string [^string s ^string suffix]
  (when (HasSuffix s suffix)
    (return (subslice s _ (- (len s) (len suffix)))))

  ^{:line 112} s)


^{:go/end 122} (go/func Clone ^string [^string s]
  (when (== (len s) 0)
    (return ""))

  (let [b (make (slice byte) (len s))]
    (copy b s)
    (unsafe/String (addr (aget b 0)) (len b))))

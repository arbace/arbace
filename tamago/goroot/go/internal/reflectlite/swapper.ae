(in-ns 'go.internal.reflectlite) (go/file "swapper.go" :imports [


    ^{:line 8} [goarch "internal/goarch"]
    ^{:line 9} [unsafeheader "internal/unsafeheader"]
    ^{:line 10} [unsafe "unsafe"]])






^{:go/end 78} (go/func Swapper "Swapper returns a function that swaps the elements in the provided\nslice.\n\nSwapper panics if the provided interface is not a slice.\n" ^{:tag (func [^int i ^int j])} [^any slice]
  (let [v (ValueOf slice)]
    (when (!= (.Kind v) Slice)
      (panic (addr (lit ValueError :Method "Swapper" :Kind (.Kind v)))))

    ;; Fast path for slices of size 0 and 1. Nothing to swap.
    (switch (.Len v)
      (case [0]
        (return ^{:go/end 25} (fn [^int i ^int j] (panic "reflect: slice index out of range"))))
      (case [1]
        (return ^{:go/end 31} (fn [^int i ^int j]
            (when (or (!= i 0) (!= j 0))
              (panic "reflect: slice index out of range"))))))




    (let [typ (.common (.Elem (.Type v)))
        ^{:line 35} size (.Size typ)
        ^{:line 36} hasPtr (.Pointers typ)]

      ;; Some common & small cases, without using memmove:
      (if hasPtr (do
          (when (== size goarch/PtrSize)
            (let [ps @(conv (* (slice unsafe/Pointer)) (.-ptr v))]
              (return ^{:go/end 42} (fn [^int i ^int j] (set! (values (aget ps i) (aget ps j)) (values (aget ps j) (aget ps i)))))))

          (when (== (.Kind typ) String)
            (let [ss @(conv (* (slice string)) (.-ptr v))]
              (return ^{:go/end 46} (fn [^int i ^int j] (set! (values (aget ss i) (aget ss j)) (values (aget ss j) (aget ss i))))))))


        (switch size
          (case [8]
            (let [is @(conv (* (slice int64)) (.-ptr v))]
              (return ^{:go/end 52} (fn [^int i ^int j] (set! (values (aget is i) (aget is j)) (values (aget is j) (aget is i)))))))
          (case [4]
            (let [is @(conv (* (slice int32)) (.-ptr v))]
              (return ^{:go/end 55} (fn [^int i ^int j] (set! (values (aget is i) (aget is j)) (values (aget is j) (aget is i)))))))
          (case [2]
            (let [is @(conv (* (slice int16)) (.-ptr v))]
              (return ^{:go/end 58} (fn [^int i ^int j] (set! (values (aget is i) (aget is j)) (values (aget is j) (aget is i)))))))
          (case [1]
            (let [is @(conv (* (slice int8)) (.-ptr v))]
              (return ^{:go/end 61} (fn [^int i ^int j] (set! (values (aget is i) (aget is j)) (values (aget is j) (aget is i)))))))))



      (let [s (conv (* unsafeheader/Slice) (.-ptr v))
          ^{:line 66} tmp (unsafe_New typ)] ; swap scratch space

        ^{:go/end 77} (fn [^int i ^int j]
          (when (or (>= (conv uint i) (conv uint (.-Len s))) (>= (conv uint j) (conv uint (.-Len s))))
            (panic "reflect: slice index out of range"))

          (let [val1 (arrayAt (.-Data s) i size "i < s.Len")
              ^{:line 73} val2 (arrayAt (.-Data s) j size "j < s.Len")]
            (typedmemmove typ tmp val1)
            (typedmemmove typ val1 val2)
            (typedmemmove typ val2 tmp)))))))

^{:go/end 159} (go/method compactify "compactify attempts to compact sparse into dense.\n\nThis is intended to be called only once after insertions are done.\n" [^{:tag (* (dataTable EI E))} d]
  (when (or (== (.-sparse d) nil) (!= (len (.-dense d)) 0))
    ;; Already compactified.
    (return))

  ;; Find the range of IDs.
  (let [maxID (conv EI 0)
      ^{:line 131} minID (bit-not (conv EI 0))]
    (range [id (.-sparse d)]
      (when (> id maxID)
        (set! maxID id))

      (when (< id minID)
        (set! minID id)))


    (when (>= maxID math/MaxInt)
      ;; We can't create a slice big enough to hold maxID elements
      (return))

    ;; We're willing to waste at most 2x memory.
    (when (> (conv int (- maxID minID)) (max (len (.-sparse d)) (* 2 (len (.-sparse d)))))
      (return))

    (when (> (conv int minID) (len (.-sparse d)))
      (return))

    (let [size (+ (conv int maxID) 1)]
      (set! (.-present d) (make (slice uint8) (/ (+ size 7) 8)))
      (set! (.-dense d) (make (slice E) size))
      (range [id data (.-sparse d)]
        (aset (.-dense d) id data)
        (set! (aget (.-present d) (/ id 8)) bit-or (<< (conv uint8 1) (% id 8))))

      (set! (.-sparse d) nil))))




^{:go/end 177} (go/method get "get returns the E for id or false if it doesn't\nexist. This should be used for validation during parsing.\n" [^{:tag (* (dataTable EI E))} d ^EI id] :results [E bool]

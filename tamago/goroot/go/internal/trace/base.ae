^{:go/end 77} (go/method addExtraString "addExtraString adds an extra string to the evTable and returns\na unique ID for the string in the table.\n" ^extraStringID [^{:tag (* evTable)} t ^string s]
  (when (== s "")
    (return 0))

  (when (== (.-extraStringIDs t) nil)
    (set! (.-extraStringIDs t) (make (map string extraStringID))))

  (when [(values id ok) (aget (.-extraStringIDs t) s)] ok
    (return id))

  (inc! (.-nextExtra t))
  (let [id (.-nextExtra t)]
    (set! (.-extraStrings t) (append (.-extraStrings t) s))
    (aset (.-extraStringIDs t) s id)
    ^{:line 76} id))




^{:go/end 86} (go/method getExtraString "getExtraString returns the extra string for the provided ID.\nThe ID must have been produced by addExtraString for this evTable.\n" ^string [^{:tag (* evTable)} t ^extraStringID id]
  (when (== id 0)
    (return ""))

  (aget (.-extraStrings t) (- id 1)))




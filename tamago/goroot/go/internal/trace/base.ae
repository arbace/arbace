  (cond (< (conv uint64 id) (conv uint64 (len (.-dense d))))
    (when (!= (bit-and (aget (.-present d) (/ id 8)) (<< (conv uint8 1) (% id 8))) 0)
      (return (aget (.-dense d) id) true))

    (!= (.-sparse d) nil)
    (when [(values data ok) (aget (.-sparse d) id)] ok
      (return data true)))


  (return @(new E) false))



^{:go/breaks [[7 197]] :go/end 198} (go/method forEach "forEach iterates over all ID/value pairs in the data table.\n" ^bool [^{:tag (* (dataTable EI E))} d ^{:tag (func [EI E] [bool])} yield]

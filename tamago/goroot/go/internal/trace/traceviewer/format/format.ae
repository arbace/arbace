;; Package traceviewer provides definitions of the JSON data structures
;; used by the Chrome trace viewer.
;;
;; The official description of the format is in this file:
;; https://docs.google.com/document/d/1CvAClvFfyA5R-PhYUmn5OOQtYMH4h6I0nSsKchNAySU/preview
;;
;; Note: This can't be part of the parent traceviewer package as that would
;; throw. go_bootstrap cannot depend on the cgo version of package net in ./make.bash.
(in-ns 'go.internal.trace.traceviewer.format) (go/file "format.go" :doc "Package traceviewer provides definitions of the JSON data structures\nused by the Chrome trace viewer.\n\nThe official description of the format is in this file:\nhttps://docs.google.com/document/d/1CvAClvFfyA5R-PhYUmn5OOQtYMH4h6I0nSsKchNAySU/preview\n\nNote: This can't be part of the parent traceviewer package as that would\nthrow. go_bootstrap cannot depend on the cgo version of package net in ./make.bash.\n" :imports [])

(go/type Data (struct
    ^{:line 16 :tag (slice (* Event)) :go/tag "json:\"traceEvents\""} Events
    ^{:line 17 :tag (map string Frame) :go/tag "json:\"stackFrames\""} Frames
    ^{:line 18 :tag string :go/tag "json:\"displayTimeUnit\""} TimeUnit))


(go/type Event (struct
    ^{:line 22 :tag string :go/tag "json:\"name,omitempty\""} Name
    ^{:line 23 :tag string :go/tag "json:\"ph\""} Phase
    ^{:line 24 :tag string :go/tag "json:\"s,omitempty\""} Scope
    ^{:line 25 :tag float64 :go/tag "json:\"ts\""} Time
    ^{:line 26 :tag float64 :go/tag "json:\"dur,omitempty\""} Dur
    ^{:line 27 :tag uint64 :go/tag "json:\"pid\""} PID
    ^{:line 28 :tag uint64 :go/tag "json:\"tid\""} TID
    ^{:line 29 :tag uint64 :go/tag "json:\"id,omitempty\""} ID
    ^{:line 30 :tag string :go/tag "json:\"bp,omitempty\""} BindPoint
    ^{:line 31 :tag int :go/tag "json:\"sf,omitempty\""} Stack
    ^{:line 32 :tag int :go/tag "json:\"esf,omitempty\""} EndStack
    ^{:line 33 :tag any :go/tag "json:\"args,omitempty\""} Arg
    ^{:line 34 :tag string :go/tag "json:\"cname,omitempty\""} Cname
    ^{:line 35 :tag string :go/tag "json:\"cat,omitempty\""} Category))


(go/type Frame (struct
    ^{:line 39 :tag string :go/tag "json:\"name\""} Name
    ^{:line 40 :tag int :go/tag "json:\"parent,omitempty\""} Parent))


(go/type NameArg (struct
    ^{:line 44 :tag string :go/tag "json:\"name\""} Name))


(go/type BlockedArg (struct
    ^{:line 48 :tag string :go/tag "json:\"blocked\""} Blocked))


(go/type SortIndexArg (struct
    ^{:line 52 :tag int :go/tag "json:\"sort_index\""} Index))


(go/type HeapCountersArg (struct
    ^{:line 56 :tag uint64} Allocated
    ^{:line 57 :tag uint64} NextGC))


(go/const
  ^{:line 61} [^{:val 0} ProcsSection 0] ; where Goroutines or per-P timelines are presented.
  ^{:line 62} [^{:val 1} StatsSection 1] ; where counters are presented.
  ^{:line 63} [^{:val 2} TasksSection 2]) ; where Task hierarchy & timeline is presented.


(go/type GoroutineCountersArg (struct
    ^{:line 67 :tag uint64} Running
    ^{:line 68 :tag uint64} Runnable
    ^{:line 69 :tag uint64} GCWaiting))


(go/type ThreadCountersArg (struct
    ^{:line 73 :tag int64} Running
    ^{:line 74 :tag int64} InSyscall))


(go/type SchedCtxArg (struct
    ^{:line 78 :tag uint64 :go/tag "json:\"thread,omitempty\""} ThreadID
    ^{:line 79 :tag uint64 :go/tag "json:\"proc,omitempty\""} ProcID))

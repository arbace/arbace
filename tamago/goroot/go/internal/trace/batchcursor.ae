(go/type batchCursor (struct
    ^{:line 16 :tag ThreadID} m
    ^{:line 17 :tag Time} lastTs
    ^{:line 18 :tag int} idx ; next index into []batch
    ^{:line 19 :tag int} dataOff ; next index into batch.data

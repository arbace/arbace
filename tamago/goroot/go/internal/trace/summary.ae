^{:go/end 692} (go/func RelatedGoroutinesV2 "RelatedGoroutinesV2 finds a set of goroutines related to goroutine goid for v2 traces.\nThe association is based on whether they have synchronized with each other in the Go\nscheduler (one has unblocked another).\n" ^{:tag (map GoID (struct))} [^{:tag (slice Event)} events ^GoID goid]
  ;; Process all the events, looking for transitions of goroutines
  ;; out of GoWaiting. If there was an active goroutine when this
  ;; happened, then we know that active goroutine unblocked another.
  ;; Scribble all these down so we can process them.
  (let-type [unblockEdge (struct
        ^{:line 649 :tag GoID} operator
        ^{:line 650 :tag GoID} operand)]

    (let [^{:tag (slice unblockEdge)} unblockEdges (zero (slice unblockEdge))]
      (range [_ ev events]
        (when (== (.Goroutine ev) NoGoroutine)
          (continue))

        (when (!= (.Kind ev) EventStateTransition)
          (continue))

        (let [st (.StateTransition ev)]
          (when (!= (.-Kind (.-Resource st)) ResourceGoroutine)
            (continue))

          (let [id (.Goroutine (.-Resource st))
              (values old new) (.Goroutine st)]
            (when (or (== old new) (!= old GoWaiting))
              (continue))

            (set! unblockEdges (append unblockEdges ^{:go/breaks [2 4]} (lit unblockEdge
                  :operator (.Goroutine ev)
                  :operand id))))))


      ;; Compute the transitive closure of depth 2 of goroutines that have unblocked each other
      ;; (starting from goid).
      (let [gmap (make (map GoID (struct)))]
        (aset gmap goid (lit (struct)))
        (for [i 0] (< i 2) (inc! i)
          ;; Copy the map.
          (let [gmap1 (make (map GoID (struct)))]
            (range [g gmap]
              (aset gmap1 g (lit (struct))))

            (range [_ edge unblockEdges]
              (when [(values _ ok) (aget gmap (.-operand edge))] ok
                (aset gmap1 (.-operator edge) (lit (struct)))))


            (set! gmap gmap1)))

        ^{:line 691} gmap))))


^{:go/end 699} (go/func IsSystemGoroutine ^bool [^string entryFn]
  ;; This mimics runtime.isSystemGoroutine as closely as
  ;; possible.
  ;; Also, locked g in extra M (with empty entryFn) is system goroutine.
  (or (== entryFn "") (and (!= entryFn "runtime.main") (strings/HasPrefix entryFn "runtime."))))

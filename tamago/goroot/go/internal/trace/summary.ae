    (set! (.-ExecTime ret) + (.Sub lastTs ^{:go/via [goroutineSummary]} (.-lastStartTime g))))

  (when (!= ^{:go/via [goroutineSummary]} (.-lastRunnableTime g) 0)
    (set! (.-SchedWaitTime ret) + (.Sub lastTs ^{:go/via [goroutineSummary]} (.-lastRunnableTime g))))


          ;; doesn't exist (it's just been mentioned now).
          ^{:line 596} task (.getOrAddTask s (.-Task log))]
        (aset (.-Goroutines task) (.Goroutine ev) (aget (.-gs s) (.Goroutine ev)))
        (set! (.-Logs task) (append (.-Logs task) ev))))))



^{:go/end 609} (go/method getOrAddTask ^{:tag (* UserTaskSummary)} [^{:tag (* Summarizer)} s ^TaskID id]
  (let [task (aget (.-tasks s) id)]
    (when (== task nil)
      (set! task (addr (lit UserTaskSummary :ID id :Goroutines (make (map GoID (* GoroutineSummary))))))
      (aset (.-tasks s) id task))

    ^{:line 608} task))




^{:go/end 638} (go/method Finalize "Finalize indicates to the summarizer that we're done processing the trace.\nIt cleans up any remaining state and returns the full summary.\n" ^{:tag (* Summary)} [^{:tag (* Summarizer)} s]
  (range [_ g (.-gs s)]
    (.finalize g (.-lastTs s) nil)

    ;; Sort based on region start time.
    (^{:inst [(slice (* UserRegionSummary)) (* UserRegionSummary)]} slices/SortFunc (.-Regions g) ^{:go/end 631} (fn ^int [^{:tag (* UserRegionSummary)} a ^{:tag (* UserRegionSummary)} b]
        (let [x (.-Start a)
            ^{:line 620} y (.-Start b)]
          (when (== x nil)
            (when (== y nil)
              (return 0))

            (return -1))

          (when (== y nil)
            (return (+ 1)))

          (^{:inst [Time]} cmp/Compare (.Time x) (.Time y)))))

    (set! (.-goroutineSummary g) nil))

  (addr ^{:go/breaks [2 4]} (lit Summary
      :Goroutines (.-gs s)

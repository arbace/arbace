        ;; We need to avoid doing it twice, otherwise we could appear twice
        ;; in the parent's Children list.
        (when (and (!= (.-Parent t) NoTask) (== (.-Parent task) nil))
          (let [parent (.getOrAddTask s (.-Parent t))]

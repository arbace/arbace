        (set! (.-Regions g) (append (.-Regions g) sd))))

    ;; Handle tasks and logs.
    (case [EventTaskBegin EventTaskEnd]
      ;; Initialize the task.
      (let [t (.Task ev)
          ^{:line 576} task (.getOrAddTask s (.-ID t))]
        (set! (.-Name task) (.-Type t))
        (aset (.-Goroutines task) (.Goroutine ev) (aget (.-gs s) (.Goroutine ev)))

(in-ns 'go.internal.trace.raw) (go/file "textwriter.go" :imports [


    ^{:line 8} [fmt "fmt"]
    ^{:line 9} [io "io"]

    ^{:line 11} [version "internal/trace/version"]])



(go/type TextWriter "TextWriter emits the text format of a trace.\n" (struct
    ^{:line 16 :tag io/Writer} w
    ^{:line 17 :tag version/Version} v))



^{:go/end 27} (go/func NewTextWriter "NewTextWriter creates a new write for the trace text format.\n" [^io/Writer w ^version/Version v] :results [(* TextWriter) error]
  (let [(values _ err) (fmt/Fprintf w "Trace Go1.%d\n" v)]
    (when (!= err nil)
      (return nil err))

    (return (addr (lit TextWriter :w w :v v)) nil)))



^{:go/end 39} (go/method WriteEvent "WriteEvent writes a single event to the stream.\n" ^error [^{:tag (* TextWriter)} w ^Event e]
  ;; Check version.
  (when (!= (.-Version e) (.-v w))
    (return (fmt/Errorf "mismatched version between writer (go 1.%d) and event (go 1.%d)" (.-v w) (.-Version e))))


  ;; Write event.
  (let [(values _ err) (fmt/Fprintln (.-w w) (.String e))]
    ^{:line 38} err))

(in-ns 'go.internal.trace.raw) (go/file "event.go" :imports [


    ^{:line 8} [binary "encoding/binary"]
    ^{:line 9} [strconv "strconv"]
    ^{:line 10} [strings "strings"]

    ^{:line 12} [tracev2 "internal/trace/tracev2"]
    ^{:line 13} [version "internal/trace/version"]])







(go/type Event "Event is a simple representation of a trace event.\n\nNote that this typically includes much more than just\ntimestamped events, and it also represents parts of the\ntrace format's framing. (But not interpreted.)\n" (struct
    ^{:line 22 :tag version/Version} Version
    ^{:line 23 :tag tracev2/EventType} Ev
    ^{:line 24 :tag (slice uint64)} Args
    ^{:line 25 :tag (slice byte)} Data))






^{:go/end 61} (go/method String "String returns the canonical string representation of the event.\n\nThis format is the same format that is parsed by the TextReader\nand emitted by the TextWriter.\n" ^string [^{:tag (* Event)} e]
  (let [spec (aget (.Specs (.-Version e)) (.-Ev e))

      ^{:line 35 :tag strings/Builder} s (zero strings/Builder)]
    (.WriteString s (.-Name spec))
    (range [i (.-Args spec)]
      (.WriteString s " ")
      (.WriteString s (aget (.-Args spec) i))
      (.WriteString s "=")
      (.WriteString s (strconv/FormatUint (aget (.-Args e) i) 10)))

    (when (.-IsStack spec)
      (let [frames (subslice (.-Args e) (len (.-Args spec)))]
        (for [i 0] (< i (len frames)) (inc! i)
          (if (== (% i 4) 0)
            (.WriteString s "\n\t")

            (.WriteString s " "))

          (.WriteString s (aget frameFields (% i 4)))
          (.WriteString s "=")
          (.WriteString s (strconv/FormatUint (aget frames i) 10)))))


    (when (!= (.-Data e) nil)
      (.WriteString s "\n\tdata=")
      (.WriteString s (strconv/Quote (conv string (.-Data e)))))

    (.String s)))



^{:go/end 76} (go/method EncodedSize "EncodedSize returns the canonical encoded size of an event.\n" ^int [^{:tag (* Event)} e]
  (let [size 1
      ^{:line 66 :tag (array binary/MaxVarintLen64 byte)} buf (zero (array binary/MaxVarintLen64 byte))]
    (range [_ arg (.-Args e)]
      (set! size + (binary/PutUvarint (subslice buf) arg)))

    (let [spec (aget (.Specs (.-Version e)) (.-Ev e))]
      (when (.-HasData spec)
        (set! size + (binary/PutUvarint (subslice buf) (conv uint64 (len (.-Data e)))))
        (set! size + (len (.-Data e))))

      ^{:line 75} size)))

(go/const "Event types in the trace, args are given in square brackets.\n\nNaming scheme:\n  - Time range event pairs have suffixes \"Begin\" and \"End\".\n  - \"Start\", \"Stop\", \"Create\", \"Destroy\", \"Block\", \"Unblock\"\n    are suffixes reserved for scheduling resources.\n\nNOTE: If you add an event type, make sure you also update all\ntables in this file!\n"
  ^{:line 17} [^{:tag EventType :val 0} EvNone iota] ; unused


  ^{:line 20} [^{:val 1 :doc "Structural events.\n"} EvEventBatch] ; start of per-M batch of events [generation, M ID, timestamp, batch length]
  ^{:line 21} [^{:val 2} EvStacks] ; start of a section of the stack table [...EvStack]
  ^{:line 22} [^{:val 3} EvStack] ; stack table entry [ID, ...{PC, func string ID, file string ID, line #}]
  ^{:line 23} [^{:val 4} EvStrings] ; start of a section of the string dictionary [...EvString]
  ^{:line 24} [^{:val 5} EvString] ; string dictionary entry [ID, length, string]
  ^{:line 25} [^{:val 6} EvCPUSamples] ; start of a section of CPU samples [...EvCPUSample]
  ^{:line 26} [^{:val 7} EvCPUSample] ; CPU profiling sample [timestamp, M ID, P ID, goroutine ID, stack ID]
  ^{:line 27} [^{:val 8} EvFrequency] ; timestamp units per sec [freq]


  ^{:line 30} [^{:val 9 :doc "Procs.\n"} EvProcsChange] ; current value of GOMAXPROCS [timestamp, GOMAXPROCS, stack ID]
  ^{:line 31} [^{:val 10} EvProcStart] ; start of P [timestamp, P ID, P seq]
  ^{:line 32} [^{:val 11} EvProcStop] ; stop of P [timestamp]
  ^{:line 33} [^{:val 12} EvProcSteal] ; P was stolen [timestamp, P ID, P seq, M ID]
  ^{:line 34} [^{:val 13} EvProcStatus] ; P status at the start of a generation [timestamp, P ID, status]


  ^{:line 37} [^{:val 14 :doc "Goroutines.\n"} EvGoCreate] ; goroutine creation [timestamp, new goroutine ID, new stack ID, stack ID]
  ^{:line 38} [^{:val 15} EvGoCreateSyscall] ; goroutine appears in syscall (cgo callback) [timestamp, new goroutine ID]
  ^{:line 39} [^{:val 16} EvGoStart] ; goroutine starts running [timestamp, goroutine ID, goroutine seq]
  ^{:line 40} [^{:val 17} EvGoDestroy] ; goroutine ends [timestamp]

  ^{:line 48} [^{:val 25} EvGoStatus] ; goroutine status at the start of a generation [timestamp, goroutine ID, M ID, status]


  ^{:line 51} [^{:val 26 :doc "STW.\n"} EvSTWBegin] ; STW start [timestamp, kind, stack ID]
  ^{:line 52} [^{:val 27} EvSTWEnd] ; STW done [timestamp]


  ^{:line 55} [^{:val 28 :doc "GC events.\n"} EvGCActive] ; GC active [timestamp, seq]

(go/type GoStatus "GoStatus is the status of a goroutine.\n\nThey correspond directly to the various goroutine states.\n" uint8)

(go/const
  ^{:line 506} [^{:tag GoStatus :val 0} GoBad iota]
  ^{:line 507} [^{:val 1} GoRunnable]
  ^{:line 508} [^{:val 2} GoRunning]
  ^{:line 509} [^{:val 3} GoSyscall]
  ^{:line 510} [^{:val 4} GoWaiting])


^{:go/breaks [[4 524]] :go/end 525} (go/method String ^string [^GoStatus s]
  (switch s
    (case [GoRunnable]
      (return "Runnable"))
    (case [GoRunning]
      (return "Running"))
    (case [GoSyscall]
      (return "Syscall"))
    (case [GoWaiting]
      (return "Waiting")))

  "Bad")





(go/type ProcStatus "ProcStatus is the status of a P.\n\nThey mostly correspond to the various P states.\n" uint8)

(go/const
  ^{:line 533} [^{:tag ProcStatus :val 0} ProcBad iota]
  ^{:line 534} [^{:val 1} ProcRunning]
  ^{:line 535} [^{:val 2} ProcIdle]
  ^{:line 536} [^{:val 3} ProcSyscall]










  ^{:line 547} [^{:val 4 :doc "ProcSyscallAbandoned is a special case of\nProcSyscall. It's used in the very specific case\nwhere the first a P is mentioned in a generation is\npart of a ProcSteal event. If that's the first time\nit's mentioned, then there's no GoSyscallBegin to\nconnect the P stealing back to at that point. This\nspecial state indicates this to the parser, so it\ndoesn't try to find a GoSyscallEndBlocked that\ncorresponds with the ProcSteal.\n"} ProcSyscallAbandoned])


^{:go/breaks [[4 561]] :go/end 562} (go/method String ^string [^ProcStatus s]
  (switch s
    (case [ProcRunning]
      (return "Running"))
    (case [ProcIdle]
      (return "Idle"))
    (case [ProcSyscall]
      (return "Syscall"))
    (case [ProcSyscallAbandoned]
      (return "SyscallAbandoned")))

  "Bad")


(go/const





  ^{:line 570} [^{:val 65536 :doc "MaxBatchSize sets the maximum size that a batch can be.\n\nDirectly controls the trace batch size in the runtime.\n\nNOTE: If this number decreases, the trace format version must change.\n"} MaxBatchSize (<< 64 10)]










  ^{:line 581} [^{:val 128 :doc "Maximum number of PCs in a single stack trace.\n\nSince events contain only stack ID rather than whole stack trace,\nwe can allow quite large values here.\n\nDirectly controls the maximum number of frames per stack\nin the runtime.\n\nNOTE: If this number decreases, the trace format version must change.\n"} MaxFramesPerStack 128]








  ^{:line 590} [^{:val 1024 :doc "MaxEventTrailerDataSize controls the amount of trailer data that\nan event can have in bytes. Must be smaller than MaxBatchSize.\nControls the maximum string size in the trace.\n\nDirectly controls the maximum such value in the runtime.\n\nNOTE: If this number decreases, the trace format version must change.\n"} MaxEventTrailerDataSize (<< 1 10)])

    ^{:line 8} [bufio "bufio"]
    ^{:line 9} [errors "errors"]
    ^{:line 10} [fmt "fmt"]
    ^{:line 11} [io "io"]
    ^{:line 12} [slices "slices"]
    ^{:line 13} [strings "strings"]


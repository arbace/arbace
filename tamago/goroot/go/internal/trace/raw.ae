(ns go.internal.trace.raw
  (:require [arbace.go :as go]))

(go/package raw
  :path "internal/trace/raw"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["doc.go" "event.go" "reader.go" "textreader.go" "textwriter.go" "writer.go"]
  :init-order [frameFields]
  :positions :lines)

(load "raw/doc")
(load "raw/event")
(load "raw/reader")
(load "raw/textreader")
(load "raw/textwriter")
(load "raw/writer")

(ns go.internal.trace.raw
  (:require [arbace.go :as go]))

(go/package raw
  :path "internal/trace/raw"
  :files ["doc.go" "event.go" "reader.go" "textreader.go" "textwriter.go" "writer.go"]
  :positions :lines)

(load "raw/doc")
(load "raw/event")
(load "raw/reader")
(load "raw/textreader")
(load "raw/textwriter")
(load "raw/writer")

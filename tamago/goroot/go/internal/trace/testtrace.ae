(go/package testtrace
  :path "internal/trace/testtrace"
  :files ["expectation.go" "format.go" "helpers.go" "platforms.go" "validation.go"]
  :positions :lines)

(load "testtrace/expectation")
(load "testtrace/format")
(load "testtrace/helpers")
(load "testtrace/platforms")
(load "testtrace/validation")

(go/type Version "Version represents the version of a trace file.\n" uint32)

(go/const
  ^{:line 18} [^{:tag Version :val 11} Go111 11] ; v1
  ^{:line 19} [^{:tag Version :val 19} Go119 19] ; v1
  ^{:line 20} [^{:tag Version :val 21} Go121 21] ; v1
  ^{:line 21} [^{:tag Version :val 22} Go122 22] ; v2
  ^{:line 22} [^{:tag Version :val 23} Go123 23] ; v2
  ^{:line 23} [^{:tag Version :val 25} Go125 25] ; v2
  ^{:line 24} [^{:tag Version :val 26} Go126 26] ; v2
  ^{:line 25} [^{:val 26} Current Go126])


(go/var versions (lit (map Version (slice tracev2/EventSpec))
    ;; Go 1.11–1.21 use a different parser and are only set here for the sake of
    ;; Version.Valid.
    ^{:line 31} [Go111 nil]
    ^{:line 32} [Go119 nil]
    ^{:line 33} [Go121 nil]

    ^{:line 35} [Go122 (subslice (tracev2/Specs) _ (+ tracev2/EvUserLog 1))] ; All events after are Go 1.23+.
    ^{:line 36} [Go123 (subslice (tracev2/Specs) _ (+ tracev2/EvExperimentalBatch 1))] ; All events after are Go 1.25+.
    ^{:line 37} [Go125 (subslice (tracev2/Specs) _ (+ tracev2/EvClockSnapshot 1))] ; All events after are Go 1.26+.
    ^{:line 38} [Go126 (tracev2/Specs)]))



^{:go/end 44} (go/method Specs "Specs returns the set of event.Specs for this version.\n" ^{:tag (slice tracev2/EventSpec)} [^Version v]
  (aget versions v))




^{:go/end 60} (go/method EventName "EventName returns a string name of a wire format event\nfor a particular trace version.\n" ^string [^Version v ^tracev2/EventType typ]
  (when (not (.Valid v))
    (return "<invalid trace version>"))

  (let [s (.Specs v)]
    (when (== (len s) 0)
      (return "<v1 trace event type>"))

    (when (and (< (conv int typ) (len s)) (!= (.-Name (aget s typ)) ""))
      (return (.-Name (aget s typ))))

    (fmt/Sprintf "Invalid(%d)" typ)))


^{:go/end 65} (go/method Valid ^bool [^Version v]
  (let [(values _ ok) (aget versions v)]
    ^{:line 64} ok))



(go/const ^{:val "go 1.%d trace\u0000\u0000\u0000" :doc "headerFmt is the format of the header of all Go execution traces.\n"} headerFmt "go 1.%d trace\u0000\u0000\u0000")



^{:go/end 82} (go/func ReadHeader "ReadHeader reads the version of the trace out of the trace file's\nheader, whose prefix must be present in v.\n" [^io/Reader r] :results [Version error]
  (let [^Version v (zero Version)
      (values _ err) (fmt/Fscanf r headerFmt (addr v))]
    (when (!= err nil)
      (return v (fmt/Errorf "bad file format: not a Go execution trace?")))

    (when (not (.Valid v))
      (return v (fmt/Errorf "unknown or unsupported trace version go 1.%d" v)))

    (return v nil)))



^{:go/end 87} (go/func WriteHeader "WriteHeader writes a header for a trace version v to w.\n" [^io/Writer w ^Version v] :results [int error]
  (fmt/Fprintf w headerFmt v))

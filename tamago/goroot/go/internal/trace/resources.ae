^{:go/end 261} (go/method Goroutine "Goroutine returns the state transition for a goroutine.\n\nTransitions to and from states that are Executing are special in that\nthey change the future execution context. In other words, future events\non the same thread will feature the same goroutine until it stops running.\n\nPanics if d.Resource.Kind is not ResourceGoroutine.\n" [^StateTransition d] :results [^GoState from ^GoState to]
  (when (!= (.-Kind (.-Resource d)) ResourceGoroutine)
    (panic "Goroutine called on non-Goroutine state transition"))

  (return (conv GoState (.-oldState d)) (conv GoState (.-newState d))))









^{:go/end 275} (go/method Proc "Proc returns the state transition for a proc.\n\nTransitions to and from states that are Executing are special in that\nthey change the future execution context. In other words, future events\non the same thread will feature the same goroutine until it stops running.\n\nPanics if d.Resource.Kind is not ResourceProc.\n" [^StateTransition d] :results [^ProcState from ^ProcState to]
  (when (!= (.-Kind (.-Resource d)) ResourceProc)
    (panic "Proc called on non-Proc state transition"))

  (return (conv ProcState (.-oldState d)) (conv ProcState (.-newState d))))

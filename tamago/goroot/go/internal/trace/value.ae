(in-ns 'go.internal.trace) (go/file "value.go" :imports [


    ^{:line 8} [fmt "fmt"]
    ^{:line 9} [unsafe "unsafe"]])



(go/type Value "Value is a dynamically-typed value obtained from a trace.\n" (struct
    ^{:line 14 :tag ValueKind} kind
    ^{:line 15 :tag unsafe/Pointer} pointer
    ^{:line 16 :tag uint64} scalar))



(go/type ValueKind "ValueKind is the type of a dynamically-typed value from a trace.\n" uint8)

(go/const
  ^{:line 23} [^{:tag ValueKind :val 0} ValueBad iota]
  ^{:line 24} [^{:val 1} ValueUint64]
  ^{:line 25} [^{:val 2} ValueString])








^{:go/end 36} (go/method Kind "Kind returns the ValueKind of the value.\n\nIt represents the underlying structure of the value.\n\nNew ValueKinds may be added in the future. Users of this type must be robust\nto that possibility.\n" ^ValueKind [^Value v]
  (.-kind v))





^{:go/end 46} (go/method Uint64 "Uint64 returns the uint64 value for a ValueUint64.\n\nPanics if this Value's Kind is not ValueUint64.\n" ^uint64 [^Value v]
  (when (!= (.-kind v) ValueUint64)
    (panic "Uint64 called on Value of a different Kind"))

  (.-scalar v))




^{:go/breaks [[6 58]] :go/end 59} (go/method String "String returns the string value for a ValueString, and otherwise\na string representation of the value for other kinds of values.\n" ^string [^Value v]
  (when (== (.-kind v) ValueString)
    (return (unsafe/String (conv (* byte) (.-pointer v)) (conv int (.-scalar v)))))

  (switch (.-kind v)
    (case [ValueUint64]
      (return (fmt/Sprintf "Value{Uint64(%d)}" (.Uint64 v)))))

  "Value{Bad}")



^{:go/end 64} (go/func Uint64Value "Uint64Value creates a value of kind ValueUint64.\n" ^Value [^uint64 x]
  (lit Value :kind ValueUint64 :scalar x))



^{:go/end 69} (go/func StringValue "StringValue creates a value of kind ValueString.\n" ^Value [^string s]
  (lit Value :kind ValueString :scalar (conv uint64 (len s)) :pointer (conv unsafe/Pointer (unsafe/StringData s))))

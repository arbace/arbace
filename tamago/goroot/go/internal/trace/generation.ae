    (when (!= spill nil)
      ;; Process the spilled batch, which contains real data.
      (set! (.-gen g) (.-gen spill))
      (set! (.-minTs g) (.-time (.-batch spill)))
      (when [err (processBatch g @(.-batch spill) ver)] (!= err nil)
        (return nil nil err))

      (set! spill nil))

    ;; Read batches one at a time until we either hit the next generation.
    (let [^error spillErr (zero error)]
      (while true
        (let [(values b gen err) (readBatch r)]
          (when (== err io/EOF)
            (break))

          (when (!= err nil)

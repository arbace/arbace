^{:go/breaks [[5 260]] :go/end 261} (go/func processBatch "processBatch adds the batch to the generation.\n" ^error [^{:tag (* generation)} g ^batch b ^version/Version ver]
  (switch
    (case [(.isStringsBatch b)]
      (when [err (addStrings (addr ^{:go/via [evTable]} (.-strings g)) b)] (!= err nil)
        (return err)))

    (case [(.isStacksBatch b)]
      (when [err (addStacks (addr ^{:go/via [evTable]} (.-stacks g)) ^{:go/via [evTable]} (.-pcs g) b)] (!= err nil)
        (return err)))

    (case [(.isCPUSamplesBatch b)]
      (let [(values samples err) (addCPUSamples (.-cpuSamples g) b)]
        (when (!= err nil)
          (return err))

        (set! (.-cpuSamples g) samples)))
    (case [(.isSyncBatch b ver)]
      (when [err (setSyncBatch (addr ^{:go/via [evTable]} (.-sync g)) b ver)] (!= err nil)
        (return err)))

    (case [(!= (.-exp b) tracev2/NoExperiment)]
      (when (== ^{:go/via [evTable]} (.-expBatches g) nil)
        (set! ^{:go/via [evTable]} (.-expBatches g) (make (map tracev2/Experiment (slice ExperimentalBatch)))))

      (when [err (addExperimentalBatch ^{:go/via [evTable]} (.-expBatches g) b)] (!= err nil)
        (return err)))

    (case [(.isEndOfGeneration b)]
      (return (errors/New "internal error: unexpectedly processing EndOfGeneration; broken trace?")))
    (default
      (when [(values _ ok) (aget (.-batches g) (.-m b))] (not ok)
        (set! (.-batchMs g) (append (.-batchMs g) (.-m b))))

      (aset (.-batches g) (.-m b) (append (aget (.-batches g) (.-m b)) b))))

  nil)




^{:go/end 292} (go/func validateStackStrings "validateStackStrings makes sure all the string references in\nthe stack table are present in the string table.\n" ^error [

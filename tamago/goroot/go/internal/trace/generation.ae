              (return false))

            (set! (values _ ok) (.get strings (.-funcID frame)))
            (when (not ok)
              (set! err (fmt/Errorf "found invalid func string ID %d for stack %d" (.-funcID frame) id))
              (return false))

            (set! (values _ ok) (.get strings (.-fileID frame)))

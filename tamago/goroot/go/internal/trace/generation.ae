  (let [g (addr ^{:go/breaks [2 [4 136]]} (lit generation
          :evTable (addr ^{:go/breaks [2]} (lit evTable
              :pcs (make (map uint64 frame))))

          :batches (make (map ThreadID (slice batch)))))]


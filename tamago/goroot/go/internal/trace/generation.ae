^{:go/end 109} (go/func readGeneration "readGeneration buffers and decodes the structural elements of a trace generation\nout of r.\n" [^{:tag (* bufio/Reader)} r ^version/Version ver] :results [(* generation) error]
  (when (< ver version/Go126)
    (return nil (errors/New "internal error: readGeneration called for <1.26 trace")))

  (let [g (addr ^{:go/breaks [2 [4 46]]} (lit generation
          :evTable (addr ^{:go/breaks [2]} (lit evTable
              :pcs (make (map uint64 frame))))

          :batches (make (map ThreadID (slice batch)))))]


    ;; Read batches one at a time until we either hit the next generation.
    (while true
      (let [(values b gen err) (readBatch r)]
        (when (== err io/EOF)
          (when (!= (len (.-batches g)) 0)
            (return nil (errors/New "incomplete generation found; trace likely truncated")))

          (return nil nil)) ; All done.

        (when (!= err nil)
          (return nil err))

        (when (== (.-gen g) 0)
          ;; Initialize gen.
          (set! (.-gen g) gen))

        (when (.isEndOfGeneration b)
          (break))

        (when (== gen 0)
          ;; 0 is a sentinel used by the runtime, so we'll never see it.
          (return nil (fmt/Errorf "invalid generation number %d" gen)))

        (when (!= gen (.-gen g))
          (return nil (fmt/Errorf "broken trace: missing end-of-generation event, or generations are interleaved")))

        (when (or (== (.-minTs g) 0) (< (.-time b) (.-minTs g)))
          (set! (.-minTs g) (.-time b)))

        (when [err (processBatch g b ver)] (!= err nil)
          (return nil err))))



    ;; Check some invariants.
    (when (== ^{:go/via [evTable sync]} (.-freq g) 0)
      (return nil (fmt/Errorf "no frequency event found")))

    (when (not ^{:go/via [evTable sync]} (.-hasClockSnapshot g))
      (return nil (fmt/Errorf "no clock snapshot event found")))


    ;; N.B. Trust that the batch order is correct. We can't validate the batch order
    ;; by timestamp because the timestamps could just be plain wrong. The source of
    ;; truth is the order things appear in the trace and the partial order sequence
    ;; numbers on certain events. If it turns out the batch order is actually incorrect
    ;; we'll very likely fail to advance a partial order from the frontier.

    ;; Compactify stacks and strings for better lookup performance later.
    (.compactify ^{:go/via [evTable]} (.-stacks g))
    (.compactify ^{:go/via [evTable]} (.-strings g))

    ;; Validate stacks.
    (when [err (validateStackStrings (addr ^{:go/via [evTable]} (.-stacks g)) (addr ^{:go/via [evTable]} (.-strings g)) ^{:go/via [evTable]} (.-pcs g))] (!= err nil)
      (return nil err))


    ;; Now that we have the frequency, fix up CPU samples.
    (fixUpCPUSamples (.-cpuSamples g) ^{:go/via [evTable sync]} (.-freq g))
    (return g nil)))







(go/type spilledBatch "spilledBatch represents a batch that was read out for the next generation,\nwhile reading the previous one. It's passed on when parsing the next\ngeneration.\n\nUsed only for trace versions < Go126.\n" (struct
    ^{:line 117 :tag uint64} gen
    (* batch)))









^{:go/end 222} (go/func readGenerationWithSpill "readGenerationWithSpill buffers and decodes the structural elements of a trace generation\nout of r. spill is the first batch of the new generation (already buffered and\nparsed from reading the last generation). Returns the generation and the first\nbatch read of the next generation, if any.\n\nIf gen is non-nil, it is valid and must be processed before handling the returned\nerror.\n" [^{:tag (* bufio/Reader)} r ^{:tag (* spilledBatch)} spill ^version/Version ver] :results [(* generation) (* spilledBatch) error]

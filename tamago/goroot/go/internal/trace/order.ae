^{:go/end 232} (go/method advanceProcStatus [^{:tag (* ordering)} o ^{:tag (* baseEvent)} ev ^{:tag (* evTable)} evt ^ThreadID m ^uint64 gen ^schedCtx curCtx] :results [schedCtx bool error]
  (let [pid (conv ProcID (aget (.-args ev) 0))
      ^{:line 172} status (conv tracev2/ProcStatus (aget (.-args ev) 1))]
    (when (>= (conv int status) (len tracev2ProcStatus2ProcState))
      (return curCtx false (fmt/Errorf "invalid status for proc %d: %d" pid status)))

    (let [oldState (aget tracev2ProcStatus2ProcState status)]
      (if [(values s ok) (aget (.-pStates o) pid)] ok (do
          (cond (and (== status tracev2/ProcSyscallAbandoned) (== (.-status s) tracev2/ProcSyscall)) (do
              ;; ProcSyscallAbandoned is a special case of ProcSyscall. It indicates a
              ;; potential loss of information, but if we're already in ProcSyscall,
              ;; we haven't lost the relevant information. Promote the status and advance.
              (set! oldState ProcRunning)
              (aset (.-args ev) 1 (conv uint64 tracev2/ProcSyscall)))
            (and (== status tracev2/ProcSyscallAbandoned) (== (.-status s) tracev2/ProcSyscallAbandoned)) (do
              ;; If we're passing through ProcSyscallAbandoned, then there's no promotion
              ;; to do. We've lost the M that this P is associated with. However it got there,
              ;; it's going to appear as idle in the API, so pass through as idle.
              (set! oldState ProcIdle)
              (aset (.-args ev) 1 (conv uint64 tracev2/ProcSyscallAbandoned)))
            (!= (.-status s) status)
            (return curCtx false (fmt/Errorf "inconsistent status for proc %d: old %v vs. new %v" pid (.-status s) status)))

          (set! (.-seq s) (makeSeq gen 0))) ; Reset seq.
        (do
          (aset (.-pStates o) pid (addr (lit pState :id pid :status status :seq (makeSeq gen 0))))
          (if (== gen (.-initialGen o))
            (set! oldState ProcUndetermined)

            (set! oldState ProcNotExist))))


      (aset (.extra ev version/Go122) 0 (conv uint64 oldState)) ; Smuggle in the old state for StateTransition.

      ;; Bind the proc to the new context, if it's running.
      (let [newCtx curCtx]
        (when (or (== status tracev2/ProcRunning) (== status tracev2/ProcSyscall))
          (set! (.-P newCtx) pid))

        ;; If we're advancing through ProcSyscallAbandoned *but* oldState is running then we've
        ;; promoted it to ProcSyscall. However, because it's ProcSyscallAbandoned, we know this
        ;; P is about to get stolen and its status very likely isn't being emitted by the same
        ;; thread it was bound to. Since this status is Running -> Running and Running is binding,
        ;; we need to make sure we emit it in the right context: the context to which it is bound.
        ;; Find it, and set our current context to it.
        (when (and (== status tracev2/ProcSyscallAbandoned) (== oldState ProcRunning))

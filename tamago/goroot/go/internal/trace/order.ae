(go/type ordering "ordering emulates Go scheduler state for both validation and\nfor putting events in the right order.\n\nThe interface to ordering consists of two methods: Advance\nand Next. Advance is called to try and advance an event and\nadd completed events to the ordering. Next is used to pick\noff events in the ordering.\n" (struct
    ^{:line 24 :tag version/Version} traceVer
    ^{:line 25 :tag (map GoID (* gState))} gStates
    ^{:line 26 :tag (map ProcID (* pState))} pStates ; TODO: The keys are dense, so this can be a slice.
    ^{:line 27 :tag (map ThreadID (* mState))} mStates
    ^{:line 28 :tag (map TaskID taskState)} activeTasks
    ^{:line 29 :tag uint64} gcSeq
    ^{:line 30 :tag gcState} gcState
    ^{:line 31 :tag uint64} initialGen
    ^{:line 32 :tag (queue Event)} queue))














^{:go/end 89} (go/method Advance "Advance checks if it's valid to proceed with ev which came from thread m.\n\nIt assumes the gen value passed to it is monotonically increasing across calls.\n\nIf any error is returned, then the trace is broken and trace parsing must cease.\nIf it's not valid to advance with ev, but no error was encountered, the caller\nshould attempt to advance with other candidate events from other threads. If the\ncaller runs out of candidates, the trace is invalid.\n\nIf this returns true, Next is guaranteed to return a complete event. However,\nmultiple events may be added to the ordering, so the caller should (but is not\nrequired to) continue to call Next until it is exhausted.\n" [^{:tag (* ordering)} o ^{:tag (* baseEvent)} ev ^{:tag (* evTable)} evt ^ThreadID m ^uint64 gen] :results [bool error]
  (when (== (.-initialGen o) 0)
    ;; Set the initial gen if necessary.
    (set! (.-initialGen o) gen))


  (let [(values ^schedCtx curCtx ^schedCtx newCtx) (zero schedCtx)]
    (set! (.-M curCtx) m)
    (set! (.-M newCtx) m)

    (let [^{:tag (* mState)} ms (zero (* mState))]
      (if (== m NoThread) (do
          (set! (.-P curCtx) NoProc)
          (set! (.-G curCtx) NoGoroutine)
          (set! newCtx curCtx))

        ;; Pull out or create the mState for this event.
        (let [^bool ok (zero bool)]
          (set! (values ms ok) (aget (.-mStates o) m))
          (when (not ok)
            (set! ms (addr ^{:go/breaks [2 4]} (lit mState
                  :g NoGoroutine
                  :p NoProc)))

            (aset (.-mStates o) m ms))

          (set! (.-P curCtx) (.-p ms))
          (set! (.-G curCtx) (.-g ms))
          (set! newCtx curCtx)))


      (let [f (aget orderingDispatch (.-typ ev))]
        (when (== f nil)
          (return false (fmt/Errorf "bad event type found while ordering: %v" (.-typ ev))))

        (let [(values ^:assign newCtx ok err) (f o ev evt m gen curCtx)]
          (when (and (== err nil) ok (!= ms nil))
            ;; Update the mState for this event.
            (set! (.-p ms) (.-P newCtx))
            (set! (.-g ms) (.-G newCtx)))

          (return ok err))))))



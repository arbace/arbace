^{:go/end 464} (go/method advanceGoCreate [^{:tag (* ordering)} o ^{:tag (* baseEvent)} ev ^{:tag (* evTable)} evt ^ThreadID m ^uint64 gen ^schedCtx curCtx] :results [schedCtx bool error]
  ;; Goroutines must be created on a running P, but may or may not be created
  ;; by a running goroutine.
  (let [reqs (lit schedReqs :M mustHave :P mustHave :G mayHave)]
    (when [err (validateCtx curCtx reqs)] (!= err nil)

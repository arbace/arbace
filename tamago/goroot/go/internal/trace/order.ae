        (return curCtx true nil)))))


^{:go/end 499} (go/method advanceGoStopExec [^{:tag (* ordering)} o ^{:tag (* baseEvent)} ev ^{:tag (* evTable)} evt ^ThreadID m ^uint64 gen ^schedCtx curCtx] :results [schedCtx bool error]

        (.push (.-queue o) (lit Event :table evt :ctx curCtx :base @ev))
        (return newCtx true nil)))))


^{:go/end 263} (go/method advanceProcStart [^{:tag (* ordering)} o ^{:tag (* baseEvent)} ev ^{:tag (* evTable)} evt ^ThreadID m ^uint64 gen ^schedCtx curCtx] :results [schedCtx bool error]

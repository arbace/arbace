^{:go/end 439} (go/method advanceGoStatus [^{:tag (* ordering)} o ^{:tag (* baseEvent)} ev ^{:tag (* evTable)} evt ^ThreadID m ^uint64 gen ^schedCtx curCtx] :results [schedCtx bool error]

(ns go.internal.trace.tracev2
  (:require [arbace.go :as go]))

(go/package tracev2
  :path "internal/trace/tracev2"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["doc.go" "events.go" "spec.go"]
  :init-order [experiments specs EventArgTypes]
  :positions :lines)

(load "tracev2/doc")
(load "tracev2/events")
(load "tracev2/spec")

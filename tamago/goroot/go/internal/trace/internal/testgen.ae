(ns go.internal.trace.internal.testgen
  (:require [arbace.go :as go]))

(go/package testgen
  :path "internal/trace/internal/testgen"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["trace.go"]
  :init-order [NoString NoStack]
  :positions :lines)

(load "testgen/trace")

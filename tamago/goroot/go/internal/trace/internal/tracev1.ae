(ns go.internal.trace.internal.tracev1
  (:require [arbace.go :as go]))

(go/package tracev1
  :path "internal/trace/internal/tracev1"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["order.go" "parser.go"]
  :init-order [ErrTimeOrder errMalformedVarint EventDescriptions]
  :positions :lines)

(load "tracev1/order")
(load "tracev1/parser")

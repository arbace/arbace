(go/directive "//gcassert:inline")
^{:go/end 1511} (go/method allocateStack ^{:tag (slice uint64)} [^{:tag (* parser)} p ^uint64 size]
  (when (== size 0)
    (return nil))


  ;; Stacks are plentiful but small. For our "Staticcheck on std" trace with
  ;; 11e6 events, we have roughly 500,000 stacks, using 200 MiB of memory. To
  ;; avoid making 500,000 small allocations we allocate backing arrays 1 MiB
  ;; at a time.
  (let [out (.-stacksData p)]
    (when (< (conv uint64 (len out)) size)
      (set! out (make (slice uint64) (* 1024 128))))

    (set! (.-stacksData p) (subslice out size))
    (subslice out _ size size)))


^{:go/end 1529} (go/method STWReason ^STWReason [^{:tag (* Trace)} tr ^uint64 kindID]
  (cond (< (.-Version tr) 21)
    (if (or (== kindID 0) (== kindID 1))
      (return (conv STWReason (+ kindID 1)))

      (return STWUnknown))

    (== (.-Version tr) 21)
    (if (< kindID NumSTWReasons)
      (return (conv STWReason kindID))

      (return STWUnknown)) :else


    (return STWUnknown)))




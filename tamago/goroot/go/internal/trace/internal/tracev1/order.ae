  ^{:line 22} [^{:tag gStatus :val 0} gDead iota]
  ^{:line 23} [^{:val 1} gRunnable]
  ^{:line 24} [^{:val 2} gRunning]
  ^{:line 25} [^{:val 3} gWaiting]

  ^{:line 27} [^{:val 18446744073709551615N} unordered (bit-not (conv uint64 0))]
  ^{:line 28} [^{:val 18446744073709551614N} garbage (- (bit-not (conv uint64 0)) 1)]
  ^{:line 29} [^{:val 18446744073709551615N} noseq (bit-not (conv uint64 0))]

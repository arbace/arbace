    (when (.-Stack (aget tracev1/EventDescriptions (.-Type ev)))
      (when [stackIDs (.-StackIDs (aget (tracev2/Specs) mappedType))] (> (len stackIDs) 0)
        (aset mappedArgs (- (aget stackIDs 0) 1) (conv uint64 (.-StkID ev)))))



    (let [m NoThread]
      (when (and (!= (.-P ev) -1) (!= (.-Type ev) tracev1/EvCPUSample))
        (when [(values t ok) (aget (.-procMs it) (conv ProcID (.-P ev)))] ok
          (set! m (conv ThreadID t))))


      (when (== (.-Type ev) tracev1/EvProcStop)
        (delete (.-procMs it) (conv ProcID (.-P ev))))

      (let [g (conv GoID (.-G ev))]
        (when (== g 0)
          (set! g NoGoroutine))

        (let [out ^{:go/breaks [2 [4 551] 6]} (lit Event
              :ctx ^{:go/breaks [2 4 6]} (lit schedCtx
                :G (conv GoID g)
                :P (conv ProcID (.-P ev))
                :M m)

              :table (.-evt it)
              :base ^{:go/breaks [2 4 6]} (lit baseEvent
                :typ mappedType
                :time (conv Time (.-Ts ev))
                :args mappedArgs))]


          (return out nil))))))




^{:go/end 567} (go/func convertV1Trace "convertV1Trace takes a fully loaded trace in the v1 trace format and\nreturns an iterator over events in the new format.\n" ^{:tag (* traceV1Converter)} [^tracev1/Trace pr]
  (let [it (addr (lit traceV1Converter))]
    (.init it pr)
    ^{:line 566} it))

^{:go/end 587} (go/func makeRangeEvent "TODO(felixge): should this ever manipulate the e ctx? Or just report mismatches?\n" [^Event e ^EventKind kind ^Range r] :results [Event error]
  ;; TODO(felixge): Should we add dedicated range kinds rather than using
  ;; string names?
  (switch (.-Name r)
    (case ["GC concurrent mark phase"]
      (when (!= (.-Kind (.-Scope r)) ResourceNone)
        (return (lit Event) (fmt/Errorf "unexpected scope: %s" (.-Scope r))))

      (switch kind
        (case [EventRangeBegin]
          (set! (.-typ (.-base e)) tracev2/EvGCBegin))
        (case [EventRangeActive]
          (set! (.-typ (.-base e)) tracev2/EvGCActive))
        (case [EventRangeEnd]
          (set! (.-typ (.-base e)) tracev2/EvGCEnd))
        (default
          (return (lit Event) (fmt/Errorf "unexpected range kind: %s" kind)))))

    (case ["GC incremental sweep"]
      (when (!= (.-Kind (.-Scope r)) ResourceProc)
        (return (lit Event) (fmt/Errorf "unexpected scope: %s" (.-Scope r))))

      (switch kind
        (case [EventRangeBegin]
          (set! (.-typ (.-base e)) tracev2/EvGCSweepBegin)
          (set! (.-P (.-ctx e)) (.Proc (.-Scope r))))
        (case [EventRangeActive]
          (set! (.-typ (.-base e)) tracev2/EvGCSweepActive)
          (aset (.-args (.-base e)) 0 (conv uint64 (.Proc (.-Scope r)))))
        (case [EventRangeEnd]
          (set! (.-typ (.-base e)) tracev2/EvGCSweepEnd)
          ;; TODO(felixge): check against sched ctx and return error on mismatch
          (set! (.-P (.-ctx e)) (.Proc (.-Scope r))))
        (default
          (return (lit Event) (fmt/Errorf "unexpected range kind: %s" kind)))))

    (case ["GC mark assist"]
      (when (!= (.-Kind (.-Scope r)) ResourceGoroutine)
        (return (lit Event) (fmt/Errorf "unexpected scope: %s" (.-Scope r))))

      (switch kind
        (case [EventRangeBegin]
          (set! (.-typ (.-base e)) tracev2/EvGCMarkAssistBegin)
          (set! (.-G (.-ctx e)) (.Goroutine (.-Scope r))))
        (case [EventRangeActive]
          (set! (.-typ (.-base e)) tracev2/EvGCMarkAssistActive)
          (aset (.-args (.-base e)) 0 (conv uint64 (.Goroutine (.-Scope r)))))
        (case [EventRangeEnd]
          (set! (.-typ (.-base e)) tracev2/EvGCMarkAssistEnd)
          ;; TODO(felixge): check against sched ctx and return error on mismatch
          (set! (.-G (.-ctx e)) (.Goroutine (.-Scope r))))
        (default
          (return (lit Event) (fmt/Errorf "unexpected range kind: %s" kind)))))

    (default
      (let [match (.FindStringSubmatch stwRangeRegexp (.-Name r))]
        (when (!= (len match) 2)
          (return (lit Event) (fmt/Errorf "unexpected range name: %s" (.-Name r))))

        (when (!= (.-Kind (.-Scope r)) ResourceGoroutine)
          (return (lit Event) (fmt/Errorf "unexpected scope: %s" (.-Scope r))))

        (switch kind
          (case [EventRangeBegin]
            (set! (.-typ (.-base e)) tracev2/EvSTWBegin)
            ;; TODO(felixge): check against sched ctx and return error on mismatch
            (set! (.-G (.-ctx e)) (.Goroutine (.-Scope r))))
          (case [EventRangeEnd]
            (set! (.-typ (.-base e)) tracev2/EvSTWEnd)
            ;; TODO(felixge): check against sched ctx and return error on mismatch
            (set! (.-G (.-ctx e)) (.Goroutine (.-Scope r))))
          (default
            (return (lit Event) (fmt/Errorf "unexpected range kind: %s" kind))))

        (aset (.-args (.-base e)) 0 (conv uint64 (.append (.-strings (.-table e)) (aget match 1)))))))

  (return e nil))



^{:go/end 1346} (go/method String "String returns the event as a human-readable string.\n\nThe format of the string is intended for debugging and is subject to change.\n" ^string [^Event e]
  (let [^strings/Builder sb (zero strings/Builder)]
    (fmt/Fprintf (addr sb) "M=%d P=%d G=%d" (.Thread e) (.Proc e) (.Goroutine e))
    (fmt/Fprintf (addr sb) " %s Time=%d" (.Kind e) (.Time e))
    ;; Kind-specific fields.
    (switch [kind (.Kind e)] kind
      (case [EventMetric]
        (let [m (.Metric e)
            ^{:line 1271} v (.String (.-Value m))]
          (when (== (.Kind (.-Value m)) ValueString)
            (set! v (strconv/Quote v)))

          (fmt/Fprintf (addr sb) " Name=%q Value=%s" (.-Name m) (.-Value m))))
      (case [EventLabel]
        (let [l (.Label e)]
          (fmt/Fprintf (addr sb) " Label=%q Resource=%s" (.-Label l) (.-Resource l))))
      (case [EventRangeBegin EventRangeActive EventRangeEnd]
        (let [r (.Range e)]
          (fmt/Fprintf (addr sb) " Name=%q Scope=%s" (.-Name r) (.-Scope r))
          (when (== kind EventRangeEnd)
            (fmt/Fprintf (addr sb) " Attributes=[")
            (range [i attr (.RangeAttributes e)]
              (when (!= i 0)
                (fmt/Fprintf (addr sb) " "))

              (fmt/Fprintf (addr sb) "%q=%s" (.-Name attr) (.-Value attr)))

            (fmt/Fprintf (addr sb) "]"))))

      (case [EventTaskBegin EventTaskEnd]
        (let [t (.Task e)]
          (fmt/Fprintf (addr sb) " ID=%d Parent=%d Type=%q" (.-ID t) (.-Parent t) (.-Type t))))
      (case [EventRegionBegin EventRegionEnd]
        (let [r (.Region e)]
          (fmt/Fprintf (addr sb) " Task=%d Type=%q" (.-Task r) (.-Type r))))
      (case [EventLog]
        (let [l (.Log e)]
          (fmt/Fprintf (addr sb) " Task=%d Category=%q Message=%q" (.-Task l) (.-Category l) (.-Message l))))
      (case [EventStateTransition]
        (let [s (.StateTransition e)]
          (switch (.-Kind (.-Resource s))
            (case [ResourceGoroutine]
              (let [id (.Goroutine (.-Resource s))
                  (values old new) (.Goroutine s)]
                (fmt/Fprintf (addr sb) " GoID=%d %s->%s" id old new)))
            (case [ResourceProc]
              (let [id (.Proc (.-Resource s))
                  (values old new) (.Proc s)]
                (fmt/Fprintf (addr sb) " ProcID=%d %s->%s" id old new))))

          (fmt/Fprintf (addr sb) " Reason=%q" (.-Reason s))
          (when (!= (.-Stack s) NoStack)
            (fmt/Fprintln (addr sb))
            (fmt/Fprintln (addr sb) "TransitionStack=")
            (printStack (addr sb) "\t" (.Frames (.-Stack s))))))

      (case [EventExperimental]
        (let [r (.Experimental e)]
          (fmt/Fprintf (addr sb) " Name=%s Args=[" (.-Name r))
          (range [i arg (.-Args r)]
            (when (!= i 0)
              (fmt/Fprintf (addr sb) ", "))

            (fmt/Fprintf (addr sb) "%s=%s" arg (.String (.ArgValue r i))))

          (fmt/Fprintf (addr sb) "]")))
      (case [EventSync]
        (let [s (.Sync e)]
          (fmt/Fprintf (addr sb) " N=%d" (.-N s))
          (when (!= (.-ClockSnapshot s) nil)
            (fmt/Fprintf (addr sb) " Trace=%d Mono=%d Wall=%s"
              (.-Trace (.-ClockSnapshot s))
              (.-Mono (.-ClockSnapshot s))
              (.Format (.-Wall (.-ClockSnapshot s)) time/RFC3339Nano))))))



    (when [stk (.Stack e)] (!= stk NoStack)
      (fmt/Fprintln (addr sb))
      (fmt/Fprintln (addr sb) "Stack=")
      (printStack (addr sb) "\t" (.Frames stk)))

    (.String sb)))




^{:go/end 1376} (go/method validateTableIDs "validateTableIDs checks to make sure lookups in e.table\nwill work.\n" ^error [^Event e]
  (when (== (.-typ (.-base e)) evSync)
    (return nil))

  ^{:go/breaks [[4 1375]]} (let [spec (aget (tracev2/Specs) (.-typ (.-base e)))]

    ;; Check stacks.
    (range [_ i (.-StackIDs spec)]
      (let [id (conv stackID (aget (.-args (.-base e)) (- i 1)))
          (values _ ok) (.get (.-stacks (.-table e)) id)]
        (when (not ok)
          (return (fmt/Errorf "found invalid stack ID %d for event %s" id (.-Name spec))))))


    ;; N.B. Strings referenced by stack frames are validated
    ;; early on, when reading the stacks in to begin with.

    ;; Check strings.
    (range [_ i (.-StringIDs spec)]
      (let [id (conv stringID (aget (.-args (.-base e)) (- i 1)))
          (values _ ok) (.get (.-strings (.-table e)) id)]
        (when (not ok)
          (return (fmt/Errorf "found invalid string ID %d for event %s" id (.-Name spec))))))


    nil))


^{:go/end 1393} (go/func syncEvent ^Event [^{:tag (* evTable)} table ^Time ts ^int n]
  (let [ev ^{:go/breaks [2 4 [6 1386]]} (lit Event
        :table table
        :ctx ^{:go/breaks [2 4 6]} (lit schedCtx
          :G NoGoroutine
          :P NoProc
          :M NoThread)

        :base ^{:go/breaks [2 4]} (lit baseEvent
          :typ evSync
          :time ts))]


    (aset (.-args (.-base ev)) 0 (conv uint64 n))
    ^{:line 1392} ev))

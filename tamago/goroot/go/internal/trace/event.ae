    (case ["/memory/classes/heap/objects:bytes"]
      (set! (.-typ (.-base e)) tracev2/EvHeapAlloc))
    (case ["/gc/heap/goal:bytes"]
      (set! (.-typ (.-base e)) tracev2/EvHeapGoal))

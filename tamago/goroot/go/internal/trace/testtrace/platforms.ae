(in-ns 'go.internal.trace.testtrace) (go/file "platforms.go" :imports [


    ^{:line 8} [runtime "runtime"]
    ^{:line 9} [testing "testing"]])




^{:go/end 19} (go/func MustHaveSyscallEvents "MustHaveSyscallEvents skips the current test if the current\nplatform does not support true system call events.\n" [^{:tag (* testing/T)} t]
  (when (HasSyscallEvents)
    (return))

  ^{:go/via [common]} (.Skip t "current platform has no true syscall events"))




^{:go/breaks [[5 31]] :go/end 32} (go/func HasSyscallEvents "HasSyscallEvents returns true if the current platform\nhas real syscall events available.\n" ^bool []
  (switch runtime/GOOS
    (case ["js" "wasip1" "tamago"]
      ;; js and wasip1 emulate system calls by blocking on channels
      ;; while yielding back to the environment. They never actually
      ;; call entersyscall/exitsyscall.
      (return false)))

  true)

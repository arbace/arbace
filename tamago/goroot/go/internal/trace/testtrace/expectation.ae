(in-ns 'go.internal.trace.testtrace) (go/file "expectation.go" :imports [


    ^{:line 8} [bufio "bufio"]
    ^{:line 9} [bytes "bytes"]
    ^{:line 10} [fmt "fmt"]
    ^{:line 11} [regexp "regexp"]
    ^{:line 12} [strconv "strconv"]
    ^{:line 13} [strings "strings"]])



(go/type Expectation "Expectation represents the expected result of some operation.\n" (struct
    ^{:line 18 :tag bool} failure
    ^{:line 19 :tag (* regexp/Regexp)} errorMatcher))



^{:go/end 25} (go/func ExpectSuccess "ExpectSuccess returns an Expectation that trivially expects success.\n" ^{:tag (* Expectation)} []
  (new Expectation))







^{:go/breaks [[7 42]] :go/end 43} (go/method Check "Check validates whether err conforms to the expectation. Returns\nan error if it does not conform.\n\nConformance means that if failure is true, then err must be non-nil.\nIf err is non-nil, then it must match errorMatcher.\n" ^error [^{:tag (* Expectation)} e ^error err]
  (when (and (not (.-failure e)) (!= err nil))
    (return (fmt/Errorf "unexpected error while reading the trace: %v" err)))

  (when (and (.-failure e) (== err nil))
    (return (fmt/Errorf "expected error while reading the trace: want something matching %q, got none" (.-errorMatcher e))))

  (when (and (.-failure e) (!= err nil) (not (.MatchString (.-errorMatcher e) (.Error err))))
    (return (fmt/Errorf "unexpected error while reading the trace: want something matching %q, got %s" (.-errorMatcher e) (.Error err))))

  nil)



^{:go/end 69} (go/func ParseExpectation "ParseExpectation parses the serialized form of an Expectation.\n" [^{:tag (slice byte)} data] :results [(* Expectation) error]
  (let [exp (new Expectation)
      ^{:line 48} s (bufio/NewScanner (bytes/NewReader data))]
    (when (.Scan s)
      (let [c (strings/SplitN (.Text s) " " 2)]
        (switch (aget c 0)
          (case ["SUCCESS"])
          (case ["FAILURE"]
            (set! (.-failure exp) true)
            (when (!= (len c) 2)
              (return exp (fmt/Errorf "bad header line for FAILURE: %q" (.Text s))))

            (let [(values matcher err) (parseMatcher (aget c 1))]
              (when (!= err nil)
                (return exp err))

              (set! (.-errorMatcher exp) matcher)))
          (default
            (return exp (fmt/Errorf "bad header line: %q" (.Text s)))))

        (return exp nil)))

    (return exp (.Err s))))


^{:go/end 81} (go/func parseMatcher [^string quoted] :results [(* regexp/Regexp) error]
  (let [(values pattern err) (strconv/Unquote quoted)]
    (when (!= err nil)
      (return nil (fmt/Errorf "malformed pattern: not correctly quoted: %s: %v" quoted err)))

    (let [(values matcher ^:assign err) (regexp/Compile pattern)]
      (when (!= err nil)
        (return nil (fmt/Errorf "malformed pattern: not a valid regexp: %s: %v" pattern err)))

      (return matcher nil))))

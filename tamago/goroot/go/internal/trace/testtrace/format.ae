(in-ns 'go.internal.trace.testtrace) (go/file "format.go" :imports [


    ^{:line 8} [bytes "bytes"]
    ^{:line 9} [fmt "fmt"]
    ^{:line 10} [raw "internal/trace/raw"]
    ^{:line 11} [version "internal/trace/version"]
    ^{:line 12} [txtar "internal/txtar"]
    ^{:line 13} [io "io"]])



^{:go/end 57} (go/func ParseFile "ParseFile parses a test file generated by the testgen package.\n" [^string testPath] :results [io/Reader version/Version (* Expectation) error]
  (let [(values ar err) (txtar/ParseFile testPath)]
    (when (!= err nil)
      (return nil 0 nil (fmt/Errorf "failed to read test file for %s: %v" testPath err)))

    (when (!= (len (.-Files ar)) 2)
      (return nil 0 nil (fmt/Errorf "malformed test %s: wrong number of files" testPath)))

    (when (!= (.-Name (aget (.-Files ar) 0)) "expect")
      (return nil 0 nil (fmt/Errorf "malformed test %s: bad filename %s" testPath (.-Name (aget (.-Files ar) 0)))))

    (when (!= (.-Name (aget (.-Files ar) 1)) "trace")
      (return nil 0 nil (fmt/Errorf "malformed test %s: bad filename %s" testPath (.-Name (aget (.-Files ar) 1)))))

    (let [(values tr ^:assign err) (raw/NewTextReader (bytes/NewReader (.-Data (aget (.-Files ar) 1))))]
      (when (!= err nil)
        (return nil 0 nil (fmt/Errorf "malformed test %s: bad trace file: %v" testPath err)))

      (let [^bytes/Buffer buf (zero bytes/Buffer)
          (values tw ^:assign err) (raw/NewWriter (addr buf) (.Version tr))]
        (when (!= err nil)
          (return nil 0 nil (fmt/Errorf "failed to create trace byte writer: %v" err)))

        (while true
          (let [(values ev err) (.ReadEvent tr)]
            (when (== err io/EOF)
              (break))

            (when (!= err nil)
              (return nil 0 nil (fmt/Errorf "malformed test %s: bad trace file: %v" testPath err)))

            (when [err (.WriteEvent tw ev)] (!= err nil)
              (return nil 0 nil (fmt/Errorf "internal error during %s: failed to write trace bytes: %v" testPath err)))))


        (let [(values exp ^:assign err) (ParseExpectation (.-Data (aget (.-Files ar) 0)))]
          (when (!= err nil)
            (return nil 0 nil (fmt/Errorf "internal error during %s: failed to parse expectation %q: %v" testPath (conv string (.-Data (aget (.-Files ar) 0))) err)))

          (return (addr buf) (.Version tr) exp nil))))))

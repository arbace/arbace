(in-ns 'go.internal.sync) (go/file "runtime.go" :imports [

    ^{:line 7} [_ "unsafe"]])

;; defined in package runtime











(go/func ^:extern ^{:go/linkname "runtime_SemacquireMutex"} runtime_SemacquireMutex "SemacquireMutex is like Semacquire, but for profiling contended\nMutexes and RWMutexes.\nIf lifo is true, queue waiter at the head of wait queue.\nskipframes is the number of frames to omit during tracing, counting from\nruntime_SemacquireMutex's caller.\nThe different forms of this function just tell the runtime how to present\nthe reason for waiting in a backtrace, and is used to compute some metrics.\nOtherwise they're functionally identical.\n" [^{:tag (* uint32)} s ^bool lifo ^int skipframes])










(go/func ^:extern ^{:go/linkname "runtime_Semrelease"} runtime_Semrelease "Semrelease atomically increments *s and notifies a waiting goroutine\nif one is blocked in Semacquire.\nIt is intended as a simple wakeup primitive for use by the synchronization\nlibrary and should not be used directly.\nIf handoff is true, pass count directly to the first waiter.\nskipframes is the number of frames to omit during tracing, counting from\nruntime_Semrelease's caller.\n" [^{:tag (* uint32)} s ^bool handoff ^int skipframes])





(go/func ^:extern ^{:go/linkname "runtime_canSpin"} runtime_canSpin "Active spinning runtime support.\nruntime_canSpin reports whether spinning makes sense at the moment.\n" ^bool [^int i])




(go/func ^:extern ^{:go/linkname "runtime_doSpin"} runtime_doSpin "runtime_doSpin does active spinning.\n" [])


(go/func ^:extern ^{:go/linkname "runtime_nanotime"} runtime_nanotime ^int64 [])


(go/func ^:extern ^{:go/linkname "throw"} throw [string])


(go/func ^:extern ^{:go/linkname "fatal"} fatal [string])

(ns go.internal.stringslite
  (:require [arbace.go :as go]))

(go/package stringslite
  :path "internal/stringslite"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["strings.go"]
  :init-order []
  :positions :lines)

(load "stringslite/strings")

;; Package goexperiment implements support for toolchain experiments.
;;
;; Toolchain experiments are controlled by the GOEXPERIMENT
;; environment variable. GOEXPERIMENT is a comma-separated list of
;; experiment names. GOEXPERIMENT can be set at make.bash time, which
;; sets the default experiments for binaries built with the tool
;; chain; or it can be set at build time. GOEXPERIMENT can also be set
;; to "none", which disables any experiments that were enabled at
;; make.bash time.
;;
;; Experiments are exposed to the build in the following ways:
;;
;;   - Build tag goexperiment.x is set if experiment x (lower case) is
;;     enabled.
;;
;;   - For each experiment x (in camel case), this package contains a
;;     boolean constant x and an integer constant xInt.
;;
;;   - In runtime assembly, the macro GOEXPERIMENT_x is defined if
;;     experiment x (lower case) is enabled.
;;
;; In the toolchain, the set of experiments enabled for the current
;; build should be accessed via objabi.Experiment.
;;
;; The set of experiments is included in the output of [runtime.Version]()
;; and "go version <binary>" if it differs from the default experiments.
;;
;; For the set of experiments supported by the current toolchain, see
;; "go doc goexperiment.Flags".
;;
;; Note that this package defines the set of experiments (in [Flags])
;; and records the experiments that were enabled when the package
;; was compiled (as boolean and integer constants).
;;
;; Note especially that this package does not itself change behavior
;; at run time based on the GOEXPERIMENT variable.
;; The code used in builds to interpret the GOEXPERIMENT variable
;; is in the separate package [internal/buildcfg].
(in-ns 'go.internal.goexperiment) (go/file "flags.go" :doc "Package goexperiment implements support for toolchain experiments.\n\nToolchain experiments are controlled by the GOEXPERIMENT\nenvironment variable. GOEXPERIMENT is a comma-separated list of\nexperiment names. GOEXPERIMENT can be set at make.bash time, which\nsets the default experiments for binaries built with the tool\nchain; or it can be set at build time. GOEXPERIMENT can also be set\nto \"none\", which disables any experiments that were enabled at\nmake.bash time.\n\nExperiments are exposed to the build in the following ways:\n\n  - Build tag goexperiment.x is set if experiment x (lower case) is\n    enabled.\n\n  - For each experiment x (in camel case), this package contains a\n    boolean constant x and an integer constant xInt.\n\n  - In runtime assembly, the macro GOEXPERIMENT_x is defined if\n    experiment x (lower case) is enabled.\n\nIn the toolchain, the set of experiments enabled for the current\nbuild should be accessed via objabi.Experiment.\n\nThe set of experiments is included in the output of [runtime.Version]()\nand \"go version <binary>\" if it differs from the default experiments.\n\nFor the set of experiments supported by the current toolchain, see\n\"go doc goexperiment.Flags\".\n\nNote that this package defines the set of experiments (in [Flags])\nand records the experiments that were enabled when the package\nwas compiled (as boolean and integer constants).\n\nNote especially that this package does not itself change behavior\nat run time based on the GOEXPERIMENT variable.\nThe code used in builds to interpret the GOEXPERIMENT variable\nis in the separate package [internal/buildcfg].\n" :imports [])

(go/directive "//go:generate go run mkconsts.go")











(go/type Flags "Flags is the set of experiments that can be enabled or disabled in\nthe current toolchain.\n\nWhen specified in the GOEXPERIMENT environment variable or as build\ntags, experiments use the strings.ToLower of their field name.\n\nFor the baseline experimental configuration, see\n[internal/buildcfg.Experiment].\n\nIf you change this struct definition, run \"go generate\".\n" (struct
    ^{:line 58 :tag bool} FieldTrack
    ^{:line 59 :tag bool} PreemptibleLoops
    ^{:line 60 :tag bool} StaticLockRanking
    ^{:line 61 :tag bool} BoringCrypto

    ;; Regabi is split into several sub-experiments that can be
    ;; enabled individually. Not all combinations work.
    ;; The "regabi" GOEXPERIMENT is an alias for all "working"
    ;; subexperiments.




    ^{:line 71 :tag bool :doc "RegabiWrappers enables ABI wrappers for calling between\nABI0 and ABIInternal functions. Without this, the ABIs are\nassumed to be identical so cross-ABI calls are direct.\n"} RegabiWrappers





    ^{:line 77 :tag bool :doc "RegabiArgs enables register arguments/results in all\ncompiled Go functions.\n\nRequires wrappers (to do ABI translation), and reflect (so\nreflection calls use registers).\n"} RegabiArgs






    ^{:line 84 :tag bool :doc "HeapMinimum512KiB reduces the minimum heap size to 512 KiB.\n\nThis was originally reduced as part of PacerRedesign, but\nhas been broken out to its own experiment that is disabled\nby default.\n"} HeapMinimum512KiB



    ^{:line 88 :tag bool :doc "Arenas causes the \"arena\" standard library package to be visible\nto the outside world.\n"} Arenas




    ^{:line 93 :tag bool :doc "CgoCheck2 enables an expensive cgo rule checker.\nWhen this experiment is enabled, cgo rule checks occur regardless\nof the GODEBUG=cgocheck setting provided at runtime.\n"} CgoCheck2



    ^{:line 97 :tag bool :doc "LoopVar changes loop semantics so that each iteration gets its own\ncopy of the iteration variable.\n"} LoopVar



    ^{:line 101 :tag bool :doc "NewInliner enables a new+improved version of the function\ninlining phase within the Go compiler.\n"} NewInliner


    ^{:line 104 :tag bool :doc "Dwarf5 enables DWARF version 5 debug info generation.\n"} Dwarf5


    ^{:line 107 :tag bool :doc "JSONv2 enables the json/v2 package.\n"} JSONv2


    ^{:line 110 :tag bool :doc "GreenTeaGC enables the Green Tea GC implementation.\n"} GreenTeaGC



    ^{:line 114 :tag bool :doc "RandomizedHeapBase enables heap base address randomization on 64-bit\nplatforms.\n"} RandomizedHeapBase64


    ^{:line 117 :tag bool :doc "RuntimeFreegc enables the runtime to free and reuse memory more eagerly in some circumstances with compiler help.\n"} RuntimeFreegc


    ^{:line 120 :tag bool :doc "SizeSpecializedMalloc enables malloc implementations that are specialized per size class.\n"} SizeSpecializedMalloc



    ^{:line 124 :tag bool :doc "SIMD enables the simd package and the compiler's handling\nof SIMD intrinsics.\n"} SIMD


    ^{:line 127 :tag bool :doc "RuntimeSecret enables the runtime/secret package.\n"} RuntimeSecret




    ^{:line 132 :tag bool :doc "MapSplitGroup changes the internal representation of map groups\nfrom interleaved key/elem slots (KVKVKVKV) to split key and elem\narrays (KKKKVVVV).\n"} MapSplitGroup))

(ns go.internal.txtar
  (:require [arbace.go :as go]))

(go/package txtar
  :path "internal/txtar"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["archive.go"]
  :init-order [newlineMarker marker markerEnd]
  :positions :lines)

(load "txtar/archive")

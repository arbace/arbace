(ns go.internal.sync
  (:require [arbace.go :as go]))

(go/package sync
  :path "internal/sync"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["hashtriemap.go" "mutex.go" "runtime.go"]
  :init-order []
  :positions :lines)

(load "sync/hashtriemap")
(load "sync/mutex")
(load "sync/runtime")

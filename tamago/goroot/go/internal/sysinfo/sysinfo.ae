;; Package sysinfo implements high level hardware information gathering
;; that can be used for debugging or information purposes.
(in-ns 'go.internal.sysinfo) (go/file "sysinfo.go" :doc "Package sysinfo implements high level hardware information gathering\nthat can be used for debugging or information purposes.\n" :imports [


    ^{:line 10} [cpu "internal/cpu"]
    ^{:line 11} [sync "sync"]])


(go/var CPUName (^{:inst [string]} sync/OnceValue ^{:go/breaks [[4 23]] :go/end 24} (fn ^string []
      (when [name (cpu/Name)] (!= name "")
        (return name))


      (when [name (osCPUInfoName)] (!= name "")
        (return name))


      "")))

(in-ns 'go.internal.goarch) (go/file "goarch_amd64.go" :imports [])

(go/const
  ^{:line 8} [^{:val 0} _ArchFamily AMD64]
  ^{:line 9} [^{:val 4096} _DefaultPhysPageSize 4096]
  ^{:line 10} [^{:val 1} _PCQuantum 1]
  ^{:line 11} [^{:val 0} _MinFrameSize 0]
  ^{:line 12} [^{:val 8} _StackAlign PtrSize])

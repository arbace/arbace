(ns go.internal.xcoff
  (:require [arbace.go :as go]))

(go/package xcoff
  :path "internal/xcoff"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["ar.go" "file.go" "xcoff.go"]
  :init-order []
  :positions :lines)

(load "xcoff/ar")
(load "xcoff/file")
(load "xcoff/xcoff")

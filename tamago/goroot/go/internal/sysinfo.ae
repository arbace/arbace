(ns go.internal.sysinfo
  (:require [arbace.go :as go]))

(go/package sysinfo
  :path "internal/sysinfo"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["cpuinfo_stub.go" "sysinfo.go"]
  :init-order [CPUName]
  :positions :lines)

(load "sysinfo/cpuinfo_stub")
(load "sysinfo/sysinfo")

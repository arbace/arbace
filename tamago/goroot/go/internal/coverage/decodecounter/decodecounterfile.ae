^{:go/end 216} (go/method Goos "Goos returns the GOOS setting in effect for the \"-cover\" binary\nthat produced this counter data file. The GOOS value may be\nempty in the case where the counter data file was produced\nfrom a merge in which more than one GOOS value was present.\n" ^string [^{:tag (* CounterDataReader)} cdr]
  (.-goos cdr))







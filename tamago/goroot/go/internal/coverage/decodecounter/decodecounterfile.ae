    nil))




^{:go/breaks [[9 129]] :go/end 130} (go/method readSegmentPreamble "readSegmentPreamble reads and consumes the segment header, segment string\ntable, and segment args table.\n" ^error [^{:tag (* CounterDataReader)} cdr]
  ;; Read segment header.
  (when [err (binary/Read (.-mr cdr) binary/LittleEndian (addr (.-shdr cdr)))] (!= err nil)
    (return err))

  (when (.-debug cdr)
    (fmt/Fprintf os/Stderr "=-= read counter segment header: %+v" (.-shdr cdr))
    (fmt/Fprintf os/Stderr " FcnEntries=0x%x StrTabLen=0x%x ArgsLen=0x%x\n"
      (.-FcnEntries (.-shdr cdr)) (.-StrTabLen (.-shdr cdr)) (.-ArgsLen (.-shdr cdr))))



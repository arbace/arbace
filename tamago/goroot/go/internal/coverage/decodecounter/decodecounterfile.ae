^{:go/end 73} (go/func NewCounterDataReader [^string fn ^io/ReadSeeker rs] :results [(* CounterDataReader) error]
  (let [cdr (addr ^{:go/breaks [2 4 6]} (lit CounterDataReader
          :mr rs
          :u32b (make (slice byte) 4)
          :u8b (make (slice byte) 1)))]

    ;; Read header
    (when [err (binary/Read rs binary/LittleEndian (addr (.-hdr cdr)))] (!= err nil)
      (return nil err))

    (when (.-debug cdr)
      (fmt/Fprintf os/Stderr "=-= counter file header: %+v\n" (.-hdr cdr)))

    (when (not (checkMagic (.-Magic (.-hdr cdr))))
      (return nil (fmt/Errorf "invalid magic string: not a counter data file")))

    (when (> (.-Version (.-hdr cdr)) coverage/CounterFileVersion)
      (return nil (fmt/Errorf "version data incompatibility: reader is %d data is %d" coverage/CounterFileVersion (.-Version (.-hdr cdr)))))


    ;; Read footer.
    (when [err (.readFooter cdr)] (!= err nil)
      (return nil err))

    ;; Seek back to just past the file header.
    (let [hsz (conv int64 (unsafe/Sizeof (.-hdr cdr)))]
      (when [(values _ err) (.Seek (.-mr cdr) hsz io/SeekStart)] (!= err nil)
        (return nil err))

      ;; Read preamble for first segment.
      (when [err (.readSegmentPreamble cdr)] (!= err nil)
        (return nil err))

      (return cdr nil))))


^{:go/end 78} (go/func checkMagic ^bool [^{:tag (array 4 byte)} v]
  (let [g coverage/CovCounterMagic]
    (and (== (aget v 0) (aget g 0)) (== (aget v 1) (aget g 1)) (== (aget v 2) (aget g 2)) (== (aget v 3) (aget g 3)))))


^{:go/end 95} (go/method readFooter ^error [^{:tag (* CounterDataReader)} cdr]

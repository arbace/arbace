(in-ns 'go.internal.coverage.cformat) (go/file "format.go" :imports [

    ;; This package provides apis for producing human-readable summaries
    ;; of coverage data (e.g. a coverage percentage for a given package or
    ;; set of packages) and for writing data in the legacy test format
    ;; emitted by "go test -coverprofile=<outfile>".
    ;;
    ;; The model for using these apis is to create a Formatter object,
    ;; then make a series of calls to SetPackage and AddUnit passing in
    ;; data read from coverage meta-data and counter-data files. E.g.
    ;;
    ;;		myformatter := cformat.NewFormatter()
    ;;		...
    ;;		for each package P in meta-data file: {
    ;;			myformatter.SetPackage(P)
    ;;			for each function F in P: {
    ;;				for each coverable unit U in F: {
    ;;					myformatter.AddUnit(U)
    ;;				}
    ;;			}
    ;;		}
    ;;		myformatter.EmitPercent(os.Stdout, nil, "", true, true)
    ;;		myformatter.EmitTextual(nil, somefile)
    ;;
    ;; These apis are linked into tests that are built with "-cover", and
    ;; called at the end of test execution to produce text output or
    ;; emit coverage percentages.


    ^{:line 34} [cmp "cmp"]
    ^{:line 35} [fmt "fmt"]
    ^{:line 36} [coverage "internal/coverage"]
    ^{:line 37} [cmerge "internal/coverage/cmerge"]
    ^{:line 38} [io "io"]
    ^{:line 39} [maps "maps"]
    ^{:line 40} [slices "slices"]
    ^{:line 41} [sort "sort"]
    ^{:line 42} [strings "strings"]
    ^{:line 43} [tabwriter "text/tabwriter"]])


(go/type Formatter (struct

    ^{:line 48 :tag (map string (* pstate)) :doc "Maps import path to package state.\n"} pm

    ^{:line 50 :tag string :doc "Records current package being visited.\n"} pkg

    ^{:line 52 :tag (* pstate) :doc "Pointer to current package state.\n"} p

    ^{:line 54 :tag coverage/CounterMode :doc "Counter mode.\n"} cm))






(go/type pstate "pstate records package-level coverage data state:\n- a table of functions (file/fname/literal)\n- a map recording the index/ID of each func encountered so far\n- a table storing execution count for the coverable units in each func\n" (struct

    ^{:line 63 :tag (slice fnfile) :doc "slice of unique functions\n"} funcs

    ^{:line 65 :tag (map fnfile uint32) :doc "maps function to index in slice above (index acts as function ID)\n"} funcTable


    ^{:line 68 :tag (map extcu uint32) :doc "A table storing coverage counts for each coverable unit.\n"} unitTable))



(go/type extcu "extcu encapsulates a coverable unit within some function.\n" (struct
    ^{:line 73 :tag uint32} fnfid ; index into p.funcs slice
    ^{:line 74} coverage/CoverableUnit))



(go/type fnfile "fnfile is a function-name/file-name tuple.\n" (struct
    ^{:line 79 :tag string} file
    ^{:line 80 :tag string} fname
    ^{:line 81 :tag bool} lit))


^{:go/end 89} (go/func NewFormatter ^{:tag (* Formatter)} [^coverage/CounterMode cm]
  (addr ^{:go/breaks [2 4]} (lit Formatter
      :pm (make (map string (* pstate)))
      :cm cm)))







^{:go/end 108} (go/method SetPackage "SetPackage tells the formatter that we're about to visit the\ncoverage data for the package with the specified import path.\nNote that it's OK to call SetPackage more than once with the\nsame import path; counter data values will be accumulated.\n" [^{:tag (* Formatter)} fm ^string importpath]
  (when (== importpath (.-pkg fm))
    (return))

  (set! (.-pkg fm) importpath)
  (let [(values ps ok) (aget (.-pm fm) importpath)]
    (when (not ok)
      (set! ps (new pstate))
      (aset (.-pm fm) importpath ps)
      (set! (.-unitTable ps) (make (map extcu uint32)))
      (set! (.-funcTable ps) (make (map fnfile uint32))))

    (set! (.-p fm) ps)))





^{:go/end 136} (go/method AddUnit "AddUnit passes info on a single coverable unit (file, funcname,\nliteral flag, range of lines, and counter value) to the formatter.\nCounter values will be accumulated where appropriate.\n" [^{:tag (* Formatter)} fm ^string file ^string fname ^bool isfnlit ^coverage/CoverableUnit unit ^uint32 count]
  (when (== (.-p fm) nil)
    (panic "AddUnit invoked before SetPackage"))

  (let [fkey (lit fnfile :file file :fname fname :lit isfnlit)
      (values idx ok) (aget (.-funcTable (.-p fm)) fkey)]
    (when (not ok)
      (set! idx (conv uint32 (len (.-funcs (.-p fm)))))
      (set! (.-funcs (.-p fm)) (append (.-funcs (.-p fm)) fkey))
      (aset (.-funcTable (.-p fm)) fkey idx))

    (let [ukey (lit extcu :fnfid idx :CoverableUnit unit)
        ^{:line 125} pcount (aget (.-unitTable (.-p fm)) ukey)
        ^{:line 126 :tag uint32} result (zero uint32)]
      (if (== (.-cm fm) coverage/CtrModeSet)
        (when (or (!= count 0) (!= pcount 0))
          (set! result 1))


        ;; Use saturating arithmetic.
        (set! (values result _) (cmerge/SaturatingAdd pcount count)))

      (aset (.-unitTable (.-p fm)) ukey result))))






^{:go/end 165} (go/method sortUnits "sortUnits sorts a slice of extcu objects in a package according to\nsource position information (e.g. file and line). Note that we don't\ninclude function name as part of the sorting criteria, the thinking\nbeing that is better to provide things in the original source order.\n" [^{:tag (* pstate)} p ^{:tag (slice extcu)} units]
  (^{:inst [(slice extcu) extcu]} slices/SortFunc units ^{:go/end 164} (fn ^int [^extcu ui ^extcu uj]
      (let [ifile (.-file (aget (.-funcs p) (.-fnfid ui)))
          ^{:line 145} jfile (.-file (aget (.-funcs p) (.-fnfid uj)))]
        (when [r (strings/Compare ifile jfile)] (!= r 0)
          (return r))

        ;; NB: not taking function literal flag into account here (no
        ;; need, since other fields are guaranteed to be distinct).
        (when [r (^{:inst [uint32]} cmp/Compare ^{:go/via [CoverableUnit]} (.-StLine ui) ^{:go/via [CoverableUnit]} (.-StLine uj))] (!= r 0)
          (return r))

        (when [r (^{:inst [uint32]} cmp/Compare ^{:go/via [CoverableUnit]} (.-EnLine ui) ^{:go/via [CoverableUnit]} (.-EnLine uj))] (!= r 0)
          (return r))

        (when [r (^{:inst [uint32]} cmp/Compare ^{:go/via [CoverableUnit]} (.-StCol ui) ^{:go/via [CoverableUnit]} (.-StCol uj))] (!= r 0)
          (return r))

        (when [r (^{:inst [uint32]} cmp/Compare ^{:go/via [CoverableUnit]} (.-EnCol ui) ^{:go/via [CoverableUnit]} (.-EnCol uj))] (!= r 0)
          (return r))

        (^{:inst [uint32]} cmp/Compare ^{:go/via [CoverableUnit]} (.-NxStmts ui) ^{:go/via [CoverableUnit]} (.-NxStmts uj))))))









^{:go/breaks [[9 207]] :go/end 208} (go/method EmitTextual "EmitTextual writes the accumulated coverage data for 'pkgs' in the legacy\ncmd/cover text format to the writer 'w'; if pkgs is empty, text output\nis emitted for all packages recorded.  We sort the data items by\nimportpath, source file, and line number before emitting (this sorting\nis not explicitly mandated by the format, but seems like a good idea\nfor repeatable/deterministic dumps).\n" ^error [^{:tag (* Formatter)} fm ^{:tag (slice string)} pkgs ^io/Writer w]
  (when (== (.-cm fm) coverage/CtrModeInvalid)
    (panic "internal error, counter mode unset"))

  (when (== (len pkgs) 0)
    (set! pkgs (make (slice string) 0 (len (.-pm fm))))
    (range [importpath (.-pm fm)]
      (set! pkgs (append pkgs importpath))))


  (when [(values _ err) (fmt/Fprintf w "mode: %s\n" (.String (.-cm fm)))] (!= err nil)
    (return err))

  (sort/Strings pkgs)
  (range [_ importpath pkgs]
    (let [p (aget (.-pm fm) importpath)]
      (when (== p nil)
        (continue))

      (let [units (make (slice extcu) 0 (len (.-unitTable p)))]
        (range [u (.-unitTable p)]
          (set! units (append units u)))

        (.sortUnits p units)
        (range [_ u units]
          (let [count (aget (.-unitTable p) u)
              ^{:line 199} file (.-file (aget (.-funcs p) (.-fnfid u)))]
            (when [(values _ err) (fmt/Fprintf w "%s:%d.%d,%d.%d %d %d\n"
                  ^{:line 201} file ^{:go/via [CoverableUnit]} (.-StLine u) ^{:go/via [CoverableUnit]} (.-StCol u)
                  ^{:go/via [CoverableUnit]} (.-EnLine u) ^{:go/via [CoverableUnit]} (.-EnCol u) ^{:go/via [CoverableUnit]} (.-NxStmts u) count)] (!= err nil)
              (return err)))))))



  nil)





^{:go/end 268} (go/method EmitPercent "EmitPercent writes out a \"percentage covered\" string to the writer\n'w', selecting the set of packages in 'pkgs' and suffixing the\nprinted string with 'inpkgs'.\n" ^error [^{:tag (* Formatter)} fm ^io/Writer w ^{:tag (slice string)} pkgs ^string inpkgs ^bool noteEmpty ^bool aggregate]
  (when (== (len pkgs) 0)
    (set! pkgs (make (slice string) 0 (len (.-pm fm))))
    (range [importpath (.-pm fm)]
      (set! pkgs (append pkgs importpath))))



  (let [rep ^{:go/breaks [[3 232]] :go/end 233} (fn ^error [^uint64 cov ^uint64 tot]
        (cond (!= tot 0)
          (when [(values _ err) (fmt/Fprintf w "coverage: %.1f%% of statements%s\n"
                (/ (* 100.0 (conv float64 cov)) (conv float64 tot)) inpkgs)] (!= err nil)
            (return err))

          ^{:line 227} noteEmpty
          (when [(values _ err) (fmt/Fprintf w "coverage: [no statements]\n")] (!= err nil)
            (return err)))


        nil)]


    (^{:inst [(slice string) string]} slices/Sort pkgs)
    ^{:go/breaks [[4 267]]} (let [(values ^uint64 totalStmts ^uint64 coveredStmts) (zero uint64)]
      (range [_ importpath pkgs]
        (let [p (aget (.-pm fm) importpath)]
          (when (== p nil)
            (continue))

          (when (not aggregate)
            (set! (values totalStmts coveredStmts) (values 0 0)))

          (range [unit count (.-unitTable p)]
            (let [nx (conv uint64 ^{:go/via [CoverableUnit]} (.-NxStmts unit))]
              (set! totalStmts + nx)
              (when (!= count 0)
                (set! coveredStmts + nx))))


          (when (not aggregate)
            (when [(values _ err) (fmt/Fprintf w "\t%s\t\t" importpath)] (!= err nil)
              (return err))

            (when [err (rep coveredStmts totalStmts)] (!= err nil)
              (return err)))))



      (when aggregate
        (when [err (rep coveredStmts totalStmts)] (!= err nil)
          (return err)))



      nil)))









^{:go/end 361} (go/method EmitFuncs "EmitFuncs writes out a function-level summary to the writer 'w'. A\nnote on handling function literals: although we collect coverage\ndata for unnamed literals, it probably does not make sense to\ninclude them in the function summary since there isn't any good way\nto name them (this is also consistent with the legacy cmd/cover\nimplementation). We do want to include their counts in the overall\nsummary however.\n" ^error [^{:tag (* Formatter)} fm ^io/Writer w]

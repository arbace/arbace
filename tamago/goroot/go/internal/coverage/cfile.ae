(ns go.internal.coverage.cfile
  (:require [arbace.go :as go]))

(go/package cfile
  :path "internal/coverage/cfile"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["apis.go" "emit.go" "hooks.go" "testsupport.go"]
  :init-order []
  :positions :lines)

(load "cfile/apis")
(load "cfile/emit")
(load "cfile/hooks")
(load "cfile/testsupport")

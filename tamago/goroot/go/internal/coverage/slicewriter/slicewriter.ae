(in-ns 'go.internal.coverage.slicewriter) (go/file "slicewriter.go" :imports [


    ^{:line 8} [fmt "fmt"]
    ^{:line 9} [io "io"]])







(go/type WriteSeeker "WriteSeeker is a helper object that implements the io.WriteSeeker\ninterface. Clients can create a WriteSeeker, make a series of Write\ncalls to add data to it (and possibly Seek calls to update\npreviously written portions), then finally invoke BytesWritten() to\nget a pointer to the constructed byte slice.\n" (struct
    ^{:line 18 :tag (slice byte)} payload
    ^{:line 19 :tag int64} off))


^{:go/end 32} (go/method Write [^{:tag (* WriteSeeker)} sws ^{:tag (slice byte)} p] :results [^int n ^error err]
  (let [amt (len p)
      ^{:line 24} towrite (subslice (.-payload sws) (.-off sws))]
    (when (< (len towrite) amt)
      (set! (.-payload sws) (append (.-payload sws) (spread (make (slice byte) (- amt (len towrite))))))
      (set! towrite (subslice (.-payload sws) (.-off sws))))

    (copy towrite p)
    (set! (.-off sws) + (conv int64 amt))
    (return amt nil)))






^{:go/end 63} (go/method Seek "Seek repositions the read/write position of the WriteSeeker within\nits internally maintained slice. Note that it is not possible to\nexpand the size of the slice using SEEK_SET; trying to seek outside\nthe slice will result in an error.\n" [^{:tag (* WriteSeeker)} sws ^int64 offset ^int whence] :results [int64 error]
  (switch whence
    (case [io/SeekStart]
      (when (and (!= (.-off sws) offset) ^:go/paren (or (< offset 0) (> offset (conv int64 (len (.-payload sws))))))
        (return 0 (fmt/Errorf "invalid seek: new offset %d (out of range [0 %d]" offset (len (.-payload sws)))))

      (set! (.-off sws) offset)
      (return offset nil))
    (case [io/SeekCurrent]
      (let [newoff (+ (.-off sws) offset)]
        (when (and (!= newoff (.-off sws)) ^:go/paren (or (< newoff 0) (> newoff (conv int64 (len (.-payload sws))))))
          (return 0 (fmt/Errorf "invalid seek: new offset %d (out of range [0 %d]" newoff (len (.-payload sws)))))

        (set! (.-off sws) + offset)
        (return (.-off sws) nil)))
    (case [io/SeekEnd]
      (let [newoff (+ (conv int64 (len (.-payload sws))) offset)]
        (when (and (!= newoff (.-off sws)) ^:go/paren (or (< newoff 0) (> newoff (conv int64 (len (.-payload sws))))))
          (return 0 (fmt/Errorf "invalid seek: new offset %d (out of range [0 %d]" newoff (len (.-payload sws)))))

        (set! (.-off sws) newoff)
        (return (.-off sws) nil))))

  ;; other modes not supported
  (return 0 (fmt/Errorf "unsupported seek mode %d" whence)))




^{:go/end 69} (go/method BytesWritten "BytesWritten returns the underlying byte slice for the WriteSeeker,\ncontaining the data written to it via Write/Seek calls.\n" ^{:tag (slice byte)} [^{:tag (* WriteSeeker)} sws]
  (.-payload sws))


^{:go/end 80} (go/method Read [^{:tag (* WriteSeeker)} sws ^{:tag (slice byte)} p] :results [^int n ^error err]
  (let [amt (len p)
      ^{:line 73} toread (subslice (.-payload sws) (.-off sws))]
    (when (< (len toread) amt)
      (set! amt (len toread)))

    (copy p toread)
    (set! (.-off sws) + (conv int64 amt))
    (return amt nil)))

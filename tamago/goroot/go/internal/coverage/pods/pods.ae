(in-ns 'go.internal.coverage.pods) (go/file "pods.go" :imports [


    ^{:line 8} [cmp "cmp"]
    ^{:line 9} [fmt "fmt"]
    ^{:line 10} [coverage "internal/coverage"]
    ^{:line 11} [os "os"]
    ^{:line 12} [filepath "path/filepath"]
    ^{:line 13} [regexp "regexp"]
    ^{:line 14} [slices "slices"]
    ^{:line 15} [strconv "strconv"]
    ^{:line 16} [strings "strings"]])















(go/type Pod "Pod encapsulates a set of files emitted during the executions of a\ncoverage-instrumented binary. Each pod contains a single meta-data\nfile, and then 0 or more counter data files that refer to that\nmeta-data file. Pods are intended to simplify processing of\ncoverage output files in the case where we have several coverage\noutput directories containing output files derived from more\nthan one instrumented executable. In the case where the files that\nmake up a pod are spread out across multiple directories, each\nelement of the \"Origins\" field below will be populated with the\nindex of the originating directory for the corresponding counter\ndata file (within the slice of input dirs handed to CollectPods).\nThe ProcessIDs field will be populated with the process ID of each\ndata file in the CounterDataFiles slice.\n" (struct
    ^{:line 33 :tag string} MetaFile
    ^{:line 34 :tag (slice string)} CounterDataFiles
    ^{:line 35 :tag (slice int)} Origins
    ^{:line 36 :tag (slice int)} ProcessIDs))















^{:go/end 69} (go/func CollectPods "CollectPods visits the files contained within the directories in\nthe list 'dirs', collects any coverage-related files, partitions\nthem into pods, and returns a list of the pods to the caller, along\nwith an error if something went wrong during directory/file\nreading.\n\nCollectPods skips over any file that is not related to coverage\n(e.g. avoids looking at things that are not meta-data files or\ncounter-data files). CollectPods also skips over 'orphaned' counter\ndata files (e.g. counter data files for which we can't find the\ncorresponding meta-data file). If \"warn\" is true, CollectPods will\nissue warnings to stderr when it encounters non-fatal problems (for\norphans or a directory with no meta-data files).\n" [^{:tag (slice string)} dirs ^bool warn] :results [(slice Pod) error]
  (let [files (lit (slice string))
      ^{:line 54} dirIndices (lit (slice int))]
    (range [k dir dirs]
      (let [(values dents err) (os/ReadDir dir)]
        (when (!= err nil)
          (return nil err))

        (range [_ e dents]
          (when (.IsDir e)
            (continue))

          (set! files (append files (filepath/Join dir (.Name e))))
          (set! dirIndices (append dirIndices k)))))


    (return (collectPodsImpl files dirIndices warn) nil)))




^{:go/end 75} (go/func CollectPodsFromFiles "CollectPodsFromFiles functions the same as \"CollectPods\" but\noperates on an explicit list of files instead of a directory.\n" ^{:tag (slice Pod)} [^{:tag (slice string)} files ^bool warn]
  (collectPodsImpl files nil warn))


(go/type fileWithAnnotations (struct
    ^{:line 78 :tag string} file
    ^{:line 79 :tag int} origin
    ^{:line 80 :tag int} pid))


(go/type protoPod (struct
    ^{:line 84 :tag string} mf
    ^{:line 85 :tag (slice fileWithAnnotations)} elements))



































^{:go/end 193} (go/func collectPodsImpl "collectPodsImpl examines the specified list of files and picks out\nsubsets that correspond to coverage pods. The first stage in this\nprocess is collecting a set { M1, M2, ... MN } where each M_k is a\ndistinct coverage meta-data file. We then create a single pod for\neach meta-data file M_k, then find all of the counter data files\nthat refer to that meta-data file (recall that the counter data\nfile name incorporates the meta-data hash), and add the counter\ndata file to the appropriate pod.\n\nThis process is complicated by the fact that we need to keep track\nof directory indices for counter data files. Here is an example to\nmotivate:\n\n\tdirectory 1:\n\nM1   covmeta.9bbf1777f47b3fcacb05c38b035512d6\nC1   covcounters.9bbf1777f47b3fcacb05c38b035512d6.1677673.1662138360208416486\nC2   covcounters.9bbf1777f47b3fcacb05c38b035512d6.1677637.1662138359974441782\n\n\tdirectory 2:\n\nM2   covmeta.9bbf1777f47b3fcacb05c38b035512d6\nC3   covcounters.9bbf1777f47b3fcacb05c38b035512d6.1677445.1662138360208416480\nC4   covcounters.9bbf1777f47b3fcacb05c38b035512d6.1677677.1662138359974441781\nM3   covmeta.a723844208cea2ae80c63482c78b2245\nC5   covcounters.a723844208cea2ae80c63482c78b2245.3677445.1662138360208416480\nC6   covcounters.a723844208cea2ae80c63482c78b2245.1877677.1662138359974441781\n\nIn these two directories we have three meta-data files, but only\ntwo are distinct, meaning that we'll wind up with two pods. The\nfirst pod (with meta-file M1) will have four counter data files\n(C1, C2, C3, C4) and the second pod will have two counter data files\n(C5, C6).\n" ^{:tag (slice Pod)} [^{:tag (slice string)} files ^{:tag (slice int)} dirIndices ^bool warn]
  (let [metaRE (regexp/MustCompile (fmt/Sprintf "^%s\\.(\\S+)$" coverage/MetaFilePref))
      ^{:line 123} mm (make (map string protoPod))]
    (range [_ f files]
      (let [base (filepath/Base f)]
        (when [m (.FindStringSubmatch metaRE base)] (!= m nil)
          (let [tag (aget m 1)]
            ;; We need to allow for the possibility of duplicate
            ;; meta-data files. If we hit this case, use the
            ;; first encountered as the canonical version.
            (when [(values _ ok) (aget mm tag)] (not ok)
              (aset mm tag (lit protoPod :mf f)))))))

    ;; FIXME: should probably check file length and hash here for
    ;; the duplicate.


    (let [counterRE (regexp/MustCompile (fmt/Sprintf coverage/CounterFileRegexp coverage/CounterFilePref))]
      (range [k f files]
        (let [base (filepath/Base f)]
          (when [m (.FindStringSubmatch counterRE base)] (!= m nil)
            (let [tag (aget m 1) ; meta hash
                (values pid err) (strconv/Atoi (aget m 2))]
              (when (!= err nil)
                (continue))

              (if [(values v ok) (aget mm tag)] ok
                (let [idx -1]
                  (when (!= dirIndices nil)
                    (set! idx (aget dirIndices k)))

                  (let [fo (lit fileWithAnnotations :file f :origin idx :pid pid)]
                    (set! (.-elements v) (append (.-elements v) fo))
                    (aset mm tag v)))
                (do
                  (when warn
                    (warning "skipping orphaned counter file: %s" f))))))))




      (when (== (len mm) 0)
        (when warn
          (warning "no coverage data files found"))

        (return nil))

      (let [pods (make (slice Pod) 0 (len mm))]
        (range [_ p mm]
          (^{:inst [(slice fileWithAnnotations) fileWithAnnotations]} slices/SortFunc (.-elements p) ^{:go/end 175} (fn ^int [^fileWithAnnotations a ^fileWithAnnotations b]
              (when [r (^{:inst [int]} cmp/Compare (.-origin a) (.-origin b))] (!= r 0)
                (return r))

              (strings/Compare (.-file a) (.-file b))))

          (let [pod ^{:go/breaks [2 4 6 8]} (lit Pod
                :MetaFile (.-mf p)
                :CounterDataFiles (make (slice string) 0 (len (.-elements p)))
                :Origins (make (slice int) 0 (len (.-elements p)))
                :ProcessIDs (make (slice int) 0 (len (.-elements p))))]

            (range [_ e (.-elements p)]
              (set! (.-CounterDataFiles pod) (append (.-CounterDataFiles pod) (.-file e)))
              (set! (.-Origins pod) (append (.-Origins pod) (.-origin e)))
              (set! (.-ProcessIDs pod) (append (.-ProcessIDs pod) (.-pid e))))

            (set! pods (append pods pod))))

        (^{:inst [(slice Pod) Pod]} slices/SortFunc pods ^{:go/end 191} (fn ^int [^Pod a ^Pod b]
            (strings/Compare (.-MetaFile a) (.-MetaFile b))))

        ^{:line 192} pods))))


^{:go/end 199} (go/func warning [^string s & ^{:tag (slice any)} a]
  (fmt/Fprintf os/Stderr "warning: ")
  (fmt/Fprintf os/Stderr s (spread a))
  (fmt/Fprintf os/Stderr "\n"))

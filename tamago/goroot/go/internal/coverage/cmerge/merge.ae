^{:go/end 58} (go/method MergeCounters "MergeCounters takes the counter values in 'src' and merges them\ninto 'dst' according to the correct counter mode.\n" [^{:tag (* Merger)} m ^{:tag (slice uint32)} dst ^{:tag (slice uint32)} src] :results [error bool]
  (when (!= (len src) (len dst))
    (return (fmt/Errorf "merging counters: len(dst)=%d len(src)=%d" (len dst) (len src)) false))

  (if (== (.-cmode m) coverage/CtrModeSet)
    (for [i 0] (< i (len src)) (inc! i)
      (when (!= (aget src i) 0)
        (aset dst i 1)))



    (for [i 0] (< i (len src)) (inc! i)
      (aset dst i (.SaturatingAdd m (aget dst i) (aget src i)))))


  (let [ovf (.-overflow m)]
    (set! (.-overflow m) false)
    (return nil ovf)))





^{:go/end 69} (go/method SaturatingAdd "SaturatingAdd does a saturating addition of 'dst' and 'src',\nreturning added value or math.MaxUint32 if there is an overflow.\nOverflows are recorded in case the client needs to track them.\n" ^uint32 [^{:tag (* Merger)} m ^uint32 dst ^uint32 src]
  (let [(values result overflow) (SaturatingAdd dst src)]
    (when overflow
      (set! (.-overflow m) true))

    ^{:line 68} result))




^{:go/end 82} (go/func SaturatingAdd "SaturatingAdd does a saturating addition of 'dst' and 'src',\nreturning added value or math.MaxUint32 plus an overflow flag.\n" [^uint32 dst ^uint32 src] :results [uint32 bool]
  (let [(values d s) (values (conv uint64 dst) (conv uint64 src))
      ^{:line 75} sum (+ d s)
      ^{:line 76} overflow false]
    (when (!= (conv uint64 (conv uint32 sum)) sum)
      (set! overflow true)
      (set! sum math/MaxUint32))

    (return (conv uint32 sum) overflow)))







^{:go/breaks [[5 112]] :go/end 113} (go/method SetModeAndGranularity "SetModeAndGranularity records the counter mode and granularity for\nthe current merge. In the specific case of merging across coverage\ndata files from different binaries, where we're combining data from\nmore than one meta-data file, we need to check for and resolve\nmode/granularity clashes.\n" ^error [^{:tag (* Merger)} cm ^string mdf ^coverage/CounterMode cmode ^coverage/CounterGranularity cgran]
  (if (== (.-cmode cm) coverage/CtrModeInvalid) (do
      ;; Set merger mode based on what we're seeing here.
      (set! (.-cmode cm) cmode)
      (set! (.-cgran cm) cgran))
    (do
      ;; Granularity clashes are always errors.
      (when (!= (.-cgran cm) cgran)
        (return (fmt/Errorf "counter granularity clash while reading meta-data file %s: previous file had %s, new file has %s" mdf (.String (.-cgran cm)) (.String cgran))))

      ;; Mode clashes are treated as errors if we're using the
      ;; default strict policy.
      (when (!= (.-cmode cm) cmode)
        (when (== (.-policy cm) ModeMergeStrict)
          (return (fmt/Errorf "counter mode clash while reading meta-data file %s: previous file had %s, new file has %s" mdf (.String (.-cmode cm)) (.String cmode))))

        ;; In the case of a relaxed mode merge policy, upgrade
        ;; mode if needed.
        (when (< (.-cmode cm) cmode)
          (set! (.-cmode cm) cmode)))))



  nil)


^{:go/end 119} (go/method ResetModeAndGranularity [^{:tag (* Merger)} cm]
  (set! (.-cmode cm) coverage/CtrModeInvalid)
  (set! (.-cgran cm) coverage/CtrGranularityInvalid)
  (set! (.-overflow cm) false))


^{:go/end 123} (go/method Mode ^coverage/CounterMode [^{:tag (* Merger)} cm]
  (.-cmode cm))


^{:go/end 127} (go/method Granularity ^coverage/CounterGranularity [^{:tag (* Merger)} cm]

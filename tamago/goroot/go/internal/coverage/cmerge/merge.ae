(go/const
  ^{:line 19} [^{:tag ModeMergePolicy :val 0} ModeMergeStrict iota]
  ^{:line 20} [^{:val 1} ModeMergeRelaxed])






(go/type Merger "Merger provides state and methods to help manage the process of\nmerging together coverage counter data for a given function, for\ntools that need to implicitly merge counter as they read multiple\ncoverage counter data files.\n" (struct
    ^{:line 28 :tag coverage/CounterMode} cmode

    (when (.-debug r)
      (fmt/Fprintf os/Stderr "=-= for pk %d, off=%d len=%d\n" pkIdx off len))


    (when (!= (.-fileView r) nil)
      (return (subslice (.-fileView r) off (+ off len)) nil))


    (let [payload (subslice payloadbuf _ 0)]
      (when (< (cap payload) (conv int len))

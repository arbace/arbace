  (let [^error err (zero error)]

    (set! (.-fileRdr r) (bufio/NewReader (.-f r)))

    ;; Read file header.
    (when [err (binary/Read (.-fileRdr r) binary/LittleEndian (addr (.-hdr r)))] (!= err nil)
      (return err))


    ;; Verify magic string
    (let [m (.-Magic (.-hdr r))
        ^{:line 70} g coverage/CovMetaMagic]
      (when (or (!= (aget m 0) (aget g 0)) (!= (aget m 1) (aget g 1)) (!= (aget m 2) (aget g 2)) (!= (aget m 3) (aget g 3)))
        (return (fmt/Errorf "invalid meta-data file magic string")))


      ;; Vet the version. If this is a meta-data file from the future,
      ;; we won't be able to read it.
      (when (> (.-Version (.-hdr r)) coverage/MetaFileVersion)
        (return (fmt/Errorf "meta-data file with an unknown version %d (expected %d)" (.-Version (.-hdr r)) coverage/MetaFileVersion)))


      ;; Read package offsets for good measure
      (set! (.-pkgOffsets r) (make (slice uint64) (.-Entries (.-hdr r))))
      (for [i (conv uint64 0)] (< i (.-Entries (.-hdr r))) (inc! i)
        (when [(set! (values (aget (.-pkgOffsets r) i) err) (.rdUint64 r))] (!= err nil)
          (return err))

        (when (> (aget (.-pkgOffsets r) i) (.-TotalLength (.-hdr r)))
          (return (fmt/Errorf "insane pkg offset %d: %d > totlen %d"
              ^{:line 89} i (aget (.-pkgOffsets r) i) (.-TotalLength (.-hdr r))))))


      (set! (.-pkgLengths r) (make (slice uint64) (.-Entries (.-hdr r))))
      (for [i (conv uint64 0)] (< i (.-Entries (.-hdr r))) (inc! i)
        (when [(set! (values (aget (.-pkgLengths r) i) err) (.rdUint64 r))] (!= err nil)
          (return err))

        (when (> (aget (.-pkgLengths r) i) (.-TotalLength (.-hdr r)))
          (return (fmt/Errorf "insane pkg length %d: %d > totlen %d"
              ^{:line 99} i (aget (.-pkgLengths r) i) (.-TotalLength (.-hdr r))))))



      ;; Read string table.
      (let [b (make (slice byte) (.-StrTabLength (.-hdr r)))
          (values nr ^:assign err) (.Read (.-fileRdr r) b)]
        (when (!= err nil)
          (return err))

        (when (!= nr (conv int (.-StrTabLength (.-hdr r))))
          (return (fmt/Errorf "error: short read on string table")))

        ^{:go/breaks [[5 120]]} (let [slr (slicereader/NewReader b false)] ; /* not readonly */
          (set! (.-strtab r) (stringtab/NewReader slr))
          (.Read (.-strtab r))

          (when (.-debug r)
            (fmt/Fprintf os/Stderr "=-= read-in header is: %+v\n" @r))


          nil)))))


^{:go/end 135} (go/method rdUint64 [^{:tag (* CoverageMetaFileReader)} r] :results [uint64 error]
  (set! (.-tmp r) (subslice (.-tmp r) _ 0))
  (set! (.-tmp r) (append (.-tmp r) (spread (make (slice byte) 8))))
  (let [(values n err) (.Read (.-fileRdr r) (.-tmp r))]
    (when (!= err nil)
      (return 0 err))

    (when (!= n 8)
      (return 0 (fmt/Errorf "premature end of file on read")))

    (let [v (.Uint64 binary/LittleEndian (.-tmp r))]
      (return v nil))))





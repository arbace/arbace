  (.-Entries (.-hdr r)))





^{:go/end 148} (go/method CounterMode "CounterMode returns the counter mode (set, count, atomic) used\nwhen building for coverage for the program that produce this\nmeta-data file.\n" ^coverage/CounterMode [^{:tag (* CoverageMetaFileReader)} r]

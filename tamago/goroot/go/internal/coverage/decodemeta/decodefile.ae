      (return nil nil err))

    (let [(values mdd ^:assign err) (NewCoverageMetaDataDecoder pp (!= (.-fileView r) nil))]
      (when (!= err nil)
        (return nil nil err))

      (return mdd pp nil))))









^{:go/end 225} (go/method GetPackagePayload "GetPackagePayload returns the raw (encoded) meta-data payload for the\npackage with index 'pkIdx'. As with GetPackageDecoder, if the\nCoverageMetaFileReader was set up with a read-only file view, a\npointer into that file view will be returned, otherwise the buffer\n'payloadbuf' will be written to (or if it is not of sufficient\nsize, a new buffer will be allocated). Return value is the decoder,\na byte slice with the encoded meta-data, and an error.\n" [^{:tag (* CoverageMetaFileReader)} r ^uint32 pkIdx ^{:tag (slice byte)} payloadbuf] :results [(slice byte) error]


    ^{:line 28 :tag (* os/File)} f
    ^{:line 29 :tag coverage/MetaFileHeader} hdr
    ^{:line 30 :tag (slice byte)} tmp
    ^{:line 31 :tag (slice uint64)} pkgOffsets
    ^{:line 32 :tag (slice uint64)} pkgLengths
    ^{:line 33 :tag (* stringtab/Reader)} strtab
    ^{:line 34 :tag (* bufio/Reader)} fileRdr
    ^{:line 35 :tag (slice byte)} fileView
    ^{:line 36 :tag bool} debug))









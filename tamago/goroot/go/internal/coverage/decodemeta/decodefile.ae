      (set! payload (append payload (spread (make (slice byte) len))))
      (when [(values _ err) (.Seek (.-f r) (conv int64 off) io/SeekStart)] (!= err nil)
        (return nil err))

      (when [(values _ err) (io/ReadFull (.-f r) payload)] (!= err nil)

    (when (.-debug r)
      (let [h (fnv/New128a)]
        (.Write h pp)
        (fmt/Fprintf os/Stderr "=-= pkidx=%d payload length is %d hash=%s\n"
          ^{:line 177} pkIdx (len pp) (fmt/Sprintf "%x" (.Sum h nil)))))


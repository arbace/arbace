  (let [r (addr ^{:go/breaks [2 4 6]} (lit CoverageMetaFileReader
          :f f
          :fileView fileView
          :tmp (make (slice byte) 256)))]


    (when [err (.readFileHeader r)] (!= err nil)
      (return nil err))

    (return r nil)))



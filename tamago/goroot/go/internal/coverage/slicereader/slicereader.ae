(in-ns 'go.internal.coverage.slicereader) (go/file "slicereader.go" :imports [


    ^{:line 8} [binary "encoding/binary"]
    ^{:line 9} [fmt "fmt"]
    ^{:line 10} [io "io"]
    ^{:line 11} [unsafe "unsafe"]])


;; This file contains the helper "SliceReader", a utility for
;; reading values from a byte slice that may or may not be backed
;; by a read-only mmap'd region.

(go/type Reader (struct
    ^{:line 19 :tag (slice byte)} b
    ^{:line 20 :tag bool} readonly
    ^{:line 21 :tag int64} off))


^{:go/end 30} (go/func NewReader ^{:tag (* Reader)} [^{:tag (slice byte)} b ^bool readonly]
  (let [r ^{:go/breaks [2 4]} (lit Reader
        :b b
        :readonly readonly)]

    (addr r)))


^{:go/end 41} (go/method Read [^{:tag (* Reader)} r ^{:tag (slice byte)} b] :results [int error]
  (let [amt (len b)
      ^{:line 34} toread (subslice (.-b r) (.-off r))]
    (when (< (len toread) amt)
      (set! amt (len toread)))

    (copy b toread)
    (set! (.-off r) + (conv int64 amt))
    (return amt nil)))


^{:go/end 68} (go/method Seek [^{:tag (* Reader)} r ^int64 offset ^int whence] :results [^int64 ret ^error err]
  (switch whence
    (case [io/SeekStart]
      (when (or (< offset 0) (> offset (conv int64 (len (.-b r)))))
        (return 0 (fmt/Errorf "invalid seek: new offset %d (out of range [0 %d]" offset (len (.-b r)))))

      (set! (.-off r) offset)
      (return offset nil))
    (case [io/SeekCurrent]
      (let [newoff (+ (.-off r) offset)]
        (when (or (< newoff 0) (> newoff (conv int64 (len (.-b r)))))
          (return 0 (fmt/Errorf "invalid seek: new offset %d (out of range [0 %d]" newoff (len (.-b r)))))

        (set! (.-off r) newoff)
        (return (.-off r) nil)))
    (case [io/SeekEnd]
      (let [newoff (+ (conv int64 (len (.-b r))) offset)]
        (when (or (< newoff 0) (> newoff (conv int64 (len (.-b r)))))
          (return 0 (fmt/Errorf "invalid seek: new offset %d (out of range [0 %d]" newoff (len (.-b r)))))

        (set! (.-off r) newoff)
        (return (.-off r) nil))))

  ;; other modes are not supported
  (return 0 (fmt/Errorf "unsupported seek mode %d" whence)))


^{:go/end 72} (go/method Offset ^int64 [^{:tag (* Reader)} r]
  (.-off r))


^{:go/end 78} (go/method ReadUint8 ^uint8 [^{:tag (* Reader)} r]
  (let [rv (conv uint8 (aget (.-b r) (conv int (.-off r))))]
    (set! (.-off r) + 1)
    ^{:line 77} rv))


^{:go/end 85} (go/method ReadUint32 ^uint32 [^{:tag (* Reader)} r]
  (let [end (+ (conv int (.-off r)) 4)
      ^{:line 82} rv (.Uint32 binary/LittleEndian (subslice (.-b r) (conv int (.-off r)) end end))]
    (set! (.-off r) + 4)
    ^{:line 84} rv))


^{:go/end 92} (go/method ReadUint64 ^uint64 [^{:tag (* Reader)} r]
  (let [end (+ (conv int (.-off r)) 8)
      ^{:line 89} rv (.Uint64 binary/LittleEndian (subslice (.-b r) (conv int (.-off r)) end end))]
    (set! (.-off r) + 8)
    ^{:line 91} rv))


^{:go/end 107} (go/method ReadULEB128 [^{:tag (* Reader)} r] :results [^uint64 value]
  (let [^uint shift (zero uint)]

    (while true
      (let [b (aget (.-b r) (.-off r))]
        (inc! (.-off r))
        (set! value bit-or (<< (conv uint64 (bit-and b 0x7F)) shift))
        (when (== (bit-and b 0x80) 0)
          (break))

        (set! shift + 7)))

    (return)))


^{:go/end 116} (go/method ReadString ^string [^{:tag (* Reader)} r ^int64 len]
  (let [b (subslice (.-b r) (.-off r) (+ (.-off r) len))]
    (set! (.-off r) + len)
    (when (.-readonly r)
      (return (toString b))) ; backed by RO memory, ok to make unsafe string

    (conv string b)))


^{:go/end 123} (go/func toString ^string [^{:tag (slice byte)} b]
  (when (== (len b) 0)
    (return ""))

  (unsafe/String (addr (aget b 0)) (len b)))

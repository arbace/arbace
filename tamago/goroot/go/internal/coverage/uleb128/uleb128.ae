(in-ns 'go.internal.coverage.uleb128) (go/file "uleb128.go" :imports [])

^{:go/end 20} (go/func AppendUleb128 ^{:tag (slice byte)} [^{:tag (slice byte)} b ^uint v]
  (while true
    (let [c (conv uint8 (bit-and v 0x7f))]
      (set! v >> 7)
      (when (!= v 0)
        (set! c bit-or 0x80))

      (set! b (append b c))
      (when (== (bit-and c 0x80) 0)
        (break))))


  ^{:line 19} b)

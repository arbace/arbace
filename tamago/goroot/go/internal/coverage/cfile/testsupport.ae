^{:go/end 273} (go/method readAuxMetaFiles ^error [^{:tag (* tstate)} ts ^string metafiles ^{:tag (map string (struct))} importpaths]
  ;; Unmarshal the information on available aux metafiles into
  ;; a MetaFileCollection struct.
  ^{:go/breaks [[5 272]]} (let [^coverage/MetaFileCollection mfc (zero coverage/MetaFileCollection)
      (values data err) (os/ReadFile metafiles)]
    (when (!= err nil)
      (return (fmt/Errorf "error reading auxmetafiles file %q: %v" metafiles err)))

    (when [err (json/Unmarshal data (addr mfc))] (!= err nil)
      (return (fmt/Errorf "error reading auxmetafiles file %q: %v" metafiles err)))


    ;; Walk through each available aux meta-file. If we've already
    ;; seen the package path in question during the walk of the
    ;; "regular" meta-data file, then we can skip the package,
    ;; otherwise construct a dummy pod with the single meta-data file
    ;; (no counters) and invoke processPod on it.
    (range [i (.-ImportPaths mfc)]
      (let [p (aget (.-ImportPaths mfc) i)]
        (when [(values _ ok) (aget importpaths p)] ok
          (continue))

        (let [^pods/Pod pod (zero pods/Pod)]
          (set! (.-MetaFile pod) (aget (.-MetaFileFragments mfc) i))
          (when [err (.processPod ts pod importpaths)] (!= err nil)
            (return err)))))


    nil))








^{:go/end 318} (go/func Snapshot "Snapshot returns a snapshot of coverage percentage at a moment of\ntime within a running test, so as to support the testing.Coverage()\nfunction. This version doesn't examine coverage meta-data, so the\nresult it returns will be less accurate (more \"slop\") due to the\nfact that we don't look at the meta data to see how many statements\nare associated with each counter.\n" ^float64 []
  (let [cl (getCovCounterList)]
    (when (== (len cl) 0)
      ;; no work to do here.
      (return 0.0))


    (let [tot (conv uint64 0)
        ^{:line 289} totExec (conv uint64 0)]
      (range [_ c cl]
        (let [sd (unsafe/Slice (conv (* atomic/Uint32) (conv unsafe/Pointer (.-Counters c))) (.-Len c))]
          (set! tot + (conv uint64 (len sd)))
          (for [i 0] (< i (len sd)) (inc! i)
            ;; Skip ahead until the next non-zero value.
            (when (== (.Load (aget sd i)) 0)
              (continue))

            ;; We found a function that was executed.
            (let [nCtrs (.Load (aget sd (+ i coverage/NumCtrsOffset)))
                ^{:line 300} cst (+ i coverage/FirstCtrOffset)]

              (when (> (+ cst (conv int nCtrs)) (len sd))
                (break))

              (let [counters (subslice sd cst (+ cst (conv int nCtrs)))]
                (range [i counters]
                  (when (!= (.Load (aget counters i)) 0)
                    (inc! totExec)))


                (set! i + (- (+ coverage/FirstCtrOffset (conv int nCtrs)) 1)))))))


      (when (== tot 0)
        (return 0.0))

      (/ (conv float64 totExec) (conv float64 tot)))))

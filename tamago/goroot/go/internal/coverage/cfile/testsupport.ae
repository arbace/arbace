                (when [err (.EmitTextual (.-cf ts) selpkgs tf)] (!= err nil)
                  (return err))

                (set! tfClosed true)
                (when [err (.Close tf)] (!= err nil)
                  (return (fmt/Errorf "closing %s: %v" cfile err))))



              nil)))))))



  (let [cmode (coverage/ParseCounterMode cm)]
    (when (== cmode coverage/CtrModeInvalid)
      (return (fmt/Errorf "invalid counter mode %q" cm)))


    ;; Emit meta-data and counter data.
    (let [ml (.-List rtcov/Meta)]

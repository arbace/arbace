^{:go/end 145} (go/func emitMetaData "emitMetaData emits the meta-data output file for this coverage run.\nThis entry point is intended to be invoked by the compiler from\nan instrumented program's main package init func.\n" []
  (when covProfileAlreadyEmitted
    (return))

  (let [(values ml err) (prepareForMetaEmit)]
    (when (!= err nil)
      (fmt/Fprintf os/Stderr "error: coverage meta-data prep failed: %v\n" err)
      (when (!= (os/Getenv "GOCOVERDEBUG") "")
        (panic "meta-data write failure")))


    (when (== (len ml) 0)
      (fmt/Fprintf os/Stderr "program not built with -cover\n")
      (return))


    (set! goCoverDir (os/Getenv "GOCOVERDIR"))
    (when (== goCoverDir "")
      (fmt/Fprintf os/Stderr "warning: GOCOVERDIR not set, no coverage data emitted\n")
      (return))


    (when [err (emitMetaDataToDirectory goCoverDir ml)] (!= err nil)
      (fmt/Fprintf os/Stderr "error: coverage meta-data emit failed: %v\n" err)
      (when (!= (os/Getenv "GOCOVERDEBUG") "")
        (panic "meta-data write failure")))))





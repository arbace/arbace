            :metalist ml
            :debug (!= (os/Getenv "GOCOVERDEBUG") "")))]


      ;; Capture os.Args() now so as to avoid issues if args
      ;; are rewritten during program execution.
      (set! capturedOsArgs (captureOsArgs))

      (when (.-debug s)
        (fmt/Fprintf os/Stderr "=+= GOCOVERDIR is %s\n" (os/Getenv "GOCOVERDIR"))
        (fmt/Fprintf os/Stderr "=+= contents of covmetalist:\n")
        (range [k b ml]
          (fmt/Fprintf os/Stderr "=+= slot: %d path: %s " k (.-PkgPath b))
          (when (!= (.-PkgID b) -1)
            (fmt/Fprintf os/Stderr " hcid: %d" (.-PkgID b)))

          (fmt/Fprintf os/Stderr "\n"))

        (let [pm (.-PkgMap rtcov/Meta)]
          (fmt/Fprintf os/Stderr "=+= remap table:\n")
          (range [from to pm]
            (fmt/Fprintf os/Stderr "=+= from %d to %d\n"
              (conv uint32 from) (conv uint32 to)))))



      (let [h (fnv/New128a)
          ^{:line 210} tlen (conv uint64 (unsafe/Sizeof (lit coverage/MetaFileHeader)))]
        (range [_ entry ml]
          (when [(values _ err) (.Write h (subslice (.-Hash entry)))] (!= err nil)
            (return nil err))

          (set! tlen + (conv uint64 (.-Len entry)))
          (let [ecm (conv coverage/CounterMode (.-CounterMode entry))]
            (when (modeClash ecm)
              (return nil (fmt/Errorf "coverage counter mode clash: package %s uses mode=%d, but package %s uses mode=%s\n" (.-PkgPath (aget ml 0)) cmode (.-PkgPath entry) ecm)))

            (let [ecg (conv coverage/CounterGranularity (.-CounterGranularity entry))]
              (when (granClash ecg)
                (return nil (fmt/Errorf "coverage counter granularity clash: package %s uses gran=%d, but package %s uses gran=%s\n" (.-PkgPath (aget ml 0)) cgran (.-PkgPath entry) ecg))))))



        ;; Hash mode and granularity as well.
        (.Write h (conv (slice byte) (.String cmode)))
        (.Write h (conv (slice byte) (.String cgran)))

        ;; Compute final digest.
        (let [fh (.Sum h nil)]
          (copy (subslice finalHash) fh)
          (set! finalHashComputed true)
          (set! finalMetaLen tlen)

          (return ml nil))))))





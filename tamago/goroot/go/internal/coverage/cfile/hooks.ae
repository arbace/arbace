(in-ns 'go.internal.coverage.cfile) (go/file "hooks.go" :imports [

    ^{:line 7} [exithook "internal/runtime/exithook"]])




















^{:go/end 38} (go/func InitHook "InitHook is invoked from the main package \"init\" routine in\nprograms built with \"-cover\". This function is intended to be\ncalled only by the compiler (via runtime/coverage.initHook).\n\nIf 'istest' is false, it indicates we're building a regular program\n(\"go build -cover ...\"), in which case we immediately try to write\nout the meta-data file, and register emitCounterData as an exit\nhook.\n\nIf 'istest' is true (indicating that the program in question is a\nGo test binary), then we tentatively queue up both emitMetaData and\nemitCounterData as exit hooks. In the normal case (e.g. regular \"go\ntest -cover\" run) the testmain.go boilerplate will run at the end\nof the test, write out the coverage percentage, and then invoke\nMarkProfileEmitted to indicate that no more work needs to be\ndone. If however that call is never made, this is a sign that the\ntest binary is being used as a replacement binary for the tool\nbeing tested, hence we do want to run exit hooks when the program\nterminates.\n" [^bool istest]
  ;; Note: hooks are run in reverse registration order, so
  ;; register the counter data hook before the meta-data hook
  ;; (in the case where two hooks are needed).
  (exithook/Add (lit exithook/Hook :F emitCounterData :RunOnFailure true))
  (if istest
    (exithook/Add (lit exithook/Hook :F emitMetaData :RunOnFailure true))

    (emitMetaData)))

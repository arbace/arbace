(in-ns 'go.internal.coverage.rtcov) (go/file "rtcov.go" :imports [

    ^{:line 7} [unsafe "unsafe"]])

;; This package contains types whose structure is shared between
;; the runtime package and the "runtime/coverage" implementation.








(go/type CovMetaBlob "CovMetaBlob is a container for holding the meta-data symbol (an\nRODATA variable) for an instrumented Go package. Here \"p\" points to\nthe symbol itself, \"len\" is the length of the sym in bytes, and\n\"hash\" is an md5sum for the sym computed by the compiler. When\nthe init function for a coverage-instrumented package executes, it\nwill make a call into the runtime which will create a covMetaBlob\nobject for the package and chain it onto a global list.\n" (struct
    ^{:line 20 :tag (* byte)} P
    ^{:line 21 :tag uint32} Len
    ^{:line 22 :tag (array 16 byte)} Hash
    ^{:line 23 :tag string} PkgPath
    ^{:line 24 :tag int} PkgID
    ^{:line 25 :tag uint8} CounterMode ; coverage.CounterMode
    ^{:line 26 :tag uint8} CounterGranularity)) ; coverage.CounterGranularity






(go/type CovCounterBlob "CovCounterBlob is a container for encapsulating a counter section\n(BSS variable) for an instrumented Go module. Here \"counters\"\npoints to the counter payload and \"len\" is the number of uint32\nentries in the section.\n" (struct
    ^{:line 34 :tag (* uint32)} Counters
    ^{:line 35 :tag uint64} Len))




(go/var ^{:tag (struct ^{:tag (slice CovMetaBlob) :doc "List contains the list of currently registered meta-data\nblobs for the running program.\n"} List ^{:tag (map int int) :doc "PkgMap records mappings from hard-coded package IDs to\nslots in the List above.\n"} PkgMap ^{:tag bool :doc "Set to true if we discover a package mapping glitch.\n"} hardCodedListNeedsUpdating) :doc "Meta is the top-level container for bits of state related to\ncode coverage meta-data in the runtime.\n"} Meta)






















^{:go/end 88} (go/func AddMeta "AddMeta is invoked during package \"init\" functions by the\ncompiler when compiling for coverage instrumentation; here 'p' is a\nmeta-data blob of length 'dlen' for the package in question, 'hash'\nis a compiler-computed md5.sum for the blob, 'pkpath' is the\npackage path, 'pkid' is the hard-coded ID that the compiler is\nusing for the package (or -1 if the compiler doesn't think a\nhard-coded ID is needed), and 'cmode'/'cgran' are the coverage\ncounter mode and granularity requested by the user. Return value is\nthe ID for the package for use by the package code itself,\nor 0 for impossible errors.\n" ^uint32 [^unsafe/Pointer p ^uint32 dlen ^{:tag (array 16 byte)} hash ^string pkgpath ^int pkgid ^uint8 cmode ^uint8 cgran]
  (let [slot (len (.-List Meta))]
    (set! (.-List Meta) (append (.-List Meta) ^{:go/breaks [2 4 6 8 10 12 14]} (lit CovMetaBlob
          :P (conv (* byte) p)
          :Len dlen
          :Hash hash
          :PkgPath pkgpath
          :PkgID pkgid
          :CounterMode cmode
          :CounterGranularity cgran)))

    (when (!= pkgid -1)
      (when (== (.-PkgMap Meta) nil)
        (set! (.-PkgMap Meta) (make (map int int))))

      (when [(values _ ok) (aget (.-PkgMap Meta) pkgid)] ok
        (return 0))

      ;; Record the real slot (position on meta-list) for this
      ;; package; we'll use the map to fix things up later on.
      (aset (.-PkgMap Meta) pkgid slot))


    ;; ID zero is reserved as invalid.
    (conv uint32 (+ slot 1))))

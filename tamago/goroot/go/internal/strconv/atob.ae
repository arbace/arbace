(in-ns 'go.internal.strconv) (go/file "atob.go" :imports [])




^{:go/end 18} (go/func ParseBool "ParseBool returns the boolean value represented by the string.\nIt accepts 1, t, T, TRUE, true, True, 0, f, F, FALSE, false, False.\nAny other value returns an error.\n" [^string str] :results [bool error]
  (switch str
    (case ["1" "t" "T" "true" "TRUE" "True"]
      (return true nil))
    (case ["0" "f" "F" "false" "FALSE" "False"]
      (return false nil)))

  (return false ErrSyntax))



^{:go/breaks [[5 25]] :go/end 26} (go/func FormatBool "FormatBool returns \"true\" or \"false\" according to the value of b.\n" ^string [^bool b]
  (when b
    (return "true"))

  "false")




^{:go/end 35} (go/func AppendBool "AppendBool appends \"true\" or \"false\", according to the value of b,\nto dst and returns the extended buffer.\n" ^{:tag (slice byte)} [^{:tag (slice byte)} dst ^bool b]
  (when b
    (return (append dst (spread "true"))))

  (append dst (spread "false")))

(in-ns 'go.internal.strconv) (go/file "atoc.go" :imports [])





















^{:go/end 88} (go/func ParseComplex "ParseComplex converts the string s to a complex number\nwith the precision specified by bitSize: 64 for complex64, or 128 for complex128.\nWhen bitSize=64, the result still has type complex128, but it will be\nconvertible to complex64 without changing its value.\n\nThe number represented by s must be of the form N, Ni, or N±Ni, where N stands\nfor a floating-point number as recognized by [ParseFloat], and i is the imaginary\ncomponent. If the second N is unsigned, a + sign is required between the two components\nas indicated by the ±. If the second N is NaN, only a + sign is accepted.\nThe form may be parenthesized and cannot contain any spaces.\nThe resulting complex number consists of the two components converted by ParseFloat.\n\nThe errors that ParseComplex returns have concrete type [*NumError]\nand include err.Num = s.\n\nIf s is not syntactically well-formed, ParseComplex returns err.Err = ErrSyntax.\n\nIf s is syntactically well-formed but either component is more than 1/2 ULP\naway from the largest floating point number of the given component's size,\nParseComplex returns err.Err = ErrRange and c = ±Inf for the respective component.\n" [^string s ^int bitSize] :results [complex128 error]
  (let [size 64]
    (when (== bitSize 64)
      (set! size 32)) ; complex64 uses float32 parts


    ;; Remove parentheses, if any.
    (when (and (>= (len s) 2) (== (aget s 0) \() (== (aget s (- (len s) 1)) \)))
      (set! s (subslice s 1 (- (len s) 1))))


    (let [^error pending (zero error) ; pending range error, or nil

        ;; Read real part (possibly imaginary part if followed by 'i').
        (values re n err) (parseFloatPrefix s size)]
      (when (!= err nil)
        (when (!= err ErrRange)
          (return 0 err))

        (set! pending err))

      (set! s (subslice s n))

      ;; If we have nothing left, we're done.
      (when (== (len s) 0)
        (return (complex re 0) pending))


      ;; Otherwise, look at the next character.
      (switch (aget s 0)
        (case [\+]
          ;; Consume the '+' to avoid an error if we have "+NaNi", but
          ;; do this only if we don't have a "++" (don't hide that error).
          (when (and (> (len s) 1) (!= (aget s 1) \+))
            (set! s (subslice s 1))))

        (case [\-])
        ;; ok
        (case [\i]
          ;; If 'i' is the last character, we only have an imaginary part.
          (when (== (len s) 1)
            (return (complex 0 re) pending))

          (fallthrough))
        (default
          (return 0 ErrSyntax)))


      ;; Read imaginary part.
      (let [(values im ^:assign n ^:assign err) (parseFloatPrefix s size)]
        (when (!= err nil)
          (when (!= err ErrRange)
            (return 0 err))

          (set! pending err))

        (set! s (subslice s n))
        (when (!= s "i")
          (return 0 ErrSyntax))

        (return (complex re im) pending)))))

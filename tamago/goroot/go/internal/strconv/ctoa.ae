(in-ns 'go.internal.strconv) (go/file "ctoa.go" :imports [])








^{:go/end 17} (go/func FormatComplex "FormatComplex converts the complex number c to a string of the\nform (a+bi) where a and b are the real and imaginary parts,\nformatted according to the format fmt and precision prec.\n\nThe format fmt and precision prec have the same meaning as in [FormatFloat].\nIt rounds the result assuming that the original was obtained from a complex\nvalue of bitSize bits, which must be 64 for complex64 and 128 for complex128.\n" ^string [^complex128 c ^byte fmt ^int prec ^int bitSize]
  (let [^{:tag (array 64 byte)} buf (zero (array 64 byte))]
    (conv string (AppendComplex (subslice buf _ 0) c fmt prec bitSize))))





^{:go/end 40} (go/func AppendComplex "AppendComplex appends the result of FormatComplex to dst.\nIt is here for the runtime.\nThere is no public strconv.AppendComplex.\n" ^{:tag (slice byte)} [^{:tag (slice byte)} dst ^complex128 c ^byte fmt ^int prec ^int bitSize]
  (when (and (!= bitSize 64) (!= bitSize 128))
    (panic "invalid bitSize"))

  (set! bitSize >> 1) ; complex64 uses float32 internally

  (set! dst (append dst \())
  (set! dst (AppendFloat dst (real c) fmt prec bitSize))
  (let [i (len dst)]
    (set! dst (AppendFloat dst (imag c) fmt prec bitSize))
    ;; Check if imaginary part has a sign. If not, add one.
    (when (and (!= (aget dst i) \+) (!= (aget dst i) \-))
      (set! dst (append dst 0))
      (copy (subslice dst (+ i 1)) (subslice dst i))
      (aset dst i \+))

    (set! dst (append dst (spread "i)")))
    ^{:line 39} dst))

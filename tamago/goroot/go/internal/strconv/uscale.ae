      (return (conv unrounded (bit-or (>> hi s) 1))))

    (let [(values mid2 _) (bits/Mul64 x (.-pmLo c))]
      (set! hi - ((inst bool2 uint64) (< mid mid2)))
      (conv unrounded (bit-or (>> hi s) ((inst bool2 uint64) (> (- mid mid2) 1)))))))



^{:go/end 283} (go/func setDigits "setDigits sets digs to the nd digits described by d, p.\n" [^{:tag (slice byte)} s ^uint64 d ^int p ^int nd] :results [^int dp ^int nzd]

^{:go/end 107} (go/func fixedWidthFloat "fixedWidthFloat returns the n-digit decimal form of f = m * 2**e as d * 10**p.\nn can be at most 18.\nIf fmt == 'f' then n is a conservative estimate of the number of digits,\nand digits are discarded to match prec.\n" [^uint64 m ^int e ^int n ^int prec ^byte fmt] :results [^uint64 d ^int p]
  (set! p (- n 1 (log10Pow2 (+ e 63))))
  (let [^scaler pre (zero scaler)]
    (prescale (addr pre) e p (log2Pow10 p))
    (let [u (uscale m (addr pre))]
      (when (>= u (unmin (aget uint64pow10 n)))
        (set! u (.div u 10))
        (dec! p))

      (when (== fmt \f)
        (while (> p prec)
          (set! u (.div u 10))
          (dec! p)))


      (return (.round u) (- p)))))






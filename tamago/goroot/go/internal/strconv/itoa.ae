          (set! (values (aget a (- nd 3)) (aget a (- nd 4))) (values (aget smalls (+ x1 1)) (aget smalls x1)))
          (set! (values (aget a (- nd 5)) (aget a (- nd 6))) (values (aget smalls (+ x2 1)) (aget smalls x2)))
          (set! (values (aget a (- nd 7)) (aget a (- nd 8))) (values (aget smalls (+ x3 1)) (aget smalls x3)))

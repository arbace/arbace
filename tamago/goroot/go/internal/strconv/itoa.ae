^{:go/end 148} (go/func formatBits "formatBits computes the string representation of u in the given base.\nIf neg is set, u is treated as negative int64 value. If append_ is\nset, the string is appended to dst and the resulting byte slice is\nreturned as the first result value; otherwise the string is returned\nas the second result value.\nThe caller is expected to have handled base 10 separately for speed.\n" [^{:tag (slice byte)} dst ^uint64 u ^int base ^bool neg ^bool append_] :results [^{:tag (slice byte)} d ^string s]
  (when (or (< base 2) (== base 10) (> base (len digits)))
    (panic "strconv: illegal AppendInt/FormatInt base"))

  ;; 2 <= base && base <= len(digits)

  (let [^{:tag (array (+ 64 1) byte)} a (zero (array (+ 64 1) byte)) ; +1 for sign of 64bit value in base 2
      ^{:line 98} i (len a)]
    (when neg
      (set! u (- u)))


    ;; convert bits
    ;; We use uint values where we can because those will
    ;; fit into a single register even on a 32bit machine.

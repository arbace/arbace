    (while (>= nd 8)
      ;; Format last 8 digits (4 pairs).
      (let [x3210 (conv uint32 (% u 1.0E8))]
        (set! u / 1.0E8)
        (let [(values x32 x10) (values (/ x3210 10000.0) (% x3210 10000.0))
            (values x1 x0) (values (* (/ x10 100) 2) (* (% x10 100) 2))
            (values x3 x2) (values (* (/ x32 100) 2) (* (% x32 100) 2))]

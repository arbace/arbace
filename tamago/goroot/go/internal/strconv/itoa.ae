          ^{:line 109} b (conv uint64 base)
          ^{:line 110} m (- (conv uint base) 1)] ; == 1<<shift - 1
        (while (>= u b)
          (dec! i)
          (aset a i (aget digits (bit-and (conv uint u) m)))
          (set! u >> shift))

        ;; u < base
        (dec! i)
        (aset a i (aget digits (conv uint u))))

      ;; general case
      (let [b (conv uint64 base)]
        (while (>= u b)
          (dec! i)
          ;; Avoid using r = a%b in addition to q = a/b
          ;; since 64bit division and modulo operations
          ;; are calculated by runtime functions on 32bit machines.
          (let [q (/ u b)]
            (aset a i (aget digits (conv uint (- u (* q b)))))
            (set! u q)))

        ;; u < base
        (dec! i)
        (aset a i (aget digits (conv uint u)))))


    ;; add sign, if any
    (when neg
      (dec! i)
      (aset a i \-))


    (when append_
      (set! d (append dst (spread (subslice a i))))
      (return))

    (set! s (conv string (subslice a i)))
    (return)))



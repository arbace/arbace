    (while (> (.-dp d) 0)
      (let [^int n (zero int)]
        (if (>= (.-dp d) (len powtab))
          (set! n 27)

          (set! n (aget powtab (.-dp d))))

        (.Shift d (- n))
        (set! exp + n)))

    (while (or (< (.-dp d) 0) (and (== (.-dp d) 0) (< (aget (.-d d) 0) \5)))

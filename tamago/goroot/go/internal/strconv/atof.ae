  (return))







^{:go/end 570} (go/func atofHex "atofHex converts the hex floating-point string s\nto a rounded float32 or float64 value (depending on flt==&float32info or flt==&float64info)\nand returns it as a float64.\nThe string s has already been parsed into a mantissa, exponent, and sign (neg==true for negative).\nIf trunc is true, trailing non-zero bits have been omitted from the mantissa.\n" [^string s ^{:tag (* floatInfo)} flt ^uint64 mantissa ^int exp ^bool neg ^bool trunc] :results [float64 error]

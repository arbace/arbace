^{:go/end 467} (go/func atof64exact "If possible to convert decimal representation to 64-bit float f exactly,\nentirely in floating-point math, do so, avoiding the expense of decimalToFloatBits.\nThree common cases:\n\n\tvalue is exact integer\n\tvalue is exact integer * exact power of ten\n\tvalue is exact integer / exact power of ten\n\nThese all produce potentially inexact but correctly rounded answers.\n" [^uint64 mantissa ^int exp ^bool neg] :results [^float64 f ^bool ok]
  (when (!= (>> mantissa (.-mantbits float64info)) 0)
    (return))

  (set! f (conv float64 mantissa))
  (when neg
    (set! f (- f)))

  (switch
    (case [(== exp 0)]
      ;; an integer.
      (return f true))
    ;; Exact integers are <= 10^15.
    ;; Exact powers of ten are <= 10^22.
    (case [(and (> exp 0) (<= exp (+ 15 22)))] ; int * 10^k
      ;; If exponent is big but number of digits is not,
      ;; can move a few zeros into the integer part.
      (when (> exp 22)
        (set! f * (aget float64pow10 (- exp 22)))
        (set! exp 22))

      (when (or (> f 1.0E15) (< f -1.0E15))
        ;; the exponent was really too large.
        (return))

      (return (* f (aget float64pow10 exp)) true))
    (case [(and (< exp 0) (>= exp -22))] ; int / 10^k
      (return (/ f (aget float64pow10 (- exp))) true)))

  (return))





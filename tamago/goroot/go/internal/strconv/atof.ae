    (for [i 0] (< i n) (inc! i)
      (let [c (aget s i)]
        (when (and (<= \A c) (<= c \Z))
          (set! c + (- \a \A)))

        (when (!= c (aget prefix i))
          (return i))))


    ^{:line 40} n))








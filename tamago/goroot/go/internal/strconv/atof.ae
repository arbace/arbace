      (set! mantissa >> 2)
      (set! round bit-or (bit-and mantissa 1)) ; round to even (round up if mantissa is odd)
      (set! exp + 2)
      (when (== round 3)
        (inc! mantissa)
        (when (== mantissa ^uint64 (<< 1 (+ 1 (.-mantbits flt))))
          (set! mantissa >> 1)
          (inc! exp)))



      (when (== (>> mantissa (.-mantbits flt)) 0) ; Denormal or zero.
        (set! exp (.-bias flt)))

      (let [^error err (zero error)]
        (when (> exp maxExp) ; infinity and range error
          (set! mantissa ^uint64 (<< 1 (.-mantbits flt)))

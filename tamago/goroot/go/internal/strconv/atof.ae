(go/var ^{:doc "decimal power of ten to binary power of two.\n"} powtab (lit (slice int) 1 3 6 9 13 16 19 23 26))

^{:go/end 418} (go/method floatBits [^{:tag (* decimal)} d ^{:tag (* floatInfo)} flt] :results [^uint64 b ^bool overflow]
  (let [^int exp (zero int)
      ^{:line 324 :tag uint64} mant (zero uint64)]

    ;; Zero is always a special case.
    (when (== (.-nd d) 0)

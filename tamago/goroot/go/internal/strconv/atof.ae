^{:go/end 632} (go/func atof32 [^string s] :results [^float32 f ^int n ^error err]
  (when [(values val n ok) (special s)] ok
    (return (conv float32 val) n nil))


  (let [(values d p neg trunc hex ^:assign n ok) (readFloat s)]
    (when (not ok)
      (return 0 n ErrSyntax))


    (when hex
      (let [(values f err) (atofHex (subslice s _ n) (addr float32info) d p neg trunc)]
        (return (conv float32 f) n err)))


    (when optimize
      (let [sign (<< ((inst bool2 uint32) neg) 31)]
        (when (== d 0)
          (return (float32frombits (bit-or sign 0)) n nil))

        (when (> p 40) ; overflow to ±Inf
          (return (float32frombits (bit-or sign (<< 0xff 23))) n ErrRange))

        (when (< p -70) ; underflow to ±0
          (return (float32frombits (bit-or sign 0)) n nil))

        (when (not trunc)
          ;; Exact rounding with single multiplication or division.
          (when [(values f ok) (atof32exact d p neg)] ok
            (return f n nil)))


        ;; Use fast unrounded scaling.
        ;; The only possible err is ErrRange, when the result overflows to ±Inf.
        (let [(values f err) (parseFloat32 d p sign)]
          (when (not trunc)
            (return f n err))

          ;; If additional digits were truncated from d
          ;; but d+1 converts to the same value,
          ;; then the additional digits don't matter.
          (let [(values f1 _) (parseFloat32 (+ d 1) p sign)]
            (when (== f f1)
              (return f n err))))))



    ;; Slow fallback.
    (let [^decimal dec (zero decimal)]
      (when (not (.set dec (subslice s _ n)))
        (return 0 n ErrSyntax))

      (let [(values b ovf) (.floatBits dec (addr float32info))]
        (set! f (float32frombits (conv uint32 b)))
        (when ovf
          (set! err ErrRange))

        (return f n err)))))


^{:go/end 690} (go/func atof64 [^string s] :results [^float64 f ^int n ^error err]
  (when [(values val n ok) (special s)] ok
    (return val n nil))


  (let [(values d p neg trunc hex ^:assign n ok) (readFloat s)]
    (when (not ok)
      (return 0 n ErrSyntax))

    (when hex
      (let [(values f err) (atofHex (subslice s _ n) (addr float64info) d p neg trunc)]
        (return f n err)))

    (when optimize
      (let [sign (<< ((inst bool2 uint64) neg) 63)]

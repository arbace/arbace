(in-ns 'go.internal.strconv) (go/file "deps.go" :imports [

    ^{:line 7} [unsafe "unsafe"]])

;; Implementations to avoid importing other dependencies.

;; package math

^{:go/end 13} (go/func float64frombits ^float64 [^uint64 b] @(conv (* float64) (conv unsafe/Pointer (addr b))))
^{:go/end 14} (go/func float32frombits ^float32 [^uint32 b] @(conv (* float32) (conv unsafe/Pointer (addr b))))
^{:go/end 15} (go/func float64bits ^uint64 [^float64 f] @(conv (* uint64) (conv unsafe/Pointer (addr f))))
^{:go/end 16} (go/func float32bits ^uint32 [^float32 f] @(conv (* uint32) (conv unsafe/Pointer (addr f))))

^{:go/end 26} (go/func inf ^float64 [^int sign]
  (let [^uint64 v (zero uint64)]
    (if (>= sign 0)
      (set! v 0x7FF0000000000000)

      (set! v 0xFFF0000000000000))

    (float64frombits v)))


^{:go/end 28} (go/func isNaN [^float64 f] :results [^bool is] (!= f f))

^{:go/end 30} (go/func nan ^float64 [] (float64frombits 0x7FF8000000000001))

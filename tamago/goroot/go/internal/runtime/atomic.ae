(ns go.internal.runtime.atomic
  (:require [arbace.go :as go]))

(go/package atomic
  :path "internal/runtime/atomic"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["atomic_amd64.go" "doc.go" "linkname.go" "stubs.go" "types.go" "types_64bit.go" "unaligned.go" "xchg8.go"]
  :other-files ["atomic_amd64.s"]
  :init-order []
  :positions :lines)

(load "atomic/atomic_amd64")
(load "atomic/doc")
(load "atomic/linkname")
(load "atomic/stubs")
(load "atomic/types")
(load "atomic/types_64bit")
(load "atomic/unaligned")
(load "atomic/xchg8")

;; Package label provides common declarations used by both the [runtime] and [runtime/pprof] packages.
;; The [Set] type is used for goroutine labels, and is duplicated as
;; [runtime/pprof.LabelSet]. The type is duplicated due to go.dev/issue/65437
;; preventing the use of a type-alias in an existing public interface.
(in-ns 'go.internal.runtime.pprof.label) (go/file "labelset.go" :doc "Package label provides common declarations used by both the [runtime] and [runtime/pprof] packages.\nThe [Set] type is used for goroutine labels, and is duplicated as\n[runtime/pprof.LabelSet]. The type is duplicated due to go.dev/issue/65437\npreventing the use of a type-alias in an existing public interface.\n" :imports [])


(go/type Label "Label is a key/value pair of strings.\n" (struct
    ^{:line 13 :tag string} Key
    ^{:line 14 :tag string} Value))



(go/type Set "Set is a set of labels.\n" (struct
    ^{:line 19 :tag (slice Label)} List))



^{:go/end 25} (go/func NewSet "NewSet constructs a LabelSet that wraps the provided labels.\n" ^Set [^{:tag (slice Label)} list]
  (lit Set :List list))

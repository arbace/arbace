(in-ns 'go.internal.runtime.gc.scan) (go/file "filter.go" :imports [

    ^{:line 7} [unsafe "unsafe"]])




^{:go/end 33} (go/func FilterNil "FilterNil packs non-nil (non-zero) values in bufp together\nat the beginning of bufp, returning the length of the\npacked buffer. It treats bufp as an array of size n.\n" ^int32 [^{:tag (* uintptr)} bufp ^int32 n]
  (let [buf (unsafe/Slice bufp (conv int n))
      ^{:line 14} lo 0
      ^{:line 15} hi (- (len buf) 1)]
    (while (< lo hi)
      (while (and (< lo hi) (== (aget buf hi) 0))
        (dec! hi))

      (while (and (< lo hi) (!= (aget buf lo) 0))
        (inc! lo))

      (when (>= lo hi)
        (break))

      (aset buf lo (aget buf hi))
      (dec! hi))

    (when (and (>= hi 0) (== (aget buf hi) 0))
      (dec! hi))

    (+ (conv int32 hi) 1)))

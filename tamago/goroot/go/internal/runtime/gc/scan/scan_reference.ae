    ^{:line 10} [unsafe "unsafe"]])










^{:go/end 40} (go/func ScanSpanPackedReference "ScanSpanPackedReference is the reference implementation of ScanScanPacked. It prioritizes clarity over performance.\n\nConcretely, ScanScanPacked functions read pointers from mem, assumed to be gc.PageSize-aligned and gc.PageSize in size,\nand writes them to bufp, which is large enough to guarantee that even if pointer-word of mem is a pointer, it will fit.\nTherefore bufp, is always at least gc.PageSize in size.\n\nScanSpanPacked is supposed to identify pointers by first filtering words by objMarks, where each bit of the mask\nrepresents gc.SizeClassToSize[sizeClass] bytes of memory, and then filtering again by the bits in ptrMask.\n" [^unsafe/Pointer mem ^{:tag (* uintptr)} bufp ^{:tag (* gc/ObjMask)} objMarks ^uintptr sizeClass ^{:tag (* gc/PtrMask)} ptrMask] :results [^int32 count]
  (let [buf (unsafe/Slice bufp gc/PageWords)
      ^{:line 23} expandBy (/ (conv uintptr (aget gc/SizeClassToSize sizeClass)) goarch/PtrSize)]
    (range [word gc/PageWords]
      (let [objI (/ (conv uintptr word) expandBy)]
        (when (== (bit-and (aget objMarks (/ objI goarch/PtrBits)) ^uintptr (<< 1 (% objI goarch/PtrBits))) 0)
          (continue))

        (when (== (bit-and (aget ptrMask (/ word goarch/PtrBits)) ^uintptr (<< 1 (% word goarch/PtrBits))) 0)
          (continue))

        (let [ptr @(conv (* uintptr) (unsafe/Add mem (* word goarch/PtrSize)))]
          (when (== ptr 0)
            (continue))

          (aset buf count ptr)
          (inc! count))))

    ^{:line 39} count))

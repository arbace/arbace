(in-ns 'go.internal.runtime.gc.scan) (go/file "scan_amd64.go" :imports [


    ^{:line 8} [cpu "internal/cpu"]
    ^{:line 9} [gc "internal/runtime/gc"]
    ^{:line 10} [unsafe "unsafe"]])


^{:go/end 18} (go/func ScanSpanPacked [^unsafe/Pointer mem ^{:tag (* uintptr)} bufp ^{:tag (* gc/ObjMask)} objMarks ^uintptr sizeClass ^{:tag (* gc/PtrMask)} ptrMask] :results [^int32 count]
  (when (CanAVX512)
    (return (ScanSpanPackedAVX512 mem bufp objMarks sizeClass ptrMask)))

  (panic "not implemented"))


^{:go/end 22} (go/func HasFastScanSpanPacked ^bool []
  ^{:line 21} avx512ScanPackedReqsMet)


;; -- AVX512 --

^{:go/end 28} (go/func CanAVX512 ^bool []
  ^{:line 27} avx512ScanPackedReqsMet)


^{:go/end 32} (go/func ScanSpanPackedAVX512 [^unsafe/Pointer mem ^{:tag (* uintptr)} bufp ^{:tag (* gc/ObjMask)} objMarks ^uintptr sizeClass ^{:tag (* gc/PtrMask)} ptrMask] :results [^int32 count]
  (FilterNilAVX512 bufp (scanSpanPackedAVX512 mem bufp objMarks sizeClass ptrMask)))



(go/func ^:extern ^:go/noescape scanSpanPackedAVX512 [^unsafe/Pointer mem ^{:tag (* uintptr)} bufp ^{:tag (* gc/ObjMask)} objMarks ^uintptr sizeClass ^{:tag (* gc/PtrMask)} ptrMask] :results [^int32 count])

(go/var avx512ScanPackedReqsMet (and (.-HasAVX512VL cpu/X86)
    (.-HasAVX512BW cpu/X86)
    (.-HasGFNI cpu/X86)
    (.-HasAVX512BITALG cpu/X86)
    (.-HasAVX512DQ cpu/X86) ; for kmovb, see #79871
    (.-HasAVX512VBMI cpu/X86)
    (.-HasPOPCNT cpu/X86)))

(in-ns 'go.internal.runtime.gc.scan) (go/file "expand_amd64.go" :imports [

    ^{:line 7} [gc "internal/runtime/gc"]])







(go/func ^:extern ^:go/noescape ExpandAVX512 "ExpandAVX512 expands each bit in packed into f consecutive bits in unpacked,\nwhere f is the word size of objects in sizeClass.\n\nThis is a testing entrypoint to the expanders used by scanSpanPacked*.\n" [^int sizeClass ^{:tag (* gc/ObjMask)} packed ^{:tag (* gc/PtrMask)} unpacked])






(go/var ^{:tag (array (len gc/SizeClassToSize) uintptr) :doc "gcExpandersAVX512 is the PCs of expander functions. These cannot be called directly\nas they don't follow the Go ABI, but you can use this to check if a given\nexpander PC is 0.\n\nIt is defined in assembly.\n"} gcExpandersAVX512)

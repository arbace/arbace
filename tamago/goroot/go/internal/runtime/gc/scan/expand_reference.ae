(in-ns 'go.internal.runtime.gc.scan) (go/file "expand_reference.go" :imports [


    ^{:line 8} [goarch "internal/goarch"]
    ^{:line 9} [gc "internal/runtime/gc"]])





^{:go/end 39} (go/func ExpandReference "ExpandReference is a reference implementation of an expander function\nthat translates object mark bits into a bitmap of one bit per word of\nmarked object, assuming the object is of the provided size class.\n" [^int sizeClass ^{:tag (* gc/ObjMask)} packed ^{:tag (* gc/PtrMask)} unpacked]
  ;; Look up the size and derive the number of objects in a span.
  ;; We're only concerned with small objects in single-page spans,
  ;; and gc.PtrMask enforces this by being statically sized to
  ;; accommodate only such spans.
  (let [size (conv uintptr (aget gc/SizeClassToSize sizeClass))
      ^{:line 21} nObj (/ (* (conv uintptr (aget gc/SizeClassToNPages sizeClass)) gc/PageSize) size)

      ;; f is the expansion factor. For example, if our objects are of size 48,
      ;; then each mark bit will translate into 6 (48/8 = 6) set bits in the
      ;; pointer bitmap.
      ^{:line 26} f (/ size goarch/PtrSize)]
    (range [i nObj]
      ;; Check if the object is marked.
      (when (== (bit-and (aget packed (/ i goarch/PtrBits)) (<< (conv uintptr 1) (% i goarch/PtrBits))) 0)
        (continue))

      ;; Propagate that mark into the destination into one bit per the
      ;; expansion factor f, offset to the object's offset within the span.
      (range [j f]
        (let [b (+ (* i f) j)] ; i*f is the start bit for the object, j indexes into each corresponding word after.
          (set! (aget unpacked (/ b goarch/PtrBits)) bit-or (<< (conv uintptr 1) (% b goarch/PtrBits))))))))

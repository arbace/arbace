(in-ns 'go.internal.runtime.gc) (go/file "scan.go" :imports [

    ^{:line 7} [goarch "internal/goarch"]])




(go/type ObjMask "ObjMask is a bitmap where each bit corresponds to an object in a span.\n\nIt is sized to accommodate all size classes.\n" (array (/ MaxObjsPerSpan (* goarch/PtrSize 8)) uintptr))


(go/type PtrMask "PtrMask is a bitmap where each bit represents a pointer-word in a single runtime page.\n" (array (/ PageSize goarch/PtrSize (* goarch/PtrSize 8)) uintptr))

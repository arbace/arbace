(ns go.internal.runtime.gc.internal.gen
  (:require [arbace.go :as go]))

(go/package gen
  :path "internal/runtime/gc/internal/gen"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["gen.go" "gp.go" "regalloc.go" "simd.go" "val.go"]
  :init-order [canMem kindUint64 opRMW fixedRegs gpRegs kindUint8x64 kindUint64x8 kindMask8 kindMask64 voidKind ["val.go" 47 5] ptrKinds]
  :positions :lines)

(load "gen/gen")
(load "gen/gp")
(load "gen/regalloc")
(load "gen/simd")
(load "gen/val")

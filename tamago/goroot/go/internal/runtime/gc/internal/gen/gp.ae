    ^{:line 8} valGP))


(go/var kindUint64 (addr (lit kind :typ "Uint64" :reg regClassGP)))

^{:go/end 16} (go/func ConstUint64 [^uint64 c ^string name] :results [^Uint64 y]
  ^{:go/via [valGP valAny]} (.initOp y (addr (lit op :op "const" :kind (.kind y) :c c :name name)))
  ^{:line 15} y)


^{:go/end 20} (go/method kind ^{:tag (* kind)} [Uint64]

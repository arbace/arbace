^{:go/end 206} (go/method Compile [^{:tag (* File)} f]
  ;; TODO: CSE constants across the whole file

  (fmt/Fprintf (.-w f) "#include \"go_asm.h\"\n#include \"textflag.h\"\n\n")




  (range [_ c (.-consts f)]
    (.emitConst f (.-name c) (.-data c)))


  (let [trace ^{:go/end 179} (fn [^{:tag (* Func)} fn ^string step]
        (when (not logCompile)
          (return))

        (log/Printf "## Compiling %s: %s" (.-name fn) step)
        (.write fn os/Stderr))]


    (range [_ fn (.-funcs f)]
      (trace fn "initial")

      (while true
        (when (.cse fn)
          (trace fn "post cse")
          (continue))

        (when (.deadcode fn)
          (trace fn "post deadcode")
          (continue))

        (break))

      (.addLoads fn)
      (trace fn "post addLoads")

      ;; Assigning locations requires ops to be in dependency order.
      (.schedule fn)
      (trace fn "post schedule")

      (let [locs (.assignLocs fn)]

        (.emit fn f locs)))))





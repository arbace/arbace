^{:go/end 80} (go/method attach "attach adds x to fn's op list. If x has any unattached arguments, this adds\nthose first (recursively).\n" [^{:tag (* Func)} fn ^{:tag (* op)} x]
  ;; Make sure the arguments are attached to the function.
  (range [_ arg (.-args x)]

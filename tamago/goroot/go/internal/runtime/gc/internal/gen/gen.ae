^{:go/end 444} (go/method schedule "schedule ensures fn's ops are in dependency order.\n" [^{:tag (* Func)} fn]
  ;; TODO: This tends to generate a huge amount of register pressure, mostly
  ;; because it floats loads as early as possible and partly because it has no
  ;; concept of rematerialization and CSE can make rematerializable values
  ;; live for a very long time. It some sense it doesn't matter because we
  ;; don't run out of registers for anything we need.

  (let [missing (make (map (* op) int))
      ^{:line 404} uses (make (map (* op) (slice (* op))))
      ^{:line 405 :tag opHeap} h (zero opHeap)]
    (range [_ op (.-ops fn)]
      (if (== (len (.-args op)) 0)
        (set! h (append h op))

        (aset missing op (len (.-args op))))

      (range [_ arg (.-args op)]
        (aset uses arg (append (aget uses arg) op))))


    (heap/Init (addr h))

    (let [newOps (make (slice (* op)) 0 (len (.-ops fn)))]
      (while (> (len h) 0)
        (when false
          (log/Printf "schedule: %s" h))

        (let [top (aget h 0)]
          (set! newOps (append newOps top))
          (heap/Pop (addr h))
          (range [_ o (aget uses top)]
            (dec! (aget missing o))
            (when (== (aget missing o) 0)
              (heap/Push (addr h) o)))))



      (when (!= (len newOps) (len (.-ops fn)))
        (log/Print "schedule didn't schedule all ops")
        (log/Print "before:")
        (.write fn os/Stderr)
        (set! (.-ops fn) newOps)
        (log/Print "after:")
        (.write fn os/Stderr)
        (log/Fatal "bad schedule"))


      (set! (.-ops fn) newOps))))


^{:go/end 505} (go/method emit [^{:tag (* Func)} fn ^{:tag (* File)} f ^{:tag (map (* op) loc)} locs]
  (let [w (.-w f)]

    ;; Emit constants first
    (range [_ o (.-ops fn)]
      (when (== (.-op o) "const")
        (let [name (.-name (assert locMem (aget locs o)))]
          (.emitConst f name (.-c o)))))



    (fmt/Fprintf w "TEXT %s(SB), NOSPLIT, $0-0\n" (.-name fn))

    ;; Emit body
    (range [_ o (.-ops fn)]
      (switch (.-op o)
        (case ["const" "arg" "return" "deref" "imm"]
          ;; Does not produce code
          (continue)))

      (switch (.-op o)
        (case ["addConst"]
          (fatalf "addConst not lowered")))


      (let [opName (.-op o)]
        ;; A ".mask" suffix is used to distinguish AVX-512 ops that use the same
        ;; mnemonic for regular and masked mode.
        (set! opName (strings/TrimSuffix opName ".mask"))

        (fmt/Fprintf w "\t%s" opName)
        (when (== (.-op o) "VGF2P8AFFINEQB")
          ;; Hidden immediate, but always 0
          ;;
          ;; TODO: Replace this with an imm input.
          (fmt/Fprintf w " $0,"))

        (range [i arg (.-args o)]
          (if (== i 0)
            (fmt/Fprintf w " ")

            (fmt/Fprintf w ", "))

          (if (== (.-op arg) "imm")
            (fmt/Fprintf w "$0x%x" (.-c arg))

            (fmt/Fprint w (.LocString (aget locs arg)))))


        (if [(values _ ok) (aget opRMW (.-op o))] ok (do)
          ;; Read-modify-write instructions, so the output is already in the
          ;; arguments above.

          (fmt/Fprintf w ", %s" (.LocString (aget locs o))))

        (fmt/Fprintf w "\n")))

    (fmt/Fprintf w "\tRET\n")
    (fmt/Fprintf w "\n")))


^{:go/end 537} (go/method emitConst [^{:tag (* File)} f ^string name ^any data]
  (type-switch [data data]
    (case [(slice (* Func))]
      (fmt/Fprintf (.-w f) "GLOBL %s(SB), RODATA, $%#x\n" name (* (len data) 8))
      (range [i fn data]
        (fmt/Fprintf (.-w f) "DATA  %s+%#02x(SB)/8, " name (* 8 i))
        (if (== fn nil)
          (fmt/Fprintf (.-w f) "$0\n")

          (fmt/Fprintf (.-w f) "$%s(SB)\n" (.-name fn))))


      (fmt/Fprintf (.-w f) "\n")
      (return)))


  ;; Assume it's a numeric slice or array
  (let [rv (reflect/ValueOf data)
      ^{:line 525} sz (conv int (.Size (.Elem (.Type rv))))]
    (fmt/Fprintf (.-w f) "GLOBL %s(SB), RODATA, $%#x\n" name (* (.Len rv) sz))
    (for [wi 0] (< wi (/ (* sz (.Len rv)) 8)) (inc! wi) ; Iterate over words
      (let [^uint64 word (zero uint64)]
        (for [j 0] (< j (/ 8 sz)) (inc! j) ; Iterate over elements in this word
          (let [d (.Uint (.Index rv (+ (/ (* wi 8) sz) j)))]
            (set! word bit-or (<< d (* j sz 8)))))

        (fmt/Fprintf (.-w f) "DATA  %s+%#02x(SB)/8, $%#016x\n" name (* 8 wi) word)))


    (fmt/Fprintf (.-w f) "\n")))

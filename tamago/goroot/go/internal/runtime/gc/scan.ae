(ns go.internal.runtime.gc.scan
  (:require [arbace.go :as go]))

(go/package scan
  :path "internal/runtime/gc/scan"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["expand_amd64.go" "expand_reference.go" "filter.go" "filter_amd64.go" "scan_amd64.go" "scan_go.go" "scan_reference.go"]
  :other-files ["expand_amd64.s" "filter_amd64.s" "scan_amd64.s"]
  :init-order [avx512ScanPackedReqsMet]
  :positions :lines)

(load "scan/expand_amd64")
(load "scan/expand_reference")
(load "scan/filter")
(load "scan/filter_amd64")
(load "scan/scan_amd64")
(load "scan/scan_go")
(load "scan/scan_reference")

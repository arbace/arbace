(ns go.internal.runtime.gc
  (:require [arbace.go :as go]))

(go/package gc
  :path "internal/runtime/gc"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["malloc.go" "scan.go" "sizeclasses.go"]
  :init-order [SizeClassToSize SizeClassToNPages SizeClassToDivMagic SizeToSizeClass8 SizeToSizeClass128]
  :positions :lines)

(load "gc/malloc")
(load "gc/scan.go")
(load "gc/sizeclasses")

^{:go/end 113} (go/func ^:go/nosplit Len64 "Len64 returns the minimum number of bits required to represent x; the result is 0 for x == 0.\n\nnosplit because this is used in src/runtime/histogram.go, which make run in sensitive contexts.\n" [^uint64 x] :results [^int n]
  (when (>= x (<< 1 32))
    (set! x >> 32)
    (set! n 32))

  (when (>= x (<< 1 16))
    (set! x >> 16)
    (set! n + 16))

  (when (>= x (<< 1 8))
    (set! x >> 8)
    (set! n + 8))

  (+ n (conv int (aget len8tab (conv uint8 x)))))


;; --- OnesCount ---

(go/const ^{:val 6148914691236517205} m0 0x5555555555555555) ; 01010101 ...
(go/const ^{:val 3689348814741910323} m1 0x3333333333333333) ; 00110011 ...
(go/const ^{:val 1085102592571150095} m2 0x0f0f0f0f0f0f0f0f) ; 00001111 ...


^{:go/end 150} (go/func OnesCount64 "OnesCount64 returns the number of one bits (\"population count\") in x.\n" ^int [^uint64 x]
  ;; Implementation: Parallel summing of adjacent bits.
  ;; See "Hacker's Delight", Chap. 5: Counting Bits.
  ;; The following pattern shows the general approach:
  ;;
  ;;   x = x>>1&(m0&m) + x&(m0&m)
  ;;   x = x>>2&(m1&m) + x&(m1&m)
  ;;   x = x>>4&(m2&m) + x&(m2&m)
  ;;   x = x>>8&(m3&m) + x&(m3&m)
  ;;   x = x>>16&(m4&m) + x&(m4&m)
  ;;   x = x>>32&(m5&m) + x&(m5&m)
  ;;   return int(x)
  ;;
  ;; Masking (& operations) can be left away when there's no
  ;; danger that a field's sum will carry over into the next
  ;; field: Since the result cannot be > 64, 8 bits is enough
  ;; and we can ignore the masks for the shifts by 8 and up.
  ;; Per "Hacker's Delight", the first line can be simplified
  ;; more, but it saves at best one instruction, so we leave
  ;; it alone for clarity.
  (let [^:const ^{:val 18446744073709551615N} m (- (<< 1 64) 1)]
    (set! x (+ (bit-and (>> x 1) (bit-and m0 m)) (bit-and x (bit-and m0 m))))
    (set! x (+ (bit-and (>> x 2) (bit-and m1 m)) (bit-and x (bit-and m1 m))))
    (set! x (bit-and (+ (>> x 4) x) (bit-and m2 m)))
    (set! x + (>> x 8))
    (set! x + (>> x 16))
    (set! x + (>> x 32))
    (bit-and (conv int x) (- (<< 1 7) 1))))



^{:go/end 153} (go/func LeadingZeros64 "LeadingZeros64 returns the number of leading zero bits in x; the result is 64 for x == 0.\n" ^int [^uint64 x] (- 64 (Len64 x)))


^{:go/end 156} (go/func LeadingZeros8 "LeadingZeros8 returns the number of leading zero bits in x; the result is 8 for x == 0.\n" ^int [^uint8 x] (- 8 (Len8 x)))


^{:go/end 161} (go/func Len8 "Len8 returns the minimum number of bits required to represent x; the result is 0 for x == 0.\n" ^int [^uint8 x]
  (conv int (aget len8tab x)))




^{:go/end 179} (go/func Bswap64 "Bswap64 returns its input with byte order reversed\n0x0102030405060708 -> 0x0807060504030201\n" ^uint64 [^uint64 x]
  (let [c8 (conv uint64 0x00ff00ff00ff00ff)
      ^{:line 167} a (bit-and (>> x 8) c8)
      ^{:line 168} b (<< (bit-and x c8) 8)]
    (set! x (bit-or a b))
    (let [c16 (conv uint64 0x0000ffff0000ffff)]
      (set! a (bit-and (>> x 16) c16))
      (set! b (<< (bit-and x c16) 16))
      (set! x (bit-or a b))
      (let [c32 (conv uint64 0x00000000ffffffff)]
        (set! a (bit-and (>> x 32) c32))
        (set! b (<< (bit-and x c32) 32))
        (set! x (bit-or a b))
        ^{:line 178} x))))




^{:go/end 193} (go/func Bswap32 "Bswap32 returns its input with byte order reversed\n0x01020304 -> 0x04030201\n" ^uint32 [^uint32 x]
  (let [c8 (conv uint32 0x00ff00ff)
      ^{:line 185} a (bit-and (>> x 8) c8)
      ^{:line 186} b (<< (bit-and x c8) 8)]
    (set! x (bit-or a b))
    (let [c16 (conv uint32 0x0000ffff)]
      (set! a (bit-and (>> x 16) c16))
      (set! b (<< (bit-and x c16) 16))
      (set! x (bit-or a b))
      ^{:line 192} x)))







^{:go/end 200} (go/func Prefetch "Prefetch prefetches data from memory addr to cache\n\nAMD64: Produce PREFETCHT0 instruction\n\nARM64: Produce PRFM instruction with PLDL1KEEP option\n" [^uintptr addr])







^{:go/end 208} (go/func PrefetchStreamed "PrefetchStreamed prefetches data from memory addr, with a hint that this data is being streamed.\nThat is, it is likely to be accessed very soon, but only once. If possible, this will avoid polluting the cache.\n\nAMD64: Produce PREFETCHNTA instruction\n\nARM64: Produce PRFM instruction with PLDL1STRM option\n" [^uintptr addr])

;; GetCallerPC returns the program counter (PC) of its caller's caller.
;; GetCallerSP returns the stack pointer (SP) of its caller's caller.
;; Both are implemented as intrinsics on every platform.
;;
;; For example:
;;
;;	func f(arg1, arg2, arg3 int) {
;;		pc := GetCallerPC()
;;		sp := GetCallerSP()
;;	}
;;
;; These two lines find the PC and SP immediately following
;; the call to f (where f will return).
;;
;; The call to GetCallerPC and GetCallerSP must be done in the
;; frame being asked about.
;;
;; The result of GetCallerSP is correct at the time of the return,
;; but it may be invalidated by any subsequent call to a function
;; that might relocate the stack in order to grow or shrink it.
;; A general rule is that the result of GetCallerSP should be used
;; immediately and can only be passed to nosplit functions.

(go/func ^:extern GetCallerPC ^uintptr [])

(go/func ^:extern GetCallerSP ^uintptr [])




















(go/func ^:extern GetClosurePtr "GetClosurePtr returns the pointer to the current closure.\nGetClosurePtr can only be used in an assignment statement\nat the entry of a function. Moreover, go:nosplit directive\nmust be specified at the declaration of caller function,\nso that the function prolog does not clobber the closure register.\nfor example:\n\n\t//go:nosplit\n\tfunc f(arg1, arg2, arg3 int) {\n\t\tdx := GetClosurePtr()\n\t}\n\nThe compiler rewrites calls to this function into instructions that fetch the\npointer from a well-known register (DX on x86 architecture, etc.) directly.\n\nWARNING: PGO-based devirtualization cannot detect that caller of\nGetClosurePtr requires closure context, and thus must maintain a list of\nthese functions, which is in\ncmd/compile/internal/devirtualize/pgo.maybeDevirtualizeFunctionCall.\n" ^uintptr [])

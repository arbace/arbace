^{:go/end 50} (go/func TrailingZeros32 "TrailingZeros32 returns the number of trailing zero bits in x; the result is 32 for x == 0.\n" ^int [^uint32 x]
  (when (== x 0)
    (return 32))

  ;; see comment in TrailingZeros64
  (conv int (aget deBruijn32tab (>> (* (bit-and x (- x)) deBruijn32) (- 32 5)))))



^{:go/end 69} (go/func TrailingZeros64 "TrailingZeros64 returns the number of trailing zero bits in x; the result is 64 for x == 0.\n" ^int [^uint64 x]
  (when (== x 0)
    (return 64))

  ;; If popcount is fast, replace code below with return popcount(^x & (x - 1)).
  ;;
  ;; x & -x leaves only the right-most bit set in the word. Let k be the
  ;; index of that bit. Since only a single bit is set, the value is two
  ;; to the power of k. Multiplying by a power of two is equivalent to
  ;; left shifting, in this case by k bits. The de Bruijn (64 bit) constant
  ;; is such that all six bit, consecutive substrings are distinct.
  ;; Therefore, if we have a left shifted version of this constant we can
  ;; find by how many bits it was shifted by looking at which six bit
  ;; substring ended up at the top of the word.
  ;; (Knuth, volume 4, section 7.3.1)
  (conv int (aget deBruijn64tab (>> (* (bit-and x (- x)) deBruijn64) (- 64 6)))))



^{:go/end 74} (go/func TrailingZeros8 "TrailingZeros8 returns the number of trailing zero bits in x; the result is 8 for x == 0.\n" ^int [^uint8 x]
  (conv int (aget ntz8tab x)))



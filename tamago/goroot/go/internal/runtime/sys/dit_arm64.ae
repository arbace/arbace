(in-ns 'go.internal.runtime.sys) (go/file "dit_arm64.go" :build ["//go:build arm64"] :imports [


    ^{:line 10} [cpu "internal/cpu"]
    ^{:line 11} [unsafe "unsafe"]])


(go/var DITSupported (.-HasDIT cpu/ARM64))

(go/const ^{:val 138} offsetARM64HasSB (unsafe/Offsetof (.-HasSB cpu/ARM64)))


(ns go.internal.runtime.cgroup
  (:require [arbace.go :as go]))

(go/package cgroup
  :path "internal/runtime/cgroup"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["cgroup.go" "line_reader.go" "runtime.go"]
  :init-order [ErrNoCgroup errMalformedFile errInvalidEscape errPathTooLong errIncompleteLine errSyscallFailed errEOF]
  :positions :lines)

(load "cgroup/cgroup")
(load "cgroup/line_reader")
(load "cgroup/runtime")

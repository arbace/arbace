(go/type bitset "bitset represents a set of slots within a group.\n\nThe underlying representation depends on GOARCH.\n\nOn AMD64, bitset uses one bit per slot, where the bit is set if the slot is\npart of the set. All of the ctrlGroup.match* methods are replaced with\nintrinsics that return this packed representation.\n\nOn other architectures, bitset uses one byte per slot, where each byte is\neither 0x80 if the slot is part of the set or 0x00 otherwise. This makes it\nconvenient to calculate for an entire group at once using standard\narithmetic instructions.\n" uint64)





^{:go/end 51} (go/method first "first returns the relative index of the first control byte in the group that\nis in the set.\n\nPreconditions: b is not 0 (empty).\n" ^uintptr [^bitset b]
  (bitsetFirst b))






^{:go/end 59} (go/func bitsetFirst "Portable implementation of first.\n\nOn AMD64, this is replaced with an intrisic that simply does\nTrailingZeros64. There is no need to shift as the bitset is packed.\n" ^uintptr [^bitset b]
  (>> (conv uintptr (sys/TrailingZeros64 (conv uint64 b))) 3))




^{:go/end 65} (go/method removeFirst "removeFirst clears the first set bit (that is, resets the least significant\nset bit to 0).\n" ^bitset [^bitset b]
  (bit-and b (- b 1)))



^{:go/end 70} (go/method removeBelow "removeBelow clears all set bits below slot i (non-inclusive).\n" ^bitset [^bitset b ^uintptr i]
  (bitsetRemoveBelow b i))





^{:go/end 79} (go/func bitsetRemoveBelow "Portable implementation of removeBelow.\n\nOn AMD64, this is replaced with an intrisic that clears the lower i bits.\n" ^bitset [^bitset b ^uintptr i]
  ;; Clear all bits below slot i's byte.
  (let [mask (- (<< (conv uint64 1) (* 8 (conv uint64 i))) 1)]
    (bit-and-not b (conv bitset mask))))






^{:go/end 87} (go/method lowestSet "lowestSet returns true if the bit is set for the lowest index in the bitset.\n\nThis is intended for use with shiftOutLowest to loop over all entries in the\nbitset regardless of whether they are set.\n" ^bool [^bitset b]
  (bitsetLowestSet b))





^{:go/end 94} (go/func bitsetLowestSet "Portable implementation of lowestSet.\n\nOn AMD64, this is replaced with an intrisic that checks the lowest bit.\n" ^bool [^bitset b]

  ;; Note: works for both bitset representations (AMD64 and generic)
  (sys/OnesCount64 (conv uint64 b)))










(go/type ctrl "Each slot in the hash table has a control byte which can have one of three\nstates: empty, deleted, and full. They have the following bit patterns:\n\n\t  empty: 1 0 0 0 0 0 0 0\n\tdeleted: 1 1 1 1 1 1 1 0\n\t   full: 0 h h h h h h h  // h represents the H2 hash bits\n\nTODO(prattmic): Consider inverting the top bit so that the zero value is empty.\n" uint8)



(go/type ctrlGroup "ctrlGroup is a fixed size array of abi.MapGroupSlots control bytes\nstored in a uint64.\n" uint64)


^{:go/end 135} (go/method get "get returns the i-th control byte.\n" ^ctrl [^{:tag (* ctrlGroup)} g ^uintptr i]
  (when goarch/BigEndian
    (return @(conv (* ctrl) (unsafe/Add (conv unsafe/Pointer g) (- 7 i)))))

  ^{:line 134} @(conv (* ctrl) (unsafe/Add (conv unsafe/Pointer g) i)))



^{:go/end 144} (go/method set "set sets the i-th control byte.\n" [^{:tag (* ctrlGroup)} g ^uintptr i ^ctrl c]
  (when goarch/BigEndian
    (set! @(conv (* ctrl) (unsafe/Add (conv unsafe/Pointer g) (- 7 i))) c)
    (return))

  (set! @(conv (* ctrl) (unsafe/Add (conv unsafe/Pointer g) i)) c))



^{:go/end 149} (go/method setEmpty "setEmpty sets all the control bytes to empty.\n" [^{:tag (* ctrlGroup)} g]
  (set! @g (conv ctrlGroup bitsetEmpty)))




^{:go/end 155} (go/method matchH2 "matchH2 returns the set of slots which are full and for which the 7-bit hash\nmatches the given value. May return false positives.\n" ^bitset [^ctrlGroup g ^uintptr h]
  (ctrlGroupMatchH2 g h))






^{:go/end 176} (go/func ctrlGroupMatchH2 "Portable implementation of matchH2.\n\nNote: On AMD64, this is an intrinsic implemented with SIMD instructions. See\nnote on bitset about the packed intrinsified return value.\n" ^bitset [^ctrlGroup g ^uintptr h]
  (let [v (bit-xor (conv uint64 g) (* bitsetLSB (conv uint64 h)))]
    (when (== goarch/IsArm64 1)
      (set! v (bit-not v))
      (return (conv bitset (bit-and (+ (bit-and v bitsetL7B) bitsetLSB) (bit-and v bitsetMSB)))))

    ;; NB: This generic matching routine produces false positive matches when
    ;; h is 2^N and the control bytes have a seq of 2^N followed by 2^N+1. For
    ;; example: if ctrls==0x0302 and h=02, we'll compute v as 0x0100. When we
    ;; subtract off 0x0101 the first 2 bytes we'll become 0xffff and both be
    ;; considered matches of h. The false positive matches are not a problem,
    ;; just a rare inefficiency. Note that they only occur if there is a real
    ;; match and never occur on ctrlEmpty, or ctrlDeleted. The subsequent key
    ;; comparisons ensure that there is no correctness issue.
    (conv bitset (bit-and (bit-and-not (- v bitsetLSB) v) bitsetMSB))))



^{:go/end 181} (go/method matchEmpty "matchEmpty returns the set of slots in the group that are empty.\n" ^bitset [^ctrlGroup g]
  (ctrlGroupMatchEmpty g))






^{:go/end 196} (go/func ctrlGroupMatchEmpty "Portable implementation of matchEmpty.\n\nNote: On AMD64, this is an intrinsic implemented with SIMD instructions. See\nnote on bitset about the packed intrinsified return value.\n" ^bitset [^ctrlGroup g]
  ;; An empty slot is   1000 0000
  ;; A deleted slot is  1111 1110
  ;; A full slot is     0??? ????
  ;;
  ;; A slot is empty iff bit 7 is set and bit 1 is not. We could select any
  ;; of the other bits here (e.g. v << 1 would also work).
  (let [v (conv uint64 g)]
    (conv bitset (bit-and (bit-and-not v (<< v 6)) bitsetMSB))))




^{:go/end 202} (go/method matchEmptyOrDeleted "matchEmptyOrDeleted returns the set of slots in the group that are empty or\ndeleted.\n" ^bitset [^ctrlGroup g]
  (ctrlGroupMatchEmptyOrDeleted g))






^{:go/end 216} (go/func ctrlGroupMatchEmptyOrDeleted "Portable implementation of matchEmptyOrDeleted.\n\nNote: On AMD64, this is an intrinsic implemented with SIMD instructions. See\nnote on bitset about the packed intrinsified return value.\n" ^bitset [^ctrlGroup g]
  ;; An empty slot is  1000 0000
  ;; A deleted slot is 1111 1110
  ;; A full slot is    0??? ????
  ;;
  ;; A slot is empty or deleted iff bit 7 is set.
  (let [v (conv uint64 g)]
    (conv bitset (bit-and v bitsetMSB))))



^{:go/end 221} (go/method matchFull "matchFull returns the set of slots in the group that are full.\n" ^bitset [^ctrlGroup g]
  (ctrlGroupMatchFull g))



^{:go/end 227} (go/method anyFull "anyFull reports whether any slots in the group are full.\n" ^bool [^ctrlGroup g]
  ;; A slot is full iff bit 7 is unset. Test whether any slot has bit 7 unset.
  (!= (bit-and (bit-not g) bitsetMSB) 0))






^{:go/end 241} (go/func ctrlGroupMatchFull "Portable implementation of matchFull.\n\nNote: On AMD64, this is an intrinsic implemented with SIMD instructions. See\nnote on bitset about the packed intrinsified return value.\n" ^bitset [^ctrlGroup g]
  ;; An empty slot is  1000 0000
  ;; A deleted slot is 1111 1110
  ;; A full slot is    0??? ????
  ;;
  ;; A slot is full iff bit 7 is unset.
  (let [v (conv uint64 g)]
    (conv bitset (bit-and (bit-not v) bitsetMSB))))







(go/type groupReference "groupReference is a wrapper type representing a single slot group stored at\ndata.\n\nA group holds abi.MapGroupSlots slots (key/elem pairs) plus their\ncontrol word.\n" (struct





















    ^{:line 270 :tag unsafe/Pointer :doc "data points to the group, which is described by typ.Group and has\nlayout depending on GOEXPERIMENT=mapsplitgroup:\n\nWith mapsplitgroup (split arrays):\ntype group struct {\n\tctrls ctrlGroup\n\tkeys  [abi.MapGroupSlots]typ.Key\n\telems [abi.MapGroupSlots]typ.Elem\n}\n\nWithout (interleaved slots):\ntype group struct {\n\tctrls ctrlGroup\n\tslots [abi.MapGroupSlots]struct {\n\t\tkey  typ.Key\n\t\telem typ.Elem\n\t}\n}\n\nIn both cases, key(i) and elem(i) use the same formula via\ntyp.KeysOff/KeyStride and typ.ElemsOff/ElemStride.\n"} data)) ; data *typ.Group



^{:go/end 276} (go/func alignUp "alignUp rounds n up to a multiple of a. a must be a power of 2.\n" ^uintptr [^uintptr n ^uintptr a]
  (bit-and-not (- (+ n a) 1) (- a 1)))





^{:go/end 290} (go/func alignUpPow2 "alignUpPow2 rounds n up to the next power of 2.\n\nReturns true if round up causes overflow.\n" [^uint64 n] :results [uint64 bool]
  (when (== n 0)
    (return 0 false))

  (let [v (<< (conv uint64 1) (sys/Len64 (- n 1)))]
    (when (== v 0)
      (return 0 true))

    (return v false)))




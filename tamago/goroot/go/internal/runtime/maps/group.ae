^{:go/end 373} (go/func cloneGroup [^{:tag (* abi/MapType)} typ ^groupReference newGroup ^groupReference oldGroup]
  (typedmemmove (.-Group typ) (.-data newGroup) (.-data oldGroup))
  (when (.IndirectKey typ)
    ;; Deep copy keys if indirect.
    (for [i (conv uintptr 0)] (< i abi/MapGroupSlots) (inc! i)
      (let [oldKey @(conv (* unsafe/Pointer) (.key oldGroup typ i))]
        (when (== oldKey nil)
          (continue))

        (let [newKey (newobject (.-Key typ))]
          (typedmemmove (.-Key typ) newKey oldKey)
          (set! @(conv (* unsafe/Pointer) (.key newGroup typ i)) newKey)))))


  (when (.IndirectElem typ)
    ;; Deep copy elems if indirect.
    (for [i (conv uintptr 0)] (< i abi/MapGroupSlots) (inc! i)
      (let [oldElem @(conv (* unsafe/Pointer) (.elem oldGroup typ i))]
        (when (== oldElem nil)
          (continue))

        (let [newElem (newobject (.-Elem typ))]
          (typedmemmove (.-Elem typ) newElem oldElem)
          (set! @(conv (* unsafe/Pointer) (.elem newGroup typ i)) newElem))))))

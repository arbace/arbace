^{:go/end 100} (go/method shiftOutLowest "shiftOutLowest shifts the lowest entry out of the bitset. Afterwards, the\nlowest entry in the bitset corresponds to the next slot.\n" ^bitset [^bitset b]
  (bitsetShiftOutLowest b))





^{:go/end 107} (go/func bitsetShiftOutLowest "Portable implementation of shiftOutLowest.\n\nOn AMD64, this is replaced with an intrisic that shifts a single bit.\n" ^bitset [^bitset b]
  (>> b 8))




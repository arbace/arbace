(in-ns 'go.internal.runtime.maps) (go/file "memhash_aes.go" :build ["//go:build amd64 || arm64 || 386"] :imports [


    ^{:line 10} [unsafe "unsafe"]])


(go/const ^{:val true} memHashAESImplemented true)

^{:go/end 20} (go/func MemHash ^uintptr [^unsafe/Pointer p ^uintptr h ^uintptr s]
  (when UseAeshash
    (return (memHashAES p h s)))

  (memHashFallback p h s))


^{:go/end 27} (go/func MemHash32 ^uintptr [^uint32 k ^uintptr h]
  (when UseAeshash
    (return (memHash32AES k h)))

  (memHash32Fallback k h))


^{:go/end 34} (go/func MemHash64 ^uintptr [^uint64 k ^uintptr h]
  (when UseAeshash
    (return (memHash64AES k h)))

  (memHash64Fallback k h))


^{:go/end 38} (go/func StrHash ^uintptr [^string s ^uintptr h]
  (MemHash (conv unsafe/Pointer (unsafe/StringData s)) h (conv uintptr (len s))))

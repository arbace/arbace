;; Hashing algorithm inspired by
;; wyhash: https://github.com/wangyi-fudan/wyhash



(in-ns 'go.internal.runtime.maps) (go/file "runtime_hash64.go" :build ["//go:build amd64 || arm64 || loong64 || mips64 || mips64le || ppc64 || ppc64le || riscv64 || s390x"] :imports [


    ^{:line 13} [bits "math/bits"]
    ^{:line 14} [unsafe "unsafe"]])


(go/const
  ^{:line 18} [^{:val 2129725606500045391} m5 0x1d8e4e27c47d124f])


^{:go/end 65} (go/func memHashFallback ^uintptr [^unsafe/Pointer p ^uintptr seed ^uintptr s]
  (let [(values ^uintptr a ^uintptr b) (zero uintptr)]
    (set! seed bit-xor (aget hashkey 0))
    (switch
      (case [(== s 0)]
        (return seed))
      (case [(< s 4)]
        (set! a (conv uintptr @(conv (* byte) p)))
        (set! a bit-or (<< (conv uintptr @(conv (* byte) (add p (>> s 1)))) 8))
        (set! a bit-or (<< (conv uintptr @(conv (* byte) (add p (- s 1)))) 16)))
      (case [(== s 4)]
        (set! a (r4 p))
        (set! b a))
      (case [(< s 8)]
        (set! a (r4 p))
        (set! b (r4 (add p (- s 4)))))
      (case [(== s 8)]
        (set! a (r8 p))
        (set! b a))
      (case [(<= s 16)]
        (set! a (r8 p))
        (set! b (r8 (add p (- s 8)))))
      (default
        (let [l s]
          (when (> l 48)
            (let [seed1 seed
                ^{:line 47} seed2 seed]
              (for [] (> l 48) (set! l - 48)
                (set! seed (mix (bit-xor (r8 p) (aget hashkey 1)) (bit-xor (r8 (add p 8)) seed)))
                (set! seed1 (mix (bit-xor (r8 (add p 16)) (aget hashkey 2)) (bit-xor (r8 (add p 24)) seed1)))
                (set! seed2 (mix (bit-xor (r8 (add p 32)) (aget hashkey 3)) (bit-xor (r8 (add p 40)) seed2)))
                (set! p (add p 48)))

              (set! seed bit-xor (bit-xor seed1 seed2))))

          (for [] (> l 16) (set! l - 16)
            (set! seed (mix (bit-xor (r8 p) (aget hashkey 1)) (bit-xor (r8 (add p 8)) seed)))
            (set! p (add p 16)))

          (set! a (r8 (add p (- l 16))))
          (set! b (r8 (add p (- l 8)))))))


    (mix (bit-xor m5 s) (mix (bit-xor a (aget hashkey 1)) (bit-xor b seed)))))


^{:go/end 70} (go/func memHash32Fallback ^uintptr [^uint32 k ^uintptr seed]
  (let [a (conv uintptr k)]
    (mix (bit-xor m5 4) (mix (bit-xor a (aget hashkey 1)) (bit-xor a seed (aget hashkey 0))))))


^{:go/end 75} (go/func memHash64Fallback ^uintptr [^uint64 k ^uintptr seed]
  (let [a (conv uintptr k)]
    (mix (bit-xor m5 8) (mix (bit-xor a (aget hashkey 1)) (bit-xor a seed (aget hashkey 0))))))


^{:go/end 80} (go/func mix ^uintptr [^uintptr a ^uintptr b]
  (let [(values hi lo) (bits/Mul64 (conv uint64 a) (conv uint64 b))]
    (conv uintptr (bit-xor hi lo))))


^{:go/end 84} (go/func r4 ^uintptr [^unsafe/Pointer p]
  (conv uintptr (readUnaligned32 p)))


^{:go/end 88} (go/func r8 ^uintptr [^unsafe/Pointer p]
  (conv uintptr (readUnaligned64 p)))

(ns go.internal.runtime.sys
  (:require [arbace.go :as go]))

(go/package sys
  :path "internal/runtime/sys"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["consts.go" "consts_norace.go" "intrinsics.go" "nih.go" "no_dit.go" "sys.go" "zversion.go"]
  :other-files ["empty.s"]
  :init-order [deBruijn32tab deBruijn64tab DITSupported]
  :positions :lines)

(load "sys/consts")
(load "sys/consts_norace")
(load "sys/intrinsics")
(load "sys/nih")
(load "sys/no_dit")
(load "sys/sys")
(load "sys/zversion")

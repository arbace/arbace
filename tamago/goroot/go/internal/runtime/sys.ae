(ns go.internal.runtime.sys
  (:require [arbace.go :as go]))

(go/package sys
  :path "internal/runtime/sys"
  :files ["consts.go" "consts_norace.go" "dit_arm64.go" "intrinsics.go" "nih.go" "no_dit.go" "sys.go" "zversion.go"]
  :other-files ["dit_arm64.s" "empty.s"]
  :positions :lines)

(load "sys/consts")
(load "sys/consts_norace")
(load "sys/dit_arm64")
(load "sys/intrinsics")
(load "sys/nih")
(load "sys/no_dit")
(load "sys/sys")
(load "sys/zversion")

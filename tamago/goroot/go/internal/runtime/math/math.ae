(in-ns 'go.internal.runtime.math) (go/file "math.go" :imports [

    ^{:line 7} [goarch "internal/goarch"]])

(go/const
  ^{:line 10} [^{:val 65535} MaxUint16 (bit-not (conv uint16 0))]
  ^{:line 11} [^{:val 4294967295} MaxUint32 (bit-not (conv uint32 0))]
  ^{:line 12} [^{:val 18446744073709551615N} MaxUint64 (bit-not (conv uint64 0))]
  ^{:line 13} [^{:val 18446744073709551615N} MaxUintptr (bit-not (conv uintptr 0))]

  ^{:line 15} [^{:val 9223372036854775807} MaxInt64 (conv int64 (>> MaxUint64 1))])




^{:go/end 26} (go/func MulUintptr "MulUintptr returns a * b and whether the multiplication overflowed.\nOn supported platforms this is an intrinsic lowered by the compiler.\n" [^uintptr a ^uintptr b] :results [uintptr bool]
  (when (or (< (bit-or a b) (<< 1 (* 4 goarch/PtrSize))) (== a 0))
    (return (* a b) false))

  (let [overflow (> b (/ MaxUintptr a))]
    (return (* a b) overflow)))








^{:go/end 41} (go/func Add64 "Add64 returns the sum with carry of x, y and carry: sum = x + y + carry.\nThe carry input must be 0 or 1; otherwise the behavior is undefined.\nThe carryOut output is guaranteed to be 0 or 1.\n\nThis function's execution time does not depend on the inputs.\nOn supported platforms this is an intrinsic lowered by the compiler.\n" [^uint64 x ^uint64 y ^uint64 carry] :results [^uint64 sum ^uint64 carryOut]
  (set! sum (+ x y carry))
  ;; The sum will overflow if both top bits are set (x & y) or if one of them
  ;; is (x | y), and a carry from the lower place happened. If such a carry
  ;; happens, the top bit will be 1 + 0 + 1 = 0 (&^ sum).
  (set! carryOut (>> (bit-or (bit-and x y) (bit-and-not (bit-or x y) sum)) 63))
  (return))

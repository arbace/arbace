(ns go.internal.runtime.maps
  (:require [arbace.go :as go]))

(go/package maps
  :path "internal/runtime/maps"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["group.go" "map.go" "memhash_aes.go" "memhash_aes_asm.go" "memhash_align_check.go" "runtime.go" "runtime_alg.go" "runtime_fast32.go" "runtime_fast64.go" "runtime_faststr.go" "runtime_hash64.go" "table.go" "table_debug.go"]
  :other-files ["memhash_amd64.s" "memhash_nosimd_amd64.s"]
  :init-order [["table.go" 24 5]]
  :positions :lines)

(load "maps/group")
(load "maps/map")
(load "maps/memhash_aes")
(load "maps/memhash_aes_asm")
(load "maps/memhash_align_check")
(load "maps/runtime")
(load "maps/runtime_alg")
(load "maps/runtime_fast32")
(load "maps/runtime_fast64")
(load "maps/runtime_faststr")
(load "maps/runtime_hash64")
(load "maps/table")
(load "maps/table_debug")

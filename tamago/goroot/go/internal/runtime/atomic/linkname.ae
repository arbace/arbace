(in-ns 'go.internal.runtime.atomic) (go/file "linkname.go" :imports [

    ^{:line 7} [_ "unsafe"]]) ; for linkname

;; Export some functions via linkname to assembly in sync/atomic.
;;
(go/directive "//go:linknamestd Load")
(go/directive "//go:linknamestd Loadp")
(go/directive "//go:linknamestd Load64")
(go/directive "//go:linknamestd Loaduintptr")
(go/directive "//go:linknamestd Xadd")
(go/directive "//go:linknamestd Xadd64")
(go/directive "//go:linknamestd Xadduintptr")
(go/directive "//go:linknamestd Xchg")
(go/directive "//go:linknamestd Xchg64")
(go/directive "//go:linknamestd Xchguintptr")
(go/directive "//go:linknamestd Cas")
(go/directive "//go:linknamestd Cas64")
(go/directive "//go:linknamestd Casint32")
(go/directive "//go:linknamestd Casint64")
(go/directive "//go:linknamestd Casuintptr")
(go/directive "//go:linknamestd Store")
(go/directive "//go:linknamestd Store64")
(go/directive "//go:linknamestd Storeuintptr")
(go/directive "//go:linknamestd And32")
(go/directive "//go:linknamestd And64")
(go/directive "//go:linknamestd Anduintptr")
(go/directive "//go:linknamestd Or32")
(go/directive "//go:linknamestd Or64")
(go/directive "//go:linknamestd Oruintptr")

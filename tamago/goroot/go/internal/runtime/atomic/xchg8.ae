(in-ns 'go.internal.runtime.atomic) (go/file "xchg8.go" :imports [


    ^{:line 8} [goarch "internal/goarch"]
    ^{:line 9} [unsafe "unsafe"]])



^{:go/end 32} (go/func ^:go/nosplit goXchg8 ^uint8 [^{:tag (* uint8)} addr ^uint8 v]
  ;; Align down to 4 bytes and use 32-bit CAS.
  (let [addr32 (conv (* uint32) (conv unsafe/Pointer (bit-and-not (conv uintptr (conv unsafe/Pointer addr)) 3)))
      ^{:line 16} shift (bit-and (conv uintptr (conv unsafe/Pointer addr)) 3)]
    (when goarch/BigEndian
      (set! shift (bit-xor shift 3)))

    (set! shift (* shift 8))
    (let [word (<< (conv uint32 v) shift)
        ^{:line 22} mask (<< (conv uint32 0xFF) shift)]

      (while true
        (let [old @addr32] ; Read the old 32-bit value
          ;; Clear the old 8 bits then insert the new value
          (when (Cas addr32 old (bit-or (bit-and-not old mask) word))
            ;; Return the old 8-bit value
            (return (conv uint8 (>> (bit-and old mask) shift)))))))))

(ns go.internal.pkgbits
  (:require [arbace.go :as go]))

(go/package pkgbits
  :path "internal/pkgbits"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["codes.go" "decoder.go" "doc.go" "encoder.go" "flags.go" "reloc.go" "support.go" "sync.go" "syncmarker_string.go" "version.go"]
  :init-order [overflow _SyncMarker_index introduced removed]
  :positions :lines)

(load "pkgbits/codes")
(load "pkgbits/decoder")
(load "pkgbits/doc")
(load "pkgbits/encoder")
(load "pkgbits/flags")
(load "pkgbits/reloc")
(load "pkgbits/support")
(load "pkgbits/sync")
(load "pkgbits/syncmarker_string")
(load "pkgbits/version")

(ns go.internal.goos
  (:require [arbace.go :as go]))

(go/package goos
  :path "internal/goos"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["goos.go" "nonunix.go" "zgoos_tamago.go"]
  :init-order []
  :positions :lines)

(load "goos/goos")
(load "goos/nonunix")
(load "goos/zgoos_tamago")

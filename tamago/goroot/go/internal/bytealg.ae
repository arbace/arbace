(ns go.internal.bytealg
  (:require [arbace.go :as go]))

(go/package bytealg
  :path "internal/bytealg"
  :files ["bytealg.go" "compare_native.go" "count_native.go" "equal_generic.go" "equal_native.go" "index_amd64.go" "index_arm64.go" "index_native.go" "indexbyte_native.go" "lastindexbyte_generic.go"]
  :other-files ["compare_amd64.s" "compare_arm64.s" "count_amd64.s" "count_arm64.s" "equal_amd64.s" "equal_arm64.s" "index_amd64.s" "index_arm64.s" "indexbyte_amd64.s" "indexbyte_arm64.s"]
  :positions :lines)

(load "bytealg/bytealg")
(load "bytealg/compare_native")
(load "bytealg/count_native")
(load "bytealg/equal_generic")
(load "bytealg/equal_native")
(load "bytealg/index_amd64")
(load "bytealg/index_arm64")
(load "bytealg/index_native")
(load "bytealg/indexbyte_native")
(load "bytealg/lastindexbyte_generic")

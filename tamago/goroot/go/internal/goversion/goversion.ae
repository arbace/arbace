(in-ns 'go.internal.goversion) (go/file "goversion.go" :imports [])






(go/const ^{:val 27 :doc "Version is the Go 1.x version which is currently\nin development and will eventually get released.\n\nIt should be updated at the start of each development cycle to be\nthe version of the next Go 1.x release. See go.dev/issue/40705.\n"} Version 27)

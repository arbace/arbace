(in-ns 'go.internal.dag) (go/file "alg.go" :imports [])


^{:go/end 21} (go/method Transpose "Transpose reverses all edges in g.\n" [^{:tag (* Graph)} g]
  (let [old (.-edges g)]

    (set! (.-edges g) (make (map string (map string bool))))
    (range [_ n (.-Nodes g)]
      (aset (.-edges g) n (make (map string bool))))


    (range [from tos old]
      (range [to tos]
        (aset (aget (.-edges g) to) from true)))))





^{:go/end 46} (go/method Topo "Topo returns a topological sort of g. This function is deterministic.\n" ^{:tag (slice string)} [^{:tag (* Graph)} g]
  (let [topo (make (slice string) 0 (len (.-Nodes g)))
      ^{:line 26} marks (make (map string bool))

      ^{:line 28 :tag (func [^string n])} visit (zero (func [^string n]))]
    (set! visit ^{:go/end 38} (fn [^string n]
        (when (aget marks n)
          (return))

        (range [_ to (.Edges g n)]
          (visit to))

        (aset marks n true)
        (set! topo (append topo n))))

    (range [_ root (.-Nodes g)]
      (visit root))

    (for [(values i j) (values 0 (- (len topo) 1))] (< i j) (set! (values i j) (values (+ i 1) (- j 1)))
      (set! (values (aget topo i) (aget topo j)) (values (aget topo j) (aget topo i))))

    ^{:line 45} topo))




^{:go/end 63} (go/method TransitiveReduction "TransitiveReduction removes edges from g that are transitively\nreachable. g must be transitively closed.\n" [^{:tag (* Graph)} g]
  ;; For i -> j -> k, if i -> k exists, delete it.
  (range [_ i (.-Nodes g)]
    (range [_ j (.-Nodes g)]
      (when (.HasEdge g i j)
        (range [_ k (.-Nodes g)]
          (when (.HasEdge g j k)
            (.DelEdge g i k)))))))

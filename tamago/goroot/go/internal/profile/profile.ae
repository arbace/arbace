^{:go/end 151} (go/func Parse "Parse parses a profile and checks for its validity. The input must be an\nencoded pprof protobuf, which may optionally be gzip-compressed.\n" [^io/Reader r] :results [(* Profile) error]
  (let [(values orig err) (io/ReadAll r)]
    (when (!= err nil)
      (return nil err))


    (when (and (>= (len orig) 2) (== (aget orig 0) 0x1f) (== (aget orig 1) 0x8b))
      (let [(values gz err) (gzip/NewReader (bytes/NewBuffer orig))]
        (when (!= err nil)
          (return nil (fmt/Errorf "decompressing profile: %v" err)))

        (let [(values data ^:assign err) (io/ReadAll gz)]
          (when (!= err nil)
            (return nil (fmt/Errorf "decompressing profile: %v" err)))

          (set! orig data))))


    (let [(values p ^:assign err) (parseUncompressed orig)]
      (when (!= err nil)
        (return nil (fmt/Errorf "parsing profile: %w" err)))


      (when [err (.CheckValid p)] (!= err nil)
        (return nil (fmt/Errorf "malformed profile: %v" err)))

      (return p nil))))


(go/var errMalformed (fmt/Errorf "malformed profile format"))
(go/var ErrNoData (fmt/Errorf "empty input file"))

^{:go/end 171} (go/func parseUncompressed [^{:tag (slice byte)} data] :results [(* Profile) error]
  (when (== (len data) 0)
    (return nil ErrNoData))


  (let [p (addr (lit Profile))]
    (when [err (unmarshal data p)] (!= err nil)
      (return nil err))


    (when [err (.postDecode p)] (!= err nil)
      (return nil err))


    (return p nil)))



^{:go/end 183} (go/method Write "Write writes the profile as a gzip-compressed marshaled protobuf.\n" ^error [^{:tag (* Profile)} p ^io/Writer w]
  (.preEncode p)
  (let [b (marshal p)
      ^{:line 177} zw (gzip/NewWriter w)]
    (when [(values _ err) (.Write zw b)] (!= err nil)
      (.Close zw)
      (return err))

    (.Close zw)))






^{:go/end 246} (go/method CheckValid "CheckValid tests whether the profile is valid. Checks include, but are\nnot limited to:\n  - len(Profile.Sample[n].value) == len(Profile.value_unit)\n  - Sample.id has a corresponding Profile.Location\n" ^error [^{:tag (* Profile)} p]
  ;; Check that sample values are consistent
  (let [sampleLen (len (.-SampleType p))]
    (when (and (== sampleLen 0) (!= (len (.-Sample p)) 0))
      (return (fmt/Errorf "missing sample type information")))

    (range [_ s (.-Sample p)]
      (when (!= (len (.-Value s)) sampleLen)
        (return (fmt/Errorf "mismatch: sample has: %d values vs. %d types" (len (.-Value s)) (len (.-SampleType p))))))



    ;; Check that all mappings/locations/functions are in the tables
    ;; Check that there are no duplicate ids
    (let [mappings (make (map uint64 (* Mapping)) (len (.-Mapping p)))]
      (range [_ m (.-Mapping p)]
        (when (== (.-ID m) 0)
          (return (fmt/Errorf "found mapping with reserved ID=0")))

        (when (!= (aget mappings (.-ID m)) nil)
          (return (fmt/Errorf "multiple mappings with same id: %d" (.-ID m))))

        (aset mappings (.-ID m) m))

      (let [functions (make (map uint64 (* Function)) (len (.-Function p)))]
        (range [_ f (.-Function p)]
          (when (== (.-ID f) 0)
            (return (fmt/Errorf "found function with reserved ID=0")))

          (when (!= (aget functions (.-ID f)) nil)
            (return (fmt/Errorf "multiple functions with same id: %d" (.-ID f))))

          (aset functions (.-ID f) f))

        ^{:go/breaks [[3 245]]} (let [locations (make (map uint64 (* Location)) (len (.-Location p)))]
          (range [_ l (.-Location p)]
            (when (== (.-ID l) 0)
              (return (fmt/Errorf "found location with reserved id=0")))

            (when (!= (aget locations (.-ID l)) nil)
              (return (fmt/Errorf "multiple locations with same id: %d" (.-ID l))))

            (aset locations (.-ID l) l)
            (when [m (.-Mapping l)] (!= m nil)
              (when (or (== (.-ID m) 0) (!= (aget mappings (.-ID m)) m))
                (return (fmt/Errorf "inconsistent mapping %p: %d" m (.-ID m)))))


            (range [_ ln (.-Line l)]
              (when [f (.-Function ln)] (!= f nil)
                (when (or (== (.-ID f) 0) (!= (aget functions (.-ID f)) f))
                  (return (fmt/Errorf "inconsistent function %p: %d" f (.-ID f)))))))




          nil)))))





^{:go/end 290} (go/method Aggregate "Aggregate merges the locations in the profile into equivalence\nclasses preserving the request attributes. It also updates the\nsamples to point to the merged locations.\n" ^error [^{:tag (* Profile)} p ^bool inlineFrame ^bool function ^bool filename ^bool linenumber ^bool address]
  (range [_ m (.-Mapping p)]
    (set! (.-HasInlineFrames m) (and (.-HasInlineFrames m) inlineFrame))
    (set! (.-HasFunctions m) (and (.-HasFunctions m) function))
    (set! (.-HasFilenames m) (and (.-HasFilenames m) filename))
    (set! (.-HasLineNumbers m) (and (.-HasLineNumbers m) linenumber)))


  ;; Aggregate functions
  (when (or (not function) (not filename))
    (range [_ f (.-Function p)]
      (when (not function)
        (set! (.-Name f) "")
        (set! (.-SystemName f) ""))

      (when (not filename)
        (set! (.-Filename f) ""))))




  ;; Aggregate locations
  (when (or (not inlineFrame) (not address) (not linenumber))
    (range [_ l (.-Location p)]
      (when (and (not inlineFrame) (> (len (.-Line l)) 1))
        (set! (.-Line l) (subslice (.-Line l) (- (len (.-Line l)) 1))))

      (when (not linenumber)
        (range [i (.-Line l)]
          (set! (.-Line (aget (.-Line l) i)) 0)))


      (when (not address)
        (set! (.-Address l) 0))))




  (.CheckValid p))




^{:go/end 392} (go/method String "Print dumps a text representation of a profile. Intended mainly\nfor debugging purposes.\n" ^string [^{:tag (* Profile)} p]

  (let [ss (make (slice string) 0 (+ (len (.-Sample p)) (len (.-Mapping p)) (len (.-Location p))))]
    (when [pt (.-PeriodType p)] (!= pt nil)
      (set! ss (append ss (fmt/Sprintf "PeriodType: %s %s" (.-Type pt) (.-Unit pt)))))

    (set! ss (append ss (fmt/Sprintf "Period: %d" (.-Period p))))
    (when (!= (.-TimeNanos p) 0)
      (set! ss (append ss (fmt/Sprintf "Time: %v" (time/Unix 0 (.-TimeNanos p))))))

    (when (!= (.-DurationNanos p) 0)
      (set! ss (append ss (fmt/Sprintf "Duration: %v" (conv time/Duration (.-DurationNanos p))))))


    (set! ss (append ss "Samples:"))
    (let [^string sh1 (zero string)]
      (range [_ s (.-SampleType p)]
        (set! sh1 (+ sh1 (fmt/Sprintf "%s/%s " (.-Type s) (.-Unit s)))))

      (set! ss (append ss (strings/TrimSpace sh1)))
      (range [_ s (.-Sample p)]
        (let [^string sv (zero string)]
          (range [_ v (.-Value s)]
            (set! sv (fmt/Sprintf "%s %10d" sv v)))

          (set! sv (+ sv ": "))
          (range [_ l (.-Location s)]
            (set! sv (+ sv (fmt/Sprintf "%d " (.-ID l)))))

          (set! ss (append ss sv))
          (let [^:const ^{:val "                "} labelHeader "                "]
            (when (> (len (.-Label s)) 0)
              (let [ls labelHeader]
                (range [k v (.-Label s)]
                  (set! ls (+ ls (fmt/Sprintf "%s:%v " k v))))

                (set! ss (append ss ls))))

            (when (> (len (.-NumLabel s)) 0)
              (let [ls labelHeader]
                (range [k v (.-NumLabel s)]
                  (set! ls (+ ls (fmt/Sprintf "%s:%v " k v))))

                (set! ss (append ss ls)))))))



      (set! ss (append ss "Locations"))
      (range [_ l (.-Location p)]
        (let [locStr (fmt/Sprintf "%6d: %#x " (.-ID l) (.-Address l))]
          (when [m (.-Mapping l)] (!= m nil)
            (set! locStr (+ locStr (fmt/Sprintf "M=%d " (.-ID m)))))

          (when (== (len (.-Line l)) 0)
            (set! ss (append ss locStr)))

          (range [li (.-Line l)]
            (let [lnStr "??"]
              (when [fn (.-Function (aget (.-Line l) li))] (!= fn nil)
                (set! lnStr (fmt/Sprintf "%s %s:%d s=%d"
                    (.-Name fn)
                    (.-Filename fn)
                    (.-Line (aget (.-Line l) li))
                    (.-StartLine fn)))
                (when (!= (.-Name fn) (.-SystemName fn))
                  (set! lnStr (+ lnStr "(" (.-SystemName fn) ")"))))


              (set! ss (append ss (+ locStr lnStr)))
              ;; Do not print location details past the first line
              (set! locStr "             ")))))



      (set! ss (append ss "Mappings"))
      (range [_ m (.-Mapping p)]
        (let [bits ""]
          (when (.-HasFunctions m)
            (set! bits + "[FN]"))

          (when (.-HasFilenames m)
            (set! bits + "[FL]"))

          (when (.-HasLineNumbers m)
            (set! bits + "[LN]"))

          (when (.-HasInlineFrames m)
            (set! bits + "[IN]"))

          (set! ss (append ss (fmt/Sprintf "%d: %#x/%#x/%#x %s %s %s"
                (.-ID m)
                (.-Start m) (.-Limit m) (.-Offset m)
                (.-File m)
                (.-BuildID m)
                ^{:line 388} bits)))))


      (+ (strings/Join ss "\n") "\n"))))






^{:go/end 434} (go/method Merge "Merge adds profile p adjusted by ratio r into profile p. Profiles\nmust be compatible (same Type and SampleType).\nTODO(rsilvera): consider normalizing the profiles based on the\ntotal samples collected.\n" ^error [^{:tag (* Profile)} p ^{:tag (* Profile)} pb ^float64 r]
  (when [err (.Compatible p pb)] (!= err nil)
    (return err))


  (set! pb (.Copy pb))

  ;; Keep the largest of the two periods.
  (when (> (.-Period pb) (.-Period p))
    (set! (.-Period p) (.-Period pb)))


  (set! (.-DurationNanos p) + (.-DurationNanos pb))

  (set! (.-Mapping p) (append (.-Mapping p) (spread (.-Mapping pb))))
  (range [i m (.-Mapping p)]
    (set! (.-ID m) (conv uint64 (+ i 1))))

  (set! (.-Location p) (append (.-Location p) (spread (.-Location pb))))
  (range [i l (.-Location p)]
    (set! (.-ID l) (conv uint64 (+ i 1))))

  (set! (.-Function p) (append (.-Function p) (spread (.-Function pb))))
  (range [i f (.-Function p)]
    (set! (.-ID f) (conv uint64 (+ i 1))))


  (when (!= r 1.0)
    (range [_ s (.-Sample pb)]
      (range [i v (.-Value s)]
        (aset (.-Value s) i (conv int64 (* (conv float64 v) r))))))



  (set! (.-Sample p) (append (.-Sample p) (spread (.-Sample pb))))
  (.CheckValid p))





^{:go/breaks [[7 454]] :go/end 455} (go/method Compatible "Compatible determines if two profiles can be compared/merged.\nreturns nil if the profiles are compatible; otherwise an error with\ndetails on the incompatibility.\n" ^error [^{:tag (* Profile)} p ^{:tag (* Profile)} pb]
  (when (not (compatibleValueTypes (.-PeriodType p) (.-PeriodType pb)))
    (return (fmt/Errorf "incompatible period types %v and %v" (.-PeriodType p) (.-PeriodType pb))))


  (when (!= (len (.-SampleType p)) (len (.-SampleType pb)))
    (return (fmt/Errorf "incompatible sample types %v and %v" (.-SampleType p) (.-SampleType pb))))


  (range [i (.-SampleType p)]
    (when (not (compatibleValueTypes (aget (.-SampleType p) i) (aget (.-SampleType pb) i)))
      (return (fmt/Errorf "incompatible sample types %v and %v" (.-SampleType p) (.-SampleType pb)))))



  nil)




^{:go/breaks [[5 465]] :go/end 466} (go/method HasFunctions "HasFunctions determines if all locations in this profile have\nsymbolized function information.\n" ^bool [^{:tag (* Profile)} p]
  (range [_ l (.-Location p)]
    (when (or (== (.-Mapping l) nil) (not (.-HasFunctions (.-Mapping l))))
      (return false)))


  true)




^{:go/breaks [[5 476]] :go/end 477} (go/method HasFileLines "HasFileLines determines if all locations in this profile have\nsymbolized file and line number information.\n" ^bool [^{:tag (* Profile)} p]
  (range [_ l (.-Location p)]
    (when (or (== (.-Mapping l) nil) ^:go/paren (or (not (.-HasFilenames (.-Mapping l))) (not (.-HasLineNumbers (.-Mapping l)))))
      (return false)))


  true)


^{:go/end 484} (go/func compatibleValueTypes ^bool [^{:tag (* ValueType)} v1 ^{:tag (* ValueType)} v2]
  (when (or (== v1 nil) (== v2 nil))
    (return true)) ; No grounds to disqualify.

  (and (== (.-Type v1) (.-Type v2)) (== (.-Unit v1) (.-Unit v2))))




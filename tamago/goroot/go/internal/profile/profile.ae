  (.preEncode p)
  (let [b (marshal p)

      ^{:line 491} pp (addr (lit Profile))]
    (when [err (unmarshal b pp)] (!= err nil)
      (panic err))

    (when [err (.postDecode pp)] (!= err nil)
      (panic err))


    ^{:line 499} pp))





(go/type Demangler "Demangler maps symbol names to a human-readable form. This may\ninclude C++ demangling and additional simplification. Names that\nare not demangled may be missing from the resulting map.\n" (func [^{:tag (slice string)} name] [(map string string) error]))




^{:go/end 528} (go/method Demangle "Demangle attempts to demangle and optionally simplify any function\nnames referenced in the profile. It works on a best-effort basis:\nit will silently preserve the original names in case of any errors.\n" ^error [^{:tag (* Profile)} p ^Demangler d]
  ;; Collect names to demangle.
  (let [^{:tag (slice string)} names (zero (slice string))]
    (range [_ fn (.-Function p)]
      (set! names (append names (.-SystemName fn))))


    ;; Update profile with demangled names.
    ^{:go/breaks [[4 527]]} (let [(values demangled err) (d names)]
      (when (!= err nil)
        (return err))

      (range [_ fn (.-Function p)]
        (when [(values dd ok) (aget demangled (.-SystemName fn))] ok
          (set! (.-Name fn) dd)))


      nil)))



^{:go/end 533} (go/method Empty "Empty reports whether the profile contains no samples.\n" ^bool [^{:tag (* Profile)} p]
  (== (len (.-Sample p)) 0))



^{:go/end 545} (go/method Scale "Scale multiplies all sample values in a profile by a constant.\n" [^{:tag (* Profile)} p ^float64 ratio]
  (when (== ratio 1)
    (return))

  (let [ratios (make (slice float64) (len (.-SampleType p)))]
    (range [i (.-SampleType p)]
      (aset ratios i ratio))

    (.ScaleN p ratios)))



^{:go/end 570} (go/method ScaleN "ScaleN multiplies each sample values in a sample by a different amount.\n" ^error [^{:tag (* Profile)} p ^{:tag (slice float64)} ratios]
  (when (!= (len (.-SampleType p)) (len ratios))
    (return (fmt/Errorf "mismatched scale ratios, got %d, want %d" (len ratios) (len (.-SampleType p)))))

  ^{:go/breaks [[5 569]]} (let [allOnes true]
    (range [_ r ratios]
      (when (!= r 1)
        (set! allOnes false)
        (break)))


    (when allOnes
      (return nil))

    (range [_ s (.-Sample p)]
      (range [i v (.-Value s)]
        (when (!= (aget ratios i) 1)
          (aset (.-Value s) i (conv int64 (* (conv float64 v) (aget ratios i)))))))



    nil))

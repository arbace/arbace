;; Implements methods to remove frames from profiles.

(in-ns 'go.internal.profile) (go/file "prune.go" :imports [


    ^{:line 10} [fmt "fmt"]
    ^{:line 11} [regexp "regexp"]])





^{:go/end 77} (go/method Prune "Prune removes all nodes beneath a node matching dropRx, and not\nmatching keepRx. If the root node of a Sample matches, the sample\nwill have an empty stack.\n" [^{:tag (* Profile)} p ^{:tag (* regexp/Regexp)} dropRx ^{:tag (* regexp/Regexp)} keepRx]
  (let [prune (make (map uint64 bool))
      ^{:line 19} pruneBeneath (make (map uint64 bool))]

    (range [_ loc (.-Location p)]
      (let [^int i (zero int)]
        (for [(set! i (- (len (.-Line loc)) 1))] (>= i 0) (dec! i)
          (when [fn (.-Function (aget (.-Line loc) i))] (and (!= fn nil) (!= (.-Name fn) ""))
            (let [funcName (.-Name fn)]
              ;; Account for leading '.' on the PPC ELF v1 ABI.
              (when (== (aget funcName 0) \.)
                (set! funcName (subslice funcName 1)))

              (when (.MatchString dropRx funcName)
                (when (or (== keepRx nil) (not (.MatchString keepRx funcName)))
                  (break))))))





        (when (>= i 0)
          ;; Found matching entry to prune.
          (aset pruneBeneath (.-ID loc) true)

          ;; Remove the matching location.
          (if (== i (- (len (.-Line loc)) 1))
            ;; Matched the top entry: prune the whole location.
            (aset prune (.-ID loc) true)

            (set! (.-Line loc) (subslice (.-Line loc) (+ i 1)))))))




    ;; Prune locs from each Sample
    (range [_ sample (.-Sample p)]
      ;; Scan from the root to the leaves to find the prune location.
      ;; Do not prune frames before the first user frame, to avoid
      ;; pruning everything.
      (let [foundUser false]
        (for [i (- (len (.-Location sample)) 1)] (>= i 0) (dec! i)
          (let [id (.-ID (aget (.-Location sample) i))]
            (when (and (not (aget prune id)) (not (aget pruneBeneath id)))
              (set! foundUser true)
              (continue))

            (when (not foundUser)
              (continue))

            (when (aget prune id)
              (set! (.-Location sample) (subslice (.-Location sample) (+ i 1)))
              (break))

            (when (aget pruneBeneath id)
              (set! (.-Location sample) (subslice (.-Location sample) i))
              (break))))))))







^{:go/end 97} (go/method RemoveUninteresting "RemoveUninteresting prunes and elides profiles using built-in\ntables of uninteresting function names.\n" ^error [^{:tag (* Profile)} p]
  ^{:go/breaks [[3 96]]} (let [(values ^{:tag (* regexp/Regexp)} keep ^{:tag (* regexp/Regexp)} drop) (zero (* regexp/Regexp))
      ^{:line 83 :tag error} err (zero error)]

    (when (!= (.-DropFrames p) "")
      (when [(set! (values drop err) (regexp/Compile (+ "^(" (.-DropFrames p) ")$")))] (!= err nil)
        (return (fmt/Errorf "failed to compile regexp %s: %v" (.-DropFrames p) err)))

      (when (!= (.-KeepFrames p) "")
        (when [(set! (values keep err) (regexp/Compile (+ "^(" (.-KeepFrames p) ")$")))] (!= err nil)
          (return (fmt/Errorf "failed to compile regexp %s: %v" (.-KeepFrames p) err))))


      (.Prune p drop keep))

    nil))

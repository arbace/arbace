^{:go/end 106} (go/method preEncode "preEncode populates the unexported fields to be used by encode\n(with suffix X) from the corresponding exported fields. The\nexported fields are cleared up to facilitate testing.\n" [^{:tag (* Profile)} p]
  (let [strings (make (map string int))]
    (addString strings "")

    (range [_ st (.-SampleType p)]
      (set! (.-typeX st) (addString strings (.-Type st)))
      (set! (.-unitX st) (addString strings (.-Unit st))))


    (range [_ s (.-Sample p)]
      (set! (.-labelX s) nil)
      (let [^{:tag (slice string)} keys (zero (slice string))]
        (range [k (.-Label s)]
          (set! keys (append keys k)))

        (sort/Strings keys)
        (range [_ k keys]
          (let [vs (aget (.-Label s) k)]
            (range [_ v vs]
              (set! (.-labelX s) (append (.-labelX s)
                  ^{:go/breaks [2 4]} (lit Label
                    :keyX (addString strings k)
                    :strX (addString strings v)))))))




        (let [^{:tag (slice string)} numKeys (zero (slice string))]
          (range [k (.-NumLabel s)]
            (set! numKeys (append numKeys k)))

          (sort/Strings numKeys)
          (range [_ k numKeys]
            (let [vs (aget (.-NumLabel s) k)]
              (range [_ v vs]
                (set! (.-labelX s) (append (.-labelX s)
                    ^{:go/breaks [2 4]} (lit Label
                      :keyX (addString strings k)
                      :numX v))))))




          (set! (.-locationIDX s) nil)
          (range [_ l (.-Location s)]
            (set! (.-locationIDX s) (append (.-locationIDX s) (.-ID l)))))))



    (range [_ m (.-Mapping p)]
      (set! (.-fileX m) (addString strings (.-File m)))
      (set! (.-buildIDX m) (addString strings (.-BuildID m))))


    (range [_ l (.-Location p)]
      (range [i ln (.-Line l)]
        (if (!= (.-Function ln) nil)
          (set! (.-functionIDX (aget (.-Line l) i)) (.-ID (.-Function ln)))

          (set! (.-functionIDX (aget (.-Line l) i)) 0)))


      (if (!= (.-Mapping l) nil)
        (set! (.-mappingIDX l) (.-ID (.-Mapping l)))

        (set! (.-mappingIDX l) 0)))


    (range [_ f (.-Function p)]
      (set! (.-nameX f) (addString strings (.-Name f)))
      (set! (.-systemNameX f) (addString strings (.-SystemName f)))
      (set! (.-filenameX f) (addString strings (.-Filename f))))


    (set! (.-dropFramesX p) (addString strings (.-DropFrames p)))
    (set! (.-keepFramesX p) (addString strings (.-KeepFrames p)))

    (when [pt (.-PeriodType p)] (!= pt nil)
      (set! (.-typeX pt) (addString strings (.-Type pt)))
      (set! (.-unitX pt) (addString strings (.-Unit pt))))


    (set! (.-stringTable p) (make (slice string) (len strings)))
    (range [s i strings]
      (aset (.-stringTable p) i s))))



^{:go/end 133} (go/method encode [^{:tag (* Profile)} p ^{:tag (* buffer)} b]
  (range [_ x (.-SampleType p)]
    (encodeMessage b 1 x))

  (range [_ x (.-Sample p)]
    (encodeMessage b 2 x))

  (range [_ x (.-Mapping p)]
    (encodeMessage b 3 x))

  (range [_ x (.-Location p)]
    (encodeMessage b 4 x))

  (range [_ x (.-Function p)]
    (encodeMessage b 5 x))

  (encodeStrings b 6 (.-stringTable p))
  (encodeInt64Opt b 7 (.-dropFramesX p))
  (encodeInt64Opt b 8 (.-keepFramesX p))
  (encodeInt64Opt b 9 (.-TimeNanos p))
  (encodeInt64Opt b 10 (.-DurationNanos p))
  (when [pt (.-PeriodType p)] (and (!= pt nil) ^:go/paren (or (!= (.-typeX pt) 0) (!= (.-unitX pt) 0)))
    (encodeMessage b 11 (.-PeriodType p)))

  (encodeInt64Opt b 12 (.-Period p)))



^{:go/end 295} (go/method postDecode "postDecode takes the unexported fields populated by decode (with\nsuffix X) and populates the corresponding exported fields.\nThe unexported fields are cleared up to facilitate testing.\n" ^error [^{:tag (* Profile)} p]
  (let [^error err (zero error)

      ^{:line 212} mappings (make (map uint64 (* Mapping)))]
    (range [_ m (.-Mapping p)]
      (set! (values (.-File m) err) (getString (.-stringTable p) (addr (.-fileX m)) err))
      (set! (values (.-BuildID m) err) (getString (.-stringTable p) (addr (.-buildIDX m)) err))
      (aset mappings (.-ID m) m))


    (let [functions (make (map uint64 (* Function)))]
      (range [_ f (.-Function p)]
        (set! (values (.-Name f) err) (getString (.-stringTable p) (addr (.-nameX f)) err))
        (set! (values (.-SystemName f) err) (getString (.-stringTable p) (addr (.-systemNameX f)) err))
        (set! (values (.-Filename f) err) (getString (.-stringTable p) (addr (.-filenameX f)) err))
        (aset functions (.-ID f) f))


      (let [locations (make (map uint64 (* Location)))]
        (range [_ l (.-Location p)]
          (set! (.-Mapping l) (aget mappings (.-mappingIDX l)))
          (set! (.-mappingIDX l) 0)
          (range [i ln (.-Line l)]
            (when [id (.-functionIDX ln)] (!= id 0)
              (set! (.-Function (aget (.-Line l) i)) (aget functions id))
              (when (== (.-Function (aget (.-Line l) i)) nil)
                (return (fmt/Errorf "function ID %d not found" id)))

              (set! (.-functionIDX (aget (.-Line l) i)) 0)))


          (aset locations (.-ID l) l))


        (range [_ st (.-SampleType p)]
          (set! (values (.-Type st) err) (getString (.-stringTable p) (addr (.-typeX st)) err))
          (set! (values (.-Unit st) err) (getString (.-stringTable p) (addr (.-unitX st)) err)))


        (range [_ s (.-Sample p)]
          (let [labels (make (map string (slice string)))
              ^{:line 250} numLabels (make (map string (slice int64)))]
            (range [_ l (.-labelX s)]
              (let [(values ^string key ^string value) (zero string)]
                (set! (values key err) (getString (.-stringTable p) (addr (.-keyX l)) err))
                (if (!= (.-strX l) 0) (do
                    (set! (values value err) (getString (.-stringTable p) (addr (.-strX l)) err))
                    (aset labels key (append (aget labels key) value)))

                  (aset numLabels key (append (aget numLabels key) (.-numX l))))))


            (when (> (len labels) 0)
              (set! (.-Label s) labels))

            (when (> (len numLabels) 0)
              (set! (.-NumLabel s) numLabels))

            (set! (.-Location s) nil)
            (range [_ lid (.-locationIDX s)]
              (set! (.-Location s) (append (.-Location s) (aget locations lid))))

            (set! (.-locationIDX s) nil)))


        (set! (values (.-DropFrames p) err) (getString (.-stringTable p) (addr (.-dropFramesX p)) err))
        (set! (values (.-KeepFrames p) err) (getString (.-stringTable p) (addr (.-keepFramesX p)) err))

        (when [pt (.-PeriodType p)] (== pt nil)
          (set! (.-PeriodType p) (addr (lit ValueType))))


        (when [pt (.-PeriodType p)] (!= pt nil)
          (set! (values (.-Type pt) err) (getString (.-stringTable p) (addr (.-typeX pt)) err))
          (set! (values (.-Unit pt) err) (getString (.-stringTable p) (addr (.-unitX pt)) err)))

        (range [_ i (.-commentX p)]
          (let [^string c (zero string)]
            (set! (values c err) (getString (.-stringTable p) (addr i) err))
            (set! (.-Comments p) (append (.-Comments p) c))))


        (set! (.-commentX p) nil)
        (set! (values (.-DefaultSampleType p) err) (getString (.-stringTable p) (addr (.-defaultSampleTypeX p)) err))
        (set! (.-stringTable p) nil)
        ^{:line 294} err))))



^{:go/end 470} (go/func addString ^int64 [^{:tag (map string int)} strings ^string s]
  (let [(values i ok) (aget strings s)]
    (when (not ok)
      (set! i (len strings))
      (aset strings s i))

    (conv int64 i)))


^{:go/end 482} (go/func getString [^{:tag (slice string)} strings ^{:tag (* int64)} strng ^error err] :results [string error]
  (when (!= err nil)
    (return "" err))

  (let [s (conv int @strng)]
    (when (or (< s 0) (>= s (len strings)))
      (return "" errMalformed))

    (set! @strng 0)
    (return (aget strings s) nil)))

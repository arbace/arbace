  (encodeVarint b (conv uint64 len)))


^{:go/end 68} (go/func encodeUint64 [^{:tag (* buffer)} b ^int tag ^uint64 x]
  ;; append varint to b.data
  (encodeVarint b (bit-or (<< (conv uint64 tag) 3) 0))
  (encodeVarint b x))


^{:go/end 88} (go/func encodeUint64s [^{:tag (* buffer)} b ^int tag ^{:tag (slice uint64)} x]
  (when (> (len x) 2)
    ;; Use packed encoding
    (let [n1 (len (.-data b))]
      (range [_ u x]
        (encodeVarint b u))

      (let [n2 (len (.-data b))]
        (encodeLength b tag (- n2 n1))
        (let [n3 (len (.-data b))]
          (copy (subslice (.-tmp b)) (subslice (.-data b) n2 n3))
          (copy (subslice (.-data b) (+ n1 (- n3 n2))) (subslice (.-data b) n1 n2))
          (copy (subslice (.-data b) n1) (subslice (.-tmp b) _ (- n3 n2)))
          (return)))))

  (range [_ u x]
    (encodeUint64 b tag u)))




;; This file is a simple protocol buffer encoder and decoder.
;;
;; A protocol message must implement the message interface:
;;   decoder() []decoder
;;   encode(*buffer)
;;
;; The decode method returns a slice indexed by field number that gives the
;; function to decode that field.
;; The encode method encodes its receiver into the given buffer.
;;
;; The two methods are simple enough to be implemented by hand rather than
;; by using a protocol compiler.
;;
;; See profile.go for examples of messages implementing this interface.
;;
;; There is no support for groups, message sets, or "has" bits.

(in-ns 'go.internal.profile) (go/file "proto.go" :imports [


    ^{:line 25} [errors "errors"]
    ^{:line 26} [fmt "fmt"]
    ^{:line 27} [slices "slices"]])


(go/type buffer (struct
    ^{:line 31 :tag int} field
    ^{:line 32 :tag int} typ
    ^{:line 33 :tag uint64} u64
    ^{:line 34 :tag (slice byte)} data
    ^{:line 35 :tag (array 16 byte)} tmp))


(go/type decoder (func [(* buffer) message] [error]))

(go/type message (interface
    (decoder ^{:tag (slice decoder)} [])
    (encode [(* buffer)])))


^{:go/end 49} (go/func marshal ^{:tag (slice byte)} [^message m]
  (let [^buffer b (zero buffer)]
    (.encode m (addr b))
    (.-data b)))


^{:go/end 57} (go/func encodeVarint [^{:tag (* buffer)} b ^uint64 x]
  (while (>= x 128)
    (set! (.-data b) (append (.-data b) (bit-or (conv byte x) 0x80)))
    (set! x >> 7))

  (set! (.-data b) (append (.-data b) (conv byte x))))


^{:go/end 62} (go/func encodeLength [^{:tag (* buffer)} b ^int tag ^int len]

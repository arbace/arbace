^{:go/end 246} (go/func decodeField [^{:tag (* buffer)} b ^{:tag (slice byte)} data] :results [(slice byte) error]
  (let [(values x ^:assign data err) (decodeVarint data)]
    (when (!= err nil)
      (return nil err))

    (set! (.-field b) (conv int (>> x 3)))
    (set! (.-typ b) (conv int (bit-and x 7)))
    (set! (.-data b) nil)
    (set! (.-u64 b) 0)
    (switch (.-typ b)
      (case [0]
        (set! (values (.-u64 b) data err) (decodeVarint data))
        (when (!= err nil)
          (return nil err)))

      (case [1]
        (when (< (len data) 8)
          (return nil (errors/New "not enough data")))

        (set! (.-u64 b) (le64 (subslice data _ 8)))
        (set! data (subslice data 8)))
      (case [2]
        (let [^uint64 n (zero uint64)]
          (set! (values n data err) (decodeVarint data))
          (when (!= err nil)
            (return nil err))

          (when (> n (conv uint64 (len data)))
            (return nil (errors/New "too much data")))

          (set! (.-data b) (subslice data _ n))
          (set! data (subslice data n))))
      (case [5]
        (when (< (len data) 4)
          (return nil (errors/New "not enough data")))

        (set! (.-u64 b) (conv uint64 (le32 (subslice data _ 4))))
        (set! data (subslice data 4)))
      (default
        (return nil (fmt/Errorf "unknown wire type: %d" (.-typ b)))))


    (return data nil)))



;; Implements methods to filter samples from profiles.

(in-ns 'go.internal.profile) (go/file "filter.go" :imports [])


(go/type TagMatch "TagMatch selects tags for filtering\n" (func [^string key ^string val ^int64 nval] [bool]))




^{:go/end 27} (go/method FilterSamplesByTag "FilterSamplesByTag removes all samples from the profile, except\nthose that match focus and do not match the ignore regular\nexpression.\n" [^{:tag (* Profile)} p ^TagMatch focus ^TagMatch ignore] :results [^bool fm ^bool im]
  (let [samples (make (slice (* Sample)) 0 (len (.-Sample p)))]
    (range [_ s (.-Sample p)]
      (let [(values focused ignored) (focusedSample s focus ignore)]
        (set! fm (or fm focused))
        (set! im (or im ignored))
        (when (and focused (not ignored))
          (set! samples (append samples s)))))


    (set! (.-Sample p) samples)
    (return)))




^{:go/end 54} (go/func focusedSample "focusedSample checks a sample against focus and ignore regexps.\nReturns whether the focus/ignore regexps match any tags.\n" [^{:tag (* Sample)} s ^TagMatch focus ^TagMatch ignore] :results [^bool fm ^bool im]
  (set! fm (== focus nil))
  (range [key vals (.-Label s)]
    (range [_ val vals]
      (when (and (!= ignore nil) (ignore key val 0))
        (set! im true))

      (when (and (not fm) (focus key val 0))
        (set! fm true))))



  (range [key vals (.-NumLabel s)]
    (range [_ val vals]
      (when (and (!= ignore nil) (ignore key "" val))
        (set! im true))

      (when (and (not fm) (focus key "" val))
        (set! fm true))))



  (return fm im))

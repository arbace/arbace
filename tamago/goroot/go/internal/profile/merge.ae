^{:go/end 68} (go/func Merge "Merge merges all the profiles in profs into a single Profile.\nReturns a new profile independent of the input profiles. The merged\nprofile is compacted to eliminate unused samples, locations,\nfunctions and mappings. Profiles must have identical profile sample\nand period types or the merge will fail. profile.Period of the\nresulting profile will be the maximum of all profiles, and\nprofile.TimeNanos will be the earliest nonzero one.\n" [^{:tag (slice (* Profile))} srcs] :results [(* Profile) error]
  (when (== (len srcs) 0)
    (return nil (fmt/Errorf "no profiles to merge")))

  (let [(values p err) (combineHeaders srcs)]
    (when (!= err nil)
      (return nil err))


    (let [pm (addr ^{:go/breaks [2 4 6 8 10]} (lit profileMerger
            :p p
            :samples (make (map sampleKey (* Sample)) (len (.-Sample (aget srcs 0))))
            :locations (make (map locationKey (* Location)) (len (.-Location (aget srcs 0))))
            :functions (make (map functionKey (* Function)) (len (.-Function (aget srcs 0))))
            :mappings (make (map mappingKey (* Mapping)) (len (.-Mapping (aget srcs 0))))))]


      (range [_ src srcs]
        ;; Clear the profile-specific hash tables
        (set! (.-locationsByID pm) (make (map uint64 (* Location)) (len (.-Location src))))
        (set! (.-functionsByID pm) (make (map uint64 (* Function)) (len (.-Function src))))
        (set! (.-mappingsByID pm) (make (map uint64 mapInfo) (len (.-Mapping src))))

        (when (and (== (len (.-mappings pm)) 0) (> (len (.-Mapping src)) 0))
          ;; The Mapping list has the property that the first mapping
          ;; represents the main binary. Take the first Mapping we see,
          ;; otherwise the operations below will add mappings in an
          ;; arbitrary order.
          (.mapMapping pm (aget (.-Mapping src) 0)))


        (range [_ s (.-Sample src)]
          (when (not (isZeroSample s))
            (.mapSample pm s))))




      (range [_ s (.-Sample p)]
        (when (isZeroSample s)
          ;; If there are any zero samples, re-merge the profile to GC
          ;; them.
          (return (Merge (lit (slice (* Profile)) p)))))



      (return p nil))))





^{:go/end 103} (go/method Normalize "Normalize normalizes the source profile by multiplying each value in profile by the\nratio of the sum of the base profile's values of that sample type to the sum of the\nsource profile's value of that sample type.\n" ^error [^{:tag (* Profile)} p ^{:tag (* Profile)} pb]


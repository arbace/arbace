    (range [_ s (.-Sample pb)]
      (range [i v (.-Value s)]
        (set! (aget baseVals i) + v)))



    (let [srcVals (make (slice int64) (len (.-SampleType p)))]
      (range [_ s (.-Sample p)]
        (range [i v (.-Value s)]
          (set! (aget srcVals i) + v)))



      ^{:go/breaks [4]} (let [normScale (make (slice float64) (len baseVals))]
        (range [i baseVals]
          (if (== (aget srcVals i) 0)
            (aset normScale i 0.0)

            (aset normScale i (/ (conv float64 (aget baseVals i)) (conv float64 (aget srcVals i))))))


        (.ScaleN p normScale)
        nil))))



^{:go/end 435} (go/func combineHeaders "combineHeaders checks that all profiles can be merged and returns\ntheir combined profile.\n" [^{:tag (slice (* Profile))} srcs] :results [(* Profile) error]
  (range [_ s (subslice srcs 1)]
    (when [err (.compatible (aget srcs 0) s)] (!= err nil)
      (return nil err)))



  (let [(values ^int64 timeNanos ^int64 durationNanos ^int64 period) (zero int64)

        (set! timeNanos (.-TimeNanos s)))

      (set! durationNanos + (.-DurationNanos s))
      (when (or (== period 0) (< period (.-Period s)))
        (set! period (.-Period s)))

      (range [_ c (.-Comments s)]
        (when [seen (aget seenComments c)] (not seen)
          (set! comments (append comments c))
          (aset seenComments c true)))


      (when (== defaultSampleType "")
        (set! defaultSampleType (.-DefaultSampleType s))))



    (let [p (addr ^{:go/breaks [2 [4 422] 6 [8 425] 10 12 14 [16 430] 18]} (lit Profile
            :SampleType (make (slice (* ValueType)) (len (.-SampleType (aget srcs 0))))

            :DropFrames (.-DropFrames (aget srcs 0))
            :KeepFrames (.-KeepFrames (aget srcs 0))

            :TimeNanos timeNanos
            :DurationNanos durationNanos
            :PeriodType (.-PeriodType (aget srcs 0))
            :Period period

            :Comments comments
            :DefaultSampleType defaultSampleType))]

      (copy (.-SampleType p) (.-SampleType (aget srcs 0)))
      (return p nil))))






(in-ns 'go.internal.testenv) (go/file "testenv_notwin.go" :build ["//go:build !windows"] :imports [


    ^{:line 10} [fmt "fmt"]
    ^{:line 11} [os "os"]
    ^{:line 12} [filepath "path/filepath"]
    ^{:line 13} [runtime "runtime"]
    ^{:line 14} [sync "sync"]])


(go/var hasSymlink (^{:inst [bool string]} sync/OnceValues ^{:go/end 47} (fn [] :results [^bool ok ^string reason]
      (switch runtime/GOOS
        (case ["plan9" "tamago"]
          (return false ""))
        (case ["android" "wasip1"]
          ;; For wasip1, some runtimes forbid absolute symlinks,
          ;; or symlinks that escape the current working directory.
          ;; Perform a simple test to see whether the runtime
          ;; supports symlinks or not. If we get a permission
          ;; error, the runtime does not support symlinks.
          (let [(values dir err) (os/MkdirTemp "" "")]
            (when (!= err nil)
              (return false ""))

            (defer (^{:go/end 33} (fn []
                  (set! _ (os/RemoveAll dir)))))

            (let [fpath (filepath/Join dir "testfile.txt")]
              (when [err (os/WriteFile fpath nil 0644)] (!= err nil)
                (return false ""))

              (when [err (os/Symlink fpath (filepath/Join dir "testlink"))] (!= err nil)
                (when (SyscallIsNotSupported err)
                  (return false (fmt/Sprintf "symlinks unsupported: %s" (.Error err))))

                (return false ""))))))



      (return true ""))))

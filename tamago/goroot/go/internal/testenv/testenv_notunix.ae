(in-ns 'go.internal.testenv) (go/file "testenv_notunix.go" :build ["//go:build windows || plan9 || (js && wasm) || wasip1 || tamago"] :imports [


    ^{:line 10} [errors "errors"]
    ^{:line 11} [fs "io/fs"]
    ^{:line 12} [os "os"]])




(go/var ^{:doc "Sigquit is the signal to send to kill a hanging subprocess.\nOn Unix we send SIGQUIT, but on non-Unix we only have os.Kill.\n"} Sigquit os/Kill)

^{:go/end 21} (go/func syscallIsNotSupported ^bool [^error err]
  (or (errors/Is err fs/ErrPermission) (errors/Is err errors/ErrUnsupported)))

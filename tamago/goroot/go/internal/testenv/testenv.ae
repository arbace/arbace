^{:go/end 526} (go/func WriteImportcfg "WriteImportcfg writes an importcfg file used by the compiler or linker to\ndstPath containing entries for the file mappings in packageFiles, as well\nas for the packages transitively imported by the package(s) in pkgs.\n\npkgs may include any package pattern that is valid to pass to 'go list',\nso it may also be a list of Go source files all in the same directory.\n" [^testing/TB t ^string dstPath ^{:tag (map string string)} packageFiles & ^{:tag (slice string)} pkgs]
  (.Helper t)

  (let [icfg (new bytes/Buffer)]
    (.WriteString icfg "# import config\n")
    (range [k v packageFiles]
      (fmt/Fprintf icfg "packagefile %s=%s\n" k v))


    (when (> (len pkgs) 0)
      ;; Use 'go list' to resolve any missing packages and rewrite the import map.
      (let [cmd (Command t (GoToolPath t) "list" "-export" "-deps" "-f" "{{if ne .ImportPath \"command-line-arguments\"}}{{if .Export}}{{.ImportPath}}={{.Export}}{{end}}{{end}}")]
        (set! (.-Args cmd) (append (.-Args cmd) (spread pkgs)))
        (set! (.-Stderr cmd) (new strings/Builder))
        (let [(values out err) (.Output cmd)]
          (when (!= err nil)
            (.Fatalf t "%v: %v\n%s" cmd err (.-Stderr cmd)))


          (range [line (strings/SplitSeq (conv string out) "\n")]
            (when (== line "")
              (continue))

            (let [(values importPath export ok) (strings/Cut line "=")]
              (when (not ok)
                (.Fatalf t "invalid line in output from %v:\n%s" cmd line))

              (when (== (aget packageFiles importPath) "")
                (fmt/Fprintf icfg "packagefile %s=%s\n" importPath export)))))))




    (when [err (os/WriteFile dstPath (.Bytes icfg) 0666)] (!= err nil)
      (.Fatal t err))))






^{:go/end 385} (go/func MustInternalLink "MustInternalLink checks that the current system can link programs with internal\nlinking.\nIf not, MustInternalLink calls t.Skip with an explanation.\n" [^testing/TB t ^SpecialBuildTypes with]
  (when (or (.-Asan with) (.-Msan with) (.-Race with))
    (.Skipf t "skipping test: internal linking with sanitizers is not supported"))

  (when (not (CanInternalLink (.-Cgo with)))
    (.Helper t)
    (when (and (.-Cgo with) (CanInternalLink false))
      (.Skipf t "skipping test: internal linking on %s/%s is not supported with cgo" runtime/GOOS runtime/GOARCH))

    (.Skipf t "skipping test: internal linking on %s/%s is not supported" runtime/GOOS runtime/GOARCH)))







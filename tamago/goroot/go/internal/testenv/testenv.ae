;; Package testenv provides information about what functionality
;; is available in different testing environments run by the Go team.
;;
;; It is an internal package because these details are specific
;; to the Go team's test setup (on build.golang.org) and not
;; fundamental to tests in general.
(in-ns 'go.internal.testenv) (go/file "testenv.go" :doc "Package testenv provides information about what functionality\nis available in different testing environments run by the Go team.\n\nIt is an internal package because these details are specific\nto the Go team's test setup (on build.golang.org) and not\nfundamental to tests in general.\n" :imports [


    ^{:line 14} [bytes "bytes"]
    ^{:line 15} [errors "errors"]
    ^{:line 16} [flag "flag"]
    ^{:line 17} [fmt "fmt"]
    ^{:line 18} [cfg "internal/cfg"]
    ^{:line 19} [goarch "internal/goarch"]
    ^{:line 20} [platform "internal/platform"]
    ^{:line 21} [os "os"]
    ^{:line 22} [exec "os/exec"]
    ^{:line 23} [filepath "path/filepath"]
    ^{:line 24} [runtime "runtime"]
    ^{:line 25} [strconv "strconv"]
    ^{:line 26} [strings "strings"]
    ^{:line 27} [sync "sync"]
    ^{:line 28} [testing "testing"]])






(go/var ^{:doc "Save the original environment during init for use in checks. A test\nbinary may modify its environment before calling HasExec to change its\nbehavior (such as mimicking a command-line tool), and that modified\nenvironment might cause environment checks to behave erratically.\n"} origEnv (os/Environ))










^{:go/end 48} (go/func Builder "Builder reports the name of the builder running this test. For example,\n\"gotip-linux-amd64_avx512-test_only\" or \"go1.24-windows-arm64\" on LUCI,\nor \"linux-amd64\" on our old infrastructure. Prefer using runtime.GOOS,\nruntime.GOARCH, race.Enabled, reading the OS version, checking CPU\nfeature flags with internal/cpu, etc. over parsing builder names when\npossible. When matching builder names, prefer a fuzzy match instead\nof a strict comparison.\nIf the test is not running on the build infrastructure,\nBuilder returns the empty string.\n" ^string []
  (os/Getenv "GO_BUILDER_NAME"))




^{:go/end 62} (go/func HasGoBuild "HasGoBuild reports whether the current system can build programs with “go build”\nand then run them with os.StartProcess or exec.Command.\n" ^bool []
  (when (!= (os/Getenv "GO_GCFLAGS") "")
    ;; It's too much work to require every caller of the go command
    ;; to pass along "-gcflags="+os.Getenv("GO_GCFLAGS").
    ;; For now, if $GO_GCFLAGS is set, report that we simply can't
    ;; run go build.
    (return false))


  (== (tryGoBuild) nil))


(go/var tryGoBuild (^{:inst [error]} sync/OnceValue ^{:go/end 113} (fn ^error []
      ;; To run 'go build', we need to be able to exec a 'go' command.
      ;; We somewhat arbitrarily choose to exec 'go tool -n compile' because that
      ;; also confirms that cmd/go can find the compiler. (Before CL 472096,
      ;; we sometimes ended up with cmd/go installed in the test environment
      ;; without a cmd/compile it could use to actually build things.)
      (let [(values goTool err) (goTool)]
        (when (!= err nil)
          (return err))

        (let [cmd (exec/Command goTool "tool" "-n" "compile")]
          (set! (.-Env cmd) origEnv)
          ^{:go/breaks [[7 112]]} (let [(values out ^:assign err) (.Output cmd)]
            (when (!= err nil)
              (return (fmt/Errorf "%v: %w" cmd err)))

            (set! out (bytes/TrimSpace out))
            (when (== (len out) 0)
              (return (fmt/Errorf "%v: no tool reported" cmd)))

            (when [(values _ err) (exec/LookPath (conv string out))] (!= err nil)
              (return err))


            (when (platform/MustLinkExternal runtime/GOOS runtime/GOARCH false)
              ;; We can assume that we always have a complete Go toolchain available.
              ;; However, this platform requires a C linker to build even pure Go
              ;; programs, including tests. Do we have one in the test environment?
              ;; (On Android, for example, the device running the test might not have a
              ;; C toolchain installed.)
              ;;
              ;; If CC is set explicitly, assume that we do. Otherwise, use 'go env CC'
              ;; to determine which toolchain it would use by default.
              (when (== (os/Getenv "CC") "")
                (let [cmd (exec/Command goTool "env" "CC")]
                  (set! (.-Env cmd) origEnv)
                  (let [(values out err) (.Output cmd)]
                    (when (!= err nil)
                      (return (fmt/Errorf "%v: %w" cmd err)))

                    (set! out (bytes/TrimSpace out))
                    (when (== (len out) 0)
                      (return (fmt/Errorf "%v: no CC reported" cmd)))

                    (set! (values _ err) (exec/LookPath (conv string out)))
                    (return err)))))


            nil))))))





^{:go/end 127} (go/func MustHaveGoBuild "MustHaveGoBuild checks that the current system can build programs with “go build”\nand then run them with os.StartProcess or exec.Command.\nIf not, MustHaveGoBuild calls t.Skip with an explanation.\n" [^testing/TB t]
  (when (!= (os/Getenv "GO_GCFLAGS") "")
    (.Helper t)
    (.Skipf t "skipping test: 'go build' not compatible with setting $GO_GCFLAGS"))

  (when (not (HasGoBuild))
    (.Helper t)
    (.Skipf t "skipping test: 'go build' unavailable: %v" (tryGoBuild))))





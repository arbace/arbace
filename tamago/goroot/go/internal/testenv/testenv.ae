(go/var hasCgo (^{:inst [bool]} sync/OnceValue ^{:go/end 344} (fn ^bool []
      (let [(values goTool err) (goTool)]
        (when (!= err nil)
          (return false))

        (let [cmd (exec/Command goTool "env" "CGO_ENABLED")]
          (set! (.-Env cmd) origEnv)
          (let [(values out ^:assign err) (.Output cmd)]
            (when (!= err nil)
              (panic (fmt/Sprintf "%v: %v" cmd out)))

            (let [(values ok ^:assign err) (strconv/ParseBool (conv string (bytes/TrimSpace out)))]
              (when (!= err nil)
                (panic (fmt/Sprintf "%v: non-boolean output %q" cmd out)))

              ^{:line 343} ok)))))))




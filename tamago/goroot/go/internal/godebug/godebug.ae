;; Package godebug makes the settings in the $GODEBUG environment variable
;; available to other packages. These settings are often used for compatibility
;; tweaks, when we need to change a default behavior but want to let users
;; opt back in to the original. For example GODEBUG=http2server=0 disables
;; HTTP/2 support in the net/http server.
;;
;; In typical usage, code should declare a Setting as a global
;; and then call Value each time the current setting value is needed:
;;
;;	var http2server = godebug.New("http2server")
;;
;;	func ServeConn(c net.Conn) {
;;		if http2server.Value() == "0" {
;;			disallow HTTP/2
;;			...
;;		}
;;		...
;;	}
;;
;; Each time a non-default setting causes a change in program behavior,
;; code must call [Setting.IncNonDefault] to increment a counter that can
;; be reported by [runtime/metrics.Read]. The call must only happen when
;; the program executes a non-default behavior, not just when the setting
;; is set to a non-default value. This is occasionally (but very rarely)
;; infeasible, in which case the internal/godebugs table entry must set
;; Opaque: true, and the documentation in doc/godebug.md should
;; mention that metrics are unavailable.
;;
;; Conventionally, the global variable representing a godebug is named
;; for the godebug itself, with no case changes:
;;
;;	var gotypesalias = godebug.New("gotypesalias") // this
;;	var goTypesAlias = godebug.New("gotypesalias") // NOT THIS
;;
;; The test in internal/godebugs that checks for use of IncNonDefault
;; requires the use of this convention.
;;
;; Note that counters used with IncNonDefault must be added to
;; various tables in other packages. See the [Setting.IncNonDefault]
;; documentation for details.
(in-ns 'go.internal.godebug) (go/file "godebug.go" :doc "Package godebug makes the settings in the $GODEBUG environment variable\navailable to other packages. These settings are often used for compatibility\ntweaks, when we need to change a default behavior but want to let users\nopt back in to the original. For example GODEBUG=http2server=0 disables\nHTTP/2 support in the net/http server.\n\nIn typical usage, code should declare a Setting as a global\nand then call Value each time the current setting value is needed:\n\n\tvar http2server = godebug.New(\"http2server\")\n\n\tfunc ServeConn(c net.Conn) {\n\t\tif http2server.Value() == \"0\" {\n\t\t\tdisallow HTTP/2\n\t\t\t...\n\t\t}\n\t\t...\n\t}\n\nEach time a non-default setting causes a change in program behavior,\ncode must call [Setting.IncNonDefault] to increment a counter that can\nbe reported by [runtime/metrics.Read]. The call must only happen when\nthe program executes a non-default behavior, not just when the setting\nis set to a non-default value. This is occasionally (but very rarely)\ninfeasible, in which case the internal/godebugs table entry must set\nOpaque: true, and the documentation in doc/godebug.md should\nmention that metrics are unavailable.\n\nConventionally, the global variable representing a godebug is named\nfor the godebug itself, with no case changes:\n\n\tvar gotypesalias = godebug.New(\"gotypesalias\") // this\n\tvar goTypesAlias = godebug.New(\"gotypesalias\") // NOT THIS\n\nThe test in internal/godebugs that checks for use of IncNonDefault\nrequires the use of this convention.\n\nNote that counters used with IncNonDefault must be added to\nvarious tables in other packages. See the [Setting.IncNonDefault]\ndocumentation for details.\n" :imports [

    ;; Note: Be careful about new imports here. Any package
    ;; that internal/godebug imports cannot itself import internal/godebug,
    ;; meaning it cannot introduce a GODEBUG setting of its own.
    ;; We keep imports to the absolute bare minimum.

    ^{:line 52} [bisect "internal/bisect"]
    ^{:line 53} [godebugs "internal/godebugs"]
    ^{:line 54} [sync "sync"]
    ^{:line 55} [atomic "sync/atomic"]
    ^{:line 56} [unsafe "unsafe"]
    ^{:line 57} [_ "unsafe"]]) ; go:linkname



(go/type Setting "A Setting is a single setting in the $GODEBUG environment variable.\n" (struct
    ^{:line 62 :tag string} name
    ^{:line 63 :tag sync/Once} once
    (* setting)))


(go/type setting (struct
    ^{:line 68 :tag (atomic/Pointer value)} value
    ^{:line 69 :tag sync/Once} nonDefaultOnce
    ^{:line 70 :tag atomic/Uint64} nonDefault
    ^{:line 71 :tag (* godebugs/Info)} info))


(go/type value (struct
    ^{:line 75 :tag string} text
    ^{:line 76 :tag (* bisect/Matcher)} bisect))
















^{:go/end 95} (go/func New "New returns a new Setting for the $GODEBUG setting with the given name.\n\nGODEBUGs meant for use by end users must be listed in ../godebugs/table.go,\nwhich is used for generating and checking various documentation.\nIf the name is not listed in that table, New will succeed but calling Value\non the returned Setting will panic.\nTo disable that panic for access to an undocumented setting,\nprefix the name with a #, as in godebug.New(\"#gofsystrace\").\nThe # is a signal to New but not part of the key used in $GODEBUG.\n\nNote that almost all settings should arrange to call [IncNonDefault] precisely\nwhen program behavior is changing from the default due to the setting\n(not just when the setting is different, but when program behavior changes).\nSee the [internal/godebug] package comment for more.\n" ^{:tag (* Setting)} [^string name]
  (addr (lit Setting :name name)))



^{:go/end 103} (go/method Name "Name returns the name of the setting.\n" ^string [^{:tag (* Setting)} s]
  (when (and (!= (.-name s) "") (== (aget (.-name s) 0) \#))
    (return (subslice (.-name s) 1)))

  (.-name s))



^{:go/end 108} (go/method Undocumented "Undocumented reports whether this is an undocumented setting.\n" ^bool [^{:tag (* Setting)} s]
  (and (!= (.-name s) "") (== (aget (.-name s) 0) \#)))



^{:go/end 113} (go/method String "String returns a printable form for the setting: name=value.\n" ^string [^{:tag (* Setting)} s]
  (+ (.Name s) "=" (.Value s)))








^{:go/end 124} (go/method IncNonDefault "IncNonDefault increments the non-default behavior counter\nassociated with the given setting.\nThis counter is exposed in the runtime/metrics value\n/godebug/non-default-behavior/<name>:events.\n\nNote that Value must be called at least once before IncNonDefault.\n" [^{:tag (* Setting)} s]
  (.Do ^{:go/via [setting]} (.-nonDefaultOnce s) (.-register s))
  (.Add ^{:go/via [setting]} (.-nonDefault s) 1))


^{:go/end 131} (go/method register [^{:tag (* Setting)} s]
  (when (or (== ^{:go/via [setting]} (.-info s) nil) (.-Opaque ^{:go/via [setting]} (.-info s)))
    (panic (+ "godebug: unexpected IncNonDefault of " (.-name s))))

  (registerMetric (+ "/godebug/non-default-behavior/" (.Name s) ":events") (.-Load ^{:go/via [setting]} (.-nonDefault s))))















(go/var ^{:tag sync/Map :doc "cache is a cache of all the GODEBUG settings,\na locked map[string]*atomic.Pointer[string].\n\nAll Settings with the same name share a single\n*atomic.Pointer[string], so that when GODEBUG\nchanges only that single atomic string pointer\nneeds to be updated.\n\nA name appears in the values map either if it is the\nname of a Setting for which Value has been called\nat least once, or if the name has ever appeared in\na name=value pair in the $GODEBUG environment variable.\nOnce entered into the map, the name is never removed.\n"} cache) ; name string -> value *atomic.Pointer[string]

(go/var ^value empty)








^{:go/end 169} (go/method Value "Value returns the current value for the GODEBUG setting s.\n\nValue maintains an internal cache that is synchronized\nwith changes to the $GODEBUG environment variable,\nmaking Value efficient to call as frequently as needed.\nClients should therefore typically not attempt their own\ncaching of Value's result.\n" ^string [^{:tag (* Setting)} s]
  (.Do (.-once s) ^{:go/end 163} (fn []
      (set! (.-setting s) (lookup (.Name s)))
      (when (and (== ^{:go/via [setting]} (.-info s) nil) (not (.Undocumented s)))
        (panic (+ "godebug: Value of name not listed in godebugs.All: " (.-name s))))))


  (let [v @(.Load ^{:go/via [setting]} (.-value s))]
    (when (and (!= (.-bisect v) nil) (not (.Stack (.-bisect v) (addr stderr))))
      (return ""))

    (.-text v)))



^{:go/end 185} (go/func lookup "lookup returns the unique *setting value for the given name.\n" ^{:tag (* setting)} [^string name]
  (when [(values v ok) (.Load cache name)] ok
    (return (assert (* setting) v)))

  (let [s (new setting)]
    (set! (.-info s) (godebugs/Lookup name))
    (.Store (.-value s) (addr empty))
    (when [(values v loaded) (.LoadOrStore cache name s)] loaded
      ;; Lost race: someone else created it. Use theirs.
      (return (assert (* setting) v)))


    ^{:line 184} s))










(go/func ^:extern ^{:go/linkname "setUpdate"} setUpdate "setUpdate is provided by package runtime.\nIt calls update(def, env), where def is the default GODEBUG setting\nand env is the current value of the $GODEBUG environment variable.\nAfter that first call, the runtime calls update(def, env)\nagain each time the environment variable changes\n(due to use of os.Setenv, for example).\n" [^{:tag (func [string string])} update])





(go/func ^:extern ^{:go/linkname "registerMetric"} registerMetric "registerMetric is provided by package runtime.\nIt forwards registrations to runtime/metrics.\n" [^string name ^{:tag (func [] [uint64])} read])













(go/func ^:extern ^{:go/linkname "setNewIncNonDefault"} setNewIncNonDefault "setNewIncNonDefault is provided by package runtime.\nThe runtime can do\n\n\tinc := newNonDefaultInc(name)\n\ninstead of\n\n\tinc := godebug.New(name).IncNonDefault\n\nsince it cannot import godebug.\n" [^{:tag (func [string] [(func [])])} newIncNonDefault])

^{:go/end 220} (go/func init []
  (setUpdate update)
  (setNewIncNonDefault newIncNonDefault))


^{:go/end 226} (go/func newIncNonDefault ^{:tag (func [])} [^string name]
  (let [s (New name)]
    (.Value s)
    (.-IncNonDefault s)))


(go/var ^sync/Mutex updateMu)




^{:go/end 258} (go/func update "update records an updated GODEBUG setting.\ndef is the default GODEBUG setting for the running binary,\nand env is the current value of the $GODEBUG environment variable.\n" [^string def ^string env]
  (.Lock updateMu)
  (defer (.Unlock updateMu))

  ;; Update all the cached values, creating new ones as needed.
  ;; We parse the environment variable first, so that any settings it has
  ;; are already locked in place (did[name] = true) before we consider
  ;; the defaults. Existing immutable settings are always locked.
  (let [did (make (map string bool))]
    (.Range cache ^{:go/breaks [[3 246]] :go/end 247} (fn ^bool [^any name ^any s]
        (when [info (.-info (assert (* setting) s))] (and (!= info nil) (.-Immutable info))
          (aset did (assert string name) true))

        true))

    (parse did env)
    (parse did def)

    ;; Clear any cached values that are no longer present.
    (.Range cache ^{:go/breaks [[3 256]] :go/end 257} (fn ^bool [^any name ^any s]
        (when (not (aget did (assert string name)))
          (.Store (.-value (assert (* setting) s)) (addr empty)))

        true))))











^{:go/end 299} (go/func parse "parse parses the GODEBUG setting string s,\nwhich has the form k=v,k2=v2,k3=v3.\nLater settings override earlier ones.\nParse only updates settings k=v for which did[k] = false.\nIt also sets did[k] = true for settings that it updates.\nEach value v can also have the form v#pattern,\nin which case the GODEBUG is only enabled for call stacks\nmatching pattern, for use with golang.org/x/tools/cmd/bisect.\n" [^{:tag (map string bool)} did ^string s]
  ;; Scan the string backward so that later settings are used
  ;; and earlier settings are ignored.
  ;; Note that a forward scan would cause cached values
  ;; to temporarily use the ignored value before being
  ;; updated to the "correct" one.
  (let [end (len s)
      ^{:line 275} eq -1]
    (for [i (- end 1)] (>= i -1) (dec! i)
      (cond (or (== i -1) (== (aget s i) \,)) (do
          (when (>= eq 0)
            (let [(values name arg) (values (subslice s (+ i 1) eq) (subslice s (+ eq 1) end))]
              (when (not (aget did name))
                (aset did name true)
                (let [v (addr (lit value :text arg))]
                  (for [j 0] (< j (len arg)) (inc! j)
                    (when (== (aget arg j) \#)
                      (set! (.-text v) (subslice arg _ j))
                      (set! (values (.-bisect v) _) (bisect/New (subslice arg (+ j 1))))
                      (break)))


                  (.Store (.-value (lookup name)) v)))))


          (set! eq -1)
          (set! end i))
        (== (aget s i) \=)
        (set! eq i)))))




(go/type runtimeStderr (struct))

(go/var ^runtimeStderr stderr)

^{:go/end 310} (go/method Write [(* runtimeStderr) ^{:tag (slice byte)} b] :results [int error]
  (when (> (len b) 0)
    (write 2 (conv unsafe/Pointer (addr (aget b 0))) (conv int32 (len b))))

  (return (len b) nil))






(go/func ^:extern ^{:go/linkname "write runtime.write"} write "Since we cannot import os or syscall, use the runtime's write function\nto print to standard error.\n" ^int32 [^uintptr fd ^unsafe/Pointer p ^int32 n])

(in-ns 'go.internal.filepathlite) (go/file "path_unix.go" :build ["//go:build unix || (js && wasm) || wasip1 || tamago"] :imports [


    ^{:line 10} [bytealg "internal/bytealg"]
    ^{:line 11} [stringslite "internal/stringslite"]])


(go/const
  ^{:line 15} [^{:val \/} Separator \/] ; OS-specific path separator
  ^{:line 16} [^{:val \:} ListSeparator \:]) ; OS-specific path list separator


^{:go/end 21} (go/func IsPathSeparator ^bool [^uint8 c]
  (== Separator c))


^{:go/end 25} (go/func isLocal ^bool [^string path]
  (unixIsLocal path))


^{:go/end 32} (go/func localize [^string path] :results [string error]
  (when (>= (bytealg/IndexByteString path 0) 0)
    (return "" errInvalidPath))

  (return path nil))



^{:go/end 37} (go/func IsAbs "IsAbs reports whether the path is absolute.\n" ^bool [^string path]
  (stringslite/HasPrefix path "/"))




^{:go/breaks [4] :go/end 43} (go/func volumeNameLen "volumeNameLen returns length of the leading volume name on Windows.\nIt returns 0 elsewhere.\n" ^int [^string path]
  0)

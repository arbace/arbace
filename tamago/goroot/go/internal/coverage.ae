(ns go.internal.coverage
  (:require [arbace.go :as go]))

(go/package coverage
  :path "internal/coverage"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["defs.go" "pkid.go"]
  :init-order [CovMetaMagic CovCounterMagic rtPkgs]
  :positions :lines)

(load "coverage/defs")
(load "coverage/pkid")

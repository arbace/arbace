^{:go/end 381} (go/method scalar [^{:tag (* Encoder)} w ^constant/Value val]
  (type-switch [v (constant/Val val)]
    (default
      (panicf "unhandled %v (%v)" val (.Kind val)))
    (case [bool]
      (.Code w ValBool)
      (.Bool w v))
    (case [string]
      (.Code w ValString)
      (.String w v))
    (case [int64]
      (.Code w ValInt64)
      (.Int64 w v))
    (case [(* big/Int)]
      (.Code w ValBigInt)
      (.bigInt w v))
    (case [(* big/Rat)]
      (.Code w ValBigRat)
      (.bigInt w (.Num v))
      (.bigInt w (.Denom v)))
    (case [(* big/Float)]
      (.Code w ValBigFloat)
      (.bigFloat w v))))




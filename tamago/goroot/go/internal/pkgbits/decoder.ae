    (let [^{:tag (array 32 uintptr)} readerPCs (zero (array 32 uintptr)) ; TODO(mdempsky): Dynamically size?
        ^{:line 349} n (runtime/Callers 2 (subslice readerPCs))]
      (range [_ pc (fmtFrames (spread (subslice readerPCs _ n)))]

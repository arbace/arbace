(in-ns 'go.internal.pkgbits) (go/file "sync.go" :imports [


    ^{:line 8} [fmt "fmt"]
    ^{:line 9} [runtime "runtime"]
    ^{:line 10} [strings "strings"]])



^{:go/end 23} (go/func fmtFrames "fmtFrames formats a backtrace for reporting reader/writer desyncs.\n" ^{:tag (slice string)} [& ^{:tag (slice uintptr)} pcs]
  (let [res (make (slice string) 0 (len pcs))]
    (walkFrames pcs ^{:go/end 21} (fn [^string file ^int line ^string name ^uintptr offset]
        ;; Trim package from function name. It's just redundant noise.
        (set! name (strings/TrimPrefix name "cmd/compile/internal/noder."))

        (set! res (append res (fmt/Sprintf "%s:%v: %s +0x%v" file line name offset)))))

    ^{:line 22} res))


(go/type frameVisitor (func [^string file ^int line ^string name ^uintptr offset]))




^{:go/end 43} (go/func walkFrames "walkFrames calls visit for each call frame represented by pcs.\n\npcs should be a slice of PCs, as returned by runtime.Callers.\n" [^{:tag (slice uintptr)} pcs ^frameVisitor visit]
  (when (== (len pcs) 0)
    (return))


  (let [frames (runtime/CallersFrames pcs)]
    (while true
      (let [(values frame more) (.Next frames)]
        (visit (.-File frame) (.-Line frame) (.-Function frame) (- (.-PC frame) (.-Entry frame)))
        (when (not more)
          (return))))))







(go/type SyncMarker "SyncMarker is an enum type that represents markers that may be\nwritten to export data to ensure the reader and writer stay\nsynchronized.\n" int)

(go/directive "//go:generate stringer -type=SyncMarker -trimprefix=Sync")


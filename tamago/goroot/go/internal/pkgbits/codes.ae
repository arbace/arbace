(in-ns 'go.internal.pkgbits) (go/file "codes.go" :imports [])





(go/type Code "A Code is an enum value that can be encoded into bitstreams.\n\nCode types are preferable for enum types, because they allow\nDecoder to detect desyncs.\n" (interface

    (^{:doc "Marker returns the SyncMarker for the Code's dynamic type.\n"} Marker ^SyncMarker [])


    (^{:doc "Value returns the Code's ordinal value.\n"} Value ^int [])))



(go/type CodeVal "A CodeVal distinguishes among go/constant.Value encodings.\n" int)

^{:go/end 22} (go/method Marker ^SyncMarker [^CodeVal c] SyncVal)
^{:go/end 23} (go/method Value ^int [^CodeVal c] (conv int c))

;; Note: These values are public and cannot be changed without
;; updating the go/types importers.

(go/const
  ^{:line 29} [^{:tag CodeVal :val 0} ValBool iota]
  ^{:line 30} [^{:val 1} ValString]
  ^{:line 31} [^{:val 2} ValInt64]
  ^{:line 32} [^{:val 3} ValBigInt]
  ^{:line 33} [^{:val 4} ValBigRat]
  ^{:line 34} [^{:val 5} ValBigFloat])



(go/type CodeType "A CodeType distinguishes among go/types.Type encodings.\n" int)

^{:go/end 40} (go/method Marker ^SyncMarker [^CodeType c] SyncType)
^{:go/end 41} (go/method Value ^int [^CodeType c] (conv int c))

;; Note: These values are public and cannot be changed without
;; updating the go/types importers.

(go/const
  ^{:line 47} [^{:tag CodeType :val 0} TypeBasic iota]
  ^{:line 48} [^{:val 1} TypeNamed]
  ^{:line 49} [^{:val 2} TypePointer]
  ^{:line 50} [^{:val 3} TypeSlice]
  ^{:line 51} [^{:val 4} TypeArray]
  ^{:line 52} [^{:val 5} TypeChan]
  ^{:line 53} [^{:val 6} TypeMap]
  ^{:line 54} [^{:val 7} TypeSignature]
  ^{:line 55} [^{:val 8} TypeStruct]
  ^{:line 56} [^{:val 9} TypeInterface]
  ^{:line 57} [^{:val 10} TypeUnion]
  ^{:line 58} [^{:val 11} TypeTypeParam])



(go/type CodeObj "A CodeObj distinguishes among go/types.Object encodings.\n" int)

^{:go/end 64} (go/method Marker ^SyncMarker [^CodeObj c] SyncCodeObj)
^{:go/end 65} (go/method Value ^int [^CodeObj c] (conv int c))

;; Note: These values are public and cannot be changed without
;; updating the go/types importers.

(go/const
  ^{:line 71} [^{:tag CodeObj :val 0} ObjAlias iota]
  ^{:line 72} [^{:val 1} ObjConst]
  ^{:line 73} [^{:val 2} ObjType]
  ^{:line 74} [^{:val 3} ObjFunc]
  ^{:line 75} [^{:val 4} ObjVar]
  ^{:line 76} [^{:val 5} ObjStub])

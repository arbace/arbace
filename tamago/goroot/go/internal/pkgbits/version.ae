(in-ns 'go.internal.pkgbits) (go/file "version.go" :imports [])






(go/type Version "Version indicates a version of a unified IR bitstream.\nEach Version indicates the addition, removal, or change of\nnew data in the bitstream.\n\nThese are serialized to disk and the interpretation remains fixed.\n" uint32)

(go/const




  ^{:line 19} [^{:tag Version :val 0 :doc "V0: initial prototype.\n\nAll data that is not assigned a Field is in version V0\nand has not been deprecated.\n"} V0 iota]


  ^{:line 22} [^{:val 1 :doc "V1: adds the Flags uint32 word\n"} V1]






  ^{:line 29} [^{:val 2 :doc "V2: removes unused legacy fields and supports type parameters for aliases.\n- remove the legacy \"has init\" bool from the public root\n- remove obj's \"derived func instance\" bool\n- add a TypeParamNames field to ObjAlias\n- remove derived info \"needed\" bool\n"} V2]





  ^{:line 35} [^{:val 3 :doc "V3: introduces a more compact format for composite literal element lists\n- negative lengths indicate that (some) elements may have keys\n- positive lengths indicate that no element has a key\n- a negative struct field index indicates an embedded field\n"} V3]


  ^{:line 38} [^{:val 4 :doc "V4: encodes generic methods as standalone function objects\n"} V4]

  ^{:line 40} [^{:val 5} numVersions iota])










(go/type Field "Field denotes a unit of data in the serialized unified IR bitstream.\nIt is conceptually a like field in a structure.\n\nWe only really need Fields when the data may or may not be present\nin a stream based on the Version of the bitstream.\n\nUnlike much of pkgbits, Fields are not serialized and\ncan change values as needed.\n" int)

(go/const


  ^{:line 56} [^{:tag Field :val 0 :doc "Flags in a uint32 in the header of a bitstream\nthat is used to indicate whether optional features are enabled.\n"} Flags iota]



  ^{:line 60} [^{:val 1 :doc "Deprecated: HasInit was a bool indicating whether a package\nhas any init functions.\n"} HasInit]



  ^{:line 64} [^{:val 2 :doc "Deprecated: DerivedFuncInstance was a bool indicating\nwhether an object was a function instance.\n"} DerivedFuncInstance]


  ^{:line 67} [^{:val 3 :doc "ObjAlias has a list of TypeParamNames.\n"} AliasTypeParamNames]



  ^{:line 71} [^{:val 4 :doc "Deprecated: DerivedInfoNeeded was a bool indicating\nwhether a type was a derived type.\n"} DerivedInfoNeeded]


  ^{:line 74} [^{:val 5 :doc "Composite literals use a more compact format for element lists.\n"} CompactCompLiterals]


  ^{:line 77} [^{:val 6 :doc "Generic methods may appear as standalone function objects.\n"} GenericMethods]

  ^{:line 79} [^{:val 7} numFields iota])



(go/var ^{:doc "introduced is the version a field was added.\n"} introduced (lit (array numFields Version)
    ^{:line 84} [Flags V1]
    ^{:line 85} [AliasTypeParamNames V2]
    ^{:line 86} [CompactCompLiterals V3]
    ^{:line 87} [GenericMethods V4]))





(go/var ^{:doc "removed is the version a field was removed in or 0 for fields\nthat have not yet been deprecated.\n(So removed[f]-1 is the last version it is included in.)\n"} removed (lit (array numFields Version)
    ^{:line 94} [HasInit V2]
    ^{:line 95} [DerivedFuncInstance V2]
    ^{:line 96} [DerivedInfoNeeded V2]))



^{:go/end 102} (go/method Has "Has reports whether field f is present in a bitstream at version v.\n" ^bool [^Version v ^Field f]
  (and (<= (aget introduced f) v) ^:go/paren (or (< v (aget removed f)) (== (aget removed f) V0))))

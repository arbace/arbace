(in-ns 'go.internal.pkgbits) (go/file "support.go" :imports [

    ^{:line 7} [fmt "fmt"]])

^{:go/end 13} (go/func assert [^bool b]
  (when (not b)
    (panic "assertion failed")))



^{:go/end 17} (go/func panicf [^string format & ^{:tag (slice any)} args]
  (panic (fmt/Errorf format (spread args))))

(ns go.internal.nettest
  (:require [arbace.go :as go]))

(go/package nettest
  :path "internal/nettest"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["conn.go" "listener.go" "packetconn.go" "queue.go"]
  :init-order [errClosedByPeer]
  :positions :lines)

(load "nettest/conn")
(load "nettest/listener")
(load "nettest/packetconn")
(load "nettest/queue")

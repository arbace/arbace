;; Package gate contains an alternative condition variable.
(in-ns 'go.internal.gate) (go/file "gate.go" :doc "Package gate contains an alternative condition variable.\n" :imports [

    ^{:line 8} [context "context"]])






(go/type Gate "A Gate is a monitor (mutex + condition variable) with one bit of state.\n\nThe condition may be either set or unset.\nLock operations may be unconditional, or wait for the condition to be set.\nUnlock operations record the new state of the condition.\n" (struct


    ^{:line 18 :tag (chan (struct)) :doc "When unlocked, exactly one of set or unset contains a value.\nWhen locked, neither chan contains a value.\n"} set
    ^{:line 19 :tag (chan (struct))} unset))



^{:go/end 30} (go/func New "New returns a new, unlocked gate.\n" ^Gate [^bool set]
  (let [g ^{:go/breaks [2 4]} (lit Gate
        :set (make (chan (struct)) 1)
        :unset (make (chan (struct)) 1))]

    (.Unlock g set)
    ^{:line 29} g))




^{:go/end 41} (go/method Lock "Lock acquires the gate unconditionally.\nIt reports whether the condition is set.\n" [^{:tag (* Gate)} g] :results [^bool set]
  (select
    (case (<! (.-set g))
      (return true))
    (case (<! (.-unset g))
      (return false))))





^{:go/end 57} (go/method WaitAndLock "WaitAndLock waits until the condition is set before acquiring the gate.\nIf the context expires, WaitAndLock returns an error and does not acquire the gate.\n" ^error [^{:tag (* Gate)} g ^context/Context ctx]
  (select
    (case (<! (.-set g))
      (return nil))
    (default))

  (select
    (case (<! (.-set g))
      (return nil))
    (case (<! (.Done ctx))
      (return (.Err ctx)))))




^{:go/end 67} (go/method LockIfSet "LockIfSet acquires the gate if and only if the condition is set.\n" [^{:tag (* Gate)} g] :results [^bool acquired]
  (select
    (case (<! (.-set g))
      (return true))
    (default
      (return false))))




^{:go/end 76} (go/method Unlock "Unlock sets the condition and releases the gate.\n" [^{:tag (* Gate)} g ^bool set]
  (if set
    (>! (.-set g) (lit (struct)))

    (>! (.-unset g) (lit (struct)))))

;; Package profilerecord holds internal types used to represent profiling
;; records with deep stack traces.
;;
;; TODO: Consider moving this to internal/runtime, see golang.org/issue/65355.
(in-ns 'go.internal.profilerecord) (go/file "profilerecord.go" :doc "Package profilerecord holds internal types used to represent profiling\nrecords with deep stack traces.\n\nTODO: Consider moving this to internal/runtime, see golang.org/issue/65355.\n" :imports [])

(go/type StackRecord (struct
    ^{:line 12 :tag (slice uintptr)} Stack))


(go/type MemProfileRecord (struct
    ^{:line 16 :tag int64} ObjectSize
    ^{:line 17 :tag int64} AllocObjects ^int64 FreeObjects
    ^{:line 18 :tag (slice uintptr)} Stack))


^{:go/end 21} (go/method InUseBytes ^int64 [^{:tag (* MemProfileRecord)} r] (* (.InUseObjects r) (.-ObjectSize r)))
^{:go/end 22} (go/method InUseObjects ^int64 [^{:tag (* MemProfileRecord)} r] (- (.-AllocObjects r) (.-FreeObjects r)))

(go/type BlockProfileRecord (struct
    ^{:line 25 :tag int64} Count
    ^{:line 26 :tag int64} Cycles
    ^{:line 27 :tag (slice uintptr)} Stack))

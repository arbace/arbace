;; Package gover implements support for Go toolchain versions like 1.21.0 and 1.21rc1.
;; (For historical reasons, Go does not use semver for its toolchains.)
;; This package provides the same basic analysis that golang.org/x/mod/semver does for semver.
;;
;; The go/version package should be imported instead of this one when possible.
;; Note that this package works on "1.21" while go/version works on "go1.21".
(in-ns 'go.internal.gover) (go/file "gover.go" :doc "Package gover implements support for Go toolchain versions like 1.21.0 and 1.21rc1.\n(For historical reasons, Go does not use semver for its toolchains.)\nThis package provides the same basic analysis that golang.org/x/mod/semver does for semver.\n\nThe go/version package should be imported instead of this one when possible.\nNote that this package works on \"1.21\" while go/version works on \"go1.21\".\n" :imports [


    ^{:line 14} [cmp "cmp"]])








(go/type Version "A Version is a parsed Go version: major[.Minor[.Patch]][kind[pre]]\nThe numbers are the original decimal strings to avoid integer overflows\nand since there is very little actual math. (Probably overflow doesn't matter in practice,\nbut at the time this code was written, there was an existing test that used\ngo1.99999999999, which does not fit in an int on 32-bit platforms.\nThe \"big decimal\" representation avoids the problem entirely.)\n" (struct
    ^{:line 24 :tag string} Major ; decimal
    ^{:line 25 :tag string} Minor ; decimal or ""
    ^{:line 26 :tag string} Patch ; decimal or ""
    ^{:line 27 :tag string} Kind ; "", "alpha", "beta", "rc"
    ^{:line 28 :tag string} Pre)) ; decimal or ""







^{:go/end 56} (go/func Compare "Compare returns -1, 0, or +1 depending on whether\nx < y, x == y, or x > y, interpreted as toolchain versions.\nThe versions x and y must not begin with a \"go\" prefix: just \"1.21\" not \"go1.21\".\nMalformed versions compare less than well-formed versions and equal to each other.\nThe language version \"1.21\" compares less than the release candidate and eventual releases \"1.21rc1\" and \"1.21.0\".\n" ^int [^string x ^string y]
  ^{:go/breaks [[7 55]]} (let [vx (Parse x)
      ^{:line 38} vy (Parse y)]

    (when [c (CmpInt (.-Major vx) (.-Major vy))] (!= c 0)
      (return c))

    (when [c (CmpInt (.-Minor vx) (.-Minor vy))] (!= c 0)
      (return c))

    (when [c (CmpInt (.-Patch vx) (.-Patch vy))] (!= c 0)
      (return c))

    (when [c (^{:inst [string]} cmp/Compare (.-Kind vx) (.-Kind vy))] (!= c 0) ; "" < alpha < beta < rc
      (return c))

    (when [c (CmpInt (.-Pre vx) (.-Pre vy))] (!= c 0)
      (return c))

    0))





^{:go/end 66} (go/func Max "Max returns the maximum of x and y interpreted as toolchain versions,\ncompared using Compare.\nIf x and y compare equal, Max returns x.\n" ^string [^string x ^string y]
  (when (< (Compare x y) 0)
    (return y))

  ^{:line 65} x)











^{:go/end 80} (go/func IsLang "IsLang reports whether v denotes the overall Go language version\nand not a specific release. Starting with the Go 1.21 release, \"1.x\" denotes\nthe overall language version; the first release is \"1.x.0\".\nThe distinction is important because the relative ordering is\n\n\t1.21 < 1.21rc1 < 1.21.0\n\nmeaning that Go 1.21rc1 and Go 1.21.0 will both handle go.mod files that\nsay \"go 1.21\", but Go 1.21rc1 will not handle files that say \"go 1.21.0\".\n" ^bool [^string x]
  (let [v (Parse x)]
    (and (!= v (lit Version)) (== (.-Patch v) "") (== (.-Kind v) "") (== (.-Pre v) ""))))



^{:go/end 89} (go/func Lang "Lang returns the Go language version. For example, Lang(\"1.2.3\") == \"1.2\".\n" ^string [^string x]
  (let [v (Parse x)]
    (when (or (== (.-Minor v) "") (and (== (.-Major v) "1") (== (.-Minor v) "0")))
      (return (.-Major v)))

    (+ (.-Major v) "." (.-Minor v))))



^{:go/end 94} (go/func IsValid "IsValid reports whether the version x is valid.\n" ^bool [^string x]
  (!= (Parse x) (lit Version)))




^{:go/end 169} (go/func Parse "Parse parses the Go version string x into a version.\nIt returns the zero version if x is malformed.\n" ^Version [^string x]
  (let [^Version v (zero Version)

      ;; Parse major version.
      ^{:line 102 :tag bool} ok (zero bool)]
    (set! (values (.-Major v) x ok) (cutInt x))
    (when (not ok)
      (return (lit Version)))

    (when (== x "")
      ;; Interpret "1" as "1.0.0".
      (set! (.-Minor v) "0")
      (set! (.-Patch v) "0")
      (return v))


    ;; Parse . before minor version.
    (when (!= (aget x 0) \.)
      (return (lit Version)))


    ;; Parse minor version.
    (set! (values (.-Minor v) x ok) (cutInt (subslice x 1)))
    (when (not ok)
      (return (lit Version)))

    (when (== x "")
      ;; Patch missing is same as "0" for older versions.
      ;; Starting in Go 1.21, patch missing is different from explicit .0.
      (when (< (CmpInt (.-Minor v) "21") 0)
        (set! (.-Patch v) "0"))

      (return v))


    ;; Parse patch if present.
    (when (== (aget x 0) \.)
      (set! (values (.-Patch v) x ok) (cutInt (subslice x 1)))
      (when (or (not ok) (!= x ""))
        ;; Note that we are disallowing prereleases (alpha, beta, rc) for patch releases here (x != "").
        ;; Allowing them would be a bit confusing because we already have:
        ;;	1.21 < 1.21rc1
        ;; But a prerelease of a patch would have the opposite effect:
        ;;	1.21.3rc1 < 1.21.3
        ;; We've never needed them before, so let's not start now.
        (return (lit Version)))

      (return v))


    ;; Parse prerelease.
    (let [i 0]
      (while (and (< i (len x)) ^:go/paren (or (< (aget x i) \0) (< \9 (aget x i))))
        (when (or (< (aget x i) \a) (< \z (aget x i)))
          (return (lit Version)))

        (inc! i))

      (when (== i 0)
        (return (lit Version)))

      (set! (values (.-Kind v) x) (values (subslice x _ i) (subslice x i)))
      (when (== x "")
        (return v))

      (set! (values (.-Pre v) x ok) (cutInt x))
      (when (or (not ok) (!= x ""))
        (return (lit Version)))


      ^{:line 168} v)))




^{:go/end 182} (go/func cutInt "cutInt scans the leading decimal number at the start of x to an integer\nand returns that value and the rest of the string.\n" [^string x] :results [^string n ^string rest ^bool ok]
  (let [i 0]
    (while (and (< i (len x)) (<= \0 (aget x i)) (<= (aget x i) \9))
      (inc! i))

    (when (or (== i 0) (and (== (aget x 0) \0) (!= i 1))) ; no digits or unnecessary leading zero
      (return "" "" false))

    (return (subslice x _ i) (subslice x i) true)))




^{:go/end 201} (go/func CmpInt "CmpInt returns cmp.Compare(x, y) interpreting x and y as decimal numbers.\n(Copied from golang.org/x/mod/semver's compareInt.)\n" ^int [^string x ^string y]
  (when (== x y)
    (return 0))

  (when (< (len x) (len y))
    (return -1))

  (when (> (len x) (len y))
    (return (+ 1)))

  (if (< x y)
    (return -1)

    (return (+ 1))))






^{:go/end 223} (go/func DecInt "DecInt returns the decimal string decremented by 1, or the empty string\nif the decimal is all zeroes.\n(Copied from golang.org/x/mod/module's decDecimal.)\n" ^string [^string decimal]
  ;; Scan right to left turning 0s to 9s until you find a digit to decrement.
  (let [digits (conv (slice byte) decimal)
      ^{:line 209} i (- (len digits) 1)]
    (for [] (and (>= i 0) (== (aget digits i) \0)) (dec! i)
      (aset digits i \9))

    (when (< i 0)
      ;; decimal is all zeros
      (return ""))

    (if (and (== i 0) (== (aget digits i) \1) (> (len digits) 1))
      (set! digits (subslice digits 1))

      (dec! (aget digits i)))

    (conv string digits)))

^{:go/end 67} (go/func byteSliceDuplicateBytes "byteSliceDuplicateBytes duplicates a chunk of bytes in b and inserts it into\na random position.\n" ^{:tag (slice byte)} [^{:tag (* mutator)} m ^{:tag (slice byte)} b]
  (when (<= (len b) 1)
    (return nil))

  (let [src (.rand m (len b))
      ^{:line 42} dst (.rand m (len b))]
    (while (== dst src)
      (set! dst (.rand m (len b))))

    (let [n (.chooseLen m (- (len b) src))]
      ;; Use the end of the slice as scratch space to avoid doing an
      ;; allocation. If the slice is too small abort and try something
      ;; else.
      (when (>= (+ (len b) (* n 2)) (cap b))
        (return nil))

      (let [end (len b)]
        ;; Increase the size of b to fit the duplicated block as well as
        ;; some extra working space
        (set! b (subslice b _ (+ end (* n 2))))
        ;; Copy the block of bytes we want to duplicate to the end of the
        ;; slice
        (copy (subslice b (+ end n)) (subslice b src (+ src n)))
        ;; Shift the bytes after the splice point n positions to the right
        ;; to make room for the new block
        (copy (subslice b (+ dst n) (+ end n)) (subslice b dst end))
        ;; Insert the duplicate block into the splice point
        (copy (subslice b dst) (subslice b (+ end n)))
        (set! b (subslice b _ (+ end n)))
        ^{:line 66} b))))




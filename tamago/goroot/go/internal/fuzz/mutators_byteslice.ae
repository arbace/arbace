^{:go/end 275} (go/func byteSliceShuffleBytes "byteSliceShuffleBytes shuffles a chunk of bytes in b.\n" ^{:tag (slice byte)} [^{:tag (* mutator)} m ^{:tag (slice byte)} b]
  (when (<= (len b) 1)
    (return nil))

  (let [dst (.rand m (len b))
      ^{:line 263} n (.chooseLen m (- (len b) dst))]
    (when (<= n 2)
      (return nil))

    ;; Start at the end of the range, and iterate backwards
    ;; to dst, swapping each element with another element in
    ;; dst:dst+n (Fisher-Yates shuffle).
    (for [i (- n 1)] (> i 0) (dec! i)
      (let [j (.rand m (+ i 1))]
        (set! (values (aget b (+ dst i)) (aget b (+ dst j))) (values (aget b (+ dst j)) (aget b (+ dst i))))))

    ^{:line 274} b))



^{:go/end 313} (go/func byteSliceSwapBytes "byteSliceSwapBytes swaps two chunks of bytes in b.\n" ^{:tag (slice byte)} [^{:tag (* mutator)} m ^{:tag (slice byte)} b]
  (when (<= (len b) 1)
    (return nil))

  (let [src (.rand m (len b))
      ^{:line 283} dst (.rand m (len b))]
    (while (== dst src)
      (set! dst (.rand m (len b))))

    ;; Choose the random length as len(b) - max(src, dst)
    ;; so that we don't attempt to swap a chunk that extends
    ;; beyond the end of the slice
    (let [max dst]
      (when (> src max)
        (set! max src))

      (let [n (.chooseLen m (- (len b) max 1))]
        ;; Check that neither chunk intersect, so that we don't end up
        ;; duplicating parts of the input, rather than swapping them
        (when (or (and (> src dst) (>= (+ dst n) src)) (and (> dst src) (>= (+ src n) dst)))
          (return nil))

        ;; Use the end of the slice as scratch space to avoid doing an
        ;; allocation. If the slice is too small abort and try something
        ;; else.
        (when (>= (+ (len b) n) (cap b))
          (return nil))

        (let [end (len b)]
          (set! b (subslice b _ (+ end n)))
          (copy (subslice b end) (subslice b dst (+ dst n)))
          (copy (subslice b dst) (subslice b src (+ src n)))
          (copy (subslice b src) (subslice b end))
          (set! b (subslice b _ end))
          ^{:line 312} b)))))

^{:go/end 273} (go/method mutateBytes [^{:tag (* mutator)} m ^{:tag (* (slice byte))} ptrB]
  (let [b @ptrB]
    (defer (^{:go/end 264} (fn []
          (when (!= (unsafe/SliceData @ptrB) (unsafe/SliceData b))
            (panic "data moved to new address"))

          (set! @ptrB b))))


    (while true
      (let [mut (aget byteSliceMutators (.rand m (len byteSliceMutators)))]
        (when [mutated (mut m b)] (!= mutated nil)
          (set! b mutated)
          (return))))))





^{:go/end 45} (go/method chooseLen "chooseLen chooses length of range mutation in range [1,n]. It gives\npreference to shorter ranges.\n" ^int [^{:tag (* mutator)} m ^int n]
  (switch [x (.rand m 100)]
    (case [(< x 90)]
      (return (+ (.rand m (min 8 n)) 1)))
    (case [(< x 99)]
      (return (+ (.rand m (min 32 n)) 1)))
    (default
      (return (+ (.rand m n) 1)))))




^{:go/end 117} (go/method mutate "mutate performs several mutations on the provided values.\n" [^{:tag (* mutator)} m ^{:tag (slice any)} vals ^int maxBytes]
  ;; TODO(katiehockman): pull some of these functions into helper methods and
  ;; test that each case is working as expected.
  ;; TODO(katiehockman): perform more types of mutations for []byte.

  ;; maxPerVal will represent the maximum number of bytes that each value be
  ;; allowed after mutating, giving an equal amount of capacity to each line.
  ;; Allow a little wiggle room for the encoding.
  (let [maxPerVal (- (/ maxBytes (len vals)) 100)

      ;; Pick a random value to mutate.
      ;; TODO: consider mutating more than one value at a time.
      ^{:line 60} i (.rand m (len vals))]
    (type-switch [v (aget vals i)]
      (case [int]
        (aset vals i (conv int (.mutateInt m (conv int64 v) maxInt))))
      (case [int8]
        (aset vals i (conv int8 (.mutateInt m (conv int64 v) math/MaxInt8))))
      (case [int16]
        (aset vals i (conv int16 (.mutateInt m (conv int64 v) math/MaxInt16))))
      (case [int64]
        (aset vals i (.mutateInt m v math/MaxInt64)))
      (case [uint]
        (aset vals i (conv uint (.mutateUInt m (conv uint64 v) maxUint))))
      (case [uint16]
        (aset vals i (conv uint16 (.mutateUInt m (conv uint64 v) math/MaxUint16))))
      (case [uint32]
        (aset vals i (conv uint32 (.mutateUInt m (conv uint64 v) math/MaxUint32))))
      (case [uint64]
        (aset vals i (.mutateUInt m v math/MaxUint64)))
      (case [float32]
        (aset vals i (conv float32 (.mutateFloat m (conv float64 v) math/MaxFloat32))))
      (case [float64]
        (aset vals i (.mutateFloat m v math/MaxFloat64)))
      (case [bool]
        (when (== (.rand m 2) 1)
          (aset vals i (not v)))) ; 50% chance of flipping the bool

      (case [rune] ; int32
        (aset vals i (conv rune (.mutateInt m (conv int64 v) math/MaxInt32))))
      (case [byte] ; uint8
        (aset vals i (conv byte (.mutateUInt m (conv uint64 v) math/MaxUint8))))
      (case [string]
        (when (> (len v) maxPerVal)
          (panic (fmt/Sprintf "cannot mutate bytes of length %d" (len v))))

        (if (< (cap (.-scratch m)) maxPerVal)
          (set! (.-scratch m) (append (make (slice byte) 0 maxPerVal) (spread v)))
          (do
            (set! (.-scratch m) (subslice (.-scratch m) _ (len v)))
            (copy (.-scratch m) v)))

        (.mutateBytes m (addr (.-scratch m)))
        (aset vals i (conv string (.-scratch m))))
      (case [(slice byte)]
        (when (> (len v) maxPerVal)
          (panic (fmt/Sprintf "cannot mutate bytes of length %d" (len v))))

        (if (< (cap (.-scratch m)) maxPerVal)
          (set! (.-scratch m) (append (make (slice byte) 0 maxPerVal) (spread v)))
          (do
            (set! (.-scratch m) (subslice (.-scratch m) _ (len v)))
            (copy (.-scratch m) v)))

        (.mutateBytes m (addr (.-scratch m)))
        (aset vals i (.-scratch m)))
      (default
        (panic (fmt/Sprintf "type not supported for mutating: %T" (aget vals i)))))))



^{:go/end 148} (go/method mutateInt ^int64 [^{:tag (* mutator)} m ^int64 v ^int64 maxValue]
  (let [^int64 max (zero int64)]
    (while true
      (set! max 100)
      (switch (.rand m 2)
        (case [0]
          ;; Add a random number
          (when (>= v maxValue)
            (continue))

          (when (and (> v 0) (< (- maxValue v) max))
            ;; Don't let v exceed maxValue
            (set! max (- maxValue v)))

          (set! v + (conv int64 (+ 1 (.rand m (conv int max)))))
          (return v))
        (case [1]
          ;; Subtract a random number
          (when (<= v (- maxValue))
            (continue))

          (when (and (< v 0) (< (+ maxValue v) max))
            ;; Don't let v drop below -maxValue
            (set! max (+ maxValue v)))

          (set! v - (conv int64 (+ 1 (.rand m (conv int max)))))
          (return v))))))




^{:go/end 180} (go/method mutateUInt ^uint64 [^{:tag (* mutator)} m ^uint64 v ^uint64 maxValue]
  (let [^uint64 max (zero uint64)]
    (while true
      (set! max 100)
      (switch (.rand m 2)
        (case [0]
          ;; Add a random number
          (when (>= v maxValue)
            (continue))

          (when (and (> v 0) (< (- maxValue v) max))
            ;; Don't let v exceed maxValue
            (set! max (- maxValue v)))


          (set! v + (conv uint64 (+ 1 (.rand m (conv int max)))))
          (return v))
        (case [1]
          ;; Subtract a random number
          (when (<= v 0)
            (continue))

          (when (< v max)
            ;; Don't let v drop below 0
            (set! max v))

          (set! v - (conv uint64 (+ 1 (.rand m (conv int max)))))
          (return v))))))




^{:go/end 232} (go/method mutateFloat ^float64 [^{:tag (* mutator)} m ^float64 v ^float64 maxValue]
  (let [^float64 max (zero float64)]
    (while true
      (switch (.rand m 4)
        (case [0]
          ;; Add a random number
          (when (>= v maxValue)
            (continue))

          (set! max 100)
          (when (and (> v 0) (< (- maxValue v) max))
            ;; Don't let v exceed maxValue
            (set! max (- maxValue v)))

          (set! v + (conv float64 (+ 1 (.rand m (conv int max)))))
          (return v))
        (case [1]
          ;; Subtract a random number
          (when (<= v (- maxValue))
            (continue))

          (set! max 100)
          (when (and (< v 0) (< (+ maxValue v) max))
            ;; Don't let v drop below -maxValue
            (set! max (+ maxValue v)))

          (set! v - (conv float64 (+ 1 (.rand m (conv int max)))))
          (return v))
        (case [2]
          ;; Multiply by a random number
          (let [absV (math/Abs v)]
            (when (or (== v 0) (>= absV maxValue))
              (continue))

            (set! max 10)
            (when (< (/ maxValue absV) max)
              ;; Don't let v go beyond the minimum or maximum value
              (set! max (/ maxValue absV)))

            (set! v * (conv float64 (+ 1 (.rand m (conv int max)))))
            (return v)))
        (case [3]
          ;; Divide by a random number
          (when (== v 0)
            (continue))

          (set! v / (conv float64 (+ 1 (.rand m 10))))
          (return v))))))





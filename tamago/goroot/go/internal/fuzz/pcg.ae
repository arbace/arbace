          (set! low (conv uint32 prod)))))


    (conv uint32 (>> prod 32))))



^{:go/end 128} (go/method bool "bool generates a random bool.\n" ^bool [^{:tag (* pcgRand)} r]
  (== (bit-and (.uint32 r) 1) 0))








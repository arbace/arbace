    ^{:line 52 :tag (* coordinator)} coordinator

    ^{:line 54 :tag (chan (* sharedMem))} memMu ; mutex guarding shared memory with worker; persists across processes.

    ^{:line 56 :tag (* exec/Cmd)} cmd ; current worker process
    ^{:line 57 :tag (* workerClient)} client ; used to communicate with worker process
    ^{:line 58 :tag error} waitErr ; last error returned by wait, set before termC is closed.
    ^{:line 59 :tag bool} interrupted ; true after stop interrupts a running worker.
    ^{:line 60 :tag (chan (struct))} termC)) ; closed by wait when worker process terminates



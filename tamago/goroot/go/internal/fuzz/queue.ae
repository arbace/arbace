(in-ns 'go.internal.fuzz) (go/file "queue.go" :imports [])








(go/type queue "queue holds a growable sequence of inputs for fuzzing and minimization.\n\nFor now, this is a simple ring buffer\n(https://en.wikipedia.org/wiki/Circular_buffer).\n\nTODO(golang.org/issue/46224): use a prioritization algorithm based on input\nsize, previous duration, coverage, and any other metrics that seem useful.\n" (struct




    ^{:line 19 :tag (slice any) :doc "elems holds a ring buffer.\nThe queue is empty when begin = end.\nThe queue is full (until grow is called) when end = begin + N - 1 (mod N)\nwhere N = cap(elems).\n"} elems
    ^{:line 20 :tag int} head ^int len))


^{:go/end 25} (go/method cap ^int [^{:tag (* queue)} q]
  (len (.-elems q)))


^{:go/end 40} (go/method grow [^{:tag (* queue)} q]
  (let [oldCap (.cap q)
      ^{:line 29} newCap (* oldCap 2)]
    (when (== newCap 0)
      (set! newCap 8))

    (let [newElems (make (slice any) newCap)
        ^{:line 34} oldLen (.-len q)]
      (for [i 0] (< i oldLen) (inc! i)
        (aset newElems i (aget (.-elems q) (% (+ (.-head q) i) oldCap))))

      (set! (.-elems q) newElems)
      (set! (.-head q) 0))))


^{:go/end 49} (go/method enqueue [^{:tag (* queue)} q ^any e]
  (when (> (+ (.-len q) 1) (.cap q))
    (.grow q))

  (let [i (% (+ (.-head q) (.-len q)) (.cap q))]
    (aset (.-elems q) i e)
    (inc! (.-len q))))


^{:go/end 60} (go/method dequeue [^{:tag (* queue)} q] :results [any bool]
  (when (== (.-len q) 0)
    (return nil false))

  (let [e (aget (.-elems q) (.-head q))]
    (aset (.-elems q) (.-head q) nil)
    (set! (.-head q) (% (+ (.-head q) 1) (.cap q)))
    (dec! (.-len q))
    (return e true)))


^{:go/end 67} (go/method peek [^{:tag (* queue)} q] :results [any bool]
  (when (== (.-len q) 0)
    (return nil false))

  (return (aget (.-elems q) (.-head q)) true))


^{:go/end 71} (go/method clear [^{:tag (* queue)} q]
  (set! @q (lit queue)))

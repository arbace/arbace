(in-ns 'go.internal.platform) (go/file "supported.go" :directives ["//go:generate go test . -run=^TestGenerated$ -fix"] :imports [])


(go/type OSArch "An OSArch is a pair of GOOS and GOARCH values indicating a platform.\n" (struct
    ^{:line 11 :tag string} GOOS ^string GOARCH))


^{:go/end 16} (go/method String ^string [^OSArch p]
  (+ (.-GOOS p) "/" (.-GOARCH p)))







^{:go/end 34} (go/func RaceDetectorSupported "RaceDetectorSupported reports whether goos/goarch supports the race\ndetector. There is a copy of this function in cmd/dist/test.go.\nRace detector only supports 48-bit VMA on arm64. But it will always\nreturn true for arm64, because we don't have VMA size information during\nthe compile time.\n" ^bool [^string goos ^string goarch]
  (switch goos
    (case ["linux"]
      (return (or (== goarch "amd64") (== goarch "arm64") (== goarch "loong64") (== goarch "ppc64le") (== goarch "riscv64") (== goarch "s390x"))))
    (case ["darwin"]
      (return (or (== goarch "amd64") (== goarch "arm64"))))
    (case ["freebsd" "netbsd" "windows"]
      (return (== goarch "amd64")))
    (default
      (return false))))





^{:go/end 47} (go/func MSanSupported "MSanSupported reports whether goos/goarch supports the memory\nsanitizer option.\n" ^bool [^string goos ^string goarch]
  (switch goos
    (case ["linux"]
      (return (or (== goarch "amd64") (== goarch "arm64") (== goarch "loong64"))))
    (case ["freebsd"]
      (return (== goarch "amd64")))
    (default
      (return false))))





^{:go/end 58} (go/func ASanSupported "ASanSupported reports whether goos/goarch supports the address\nsanitizer option.\n" ^bool [^string goos ^string goarch]
  (switch goos
    (case ["linux"]
      (return (or (== goarch "arm64") (== goarch "amd64") (== goarch "loong64") (== goarch "riscv64") (== goarch "ppc64le"))))
    (default
      (return false))))





^{:go/end 69} (go/func FuzzSupported "FuzzSupported reports whether goos/goarch supports fuzzing\n('go test -fuzz=.').\n" ^bool [^string goos ^string goarch]
  (switch goos
    (case ["darwin" "freebsd" "linux" "openbsd" "windows"]
      (return true))
    (default
      (return false))))





^{:go/end 81} (go/func FuzzInstrumented "FuzzInstrumented reports whether fuzzing on goos/goarch uses coverage\ninstrumentation. (FuzzInstrumented implies FuzzSupported.)\n" ^bool [^string goos ^string goarch]
  (switch goarch
    (case ["amd64" "arm64" "loong64"]
      ;; TODO(#14565): support more architectures.
      (return (FuzzSupported goos goarch)))
    (default
      (return false))))





^{:go/breaks [[6 121]] :go/end 122} (go/func MustLinkExternal "MustLinkExternal reports whether goos/goarch requires external linking\nwith or without cgo dependencies.\n" ^bool [^string goos ^string goarch ^bool withCgo]
  (when withCgo
    (switch goarch
      (case ["mips" "mipsle" "mips64" "mips64le"]
        ;; Internally linking cgo is incomplete on some architectures.
        ;; https://go.dev/issue/14449
        (return true))
      (case ["ppc64"]
        ;; Big Endian PPC64 cgo internal linking is not implemented for aix.
        ;; https://go.dev/issue/8912
        (when (== goos "aix")
          (return true))))



    (switch goos
      (case ["android"]
        (return true))
      (case ["dragonfly"]
        ;; It seems that on Dragonfly thread local storage is
        ;; set up by the dynamic linker, so internal cgo linking
        ;; doesn't work. Test case is "go test runtime/cgo".
        (return true))))



  (switch goos
    (case ["android"]
      (when (!= goarch "arm64")
        (return true)))

    (case ["ios"]
      (when (== goarch "arm64")
        (return true))))


  false)





^{:go/end 215} (go/func BuildModeSupported "BuildModeSupported reports whether goos/goarch supports the given build mode\nusing the given compiler.\nThere is a copy of this function in cmd/dist/test.go.\n" ^bool [^string compiler ^string buildmode ^string goos ^string goarch]
  (when (== compiler "gccgo")
    (return true))


  (when [(values _ ok) (aget distInfo (lit OSArch goos goarch))] (not ok)
    (return false)) ; platform unrecognized


  (let [platform (+ goos "/" goarch)]
    (switch buildmode
      (case ["archive"]
        (return true))

      (case ["c-archive"]
        (switch goos
          (case ["aix" "darwin" "ios" "windows"]
            (return true))
          (case ["linux"]
            (switch goarch
              (case ["386" "amd64" "arm" "armbe" "arm64" "arm64be" "loong64" "ppc64" "ppc64le" "riscv64" "s390x"]
                (return true))
              (default
                ;; Other targets do not support -shared,
                ;; per ParseFlags in
                ;; cmd/compile/internal/base/flag.go.
                ;; For c-archive the Go tool passes -shared,
                ;; so that the result is suitable for inclusion
                ;; in a PIE or shared library.
                (return false))))

          (case ["freebsd"]
            (return (== goarch "amd64"))))

        (return false))

      (case ["c-shared"]
        (switch platform
          (case ^{:go/breaks [9 13 14 16 19]} ["linux/amd64" "linux/arm" "linux/arm64" "linux/loong64" "linux/386" "linux/ppc64" "linux/ppc64le" "linux/riscv64" "linux/s390x"
              "android/amd64" "android/arm" "android/arm64" "android/386"
              "freebsd/amd64"
              "darwin/amd64" "darwin/arm64"
              "windows/amd64" "windows/386" "windows/arm64"
              "wasip1/wasm"]
            (return true)))

        (return false))

      (case ["default"]
        (return true))

      (case ["exe"]
        (return true))

      (case ["pie"]
        (switch platform
          (case ^{:go/breaks [9 13 14 16 18 19 20]} ["linux/386" "linux/amd64" "linux/arm" "linux/arm64" "linux/loong64" "linux/ppc64" "linux/ppc64le" "linux/riscv64" "linux/s390x"
              "android/amd64" "android/arm" "android/arm64" "android/386"
              "freebsd/amd64"
              "darwin/amd64" "darwin/arm64"
              "ios/amd64" "ios/arm64"
              "aix/ppc64"
              "openbsd/arm64"
              "windows/386" "windows/amd64" "windows/arm64"]
            (return true)))

        (return false))

      (case ["shared"]
        (switch platform
          (case ["linux/386" "linux/amd64" "linux/arm" "linux/arm64" "linux/ppc64" "linux/ppc64le" "linux/s390x"]
            (return true)))

        (return false))

      (case ["plugin"]
        (switch platform
          (case ^{:go/breaks [9 11 13]} ["linux/amd64" "linux/arm" "linux/arm64" "linux/386" "linux/loong64" "linux/riscv64" "linux/s390x" "linux/ppc64" "linux/ppc64le"
              "android/amd64" "android/386"
              "darwin/amd64" "darwin/arm64"
              "freebsd/amd64"]
            (return true)))

        (return false))

      (default
        (return false)))))



^{:go/breaks [[4 225]] :go/end 226} (go/func InternalLinkPIESupported ^bool [^string goos ^string goarch]
  (switch (+ goos "/" goarch)
    (case ^{:go/breaks [1 3 9]} ["android/arm64"
        "darwin/amd64" "darwin/arm64"
        "linux/amd64" "linux/arm64" "linux/loong64" "linux/ppc64" "linux/ppc64le" "linux/s390x"
        "windows/386" "windows/amd64" "windows/arm64"]
      (return true)))

  false)





^{:go/breaks [[5 245]] :go/end 246} (go/func DefaultPIE "DefaultPIE reports whether goos/goarch produces a PIE binary when using the\n\"default\" buildmode. On Windows this is affected by -race,\nso force the caller to pass that in to centralize that choice.\n" ^bool [^string goos ^string goarch ^bool isRace]
  (switch goos
    (case ["android" "ios"]
      (return true))
    (case ["windows"]
      (when isRace
        ;; PIE is not supported with -race on windows;
        ;; see https://go.dev/cl/416174.
        (return false))

      (return true))
    (case ["darwin"]
      (return true)))

  false)




^{:go/breaks [[5 255]] :go/end 256} (go/func ExecutableHasDWARF "ExecutableHasDWARF reports whether the linked executable includes DWARF\nsymbols on goos/goarch.\n" ^bool [^string goos ^string goarch]
  (switch goos
    (case ["plan9" "ios"]
      (return false)))

  true)




(go/type osArchInfo "osArchInfo describes information about an OSArch extracted from cmd/dist and\nstored in the generated distInfo map.\n" (struct
    ^{:line 261 :tag bool} CgoSupported
    ^{:line 262 :tag bool} FirstClass
    ^{:line 263 :tag bool} Broken))



^{:go/end 269} (go/func CgoSupported "CgoSupported reports whether goos/goarch supports cgo.\n" ^bool [^string goos ^string goarch]
  (.-CgoSupported (aget distInfo (lit OSArch goos goarch))))




^{:go/end 275} (go/func FirstClass "FirstClass reports whether goos/goarch is considered a “first class” port.\n(See https://go.dev/wiki/PortingPolicy#first-class-ports.)\n" ^bool [^string goos ^string goarch]
  (.-FirstClass (aget distInfo (lit OSArch goos goarch))))




^{:go/end 281} (go/func Broken "Broken reports whether goos/goarch is considered a broken port.\n(See https://go.dev/wiki/PortingPolicy#broken-ports.)\n" ^bool [^string goos ^string goarch]
  (.-Broken (aget distInfo (lit OSArch goos goarch))))

(ns go.internal.strconv
  (:require [arbace.go :as go]))

(go/package strconv
  :path "internal/strconv"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["atob.go" "atoc.go" "atof.go" "atoi.go" "ctoa.go" "decimal.go" "deps.go" "ftoa.go" "itoa.go" "pow10tab.go" "uscale.go"]
  :init-order [float32info float64info optimize powtab float64pow10 float32pow10 leftcheats pow10Tab uint64pow10]
  :positions :lines)

(load "strconv/atob")
(load "strconv/atoc")
(load "strconv/atof")
(load "strconv/atoi")
(load "strconv/ctoa")
(load "strconv/decimal")
(load "strconv/deps")
(load "strconv/ftoa")
(load "strconv/itoa")
(load "strconv/pow10tab")
(load "strconv/uscale")

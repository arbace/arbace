          (let [lhdr (new LoaderHeader32)]
            (when [err (binary/Read (.-sr s) binary/BigEndian lhdr)] (!= err nil)
              (return nil err))

            (set! stlen (.-Lstlen lhdr))
            (set! stoff (conv uint64 (.-Lstoff lhdr)))
            (set! nsyms (.-Lnsyms lhdr))
            (set! symoff LDHDRSZ_32)))
        (case [U64_TOCMAGIC]
          (let [lhdr (new LoaderHeader64)]
            (when [err (binary/Read (.-sr s) binary/BigEndian lhdr)] (!= err nil)
              (return nil err))

            (set! stlen (.-Lstlen lhdr))
            (set! stoff (.-Lstoff lhdr))
            (set! nsyms (.-Lnsyms lhdr))
            (set! symoff (.-Lsymoff lhdr)))))


      ;; Read loader section string table
      (when [(values _ err) (.Seek (.-sr s) (conv int64 stoff) io/SeekStart)] (!= err nil)
        (return nil err))

      (let [st (make (slice byte) stlen)]
        (when [(values _ err) (io/ReadFull (.-sr s) st)] (!= err nil)
          (return nil err))


        ;; Read imported libraries
        (let [(values libs err) (.readImportIDs f s)]
          (when (!= err nil)
            (return nil err))


          ;; Read loader symbol table
          (when [(values _ err) (.Seek (.-sr s) (conv int64 symoff) io/SeekStart)] (!= err nil)
            (return nil err))

          (let [all (make (slice ImportedSymbol) 0)]
            (for [i 0] (< i (conv int nsyms)) (inc! i)
              (let [^string name (zero string)
                  ^{:line 636 :tag uint32} ifile (zero uint32)
                  ^{:line 637 :tag bool} ok (zero bool)]
                (switch ^{:go/via [FileHeader]} (.-TargetMachine f)
                  (case [U802TOCMAGIC]
                    (let [ldsym (new LoaderSymbol32)]
                      (when [err (binary/Read (.-sr s) binary/BigEndian ldsym)] (!= err nil)
                        (return nil err))

                      (when (== (bit-and (.-Lsmtype ldsym) 0x40) 0)
                        (continue)) ; Imported symbols only

                      (let [zeroes (.Uint32 binary/BigEndian (subslice (.-Lname ldsym) _ 4))]
                        (if (!= zeroes 0)
                          (set! name (cstring (subslice (.-Lname ldsym))))

                          (let [offset (.Uint32 binary/BigEndian (subslice (.-Lname ldsym) 4))]
                            (set! (values name ok) (getString st offset))
                            (when (not ok)
                              (continue))))


                        (set! ifile (.-Lifile ldsym)))))
                  (case [U64_TOCMAGIC]
                    (let [ldsym (new LoaderSymbol64)]
                      (when [err (binary/Read (.-sr s) binary/BigEndian ldsym)] (!= err nil)
                        (return nil err))

                      (when (== (bit-and (.-Lsmtype ldsym) 0x40) 0)
                        (continue)) ; Imported symbols only

                      (set! (values name ok) (getString st (.-Loffset ldsym)))
                      (when (not ok)
                        (continue))

                      (set! ifile (.-Lifile ldsym)))))

                (let [^ImportedSymbol sym (zero ImportedSymbol)]
                  (set! (.-Name sym) name)
                  (when (and (>= ifile 1) (<= (conv int ifile) (len libs)))
                    (set! (.-Library sym) (aget libs (- ifile 1))))

                  (set! all (append all sym)))))


            (return all nil)))))))





^{:go/end 693} (go/method ImportedLibraries "ImportedLibraries returns the names of all libraries\nreferred to by the binary f that are expected to be\nlinked with the binary at dynamic link time.\n" [^{:tag (* File)} f] :results [(slice string) error]
  (let [s (.SectionByType f STYP_LOADER)]
    (when (== s nil)
      (return nil nil))

    (let [(values all err) (.readImportIDs f s)]
      (return all err))))

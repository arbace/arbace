(go/type bigarFileHeader (struct
    ^{:line 28 :tag (array SAIAMAG byte)} Flmagic ; Archive magic string
    ^{:line 29 :tag (array 20 byte)} Flmemoff ; Member table offset
    ^{:line 30 :tag (array 20 byte)} Flgstoff ; 32-bits global symtab offset
    ^{:line 31 :tag (array 20 byte)} Flgst64off ; 64-bits global symtab offset

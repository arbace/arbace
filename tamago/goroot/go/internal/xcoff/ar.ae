^{:go/end 226} (go/method GetFile "GetFile returns the XCOFF file defined by member name.\nFIXME: This doesn't work if an archive has two members with the same\nname which can occur if an archive has both 32-bits and 64-bits files.\n" [^{:tag (* Archive)} arch ^string name] :results [(* File) error]
  (range [_ mem (.-Members arch)]
    (when (== ^{:go/via [MemberHeader]} (.-Name mem) name)
      (return (NewFile (.-sr mem)))))


  (return nil (fmt/Errorf "unknown member %s in archive" name)))

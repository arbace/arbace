^{:go/end 88} (go/func OpenArchive "OpenArchive opens the named archive using os.Open and prepares it for use\nas an AIX big archive.\n" [^string name] :results [(* Archive) error]
  (let [(values f err) (os/Open name)]
    (when (!= err nil)
      (return nil err))

    (let [(values arch ^:assign err) (NewArchive f)]
      (when (!= err nil)
        (.Close f)
        (return nil err))

      (set! (.-closer arch) f)
      (return arch nil))))





^{:go/end 100} (go/method Close "Close closes the Archive.\nIf the Archive was created using NewArchive directly instead of OpenArchive,\nClose has no effect.\n" ^error [^{:tag (* Archive)} a]
  (let [^error err (zero error)]
    (when (!= (.-closer a) nil)
      (set! err (.Close (.-closer a)))
      (set! (.-closer a) nil))

    ^{:line 99} err))



^{:go/end 214} (go/func NewArchive "NewArchive creates a new Archive for accessing an AIX big archive in an underlying reader.\n" [^io/ReaderAt r] :results [(* Archive) error]
  (let [parseDecimalBytes ^{:go/end 106} (fn [^{:tag (slice byte)} b] :results [int64 error]
        (strconv/ParseInt (strings/TrimSpace (conv string b)) 10 64))

      ^{:line 107} sr (io/NewSectionReader r 0 (- (<< 1 63) 1))

      ;; Read File Header
      ^{:line 110 :tag (array SAIAMAG byte)} magic (zero (array SAIAMAG byte))]
    (when [(values _ err) (.ReadAt sr (subslice magic) 0)] (!= err nil)
      (return nil err))


    (let [arch (new Archive)]
      (switch (conv string (subslice magic))
        (case [AIAMAGBIG]
          (set! ^{:go/via [ArchiveHeader]} (.-magic arch) (conv string (subslice magic))))
        (case [AIAMAG]
          (return nil (fmt/Errorf "small AIX archive not supported")))
        (default
          (return nil (fmt/Errorf "unrecognised archive magic: 0x%x" magic))))


      (let [^bigarFileHeader fhdr (zero bigarFileHeader)]
        (when [(values _ err) (.Seek sr 0 io/SeekStart)] (!= err nil)
          (return nil err))

        (when [err (binary/Read sr binary/BigEndian (addr fhdr))] (!= err nil)
          (return nil err))


        (let [(values off err) (parseDecimalBytes (subslice (.-Flfstmoff fhdr)))]
          (when (!= err nil)
            (return nil (fmt/Errorf "error parsing offset of first member in archive header(%q); %v" fhdr err)))


          (when (== off 0)
            ;; Occurs if the archive is empty.
            (return arch nil))


          (let [(values lastoff ^:assign err) (parseDecimalBytes (subslice (.-Fllstmoff fhdr)))]
            (when (!= err nil)
              (return nil (fmt/Errorf "error parsing offset of first member in archive header(%q); %v" fhdr err)))


            ;; Read members
            (while true
              ;; Read Member Header
              ;; The member header is normally 2 bytes larger. But it's easier
              ;; to read the name if the header is read without _ar_nam.
              ;; However, AIAFMAG must be read afterward.
              (when [(values _ err) (.Seek sr off io/SeekStart)] (!= err nil)
                (return nil err))


              (let [^bigarMemberHeader mhdr (zero bigarMemberHeader)]
                (when [err (binary/Read sr binary/BigEndian (addr mhdr))] (!= err nil)
                  (return nil err))


                (let [member (new Member)]
                  (set! (.-Members arch) (append (.-Members arch) member))

                  (let [(values size err) (parseDecimalBytes (subslice (.-Arsize mhdr)))]
                    (when (!= err nil)
                      (return nil (fmt/Errorf "error parsing size in member header(%q); %v" mhdr err)))

                    (set! ^{:go/via [MemberHeader]} (.-Size member) (conv uint64 size))

                    ;; Read name
                    (let [(values namlen ^:assign err) (parseDecimalBytes (subslice (.-Arnamlen mhdr)))]
                      (when (!= err nil)
                        (return nil (fmt/Errorf "error parsing name length in member header(%q); %v" mhdr err)))

                      (let [name (make (slice byte) namlen)]
                        (when [err (binary/Read sr binary/BigEndian name)] (!= err nil)

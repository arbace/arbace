;; Package testpty is a simple pseudo-terminal package for Unix systems,
;; implemented by calling C functions via cgo.
(in-ns 'go.internal.testpty) (go/file "pty.go" :doc "Package testpty is a simple pseudo-terminal package for Unix systems,\nimplemented by calling C functions via cgo.\n" :imports [


    ^{:line 10} [errors "errors"]
    ^{:line 11} [fmt "fmt"]
    ^{:line 12} [os "os"]])


(go/type PtyError (struct
    ^{:line 16 :tag string} FuncName
    ^{:line 17 :tag string} ErrorString
    ^{:line 18 :tag error} Errno))


^{:go/end 23} (go/func ptyError ^{:tag (* PtyError)} [^string name ^error err]
  (addr (lit PtyError name (.Error err) err)))


^{:go/end 27} (go/method Error ^string [^{:tag (* PtyError)} e]
  (fmt/Sprintf "%s: %s" (.-FuncName e) (.-ErrorString e)))


^{:go/end 29} (go/method Unwrap ^error [^{:tag (* PtyError)} e] (.-Errno e))

(go/var ErrNotSupported (errors/New "testpty.Open not implemented on this platform"))




^{:go/end 38} (go/func Open "Open returns a control pty and the name of the linked process tty.\n\nIf Open is not implemented on this platform, it returns ErrNotSupported.\n" [] :results [^{:tag (* os/File)} pty ^string processTTY ^error err]
  (open))

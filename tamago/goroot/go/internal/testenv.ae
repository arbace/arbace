(ns go.internal.testenv
  (:require [arbace.go :as go]))

(go/package testenv
  :path "internal/testenv"
  :files ["exec.go" "opt.go" "testenv.go" "testenv_notunix.go" "testenv_notwin.go"]
  :positions :lines)

(load "testenv/exec")
(load "testenv/opt")
(load "testenv/testenv")
(load "testenv/testenv_notunix")
(load "testenv/testenv_notwin")

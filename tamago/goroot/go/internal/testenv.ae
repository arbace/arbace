(ns go.internal.testenv
  (:require [arbace.go :as go]))

(go/package testenv
  :path "internal/testenv"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["exec.go" "opt.go" "testenv.go" "testenv_notunix.go" "testenv_notwin.go"]
  :init-order [exePath origEnv tryExec findGOROOT goTool tryGoBuild hasCgo flaky Sigquit hasSymlink]
  :positions :lines)

(load "testenv/exec")
(load "testenv/opt")
(load "testenv/testenv")
(load "testenv/testenv_notunix")
(load "testenv/testenv_notwin")

(ns go.internal.exportdata
  (:require [arbace.go :as go]))

(go/package exportdata
  :path "internal/exportdata"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["exportdata.go" "support.go"]
  :init-order [pkgExts]
  :positions :lines)

(load "exportdata/exportdata")
(load "exportdata/support")

(ns go.internal.platform
  (:require [arbace.go :as go]))

(go/package platform
  :path "internal/platform"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["supported.go" "zosarch.go"]
  :init-order [List distInfo]
  :positions :lines)

(load "platform/supported")
(load "platform/zosarch")

          (set! (values off err) (.setSeqTable r data off seqOffset (bit-and (>> symMode 4) 3)))
          (when (!= err nil)
            (return 0 0 err))


          (set! (values off err) (.setSeqTable r data off seqMatch (bit-and (>> symMode 2) 3)))
          (when (!= err nil)

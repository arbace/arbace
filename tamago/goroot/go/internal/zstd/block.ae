^{:go/end 60} (go/method compressedBlock "compressedBlock decompresses a compressed block, storing the decompressed\ndata in r.buffer. The blockSize argument is the compressed size.\nRFC 3.1.1.3.\n" ^error [^{:tag (* Reader)} r ^int blockSize]

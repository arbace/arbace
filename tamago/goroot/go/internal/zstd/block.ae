^{:go/end 425} (go/method copyFromWindow "Copy match bytes from the decoded output, or the window, at offset.\n" ^error [^{:tag (* Reader)} r ^{:tag (* reverseBitReader)} rbr ^uint32 offset ^uint32 match]
  (when (== offset 0)

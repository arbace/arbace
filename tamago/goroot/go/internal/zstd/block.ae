          (when (>= (+ off 1) (len data))
            (return 0 0 (.makeEOFError r off)))

          (set! seqCount (+ (conv int (aget data off)) (<< (conv int (aget data (+ off 1))) 8) 0x7f00))
          (set! off + 2)))


      ;; Read the Symbol_Compression_Modes byte.

      (when (>= off (len data))
        (return 0 0 (.makeEOFError r off)))


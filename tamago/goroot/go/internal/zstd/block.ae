^{:go/end 169} (go/method initSeqs "initSeqs reads the Sequences_Section_Header and sets up the FSE\ntables used to read the sequence codes. It returns the number of\nsequences and the new offset. RFC 3.1.1.3.2.1.\n" [^{:tag (* Reader)} r ^block data ^int off] :results [int int error]

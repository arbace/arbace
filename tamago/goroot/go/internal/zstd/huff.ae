(in-ns 'go.internal.zstd) (go/file "huff.go" :imports [


    ^{:line 8} [io "io"]
    ^{:line 9} [bits "math/bits"]])



(go/const ^{:val 11 :doc "maxHuffmanBits is the largest possible Huffman table bits.\n"} maxHuffmanBits 11)









^{:go/end 204} (go/method readHuff "readHuff reads Huffman table from data starting at off into table.\nEach entry in a Huffman table is a pair of bytes.\nThe high byte is the encoded value. The low byte is the number\nof bits used to encode that value. We index into the table\nwith a value of size tableBits. A value that requires fewer bits\nappear in the table multiple times.\nThis returns the number of bits in the Huffman table and the new offset.\nRFC 4.2.1.\n" [^{:tag (* Reader)} r ^block data ^int off ^{:tag (slice uint16)} table] :results [^int tableBits ^int roff ^error err]
  (when (>= off (len data))
    (return 0 0 (.makeEOFError r off)))


  (let [hdr (aget data off)]
    (inc! off)

    (let [^{:tag (array 256 uint8)} weights (zero (array 256 uint8))
        ^{:line 32 :tag int} count (zero int)]
      (if (< hdr 128) (do
          ;; The table is compressed using an FSE. RFC 4.2.1.2.
          (when (< (len (.-fseScratch r)) (<< 1 6))
            (set! (.-fseScratch r) (make (slice fseEntry) (<< 1 6))))

          (let [(values fseBits noff err) (.readFSE r data off 255 6 (.-fseScratch r))]
            (when (!= err nil)
              (return 0 0 err))

            (let [fseTable (.-fseScratch r)]

              (when (> (+ off (conv int hdr)) (len data))
                (return 0 0 (.makeEOFError r off)))


              (let [(values rbr ^:assign err) (.makeReverseBitReader r data (- (+ off (conv int hdr)) 1) noff)]
                (when (!= err nil)
                  (return 0 0 err))


                (let [(values state1 ^:assign err) (.val rbr (conv uint8 fseBits))]
                  (when (!= err nil)
                    (return 0 0 err))


                  (let [(values state2 ^:assign err) (.val rbr (conv uint8 fseBits))]
                    (when (!= err nil)
                      (return 0 0 err))


                    ;; There are two independent FSE streams, tracked by
                    ;; state1 and state2. We decode them alternately.

                    (while true
                      (let [pt (addr (aget fseTable state1))]
                        (when (not (.fetch rbr (.-bits pt)))
                          (when (>= count 254)
                            (return 0 0 (.makeError rbr "Huffman count overflow")))

                          (aset weights count (.-sym pt))
                          (aset weights (+ count 1) (.-sym (aget fseTable state2)))
                          (set! count + 2)
                          (break))


                        (let [(values v err) (.val rbr (.-bits pt))]
                          (when (!= err nil)
                            (return 0 0 err))

                          (set! state1 (+ (conv uint32 (.-base pt)) v))

                          (when (>= count 255)
                            (return 0 0 (.makeError rbr "Huffman count overflow")))


                          (aset weights count (.-sym pt))
                          (inc! count)

                          (set! pt (addr (aget fseTable state2)))

                          (when (not (.fetch rbr (.-bits pt)))
                            (when (>= count 254)
                              (return 0 0 (.makeError rbr "Huffman count overflow")))

                            (aset weights count (.-sym pt))
                            (aset weights (+ count 1) (.-sym (aget fseTable state1)))
                            (set! count + 2)
                            (break))


                          (set! (values v err) (.val rbr (.-bits pt)))
                          (when (!= err nil)
                            (return 0 0 err))

                          (set! state2 (+ (conv uint32 (.-base pt)) v))

                          (when (>= count 255)
                            (return 0 0 (.makeError rbr "Huffman count overflow")))


                          (aset weights count (.-sym pt))
                          (inc! count))))


                    (set! off + (conv int hdr))))))))
        (do
          ;; The table is not compressed. Each weight is 4 bits.

          (set! count (- (conv int hdr) 127))
          (when (>= (+ off (/ (+ count 1) 2)) (len data))
            (return 0 0 io/ErrUnexpectedEOF))

          (for [i 0] (< i count) (set! i + 2)
            (let [b (aget data off)]
              (inc! off)
              (aset weights i (>> b 4))
              (aset weights (+ i 1) (bit-and b 0xf))))))



      ;; RFC 4.2.1.3.

      (let [^{:tag (array 13 uint32)} weightMark (zero (array 13 uint32))
          ^{:line 136} weightMask (conv uint32 0)]
        (range [_ w (subslice weights _ count)]
          (when (> w 12)
            (return 0 0 (.makeError r off "Huffman weight overflow")))

          (inc! (aget weightMark w))
          (when (> w 0)
            (set! weightMask + ^uint32 (<< 1 (- w 1)))))


        (when (== weightMask 0)
          (return 0 0 (.makeError r off "bad Huffman weights")))


        (set! tableBits (- 32 (bits/LeadingZeros32 weightMask)))
        (when (> tableBits maxHuffmanBits)
          (return 0 0 (.makeError r off "bad Huffman weights")))


        (when (< (len table) ^int (<< 1 tableBits))
          (return 0 0 (.makeError r off "Huffman table too small")))


        ;; Work out the last weight value, which is omitted because
        ;; the weights must sum to a power of two.
        (let [left (- (<< (conv uint32 1) tableBits) weightMask)]
          (when (== left 0)
            (return 0 0 (.makeError r off "bad Huffman weights")))

          (let [highBit (- 31 (bits/LeadingZeros32 left))]
            (when (!= (<< (conv uint32 1) highBit) left)
              (return 0 0 (.makeError r off "bad Huffman weights")))

            (when (>= count 256)
              (return 0 0 (.makeError r off "Huffman weight overflow")))

            (aset weights count (conv uint8 (+ highBit 1)))
            (inc! count)
            (inc! (aget weightMark (+ highBit 1)))

            (when (or (< (aget weightMark 1) 2) (!= (bit-and (aget weightMark 1) 1) 0))
              (return 0 0 (.makeError r off "bad Huffman weights")))


            ;; Change weightMark from a count of weights to the index of
            ;; the first symbol for that weight. We shift the indexes to
            ;; also store how many we have seen so far,
            (let [next (conv uint32 0)]
              (for [i 0] (< i tableBits) (inc! i)
                (let [cur next]
                  (set! next + (<< (aget weightMark (+ i 1)) i))
                  (aset weightMark (+ i 1) cur)))


              (range [i w (subslice weights _ count)]
                (when (== w 0)
                  (continue))

                (let [length (<< (conv uint32 1) (- w 1))
                    ^{:line 195} tval (bit-or (<< (conv uint16 i) 8) (- (+ (conv uint16 tableBits) 1) (conv uint16 w)))
                    ^{:line 196} start (aget weightMark w)]
                  (for [j (conv uint32 0)] (< j length) (inc! j)
                    (aset table (+ start j) tval))

                  (set! (aget weightMark w) + length)))


              (return tableBits off nil))))))))

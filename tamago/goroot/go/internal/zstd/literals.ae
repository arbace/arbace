^{:go/end 28} (go/method readLiterals "readLiterals reads and decompresses the literals from data at off.\nThe literals are appended to outbuf, which is returned.\nAlso returns the new input offset. RFC 3.1.1.3.1.\n" [^{:tag (* Reader)} r ^block data ^int off ^{:tag (slice byte)} outbuf] :results [int (slice byte) error]
  (when (>= off (len data))
    (return 0 nil (.makeEOFError r off)))


  ;; Literals section header. RFC 3.1.1.3.1.1.
  (let [hdr (aget data off)]
    (inc! off)

    (if (or (== (bit-and hdr 3) 0) (== (bit-and hdr 3) 1))
      (return (.readRawRLELiterals r data off hdr outbuf))

      (return (.readHuffLiterals r data off hdr outbuf)))))






(in-ns 'go.internal.zstd) (go/file "window.go" :imports [])








(go/type window "window stores up to size bytes of data.\nIt is implemented as a circular buffer:\nsequential save calls append to the data slice until\nits length reaches configured size and after that,\nsave calls overwrite previously saved data at off\nand update off such that it always points at\nthe byte stored before others.\n" (struct
    ^{:line 15 :tag int} size
    ^{:line 16 :tag (slice byte)} data
    ^{:line 17 :tag int} off))



^{:go/end 29} (go/method reset "reset clears stored data and configures window size.\n" [^{:tag (* window)} w ^int size]
  (let [b (subslice (.-data w) _ 0)]
    (when (< (cap b) size)
      (set! b (make (slice byte) 0 size)))

    (set! (.-data w) b)
    (set! (.-off w) 0)
    (set! (.-size w) size)))



^{:go/end 34} (go/method len "len returns the number of stored bytes.\n" ^uint32 [^{:tag (* window)} w]
  (conv uint32 (len (.-data w))))



^{:go/end 69} (go/method save "save stores up to size last bytes from the buf.\n" [^{:tag (* window)} w ^{:tag (slice byte)} buf]
  (when (== (.-size w) 0)
    (return))

  (when (== (len buf) 0)
    (return))


  (when (>= (len buf) (.-size w))
    (let [from (- (len buf) (.-size w))]
      (set! (.-data w) (append (subslice (.-data w) _ 0) (spread (subslice buf from))))
      (set! (.-off w) 0)
      (return)))


  ;; Update off to point to the oldest remaining byte.
  (let [free (- (.-size w) (len (.-data w)))]
    (if (== free 0)
      (let [n (copy (subslice (.-data w) (.-off w)) buf)]
        (if (== n (len buf))
          (set! (.-off w) + n)

          (set! (.-off w) (copy (.-data w) (subslice buf n)))))

      (do
        (if (>= free (len buf))
          (set! (.-data w) (append (.-data w) (spread buf)))
          (do
            (set! (.-data w) (append (.-data w) (spread (subslice buf _ free))))
            (set! (.-off w) (copy (.-data w) (subslice buf free)))))))))






^{:go/end 94} (go/method appendTo "appendTo appends stored bytes between from and to indices to the buf.\nIndex from must be less or equal to index to and to must be less or equal to w.len().\n" ^{:tag (slice byte)} [^{:tag (* window)} w ^{:tag (slice byte)} buf ^uint32 from ^uint32 to]
  (let [dataLen (conv uint32 (len (.-data w)))]
    (set! from + (conv uint32 (.-off w)))
    (set! to + (conv uint32 (.-off w)))

    (let [wrap false]
      (when (> from dataLen)
        (set! from - dataLen)
        (set! wrap (not wrap)))

      (when (> to dataLen)
        (set! to - dataLen)
        (set! wrap (not wrap)))


      (if wrap (do
          (set! buf (append buf (spread (subslice (.-data w) from))))
          (return (append buf (spread (subslice (.-data w) _ to)))))

        (return (append buf (spread (subslice (.-data w) from to))))))))

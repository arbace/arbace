^{:go/end 46} (go/method reset "reset discards the current state and prepares to compute a new hash.\nWe assume a seed of 0 since that is what zstd uses.\n" [^{:tag (* xxhash64)} xh]
  (set! (.-len xh) 0)

  ;; Separate addition for awkward constant overflow.
  (aset (.-v xh) 0 xxhPrime64c1)
  (set! (aget (.-v xh) 0) + xxhPrime64c2)

  (aset (.-v xh) 1 xxhPrime64c2)
  (aset (.-v xh) 2 0)

  ;; Separate negation for awkward constant overflow.
  (aset (.-v xh) 3 xxhPrime64c1)
  (aset (.-v xh) 3 (- (aget (.-v xh) 3)))

  (clear (subslice (.-buf xh)))
  (set! (.-cnt xh) 0))



^{:go/end 80} (go/method update "update adds a buffer to the has.\n" [^{:tag (* xxhash64)} xh ^{:tag (slice byte)} b]
  (set! (.-len xh) + (conv uint64 (len b)))

  (when (< (+ (.-cnt xh) (len b)) (len (.-buf xh)))
    (copy (subslice (.-buf xh) (.-cnt xh)) b)
    (set! (.-cnt xh) + (len b))
    (return))


  (when (> (.-cnt xh) 0)
    (let [n (copy (subslice (.-buf xh) (.-cnt xh)) b)]
      (set! b (subslice b n))
      (aset (.-v xh) 0 (.round xh (aget (.-v xh) 0) (.Uint64 binary/LittleEndian (subslice (.-buf xh)))))
      (aset (.-v xh) 1 (.round xh (aget (.-v xh) 1) (.Uint64 binary/LittleEndian (subslice (.-buf xh) 8))))
      (aset (.-v xh) 2 (.round xh (aget (.-v xh) 2) (.Uint64 binary/LittleEndian (subslice (.-buf xh) 16))))
      (aset (.-v xh) 3 (.round xh (aget (.-v xh) 3) (.Uint64 binary/LittleEndian (subslice (.-buf xh) 24))))
      (set! (.-cnt xh) 0)))


  (while (>= (len b) 32)
    (aset (.-v xh) 0 (.round xh (aget (.-v xh) 0) (.Uint64 binary/LittleEndian b)))
    (aset (.-v xh) 1 (.round xh (aget (.-v xh) 1) (.Uint64 binary/LittleEndian (subslice b 8))))
    (aset (.-v xh) 2 (.round xh (aget (.-v xh) 2) (.Uint64 binary/LittleEndian (subslice b 16))))
    (aset (.-v xh) 3 (.round xh (aget (.-v xh) 3) (.Uint64 binary/LittleEndian (subslice b 24))))
    (set! b (subslice b 32)))


  (when (> (len b) 0)
    (copy (subslice (.-buf xh)) b)
    (set! (.-cnt xh) (len b))))




^{:go/end 130} (go/method digest "digest returns the final hash value.\n" ^uint64 [^{:tag (* xxhash64)} xh]
  (let [^uint64 h64 (zero uint64)]
    (if (< (.-len xh) 32)
      (set! h64 (+ (aget (.-v xh) 2) xxhPrime64c5))
      (do
        (set! h64 (+ (bits/RotateLeft64 (aget (.-v xh) 0) 1)
            (bits/RotateLeft64 (aget (.-v xh) 1) 7)
            (bits/RotateLeft64 (aget (.-v xh) 2) 12)
            (bits/RotateLeft64 (aget (.-v xh) 3) 18)))
        (set! h64 (.mergeRound xh h64 (aget (.-v xh) 0)))
        (set! h64 (.mergeRound xh h64 (aget (.-v xh) 1)))
        (set! h64 (.mergeRound xh h64 (aget (.-v xh) 2)))
        (set! h64 (.mergeRound xh h64 (aget (.-v xh) 3)))))


    (set! h64 + (.-len xh))

    (let [len (.-len xh)]
      (set! len bit-and 31)
      (let [buf (subslice (.-buf xh))]
        (while (>= len 8)
          (let [k1 (.round xh 0 (.Uint64 binary/LittleEndian buf))]
            (set! buf (subslice buf 8))
            (set! h64 bit-xor k1)
            (set! h64 (+ (* (bits/RotateLeft64 h64 27) xxhPrime64c1) xxhPrime64c4))
            (set! len - 8)))

        (when (>= len 4)
          (set! h64 bit-xor (* (conv uint64 (.Uint32 binary/LittleEndian buf)) xxhPrime64c1))
          (set! buf (subslice buf 4))
          (set! h64 (+ (* (bits/RotateLeft64 h64 23) xxhPrime64c2) xxhPrime64c3))
          (set! len - 4))

        (while (> len 0)
          (set! h64 bit-xor (* (conv uint64 (aget buf 0)) xxhPrime64c5))
          (set! buf (subslice buf 1))
          (set! h64 (* (bits/RotateLeft64 h64 11) xxhPrime64c1))
          (dec! len))


        (set! h64 bit-xor (>> h64 33))
        (set! h64 * xxhPrime64c2)
        (set! h64 bit-xor (>> h64 29))
        (set! h64 * xxhPrime64c3)
        (set! h64 bit-xor (>> h64 32))

        ^{:line 129} h64))))



^{:go/end 138} (go/method round "round updates a value.\n" ^uint64 [^{:tag (* xxhash64)} xh ^uint64 v ^uint64 n]
  (set! v + (* n xxhPrime64c2))
  (set! v (bits/RotateLeft64 v 31))
  (set! v * xxhPrime64c1)

(ns go.internal.reflectlite
  (:require [arbace.go :as go]))

(go/package reflectlite
  :path "internal/reflectlite"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["swapper.go" "type.go" "value.go"]
  :other-files ["asm.s"]
  :init-order []
  :positions :lines)

(load "reflectlite/swapper")
(load "reflectlite/type")
(load "reflectlite/value")

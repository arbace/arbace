(in-ns 'go.internal.cpu) (go/file "cpu_arm64_tamago.go" :build ["//go:build arm64"] :imports [])

^{:go/end 16} (go/func osInit []
  ;; Retrieve info from system register ID_AA64ISAR0_EL1.
  (let [isar0 (getisar0)
      ^{:line 12} isar1 (getisar1)
      ^{:line 13} prf0 (getpfr0)]

    (parseARM64SystemRegisters isar0 isar1 prf0)))

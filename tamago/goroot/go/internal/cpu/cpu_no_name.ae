(in-ns 'go.internal.cpu) (go/file "cpu_no_name.go" :build ["//go:build !386 && !amd64 && !ppc64 && !ppc64le"] :imports [])







^{:go/breaks [[4 17]] :go/end 18} (go/func Name "Name returns the CPU name given by the vendor\nif it can be read directly from memory or by CPU instructions.\nIf the CPU name can not be determined an empty string is returned.\n\nImplementations that use the Operating System (e.g. sysctl or /sys/)\nto gather CPU information for display should be placed in internal/sysinfo.\n" ^string []
  ;; "A CPU has no name".
  "")

(go/var ^{:tag (struct ^CacheLinePad _ ^bool HasAES ^bool HasPMULL ^bool HasSHA1 ^bool HasSHA2 ^bool HasSHA512 ^bool HasSHA3 ^bool HasCRC32 ^bool HasATOMICS ^bool HasCPUID ^bool HasDIT ^bool HasSB ^bool IsNeoverse ^CacheLinePad _) :doc "The booleans in ARM64 contain the correspondingly named cpu feature bit.\nThe struct is padded to avoid false sharing.\n"} ARM64)


















(go/var ^{:tag (struct ^CacheLinePad _ ^bool HasLSX ^bool HasLASX ^bool HasCRC32 ^bool HasLAMCAS ^bool HasLAM_BH ^bool HasLLACQ_SCREL ^bool HasSCQ ^bool HasDBAR_HINTS ^CacheLinePad _) :doc "The booleans in Loong64 contain the correspondingly named cpu feature bit.\nThe struct is padded to avoid false sharing.\n"} Loong64)

;; support 128-bit vector extension
;; support 256-bit vector extension

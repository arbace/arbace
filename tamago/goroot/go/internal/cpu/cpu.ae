(go/var ^{:tag (func []) :doc "doDerived, if non-nil, is called after processing GODEBUG to set \"derived\"\nfeature flags.\n"} doDerived)





^{:go/end 201} (go/func Initialize "Initialize examines the processor and sets the relevant variables above.\nThis is called by the runtime package early in program initialization,\nbefore normal init functions are run. env is set by runtime if the OS supports\ncpu feature options in GODEBUG.\n" [^string env]
  (doinit)
  (processOptions env)
  (when (!= doDerived nil)
    (doDerived)))







(go/var ^{:tag (slice option) :doc "options contains the cpu debug options that can be used in GODEBUG.\nOptions are arch dependent and are added by the arch specific doinit functions.\nFeatures that are mandatory for the specific GOARCH should not be added to options\n(e.g. SSE2 on amd64).\n"} options)


(go/type option "Option names should be lower case. e.g. avx instead of AVX.\n" (struct
    ^{:line 211 :tag string} Name
    ^{:line 212 :tag (* bool)} Feature
    ^{:line 213 :tag bool} Specified ; whether feature value was specified in GODEBUG
    ^{:line 214 :tag bool} Enable)) ; whether feature should be enabled








^{:go/end 285} (go/func processOptions "processOptions enables or disables CPU feature values based on the parsed env string.\nThe env string is expected to be of the form cpu.feature1=value1,cpu.feature2=value2...\nwhere feature names is one of the architecture specific list stored in the\ncpu packages options variable and values are either 'on' or 'off'.\nIf env contains cpu.all=off then all cpu features referenced through the options\nvariable are disabled. Other feature names and values result in warning messages.\n" [^string env]
  (label :field
    (while (!= env "")
      (let [field ""
          ^{:line 227} i (indexByte env \,)]
        (if (< i 0)
          (set! (values field env) (values env ""))

          (set! (values field env) (values (subslice env _ i) (subslice env (+ i 1)))))

        (when (or (< (len field) 4) (!= (subslice field _ 4) "cpu."))
          (continue))

        (set! i (indexByte field \=))
        (when (< i 0)
          (print "GODEBUG: no value specified for \"" field "\"\n")
          (continue))

        (let [(values key value) (values (subslice field 4 i) (subslice field (+ i 1))) ; e.g. "SSE2", "on"

            ^{:line 243 :tag bool} enable (zero bool)]
          (switch value
            (case ["on"]
              (set! enable true))
            (case ["off"]
              (set! enable false))
            (default
              (print "GODEBUG: value \"" value "\" not supported for cpu option \"" key "\"\n")
              (continue :field)))


          (when (== key "all")
            (range [i options]
              (set! (.-Specified (aget options i)) true)
              (set! (.-Enable (aget options i)) enable))

            (continue :field))


          (range [i options]
            (when (== (.-Name (aget options i)) key)
              (set! (.-Specified (aget options i)) true)
              (set! (.-Enable (aget options i)) enable)
              (continue :field)))



          (print "GODEBUG: unknown cpu feature \"" key "\"\n")))))


  (range [_ o options]
    (when (not (.-Specified o))
      (continue))


    (when (and (.-Enable o) (not @(.-Feature o)))
      (print "GODEBUG: can not enable \"" (.-Name o) "\", missing CPU support\n")
      (continue))


    (set! @(.-Feature o) (.-Enable o))))







^{:go/breaks [[5 297]] :go/end 298} (go/func indexByte "indexByte returns the index of the first instance of c in s,\nor -1 if c is not present in s.\nindexByte is semantically the same as [strings.IndexByte].\nWe copy this function because \"internal/cpu\" should not have external dependencies.\n" ^int [^string s ^byte c]
  (for [i 0] (< i (len s)) (inc! i)
    (when (== (aget s i) c)
      (return i)))


  -1)

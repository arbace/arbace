^{:go/end 232} (go/func doinit []
  (set! options (lit (slice option)
      (lit _ :Name "adx" :Feature (addr (.-HasADX X86)))
      (lit _ :Name "aes" :Feature (addr (.-HasAES X86)))
      (lit _ :Name "erms" :Feature (addr (.-HasERMS X86)))
      (lit _ :Name "fsrm" :Feature (addr (.-HasFSRM X86)))
      (lit _ :Name "pclmulqdq" :Feature (addr (.-HasPCLMULQDQ X86)))
      (lit _ :Name "rdtscp" :Feature (addr (.-HasRDTSCP X86)))
      (lit _ :Name "sha" :Feature (addr (.-HasSHA X86)))
      (lit _ :Name "vpclmulqdq" :Feature (addr (.-HasAVX512VPCLMULQDQ X86)))))

  (let [level (getGOAMD64level)]
    (when (< level 2)
      ;; These options are required at level 2. At lower levels
      ;; they can be turned off.
      (set! options (append options
          (lit option :Name "popcnt" :Feature (addr (.-HasPOPCNT X86)))
          (lit option :Name "sse3" :Feature (addr (.-HasSSE3 X86)))
          (lit option :Name "sse41" :Feature (addr (.-HasSSE41 X86)))
          (lit option :Name "sse42" :Feature (addr (.-HasSSE42 X86)))
          (lit option :Name "ssse3" :Feature (addr (.-HasSSSE3 X86))))))

    (when (< level 3)
      ;; These options are required at level 3. At lower levels
      ;; they can be turned off.
      (set! options (append options
          (lit option :Name "avx" :Feature (addr (.-HasAVX X86)))
          (lit option :Name "avx2" :Feature (addr (.-HasAVX2 X86)))
          (lit option :Name "bmi1" :Feature (addr (.-HasBMI1 X86)))
          (lit option :Name "bmi2" :Feature (addr (.-HasBMI2 X86)))
          (lit option :Name "fma" :Feature (addr (.-HasFMA X86))))))

    (when (< level 4)
      ;; These options are required at level 4. At lower levels
      ;; they can be turned off.
      (set! options (append options
          (lit option :Name "avx512f" :Feature (addr (.-HasAVX512F X86)))
          (lit option :Name "avx512cd" :Feature (addr (.-HasAVX512CD X86)))
          (lit option :Name "avx512bw" :Feature (addr (.-HasAVX512BW X86)))
          (lit option :Name "avx512dq" :Feature (addr (.-HasAVX512DQ X86)))
          (lit option :Name "avx512vl" :Feature (addr (.-HasAVX512VL X86))))))



    (let [(values maxID _ _ _) (cpuid 0 0)]

      (when (< maxID 1)
        (osInit)
        (return))


      (set! (values maxExtendedFunctionInformation _ _ _) (cpuid 0x80000000 0))

      (let [(values _ _ ecx1 _) (cpuid 1 0)]

        (set! (.-HasSSE3 X86) (isSet ecx1 cpuid_SSE3))
        (set! (.-HasPCLMULQDQ X86) (isSet ecx1 cpuid_PCLMULQDQ))
        (set! (.-HasSSSE3 X86) (isSet ecx1 cpuid_SSSE3))
        (set! (.-HasSSE41 X86) (isSet ecx1 cpuid_SSE41))
        (set! (.-HasSSE42 X86) (isSet ecx1 cpuid_SSE42))
        (set! (.-HasPOPCNT X86) (isSet ecx1 cpuid_POPCNT))
        (set! (.-HasAES X86) (isSet ecx1 cpuid_AES))

        ;; OSXSAVE can be false when using older Operating Systems
        ;; or when explicitly disabled on newer Operating Systems by
        ;; e.g. setting the xsavedisable boot option on Windows 10.
        (set! (.-HasOSXSAVE X86) (isSet ecx1 cpuid_OSXSAVE))

        (let [osSupportsAVX false
            ^{:line 141} osSupportsAVX512 false]
          ;; For XGETBV, OSXSAVE bit is required and sufficient.
          (when (.-HasOSXSAVE X86)
            (let [(values eax _) (xgetbv)]
              ;; Check if XMM and YMM registers have OS support.
              (set! osSupportsAVX (and (isSet eax (<< 1 1)) (isSet eax (<< 1 2))))

              ;; AVX512 detection does not work on Darwin,
              ;; see https://github.com/golang/go/issues/49233
              ;;
              ;; Check if opmask, ZMMhi256 and Hi16_ZMM have OS support.
              (set! osSupportsAVX512 (and osSupportsAVX (isSet eax (<< 1 5)) (isSet eax (<< 1 6)) (isSet eax (<< 1 7))))))


          (set! (.-HasAVX X86) (and (isSet ecx1 cpuid_AVX) osSupportsAVX))

          ;; The FMA instruction set extension requires both the FMA and AVX flags.
          ;;
          ;; Furthermore, the FMA instructions are all VEX prefixed instructions.
          ;; VEX prefixed instructions require OSXSAVE to be enabled.
          ;; See Intel 64 and IA-32 Architecture Software Developer’s Manual Volume 2
          ;; Section 2.4 "AVX and SSE Instruction Exception Specification"
          (set! (.-HasFMA X86) (and (isSet ecx1 cpuid_FMA) (.-HasAVX X86) (.-HasOSXSAVE X86)))

          (when (< maxID 7)
            (osInit)
            (return))


          (let [(values eax7 ebx7 ecx7 edx7) (cpuid 7 0)]
            (set! (.-HasBMI1 X86) (isSet ebx7 cpuid_BMI1))
            (set! (.-HasAVX2 X86) (and (isSet ebx7 cpuid_AVX2) osSupportsAVX))
            (set! (.-HasBMI2 X86) (isSet ebx7 cpuid_BMI2))
            (set! (.-HasERMS X86) (isSet ebx7 cpuid_ERMS))
            (set! (.-HasADX X86) (isSet ebx7 cpuid_ADX))
            (set! (.-HasSHA X86) (isSet ebx7 cpuid_SHA))
            (set! (.-HasVAES X86) (and (isSet ecx7 cpuid_VAES) (.-HasAVX X86)))
            (set! (.-HasVPCLMULQDQ X86) (isSet ecx7 cpuid_VPCLMULQDQ))

            (set! (.-HasAVX512F X86) (and (isSet ebx7 cpuid_AVX512F) osSupportsAVX512))
            (when (.-HasAVX512F X86)
              (set! (.-HasAVX512CD X86) (isSet ebx7 cpuid_AVX512CD))
              (set! (.-HasAVX512BW X86) (isSet ebx7 cpuid_AVX512BW))
              (set! (.-HasAVX512DQ X86) (isSet ebx7 cpuid_AVX512DQ))
              (set! (.-HasAVX512VL X86) (isSet ebx7 cpuid_AVX512VL))
              (set! (.-HasAVX512GFNI X86) (isSet ecx7 cpuid_AVX512GFNI))
              (set! (.-HasAVX512BITALG X86) (isSet ecx7 cpuid_AVX512BITALG))
              (set! (.-HasAVX512VPOPCNTDQ X86) (isSet ecx7 cpuid_AVX512VPOPCNTDQ))
              (set! (.-HasAVX512VBMI X86) (isSet ecx7 cpuid_AVX512VBMI))
              (set! (.-HasAVX512VBMI2 X86) (isSet ecx7 cpuid_AVX512VBMI2))
              (set! (.-HasAVX512VAES X86) (and (isSet ecx7 cpuid_VAES) (.-HasAES X86) (isSet ebx7 cpuid_AVX512VL)))
              (set! (.-HasAVX512VNNI X86) (isSet ecx7 cpuid_AVX512VNNI))
              (set! (.-HasAVX512VPCLMULQDQ X86) (isSet ecx7 cpuid_AVX512VPCLMULQDQ))
              (set! (.-HasAVX512VBMI X86) (isSet ecx7 cpuid_AVX512_VBMI))
              (set! (.-HasAVX512VBMI2 X86) (isSet ecx7 cpuid_AVX512_VBMI2))
              (set! (.-HasGFNI X86) (isSet ecx7 cpuid_GFNI))
              (set! (.-HasAVX512BITALG X86) (isSet ecx7 cpuid_AVX512_BITALG)))


            (set! (.-HasFSRM X86) (isSet edx7 cpuid_FSRM))

            (let [^uint32 maxExtendedInformation (zero uint32)]
              (set! (values maxExtendedInformation _ _ _) (cpuid 0x80000000 0))

              (when (< maxExtendedInformation 0x80000001)
                (osInit)
                (return))


              (let [(values _ _ _ edxExt1) (cpuid 0x80000001 0)]
                (set! (.-HasRDTSCP X86) (isSet edxExt1 cpuid_RDTSCP))

                (set! doDerived ^{:go/end 222} (fn []
                    ;; Rather than carefully gating on fundamental AVX-512 features, we have
                    ;; a virtual "AVX512" feature that captures F+CD+BW+DQ+VL. BW, DQ, and
                    ;; VL have a huge effect on which AVX-512 instructions are available,
                    ;; and these have all been supported on everything except the earliest
                    ;; Phi chips with AVX-512. No CPU has had CD without F, so we include
                    ;; it. GOAMD64=v4 also implies exactly this set, and these are all
                    ;; included in AVX10.1.
                    (set! (.-HasAVX512 X86) (and (.-HasAVX512F X86) (.-HasAVX512CD X86) (.-HasAVX512BW X86) (.-HasAVX512DQ X86) (.-HasAVX512VL X86)))))


                (when (>= eax7 1)
                  (let [(values eax71 _ _ _) (cpuid 7 1)]
                    (when (.-HasAVX X86)
                      (set! (.-HasAVXVNNI X86) (isSet eax71 cpuid_AVXVNNI)))))



                (osInit)))))))))


^{:go/end 236} (go/func isSet ^bool [^uint32 hwc ^uint32 value]
  (!= (bit-and hwc value) 0))





^{:go/end 270} (go/func Name "Name returns the CPU name given by the vendor.\nIf the CPU name can not be determined an\nempty string is returned.\n" ^string []
  (when (< maxExtendedFunctionInformation 0x80000004)
    (return ""))


  (let [data (make (slice byte) 0 (* 3 4 4))

      (values ^uint32 eax ^uint32 ebx ^uint32 ecx ^uint32 edx) (zero uint32)]
    (set! (values eax ebx ecx edx) (cpuid 0x80000002 0))
    (set! data (appendBytes data eax ebx ecx edx))
    (set! (values eax ebx ecx edx) (cpuid 0x80000003 0))
    (set! data (appendBytes data eax ebx ecx edx))
    (set! (values eax ebx ecx edx) (cpuid 0x80000004 0))
    (set! data (appendBytes data eax ebx ecx edx))

    ;; Trim leading spaces.
    (while (and (> (len data) 0) (== (aget data 0) \space))
      (set! data (subslice data 1)))


    ;; Trim tail after and including the first null byte.
    (range [i c data]
      (when (== c \u0000)
        (set! data (subslice data _ i))
        (break)))



    (conv string data)))


^{:go/end 281} (go/func appendBytes ^{:tag (slice byte)} [^{:tag (slice byte)} b & ^{:tag (slice uint32)} args]
  (range [_ arg args]
    (set! b (append b
        (conv byte (>> arg 0))
        (conv byte (>> arg 8))
        (conv byte (>> arg 16))
        (conv byte (>> arg 24)))))

  ^{:line 280} b)

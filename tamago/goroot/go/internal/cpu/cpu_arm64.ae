(in-ns 'go.internal.cpu) (go/file "cpu_arm64.go" :imports [])




(go/const ^{:val 128 :doc "CacheLinePadSize is used to prevent false sharing of cache lines.\nWe choose 128 because Apple Silicon, a.k.a. M1, has 128-byte cache line size.\nIt doesn't cost much and is much more future-proof.\n"} CacheLinePadSize 128)

^{:go/end 28} (go/func doinit []
  (set! options (lit (slice option)
      (lit _ :Name "aes" :Feature (addr (.-HasAES ARM64)))
      (lit _ :Name "pmull" :Feature (addr (.-HasPMULL ARM64)))
      (lit _ :Name "sha1" :Feature (addr (.-HasSHA1 ARM64)))
      (lit _ :Name "sha2" :Feature (addr (.-HasSHA2 ARM64)))
      (lit _ :Name "sha512" :Feature (addr (.-HasSHA512 ARM64)))
      (lit _ :Name "sha3" :Feature (addr (.-HasSHA3 ARM64)))
      (lit _ :Name "crc32" :Feature (addr (.-HasCRC32 ARM64)))
      (lit _ :Name "atomics" :Feature (addr (.-HasATOMICS ARM64)))
      (lit _ :Name "cpuid" :Feature (addr (.-HasCPUID ARM64)))
      (lit _ :Name "isNeoverse" :Feature (addr (.-IsNeoverse ARM64)))))


  ;; arm64 uses different ways to detect CPU features at runtime depending on the operating system.
  (osInit))


(go/func ^:extern getisar0 ^uint64 [])

(go/func ^:extern getisar1 ^uint64 [])

(go/func ^:extern getpfr0 ^uint64 [])

(go/func ^:extern getMIDR ^uint64 [])

^{:go/end 40} (go/func extractBits ^uint [^uint64 data ^uint start ^uint end]
  (bit-and (conv uint (>> data start)) (- ^uint (<< 1 (+ (- end start) 1)) 1)))


^{:go/end 90} (go/func parseARM64SystemRegisters [^uint64 isar0 ^uint64 isa1 ^uint64 pfr0]
  ;; ID_AA64ISAR0_EL1
  ;; https://developer.arm.com/documentation/ddi0601/2025-03/AArch64-Registers/ID-AA64ISAR0-EL1--AArch64-Instruction-Set-Attribute-Register-0
  (switch (extractBits isar0 4 7)
    (case [1]
      (set! (.-HasAES ARM64) true))
    (case [2]
      (set! (.-HasAES ARM64) true)
      (set! (.-HasPMULL ARM64) true)))


  (switch (extractBits isar0 8 11)
    (case [1]
      (set! (.-HasSHA1 ARM64) true)))


  (switch (extractBits isar0 12 15)
    (case [1]
      (set! (.-HasSHA2 ARM64) true))
    (case [2]
      (set! (.-HasSHA2 ARM64) true)
      (set! (.-HasSHA512 ARM64) true)))


  (switch (extractBits isar0 16 19)
    (case [1]
      (set! (.-HasCRC32 ARM64) true)))


  (switch (extractBits isar0 20 23)
    (case [2]
      (set! (.-HasATOMICS ARM64) true)))


  (switch (extractBits isar0 32 35)
    (case [1]
      (set! (.-HasSHA3 ARM64) true)))


  (switch (extractBits isa1 36 39)
    (case [1]
      (set! (.-HasSB ARM64) true)))


  (switch (extractBits pfr0 48 51)
    (case [1]
      (set! (.-HasDIT ARM64) true))))

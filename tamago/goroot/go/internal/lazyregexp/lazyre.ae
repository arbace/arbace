;; Package lazyregexp is a thin wrapper over regexp, allowing the use of global
;; regexp variables without forcing them to be compiled at init.
(in-ns 'go.internal.lazyregexp) (go/file "lazyre.go" :doc "Package lazyregexp is a thin wrapper over regexp, allowing the use of global\nregexp variables without forcing them to be compiled at init.\n" :imports [


    ^{:line 10} [os "os"]
    ^{:line 11} [regexp "regexp"]
    ^{:line 12} [strings "strings"]
    ^{:line 13} [sync "sync"]])




(go/type Regexp "Regexp is a wrapper around regexp.Regexp, where the underlying regexp will be\ncompiled the first time it is needed.\n" (struct
    ^{:line 19 :tag string} str
    ^{:line 20 :tag sync/Once} once
    ^{:line 21 :tag (* regexp/Regexp)} rx))


^{:go/end 27} (go/method re ^{:tag (* regexp/Regexp)} [^{:tag (* Regexp)} r]
  (.Do (.-once r) (.-build r))
  (.-rx r))


^{:go/end 32} (go/method build [^{:tag (* Regexp)} r]
  (set! (.-rx r) (regexp/MustCompile (.-str r)))
  (set! (.-str r) ""))


^{:go/end 36} (go/method FindSubmatch ^{:tag (slice (slice byte))} [^{:tag (* Regexp)} r ^{:tag (slice byte)} s]
  (.FindSubmatch (.re r) s))


^{:go/end 40} (go/method FindStringSubmatch ^{:tag (slice string)} [^{:tag (* Regexp)} r ^string s]
  (.FindStringSubmatch (.re r) s))


^{:go/end 44} (go/method FindStringSubmatchIndex ^{:tag (slice int)} [^{:tag (* Regexp)} r ^string s]
  (.FindStringSubmatchIndex (.re r) s))


^{:go/end 48} (go/method ReplaceAll ^{:tag (slice byte)} [^{:tag (* Regexp)} r ^{:tag (slice byte)} src ^{:tag (slice byte)} repl]
  (.ReplaceAll (.re r) src repl))


^{:go/end 52} (go/method ReplaceAllString ^string [^{:tag (* Regexp)} r ^string src ^string repl]
  (.ReplaceAllString (.re r) src repl))


^{:go/end 56} (go/method FindString ^string [^{:tag (* Regexp)} r ^string s]
  (.FindString (.re r) s))


^{:go/end 60} (go/method FindAllString ^{:tag (slice string)} [^{:tag (* Regexp)} r ^string s ^int n]
  (.FindAllString (.re r) s n))


^{:go/end 64} (go/method MatchString ^bool [^{:tag (* Regexp)} r ^string s]
  (.MatchString (.re r) s))


^{:go/end 68} (go/method SubexpNames ^{:tag (slice string)} [^{:tag (* Regexp)} r]
  (.SubexpNames (.re r)))


(go/var inTest (and (> (len os/Args) 0) (strings/HasSuffix (strings/TrimSuffix (aget os/Args 0) ".exe") ".test")))




^{:go/end 82} (go/func New "New creates a new lazy regexp, delaying the compiling work until it is first\nneeded. If the code is being run as part of tests, the regexp compiling will\nhappen immediately.\n" ^{:tag (* Regexp)} [^string str]
  (let [lr (addr (lit Regexp :str str))]
    (when inTest
      ;; In tests, always compile the regexps early.
      (.re lr))

    ^{:line 81} lr))

;; Package godebugs provides a table of known GODEBUG settings,
;; for use by a variety of other packages, including internal/godebug,
;; runtime, runtime/metrics, and cmd/go/internal/load.
(in-ns 'go.internal.godebugs) (go/file "table.go" :doc "Package godebugs provides a table of known GODEBUG settings,\nfor use by a variety of other packages, including internal/godebug,\nruntime, runtime/metrics, and cmd/go/internal/load.\n" :imports [])


(go/type Info "An Info describes a single known GODEBUG setting.\n" (struct
    ^{:line 12 :tag string} Name ; name of the setting ("panicnil")
    ^{:line 13 :tag string} Package ; package that uses the setting ("runtime")
    ^{:line 14 :tag int} Changed ; minor version when default changed, if any; 21 means Go 1.21
    ^{:line 15 :tag string} Old ; value that restores behavior prior to Changed
    ^{:line 16 :tag bool} Opaque ; setting does not export information to runtime/metrics using [internal/godebug.Setting.IncNonDefault]
    ^{:line 17 :tag bool} Immutable)) ; setting cannot be changed after program start










(go/var ^{:doc "All is the table of known settings, sorted by Name.\n\nNote: After adding entries to this table, run 'go generate runtime/metrics'\nto update the runtime/metrics doc comment.\n(Otherwise the runtime/metrics test will fail.)\n\nNote: After adding entries to this table, update the list in doc/godebug.md as well.\n(Otherwise the test in this package will fail.)\n"} All (lit (slice Info)
    (lit _ :Name "allowmultiplevcs" :Package "cmd/go")
    (lit _ :Name "containermaxprocs" :Package "runtime" :Changed 25 :Old "0")
    (lit _ :Name "cryptocustomrand" :Package "crypto" :Changed 26 :Old "1")
    (lit _ :Name "dataindependenttiming" :Package "crypto/subtle" :Opaque true)
    (lit _ :Name "decoratemappings" :Package "runtime" :Opaque true :Changed 25 :Old "0")
    (lit _ :Name "embedfollowsymlinks" :Package "cmd/go")
    (lit _ :Name "execerrdot" :Package "os/exec")
    (lit _ :Name "fips140" :Package "crypto/fips140" :Opaque true :Immutable true)
    (lit _ :Name "fips140ems" :Package "crypto/tls")
    (lit _ :Name "gocachehash" :Package "cmd/go")
    (lit _ :Name "gocachetest" :Package "cmd/go")
    (lit _ :Name "gocacheverify" :Package "cmd/go")
    (lit _ :Name "gotestjsonbuildtext" :Package "cmd/go" :Changed 24 :Old "1")
    (lit _ :Name "htmlmetacontenturlescape" :Package "html/template")
    (lit _ :Name "http2client" :Package "net/http")
    (lit _ :Name "http2debug" :Package "net/http" :Opaque true)
    (lit _ :Name "http2server" :Package "net/http")
    (lit _ :Name "httpcookiemaxnum" :Package "net/http" :Changed 24 :Old "0")
    (lit _ :Name "httplaxcontentlength" :Package "net/http" :Changed 22 :Old "1")
    (lit _ :Name "httpmuxgo121" :Package "net/http" :Changed 22 :Old "1")
    (lit _ :Name "httpservecontentkeepheaders" :Package "net/http" :Changed 23 :Old "1")
    (lit _ :Name "installgoroot" :Package "go/build")
    (lit _ :Name "jstmpllitinterp" :Package "html/template" :Opaque true) ; bug #66217: remove Opaque
    ;;{Name: "multipartfiles", Package: "mime/multipart"},
    (lit _ :Name "multipartmaxheaders" :Package "mime/multipart")
    (lit _ :Name "multipartmaxparts" :Package "mime/multipart")
    (lit _ :Name "multipathtcp" :Package "net" :Changed 24 :Old "0")
    (lit _ :Name "netdns" :Package "net" :Opaque true)
    (lit _ :Name "netedns0" :Package "net" :Changed 19 :Old "0")
    (lit _ :Name "panicnil" :Package "runtime" :Changed 21 :Old "1")
    (lit _ :Name "randautoseed" :Package "math/rand")
    (lit _ :Name "randseednop" :Package "math/rand" :Changed 24 :Old "0")
    (lit _ :Name "rsa1024min" :Package "crypto/rsa" :Changed 24 :Old "0")
    (lit _ :Name "tarinsecurepath" :Package "archive/tar")
    (lit _ :Name "tlsmaxrsasize" :Package "crypto/tls")
    (lit _ :Name "tlsmlkem" :Package "crypto/tls" :Changed 24 :Old "0" :Opaque true)
    (lit _ :Name "tlssecpmlkem" :Package "crypto/tls" :Changed 26 :Old "0" :Opaque true)
    (lit _ :Name "tlssha1" :Package "crypto/tls" :Changed 25 :Old "1")
    ;; Mark tracebacklabels as Opaque so we don't generate a metric that we can't increment.
    ;; IncNonDefault uses a sync.Once, which involves sync.Mutex, and is not safe from a signal handler.
    ;; (Tracebacks are generated in signal-handlers.)
    (lit _ :Name "tracebacklabels" :Package "runtime" :Changed 27 :Old "0" :Opaque true)
    (lit _ :Name "updatemaxprocs" :Package "runtime" :Changed 25 :Old "0")
    (lit _ :Name "urlmaxqueryparams" :Package "net/url" :Changed 24 :Old "0")
    (lit _ :Name "urlstrictcolons" :Package "net/url" :Changed 26 :Old "0")
    (lit _ :Name "winreadlinkvolume" :Package "os" :Changed 23 :Old "0")
    (lit _ :Name "winsymlink" :Package "os" :Changed 23 :Old "0")
    (lit _ :Name "x509negativeserial" :Package "crypto/x509" :Changed 23 :Old "1")
    (lit _ :Name "x509rsacrt" :Package "crypto/x509" :Changed 24 :Old "0")
    (lit _ :Name "x509sha256skid" :Package "crypto/x509" :Changed 25 :Old "0")
    (lit _ :Name "x509sslcertoverrideplatform" :Package "crypto/x509" :Changed 27 :Old "0")
    (lit _ :Name "x509usefallbackroots" :Package "crypto/x509")
    (lit _ :Name "x509usepolicies" :Package "crypto/x509" :Changed 24 :Old "0")
    (lit _ :Name "zipinsecurepath" :Package "archive/zip")))








(go/type RemovedInfo "A RemovedInfo describes a GODEBUG setting that has been removed.\n\nPer the policy for removing GODEBUG settings (go.dev/issue/76163), using any non-\"old\"\nvalue for the removed setting is permissible. Using an old value, indicating a non-final\ndefault value for that setting, leads to a build or vet error.\nTo support multiple \"old\" values (see asynctimerchan), the Old field is a predicate.\n" (struct
    ^{:line 92 :tag string} Name ; name of the removed GODEBUG setting.
    ^{:line 93 :tag int} Removed ; minor version of Go, when the removal happened
    ^{:line 94 :tag (func [string] [bool])} Old)) ; reports whether the GODEBUG value (argument) is an old (invalid) value






(go/var ^{:doc "Removed contains all GODEBUGs that we have removed.\n\nEvery removed GODEBUG must have a corresponding section in doc/godebug.md,\nsince cmd/go links to that document when a removed GODEBUG is used.\n"} Removed (lit (slice RemovedInfo)
    (lit _ :Name "x509sha1" :Removed 24 :Old one) ; Old: "1"
    (lit _ :Name "tlskyber" :Removed 24 :Old zero) ; Old: "0"
    (lit _ :Name "gotypesalias" :Removed 27 :Old zero) ; Old: "0"
    (lit _ :Name "tlsunsafeekm" :Removed 27 :Old one) ; Old: "1"
    (lit _ :Name "tlsrsakex" :Removed 27 :Old one) ; Old: "1"
    (lit _ :Name "tls3des" :Removed 27 :Old one) ; Old: "1"
    (lit _ :Name "tls10server" :Removed 27 :Old one) ; Old: "1"
    (lit _ :Name "x509keypairleaf" :Removed 27 :Old zero) ; Old: "0"
    (lit _ :Name "asynctimerchan" :Removed 27 :Old ^{:go/end 110} (fn ^bool [^string s] (or (== s "1") (== s "2")))))) ; Old: "1" or "2"


^{:go/end 113} (go/func zero ^bool [^string s] (== s "0"))
^{:go/end 114} (go/func one ^bool [^string s] (== s "1"))


^{:go/end 134} (go/func Lookup "Lookup returns the Info with the given name.\n" ^{:tag (* Info)} [^string name]
  ;; binary search, avoiding import of sort.
  ^{:go/breaks [[3 133]]} (let [lo 0
      ^{:line 120} hi (len All)]
    (while (< lo hi)
      (let [m (conv int (>> (conv uint (+ lo hi)) 1))
          ^{:line 123} mid (.-Name (aget All m))]
        (when (== name mid)
          (return (addr (aget All m))))

        (if (< name mid)
          (set! hi m)

          (set! lo (+ m 1)))))


    nil))

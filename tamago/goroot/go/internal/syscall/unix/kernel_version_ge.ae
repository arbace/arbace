(in-ns 'go.internal.syscall.unix) (go/file "kernel_version_ge.go" :imports [])



^{:go/end 13} (go/func KernelVersionGE "KernelVersionGE checks if the running kernel version\nis greater than or equal to the provided version.\n" ^bool [^int x ^int y]
  (let [(values xx yy) (KernelVersion)]

    (or (> xx x) ^:go/paren (and (== xx x) (>= yy y)))))

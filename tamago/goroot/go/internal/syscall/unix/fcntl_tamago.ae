(in-ns 'go.internal.syscall.unix) (go/file "fcntl_tamago.go" :build ["//go:build tamago"] :imports [

    ^{:line 9} [syscall "syscall"]])

^{:go/end 13} (go/func Fcntl [^int fd ^int cmd ^int arg] :results [int error]
  (return 0 syscall/ENOSYS))

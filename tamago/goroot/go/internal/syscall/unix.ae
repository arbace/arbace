(ns go.internal.syscall.unix
  (:require [arbace.go :as go]))

(go/package unix
  :path "internal/syscall/unix"
  :files ["at_tamago.go" "fcntl_tamago.go" "kernel_version_ge.go" "kernel_version_other.go" "net_tamago.go" "nonblocking_tamago.go" "syscall.go"]
  :positions :lines)

(load "unix/at_tamago")
(load "unix/fcntl_tamago")
(load "unix/kernel_version_ge")
(load "unix/kernel_version_other")
(load "unix/net_tamago")
(load "unix/nonblocking_tamago")
(load "unix/syscall")

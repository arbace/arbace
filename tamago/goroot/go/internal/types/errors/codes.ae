  ^{:line 259} [^{:val 25 :doc "NotAType occurs when the identifier used as the underlying type in a type\ndeclaration or the right-hand side of a type alias does not denote a type.\n\nExample:\n var S = 2\n\n type T S\n"} NotAType]






  ^{:line 266} [^{:val 26 :doc "InvalidArrayLen occurs when an array length is not a constant value.\n\nExample:\n var n = 3\n var _ = [n]int{}\n"} InvalidArrayLen]











  ^{:line 278} [^{:val 27 :doc "BlankIfaceMethod occurs when a method name is '_'.\n\nPer the spec:\n \"The name of each explicitly specified method must be unique and not\n blank.\"\n\nExample:\n type T interface {\n \t_(int)\n }\n"} BlankIfaceMethod]













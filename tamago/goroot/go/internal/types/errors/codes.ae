  ^{:line 1044} [^{:val 111 :doc "MisplacedContinue occurs when a continue statement is not within a for\nloop of the innermost function definition.\n\nExample:\n func sumeven(n int) int {\n \tproceed := func() {\n \t\tcontinue\n \t}\n \tsum := 0\n \tfor i := 1; i <= n; i++ {\n \t\tif i % 2 != 0 {\n \t\t\tproceed()\n \t\t}\n \t\tsum += i\n \t}\n \treturn sum\n }\n"} MisplacedContinue]














  ^{:line 1059} [^{:val 112 :doc "MisplacedFallthrough occurs when a fallthrough statement is not within an\nexpression switch.\n\nExample:\n func typename(i interface{}) string {\n \tswitch i.(type) {\n \tcase int64:\n \t\tfallthrough\n \tcase int:\n \t\treturn \"int\"\n \t}\n \treturn \"unsupported\"\n }\n"} MisplacedFallthrough]













  ^{:line 1073} [^{:val 113 :doc "DuplicateCase occurs when a type or expression switch has duplicate\ncases.\n\nExample:\n func printInt(i int) {\n \tswitch i {\n \tcase 1:\n \t\tprintln(\"one\")\n \tcase 1:\n \t\tprintln(\"One\")\n \t}\n }\n"} DuplicateCase]















  ^{:line 1089} [^{:val 114 :doc "DuplicateDefault occurs when a type or expression switch has multiple\ndefault clauses.\n\nExample:\n func printInt(i int) {\n \tswitch i {\n \tcase 1:\n \t\tprintln(\"one\")\n \tdefault:\n \t\tprintln(\"One\")\n \tdefault:\n \t\tprintln(\"1\")\n \t}\n }\n"} DuplicateDefault]











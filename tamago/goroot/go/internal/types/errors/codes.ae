(in-ns 'go.internal.types.errors) (go/file "codes.go" :imports [])

(go/directive "//go:generate go run golang.org/x/tools/cmd/stringer@latest -type Code codes.go")

(go/type Code int)

;; This file defines the error codes that can be produced during type-checking.
;; Collectively, these codes provide an identifier that may be used to
;; implement special handling for certain types of errors.
;;
;; Error code values should not be changed: add new codes at the end.
;;
;; Error codes should be fine-grained enough that the exact nature of the error
;; can be easily determined, but coarse enough that they are not an
;; implementation detail of the type checking algorithm. As a rule-of-thumb,
;; errors should be considered equivalent if there is a theoretical refactoring
;; of the type checker in which they are emitted in exactly one place. For
;; example, the type checker emits different error messages for "too many
;; arguments" and "too few arguments", but one can imagine an alternative type
;; checker where this check instead just emits a single "wrong number of
;; arguments", so these errors should have the same code.
;;
;; Error code names should be as brief as possible while retaining accuracy and
;; distinctiveness. In most cases names should start with an adjective
;; describing the nature of the error (e.g. "invalid", "unused", "misplaced"),
;; and end with a noun identifying the relevant language object. For example,
;; "_DuplicateDecl" or "_InvalidSliceExpr". For brevity, naming follows the
;; convention that "bad" implies a problem with syntax, and "invalid" implies a
;; problem with types.

(go/const


  ^{:line 38} [^{:tag Code :val -1 :doc "InvalidSyntaxTree occurs if an invalid syntax tree is provided\nto the type checker. It should never happen.\n"} InvalidSyntaxTree -1])


(go/const

  ^{:line 43} [^{:tag Code :val 0 :doc "The zero Code value indicates an unset (invalid) error code.\n"} _ iota]


  ^{:line 46} [^{:val 1 :doc "Test is reserved for errors that only apply while in self-test mode.\n"} Test]








  ^{:line 55} [^{:val 2 :doc "BlankPkgName occurs when a package name is the blank identifier \"_\".\n\nPer the spec:\n \"The PackageName must not be the blank identifier.\"\n\nExample:\n package _\n"} BlankPkgName]



  ^{:line 59} [^{:val 3 :doc "MismatchedPkgName occurs when a file's package name doesn't match the\npackage name already established by other files.\n"} MismatchedPkgName]








  ^{:line 68} [^{:val 4 :doc "InvalidPkgUse occurs when a package identifier is used outside of a\nselector expression.\n\nExample:\n import \"fmt\"\n\n var _ = fmt\n"} InvalidPkgUse]


  ^{:line 71} [^{:val 5 :doc "BadImportPath occurs when an import path is not valid.\n"} BadImportPath]





  ^{:line 77} [^{:val 6 :doc "BrokenImport occurs when importing a package fails.\n\nExample:\n import \"amissingpackage\"\n"} BrokenImport]






  ^{:line 84} [^{:val 7 :doc "ImportCRenamed occurs when the special import \"C\" is renamed. \"C\" is a\npseudo-package, and must not be renamed.\n\nExample:\n import _ \"C\"\n"} ImportCRenamed]







  ^{:line 92} [^{:val 8 :doc "UnusedImport occurs when an import is unused.\n\nExample:\n import \"fmt\"\n\n func main() {}\n"} UnusedImport]








  ^{:line 101} [^{:val 9 :doc "InvalidInitCycle occurs when an invalid cycle is detected within the\ninitialization graph.\n\nExample:\n var x int = f()\n\n func f() int { return x }\n"} InvalidInitCycle]






  ^{:line 108} [^{:val 10 :doc "DuplicateDecl occurs when an identifier is declared multiple times.\n\nExample:\n var x = 1\n var x = 2\n"} DuplicateDecl]












  ^{:line 121} [^{:val 11 :doc "InvalidDeclCycle occurs when a declaration cycle is not valid.\n\nExample:\n type S struct {\n \tS\n }\n\nExample:\n import \"unsafe\"\n\n type T [unsafe.Sizeof(T{})]int\n"} InvalidDeclCycle]

  ;; TODO(markfreeman): Retire InvalidTypeCycle, as it's never emitted.



  ^{:line 127} [^{:val 12 :doc "InvalidTypeCycle occurs when a cycle in type definitions results in a\ntype that is not well-defined.\n"} InvalidTypeCycle]







  ^{:line 135} [^{:val 13 :doc "InvalidConstInit occurs when a const declaration has a non-constant\ninitializer.\n\nExample:\n var x int\n const _ = x\n"} InvalidConstInit]









  ^{:line 145} [^{:val 14 :doc "InvalidConstVal occurs when a const value cannot be converted to its\ntarget type.\n\nTODO(findleyr): this error code and example are not very clear. Consider\nremoving it.\n\nExample:\n const _ = 1 << \"hello\"\n"} InvalidConstVal]






  ^{:line 152} [^{:val 15 :doc "InvalidConstType occurs when the underlying type in a const declaration\nis not a valid constant type.\n\nExample:\n const c *int = 4\n"} InvalidConstType]






  ^{:line 159} [^{:val 16 :doc "UntypedNilUse occurs when the predeclared (untyped) value nil is used to\ninitialize a variable declared without an explicit type.\n\nExample:\n var x = nil\n"} UntypedNilUse]







  ^{:line 167} [^{:val 17 :doc "WrongAssignCount occurs when the number of values on the right-hand side\nof an assignment or initialization expression does not match the number\nof variables on the left-hand side.\n\nExample:\n var x = 1, 2\n"} WrongAssignCount]









  ^{:line 177} [^{:val 18 :doc "UnassignableOperand occurs when the left-hand side of an assignment is\nnot assignable.\n\nExample:\n func f() {\n \tconst c = 1\n \tc = 2\n }\n"} UnassignableOperand]









  ^{:line 187} [^{:val 19 :doc "NoNewVar occurs when a short variable declaration (':=') does not declare\nnew variables.\n\nExample:\n func f() {\n \tx := 1\n \tx := 2\n }\n"} NoNewVar]














  ^{:line 202} [^{:val 20 :doc "MultiValAssignOp occurs when an assignment operation (+=, *=, etc) does\nnot have single-valued left-hand or right-hand side.\n\nPer the spec:\n \"In assignment operations, both the left- and right-hand expression lists\n must contain exactly one single-valued expression\"\n\nExample:\n func f() int {\n \tx, y := 1, 2\n \tx, y += 1\n \treturn x + y\n }\n"} MultiValAssignOp]












  ^{:line 215} [^{:val 21 :doc "InvalidIfaceAssign occurs when a value of type T is used as an\ninterface, but T does not implement a method of the expected interface.\n\nExample:\n type I interface {\n \tf()\n }\n\n type T int\n\n var x I = T(1)\n"} InvalidIfaceAssign]















  ^{:line 231} [^{:val 22 :doc "InvalidChanAssign occurs when a chan assignment is invalid.\n\nPer the spec, a value x is assignable to a channel type T if:\n \"x is a bidirectional channel value, T is a channel type, x's type V and\n T have identical element types, and at least one of V or T is not a\n defined type.\"\n\nExample:\n type T1 chan int\n type T2 chan int\n\n var x T1\n // Invalid assignment because both types are named\n var _ T2 = x\n"} InvalidChanAssign]








  ^{:line 240} [^{:val 23 :doc "IncompatibleAssign occurs when the type of the right-hand side expression\nin an assignment cannot be assigned to the type of the variable being\nassigned.\n\nExample:\n var x []int\n var _ int = x\n"} IncompatibleAssign]










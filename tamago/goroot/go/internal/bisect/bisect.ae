        (dec! i)
        (aset buf i (+ \0 (conv byte (% u 10))))
        (set! u / 10))

      (set! dst (append dst (spread (subslice buf i))))
      ^{:line 410} dst)))





^{:go/end 421} (go/method Stack "MatchStack assigns the current call stack a change ID.\nIf the stack should be printed, MatchStack prints it.\nThen MatchStack reports whether a change at the current call stack should be enabled.\n" ^bool [^{:tag (* Matcher)} m ^Writer w]
  (when (== m nil)
    (return true))

  (.stack m w))




^{:go/end 469} (go/method stack "stack does the real work for Stack.\nThis lets stack's body handle m == nil and potentially be inlined.\n" ^bool [^{:tag (* Matcher)} m ^Writer w]
  (let [^:const ^{:val 16} maxStack 16
      ^{:line 427 :tag (array maxStack uintptr)} stk (zero (array maxStack uintptr))
      ^{:line 428} n (runtime/Callers 2 (subslice stk))]
    ;; caller #2 is not for printing; need it to normalize PCs if ASLR.

;; Package oserror defines errors values used in the os package.
;;
;; These types are defined here to permit the syscall package to reference them.
(in-ns 'go.internal.oserror) (go/file "errors.go" :doc "Package oserror defines errors values used in the os package.\n\nThese types are defined here to permit the syscall package to reference them.\n" :imports [

    ^{:line 10} [errors "errors"]])

(go/var
  ^{:line 13} [ErrInvalid (errors/New "invalid argument")]
  ^{:line 14} [ErrPermission (errors/New "permission denied")]
  ^{:line 15} [ErrExist (errors/New "file already exists")]
  ^{:line 16} [ErrNotExist (errors/New "file does not exist")]
  ^{:line 17} [ErrClosed (errors/New "file already closed")])

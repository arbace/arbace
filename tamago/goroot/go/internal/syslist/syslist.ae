;; Package syslist stores tables of OS and ARCH names that are
;; (or at one point were) acceptable build targets.

(in-ns 'go.internal.syslist) (go/file "syslist.go" :imports [])

;; Note that this file is read by internal/goarch/gengoarch.go and by
;; internal/goos/gengoos.go. If you change this file, look at those
;; files as well.




(go/var ^{:doc "KnownOS is the list of past, present, and future known GOOS values.\nDo not remove from this list, as it is used for filename matching.\nIf you add an entry to this list, look at UnixOS, below.\n"} KnownOS (lit (map string bool)
    ^{:line 18} ["aix" true]
    ^{:line 19} ["android" true]
    ^{:line 20} ["darwin" true]
    ^{:line 21} ["dragonfly" true]
    ^{:line 22} ["freebsd" true]
    ^{:line 23} ["hurd" true]
    ^{:line 24} ["illumos" true]
    ^{:line 25} ["ios" true]
    ^{:line 26} ["js" true]
    ^{:line 27} ["linux" true]
    ^{:line 28} ["nacl" true]
    ^{:line 29} ["netbsd" true]
    ^{:line 30} ["openbsd" true]
    ^{:line 31} ["plan9" true]
    ^{:line 32} ["solaris" true]
    ^{:line 33} ["tamago" true]
    ^{:line 34} ["wasip1" true]
    ^{:line 35} ["windows" true]
    ^{:line 36} ["zos" true]))





(go/var ^{:doc "UnixOS is the set of GOOS values matched by the \"unix\" build tag.\nThis is not used for filename matching.\nThis list also appears in cmd/dist/build.go.\n"} UnixOS (lit (map string bool)
    ^{:line 43} ["aix" true]
    ^{:line 44} ["android" true]
    ^{:line 45} ["darwin" true]
    ^{:line 46} ["dragonfly" true]
    ^{:line 47} ["freebsd" true]
    ^{:line 48} ["hurd" true]
    ^{:line 49} ["illumos" true]
    ^{:line 50} ["ios" true]
    ^{:line 51} ["linux" true]
    ^{:line 52} ["netbsd" true]
    ^{:line 53} ["openbsd" true]
    ^{:line 54} ["solaris" true]))




(go/var ^{:doc "KnownArch is the list of past, present, and future known GOARCH values.\nDo not remove from this list, as it is used for filename matching.\n"} KnownArch (lit (map string bool)
    ^{:line 60} ["386" true]
    ^{:line 61} ["amd64" true]
    ^{:line 62} ["amd64p32" true]
    ^{:line 63} ["arm" true]
    ^{:line 64} ["armbe" true]
    ^{:line 65} ["arm64" true]
    ^{:line 66} ["arm64be" true]
    ^{:line 67} ["loong64" true]
    ^{:line 68} ["mips" true]
    ^{:line 69} ["mipsle" true]
    ^{:line 70} ["mips64" true]
    ^{:line 71} ["mips64le" true]
    ^{:line 72} ["mips64p32" true]
    ^{:line 73} ["mips64p32le" true]
    ^{:line 74} ["ppc" true]
    ^{:line 75} ["ppc64" true]
    ^{:line 76} ["ppc64le" true]
    ^{:line 77} ["riscv" true]
    ^{:line 78} ["riscv64" true]
    ^{:line 79} ["s390" true]
    ^{:line 80} ["s390x" true]
    ^{:line 81} ["sparc" true]
    ^{:line 82} ["sparc64" true]
    ^{:line 83} ["wasm" true]))

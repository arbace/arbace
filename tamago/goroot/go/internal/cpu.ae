(ns go.internal.cpu
  (:require [arbace.go :as go]))

(go/package cpu
  :path "internal/cpu"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["cpu.go" "cpu_x86.go" "cpu_x86_other.go" "datacache_x86.go"]
  :other-files ["cpu.s" "cpu_x86.s"]
  :init-order [CacheLineSize]
  :positions :lines)

(load "cpu/cpu")
(load "cpu/cpu_x86")
(load "cpu/cpu_x86_other")
(load "cpu/datacache_x86")

(ns go.internal.cpu
  (:require [arbace.go :as go]))

(go/package cpu
  :path "internal/cpu"
  :files ["cpu.go" "cpu_arm64.go" "cpu_arm64_tamago.go" "cpu_no_name.go" "cpu_x86.go" "cpu_x86_other.go" "datacache_unsupported.go" "datacache_x86.go"]
  :other-files ["cpu.s" "cpu_arm64.s" "cpu_x86.s"]
  :positions :lines)

(load "cpu/cpu")
(load "cpu/cpu_arm64")
(load "cpu/cpu_arm64_tamago")
(load "cpu/cpu_no_name")
(load "cpu/cpu_x86")
(load "cpu/cpu_x86_other")
(load "cpu/datacache_unsupported")
(load "cpu/datacache_x86")

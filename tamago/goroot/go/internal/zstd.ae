(ns go.internal.zstd
  (:require [arbace.go :as go]))

(go/package zstd
  :path "internal/zstd"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["bits.go" "block.go" "fse.go" "huff.go" "literals.go" "window.go" "xxhash.go" "zstd.go"]
  :init-order [literalLengthBase matchLengthBase predefinedLiteralTable predefinedOffsetTable predefinedMatchTable seqCodeInfo fuzzing]
  :positions :lines)

(load "zstd/bits")
(load "zstd/block")
(load "zstd/fse")
(load "zstd/huff")
(load "zstd/literals")
(load "zstd/window")
(load "zstd/xxhash")
(load "zstd/zstd")

(ns go.internal.zstd
  (:require [arbace.go :as go]))

(go/package zstd
  :path "internal/zstd"
  :files ["bits.go" "block.go" "fse.go" "huff.go" "literals.go" "window.go" "xxhash.go" "zstd.go"]
  :positions :lines)

(load "zstd/bits")
(load "zstd/block")
(load "zstd/fse")
(load "zstd/huff")
(load "zstd/literals")
(load "zstd/window")
(load "zstd/xxhash")
(load "zstd/zstd")

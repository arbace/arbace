^{:go/end 407} (go/func GOGOARCH "GOGOARCH returns the name and value of the GO$GOARCH setting.\nFor example, if GOARCH is \"amd64\" it might return \"GOAMD64\", \"v2\".\n" [] :results [^string name ^string value]
  (switch GOARCH
    (case ["386"]
      (return "GO386" GO386))
    (case ["amd64"]
      (return "GOAMD64" (fmt/Sprintf "v%d" GOAMD64)))
    (case ["arm"]
      (return "GOARM" (.String GOARM)))
    (case ["arm64"]
      (return "GOARM64" (.String GOARM64)))
    (case ["mips" "mipsle"]
      (return "GOMIPS" GOMIPS))
    (case ["mips64" "mips64le"]
      (return "GOMIPS64" GOMIPS64))
    (case ["ppc64" "ppc64le"]
      (return "GOPPC64" (fmt/Sprintf "power%d" GOPPC64)))
    (case ["riscv64"]
      (return "GORISCV64" (fmt/Sprintf "rva%du64" GORISCV64)))
    (case ["wasm"]
      (return "GOWASM" (.String GOWASM))))

  (return "" ""))


^{:go/breaks [[4 466]] :go/end 467} (go/func gogoarchTags ^{:tag (slice string)} []
  (switch GOARCH
    (case ["386"]
      (return (lit (slice string) (+ GOARCH "." GO386))))
    (case ["amd64"]
      (let [^{:tag (slice string)} list (zero (slice string))]
        (for [i 1] (<= i GOAMD64) (inc! i)
          (set! list (append list (fmt/Sprintf "%s.v%d" GOARCH i))))

        (return list)))
    (case ["arm"]
      (let [^{:tag (slice string)} list (zero (slice string))]
        (for [i 5] (<= i (.-Version GOARM)) (inc! i)
          (set! list (append list (fmt/Sprintf "%s.%d" GOARCH i))))

        (return list)))
    (case ["arm64"]
      (let [^{:tag (slice string)} list (zero (slice string))
          ^{:line 427} major (conv int (- (aget (.-Version GOARM64) 1) \0))
          ^{:line 428} minor (conv int (- (aget (.-Version GOARM64) 3) \0))]
        (for [i 0] (<= i minor) (inc! i)
          (set! list (append list (fmt/Sprintf "%s.v%d.%d" GOARCH major i))))

        ;; ARM64 v9.x also includes support of v8.x+5 (i.e. v9.1 includes v8.(1+5) = v8.6).
        (when (== major 9)
          (for [i 0] (and (<= i (+ minor 5)) (<= i 9)) (inc! i)
            (set! list (append list (fmt/Sprintf "%s.v%d.%d" GOARCH 8 i)))))


        (return list)))
    (case ["mips" "mipsle"]
      (return (lit (slice string) (+ GOARCH "." GOMIPS))))
    (case ["mips64" "mips64le"]
      (return (lit (slice string) (+ GOARCH "." GOMIPS64))))
    (case ["ppc64" "ppc64le"]
      (let [^{:tag (slice string)} list (zero (slice string))]
        (for [i 8] (<= i GOPPC64) (inc! i)
          (set! list (append list (fmt/Sprintf "%s.power%d" GOARCH i))))

        (return list)))
    (case ["riscv64"]
      (let [list (lit (slice string) (+ GOARCH "." "rva20u64"))]
        (when (>= GORISCV64 22)
          (set! list (append list (+ GOARCH "." "rva22u64"))))

        (when (>= GORISCV64 23)
          (set! list (append list (+ GOARCH "." "rva23u64"))))

        (return list)))
    (case ["wasm"]
      (let [^{:tag (slice string)} list (zero (slice string))]
        ;; SatConv is always enabled
        (set! list (append list (+ GOARCH ".satconv")))
        ;; SignExt is always enabled
        (set! list (append list (+ GOARCH ".signext")))
        (return list))))

  nil)

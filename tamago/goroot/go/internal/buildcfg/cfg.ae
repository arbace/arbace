^{:go/end 246} (go/func ParseGoarm64 [^string v] :results [^Goarm64Features g ^error e]
  (let [
      ^:const ^{:line 208 :val ",lse"} lseOpt ",lse"
      ^:const ^:go/grouped ^{:line 209 :val ",crypto"} cryptoOpt ",crypto"]


    (set! (.-LSE g) false)
    (set! (.-Crypto g) false)
    ;; We allow any combination of suffixes, in any order
    (while true
      (when (strings/HasSuffix v lseOpt)
        (set! (.-LSE g) true)
        (set! v (subslice v _ (- (len v) (len lseOpt))))
        (continue))


      (when (strings/HasSuffix v cryptoOpt)
        (set! (.-Crypto g) true)
        (set! v (subslice v _ (- (len v) (len cryptoOpt))))

    (let [rt (.Type rv)]
      (for [i 0] (< i (.NumField rt)) (inc! i)
        (let [name (strings/ToLower (.-Name (.Field rt i)))
            ^{:line 177} val (.Bool (.Field rv i))
            ^{:line 178} baseVal false]
          (when (!= base nil)
            (set! baseVal (.Bool (.Field rBase i))))

          (when (or all (!= val baseVal))
            (if val
              (set! list (append list name))

              (set! list (append list (+ "no" name)))))))




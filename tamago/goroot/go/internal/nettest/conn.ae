^{:go/end 356} (go/method read [^{:tag (* connHalf)} h ^{:tag (slice byte)} b] :results [^int n ^error err]
  (.waitAndLockForRead h)
  (defer (.unlock h))
  (when (.-readClosed h)
    (return 0 net/ErrClosed))

  (when (.-expired (.-readDeadline h))
    (return 0 os/ErrDeadlineExceeded))

  (when (> (.Len (.-buf h)) 0)
    (return (.Read (.-buf h) b)))

  (when (.-writeClosed h)
    (return 0 io/EOF))

  (return 0 (.-readErr h)))



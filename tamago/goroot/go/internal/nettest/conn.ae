(go/type locker (interface
    (lock [])
    (unlock [])))


^{:go/end 437} (go/method setDeadline [^{:tag (* connDeadline)} d ^locker mu ^time/Time t]
  (.lock mu)
  (defer (.unlock mu))
  (when (!= (.-timer d) nil)
    (.Stop (.-timer d))
    (set! (.-timer d) nil))

  (when (.IsZero t)
    ;; No deadline.
    (set! (.-expired d) false)
    (return))

  (let [expiry (time/Until t)]
    (when (<= expiry 0)
      ;; Deadline has already passed.
      (set! (.-expired d) true)
      (return))

    ;; Deadline is in the future.
    (set! (.-expired d) false)
    (let [^{:tag (* time/Timer)} timer (zero (* time/Timer))]
      (set! timer (time/AfterFunc expiry ^{:go/end 435} (fn []
            (.lock mu)
            (defer (.unlock mu))
            (when (== (.-timer d) timer)
              (set! (.-timer d) nil)
              (set! (.-expired d) true)))))


      (set! (.-timer d) timer))))

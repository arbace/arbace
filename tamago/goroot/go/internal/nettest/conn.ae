  (set! (.-bufMax h) size))


^{:go/end 373} (go/method write [^{:tag (* connHalf)} h ^{:tag (slice byte)} b] :results [^int n ^error err]
  (while (< n (len b))
    (let [(values nn err) (.writePartial h (subslice b n))]
      (set! n + nn)
      (when (!= err nil)
        (return n err))))


  (return n nil))


^{:go/end 395} (go/method writePartial [^{:tag (* connHalf)} h ^{:tag (slice byte)} b] :results [^int n ^error err]
  (.waitAndLockForWrite h)
  (defer (.unlock h))
  (when (.-writeClosed h)
    (return 0 net/ErrClosed))

  (when (.-expired (.-writeDeadline h))
    (return 0 os/ErrDeadlineExceeded))

  (when (.-readClosed h)
    (return 0 errClosedByPeer))

  (when (!= (.-writeErr h) nil)
    (return 0 (.-writeErr h)))

  (let [writeMax (- (.-bufMax h) (.Len (.-buf h)))]
    (when (< writeMax (len b))
      (set! b (subslice b _ writeMax)))

    (.Write (.-buf h) b)))



    ^{:line 262 :tag bool} readClosed ^bool writeClosed
    ^{:line 263 :tag error} readErr ^error writeErr ; errors returned by reads/writes
    ^{:line 264 :tag error} closeErr)) ; error returned by closing the conn reading from this half



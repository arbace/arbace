  (.lock (.-w c))
  (defer (.unlock (.-w c)))
  (set! (.-writeErr (.-w c)) err))





(go/type connHalf "connHalf is one direction data flow in a Conn.\nThe connHalf contains a buffer.\nWrites to the connHalf push to the buffer and reads pull from it.\n" (struct
    ^{:line 243 :tag net/Addr} addr








^{:go/end 52} (go/func newConnPair [^net/Addr addr1 ^net/Addr addr2] :results [(* Conn) (* Conn)]
  (let [h1 (newConnHalf addr1)
      ^{:line 44} h2 (newConnHalf addr2)
      ^{:line 45} c1 (addr (lit Conn :r h1 :w h2))
      ^{:line 46} c2 (addr (lit Conn :r h2 :w h1))]

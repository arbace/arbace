(in-ns 'go.internal.nettest) (go/file "listener.go" :imports [


    ^{:line 8} [context "context"]
    ^{:line 9} [gate "internal/gate"]
    ^{:line 10} [net "net"]
    ^{:line 11} [netip "net/netip"]])



(go/type Listener "Listener is an in-memory test implementation of net.Listener.\n" (struct
    ^{:line 16 :tag gate/Gate} gate
    ^{:line 17 :tag (queue (* Conn))} queue
    ^{:line 18 :tag bool} closed
    ^{:line 19 :tag error} acceptErr
    ^{:line 20 :tag error} closeErr

    ^{:line 22 :tag net/Addr} addr
    ^{:line 23 :tag netip/AddrPort} nextaddr))



^{:go/end 33} (go/func NewListener "NewListener returns a new Listener.\n" ^{:tag (* Listener)} []
  (addr ^{:go/breaks [2 4 6]} (lit Listener
      :gate (gate/New false)
      :addr (net/TCPAddrFromAddrPort (netip/MustParseAddrPort "192.0.2.1:1000"))
      :nextaddr (netip/MustParseAddrPort "192.0.2.1:10001"))))





^{:go/end 53} (go/method Close "Close closes the listener.\nAny blocked Accept operations will be unblocked and return errors.\n" ^error [^{:tag (* Listener)} li]
  (.lock li)
  (defer (.unlock li))
  (let [err (.-closeErr li)]
    (set! (.-closed li) true)
    (set! (.-acceptErr li) net/ErrClosed)
    (set! (.-closeErr li) net/ErrClosed)
    (when (!= err nil)
      (return (addr ^{:go/breaks [2 4 6 8]} (lit net/OpError
            :Op "close"
            :Net "tcp"
            :Addr (.-addr li)
            :Err err))))


    ^{:line 52} err))





^{:go/end 62} (go/method Addr "Addr returns the listener's network address.\n\nThe address is always a *net.TCPAddr.\n" ^net/Addr [^{:tag (* Listener)} li]
  (.lock li)
  (defer (.unlock li))
  (.-addr li))



^{:go/end 69} (go/method SetAddr "SetAddr sets the listener's network address.\n" [^{:tag (* Listener)} li ^net/Addr addr]
  (.lock li)
  (defer (.unlock li))
  (set! (.-addr li) addr))





^{:go/end 76} (go/method NewConn "NewConn returns a new connection to the listener.\n\nAccept will return the other side of the conn.\n" ^{:tag (* Conn)} [^{:tag (* Listener)} li]
  (.NewConnConfig li ^{:go/end 75} (fn [(* Conn)])))












^{:go/end 99} (go/method NewConnConfig "NewConnConfig returns a new connection to the listener.\n\nThe function f is called with the new client connection.\nAfter f returns, Accept will return the other side of the connection.\n\nFor example, to create a connection from a specific IP address:\n\n\tconn := li.NewConnConfig(func(conn *nettest.Conn) {\n\t\tconn.SetLocalAddr(net.TCPAddrFromAddrPort(netip.MustParseAddrPort(\"10.0.0.1:1234\")))\n\t})\n" ^{:tag (* Conn)} [^{:tag (* Listener)} li ^{:tag (func [(* Conn)])} f]
  (.lock li)
  (defer (.unlock li))
  (let [(values cli srv) (newConnPair
        (net/TCPAddrFromAddrPort (.-nextaddr li))
        (.-addr li))]

    (set! (.-nextaddr li) (netip/AddrPortFrom (.Addr (.-nextaddr li)) (+ (.Port (.-nextaddr li)) 1)))
    (f cli)
    (.push (.-queue li) srv)
    ^{:line 98} cli))





^{:go/end 116} (go/method Accept "Accept waits for and returns the next connection to the listener.\n\nThe connections returned by Accept are always [*Conn]s.\n" [^{:tag (* Listener)} li] :results [net/Conn error]
  (.WaitAndLock (.-gate li) (context/Background))
  (defer (.unlock li))
  (when (and (!= (.-acceptErr li) nil) (== (.len (.-queue li)) 0))
    (return nil (addr ^{:go/breaks [2 4 6 8]} (lit net/OpError
          :Op "accept"
          :Net "tcp"
          :Addr (.-addr li)
          :Err (.-acceptErr li)))))


  (return (.pop (.-queue li)) nil))







^{:go/end 129} (go/method SetAcceptError "SetAcceptError causes any currently blocked and future Accept calls to return\na net.OpError wrapping err.\nAccept will return any available connections before returning the error,\nincluding connections created after the error is set.\nA nil error restores the usual behavior.\n" [^{:tag (* Listener)} li ^error err]
  (.Lock (.-gate li))
  (defer (.unlock li))
  (when (not (.-closed li))
    (set! (.-acceptErr li) err)))






^{:go/end 140} (go/method SetCloseError "SetCloseError sets the error returned by Close.\nClose still closes the listener.\nA nil error restores the usual behavior.\n" [^{:tag (* Listener)} li ^error err]
  (.Lock (.-gate li))
  (defer (.unlock li))
  (when (not (.-closed li))
    (set! (.-closeErr li) err)))



^{:go/end 144} (go/method lock [^{:tag (* Listener)} li]
  (.Lock (.-gate li)))


^{:go/end 148} (go/method unlock [^{:tag (* Listener)} li]
  (.Unlock (.-gate li) (or (!= (.-acceptErr li) nil) (> (.len (.-queue li)) 0))))

(in-ns 'go.internal.nettest) (go/file "queue.go" :imports [])

(go/type queue :type-params [T] (struct
    ^{:line 8 :tag int} headPos
    ^{:line 9 :tag (slice T)} head
    ^{:line 10 :go/grouped false :tag (slice T)} tail))


^{:go/end 15} (go/method len ^int [^{:tag (* (queue T))} q]
  (+ (len (subslice (.-head q) (.-headPos q))) (len (.-tail q))))


^{:go/end 19} (go/method push [^{:tag (* (queue T))} q ^T v]
  (set! (.-tail q) (append (.-tail q) v)))


^{:go/end 33} (go/method pop ^T [^{:tag (* (queue T))} q]
  (let [^T zero (zero T)]
    (when (>= (.-headPos q) (len (.-head q)))
      (when (== (len (.-tail q)) 0)
        (return zero))

      (set! (values (.-head q) (.-headPos q) (.-tail q)) (values (.-tail q) 0 (subslice (.-head q) _ 0))))

    (let [v (aget (.-head q) (.-headPos q))]
      (aset (.-head q) (.-headPos q) zero)
      (inc! (.-headPos q))
      ^{:line 32} v)))

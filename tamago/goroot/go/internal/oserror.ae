(ns go.internal.oserror
  (:require [arbace.go :as go]))

(go/package oserror
  :path "internal/oserror"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["errors.go"]
  :init-order [ErrInvalid ErrPermission ErrExist ErrNotExist ErrClosed]
  :positions :lines)

(load "oserror/errors")

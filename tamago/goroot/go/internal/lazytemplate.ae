(ns go.internal.lazytemplate
  (:require [arbace.go :as go]))

(go/package lazytemplate
  :path "internal/lazytemplate"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["lazytemplate.go"]
  :init-order [inTest]
  :positions :lines)

(load "lazytemplate/lazytemplate")

(ns go.internal.filepathlite
  (:require [arbace.go :as go]))

(go/package filepathlite
  :path "internal/filepathlite"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["path.go" "path_nonwindows.go" "path_unix.go"]
  :init-order [errInvalidPath]
  :positions :lines)

(load "filepathlite/path")
(load "filepathlite/path_nonwindows")
(load "filepathlite/path_unix")

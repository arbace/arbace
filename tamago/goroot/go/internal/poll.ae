(ns go.internal.poll
  (:require [arbace.go :as go]))

(go/package poll
  :path "internal/poll"
  :files ["errno_unix.go" "fd.go" "fd_fsync_posix.go" "fd_mutex.go" "fd_poll_runtime.go" "fd_posix.go" "fd_unix.go" "fd_unixjs.go" "hook_unix.go" "sendfile.go" "sys_cloexec.go"]
  :positions :lines)

(load "poll/errno_unix")
(load "poll/fd")
(load "poll/fd_fsync_posix")
(load "poll/fd_mutex")
(load "poll/fd_poll_runtime")
(load "poll/fd_posix")
(load "poll/fd_unix")
(load "poll/fd_unixjs")
(load "poll/hook_unix")
(load "poll/sendfile")
(load "poll/sys_cloexec")

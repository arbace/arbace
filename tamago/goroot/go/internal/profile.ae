(ns go.internal.profile
  (:require [arbace.go :as go]))

(go/package profile
  :path "internal/profile"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["encode.go" "filter.go" "graph.go" "merge.go" "profile.go" "proto.go" "prune.go"]
  :init-order [profileDecoder valueTypeDecoder sampleDecoder labelDecoder mappingDecoder locationDecoder lineDecoder functionDecoder errMalformed ErrNoData]
  :positions :lines)

(load "profile/encode")
(load "profile/filter")
(load "profile/graph")
(load "profile/merge")
(load "profile/profile")
(load "profile/proto")
(load "profile/prune")

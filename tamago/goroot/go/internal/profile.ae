(ns go.internal.profile
  (:require [arbace.go :as go]))

(go/package profile
  :path "internal/profile"
  :files ["encode.go" "filter.go" "graph.go" "merge.go" "profile.go" "proto.go" "prune.go"]
  :positions :lines)

(load "profile/encode")
(load "profile/filter")
(load "profile/graph")
(load "profile/merge")
(load "profile/profile")
(load "profile/proto")
(load "profile/prune")

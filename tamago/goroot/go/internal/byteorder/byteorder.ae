;; Package byteorder provides functions for decoding and encoding
;; little and big endian integer types from/to byte slices.
(in-ns 'go.internal.byteorder) (go/file "byteorder.go" :doc "Package byteorder provides functions for decoding and encoding\nlittle and big endian integer types from/to byte slices.\n" :imports [])

^{:go/end 12} (go/func LEUint16 ^uint16 [^{:tag (slice byte)} b]
  (set! _ (aget b 1)) ; bounds check hint to compiler; see golang.org/issue/14808
  (bit-or (conv uint16 (aget b 0)) (<< (conv uint16 (aget b 1)) 8)))


^{:go/end 18} (go/func LEPutUint16 [^{:tag (slice byte)} b ^uint16 v]
  (set! _ (aget b 1)) ; early bounds check to guarantee safety of writes below
  (aset b 0 (conv byte v))
  (aset b 1 (conv byte (>> v 8))))


^{:go/end 25} (go/func LEAppendUint16 ^{:tag (slice byte)} [^{:tag (slice byte)} b ^uint16 v]
  (append b
    (conv byte v)
    (conv byte (>> v 8))))



^{:go/end 30} (go/func LEUint32 ^uint32 [^{:tag (slice byte)} b]
  (set! _ (aget b 3)) ; bounds check hint to compiler; see golang.org/issue/14808
  (bit-or (conv uint32 (aget b 0)) (<< (conv uint32 (aget b 1)) 8) (<< (conv uint32 (aget b 2)) 16) (<< (conv uint32 (aget b 3)) 24)))


^{:go/end 38} (go/func LEPutUint32 [^{:tag (slice byte)} b ^uint32 v]
  (set! _ (aget b 3)) ; early bounds check to guarantee safety of writes below
  (aset b 0 (conv byte v))
  (aset b 1 (conv byte (>> v 8)))
  (aset b 2 (conv byte (>> v 16)))
  (aset b 3 (conv byte (>> v 24))))


^{:go/end 47} (go/func LEAppendUint32 ^{:tag (slice byte)} [^{:tag (slice byte)} b ^uint32 v]
  (append b
    (conv byte v)
    (conv byte (>> v 8))
    (conv byte (>> v 16))
    (conv byte (>> v 24))))



^{:go/end 53} (go/func LEUint64 ^uint64 [^{:tag (slice byte)} b]
  (set! _ (aget b 7)) ; bounds check hint to compiler; see golang.org/issue/14808
  (bit-or (conv uint64 (aget b 0)) (<< (conv uint64 (aget b 1)) 8) (<< (conv uint64 (aget b 2)) 16) (<< (conv uint64 (aget b 3)) 24)
    (<< (conv uint64 (aget b 4)) 32) (<< (conv uint64 (aget b 5)) 40) (<< (conv uint64 (aget b 6)) 48) (<< (conv uint64 (aget b 7)) 56)))


^{:go/end 65} (go/func LEPutUint64 [^{:tag (slice byte)} b ^uint64 v]
  (set! _ (aget b 7)) ; early bounds check to guarantee safety of writes below
  (aset b 0 (conv byte v))
  (aset b 1 (conv byte (>> v 8)))
  (aset b 2 (conv byte (>> v 16)))
  (aset b 3 (conv byte (>> v 24)))
  (aset b 4 (conv byte (>> v 32)))
  (aset b 5 (conv byte (>> v 40)))
  (aset b 6 (conv byte (>> v 48)))
  (aset b 7 (conv byte (>> v 56))))


^{:go/end 78} (go/func LEAppendUint64 ^{:tag (slice byte)} [^{:tag (slice byte)} b ^uint64 v]
  (append b
    (conv byte v)
    (conv byte (>> v 8))
    (conv byte (>> v 16))
    (conv byte (>> v 24))
    (conv byte (>> v 32))
    (conv byte (>> v 40))
    (conv byte (>> v 48))
    (conv byte (>> v 56))))



^{:go/end 83} (go/func BEUint16 ^uint16 [^{:tag (slice byte)} b]
  (set! _ (aget b 1)) ; bounds check hint to compiler; see golang.org/issue/14808
  (bit-or (conv uint16 (aget b 1)) (<< (conv uint16 (aget b 0)) 8)))


^{:go/end 89} (go/func BEPutUint16 [^{:tag (slice byte)} b ^uint16 v]
  (set! _ (aget b 1)) ; early bounds check to guarantee safety of writes below
  (aset b 0 (conv byte (>> v 8)))
  (aset b 1 (conv byte v)))


^{:go/end 96} (go/func BEAppendUint16 ^{:tag (slice byte)} [^{:tag (slice byte)} b ^uint16 v]
  (append b
    (conv byte (>> v 8))
    (conv byte v)))



^{:go/end 101} (go/func BEUint32 ^uint32 [^{:tag (slice byte)} b]
  (set! _ (aget b 3)) ; bounds check hint to compiler; see golang.org/issue/14808
  (bit-or (conv uint32 (aget b 3)) (<< (conv uint32 (aget b 2)) 8) (<< (conv uint32 (aget b 1)) 16) (<< (conv uint32 (aget b 0)) 24)))


^{:go/end 109} (go/func BEPutUint32 [^{:tag (slice byte)} b ^uint32 v]
  (set! _ (aget b 3)) ; early bounds check to guarantee safety of writes below
  (aset b 0 (conv byte (>> v 24)))
  (aset b 1 (conv byte (>> v 16)))
  (aset b 2 (conv byte (>> v 8)))
  (aset b 3 (conv byte v)))


^{:go/end 118} (go/func BEAppendUint32 ^{:tag (slice byte)} [^{:tag (slice byte)} b ^uint32 v]
  (append b
    (conv byte (>> v 24))
    (conv byte (>> v 16))
    (conv byte (>> v 8))
    (conv byte v)))



^{:go/end 124} (go/func BEUint64 ^uint64 [^{:tag (slice byte)} b]
  (set! _ (aget b 7)) ; bounds check hint to compiler; see golang.org/issue/14808
  (bit-or (conv uint64 (aget b 7)) (<< (conv uint64 (aget b 6)) 8) (<< (conv uint64 (aget b 5)) 16) (<< (conv uint64 (aget b 4)) 24)
    (<< (conv uint64 (aget b 3)) 32) (<< (conv uint64 (aget b 2)) 40) (<< (conv uint64 (aget b 1)) 48) (<< (conv uint64 (aget b 0)) 56)))


^{:go/end 136} (go/func BEPutUint64 [^{:tag (slice byte)} b ^uint64 v]
  (set! _ (aget b 7)) ; early bounds check to guarantee safety of writes below
  (aset b 0 (conv byte (>> v 56)))
  (aset b 1 (conv byte (>> v 48)))
  (aset b 2 (conv byte (>> v 40)))
  (aset b 3 (conv byte (>> v 32)))
  (aset b 4 (conv byte (>> v 24)))
  (aset b 5 (conv byte (>> v 16)))
  (aset b 6 (conv byte (>> v 8)))
  (aset b 7 (conv byte v)))


^{:go/end 149} (go/func BEAppendUint64 ^{:tag (slice byte)} [^{:tag (slice byte)} b ^uint64 v]
  (append b
    (conv byte (>> v 56))
    (conv byte (>> v 48))
    (conv byte (>> v 40))
    (conv byte (>> v 32))
    (conv byte (>> v 24))
    (conv byte (>> v 16))
    (conv byte (>> v 8))
    (conv byte v)))

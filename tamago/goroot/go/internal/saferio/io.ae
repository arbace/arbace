;; Package saferio provides I/O functions that avoid allocating large
;; amounts of memory unnecessarily. This is intended for packages that
;; read data from an [io.Reader] where the size is part of the input
;; data but the input may be corrupt, or may be provided by an
;; untrustworthy attacker.
(in-ns 'go.internal.saferio) (go/file "io.go" :doc "Package saferio provides I/O functions that avoid allocating large\namounts of memory unnecessarily. This is intended for packages that\nread data from an [io.Reader] where the size is part of the input\ndata but the input may be corrupt, or may be provided by an\nuntrustworthy attacker.\n" :imports [


    ^{:line 13} [io "io"]
    ^{:line 14} [unsafe "unsafe"]])




(go/const ^{:val 10485760 :doc "chunk is an arbitrary limit on how much memory we are willing\nto allocate without concern.\n"} chunk (<< 10 20)) ; 10M








^{:go/end 62} (go/func ReadData "ReadData reads n bytes from the input stream, but avoids allocating\nall n bytes if n is large. This avoids crashing the program by\nallocating all n bytes in cases where n is incorrect.\n\nThe error is io.EOF only if no bytes were read.\nIf an io.EOF happens after reading some but not all the bytes,\nReadData returns io.ErrUnexpectedEOF.\n" [^io/Reader r ^uint64 n] :results [(slice byte) error]
  (when (or (< (conv int64 n) 0) (!= n (conv uint64 (conv int n))))
    ;; n is too large to fit in int, so we can't allocate
    ;; a buffer large enough. Treat this as a read failure.
    (return nil io/ErrUnexpectedEOF))


  (when (< n chunk)
    (let [buf (make (slice byte) n)
        (values _ err) (io/ReadFull r buf)]
      (when (!= err nil)
        (return nil err))

      (return buf nil)))


  (let [^{:tag (slice byte)} buf (zero (slice byte))
      ^{:line 45} buf1 (make (slice byte) chunk)]
    (while (> n 0)
      (let [next n]
        (when (> next chunk)
          (set! next chunk))

        (let [(values _ err) (io/ReadFull r (subslice buf1 _ next))]
          (when (!= err nil)
            (when (and (> (len buf) 0) (== err io/EOF))
              (set! err io/ErrUnexpectedEOF))

            (return nil err))

          (set! buf (append buf (spread (subslice buf1 _ next))))
          (set! n - next))))

    (return buf nil)))





^{:go/end 103} (go/func ReadDataAt "ReadDataAt reads n bytes from the input stream at off, but avoids\nallocating all n bytes if n is large. This avoids crashing the program\nby allocating all n bytes in cases where n is incorrect.\n" [^io/ReaderAt r ^uint64 n ^int64 off] :results [(slice byte) error]
  (when (or (< (conv int64 n) 0) (!= n (conv uint64 (conv int n))))
    ;; n is too large to fit in int, so we can't allocate
    ;; a buffer large enough. Treat this as a read failure.
    (return nil io/ErrUnexpectedEOF))


  (when (< n chunk)
    (let [buf (make (slice byte) n)
        (values _ err) (.ReadAt r buf off)]
      (when (!= err nil)
        ;; io.SectionReader can return EOF for n == 0,
        ;; but for our purposes that is a success.
        (when (or (!= err io/EOF) (> n 0))
          (return nil err)))


      (return buf nil)))


  (let [^{:tag (slice byte)} buf (zero (slice byte))
      ^{:line 88} buf1 (make (slice byte) chunk)]
    (while (> n 0)
      (let [next n]
        (when (> next chunk)
          (set! next chunk))

        (let [(values _ err) (.ReadAt r (subslice buf1 _ next) off)]
          (when (!= err nil)
            (return nil err))

          (set! buf (append buf (spread (subslice buf1 _ next))))
          (set! n - next)
          (set! off + (conv int64 next)))))

    (return buf nil)))








^{:go/end 125} (go/func SliceCapWithSize "SliceCapWithSize returns the capacity to use when allocating a slice.\nAfter the slice is allocated with the capacity, it should be\nbuilt using append. This will avoid allocating too much memory\nif the capacity is large and incorrect.\n\nA negative result means that the value is always too big.\n" ^int [^uint64 size ^uint64 c]
  (when (or (< (conv int64 c) 0) (!= c (conv uint64 (conv int c))))
    (return -1))

  (when (and (> size 0) (> c (/ (- (<< 1 64) 1) size)))
    (return -1))

  (when (> (* c size) chunk)
    (set! c (/ chunk size))
    (when (== c 0)
      (set! c 1)))


  (conv int c))



^{:go/end 132} (go/func SliceCap "SliceCap is like SliceCapWithSize but using generics.\n" :type-params [E] ^int [^uint64 c]
  (let [^E v (zero E)
      ^{:line 130} size (conv uint64 (unsafe/Sizeof v))]
    (SliceCapWithSize size c)))

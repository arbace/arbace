;; Package obscuretestdata contains functionality used by tests to more easily
;; work with testdata that must be obscured primarily due to
;; golang.org/issue/34986.
(in-ns 'go.internal.obscuretestdata) (go/file "obscuretestdata.go" :doc "Package obscuretestdata contains functionality used by tests to more easily\nwork with testdata that must be obscured primarily due to\ngolang.org/issue/34986.\n" :imports [


    ^{:line 11} [base64 "encoding/base64"]
    ^{:line 12} [io "io"]
    ^{:line 13} [os "os"]])



^{:go/end 29} (go/func Rot13 "Rot13 returns the rot13 encoding or decoding of its input.\n" ^{:tag (slice byte)} [^{:tag (slice byte)} data]
  (let [out (make (slice byte) (len data))]
    (copy out data)
    (range [i c out]
      (switch
        (case [(or (and (<= \A c) (<= c \M)) (and (<= \a c) (<= c \m)))]
          (aset out i (+ c 13)))
        (case [(or (and (<= \N c) (<= c \Z)) (and (<= \n c) (<= c \z)))]
          (aset out i (- c 13)))))


    ^{:line 28} out))





^{:go/end 55} (go/func DecodeToTempFile "DecodeToTempFile decodes the named file to a temporary location.\nIf successful, it returns the path of the decoded file.\nThe caller is responsible for ensuring that the temporary file is removed.\n" [^string name] :results [^string path ^error err]
  (let [(values f ^:assign err) (os/Open name)]
    (when (!= err nil)
      (return "" err))

    (defer (.Close f))

    (let [(values tmp ^:assign err) (os/CreateTemp "" "obscuretestdata-decoded-")]
      (when (!= err nil)
        (return "" err))

      (when [(values _ err) (io/Copy tmp (base64/NewDecoder base64/StdEncoding f))] (!= err nil)
        (.Close tmp)
        (os/Remove (.Name tmp))
        (return "" err))

      (when [err (.Close tmp)] (!= err nil)
        (os/Remove (.Name tmp))
        (return "" err))

      (return (.Name tmp) nil))))



^{:go/end 65} (go/func ReadFile "ReadFile reads the named file and returns its decoded contents.\n" [^string name] :results [(slice byte) error]
  (let [(values f err) (os/Open name)]
    (when (!= err nil)
      (return nil err))

    (defer (.Close f))
    (io/ReadAll (base64/NewDecoder base64/StdEncoding f))))

(in-ns 'go.internal.abi) (go/file "iface.go" :imports [


    ^{:line 8} [goarch "internal/goarch"]
    ^{:line 9} [unsafe "unsafe"]])







(go/type ITab "The first word of every non-empty interface type contains an *ITab.\nIt records the underlying concrete type (Type), the interface type it\nis implementing (Inter), and some ancillary information.\n\nallocated in non-garbage-collected memory\n" (struct
    ^{:line 18 :tag (* InterfaceType)} Inter
    ^{:line 19 :tag (* Type)} Type
    ^{:line 20 :tag uint32} Hash ; copy of Type.Hash. Used for type switches.
    ^{:line 21 :tag (array 1 uintptr)} Fun)) ; variable sized. fun[0]==0 means Type does not implement Inter.



^{:go/end 31} (go/method Size "Size returns the size of the itab in memory.\n" ^int [^{:tag (* ITab)} it]
  (let [size (conv int (unsafe/Sizeof (lit ITab)))]
    (when (== (aget (.-Fun it) 0) 0)
      (return size))

    (+ size (* (- (len (.-Methods (.-Inter it))) 1) goarch/PtrSize))))





(go/type EmptyInterface "EmptyInterface describes the layout of a \"interface{}\" or a \"any.\"\nThese are represented differently than non-empty interface, as the first\nword always points to an abi.Type.\n" (struct
    ^{:line 37 :tag (* Type)} Type
    ^{:line 38 :tag unsafe/Pointer} Data))



(go/type NonEmptyInterface "NonEmptyInterface describes the layout of an interface that contains any methods.\n" (struct
    ^{:line 43 :tag (* ITab)} ITab
    ^{:line 44 :tag unsafe/Pointer} Data))



(go/type CommonInterface "CommonInterface describes the layout of both [EmptyInterface] and [NonEmptyInterface].\n" (struct

    ^{:line 50 :tag unsafe/Pointer :doc "Either an *ITab or a *Type, unexported to avoid accidental use.\n"} _

    ^{:line 52 :tag unsafe/Pointer} Data))

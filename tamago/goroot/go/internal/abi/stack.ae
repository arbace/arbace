(in-ns 'go.internal.abi) (go/file "stack.go" :imports [])

(go/const






  ^{:line 14} [^{:val 800 :doc "StackNosplitBase is the base maximum number of bytes that a chain of\nNOSPLIT functions can use.\n\nThis value must be multiplied by the stack guard multiplier, so do not\nuse it directly. See runtime/stack.go:stackNosplit and\ncmd/internal/objabi/stack.go:StackNosplit.\n"} StackNosplitBase 800]

  ;; We have three different sequences for stack bounds checks, depending on
  ;; whether the stack frame of a function is small, big, or huge.








  ^{:line 26} [^{:val 128 :doc "After a stack split check the SP is allowed to be StackSmall bytes below\nthe stack guard.\n\nFunctions that need frames <= StackSmall can perform the stack check\nusing a single comparison directly between the stack guard and the SP\nbecause we ensure that StackSmall bytes of stack space are available\nbeyond the stack guard.\n"} StackSmall 128]





  ^{:line 32} [^{:val 4096 :doc "Functions that need frames <= StackBig can assume that neither\nSP-framesize nor stackGuard-StackSmall will underflow, and thus use a\nmore efficient check. In order to ensure this, StackBig must be <= the\nsize of the unmapped space at zero.\n"} StackBig 4096])

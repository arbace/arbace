    ^{:line 8} [unsafe "unsafe"]])




(go/const "Map constants common to several packages\nruntime/runtime-gdb.py:MapTypePrinter contains its own copy\n"

  ^{:line 15} [^{:val 3 :doc "Number of bits in the group.slot count.\n"} MapGroupSlotsBits 3]


  ^{:line 18} [^{:val 8 :doc "Number of slots in a group.\n"} MapGroupSlots (<< 1 MapGroupSlotsBits)] ; 8



  ^{:line 22} [^{:val 128 :doc "Maximum key or elem size to keep inline (instead of mallocing per element).\nMust fit in a uint8.\n"} MapMaxKeyBytes 128]
  ^{:line 23} [^{:val 128} MapMaxElemBytes 128]

  ^{:line 25} [^{:val 128} ctrlEmpty 2r10000000]
  ^{:line 26} [^{:val 72340172838076673} bitsetLSB 0x0101010101010101]


  ^{:line 29} [^{:val 9259542123273814144N :doc "Value of control word with all empty slots.\n"} MapCtrlEmpty (* bitsetLSB (conv uint64 ctrlEmpty))])


(go/type MapType (struct
    ^{:line 33} Type
    ^{:line 34 :tag (* Type)} Key
    ^{:line 35 :tag (* Type)} Elem
    ^{:line 36 :tag (* Type)} Group ; internal type representing a slot group

    ^{:line 38 :tag (func [unsafe/Pointer uintptr] [uintptr]) :doc "function for hashing keys (ptr to key, seed) -> hash\n"} Hasher
    ^{:line 39 :tag uintptr} GroupSize ; == Group.Size_















    ^{:line 55 :tag uintptr :doc "These fields describe how to access keys and elems within a group.\nThe formulas key(i) = KeysOff + i*KeyStride and\nelem(i) = ElemsOff + i*ElemStride work for both group layouts:\n\nWith GOEXPERIMENT=mapsplitgroup (split arrays KKKKVVVV):\n  KeysOff    = offset of keys array in group\n  KeyStride  = size of a single key\n  ElemsOff   = offset of elems array in group\n  ElemStride = size of a single elem\n\nWithout (interleaved slots KVKVKVKV):\n  KeysOff    = offset of slots array in group\n  KeyStride  = size of a key/elem slot (stride between keys)\n  ElemsOff   = offset of first elem (slots offset + elem offset within slot)\n  ElemStride = size of a key/elem slot (stride between elems)\n"} KeysOff
    ^{:line 56 :tag uintptr} KeyStride
    ^{:line 57 :tag uintptr} ElemsOff
    ^{:line 58 :tag uintptr} ElemStride
    ^{:line 59 :tag uintptr} ElemOff ; GOEXPERIMENT=nomapsplitgroup only
    ^{:line 60 :tag uint32} Flags))



(go/const "Flag values\n"
  ^{:line 65} [^{:val 1} MapNeedKeyUpdate (<< 1 iota)]
  ^{:line 66} [^{:val 2} MapHashMightPanic]
  ^{:line 67} [^{:val 4} MapIndirectKey]
  ^{:line 68} [^{:val 8} MapIndirectElem])


^{:go/end 73} (go/method NeedKeyUpdate ^bool [^{:tag (* MapType)} mt] ; true if we need to update key on an overwrite
  (!= (bit-and (.-Flags mt) MapNeedKeyUpdate) 0))

^{:go/end 76} (go/method HashMightPanic ^bool [^{:tag (* MapType)} mt] ; true if hash function might panic
  (!= (bit-and (.-Flags mt) MapHashMightPanic) 0))

^{:go/end 79} (go/method IndirectKey ^bool [^{:tag (* MapType)} mt] ; store ptr to key instead of key itself
  (!= (bit-and (.-Flags mt) MapIndirectKey) 0))

^{:go/end 82} (go/method IndirectElem ^bool [^{:tag (* MapType)} mt] ; store ptr to elem instead of elem itself
  (!= (bit-and (.-Flags mt) MapIndirectElem) 0))

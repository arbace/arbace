(in-ns 'go.internal.abi) (go/file "rangefuncconsts.go" :imports [])

(go/type RF_State int)




(go/const "These constants are shared between the compiler, which uses them for state functions\nand panic indicators, and the runtime, which turns them into more meaningful strings\nFor best code generation, RF_DONE and RF_READY should be 0 and 1.\n"
  ^{:line 13} [^{:val 0} RF_DONE (conv RF_State iota)] ; body of loop has exited in a non-panic way
  ^{:line 14} [^{:val 1} RF_READY] ; body of loop has not exited yet, is not running  -- this is not a panic index
  ^{:line 15} [^{:val 2} RF_PANIC] ; body of loop is either currently running, or has panicked
  ^{:line 16} [^{:val 3} RF_EXHAUSTED] ; iterator function return, i.e., sequence is "exhausted"
  ^{:line 17} [^{:val 4} RF_MISSING_PANIC 4]) ; body of loop panicked but iterator function defer-recovered it away

(in-ns 'go.internal.abi) (go/file "escape.go" :imports [

    ^{:line 7} [unsafe "unsafe"]])











^{:go/end 22} (go/func ^:go/nocheckptr ^:go/nosplit NoEscape "NoEscape hides the pointer p from escape analysis, preventing it\nfrom escaping to the heap. It compiles down to nothing.\n\nWARNING: This is very subtle to use correctly. The caller must\nensure that it's truly safe for p to not escape to the heap by\nmaintaining runtime pointer invariants (for example, that globals\nand the heap may not generally point into a stack).\n" ^unsafe/Pointer [^unsafe/Pointer p]
  (let [x (conv uintptr p)]
    (conv unsafe/Pointer (bit-xor x 0))))


(go/var ^bool alwaysFalse)
(go/var ^any escapeSink)


^{:go/end 33} (go/func Escape "Escape forces any pointers in x to escape to the heap.\n" :type-params [T] ^T [^T x]
  (when alwaysFalse
    (set! escapeSink x))

  ^{:line 32} x)















^{:go/end 48} (go/func EscapeNonString "EscapeNonString forces v to be on the heap, if v contains a\nnon-string pointer.\n\nThis is used in hash/maphash.Comparable. We cannot hash pointers\nto local variables on stack, as their addresses might change on\nstack growth. Strings are okay as the hash depends on only the\ncontent, not the pointer.\n\nThis is essentially\n\n\tif hasNonStringPointers(T) { Escape(v) }\n\nImplemented as a compiler intrinsic.\n" :type-params [T] [^T v] (panic "intrinsic"))













^{:go/end 65} (go/func EscapeToResultNonString "EscapeToResultNonString models a data flow edge from v to the result,\nif v contains a non-string pointer. If v contains only string pointers,\nit returns a copy of v, but is not modeled as a data flow edge\nfrom the escape analysis's perspective.\n\nThis is used in unique.clone, to model the data flow edge on the\nvalue with strings excluded, because strings are cloned (by\ncontent).\n\nTODO: probably we should define this as a intrinsic and EscapeNonString\ncould just be \"heap = EscapeToResultNonString(v)\". This way we can model\nan edge to the result but not necessarily heap.\n" :type-params [T] ^T [^T v]
  (^{:inst [T]} EscapeNonString v)
  ^{:line 64} @(conv (* T) (NoEscape (conv unsafe/Pointer (addr v)))))

(in-ns 'go.internal.abi) (go/file "symtab.go" :imports [])






(go/type PCLnTabMagic "PCLnTabMagic is the version at the start of the PC/line table.\nThis is the start of the .pclntab section, and is also runtime.pcHeader.\nThe magic numbers are chosen such that reading the value with\na different endianness does not result in the same value.\nThat lets us the magic number to determine the endianness.\n" uint32)

(go/const

  ^{:line 16} [^{:tag PCLnTabMagic :val 4294967291 :doc "Initial PCLnTabMagic value used in Go 1.2 through Go 1.15.\n"} Go12PCLnTabMagic 0xfffffffb]


  ^{:line 19} [^{:tag PCLnTabMagic :val 4294967290 :doc "PCLnTabMagic value used in Go 1.16 through Go 1.17.\nSeveral fields added to header (CL 241598).\n"} Go116PCLnTabMagic 0xfffffffa]


  ^{:line 22} [^{:tag PCLnTabMagic :val 4294967280 :doc "PCLnTabMagic value used in Go 1.18 through Go 1.19.\nEntry PC of func data changed from address to offset (CL 351463).\n"} Go118PCLnTabMagic 0xfffffff0]


  ^{:line 25} [^{:tag PCLnTabMagic :val 4294967281 :doc "PCLnTabMagic value used in Go 1.20 and later.\nA \":\" was added to generated symbol names (#37762).\n"} Go120PCLnTabMagic 0xfffffff1]








  ^{:line 34} [^{:val 4294967281 :doc "CurrentPCLnTabMagic is the value emitted by the current toolchain.\nThis is written by the linker to the pcHeader and read by the\nruntime and debug/gosym (and external tools like Delve).\n\nChange this value when updating the pclntab version.\nChanging this exported value is OK because is an\ninternal package.\n"} CurrentPCLnTabMagic Go120PCLnTabMagic])



(go/type FuncFlag "A FuncFlag records bits about a function, passed to the runtime.\n" uint8)

(go/const






  ^{:line 47} [^{:tag FuncFlag :val 1 :doc "FuncFlagTopFrame indicates a function that appears at the top of its stack.\nThe traceback routine stop at such a function and consider that a\nsuccessful, complete traversal of the stack.\nExamples of TopFrame functions include goexit, which appears\nat the top of a user goroutine stack, and mstart, which appears\nat the top of a system goroutine stack.\n"} FuncFlagTopFrame (<< 1 iota)]








  ^{:line 56} [^{:val 2 :doc "FuncFlagSPWrite indicates a function that writes an arbitrary value to SP\n(any write other than adding or subtracting a constant amount).\nThe traceback routines cannot encode such changes into the\npcsp tables, so the function traceback cannot safely unwind past\nSPWrite functions. Stopping at an SPWrite function is considered\nto be an incomplete unwinding of the stack. In certain contexts\n(in particular garbage collector stack scans) that is a fatal error.\n"} FuncFlagSPWrite]


  ^{:line 59} [^{:val 4 :doc "FuncFlagAsm indicates that a function was implemented in assembly.\n"} FuncFlagAsm])







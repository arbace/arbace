(in-ns 'go.internal.bytealg) (go/file "index_arm64.go" :imports [])



(go/const ^{:val 16 :doc "Empirical data shows that using Index can get better\nperformance when len(s) <= 16.\n"} MaxBruteForce 16)

^{:go/end 14} (go/func init []
  ;; Optimize cases where the length of the substring is less than 32 bytes
  (set! MaxLen 32))






^{:go/end 23} (go/func Cutover "Cutover reports the number of failures of IndexByte we should tolerate\nbefore switching over to Index.\nn is the number of bytes processed so far.\nSee the bytes.Index implementation for details.\n" ^int [^int n]
  ;; 1 error per 16 characters, plus a few slop to start.
  (+ 4 (>> n 4)))

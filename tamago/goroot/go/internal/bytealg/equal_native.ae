(in-ns 'go.internal.bytealg) (go/file "equal_native.go" :imports [

    ^{:line 7} [unsafe "unsafe"]])

;; The declarations below generate ABI wrappers for functions
;; implemented in assembly in this package but declared in another
;; package.

;; The compiler generates calls to runtime.memequal and runtime.memequal_varlen.
;; In addition, the runtime calls runtime.memequal explicitly.
;; Those functions are implemented in this package.


(go/func ^:extern ^{:go/linkname "abigen_runtime_memequal runtime.memequal"} abigen_runtime_memequal ^bool [^unsafe/Pointer a ^unsafe/Pointer b ^uintptr size])


(go/func ^:extern ^{:go/linkname "abigen_runtime_memequal_varlen runtime.memequal_varlen"} abigen_runtime_memequal_varlen ^bool [^unsafe/Pointer a ^unsafe/Pointer b])

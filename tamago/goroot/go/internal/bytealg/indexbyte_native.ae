(in-ns 'go.internal.bytealg) (go/file "indexbyte_native.go" :build ["//go:build 386 || (amd64 && !plan9) || s390x || arm || arm64 || loong64 || ppc64 || ppc64le || mips || mipsle || mips64 || mips64le || riscv64 || wasm"] :imports [])


(go/func ^:extern ^:go/noescape IndexByte ^int [^{:tag (slice byte)} b ^byte c])


(go/func ^:extern ^:go/noescape IndexByteString ^int [^string s ^byte c])

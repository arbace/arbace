(in-ns 'go.internal.bytealg) (go/file "compare_native.go" :build ["//go:build 386 || amd64 || s390x || arm || arm64 || loong64 || ppc64 || ppc64le || mips || mipsle || wasm || mips64 || mips64le || riscv64"] :imports [

    ^{:line 9} [_ "unsafe"]]) ; For go:linkname


(go/func ^:extern ^:go/noescape Compare ^int [^{:tag (slice byte)} a ^{:tag (slice byte)} b])

^{:go/end 16} (go/func CompareString ^int [^string a ^string b]
  (abigen_runtime_cmpstring a b))


;; The declaration below generates ABI wrappers for functions
;; implemented in assembly in this package but declared in another

(in-ns 'go.internal.bytealg) (go/file "count_native.go" :build ["//go:build amd64 || arm || arm64 || loong64 || mips64le || mips64 || ppc64le || ppc64 || riscv64 || s390x"] :imports [])


(go/func ^:extern ^:go/noescape Count ^int [^{:tag (slice byte)} b ^byte c])


(go/func ^:extern ^:go/noescape CountString ^int [^string s ^byte c])


^{:go/end 24} (go/func countGeneric "A backup implementation to use by assembly.\n" ^int [^{:tag (slice byte)} b ^byte c]
  (let [n 0]
    (range [_ x b]
      (when (== x c)
        (inc! n)))


    ^{:line 23} n))

^{:go/end 33} (go/func countGenericString ^int [^string s ^byte c]
  (let [n 0]
    (for [i 0] (< i (len s)) (inc! i)
      (when (== (aget s i) c)
        (inc! n)))


    ^{:line 32} n))

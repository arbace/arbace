(in-ns 'go.internal.bytealg) (go/file "index_amd64.go" :imports [

    ^{:line 7} [cpu "internal/cpu"]])

(go/const ^{:val 64} MaxBruteForce 64)

^{:go/end 17} (go/func init []
  (if (.-HasAVX2 cpu/X86)
    (set! MaxLen 63)

    (set! MaxLen 31)))







^{:go/end 26} (go/func Cutover "Cutover reports the number of failures of IndexByte we should tolerate\nbefore switching over to Index.\nn is the number of bytes processed so far.\nSee the bytes.Index implementation for details.\n" ^int [^int n]
  ;; 1 error per 8 characters, plus a few slop to start.
  (/ (+ n 16) 8))

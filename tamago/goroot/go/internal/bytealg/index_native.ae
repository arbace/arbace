(in-ns 'go.internal.bytealg) (go/file "index_native.go" :build ["//go:build amd64 || arm64 || loong64 || s390x || ppc64le || ppc64"] :imports [])





(go/func ^:extern ^:go/noescape Index "Index returns the index of the first instance of b in a, or -1 if b is not present in a.\nRequires 2 <= len(b) <= MaxLen.\n" ^int [^{:tag (slice byte)} a ^{:tag (slice byte)} b])





(go/func ^:extern ^:go/noescape IndexString "IndexString returns the index of the first instance of b in a, or -1 if b is not present in a.\nRequires 2 <= len(b) <= MaxLen.\n" ^int [^string a ^string b])

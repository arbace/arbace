(in-ns 'go.internal.bytealg) (go/file "lastindexbyte_generic.go" :imports [])

^{:go/breaks [[4 13]] :go/end 14} (go/func LastIndexByte ^int [^{:tag (slice byte)} s ^byte c]
  (for [i (- (len s) 1)] (>= i 0) (dec! i)
    (when (== (aget s i) c)
      (return i)))


  -1)


^{:go/breaks [[4 22]] :go/end 23} (go/func LastIndexByteString ^int [^string s ^byte c]
  (for [i (- (len s) 1)] (>= i 0) (dec! i)
    (when (== (aget s i) c)
      (return i)))


  -1)

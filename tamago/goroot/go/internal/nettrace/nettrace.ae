;; Package nettrace contains internal hooks for tracing activity in
;; the net package. This package is purely internal for use by the
;; net/http/httptrace package and has no stable API exposed to end
;; users.
(in-ns 'go.internal.nettrace) (go/file "nettrace.go" :doc "Package nettrace contains internal hooks for tracing activity in\nthe net package. This package is purely internal for use by the\nnet/http/httptrace package and has no stable API exposed to end\nusers.\n" :imports [])



(go/type TraceKey "TraceKey is a context.Context Value key. Its associated value should\nbe a *Trace struct.\n" (struct))







(go/type LookupIPAltResolverKey "LookupIPAltResolverKey is a context.Context Value key used by tests to\nspecify an alternate resolver func.\nIt is not exposed to outsider users. (But see issue 12503)\nThe value should be the same type as lookupIP:\n\n\tfunc lookupIP(ctx context.Context, host string) ([]IPAddr, error)\n" (struct))



(go/type Trace "Trace contains a set of hooks for tracing events within\nthe net package. Any specific hook may be nil.\n" (struct


    ^{:line 28 :tag (func [^string name]) :doc "DNSStart is called with the hostname of a DNS lookup\nbefore it begins.\n"} DNSStart





    ^{:line 34 :tag (func [^{:tag (slice any)} netIPs ^bool coalesced ^error err]) :doc "DNSDone is called after a DNS lookup completes (or fails).\nThe coalesced parameter is whether singleflight de-duped\nthe call. The addrs are of type net.IPAddr but can't\nactually be for circular dependency reasons.\n"} DNSDone





    ^{:line 40 :tag (func [^string network ^string addr]) :doc "ConnectStart is called before a Dial, excluding Dials made\nduring DNS lookups. In the case of DualStack (Happy Eyeballs)\ndialing, this may be called multiple times, from multiple\ngoroutines.\n"} ConnectStart




    ^{:line 45 :tag (func [^string network ^string addr ^error err]) :doc "ConnectDone is called after a Dial with the results, excluding\nDials made during DNS lookups. It may also be called multiple\ntimes, like ConnectStart.\n"} ConnectDone))

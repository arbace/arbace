(ns go.runtime.pprof
  (:require [arbace.go :as go]))

(go/package pprof
  :path "runtime/pprof"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["elf.go" "label.go" "map.go" "pe.go" "pprof.go" "pprof_norusage.go" "proto.go" "proto_other.go" "protobuf.go" "protomem.go" "runtime.go"]
  :init-order [errBadELF errNoBuildID space newline goroutineProfile goroutineLeakProfile threadcreateProfile heapProfile allocsProfile blockProfile mutexProfile]
  :positions :lines)

(load "pprof/elf")
(load "pprof/label")
(load "pprof/map")
(load "pprof/pe")
(load "pprof/pprof")
(load "pprof/pprof_norusage")
(load "pprof/proto")
(load "pprof/proto_other")
(load "pprof/protobuf")
(load "pprof/protomem")
(load "pprof/runtime")

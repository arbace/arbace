(ns go.runtime.pprof
  (:require [arbace.go :as go]))

(go/package pprof
  :path "runtime/pprof"
  :files ["elf.go" "label.go" "map.go" "pe.go" "pprof.go" "pprof_norusage.go" "proto.go" "proto_other.go" "protobuf.go" "protomem.go" "runtime.go"]
  :positions :lines)

(load "pprof/elf")
(load "pprof/label")
(load "pprof/map")
(load "pprof/pe")
(load "pprof/pprof")
(load "pprof/pprof_norusage")
(load "pprof/proto")
(load "pprof/proto_other")
(load "pprof/protobuf")
(load "pprof/protomem")
(load "pprof/runtime")

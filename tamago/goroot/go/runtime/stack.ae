(go/var ^{:tag uint32 :doc "startingStackSize is the amount of stack that new goroutines start with.\nIt is a power of 2, and between fixedStack and maxstacksize, inclusive.\nstartingStackSize is updated every GC by tracking the average size of\nstacks scanned during the GC.\n"} startingStackSize fixedStack)

^{:go/end 1460} (go/func gcComputeStartingStackSize []
  (when (== (.-adaptivestackstart debug) 0)
    (return))

  ;; For details, see the design doc at
  ;; https://docs.google.com/document/d/1YDlGIdVTPnmUiTAavlZxBI1d9pwGQgZT7IKFKlIXohQ/edit?usp=sharing
  ;; The basic algorithm is to track the average size of stacks
  ;; and start goroutines with stack equal to that average size.
  ;; Starting at the average size uses at most 2x the space that
  ;; an ideal algorithm would have used.
  ;; This is just a heuristic to avoid excessive stack growth work
  ;; early in a goroutine's lifetime. See issue 18138. Stacks that
  ;; are allocated too small can still grow, and stacks allocated
  ;; too large can still shrink.
  (let [^uint64 scannedStackSize (zero uint64)
      ^{:line 1437 :tag uint64} scannedStacks (zero uint64)]
    (range [_ p allp]
      (set! scannedStackSize + (.-scannedStackSize p))
      (set! scannedStacks + (.-scannedStacks p))
      ;; Reset for next time
      (set! (.-scannedStackSize p) 0)
      (set! (.-scannedStacks p) 0))

    (when (== scannedStacks 0)
      (set! startingStackSize fixedStack)
      (return))

    (let [avg (+ (/ scannedStackSize scannedStacks) stackGuard)]
      ;; Note: we add stackGuard to ensure that a goroutine that
      ;; uses the average space will not trigger a growth.
      (when (> avg (conv uint64 maxstacksize))
        (set! avg (conv uint64 maxstacksize)))

      (when (< avg fixedStack)
        (set! avg fixedStack))

      ;; Note: maxstacksize fits in 30 bits, so avg also does.
      (set! startingStackSize (conv uint32 (round2 (conv int32 avg)))))))

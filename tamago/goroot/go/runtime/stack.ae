^{:go/end 1369} (go/func freeStackSpans "freeStackSpans frees unused stack spans at the end of GC.\n" []
  ;; Scan stack pools for empty stack spans.
  (range [order stackpool]
    (lock (addr (.-mu (.-item (aget stackpool order)))))
    (let [list (addr (.-span (.-item (aget stackpool order))))]
      (for [s (.-first list)] (!= s nil) _
        (let [next (.-next s)]

            (.remove list s)
            (set! (.-manualFreeList s) 0)
            (osStackFree s)
            (.freeManual mheap_ s spanAllocStack))

          (set! s next)))

      (unlock (addr (.-mu (.-item (aget stackpool order)))))))


  ;; Free large stack spans.
  (lock (addr (.-lock stackLarge)))
  (range [i (.-free stackLarge)]
    (for [s (.-first (aget (.-free stackLarge) i))] (!= s nil) _
      (let [next (.-next s)]
        (.remove (aget (.-free stackLarge) i) s)
        (osStackFree s)
        (.freeManual mheap_ s spanAllocStack)
        (set! s next))))


  (unlock (addr (.-lock stackLarge))))





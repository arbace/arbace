      ^{:line 116 :tag int64} nextYield (zero int64)

      ;; Drive the goroutine to a preemption point.
      ^{:line 119} stopped false
      ^{:line 120 :tag (* m)} asyncM (zero (* m))
      ^{:line 121 :tag uint32} asyncGen (zero uint32)
      ^{:line 122 :tag int64} nextPreemptM (zero int64)]
    (for [i 0] _ (inc! i)
      (switch [s (readgstatus gp)] s
        (default
          (when (!= (bit-and s _Gscan) 0)
            ;; Someone else is suspending it. Wait
            ;; for them to finish.
            ;;
            ;; TODO: It would be nicer if we could
            ;; coalesce suspends.
            (break))


          (dumpgstatus gp)
          (throw "invalid g status"))

        (case [_Gdead _Gdeadextra]
          ;; Nothing to suspend.
          ;;
          ;; preemptStop may need to be cleared, but
          ;; doing that here could race with goroutine
          ;; reuse. Instead, goexit0 clears it.
          (return (lit suspendGState :dead true)))

        (case [_Gcopystack])
        ;; The stack is being copied. We need to wait
        ;; until this is done.

        (case [_Gpreempted]
          ;; We (or someone else) suspended the G. Claim
          ;; ownership of it by transitioning it to
          ;; _Gwaiting.
          (when (not (casGFromPreempted gp _Gpreempted _Gwaiting))
            (break))


          ;; We stopped the G, so we have to ready it later.
          (set! stopped true)

          (set! s _Gwaiting)
          (fallthrough))

        (case [_Grunnable _Gsyscall _Gwaiting _Gleaked]
          ;; Claim goroutine by setting scan bit.
          ;; This may race with execution or readying of gp.
          ;; The scan bit keeps it from transition state.
          (when (not (castogscanstatus gp s (bit-or s _Gscan)))
            (break))


          ;; Clear the preemption request. It's safe to
          ;; reset the stack guard because we hold the
          ;; _Gscan bit and thus own the stack.
          (set! (.-preemptStop gp) false)
          (set! (.-preempt gp) false)
          (set! (.-stackguard0 gp) (+ (.-lo (.-stack gp)) stackGuard))

          ;; The goroutine was already at a safe-point
          ;; and we've now locked that in.

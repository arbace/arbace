        (do
          (osyield)
          (set! nextYield (+ (nanotime) (/ yieldDelay 2))))))))






^{:go/end 282} (go/func resumeG "resumeG undoes the effects of suspendG, allowing the suspended\ngoroutine to continue from its current safe-point.\n" [^suspendGState state]
  (when (.-dead state)
    ;; We didn't actually stop anything.
    (return))


  (let [gp (.-g state)]
    (switch [s (readgstatus gp)] s
      (default
        (dumpgstatus gp)
        (throw "unexpected g status"))

      (case [(bit-or _Grunnable _Gscan)
          (bit-or _Gwaiting _Gscan)
          (bit-or _Gleaked _Gscan)
          (bit-or _Gsyscall _Gscan)]
        (casfrom_Gscanstatus gp s (bit-and-not s _Gscan))))


    (when (.-stopped state)
      ;; We stopped it, so we need to re-schedule it.
      (ready gp 0 true))))








^{:go/end 291} (go/func ^:go/nosplit canPreemptM "canPreemptM reports whether mp is in a state that is safe to preempt.\n\nIt is nosplit because it has nosplit callers.\n" ^bool [^{:tag (* m)} mp]
  (and (== (.-locks mp) 0) (== (.-mallocing mp) 0) (== (.-preemptoff mp) "") (== (.-status (.ptr (.-p mp))) _Prunning) (!= (.-curg mp) nil) (!= (bit-and-not (readgstatus (.-curg mp)) _Gscan) _Gsyscall)))



(go/func ^:extern asyncPreempt "asyncPreempt saves all user registers and calls asyncPreempt2.\n\nIt saves GP registers (anything that might contain a pointer) to the G stack.\nHence, when stack scanning encounters an asyncPreempt frame, it scans that\nframe and its parent frame conservatively.\n\nOn some platforms, it saves large additional scalar-only register state such\nas vector registers to an \"extended register state\" on the P.\n\nasyncPreempt is implemented in assembly.\n" [])











^{:go/end 344} (go/func ^:go/nosplit ^:go/nowritebarrierrec asyncPreempt2 "asyncPreempt2 is the Go continuation of asyncPreempt.\n\nIt must be deeply nosplit because there's untyped data on the stack from\nasyncPreempt.\n\nIt must not have any write barriers because we need to limit the amount of\nstack it uses.\n" []
  ;; We can't grow the stack with untyped data from asyncPreempt, so switch to
  ;; the system stack right away.
  (mcall ^{:go/end 333} (fn [^{:tag (* g)} gp]
      (set! (.-asyncSafePoint gp) true)

      ;; Move the extended register state from the P to the G. We do this now that
      ;; we're on the system stack to avoid stack splits.
      (xRegSave gp)

      (if (.-preemptStop gp)
        (preemptPark gp)

        (gopreempt_m gp))))

  ;; The above functions never return.


  ;; Do not grow the stack below here!

  (let [gp (getg)]

    ;; Put the extended register state back on the M so resumption can find it.
    ;; We can't do this in asyncPreemptM because the park calls never return.
    (xRegRestore gp)

    (set! (.-asyncSafePoint gp) false)))




(go/var ^{:doc "asyncPreemptStack is the bytes of stack space required to inject an\nasyncPreempt call.\n"} asyncPreemptStack (bit-not (conv uintptr 0)))

^{:go/end 365} (go/func init []
  (let [f (findfunc (abi/FuncPCABI0 asyncPreempt))
      ^{:line 352} total (funcMaxSPDelta f)]
    (set! f (findfunc (abi/FuncPCABIInternal asyncPreempt2)))
    (set! total + (funcMaxSPDelta f))
    (set! f (findfunc (abi/FuncPCABIInternal xRegRestore)))
    (set! total + (funcMaxSPDelta f))
    ;; Add some overhead for return PCs, etc.
    (set! asyncPreemptStack (+ (conv uintptr total) (* 8 goarch/PtrSize)))
    (when (> asyncPreemptStack stackNosplit)
      ;; We need more than the nosplit limit. This isn't unsafe, but it may
      ;; limit asynchronous preemption. Consider moving state into xRegState.
      (print "runtime: asyncPreemptStack=" asyncPreemptStack "\n")
      (throw "async stack too large"))))






^{:go/end 894} (go/method reportZombies "reportZombies reports any marked but free objects in s and throws.\n\nThis generally means one of the following:\n\n1. User code converted a pointer to a uintptr and then back\nunsafely, and a GC ran while the uintptr was the only reference to\nan object.\n\n2. User code (or a compiler bug) constructed a bad pointer that\npoints to a free slot, often a past-the-end pointer.\n\n3. The GC two cycles ago missed a pointer and freed a live object,\nbut it was still live in the last cycle, so this GC cycle found a\npointer to that object and marked it.\n" [^{:tag (* mspan)} s]
  (printlock)
  (print "runtime: marked free object in span " s ", elemsize=" (.-elemsize s) " freeindex=" (.-freeindex s) " (bad use of unsafe.Pointer or having race conditions? try -d=checkptr or -race)\n")
  (let [mbits (.markBitsForBase s)
      ^{:line 863} abits (.allocBitsForIndex s 0)]
    (for [i (conv uintptr 0)] (< i (conv uintptr (.-nelems s))) (inc! i)
      (let [addr (+ (.base s) (* i (.-elemsize s)))]
        (print (conv hex addr))
        (let [alloc (or (< i (conv uintptr (.-freeindex s))) (.isMarked abits))]
          (if alloc
            (print " alloc")

            (print " free "))

          (if (.isMarked mbits)
            (print " marked  ")

            (print " unmarked"))

          (let [zombie (and (.isMarked mbits) (not alloc))]
            (when zombie
              (print " zombie"))

            (print "\n")
            (when zombie
              (let [length (.-elemsize s)]
                (when (> length 1024)
                  (set! length 1024))

                (hexdumpWords addr length nil)))

            (.advance mbits)
            (.advance abits)))))

    (throw "found pointer to free object")))



















^{:go/end 966} (go/func deductSweepCredit "deductSweepCredit deducts sweep credit for allocating a span of\nsize spanBytes. This must be performed *before* the span is\nallocated to ensure the system has enough credit. If necessary, it\nperforms sweeping to prevent going in to debt. If the caller will\nalso sweep pages (e.g., for a large allocation), it can pass a\nnon-zero callerSweepPages to leave that many pages unswept.\n\ndeductSweepCredit makes a worst-case assumption that all spanBytes\nbytes of the ultimately allocated span will be available for object\nallocation.\n\ndeductSweepCredit is the core of the \"proportional sweep\" system.\nIt uses statistics gathered by the garbage collector to perform\nenough sweeping so that all pages are swept during the concurrent\nsweep phase between GC cycles.\n\nmheap_ must NOT be locked.\n" [^uintptr spanBytes ^uintptr callerSweepPages]

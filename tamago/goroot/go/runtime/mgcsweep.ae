^{:go/end 79} (go/method update [^{:tag (* sweepClass)} s ^sweepClass sNew]
  ;; Only update *s if its current value is less than sNew,
  ;; since *s increases monotonically.
  (let [sOld (.load s)]
    (while (and (< sOld sNew) (not (atomic/Cas (conv (* uint32) s) (conv uint32 sOld) (conv uint32 sNew))))
      (set! sOld (.load s)))))


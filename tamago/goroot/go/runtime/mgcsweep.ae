        (set! trace (traceAcquire))
        (when (.ok trace)
          (.GCSweepDone trace)
          (traceRelease trace))))))





^{:go/end 975} (go/func clobberfree "clobberfree sets the memory content at x to bad content, for debugging\npurposes.\n" [^unsafe/Pointer x ^uintptr size]
  ;; size (span.elemsize) is always a multiple of 4.
  (for [i (conv uintptr 0)] (< i size) (set! i + 4)
    (set! @(conv (* uint32) (add x i)) 0xdeadbeef)))









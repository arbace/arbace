(ns go.runtime.trace
  (:require [arbace.go :as go]))

(go/package trace
  :path "runtime/trace"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["annotation.go" "batch.go" "encoding.go" "flightrecorder.go" "recorder.go" "subscribe.go" "trace.go"]
  :init-order [lastTaskID bgTask noopRegion errOverflow errEOB]
  :positions :lines)

(load "trace/annotation")
(load "trace/batch")
(load "trace/encoding")
(load "trace/flightrecorder")
(load "trace/recorder")
(load "trace/subscribe")
(load "trace/trace")

^{:go/end 123} (go/method unpin [^{:tag (* pinner)} p]
  (when (or (== p nil) (== (.-refs p) nil))
    (return))

  (range [i (.-refs p)]
    (setPinned (aget (.-refs p) i) false))

  ;; The following two lines make all pointers to references
  ;; in p.refs unreachable, either by deleting them or dropping
  ;; p.refs' backing store (if it was not backed by refStore).
  (set! (.-refStore p) (lit (array pinnerRefStoreSize unsafe/Pointer)))
  (set! (.-refs p) (subslice (.-refStore p) _ 0)))


^{:go/end 139} (go/func pinnerGetPtr ^unsafe/Pointer [^{:tag (* any)} i]
  (let [e (efaceOf i)
      ^{:line 127} etyp (.-_type e)]
    (when (== etyp nil)
      (panic (conv errorString "runtime.Pinner: argument is nil")))

    (when [kind (.Kind etyp)] (and (!= kind abi/Pointer) (!= kind abi/UnsafePointer))
      (panic (conv errorString (+ "runtime.Pinner: argument is not a pointer: " (.string (toRType etyp))))))

    (when (inUserArenaChunk (conv uintptr (.-data e)))
      ;; Arena-allocated objects are not eligible for pinning.
      (panic (conv errorString "runtime.Pinner: object was allocated into an arena")))

    (.-data e)))






^{:go/end 163} (go/func ^:go/nosplit isPinned "isPinned checks if a Go pointer is pinned.\nnosplit, because it's called from nosplit code in cgocheck.\n" ^bool [^unsafe/Pointer ptr]
  (let [span (spanOfHeap (conv uintptr ptr))]
    (when (== span nil)
      ;; this code is only called for Go pointer, so this must be a
      ;; linker-allocated global object.
      (return true))

    (let [pinnerBits (.getPinnerBits span)]
      ;; these pinnerBits might get unlinked by a concurrently running sweep, but
      ;; that's OK because gcBits don't get cleared until the following GC cycle
      ;; (nextMarkBitArenaEpoch)
      (when (== pinnerBits nil)
        (return false))

      (let [objIndex (.objIndex span (conv uintptr ptr))
          ^{:line 160} pinState (.ofObject pinnerBits objIndex)]
        (KeepAlive ptr) ; make sure ptr is alive until we are done so the span can't be freed
        (.isPinned pinState)))))






^{:go/end 236} (go/func setPinned "setPinned marks or unmarks a Go pointer as pinned, when the ptr is a Go pointer.\nIt will be ignored while trying to pin a non-Go pointer.\nIt will panic while trying to unpin a non-Go pointer,\nwhich should not happen in normal usage.\n" ^bool [^unsafe/Pointer ptr ^bool pin]
  (let [span (spanOfHeap (conv uintptr ptr))]
    (when (== span nil)
      (when (not pin)
        (panic (conv errorString "tried to unpin non-Go pointer")))

      ;; This is a linker-allocated, zero size object or other object,
      ;; nothing to do, silently ignore it.
      (return false))


    ;; ensure that the span is swept, b/c sweeping accesses the specials list
    ;; w/o locks.
    (let [mp (acquirem)]
      (.ensureSwept span)
      (KeepAlive ptr) ; make sure ptr is still alive after span is swept

      (let [objIndex (.objIndex span (conv uintptr ptr))]

        (lock (addr (.-speciallock span))) ; guard against concurrent calls of setPinned on same span

        (let [pinnerBits (.getPinnerBits span)]
          (when (== pinnerBits nil)
            (set! pinnerBits (.newPinnerBits span))
            (.setPinnerBits span pinnerBits))

          ^{:go/breaks [5]} (let [pinState (.ofObject pinnerBits objIndex)]
            (if pin
              (if (.isPinned pinState) (do
                  ;; multiple pins on same object, set multipin bit
                  (.setMultiPinned pinState true)
                  ;; and increase the pin counter
                  ;; TODO(mknyszek): investigate if systemstack is necessary here
                  (systemstack ^{:go/end 205} (fn []
                      (let [offset (* objIndex (.-elemsize span))]
                        (.incPinCounter span offset)))))


                ;; set pin bit
                (.setPinned pinState true))

              (do
                ;; unpin
                (if (.isPinned pinState)
                  (if (.isMultiPinned pinState)
                    (let [^bool exists (zero bool)]
                      ;; TODO(mknyszek): investigate if systemstack is necessary here
                      (systemstack ^{:go/end 219} (fn []
                          (let [offset (* objIndex (.-elemsize span))]
                            (set! exists (.decPinCounter span offset)))))

                      (when (not exists)
                        ;; counter is 0, clear multipin bit
                        (.setMultiPinned pinState false)))


                    ;; no multipins recorded. unpin object.
                    (.setPinned pinState false))


                  ;; unpinning unpinned object, bail out
                  (throw "runtime.Pinner: object already unpinned"))))


            (unlock (addr (.-speciallock span)))
            (releasem mp)
            true))))))



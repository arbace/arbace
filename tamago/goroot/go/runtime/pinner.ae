^{:go/end 363} (go/method incPinCounter "incPinCounter is only called for multiple pins of the same object and records\nthe _additional_ pins.\n" [^{:tag (* mspan)} span ^uintptr offset]
  (let [^{:tag (* specialPinCounter)} rec (zero (* specialPinCounter))
      (values ref exists) (.specialFindSplicePoint span offset _KindSpecialPinCounter)]
    (if (not exists) (do
        (lock (addr (.-speciallock mheap_)))
        (set! rec (conv (* specialPinCounter) (.alloc (.-specialPinCounterAlloc mheap_))))
        (unlock (addr (.-speciallock mheap_)))

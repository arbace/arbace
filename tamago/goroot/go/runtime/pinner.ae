  ^{:line 102} [^{:val 64} pinnerSize 64]
  ^{:line 103} [^{:val 5} pinnerRefStoreSize (/ (- pinnerSize (unsafe/Sizeof (lit (slice unsafe/Pointer)))) (unsafe/Sizeof (conv unsafe/Pointer nil)))])



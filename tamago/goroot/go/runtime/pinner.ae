    (inc! (.-counter rec))))




^{:go/end 385} (go/method decPinCounter "decPinCounter decreases the counter. If the counter reaches 0, the counter\nspecial is deleted and false is returned. Otherwise true is returned.\n" ^bool [^{:tag (* mspan)} span ^uintptr offset]

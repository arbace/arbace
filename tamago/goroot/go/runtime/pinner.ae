(go/type Pinner "A Pinner is a set of Go objects each pinned to a fixed location in memory. The\n[Pinner.Pin] method pins one object, while [Pinner.Unpin] unpins all pinned\nobjects.\n\nThe purpose of a Pinner is two-fold.\nFirst, it allows C code to safely use Go pointers that have not been passed\nexplicitly to the C code via a cgo call.\nFor example, for safely interacting with a pointer stored inside of a struct\nwhose pointer is passed to a C function.\nSecond, it allows C memory to safely retain that Go pointer even after the\ncgo call returns, provided the object remains pinned.\n\nA Pinner arranges for its objects to be automatically unpinned some time after\nit becomes unreachable, so its referents will not leak. However, this means the\nPinner itself must be kept alive across a cgo call, or as long as C retains a\nreference to the pinned Go pointers.\n\nReusing a Pinner is safe, and in fact encouraged, to avoid the cost of\ninitializing new Pinners on first use.\n\nThe zero value of Pinner is ready to use.\n" (struct
    (* pinner)))













^{:go/end 82} (go/method Pin "Pin pins a Go object, preventing it from being moved or freed by the garbage\ncollector until the [Pinner.Unpin] method has been called.\n\nA pointer to a pinned object can be directly stored in C memory or can be\ncontained in Go memory passed to C functions. If the pinned object itself\ncontains pointers to Go objects, these objects must be pinned separately if they\nare going to be accessed from C code.\n\nThe argument must be a pointer of any type or an [unsafe.Pointer].\n\nIt's safe to call Pin on non-Go pointers, in which case Pin will do nothing.\n" [^{:tag (* Pinner)} p ^any pointer]
  (when (== (.-pinner p) nil)
    ;; Check the pinner cache first.
    (let [mp (acquirem)]
      (when [pp (.ptr (.-p mp))] (!= pp nil)
        (set! (.-pinner p) (.-pinnerCache pp))
        (set! (.-pinnerCache pp) nil))

      (releasem mp)

      (when (== (.-pinner p) nil)
        ;; Didn't get anything from the pinner cache.
        (set! (.-pinner p) (new pinner))
        (set! ^{:go/via [pinner]} (.-refs p) (subslice ^{:go/via [pinner]} (.-refStore p) _ 0))

        ;; We set this finalizer once and never clear it. Thus, if the
        ;; pinner gets cached, we'll reuse it, along with its finalizer.
        ;; This lets us avoid the relatively expensive SetFinalizer call
        ;; when reusing from the cache. The finalizer however has to be
        ;; resilient to an empty pinner being finalized, which is done
        ;; by checking p.refs' length.
        (SetFinalizer (.-pinner p) ^{:go/end 75} (fn [^{:tag (* pinner)} i]
            (when (!= (len (.-refs i)) 0)
              (.unpin i) ; only required to make the test idempotent
              (pinnerLeakPanic)))))))




  (let [ptr (pinnerGetPtr (addr pointer))]
    (when (setPinned ptr true)
      (set! ^{:go/via [pinner]} (.-refs p) (append ^{:go/via [pinner]} (.-refs p) ptr)))))





^{:go/end 99} (go/method Unpin "Unpin unpins all pinned objects of the [Pinner].\nIt's safe and encouraged to reuse a Pinner after calling Unpin.\n" [^{:tag (* Pinner)} p]
  (.unpin (.-pinner p))

  (let [mp (acquirem)]
    (when [pp (.ptr (.-p mp))] (and (!= pp nil) (== (.-pinnerCache pp) nil))
      ;; Put the pinner back in the cache, but only if the
      ;; cache is empty. If application code is reusing Pinners
      ;; on its own, we want to leave the backing store in place
      ;; so reuse is more efficient.
      (set! (.-pinnerCache pp) (.-pinner p))
      (set! (.-pinner p) nil))

    (releasem mp)))



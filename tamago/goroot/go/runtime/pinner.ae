^{:go/end 249} (go/method ^:go/nosplit isPinned "nosplit, because it's called by isPinned, which is nosplit\n" ^bool [^{:tag (* pinState)} v]
  (!= (bit-and (.-byteVal v) (.-mask v)) 0))


^{:go/end 253} (go/method isMultiPinned ^bool [^{:tag (* pinState)} v]
  (!= (bit-and (.-byteVal v) (<< (.-mask v) 1)) 0))


^{:go/end 257} (go/method setPinned [^{:tag (* pinState)} v ^bool val]
  (.set v val false))


^{:go/end 261} (go/method setMultiPinned [^{:tag (* pinState)} v ^bool val]
  (.set v val true))




^{:go/end 275} (go/method set "set sets the pin bit of the pinState to val. If multipin is true, it\nsets/unsets the multipin bit instead.\n" [^{:tag (* pinState)} v ^bool val ^bool multipin]
  (let [mask (.-mask v)]
    (when multipin
      (set! mask << 1))

    (if val
      (atomic/Or8 (.-bytep v) mask)

      (atomic/And8 (.-bytep v) (bit-not mask)))))




(go/type pinnerBits "pinnerBits is the same type as gcBits but has different methods.\n" gcBits)






            (case [abi/Pointer]
              (let [pt (conv (* ptrtype) (conv unsafe/Pointer t))
                  ^{:line 682} pv (conv (* ptrtype) (conv unsafe/Pointer v))]
                (return (typesEqual (.-Elem pt) (.-Elem pv) seen))))
            (case [abi/Slice]
              (let [st (conv (* slicetype) (conv unsafe/Pointer t))
                  ^{:line 686} sv (conv (* slicetype) (conv unsafe/Pointer v))]
                (return (typesEqual (.-Elem st) (.-Elem sv) seen))))
            (case [abi/Struct]
              (let [st (conv (* structtype) (conv unsafe/Pointer t))
                  ^{:line 690} sv (conv (* structtype) (conv unsafe/Pointer v))]
                (when (!= (len (.-Fields st)) (len (.-Fields sv)))
                  (return false))

                (when (!= (.Name (.-PkgPath st)) (.Name (.-PkgPath sv)))
                  (return false))

                (range [i (.-Fields st)]
                  (let [tf (addr (aget (.-Fields st) i))
                      ^{:line 699} vf (addr (aget (.-Fields sv) i))]
                    (when (!= (.Name (.-Name tf)) (.Name (.-Name vf)))
                      (return false))

                    (when (not (typesEqual (.-Typ tf) (.-Typ vf) seen))
                      (return false))

                    (when (!= (.Tag (.-Name tf)) (.Tag (.-Name vf)))
                      (return false))

                    (when (!= (.-Offset tf) (.-Offset vf))
                      (return false))

                    (when (!= (.IsEmbedded (.-Name tf)) (.IsEmbedded (.-Name vf)))
                      (return false))))


                (return true)))
            (default
              (println "runtime: impossible type kind" kind)
              (throw "runtime: impossible type kind")
              (return false))))))))

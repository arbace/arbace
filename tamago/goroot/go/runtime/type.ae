              ;; is larger than half of the parent type.
              ;; There can be only one.
              (set! bigField f)
              (continue))

            (buildGCMask ft (.offset dst (/ (.-Offset f) goarch/PtrSize)))))

        (when (!= (.-Typ bigField) nil)
          ;; Note: this case causes bits to be written out of order.
          (set! t (.-Typ bigField))

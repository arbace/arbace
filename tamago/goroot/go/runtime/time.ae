^{:go/end 185} (go/method less "less reports whether tw is less than other.\n" ^bool [^timerWhen tw ^timerWhen other]
  (switch
    (case [(< (.-when tw) (.-when other))]
      (return true))
    (case [(> (.-when tw) (.-when other))]
      (return false))
    (default
      ;; When timers wake at the same time, use a per-timer random value to order them.

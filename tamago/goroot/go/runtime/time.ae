;; Timer channels.




^{:go/end 1430} (go/method maybeRunChan "maybeRunChan checks whether the timer needs to run\nto send a value to its associated channel. If so, it does.\nThe timer must not be locked.\n" [^{:tag (* timer)} t ^{:tag (* hchan)} c]
  (when (and (.-isFake t) (!= (.-bubble (getg)) (.-bubble c)))
    ;; This should have been checked by the caller, but check just in case.
    (fatal "synctest timer accessed from outside bubble"))

  (when (!= (bit-and (.Load (.-astate t)) timerHeaped) 0)
    ;; If the timer is in the heap, the ordinary timer code
    ;; is in charge of sending when appropriate.
    (return))


  (.lock t)
  (let [now (nanotime)]
    (when (.-isFake t)
      (set! now (.-now (.-bubble (getg)))))

    (when (or (!= (bit-and (.-state t) timerHeaped) 0) (== (.-when t) 0) (> (.-when t) now))
      (.trace t "maybeRunChan-")
      ;; Timer in the heap, or not running at all, or not triggered.
      (.unlock t)
      (return))

    (.trace t "maybeRunChan+")
    (systemstack ^{:go/end 1429} (fn []
        (.unlockAndRun t now (.-bubble c))))))







^{:go/end 1470} (go/func blockTimerChan "blockTimerChan is called when a channel op has decided to block on c.\nThe caller holds the channel lock for c and possibly other channels.\nblockTimerChan makes sure that c is in a timer heap,\nadding it if needed.\n" [^{:tag (* hchan)} c]
  (let [t (.-timer c)]
    (when (and (.-isFake t) (!= (.-bubble c) (.-bubble (getg))))
      ;; This should have been checked by the caller, but check just in case.
      (fatal "synctest timer accessed from outside bubble"))


    (.lock t)
    (.trace t "blockTimerChan")
    (when (not (.-isChan t))
      (badTimer))


    (inc! (.-blocked t))

    ;; If this is the first enqueue after a recent dequeue,
    ;; the timer may still be in the heap but marked as a zombie.
    ;; Unmark it in this case, if the timer is still pending.
    (when (and (!= (bit-and (.-state t) timerHeaped) 0) (!= (bit-and (.-state t) timerZombie) 0) (> (.-when t) 0))
      (set! (.-state t) bit-and-not timerZombie)
      (.Add (.-zombies (.-ts t)) -1))


    ;; t.maybeAdd must be called with t unlocked,
    ;; because it needs to lock t.ts before t.
    ;; Then it will do nothing if t.needsAdd(state) is false.
    ;; Check that now before the unlock,
    ;; avoiding the extra lock-lock-unlock-unlock
    ;; inside maybeAdd when t does not need to be added.
    (let [add (.needsAdd t)]
      (.unlock t)
      (when add
        (.maybeAdd t)))))









^{:go/end 1494} (go/func unblockTimerChan "unblockTimerChan is called when a channel op that was blocked on c\nis no longer blocked. Every call to blockTimerChan must be paired with\na call to unblockTimerChan.\nThe caller holds the channel lock for c and possibly other channels.\nunblockTimerChan removes c from the timer heap when nothing is\nblocked on it anymore.\n" [^{:tag (* hchan)} c]
  (let [t (.-timer c)]
    (.lock t)
    (.trace t "unblockTimerChan")
    (when (or (not (.-isChan t)) (== (.-blocked t) 0))
      (badTimer))

    (dec! (.-blocked t))
    (when (and (== (.-blocked t) 0) (!= (bit-and (.-state t) timerHeaped) 0) (== (bit-and (.-state t) timerZombie) 0))
      ;; Last goroutine that was blocked on this timer.
      ;; Mark for removal from heap but do not clear t.when,
      ;; so that we know what time it is still meant to trigger.
      (set! (.-state t) bit-or timerZombie)
      (.Add (.-zombies (.-ts t)) 1))

    (.unlock t)))

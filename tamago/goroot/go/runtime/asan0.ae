;; Dummy ASan support API, used when not built with -asan.

(in-ns 'go.runtime) (go/file "asan0.go" :build ["//go:build !asan"] :imports [


    ^{:line 12} [unsafe "unsafe"]])


(go/const ^{:val false} asanenabled false)
(go/const ^{:val 0} asanenabledBit 0)

;; Because asanenabled is false, none of these functions should be called.

^{:go/end 20} (go/func asanread [^unsafe/Pointer addr ^uintptr sz] (throw "asan"))
^{:go/end 21} (go/func asanwrite [^unsafe/Pointer addr ^uintptr sz] (throw "asan"))
^{:go/end 22} (go/func asanunpoison [^unsafe/Pointer addr ^uintptr sz] (throw "asan"))
^{:go/end 23} (go/func asanpoison [^unsafe/Pointer addr ^uintptr sz] (throw "asan"))
^{:go/end 24} (go/func asanregisterglobals [^unsafe/Pointer addr ^uintptr sz] (throw "asan"))
^{:go/end 25} (go/func lsanregisterrootregion [unsafe/Pointer uintptr] (throw "asan"))
^{:go/end 26} (go/func lsanunregisterrootregion [unsafe/Pointer uintptr] (throw "asan"))
^{:go/end 27} (go/func lsandoleakcheck [] (throw "asan"))

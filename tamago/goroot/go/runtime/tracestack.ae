^{:go/end 357} (go/func startPCForTrace "startPCForTrace returns the start PC of a goroutine for tracing purposes.\nIf pc is a wrapper, it returns the PC of the wrapped function. Otherwise it\nreturns pc.\n" ^uintptr [^uintptr pc]

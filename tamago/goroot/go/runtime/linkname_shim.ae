(in-ns 'go.runtime) (go/file "linkname_shim.go" :imports [


    ^{:line 8} [abi "internal/abi"]
    ^{:line 9} [maps "internal/runtime/maps"]
    ^{:line 10} [sys "internal/runtime/sys"]
    ^{:line 11} [unsafe "unsafe"]])


;; Legacy //go:linkname compatibility shims
;;
;; The functions below are unused by the toolchain, and exist only for
;; compatibility with existing //go:linkname use in the ecosystem.










































(go/type linknameIter "linknameIter is the it argument to mapiterinit and mapiternext.\n\nCallers of mapiterinit allocate their own iter structure, which has the\nlayout of the pre-Go 1.24 hiter structure, shown here for posterity:\n\n\ttype hiter struct {\n\t\tkey         unsafe.Pointer\n\t\telem        unsafe.Pointer\n\t\tt           *maptype // old map abi.Type\n\t\th           *hmap\n\t\tbuckets     unsafe.Pointer\n\t\tbptr        *bmap\n\t\toverflow    *[]*bmap\n\t\toldoverflow *[]*bmap\n\t\tstartBucket uintptr\n\t\toffset      uint8\n\t\twrapped     bool\n\t\tB           uint8\n\t\ti           uint8\n\t\tbucket      uintptr\n\t\tcheckBucket uintptr\n\t}\n\nOur structure must maintain compatibility with the old structure. This\nmeans:\n\n  - Our structure must be the same size or smaller than hiter. Otherwise we\n    may write outside the caller's hiter allocation.\n  - Our structure must have the same pointer layout as hiter, so that the GC\n    tracks pointers properly.\n\nBased on analysis of the \"hall of shame\" users of these linknames:\n\n  - The key and elem fields must be kept up to date with the current key/elem.\n    Some users directly access the key and elem fields rather than calling\n    reflect.mapiterkey/reflect.mapiterelem.\n  - The t field must be non-nil after mapiterinit. gonum.org/v1/gonum uses\n    this to verify the iterator is initialized.\n  - github.com/segmentio/encoding and github.com/RomiChan/protobuf check if h\n    is non-nil, but the code has no effect. Thus the value of h does not\n    matter. See internal/runtime_reflect/map.go.\n" (struct

    ^{:line 62 :tag unsafe/Pointer :doc "Fields from hiter.\n"} key
    ^{:line 63 :tag unsafe/Pointer} elem
    ^{:line 64 :tag (* abi/MapType)} typ


    ^{:line 67 :tag (* maps/Iter) :doc "The real iterator.\n"} it))




















^{:go/end 102} (go/func ^{:go/linkname "mapiterinit"} mapiterinit "mapiterinit is a compatibility wrapper for map iterator for users of\n//go:linkname from before Go 1.24. It is not used by Go itself. New users\nshould use reflect or the maps package.\n\nmapiterinit should be an internal detail,\nbut widely used packages access it using linkname.\nNotable members of the hall of shame include:\n  - github.com/bytedance/sonic\n  - github.com/goccy/go-json\n  - github.com/RomiChan/protobuf\n  - github.com/segmentio/encoding\n  - github.com/ugorji/go/codec\n  - github.com/wI2L/jettison\n\nDo not remove or change the type signature.\nSee go.dev/issue/67401.\n" [^{:tag (* abi/MapType)} t ^{:tag (* maps/Map)} m ^{:tag (* linknameIter)} it]
  (when (and raceenabled (!= m nil))
    (let [callerpc (sys/GetCallerPC)]
      (racereadpc (conv unsafe/Pointer m) callerpc (abi/FuncPCABIInternal mapiterinit))))


  (set! (.-typ it) t)

  (set! (.-it it) (new maps/Iter))
  (.Init (.-it it) t m)
  (.Next (.-it it))

  (set! (.-key it) (.Key (.-it it)))
  (set! (.-elem it) (.Elem (.-it it))))


















^{:go/end 122} (go/func ^{:go/linkname "reflect_mapiterinit reflect.mapiterinit"} reflect_mapiterinit "reflect_mapiterinit is a compatibility wrapper for map iterator for users of\n//go:linkname from before Go 1.24. It is not used by Go itself. New users\nshould use reflect or the maps package.\n\nreflect_mapiterinit should be an internal detail,\nbut widely used packages access it using linkname.\nNotable members of the hall of shame include:\n  - github.com/modern-go/reflect2\n  - gitee.com/quant1x/gox\n  - github.com/v2pro/plz\n  - github.com/wI2L/jettison\n\nDo not remove or change the type signature.\nSee go.dev/issue/67401.\n" [^{:tag (* abi/MapType)} t ^{:tag (* maps/Map)} m ^{:tag (* linknameIter)} it]
  (mapiterinit t m it))



















^{:go/end 151} (go/func ^{:go/linkname "mapiternext"} mapiternext "mapiternext is a compatibility wrapper for map iterator for users of\n//go:linkname from before Go 1.24. It is not used by Go itself. New users\nshould use reflect or the maps package.\n\nmapiternext should be an internal detail,\nbut widely used packages access it using linkname.\nNotable members of the hall of shame include:\n  - github.com/bytedance/sonic\n  - github.com/RomiChan/protobuf\n  - github.com/segmentio/encoding\n  - github.com/ugorji/go/codec\n  - gonum.org/v1/gonum\n\nDo not remove or change the type signature.\nSee go.dev/issue/67401.\n" [^{:tag (* linknameIter)} it]
  (when raceenabled
    (let [callerpc (sys/GetCallerPC)]
      (racereadpc (conv unsafe/Pointer (.Map (.-it it))) callerpc (abi/FuncPCABIInternal mapiternext))))


  (.Next (.-it it))

  (set! (.-key it) (.Key (.-it it)))
  (set! (.-elem it) (.Elem (.-it it))))



















^{:go/end 172} (go/func ^{:go/linkname "reflect_mapiternext reflect.mapiternext"} reflect_mapiternext "reflect_mapiternext is a compatibility wrapper for map iterator for users of\n//go:linkname from before Go 1.24. It is not used by Go itself. New users\nshould use reflect or the maps package.\n\nreflect_mapiternext is for package reflect,\nbut widely used packages access it using linkname.\nNotable members of the hall of shame include:\n  - gitee.com/quant1x/gox\n  - github.com/modern-go/reflect2\n  - github.com/goccy/go-json\n  - github.com/v2pro/plz\n  - github.com/wI2L/jettison\n\nDo not remove or change the type signature.\nSee go.dev/issue/67401.\n" [^{:tag (* linknameIter)} it]
  (mapiternext it))
















^{:go/end 190} (go/func ^{:go/linkname "reflect_mapiterkey reflect.mapiterkey"} reflect_mapiterkey "reflect_mapiterkey is a compatibility wrapper for map iterator for users of\n//go:linkname from before Go 1.24. It is not used by Go itself. New users\nshould use reflect or the maps package.\n\nreflect_mapiterkey should be an internal detail,\nbut widely used packages access it using linkname.\nNotable members of the hall of shame include:\n  - github.com/goccy/go-json\n  - gonum.org/v1/gonum\n\nDo not remove or change the type signature.\nSee go.dev/issue/67401.\n" ^unsafe/Pointer [^{:tag (* linknameIter)} it]
  (.Key (.-it it)))
















^{:go/end 208} (go/func ^{:go/linkname "reflect_mapiterelem reflect.mapiterelem"} reflect_mapiterelem "reflect_mapiterelem is a compatibility wrapper for map iterator for users of\n//go:linkname from before Go 1.24. It is not used by Go itself. New users\nshould use reflect or the maps package.\n\nreflect_mapiterelem should be an internal detail,\nbut widely used packages access it using linkname.\nNotable members of the hall of shame include:\n  - github.com/goccy/go-json\n  - gonum.org/v1/gonum\n\nDo not remove or change the type signature.\nSee go.dev/issue/67401.\n" ^unsafe/Pointer [^{:tag (* linknameIter)} it]
  (.Elem (.-it it)))

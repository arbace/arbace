(go/func ^:extern userTaskCreate "emits UserTaskCreate event.\n" [^uint64 id ^uint64 parentID ^string taskType])


(go/func ^:extern userTaskEnd "emits UserTaskEnd event.\n" [^uint64 id])


(go/func ^:extern userRegion "emits UserRegion event.\n" [^uint64 id ^uint64 mode ^string regionType])


(go/func ^:extern userLog "emits UserLog event.\n" [^uint64 id ^string category ^string message])

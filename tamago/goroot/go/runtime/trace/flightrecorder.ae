(in-ns 'go.runtime.trace) (go/file "flightrecorder.go" :imports [


    ^{:line 8} [fmt "fmt"]
    ^{:line 9} [io "io"]
    ^{:line 10} [sync "sync"]
    ^{:line 11} [time "time"]
    ^{:line 12} [_ "unsafe"]]) ; added for go linkname usage












(go/type FlightRecorder "FlightRecorder represents a single consumer of a Go execution\ntrace.\nIt tracks a moving window over the execution trace produced by\nthe runtime, always containing the most recent trace data.\n\nAt most one flight recorder may be active at any given time,\nthough flight recording is allowed to be concurrently active\nwith a trace consumer using trace.Start.\nThis restriction of only a single flight recorder may be removed\nin the future.\n" (struct
    ^{:line 26 :tag error} err


    ^{:line 29 :tag (array 16 byte) :doc "State specific to the recorder.\n"} header
    ^{:line 30 :tag rawGeneration} active
    ^{:line 31 :tag sync/Mutex} ringMu
    ^{:line 32 :tag (slice rawGeneration)} ring
    ^{:line 33 :tag frequency} freq ; timestamp conversion factor, from the runtime


    ^{:line 36 :tag uint64 :doc "Externally-set options.\n"} targetSize
    ^{:line 37 :tag time/Duration} targetPeriod

    ^{:line 39 :tag bool} enabled ; whether the flight recorder is enabled.
    ^{:line 40 :tag sync/Mutex} writing ; protects concurrent calls to WriteTo


    ^{:line 43 :tag uint64 :doc "The values of targetSize and targetPeriod we've committed to since the last Start.\n"} wantSize
    ^{:line 44 :tag time/Duration} wantDur))



^{:go/end 62} (go/func NewFlightRecorder "NewFlightRecorder creates a new flight recorder from the provided configuration.\n" ^{:tag (* FlightRecorder)} [^FlightRecorderConfig cfg]
  (let [fr (new FlightRecorder)]
    (if (!= (.-MaxBytes cfg) 0)
      (set! (.-targetSize fr) (.-MaxBytes cfg))

      (set! (.-targetSize fr) (<< 10 20))) ; 10 MiB.


    (if (!= (.-MinAge cfg) 0)
      (set! (.-targetPeriod fr) (.-MinAge cfg))

      (set! (.-targetPeriod fr) (* 10 time/Second)))

    ^{:line 61} fr))






^{:go/breaks [11] :go/end 85} (go/method Start "Start activates the flight recorder and begins recording trace data.\nOnly one call to trace.Start may be active at any given time.\nIn addition, currently only one flight recorder may be active in the program.\nReturns an error if the flight recorder cannot be started or is already started.\n" ^error [^{:tag (* FlightRecorder)} fr]
  (when (.-enabled fr)
    (return (fmt/Errorf "cannot enable a enabled flight recorder")))

  (set! (.-wantSize fr) (.-targetSize fr))
  (set! (.-wantDur fr) (.-targetPeriod fr))
  (set! (.-err fr) nil)
  (set! (.-freq fr) (conv frequency (/ 1.0 (/ (conv float64 (runtime_traceClockUnitsPerSecond)) 1.0E9))))

  ;; Start tracing, data is sent to a recorder which forwards it to our own
  ;; storage.
  (when [err (.subscribeFlightRecorder tracing (addr (lit recorder :r fr)))] (!= err nil)
    (return err))


  (set! (.-enabled fr) true)
  nil)



^{:go/end 98} (go/method Stop "Stop ends recording of trace data. It blocks until any concurrent WriteTo calls complete.\n" [^{:tag (* FlightRecorder)} fr]
  (when (not (.-enabled fr))
    (return))

  (set! (.-enabled fr) false)
  (.unsubscribeFlightRecorder tracing)

  ;; Reset all state. No need to lock because the reader has already exited.
  (set! (.-active fr) (lit rawGeneration))
  (set! (.-ring fr) nil))





^{:go/end 103} (go/method Enabled "Enabled returns true if the flight recorder is active.\nSpecifically, it will return true if Start did not return an error, and Stop has not yet been called.\nIt is safe to call from multiple goroutines simultaneously.\n" ^bool [^{:tag (* FlightRecorder)} fr] (.-enabled fr))







^{:go/end 154} (go/method WriteTo "WriteTo snapshots the moving window tracked by the flight recorder.\nThe snapshot is expected to contain data that is up-to-date as of when WriteTo is called,\nthough this is not a hard guarantee.\nOnly one goroutine may execute WriteTo at a time.\nAn error is returned upon failure to write to w, if another WriteTo call is already in-progress,\nor if the flight recorder is inactive.\n" [^{:tag (* FlightRecorder)} fr ^io/Writer w] :results [^int64 n ^error err]
  (when (not (.-enabled fr))
    (return 0 (fmt/Errorf "cannot snapshot a disabled flight recorder")))

  (when (not (.TryLock (.-writing fr)))
    ;; Indicates that a call to WriteTo was made while one was already in progress.
    ;; If the caller of WriteTo sees this error, they should use the result from the other call to WriteTo.
    (return 0 (fmt/Errorf "call to WriteTo for trace.FlightRecorder already in progress")))

  (defer (.Unlock (.-writing fr)))

  ;; Force a global buffer flush.
  (runtime_traceAdvance false)

  ;; Now that everything has been flushed and written, grab whatever we have.
  ;;
  ;; N.B. traceAdvance blocks until the tracer goroutine has actually written everything
  ;; out, which means the generation we just flushed must have been already been observed
  ;; by the recorder goroutine. Because we flushed twice, the first flush is guaranteed to
  ;; have been both completed *and* processed by the recorder goroutine.
  (.Lock (.-ringMu fr))
  (let [gens (.-ring fr)]
    (.Unlock (.-ringMu fr))

    ;; Write the header.
    (let [(values nw ^:assign err) (.Write w (subslice (.-header fr)))]
      (when (!= err nil)
        (return (conv int64 nw) err))

      (set! n + (conv int64 nw))

      ;; Write all the data.
      (range [_ gen gens]
        (range [_ data (.-batches gen)]
          ;; Write batch data.
          (set! (values nw err) (.Write w data))
          (set! n + (conv int64 nw))
          (when (!= err nil)
            (return n err))))



      (return n nil))))


(go/type FlightRecorderConfig (struct








    ^{:line 165 :tag time/Duration :doc "MinAge is a lower bound on the age of an event in the flight recorder's window.\n\nThe flight recorder will strive to promptly discard events older than the minimum age,\nbut older events may appear in the window snapshot. The age setting will always be\noverridden by MaxBytes.\n\nIf this is 0, the minimum age is implementation defined, but can be assumed to be on the order\nof seconds.\n"} MinAge









    ^{:line 175 :tag uint64 :doc "MaxBytes is an upper bound on the size of the window in bytes.\n\nThis setting takes precedence over MinAge.\nHowever, it does not make any guarantees on the size of the data WriteTo will write,\nnor does it guarantee memory overheads will always stay below MaxBytes. Treat it\nas a hint.\n\nIf this is 0, the maximum size is implementation defined.\n"} MaxBytes))



(go/func ^:extern ^{:go/linkname "runtime_traceClockUnitsPerSecond"} runtime_traceClockUnitsPerSecond ^uint64 [])


(go/func ^:extern ^{:go/linkname "runtime_traceAdvance runtime.traceAdvance"} runtime_traceAdvance [^bool stopTrace])

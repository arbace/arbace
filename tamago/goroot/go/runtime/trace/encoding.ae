(in-ns 'go.runtime.trace) (go/file "encoding.go" :imports [


    ^{:line 8} [errors "errors"]])



(go/const ^{:val 10 :doc "maxVarintLenN is the maximum length of a varint-encoded N-bit integer.\n"} maxVarintLen64 10)

(go/var
  ^{:line 15} [errOverflow (errors/New "binary: varint overflows a 64-bit integer")]
  ^{:line 16} [errEOB (errors/New "binary: end of buffer")])



^{:go/end 36} (go/func readUvarint "TODO deduplicate this function.\n" [^{:tag (slice byte)} b] :results [uint64 int error]
  (let [^uint64 x (zero uint64)
      ^{:line 22 :tag uint} s (zero uint)
      ^{:line 23 :tag byte} byt (zero byte)]
    (for [i 0] (and (< i maxVarintLen64) (< i (len b))) (inc! i)
      (set! byt (aget b i))
      (when (< byt 0x80)
        (when (and (== i (- maxVarintLen64 1)) (> byt 1))
          (return x i errOverflow))

        (return (bit-or x (<< (conv uint64 byt) s)) (+ i 1) nil))

      (set! x bit-or (<< (conv uint64 (bit-and byt 0x7f)) s))
      (set! s + 7))

    (return x (len b) errOverflow)))





^{:go/end 50} (go/func putUvarint "putUvarint encodes a uint64 into buf and returns the number of bytes written.\nIf the buffer is too small, PutUvarint will panic.\nTODO deduplicate this function.\n" ^int [^{:tag (slice byte)} buf ^uint64 x]
  (let [i 0]
    (while (>= x 0x80)
      (aset buf i (bit-or (conv byte x) 0x80))
      (set! x >> 7)
      (inc! i))

    (aset buf i (conv byte x))
    (+ i 1)))

;; Fake network poller for js/wasm.
;; Should never be used, because js/wasm network connections do not honor "SetNonblock".



(in-ns 'go.runtime) (go/file "netpoll_fake.go" :build ["//go:build (js && wasm) || tamago"] :imports [])

^{:go/end 13} (go/func netpollinit [])


^{:go/breaks [3] :go/end 17} (go/func netpollIsPollDescriptor ^bool [^uintptr fd]
  false)


^{:go/breaks [3] :go/end 21} (go/func netpollopen ^int32 [^uintptr fd ^{:tag (* pollDesc)} pd]
  0)


^{:go/breaks [3] :go/end 25} (go/func netpollclose ^int32 [^uintptr fd]
  0)


^{:go/end 28} (go/func netpollarm [^{:tag (* pollDesc)} pd ^int mode])


^{:go/end 31} (go/func netpollBreak [])


^{:go/end 35} (go/func netpoll [^int64 delay] :results [gList int32]
  (return (lit gList) 0))

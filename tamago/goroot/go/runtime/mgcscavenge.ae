^{:go/end 456} (go/method wake "wake immediately unparks the scavenger if necessary.\n\nSafe to run without a P.\n" [^{:tag (* scavengerState)} s]
  (lock (addr (.-lock s)))
  (when (.-parked s)
    ;; Unset sysmonWake, since the scavenger is now being awoken.
    (.Store (.-sysmonWake s) 0)

    ;; s.parked is unset to prevent a double wake-up.
    (set! (.-parked s) false)

    ;; Ready the goroutine by injecting it. We use injectglist instead
    ;; of ready or goready in order to allow us to run this function
    ;; without a P. injectglist also avoids placing the goroutine in
    ;; the current P's runnext slot, which is desirable to prevent
    ;; the scavenger from interfering with user goroutine scheduling
    ;; too much.
    (let [^gList list (zero gList)]
      (.push list (.-g s))
      (injectglist (addr list))))

  (unlock (addr (.-lock s))))










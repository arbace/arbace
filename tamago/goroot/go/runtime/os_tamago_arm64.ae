(in-ns 'go.runtime) (go/file "os_tamago_arm64.go" :build ["//go:build tamago && arm64"] :imports [])


^{:go/end 13} (go/func ^:go/nosplit cputicks ^int64 []
  ;; runtime·nanotime() is a poor approximation of CPU ticks that is enough for the profiler.
  (nanotime))

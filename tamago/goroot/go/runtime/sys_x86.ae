(in-ns 'go.runtime) (go/file "sys_x86.go" :build ["//go:build amd64 || 386"] :imports [


    ^{:line 10} [goarch "internal/goarch"]
    ^{:line 11} [unsafe "unsafe"]])




^{:go/end 23} (go/func gostartcall "adjust Gobuf as if it executed a call to fn with context ctxt\nand then stopped before the first instruction in fn.\n" [^{:tag (* gobuf)} buf ^unsafe/Pointer fn ^unsafe/Pointer ctxt]
  (let [sp (.-sp buf)]
    (set! sp - goarch/PtrSize)
    (set! @(conv (* uintptr) (conv unsafe/Pointer sp)) (.-pc buf))
    (set! (.-sp buf) sp)
    (set! (.-pc buf) (conv uintptr fn))
    (set! (.-ctxt buf) ctxt)))

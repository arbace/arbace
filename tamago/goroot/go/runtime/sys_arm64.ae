(in-ns 'go.runtime) (go/file "sys_arm64.go" :imports [

    ^{:line 7} [unsafe "unsafe"]])



^{:go/end 18} (go/func gostartcall "adjust Gobuf as if it executed a call to fn with context ctxt\nand then did an immediate Gosave.\n" [^{:tag (* gobuf)} buf ^unsafe/Pointer fn ^unsafe/Pointer ctxt]
  (when (!= (.-lr buf) 0)
    (throw "invalid use of gostartcall"))

  (set! (.-lr buf) (.-pc buf))
  (set! (.-pc buf) (conv uintptr fn))
  (set! (.-ctxt buf) ctxt))

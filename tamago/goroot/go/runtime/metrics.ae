(ns go.runtime.metrics
  (:require [arbace.go :as go]))

(go/package metrics
  :path "runtime/metrics"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["description.go" "doc.go" "histogram.go" "sample.go" "value.go"]
  :init-order [allDesc]
  :positions :lines)

(load "metrics/description")
(load "metrics/doc")
(load "metrics/histogram")
(load "metrics/sample")
(load "metrics/value")

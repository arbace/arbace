  (when goexperiment/CgoCheck2
    (cgoCheckPtrWrite ptr new))

  (sync_atomic_StoreUintptr (conv (* uintptr) (conv unsafe/Pointer ptr)) (conv uintptr new)))



(go/func ^:extern ^{:go/linkname "sync_atomic_SwapUintptr sync/atomic.SwapUintptr"} sync_atomic_SwapUintptr ^uintptr [^{:tag (* uintptr)} ptr ^uintptr new])




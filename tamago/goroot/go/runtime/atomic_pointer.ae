;; These functions cannot have go:noescape annotations,
;; because while ptr does not escape, new does.
;; If new is marked as not escaping, the compiler will make incorrect
;; escape analysis decisions about the pointer value being stored.















^{:go/end 37} (go/func ^:go/nosplit ^{:go/linkname "atomicwb"} atomicwb "atomicwb performs a write barrier before an atomic pointer write.\nThe caller should guard the call with \"if writeBarrier.enabled\".\n\natomicwb should be an internal detail,\nbut widely used packages access it using linkname.\nNotable members of the hall of shame include:\n  - github.com/bytedance/gopkg\n  - github.com/songzhibin97/gkit\n\nDo not remove or change the type signature.\nSee go.dev/issue/67401.\n" [^{:tag (* unsafe/Pointer)} ptr ^unsafe/Pointer new]
  (let [slot (conv (* uintptr) (conv unsafe/Pointer ptr))
      ^{:line 34} buf (.get2 (.-wbBuf (.ptr (.-p (.-m (getg))))))]
    (aset buf 0 @slot)
    (aset buf 1 (conv uintptr new))))





^{:go/end 50} (go/func ^:go/nosplit atomicstorep "atomicstorep performs *ptr = new atomically and invokes a write barrier.\n" [^unsafe/Pointer ptr ^unsafe/Pointer new]
  (when (.-enabled writeBarrier)
    (atomicwb (conv (* unsafe/Pointer) ptr) new))

  (when goexperiment/CgoCheck2
    (cgoCheckPtrWrite (conv (* unsafe/Pointer) ptr) new))

  (atomic/StorepNoWB (noescape ptr) new))







^{:go/end 59} (go/func ^:go/nosplit ^{:go/linkname "atomic_storePointer internal/runtime/atomic.storePointer"} atomic_storePointer "atomic_storePointer is the implementation of internal/runtime/atomic.UnsafePointer.Store\n(like StoreNoWB but with the write barrier).\n" [^{:tag (* unsafe/Pointer)} ptr ^unsafe/Pointer new]
  (atomicstorep (conv unsafe/Pointer ptr) new))







^{:go/end 74} (go/func ^:go/nosplit ^{:go/linkname "atomic_casPointer internal/runtime/atomic.casPointer"} atomic_casPointer "atomic_casPointer is the implementation of internal/runtime/atomic.UnsafePointer.CompareAndSwap\n(like CompareAndSwapNoWB but with the write barrier).\n" ^bool [^{:tag (* unsafe/Pointer)} ptr ^unsafe/Pointer old ^unsafe/Pointer new]
  (when (.-enabled writeBarrier)
    (atomicwb ptr new))

  (when goexperiment/CgoCheck2
    (cgoCheckPtrWrite ptr new))

  (atomic/Casp1 ptr old new))


;; Like above, but implement in terms of sync/atomic's uintptr operations.
;; We cannot just call the runtime routines, because the race detector expects
;; to be able to intercept the sync/atomic forms but not the runtime forms.


(go/func ^:extern ^{:go/linkname "sync_atomic_StoreUintptr sync/atomic.StoreUintptr"} sync_atomic_StoreUintptr [^{:tag (* uintptr)} ptr ^uintptr new])



^{:go/end 93} (go/func ^:go/nosplit ^{:go/linkname "sync_atomic_StorePointer sync/atomic.StorePointer"} sync_atomic_StorePointer [^{:tag (* unsafe/Pointer)} ptr ^unsafe/Pointer new]

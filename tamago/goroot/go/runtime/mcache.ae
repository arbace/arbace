    ^{:line 25 :tag int64 :doc "The following members are accessed on every malloc,\nso they are grouped here for better caching.\n"} nextSample ; trigger heap sample after allocating this many bytes
    ^{:line 26 :tag int} memProfRate ; cached mem profile rate, used to detect changes
    ^{:line 27 :tag uintptr} scanAlloc ; bytes of scannable heap allocated

    ;; Allocator cache for tiny objects w/o pointers.
    ;; See "Tiny allocator" comment in malloc.go.










    ^{:line 41 :tag uintptr :doc "tiny points to the beginning of the current tiny block, or\nnil if there is no current tiny block.\n\ntiny is a heap pointer. Since mcache is in non-GC'd memory,\nwe handle it by clearing it in releaseAll during mark\ntermination.\n\ntinyAllocs is the number of tiny allocations performed\nby the P that owns this mcache.\n"} tiny
    ^{:line 42 :tag uintptr} tinyoffset
    ^{:line 43 :tag uintptr} tinyAllocs

    ;; The rest is not accessed on every malloc.


    ^{:line 48 :tag (array numSpanClasses (* mspan)) :doc "alloc contains spans to allocate from, indexed by spanClass.\n"} alloc

    ;; TODO(thepudds): better to interleave alloc and reusableScan/reusableNoscan so that

^{:go/end 239} (go/method refill "refill acquires a new span of span class spc for c. This span will\nhave at least one free object. The current span in c must be full.\n\nMust run in a non-preemptible context since otherwise the owner of\nc could change.\n" [^{:tag (* mcache)} c ^spanClass spc]
  ;; Return the current cached span to the central lists.
  (let [s (aget (.-alloc c) spc)]

    (when (!= (.-allocCount s) (.-nelems s))
      (throw "refill of span with free space remaining"))


    ;; TODO(thepudds): we might be able to allow mallocgcTiny to reuse 16 byte objects from spc==5,
    ;; but for now, just clear our reusable objects for tinySpanClass.
    (when (== spc tinySpanClass)
      (aset (.-reusableNoscan c) spc 0))

    (when (!= (aget (.-reusableNoscan c) spc) 0)
      (throw "refill of span with reusable pointers remaining on pointer free list"))


    (when (!= s (addr emptymspan))
      ;; Mark this span as no longer cached.
      (when (!= (.-sweepgen s) (+ (.-sweepgen mheap_) 3))
        (throw "bad sweepgen in refill"))

      (.uncacheSpan (.-mcentral (aget (.-central mheap_) spc)) s)

      ;; Count up how many slots were used and record it.
      (let [stats (.acquire (.-heapStats memstats))
          ^{:line 186} slotsUsed (- (conv int64 (.-allocCount s)) (conv int64 (.-allocCountBeforeCache s)))]
        (atomic/Xadd64 (addr (aget (.-smallAllocCount stats) (.sizeclass spc))) slotsUsed)

        ;; Flush tinyAllocs.
        (when (== spc tinySpanClass)
          (atomic/Xadd64 (addr (.-tinyAllocCount stats)) (conv int64 (.-tinyAllocs c)))
          (set! (.-tinyAllocs c) 0))

        (.release (.-heapStats memstats))

        ;; Count the allocs in inconsistent, internal stats.
        (let [bytesAllocated (* slotsUsed (conv int64 (.-elemsize s)))]
          (.Add (.-totalAlloc gcController) bytesAllocated)

          ;; Clear the second allocCount just to be safe.
          (set! (.-allocCountBeforeCache s) 0))))


    ;; Get a new cached span from the central lists.
    (set! s (.cacheSpan (.-mcentral (aget (.-central mheap_) spc))))
    (when (== s nil)
      (throw "out of memory"))


    (when (== (.-allocCount s) (.-nelems s))
      (throw "span has no free space"))


    ;; Indicate that this span is cached and prevent asynchronous
    ;; sweeping in the next sweep phase.
    (set! (.-sweepgen s) (+ (.-sweepgen mheap_) 3))

    ;; Store the current alloc count for accounting later.
    (set! (.-allocCountBeforeCache s) (.-allocCount s))

    ;; Update heapLive and flush scanAlloc.
    ;;
    ;; We have not yet allocated anything new into the span, but we
    ;; assume that all of its slots will get used, so this makes
    ;; heapLive an overestimate.
    ;;
    ;; When the span gets uncached, we'll fix up this overestimate
    ;; if necessary (see releaseAll).
    ;;
    ;; We pick an overestimate here because an underestimate leads
    ;; the pacer to believe that it's in better shape than it is,
    ;; which appears to lead to more memory used. See #53738 for
    ;; more details.
    (let [usedBytes (* (conv uintptr (.-allocCount s)) (.-elemsize s))]
      (.update gcController (- (conv int64 (* (.-npages s) pageSize)) (conv int64 usedBytes)) (conv int64 (.-scanAlloc c)))
      (set! (.-scanAlloc c) 0)

      (aset (.-alloc c) spc s))))



^{:go/end 288} (go/method allocLarge "allocLarge allocates a span for a large object.\n" ^{:tag (* mspan)} [^{:tag (* mcache)} c ^uintptr size ^bool noscan]
  (when (< (+ size pageSize) size)
    (throw "out of memory"))

  (let [npages (>> size gc/PageShift)]
    (when (!= (bit-and size pageMask) 0)
      (inc! npages))


    ;; Deduct credit for this span allocation and sweep if
    ;; necessary. mHeap_Alloc will also sweep npages, so this only
    ;; pays the debt down to npage pages.
    (deductSweepCredit (* npages pageSize) npages)

    (let [spc (makeSpanClass 0 noscan)
        ^{:line 257} s (.alloc mheap_ npages spc)]
      (when (== s nil)
        (throw "out of memory"))


      ;; Count the alloc in consistent, external stats.
      (let [stats (.acquire (.-heapStats memstats))]
        (atomic/Xadd64 (addr (.-largeAlloc stats)) (conv int64 (* npages pageSize)))
        (atomic/Xadd64 (addr (.-largeAllocCount stats)) 1)
        (.release (.-heapStats memstats))

        ;; Count the alloc in inconsistent, internal stats.
        (.Add (.-totalAlloc gcController) (conv int64 (* npages pageSize)))

        ;; Update heapLive.
        (.update gcController (conv int64 (* (.-npages s) pageSize)) 0)

        ;; Put the large span in the mcentral swept list so that it's
        ;; visible to the background sweeper.
        (.push (.fullSwept (.-mcentral (aget (.-central mheap_) spc)) (.-sweepgen mheap_)) s)

        ;; Adjust s.limit down to the object-containing part of the span.
        ;;
        ;; This is just to create a slightly tighter bound on the limit.
        ;; It's totally OK if the garbage collector, in particular
        ;; conservative scanning, can temporarily observes an inflated
        ;; limit. It will simply mark the whole object or just skip it
        ;; since we're in the mark phase anyway.
        (set! (.-limit s) (+ (.base s) size))
        (.initHeapBits s)
        ^{:line 287} s))))


^{:go/end 345} (go/method releaseAll [^{:tag (* mcache)} c]
  ;; Take this opportunity to flush scanAlloc.
  (let [scanAlloc (conv int64 (.-scanAlloc c))]
    (set! (.-scanAlloc c) 0)

    (let [sg (.-sweepgen mheap_)
        ^{:line 296} dHeapLive (conv int64 0)]
      (range [i (.-alloc c)]
        (let [s (aget (.-alloc c) i)]
          (when (!= s (addr emptymspan))
            (let [slotsUsed (- (conv int64 (.-allocCount s)) (conv int64 (.-allocCountBeforeCache s)))]
              (set! (.-allocCountBeforeCache s) 0)

              ;; Adjust smallAllocCount for whatever was allocated.
              (let [stats (.acquire (.-heapStats memstats))]
                (atomic/Xadd64 (addr (aget (.-smallAllocCount stats) (.sizeclass (conv spanClass i)))) slotsUsed)
                (.release (.-heapStats memstats))

                ;; Adjust the actual allocs in inconsistent, internal stats.
                ;; We assumed earlier that the full span gets allocated.
                (.Add (.-totalAlloc gcController) (* slotsUsed (conv int64 (.-elemsize s))))

                (when (!= (.-sweepgen s) (+ sg 1))
                  ;; refill conservatively counted unallocated slots in gcController.heapLive.
                  ;; Undo this.
                  ;;
                  ;; If this span was cached before sweep, then gcController.heapLive was totally
                  ;; recomputed since caching this span, so we don't do this for stale spans.
                  (set! dHeapLive - (* (conv int64 (- (.-nelems s) (.-allocCount s))) (conv int64 (.-elemsize s)))))


                ;; Release the span to the mcentral.
                (.uncacheSpan (.-mcentral (aget (.-central mheap_) i)) s)
                (aset (.-alloc c) i (addr emptymspan)))))))


      ;; Clear tinyalloc pool.
      (set! (.-tiny c) 0)
      (set! (.-tinyoffset c) 0)

      ;; Flush tinyAllocs.
      (let [stats (.acquire (.-heapStats memstats))]
        (atomic/Xadd64 (addr (.-tinyAllocCount stats)) (conv int64 (.-tinyAllocs c)))
        (set! (.-tinyAllocs c) 0)
        (.release (.-heapStats memstats))

        ;; Clear the reusable linked lists.
        ;; For noscan objects, the nodes of the linked lists are the reusable heap objects themselves,
        ;; so we can simply clear the linked list head pointers.
        ;; TODO(thepudds): consider having debug logging of a non-empty reusable lists getting cleared,
        ;; maybe based on the existing debugReusableLog.
        (clear (subslice (.-reusableNoscan c)))

        ;; Update heapLive and heapScan.
        (.update gcController dHeapLive scanAlloc)))))





^{:go/end 369} (go/method prepareForSweep "prepareForSweep flushes c if the system has entered a new sweep phase\nsince c was populated. This must happen between the sweep phase\nstarting and the first allocation from c.\n" [^{:tag (* mcache)} c]
  ;; Alternatively, instead of making sure we do this on every P
  ;; between starting the world and allocating on that P, we
  ;; could leave allocate-black on, allow allocation to continue
  ;; as usual, use a ragged barrier at the beginning of sweep to
  ;; ensure all cached spans are swept, and then disable
  ;; allocate-black. However, with this approach it's difficult
  ;; to avoid spilling mark bits into the *next* GC cycle.
  (let [sg (.-sweepgen mheap_)
      ^{:line 359} flushGen (.Load (.-flushGen c))]
    (cond (== flushGen sg)
      (return)
      (!= flushGen (- sg 2)) (do
        (println "bad flushGen" flushGen "in prepareForSweep; sweepgen" sg)
        (throw "bad flushGen")))

    (.releaseAll c)
    (stackcache_clear c)
    (.Store (.-flushGen c) (.-sweepgen mheap_)))) ; Synchronizes with gcStart




^{:go/end 382} (go/method addReusableNoscan "addReusableNoscan adds a noscan object pointer to the reusable pointer free list\nfor a span class.\n" [^{:tag (* mcache)} c ^spanClass spc ^uintptr ptr]
  (when (not runtimeFreegcEnabled)
    (return))


  ;; Add to the reusable pointers free list.
  (let [v (conv gclinkptr ptr)]
    (set! (.-next (.ptr v)) (aget (.-reusableNoscan c) spc))
    (aset (.-reusableNoscan c) spc v)))




^{:go/end 391} (go/method hasReusableNoscan "hasReusableNoscan reports whether there is a reusable object available for\na noscan spc.\n" ^bool [^{:tag (* mcache)} c ^spanClass spc]
  (when (not runtimeFreegcEnabled)
    (return false))

  (!= (aget (.-reusableNoscan c) spc) 0))

^{:go/end 410} (go/func findBitRange64 "findBitRange64 returns the bit index of the first set of\nn consecutive 1 bits. If no consecutive set of 1 bits of\nsize n may be found in c, then it returns an integer >= 64.\nn must be > 0.\n" ^uint [^uint64 c ^uint n]
  ;; This implementation is based on shrinking the length of
  ;; runs of contiguous 1 bits. We remove the top n-1 1 bits
  ;; from each run of 1s, then look for the first remaining 1 bit.
  (let [p (- n 1) ; number of 1s we want to remove.
      ^{:line 389} k (conv uint 1)] ; current minimum width of runs of 0 in c.
    (while (> p 0)
      (when (<= p k)
        ;; Shift p 0s down into the top of each run of 1s.
        (set! c bit-and (>> c (bit-and p 63)))
        (break))

      ;; Shift k 0s down into the top of each run of 1s.
      (set! c bit-and (>> c (bit-and k 63)))
      (when (== c 0)
        (return 64))

      (set! p - k)
      ;; We've just doubled the minimum length of 0-runs.
      ;; This allows us to shift farther in the next iteration.
      (set! k * 2))

    ;; Find first remaining 1.
    ;; Since we shrunk from the top down, the first 1 is in
    ;; its correct original position.
    (conv uint (sys/TrailingZeros64 c))))









(go/type pallocData "pallocData encapsulates pallocBits and a bitmap for\nwhether or not a given page is scavenged in a single\nstructure. It's effectively a pallocBits with\nadditional functionality.\n\nUpdate the comment on (*pageAlloc).chunks should this\nstructure change.\n" (struct
    ^{:line 420} pallocBits
    ^{:line 421 :tag pageBits} scavenged))




^{:go/end 430} (go/method allocRange "allocRange sets bits [i, i+n) in the bitmap to 1 and\nupdates the scavenged bits appropriately.\n" [^{:tag (* pallocData)} m ^uint i ^uint n]
  ;; Clear the scavenged bits when we alloc the range.
  (.allocRange (.-pallocBits m) i n)
  (.clearRange (.-scavenged m) i n))




^{:go/end 438} (go/method allocAll "allocAll sets every bit in the bitmap to 1 and updates\nthe scavenged bits appropriately.\n" [^{:tag (* pallocData)} m]
  ;; Clear the scavenged bits when we alloc the range.
  (.allocAll (.-pallocBits m))
  (.clearAll (.-scavenged m)))

(in-ns 'go.runtime) (go/file "libinit.go" :build ["//go:build 386 || amd64 || arm || arm64 || loong64 || ppc64 || ppc64le || riscv64 || s390x"] :imports [


    ^{:line 10} [abi "internal/abi"]
    ^{:line 11} [unsafe "unsafe"]])







(go/var ^{:tag uintptr :doc "rt0LibGoFn holds the function pointer to rt0_lib_go suitable for thread\ncreation. On most platforms it is zero, meaning the raw code address should\nbe used. On AIX it is set by libpreinit to a function descriptor pointer,\nbecause pthread_create on AIX expects a function descriptor, not a raw\ncode address.\n"} rt0LibGoFn)








^{:go/end 48} (go/func ^:go/nosplit ^:go/nowritebarrierrec libInit "libInit is common startup code for most architectures when\nusing -buildmode=c-archive or -buildmode=c-shared.\n\nMay run with m.p==nil, so write barriers are not allowed.\n" []
  ;; Synchronous initialization.
  (libpreinit)

  ;; Use the platform-specific function pointer if set (e.g. AIX
  ;; function descriptor), otherwise fall back to the raw code address.
  (let [fn (conv unsafe/Pointer rt0LibGoFn)]
    (when (== fn nil)
      (set! fn (conv unsafe/Pointer (abi/FuncPCABIInternal rt0_lib_go))))


    ;; Asynchronous initialization.
    ;; Prefer creating a thread via cgo if it is available.
    (if (!= _cgo_sys_thread_create nil)
      ;; No g because the TLS is not set up until later in rt0_go.
      (asmcgocall_no_g _cgo_sys_thread_create fn)

      (let [^:const ^{:val 8388608} stackSize 0x800000] ; 8192KB
        (newosproc0 stackSize fn)))))

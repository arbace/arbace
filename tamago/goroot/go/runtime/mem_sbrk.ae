(go/const ^{:val true} isSbrkPlatform true)

(go/const ^{:val false} memDebug false)

;; Memory management on sbrk systems (including the linear memory
;; on Wasm).

;; bloc is the runtime's sense of the break, which can go up or
;; down. blocMax is the system's break, also the high water mark
;; of bloc. The runtime uses memory up to bloc. The memory
;; between bloc and blocMax is allocated by the OS but not used
;; by the runtime.
;;
;; When the runtime needs to grow the heap address range, it
;; increases bloc. When it needs to grow beyond blocMax, it calls
;; the system sbrk to allocate more memory (and therefore
;; increase blocMax).
;;
;; When the runtime frees memory at the end of the address space,
;; it decreases bloc, but does not reduces the system break (as
;; the OS doesn't support it). When the runtime frees memory in
;; the middle of the address space, the memory goes to a free
;; list.

(go/var ^uintptr bloc) ; The runtime's sense of break. Can go up or down.
(go/var ^uintptr blocMax) ; The break of the OS. Only increase.
(go/var ^mutex memlock)

(go/type memHdr (struct
    ^{:line 40 :tag memHdrPtr} next
    ^{:line 41 :tag uintptr} size))


(go/var ^memHdrPtr memFreelist) ; sorted in ascending order

(go/type memHdrPtr uintptr)

^{:go/end 48} (go/method ptr ^{:tag (* memHdr)} [^memHdrPtr p] (conv (* memHdr) (conv unsafe/Pointer p)))
^{:go/end 49} (go/method set [^{:tag (* memHdrPtr)} p ^{:tag (* memHdr)} x] (set! @p (conv memHdrPtr (conv unsafe/Pointer x))))











^{:go/end 66} (go/func ^:go/systemstack memAlloc "memAlloc allocates n bytes from the brk reservation, or if it's full,\nthe system.\n\nmemlock must be held.\n\nmemAlloc must be called on the system stack, otherwise a stack growth\ncould cause us to call back into it. Since memlock is held, that could\nlead to a self-deadlock.\n" ^unsafe/Pointer [^uintptr n]
  (when [p (memAllocNoGrow n)] (!= p nil)
    (return p))

  (sbrk n))











^{:go/end 98} (go/func ^:go/systemstack memAllocNoGrow "memAllocNoGrow attempts to allocate n bytes from the existing brk.\n\nmemlock must be held.\n\nmemAlloc must be called on the system stack, otherwise a stack growth\ncould cause us to call back into it. Since memlock is held, that could\nlead to a self-deadlock.\n" ^unsafe/Pointer [^uintptr n]
  (set! n (memRound n))
  ^{:go/breaks [[3 97]]} (let [^{:tag (* memHdr)} prevp (zero (* memHdr))]
    (for [p (.ptr memFreelist)] (!= p nil) (set! p (.ptr (.-next p)))
      (when (>= (.-size p) n)
        (if (== (.-size p) n)
          (if (!= prevp nil)
            (set! (.-next prevp) (.-next p))

            (set! memFreelist (.-next p)))

          (do
            (set! (.-size p) - n)
            (set! p (conv (* memHdr) (add (conv unsafe/Pointer p) (.-size p))))))

        (set! @p (lit memHdr))
        (return (conv unsafe/Pointer p)))

      (set! prevp p))

    nil))











^{:go/end 151} (go/func ^:go/systemstack memFree "memFree makes [ap, ap+n) available for reallocation by memAlloc.\n\nmemlock must be held.\n\nmemAlloc must be called on the system stack, otherwise a stack growth\ncould cause us to call back into it. Since memlock is held, that could\nlead to a self-deadlock.\n" [^unsafe/Pointer ap ^uintptr n]
  (set! n (memRound n))
  (memclrNoHeapPointers ap n)
  (let [bp (conv (* memHdr) ap)]
    (set! (.-size bp) n)
    (let [bpn (conv uintptr ap)]
      (when (== memFreelist 0)
        (set! (.-next bp) 0)
        (.set memFreelist bp)
        (return))

      (let [p (.ptr memFreelist)]
        (when (< bpn (conv uintptr (conv unsafe/Pointer p)))
          (.set memFreelist bp)
          (if (== (+ bpn (.-size bp)) (conv uintptr (conv unsafe/Pointer p))) (do
              (set! (.-size bp) + (.-size p))
              (set! (.-next bp) (.-next p))
              (set! @p (lit memHdr)))

            (.set (.-next bp) p))

          (return))

        (for [] (!= (.-next p) 0) (set! p (.ptr (.-next p)))
          (when (and (> bpn (conv uintptr (conv unsafe/Pointer p))) (< bpn (conv uintptr (conv unsafe/Pointer (.-next p)))))
            (break)))


        (if (== (+ bpn (.-size bp)) (conv uintptr (conv unsafe/Pointer (.-next p)))) (do
            (set! (.-size bp) + (.-size (.ptr (.-next p))))
            (set! (.-next bp) (.-next (.ptr (.-next p))))
            (set! @(.ptr (.-next p)) (lit memHdr)))

          (set! (.-next bp) (.-next p)))

        (if (== (+ (conv uintptr (conv unsafe/Pointer p)) (.-size p)) bpn) (do
            (set! (.-size p) + (.-size bp))
            (set! (.-next p) (.-next bp))
            (set! @bp (lit memHdr)))

          (.set (.-next p) bp))))))












^{:go/end 186} (go/func ^:go/systemstack memCheck "memCheck checks invariants around free list management.\n\nmemlock must be held.\n\nmemAlloc must be called on the system stack, otherwise a stack growth\ncould cause us to call back into it. Since memlock is held, that could\nlead to a self-deadlock.\n" []
  (when (not memDebug)
    (return))

  (for [p (.ptr memFreelist)] (and (!= p nil) (!= (.-next p) 0)) (set! p (.ptr (.-next p)))
    (when (== (conv uintptr (conv unsafe/Pointer p)) (conv uintptr (conv unsafe/Pointer (.-next p))))
      (print "runtime: " (conv unsafe/Pointer p) " == " (conv unsafe/Pointer (.-next p)) "\n")
      (throw "mem: infinite loop"))

    (when (> (conv uintptr (conv unsafe/Pointer p)) (conv uintptr (conv unsafe/Pointer (.-next p))))
      (print "runtime: " (conv unsafe/Pointer p) " > " (conv unsafe/Pointer (.-next p)) "\n")
      (throw "mem: unordered list"))

    (when (> (+ (conv uintptr (conv unsafe/Pointer p)) (.-size p)) (conv uintptr (conv unsafe/Pointer (.-next p))))

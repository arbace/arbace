^{:go/end 266} (go/func sysReserveOS ^unsafe/Pointer [^unsafe/Pointer v ^uintptr n ^string _]
  (let [^uintptr p (zero uintptr)]
    (systemstack ^{:go/end 264} (fn []
        (lock (addr memlock))
        (when (== (conv uintptr v) bloc)
          ;; Address hint is the current end of memory,
          ;; so try to extend the address space.
          (set! p (conv uintptr (sbrk n))))

        (when (and (== p 0) (== v nil))
          (set! p (conv uintptr (memAlloc n)))
          (memCheck))

        (unlock (addr memlock))))

    (conv unsafe/Pointer p)))


^{:go/end 302} (go/func sysReserveAlignedSbrk [^uintptr size ^uintptr align] :results [unsafe/Pointer uintptr]
  (let [^uintptr p (zero uintptr)]
    (systemstack ^{:go/end 300} (fn []
        (lock (addr memlock))
        (when [base (memAllocNoGrow (+ size align))] (!= base nil)
          ;; We can satisfy the reservation from the free list.
          ;; Trim off the unaligned parts.
          (let [start (alignUp (conv uintptr base) align)]
            (when [startLen (- start (conv uintptr base))] (> startLen 0)
              (memFree base startLen))

            (let [end (+ start size)]
              (when [endLen (- (+ (conv uintptr base) size align) end)] (> endLen 0)
                (memFree (conv unsafe/Pointer end) endLen))

              (memCheck)
              (unlock (addr memlock))
              (set! p start)
              (return))))


        ;; Round up bloc to align, then allocate size.
        (set! p (alignUp bloc align))
        (let [r (sbrk (- (+ p size) bloc))]
          (if (== r nil)
            (set! (values p size) (values 0 0))
            (when [l (- p (conv uintptr r))] (> l 0)
              ;; Free the area we skipped over for alignment.
              (memFree r l)
              (memCheck)))

          (unlock (addr memlock)))))

    (return (conv unsafe/Pointer p) size)))



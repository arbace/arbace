      (throw "mem: overlapping blocks"))

    (for [b (add (conv unsafe/Pointer p) (unsafe/Sizeof (lit memHdr)))] (< (conv uintptr b) (+ (conv uintptr (conv unsafe/Pointer p)) (.-size p))) (set! b (add b 1))
      (when (!= @(conv (* byte) b) 0)
        (print "runtime: value at addr " b " with offset " (- (conv uintptr b) (conv uintptr (conv unsafe/Pointer p))) " in block " p " of size " (.-size p) " is not zero\n")
        (throw "mem: uninitialised memory")))))





^{:go/end 190} (go/func memRound ^uintptr [^uintptr p]
  (alignUp p physPageSize))


^{:go/end 195} (go/func initBloc []
  (set! bloc (memRound (.-end firstmoduledata)))
  (set! blocMax bloc))


^{:go/end 206} (go/func sysAllocOS ^unsafe/Pointer [^uintptr n ^string _]
  (let [^uintptr p (zero uintptr)]
    (systemstack ^{:go/end 204} (fn []
        (lock (addr memlock))
        (set! p (conv uintptr (memAlloc n)))
        (memCheck)
        (unlock (addr memlock))))

    (conv unsafe/Pointer p)))


^{:go/end 227} (go/func sysFreeOS [^unsafe/Pointer v ^uintptr n]
  (when (== v nil)
    ;; A failed sysReserveOS returns nil, so freeing it is a no-op.
    (return))

  (systemstack ^{:go/end 226} (fn []
      (lock (addr memlock))
      (if (== (+ (conv uintptr v) n) bloc) (do
          ;; Address range being freed is at the end of memory,
          ;; so record a new lower value for end of memory.
          ;; Can't actually shrink address space because segment is shared.
          (memclrNoHeapPointers v n)
          (set! bloc - n))
        (do
          (memFree v n)
          (memCheck)))

      (unlock (addr memlock)))))




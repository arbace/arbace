^{:go/end 230} (go/method putPtr "Add p as a potential pointer to a stack object.\np must be a stack address.\n" [^{:tag (* stackScanState)} s ^uintptr p ^bool conservative]
  (when (or (< p (.-lo (.-stack s))) (>= p (.-hi (.-stack s))))
    (throw "address not a stack address"))

  (let [head (addr (.-buf s))]
    (when conservative
      (set! head (addr (.-cbuf s))))

    (let [buf @head]
      (cond (== buf nil) (do
          ;; Initial setup.
          (set! buf (conv (* stackWorkBuf) (conv unsafe/Pointer (getempty))))
          (set! ^{:go/via [stackWorkBufHdr workbufhdr]} (.-nobj buf) 0)
          (set! ^{:go/via [stackWorkBufHdr]} (.-next buf) nil)
          (set! @head buf))
        (== ^{:go/via [stackWorkBufHdr workbufhdr]} (.-nobj buf) (len (.-obj buf))) (do
          (if (!= (.-freeBuf s) nil) (do
              (set! buf (.-freeBuf s))
              (set! (.-freeBuf s) nil))

            (set! buf (conv (* stackWorkBuf) (conv unsafe/Pointer (getempty)))))

          (set! ^{:go/via [stackWorkBufHdr workbufhdr]} (.-nobj buf) 0)
          (set! ^{:go/via [stackWorkBufHdr]} (.-next buf) @head)
          (set! @head buf)))

      (aset (.-obj buf) ^{:go/via [stackWorkBufHdr workbufhdr]} (.-nobj buf) p)
      (inc! ^{:go/via [stackWorkBufHdr workbufhdr]} (.-nobj buf)))))







^{:go/end 267} (go/method getPtr "Remove and return a potential pointer to a stack object.\nReturns 0 if there are no more pointers available.\n\nThis prefers non-conservative pointers so we scan stack objects\nprecisely if there are any non-conservative pointers to them.\n" [^{:tag (* stackScanState)} s] :results [^uintptr p ^bool conservative]
  (range [_ head (lit (slice (* (* stackWorkBuf))) (addr (.-buf s)) (addr (.-cbuf s)))]
    (let [buf @head]
      (when (== buf nil)
        ;; Never had any data.
        (continue))

      (when (== ^{:go/via [stackWorkBufHdr workbufhdr]} (.-nobj buf) 0)
        (when (!= (.-freeBuf s) nil)
          ;; Free old freeBuf.
          (putempty (conv (* workbuf) (conv unsafe/Pointer (.-freeBuf s)))))

        ;; Move buf to the freeBuf.
        (set! (.-freeBuf s) buf)
        (set! buf ^{:go/via [stackWorkBufHdr]} (.-next buf))
        (set! @head buf)
        (when (== buf nil)
          ;; No more data in this list.
          (continue)))


      (dec! ^{:go/via [stackWorkBufHdr workbufhdr]} (.-nobj buf))
      (return (aget (.-obj buf) ^{:go/via [stackWorkBufHdr workbufhdr]} (.-nobj buf)) (== head (addr (.-cbuf s))))))

  ;; No more data in either list.
  (when (!= (.-freeBuf s) nil)
    (putempty (conv (* workbuf) (conv unsafe/Pointer (.-freeBuf s))))
    (set! (.-freeBuf s) nil))

  (return 0 false))




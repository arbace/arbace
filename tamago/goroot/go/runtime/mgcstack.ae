      (set! (.-tail s) x))

    (when (and (> ^{:go/via [stackObjectBufHdr workbufhdr]} (.-nobj x) 0) (< (conv uint32 (- addr (.-lo (.-stack s)))) (+ (.-off (aget (.-obj x) (- ^{:go/via [stackObjectBufHdr workbufhdr]} (.-nobj x) 1))) (.-size (aget (.-obj x) (- ^{:go/via [stackObjectBufHdr workbufhdr]} (.-nobj x) 1))))))

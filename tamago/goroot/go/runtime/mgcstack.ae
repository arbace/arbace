^{:go/end 327} (go/func binarySearchTree "Build a binary search tree with the n objects in the list\nx.obj[idx], x.obj[idx+1], ..., x.next.obj[0], ...\nReturns the root of that tree, and the buf+idx of the nth object after x.obj[idx].\n(The first object that was not included in the binary search tree.)\nIf n == 0, returns nil, x.\n" [^{:tag (* stackObjectBuf)} x ^int idx ^int n] :results [^{:tag (* stackObject)} root ^{:tag (* stackObjectBuf)} restBuf ^int restIdx]
  (when (== n 0)
    (return nil x idx))

  (let [(values ^{:tag (* stackObject)} left ^{:tag (* stackObject)} right) (zero (* stackObject))]
    (set! (values left x idx) (binarySearchTree x idx (/ n 2)))
    (set! root (addr (aget (.-obj x) idx)))
    (inc! idx)
    (when (== idx (len (.-obj x)))
      (set! x ^{:go/via [stackObjectBufHdr]} (.-next x))
      (set! idx 0))

    (set! (values right x idx) (binarySearchTree x idx (- n (/ n 2) 1)))
    (set! (.-left root) left)
    (set! (.-right root) right)
    (return root x idx)))




^{:go/end 348} (go/method findObject "findObject returns the stack object containing address a, if any.\nMust have called buildIndex previously.\n" ^{:tag (* stackObject)} [^{:tag (* stackScanState)} s ^uintptr a]
  (let [off (conv uint32 (- a (.-lo (.-stack s))))
      ^{:line 333} obj (.-root s)]
    (while true
      (when (== obj nil)
        (return nil))

      (when (< off (.-off obj))
        (set! obj (.-left obj))
        (continue))

      (when (>= off (+ (.-off obj) (.-size obj)))
        (set! obj (.-right obj))
        (continue))

      (return obj))))

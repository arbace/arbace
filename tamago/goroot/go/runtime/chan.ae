            (continue)))



        (return sgp)))))



^{:go/end 914} (go/method raceaddr ^unsafe/Pointer [^{:tag (* hchan)} c]
  ;; Treat read-like and write-like operations on the channel to
  ;; happen at this address. Avoid using the address of qcount
  ;; or dataqsiz, because the len() and cap() builtins read
  ;; those addresses, and we don't want them racing with
  ;; operations like close().
  (conv unsafe/Pointer (addr (.-buf c))))


^{:go/end 921} (go/func racesync [^{:tag (* hchan)} c ^{:tag (* sudog)} sg]
  (racerelease (chanbuf c 0))
  (raceacquireg (.-g sg) (chanbuf c 0))
  (racereleaseg (.-g sg) (chanbuf c 0))
  (raceacquire (chanbuf c 0)))





^{:go/end 956} (go/func racenotify "Notify the race detector of a send or receive involving buffer entry idx\nand a channel c or its communicating partner sg.\nThis function handles the special case of c.elemsize==0.\n" [^{:tag (* hchan)} c ^uint idx ^{:tag (* sudog)} sg]
  ;; We could have passed the unsafe.Pointer corresponding to entry idx
  ;; instead of idx itself.  However, in a future version of this function,
  ;; we can use idx to better handle the case of elemsize==0.
  ;; A future improvement to the detector is to call TSan with c and idx:
  ;; this way, Go will continue to not allocating buffer entries for channels
  ;; of elemsize==0, yet the race detector can be made to handle multiple
  ;; sync objects underneath the hood (one sync object per idx)
  (let [qp (chanbuf c idx)]
    ;; When elemsize==0, we don't allocate a full buffer for the channel.
    ;; Instead of individual buffer entries, the race detector uses the
    ;; c.buf as the only buffer entry.  This simplification prevents us from
    ;; following the memory model's happens-before rules (rules that are
    ;; implemented in racereleaseacquire).  Instead, we accumulate happens-before
    ;; information in the synchronization object associated with c.buf.
    (if (== (.-elemsize c) 0)
      (if (== sg nil) (do
          (raceacquire qp)
          (racerelease qp))
        (do
          (raceacquireg (.-g sg) qp)
          (racereleaseg (.-g sg) qp)))

      (do
        (if (== sg nil)
          (racereleaseacquire qp)

          (racereleaseacquireg (.-g sg) qp))))))

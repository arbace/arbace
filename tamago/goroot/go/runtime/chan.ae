^{:go/end 870} (go/method enqueue [^{:tag (* waitq)} q ^{:tag (* sudog)} sgp]
  (set! (.-next sgp) nil)
  (let [x (.-last q)]
    (when (== x nil)
      (set! (.-prev sgp) nil)
      (set! (.-first q) sgp)
      (set! (.-last q) sgp)
      (return))

    (set! (.-prev sgp) x)
    (set! (.-next x) sgp)
    (set! (.-last q) sgp)))


^{:go/end 905} (go/method dequeue ^{:tag (* sudog)} [^{:tag (* waitq)} q]
  (while true
    (let [sgp (.-first q)]
      (when (== sgp nil)
        (return nil))

      (let [y (.-next sgp)]
        (if (== y nil) (do
            (set! (.-first q) nil)
            (set! (.-last q) nil))
          (do
            (set! (.-prev y) nil)
            (set! (.-first q) y)
            (set! (.-next sgp) nil))) ; mark as removed (see dequeueSudoG)


        ;; if a goroutine was put on this queue because of a
        ;; select, there is a small window between the goroutine
        ;; being woken up by a different case and it grabbing the
        ;; channel locks. Once it has the lock
        ;; it removes itself from the queue, so we won't see it after that.

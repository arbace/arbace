^{:go/end 746} (go/func recv "recv processes a receive operation on a full channel c.\nThere are 2 parts:\n 1. The value sent by the sender sg is put into the channel\n    and the sender is woken up to go on its merry way.\n 2. The value received by the receiver (the current G) is\n    written to ep.\n\nFor synchronous channels, both values are the same.\nFor asynchronous channels, the receiver gets its data from\nthe channel buffer and the sender's data is put in the\nchannel buffer.\nChannel c must be full and locked. recv unlocks c with unlockf.\nsg must already be dequeued from c.\nA non-nil ep must point to the heap or the caller's stack.\n" [^{:tag (* hchan)} c ^{:tag (* sudog)} sg ^unsafe/Pointer ep ^{:tag (func [])} unlockf ^int skip]
  (when (and (!= (.-bubble c) nil) (!= (.-bubble (getg)) (.-bubble c)))
    (unlockf)
    (fatal "receive on synctest channel from outside bubble"))

  (if (== (.-dataqsiz c) 0) (do
      (when raceenabled
        (racesync c sg))

      (when (!= ep nil)
        ;; copy data from sender
        (recvDirect (.-elemtype c) sg ep)))


    ;; Queue is full. Take the item at the
    ;; head of the queue. Make the sender enqueue
    ;; its item at the tail of the queue. Since the
    ;; queue is full, those are both the same slot.
    (let [qp (chanbuf c (.-recvx c))]
      (when raceenabled
        (racenotify c (.-recvx c) nil)
        (racenotify c (.-recvx c) sg))

      ;; copy data from queue to receiver
      (when (!= ep nil)
        (typedmemmove (.-elemtype c) ep qp))

      ;; copy data from sender to queue
      (typedmemmove (.-elemtype c) qp (.get (.-elem sg)))
      (inc! (.-recvx c))
      (when (== (.-recvx c) (.-dataqsiz c))
        (set! (.-recvx c) 0))

      (set! (.-sendx c) (.-recvx c)))) ; c.sendx = (c.sendx+1) % c.dataqsiz

  (.set (.-elem sg) nil)
  (let [gp (.-g sg)]
    (unlockf)
    (set! (.-param gp) (conv unsafe/Pointer sg))
    (set! (.-success sg) true)
    (when (!= (.-releasetime sg) 0)
      (set! (.-releasetime sg) (cputicks)))

    (goready gp (+ skip 1))))


^{:go/breaks [6] :go/end 766} (go/func chanparkcommit ^bool [^{:tag (* g)} gp ^unsafe/Pointer chanLock]
  ;; There are unlocked sudogs that point into gp's stack. Stack
  ;; copying must lock the channels of those sudogs.
  ;; Set activeStackChans here instead of before we try parking
  ;; because we could self-deadlock in stack growth on the
  ;; channel lock.
  (set! (.-activeStackChans gp) true)
  ;; Mark that it's safe for stack shrinking to occur now,
  ;; because any thread acquiring this G's stack for shrinking
  ;; is guaranteed to observe activeStackChans after this store.
  (.Store (.-parkingOnChan gp) false)
  ;; Make sure we unlock after setting activeStackChans and
  ;; unsetting parkingOnChan. The moment we unlock chanLock
  ;; we risk gp getting readied by a channel operation and
  ;; so gp could continue running before everything before
  ;; the unlock is visible (even to gp itself).
  (unlock (conv (* mutex) chanLock))
  true)



















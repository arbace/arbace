(in-ns 'go.runtime) (go/file "cpuflags_arm64.go" :imports [


    ^{:line 8} [cpu "internal/cpu"]])


(go/var ^bool arm64UseAlignedLoads)

^{:go/end 17} (go/func init []
  (when (.-IsNeoverse cpu/ARM64)
    (set! arm64UseAlignedLoads true)))

              (casgstatus gnext _Grunnable _Grunning))


            ;; Donate locked state.
            (when locked
              (.set (.-lockedg mp) gnext)
              (.set (.-lockedm gnext) mp))


            ;; Release the trace locker. We've completed all the necessary transitions..
            (when (.ok trace)
              (traceRelease trace))


            (when (!= bubble nil)
              (.decActive bubble))


            ;; Switch to gnext. Does not return.
            (gogo (addr (.-sched gnext)))))))))

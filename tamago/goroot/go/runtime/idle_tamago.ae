(in-ns 'go.runtime) (go/file "idle_tamago.go" :build ["//go:build tamago"] :imports [


    ^{:line 10} [goos "runtime/goos"]])





^{:go/end 27} (go/func ^:go/yeswritebarrierrec beforeIdle "beforeIdle gets called by the scheduler if no goroutine is awake.\n" [^int64 now ^int64 pollUntil] :results [^{:tag (* g)} gp ^bool otherReady]
  (when (!= goos/Idle nil)
    (goos/Idle pollUntil))


  (when (> now 0)
    (.Add (.-idleTime sched) (- (nanotime) now)))


  ;; always return otherReady to ensure that no M is ever dropped
  (return nil true))


^{:go/end 29} (go/func checkTimeouts [])

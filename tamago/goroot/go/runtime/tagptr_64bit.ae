(in-ns 'go.runtime) (go/file "tagptr_64bit.go" :build ["//go:build amd64 || arm64 || loong64 || mips64 || mips64le || ppc64 || ppc64le || riscv64 || s390x || wasm"] :imports [


    ^{:line 10} [goarch "internal/goarch"]
    ^{:line 11} [goos "internal/goos"]
    ^{:line 12} [unsafe "unsafe"]])


(go/const



















  ^{:line 35} [^{:val 49 :doc "addrBits is the number of bits needed to represent a virtual address.\n\nSee heapAddrBits for a table of address space sizes on\nvarious architectures. 48 bits is enough for all\narch/os combos except s390x, aix, and riscv64.\n\nOn AMD64, virtual addresses are 48-bit (or 57-bit) sign-extended.\nOther archs are 48-bit zero-extended.\n\nWe use one extra bit to placate systems which simulate amd64 binaries on\nan arm64 host. Allocated arm64 addresses could be as high as 1<<48-1,\nwhich would be invalid if we assumed 48-bit sign-extended addresses.\nSee issue 69255.\n(Note that this does not help the other way around, simluating arm64\non amd64, but we don't have that problem at the moment.)\n\nOn s390x, virtual addresses are 64-bit. There's not much we\ncan do about this, so we just hope that the kernel doesn't\nget to really high addresses and panic if it does.\n"} defaultAddrBits (+ 48 1)]






  ^{:line 42} [^{:val 57 :doc "On AIX, 64-bit addresses are split into 36-bit segment number and 28-bit\noffset in segment.  Segment numbers in the range 0x0A0000000-0x0AFFFFFFF(LSA)\nare available for mmap.\nWe assume all tagged addresses are from memory allocated with mmap.\nWe use one bit to distinguish between the two ranges.\n"} aixAddrBits 57]


  ^{:line 45} [^{:val 57 :doc "Later versions of FreeBSD enable amd64's la57 by default.\n"} freebsdAmd64AddrBits 57]





  ^{:line 51} [^{:val 56 :doc "riscv64 SV57 mode gives 56 bits of userspace VA.\ntagged pointer code supports it,\nbut broader support for SV57 mode is incomplete,\nand there may be other issues (see #54104).\n"} riscv64AddrBits 56]

  ^{:line 53} [^{:val 49} addrBits (+ (* goos/IsAix aixAddrBits) (* goarch/IsRiscv64 riscv64AddrBits) (* goos/IsFreebsd goarch/IsAmd64 freebsdAmd64AddrBits) (* (- 1 goos/IsAix) (- 1 goarch/IsRiscv64) (- 1 (* goos/IsFreebsd goarch/IsAmd64)) defaultAddrBits))]




  ^{:line 58} [^{:val 24 :doc "In addition to the 16 bits (or other, depending on arch/os) taken from the top,\nwe can take 9 from the bottom, because we require pointers to be well-aligned\n(see tagptr.go:tagAlignBits). That gives us a total of 25 bits for the tag.\n"} tagBits (+ (- 64 addrBits) tagAlignBits)])




^{:go/end 70} (go/func taggedPointerPack "taggedPointerPack created a taggedPointer from a pointer and a tag.\nTag bits that don't fit in the result are discarded.\n" ^taggedPointer [^unsafe/Pointer ptr ^uintptr tag]
  (let [t (conv taggedPointer (bit-or (<< (conv uint64 (conv uintptr ptr)) (- tagBits tagAlignBits)) (conv uint64 (bit-and tag (- (<< 1 tagBits) 1)))))]
    (when (or (!= (.pointer t) ptr) (!= (.tag t) tag))
      (print "runtime: taggedPointerPack invalid packing: ptr=" ptr " tag=" (conv hex tag) " packed=" (conv hex t) " -> ptr=" (.pointer t) " tag=" (conv hex (.tag t)) "\n")
      (throw "taggedPointerPack"))

    ^{:line 69} t))



^{:go/end 83} (go/method pointer "Pointer returns the pointer from a taggedPointer.\n" ^unsafe/Pointer [^taggedPointer tp]
  (when (== GOARCH "amd64")
    ;; amd64 systems can place the stack above the VA hole, so we need to sign extend
    ;; val before unpacking.
    (return (conv unsafe/Pointer (conv uintptr (<< (>> (conv int64 tp) tagBits) tagAlignBits)))))

  (when (== GOOS "aix")
    (return (conv unsafe/Pointer (conv uintptr (bit-or (<< (>> tp tagBits) tagAlignBits) (<< 0xa 56))))))

  (conv unsafe/Pointer (conv uintptr (<< (>> tp tagBits) tagAlignBits))))



^{:go/end 88} (go/method tag "Tag returns the tag from a taggedPointer.\n" ^uintptr [^taggedPointer tp]
  (conv uintptr (bit-and tp (- (<< 1 tagBits) 1))))

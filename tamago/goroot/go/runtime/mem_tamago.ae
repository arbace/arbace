(in-ns 'go.runtime) (go/file "mem_tamago.go" :imports [

    ^{:line 7} [unsafe "unsafe"]])

^{:go/end 24} (go/func sbrk ^unsafe/Pointer [^uintptr n]
  ;; Plan 9 sbrk from /sys/src/libc/9sys/sbrk.c
  (let [bl bloc]
    (set! n (memRound n))
    (when (> (+ bl n) blocMax)
      ;; Stop at stack top address
      (if (> (+ bl n) (conv uintptr (.-lo (.-stack g0))))
        (return nil)

        (memclrNoHeapPointers (conv unsafe/Pointer bl) n))

      (set! blocMax (+ bl n)))

    (set! bloc + n)
    (conv unsafe/Pointer bl)))

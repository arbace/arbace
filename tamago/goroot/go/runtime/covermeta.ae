(in-ns 'go.runtime) (go/file "covermeta.go" :imports [


    ^{:line 8} [rtcov "internal/coverage/rtcov"]
    ^{:line 9} [unsafe "unsafe"]])




^{:go/end 20} (go/func addCovMeta "The compiler emits calls to runtime.addCovMeta\nbut this code has moved to rtcov.AddMeta.\n" ^uint32 [^unsafe/Pointer p ^uint32 dlen ^{:tag (array 16 byte)} hash ^string pkgpath ^int pkgid ^uint8 cmode ^uint8 cgran]
  (let [id (rtcov/AddMeta p dlen hash pkgpath pkgid cmode cgran)]
    (when (== id 0)
      (throw "runtime.addCovMeta: coverage package map collision"))

    ^{:line 19} id))

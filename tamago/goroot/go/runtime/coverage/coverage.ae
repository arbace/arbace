;; Package coverage contains APIs for writing coverage profile data at runtime
;; from long-running and/or server programs that do not terminate via [os.Exit].
(in-ns 'go.runtime.coverage) (go/file "coverage.go" :doc "Package coverage contains APIs for writing coverage profile data at runtime\nfrom long-running and/or server programs that do not terminate via [os.Exit].\n" :imports [


    ^{:line 10} [cfile "internal/coverage/cfile"]
    ^{:line 11} [io "io"]])




^{:go/end 18} (go/func initHook "initHook is invoked from main.init in programs built with -cover.\nThe call is emitted by the compiler.\n" [^bool istest]
  (cfile/InitHook istest))







^{:go/end 27} (go/func WriteMetaDir "WriteMetaDir writes a coverage meta-data file for the currently\nrunning program to the directory specified in 'dir'. An error will\nbe returned if the operation can't be completed successfully (for\nexample, if the currently running program was not built with\n\"-cover\", or if the directory does not exist).\n" ^error [^string dir]
  (cfile/WriteMetaDir dir))








^{:go/end 37} (go/func WriteMeta "WriteMeta writes the meta-data content (the payload that would\nnormally be emitted to a meta-data file) for the currently running\nprogram to the writer 'w'. An error will be returned if the\noperation can't be completed successfully (for example, if the\ncurrently running program was not built with \"-cover\", or if a\nwrite fails).\n" ^error [^io/Writer w]
  (cfile/WriteMeta w))









^{:go/end 48} (go/func WriteCountersDir "WriteCountersDir writes a coverage counter-data file for the\ncurrently running program to the directory specified in 'dir'. An\nerror will be returned if the operation can't be completed\nsuccessfully (for example, if the currently running program was not\nbuilt with \"-cover\", or if the directory does not exist). The\ncounter data written will be a snapshot taken at the point of the\ncall.\n" ^error [^string dir]
  (cfile/WriteCountersDir dir))








^{:go/end 58} (go/func WriteCounters "WriteCounters writes coverage counter-data content for the\ncurrently running program to the writer 'w'. An error will be\nreturned if the operation can't be completed successfully (for\nexample, if the currently running program was not built with\n\"-cover\", or if a write fails). The counter data written will be a\nsnapshot taken at the point of the invocation.\n" ^error [^io/Writer w]
  (cfile/WriteCounters w))








^{:go/end 68} (go/func ClearCounters "ClearCounters clears/resets all coverage counter variables in the\ncurrently running program. It returns an error if the program in\nquestion was not built with the \"-cover\" flag. Clearing of coverage\ncounters is also not supported for programs not using atomic\ncounter mode (see more detailed comments below for the rationale\nhere).\n" ^error []
  (cfile/ClearCounters))

    ^{:line 110 :tag atomic/Uint64} pagesSweptBasis ; pagesSwept to use as the origin of the sweep ratio
    ^{:line 111 :tag uint64} sweepHeapLiveBasis ; value of gcController.heapLive to use as the origin of sweep ratio; written with lock, read without
    ^{:line 112 :tag float64} sweepPagesPerByte ; proportional sweep ratio; written with lock, read without


  ^{:line 389} [^{:tag mSpanState :val 0} mSpanDead iota]
  ^{:line 390} [^{:val 1} mSpanInUse] ; allocated for garbage collected heap
  ^{:line 391} [^{:val 2} mSpanManual]) ; allocated for manual management (e.g., stack allocator)





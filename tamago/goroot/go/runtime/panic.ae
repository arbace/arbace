(go/var rangePanicError (conv error (conv errorString "range function continued iteration after loop body panic")))
(go/var rangeExhaustedError (conv error (conv errorString "range function continued iteration after whole loop exit")))
(go/var rangeMissingPanicError (conv error (conv errorString "range function recovered a loop body panic and did not resume panicking")))



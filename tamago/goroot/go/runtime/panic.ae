^{:go/end 369} (go/func deferproc "Create a new deferred function fn, which has no arguments and results.\nThe compiler turns a defer statement into a call to this.\n" [^{:tag (func [])} fn]
  (let [gp (getg)]
    (when (!= (.-curg (.-m gp)) gp)
      ;; go code on the system stack can't defer
      (throw "defer on system stack"))


    (let [d (newdefer)]
      (set! (.-link d) (.-_defer gp))
      (set! (.-_defer gp) d)
      (set! (.-fn d) fn)
      (set! (.-pc d) (sys/GetCallerPC))
      ;; We must not be preempted between calling GetCallerSP and
      ;; storing it to d.sp because GetCallerSP's result is a
      ;; uintptr stack pointer.
      (set! (.-sp d) (sys/GetCallerSP)))))



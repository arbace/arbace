^{:go/end 268} (go/func ^{:go/linkname "typehash"} typehash "typehash computes the hash of the object of type t at address p.\nh is the seed.\nThis function is seldom used. Most maps use for hashing either\nfixed functions (e.g. f32hash) or compiler-generated functions\n(e.g. for a type like struct { x, y string }). This implementation\nis slower but more general and is used for hashing interface types\n(called from interhash or nilinterhash, above) or for hashing in\nmaps generated by reflect.MapOf (reflect_typehash, below).\n\ntypehash should be an internal detail,\nbut widely used packages access it using linkname.\nNotable members of the hall of shame include:\n  - github.com/puzpuzpuz/xsync/v2\n  - github.com/puzpuzpuz/xsync/v3\n\nDo not remove or change the type signature.\nSee go.dev/issue/67401.\n" ^uintptr [^{:tag (* _type)} t ^unsafe/Pointer p ^uintptr h]
  (when (!= (bit-and (.-TFlag t) abi/TFlagRegularMemory) 0)
    ;; Handle ptr sizes specially, see issue 37086.
    (switch (.-Size_ t)
      (case [4]
        (return (memhash32 p h)))
      (case [8]
        (return (memhash64 p h)))
      (default
        (return (memhash p h (.-Size_ t))))))


  (switch (.Kind t)
    (case [abi/Float32]
      (return (f32hash p h)))
    (case [abi/Float64]
      (return (f64hash p h)))
    (case [abi/Complex64]
      (return (c64hash p h)))
    (case [abi/Complex128]
      (return (c128hash p h)))
    (case [abi/String]
      (return (strhash p h)))
    (case [abi/Interface]
      (let [i (conv (* interfacetype) (conv unsafe/Pointer t))]
        (when (== (len (.-Methods i)) 0)
          (return (nilinterhash p h)))

        (return (interhash p h))))
    (case [abi/Array]
      (let [a (conv (* arraytype) (conv unsafe/Pointer t))]
        (for [i (conv uintptr 0)] (< i (.-Len a)) (inc! i)
          (set! h (typehash (.-Elem a) (add p (* i (.-Size_ (.-Elem a)))) h)))

        (return h)))
    (case [abi/Struct]
      (let [s (conv (* structtype) (conv unsafe/Pointer t))]
        (range [_ f (.-Fields s)]
          (when (.IsBlank (.-Name f))
            (continue))

          (set! h (typehash (.-Typ f) (add p (.-Offset f)) h)))

        (return h)))
    (default
      ;; Should never happen, as typehash should only be called
      ;; with comparable types.
      (panic (conv errorString (+ "hash of unhashable type " (.string (toRType t))))))))





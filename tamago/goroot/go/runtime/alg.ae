^{:go/end 128} (go/func f32hash ^uintptr [^unsafe/Pointer p ^uintptr h]
  (let [f @(conv (* float32) p)]
    (switch
      (case [(== f 0)]
        (return (trimHash (* c1 (bit-xor c0 h))))) ; +0, -0
      (case [(!= f f)]
        (return (trimHash (* c1 (bit-xor c0 h (conv uintptr (rand))))))) ; any kind of NaN
      (default
        (return (memhash p h 4))))))



^{:go/end 140} (go/func f64hash ^uintptr [^unsafe/Pointer p ^uintptr h]

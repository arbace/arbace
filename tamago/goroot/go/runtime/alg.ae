^{:go/end 333} (go/func efaceeq ^bool [^{:tag (* _type)} t ^unsafe/Pointer x ^unsafe/Pointer y]
  (when (== t nil)
    (return true))

  (let [eq (.-Equal t)]
    (when (== eq nil)
      (panic (conv errorString (+ "comparing uncomparable type " (.string (toRType t))))))


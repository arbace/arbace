(in-ns 'go.runtime) (go/file "lockrank_off.go" :build ["//go:build !goexperiment.staticlockranking"] :imports [])

(go/const ^{:val false} staticLockRanking false)



(go/type lockRankStruct "// lockRankStruct is embedded in mutex, but is empty when staticklockranking is\ndisabled (the default)\n" (struct))


^{:go/end 17} (go/func lockInit [^{:tag (* mutex)} l ^lockRank rank])


^{:go/breaks [3] :go/end 21} (go/func getLockRank ^lockRank [^{:tag (* mutex)} l]
  0)


^{:go/end 25} (go/func lockWithRank [^{:tag (* mutex)} l ^lockRank rank]
  (lock2 l))





^{:go/end 33} (go/func ^:go/nosplit acquireLockRankAndM "This function may be called in nosplit context and thus must be nosplit.\n" [^lockRank rank]
  (let [mp (acquirem)]
    (set! (.-locks mp) + mutexMLocksDelta))) ; not safe to profile right now


^{:go/end 37} (go/func unlockWithRank [^{:tag (* mutex)} l]
  (unlock2 l))





^{:go/end 46} (go/func ^:go/nosplit releaseLockRankAndM "This function may be called in nosplit context and thus must be nosplit.\n" [^lockRank rank]
  (let [mp (.-m (getg))]
    (set! (.-locks mp) - mutexMLocksDelta)
    (releasem mp)))





^{:go/end 52} (go/func ^:go/nosplit lockWithRankMayAcquire "This function may be called in nosplit context and thus must be nosplit.\n" [^{:tag (* mutex)} l ^lockRank rank])



^{:go/end 56} (go/func ^:go/nosplit assertLockHeld [^{:tag (* mutex)} l])



^{:go/end 60} (go/func ^:go/nosplit assertRankHeld [^lockRank r])



^{:go/end 64} (go/func ^:go/nosplit worldStopped [])



^{:go/end 68} (go/func ^:go/nosplit worldStarted [])



^{:go/end 72} (go/func ^:go/nosplit assertWorldStopped [])



^{:go/end 76} (go/func ^:go/nosplit assertWorldStoppedOrLockHeld [^{:tag (* mutex)} l])

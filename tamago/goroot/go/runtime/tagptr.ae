(in-ns 'go.runtime) (go/file "tagptr.go" :imports [])





(go/type taggedPointer "taggedPointer is a pointer with a numeric tag.\nThe size of the numeric tag is GOARCH-dependent,\ncurrently at least 16 bits.\nThis should only be used with pointers allocated outside the Go heap.\n" uint64)


(go/const ^{:val 16 :doc "minTagBits is the minimum number of tag bits that we expect.\n"} minTagBits 16)







(go/const ^{:val 9 :doc "# of bits we can steal from the bottom. We enforce that all pointers\nthat we tag are aligned to at least this many bits.\nCurrently the long pole in this tent is pollDesc at 280 bytes. Setting\n9 here rounds those structs up to 512 bytes.\ngcBgMarkWorkerNode is also small, but we don't make many of those\nso it is ok to waste space on them.\n"} tagAlignBits 9)
(go/const ^{:val 512} tagAlign (<< 1 tagAlignBits))

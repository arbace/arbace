        ;; Dump a snapshot of memory, if enabled.
        (when (.-enabledWithAllocFree trace)
          (traceSnapshotMemory firstGen))


        ;; Record the heap goal so we have it at the very beginning of the trace.
        (.HeapGoal tl)
        (traceRelease tl)

        (unlock (addr (.-sysmonlock sched)))
        (startTheWorld stw)

        (traceStartReadCPU)
        (.start traceAdvancer)

        (semrelease (addr traceAdvanceSema))
        nil))))





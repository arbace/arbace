        (traceSyncBatch firstGen frequency) ; Get this as early in the trace as possible. See comment in traceAdvance.
        (.Gomaxprocs tl gomaxprocs) ; Get this as early in the trace as possible. See comment in traceAdvance.
        (.STWStart tl stwStartTrace) ; We didn't trace this above, so trace it now.

        ;; Record the fact that a GC is active, if applicable.
        (when (or (== gcphase _GCmark) (== gcphase _GCmarktermination))

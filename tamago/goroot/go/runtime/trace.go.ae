          ^{:line 485 :tag (* g)} gp
          ^{:line 486 :tag uint64} goid
          ^{:line 487 :tag int64} mid
          ^{:line 488 :tag uint64} stackID
          ^{:line 489 :tag uint32} status
          ^{:line 490 :tag waitReason} waitreason
          ^{:line 491 :tag bool} inMarkAssist)]


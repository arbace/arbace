        (when (or (!= err nil) (< n 0))
          (return 0 false))

        (return n true)))

    ;; Failing a trailing digit, this must always end in 'B'.
    ;; Also at this point there must be at least one digit before
    ;; that B.
    (when (or (!= last \B) (< (len s) 2))

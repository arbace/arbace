(go/type MemStats "A MemStats records statistics about the memory allocator.\n" (struct
    ;; General statistics.




    ^{:line 61 :tag uint64 :doc "Alloc is bytes of allocated heap objects.\n\nThis is the same as HeapAlloc (see below).\n"} Alloc






    ^{:line 68 :tag uint64 :doc "TotalAlloc is cumulative bytes allocated for heap objects.\n\nTotalAlloc increases as heap objects are allocated, but\nunlike Alloc and HeapAlloc, it does not decrease when\nobjects are freed.\n"} TotalAlloc









    ^{:line 78 :tag uint64 :doc "Sys is the total bytes of memory obtained from the OS.\n\nSys is the sum of the XSys fields below. Sys measures the\nvirtual address space reserved by the Go runtime for the\nheap, stacks, and other internal data structures. It's\nlikely that not all of the virtual address space is backed\nby physical memory at any given moment, though in general\nit all was at some point.\n"} Sys





    ^{:line 84 :tag uint64 :doc "Lookups is the number of pointer lookups performed by the\nruntime.\n\nThis is primarily useful for debugging runtime internals.\n"} Lookups



    ^{:line 88 :tag uint64 :doc "Mallocs is the cumulative count of heap objects allocated.\nThe number of live objects is Mallocs - Frees.\n"} Mallocs


    ^{:line 91 :tag uint64 :doc "Frees is the cumulative count of heap objects freed.\n"} Frees

    ;; Heap memory statistics.
    ;;
    ;; Interpreting the heap statistics requires some knowledge of
    ;; how Go organizes memory. Go divides the virtual address
    ;; space of the heap into "spans", which are contiguous
    ;; regions of memory 8K or larger. A span may be in one of
    ;; three states:
    ;;
    ;; An "idle" span contains no objects or other data. The
    ;; physical memory backing an idle span can be released back
    ;; to the OS (but the virtual address space never is), or it
    ;; can be converted into an "in use" or "stack" span.
    ;;
    ;; An "in use" span contains at least one heap object and may
    ;; have free space available to allocate more heap objects.
    ;;
    ;; A "stack" span is used for goroutine stacks. Stack spans
    ;; are not considered part of the heap. A span can change
    ;; between heap and stack memory; it is never used for both
    ;; simultaneously.












    ^{:line 125 :tag uint64 :doc "HeapAlloc is bytes of allocated heap objects.\n\n\"Allocated\" heap objects include all reachable objects, as\nwell as unreachable objects that the garbage collector has\nnot yet freed. Specifically, HeapAlloc increases as heap\nobjects are allocated and decreases as the heap is swept\nand unreachable objects are freed. Sweeping occurs\nincrementally between GC cycles, so these two processes\noccur simultaneously, and as a result HeapAlloc tends to\nchange smoothly (in contrast with the sawtooth that is\ntypical of stop-the-world garbage collectors).\n"} HeapAlloc












    ^{:line 138 :tag uint64 :doc "HeapSys is bytes of heap memory obtained from the OS.\n\nHeapSys measures the amount of virtual address space\nreserved for the heap. This includes virtual address space\nthat has been reserved but not yet used, which consumes no\nphysical memory, but tends to be small, as well as virtual\naddress space for which the physical memory has been\nreturned to the OS after it became unused (see HeapReleased\nfor a measure of the latter).\n\nHeapSys estimates the largest size the heap has had.\n"} HeapSys














    ^{:line 153 :tag uint64 :doc "HeapIdle is bytes in idle (unused) spans.\n\nIdle spans have no objects in them. These spans could be\n(and may already have been) returned to the OS, or they can\nbe reused for heap allocations, or they can be reused as\nstack memory.\n\nHeapIdle minus HeapReleased estimates the amount of memory\nthat could be returned to the OS, but is being retained by\nthe runtime so it can grow the heap without requesting more\nmemory from the OS. If this difference is significantly\nlarger than the heap size, it indicates there was a recent\ntransient spike in live heap size.\n"} HeapIdle












    ^{:line 166 :tag uint64 :doc "HeapInuse is bytes in in-use spans.\n\nIn-use spans have at least one object in them. These spans\ncan only be used for other objects of roughly the same\nsize.\n\nHeapInuse minus HeapAlloc estimates the amount of memory\nthat has been dedicated to particular size classes, but is\nnot currently being used. This is an upper bound on\nfragmentation, but in general this memory can be reused\nefficiently.\n"} HeapInuse





    ^{:line 172 :tag uint64 :doc "HeapReleased is bytes of physical memory returned to the OS.\n\nThis counts heap memory from idle spans that was returned\nto the OS and has not yet been reacquired for the heap.\n"} HeapReleased






    ^{:line 179 :tag uint64 :doc "HeapObjects is the number of allocated heap objects.\n\nLike HeapAlloc, this increases as objects are allocated and\ndecreases as the heap is swept and unreachable objects are\nfreed.\n"} HeapObjects

    ;; Stack memory statistics.
    ;;
    ;; Stacks are not considered part of the heap, but the runtime
    ;; can reuse a span of heap memory for stack memory, and
    ;; vice-versa.








    ^{:line 194 :tag uint64 :doc "StackInuse is bytes in stack spans.\n\nIn-use stack spans have at least one stack in them. These\nspans can only be used for other stacks of the same size.\n\nThere is no StackIdle because unused stack spans are\nreturned to the heap (and hence counted toward HeapIdle).\n"} StackInuse















    ^{:line 210 :tag uint64 :doc "StackSys is bytes of stack memory obtained from the OS.\n\nStackSys is StackInuse, plus any memory obtained directly\nfrom the OS for OS thread stacks.\n\nIn non-cgo programs this metric is currently equal to StackInuse\n(but this should not be relied upon, and the value may change in\nthe future).\n\nIn cgo programs this metric includes OS thread stacks allocated\ndirectly from the OS. Currently, this only accounts for one stack in\nc-shared and c-archive build modes and other sources of stacks from\nthe OS (notably, any allocated by C code) are not currently measured.\nNote this too may change in the future.\n"} StackSys

    ;; Off-heap memory statistics.
    ;;
    ;; The following statistics measure runtime-internal
    ;; structures that are not allocated from heap memory (usually
    ;; because they are part of implementing the heap). Unlike
    ;; heap or stack memory, any memory allocated to these
    ;; structures is dedicated to these structures.
    ;;
    ;; These are primarily useful for debugging runtime memory
    ;; overheads.


    ^{:line 224 :tag uint64 :doc "MSpanInuse is bytes of allocated mspan structures.\n"} MSpanInuse



    ^{:line 228 :tag uint64 :doc "MSpanSys is bytes of memory obtained from the OS for mspan\nstructures.\n"} MSpanSys


    ^{:line 231 :tag uint64 :doc "MCacheInuse is bytes of allocated mcache structures.\n"} MCacheInuse



    ^{:line 235 :tag uint64 :doc "MCacheSys is bytes of memory obtained from the OS for\nmcache structures.\n"} MCacheSys


    ^{:line 238 :tag uint64 :doc "BuckHashSys is bytes of memory in profiling bucket hash tables.\n"} BuckHashSys


    ^{:line 241 :tag uint64 :doc "GCSys is bytes of memory in garbage collection metadata.\n"} GCSys



    ^{:line 245 :tag uint64 :doc "OtherSys is bytes of memory in miscellaneous off-heap\nruntime allocations.\n"} OtherSys

    ;; Garbage collector statistics.







    ^{:line 255 :tag uint64 :doc "NextGC is the target heap size of the next GC cycle.\n\nThe garbage collector's goal is to keep HeapAlloc ≤ NextGC.\nAt the end of each GC cycle, the target for the next cycle\nis computed based on the amount of reachable data and the\nvalue of GOGC.\n"} NextGC



    ^{:line 259 :tag uint64 :doc "LastGC is the time the last garbage collection finished, as\nnanoseconds since 1970 (the UNIX epoch).\n"} LastGC






    ^{:line 266 :tag uint64 :doc "PauseTotalNs is the cumulative nanoseconds in GC\nstop-the-world pauses since the program started.\n\nDuring a stop-the-world pause, all goroutines are paused\nand only the garbage collector can run.\n"} PauseTotalNs








    ^{:line 275 :tag (array 256 uint64) :doc "PauseNs is a circular buffer of recent GC stop-the-world\npause times in nanoseconds.\n\nThe most recent pause is at PauseNs[(NumGC+255)%256]. In\ngeneral, PauseNs[N%256] records the time paused in the most\nrecent N%256th GC cycle. There may be multiple pauses per\nGC cycle; this is the sum of all pauses during a cycle.\n"} PauseNs







    ^{:line 283 :tag (array 256 uint64) :doc "PauseEnd is a circular buffer of recent GC pause end times,\nas nanoseconds since 1970 (the UNIX epoch).\n\nThis buffer is filled the same way as PauseNs. There may be\nmultiple pauses per GC cycle; this records the end of the\nlast pause in a cycle.\n"} PauseEnd


    ^{:line 286 :tag uint32 :doc "NumGC is the number of completed GC cycles.\n"} NumGC



    ^{:line 290 :tag uint32 :doc "NumForcedGC is the number of GC cycles that were forced by\nthe application calling the GC function.\n"} NumForcedGC














    ^{:line 305 :tag float64 :doc "GCCPUFraction is the fraction of this program's available\nCPU time used by the GC since the program started.\n\nGCCPUFraction is expressed as a number between 0 and 1,\nwhere 0 means GC has consumed none of this program's CPU. A\nprogram's available CPU time is defined as the integral of\nGOMAXPROCS since the program started. That is, if\nGOMAXPROCS is 2 and a program has been running for 10\nseconds, its \"available CPU\" is 20 seconds. GCCPUFraction\ndoes not include CPU time used for write barrier activity.\n\nThis is the same as the fraction of CPU reported by\nGODEBUG=gctrace=1.\n"} GCCPUFraction



    ^{:line 309 :tag bool :doc "EnableGC indicates that GC is enabled. It is always true,\neven if GOGC=off.\n"} EnableGC


    ^{:line 312 :tag bool :doc "DebugGC is currently unused.\n"} DebugGC







    ^{:line 320 :tag (array 61 (struct ^{:tag uint32 :doc "Size is the maximum byte size of an object in this\nsize class.\n"} Size ^{:tag uint64 :doc "Mallocs is the cumulative count of heap objects\nallocated in this size class. The cumulative bytes\nof allocation is Size*Mallocs. The number of live\nobjects in this size class is Mallocs - Frees.\n"} Mallocs ^{:tag uint64 :doc "Frees is the cumulative count of heap objects freed\nin this size class.\n"} Frees)) :doc "BySize reports per-size class allocation statistics.\n\nBySize[N] gives statistics for allocations of size S where\nBySize[N-1].Size < S ≤ BySize[N].Size.\n\nThis does not report allocations larger than BySize[60].Size.\n"} BySize))
















^{:go/end 348} (go/func init []
  (when [offset (unsafe/Offsetof (.-heapStats memstats))] (!= (% offset 8) 0)
    (println offset)
    (throw "memstats.heapStats not aligned to 8 bytes"))

  ;; Ensure the size of heapStatsDelta causes adjacent fields/slots (e.g.
  ;; [3]heapStatsDelta) to be 8-byte aligned.
  (when [size (unsafe/Sizeof (lit heapStatsDelta))] (!= (% size 8) 0)
    (println size)
    (throw "heapStatsDelta not a multiple of 8 bytes in size")))









^{:go/end 365} (go/func ReadMemStats "ReadMemStats populates m with memory allocator statistics.\n\nThe returned memory allocator statistics are up to date as of the\ncall to ReadMemStats. This is in contrast with a heap profile,\nwhich is a snapshot as of the most recently completed garbage\ncollection cycle.\n" [^{:tag (* MemStats)} m]
  (set! _ (.-Alloc m)) ; nil check test before we switch stacks, see issue 61158
  (let [stw (stopTheWorld stwReadMemStats)]

    (systemstack ^{:go/end 362} (fn []
        (readmemstats_m m)))


    (startTheWorld stw)))





(go/var ^{:doc "doubleCheckReadMemStats controls a double-check mode for ReadMemStats that\nensures consistency between the values that ReadMemStats is using and the\nruntime-internal stats.\n"} doubleCheckReadMemStats false)




^{:go/end 564} (go/func readmemstats_m "readmemstats_m populates stats for internal runtime values.\n\nThe world must be stopped.\n" [^{:tag (* MemStats)} stats]
  (assertWorldStopped)

  ;; Flush mcaches to mcentral before doing anything else.
  ;;
  ;; Flushing to the mcentral may in general cause stats to
  ;; change as mcentral data structures are manipulated.
  (systemstack flushallmcaches)

  ;; Calculate memory allocator stats.
  ;; During program execution we only count number of frees and amount of freed memory.
  ;; Current number of alive objects in the heap and amount of alive heap memory
  ;; are calculated by scanning all spans.
  ;; Total number of mallocs is calculated as number of frees plus number of alive objects.
  ;; Similarly, total amount of allocated memory is calculated as amount of freed memory
  ;; plus amount of alive heap memory.

  ;; Collect consistent stats, which are the source-of-truth in some cases.
  (let [^heapStatsDelta consStats (zero heapStatsDelta)]
    (.unsafeRead (.-heapStats memstats) (addr consStats))

    ;; Collect large allocation stats.
    (let [totalAlloc (.-largeAlloc consStats)
        ^{:line 398} nMalloc (.-largeAllocCount consStats)
        ^{:line 399} totalFree (.-largeFree consStats)
        ^{:line 400} nFree (.-largeFreeCount consStats)

        ;; Collect per-sizeclass stats.
        ^{:line 403 :tag (array gc/NumSizeClasses (struct ^uint32 Size ^uint64 Mallocs ^uint64 Frees))} bySize (zero (array gc/NumSizeClasses (struct
              ^{:line 404 :tag uint32} Size
              ^{:line 405 :tag uint64} Mallocs
              ^{:line 406 :tag uint64} Frees)))]

      (range [i bySize]
        (set! (.-Size (aget bySize i)) (conv uint32 (aget gc/SizeClassToSize i)))

        ;; Malloc stats.
        (let [a (aget (.-smallAllocCount consStats) i)]
          (set! totalAlloc + (* a (conv uint64 (aget gc/SizeClassToSize i))))
          (set! nMalloc + a)
          (set! (.-Mallocs (aget bySize i)) a)

          ;; Free stats.
          (let [f (aget (.-smallFreeCount consStats) i)]
            (set! totalFree + (* f (conv uint64 (aget gc/SizeClassToSize i))))
            (set! nFree + f)
            (set! (.-Frees (aget bySize i)) f))))


      ;; Account for tiny allocations.
      ;; For historical reasons, MemStats includes tiny allocations
      ;; in both the total free and total alloc count. This double-counts
      ;; memory in some sense because their tiny allocation block is also
      ;; counted. Tracking the lifetime of individual tiny allocations is
      ;; currently not done because it would be too expensive.
      (set! nFree + (.-tinyAllocCount consStats))
      (set! nMalloc + (.-tinyAllocCount consStats))

      ;; Calculate derived stats.

      (let [stackInUse (conv uint64 (.-inStacks consStats))
          ^{:line 436} gcWorkBufInUse (conv uint64 (.-inWorkBufs consStats))

          ^{:line 438} totalMapped (+ (.load (.-heapInUse gcController)) (.load (.-heapFree gcController)) (.load (.-heapReleased gcController))
            (.load (.-stacks_sys memstats)) (.load (.-mspan_sys memstats)) (.load (.-mcache_sys memstats))
            (.load (.-buckhash_sys memstats)) (.load (.-gcMiscSys memstats)) (.load (.-other_sys memstats))
            ^{:line 441} stackInUse gcWorkBufInUse)

          ^{:line 443} heapGoal (.heapGoal gcController)]

        (when doubleCheckReadMemStats
          ;; Only check this if we're debugging. It would be bad to crash an application
          ;; just because the debugging stats are wrong. We mostly rely on tests to catch
          ;; these issues, and we enable the double check mode for tests.
          ;;
          ;; The world is stopped, so the consistent stats (after aggregation)
          ;; should be identical to some combination of memstats. In particular:
          ;;
          ;; * memstats.heapInUse == inHeap
          ;; * memstats.heapReleased == released
          ;; * memstats.heapInUse + memstats.heapFree == committed - inStacks - inWorkBufs
          ;; * memstats.totalAlloc == totalAlloc
          ;; * memstats.totalFree == totalFree
          ;;
          ;; Check if that's actually true.
          ;;
          ;; Prevent sysmon and the tracer from skewing the stats since they can
          ;; act without synchronizing with a STW. See #64401.
          (lock (addr (.-sysmonlock sched)))
          (lock (addr (.-lock trace)))
          (when (!= (.load (.-heapInUse gcController)) (conv uint64 (.-inHeap consStats)))
            (print "runtime: heapInUse=" (.load (.-heapInUse gcController)) "\n")
            (print "runtime: consistent value=" (.-inHeap consStats) "\n")
            (throw "heapInUse and consistent stats are not equal"))

          (when (!= (.load (.-heapReleased gcController)) (conv uint64 (.-released consStats)))
            (print "runtime: heapReleased=" (.load (.-heapReleased gcController)) "\n")
            (print "runtime: consistent value=" (.-released consStats) "\n")
            (throw "heapReleased and consistent stats are not equal"))

          (let [heapRetained (+ (.load (.-heapInUse gcController)) (.load (.-heapFree gcController)))
              ^{:line 476} consRetained (conv uint64 (- (.-committed consStats) (.-inStacks consStats) (.-inWorkBufs consStats)))]
            (when (!= heapRetained consRetained)
              (print "runtime: global value=" heapRetained "\n")
              (print "runtime: consistent value=" consRetained "\n")
              (throw "measures of the retained heap are not equal"))

            (when (!= (.Load (.-totalAlloc gcController)) totalAlloc)
              (print "runtime: totalAlloc=" (.Load (.-totalAlloc gcController)) "\n")
              (print "runtime: consistent value=" totalAlloc "\n")
              (throw "totalAlloc and consistent stats are not equal"))

            (when (!= (.Load (.-totalFree gcController)) totalFree)
              (print "runtime: totalFree=" (.Load (.-totalFree gcController)) "\n")
              (print "runtime: consistent value=" totalFree "\n")
              (throw "totalFree and consistent stats are not equal"))

            ;; Also check that mappedReady lines up with totalMapped - released.
            ;; This isn't really the same type of "make sure consistent stats line up" situation,
            ;; but this is an opportune time to check.
            (when (!= (.Load (.-mappedReady gcController)) (- totalMapped (conv uint64 (.-released consStats))))
              (print "runtime: mappedReady=" (.Load (.-mappedReady gcController)) "\n")
              (print "runtime: totalMapped=" totalMapped "\n")
              (print "runtime: released=" (conv uint64 (.-released consStats)) "\n")
              (print "runtime: totalMapped-released=" (- totalMapped (conv uint64 (.-released consStats))) "\n")
              (throw "mappedReady and other memstats are not equal"))

            (unlock (addr (.-lock trace)))
            (unlock (addr (.-sysmonlock sched)))))


        ;; We've calculated all the values we need. Now, populate stats.

        (set! (.-Alloc stats) (- totalAlloc totalFree))
        (set! (.-TotalAlloc stats) totalAlloc)
        (set! (.-Sys stats) totalMapped)
        (set! (.-Mallocs stats) nMalloc)
        (set! (.-Frees stats) nFree)
        (set! (.-HeapAlloc stats) (- totalAlloc totalFree))
        (set! (.-HeapSys stats) (+ (.load (.-heapInUse gcController)) (.load (.-heapFree gcController)) (.load (.-heapReleased gcController))))
        ;; By definition, HeapIdle is memory that was mapped
        ;; for the heap but is not currently used to hold heap
        ;; objects. It also specifically is memory that can be
        ;; used for other purposes, like stacks, but this memory
        ;; is subtracted out of HeapSys before it makes that
        ;; transition. Put another way:
        ;;
        ;; HeapSys = bytes allocated from the OS for the heap - bytes ultimately used for non-heap purposes
        ;; HeapIdle = bytes allocated from the OS for the heap - bytes ultimately used for any purpose
        ;;
        ;; or
        ;;
        ;; HeapSys = sys - stacks_inuse - gcWorkBufInUse
        ;; HeapIdle = sys - stacks_inuse - gcWorkBufInUse - heapInUse
        ;;
        ;; => HeapIdle = HeapSys - heapInUse = heapFree + heapReleased
        (set! (.-HeapIdle stats) (+ (.load (.-heapFree gcController)) (.load (.-heapReleased gcController))))
        (set! (.-HeapInuse stats) (.load (.-heapInUse gcController)))
        (set! (.-HeapReleased stats) (.load (.-heapReleased gcController)))
        (set! (.-HeapObjects stats) (- nMalloc nFree))
        (set! (.-StackInuse stats) stackInUse)
        ;; memstats.stacks_sys is only memory mapped directly for OS stacks.
        ;; Add in heap-allocated stack memory for user consumption.
        (set! (.-StackSys stats) (+ stackInUse (.load (.-stacks_sys memstats))))
        (set! (.-MSpanInuse stats) (conv uint64 (.-inuse (.-spanalloc mheap_))))
        (set! (.-MSpanSys stats) (.load (.-mspan_sys memstats)))
        (set! (.-MCacheInuse stats) (conv uint64 (.-inuse (.-cachealloc mheap_))))
        (set! (.-MCacheSys stats) (.load (.-mcache_sys memstats)))
        (set! (.-BuckHashSys stats) (.load (.-buckhash_sys memstats)))
        ;; MemStats defines GCSys as an aggregate of all memory related
        ;; to the memory management system, but we track this memory
        ;; at a more granular level in the runtime.
        (set! (.-GCSys stats) (+ (.load (.-gcMiscSys memstats)) gcWorkBufInUse))
        (set! (.-OtherSys stats) (.load (.-other_sys memstats)))
        (set! (.-NextGC stats) heapGoal)
        (set! (.-LastGC stats) (.-last_gc_unix memstats))
        (set! (.-PauseTotalNs stats) (.-pause_total_ns memstats))
        (set! (.-PauseNs stats) (.-pause_ns memstats))
        (set! (.-PauseEnd stats) (.-pause_end memstats))
        (set! (.-NumGC stats) (.-numgc memstats))
        (set! (.-NumForcedGC stats) (.-numforcedgc memstats))
        (set! (.-GCCPUFraction stats) (.-gc_cpu_fraction memstats))
        (set! (.-EnableGC stats) true)

        ;; stats.BySize and bySize might not match in length.
        ;; That's OK, stats.BySize cannot change due to backwards
        ;; compatibility issues. copy will copy the minimum amount
        ;; of values between the two of them.
        (copy (subslice (.-BySize stats)) (subslice bySize))))))



^{:go/end 571} (go/func ^{:go/linkname "readGCStats runtime/debug.readGCStats"} readGCStats [^{:tag (* (slice uint64))} pauses]

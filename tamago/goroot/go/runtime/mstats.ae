^{:go/end 608} (go/func ^:go/systemstack readGCStats_m "readGCStats_m must be called on the system stack because it acquires the heap\nlock. See mheap for details.\n" [^{:tag (* (slice uint64))} pauses]
  (let [p @pauses]
    ;; Calling code in runtime/debug should make the slice large enough.
    (when (< (cap p) (+ (len (.-pause_ns memstats)) 3))
      (throw "short slice passed to readGCStats"))


    ;; Pass back: pauses, pause ends, last gc (absolute time), number of gc, total pause ns.
    (lock (addr (.-lock mheap_)))

    (let [n (.-numgc memstats)]
      (when (> n (conv uint32 (len (.-pause_ns memstats))))
        (set! n (conv uint32 (len (.-pause_ns memstats)))))


      ;; The pause buffer is circular. The most recent pause is at
      ;; pause_ns[(numgc-1)%len(pause_ns)], and then backward
      ;; from there to go back farther in time. We deliver the times
      ;; most recent first (in p[0]).
      (set! p (subslice p _ (cap p)))
      (for [i (conv uint32 0)] (< i n) (inc! i)
        (let [j (% (- (.-numgc memstats) 1 i) (conv uint32 (len (.-pause_ns memstats))))]
          (aset p i (aget (.-pause_ns memstats) j))
          (aset p (+ n i) (aget (.-pause_end memstats) j))))


      (aset p (+ n n) (.-last_gc_unix memstats))
      (aset p (+ n n 1) (conv uint64 (.-numgc memstats)))
      (aset p (+ n n 2) (.-pause_total_ns memstats))
      (unlock (addr (.-lock mheap_)))
      (set! @pauses (subslice p _ (+ n n 3))))))







^{:go/end 625} (go/func ^:go/nowritebarrier flushmcache "flushmcache flushes the mcache of allp[i].\n\nThe world must be stopped.\n" [^int i]
  (assertWorldStopped)

  (let [p (aget allp i)
      ^{:line 619} c (.-mcache p)]
    (when (== c nil)
      (return))

    (.releaseAll c)
    (stackcache_clear c)))







^{:go/end 638} (go/func ^:go/nowritebarrier flushallmcaches "flushallmcaches flushes the mcaches of all Ps.\n\nThe world must be stopped.\n" []
  (assertWorldStopped)

  (for [i 0] (< i (conv int gomaxprocs)) (inc! i)
    (flushmcache i)))






(go/type sysMemStat "sysMemStat represents a global system statistic that is managed atomically.\n\nThis type must structurally be a uint64 so that mstats aligns with MemStats.\n" uint64)






^{:go/end 652} (go/method ^:go/nosplit load "load atomically reads the value of the stat.\n\nMust be nosplit as it is called in runtime initialization, e.g. newosproc0.\n" ^uint64 [^{:tag (* sysMemStat)} s]
  (atomic/Load64 (conv (* uint64) s)))







^{:go/end 665} (go/method ^:go/nosplit add "add atomically adds the sysMemStat by n.\n\nMust be nosplit as it is called in runtime initialization, e.g. newosproc0.\n" [^{:tag (* sysMemStat)} s ^int64 n]
  (let [val (atomic/Xadd64 (conv (* uint64) s) n)]
    (when (or ^:go/paren (and (> n 0) (< (conv int64 val) n)) ^:go/paren (and (< n 0) (< (+ (conv int64 val) n) n)))

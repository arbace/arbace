(in-ns 'go.runtime) (go/file "os_tamago_64bit.go" :build ["//go:build tamago && (amd64 || arm64 || loong64 || riscv64)"] :imports [

    ^{:line 9} [goos "runtime/goos"]])



^{:go/end 15} (go/func MemRegion "MemRegion returns the start and end addresses of the physical RAM assigned\nto the Go runtime.\n" [] :results [^uint64 start ^uint64 end]
  (return (conv uint64 goos/RamStart) (conv uint64 (+ goos/RamStart goos/RamSize))))




^{:go/end 21} (go/func TextRegion "TextRegion returns the start and end addresses of the physical RAM\ncontaining the Go runtime executable instructions.\n" [] :results [^uint64 start ^uint64 end]
  (return (conv uint64 (.-text firstmoduledata)) (conv uint64 (.-etext firstmoduledata))))




^{:go/end 27} (go/func DataRegion "DataRegion returns the start and end addresses of the physical RAM\ncontaining the Go runtime global symbols.\n" [] :results [^uint64 start ^uint64 end]
  (return (conv uint64 (.-data firstmoduledata)) (conv uint64 (.-enoptrbss firstmoduledata))))

              (aset maskFromHeap (/ (- addr base) goarch/PtrSize) 1)))


          ;; Double-check that every part of the ptr/scalar we're not
          ;; showing the caller is zeroed. This keeps us honest that
          ;; that information is actually irrelevant.
          (for [i limit] (< i (.-elemsize s)) (inc! i)
            (when (!= @(conv (* byte) (conv unsafe/Pointer i)) 0)
              (throw "found non-zeroed tail of allocation")))



          ;; Callers (and a check we're about to run) expects this mask
          ;; to end at the last pointer.
          (while (and (> (len maskFromHeap) 0) (== (aget maskFromHeap (- (len maskFromHeap) 1)) 0))
            (set! maskFromHeap (subslice maskFromHeap _ (- (len maskFromHeap) 1))))


          ;; Unroll again, but this time from the type information.
          (let [maskFromType (make (slice byte) (/ (- limit base) goarch/PtrSize))]
            (set! tp (.typePointersOfType s et base))
            (while true
              (let [^uintptr addr (zero uintptr)]
                (when [(set! (values tp addr) (.next tp limit))] (== addr 0)
                  (break))

                (aset maskFromType (/ (- addr base) goarch/PtrSize) 1)))


            ;; Validate that the prefix of maskFromType is equal to
            ;; maskFromHeap. maskFromType may contain more pointers than
            ;; maskFromHeap produces because maskFromHeap may be able to
            ;; get exact type information for certain classes of objects.
            ;; With maskFromType, we're always just tiling the type bitmap
            ;; through to the elemsize.
            ;;
            ;; It's OK if maskFromType has pointers in elemsize that extend
            ;; past the actual populated space; we checked above that all
            ;; that space is zeroed, so just the GC will just see nil pointers.
            (let [differs false]
              (range [i maskFromHeap]
                (when (!= (aget maskFromHeap i) (aget maskFromType i))
                  (set! differs true)
                  (break)))



              (when differs
                (print "runtime: heap mask=")
                (range [_ b maskFromHeap]
                  (print b))

                (println)
                (print "runtime: type mask=")
                (range [_ b maskFromType]
                  (print b))

                (println)
                (print "runtime: type=" (.string (toRType et)) "\n")
                (throw "found two different masks from two different methods"))


              ;; Select the heap mask to return. We may not have a type mask.
              (set! mask maskFromHeap)

              ;; Make sure we keep ep alive. We may have stopped referencing
              ;; ep's data pointer sometime before this point and it's possible
              ;; for that memory to get freed.
              (KeepAlive ep)
              (return))))))


    ;; stack
    (when [gp (getg)] (and (<= (.-lo (.-stack (.-curg (.-m gp)))) (conv uintptr p)) (< (conv uintptr p) (.-hi (.-stack (.-curg (.-m gp))))))
      (let [found false
          ^{:line 1950 :tag unwinder} u (zero unwinder)]
        (for [(.initAt u (.-pc (.-sched (.-curg (.-m gp)))) (.-sp (.-sched (.-curg (.-m gp)))) 0 (.-curg (.-m gp)) 0)] (.valid u) (.next u)
          (when (and (<= (.-sp (.-frame u)) (conv uintptr p)) (< (conv uintptr p) (.-varp (.-frame u))))
            (set! found true)
            (break)))


        (when found
          (let [(values locals _ _) (.getStackMap (.-frame u) false)]
            (when (== (.-n locals) 0)
              (return))

            (let [size (* (conv uintptr (.-n locals)) goarch/PtrSize)
                ^{:line 1963} n (.-Size_ (.-Elem (conv (* ptrtype) (conv unsafe/Pointer t))))]
              (set! mask (make (slice byte) (/ n goarch/PtrSize)))
              (for [i (conv uintptr 0)] (< i n) (set! i + goarch/PtrSize)
                (let [off (/ (+ (- (+ (conv uintptr p) i) (.-varp (.-frame u))) size) goarch/PtrSize)]
                  (aset mask (/ i goarch/PtrSize) (.ptrbit locals off)))))))


        (return)))


    ;; otherwise, not something the GC knows about.
    ;; possibly read-only data, like malloc(0).
    ;; must not have pointers
    (return)))

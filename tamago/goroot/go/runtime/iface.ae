^{:go/end 710} (go/func iterate_itabs [^{:tag (func [(* itab)])} fn]
  ;; Note: only runs during stop the world or with itabLock held,
  ;; so no other locks/atomics needed.
  (let [t itabTable]
    (for [i (conv uintptr 0)] (< i (.-size t)) (inc! i)
      (let [m @(conv (* (* itab)) (add (conv unsafe/Pointer (addr (.-entries t))) (* i goarch/PtrSize)))]
        (when (!= m nil)
          (go/call fn m))))))








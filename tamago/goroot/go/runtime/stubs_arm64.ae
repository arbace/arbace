    ^{:line 7} [unsafe "unsafe"]])











(go/func ^:extern ^{:go/linkname "load_g"} load_g "Called from assembly only; declared for go vet.\n\nload_g is also called from runtime/cgo.\n\nload_g should be an internal detail,\nbut widely used packages access it using linkname.\nNotable members of the hall of shame include:\n  - github.com/ebitengine/purego\n" [])
(go/func ^:extern save_g [])


(go/func ^:extern ^:go/noescape asmcgocall_no_g [^unsafe/Pointer fn ^unsafe/Pointer arg])

(go/func ^:extern emptyfunc [])






(go/directive "//go:linknamestd spillArgs")
(go/func ^:extern spillArgs "Used by reflectcall and the reflect package.\n\nSpills/loads arguments in registers to/from an internal/abi.RegArgs\nrespectively. Does not follow the Go ABI.\n" [])

(go/directive "//go:linknamestd unspillArgs")
(go/func ^:extern unspillArgs [])



(go/func ^:extern getfp "getfp returns the frame pointer register of its caller or 0 if not implemented.\nTODO: Make this a compiler intrinsic\n" ^uintptr [])

(in-ns 'go.runtime) (go/file "os_nonopenbsd.go" :build ["//go:build !openbsd"] :imports [])



^{:go/end 12} (go/func osStackAlloc "osStackAlloc performs OS-specific initialization before s is used\nas stack memory.\n" [^{:tag (* mspan)} s])




^{:go/end 17} (go/func osStackFree "osStackFree undoes the effect of osStackAlloc before s is returned\nto the heap.\n" [^{:tag (* mspan)} s])

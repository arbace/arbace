^{:go/end 253} (go/func fadd64 ^uint64 [^uint64 f ^uint64 g]
  (let [(values fs fm fe fi fn) (funpack64 f)
      (values gs gm ge gi gn) (funpack64 g)]

    ;; Special cases.

      (case [gi] ; f + ±Inf = ±Inf
        (return g))

      (case [(and (== fm 0) (== gm 0) (!= fs 0) (!= gs 0))] ; -0 + -0 = -0
        (return f))

      (case [(== fm 0)] ; 0 + g = g but 0 + -0 = +0

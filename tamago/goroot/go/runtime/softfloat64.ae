^{:go/end 59} (go/func funpack64 [^uint64 f] :results [^uint64 sign ^uint64 mant ^int exp ^bool inf ^bool nan]
  (set! sign (bit-and f (<< 1 (+ mantbits64 expbits64))))
  (set! mant (bit-and f (- (<< 1 mantbits64) 1)))
  (set! exp (bit-and (conv int (>> f mantbits64)) (- (<< 1 expbits64) 1)))

  (switch exp
    (case [(- (<< 1 expbits64) 1)]
      (when (!= mant 0)
        (set! nan true)
        (return))

      (set! inf true)
      (return))

    (case [0]
      ;; denormalized
      (when (!= mant 0)
        (set! exp + (+ bias64 1))
        (while (< mant (<< 1 mantbits64))
          (set! mant << 1)
          (dec! exp))))



    (default
      ;; add implicit top bit
      (set! mant bit-or (<< 1 mantbits64))
      (set! exp + bias64)))

  (return))



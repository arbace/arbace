^{:go/end 146} (go/func fpack64 ^uint64 [^uint64 sign ^uint64 mant ^int exp ^uint64 trunc]
  (when (== mant 0)
    (return sign))

  (while (< mant (<< 1 mantbits64))
    (set! mant << 1)
    (dec! exp))

  ;; Save the normalized mantissa; the denormal path below restores it and
  ;; re-aligns to the subnormal exponent. Saving before this loop (as the
  ;; code originally did) left a heavily-cancelled add/sub mantissa
  ;; un-normalized, which that path then shifted the wrong way. See #79964.
  (let [(values mant0 exp0 trunc0) (values mant exp trunc)]
    (while (>= mant (<< 4 mantbits64))
      (set! trunc bit-or (bit-and mant 1))
      (set! mant >> 1)
      (inc! exp))

    (when (>= mant (<< 2 mantbits64))
      (when (and (!= (bit-and mant 1) 0) ^:go/paren (or (!= trunc 0) (!= (bit-and mant 2) 0)))
        (inc! mant)
        (when (>= mant (<< 4 mantbits64))
          (set! mant >> 1)
          (inc! exp)))


      (set! mant >> 1)
      (inc! exp))

    (when (>= exp (+ (- (<< 1 expbits64) 1) bias64))
      (return (bit-xor sign inf64)))

    (when (< exp (+ bias64 1))
      (when (< exp (- bias64 (conv int mantbits64)))
        (return (bit-or sign 0)))

      ;; repeat expecting denormal
      (set! (values mant exp trunc) (values mant0 exp0 trunc0))
      (while (< exp bias64)
        (set! trunc bit-or (bit-and mant 1))
        (set! mant >> 1)
        (inc! exp))

      (when (and (!= (bit-and mant 1) 0) ^:go/paren (or (!= trunc 0) (!= (bit-and mant 2) 0)))
        (inc! mant))

      (set! mant >> 1)
      (inc! exp)
      (when (< mant (<< 1 mantbits64))
        (return (bit-or sign mant))))


    (bit-or sign (<< (conv uint64 (- exp bias64)) mantbits64) (bit-and mant (- (<< 1 mantbits64) 1)))))



^{:go/end 536} (go/func init []
  ;; Insert all the non-default-reporting GODEBUGs into the table,
  ;; preserving the overall sort order.
  (let [i 0]
    (while (and (< i (len allDesc)) (< (.-Name (aget allDesc i)) "/godebug/"))
      (inc! i))

    (let [more (make (slice Description) i (+ (len allDesc) (len godebugs/All)))]
      (copy more allDesc)
      (range [_ info godebugs/All]
        (when (not (.-Opaque info))
          (set! more (append more ^{:go/breaks [2 4 6 8]} (lit Description
                :Name (+ "/godebug/non-default-behavior/" (.-Name info) ":events")
                :Description ^{:go/breaks [5]} (+ "The number of non-default behaviors executed by the "
                  (.-Package info) " package " "due to a non-default "
                  "GODEBUG=" (.-Name info) "=... setting.")
                :Kind KindUint64
                :Cumulative true)))))



      (set! allDesc (append more (spread (subslice allDesc i)))))))



^{:go/end 541} (go/func All "All returns a slice of containing metric descriptions for all supported metrics.\n" ^{:tag (slice Description)} []
  ^{:line 540} allDesc)

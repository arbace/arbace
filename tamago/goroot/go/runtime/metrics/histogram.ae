(in-ns 'go.runtime.metrics) (go/file "histogram.go" :imports [])


(go/type Float64Histogram "Float64Histogram represents a distribution of float64 values.\n" (struct




    ^{:line 13 :tag (slice uint64) :doc "Counts contains the weights for each histogram bucket.\n\nGiven N buckets, Count[n] is the weight of the range\n[bucket[n], bucket[n+1]), for 0 <= n < N.\n"} Counts


















    ^{:line 32 :tag (slice float64) :doc "Buckets contains the boundaries of the histogram buckets, in increasing order.\n\nBuckets[0] is the inclusive lower bound of the minimum bucket while\nBuckets[len(Buckets)-1] is the exclusive upper bound of the maximum bucket.\nHence, there are len(Buckets)-1 counts. Furthermore, len(Buckets) != 1, always,\nsince at least two boundaries are required to describe one bucket (and 0\nboundaries are used to describe 0 buckets).\n\nBuckets[0] is permitted to have value -Inf and Buckets[len(Buckets)-1] is\npermitted to have value Inf.\n\nFor a given metric name, the value of Buckets is guaranteed not to change\nbetween calls until program exit.\n\nThis slice value is permitted to alias with other Float64Histograms' Buckets\nfields, so the values within should only ever be read. If they need to be\nmodified, the user must make a copy.\n"} Buckets))

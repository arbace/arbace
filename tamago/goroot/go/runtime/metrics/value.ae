(in-ns 'go.runtime.metrics) (go/file "value.go" :imports [


    ^{:line 8} [math "math"]
    ^{:line 9} [unsafe "unsafe"]])



(go/type ValueKind "ValueKind is a tag for a metric [Value] which indicates its type.\n" int)

(go/const

  ^{:line 17} [^{:tag ValueKind :val 0 :doc "KindBad indicates that the Value has no type and should not be used.\n"} KindBad iota]


  ^{:line 20} [^{:val 1 :doc "KindUint64 indicates that the type of the Value is a uint64.\n"} KindUint64]


  ^{:line 23} [^{:val 2 :doc "KindFloat64 indicates that the type of the Value is a float64.\n"} KindFloat64]


  ^{:line 26} [^{:val 3 :doc "KindFloat64Histogram indicates that the type of the Value is a *Float64Histogram.\n"} KindFloat64Histogram])



(go/type Value "Value represents a metric value returned by the runtime.\n" (struct
    ^{:line 31 :tag ValueKind} kind
    ^{:line 32 :tag uint64} scalar ; contains scalar values for scalar Kinds.
    ^{:line 33 :tag unsafe/Pointer} pointer)) ; contains non-scalar values.



^{:go/end 39} (go/method Kind "Kind returns the tag representing the kind of value this is.\n" ^ValueKind [^Value v]
  (.-kind v))





^{:go/end 49} (go/method Uint64 "Uint64 returns the internal uint64 value for the metric.\n\nIf v.Kind() != KindUint64, this method panics.\n" ^uint64 [^Value v]
  (when (!= (.-kind v) KindUint64)
    (panic "called Uint64 on non-uint64 metric value"))

  (.-scalar v))





^{:go/end 59} (go/method Float64 "Float64 returns the internal float64 value for the metric.\n\nIf v.Kind() != KindFloat64, this method panics.\n" ^float64 [^Value v]
  (when (!= (.-kind v) KindFloat64)
    (panic "called Float64 on non-float64 metric value"))

  (math/Float64frombits (.-scalar v)))





^{:go/end 69} (go/method Float64Histogram "Float64Histogram returns the internal *Float64Histogram value for the metric.\n\nIf v.Kind() != KindFloat64Histogram, this method panics.\n" ^{:tag (* Float64Histogram)} [^Value v]
  (when (!= (.-kind v) KindFloat64Histogram)
    (panic "called Float64Histogram on non-Float64Histogram metric value"))

  (conv (* Float64Histogram) (.-pointer v)))

(in-ns 'go.runtime.metrics) (go/file "sample.go" :imports [


    ^{:line 8} [_ "runtime"] ; depends on the runtime via a linkname'd function
    ^{:line 9} [unsafe "unsafe"]])



(go/type Sample "Sample captures a single metric sample.\n" (struct




    ^{:line 18 :tag string :doc "Name is the name of the metric sampled.\n\nIt must correspond to a name in one of the metric descriptions\nreturned by All.\n"} Name


    ^{:line 21 :tag Value :doc "Value is the value of the metric sample.\n"} Value))



(go/func ^:extern runtime_readMetrics "Implemented in the runtime.\n" [unsafe/Pointer int int])



















^{:go/end 50} (go/func Read "Read populates each [Value] field in the given slice of metric samples.\n\nDesired metrics should be present in the slice with the appropriate name.\nThe user of this API is encouraged to re-use the same slice between calls for\nefficiency, but is not required to do so.\n\nNote that re-use has some caveats. Notably, Values should not be read or\nmanipulated while a Read with that value is outstanding; that is a data race.\nThis property includes pointer-typed Values (for example, [Float64Histogram])\nwhose underlying storage will be reused by Read when possible. To safely use\nsuch values in a concurrent setting, all data must be deep-copied.\n\nIt is safe to execute multiple Read calls concurrently, but their arguments\nmust share no underlying memory. When in doubt, create a new []Sample from\nscratch, which is always safe, though may be inefficient.\n\nSample values with names not appearing in [All] will have their Value populated\nas KindBad to indicate that the name is unknown.\n" [^{:tag (slice Sample)} m]
  (when (== (len m) 0)
    (return))

  (runtime_readMetrics (conv unsafe/Pointer (addr (aget m 0))) (len m) (cap m)))

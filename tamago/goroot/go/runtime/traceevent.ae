;; Trace event writing API for trace2runtime.go.

(in-ns 'go.runtime) (go/file "traceevent.go" :imports [


    ^{:line 10} [abi "internal/abi"]
    ^{:line 11} [sys "internal/runtime/sys"]
    ^{:line 12} [tracev2 "internal/trace/tracev2"]])




(go/type traceArg "traceArg is a simple wrapper type to help ensure that arguments passed\nto traces are well-formed.\n" uint64)





(go/type traceEventWriter "traceEventWriter is the high-level API for writing trace events.\n\nSee the comment on traceWriter about style for more details as to why\nthis type and its methods are structured the way they are.\n" (struct
    ^{:line 24 :tag traceLocker} tl))















^{:go/end 48} (go/method eventWriter "eventWriter creates a new traceEventWriter. It is the main entrypoint for writing trace events.\n\nBefore creating the event writer, this method will emit a status for the current goroutine\nor proc if it exists, and if it hasn't had its status emitted yet. goStatus and procStatus indicate\nwhat the status of goroutine or P should be immediately *before* the events that are about to\nbe written using the eventWriter (if they exist). No status will be written if there's no active\ngoroutine or P.\n\nCallers can elect to pass a constant value here if the status is clear (e.g. a goroutine must have\nbeen Runnable before a GoStart). Otherwise, callers can query the status of either the goroutine\nor P and pass the appropriate status.\n\nIn this case, the default status should be tracev2.GoBad or tracev2.ProcBad to help identify bugs sooner.\n" ^traceEventWriter [^traceLocker tl ^tracev2/GoStatus goStatus ^tracev2/ProcStatus procStatus]
  (when [pp (.ptr (.-p (.-mp tl)))] (and (!= pp nil) (not ^{:go/via [traceSchedResourceState]} (.statusWasTraced (.-trace pp) (.-gen tl))) ^{:go/via [traceSchedResourceState]} (.acquireStatus (.-trace pp) (.-gen tl)))
    (.end (.writeProcStatus (.writer tl) (conv uint64 (.-id pp)) procStatus (.-inSweep (.-trace pp)))))

  (when [gp (.-curg (.-mp tl))] (and (!= gp nil) (not ^{:go/via [traceSchedResourceState]} (.statusWasTraced (.-trace gp) (.-gen tl))) ^{:go/via [traceSchedResourceState]} (.acquireStatus (.-trace gp) (.-gen tl)))
    (.end (.writeGoStatus (.writer tl) (.-goid gp) (conv int64 (.-procid (.-mp tl))) goStatus (.-inMarkAssist gp) 0))) ; /* no stack */

  (.rawEventWriter tl))





^{:go/end 55} (go/method rawEventWriter "rawEventWriter creates a new traceEventWriter without emitting any status events.\n\nIt is the caller's responsibility to emit any status events, if necessary.\n" ^traceEventWriter [^traceLocker tl]
  (lit traceEventWriter tl))



^{:go/end 60} (go/method event "event writes out a trace event.\n" [^traceEventWriter e ^tracev2/EventType ev & ^{:tag (slice traceArg)} args]
  (.end (.event (.writer (.-tl e)) ev (spread args))))





^{:go/end 67} (go/method stack "stack takes a stack trace skipping the provided number of frames.\nIt then returns a traceArg representing that stack which may be\npassed to write.\n" ^traceArg [^traceLocker tl ^int skip]
  (conv traceArg (traceStack skip nil (addr (aget (.-stackTab trace) (% (.-gen tl) 2))))))







^{:go/end 80} (go/method startPC "startPC takes a start PC for a goroutine and produces a unique\nstack ID for it.\n\nIt then returns a traceArg representing that stack which may be\npassed to write.\n" ^traceArg [^traceLocker tl ^uintptr pc]
  ;; +PCQuantum because makeTraceFrame expects return PCs and subtracts PCQuantum.
  (conv traceArg (.put (aget (.-stackTab trace) (% (.-gen tl) 2)) (lit (slice uintptr)
        ^{:line 77} logicalStackSentinel
        (+ (startPCForTrace pc) sys/PCQuantum)))))






^{:go/end 87} (go/method string "string returns a traceArg representing s which may be passed to write.\nThe string is assumed to be relatively short and popular, so it may be\nstored for a while in the string dictionary.\n" ^traceArg [^traceLocker tl ^string s]
  (conv traceArg (.put (aget (.-stringTab trace) (% (.-gen tl) 2)) (.-gen tl) s)))





^{:go/end 94} (go/method uniqueString "uniqueString returns a traceArg representing s which may be passed to write.\nThe string is assumed to be unique or long, so it will be written out to\nthe trace eagerly.\n" ^traceArg [^traceLocker tl ^string s]
  (conv traceArg (.emit (aget (.-stringTab trace) (% (.-gen tl) 2)) (.-gen tl) s)))



^{:go/end 99} (go/method rtype "rtype returns a traceArg representing typ which may be passed to write.\n" ^traceArg [^traceLocker tl ^{:tag (* abi/Type)} typ]
  (conv traceArg (.put (aget (.-typeTab trace) (% (.-gen tl) 2)) typ)))

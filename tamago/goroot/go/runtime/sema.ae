            (set! (.-acquiretime s) (.-acquiretime t)) ; preserve head acquiretime as oldest time
            (set! (.-parent s) (.-parent t))
            (set! (.-prev s) (.-prev t))
            (set! (.-next s) (.-next t))
            (when (!= (.-prev s) nil)
              (set! (.-parent (.-prev s)) s))

            (when (!= (.-next s) nil)
              (set! (.-parent (.-next s)) s))


^{:go/end 722} (go/func ^{:go/linkname "notifyListNotifyOne sync.runtime_notifyListNotifyOne"} notifyListNotifyOne "notifyListNotifyOne notifies one entry in the list.\n" [^{:tag (* notifyList)} l]
  ;; Fast-path: if there are no new waiters since the last notification
  ;; we don't need to acquire the lock at all.
  (when (== (.Load (.-wait l)) (atomic/Load (addr (.-notify l))))
    (return))


  (lockWithRank (addr (.-lock l)) lockRankNotifyList)

  ;; Re-check under the lock if we need to do anything.
  (let [t (.-notify l)]
    (when (== t (.Load (.-wait l)))
      (unlock (addr (.-lock l)))
      (return))


    ;; Update the next notify ticket number.
    (atomic/Store (addr (.-notify l)) (+ t 1))

    ;; Try to find the g that needs to be notified.
    ;; If it hasn't made it to the list yet we won't find it,
    ;; but it won't park itself once it sees the new notify number.
    ;;
    ;; This scan looks linear but essentially always stops quickly.
    ;; Because g's queue separately from taking numbers,
    ;; there may be minor reorderings in the list, but we
    ;; expect the g we're looking for to be near the front.
    ;; The g has others in front of it on the list only to the
    ;; extent that it lost the race, so the iteration will not
    ;; be too long. This applies even when the g is missing:
    ;; it hasn't yet gotten to sleep and has lost the race to
    ;; the (few) other g's that we find on the list.
    (for [(values p s) (values (conv (* sudog) nil) (.-head l))] (!= s nil) (set! (values p s) (values s (.-next s)))
      (when (== (.-ticket s) t)
        (let [n (.-next s)]
          (if (!= p nil)
            (set! (.-next p) n)

            (set! (.-head l) n))

          (when (== n nil)
            (set! (.-tail l) p))

          (unlock (addr (.-lock l)))
          (set! (.-next s) nil)
          (when (and (!= (.-bubble (.-g s)) nil) (!= (.-bubble (getg)) (.-bubble (.-g s))))
            (println "semaphore wake of synctest goroutine" (.-goid (.-g s)) "from outside bubble")
            (fatal "semaphore wake of synctest goroutine from outside bubble"))

          (readyWithTime s 4)
          (return))))


    (unlock (addr (.-lock l)))))



^{:go/end 730} (go/func ^{:go/linkname "notifyListCheck sync.runtime_notifyListCheck"} notifyListCheck [^uintptr sz]
  (when (!= sz (unsafe/Sizeof (lit notifyList)))
    (print "runtime: bad notifyList size - sync=" sz " runtime=" (unsafe/Sizeof (lit notifyList)) "\n")
    (throw "bad notifyList size")))




^{:go/end 735} (go/func ^{:go/linkname "internal_sync_nanotime internal/sync.runtime_nanotime"} internal_sync_nanotime ^int64 []
  (nanotime))

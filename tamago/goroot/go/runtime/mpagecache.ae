      ;; the first free page the slow way.
      (let [(values addr _) (.find p 1)]
        (when (== addr 0)
          ;; We failed to find adequate free space, so mark the searchAddr as OoM
          ;; and return an empty pageCache.
          (set! (.-searchAddr p) (maxSearchAddr))
          (return (lit pageCache)))

        (set! ci (chunkIndex addr))
        (set! chunk (.chunkOf p ci))
        (set! c ^{:go/breaks [2 4 6]} (lit pageCache
            :base (alignDown addr (* 64 pageSize))
            :cache (bit-not ^{:go/via [pallocBits]} (.pages64 chunk (chunkPageIndex addr)))
            :scav (.block64 (.-scavenged chunk) (chunkPageIndex addr))))))



    ;; Set the page bits as allocated and clear the scavenged bits, but
    ;; be careful to only set and clear the relevant bits.
    (let [cpi (chunkPageIndex (.-base c))]
      ^{:go/via [pallocBits]} (.allocPages64 chunk cpi (.-cache c))

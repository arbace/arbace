          (set! c ^{:go/breaks [2 4 6]} (lit pageCache
              :base (+ (chunkBase ci) (* (alignDown (conv uintptr j) 64) pageSize))
              :cache (bit-not ^{:go/via [pallocBits]} (.pages64 chunk j))

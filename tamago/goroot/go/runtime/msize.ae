;; Malloc small size classes.
;;
;; See malloc.go for overview.
;; See also mksizeclasses.go for how we decide what size classes to use.

(in-ns 'go.runtime) (go/file "msize.go" :imports [

    ^{:line 12} [gc "internal/runtime/gc"]])



^{:go/end 36} (go/func roundupsize "Returns size of the memory block that mallocgc will allocate if you ask for the size,\nminus any inline space for metadata.\n" [^uintptr size ^bool noscan] :results [^uintptr reqSize]
  (set! reqSize size)
  (when (<= reqSize (- maxSmallSize gc/MallocHeaderSize))
    ;; Small object.
    (when (and (not noscan) (> reqSize gc/MinSizeForMallocHeader)) ; !noscan && !heapBitsInSpan(reqSize)
      (set! reqSize + gc/MallocHeaderSize))

    ;; (reqSize - size) is either mallocHeaderSize or 0. We need to subtract mallocHeaderSize
    ;; from the result if we have one, since mallocgc will add it back in.
    (when (<= reqSize (- gc/SmallSizeMax 8))
      (return (- (conv uintptr (aget gc/SizeClassToSize (aget gc/SizeToSizeClass8 (divRoundUp reqSize gc/SmallSizeDiv)))) (- reqSize size))))

    (return (- (conv uintptr (aget gc/SizeClassToSize (aget gc/SizeToSizeClass128 (divRoundUp (- reqSize gc/SmallSizeMax) gc/LargeSizeDiv)))) (- reqSize size))))

  ;; Large object. Align reqSize up to the next page. Check for overflow.
  (set! reqSize + (- pageSize 1))
  (when (< reqSize size)
    (return size))

  (bit-and-not reqSize (- pageSize 1)))

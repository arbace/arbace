(in-ns 'go.runtime) (go/file "runtime_noclearenv.go" :build ["//go:build !linux"] :imports [

    ^{:line 9} [_ "unsafe"]]) ; for go:linkname


^{:go/end 18} (go/func ^{:go/linkname "syscall_runtimeClearenv syscall.runtimeClearenv"} syscall_runtimeClearenv [^{:tag (map string int)} env]
  ;; The system doesn't have clearenv(3) so emulate it by unsetting all of
  ;; the variables manually.
  (range [k env]
    (syscall_runtimeUnsetenv k)))

;; Declarations for operating systems implementing time.now
;; indirectly, in terms of walltime and nanotime assembly.



(in-ns 'go.runtime) (go/file "timestub.go" :build ["//go:build !faketime && !windows && !(linux && amd64) && !plan9"] :imports [

    ^{:line 12} [_ "unsafe"]]) ; for go:linkname













^{:go/end 29} (go/func ^{:go/linkname "time_now time.now"} time_now "time_now should be an internal detail,\nbut widely used packages access it using linkname.\nNotable members of the hall of shame include:\n  - gitee.com/quant1x/gox\n  - github.com/phuslu/log\n  - github.com/sethvargo/go-limiter\n  - github.com/ulule/limiter/v3\n\nDo not remove or change the type signature.\nSee go.dev/issue/67401.\n" [] :results [^int64 sec ^int32 nsec ^int64 mono]
  (set! (values sec nsec) (walltime))
  (return sec nsec (nanotime)))

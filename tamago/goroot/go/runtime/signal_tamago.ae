(in-ns 'go.runtime) (go/file "signal_tamago.go" :imports [])

(go/type sigTabT (struct
    ^{:line 8 :tag int32} flags
    ^{:line 9 :tag string} name))


(go/var sigtable (lit (array ... sigTabT)))

      (set! deadline math/MaxInt64))


    (while true
      (when [(set! v (atomic/Load addr))] (> v 0)
        (when (atomic/Cas addr v (- v 1))
          (return 0))

        (continue))

      (when (>= ns 0)
        (when (<= (- deadline (nanotime)) 0)
          (return -1)))


      (when (!= goos/Idle nil)
        (goos/Idle deadline)))))






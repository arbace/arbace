(go/const ^{:val 10 :doc "Maximum number of bytes required to encode uint64 in base-128.\n"} traceBytesPerNumber 10)









(go/type traceWriter "traceWriter is the interface for writing all trace data.\n\nThis type is passed around as a value, and all of its methods return\na new traceWriter. This allows for chaining together calls in a fluent-style\nAPI. This is partly stylistic, and very slightly for performance, since\nthe compiler can destructure this value and pass it between calls as\njust regular arguments. However, this style is not load-bearing, and\nwe can change it if it's deemed too error-prone.\n" (struct
    ^{:line 27} traceLocker
    ^{:line 28 :tag tracev2/Experiment} exp
    (* traceBuf)))













^{:go/end 53} (go/method ^:go/nosplit writer "writer returns a traceWriter that writes into the current M's stream.\n\nOnce this is called, the caller must guard against stack growth until\nend is called on it. Therefore, it's highly recommended to use this\nAPI in a \"fluent\" style, for example tl.writer().event(...).end().\nBetter yet, callers just looking to write events should use eventWriter\nwhen possible, which is a much safer wrapper around this function.\n\nnosplit to allow for safe reentrant tracing from stack growth paths.\n" ^traceWriter [^traceLocker tl]
  (when debugTraceReentrancy
    ;; Checks that the invariants of this function are being upheld.
    (let [gp (getg)]
      (when (== gp (.-curg (.-m gp)))
        (set! (.-oldthrowsplit (.-trace (.-mp tl))) (.-throwsplit gp))
        (set! (.-throwsplit gp) true))))


  (lit traceWriter :traceLocker tl :traceBuf (aget (aget (.-buf (.-trace (.-mp tl))) (% (.-gen tl) 2)) tracev2/NoExperiment)))











^{:go/end 66} (go/func unsafeTraceWriter "unsafeTraceWriter produces a traceWriter that doesn't lock the trace.\n\nIt should only be used in contexts where either:\n- Another traceLocker is held.\n- trace.gen is prevented from advancing.\n\nThis does not have the same stack growth restrictions as traceLocker.writer.\n\nbuf may be nil.\n" ^traceWriter [^uintptr gen ^{:tag (* traceBuf)} buf]
  (lit traceWriter :traceLocker (lit traceLocker :gen gen) :traceBuf buf))








^{:go/end 96} (go/method ^:go/nosplit event "event writes out the bytes of an event into the event stream.\n\nnosplit because it's part of writing an event for an M, which must not\nhave any stack growth.\n" ^traceWriter [^traceWriter w ^tracev2/EventType ev & ^{:tag (slice traceArg)} args]
  ;; N.B. Everything in this call must be nosplit to maintain
  ;; the stack growth related invariants for writing events.

  ;; Make sure we have room.
  (set! (values w _) (.ensure w (+ 1 (* (+ (len args) 1) traceBytesPerNumber))))

  ;; Compute the timestamp diff that we'll put in the trace.
  (let [ts (traceClockNow)]
    (when (<= ts ^{:go/via [traceBufHeader]} (.-lastTime (.-traceBuf w)))
      (set! ts (+ ^{:go/via [traceBufHeader]} (.-lastTime (.-traceBuf w)) 1)))

    (let [tsDiff (conv uint64 (- ts ^{:go/via [traceBufHeader]} (.-lastTime (.-traceBuf w))))]
      (set! ^{:go/via [traceBufHeader]} (.-lastTime (.-traceBuf w)) ts)

      ;; Write out event.
      ^{:go/via [traceBuf]} (.byte w (conv byte ev))
      ^{:go/via [traceBuf]} (.varint w tsDiff)
      (range [_ arg args]
        ^{:go/via [traceBuf]} (.varint w (conv uint64 arg)))

      ^{:line 95} w)))








^{:go/end 119} (go/method ^:go/nosplit end "end writes the buffer back into the m.\n\nnosplit because it's part of writing an event for an M, which must not\nhave any stack growth.\n" [^traceWriter w]
  (when (== ^{:go/via [traceLocker]} (.-mp w) nil)
    ;; Tolerate a nil mp. It makes code that creates traceWriters directly
    ;; less error-prone.
    (return))

  (aset (aget (.-buf (.-trace ^{:go/via [traceLocker]} (.-mp w))) (% ^{:go/via [traceLocker]} (.-gen w) 2)) (.-exp w) (.-traceBuf w))
  (when debugTraceReentrancy
    ;; The writer is no longer live, we can drop throwsplit (if it wasn't

^{:go/end 135} (go/method ^:go/nosplit ensure "ensure makes sure that at least maxSize bytes are available to write.\n\nReturns whether the buffer was flushed.\n\nnosplit because it's part of writing an event for an M, which must not\nhave any stack growth.\n" [^traceWriter w ^int maxSize] :results [traceWriter bool]

          ^{:go/via [traceBuf]} (.byte w (conv byte tracev2/EvExperimentalBatch))
          ^{:go/via [traceBuf]} (.byte w (conv byte (.-exp w)))))

      ^{:go/via [traceBuf]} (.varint w (conv uint64 ^{:go/via [traceLocker]} (.-gen w)))
      ^{:go/via [traceBuf]} (.varint w mID)
      ^{:go/via [traceBuf]} (.varint w (conv uint64 ts))
      (set! ^{:go/via [traceBufHeader]} (.-lenPos (.-traceBuf w)) ^{:go/via [traceBuf]} (.varintReserve w))

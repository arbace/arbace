^{:go/end 222} (go/func unsafeTraceExpWriter "unsafeTraceExpWriter produces a traceWriter for experimental trace batches\nthat doesn't lock the trace. Data written to experimental batches need not\nconform to the standard trace format.\n\nIt should only be used in contexts where either:\n- Another traceLocker is held.\n- trace.gen is prevented from advancing.\n\nThis does not have the same stack growth restrictions as traceLocker.writer.\n\nbuf may be nil.\n" ^traceWriter [^uintptr gen ^{:tag (* traceBuf)} buf ^tracev2/Experiment exp]

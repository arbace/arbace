  (systemstack ^{:go/end 173} (fn []
      (lock (addr (.-lock trace)))
      (when (!= (.-traceBuf w) nil)
        (traceBufFlush (.-traceBuf w) ^{:go/via [traceLocker]} (.-gen w)))

      (if (!= (.-empty trace) nil) (do

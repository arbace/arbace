(go/type traceBufQueue "traceBufQueue is a FIFO of traceBufs.\n" (struct
    ^{:line 226 :tag (* traceBuf)} head ^{:tag (* traceBuf)} tail))



^{:go/end 238} (go/method push "push queues buf into queue of buffers.\n" [^{:tag (* traceBufQueue)} q ^{:tag (* traceBuf)} buf]
  (set! ^{:go/via [traceBufHeader]} (.-link buf) nil)
  (if (== (.-head q) nil)
    (set! (.-head q) buf)

    (set! ^{:go/via [traceBufHeader]} (.-link (.-tail q)) buf))

  (set! (.-tail q) buf))



^{:go/end 252} (go/method pop "pop dequeues from the queue of buffers.\n" ^{:tag (* traceBuf)} [^{:tag (* traceBufQueue)} q]

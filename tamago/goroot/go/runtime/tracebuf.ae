    (when (== buf nil)
      (return nil))

    (set! (.-head q) ^{:go/via [traceBufHeader]} (.-link buf))
    (when (== (.-head q) nil)
      (set! (.-tail q) nil))

    (set! ^{:go/via [traceBufHeader]} (.-link buf) nil)
    ^{:line 251} buf))



(go/type godebugInc "A godebugInc provides access to internal/godebug's IncNonDefault function\nfor a given GODEBUG setting.\nCalls before internal/godebug registers itself are dropped on the floor.\n" (struct
    ^{:line 161 :tag string} name
    ^{:line 162 :tag (atomic/Pointer (func []))} inc))


^{:go/end 185} (go/method IncNonDefault [^{:tag (* godebugInc)} g]
  (let [inc (.Load (.-inc g))]
    (when (== inc nil)
      (let [newInc (.Load godebugNewIncNonDefault)]
        (when (== newInc nil)
          (return))

        (set! inc (new (func [])))
        (set! @inc (@newInc (.-name g)))
        (when raceenabled
          (racereleasemerge (conv unsafe/Pointer (addr (.-inc g)))))

        (when (not (.CompareAndSwap (.-inc g) nil inc))
          (set! inc (.Load (.-inc g))))))


    (when raceenabled
      (raceacquire (conv unsafe/Pointer (addr (.-inc g)))))

    (@inc)))


^{:go/end 199} (go/func godebugNotify [^bool envChanged]
  (let [update (.Load godebugUpdate)
      ^{:line 189 :tag string} env (zero string)]
    (when [p (.Load godebugEnv)] (!= p nil)
      (set! env @p))

    (when envChanged
      (reparsedebugvars env))

    (when (!= update nil)
      (@update godebugDefault env))))




^{:go/end 210} (go/func ^{:go/linkname "syscall_runtimeSetenv syscall.runtimeSetenv"} syscall_runtimeSetenv [^string key ^string value]
  (setenv_c key value)
  (when (== key "GODEBUG")
    (let [p (new string)]
      (set! @p value)
      (.Store godebugEnv p)
      (godebugNotify true))))




^{:go/end 219} (go/func ^{:go/linkname "syscall_runtimeUnsetenv syscall.runtimeUnsetenv"} syscall_runtimeUnsetenv [^string key]
  (unsetenv_c key)

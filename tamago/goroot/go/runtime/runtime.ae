^{:go/end 36} (go/method init "init initializes ticks to maximize the chance that we have a good ticksPerSecond reference.\n\nMust not run concurrently with ticksPerSecond.\n" [^{:tag (* ticksType)} t]
  (lock (addr (.-lock ticks)))
  (set! (.-startTime t) (nanotime))
  (set! (.-startTicks t) (cputicks))
  (unlock (addr (.-lock ticks))))

















(go/const ^{:val 5000000 :doc "minTimeForTicksPerSecond is the minimum elapsed time we require to consider our ticksPerSecond\nmeasurement to be of decent enough quality for profiling.\n\nThere's a linear relationship here between minimum time and error from the true value.\nThe error from the true ticks-per-second in a linux/amd64 VM seems to be:\n-   1 ms -> ~0.02% error\n-   5 ms -> ~0.004% error\n-  10 ms -> ~0.002% error\n-  50 ms -> ~0.0003% error\n- 100 ms -> ~0.0001% error\n\nWe're willing to take 0.004% error here, because ticksPerSecond is intended to be used for\nconverting durations, not timestamps. Durations are usually going to be much larger, and so\nthe tiny error doesn't matter. The error is definitely going to be a problem when trying to\nuse this for timestamps, as it'll make those timestamps much less likely to line up.\n"} minTimeForTicksPerSecond (+ (* 5000000 (- 1 osHasLowResClockInt)) (* 100000000 osHasLowResClockInt)))























^{:go/end 116} (go/func ticksPerSecond "ticksPerSecond returns a conversion rate between the cputicks clock and the nanotime clock.\n\nNote: Clocks are hard. Using this as an actual conversion rate for timestamps is ill-advised\nand should be avoided when possible. Use only for durations, where a tiny error term isn't going\nto make a meaningful difference in even a 1ms duration. If an accurate timestamp is needed,\nuse nanotime instead. (The entire Windows platform is a broad exception to this rule, where nanotime\nproduces timestamps on such a coarse granularity that the error from this conversion is actually\npreferable.)\n\nThe strategy for computing the conversion rate is to write down nanotime and cputicks as\nearly in process startup as possible. From then, we just need to wait until we get values\nfrom nanotime that we can use (some platforms have a really coarse system time granularity).\nWe require some amount of time to pass to ensure that the conversion rate is fairly accurate\nin aggregate. But because we compute this rate lazily, there's a pretty good chance a decent\namount of time has passed by the time we get here.\n\nMust be called from a normal goroutine context (running regular goroutine with a P).\n\nCalled by runtime/pprof in addition to runtime code.\n\nTODO(mknyszek): This doesn't account for things like CPU frequency scaling. Consider\na more sophisticated and general approach in the future.\n" ^int64 []
  ;; Get the conversion rate if we've already computed it.
  (let [r (.Load (.-val ticks))]
    (when (!= r 0)
      (return r))


    ;; Compute the conversion rate.
    (while true
      (lock (addr (.-lock ticks)))
      (set! r (.Load (.-val ticks)))
      (when (!= r 0)
        (unlock (addr (.-lock ticks)))
        (return r))


      ;; Grab the current time in both clocks.
      (let [nowTime (nanotime)
          ^{:line 95} nowTicks (cputicks)]

        ;; See if we can use these times.
        (when (and (> nowTicks (.-startTicks ticks)) (> (- nowTime (.-startTime ticks)) minTimeForTicksPerSecond))
          ;; Perform the calculation with floats. We don't want to risk overflow.
          (set! r (conv int64 (/ (* (conv float64 (- nowTicks (.-startTicks ticks))) 1.0E9) (conv float64 (- nowTime (.-startTime ticks))))))
          (when (== r 0)
            ;; Zero is both a sentinel value and it would be bad if callers used this as
            ;; a divisor. We tried out best, so just make it 1.
            (inc! r))

          (.Store (.-val ticks) r)
          (unlock (addr (.-lock ticks)))
          (break))

        (unlock (addr (.-lock ticks)))

        ;; Sleep in one millisecond increments until we have a reliable time.
        (timeSleep 1000000)))

    ^{:line 115} r))



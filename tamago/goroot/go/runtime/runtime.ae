    (.Store godebugEnv nil)
    (godebugNotify true)))







^{:go/end 227} (go/func ^:go/nosplit writeErrStr "writeErrStr writes a string to descriptor 2.\nIf SetCrashOutput(f) was called, it also writes to f.\n" [^string s]

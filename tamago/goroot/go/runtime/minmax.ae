(in-ns 'go.runtime) (go/file "minmax.go" :imports [

    ^{:line 7} [unsafe "unsafe"]])

^{:go/end 14} (go/func strmin ^string [^string x ^string y]
  (when (< y x)
    (return y))

  ^{:line 13} x)


^{:go/end 21} (go/func strmax ^string [^string x ^string y]
  (when (> y x)
    (return y))

  ^{:line 20} x)


^{:go/end 23} (go/func fmin32 ^float32 [^float32 x ^float32 y] (^{:inst [float32]} fmin x y))
^{:go/end 24} (go/func fmin64 ^float64 [^float64 x ^float64 y] (^{:inst [float64]} fmin x y))
^{:go/end 25} (go/func fmax32 ^float32 [^float32 x ^float32 y] (^{:inst [float32]} fmax x y))
^{:go/end 26} (go/func fmax64 ^float64 [^float64 x ^float64 y] (^{:inst [float64]} fmax x y))

(go/type floaty (interface (| (tilde float32) (tilde float64))))

^{:go/end 40} (go/func fmin :type-params [^floaty F] ^F [^F x ^:go/grouped ^F y]
  (when (or (!= y y) (< y x))
    (return y))

  (when (or (!= x x) (< x y) (!= x 0))
    (return x))

  ;; x and y are both ±0
  ;; if either is -0, return -0; else return +0
  (^{:inst [F]} forbits x y))


^{:go/end 52} (go/func fmax :type-params [^floaty F] ^F [^F x ^:go/grouped ^F y]
  (when (or (!= y y) (> y x))
    (return y))

  (when (or (!= x x) (> x y) (!= x 0))
    (return x))

  ;; x and y are both ±0
  ;; if both are -0, return -0; else return +0
  (^{:inst [F]} fandbits x y))


^{:go/end 62} (go/func forbits :type-params [^floaty F] ^F [^F x ^:go/grouped ^F y]
  (switch (unsafe/Sizeof x)
    (case [4]
      (set! @(conv (* uint32) (conv unsafe/Pointer (addr x))) bit-or @(conv (* uint32) (conv unsafe/Pointer (addr y)))))
    (case [8]
      (set! @(conv (* uint64) (conv unsafe/Pointer (addr x))) bit-or @(conv (* uint64) (conv unsafe/Pointer (addr y))))))

  ^{:line 61} x)


^{:go/end 72} (go/func fandbits :type-params [^floaty F] ^F [^F x ^:go/grouped ^F y]
  (switch (unsafe/Sizeof x)
    (case [4]
      (set! @(conv (* uint32) (conv unsafe/Pointer (addr x))) bit-and @(conv (* uint32) (conv unsafe/Pointer (addr y)))))
    (case [8]
      (set! @(conv (* uint64) (conv unsafe/Pointer (addr x))) bit-and @(conv (* uint64) (conv unsafe/Pointer (addr y))))))

  ^{:line 71} x)

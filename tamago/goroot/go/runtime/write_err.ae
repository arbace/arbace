(in-ns 'go.runtime) (go/file "write_err.go" :build ["//go:build !android"] :imports [])


^{:go/end 14} (go/func ^:go/nosplit writeErr [^{:tag (slice byte)} b]
  (when (> (len b) 0)
    (writeErrData (addr (aget b 0)) (conv int32 (len b)))))

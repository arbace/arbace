(in-ns 'go.runtime) (go/file "cpuflags_amd64.go" :imports [


    ^{:line 8} [cpu "internal/cpu"]])


(go/var ^uint8 memmoveBits)

(go/const

  ^{:line 15} [^{:val 1 :doc "avxSupported indicates that the CPU supports AVX instructions.\n"} avxSupported (<< 1 0)]



  ^{:line 19} [^{:val 2 :doc "repmovsPreferred indicates that REP MOVSx instruction is more\nefficient on the CPU.\n"} repmovsPreferred (<< 1 1)])


^{:go/end 38} (go/func init []
  ;; Here we assume that on modern CPUs with both FSRM and ERMS features,
  ;; copying data blocks of 2KB or larger using the REP MOVSB instruction
  ;; will be more efficient to avoid having to keep up with CPU generations.
  ;; Therefore, we may retain a BlockList mechanism to ensure that microarchitectures
  ;; that do not fit this case may appear in the future.
  ;; We enable it on Intel CPUs first, and we may support more platforms
  ;; in the future.
  (let [isERMSNiceCPU isIntel
      ^{:line 31} useREPMOV (and isERMSNiceCPU (.-HasERMS cpu/X86) (.-HasFSRM cpu/X86))]
    (when (.-HasAVX cpu/X86)
      (set! memmoveBits bit-or avxSupported))

    (when useREPMOV
      (set! memmoveBits bit-or repmovsPreferred))))

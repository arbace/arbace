^{:go/end 255} (go/func printquoted [^string s]
  (printlock)
  (gwrite (conv (slice byte) "\""))
  (range [i r s]
    (switch r
      (case [\newline]
        (gwrite (conv (slice byte) "\\n"))
        (continue))
      (case [\return]
        (gwrite (conv (slice byte) "\\r"))
        (continue))
      (case [\tab]
        (gwrite (conv (slice byte) "\\t"))
        (print)
        (continue))
      (case [\\ \"]
        (gwrite (lit (slice byte) (conv byte \\) (conv byte r)))
        (continue))
      (case [runeError]
        ;; Distinguish errors from a valid encoding of U+FFFD.
        (when [(values _ j) (decoderune s (conv uint i))] (== j (conv uint (+ i 1)))
          (gwrite (bytes "\\x"))
          (printhexopts false 2 (conv uint64 (aget s i)))
          (continue))))

    ;; Fall through to quoting.

    ;; For now, only allow basic printable ascii through unescaped
    (cond (and (>= r \space) (<= r \~))
      (gwrite (lit (slice byte) (conv byte r)))
      (< r 127) (do
        (gwrite (bytes "\\x"))
        (printhexopts false 2 (conv uint64 r)))
      (< r 0x10000) (do
        (gwrite (bytes "\\u"))
        (printhexopts false 4 (conv uint64 r))) :else
      (do
        (gwrite (bytes "\\U"))
        (printhexopts false 8 (conv uint64 r)))))


  (gwrite (lit (slice byte) (conv byte \")))
  (printunlock))



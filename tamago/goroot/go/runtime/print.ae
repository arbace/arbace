^{:go/end 57} (go/func recordForPanic "recordForPanic maintains a circular buffer of messages written by the\nruntime leading up to a process crash, allowing the messages to be\nextracted from a core dump.\n\nThe text written during a process crash (following \"panic\" or \"fatal\nerror\") is not saved, since the goroutine stacks will generally be readable\nfrom the runtime data structures in the core file.\n" [^{:tag (slice byte)} b]
  (printlock)

  (when (== (.Load panicking) 0)
    ;; Not actively crashing: maintain circular buffer of print output.
    (for [i 0] (< i (len b)) _
      (let [n (copy (subslice printBacklog printBacklogIndex) (subslice b i))]
        (set! i + n)
        (set! printBacklogIndex + n)
        (set! printBacklogIndex % (len printBacklog)))))



  (printunlock))


(go/var ^mutex debuglock)

;; The compiler emits calls to printlock and printunlock around
;; the multiple calls that implement a single Go print or println
;; statement. Some of the print helpers (printslice, for example)
;; call print recursively. There is also the problem of a crash
;; happening during the print routines and needing to acquire
;; the print lock to print information about the crash.
;; For both these reasons, let a thread acquire the printlock 'recursively'.

^{:go/end 77} (go/func printlock []
  (let [mp (.-m (getg))]
    (inc! (.-locks mp)) ; do not reschedule between printlock++ and lock(&debuglock).
    (inc! (.-printlock mp))
    (when (== (.-printlock mp) 1)
      (lock (addr debuglock)))

    (dec! (.-locks mp)))) ; now we know debuglock is held and holding up mp.locks for us.


^{:go/end 85} (go/func printunlock []
  (let [mp (.-m (getg))]
    (dec! (.-printlock mp))
    (when (== (.-printlock mp) 0)
      (unlock (addr debuglock)))))





^{:go/end 107} (go/func gwrite "write to goroutine-local buffer if diverting output,\nor else standard error.\n" [^{:tag (slice byte)} b]
  (when (== (len b) 0)
    (return))

  (recordForPanic b)
  (let [gp (getg)]
    ;; Don't use the writebuf if gp.m is dying. We want anything
    ;; written through gwrite to appear in the terminal rather
    ;; than be written to in some buffer, if we're in a panicking state.
    ;; Note that we can't just clear writebuf in the gp.m.dying case
    ;; because a panic isn't allowed to have any write barriers.
    (when (or (== gp nil) (== (.-writebuf gp) nil) (> (.-dying (.-m gp)) 0))
      (writeErr b)
      (return))


    (let [n (copy (subslice (.-writebuf gp) (len (.-writebuf gp)) (cap (.-writebuf gp))) b)]
      (set! (.-writebuf gp) (subslice (.-writebuf gp) _ (+ (len (.-writebuf gp)) n))))))



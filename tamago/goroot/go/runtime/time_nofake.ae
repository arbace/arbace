(in-ns 'go.runtime) (go/file "time_nofake.go" :build ["//go:build !faketime"] :imports [

    ^{:line 9} [unsafe "unsafe"]])





(go/var ^{:tag int64 :doc "faketime is the simulated time in nanoseconds since 1970 for the\nplayground.\n\nZero means not to use faketime.\n"} faketime)
















^{:go/end 34} (go/func ^:go/nosplit ^{:go/linkname "nanotime"} nanotime "Exported via linkname for use by time and internal/poll.\n\nMany external packages also linkname nanotime for a fast monotonic time.\nSuch code should be updated to use:\n\n\tvar start = time.Now() // at init time\n\nand then replace nanotime() with time.Since(start), which is equally fast.\n\nHowever, all the code linknaming nanotime is never going to go away.\nDo not remove or change the type signature.\nSee go.dev/issue/67401.\n" ^int64 []
  (nanotime1))














(go/var ^{:tag (func [^uintptr fd ^unsafe/Pointer p ^int32 n] [int32]) :doc "overrideWrite allows write to be redirected externally, by\nlinkname'ing this and set it to a write function.\n\noverrideWrite should be an internal detail,\nbut widely used packages access it using linkname.\nNotable members of the hall of shame include:\n  - golang.zx2c4.com/wireguard/windows\n\nDo not remove or change the type signature.\nSee go.dev/issue/67401.\n" :go/linkname "overrideWrite"} overrideWrite)




^{:go/end 58} (go/func ^:go/nosplit write "write must be nosplit on Windows (see write1)\n" ^int32 [^uintptr fd ^unsafe/Pointer p ^int32 n]
  (when (!= overrideWrite nil)
    (return (overrideWrite fd (noescape p) n)))

  (write1 fd p n))

^{:go/end 2211} (go/func clearpools []
  ;; clear sync.Pools
  (when (!= poolcleanup nil)
    (poolcleanup))


  ;; clear boringcrypto caches
  (range [_ p boringCaches]
    (atomicstorep p nil))


  ;; Clear central sudog cache.
  ;; Leave per-P caches alone, they have strictly bounded size.
  ;; Disconnect cached list before dropping it on the floor,
  ;; so that a dangling ref to one entry does not pin all of them.
  (lock (addr (.-sudoglock sched)))
  (let [(values ^{:tag (* sudog)} sg ^{:tag (* sudog)} sgnext) (zero (* sudog))]
    (for [(set! sg (.-sudogcache sched))] (!= sg nil) (set! sg sgnext)
      (set! sgnext (.-next sg))
      (set! (.-next sg) nil))

    (set! (.-sudogcache sched) nil)
    (unlock (addr (.-sudoglock sched)))

    ;; Clear central defer pool.
    ;; Leave per-P pools alone, they have strictly bounded size.
    (lock (addr (.-deferlock sched)))
    ;; disconnect cached list before dropping it on the floor,
    ;; so that a dangling ref to one entry does not pin all of them.
    (let [(values ^{:tag (* _defer)} d ^{:tag (* _defer)} dlink) (zero (* _defer))]
      (for [(set! d (.-deferpool sched))] (!= d nil) (set! d dlink)
        (set! dlink (.-link d))
        (set! (.-link d) nil))

      (set! (.-deferpool sched) nil)
      (unlock (addr (.-deferlock sched))))))


;; Timing


^{:go/end 2230} (go/func itoaDiv "itoaDiv formats val/(10**dec) into buf.\n" ^{:tag (slice byte)} [^{:tag (slice byte)} buf ^uint64 val ^int dec]
  (let [i (- (len buf) 1)
      ^{:line 2218} idec (- i dec)]
    (while (or (>= val 10) (>= i idec))
      (aset buf i (conv byte (+ (% val 10) \0)))
      (dec! i)
      (when (== i idec)
        (aset buf i \.)
        (dec! i))

      (set! val / 10))

    (aset buf i (conv byte (+ val \0)))
    (subslice buf i)))



^{:go/end 2250} (go/func fmtNSAsMS "fmtNSAsMS nicely formats ns nanoseconds as milliseconds.\n" ^{:tag (slice byte)} [^{:tag (slice byte)} buf ^uint64 ns]
  (when (>= ns 1.0E7)
    ;; Format as whole milliseconds.
    (return (itoaDiv buf (/ ns 1000000.0) 0)))

  ;; Format two digits of precision, with at most three decimal places.
  (let [x (/ ns 1000.0)]
    (when (== x 0)
      (aset buf 0 \0)
      (return (subslice buf _ 1)))

    (let [dec 3]
      (while (>= x 100)
        (set! x / 10)
        (dec! dec))

      (itoaDiv buf x dec))))



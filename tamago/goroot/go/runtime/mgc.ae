^{:go/end 323} (go/func pollFractionalWorkerExit "pollFractionalWorkerExit reports whether a fractional mark worker\nshould self-preempt. It assumes it is called from the fractional\nworker.\n" ^bool []
  ;; This should be kept in sync with the fractional worker
  ;; scheduler logic in findRunnableGCWorker.
  (let [now (nanotime)
      ^{:line 314} delta (- now (.-markStartTime gcController))]
    (when (<= delta 0)

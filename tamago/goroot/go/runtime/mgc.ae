^{:go/breaks [4] :go/end 177} (go/func ^{:go/linkname "heapObjectsCanMove"} heapObjectsCanMove "heapObjectsCanMove always returns false in the current garbage collector.\nIt exists for go4.org/unsafe/assume-no-moving-gc, which is an\nunfortunate idea that had an even more unfortunate implementation.\nEvery time a new Go release happened, the package stopped building,\nand the authors had to add a new file with a new //go:build line, and\nthen the entire ecosystem of packages with that as a dependency had to\nexplicitly update to the new version. Many packages depend on\nassume-no-moving-gc transitively, through paths like\ninet.af/netaddr -> go4.org/intern -> assume-no-moving-gc.\nThis was causing a significant amount of friction around each new\nrelease, so we added this bool for the package to //go:linkname\ninstead. The bool is still unfortunate, but it's not as bad as\nbreaking the ecosystem on every new release.\n\nIf the Go garbage collector ever does move heap objects, we can set\nthis to true to break all the programs using assume-no-moving-gc.\n" ^bool []
  false)


^{:go/end 205} (go/func gcinit []
  (when (!= (unsafe/Sizeof (lit workbuf)) _WorkbufSize)
    (throw "size of Workbuf is suboptimal"))

  ;; No sweep on the first cycle.
  (.Store (.-state (.-active sweep)) sweepDrainedMask)

  ;; Initialize GC pacer state.
  ;; Use the environment variable GOGC for the initial gcPercent value.
  ;; Use the environment variable GOMEMLIMIT for the initial memoryLimit value.
  (.init gcController (readGOGC) (readGOMEMLIMIT))

  ;; Set up the cleanup block ptr mask.
  (range [i cleanupBlockPtrMask]
    (aset cleanupBlockPtrMask i 0xff))


  (set! (.-startSema work) 1)
  (set! (.-markDoneSema work) 1)
  (.init (.-list (.-spanSPMCs work)) (unsafe/Offsetof (.-allnode (lit spanSPMC))))
  (lockInit (addr (.-lock (.-sweepWaiters work))) lockRankSweepWaiters)
  (lockInit (addr (.-lock (.-assistQueue work))) lockRankAssistQueue)
  (lockInit (addr (.-lock (.-strongFromWeak work))) lockRankStrongFromWeakQueue)
  (lockInit (addr (.-lock (.-wbufSpans work))) lockRankWbufSpans)
  (lockInit (addr (.-lock (.-spanSPMCs work))) lockRankSpanSPMCs)
  (lockInit (addr (.-lock gcCleanups)) lockRankCleanupQueue))






^{:go/end 219} (go/func gcenable "gcenable is called after the bulk of the runtime initialization,\njust before we're about to start letting user code run.\nIt kicks off the background sweeper goroutine, the background\nscavenger goroutine, and enables GC.\n" []
  ;; Kick off sweeping and scavenging.
  (let [c (make (chan int) 2)]
    (go (bgsweep c))
    (go (bgscavenge c))
    (<! c)
    (<! c)
    (set! (.-enablegc memstats) true))) ; now that runtime is initialized, GC is okay





    (let [p (.ptr (.-p (.-m (getg))))
        ^{:line 319} selfTime (+ (.Load (.-gcFractionalMarkTime p)) (- now (.-gcMarkWorkerStartTime p)))]
      ;; Add some slack to the utilization goal so that the
      ;; fractional worker isn't behind again the instant it exits.
      (> (/ (conv float64 selfTime) (conv float64 delta)) (* 1.2 (.-fractionalUtilizationGoal gcController))))))



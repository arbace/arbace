^{:go/end 240} (go/method sysGrow "sysGrow increases the index's backing store in response to a heap growth.\n\nReturns the amount of memory added to sysStat.\n" ^uintptr [^{:tag (* scavengeIndex)} s ^uintptr base ^uintptr limit ^{:tag (* sysMemStat)} sysStat]
  (when (or (!= (% base pallocChunkBytes) 0) (!= (% limit pallocChunkBytes) 0))
    (print "runtime: base = " (conv hex base) ", limit = " (conv hex limit) "\n")
    (throw "sysGrow bounds not aligned to pallocChunkBytes"))


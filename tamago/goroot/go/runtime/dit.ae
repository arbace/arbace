(in-ns 'go.runtime) (go/file "dit.go" :imports [


    ^{:line 8} [sys "internal/runtime/sys"]
    ^{:line 9} [_ "unsafe"]])



^{:go/end 18} (go/func ^{:go/linkname "dit_setEnabled crypto/subtle.setDITEnabled"} dit_setEnabled ^bool []
  (let [g (getg)]
    (set! (.-ditWanted g) true)
    (set! (.-ditEnabled (.-m g)) true)
    (sys/EnableDIT)))



^{:go/end 26} (go/func ^{:go/linkname "dit_setDisabled crypto/subtle.setDITDisabled"} dit_setDisabled []
  (let [g (getg)]
    (set! (.-ditWanted g) false)
    (set! (.-ditEnabled (.-m g)) false)
    (sys/DisableDIT)))

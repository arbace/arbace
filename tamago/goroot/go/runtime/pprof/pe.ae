(in-ns 'go.runtime.pprof) (go/file "pe.go" :imports [

    ^{:line 7} [os "os"]])





^{:go/end 19} (go/func peBuildID "peBuildID returns a best effort unique ID for the named executable.\n\nIt would be wasteful to calculate the hash of the whole file,\ninstead use the binary name and the last modified time for the buildid.\n" ^string [^string file]
  (let [(values s err) (os/Stat file)]
    (when (!= err nil)
      (return file))

    (+ file (.String (.ModTime s)))))

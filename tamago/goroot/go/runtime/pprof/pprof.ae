  (when (== (.-name p) "")
    (panic "pprof: use of zero Profile"))

  (when (!= (.-write p) nil)
    (return ((.-write p) w debug)))


  ;; Obtain consistent snapshot under lock; then process without lock.
  (.Lock (.-mu p))
  (let [all (make (slice (slice uintptr)) 0 (len (.-m p)))]
    (range [_ stk (.-m p)]
      (set! all (append all stk)))

    (.Unlock (.-mu p))

    ;; Map order is non-deterministic; make output deterministic.
    (^{:inst [(slice (slice uintptr)) (slice uintptr)]} slices/SortFunc all ^{:inst [(slice uintptr) uintptr]} slices/Compare)

    (printCountProfile w debug (.-name p) (conv stackProfile all))))



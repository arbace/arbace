(in-ns 'go.runtime.pprof) (go/file "protobuf.go" :imports [])


(go/type protobuf "A protobuf is a simple protocol buffer encoder.\n" (struct
    ^{:line 9 :tag (slice byte)} data
    ^{:line 10 :tag (array 16 byte)} tmp
    ^{:line 11 :tag int} nest))


^{:go/end 20} (go/method varint [^{:tag (* protobuf)} b ^uint64 x]
  (while (>= x 128)
    (set! (.-data b) (append (.-data b) (bit-or (conv byte x) 0x80)))
    (set! x >> 7))

  (set! (.-data b) (append (.-data b) (conv byte x))))


^{:go/end 25} (go/method length [^{:tag (* protobuf)} b ^int tag ^int len]
  (.varint b (bit-or (<< (conv uint64 tag) 3) 2))
  (.varint b (conv uint64 len)))


^{:go/end 31} (go/method uint64 [^{:tag (* protobuf)} b ^int tag ^uint64 x]
  ;; append varint to b.data
  (.varint b (bit-or (<< (conv uint64 tag) 3) 0))
  (.varint b x))


^{:go/end 51} (go/method uint64s [^{:tag (* protobuf)} b ^int tag ^{:tag (slice uint64)} x]
  (when (> (len x) 2)
    ;; Use packed encoding
    (let [n1 (len (.-data b))]
      (range [_ u x]
        (.varint b u))

      (let [n2 (len (.-data b))]
        (.length b tag (- n2 n1))
        (let [n3 (len (.-data b))]
          (copy (subslice (.-tmp b)) (subslice (.-data b) n2 n3))
          (copy (subslice (.-data b) (+ n1 (- n3 n2))) (subslice (.-data b) n1 n2))
          (copy (subslice (.-data b) n1) (subslice (.-tmp b) _ (- n3 n2)))
          (return)))))

  (range [_ u x]
    (.uint64 b tag u)))



^{:go/end 58} (go/method uint64Opt [^{:tag (* protobuf)} b ^int tag ^uint64 x]
  (when (== x 0)
    (return))

  (.uint64 b tag x))


^{:go/end 63} (go/method int64 [^{:tag (* protobuf)} b ^int tag ^int64 x]
  (let [u (conv uint64 x)]
    (.uint64 b tag u)))


^{:go/end 70} (go/method int64Opt [^{:tag (* protobuf)} b ^int tag ^int64 x]
  (when (== x 0)
    (return))

  (.int64 b tag x))


^{:go/end 90} (go/method int64s [^{:tag (* protobuf)} b ^int tag ^{:tag (slice int64)} x]
  (when (> (len x) 2)
    ;; Use packed encoding
    (let [n1 (len (.-data b))]
      (range [_ u x]
        (.varint b (conv uint64 u)))

      (let [n2 (len (.-data b))]
        (.length b tag (- n2 n1))
        (let [n3 (len (.-data b))]
          (copy (subslice (.-tmp b)) (subslice (.-data b) n2 n3))
          (copy (subslice (.-data b) (+ n1 (- n3 n2))) (subslice (.-data b) n1 n2))
          (copy (subslice (.-data b) n1) (subslice (.-tmp b) _ (- n3 n2)))
          (return)))))

  (range [_ u x]
    (.int64 b tag u)))



^{:go/end 95} (go/method string [^{:tag (* protobuf)} b ^int tag ^string x]
  (.length b tag (len x))
  (set! (.-data b) (append (.-data b) (spread x))))


^{:go/end 101} (go/method strings [^{:tag (* protobuf)} b ^int tag ^{:tag (slice string)} x]
  (range [_ s x]
    (.string b tag s)))



^{:go/end 108} (go/method stringOpt [^{:tag (* protobuf)} b ^int tag ^string x]
  (when (== x "")
    (return))

  (.string b tag x))


^{:go/end 116} (go/method bool [^{:tag (* protobuf)} b ^int tag ^bool x]
  (if x
    (.uint64 b tag 1)

    (.uint64 b tag 0)))



^{:go/end 123} (go/method boolOpt [^{:tag (* protobuf)} b ^int tag ^bool x]
  (when (not x)
    (return))

  (.bool b tag x))


(go/type msgOffset int)

^{:go/end 130} (go/method startMessage ^msgOffset [^{:tag (* protobuf)} b]
  (inc! (.-nest b))
  (conv msgOffset (len (.-data b))))


^{:go/end 141} (go/method endMessage [^{:tag (* protobuf)} b ^int tag ^msgOffset start]
  (let [n1 (conv int start)
      ^{:line 134} n2 (len (.-data b))]
    (.length b tag (- n2 n1))
    (let [n3 (len (.-data b))]
      (copy (subslice (.-tmp b)) (subslice (.-data b) n2 n3))
      (copy (subslice (.-data b) (+ n1 (- n3 n2))) (subslice (.-data b) n1 n2))
      (copy (subslice (.-data b) n1) (subslice (.-tmp b) _ (- n3 n2)))
      (dec! (.-nest b)))))

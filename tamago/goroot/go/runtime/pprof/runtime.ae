^{:go/end 44} (go/func SetGoroutineLabels "SetGoroutineLabels sets the current goroutine's labels to match ctx.\nA new goroutine inherits the labels of the goroutine that created it.\nThis is a lower-level API than [Do], which should be used instead when possible.\n" [^context/Context ctx]
  (let [(values ctxLabels _) (assert (* labelMap) (.Value ctx (lit labelContextKey)))]
    (runtime_setProfLabel (conv unsafe/Pointer ctxLabels))))









^{:go/end 58} (go/func Do "Do calls f with a copy of the parent context with the\ngiven labels added to the parent's label map.\nGoroutines spawned while executing f will inherit the augmented label-set.\nEach key/value pair in labels is inserted into the label map in the\norder provided, overriding any previous value for the same key.\nThe augmented label map will be set for the duration of the call to f\nand restored once f returns.\n" [^context/Context ctx ^LabelSet labels ^{:tag (func [context/Context])} f]
  (defer (SetGoroutineLabels ctx))
  (set! ctx (WithLabels ctx labels))
  (SetGoroutineLabels ctx)
  (f ctx))

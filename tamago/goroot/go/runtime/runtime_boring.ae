(in-ns 'go.runtime) (go/file "runtime_boring.go" :imports [

    ^{:line 7} [_ "unsafe"]]) ; for go:linkname


^{:go/end 16} (go/func ^{:go/linkname "boring_runtime_arg0 crypto/internal/boring.runtime_arg0"} boring_runtime_arg0 ^string []
  ;; On Windows, argslice is not set, and it's too much work to find argv0.
  (when (== (len argslice) 0)
    (return ""))

  (aget argslice 0))

;; Dummy MSan support API, used when not built with -msan.

(in-ns 'go.runtime) (go/file "msan0.go" :build ["//go:build !msan"] :imports [


    ^{:line 12} [unsafe "unsafe"]])


(go/const ^{:val false} msanenabled false)

;; Because msanenabled is false, none of these functions should be called.

^{:go/end 19} (go/func msanread [^unsafe/Pointer addr ^uintptr sz] (throw "msan"))
^{:go/end 20} (go/func msanwrite [^unsafe/Pointer addr ^uintptr sz] (throw "msan"))
^{:go/end 21} (go/func msanmalloc [^unsafe/Pointer addr ^uintptr sz] (throw "msan"))
^{:go/end 22} (go/func msanfree [^unsafe/Pointer addr ^uintptr sz] (throw "msan"))
^{:go/end 23} (go/func msanmove [^unsafe/Pointer dst ^unsafe/Pointer src ^uintptr sz] (throw "msan"))

^{:go/end 626} (go/func ^{:go/linkname "trace_userTaskCreate runtime/trace.userTaskCreate"} trace_userTaskCreate "trace_userTaskCreate emits a UserTaskCreate event.\n" [^uint64 id ^uint64 parentID ^string taskType]

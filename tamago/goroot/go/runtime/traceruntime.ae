^{:go/end 365} (go/method GCSweepStart "GCSweepStart prepares to trace a sweep loop. This does not\nemit any events until traceGCSweepSpan is called.\n\nGCSweepStart must be paired with traceGCSweepDone and there\nmust be no preemption points between these two calls.\n\nMust be called with a valid P.\n" [^traceLocker tl]
  ;; Delay the actual GCSweepBegin event until the first span
  ;; sweep. If we don't sweep anything, don't emit any events.
  (let [pp (.ptr (.-p (.-mp tl)))]
    (when (.-maySweep (.-trace pp))
      (throw "double traceGCSweepStart"))

    (set! (values (.-maySweep (.-trace pp)) (.-swept (.-trace pp)) (.-reclaimed (.-trace pp))) (values true 0 0))))










^{:go/end 384} (go/method GCSweepSpan "GCSweepSpan traces the sweep of a single span. If this is\nthe first span swept since traceGCSweepStart was called, this\nwill emit a GCSweepBegin event.\n\nThis may be called outside a traceGCSweepStart/traceGCSweepDone\npair; however, it will not emit any trace events in this case.\n\nMust be called with a valid P.\n" [^traceLocker tl ^uintptr bytesSwept]

    (when (.-maySweep (.-trace pp))
      (when (== (.-swept (.-trace pp)) 0)
        (.event (.eventWriter tl tracev2/GoRunning tracev2/ProcRunning) tracev2/EvGCSweepBegin (.stack tl 1))
        (set! (.-inSweep (.-trace pp)) true))

      (set! (.-swept (.-trace pp)) + bytesSwept))))








^{:go/end 401} (go/method GCSweepDone "GCSweepDone finishes tracing a sweep loop. If any memory was\nswept (i.e. traceGCSweepSpan emitted an event) then this will emit\na GCSweepEnd event.\n\nMust be called with a valid P.\n" [^traceLocker tl]
  (let [pp (.ptr (.-p (.-mp tl)))]
    (when (not (.-maySweep (.-trace pp)))
      (throw "missing traceGCSweepStart"))

    (when (.-inSweep (.-trace pp))
      (.event (.eventWriter tl tracev2/GoRunning tracev2/ProcRunning) tracev2/EvGCSweepEnd (conv traceArg (.-swept (.-trace pp))) (conv traceArg (.-reclaimed (.-trace pp))))
      (set! (.-inSweep (.-trace pp)) false))

    (set! (.-maySweep (.-trace pp)) false)))




^{:go/end 69} (go/func traceLockInit "traceLockInit initializes global trace locks.\n" []
  ;; Sharing a lock rank here is fine because they should never be accessed
  ;; together. If they are, we want to find out immediately.
  (lockInit (addr (.-lock (aget (.-stringTab trace) 0))) lockRankTraceStrings)
  (lockInit (addr (.-lock (.-mem (.-tab (aget (.-stringTab trace) 0))))) lockRankTraceStrings)
  (lockInit (addr (.-lock (aget (.-stringTab trace) 1))) lockRankTraceStrings)
  (lockInit (addr (.-lock (.-mem (.-tab (aget (.-stringTab trace) 1))))) lockRankTraceStrings)
  (lockInit (addr (.-lock (.-mem (.-tab (aget (.-stackTab trace) 0))))) lockRankTraceStackTab)
  (lockInit (addr (.-lock (.-mem (.-tab (aget (.-stackTab trace) 1))))) lockRankTraceStackTab)
  (lockInit (addr (.-lock (.-mem (.-tab (aget (.-typeTab trace) 0))))) lockRankTraceTypeTab)
  (lockInit (addr (.-lock (.-mem (.-tab (aget (.-typeTab trace) 1))))) lockRankTraceTypeTab)
  (lockInit (addr (.-lock trace)) lockRankTrace))









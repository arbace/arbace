  (!= (.-gen tl) 0))







^{:go/end 266} (go/func ^:go/nosplit traceRelease "traceRelease indicates that this M is done writing trace events.\n\nnosplit because it's called on the syscall path when stack movement is forbidden.\n" [^traceLocker tl]
  (if (> (.-reentered (.-trace (.-mp tl))) 0)
    (dec! (.-reentered (.-trace (.-mp tl))))

    (.Store (.-writing (.-trace (.-mp tl))) false))

  (releasem (.-mp tl)))






(in-ns 'go.runtime) (go/file "mem.go" :imports [

    ^{:line 7} [unsafe "unsafe"]])

;; OS memory management abstraction layer
;;
;; Regions of the address space managed by the runtime may be in one of four
;; states at any given time:
;; 1) None - Unreserved and unmapped, the default state of any region.
;; 2) Reserved - Owned by the runtime, but accessing it would cause a fault.
;;               Does not count against the process' memory footprint.
;; 3) Prepared - Reserved, intended not to be backed by physical memory (though
;;               an OS may implement this lazily). Can transition efficiently to
;;               Ready. Accessing memory in such a region is undefined (may
;;               fault, may give back unexpected zeroes, etc.).
;; 4) Ready - may be accessed safely.
;;
;; This set of states is more than strictly necessary to support all the
;; currently supported platforms. One could get by with just None, Reserved, and
;; Ready. However, the Prepared state gives us flexibility for performance
;; purposes. For example, on POSIX-y operating systems, Reserved is usually a
;; private anonymous mmap'd region with PROT_NONE set, and to transition
;; to Ready would require setting PROT_READ|PROT_WRITE. However the
;; underspecification of Prepared lets us use just MADV_FREE to transition from
;; Ready to Prepared. Thus with the Prepared state we can set the permission
;; bits just once early on, we can efficiently tell the OS that it's free to
;; take pages away from us when we don't strictly need them.
;;
;; This file defines a cross-OS interface for a common set of helpers
;; that transition memory regions between these states. The helpers call into
;; OS-specific implementations that handle errors, while the interface boundary
;; implements cross-OS functionality, like updating runtime accounting.












^{:go/end 61} (go/func ^:go/nosplit sysAlloc "sysAlloc transitions an OS-chosen region of memory from None to Ready.\nMore specifically, it obtains a large chunk of zeroed memory from the\noperating system, typically on the order of a hundred kilobytes\nor a megabyte. This memory is always immediately available for use.\n\nsysStat must be non-nil.\n\nDon't split the stack as this function may be invoked without a valid G,\nwhich prevents us from allocating more stack.\n" ^unsafe/Pointer [^uintptr n ^{:tag (* sysMemStat)} sysStat ^string vmaName]
  (.add sysStat (conv int64 n))
  (.Add (.-mappedReady gcController) (conv int64 n))
  (let [p (sysAllocOS n vmaName)]

    ;; When using ASAN leak detection, we must tell ASAN about
    ;; cases where we store pointers in mmapped memory.
    (when asanenabled
      (lsanregisterrootregion p n))


    ^{:line 60} p))







^{:go/end 71} (go/func sysUnused "sysUnused transitions a memory region from Ready to Prepared. It notifies the\noperating system that the physical pages backing this memory region are no\nlonger needed and can be reused for other purposes. The contents of a\nsysUnused memory region are considered forfeit and the region must not be\naccessed again until sysUsed is called.\n" [^unsafe/Pointer v ^uintptr n]
  (.Add (.-mappedReady gcController) (- (conv int64 n)))
  (sysUnusedOS v n))




^{:go/end 77} (go/func needZeroAfterSysUnused "needZeroAfterSysUnused reports whether memory returned by sysUnused must be\nzeroed for use.\n" ^bool []
  (needZeroAfterSysUnusedOS))












^{:go/end 92} (go/func sysUsed "sysUsed transitions a memory region from Prepared to Ready. It notifies the\noperating system that the memory region is needed and ensures that the region\nmay be safely accessed. This is typically a no-op on systems that don't have\nan explicit commit step and hard over-commit limits, but is critical on\nWindows, for example.\n\nThis operation is idempotent for memory already in the Prepared state, so\nit is safe to refer, with v and n, to a range of memory that includes both\nPrepared and Ready memory. However, the caller must provide the exact amount\nof Prepared memory for accounting purposes.\n" [^unsafe/Pointer v ^uintptr n ^uintptr prepared]
  (.Add (.-mappedReady gcController) (conv int64 prepared))
  (sysUsedOS v n))





^{:go/end 99} (go/func sysHugePage "sysHugePage does not transition memory regions, but instead provides a\nhint to the OS that it would be more efficient to back this memory region\nwith pages of a larger size transparently.\n" [^unsafe/Pointer v ^uintptr n]
  (sysHugePageOS v n))





^{:go/end 106} (go/func sysNoHugePage "sysNoHugePage does not transition memory regions, but instead provides a\nhint to the OS that it would be less efficient to back this memory region\nwith pages of a larger size transparently.\n" [^unsafe/Pointer v ^uintptr n]
  (sysNoHugePageOS v n))




^{:go/end 112} (go/func sysHugePageCollapse "sysHugePageCollapse attempts to immediately back the provided memory region\nwith huge pages. It is best-effort and may fail silently.\n" [^unsafe/Pointer v ^uintptr n]
  (sysHugePageCollapseOS v n))















^{:go/end 141} (go/func ^:go/nosplit sysFree "sysFree transitions a memory region from Ready to None. Therefore, it\nreturns memory unconditionally.\n\nsysStat must be non-nil.\n\nThe size and start address must exactly match the size and returned address\nfrom the original sysAlloc/sysReserve/sysReserveAligned call. That is,\nsysFree cannot be used to free a subset of a memory region.\n\nDon't split the stack as this function may be invoked without a valid G,\nwhich prevents us from allocating more stack.\n" [^unsafe/Pointer v ^uintptr n ^{:tag (* sysMemStat)} sysStat]
  ;; When using ASAN leak detection, the memory being freed is known by
  ;; the sanitizer. We need to unregister it so it's not accessed by it.
  ;;
  ;; lsanunregisterrootregion matches regions by start address and size,
  ;; so it is not possible to unregister a subset of the region. This is
  ;; why sysFree requires the full region from the initial allocation.
  (when asanenabled
    (lsanunregisterrootregion v n))


  (.add sysStat (- (conv int64 n)))
  (.Add (.-mappedReady gcController) (- (conv int64 n)))
  (sysFreeOS v n))











^{:go/end 155} (go/func sysFault "sysFault transitions a memory region from Ready to Reserved. It\nmarks a region such that it will always fault if accessed. Used only for\ndebugging the runtime.\n\nTODO(mknyszek): Currently it's true that all uses of sysFault transition\nmemory from Ready to Reserved, but this may not be true in the future\nsince on every platform the operation is much more general than that.\nIf a transition from Prepared is ever introduced, create a new function\nthat elides the Ready state accounting.\n" [^unsafe/Pointer v ^uintptr n]
  (.Add (.-mappedReady gcController) (- (conv int64 n)))
  (sysFaultOS v n))













^{:go/end 178} (go/func sysReserve "sysReserve transitions a memory region from None to Reserved. It reserves\naddress space in such a way that it would cause a fatal fault upon access\n(either via permissions or not committing the memory). Such a reservation is\nthus never backed by physical memory.\n\nIf the pointer passed to it is non-nil, the caller wants the reservation\nthere, but sysReserve can still choose another location if that one is\nunavailable.\n\nsysReserve returns OS-aligned memory. If a larger alignment is required, use\nsysReservedAligned.\n" ^unsafe/Pointer [^unsafe/Pointer v ^uintptr n ^string vmaName]
  (let [p (sysReserveOS v n vmaName)]

    ;; When using ASAN leak detection, we must tell ASAN about
    ;; cases where we store pointers in mmapped memory.
    (when asanenabled
      (lsanregisterrootregion p n))


    ^{:line 177} p))







^{:go/end 243} (go/func sysReserveAligned "sysReserveAligned transitions a memory region from None to Reserved.\n\nSemantics are equivlent to sysReserve, but the returned pointer is aligned\nto align bytes. It may reserve either n or n+align bytes, so it returns the\nsize that was reserved.\n" [^unsafe/Pointer v ^uintptr size ^uintptr align ^string vmaName] :results [unsafe/Pointer uintptr]
  (when isSbrkPlatform
    (when (!= v nil)
      (throw "unexpected heap arena hint on sbrk platform"))

    (return (sysReserveAlignedSbrk size align)))

  ;; Since the alignment is rather large in uses of this
  ;; function, we're not likely to get it by chance, so we ask
  ;; for a larger region and remove the parts we don't need.
  (let [retries 0]
    (let [
        ^{:line 197 :go/label :retry} p (conv uintptr (sysReserve v (+ size align) vmaName))]
      (switch
        (case [(== p 0)]
          (return nil 0))
        (case [(== (bit-and p (- align 1)) 0)]
          (return (conv unsafe/Pointer p) (+ size align)))
        (case [(== GOOS "windows")]
          ;; On Windows we can't release pieces of a
          ;; reservation, so we release the whole thing and
          ;; re-reserve the aligned sub-region. This may race,
          ;; so we may have to try again.
          (sysUnreserve (conv unsafe/Pointer p) (+ size align))
          (set! p (alignUp p align))
          (let [p2 (sysReserve (conv unsafe/Pointer p) size vmaName)]
            (when (!= p (conv uintptr p2))
              ;; Must have raced. Try again.
              (sysUnreserve p2 size)
              (when [(inc! retries)] (== retries 100)
                (throw "failed to allocate aligned heap memory; too many retries"))

              (goto :retry))

            ;; Success.
            (return p2 size)))
        (default
          ;; Trim off the unaligned parts.
          (let [pAligned (alignUp p align)
              ^{:line 224} end (+ pAligned size)
              ^{:line 225} endLen (- (+ p size align) end)]

            ;; sysUnreserve does not allow unreserving a subset of the
            ;; region because LSAN does not allow unregistering a subset.
            ;; So we can't call sysUnreserve. Instead we simply unregister
            ;; the entire region from LSAN and re-register with the smaller
            ;; region before freeing the unecessary portions, which does
            ;; allow subsets of the region.
            (when asanenabled
              (lsanunregisterrootregion (conv unsafe/Pointer p) (+ size align))
              (lsanregisterrootregion (conv unsafe/Pointer pAligned) size))

            (sysFreeOS (conv unsafe/Pointer p) (- pAligned p))
            (when (> endLen 0)
              (sysFreeOS (conv unsafe/Pointer end) endLen))

            (return (conv unsafe/Pointer pAligned) size)))))))













^{:go/end 267} (go/func ^:go/nosplit sysUnreserve "sysUnreserve transitions a memory region from Reserved to None.\n\nThe size and start address must exactly match the size and returned address\nfrom sysReserve/sysReserveAligned. That is, sysUnreserve cannot be used to\nunreserve a subset of a memory region.\n\nDon't split the stack as this function may be invoked without a valid G,\nwhich prevents us from allocating more stack.\n" [^unsafe/Pointer v ^uintptr n]
  ;; When using ASAN leak detection, the memory being freed is known by
  ;; the sanitizer. We need to unregister it so it's not accessed by it.
  ;;
  ;; lsanunregisterrootregion matches regions by start address and size,
  ;; so it is not possible to unregister a subset of the region. This is
  ;; why sysUnreserve requires the full region from sysReserve.
  (when asanenabled
    (lsanunregisterrootregion v n))


  (sysFreeOS v n))






^{:go/end 276} (go/func sysMap "sysMap transitions a memory region from Reserved to Prepared. It ensures the\nmemory region can be efficiently transitioned to Ready.\n\nsysStat must be non-nil.\n" [^unsafe/Pointer v ^uintptr n ^{:tag (* sysMemStat)} sysStat ^string vmaName]
  (.add sysStat (conv int64 n))
  (sysMapOS v n vmaName))

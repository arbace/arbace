(in-ns 'go.runtime) (go/file "cgroup_stubs.go" :build ["//go:build !linux"] :imports [])

^{:go/end 9} (go/func defaultGOMAXPROCSInit [])
^{:go/end 10} (go/func defaultGOMAXPROCSUpdateGODEBUG [])

^{:go/end 24} (go/func defaultGOMAXPROCS ^int32 [^int32 ncpu]
  ;; Use the total number of logical CPUs available now, as CPU affinity
  ;; may change after start.
  ;;
  ;; TODO(prattmic): On some GOOS getCPUCount can never change. Don't
  ;; bother calling over and over.

  (let [procs ncpu]
    (when (<= procs 0)
      (set! procs (getCPUCount)))

    ^{:line 23} procs))

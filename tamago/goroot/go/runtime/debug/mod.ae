        ^:const ^:go/grouped ^{:line 173 :val "\n"} newline "\n"
        ^:const ^:go/grouped ^{:line 174 :val "\t"} tab "\t"


        ^{:line 177} readModuleLine ^{:go/end 191} (fn [^{:tag (slice string)} elem] :results [Module error]
          (when (and (!= (len elem) 2) (!= (len elem) 3))

(go/func ^:extern modinfo "exported from runtime.\n" ^string [])




^{:go/end 38} (go/func ReadBuildInfo "ReadBuildInfo returns the build information embedded\nin the running binary. The information is available only\nin binaries built with module support.\n" [] :results [^{:tag (* BuildInfo)} info ^bool ok]
  (let [data (modinfo)]
    (when (< (len data) 32)
      (return nil false))

    (set! data (subslice data 16 (- (len data) 16)))
    (let [(values bi err) (ParseBuildInfo data)]
      (when (!= err nil)
        (return nil false))


      ;; The go version is stored separately from other build info, mostly for
      ;; historical reasons. It is not part of the modinfo() string, and
      ;; ParseBuildInfo does not recognize it. We inject it here to hide this
      ;; awkwardness from the user.
      (set! (.-GoVersion bi) (runtime/Version))

      (return bi true))))



(go/type BuildInfo "BuildInfo represents the build information read from a Go binary.\n" (struct


    ^{:line 44 :tag string :go/tag "json:\",omitempty\"" :doc "GoVersion is the version of the Go toolchain that built the binary\n(for example, \"go1.19.2\").\n"} GoVersion



    ^{:line 48 :tag string :go/tag "json:\",omitempty\"" :doc "Path is the package path of the main package for the binary\n(for example, \"golang.org/x/tools/cmd/stringer\").\n"} Path


    ^{:line 51 :tag Module :go/tag "json:\"\"" :doc "Main describes the module that contains the main package for the binary.\n"} Main



    ^{:line 55 :tag (slice (* Module)) :go/tag "json:\",omitempty\"" :doc "Deps describes all the dependency modules, both direct and indirect,\nthat contributed packages to the build of this binary.\n"} Deps


    ^{:line 58 :tag (slice BuildSetting) :go/tag "json:\",omitempty\"" :doc "Settings describes the build settings used to build the binary.\n"} Settings))



(go/type Module "A Module describes a single module included in a build.\n" (struct
    ^{:line 63 :tag string :go/tag "json:\",omitempty\""} Path ; module path
    ^{:line 64 :tag string :go/tag "json:\",omitempty\""} Version ; module version
    ^{:line 65 :tag string :go/tag "json:\",omitempty\""} Sum ; checksum
    ^{:line 66 :tag (* Module) :go/tag "json:\",omitempty\""} Replace)) ; replaced by this module






















(go/type BuildSetting "A BuildSetting is a key-value pair describing one setting that influenced a build.\n\nDefined keys include:\n\n  - -buildmode: the buildmode flag used (typically \"exe\")\n  - -compiler: the compiler toolchain flag used (typically \"gc\")\n  - CGO_ENABLED: the effective CGO_ENABLED environment variable\n  - CGO_CFLAGS: the effective CGO_CFLAGS environment variable\n  - CGO_CPPFLAGS: the effective CGO_CPPFLAGS environment variable\n  - CGO_CXXFLAGS:  the effective CGO_CXXFLAGS environment variable\n  - CGO_LDFLAGS: the effective CGO_LDFLAGS environment variable\n  - DefaultGODEBUG: the effective GODEBUG settings\n  - GOARCH: the architecture target\n  - GOAMD64/GOARM/GO386/etc: the architecture feature level for GOARCH\n  - GOOS: the operating system target\n  - GOFIPS140: the frozen FIPS 140-3 module version, if any\n  - vcs: the version control system for the source tree where the build ran\n  - vcs.revision: the revision identifier for the current commit or checkout\n  - vcs.time: the modification time associated with vcs.revision, in RFC3339 format\n  - vcs.modified: true or false indicating whether the source tree had local modifications\n" (struct


    ^{:line 92 :tag string :go/tag "json:\",omitempty\"" :doc "Key and Value describe the build setting.\nKey must not contain an equals sign, space, tab, or newline.\n"} Key

    ^{:line 94 :tag string :go/tag "json:\",omitempty\"" :doc "Value must not contain newlines ('\\n').\n"} Value))



^{:go/end 100} (go/func quoteKey "quoteKey reports whether key is required to be quoted.\n" ^bool [^string key]
  (or (== (len key) 0) (strings/ContainsAny key "= \t\r\n\"`")))



^{:go/end 105} (go/func quoteValue "quoteValue reports whether value is required to be quoted.\n" ^bool [^string value]
  (strings/ContainsAny value " \t\r\n\"`"))



^{:go/end 151} (go/method String "String returns a string representation of a [BuildInfo].\n" ^string [^{:tag (* BuildInfo)} bi]
  (let [buf (new strings/Builder)]
    (when (!= (.-GoVersion bi) "")
      (fmt/Fprintf buf "go\t%s\n" (.-GoVersion bi)))

    (when (!= (.-Path bi) "")
      (fmt/Fprintf buf "path\t%s\n" (.-Path bi)))

    (let [^{:tag (func [string Module])} formatMod (zero (func [string Module]))]
      (set! formatMod ^{:go/end 131} (fn [^string word ^Module m]
          (.WriteString buf word)
          (.WriteByte buf \tab)
          (.WriteString buf (.-Path m))
          (.WriteByte buf \tab)
          (.WriteString buf (.-Version m))
          (if (== (.-Replace m) nil) (do
              (.WriteByte buf \tab)
              (.WriteString buf (.-Sum m)))
            (do
              (.WriteByte buf \newline)
              (formatMod "=>" @(.-Replace m))))

          (.WriteByte buf \newline)))

      (when (!= (.-Main bi) (lit Module))
        (formatMod "mod" (.-Main bi)))

      (range [_ dep (.-Deps bi)]
        (formatMod "dep" @dep))

      (range [_ s (.-Settings bi)]
        (let [key (.-Key s)]
          (when (quoteKey key)
            (set! key (strconv/Quote key)))

          (let [value (.-Value s)]
            (when (quoteValue value)
              (set! value (strconv/Quote value)))

            (fmt/Fprintf buf "build\t%s=%s\n" key value))))


      (.String buf))))









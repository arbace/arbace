(in-ns 'go.runtime) (go/file "rdebug.go" :imports [

    ^{:line 7} [_ "unsafe"]]) ; for go:linkname


^{:go/end 14} (go/func ^{:go/linkname "setMaxStack runtime/debug.setMaxStack"} setMaxStack [^int in] :results [^int out]
  (set! out (conv int maxstacksize))
  (set! maxstacksize (conv uintptr in))
  ^{:line 13} out)



^{:go/end 22} (go/func ^{:go/linkname "setPanicOnFault runtime/debug.setPanicOnFault"} setPanicOnFault [^bool new] :results [^bool old]
  (let [gp (getg)]
    (set! old (.-paniconfault gp))
    (set! (.-paniconfault gp) new)
    ^{:line 21} old))

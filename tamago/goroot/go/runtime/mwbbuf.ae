^{:go/end 183} (go/func ^:go/nosplit ^:go/nowritebarrierrec wbBufFlush "wbBufFlush flushes the current P's write barrier buffer to the GC\nworkbufs.\n\nThis must not have write barriers because it is part of the write\nbarrier implementation.\n\nThis and everything it calls must be nosplit because 1) the stack\ncontains untyped slots from gcWriteBarrier and 2) there must not be\na GC safe point between the write barrier test in the caller and\nflushing the buffer.\n\nTODO: A \"go:nosplitrec\" annotation would be perfect for this.\n" []
  ;; Note: Every possible return from this function must reset
  ;; the buffer's next pointer to prevent buffer overflow.

  (when (> (.-dying (.-m (getg))) 0)
    ;; We're going down. Not much point in write barriers
    ;; and this way we can allow write barriers in the
    ;; panic path.
    (.discard (.-wbBuf (.ptr (.-p (.-m (getg))))))
    (return))


  ;; Switch to the system stack so we don't have to worry about
  ;; safe points.
  (systemstack ^{:go/end 182} (fn []
      (wbBufFlush1 (.ptr (.-p (.-m (getg))))))))













^{:go/end 273} (go/func ^:go/nowritebarrierrec ^:go/systemstack wbBufFlush1 "wbBufFlush1 flushes p's write barrier buffer to the GC work queue.\n\nThis must not have write barriers because it is part of the write\nbarrier implementation, so this may lead to infinite loops or\nbuffer corruption.\n\nThis must be non-preemptible because it uses the P's workbuf.\n" [^{:tag (* p)} pp]
  ;; Get the buffered pointers.
  (let [start (conv uintptr (conv unsafe/Pointer (addr (aget (.-buf (.-wbBuf pp)) 0))))
      ^{:line 198} n (/ (- (.-next (.-wbBuf pp)) start) (unsafe/Sizeof (aget (.-buf (.-wbBuf pp)) 0)))
      ^{:line 199} ptrs (subslice (.-buf (.-wbBuf pp)) _ n)]

    ;; Poison the buffer to make extra sure nothing is enqueued
    ;; while we're processing the buffer.
    (set! (.-next (.-wbBuf pp)) 0)

    (when useCheckmark
      ;; Slow path for checkmark mode.
      (range [_ ptr ptrs]
        (shade ptr))

      (.reset (.-wbBuf pp))
      (return))


    ;; Mark all of the pointers in the buffer and record only the
    ;; pointers we greyed. We use the buffer itself to temporarily
    ;; record greyed pointers.
    ;;
    ;; TODO: Should scanObject/scanblock just stuff pointers into
    ;; the wbBuf? Then this would become the sole greying path.
    ;;
    ;; TODO: We could avoid shading any of the "new" pointers in
    ;; the buffer if the stack has been shaded, or even avoid
    ;; putting them in the buffer at all (which would double its
    ;; capacity). This is slightly complicated with the buffer; we
    ;; could track whether any un-shaded goroutine has used the
    ;; buffer, or just track globally whether there are any
    ;; un-shaded stacks and flush after each stack scan.
    (let [gcw (addr (.-gcw pp))
        ^{:line 229} pos 0]
      (range [_ ptr ptrs]
        (when (< ptr minLegalPointer)
          ;; nil pointers are very common, especially
          ;; for the "old" values. Filter out these and
          ;; other "obvious" non-heap pointers ASAP.
          ;;
          ;; TODO: Should we filter out nils in the fast
          ;; path to reduce the rate of flushes?
          (continue))

        (when (tryDeferToSpanScan ptr gcw)
          (continue))

        (let [(values obj span objIndex) (findObject ptr 0 0)]
          (when (== obj 0)
            (continue))

          ;; TODO: Consider making two passes where the first
          ;; just prefetches the mark bits.
          (let [mbits (.markBitsForIndex span objIndex)]
            (when (.isMarked mbits)
              (continue))

            (.setMarked mbits)

            ;; Mark span.
            (let [(values arena pageIdx pageMask) (pageIndexOf (.base span))]
              (when (== (bit-and (aget (.-pageMarks arena) pageIdx) pageMask) 0)
                (atomic/Or8 (addr (aget (.-pageMarks arena) pageIdx)) pageMask))


              (when (.noscan (.-spanclass span))
                (set! (.-bytesMarked gcw) + (conv uint64 (.-elemsize span)))
                (continue))

              (aset ptrs pos obj)
              (inc! pos)))))


      ;; Enqueue the greyed objects.

;; This implements the write barrier buffer. The write barrier itself
;; is gcWriteBarrier and is implemented in assembly.
;;
;; See mbarrier.go for algorithmic details on the write barrier. This
;; file deals only with the buffer.
;;
;; The write barrier has a fast path and a slow path. The fast path
;; simply enqueues to a per-P write barrier buffer. It's written in
;; assembly and doesn't clobber any general purpose registers, so it
;; doesn't have the usual overheads of a Go call.
;;
;; When the buffer fills up, the write barrier invokes the slow path
;; (wbBufFlush) to flush the buffer to the GC work queues. In this
;; path, since the compiler didn't spill registers, we spill *all*
;; registers and disallow any GC safe points that could observe the
;; stack frame (since we don't know the types of the spilled
;; registers).

(in-ns 'go.runtime) (go/file "mwbbuf.go" :imports [


    ^{:line 26} [goarch "internal/goarch"]
    ^{:line 27} [atomic "internal/runtime/atomic"]
    ^{:line 28} [unsafe "unsafe"]])




(go/const ^{:val false :doc "testSmallBuf forces a small write barrier buffer to stress write\nbarrier flushing.\n"} testSmallBuf false)








(go/type wbBuf "wbBuf is a per-P buffer of pointers queued by the write barrier.\nThis buffer is flushed to the GC workbufs when it fills up and on\nvarious GC transitions.\n\nThis is closely related to a \"sequential store buffer\" (SSB),\nexcept that SSBs are usually used for maintaining remembered sets,\nwhile this is used for marking.\n" (struct






    ^{:line 49 :tag uintptr :doc "next points to the next slot in buf. It must not be a\npointer type because it can point past the end of buf and\nmust be updated without write barriers.\n\nThis is a pointer rather than an index to optimize the\nwrite barrier assembly.\n"} next




    ^{:line 54 :tag uintptr :doc "end points to just past the end of buf. It must not be a\npointer type because it points past the end of buf and must\nbe updated without write barriers.\n"} end


    ^{:line 57 :tag (array wbBufEntries uintptr) :doc "buf stores a series of pointers to execute write barriers on.\n"} buf))


(go/const









  ^{:line 70} [^{:val 512 :doc "wbBufEntries is the maximum number of pointers that can be\nstored in the write barrier buffer.\n\nThis trades latency for throughput amortization. Higher\nvalues amortize flushing overhead more, but increase the\nlatency of flushing. Higher values also increase the cache\nfootprint of the buffer.\n\nTODO: What is the latency cost of this? Tune this value.\n"} wbBufEntries 512]



  ^{:line 74} [^{:val 8 :doc "Maximum number of entries that we need to ask from the\nbuffer in a single call.\n"} wbMaxEntriesPerCall 8])



^{:go/end 93} (go/method reset "reset empties b by resetting its next and end pointers.\n" [^{:tag (* wbBuf)} b]
  (let [start (conv uintptr (conv unsafe/Pointer (addr (aget (.-buf b) 0))))]
    (set! (.-next b) start)
    (if testSmallBuf
      ;; For testing, make the buffer smaller but more than
      ;; 1 write barrier's worth, so it tests both the
      ;; immediate flush and delayed flush cases.
      (set! (.-end b) (conv uintptr (conv unsafe/Pointer (addr (aget (.-buf b) (+ wbMaxEntriesPerCall 1))))))

      (set! (.-end b) (+ start (* (conv uintptr (len (.-buf b))) (unsafe/Sizeof (aget (.-buf b) 0))))))


    (when (!= (% (- (.-end b) (.-next b)) (unsafe/Sizeof (aget (.-buf b) 0))) 0)
      (throw "bad write barrier buffer bounds"))))








^{:go/end 102} (go/method ^:go/nosplit discard "discard resets b's next pointer, but not its end pointer.\n\nThis must be nosplit because it's called by wbBufFlush.\n" [^{:tag (* wbBuf)} b]
  (set! (.-next b) (conv uintptr (conv unsafe/Pointer (addr (aget (.-buf b) 0))))))



^{:go/end 107} (go/method empty "empty reports whether b contains no pointers.\n" ^bool [^{:tag (* wbBuf)} b]

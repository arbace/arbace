^{:go/breaks [[7 1175]] :go/end 1176} (go/func gcMarkWorkAvailable "gcMarkWorkAvailable reports whether there's any non-local work available to do.\n\nThis is a heavyweight check and must only be used for correctness, not\nas a hint.\n" ^bool []
  (when (not (.empty (.-full work)))
    (return true)) ; global work available

  (when (< (.Load (.-markrootNext work)) (.Load (.-markrootJobs work)))
    (return true)) ; root scan work available

  (when (.any (.-spanqMask work))
    (return true)) ; stealable local work available

  false)











^{:go/end 1280} (go/func ^:go/nowritebarrier scanObject "scanObject scans the object starting at b, adding pointers to gcw.\nb must point to the beginning of a heap object or an oblet.\nscanObject consults the GC bitmap for the pointer mask and the\nspans for the size of the object.\n\nUsed only for !gcUsesSpanInlineMarkBits spans, but supports all\nobject sizes and is safe to be called on all heap objects.\n" [^uintptr b ^{:tag (* gcWork)} gcw]
  ;; Prefetch object before we scan it.
  ;;
  ;; This will overlap fetching the beginning of the object with initial
  ;; setup before we start scanning the object.
  (sys/Prefetch b)

  ;; Find the bits for b and the size of the object at b.
  ;;
  ;; b is either the beginning of an object, in which case this
  ;; is the size of the object to scan, or it points to an
  ;; oblet, in which case we compute the size to scan below.
  (let [s (spanOfUnchecked b)
      ^{:line 1200} n (.-elemsize s)]
    (when (== n 0)
      (throw "scanObject n == 0"))

    (when (.noscan (.-spanclass s))
      ;; Correctness-wise this is ok, but it's inefficient
      ;; if noscan objects reach here.
      (throw "scanObject of a noscan object"))


    (let [^typePointers tp (zero typePointers)]
      (if (> n maxObletBytes) (do
          ;; Large object. Break into oblets for better
          ;; parallelism and lower latency.
          (when (== b (.base s))
            ;; Enqueue the other oblets to scan later.
            ;; Some oblets may be in b's scalar tail, but
            ;; these will be marked as "no more pointers",
            ;; so we'll drop out immediately when we go to
            ;; scan those.
            (for [oblet (+ b maxObletBytes)] (< oblet (+ (.base s) (.-elemsize s))) (set! oblet + maxObletBytes)
              (when (not (.putObjFast gcw oblet))
                (.putObj gcw oblet))))




          ;; Compute the size of the oblet. Since this object
          ;; must be a large object, s.base() is the beginning
          ;; of the object.
          (set! n (- (+ (.base s) (.-elemsize s)) b))
          (set! n (min n maxObletBytes))
          (set! tp (.typePointersOfUnchecked s (.base s)))
          (set! tp (.fastForward tp (- b (.-addr tp)) (+ b n))))

        (set! tp (.typePointersOfUnchecked s b)))


      (let [^uintptr scanSize (zero uintptr)]
        (while true
          (let [^uintptr addr (zero uintptr)]
            (when [(set! (values tp addr) (.nextFast tp))] (== addr 0)
              (when [(set! (values tp addr) (.next tp (+ b n)))] (== addr 0)
                (break)))



            ;; Keep track of farthest pointer we found, so we can
            ;; update heapScanWork. TODO: is there a better metric,
            ;; now that we can skip scalar portions pretty efficiently?
            (set! scanSize (+ (- addr b) goarch/PtrSize))

            ;; Work here is duplicated in scanblock and above.
            ;; If you make changes here, make changes there too.
            (let [obj @(conv (* uintptr) (conv unsafe/Pointer addr))]

              ;; At this point we have extracted the next potential pointer.
              ;; Quickly filter out nil and pointers back to the current object.
              (when (and (!= obj 0) (>= (- obj b) n))
                ;; Test if obj points into the Go heap and, if so,
                ;; mark the object.
                ;;
                ;; Note that it's possible for findObject to
                ;; fail if obj points to a just-allocated heap
                ;; object because of a race with growing the
                ;; heap. In this case, we know the object was
                ;; just allocated and hence will be marked by
                ;; allocation itself.
                (when (not (tryDeferToSpanScan obj gcw))
                  (when [(values obj span objIndex) (findObject obj b (- addr b))] (!= obj 0)
                    (greyobject obj b (- addr b) span gcw objIndex)))))))




        (set! (.-bytesMarked gcw) + (conv uint64 n))
        (set! (.-heapScanWork gcw) + (conv int64 scanSize))
        (when (> (.-gctrace debug) 1)
          (inc! (.-sparseObjsScanned (aget (.-stats gcw) (.sizeclass (.-spanclass s))))))))))

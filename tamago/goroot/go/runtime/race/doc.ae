;; Package race implements data race detection logic.
;; No public interface is provided.
;; For details about the race detector see
;; https://golang.org/doc/articles/race_detector.html
(in-ns 'go.runtime.race) (go/file "doc.go" :doc "Package race implements data race detection logic.\nNo public interface is provided.\nFor details about the race detector see\nhttps://golang.org/doc/articles/race_detector.html\n" :imports [])

(go/directive "//go:generate ./mkcgo.sh")

(go/directive "//go:linkname _cgo_call_traceback_function _cgo_call_traceback_function")
(go/directive "//go:linkname _cgo_call_symbolizer_function _cgo_call_symbolizer_function")
(go/directive "//go:linkname _cgo_yield _cgo_yield")
(go/directive "//go:linkname _cgo_pthread_key_created _cgo_pthread_key_created")
(go/directive "//go:linkname _cgo_bindm _cgo_bindm")
(go/directive "//go:linkname _cgo_getstackbound _cgo_getstackbound")


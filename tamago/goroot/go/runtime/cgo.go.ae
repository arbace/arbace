(in-ns 'go.runtime) (go/file "cgo.go" :imports [

    ^{:line 7} [unsafe "unsafe"]])

(go/directive "//go:cgo_export_static main")

;; Filled in by runtime/cgo when linked into binary.

(go/directive "//go:linkname _cgo_init _cgo_init")
(go/directive "//go:linkname _cgo_thread_start _cgo_thread_start")
(go/directive "//go:linkname _cgo_sys_thread_create _cgo_sys_thread_create")
(go/directive "//go:linkname _cgo_notify_runtime_init_done _cgo_notify_runtime_init_done")

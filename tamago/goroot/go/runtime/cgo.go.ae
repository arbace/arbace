(go/var ^{:tag bool :doc "iscgo is set to true by the runtime/cgo package\n\niscgo should be an internal detail,\nbut widely used packages access it using linkname.\nNotable members of the hall of shame include:\n  - github.com/ebitengine/purego\n\nDo not remove or change the type signature.\nSee go.dev/issue/67401.\n" :go/linkname "iscgo"} iscgo)











(go/var ^{:tag (func []) :doc "set_crosscall2 is set by the runtime/cgo package\nset_crosscall2 should be an internal detail,\nbut widely used packages access it using linkname.\nNotable members of the hall of shame include:\n  - github.com/ebitengine/purego\n\nDo not remove or change the type signature.\nSee go.dev/issue/67401.\n" :go/linkname "set_crosscall2"} set_crosscall2)



(go/var ^{:tag bool :doc "cgoHasExtraM is set on startup when an extra M is created for cgo.\nThe extra M must be created before any C/C++ code calls cgocallback.\n"} cgoHasExtraM)








^{:go/end 77} (go/func cgoUse "cgoUse is called by cgo-generated code (using go:linkname to get at\nan unexported name). The calls serve two purposes:\n1) they are opaque to escape analysis, so the argument is considered to\nescape to the heap.\n2) they keep the argument alive until the call site; the call is emitted after\nthe end of the (presumed) use of the argument by C.\ncgoUse should not actually be called (see cgoAlwaysFalse).\n" [any] (throw "cgoUse should not be called"))







^{:go/end 85} (go/func cgoKeepAlive "cgoKeepAlive is called by cgo-generated code (using go:linkname to get at\nan unexported name). This call keeps its argument alive until the call site;\ncgo emits the call after the last possible use of the argument by C code.\ncgoKeepAlive is marked in the cgo-generated code as //go:noescape, so\nunlike cgoUse it does not force the argument to escape to the heap.\nThis is used to implement the #cgo noescape directive.\n" [any] (throw "cgoKeepAlive should not be called"))







(go/var ^{:tag bool :doc "cgoAlwaysFalse is a boolean value that is always false.\nThe cgo-generated code says if cgoAlwaysFalse { cgoUse(p) },\nor if cgoAlwaysFalse { cgoKeepAlive(p) }.\nThe compiler cannot see that cgoAlwaysFalse is always false,\nso it emits the test and keeps the call, giving the desired\nescape/alive analysis result. The test is cheaper than the call.\n"} cgoAlwaysFalse)

(go/var cgo_yield (addr _cgo_yield))

^{:go/end 103} (go/func cgoNoCallback [^bool v]
  (let [g (getg)]
    (when (and (.-nocgocallback g) v)
      (panic "runtime: unexpected setting cgoNoCallback"))

    (set! (.-nocgocallback g) v)))

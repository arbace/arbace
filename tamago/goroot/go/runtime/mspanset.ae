      ^{:line 90 :tag (* spanSetBlock)} block (zero (* spanSetBlock))]
    (label :retry
      (if (< top spineLen)
        (set! block (.Load (.lookup (.Load (.-spine b)) top)))
        (do
          ;; Add a new block to the spine, potentially growing
          ;; the spine.
          (lock (addr (.-spineLock b)))
          ;; spineLen cannot change until we release the lock,
          ;; but may have changed while we were waiting.
          (set! spineLen (.Load (.-spineLen b)))
          (when (< top spineLen)
            (unlock (addr (.-spineLock b)))
            (goto :retry))


          (let [spine (.Load (.-spine b))]
            (when (== spineLen (.-spineCap b))
              ;; Grow the spine.
              (let [newCap (* (.-spineCap b) 2)]
                (when (== newCap 0)

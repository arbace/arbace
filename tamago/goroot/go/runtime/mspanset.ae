(go/type spanSet "A spanSet is a set of *mspans.\n\nspanSet is safe for concurrent push and pop operations.\n" (struct
    ;; A spanSet is a two-level data structure consisting of a
    ;; growable spine that points to fixed-sized blocks. The spine
    ;; can be accessed without locks, but adding a block or
    ;; growing it requires taking the spine lock.
    ;;
    ;; Because each mspan covers at least 8K of heap and takes at
    ;; most 8 bytes in the spanSet, the growth of the spine is
    ;; quite limited.
    ;;
    ;; The spine and all blocks are allocated off-heap, which
    ;; allows this to be used in the memory manager and avoids the
    ;; need for write barriers on all of these. spanSetBlocks are
    ;; managed in a pool, though never freed back to the operating
    ;; system. We never release spine memory because there could be
    ;; concurrent lock-free access and we're likely to reuse it
    ;; anyway. (In principle, we could do this during STW.)

    ^{:line 35 :tag mutex} spineLock
    ^{:line 36 :tag atomicSpanSetSpinePointer} spine ; *[N]atomic.Pointer[spanSetBlock]
    ^{:line 37 :tag atomic/Uintptr} spineLen ; Spine array length
    ^{:line 38 :tag uintptr} spineCap ; Spine array cap, accessed under spineLock












    ^{:line 51 :tag atomicHeadTailIndex :doc "index is the head and tail of the spanSet in a single field.\nThe head and the tail both represent an index into the logical\nconcatenation of all blocks, with the head always behind or\nequal to the tail (indicating an empty set). This field is\nalways accessed atomically.\n\nThe head and the tail are only 32 bits wide, which means we\ncan only support up to 2^32 pushes before a reset. If every\nspan in the heap were stored in this set, and each span were\nthe minimum size (1 runtime page, 8 KiB), then roughly the\nsmallest heap which would be unrepresentable is 32 TiB in size.\n"} index))


(go/const
  ^{:line 55} [^{:val 512} spanSetBlockEntries 512] ; 4KB on 64-bit
  ^{:line 56} [^{:val 256} spanSetInitSpineCap 256]) ; Enough for 1GB heap on 64-bit



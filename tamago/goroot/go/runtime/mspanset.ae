      ^{:line 152 :tag uint32} backoff (zero uint32)]
    ;; TODO: tweak backoff parameters on other architectures.
    (when (== GOARCH "arm64")
      (set! backoff 128))

    (label :claimLoop
      (while true
        (let [headtail (.load (.-index b))]
          (set! (values head tail) (.split headtail))
          (when (>= head tail)

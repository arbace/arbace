    ^{:line 61 :doc "Free spanSetBlocks are managed via a lock-free stack.\n"} lfnode




    ^{:line 66 :tag atomic/Uint32 :doc "popped is the number of pop operations that have occurred on\nthis block. This number is used to help determine when a block\nmay be safely recycled.\n"} popped))



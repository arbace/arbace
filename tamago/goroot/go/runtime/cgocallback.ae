(in-ns 'go.runtime) (go/file "cgocallback.go" :imports [])

;; These functions are called from C code via cgo/callbacks.go.

;; Panic.

^{:go/end 13} (go/func _cgo_panic_internal [^{:tag (* byte)} p]
  (panic (gostringnocopy p)))

(in-ns 'go.runtime) (go/file "linkname.go" :imports [

    ^{:line 7} [_ "unsafe"]])

;; used in internal/godebug and syscall
(go/directive "//go:linkname write")

;; used by cgo
(go/directive "//go:linkname _cgo_panic_internal")
(go/directive "//go:linkname cgoAlwaysFalse")
(go/directive "//go:linkname cgoUse")
(go/directive "//go:linkname cgoKeepAlive")
(go/directive "//go:linkname cgoCheckPointer")
(go/directive "//go:linkname cgoCheckResult")
(go/directive "//go:linkname cgoNoCallback")
(go/directive "//go:linkname gobytes")
(go/directive "//go:linkname gostringn")

;; used in plugin
(go/directive "//go:linkname doInit")

;; used in math/bits
(go/directive "//go:linkname overflowError")
(go/directive "//go:linkname divideError")

;; used in tests
(go/directive "//go:linkname extraMInUse")
(go/directive "//go:linkname blockevent")
(go/directive "//go:linkname haveHighResSleep")
(go/directive "//go:linkname blockUntilEmptyFinalizerQueue")
(go/directive "//go:linkname lockedOSThread")

(go/type listHead "listHead points to the head of an intrusive doubly-linked list.\n\nPrior to use, you must call init to store the offset of listNode fields.\n\nEvery object in the list should be the same type.\n" (struct
    ^{:line 17 :tag unsafe/Pointer} obj

    ^{:line 19 :tag bool} initialized
    ^{:line 20 :tag uintptr} nodeOffset))




^{:go/end 28} (go/method init "init initializes the list head. off is the offset (via unsafe.Offsetof) of\nthe listNode field in the objects in the list.\n" [^{:tag (* listHead)} head ^uintptr off]
  (set! (.-initialized head) true)
  (set! (.-nodeOffset head) off))

















(go/type listNode "listNode is the linked list node for objects in a listHead list.\n\nlistNode must be stored as a field in objects placed in the linked list. The\noffset of the field is registered via listHead.init.\n\nFor example:\n\n\ttype foo struct {\n\t\tval int\n\n\t\tnode listNode\n\t}\n\nvar fooHead listHead\nfooHead.init(unsafe.Offsetof(foo{}.node))\n" (struct
    ^{:line 46 :tag unsafe/Pointer} prev
    ^{:line 47 :tag unsafe/Pointer} next))


^{:go/end 59} (go/method getNode ^{:tag (* listNode)} [^{:tag (* listHead)} head ^unsafe/Pointer p]
  (when (not (.-initialized head))
    (throw "runtime: uninitialized listHead"))


  (when (== p nil)
    (return nil))

  (conv (* listNode) (unsafe/Add p (.-nodeOffset head))))



^{:go/end 64} (go/method empty "Returns true if the list is empty.\n" ^bool [^{:tag (* listHead)} head]
  (== (.-obj head) nil))



^{:go/end 69} (go/method head "Returns the head of the list without removing it.\n" ^unsafe/Pointer [^{:tag (* listHead)} head]
  (.-obj head))



^{:go/end 86} (go/method push "Push p onto the front of the list.\n" [^{:tag (* listHead)} head ^unsafe/Pointer p]
  ;; p becomes the head of the list.

  ;; ... so p's next is the current head.
  (let [pNode (.getNode head p)]
    (set! (.-next pNode) (.-obj head))

    ;; ... and the current head's prev is p.
    (when (!= (.-obj head) nil)
      (let [headNode (.getNode head (.-obj head))]
        (set! (.-prev headNode) p)))


    (set! (.-obj head) p)))



^{:go/end 111} (go/method pop "Pop removes the head of the list.\n" ^unsafe/Pointer [^{:tag (* listHead)} head]
  (when (== (.-obj head) nil)
    (return nil))


  ;; Return the head of the list.
  (let [p (.-obj head)

      ;; ... so the new head is p's next.
      ^{:line 98} pNode (.getNode head p)]
    (set! (.-obj head) (.-next pNode))
    ;; p is no longer on the list. Clear next to remove unused references.
    ;; N.B. as the head, prev must already be nil.
    (set! (.-next pNode) nil)

    ;; ... and the new head no longer has a prev.
    (when (!= (.-obj head) nil)
      (let [headNode (.getNode head (.-obj head))]
        (set! (.-prev headNode) nil)))


    ^{:line 110} p))



^{:go/end 136} (go/method remove "Remove p from the middle of the list.\n" [^{:tag (* listHead)} head ^unsafe/Pointer p]
  (when (== (.-obj head) p)
    ;; Use pop to ensure head is updated when removing the head.
    (.pop head)
    (return))


  (let [pNode (.getNode head p)
      ^{:line 122} prevNode (.getNode head (.-prev pNode))
      ^{:line 123} nextNode (.getNode head (.-next pNode))]

    ;; Link prev to next.
    (when (!= prevNode nil)
      (set! (.-next prevNode) (.-next pNode)))

    ;; Link next to prev.
    (when (!= nextNode nil)
      (set! (.-prev nextNode) (.-prev pNode)))


    (set! (.-prev pNode) nil)
    (set! (.-next pNode) nil)))

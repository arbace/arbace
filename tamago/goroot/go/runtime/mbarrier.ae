^{:go/end 399} (go/func ^{:go/linkname "reflect_typedmemclrpartial reflect.typedmemclrpartial"} reflect_typedmemclrpartial [^{:tag (* _type)} typ ^unsafe/Pointer ptr ^uintptr off ^uintptr size]
  (when (and (.-enabled writeBarrier) (.Pointers typ))
    ;; Pass nil for the type. ptr does not point to value of type typ,
    ;; but rather points into one so it's not safe to apply the optimization.
    ;; See the comment on this function in the reflect package and the
    ;; comment on bulkBarrierPreWrite.
    (bulkBarrierPreWrite (conv uintptr ptr) 0 size nil))

  (memclrNoHeapPointers ptr size))



^{:go/end 410} (go/func ^{:go/linkname "reflect_typedarrayclear reflect.typedarrayclear"} reflect_typedarrayclear [^{:tag (* _type)} typ ^unsafe/Pointer ptr ^int len]
  (let [size (* (.-Size_ typ) (conv uintptr len))]
    (when (and (.-enabled writeBarrier) (.Pointers typ))
      ;; This always clears whole elements of an array, so it's
      ;; safe to pass a type here. See the comment on bulkBarrierPreWrite.
      (bulkBarrierPreWrite (conv uintptr ptr) 0 size typ))

    (memclrNoHeapPointers ptr size)))

















^{:go/end 431} (go/func ^:go/nosplit ^{:go/linkname "memclrHasPointers"} memclrHasPointers "memclrHasPointers clears n bytes of typed memory starting at ptr.\nThe caller must ensure that the type of the object at ptr has\npointers, usually by checking typ.PtrBytes. However, ptr\ndoes not have to point to the start of the allocation.\n\nmemclrHasPointers should be an internal detail,\nbut widely used packages access it using linkname.\nNotable members of the hall of shame include:\n  - github.com/bytedance/sonic\n\nDo not remove or change the type signature.\nSee go.dev/issue/67401.\n" [^unsafe/Pointer ptr ^uintptr n]
  ;; Pass nil for the type since we don't have one here anyway.
  (bulkBarrierPreWrite (conv uintptr ptr) 0 n nil)
  (memclrNoHeapPointers ptr n))

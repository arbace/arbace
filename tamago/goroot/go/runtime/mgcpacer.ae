          ;; allocates the remaining heap bytes up to heapGoal, it will
          ;; have done (or stolen) the remaining amount of scan work.
          ;; Note that the assist ratio values are updated atomically
          ;; but not together. This means there may be some degree of
          ;; skew between the two values. This is generally OK as the
          ;; values shift relatively slowly over the course of a GC
          ;; cycle.
          (let [assistWorkPerByte (/ (conv float64 scanWorkRemaining) (conv float64 heapRemaining))
              ^{:line 592} assistBytesPerWork (/ (conv float64 heapRemaining) (conv float64 scanWorkRemaining))]
            (.Store (.-assistWorkPerByte c) assistWorkPerByte)
            (.Store (.-assistBytesPerWork c) assistBytesPerWork)))))))



^{:go/end 684} (go/method endCycle "endCycle computes the consMark estimate for the next cycle.\n" [^{:tag (* gcControllerState)} c ^int64 now ^int procs]
  ;; Record last heap goal for the scavenger.
  ;; We'll be updating the heap goal soon.
  (set! (.-lastHeapGoal gcController) (.heapGoal c))

  ;; Compute the duration of time for which assists were turned on.
  (let [assistDuration (- now (.-markStartTime c))

      ;; Assume background mark hit its utilization goal.
      ^{:line 607} utilization gcBackgroundUtilization]
    ;; Add assist utilization; avoid divide by zero.
    (when (> assistDuration 0)
      (set! utilization + (/ (conv float64 (.Load (.-assistTime c))) (conv float64 (* assistDuration (conv int64 procs))))))


    (when (<= (.Load (.-heapLive c)) (.-triggered c))
      ;; Shouldn't happen, but let's be very safe about this in case the

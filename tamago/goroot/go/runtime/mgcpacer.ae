^{:go/end 1455} (go/method ^:go/nosplit addIdleMarkWorker "addIdleMarkWorker attempts to add a new idle mark worker.\n\nIf this returns true, the caller must become an idle mark worker unless\nthere's no background mark worker goroutines in the pool. This case is\nharmless because there are already background mark workers running.\nIf this returns false, the caller must NOT become an idle mark worker.\n\nnosplit because it may be called without a P.\n" ^bool [^{:tag (* gcControllerState)} c]
  (while true
    (let [old (.Load (.-idleMarkWorkers c))
        (values n max) (values (conv int32 (bit-and old (conv uint64 (bit-not (conv uint32 0))))) (conv int32 (>> old 32)))]
      (when (>= n max)
        ;; See the comment on idleMarkWorkers for why
        ;; n > max is tolerated.
        (return false))

      (when (< n 0)
        (print "n=" n " max=" max "\n")
        (throw "negative idle mark workers"))

      (let [new (bit-or (conv uint64 (conv uint32 (+ n 1))) (<< (conv uint64 max) 32))]
        (when (.CompareAndSwap (.-idleMarkWorkers c) old new)
          (return true))))))












^{:go/end 1469} (go/method ^:go/nosplit needIdleMarkWorker "needIdleMarkWorker is a hint as to whether another idle mark worker is needed.\n\nThe caller must still call addIdleMarkWorker to become one. This is mainly\nuseful for a quick check before an expensive operation.\n\nnosplit because it may be called without a P.\n" ^bool [^{:tag (* gcControllerState)} c]
  (let [p (.Load (.-idleMarkWorkers c))
      (values n max) (values (conv int32 (bit-and p (conv uint64 (bit-not (conv uint32 0))))) (conv int32 (>> p 32)))]
    (< n max)))



^{:go/end 1485} (go/method removeIdleMarkWorker "removeIdleMarkWorker must be called when a new idle mark worker stops executing.\n" [^{:tag (* gcControllerState)} c]
  (while true
    (let [old (.Load (.-idleMarkWorkers c))
        (values n max) (values (conv int32 (bit-and old (conv uint64 (bit-not (conv uint32 0))))) (conv int32 (>> old 32)))]
      (when (< (- n 1) 0)
        (print "n=" n " max=" max "\n")
        (throw "negative idle mark workers"))

      (let [new (bit-or (conv uint64 (conv uint32 (- n 1))) (<< (conv uint64 max) 32))]
        (when (.CompareAndSwap (.-idleMarkWorkers c) old new)
          (return))))))










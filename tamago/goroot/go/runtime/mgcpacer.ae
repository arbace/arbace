^{:go/end 1537} (go/func ^:go/systemstack gcControllerCommit "gcControllerCommit is gcController.commit, but passes arguments from live\n(non-test) data. It also updates any consumers of the GC pacing, such as\nsweep pacing and the background scavenger.\n\nCalls gcController.commit.\n\nThe heap lock must be held, so this must be executed on the system stack.\n" []
  (assertWorldStoppedOrLockHeld (addr (.-lock mheap_)))

  (.commit gcController (isSweepDone))

  ;; Update mark pacing.
  (when (!= gcphase _GCoff)
    (.revise gcController))


  ;; TODO(mknyszek): This isn't really accurate any longer because the heap
  ;; goal is computed dynamically. Still useful to snapshot, but not as useful.
  (let [trace (traceAcquire)]
    (when (.ok trace)
      (.HeapGoal trace)
      (traceRelease trace))


    (let [(values trigger heapGoal) (.trigger gcController)]
      (gcPaceSweeper trigger)
      (gcPaceScavenger (.Load (.-memoryLimit gcController)) heapGoal (.-lastHeapGoal gcController)))))

^{:go/end 381} (go/method init [^{:tag (* gcControllerState)} c ^int32 gcPercent ^int64 memoryLimit]
  (set! (.-heapMinimum c) defaultHeapMinimum)
  (set! (.-triggered c) (bit-not (conv uint64 0)))
  (.setGCPercent c gcPercent)
  (.setMemoryLimit c memoryLimit)
  (.commit c true)) ; No sweep phase in the first GC cycle.
;; N.B. Don't bother calling traceHeapGoal. Tracing is never enabled at
;; initialization time.
;; N.B. No need to call revise; there's no GC enabled during
;; initialization.





^{:go/end 468} (go/method startCycle "startCycle resets the GC controller's state and computes estimates\nfor a new GC cycle. The caller must hold worldsema and the world\nmust be stopped.\n" [^{:tag (* gcControllerState)} c ^int64 markStartTime ^int procs ^gcTrigger trigger]
  (.Store (.-heapScanWork c) 0)
  (.Store (.-stackScanWork c) 0)
  (.Store (.-globalsScanWork c) 0)
  (.Store (.-bgScanCredit c) 0)
  (.Store (.-assistTime c) 0)
  (.Store (.-dedicatedMarkTime c) 0)
  (.Store (.-fractionalMarkTime c) 0)
  (.Store (.-idleMarkTime c) 0)
  (set! (.-markStartTime c) markStartTime)
  (set! (.-triggered c) (.Load (.-heapLive c)))

  ;; Compute the background mark utilization goal. In general,
  ;; this may not come out exactly. We round the number of
  ;; dedicated workers so that the utilization is closest to
  ;; 25%. For small GOMAXPROCS, this would introduce too much
  ;; error, so we add fractional workers in that case.
  (let [totalUtilizationGoal (* (conv float64 procs) gcBackgroundUtilization)
      ^{:line 404} dedicatedMarkWorkersNeeded (conv int64 (+ totalUtilizationGoal 0.5))
      ^{:line 405} utilError (- (/ (conv float64 dedicatedMarkWorkersNeeded) totalUtilizationGoal) 1)
      ^:const ^{:line 406 :val 0.3} maxUtilError 0.3]
    (if (or (< utilError (- maxUtilError)) (> utilError maxUtilError)) (do
        ;; Rounding put us more than 30% off our goal. With
        ;; gcBackgroundUtilization of 25%, this happens for
        ;; GOMAXPROCS<=3 or GOMAXPROCS=6. Enable fractional
        ;; workers to compensate.
        (when (> (conv float64 dedicatedMarkWorkersNeeded) totalUtilizationGoal)
          ;; Too many dedicated workers.
          (dec! dedicatedMarkWorkersNeeded))

        (set! (.-fractionalUtilizationGoal c) (/ (- totalUtilizationGoal (conv float64 dedicatedMarkWorkersNeeded)) (conv float64 procs))))

      (set! (.-fractionalUtilizationGoal c) 0))


    ;; In STW mode, we just want dedicated workers.
    (when (> (.-gcstoptheworld debug) 0)
      (set! dedicatedMarkWorkersNeeded (conv int64 procs))
      (set! (.-fractionalUtilizationGoal c) 0))


    ;; Clear per-P state
    (range [_ p allp]
      (set! (.-gcAssistTime p) 0)
      (.Store (.-gcFractionalMarkTime p) 0))


    (if (== (.-kind trigger) gcTriggerTime)
      ;; During a periodic GC cycle, reduce the number of idle mark workers
      ;; required. However, we need at least one dedicated mark worker or
      ;; idle GC worker to ensure GC progress in some scenarios (see comment
      ;; on maxIdleMarkWorkers).
      (if (> dedicatedMarkWorkersNeeded 0)
        (.setMaxIdleMarkWorkers c 0)

        ;; TODO(mknyszek): The fundamental reason why we need this is because
        ;; we can't count on the fractional mark worker to get scheduled.
        ;; Fix that by ensuring it gets scheduled according to its quota even
        ;; if the rest of the application is idle.
        (.setMaxIdleMarkWorkers c 1))


      ;; N.B. gomaxprocs and dedicatedMarkWorkersNeeded are guaranteed not to
      ;; change during a GC cycle.
      (.setMaxIdleMarkWorkers c (- (conv int32 procs) (conv int32 dedicatedMarkWorkersNeeded))))


    ;; Compute initial values for controls that are updated
    ;; throughout the cycle.
    (.Store (.-dedicatedMarkWorkersNeeded c) dedicatedMarkWorkersNeeded)
    (.revise c)

    (when (> (.-gcpacertrace debug) 0)
      (let [heapGoal (.heapGoal c)
          ^{:line 460} assistRatio (.Load (.-assistWorkPerByte c))]
        ^{:go/breaks [3 10 12]} (print "pacer: assist ratio=" assistRatio
          " (scan " (>> (.Load (.-heapScan gcController)) 20) " MB in "
          (>> (.-initialHeapLive work) 20) "->"
          (>> heapGoal 20) " MB)"
          " workers=" dedicatedMarkWorkersNeeded
          "+" (.-fractionalUtilizationGoal c) "\n")))))

























^{:go/end 595} (go/method revise "revise updates the assist ratio during the GC cycle to account for\nimproved estimates. This should be called whenever gcController.heapScan,\ngcController.heapLive, or if any inputs to gcController.heapGoal are\nupdated. It is safe to call concurrently, but it may race with other\ncalls to revise.\n\nThe result of this race is that the two assist ratio values may not line\nup or may be stale. In practice this is OK because the assist ratio\nmoves slowly throughout a GC cycle, and the assist ratio is a best-effort\nheuristic anyway. Furthermore, no part of the heuristic depends on\nthe two assist ratio values being exact reciprocals of one another, since\nthe two values are used to convert values from different sources.\n\nThe worst case result of this raciness is that we may miss a larger shift\nin the ratio (say, if we decide to pace more aggressively against the\nhard heap goal) but even this \"hard goal\" is best-effort (see #40460).\nThe dedicated GC should ensure we don't exceed the hard goal by too much\nin the rare case we do exceed it.\n\nIt should only be called when gcBlackenEnabled != 0 (because this\nis when assists are enabled and the necessary statistics are\navailable).\n" [^{:tag (* gcControllerState)} c]
  (let [gcPercent (.Load (.-gcPercent c))]
    (when (< gcPercent 0)
      ;; If GC is disabled but we're running a forced GC,
      ;; act like GOGC is huge for the below calculations.
      (set! gcPercent 100000))

    (let [live (.Load (.-heapLive c))
        ^{:line 500} scan (.Load (.-heapScan c))
        ^{:line 501} work (+ (.Load (.-heapScanWork c)) (.Load (.-stackScanWork c)) (.Load (.-globalsScanWork c)))

        ;; Assume we're under the soft goal. Pace GC to complete at
        ;; heapGoal assuming the heap is in steady-state.
        ^{:line 505} heapGoal (conv int64 (.heapGoal c))

        ;; The expected scan work is computed as the amount of bytes scanned last
        ;; GC cycle (both heap and stack), plus our estimate of globals work for this cycle.
        ^{:line 509} scanWorkExpected (conv int64 (+ (.-lastHeapScan c) (.Load (.-lastStackScan c)) (.Load (.-globalsScan c))))

        ;; maxScanWork is a worst-case estimate of the amount of scan work that
        ;; needs to be performed in this GC cycle. Specifically, it represents
        ;; the case where *all* scannable memory turns out to be live, and
        ;; *all* allocated stack space is scannable.
        ^{:line 515} maxStackScan (.Load (.-maxStackScan c))
        ^{:line 516} maxScanWork (conv int64 (+ scan maxStackScan (.Load (.-globalsScan c))))]
      (when (> work scanWorkExpected)
        ;; We've already done more scan work than expected. Because our expectation
        ;; is based on a steady-state scannable heap size, we assume this means our
        ;; heap is growing. Compute a new heap goal that takes our existing runway
        ;; computed for scanWorkExpected and extrapolates it to maxScanWork, the worst-case
        ;; scan work. This keeps our assist ratio stable if the heap continues to grow.
        ;;
        ;; The effect of this mechanism is that assists stay flat in the face of heap
        ;; growths. It's OK to use more memory this cycle to scan all the live heap,
        ;; because the next GC cycle is inevitably going to use *at least* that much
        ;; memory anyway.
        (let [extHeapGoal (+ (conv int64 (* (/ (conv float64 (- heapGoal (conv int64 (.-triggered c)))) (conv float64 scanWorkExpected)) (conv float64 maxScanWork))) (conv int64 (.-triggered c)))]
          (set! scanWorkExpected maxScanWork)

          ;; hardGoal is a hard limit on the amount that we're willing to push back the
          ;; heap goal, and that's twice the heap goal (i.e. if GOGC=100 and the heap and/or
          ;; stacks and/or globals grow to twice their size, this limits the current GC cycle's
          ;; growth to 4x the original live heap's size).
          ;;
          ;; This maintains the invariant that we use no more memory than the next GC cycle
          ;; will anyway.
          (let [hardGoal (conv int64 (* (+ 1.0 (/ (conv float64 gcPercent) 100.0)) (conv float64 heapGoal)))]
            (when (> extHeapGoal hardGoal)
              (set! extHeapGoal hardGoal))

            (set! heapGoal extHeapGoal))))

      (when (> (conv int64 live) heapGoal)
        ;; We're already past our heap goal, even the extrapolated one.
        ;; Leave ourselves some extra runway, so in the worst case we
        ;; finish by that point.
        (let [^:const ^{:val 1.1} maxOvershoot 1.1]
          (set! heapGoal (conv int64 (* (conv float64 heapGoal) maxOvershoot)))

          ;; Compute the upper bound on the scan work remaining.
          (set! scanWorkExpected maxScanWork)))


      ;; Compute the remaining scan work estimate.
      ;;
      ;; Note that we currently count allocations during GC as both
      ;; scannable heap (heapScan) and scan work completed
      ;; (scanWork), so allocation will change this difference
      ;; slowly in the soft regime and not at all in the hard
      ;; regime.
      (let [scanWorkRemaining (- scanWorkExpected work)]
        (when (< scanWorkRemaining 1000)
          ;; We set a somewhat arbitrary lower bound on
          ;; remaining scan work since if we aim a little high,
          ;; we can miss by a little.
          ;;
          ;; We *do* need to enforce that this is at least 1,
          ;; since marking is racy and double-scanning objects
          ;; may legitimately make the remaining scan work
          ;; negative, even in the hard goal regime.
          (set! scanWorkRemaining 1000))


        ;; Compute the heap distance remaining.
        (let [heapRemaining (- heapGoal (conv int64 live))]
          (when (<= heapRemaining 0)

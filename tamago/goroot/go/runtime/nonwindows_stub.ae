(in-ns 'go.runtime) (go/file "nonwindows_stub.go" :build ["//go:build !windows"] :imports [])





(go/const ^{:val 0 :doc "osRelaxMinNS is the number of nanoseconds of idleness to tolerate\nwithout performing an osRelax. Since osRelax may reduce the\nprecision of timers, this should be enough larger than the relaxed\ntimer precision to keep the timer error acceptable.\n"} osRelaxMinNS 0)

(go/var haveHighResSleep true)



^{:go/end 19} (go/func osRelax "osRelax is called by the scheduler when transitioning to and from\nall Ps being idle.\n" [^bool relax])



^{:go/end 23} (go/func enableWER "enableWER is called by setTraceback(\"wer\").\nWindows Error Reporting (WER) is only supported on Windows.\n" [])




(go/type winlibcall "winlibcall is not implemented on non-Windows systems,\nbut it is used in non-OS-specific parts of the runtime.\nDefine it as an empty struct to avoid wasting stack space.\n" (struct))

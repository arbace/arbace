(in-ns 'go.runtime) (go/file "compiler.go" :imports [])






(go/const ^{:val "gc" :doc "Compiler is the name of the compiler toolchain that built the\nrunning binary. Known toolchains are:\n\n\tgc      Also known as cmd/compile.\n\tgccgo   The gccgo front end, part of the GCC compiler suite.\n"} Compiler "gc")

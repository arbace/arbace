            (dumpint (conv uint64 (conv uintptr (conv unsafe/Pointer (.-link p)))))))))))



^{:go/end 434} (go/func dumpgs []
  (assertWorldStopped)

  ;; goroutines & stacks
  (forEachG ^{:go/end 433} (fn [^{:tag (* g)} gp]
      (let [status (readgstatus gp)] ; The world is stopped so gp will not be in a scan state.
        (switch status
          (case [_Grunning]
            ;; Dump goroutine if it's _Grunning only during a syscall. This is safe
            ;; because the goroutine will just park without mutating its stack, since
            ;; the world is stopped.
            (when (!= (.-syscallsp gp) 0)
              (dumpgoroutine gp))

            (fallthrough))
          (default
            (print "runtime: unexpected G.status " (conv hex status) "\n")
            (throw "dumpgs in STW - bad status"))
          (case [_Gdead _Gdeadextra])
          ;; ok
          (case [_Grunnable
              ^{:line 429} _Gsyscall
              ^{:line 430} _Gwaiting]
            (dumpgoroutine gp)))))))





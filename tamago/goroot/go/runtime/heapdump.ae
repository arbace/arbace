          (dumpint (conv uint64 (conv uintptr (conv unsafe/Pointer d))))
          (dumpint (conv uint64 (conv uintptr (conv unsafe/Pointer gp))))
          (dumpint (conv uint64 (.-sp d)))
          (dumpint (conv uint64 (.-pc d)))
          (let [fn @(conv (* (* funcval)) (conv unsafe/Pointer (addr (.-fn d))))]

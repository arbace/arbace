^{:go/end 97} (go/func dwrite [^unsafe/Pointer data ^uintptr len]
  (when (== len 0)
    (return))

  (when (<= (+ nbuf len) bufSize)
    (copy (subslice buf nbuf) (subslice (conv (* (array bufSize byte)) data) _ len))
    (set! nbuf + len)
    (return))


  (write dumpfd (conv unsafe/Pointer (addr buf)) (conv int32 nbuf))
  (if (>= len bufSize) (do
      (write dumpfd data (conv int32 len))
      (set! nbuf 0))
    (do
      (copy (subslice buf) (subslice (conv (* (array bufSize byte)) data) _ len))
      (set! nbuf len))))




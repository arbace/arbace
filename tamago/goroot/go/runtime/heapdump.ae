^{:go/end 210} (go/func dumptype "dump information for a type.\n" [^{:tag (* _type)} t]
  (when (== t nil)
    (return))


  ;; If we've definitely serialized the type before,
  ;; no need to do it again.
  (let [b (addr (aget typecache (bit-and (.-Hash t) (- typeCacheBuckets 1))))]
    (when (== t (aget (.-t b) 0))

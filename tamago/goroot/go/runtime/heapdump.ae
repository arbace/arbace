        (aset (.-t b) 0 t)
        (return)))



    ;; Might not have been dumped yet. Dump it and
    ;; remember we did so.
    (for [j (- typeCacheAssoc 1)] (> j 0) (dec! j)
      (aset (.-t b) j (aget (.-t b) (- j 1))))

    (aset (.-t b) 0 t)

    ;; dump the type
    (dumpint tagType)
    (dumpint (conv uint64 (conv uintptr (conv unsafe/Pointer t))))
    (dumpint (conv uint64 (.-Size_ t)))
    (let [rt (toRType t)]
      (if [x (.Uncommon t)] (or (== x nil) (== (.Name (.nameOff rt (.-PkgPath x))) ""))
        (dumpstr (.string rt))

        (let [pkgpath (.Name (.nameOff rt (.-PkgPath x)))
            ^{:line 203} name (.name rt)]
          (dumpint (conv uint64 (+ (conv uintptr (len pkgpath)) 1 (conv uintptr (len name)))))
          (dwrite (conv unsafe/Pointer (unsafe/StringData pkgpath)) (conv uintptr (len pkgpath)))
          (dwritebyte \.)
          (dwrite (conv unsafe/Pointer (unsafe/StringData name)) (conv uintptr (len name)))))

      (dumpbool (or (not (.IsDirectIface t)) (.Pointers t))))))




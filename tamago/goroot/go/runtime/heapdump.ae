  (dumpint (conv uint64 (.-bss firstmoduledata)))
  (dumpmemrange (conv unsafe/Pointer (.-bss firstmoduledata)) (- (.-ebss firstmoduledata) (.-bss firstmoduledata)))
  (dumpfields (.-gcbssmask firstmoduledata))

  ;; mspan.types
  (range [_ s (.-allspans mheap_)]
    (when (== (.get (.-state s)) mSpanInUse)
      ;; Finalizers
      (for [sp (.-specials s)] (!= sp nil) (set! sp (.-next sp))
        (when (!= (.-kind sp) _KindSpecialFinalizer)
          (continue))

        (let [spf (conv (* specialfinalizer) (conv unsafe/Pointer sp))
            ^{:line 471} p (conv unsafe/Pointer (+ (.base s) (.-offset (.-special spf))))]
          (dumpfinalizer p (.-fn spf) (.-fint spf) (.-ot spf))))))




  ;; Finalizer queue

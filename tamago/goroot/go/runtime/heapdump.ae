    (dumpint (conv uint64 (.-gopc gp)))
    (dumpint (conv uint64 (readgstatus gp)))
    (dumpbool (isSystemGoroutine gp false))
    (dumpbool false) ; isbackground
    (dumpint (conv uint64 (.-waitsince gp)))
    (dumpstr (.String (.-waitreason gp)))
    (dumpint (conv uint64 (conv uintptr (.-ctxt (.-sched gp)))))
    (dumpint (conv uint64 (conv uintptr (conv unsafe/Pointer (.-m gp)))))
    (dumpint (conv uint64 (conv uintptr (conv unsafe/Pointer (.-_defer gp)))))

(ns go.runtime.goos
  (:require [arbace.go :as go]))

(go/package goos
  :path "runtime/goos"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["linux_user.go"]
  :other-files ["linux_user_amd64.s"]
  :init-order [RamStart RamSize RamStackOffset Bloc Exit Hwinit0 InitRNG Hwinit1 Nanotime Task]
  :positions :lines)

(load "goos/linux_user")

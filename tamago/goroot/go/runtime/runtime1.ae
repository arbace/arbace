^{:go/end 769} (go/func ^{:go/linkname "reflect_addReflectOff reflect.addReflectOff"} reflect_addReflectOff "reflect_addReflectOff adds a pointer to the reflection offset lookup map.\n" ^int32 [^unsafe/Pointer ptr]
  (reflectOffsLock)
  (when (== (.-m reflectOffs) nil)
    (set! (.-m reflectOffs) (make (map int32 unsafe/Pointer)))
    (set! (.-minv reflectOffs) (make (map unsafe/Pointer int32)))
    (set! (.-next reflectOffs) -1))

  (let [(values id found) (aget (.-minv reflectOffs) ptr)]
    (when (not found)
      (set! id (.-next reflectOffs))
      (dec! (.-next reflectOffs)) ; use negative offsets as IDs to aid debugging
      (aset (.-m reflectOffs) id ptr)
      (aset (.-minv reflectOffs) ptr id))

    (reflectOffsUnlock)

^{:go/end 573} (go/func parsegodebug "parsegodebug parses the godebug string, updating variables listed in dbgvars.\nIf seen == nil, this is startup time and we process the string left to right\noverwriting older settings with newer ones.\nIf seen != nil, $GODEBUG has changed and we are doing an\nincremental update. To avoid flapping in the case where a value is\nset multiple times (perhaps in the default and the environment,\nor perhaps twice in the environment), we process the string right-to-left\nand only change values not already seen. After doing this for both\nthe environment and the default settings, the caller must also call\ncleargodebug(seen) to reset any now-unset values back to their defaults.\n" [^string godebug ^{:tag (map string bool)} seen]
  (for [p godebug] (!= p "") _
    (let [^string field (zero string)]
      (if (== seen nil)
        ;; startup: process left to right, overwriting older settings with newer
        (let [i (bytealg/IndexByteString p \,)]
          (if (< i 0)
            (set! (values field p) (values p ""))

            (set! (values field p) (values (subslice p _ i) (subslice p (+ i 1))))))


        ;; incremental update: process right to left, updating and skipping seen
        (let [i (- (len p) 1)]
          (while (and (>= i 0) (!= (aget p i) \,))
            (dec! i))

          (if (< i 0)
            (set! (values p field) (values "" p))

            (set! (values p field) (values (subslice p _ i) (subslice p (+ i 1)))))))


      (let [i (bytealg/IndexByteString field \=)]
        (when (< i 0)
          (continue))

        (let [(values key value) (values (subslice field _ i) (subslice field (+ i 1)))]

          ;; Setting a removed GODEBUG is ok unless it's set to an old value.
          ;; We only check at startup time per go.dev/issue/76163.
          (when (== seen nil)
            (range [_ info godebugs/Removed]
              (when (== (.-Name info) key)
                (when ((.-Old info) value)
                  (set! (.-key invalidGODEBUG) key)
                  (set! (.-value invalidGODEBUG) value)
                  (set! (.-removed invalidGODEBUG) (.-Removed info))
                  (return)) ; this skips the cgocheck below but we're about to fatal anyway

                (break))))




          (when (aget seen key)
            (continue))

          (when (!= seen nil)
            (aset seen key true))


          ;; Update MemProfileRate directly here since it
          ;; is int, not int32, and should only be updated
          ;; if specified in GODEBUG.
          (if (and (== seen nil) (== key "memprofilerate"))
            (when [(values n err) (strconv/Atoi value)] (== err nil)
              (set! MemProfileRate n))


            (range [_ v dbgvars]
              (when (== (.-name v) key)
                (when [(values n err) (strconv/ParseInt value 10 32)] (== err nil)
                  (cond (and (== seen nil) (!= (.-value v) nil))
                    (set! @(.-value v) (conv int32 n))
                    (!= (.-atomic v) nil)
                    (.Store (.-atomic v) (conv int32 n)))))))))))







  (when (> (.-cgocheck debug) 1)
    (throw "cgocheck > 1 mode is no longer supported at runtime. Use GOEXPERIMENT=cgocheck2 at build time instead.")))




^{:go/end 611} (go/func ^{:go/linkname "setTraceback runtime/debug.SetTraceback"} setTraceback [^string level]
  (let [^uint32 t (zero uint32)]
    (switch level
      (case ["none"]
        (set! t 0))
      (case ["single" ""]
        (set! t (<< 1 tracebackShift)))
      (case ["all"]
        (set! t (bit-or (<< 1 tracebackShift) tracebackAll)))
      (case ["system"]
        (set! t (bit-or (<< 2 tracebackShift) tracebackAll)))
      (case ["crash"]
        (set! t (bit-or (<< 2 tracebackShift) tracebackAll tracebackCrash)))
      (case ["wer"]
        (when (== GOOS "windows")
          (set! t (bit-or (<< 2 tracebackShift) tracebackAll tracebackCrash))
          (enableWER)
          (break))

        (fallthrough))

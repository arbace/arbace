^{:go/end 147} (go/func testAtomic64 []
  (set! test_z64 42)
  (set! test_x64 0)
  (when (atomic/Cas64 (addr test_z64) test_x64 1)
    (throw "cas64 failed"))

  (when (!= test_x64 0)
    (throw "cas64 failed"))

  (set! test_x64 42)
  (when (not (atomic/Cas64 (addr test_z64) test_x64 1))
    (throw "cas64 failed"))

  (when (or (!= test_x64 42) (!= test_z64 1))
    (throw "cas64 failed"))

  (when (!= (atomic/Load64 (addr test_z64)) 1)
    (throw "load64 failed"))

  (atomic/Store64 (addr test_z64) (+ (<< 1 40) 1))
  (when (!= (atomic/Load64 (addr test_z64)) (+ (<< 1 40) 1))
    (throw "store64 failed"))

  (when (!= (atomic/Xadd64 (addr test_z64) (+ (<< 1 40) 1)) (+ (<< 2 40) 2))
    (throw "xadd64 failed"))

  (when (!= (atomic/Load64 (addr test_z64)) (+ (<< 2 40) 2))
    (throw "xadd64 failed"))

  (when (!= (atomic/Xchg64 (addr test_z64) (+ (<< 3 40) 3)) (+ (<< 2 40) 2))
    (throw "xchg64 failed"))

  (when (!= (atomic/Load64 (addr test_z64)) (+ (<< 3 40) 3))
    (throw "xchg64 failed")))




(in-ns 'go.runtime) (go/file "fastlog2.go" :imports [])








^{:go/end 27} (go/func fastlog2 "fastlog2 implements a fast approximation to the base 2 log of a\nfloat64. This is used to compute a geometric distribution for heap\nsampling, without introducing dependencies into package math. This\nuses a very rough approximation using the float64 exponent and the\nfirst 25 bits of the mantissa. The top 5 bits of the mantissa are\nused to load limits from a table of constants and the rest are used\nto scale linearly between them.\n" ^float64 [^float64 x]
  (let [^:const ^{:val 20} fastlogScaleBits 20
      ^:const ^{:line 16 :val 9.5367431640625E-7} fastlogScaleRatio (/ 1.0 (<< 1 fastlogScaleBits))

      ^{:line 18} xBits (float64bits x)
      ;; Extract the exponent from the IEEE float64, and index a constant
      ;; table with the first 10 bits from the mantissa.
      ^{:line 21} xExp (- (conv int64 (bit-and (>> xBits 52) 0x7FF)) 1023)
      ^{:line 22} xManIndex (% (>> xBits (- 52 fastlogNumBits)) (<< 1 fastlogNumBits))
      ^{:line 23} xManScale (% (>> xBits (- 52 fastlogNumBits fastlogScaleBits)) (<< 1 fastlogScaleBits))

      (values low high) (values (aget fastlog2Table xManIndex) (aget fastlog2Table (+ xManIndex 1)))]
    (+ (conv float64 xExp) low (* (- high low) (conv float64 xManScale) fastlogScaleRatio))))

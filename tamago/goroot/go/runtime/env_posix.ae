(in-ns 'go.runtime) (go/file "env_posix.go" :imports [

    ^{:line 7} [unsafe "unsafe"]])

^{:go/end 24} (go/func gogetenv ^string [^string key]
  (when (== GOOS "tamago")
    (return ""))


  ^{:go/breaks [[4 23]]} (let [env (environ)]
    (when (== env nil)
      (throw "getenv before env init"))

    (range [_ s env]
      (when (and (> (len s) (len key)) (== (aget s (len key)) \=) (envKeyEqual (subslice s _ (len key)) key))
        (return (subslice s (+ (len key) 1)))))


    ""))




^{:go/end 40} (go/func envKeyEqual "envKeyEqual reports whether a == b, with ASCII-only case insensitivity\non Windows. The two strings must have the same length.\n" ^bool [^string a ^string b]
  (when (== GOOS "windows") ; case insensitive
    (for [i 0] (< i (len a)) (inc! i)
      (let [(values ca cb) (values (aget a i) (aget b i))]
        (when (or (== ca cb) (== (lowerASCII ca) (lowerASCII cb)))
          (continue))

        (return false)))

    (return true))

  (== a b))


^{:go/end 47} (go/func lowerASCII ^byte [^byte c]
  (when (and (<= \A c) (<= c \Z))
    (return (+ c (- \a \A))))

  ^{:line 46} c)











(go/var ^{:tag unsafe/Pointer :doc "_cgo_setenv should be an internal detail,\nbut widely used packages access it using linkname.\nNotable members of the hall of shame include:\n  - github.com/ebitengine/purego\n\nDo not remove or change the type signature.\nSee go.dev/issue/67401.\n" :go/linkname "_cgo_setenv"} _cgo_setenv) ; pointer to C function










(go/var ^{:tag unsafe/Pointer :doc "_cgo_unsetenv should be an internal detail,\nbut widely used packages access it using linkname.\nNotable members of the hall of shame include:\n  - github.com/ebitengine/purego\n\nDo not remove or change the type signature.\nSee go.dev/issue/67401.\n" :go/linkname "_cgo_unsetenv"} _cgo_unsetenv) ; pointer to C function


^{:go/end 78} (go/func setenv_c "Update the C environment if cgo is loaded.\n" [^string k ^string v]
  (when (== _cgo_setenv nil)
    (return))

  (let [arg (lit (array 2 unsafe/Pointer) (cstring k) (cstring v))]
    (asmcgocall _cgo_setenv (conv unsafe/Pointer (addr arg)))))



^{:go/end 87} (go/func unsetenv_c "Update the C environment if cgo is loaded.\n" [^string k]
  (when (== _cgo_unsetenv nil)
    (return))

  (let [arg (lit (array 1 unsafe/Pointer) (cstring k))]
    (asmcgocall _cgo_unsetenv (conv unsafe/Pointer (addr arg)))))


^{:go/end 93} (go/func cstring ^unsafe/Pointer [^string s]
  (let [p (make (slice byte) (+ (len s) 1))]
    (copy p s)
    (conv unsafe/Pointer (addr (aget p 0)))))

(ns go.runtime.debug
  (:require [arbace.go :as go]))

(go/package debug
  :path "runtime/debug"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["garbage.go" "mod.go" "stack.go" "stubs.go"]
  :other-files ["debug.s"]
  :init-order []
  :positions :lines)

(load "debug/garbage")
(load "debug/mod")
(load "debug/stack")
(load "debug/stubs")

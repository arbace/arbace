;; Valgrind instrumentation is only available on linux amd64 and arm64.



(in-ns 'go.runtime) (go/file "valgrind0.go" :build ["//go:build !valgrind || !linux || (!amd64 && !arm64)"] :imports [

    ^{:line 11} [unsafe "unsafe"]])

(go/const ^{:val false} valgrindenabled false)

^{:go/end 15} (go/func valgrindRegisterStack ^uintptr [^unsafe/Pointer start ^unsafe/Pointer end] 0)
^{:go/end 16} (go/func valgrindDeregisterStack [^uintptr id])
^{:go/end 17} (go/func valgrindChangeStack [^uintptr id ^unsafe/Pointer start ^unsafe/Pointer end])
^{:go/end 18} (go/func valgrindMalloc [^unsafe/Pointer addr ^uintptr size])
^{:go/end 19} (go/func valgrindFree [^unsafe/Pointer addr])
^{:go/end 20} (go/func valgrindCreateMempool [^unsafe/Pointer addr])
^{:go/end 21} (go/func valgrindMempoolMalloc [^unsafe/Pointer pool ^unsafe/Pointer addr ^uintptr size])
^{:go/end 22} (go/func valgrindMempoolFree [^unsafe/Pointer pool ^unsafe/Pointer addr])
^{:go/end 23} (go/func valgrindMakeMemUndefined [^unsafe/Pointer addr ^uintptr size])
^{:go/end 24} (go/func valgrindMakeMemDefined [^unsafe/Pointer addr ^uintptr size])
^{:go/end 25} (go/func valgrindMakeMemNoAccess [^unsafe/Pointer addr ^uintptr size])

(in-ns 'go.runtime) (go/file "complex.go" :imports [])



^{:go/end 15} (go/func inf2one "inf2one returns a signed 1 if f is an infinity and a signed 0 otherwise.\nThe sign of the result is the sign of f.\n" ^float64 [^float64 f]
  (let [g 0.0]
    (when (isInf f)
      (set! g 1.0))

    (copysign g f)))


^{:go/end 61} (go/func complex128div ^complex128 [^complex128 n ^complex128 m]
  (let [(values ^float64 e ^float64 f) (zero float64)] ; complex(e, f) = n/m

    ;; Algorithm for robust complex division as described in
    ;; Robert L. Smith: Algorithm 116: Complex division. Commun. ACM 5(8): 435 (1962).
    (if (>= (abs (real m)) (abs (imag m)))
      (let [ratio (/ (imag m) (real m))
          ^{:line 24} denom (+ (real m) (* ratio (imag m)))]
        (set! e (/ (+ (real n) (* (imag n) ratio)) denom))
        (set! f (/ (- (imag n) (* (real n) ratio)) denom)))

      (let [ratio (/ (real m) (imag m))
          ^{:line 29} denom (+ (imag m) (* ratio (real m)))]
        (set! e (/ (+ (* (real n) ratio) (imag n)) denom))
        (set! f (/ (- (* (imag n) ratio) (real n)) denom))))


    (when (and (isNaN e) (isNaN f))
      ;; Correct final result to infinities and zeros if applicable.
      ;; Matches C99: ISO/IEC 9899:1999 - G.5.1  Multiplicative operators.

      (let [(values a b) (values (real n) (imag n))
          (values c d) (values (real m) (imag m))]

        (switch
          (case [(and (== m 0) ^:go/paren (or (not (isNaN a)) (not (isNaN b))))]
            (set! e (* (copysign inf c) a))
            (set! f (* (copysign inf c) b)))

          (case [(and ^:go/paren (or (isInf a) (isInf b)) (isFinite c) (isFinite d))]
            (set! a (inf2one a))
            (set! b (inf2one b))
            (set! e (* inf (+ (* a c) (* b d))))
            (set! f (* inf (- (* b c) (* a d)))))

          (case [(and ^:go/paren (or (isInf c) (isInf d)) (isFinite a) (isFinite b))]
            (set! c (inf2one c))
            (set! d (inf2one d))
            (set! e (* 0 (+ (* a c) (* b d))))
            (set! f (* 0 (- (* b c) (* a d))))))))



    (complex e f)))

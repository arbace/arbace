;; Package cmp provides types and functions related to comparing
;; ordered values.
(in-ns 'go.cmp) (go/file "cmp.go" :doc "Package cmp provides types and functions related to comparing\nordered values.\n" :imports [])










(go/type Ordered "Ordered is a constraint that permits any ordered type: any type\nthat supports the operators < <= >= >.\nIf future releases of Go add new ordered types,\nthis constraint will be modified to include them.\n\nNote that floating-point types may contain NaN (\"not-a-number\") values.\nAn operator such as == or < will always report false when\ncomparing a NaN value with any other value, NaN or not.\nSee the [Compare] function for a consistent way to compare NaN values.\n" (interface
    (| (tilde int) (tilde int8) (tilde int16) (tilde int32) (tilde int64)
      (tilde uint) (tilde uint8) (tilde uint16) (tilde uint32) (tilde uint64) (tilde uintptr)
      (tilde float32) (tilde float64)
      (tilde string))))





^{:go/end 30} (go/func Less "Less reports whether x is less than y.\nFor floating-point types, a NaN is considered less than any non-NaN,\nand -0.0 is not less than (is equal to) 0.0.\n" :type-params [^Ordered T] ^bool [^T x ^:go/grouped ^T y]
  (or ^:go/paren (and (^{:inst [T]} isNaN x) (not (^{:inst [T]} isNaN y))) (< x y)))










^{:go/end 59} (go/func Compare "Compare returns\n\n\t-1 if x is less than y,\n\t 0 if x equals y,\n\t+1 if x is greater than y.\n\nFor floating-point types, a NaN is considered less than any non-NaN,\na NaN is considered equal to a NaN, and -0.0 is equal to 0.0.\n" :type-params [^Ordered T] ^int [^T x ^:go/grouped ^T y]
  ^{:go/breaks [[6 58]]} (let [xNaN (^{:inst [T]} isNaN x)
      ^{:line 42} yNaN (^{:inst [T]} isNaN y)]
    (when xNaN
      (when yNaN
        (return 0))

      (return -1))

    (when yNaN
      (return (+ 1)))

    (when (< x y)
      (return -1))

    (when (> x y)
      (return (+ 1)))

    0))




^{:go/end 65} (go/func isNaN "isNaN reports whether x is a NaN without requiring the math package.\nThis will always return false if T is not floating-point.\n" :type-params [^Ordered T] ^bool [^T x]
  (!= x x))




^{:go/end 77} (go/func Or "Or returns the first of its arguments that is not equal to the zero value.\nIf no argument is non-zero, it returns the zero value.\n" :type-params [^comparable T] ^T [& ^{:tag (slice T)} vals]
  (let [^T zero (zero T)]
    (range [_ val vals]
      (when (!= val zero)
        (return val)))


    ^{:line 76} zero))

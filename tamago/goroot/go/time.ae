(ns go.time
  (:require [arbace.go :as go]))

(go/package time
  :path "time"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["format.go" "format_rfc3339.go" "sleep.go" "sys_tamago.go" "tick.go" "time.go" "zoneinfo.go" "zoneinfo_read.go" "zoneinfo_tamago.go"]
  :init-order [std0x longDayNames shortDayNames shortMonthNames longMonthNames errAtoi errBad errLeadingInt unitMap startNano utcLoc UTC Local errLocation errBadData platformZoneSources]
  :positions :lines)

(load "time/format")
(load "time/format_rfc3339")
(load "time/sleep")
(load "time/sys_tamago")
(load "time/tick")
(load "time/time")
(load "time/zoneinfo")
(load "time/zoneinfo_read")
(load "time/zoneinfo_tamago")

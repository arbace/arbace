(ns go.time
  (:require [arbace.go :as go]))

(go/package time
  :path "time"
  :files ["format.go" "format_rfc3339.go" "sleep.go" "sys_tamago.go" "tick.go" "time.go" "zoneinfo.go" "zoneinfo_read.go" "zoneinfo_tamago.go"]
  :positions :lines)

(load "time/format")
(load "time/format_rfc3339")
(load "time/sleep")
(load "time/sys_tamago")
(load "time/tick")
(load "time/time")
(load "time/zoneinfo")
(load "time/zoneinfo_read")
(load "time/zoneinfo_tamago")

(ns go.syscall
  (:require [arbace.go :as go]))

(go/package syscall
  :path "syscall"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["dirent.go" "env_unix.go" "fd_tamago.go" "fs_tamago.go" "net.go" "net_tamago.go" "syscall.go" "syscall_tamago.go" "tables_tamago.go" "time_nofake.go" "timestruct.go" "zsyscall_tamago_amd64.go" "zsysnum_tamago_amd64.go"]
  :other-files ["asm_tamago_amd64.s"]
  :init-order [envs copyenv fs fsinit net nextport netprotoAF_INET netprotos signals errorstr errEAGAIN errEINVAL errENOENT errnoByCode]
  :positions :lines)

(load "syscall/dirent")
(load "syscall/env_unix")
(load "syscall/fd_tamago")
(load "syscall/fs_tamago")
(load "syscall/net")
(load "syscall/net_tamago")
(load "syscall/syscall")
(load "syscall/syscall_tamago")
(load "syscall/tables_tamago")
(load "syscall/time_nofake")
(load "syscall/timestruct")
(load "syscall/zsyscall_tamago_amd64")
(load "syscall/zsysnum_tamago_amd64")

(ns go.syscall
  (:require [arbace.go :as go]))

(go/package syscall
  :path "syscall"
  :files ["dirent.go" "env_unix.go" "fd_tamago.go" "fs_tamago.go" "net.go" "net_tamago.go" "syscall.go" "syscall_tamago.go" "tables_tamago.go" "time_nofake.go" "timestruct.go" "zsyscall_tamago_amd64.go" "zsyscall_tamago_arm64.go" "zsysnum_tamago_amd64.go" "zsysnum_tamago_arm64.go"]
  :other-files ["asm_tamago_amd64.s" "asm_tamago_arm64.s"]
  :positions :lines)

(load "syscall/dirent")
(load "syscall/env_unix")
(load "syscall/fd_tamago")
(load "syscall/fs_tamago")
(load "syscall/net")
(load "syscall/net_tamago")
(load "syscall/syscall")
(load "syscall/syscall_tamago")
(load "syscall/tables_tamago")
(load "syscall/time_nofake")
(load "syscall/timestruct")
(load "syscall/zsyscall_tamago_amd64")
(load "syscall/zsyscall_tamago_arm64")
(load "syscall/zsysnum_tamago_amd64")
(load "syscall/zsysnum_tamago_arm64")

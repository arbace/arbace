(in-ns 'go.strconv) (go/file "bytealg.go" :build ["//go:build !compiler_bootstrap"] :imports [

    ^{:line 9} [bytealg "internal/bytealg"]])


^{:go/end 14} (go/func index "index returns the index of the first instance of c in s, or -1 if missing.\n" ^int [^string s ^byte c]
  (bytealg/IndexByteString s c))

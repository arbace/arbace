    (case [\u0007]
      (set! buf (append buf (spread "\\a"))))
    (case [\backspace]
      (set! buf (append buf (spread "\\b"))))
    (case [\formfeed]
      (set! buf (append buf (spread "\\f"))))
    (case [\newline]
      (set! buf (append buf (spread "\\n"))))
    (case [\return]
      (set! buf (append buf (spread "\\r"))))
    (case [\tab]
      (set! buf (append buf (spread "\\t"))))
    (case [\u000b]
      (set! buf (append buf (spread "\\v"))))
    (default
      (switch
        (case [(or (< r \space) (== r 0x7f))]
          (set! buf (append buf (spread "\\x")))
          (set! buf (append buf (aget lowerhex (>> (conv byte r) 4))))
          (set! buf (append buf (aget lowerhex (bit-and (conv byte r) 0xF)))))

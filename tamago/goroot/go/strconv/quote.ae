^{:go/end 115} (go/func appendEscapedRune ^{:tag (slice byte)} [^{:tag (slice byte)} buf ^rune r ^byte quote ^bool ASCIIonly ^bool graphicOnly]
  (when (or (== r (conv rune quote)) (== r \\)) ; always backslashed
    (set! buf (append buf \\))
    (set! buf (append buf (conv byte r)))
    (return buf))

  (cond ASCIIonly
    (when (and (< r utf8/RuneSelf) (IsPrint r))
      (set! buf (append buf (conv byte r)))
      (return buf))

    (or (IsPrint r) (and graphicOnly (isInGraphicList r)))
    (return (utf8/AppendRune buf r)))


^{:go/end 239} (go/func unhex [^byte b] :results [^rune v ^bool ok]
  (let [c (conv rune b)]
    (switch
      (case [(and (<= \0 c) (<= c \9))]
        (return (- c \0) true))
      (case [(and (<= \a c) (<= c \f))]
        (return (+ (- c \a) 10) true))
      (case [(and (<= \A c) (<= c \F))]
        (return (+ (- c \A) 10) true)))

    (return)))
















^{:go/end 364} (go/func UnquoteChar "UnquoteChar decodes the first character or byte in the escaped string\nor character literal represented by the string s.\nIt returns four values:\n\n 1. value, the decoded Unicode code point or byte value;\n 2. multibyte, a boolean indicating whether the decoded character requires a multibyte UTF-8 representation;\n 3. tail, the remainder of the string after the character; and\n 4. an error that will be nil if the character is syntactically valid.\n\nThe second argument, quote, specifies the type of literal being parsed\nand therefore which escaped quote character is permitted.\nIf set to a single quote, it permits the sequence \\' and disallows unescaped '.\nIf set to a double quote, it permits \\\" and disallows unescaped \".\nIf set to zero, it does not permit either escape and allows both quote characters to appear unescaped.\n" [^string s ^byte quote] :results [^rune value ^bool multibyte ^string tail ^error err]
  ;; easy cases
  (when (== (len s) 0)
    (set! err ErrSyntax)
    (return))

  (switch [c (aget s 0)]
    (case [(and (== c quote) ^:go/paren (or (== quote \') (== quote \")))]
      (set! err ErrSyntax)
      (return))
    (case [(>= c utf8/RuneSelf)]
      (let [(values r size) (utf8/DecodeRuneInString s)]
        (return r true (subslice s size) nil)))
    (case [(!= c \\)]
      (return (conv rune (aget s 0)) false (subslice s 1) nil)))


  ;; hard case: c is backslash
  (when (<= (len s) 1)
    (set! err ErrSyntax)
    (return))

  (let [c (aget s 1)]
    (set! s (subslice s 2))

    (switch c
      (case [\a]
        (set! value \u0007))
      (case [\b]
        (set! value \backspace))
      (case [\f]
        (set! value \formfeed))
      (case [\n]
        (set! value \newline))
      (case [\r]
        (set! value \return))
      (case [\t]
        (set! value \tab))
      (case [\v]
        (set! value \u000b))
      (case [\x \u \U]
        (let [n 0]
          (switch c
            (case [\x]
              (set! n 2))
            (case [\u]
              (set! n 4))
            (case [\U]
              (set! n 8)))

          (let [^rune v (zero rune)]
            (when (< (len s) n)
              (set! err ErrSyntax)
              (return))

            (for [j 0] (< j n) (inc! j)
              (let [(values x ok) (unhex (aget s j))]
                (when (not ok)
                  (set! err ErrSyntax)
                  (return))

                (set! v (bit-or (<< v 4) x))))

            (set! s (subslice s n))
            (when (== c \x)
              ;; single-byte string, possibly not UTF-8
              (set! value v)
              (break))

            (when (not (utf8/ValidRune v))
              (set! err ErrSyntax)
              (return))

            (set! value v)
            (set! multibyte true))))
      (case [\0 \1 \2 \3 \4 \5 \6 \7]
        (let [v (- (conv rune c) \0)]
          (when (< (len s) 2)
            (set! err ErrSyntax)
            (return))

          (for [j 0] (< j 2) (inc! j) ; one digit already; two more
            (let [x (- (conv rune (aget s j)) \0)]
              (when (or (< x 0) (> x 7))
                (set! err ErrSyntax)
                (return))

              (set! v (bit-or (<< v 3) x))))

          (set! s (subslice s 2))
          (when (> v 255)
            (set! err ErrSyntax)
            (return))

          (set! value v)))
      (case [\\]
        (set! value \\))
      (case [\' \"]
        (when (!= c quote)
          (set! err ErrSyntax)
          (return))

        (set! value (conv rune c)))
      (default
        (set! err ErrSyntax)
        (return)))

    (set! tail s)
    (return)))





      (set! buf (append buf (aget lowerhex (>> (aget s 0) 4))))
      (set! buf (append buf (aget lowerhex (bit-and (aget s 0) 0xF))))
      (continue))

    (set! buf (appendEscapedRune buf r quote ASCIIonly graphicOnly)))

  (set! buf (append buf quote))

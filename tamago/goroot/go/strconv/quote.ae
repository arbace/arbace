  ;; We know r must fit in 16 bits - see makeisprint.go.
  (when (> r 0xFFFF)
    (return false))

  (let [(values _ found) (^{:inst [(slice uint16) uint16]} bsearch isGraphic (conv uint16 r))]
    ^{:line 580} found))

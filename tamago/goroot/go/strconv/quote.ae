^{:go/breaks [[5 225]] :go/end 226} (go/func CanBackquote "CanBackquote reports whether the string s can be represented\nunchanged as a single-line backquoted string without control\ncharacters other than tab.\n" ^bool [^string s]
  (while (> (len s) 0)
    (let [(values r wid) (utf8/DecodeRuneInString s)]
      (set! s (subslice s wid))
      (when (> wid 1)
        (when (== r \ufeff)
          (return false)) ; BOMs are invisible and should not be quoted.

        (continue)) ; All other multibyte runes are correctly encoded and assumed printable.

      (when (== r utf8/RuneError)
        (return false))

      (when (or ^:go/paren (and (< r \space) (!= r \tab)) (== r \`) (== r \u007f))

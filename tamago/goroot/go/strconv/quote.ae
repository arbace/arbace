^{:go/end 507} (go/func bsearch "bsearch is semantically the same as [slices.BinarySearch] (without NaN checks)\nWe copied this function because we can not import \"slices\" here.\n" :type-params [^{:tag (tilde (slice E))} S ^{:tag (| (tilde uint16) (tilde uint32))} E] [^S s ^E v] :results [int bool]
  (let [n (len s)
      (values i j) (values 0 n)]
    (while (< i j)
      (let [h (+ i (>> (- j i) 1))]
        (if (< (aget s h) v)
          (set! i (+ h 1))

          (set! j h))))


    (return i (and (< i n) (== (aget s i) v)))))


;; TODO: IsPrint is a local implementation of unicode.IsPrint, verified by the tests
;; to give the same answer. It allows this package not to depend on unicode,
;; and therefore not pull in all the Unicode tables. If the linker were better
;; at tossing unused tables, we could get rid of this implementation.
;; That would be nice.




^{:go/end 559} (go/func IsPrint "IsPrint reports whether the rune is defined as printable by Go, with\nthe same definition as [unicode.IsPrint]: letters, numbers, punctuation,\nsymbols and ASCII space.\n" ^bool [^rune r]
  ;; Fast check for Latin-1
  (when (<= r 0xFF)
    (when (and (<= 0x20 r) (<= r 0x7E))
      ;; All the ASCII is printable from space through DEL-1.
      (return true))

    (when (and (<= 0xA1 r) (<= r 0xFF))
      ;; Similarly for ¡ through ÿ...
      (return (!= r 0xAD))) ; ...except for the bizarre soft hyphen.

    (return false))


  ;; Same algorithm, either on uint16 or uint32 value.
  ;; First, find first i such that isPrint[i] >= x.
  ;; This is the index of either the start or end of a pair that might span x.
  ;; The start is even (isPrint[i&^1]) and the end is odd (isPrint[i|1]).
  ;; If we find x in a range, make sure x is not in isNotPrint list.

  (when (and (<= 0 r) (< r (<< 1 16)))
    (let [(values rr isPrint isNotPrint) (values (conv uint16 r) isPrint16 isNotPrint16)
        (values i _) (^{:inst [(slice uint16) uint16]} bsearch isPrint rr)]
      (when (or (>= i (len isPrint)) (< rr (aget isPrint (bit-and-not i 1))) (< (aget isPrint (bit-or i 1)) rr))
        (return false))

      (let [(values _ found) (^{:inst [(slice uint16) uint16]} bsearch isNotPrint rr)]
        (return (not found)))))


  (let [(values rr isPrint isNotPrint) (values (conv uint32 r) isPrint32 isNotPrint32)
      (values i _) (^{:inst [(slice uint32) uint32]} bsearch isPrint rr)]
    (when (or (>= i (len isPrint)) (< rr (aget isPrint (bit-and-not i 1))) (< (aget isPrint (bit-or i 1)) rr))
      (return false))

    (when (>= r 0x20000)
      (return true))

    (set! r - 0x10000)
    (let [(values _ found) (^{:inst [(slice uint16) uint16]} bsearch isNotPrint (conv uint16 r))]
      (not found))))





^{:go/end 569} (go/func IsGraphic "IsGraphic reports whether the rune is defined as a Graphic by Unicode. Such\ncharacters include letters, marks, numbers, punctuation, symbols, and\nspaces, from categories L, M, N, P, S, and Zs.\n" ^bool [^rune r]
  (when (IsPrint r)
    (return true))

  (isInGraphicList r))






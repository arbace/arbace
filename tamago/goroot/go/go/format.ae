(ns go.go.format
  (:require [arbace.go :as go]))

(go/package format
  :path "go/format"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["format.go" "internal.go"]
  :init-order [config]
  :positions :lines)

(load "format/format")
(load "format/internal")

;; Package version provides operations on [Go versions]
;; in [Go toolchain name syntax]: strings like
;; "go1.20", "go1.21.0", "go1.22rc2", and "go1.23.4-custom".
;;
;; [Go versions]: https://go.dev/doc/toolchain#version
;; [Go toolchain name syntax]: https://go.dev/doc/toolchain#name
(in-ns 'go.go.version) (go/file "version.go" :doc "Package version provides operations on [Go versions]\nin [Go toolchain name syntax]: strings like\n\"go1.20\", \"go1.21.0\", \"go1.22rc2\", and \"go1.23.4-custom\".\n\n[Go versions]: https://go.dev/doc/toolchain#version\n[Go toolchain name syntax]: https://go.dev/doc/toolchain#name\n" :imports [ ; import "go/version"


    ^{:line 14} [gover "internal/gover"]
    ^{:line 15} [strings "strings"]])




^{:go/end 26} (go/func stripGo "stripGo converts from a \"go1.21-custom\" version to a \"1.21\" version.\nIf v does not start with \"go\", stripGo returns the empty string (a known invalid version).\n" ^string [^string v]
  (set! (values v _ _) (strings/Cut v "-")) ; strip -custom suffix.
  (when (or (< (len v) 2) (!= (subslice v _ 2) "go"))
    (return ""))

  (subslice v 2))












^{:go/end 48} (go/func Lang "Lang returns the Go language version for version x.\nIf x is not a valid version, Lang returns the empty string.\nFor example:\n\n\tLang(\"go1.21rc2\") = \"go1.21\"\n\tLang(\"go1.21.2\") = \"go1.21\"\n\tLang(\"go1.21\") = \"go1.21\"\n\tLang(\"go1\") = \"go1\"\n\tLang(\"bad\") = \"\"\n\tLang(\"1.21\") = \"\"\n" ^string [^string x]
  (let [v (gover/Lang (stripGo x))]
    (when (== v "")
      (return ""))

    (if (strings/HasPrefix (subslice x 2) v)
      (return (subslice x _ (+ 2 (len v)))) ; "go"+v without allocation

      (return (+ "go" v)))))










^{:go/end 59} (go/func Compare "Compare returns -1, 0, or +1 depending on whether\nx < y, x == y, or x > y, interpreted as Go versions.\nThe versions x and y must begin with a \"go\" prefix: \"go1.21\" not \"1.21\".\nInvalid versions, including the empty string, compare less than\nvalid versions and equal to each other.\nThe language version \"go1.21\" compares less than the\nrelease candidate and eventual releases \"go1.21rc1\" and \"go1.21.0\".\n" ^int [^string x ^string y]
  (gover/Compare (stripGo x) (stripGo y)))



^{:go/end 64} (go/func IsValid "IsValid reports whether the version x is valid.\n" ^bool [^string x]
  (gover/IsValid (stripGo x)))

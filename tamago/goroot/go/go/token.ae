(ns go.go.token
  (:require [arbace.go :as go]))

(go/package token
  :path "go/token"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["position.go" "serialize.go" "token.go" "tree.go"]
  :init-order [tokens]
  :positions :lines)

(load "token/position")
(load "token/serialize")
(load "token/token")
(load "token/tree")

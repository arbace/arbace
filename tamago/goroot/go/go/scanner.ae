(ns go.go.scanner
  (:require [arbace.go :as go]))

(go/package scanner
  :path "go/scanner"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["errors.go" "scanner.go"]
  :init-order [["errors.go" 23 5] prefix]
  :positions :lines)

(load "scanner/errors")
(load "scanner/scanner")

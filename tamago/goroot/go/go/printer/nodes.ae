;; This file implements printing of AST nodes; specifically
;; expressions, statements, declarations, and files. It uses
;; the print functionality implemented in printer.go.

(in-ns 'go.go.printer) (go/file "nodes.go" :imports [


    ^{:line 12} [ast "go/ast"]
    ^{:line 13} [token "go/token"]
    ^{:line 14} [strconv "strconv"]
    ^{:line 15} [strings "strings"]
    ^{:line 16} [unicode "unicode"]
    ^{:line 17} [utf8 "unicode/utf8"]])


;; Formatting issues:
;; - better comment formatting for /*-style comments at the end of a line (e.g. a declaration)
;;   when the comment spans multiple lines; if such a comment is just two lines, formatting is
;;   not idempotent
;; - formatting of expression lists
;; - should use blank instead of tab to separate one-line function bodies from
;;   the function header unless there is a group of consecutive one-liners

;; ----------------------------------------------------------------------------
;; Common AST nodes.















^{:go/end 60} (go/method linebreak "Print as many newlines as necessary (but at least min newlines) to get to\nthe current line. ws is printed before the first line break. If newSection\nis set, the first line break is printed as formfeed. Returns 0 if no line\nbreaks were printed, returns 1 if there was exactly one newline printed,\nand returns a value > 1 if there was a formfeed or more than one newline\nprinted.\n\nTODO(gri): linebreak may add too many lines if the next statement at \"line\"\nis preceded by comments because the computation of n assumes\nthe current position before the comment and the target position\nafter the comment. Thus, after interspersing such comments, the\nspace taken up by them is not considered to reduce the number of\nlinebreaks. At the moment there is no easy way to know about\nfuture (not yet interspersed) comments in this function.\n" [^{:tag (* printer)} p ^int line ^int min ^whiteSpace ws ^bool newSection] :results [^int nbreaks]
  (let [n (max (nlimit (- line (.-Line (.-pos p)))) min)]
    (when (> n 0)
      (.print p ws)
      (when newSection
        (.print p formfeed)
        (dec! n)
        (set! nbreaks 2))

      (set! nbreaks + n)
      (for [] (> n 0) (dec! n)
        (.print p newline)))


    (return)))






^{:go/end 91} (go/method setComment "setComment sets g as the next comment if g != nil and if node comments\nare enabled - this mode is used when printing source code fragments such\nas exports only. It assumes that there is no pending comment in p.comments\nand at most one pending comment in the p.comment cache.\n" [^{:tag (* printer)} p ^{:tag (* ast/CommentGroup)} g]
  (when (or (== g nil) (not (.-useNodeComments p)))
    (return))

  (cond (== (.-comments p) nil)
    ;; initialize p.comments lazily
    (set! (.-comments p) (make (slice (* ast/CommentGroup)) 1))
    (< ^{:go/via [commentInfo]} (.-cindex p) (len (.-comments p))) (do
      ;; for some reason there are pending comments; this
      ;; should never happen - handle gracefully and flush
      ;; all comments up to g, ignore anything after that
      (.flush p (.posFor p (.Pos (aget (.-List g) 0))) token/ILLEGAL)
      (set! (.-comments p) (subslice (.-comments p) 0 1))
      ;; in debug mode, report error
      (.internalError p "setComment found pending comments")))

  (aset (.-comments p) 0 g)
  (set! ^{:go/via [commentInfo]} (.-cindex p) 0)
  ;; don't overwrite any pending comment in the p.comment cache
  ;; (there may be a pending comment when a line comment is
  ;; immediately followed by a lead comment with no other
  ;; tokens between)
  (when (== ^{:go/via [commentInfo]} (.-commentOffset p) infinity)
    (.nextComment p))) ; get comment ready for use



(go/type exprListMode uint)

(go/const
  ^{:line 96} [^{:tag exprListMode :val 1} commaTerm (<< 1 iota)] ; list is optionally terminated by a comma
  ^{:line 97} [^{:val 2} noIndent]) ; no extra indentation in multi-line lists




^{:go/end 113} (go/method identList "If indent is set, a multi-line identifier list is indented after the\nfirst linebreak encountered.\n" [^{:tag (* printer)} p ^{:tag (slice (* ast/Ident))} list ^bool indent]
  ;; convert into an expression list so we can re-use exprList formatting
  (let [xlist (make (slice ast/Expr) (len list))]
    (range [i x list]
      (aset xlist i x))

    (let [^exprListMode mode (zero exprListMode)]
      (when (not indent)
        (set! mode noIndent))

      (.exprList p token/NoPos xlist 1 mode token/NoPos false))))


(go/const ^{:val "contains filtered or unexported fields"} filteredMsg "contains filtered or unexported fields")









^{:go/end 317} (go/method exprList "Print a list of expressions. If the list spans multiple\nsource lines, the original line breaks are respected between\nexpressions.\n\nTODO(gri) Consider rewriting this to be independent of []ast.Expr\nso that we can use the algorithm for any kind of list\n\n\t(e.g., pass list via a channel over which to range).\n" [^{:tag (* printer)} p ^token/Pos prev0 ^{:tag (slice ast/Expr)} list ^int depth ^exprListMode mode ^token/Pos next0 ^bool isIncomplete]
  (when (== (len list) 0)
    (when isIncomplete
      (let [prev (.posFor p prev0)
          ^{:line 129} next (.posFor p next0)]
        (if (and (.IsValid prev) (== (.-Line prev) (.-Line next)))
          (.print p (+ "/* " filteredMsg " */"))
          (do
            (.print p newline)
            (.print p indent (+ "// " filteredMsg) unindent newline)))))


    (return))


  (let [prev (.posFor p prev0)
      ^{:line 141} next (.posFor p next0)
      ^{:line 142} line (.lineFor p (.Pos (aget list 0)))
      ^{:line 143} endLine (.lineFor p (.End (aget list (- (len list) 1))))]

    (when (and (.IsValid prev) (== (.-Line prev) line) (== line endLine))
      ;; all list entries on a single line
      (range [i x list]
        (when (> i 0)
          ;; use position of expression following the comma as
          ;; comma position for correct comment placement
          (.setPos p (.Pos x))
          (.print p token/COMMA blank))

        (.expr0 p x depth))

      (when isIncomplete
        (.print p token/COMMA blank (+ "/* " filteredMsg " */")))

      (return))


    ;; list entries span multiple lines;
    ;; use source code positions to guide line breaks

    ;; Don't add extra indentation if noIndent is set;
    ;; i.e., pretend that the first line is already indented.
    (let [ws ignore]
      (when (== (bit-and mode noIndent) 0)
        (set! ws indent))


      ;; The first linebreak is always a formfeed since this section must not
      ;; depend on any previous formatting.
      (let [prevBreak -1] ; index of last expression that was followed by a linebreak
        (when (and (.IsValid prev) (< (.-Line prev) line) (> (.linebreak p line 0 ws true) 0))
          (set! ws ignore)
          (set! prevBreak 0))


        ;; initialize expression/key size: a zero value indicates expr/key doesn't fit on a single line
        (let [size 0

            ;; We use the ratio between the geometric mean of the previous key sizes and
            ;; the current size to determine if there should be a break in the alignment.
            ;; To compute the geometric mean we accumulate the log₂(size) values (log2sum)
            ;; and the number of sizes included (count).
            ^{:line 187} log2sum 0.0
            ^{:line 188} count 0

            ;; print all list elements
            ^{:line 191} prevLine (.-Line prev)]
          (range [i x list]
            (set! line (.lineFor p (.Pos x)))

            ;; Determine if the next linebreak, if any, needs to use formfeed:
            ;; in general, use the entire node size to make the decision; for
            ;; key:value expressions, use the key size.
            ;; TODO(gri) for a better result, should probably incorporate both
            ;;           the key and the node size into the decision process
            (let [useFF true

                ;; Determine element size: All bets are off if we don't have
                ;; position information for the previous and next token (likely
                ;; generated code - simply ignore the size in this case by setting
                ;; it to 0).
                ^{:line 206} prevSize size
                ^:const ^{:line 207 :val 1000000.0} infinity 1000000.0] ; larger than any source line
              (set! size (.nodeSize p x infinity))
              (let [(values pair isPair) (assert (* ast/KeyValueExpr) x)]
                (if (and (<= size infinity) (.IsValid prev) (.IsValid next))
                  ;; x fits on a single line
                  (when isPair
                    (set! size (.nodeSize p (.-Key pair) infinity))) ; size <= infinity


                  ;; size too large or we don't have good layout information
                  (set! size 0))


                ;; If the previous line and the current line had single-
                ;; line-expressions and the key sizes are small or the
                ;; ratio between the current key and the geometric mean
                ;; if the previous key sizes does not exceed a threshold,
                ;; align columns and do not use formfeed.
                (when (and (> prevSize 0) (> size 0))
                  (let [^:const ^{:val 40} smallSize 40]
                    (if (or (== count 0) (and (<= prevSize smallSize) (<= size smallSize)))
                      (set! useFF false)

                      (let [^:const ^{:val 2.5} r 2.5 ; threshold
                          ^{:line 231} geomean (exp2ish (/ log2sum (conv float64 count))) ; count > 0
                          ^{:line 232} ratio (/ (conv float64 size) geomean)]
                        (set! useFF (or (<= (* r ratio) 1) (<= r ratio)))))))



                (let [needsLinebreak (and (< 0 prevLine) (< prevLine line))]
                  (when (> i 0)
                    ;; Use position of expression following the comma as
                    ;; comma position for correct comment placement, but
                    ;; only if the expression is on the same line.
                    (when (not needsLinebreak)
                      (.setPos p (.Pos x)))

                    (.print p token/COMMA)
                    (let [needsBlank true]
                      (when needsLinebreak
                        ;; Lines are broken using newlines so comments remain aligned
                        ;; unless useFF is set or there are multiple expressions on
                        ;; the same line in which case formfeed is used.
                        (let [nbreaks (.linebreak p line 0 ws (or useFF (< (+ prevBreak 1) i)))]
                          (when (> nbreaks 0)
                            (set! ws ignore)
                            (set! prevBreak i)
                            (set! needsBlank false)) ; we got a line break instead

                          ;; If there was a new section or more than one new line
                          ;; (which means that the tabwriter will implicitly break
                          ;; the section), reset the geomean variables since we are
                          ;; starting a new group of elements with the next element.
                          (when (> nbreaks 1)
                            (set! log2sum 0)
                            (set! count 0))))


                      (when needsBlank
                        (.print p blank))))



                  (if (and (> (len list) 1) isPair (> size 0) needsLinebreak) (do
                      ;; We have a key:value expression that fits onto one line
                      ;; and it's not on the same line as the prior expression:
                      ;; Use a column for the key such that consecutive entries
                      ;; can align if possible.
                      ;; (needsLinebreak is set if we started a new line before)
                      (.expr p (.-Key pair))
                      (.setPos p (.-Colon pair))
                      (.print p token/COLON vtab)
                      (.expr p (.-Value pair)))

                    (.expr0 p x depth))


                  (when (> size 0)
                    (set! log2sum + (log2ish (conv float64 size)))
                    (inc! count))


                  (set! prevLine line)))))


          (when (and (!= (bit-and mode commaTerm) 0) (.IsValid next) (< (.-Line (.-pos p)) (.-Line next)))
            ;; Print a terminating comma if the next token is on a new line.
            (.print p token/COMMA)
            (when isIncomplete
              (.print p newline)
              (.print p (+ "// " filteredMsg)))

            (when (and (== ws ignore) (== (bit-and mode noIndent) 0))
              ;; unindent if we indented
              (.print p unindent))

            (.print p formfeed) ; terminating comma needs a line break to look good
            (return))


          (when isIncomplete
            (.print p token/COMMA newline)
            (.print p (+ "// " filteredMsg) newline))


          (when (and (== ws ignore) (== (bit-and mode noIndent) 0))
            ;; unindent if we indented
            (.print p unindent)))))))



(go/type paramMode int)

(go/const
  ^{:line 322} [^{:tag paramMode :val 0} funcParam iota]
  ^{:line 323} [^{:val 1} funcTParam]
  ^{:line 324} [^{:val 2} typeTParam])


^{:go/end 398} (go/method parameters [^{:tag (* printer)} p ^{:tag (* ast/FieldList)} fields ^paramMode mode]
  (let [(values openTok closeTok) (values token/LPAREN token/RPAREN)]
    (when (!= mode funcParam)
      (set! (values openTok closeTok) (values token/LBRACK token/RBRACK)))

    (.setPos p (.-Opening fields))
    (.print p openTok)
    (when (> (len (.-List fields)) 0)
      (let [prevLine (.lineFor p (.-Opening fields))
          ^{:line 336} ws indent]
        (range [i par (.-List fields)]
          ;; determine par begin and end line (may be different
          ;; if there are multiple parameter names for this par
          ;; or the type is on a separate line)
          (let [parLineBeg (.lineFor p (.Pos par))
              ^{:line 342} parLineEnd (.lineFor p (.End par))
              ;; separating "," if needed
              ^{:line 344} needsLinebreak (and (< 0 prevLine) (< prevLine parLineBeg))]
            (when (> i 0)
              ;; use position of parameter following the comma as
              ;; comma position for correct comma placement, but
              ;; only if the next parameter is on the same line
              (when (not needsLinebreak)
                (.setPos p (.Pos par)))

              (.print p token/COMMA))

            ;; separator if needed (linebreak or blank)
            (cond (and needsLinebreak (> (.linebreak p parLineBeg 0 ws true) 0))
              ;; break line if the opening "(" or previous parameter ended on a different line
              (set! ws ignore)
              (> i 0)
              (.print p blank))

            ;; parameter names
            (when (> (len (.-Names par)) 0)
              ;; Very subtle: If we indented before (ws == ignore), identList
              ;; won't indent again. If we didn't (ws == indent), identList will
              ;; indent if the identList spans multiple lines, and it will outdent
              ;; again at the end (and still ws == indent). Thus, a subsequent indent
              ;; by a linebreak call after a type, or in the next multi-line identList
              ;; will do the right thing.
              (.identList p (.-Names par) (== ws indent))
              (.print p blank))

            ;; parameter type
            (.expr p (stripParensAlways (.-Type par)))
            (set! prevLine parLineEnd)))


        ;; if the closing ")" is on a separate line from the last parameter,
        ;; print an additional "," and line break
        (if [closing (.lineFor p (.-Closing fields))] (and (< 0 prevLine) (< prevLine closing)) (do
            (.print p token/COMMA)
            (.linebreak p closing 0 ignore true))
          (when (and (== mode typeTParam) (== (.NumFields fields) 1) (combinesWithName (stripParensAlways (.-Type (aget (.-List fields) 0)))))
            ;; A type parameter list [P T] where the name P and the type expression T syntactically
            ;; combine to another valid (value) expression requires a trailing comma, as in [P *T,]
            ;; (or an enclosing interface as in [P interface(*T)]), so that the type parameter list
            ;; is not parsed as an array length [P*T].
            (.print p token/COMMA)))


        ;; unindent if we indented
        (when (== ws ignore)
          (.print p unindent))))



    (.setPos p (.-Closing fields))
    (.print p closeTok)))







^{:go/breaks [[5 415]] :go/end 416} (go/func combinesWithName "combinesWithName reports whether a name followed by the expression x\nsyntactically combines to another valid (value) expression. For instance\nusing *T for x, \"name *T\" syntactically appears as the expression x*T.\nOn the other hand, using  P|Q or *P|~Q for x, \"name P|Q\" or \"name *P|~Q\"\ncannot be combined into a valid (value) expression.\n" ^bool [^ast/Expr x]
  (type-switch [x x]
    (case [(* ast/StarExpr)]
      ;; name *x.X combines to name*x.X if x.X is not a type element
      (return (not (isTypeElem (.-X x)))))
    (case [(* ast/BinaryExpr)]
      (return (and (combinesWithName (.-X x)) (not (isTypeElem (.-Y x))))))
    (case [(* ast/ParenExpr)]
      (return (not (isTypeElem (.-X x))))))

  false)




^{:go/breaks [[5 431]] :go/end 432} (go/func isTypeElem "isTypeElem reports whether x is a (possibly parenthesized) type element expression.\nThe result is false if x could be a type element OR an ordinary (value) expression.\n" ^bool [^ast/Expr x]
  (type-switch [x x]
    (case [(* ast/ArrayType) (* ast/StructType) (* ast/FuncType) (* ast/InterfaceType) (* ast/MapType) (* ast/ChanType)]
      (return true))
    (case [(* ast/UnaryExpr)]
      (return (== (.-Op x) token/TILDE)))
    (case [(* ast/BinaryExpr)]
      (return (or (isTypeElem (.-X x)) (isTypeElem (.-Y x)))))
    (case [(* ast/ParenExpr)]
      (return (isTypeElem (.-X x)))))

  false)


^{:go/end 455} (go/method signature [^{:tag (* printer)} p ^{:tag (* ast/FuncType)} sig]
  (when (!= (.-TypeParams sig) nil)
    (.parameters p (.-TypeParams sig) funcTParam))

  (if (!= (.-Params sig) nil)
    (.parameters p (.-Params sig) funcParam)

    (.print p token/LPAREN token/RPAREN))

  (let [res (.-Results sig)
      ^{:line 444} n (.NumFields res)]
    (when (> n 0)
      ;; res != nil
      (.print p blank)
      (when (and (== n 1) (== (.-Names (aget (.-List res) 0)) nil))
        ;; single anonymous res; no ()'s
        (.expr p (stripParensAlways (.-Type (aget (.-List res) 0))))
        (return))

      (.parameters p res funcParam))))



^{:go/end 468} (go/func identListSize [^{:tag (slice (* ast/Ident))} list ^int maxSize] :results [^int size]
  (range [i x list]
    (when (> i 0)
      (set! size + (len ", ")))

    (set! size + (utf8/RuneCountInString (.-Name x)))
    (when (>= size maxSize)
      (break)))


  (return))


^{:go/end 486} (go/method isOneLineFieldList ^bool [^{:tag (* printer)} p ^{:tag (slice (* ast/Field))} list]
  (when (!= (len list) 1)
    (return false)) ; allow only one field

  (let [f (aget list 0)]
    (when (or (!= (.-Tag f) nil) (!= (.-Comment f) nil))
      (return false)) ; don't allow tags or comments

    ;; only name(s) and type
    (let [^:const ^{:val 30} maxSize 30 ; adjust as appropriate, this is an approximate value
        ^{:line 480} namesSize (identListSize (.-Names f) maxSize)]
      (when (> namesSize 0)
        (set! namesSize 1)) ; blank between names and types

      (let [typeSize (.nodeSize p (.-Type f) maxSize)]
        (<= (+ namesSize typeSize) maxSize)))))


^{:go/end 490} (go/method setLineComment [^{:tag (* printer)} p ^string text]
  (.setComment p (addr (lit ast/CommentGroup :List (lit (slice (* ast/Comment)) (lit _ :Slash token/NoPos :Text text))))))


^{:go/end 644} (go/method fieldList [^{:tag (* printer)} p ^{:tag (* ast/FieldList)} fields ^bool isStruct ^bool isIncomplete]
  (let [lbrace (.-Opening fields)
      ^{:line 494} list (.-List fields)
      ^{:line 495} rbrace (.-Closing fields)
      ^{:line 496} hasComments (or isIncomplete (.commentBefore p (.posFor p rbrace)))
      ^{:line 497} srcIsOneLine (and (.IsValid lbrace) (.IsValid rbrace) (== (.lineFor p lbrace) (.lineFor p rbrace)))]

    (when (and (not hasComments) srcIsOneLine)
      ;; possibly a one-line struct/interface
      (cond (== (len list) 0) (do
          ;; no blank between keyword and {} in this case
          (.setPos p lbrace)
          (.print p token/LBRACE)
          (.setPos p rbrace)
          (.print p token/RBRACE)
          (return))
        (.isOneLineFieldList p list) (do
          ;; small enough - print on one line
          ;; (don't use identList and ignore source line breaks)
          (.setPos p lbrace)
          (.print p token/LBRACE blank)
          (let [f (aget list 0)]
            (if isStruct (do
                (range [i x (.-Names f)]
                  (when (> i 0)
                    ;; no comments so no need for comma position
                    (.print p token/COMMA blank))

                  (.expr p x))

                (when (> (len (.-Names f)) 0)
                  (.print p blank))

                (.expr p (.-Type f)))
              (do ; interface
                (if (> (len (.-Names f)) 0)
                  (let [name (aget (.-Names f) 0)] ; method name
                    (.expr p name)
                    (.signature p (assert (* ast/FuncType) (.-Type f)))) ; don't print "func"

                  ;; embedded interface
                  (.expr p (.-Type f)))))


            (.print p blank)
            (.setPos p rbrace)
            (.print p token/RBRACE)
            (return)))))


    ;; hasComments || !srcIsOneLine

    (.print p blank)
    (.setPos p lbrace)
    (.print p token/LBRACE indent)
    (when (or hasComments (> (len list) 0))
      (.print p formfeed))


    (if isStruct

      (let [sep vtab]
        (when (== (len list) 1)
          (set! sep blank))

        (let [^int line (zero int)]
          (range [i f list]
            (when (> i 0)
              (.linebreak p (.lineFor p (.Pos f)) 1 ignore (> (.linesFrom p line) 0)))

            (let [extraTabs 0]
              (.setComment p (.-Doc f))
              (.recordLine p (addr line))
              (if (> (len (.-Names f)) 0) (do
                  ;; named fields
                  (.identList p (.-Names f) false)
                  (.print p sep)
                  (.expr p (.-Type f))
                  (set! extraTabs 1))
                (do
                  ;; anonymous field
                  (.expr p (.-Type f))
                  (set! extraTabs 2)))

              (when (!= (.-Tag f) nil)
                (when (and (> (len (.-Names f)) 0) (== sep vtab))
                  (.print p sep))

                (.print p sep)
                (.expr p (.-Tag f))
                (set! extraTabs 0))

              (when (!= (.-Comment f) nil)
                (for [] (> extraTabs 0) (dec! extraTabs)
                  (.print p sep))

                (.setComment p (.-Comment f)))))


          (when isIncomplete
            (when (> (len list) 0)
              (.print p formfeed))

            (.flush p (.posFor p rbrace) token/RBRACE) ; make sure we don't lose the last line comment
            (.setLineComment p (+ "// " filteredMsg)))))


      ;; interface

      (let [^int line (zero int)
          ^{:line 602 :tag (* ast/Ident)} prev (zero (* ast/Ident))] ; previous "type" identifier
        (range [i f list]
          (let [^{:tag (* ast/Ident)} name (zero (* ast/Ident))] ; first name, or nil
            (when (> (len (.-Names f)) 0)
              (set! name (aget (.-Names f) 0)))

            (when (> i 0)
              ;; don't do a line break (min == 0) if we are printing a list of types
              ;; TODO(gri) this doesn't work quite right if the list of types is
              ;;           spread across multiple lines
              (let [min 1]
                (when (and (!= prev nil) (== name prev))
                  (set! min 0))

                (.linebreak p (.lineFor p (.Pos f)) min ignore (> (.linesFrom p line) 0))))

            (.setComment p (.-Doc f))
            (.recordLine p (addr line))
            (if (!= name nil) (do
                ;; method
                (.expr p name)
                (.signature p (assert (* ast/FuncType) (.-Type f))) ; don't print "func"
                (set! prev nil))
              (do
                ;; embedded interface
                (.expr p (.-Type f))
                (set! prev nil)))

            (.setComment p (.-Comment f))))

        (when isIncomplete
          (when (> (len list) 0)
            (.print p formfeed))

          (.flush p (.posFor p rbrace) token/RBRACE) ; make sure we don't lose the last line comment
          (.setLineComment p "// contains filtered or unexported methods"))))



    (.print p unindent formfeed)
    (.setPos p rbrace)
    (.print p token/RBRACE)))


;; ----------------------------------------------------------------------------
;; Expressions

^{:go/end 696} (go/func walkBinary [^{:tag (* ast/BinaryExpr)} e] :results [^bool has4 ^bool has5 ^int maxProblem]
  (switch (.Precedence (.-Op e))
    (case [4]
      (set! has4 true))
    (case [5]
      (set! has5 true)))


  (type-switch [l (.-X e)]
    (case [(* ast/BinaryExpr)]
      (when (< (.Precedence (.-Op l)) (.Precedence (.-Op e)))
        ;; parens will be inserted.
        ;; pretend this is an *ast.ParenExpr and do nothing.
        (break))

      (let [(values h4 h5 mp) (walkBinary l)]
        (set! has4 (or has4 h4))
        (set! has5 (or has5 h5))
        (set! maxProblem (max maxProblem mp)))))


  (type-switch [r (.-Y e)]
    (case [(* ast/BinaryExpr)]
      (when (<= (.Precedence (.-Op r)) (.Precedence (.-Op e)))
        ;; parens will be inserted.
        ;; pretend this is an *ast.ParenExpr and do nothing.
        (break))

      (let [(values h4 h5 mp) (walkBinary r)]
        (set! has4 (or has4 h4))
        (set! has5 (or has5 h5))
        (set! maxProblem (max maxProblem mp))))

    (case [(* ast/StarExpr)]
      (when (== (.-Op e) token/QUO) ; `*/`
        (set! maxProblem 5)))


    (case [(* ast/UnaryExpr)]
      (switch (+ (.String (.-Op e)) (.String (.-Op r)))
        (case ["/*" "&&" "&^"]
          (set! maxProblem 5))
        (case ["++" "--"]
          (set! maxProblem (max maxProblem 4))))))


  (return))


^{:go/end 713} (go/func cutoff ^int [^{:tag (* ast/BinaryExpr)} e ^int depth]
  ^{:go/breaks [[5 712]]} (let [(values has4 has5 maxProblem) (walkBinary e)]
    (when (> maxProblem 0)
      (return (+ maxProblem 1)))

    (when (and has4 has5)
      (when (== depth 1)
        (return 5))

      (return 4))

    (when (== depth 1)
      (return 6))

    4))


^{:go/end 721} (go/func diffPrec ^int [^ast/Expr expr ^int prec]
  ^{:go/breaks [[3 720]]} (let [(values x ok) (assert (* ast/BinaryExpr) expr)]
    (when (or (not ok) (!= prec (.Precedence (.-Op x))))
      (return 1))

    0))



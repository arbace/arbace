    (return lit)) ; not a number - nothing to do

  (when (< (len (.-Value lit)) 2)
    (return lit)) ; only one digit (common case) - nothing to do

  ;; len(lit.Value) >= 2

  ;; We ignore lit.Kind because for lit.Kind == token.IMAG the literal may be an integer
  ;; or floating-point value, decimal or not. Instead, just consider the literal pattern.
  (let [x (.-Value lit)]
    (switch (subslice x _ 2)
      (default
        ;; 0-prefix octal, decimal int, or float (possibly with 'i' suffix)
        (when [i (strings/LastIndexByte x \E)] (>= i 0)
          (set! x (+ (subslice x _ i) "e" (subslice x (+ i 1))))
          (break))

        ;; remove leading 0's from integer (but not floating-point) imaginary literals
        (when (and (== (aget x (- (len x) 1)) \i) (not (strings/ContainsAny x ".e")))
          (set! x (strings/TrimLeft x "0_"))
          (when (== x "i")
            (set! x "0i"))))


      (case ["0X"]
        (set! x (+ "0x" (subslice x 2)))
        ;; possibly a hexadecimal float
        (when [i (strings/LastIndexByte x \P)] (>= i 0)
          (set! x (+ (subslice x _ i) "p" (subslice x (+ i 1))))))

      (case ["0x"]
        ;; possibly a hexadecimal float
        (let [i (strings/LastIndexByte x \P)]
          (when (== i -1)
            (return lit)) ; nothing to do

          (set! x (+ (subslice x _ i) "p" (subslice x (+ i 1))))))
      (case ["0O"]
        (set! x (+ "0o" (subslice x 2))))
      (case ["0o"]
        (return lit)) ; nothing to do
      (case ["0B"]
        (set! x (+ "0b" (subslice x 2))))
      (case ["0b"]
        (return lit))) ; nothing to do


    (addr (lit ast/BasicLit :ValuePos (.-ValuePos lit) :Kind (.-Kind lit) :Value x))))



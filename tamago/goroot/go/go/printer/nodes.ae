      (.setPos p (.Pos d))
      (.print p "BadDecl"))
    (case [(* ast/GenDecl)]
      (.genDecl p d))
    (case [(* ast/FuncDecl)]
      (.funcDecl p d))
    (default
      (panic "unreachable"))))




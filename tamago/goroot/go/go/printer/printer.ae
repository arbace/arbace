    (.flush p (lit token/Position :Offset infinity :Line infinity) token/EOF)

    ;; output is buffered in p.output now.
    ;; fix //go:build and // +build comments if needed.
    (.fixGoBuildLines p)

    ;; redirect output through a trimmer to eliminate trailing whitespace
    ;; (Input to a tabwriter must be untrimmed since trailing tabs provide
    ;; formatting information. The tabwriter could provide trimming
    ;; functionality but no tabwriter is used when RawFormat is set.)
    (set! output (addr (lit trimmer :output output)))

    ;; redirect output through a tabwriter if necessary
    (when (== (bit-and (.-Mode cfg) RawFormat) 0)
      (let [minwidth (.-Tabwidth cfg)

          ^{:line 1387} padchar (conv byte \tab)]
        (when (!= (bit-and (.-Mode cfg) UseSpaces) 0)
          (set! padchar \space))


        (let [twmode tabwriter/DiscardEmptyColumns]
          (when (!= (bit-and (.-Mode cfg) TabIndent) 0)
            (set! minwidth 0)
            (set! twmode bit-or tabwriter/TabIndent))


          (set! output (tabwriter/NewWriter output minwidth (.-Tabwidth cfg) 1 padchar twmode)))))


    ;; write printer result via tabwriter/trimmer to output
    (when [(set! (values _ err) (.Write output (.-output p)))] (!= err nil)
      (return))


    ;; flush tabwriter, if any
    (when [(values tw _) (assert (* tabwriter/Writer) output)] (!= tw nil)
      (set! err (.Flush tw)))


    (return)))




(go/type CommentedNode "A CommentedNode bundles an AST node and corresponding comments.\nIt may be provided as argument to any of the [Fprint] functions.\n" (struct
    ^{:line 1417 :tag any} Node ; *ast.File, or ast.Expr, ast.Decl, ast.Spec, or ast.Stmt
    ^{:line 1418 :tag (slice (* ast/CommentGroup))} Comments))






^{:go/end 1427} (go/method Fprint "Fprint \"pretty-prints\" an AST node to output for a given configuration cfg.\nPosition information is interpreted relative to the file set fset.\nThe node type must be *[ast.File], *[CommentedNode], [][ast.Decl], [][ast.Stmt],\nor assignment-compatible to [ast.Expr], [ast.Decl], [ast.Spec], or [ast.Stmt].\n" ^error [^{:tag (* Config)} cfg ^io/Writer output ^{:tag (* token/FileSet)} fset ^any node]
  (.fprint cfg output fset node (make (map ast/Node int))))






^{:go/end 1435} (go/func Fprint "Fprint \"pretty-prints\" an AST node to output.\nIt calls [Config.Fprint] with default settings.\nNote that gofmt uses tabs for indentation but spaces for alignment;\nuse format.Node (package go/format) for output that matches gofmt.\n" ^error [^io/Writer output ^{:tag (* token/FileSet)} fset ^any node]
  (.Fprint (addr (lit Config :Tabwidth 8)) output fset node))

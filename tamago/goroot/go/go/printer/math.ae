(in-ns 'go.go.printer) (go/file "math.go" :imports [

    ^{:line 7} [math "math"]])






^{:go/end 17} (go/func log2ish "log2ish returns a crude approximation to log₂(x).\nThe result is only used for heuristic alignment decisions and should\nnot be used where precision matters.\nThe approximation is guaranteed to produce identical results\nacross all architectures.\n" ^float64 [^float64 x]
  (let [(values f e) (math/Frexp x)]
    (+ (conv float64 e) (* 2 (- f 1)))))







^{:go/end 28} (go/func exp2ish "exp2ish returns a crude approximation to 2**x.\nThe result is only used for heuristic alignment decisions and should\nnot be used where precision matters.\nThe approximation is guaranteed to produce identical results\nacross all architectures.\n" ^float64 [^float64 x]
  (let [n (math/Floor x)
      ^{:line 26} f (- x n)]
    (math/Ldexp (+ 1 f) (conv int n))))

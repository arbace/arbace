(ns go.go.constant
  (:require [arbace.go :as go]))

(go/package constant
  :path "go/constant"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["kind_string.go" "value.go"]
  :init-order [_Kind_index floatVal0]
  :positions :lines)

(load "constant/kind_string")
(load "constant/value")

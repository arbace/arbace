(ns go.go.doc
  (:require [arbace.go :as go]))

(go/package doc
  :path "go/doc"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["comment.go" "doc.go" "example.go" "exports.go" "filter.go" "reader.go" "synopsis.go"]
  :init-order [outputPrefix underscore noteMarker noteMarkerRx noteCommentRx predeclaredTypes predeclaredFuncs predeclaredConstants IllegalPrefixes]
  :positions :lines)

(load "doc/comment.go")
(load "doc/doc")
(load "doc/example")
(load "doc/exports")
(load "doc/filter")
(load "doc/reader")
(load "doc/synopsis")

(ns go.go.doc
  (:require [arbace.go :as go]))

(go/package doc
  :path "go/doc"
  :files ["comment.go" "doc.go" "example.go" "exports.go" "filter.go" "reader.go" "synopsis.go"]
  :positions :lines)

(load "doc/comment.go")
(load "doc/doc")
(load "doc/example")
(load "doc/exports")
(load "doc/filter")
(load "doc/reader")
(load "doc/synopsis")

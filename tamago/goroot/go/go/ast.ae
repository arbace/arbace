(ns go.go.ast
  (:require [arbace.go :as go]))

(go/package ast
  :path "go/ast"
  :files ["ast.go" "commentmap.go" "directive.go" "filter.go" "import.go" "print.go" "resolve.go" "scope.go" "walk.go"]
  :positions :lines)

(load "ast/ast")
(load "ast/commentmap")
(load "ast/directive")
(load "ast/filter")
(load "ast/import")
(load "ast/print")
(load "ast/resolve")
(load "ast/scope")
(load "ast/walk")

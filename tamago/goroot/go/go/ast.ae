(ns go.go.ast
  (:require [arbace.go :as go]))

(go/package ast
  :path "go/ast"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["ast.go" "commentmap.go" "directive.go" "filter.go" "import.go" "print.go" "resolve.go" "scope.go" "walk.go"]
  :init-order [separator indent objKindStrings]
  :positions :lines)

(load "ast/ast")
(load "ast/commentmap")
(load "ast/directive")
(load "ast/filter")
(load "ast/import")
(load "ast/print")
(load "ast/resolve")
(load "ast/scope")
(load "ast/walk")

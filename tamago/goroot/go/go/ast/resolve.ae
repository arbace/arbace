(in-ns 'go.go.ast) (go/file "resolve.go" :imports [


    ^{:line 10} [fmt "fmt"]
    ^{:line 11} [scanner "go/scanner"]
    ^{:line 12} [token "go/token"]
    ^{:line 13} [strconv "strconv"]])


(go/type pkgBuilder (struct
    ^{:line 17 :tag (* token/FileSet)} fset
    ^{:line 18 :tag scanner/ErrorList} errors))


^{:go/end 23} (go/method error [^{:tag (* pkgBuilder)} p ^token/Pos pos ^string msg]
  (.Add (.-errors p) (.Position (.-fset p) pos) msg))


^{:go/end 27} (go/method errorf [^{:tag (* pkgBuilder)} p ^token/Pos pos ^string format & ^{:tag (slice any)} args]
  (.error p pos (fmt/Sprintf format (spread args))))


^{:go/end 42} (go/method declare [^{:tag (* pkgBuilder)} p ^{:tag (* Scope)} scope ^{:tag (* Scope)} altScope ^{:tag (* Object)} obj]
  (let [alt (.Insert scope obj)]
    (when (and (== alt nil) (!= altScope nil))
      ;; see if there is a conflicting declaration in altScope
      (set! alt (.Lookup altScope (.-Name obj))))

    (when (!= alt nil)
      (let [prevDecl ""]
        (when [pos (.Pos alt)] (.IsValid pos)
          (set! prevDecl (fmt/Sprintf "\n\tprevious declaration at %s" (.Position (.-fset p) pos))))

        (.error p (.Pos obj) (fmt/Sprintf "%s redeclared in this block%s" (.-Name obj) prevDecl))))))



^{:go/breaks [[4 51]] :go/end 52} (go/func resolve ^bool [^{:tag (* Scope)} scope ^{:tag (* Ident)} ident]
  (for [] (!= scope nil) (set! scope (.-Outer scope))
    (when [obj (.Lookup scope (.-Name ident))] (!= obj nil)
      (set! (.-Obj ident) obj)
      (return true)))


  false)













(go/type Importer "An Importer resolves import paths to package Objects.\nThe imports map records the packages already imported,\nindexed by package id (canonical import path).\nAn Importer must determine the canonical import path and\ncheck the map to see if it is already present in the imports map.\nIf so, the Importer can return the map entry. Otherwise, the\nImporter should load the package data for the given path into\na new *[Object] (pkg), record pkg in the imports map, and then\nreturn pkg.\n\nDeprecated: use the type checker [go/types] instead; see [Object].\n" (func [^{:tag (map string (* Object))} imports ^string path] [^{:tag (* Object)} pkg ^error err]))











^{:go/end 177} (go/func NewPackage "NewPackage creates a new [Package] node from a set of [File] nodes. It resolves\nunresolved identifiers across files and updates each file's Unresolved list\naccordingly. If a non-nil importer and universe scope are provided, they are\nused to resolve identifiers not declared in any of the package files. Any\nremaining unresolved identifiers are reported as undeclared. If the files\nbelong to different packages, one package name is selected and files with\ndifferent package names are reported and then ignored.\nThe result is a package node and a [scanner.ErrorList] if there were errors.\n\nDeprecated: use the type checker [go/types] instead; see [Object].\n" [^{:tag (* token/FileSet)} fset ^{:tag (map string (* File))} files ^Importer importer ^{:tag (* Scope)} universe] :results [(* Package) error]
  (let [^pkgBuilder p (zero pkgBuilder)]
    (set! (.-fset p) fset)

    ;; complete package scope
    (let [pkgName ""
        ^{:line 83} pkgScope (NewScope universe)]
      (range [_ file files]
        ;; package names must match
        (switch [name (.-Name (.-Name file))]
          (case [(== pkgName "")]
            (set! pkgName name))
          (case [(!= name pkgName)]
            (.errorf p (.-Package file) "package %s; expected %s" name pkgName)
            (continue))) ; ignore this file


        ;; collect top-level file objects in package scope
        (range [_ obj (.-Objects (.-Scope file))]
          (.declare p pkgScope nil obj)))



      ;; package global mapping of imported package ids to package objects
      (let [imports (make (map string (* Object)))]

        ;; complete file scopes with imports and resolve identifiers
        (range [_ file files]
          ;; ignore file if it belongs to a different package
          ;; (error has already been reported)
          (when (!= (.-Name (.-Name file)) pkgName)
            (continue))


          ;; build file scope by processing all imports
          (let [importErrors false
              ^{:line 113} fileScope (NewScope pkgScope)]
            (range [_ spec (.-Imports file)]
              (when (== importer nil)
                (set! importErrors true)
                (continue))

              (let [(values path _) (strconv/Unquote (.-Value (.-Path spec)))
                  (values pkg err) (importer imports path)]
                (when (!= err nil)
                  (.errorf p (.Pos (.-Path spec)) "could not import %s (%s)" path err)
                  (set! importErrors true)
                  (continue))

                ;; TODO(gri) If a local package name != "." is provided,
                ;; global identifier resolution could proceed even if the
                ;; import failed. Consider adjusting the logic here a bit.

                ;; local name overrides imported package name
                (let [name (.-Name pkg)]
                  (when (!= (.-Name spec) nil)
                    (set! name (.-Name (.-Name spec))))


                  ;; add import to file scope
                  (cond (== name ".")
                    ;; merge imported scope with file scope
                    (range [_ obj (.-Objects (assert (* Scope) (.-Data pkg)))]
                      (.declare p fileScope pkgScope obj))

                    (!= name "_")
                    ;; declare imported package object in file scope
                    ;; (do not re-use pkg in the file scope but create
                    ;; a new object instead; the Decl field is different
                    ;; for different files)
                    (let [obj (NewObj Pkg name)]
                      (set! (.-Decl obj) spec)
                      (set! (.-Data obj) (.-Data pkg))
                      (.declare p fileScope pkgScope obj))))))



            ;; resolve identifiers
            (when importErrors
              ;; don't use the universe scope without correct imports
              ;; (objects in the universe may be shadowed by imports;
              ;; with missing imports, identifiers might get resolved
              ;; incorrectly to universe objects)
              (set! (.-Outer pkgScope) nil))

            (let [i 0]
              (range [_ ident (.-Unresolved file)]
                (when (not (resolve fileScope ident))
                  (.errorf p (.Pos ident) "undeclared name: %s" (.-Name ident))
                  (aset (.-Unresolved file) i ident)
                  (inc! i)))



              (set! (.-Unresolved file) (subslice (.-Unresolved file) 0 i))
              (set! (.-Outer pkgScope) universe)))) ; reset universe scope


        (.Sort (.-errors p))
        (return (addr (lit Package pkgName pkgScope imports files)) (.Err (.-errors p)))))))

;; This file implements scopes and the objects they contain.

(in-ns 'go.go.ast) (go/file "scope.go" :imports [


    ^{:line 10} [fmt "fmt"]
    ^{:line 11} [token "go/token"]
    ^{:line 12} [strings "strings"]])







(go/type Scope "A Scope maintains the set of named language entities declared\nin the scope and a link to the immediately surrounding (outer)\nscope.\n\nDeprecated: use the type checker [go/types] instead; see [Object].\n" (struct
    ^{:line 21 :tag (* Scope)} Outer
    ^{:line 22 :tag (map string (* Object))} Objects))



^{:go/end 29} (go/func NewScope "NewScope creates a new scope nested in the outer scope.\n" ^{:tag (* Scope)} [^{:tag (* Scope)} outer]
  (let [^:const ^{:val 4} n 4] ; initial scope capacity
    (addr (lit Scope outer (make (map string (* Object)) n)))))





^{:go/end 36} (go/method Lookup "Lookup returns the object with the given name if it is\nfound in scope s, otherwise it returns nil. Outer scopes\nare ignored.\n" ^{:tag (* Object)} [^{:tag (* Scope)} s ^string name]
  (aget (.-Objects s) name))






^{:go/end 47} (go/method Insert "Insert attempts to insert a named object obj into the scope s.\nIf the scope already contains an object alt with the same name,\nInsert leaves the scope unchanged and returns alt. Otherwise\nit inserts obj and returns nil.\n" [^{:tag (* Scope)} s ^{:tag (* Object)} obj] :results [^{:tag (* Object)} alt]
  (when [(set! alt (aget (.-Objects s) (.-Name obj)))] (== alt nil)
    (aset (.-Objects s) (.-Name obj) obj))

  (return))



^{:go/end 61} (go/method String "Debugging support\n" ^string [^{:tag (* Scope)} s]
  (let [^strings/Builder buf (zero strings/Builder)]
    (fmt/Fprintf (addr buf) "scope %p {" s)
    (when (and (!= s nil) (> (len (.-Objects s)) 0))
      (fmt/Fprintln (addr buf))
      (range [_ obj (.-Objects s)]
        (fmt/Fprintf (addr buf) "\t%s %s\n" (.-Kind obj) (.-Name obj))))


    (fmt/Fprintf (addr buf) "}\n")
    (.String buf)))


;; ----------------------------------------------------------------------------
;; Objects






















(go/type Object "An Object describes a named language entity such as a package,\nconstant, type, variable, function (incl. methods), or label.\n\nThe Data fields contains object-specific data:\n\n\tKind    Data type         Data value\n\tPkg     *Scope            package scope\n\tCon     int               iota for the respective declaration\n\nDeprecated: The relationship between Idents and Objects cannot be\ncorrectly computed without type information. For example, the\nexpression T{K: 0} may denote a struct, map, slice, or array\nliteral, depending on the type of T. If T is a struct, then K\nrefers to a field of T, whereas for the other types it refers to a\nvalue in the environment.\n\nNew programs should set the [go/parser.SkipObjectResolution] parser\nflag to disable syntactic object resolution (which also saves CPU\nand memory), and instead use the type checker [go/types] if object\nresolution is desired. See the Defs, Uses, and Implicits fields of\nthe [go/types.Info] struct for details.\n" (struct
    ^{:line 88 :tag ObjKind} Kind
    ^{:line 89 :tag string} Name ; declared name
    ^{:line 90 :tag any} Decl ; corresponding Field, XxxSpec, FuncDecl, LabeledStmt, AssignStmt, Scope; or nil
    ^{:line 91 :tag any} Data ; object-specific data; or nil
    ^{:line 92 :tag any} Type)) ; placeholder for type information; may be nil



^{:go/end 98} (go/func NewObj "NewObj creates a new object of a given kind and name.\n" ^{:tag (* Object)} [^ObjKind kind ^string name]
  (addr (lit Object :Kind kind :Name name)))





^{:go/end 145} (go/method Pos "Pos computes the source position of the declaration of an object name.\nThe result may be an invalid position if it cannot be computed\n(obj.Decl may be nil or not correct).\n" ^token/Pos [^{:tag (* Object)} obj]
  (let [name (.-Name obj)]
    (type-switch [d (.-Decl obj)]
      (case [(* Field)]
        (range [_ n (.-Names d)]
          (when (== (.-Name n) name)
            (return (.Pos n)))))


      (case [(* ImportSpec)]
        (when (and (!= (.-Name d) nil) (== (.-Name (.-Name d)) name))
          (return (.Pos (.-Name d))))

        (return (.Pos (.-Path d))))
      (case [(* ValueSpec)]
        (range [_ n (.-Names d)]
          (when (== (.-Name n) name)
            (return (.Pos n)))))


      (case [(* TypeSpec)]
        (when (== (.-Name (.-Name d)) name)
          (return (.Pos (.-Name d)))))

      (case [(* FuncDecl)]
        (when (== (.-Name (.-Name d)) name)
          (return (.Pos (.-Name d)))))

      (case [(* LabeledStmt)]
        (when (== (.-Name (.-Label d)) name)
          (return (.Pos (.-Label d)))))

      (case [(* AssignStmt)]
        (range [_ x (.-Lhs d)]
          (when [(values ident isIdent) (assert (* Ident) x)] (and isIdent (== (.-Name ident) name))
            (return (.Pos ident)))))


      (case [(* Scope)]))
    ;; predeclared object - nothing to do for now

    ^{:line 144} token/NoPos))



(go/type ObjKind "ObjKind describes what an [Object] represents.\n" int)


(go/const "The list of possible [Object] kinds.\n"
  ^{:line 152} [^{:tag ObjKind :val 0} Bad iota] ; for error handling
  ^{:line 153} [^{:val 1} Pkg] ; package
  ^{:line 154} [^{:val 2} Con] ; constant
  ^{:line 155} [^{:val 3} Typ] ; type
  ^{:line 156} [^{:val 4} Var] ; variable
  ^{:line 157} [^{:val 5} Fun] ; function or method
  ^{:line 158} [^{:val 6} Lbl]) ; label


(go/var objKindStrings (lit (array ... string)
    ^{:line 162} [Bad "bad"]
    ^{:line 163} [Pkg "package"]
    ^{:line 164} [Con "const"]
    ^{:line 165} [Typ "type"]
    ^{:line 166} [Var "var"]
    ^{:line 167} [Fun "func"]
    ^{:line 168} [Lbl "label"]))


^{:go/end 171} (go/method String ^string [^ObjKind kind] (aget objKindStrings kind))

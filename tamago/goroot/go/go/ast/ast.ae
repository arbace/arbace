^{:go/end 1122} (go/func IsGenerated "IsGenerated reports whether the file was generated by a program,\nnot handwritten, by detecting the special comment described\nat https://go.dev/s/generatedcode.\n\nThe syntax tree must have been parsed with the [go/parser.ParseComments] flag.\nExample:\n\n\tf, err := parser.ParseFile(fset, filename, src, parser.ParseComments|parser.PackageClauseOnly|parser.SkipObjectResolution)\n\tif err != nil { ... }\n\tgen := ast.IsGenerated(f)\n" ^bool [^{:tag (* File)} file]
  (let [(values _ ok) (generator file)]
    ^{:line 1121} ok))


^{:go/end 1144} (go/func generator [^{:tag (* File)} file] :results [string bool]
  (range [_ group (.-Comments file)]
    (range [_ comment (.-List group)]
      (when (> (.Pos comment) (.-Package file))
        (break)) ; after package declaration

      ;; opt: check Contains first to avoid unnecessary array allocation in Split.
      (let [^:const ^{:val "// Code generated "} prefix "// Code generated "]
        (when (strings/Contains (.-Text comment) prefix)
          (range [line (strings/SplitSeq (.-Text comment) "\n")]
            (when [(values rest ok) (strings/CutPrefix line prefix)] ok
              (when [(values gen ok) (strings/CutSuffix rest " DO NOT EDIT.")] ok
                (return gen true))))))))






  (return "" false))



^{:go/end 1155} (go/func Unparen "Unparen returns the expression with any enclosing parentheses removed.\n" ^Expr [^Expr e]
  (while true
    (let [(values paren ok) (assert (* ParenExpr) e)]
      (when (not ok)
        (return e))

      (set! e (.-X paren)))))

  (when (> (len (.-Names f)) 0)
    (return (.Pos (aget (.-Names f) 0))))

  (when (!= (.-Type f) nil)
    (return (.Pos (.-Type f))))

  ^{:line 216} token/NoPos)


^{:go/end 230} (go/method End ^token/Pos [^{:tag (* Field)} f]
  (when (!= (.-Tag f) nil)
    (return (.End (.-Tag f))))

  (when (!= (.-Type f) nil)
    (return (.End (.-Type f))))

  (when (> (len (.-Names f)) 0)
    (return (.End (aget (.-Names f) (- (len (.-Names f)) 1)))))

  ^{:line 229} token/NoPos)




(go/type FieldList "A FieldList represents a list of Fields, enclosed by parentheses,\ncurly braces, or square brackets.\n" (struct
    ^{:line 235 :tag token/Pos} Opening ; position of opening parenthesis/brace/bracket, if any
    ^{:line 236 :tag (slice (* Field))} List ; field list; or nil

  (when (.IsValid (.-Opening f))
    (return (.-Opening f)))

  ;; the list should not be empty in this case;
  ;; be conservative and guard against bad ASTs
  (when (> (len (.-List f)) 0)
    (return (.Pos (aget (.-List f) 0))))

  ^{:line 249} token/NoPos)


^{:go/end 262} (go/method End ^token/Pos [^{:tag (* FieldList)} f]
  (when (.IsValid (.-Closing f))
    (return (+ (.-Closing f) 1)))

  ;; the list should not be empty in this case;
  ;; be conservative and guard against bad ASTs
  (when [n (len (.-List f))] (> n 0)
    (return (.End (aget (.-List f) (- n 1)))))

  ^{:line 261} token/NoPos)



^{:go/end 277} (go/method NumFields "NumFields returns the number of parameters or struct fields represented by a [FieldList].\n" ^int [^{:tag (* FieldList)} f]
  (let [n 0]
    (when (!= f nil)
      (range [_ g (.-List f)]
        (let [m (len (.-Names g))]
          (when (== m 0)
            (set! m 1))

          (set! n + m))))


    ^{:line 276} n))





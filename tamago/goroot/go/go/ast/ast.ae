;; Package ast declares the types used to represent syntax trees for Go
;; packages.
;;
;; Syntax trees may be constructed directly, but they are typically
;; produced from Go source code by the parser; see the
;; [go/parser.ParseFile] function.
(in-ns 'go.go.ast) (go/file "ast.go" :doc "Package ast declares the types used to represent syntax trees for Go\npackages.\n\nSyntax trees may be constructed directly, but they are typically\nproduced from Go source code by the parser; see the\n[go/parser.ParseFile] function.\n" :imports [


    ^{:line 14} [token "go/token"]
    ^{:line 15} [strings "strings"]])


;; ----------------------------------------------------------------------------
;; Interfaces
;;
;; There are 3 main classes of nodes: Expressions and type nodes,
;; statement nodes, and declaration nodes. The node names usually
;; match the corresponding Go spec production names to which they
;; correspond. The node fields correspond to the individual parts
;; of the respective productions.
;;
;; All nodes contain position information marking the beginning of
;; the corresponding source text segment; it is accessible via the
;; Pos accessor method. Nodes may contain additional position info
;; for language constructs where comments may be found between parts
;; of the construct (typically any larger, parenthesized subpart).
;; That position information is needed to properly position comments
;; when printing the construct.


(go/type Node "All node types implement the Node interface.\n" (interface
    (Pos ^token/Pos []) ; position of first character belonging to the node
    (End ^token/Pos []))) ; position of first character immediately after the node



(go/type Expr "All expression nodes implement the Expr interface.\n" (interface
    ^{:line 43} Node
    (exprNode [])))



(go/type Stmt "All statement nodes implement the Stmt interface.\n" (interface
    ^{:line 49} Node
    (stmtNode [])))



(go/type Decl "All declaration nodes implement the Decl interface.\n" (interface
    ^{:line 55} Node
    (declNode [])))


;; ----------------------------------------------------------------------------
;; Comments







(go/type Comment "A Comment node represents a single //-style or /*-style comment.\n\nThe Text field contains the comment text without carriage returns (\\r) that\nmay have been present in the source. Because a comment's end position is\ncomputed using len(Text), the position reported by [Comment.End] does not match the\ntrue source end position for comments containing carriage returns.\n" (struct
    ^{:line 69 :tag token/Pos} Slash ; position of "/" starting the comment
    ^{:line 70 :tag string} Text)) ; comment text (excluding '\n' for //-style comments)


^{:go/end 73} (go/method Pos ^token/Pos [^{:tag (* Comment)} c] (.-Slash c))
^{:go/end 74} (go/method End ^token/Pos [^{:tag (* Comment)} c] (conv token/Pos (+ (conv int (.-Slash c)) (len (.-Text c)))))



(go/type CommentGroup "A CommentGroup represents a sequence of comments\nwith no other tokens and no empty lines between.\n" (struct
    ^{:line 79 :tag (slice (* Comment))} List)) ; len(List) > 0


^{:go/end 82} (go/method Pos ^token/Pos [^{:tag (* CommentGroup)} g] (.Pos (aget (.-List g) 0)))
^{:go/end 83} (go/method End ^token/Pos [^{:tag (* CommentGroup)} g] (.End (aget (.-List g) (- (len (.-List g)) 1))))

^{:go/end 85} (go/func isWhitespace ^bool [^byte ch] (or (== ch \space) (== ch \tab) (== ch \newline) (== ch \return)))

^{:go/end 93} (go/func stripTrailingWhitespace ^string [^string s]
  (let [i (len s)]
    (while (and (> i 0) (isWhitespace (aget s (- i 1))))
      (dec! i))

    (subslice s 0 i)))








^{:go/end 162} (go/method Text "Text returns the text of the comment.\nComment markers (//, /*, and */), the first space of a line comment, and\nleading and trailing empty lines are removed.\nComment directives like \"//line\" and \"//go:noinline\" are also removed.\nMultiple empty lines are reduced to one, and trailing space on lines is trimmed.\nUnless the result is empty, it is newline-terminated.\n" ^string [^{:tag (* CommentGroup)} g]
  (when (== g nil)
    (return ""))

  (let [comments (make (slice string) (len (.-List g)))]
    (range [i c (.-List g)]
      (aset comments i (.-Text c)))


    (let [lines (make (slice string) 0 10)] ; most comments are less than 10 lines
      (range [_ c comments]
        ;; Remove comment markers.
        ;; The parser has given us exactly the comment text.
        (switch (aget c 1)
          (case [\/]
            ;;-style comment (no newline at the end)
            (set! c (subslice c 2))
            (when (== (len c) 0)
              ;; empty line
              (break))

            (when (== (aget c 0) \space)
              ;; strip first space - required for Example tests
              (set! c (subslice c 1))
              (break))

            (when (isDirective c)
              ;; Ignore //go:noinline, //line, and so on.
              (continue)))

          (case [\*]
            ;; /*-style comment */
            (set! c (subslice c 2 (- (len c) 2)))))


        ;; Split on newlines.
        (let [cl (strings/SplitSeq c "\n")]

          ;; Walk lines, stripping trailing white space and adding to list.
          (range [l cl]
            (set! lines (append lines (stripTrailingWhitespace l))))))



      ;; Remove leading blank lines; convert runs of
      ;; interior blank lines to a single blank line.
      (let [n 0]
        (range [_ line lines]
          (when (or (!= line "") (and (> n 0) (!= (aget lines (- n 1)) "")))
            (aset lines n line)
            (inc! n)))


        (set! lines (subslice lines 0 n))

        ;; Add final "" entry to get trailing newline from Join.
        (when (and (> n 0) (!= (aget lines (- n 1)) ""))
          (set! lines (append lines "")))


        (strings/Join lines "\n")))))




^{:go/end 191} (go/func isDirective "isDirective reports whether c is a comment directive.\nThis code is also in go/printer.\n" ^bool [^string c]
  ;; "//line " is a line directive.
  ;; "//extern " is for gccgo.
  ;; "//export " is for cgo.
  ;; (The // has been removed.)
  (when (or (strings/HasPrefix c "line ") (strings/HasPrefix c "extern ") (strings/HasPrefix c "export "))
    (return true))


  ;; "//[a-z0-9]+:[a-z0-9]"
  ;; (The // has been removed.)
  ^{:go/breaks [[4 190]]} (let [colon (strings/Index c ":")]
    (when (or (<= colon 0) (>= (+ colon 1) (len c)))
      (return false))

    (for [i 0] (<= i (+ colon 1)) (inc! i)
      (when (== i colon)
        (continue))

      (let [b (aget c i)]
        (when (not (or (and (<= \a b) (<= b \z)) (and (<= \0 b) (<= b \9))))
          (return false))))


    true))



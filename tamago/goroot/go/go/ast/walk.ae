(in-ns 'go.go.ast) (go/file "walk.go" :imports [


    ^{:line 8} [fmt "fmt"]
    ^{:line 9} [iter "iter"]])





(go/type Visitor "A Visitor's Visit method is invoked for each node encountered by [Walk].\nIf the result visitor w is not nil, [Walk] visits each of the children\nof node with the visitor w, followed by a call of w.Visit(nil).\n" (interface
    (Visit [^Node node] :results [^Visitor w])))


^{:go/end 23} (go/func walkList :type-params [^Node N] [^Visitor v ^{:tag (slice N)} list]
  (range [_ node list]
    (Walk v node)))



;; TODO(gri): Investigate if providing a closure to Walk leads to
;; simpler use (and may help eliminate Inspect in turn).






^{:go/end 356} (go/func Walk "Walk traverses an AST in depth-first order: It starts by calling\nv.Visit(node); node must not be nil. If the visitor w returned by\nv.Visit(node) is not nil, Walk is invoked recursively with visitor\nw for each of the non-nil children of node, followed by a call of\nw.Visit(nil).\n" [^Visitor v ^Node node]
  (when [(set! v (.Visit v node))] (== v nil)
    (return))


  ;; walk children
  ;; (the order of the cases matches the order
  ;; of the corresponding node types in ast.go)
  (type-switch [n node]
    ;; Comments and fields
    (case [(* Comment)])
    ;; nothing to do

    (case [(* CommentGroup)]
      (^{:inst [(* Comment)]} walkList v (.-List n)))

    (case [(* Field)]
      (when (!= (.-Doc n) nil)
        (Walk v (.-Doc n)))

      (^{:inst [(* Ident)]} walkList v (.-Names n))
      (when (!= (.-Type n) nil)
        (Walk v (.-Type n)))

      (when (!= (.-Tag n) nil)
        (Walk v (.-Tag n)))

      (when (!= (.-Comment n) nil)
        (Walk v (.-Comment n))))


    (case [(* FieldList)]
      (^{:inst [(* Field)]} walkList v (.-List n)))

    ;; Expressions
    (case [(* BadExpr) (* Ident) (* BasicLit)])
    ;; nothing to do

    (case [(* Ellipsis)]
      (when (!= (.-Elt n) nil)
        (Walk v (.-Elt n))))


    (case [(* FuncLit)]
      (Walk v (.-Type n))
      (Walk v (.-Body n)))

    (case [(* CompositeLit)]
      (when (!= (.-Type n) nil)
        (Walk v (.-Type n)))

      (^{:inst [Expr]} walkList v (.-Elts n)))

    (case [(* ParenExpr)]
      (Walk v (.-X n)))

    (case [(* SelectorExpr)]
      (Walk v (.-X n))
      (Walk v (.-Sel n)))

    (case [(* IndexExpr)]
      (Walk v (.-X n))
      (Walk v (.-Index n)))

    (case [(* IndexListExpr)]
      (Walk v (.-X n))
      (^{:inst [Expr]} walkList v (.-Indices n)))

    (case [(* SliceExpr)]
      (Walk v (.-X n))
      (when (!= (.-Low n) nil)
        (Walk v (.-Low n)))

      (when (!= (.-High n) nil)
        (Walk v (.-High n)))

      (when (!= (.-Max n) nil)
        (Walk v (.-Max n))))


    (case [(* TypeAssertExpr)]
      (Walk v (.-X n))
      (when (!= (.-Type n) nil)
        (Walk v (.-Type n))))


    (case [(* CallExpr)]
      (Walk v (.-Fun n))
      (^{:inst [Expr]} walkList v (.-Args n)))

    (case [(* StarExpr)]
      (Walk v (.-X n)))

    (case [(* UnaryExpr)]
      (Walk v (.-X n)))

    (case [(* BinaryExpr)]
      (Walk v (.-X n))
      (Walk v (.-Y n)))

    (case [(* KeyValueExpr)]
      (Walk v (.-Key n))
      (Walk v (.-Value n)))

    ;; Types
    (case [(* ArrayType)]
      (when (!= (.-Len n) nil)
        (Walk v (.-Len n)))

      (Walk v (.-Elt n)))

    (case [(* StructType)]
      (Walk v (.-Fields n)))

    (case [(* FuncType)]
      (when (!= (.-TypeParams n) nil)
        (Walk v (.-TypeParams n)))

      (when (!= (.-Params n) nil)
        (Walk v (.-Params n)))

      (when (!= (.-Results n) nil)
        (Walk v (.-Results n))))


    (case [(* InterfaceType)]
      (Walk v (.-Methods n)))

    (case [(* MapType)]
      (Walk v (.-Key n))
      (Walk v (.-Value n)))

    (case [(* ChanType)]
      (Walk v (.-Value n)))

    ;; Statements
    (case [(* BadStmt)])
    ;; nothing to do

    (case [(* DeclStmt)]
      (Walk v (.-Decl n)))

    (case [(* EmptyStmt)])
    ;; nothing to do

    (case [(* LabeledStmt)]
      (Walk v (.-Label n))
      (Walk v (.-Stmt n)))

    (case [(* ExprStmt)]
      (Walk v (.-X n)))

    (case [(* SendStmt)]
      (Walk v (.-Chan n))
      (Walk v (.-Value n)))

    (case [(* IncDecStmt)]
      (Walk v (.-X n)))

    (case [(* AssignStmt)]
      (^{:inst [Expr]} walkList v (.-Lhs n))
      (^{:inst [Expr]} walkList v (.-Rhs n)))

    (case [(* GoStmt)]
      (Walk v (.-Call n)))

    (case [(* DeferStmt)]
      (Walk v (.-Call n)))

    (case [(* ReturnStmt)]
      (^{:inst [Expr]} walkList v (.-Results n)))

    (case [(* BranchStmt)]
      (when (!= (.-Label n) nil)
        (Walk v (.-Label n))))


    (case [(* BlockStmt)]
      (^{:inst [Stmt]} walkList v (.-List n)))

    (case [(* IfStmt)]
      (when (!= (.-Init n) nil)
        (Walk v (.-Init n)))

      (Walk v (.-Cond n))
      (Walk v (.-Body n))
      (when (!= (.-Else n) nil)
        (Walk v (.-Else n))))


    (case [(* CaseClause)]
      (^{:inst [Expr]} walkList v (.-List n))
      (^{:inst [Stmt]} walkList v (.-Body n)))

    (case [(* SwitchStmt)]
      (when (!= (.-Init n) nil)
        (Walk v (.-Init n)))

      (when (!= (.-Tag n) nil)
        (Walk v (.-Tag n)))

      (Walk v (.-Body n)))

    (case [(* TypeSwitchStmt)]
      (when (!= (.-Init n) nil)
        (Walk v (.-Init n)))

      (Walk v (.-Assign n))
      (Walk v (.-Body n)))

    (case [(* CommClause)]
      (when (!= (.-Comm n) nil)
        (Walk v (.-Comm n)))

      (^{:inst [Stmt]} walkList v (.-Body n)))

    (case [(* SelectStmt)]
      (Walk v (.-Body n)))

    (case [(* ForStmt)]
      (when (!= (.-Init n) nil)
        (Walk v (.-Init n)))

      (when (!= (.-Cond n) nil)
        (Walk v (.-Cond n)))

      (when (!= (.-Post n) nil)
        (Walk v (.-Post n)))

      (Walk v (.-Body n)))

    (case [(* RangeStmt)]
      (when (!= (.-Key n) nil)
        (Walk v (.-Key n)))

      (when (!= (.-Value n) nil)
        (Walk v (.-Value n)))

      (Walk v (.-X n))
      (Walk v (.-Body n)))

    ;; Declarations
    (case [(* ImportSpec)]
      (when (!= (.-Doc n) nil)
        (Walk v (.-Doc n)))

      (when (!= (.-Name n) nil)
        (Walk v (.-Name n)))

      (Walk v (.-Path n))
      (when (!= (.-Comment n) nil)
        (Walk v (.-Comment n))))


    (case [(* ValueSpec)]
      (when (!= (.-Doc n) nil)
        (Walk v (.-Doc n)))

      (^{:inst [(* Ident)]} walkList v (.-Names n))
      (when (!= (.-Type n) nil)
        (Walk v (.-Type n)))

      (^{:inst [Expr]} walkList v (.-Values n))
      (when (!= (.-Comment n) nil)
        (Walk v (.-Comment n))))


    (case [(* TypeSpec)]
      (when (!= (.-Doc n) nil)
        (Walk v (.-Doc n)))

      (Walk v (.-Name n))
      (when (!= (.-TypeParams n) nil)
        (Walk v (.-TypeParams n)))

      (Walk v (.-Type n))
      (when (!= (.-Comment n) nil)
        (Walk v (.-Comment n))))


    (case [(* BadDecl)])
    ;; nothing to do

    (case [(* GenDecl)]
      (when (!= (.-Doc n) nil)
        (Walk v (.-Doc n)))

      (^{:inst [Spec]} walkList v (.-Specs n)))

    (case [(* FuncDecl)]
      (when (!= (.-Doc n) nil)
        (Walk v (.-Doc n)))

      (when (!= (.-Recv n) nil)
        (Walk v (.-Recv n)))

      (Walk v (.-Name n))
      (Walk v (.-Type n))
      (when (!= (.-Body n) nil)
        (Walk v (.-Body n))))


    ;; Files and packages
    (case [(* File)]
      (when (!= (.-Doc n) nil)
        (Walk v (.-Doc n)))

      (Walk v (.-Name n))
      (^{:inst [Decl]} walkList v (.-Decls n)))
    ;; don't walk n.Comments - they have been
    ;; visited already through the individual
    ;; nodes

    (case [(* Package)]
      (range [_ f (.-Files n)]
        (Walk v f)))


    (default
      (panic (fmt/Sprintf "ast.Walk: unexpected node type %T" n))))


  (.Visit v nil))


(go/type inspector (func [Node] [bool]))

^{:go/breaks [[4 364]] :go/end 365} (go/method Visit ^Visitor [^inspector f ^Node node]
  (when (f node)
    (return f))

  nil)











^{:go/end 378} (go/func Inspect "Inspect traverses an AST in depth-first order: It starts by calling\nf(node); node must not be nil. If f returns true, Inspect invokes f\nrecursively for each of the non-nil children of node, followed by a\ncall of f(nil).\n\nIn many cases it may be more convenient to use [Preorder], which\nreturns an iterator over the sequence of nodes, or [PreorderStack],\nwhich (like [Inspect]) provides control over descent into subtrees,\nbut additionally reports the stack of enclosing nodes.\n" [^Node node ^{:tag (func [Node] [bool])} f]
  (Walk (conv inspector f) node))








^{:go/end 397} (go/func Preorder "Preorder returns an iterator over all the nodes of the syntax tree\nbeneath (and including) the specified root, in depth-first\npreorder.\n\nFor greater control over the traversal of each subtree, use\n[Inspect] or [PreorderStack].\n" ^{:tag (iter/Seq Node)} [^Node root]
  ^{:go/end 396} (fn [^{:tag (func [Node] [bool])} yield]
    (let [ok true]
      (Inspect root ^{:go/end 395} (fn ^bool [^Node n]
          (when (!= n nil)
            ;; yield must not be called once ok is false.
            (set! ok (and ok (yield n))))

          ^{:line 394} ok)))))
















^{:go/end 428} (go/func PreorderStack "PreorderStack traverses the tree rooted at root,\ncalling f before visiting each node.\n\nEach call to f provides the current node and traversal stack,\nconsisting of the original value of stack appended with all nodes\nfrom root to n, excluding n itself. (This design allows calls\nto PreorderStack to be nested without double counting.)\n\nIf f returns false, the traversal skips over that subtree. Unlike\n[Inspect], no second call to f is made after visiting node n.\n(In practice, the second call is nearly always used only to pop the\nstack, and it is surprisingly tricky to do this correctly.)\n" [^Node root ^{:tag (slice Node)} stack ^{:tag (func [^Node n ^{:tag (slice Node)} stack] [bool])} f]
  (let [before (len stack)]
    (Inspect root ^{:go/breaks [[3 423]] :go/end 424} (fn ^bool [^Node n]
        (if (!= n nil) (do
            (when (not (f n stack))
              ;; Do not push, as there will be no corresponding pop.
              (return false))

            (set! stack (append stack n))) ; push

          (set! stack (subslice stack _ (- (len stack) 1)))) ; pop

        true))

    (when (!= (len stack) before)
      (panic "push/pop mismatch"))))

;; ----------------------------------------------------------------------------
;; Export filtering


^{:go/end 18} (go/func exportFilter "exportFilter is a special filter function to extract exported nodes.\n" ^bool [^string name]
  (IsExported name))









^{:go/end 29} (go/func FileExports "FileExports trims the AST for a Go source file in place such that\nonly exported nodes remain: all top-level identifiers which are not exported\nand their associated information (such as type, initial value, or function\nbody) are removed. Non-exported fields and methods of exported types are\nstripped. The [File.Comments] list is not changed.\n\nFileExports reports whether there are exported declarations.\n" ^bool [^{:tag (* File)} src]
  (filterFile src exportFilter true))











^{:go/end 42} (go/func PackageExports "PackageExports trims the AST for a Go package in place such that\nonly exported nodes remain. The pkg.Files list is not changed, so that\nfile names and top-level package comments don't get lost.\n\nPackageExports reports whether there are exported declarations;\nit returns false otherwise.\n\nDeprecated: use the type checker [go/types] instead of [Package];\nsee [Object]. Alternatively, use [FileExports].\n" ^bool [^{:tag (* Package)} pkg]
  (filterPackage pkg exportFilter true))


;; ----------------------------------------------------------------------------
;; General filtering

(go/type Filter (func [string] [bool]))

^{:go/end 58} (go/func filterIdentList ^{:tag (slice (* Ident))} [^{:tag (slice (* Ident))} list ^Filter f]
  (let [j 0]
    (range [_ x list]
      (when (f (.-Name x))
        (aset list j x)
        (inc! j)))


    (subslice list 0 j)))





^{:go/breaks [[5 74]] :go/end 75} (go/func fieldName "fieldName assumes that x is the type of an anonymous field and\nreturns the corresponding field name. If x is not an acceptable\nanonymous field, the result is nil.\n" ^{:tag (* Ident)} [^Expr x]
  (type-switch [t x]
    (case [(* Ident)]
      (return t))
    (case [(* SelectorExpr)]
      (when [(values _ ok) (assert (* Ident) (.-X t))] ok
        (return (.-Sel t))))

    (case [(* StarExpr)]
      (return (fieldName (.-X t)))))

  nil)


^{:go/end 110} (go/func filterFieldList [^{:tag (* FieldList)} fields ^Filter filter ^bool export] :results [^bool removedFields]
  (when (== fields nil)
    (return false))

  (let [list (.-List fields)
      ^{:line 82} j 0]
    (range [_ f list]
      (let [keepField false]
        (if (== (len (.-Names f)) 0)
          ;; anonymous field
          (let [name (fieldName (.-Type f))]
            (set! keepField (and (!= name nil) (filter (.-Name name)))))

          (let [n (len (.-Names f))]
            (set! (.-Names f) (filterIdentList (.-Names f) filter))
            (when (< (len (.-Names f)) n)
              (set! removedFields true))

            (set! keepField (> (len (.-Names f)) 0))))

        (when keepField
          (when export
            (filterType (.-Type f) filter export))

          (aset list j f)
          (inc! j))))


    (when (< j (len list))
      (set! removedFields true))

    (set! (.-List fields) (subslice list 0 j))
    (return)))


^{:go/end 118} (go/func filterCompositeLit [^{:tag (* CompositeLit)} lit ^Filter filter ^bool export]
  (let [n (len (.-Elts lit))]
    (set! (.-Elts lit) (filterExprList (.-Elts lit) filter export))
    (when (< (len (.-Elts lit)) n)
      (set! (.-Incomplete lit) true))))



^{:go/end 138} (go/func filterExprList ^{:tag (slice Expr)} [^{:tag (slice Expr)} list ^Filter filter ^bool export]
  (let [j 0]
    (range [_ exp list]
      (type-switch [x exp]
        (case [(* CompositeLit)]
          (filterCompositeLit x filter export))
        (case [(* KeyValueExpr)]
          (when [(values x ok) (assert (* Ident) (.-Key x))] (and ok (not (filter (.-Name x))))
            (continue))

          (when [(values x ok) (assert (* CompositeLit) (.-Value x))] ok
            (filterCompositeLit x filter export))))


      (aset list j exp)
      (inc! j))

    (subslice list 0 j)))


^{:go/end 151} (go/func filterParamList ^bool [^{:tag (* FieldList)} fields ^Filter filter ^bool export]
  (when (== fields nil)
    (return false))

  (let [^bool b (zero bool)]
    (range [_ f (.-List fields)]
      (when (filterType (.-Type f) filter export)
        (set! b true)))


    ^{:line 150} b))


^{:go/breaks [[4 182]] :go/end 183} (go/func filterType ^bool [^Expr typ ^Filter f ^bool export]
  (type-switch [t typ]
    (case [(* Ident)]
      (return (f (.-Name t))))
    (case [(* ParenExpr)]
      (return (filterType (.-X t) f export)))
    (case [(* ArrayType)]
      (return (filterType (.-Elt t) f export)))
    (case [(* StructType)]
      (when (filterFieldList (.-Fields t) f export)
        (set! (.-Incomplete t) true))

      (return (> (len (.-List (.-Fields t))) 0)))
    (case [(* FuncType)]
      (let [b1 (filterParamList (.-Params t) f export)
          ^{:line 168} b2 (filterParamList (.-Results t) f export)]
        (return (or b1 b2))))
    (case [(* InterfaceType)]
      (when (filterFieldList (.-Methods t) f export)
        (set! (.-Incomplete t) true))

      (return (> (len (.-List (.-Methods t))) 0)))
    (case [(* MapType)]
      (let [b1 (filterType (.-Key t) f export)
          ^{:line 177} b2 (filterType (.-Value t) f export)]
        (return (or b1 b2))))
    (case [(* ChanType)]
      (return (filterType (.-Value t) f export))))

  false)


^{:go/breaks [[4 212]] :go/end 213} (go/func filterSpec ^bool [^Spec spec ^Filter f ^bool export]
  (type-switch [s spec]
    (case [(* ValueSpec)]
      (set! (.-Names s) (filterIdentList (.-Names s) f))
      (set! (.-Values s) (filterExprList (.-Values s) f export))
      (when (> (len (.-Names s)) 0)
        (when export
          (filterType (.-Type s) f export))

        (return true)))

    (case [(* TypeSpec)]
      (when (f (.-Name (.-Name s)))
        (when export
          (filterType (.-Type s) f export))

        (return true))

      (when (not export)
        ;; For general filtering (not just exports),
        ;; filter type even if name is not filtered
        ;; out.
        ;; If the type contains filtered elements,
        ;; keep the declaration.
        (return (filterType (.-Type s) f export)))))


  false)


^{:go/end 224} (go/func filterSpecList ^{:tag (slice Spec)} [^{:tag (slice Spec)} list ^Filter f ^bool export]
  (let [j 0]
    (range [_ s list]
      (when (filterSpec s f export)
        (aset list j s)
        (inc! j)))


    (subslice list 0 j)))








^{:go/end 234} (go/func FilterDecl "FilterDecl trims the AST for a Go declaration in place by removing\nall names (including struct field and interface method names, but\nnot from parameter lists) that don't pass through the filter f.\n\nFilterDecl reports whether there are any declared names left after\nfiltering.\n" ^bool [^Decl decl ^Filter f]
  (filterDecl decl f false))


^{:go/breaks [[4 244]] :go/end 245} (go/func filterDecl ^bool [^Decl decl ^Filter f ^bool export]
  (type-switch [d decl]
    (case [(* GenDecl)]
      (set! (.-Specs d) (filterSpecList (.-Specs d) f export))
      (return (> (len (.-Specs d)) 0)))
    (case [(* FuncDecl)]
      (return (f (.-Name (.-Name d))))))

  false)











^{:go/end 258} (go/func FilterFile "FilterFile trims the AST for a Go file in place by removing all\nnames from top-level declarations (including struct field and\ninterface method names, but not from parameter lists) that don't\npass through the filter f. If the declaration is empty afterwards,\nthe declaration is removed from the AST. Import declarations are\nalways removed. The [File.Comments] list is not changed.\n\nFilterFile reports whether there are any top-level declarations\nleft after filtering.\n" ^bool [^{:tag (* File)} src ^Filter f]
  (filterFile src f false))


^{:go/end 270} (go/func filterFile ^bool [^{:tag (* File)} src ^Filter f ^bool export]
  (let [j 0]
    (range [_ d (.-Decls src)]
      (when (filterDecl d f export)
        (aset (.-Decls src) j d)
        (inc! j)))


    (set! (.-Decls src) (subslice (.-Decls src) 0 j))
    (> j 0)))















^{:go/end 287} (go/func FilterPackage "FilterPackage trims the AST for a Go package in place by removing\nall names from top-level declarations (including struct field and\ninterface method names, but not from parameter lists) that don't\npass through the filter f. If the declaration is empty afterwards,\nthe declaration is removed from the AST. The pkg.Files list is not\nchanged, so that file names and top-level package comments don't get\nlost.\n\nFilterPackage reports whether there are any top-level declarations\nleft after filtering.\n\nDeprecated: use the type checker [go/types] instead of [Package];\nsee [Object]. Alternatively, use [FilterFile].\n" ^bool [^{:tag (* Package)} pkg ^Filter f]
  (filterPackage pkg f false))


^{:go/end 297} (go/func filterPackage ^bool [^{:tag (* Package)} pkg ^Filter f ^bool export]
  (let [hasDecls false]
    (range [_ src (.-Files pkg)]
      (when (filterFile src f export)
        (set! hasDecls true)))


    ^{:line 296} hasDecls))


;; ----------------------------------------------------------------------------
;; Merging of package files





(go/type MergeMode "The MergeMode flags control the behavior of [MergePackageFiles].\n\nDeprecated: use the type checker [go/types] instead of [Package];\nsee [Object].\n" uint)



(go/const "Deprecated: use the type checker [go/types] instead of [Package];\nsee [Object].\n"

  ^{:line 312} [^{:tag MergeMode :val 1 :doc "If set, duplicate function declarations are excluded.\n"} FilterFuncDuplicates (<< 1 iota)]


  ^{:line 315} [^{:val 2 :doc "If set, comments that are not associated with a specific\nAST node (as Doc or Comment) are excluded.\n"} FilterUnassociatedComments]

  ^{:line 317} [^{:val 4 :doc "If set, duplicate import declarations are excluded.\n"} FilterImportDuplicates])





^{:go/end 338} (go/func nameOf "nameOf returns the function (foo) or method name (foo.bar) for\nthe given function declaration. If the AST is incorrect for the\nreceiver, it assumes a function instead.\n" ^string [^{:tag (* FuncDecl)} f]
  (when [r (.-Recv f)] (and (!= r nil) (== (len (.-List r)) 1))
    ;; looks like a correct receiver declaration
    (let [t (.-Type (aget (.-List r) 0))]
      ;; dereference pointer receiver types
      (when [(values p _) (assert (* StarExpr) t)] (!= p nil)
        (set! t (.-X p)))

      ;; the receiver type must be a type name
      (when [(values p _) (assert (* Ident) t)] (!= p nil)
        (return (+ (.-Name p) "." (.-Name (.-Name f)))))))

  ;; otherwise assume a function instead

  (.-Name (.-Name f)))




(go/var ^{:doc "separator is an empty //-style comment that is interspersed between\ndifferent comment groups when they are concatenated into a single group\n"} separator (addr (lit Comment token/NoPos "//")))






^{:go/end 509} (go/func MergePackageFiles "MergePackageFiles creates a file AST by merging the ASTs of the\nfiles belonging to a package. The mode flags control merging behavior.\n\nDeprecated: this function is poorly specified and has unfixable\nbugs; also [Package] is deprecated.\n" ^{:tag (* File)} [^{:tag (* Package)} pkg ^MergeMode mode]
  ;; Count the number of package docs, comments and declarations across
  ;; all package files. Also, compute sorted list of filenames, so that
  ;; subsequent iterations can always iterate in the same order.
  (let [ndocs 0
      ^{:line 354} ncomments 0
      ^{:line 355} ndecls 0
      ^{:line 356} filenames (make (slice string) (len (.-Files pkg)))
      (values ^token/Pos minPos ^token/Pos maxPos) (zero token/Pos)
      ^{:line 358} i 0]
    (range [filename f (.-Files pkg)]
      (aset filenames i filename)
      (when (!= (.-Doc f) nil)
        (set! ndocs + (+ (len (.-List (.-Doc f))) 1))) ; +1 for separator

      (set! ncomments + (len (.-Comments f)))
      (set! ndecls + (len (.-Decls f)))
      (when (or (== i 0) (< (.-FileStart f) minPos))
        (set! minPos (.-FileStart f)))

      (when (or (== i 0) (> (.-FileEnd f) maxPos))
        (set! maxPos (.-FileEnd f)))

      (inc! i))

    (^{:inst [(slice string) string]} slices/Sort filenames)

    ;; Collect package comments from all package files into a single
    ;; CommentGroup - the collected package documentation. In general
    ;; there should be only one file with a package comment; but it's
    ;; better to collect extra comments than drop them on the floor.
    (let [^{:tag (* CommentGroup)} doc (zero (* CommentGroup))
        ^{:line 381 :tag token/Pos} pos (zero token/Pos)]
      (when (> ndocs 0)
        (let [list (make (slice (* Comment)) (- ndocs 1)) ; -1: no separator before first group
            ^{:line 384} i 0]
          (range [_ filename filenames]
            (let [f (aget (.-Files pkg) filename)]
              (when (!= (.-Doc f) nil)
                (when (> i 0)
                  ;; not the first group - add separator
                  (aset list i separator)
                  (inc! i))

                (range [_ c (.-List (.-Doc f))]
                  (aset list i c)
                  (inc! i))

                (when (> (.-Package f) pos)
                  ;; Keep the maximum package clause position as
                  ;; position for the package clause of the merged
                  ;; files.
                  (set! pos (.-Package f))))))



          (set! doc (addr (lit CommentGroup list)))))


      ;; Collect declarations from all package files.
      (let [^{:tag (slice Decl)} decls (zero (slice Decl))]
        (when (> ndecls 0)
          (set! decls (make (slice Decl) ndecls))
          (let [funcs (make (map string int)) ; map of func name -> decls index
              ^{:line 413} i 0 ; current index
              ^{:line 414} n 0] ; number of filtered entries
            (range [_ filename filenames]
              (let [f (aget (.-Files pkg) filename)]
                (range [_ d (.-Decls f)]
                  (when (!= (bit-and mode FilterFuncDuplicates) 0)
                    ;; A language entity may be declared multiple
                    ;; times in different package files; only at

              (set! decls (subslice decls 0 i)))))



        ;; Collect import specs from all package files.
        (let [^{:tag (slice (* ImportSpec))} imports (zero (slice (* ImportSpec)))]
          (if (!= (bit-and mode FilterImportDuplicates) 0)

;; This file contains printing support for ASTs.

(in-ns 'go.go.ast) (go/file "print.go" :imports [


    ^{:line 10} [fmt "fmt"]
    ^{:line 11} [token "go/token"]
    ^{:line 12} [io "io"]
    ^{:line 13} [os "os"]
    ^{:line 14} [reflect "reflect"]])



(go/type FieldFilter "A FieldFilter may be provided to [Fprint] to control the output.\n" (func [^string name ^reflect/Value value] [bool]))



^{:go/breaks [[5 27]] :go/end 28} (go/func NotNilFilter "NotNilFilter is a [FieldFilter] that returns true for field values\nthat are not nil; it returns false otherwise.\n" ^bool [^string _ ^reflect/Value v]
  (switch (.Kind v)
    (case [reflect/Chan reflect/Func reflect/Interface reflect/Map reflect/Pointer reflect/Slice]
      (return (not (.IsNil v)))))

  true)











^{:go/end 41} (go/func Fprint "Fprint prints the (sub-)tree starting at AST node x to w.\nIf fset != nil, position information is interpreted relative\nto that file set. Otherwise positions are printed as integer\nvalues (file set specific offsets).\n\nA non-nil [FieldFilter] f may be provided to control the output:\nstruct fields for which f(fieldname, fieldvalue) is true are\nprinted; all others are filtered from the output. Unexported\nstruct fields are never printed.\n" ^error [^io/Writer w ^{:tag (* token/FileSet)} fset ^any x ^FieldFilter f]
  (fprint w fset x f))


^{:go/end 69} (go/func fprint [^io/Writer w ^{:tag (* token/FileSet)} fset ^any x ^FieldFilter f] :results [^error err]
  ;; setup printer
  (let [p ^{:go/breaks [2 4 6 8 10]} (lit printer
        :output w
        :fset fset
        :filter f
        :ptrmap (make (map any int))
        :last \newline)] ; force printing of line number on first line


    ;; install error handler
    (defer (^{:go/end 58} (fn []
          (when [e (recover)] (!= e nil)
            (set! err (.-err (assert localError e))))))) ; re-panics if it's not a localError



    ;; print x
    (when (== x nil)
      (.printf p "nil\n")
      (return))

    (.print p (reflect/ValueOf x))
    (.printf p "\n")

    (return)))




^{:go/end 75} (go/func Print "Print prints x to standard output, skipping nil fields.\nPrint(fset, x) is the same as Fprint(os.Stdout, fset, x, NotNilFilter).\n" ^error [^{:tag (* token/FileSet)} fset ^any x]
  (Fprint os/Stdout fset x NotNilFilter))


(go/type printer (struct
    ^{:line 78 :tag io/Writer} output
    ^{:line 79 :tag (* token/FileSet)} fset
    ^{:line 80 :tag FieldFilter} filter
    ^{:line 81 :tag (map any int)} ptrmap ; *T -> line number
    ^{:line 82 :tag int} indent ; current indentation level
    ^{:line 83 :tag byte} last ; the last byte processed by Write
    ^{:line 84 :tag int} line)) ; current line number


(go/var indent (conv (slice byte) ".  "))

^{:go/end 119} (go/method Write [^{:tag (* printer)} p ^{:tag (slice byte)} data] :results [^int n ^error err]
  (let [^int m (zero int)]
    (range [i b data]
      ;; invariant: data[0:n] has been written
      (cond (== b \newline) (do
          (set! (values m err) (.Write (.-output p) (subslice data n (+ i 1))))
          (set! n + m)
          (when (!= err nil)
            (return))

          (inc! (.-line p)))
        (== (.-last p) \newline) (do
          (set! (values _ err) (fmt/Fprintf (.-output p) "%6d  " (.-line p)))
          (when (!= err nil)
            (return))

          (for [j (.-indent p)] (> j 0) (dec! j)
            (set! (values _ err) (.Write (.-output p) indent))
            (when (!= err nil)
              (return)))))



      (set! (.-last p) b))

    (when (> (len data) n)
      (set! (values m err) (.Write (.-output p) (subslice data n)))
      (set! n + m))

    (return)))




(go/type localError "localError wraps locally caught errors so we can distinguish\nthem from genuine panics which we don't want to return as errors.\n" (struct
    ^{:line 124 :tag error} err))



^{:go/end 132} (go/method printf "printf is a convenience wrapper that takes care of print errors.\n" [^{:tag (* printer)} p ^string format & ^{:tag (slice any)} args]
  (when [(values _ err) (fmt/Fprintf p format (spread args))] (!= err nil)
    (panic (lit localError err))))



;; Implementation note: Print is written for AST nodes but could be
;; used to print arbitrary data structures; such a version should
;; probably be in a different package.
;;
;; Note: This code detects (some) cycles created via pointers but
;; not cycles that are created via slices or maps containing the
;; same slice or map. Code for general data structures probably
;; should catch those as well.

^{:go/end 254} (go/method print [^{:tag (* printer)} p ^reflect/Value x]
  (when (not (NotNilFilter "" x))
    (.printf p "nil")
    (return))


  (switch (.Kind x)
    (case [reflect/Interface]
      (.print p (.Elem x)))

    (case [reflect/Map]
      (.printf p "%s (len = %d) {" (.Type x) (.Len x))
      (when (> (.Len x) 0)
        (inc! (.-indent p))
        (.printf p "\n")
        (range [_ key (.MapKeys x)]
          (.print p key)
          (.printf p ": ")
          (.print p (.MapIndex x key))
          (.printf p "\n"))

        (dec! (.-indent p)))

      (.printf p "}"))

    (case [reflect/Pointer]
      (.printf p "*")
      ;; type-checked ASTs may contain cycles - use ptrmap
      ;; to keep track of objects that have been printed
      ;; already and print the respective line number instead
      (let [ptr (.Interface x)]
        (if [(values line exists) (aget (.-ptrmap p) ptr)] exists
          (.printf p "(obj @ %d)" line)
          (do
            (aset (.-ptrmap p) ptr (.-line p))
            (.print p (.Elem x))))))


    (case [reflect/Array]
      (.printf p "%s {" (.Type x))
      (when (> (.Len x) 0)
        (inc! (.-indent p))
        (.printf p "\n")
        (for [(values i n) (values 0 (.Len x))] (< i n) (inc! i)
          (.printf p "%d: " i)
          (.print p (.Index x i))
          (.printf p "\n"))

        (dec! (.-indent p)))

      (.printf p "}"))

    (case [reflect/Slice]
      (when [(values s ok) (assert (slice byte) (.Interface x))] ok
        (.printf p "%#q" s)
        (return))

      (.printf p "%s (len = %d) {" (.Type x) (.Len x))
      (when (> (.Len x) 0)
        (inc! (.-indent p))
        (.printf p "\n")
        (for [(values i n) (values 0 (.Len x))] (< i n) (inc! i)
          (.printf p "%d: " i)
          (.print p (.Index x i))
          (.printf p "\n"))

        (dec! (.-indent p)))

      (.printf p "}"))

    (case [reflect/Struct]
      (let [t (.Type x)]
        (.printf p "%s {" t)
        (inc! (.-indent p))
        (let [first true]
          (for [(values i n) (values 0 (.NumField t))] (< i n) (inc! i)
            ;; exclude non-exported fields because their
            ;; values cannot be accessed via reflection
            (when [name (.-Name (.Field t i))] (IsExported name)
              (let [value (.Field x i)]
                (when (or (== (.-filter p) nil) ((.-filter p) name value))
                  (when first
                    (.printf p "\n")
                    (set! first false))

                  (.printf p "%s: " name)
                  (.print p value)
                  (.printf p "\n")))))



          (dec! (.-indent p))
          (.printf p "}"))))

    (default
      (let [v (.Interface x)]
        (type-switch [v v]
          (case [string]
            ;; print strings in quotes
            (.printf p "%q" v)
            (return))
          (case [token/Pos]
            ;; position values can be printed nicely if we have a file set
            (when (!= (.-fset p) nil)
              (.printf p "%s" (.Position (.-fset p) v))
              (return))))


        ;; default
        (.printf p "%v" v)))))

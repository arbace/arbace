;; Package importer provides access to export data importers.
;;
;; These functions, which are mostly deprecated, date from before the
;; introduction of modules in release Go 1.11. They should no longer
;; be relied on except for use in test cases using small programs that
;; depend only on the standard library. For reliable module-aware
;; loading of type information, use the packages.Load function from
;; golang.org/x/tools/go/packages.
(in-ns 'go.go.importer) (go/file "importer.go" :doc "Package importer provides access to export data importers.\n\nThese functions, which are mostly deprecated, date from before the\nintroduction of modules in release Go 1.11. They should no longer\nbe relied on except for use in test cases using small programs that\ndepend only on the standard library. For reliable module-aware\nloading of type information, use the packages.Load function from\ngolang.org/x/tools/go/packages.\n" :imports [


    ^{:line 16} [build "go/build"]
    ^{:line 17} [gccgoimporter "go/internal/gccgoimporter"]
    ^{:line 18} [gcimporter "go/internal/gcimporter"]
    ^{:line 19} [srcimporter "go/internal/srcimporter"]
    ^{:line 20} [token "go/token"]
    ^{:line 21} [types "go/types"]
    ^{:line 22} [io "io"]
    ^{:line 23} [runtime "runtime"]])




(go/type Lookup "A Lookup function returns a reader to access package data for\na given import path, or an error if no matching package is found.\n" (func [^string path] [io/ReadCloser error]))



















^{:go/breaks [[5 77]] :go/end 78} (go/func ForCompiler "ForCompiler returns an Importer for importing from installed packages\nfor the compilers \"gc\" and \"gccgo\", or for importing directly\nfrom the source if the compiler argument is \"source\". In this\nlatter case, importing may fail under circumstances where the\nexported API is not entirely defined in pure Go source code\n(if the package API depends on cgo-defined entities, the type\nchecker won't have access to those).\n\nThe lookup function is called each time the resulting importer needs\nto resolve an import path. In this mode the importer can only be\ninvoked with canonical import paths (not relative or absolute ones);\nit is assumed that the translation to canonical import paths is being\ndone by the client of the importer.\n\nA lookup function must be provided for correct module-aware\noperation. Providing a nil value for lookup is deprecated but, for\nbackwards-compatibility, the importer will in this case attempt to\nresolve imports in the $GOPATH workspace.\n" ^types/Importer [^{:tag (* token/FileSet)} fset ^string compiler ^Lookup lookup]
  (switch compiler
    (case ["gc"]
      (return (addr ^{:go/breaks [2 4 6]} (lit gcimports
            :fset fset
            :packages (make (map string (* types/Package)))
            :lookup lookup))))


    (case ["gccgo"]
      (let [^gccgoimporter/GccgoInstallation inst (zero gccgoimporter/GccgoInstallation)]
        (when [err (.InitFromDriver inst "gccgo")] (!= err nil)
          (return nil))

        (return (addr ^{:go/breaks [2 4 6]} (lit gccgoimports
              :packages (make (map string (* types/Package)))
              :importer (.GetImporter inst nil nil)
              :lookup lookup)))))


    (case ["source"]
      (when (!= lookup nil)
        (panic "source importer for custom import path lookup not supported (issue #13847)."))


      (return (srcimporter/New (addr build/Default) fset (make (map string (* types/Package)))))))


  ;; compiler not supported
  nil)








^{:go/end 88} (go/func ^{:go/fix "inline"} For "For calls [ForCompiler] with a new FileSet.\n\nDeprecated: Use [ForCompiler], which populates a FileSet\nwith the positions of objects created by the importer.\n" ^types/Importer [^string compiler ^Lookup lookup]
  (ForCompiler (token/NewFileSet) compiler lookup))










^{:go/end 100} (go/func Default "Default returns an Importer for the compiler that built the running binary.\nIf available, the result implements [types.ImporterFrom].\n\nDefault may be convenient for use in the simplest of cases, but\nmost clients should instead use [ForCompiler], which accepts a\n[token.FileSet] from the caller; without it, all position\ninformation derived from the Importer will be incorrect and\nmisleading. See also the package documentation.\n" ^types/Importer []
  (For runtime/Compiler nil))


;; gc importer

(go/type gcimports (struct
    ^{:line 105 :tag (* token/FileSet)} fset
    ^{:line 106 :tag (map string (* types/Package))} packages
    ^{:line 107 :tag Lookup} lookup))


^{:go/end 112} (go/method Import [^{:tag (* gcimports)} m ^string path] :results [(* types/Package) error]
  (.ImportFrom m path "" 0)) ; /* no vendoring */


^{:go/end 119} (go/method ImportFrom [^{:tag (* gcimports)} m ^string path ^string srcDir ^types/ImportMode mode] :results [(* types/Package) error]
  (when (!= mode 0)
    (panic "mode must be 0"))

  (gcimporter/Import (.-fset m) (.-packages m) path srcDir (.-lookup m)))


;; gccgo importer

(go/type gccgoimports (struct
    ^{:line 124 :tag (map string (* types/Package))} packages
    ^{:line 125 :tag gccgoimporter/Importer} importer
    ^{:line 126 :tag Lookup} lookup))


^{:go/end 131} (go/method Import [^{:tag (* gccgoimports)} m ^string path] :results [(* types/Package) error]
  (.ImportFrom m path "" 0)) ; /* no vendoring */


^{:go/end 138} (go/method ImportFrom [^{:tag (* gccgoimports)} m ^string path ^string srcDir ^types/ImportMode mode] :results [(* types/Package) error]
  (when (!= mode 0)
    (panic "mode must be 0"))

  ((.-importer m) (.-packages m) path srcDir (.-lookup m)))

  ;;   comment, we make sure End returns its ending position (i.e. prevPos+len("\n")).
  (when (.-endPosValid s)
    (return (.-endPos s)))


  ;; Normal case: s.file.Pos(s.offset) represents the end of the token
  (.Pos (.-file s) (.-offset s)))


































^{:go/end 999} (go/method Scan "Scan scans the next token and returns the token position, the token,\nand its literal string if applicable. The source end is indicated by\n[token.EOF].\n\nIf the returned token is a literal ([token.IDENT], [token.INT], [token.FLOAT],\n[token.IMAG], [token.CHAR], [token.STRING]) or [token.COMMENT], the literal string\nhas the corresponding value.\n\nIf the returned token is a keyword, the literal string is the keyword.\n\nIf the returned token is [token.SEMICOLON], the corresponding\nliteral string is \";\" if the semicolon was present in the source,\nand \"\\n\" if the semicolon was inserted because of a newline or\nat EOF. If the newline is within a /*...*/ comment, the SEMICOLON token\nis synthesized immediately after the COMMENT token; its position is that\nof the actual newline within the comment.\n\nIf the returned token is [token.ILLEGAL], the literal string is the\noffending character.\n\nIn all other cases, Scan returns an empty literal string.\n\nFor more tolerant parsing, Scan will return a valid token if\npossible even if a syntax error was encountered. Thus, even\nif the resulting token sequence contains no illegal tokens,\na client may not assume that no error occurred. Instead it\nmust check the scanner's ErrorCount or the number of calls\nof the error handler, if there was one installed.\n\nScan adds line information to the file added to the file\nset with Init. Token positions are relative to that file\nand thus relative to the file set.\n" [^{:tag (* Scanner)} s] :results [^token/Pos pos ^token/Token tok ^string lit]
  (label :scanAgain
    (set! (.-endPosValid s) false))
  (when (.IsValid (.-nlPos s))
    ;; Return artificial ';' token after /*...*/ comment
    ;; containing newline, at position of first newline.
    (set! (values pos tok lit) (values (.-nlPos s) token/SEMICOLON "\n"))
    (set! (.-endPos s) (+ pos 1))
    (set! (.-endPosValid s) true)
    (set! (.-nlPos s) token/NoPos)
    (return))


  (.skipWhitespace s)

  ;; current token start
  (set! pos (.Pos (.-file s) (.-offset s)))

  ;; determine token value
  (let [insertSemi false]
    (switch [ch (.-ch s)]
      (case [(isLetter ch)]
        (set! lit (.scanIdentifier s))
        (if (> (len lit) 1) (do
            ;; keywords are longer than one letter - avoid lookup otherwise
            (set! tok (token/Lookup lit))
            (switch tok
              (case [token/IDENT token/BREAK token/CONTINUE token/FALLTHROUGH token/RETURN]
                (set! insertSemi true))))

          (do
            (set! insertSemi true)
            (set! tok token/IDENT))))

      (case [(or (isDecimal ch) (and (== ch \.) (isDecimal (conv rune (.peek s)))))]
        (set! insertSemi true)
        (set! (values tok lit) (.scanNumber s)))
      (default
        (.next s) ; always make progress
        (switch ch
          (case [eof]
            (when (.-insertSemi s)
              (set! (.-insertSemi s) false) ; EOF consumed
              (return pos token/SEMICOLON "\n"))

            (set! tok token/EOF))
          (case [\newline]
            ;; we only reach here if s.insertSemi was
            ;; set in the first place and exited early
            ;; from s.skipWhitespace()
            (set! (.-insertSemi s) false) ; newline consumed
            (return pos token/SEMICOLON "\n"))
          (case [\"]
            (set! insertSemi true)
            (set! tok token/STRING)
            (set! lit (.scanString s)))
          (case [\']
            (set! insertSemi true)
            (set! tok token/CHAR)
            (set! lit (.scanRune s)))
          (case [\`]
            (set! insertSemi true)
            (set! tok token/STRING)
            (set! lit (.scanRawString s)))
          (case [\:]
            (set! tok (.switch2 s token/COLON token/DEFINE)))
          (case [\.]
            ;; fractions starting with a '.' are handled by outer switch
            (set! tok token/PERIOD)
            (when (and (== (.-ch s) \.) (== (.peek s) \.))
              (.next s)
              (.next s) ; consume last '.'
              (set! tok token/ELLIPSIS)))

          (case [\,]
            (set! tok token/COMMA))
          (case [\;]
            (set! tok token/SEMICOLON)
            (set! lit ";"))
          (case [\(]
            (set! tok token/LPAREN))
          (case [\)]
            (set! insertSemi true)
            (set! tok token/RPAREN))
          (case [\[]
            (set! tok token/LBRACK))
          (case [\]]
            (set! insertSemi true)
            (set! tok token/RBRACK))
          (case [\{]
            (set! tok token/LBRACE))
          (case [\}]
            (set! insertSemi true)
            (set! tok token/RBRACE))
          (case [\+]
            (set! tok (.switch3 s token/ADD token/ADD_ASSIGN \+ token/INC))
            (when (== tok token/INC)
              (set! insertSemi true)))

          (case [\-]
            (set! tok (.switch3 s token/SUB token/SUB_ASSIGN \- token/DEC))
            (when (== tok token/DEC)
              (set! insertSemi true)))

          (case [\*]
            (set! tok (.switch2 s token/MUL token/MUL_ASSIGN)))
          (case [\/]
            (if (or (== (.-ch s) \/) (== (.-ch s) \*))
              ;; comment
              (let [(values comment nlOffset) (.scanComment s)]
                (if (and (.-insertSemi s) (!= nlOffset 0)) (do
                    ;; For /*...*/ containing \n, return
                    ;; COMMENT then artificial SEMICOLON.
                    (set! (.-nlPos s) (.Pos (.-file s) nlOffset))
                    (set! (.-insertSemi s) false))

                  (set! insertSemi (.-insertSemi s))) ; preserve insertSemi info

                (when (== (bit-and (.-mode s) ScanComments) 0)
                  ;; skip comment
                  (goto :scanAgain))

                (set! tok token/COMMENT)
                (set! lit comment))

              ;; division
              (set! tok (.switch2 s token/QUO token/QUO_ASSIGN))))

          (case [\%]
            (set! tok (.switch2 s token/REM token/REM_ASSIGN)))
          (case [\^]
            (set! tok (.switch2 s token/XOR token/XOR_ASSIGN)))
          (case [\<]
            (if (== (.-ch s) \-) (do
                (.next s)
                (set! tok token/ARROW))

              (set! tok (.switch4 s token/LSS token/LEQ \< token/SHL token/SHL_ASSIGN))))

          (case [\>]
            (set! tok (.switch4 s token/GTR token/GEQ \> token/SHR token/SHR_ASSIGN)))
          (case [\=]
            (set! tok (.switch2 s token/ASSIGN token/EQL)))
          (case [\!]
            (set! tok (.switch2 s token/NOT token/NEQ)))
          (case [\&]
            (if (== (.-ch s) \^) (do
                (.next s)
                (set! tok (.switch2 s token/AND_NOT token/AND_NOT_ASSIGN)))

              (set! tok (.switch3 s token/AND token/AND_ASSIGN \& token/LAND))))

          (case [\|]
            (set! tok (.switch3 s token/OR token/OR_ASSIGN \| token/LOR)))
          (case [\~]
            (set! tok token/TILDE))
          (default
            ;; next reports unexpected BOMs - don't repeat
            (when (!= ch bom)
              ;; Report an informative error for U+201[CD] quotation
              ;; marks, which are easily introduced via copy and paste.
              (if (or (== ch \“) (== ch \”))
                (.errorf s (.Offset (.-file s) pos) "curly quotation mark %q (use neutral %q)" ch \")

                (.errorf s (.Offset (.-file s) pos) "illegal character %#U" ch)))


            (set! insertSemi (.-insertSemi s)) ; preserve insertSemi info
            (set! tok token/ILLEGAL)
            (set! lit (conv string ch))))))


    (when (== (bit-and (.-mode s) dontInsertSemis) 0)
      (set! (.-insertSemi s) insertSemi))


    (return)))

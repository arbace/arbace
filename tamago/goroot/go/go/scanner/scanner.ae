    (.next s)
    (return tok1))

  (when (== (.-ch s) ch2)
    (.next s)
    (when (== (.-ch s) \=)
      (.next s)
      (return tok3))

    (return tok2))

  ^{:line 772} tok0)




^{:go/end 788} (go/method End "End returns the position immediately after the last scanned token.\nIf [Scanner.Scan] has not been called yet, End returns [token.NoPos].\n" ^token/Pos [^{:tag (* Scanner)} s]

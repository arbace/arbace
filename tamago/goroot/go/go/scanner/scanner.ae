    (.next s)
    (return tok1))

  ^{:line 744} tok0)


^{:go/end 757} (go/method switch3 ^token/Token [^{:tag (* Scanner)} s ^token/Token tok0 ^token/Token tok1 ^rune ch2 ^token/Token tok2]
  (when (== (.-ch s) \=)
    (.next s)
    (return tok1))

  (when (== (.-ch s) ch2)
    (.next s)
    (return tok2))

  ^{:line 756} tok0)


^{:go/end 773} (go/method switch4 ^token/Token [^{:tag (* Scanner)} s ^token/Token tok0 ^token/Token tok1 ^rune ch2 ^token/Token tok2 ^token/Token tok3]

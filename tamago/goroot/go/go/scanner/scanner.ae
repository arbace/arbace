  (when (!= (.Size file) (len src))
    (panic (fmt/Sprintf "file size (%d) does not match src len (%d)" (.Size file) (len src))))


  (let [(values dir _) (filepath/Split (.Name file))]

    (set! @s ^{:go/breaks [2 4 6 8 10 [12 151] 14 16]} (lit Scanner
        :file file
        :dir dir
        :src src
        :err err
        :mode mode


      (when (or (!= ch \return) (and comment (> i (len "/*")) (== (aget c (- i 1)) \*) (< (+ j 1) (len b)) (== (aget b (+ j 1)) \/)))
        (aset c i ch)
        (inc! i)))


    (subslice c _ i)))


^{:go/end 725} (go/method scanRawString ^string [^{:tag (* Scanner)} s]
  ;; '`' opening already consumed
  (let [offs (- (.-offset s) 1)

      ^{:line 703} hasCR false]
    (while true
      (let [ch (.-ch s)]
        (when (< ch 0)
          (.error s offs "raw string literal not terminated")
          (break))

        (.next s)
        (when (== ch \`)
          (break))

        (when (== ch \return)
          (set! hasCR true))))



    (let [lit (subslice (.-src s) offs (.-offset s))]
      (when hasCR
        (set! lit (stripCR lit false)))


      (conv string lit))))


^{:go/end 731} (go/method skipWhitespace [^{:tag (* Scanner)} s]

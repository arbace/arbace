(in-ns 'go.go.scanner) (go/file "errors.go" :imports [


    ^{:line 8} [fmt "fmt"]
    ^{:line 9} [token "go/token"]
    ^{:line 10} [io "io"]
    ^{:line 11} [sort "sort"]])






(go/type Error "In an [ErrorList], an error is represented by an *Error.\nThe position Pos, if valid, points to the beginning of\nthe offending token, and the error condition is described\nby Msg.\n" (struct
    ^{:line 19 :tag token/Position} Pos
    ^{:line 20 :tag string} Msg))


(go/var ^error _ (conv (* Error) nil)) ; *Error (not Error) is the correct type in error.Is tests.


^{:go/end 33} (go/method Error "Error implements the error interface.\n" ^string [^Error e]
  (when (or (!= (.-Filename (.-Pos e)) "") (.IsValid (.-Pos e)))
    ;; don't print "<unknown position>"
    ;; TODO(gri) reconsider the semantics of Position.IsValid
    (return (+ (.String (.-Pos e)) ": " (.-Msg e))))

  (.-Msg e))




(go/type ErrorList "ErrorList is a list of *Errors.\nThe zero value for an ErrorList is an empty ErrorList ready to use.\n" (slice (* Error)))


^{:go/end 42} (go/method Add "Add adds an [Error] with given position and error message to an [ErrorList].\n" [^{:tag (* ErrorList)} p ^token/Position pos ^string msg]
  (set! @p (append @p (addr (lit Error pos msg)))))



^{:go/end 45} (go/method Reset "Reset resets an [ErrorList] to no errors.\n" [^{:tag (* ErrorList)} p] (set! @p (subslice @p 0 0)))


^{:go/end 48} (go/method Len "[ErrorList] implements the sort Interface.\n" ^int [^ErrorList p] (len p))
^{:go/end 49} (go/method Swap [^ErrorList p ^int i ^int j] (set! (values (aget p i) (aget p j)) (values (aget p j) (aget p i))))

^{:go/end 67} (go/method Less ^bool [^ErrorList p ^int i ^int j]
  (let [e (addr (.-Pos (aget p i)))
      ^{:line 53} f (addr (.-Pos (aget p j)))]
    ;; Note that it is not sufficient to simply compare file offsets because
    ;; the offsets do not reflect modified line information (through //line
    ;; comments).
    (when (!= (.-Filename e) (.-Filename f))
      (return (< (.-Filename e) (.-Filename f))))

    (when (!= (.-Line e) (.-Line f))
      (return (< (.-Line e) (.-Line f))))

    (when (!= (.-Column e) (.-Column f))
      (return (< (.-Column e) (.-Column f))))

    (< (.-Msg (aget p i)) (.-Msg (aget p j)))))





^{:go/end 74} (go/method Sort "Sort sorts an [ErrorList]. *[Error] entries are sorted by position,\nother errors are sorted by error message, and before any *[Error]\nentry.\n" [^ErrorList p]
  (sort/Sort p))



^{:go/end 89} (go/method RemoveMultiples "RemoveMultiples sorts an [ErrorList] and removes all but the first error per line.\n" [^{:tag (* ErrorList)} p]
  (sort/Sort p)
  (let [^token/Position last (zero token/Position) ; initial last.Line is != any legal error line
      ^{:line 80} i 0]
    (range [_ e @p]
      (when (or (!= (.-Filename (.-Pos e)) (.-Filename last)) (!= (.-Line (.-Pos e)) (.-Line last)))
        (set! last (.-Pos e))
        (aset @p i e)
        (inc! i)))


    (set! @p (subslice @p 0 i))))



^{:go/end 100} (go/method Error "An [ErrorList] implements the error interface.\n" ^string [^ErrorList p]
  (switch (len p)
    (case [0]
      (return "no errors"))
    (case [1]
      (return (.Error (aget p 0)))))

  (fmt/Sprintf "%s (and %d more errors)" (aget p 0) (- (len p) 1)))




^{:go/end 109} (go/method Err "Err returns an error equivalent to this error list.\nIf the list is empty, Err returns nil.\n" ^error [^ErrorList p]
  (when (== (len p) 0)
    (return nil))

  ^{:line 108} p)





^{:go/end 122} (go/func PrintError "PrintError is a utility function that prints a list of errors to w,\none error per line, if the err parameter is an [ErrorList]. Otherwise\nit prints the err string.\n" [^io/Writer w ^error err]
  (if [(values list ok) (assert ErrorList err)] ok
    (range [_ e list]
      (fmt/Fprintf w "%s\n" e))

    (when (!= err nil)
      (fmt/Fprintf w "%s\n" err))))

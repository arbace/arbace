;; Package parser implements a parser for Go source files.
;;
;; The [ParseFile] function reads file input from a string, []byte, or
;; io.Reader, and produces an [ast.File] representing the complete
;; abstract syntax tree of the file.
;;
;; The [ParseExprFrom] function reads a single source-level expression and
;; produces an [ast.Expr], the syntax tree of the expression.
;;
;; The parser accepts a larger language than is syntactically permitted by
;; the Go spec, for simplicity, and for improved robustness in the presence
;; of syntax errors. For instance, in method declarations, the receiver is
;; treated like an ordinary parameter list and thus may contain multiple
;; entries where the spec permits exactly one. Consequently, the corresponding
;; field in the AST (ast.FuncDecl.Recv) field is not restricted to one entry.
;;
;; Applications that need to parse one or more complete packages of Go
;; source code may find it more convenient not to interact directly
;; with the parser but instead to use the Load function in package
;; [golang.org/x/tools/go/packages].
(in-ns 'go.go.parser) (go/file "parser.go" :doc "Package parser implements a parser for Go source files.\n\nThe [ParseFile] function reads file input from a string, []byte, or\nio.Reader, and produces an [ast.File] representing the complete\nabstract syntax tree of the file.\n\nThe [ParseExprFrom] function reads a single source-level expression and\nproduces an [ast.Expr], the syntax tree of the expression.\n\nThe parser accepts a larger language than is syntactically permitted by\nthe Go spec, for simplicity, and for improved robustness in the presence\nof syntax errors. For instance, in method declarations, the receiver is\ntreated like an ordinary parameter list and thus may contain multiple\nentries where the spec permits exactly one. Consequently, the corresponding\nfield in the AST (ast.FuncDecl.Recv) field is not restricted to one entry.\n\nApplications that need to parse one or more complete packages of Go\nsource code may find it more convenient not to interact directly\nwith the parser but instead to use the Load function in package\n[golang.org/x/tools/go/packages].\n" :imports [


    ^{:line 28} [fmt "fmt"]
    ^{:line 29} [ast "go/ast"]
    ^{:line 30} [constraint "go/build/constraint"]
    ^{:line 31} [scanner "go/scanner"]
    ^{:line 32} [token "go/token"]
    ^{:line 33} [strings "strings"]])



(go/type parser "The parser structure holds the parser's internal state.\n" (struct
    ^{:line 38 :tag (* token/File)} file
    ^{:line 39 :tag scanner/ErrorList} errors
    ^{:line 40 :tag scanner/Scanner} scanner


    ^{:line 43 :tag Mode :doc "Tracing/debugging\n"} mode ; parsing mode
    ^{:line 44 :tag bool} trace ; == (mode&Trace != 0)
    ^{:line 45 :tag int} indent ; indentation used for tracing output


    ^{:line 48 :tag (slice (* ast/CommentGroup)) :doc "Comments\n"} comments
    ^{:line 49 :tag (* ast/CommentGroup)} leadComment ; last lead comment
    ^{:line 50 :tag (* ast/CommentGroup)} lineComment ; last line comment
    ^{:line 51 :tag bool} top ; in top of file (before package clause)
    ^{:line 52 :tag string} goVersion ; minimum Go version found in //go:build comment


    ^{:line 55 :tag token/Pos :doc "Next token\n"} pos ; token position
    ^{:line 56 :tag token/Token} tok ; one token look-ahead
    ^{:line 57 :tag string} lit ; token literal





    ^{:line 63 :tag token/Pos :doc "Error recovery\n(used to limit the number of calls to parser.advance\nw/o making scanning progress - avoids potential endless\nloops across multiple parser functions during error recovery)\n"} syncPos ; last synchronization position
    ^{:line 64 :tag int} syncCnt ; number of parser.advance calls without progress



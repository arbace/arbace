  (let [^:const ^{:val ". . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . "} dots ". . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . "
      ^:const ^{:line 98 :val 64} n (len dots)
      ^{:line 99} pos (.Position (.-file p) (.-pos p))]
    (fmt/Printf "%5d:%3d: " (.-Line pos) (.-Column pos))
    (let [i (* 2 (.-indent p))]
      (while (> i n)
        (fmt/Print dots)
        (set! i - n))

      ;; i <= n
      (fmt/Print (subslice dots 0 i))
      (fmt/Println (spread a)))))



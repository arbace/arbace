^{:go/end 176} (go/method next0 "Advance to the next token.\n" [^{:tag (* parser)} p]
  ;; Because of one-token look-ahead, print the previous token
  ;; when tracing as it provides a more readable output. The
  ;; very first token (!p.pos.IsValid()) is not initialized
  ;; (it is token.ILLEGAL), so don't print it.
  (when (and (.-trace p) (.IsValid (.-pos p)))
    (let [s (.String (.-tok p))]
      (switch
        (case [(.IsLiteral (.-tok p))]
          (.printTrace p s (.-lit p)))
        (case [(.IsOperator (.-tok p)) (.IsKeyword (.-tok p))]
          (.printTrace p (+ "\"" s "\"")))
        (default
          (.printTrace p s)))))



  (while true
    (set! (values (.-pos p) (.-tok p) (.-lit p)) (.Scan (.-scanner p)))
    (if (== (.-tok p) token/COMMENT) (do
        (when (and (.-top p) (strings/HasPrefix (.-lit p) "//go:build"))
          (when [(values x err) (constraint/Parse (.-lit p))] (== err nil)
            (set! (.-goVersion p) (constraint/GoVersion x))))


        (when (== (bit-and (.-mode p) ParseComments) 0)
          (continue)))


      ;; Found a non-comment; top of file is over.
      (set! (.-top p) false))

    (break)))





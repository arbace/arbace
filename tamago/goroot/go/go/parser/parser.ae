  (set! (.-file p) file)
  (let [eh ^{:go/end 79} (fn [^token/Position pos ^string msg] (.Add (.-errors p) pos msg))]
    (.Init (.-scanner p) (.-file p) src eh scanner/ScanComments)

    (set! (.-top p) true)
    (set! (.-mode p) mode)

^{:go/end 55} (go/func resolveFile "resolveFile walks the given file to resolve identifiers within the file\nscope, updating ast.Ident.Obj fields with declaration information.\n\nIf declErr is non-nil, it is used to report declaration errors during\nresolution. tok is used to format position in error messages.\n" [^{:tag (* ast/File)} file ^{:tag (* token/File)} handle ^{:tag (func [token/Pos string])} declErr]
  (let [pkgScope (ast/NewScope nil)
      ^{:line 23} r (addr ^{:go/breaks [2 4 6 8 10]} (lit resolver
          :handle handle
          :declErr declErr
          :topScope pkgScope
          :pkgScope pkgScope
          :depth 1))]


    (range [_ decl (.-Decls file)]
      (ast/Walk r decl))


    (.closeScope r)
    (go/call assert (== (.-topScope r) nil) "unbalanced scopes")
    (go/call assert (== (.-labelScope r) nil) "unbalanced label scopes")

    ;; resolve global identifiers within the same file
    (let [i 0]
      (range [_ ident (.-unresolved r)]
        ;; i <= index for current ident
        (go/call assert (== (.-Obj ident) unresolved) "object already resolved")
        (set! (.-Obj ident) (.Lookup (.-pkgScope r) (.-Name ident))) ; also removes unresolved sentinel
        (cond (== (.-Obj ident) nil) (do
            (aset (.-unresolved r) i ident)
            (inc! i))
          ^{:line 48} debugResolve
          (let [pos (.Pos (assert (interface (Pos ^token/Pos [])) (.-Decl (.-Obj ident))))]
            (.trace r "resolved %s@%v to package object %v" (.-Name ident) (.Pos ident) pos))))


      (set! (.-Scope file) (.-pkgScope r))
      (set! (.-Unresolved file) (subslice (.-unresolved r) 0 i)))))


(go/const ^{:tag int :val 1000} maxScopeDepth 1000.0)


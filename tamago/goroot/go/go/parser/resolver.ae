    (case [(* ast/BlockStmt)]
      (.openScope r (.Pos n))
      (defer (.closeScope r))
      (.walkStmts r (.-List n)))

    (case [(* ast/IfStmt)]
      (.openScope r (.Pos n))
      (defer (.closeScope r))
      (when (!= (.-Init n) nil)
        (ast/Walk r (.-Init n)))

      (ast/Walk r (.-Cond n))
      (ast/Walk r (.-Body n))
      (when (!= (.-Else n) nil)
        (ast/Walk r (.-Else n))))


    (case [(* ast/CaseClause)]
      (.walkExprs r (.-List n))
      (.openScope r (.Pos n))
      (defer (.closeScope r))
      (.walkStmts r (.-Body n)))

    (case [(* ast/SwitchStmt)]
      (.openScope r (.Pos n))
      (defer (.closeScope r))

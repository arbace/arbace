^{:go/breaks [[5 512]] :go/end 513} (go/method Visit ^ast/Visitor [^{:tag (* resolver)} r ^ast/Node node]
  (when (and debugResolve (!= node nil))
    (.trace r "node %T@%v" node (.Pos node)))


  (type-switch [n node]

    ;; Expressions.
    (case [(* ast/Ident)]
      (.resolve r n true))

    (case [(* ast/FuncLit)]
      (.openScope r (.Pos n))
      (defer (.closeScope r))
      (.walkFuncType r (.-Type n))
      (.walkBody r (.-Body n)))

    (case [(* ast/SelectorExpr)]
      (ast/Walk r (.-X n)))
    ;; Note: don't try to resolve n.Sel, as we don't support qualified
    ;; resolution.

    (case [(* ast/StructType)]
      (.openScope r (.Pos n))
      (defer (.closeScope r))
      (.walkFieldList r (.-Fields n) ast/Var))

    (case [(* ast/FuncType)]
      (.openScope r (.Pos n))
      (defer (.closeScope r))
      (.walkFuncType r n))

    (case [(* ast/CompositeLit)]
      (when (!= (.-Type n) nil)
        (ast/Walk r (.-Type n)))

      (range [_ e (.-Elts n)]

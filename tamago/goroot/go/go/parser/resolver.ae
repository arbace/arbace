            ((.-declErr r) (.Pos ident) (fmt/Sprintf "%s redeclared in this block%s" (.-Name ident) prevDecl))))))))





^{:go/end 185} (go/method shortVarDecl [^{:tag (* resolver)} r ^{:tag (* ast/AssignStmt)} decl]
  ;; Go spec: A short variable declaration may redeclare variables
  ;; provided they were originally declared in the same block with

  (.resolveList r list))


^{:go/end 612} (go/method walkBody [^{:tag (* resolver)} r ^{:tag (* ast/BlockStmt)} body]
  (when (== body nil)
    (return))

  (.openLabelScope r)
  (defer (.closeLabelScope r))
  (.walkStmts r (.-List body)))

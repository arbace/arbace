^{:go/end 156} (go/method declare [^{:tag (* resolver)} r ^any decl ^any data ^{:tag (* ast/Scope)} scope ^ast/ObjKind kind & ^{:tag (slice (* ast/Ident))} idents]
  (range [_ ident idents]

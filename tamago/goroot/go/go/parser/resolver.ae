      ;; Resolve and declare parameters in a specific order to get duplicate
      ;; declaration errors in the correct location.
      (.resolveList r (.-Params (.-Type n)))
      (.resolveList r (.-Results (.-Type n)))
      (.declareList r (.-Recv n) ast/Var)
      (.declareList r (.-Params (.-Type n)) ast/Var)
      (.declareList r (.-Results (.-Type n)) ast/Var)

      (.walkBody r (.-Body n))

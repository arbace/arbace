  nil)


^{:go/end 521} (go/method walkFuncType [^{:tag (* resolver)} r ^{:tag (* ast/FuncType)} typ]
  ;; typ.TypeParams must be walked separately for FuncDecls.
  (.resolveList r (.-Params typ))
  (.resolveList r (.-Results typ))
  (.declareList r (.-Params typ) ast/Var)
  (.declareList r (.-Results typ) ast/Var))


^{:go/end 532} (go/method resolveList [^{:tag (* resolver)} r ^{:tag (* ast/FieldList)} list]
  (when (== list nil)
    (return))

  (range [_ f (.-List list)]
    (when (!= (.-Type f) nil)
      (ast/Walk r (.-Type f)))))




^{:go/end 541} (go/method declareList [^{:tag (* resolver)} r ^{:tag (* ast/FieldList)} list ^ast/ObjKind kind]
  (when (== list nil)
    (return))

  (range [_ f (.-List list)]
    (.declare r f nil (.-topScope r) kind (spread (.-Names f)))))



^{:go/end 587} (go/method walkRecv [^{:tag (* resolver)} r ^{:tag (* ast/FieldList)} recv]
  ;; If our receiver has receiver type parameters, we must declare them before
  ;; trying to resolve the rest of the receiver, and avoid re-resolving the
  ;; type parameter identifiers.
  (when (or (== recv nil) (== (len (.-List recv)) 0))
    (return)) ; nothing to do

  (let [typ (.-Type (aget (.-List recv) 0))]
    (when [(values ptr ok) (assert (* ast/StarExpr) typ)] ok
      (set! typ (.-X ptr)))



    ^{:line 60 :tag (* token/File)} handle
    ^{:line 61 :tag (func [token/Pos string])} declErr


    ^{:line 64 :tag (* ast/Scope) :doc "Ordinary identifier scopes\n"} pkgScope ; pkgScope.Outer == nil
    ^{:line 65 :tag (* ast/Scope)} topScope ; top-most scope; may be pkgScope
    ^{:line 66 :tag (slice (* ast/Ident))} unresolved ; unresolved identifiers
    ^{:line 67 :tag int} depth ; scope depth



    ^{:line 71 :tag (* ast/Scope) :doc "Label scopes\n(maintained by open/close LabelScope)\n"} labelScope ; label scope for current function
    ^{:line 72 :tag (slice (slice (* ast/Ident)))} targetStack)) ; stack of unresolved labels


^{:go/end 77} (go/method trace [^{:tag (* resolver)} r ^string format & ^{:tag (slice any)} args]
  (fmt/Println (+ (strings/Repeat ". " (.-depth r)) (.sprintf r format (spread args)))))


^{:go/end 87} (go/method sprintf ^string [^{:tag (* resolver)} r ^string format & ^{:tag (slice any)} args]
  (range [i arg args]

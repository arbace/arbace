          (ast/Walk r (.-Type f)))))))




^{:go/end 595} (go/method walkFieldList [^{:tag (* resolver)} r ^{:tag (* ast/FieldList)} list ^ast/ObjKind kind]
  (when (== list nil)
    (return))

  (.resolveList r list)
  (.declareList r list kind))





^{:go/end 603} (go/method walkTParams "walkTParams is like walkFieldList, but declares type parameters eagerly so\nthat they may be resolved in the constraint expressions held in the field\nType.\n" [^{:tag (* resolver)} r ^{:tag (* ast/FieldList)} list]

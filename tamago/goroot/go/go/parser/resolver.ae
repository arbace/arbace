              (.resolve r ident false)

              (ast/Walk r (.-Key kv)))

            (ast/Walk r (.-Value kv)))

          (ast/Walk r e))))



    (case [(* ast/InterfaceType)]
      (.openScope r (.Pos n))
      (defer (.closeScope r))
      (.walkFieldList r (.-Methods n) ast/Fun))

    ;; Statements
    (case [(* ast/LabeledStmt)]
      (.declare r n nil (.-labelScope r) ast/Lbl (.-Label n))
      (ast/Walk r (.-Stmt n)))

    (case [(* ast/AssignStmt)]
      (.walkExprs r (.-Rhs n))

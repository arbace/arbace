              (inc! n)))))) ; new declaration




    (when (and (== n 0) (!= (.-declErr r) nil))
      ((.-declErr r) (.Pos (aget (.-Lhs decl) 0)) "no new variables on left side of :="))))






(go/var ^{:doc "The unresolved object is a sentinel to mark identifiers that have been added\nto the list of unresolved identifiers. The sentinel is only used for verifying\ninternal consistency.\n"} unresolved (new ast/Object))





^{:go/end 227} (go/method resolve "If x is an identifier, resolve attempts to resolve x by looking up\nthe object it denotes. If no object is found and collectUnresolved is\nset, x is marked as unresolved and collected in the list of unresolved\nidentifiers.\n" [^{:tag (* resolver)} r ^{:tag (* ast/Ident)} ident ^bool collectUnresolved]
  (when (!= (.-Obj ident) nil)
    (panic (.sprintf r "%v: identifier %s already declared or resolved" (.Pos ident) (.-Name ident))))

  ;; '_' should never refer to existing declarations, because it has special
  ;; handling in the spec.
  (when (== (.-Name ident) "_")
    (return))

  (for [s (.-topScope r)] (!= s nil) (set! s (.-Outer s))
    (when [obj (.Lookup s (.-Name ident))] (!= obj nil)
      (when debugResolve
        (.trace r "resolved %v:%s to %v" (.Pos ident) (.-Name ident) obj))

      (go/call assert (!= (.-Name obj) "") "obj with no name")
      ;; Identifiers (for receiver type parameters) are written to the scope,
      ;; but never set as the resolved object. See go.dev/issue/50956.
      (when [(values _ ok) (assert (* ast/Ident) (.-Decl obj))] (not ok)
        (set! (.-Obj ident) obj))

      (return)))


  ;; all local scopes are known, so any unresolved identifier
  ;; must be found either in the file scope, package scope
  ;; (perhaps in another file), or universe scope --- collect
  ;; them so that they can be resolved later
  (when collectUnresolved
    (set! (.-Obj ident) unresolved)
    (set! (.-unresolved r) (append (.-unresolved r) ident))))



^{:go/end 233} (go/method walkExprs [^{:tag (* resolver)} r ^{:tag (slice ast/Expr)} list]
  (range [_ node list]

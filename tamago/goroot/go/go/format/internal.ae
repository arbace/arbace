;; TODO(gri): This file and the file src/cmd/gofmt/internal.go are
;; the same (but for this comment and the package name). Do not modify
;; one without the other. Determine if we can factor out functionality
;; in a public API. See also #11844 for context.

(in-ns 'go.go.format) (go/file "internal.go" :imports [


    ^{:line 13} [bytes "bytes"]
    ^{:line 14} [ast "go/ast"]
    ^{:line 15} [parser "go/parser"]
    ^{:line 16} [printer "go/printer"]
    ^{:line 17} [token "go/token"]
    ^{:line 18} [strings "strings"]])




^{:go/end 89} (go/func parse "parse parses src, which was read from the named file,\nas a Go source file, declaration, or statement list.\n" [^{:tag (* token/FileSet)} fset ^string filename ^{:tag (slice byte)} src ^bool fragmentOk] :results [
    ^{:line 24 :tag (* ast/File)} file
    ^{:line 25 :tag (func [^{:tag (slice byte)} src ^int indent] [(slice byte)])} sourceAdj
    ^{:line 26 :tag int} indentAdj
    ^{:line 27 :tag error} err]

  ;; Try as whole source file.
  (set! (values file err) (parser/ParseFile fset filename src parserMode))
  ;; If there's no error, return. If the error is that the source file didn't begin with a
  ;; package line and source fragments are ok, fall through to
  ;; try as a source fragment. Stop and return on any other error.
  (when (or (== err nil) (not fragmentOk) (not (strings/Contains (.Error err) "expected 'package'")))
    (return))


  ;; If this is a declaration list, make it a source file
  ;; by inserting a package clause.
  ;; Insert using a ';', not a newline, so that the line numbers
  ;; in psrc match the ones in src.
  (let [psrc (append (conv (slice byte) "package p;") (spread src))]
    (set! (values file err) (parser/ParseFile fset filename psrc parserMode))
    (when (== err nil)
      (set! sourceAdj ^{:go/end 50} (fn ^{:tag (slice byte)} [^{:tag (slice byte)} src ^int indent]
          ;; Remove the package clause.
          ;; Gofmt has turned the ';' into a '\n'.
          (set! src (subslice src (+ indent (len "package p\n"))))
          (bytes/TrimSpace src)))

      (return))

    ;; If the error is that the source file didn't begin with a
    ;; declaration, fall through to try as a statement list.
    ;; Stop and return on any other error.
    (when (not (strings/Contains (.Error err) "expected declaration"))
      (return))


    ;; If this is a statement list, make it a source file
    ;; by inserting a package clause and turning the list
    ;; into a function body. This handles expressions too.
    ;; Insert using a ';', not a newline, so that the line numbers
    ;; in fsrc match the ones in src. Add an extra '\n' before the '}'
    ;; to make sure comments are flushed before the '}'.
    (let [fsrc (append (append (conv (slice byte) "package p; func _() {") (spread src)) \newline \newline \})]
      (set! (values file err) (parser/ParseFile fset filename fsrc parserMode))
      (when (== err nil)
        (set! sourceAdj ^{:go/end 81} (fn ^{:tag (slice byte)} [^{:tag (slice byte)} src ^int indent]
            ;; Cap adjusted indent to zero.
            (when (< indent 0)
              (set! indent 0))

            ;; Remove the wrapping.
            ;; Gofmt has turned the "; " into a "\n\n".
            ;; There will be two non-blank lines with indent, hence 2*indent.
            (set! src (subslice src (+ (* 2 indent) (len "package p\n\nfunc _() {"))))
            ;; Remove only the "}\n" suffix: remaining whitespaces will be trimmed anyway
            (set! src (subslice src _ (- (len src) (len "}\n"))))
            (bytes/TrimSpace src)))

        ;; Gofmt has also indented the function body one level.
        ;; Adjust that with indentAdj.
        (set! indentAdj -1))


      ;; Succeeded, or out of options.
      (return))))





^{:go/end 170} (go/func format "format formats the given package file originally obtained from src\nand adjusts the result based on the original source via sourceAdj\nand indentAdj.\n" [
    ^{:line 95 :tag (* token/FileSet)} fset
    ^{:line 96 :tag (* ast/File)} file
    ^{:line 97 :tag (func [^{:tag (slice byte)} src ^int indent] [(slice byte)])} sourceAdj
    ^{:line 98 :tag int} indentAdj
    ^{:line 99 :tag (slice byte)} src
    ^{:line 100 :tag printer/Config} cfg] :results [
    (slice byte) error]
  (when (== sourceAdj nil)
    ;; Complete source file.
    (let [^bytes/Buffer buf (zero bytes/Buffer)
        ^{:line 105} err (.Fprint cfg (addr buf) fset file)]
      (when (!= err nil)
        (return nil err))

      (return (.Bytes buf) nil)))


  ;; Partial source file.
  ;; Determine and prepend leading space.
  (let [(values i j) (values 0 0)]
    (while (and (< j (len src)) (isSpace (aget src j)))
      (when (== (aget src j) \newline)
        (set! i (+ j 1))) ; byte offset of last line in leading space

      (inc! j))

    (let [^{:tag (slice byte)} res (zero (slice byte))]
      (set! res (append res (spread (subslice src _ i))))

      ;; Determine and prepend indentation of first code line.
      ;; Spaces are ignored unless there are no tabs,
      ;; in which case spaces count as one tab.
      (let [indent 0
          ^{:line 128} hasSpace false]
        (range [_ b (subslice src i j)]
          (switch b
            (case [\space]
              (set! hasSpace true))
            (case [\tab]
              (inc! indent))))


        (when (and (== indent 0) hasSpace)
          (set! indent 1))

        (for [i 0] (< i indent) (inc! i)
          (set! res (append res \tab)))


        ;; Format the source.
        ;; Write it without any leading and trailing space.
        (set! (.-Indent cfg) (+ indent indentAdj))
        (let [^bytes/Buffer buf (zero bytes/Buffer)
            ^{:line 148} err (.Fprint cfg (addr buf) fset file)]
          (when (!= err nil)
            (return nil err))

          (let [out (sourceAdj (.Bytes buf) (.-Indent cfg))]

            ;; If the adjusted output is empty, the source
            ;; was empty but (possibly) for white space.
            ;; The result is the incoming source.
            (when (== (len out) 0)
              (return src nil))


            ;; Otherwise, append output to leading space.
            (set! res (append res (spread out)))

            ;; Determine and append trailing space.
            (set! i (len src))
            (while (and (> i 0) (isSpace (aget src (- i 1))))
              (dec! i))

            (return (append res (spread (subslice src i))) nil)))))))




^{:go/end 176} (go/func isSpace "isSpace reports whether the byte is a space character.\nisSpace defines a space as being among the following bytes: ' ', '\\t', '\\n' and '\\r'.\n" ^bool [^byte b]
  (or (== b \space) (== b \tab) (== b \newline) (== b \return)))

;; This file implements go/types-specific scope methods.
;; These methods do not exist in types2.

(in-ns 'go.go.types) (go/file "scope2.go" :imports [

    ^{:line 10} [token "go/token"]])













^{:go/end 31} (go/method LookupParent "LookupParent follows the parent chain of scopes starting with s until\nit finds a scope where Lookup(name) returns a non-nil object, and then\nreturns that scope and object. If a valid position pos is provided,\nonly objects that were declared at or before pos are considered.\nIf no such scope and object exists, the result is (nil, nil).\nThe results are guaranteed to be valid only if the type-checked\nAST has complete position information.\n\nNote that obj.Parent() may be different from the returned scope if the\nobject was inserted into the scope and already had a parent at that\ntime (see Insert). This can only happen for dot-imported objects\nwhose parent is the scope of the package that exported them.\n" [^{:tag (* Scope)} s ^string name ^token/Pos pos] :results [(* Scope) Object]
  (for [] (!= s nil) (set! s (.-parent s))
    (when [obj (.Lookup s name)] (and (!= obj nil) ^:go/paren (or (not (.IsValid pos)) (<= (cmpPos (.scopePos obj) pos) 0)))
      (return s obj)))


  (return nil nil))






^{:go/end 37} (go/method Pos "Pos and End describe the scope's source code extent [pos, end).\nThe results are guaranteed to be valid only if the type-checked\nAST has complete position information. The extent is undefined\nfor Universe and package scopes.\n" ^token/Pos [^{:tag (* Scope)} s] (.-pos s))
^{:go/end 38} (go/method End ^token/Pos [^{:tag (* Scope)} s] (.-end s))




^{:go/end 45} (go/method Contains "Contains reports whether pos is within the scope's extent.\nThe result is guaranteed to be valid only if the type-checked\nAST has complete position information.\n" ^bool [^{:tag (* Scope)} s ^token/Pos pos]
  (and (<= (cmpPos (.-pos s) pos) 0) (< (cmpPos pos (.-end s)) 0)))







^{:go/breaks [[6 71]] :go/end 72} (go/method Innermost "Innermost returns the innermost (child) scope containing\npos. If pos is not within any scope, the result is nil.\nThe result is also nil for the Universe scope.\nThe result is guaranteed to be valid only if the type-checked\nAST has complete position information.\n" ^{:tag (* Scope)} [^{:tag (* Scope)} s ^token/Pos pos]
  ;; Package scopes do not have extents since they may be
  ;; discontiguous, so iterate over the package's files.
  (when (== (.-parent s) Universe)
    (range [_ s (.-children s)]
      (when [inner (.Innermost s pos)] (!= inner nil)
        (return inner))))




  (when (.Contains s pos)
    (range [_ s (.-children s)]
      (when (.Contains s pos)
        (return (.Innermost s pos))))


    (return s))

  nil)

;; This file implements printing of expressions.

(in-ns 'go.go.types) (go/file "exprstring.go" :imports [


    ^{:line 10} [bytes "bytes"]
    ^{:line 11} [fmt "fmt"]
    ^{:line 12} [ast "go/ast"]])





^{:go/end 22} (go/func ExprString "ExprString returns the (possibly shortened) string representation for x.\nShortened representations are suitable for user interfaces but may not\nnecessarily follow Go syntax.\n" ^string [^ast/Expr x]
  (let [^bytes/Buffer buf (zero bytes/Buffer)]
    (WriteExpr (addr buf) x)
    (.String buf)))





^{:go/end 168} (go/func WriteExpr "WriteExpr writes the (possibly shortened) string representation for x to buf.\nShortened representations are suitable for user interfaces but may not\nnecessarily follow Go syntax.\n" [^{:tag (* bytes/Buffer)} buf ^ast/Expr x]
  ;; The AST preserves source-level parentheses so there is
  ;; no need to introduce them here to correct for different
  ;; operator precedences. (This assumes that the AST was
  ;; generated by a Go parser.)

  (type-switch [x x]
    (default
      (fmt/Fprintf buf "(ast: %T)" x)) ; nil, ast.BadExpr, ast.KeyValueExpr

    (case [(* ast/Ident)]
      (.WriteString buf (.-Name x)))

    (case [(* ast/Ellipsis)]
      (.WriteString buf "...")
      (when (!= (.-Elt x) nil)
        (WriteExpr buf (.-Elt x))))


    (case [(* ast/BasicLit)]
      (.WriteString buf (.-Value x)))

    (case [(* ast/FuncLit)]
      (.WriteByte buf \()
      (WriteExpr buf (.-Type x))
      (.WriteString buf " literal)")) ; shortened

    (case [(* ast/CompositeLit)]
      (WriteExpr buf (.-Type x))
      (.WriteByte buf \{)
      (when (> (len (.-Elts x)) 0)
        (.WriteString buf "…"))

      (.WriteByte buf \}))

    (case [(* ast/ParenExpr)]
      (.WriteByte buf \()
      (WriteExpr buf (.-X x))
      (.WriteByte buf \)))

    (case [(* ast/SelectorExpr)]
      (WriteExpr buf (.-X x))
      (.WriteByte buf \.)
      (.WriteString buf (.-Name (.-Sel x))))

    (case [(* ast/IndexExpr) (* ast/IndexListExpr)]
      (let [ix (unpackIndexedExpr x)]
        (WriteExpr buf (.-x ix))
        (.WriteByte buf \[)
        (writeExprList buf (.-indices ix))
        (.WriteByte buf \])))

    (case [(* ast/SliceExpr)]
      (WriteExpr buf (.-X x))
      (.WriteByte buf \[)
      (when (!= (.-Low x) nil)
        (WriteExpr buf (.-Low x)))

      (.WriteByte buf \:)
      (when (!= (.-High x) nil)
        (WriteExpr buf (.-High x)))

      (when (.-Slice3 x)
        (.WriteByte buf \:)
        (when (!= (.-Max x) nil)
          (WriteExpr buf (.-Max x))))


      (.WriteByte buf \]))

    (case [(* ast/TypeAssertExpr)]
      (WriteExpr buf (.-X x))
      (.WriteString buf ".(")
      (WriteExpr buf (.-Type x))
      (.WriteByte buf \)))

    (case [(* ast/CallExpr)]
      (WriteExpr buf (.-Fun x))
      (.WriteByte buf \()
      (writeExprList buf (.-Args x))
      (when (hasDots x)
        (.WriteString buf "..."))

      (.WriteByte buf \)))

    (case [(* ast/StarExpr)]
      (.WriteByte buf \*)
      (WriteExpr buf (.-X x)))

    (case [(* ast/UnaryExpr)]
      (.WriteString buf (.String (.-Op x)))
      (WriteExpr buf (.-X x)))

    (case [(* ast/BinaryExpr)]
      (WriteExpr buf (.-X x))
      (.WriteByte buf \space)
      (.WriteString buf (.String (.-Op x)))
      (.WriteByte buf \space)
      (WriteExpr buf (.-Y x)))

    (case [(* ast/ArrayType)]
      (.WriteByte buf \[)
      (when (!= (.-Len x) nil)
        (WriteExpr buf (.-Len x)))

      (.WriteByte buf \])
      (WriteExpr buf (.-Elt x)))

    (case [(* ast/StructType)]
      (.WriteString buf "struct{")
      (writeFieldList buf (.-List (.-Fields x)) "; " false)
      (.WriteByte buf \}))

    (case [(* ast/FuncType)]
      (.WriteString buf "func")
      (writeSigExpr buf x))

    (case [(* ast/InterfaceType)]
      (.WriteString buf "interface{")
      (writeFieldList buf (.-List (.-Methods x)) "; " true)
      (.WriteByte buf \}))

    (case [(* ast/MapType)]
      (.WriteString buf "map[")
      (WriteExpr buf (.-Key x))
      (.WriteByte buf \])
      (WriteExpr buf (.-Value x)))

    (case [(* ast/ChanType)]
      (let [^string s (zero string)]
        (switch (.-Dir x)
          (case [ast/SEND]
            (set! s "chan<- "))
          (case [ast/RECV]
            (set! s "<-chan "))
          (default
            (set! s "chan ")))

        (.WriteString buf s)
        (WriteExpr buf (.-Value x))))))



^{:go/end 193} (go/func writeSigExpr [^{:tag (* bytes/Buffer)} buf ^{:tag (* ast/FuncType)} sig]
  (.WriteByte buf \()
  (writeFieldList buf (.-List (.-Params sig)) ", " false)
  (.WriteByte buf \))

  (let [res (.-Results sig)
      ^{:line 176} n (.NumFields res)]
    (when (== n 0)
      ;; no result
      (return))


    (.WriteByte buf \space)
    (when (and (== n 1) (== (len (.-Names (aget (.-List res) 0))) 0))
      ;; single unnamed result
      (WriteExpr buf (.-Type (aget (.-List res) 0)))
      (return))


    ;; multiple or named result(s)
    (.WriteByte buf \()
    (writeFieldList buf (.-List res) ", " false)
    (.WriteByte buf \))))


^{:go/end 219} (go/func writeFieldList [^{:tag (* bytes/Buffer)} buf ^{:tag (slice (* ast/Field))} list ^string sep ^bool iface]
  (range [i f list]
    (when (> i 0)
      (.WriteString buf sep))


    ;; field list names
    (writeIdentList buf (.-Names f))

    ;; types of interface methods consist of signatures only
    (when [(values sig _) (assert (* ast/FuncType) (.-Type f))] (and (!= sig nil) iface)
      (writeSigExpr buf sig)
      (continue))


    ;; named fields are separated with a blank from the field type
    (when (> (len (.-Names f)) 0)
      (.WriteByte buf \space))


    (WriteExpr buf (.-Type f))))

;; ignore tag



^{:go/end 228} (go/func writeIdentList [^{:tag (* bytes/Buffer)} buf ^{:tag (slice (* ast/Ident))} list]
  (range [i x list]
    (when (> i 0)
      (.WriteString buf ", "))

    (.WriteString buf (.-Name x))))



^{:go/end 237} (go/func writeExprList [^{:tag (* bytes/Buffer)} buf ^{:tag (slice ast/Expr)} list]
  (range [i x list]
    (when (> i 0)
      (.WriteString buf ", "))

    (WriteExpr buf x)))

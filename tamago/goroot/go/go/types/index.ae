^{:go/end 414} (go/method singleIndex "singleIndex returns the (single) index from the index expression e.\nIf the index is missing, or if there are multiple indices, an error\nis reported and the result is nil.\n" ^ast/Expr [^{:tag (* Checker)} check ^{:tag (* indexedExpr)} expr]

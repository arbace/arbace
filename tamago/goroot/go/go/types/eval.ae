(in-ns 'go.go.types) (go/file "eval.go" :imports [


    ^{:line 8} [fmt "fmt"]
    ^{:line 9} [ast "go/ast"]
    ^{:line 10} [parser "go/parser"]
    ^{:line 11} [token "go/token"]])












^{:go/end 36} (go/func Eval "Eval returns the type and, if constant, the value for the\nexpression expr, evaluated at position pos of package pkg,\nwhich must have been derived from type-checking an AST with\ncomplete position information relative to the provided file\nset.\n\nThe meaning of the parameters fset, pkg, and pos is the\nsame as in [CheckExpr]. An error is returned if expr cannot\nbe parsed successfully, or the resulting expr AST cannot be\ntype-checked.\n" [^{:tag (* token/FileSet)} fset ^{:tag (* Package)} pkg ^token/Pos pos ^string expr] :results [^TypeAndValue _ ^error err]
  ;; parse expressions
  (let [(values node ^:assign err) (parser/ParseExprFrom fset "eval" expr 0)]
    (when (!= err nil)
      (return (lit TypeAndValue) err))


    (let [info (addr ^{:go/breaks [2]} (lit Info
            :Types (make (map ast/Expr TypeAndValue))))]

      (set! err (CheckExpr fset pkg pos node info))
      (return (aget (.-Types info) node) err))))




















^{:go/end 99} (go/func CheckExpr "CheckExpr type checks the expression expr as if it had appeared at position\npos of package pkg. [Type] information about the expression is recorded in\ninfo. The expression may be an identifier denoting an uninstantiated generic\nfunction or type.\n\nIf pkg == nil, the [Universe] scope is used and the provided\nposition pos is ignored. If pkg != nil, and pos is invalid,\nthe package scope is used. Otherwise, pos must belong to the\npackage.\n\nAn error is returned if pos is not within the package or\nif the node cannot be type-checked.\n\nNote: [Eval] and CheckExpr should not be used instead of running Check\nto compute types and values, but in addition to Check, as these\nfunctions ignore the context in which an expression is used (e.g., an\nassignment). Thus, top-level untyped constants will return an\nuntyped type rather than the respective context-specific type.\n" [^{:tag (* token/FileSet)} fset ^{:tag (* Package)} pkg ^token/Pos pos ^ast/Expr expr ^{:tag (* Info)} info] :results [^error err]
  ;; determine scope
  (let [^{:tag (* Scope)} scope (zero (* Scope))]
    (cond (== pkg nil) (do
        (set! scope Universe)
        (set! pos nopos))
      (not (.IsValid pos))
      (set! scope (.-scope pkg)) :else
      (do
        ;; The package scope extent (position information) may be
        ;; incorrect (files spread across a wide range of fset
        ;; positions) - ignore it and just consider its children
        ;; (file scopes).
        (range [_ fscope (.-children (.-scope pkg))]
          (when [(set! scope (.Innermost fscope pos))] (!= scope nil)
            (break)))


        (when (or (== scope nil) debug)
          (let [s scope]
            (while (and (!= s nil) (!= s (.-scope pkg)))
              (set! s (.-parent s)))

            ;; s == nil || s == pkg.scope
            (when (== s nil)
              (return (fmt/Errorf "no position %s found in package %s" (.Position fset pos) (.-name pkg))))))))




    ;; initialize checker
    (let [check (NewChecker nil fset pkg info)]
      (set! ^{:go/via [environment]} (.-scope check) scope)
      (set! ^{:go/via [environment]} (.-exprPos check) pos)
      (defer (.handleBailout check (addr err)))

      ;; evaluate node
      ^{:go/breaks [[5 98]]} (let [^operand x (zero operand)]
        (.rawExpr check nil (addr x) expr nil true) ; allow generic expressions
        (.processDelayed check 0) ; incl. all functions
        (.recordUntyped check)

        nil))))

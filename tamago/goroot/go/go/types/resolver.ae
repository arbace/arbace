^{:go/end 715} (go/method unusedImports "unusedImports checks for unused imports.\n" [^{:tag (* Checker)} check]
  ;; If function bodies are not checked, packages' uses are likely missing - don't check.
  (when (.-IgnoreFuncBodies (.-conf check))
    (return))



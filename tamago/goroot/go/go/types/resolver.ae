^{:go/end 734} (go/method errorUnusedPkg [^{:tag (* Checker)} check ^{:tag (* PkgName)} obj]
  ;; If the package was imported with a name other than the final
  ;; import path element, show it explicitly in the error message.
  ;; Note that this handles both renamed imports and imports of
  ;; packages containing unconventional package declarations.
  ;; Note that this uses / always, even on Windows, because Go import
  ;; paths always use forward slashes.
  (let [path (.-path (.-imported obj))
      ^{:line 725} elem path]
    (when [i (strings/LastIndex elem "/")] (>= i 0)
      (set! elem (subslice elem (+ i 1))))

    (if (or (== ^{:go/via [object]} (.-name obj) "") (== ^{:go/via [object]} (.-name obj) ".") (== ^{:go/via [object]} (.-name obj) elem))
      (.softErrorf check obj UnusedImport "%q imported and not used" path)

      (.softErrorf check obj UnusedImport "%q imported as %s and not used" path ^{:go/via [object]} (.-name obj)))))







^{:go/breaks [[5 745]] :go/end 746} (go/func dir "dir makes a good-faith attempt to return the directory\nportion of path. If path is empty, the result is \".\".\n(Per the go/build package dependency tests, we cannot import\npath/filepath and simply use filepath.Dir.)\n" ^string [^string path]
  (when [i (strings/LastIndexAny path "/\\")] (> i 0)
    (return (subslice path _ i)))

  ;; i <= 0
  ".")

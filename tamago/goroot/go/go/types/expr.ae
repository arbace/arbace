    ;; update the recorded type.
    (when (and (not final) (isUntyped typ))
      (set! (.-typ old) (assert (* Basic) (.Underlying typ)))
      (aset (.-untyped check) x old)
      (return))


    ;; Otherwise we have the final (typed or untyped type).
    ;; Remove it from the map of yet untyped expressions.
    (delete (.-untyped check) x)

    (when (.-isLhs old)
      ;; If x is the lhs of a shift, its final type must be integer.
      ;; We already know from the shift check that it is representable
      ;; as an integer if it is a constant.
      (when (not (allInteger typ))
        (.errorf check x InvalidShiftOperand (+ invalidOp "shifted operand %s (type %s) must be integer") x typ)

^{:go/end 677} (go/func writeFuncName [^{:tag (* bytes/Buffer)} buf ^{:tag (* Func)} f ^Qualifier qf]
  (when (!= ^{:go/via [object]} (.-typ f) nil)
    (let [sig (assert (* Signature) ^{:go/via [object]} (.-typ f))]
      (if [recv (.Recv sig)] (!= recv nil) (do
          (.WriteByte buf \()
          (if [(values _ ok) (assert (* Interface) ^{:go/via [object]} (.Type recv))] ok
            ;; gcimporter creates abstract methods of
            ;; named interfaces using the interface type
            ;; (not the named type) as the receiver.
            ;; Don't print it in full.
            (.WriteString buf "interface")

            (WriteType buf ^{:go/via [object]} (.Type recv) qf))

          (.WriteByte buf \))
          (.WriteByte buf \.))
        (when (!= ^{:go/via [object]} (.-pkg f) nil)
          (.WriteString buf (packagePrefix ^{:go/via [object]} (.-pkg f) qf))))))


  (.WriteString buf ^{:go/via [object]} (.-name f)))



^{:go/breaks [[6 725]] :go/end 726} (go/func objectKind "objectKind returns a description of the object's kind.\n" ^string [^Object obj]
  (type-switch [obj obj]
    (case [(* PkgName)]
      (return "package name"))
    (case [(* Const)]
      (return "constant"))
    (case [(* TypeName)]
      (if (.IsAlias obj)
        (return "type alias")
        (if [(values _ ok) (assert (* TypeParam) ^{:go/via [object]} (.Type obj))] ok
          (return "type parameter")

          (return "defined type"))))

    (case [(* Var)]
      (switch (.Kind obj)
        (case [PackageVar]
          (return "package-level variable"))
        (case [LocalVar]
          (return "local variable"))
        (case [RecvVar]
          (return "receiver"))
        (case [ParamVar]
          (return "parameter"))
        (case [ResultVar]
          (return "result variable"))
        (case [FieldVar]
          (return "struct field"))))

    (case [(* Func)]
      (if (!= (.Recv (.Signature obj)) nil)
        (return "method")

        (return "function")))

    (case [(* Label)]
      (return "label"))
    (case [(* Builtin)]
      (return "built-in function"))
    (case [(* Nil)]
      (return "untyped nil")))

  (when debug
    (panic (fmt/Sprintf "unknown symbol (%T)" obj)))

  "unknown symbol")

      ^{:line 657 :tag (* term)} single (zero (* term)) ; valid if n == 1
      ^{:line 658 :tag bool} tilde (zero bool)]
    (.is tpar ^{:go/breaks [[6 669]] :go/end 670} (fn ^bool [^{:tag (* term)} t]
        (when (== t nil)
          (go/call assert (== n 0))
          (return false)) ; no terms

        (inc! n)
        (set! single t)
        (when (.-tilde t)
          (set! tilde true))

        true))

    (when (== n 1)
      (when debug
        (let [(values u _) (commonUnder tpar nil)]
          (go/call assert (== (.Underlying (.-typ single)) u))))

      (return single true))

    (when [(values typ _) (commonUnder tpar nil)] (!= typ nil)
      ;; A core type is always an underlying type.
      ;; If any term of tpar has a tilde, we don't
      ;; have a precise core type and we must return
      ;; a tilde as well.
      (return (addr (lit term tilde typ)) false))

    (return nil false)))









^{:go/end 700} (go/func killCycles "killCycles walks through the given type parameters and looks for cycles\ncreated by type parameters whose inferred types refer back to that type\nparameter, either directly or indirectly. If such a cycle is detected,\nit is killed by setting the corresponding inferred type to nil.\n\nTODO(gri) Determine if we can simply abort inference as soon as we have\nfound a single cycle.\n" [^{:tag (slice (* TypeParam))} tparams ^{:tag (slice Type)} inferred]
  (let [w (lit cycleFinder tparams inferred (make (map Type bool)))]
    (range [_ t tparams]
      (.typ w t)))) ; t != nil



(go/type cycleFinder (struct
    ^{:line 703 :tag (slice (* TypeParam))} tparams
    ^{:line 704 :tag (slice Type)} inferred
    ^{:line 705 :tag (map Type bool)} seen))


^{:go/end 791} (go/method typ [^{:tag (* cycleFinder)} w ^Type typ]
  (set! typ (Unalias typ))
  (when (aget (.-seen w) typ)
    ;; We have seen typ before. If it is one of the type parameters
    ;; in w.tparams, iterative substitution will lead to infinite expansion.
    ;; Nil out the corresponding type which effectively kills the cycle.
    (when [(values tpar _) (assert (* TypeParam) typ)] (!= tpar nil)
      (when [i (^{:inst [(slice (* TypeParam)) (* TypeParam)]} slices/Index (.-tparams w) tpar)] (>= i 0)
        ;; cycle through tpar
        (aset (.-inferred w) i nil)))


    ;; If we don't have one of our type parameters, the cycle is due
    ;; to an ordinary recursive type and we can just stop walking it.
    (return))

  (aset (.-seen w) typ true)
  (defer (delete (.-seen w) typ))

  (type-switch [t typ]
    (case [(* Basic)])
    ;; nothing to do

    ;; *Alias:
    ;;      This case should not occur because of Unalias(typ) at the top.

    (case [(* Array)]
      (.typ w (.-elem t)))

    (case [(* Slice)]
      (.typ w (.-elem t)))

    (case [(* Struct)]
      (.varList w (.-fields t)))

    (case [(* Pointer)]
      (.typ w (.-base t)))

    ;; case *Tuple:
    ;;      This case should not occur because tuples only appear
    ;;      in signatures where they are handled explicitly.

    (case [(* Signature)]
      (when (!= (.-params t) nil)
        (.varList w (.-vars (.-params t))))

      (when (!= (.-results t) nil)
        (.varList w (.-vars (.-results t)))))


    (case [(* Union)]
      (range [_ t (.-terms t)]
        (.typ w (.-typ t))))


    (case [(* Interface)]
      (range [_ m (.-methods t)]
        (.typ w ^{:go/via [object]} (.-typ m)))

      (range [_ t (.-embeddeds t)]
        (.typ w t)))


    (case [(* Map)]
      (.typ w (.-key t))
      (.typ w (.-elem t)))

    (case [(* Chan)]
      (.typ w (.-elem t)))

    (case [(* Named)]
      (range [_ tpar (.list (.TypeArgs t))]
        (.typ w tpar)))


    (case [(* TypeParam)]
      (when [i (^{:inst [(slice (* TypeParam)) (* TypeParam)]} slices/Index (.-tparams w) t)] (and (>= i 0) (!= (aget (.-inferred w) i) nil))
        (.typ w (aget (.-inferred w) i))))


    (default
      (panic (fmt/Sprintf "unexpected %T" typ)))))




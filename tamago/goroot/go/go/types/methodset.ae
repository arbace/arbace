(go/type MethodSet "A MethodSet is an ordered set of concrete or abstract (interface) methods;\na method is a [MethodVal] selection, and they are ordered by ascending m.Obj().Id().\nThe zero value for a MethodSet is a ready-to-use empty method set.\n" (struct
    ^{:line 19 :tag (slice (* Selection))} list))


^{:go/end 34} (go/method String ^string [^{:tag (* MethodSet)} s]
  (when (== (.Len s) 0)
    (return "MethodSet {}"))


  (let [^strings/Builder buf (zero strings/Builder)]
    (fmt/Fprintln (addr buf) "MethodSet {")
    (range [_ f (.-list s)]
      (fmt/Fprintf (addr buf) "\t%s\n" f))

    (fmt/Fprintln (addr buf) "}")
    (.String buf)))



^{:go/end 37} (go/method Len "Len returns the number of methods in s.\n" ^int [^{:tag (* MethodSet)} s] (len (.-list s)))


^{:go/end 40} (go/method At "At returns the i'th method in s for 0 <= i < s.Len().\n" ^{:tag (* Selection)} [^{:tag (* MethodSet)} s ^int i] (aget (.-list s) i))



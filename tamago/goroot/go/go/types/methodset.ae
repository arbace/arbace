  (when (== (.Len s) 0)
    (return nil))


  ^{:go/breaks [[3 59]]} (let [key (Id pkg name)
      ^{:line 49} i (sort/Search (len (.-list s)) ^{:go/end 52} (fn ^bool [^int i]
          (let [m (aget (.-list s) i)]
            (>= (.Id (.-obj m)) key))))]

    (when (< i (len (.-list s)))
      (let [m (aget (.-list s) i)]
        (when (== (.Id (.-obj m)) key)

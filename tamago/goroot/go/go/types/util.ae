;; This file contains various functionality that is
;; different between go/types and types2. Factoring
;; out this code allows more of the rest of the code
;; to be shared.

(in-ns 'go.go.types) (go/file "util.go" :imports [


    ^{:line 13} [ast "go/ast"]
    ^{:line 14} [constant "go/constant"]
    ^{:line 15} [token "go/token"]])


(go/const ^{:val false} isTypes2 false)









^{:go/end 28} (go/func cmpPos "cmpPos compares the positions p and q and returns a result r as follows:\n\nr <  0: p is before q\nr == 0: p and q are the same position (but may not be identical)\nr >  0: p is after q\n\nIf p and q are in different files, p is before q if the filename\nof p sorts lexicographically before the filename of q.\n" ^int [^token/Pos p ^token/Pos q] (conv int (- p q)))


^{:go/end 31} (go/func hasDots "hasDots reports whether the last argument in the call is followed by ...\n" ^bool [^{:tag (* ast/CallExpr)} call] (.IsValid (.-Ellipsis call)))


^{:go/end 34} (go/func dddErrPos "dddErrPos returns the positioner for reporting an invalid ... use in a call.\n" ^positioner [^{:tag (* ast/CallExpr)} call] (conv atPos (.-Ellipsis call)))


^{:go/breaks [[5 43]] :go/end 44} (go/func isdddArray "isdddArray reports whether atyp is of the form [...]E.\n" ^bool [^{:tag (* ast/ArrayType)} atyp]
  (when (!= (.-Len atyp) nil)
    (when [(values ddd _) (assert (* ast/Ellipsis) (.-Len atyp))] (and (!= ddd nil) (== (.-Elt ddd) nil))
      (return true)))


  false)



^{:go/end 47} (go/func argErrPos "argErrPos returns positioner for reporting an invalid argument count.\n" ^positioner [^{:tag (* ast/CallExpr)} call] (inNode call (.-Rparen call)))


^{:go/end 50} (go/func startPos "startPos returns the start position of node n.\n" ^token/Pos [^ast/Node n] (.Pos n))


^{:go/end 53} (go/func endPos "endPos returns the position of the first character immediately after node n.\n" ^token/Pos [^ast/Node n] (.End n))


^{:go/end 58} (go/func makeFromLiteral "makeFromLiteral returns the constant value for the given literal string and kind.\n" ^constant/Value [^string lit ^token/Token kind]
  (constant/MakeFromLiteral lit kind 0))

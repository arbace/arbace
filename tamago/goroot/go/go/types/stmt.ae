              (when (or (!= (len (.-Lhs guard)) 1) (!= (.-Tok guard) token/DEFINE) (!= (len (.-Rhs guard)) 1))
                (.error check s InvalidSyntaxTree "incorrect form of type switch guard")
                (return))


              (set! (values lhs _) (assert (* ast/Ident) (aget (.-Lhs guard) 0)))
              (when (== lhs nil)
                (.error check s InvalidSyntaxTree "incorrect form of type switch guard")
                (return))


              (if (== (.-Name lhs) "_") (do
                  ;; _ := x.(type) is an invalid short variable declaration
                  (.softErrorf check lhs NoNewVar "no new variable on left side of :=")
                  (set! lhs nil)) ; avoid declared and not used error below

                (.recordDef check lhs nil)) ; lhs variable is implicitly declared in each cause clause


              (set! rhs (aget (.-Rhs guard) 0)))

            (default
              (.error check s InvalidSyntaxTree "incorrect form of type switch guard")
              (return)))


          ;; rhs must be of the form: expr.(type) and expr must be an ordinary interface
          (let [(values expr _) (assert (* ast/TypeAssertExpr) rhs)]
            (when (or (== expr nil) (!= (.-Type expr) nil))
              (.error check s InvalidSyntaxTree "incorrect form of type switch guard")
              (return))


            (let [^{:tag (* operand)} sx (zero (* operand))] ; switch expression against which cases are compared against; nil if invalid
              (do
                (let [^operand x (zero operand)]
                  (.expr check nil (addr x) (.-X expr))
                  (when (.isValid x)
                    (cond (isTypeParam (.typ x))
                      (.errorf check (addr x) InvalidTypeSwitch "cannot use type switch on type parameter value %s" (addr x))
                      (IsInterface (.typ x))
                      (set! sx (addr x)) :else

                      (.errorf check (addr x) InvalidTypeSwitch "%s is not an interface" (addr x))))))




              (.multipleDefaults check (.-List (.-Body s)))

              (let [^{:tag (slice (* Var))} lhsVars (zero (slice (* Var))) ; list of implicitly declared lhs variables
                  ^{:line 745} seen (make (map Type ast/Expr))] ; map of seen types to positions
                (range [_ s (.-List (.-Body s))]
                  (let [(values clause _) (assert (* ast/CaseClause) s)]
                    (when (== clause nil)
                      (.error check s InvalidSyntaxTree "incorrect type switch case")
                      (continue))

                    ;; Check each type in this type switch case.
                    (let [T (.caseTypes check sx (.-List clause) seen)]
                      (.openScope check clause "case")
                      ;; If lhs exists, declare a corresponding variable in the case-local scope.
                      (when (!= lhs nil)
                        (let [obj (newVar LocalVar (.Pos lhs) (.-pkg check) (.-Name lhs) T)]
                          (.declare check ^{:go/via [environment]} (.-scope check) nil obj (.-Colon clause))
                          (.recordImplicit check clause obj)
                          ;; For the "declared and not used" error, all lhs variables act as
                          ;; one; i.e., if any one of them is 'used', all of them are 'used'.
                          ;; Collect them for later analysis.
                          (set! lhsVars (append lhsVars obj))))

                      (.stmtList check inner (.-Body clause))
                      (.closeScope check))))


                ;; If lhs exists, we must have at least one lhs variable that was used.
                ;; (We can't use check.usage because that only looks at one scope; and
                ;; we don't want to use the same variable for all scopes and change the
                ;; variable type underfoot.)
                (when (!= lhs nil)
                  (let [^bool used (zero bool)]
                    (range [_ v lhsVars]
                      (when (aget (.-usedVars check) v)
                        (set! used true))

                      (aset (.-usedVars check) v true)) ; avoid usage error when checking entire function

                    (when (not used)
                      (.softErrorf check lhs UnusedVar "%s declared and not used" (.-Name lhs))))))))))



      (case [(* ast/SelectStmt)]
        (set! inner bit-or breakOk)

        (.multipleDefaults check (.-List (.-Body s)))

        (range [_ s (.-List (.-Body s))]
          (let [(values clause _) (assert (* ast/CommClause) s)]
            (when (== clause nil)
              (continue)) ; error reported before


            ;; clause.Comm must be a SendStmt, RecvStmt, or default case
            (let [valid false
                ^{:line 799 :tag ast/Expr} rhs (zero ast/Expr)] ; rhs of RecvStmt, or nil
              (type-switch [s (.-Comm clause)]
                (case [nil (* ast/SendStmt)]
                  (set! valid true))
                (case [(* ast/AssignStmt)]
                  (when (== (len (.-Rhs s)) 1)
                    (set! rhs (aget (.-Rhs s) 0))))

                (case [(* ast/ExprStmt)]
                  (set! rhs (.-X s))))


              ;; if present, rhs must be a receive operation
              (when (!= rhs nil)
                (when [(values x _) (assert (* ast/UnaryExpr) (ast/Unparen rhs))] (and (!= x nil) (== (.-Op x) token/ARROW))
                  (set! valid true)))



              (when (not valid)
                (.error check (.-Comm clause) InvalidSelectCase "select case must be send or receive (possibly with assignment)")
                (continue))


              (.openScope check s "case")
              (when (!= (.-Comm clause) nil)
                (.stmt check inner (.-Comm clause)))

              (.stmtList check inner (.-Body clause))
              (.closeScope check)))))


      (case [(* ast/ForStmt)]
        (set! inner bit-or (bit-or breakOk continueOk))
        (.openScope check s "for")
        (defer (.closeScope check))

        (.simpleStmt check (.-Init s))
        (when (!= (.-Cond s) nil)
          (let [^operand x (zero operand)]
            (.expr check nil (addr x) (.-Cond s))
            (when (and (.isValid x) (not (allBoolean (.typ x))))
              (.error check (.-Cond s) InvalidCond "non-boolean condition in for statement"))))


        (.simpleStmt check (.-Post s))
        ;; spec: "The init statement may be a short variable
        ;; declaration, but the post statement must not."
        (when [(values s _) (assert (* ast/AssignStmt) (.-Post s))] (and (!= s nil) (== (.-Tok s) token/DEFINE))
          (.softErrorf check s InvalidPostDecl "cannot declare in post statement")
          ;; Don't call useLHS here because we want to use the lhs in
          ;; this erroneous statement so that we don't get errors about
          ;; these lhs variables being declared and not used.
          (.use check (spread (.-Lhs s)))) ; avoid follow-up errors

        (.stmt check inner (.-Body s)))

      (case [(* ast/RangeStmt)]
        (set! inner bit-or (bit-or breakOk continueOk))
        ;; s.TokPos is invalid when there are no range variables (for range x {});
        ;; noNewVarPos is unused in that case, but inNode asserts a valid pos.
        (let [tokPos (.-TokPos s)]
          (when (not (.IsValid tokPos))
            (set! tokPos (.-For s)))

          (.rangeStmt check inner s (inNode s tokPos) (.-Key s) (.-Value s) nil (.-X s) (== (.-Tok s) token/DEFINE))))

      (default
        (.error check s InvalidSyntaxTree "invalid statement")))))

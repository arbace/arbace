^{:go/breaks [[6 220]] :go/end 221} (go/func goVal "goVal returns the Go value for val, or nil.\n" ^any [^constant/Value val]
  ;; val should exist, but be conservative and check
  (when (== val nil)
    (return nil))

  ;; Match implementation restriction of other compilers.
  ;; gc only checks duplicates for integer, floating-point
  ;; and string values, so only create Go values for these
  ;; types.
  (switch (.Kind val)
    (case [constant/Int]
      (when [(values x ok) (constant/Int64Val val)] ok
        (return x))

      (when [(values x ok) (constant/Uint64Val val)] ok
        (return x)))

    (case [constant/Float]
      (when [(values x ok) (constant/Float64Val val)] ok
        (return x)))

    (case [constant/String]
      (return (constant/StringVal val))))

  nil)









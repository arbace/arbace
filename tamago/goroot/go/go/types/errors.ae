  ^{:line 225} [^{:val "invalid argument: "} invalidArg "invalid argument: "]
  ^{:line 226} [^{:val "invalid operation: "} invalidOp "invalid operation: "])



(go/type positioner "The positioner interface is used to extract the position of type-checker errors.\n" (interface
    (Pos ^token/Pos [])))


^{:go/end 238} (go/method error [^{:tag (* Checker)} check ^positioner at ^Code code ^string msg]
  (let [err (.newError check code)]
    (.addf err at "%s" msg)
    (.report err)))


^{:go/end 244} (go/method errorf [^{:tag (* Checker)} check ^positioner at ^Code code ^string format & ^{:tag (slice any)} args]
  (let [err (.newError check code)]
    (.addf err at format (spread args))
    (.report err)))


^{:go/end 251} (go/method softErrorf [^{:tag (* Checker)} check ^positioner at ^Code code ^string format & ^{:tag (slice any)} args]

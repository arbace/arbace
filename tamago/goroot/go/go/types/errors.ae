  (.-posn (aget (.-desc err) 0)))



^{:go/end 103} (go/method msg "msg returns the formatted error message without the primary error position pos().\n" ^string [^{:tag (* error_)} err]
  (when (.empty err)
    (return "no error"))


  (let [^strings/Builder buf (zero strings/Builder)]
    (range [i (.-desc err)]
      (let [p (addr (aget (.-desc err) i))]
        (when (> i 0)
          (fmt/Fprint (addr buf) "\n\t")
          (when (.IsValid (.Pos (.-posn p)))
            (fmt/Fprintf (addr buf) "%s: " (.Position (.-fset (.-check err)) (.Pos (.-posn p))))))


        (.WriteString buf (.-msg p))))

    (.String buf)))



^{:go/end 153} (go/method report "report reports the error err, setting check.firstError if necessary.\n" [^{:tag (* error_)} err]
  (when (.empty err)
    (panic "no error"))


  ;; Cheap trick: Don't report errors with messages containing
  ;; "invalid operand" or "invalid type" as those tend to be
  ;; follow-on errors which don't add useful information. Only
  ;; exclude them if these strings are not at the beginning,
  ;; and only if we have at least one error already reported.
  (let [check (.-check err)]
    (when (!= (.-firstErr check) nil)
      ;; It is sufficient to look at the first sub-error only.
      (let [msg (.-msg (aget (.-desc err) 0))]
        (when (or (> (strings/Index msg "invalid operand") 0) (> (strings/Index msg "invalid type") 0))
          (return))))



    (when (.-_Trace (.-conf check))
      (.trace check (.Pos (.posn err)) "ERROR: %s (code = %d)" (.-msg (aget (.-desc err) 0)) (.-code err)))


    ;; In go/types, if there is a sub-error with a valid position,
    ;; call the typechecker error handler for each sub-error.
    ;; Otherwise, call it once, with a single combined message.
    (let [multiError false]
      (when (not isTypes2)
        (for [i 1] (< i (len (.-desc err))) (inc! i)
          (when (.IsValid (.Pos (.-posn (aget (.-desc err) i))))
            (set! multiError true)
            (break))))




      (if multiError
        (range [i (.-desc err)]
          (let [p (addr (aget (.-desc err) i))]
            (.handleError check i (.-posn p) (.-code err) (.-msg p) (.-soft err))))


        (.handleError check 0 (.posn err) (.-code err) (.msg err) (.-soft err)))


      ;; make sure the error is not reported twice
      (set! (.-desc err) nil))))



^{:go/end 222} (go/method handleError "handleError should only be called by error_.report.\n" [^{:tag (* Checker)} check ^int index ^positioner posn ^Code code ^string msg ^bool soft]
  (go/call assert (!= code 0))

  (if (== index 0) (do
      ;; If we are encountering an error while evaluating an inherited
      ;; constant initialization expression, pos is the position of
      ;; the original expression, and not of the currently declared
      ;; constant identifier. Use the provided errpos instead.
      ;; TODO(gri) We may also want to augment the error message and
      ;; refer to the position (pos) in the original expression.
      (when (and (!= ^{:go/via [environment]} (.-errpos check) nil) (.IsValid (.Pos ^{:go/via [environment]} (.-errpos check))))
        (go/call assert (!= ^{:go/via [environment]} (.-iota check) nil))
        (set! posn ^{:go/via [environment]} (.-errpos check)))


      ;; Report invalid syntax trees explicitly.
      (when (== code InvalidSyntaxTree)
        (set! msg (+ "invalid syntax tree: " msg)))


      ;; If we have a URL for error codes, add a link to the first line.
      (when (!= (.-_ErrorURL (.-conf check)) "")
        (let [url (fmt/Sprintf (.-_ErrorURL (.-conf check)) code)]
          (if [i (strings/Index msg "\n")] (>= i 0)
            (set! msg (+ (subslice msg _ i) url (subslice msg i)))

            (set! msg + url)))))



    ;; Indent sub-error.
    ;; Position information is passed explicitly to Error, below.
    (set! msg (+ "\t" msg)))


  (let [span (spanOf posn)
      ^{:line 192} e ^{:go/breaks [2 4 6 8 10 12 14]} (lit Error
        :Fset (.-fset check)
        :Pos (.-pos span)
        :Msg (stripAnnotations msg)
        :Soft soft
        :go116code code
        :go116start (.-start span)
        :go116end (.-end span))]


    (when (!= ^{:go/via [environment]} (.-errpos check) nil)
      ;; If we have an internal error and the errpos override is set, use it to
      ;; augment our error positioning.
      ;; TODO(rFindley) we may also want to augment the error message and refer
      ;; to the position (pos) in the original expression.
      (let [span (spanOf ^{:go/via [environment]} (.-errpos check))]
        (set! (.-Pos e) (.-pos span))
        (set! (.-go116start e) (.-start span))
        (set! (.-go116end e) (.-end span))))


    (when (== (.-firstErr check) nil)
      (set! (.-firstErr check) e))


    (let [f (.-Error (.-conf check))]
      (when (== f nil)
        (panic (lit bailout))) ; record first error and exit

      (f e))))



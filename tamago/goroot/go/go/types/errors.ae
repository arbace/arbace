    (.addf err at format (spread args))
    (set! (.-soft err) true)
    (.report err)))


^{:go/end 258} (go/method versionErrorf [^{:tag (* Checker)} check ^positioner at ^goVersion v ^string format & ^{:tag (slice any)} args]

^{:go/end 28} (go/func assert [^bool p]
  (when (not p)
    (let [msg "assertion failed"]
      ;; Include information about the assertion location. Due to panic recovery,
      ;; this location is otherwise buried in the middle of the panicking stack.
      (when [(values _ file line ok) (runtime/Caller 1)] ok
        (set! msg (fmt/Sprintf "%s:%d: %s" file line msg)))

      (panic msg))))




(go/type errorDesc "An errorDesc describes part of a type-checking error.\n" (struct
    ^{:line 32 :tag positioner} posn
    ^{:line 33 :tag string} msg))





(go/type error_ "An error_ represents a type-checking error.\nA new error_ is created with Checker.newError.\nTo report an error_, call error_.report.\n" (struct
    ^{:line 40 :tag (* Checker)} check
    ^{:line 41 :tag (slice errorDesc)} desc
    ^{:line 42 :tag Code} code
    ^{:line 43 :tag bool} soft)) ; TODO(gri) eventually determine this from an error code



^{:go/end 52} (go/method newError "newError returns a new error_ with the given error code.\n" ^{:tag (* error_)} [^{:tag (* Checker)} check ^Code code]
  (when (== code 0)
    (panic "error code must not be 0"))

  (addr (lit error_ :check check :code code)))








^{:go/end 62} (go/method addf "addf adds formatted error information to err.\nIt may be called multiple times to provide additional information.\nThe position of the first call to addf determines the position of the reported Error.\nSubsequent calls to addf provide additional information in the form of additional lines\nin the error message (types2) or continuation errors identified by a tab-indented error\nmessage (go/types).\n" [^{:tag (* error_)} err ^positioner at ^string format & ^{:tag (slice any)} args]
  (set! (.-desc err) (append (.-desc err) (lit errorDesc at (.sprintf (.-check err) format (spread args))))))



^{:go/end 72} (go/method addAltDecl "addAltDecl is a specialized form of addf reporting another declaration of obj.\n" [^{:tag (* error_)} err ^Object obj]
  (when [pos (.Pos obj)] (.IsValid pos)
    ;; We use "other" rather than "previous" here because
    ;; the first declaration seen may not be textually
    ;; earlier in the source.
    (.addf err obj "other declaration of %s" (.Name obj))))



^{:go/end 76} (go/method empty ^bool [^{:tag (* error_)} err]
  (== (.-desc err) nil))


^{:go/end 83} (go/method posn ^positioner [^{:tag (* error_)} err]
  (when (.empty err)

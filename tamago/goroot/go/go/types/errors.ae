(go/type posSpan "posSpan holds a position range along with a highlighted position within that\nrange. This is used for positioning errors, with pos by convention being the\nfirst position in the source where the error is known to exist, and start\nand end defining the full span of syntax being considered when the error was\ndetected. Invariant: start <= pos < end || start == pos == end.\n" (struct
    ^{:line 273 :tag token/Pos} start ^token/Pos pos ^token/Pos end))


^{:go/end 278} (go/method Pos ^token/Pos [^posSpan e]
  (.-pos e))





^{:go/end 289} (go/func inNode "inNode creates a posSpan for the given node.\nInvariant: node.Pos() <= pos < node.End() (node.End() is the position of the\nfirst byte after node within the source).\n" ^posSpan [^ast/Node node ^token/Pos pos]
  (let [(values start end) (values (.Pos node) (.End node))]
    (when debug
      (go/call assert (and (<= start pos) (< pos end))))

    (lit posSpan start pos end)))





^{:go/end 313} (go/func spanOf "spanOf extracts an error span from the given positioner. By default this is\nthe trivial span starting and ending at pos, but this span is expanded when\nthe argument naturally corresponds to a span of source code.\n" ^posSpan [^positioner at]
  (type-switch [x at]
    (case [nil]
      (panic "nil positioner"))
    (case [posSpan]
      (return x))
    (case [ast/Node]
      (let [pos (.Pos x)]
        (return (lit posSpan pos pos (.End x)))))
    (case [(* operand)]
      (when (!= (.-expr x) nil)
        (let [pos (.Pos x)]
          (return (lit posSpan pos pos (.End (.-expr x))))))

      (return (lit posSpan nopos nopos nopos)))
    (default
      (let [pos (.Pos at)]
        (return (lit posSpan pos pos pos))))))

;; This file implements isTerminating.

(in-ns 'go.go.types) (go/file "return.go" :imports [


    ^{:line 10} [ast "go/ast"]
    ^{:line 11} [token "go/token"]])





^{:go/breaks [[5 76]] :go/end 77} (go/method isTerminating "isTerminating reports if s is a terminating statement.\nIf s is labeled, label is the label name; otherwise s\nis \"\".\n" ^bool [^{:tag (* Checker)} check ^ast/Stmt s ^string label]
  (type-switch [s s]
    (default
      (panic "unreachable"))

    (case [(* ast/BadStmt) (* ast/DeclStmt) (* ast/EmptyStmt) (* ast/SendStmt)
        (* ast/IncDecStmt) (* ast/AssignStmt) (* ast/GoStmt) (* ast/DeferStmt)
        (* ast/RangeStmt)])
    ;; no chance

    (case [(* ast/LabeledStmt)]
      (return (.isTerminating check (.-Stmt s) (.-Name (.-Label s)))))

    (case [(* ast/ExprStmt)]
      ;; calling the predeclared (possibly parenthesized) panic() function is terminating
      (when [(values call ok) (assert (* ast/CallExpr) (ast/Unparen (.-X s)))] (and ok (aget ^{:go/via [environment]} (.-isPanic check) call))
        (return true)))


    (case [(* ast/ReturnStmt)]
      (return true))

    (case [(* ast/BranchStmt)]
      (when (or (== (.-Tok s) token/GOTO) (== (.-Tok s) token/FALLTHROUGH))
        (return true)))


    (case [(* ast/BlockStmt)]
      (return (.isTerminatingList check (.-List s) "")))

    (case [(* ast/IfStmt)]
      (when (and (!= (.-Else s) nil)
          (.isTerminating check (.-Body s) "")
          (.isTerminating check (.-Else s) ""))
        (return true)))


    (case [(* ast/SwitchStmt)]
      (return (.isTerminatingSwitch check (.-Body s) label)))

    (case [(* ast/TypeSwitchStmt)]
      (return (.isTerminatingSwitch check (.-Body s) label)))

    (case [(* ast/SelectStmt)]
      (range [_ s (.-List (.-Body s))]
        (let [cc (assert (* ast/CommClause) s)]
          (when (or (not (.isTerminatingList check (.-Body cc) "")) (hasBreakList (.-Body cc) label true))
            (return false))))



      (return true))

    (case [(* ast/ForStmt)]
      (when (and (== (.-Cond s) nil) (not (hasBreak (.-Body s) label true)))
        (return true))))



  false)


^{:go/breaks [[4 86]] :go/end 87} (go/method isTerminatingList ^bool [^{:tag (* Checker)} check ^{:tag (slice ast/Stmt)} list ^string label]
  ;; trailing empty statements are permitted - skip them
  (for [i (- (len list) 1)] (>= i 0) (dec! i)
    (when [(values _ ok) (assert (* ast/EmptyStmt) (aget list i))] (not ok)
      (return (.isTerminating check (aget list i) label))))


  false) ; all statements are empty


^{:go/end 101} (go/method isTerminatingSwitch ^bool [^{:tag (* Checker)} check ^{:tag (* ast/BlockStmt)} body ^string label]
  (let [hasDefault false]
    (range [_ s (.-List body)]
      (let [cc (assert (* ast/CaseClause) s)]
        (when (== (.-List cc) nil)
          (set! hasDefault true))

        (when (or (not (.isTerminatingList check (.-Body cc) "")) (hasBreakList (.-Body cc) label true))
          (return false))))


    ^{:line 100} hasDefault))


;; TODO(gri) For nested breakable statements, the current implementation of hasBreak
;; will traverse the same subtree repeatedly, once for each label. Replace
;; with a single-pass label/break matching phase.




^{:go/breaks [[5 174]] :go/end 175} (go/func hasBreak "hasBreak reports if s is or contains a break statement\nreferring to the label-ed statement or implicit-ly the\nclosest outer breakable statement.\n" ^bool [^ast/Stmt s ^string label ^bool implicit]
  (type-switch [s s]
    (default
      (panic "unreachable"))

    (case [(* ast/BadStmt) (* ast/DeclStmt) (* ast/EmptyStmt) (* ast/ExprStmt)
        (* ast/SendStmt) (* ast/IncDecStmt) (* ast/AssignStmt) (* ast/GoStmt)
        (* ast/DeferStmt) (* ast/ReturnStmt)])
    ;; no chance

    (case [(* ast/LabeledStmt)]
      (return (hasBreak (.-Stmt s) label implicit)))

    (case [(* ast/BranchStmt)]
      (when (== (.-Tok s) token/BREAK)
        (when (== (.-Label s) nil)
          (return implicit))

        (when (== (.-Name (.-Label s)) label)
          (return true))))



    (case [(* ast/BlockStmt)]
      (return (hasBreakList (.-List s) label implicit)))

    (case [(* ast/IfStmt)]
      (when (or (hasBreak (.-Body s) label implicit)
          (and (!= (.-Else s) nil) (hasBreak (.-Else s) label implicit)))
        (return true)))


    (case [(* ast/CaseClause)]
      (return (hasBreakList (.-Body s) label implicit)))

    (case [(* ast/SwitchStmt)]
      (when (and (!= label "") (hasBreak (.-Body s) label false))
        (return true)))


    (case [(* ast/TypeSwitchStmt)]
      (when (and (!= label "") (hasBreak (.-Body s) label false))
        (return true)))


    (case [(* ast/CommClause)]
      (return (hasBreakList (.-Body s) label implicit)))

    (case [(* ast/SelectStmt)]
      (when (and (!= label "") (hasBreak (.-Body s) label false))
        (return true)))


    (case [(* ast/ForStmt)]
      (when (and (!= label "") (hasBreak (.-Body s) label false))
        (return true)))


    (case [(* ast/RangeStmt)]
      (when (and (!= label "") (hasBreak (.-Body s) label false))
        (return true))))



  false)


^{:go/breaks [[4 183]] :go/end 184} (go/func hasBreakList ^bool [^{:tag (slice ast/Stmt)} list ^string label ^bool implicit]
  (range [_ s list]
    (when (hasBreak s label implicit)
      (return true)))


  false)

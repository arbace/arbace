^{:go/end 207} (go/method hashTypeParam "hashTypeParam encodes a type parameter into hasher h.\n" [^hasher hr ^{:tag (* maphash/Hash)} h ^{:tag (* TypeParam)} t]
  (.WriteByte h \P)
  ;; Within the signature of a generic function, TypeParams are
  ;; identical if they have the same index and constraint, so we
  ;; hash them based on index.
  ;;
  ;; When we are outside a generic function, free TypeParams are
  ;; identical iff they are the same object, so we can use a
  ;; more discriminating hash consistent with object identity.
  ;; This optimization saves [Map] about 4% when hashing all the
  ;; Info.Types in the forward closure of net/http.
  (if (not (.-inGenericSig hr))
    ;; Optimization: outside a generic function signature,
    ;; use a more discrimating hash consistent with object identity.
    (.hashTypeName hr h (.Obj t))

    (.WriteByte h (conv byte (.Index t)))))




^{:go/end 215} (go/method hashTypeName "hashTypeName hashes the pointer of tname.\n" [hasher ^{:tag (* maphash/Hash)} h ^{:tag (* TypeName)} tname]
  (.WriteByte h \N)
  ;; Since Identical uses == to compare TypeNames,
  ;; the hash function uses maphash.Comparable.
  (^{:inst [(* TypeName)]} maphash/WriteComparable h tname))
















^{:go/end 301} (go/method shallowHash "shallowHash computes a hash of t without looking at any of its\nelement Types, to avoid potential anonymous cycles in the types of\ninterface methods.\n\nWhen an unnamed non-empty interface type appears anywhere among the\narguments or results of an interface method, there is a potential\nfor endless recursion. Consider:\n\n\ttype X interface { m() []*interface { X } }\n\nThe problem is that the Methods of the interface in m's result type\ninclude m itself; there is no mention of the named type X that\nmight help us break the cycle.\n(See comment in [Identical], case *Interface, for more.)\n" [^hasher hr ^{:tag (* maphash/Hash)} h ^Type t]
  ;; t is the type of an interface method (Signature),
  ;; its params or results (Tuples), or their immediate
  ;; elements (mostly Slice, Pointer, Basic, Named),
  ;; so there's no need to optimize anything else.
  (type-switch [t t]
    (case [(* Alias)]
      (.shallowHash hr h (Unalias t)))

    (case [(* Array)]
      (.WriteByte h \A)
      (^{:inst [int64]} maphash/WriteComparable h (.Len t)))
    ;; ignore t.Elem()

    (case [(* Basic)]
      (.WriteByte h \B)
      (.WriteByte h (conv byte (.Kind t))))

    (case [(* Chan)]
      (.WriteByte h \C))
    ;; ignore Dir(), Elem()

    (case [(* Interface)]
      (.WriteByte h \I))
    ;; no recursion here

    (case [(* Map)]
      (.WriteByte h \M))
    ;; ignore Key(), Elem()

    (case [(* Named)]
      (.hashTypeName hr h (.Obj t)))

    (case [(* Pointer)]
      (.WriteByte h \P))
    ;; ignore t.Elem()

    (case [(* Signature)]
      (.WriteByte h (conv byte (btoi (.Variadic t))))
      ;; The Signature/Tuple recursion is always
      ;; finite and invariably shallow.
      (.shallowHash hr h (.Params t))
      (.shallowHash hr h (.Results t)))

    (case [(* Slice)]
      (.WriteByte h \S))
    ;; ignore t.Elem()

    (case [(* Struct)]
      (.WriteByte h \R) ; mnemonic: a struct is a record type
      (.WriteByte h (conv byte (.NumFields t))))
    ;; ignore t.Fields()

    (case [(* Tuple)]
      (.WriteByte h \T)
      (.WriteByte h (conv byte (.Len t)))
      (range [v (.Variables t)]
        (.shallowHash hr h ^{:go/via [object]} (.Type v))))


    (case [(* TypeParam)]
      (.hashTypeParam hr h t))

    (case [(* Union)]
      (.WriteByte h \U))
    ;; ignore term set

    (default
      (panic (fmt/Sprintf "shallowHash: %T: %v" t t)))))



^{:go/end 309} (go/func btoi ^int [^bool b]
  (if b
    (return 1)

    (return 0)))

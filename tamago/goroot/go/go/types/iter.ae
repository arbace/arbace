(in-ns 'go.go.types) (go/file "iter.go" :imports [

    ^{:line 7} [iter "iter"]])

;; This file defines go1.23 iterator methods for a variety of data
;; types. They are not mirrored to cmd/compile/internal/types2, as
;; there is no point doing so until the bootstrap compiler it at least
;; go1.23; therefore go1.23-style range statements should not be used
;; in code common to types and types2, though clients of go/types are
;; free to use them.





^{:go/end 28} (go/method Methods "Methods returns a go1.23 iterator over all the methods of an\ninterface, ordered by Id.\n\nExample: for m := range t.Methods() { ... }\n" ^{:tag (iter/Seq (* Func))} [^{:tag (* Interface)} t]
  ^{:go/end 27} (fn [^{:tag (func [^{:tag (* Func)} m] [bool])} yield]
    (range [i (.NumMethods t)]
      (when (not (yield (.Method t i)))
        (break)))))









^{:go/end 42} (go/method ExplicitMethods "ExplicitMethods returns a go1.23 iterator over the explicit methods of\nan interface, ordered by Id.\n\nExample: for m := range t.ExplicitMethods() { ... }\n" ^{:tag (iter/Seq (* Func))} [^{:tag (* Interface)} t]
  ^{:go/end 41} (fn [^{:tag (func [^{:tag (* Func)} m] [bool])} yield]
    (range [i (.NumExplicitMethods t)]
      (when (not (yield (.ExplicitMethod t i)))
        (break)))))








^{:go/end 55} (go/method EmbeddedTypes "EmbeddedTypes returns a go1.23 iterator over the types embedded within an interface.\n\nExample: for e := range t.EmbeddedTypes() { ... }\n" ^{:tag (iter/Seq Type)} [^{:tag (* Interface)} t]
  ^{:go/end 54} (fn [^{:tag (func [^Type e] [bool])} yield]
    (range [i (.NumEmbeddeds t)]
      (when (not (yield (.EmbeddedType t i)))
        (break)))))








^{:go/end 68} (go/method Methods "Methods returns a go1.23 iterator over the declared methods of a named type.\n\nExample: for m := range t.Methods() { ... }\n" ^{:tag (iter/Seq (* Func))} [^{:tag (* Named)} t]
  ^{:go/end 67} (fn [^{:tag (func [^{:tag (* Func)} m] [bool])} yield]
    (range [i (.NumMethods t)]
      (when (not (yield (.Method t i)))
        (break)))))








^{:go/end 81} (go/method Children "Children returns a go1.23 iterator over the child scopes nested within scope s.\n\nExample: for child := range scope.Children() { ... }\n" ^{:tag (iter/Seq (* Scope))} [^{:tag (* Scope)} s]
  ^{:go/end 80} (fn [^{:tag (func [^{:tag (* Scope)} child] [bool])} yield]
    (range [i (.NumChildren s)]
      (when (not (yield (.Child s i)))
        (break)))))








^{:go/end 94} (go/method Fields "Fields returns a go1.23 iterator over the fields of a struct type.\n\nExample: for field := range s.Fields() { ... }\n" ^{:tag (iter/Seq (* Var))} [^{:tag (* Struct)} s]
  ^{:go/end 93} (fn [^{:tag (func [^{:tag (* Var)} field] [bool])} yield]
    (range [i (.NumFields s)]
      (when (not (yield (.Field s i)))
        (break)))))








^{:go/end 107} (go/method Variables "Variables returns a go1.23 iterator over the variables of a tuple type.\n\nExample: for v := range tuple.Variables() { ... }\n" ^{:tag (iter/Seq (* Var))} [^{:tag (* Tuple)} t]
  ^{:go/end 106} (fn [^{:tag (func [^{:tag (* Var)} v] [bool])} yield]
    (range [i (.Len t)]
      (when (not (yield (.At t i)))
        (break)))))








^{:go/end 120} (go/method Methods "Methods returns a go1.23 iterator over the methods of a method set.\n\nExample: for method := range s.Methods() { ... }\n" ^{:tag (iter/Seq (* Selection))} [^{:tag (* MethodSet)} s]
  ^{:go/end 119} (fn [^{:tag (func [^{:tag (* Selection)} method] [bool])} yield]
    (range [i (.Len s)]
      (when (not (yield (.At s i)))
        (break)))))








^{:go/end 133} (go/method Terms "Terms returns a go1.23 iterator over the terms of a union.\n\nExample: for term := range union.Terms() { ... }\n" ^{:tag (iter/Seq (* Term))} [^{:tag (* Union)} u]
  ^{:go/end 132} (fn [^{:tag (func [^{:tag (* Term)} term] [bool])} yield]
    (range [i (.Len u)]
      (when (not (yield (.Term u i)))
        (break)))))








^{:go/end 146} (go/method TypeParams "TypeParams returns a go1.23 iterator over a list of type parameters.\n\nExample: for tparam := range l.TypeParams() { ... }\n" ^{:tag (iter/Seq (* TypeParam))} [^{:tag (* TypeParamList)} l]
  ^{:go/end 145} (fn [^{:tag (func [^{:tag (* TypeParam)} tparam] [bool])} yield]
    (range [i (.Len l)]
      (when (not (yield (.At l i)))
        (break)))))








^{:go/end 159} (go/method Types "Types returns a go1.23 iterator over the elements of a list of types.\n\nExample: for t := range l.Types() { ... }\n" ^{:tag (iter/Seq Type)} [^{:tag (* TypeList)} l]
  ^{:go/end 158} (fn [^{:tag (func [^Type t] [bool])} yield]
    (range [i (.Len l)]
      (when (not (yield (.At l i)))
        (break)))))

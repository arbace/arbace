(ns go.go.build.constraint
  (:require [arbace.go :as go]))

(go/package constraint
  :path "go/build/constraint"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["expr.go" "vers.go"]
  :init-order [errNotConstraint errComplex]
  :positions :lines)

(load "constraint/expr")
(load "constraint/vers")

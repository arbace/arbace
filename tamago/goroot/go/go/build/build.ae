  (.Eval x ^{:go/end 1930} (fn ^bool [^string tag] (.matchTag ctxt tag allTags))))
















^{:go/end 1978} (go/method matchTag "matchTag reports whether the name is one of:\n\n\tcgo (if cgo is enabled)\n\t$GOOS\n\t$GOARCH\n\tctxt.Compiler\n\tlinux (if GOOS = android)\n\tsolaris (if GOOS = illumos)\n\tdarwin (if GOOS = ios)\n\tunix (if this is a Unix GOOS)\n\tboringcrypto (if GOEXPERIMENT=boringcrypto is enabled)\n\ttag (if tag is listed in ctxt.BuildTags, ctxt.ToolTags, or ctxt.ReleaseTags)\n\nIt records all consulted tags in allTags.\n" ^bool [^{:tag (* Context)} ctxt ^string name ^{:tag (map string bool)} allTags]
  (when (!= allTags nil)
    (aset allTags name true))


  ;; special tags
  (when (and (.-CgoEnabled ctxt) (== name "cgo"))
    (return true))

  (when (or (== name (.-GOOS ctxt)) (== name (.-GOARCH ctxt)) (== name (.-Compiler ctxt)))
    (return true))

  (when (and (== (.-GOOS ctxt) "android") (== name "linux"))
    (return true))

  (when (and (== (.-GOOS ctxt) "illumos") (== name "solaris"))
    (return true))

  (when (and (== (.-GOOS ctxt) "ios") (== name "darwin"))
    (return true))

  (when (and (== name "unix") (aget syslist/UnixOS (.-GOOS ctxt)))
    (return true))

  (when (== name "boringcrypto")
    (set! name "goexperiment.boringcrypto")) ; boringcrypto is an old name for goexperiment.boringcrypto


  ;; other tags
  (or (^{:inst [(slice string) string]} slices/Contains (.-BuildTags ctxt) name) (^{:inst [(slice string) string]} slices/Contains (.-ToolTags ctxt) name)
    (^{:inst [(slice string) string]} slices/Contains (.-ReleaseTags ctxt) name)))

















^{:go/end 2027} (go/method goodOSArchFile "goodOSArchFile returns false if the name contains a $GOOS or $GOARCH\nsuffix which does not match the current system.\nThe recognized name formats are:\n\n\tname_$(GOOS).*\n\tname_$(GOARCH).*\n\tname_$(GOOS)_$(GOARCH).*\n\tname_$(GOOS)_test.*\n\tname_$(GOARCH)_test.*\n\tname_$(GOOS)_$(GOARCH)_test.*\n\nExceptions:\nif GOOS=android, then files with GOOS=linux are also matched.\nif GOOS=illumos, then files with GOOS=solaris are also matched.\nif GOOS=ios, then files with GOOS=darwin are also matched.\n" ^bool [^{:tag (* Context)} ctxt ^string name ^{:tag (map string bool)} allTags]
  (set! (values name _ _) (strings/Cut name "."))

  ;; Before Go 1.4, a file called "linux.go" would be equivalent to having a
  ;; build tag "linux" in that file. For Go 1.4 and beyond, we require this
  ;; auto-tagging to apply only to files with a non-empty prefix, so
  ;; "foo_linux.go" is tagged but "linux.go" is not. This allows new operating
  ;; systems, such as android, to arrive without breaking existing code with
  ;; innocuous source code in "android.go". The easiest fix: cut everything
  ;; in the name before the initial _.
  (let [i (strings/Index name "_")]
    (when (< i 0)
      (return true))

    (set! name (subslice name i)) ; ignore everything before first _

    (let [l (strings/Split name "_")]
      (when [n (len l)] (and (> n 0) (== (aget l (- n 1)) "test"))
        (set! l (subslice l _ (- n 1))))

      ^{:go/breaks [[4 2026]]} (let [n (len l)]
        (when (and (>= n 2) (aget syslist/KnownOS (aget l (- n 2))) (aget syslist/KnownArch (aget l (- n 1))))
          (when (!= allTags nil)
            ;; In case we short-circuit on l[n-1].
            (aset allTags (aget l (- n 2)) true))

          (return (and (.matchTag ctxt (aget l (- n 1)) allTags) (.matchTag ctxt (aget l (- n 2)) allTags))))

        (when (and (>= n 1) ^:go/paren (or (aget syslist/KnownOS (aget l (- n 1))) (aget syslist/KnownArch (aget l (- n 1)))))
          (return (.matchTag ctxt (aget l (- n 1)) allTags)))

        true))))



(go/var ^{:doc "ToolDir is the directory containing build tools.\n"} ToolDir (getToolDir))



^{:go/end 2037} (go/func IsLocalImport "IsLocalImport reports whether the import path is\na local import path, like \".\", \"..\", \"./foo\", or \"../foo\".\n" ^bool [^string path]
  (or (== path ".") (== path "..")
    (strings/HasPrefix path "./") (strings/HasPrefix path "../")))







^{:go/end 2046} (go/func ArchChar "ArchChar returns \"?\" and an error.\nIn earlier versions of Go, the returned string was used to derive\nthe compiler and linker tool names, the default object file suffix,\nand the default linker output name. As of Go 1.5, those strings\nno longer vary by architecture; they are compile, link, .o, and a.out, respectively.\n" [^string goarch] :results [string error]
  (return "?" (errors/New "architecture letter no longer used")))

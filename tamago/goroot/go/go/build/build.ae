^{:go/end 379} (go/func defaultContext ^Context []
  (let [^Context c (zero Context)]

    (set! (.-GOARCH c) buildcfg/GOARCH)
    (set! (.-GOOS c) buildcfg/GOOS)
    (when [goroot (runtime/GOROOT)] (!= goroot "")
      (set! (.-GOROOT c) (filepath/Clean goroot)))

    (set! (.-GOPATH c) (envOr "GOPATH" (defaultGOPATH)))
    (set! (.-Compiler c) runtime/Compiler)
    (set! (.-ToolTags c) (append (.-ToolTags c) (spread buildcfg/ToolTags)))

    (set! defaultToolTags (append (lit (slice string)) (spread (.-ToolTags c)))) ; our own private copy

    ;; Each major Go release in the Go 1.x series adds a new
    ;; "go1.x" release tag. That is, the go1.x tag is present in
    ;; all releases >= Go 1.x. Code that requires Go 1.x or later
    ;; should say "go:build go1.x", and code that should only be
    ;; built before Go 1.x (perhaps it is the stub to use in that
    ;; case) should say "go:build !go1.x".
    ;; The last element in ReleaseTags is the current release.
    (for [i 1] (<= i goversion/Version) (inc! i)
      (set! (.-ReleaseTags c) (append (.-ReleaseTags c) (+ "go1." (strconv/Itoa i)))))


    (set! defaultReleaseTags (append (lit (slice string)) (spread (.-ReleaseTags c)))) ; our own private copy

    (let [env (os/Getenv "CGO_ENABLED")]
      (when (== env "")
        (set! env buildcfg/DefaultCGO_ENABLED))

      (switch env
        (case ["1"]
          (set! (.-CgoEnabled c) true))
        (case ["0"]
          (set! (.-CgoEnabled c) false))
        (default
          ;; cgo must be explicitly enabled for cross compilation builds
          (when (and (== runtime/GOARCH (.-GOARCH c)) (== runtime/GOOS (.-GOOS c)))
            (set! (.-CgoEnabled c) (platform/CgoSupported (.-GOOS c) (.-GOARCH c)))
            (break))

          (set! (.-CgoEnabled c) false)))


      ^{:line 378} c)))



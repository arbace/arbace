(in-ns 'go.go.build) (go/file "gc.go" :build ["//go:build gc"] :imports [


    ^{:line 10} [filepath "path/filepath"]
    ^{:line 11} [runtime "runtime"]])



^{:go/end 17} (go/func getToolDir "getToolDir returns the default value of ToolDir.\n" ^string []
  (filepath/Join (runtime/GOROOT) (+ "pkg/tool/" runtime/GOOS "_" runtime/GOARCH)))

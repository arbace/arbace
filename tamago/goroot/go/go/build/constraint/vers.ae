(in-ns 'go.go.build.constraint) (go/file "vers.go" :imports [


    ^{:line 8} [strconv "strconv"]
    ^{:line 9} [strings "strings"]])




















^{:go/end 39} (go/func GoVersion "GoVersion returns the minimum Go version implied by a given build expression.\nIf the expression can be satisfied without any Go version tags, GoVersion returns an empty string.\n\nFor example:\n\n\tGoVersion(linux && go1.22) = \"go1.22\"\n\tGoVersion((linux && go1.22) || (windows && go1.20)) = \"go1.20\" => go1.20\n\tGoVersion(linux) = \"\"\n\tGoVersion(linux || (windows && go1.22)) = \"\"\n\tGoVersion(!go1.22) = \"\"\n\nGoVersion assumes that any tag or negated tag may independently be true,\nso that its analysis can be purely structural, without SAT solving.\n“Impossible” subexpressions may therefore affect the result.\n\nFor example:\n\n\tGoVersion((linux && !linux && go1.20) || go1.21) = \"go1.20\"\n" ^string [^Expr x]
  (let [v (minVersion x (+ 1))]
    (when (< v 0)
      (return ""))

    (when (== v 0)
      (return "go1"))

    (+ "go1." (strconv/Itoa v))))




^{:go/end 80} (go/func minVersion "minVersion returns the minimum Go major version (9 for go1.9)\nimplied by expression z, or if sign < 0, by expression !z.\n" ^int [^Expr z ^int sign]
  (type-switch [z z]
    (default
      (return -1))
    (case [(* AndExpr)]
      (let [op andVersion]
        (when (< sign 0)
          (set! op orVersion))

        (return (op (minVersion (.-X z) sign) (minVersion (.-Y z) sign)))))
    (case [(* OrExpr)]
      (let [op orVersion]
        (when (< sign 0)
          (set! op andVersion))

        (return (op (minVersion (.-X z) sign) (minVersion (.-Y z) sign)))))
    (case [(* NotExpr)]
      (return (minVersion (.-X z) (- sign))))
    (case [(* TagExpr)]
      (when (< sign 0)
        ;; !foo implies nothing
        (return -1))

      (when (== (.-Tag z) "go1")
        (return 0))

      (let [(values _ v ok) (strings/Cut (.-Tag z) "go1.")]
        (when (not ok)
          (return -1))

        (let [(values n err) (strconv/Atoi v)]
          (when (!= err nil)
            ;; not a go1.N tag
            (return -1))

          (return n))))))






^{:go/end 90} (go/func andVersion "andVersion returns the minimum Go version\nimplied by the AND of two minimum Go versions,\nwhich is the max of the versions.\n" ^int [^int x ^int y]
  (when (> x y)
    (return x))

  ^{:line 89} y)





^{:go/end 100} (go/func orVersion "orVersion returns the minimum Go version\nimplied by the OR of two minimum Go versions,\nwhich is the min of the versions.\n" ^int [^int x ^int y]
  (when (< x y)
    (return x))

  ^{:line 99} y)

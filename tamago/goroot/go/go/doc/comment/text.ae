(in-ns 'go.go.doc.comment) (go/file "text.go" :imports [


    ^{:line 8} [bytes "bytes"]
    ^{:line 9} [fmt "fmt"]
    ^{:line 10} [sort "sort"]
    ^{:line 11} [strings "strings"]
    ^{:line 12} [utf8 "unicode/utf8"]])



(go/type textPrinter "A textPrinter holds the state needed for printing a Doc as plain text.\n" (struct
    (* Printer)
    ^{:line 18 :tag strings/Builder} long
    ^{:line 19 :tag string} prefix
    ^{:line 20 :tag string} codePrefix
    ^{:line 21 :tag int} width))




^{:go/end 64} (go/method Text "Text returns a textual formatting of the [Doc].\nSee the [Printer] documentation for ways to customize the text output.\n" ^{:tag (slice byte)} [^{:tag (* Printer)} p ^{:tag (* Doc)} d]
  (let [tp (addr ^{:go/breaks [2 4 6 8]} (lit textPrinter
          :Printer p
          :prefix (.-TextPrefix p)
          :codePrefix (.-TextCodePrefix p)
          :width (.-TextWidth p)))]

    (when (== (.-codePrefix tp) "")
      (set! (.-codePrefix tp) (+ (.-TextPrefix p) "\t")))

    (when (== (.-width tp) 0)
      (set! (.-width tp) (- 80 (utf8/RuneCountInString (.-prefix tp)))))


    (let [^bytes/Buffer out (zero bytes/Buffer)]
      (range [i x (.-Content d)]
        (when (and (> i 0) (blankBefore x))
          (.WriteString out (.-prefix tp))
          (writeNL (addr out)))

        (.block tp (addr out) x))

      (let [anyUsed false]
        (range [_ def (.-Links d)]
          (when (.-Used def)
            (set! anyUsed true)
            (break)))


        (when anyUsed
          (writeNL (addr out))
          (range [_ def (.-Links d)]
            (when (.-Used def)
              (fmt/Fprintf (addr out) "[%s]: %s\n" (.-Text def) (.-URL def)))))



        (.Bytes out)))))




^{:go/end 79} (go/func writeNL "writeNL calls out.WriteByte('\\n')\nbut first trims trailing spaces on the previous line.\n" [^{:tag (* bytes/Buffer)} out]
  ;; Trim trailing spaces.
  (let [data (.Bytes out)
      ^{:line 71} n 0]
    (while (and (< n (len data)) ^:go/paren (or (== (aget data (- (len data) n 1)) \space) (== (aget data (- (len data) n 1)) \tab)))
      (inc! n))

    (when (> n 0)
      (.Truncate out (- (len data) n)))

    (.WriteByte out \newline)))



^{:go/end 134} (go/method block "block prints the block x to out.\n" [^{:tag (* textPrinter)} p ^{:tag (* bytes/Buffer)} out ^Block x]
  (type-switch [x x]
    (default
      (fmt/Fprintf out "?%T\n" x))

    (case [(* Paragraph)]
      (.WriteString out (.-prefix p))
      (.text p out "" (.-Text x)))

    (case [(* Heading)]
      (.WriteString out (.-prefix p))
      (.WriteString out "# ")
      (.text p out "" (.-Text x)))

    (case [(* Code)]
      (let [text (.-Text x)]
        (while (!= text "")
          (let [^string line (zero string)]
            (set! (values line text _) (strings/Cut text "\n"))
            (when (!= line "")
              (.WriteString out (.-codePrefix p))
              (.WriteString out line))

            (writeNL out)))))


    (case [(* List)]
      (let [loose (.BlankBetween x)]
        (range [i item (.-Items x)]
          (when (and (> i 0) loose)
            (.WriteString out (.-prefix p))
            (writeNL out))

          (.WriteString out (.-prefix p))
          (.WriteString out " ")
          (if (== (.-Number item) "")
            (.WriteString out " - ")
            (do
              (.WriteString out (.-Number item))
              (.WriteString out ". ")))

          (range [i blk (.-Content item)]
            (let [^:const ^{:val "    "} fourSpace "    "]
              (when (> i 0)
                (writeNL out)
                (.WriteString out (.-prefix p))
                (.WriteString out fourSpace))

              (.text p out fourSpace (.-Text (assert (* Paragraph) blk))))))))))






^{:go/end 161} (go/method text "text prints the text sequence x to out.\n" [^{:tag (* textPrinter)} p ^{:tag (* bytes/Buffer)} out ^string indent ^{:tag (slice Text)} x]
  (.oneLongLine p (addr (.-long p)) x)
  (let [words (strings/Fields (.String (.-long p)))]
    (.Reset (.-long p))

    (let [^{:tag (slice int)} seq (zero (slice int))]
      (if (or (< (.-width p) 0) (== (len words) 0))
        (set! seq (lit (slice int) 0 (len words))) ; one long line

        (set! seq (wrap words (- (.-width p) (utf8/RuneCountInString indent)))))

      (for [i 0] (< (+ i 1) (len seq)) (inc! i)
        (when (> i 0)
          (.WriteString out (.-prefix p))
          (.WriteString out indent))

        (range [j w (subslice words (aget seq i) (aget seq (+ i 1)))]
          (when (> j 0)
            (.WriteString out " "))

          (.WriteString out w))

        (writeNL out)))))






^{:go/end 179} (go/method oneLongLine "oneLongLine prints the text sequence x to out as one long line,\nwithout worrying about line wrapping.\nExplicit links have the [ ] dropped to improve readability.\n" [^{:tag (* textPrinter)} p ^{:tag (* strings/Builder)} out ^{:tag (slice Text)} x]
  (range [_ t x]
    (type-switch [t t]
      (case [Plain]
        (.WriteString out (conv string t)))
      (case [Italic]
        (.WriteString out (conv string t)))
      (case [(* Link)]
        (.oneLongLine p out (.-Text t)))
      (case [(* DocLink)]
        (.oneLongLine p out (.-Text t))))))



















^{:go/end 328} (go/func wrap "wrap wraps words into lines of at most max runes,\nminimizing the sum of the squares of the leftover lengths\nat the end of each line (except the last, of course),\nwith a preference for ending lines at punctuation (.,:;).\n\nThe returned slice gives the indexes of the first words\non each line in the wrapped text with a final entry of len(words).\nThus the lines are words[seq[0]:seq[1]], words[seq[1]:seq[2]],\n..., words[seq[len(seq)-2]:seq[len(seq)-1]].\n\nThe implementation runs in O(n log n) time, where n = len(words),\nusing the algorithm described in D. S. Hirschberg and L. L. Larmore,\n“[The least weight subsequence problem],” FOCS 1985, pp. 137-143.\n\n[The least weight subsequence problem]: https://doi.org/10.1109/SFCS.1985.60\n" [^{:tag (slice string)} words ^int max] :results [^{:tag (slice int)} seq]
  ;; The algorithm requires that our scoring function be concave,
  ;; meaning that for all i₀ ≤ i₁ < j₀ ≤ j₁,
  ;; weight(i₀, j₀) + weight(i₁, j₁) ≤ weight(i₀, j₁) + weight(i₁, j₀).
  ;;
  ;; Our weights are two-element pairs [hi, lo]
  ;; ordered by elementwise comparison.
  ;; The hi entry counts the weight for lines that are longer than max,
  ;; and the lo entry counts the weight for lines that are not.
  ;; This forces the algorithm to first minimize the number of lines
  ;; that are longer than max, which correspond to lines with
  ;; single very long words. Having done that, it can move on to
  ;; minimizing the lo score, which is more interesting.
  ;;
  ;; The lo score is the sum for each line of the square of the
  ;; number of spaces remaining at the end of the line and a
  ;; penalty of 64 given out for not ending the line in a
  ;; punctuation character (.,:;).
  ;; The penalty is somewhat arbitrarily chosen by trying
  ;; different amounts and judging how nice the wrapped text looks.
  ;; Roughly speaking, using 64 means that we are willing to
  ;; end a line with eight blank spaces in order to end at a
  ;; punctuation character, even if the next word would fit in
  ;; those spaces.
  ;;
  ;; We care about ending in punctuation characters because
  ;; it makes the text easier to skim if not too many sentences
  ;; or phrases begin with a single word on the previous line.

  ;; A score is the score (also called weight) for a given line.
  ;; add and cmp add and compare scores.
  (let-type [score (struct
        ^{:line 228 :tag int64} hi
        ^{:line 229 :tag int64} lo)]

    (let [add ^{:go/end 231} (fn ^score [^score s ^score t] (lit score (+ (.-hi s) (.-hi t)) (+ (.-lo s) (.-lo t))))
        ^{:line 232} cmp ^{:go/breaks [[3 243]] :go/end 244} (fn ^int [^score s ^score t]
          (switch
            (case [(< (.-hi s) (.-hi t))]
              (return -1))
            (case [(> (.-hi s) (.-hi t))]
              (return (+ 1)))
            (case [(< (.-lo s) (.-lo t))]
              (return -1))
            (case [(> (.-lo s) (.-lo t))]
              (return (+ 1))))

          0)


        ;; total[j] is the total number of runes
        ;; (including separating spaces) in words[:j].
        ^{:line 248} total (make (slice int) (+ (len words) 1))]
      (aset total 0 0)
      (range [i s words]
        (aset total (+ 1 i) (+ (aget total i) (utf8/RuneCountInString s) 1)))


      ;; weight returns weight(i, j).
      (let [weight ^{:go/end 272} (fn ^score [^int i ^int j]
            ;; On the last line, there is zero weight for being too short.
            (let [n (- (aget total j) 1 (aget total i))]
              (when (and (== j (len words)) (<= n max))
                (return (lit score 0 0)))


              ;; Otherwise the weight is the penalty plus the square of the number of
              ;; characters remaining on the line or by which the line goes over.
              ;; In the latter case, that value goes in the hi part of the score.
              ;; (See note above.)
              (let [p (wrapPenalty (aget words (- j 1)))
                  ^{:line 267} v (* (conv int64 (- max n)) (conv int64 (- max n)))]
                (when (> n max)
                  (return (lit score v p)))

                (lit score 0 (+ v p)))))


          ;; The rest of this function is “The Basic Algorithm” from
          ;; Hirschberg and Larmore's conference paper,
          ;; using the same names as in the paper.
          ^{:line 277} f (lit (slice score) (lit _ 0 0))
          ^{:line 278} g ^{:go/end 278} (fn ^score [^int i ^int j] (add (aget f i) (weight i j)))

          ^{:line 280} bridge ^{:go/end 289} (fn ^bool [^int a ^int b ^int c]
            (let [k (+ c (sort/Search (- (+ (len words) 1) c) ^{:go/end 284} (fn ^bool [^int k]
                      (set! k + c)
                      (> (cmp (g a k) (g b k)) 0))))]

              (when (> k (len words))
                (return true))

              (<= (cmp (g c k) (g b k)) 0)))


          ;; d is a one-ended deque implemented as a slice.
          ^{:line 292} d (make (slice int) 1 (len words))]
        (aset d 0 0)
        (let [bestleft (make (slice int) 1 (len words))]
          (aset bestleft 0 -1)
          (for [m 1] (< m (len words)) (inc! m)
            (set! f (append f (g (aget d 0) m)))
            (set! bestleft (append bestleft (aget d 0)))
            (while (and (> (len d) 1) (<= (cmp (g (aget d 1) (+ m 1)) (g (aget d 0) (+ m 1))) 0))
              (set! d (subslice d 1))) ; “Retire”

            (while (and (> (len d) 1) (bridge (aget d (- (len d) 2)) (aget d (- (len d) 1)) m))
              (set! d (subslice d _ (- (len d) 1)))) ; “Fire”

            (when (< (cmp (g m (len words)) (g (aget d (- (len d) 1)) (len words))) 0)
              (set! d (append d m)) ; “Hire”
              ;; The next few lines are not in the paper but are necessary
              ;; to handle two-word inputs correctly. It appears to be
              ;; just a bug in the paper's pseudocode.
              (when (and (== (len d) 2) (<= (cmp (g (aget d 1) (+ m 1)) (g (aget d 0) (+ m 1))) 0))
                (set! d (subslice d 1)))))



          (set! bestleft (append bestleft (aget d 0)))

          ;; Recover least weight sequence from bestleft.
          (let [n 1]
            (for [m (len words)] (> m 0) (set! m (aget bestleft m))
              (inc! n))

            (set! seq (make (slice int) n))
            (for [m (len words)] (> m 0) (set! m (aget bestleft m))
              (dec! n)
              (aset seq n m))

            ^{:line 327} seq))))))



^{:go/breaks [[5 336]] :go/end 337} (go/func wrapPenalty "wrapPenalty is the penalty for inserting a line break after word s.\n" ^int64 [^string s]
  (switch (aget s (- (len s) 1))
    (case [\. \, \: \;]
      (return 0)))

  64)

(in-ns 'go.go.doc.comment) (go/file "print.go" :imports [


    ^{:line 8} [bytes "bytes"]
    ^{:line 9} [fmt "fmt"]
    ^{:line 10} [strings "strings"]])






(go/type Printer "A Printer is a doc comment printer.\nThe fields in the struct can be filled in before calling\nany of the printing methods\nin order to customize the details of the printing process.\n" (struct




    ^{:line 22 :tag int :doc "HeadingLevel is the nesting level used for\nHTML and Markdown headings.\nIf HeadingLevel is zero, it defaults to level 3,\nmeaning to use <h3> and ###.\n"} HeadingLevel






    ^{:line 29 :tag (func [^{:tag (* Heading)} h] [string]) :doc "HeadingID is a function that computes the heading ID\n(anchor tag) to use for the heading h when generating\nHTML and Markdown. If HeadingID returns an empty string,\nthen the heading ID is omitted.\nIf HeadingID is nil, h.DefaultID is used.\n"} HeadingID



    ^{:line 33 :tag (func [^{:tag (* DocLink)} link] [string]) :doc "DocLinkURL is a function that computes the URL for the given DocLink.\nIf DocLinkURL is nil, then link.DefaultURL(p.DocLinkBaseURL) is used.\n"} DocLinkURL




    ^{:line 38 :tag string :doc "DocLinkBaseURL is used when DocLinkURL is nil,\npassed to [DocLink.DefaultURL] to construct a DocLink's URL.\nSee that method's documentation for details.\n"} DocLinkBaseURL



    ^{:line 42 :tag string :doc "TextPrefix is a prefix to print at the start of every line\nwhen generating text output using the Text method.\n"} TextPrefix





    ^{:line 48 :tag string :doc "TextCodePrefix is the prefix to print at the start of each\npreformatted (code block) line when generating text output,\ninstead of (not in addition to) TextPrefix.\nIf TextCodePrefix is the empty string, it defaults to TextPrefix+\"\\t\".\n"} TextCodePrefix






    ^{:line 55 :tag int :doc "TextWidth is the maximum width text line to generate,\nmeasured in Unicode code points,\nexcluding TextPrefix and the newline character.\nIf TextWidth is zero, it defaults to 80 minus the number of code points in TextPrefix.\nIf TextWidth is negative, there is no limit.\n"} TextWidth))


^{:go/end 63} (go/method headingLevel ^int [^{:tag (* Printer)} p]
  (when (<= (.-HeadingLevel p) 0)
    (return 3))

  (.-HeadingLevel p))


^{:go/end 70} (go/method headingID ^string [^{:tag (* Printer)} p ^{:tag (* Heading)} h]
  (when (== (.-HeadingID p) nil)
    (return (.DefaultID h)))

  ((.-HeadingID p) h))


^{:go/end 77} (go/method docLinkURL ^string [^{:tag (* Printer)} p ^{:tag (* DocLink)} link]
  (when (!= (.-DocLinkURL p) nil)
    (return ((.-DocLinkURL p) link)))

  (.DefaultURL link (.-DocLinkBaseURL p)))




















^{:go/end 118} (go/method DefaultURL "DefaultURL constructs and returns the documentation URL for l,\nusing baseURL as a prefix for links to other packages.\n\nThe possible forms returned by DefaultURL are:\n  - baseURL/ImportPath, for a link to another package\n  - baseURL/ImportPath#Name, for a link to a const, func, type, or var in another package\n  - baseURL/ImportPath#Recv.Name, for a link to a method in another package\n  - #Name, for a link to a const, func, type, or var in this package\n  - #Recv.Name, for a link to a method in this package\n\nIf baseURL ends in a trailing slash, then DefaultURL inserts\na slash between ImportPath and # in the anchored forms.\nFor example, here are some baseURL values and URLs they can generate:\n\n\t\"/pkg/\" → \"/pkg/math/#Sqrt\"\n\t\"/pkg\"  → \"/pkg/math#Sqrt\"\n\t\"/\"     → \"/math/#Sqrt\"\n\t\"\"      → \"/math#Sqrt\"\n" ^string [^{:tag (* DocLink)} l ^string baseURL]
  (when (!= (.-ImportPath l) "")
    (let [slash ""]
      (if (strings/HasSuffix baseURL "/")
        (set! slash "/")

        (set! baseURL + "/"))

      (switch
        (case [(== (.-Name l) "")]
          (return (+ baseURL (.-ImportPath l) slash)))
        (case [(!= (.-Recv l) "")]
          (return (+ baseURL (.-ImportPath l) slash "#" (.-Recv l) "." (.-Name l))))
        (default
          (return (+ baseURL (.-ImportPath l) slash "#" (.-Name l)))))))


  (when (!= (.-Recv l) "")
    (return (+ "#" (.-Recv l) "." (.-Name l))))

  (+ "#" (.-Name l)))









^{:go/end 147} (go/method DefaultID "DefaultID returns the default anchor ID for the heading h.\n\nThe default anchor ID is constructed by converting every\nrune that is not alphanumeric ASCII to an underscore\nand then adding the prefix “hdr-”.\nFor example, if the heading text is “Go Doc Comments”,\nthe default ID is “hdr-Go_Doc_Comments”.\n" ^string [^{:tag (* Heading)} h]
  ;; Note: The “hdr-” prefix is important to avoid DOM clobbering attacks.
  ;; See https://pkg.go.dev/github.com/google/safehtml#Identifier.
  (let [^strings/Builder out (zero strings/Builder)
      ^{:line 131 :tag textPrinter} p (zero textPrinter)]
    (.oneLongLine p (addr out) (.-Text h))
    (let [s (strings/TrimSpace (.String out))]
      (when (== s "")
        (return ""))

      (.Reset out)
      (.WriteString out "hdr-")
      (range [_ r s]
        (if (and (< r 0x80) (isIdentASCII (conv byte r)))
          (.WriteByte out (conv byte r))

          (.WriteByte out \_)))


      (.String out))))


(go/type commentPrinter (struct
    (* Printer)))




^{:go/end 189} (go/method Comment "Comment returns the standard Go formatting of the [Doc],\nwithout any comment markers.\n" ^{:tag (slice byte)} [^{:tag (* Printer)} p ^{:tag (* Doc)} d]
  (let [cp (addr (lit commentPrinter :Printer p))
      ^{:line 157 :tag bytes/Buffer} out (zero bytes/Buffer)]
    (range [i x (.-Content d)]
      (when (and (> i 0) (blankBefore x))
        (.WriteString out "\n"))

      (.block cp (addr out) x))


    ;; Print one block containing all the link definitions that were used,
    ;; and then a second block containing all the unused ones.
    ;; This makes it easy to clean up the unused ones: gofmt and
    ;; delete the final block. And it's a nice visual signal without
    ;; affecting the way the comment formats for users.
    (for [i 0] (< i 2) (inc! i)
      (let [used (== i 0)
          ^{:line 172} first true]
        (range [_ def (.-Links d)]
          (when (== (.-Used def) used)
            (when first
              (.WriteString out "\n")
              (set! first false))

            (.WriteString out "[")
            (.WriteString out (.-Text def))
            (.WriteString out "]: ")
            (.WriteString out (.-URL def))
            (.WriteString out "\n")))))




    (.Bytes out)))




^{:go/breaks [[5 197]] :go/end 198} (go/func blankBefore "blankBefore reports whether the block x requires a blank line before it.\nAll blocks do, except for Lists that return false from x.BlankBefore().\n" ^bool [^Block x]
  (when [(values x ok) (assert (* List) x)] ok
    (return (.BlankBefore x)))

  true)



^{:go/end 250} (go/method block "block prints the block x to out.\n" [^{:tag (* commentPrinter)} p ^{:tag (* bytes/Buffer)} out ^Block x]
  (type-switch [x x]
    (default
      (fmt/Fprintf out "?%T" x))

    (case [(* Paragraph)]
      (.text p out "" (.-Text x))
      (.WriteString out "\n"))

    (case [(* Heading)]
      (.WriteString out "# ")
      (.text p out "" (.-Text x))
      (.WriteString out "\n"))

    (case [(* Code)]
      (let [md (.-Text x)]
        (while (!= md "")
          (let [^string line (zero string)]
            (set! (values line md _) (strings/Cut md "\n"))
            (when (!= line "")
              (.WriteString out "\t")
              (.WriteString out line))

            (.WriteString out "\n")))))


    (case [(* List)]
      (let [loose (.BlankBetween x)]
        (range [i item (.-Items x)]
          (when (and (> i 0) loose)
            (.WriteString out "\n"))

          (.WriteString out " ")
          (if (== (.-Number item) "")
            (.WriteString out " - ")
            (do
              (.WriteString out (.-Number item))
              (.WriteString out ". ")))

          (range [i blk (.-Content item)]
            (let [^:const ^{:val "    "} fourSpace "    "]
              (when (> i 0)
                (.WriteString out (+ "\n" fourSpace)))

              (.text p out fourSpace (.-Text (assert (* Paragraph) blk)))
              (.WriteString out "\n"))))))))






^{:go/end 274} (go/method text "text prints the text sequence x to out.\n" [^{:tag (* commentPrinter)} p ^{:tag (* bytes/Buffer)} out ^string indent ^{:tag (slice Text)} x]
  (range [_ t x]
    (type-switch [t t]
      (case [Plain]
        (.indent p out indent (conv string t)))
      (case [Italic]
        (.indent p out indent (conv string t)))
      (case [(* Link)]
        (if (.-Auto t)
          (.text p out indent (.-Text t))
          (do
            (.WriteString out "[")
            (.text p out indent (.-Text t))
            (.WriteString out "]"))))

      (case [(* DocLink)]
        (.WriteString out "[")
        (.text p out indent (.-Text t))
        (.WriteString out "]")))))






^{:go/end 288} (go/method indent "indent prints s to out, indenting with the indent string\nafter each newline in s.\n" [^{:tag (* commentPrinter)} p ^{:tag (* bytes/Buffer)} out ^string indent ^string s]
  (while (!= s "")
    (let [(values line rest ok) (strings/Cut s "\n")]
      (.WriteString out line)
      (when ok
        (.WriteString out "\n")
        (.WriteString out indent))

      (set! s rest))))

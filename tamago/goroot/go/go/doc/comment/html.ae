(in-ns 'go.go.doc.comment) (go/file "html.go" :imports [


    ^{:line 8} [bytes "bytes"]
    ^{:line 9} [fmt "fmt"]
    ^{:line 10} [strconv "strconv"]])



(go/type htmlPrinter "An htmlPrinter holds the state needed for printing a [Doc] as HTML.\n" (struct
    (* Printer)
    ^{:line 16 :tag bool} tight))




^{:go/end 28} (go/method HTML "HTML returns an HTML formatting of the [Doc].\nSee the [Printer] documentation for ways to customize the HTML output.\n" ^{:tag (slice byte)} [^{:tag (* Printer)} p ^{:tag (* Doc)} d]
  (let [hp (addr (lit htmlPrinter :Printer p))
      ^{:line 23 :tag bytes/Buffer} out (zero bytes/Buffer)]
    (range [_ x (.-Content d)]
      (.block hp (addr out) x))

    (.Bytes out)))



^{:go/end 92} (go/method block "block prints the block x to out.\n" [^{:tag (* htmlPrinter)} p ^{:tag (* bytes/Buffer)} out ^Block x]
  (type-switch [x x]
    (default
      (fmt/Fprintf out "?%T" x))

    (case [(* Paragraph)]
      (when (not (.-tight p))
        (.WriteString out "<p>"))

      (.text p out (.-Text x))
      (.WriteString out "\n"))

    (case [(* Heading)]
      (.WriteString out "<h")
      (let [h (strconv/Itoa ^{:go/via [Printer]} (.headingLevel p))]
        (.WriteString out h)
        (when [id ^{:go/via [Printer]} (.headingID p x)] (!= id "")
          (.WriteString out " id=\"")
          (.escape p out id)
          (.WriteString out "\""))

        (.WriteString out ">")
        (.text p out (.-Text x))
        (.WriteString out "</h")
        (.WriteString out h)
        (.WriteString out ">\n")))

    (case [(* Code)]
      (.WriteString out "<pre>")
      (.escape p out (.-Text x))
      (.WriteString out "</pre>\n"))

    (case [(* List)]
      (let [kind "ol>\n"]
        (when (== (.-Number (aget (.-Items x) 0)) "")
          (set! kind "ul>\n"))

        (.WriteString out "<")
        (.WriteString out kind)
        (let [next "1"]
          (range [_ item (.-Items x)]
            (.WriteString out "<li")
            (when [n (.-Number item)] (!= n "")
              (when (!= n next)
                (.WriteString out " value=\"")
                (.WriteString out n)
                (.WriteString out "\"")
                (set! next n))

              (set! next (inc next)))

            (.WriteString out ">")
            (set! (.-tight p) (not (.BlankBetween x)))
            (range [_ blk (.-Content item)]
              (.block p out blk))

            (set! (.-tight p) false))

          (.WriteString out "</")
          (.WriteString out kind))))))





^{:go/end 106} (go/func inc "inc increments the decimal string s.\nFor example, inc(\"1199\") == \"1200\".\n" ^string [^string s]
  (let [b (conv (slice byte) s)]
    (for [i (- (len b) 1)] (>= i 0) (dec! i)
      (when (< (aget b i) \9)
        (inc! (aget b i))
        (return (conv string b)))

      (aset b i \0))

    (+ "1" (conv string b))))



^{:go/end 137} (go/method text "text prints the text sequence x to out.\n" [^{:tag (* htmlPrinter)} p ^{:tag (* bytes/Buffer)} out ^{:tag (slice Text)} x]
  (range [_ t x]
    (type-switch [t t]
      (case [Plain]
        (.escape p out (conv string t)))
      (case [Italic]
        (.WriteString out "<i>")
        (.escape p out (conv string t))
        (.WriteString out "</i>"))
      (case [(* Link)]
        (.WriteString out "<a href=\"")
        (.escape p out (.-URL t))
        (.WriteString out "\">")
        (.text p out (.-Text t))
        (.WriteString out "</a>"))
      (case [(* DocLink)]
        (let [url ^{:go/via [Printer]} (.docLinkURL p t)]
          (when (!= url "")
            (.WriteString out "<a href=\"")
            (.escape p out url)
            (.WriteString out "\">"))

          (.text p out (.-Text t))
          (when (!= url "")
            (.WriteString out "</a>")))))))








^{:go/end 169} (go/method escape "escape prints s to out as plain text,\nescaping < & \" ' and > to avoid being misinterpreted\nin larger HTML constructs.\n" [^{:tag (* htmlPrinter)} p ^{:tag (* bytes/Buffer)} out ^string s]
  (let [start 0]
    (for [i 0] (< i (len s)) (inc! i)
      (switch (aget s i)
        (case [\<]
          (.WriteString out (subslice s start i))
          (.WriteString out "&lt;")
          (set! start (+ i 1)))
        (case [\&]
          (.WriteString out (subslice s start i))
          (.WriteString out "&amp;")
          (set! start (+ i 1)))
        (case [\"]
          (.WriteString out (subslice s start i))
          (.WriteString out "&quot;")
          (set! start (+ i 1)))
        (case [\']
          (.WriteString out (subslice s start i))
          (.WriteString out "&apos;")
          (set! start (+ i 1)))
        (case [\>]
          (.WriteString out (subslice s start i))
          (.WriteString out "&gt;")
          (set! start (+ i 1)))))


    (.WriteString out (subslice s start))))

        ;; assume type is imported
        (return (.-Name (.-Sel t)) true)))

    (case [(* ast/ParenExpr)]
      (return (baseTypeName (.-X t))))
    (case [(* ast/StarExpr)]
      (return (baseTypeName (.-X t)))))

  (return "" false))




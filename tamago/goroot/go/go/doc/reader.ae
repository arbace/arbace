;; function/method sets
;;
;; Internally, we treat functions like methods and collect them in method sets.



(go/type methodSet "A methodSet describes a set of methods. Entries where Decl == nil are conflict\nentries (more than one method with the same name at the same embedding level).\n" (map string (* Func)))




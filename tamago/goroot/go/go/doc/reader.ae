^{:go/end 692} (go/method readPackage [^{:tag (* reader)} r ^{:tag (* ast/Package)} pkg ^Mode mode]
  ;; initialize reader
  (set! (.-filenames r) (make (slice string) (len (.-Files pkg))))
  (set! (.-imports r) (make (map string int)))
  (set! (.-mode r) mode)
  (set! (.-types r) (make (map string (* namedType))))
  (set! (.-funcs r) (make methodSet))
  (set! (.-notes r) (make (map string (slice (* Note)))))
  (set! (.-importByName r) (make (map string string)))

  ;; sort package files before reading them so that the
  ;; result does not depend on map iteration order
  (let [i 0]
    (range [filename (.-Files pkg)]
      (aset (.-filenames r) i filename)
      (inc! i))

    (^{:inst [(slice string) string]} slices/Sort (.-filenames r))

    ;; process files in sorted order
    (range [_ filename (.-filenames r)]
      (let [f (aget (.-Files pkg) filename)]
        (when (== (bit-and mode AllDecls) 0)
          (.fileExports r f))

        (.readFile r f)))


    (range [name path (.-importByName r)]
      (when (== path "")
        (delete (.-importByName r) name)))



    ;; process functions now that we have better type information
    (range [_ f (.-Files pkg)]
      (range [_ decl (.-Decls f)]
        (when [(values d ok) (assert (* ast/FuncDecl) decl)] ok
          (.readFunc r d))))))






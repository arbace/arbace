      (return))

    (when (== (.-Level m) (.-Level old))
      ;; conflict - mark it using a method with nil Decl
      (aset mset (.-Name m) (addr ^{:go/breaks [2 4]} (lit Func
            :Name (.-Name m)
            :Level (.-Level m)))))))





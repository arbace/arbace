        (return (addr ^{:go/breaks [2 4]} (lit ast/SelectorExpr
              :Sel (ast/NewIdent (.-Name (.-Sel typ)))
              :X (addr (lit ast/Ident :Name (.-Name id) :NamePos pos))))))))



  nil) ; shouldn't happen, but be conservative and don't panic


^{:go/end 297} (go/method filterSpecList ^{:tag (slice ast/Spec)} [^{:tag (* reader)} r ^{:tag (slice ast/Spec)} list ^token/Token tok]
  (when (== tok token/CONST)
    ;; Propagate any type information that would get lost otherwise
    ;; when unexported constants are filtered.
    (let [^ast/Expr prevType (zero ast/Expr)]
      (range [_ spec list]
        (let [spec (assert (* ast/ValueSpec) spec)]
          (when (and (== (.-Type spec) nil) (== (len (.-Values spec)) 0) (!= prevType nil))
            ;; provide current spec with an explicit type
            (set! (.-Type spec) (copyConstType prevType (.Pos spec))))

          (if (hasExportedName (.-Names spec))
            ;; exported names are preserved so there's no need to propagate the type
            (set! prevType nil)

            (set! prevType (.-Type spec)))))))




  (let [j 0]
    (range [_ s list]
      (when (.filterSpec r s)
        (aset list j s)
        (inc! j)))


    (subslice list 0 j)))


^{:go/breaks [[4 311]] :go/end 312} (go/method filterDecl ^bool [^{:tag (* reader)} r ^ast/Decl decl]
  (type-switch [d decl]
    (case [(* ast/GenDecl)]
      (set! (.-Specs d) (.filterSpecList r (.-Specs d) (.-Tok d)))
      (return (> (len (.-Specs d)) 0)))
    (case [(* ast/FuncDecl)]
      ;; ok to filter these methods early because any
      ;; conflicting method will be filtered here, too -
      ;; thus, removing these methods early will not lead
      ;; to the false removal of possible conflicts
      (return (token/IsExported (.-Name (.-Name d))))))

  false)



^{:go/end 324} (go/method fileExports "fileExports removes unexported declarations from src in place.\n" [^{:tag (* reader)} r ^{:tag (* ast/File)} src]
  (let [j 0]
    (range [_ d (.-Decls src)]
      (when (.filterDecl r d)
        (aset (.-Decls src) j d)
        (inc! j)))


    (set! (.-Decls src) (subslice (.-Decls src) 0 j))))

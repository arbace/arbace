^{:go/end 25} (go/func filterIdentList "filterIdentList removes unexported names from list in place\nand returns the resulting list.\n" ^{:tag (slice (* ast/Ident))} [^{:tag (slice (* ast/Ident))} list]
  (let [j 0]
    (range [_ x list]
      (when (token/IsExported (.-Name x))
        (aset list j x)
        (inc! j)))


    (subslice list 0 j)))


(go/var underscore (ast/NewIdent "_"))

^{:go/end 35} (go/func filterCompositeLit [^{:tag (* ast/CompositeLit)} lit ^Filter filter ^bool export]
  (let [n (len (.-Elts lit))]
    (set! (.-Elts lit) (filterExprList (.-Elts lit) filter export))
    (when (< (len (.-Elts lit)) n)
      (set! (.-Incomplete lit) true))))



^{:go/end 55} (go/func filterExprList ^{:tag (slice ast/Expr)} [^{:tag (slice ast/Expr)} list ^Filter filter ^bool export]
  (let [j 0]
    (range [_ exp list]
      (type-switch [x exp]
        (case [(* ast/CompositeLit)]
          (filterCompositeLit x filter export))
        (case [(* ast/KeyValueExpr)]
          (when [(values x ok) (assert (* ast/Ident) (.-Key x))] (and ok (not (filter (.-Name x))))
            (continue))

          (when [(values x ok) (assert (* ast/CompositeLit) (.-Value x))] ok
            (filterCompositeLit x filter export))))


      (aset list j exp)
      (inc! j))

    (subslice list 0 j)))




^{:go/end 68} (go/func updateIdentList "updateIdentList replaces all unexported identifiers with underscore\nand reports whether at least one exported name exists.\n" [^{:tag (slice (* ast/Ident))} list] :results [^bool hasExported]
  (range [i x list]
    (if (token/IsExported (.-Name x))
      (set! hasExported true)

      (aset list i underscore)))


  ^{:line 67} hasExported)



^{:go/breaks [[5 77]] :go/end 78} (go/func hasExportedName "hasExportedName reports whether list contains any exported names.\n" ^bool [^{:tag (slice (* ast/Ident))} list]

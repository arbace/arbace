(in-ns 'go.go.doc) (go/file "synopsis.go" :imports [


    ^{:line 8} [comment "go/doc/comment"]
    ^{:line 9} [strings "strings"]
    ^{:line 10} [unicode "unicode"]])





^{:go/end 31} (go/func firstSentence "firstSentence returns the first sentence in s.\nThe sentence ends after the first period followed by space and\nnot preceded by exactly one uppercase letter.\n" ^string [^string s]
  (let [(values ^rune ppp ^rune pp ^rune p) (zero rune)]
    (range [i q s]
      (when (or (== q \newline) (== q \return) (== q \tab))
        (set! q \space))

      (when (and (== q \space) (== p \.) ^:go/paren (or (not (unicode/IsUpper pp)) (unicode/IsUpper ppp)))
        (return (subslice s _ i)))

      (when (or (== p \。) (== p \．))
        (return (subslice s _ i)))

      (set! (values ppp pp p) (values pp p q)))

    ^{:line 30} s))






^{:go/end 40} (go/func Synopsis "Synopsis returns a cleaned version of the first sentence in text.\n\nDeprecated: New programs should use [Package.Synopsis] instead,\nwhich handles links in text properly.\n" ^string [^string text]
  (let [^Package p (zero Package)]
    (.Synopsis p text)))







(go/var ^{:doc "IllegalPrefixes is a list of lower-case prefixes that identify\na comment as not being a doc comment.\nThis helps to avoid misinterpreting the common mistake\nof a copyright notice immediately before a package statement\nas being a doc comment.\n"} IllegalPrefixes ^{:go/breaks [2 3 4]} (lit (slice string)
    "copyright"
    "all rights"
    "author"))








^{:go/end 78} (go/method Synopsis "Synopsis returns a cleaned version of the first sentence in text.\nThat sentence ends after the first period followed by space and not\npreceded by exactly one uppercase letter, or at the first paragraph break.\nThe result string has no \\n, \\r, or \\t characters and uses only single\nspaces between words. If text starts with any of the [IllegalPrefixes],\nthe result is the empty string.\n" ^string [^{:tag (* Package)} p ^string text]
  (set! text (firstSentence text))
  (let [lower (strings/ToLower text)]
    (range [_ prefix IllegalPrefixes]
      (when (strings/HasPrefix lower prefix)
        (return "")))


    (let [pr (.Printer p)]
      (set! (.-TextWidth pr) -1)
      (let [d (.Parse (.Parser p) text)]
        (when (== (len (.-Content d)) 0)
          (return ""))

        (when [(values _ ok) (assert (* comment/Paragraph) (aget (.-Content d) 0))] (not ok)
          (return ""))

        (set! (.-Content d) (subslice (.-Content d) _ 1)) ; might be blank lines, code blocks, etc in “first sentence”
        (strings/TrimSpace (conv string (.Text pr d)))))))

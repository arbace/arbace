      ;; Consider all possible split points for the suffix
      ;; by starting at the end of string (no suffix case),
      ;; then trying all positions that contain a '_' character.
      ;;
      ;; An association is made on the first successful match.
      ;; Examples with malformed names that match nothing are skipped.
      (for [i (len (.-Name ex))] (>= i 0) (set! i (strings/LastIndexByte (subslice (.-Name ex) _ i) \_))
        (let [(values prefix suffix ok) (splitExampleName (.-Name ex) i)]
          (when (not ok)
            (continue))

          (let [(values exs ^:assign ok) (aget ids prefix)]
            (when (not ok)
              (continue))

            (set! (.-Suffix ex) suffix)
            (set! @exs (append @exs ex))
            (break)))))



    ;; Sort list of example according to the user-specified suffix name.
    (range [_ exs ids]
      (^{:inst [(slice (* Example)) (* Example)]} slices/SortFunc @exs ^{:go/end 682} (fn ^int [^{:tag (* Example)} a ^{:tag (* Example)} b]
          (^{:inst [string]} cmp/Compare (.-Suffix a) (.-Suffix b)))))))









^{:go/end 702} (go/func nameWithoutInst "nameWithoutInst returns name if name has no brackets. If name contains\nbrackets, then it returns name with all the contents between (and including)\nthe outermost left and right bracket removed.\n\nAdapted from debug/gosym/symtab.go:Sym.nameWithoutInst.\n" ^string [^string name]
  (let [start (strings/Index name "[")]
    (when (< start 0)
      (return name))

    (let [end (strings/LastIndex name "]")]
      (when (< end 0)
        ;; Malformed name, should contain closing bracket too.
        (return name))

      (+ (subslice name 0 start) (subslice name (+ end 1))))))








^{:go/end 719} (go/func splitExampleName "splitExampleName attempts to split example name s at index i,\nand reports if that produces a valid split. The suffix may be\nabsent. Otherwise, it must start with a lower-case letter and\nbe preceded by '_'.\n\nOne of i == len(s) or s[i] == '_' must be true.\n" [^string s ^int i] :results [^string prefix ^string suffix ^bool ok]
  (when (== i (len s))
    (return s "" true))

  (when (== i (- (len s) 1))
    (return "" "" false))

  (set! (values prefix suffix) (values (subslice s _ i) (subslice s (+ i 1))))
  (return prefix suffix (isExampleSuffix suffix)))


^{:go/end 724} (go/func isExampleSuffix ^bool [^string s]
  (let [(values r size) (utf8/DecodeRuneInString s)]
    (and (> size 0) (unicode/IsLower r))))





^{:go/end 735} (go/func updateBasicLitPos "updateBasicLitPos updates lit.Pos,\nensuring that lit.End is displaced by the same amount.\n(See https://go.dev/issue/76395.)\n" [^{:tag (* ast/BasicLit)} lit ^token/Pos pos]
  (let [len (- (.End lit) (.Pos lit))]
    (set! (.-ValuePos lit) pos)
    (when (.IsValid (.-ValueEnd lit))
      (set! (.-ValueEnd lit) (+ pos len)))))

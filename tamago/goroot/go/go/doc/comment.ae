(ns go.go.doc.comment
  (:require [arbace.go :as go]))

(go/package comment
  :path "go/doc/comment"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["doc.go" "html.go" "markdown.go" "parse.go" "print.go" "std.go" "text.go"]
  :init-order [stdPkgs]
  :positions :lines)

(load "comment/doc")
(load "comment/html")
(load "comment/markdown")
(load "comment/parse")
(load "comment/print")
(load "comment/std")
(load "comment/text")

(ns go.go.doc.comment
  (:require [arbace.go :as go]))

(go/package comment
  :path "go/doc/comment"
  :files ["doc.go" "html.go" "markdown.go" "parse.go" "print.go" "std.go" "text.go"]
  :positions :lines)

(load "comment/doc")
(load "comment/html")
(load "comment/markdown")
(load "comment/parse")
(load "comment/print")
(load "comment/std")
(load "comment/text")

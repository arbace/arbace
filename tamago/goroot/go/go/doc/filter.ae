(in-ns 'go.go.doc) (go/file "filter.go" :imports [

    ^{:line 7} [ast "go/ast"]])

(go/type Filter (func [string] [bool]))

^{:go/breaks [[4 21]] :go/end 22} (go/func matchFields ^bool [^{:tag (* ast/FieldList)} fields ^Filter f]
  (when (!= fields nil)
    (range [_ field (.-List fields)]
      (range [_ name (.-Names field)]
        (when (f (.-Name name))
          (return true)))))




  false)


^{:go/breaks [[4 51]] :go/end 52} (go/func matchDecl ^bool [^{:tag (* ast/GenDecl)} d ^Filter f]
  (range [_ d (.-Specs d)]
    (type-switch [v d]
      (case [(* ast/ValueSpec)]
        (range [_ name (.-Names v)]
          (when (f (.-Name name))
            (return true))))


      (case [(* ast/TypeSpec)]
        (when (f (.-Name (.-Name v)))
          (return true))

        ;; We don't match ordinary parameters in filterFuncs, so by analogy don't
        ;; match type parameters here.
        (type-switch [t (.-Type v)]
          (case [(* ast/StructType)]
            (when (matchFields (.-Fields t) f)
              (return true)))

          (case [(* ast/InterfaceType)]
            (when (matchFields (.-Methods t) f)
              (return true)))))))




  false)


^{:go/end 63} (go/func filterValues ^{:tag (slice (* Value))} [^{:tag (slice (* Value))} a ^Filter f]
  (let [w 0]
    (range [_ vd a]
      (when (matchDecl (.-Decl vd) f)
        (aset a w vd)
        (inc! w)))


    (subslice a 0 w)))


^{:go/end 74} (go/func filterFuncs ^{:tag (slice (* Func))} [^{:tag (slice (* Func))} a ^Filter f]
  (let [w 0]
    (range [_ fd a]
      (when (f (.-Name fd))
        (aset a w fd)
        (inc! w)))


    (subslice a 0 w)))


^{:go/end 96} (go/func filterTypes ^{:tag (slice (* Type))} [^{:tag (slice (* Type))} a ^Filter f]
  (let [w 0]
    (range [_ td a]
      (let [n 0] ; number of matches
        (if (matchDecl (.-Decl td) f)
          (set! n 1)
          (do
            ;; type name doesn't match, but we may have matching consts, vars, factories or methods
            (set! (.-Consts td) (filterValues (.-Consts td) f))
            (set! (.-Vars td) (filterValues (.-Vars td) f))
            (set! (.-Funcs td) (filterFuncs (.-Funcs td) f))
            (set! (.-Methods td) (filterFuncs (.-Methods td) f))
            (set! n + (+ (len (.-Consts td)) (len (.-Vars td)) (len (.-Funcs td)) (len (.-Methods td))))))

        (when (> n 0)
          (aset a w td)
          (inc! w))))


    (subslice a 0 w)))




^{:go/end 106} (go/method Filter "Filter eliminates documentation for names that don't pass through the filter f.\nTODO(gri): Recognize \"Type.Method\" as a name.\n" [^{:tag (* Package)} p ^Filter f]
  (set! (.-Consts p) (filterValues (.-Consts p) f))
  (set! (.-Vars p) (filterValues (.-Vars p) f))
  (set! (.-Types p) (filterTypes (.-Types p) f))
  (set! (.-Funcs p) (filterFuncs (.-Funcs p) f))
  (set! (.-Doc p) "")) ; don't show top-level package doc

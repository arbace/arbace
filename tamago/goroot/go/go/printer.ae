(ns go.go.printer
  (:require [arbace.go :as go]))

(go/package printer
  :path "go/printer"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["comment.go" "gobuild.go" "math.go" "nodes.go" "printer.go"]
  :init-order [aNewline printerPool]
  :positions :lines)

(load "printer/comment")
(load "printer/gobuild")
(load "printer/math")
(load "printer/nodes")
(load "printer/printer")

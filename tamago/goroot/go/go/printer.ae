(ns go.go.printer
  (:require [arbace.go :as go]))

(go/package printer
  :path "go/printer"
  :files ["comment.go" "gobuild.go" "math.go" "nodes.go" "printer.go"]
  :positions :lines)

(load "printer/comment")
(load "printer/gobuild")
(load "printer/math")
(load "printer/nodes")
(load "printer/printer")

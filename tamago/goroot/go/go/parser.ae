(ns go.go.parser
  (:require [arbace.go :as go]))

(go/package parser
  :path "go/parser"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["interface.go" "parser.go" "resolver.go"]
  :init-order [stmtStart declStart exprEnd unresolved]
  :positions :lines)

(load "parser/interface")
(load "parser/parser")
(load "parser/resolver")

^{:go/end 250} (go/method String "String returns the string corresponding to the token tok.\nFor operators, delimiters, and keywords the string is the actual\ntoken character sequence (e.g., for the token [ADD], the string is\n\"+\"). For all other tokens the string corresponds to the token\nconstant name (e.g. for the token [IDENT], the string is \"IDENT\").\n" ^string [^Token tok]
  (let [s ""]
    (when (and (<= 0 tok) (< tok (conv Token (len tokens))))
      (set! s (aget tokens tok)))

    (when (== s "")
      (set! s (+ "token(" (strconv/Itoa (conv int tok)) ")")))

    ^{:line 249} s))







(go/const "A set of constants for precedence-based expression parsing.\nNon-operators have lowest precedence, followed by operators\nstarting with precedence 1 up to unary operators. The highest\nprecedence serves as \"catch-all\" precedence for selector,\nindexing, and other operator and delimiter tokens.\n"
  ^{:line 258} [^{:val 0} LowestPrec 0] ; non-operators
  ^{:line 259} [^{:val 6} UnaryPrec 6]
  ^{:line 260} [^{:val 7} HighestPrec 7])





^{:go/end 280} (go/method Precedence "Precedence returns the operator precedence of the binary\noperator op. If op is not a binary operator, the result\nis LowestPrecedence.\n" ^int [^Token op]
  (switch op
    (case [LOR]
      (return 1))
    (case [LAND]
      (return 2))
    (case [EQL NEQ LSS LEQ GTR GEQ]
      (return 3))
    (case [ADD SUB OR XOR]
      (return 4))
    (case [MUL QUO REM SHL SHR AND AND_NOT]
      (return 5)))

  ^{:line 279} LowestPrec)


(go/var ^{:tag (map string Token)} keywords)

^{:go/end 289} (go/func init []
  (set! keywords (make (map string Token) (- keyword_end (+ keyword_beg 1))))
  (for [i (+ keyword_beg 1)] (< i keyword_end) (inc! i)
    (aset keywords (aget tokens i) i)))




^{:go/end 297} (go/func Lookup "Lookup maps an identifier to its keyword token or [IDENT] (if not a keyword).\n" ^Token [^string ident]
  (when [(values tok is_keyword) (aget keywords ident)] is_keyword
    (return tok))

  ^{:line 296} IDENT)


;; Predicates



^{:go/end 303} (go/method IsLiteral "IsLiteral returns true for tokens corresponding to identifiers\nand basic type literals; it returns false otherwise.\n" ^bool [^Token tok] (and (< literal_beg tok) (< tok literal_end)))



^{:go/end 309} (go/method IsOperator "IsOperator returns true for tokens corresponding to operators and\ndelimiters; it returns false otherwise.\n" ^bool [^Token tok]
  (or ^:go/paren (and (< operator_beg tok) (< tok operator_end)) (== tok TILDE)))




^{:go/end 313} (go/method IsKeyword "IsKeyword returns true for tokens corresponding to keywords;\nit returns false otherwise.\n" ^bool [^Token tok] (and (< keyword_beg tok) (< tok keyword_end)))


^{:go/end 319} (go/func IsExported "IsExported reports whether name starts with an upper-case letter.\n" ^bool [^string name]
  (let [(values ch _) (utf8/DecodeRuneInString name)]
    (unicode/IsUpper ch)))



^{:go/end 326} (go/func IsKeyword "IsKeyword reports whether name is a Go keyword, such as \"func\" or \"return\".\n" ^bool [^string name]
  ;; TODO: opt: use a perfect hash function instead of a global map.
  (let [(values _ ok) (aget keywords name)]
    ^{:line 325} ok))





^{:go/breaks [[6 340]] :go/end 341} (go/func IsIdentifier "IsIdentifier reports whether name is a Go identifier, that is, a non-empty\nstring made up of letters, digits, and underscores, where the first character\nis not a digit. Keywords are not identifiers.\n" ^bool [^string name]
  (when (or (== name "") (IsKeyword name))
    (return false))

  (range [i c name]
    (when (and (not (unicode/IsLetter c)) (!= c \_) ^:go/paren (or (== i 0) (not (unicode/IsDigit c))))
      (return false)))


  true)

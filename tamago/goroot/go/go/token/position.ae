^{:go/end 597} (go/method PositionFor "PositionFor converts a [Pos] p in the fileset into a [Position] value.\nIf adjusted is set, the position may be adjusted by position-altering\n//line comments; otherwise those comments are ignored.\np must be a [Pos] value in s or [NoPos].\n" [^{:tag (* FileSet)} s ^Pos p ^bool adjusted] :results [^Position pos]
  (when (!= p NoPos)

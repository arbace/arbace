    nil))





^{:go/end 584} (go/method File "File returns the file that contains the position p.\nIf no such file is found (for instance for p == [NoPos]),\nthe result is nil.\n" [^{:tag (* FileSet)} s ^Pos p] :results [^{:tag (* File)} f]

^{:go/end 603} (go/method Position "Position converts a [Pos] p in the fileset into a Position value.\nCalling s.Position(p) is equivalent to calling s.PositionFor(p, true).\n" [^{:tag (* FileSet)} s ^Pos p] :results [^Position pos]

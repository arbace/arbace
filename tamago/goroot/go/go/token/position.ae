  (let [b (.-base s)]
    (.RUnlock (.-mutex s))
    ^{:line 445} b))

















^{:go/end 489} (go/method AddFile "AddFile adds a new file with a given filename, base offset, and file size\nto the file set s and returns the file. Multiple files may have the same\nname. The base offset must not be smaller than the [FileSet.Base], and\nsize must not be negative. As a special case, if a negative base is provided,\nthe current value of the [FileSet.Base] is used instead.\n\nAdding the file will set the file set's [FileSet.Base] value to base + size + 1\nas the minimum base value for the next file. The following relationship\nexists between a [Pos] value p for a given file offset offs:\n\n\tint(p) = base + offs\n\nwith offs in the range [0, size] and thus p in the range [base, base+size].\nFor convenience, [File.Pos] may be used to create file-specific position\nvalues from a file offset.\n" ^{:tag (* File)} [^{:tag (* FileSet)} s ^string filename ^int base ^int size]
  ;; Allocate f outside the critical section.
  (let [f (addr (lit File :name filename :size size :lines (lit (slice int) 0)))]

    (.Lock (.-mutex s))
    (defer (.Unlock (.-mutex s)))
    (when (< base 0)
      (set! base (.-base s)))

    (when (< base (.-base s))
      (panic (fmt/Sprintf "invalid base %d (should be >= %d)" base (.-base s))))

    (set! (.-base f) base)
    (when (< size 0)
      (panic (fmt/Sprintf "invalid size %d (should be >= 0)" size)))

    ;; base >= s.base && size >= 0
    (set! base + (+ size 1)) ; +1 because EOF also has a position
    (when (< base 0)
      (panic "token.Pos offset overflow (> 2G of source code in file set)"))

    ;; add the file to the file set
    (set! (.-base s) base)
    (.add (.-tree s) f)
    (.Store (.-last s) f)
    ^{:line 488} f))






^{:go/end 521} (go/method AddExistingFiles "AddExistingFiles adds the specified files to the\nFileSet if they are not already present.\nThe caller must ensure that no pair of Files that\nwould appear in the resulting FileSet overlap.\n" [^{:tag (* FileSet)} s & ^{:tag (slice (* File))} files]
  ;; This function cannot be implemented as:
  ;;
  ;;	for _, file := range files {
  ;;		if prev := fset.File(token.Pos(file.Base())); prev != nil {
  ;;			if prev != file {
  ;;				panic("FileSet contains a different file at the same base")
  ;;			}
  ;;			continue
  ;;		}
  ;;		file2 := fset.AddFile(file.Name(), file.Base(), file.Size())
  ;;		file2.SetLines(file.Lines())
  ;;	}
  ;;
  ;; because all calls to AddFile must be in increasing order.
  ;; AddExistingFiles lets us augment an existing FileSet
  ;; sequentially, so long as all sets of files have disjoint ranges.
  ;; This approach also does not preserve line directives.

  (.Lock (.-mutex s))
  (defer (.Unlock (.-mutex s)))

  (range [_ f files]
    (.add (.-tree s) f)
    (set! (.-base s) (max (.-base s) (+ (.Base f) (.Size f) 1)))))









^{:go/end 539} (go/method RemoveFile "RemoveFile removes a file from the [FileSet] so that subsequent\nqueries for its [Pos] interval yield a negative result.\nThis reduces the memory usage of a long-lived [FileSet] that\nencounters an unbounded stream of files.\n\nRemoving a file that does not belong to the set has no effect.\n" [^{:tag (* FileSet)} s ^{:tag (* File)} file]
  (.Lock (.-mutex s))
  (defer (.Unlock (.-mutex s)))

  (.CompareAndSwap (.-last s) file nil) ; clear last file cache

  (let [(values pn _) (.locate (.-tree s) (.key file))]
    (when (and (!= @pn nil) (== (.-file @pn) file))
      (.delete (.-tree s) pn))))





^{:go/end 555} (go/method Iterate "Iterate calls yield for the files in the file set in ascending Base\norder until yield returns false.\n" [^{:tag (* FileSet)} s ^{:tag (func [(* File)] [bool])} yield]

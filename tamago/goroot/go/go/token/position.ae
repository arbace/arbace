  (when [i (searchInts (.-lines f) offset)] (>= i 0)
    (set! (values line column) (values (+ i 1) (+ (- offset (aget (.-lines f) i)) 1))))

  (when (and adjusted (> (len (.-infos f)) 0))
    ;; few files have extra line infos
    (when [i (searchLineInfos (.-infos f) offset)] (>= i 0)
      (let [alt (addr (aget (.-infos f) i))]
        (set! filename (.-Filename alt))
        (when [i (searchInts (.-lines f) (.-Offset alt))] (>= i 0)
          ;; i+1 is the line at which the alternative position was recorded
          (let [d (- line (+ i 1))] ; line distance from alternative position base
            (set! line (+ (.-Line alt) d))
            (cond (== (.-Column alt) 0)
              ;; alternative column is unknown => relative column is unknown
              ;; (the current specification for line directives requires
              ;; this to apply until the next PosBase/line directive,
              ;; not just until the new newline)
              (set! column 0)
              (== d 0)
              ;; the alternative position base is on the current line
              ;; => column is relative to alternative column
              (set! column (+ (.-Column alt) (- offset (.-Offset alt))))))))))




  ;; TODO(mvdan): move Unlock back under Lock with a defer statement once
  ;; https://go.dev/issue/38471 is fixed to remove the performance penalty.
  (.Unlock (.-mutex f))
  (return))



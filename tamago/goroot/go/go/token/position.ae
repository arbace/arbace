  (defer (.RUnlock (.-mutex s)))

  ;; Unlock around user code.
  ;; The iterator is robust to modification by yield.
  ;; Avoid range here, so we can use defer.
  ((.all (.-tree s)) ^{:go/end 554} (fn ^bool [^{:tag (* File)} f]
      (.RUnlock (.-mutex s))
      (defer (.RLock (.-mutex s)))
      (yield f))))




^{:go/end 179} (go/method MergeLine "MergeLine merges a line with the following line. It is akin to replacing\nthe newline character at the end of the line with a space (to not change the\nremaining offsets). To obtain the line number, consult e.g. [Position.Line].\nMergeLine will panic if given an invalid line number.\n" [^{:tag (* File)} f ^int line]
  (when (< line 1)
    (panic (fmt/Sprintf "invalid line number %d (should be >= 1)" line)))

  (.Lock (.-mutex f))
  (defer (.Unlock (.-mutex f)))
  (when (>= line (len (.-lines f)))
    (panic (fmt/Sprintf "invalid line number %d (should be < %d)" line (len (.-lines f)))))

  ;; To merge the line numbered <line> with the line numbered <line+1>,
  ;; we need to remove the entry in lines corresponding to the line
  ;; numbered <line+1>. The entry in lines corresponding to the line
  ;; numbered <line+1> is located at index <line>, since indices in lines
  ;; are 0-based and line numbers are 1-based.
  (copy (subslice (.-lines f) line) (subslice (.-lines f) (+ line 1)))
  (set! (.-lines f) (subslice (.-lines f) _ (- (len (.-lines f)) 1))))





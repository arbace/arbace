  (.RLock (.-mutex s))
  (defer (.RUnlock (.-mutex s)))

  ^{:go/breaks [[3 573]]} (let [(values pn _) (.locate (.-tree s) (lit key (conv int p) (conv int p)))]
    (when [n @pn] (!= n nil)

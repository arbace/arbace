(in-ns 'go.go.token) (go/file "tree.go" :imports [

    ;; tree is a self-balancing AVL tree; see
    ;; Lewis & Denenberg, Data Structures and Their Algorithms.
    ;;
    ;; An AVL tree is a binary tree in which the difference between the
    ;; heights of a node's two subtrees--the node's "balance factor"--is
    ;; at most one. It is more strictly balanced than a red/black tree,
    ;; and thus favors lookups at the expense of updates, which is the
    ;; appropriate trade-off for FileSet.
    ;;
    ;; Insertion at a node may cause its ancestors' balance factors to
    ;; temporarily reach ±2, requiring rebalancing of each such ancestor
    ;; by a rotation.
    ;;
    ;; Each key is the pos-end range of a single File.
    ;; All Files in the tree must have disjoint ranges.
    ;;
    ;; The implementation is simplified from Russ Cox's github.com/rsc/omap.


    ^{:line 26} [fmt "fmt"]
    ^{:line 27} [iter "iter"]])







(go/type tree "A tree is a tree-based ordered map:\neach value is a *File, keyed by its Pos range.\nAll map entries cover disjoint ranges.\n\nThe zero value of tree is an empty map ready to use.\n" (struct
    ^{:line 36 :tag (* node)} root))


(go/type node (struct

    ^{:line 41 :tag (* node) :doc "We use the notation (parent left right) in many comments.\n"} parent
    ^{:line 42 :tag (* node)} left
    ^{:line 43 :tag (* node)} right
    ^{:line 44 :tag (* File)} file
    ^{:line 45 :tag key} key ; = file.key(), but improves locality (25% faster)
    ^{:line 46 :tag int32} balance ; at most ±2
    ^{:line 47 :tag int32} height))



(go/type key "A key represents the Pos range of a File.\n" (struct ^int start ^int end))

^{:go/end 55} (go/method key ^key [^{:tag (* File)} f]
  (lit key (.-base f) (+ (.-base f) (.-size f))))











^{:go/breaks [[5 73]] :go/end 74} (go/func compareKey "compareKey reports whether x is before y (-1),\nafter y (+1), or overlapping y (0).\nThis is a total order so long as all\nfiles in the tree have disjoint ranges.\n\nAll files are separated by at least one unit.\nThis allows us to use strict < comparisons.\nUse key{p, p} to search for a zero-width position\neven at the start or end of a file.\n" ^int [^key x ^key y]
  (switch
    (case [(< (.-end x) (.-start y))]
      (return -1))
    (case [(< (.-end y) (.-start x))]
      (return (+ 1))))

  0)




^{:go/end 91} (go/method check "check asserts that each node's height, subtree, and parent link is\ncorrect.\n" [^{:tag (* node)} n ^{:tag (* node)} parent]
  (let [^:const ^{:val false} debugging false]
    (when debugging
      (when (== n nil)
        (return))

      (when (!= (.-parent n) parent)
        (panic "bad parent"))

      (.check (.-left n) n)
      (.check (.-right n) n)
      (.checkBalance n))))



^{:go/end 106} (go/method checkBalance [^{:tag (* node)} n]
  (let [(values lheight rheight) (values (.safeHeight (.-left n)) (.safeHeight (.-right n)))
      ^{:line 95} balance (- rheight lheight)]
    (when (!= balance (.-balance n))
      (panic "bad node.balance"))

    (when (not (and (<= -2 balance) (<= balance (+ 2))))
      (panic (fmt/Sprintf "node.balance out of range: %d" balance)))

    (let [h (+ 1 (max lheight rheight))]
      (when (!= h (.-height n))
        (panic "bad node.height")))))







^{:go/end 125} (go/method locate "locate returns a pointer to the variable that holds the node\nidentified by k, along with its parent, if any. If the key is not\npresent, it returns a pointer to the node where the key should be\ninserted by a subsequent call to [tree.set].\n" [^{:tag (* tree)} t ^key k] :results [^{:tag (* (* node))} pos ^{:tag (* node)} parent]
  (let [(values ^:assign pos x) (values (addr (.-root t)) (.-root t))]
    (while (!= x nil)
      (let [sign (compareKey k (.-key x))]
        (cond (< sign 0)
          (set! (values pos x parent) (values (addr (.-left x)) (.-left x) x))
          (> sign 0)
          (set! (values pos x parent) (values (addr (.-right x)) (.-right x) x)) :else

          (break))))


    (return pos parent)))






^{:go/end 152} (go/method all "all returns an iterator over the tree t.\nIf t is modified during the iteration,\nsome files may not be visited.\nNo file will be visited multiple times.\n" ^{:tag (iter/Seq (* File))} [^{:tag (* tree)} t]
  ^{:go/end 151} (fn [^{:tag (func [(* File)] [bool])} yield]
    (when (== t nil)
      (return))

    (let [x (.-root t)]
      (when (!= x nil)
        (while (!= (.-left x) nil)
          (set! x (.-left x))))


      (while (and (!= x nil) (yield (.-file x)))
        (if (>= (.-height x) 0)
          ;; still in tree
          (set! x (.next x))

          ;; deleted
          (set! x (.nextAfter t (.locate t (.-key x)))))))))







^{:go/end 167} (go/method nextAfter "nextAfter returns the node in the key sequence following\n(pos, parent), a result pair from [tree.locate].\n" ^{:tag (* node)} [^{:tag (* tree)} t ^{:tag (* (* node))} pos ^{:tag (* node)} parent]
  (switch
    (case [(!= @pos nil)]
      (return (.next @pos)))
    (case [(== parent nil)]
      (return nil))
    (case [(== pos (addr (.-left parent)))]
      (return parent))
    (default
      (return (.next parent)))))




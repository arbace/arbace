    (while (and (!= (.-parent x) nil) (== (.-right (.-parent x)) x))
      (set! x (.-parent x)))

    (return (.-parent x)))

  (set! x (.-right x))
  (while (!= (.-left x) nil)
    (set! x (.-left x)))

  ^{:line 180} x)



  ;; p -> (x a (y b c))
  (let [p (.-parent x)
      ^{:line 291} y (.-right x)
      ^{:line 292} b (.-left y)]

    (.checkBalance x)
    (.checkBalance y)

    (.setLeft y x)
    (.setRight x b)
    (.replaceChild t p x y)

    (.update x)
    (.update y)
    ^{:line 303} y))




^{:go/end 319} (go/method add "add inserts file into the tree, if not present.\nIt panics if file overlaps with another.\n" [^{:tag (* tree)} t ^{:tag (* File)} file]
  (let [(values pos parent) (.locate t (.key file))]
    (when (== @pos nil)
      (.set t file pos parent) ; missing; insert
      (return))

    (when [prev (.-file @pos)] (!= prev file)
      (panic (fmt/Sprintf "file %s (%d-%d) overlaps with file %s (%d-%d)"
          (.Name prev) (.Base prev) (.End prev)
          (.Name file) (.Base file) (.End file))))))





^{:go/end 337} (go/method set "set updates the existing node at (pos, parent) if present, or\ninserts a new node if not, so that it refers to file.\n" [^{:tag (* tree)} t ^{:tag (* File)} file ^{:tag (* (* node))} pos ^{:tag (* node)} parent]
  (when [x @pos] (!= x nil)
    ;; This code path isn't currently needed
    ;; because FileSet never updates an existing entry.
    ;; Remove this assertion if things change.
    (when true ; defeat vet's unreachable pass
      (panic "unreachable according to current FileSet requirements"))

    (set! (.-file x) file)
    (return))

  (let [x (addr (lit node :file file :key (.key file) :parent parent :height -1))]
    (set! @pos x)
    (.rebalanceUp t x)))



^{:go/end 375} (go/method delete "delete deletes the node at pos.\n" [^{:tag (* tree)} t ^{:tag (* (* node))} pos]
  (.check (.-root t) nil)

  (let [x @pos]
    (switch
      (case [(== x nil)]
        ;; This code path isn't currently needed because FileSet
        ;; only calls delete after a positive locate.
        ;; Remove this assertion if things change.
        (when true ; defeat vet's unreachable pass
          (panic "unreachable according to current FileSet requirements"))

        (return))

      (case [(== (.-left x) nil)]
        (when [(set! @pos (.-right x))] (!= @pos nil)
          (set! (.-parent @pos) (.-parent x)))

        (.rebalanceUp t (.-parent x)))

      (case [(== (.-right x) nil)]
        (set! @pos (.-left x))
        (set! (.-parent (.-left x)) (.-parent x))
        (.rebalanceUp t (.-parent x)))

      (default
        (.deleteSwap t pos)))


    (set! (.-balance x) -100)
    (set! (.-parent x) nil)
    (set! (.-left x) nil)
    (set! (.-right x) nil)
    (set! (.-height x) -1)
    (.check (.-root t) nil)))




^{:go/end 395} (go/method deleteSwap "deleteSwap deletes a node that has two children by replacing\nit by its in-order successor, then triggers a rebalance.\n" [^{:tag (* tree)} t ^{:tag (* (* node))} pos]
  (let [x @pos
      ^{:line 381} z (.deleteMin t (addr (.-right x)))]

    (set! @pos z)
    (let [unbalanced (.-parent z)] ; lowest potentially unbalanced node
      (when (== unbalanced x)
        (set! unbalanced z)) ; (x a (z nil b)) -> (z a b)

      (set! (.-parent z) (.-parent x))
      (set! (.-height z) (.-height x))
      (set! (.-balance z) (.-balance x))
      (.setLeft z (.-left x))
      (.setRight z (.-right x))

      (.rebalanceUp t unbalanced))))





^{:go/end 410} (go/method deleteMin "deleteMin updates the subtree rooted at *zpos to delete its minimum\n(leftmost) element, which may be *zpos itself. It returns the\ndeleted node.\n" [^{:tag (* tree)} t ^{:tag (* (* node))} zpos] :results [^{:tag (* node)} z]
  (while (!= (.-left @zpos) nil)
    (set! zpos (addr (.-left @zpos))))

  (set! z @zpos)
  (set! @zpos (.-right z))
  (when (!= @zpos nil)
    (set! (.-parent @zpos) (.-parent z)))

  ^{:line 409} z)

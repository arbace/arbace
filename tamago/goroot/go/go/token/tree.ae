  (when (!= y nil)
    (set! (.-parent y) x)))



^{:go/end 209} (go/method safeHeight ^int32 [^{:tag (* node)} n]
  (when (== n nil)
    (return -1))

  (.-height n))


^{:go/end 215} (go/method update [^{:tag (* node)} n]
  (let [(values lheight rheight) (values (.safeHeight (.-left n)) (.safeHeight (.-right n)))]
    (set! (.-height n) (+ (max lheight rheight) 1))
    (set! (.-balance n) (- rheight lheight))))


^{:go/end 231} (go/method replaceChild [^{:tag (* tree)} t ^{:tag (* node)} parent ^{:tag (* node)} old ^{:tag (* node)} new]
  (switch
    (case [(== parent nil)]
      (when (!= (.-root t) old)
        (panic "corrupt tree"))

      (.setRoot t new))
    (case [(== (.-left parent) old)]
      (.setLeft parent new))
    (case [(== (.-right parent) old)]
      (.setRight parent new))
    (default
      (panic "corrupt tree"))))









^{:go/end 264} (go/method rebalanceUp "rebalanceUp visits each excessively unbalanced ancestor\nof x, restoring balance by rotating it.\n\nx is a node that has just been mutated, and so the height and\nbalance of x and its ancestors may be stale, but the children of x\nmust be in a valid state.\n" [^{:tag (* tree)} t ^{:tag (* node)} x]
  (while (!= x nil)
    (let [h (.-height x)]
      (.update x)
      (switch (.-balance x)
        (case [-2]
          (when (== (.-balance (.-left x)) 1)
            (.rotateLeft t (.-left x)))

          (set! x (.rotateRight t x)))

        (case [(+ 2)]
          (when (== (.-balance (.-right x)) -1)
            (.rotateRight t (.-right x)))

          (set! x (.rotateLeft t x))))

      (when (== (.-height x) h)
        ;; x's height has not changed, so the height
        ;; and balance of its ancestors have not changed;
        ;; no further rebalancing is required.
        (return))

      (set! x (.-parent x)))))





^{:go/end 284} (go/method rotateRight "rotateRight rotates the subtree rooted at node y.\nturning (y (x a b) c) into (x a (y b c)).\n" ^{:tag (* node)} [^{:tag (* tree)} t ^{:tag (* node)} y]
  ;; p -> (y (x a b) c)
  (let [p (.-parent y)
      ^{:line 271} x (.-left y)
      ^{:line 272} b (.-right x)]

    (.checkBalance x)
    (.checkBalance y)

    (.setRight x y)
    (.setLeft y b)
    (.replaceChild t p y x)

    (.update y)
    (.update x)
    ^{:line 283} x))





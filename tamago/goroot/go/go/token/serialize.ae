(in-ns 'go.go.token) (go/file "serialize.go" :imports [

    ^{:line 7} [slices "slices"]])

(go/type serializedFile (struct

    ^{:line 11 :tag string :doc "fields correspond 1:1 to fields with same (lower-case) name in File\n"} Name
    ^{:line 12 :tag int} Base
    ^{:line 13 :tag int} Size
    ^{:line 14 :tag (slice int)} Lines
    ^{:line 15 :tag (slice lineInfo)} Infos))


(go/type serializedFileSet (struct
    ^{:line 19 :tag int} Base
    ^{:line 20 :tag (slice serializedFile)} Files))



^{:go/end 45} (go/method Read "Read calls decode to deserialize a file set into s; s must not be nil.\n" ^error [^{:tag (* FileSet)} s ^{:tag (func [any] [error])} decode]
  ^{:go/breaks [[8 44]]} (let [^serializedFileSet ss (zero serializedFileSet)]
    (when [err (decode (addr ss))] (!= err nil)
      (return err))


    (.Lock (.-mutex s))
    (set! (.-base s) (.-Base ss))
    (range [_ f (.-Files ss)]
      (.add (.-tree s) (addr ^{:go/breaks [2 4 6 8 10]} (lit File
            :name (.-Name f)
            :base (.-Base f)
            :size (.-Size f)
            :lines (.-Lines f)
            :infos (.-Infos f)))))


    (.Store (.-last s) nil)
    (.Unlock (.-mutex s))

    nil))



^{:go/end 69} (go/method Write "Write calls encode to serialize the file set s.\n" ^error [^{:tag (* FileSet)} s ^{:tag (func [any] [error])} encode]
  (let [^serializedFileSet ss (zero serializedFileSet)]

    (.Lock (.-mutex s))
    (set! (.-Base ss) (.-base s))
    (let [^{:tag (slice serializedFile)} files (zero (slice serializedFile))]
      (range [f (.all (.-tree s))]
        (.Lock (.-mutex f))
        (set! files (append files ^{:go/breaks [2 4 6 8 10]} (lit serializedFile
              :Name (.-name f)
              :Base (.-base f)
              :Size (.-size f)
              :Lines (^{:inst [(slice int) int]} slices/Clone (.-lines f))
              :Infos (^{:inst [(slice lineInfo) lineInfo]} slices/Clone (.-infos f)))))

        (.Unlock (.-mutex f)))

      (set! (.-Files ss) files)
      (.Unlock (.-mutex s))

      (encode ss))))

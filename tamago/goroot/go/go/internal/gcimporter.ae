(ns go.go.internal.gcimporter
  (:require [arbace.go :as go]))

(go/package gcimporter
  :path "go/internal/gcimporter"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["gcimporter.go" "support.go" "ureader.go"]
  :init-order []
  :positions :lines)

(load "gcimporter/gcimporter")
(load "gcimporter/support")
(load "gcimporter/ureader")

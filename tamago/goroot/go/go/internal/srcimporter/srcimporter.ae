;; Package srcimporter implements importing directly
;; from source files rather than installed packages.
(in-ns 'go.go.internal.srcimporter) (go/file "srcimporter.go" :doc "Package srcimporter implements importing directly\nfrom source files rather than installed packages.\n" :imports [ ; import "go/internal/srcimporter"



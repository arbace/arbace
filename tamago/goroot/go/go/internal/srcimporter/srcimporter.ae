^{:go/end 252} (go/method absPath [^{:tag (* Importer)} p ^string path] :results [string error]
  ;; TODO(gri) This should be using p.ctxt.AbsPath which doesn't
  ;; exist but probably should. See also issue #14282.
  (filepath/Abs path))


^{:go/end 259} (go/method isAbsPath ^bool [^{:tag (* Importer)} p ^string path]
  (when [f (.-IsAbsPath (.-ctxt p))] (!= f nil)
    (return (f path)))

  (filepath/IsAbs path))


^{:go/end 266} (go/method joinPath ^string [^{:tag (* Importer)} p & ^{:tag (slice string)} elem]
  (when [f (.-JoinPath (.-ctxt p))] (!= f nil)
    (return (f (spread elem))))

  (filepath/Join (spread elem)))




;; Package gcimporter implements Import for gc-generated object files.
(in-ns 'go.go.internal.gcimporter) (go/file "gcimporter.go" :doc "Package gcimporter implements Import for gc-generated object files.\n" :imports [ ; import "go/internal/gcimporter"


    ^{:line 9} [bufio "bufio"]
    ^{:line 10} [fmt "fmt"]
    ^{:line 11} [token "go/token"]
    ^{:line 12} [types "go/types"]
    ^{:line 13} [exportdata "internal/exportdata"]
    ^{:line 14} [pkgbits "internal/pkgbits"]
    ^{:line 15} [io "io"]
    ^{:line 16} [os "os"]])





^{:go/end 84} (go/func Import "Import imports a gc-generated package given its import path and srcDir, adds\nthe corresponding package object to the packages map, and returns the object.\nThe packages map must contain all packages already imported.\n" [^{:tag (* token/FileSet)} fset ^{:tag (map string (* types/Package))} packages ^string path ^string srcDir ^{:tag (func [^string path] [io/ReadCloser error])} lookup] :results [^{:tag (* types/Package)} pkg ^error err]
  (let [^io/ReadCloser rc (zero io/ReadCloser)
      ^{:line 24 :tag string} id (zero string)]
    (if (!= lookup nil) (do
        ;; With custom lookup specified, assume that caller has
        ;; converted path to a canonical import path for use in the map.
        (when (== path "unsafe")
          (return types/Unsafe nil))

        (set! id path)

        ;; No need to re-import if the package was imported completely before.
        (when [(set! pkg (aget packages id))] (and (!= pkg nil) (.Complete pkg))
          (return))

        (let [(values f err) (lookup path)]
          (when (!= err nil)
            (return nil err))

          (set! rc f)))

      (let [^string filename (zero string)]
        (set! (values filename id err) (exportdata/FindPkg path srcDir))
        (when (== filename "")
          (when (== path "unsafe")
            (return types/Unsafe nil))

          (return nil err))


        ;; no need to re-import if the package was imported completely before
        (when [(set! pkg (aget packages id))] (and (!= pkg nil) (.Complete pkg))
          (return))


        ;; open file
        (let [(values f err) (os/Open filename)]
          (when (!= err nil)
            (return nil err))

          (defer (^{:go/end 67} (fn []
                (when (!= err nil)
                  ;; add file name to error
                  (set! err (fmt/Errorf "%s: %v" filename err))))))


          (set! rc f))))

    (defer (.Close rc))

    (let [buf (bufio/NewReader rc)
        (values data ^:assign err) (exportdata/ReadUnified buf)]
      (when (!= err nil)
        (set! err (fmt/Errorf "import %q: %v" path err))
        (return))

      (let [s (conv string data)

          ^{:line 80} input (pkgbits/NewPkgDecoder id s)]
        (set! pkg (readUnifiedPackage fset nil packages input))

        (return)))))

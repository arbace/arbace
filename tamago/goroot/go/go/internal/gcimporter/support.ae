;; This file implements support functionality for ureader.go.

(in-ns 'go.go.internal.gcimporter) (go/file "support.go" :imports [


    ^{:line 10} [fmt "fmt"]
    ^{:line 11} [token "go/token"]
    ^{:line 12} [pkgbits "internal/pkgbits"]
    ^{:line 13} [sync "sync"]])


^{:go/end 20} (go/func assert [^bool b]
  (when (not b)
    (panic "assertion failed")))



^{:go/end 24} (go/func errorf [^string format & ^{:tag (slice any)} args]
  (panic (fmt/Sprintf format (spread args))))



(go/type fakeFileSet "Synthesize a token.Pos\n" (struct
    ^{:line 28 :tag (* token/FileSet)} fset
    ^{:line 29 :tag (map string (* fileInfo))} files))


(go/type fileInfo (struct
    ^{:line 33 :tag (* token/File)} file
    ^{:line 34 :tag int} lastline))


(go/const ^{:val 65536} maxlines (* 64 1024))

^{:go/end 61} (go/method pos ^token/Pos [^{:tag (* fakeFileSet)} s ^string file ^int line ^int column]
  ;; TODO(mdempsky): Make use of column.

  ;; Since we don't know the set of needed file positions, we reserve
  ;; maxlines positions per file. We delay calling token.File.SetLines until
  ;; all positions have been calculated (by way of fakeFileSet.setLines), so
  ;; that we can avoid setting unnecessary lines. See also golang/go#46586.
  (let [f (aget (.-files s) file)]
    (when (== f nil)
      (set! f (addr (lit fileInfo :file (.AddFile (.-fset s) file -1 maxlines))))
      (aset (.-files s) file f))


    (when (> line maxlines)
      (set! line 1))

    (when (> line (.-lastline f))
      (set! (.-lastline f) line))


    ;; Return a fake position assuming that f.file consists only of newlines.
    (conv token/Pos (- (+ (.Base (.-file f)) line) 1))))


^{:go/end 73} (go/method setLines [^{:tag (* fakeFileSet)} s]
  (.Do fakeLinesOnce ^{:go/end 69} (fn []
      (set! fakeLines (make (slice int) maxlines))
      (range [i fakeLines]
        (aset fakeLines i i))))


  (range [_ f (.-files s)]
    (.SetLines (.-file f) (subslice fakeLines _ (.-lastline f)))))



(go/var
  ^{:line 76} [^{:tag (slice int)} fakeLines]
  ^{:line 77} [^sync/Once fakeLinesOnce])



(go/type derivedInfo "See cmd/compile/internal/noder.derivedInfo.\n" (struct
    ^{:line 82 :tag pkgbits/Index} idx
    ^{:line 83 :tag bool} needed))



(go/type typeInfo "See cmd/compile/internal/noder.typeInfo.\n" (struct
    ^{:line 88 :tag pkgbits/Index} idx
    ^{:line 89 :tag bool} derived))



^{:go/end 104} (go/func splitVargenSuffix "See cmd/compile/internal/types.SplitVargenSuffix.\n" [^string name] :results [^string base ^string suffix]
  (let [i (len name)]
    (while (and (> i 0) (>= (aget name (- i 1)) \0) (<= (aget name (- i 1)) \9))
      (dec! i))

    (let [^:const ^{:val "·"} dot "·"]
      (when (and (>= i (len dot)) (== (subslice name (- i (len dot)) i) dot))
        (set! i - (len dot))
        (return (subslice name _ i) (subslice name i)))

      (return name ""))))

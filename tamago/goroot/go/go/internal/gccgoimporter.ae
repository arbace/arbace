(ns go.go.internal.gccgoimporter
  (:require [arbace.go :as go]))

(go/package gccgoimporter
  :path "go/internal/gccgoimporter"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["ar.go" "gccgoinstallation.go" "importer.go" "parser.go"]
  :init-order [["parser.go" 78 5] reserved]
  :positions :lines)

(load "gccgoimporter/ar")
(load "gccgoimporter/gccgoinstallation")
(load "gccgoimporter/importer")
(load "gccgoimporter/parser")

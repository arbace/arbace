^{:go/end 62} (go/func findExportFile "Locate the file from which to read export data.\nThis is intended to replicate the logic in gofrontend.\n" [^{:tag (slice string)} searchpaths ^string pkgpath] :results [string error]
  (range [_ spath searchpaths]
    (let [pkgfullpath (filepath/Join spath pkgpath)
        (values pkgdir name) (filepath/Split pkgfullpath)]

      (range [_ filepath (lit (array ... string)
            ^{:line 48} pkgfullpath
            (+ pkgfullpath ".gox")
            (+ pkgdir "lib" name ".so")
            (+ pkgdir "lib" name ".a")
            (+ pkgfullpath ".o"))]

        (let [(values fi err) (os/Stat filepath)]
          (when (and (== err nil) (not (.IsDir fi)))
            (return filepath nil))))))




  (return "" (fmt/Errorf "%s: could not find export data (tried %s)" pkgpath (strings/Join searchpaths ":"))))



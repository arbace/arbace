^{:go/end 134} (go/func openExportFile "Opens the export data file at the given path. If this is an ELF file,\nsearches for and opens the .go_export section. If this is an archive,\nreads the export data from the first member, which is assumed to be an ELF file.\nThis is intended to replicate the logic in gofrontend.\n" [^string fpath] :results [^io/ReadSeeker reader ^io/Closer closer ^error err]
  (let [(values f ^:assign err) (os/Open fpath)]
    (when (!= err nil)
      (return))

    (set! closer f)
    (defer (^{:go/end 87} (fn []
          (when (and (!= err nil) (!= closer nil))
            (.Close f)))))



    (let [^{:tag (array 4 byte)} magic (zero (array 4 byte))]
      (set! (values _ err) (.ReadAt f (subslice magic) 0))
      (when (!= err nil)
        (return))


      (let [^io/ReaderAt objreader (zero io/ReaderAt)]
        (switch (conv string (subslice magic))
          (case [gccgov1Magic gccgov2Magic gccgov3Magic goimporterMagic]
            ;; Raw export data.
            (set! reader f)
            (return))

          (case [archiveMagic aixbigafMagic]
            (set! (values reader err) (arExportData f))
            (return))

          (default
            (set! objreader f)))


        (let [(values ef ^:assign err) (elf/NewFile objreader)]
          (when (== err nil)
            (let [sec (.Section ef ".go_export")]
              (when (== sec nil)
                (set! err (fmt/Errorf "%s: .go_export section not found" fpath))
                (return))

              (set! reader (.Open sec))
              (return)))


          (let [(values xf ^:assign err) (xcoff/NewFile objreader)]
            (when (== err nil)
              (let [sdat (.CSect xf ".go_export")]
                (when (== sdat nil)
                  (set! err (fmt/Errorf "%s: .go_export section not found" fpath))
                  (return))

                (set! reader (bytes/NewReader sdat))
                (return)))


            (set! err (fmt/Errorf "%s: unrecognized file format" fpath))
            (return)))))))









(go/type Importer "An Importer resolves import paths to Packages. The imports map records\npackages already known, indexed by package path.\nAn importer must determine the canonical package path and check imports\nto see if it is already present in the map. If so, the Importer can return\nthe map entry. Otherwise, the importer must load the package data for the\ngiven path into a new *Package, record it in imports map, and return the\npackage.\n" (func [^{:tag (map string (* types/Package))} imports ^string path ^string srcDir ^{:tag (func [string] [io/ReadCloser error])} lookup] [(* types/Package) error]))


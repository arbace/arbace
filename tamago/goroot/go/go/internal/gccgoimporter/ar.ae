          (return nil (fmt/Errorf "archive header format header (%q)" (subslice hdrBuf))))


        (let [(values size err) (strconv/ParseInt (strings/TrimSpace (conv string (subslice hdrBuf arSizeOff (+ arSizeOff arSizeSize)))) 10 64)]
          (when (!= err nil)
            (return nil (fmt/Errorf "error parsing size in archive header (%q): %v" (subslice hdrBuf) err)))


          (let [fn (subslice hdrBuf arNameOff (+ arNameOff arNameSize))]
            (if (and (== (aget fn 0) \/) ^:go/paren (or (== (aget fn 1) \space) (== (aget fn 1) \/) (== (conv string (subslice fn _ 8)) "/SYM64/ "))) (do)
              ;; Archive symbol table or extended name table,

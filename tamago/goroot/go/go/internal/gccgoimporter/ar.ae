      (return (.Open sec) nil))))



^{:go/end 150} (go/func aixBigArExportData "aixBigArExportData returns export data from an AIX big archive.\n" [^io/ReadSeeker archive] :results [io/ReadSeeker error]
  (let [archiveAt (readerAtFromSeeker archive)
      (values arch err) (xcoff/NewArchive archiveAt)]
    (when (!= err nil)

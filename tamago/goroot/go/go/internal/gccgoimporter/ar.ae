^{:go/end 73} (go/func arExportData "arExportData takes an archive file and returns a ReadSeeker for the\nexport data in that file. This assumes that there is only one\nobject in the archive containing export data, which is not quite\nwhat gccgo does; gccgo concatenates together all the export data\nfor all the objects in the file.  In practice that case does not arise.\n" [^io/ReadSeeker archive] :results [io/ReadSeeker error]
  (when [(values _ err) (.Seek archive 0 io/SeekStart)] (!= err nil)
    (return nil err))


  (let [^{:tag (array (len armag) byte)} buf (zero (array (len armag) byte))]
    (when [(values _ err) (.Read archive (subslice buf))] (!= err nil)
      (return nil err))


    (switch (conv string (subslice buf))
      (case [armag]
        (return (standardArExportData archive)))
      (case [armagt]
        (return nil (errors/New "unsupported thin archive")))
      (case [armagb]
        (return (aixBigArExportData archive)))
      (default
        (return nil (fmt/Errorf "unrecognized archive file format %q" (subslice buf)))))))




^{:go/end 114} (go/func standardArExportData "standardArExportData returns export data from a standard archive.\n" [^io/ReadSeeker archive] :results [io/ReadSeeker error]
  (let [off (conv int64 (len armag))]
    (while true
      (let [^{:tag (array arHdrSize byte)} hdrBuf (zero (array arHdrSize byte))]
        (when [(values _ err) (.Read archive (subslice hdrBuf))] (!= err nil)

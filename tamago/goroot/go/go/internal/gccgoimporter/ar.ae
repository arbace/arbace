^{:go/end 128} (go/func elfFromAr "elfFromAr tries to get export data from an archive member as an ELF file.\nIf there is no export data, this returns nil, nil.\n" [^{:tag (* io/SectionReader)} member] :results [io/ReadSeeker error]
  (let [(values ef err) (elf/NewFile member)]
    (when (!= err nil)
      (return nil err))

    (let [sec (.Section ef ".go_export")]
      (when (== sec nil)

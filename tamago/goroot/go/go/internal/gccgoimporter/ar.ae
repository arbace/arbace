              (let [archiveAt (readerAtFromSeeker archive)
                  (values ret err) (elfFromAr (io/NewSectionReader archiveAt off size))]
                (when (or (!= ret nil) (!= err nil))
                  (return ret err))))



            (when (!= (bit-and size 1) 0)

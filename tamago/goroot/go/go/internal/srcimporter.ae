(ns go.go.internal.srcimporter
  (:require [arbace.go :as go]))

(go/package srcimporter
  :path "go/internal/srcimporter"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["srcimporter.go"]
  :init-order []
  :positions :lines)

(load "srcimporter/srcimporter")

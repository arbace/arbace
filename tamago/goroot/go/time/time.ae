      (case [(and (< d Second) (== (% Second (+ d d)) 0))]
        (set! qmod2 (bit-and (conv int (/ nsec (conv int32 d))) 1))
        (set! r (conv Duration (% nsec (conv int32 d)))))

      ;; Special case: d is a multiple of 1 second.
      (case [(== (% d Second) 0)]
        (let [d1 (conv int64 (/ d Second))]
          (set! qmod2 (bit-and (conv int (/ sec d1)) 1))
          (set! r (+ (* (conv Duration (% sec d1)) Second) (conv Duration nsec)))))

      ;; General case.
      ;; This could be faster if more cleverness were applied,
      ;; but it's really only here to avoid special case restrictions in the API.
      ;; No one will care about these cases.
      (default
        ;; Compute nanoseconds as 128-bit number.
        (let [sec (conv uint64 sec)
            ^{:line 1848} tmp (* (>> sec 32) 1.0E9)
            ^{:line 1849} u1 (>> tmp 32)
            ^{:line 1850} u0 (<< tmp 32)]
          (set! tmp (* (bit-and sec 0xFFFFFFFF) 1.0E9))
          (let [(values u0x ^:assign u0) (values u0 (+ u0 tmp))]
            (when (< u0 u0x)
              (inc! u1))

            (set! (values u0x u0) (values u0 (+ u0 (conv uint64 nsec))))
            (when (< u0 u0x)
              (inc! u1))


            ;; Compute remainder by subtracting r<<k for decreasing k.
            ;; Quotient parity is whether we subtract on last round.
            (let [d1 (conv uint64 d)]
              (while (!= (>> d1 63) 1)
                (set! d1 << 1))

              (let [d0 (conv uint64 0)]
                (while true
                  (set! qmod2 0)
                  (when (or (> u1 d1) (and (== u1 d1) (>= u0 d0)))
                    ;; subtract
                    (set! qmod2 1)
                    (set! (values u0x u0) (values u0 (- u0 d0)))
                    (when (> u0 u0x)
                      (dec! u1))

                    (set! u1 - d1))

                  (when (and (== d1 0) (== d0 (conv uint64 d)))
                    (break))

                  (set! d0 >> 1)
                  (set! d0 bit-or (<< (bit-and d1 1) 63))
                  (set! d1 >> 1))

                (set! r (conv Duration u0))))))))


    (when (and neg (!= r 0))
      ;; If input was negative and not an exact multiple of d, we computed q, r such that
      ;;	q*d + r = -t
      ;; But the right answers are given by -(q-1), d-r:
      ;;	q*d + r = -t
      ;;	-q*d - r = t
      ;;	-(q-1)*d + (d - r) = t
      (set! qmod2 bit-xor 1)
      (set! r (- d r)))

    (return)))


;; Regrettable Linkname Compatibility
;;
;; timeAbs, absDate, and absClock mimic old internal details, no longer used.
;; Widely used packages linknamed these to get “faster” time routines.
;; Notable members of the hall of shame include:
;;   - gitee.com/quant1x/gox
;;   - github.com/phuslu/log
;;
;; phuslu hard-coded 'Unix time + 9223372028715321600' [sic]
;; as the input to absDate and absClock, using the old Jan 1-based
;; absolute times.
;; quant1x linknamed the time.Time.abs method and passed the
;; result of that method to absDate and absClock.
;;
;; Keeping both of these working forces us to provide these three
;; routines here, operating on the old Jan 1-based epoch instead
;; of the new March 1-based epoch. And the fact that time.Time.abs
;; was linknamed means that we have to call the current abs method
;; something different (time.Time.absSec, defined above) to make it
;; possible to provide this simulation of the old routines here.
;;
;; None of this code is linked into the binary if not referenced by
;; these linkname-happy packages. In particular, despite its name,
;; time.Time.abs does not appear in the time.Time method table.
;;
;; Do not remove these routines or their linknames, or change the
;; type signature or meaning of arguments.


^{:go/end 1933} (go/func ^{:go/linkname "legacyTimeTimeAbs time.Time.abs"} legacyTimeTimeAbs ^uint64 [^Time t]
  (conv uint64 (- (.absSec t) (* marchThruDecember secondsPerDay))))



^{:go/end 1938} (go/func ^{:go/linkname "legacyAbsClock time.absClock"} legacyAbsClock [^uint64 abs] :results [^int hour ^int min ^int sec]
  (.clock (conv absSeconds (+ abs (* marchThruDecember secondsPerDay)))))



^{:go/end 1947} (go/func ^{:go/linkname "legacyAbsDate time.absDate"} legacyAbsDate [^uint64 abs ^bool full] :results [^int year ^Month month ^int day ^int yday]
  (let [d (.days (conv absSeconds (+ abs (* marchThruDecember secondsPerDay))))]
    (set! (values year month day) (.date d))
    (set! (values _ yday) (.yearYday d))
    (dec! yday) ; yearYday is 1-based, old API was 0-based
    (return)))

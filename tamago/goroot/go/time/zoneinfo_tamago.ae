(in-ns 'go.time) (go/file "zoneinfo_tamago.go" :build ["//go:build tamago"] :imports [])

(go/var platformZoneSources (lit (slice string)))

^{:go/end 13} (go/func gorootZoneSource [^string goroot] :results [string bool]
  (return "zoneinfo" true))


^{:go/end 17} (go/func initLocal []
  (set! (.-name localLoc) "UTC"))

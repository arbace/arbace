(in-ns 'go.time) (go/file "sys_tamago.go" :build ["//go:build tamago"] :imports [


    ^{:line 10} [errors "errors"]
    ^{:line 11} [syscall "syscall"]])



^{:go/end 17} (go/func interrupt "for testing: whatever interrupts a sleep\n" [])
;; cannot predict pid, don't want to kill group


^{:go/end 25} (go/func open [^string name] :results [uintptr error]
  (let [(values fd err) (syscall/Open name syscall/O_RDONLY 0600)]
    (when (!= err nil)
      (return 0 err))

    (return (conv uintptr fd) nil)))


^{:go/end 29} (go/func read [^uintptr fd ^{:tag (slice byte)} buf] :results [int error]
  (syscall/Read (conv int fd) buf))


^{:go/end 33} (go/func closefd [^uintptr fd]
  (syscall/Close (conv int fd)))


^{:go/end 54} (go/func preadn ^error [^uintptr fd ^{:tag (slice byte)} buf ^int off]
  ^{:go/breaks [[5 53]]} (let [whence seekStart]
    (when (< off 0)
      (set! whence seekEnd))

    (when [(values _ err) (syscall/Seek (conv int fd) (conv int64 off) whence)] (!= err nil)
      (return err))

    (while (> (len buf) 0)
      (let [(values m err) (syscall/Read (conv int fd) buf)]
        (when (<= m 0)
          (when (== err nil)
            (return (errors/New "short read")))

          (return err))

        (set! buf (subslice buf m))))

    nil))

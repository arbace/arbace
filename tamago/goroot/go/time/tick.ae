(in-ns 'go.time) (go/file "tick.go" :imports [

    ^{:line 7} [unsafe "unsafe"]])

;; Note: The runtime knows the layout of struct Ticker, since newTimer allocates it.
;; Note also that Ticker and Timer have the same layout, so that newTimer can handle both.
;; The initTimer and initTicker fields are named differently so that
;; users cannot convert between the two without unsafe.



(go/type Ticker "A Ticker holds a channel that delivers “ticks” of a clock\nat intervals.\n" (struct
    ^{:line 17 :tag (chan :recv Time)} C ; The channel on which the ticks are delivered.
    ^{:line 18 :tag bool} initTicker))

















^{:go/end 47} (go/func NewTicker "NewTicker returns a new [Ticker] containing a channel that will send\nthe current time on the channel after each tick. The period of the\nticks is specified by the duration argument. The ticker will adjust\nthe time interval or drop ticks to make up for slow receivers.\nThe duration d must be greater than zero; if not, NewTicker will\npanic.\n\nBefore Go 1.23, the garbage collector did not recover\ntickers that had not yet expired or been stopped, so code often\nimmediately deferred t.Stop after calling NewTicker, to make\nthe ticker recoverable when it was no longer needed.\nAs of Go 1.23, the garbage collector can recover unreferenced\ntickers, even if they haven't been stopped.\nThe Stop method is no longer necessary to help the garbage collector.\n(Code may of course still want to call Stop to stop the ticker for other reasons.)\n" ^{:tag (* Ticker)} [^Duration d]
  (when (<= d 0)
    (panic "non-positive interval for NewTicker"))

  ;; Give the channel a 1-element time buffer.
  ;; If the client falls behind while reading, we drop ticks
  ;; on the floor until the client catches up.
  (let [c (make (chan Time) 1)
      ^{:line 44} t (conv (* Ticker) (conv unsafe/Pointer (newTimer (go/call when d) (conv int64 d) sendTime c (syncTimer c))))]
    (set! (.-C t) c)
    ^{:line 46} t))






^{:go/end 61} (go/method Stop "Stop turns off a ticker. After Stop, no more ticks will be sent.\nStop does not close the channel, to permit calling [Ticker.Reset],\nand to prevent a concurrent goroutine reading from the channel\nfrom seeing an erroneous \"tick\".\n" [^{:tag (* Ticker)} t]
  (when (not (.-initTicker t))
    ;; This is misuse, and the same for time.Timer would panic,
    ;; but this didn't always panic, and we keep it not panicking
    ;; to avoid breaking old programs. See issue 21874.
    (return))

  (stopTimer (conv (* Timer) (conv unsafe/Pointer t))))





^{:go/end 74} (go/method Reset "Reset stops a ticker and resets its period to the specified duration.\nThe next tick will arrive after the new period elapses. The duration d\nmust be greater than zero; if not, Reset will panic.\n" [^{:tag (* Ticker)} t ^Duration d]
  (when (<= d 0)
    (panic "non-positive interval for Ticker.Reset"))

  (when (not (.-initTicker t))
    (panic "time: Reset called on uninitialized Ticker"))

  (resetTimer (conv (* Timer) (conv unsafe/Pointer t)) (go/call when d) (conv int64 d)))













^{:go/end 92} (go/func Tick "Tick is a convenience wrapper for [NewTicker] providing access to the ticking\nchannel only. Unlike NewTicker, Tick will return nil if d <= 0.\n\nBefore Go 1.23, this documentation warned that the underlying\n[Ticker] would never be recovered by the garbage collector, and that\nif efficiency was a concern, code should use NewTicker instead and\ncall [Ticker.Stop] when the ticker is no longer needed.\nAs of Go 1.23, the garbage collector can recover unreferenced\ntickers, even if they haven't been stopped.\nThe Stop method is no longer necessary to help the garbage collector.\nThere is no longer any reason to prefer NewTicker when Tick will do.\n" ^{:tag (chan :recv Time)} [^Duration d]
  (when (<= d 0)
    (return nil))

  (.-C (NewTicker d)))

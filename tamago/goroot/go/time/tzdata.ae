(ns go.time.tzdata
  (:require [arbace.go :as go]))

(go/package tzdata
  :path "time/tzdata"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["tzdata.go" "zzipdata.go"]
  :init-order []
  :positions :lines)

(load "tzdata/tzdata")
(load "tzdata/zzipdata")

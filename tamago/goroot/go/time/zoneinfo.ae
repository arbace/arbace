        (let [^int day (zero int)]
          (set! (values day s ok) (tzsetNum s 0 365))
          (when (not ok)
            (return (lit rule) "" false))

          (set! (.-kind r) ruleDOY)
          (set! (.-day r) day)))


      (when (or (== (len s) 0) (!= (aget s 0) \/))
        (set! (.-time r) (* 2 secondsPerHour)) ; 2am is the default
        (return r s true))


      (let [(values offset ^:assign s ^:assign ok) (tzsetOffset (subslice s 1))]
        (when (not ok)

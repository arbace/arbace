^{:go/end 697} (go/func LoadLocation "LoadLocation returns a [Location] with the given name.\n\nIf the name is \"\" or \"UTC\", LoadLocation returns [UTC].\nIf the name is \"Local\", LoadLocation returns [Local].\n\nOtherwise, a new [Location] is created where the name is taken\nto be a location name corresponding to a file\nin the IANA Time Zone database, such as \"America/New_York\".\n\nLoadLocation looks for the IANA Time Zone database in the following\nlocations in order:\n\n  - the directory or uncompressed zip file named by the ZONEINFO environment variable\n  - on a Unix system, the system standard installation location\n  - $GOROOT/lib/time/zoneinfo.zip\n  - the time/tzdata package, if it was imported\n" [^string name] :results [(* Location) error]
  (when (or (== name "") (== name "UTC"))
    (return UTC nil))

  (when (== name "Local")
    (return Local nil))

  (when (or (containsDotDot name) (== (aget name 0) \/) (== (aget name 0) \\))
    ;; No valid IANA Time Zone name contains a single dot,
    ;; much less dot dot. Likewise, none begin with a slash.
    (return nil errLocation))

  (.Do zoneinfoOnce ^{:go/end 679} (fn []
      (let [(values env _) (syscall/Getenv "ZONEINFO")]
        (set! zoneinfo (addr env)))))

  (let [^error firstErr (zero error)]
    (when (!= @zoneinfo "")
      (if [(values zoneData err) (loadTzinfoFromDirOrZip @zoneinfo name)] (== err nil) (do
          (when [(values z err) (LoadLocationFromTZData name zoneData)] (== err nil)
            (return z nil))

          (set! firstErr err))
        (when (!= err syscall/ENOENT)
          (set! firstErr err))))


    (if [(values z err) (loadLocation name platformZoneSources)] (== err nil)
      (return z nil)
      (when (== firstErr nil)
        (set! firstErr err)))

    (return nil firstErr)))




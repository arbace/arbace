    (switch (.-kind r)
      (case [ruleJulian]
        (set! s (* (- (.-day r) 1) secondsPerDay))
        (when (and (isLeap year) (>= (.-day r) 60))
          (set! s + secondsPerDay)))

      (case [ruleDOY]
        (set! s (* (.-day r) secondsPerDay)))
      (case [ruleMonthWeekDay]

        (set! (.-time r) offset)

        (return r s true)))))





^{:go/end 556} (go/func tzsetNum "tzsetNum parses a number from a tzset string.\nIt returns the number, and the remainder of the string, and reports success.\nThe number must be between min and max.\n" [^string s ^int min ^int max] :results [^int num ^string rest ^bool ok]

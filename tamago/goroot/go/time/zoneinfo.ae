        (let [^int jday (zero int)]
          (set! (values jday s ok) (tzsetNum (subslice s 1) 1 365))
          (when (not ok)
            (return (lit rule) "" false))

          (set! (.-kind r) ruleJulian)
          (set! (.-day r) jday))
        (== (aget s 0) \M)
        (let [^int mon (zero int)]
          (set! (values mon s ok) (tzsetNum (subslice s 1) 1 12))
          (when (or (not ok) (== (len s) 0) (!= (aget s 0) \.))
            (return (lit rule) "" false))


          (let [^int week (zero int)]
            (set! (values week s ok) (tzsetNum (subslice s 1) 1 5))
            (when (or (not ok) (== (len s) 0) (!= (aget s 0) \.))
              (return (lit rule) "" false))

            (let [^int day (zero int)]
              (set! (values day s ok) (tzsetNum (subslice s 1) 0 6))
              (when (not ok)
                (return (lit rule) "" false))

              (set! (.-kind r) ruleMonthWeekDay)
              (set! (.-day r) day)
              (set! (.-week r) week)

      (return 0 "" false)))


  (when (< num min)
    (return 0 "" false))

  (return num "" true))





^{:go/end 604} (go/func tzruleTime "tzruleTime takes a year, a rule, and a timezone offset,\nand returns the number of seconds since the start of the year\nthat the rule takes effect.\n" ^int [^int year ^rule r ^int off]

            (return offset true))))))




  ;; Otherwise fall back to an ordinary name match.
  (range [i (.-zone l)]
    (let [zone (addr (aget (.-zone l) i))]
      (when (== (.-name zone) name)
        (return (.-offset zone) true))))



  ;; Otherwise, give up.
  (return))



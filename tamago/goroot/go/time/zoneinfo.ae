              (set! hi m))

            (set! lo m))))


      (let [zone (addr (aget (.-zone l) (.-index (aget tx lo))))]
        (set! name (.-name zone))
        (set! offset (.-offset zone))
        (set! start (.-when (aget tx lo)))

^{:go/end 35} (go/func when "when is a helper function for setting the 'when' field of a runtimeTimer.\nIt returns what the time will be, in nanoseconds, Duration d in the future.\nIf d is negative, it is ignored. If the returned value would be less than\nzero because of an overflow, MaxInt64 is returned.\n" ^int64 [^Duration d]
  (when (<= d 0)
    (return (runtimeNano)))

  (let [t (+ (runtimeNano) (conv int64 d))]
    (when (< t 0)
      ;; N.B. runtimeNano() and d are always positive, so addition
      ;; (including overflow) will never result in t == 0.
      (set! t (- (<< 1 63) 1))) ; math.MaxInt64

    ^{:line 34} t))



  ^{:line 116} [^{:val "Monday, 02-Jan-06 15:04:05 MST"} RFC850 "Monday, 02-Jan-06 15:04:05 MST"]
  ^{:line 117} [^{:val "Mon, 02 Jan 2006 15:04:05 MST"} RFC1123 "Mon, 02 Jan 2006 15:04:05 MST"]
  ^{:line 118} [^{:val "Mon, 02 Jan 2006 15:04:05 -0700"} RFC1123Z "Mon, 02 Jan 2006 15:04:05 -0700"] ; RFC1123 with numeric zone
  ^{:line 119} [^{:val "2006-01-02T15:04:05Z07:00"} RFC3339 "2006-01-02T15:04:05Z07:00"]
  ^{:line 120} [^{:val "2006-01-02T15:04:05.999999999Z07:00"} RFC3339Nano "2006-01-02T15:04:05.999999999Z07:00"]
  ^{:line 121} [^{:val "3:04PM"} Kitchen "3:04PM"]

  ^{:line 123} [^{:val "Jan _2 15:04:05" :doc "Handy time stamps.\n"} Stamp "Jan _2 15:04:05"]
  ^{:line 124} [^{:val "Jan _2 15:04:05.000"} StampMilli "Jan _2 15:04:05.000"]
  ^{:line 125} [^{:val "Jan _2 15:04:05.000000"} StampMicro "Jan _2 15:04:05.000000"]
  ^{:line 126} [^{:val "Jan _2 15:04:05.000000000"} StampNano "Jan _2 15:04:05.000000000"]
  ^{:line 127} [^{:val "2006-01-02 15:04:05"} DateTime "2006-01-02 15:04:05"]
  ^{:line 128} [^{:val "2006-01-02"} DateOnly "2006-01-02"]
  ^{:line 129} [^{:val "15:04:05"} TimeOnly "15:04:05"])



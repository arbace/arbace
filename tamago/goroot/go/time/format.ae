        (break))

      (when [c (aget value nUpper)] (or (< c \A) (< \Z c))
        (break)))


    (switch nUpper
      (case [0 1 2 6]
        (return 0 false))
      (case [5] ; Must end in T to match.
        (when (== (aget value 4) \T)
          (return 5 true)))

      (case [4]
        ;; Must end in T, except one special case.
        (when (or (== (aget value 3) \T) (== (subslice value _ 4) "WITA"))
          (return 4 true)))

      (case [3]
        (return 3 true)))

    (return 0 false)))






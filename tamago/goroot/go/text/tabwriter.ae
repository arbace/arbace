(ns go.text.tabwriter
  (:require [arbace.go :as go]))

(go/package tabwriter
  :path "text/tabwriter"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["tabwriter.go"]
  :init-order [newline tabs vbar hbar]
  :positions :lines)

(load "tabwriter/tabwriter")

    (set! ^{:go/via [Position]} (.-Offset s) (+ (.-srcBufOffset s) (.-tokPos s)))
    (if (> (.-column s) 0) (do
        ;; common case: last character was not a '\n'
        (set! ^{:go/via [Position]} (.-Line s) (.-line s))
        (set! ^{:go/via [Position]} (.-Column s) (.-column s)))
      (do
        ;; last character was a '\n'
        ;; (we cannot be at the beginning of the source
        ;; since we have called next() at least once)
        (set! ^{:go/via [Position]} (.-Line s) (- (.-line s) 1))
        (set! ^{:go/via [Position]} (.-Column s) (.-lastLineLen s))))


    ;; determine token value
    (let [tok ch]
      (switch
        (case [(.isIdentRune s ch 0)]
          (if (!= (bit-and (.-Mode s) ScanIdents) 0) (do
              (set! tok Ident)
              (set! ch (.scanIdentifier s)))

            (set! ch (.next s))))

        (case [(isDecimal ch)]
          (if (!= (bit-and (.-Mode s) (bit-or ScanInts ScanFloats)) 0)
            (set! (values tok ch) (.scanNumber s ch false))

            (set! ch (.next s))))

        (default
          (switch ch
            (case [EOF]
              (break))
            (case [\"]
              (when (!= (bit-and (.-Mode s) ScanStrings) 0)
                (.scanString s \")
                (set! tok String))

              (set! ch (.next s)))
            (case [\']
              (when (!= (bit-and (.-Mode s) ScanChars) 0)
                (.scanChar s)
                (set! tok Char))

              (set! ch (.next s)))
            (case [\.]
              (set! ch (.next s))
              (when (and (isDecimal ch) (!= (bit-and (.-Mode s) ScanFloats) 0))
                (set! (values tok ch) (.scanNumber s ch true))))

            (case [\/]
              (set! ch (.next s))
              (when (and ^:go/paren (or (== ch \/) (== ch \*)) (!= (bit-and (.-Mode s) ScanComments) 0))
                (when (!= (bit-and (.-Mode s) SkipComments) 0)
                  (set! (.-tokPos s) -1) ; don't collect token text
                  (set! ch (.scanComment s ch))
                  (goto :redo))

                (set! ch (.scanComment s ch))
                (set! tok Comment)))

            (case [\`]
              (when (!= (bit-and (.-Mode s) ScanRawStrings) 0)
                (.scanRawString s)
                (set! tok RawString))

              (set! ch (.next s)))
            (default
              (set! ch (.next s))))))



      ;; end of token text
      (set! (.-tokEnd s) (- (.-srcPos s) (.-lastCharLen s)))

      (set! (.-ch s) ch)
      ^{:line 741} tok)))






^{:go/end 766} (go/method Pos "Pos returns the position of the character immediately after\nthe character or token returned by the last call to [Scanner.Next] or [Scanner.Scan].\nUse the [Scanner.Position] field for the start position of the most\nrecently scanned token.\n" [^{:tag (* Scanner)} s] :results [^Position pos]
  (set! (.-Filename pos) ^{:go/via [Position]} (.-Filename s))
  (set! (.-Offset pos) (- (+ (.-srcBufOffset s) (.-srcPos s)) (.-lastCharLen s)))
  (switch
    (case [(> (.-column s) 0)]
      ;; common case: last character was not a '\n'
      (set! (.-Line pos) (.-line s))
      (set! (.-Column pos) (.-column s)))
    (case [(> (.-lastLineLen s) 0)]
      ;; last character was a '\n'
      (set! (.-Line pos) (- (.-line s) 1))
      (set! (.-Column pos) (.-lastLineLen s)))
    (default
      ;; at the beginning of the source
      (set! (.-Line pos) 1)
      (set! (.-Column pos) 1)))

  (return))




^{:go/end 792} (go/method TokenText "TokenText returns the string corresponding to the most recently scanned token.\nValid after calling [Scanner.Scan] and in calls of [Scanner.Error].\n" ^string [^{:tag (* Scanner)} s]
  (when (< (.-tokPos s) 0)
    ;; no token text
    (return ""))


  (when (< (.-tokEnd s) (.-tokPos s))
    ;; if EOF was reached, s.tokEnd is set to -1 (s.srcPos == 0)
    (set! (.-tokEnd s) (.-tokPos s)))

  ;; s.tokEnd >= s.tokPos

  (when (== (.Len (.-tokBuf s)) 0)
    ;; common case: the entire token text is still in srcBuf
    (return (conv string (subslice (.-srcBuf s) (.-tokPos s) (.-tokEnd s)))))


  ;; part of the token text was saved in tokBuf: save the rest in
  ;; tokBuf as well and return its content
  (.Write (.-tokBuf s) (subslice (.-srcBuf s) (.-tokPos s) (.-tokEnd s)))
  (set! (.-tokPos s) (.-tokEnd s)) ; ensure idempotency of TokenText() call
  (.String (.-tokBuf s)))

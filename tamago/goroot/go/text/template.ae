(ns go.text.template
  (:require [arbace.go :as go]))

(go/package template
  :path "text/template"
  :files ["doc.go" "exec.go" "funcs.go" "helper.go" "option.go" "template.go"]
  :positions :lines)

(load "template/doc")
(load "template/exec")
(load "template/funcs")
(load "template/helper")
(load "template/option")
(load "template/template")

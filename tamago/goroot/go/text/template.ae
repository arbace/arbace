(ns go.text.template
  (:require [arbace.go :as go]))

(go/package template
  :path "text/template"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["doc.go" "exec.go" "funcs.go" "helper.go" "option.go" "template.go"]
  :init-order [maxExecDepth missingVal missingValReflectType walkBreak walkContinue errorType fmtStringerType reflectValueType errBadComparisonType errNoComparison htmlQuot htmlApos htmlAmp htmlLt htmlGt htmlNull jsLowUni hex jsBackslash jsApos jsQuot jsLt jsGt jsAmp jsEq builtinFuncs]
  :positions :lines)

(load "template/doc")
(load "template/exec")
(load "template/funcs")
(load "template/helper")
(load "template/option")
(load "template/template")

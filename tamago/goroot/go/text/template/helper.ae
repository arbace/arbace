;; Helper functions to make constructing templates easier.

(in-ns 'go.text.template) (go/file "helper.go" :imports [


    ^{:line 10} [fmt "fmt"]
    ^{:line 11} [fs "io/fs"]
    ^{:line 12} [os "os"]
    ^{:line 13} [path "path"]
    ^{:line 14} [filepath "path/filepath"]])


;; Functions and methods to parse templates.






^{:go/end 29} (go/func Must "Must is a helper that wraps a call to a function returning ([*Template], error)\nand panics if the error is non-nil. It is intended for use in variable\ninitializations such as\n\n\tvar t = template.Must(template.New(\"name\").Parse(\"text\"))\n" ^{:tag (* Template)} [^{:tag (* Template)} t ^error err]
  (when (!= err nil)
    (panic err))

  ^{:line 28} t)











^{:go/end 42} (go/func ParseFiles "ParseFiles creates a new [Template] and parses the template definitions from\nthe named files. The returned template's name will have the base name and\nparsed contents of the first file. There must be at least one file.\nIf an error occurs, parsing stops and the returned *Template is nil.\n\nWhen parsing multiple files with the same name in different directories,\nthe last one mentioned will be the one that results.\nFor instance, ParseFiles(\"a/foo\", \"b/foo\") stores \"b/foo\" as the template\nnamed \"foo\", while \"a/foo\" is unavailable.\n" [& ^{:tag (slice string)} filenames] :results [(* Template) error]
  (parseFiles nil readFileOS (spread filenames)))













^{:go/end 58} (go/method ParseFiles "ParseFiles parses the named files and associates the resulting templates with\nt. If an error occurs, parsing stops and the returned template is nil;\notherwise it is t. There must be at least one file.\nSince the templates created by ParseFiles are named by the base\n(see [filepath.Base]) names of the argument files, t should usually have the\nname of one of the (base) names of the files. If it does not, depending on\nt's contents before calling ParseFiles, t.Execute may fail. In that\ncase use t.ExecuteTemplate to execute a valid template.\n\nWhen parsing multiple files with the same name in different directories,\nthe last one mentioned will be the one that results.\n" [^{:tag (* Template)} t & ^{:tag (slice string)} filenames] :results [(* Template) error]
  (.init t)
  (parseFiles t readFileOS (spread filenames)))




^{:go/end 94} (go/func parseFiles "parseFiles is the helper for the method and function. If the argument\ntemplate is nil, it is created from the first file.\n" [^{:tag (* Template)} t ^{:tag (func [string] [string (slice byte) error])} readFile & ^{:tag (slice string)} filenames] :results [(* Template) error]
  (when (== (len filenames) 0)
    ;; Not really a problem, but be consistent.
    (return nil (fmt/Errorf "template: no files named in call to ParseFiles")))

  (range [_ filename filenames]
    (let [(values name b err) (readFile filename)]
      (when (!= err nil)
        (return nil err))

      (let [s (conv string b)
          ;; First template becomes return value if not already defined,
          ;; and we use that one for subsequent New calls to associate
          ;; all the templates together. Also, if this file has the same name
          ;; as t, this file becomes the contents of t, so
          ;;  t, err := New(name).Funcs(xxx).ParseFiles(name)
          ;; works. Otherwise we create a new template associated with t.
          ^{:line 79 :tag (* Template)} tmpl (zero (* Template))]
        (when (== t nil)
          (set! t (New name)))

        (if (== name (.Name t))
          (set! tmpl t)

          (set! tmpl (.New t name)))

        (set! (values _ err) (.Parse tmpl s))
        (when (!= err nil)
          (return nil err)))))


  (return t nil))











^{:go/end 107} (go/func ParseGlob "ParseGlob creates a new [Template] and parses the template definitions from\nthe files identified by the pattern. The files are matched according to the\nsemantics of [filepath.Match], and the pattern must match at least one file.\nThe returned template will have the [filepath.Base] name and (parsed)\ncontents of the first file matched by the pattern. ParseGlob is equivalent to\ncalling [ParseFiles] with the list of files matched by the pattern.\n\nWhen parsing multiple files with the same name in different directories,\nthe last one mentioned will be the one that results.\n" [^string pattern] :results [(* Template) error]
  (parseGlob nil pattern))










^{:go/end 120} (go/method ParseGlob "ParseGlob parses the template definitions in the files identified by the\npattern and associates the resulting templates with t. The files are matched\naccording to the semantics of [filepath.Match], and the pattern must match at\nleast one file. ParseGlob is equivalent to calling [Template.ParseFiles] with\nthe list of files matched by the pattern.\n\nWhen parsing multiple files with the same name in different directories,\nthe last one mentioned will be the one that results.\n" [^{:tag (* Template)} t ^string pattern] :results [(* Template) error]
  (.init t)
  (parseGlob t pattern))



^{:go/end 132} (go/func parseGlob "parseGlob is the implementation of the function and method ParseGlob.\n" [^{:tag (* Template)} t ^string pattern] :results [(* Template) error]
  (let [(values filenames err) (filepath/Glob pattern)]
    (when (!= err nil)
      (return nil err))

    (when (== (len filenames) 0)
      (return nil (fmt/Errorf "template: pattern matches no files: %#q" pattern)))

    (parseFiles t readFileOS (spread filenames))))






^{:go/end 140} (go/func ParseFS "ParseFS is like [Template.ParseFiles] or [Template.ParseGlob] but reads from the file system fsys\ninstead of the host operating system's file system.\nIt accepts a list of glob patterns (see [path.Match]).\n(Note that most file names serve as glob patterns matching only themselves.)\n" [^fs/FS fsys & ^{:tag (slice string)} patterns] :results [(* Template) error]
  (parseFS nil fsys patterns))






^{:go/end 149} (go/method ParseFS "ParseFS is like [Template.ParseFiles] or [Template.ParseGlob] but reads from the file system fsys\ninstead of the host operating system's file system.\nIt accepts a list of glob patterns (see [path.Match]).\n(Note that most file names serve as glob patterns matching only themselves.)\n" [^{:tag (* Template)} t ^fs/FS fsys & ^{:tag (slice string)} patterns] :results [(* Template) error]
  (.init t)
  (parseFS t fsys patterns))


^{:go/end 164} (go/func parseFS [^{:tag (* Template)} t ^fs/FS fsys ^{:tag (slice string)} patterns] :results [(* Template) error]
  (let [^{:tag (slice string)} filenames (zero (slice string))]
    (range [_ pattern patterns]
      (let [(values list err) (fs/Glob fsys pattern)]
        (when (!= err nil)
          (return nil err))

        (when (== (len list) 0)
          (return nil (fmt/Errorf "template: pattern matches no files: %#q" pattern)))

        (set! filenames (append filenames (spread list)))))

    (parseFiles t (readFileFS fsys) (spread filenames))))


^{:go/end 170} (go/func readFileOS [^string file] :results [^string name ^{:tag (slice byte)} b ^error err]
  (set! name (filepath/Base file))
  (set! (values b err) (os/ReadFile file))
  (return))


^{:go/end 178} (go/func readFileFS ^{:tag (func [string] [string (slice byte) error])} [^fs/FS fsys]
  ^{:go/end 177} (fn [^string file] :results [^string name ^{:tag (slice byte)} b ^error err]
    (set! name (path/Base file))
    (set! (values b err) (fs/ReadFile fsys file))
    (return)))

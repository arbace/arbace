(ns go.text.template.parse
  (:require [arbace.go :as go]))

(go/package parse
  :path "text/template/parse"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["lex.go" "node.go" "parse.go"]
  :init-order [key textFormat maxStackDepth]
  :positions :lines)

(load "parse/lex")
(load "parse/node")
(load "parse/parse")

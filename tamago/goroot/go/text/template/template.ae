      (when (== k (.-name t))
        (aset ^{:go/via [common]} (.-tmpl nt) (.-name t) nt)
        (continue))

      ;; The associated templates share nt's common structure.
      (let [tmpl (.copy v (.-common nt))]
        (aset ^{:go/via [common]} (.-tmpl nt) k tmpl)))

    (.RLock ^{:go/via [common]} (.-muFuncs t))
    (defer (.RUnlock ^{:go/via [common]} (.-muFuncs t)))
    (^{:inst [FuncMap FuncMap string any]} maps/Copy ^{:go/via [common]} (.-parseFuncs nt) ^{:go/via [common]} (.-parseFuncs t))

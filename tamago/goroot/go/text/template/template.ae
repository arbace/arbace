^{:go/end 140} (go/method AddParseTree "AddParseTree associates the argument parse tree with the template t, giving\nit the specified name. If the template has not been defined, this tree becomes\nits definition. If it has been defined and already has that name, the existing\ndefinition is replaced; otherwise a new template is created, defined, and returned.\n" [^{:tag (* Template)} t ^string name ^{:tag (* parse/Tree)} tree] :results [(* Template) error]
  (.init t)
  (.Lock ^{:go/via [common]} (.-muTmpl t))
  (defer (.Unlock ^{:go/via [common]} (.-muTmpl t)))
  (let [nt t]
    (when (!= name (.-name t))
      (set! nt (.New t name)))

    ;; Even if nt == t, we need to install it in the common.tmpl map.
    (when (or (.associate t nt tree) (== (.-Tree nt) nil))
      (set! (.-Tree nt) tree))

    (return nt nil)))




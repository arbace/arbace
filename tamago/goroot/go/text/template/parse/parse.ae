      ^{:line 691} token (.nextNonSpace t)
      ^{:line 692} name (.parseTemplateName t token context)
      ^{:line 693 :tag (* PipeNode)} pipe (zero (* PipeNode))]
    (when (!= (.-typ (.nextNonSpace t)) itemRightDelim)
      (.backup t)
      ;; Do not pop variables; they persist until "end".
      (set! pipe (.pipeline t context itemRightDelim)))

    (.newTemplate t (.-pos token) (.-line token) name pipe)))


^{:go/end 714} (go/method parseTemplateName [^{:tag (* Tree)} t ^item token ^string context] :results [^string name]
  (switch (.-typ token)
    (case [itemString itemRawString]
      (let [(values s err) (strconv/Unquote (.-val token))]
        (when (!= err nil)
          (.error t err))

        (set! name s)))
    (default
      (.unexpected t token context)))

  (return))








^{:go/end 746} (go/method command "command:\n\n\toperand (space operand)*\n\nspace-separated arguments up to a pipeline character or right delimiter.\nwe consume the pipe character but leave the right delim to terminate the action.\n" ^{:tag (* CommandNode)} [^{:tag (* Tree)} t]
  (let [cmd (.newCommand t (.-pos (.peekNonSpace t)))]

^{:go/breaks [[5 847]] :go/end 848} (go/method hasFunction "hasFunction reports if a function name exists in the Tree's maps.\n" ^bool [^{:tag (* Tree)} t ^string name]
  (range [_ funcMap (.-funcs t)]
    (when (== funcMap nil)
      (continue))

    (when (!= (aget funcMap name) nil)
      (return true)))


  false)



^{:go/end 853} (go/method popVars "popVars trims the variable list to the specified length\n" [^{:tag (* Tree)} t ^int n]

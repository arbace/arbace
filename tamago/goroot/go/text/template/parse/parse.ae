    ^{:line 745} cmd))









^{:go/end 782} (go/method operand "operand:\n\n\tterm .Field*\n\nAn operand is a space-separated component of a command,\na term possibly followed by field accesses.\nA nil return means the next item is not an operand.\n" ^Node [^{:tag (* Tree)} t]
  (let [node (.term t)]
    (when (== node nil)
      (return nil))

    (when (== (.-typ (.peek t)) itemField)
      (let [chain (.newChain t (.-pos (.peek t)) node)]
        (while (== (.-typ (.peek t)) itemField)
          (.Add chain (.-val (.next t))))

        ;; Compatibility with original API: If the term is of type NodeField
        ;; or NodeVariable, just put more fields on the original.
        ;; Otherwise, keep the Chain node.
        ;; Obvious parsing errors involving literal values are detected here.
        ;; More complex error cases will have to be handled at execution time.
        (switch (.Type node)
          (case [NodeField]
            (set! node (.newField t ^{:go/via [Pos]} (.Position chain) (.String chain))))
          (case [NodeVariable]
            (set! node (.newVariable t ^{:go/via [Pos]} (.Position chain) (.String chain))))
          (case [NodeBool NodeString NodeNumber NodeNil NodeDot]
            (.errorf t "unexpected . after term %q" (.String node)))
          (default
            (set! node chain)))))


    ^{:line 781} node))













^{:go/breaks [6] :go/end 835} (go/method term "term:\n\n\tliteral (number, string, nil, boolean)\n\tfunction (identifier)\n\t.\n\t.Field\n\t$\n\t'(' pipeline ')'\n\nA term is a simple \"expression\".\nA nil return means the next item is not a term.\n" ^Node [^{:tag (* Tree)} t]

          (break :Loop)))))


  (.emit l itemString))



^{:go/end 669} (go/func lexRawQuote "lexRawQuote scans a raw quoted string.\n" ^stateFn [^{:tag (* lexer)} l]
  (label :Loop
    (while true
      (switch (.next l)
        (case [eof]
          (return (.errorf l "unterminated raw quoted string")))
        (case [\`]
          (break :Loop)))))


  (.emit l itemRawString))



^{:go/end 674} (go/func isSpace "isSpace reports whether r is a space character.\n" ^bool [^rune r]
  (or (== r \space) (== r \tab) (== r \return) (== r \newline)))



^{:go/end 679} (go/func isAlphaNumeric "isAlphaNumeric reports whether r is an alphabetic, digit, or underscore.\n" ^bool [^rune r]
  (or (== r \_) (unicode/IsLetter r) (unicode/IsDigit r)))


^{:go/end 683} (go/func hasLeftTrimMarker ^bool [^string s]
  (and (>= (len s) 2) (== (aget s 0) trimMarker) (isSpace (conv rune (aget s 1)))))


^{:go/end 687} (go/func hasRightTrimMarker ^bool [^string s]
  (and (>= (len s) 2) (isSpace (conv rune (aget s 0))) (== (aget s 1) trimMarker)))

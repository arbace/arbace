^{:go/end 717} (go/method newNumber [^{:tag (* Tree)} t ^Pos pos ^string text ^itemType typ] :results [(* NumberNode) error]
  (let [n (addr (lit NumberNode :tr t :NodeType NodeNumber :Pos pos :Text text))]
    (switch typ
      (case [itemCharConstant]
        (let [(values rune _ tail err) (strconv/UnquoteChar (subslice text 1) (aget text 0))]
          (when (!= err nil)
            (return nil err))

          (when (!= tail "'")
            (return nil (fmt/Errorf "malformed character constant: %s" text)))

          (set! (.-Int64 n) (conv int64 rune))
          (set! (.-IsInt n) true)
          (set! (.-Uint64 n) (conv uint64 rune))
          (set! (.-IsUint n) true)
          (set! (.-Float64 n) (conv float64 rune)) ; odd but those are the rules.
          (set! (.-IsFloat n) true)
          (return n nil)))
      (case [itemComplex]
        ;; fmt.Sscan can parse the pair, so let it do the work.
        (when [(values _ err) (fmt/Sscan text (addr (.-Complex128 n)))] (!= err nil)
          (return nil err))

        (set! (.-IsComplex n) true)
        (.simplifyComplex n)
        (return n nil)))

    ;; Imaginary constants can only be complex unless they are zero.
    (when (and (> (len text) 0) (== (aget text (- (len text) 1)) \i))

        (set! (.-Uint64 n) u))

      (let [(values i ^:assign err) (strconv/ParseInt text 0 64)]
        (when (== err nil)
          (set! (.-IsInt n) true)
          (set! (.-Int64 n) i)
          (when (== i 0)
            (set! (.-IsUint n) true) ; in case of -0.
            (set! (.-Uint64 n) u)))


        ;; If an integer extraction succeeded, promote the float.
        (cond (.-IsInt n) (do
            (set! (.-IsFloat n) true)
            (set! (.-Float64 n) (conv float64 (.-Int64 n))))
          (.-IsUint n) (do
            (set! (.-IsFloat n) true)
            (set! (.-Float64 n) (conv float64 (.-Uint64 n)))) :else

          (let [(values f err) (strconv/ParseFloat text 64)]

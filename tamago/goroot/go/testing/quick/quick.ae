    (when (not ok)
      (return (conv SetupError "argument is not a function")))


    (when (!= (.NumOut fType) 1)
      (return (conv SetupError "function does not return one value")))

    (when (!= (.Kind (.Out fType 0)) reflect/Bool)
      (return (conv SetupError "function does not return a bool")))


    ^{:go/breaks [[3 295]]} (let [arguments (make (slice reflect/Value) (.NumIn fType))
        ^{:line 281} rand (.getRand config)
        ^{:line 282} maxCount (.getMaxCount config)]


(ns go.testing.fstest
  (:require [arbace.go :as go]))

(go/package fstest
  :path "testing/fstest"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["mapfs.go" "testfs.go"]
  :init-order [["mapfs.go" 43 5] ["mapfs.go" 44 5] ["mapfs.go" 45 5]]
  :positions :lines)

(load "fstest/mapfs")
(load "fstest/testfs")

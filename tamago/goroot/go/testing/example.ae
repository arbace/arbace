(in-ns 'go.testing) (go/file "example.go" :imports [


    ^{:line 8} [fmt "fmt"]
    ^{:line 9} [runtime "runtime"]
    ^{:line 10} [slices "slices"]
    ^{:line 11} [strings "strings"]
    ^{:line 12} [time "time"]])


(go/type InternalExample (struct
    ^{:line 16 :tag string} Name
    ^{:line 17 :tag (func [])} F
    ^{:line 18 :tag string} Output
    ^{:line 19 :tag bool} Unordered))




^{:go/end 27} (go/func RunExamples "RunExamples is an internal function but exported because it is cross-package;\nit is part of the implementation of the \"go test\" command.\n" [^{:tag (func [^string pat ^string str] [bool error])} matchString ^{:tag (slice InternalExample)} examples] :results [^bool ok]
  (set! (values _ ok) (runExamples matchString examples))
  ^{:line 26} ok)


^{:go/end 47} (go/func runExamples [^{:tag (func [^string pat ^string str] [bool error])} matchString ^{:tag (slice InternalExample)} examples] :results [^bool ran ^bool ok]
  (set! ok true)

  (let [m (newMatcher matchString @match "-test.run" @skip)

      ^{:line 34 :tag InternalExample} eg (zero InternalExample)]
    ^:assign (range [_ eg examples]
      (let [(values _ matched _) (.fullName m nil (.-Name eg))]
        (when (not matched)
          (continue))

        (set! ran true)
        (when (not (runExample eg))
          (set! ok false))))



    (return ran ok)))











^{:go/end 98} (go/method processRunResult "processRunResult computes a summary and status of the result of running an example test.\nstdout is the captured output from stdout of the test.\nrecovered is the result of invoking recover after running the test, in case it panicked.\n\nIf stdout doesn't match the expected output or if recovered is non-nil, it'll print the cause of failure to stdout.\nIf the test is chatty/verbose, it'll print a success message to stdout.\nIf recovered is non-nil, it'll panic with that value.\nIf the test panicked with nil, or invoked runtime.Goexit, it'll be\nmade to fail and panic with errNilPanicOrGoexit\n" [^{:tag (* InternalExample)} eg ^string stdout ^time/Duration timeSpent ^bool finished ^any recovered] :results [^bool passed]
  (set! passed true)
  (let [dstr (fmtDuration timeSpent)
      ^{:line 61 :tag string} fail (zero string)
      ^{:line 62} got (strings/TrimSpace stdout)
      ^{:line 63} want (strings/TrimSpace (.-Output eg))]
    (when (== runtime/GOOS "windows")
      (set! got (strings/ReplaceAll got "\r\n" "\n"))
      (set! want (strings/ReplaceAll want "\r\n" "\n")))

    (if (.-Unordered eg)
      (let [gotLines (^{:inst [string]} slices/Sorted (strings/SplitSeq got "\n"))
          ^{:line 70} wantLines (^{:inst [string]} slices/Sorted (strings/SplitSeq want "\n"))]
        (when (and (not (^{:inst [(slice string) string]} slices/Equal gotLines wantLines)) (== recovered nil))
          (set! fail (fmt/Sprintf "got:\n%s\nwant (unordered):\n%s\n" stdout (.-Output eg)))))

      (do
        (when (and (!= got want) (== recovered nil))
          (set! fail (fmt/Sprintf "got:\n%s\nwant:\n%s\n" got want)))))


    (cond (or (!= fail "") (not finished) (!= recovered nil)) (do
        (fmt/Printf "%s--- FAIL: %s (%s)\n%s" (.prefix chatty) (.-Name eg) dstr fail)
        (set! passed false))
      (.-on chatty)
      (fmt/Printf "%s--- PASS: %s (%s)\n" (.prefix chatty) (.-Name eg) dstr))


    (when (and (.-on chatty) (.-json chatty))
      (fmt/Printf "%s=== NAME   %s\n" (.prefix chatty) ""))


    (cond (!= recovered nil)
      ;; Propagate the previously recovered result, by panicking.
      (panic recovered)
      (not finished)
      (panic errNilPanicOrGoexit))


    (return)))

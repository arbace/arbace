;; Support for test coverage.

(in-ns 'go.testing) (go/file "cover.go" :imports [])







(go/type CoverBlock "CoverBlock records the coverage data for a single basic block.\nThe fields are 1-indexed, as in an editor: The opening line of\nthe file is number 1, for example. Columns are measured\nin bytes.\nNOTE: This struct is internal to the testing infrastructure and may change.\nIt is not covered (yet) by the Go 1 compatibility guidelines.\n" (struct
    ^{:line 16 :tag uint32} Line0 ; Line number for block start.
    ^{:line 17 :tag uint16} Col0 ; Column number for block start.
    ^{:line 18 :tag uint32} Line1 ; Line number for block end.
    ^{:line 19 :tag uint16} Col1 ; Column number for block end.
    ^{:line 20 :tag uint16} Stmts)) ; Number of statements included in this block.





(go/type Cover "Cover records information about test coverage checking.\nNOTE: This struct is internal to the testing infrastructure and may change.\nIt is not covered (yet) by the Go 1 compatibility guidelines.\n" (struct
    ^{:line 27 :tag string} Mode
    ^{:line 28 :tag (map string (slice uint32))} Counters
    ^{:line 29 :tag (map string (slice CoverBlock))} Blocks
    ^{:line 30 :tag string} CoveredPackages))





^{:go/end 37} (go/func RegisterCover "RegisterCover records the coverage data accumulators for the tests.\nNOTE: This function is internal to the testing infrastructure and may change.\nIt is not covered (yet) by the Go 1 compatibility guidelines.\n" [^Cover c])

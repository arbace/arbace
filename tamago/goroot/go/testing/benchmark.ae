^{:go/end 662} (go/func prettyPrint [^io/Writer w ^float64 x ^string unit]
  ;; Print all numbers with 10 places before the decimal point
  ;; and small numbers with four sig figs. Field widths are
  ;; chosen to fit the whole part in 10 places while aligning
  ;; the decimal point of all fractional formats.
  (let [^string format (zero string)]
    (switch [y (math/Abs x)]
      (case [(or (== y 0) (>= y 999.95))]
        (set! format "%10.0f %s"))
      (case [(>= y 99.995)]
        (set! format "%12.1f %s"))
      (case [(>= y 9.9995)]
        (set! format "%13.2f %s"))
      (case [(>= y 0.99995)]
        (set! format "%14.3f %s"))
      (case [(>= y 0.099995)]
        (set! format "%15.4f %s"))
      (case [(>= y 0.0099995)]
        (set! format "%16.5f %s"))
      (case [(>= y 9.9995E-4)]
        (set! format "%17.6f %s"))
      (default
        (set! format "%18.7f %s")))

    (fmt/Fprintf w format x unit)))




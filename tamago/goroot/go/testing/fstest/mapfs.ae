^{:go/end 311} (go/method ReadAt [^{:tag (* openMapFile)} f ^{:tag (slice byte)} b ^int64 offset] :results [int error]
  (when (or (< offset 0) (> offset (conv int64 (len (.-Data ^{:go/via [mapFileInfo]} (.-f f))))))
    (return 0 (addr (lit fs/PathError :Op "read" :Path (.-path f) :Err fs/ErrInvalid))))


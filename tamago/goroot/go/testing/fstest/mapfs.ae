(go/type MapFS "A MapFS is a simple in-memory file system for use in tests,\nrepresented as a map from path names (arguments to Open)\nto information about the files, directories, or symbolic links they represent.\n\nThe map need not include parent directories for files contained\nin the map; those will be synthesized if needed.\nBut a directory can still be included by setting the [MapFile.Mode]'s [fs.ModeDir] bit;\nthis may be necessary for detailed control over the directory's [fs.FileInfo]\nor to create an empty directory.\n\nFile system operations read directly from the map,\nso that the file system can be changed by editing the map as needed.\nAn implication is that file system operations must not run concurrently\nwith changes to the map, which would be a race.\nAnother implication is that opening or reading a directory requires\niterating over the entire map, so a MapFS should typically be used with not more\nthan a few hundred entries or directory reads.\n" (map string (* MapFile)))


(go/type MapFile "A MapFile describes a single file in a [MapFS].\n" (struct
    ^{:line 37 :tag (slice byte)} Data ; file content or symlink destination
    ^{:line 38 :tag fs/FileMode} Mode ; fs.FileInfo.Mode
    ^{:line 39 :tag time/Time} ModTime ; fs.FileInfo.ModTime
    ^{:line 40 :tag any} Sys)) ; fs.FileInfo.Sys


(go/var ^fs/FS _ (conv MapFS nil))
(go/var ^fs/ReadLinkFS _ (conv MapFS nil))
(go/var ^fs/File _ (conv (* openMapFile) nil))


^{:go/end 120} (go/method Open "Open opens the named file after following any symbolic links.\n" [^MapFS fsys ^string name] :results [fs/File error]
  (when (not (fs/ValidPath name))
    (return nil (addr (lit fs/PathError :Op "open" :Path name :Err fs/ErrNotExist))))

  (let [(values realName ok) (.resolveSymlinks fsys name)]
    (when (not ok)
      (return nil (addr (lit fs/PathError :Op "open" :Path name :Err fs/ErrNotExist))))


    (let [file (aget fsys realName)]
      (when (and (!= file nil) (== (bit-and (.-Mode file) fs/ModeDir) 0))
        ;; Ordinary file
        (return (addr (lit openMapFile name (lit mapFileInfo (path/Base name) file) 0)) nil))


      ;; Directory, possibly synthesized.
      ;; Note that file can be nil here: the map need not contain explicit parent directories for all its files.
      ;; But file can also be non-nil, in case the user wants to set metadata for the directory explicitly.
      ;; Either way, we need to construct the list of children of this directory.
      (let [^{:tag (slice mapFileInfo)} list (zero (slice mapFileInfo))
          ^:var ^{:line 68} need (make (map string bool))]
        (if (== realName ".")
          (range [fname f fsys]
            (let [i (strings/Index fname "/")]
              (if (< i 0)
                (when (!= fname ".")
                  (set! list (append list (lit mapFileInfo fname f))))


                (aset need (subslice fname _ i) true))))



          (let [prefix (+ realName "/")]
            (range [fname f fsys]
              (when (strings/HasPrefix fname prefix)
                (let [felem (subslice fname (len prefix))
                    ^{:line 85} i (strings/Index felem "/")]
                  (if (< i 0)
                    (set! list (append list (lit mapFileInfo felem f)))

                    (aset need (subslice fname (len prefix) (+ (len prefix) i)) true)))))



            ;; If the directory name is not in the map,
            ;; and there are no children of the name in the map,
            ;; then the directory is treated as not existing.
            (when (and (== file nil) (== list nil) (== (len need) 0))
              (return nil (addr (lit fs/PathError :Op "open" :Path name :Err fs/ErrNotExist))))))


        (range [_ fi list]
          (delete need (.-name fi)))

        (range [name need]
          (set! list (append list (lit mapFileInfo name (addr (lit MapFile :Mode (bit-or fs/ModeDir 0555)))))))

        (^{:inst [(slice mapFileInfo) mapFileInfo]} slices/SortFunc list ^{:go/end 108} (fn ^int [^mapFileInfo a ^mapFileInfo b]
            (strings/Compare (.-name a) (.-name b))))


        (when (== file nil)
          (set! file (addr (lit MapFile :Mode (bit-or fs/ModeDir 0555)))))

        (let [^string elem (zero string)]
          (if (== name ".")
            (set! elem ".")

            (set! elem (subslice name (+ (strings/LastIndex name "/") 1))))

          (return (addr (lit mapDir name (lit mapFileInfo elem file) list 0)) nil))))))


^{:go/end 153} (go/method resolveSymlinks [^MapFS fsys ^string name] :results [^string _ ^bool ok]
  ;; Fast path: if a symlink is in the map, resolve it.
  (when [file (aget fsys name)] (and (!= file nil) (== (.Type (.-Mode file)) fs/ModeSymlink))
    (let [target (conv string (.-Data file))]
      (when (path/IsAbs target)
        (return "" false))

      (return (.resolveSymlinks fsys (path/Join (path/Dir name) target)))))


  ;; Check if each parent directory (starting at root) is a symlink.
  (for [i 0] (< i (len name)) _
    (let [j (strings/Index (subslice name i) "/")
        ^{:line 135 :tag string} dir (zero string)]
      (if (< j 0) (do
          (set! dir name)
          (set! i (len name)))
        (do
          (set! dir (subslice name _ (+ i j)))
          (set! i + j)))

      (when [file (aget fsys dir)] (and (!= file nil) (== (.Type (.-Mode file)) fs/ModeSymlink))
        (let [target (conv string (.-Data file))]
          (when (path/IsAbs target)
            (return "" false))

          (return (.resolveSymlinks fsys (+ (path/Join (path/Dir dir) target) (subslice name i))))))

      (set! i + (len "/"))))

  (return name (fs/ValidPath name)))



^{:go/end 165} (go/method ReadLink "ReadLink returns the destination of the named symbolic link.\n" [^MapFS fsys ^string name] :results [string error]
  (let [(values info err) (.lstat fsys name)]
    (when (!= err nil)
      (return "" (addr (lit fs/PathError :Op "readlink" :Path name :Err err))))

    (when (!= (.Type (.-Mode (.-f info))) fs/ModeSymlink)
      (return "" (addr (lit fs/PathError :Op "readlink" :Path name :Err fs/ErrInvalid))))

    (return (conv string (.-Data (.-f info))) nil)))





^{:go/end 176} (go/method Lstat "Lstat returns a FileInfo describing the named file.\nIf the file is a symbolic link, the returned FileInfo describes the symbolic link.\nLstat makes no attempt to follow the link.\n" [^MapFS fsys ^string name] :results [fs/FileInfo error]
  (let [(values info err) (.lstat fsys name)]
    (when (!= err nil)
      (return nil (addr (lit fs/PathError :Op "lstat" :Path name :Err err))))

    (return info nil)))


^{:go/end 208} (go/method lstat [^MapFS fsys ^string name] :results [(* mapFileInfo) error]
  (when (not (fs/ValidPath name))
    (return nil fs/ErrNotExist))

  (let [(values realDir ok) (.resolveSymlinks fsys (path/Dir name))]
    (when (not ok)
      (return nil fs/ErrNotExist))

    (let [elem (path/Base name)
        ^{:line 187} realName (path/Join realDir elem)

        ^{:line 189} file (aget fsys realName)]
      (when (!= file nil)
        (return (addr (lit mapFileInfo elem file)) nil))


      (when (== realName ".")
        (return (addr (lit mapFileInfo elem (addr (lit MapFile :Mode (bit-or fs/ModeDir 0555))))) nil))

      ;; Maybe a directory.
      (let [prefix (+ realName "/")]
        (range [fname fsys]
          (when (strings/HasPrefix fname prefix)
            (return (addr (lit mapFileInfo elem (addr (lit MapFile :Mode (bit-or fs/ModeDir 0555))))) nil)))


        ;; If the directory name is not in the map,
        ;; and there are no children of the name in the map,
        ;; then the directory is treated as not existing.
        (return nil fs/ErrNotExist)))))








(go/type fsOnly "fsOnly is a wrapper that hides all but the fs.FS methods,\nto avoid an infinite recursion when implementing special\nmethods in terms of helpers that would use them.\n(In general, implementing these methods using the package fs helpers\nis redundant and unnecessary, but having the methods may make\nMapFS exercise more code paths when used in tests.)\n" (struct fs/FS))


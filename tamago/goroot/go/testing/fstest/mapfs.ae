^{:go/end 300} (go/method Seek [^{:tag (* openMapFile)} f ^int64 offset ^int whence] :results [int64 error]
  (switch whence
    (case [0])
    ;; offset += 0
    (case [1]
      (set! offset + (.-offset f)))
    (case [2]
      (set! offset + (conv int64 (len (.-Data ^{:go/via [mapFileInfo]} (.-f f)))))))

  (when (or (< offset 0) (> offset (conv int64 (len (.-Data ^{:go/via [mapFileInfo]} (.-f f))))))
    (return 0 (addr (lit fs/PathError :Op "seek" :Path (.-path f) :Err fs/ErrInvalid))))

  (set! (.-offset f) offset)

^{:go/end 284} (go/method Read [^{:tag (* openMapFile)} f ^{:tag (slice byte)} b] :results [int error]
  (when (>= (.-offset f) (conv int64 (len (.-Data ^{:go/via [mapFileInfo]} (.-f f)))))
    (return 0 io/EOF))

  (when (< (.-offset f) 0)
    (return 0 (addr (lit fs/PathError :Op "read" :Path (.-path f) :Err fs/ErrInvalid))))

  (let [n (copy b (subslice (.-Data ^{:go/via [mapFileInfo]} (.-f f)) (.-offset f)))]

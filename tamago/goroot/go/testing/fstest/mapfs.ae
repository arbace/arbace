^{:go/end 341} (go/method ReadDir [^{:tag (* mapDir)} d ^int count] :results [(slice fs/DirEntry) error]
  (let [n (- (len (.-entry d)) (.-offset d))]
    (when (and (== n 0) (> count 0))
      (return nil io/EOF))

    (when (and (> count 0) (> n count))
      (set! n count))

    (let [list (make (slice fs/DirEntry) n)]

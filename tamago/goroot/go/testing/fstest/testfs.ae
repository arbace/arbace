              (set! haveNot true)))


          (when (and have haveNot)
            (break))))


      (when (> c \z)
        (set! c \a))

      (set! glob + (+ "*" (conv string c) "*"))

      (let [^{:tag (slice string)} want (zero (slice string))]
        (range [_ d list]
          (when (strings/ContainsRune (.Name d) c)
            (set! want (append want (path/Join dir (.Name d))))))



        (let [(values names err) (.Glob (assert fs/GlobFS (.-fsys t)) glob)]

^{:go/breaks [[6 62]] :go/end 63} (go/func TestFS "TestFS tests a file system implementation.\nIt walks the entire tree of files in fsys,\nopening and checking that each file behaves correctly.\nSymbolic links are not followed,\nbut their Lstat values are checked\nif the file system implements [fs.ReadLinkFS].\nIt also checks that the file system contains at least the expected files.\nAs a special case, if no expected files are listed, fsys must be empty.\nOtherwise, fsys must contain at least the listed files; it can also contain others.\nThe contents of fsys must not change concurrently with TestFS.\n\nIf TestFS finds any misbehaviors, it returns either the first error or a\nlist of errors. Use [errors.Is] or [errors.AsType] to inspect.\n\nTypical usage inside a test is:\n\n\tif err := fstest.TestFS(myFS, \"file/that/should/be/present\"); err != nil {\n\t\tt.Fatal(err)\n\t}\n" ^error [^fs/FS fsys & ^{:tag (slice string)} expected]
  (when [err (testFS fsys (spread expected))] (!= err nil)
    (return err))

  (range [_ name expected]
    (when [i (strings/Index name "/")] (>= i 0)
      (let [(values dir dirSlash) (values (subslice name _ i) (subslice name _ (+ i 1)))
          ^{:line 46 :tag (slice string)} subExpected (zero (slice string))]
        (range [_ name expected]
          (when (strings/HasPrefix name dirSlash)
            (set! subExpected (append subExpected (subslice name (len dirSlash))))))


        (let [(values sub err) (fs/Sub fsys dir)]
          (when (!= err nil)
            (return err))

          (when [err (testFS sub (spread subExpected))] (!= err nil)
            (return (fmt/Errorf "testing fs.Sub(fsys, %s): %w" dir err)))

          (break))))) ; one sub-test is enough


  nil)


^{:go/end 93} (go/func testFS ^error [^fs/FS fsys & ^{:tag (slice string)} expected]
  (let [t (lit fsTester :fsys fsys)]
    (.checkDir t ".")
    (.checkOpen t ".")
    (let [found (make (map string bool))]
      (range [_ dir (.-dirs t)]
        (aset found dir true))

      (range [_ file (.-files t)]
        (aset found file true))

      (delete found ".")
      (when (and (== (len expected) 0) (> (len found) 0))
        (let [list (^{:inst [string]} slices/Sorted (^{:inst [(map string bool) string bool]} maps/Keys found))]
          (when (> (len list) 15)
            (set! list (append (subslice list _ 10) "...")))

          (.errorf t "expected empty file system but found files:\n%s" (strings/Join list "\n"))))

      (range [_ name expected]
        (when (not (aget found name))
          (.errorf t "expected but not found: %s" name)))


      (when (== (len (.-errors t)) 0)
        (return nil))

      (fmt/Errorf "TestFS found errors:\n%w" (errors/Join (spread (.-errors t)))))))




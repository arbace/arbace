^{:go/end 589} (go/method checkFile "checkFile checks that basic file reading works correctly.\n" [^{:tag (* fsTester)} t ^string file]
  (set! (.-files t) (append (.-files t) file))

  ;; Read entire file.
  (let [(values f err) (.Open (.-fsys t) file)]
    (when (!= err nil)
      (.errorf t "%s: Open: %w" file err)
      (return))


    (let [(values data ^:assign err) (io/ReadAll f)]
      (when (!= err nil)
        (.Close f)
        (.errorf t "%s: Open+ReadAll: %w" file err)
        (return))


      (when [err (.Close f)] (!= err nil)
        (.errorf t "%s: Close: %w" file err))


      ;; Check that closing twice doesn't crash.
      ;; The return value doesn't matter.
      (.Close f)

      ;; Check that ReadFile works if present.
      (when [(values fsys ok) (assert fs/ReadFileFS (.-fsys t))] ok
        (let [(values data2 err) (.ReadFile fsys file)]
          (when (!= err nil)
            (.errorf t "%s: fsys.ReadFile: %w" file err)
            (return))

          (.checkFileRead t file "ReadAll vs fsys.ReadFile" data data2)

          ;; Modify the data and check it again. Modifying the
          ;; returned byte slice should not affect the next call.
          (range [i data2]
            (inc! (aget data2 i)))

          (set! (values data2 err) (.ReadFile fsys file))
          (when (!= err nil)
            (.errorf t "%s: second call to fsys.ReadFile: %w" file err)
            (return))

          (.checkFileRead t file "Readall vs second fsys.ReadFile" data data2)

          (.checkBadPath t file "ReadFile"
            ^{:go/end 568} (fn ^error [^string name] (let [(values _ err) (.ReadFile fsys name)] err)))))


      ;; Check that fs.ReadFile works with t.fsys.
      (let [(values data2 ^:assign err) (fs/ReadFile (.-fsys t) file)]
        (when (!= err nil)
          (.errorf t "%s: fs.ReadFile: %w" file err)
          (return))

        (.checkFileRead t file "ReadAll vs fs.ReadFile" data data2)

        ;; Use iotest.TestReader to check small reads, Seek, ReadAt.
        (set! (values f err) (.Open (.-fsys t) file))
        (when (!= err nil)
          (.errorf t "%s: second Open: %w" file err)
          (return))

        (defer (.Close f))
        (when [err (iotest/TestReader f data)] (!= err nil)
          (.errorf t "%s: failed TestReader:\n\t%s" file (strings/ReplaceAll (.Error err) "\n" "\n\t")))))))




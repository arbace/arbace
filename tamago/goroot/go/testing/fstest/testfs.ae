      (return nil))

    (let [(values d ok) (assert fs/ReadDirFile f)]
      (when (not ok)
        (.Close f)
        (.errorf t "%s: Open returned File type %T, not a fs.ReadDirFile" dir f)
        (return nil))

      ^{:line 120} d)))




^{:go/end 273} (go/method checkDir "checkDir checks the directory dir, which is expected to exist\n(it is either the root or was found in a directory listing with IsDir true).\n" [^{:tag (* fsTester)} t ^string dir]
  ;; Read entire directory.
  (set! (.-dirs t) (append (.-dirs t) dir))
  (let [d (.openDir t dir)]
    (when (== d nil)
      (return))

    (let [(values list err) (.ReadDir d -1)]
      (when (!= err nil)
        (.Close d)
        (.errorf t "%s: ReadDir(-1): %w" dir err)
        (return))


      ;; Check all children.
      (let [^string prefix (zero string)]
        (if (== dir ".")
          (set! prefix "")

          (set! prefix (+ dir "/")))

        (range [_ info list]
          (let [name (.Name info)]
            (switch
              (case [(== name ".") (== name "..") (== name "")]
                (.errorf t "%s: ReadDir: child has invalid name: %#q" dir name)
                (continue))
              (case [(strings/Contains name "/")]
                (.errorf t "%s: ReadDir: child name contains slash: %#q" dir name)
                (continue))
              (case [(strings/Contains name "\\")]
                (.errorf t "%s: ReadDir: child name contains backslash: %#q" dir name)
                (continue)))

            (let [path (+ prefix name)]
              (.checkStat t path info)
              (.checkOpen t path)
              (switch (.Type info)
                (case [fs/ModeDir]
                  (.checkDir t path))
                (case [fs/ModeSymlink]
                  ;; No further processing.
                  ;; Avoid following symlinks to avoid potentially unbounded recursion.
                  (set! (.-files t) (append (.-files t) path)))
                (default
                  (.checkFile t path))))))



        ;; Check ReadDir(-1) at EOF.
        (let [(values list2 ^:assign err) (.ReadDir d -1)]
          (when (or (> (len list2) 0) (!= err nil))
            (.Close d)
            (.errorf t "%s: ReadDir(-1) at EOF = %d entries, %w, wanted 0 entries, nil" dir (len list2) err)
            (return))


          ;; Check ReadDir(1) at EOF (different results).
          (set! (values list2 err) (.ReadDir d 1))
          (when (or (> (len list2) 0) (!= err io/EOF))
            (.Close d)
            (.errorf t "%s: ReadDir(1) at EOF = %d entries, %w, wanted 0 entries, EOF" dir (len list2) err)
            (return))


          ;; Check that close does not report an error.
          (when [err (.Close d)] (!= err nil)
            (.errorf t "%s: Close: %w" dir err))


          ;; Check that closing twice doesn't crash.
          ;; The return value doesn't matter.
          (.Close d)

          ;; Reopen directory, read a second time, make sure contents match.
          (when [(set! d (.openDir t dir))] (== d nil)
            (return))

          (defer (.Close d))
          (set! (values list2 err) (.ReadDir d -1))
          (when (!= err nil)
            (.errorf t "%s: second Open+ReadDir(-1): %w" dir err)
            (return))

          (.checkDirList t dir "first Open+ReadDir(-1) vs second Open+ReadDir(-1)" list list2)

          ;; Reopen directory, read a third time in pieces, make sure contents match.
          (when [(set! d (.openDir t dir))] (== d nil)
            (return))

          (defer (.Close d))
          (set! list2 nil)
          (while true
            (let [n 1]
              (when (> (len list2) 0)
                (set! n 2))

              (let [(values frag err) (.ReadDir d n)]
                (when (> (len frag) n)
                  (.errorf t "%s: third Open: ReadDir(%d) after %d: %d entries (too many)" dir n (len list2) (len frag))
                  (return))

                (set! list2 (append list2 (spread frag)))
                (when (== err io/EOF)
                  (break))

                (when (!= err nil)
                  (.errorf t "%s: third Open: ReadDir(%d) after %d: %w" dir n (len list2) err)
                  (return))

                (when (== n 0)
                  (.errorf t "%s: third Open: ReadDir(%d) after %d: 0 entries but nil error" dir n (len list2))
                  (return)))))


          (.checkDirList t dir "first Open+ReadDir(-1) vs third Open+ReadDir(1,2) loop" list list2)

          ;; If fsys has ReadDir, check that it matches and is sorted.
          (when [(values fsys ok) (assert fs/ReadDirFS (.-fsys t))] ok
            (let [(values list2 err) (.ReadDir fsys dir)]
              (when (!= err nil)
                (.errorf t "%s: fsys.ReadDir: %w" dir err)
                (return))

              (.checkDirList t dir "first Open+ReadDir(-1) vs fsys.ReadDir" list list2)

              (for [i 0] (< (+ i 1) (len list2)) (inc! i)
                (when (>= (.Name (aget list2 i)) (.Name (aget list2 (+ i 1))))
                  (.errorf t "%s: fsys.ReadDir: list not sorted: %s before %s" dir (.Name (aget list2 i)) (.Name (aget list2 (+ i 1))))))))




          ;; Check fs.ReadDir as well.
          (set! (values list2 err) (fs/ReadDir (.-fsys t) dir))
          (when (!= err nil)
            (.errorf t "%s: fs.ReadDir: %w" dir err)
            (return))

          (.checkDirList t dir "first Open+ReadDir(-1) vs fs.ReadDir" list list2)

          (for [i 0] (< (+ i 1) (len list2)) (inc! i)
            (when (>= (.Name (aget list2 i)) (.Name (aget list2 (+ i 1))))
              (.errorf t "%s: fs.ReadDir: list not sorted: %s before %s" dir (.Name (aget list2 i)) (.Name (aget list2 (+ i 1))))))



          (.checkGlob t dir list2))))))




              (switch (% (+ i j) 5)
                (case [0]
                  (set! pattern (append pattern r)))
                (case [1]
                  (set! pattern (append pattern \[ r \])))
                (case [2]
                  (set! pattern (append pattern \[ r \- r \])))
                (case [3]
                  (set! pattern (append pattern \[ \\ r \])))
                (case [4]

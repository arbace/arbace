            (return))

          (when (^{:inst [(slice string) string]} slices/Equal want names)
            (return))


          (when (not (^{:inst [(slice string) string]} slices/IsSorted names))
            (.errorf t "%s: Glob(%#q): unsorted output:\n%s" dir glob (strings/Join names "\n"))
            (^{:inst [(slice string) string]} slices/Sort names))


          (let [^{:tag (slice string)} problems (zero (slice string))]
            (while (or (> (len want) 0) (> (len names) 0))
              (switch
                (case [(and (> (len want) 0) (> (len names) 0) (== (aget want 0) (aget names 0)))]
                  (set! (values want names) (values (subslice want 1) (subslice names 1))))
                (case [(and (> (len want) 0) ^:go/paren (or (== (len names) 0) (< (aget want 0) (aget names 0))))]
                  (set! problems (append problems (+ "missing: " (aget want 0))))
                  (set! want (subslice want 1)))
                (default
                  (set! problems (append problems (+ "extra: " (aget names 0))))
                  (set! names (subslice names 1)))))


            (.errorf t "%s: Glob(%#q): wrong output:\n%s" dir glob (strings/Join problems "\n"))))))))





^{:go/end 386} (go/method checkGlob "checkGlob checks that various glob patterns work if the file system implements GlobFS.\n" [^{:tag (* fsTester)} t ^string dir ^{:tag (slice fs/DirEntry)} list]
  (when [(values _ ok) (assert fs/GlobFS (.-fsys t))] (not ok)

^{:go/end 640} (go/method checkBadPath "checkBadPath checks that various invalid forms of file's name cannot be opened using open.\n" [^{:tag (* fsTester)} t ^string file ^string desc ^{:tag (func [string] [error])} open]
  (let [bad (lit (slice string)
        (+ "/" file)
        (+ file "/."))]

    (when (== file ".")
      (set! bad (append bad "/")))

    (when [i (strings/Index file "/")] (>= i 0)
      (set! bad (append bad
          (+ (subslice file _ i) "//" (subslice file (+ i 1)))
          (+ (subslice file _ i) "/./" (subslice file (+ i 1)))
          (+ (subslice file _ i) "\\" (subslice file (+ i 1)))
          (+ (subslice file _ i) "/../" file))))


    (when [i (strings/LastIndex file "/")] (>= i 0)
      (set! bad (append bad
          (+ (subslice file _ i) "//" (subslice file (+ i 1)))
          (+ (subslice file _ i) "/./" (subslice file (+ i 1)))
          (+ (subslice file _ i) "\\" (subslice file (+ i 1)))
          (+ file "/../" (subslice file (+ i 1))))))



    (range [_ b bad]
      (when [err (open b)] (== err nil)
        (.errorf t "%s: %s(%s) succeeded, want error" file desc b)))))

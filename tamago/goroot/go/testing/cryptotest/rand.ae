;; Package cryptotest provides deterministic random source testing.
(in-ns 'go.testing.cryptotest) (go/file "rand.go" :doc "Package cryptotest provides deterministic random source testing.\n" :imports [


    ^:alias ^{:line 9} [cryptorand "crypto/rand"]
    ^{:line 10} [byteorder "internal/byteorder"]
    ^{:line 11} [io "io"]
    ^:alias ^{:line 12} [mathrand "math/rand/v2"]
    ^{:line 13} [sync "sync"]
    ^{:line 14} [testing "testing"]

    ;; Import unsafe and crypto/rand, which imports crypto/internal/rand,
    ;; for the crypto/internal/rand.SetTestingReader go:linkname.
    ^{:line 18} [_ "crypto/rand"]
    ^{:line 19} [_ "unsafe"]])



(go/func ^:extern ^{:go/linkname "randSetTestingReader crypto/internal/rand.SetTestingReader"} randSetTestingReader [^io/Reader r])


(go/func ^:extern ^{:go/linkname "testingCheckParallel testing.checkParallel"} testingCheckParallel [^{:tag (* testing/T)} t])


















^{:go/end 65} (go/func SetGlobalRandom "SetGlobalRandom sets a global, deterministic cryptographic randomness source\nfor the duration of test t. It affects crypto/rand, and all implicit sources\nof cryptographic randomness in the crypto/... packages.\n\nSetGlobalRandom may be called multiple times in the same test to reset the\nrandom stream or change the seed.\n\nBecause SetGlobalRandom affects the whole process, it cannot be used in\nparallel tests or tests with parallel ancestors.\n\nNote that the way cryptographic algorithms use randomness is generally not\nspecified and may change over time. Thus, if a test expects a specific output\nfrom a cryptographic function, it may fail in the future even if it uses\nSetGlobalRandom.\n\nSetGlobalRandom is not supported when building against the Go Cryptographic\nModule v1.0.0 (i.e. when [crypto/fips140.Version] returns \"v1.0.0\").\n" [^{:tag (* testing/T)} t ^uint64 seed]
  (when (== t nil)
    (panic "cryptotest: SetGlobalRandom called with a nil *testing.T"))

  (when (not (testing/Testing))
    (panic "cryptotest: SetGlobalRandom used in a non-test binary"))

  (testingCheckParallel t)

  (let [^{:tag (array 32 byte)} s (zero (array 32 byte))]
    (byteorder/LEPutUint64 (subslice s _ 8) seed)
    (let [r (addr (lit lockedReader :r (mathrand/NewChaCha8 s)))]

      (randSetTestingReader r)
      (let [previous cryptorand/Reader]
        (set! cryptorand/Reader r)
        ^{:go/via [common]} (.Cleanup t ^{:go/end 64} (fn []
            (set! cryptorand/Reader previous)
            (randSetTestingReader nil)))))))



(go/type lockedReader (struct
    ^{:line 68} sync/Mutex
    ^{:line 69 :tag (* mathrand/ChaCha8)} r))


^{:go/end 76} (go/method Read [^{:tag (* lockedReader)} lr ^{:tag (slice byte)} b] :results [^int n ^error err]
  ^{:go/via [Mutex]} (.Lock lr)
  (defer ^{:go/via [Mutex]} (.Unlock lr))
  (.Read (.-r lr) b))

(in-ns 'go.testing) (go/file "allocs.go" :imports [


    ^{:line 8} [runtime "runtime"]])











^{:go/end 48} (go/func AllocsPerRun "AllocsPerRun returns the average number of allocations during calls to f.\nAlthough the return value has type float64, it will always be an integral value.\n\nTo compute the number of allocations, the function will first be run once as\na warm-up. The average number of allocations over the specified number of\nruns will then be measured and returned.\n\nAllocsPerRun sets [runtime.GOMAXPROCS] to 1 during its measurement and will restore\nit before returning.\n" [^int runs ^{:tag (func [])} f] :results [^float64 avg]
  (when (!= (.Load parallelStart) (.Load parallelStop))
    (panic "testing: AllocsPerRun called during parallel test"))

  (defer (runtime/GOMAXPROCS (runtime/GOMAXPROCS 1)))

  ;; Warm up the function
  (f)

  ;; Measure the starting statistics
  (let [^runtime/MemStats memstats (zero runtime/MemStats)]
    (runtime/ReadMemStats (addr memstats))
    (let [mallocs (- 0 (.-Mallocs memstats))]

      ;; Run the function the specified number of times
      (for [i 0] (< i runs) (inc! i)
        (f))


      ;; Read the final statistics
      (runtime/ReadMemStats (addr memstats))
      (set! mallocs + (.-Mallocs memstats))

      ;; Average the mallocs over the runs (not counting the warm-up).
      ;; We are forced to return a float64 because the API is silly, but do
      ;; the division as integers so we can ask if AllocsPerRun()==1
      ;; instead of AllocsPerRun()<2.
      (conv float64 (/ mallocs (conv uint64 runs))))))

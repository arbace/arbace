^{:go/breaks [[4 316]] :go/end 317} (go/func isSpace ^bool [^rune r]
  (if (< r 0x2000)
    (switch r
      ;; Note: not the same as Unicode Z class.
      (case [\tab \newline \u000b \formfeed \return \space 0x85 0xA0 0x1680]
        (return true)))

    (do
      (when (<= r 0x200a)
        (return true))

      (switch r
        (case [0x2028 0x2029 0x202f 0x205f 0x3000]

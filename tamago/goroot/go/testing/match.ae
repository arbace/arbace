^{:go/end 251} (go/method unique "unique creates a unique name for the given parent and subname by affixing it\nwith one or more counts, if necessary.\n" ^string [^{:tag (* matcher)} m ^string parent ^string subname]
  (let [base (+ parent "/" subname)]

    (while true
      (let [n (aget (.-subNames m) base)]
        (when (< n 0)
          (panic "subtest count overflow"))

        (aset (.-subNames m) base (+ n 1))

        (when (and (== n 0) (!= subname ""))
          (let [(values prefix nn) (parseSubtestNumber base)]
            (when (and (< (len prefix) (len base)) (< nn (aget (.-subNames m) prefix)))
              ;; This test is explicitly named like "parent/subname#NN",
              ;; and #NN was already used for the NNth occurrence of "parent/subname".
              ;; Loop to add a disambiguating suffix.
              (continue))

            (return base)))


        (let [name (fmt/Sprintf "%s#%02d" base n)]
          (when (!= (aget (.-subNames m) name) 0)
            ;; This is the nth occurrence of base, but the name "parent/subname#NN"
            ;; collides with the first occurrence of a subtest *explicitly* named
            ;; "parent/subname#NN". Try the next number.
            (continue))


          (return name))))))





^{:go/end 280} (go/func parseSubtestNumber "parseSubtestNumber splits a subtest name into a \"#%02d\"-formatted int32\nsuffix (if present), and a prefix preceding that suffix (always).\n" [^string s] :results [^string prefix ^int32 nn]

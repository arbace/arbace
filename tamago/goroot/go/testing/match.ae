^{:go/end 114} (go/method fullName [^{:tag (* matcher)} m ^{:tag (* common)} c ^string subname] :results [^string name ^bool ok ^bool partial]
  (set! name subname)

  (.Lock (.-mu m))
  (defer (.Unlock (.-mu m)))

  (when (and (!= c nil) (> (.-level c) 0))
    (set! name (.unique m (.-name c) (rewrite subname))))


  (.Lock matchMutex)
  (defer (.Unlock matchMutex))

  ;; We check the full array of paths each time to allow for the case that a pattern contains a '/'.
  (let [elem (strings/Split name "/")]

    ;; filter must match.
    ;; accept partial match that may produce full match later.
    (set! (values ok partial) (.matches (.-filter m) elem (.-matchFunc m)))
    (when (not ok)
      (return name false false))


    ;; skip must not match.
    ;; ignore partial match so we can get to more precise match later.
    (let [(values skip partialSkip) (.matches (.-skip m) elem (.-matchFunc m))]
      (when (and skip (not partialSkip))
        (return name false false))


      (return name ok partial))))





^{:go/end 123} (go/method clearSubNames "clearSubNames clears the matcher's internal state, potentially freeing\nmemory. After this is called, T.Name may return the same strings as it did\nfor earlier subtests.\n" [^{:tag (* matcher)} m]
  (.Lock (.-mu m))
  (defer (.Unlock (.-mu m)))
  (clear (.-subNames m)))



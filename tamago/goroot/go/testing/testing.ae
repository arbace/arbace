^{:go/end 485} (go/func Init "Init registers testing flags. These flags are automatically registered by\nthe \"go test\" command before running test functions, so Init is only needed\nwhen calling functions such as Benchmark without using \"go test\".\n\nInit is not safe to call concurrently. It has no effect if it was already called.\n" []
  (when initRan
    (return))

  (set! initRan true)
  ;; The short flag requests that tests run more quickly, but its functionality
  ;; is provided by test writers themselves. The testing package is just its
  ;; home. The all.bash installation script sets it to make installation more
  ;; efficient, but by default the flag is off so a plain "go test" will do a
  ;; full test of the package.
  (set! short (flag/Bool "test.short" false "run smaller test suite to save time"))

  ;; The failfast flag requests that test execution stop after the first test failure.
  (set! failFast (flag/Bool "test.failfast" false "do not start new tests after the first test failure"))

  ;; The directory in which to create profile files and the like. When run from
  ;; "go test", the binary always runs in the source directory for the package;
  ;; this flag lets "go test" tell the binary to write the files in the directory where
  ;; the "go test" command is run.
  (set! outputDir (flag/String "test.outputdir" "" "write profiles to `dir`"))
  (set! artifacts (flag/Bool "test.artifacts" false "store test artifacts in test.,outputdir"))
  ;; Report as tests are run; default is silent for success.
  (flag/Var (addr chatty) "test.v" "verbose: print additional output")
  (set! count (flag/Uint "test.count" 1 "run tests and benchmarks `n` times"))
  (set! coverProfile (flag/String "test.coverprofile" "" "write a coverage profile to `file`"))
  (set! gocoverdir (flag/String "test.gocoverdir" "" "write coverage intermediate files to this directory"))
  (set! matchList (flag/String "test.list" "" "list tests, examples, and benchmarks matching `regexp` then exit"))
  (set! match (flag/String "test.run" "" "run only tests and examples matching `regexp`"))
  (set! skip (flag/String "test.skip" "" "do not list or run tests matching `regexp`"))
  (set! memProfile (flag/String "test.memprofile" "" "write an allocation profile to `file`"))
  (set! memProfileRate (flag/Int "test.memprofilerate" 0 "set memory allocation profiling `rate` (see runtime.MemProfileRate)"))
  (set! cpuProfile (flag/String "test.cpuprofile" "" "write a cpu profile to `file`"))
  (set! blockProfile (flag/String "test.blockprofile" "" "write a goroutine blocking profile to `file`"))
  (set! blockProfileRate (flag/Int "test.blockprofilerate" 1 "set blocking profile `rate` (see runtime.SetBlockProfileRate)"))
  (set! mutexProfile (flag/String "test.mutexprofile" "" "write a mutex contention profile to the named file after execution"))
  (set! mutexProfileFraction (flag/Int "test.mutexprofilefraction" 1 "if >= 0, calls runtime.SetMutexProfileFraction()"))
  (set! panicOnExit0 (flag/Bool "test.paniconexit0" false "panic on call to os.Exit(0)"))
  (set! traceFile (flag/String "test.trace" "" "write an execution trace to `file`"))
  (set! timeout (flag/Duration "test.timeout" 0 "panic test binary after duration `d` (default 0, timeout disabled)"))
  (set! cpuListStr (flag/String "test.cpu" "" "comma-separated `list` of cpu counts to run each test with"))
  (set! parallel (flag/Int "test.parallel" (runtime/GOMAXPROCS 0) "run at most `n` tests in parallel"))
  (set! testlog (flag/String "test.testlogfile" "" "write test action log to `file` (for use only by cmd/go)"))
  (set! shuffle (flag/String "test.shuffle" "off" "randomize the execution order of tests and benchmarks"))
  (set! fullPath (flag/Bool "test.fullpath" false "show full file names in error messages"))

  (initBenchmarkFlags)
  (initFuzzFlags))



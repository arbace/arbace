(in-ns 'go.testing) (go/file "testing_other.go" :build ["//go:build !windows"] :imports [

    ^{:line 9} [time "time"]])



^{:go/breaks [4] :go/end 15} (go/func isWindowsRetryable "isWindowsRetryable reports whether err is a Windows error code\nthat may be fixed by retrying a failed filesystem operation.\n" ^bool [^error err]
  false)




(go/type highPrecisionTime "highPrecisionTime represents a single point in time.\nOn all systems except Windows, using time.Time is fine.\n" (struct
    ^{:line 20 :tag time/Time} now))



^{:go/end 26} (go/func highPrecisionTimeNow "highPrecisionTimeNow returns high precision time for benchmarking.\n" ^highPrecisionTime []
  (lit highPrecisionTime :now (time/Now)))



^{:go/end 31} (go/func highPrecisionTimeSince "highPrecisionTimeSince returns duration since b.\n" ^time/Duration [^highPrecisionTime b]
  (time/Since (.-now b)))

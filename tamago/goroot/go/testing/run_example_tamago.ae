(in-ns 'go.testing) (go/file "run_example_tamago.go" :build ["//go:build tamago"] :imports [


    ^{:line 10} [fmt "fmt"]
    ^{:line 11} [io "io"]
    ^{:line 12} [os "os"]
    ^{:line 13} [strings "strings"]
    ^{:line 14} [time "time"]])




^{:go/end 61} (go/func runExample "TODO(@musiol, @odeke-em): unify this code back into\nexample.go when js/wasm gets an os.Pipe implementation.\n" [^InternalExample eg] :results [^bool ok]
  (when (.-on chatty)
    (fmt/Printf "%s=== RUN   %s\n" (.prefix chatty) (.-Name eg)))


  ;; Capture stdout to temporary file. We're not using
  ;; os.Pipe because it is not supported on js/wasm.
  (let [stdout os/Stdout
      ^{:line 27} f (createTempFile (.-Name eg))]
    (set! os/Stdout f)
    (let [finished false
        ^{:line 30} start (time/Now)]

      ;; Clean up in a deferred call so we can recover if the example panics.
      (defer (^{:go/end 55} (fn []
            (let [timeSpent (time/Since start)]

              ;; Restore stdout, get output and remove temporary file.
              (set! os/Stdout stdout)
              (let [^strings/Builder buf (zero strings/Builder)
                  (values _ seekErr) (.Seek f 0 io/SeekStart)
                  (values _ readErr) (io/Copy (addr buf) f)
                  ^{:line 41} out (.String buf)]
                (.Close f)
                (os/Remove (.Name f))
                (when (!= seekErr nil)
                  (fmt/Fprintf os/Stderr "testing: seek temp file: %v\n" seekErr)
                  (os/Exit 1))

                (when (!= readErr nil)
                  (fmt/Fprintf os/Stderr "testing: read temp file: %v\n" readErr)
                  (os/Exit 1))


                (let [err (recover)]
                  (set! ok (.processRunResult eg out timeSpent finished err))))))))


      ;; Run example.
      ((.-F eg))
      (set! finished true)
      (return))))


^{:go/end 76} (go/func createTempFile ^{:tag (* os/File)} [^string exampleName]
  (for [i 0] _ (inc! i)
    (let [name (fmt/Sprintf "%s/go-example-stdout-%s-%d.txt" (os/TempDir) exampleName i)
        (values f err) (os/OpenFile name (bit-or os/O_RDWR os/O_CREATE os/O_EXCL) 0600)]
      (when (!= err nil)
        (when (os/IsExist err)
          (continue))

        (fmt/Fprintf os/Stderr "testing: open temp file: %v\n" err)
        (os/Exit 1))

      (return f))))

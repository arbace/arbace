(in-ns 'go.testing.iotest) (go/file "writer.go" :imports [

    ^{:line 7} [io "io"]])



^{:go/end 13} (go/func TruncateWriter "TruncateWriter returns a Writer that writes to w\nbut stops silently after n bytes.\n" ^io/Writer [^io/Writer w ^int64 n]
  (addr (lit truncateWriter w n)))


(go/type truncateWriter (struct
    ^{:line 16 :tag io/Writer} w
    ^{:line 17 :tag int64} n))


^{:go/end 35} (go/method Write [^{:tag (* truncateWriter)} t ^{:tag (slice byte)} p] :results [^int n ^error err]
  (when (<= (.-n t) 0)
    (return (len p) nil))

  ;; real write
  (set! n (len p))
  (when (> (conv int64 n) (.-n t))
    (set! n (conv int (.-n t))))

  (set! (values n err) (.Write (.-w t) (subslice p 0 n)))
  (set! (.-n t) - (conv int64 n))
  (when (== err nil)
    (set! n (len p)))

  (return))

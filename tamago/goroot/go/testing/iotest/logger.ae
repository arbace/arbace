(in-ns 'go.testing.iotest) (go/file "logger.go" :imports [


    ^{:line 8} [io "io"]
    ^{:line 9} [log "log"]])


(go/type writeLogger (struct
    ^{:line 13 :tag string} prefix
    ^{:line 14 :tag io/Writer} w))


^{:go/end 25} (go/method Write [^{:tag (* writeLogger)} l ^{:tag (slice byte)} p] :results [^int n ^error err]
  (set! (values n err) (.Write (.-w l) p))
  (if (!= err nil)
    (log/Printf "%s %x: %v" (.-prefix l) (subslice p 0 n) err)

    (log/Printf "%s %x" (.-prefix l) (subslice p 0 n)))

  (return))





^{:go/end 32} (go/func NewWriteLogger "NewWriteLogger returns a writer that behaves like w except\nthat it logs (using [log.Printf]) each write to standard error,\nprinting the prefix and the hexadecimal data written.\n" ^io/Writer [^string prefix ^io/Writer w]
  (addr (lit writeLogger prefix w)))


(go/type readLogger (struct
    ^{:line 35 :tag string} prefix
    ^{:line 36 :tag io/Reader} r))


^{:go/end 47} (go/method Read [^{:tag (* readLogger)} l ^{:tag (slice byte)} p] :results [^int n ^error err]
  (set! (values n err) (.Read (.-r l) p))
  (if (!= err nil)
    (log/Printf "%s %x: %v" (.-prefix l) (subslice p 0 n) err)

    (log/Printf "%s %x" (.-prefix l) (subslice p 0 n)))

  (return))





^{:go/end 54} (go/func NewReadLogger "NewReadLogger returns a reader that behaves like r except\nthat it logs (using [log.Printf]) each read to standard error,\nprinting the prefix and the hexadecimal data read.\n" ^io/Reader [^string prefix ^io/Reader r]
  (addr (lit readLogger prefix r)))

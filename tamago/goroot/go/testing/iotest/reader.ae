;; Package iotest implements Readers and Writers useful mainly for testing.
(in-ns 'go.testing.iotest) (go/file "reader.go" :doc "Package iotest implements Readers and Writers useful mainly for testing.\n" :imports [


    ^{:line 9} [bytes "bytes"]
    ^{:line 10} [errors "errors"]
    ^{:line 11} [fmt "fmt"]
    ^{:line 12} [io "io"]])




^{:go/end 17} (go/func OneByteReader "OneByteReader returns a Reader that implements\neach non-empty Read by reading one byte from r.\n" ^io/Reader [^io/Reader r] (addr (lit oneByteReader r)))

(go/type oneByteReader (struct
    ^{:line 20 :tag io/Reader} r))


^{:go/end 28} (go/method Read [^{:tag (* oneByteReader)} r ^{:tag (slice byte)} p] :results [int error]
  (when (== (len p) 0)
    (return 0 nil))

  (.Read (.-r r) (subslice p 0 1)))




^{:go/end 32} (go/func HalfReader "HalfReader returns a Reader that implements Read\nby reading half as many requested bytes from r.\n" ^io/Reader [^io/Reader r] (addr (lit halfReader r)))

(go/type halfReader (struct
    ^{:line 35 :tag io/Reader} r))


^{:go/end 40} (go/method Read [^{:tag (* halfReader)} r ^{:tag (slice byte)} p] :results [int error]
  (.Read (.-r r) (subslice p 0 (/ (+ (len p) 1) 2))))







^{:go/end 47} (go/func DataErrReader "DataErrReader changes the way errors are handled by a Reader. Normally, a\nReader returns an error (typically EOF) from the first Read call after the\nlast piece of data is read. DataErrReader wraps a Reader and changes its\nbehavior so the final error is returned along with the final data, instead\nof in the first call after the final data.\n" ^io/Reader [^io/Reader r] (addr (lit dataErrReader r nil (make (slice byte) 1024))))

(go/type dataErrReader (struct
    ^{:line 50 :tag io/Reader} r
    ^{:line 51 :tag (slice byte)} unread
    ^{:line 52 :tag (slice byte)} data))


^{:go/end 71} (go/method Read [^{:tag (* dataErrReader)} r ^{:tag (slice byte)} p] :results [^int n ^error err]
  ;; loop because first call needs two reads:
  ;; one to get data and a second to look for an error.
  (while true
    (when (== (len (.-unread r)) 0)
      (let [(values n1 err1) (.Read (.-r r) (.-data r))]
        (set! (.-unread r) (subslice (.-data r) 0 n1))
        (set! err err1)))

    (when (or (> n 0) (!= err nil))
      (break))

    (set! n (copy p (.-unread r)))
    (set! (.-unread r) (subslice (.-unread r) n)))

  (return))



(go/var ^{:doc "ErrTimeout is a fake timeout error.\n"} ErrTimeout (errors/New "timeout"))



^{:go/end 78} (go/func TimeoutReader "TimeoutReader returns [ErrTimeout] on the second read\nwith no data. Subsequent calls to read succeed.\n" ^io/Reader [^io/Reader r] (addr (lit timeoutReader r 0)))

(go/type timeoutReader (struct
    ^{:line 81 :tag io/Reader} r
    ^{:line 82 :tag int} count))


^{:go/end 91} (go/method Read [^{:tag (* timeoutReader)} r ^{:tag (slice byte)} p] :results [int error]
  (inc! (.-count r))
  (when (== (.-count r) 2)
    (return 0 ErrTimeout))

  (.Read (.-r r) p))



^{:go/end 96} (go/func ErrReader "ErrReader returns an [io.Reader] that returns 0, err from all Read calls.\n" ^io/Reader [^error err]
  (addr (lit errReader :err err)))


(go/type errReader (struct
    ^{:line 99 :tag error} err))


^{:go/end 104} (go/method Read [^{:tag (* errReader)} r ^{:tag (slice byte)} p] :results [int error]
  (return 0 (.-err r)))


(go/type smallByteReader (struct
    ^{:line 107 :tag io/Reader} r
    ^{:line 108 :tag int} off
    ^{:line 109 :tag int} n))


^{:go/end 127} (go/method Read [^{:tag (* smallByteReader)} r ^{:tag (slice byte)} p] :results [int error]
  (when (== (len p) 0)
    (return 0 nil))

  (set! (.-n r) (+ (% (.-n r) 3) 1))
  (let [n (.-n r)]
    (when (> n (len p))
      (set! n (len p)))

    (let [(values ^:assign n err) (.Read (.-r r) (subslice p 0 n))]
      (when (and (!= err nil) (!= err io/EOF))
        (set! err (fmt/Errorf "Read(%d bytes at offset %d): %v" n (.-off r) err)))

      (set! (.-off r) + n)
      (return n err))))









^{:go/end 268} (go/func TestReader "TestReader tests that reading from r returns the expected file content.\nIt does reads of different sizes, until EOF.\nIf r implements [io.ReaderAt] or [io.Seeker], TestReader also checks\nthat those operations behave as they should.\n\nIf TestReader finds any misbehaviors, it returns an error reporting them.\nThe error text may span multiple lines.\n" ^error [^io/Reader r ^{:tag (slice byte)} content]
  (when (> (len content) 0)
    (let [(values n err) (.Read r nil)]
      (when (or (!= n 0) (!= err nil))
        (return (fmt/Errorf "Read(0) = %d, %v, want 0, nil" n err)))))



  (let [(values data err) (io/ReadAll (addr (lit smallByteReader :r r)))]
    (when (!= err nil)
      (return err))

    (when (not (bytes/Equal data content))
      (return (fmt/Errorf "ReadAll(small amounts) = %q\n\twant %q" data content)))

    ^{:go/breaks [[5 267]]} (let [(values n ^:assign err) (.Read r (make (slice byte) 10))]
      (when (or (!= n 0) (!= err io/EOF))
        (return (fmt/Errorf "Read(10) at EOF = %v, %v, want 0, EOF" n err)))


      (when [(values r ok) (assert io/ReadSeeker r)] ok
        ;; Seek(0, 1) should report the current file position (EOF).
        (when [(values off err) (.Seek r 0 1)] (or (!= off (conv int64 (len content))) (!= err nil))
          (return (fmt/Errorf "Seek(0, 1) from EOF = %d, %v, want %d, nil" off err (len content))))


        ;; Seek backward partway through file, in two steps.
        ;; If middle == 0, len(content) == 0, can't use the -1 and +1 seeks.
        (let [middle (- (len content) (/ (len content) 3))]
          (when (> middle 0)
            (when [(values off err) (.Seek r -1 1)] (or (!= off (conv int64 (- (len content) 1))) (!= err nil))
              (return (fmt/Errorf "Seek(-1, 1) from EOF = %d, %v, want %d, nil" (- off) err (- (len content) 1))))

            (when [(values off err) (.Seek r (conv int64 (/ (- (len content)) 3)) 1)] (or (!= off (conv int64 (- middle 1))) (!= err nil))
              (return (fmt/Errorf "Seek(%d, 1) from %d = %d, %v, want %d, nil" (/ (- (len content)) 3) (- (len content) 1) off err (- middle 1))))

            (when [(values off err) (.Seek r (+ 1) 1)] (or (!= off (conv int64 middle)) (!= err nil))
              (return (fmt/Errorf "Seek(+1, 1) from %d = %d, %v, want %d, nil" (- middle 1) off err middle))))



          ;; Seek(0, 1) should report the current file position (middle).
          (when [(values off err) (.Seek r 0 1)] (or (!= off (conv int64 middle)) (!= err nil))
            (return (fmt/Errorf "Seek(0, 1) from %d = %d, %v, want %d, nil" middle off err middle)))


          ;; Reading forward should return the last part of the file.
          (let [(values data err) (io/ReadAll (addr (lit smallByteReader :r r)))]
            (when (!= err nil)
              (return (fmt/Errorf "ReadAll from offset %d: %v" middle err)))

            (when (not (bytes/Equal data (subslice content middle)))
              (return (fmt/Errorf "ReadAll from offset %d = %q\n\twant %q" middle data (subslice content middle))))


            ;; Seek relative to end of file, but start elsewhere.
            (when [(values off err) (.Seek r (conv int64 (/ middle 2)) 0)] (or (!= off (conv int64 (/ middle 2))) (!= err nil))
              (return (fmt/Errorf "Seek(%d, 0) from EOF = %d, %v, want %d, nil" (/ middle 2) off err (/ middle 2))))

            (when [(values off err) (.Seek r (conv int64 (/ (- (len content)) 3)) 2)] (or (!= off (conv int64 middle)) (!= err nil))
              (return (fmt/Errorf "Seek(%d, 2) from %d = %d, %v, want %d, nil" (/ (- (len content)) 3) (/ middle 2) off err middle)))


            ;; Reading forward should return the last part of the file (again).
            (set! (values data err) (io/ReadAll (addr (lit smallByteReader :r r))))
            (when (!= err nil)
              (return (fmt/Errorf "ReadAll from offset %d: %v" middle err)))

            (when (not (bytes/Equal data (subslice content middle)))
              (return (fmt/Errorf "ReadAll from offset %d = %q\n\twant %q" middle data (subslice content middle))))


            ;; Absolute seek & read forward.
            (when [(values off err) (.Seek r (conv int64 (/ middle 2)) 0)] (or (!= off (conv int64 (/ middle 2))) (!= err nil))
              (return (fmt/Errorf "Seek(%d, 0) from EOF = %d, %v, want %d, nil" (/ middle 2) off err (/ middle 2))))

            (set! (values data err) (io/ReadAll r))
            (when (!= err nil)
              (return (fmt/Errorf "ReadAll from offset %d: %v" (/ middle 2) err)))

            (when (not (bytes/Equal data (subslice content (/ middle 2))))
              (return (fmt/Errorf "ReadAll from offset %d = %q\n\twant %q" (/ middle 2) data (subslice content (/ middle 2))))))))



      (when [(values r ok) (assert io/ReaderAt r)] ok
        (let [data (make (slice byte) (len content) (+ (len content) 1))]
          (range [i data]
            (aset data i 0xfe))

          (let [(values n err) (.ReadAt r data 0)]
            (when (or (!= n (len data)) (and (!= err nil) (!= err io/EOF)))
              (return (fmt/Errorf "ReadAt(%d, 0) = %v, %v, want %d, nil or EOF" (len data) n err (len data))))

            (when (not (bytes/Equal data content))
              (return (fmt/Errorf "ReadAt(%d, 0) = %q\n\twant %q" (len data) data content)))


            (set! (values n err) (.ReadAt r (subslice data _ 1) (conv int64 (len data))))
            (when (or (!= n 0) (!= err io/EOF))
              (return (fmt/Errorf "ReadAt(1, %d) = %v, %v, want 0, EOF" (len data) n err)))


            (range [i data]
              (aset data i 0xfe))

            (set! (values n err) (.ReadAt r (subslice data _ (cap data)) 0))
            (when (or (!= n (len data)) (!= err io/EOF))
              (return (fmt/Errorf "ReadAt(%d, 0) = %v, %v, want %d, EOF" (cap data) n err (len data))))

            (when (not (bytes/Equal data content))
              (return (fmt/Errorf "ReadAt(%d, 0) = %q\n\twant %q" (len data) data content)))


            (range [i data]
              (aset data i 0xfe))

            (range [i data]
              (set! (values n err) (.ReadAt r (subslice data i (+ i 1)) (conv int64 i)))
              (when (or (!= n 1) (and (!= err nil) ^:go/paren (or (!= i (- (len data) 1)) (!= err io/EOF))))
                (let [want "nil"]
                  (when (== i (- (len data) 1))
                    (set! want "nil or EOF"))

                  (return (fmt/Errorf "ReadAt(1, %d) = %v, %v, want 1, %s" i n err want))))

              (when (!= (aget data i) (aget content i))
                (return (fmt/Errorf "ReadAt(1, %d) = %q want %q" i (subslice data i (+ i 1)) (subslice content i (+ i 1)))))))))



      nil)))

(ns go.testing.iotest
  (:require [arbace.go :as go]))

(go/package iotest
  :path "testing/iotest"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["logger.go" "reader.go" "writer.go"]
  :init-order [ErrTimeout]
  :positions :lines)

(load "iotest/logger")
(load "iotest/reader")
(load "iotest/writer")

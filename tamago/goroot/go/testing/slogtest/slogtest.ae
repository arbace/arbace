    ^{:go/breaks [2 4 6 [8 65]]} (lit _
      :name "empty-attr"
      :explanation (withSource "a Handler should ignore an empty Attr")
      :f ^{:go/end 64} (fn [^{:tag (* slog/Logger)} l]
        (.Info l "msg" "a" "b" "" nil "c" "d"))

      :checks (lit (slice check)

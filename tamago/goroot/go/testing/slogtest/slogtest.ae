      :f ^{:go/end 123} (fn [^{:tag (* slog/Logger)} l]
        (.Info l "msg" "a" "b" (slog/Group "" (slog/String "c" "d")) "e" "f"))


      :checks (lit (slice check)
        (hasAttr "a" "b")
        (hasAttr "c" "d")
        (hasAttr "e" "f")))


    ^{:go/breaks [2 4 6 [8 136]]} (lit _
      :name "WithGroup"
      :explanation (withSource "a Handler should handle the WithGroup method")
      :f ^{:go/end 135} (fn [^{:tag (* slog/Logger)} l]
        (.Info (.WithGroup l "G") "msg" "a" "b"))

      :checks (lit (slice check)
        (hasKey slog/TimeKey)
        (hasKey slog/LevelKey)
        (hasAttr slog/MessageKey "msg")
        (missingKey "a")
        (inGroup "G" (hasAttr "a" "b"))))


    ^{:go/breaks [2 4 6 [8 150]]} (lit _
      :name "multi-With"
      :explanation (withSource "a Handler should handle multiple WithGroup and WithAttr calls")
      :f ^{:go/end 149} (fn [^{:tag (* slog/Logger)} l]
        (.Info (.WithGroup (.With (.WithGroup (.With l "a" "b") "G") "c" "d") "H") "msg" "e" "f"))

      :checks (lit (slice check)
        (hasKey slog/TimeKey)
        (hasKey slog/LevelKey)
        (hasAttr slog/MessageKey "msg")
        (hasAttr "a" "b")
        (inGroup "G" (hasAttr "c" "d"))
        (inGroup "G" (inGroup "H" (hasAttr "e" "f")))))


    ^{:go/breaks [2 4 6 [8 165]]} (lit _
      :name "empty-group-record"
      :explanation (withSource "a Handler should not output groups if there are no attributes")
      :f ^{:go/end 164} (fn [^{:tag (* slog/Logger)} l]
        (.Info (.WithGroup (.With (.WithGroup (.With l "a" "b") "G") "c" "d") "H") "msg"))

      :checks (lit (slice check)

    ^{:line 23 :tag string :doc "If non-empty, explanation explains the violated constraint.\n"} explanation




    ^{:line 28 :tag (func [(* slog/Logger)]) :doc "f executes a single log event using its argument logger.\nSo that mkdescs.sh can generate the right description,\nthe body of f must appear on a single line whose first\nnon-whitespace characters are \"l.\".\n"} f



^{:go/end 293} (go/func TestHandler "TestHandler tests a [slog.Handler].\nIf TestHandler finds any misbehaviors, it returns an error for each,\ncombined into a single error with [errors.Join].\n\nTestHandler installs the given Handler in a [slog.Logger] and\nmakes several calls to the Logger's output methods.\nThe Handler should be enabled for levels Info and above.\n\nThe results function is invoked after all such calls.\nIt should return a slice of map[string]any, one for each call to a Logger output method.\nThe keys and values of the map should correspond to the keys and values of the Handler's\noutput. Each group in the output should be represented as its own nested map[string]any.\nThe standard keys [slog.TimeKey], [slog.LevelKey] and [slog.MessageKey] should be used.\n\nIf the Handler outputs JSON, then calling [encoding/json.Unmarshal] with a `map[string]any`\nwill create the right data structure.\n\nIf a Handler intentionally drops an attribute that is checked by a test,\nthen the results function should check for its absence and add it to the map it returns.\n" ^error [^slog/Handler h ^{:tag (func [] [(slice (map string any))])} results]
  ;; Run the handler on the test cases.
  (range [_ c cases]
    (let [ht h]
      (when (!= (.-mod c) nil)
        (set! ht (addr (lit wrapper h (.-mod c)))))

      (let [l (slog/New ht)]
        ((.-f c) l))))


  ;; Collect and check the results.
  (let [^{:tag (slice error)} errs (zero (slice error))
      ^{:line 280} res (results)]
    (when [(values g w) (values (len res) (len cases))] (!= g w)
      (return (fmt/Errorf "got %d results, want %d" g w)))

    (range [i got res]
      (let [c (aget cases i)]
        (range [_ check (.-checks c)]
          (when [problem (check got)] (!= problem "")
            (set! errs (append errs (fmt/Errorf "%s: %s" problem (.-explanation c))))))))



    (errors/Join (spread errs))))






^{:go/end 316} (go/func Run "Run exercises a [slog.Handler] on the same test cases as [TestHandler], but\nruns each case in a subtest. For each test case, it first calls newHandler to\nget an instance of the handler under test, then runs the test case, then\ncalls result to get the result. If the test case fails, it calls t.Error.\n" [^{:tag (* testing/T)} t ^{:tag (func [(* testing/T)] [slog/Handler])} newHandler ^{:tag (func [(* testing/T)] [(map string any)])} result]
  (range [_ c cases]
    (.Run t (.-name c) ^{:go/end 314} (fn [^{:tag (* testing/T)} t]
        (let [h (newHandler t)]
          (when (!= (.-mod c) nil)
            (set! h (addr (lit wrapper h (.-mod c)))))

          (let [l (slog/New h)]
            ((.-f c) l)
            (let [got (result t)]
              (range [_ check (.-checks c)]
                (when [p (check got)] (!= p "")
                  ^{:go/via [common]} (.Errorf t "%s: %s" p (.-explanation c)))))))))))






(go/type check (func [(map string any)] [string]))

^{:go/end 327} (go/func hasKey ^check [^string key]
  ^{:go/breaks [[3 325]] :go/end 326} (fn ^string [^{:tag (map string any)} m]
    (when [(values _ ok) (aget m key)] (not ok)
      (return (fmt/Sprintf "missing key %q" key)))

    ""))



^{:go/end 336} (go/func missingKey ^check [^string key]
  ^{:go/breaks [[3 334]] :go/end 335} (fn ^string [^{:tag (map string any)} m]
    (when [(values _ ok) (aget m key)] ok
      (return (fmt/Sprintf "unexpected key %q" key)))

    ""))



^{:go/end 349} (go/func hasAttr ^check [^string key ^any wantVal]
  ^{:go/end 348} (fn ^string [^{:tag (map string any)} m]
    (when [s ((hasKey key) m)] (!= s "")
      (return s))

    ^{:go/breaks [[3 347]]} (let [gotVal (aget m key)]
      (when (not (reflect/DeepEqual gotVal wantVal))
        (return (fmt/Sprintf "%q: got %#v, want %#v" key gotVal wantVal)))

      "")))



^{:go/end 363} (go/func inGroup ^check [^string name ^check c]
  ^{:go/end 362} (fn ^string [^{:tag (map string any)} m]
    (let [(values v ok) (aget m name)]
      (when (not ok)
        (return (fmt/Sprintf "missing group %q" name)))

      (let [(values g ^:assign ok) (assert (map string any) v)]
        (when (not ok)
          (return (fmt/Sprintf "value for group %q is not map[string]any" name)))

        (c g)))))



(go/type wrapper (struct
    ^{:line 366} slog/Handler
    ^{:line 367 :tag (func [(* slog/Record)])} mod))


^{:go/end 373} (go/method Handle ^error [^{:tag (* wrapper)} h ^context/Context ctx ^slog/Record r]
  ((.-mod h) (addr r))

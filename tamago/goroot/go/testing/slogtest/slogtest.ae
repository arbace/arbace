      :f ^{:go/end 87} (fn [^{:tag (* slog/Logger)} l]
        (.Info (.With l "a" "b") "msg" "k" "v"))

      :checks (lit (slice check)
        (hasAttr "a" "b")
        (hasAttr "k" "v")))


    ^{:go/breaks [2 4 6 [8 99]]} (lit _
      :name "groups"
      :explanation (withSource "a Handler should handle Group attributes")
      :f ^{:go/end 98} (fn [^{:tag (* slog/Logger)} l]
        (.Info l "msg" "a" "b" (slog/Group "G" (slog/String "c" "d")) "e" "f"))

      :checks (lit (slice check)
        (hasAttr "a" "b")
        (inGroup "G" (hasAttr "c" "d"))
        (hasAttr "e" "f")))


    ^{:go/breaks [2 4 6 [8 111]]} (lit _
      :name "empty-group"
      :explanation (withSource "a Handler should ignore an empty group")
      :f ^{:go/end 110} (fn [^{:tag (* slog/Logger)} l]
        (.Info l "msg" "a" "b" (slog/Group "G") "e" "f"))


        (inGroup "G" (hasAttr "b" "v2"))))


    ^{:go/breaks [2 4 6 [8 241] 10]} (lit _
      :name "empty-PC"
      :explanation (withSource "a Handler should not output SourceKey if the PC is zero")
      :f ^{:go/end 240} (fn [^{:tag (* slog/Logger)} l]
        (.Info l "message"))

      :mod ^{:go/end 241} (fn [^{:tag (* slog/Record)} r] (set! (.-PC r) 0))
      :checks (lit (slice check)

        (missingKey "")
        (hasAttr "c" "d")))


    ^{:go/breaks [2 4 6 [8 77] 10]} (lit _
      :name "zero-time"
      :explanation (withSource "a Handler should ignore a zero Record.Time")
      :f ^{:go/end 76} (fn [^{:tag (* slog/Logger)} l]
        (.Info l "msg" "k" "v"))

      :mod ^{:go/end 77} (fn [^{:tag (* slog/Record)} r] (set! (.-Time r) (lit time/Time)))
      :checks (lit (slice check)

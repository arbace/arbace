        (hasAttr slog/MessageKey "msg")
        (hasAttr "a" "b")
        (inGroup "G" (hasAttr "c" "d"))
        (inGroup "G" (missingKey "H"))))


    ^{:go/breaks [2 4 6 [8 180]]} (lit _
      :name "nested-empty-group-record"
      :explanation (withSource "a Handler should not output nested groups if there are no attributes")
      :f ^{:go/end 179} (fn [^{:tag (* slog/Logger)} l]
        (.Info (.WithGroup (.WithGroup (.With (.WithGroup (.With l "a" "b") "G") "c" "d") "H") "I") "msg"))

      :checks (lit (slice check)
        (hasKey slog/TimeKey)
        (hasKey slog/LevelKey)
        (hasAttr slog/MessageKey "msg")
        (hasAttr "a" "b")
        (inGroup "G" (hasAttr "c" "d"))
        (inGroup "G" (missingKey "H"))
        (inGroup "G" (missingKey "I"))))


    ^{:go/breaks [2 4 6 [8 196]]} (lit _
      :name "resolve"
      :explanation (withSource "a Handler should call Resolve on attribute values")
      :f ^{:go/end 195} (fn [^{:tag (* slog/Logger)} l]
        (.Info l "msg" "k" (addr (lit replace "replaced"))))

      :checks (lit (slice check) (hasAttr "k" "replaced")))

    ^{:go/breaks [2 4 6 [8 207]]} (lit _
      :name "resolve-groups"
      :explanation (withSource "a Handler should call Resolve on attribute values in groups")
      :f ^{:go/end 206} (fn [^{:tag (* slog/Logger)} l]

(in-ns 'go.strings) (go/file "builder.go" :imports [


    ^{:line 8} [abi "internal/abi"]
    ^{:line 9} [bytealg "internal/bytealg"]
    ^{:line 10} [utf8 "unicode/utf8"]
    ^{:line 11} [unsafe "unsafe"]])





(go/type Builder "A Builder is used to efficiently build a string using [Builder.Write] methods.\nIt minimizes memory copying. The zero value is ready to use.\nDo not copy a non-zero Builder.\n" (struct
    ^{:line 18 :tag (* Builder)} addr ; of receiver, to detect copies by value




    ^{:line 23 :tag (slice byte) :doc "External users should never get direct access to this buffer, since\nthe slice at some point will be converted to a string using unsafe, also\ndata between len(buf) and cap(buf) might be uninitialized.\n"} buf))








^{:go/end 43} (go/method copyCheck "copyCheck implements a dynamic check to prevent modification after\ncopying a non-zero Builder, which would be unsafe (see #25907, #47276).\n\nWe cannot add a noCopy field to Builder, to cause vet's copylocks\ncheck to report copying, because copylocks cannot reliably\ndiscriminate the zero and nonzero cases.\n" [^{:tag (* Builder)} b]
  (cond (== (.-addr b) nil)
    ;; This hack works around a failing of Go's escape analysis
    ;; that was causing b to escape and be heap allocated.
    ;; See issue 23382.
    ;; TODO: once issue 7921 is fixed, this should be reverted to
    ;; just "b.addr = b".
    (set! (.-addr b) (conv (* Builder) (abi/NoEscape (conv unsafe/Pointer b))))
    (!= (.-addr b) b)
    (panic "strings: illegal use of non-zero Builder copied by value")))




^{:go/end 48} (go/method String "String returns the accumulated string.\n" ^string [^{:tag (* Builder)} b]
  (unsafe/String (unsafe/SliceData (.-buf b)) (len (.-buf b))))



^{:go/end 51} (go/method Len "Len returns the number of accumulated bytes; b.Len() == len(b.String()).\n" ^int [^{:tag (* Builder)} b] (len (.-buf b)))




^{:go/end 56} (go/method Cap "Cap returns the capacity of the builder's underlying byte slice. It is the\ntotal space allocated for the string being built and includes any bytes\nalready written.\n" ^int [^{:tag (* Builder)} b] (cap (.-buf b)))


^{:go/end 62} (go/method Reset "Reset resets the [Builder] to be empty.\n" [^{:tag (* Builder)} b]
  (set! (.-addr b) nil)
  (set! (.-buf b) nil))




^{:go/end 70} (go/method grow "grow copies the buffer to a new, larger buffer so that there are at least n\nbytes of capacity beyond len(b.buf).\n" [^{:tag (* Builder)} b ^int n]
  (let [buf (subslice (bytealg/MakeNoZero (+ (* 2 (cap (.-buf b))) n)) _ (len (.-buf b)))]
    (copy buf (.-buf b))
    (set! (.-buf b) buf)))





^{:go/end 83} (go/method Grow "Grow grows b's capacity, if necessary, to guarantee space for\nanother n bytes. After Grow(n), at least n bytes can be written to b\nwithout another allocation. If n is negative, Grow panics.\n" [^{:tag (* Builder)} b ^int n]
  (.copyCheck b)
  (when (< n 0)
    (panic "strings.Builder.Grow: negative count"))

  (when (< (- (cap (.-buf b)) (len (.-buf b))) n)
    (.grow b n)))





^{:go/end 91} (go/method Write "Write appends the contents of p to b's buffer.\nWrite always returns len(p), nil.\n" [^{:tag (* Builder)} b ^{:tag (slice byte)} p] :results [int error]
  (.copyCheck b)
  (set! (.-buf b) (append (.-buf b) (spread p)))
  (return (len p) nil))




^{:go/breaks [6] :go/end 99} (go/method WriteByte "WriteByte appends the byte c to b's buffer.\nThe returned error is always nil.\n" ^error [^{:tag (* Builder)} b ^byte c]
  (.copyCheck b)
  (set! (.-buf b) (append (.-buf b) c))
  nil)




^{:go/end 108} (go/method WriteRune "WriteRune appends the UTF-8 encoding of Unicode code point r to b's buffer.\nIt returns the number of bytes written and a nil error.\n" [^{:tag (* Builder)} b ^rune r] :results [int error]
  (.copyCheck b)
  (let [n (len (.-buf b))]
    (set! (.-buf b) (utf8/AppendRune (.-buf b) r))
    (return (- (len (.-buf b)) n) nil)))




^{:go/end 116} (go/method WriteString "WriteString appends the contents of s to b's buffer.\nIt returns the length of s and a nil error.\n" [^{:tag (* Builder)} b ^string s] :results [int error]
  (.copyCheck b)
  (set! (.-buf b) (append (.-buf b) (spread s)))
  (return (len s) nil))

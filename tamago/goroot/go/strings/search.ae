(in-ns 'go.strings) (go/file "search.go" :imports [])






(go/type stringFinder "stringFinder efficiently finds strings in a source text. It's implemented\nusing the Boyer-Moore string search algorithm:\nhttps://en.wikipedia.org/wiki/Boyer-Moore_string_search_algorithm\nhttps://www.cs.utexas.edu/~moore/publications/fstrpos.pdf (note: this aged\ndocument uses 1-based indexing)\n" (struct

    ^{:line 14 :tag string :doc "pattern is the string that we are searching for in the text.\n"} pattern








    ^{:line 23 :tag (array 256 int) :doc "badCharSkip[b] contains the distance between the last byte of pattern\nand the rightmost occurrence of b in pattern. If b is not in pattern,\nbadCharSkip[b] is len(pattern).\n\nWhenever a mismatch is found with byte b in the text, we can safely\nshift the matching frame at least badCharSkip[b] until the next time\nthe matching char could be in alignment.\n"} badCharSkip





















    ^{:line 45 :tag (slice int) :doc "goodSuffixSkip[i] defines how far we can shift the matching frame given\nthat the suffix pattern[i+1:] matches, but the byte pattern[i] does\nnot. There are two cases to consider:\n\n1. The matched suffix occurs elsewhere in pattern (with a different\nbyte preceding it that we might possibly match). In this case, we can\nshift the matching frame to align with the next suffix chunk. For\nexample, the pattern \"mississi\" has the suffix \"issi\" next occurring\n(in right-to-left order) at index 1, so goodSuffixSkip[3] ==\nshift+len(suffix) == 3+4 == 7.\n\n2. If the matched suffix does not occur elsewhere in pattern, then the\nmatching frame may share part of its prefix with the end of the\nmatching suffix. In this case, goodSuffixSkip[i] will contain how far\nto shift the frame to align this portion of the prefix to the\nsuffix. For example, in the pattern \"abcxxxabc\", when the first\nmismatch from the back is found to be in position 3, the matching\nsuffix \"xxabc\" is not found elsewhere in the pattern. However, its\nrightmost \"abc\" (at position 6) is a prefix of the whole pattern, so\ngoodSuffixSkip[3] == shift+len(suffix) == 6+5 == 11.\n"} goodSuffixSkip))


^{:go/end 89} (go/func makeStringFinder ^{:tag (* stringFinder)} [^string pattern]
  (let [f (addr ^{:go/breaks [2 4]} (lit stringFinder
          :pattern pattern
          :goodSuffixSkip (make (slice int) (len pattern))))

      ;; last is the index of the last character in the pattern.
      ^{:line 54} last (- (len pattern) 1)]

    ;; Build bad character table.
    ;; Bytes not in the pattern can skip one pattern's length.
    (range [i (.-badCharSkip f)]
      (aset (.-badCharSkip f) i (len pattern)))

    ;; The loop condition is < instead of <= so that the last byte does not
    ;; have a zero distance to itself. Finding this byte out of place implies
    ;; that it is not in the last position.
    (for [i 0] (< i last) (inc! i)
      (aset (.-badCharSkip f) (aget pattern i) (- last i)))


    ;; Build good suffix table.
    ;; First pass: set each value to the next index which starts a prefix of
    ;; pattern.
    (let [lastPrefix last]
      (for [i last] (>= i 0) (dec! i)
        (when (HasPrefix pattern (subslice pattern (+ i 1)))
          (set! lastPrefix (+ i 1)))

        ;; lastPrefix is the shift, and (last-i) is len(suffix).
        (aset (.-goodSuffixSkip f) i (- (+ lastPrefix last) i)))

      ;; Second pass: find repeats of pattern's suffix starting from the front.
      (for [i 0] (< i last) (inc! i)
        (let [lenSuffix (longestCommonSuffix pattern (subslice pattern 1 (+ i 1)))]
          (when (!= (aget pattern (- i lenSuffix)) (aget pattern (- last lenSuffix)))
            ;; (last-i) is the shift, and lenSuffix is len(suffix).
            (aset (.-goodSuffixSkip f) (- last lenSuffix) (- (+ lenSuffix last) i)))))



      ^{:line 88} f)))


^{:go/end 98} (go/func longestCommonSuffix [^string a ^string b] :results [^int i]
  (for [] (and (< i (len a)) (< i (len b))) (inc! i)
    (when (!= (aget a (- (len a) 1 i)) (aget b (- (len b) 1 i)))
      (break)))


  (return))




^{:go/end 117} (go/method next "next returns the index in text of the first occurrence of the pattern. If\nthe pattern is not found, it returns -1.\n" ^int [^{:tag (* stringFinder)} f ^string text]
  ^{:go/breaks [[3 116]]} (let [i (- (len (.-pattern f)) 1)]
    (while (< i (len text))
      ;; Compare backwards from the end until the first unmatching character.
      (let [j (- (len (.-pattern f)) 1)]
        (while (and (>= j 0) (== (aget text i) (aget (.-pattern f) j)))
          (dec! i)
          (dec! j))

        (when (< j 0)
          (return (+ i 1))) ; match

        (set! i + (max (aget (.-badCharSkip f) (aget text i)) (aget (.-goodSuffixSkip f) j)))))

    -1))

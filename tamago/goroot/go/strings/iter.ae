(in-ns 'go.strings) (go/file "iter.go" :imports [


    ^{:line 8} [iter "iter"]
    ^{:line 9} [unicode "unicode"]
    ^{:line 10} [utf8 "unicode/utf8"]])







^{:go/end 32} (go/func Lines "Lines returns an iterator over the newline-terminated lines in the string s.\nThe lines yielded by the iterator include their terminating newlines.\nIf s is empty, the iterator yields no lines at all.\nIf s does not end in a newline, the final yielded line will not end in a newline.\nIt returns a single-use iterator.\n" ^{:tag (iter/Seq string)} [^string s]
  ^{:go/end 31} (fn [^{:tag (func [string] [bool])} yield]
    (while (> (len s) 0)
      (let [^string line (zero string)]
        (if [i (IndexByte s \newline)] (>= i 0)
          (set! (values line s) (values (subslice s _ (+ i 1)) (subslice s (+ i 1))))

          (set! (values line s) (values s "")))

        (when (not (yield line))
          (return))))))







^{:go/end 61} (go/func splitSeq "splitSeq is SplitSeq or SplitAfterSeq, configured by how many\nbytes of sep to include in the results (none or all).\n" ^{:tag (iter/Seq string)} [^string s ^string sep ^int sepSave]
  ^{:go/end 60} (fn [^{:tag (func [string] [bool])} yield]
    (when (== (len sep) 0)
      (while (> (len s) 0)
        (let [(values _ size) (utf8/DecodeRuneInString s)]
          (when (not (yield (subslice s _ size)))
            (return))

          (set! s (subslice s size))))

      (return))

    (while true
      (let [i (Index s sep)]
        (when (< i 0)
          (break))

        (let [frag (subslice s _ (+ i sepSave))]
          (when (not (yield frag))
            (return))

          (set! s (subslice s (+ i (len sep)))))))

    (yield s)))







^{:go/end 69} (go/func SplitSeq "SplitSeq returns an iterator over all substrings of s separated by sep.\nThe iterator yields the same strings that would be returned by [Split](s, sep),\nbut without constructing the slice.\nIt returns a single-use iterator.\n" ^{:tag (iter/Seq string)} [^string s ^string sep]
  (splitSeq s sep 0))






^{:go/end 77} (go/func SplitAfterSeq "SplitAfterSeq returns an iterator over substrings of s split after each instance of sep.\nThe iterator yields the same strings that would be returned by [SplitAfter](s, sep),\nbut without constructing the slice.\nIt returns a single-use iterator.\n" ^{:tag (iter/Seq string)} [^string s ^string sep]
  (splitSeq s sep (len sep)))






^{:go/end 110} (go/func FieldsSeq "FieldsSeq returns an iterator over substrings of s split around runs of\nwhitespace characters, as defined by [unicode.IsSpace].\nThe iterator yields the same strings that would be returned by [Fields](s),\nbut without constructing the slice.\n" ^{:tag (iter/Seq string)} [^string s]
  ^{:go/end 109} (fn [^{:tag (func [string] [bool])} yield]
    (let [start -1]
      (for [i 0] (< i (len s)) _
        (let [size 1
            ^{:line 88} r (conv rune (aget s i))
            ^{:line 89} isSpace (!= (aget asciiSpace (aget s i)) 0)]
          (when (>= r utf8/RuneSelf)
            (set! (values r size) (utf8/DecodeRuneInString (subslice s i)))
            (set! isSpace (unicode/IsSpace r)))

          (cond isSpace
            (when (>= start 0)
              (when (not (yield (subslice s start i)))
                (return))

              (set! start -1))

            (< start 0)
            (set! start i))

          (set! i + size)))

      (when (>= start 0)
        (yield (subslice s start))))))








^{:go/end 137} (go/func FieldsFuncSeq "FieldsFuncSeq returns an iterator over substrings of s split around runs of\nUnicode code points satisfying f(c).\nThe iterator yields the same strings that would be returned by [FieldsFunc](s),\nbut without constructing the slice.\n" ^{:tag (iter/Seq string)} [^string s ^{:tag (func [rune] [bool])} f]
  ^{:go/end 136} (fn [^{:tag (func [string] [bool])} yield]
    (let [start -1]
      (for [i 0] (< i (len s)) _
        (let [(values r size) (utf8/DecodeRuneInString (subslice s i))]
          (cond (f r)
            (when (>= start 0)
              (when (not (yield (subslice s start i)))
                (return))

              (set! start -1))

            (< start 0)
            (set! start i))

          (set! i + size)))

      (when (>= start 0)
        (yield (subslice s start))))))

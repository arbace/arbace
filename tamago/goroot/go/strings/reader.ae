(in-ns 'go.strings) (go/file "reader.go" :imports [


    ^{:line 8} [errors "errors"]
    ^{:line 9} [io "io"]
    ^{:line 10} [utf8 "unicode/utf8"]])






(go/type Reader "A Reader implements the [io.Reader], [io.ReaderAt], [io.ByteReader], [io.ByteScanner],\n[io.RuneReader], [io.RuneScanner], [io.Seeker], and [io.WriterTo] interfaces by reading\nfrom a string.\nThe zero value for Reader operates like a Reader of an empty string.\n" (struct
    ^{:line 18 :tag string} s
    ^{:line 19 :tag int64} i ; current reading index
    ^{:line 20 :tag int} prevRune)) ; index of previous rune; or < 0




^{:go/end 30} (go/method Len "Len returns the number of bytes of the unread portion of the\nstring.\n" ^int [^{:tag (* Reader)} r]
  (when (>= (.-i r) (conv int64 (len (.-s r))))
    (return 0))

  (conv int (- (conv int64 (len (.-s r))) (.-i r))))






^{:go/end 36} (go/method Size "Size returns the original length of the underlying string.\nSize is the number of bytes available for reading via [Reader.ReadAt].\nThe returned value is always the same and is not affected by calls\nto any other method.\n" ^int64 [^{:tag (* Reader)} r] (conv int64 (len (.-s r))))


^{:go/end 47} (go/method Read "Read implements the [io.Reader] interface.\n" [^{:tag (* Reader)} r ^{:tag (slice byte)} b] :results [^int n ^error err]
  (when (>= (.-i r) (conv int64 (len (.-s r))))
    (return 0 io/EOF))

  (set! (.-prevRune r) -1)
  (set! n (copy b (subslice (.-s r) (.-i r))))
  (set! (.-i r) + (conv int64 n))
  (return))



^{:go/end 63} (go/method ReadAt "ReadAt implements the [io.ReaderAt] interface.\n" [^{:tag (* Reader)} r ^{:tag (slice byte)} b ^int64 off] :results [^int n ^error err]
  ;; cannot modify state - see io.ReaderAt
  (when (< off 0)
    (return 0 (errors/New "strings.Reader.ReadAt: negative offset")))

  (when (>= off (conv int64 (len (.-s r))))
    (return 0 io/EOF))

  (set! n (copy b (subslice (.-s r) off)))
  (when (< n (len b))
    (set! err io/EOF))

  (return))



^{:go/end 74} (go/method ReadByte "ReadByte implements the [io.ByteReader] interface.\n" [^{:tag (* Reader)} r] :results [byte error]
  (set! (.-prevRune r) -1)
  (when (>= (.-i r) (conv int64 (len (.-s r))))
    (return 0 io/EOF))

  (let [b (aget (.-s r) (.-i r))]
    (inc! (.-i r))
    (return b nil)))



^{:go/breaks [7] :go/end 84} (go/method UnreadByte "UnreadByte implements the [io.ByteScanner] interface.\n" ^error [^{:tag (* Reader)} r]
  (when (<= (.-i r) 0)
    (return (errors/New "strings.Reader.UnreadByte: at beginning of string")))

  (set! (.-prevRune r) -1)
  (dec! (.-i r))
  nil)



^{:go/end 96} (go/method ReadRune "ReadRune implements the [io.RuneReader] interface.\n" [^{:tag (* Reader)} r] :results [^rune ch ^int size ^error err]
  (when (>= (.-i r) (conv int64 (len (.-s r))))
    (set! (.-prevRune r) -1)
    (return 0 0 io/EOF))

  (set! (.-prevRune r) (conv int (.-i r)))
  (set! (values ch size) (utf8/DecodeRuneInString (subslice (.-s r) (.-i r))))
  (set! (.-i r) + (conv int64 size))
  (return))



^{:go/breaks [8] :go/end 109} (go/method UnreadRune "UnreadRune implements the [io.RuneScanner] interface.\n" ^error [^{:tag (* Reader)} r]
  (when (<= (.-i r) 0)
    (return (errors/New "strings.Reader.UnreadRune: at beginning of string")))

  (when (< (.-prevRune r) 0)
    (return (errors/New "strings.Reader.UnreadRune: previous operation was not ReadRune")))

  (set! (.-i r) (conv int64 (.-prevRune r)))
  (set! (.-prevRune r) -1)
  nil)



^{:go/end 130} (go/method Seek "Seek implements the [io.Seeker] interface.\n" [^{:tag (* Reader)} r ^int64 offset ^int whence] :results [int64 error]
  (set! (.-prevRune r) -1)
  (let [^int64 abs (zero int64)]
    (switch whence
      (case [io/SeekStart]
        (set! abs offset))
      (case [io/SeekCurrent]
        (set! abs (+ (.-i r) offset)))
      (case [io/SeekEnd]
        (set! abs (+ (conv int64 (len (.-s r))) offset)))
      (default
        (return 0 (errors/New "strings.Reader.Seek: invalid whence"))))

    (when (< abs 0)
      (return 0 (errors/New "strings.Reader.Seek: negative position")))

    (set! (.-i r) abs)
    (return abs nil)))



^{:go/end 149} (go/method WriteTo "WriteTo implements the [io.WriterTo] interface.\n" [^{:tag (* Reader)} r ^io/Writer w] :results [^int64 n ^error err]
  (set! (.-prevRune r) -1)
  (when (>= (.-i r) (conv int64 (len (.-s r))))
    (return 0 nil))

  (let [s (subslice (.-s r) (.-i r))
      (values m ^:assign err) (io/WriteString w s)]
    (when (> m (len s))
      (panic "strings.Reader.WriteTo: invalid WriteString count"))

    (set! (.-i r) + (conv int64 m))
    (set! n (conv int64 m))
    (when (and (!= m (len s)) (== err nil))
      (set! err io/ErrShortWrite))

    (return)))



^{:go/end 152} (go/method Reset "Reset resets the [Reader] to be reading from s.\n" [^{:tag (* Reader)} r ^string s] (set! @r (lit Reader s 0 -1)))



^{:go/end 156} (go/func NewReader "NewReader returns a new [Reader] reading from s.\nIt is similar to [bytes.NewBufferString] but more efficient and non-writable.\n" ^{:tag (* Reader)} [^string s] (addr (lit Reader s 0 -1)))

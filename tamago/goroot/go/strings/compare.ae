(in-ns 'go.strings) (go/file "compare.go" :imports [

    ^{:line 7} [bytealg "internal/bytealg"]])







^{:go/end 17} (go/func Compare "Compare returns an integer comparing two strings lexicographically.\nThe result will be 0 if a == b, -1 if a < b, and +1 if a > b.\n\nUse Compare when you need to perform a three-way comparison (with\n[slices.SortFunc], for example). It is usually clearer and always faster\nto use the built-in string comparison operators ==, <, >, and so on.\n" ^int [^string a ^string b]
  (bytealg/CompareString a b))

    ^{:line 7} [sync "sync"]])


(go/const ^{:val 6 :doc "All entities that do not end with ';' are 6 or fewer bytes long.\n"} longestEntityWithoutSemicolon 6)










(go/var ^{:doc "entityMaps returns entity and entity2.\n\nentity is a map from HTML entity names to their values. The semicolon matters:\nhttps://html.spec.whatwg.org/multipage/named-characters.html\nlists both \"amp\" and \"amp;\" as two separate entries.\nNote that the HTML5 list is larger than the HTML4 list at\nhttp://www.w3.org/TR/html4/sgml/entities.html\n\nentity2 is a map of HTML entities to two unicode codepoints.\n"} entityMaps (^{:inst [(map string rune) (map string (array 2 rune))]} sync/OnceValues ^{:go/end 2261} (fn [] :results [^{:tag (map string rune)} entity ^{:tag (map string (array 2 rune))} entity2]

(ns go.html.template
  (:require [arbace.go :as go]))

(go/package template
  :path "html/template"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["attr.go" "attr_string.go" "content.go" "context.go" "css.go" "delim_string.go" "doc.go" "element_string.go" "error.go" "escape.go" "html.go" "js.go" "jsctx_string.go" "state_string.go" "template.go" "transition.go" "url.go" "urlpart_string.go"]
  :init-order [attrTypeMap _attr_index errorType fmtStringerType cssReplacementTable expressionBytes mozBindingBytes _delim_index _element_index debugAllowActionJSTmpl htmlmetacontenturlescape predefinedEscapers equivEscapers redundantFuncs delimEnds specialScriptTagRE specialScriptTagReplacement doctypeBytes htmlReplacementTable htmlNormReplacementTable htmlNospaceReplacementTable htmlNospaceNormReplacementTable regexpPrecederKeywords jsonMarshalType scriptTagRe lowUnicodeReplacementTable jsStrReplacementTable jsBqStrReplacementTable jsStrNormReplacementTable jsRegexpReplacementTable _jsCtx_index _state_index escapeOK commentStart commentEnd elementContentType attrStartStates specialTagEndMarkers specialTagEndPrefix tagEndSeparators blockCommentEnd elementNameMap transitionFunc funcMap _urlPart_index]
  :positions :lines)

(load "template/attr")
(load "template/attr_string")
(load "template/content")
(load "template/context")
(load "template/css")
(load "template/delim_string")
(load "template/doc")
(load "template/element_string")
(load "template/error")
(load "template/escape")
(load "template/html")
(load "template/js")
(load "template/jsctx_string")
(load "template/state_string")
(load "template/template")
(load "template/transition")
(load "template/url")
(load "template/urlpart_string")

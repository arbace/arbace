(go/var ^{:doc "attrTypeMap[n] describes the value of the given attribute.\nIf an attribute affects (or can mask) the encoding or interpretation of\nother content, or affects the contents, idempotency, or credentials of a\nnetwork message, then the value in this map is contentTypeUnsafe.\nThis map is derived from HTML5, specifically\nhttps://www.w3.org/TR/html5/Overview.html#attributes-1\nas well as \"%URI\"-typed attributes from\nhttps://www.w3.org/TR/html4/index/attributes.html\n"} attrTypeMap (lit (map string contentType)
    ^{:line 20} ["accept" contentTypePlain]
    ^{:line 21} ["accept-charset" contentTypeUnsafe]
    ^{:line 22} ["action" contentTypeURL]
    ^{:line 23} ["alt" contentTypePlain]

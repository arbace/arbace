^{:go/end 175} (go/func attrType "attrType returns a conservative (upper-bound on authority) guess at the\ntype of the lowercase named attribute.\n" ^contentType [^string name]
  (if (strings/HasPrefix name "data-")
    ;; Strip data- so that custom attribute heuristics below are
    ;; widely applied.
    ;; Treat data-action as URL below.
    (set! name (subslice name 5))
    (when [(values prefix short ok) (strings/Cut name ":")] ok
      (when (== prefix "xmlns")
        (return contentTypeURL))

      ;; Treat svg:href and xlink:href as href below.
      (set! name short)))

  (when [(values t ok) (aget attrTypeMap name)] ok
    (return t))

  ;; Treat partial event handler names as script.
  (when (strings/HasPrefix name "on")
    (return contentTypeJS))


  ;; Heuristics to prevent "javascript:..." injection in custom
  ;; data attributes and custom attributes like g:tweetUrl.
  ;; https://www.w3.org/TR/html5/dom.html#embedding-custom-non-visible-data-with-the-data-*-attributes
  ;; "Custom data attributes are intended to store custom data
  ;;  private to the page or application, for which there are no
  ;;  more appropriate attributes or elements."
  ;; Developers seem to store URL content in data URLs that start
  ;; or end with "URI" or "URL".
  (when (or (strings/Contains name "src")
      (strings/Contains name "uri")
      (strings/Contains name "url"))
    (return contentTypeURL))

  ^{:line 174} contentTypePlain)

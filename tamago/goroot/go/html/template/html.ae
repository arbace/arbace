^{:go/end 177} (go/func htmlReplacer "htmlReplacer returns s with runes replaced according to replacementTable\nand when badRunes is true, certain bad runes are allowed through unescaped.\n" ^string [^string s ^{:tag (slice string)} replacementTable ^bool badRunes]
  (let [(values written b) (values 0 (new strings/Builder))
      (values r w) (values (conv rune 0) 0)]
    (for [i 0] (< i (len s)) (set! i + w)
      ;; Cannot use 'for range s' because we need to preserve the width
      ;; of the runes in the input. If we see a decoding error, the input
      ;; width will not be utf8.Runelen(r) and we will overrun the buffer.
      (set! (values r w) (utf8/DecodeRuneInString (subslice s i)))
      (cond (< (conv int r) (len replacementTable))
        (when [repl (aget replacementTable r)] (!= (len repl) 0)
          (when (== written 0)
            (.Grow b (len s)))

          (.WriteString b (subslice s written i))
          (.WriteString b repl)
          (set! written (+ i w)))

        ^{:line 161} badRunes (do)
        ;; No-op.
        ;; IE does not allow these ranges in unquoted attrs.
        (or (and (<= 0xfdd0 r) (<= r 0xfdef)) (and (<= 0xfff0 r) (<= r 0xffff))) (do
          (when (== written 0)
            (.Grow b (len s)))

          (fmt/Fprintf b "%s&#x%x;" (subslice s written i) r)
          (set! written (+ i w)))))


    (when (== written 0)
      (return s))

    (.WriteString b (subslice s written))
    (.String b)))




^{:go/end 229} (go/func stripTags "stripTags takes a snippet of HTML and returns only the text content.\nFor example, `<b>&iexcl;Hi!</b> <script>...</script>` -> `&iexcl;Hi! `.\n" ^string [^string html]
  (let [^strings/Builder b (zero strings/Builder)
      (values s c i allText) (values (conv (slice byte) html) (lit context) 0 true)]
    ;; Using the transition funcs helps us avoid mangling
    ;; `<div title="1>2">` or `I <3 Ponies!`.
    (while (!= i (len s))
      (when (== (.-delim c) delimNone)
        (let [st (.-state c)]
          ;; Use RCDATA instead of parsing into JS or CSS styles.
          (when (and (!= (.-element c) elementNone) (not (isInTag st)))
            (set! st stateRCDATA))

          (let [(values d nread) ((aget transitionFunc st) c (subslice s i))
              ^{:line 194} i1 (+ i nread)]
            (if (or (== (.-state c) stateText) (== (.-state c) stateRCDATA))
              ;; Emit text up to the start of the tag or comment.
              (let [j i1]
                (when (!= (.-state d) (.-state c))
                  (for [j1 (- j 1)] (>= j1 i) (dec! j1)
                    (when (== (aget s j1) \<)
                      (set! j j1)
                      (break))))



                (.Write b (subslice s i j)))

              (set! allText false))

            (set! (values c i) (values d i1))
            (continue))))

      (let [i1 (+ i (bytes/IndexAny (subslice s i) (aget delimEnds (.-delim c))))]
        (when (< i1 i)
          (break))

        (when (!= (.-delim c) delimSpaceOrTagEnd)

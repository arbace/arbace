      (or (== (.-state c) stateText) (== (.-state c) stateRCDATA))
      (.Write b (subslice s i)))

    (.String b)))




^{:go/end 260} (go/func htmlNameFilter "htmlNameFilter accepts valid parts of an HTML attribute or tag name or\na known-safe HTML attribute.\n" ^string [& ^{:tag (slice any)} args]
  (let [(values s t) (stringify (spread args))]
    (when (== t contentTypeHTMLAttr)
      (return s))

    (when (== (len s) 0)
      ;; Avoid violation of structure preservation.
      ;; <input checked {{.K}}={{.V}}>.
      ;; Without this, if .K is empty then .V is the value of
      ;; checked, but otherwise .V is the value of the attribute
      ;; named .K.
      (return filterFailsafe))

    (set! s (strings/ToLower s))
    (when [t (attrType s)] (!= t contentTypePlain)
      ;; TODO: Split attr and element name part filters so we can recognize known attributes.
      (return filterFailsafe))

    (range [_ r s]
      (switch
        (case [(and (<= \0 r) (<= r \9))])
        (case [(and (<= \a r) (<= r \z))])
        (default
          (return filterFailsafe))))


    ^{:line 259} s))









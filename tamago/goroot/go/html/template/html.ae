^{:go/end 24} (go/func htmlNospaceEscaper "htmlNospaceEscaper escapes for inclusion in unquoted attribute values.\n" ^string [& ^{:tag (slice any)} args]
  (let [(values s t) (stringify (spread args))]
    (when (== s "")
      (return filterFailsafe))

    (when (== t contentTypeHTML)
      (return (htmlReplacer (stripTags s) htmlNospaceNormReplacementTable false)))

    (htmlReplacer s htmlNospaceReplacementTable false)))



^{:go/end 33} (go/func attrEscaper "attrEscaper escapes for inclusion in quoted attribute values.\n" ^string [& ^{:tag (slice any)} args]
  (let [(values s t) (stringify (spread args))]
    (when (== t contentTypeHTML)
      (return (htmlReplacer (stripTags s) htmlNormReplacementTable true)))

    (htmlReplacer s htmlReplacementTable true)))



^{:go/end 42} (go/func rcdataEscaper "rcdataEscaper escapes for inclusion in an RCDATA element body.\n" ^string [& ^{:tag (slice any)} args]
  (let [(values s t) (stringify (spread args))]
    (when (== t contentTypeHTML)
      (return (htmlReplacer s htmlNormReplacementTable true)))

    (htmlReplacer s htmlReplacementTable true)))



^{:go/end 51} (go/func htmlEscaper "htmlEscaper escapes for inclusion in HTML text.\n" ^string [& ^{:tag (slice any)} args]
  (let [(values s t) (stringify (spread args))]
    (when (== t contentTypeHTML)
      (return s))

    (htmlReplacer s htmlReplacementTable true)))





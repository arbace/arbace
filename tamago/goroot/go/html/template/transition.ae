^{:go/end 674} (go/func eatAttrName "eatAttrName returns the largest j such that s[i:j] is an attribute name.\nIt returns an error if s[i:] does not look like it begins with an\nattribute name, such as encountering a quote mark without a preceding\nequals sign.\n" [^{:tag (slice byte)} s ^int i] :results [int (* Error)]
  (for [j i] (< j (len s)) (inc! j)
    (switch (aget s j)
      (case [\space \tab \newline \formfeed \return \= \>]
        (return j nil))
      (case [\' \" \<]
        ;; These result in a parse warning in HTML5 and are
        ;; indicative of serious problems if seen in an attr
        ;; name in a template.
        (return -1 (errorf ErrBadHTML nil 0 "%q in attribute name: %.32q" (subslice s j (+ j 1)) s)))
      (default)))
  ;; No-op.


  (return (len s) nil))


(go/var elementNameMap (lit (map string element)

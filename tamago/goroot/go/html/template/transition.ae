    (when (and (<= (+ i 3) (- (len s) 1)) (bytes/EqualFold (subslice s i (+ i 3)) (conv (slice byte) "url")))
      (when [j (eatWhiteSpace s (+ i 3))] (and (< j (len s)) (== (aget s j) \=))
        (set! (.-state c) stateMetaContentURL)
        (return c (+ j 1)))))



  (return c (len s)))



^{:go/end 653} (go/func tMetaContentURL "tMetaContentURL is the context transition function for the \"url=\" part of a meta content attribute state.\n" [^context c ^{:tag (slice byte)} s] :results [context int]

^{:go/end 687} (go/func asciiAlpha "asciiAlpha reports whether c is an ASCII letter.\n" ^bool [^byte c]
  (or (and (<= \A c) (<= c \Z)) (and (<= \a c) (<= c \z))))



^{:go/end 692} (go/func asciiAlphaNum "asciiAlphaNum reports whether c is an ASCII letter or digit.\n" ^bool [^byte c]
  (or (asciiAlpha c) (and (<= \0 c) (<= c \9))))



^{:go/end 714} (go/func eatTagName "eatTagName returns the largest j such that s[i:j] is a tag name and the tag type.\n" [^{:tag (slice byte)} s ^int i] :results [int element]
  (when (or (== i (len s)) (not (asciiAlpha (aget s i))))
    (return i elementNone))

  (let [j (+ i 1)]
    (while (< j (len s))
      (let [x (aget s j)]
        (when (asciiAlphaNum x)
          (inc! j)
          (continue))

        ;; Allow "x-y" or "x:y" but not "x-", "-y", or "x--y".
        (when (and ^:go/paren (or (== x \:) (== x \-)) (< (+ j 1) (len s)) (asciiAlphaNum (aget s (+ j 1))))
          (set! j + 2)
          (continue))

        (break)))

    (return j (aget elementNameMap (strings/ToLower (conv string (subslice s i j)))))))



^{:go/end 727} (go/func eatWhiteSpace "eatWhiteSpace returns the largest j such that s[i:j] is white space.\n" ^int [^{:tag (slice byte)} s ^int i]
  (for [j i] (< j (len s)) (inc! j)
    (switch (aget s j)
      (case [\space \tab \newline \formfeed \return])
      ;; No-op.
      (default
        (return j))))


  (len s))

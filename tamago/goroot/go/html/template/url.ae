    ^{:line 9} [strings "strings"]])
























^{:go/end 43} (go/func urlFilter "urlFilter returns its input unless it contains an unsafe scheme in which\ncase it defangs the entire URL.\n\nSchemes that cause unintended side effects that are irreversible without user\ninteraction are considered unsafe. For example, clicking on a \"javascript:\"\nlink can immediately trigger JavaScript code execution.\n\nThis filter conservatively assumes that all schemes other than the following\nare unsafe:\n  - http:   Navigates to a new website, and may open a new window or tab.\n    These side effects can be reversed by navigating back to the\n    previous website, or closing the window or tab. No irreversible\n    changes will take place without further user interaction with\n    the new website.\n  - https:  Same as http.\n  - mailto: Opens an email program and starts a new draft. This side effect\n    is not irreversible until the user explicitly clicks send; it\n    can be undone by closing the email program.\n\nTo allow URLs containing other schemes to bypass this filter, developers must\nexplicitly indicate that such a URL is expected and safe by encapsulating it\nin a template.URL value.\n" ^string [& ^{:tag (slice any)} args]
  (let [(values s t) (stringify (spread args))]
    (when (== t contentTypeURL)
      (return s))

    (when (not (isSafeURL s))
      (return (+ "#" filterFailsafe)))

    ^{:line 42} s))




^{:go/breaks [[5 53]] :go/end 54} (go/func isSafeURL "isSafeURL is true if s is a relative URL or if URL has a protocol in\n(http, https, mailto).\n" ^bool [^string s]
  (when [(values protocol _ ok) (strings/Cut s ":")] (and ok (not (strings/Contains protocol "/")))
    (when (and (not (strings/EqualFold protocol "http")) (not (strings/EqualFold protocol "https")) (not (strings/EqualFold protocol "mailto")))
      (return false)))


  true)




^{:go/end 60} (go/func urlEscaper "urlEscaper produces an output that can be embedded in a URL query.\nThe output can be embedded in an HTML attribute without further escaping.\n" ^string [& ^{:tag (slice any)} args]
  (urlProcessor false (spread args)))







^{:go/end 69} (go/func urlNormalizer "urlNormalizer normalizes URL content so it can be embedded in a quote-delimited\nstring or parenthesis delimited url(...).\nThe normalizer does not encode all HTML specials. Specifically, it does not\nencode '&' so correct embedding in an HTML attribute requires escaping of\n'&' to '&amp;'.\n" ^string [& ^{:tag (slice any)} args]
  (urlProcessor true (spread args)))




^{:go/end 83} (go/func urlProcessor "urlProcessor normalizes (when norm is true) or escapes its input to produce\na valid hierarchical or opaque URL part.\n" ^string [^bool norm & ^{:tag (slice any)} args]
  (let [(values s t) (stringify (spread args))]
    (when (== t contentTypeURL)
      (set! norm true))

    (let [^strings/Builder b (zero strings/Builder)]
      (when (processURLOnto s norm (addr b))
        (return (.String b)))

      ^{:line 82} s)))




^{:go/end 139} (go/func processURLOnto "processURLOnto appends a normalized URL corresponding to its input to b\nand reports whether the appended content differs from s.\n" ^bool [^string s ^bool norm ^{:tag (* strings/Builder)} b]
  (.Grow b (+ (len s) 16))
  (let [written 0]
    ;; The byte loop below assumes that all URLs use UTF-8 as the
    ;; content-encoding. This is similar to the URI to IRI encoding scheme
    ;; defined in section 3.1 of  RFC 3987, and behaves the same as the
    ;; EcmaScript builtin encodeURIComponent.
    ;; It should not cause any misencoding of URLs in pages with
    ;; Content-type: text/html;charset=UTF-8.
    (for [(values i n) (values 0 (len s))] (< i n) (inc! i)
      (let [c (aget s i)]
        (switch c
          ;; Single quote and parens are sub-delims in RFC 3986, but we
          ;; escape them so the output can be embedded in single
          ;; quoted attributes and unquoted CSS url(...) constructs.
          ;; Single quotes are reserved in URLs, but are only used in
          ;; the obsolete "mark" rule in an appendix in RFC 3986
          ;; so can be safely encoded.
          (case [\! \# \$ \& \* \+ \, \/ \: \; \= \? \@ \[ \]]
            (when norm
              (continue)))

          ;; Unreserved according to RFC 3986 sec 2.3
          ;; "For consistency, percent-encoded octets in the ranges of
          ;; ALPHA (%41-%5A and %61-%7A), DIGIT (%30-%39), hyphen (%2D),
          ;; period (%2E), underscore (%5F), or tilde (%7E) should not be
          ;; created by URI producers
          (case [\- \. \_ \~]
            (continue))
          (case [\%]
            ;; When normalizing do not re-encode valid escapes.
            (when (and norm (< (+ i 2) (len s)) (isHex (aget s (+ i 1))) (isHex (aget s (+ i 2))))
              (continue)))

          (default
            ;; Unreserved according to RFC 3986 sec 2.3
            (when (and (<= \a c) (<= c \z))
              (continue))

            (when (and (<= \A c) (<= c \Z))
              (continue))

            (when (and (<= \0 c) (<= c \9))
              (continue))))


        (.WriteString b (subslice s written i))
        (fmt/Fprintf b "%%%02x" c)
        (set! written (+ i 1))))

    (.WriteString b (subslice s written))
    (!= written 0)))




^{:go/end 170} (go/func srcsetFilterAndEscaper "Filters and normalizes srcset values which are comma separated\nURLs followed by metadata.\n" ^string [& ^{:tag (slice any)} args]
  (let [(values s t) (stringify (spread args))]
    (switch t
      (case [contentTypeSrcset]
        (return s))
      (case [contentTypeURL]
        ;; Normalizing gets rid of all HTML whitespace
        ;; which separate the image URL from its metadata.
        (let [^strings/Builder b (zero strings/Builder)]
          (when (processURLOnto s true (addr b))
            (set! s (.String b)))

          ;; Additionally, commas separate one source from another.
          (return (strings/ReplaceAll s "," "%2c")))))


    (let [^strings/Builder b (zero strings/Builder)
        ^{:line 160} written 0]
      (for [i 0] (< i (len s)) (inc! i)
        (when (== (aget s i) \,)
          (filterSrcsetElement s written i (addr b))
          (.WriteString b ",")
          (set! written (+ i 1))))


      (filterSrcsetElement s written (len s) (addr b))
      (.String b))))



(go/const ^{:val (byte-string "\u00006\u0000\u0000\u0001\u0000" 0xff "\u0003" 0xfe 0xff 0xff "\u0007" 0xfe 0xff 0xff "\u0007") :doc "Derived from https://play.golang.org/p/Dhmj7FORT5\n"} htmlSpaceAndASCIIAlnumBytes (byte-string "\u00006\u0000\u0000\u0001\u0000" 0xff "\u0003" 0xfe 0xff 0xff "\u0007" 0xfe 0xff 0xff "\u0007"))



^{:go/end 179} (go/func isHTMLSpace "isHTMLSpace is true iff c is a whitespace character per\nhttps://infra.spec.whatwg.org/#ascii-whitespace\n" ^bool [^byte c]
  (and ^:go/paren (<= c 0x20) (!= 0 (bit-and (aget htmlSpaceAndASCIIAlnumBytes (>> c 3)) ^byte (<< 1 (conv uint (bit-and c 0x7)))))))


^{:go/end 183} (go/func isHTMLSpaceOrASCIIAlnum ^bool [^byte c]
  (and ^:go/paren (< c 0x80) (!= 0 (bit-and (aget htmlSpaceAndASCIIAlnumBytes (>> c 3)) ^byte (<< 1 (conv uint (bit-and c 0x7)))))))


^{:go/end 216} (go/func filterSrcsetElement [^string s ^int left ^int right ^{:tag (* strings/Builder)} b]
  (let [start left]
    (while (and (< start right) (isHTMLSpace (aget s start)))
      (inc! start))

    (let [end right]
      (for [i start] (< i right) (inc! i)
        (when (isHTMLSpace (aget s i))
          (set! end i)
          (break)))


      (when [url (subslice s start end)] (isSafeURL url)
        ;; If image metadata is only spaces or alnums then
        ;; we don't need to URL normalize it.
        (let [metadataOk true]
          (for [i end] (< i right) (inc! i)
            (when (not (isHTMLSpaceOrASCIIAlnum (aget s i)))
              (set! metadataOk false)
              (break)))


          (when metadataOk
            (.WriteString b (subslice s left start))
            (processURLOnto url true b)
            (.WriteString b (subslice s end right))
            (return))))


      (.WriteString b "#")
      (.WriteString b filterFailsafe))))

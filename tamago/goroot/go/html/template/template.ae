    (return nil err))


  (let [(values ret err) (.Parse (.-text t) text)]
    (when (!= err nil)
      (return nil err))


    ;; In general, all the named templates might have changed underfoot.
    ;; Regardless, some new ones may have been defined.
    ;; The template.Template set has been updated; update ours.
    (.Lock (.-mu (.-nameSpace t)))
    (defer (.Unlock (.-mu (.-nameSpace t))))
    (range [_ v (.Templates ret)]
      (let [name (.Name v)
          ^{:line 204} tmpl (aget ^{:go/via [nameSpace]} (.-set t) name)]
        (when (== tmpl nil)
          (set! tmpl (.new t name)))

        (set! (.-text tmpl) v)
        (set! (.-Tree tmpl) (.-Tree v))))

    (return t nil)))







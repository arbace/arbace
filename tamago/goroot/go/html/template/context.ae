(go/type context "context describes the state an HTML parser must be in when it reaches the\nportion of HTML produced by evaluating a particular template node.\n\nThe zero value of type context is the start context for a template that\nproduces an HTML fragment as defined at\nhttps://www.w3.org/TR/html5/syntax.html#the-end\nwhere the context element is null.\n" (struct
    ^{:line 21 :tag state} state
    ^{:line 22 :tag delim} delim
    ^{:line 23 :tag urlPart} urlPart
    ^{:line 24 :tag jsCtx} jsCtx




    ^{:line 29 :tag (slice int) :doc "jsBraceDepth contains the current depth, for each JS template literal\nstring interpolation expression, of braces we've seen. This is used to\ndetermine if the next } will close a JS template literal string\ninterpolation expression or not.\n"} jsBraceDepth
    ^{:line 30 :tag attr} attr
    ^{:line 31 :tag element} element
    ^{:line 32 :tag parse/Node} n ; for range break/continue
    ^{:line 33 :tag (* Error)} err))


^{:go/end 42} (go/method String ^string [^context c]
  (let [^error err (zero error)]
    (when (!= (.-err c) nil)
      (set! err (.-err c)))

    (fmt/Sprintf "{%v %v %v %v %v %v %v %v}" (.-state c) (.-delim c) (.-urlPart c) (.-jsCtx c) (.-jsBraceDepth c) (.-attr c) (.-element c) err)))



^{:go/end 54} (go/method eq "eq reports whether two contexts are equal.\n" ^bool [^context c ^context d]
  (and (== (.-state c) (.-state d))
    (== (.-delim c) (.-delim d))
    (== (.-urlPart c) (.-urlPart d))
    (== (.-jsCtx c) (.-jsCtx d))
    (^{:inst [(slice int) int]} slices/Equal (.-jsBraceDepth c) (.-jsBraceDepth d))
    (== (.-attr c) (.-attr d))
    (== (.-element c) (.-element d))
    (== (.-err c) (.-err d))))




^{:go/end 83} (go/method mangle "mangle produces an identifier that includes a suffix that distinguishes it\nfrom template names mangled with different contexts.\n" ^string [^context c ^string templateName]
  ;; The mangled name for the default context is the input templateName.
  (when (== (.-state c) stateText)
    (return templateName))

  (let [s (+ templateName "$htmltemplate_" (.String (.-state c)))]
    (when (!= (.-delim c) delimNone)
      (set! s + (+ "_" (.String (.-delim c)))))

    (when (!= (.-urlPart c) urlPartNone)
      (set! s + (+ "_" (.String (.-urlPart c)))))

    (when (!= (.-jsCtx c) jsCtxRegexp)
      (set! s + (+ "_" (.String (.-jsCtx c)))))

    (when (!= (.-jsBraceDepth c) nil)
      (set! s + (fmt/Sprintf "_jsBraceDepth(%v)" (.-jsBraceDepth c))))

    (when (!= (.-attr c) attrNone)
      (set! s + (+ "_" (.String (.-attr c)))))

    (when (!= (.-element c) elementNone)
      (set! s + (+ "_" (.String (.-element c)))))

    ^{:line 82} s))



^{:go/end 90} (go/method clone "clone returns a copy of c with the same field values.\n" ^context [^context c]
  (let [clone c]
    (set! (.-jsBraceDepth clone) (^{:inst [(slice int) int]} slices/Clone (.-jsBraceDepth c)))
    ^{:line 89} clone))













(go/type state "state describes a high-level HTML parser state.\n\nIt bounds the top of the element stack, and by extension the HTML insertion\nmode, but also contains state that does not correspond to anything in the\nHTML5 parsing algorithm because a single token production in the HTML\ngrammar may contain embedded actions in a template. For instance, the quoted\nHTML attribute produced by\n\n\t<div title=\"Hello {{.World}}\">\n\nis a single token in HTML's grammar but in a template spans several nodes.\n" uint8)

(go/directive "//go:generate stringer -type state")

(go/const



  ^{:line 111} [^{:tag state :val 0 :doc "stateText is parsed character data. An HTML parser is in\nthis state when its parse position is outside an HTML tag,\ndirective, comment, and special element body.\n"} stateText iota]

  ^{:line 113} [^{:val 1 :doc "stateTag occurs before an HTML attribute or the end of a tag.\n"} stateTag]


  ^{:line 116} [^{:val 2 :doc "stateAttrName occurs inside an attribute name.\nIt occurs between the ^'s in ` ^name^ = value`.\n"} stateAttrName]


  ^{:line 119} [^{:val 3 :doc "stateAfterName occurs after an attr name has ended but before any\nequals sign. It occurs between the ^'s in ` name^ ^= value`.\n"} stateAfterName]


  ^{:line 122} [^{:val 4 :doc "stateBeforeValue occurs after the equals sign but before the value.\nIt occurs between the ^'s in ` name =^ ^value`.\n"} stateBeforeValue]

  ^{:line 124} [^{:val 5 :doc "stateHTMLCmt occurs inside an <!-- HTML comment -->.\n"} stateHTMLCmt]


  ^{:line 127} [^{:val 6 :doc "stateRCDATA occurs inside an RCDATA element (<textarea> or <title>)\nas described at https://www.w3.org/TR/html5/syntax.html#elements-0\n"} stateRCDATA]

  ^{:line 129} [^{:val 7 :doc "stateAttr occurs inside an HTML attribute whose content is text.\n"} stateAttr]

  ^{:line 131} [^{:val 8 :doc "stateURL occurs inside an HTML attribute whose content is a URL.\n"} stateURL]

  ^{:line 133} [^{:val 9 :doc "stateSrcset occurs inside an HTML srcset attribute.\n"} stateSrcset]

  ^{:line 135} [^{:val 10 :doc "stateJS occurs inside an event handler or script element.\n"} stateJS]

  ^{:line 137} [^{:val 11 :doc "stateJSDqStr occurs inside a JavaScript double quoted string.\n"} stateJSDqStr]

  ^{:line 139} [^{:val 12 :doc "stateJSSqStr occurs inside a JavaScript single quoted string.\n"} stateJSSqStr]

  ^{:line 141} [^{:val 13 :doc "stateJSTmplLit occurs inside a JavaScript back quoted string.\n"} stateJSTmplLit]

  ^{:line 143} [^{:val 14 :doc "stateJSRegexp occurs inside a JavaScript regexp literal.\n"} stateJSRegexp]

  ^{:line 145} [^{:val 15 :doc "stateJSBlockCmt occurs inside a JavaScript /* block comment */.\n"} stateJSBlockCmt]


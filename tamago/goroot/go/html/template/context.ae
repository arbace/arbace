  ^{:line 149} [^{:val 17 :doc "stateJSHTMLOpenCmt occurs inside a JavaScript <!-- HTML-like comment.\n"} stateJSHTMLOpenCmt]

  ^{:line 151} [^{:val 18 :doc "stateJSHTMLCloseCmt occurs inside a JavaScript --> HTML-like comment.\n"} stateJSHTMLCloseCmt]

  ^{:line 153} [^{:val 19 :doc "stateCSS occurs inside a <style> element or style attribute.\n"} stateCSS]


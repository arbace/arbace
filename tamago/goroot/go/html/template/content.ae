^{:go/end 128} (go/func indirect "indirect returns the value, after dereferencing as many times\nas necessary to reach the base type (or nil).\n" ^any [^any a]
  (when (== a nil)
    (return nil))

  (when [t (reflect/TypeOf a)] (!= (.Kind t) reflect/Pointer)
    ;; Avoid creating a reflect.Value if it's not a pointer.
    (return a))

  (let [v (reflect/ValueOf a)]
    (while (and (== (.Kind v) reflect/Pointer) (not (.IsNil v)))
      (set! v (.Elem v)))

    (.Interface v)))


(go/var
  ^{:line 131} [errorType ((inst reflect/TypeFor error))]
  ^{:line 132} [fmtStringerType ((inst reflect/TypeFor fmt/Stringer))])





^{:go/end 147} (go/func indirectToStringerOrError "indirectToStringerOrError returns the value, after dereferencing as many times\nas necessary to reach the base type (or nil) or an implementation of fmt.Stringer\nor error.\n" ^any [^any a]
  (when (== a nil)
    (return nil))

  (let [v (reflect/ValueOf a)]
    (while (and (not (.Implements (.Type v) fmtStringerType)) (not (.Implements (.Type v) errorType)) (== (.Kind v) reflect/Pointer) (not (.IsNil v)))
      (set! v (.Elem v)))

    (.Interface v)))




^{:go/end 185} (go/func stringify "stringify converts its arguments to a string and the type of the content.\nAll pointers are dereferenced, as in the text/template package.\n" [& ^{:tag (slice any)} args] :results [string contentType]
  (when (== (len args) 1)
    (type-switch [s (indirect (aget args 0))]
      (case [string]
        (return s contentTypePlain))
      (case [CSS]
        (return (conv string s) contentTypeCSS))
      (case [HTML]
        (return (conv string s) contentTypeHTML))
      (case [HTMLAttr]
        (return (conv string s) contentTypeHTMLAttr))
      (case [JS]
        (return (conv string s) contentTypeJS))
      (case [JSStr]
        (return (conv string s) contentTypeJSStr))
      (case [URL]
        (return (conv string s) contentTypeURL))
      (case [Srcset]
        (return (conv string s) contentTypeSrcset))))


  (let [i 0]
    (range [_ arg args]
      ;; We skip untyped nil arguments for backward compatibility.
      ;; Without this they would be output as <nil>, escaped.
      ;; See issue 25875.
      (when (== arg nil)
        (continue))


      (aset args i (indirectToStringerOrError arg))
      (inc! i))

    (return (fmt/Sprint (spread (subslice args _ i))) contentTypePlain)))

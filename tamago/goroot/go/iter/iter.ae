          ^{:line 264 :tag bool} ok
          ^{:line 265 :go/grouped false :tag bool} done
          ^{:line 266 :go/grouped false :tag bool} yieldNext
          ^{:line 267 :go/grouped false :tag bool} seqDone ; to detect Goexit
          ^{:line 268 :tag int} racer
          ^{:line 269 :tag any} panicValue))

      ^{:line 271} c (newcoro ^{:go/end 305} (fn [^{:tag (* coro)} c]
          (race/Acquire (conv unsafe/Pointer (addr (.-racer pull))))
          (when (.-done pull)
            (race/Release (conv unsafe/Pointer (addr (.-racer pull))))
            (return))

          (let [yield ^{:go/end 290} (fn ^bool [^V v1]
                (when (.-done pull)
                  (return false))

                (when (not (.-yieldNext pull))
                  (panic "iter.Pull: yield called again before next"))

                (set! (.-yieldNext pull) false)
                (set! (values (.-v pull) (.-ok pull)) (values v1 true))
                (race/Release (conv unsafe/Pointer (addr (.-racer pull))))
                (coroswitch c)
                (race/Acquire (conv unsafe/Pointer (addr (.-racer pull))))
                (not (.-done pull)))]

            ;; Recover and propagate panics from seq.
            (defer (^{:go/end 300} (fn []
                  (if [p (recover)] (!= p nil)
                    (set! (.-panicValue pull) p)
                    (when (not (.-seqDone pull))
                      (set! (.-panicValue pull) goexitPanicValue)))

                  (set! (.-done pull) true) ; Invalidate iterator
                  (race/Release (conv unsafe/Pointer (addr (.-racer pull)))))))

            (seq yield)
            (let [^V v0 (zero V)]

    (set! next ^{:go/end 330} (fn [] :results [^V v1 ^bool ok1]
        (race/Write (conv unsafe/Pointer (addr (.-racer pull)))) ; detect races

        (when (.-done pull)
          (return))

        (when (.-yieldNext pull)
          (panic "iter.Pull: next called again before yield"))

        (set! (.-yieldNext pull) true)
        (race/Release (conv unsafe/Pointer (addr (.-racer pull))))
        (coroswitch c)
        (race/Acquire (conv unsafe/Pointer (addr (.-racer pull))))

        ;; Propagate panics and goexits from seq.
        (when (!= (.-panicValue pull) nil)
          (if (== (.-panicValue pull) goexitPanicValue)
            ;; Propagate runtime.Goexit from seq.
            (runtime/Goexit)

            (panic (.-panicValue pull))))


        (return (.-v pull) (.-ok pull))))

    (set! stop ^{:go/end 350} (fn []
        (race/Write (conv unsafe/Pointer (addr (.-racer pull)))) ; detect races

        (when (not (.-done pull))
          (set! (.-done pull) true)
          (race/Release (conv unsafe/Pointer (addr (.-racer pull))))

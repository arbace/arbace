(ns go.io.ioutil
  (:require [arbace.go :as go]))

(go/package ioutil
  :path "io/ioutil"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["ioutil.go" "tempfile.go"]
  :init-order [Discard]
  :positions :lines)

(load "ioutil/ioutil")
(load "ioutil/tempfile")

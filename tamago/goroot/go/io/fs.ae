(ns go.io.fs
  (:require [arbace.go :as go]))

(go/package fs
  :path "io/fs"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["format.go" "fs.go" "glob.go" "readdir.go" "readfile.go" "readlink.go" "stat.go" "sub.go" "walk.go"]
  :init-order [ErrInvalid ErrPermission ErrExist ErrNotExist ErrClosed ["sub.go" 50 5] ["sub.go" 51 5] ["sub.go" 52 5] ["sub.go" 53 5] ["sub.go" 54 5] SkipDir SkipAll]
  :positions :lines)

(load "fs/format")
(load "fs/fs")
(load "fs/glob")
(load "fs/readdir")
(load "fs/readfile")
(load "fs/readlink")
(load "fs/stat")
(load "fs/sub")
(load "fs/walk")

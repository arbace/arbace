(ns go.io.fs
  (:require [arbace.go :as go]))

(go/package fs
  :path "io/fs"
  :files ["format.go" "fs.go" "glob.go" "readdir.go" "readfile.go" "readlink.go" "stat.go" "sub.go" "walk.go"]
  :positions :lines)

(load "fs/format")
(load "fs/fs")
(load "fs/glob")
(load "fs/readdir")
(load "fs/readfile")
(load "fs/readlink")
(load "fs/stat")
(load "fs/sub")
(load "fs/walk")

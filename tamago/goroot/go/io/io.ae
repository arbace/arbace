          ;; Build our final right-sized slice.
          (set! finalSize + (len b))
          (let [final (subslice (append (conv (slice byte) nil) (spread (make (slice byte) finalSize))) _ 0)]
            (range [_ chunk chunks]
              (set! final (append final (spread chunk))))

            (set! final (append final (spread b)))
            (return final err)))


        (when (< (- (cap b) (len b)) (/ (cap b) 16))
          ;; Move to the next intermediate slice.
          (set! chunks (append chunks b))
          (set! finalSize + (len b))
          (set! b (subslice (append (conv (slice byte) nil) (spread (make (slice byte) next))) _ 0))
          (set! next + (/ next 2)))))))

(go/type PipeReader "A PipeReader is the read half of a pipe.\n" (struct pipe))






^{:go/end 135} (go/method Read "Read implements the standard Read interface:\nit reads data from the pipe, blocking until a writer\narrives or the write end is closed.\nIf the write end is closed with an error, that error is\nreturned as err; otherwise err is EOF.\n" [^{:tag (* PipeReader)} r ^{:tag (slice byte)} data] :results [^int n ^error err]

(in-ns 'go.io.fs) (go/file "readdir.go" :imports [


    ^{:line 8} [errors "errors"]
    ^{:line 9} [bytealg "internal/bytealg"]
    ^{:line 10} [slices "slices"]])




(go/type ReadDirFS "ReadDirFS is the interface implemented by a file system\nthat provides an optimized implementation of [ReadDir].\n" (interface
    ^{:line 16} FS



    (^{:doc "ReadDir reads the named directory\nand returns a list of directory entries sorted by filename.\n"} ReadDir [^string name] :results [(slice DirEntry) error])))








^{:go/end 50} (go/func ReadDir "ReadDir reads the named directory\nand returns a list of directory entries sorted by filename.\n\nIf fsys implements [ReadDirFS], ReadDir calls fsys.ReadDir.\nOtherwise ReadDir calls fsys.Open and uses ReadDir and Close\non the returned [ReadDirFile].\n" [^FS fsys ^string name] :results [(slice DirEntry) error]
  (when [(values fsys ok) (assert ReadDirFS fsys)] ok
    (return (.ReadDir fsys name)))


  (let [(values file err) (.Open fsys name)]
    (when (!= err nil)
      (return nil err))

    (defer (.Close file))

    (let [(values dir ok) (assert ReadDirFile file)]
      (when (not ok)
        (return nil (addr (lit PathError :Op "readdir" :Path name :Err (errors/New "not implemented")))))


      (let [(values list ^:assign err) (.ReadDir dir -1)]
        (^{:inst [(slice DirEntry) DirEntry]} slices/SortFunc list ^{:go/end 48} (fn ^int [^DirEntry a ^DirEntry b]
            (bytealg/CompareString (.Name a) (.Name b))))

        (return list err)))))



(go/type dirInfo "dirInfo is a DirEntry based on a FileInfo.\n" (struct
    ^{:line 54 :tag FileInfo} fileInfo))


^{:go/end 59} (go/method IsDir ^bool [^dirInfo di]
  (.IsDir (.-fileInfo di)))


^{:go/end 63} (go/method Type ^FileMode [^dirInfo di]
  (.Type (.Mode (.-fileInfo di))))


^{:go/end 67} (go/method Info [^dirInfo di] :results [FileInfo error]
  (return (.-fileInfo di) nil))


^{:go/end 71} (go/method Name ^string [^dirInfo di]
  (.Name (.-fileInfo di)))


^{:go/end 75} (go/method String ^string [^dirInfo di]
  (FormatDirEntry di))




^{:go/end 84} (go/func FileInfoToDirEntry "FileInfoToDirEntry returns a [DirEntry] that returns information from info.\nIf info is nil, FileInfoToDirEntry returns nil.\n" ^DirEntry [^FileInfo info]
  (when (== info nil)
    (return nil))

  (lit dirInfo :fileInfo info))

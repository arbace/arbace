(in-ns 'go.io.fs) (go/file "readlink.go" :imports [])



(go/type ReadLinkFS "ReadLinkFS is the interface implemented by a file system\nthat supports reading symbolic links.\n" (interface
    ^{:line 10} FS



    (^{:doc "ReadLink returns the destination of the named symbolic link.\nIf there is an error, it should be of type [*PathError].\n"} ReadLink [^string name] :results [string error])





    (^{:doc "Lstat returns a [FileInfo] describing the named file.\nIf the file is a symbolic link, the returned [FileInfo] describes the symbolic link.\nLstat makes no attempt to follow the link.\nIf there is an error, it should be of type [*PathError].\n"} Lstat [^string name] :results [FileInfo error])))





^{:go/end 32} (go/func ReadLink "ReadLink returns the destination of the named symbolic link.\n\nIf fsys does not implement [ReadLinkFS], then ReadLink returns an error.\n" [^FS fsys ^string name] :results [string error]
  (let [(values sym ok) (assert ReadLinkFS fsys)]
    (when (not ok)
      (return "" (addr (lit PathError :Op "readlink" :Path name :Err ErrInvalid))))

    (.ReadLink sym name)))







^{:go/end 45} (go/func Lstat "Lstat returns a [FileInfo] describing the named file.\nIf the file is a symbolic link, the returned [FileInfo] describes the symbolic link.\nLstat makes no attempt to follow the link.\n\nIf fsys does not implement [ReadLinkFS], then Lstat is identical to [Stat].\n" [^FS fsys ^string name] :results [FileInfo error]
  (let [(values sym ok) (assert ReadLinkFS fsys)]
    (when (not ok)
      (return (Stat fsys name)))

    (.Lstat sym name)))

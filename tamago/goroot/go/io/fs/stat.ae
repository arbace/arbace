(in-ns 'go.io.fs) (go/file "stat.go" :imports [])


(go/type StatFS "A StatFS is a file system with a Stat method.\n" (interface
    ^{:line 9} FS



    (^{:doc "Stat returns a FileInfo describing the file.\nIf there is an error, it should be of type *PathError.\n"} Stat [^string name] :results [FileInfo error])))






^{:go/end 31} (go/func Stat "Stat returns a [FileInfo] describing the named file from the file system.\n\nIf fsys implements [StatFS], Stat calls fsys.Stat.\nOtherwise, Stat opens the [File] to stat it.\n" [^FS fsys ^string name] :results [FileInfo error]
  (when [(values fsys ok) (assert StatFS fsys)] ok
    (return (.Stat fsys name)))


  (let [(values file err) (.Open fsys name)]
    (when (!= err nil)
      (return nil err))

    (defer (.Close file))
    (.Stat file)))

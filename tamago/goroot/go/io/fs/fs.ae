  ^{:line 154} [ErrInvalid (errInvalid)] ; "invalid argument"
  ^{:line 155} [ErrPermission (errPermission)] ; "permission denied"
  ^{:line 156} [ErrExist (errExist)] ; "file already exists"
  ^{:line 157} [ErrNotExist (errNotExist)]) ; "file does not exist"





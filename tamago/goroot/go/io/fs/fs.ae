(go/type FileInfo "A FileInfo describes a file and is returned by [Stat].\n" (interface
    (Name ^string []) ; base name of the file
    (Size ^int64 []) ; length in bytes for regular files; system-dependent for others
    (Mode ^FileMode []) ; file mode bits
    (ModTime ^time/Time []) ; modification time
    (IsDir ^bool []) ; abbreviation for Mode().IsDir()
    (Sys ^any []))) ; underlying data source (can return nil)







(go/type FileMode "A FileMode represents a file's mode and permission bits.\nThe bits have the same definition on all systems, so that\ninformation about files can be moved from one system\nto another portably. Not all bits apply to all systems.\nThe only required bit is [ModeDir] for directories.\n" uint32)






(go/const "The defined file mode bits are the most significant bits of the [FileMode].\nThe nine least-significant bits are the standard Unix rwxrwxrwx permissions.\nThe values of these bits should be considered part of the public API and\nmay be used in wire protocols or disk representations: they must not be\nchanged, although new bits might be added.\n"


  ^{:line 195} [^{:tag FileMode :val 2147483648 :doc "The single letters are the abbreviations\nused by the String method's formatting.\n"} ModeDir (<< 1 (- 32 1 iota))] ; d: is a directory
  ^{:line 196} [^{:val 1073741824} ModeAppend] ; a: append-only
  ^{:line 197} [^{:val 536870912} ModeExclusive] ; l: exclusive use
  ^{:line 198} [^{:val 268435456} ModeTemporary] ; T: temporary file; Plan 9 only
  ^{:line 199} [^{:val 134217728} ModeSymlink] ; L: symbolic link
  ^{:line 200} [^{:val 67108864} ModeDevice] ; D: device file
  ^{:line 201} [^{:val 33554432} ModeNamedPipe] ; p: named pipe (FIFO)
  ^{:line 202} [^{:val 16777216} ModeSocket] ; S: Unix domain socket
  ^{:line 203} [^{:val 8388608} ModeSetuid] ; u: setuid
  ^{:line 204} [^{:val 4194304} ModeSetgid] ; g: setgid
  ^{:line 205} [^{:val 2097152} ModeCharDevice] ; c: Unix character device, when ModeDevice is set
  ^{:line 206} [^{:val 1048576} ModeSticky] ; t: sticky
  ^{:line 207} [^{:val 524288} ModeIrregular] ; ?: non-regular file; nothing else is known about this file


  ^{:line 210} [^{:val 2401763328 :doc "Mask for the type bits. For regular files, none will be set.\n"} ModeType (bit-or ModeDir ModeSymlink ModeNamedPipe ModeSocket ModeDevice ModeCharDevice ModeIrregular)]

  ^{:line 212} [^{:tag FileMode :val 511} ModePerm 0777]) ; Unix permission bits


^{:go/end 239} (go/method String ^string [^FileMode m]
  (let [^:const ^{:val "dalTLDpSugct?"} str "dalTLDpSugct?"
      ^{:line 217 :tag (array 32 byte)} buf (zero (array 32 byte)) ; Mode is uint32.
      ^{:line 218} w 0]
    (range [i c str]
      (when (!= (bit-and m ^FileMode (<< 1 (conv uint (- 32 1 i)))) 0)
        (aset buf w (conv byte c))
        (inc! w)))


    (when (== w 0)
      (aset buf w \-)
      (inc! w))

    (let [^:const ^{:val "rwxrwxrwx"} rwx "rwxrwxrwx"]
      (range [i c rwx]
        (if (!= (bit-and m ^FileMode (<< 1 (conv uint (- 9 1 i)))) 0)
          (aset buf w (conv byte c))

          (aset buf w \-))

        (inc! w))

      (conv string (subslice buf _ w)))))




^{:go/end 245} (go/method IsDir "IsDir reports whether m describes a directory.\nThat is, it tests for the [ModeDir] bit being set in m.\n" ^bool [^FileMode m]
  (!= (bit-and m ModeDir) 0))




^{:go/end 251} (go/method IsRegular "IsRegular reports whether m describes a regular file.\nThat is, it tests that no mode type bits are set.\n" ^bool [^FileMode m]
  (== (bit-and m ModeType) 0))



^{:go/end 256} (go/method Perm "Perm returns the Unix permission bits in m (m & [ModePerm]).\n" ^FileMode [^FileMode m]
  (bit-and m ModePerm))



^{:go/end 261} (go/method Type "Type returns type bits in m (m & [ModeType]).\n" ^FileMode [^FileMode m]
  (bit-and m ModeType))




(go/type SubFS "A SubFS is a file system with a Sub method.\n" (interface
    ^{:line 14} FS


    (^{:doc "Sub returns an FS corresponding to the subtree rooted at dir.\n"} Sub [^string dir] :results [FS error])))



















^{:go/end 48} (go/func Sub "Sub returns an [FS] corresponding to the subtree rooted at fsys's dir.\n\nIf dir is \".\", Sub returns fsys unchanged.\nOtherwise, if fsys implements [SubFS], Sub returns fsys.Sub(dir).\nOtherwise, Sub returns a new [FS] implementation sub that,\nin effect, implements sub.Open(name) as fsys.Open(path.Join(dir, name)).\nThe implementation also translates calls to ReadDir, ReadFile,\nReadLink, Lstat, and Glob appropriately. Sub does not check if the\ndirectory currently exists.\n\nNote that Sub(os.DirFS(\"/\"), \"prefix\") is equivalent to os.DirFS(\"/prefix\")\nand that neither of them guarantees to avoid operating system\naccesses outside \"/prefix\", because the implementation of [os.DirFS]\ndoes not check for symbolic links inside \"/prefix\" that point to\nother directories. That is, [os.DirFS] is not a general substitute for a\nchroot-style security mechanism, and Sub does not change that fact.\nUse [os.Root] to constrain access to particular directory trees.\n" [^FS fsys ^string dir] :results [FS error]
  (when (not (ValidPath dir))
    (return nil (addr (lit PathError :Op "sub" :Path dir :Err ErrInvalid))))

  (when (== dir ".")
    (return fsys nil))

  (when [(values fsys ok) (assert SubFS fsys)] ok
    (return (.Sub fsys dir)))

  (return (addr (lit subFS fsys dir)) nil))


(go/var ^FS _ (conv (* subFS) nil))
(go/var ^ReadDirFS _ (conv (* subFS) nil))
(go/var ^ReadFileFS _ (conv (* subFS) nil))
(go/var ^ReadLinkFS _ (conv (* subFS) nil))
(go/var ^GlobFS _ (conv (* subFS) nil))

(go/type subFS (struct
    ^{:line 57 :tag FS} fsys
    ^{:line 58 :tag string} dir))



^{:go/end 67} (go/method fullName "fullName maps name to the fully-qualified name dir/name.\n" [^{:tag (* subFS)} f ^string op ^string name] :results [string error]
  (when (not (ValidPath name))
    (return "" (addr (lit PathError :Op op :Path name :Err ErrInvalid))))

  (return (path/Join (.-dir f) name) nil))



^{:go/end 78} (go/method shorten "shorten maps name, which should start with f.dir, back to the suffix after f.dir.\n" [^{:tag (* subFS)} f ^string name] :results [^string rel ^bool ok]
  (when (== name (.-dir f))
    (return "." true))

  (when (and (>= (len name) (+ (len (.-dir f)) 2)) (== (aget name (len (.-dir f))) \/) (== (subslice name _ (len (.-dir f))) (.-dir f)))
    (return (subslice name (+ (len (.-dir f)) 1)) true))

  (return "" false))



^{:go/end 88} (go/method fixErr "fixErr shortens any reported names in PathErrors by stripping f.dir.\n" ^error [^{:tag (* subFS)} f ^error err]
  (when [(values e ok) (assert (* PathError) err)] ok
    (when [(values short ok) (.shorten f (.-Path e))] ok
      (set! (.-Path e) short)))


  ^{:line 87} err)


^{:go/end 97} (go/method Open [^{:tag (* subFS)} f ^string name] :results [File error]
  (let [(values full err) (.fullName f "open" name)]
    (when (!= err nil)
      (return nil err))

    (let [(values file ^:assign err) (.Open (.-fsys f) full)]
      (return file (.fixErr f err)))))


^{:go/end 106} (go/method ReadDir [^{:tag (* subFS)} f ^string name] :results [(slice DirEntry) error]
  (let [(values full err) (.fullName f "read" name)]
    (when (!= err nil)
      (return nil err))

    (let [(values dir ^:assign err) (ReadDir (.-fsys f) full)]
      (return dir (.fixErr f err)))))


^{:go/end 115} (go/method ReadFile [^{:tag (* subFS)} f ^string name] :results [(slice byte) error]
  (let [(values full err) (.fullName f "read" name)]
    (when (!= err nil)
      (return nil err))

    (let [(values data ^:assign err) (ReadFile (.-fsys f) full)]
      (return data (.fixErr f err)))))


^{:go/end 127} (go/method ReadLink [^{:tag (* subFS)} f ^string name] :results [string error]
  (let [(values full err) (.fullName f "readlink" name)]
    (when (!= err nil)
      (return "" err))

    (let [(values target ^:assign err) (ReadLink (.-fsys f) full)]
      (when (!= err nil)
        (return "" (.fixErr f err)))

      (return target nil))))


^{:go/end 139} (go/method Lstat [^{:tag (* subFS)} f ^string name] :results [FileInfo error]
  (let [(values full err) (.fullName f "lstat" name)]
    (when (!= err nil)
      (return nil err))

    (let [(values info ^:assign err) (Lstat (.-fsys f) full)]
      (when (!= err nil)
        (return nil (.fixErr f err)))

      (return info nil))))


^{:go/end 160} (go/method Glob [^{:tag (* subFS)} f ^string pattern] :results [(slice string) error]
  ;; Check pattern is well-formed.
  (when [(values _ err) (path/Match pattern "")] (!= err nil)
    (return nil err))

  (when (== pattern ".")
    (return (lit (slice string) ".") nil))


  (let [full (+ (.-dir f) "/" pattern)
      (values list err) (Glob (.-fsys f) full)]
    (range [i name list]
      (let [(values name ok) (.shorten f name)]
        (when (not ok)
          (return nil (errors/New (+ "invalid result from inner fsys Glob: " name " not in " (.-dir f))))) ; can't use fmt in this package

        (aset list i name)))

    (return list (.fixErr f err))))


^{:go/end 171} (go/method Sub [^{:tag (* subFS)} f ^string dir] :results [FS error]
  (when (== dir ".")
    (return f nil))

  (let [(values full err) (.fullName f "sub" dir)]
    (when (!= err nil)
      (return nil err))

    (return (addr (lit subFS (.-fsys f) full)) nil)))

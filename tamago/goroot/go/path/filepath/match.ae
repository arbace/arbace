^{:go/end 89} (go/func Match "Match reports whether name matches the shell file name pattern.\nThe pattern syntax is:\n\n\tpattern:\n\t\t{ term }\n\tterm:\n\t\t'*'         matches any sequence of non-Separator characters\n\t\t'?'         matches any single non-Separator character\n\t\t'[' [ '^' ] { character-range } ']'\n\t\t            character class (must be non-empty)\n\t\tc           matches character c (c != '*', '?', '\\\\', '[')\n\t\t'\\\\' c      matches character c (except on Windows)\n\n\tcharacter-range:\n\t\tc           matches character c (c != '\\\\', '-', ']')\n\t\t'\\\\' c      matches character c (except on Windows)\n\t\tlo '-' hi   matches character c for lo <= c <= hi\n\nPath segments in the pattern must be separated by [Separator].\n\nMatch requires pattern to match all of name, not just a substring.\nThe only possible returned error is [ErrBadPattern], when pattern\nis malformed.\n\nOn Windows, escaping is disabled. Instead, '\\\\' is treated as\npath separator.\n" [^string pattern ^string name] :results [^bool matched ^error err]
  (label :Pattern
    (while (> (len pattern) 0)
      (let [^bool star (zero bool)
          ^{:line 50 :tag string} chunk (zero string)]
        (set! (values star chunk pattern) (scanChunk pattern))
        (when (and star (== chunk ""))
          ;; Trailing * matches rest of string unless it has a /.
          (return (not (strings/Contains name (conv string Separator))) nil))

        ;; Look for match at current position.
        (let [(values t ok err) (matchChunk chunk name)]
          ;; if we're the last chunk, make sure we've exhausted the name
          ;; otherwise we'll give a false result even if we could still match
          ;; using the star
          (when (and ok ^:go/paren (or (== (len t) 0) (> (len pattern) 0)))
            (set! name t)
            (continue))

          (when (!= err nil)
            (return false err))

          (when star
            ;; Look for match skipping i+1 bytes.
            ;; Cannot skip /.
            (for [i 0] (and (< i (len name)) (!= (aget name i) Separator)) (inc! i)
              (let [(values t ok err) (matchChunk chunk (subslice name (+ i 1)))]
                (when ok
                  ;; if we're the last chunk, make sure we exhausted the name
                  (when (and (== (len pattern) 0) (> (len t) 0))
                    (continue))

                  (set! name t)
                  (continue :Pattern))

                (when (!= err nil)
                  (return false err)))))



          (return false nil)))))

  (return (== (len name) 0) nil))




^{:go/end 117} (go/func scanChunk "scanChunk gets the next segment of pattern, which is a non-star string\npossibly preceded by a star.\n" [^string pattern] :results [^bool star ^string chunk ^string rest]
  (while (and (> (len pattern) 0) (== (aget pattern 0) \*))
    (set! pattern (subslice pattern 1))
    (set! star true))

  (let [inrange false]
    (for [i 0] (< i (len pattern)) (inc! i)
      (switch (aget pattern i)
        (case [\\]
          ;; error check handled in matchChunk: bad pattern.
          (when (and (!= runtime/GOOS "windows") (< (+ i 1) (len pattern)))
            (inc! i)))

        (case [\[]
          (set! inrange true))
        (case [\]]
          (set! inrange false))
        (case [\*]
          (when (not inrange)
            (return star (subslice pattern _ i) (subslice pattern i))))))



    (return star pattern "")))





^{:go/end 197} (go/func matchChunk "matchChunk checks whether chunk matches the beginning of s.\nIf so, it returns the remainder of s (after the match).\nChunk is all single-character operators: literals, char classes, and ?.\n" [^string chunk ^string s] :results [^string rest ^bool ok ^error err]
  ;; failed records whether the match has failed.
  ;; After the match fails, the loop continues on processing chunk,
  ;; checking that the pattern is well-formed but no longer reading s.
  (let [failed false]
    (while (> (len chunk) 0)
      (set! failed (or failed (== (len s) 0)))
      (switch (aget chunk 0)
        (case [\[]
          ;; character class
          (let [^rune r (zero rune)]
            (when (not failed)
              (let [^int n (zero int)]

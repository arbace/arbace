;; Package filepath implements utility routines for manipulating filename paths
;; in a way compatible with the target operating system-defined file paths.
;;
;; The filepath package uses either forward slashes or backslashes,
;; depending on the operating system. To process paths such as URLs
;; that always use forward slashes regardless of the operating
;; system, see the [path] package.
(in-ns 'go.path.filepath) (go/file "path.go" :doc "Package filepath implements utility routines for manipulating filename paths\nin a way compatible with the target operating system-defined file paths.\n\nThe filepath package uses either forward slashes or backslashes,\ndepending on the operating system. To process paths such as URLs\nthat always use forward slashes regardless of the operating\nsystem, see the [path] package.\n" :imports [


    ^{:line 15} [errors "errors"]
    ^{:line 16} [bytealg "internal/bytealg"]
    ^{:line 17} [filepathlite "internal/filepathlite"]
    ^{:line 18} [fs "io/fs"]
    ^{:line 19} [os "os"]
    ^{:line 20} [slices "slices"]])



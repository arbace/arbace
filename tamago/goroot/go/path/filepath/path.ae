  (filepathlite/IsAbs path))







^{:go/end 163} (go/func Abs "Abs returns an absolute representation of path.\nIf the path is not absolute it will be joined with the current\nworking directory to turn it into an absolute path. The absolute\npath name for a given file is not guaranteed to be unique.\nAbs calls [Clean] on the result.\n" [^string path] :results [string error]
  (abs path))


^{:go/end 174} (go/func unixAbs [^string path] :results [string error]
  (when (IsAbs path)
    (return (Clean path) nil))

  (let [(values wd err) (os/Getwd)]
    (when (!= err nil)
      (return "" err))

    (return (Join wd path) nil)))












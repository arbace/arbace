  (when [err (walkDirFn path d nil)] (or (!= err nil) (not (.IsDir d)))
    (when (and (== err SkipDir) (.IsDir d))
      ;; Successfully skipped directory.
      (set! err nil))

    (return err))


  ^{:go/breaks [[4 340]]} (let [(values dirs err) (os/ReadDir path)]
    (when (!= err nil)
      ;; Second call, to report ReadDir error.
      (set! err (walkDirFn path d err))
      (when (!= err nil)
        (when (and (== err SkipDir) (.IsDir d))
          (set! err nil))

        (return err)))



    (range [_ d1 dirs]
      (let [path1 (Join path (.Name d1))]
        (when [err (walkDir path1 d1 walkDirFn)] (!= err nil)
          (when (== err SkipDir)
            (break))

          (return err))))


    nil))




(in-ns 'go.path.filepath) (go/file "path_unix.go" :build ["//go:build unix || (js && wasm) || wasip1 || tamago"] :imports [


    ^{:line 10} [strings "strings"]])






^{:go/end 19} (go/func HasPrefix "HasPrefix exists for historical compatibility and should not be used.\n\nDeprecated: HasPrefix does not respect path boundaries and\ndoes not ignore case when required.\n" ^bool [^string p ^string prefix]
  (strings/HasPrefix p prefix))


^{:go/end 26} (go/func splitList ^{:tag (slice string)} [^string path]
  (when (== path "")
    (return (lit (slice string))))

  (strings/Split path (conv string ListSeparator)))


^{:go/end 30} (go/func abs [^string path] :results [string error]
  (unixAbs path))


^{:go/breaks [[4 39]] :go/end 40} (go/func join ^string [^{:tag (slice string)} elem]
  ;; If there's a bug here, fix the logic in ./path_plan9.go too.
  (range [i e elem]
    (when (!= e "")
      (return (Clean (strings/Join (subslice elem i) (conv string Separator))))))


  "")


^{:go/end 44} (go/func sameWord ^bool [^string a ^string b]
  (== a b))

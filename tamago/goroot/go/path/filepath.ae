(ns go.path.filepath
  (:require [arbace.go :as go]))

(go/package filepath
  :path "path/filepath"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["match.go" "path.go" "path_unix.go" "symlink.go" "symlink_unix.go"]
  :init-order [ErrBadPattern SkipDir SkipAll lstat]
  :positions :lines)

(load "filepath/match")
(load "filepath/path")
(load "filepath/path_unix")
(load "filepath/symlink")
(load "filepath/symlink_unix")

;; Package maps defines various functions useful with maps of any type.
;;
;; This package does not have any special handling for non-reflexive keys
;; (keys k where k != k), such as floating-point NaNs.
(in-ns 'go.maps) (go/file "maps.go" :doc "Package maps defines various functions useful with maps of any type.\n\nThis package does not have any special handling for non-reflexive keys\n(keys k where k != k), such as floating-point NaNs.\n" :imports [


    ^{:line 12} [_ "unsafe"]])




^{:go/breaks [[8 26]] :go/end 27} (go/func Equal "Equal reports whether two maps contain the same key/value pairs.\nValues are compared using ==.\n" :type-params [^{:tag (tilde (map K V))} M1 ^:go/grouped ^{:tag (tilde (map K V))} M2 ^comparable K ^:go/grouped ^comparable V] ^bool [^M1 m1 ^M2 m2]
  (when (!= (len m1) (len m2))
    (return false))

  (range [k v1 m1]
    (when [(values v2 ok) (aget m2 k)] (or (not ok) (!= v1 v2))
      (return false)))


  true)




^{:go/breaks [[8 40]] :go/end 41} (go/func EqualFunc "EqualFunc is like Equal, but compares values using eq.\nKeys are still compared with ==.\n" :type-params [^{:tag (tilde (map K V1))} M1 ^{:tag (tilde (map K V2))} M2 ^comparable K V1 ^:go/grouped V2] ^bool [^M1 m1 ^M2 m2 ^{:tag (func [V1 V2] [bool])} eq]
  (when (!= (len m1) (len m2))
    (return false))

  (range [k v1 m1]
    (when [(values v2 ok) (aget m2 k)] (or (not ok) (not (eq v1 v2)))
      (return false)))


  true)





(go/func ^:extern ^{:go/linkname "clone maps.clone"} clone "clone is implemented in the runtime package.\n" ^any [^any m])



^{:go/end 56} (go/func Clone "Clone returns a copy of m.  This is a shallow clone:\nthe new keys and values are set using ordinary assignment.\n" :type-params [^{:tag (tilde (map K V))} M ^comparable K V] ^M [^M m]
  ;; Preserve nil in case it matters.
  (when (== m nil)
    (return nil))

  (assert M (clone m)))






^{:go/end 66} (go/func Copy "Copy copies all key/value pairs in src adding them to dst.\nWhen a key in src is already present in dst,\nthe value in dst will be overwritten by the value associated\nwith the key in src.\n" :type-params [^{:tag (tilde (map K V))} M1 ^{:go/grouped false :tag (tilde (map K V))} M2 ^comparable K V] [^M1 dst ^M2 src]
  (range [k v src]
    (aset dst k v)))




^{:go/end 75} (go/func DeleteFunc "DeleteFunc deletes any key/value pairs from m for which del returns true.\n" :type-params [^{:tag (tilde (map K V))} M ^comparable K V] [^M m ^{:tag (func [K V] [bool])} del]
  (range [k v m]
    (when (del k v)
      (delete m k))))

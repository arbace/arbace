(in-ns 'go.maps) (go/file "iter.go" :imports [

    ^{:line 7} [iter "iter"]])




^{:go/end 20} (go/func All "All returns an iterator over key-value pairs from m.\nThe iteration order is not specified and is not guaranteed\nto be the same from one call to the next.\n" :type-params [^{:tag (tilde (map K V))} Map ^comparable K V] ^{:tag (iter/Seq2 K V)} [^Map m]
  ^{:go/end 19} (fn [^{:tag (func [K V] [bool])} yield]
    (range [k v m]
      (when (not (yield k v))
        (return)))))








^{:go/end 33} (go/func Keys "Keys returns an iterator over keys in m.\nThe iteration order is not specified and is not guaranteed\nto be the same from one call to the next.\n" :type-params [^{:tag (tilde (map K V))} Map ^comparable K V] ^{:tag (iter/Seq K)} [^Map m]
  ^{:go/end 32} (fn [^{:tag (func [K] [bool])} yield]
    (range [k m]
      (when (not (yield k))
        (return)))))








^{:go/end 46} (go/func Values "Values returns an iterator over values in m.\nThe iteration order is not specified and is not guaranteed\nto be the same from one call to the next.\n" :type-params [^{:tag (tilde (map K V))} Map ^comparable K V] ^{:tag (iter/Seq V)} [^Map m]
  ^{:go/end 45} (fn [^{:tag (func [V] [bool])} yield]
    (range [_ v m]
      (when (not (yield v))
        (return)))))







^{:go/end 54} (go/func Insert "Insert adds the key-value pairs from seq to m.\nIf a key in seq already exists in m, its value will be overwritten.\n" :type-params [^{:tag (tilde (map K V))} Map ^comparable K V] [^Map m ^{:tag (iter/Seq2 K V)} seq]
  (range [k v seq]
    (aset m k v)))





^{:go/end 62} (go/func Collect "Collect collects key-value pairs from seq into a new map\nand returns it.\n" :type-params [^comparable K V] ^{:tag (map K V)} [^{:tag (iter/Seq2 K V)} seq]
  (let [m (make (map K V))]
    (^{:inst [(map K V) K V]} Insert m seq)
    ^{:line 61} m))

(ns go.plugin
  (:require [arbace.go :as go]))

(go/package plugin
  :path "plugin"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["plugin.go" "plugin_stubs.go"]
  :init-order []
  :positions :lines)

(load "plugin/plugin")
(load "plugin/plugin_stubs")

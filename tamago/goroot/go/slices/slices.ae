^{:go/end 363} (go/func Clone "Clone returns a copy of the slice.\nThe elements are copied using assignment, so this is a shallow clone.\nThe result may have additional unused capacity.\nThe result preserves the nilness of s.\n" :type-params [^{:tag (tilde (slice E))} S E] ^S [^S s]
  ;; Preserve nilness in case it matters.
  (when (== s nil)
    (return nil))

  ;; Avoid s[:0:0] as it leads to unwanted liveness when cloning a
  ;; zero-length slice of a large array; see https://go.dev/issue/68488.
  (append (lit S) (spread s)))









^{:go/end 215} (go/func Insert "Insert modifies s in place by inserting the values v... at index i,\nand returns the modified slice.\nThe elements at s[i:] are shifted up to make room.\nIn the returned slice r, r[i] == v[0],\nand, if i < len(s), r[i+len(v)] == value originally at s[i].\nInsert panics if i > len(s).\nThis function is O(len(s) + len(v)).\nIf the result is empty, it has the same nilness as s.\n" :type-params [^{:tag (tilde (slice E))} S E] ^S [^S s ^int i & ^{:tag (slice E)} v]
  (set! _ (subslice s i)) ; bounds check

  (let [m (len v)]
    (when (== m 0)
      (return s))

    (let [n (len s)]
      (when (== i n)
        (return (append s (spread v))))

      (when (> (+ n m) (cap s))
        ;; Use append rather than make so that we bump the size of
        ;; the slice up to the next storage class.
        ;; This is what Grow does but we don't call Grow because
        ;; that might copy the values twice.
        (let [s2 (append (subslice s _ i) (spread (make S (- (+ n m) i))))]
          (copy (subslice s2 i) v)
          (copy (subslice s2 (+ i m)) (subslice s i))
          (return s2)))

      (set! s (subslice s _ (+ n m)))

      ;; before:
      ;; s: aaaaaaaabbbbccccccccdddd
      ;;            ^   ^       ^   ^
      ;;            i  i+m      n  n+m
      ;; after:
      ;; s: aaaaaaaavvvvbbbbcccccccc
      ;;            ^   ^       ^   ^
      ;;            i  i+m      n  n+m
      ;;
      ;; a are the values that don't move in s.
      ;; v are the values copied in from v.
      ;; b and c are the values from s that are shifted up in index.
      ;; d are the values that get overwritten, never to be seen again.

      (when (not (^{:inst [E]} overlaps v (subslice s (+ i m))))
        ;; Easy case - v does not overlap either the c or d regions.
        ;; (It might be in some of a or b, or elsewhere entirely.)
        ;; The data we copy up doesn't write to v at all, so just do it.

        (copy (subslice s (+ i m)) (subslice s i))

        ;; Now we have
        ;; s: aaaaaaaabbbbbbbbcccccccc
        ;;            ^   ^       ^   ^
        ;;            i  i+m      n  n+m
        ;; Note the b values are duplicated.

        (copy (subslice s i) v)

        ;; Now we have
        ;; s: aaaaaaaavvvvbbbbcccccccc
        ;;            ^   ^       ^   ^
        ;;            i  i+m      n  n+m
        ;; That's the result we want.
        (return s))


      ;; The hard case - v overlaps c or d. We can't just shift up
      ;; the data because we'd move or clobber the values we're trying
      ;; to insert.
      ;; So instead, write v on top of d, then rotate.
      (copy (subslice s n) v)

      ;; Now we have
      ;; s: aaaaaaaabbbbccccccccvvvv
      ;;            ^   ^       ^   ^
      ;;            i  i+m      n  n+m

      (^{:inst [E]} rotateRight (subslice s i) m)

      ;; Now we have
      ;; s: aaaaaaaavvvvbbbbcccccccc
      ;;            ^   ^       ^   ^
      ;;            i  i+m      n  n+m
      ;; That's the result we want.
      ^{:line 214} s)))









^{:go/end 235} (go/func Delete "Delete modifies s in place by removing the elements s[i:j],\nand returns the modified slice.\nDelete panics if j > len(s) or s[i:j] is not a valid slice of s.\nDelete is O(len(s)-i), so if many items must be deleted, it is better to\nmake a single call deleting them all together than to delete one at a time.\nDelete zeroes the elements s[len(s)-(j-i):len(s)].\nIf the result is empty, it has the same nilness as s.\n" :type-params [^{:tag (tilde (slice E))} S E] ^S [^S s ^int i ^:go/grouped ^int j]

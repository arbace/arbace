  (when (== i j)
    (return s))


  (let [oldlen (len s)]
    (set! s (append (subslice s _ i) (spread (subslice s j))))
    (clear (subslice s (len s) oldlen)) ; zero/nil out the obsolete elements, for GC
    ^{:line 234} s))







        (return s2)))


    (let [r (subslice s _ tot)]

      (when (<= (+ i (len v)) j)
        ;; Easy, as v fits in the deleted portion.
        (copy (subslice r i) v)
        (copy (subslice r (+ i (len v))) (subslice s j))

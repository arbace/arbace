          (return r))

        (when (not (^{:inst [E]} overlaps (subslice r (len s)) v))
          (copy (subslice r (len s)) (subslice v _ y))
          (copy (subslice r i j) (subslice v y))
          (^{:inst [E]} rotateRight (subslice r i) y)
          (return r))


        ;; Now we know that v overlaps both x and y.
        ;; That means that the entirety of b is *inside* v.
        ;; So we don't need to preserve b at all; instead we

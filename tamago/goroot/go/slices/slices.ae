^{:go/end 349} (go/func Replace "Replace modifies s in place by replacing the elements s[i:j] with the given v,\nand returns the modified slice.\nReplace panics if j > len(s) or s[i:j] is not a valid slice of s.\nWhen len(v) < (j-i), Replace zeroes the elements between the new length and the original length.\nIf the result is empty, it has the same nilness as s.\n" :type-params [^{:tag (tilde (slice E))} S E] ^S [^S s ^int i ^:go/grouped ^int j & ^{:tag (slice E)} v]
  (set! _ (subslice s i j)) ; bounds check

  (when (== i j)
    (return (^{:inst [S E]} Insert s i (spread v))))

  (when (== j (len s))
    (let [s2 (append (subslice s _ i) (spread v))]
      (when (< (len s2) (len s))
        (clear (subslice s (len s2)))) ; zero/nil out the obsolete elements, for GC

      (return s2)))


  (let [tot (+ (len (subslice s _ i)) (len v) (len (subslice s j)))]
    (when (> tot (cap s))
      ;; Too big to fit, allocate and copy over.

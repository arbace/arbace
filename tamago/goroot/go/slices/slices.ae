^{:go/end 467} (go/func overlaps "overlaps reports whether the memory ranges a[:len(a)] and b[:len(b)] overlap.\n" :type-params [E] ^bool [^{:tag (slice E)} a ^:go/grouped ^{:tag (slice E)} b]

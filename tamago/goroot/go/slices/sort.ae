(in-ns 'go.slices) (go/file "sort.go" :directives ["//go:generate go run $GOROOT/src/sort/gen_sort_variants.go -generic"] :imports [


    ^{:line 10} [cmp "cmp"]
    ^{:line 11} [bits "math/bits"]])




^{:go/end 19} (go/func Sort "Sort sorts a slice of any ordered type in ascending order.\nWhen sorting floating-point numbers, NaNs are ordered before other values.\n" :type-params [^{:tag (tilde (slice E))} S ^cmp/Ordered E] [^S x]
  (let [n (len x)]
    (^{:inst [E]} pdqsortOrdered x 0 n (bits/Len (conv uint n)))))











^{:go/end 33} (go/func SortFunc "SortFunc sorts the slice x in ascending order as determined by the cmp\nfunction. This sort is not guaranteed to be stable.\ncmp(a, b) should return a negative number when a < b, a positive number when\na > b and zero when a == b or a and b are incomparable in the sense of\na strict weak ordering.\n\nSortFunc requires that cmp is a strict weak ordering.\nSee https://en.wikipedia.org/wiki/Weak_ordering#Strict_weak_orderings.\nThe function should return 0 for incomparable items.\n" :type-params [^{:tag (tilde (slice E))} S E] [^S x ^{:tag (func [^E a ^:go/grouped ^E b] [int])} cmp]
  (let [n (len x)]
    (^{:inst [E]} pdqsortCmpFunc x 0 n (bits/Len (conv uint n)) cmp)))




^{:go/end 39} (go/func SortStableFunc "SortStableFunc sorts the slice x while keeping the original order of equal\nelements, using cmp to compare elements in the same way as [SortFunc].\n" :type-params [^{:tag (tilde (slice E))} S E] [^S x ^{:tag (func [^E a ^:go/grouped ^E b] [int])} cmp]
  (^{:inst [E]} stableCmpFunc x (len x) cmp))



^{:go/breaks [[7 48]] :go/end 49} (go/func IsSorted "IsSorted reports whether x is sorted in ascending order.\n" :type-params [^{:tag (tilde (slice E))} S ^cmp/Ordered E] ^bool [^S x]
  (for [i (- (len x) 1)] (> i 0) (dec! i)
    (when (^{:inst [E]} cmp/Less (aget x i) (aget x (- i 1)))
      (return false)))


  true)




^{:go/breaks [[7 59]] :go/end 60} (go/func IsSortedFunc "IsSortedFunc reports whether x is sorted in ascending order, with cmp as the\ncomparison function as defined by [SortFunc].\n" :type-params [^{:tag (tilde (slice E))} S E] ^bool [^S x ^{:tag (func [^E a ^:go/grouped ^E b] [int])} cmp]
  (for [i (- (len x) 1)] (> i 0) (dec! i)
    (when (< (cmp (aget x i) (aget x (- i 1))) 0)
      (return false)))


  true)





^{:go/end 74} (go/func Min "Min returns the minimal value in x. It panics if x is empty.\nFor floating-point numbers, Min propagates NaNs (any NaN value in x\nforces the output to be NaN).\n" :type-params [^{:tag (tilde (slice E))} S ^cmp/Ordered E] ^E [^S x]
  (when (< (len x) 1)
    (panic "slices.Min: empty list"))

  (let [m (aget x 0)]
    (for [i 1] (< i (len x)) (inc! i)
      (set! m (min m (aget x i))))

    ^{:line 73} m))





^{:go/end 90} (go/func MinFunc "MinFunc returns the minimal value in x, using cmp to compare elements.\nIt panics if x is empty. If there is more than one minimal element\naccording to the cmp function, MinFunc returns the first one.\n" :type-params [^{:tag (tilde (slice E))} S E] ^E [^S x ^{:tag (func [^E a ^:go/grouped ^E b] [int])} cmp]
  (when (< (len x) 1)
    (panic "slices.MinFunc: empty list"))

  (let [m (aget x 0)]
    (for [i 1] (< i (len x)) (inc! i)
      (when (< (cmp (aget x i) m) 0)
        (set! m (aget x i))))


    ^{:line 89} m))





^{:go/end 104} (go/func Max "Max returns the maximal value in x. It panics if x is empty.\nFor floating-point E, Max propagates NaNs (any NaN value in x\nforces the output to be NaN).\n" :type-params [^{:tag (tilde (slice E))} S ^cmp/Ordered E] ^E [^S x]
  (when (< (len x) 1)
    (panic "slices.Max: empty list"))

  (let [m (aget x 0)]
    (for [i 1] (< i (len x)) (inc! i)
      (set! m (max m (aget x i))))

    ^{:line 103} m))





^{:go/end 120} (go/func MaxFunc "MaxFunc returns the maximal value in x, using cmp to compare elements.\nIt panics if x is empty. If there is more than one maximal element\naccording to the cmp function, MaxFunc returns the first one.\n" :type-params [^{:tag (tilde (slice E))} S E] ^E [^S x ^{:tag (func [^E a ^:go/grouped ^E b] [int])} cmp]
  (when (< (len x) 1)
    (panic "slices.MaxFunc: empty list"))

  (let [m (aget x 0)]
    (for [i 1] (< i (len x)) (inc! i)
      (when (> (cmp (aget x i) m) 0)
        (set! m (aget x i))))


    ^{:line 119} m))






^{:go/end 143} (go/func BinarySearch "BinarySearch searches for target in a sorted slice and returns the earliest\nposition where target is found, or the position where target would appear\nin the sort order; it also returns a bool saying whether the target is\nreally found in the slice. The slice must be sorted in increasing order.\n" :type-params [^{:tag (tilde (slice E))} S ^cmp/Ordered E] [^S x ^E target] :results [int bool]
  ;; Inlining is faster than calling BinarySearchFunc with a lambda.
  (let [n (len x)
      ;; Define x[-1] < target and x[n] >= target.
      ;; Invariant: x[i-1] < target, x[j] >= target.
      (values i j) (values 0 n)]
    (while (< i j)
      (let [h (conv int (>> (conv uint (+ i j)) 1))] ; avoid overflow when computing h
        ;; i ≤ h < j
        (if (^{:inst [E]} cmp/Less (aget x h) target)
          (set! i (+ h 1)) ; preserves x[i-1] < target

          (set! j h)))) ; preserves x[j] >= target


    ;; i == j, x[i-1] < target, and x[j] (= x[i]) >= target  =>  answer is i.
    (return i (and (< i n) ^:go/paren (or (== (aget x i) target) ^:go/paren (and (^{:inst [E]} isNaN (aget x i)) (^{:inst [E]} isNaN target)))))))









^{:go/end 168} (go/func BinarySearchFunc "BinarySearchFunc works like [BinarySearch], but uses a custom comparison\nfunction. The slice must be sorted in increasing order, where \"increasing\"\nis defined by cmp. cmp should return 0 if the slice element matches\nthe target, a negative number if the slice element precedes the target,\nor a positive number if the slice element follows the target.\ncmp must implement the same ordering as the slice, such that if\ncmp(a, t) < 0 and cmp(b, t) >= 0, then a must precede b in the slice.\n" :type-params [^{:tag (tilde (slice E))} S E ^:go/grouped T] [^S x ^T target ^{:tag (func [E T] [int])} cmp] :results [int bool]
  (let [n (len x)
      ;; Define cmp(x[-1], target) < 0 and cmp(x[n], target) >= 0 .
      ;; Invariant: cmp(x[i - 1], target) < 0, cmp(x[j], target) >= 0.
      (values i j) (values 0 n)]
    (while (< i j)
      (let [h (conv int (>> (conv uint (+ i j)) 1))] ; avoid overflow when computing h
        ;; i ≤ h < j
        (if (< (cmp (aget x h) target) 0)
          (set! i (+ h 1)) ; preserves cmp(x[i - 1], target) < 0

          (set! j h)))) ; preserves cmp(x[j], target) >= 0


    ;; i == j, cmp(x[i-1], target) < 0, and cmp(x[j], target) (= cmp(x[i], target)) >= 0  =>  answer is i.
    (return i (and (< i n) (== (cmp (aget x i) target) 0)))))


(go/type sortedHint int) ; hint for pdqsort when choosing the pivot

(go/const
  ^{:line 173} [^{:tag sortedHint :val 0} unknownHint iota]
  ^{:line 174} [^{:val 1} increasingHint]
  ^{:line 175} [^{:val 2} decreasingHint])



(go/type xorshift "xorshift paper: https://www.jstatsoft.org/article/view/v008i14/xorshift.pdf\n" uint64)

^{:go/end 186} (go/method Next ^uint64 [^{:tag (* xorshift)} r]
  (set! @r bit-xor (<< @r 13))
  (set! @r bit-xor (>> @r 7))
  (set! @r bit-xor (<< @r 17))
  (conv uint64 @r))


^{:go/end 190} (go/func nextPowerOfTwo ^uint [^int length]
  ^uint (<< 1 (bits/Len (conv uint length))))




^{:go/end 196} (go/func isNaN "isNaN reports whether x is a NaN without requiring the math package.\nThis will always return false if T is not floating-point.\n" :type-params [^cmp/Ordered T] ^bool [^T x]
  (!= x x))

(in-ns 'go.slices) (go/file "iter.go" :imports [


    ^{:line 8} [cmp "cmp"]
    ^{:line 9} [iter "iter"]])




^{:go/end 22} (go/func All "All returns an iterator over index-value pairs in the slice\nin the usual order.\n" :type-params [^{:tag (tilde (slice E))} Slice E] ^{:tag (iter/Seq2 int E)} [^Slice s]
  ^{:go/end 21} (fn [^{:tag (func [int E] [bool])} yield]
    (range [i v s]
      (when (not (yield i v))
        (return)))))







^{:go/end 34} (go/func Backward "Backward returns an iterator over index-value pairs in the slice,\ntraversing it backward with descending indices.\n" :type-params [^{:tag (tilde (slice E))} Slice E] ^{:tag (iter/Seq2 int E)} [^Slice s]
  ^{:go/end 33} (fn [^{:tag (func [int E] [bool])} yield]
    (for [i (- (len s) 1)] (>= i 0) (dec! i)
      (when (not (yield i (aget s i)))
        (return)))))






^{:go/end 45} (go/func Values "Values returns an iterator that yields the slice elements in order.\n" :type-params [^{:tag (tilde (slice E))} Slice E] ^{:tag (iter/Seq E)} [^Slice s]
  ^{:go/end 44} (fn [^{:tag (func [E] [bool])} yield]
    (range [_ v s]
      (when (not (yield v))
        (return)))))








^{:go/end 55} (go/func AppendSeq "AppendSeq appends the values from seq to the slice and\nreturns the extended slice.\nIf seq is empty, the result preserves the nilness of s.\n" :type-params [^{:tag (tilde (slice E))} Slice E] ^Slice [^Slice s ^{:tag (iter/Seq E)} seq]
  (range [v seq]
    (set! s (append s v)))

  ^{:line 54} s)




^{:go/end 61} (go/func Collect "Collect collects values from seq into a new slice and returns it.\nIf seq is empty, the result is nil.\n" :type-params [E] ^{:tag (slice E)} [^{:tag (iter/Seq E)} seq]
  (^{:inst [(slice E) E]} AppendSeq (conv (slice E) nil) seq))





^{:go/end 70} (go/func Sorted "Sorted collects values from seq into a new slice, sorts the slice,\nand returns it.\nIf seq is empty, the result is nil.\n" :type-params [^cmp/Ordered E] ^{:tag (slice E)} [^{:tag (iter/Seq E)} seq]
  (let [s (^{:inst [E]} Collect seq)]
    (^{:inst [(slice E) E]} Sort s)
    ^{:line 69} s))





^{:go/end 79} (go/func SortedFunc "SortedFunc collects values from seq into a new slice, sorts the slice\nusing the comparison function, and returns it.\nIf seq is empty, the result is nil.\n" :type-params [E] ^{:tag (slice E)} [^{:tag (iter/Seq E)} seq ^{:tag (func [E E] [int])} cmp]
  (let [s (^{:inst [E]} Collect seq)]
    (^{:inst [(slice E) E]} SortFunc s cmp)
    ^{:line 78} s))







^{:go/end 90} (go/func SortedStableFunc "SortedStableFunc collects values from seq into a new slice.\nIt then sorts the slice while keeping the original order of equal elements,\nusing the comparison function to compare elements.\nIt returns the new slice.\nIf seq is empty, the result is nil.\n" :type-params [E] ^{:tag (slice E)} [^{:tag (iter/Seq E)} seq ^{:tag (func [E E] [int])} cmp]
  (let [s (^{:inst [E]} Collect seq)]
    (^{:inst [(slice E) E]} SortStableFunc s cmp)
    ^{:line 89} s))







^{:go/end 114} (go/func Chunk "Chunk returns an iterator over consecutive sub-slices of up to n elements of s.\nAll but the last sub-slice will have size n.\nAll sub-slices are clipped to have no capacity beyond the length.\nIf s is empty, the sequence is empty: there is no empty slice in the sequence.\nChunk panics if n is less than 1.\n" :type-params [^{:tag (tilde (slice E))} Slice E] ^{:tag (iter/Seq Slice)} [^Slice s ^int n]
  (when (< n 1)
    (panic "cannot be less than 1"))


  ^{:go/end 113} (fn [^{:tag (func [Slice] [bool])} yield]
    (for [i 0] (< i (len s)) (set! i + n)
      ;; Clamp the last chunk to the slice bound as necessary.
      (let [end (min n (len (subslice s i)))]

        ;; Set the capacity of each chunk so that appending to a chunk does
        ;; not modify the original slice.
        (when (not (yield (subslice s i (+ i end) (+ i end))))
          (return))))))

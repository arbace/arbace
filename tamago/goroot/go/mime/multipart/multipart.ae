^{:go/end 86} (go/method FormName "FormName returns the name parameter if p has a Content-Disposition\nof type \"form-data\".  Otherwise it returns the empty string.\n" ^string [^{:tag (* Part)} p]
  ;; See https://tools.ietf.org/html/rfc2183 section 2 for EBNF
  ;; of Content-Disposition value format.
  (when (== (.-dispositionParams p) nil)
    (.parseContentDisposition p))

  (when (!= (.-disposition p) "form-data")
    (return ""))

  (aget (.-dispositionParams p) "name"))





^{:go/end 102} (go/method FileName "FileName returns the filename parameter of the [Part]'s Content-Disposition\nheader. If not empty, the filename is passed through filepath.Base (which is\nplatform dependent) before being returned.\n" ^string [^{:tag (* Part)} p]
  (when (== (.-dispositionParams p) nil)
    (.parseContentDisposition p))

  (let [filename (aget (.-dispositionParams p) "filename")]
    (when (== filename "")
      (return ""))

    ;; RFC 7578, Section 4.2 requires that if a filename is provided, the
    ;; directory path information must not be used.
    (filepath/Base filename)))



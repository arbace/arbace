^{:go/end 51} (go/func setMimeTypes "setMimeTypes is used by initMime's non-test path, and by tests.\n" [^{:tag (map string string)} lowerExt ^{:tag (map string string)} mixExt]
  (.Clear mimeTypes)
  (.Clear mimeTypesLower)
  (.Clear extensions)

  (range [k v lowerExt]
    (.Store mimeTypesLower k v))

  (range [k v mixExt]
    (.Store mimeTypes k v))


  (.Lock extensionsMu)
  (defer (.Unlock extensionsMu))
  (range [k v lowerExt]
    (let [(values justType _ err) (ParseMediaType v)]
      (when (!= err nil)
        (panic err))

      (let [^{:tag (slice string)} exts (zero (slice string))]
        (when [(values ei ok) (.Load extensions justType)] ok
          (set! exts (assert (slice string) ei)))

        (.Store extensions justType (append exts k))))))















(go/var ^sync/Once once) ; guards initMime

(go/var (values ^{:tag (func [])} testInitMime ^{:tag (func [])} osInitMime))

^{:go/end 143} (go/func initMime []
  (if [fn testInitMime] (!= fn nil)
    (go/call fn)
    (do
      (setMimeTypes builtinTypesLower builtinTypesLower)
      (osInitMime))))























^{:go/end 196} (go/func TypeByExtension "TypeByExtension returns the MIME type associated with the file extension ext.\nThe extension ext should begin with a leading dot, as in \".html\".\nWhen ext has no associated type, TypeByExtension returns \"\".\n\nExtensions are looked up first case-sensitively, then case-insensitively.\n\nThe built-in table is small but on unix it is augmented by the local\nsystem's MIME-info database or mime.types file(s) if available under one or\nmore of these names:\n\n\t/usr/local/share/mime/globs2\n\t/usr/share/mime/globs2\n\t/etc/mime.types\n\t/etc/apache2/mime.types\n\t/etc/apache/mime.types\n\t/etc/httpd/conf/mime.types\n\nOn Windows, MIME types are extracted from the registry.\n\nText types have the charset parameter set to \"utf-8\" by default.\n" ^string [^string ext]
  (.Do once initMime)

  ;; Case-sensitive lookup.
  (when [(values v ok) (.Load mimeTypes ext)] ok
    (return (assert string v)))


  ;; Case-insensitive lookup.
  ;; Optimistically assume a short ASCII extension and be
  ;; allocation-free in that case.
  (let [^{:tag (array 10 byte)} buf (zero (array 10 byte))
      ^{:line 177} lower (subslice buf _ 0)
      ^:const ^{:line 178 :val 128} utf8RuneSelf 0x80] ; from utf8 package, but not importing it.
    (for [i 0] (< i (len ext)) (inc! i)
      (let [c (aget ext i)]
        (when (>= c utf8RuneSelf)
          ;; Slow path.
          (let [(values si _) (.Load mimeTypesLower (strings/ToLower ext))
              (values s _) (assert string si)]
            (return s)))

        (if (and (<= \A c) (<= c \Z))
          (set! lower (append lower (+ c (- \a \A))))

          (set! lower (append lower c)))))


    (let [(values si _) (.Load mimeTypesLower (conv string lower))
        (values s _) (assert string si)]
      ^{:line 195} s)))



















^{:go/end 229} (go/func ExtensionsByType "ExtensionsByType returns the extensions known to be associated with the MIME\ntype typ. The returned extensions will each begin with a leading dot, as in\n\".html\". When typ has no associated extensions, ExtensionsByType returns an\nnil slice.\n\nThe built-in table is small but on unix it is augmented by the local\nsystem's MIME-info database or mime.types file(s) if available under one or\nmore of these names:\n\n\t/usr/local/share/mime/globs2\n\t/usr/share/mime/globs2\n\t/etc/mime.types\n\t/etc/apache2/mime.types\n\t/etc/apache/mime.types\n\t/etc/httpd/conf/mime.types\n\nOn Windows, extensions are extracted from the registry.\n" [^string typ] :results [(slice string) error]
  (let [(values justType _ err) (ParseMediaType typ)]
    (when (!= err nil)
      (return nil err))


    (.Do once initMime)
    (let [(values s ok) (.Load extensions justType)]
      (when (not ok)
        (return nil nil))

      (let [ret (append (conv (slice string) nil) (spread (assert (slice string) s)))]
        (^{:inst [(slice string) string]} slices/Sort ret)
        (return ret nil)))))





^{:go/end 240} (go/func AddExtensionType "AddExtensionType sets the MIME type associated with\nthe extension ext to typ. The extension should begin with\na leading dot, as in \".html\".\n" ^error [^string ext ^string typ]
  (when (not (strings/HasPrefix ext "."))
    (return (fmt/Errorf "mime: extension %q missing leading dot" ext)))

  (.Do once initMime)
  (setExtensionType ext typ))


^{:go/end 269} (go/func setExtensionType ^error [^string extension ^string mimeType]
  (let [(values justType param err) (ParseMediaType mimeType)]
    (when (!= err nil)
      (return err))

    (when (and (strings/HasPrefix mimeType "text/") (== (aget param "charset") ""))
      (aset param "charset" "utf-8")
      (set! mimeType (FormatMediaType justType param)))

    (let [extLower (strings/ToLower extension)]

      (.Store mimeTypes extension mimeType)
      (.Store mimeTypesLower extLower mimeType)

      (.Lock extensionsMu)
      (defer (.Unlock extensionsMu))
      ^{:go/breaks [5]} (let [^{:tag (slice string)} exts (zero (slice string))]
        (when [(values ei ok) (.Load extensions justType)] ok
          (set! exts (assert (slice string) ei)))

        (range [_ v exts]
          (when (== v extLower)
            (return nil)))


        (.Store extensions justType (append exts extLower))
        nil))))

(in-ns 'go.mime.quotedprintable) (go/file "writer.go" :imports [

    ^{:line 7} [io "io"]])

(go/const ^{:val 76} lineMaxLen 76)


(go/type Writer "A Writer is a quoted-printable writer that implements [io.WriteCloser].\n" (struct


    ^{:line 15 :tag bool :doc "Binary mode treats the writer's input as pure binary and processes end of\nline bytes as binary data.\n"} Binary

    ^{:line 17 :tag io/Writer} w
    ^{:line 18 :tag int} i
    ^{:line 19 :tag (array 78 byte)} line
    ^{:line 20 :tag bool} cr))



^{:go/end 26} (go/func NewWriter "NewWriter returns a new [Writer] that writes to w.\n" ^{:tag (* Writer)} [^io/Writer w]
  (addr (lit Writer :w w)))





^{:go/end 63} (go/method Write "Write encodes p using quoted-printable encoding and writes it to the\nunderlying [io.Writer]. It limits line length to 76 characters. The encoded\nbytes are not necessarily flushed until the [Writer] is closed.\n" [^{:tag (* Writer)} w ^{:tag (slice byte)} p] :results [^int n ^error err]
  (range [i b p]
    (switch
      ;; Simple writes are done in batch.
      (case [(and (>= b \!) (<= b \~) (!= b \=))]
        (continue))
      (case [(or (isWhitespace b) (and (not (.-Binary w)) ^:go/paren (or (== b \newline) (== b \return))))]
        (continue)))


    (when (> i n)
      (when [err (.write w (subslice p n i))] (!= err nil)
        (return n err))

      (set! n i))


    (when [err (.encode w b)] (!= err nil)
      (return n err))

    (inc! n))


  (when (== n (len p))
    (return n nil))


  (when [err (.write w (subslice p n))] (!= err nil)
    (return n err))


  (return (len p) nil))




^{:go/end 73} (go/method Close "Close closes the [Writer], flushing any unwritten data to the underlying\n[io.Writer], but does not close the underlying io.Writer.\n" ^error [^{:tag (* Writer)} w]
  (when [err (.checkLastByte w)] (!= err nil)
    (return err))


  (.flush w))



^{:go/breaks [[5 109]] :go/end 110} (go/method write "write limits text encoded in quoted-printable to 76 characters per line.\n" ^error [^{:tag (* Writer)} w ^{:tag (slice byte)} p]
  (range [_ b p]
    (when (or (== b \newline) (== b \return))
      ;; If the previous byte was \r, the CRLF has already been inserted.
      (when (and (.-cr w) (== b \newline))
        (set! (.-cr w) false)
        (continue))


      (when (== b \return)
        (set! (.-cr w) true))


      (when [err (.checkLastByte w)] (!= err nil)
        (return err))

      (when [err (.insertCRLF w)] (!= err nil)
        (return err))

      (continue))


    (when (== (.-i w) (- lineMaxLen 1))
      (when [err (.insertSoftLineBreak w)] (!= err nil)
        (return err)))



    (aset (.-line w) (.-i w) b)
    (inc! (.-i w))
    (set! (.-cr w) false))


  nil)


^{:go/breaks [[8 124]] :go/end 125} (go/method encode ^error [^{:tag (* Writer)} w ^byte b]
  (when (< (- lineMaxLen 1 (.-i w)) 3)
    (when [err (.insertSoftLineBreak w)] (!= err nil)
      (return err)))



  (aset (.-line w) (.-i w) \=)
  (aset (.-line w) (+ (.-i w) 1) (aget upperhex (>> b 4)))
  (aset (.-line w) (+ (.-i w) 2) (aget upperhex (bit-and b 0x0f)))
  (set! (.-i w) + 3)

  nil)


(go/const ^{:val "0123456789ABCDEF"} upperhex "0123456789ABCDEF")


^{:go/end 144} (go/method checkLastByte "checkLastByte encodes the last buffered byte if it is a space or a tab.\n" ^error [^{:tag (* Writer)} w]
  (when (== (.-i w) 0)
    (return nil))


  ^{:go/breaks [[3 143]]} (let [b (aget (.-line w) (- (.-i w) 1))]
    (when (isWhitespace b)
      (dec! (.-i w))
      (when [err (.encode w b)] (!= err nil)
        (return err)))



    nil))


^{:go/end 151} (go/method insertSoftLineBreak ^error [^{:tag (* Writer)} w]
  (aset (.-line w) (.-i w) \=)
  (inc! (.-i w))

  (.insertCRLF w))


^{:go/end 159} (go/method insertCRLF ^error [^{:tag (* Writer)} w]
  (aset (.-line w) (.-i w) \return)
  (aset (.-line w) (+ (.-i w) 1) \newline)
  (set! (.-i w) + 2)

  (.flush w))


^{:go/breaks [5] :go/end 168} (go/method flush ^error [^{:tag (* Writer)} w]
  (when [(values _ err) (.Write (.-w w) (subslice (.-line w) _ (.-i w)))] (!= err nil)
    (return err))


  (set! (.-i w) 0)
  nil)


^{:go/end 172} (go/func isWhitespace ^bool [^byte b]
  (or (== b \space) (== b \tab)))

(ns go.mime.quotedprintable
  (:require [arbace.go :as go]))

(go/package quotedprintable
  :path "mime/quotedprintable"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["reader.go" "writer.go"]
  :init-order [crlf lf softSuffix lwspChar]
  :positions :lines)

(load "quotedprintable/reader")
(load "quotedprintable/writer")

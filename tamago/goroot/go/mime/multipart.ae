(ns go.mime.multipart
  (:require [arbace.go :as go]))

(go/package multipart
  :path "mime/multipart"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["formdata.go" "multipart.go" "readmimeheader.go" "writer.go"]
  :init-order [ErrMessageTooLarge multipartfiles multipartmaxparts emptyParams multipartmaxheaders quoteEscaper]
  :positions :lines)

(load "multipart/formdata")
(load "multipart/multipart")
(load "multipart/readmimeheader")
(load "multipart/writer")

(ns go.mime.multipart
  (:require [arbace.go :as go]))

(go/package multipart
  :path "mime/multipart"
  :files ["formdata.go" "multipart.go" "readmimeheader.go" "writer.go"]
  :positions :lines)

(load "multipart/formdata")
(load "multipart/multipart")
(load "multipart/readmimeheader")
(load "multipart/writer")

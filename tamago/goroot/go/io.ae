(ns go.io
  (:require [arbace.go :as go]))

(go/package io
  :path "io"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["io.go" "multi.go" "pipe.go"]
  :init-order [ErrShortWrite errInvalidWrite ErrShortBuffer EOF ErrUnexpectedEOF ErrNoProgress errWhence errOffset Discard ["io.go" 645 5] blackHolePool ["multi.go" 67 5] ["multi.go" 97 5] ErrClosedPipe]
  :positions :lines)

(load "io/io")
(load "io/multi")
(load "io/pipe")

(ns go.sort
  (:require [arbace.go :as go]))

(go/package sort
  :path "sort"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["search.go" "slice.go" "sort.go" "zsortfunc.go" "zsortinterface.go"]
  :init-order []
  :positions :lines)

(load "sort/search")
(load "sort/slice")
(load "sort/sort")
(load "sort/zsortfunc")
(load "sort/zsortinterface")

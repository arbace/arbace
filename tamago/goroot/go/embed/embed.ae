    (while (< i j)
      (let [h (conv int (>> (conv uint (+ i j)) 1))] ; avoid overflow when computing h
        ;; i ≤ h < j
        (if (not (f h))
          (set! i (+ h 1)) ; preserves f(i-1) == false

          (set! j h)))) ; preserves f(j) == true


    ;; i == j, f(i-1) == false, and f(j) (= f(i)) == true  =>  answer is i.

^{:go/end 436} (go/func sortSearch "sortSearch is like sort.Search, avoiding an import.\n" ^int [^int n ^{:tag (func [int] [bool])} f]
  ;; Define f(-1) == false and f(n) == true.
  ;; Invariant: f(i-1) == false, f(j) == true.

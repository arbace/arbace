^{:go/end 269} (go/method lookup "lookup returns the named file, or nil if it is not present.\n" ^{:tag (* file)} [^FS f ^string name]
  (when (not (fs/ValidPath name))
    ;; The compiler should never emit a file with an invalid name,
    ;; so this check is not strictly necessary (if name is invalid,
    ;; we shouldn't find a match below), but it's a good backstop anyway.
    (return nil))

  (when (== name ".")
    (return dotFile))

  (when (== (.-files f) nil)
    (return nil))


  ;; Binary search to find where name would be in the list,
  ;; and then check if name is at that position.
  ^{:go/breaks [[3 268]]} (let [(values dir elem _) (split name)
      ^{:line 260} files @(.-files f)
      ^{:line 261} i (sortSearch (len files) ^{:go/end 264} (fn ^bool [^int i]
          (let [(values idir ielem _) (split (.-name (aget files i)))]
            (or (> idir dir) (and (== idir dir) (>= ielem elem))))))]

    (when (and (< i (len files)) (== (stringslite/TrimSuffix (.-name (aget files i)) "/") name))
      (return (addr (aget files i))))

    nil))



^{:go/end 288} (go/method readDir "readDir returns the list of files corresponding to the directory dir.\n" ^{:tag (slice file)} [^FS f ^string dir]
  (when (== (.-files f) nil)
    (return nil))

  ;; Binary search to find where dir starts and ends in the list
  ;; and then return that slice of the list.
  (let [files @(.-files f)
      ^{:line 279} i (sortSearch (len files) ^{:go/end 282} (fn ^bool [^int i]
          (let [(values idir _ _) (split (.-name (aget files i)))]
            (>= idir dir))))

      ^{:line 283} j (sortSearch (len files) ^{:go/end 286} (fn ^bool [^int j]
          (let [(values jdir _ _) (split (.-name (aget files j)))]
            (> jdir dir))))]

    (subslice files i j)))





^{:go/end 302} (go/method Open "Open opens the named file for reading and returns it as an [fs.File].\n\nThe returned file implements [io.Seeker] and [io.ReaderAt] when the file is not a directory.\n" [^FS f ^string name] :results [fs/File error]
  (let [file (.lookup f name)]
    (when (== file nil)
      (return nil (addr (lit fs/PathError :Op "open" :Path name :Err fs/ErrNotExist))))

    (when (.IsDir file)
      (return (addr (lit openDir file (.readDir f name) 0)) nil))

    (return (addr (lit openFile file 0)) nil)))



^{:go/end 319} (go/method ReadDir "ReadDir reads and returns the entire named directory.\n" [^FS f ^string name] :results [(slice fs/DirEntry) error]
  (let [(values file err) (.Open f name)]
    (when (!= err nil)
      (return nil err))

    (let [(values dir ok) (assert (* openDir) file)]
      (when (not ok)
        (return nil (addr (lit fs/PathError :Op "read" :Path name :Err (errors/New "not a directory")))))

      (let [list (make (slice fs/DirEntry) (len (.-files dir)))]
        (range [i list]
          (aset list i (addr (aget (.-files dir) i))))

        (return list nil)))))



^{:go/end 332} (go/method ReadFile "ReadFile reads and returns the content of the named file.\n" [^FS f ^string name] :results [(slice byte) error]
  (let [(values file err) (.Open f name)]
    (when (!= err nil)
      (return nil err))

    (let [(values ofile ok) (assert (* openFile) file)]
      (when (not ok)
        (return nil (addr (lit fs/PathError :Op "read" :Path name :Err (errors/New "is a directory")))))

      (return (conv (slice byte) (.-data (.-f ofile))) nil))))




(go/type FS "An FS is a read-only collection of files, usually initialized with a //go:embed directive.\nWhen declared without a //go:embed directive, an FS is an empty file system.\n\nAn FS is a read-only value, so it is safe to use from multiple goroutines\nsimultaneously and also safe to assign values of type FS to each other.\n\nFS implements fs.FS, so it can be used with any package that understands\nfile system interfaces, including net/http, text/template, and html/template.\n\nSee the package documentation for more details about initializing an FS.\n" (struct
































    ^{:line 184 :tag (* (slice file)) :doc "The compiler knows the layout of this struct.\nSee cmd/compile/internal/staticdata's WriteEmbed.\n\nThe files list is sorted by name but not by simple string comparison.\nInstead, each file's name takes the form \"dir/elem\" or \"dir/elem/\".\nThe optional trailing slash indicates that the file is itself a directory.\nThe files list is sorted first by dir (if dir is missing, it is taken to be \".\")\nand then by base, so this list of files:\n\n\tp\n\tq/\n\tq/r\n\tq/s/\n\tq/s/t\n\tq/s/u\n\tq/v\n\tw\n\nis actually sorted as:\n\n\tp       # dir=.    elem=p\n\tq/      # dir=.    elem=q\n\tw       # dir=.    elem=w\n\tq/r     # dir=q    elem=r\n\tq/s/    # dir=q    elem=s\n\tq/v     # dir=q    elem=v\n\tq/s/t   # dir=q/s  elem=t\n\tq/s/u   # dir=q/s  elem=u\n\nThis order brings directory contents together in contiguous sections\nof the list, allowing a directory read to use binary search to find\nthe relevant sequence of entries.\n"} files))





^{:go/end 197} (go/func split "split splits the name into dir and elem as described in the\ncomment in the FS struct above. isDir reports whether the\nfinal trailing slash was present, indicating that name is a directory.\n" [^string name] :results [^string dir ^string elem ^bool isDir]
  (set! (values name isDir) (stringslite/CutSuffix name "/"))
  (let [i (bytealg/LastIndexByteString name \/)]
    (when (< i 0)
      (return "." name isDir))

    (return (subslice name _ i) (subslice name (+ i 1)) isDir)))



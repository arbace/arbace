(in-ns 'go.os) (go/file "statat.go" :build ["//go:build !windows"] :imports [


    ^{:line 10} [testlog "internal/testlog"]])


^{:go/end 24} (go/method lstatat [^{:tag (* File)} f ^string name] :results [FileInfo error]
  (when (!= stathook nil)
    (let [(values fi err) (stathook f name)]
      (when (or (!= fi nil) (!= err nil))
        (return fi err))))


  (when [log (testlog/Logger)] (!= log nil)
    (.Stat log (joinPath (.Name f) name)))

  (.lstatatNolog f name))

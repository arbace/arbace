;; aix, darwin, js/wasm, openbsd, solaris and wasip1/wasm don't implement
;; waitid/wait6.



(in-ns 'go.os) (go/file "wait_unimp.go" :build ["//go:build aix || darwin || (js && wasm) || openbsd || solaris || wasip1 || tamago"] :imports [])








^{:go/end 21} (go/method blockUntilWaitable "blockUntilWaitable attempts to block until a call to p.Wait will\nsucceed immediately, and reports whether it has done so.\nIt does not actually call p.Wait.\nThis version is used on systems that do not implement waitid,\nor where we have not implemented it yet. Note that this is racy:\na call to Process.Signal can in an extremely unlikely case send a\nsignal to the wrong process, see issue #13987.\n" [^{:tag (* Process)} p] :results [bool error]
  (return false nil))

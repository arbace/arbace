(in-ns 'go.os) (go/file "sys_tamago.go" :build ["//go:build tamago"] :imports [])



(go/const ^{:val false :doc "supportsCloseOnExec reports whether the platform supports the\nO_CLOEXEC flag.\n"} supportsCloseOnExec false)

^{:go/end 15} (go/func hostname [] :results [^string name ^error err]
  (return "tamago" nil))

^{:go/end 57} (go/func newRoot "newRoot returns a new Root.\nIf fd is not a directory, it closes it and returns an error.\n" [^string name] :results [(* Root) error]
  (let [(values fi err) (Stat name)]
    (when (!= err nil)
      (return nil (.-Err (assert (* PathError) err))))

    (when (not (.IsDir fi))
      (return nil (errors/New "not a directory")))

    (return (addr (lit Root (addr (lit root :name name)))) nil)))



^{:go/end 177} (go/func rootMkdirAll ^error [^{:tag (* Root)} r ^string name ^FileMode perm]
  ;; We only check for errPathEscapes here.
  ;; For errors such as ENOTDIR (a non-directory file appeared somewhere along the path),
  ;; we let MkdirAll generate the error.
  ;; MkdirAll will return a PathError referencing the exact location of the error,
  ;; and we want to preserve that property.
  (when [err (checkPathEscapes r name)] (== err errPathEscapes)
    (return (addr (lit PathError :Op "mkdirat" :Path name :Err err))))

  (when (== name "")
    (return (addr (lit PathError :Op "mkdirat" :Path name :Err syscall/ENOENT))))

  ^{:go/breaks [[3 176]]} (let [prefix (+ (.-name (.-root r)) (conv string PathSeparator))]
    (when [err (MkdirAll (+ prefix name) perm)] (!= err nil)
      (when [(values pe ok) (assert (* PathError) err)] ok
        (set! (.-Op pe) "mkdirat")
        (set! (.-Path pe) (stringslite/TrimPrefix (.-Path pe) prefix))
        (return pe))

      (return (addr (lit PathError :Op "mkdirat" :Path name :Err (underlyingError err)))))

    nil))


^{:go/breaks [[6 192]] :go/end 193} (go/func rootRemove ^error [^{:tag (* Root)} r ^string name]

^{:go/breaks [[7 216]] :go/end 217} (go/func rootRemoveAll ^error [^{:tag (* Root)} r ^string name]
  ;; Consistency with os.RemoveAll: Strip trailing /s from the name,
  ;; so RemoveAll("not_a_directory/") succeeds.
  (while (and (> (len name) 0) (IsPathSeparator (aget name (- (len name) 1))))
    (set! name (subslice name _ (- (len name) 1))))

  (when (endsWithDot name)
    ;; Consistency with os.RemoveAll: Return EINVAL when trying to remove .
    (return (addr (lit PathError :Op "RemoveAll" :Path name :Err syscall/EINVAL))))

  (when [err (checkPathEscapesLstat r name)] (!= err nil)
    (when (== err syscall/ENOTDIR)
      ;; Some intermediate path component is not a directory.
      ;; RemoveAll treats this as success (since the target doesn't exist).
      (return nil))

    (return (addr (lit PathError :Op "RemoveAll" :Path name :Err err))))

  (when [err (RemoveAll (joinPath (.-name (.-root r)) name))] (!= err nil)
    (return (addr (lit PathError :Op "RemoveAll" :Path name :Err (underlyingError err)))))

  nil)



^{:go/end 128} (go/method OpenFile "OpenFile opens the named file in the root.\nSee [OpenFile] for more details.\n\nIf perm contains bits other than the nine least-significant bits (0o777),\nOpenFile returns an error.\n" [^{:tag (* Root)} r ^string name ^int flag ^FileMode perm] :results [(* File) error]
  (when (!= (bit-and perm 0777) perm)
    (return nil (addr (lit PathError :Op "openat" :Path name :Err (errors/New "unsupported file mode")))))

  (.logOpen r name)
  (let [(values rf err) (rootOpenFileNolog r name flag perm)]
    (when (!= err nil)
      (return nil err))

    (set! ^{:go/via [file]} (.-appendMode rf) (!= (bit-and flag O_APPEND) 0))
    (return rf nil)))





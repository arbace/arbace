  (when [log (testlog/Logger)] (!= log nil)
    ;; This won't be right if r's name has changed since it was opened,
    ;; but it's the best we can do.
    (.Stat log (joinPath (.Name r) name))))












^{:go/end 353} (go/func splitPathInRoot "splitPathInRoot splits a path into components\nand joins it with the given prefix and suffix.\n\nThe path is relative to a Root, and must not be\nabsolute, volume-relative, or \"\".\n\n\".\" components are removed, except in the last component.\n\nendsInSlash reports whether the path ends in one or more slashes.\n" [^string s ^{:tag (slice string)} prefix ^{:tag (slice string)} suffix] :results [^{:tag (slice string)} _ ^bool endsInSlash ^error err]
  (when (== (len s) 0)
    (return nil false (errors/New "empty path")))

  (when (IsPathSeparator (aget s 0))
    (return nil false errPathEscapes))


  (when (== runtime/GOOS "windows")
    ;; Windows cleans paths before opening them.
    (set! (values s err) (rootCleanPath s prefix suffix))
    (when (!= err nil)
      (return nil false err))

    (set! prefix nil)
    (set! suffix nil))


  (let [parts (^{:inst [(slice string) string]} slices/Clone prefix)
      (values i j) (values 0 1)]
    (while true
      (when (and (< j (len s)) (not (IsPathSeparator (aget s j))))
        ;; Keep looking for the end of this component.
        (inc! j)
        (continue))

      (set! parts (append parts (subslice s i j)))
      ;; Advance to the next component, or end of the path.
      (let [partEnd j]
        (while (and (< j (len s)) (IsPathSeparator (aget s j)))
          (inc! j))

        (when (== j (len s))
          ;; If this is the last path component,
          ;; check for any trailing path separators.
          (when (> (len (subslice s partEnd)) 0)
            (set! endsInSlash true))

          (break))

        (when (== (aget parts (- (len parts) 1)) ".")
          ;; Remove "." components, except at the end.
          (set! parts (subslice parts _ (- (len parts) 1))))

        (set! i j)))

    (when (and (> (len suffix) 0) (> (len parts) 0) (== (aget parts (- (len parts) 1)) "."))
      ;; Remove a trailing "." component if we're joining to a suffix.
      (set! parts (subslice parts _ (- (len parts) 1))))

    (set! parts (append parts (spread suffix)))
    (return parts endsInSlash nil)))






^{:go/end 361} (go/method FS "FS returns a file system (an fs.FS) for the tree of files in the root.\n\nThe result implements [io/fs.StatFS], [io/fs.ReadFileFS],\n[io/fs.ReadDirFS], and [io/fs.ReadLinkFS].\n" ^fs/FS [^{:tag (* Root)} r]
  (conv (* rootFS) r))


(go/type rootFS Root)

^{:go/end 375} (go/method Open [^{:tag (* rootFS)} rfs ^string name] :results [fs/File error]
  (let [r (conv (* Root) rfs)]
    (when (not (isValidRootFSPath name))
      (return nil (addr (lit PathError :Op "open" :Path name :Err ErrInvalid))))

    (let [(values f err) (.Open r name)]
      (when (!= err nil)
        (return nil err))

      (return f nil))))


^{:go/end 399} (go/method ReadDir [^{:tag (* rootFS)} rfs ^string name] :results [(slice DirEntry) error]
  (let [r (conv (* Root) rfs)]
    (when (not (isValidRootFSPath name))
      (return nil (addr (lit PathError :Op "readdir" :Path name :Err ErrInvalid))))


    ;; This isn't efficient: We just open a regular file and ReadDir it.
    ;; Ideally, we would skip creating a *File entirely and operate directly
    ;; on the file descriptor, but that will require some extensive reworking
    ;; of directory reading in general.
    ;;
    ;; This suffices for the moment.
    (let [(values f err) (.Open r name)]
      (when (!= err nil)
        (return nil err))

      (defer (.Close f))
      (let [(values dirs ^:assign err) (.ReadDir f -1)]
        (^{:inst [(slice DirEntry) DirEntry]} slices/SortFunc dirs ^{:go/end 397} (fn ^int [^DirEntry a ^DirEntry b]
            (bytealg/CompareString (.Name a) (.Name b))))

        (return dirs err)))))


^{:go/end 412} (go/method ReadFile [^{:tag (* rootFS)} rfs ^string name] :results [(slice byte) error]
  (let [r (conv (* Root) rfs)]
    (when (not (isValidRootFSPath name))
      (return nil (addr (lit PathError :Op "readfile" :Path name :Err ErrInvalid))))

    (let [(values f err) (.Open r name)]
      (when (!= err nil)
        (return nil err))

      (defer (.Close f))
      (readFileContents (statOrZero f) (.-Read f)))))


^{:go/end 420} (go/method ReadLink [^{:tag (* rootFS)} rfs ^string name] :results [string error]
  (let [r (conv (* Root) rfs)]
    (when (not (isValidRootFSPath name))
      (return "" (addr (lit PathError :Op "readlink" :Path name :Err ErrInvalid))))

    (.Readlink r name)))


^{:go/end 428} (go/method Stat [^{:tag (* rootFS)} rfs ^string name] :results [FileInfo error]

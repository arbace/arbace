    (defer (.Close f))
    (readFileContents (statOrZero f) (.-Read f))))




^{:go/end 274} (go/method WriteFile "WriteFile writes data to the named file in the root, creating it if necessary.\nSee [WriteFile] for more details.\n" ^error [^{:tag (* Root)} r ^string name ^{:tag (slice byte)} data ^FileMode perm]
  (let [(values f err) (.OpenFile r name (bit-or O_WRONLY O_CREATE O_TRUNC) perm)]
    (when (!= err nil)
      (return err))

    (set! (values _ err) (.Write f data))
    (when [err1 (.Close f)] (== err nil)
      (set! err err1))

    ^{:line 273} err))


^{:go/end 282} (go/method logOpen [^{:tag (* Root)} r ^string name]
  (when [log (testlog/Logger)] (!= log nil)
    ;; This won't be right if r's name has changed since it was opened,
    ;; but it's the best we can do.
    (.Open log (joinPath (.Name r) name))))




^{:go/end 260} (go/method ReadFile "ReadFile reads the named file in the root and returns its contents.\nSee [ReadFile] for more details.\n" [^{:tag (* Root)} r ^string name] :results [(slice byte) error]
  (let [(values f err) (.Open r name)]
    (when (!= err nil)

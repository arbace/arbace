^{:go/breaks [[6 452]] :go/end 453} (go/func isValidRootFSPath "isValidRootFSPath reports whether name is a valid filename to pass a Root.FS method.\n" ^bool [^string name]
  (when (not (fs/ValidPath name))
    (return false))

  (when (== runtime/GOOS "windows")
    ;; fs.FS paths are /-separated.
    ;; On Windows, reject the path if it contains any \ separators.
    ;; Other forms of invalid path (for example, "NUL") are handled by
    ;; Root's usual file lookup mechanisms.
    (when (>= (stringslite/IndexByte name \\) 0)
      (return false)))


  true)

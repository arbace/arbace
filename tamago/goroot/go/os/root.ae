^{:go/end 32} (go/func OpenInRoot "OpenInRoot opens the file name in the directory dir.\nIt is equivalent to OpenRoot(dir) followed by opening the file in the root.\n\nOpenInRoot returns an error if any component of the name\nreferences a location outside of dir.\n\nSee [Root] for details and limitations.\n" [^string dir ^string name] :results [(* File) error]
  (let [(values r err) (OpenRoot dir)]
    (when (!= err nil)
      (return nil err))

    (defer (.Close r))
    (.Open r name)))




































(go/type Root "Root may be used to only access files within a single directory tree.\n\nMethods on Root can only access files and directories beneath a root directory.\nIf any component of a file name passed to a method of Root references a location\noutside the root, the method returns an error.\nFile names may reference the directory itself (.).\n\nMethods on Root will follow symbolic links, but symbolic links may not\nreference a location outside the root.\nSymbolic links must not be absolute.\n\nMethods on Root do not prohibit traversal of filesystem boundaries,\nLinux bind mounts, /proc special files, or access to Unix device files.\n\nMethods on Root are safe to be used from multiple goroutines simultaneously.\n\nOn most platforms, creating a Root opens a file descriptor or handle referencing\nthe directory. If the directory is moved, methods on Root reference the original\ndirectory in its new location.\n\nRoot's behavior differs on some platforms:\n\n  - When GOOS=windows, file names may not reference Windows reserved device names\n    such as NUL and COM1.\n  - On Unix, [Root.Chmod], [Root.Chown], and [Root.Chtimes] are vulnerable to a race condition.\n    If the target of the operation is changed from a regular file to a symlink\n    while the operation is in progress, the operation may be performed on the link\n    rather than the link target.\n  - When GOOS=js, Root is vulnerable to TOCTOU (time-of-check-time-of-use)\n    attacks in symlink validation, and cannot ensure that operations will not\n    escape the root.\n  - When GOOS=plan9 or GOOS=js, Root does not track directories across renames.\n    On these platforms, a Root references a directory name, not a file descriptor.\n  - WASI preview 1 (GOOS=wasip1) does not support [Root.Chmod].\n" (struct
    ^{:line 69 :tag (* root)} root))


(go/const



  ^{:line 76} [^{:val 8 :doc "Maximum number of symbolic links we will follow when resolving a file in a root.\n8 is __POSIX_SYMLOOP_MAX (the minimum allowed value for SYMLOOP_MAX),\nand a common limit.\n"} rootMaxSymlinks 8])






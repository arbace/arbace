(ns go.os.signal
  (:require [arbace.go :as go]))

(go/package signal
  :path "os/signal"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["doc.go" "signal.go" "signal_tamago.go"]
  :other-files ["sig.s" "signal_tamago_amd64.s"]
  :init-order []
  :positions :lines)

(load "signal/doc")
(load "signal/signal")
(load "signal/signal_tamago")

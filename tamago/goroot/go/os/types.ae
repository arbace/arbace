(go/type File "File represents an open file descriptor.\n\nThe methods of File are safe for concurrent use.\n" (struct
    (* file))) ; os specific



(go/type ^:alias FileInfo "A FileInfo describes a file and is returned by [Stat] and [Lstat].\n" fs/FileInfo)






(go/type ^:alias FileMode "A FileMode represents a file's mode and permission bits.\nThe bits have the same definition on all systems, so that\ninformation about files can be moved from one system\nto another portably. Not all bits apply to all systems.\nThe only required bit is [ModeDir] for directories.\n" fs/FileMode)






(go/const "The defined file mode bits are the most significant bits of the [FileMode].\nThe nine least-significant bits are the standard Unix rwxrwxrwx permissions.\nThe values of these bits should be considered part of the public API and\nmay be used in wire protocols or disk representations: they must not be\nchanged, although new bits might be added.\n"



  ^{:line 41} [^{:val 1073741824} ModeAppend fs/ModeAppend] ; a: append-only
  ^{:line 42} [^{:val 536870912} ModeExclusive fs/ModeExclusive] ; l: exclusive use
  ^{:line 43} [^{:val 268435456} ModeTemporary fs/ModeTemporary] ; T: temporary file; Plan 9 only
  ^{:line 44} [^{:val 134217728} ModeSymlink fs/ModeSymlink] ; L: symbolic link
  ^{:line 45} [^{:val 67108864} ModeDevice fs/ModeDevice] ; D: device file
  ^{:line 46} [^{:val 33554432} ModeNamedPipe fs/ModeNamedPipe] ; p: named pipe (FIFO)
  ^{:line 47} [^{:val 16777216} ModeSocket fs/ModeSocket] ; S: Unix domain socket
  ^{:line 48} [^{:val 8388608} ModeSetuid fs/ModeSetuid] ; u: setuid
  ^{:line 49} [^{:val 4194304} ModeSetgid fs/ModeSetgid] ; g: setgid

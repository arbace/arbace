^{:go/end 76} (go/func SameFile "SameFile reports whether fi1 and fi2 describe the same file.\nFor example, on Unix this means that the device and inode fields\nof the two underlying structures are identical; on other systems\nthe decision may be based on the path names.\nSameFile only applies to results returned by this package's [Stat].\nIt returns false in other cases.\n" ^bool [^FileInfo fi1 ^FileInfo fi2]
  (let [(values fs1 ok1) (assert (* fileStat) fi1)
      (values fs2 ok2) (assert (* fileStat) fi2)]
    (when (or (not ok1) (not ok2))
      (return false))

    (sameFile fs1 fs2)))

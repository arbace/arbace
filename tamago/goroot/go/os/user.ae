(ns go.os.user
  (:require [arbace.go :as go]))

(go/package user
  :path "os/user"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["lookup.go" "lookup_stubs.go" "lookup_tamago.go" "user.go"]
  :init-order [colon userBuffer groupBuffer userImplemented groupImplemented groupListImplemented]
  :positions :lines)

(load "user/lookup")
(load "user/lookup_stubs")
(load "user/lookup_tamago")
(load "user/user")

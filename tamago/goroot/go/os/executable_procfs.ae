(in-ns 'go.os) (go/file "executable_procfs.go" :build ["//go:build linux || tamago"] :imports [


    ^{:line 10} [errors "errors"]
    ^{:line 11} [stringslite "internal/stringslite"]
    ^{:line 12} [runtime "runtime"]])


^{:go/end 30} (go/func executable [] :results [string error]
  (let [^string procfn (zero string)]
    (switch runtime/GOOS
      (default
        (return "" (errors/New (+ "Executable not implemented for " runtime/GOOS))))
      (case ["linux" "android"]
        (set! procfn "/proc/self/exe"))
      (case ["tamago"]
        (return "tamago" nil)))

    (let [(values path err) (Readlink procfn)]

      ;; When the executable has been deleted then Readlink returns a
      ;; path appended with " (deleted)".
      (return (stringslite/TrimSuffix path " (deleted)") err))))

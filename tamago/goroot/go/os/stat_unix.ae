(in-ns 'go.os) (go/file "stat_unix.go" :build ["//go:build unix || (js && wasm) || wasip1 || tamago"] :imports [


    ^{:line 10} [syscall "syscall"]])




^{:go/end 26} (go/method Stat "Stat returns the [FileInfo] structure describing file.\nIf there is an error, it will be of type [*PathError].\n" [^{:tag (* File)} f] :results [FileInfo error]
  (when (== f nil)
    (return nil ErrInvalid))

  (let [^fileStat fs (zero fileStat)
      ^{:line 20} err (.Fstat ^{:go/via [file]} (.-pfd f) (addr (.-sys fs)))]
    (when (!= err nil)
      (return nil (.wrapErr f "stat" err)))

    (fillFileStatFromSys (addr fs) ^{:go/via [file]} (.-name f))
    (return (addr fs) nil)))



^{:go/end 39} (go/func statNolog "statNolog stats a file with no test logging.\n" [^string name] :results [FileInfo error]
  (let [^fileStat fs (zero fileStat)
      ^{:line 31} err (ignoringEINTR ^{:go/end 33} (fn ^error []
          (syscall/Stat name (addr (.-sys fs)))))]

    (when (!= err nil)
      (return nil (addr (lit PathError :Op "stat" :Path name :Err err))))

    (fillFileStatFromSys (addr fs) name)
    (return (addr fs) nil)))



^{:go/end 52} (go/func lstatNolog "lstatNolog lstats a file with no test logging.\n" [^string name] :results [FileInfo error]
  (let [^fileStat fs (zero fileStat)
      ^{:line 44} err (ignoringEINTR ^{:go/end 46} (fn ^error []
          (syscall/Lstat name (addr (.-sys fs)))))]

    (when (!= err nil)
      (return nil (addr (lit PathError :Op "lstat" :Path name :Err err))))

    (fillFileStatFromSys (addr fs) name)
    (return (addr fs) nil)))

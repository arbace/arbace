      ;; files in Linux's /proc claim size 0 but then do not work right if read in
      ;; small pieces, so an initial read of 1 byte would not work correctly.
      (when (< size minBuf)
        (set! size minBuf))


      (let [data (make (slice byte) 0 size)]

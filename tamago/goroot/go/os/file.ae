^{:go/end 730} (go/method Fd "Fd returns the system file descriptor or handle referencing the open file.\nIf f is closed, the descriptor becomes invalid.\nIf f is garbage collected, a finalizer may close the descriptor,\nmaking it invalid; see [runtime.SetFinalizer] for more information on when\na finalizer might be run.\n\nDo not close the returned descriptor; that could cause a later\nclose of f to close an unrelated descriptor.\n\nFd's behavior differs on some platforms:\n\n  - On Unix and Windows, [File.SetDeadline] methods will stop working.\n  - On Windows, the file descriptor will be disassociated from the\n    Go runtime I/O completion port if there are no concurrent I/O\n    operations on the file.\n\nFor most uses prefer the f.SyscallConn method.\n" ^uintptr [^{:tag (* File)} f]
  (.fd f))



















^{:go/end 751} (go/func DirFS "DirFS returns a file system (an fs.FS) for the tree of files rooted at the directory dir.\n\nNote that DirFS(\"/prefix\") only guarantees that the Open calls it makes to the\noperating system will begin with \"/prefix\": DirFS(\"/prefix\").Open(\"file\") is the\nsame as os.Open(\"/prefix/file\"). So if /prefix/file is a symbolic link pointing outside\nthe /prefix tree, then using DirFS does not stop the access any more than using\nos.Open does. Additionally, the root of the fs.FS returned for a relative path,\nDirFS(\"prefix\"), will be affected by later calls to Chdir. DirFS is therefore not\na general substitute for a chroot-style security mechanism when the directory tree\ncontains arbitrary content.\n\nUse [Root.FS] to obtain a fs.FS that prevents escapes from the tree via symbolic links.\n\nThe directory dir must not be \"\".\n\nThe result implements [io/fs.StatFS], [io/fs.ReadFileFS], [io/fs.ReadDirFS], and\n[io/fs.ReadLinkFS].\n" ^fs/FS [^string dir]
  (conv dirFS dir))


(go/var ^fs/StatFS _ (conv dirFS ""))
(go/var ^fs/ReadFileFS _ (conv dirFS ""))
(go/var ^fs/ReadDirFS _ (conv dirFS ""))
(go/var ^fs/ReadLinkFS _ (conv dirFS ""))

(go/type dirFS string)

^{:go/end 775} (go/method Open [^dirFS dir ^string name] :results [fs/File error]
  (let [(values fullname err) (.join dir name)]
    (when (!= err nil)
      (return nil (addr (lit PathError :Op "open" :Path name :Err err))))

    (let [(values f ^:assign err) (Open fullname)]
      (when (!= err nil)
        ;; DirFS takes a string appropriate for GOOS,
        ;; while the name argument here is always slash separated.
        ;; dir.join will have mixed the two; undo that for
        ;; error reporting.
        (set! (.-Path (assert (* PathError) err)) name)
        (return nil err))

      (return f nil))))







^{:go/end 545} (go/func UserCacheDir "UserCacheDir returns the default root directory to use for user-specific\ncached data. Users should create their own application-specific subdirectory\nwithin this one and use that.\n\nOn Unix systems, it returns $XDG_CACHE_HOME as specified by\nhttps://specifications.freedesktop.org/basedir-spec/basedir-spec-latest.html if\nnon-empty, else $HOME/.cache.\nOn Darwin, it returns $HOME/Library/Caches.\nOn Windows, it returns %LocalAppData%.\nOn Plan 9, it returns $home/lib/cache.\n\nIf the location cannot be determined (for example, $HOME is not defined) or\nthe path in $XDG_CACHE_HOME is relative, then it will return an error.\n" [] :results [string error]
  (let [^string dir (zero string)]

    (switch runtime/GOOS
      (case ["windows"]
        (set! dir (Getenv "LocalAppData"))
        (when (== dir "")
          (return "" (errors/New "%LocalAppData% is not defined"))))


      (case ["darwin" "ios"]
        (set! dir (Getenv "HOME"))
        (when (== dir "")
          (return "" (errors/New "$HOME is not defined")))

        (set! dir + "/Library/Caches"))

      (case ["plan9"]
        (set! dir (Getenv "home"))
        (when (== dir "")
          (return "" (errors/New "$home is not defined")))

        (set! dir + "/lib/cache"))

      (case ["tamago"]
        (set! dir "/"))

      (default ; Unix
        (set! dir (Getenv "XDG_CACHE_HOME"))
        (cond (== dir "") (do
            (set! dir (Getenv "HOME"))
            (when (== dir "")
              (return "" (errors/New "neither $XDG_CACHE_HOME nor $HOME are defined")))

            (set! dir + "/.cache"))
          (not (filepathlite/IsAbs dir))
          (return "" (errors/New "path in $XDG_CACHE_HOME is relative")))))



    (return dir nil)))
















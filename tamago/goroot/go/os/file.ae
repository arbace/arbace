        (when (== dir "")
          (return "" (errors/New "$HOME is not defined")))

        (set! dir + "/Library/Application Support"))

      (case ["plan9"]
        (set! dir (Getenv "home"))
        (when (== dir "")
          (return "" (errors/New "$home is not defined")))

        (set! dir + "/lib"))

      (case ["tamago"]
        (set! dir "/"))


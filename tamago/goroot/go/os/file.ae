^{:go/end 135} (go/func NewFile "NewFile returns a new [File] with the given file descriptor and name.\nThe returned value will be nil if fd is not a valid file descriptor.\n\nNewFile's behavior differs on some platforms:\n\n  - On Unix, if fd is in non-blocking mode, NewFile will attempt to return a pollable file.\n  - On Windows, if fd is opened for asynchronous I/O (that is, [syscall.FILE_FLAG_OVERLAPPED]\n    has been specified in the [syscall.CreateFile] call), NewFile will attempt to return a pollable\n    file by associating fd with the Go runtime I/O completion port.\n    The I/O operations will be performed synchronously if the association fails.\n\nOnly pollable files support [File.SetDeadline], [File.SetReadDeadline], and [File.SetWriteDeadline].\n\nAfter passing it to NewFile, fd may become invalid under the same conditions described\nin the comments of [File.Fd], and the same constraints apply.\n" ^{:tag (* File)} [^uintptr fd ^string name]
  (newFileFromNewFile fd name))





^{:go/end 146} (go/method Read "Read reads up to len(b) bytes from the File and stores them in b.\nIt returns the number of bytes read and any error encountered.\nAt end of file, Read returns 0, io.EOF.\n" [^{:tag (* File)} f ^{:tag (slice byte)} b] :results [^int n ^error err]
  (when [err (.checkValid f "read")] (!= err nil)
    (return 0 err))

  (let [(values ^:assign n e) (.read f b)]
    (return n (.wrapErr f "read" e))))






^{:go/end 172} (go/method ReadAt "ReadAt reads len(b) bytes from the File starting at byte offset off.\nIt returns the number of bytes read and the error, if any.\nReadAt always returns a non-nil error when n < len(b).\nAt end of file, that error is io.EOF.\n" [^{:tag (* File)} f ^{:tag (slice byte)} b ^int64 off] :results [^int n ^error err]
  (when [err (.checkValid f "read")] (!= err nil)
    (return 0 err))


  (when (< off 0)
    (return 0 (addr (lit PathError :Op "readat" :Path ^{:go/via [file]} (.-name f) :Err (errors/New "negative offset")))))


  (while (> (len b) 0)
    (let [(values m e) (.pread f b off)]
      (when (!= e nil)
        (set! err (.wrapErr f "read" e))
        (break))

      (set! n + m)
      (set! b (subslice b m))
      (set! off + (conv int64 m))))

  (return))




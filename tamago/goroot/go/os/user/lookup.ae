(in-ns 'go.os.user) (go/file "lookup.go" :imports [

    ^{:line 7} [sync "sync"]])

(go/const
  ^{:line 10} [^{:val "/etc/passwd"} userFile "/etc/passwd"]
  ^{:line 11} [^{:val "/etc/group"} groupFile "/etc/group"])


(go/var colon (lit (slice byte) \:))






^{:go/end 28} (go/func Current "Current returns the current user.\n\nThe first call will cache the current user information.\nSubsequent calls will return the cached value and will not reflect\nchanges to the current user.\n" [] :results [(* User) error]
  ^{:go/via [Once]} (.Do cache ^{:go/end 22} (fn [] (set! (values (.-u cache) (.-err cache)) (current))))
  (when (!= (.-err cache) nil)
    (return nil (.-err cache)))

  (let [u @(.-u cache)] ; copy
    (return (addr u) nil)))



(go/var ^{:tag (struct sync/Once ^{:tag (* User)} u ^error err) :doc "cache of the current user\n"} cache)







^{:go/end 44} (go/func Lookup "Lookup looks up a user by username. If the user cannot be found, the\nreturned error is of type [UnknownUserError].\n" [^string username] :results [(* User) error]
  (when [(values u err) (Current)] (and (== err nil) (== (.-Username u) username))
    (return u err))

  (lookupUser username))




^{:go/end 53} (go/func LookupId "LookupId looks up a user by userid. If the user cannot be found, the\nreturned error is of type [UnknownUserIdError].\n" [^string uid] :results [(* User) error]
  (when [(values u err) (Current)] (and (== err nil) (== (.-Uid u) uid))
    (return u err))

  (lookupUserId uid))




^{:go/end 59} (go/func LookupGroup "LookupGroup looks up a group by name. If the group cannot be found, the\nreturned error is of type [UnknownGroupError].\n" [^string name] :results [(* Group) error]
  (lookupGroup name))




^{:go/end 65} (go/func LookupGroupId "LookupGroupId looks up a group by groupid. If the group cannot be found, the\nreturned error is of type [UnknownGroupIdError].\n" [^string gid] :results [(* Group) error]
  (lookupGroupId gid))



^{:go/end 70} (go/method GroupIds "GroupIds returns the list of group IDs that the user is a member of.\n" [^{:tag (* User)} u] :results [(slice string) error]
  (listGroups u))

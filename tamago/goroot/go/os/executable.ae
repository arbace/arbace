(in-ns 'go.os) (go/file "executable.go" :imports [])












^{:go/end 20} (go/func Executable "Executable returns the path name for the executable that started\nthe current process. There is no guarantee that the path is still\npointing to the correct executable. If a symlink was used to start\nthe process, depending on the operating system, the result might\nbe the symlink or the path it pointed to. If a stable result is\nneeded, [path/filepath.EvalSymlinks] might help.\n\nExecutable returns an absolute path unless an error occurred.\n\nThe main use case is finding resources located relative to an\nexecutable.\n" [] :results [string error]
  (executable))

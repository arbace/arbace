(in-ns 'go.os) (go/file "exec_nohandle.go" :build ["//go:build !linux && !windows"] :imports [])

^{:go/end 11} (go/method closeHandle [^{:tag (* processHandle)} ph]
  (panic "internal error: unexpected call to closeHandle"))

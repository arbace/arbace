(ns go.os.exec
  (:require [arbace.go :as go]))

(go/package exec
  :path "os/exec"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["exec.go" "exec_unix.go" "lookpath.go" "lp_tamago.go"]
  :init-order [ErrWaitDelay execwait execerrdot ErrDot ErrNotFound]
  :positions :lines)

(load "exec/exec")
(load "exec/exec_unix")
(load "exec/lookpath")
(load "exec/lp_tamago")

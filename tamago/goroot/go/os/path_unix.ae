(in-ns 'go.os) (go/file "path_unix.go" :build ["//go:build unix || (js && wasm) || wasip1 || tamago"] :imports [])

(go/const
  ^{:line 10} [^{:val \/} PathSeparator \/] ; OS-specific path separator
  ^{:line 11} [^{:val \:} PathListSeparator \:]) ; OS-specific path list separator



^{:go/end 17} (go/func IsPathSeparator "IsPathSeparator reports whether c is a directory separator character.\n" ^bool [^uint8 c]
  (== PathSeparator c))



^{:go/end 53} (go/func splitPath "splitPath returns the base name and parent directory.\n" [^string path] :results [string string]
  ;; if no better parent is found, the path is relative from "here"
  (let [dirname "."]

    ;; Remove all but one leading slash.
    (while (and (> (len path) 1) (== (aget path 0) \/) (== (aget path 1) \/))
      (set! path (subslice path 1)))


    (let [i (- (len path) 1)]

      ;; Remove trailing slashes.
      (for [] (and (> i 0) (== (aget path i) \/)) (dec! i)
        (set! path (subslice path _ i)))


      ;; if no slashes in path, base is path
      (let [basename path]

        ;; Remove leading directory path
        (for [(dec! i)] (>= i 0) (dec! i)
          (when (== (aget path i) \/)
            (if (== i 0)
              (set! dirname (subslice path _ 1))

              (set! dirname (subslice path _ i)))

            (set! basename (subslice path (+ i 1)))
            (break)))



        (return dirname basename)))))

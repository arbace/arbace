(in-ns 'go.os) (go/file "types_unix.go" :build ["//go:build !windows && !plan9"] :imports [


    ^{:line 10} [syscall "syscall"]
    ^{:line 11} [time "time"]])



(go/type fileStat "A fileStat is the implementation of FileInfo returned by Stat and Lstat.\n" (struct
    ^{:line 16 :tag string} name
    ^{:line 17 :tag int64} size
    ^{:line 18 :tag FileMode} mode
    ^{:line 19 :tag time/Time} modTime
    ^{:line 20 :tag syscall/Stat_t} sys))


^{:go/end 23} (go/method Size ^int64 [^{:tag (* fileStat)} fs] (.-size fs))
^{:go/end 24} (go/method Mode ^FileMode [^{:tag (* fileStat)} fs] (.-mode fs))
^{:go/end 25} (go/method ModTime ^time/Time [^{:tag (* fileStat)} fs] (.-modTime fs))
^{:go/end 26} (go/method Sys ^any [^{:tag (* fileStat)} fs] (addr (.-sys fs)))

^{:go/end 30} (go/func sameFile ^bool [^{:tag (* fileStat)} fs1 ^{:tag (* fileStat)} fs2]
  (and (== (.-Dev (.-sys fs1)) (.-Dev (.-sys fs2))) (== (.-Ino (.-sys fs1)) (.-Ino (.-sys fs2)))))

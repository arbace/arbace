(in-ns 'go.os.signal) (go/file "signal_tamago.go" :imports [


    ^{:line 8} [os "os"]
    ^{:line 9} [syscall "syscall"]
    ^{:line 10} [time "time"]
    ^{:line 11} [_ "unsafe"]])


(go/var
  ^{:line 15} [^uintptr loopG]
  ^{:line 16} [^syscall/Signal sig])



(go/func ^:extern getgp "Defined by the runtime package.\n" ^uintptr [])

^{:go/end 32} (go/func loop []
  (set! loopG (getgp))

  (while true
    ;; Sleep indefinitely until woken up by [Relay] through
    ;; runtime.wakeg.
    (time/Sleep (- (<< 1 63) 1)) ; math.MaxInt64
    (process sig)
    (set! sig -1)))



^{:go/end 36} (go/func init []
  (set! watchSignalLoop loop))


(go/const ^{:val 256} numSig 256)

^{:go/end 51} (go/func signum ^int [^os/Signal sig]
  (type-switch [sig sig]
    (case [syscall/Signal]
      (let [i (conv int sig)]
        (when (or (< i 0) (>= i numSig))
          (return -1))

        (return i)))
    (default
      (return -1))))



^{:go/end 53} (go/func enableSignal [^int sig])
^{:go/end 54} (go/func disableSignal [^int sig])
^{:go/end 55} (go/func ignoreSignal [^int sig])

^{:go/breaks [3] :go/end 59} (go/func signalIgnored ^bool [^int sig]
  false)



^{:go/end 65} (go/func ^{:go/linkname "waitUntilIdle os/signal.signalWaitUntilIdle"} waitUntilIdle []
  (while (not (Waiting))))










(go/func ^:extern ^:go/nosplit Relay "Relay sends a signal to the [Notify] channel.\n\nTo make it suitable for invocation in bare metal interrupt/exception\nhandlers, the function is implemented in assembly avoiding allocation and\nruntime use.\n" [^syscall/Signal sig])





(go/func ^:extern ^:go/nosplit Waiting "Waiting returns whether package signal is blocked waiting an incoming signal\nto [Notify].\n" ^bool [])

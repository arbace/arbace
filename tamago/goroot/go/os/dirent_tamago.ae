(in-ns 'go.os) (go/file "dirent_tamago.go" :imports [


    ^{:line 8} [syscall "syscall"]
    ^{:line 9} [unsafe "unsafe"]])


^{:go/end 14} (go/func direntIno [^{:tag (slice byte)} buf] :results [uint64 bool]
  (return 1 true))


^{:go/end 18} (go/func direntReclen [^{:tag (slice byte)} buf] :results [uint64 bool]
  (readInt buf (unsafe/Offsetof (.-Reclen (lit syscall/Dirent))) (unsafe/Sizeof (.-Reclen (lit syscall/Dirent)))))


^{:go/end 26} (go/func direntNamlen [^{:tag (slice byte)} buf] :results [uint64 bool]
  (let [(values reclen ok) (direntReclen buf)]
    (when (not ok)
      (return 0 false))

    (return (- reclen (conv uint64 (unsafe/Offsetof (.-Name (lit syscall/Dirent))))) true)))


^{:go/end 30} (go/func direntType ^FileMode [^{:tag (slice byte)} buf]
  (bit-not (conv FileMode 0))) ; unknown

(in-ns 'go.os) (go/file "error.go" :imports [


    ^{:line 8} [poll "internal/poll"]
    ^{:line 9} [fs "io/fs"]])






(go/var "Portable analogs of some common system call errors.\n\nErrors returned from this package may be tested against these errors\nwith [errors.Is].\n"


  ^{:line 19} [^{:doc "ErrInvalid indicates an invalid argument.\nMethods on File will return this error when the receiver is nil.\n"} ErrInvalid fs/ErrInvalid] ; "invalid argument"

  ^{:line 21} [ErrPermission fs/ErrPermission] ; "permission denied"
  ^{:line 22} [ErrExist fs/ErrExist] ; "file already exists"
  ^{:line 23} [ErrNotExist fs/ErrNotExist] ; "file does not exist"
  ^{:line 24} [ErrClosed fs/ErrClosed] ; "file already closed"

  ^{:line 26} [ErrNoDeadline (errNoDeadline)] ; "file type does not support deadline"
  ^{:line 27} [ErrDeadlineExceeded (errDeadlineExceeded)]) ; "i/o timeout"


^{:go/end 30} (go/func errNoDeadline ^error [] poll/ErrNoDeadline)








^{:go/end 39} (go/func errDeadlineExceeded "errDeadlineExceeded returns the value for os.ErrDeadlineExceeded.\nThis error comes from the internal/poll package, which is also\nused by package net. Doing it this way ensures that the net\npackage will return os.ErrDeadlineExceeded for an exceeded deadline,\nas documented by net.Conn.SetDeadline, without requiring any extra\nwork in the net package and without requiring the internal/poll\npackage to import os (which it can't, because that would be circular).\n" ^error [] poll/ErrDeadlineExceeded)

(go/type timeout (interface
    (Timeout ^bool [])))



(go/type ^:alias PathError "PathError records an error and the operation and file path that caused it.\n" fs/PathError)


(go/type SyscallError "SyscallError records an error from a specific system call.\n" (struct
    ^{:line 50 :tag string} Syscall
    ^{:line 51 :tag error} Err))


^{:go/end 54} (go/method Error ^string [^{:tag (* SyscallError)} e] (+ (.-Syscall e) ": " (.Error (.-Err e))))

^{:go/end 56} (go/method Unwrap ^error [^{:tag (* SyscallError)} e] (.-Err e))


^{:go/end 62} (go/method Timeout "Timeout reports whether this error represents a timeout.\n" ^bool [^{:tag (* SyscallError)} e]
  (let [(values t ok) (assert timeout (.-Err e))]
    (and ok (.Timeout t))))





^{:go/end 72} (go/func NewSyscallError "NewSyscallError returns, as an error, a new [SyscallError]\nwith the given system call name and error details.\nAs a convenience, if err is nil, NewSyscallError returns nil.\n" ^error [^string syscall ^error err]
  (when (== err nil)
    (return nil))

  (addr (lit SyscallError syscall err)))








^{:go/end 82} (go/func IsExist "IsExist returns a boolean indicating whether its argument is known to report\nthat a file or directory already exists. It is satisfied by [ErrExist] as\nwell as some syscall errors.\n\nThis function predates [errors.Is]. It only supports errors returned by\nthe os package. New code should use errors.Is(err, fs.ErrExist).\n" ^bool [^error err]
  (underlyingErrorIs err ErrExist))








^{:go/end 92} (go/func IsNotExist "IsNotExist returns a boolean indicating whether its argument is known to\nreport that a file or directory does not exist. It is satisfied by\n[ErrNotExist] as well as some syscall errors.\n\nThis function predates [errors.Is]. It only supports errors returned by\nthe os package. New code should use errors.Is(err, fs.ErrNotExist).\n" ^bool [^error err]
  (underlyingErrorIs err ErrNotExist))








^{:go/end 102} (go/func IsPermission "IsPermission returns a boolean indicating whether its argument is known to\nreport that permission is denied. It is satisfied by [ErrPermission] as well\nas some syscall errors.\n\nThis function predates [errors.Is]. It only supports errors returned by\nthe os package. New code should use errors.Is(err, fs.ErrPermission).\n" ^bool [^error err]
  (underlyingErrorIs err ErrPermission))










^{:go/end 115} (go/func IsTimeout "IsTimeout returns a boolean indicating whether its argument is known\nto report that a timeout occurred.\n\nThis function predates [errors.Is], and the notion of whether an\nerror indicates a timeout can be ambiguous. For example, the Unix\nerror EWOULDBLOCK sometimes indicates a timeout and sometimes does not.\nNew code should use errors.Is with a value appropriate to the call\nreturning the error, such as [os.ErrDeadlineExceeded].\n" ^bool [^error err]
  (let [(values terr ok) (assert timeout (underlyingError err))]
    (and ok (.Timeout terr))))


^{:go/end 128} (go/func underlyingErrorIs ^bool [^error err ^error target]
  ;; Note that this function is not errors.Is:
  ;; underlyingError only unwraps the specific error-wrapping types
  ;; that it historically did, not all errors implementing Unwrap().
  (set! err (underlyingError err))
  (when (== err target)
    (return true))

  ;; To preserve prior behavior, only examine syscall errors.
  (let [(values e ok) (assert syscallErrorType err)]
    (and ok (.Is e target))))



^{:go/end 141} (go/func underlyingError "underlyingError returns the underlying error for known os error types.\n" ^error [^error err]
  (type-switch [err err]
    (case [(* PathError)]
      (return (.-Err err)))
    (case [(* LinkError)]
      (return (.-Err err)))
    (case [(* SyscallError)]
      (return (.-Err err))))

  ^{:line 140} err)

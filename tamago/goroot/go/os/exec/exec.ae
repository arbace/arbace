            (when (!= kv "")
              ;; The entry is not of the form "key=value" (as it is required to be).
              ;; Leave it as-is for now.
              ;; TODO(#52436): should we strip or reject these bogus entries?
              (set! out (append out kv)))

            (continue))

          (let [k (subslice kv _ i)]
            (when caseInsensitive
              (set! k (strings/ToLower k)))

            (when (aget saw k)
              (continue))


            (aset saw k true)
            (set! out (append out kv))))))


    ;; Now reverse the slice to restore the original order.
    (for [i 0] (< i (/ (len out) 2)) (inc! i)
      (let [j (- (len out) i 1)]
        (set! (values (aget out i) (aget out j)) (values (aget out j) (aget out i)))))


    (return out err)))





^{:go/end 1343} (go/func addCriticalEnv "addCriticalEnv adds any critical environment variables that are required\n(or at least almost always required) on the operating system.\nCurrently this is only used for Windows.\n" ^{:tag (slice string)} [^{:tag (slice string)} env]
  (when (!= runtime/GOOS "windows")
    (return env))

  (range [_ kv env]
    (let [(values k _ ok) (strings/Cut kv "=")]
      (when (not ok)
        (continue))

      (when (strings/EqualFold k "SYSTEMROOT")
        ;; We already have it.
        (return env))))


  (append env (+ "SYSTEMROOT=" (os/Getenv "SYSTEMROOT"))))









(go/var ^{:doc "ErrDot indicates that a path lookup resolved to an executable\nin the current directory due to ‘.’ being in the path, either\nimplicitly or explicitly. See the package documentation for details.\n\nNote that functions in this package do not return ErrDot directly.\nCode should use errors.Is(err, ErrDot), not err == ErrDot,\nto test whether a returned error err is due to this condition.\n"} ErrDot (errors/New "cannot run executable found relative to current directory"))



^{:go/breaks [[5 1361]] :go/end 1362} (go/func validateLookPath "validateLookPath excludes paths that can't be valid\nexecutable names. See issue #74466 and CVE-2025-47906.\n" ^error [^string s]
  (switch s
    (case ["" "." ".."]
      (return ErrNotFound)))

  nil)

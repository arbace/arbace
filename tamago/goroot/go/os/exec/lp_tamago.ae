(in-ns 'go.os.exec) (go/file "lp_tamago.go" :build ["//go:build tamago"] :imports [


    ^{:line 10} [errors "errors"]])



(go/var ^{:doc "ErrNotFound is the error resulting if a path search failed to find an executable file.\n"} ErrNotFound (errors/New "executable file not found in $PATH"))





^{:go/end 23} (go/func lookPath "LookPath searches for an executable named file in the\ndirectories named by the PATH environment variable.\nIf file contains a slash, it is tried directly and the PATH is not consulted.\nThe result may be an absolute path or a path relative to the current directory.\n" [^string file] :results [string error]
  ;; tamago can not execute processes, so act as if there are no executables at all.
  (return "" (addr (lit Error file ErrNotFound))))




^{:go/end 29} (go/func lookExtensions "lookExtensions is a no-op on non-Windows platforms, since\nthey do not restrict executables to specific extensions.\n" [^string path ^string dir] :results [string error]
  (return path nil))

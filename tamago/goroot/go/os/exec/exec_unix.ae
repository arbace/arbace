(in-ns 'go.os.exec) (go/file "exec_unix.go" :build ["//go:build !plan9 && !windows"] :imports [


    ^{:line 10} [fs "io/fs"]
    ^{:line 11} [syscall "syscall"]])




^{:go/end 24} (go/func skipStdinCopyError "skipStdinCopyError optionally specifies a function which reports\nwhether the provided stdin copy error should be ignored.\n" ^bool [^error err]
  ;; Ignore EPIPE errors copying to stdin if the program
  ;; completed successfully otherwise.
  ;; See Issue 9173.
  (let [(values pe ok) (assert (* fs/PathError) err)]
    (and ok
      (== (.-Op pe) "write") (== (.-Path pe) "|1")
      (== (.-Err pe) syscall/EPIPE))))

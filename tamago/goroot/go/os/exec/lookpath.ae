(in-ns 'go.os.exec) (go/file "lookpath.go" :imports [])






















^{:go/end 30} (go/func LookPath "LookPath searches for an executable named file in the current path,\nfollowing the conventions of the host operating system.\nIf file contains a slash, it is tried directly and the default path is not consulted.\nOtherwise, on success the result is an absolute path.\n\nLookPath returns an error satisfying [errors.Is](err, [ErrDot])\nif the resolved path is relative to the current directory.\nSee the package documentation for more details.\n\nLookPath looks for an executable named file in the\ndirectories named by the PATH environment variable,\nexcept as described below.\n\n  - On Windows, the file must have an extension named by\n    the PATHEXT environment variable.\n    When PATHEXT is unset, the file must have\n    a \".com\", \".exe\", \".bat\", or \".cmd\" extension.\n  - On Plan 9, LookPath consults the path environment variable.\n    If file begins with \"/\", \"#\", \"./\", or \"../\", it is tried\n    directly and the path is not consulted.\n  - On Wasm, LookPath always returns an error.\n" [^string file] :results [string error]
  (lookPath file))

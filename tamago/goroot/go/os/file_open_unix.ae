(in-ns 'go.os) (go/file "file_open_unix.go" :build ["//go:build unix || (js && wasm) || tamago"] :imports [


    ^{:line 10} [poll "internal/poll"]
    ^{:line 11} [syscall "syscall"]])


^{:go/end 17} (go/func open [^string path ^int flag ^uint32 perm] :results [int poll/SysFile error]
  (let [(values fd err) (syscall/Open path flag perm)]
    (return fd (lit poll/SysFile) err)))

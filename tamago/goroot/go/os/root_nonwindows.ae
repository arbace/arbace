(in-ns 'go.os) (go/file "root_nonwindows.go" :build ["//go:build !windows"] :imports [])

^{:go/end 11} (go/func rootCleanPath [^string s ^{:tag (slice string)} prefix ^{:tag (slice string)} suffix] :results [string error]
  (return s nil))

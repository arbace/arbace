(in-ns 'go.os) (go/file "path.go" :imports [


    ^{:line 8} [filepathlite "internal/filepathlite"]
    ^{:line 9} [syscall "syscall"]])









^{:go/end 66} (go/func MkdirAll "MkdirAll creates a directory named path,\nalong with any necessary parents, and returns nil,\nor else returns an error.\nThe permission bits perm (before umask) are used for all\ndirectories that MkdirAll creates.\nIf path is already a directory, MkdirAll does nothing\nand returns nil.\n" ^error [^string path ^FileMode perm]
  ;; Fast path: if we can tell whether path is a directory or file, stop with success or error.
  (let [(values dir err) (Stat path)]
    (when (== err nil)
      (when (.IsDir dir)
        (return nil))

      (return (addr (lit PathError :Op "mkdir" :Path path :Err syscall/ENOTDIR))))


    ;; Slow path: make sure parent exists and then call Mkdir for path.

    ;; Extract the parent folder from path by first removing any trailing
    ;; path separator and then scanning backward until finding a path
    ;; separator or reaching the beginning of the string.
    ^{:go/breaks [[8 65]]} (let [i (- (len path) 1)]
      (while (and (>= i 0) (IsPathSeparator (aget path i)))
        (dec! i))

      (while (and (>= i 0) (not (IsPathSeparator (aget path i))))
        (dec! i))

      (when (< i 0)
        (set! i 0))


      ;; If there is a parent directory, and it is not the volume name,
      ;; recurse to ensure parent directory exists.
      (when [parent (subslice path _ i)] (> (len parent) (len (filepathlite/VolumeName path)))
        (set! err (MkdirAll parent perm))
        (when (!= err nil)
          (return err)))



      ;; Parent now exists; invoke Mkdir and use its result.
      (set! err (Mkdir path perm))
      (when (!= err nil)
        ;; Handle arguments like "foo/." by
        ;; double-checking that directory doesn't exist.
        (let [(values dir err1) (Lstat path)]
          (when (and (== err1 nil) (.IsDir dir))
            (return nil))

          (return err)))

      nil)))







^{:go/end 75} (go/func RemoveAll "RemoveAll removes path and any children it contains.\nIt removes everything it can but returns the first error\nit encounters. If the path does not exist, RemoveAll\nreturns nil (no error).\nIf there is an error, it will be of type [*PathError].\n" ^error [^string path]
  (removeAll path))



^{:go/breaks [[6 85]] :go/end 86} (go/func endsWithDot "endsWithDot reports whether the final component of path is \".\".\n" ^bool [^string path]
  (when (== path ".")
    (return true))

  (when (and (>= (len path) 2) (== (aget path (- (len path) 1)) \.) (IsPathSeparator (aget path (- (len path) 2))))
    (return true))

  false)

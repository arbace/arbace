(in-ns 'go.os) (go/file "pipe_tamago.go" :build ["//go:build tamago"] :imports [

    ^{:line 9} [syscall "syscall"]])



^{:go/end 16} (go/func Pipe "Pipe returns a connected pair of Files; reads from r return bytes written to w.\nIt returns the files and an error, if any.\n" [] :results [^{:tag (* File)} r ^{:tag (* File)} w ^error err]
  ;; GOOS=tamago does not have pipes.
  (return nil nil (NewSyscallError "pipe" syscall/ENOSYS)))

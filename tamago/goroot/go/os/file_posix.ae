    nil))


^{:go/end 200} (go/func chtimesUtimes ^{:tag (array 2 syscall/Timespec)} [^time/Time atime ^time/Time mtime]
  (let [^{:tag (array 2 syscall/Timespec)} utimes (zero (array 2 syscall/Timespec))
      ^{:line 190} set ^{:go/end 196} (fn [^int i ^time/Time t]
        (if (.IsZero t)
          (aset utimes i (lit syscall/Timespec :Sec _UTIME_OMIT :Nsec _UTIME_OMIT))

          (aset utimes i (syscall/NsecToTimespec (.UnixNano t)))))]


    (set 0 atime)
    (set 1 mtime)
    ^{:line 199} utimes))





^{:go/breaks [[7 218]] :go/end 219} (go/method Chdir "Chdir changes the current working directory to the file,\nwhich must be a directory.\nIf there is an error, it will be of type [*PathError].\n" ^error [^{:tag (* File)} f]

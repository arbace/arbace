^{:go/end 25} (go/method Close "Close closes the [File], rendering it unusable for I/O.\nOn files that support [File.SetDeadline], any pending I/O operations will\nbe canceled and return immediately with an [ErrClosed] error.\nClose will return an error if it has already been called.\n" ^error [^{:tag (* File)} f]
  (when (== f nil)
    (return ErrInvalid))

  (.close (.-file f)))




^{:go/end 33} (go/method read "read reads up to len(b) bytes from the File.\nIt returns the number of bytes read and an error, if any.\n" [^{:tag (* File)} f ^{:tag (slice byte)} b] :results [^int n ^error err]
  (set! (values n err) (.Read ^{:go/via [file]} (.-pfd f) b))
  (runtime/KeepAlive f)
  (return n err))





^{:go/end 42} (go/method pread "pread reads len(b) bytes from the File starting at byte offset off.\nIt returns the number of bytes read and the error, if any.\nEOF is signaled by a zero count with err set to nil.\n" [^{:tag (* File)} f ^{:tag (slice byte)} b ^int64 off] :results [^int n ^error err]
  (set! (values n err) (.Pread ^{:go/via [file]} (.-pfd f) b off))
  (runtime/KeepAlive f)
  (return n err))




^{:go/end 50} (go/method write "write writes len(b) bytes to the File.\nIt returns the number of bytes written and an error, if any.\n" [^{:tag (* File)} f ^{:tag (slice byte)} b] :results [^int n ^error err]
  (set! (values n err) (.Write ^{:go/via [file]} (.-pfd f) b))
  (runtime/KeepAlive f)
  (return n err))




^{:go/end 58} (go/method pwrite "pwrite writes len(b) bytes to the File starting at byte offset off.\nIt returns the number of bytes written and an error, if any.\n" [^{:tag (* File)} f ^{:tag (slice byte)} b ^int64 off] :results [^int n ^error err]
  (set! (values n err) (.Pwrite ^{:go/via [file]} (.-pfd f) b off))
  (runtime/KeepAlive f)
  (return n err))



^{:go/end 74} (go/func syscallMode "syscallMode returns the syscall-specific mode bits from Go's portable mode bits.\n" [^FileMode i] :results [^uint32 o]
  (set! o bit-or (conv uint32 (.Perm i)))
  (when (!= (bit-and i ModeSetuid) 0)
    (set! o bit-or syscall/S_ISUID))

  (when (!= (bit-and i ModeSetgid) 0)
    (set! o bit-or syscall/S_ISGID))

  (when (!= (bit-and i ModeSticky) 0)
    (set! o bit-or syscall/S_ISVTX))

  ;; No mapping for Go's ModeTemporary (plan9 only).
  (return))




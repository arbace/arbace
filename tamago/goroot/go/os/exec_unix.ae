^{:go/end 30} (go/method wait [^{:tag (* Process)} p] :results [^{:tag (* ProcessState)} ps ^error err]
  ;; Which type of Process do we have?
  (if (!= (.-handle p) nil)
    ;; pidfd
    (return (.pidfdWait p))

    ;; Regular PID
    (return (.pidWait p))))



^{:go/end 75} (go/method pidWait [^{:tag (* Process)} p] :results [(* ProcessState) error]
  ;; TODO(go.dev/issue/67642): When there are concurrent Wait calls, one
  ;; may wait on the wrong process if the PID is reused after the
  ;; completes its wait.
  ;;
  ;; Checking for statusDone here would not be a complete fix, as the PID
  ;; could still be waited on and reused prior to blockUntilWaitable.
  (switch (.pidStatus p)
    (case [statusReleased]
      (return nil syscall/EINVAL)))


  ;; If we can block until Wait4 will succeed immediately, do so.
  (let [(values ready err) (.blockUntilWaitable p)]
    (when (!= err nil)
      (return nil err))

    (when ready
      ;; Mark the process done now, before the call to Wait4,
      ;; so that Process.pidSignal will not send a signal.
      (.doRelease p statusDone)
      ;; Acquire a write lock on sigMu to wait for any
      ;; active call to the signal method to complete.
      (.Lock (.-sigMu p))
      (.Unlock (.-sigMu p)))


    (let [
        ^{:line 60 :tag syscall/WaitStatus} status (zero syscall/WaitStatus)
        ^{:line 61 :tag syscall/Rusage} rusage (zero syscall/Rusage)

        (values pid1 ^:assign err) (^{:inst [int]} ignoringEINTR2 ^{:go/end 65} (fn [] :results [int error]
            (syscall/Wait4 (.-Pid p) (addr status) 0 (addr rusage))))]

      (when (!= err nil)
        (return nil (NewSyscallError "wait" err)))

      (.doRelease p statusDone)
      ^{:go/breaks [2]} (return (addr ^{:go/breaks [2 4 6]} (lit ProcessState
            :pid pid1
            :status status
            :rusage (addr rusage)))
        nil))))


^{:go/end 91} (go/method signal ^error [^{:tag (* Process)} p ^Signal sig]
  (let [(values s ok) (assert syscall/Signal sig)]
    (when (not ok)
      (return (errors/New "os: unsupported signal type")))


    ;; Which type of Process do we have?
    (if (!= (.-handle p) nil)
      ;; pidfd
      (return (.pidfdSendSignal p s))

      ;; Regular PID
      (return (.pidSignal p s)))))



^{:go/end 112} (go/method pidSignal ^error [^{:tag (* Process)} p ^syscall/Signal s]
  (when (== (.-Pid p) pidReleased)
    (return errProcessReleased))

  (when (== (.-Pid p) pidUnset)
    (return (errors/New "os: process not initialized")))


  (.RLock (.-sigMu p))
  (defer (.RUnlock (.-sigMu p)))

  (switch (.pidStatus p)
    (case [statusDone]
      (return ErrProcessDone))
    (case [statusReleased]
      (return errProcessReleased)))


  (convertESRCH (syscall/Kill (.-Pid p) s)))



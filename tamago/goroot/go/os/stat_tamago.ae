(in-ns 'go.os) (go/file "stat_tamago.go" :build ["//go:build tamago"] :imports [


    ^{:line 10} [filepathlite "internal/filepathlite"]
    ^{:line 11} [syscall "syscall"]
    ^{:line 12} [time "time"]])


^{:go/end 45} (go/func fillFileStatFromSys [^{:tag (* fileStat)} fs ^string name]
  (set! (.-name fs) (filepathlite/Base name))
  (set! (.-size fs) (.-Size (.-sys fs)))
  (set! (.-modTime fs) (time/Unix (.-Mtime (.-sys fs)) (.-MtimeNsec (.-sys fs))))
  (set! (.-mode fs) (conv FileMode (bit-and (.-Mode (.-sys fs)) 0777)))
  (switch (bit-and (.-Mode (.-sys fs)) syscall/S_IFMT)
    (case [syscall/S_IFBLK]
      (set! (.-mode fs) bit-or ModeDevice))
    (case [syscall/S_IFCHR]
      (set! (.-mode fs) bit-or (bit-or ModeDevice ModeCharDevice)))
    (case [syscall/S_IFDIR]
      (set! (.-mode fs) bit-or ModeDir))
    (case [syscall/S_IFIFO]
      (set! (.-mode fs) bit-or ModeNamedPipe))
    (case [syscall/S_IFLNK]
      (set! (.-mode fs) bit-or ModeSymlink))
    (case [syscall/S_IFREG])
    ;; nothing to do
    (case [syscall/S_IFSOCK]
      (set! (.-mode fs) bit-or ModeSocket)))

  (when (!= (bit-and (.-Mode (.-sys fs)) syscall/S_ISGID) 0)
    (set! (.-mode fs) bit-or ModeSetgid))

  (when (!= (bit-and (.-Mode (.-sys fs)) syscall/S_ISUID) 0)
    (set! (.-mode fs) bit-or ModeSetuid))

  (when (!= (bit-and (.-Mode (.-sys fs)) syscall/S_ISVTX) 0)
    (set! (.-mode fs) bit-or ModeSticky)))




^{:go/end 51} (go/func atime "For testing.\n" ^time/Time [^FileInfo fi]
  (let [st (assert (* syscall/Stat_t) (.Sys fi))]
    (time/Unix (.-Atime st) (.-AtimeNsec st))))

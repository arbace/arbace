^{:go/end 103} (go/method acquire "acquire adds a reference and returns the handle.\nThe bool result reports whether acquire succeeded;\nit fails if the handle is already closed.\nEvery successful call to acquire should be paired with a call to release.\n" [^{:tag (* processHandle)} ph] :results [uintptr bool]
  (while true
    (let [refs (.Load (.-refs ph))]
      (when (< refs 0)
        (panic "internal error: negative process handle reference count"))

      (when (== refs 0)
        (return 0 false))

      (when (.CompareAndSwap (.-refs ph) refs (+ refs 1))
        (return (.-handle ph) true)))))





^{:go/end 119} (go/method release "release releases a reference to the handle.\n" [^{:tag (* processHandle)} ph]
  (while true
    (let [refs (.Load (.-refs ph))]
      (when (<= refs 0)
        (panic "internal error: too many releases of process handle"))

      (when (.CompareAndSwap (.-refs ph) refs (- refs 1))
        (when (== refs 1)
          (.closeHandle ph))

        (return)))))






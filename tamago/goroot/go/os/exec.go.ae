    (let [state (.Load (.-state p))
        ^{:line 307} oldStatus (conv processStatus state)]
      (when (!= oldStatus statusOK)
        (return oldStatus))


      (when (not (.CompareAndSwap (.-state p) state (conv uint32 newStatus)))

^{:go/end 185} (go/method handleTransientAcquire "handleTransientAcquire returns the process handle or,\nif the process is not ready, the current status.\n" [^{:tag (* Process)} p] :results [uintptr processStatus]
  (when (== (.-handle p) nil)

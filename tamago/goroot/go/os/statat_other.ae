(in-ns 'go.os) (go/file "statat_other.go" :build ["//go:build (js && wasm) || plan9 || tamago"] :imports [])

^{:go/end 12} (go/method lstatatNolog [^{:tag (* File)} f ^string name] :results [FileInfo error]
  ;; These platforms don't have fstatat, so use stat instead.
  (Lstat (+ ^{:go/via [file]} (.-name f) "/" name)))

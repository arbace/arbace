      (when (== (.-nx d) BlockSize)
        (if haveAsm
          (block d (subslice (.-x d)))

          (blockGeneric d (subslice (.-x d))))

        (set! (.-nx d) 0))

      (set! p (subslice p n))))

  (when (>= (len p) BlockSize)
    (let [n (bit-and-not (len p) (- BlockSize 1))]

^{:go/end 166} (go/method Write [^{:tag (* digest)} d ^{:tag (slice byte)} p] :results [^int nn ^error err]
  (when (fips140only/Enforced)
    (return 0 (errors/New "crypto/md5: use of MD5 is not allowed in FIPS 140-only mode")))

  ;; Note that we currently call block or blockGeneric
  ;; directly (guarded using haveAsm) because this allows
  ;; escape analysis to see that p and d don't escape.
  (set! nn (len p))
  (set! (.-len d) + (conv uint64 nn))
  (when (> (.-nx d) 0)
    (let [n (copy (subslice (.-x d) (.-nx d)) p)]

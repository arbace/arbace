            (block d (subslice p _ maxAsmSize))
            (set! p (subslice p maxAsmSize))
            (set! n - maxAsmSize))

          (block d (subslice p _ n)))

        (blockGeneric d (subslice p _ n)))

      (set! p (subslice p n))))

  (when (> (len p) 0)
    (set! (.-nx d) (copy (subslice (.-x d)) p)))

  (return))



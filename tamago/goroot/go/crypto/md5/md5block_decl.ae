(in-ns 'go.crypto.md5) (go/file "md5block_decl.go" :build ["//go:build (386 || amd64 || arm || arm64 || loong64 || ppc64 || ppc64le || riscv64 || s390x) && !purego"] :imports [])

(go/const ^{:val true} haveAsm true)


(go/func ^:extern ^:go/noescape block [^{:tag (* digest)} dig ^{:tag (slice byte)} p])

(ns go.crypto.cipher
  (:require [arbace.go :as go]))

(go/package cipher
  :path "crypto/cipher"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["cbc.go" "cfb.go" "cipher.go" "ctr.go" "gcm.go" "io.go" "ofb.go"]
  :init-order [errOpen]
  :positions :lines)

(load "cipher/cbc")
(load "cipher/cfb")
(load "cipher/cipher")
(load "cipher/ctr")
(load "cipher/gcm")
(load "cipher/io")
(load "cipher/ofb")

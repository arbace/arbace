(ns go.crypto.cipher
  (:require [arbace.go :as go]))

(go/package cipher
  :path "crypto/cipher"
  :files ["cbc.go" "cfb.go" "cipher.go" "ctr.go" "gcm.go" "io.go" "ofb.go"]
  :positions :lines)

(load "cipher/cbc")
(load "cipher/cfb")
(load "cipher/cipher")
(load "cipher/ctr")
(load "cipher/gcm")
(load "cipher/io")
(load "cipher/ofb")

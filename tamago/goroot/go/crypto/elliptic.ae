(ns go.crypto.elliptic
  (:require [arbace.go :as go]))

(go/package elliptic
  :path "crypto/elliptic"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["elliptic.go" "nistec.go" "params.go"]
  :init-order [mask p224 p256 p384 p521 ["elliptic.go" 145 5]]
  :positions :lines)

(load "elliptic/elliptic")
(load "elliptic/nistec")
(load "elliptic/params")

(ns go.crypto.md5
  (:require [arbace.go :as go]))

(go/package md5
  :path "crypto/md5"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["md5.go" "md5block.go" "md5block_decl.go"]
  :other-files ["md5block_amd64.s"]
  :init-order []
  :positions :lines)

(load "md5/md5")
(load "md5/md5block")
(load "md5/md5block_decl")

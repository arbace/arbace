^{:go/end 65} (go/func SumSHAKE128 "SumSHAKE128 applies the SHAKE128 extendable output function to data and\nreturns an output of the given length in bytes.\n" ^{:tag (slice byte)} [^{:tag (slice byte)} data ^int length]

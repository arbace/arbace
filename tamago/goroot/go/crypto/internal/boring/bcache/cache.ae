      (values ^{:tag (* (cacheEntry K V))} add ^{:tag (* (cacheEntry K V))} noK) (zero (* (cacheEntry K V)))
      ^{:line 114} n 0]
    (while true
      (let [e (.Load head)
          ^{:line 117} start e]
        (for [] (and (!= e nil) (!= e noK)) (set! e (.-next e))
          (when (== (.-k e) k)
            (.Store (.-v e) v)
            (return))

          (inc! n))

        (when (== add nil)
          (set! add (addr (lit (cacheEntry K V) :k k)))

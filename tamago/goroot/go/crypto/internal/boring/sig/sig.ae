;; Package sig holds “code signatures” that can be called
;; and will result in certain code sequences being linked into
;; the final binary. The functions themselves are no-ops.
(in-ns 'go.crypto.internal.boring.sig) (go/file "sig.go" :doc "Package sig holds “code signatures” that can be called\nand will result in certain code sequences being linked into\nthe final binary. The functions themselves are no-ops.\n" :imports [])


(go/func ^:extern BoringCrypto "BoringCrypto indicates that the BoringCrypto module is present.\n" [])


(go/func ^:extern FIPSOnly "FIPSOnly indicates that package crypto/tls/fipsonly is present.\n" [])


(go/func ^:extern StandardCrypto "StandardCrypto indicates that standard Go crypto is present.\n" [])

(in-ns 'go.crypto.internal.boring.bbig) (go/file "big.go" :imports [


    ^{:line 8} [boring "crypto/internal/boring"]
    ^{:line 9} [big "math/big"]
    ^{:line 10} [unsafe "unsafe"]])


^{:go/end 22} (go/func Enc ^boring/BigInt [^{:tag (* big/Int)} b]
  (when (== b nil)
    (return nil))

  (let [x (.Bits b)]
    (when (== (len x) 0)
      (return (lit boring/BigInt)))

    (unsafe/Slice (conv (* uint) (addr (aget x 0))) (len x))))


^{:go/end 33} (go/func Dec ^{:tag (* big/Int)} [^boring/BigInt b]
  (when (== b nil)
    (return nil))

  (when (== (len b) 0)
    (return (new big/Int)))

  (let [x (unsafe/Slice (conv (* big/Word) (addr (aget b 0))) (len b))]
    (.SetBits (new big/Int) x)))

(in-ns 'go.crypto.internal.fips140only) (go/file "fips140only.go" :imports [


    ^{:line 8} [fips140 "crypto/fips140"]
    ^{:line 9} [sha256 "crypto/internal/fips140/sha256"]
    ^{:line 10} [sha3 "crypto/internal/fips140/sha3"]
    ^{:line 11} [sha512 "crypto/internal/fips140/sha512"]
    ^{:line 12} [hash "hash"]])




^{:go/end 19} (go/func Enforced "Enforced reports whether FIPS 140-only mode is enabled and enforced, in which non-approved\ncryptography returns an error or panics.\n" ^bool []
  (fips140/Enforced))


^{:go/end 28} (go/func ApprovedHash ^bool [^hash/Hash h]
  (type-switch h
    (case [(* sha256/Digest) (* sha512/Digest) (* sha3/Digest)]
      (return true))
    (default
      (return false))))

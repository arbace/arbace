(in-ns 'go.crypto.internal.constanttime) (go/file "constant_time.go" :imports [])

;; The functions in this package are compiler intrinsics for constant-time
;; operations. They are exposed by crypto/subtle and used directly by the
;; FIPS 140-3 module.



^{:go/end 20} (go/func Select "Select returns x if v == 1 and y if v == 0.\nIts behavior is undefined if v takes any other value.\n" ^int [^int v ^int x ^int y]
  ;; This is intrinsicified on arches with CMOV.
  ;; It implements the following superset behavior:
  ;; ConstantTimeSelect returns x if v != 0 and y if v == 0.
  ;; Do the same here to avoid non portable UB.
  (set! v (conv int (boolToUint8 (!= v 0))))
  (bit-or (bit-and (bit-not (- v 1)) x) (bit-and (- v 1) y)))



^{:go/end 25} (go/func ByteEq "ByteEq returns 1 if x == y and 0 otherwise.\n" ^int [^uint8 x ^uint8 y]
  (conv int (boolToUint8 (== x y))))



^{:go/end 30} (go/func Eq "Eq returns 1 if x == y and 0 otherwise.\n" ^int [^int32 x ^int32 y]
  (conv int (boolToUint8 (== x y))))




^{:go/end 36} (go/func LessOrEq "LessOrEq returns 1 if x <= y and 0 otherwise.\nIts behavior is undefined if x or y are negative or > 2**31 - 1.\n" ^int [^int x ^int y]
  (conv int (boolToUint8 (<= x y))))




^{:go/end 42} (go/func boolToUint8 "boolToUint8 is a compiler intrinsic.\nIt returns 1 for true and 0 for false.\n" ^uint8 [^bool b]
  (panic "unreachable; must be intrinsicified"))

(ns go.crypto.internal.rand
  (:require [arbace.go :as go]))

(go/package rand
  :path "crypto/internal/rand"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["rand.go" "rand_fips140v1.26.go" "random_fips140v1.28.go"]
  :init-order [Reader cryptocustomrand]
  :positions :lines)

(load "rand/rand")
(load "rand/rand_fips140v1.26")
(load "rand/random_fips140v1.28")

^{:go/end 208} (go/func sha384Block [^{:tag (* (array 8 uint64))} dh ^{:tag (* (array 128 byte))} p]
  (let [^{:tag (array 80 uint64)} w (zero (array 80 uint64))]
    (range [i 80]
      (if (< i 16)
        (aset w i (beUint64 (subslice p (* i 8))))

        (let [v1 (aget w (- i 2))
            ^{:line 174} t1 (bit-xor (bits/RotateLeft64 v1 -19) (bits/RotateLeft64 v1 -61) (>> v1 6))
            ^{:line 175} v2 (aget w (- i 15))

^{:go/end 43} (go/func SHA384 ^{:tag (array 48 byte)} [^{:tag (* (array 1024 byte))} p]
  (let [h initState]

    (sha384Block (addr h) (conv (* (array 128 byte)) (subslice p 0 128)))
    (sha384Block (addr h) (conv (* (array 128 byte)) (subslice p 128 256)))
    (sha384Block (addr h) (conv (* (array 128 byte)) (subslice p 256 384)))
    (sha384Block (addr h) (conv (* (array 128 byte)) (subslice p 384 512)))
    (sha384Block (addr h) (conv (* (array 128 byte)) (subslice p 512 640)))
    (sha384Block (addr h) (conv (* (array 128 byte)) (subslice p 640 768)))
    (sha384Block (addr h) (conv (* (array 128 byte)) (subslice p 768 896)))
    (sha384Block (addr h) (conv (* (array 128 byte)) (subslice p 896 1024)))

    (let [^{:tag (array 128 byte)} padlen (zero (array 128 byte))]
      (aset padlen 0 0x80)
      (bePutUint64 (subslice padlen (+ 112 8)) (* 1024 8))
      (sha384Block (addr h) (addr padlen))

      (digestBytes (addr h)))))


^{:go/end 71} (go/func TestingOnlySHA384 ^{:tag (array 48 byte)} [^{:tag (slice byte)} p]
  (when (== (len p) 1024)
    (return (SHA384 (conv (* (array 1024 byte)) p))))


  (let [h initState
      ^{:line 51} bitLen (* (conv uint64 (len p)) 8)]

    ;; Process full 128-byte blocks.
    (while (>= (len p) 128)
      (sha384Block (addr h) (conv (* (array 128 byte)) (subslice p _ 128)))
      (set! p (subslice p 128)))


    ;; Process final block and padding.
    (let [^{:tag (array 128 byte)} finalBlock (zero (array 128 byte))]
      (copy (subslice finalBlock) p)
      (aset finalBlock (len p) 0x80)
      (when (>= (len p) 112)
        (sha384Block (addr h) (addr finalBlock))
        (set! finalBlock (lit (array 128 byte))))

      (bePutUint64 (subslice finalBlock (+ 112 8)) bitLen)
      (sha384Block (addr h) (addr finalBlock))

      (digestBytes (addr h)))))


^{:go/end 82} (go/func digestBytes ^{:tag (array 48 byte)} [^{:tag (* (array 8 uint64))} h]

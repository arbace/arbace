    (bePutUint64 (subslice digest 8) (aget h 1))
    (bePutUint64 (subslice digest 16) (aget h 2))
    (bePutUint64 (subslice digest 24) (aget h 3))
    (bePutUint64 (subslice digest 32) (aget h 4))
    (bePutUint64 (subslice digest 40) (aget h 5))
    ^{:line 81} digest))



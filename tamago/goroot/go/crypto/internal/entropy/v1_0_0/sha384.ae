    (let [(values a b c d e f g h) (values (aget dh 0) (aget dh 1) (aget dh 2) (aget dh 3) (aget dh 4) (aget dh 5) (aget dh 6) (aget dh 7))]

      (range [i 80]
        (let [t1 (+ h (bit-xor (bits/RotateLeft64 e -14) (bits/RotateLeft64 e -18)
                (bits/RotateLeft64 e -41)) (bit-xor (bit-and e f) (bit-and (bit-not e) g)) (aget _K i) (aget w i))
            ^{:line 187} t2 (+ (bit-xor (bits/RotateLeft64 a -28) (bits/RotateLeft64 a -34)
                (bits/RotateLeft64 a -39)) (bit-xor (bit-and a b) (bit-and a c) (bit-and b c)))]


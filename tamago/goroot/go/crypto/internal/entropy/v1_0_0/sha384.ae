  (aset b 2 (conv byte (>> v 40)))
  (aset b 3 (conv byte (>> v 32)))
  (aset b 4 (conv byte (>> v 24)))
  (aset b 5 (conv byte (>> v 16)))
  (aset b 6 (conv byte (>> v 8)))
  (aset b 7 (conv byte v)))

;; Package entropy implements a CPU jitter-based SP 800-90B entropy source.
(in-ns 'go.crypto.internal.entropy.v1_0_0) (go/file "entropy.go" :doc "Package entropy implements a CPU jitter-based SP 800-90B entropy source.\n" :imports [


    ^{:line 9} [time "crypto/internal/fips140deps/time"]

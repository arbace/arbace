;; Package entropy provides the passive entropy source for the FIPS 140-3
;; module. It is only used in FIPS mode by [crypto/internal/fips140/drbg.Read]
;; from the FIPS 140-3 Go Cryptographic Module v1.0.0.
;;
;; Later versions of the module use the CPU jitter-based entropy source in the
;; crypto/internal/entropy/v1.0.0 sub-package.
;;
;; This complied with IG 9.3.A, Additional Comment 12, which until January 1,
;; 2026 allows new modules to meet an [earlier version] of Resolution 2(b):
;; "A software module that contains an approved DRBG that receives a LOAD
;; command (or its logical equivalent) with entropy obtained from [...] inside
;; the physical perimeter of the operational environment of the module [...]."
;;
;; Distributions that have their own SP 800-90B entropy source should replace
;; this package with their own implementation.
;;
;; [earlier version]: https://csrc.nist.gov/CSRC/media/Projects/cryptographic-module-validation-program/documents/IG%209.3.A%20Resolution%202b%5BMarch%2026%202024%5D.pdf
(in-ns 'go.crypto.internal.entropy) (go/file "entropy.go" :doc "Package entropy provides the passive entropy source for the FIPS 140-3\nmodule. It is only used in FIPS mode by [crypto/internal/fips140/drbg.Read]\nfrom the FIPS 140-3 Go Cryptographic Module v1.0.0.\n\nLater versions of the module use the CPU jitter-based entropy source in the\ncrypto/internal/entropy/v1.0.0 sub-package.\n\nThis complied with IG 9.3.A, Additional Comment 12, which until January 1,\n2026 allows new modules to meet an [earlier version] of Resolution 2(b):\n\"A software module that contains an approved DRBG that receives a LOAD\ncommand (or its logical equivalent) with entropy obtained from [...] inside\nthe physical perimeter of the operational environment of the module [...].\"\n\nDistributions that have their own SP 800-90B entropy source should replace\nthis package with their own implementation.\n\n[earlier version]: https://csrc.nist.gov/CSRC/media/Projects/cryptographic-module-validation-program/documents/IG%209.3.A%20Resolution%202b%5BMarch%2026%202024%5D.pdf\n" :imports [

    ^{:line 24} [sysrand "crypto/internal/sysrand"]])



^{:go/end 32} (go/func Depleted "Depleted notifies the entropy source that the entropy in the module is\n\"depleted\" and provides the callback for the LOAD command.\n" [^{:tag (func [(* (array 48 byte))])} LOAD]
  (let [^{:tag (array 48 byte)} entropy (zero (array 48 byte))]
    (sysrand/Read (subslice entropy))
    (LOAD (addr entropy))))

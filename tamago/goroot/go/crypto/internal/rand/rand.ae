(in-ns 'go.crypto.internal.rand) (go/file "rand.go" :imports [


    ^{:line 8} [boring "crypto/internal/boring"]
    ^{:line 9} [drbg "crypto/internal/fips140/drbg"]
    ^{:line 10} [randutil "crypto/internal/randutil"]
    ^{:line 11} [godebug "internal/godebug"]
    ^{:line 12} [io "io"]
    ^{:line 13} [_ "unsafe"]])




(go/type ^:alias defaultReader "defaultReader aliases [drbg.DefaultReader], so that [reader]\ndoes not have an exported DefaultReader field.\n" drbg/DefaultReader)

(go/type reader (struct defaultReader))

^{:go/end 31} (go/method Read [^reader r ^{:tag (slice byte)} b] :results [^int n ^error err]
  (when boring/Enabled
    (when [(values _ err) (.Read boring/RandReader b)] (!= err nil)
      (panic (+ "crypto/rand: boring RandReader failed: " (.Error err))))

    (return (len b) nil))

  (drbg/Read b)
  (return (len b) nil))







(go/var ^{:tag io/Reader :doc "Reader is an io.Reader that calls [drbg.Read].\n\nIt should be used internally instead of [crypto/rand.Reader], because the\nlatter can be set by applications outside of tests. These applications then\nrisk breaking between Go releases, if the way the Reader is used changes.\n"} Reader (lit reader))









^{:go/end 51} (go/func ^{:go/linkname "SetTestingReader crypto/internal/rand.SetTestingReader"} SetTestingReader "SetTestingReader overrides all calls to [drbg.Read]. The Read method of\nr must never return an error or return short.\n\nSetTestingReader panics when building against Go Cryptographic Module v1.0.0.\n\nSetTestingReader is pulled by [testing/cryptotest.SetGlobalRandom] via go:linkname.\n" [^io/Reader r]
  (set! testingReader r)
  (fips140SetTestingReader r))


(go/var ^io/Reader testingReader)

(go/var cryptocustomrand (godebug/New "cryptocustomrand"))






^{:go/end 73} (go/func CustomReader "CustomReader returns [Reader] or, only if the GODEBUG setting\n\"cryptocustomrand=1\" is set, the provided io.Reader.\n\nIf returning a non-default Reader, it calls [randutil.MaybeReadByte] on it,\nunless it's the global testing Reader set with [SetTestingReader].\n" ^io/Reader [^io/Reader r]
  (when (== (.Value cryptocustomrand) "1")
    (when (not (IsDefaultReader r))
      (when (!= r testingReader)
        (randutil/MaybeReadByte r))

      (.IncNonDefault cryptocustomrand))

    (return r))

  ^{:line 72} Reader)

(ns go.crypto.internal.cryptotest
  (:require [arbace.go :as go]))

(go/package cryptotest
  :path "crypto/internal/cryptotest"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["aead.go" "allocations.go" "block.go" "blockmode.go" "boundary_compat.go" "fetchmodule.go" "fips140.go" "hash.go" "implementations.go" "methods.go" "stream.go"]
  :init-order [lengths bufLens bufCap]
  :positions :lines)

(load "cryptotest/aead")
(load "cryptotest/allocations")
(load "cryptotest/block")
(load "cryptotest/blockmode")
(load "cryptotest/boundary_compat")
(load "cryptotest/fetchmodule")
(load "cryptotest/fips140")
(load "cryptotest/hash")
(load "cryptotest/implementations")
(load "cryptotest/methods")
(load "cryptotest/stream")

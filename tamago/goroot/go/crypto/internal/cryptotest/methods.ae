(in-ns 'go.crypto.internal.cryptotest) (go/file "methods.go" :imports [


    ^{:line 8} [fmt "fmt"]
    ^{:line 9} [reflect "reflect"]
    ^{:line 10} [slices "slices"]
    ^{:line 11} [testing "testing"]])










^{:go/end 34} (go/func NoExtraMethods "NoExtraMethods checks that the concrete type of *ms has no exported methods\nbeyond the methods of the interface type of *ms, and any others specified in\nthe allowed list.\n\nThese methods are accessible through interface upgrades, so they end up part\nof the API even if undocumented per Hyrum's Law.\n\nms must be a pointer to a non-nil interface.\n" [^{:tag (* testing/T)} t ^any ms & ^{:tag (slice string)} allowed]
  ^{:go/via [common]} (.Helper t)
  (let [(values extraMethods err) (extraMethods ms)]
    (when (!= err nil)
      ^{:go/via [common]} (.Fatal t err))

    (range [_ m extraMethods]
      (when (^{:inst [(slice string) string]} slices/Contains allowed m)
        (continue))

      ^{:go/via [common]} (.Errorf t "unexpected method %q" m))))



^{:go/end 62} (go/func extraMethods [^any ip] :results [(slice string) error]
  (let [v (reflect/ValueOf ip)]
    (when (or (!= (.Kind v) reflect/Ptr) (!= (.Kind (.Elem v)) reflect/Interface) (.IsNil (.Elem v)))
      (return nil (fmt/Errorf "argument must be a pointer to a non-nil interface")))


    (let [interfaceType (.Type (.Elem v))
        ^{:line 43} concreteType (.Type (.Elem (.Elem v)))

        ^{:line 45} interfaceMethods (make (map string bool))]
      (range [i (.NumMethod interfaceType)]
        (aset interfaceMethods (.-Name (.Method interfaceType i)) true))


      (let [^{:tag (slice string)} extraMethods (zero (slice string))]
        (range [i (.NumMethod concreteType)]
          (let [m (.Method concreteType i)]
            (when (not (.IsExported m))
              (continue))

            (when (not (aget interfaceMethods (.-Name m)))
              (set! extraMethods (append extraMethods (.-Name m))))))



        (return extraMethods nil)))))

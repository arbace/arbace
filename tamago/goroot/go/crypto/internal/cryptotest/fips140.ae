(in-ns 'go.crypto.internal.cryptotest) (go/file "fips140.go" :imports [


    ^{:line 8} [fips140 "crypto/internal/fips140"]
    ^{:line 9} [testenv "internal/testenv"]
    ^{:line 10} [regexp "regexp"]
    ^{:line 11} [strconv "strconv"]
    ^{:line 12} [strings "strings"]
    ^{:line 13} [testing "testing"]])


^{:go/end 21} (go/func MustSupportFIPS140 [^testing/TB tb]
  (.Helper tb)
  (when [err (fips140/Supported)] (!= err nil)
    (.Skipf tb "test requires FIPS 140 mode: %v" err)))





^{:go/end 33} (go/func MustMinimumFIPS140ModuleVersion "MustMinimumFIPS140ModuleVersion skips the test if compiled against a lower\nminor version of the FIPS 140-3 module than min (such as \"v1.26.0\").\n" [^testing/TB tb ^string min]
  (.Helper tb)
  (when (== (fips140/Version) "latest")
    (return))

  (when (< (parseFIPS140MinorVersion tb (fips140/Version)) (parseFIPS140MinorVersion tb min))
    (.Skipf tb "test requires FIPS 140-3 module %s or later" min)))



^{:go/end 50} (go/func parseFIPS140MinorVersion ^int [^testing/TB tb ^string version]
  (.Helper tb)
  (let [(values v ok) (strings/CutPrefix version "v1.")]
    (when (not ok)
      (.Fatalf tb "unexpected FIPS 140 version format: %q" version))

    (set! (values v _ ok) (strings/Cut v "."))
    (when (not ok)
      (.Fatalf tb "unexpected FIPS 140 version format: %q" version))

    (let [(values i err) (strconv/Atoi v)]
      (when (!= err nil)
        (.Fatalf tb "unexpected FIPS 140 version format %q: %v" version err))

      ^{:line 49} i)))


^{:go/end 63} (go/func RerunWithFIPS140Enabled [^{:tag (* testing/T)} t]
  ^{:go/via [common]} (.Helper t)
  (MustSupportFIPS140 t)
  (let [nameRegex (+ "^" (regexp/QuoteMeta ^{:go/via [common]} (.Name t)) "$")
      ^{:line 56} cmd (testenv/Command t (testenv/Executable t) (+ "-test.run=" nameRegex) "-test.v")]
    (set! (.-Env cmd) (append (.Environ cmd) "GODEBUG=fips140=on"))
    (let [(values out err) (.CombinedOutput cmd)]
      ^{:go/via [common]} (.Logf t "running with GODEBUG=fips140=on:\n%s" out)
      (when (!= err nil)
        ^{:go/via [common]} (.Errorf t "fips140=on subprocess failed: %v" err)))))



^{:go/end 76} (go/func RerunWithFIPS140Enforced [^{:tag (* testing/T)} t]
  ^{:go/via [common]} (.Helper t)
  (MustSupportFIPS140 t)
  (let [nameRegex (+ "^" (regexp/QuoteMeta ^{:go/via [common]} (.Name t)) "$")
      ^{:line 69} cmd (testenv/Command t (testenv/Executable t) (+ "-test.run=" nameRegex) "-test.v")]
    (set! (.-Env cmd) (append (.Environ cmd) "GODEBUG=fips140=only"))
    (let [(values out err) (.CombinedOutput cmd)]
      ^{:go/via [common]} (.Logf t "running with GODEBUG=fips140=only:\n%s" out)
      (when (!= err nil)
        ^{:go/via [common]} (.Errorf t "fips140=only subprocess failed: %v" err)))))

(in-ns 'go.crypto.internal.cryptotest) (go/file "allocations.go" :imports [


    ^{:line 8} [boring "crypto/internal/boring"]
    ^{:line 9} [asan "internal/asan"]
    ^{:line 10} [msan "internal/msan"]
    ^{:line 11} [race "internal/race"]
    ^{:line 12} [testenv "internal/testenv"]
    ^{:line 13} [runtime "runtime"]
    ^{:line 14} [testing "testing"]])




^{:go/end 48} (go/func SkipTestAllocations "SkipTestAllocations skips the test if there are any factors that interfere\nwith allocation optimizations.\n" [^{:tag (* testing/T)} t]
  ;; Go+BoringCrypto uses cgo.
  (when boring/Enabled
    ^{:go/via [common]} (.Skip t "skipping allocations test with BoringCrypto"))


  ;; The sanitizers sometimes cause allocations.
  (when (or race/Enabled msan/Enabled asan/Enabled)
    ^{:go/via [common]} (.Skip t "skipping allocations test with sanitizers"))


  ;; The plan9 crypto/rand allocates.
  (when (== runtime/GOOS "plan9")
    ^{:go/via [common]} (.Skip t "skipping allocations test on plan9"))


  ;; The tamago crypto/rand allocates.
  (when (== runtime/GOOS "tamago")
    ^{:go/via [common]} (.Skip t "skipping allocations test on tamago"))


  ;; s390x deviates from other assembly implementations and is very hard to
  ;; test due to the lack of LUCI builders. See #67307.
  (when (== runtime/GOARCH "s390x")
    ^{:go/via [common]} (.Skip t "skipping allocations test on s390x"))


  ;; Some APIs rely on inliner and devirtualization to allocate on the stack.
  (testenv/SkipIfOptimizationOff t))

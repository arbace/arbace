(in-ns 'go.crypto.internal.cryptotest) (go/file "fetchmodule.go" :imports [


    ^{:line 8} [bytes "bytes"]
    ^{:line 9} [json "encoding/json"]
    ^{:line 10} [testenv "internal/testenv"]
    ^{:line 11} [os "os"]
    ^{:line 12} [exec "os/exec"]
    ^{:line 13} [testing "testing"]])





^{:go/end 64} (go/func FetchModule "FetchModule fetches the module at the given version and returns the directory\ncontaining its source tree. It skips the test if fetching modules is not\npossible in this environment.\n" ^string [^{:tag (* testing/T)} t ^string module ^string version]
  (testenv/MustHaveExternalNetwork t)

  ;; If the default GOMODCACHE doesn't exist, use a temporary directory
  ;; instead. (For example, run.bash sets GOPATH=/nonexist-gopath.)
  (let [(values out err) (.Output (testenv/CleanCmdEnv (testenv/Command t (testenv/GoToolPath t) "env" "GOMODCACHE")))]
    (when (!= err nil)
      ^{:go/via [common]} (.Errorf t "%s env GOMODCACHE: %v\n%s" (testenv/GoToolPath t) err out)
      (when [(values ee ok) (assert (* exec/ExitError) err)] ok
        ^{:go/via [common]} (.Logf t "%s" (.-Stderr ee)))

      ^{:go/via [common]} (.FailNow t))

    (let [modcacheOk false]
      (when [gomodcache (conv string (bytes/TrimSpace out))] (!= gomodcache "")
        (when [(values _ err) (os/Stat gomodcache)] (== err nil)
          (set! modcacheOk true)))


      (when (not modcacheOk)
        (.Setenv t "GOMODCACHE" ^{:go/via [common]} (.TempDir t))
        ;; Allow t.TempDir() to clean up subdirectories.
        (.Setenv t "GOFLAGS" (+ (os/Getenv "GOFLAGS") " -modcacherw")))


      ^{:go/via [common]} (.Logf t "fetching %s@%s\n" module version)

      (let [cmd (testenv/Command t (testenv/GoToolPath t) "mod" "download" "-json" (+ module "@" version))
          ^{:line 47 :tag bytes/Buffer} stderr (zero bytes/Buffer)]
        (set! (.-Stderr cmd) (addr stderr))
        (let [(values output ^:assign err) (.Output cmd)]
          (when (!= err nil)
            ^{:go/via [common]} (.Fatalf t "failed to download %s@%s: %s\nstdout:\n%s\nstderr:\n%s\n" module version err output (.Bytes stderr)))

          (when (> (.Len stderr) 0)
            ^{:go/via [common]} (.Logf t "go mod download stderr:\n%s" (.Bytes stderr)))

          (let [^{:tag (struct ^string Dir)} j (zero (struct
                  ^{:line 57 :tag string} Dir))]

            (when [err (json/Unmarshal output (addr j))] (!= err nil)
              ^{:go/via [common]} (.Fatalf t "failed to parse 'go mod download': %s\nstdout:\n%s\nstderr:\n%s\n" err output (.Bytes stderr)))


            (.-Dir j)))))))

;; Package wycheproof provides helper utilities for writing tests that
;; rely on Wycheproof test vector schemas and JSON vector data.
;; See https://github.com/C2SP/wycheproof for more information.
(in-ns 'go.crypto.internal.cryptotest.wycheproof) (go/file "wycheproof.go" :doc "Package wycheproof provides helper utilities for writing tests that\nrely on Wycheproof test vector schemas and JSON vector data.\nSee https://github.com/C2SP/wycheproof for more information.\n" :imports [


    ^{:line 11} [crypto "crypto"]
    ^{:line 12} [cryptotest "crypto/internal/cryptotest"]
    ^{:line 13} [hex "encoding/hex"]
    ^{:line 14} [json "encoding/json"]
    ^{:line 15} [flag "flag"]
    ^{:line 16} [fmt "fmt"]
    ^{:line 17} [testenv "internal/testenv"]
    ^{:line 18} [os "os"]
    ^{:line 19} [path "path"]
    ^{:line 20} [reflect "reflect"]
    ^{:line 21} [testing "testing"]])




(go/var ^{:doc "wycheproofDir, if set, points to a local Wycheproof checkout that\nLoadVectorFile should read test vectors from.\n"} wycheproofDir ^{:go/breaks [3]} (flag/String "wycheproof-dir" ""
    "path to a local Wycheproof checkout to load test vectors from."))








^{:go/end 62} (go/func LoadVectorFile "LoadVectorFile unmarshals Wycheproof JSON test vector file by name.\n\nTypically, the value argument will be a pointer to a Wycheproof schema\ntype representing the in-memory structure of the JSON data.\n\nPanics if there is an error reading the Wycheproof JSON vector data file,\nor if it can't be unmarshalled into the provided value.\n" [^{:tag (* testing/T)} t ^string filename ^any value]
  (testenv/SkipIfShortAndSlow t)

  ;; We want to avoid a dependency on c2sp/wycheproof or the schema generator
  ;; in this stdlib code, so we fetch the module at runtime and read the
  ;; vector JSON from that module clone. The version is pinned to whatever
  ;; the _schema generator was last run against (see schemaversion.go), so
  ;; the vectors match the generated schema.go.
  ;;
  ;; If -wycheproof-dir is set, read from that local checkout instead, to
  ;; support testing local updates to Wycheproof.
  (let [dir @wycheproofDir]
    (when (== dir "")
      (set! dir (cryptotest/FetchModule
          ^{:line 50} t "github.com/c2sp/wycheproof" wycheproofVersion)))


    (let [(values content err) (os/ReadFile (path/Join dir "testvectors_v1" filename))]
      (when (!= err nil)
        ^{:go/via [common]} (.Fatalf t "missing Wycheproof vector file %q: %v" filename err))


      (set! err (json/Unmarshal content value))
      (when (!= err nil)
        ^{:go/via [common]} (.Fatalf t "failed to unmarshal vector file %q: %v" filename err)))))










^{:go/end 92} (go/func ShouldPass "ShouldPass returns true if a test should pass informed by expected result\nand flags.\n\nflagsShouldPass is a map used to determine if an \"acceptable\" result test\ncase should pass based on test's flags.\nEvery possible flag value that's associated with an \"acceptable\" result\nshould be explicitly specified, otherwise ShouldPass will panic.\n" ^bool [^{:tag (* testing/T)} t ^Result result ^{:tag (slice string)} flags ^{:tag (map string bool)} flagsShouldPass]
  (switch result
    (case ["valid"]
      (return true))
    (case ["invalid"]
      (return false))
    (case ["acceptable"]
      (range [_ flag flags]
        (let [(values pass ok) (aget flagsShouldPass flag)]
          (when (not ok)
            ^{:go/via [common]} (.Fatalf t "unspecified flag: %q" flag))

          (when (not pass)
            (return false))))


      (return true)) ; There are no flags, or all are meant to pass.
    (default
      ^{:go/via [common]} (.Fatalf t "unexpected result: %v" result)
      (return false))))





^{:go/end 123} (go/func ParseHash "ParseHash maps from a Wycheproof hash name to a crypto.Hash implementation\nIt panics if the provided hash name is unknown.\n" ^crypto/Hash [^string h]
  (switch h
    (case ["SHA-1"]
      (return crypto/SHA1))
    (case ["SHA-256"]
      (return crypto/SHA256))
    (case ["SHA-224"]
      (return crypto/SHA224))
    (case ["SHA-384"]
      (return crypto/SHA384))
    (case ["SHA-512"]
      (return crypto/SHA512))
    (case ["SHA-512/224"]
      (return crypto/SHA512_224))
    (case ["SHA-512/256"]
      (return crypto/SHA512_256))
    (case ["SHA3-224"]
      (return crypto/SHA3_224))
    (case ["SHA3-256"]
      (return crypto/SHA3_256))
    (case ["SHA3-384"]
      (return crypto/SHA3_384))
    (case ["SHA3-512"]
      (return crypto/SHA3_512))
    (default
      (panic (fmt/Sprintf "unknown hash algorithm: %q" h)))))




^{:go/end 138} (go/func TestName "TestName returns a t.Run subtest name for a Wycheproof test vector.\n" ^string [^string file ^any tv]
  (let [v (reflect/ValueOf tv)]
    (when (== (.Kind v) reflect/Pointer)
      (set! v (.Elem v)))

    (let [tcID (.Int (.FieldByName v "TcId"))
        ^{:line 132} comment (.String (.FieldByName v "Comment"))
        ^{:line 133} name (fmt/Sprintf "%s #%d" file tcID)]
      (when (!= comment "")
        (set! name + (+ " " comment)))

      ^{:line 137} name)))






^{:go/end 150} (go/func MustDecodeHex "MustDecodeHex is a helper that decodes the provided string or panics.\n\nMany Wycheproof vector values are hex encoded strings and in a test context\nwe don't intend to handle decoding errors gracefully.\n" ^{:tag (slice byte)} [^string h]
  (let [(values d err) (hex/DecodeString h)]
    (when (!= err nil)
      (panic err))

    ^{:line 149} d))







^{:go/end 165} (go/func MustPanic "MustPanic calls fn and fails the test if fn does not panic.\n\nThis is useful for testing that invalid inputs (like incorrect nonce sizes\nfor AEAD ciphers) properly trigger panics rather than silently accepting\nthe bad input.\n" [^{:tag (* testing/T)} t ^string name ^{:tag (func [])} fn]
  ^{:go/via [common]} (.Helper t)
  (defer (^{:go/end 163} (fn []
        (when [r (recover)] (== r nil)
          ^{:go/via [common]} (.Errorf t "%s: expected panic but didn't get one" name)))))


  (go/call fn))

(in-ns 'go.crypto.internal.cryptotest) (go/file "boundary_compat.go" :build ["//go:build !linux && !darwin"] :imports [

    ^{:line 9} [testing "testing"]])




^{:go/end 16} (go/func BoundarySlices "BoundarySlices allocates a pair of slices of the given size.\n\nOn this platform, the slices are not special.\n" [^{:tag (* testing/T)} t ^int size] :results [^{:tag (slice byte)} start ^{:tag (slice byte)} end]
  (return (make (slice byte) size) (make (slice byte) size)))

(in-ns 'go.crypto.internal.cryptotest) (go/file "implementations.go" :imports [


    ^{:line 8} [boring "crypto/internal/boring"]
    ^{:line 9} [impl "crypto/internal/impl"]
    ^{:line 10} [goarch "internal/goarch"]
    ^{:line 11} [goos "internal/goos"]
    ^{:line 12} [testenv "internal/testenv"]
    ^{:line 13} [strings "strings"]
    ^{:line 14} [testing "testing"]])





^{:go/end 54} (go/func TestAllImplementations "TestAllImplementations runs the provided test function with each available\nimplementation of the package registered with crypto/internal/impl. If there\nare no alternative implementations for pkg, f is invoked directly once.\n" [^{:tag (* testing/T)} t ^string pkg ^{:tag (func [^{:tag (* testing/T)} t])} f]
  ;; BoringCrypto bypasses the multiple Go implementations.
  (when boring/Enabled
    (f t)
    (return))


  (let [impls (impl/List pkg)]
    (when (== (len impls) 0)
      (f t)
      (return))


    ^{:go/via [common]} (.Cleanup t ^{:go/end 33} (fn [] (impl/Reset pkg)))

    (range [_ name impls]
      (if [available (impl/Select pkg name)] available
        (.Run t name f)

        (.Run t name ^{:go/end 47} (fn [^{:tag (* testing/T)} t]
            ;; Report an error if we're on the most capable builder for the
            ;; architecture and the builder can't test this implementation.
            (if (flagshipBuilder)
              ^{:go/via [common]} (.Error t "builder doesn't support CPU features needed to test this implementation")

              ^{:go/via [common]} (.Skip t "implementation not supported"))))))





    ;; Test the generic implementation.
    (impl/Select pkg "")
    (.Run t "Base" f)))


^{:go/end 71} (go/func flagshipBuilder ^bool []
  (let [builder (testenv/Builder)]
    (when (== builder "")
      (return false))

    (switch goarch/GOARCH
      (case ["amd64"]
        (return (strings/Contains builder "_avx512")))
      (case ["arm64"]
        ;; Apple M chips support everything we use.
        (return (== goos/GOOS "darwin")))
      (default
        ;; Presumably the Linux builders are the most capable.
        (return (== goos/GOOS "linux"))))))

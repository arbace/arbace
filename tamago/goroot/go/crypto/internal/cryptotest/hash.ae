(in-ns 'go.crypto.internal.cryptotest) (go/file "hash.go" :imports [


    ^{:line 8} [boring "crypto/internal/boring"]
    ^{:line 9} [fips140 "crypto/internal/fips140"]
    ^{:line 10} [hash "hash"]
    ^{:line 11} [testhash "internal/testhash"]
    ^{:line 12} [io "io"]
    ^{:line 13} [rand "math/rand"]
    ^{:line 14} [testing "testing"]
    ^{:line 15} [time "time"]])


(go/type MakeHash (func [] [hash/Hash]))



^{:go/end 42} (go/func TestHash "TestHash performs a set of tests on hash.Hash implementations, checking the\ndocumented requirements of Write, Sum, Reset, Size, and BlockSize.\n" [^{:tag (* testing/T)} t ^MakeHash mh]
  (.Run t "OutOfBounds" ^{:go/end 35} (fn [^{:tag (* testing/T)} t]
      (let [(values start end) (BoundarySlices t 1000)
          ^{:line 25} h (mh)]
        (range [i (+ (len start) 1)]
          (.Write h (subslice start _ i))
          (.Write h (subslice start (- (len start) i)))
          (.Write h (subslice end _ i))
          (.Write h (subslice end (- (len end) i))))

        (set! (values start end) (BoundarySlices t (.Size h)))
        (.Sum h (subslice start _ 0))
        (.Sum h (subslice end _ 0)))))


  (when (or boring/Enabled (== (fips140/Version) "v1.0.0"))
    (testhash/TestHashWithoutClone t (conv testhash/MakeHash mh))
    (return))

  (testhash/TestHash t (conv testhash/MakeHash mh)))


^{:go/end 48} (go/func newRandReader ^io/Reader [^{:tag (* testing/T)} t]
  (let [seed (.UnixNano (time/Now))]
    ^{:go/via [common]} (.Logf t "Deterministic RNG seed: 0x%x" seed)
    (rand/New (rand/NewSource seed))))

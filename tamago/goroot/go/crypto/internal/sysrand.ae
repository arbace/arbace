(ns go.crypto.internal.sysrand
  (:require [arbace.go :as go]))

(go/package sysrand
  :path "crypto/internal/sysrand"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["rand.go" "rand_tamago.go"]
  :init-order []
  :positions :lines)

(load "sysrand/rand")
(load "sysrand/rand_tamago")

;; Package impl is a registry of alternative implementations of cryptographic
;; primitives, to allow selecting them for testing.
(in-ns 'go.crypto.internal.impl) (go/file "impl.go" :doc "Package impl is a registry of alternative implementations of cryptographic\nprimitives, to allow selecting them for testing.\n" :imports [

    ^{:line 9} [strings "strings"]])

(go/type implementation (struct
    ^{:line 12 :tag string} Package
    ^{:line 13 :tag string} Name
    ^{:line 14 :tag bool} Available
    ^{:line 15 :tag (* bool)} Toggle))


(go/var ^{:tag (slice implementation)} allImplementations)










^{:go/end 39} (go/func Register "Register records an alternative implementation of a cryptographic primitive.\nThe implementation might be available or not based on CPU support. If\navailable is false, the implementation is unavailable and can't be tested on\nthis machine. If available is true, it can be set to false to disable the\nimplementation. If all alternative implementations but one are disabled, the\nremaining one must be used (i.e. disabling one implementation must not\nimplicitly disable any other). Each package has an implicit base\nimplementation that is selected when all alternatives are unavailable or\ndisabled. pkg must be the package name, not path (e.g. \"aes\" not \"crypto/aes\").\n" [^string pkg ^string name ^{:tag (* bool)} available]
  (when (strings/Contains pkg "/")
    (panic "impl: package name must not contain slashes"))

  (set! allImplementations (append allImplementations ^{:go/breaks [2 4 6 8]} (lit implementation
        :Package pkg
        :Name name
        :Available @available
        :Toggle available))))





^{:go/end 53} (go/func Packages "Packages returns the list of all packages for which alternative\nimplementations are registered.\n" ^{:tag (slice string)} []
  (let [^{:tag (slice string)} pkgs (zero (slice string))
      ^{:line 45} seen (make (map string bool))]
    (range [_ i allImplementations]
      (when (not (aget seen (.-Package i)))
        (set! pkgs (append pkgs (.-Package i)))
        (aset seen (.-Package i) true)))


    ^{:line 52} pkgs))





^{:go/end 66} (go/func List "List returns the names of all alternative implementations registered for the\ngiven package, whether available or not. The implicit base implementation is\nnot included.\n" ^{:tag (slice string)} [^string pkg]
  (let [^{:tag (slice string)} names (zero (slice string))]
    (range [_ i allImplementations]
      (when (== (.-Package i) pkg)
        (set! names (append names (.-Name i)))))


    ^{:line 65} names))


^{:go/end 75} (go/func available ^bool [^string pkg ^string name]
  (range [_ i allImplementations]
    (when (and (== (.-Package i) pkg) (== (.-Name i) name))
      (return (.-Available i))))


  (panic "unknown implementation"))





^{:go/breaks [[7 97]] :go/end 98} (go/func Select "Select disables all implementations for the given package except the one\nwith the given name. If name is empty, the base implementation is selected.\nIt returns whether the selected implementation is available.\n" ^bool [^string pkg ^string name]
  (when (== name "")
    (range [_ i allImplementations]
      (when (== (.-Package i) pkg)
        (set! @(.-Toggle i) false)))


    (return true))

  (when (not (available pkg name))
    (return false))

  (range [_ i allImplementations]
    (when (== (.-Package i) pkg)
      (set! @(.-Toggle i) (== (.-Name i) name))))


  true)


^{:go/end 107} (go/func Reset [^string pkg]
  (range [_ i allImplementations]
    (when (== (.-Package i) pkg)
      (set! @(.-Toggle i) (.-Available i))
      (return))))

(in-ns 'go.crypto.internal.fips140hash) (go/file "hash.go" :imports [


    ^:alias ^{:line 8} [fsha3 "crypto/internal/fips140/sha3"]
    ^{:line 9} [sha3 "crypto/sha3"]
    ^{:line 10} [hash "hash"]
    ^{:line 11} [_ "unsafe"]])



(go/func ^:extern ^{:go/linkname "sha3Unwrap"} sha3Unwrap ^{:tag (* fsha3/Digest)} [(* sha3/SHA3)])







^{:go/end 28} (go/func Unwrap "Unwrap returns h, or a crypto/internal/fips140 inner implementation of h.\n\nThe return value can be type asserted to one of\n[crypto/internal/fips140/sha256.Digest],\n[crypto/internal/fips140/sha512.Digest], or\n[crypto/internal/fips140/sha3.Digest] if it is a FIPS 140-3 approved hash.\n" ^hash/Hash [^hash/Hash h]
  (when [(values sha3 ok) (assert (* sha3/SHA3) h)] ok
    (return (sha3Unwrap sha3)))

  ^{:line 27} h)




^{:go/end 34} (go/func UnwrapNew "UnwrapNew returns a function that calls newHash and applies [Unwrap] to the\nreturn value.\n" :type-params [^hash/Hash Hash] ^{:tag (func [] [hash/Hash])} [^{:tag (func [] [Hash])} newHash]
  ^{:go/end 33} (fn ^hash/Hash [] (Unwrap (newHash))))

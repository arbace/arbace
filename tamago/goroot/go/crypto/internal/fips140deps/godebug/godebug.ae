(in-ns 'go.crypto.internal.fips140deps.godebug) (go/file "godebug.go" :imports [


    ^{:line 8} [godebug "internal/godebug"]])


(go/type Setting godebug/Setting)

^{:go/end 15} (go/func New ^{:tag (* Setting)} [^string name]
  (conv (* Setting) (godebug/New name)))


^{:go/end 19} (go/method Value ^string [^{:tag (* Setting)} s]
  (.Value (conv (* godebug/Setting) s)))


^{:go/end 23} (go/func Value ^string [^string name]
  (.Value (godebug/New name)))

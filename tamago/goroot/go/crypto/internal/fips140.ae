(ns go.crypto.internal.fips140
  (:require [arbace.go :as go]))

(go/package fips140
  :path "crypto/internal/fips140"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["cast.go" "fips140.go" "indicator.go" "notasan.go" "notboring.go" "notpurego.go"]
  :init-order [failfipscast]
  :positions :lines)

(load "fips140/cast")
(load "fips140/fips140")
(load "fips140/indicator")
(load "fips140/notasan")
(load "fips140/notboring")
(load "fips140/notpurego")

      ;; r = (u * v3) * (u * v7)^((p-5)/8)
      ^{:line 370} v2 (.Square (new Element) v)
      ^{:line 371} uv3 (.Multiply (new Element) u (.Multiply t0 v2 v))
      ^{:line 372} uv7 (.Multiply (new Element) uv3 (.Square t0 v2))
      ^{:line 373} rr (.Multiply (new Element) uv3 (.Pow22523 t0 uv7))

      ^{:line 375} check (.Multiply (new Element) v (.Square t0 rr)) ; check = v * r^2

      ^{:line 377} uNeg (.Negate (new Element) u)
      ^{:line 378} correctSignSqrt (.Equal check u)

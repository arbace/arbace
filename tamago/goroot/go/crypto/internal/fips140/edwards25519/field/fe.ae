    (set! (.-l2 v) (bit-or (bit-and m (.-l2 a)) (bit-and (bit-not m) (.-l2 b))))
    (set! (.-l3 v) (bit-or (bit-and m (.-l3 a)) (bit-and (bit-not m) (.-l3 b))))
    (set! (.-l4 v) (bit-or (bit-and m (.-l4 a)) (bit-and (bit-not m) (.-l4 b))))

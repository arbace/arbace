^{:go/end 193} (go/method SetBytes "SetBytes sets v to x, where x is a 32-byte little-endian encoding. If x is\nnot of the right length, SetBytes returns nil and an error, and the\nreceiver is unchanged.\n\nConsistent with RFC 7748, the most significant bit (the high bit of the\nlast byte) is ignored, and non-canonical values (2^255-19 through 2^255-1)\nare accepted. Note that this is laxer than specified by RFC 8032, but\nconsistent with most Ed25519 implementations.\n" [^{:tag (* Element)} v ^{:tag (slice byte)} x] :results [(* Element) error]
  (when (!= (len x) 32)
    (return nil (errors/New "edwards25519: invalid field element input size")))


  ;; Bits 0:51 (bytes 0:8, bits 0:64, shift 0, mask 51).
  (set! (.-l0 v) (byteorder/LEUint64 (subslice x 0 8)))
  (set! (.-l0 v) bit-and maskLow51Bits)
  ;; Bits 51:102 (bytes 6:14, bits 48:112, shift 3, mask 51).
  (set! (.-l1 v) (>> (byteorder/LEUint64 (subslice x 6 14)) 3))
  (set! (.-l1 v) bit-and maskLow51Bits)
  ;; Bits 102:153 (bytes 12:20, bits 96:160, shift 6, mask 51).
  (set! (.-l2 v) (>> (byteorder/LEUint64 (subslice x 12 20)) 6))
  (set! (.-l2 v) bit-and maskLow51Bits)
  ;; Bits 153:204 (bytes 19:27, bits 152:216, shift 1, mask 51).
  (set! (.-l3 v) (>> (byteorder/LEUint64 (subslice x 19 27)) 1))
  (set! (.-l3 v) bit-and maskLow51Bits)
  ;; Bits 204:255 (bytes 24:32, bits 192:256, shift 12, mask 51).
  ;; Note: not bytes 25:33, shift 4, to avoid overread.
  (set! (.-l4 v) (>> (byteorder/LEUint64 (subslice x 24 32)) 12))
  (set! (.-l4 v) bit-and maskLow51Bits)

  (return v nil))



^{:go/end 201} (go/method Bytes "Bytes returns the canonical 32-byte little-endian encoding of v.\n" ^{:tag (slice byte)} [^{:tag (* Element)} v]

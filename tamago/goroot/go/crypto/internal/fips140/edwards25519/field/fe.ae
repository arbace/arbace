(go/type Element "Element represents an element of the field GF(2^255-19). Note that this\nis not a cryptographically secure group, and should only be used to interact\nwith edwards25519.Point coordinates.\n\nThis type works similarly to math/big.Int, and all arguments and receivers\nare allowed to alias.\n\nThe zero value is a valid zero element.\n" (struct




    ^{:line 29 :tag uint64 :doc "An element t represents the integer\n    t.l0 + t.l1*2^51 + t.l2*2^102 + t.l3*2^153 + t.l4*2^204\n\nBetween operations, all limbs are expected to be lower than 2^52.\n"} l0
    ^{:line 30 :tag uint64} l1
    ^{:line 31 :tag uint64} l2
    ^{:line 32 :tag uint64} l3
    ^{:line 33 :tag uint64} l4))


(go/const ^{:tag uint64 :val 2251799813685247} maskLow51Bits (- (<< 1 51) 1))

(go/var feZero (addr (lit Element 0 0 0 0 0)))



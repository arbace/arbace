^{:go/end 225} (go/method bytes ^{:tag (slice byte)} [^{:tag (* Element)} v ^{:tag (* (array 32 byte))} out]
  (let [t @v]
    (.reduce t)

    ;; Pack five 51-bit limbs into four 64-bit words:
    ;;
    ;;  255    204    153    102     51      0
    ;;    ├──l4──┼──l3──┼──l2──┼──l1──┼──l0──┤
    ;;   ├───u3───┼───u2───┼───u1───┼───u0───┤
    ;; 256      192      128       64        0

    (let [u0 (bit-or (<< (.-l1 t) 51) (.-l0 t))
        ^{:line 215} u1 (bit-or (<< (.-l2 t) (- 102 64)) (>> (.-l1 t) (- 64 51)))
        ^{:line 216} u2 (bit-or (<< (.-l3 t) (- 153 128)) (>> (.-l2 t) (- 128 102)))
        ^{:line 217} u3 (bit-or (<< (.-l4 t) (- 204 192)) (>> (.-l3 t) (- 192 153)))]

      (byteorder/LEPutUint64 (subslice out (* 0 8)) u0)
      (byteorder/LEPutUint64 (subslice out (* 1 8)) u1)
      (byteorder/LEPutUint64 (subslice out (* 2 8)) u2)
      (byteorder/LEPutUint64 (subslice out (* 3 8)) u3)

      (subslice out))))




^{:go/end 85} (go/method reduce "reduce reduces v modulo 2^255 - 19 and returns it.\n" ^{:tag (* Element)} [^{:tag (* Element)} v]
  (.carryPropagate v)

  ;; After the light reduction we now have a field element representation
  ;; v < 2^255 + 2^13 * 19, but need v < 2^255 - 19.

  ;; If v >= 2^255 - 19, then v + 19 >= 2^255, which would overflow 2^255 - 1,
  ;; generating a carry. That is, c will be 0 if v < 2^255 - 19, and 1 otherwise.
  (let [c (>> (+ (.-l0 v) 19) 51)]
    (set! c (>> (+ (.-l1 v) c) 51))
    (set! c (>> (+ (.-l2 v) c) 51))
    (set! c (>> (+ (.-l3 v) c) 51))
    (set! c (>> (+ (.-l4 v) c) 51))

    ;; If v < 2^255 - 19 and c = 0, this will be a no-op. Otherwise, it's
    ;; effectively applying the reduction identity to the carry.
    (set! (.-l0 v) + (* 19 c))

    (set! (.-l1 v) + (>> (.-l0 v) 51))
    (set! (.-l0 v) (bit-and (.-l0 v) maskLow51Bits))
    (set! (.-l2 v) + (>> (.-l1 v) 51))
    (set! (.-l1 v) (bit-and (.-l1 v) maskLow51Bits))
    (set! (.-l3 v) + (>> (.-l2 v) 51))
    (set! (.-l2 v) (bit-and (.-l2 v) maskLow51Bits))
    (set! (.-l4 v) + (>> (.-l3 v) 51))
    (set! (.-l3 v) (bit-and (.-l3 v) maskLow51Bits))
    ;; no additional carry
    (set! (.-l4 v) (bit-and (.-l4 v) maskLow51Bits))

    ^{:line 84} v))



^{:go/end 95} (go/method Add "Add sets v = a + b, and returns v.\n" ^{:tag (* Element)} [^{:tag (* Element)} v ^{:tag (* Element)} a ^{:tag (* Element)} b]
  (set! (.-l0 v) (+ (.-l0 a) (.-l0 b)))
  (set! (.-l1 v) (+ (.-l1 a) (.-l1 b)))
  (set! (.-l2 v) (+ (.-l2 a) (.-l2 b)))
  (set! (.-l3 v) (+ (.-l3 a) (.-l3 b)))
  (set! (.-l4 v) (+ (.-l4 a) (.-l4 b)))
  (.carryPropagate v))



^{:go/end 107} (go/method Subtract "Subtract sets v = a - b, and returns v.\n" ^{:tag (* Element)} [^{:tag (* Element)} v ^{:tag (* Element)} a ^{:tag (* Element)} b]
  ;; We first add 2 * p, to guarantee the subtraction won't underflow, and
  ;; then subtract b (which can be up to 2^255 + 2^13 * 19).
  (set! (.-l0 v) (- (+ (.-l0 a) 0xFFFFFFFFFFFDA) (.-l0 b)))
  (set! (.-l1 v) (- (+ (.-l1 a) 0xFFFFFFFFFFFFE) (.-l1 b)))
  (set! (.-l2 v) (- (+ (.-l2 a) 0xFFFFFFFFFFFFE) (.-l2 b)))
  (set! (.-l3 v) (- (+ (.-l3 a) 0xFFFFFFFFFFFFE) (.-l3 b)))
  (set! (.-l4 v) (- (+ (.-l4 a) 0xFFFFFFFFFFFFE) (.-l4 b)))
  (.carryPropagate v))



^{:go/end 112} (go/method Negate "Negate sets v = -a, and returns v.\n" ^{:tag (* Element)} [^{:tag (* Element)} v ^{:tag (* Element)} a]
  (.Subtract v feZero a))





^{:go/end 154} (go/method Invert "Invert sets v = 1/z mod p, and returns v.\n\nIf z == 0, Invert returns v = 0.\n" ^{:tag (* Element)} [^{:tag (* Element)} v ^{:tag (* Element)} z]
  ;; Inversion is implemented as exponentiation with exponent p − 2.
  ;; It uses 254 squarings and 11 multiplications, grouping squarings to use SquareN.
  (let [(values ^Element z11 ^Element t0 ^Element t1 ^Element t2 ^Element t) (zero Element)]

    (.Square t1 z) ; 2
    (.Square t (addr t1)) ; 4
    (.Square t (addr t)) ; 8
    (.Multiply t2 (addr t) z) ; 9
    (.Multiply z11 (addr t2) (addr t1)) ; 11
    (.Square t (addr z11)) ; 22
    (.Multiply t0 (addr t) (addr t2)) ; 31 = 2^5 - 2^0

    (.SquareN t (addr t0) 5) ; 2^10 - 2^5
    (.Multiply t2 (addr t) (addr t0)) ; 2^10 - 1

    (.SquareN t (addr t2) 5) ; 2^15 - 2^5
    (.Multiply t0 (addr t) (addr t0)) ; 2^15 - 1

    (.SquareN t (addr t0) 15) ; 2^30 - 2^15
    (.Multiply t1 (addr t) (addr t0)) ; 2^30 - 1

    (.SquareN t (addr t1) 30) ; 2^60 - 2^30
    (.Multiply t0 (addr t) (addr t1)) ; 2^60 - 1

    (.SquareN t (addr t0) 60) ; 2^120 - 2^60
    (.Multiply t1 (addr t) (addr t0)) ; 2^120 - 1

    (.SquareN t (addr t1) 120) ; 2^240 - 2^120
    (.Multiply t (addr t) (addr t1)) ; 2^240 - 1

    (.SquareN t (addr t) 10) ; 2^250 - 2^10
    (.Multiply t (addr t) (addr t2)) ; 2^250 - 1

    (.SquareN t (addr t) 5) ; 2^255 - 2^5

    (.Multiply v (addr t) (addr z11)))) ; 2^255 - 21




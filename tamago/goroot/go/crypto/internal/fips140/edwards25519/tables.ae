(in-ns 'go.crypto.internal.fips140.edwards25519) (go/file "tables.go" :imports [

    ^{:line 7} [constanttime "crypto/internal/constanttime"]])


(go/type projLookupTable "A dynamic lookup table for variable-base, constant-time scalar muls.\n" (struct
    ^{:line 11 :tag (array 8 projCached)} points))



(go/type affineLookupTable "A precomputed lookup table for fixed-base, constant-time scalar muls.\n" (struct
    ^{:line 16 :tag (array 8 affineCached)} points))



(go/type nafLookupTable5 "A dynamic lookup table for variable-base, variable-time scalar muls.\n" (struct
    ^{:line 21 :tag (array 8 projCached)} points))



(go/type nafLookupTable8 "A precomputed lookup table for fixed-base, variable-time scalar muls.\n" (struct
    ^{:line 26 :tag (array 64 affineCached)} points))


;; Constructors.


^{:go/end 44} (go/method FromP3 "Builds a lookup table at runtime. Fast.\n" [^{:tag (* projLookupTable)} v ^{:tag (* Point)} q]
  ;; Goal: v.points[i] = (i+1)*Q, i.e., Q, 2Q, ..., 8Q
  ;; This allows lookup of -8Q, ..., -Q, 0, Q, ..., 8Q
  (.FromP3 (aget (.-points v) 0) q)
  (let [tmpP3 (lit Point)
      ^{:line 37} tmpP1xP1 (lit projP1xP1)]
    (for [i 0] (< i 7) (inc! i)
      ;; Compute (i+1)*Q as Q + i*Q and convert to a projCached
      ;; This is needlessly complicated because the API has explicit
      ;; receivers instead of creating stack objects and relying on RVO
      (.FromP3 (aget (.-points v) (+ i 1)) (.fromP1xP1 tmpP3 (.Add tmpP1xP1 q (addr (aget (.-points v) i))))))))




^{:go/end 57} (go/method FromP3 "This is not optimised for speed; fixed-base tables should be precomputed.\n" [^{:tag (* affineLookupTable)} v ^{:tag (* Point)} q]
  ;; Goal: v.points[i] = (i+1)*Q, i.e., Q, 2Q, ..., 8Q
  ;; This allows lookup of -8Q, ..., -Q, 0, Q, ..., 8Q
  (.FromP3 (aget (.-points v) 0) q)
  (let [tmpP3 (lit Point)
      ^{:line 52} tmpP1xP1 (lit projP1xP1)]
    (for [i 0] (< i 7) (inc! i)
      ;; Compute (i+1)*Q as Q + i*Q and convert to affineCached
      (.FromP3 (aget (.-points v) (+ i 1)) (.fromP1xP1 tmpP3 (.AddAffine tmpP1xP1 q (addr (aget (.-points v) i))))))))




^{:go/end 71} (go/method FromP3 "Builds a lookup table at runtime. Fast.\n" [^{:tag (* nafLookupTable5)} v ^{:tag (* Point)} q]
  ;; Goal: v.points[i] = (2*i+1)*Q, i.e., Q, 3Q, 5Q, ..., 15Q
  ;; This allows lookup of -15Q, ..., -3Q, -Q, 0, Q, 3Q, ..., 15Q
  (.FromP3 (aget (.-points v) 0) q)
  (let [q2 (lit Point)]
    (.Add q2 q q)
    (let [tmpP3 (lit Point)
        ^{:line 67} tmpP1xP1 (lit projP1xP1)]
      (for [i 0] (< i 7) (inc! i)
        (.FromP3 (aget (.-points v) (+ i 1)) (.fromP1xP1 tmpP3 (.Add tmpP1xP1 (addr q2) (addr (aget (.-points v) i)))))))))




^{:go/end 83} (go/method FromP3 "This is not optimised for speed; fixed-base tables should be precomputed.\n" [^{:tag (* nafLookupTable8)} v ^{:tag (* Point)} q]
  (.FromP3 (aget (.-points v) 0) q)
  (let [q2 (lit Point)]
    (.Add q2 q q)
    (let [tmpP3 (lit Point)
        ^{:line 79} tmpP1xP1 (lit projP1xP1)]
      (for [i 0] (< i 63) (inc! i)
        (.FromP3 (aget (.-points v) (+ i 1)) (.fromP1xP1 tmpP3 (.AddAffine tmpP1xP1 (addr q2) (addr (aget (.-points v) i)))))))))



;; Selectors.


^{:go/end 101} (go/method SelectInto "Set dest to x*Q, where -8 <= x <= 8, in constant time.\n" [^{:tag (* projLookupTable)} v ^{:tag (* projCached)} dest ^int8 x]
  ;; Compute xabs = |x|
  (let [xmask (>> x 7)
      ^{:line 91} xabs (conv uint8 (bit-xor (+ x xmask) xmask))]

    (.Zero dest)
    (for [j 1] (<= j 8) (inc! j)
      ;; Set dest = j*Q if |x| = j
      (let [cond (constanttime/ByteEq xabs (conv uint8 j))]
        (.Select dest (addr (aget (.-points v) (- j 1))) dest cond)))

    ;; Now dest = |x|*Q, conditionally negate to get x*Q
    (.CondNeg dest (conv int (bit-and xmask 1)))))



^{:go/end 117} (go/method SelectInto "Set dest to x*Q, where -8 <= x <= 8, in constant time.\n" [^{:tag (* affineLookupTable)} v ^{:tag (* affineCached)} dest ^int8 x]
  ;; Compute xabs = |x|
  (let [xmask (>> x 7)
      ^{:line 107} xabs (conv uint8 (bit-xor (+ x xmask) xmask))]

    (.Zero dest)
    (for [j 1] (<= j 8) (inc! j)
      ;; Set dest = j*Q if |x| = j
      (let [cond (constanttime/ByteEq xabs (conv uint8 j))]
        (.Select dest (addr (aget (.-points v) (- j 1))) dest cond)))

    ;; Now dest = |x|*Q, conditionally negate to get x*Q
    (.CondNeg dest (conv int (bit-and xmask 1)))))



^{:go/end 122} (go/method SelectInto "Given odd x with 0 < x < 2^4, return x*Q (in variable time).\n" [^{:tag (* nafLookupTable5)} v ^{:tag (* projCached)} dest ^int8 x]
  (set! @dest (aget (.-points v) (/ x 2))))



^{:go/end 127} (go/method SelectInto "Given odd x with 0 < x < 2^7, return x*Q (in variable time).\n" [^{:tag (* nafLookupTable8)} v ^{:tag (* affineCached)} dest ^int8 x]
  (set! @dest (aget (.-points v) (/ x 2))))

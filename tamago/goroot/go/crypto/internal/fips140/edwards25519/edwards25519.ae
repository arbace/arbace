^{:go/end 134} (go/method bytes ^{:tag (slice byte)} [^{:tag (* Point)} v ^{:tag (* (array 32 byte))} buf]
  (checkInitialized v)

  (let [(values ^field/Element zInv ^field/Element x ^field/Element y) (zero field/Element)]
    (.Invert zInv (addr (.-z v))) ; zInv = 1 / Z
    (.Multiply x (addr (.-x v)) (addr zInv)) ; x = X / Z
    (.Multiply y (addr (.-y v)) (addr zInv)) ; y = Y / Z

    (let [out (copyFieldElement buf (addr y))]
      (set! (aget out 31) bit-or (conv byte (<< (.IsNegative x) 7)))
      ^{:line 133} out)))


(go/var feOne (.One (new field/Element)))








^{:go/end 187} (go/method SetBytes "SetBytes sets v = x, where x is a 32-byte encoding of v. If x does not\nrepresent a valid point on the curve, SetBytes returns nil and an error and\nthe receiver is unchanged. Otherwise, SetBytes returns v.\n\nNote that SetBytes accepts all non-canonical encodings of valid points.\nThat is, it follows decoding rules that match most implementations in\nthe ecosystem rather than RFC 8032.\n" [^{:tag (* Point)} v ^{:tag (slice byte)} x] :results [(* Point) error]
  ;; Specifically, the non-canonical encodings that are accepted are
  ;;   1) the ones where the field element is not reduced (see the
  ;;      (*field.Element).SetBytes docs) and
  ;;   2) the ones where the x-coordinate is zero and the sign bit is set.
  ;;
  ;; Read more at https://hdevalence.ca/blog/2020-10-04-its-25519am,
  ;; specifically the "Canonical A, R" section.

  (let [(values y err) (.SetBytes (new field/Element) x)]
    (when (!= err nil)
      (return nil (errors/New "edwards25519: invalid point encoding length")))


    ;; -x² + y² = 1 + dx²y²
    ;; x² + dx²y² = x²(dy² + 1) = y² - 1
    ;; x² = (y² - 1) / (dy² + 1)

    ;; u = y² - 1
    (let [y2 (.Square (new field/Element) y)
        ^{:line 165} u (.Subtract (new field/Element) y2 feOne)

        ;; v = dy² + 1
        ^{:line 168} vv (.Multiply (new field/Element) y2 d)]
      (set! vv (.Add vv vv feOne))

      ;; x = +√(u/v)
      (let [(values xx wasSquare) (.SqrtRatio (new field/Element) u vv)]
        (when (== wasSquare 0)
          (return nil (errors/New "edwards25519: invalid point encoding")))


        ;; Select the negative square root if the sign bit is set.
        (let [xxNeg (.Negate (new field/Element) xx)]
          (set! xx (.Select xx xxNeg xx (conv int (>> (aget x 31) 7))))

          (.Set (.-x v) xx)
          (.Set (.-y v) y)
          (.One (.-z v))
          (.Multiply (.-t v) xx y) ; xy = T / Z

          (return v nil))))))


^{:go/end 192} (go/func copyFieldElement ^{:tag (slice byte)} [^{:tag (* (array 32 byte))} buf ^{:tag (* field/Element)} v]

(in-ns 'go.crypto.internal.fips140.sha3) (go/file "sha3_amd64.go" :build ["//go:build !purego"] :imports [])


(go/func ^:extern ^:go/noescape keccakF1600 [^{:tag (* (array 200 byte))} a])

^{:go/end 14} (go/method write [^{:tag (* Digest)} d ^{:tag (slice byte)} p] :results [^int n ^error err]
  (.writeGeneric d p))

^{:go/end 17} (go/method read [^{:tag (* Digest)} d ^{:tag (slice byte)} out] :results [^int n ^error err]
  (.readGeneric d out))

^{:go/end 20} (go/method sum ^{:tag (slice byte)} [^{:tag (* Digest)} d ^{:tag (slice byte)} b]
  (.sumGeneric d b))

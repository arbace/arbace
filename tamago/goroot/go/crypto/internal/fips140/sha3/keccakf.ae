        (set! bc4 (bits/RotateLeft64 t 2))
        (set! t (bit-xor (aget a 22) d2))
        (set! bc0 (bits/RotateLeft64 t 62))
        (set! t (bit-xor (aget a 23) d3))
        (set! bc1 (bits/RotateLeft64 t 55))
        (set! t (bit-xor (aget a 24) d4))
        (set! bc2 (bits/RotateLeft64 t 39))
        (aset a 20 (bit-xor bc0 (bit-and-not bc2 bc1)))
        (aset a 21 (bit-xor bc1 (bit-and-not bc3 bc2)))
        (aset a 22 (bit-xor bc2 (bit-and-not bc4 bc3)))
        (aset a 23 (bit-xor bc3 (bit-and-not bc0 bc4)))
        (aset a 24 (bit-xor bc4 (bit-and-not bc1 bc0)))))))

(in-ns 'go.crypto.internal.fips140.sha3) (go/file "hashes.go" :imports [])


^{:go/end 10} (go/func New224 "New224 returns a new Digest computing the SHA3-224 hash.\n" ^{:tag (* Digest)} []
  (addr (lit Digest :rate rateK448 :outputLen 28 :dsbyte dsbyteSHA3)))



^{:go/end 15} (go/func New256 "New256 returns a new Digest computing the SHA3-256 hash.\n" ^{:tag (* Digest)} []
  (addr (lit Digest :rate rateK512 :outputLen 32 :dsbyte dsbyteSHA3)))



^{:go/end 20} (go/func New384 "New384 returns a new Digest computing the SHA3-384 hash.\n" ^{:tag (* Digest)} []
  (addr (lit Digest :rate rateK768 :outputLen 48 :dsbyte dsbyteSHA3)))



^{:go/end 25} (go/func New512 "New512 returns a new Digest computing the SHA3-512 hash.\n" ^{:tag (* Digest)} []
  (addr (lit Digest :rate rateK1024 :outputLen 64 :dsbyte dsbyteSHA3)))


(go/const
  ^{:line 28} [^{:val 6} dsbyteSHA3 2r00000110]
  ^{:line 29} [^{:val 1} dsbyteKeccak 2r00000001]
  ^{:line 30} [^{:val 31} dsbyteShake 2r00011111]
  ^{:line 31} [^{:val 4} dsbyteCShake 2r00000100]



  ^{:line 35} [^{:val 168 :doc "rateK[c] is the rate in bytes for Keccak[c] where c is the capacity in\nbits. Given the sponge size is 1600 bits, the rate is 1600 - c bits.\n"} rateK256 (/ (- 1600 256) 8)]
  ^{:line 36} [^{:val 144} rateK448 (/ (- 1600 448) 8)]
  ^{:line 37} [^{:val 136} rateK512 (/ (- 1600 512) 8)]
  ^{:line 38} [^{:val 104} rateK768 (/ (- 1600 768) 8)]
  ^{:line 39} [^{:val 72} rateK1024 (/ (- 1600 1024) 8)])




^{:go/end 46} (go/func NewLegacyKeccak256 "NewLegacyKeccak256 returns a new Digest computing the legacy, non-standard\nKeccak-256 hash.\n" ^{:tag (* Digest)} []
  (addr (lit Digest :rate rateK512 :outputLen 32 :dsbyte dsbyteKeccak)))




^{:go/end 52} (go/func NewLegacyKeccak512 "NewLegacyKeccak512 returns a new Digest computing the legacy, non-standard\nKeccak-512 hash.\n" ^{:tag (* Digest)} []
  (addr (lit Digest :rate rateK1024 :outputLen 64 :dsbyte dsbyteKeccak)))

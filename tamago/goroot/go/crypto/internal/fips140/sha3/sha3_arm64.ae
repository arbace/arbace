(in-ns 'go.crypto.internal.fips140.sha3) (go/file "sha3_arm64.go" :build ["//go:build !purego"] :imports [


    ^{:line 10} [cpu "crypto/internal/fips140deps/cpu"]
    ^{:line 11} [impl "crypto/internal/impl"]
    ^{:line 12} [runtime "runtime"]])





(go/var ^{:doc "On non-Apple ARM64, the SHA-3 instructions are apparently slower than the\npure Go implementation. Checking GOOS is a bit blunt, as it also excludes\nAsahi Linux; we might consider checking the MIDR model in the future.\n"} useSHA3 (and cpu/ARM64HasSHA3 (== runtime/GOOS "darwin")))

^{:go/end 22} (go/func init []
  (impl/Register "sha3" "Armv8.2" (addr useSHA3)))



(go/func ^:extern ^:go/noescape keccakF1600NEON [^{:tag (* (array 200 byte))} a])

^{:go/end 33} (go/func keccakF1600 [^{:tag (* (array 200 byte))} a]
  (if useSHA3
    (keccakF1600NEON a)

    (keccakF1600Generic a)))



^{:go/end 37} (go/method write [^{:tag (* Digest)} d ^{:tag (slice byte)} p] :results [^int n ^error err]
  (.writeGeneric d p))

^{:go/end 40} (go/method read [^{:tag (* Digest)} d ^{:tag (slice byte)} out] :results [^int n ^error err]
  (.readGeneric d out))

^{:go/end 43} (go/method sum ^{:tag (slice byte)} [^{:tag (* Digest)} d ^{:tag (slice byte)} b]
  (.sumGeneric d b))

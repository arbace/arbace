^{:go/end 34} (go/func bytepadWrite [^{:tag (* SHAKE)} c ^{:tag (slice byte)} data ^int rate]
  (let [rateEnc (leftEncode (conv uint64 rate))]
    (.Write c rateEnc)
    (.Write c data)
    (when [padlen (- rate (% (+ (len rateEnc) (len data)) rate))] (< padlen rate)
      (let [^:const ^{:val 168} maxRate rateK256]
        (.Write c (make (slice byte) padlen maxRate)))))) ; explicit cap to allow stack allocation



^{:go/end 48} (go/func leftEncode ^{:tag (slice byte)} [^uint64 x]
  ;; Let n be the smallest positive integer for which 2^(8n) > x.
  (let [n (/ (+ (bits/Len64 x) 7) 8)]
    (when (== n 0)
      (set! n 1))

    ;; Return n || x with n as a byte and x an n bytes in big-endian order.
    (let [b (make (slice byte) 9)]
      (byteorder/BEPutUint64 (subslice b 1) x)
      (set! b (subslice b (- 9 n 1)))
      (aset b 0 (conv byte n))
      ^{:line 47} b)))


^{:go/end 59} (go/func newCShake ^{:tag (* SHAKE)} [^{:tag (* SHAKE)} c ^{:tag (slice byte)} N ^{:tag (slice byte)} S ^int rate ^int outputLen ^byte dsbyte]
  (set! (.-d c) (lit Digest :rate rate :outputLen outputLen :dsbyte dsbyte))
  (set! (.-initBlock c) (make (slice byte) 0 (+ 9 (len N) 9 (len S)))) ; leftEncode returns max 9 bytes
  (set! (.-initBlock c) (append (.-initBlock c) (spread (leftEncode (* (conv uint64 (len N)) 8)))))
  (set! (.-initBlock c) (append (.-initBlock c) (spread N)))
  (set! (.-initBlock c) (append (.-initBlock c) (spread (leftEncode (* (conv uint64 (len S)) 8)))))
  (set! (.-initBlock c) (append (.-initBlock c) (spread S)))
  (bytepadWrite c (.-initBlock c) (.-rate (.-d c)))
  ^{:line 58} c)



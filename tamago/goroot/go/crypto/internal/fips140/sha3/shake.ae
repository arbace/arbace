^{:go/breaks [6] :go/end 117} (go/method UnmarshalBinary ^error [^{:tag (* SHAKE)} s ^{:tag (slice byte)} b]
  (when (< (len b) marshaledSize)
    (return (errors/New "sha3: invalid hash state")))

  (when [err (.UnmarshalBinary (.-d s) (subslice b _ marshaledSize))] (!= err nil)
    (return err))

  (set! (.-initBlock s) (bytes/Clone (subslice b marshaledSize)))
  nil)




(in-ns 'go.crypto.internal.fips140.sha3) (go/file "cast.go" :imports [


    ^{:line 8} [bytes "bytes"]
    ^{:line 9} [fips140 "crypto/internal/fips140"]
    ^{:line 10} [errors "errors"]])


^{:go/end 32} (go/func init []
  (fips140/CAST "cSHAKE128" ^{:go/end 31} (fn ^error []
      ^{:go/breaks [[4 30]]} (let [input ^{:go/breaks [2 10]} (lit (slice byte)
            0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08
            0x09 0x0a 0x0b 0x0c 0x0d 0x0e 0x0f 0x10)

          ^{:line 19} want ^{:go/breaks [2 10 18 26]} (lit (slice byte)
            0xd2 0x17 0x37 0x39 0xf6 0xa1 0xe4 0x6e
            0x81 0xe5 0x70 0xe3 0x1b 0x10 0x4c 0x82
            0xc5 0x48 0xee 0xe6 0x09 0xf5 0x89 0x52
            0x52 0xa4 0x69 0xd4 0xd0 0x76 0x68 0x6b)

          ^{:line 25} h (NewCShake128 input input)]
        (.Write h input)
        (when [got (.Sum h nil)] (not (bytes/Equal got want))
          (return (errors/New "unexpected result")))

        nil))))

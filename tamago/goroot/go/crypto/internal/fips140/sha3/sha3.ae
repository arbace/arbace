^{:go/end 59} (go/method Size "Size returns the output size of the hash function in bytes.\n" ^int [^{:tag (* Digest)} d] (.-outputLen d))


^{:go/end 67} (go/method Reset "Reset resets the Digest to its initial state.\n" [^{:tag (* Digest)} d]
  ;; Zero the permutation's state.
  (clear (subslice (.-a d)))
  (set! (.-state d) spongeAbsorbing)
  (set! (.-n d) 0))


^{:go/end 72} (go/method Clone ^{:tag (* Digest)} [^{:tag (* Digest)} d]
  (let [ret @d]
    (addr ret)))



^{:go/end 78} (go/method permute "permute applies the KeccakF-1600 permutation.\n" [^{:tag (* Digest)} d]
  (keccakF1600 (addr (.-a d)))
  (set! (.-n d) 0))




^{:go/end 95} (go/method padAndPermute "padAndPermute appends the domain separation bits in dsbyte, applies\nthe multi-bitrate 10..1 padding rule, and permutes the state.\n" [^{:tag (* Digest)} d]
  ;; Pad with this instance's domain-separator bits. We know that there's
  ;; at least one byte of space in the sponge because, if it were full,
  ;; permute would have been called to empty it. dsbyte also contains the
  ;; first one bit for the padding. See the comment in the state struct.
  (set! (aget (.-a d) (.-n d)) bit-xor (.-dsbyte d))
  ;; This adds the final one bit for the padding. Because of the way that
  ;; bits are numbered from the LSB upwards, the final bit is the MSB of
  ;; the last byte.
  (set! (aget (.-a d) (- (.-rate d) 1)) bit-xor 0x80)
  ;; Apply the permutation
  (.permute d)
  (set! (.-state d) spongeSqueezing))



^{:go/end 98} (go/method Write "Write absorbs more data into the hash's state.\n" [^{:tag (* Digest)} d ^{:tag (slice byte)} p] :results [^int n ^error err] (.write d p))
^{:go/end 118} (go/method writeGeneric [^{:tag (* Digest)} d ^{:tag (slice byte)} p] :results [^int n ^error err]
  (when (!= (.-state d) spongeAbsorbing)
    (panic "sha3: Write after Read"))


  (set! n (len p))

  (while (> (len p) 0)
    (let [x (subtle/XORBytes (subslice (.-a d) (.-n d) (.-rate d)) (subslice (.-a d) (.-n d) (.-rate d)) p)]
      (set! (.-n d) + x)
      (set! p (subslice p x))

      ;; If the sponge is full, apply the permutation.
      (when (== (.-n d) (.-rate d))
        (.permute d))))



  (return))



^{:go/end 142} (go/method readGeneric "read squeezes an arbitrary number of bytes from the sponge.\n" [^{:tag (* Digest)} d ^{:tag (slice byte)} out] :results [^int n ^error err]
  ;; If we're still absorbing, pad and apply the permutation.
  (when (== (.-state d) spongeAbsorbing)
    (.padAndPermute d))


  (set! n (len out))

  ;; Now, do the squeezing.
  (while (> (len out) 0)
    ;; Apply the permutation if we've squeezed the sponge dry.
    (when (== (.-n d) (.-rate d))
      (.permute d))


    (let [x (copy out (subslice (.-a d) (.-n d) (.-rate d)))]
      (set! (.-n d) + x)
      (set! out (subslice out x))))


  (return))




^{:go/end 149} (go/method Sum "Sum appends the current hash to b and returns the resulting slice.\nIt does not change the underlying hash state.\n" ^{:tag (slice byte)} [^{:tag (* Digest)} d ^{:tag (slice byte)} b]
  (fips140/RecordApproved)
  (.sum d b))


^{:go/end 162} (go/method sumGeneric ^{:tag (slice byte)} [^{:tag (* Digest)} d ^{:tag (slice byte)} b]
  (when (!= (.-state d) spongeAbsorbing)
    (panic "sha3: Sum after Read"))


  ;; Make a copy of the original hash so that caller can keep writing
  ;; and summing.
  (let [dup (.Clone d)
      ^{:line 159} hash (make (slice byte) (.-outputLen dup) 64)] ; explicit cap to allow stack allocation
    (.read dup hash)
    (append b (spread hash))))



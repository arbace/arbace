(go/type spongeDirection "spongeDirection indicates the direction bytes are flowing through the sponge.\n" int)

(go/const

  ^{:line 24} [^{:tag spongeDirection :val 0 :doc "spongeAbsorbing indicates that the sponge is absorbing input.\n"} spongeAbsorbing iota]

  ^{:line 26} [^{:val 1 :doc "spongeSqueezing indicates that the sponge is being squeezed.\n"} spongeSqueezing])


(go/type Digest (struct
    ^{:line 30 :tag (array (/ 1600 8) byte)} a ; main state of the hash




    ^{:line 35 :tag int :doc "a[n:rate] is the buffer. If absorbing, it's the remaining space to XOR\ninto before running the permutation. If squeezing, it's the remaining\noutput to produce before running the permutation.\n"} n ^{:tag int :doc "a[n:rate] is the buffer. If absorbing, it's the remaining space to XOR\ninto before running the permutation. If squeezing, it's the remaining\noutput to produce before running the permutation.\n"} rate













    ^{:line 49 :tag byte :doc "dsbyte contains the \"domain separation\" bits and the first bit of\nthe padding. Sections 6.1 and 6.2 of [1] separate the outputs of the\nSHA-3 and SHAKE functions by appending bitstrings to the message.\nUsing a little-endian bit-ordering convention, these are \"01\" for SHA-3\nand \"1111\" for SHAKE, or 00000010b and 00001111b, respectively. Then the\npadding rule from section 5.1 is applied to pad the message to a multiple\nof the rate, which involves adding a \"1\" bit, zero or more \"0\" bits, and\na final \"1\" bit. We merge the first \"1\" bit from the padding into dsbyte,\ngiving 00000110b (0x06) and 00011111b (0x1f).\n[1] http://csrc.nist.gov/publications/drafts/fips-202/fips_202_draft.pdf\n    \"Draft FIPS 202: SHA-3 Standard: Permutation-Based Hash and\n     Extendable-Output Functions (May 2014)\"\n"} dsbyte

    ^{:line 51 :tag int} outputLen ; the default output size in bytes
    ^{:line 52 :tag spongeDirection} state)) ; whether the sponge is absorbing or squeezing




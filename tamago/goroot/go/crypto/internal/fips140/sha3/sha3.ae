  ^{:line 166} [^{:val "sha\t"} magicShake "sha\t"]
  ^{:line 167} [^{:val "sha\n"} magicCShake "sha\n"]
  ^{:line 168} [^{:val "sha\u000b"} magicKeccak "sha\u000b"]

  ^{:line 170} [^{:val 207 :doc "magic || rate || main state || n || sponge direction\n"} marshaledSize (+ (len magicSHA3) 1 200 1 1)])


^{:go/end 175} (go/method MarshalBinary [^{:tag (* Digest)} d] :results [(slice byte) error]
  (.AppendBinary d (make (slice byte) 0 marshaledSize)))


^{:go/end 195} (go/method AppendBinary [^{:tag (* Digest)} d ^{:tag (slice byte)} b] :results [(slice byte) error]
  (switch (.-dsbyte d)
    (case [dsbyteSHA3]
      (set! b (append b (spread magicSHA3))))
    (case [dsbyteShake]
      (set! b (append b (spread magicShake))))
    (case [dsbyteCShake]
      (set! b (append b (spread magicCShake))))
    (case [dsbyteKeccak]
      (set! b (append b (spread magicKeccak))))
    (default
      (panic "unknown dsbyte")))

  ;; rate is at most 168, and n is at most rate.
  (set! b (append b (conv byte (.-rate d))))
  (set! b (append b (spread (subslice (.-a d)))))
  (set! b (append b (conv byte (.-n d)) (conv byte (.-state d))))
  (return b nil))


^{:go/end 233} (go/method UnmarshalBinary ^error [^{:tag (* Digest)} d ^{:tag (slice byte)} b]
  (when (!= (len b) marshaledSize)
    (return (errors/New "sha3: invalid hash state")))


  (let [magic (conv string (subslice b _ (len magicSHA3)))]
    (set! b (subslice b (len magicSHA3)))

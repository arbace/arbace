;; Package drbg provides cryptographically secure random bytes
;; usable by FIPS code. In FIPS mode it uses an SP 800-90A Rev. 1
;; Deterministic Random Bit Generator (DRBG). Otherwise,
;; it uses the operating system's random number generator.
(in-ns 'go.crypto.internal.fips140.drbg) (go/file "rand.go" :doc "Package drbg provides cryptographically secure random bytes\nusable by FIPS code. In FIPS mode it uses an SP 800-90A Rev. 1\nDeterministic Random Bit Generator (DRBG). Otherwise,\nit uses the operating system's random number generator.\n" :imports [


    ^{:line 12} [fips140 "crypto/internal/fips140"]
    ^{:line 13} [sysrand "crypto/internal/sysrand"]
    ^{:line 14} [io "io"]
    ^{:line 15} [sync "sync"]
    ^{:line 16} [atomic "sync/atomic"]])






(go/var ^{:tag (atomic/Pointer Counter) :doc "getEntropy is very slow (~500µs), so we don't want it on the hot path.\nWe keep both a persistent DRBG instance and a pool of additional instances.\nOccasional uses will use drbgInstance, even if the pool was emptied since the\nlast use. Frequent concurrent uses will fill the pool and use it.\n"} drbgInstance)
(go/var drbgPool ^{:go/breaks [2]} (lit sync/Pool
    :New ^{:go/end 27} (fn ^any []
      (NewCounter (getEntropy)))))






^{:go/end 79} (go/func Read "Read fills b with cryptographically secure random bytes. In FIPS mode, it\nuses an SP 800-90A Rev. 1 Deterministic Random Bit Generator (DRBG).\nOtherwise, it uses the operating system's random number generator.\n" [^{:tag (slice byte)} b]
  (when (!= testingReader nil)
    (fips140/RecordNonApproved)
    ;; Avoid letting b escape in the non-testing case.
    (let [bb (make (slice byte) (len b))]
      (.Read testingReader bb)
      (copy b bb)
      (return)))


  (when (not fips140/Enabled)
    (sysrand/Read b)
    (return))


  ;; At every read, 128 random bits from the operating system are mixed as
  ;; additional input, to make the output as strong as non-FIPS randomness.
  ;; This is not credited as entropy for FIPS purposes, as allowed by Section
  ;; 8.7.2: "Note that a DRBG does not rely on additional input to provide
  ;; entropy, even though entropy could be provided in the additional input".
  (let [additionalInput (new (array SeedSize byte))]
    (sysrand/Read (subslice additionalInput _ 16))

    (let [drbg (.Swap drbgInstance nil)]
      (when (== drbg nil)
        (set! drbg (assert (* Counter) (.Get drbgPool))))

      (defer (^{:go/end 64} (fn []
            (when (not (.CompareAndSwap drbgInstance nil drbg))
              (.Put drbgPool drbg)))))



      (while (> (len b) 0)
        (let [size (min (len b) maxRequestSize)]
          (when [reseedRequired (.Generate drbg (subslice b _ size) additionalInput)] reseedRequired
            ;; See SP 800-90A Rev. 1, Section 9.3.1, Steps 6-8, as explained in
            ;; Section 9.3.2: if Generate reports a reseed is required, the
            ;; additional input is passed to Reseed along with the entropy and
            ;; then nulled before the next Generate call.
            (.Reseed drbg (getEntropy) additionalInput)
            (set! additionalInput nil)
            (continue))

          (set! b (subslice b size)))))))



(go/var ^io/Reader testingReader)






^{:go/end 90} (go/func SetTestingReader "SetTestingReader sets a global, deterministic cryptographic randomness source\nfor testing purposes. Its Read method must never return an error, it must\nnever return short, and it must be safe for concurrent use.\n\nThis is only intended to be used by the testing/cryptotest package.\n" [^io/Reader r]
  (set! testingReader r))








(go/type DefaultReader "DefaultReader is a sentinel type, embedded in the default\n[crypto/rand.Reader], used to recognize it when passed to\nAPIs that accept a rand io.Reader.\n\nAny [io.Reader] that embeds this type is assumed to\ncall [Read] as its [io.Reader.Read] method.\n" (struct))

^{:go/end 100} (go/method defaultReader [^DefaultReader d])


^{:go/end 106} (go/func IsDefaultReader "IsDefaultReader reports whether the r embeds the [DefaultReader] type.\n" ^bool [^io/Reader r]
  (let [(values _ ok) (assert (interface (defaultReader [])) r)]
    ^{:line 105} ok))




^{:go/end 119} (go/func ReadWithReader "ReadWithReader uses Reader to fill b with cryptographically secure random\nbytes. It is intended for use in APIs that expose a rand io.Reader.\n" ^error [^io/Reader r ^{:tag (slice byte)} b]
  (when (IsDefaultReader r)
    (Read b)
    (return nil))


  (fips140/RecordNonApproved)
  (let [(values _ err) (io/ReadFull r b)]
    ^{:line 118} err))

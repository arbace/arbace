(in-ns 'go.crypto.internal.fips140.mldsa) (go/file "cast.go" :imports [


    ^{:line 8} [bytes "bytes"]
    ^{:line 9} [fips140 "crypto/internal/fips140"]
    ^{:line 10} [_ "crypto/internal/fips140/check"]
    ^{:line 11} [sha256 "crypto/internal/fips140/sha256"]
    ^{:line 12} [errors "errors"]
    ^{:line 13} [sync "sync"]])


^{:go/end 25} (go/func fipsPCT [^{:tag (* PrivateKey)} priv]
  (fips140/PCT "ML-DSA sign and verify PCT" ^{:go/end 24} (fn ^error []
      (let [μ (make (slice byte) 64)
          (values sig err) (SignExternalMuDeterministic priv μ)]
        (when (!= err nil)
          (return err))

        (VerifyExternalMu (.PublicKey priv) μ sig)))))



(go/var fipsSelfTest (sync/OnceFunc ^{:go/end 29} (fn []
      (fips140/CAST "ML-DSA-44" fips140CAST))))









^{:go/end 82} (go/func fips140CAST "fips140CAST covers all rejection sampling paths, as recommended by IG 10.3.A,\nand as tested by TestCASTRejectionPaths. It tests only one parameter set as\nallowed by Note26. It tests the modified version of Algorithm 7 and 8 with a\nfixed mu/μ, as allowed by IG 10.3.A, Resolution 15. It compares sk and not\npk, because H(pk) is part of sk, as allowed by the same Resolution. It\ncompares the results with hashes instead of values, to avoid embedding several\nkilobytes of test vectors in every binary, as allowed by GeneralNote7.\n" ^error []
  ;; From https://pages.nist.gov/ACVP/draft-celi-acvp-ml-dsa.html#table-1.
  (let [^:var seed (addr ^{:go/breaks [2 10 18 26]} (lit (array 32 byte)
          0x5c 0x62 0x4f 0xcc 0x18 0x62 0x45 0x24
          0x52 0xd0 0xc6 0x65 0x84 0x0d 0x82 0x37
          0xf4 0x31 0x08 0xe5 0x49 0x9e 0xdc 0xdc
          0x10 0x8f 0xbc 0x49 0xd5 0x96 0xe4 0xb7))

      ^:var ^{:line 46} μ (addr ^{:go/breaks [2 10 18 26 34 42 50 58]} (lit (array 64 byte)
          0x2a 0xd1 0xc7 0x2b 0xb0 0xfc 0xbe 0x28
          0x09 0x9c 0xe8 0xbd 0x2e 0xd8 0x36 0xdf
          0xeb 0xe5 0x20 0xaa 0xd3 0x8f 0xba 0xc6
          0x6e 0xf7 0x85 0xa3 0xcf 0xb1 0x0f 0xb4
          0x19 0x32 0x7f 0xa5 0x78 0x18 0xee 0x4e
          0x37 0x18 0xda 0x4b 0xe4 0x8d 0x24 0xb5
          0x9a 0x20 0x8f 0x88 0x07 0x27 0x1f 0xdb
          0x7e 0xda 0x6e 0x60 0x14 0x1b 0xd2 0x63))

      ^:var ^{:line 56} skHash ^{:go/breaks [2 10 18 26]} (lit (slice byte)
        0x29 0x37 0x49 0x51 0xcb 0x2b 0xc3 0xcd
        0xa7 0x31 0x5c 0xe7 0xf0 0xab 0x99 0xc7
        0xd2 0xd6 0x52 0x92 0xe6 0xc5 0x15 0x6e
        0x8a 0xa6 0x2a 0xc1 0x4b 0x14 0x12 0xaf)

      ^:var ^{:line 62} sigHash ^{:go/breaks [2 10 18 26]} (lit (slice byte)
        0xdc 0xc7 0x1a 0x42 0x1b 0xc6 0xff 0xaf
        0xb7 0xdf 0x0c 0x7f 0x6d 0x01 0x8a 0x19
        0xad 0xa1 0x54 0xd1 0xe2 0xee 0x36 0x0e
        0xd5 0x33 0xce 0xcd 0x5d 0xc9 0x80 0xad)

      ^{:line 68} priv (newPrivateKey seed params44)
      ^{:line 69} H (sha256/New)]
    (.Write H (TestingOnlyPrivateKeySemiExpandedBytes priv))
    (when (not (bytes/Equal (.Sum H nil) skHash))
      (return (errors/New "unexpected private key hash")))

    (let [^{:tag (array 32 byte)} random (zero (array 32 byte))
        ^{:line 75} sig (signInternal priv μ (addr random))]
      (.Reset H)
      (.Write H sig)
      (when (not (bytes/Equal (.Sum H nil) sigHash))
        (return (errors/New "unexpected signature hash")))

      (verifyInternal (.PublicKey priv) μ sig))))

        (aset v 0 (conv byte acc)))

      ^{:line 206} out)))


^{:go/end 244} (go/func bitUnpackSlow [^{:tag (slice byte)} v ^int a ^int b] :results [ringElement error]
  (let [bitlen (bits/Len (conv uint (+ a b)))]
    (when (or (<= bitlen 0) (> bitlen 16))
      (panic "mldsa: internal error: invalid bitlen"))

    (when (!= (len v) (/ (* n bitlen) 8))
      (return (lit ringElement) (errors/New "mldsa: invalid input length for bitUnpackSlow")))


    (let [mask (conv uint32 (- ^uint32 (<< 1 bitlen) 1))
        ^{:line 219} maxValue (conv uint32 (+ a b))

        ^{:line 221 :tag ringElement} r (zero ringElement)
        ^{:line 222 :tag uint32} acc (zero uint32)
        ^{:line 223 :tag uint} accBits (zero uint)
        ^{:line 224} vIdx 0]

      (range [i r]
        (while (< accBits (conv uint bitlen))
          (when (< vIdx (len v))
            (set! acc bit-or (<< (conv uint32 (aget v vIdx)) accBits))
            (inc! vIdx)
            (set! accBits + 8)))


        (let [w (bit-and acc mask)]

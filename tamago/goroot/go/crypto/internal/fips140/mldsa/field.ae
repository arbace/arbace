^{:go/end 213} (go/func ntt "ntt maps a ringElement to its nttElement representation.\n\nIt implements NTT, according to FIPS 203, Algorithm 9.\n" ^nttElement [^ringElement f]
  (let [^uint8 m (zero uint8)]

    (for [len 128] (>= len 8) (set! len / 2)
      (for [start 0] (< start 256) (set! start + (* 2 len))
        (inc! m)
        (let [zeta (aget zetas m)

            ;; Bounds check elimination hint.
            (values f flen) (values (subslice f start (+ start len)) (subslice f (+ start len) (+ start len len)))]
          (for [j 0] (< j len) (set! j + 2)
            (let [t (fieldMontgomeryMul zeta (aget flen j))]
              (aset flen j (fieldSub (aget f j) t))
              (aset f j (fieldAdd (aget f j) t))

              ;; Unroll by 2 for performance.
              (set! t (fieldMontgomeryMul zeta (aget flen (+ j 1))))
              (aset flen (+ j 1) (fieldSub (aget f (+ j 1)) t))
              (aset f (+ j 1) (fieldAdd (aget f (+ j 1)) t)))))))




    ;; Unroll len = 4, 2, and 1.
    (for [start 0] (< start 256) (set! start + 8)
      (inc! m)
      (let [zeta (aget zetas m)

          ^{:line 175} t (fieldMontgomeryMul zeta (aget f (+ start 4)))]
        (aset f (+ start 4) (fieldSub (aget f start) t))
        (aset f start (fieldAdd (aget f start) t))

        (set! t (fieldMontgomeryMul zeta (aget f (+ start 5))))
        (aset f (+ start 5) (fieldSub (aget f (+ start 1)) t))
        (aset f (+ start 1) (fieldAdd (aget f (+ start 1)) t))

        (set! t (fieldMontgomeryMul zeta (aget f (+ start 6))))
        (aset f (+ start 6) (fieldSub (aget f (+ start 2)) t))
        (aset f (+ start 2) (fieldAdd (aget f (+ start 2)) t))

        (set! t (fieldMontgomeryMul zeta (aget f (+ start 7))))
        (aset f (+ start 7) (fieldSub (aget f (+ start 3)) t))
        (aset f (+ start 3) (fieldAdd (aget f (+ start 3)) t))))

    (for [start 0] (< start 256) (set! start + 4)
      (inc! m)
      (let [zeta (aget zetas m)

          ^{:line 195} t (fieldMontgomeryMul zeta (aget f (+ start 2)))]
        (aset f (+ start 2) (fieldSub (aget f start) t))
        (aset f start (fieldAdd (aget f start) t))


          (aset f (+ start 4) (fieldMontgomeryMulSub zeta (aget f (+ start 4)) t))

          (set! t (aget f (+ start 1)))
          (aset f (+ start 1) (fieldAdd t (aget f (+ start 5))))
          (aset f (+ start 5) (fieldMontgomeryMulSub zeta (aget f (+ start 5)) t))


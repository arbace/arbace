(in-ns 'go.crypto.internal.fips140.ed25519) (go/file "cast.go" :imports [


    ^{:line 8} [bytes "bytes"]
    ^{:line 9} [fips140 "crypto/internal/fips140"]
    ^{:line 10} [_ "crypto/internal/fips140/check"]
    ^{:line 11} [errors "errors"]
    ^{:line 12} [sync "sync"]])


^{:go/end 19} (go/func fipsPCT [^{:tag (* PrivateKey)} k]
  (fips140/PCT "Ed25519 sign and verify PCT" ^{:go/end 18} (fn ^error []
      (pairwiseTest k))))





^{:go/end 34} (go/func pairwiseTest "pairwiseTest needs to be a top-level function declaration to let the calls\ninline and their allocations not escape.\n" ^error [^{:tag (* PrivateKey)} k]
  (let [msg (conv (slice byte) "PCT")
      ^{:line 25} sig (Sign k msg)
      ;; Note that this runs pub.a.SetBytes. If we wanted to make key generation
      ;; in FIPS mode faster, we could reuse A from GenerateKey. But another thing
      ;; that could make it faster is just _not doing a useless self-test_.
      (values pub err) (NewPublicKey (.PublicKey k))]
    (when (!= err nil)
      (return err))

    (Verify pub msg sig)))


^{:go/end 39} (go/func signWithoutSelfTest ^{:tag (slice byte)} [^{:tag (* PrivateKey)} priv ^{:tag (slice byte)} message]
  (let [signature (make (slice byte) signatureSize)]
    (signWithDom signature priv message domPrefixPure "")))


^{:go/end 43} (go/func verifyWithoutSelfTest ^error [^{:tag (* PublicKey)} pub ^{:tag (slice byte)} message ^{:tag (slice byte)} sig]
  (verifyWithDom pub message sig domPrefixPure ""))


(go/var fipsSelfTest (sync/OnceFunc ^{:go/end 76} (fn []
      (fips140/CAST "Ed25519 sign and verify" ^{:go/end 75} (fn ^error []
          (let [seed ^{:go/breaks [2 10 18 26]} (lit (array 32 byte)
                0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08
                0x09 0x0a 0x0b 0x0c 0x0d 0x0e 0x0f 0x10
                0x11 0x12 0x13 0x14 0x15 0x16 0x17 0x18
                0x19 0x1a 0x1b 0x1c 0x1d 0x1e 0x1f 0x20)

              ^{:line 53} msg (conv (slice byte) "CAST")
              ^{:line 54} want ^{:go/breaks [2 10 18 26 34 42 50 58]} (lit (slice byte)
                0xbd 0xe7 0xa5 0xf3 0x40 0x73 0xb9 0x5a
                0x2e 0x6d 0x63 0x20 0x0a 0xd5 0x92 0x9b
                0xa2 0x3d 0x00 0x44 0xb4 0xc5 0xfd 0x62
                0x1d 0x5e 0x33 0x2f 0xe4 0x61 0x42 0x31
                0x5b 0x10 0x53 0x13 0x4d 0xcb 0xd1 0x1b
                0x2a 0xf6 0xcd 0x0e 0xdb 0x9a 0xd3 0x1e
                0x35 0xdb 0x0b 0xcf 0x58 0x90 0x4f 0xd7
                0x69 0x38 0xed 0x30 0x51 0x0f 0xaa 0x03)

              ^{:line 64} k (addr (lit PrivateKey :seed seed))]
            (precomputePrivateKey k)
            (let [(values pub err) (NewPublicKey (.PublicKey k))]
              (when (!= err nil)
                (return err))

              (let [sig (signWithoutSelfTest k msg)]
                (when (not (bytes/Equal sig want))
                  (return (errors/New "unexpected result")))

                (verifyWithoutSelfTest pub msg sig)))))))))

(ns go.crypto.internal.fips140.drbg
  (:require [arbace.go :as go]))

(go/package drbg
  :path "crypto/internal/fips140/drbg"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["cast.go" "ctrdrbg.go" "entropy_tamago.go" "rand.go"]
  :init-order [getMemory drbgPool]
  :positions :lines)

(load "drbg/cast")
(load "drbg/ctrdrbg")
(load "drbg/entropy_tamago")
(load "drbg/rand")

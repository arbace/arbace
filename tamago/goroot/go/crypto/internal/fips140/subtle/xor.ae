(in-ns 'go.crypto.internal.fips140.subtle) (go/file "xor.go" :imports [

    ^{:line 7} [alias "crypto/internal/fips140/alias"]])









^{:go/end 30} (go/func XORBytes "XORBytes sets dst[i] = x[i] ^ y[i] for all i < n = min(len(x), len(y)),\nreturning n, the number of bytes written to dst.\n\nIf dst does not have length at least n,\nXORBytes panics without writing anything to dst.\n\ndst and x or y may overlap exactly or not at all,\notherwise XORBytes may panic.\n" ^int [^{:tag (slice byte)} dst ^{:tag (slice byte)} x ^{:tag (slice byte)} y]
  (let [n (min (len x) (len y))]
    (when (== n 0)
      (return 0))

    (when (> n (len dst))
      (panic "subtle.XORBytes: dst too short"))

    (when (or (alias/InexactOverlap (subslice dst _ n) (subslice x _ n)) (alias/InexactOverlap (subslice dst _ n) (subslice y _ n)))
      (panic "subtle.XORBytes: invalid overlap"))

    (xorBytes (addr (aget dst 0)) (addr (aget x 0)) (addr (aget y 0)) n) ; arch-specific
    ^{:line 29} n))

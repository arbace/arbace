(in-ns 'go.crypto.internal.fips140.subtle) (go/file "constant_time.go" :imports [


    ^{:line 8} [constanttime "crypto/internal/constanttime"]
    ^{:line 9} [byteorder "crypto/internal/fips140deps/byteorder"]
    ^{:line 10} [bits "math/bits"]])






^{:go/end 29} (go/func ConstantTimeCompare "ConstantTimeCompare returns 1 if the two slices, x and y, have equal contents\nand 0 otherwise. The time taken is a function of the length of the slices and\nis independent of the contents. If the lengths of x and y do not match it\nreturns 0 immediately.\n" ^int [^{:tag (slice byte)} x ^{:tag (slice byte)} y]
  (when (!= (len x) (len y))
    (return 0))


  (let [^byte v (zero byte)]

    (for [i 0] (< i (len x)) (inc! i)
      (set! v bit-or (bit-xor (aget x i) (aget y i))))


    (constanttime/ByteEq v 0)))






^{:go/end 60} (go/func ConstantTimeLessOrEqBytes "ConstantTimeLessOrEqBytes returns 1 if x <= y and 0 otherwise. The comparison\nis lexicographical, or big-endian. The time taken is a function of the length of\nthe slices and is independent of the contents. If the lengths of x and y do not\nmatch it returns 0 immediately.\n" ^int [^{:tag (slice byte)} x ^{:tag (slice byte)} y]
  (when (!= (len x) (len y))
    (return 0))


  ;; Do a constant time subtraction chain y - x.
  ;; If there is no borrow at the end, then x <= y.
  (let [^uint64 b (zero uint64)]
    (while (> (len x) 8)
      (let [x0 (byteorder/BEUint64 (subslice x (- (len x) 8)))
          ^{:line 45} y0 (byteorder/BEUint64 (subslice y (- (len y) 8)))]
        (set! (values _ b) (bits/Sub64 y0 x0 b))
        (set! x (subslice x _ (- (len x) 8)))
        (set! y (subslice y _ (- (len y) 8)))))

    (when (> (len x) 0)
      (let [xb (make (slice byte) 8)
          ^{:line 52} yb (make (slice byte) 8)]
        (copy (subslice xb (- 8 (len x))) x)
        (copy (subslice yb (- 8 (len y))) y)
        (let [x0 (byteorder/BEUint64 xb)
            ^{:line 56} y0 (byteorder/BEUint64 yb)]
          (set! (values _ b) (bits/Sub64 y0 x0 b)))))

    (conv int (bit-xor b 1))))





^{:go/end 75} (go/func ConstantTimeCopy "ConstantTimeCopy copies the contents of y into x (a slice of equal length)\nif v == 1. If v == 0, x is left unchanged. Its behavior is undefined if v\ntakes any other value.\n" [^int v ^{:tag (slice byte)} x ^{:tag (slice byte)} y]
  (when (!= (len x) (len y))
    (panic "subtle: slices have different lengths"))


  (let [xmask (conv byte (- v 1))
      ^{:line 71} ymask (conv byte (bit-not (- v 1)))]
    (for [i 0] (< i (len x)) (inc! i)
      (aset x i (bit-or (bit-and (aget x i) xmask) (bit-and (aget y i) ymask))))))

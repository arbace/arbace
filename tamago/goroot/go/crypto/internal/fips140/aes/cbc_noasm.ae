(in-ns 'go.crypto.internal.fips140.aes) (go/file "cbc_noasm.go" :build ["//go:build (!s390x && !ppc64 && !ppc64le) || purego"] :imports [])

^{:go/end 11} (go/func cryptBlocksEnc [^{:tag (* Block)} b ^{:tag (* (array BlockSize byte))} civ ^{:tag (slice byte)} dst ^{:tag (slice byte)} src]
  (cryptBlocksEncGeneric b civ dst src))


^{:go/end 15} (go/func cryptBlocksDec [^{:tag (* Block)} b ^{:tag (* (array BlockSize byte))} civ ^{:tag (slice byte)} dst ^{:tag (slice byte)} src]
  (cryptBlocksDecGeneric b civ dst src))

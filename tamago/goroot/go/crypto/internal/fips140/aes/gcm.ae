(ns go.crypto.internal.fips140.aes.gcm
  (:require [arbace.go :as go]))

(go/package gcm
  :path "crypto/internal/fips140/aes/gcm"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["cast.go" "cmac.go" "ctrkdf.go" "gcm.go" "gcm_asm.go" "gcm_generic.go" "gcm_nonces.go" "ghash.go"]
  :other-files ["gcm_amd64.s"]
  :init-order [errOpen supportsAESGCM]
  :positions :lines)

(load "gcm/cast")
(load "gcm/cmac")
(load "gcm/ctrkdf")
(load "gcm/gcm")
(load "gcm/gcm_asm")
(load "gcm/gcm_generic")
(load "gcm/gcm_nonces")
(load "gcm/ghash")

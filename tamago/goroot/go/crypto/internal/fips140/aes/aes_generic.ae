^{:go/end 86} (go/func encryptBlockGeneric "Encrypt one block from src into dst, using the expanded key xk.\n" [^{:tag (* blockExpanded)} c ^{:tag (slice byte)} dst ^{:tag (slice byte)} src]
  (checkGenericIsExpected)
  (let [xk (subslice (.-enc c))]

    (set! _ (aget src 15)) ; early bounds check
    (let [s0 (byteorder/BEUint32 (subslice src 0 4))
        ^{:line 48} s1 (byteorder/BEUint32 (subslice src 4 8))
        ^{:line 49} s2 (byteorder/BEUint32 (subslice src 8 12))
        ^{:line 50} s3 (byteorder/BEUint32 (subslice src 12 16))]

      ;; First round just XORs input with key.
      (set! s0 bit-xor (aget xk 0))
      (set! s1 bit-xor (aget xk 1))
      (set! s2 bit-xor (aget xk 2))
      (set! s3 bit-xor (aget xk 3))

      ;; Middle rounds shuffle using tables.
      (let [k 4
          (values ^uint32 t0 ^uint32 t1 ^uint32 t2 ^uint32 t3) (zero uint32)]
        (for [r 0] (< r (- (.-rounds c) 1)) (inc! r)
          (set! t0 (bit-xor (aget xk (+ k 0)) (aget te0 (conv uint8 (>> s0 24))) (aget te1 (conv uint8 (>> s1 16))) (aget te2 (conv uint8 (>> s2 8))) (aget te3 (conv uint8 s3))))
          (set! t1 (bit-xor (aget xk (+ k 1)) (aget te0 (conv uint8 (>> s1 24))) (aget te1 (conv uint8 (>> s2 16))) (aget te2 (conv uint8 (>> s3 8))) (aget te3 (conv uint8 s0))))
          (set! t2 (bit-xor (aget xk (+ k 2)) (aget te0 (conv uint8 (>> s2 24))) (aget te1 (conv uint8 (>> s3 16))) (aget te2 (conv uint8 (>> s0 8))) (aget te3 (conv uint8 s1))))
          (set! t3 (bit-xor (aget xk (+ k 3)) (aget te0 (conv uint8 (>> s3 24))) (aget te1 (conv uint8 (>> s0 16))) (aget te2 (conv uint8 (>> s1 8))) (aget te3 (conv uint8 s2))))
          (set! k + 4)
          (set! (values s0 s1 s2 s3) (values t0 t1 t2 t3)))


        ;; Last round uses s-box directly and XORs to produce output.
        (set! s0 (bit-or (<< (conv uint32 (aget sbox0 (>> t0 24))) 24) (<< (conv uint32 (aget sbox0 (bit-and (>> t1 16) 0xff))) 16) (<< (conv uint32 (aget sbox0 (bit-and (>> t2 8) 0xff))) 8) (conv uint32 (aget sbox0 (bit-and t3 0xff)))))
        (set! s1 (bit-or (<< (conv uint32 (aget sbox0 (>> t1 24))) 24) (<< (conv uint32 (aget sbox0 (bit-and (>> t2 16) 0xff))) 16) (<< (conv uint32 (aget sbox0 (bit-and (>> t3 8) 0xff))) 8) (conv uint32 (aget sbox0 (bit-and t0 0xff)))))
        (set! s2 (bit-or (<< (conv uint32 (aget sbox0 (>> t2 24))) 24) (<< (conv uint32 (aget sbox0 (bit-and (>> t3 16) 0xff))) 16) (<< (conv uint32 (aget sbox0 (bit-and (>> t0 8) 0xff))) 8) (conv uint32 (aget sbox0 (bit-and t1 0xff)))))
        (set! s3 (bit-or (<< (conv uint32 (aget sbox0 (>> t3 24))) 24) (<< (conv uint32 (aget sbox0 (bit-and (>> t0 16) 0xff))) 16) (<< (conv uint32 (aget sbox0 (bit-and (>> t1 8) 0xff))) 8) (conv uint32 (aget sbox0 (bit-and t2 0xff)))))

        (set! s0 bit-xor (aget xk (+ k 0)))
        (set! s1 bit-xor (aget xk (+ k 1)))
        (set! s2 bit-xor (aget xk (+ k 2)))
        (set! s3 bit-xor (aget xk (+ k 3)))

        (set! _ (aget dst 15)) ; early bounds check
        (byteorder/BEPutUint32 (subslice dst 0 4) s0)
        (byteorder/BEPutUint32 (subslice dst 4 8) s1)
        (byteorder/BEPutUint32 (subslice dst 8 12) s2)
        (byteorder/BEPutUint32 (subslice dst 12 16) s3)))))



^{:go/end 133} (go/func decryptBlockGeneric "Decrypt one block from src into dst, using the expanded key xk.\n" [^{:tag (* blockExpanded)} c ^{:tag (slice byte)} dst ^{:tag (slice byte)} src]
  (checkGenericIsExpected)
  (let [xk (subslice (.-dec c))]

    (set! _ (aget src 15)) ; early bounds check
    (let [s0 (byteorder/BEUint32 (subslice src 0 4))
        ^{:line 95} s1 (byteorder/BEUint32 (subslice src 4 8))
        ^{:line 96} s2 (byteorder/BEUint32 (subslice src 8 12))
        ^{:line 97} s3 (byteorder/BEUint32 (subslice src 12 16))]

      ;; First round just XORs input with key.
      (set! s0 bit-xor (aget xk 0))
      (set! s1 bit-xor (aget xk 1))
      (set! s2 bit-xor (aget xk 2))
      (set! s3 bit-xor (aget xk 3))

      ;; Middle rounds shuffle using tables.
      (let [k 4
          (values ^uint32 t0 ^uint32 t1 ^uint32 t2 ^uint32 t3) (zero uint32)]
        (for [r 0] (< r (- (.-rounds c) 1)) (inc! r)
          (set! t0 (bit-xor (aget xk (+ k 0)) (aget td0 (conv uint8 (>> s0 24))) (aget td1 (conv uint8 (>> s3 16))) (aget td2 (conv uint8 (>> s2 8))) (aget td3 (conv uint8 s1))))
          (set! t1 (bit-xor (aget xk (+ k 1)) (aget td0 (conv uint8 (>> s1 24))) (aget td1 (conv uint8 (>> s0 16))) (aget td2 (conv uint8 (>> s3 8))) (aget td3 (conv uint8 s2))))
          (set! t2 (bit-xor (aget xk (+ k 2)) (aget td0 (conv uint8 (>> s2 24))) (aget td1 (conv uint8 (>> s1 16))) (aget td2 (conv uint8 (>> s0 8))) (aget td3 (conv uint8 s3))))
          (set! t3 (bit-xor (aget xk (+ k 3)) (aget td0 (conv uint8 (>> s3 24))) (aget td1 (conv uint8 (>> s2 16))) (aget td2 (conv uint8 (>> s1 8))) (aget td3 (conv uint8 s0))))
          (set! k + 4)
          (set! (values s0 s1 s2 s3) (values t0 t1 t2 t3)))


        ;; Last round uses s-box directly and XORs to produce output.
        (set! s0 (bit-or (<< (conv uint32 (aget sbox1 (>> t0 24))) 24) (<< (conv uint32 (aget sbox1 (bit-and (>> t3 16) 0xff))) 16) (<< (conv uint32 (aget sbox1 (bit-and (>> t2 8) 0xff))) 8) (conv uint32 (aget sbox1 (bit-and t1 0xff)))))
        (set! s1 (bit-or (<< (conv uint32 (aget sbox1 (>> t1 24))) 24) (<< (conv uint32 (aget sbox1 (bit-and (>> t0 16) 0xff))) 16) (<< (conv uint32 (aget sbox1 (bit-and (>> t3 8) 0xff))) 8) (conv uint32 (aget sbox1 (bit-and t2 0xff)))))
        (set! s2 (bit-or (<< (conv uint32 (aget sbox1 (>> t2 24))) 24) (<< (conv uint32 (aget sbox1 (bit-and (>> t1 16) 0xff))) 16) (<< (conv uint32 (aget sbox1 (bit-and (>> t0 8) 0xff))) 8) (conv uint32 (aget sbox1 (bit-and t3 0xff)))))
        (set! s3 (bit-or (<< (conv uint32 (aget sbox1 (>> t3 24))) 24) (<< (conv uint32 (aget sbox1 (bit-and (>> t2 16) 0xff))) 16) (<< (conv uint32 (aget sbox1 (bit-and (>> t1 8) 0xff))) 8) (conv uint32 (aget sbox1 (bit-and t0 0xff)))))

        (set! s0 bit-xor (aget xk (+ k 0)))
        (set! s1 bit-xor (aget xk (+ k 1)))
        (set! s2 bit-xor (aget xk (+ k 2)))
        (set! s3 bit-xor (aget xk (+ k 3)))

        (set! _ (aget dst 15)) ; early bounds check
        (byteorder/BEPutUint32 (subslice dst 0 4) s0)
        (byteorder/BEPutUint32 (subslice dst 4 8) s1)
        (byteorder/BEPutUint32 (subslice dst 8 12) s2)
        (byteorder/BEPutUint32 (subslice dst 12 16) s3)))))



^{:go/end 141} (go/func subw "Apply sbox0 to each byte in w.\n" ^uint32 [^uint32 w]
  (bit-or (<< (conv uint32 (aget sbox0 (>> w 24))) 24)
    (<< (conv uint32 (aget sbox0 (bit-and (>> w 16) 0xff))) 16)
    (<< (conv uint32 (aget sbox0 (bit-and (>> w 8) 0xff))) 8)
    (conv uint32 (aget sbox0 (bit-and w 0xff)))))



^{:go/end 144} (go/func rotw "Rotate\n" ^uint32 [^uint32 w] (bit-or (<< w 8) (>> w 24)))



^{:go/end 181} (go/func expandKeyGeneric "Key expansion algorithm. See FIPS-197, Figure 11.\nTheir rcon[i] is our powx[i-1] << 24.\n" [^{:tag (* blockExpanded)} c ^{:tag (slice byte)} key]
  (checkGenericIsExpected)

  ;; Encryption key setup.
  (let [^int i (zero int)
      ^{:line 153} nk (/ (len key) 4)]
    (for [(set! i 0)] (< i nk) (inc! i)
      (aset (.-enc c) i (byteorder/BEUint32 (subslice key (* 4 i)))))

    (for [] (< i (.roundKeysSize c)) (inc! i)
      (let [t (aget (.-enc c) (- i 1))]
        (cond (== (% i nk) 0)
          (set! t (bit-xor (subw (rotw t)) (<< (conv uint32 (aget powx (- (/ i nk) 1))) 24)))
          (and (> nk 6) (== (% i nk) 4))
          (set! t (subw t)))

        (aset (.-enc c) i (bit-xor (aget (.-enc c) (- i nk)) t))))


    ;; Derive decryption key from encryption key.
    ;; Reverse the 4-word round key sets from enc to produce dec.
    ;; All sets but the first and last get the MixColumn transform applied.
    (let [n (.roundKeysSize c)]
      (for [i 0] (< i n) (set! i + 4)
        (let [ei (- n i 4)]
          (for [j 0] (< j 4) (inc! j)
            (let [x (aget (.-enc c) (+ ei j))]
              (when (and (> i 0) (< (+ i 4) n))
                (set! x (bit-xor (aget td0 (aget sbox0 (>> x 24))) (aget td1 (aget sbox0 (bit-and (>> x 16) 0xff))) (aget td2 (aget sbox0 (bit-and (>> x 8) 0xff))) (aget td3 (aget sbox0 (bit-and x 0xff))))))

              (aset (.-dec c) (+ i j) x))))))))

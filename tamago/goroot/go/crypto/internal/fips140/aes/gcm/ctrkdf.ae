(in-ns 'go.crypto.internal.fips140.aes.gcm) (go/file "ctrkdf.go" :imports [


    ^{:line 8} [fips140 "crypto/internal/fips140"]
    ^{:line 9} [aes "crypto/internal/fips140/aes"]])












(go/type CounterKDF "CounterKDF implements a KDF in Counter Mode instantiated with CMAC-AES,\naccording to NIST SP 800-108 Revision 1 Update 1, Section 4.1.\n\nIt produces a 256-bit output, and accepts a 8-bit Label and a 96-bit Context.\nIt uses a counter of 16 bits placed before the fixed data. The fixed data is\nthe sequence Label || 0x00 || Context. The L field is omitted, since the\noutput key length is fixed.\n\nIt's optimized for use in XAES-256-GCM (https://c2sp.org/XAES-256-GCM),\nrather than for exposing it to applications as a stand-alone KDF.\n" (struct
    ^{:line 23 :tag CMAC} mac))



^{:go/end 29} (go/func NewCounterKDF "NewCounterKDF creates a new CounterKDF with the given key.\n" ^{:tag (* CounterKDF)} [^{:tag (* aes/Block)} b]
  (addr (lit CounterKDF :mac @(NewCMAC b))))



^{:go/end 49} (go/method DeriveKey "DeriveKey derives a key from the given label and context.\n" ^{:tag (array 32 byte)} [^{:tag (* CounterKDF)} kdf ^byte label ^{:tag (array 12 byte)} context]
  (fips140/RecordApproved)
  (let [^{:tag (array 32 byte)} output (zero (array 32 byte))

      ^{:line 36 :tag (array aes/BlockSize byte)} input (zero (array aes/BlockSize byte))]
    (aset input 2 label)
    (copy (subslice input 4) (subslice context))

    (aset input 1 0x01) ; i = 1
    (let [K1 (.MAC (.-mac kdf) (subslice input))]

      (aset input 1 0x02) ; i = 2
      (let [K2 (.MAC (.-mac kdf) (subslice input))]

        (copy (subslice output) (subslice K1))
        (copy (subslice output aes/BlockSize) (subslice K2))
        ^{:line 48} output))))

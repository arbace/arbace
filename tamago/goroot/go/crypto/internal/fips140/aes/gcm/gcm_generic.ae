(in-ns 'go.crypto.internal.fips140.aes.gcm) (go/file "gcm_generic.go" :imports [


    ^{:line 8} [aes "crypto/internal/fips140/aes"]
    ^{:line 9} [subtle "crypto/internal/fips140/subtle"]
    ^{:line 10} [byteorder "crypto/internal/fips140deps/byteorder"]])


^{:go/end 24} (go/func sealGeneric [^{:tag (slice byte)} out ^{:tag (* GCM)} g ^{:tag (slice byte)} nonce ^{:tag (slice byte)} plaintext ^{:tag (slice byte)} additionalData]
  (let [(values ^{:tag (array gcmBlockSize byte)} H ^{:tag (array gcmBlockSize byte)} counter ^{:tag (array gcmBlockSize byte)} tagMask) (zero (array gcmBlockSize byte))]
    (aes/EncryptBlockInternal (addr (.-cipher g)) (subslice H) (subslice H))
    (deriveCounterGeneric (addr H) (addr counter) nonce)
    (gcmCounterCryptGeneric (addr (.-cipher g)) (subslice tagMask) (subslice tagMask) (addr counter))

    (gcmCounterCryptGeneric (addr (.-cipher g)) out plaintext (addr counter))

    (let [^{:tag (array gcmTagSize byte)} tag (zero (array gcmTagSize byte))]
      (gcmAuthGeneric (subslice tag) (addr H) (addr tagMask) (subslice out _ (len plaintext)) additionalData)
      (copy (subslice out (len plaintext)) (subslice tag)))))


^{:go/end 44} (go/func openGeneric ^error [^{:tag (slice byte)} out ^{:tag (* GCM)} g ^{:tag (slice byte)} nonce ^{:tag (slice byte)} ciphertext ^{:tag (slice byte)} additionalData]
  (let [(values ^{:tag (array gcmBlockSize byte)} H ^{:tag (array gcmBlockSize byte)} counter ^{:tag (array gcmBlockSize byte)} tagMask) (zero (array gcmBlockSize byte))]
    (aes/EncryptBlockInternal (addr (.-cipher g)) (subslice H) (subslice H))
    (deriveCounterGeneric (addr H) (addr counter) nonce)
    (gcmCounterCryptGeneric (addr (.-cipher g)) (subslice tagMask) (subslice tagMask) (addr counter))

    (let [tag (subslice ciphertext (- (len ciphertext) (.-tagSize g)))]
      (set! ciphertext (subslice ciphertext _ (- (len ciphertext) (.-tagSize g))))

      ^{:go/breaks [[5 43]]} (let [^{:tag (array gcmTagSize byte)} expectedTag (zero (array gcmTagSize byte))]
        (gcmAuthGeneric (subslice expectedTag) (addr H) (addr tagMask) ciphertext additionalData)
        (when (!= (subtle/ConstantTimeCompare (subslice expectedTag _ (.-tagSize g)) tag) 1)
          (return errOpen))


        (gcmCounterCryptGeneric (addr (.-cipher g)) out ciphertext (addr counter))

        nil))))





^{:go/end 64} (go/func deriveCounterGeneric "deriveCounterGeneric computes the initial GCM counter state from the given nonce.\nSee NIST SP 800-38D, section 7.1. This assumes that counter is filled with\nzeros on entry.\n" [^{:tag (* (array gcmBlockSize byte))} H ^{:tag (* (array gcmBlockSize byte))} counter ^{:tag (slice byte)} nonce]
  ;; GCM has two modes of operation with respect to the initial counter
  ;; state: a "fast path" for 96-bit (12-byte) nonces, and a "slow path"
  ;; for nonces of other lengths. For a 96-bit nonce, the nonce, along
  ;; with a four-byte big-endian counter starting at one, is used
  ;; directly as the starting counter. For other nonce sizes, the counter
  ;; is computed by passing it through the GHASH function.
  (if (== (len nonce) gcmStandardNonceSize) (do
      (copy (subslice counter) nonce)
      (aset counter (- gcmBlockSize 1) 1))

    (let [lenBlock (make (slice byte) 16)]
      (byteorder/BEPutUint64 (subslice lenBlock 8) (* (conv uint64 (len nonce)) 8))
      (ghash counter H nonce lenBlock))))






^{:go/end 86} (go/func gcmCounterCryptGeneric "gcmCounterCryptGeneric encrypts src using AES in counter mode with 32-bit\nwrapping (which is different from AES-CTR) and places the result into out.\ncounter is the initial value and will be updated with the next value.\n" [^{:tag (* aes/Block)} b ^{:tag (slice byte)} out ^{:tag (slice byte)} src ^{:tag (* (array gcmBlockSize byte))} counter]
  (let [^{:tag (array gcmBlockSize byte)} mask (zero (array gcmBlockSize byte))]

    (while (>= (len src) gcmBlockSize)
      (aes/EncryptBlockInternal b (subslice mask) (subslice counter))
      (gcmInc32 counter)

      (subtle/XORBytes out src (subslice mask))
      (set! out (subslice out gcmBlockSize))
      (set! src (subslice src gcmBlockSize)))


    (when (> (len src) 0)
      (aes/EncryptBlockInternal b (subslice mask) (subslice counter))
      (gcmInc32 counter)
      (subtle/XORBytes out src (subslice mask)))))





^{:go/end 93} (go/func gcmInc32 "gcmInc32 treats the final four bytes of counterBlock as a big-endian value\nand increments it.\n" [^{:tag (* (array gcmBlockSize byte))} counterBlock]
  (let [ctr (subslice counterBlock (- (len counterBlock) 4))]
    (byteorder/BEPutUint32 ctr (+ (byteorder/BEUint32 ctr) 1))))




^{:go/end 105} (go/func gcmAuthGeneric "gcmAuthGeneric calculates GHASH(additionalData, ciphertext), masks the result\nwith tagMask and writes the result to out.\n" [^{:tag (slice byte)} out ^{:tag (* (array gcmBlockSize byte))} H ^{:tag (* (array gcmBlockSize byte))} tagMask ^{:tag (slice byte)} ciphertext ^{:tag (slice byte)} additionalData]
  (checkGenericIsExpected)
  (let [lenBlock (make (slice byte) 16)]
    (byteorder/BEPutUint64 (subslice lenBlock _ 8) (* (conv uint64 (len additionalData)) 8))
    (byteorder/BEPutUint64 (subslice lenBlock 8) (* (conv uint64 (len ciphertext)) 8))
    (let [^{:tag (array gcmBlockSize byte)} S (zero (array gcmBlockSize byte))]
      (ghash (addr S) H additionalData ciphertext lenBlock)
      (subtle/XORBytes out (subslice S) (subslice tagMask)))))

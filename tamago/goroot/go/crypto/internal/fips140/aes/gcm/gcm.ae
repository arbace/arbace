^{:go/end 128} (go/method Open [^{:tag (* GCM)} g ^{:tag (slice byte)} dst ^{:tag (slice byte)} nonce ^{:tag (slice byte)} ciphertext ^{:tag (slice byte)} data] :results [(slice byte) error]

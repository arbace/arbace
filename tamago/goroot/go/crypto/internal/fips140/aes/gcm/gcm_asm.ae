(go/var ^{:doc "Keep in sync with crypto/tls.hasAESGCMHardwareSupport.\n"} supportsAESGCM (or (and cpu/X86HasAES cpu/X86HasPCLMULQDQ cpu/X86HasSSE41 cpu/X86HasSSSE3)
    (and cpu/ARM64HasAES cpu/ARM64HasPMULL)))

^{:go/end 44} (go/func init []
  (when cpu/AMD64
    (impl/Register "gcm" "AES-NI" (addr supportsAESGCM)))

  (when cpu/ARM64
    (impl/Register "gcm" "Armv8.0" (addr supportsAESGCM))))






^{:go/end 53} (go/func checkGenericIsExpected "checkGenericIsExpected is called by the variable-time implementation to make\nsure it is not used when hardware support is available. It shouldn't happen,\nbut this way it's more evidently correct.\n" []
  (when supportsAESGCM
    (panic "gcm: internal error: using generic implementation despite hardware support")))



(go/type gcmPlatformData (struct
    ^{:line 56 :tag (array 256 byte)} productTable))


^{:go/end 64} (go/func initGCM [^{:tag (* GCM)} g]
  (when (not supportsAESGCM)
    (return))

  (gcmAesInit (addr ^{:go/via [gcmPlatformData]} (.-productTable g)) (aes/EncryptionKeySchedule (addr (.-cipher g)))))


^{:go/end 94} (go/func seal [^{:tag (slice byte)} out ^{:tag (* GCM)} g ^{:tag (slice byte)} nonce ^{:tag (slice byte)} plaintext ^{:tag (slice byte)} data]
  (when (not supportsAESGCM)
    (sealGeneric out g nonce plaintext data)
    (return))


  (let [(values ^{:tag (array gcmBlockSize byte)} counter ^{:tag (array gcmBlockSize byte)} tagMask) (zero (array gcmBlockSize byte))]

    (if (== (len nonce) gcmStandardNonceSize) (do
        ;; Init counter to nonce||1
        (copy (subslice counter) nonce)
        (aset counter (- gcmBlockSize 1) 1))
      (do
        ;; Otherwise counter = GHASH(nonce)
        (gcmAesData (addr ^{:go/via [gcmPlatformData]} (.-productTable g)) nonce (addr counter))
        (gcmAesFinish (addr ^{:go/via [gcmPlatformData]} (.-productTable g)) (addr tagMask) (addr counter) (conv uint64 (len nonce)) (conv uint64 0))))


    (aes/EncryptBlockInternal (addr (.-cipher g)) (subslice tagMask) (subslice counter))

    (let [^{:tag (array gcmTagSize byte)} tagOut (zero (array gcmTagSize byte))]
      (gcmAesData (addr ^{:go/via [gcmPlatformData]} (.-productTable g)) data (addr tagOut))

      (when (> (len plaintext) 0)
        (gcmAesEnc (addr ^{:go/via [gcmPlatformData]} (.-productTable g)) out plaintext (addr counter) (addr tagOut) (aes/EncryptionKeySchedule (addr (.-cipher g)))))

      (gcmAesFinish (addr ^{:go/via [gcmPlatformData]} (.-productTable g)) (addr tagMask) (addr tagOut) (conv uint64 (len plaintext)) (conv uint64 (len data)))
      (copy (subslice out (len plaintext)) (subslice tagOut)))))


^{:go/end 131} (go/func open ^error [^{:tag (slice byte)} out ^{:tag (* GCM)} g ^{:tag (slice byte)} nonce ^{:tag (slice byte)} ciphertext ^{:tag (slice byte)} data]
  (when (not supportsAESGCM)
    (return (openGeneric out g nonce ciphertext data)))


  (let [tag (subslice ciphertext (- (len ciphertext) (.-tagSize g)))]
    (set! ciphertext (subslice ciphertext _ (- (len ciphertext) (.-tagSize g))))

    ;; See GCM spec, section 7.1.
    (let [(values ^{:tag (array gcmBlockSize byte)} counter ^{:tag (array gcmBlockSize byte)} tagMask) (zero (array gcmBlockSize byte))]

      (if (== (len nonce) gcmStandardNonceSize) (do
          ;; Init counter to nonce||1
          (copy (subslice counter) nonce)
          (aset counter (- gcmBlockSize 1) 1))
        (do
          ;; Otherwise counter = GHASH(nonce)
          (gcmAesData (addr ^{:go/via [gcmPlatformData]} (.-productTable g)) nonce (addr counter))
          (gcmAesFinish (addr ^{:go/via [gcmPlatformData]} (.-productTable g)) (addr tagMask) (addr counter) (conv uint64 (len nonce)) (conv uint64 0))))


      (aes/EncryptBlockInternal (addr (.-cipher g)) (subslice tagMask) (subslice counter))

      ^{:go/breaks [[6 130]]} (let [^{:tag (array gcmTagSize byte)} expectedTag (zero (array gcmTagSize byte))]
        (gcmAesData (addr ^{:go/via [gcmPlatformData]} (.-productTable g)) data (addr expectedTag))

        (when (> (len ciphertext) 0)
          (gcmAesDec (addr ^{:go/via [gcmPlatformData]} (.-productTable g)) out ciphertext (addr counter) (addr expectedTag) (aes/EncryptionKeySchedule (addr (.-cipher g)))))

        (gcmAesFinish (addr ^{:go/via [gcmPlatformData]} (.-productTable g)) (addr tagMask) (addr expectedTag) (conv uint64 (len ciphertext)) (conv uint64 (len data)))

        (when (!= (subtle/ConstantTimeCompare (subslice expectedTag _ (.-tagSize g)) tag) 1)
          (return errOpen))

        nil))))

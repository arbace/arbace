^{:go/end 38} (go/method deriveSubkeys [^{:tag (* CMAC)} c]
  (aes/EncryptBlockInternal (addr (.-b c)) (subslice (.-k1 c)) (subslice (.-k1 c)))
  (let [msb (shiftLeft (addr (.-k1 c)))]
    (set! (aget (.-k1 c) (- (len (.-k1 c)) 1)) bit-xor (* msb 2r10000111))

    (set! (.-k2 c) (.-k1 c))
    (set! msb (shiftLeft (addr (.-k2 c))))
    (set! (aget (.-k2 c) (- (len (.-k2 c)) 1)) bit-xor (* msb 2r10000111))))



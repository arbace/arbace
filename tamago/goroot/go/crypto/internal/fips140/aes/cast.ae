(in-ns 'go.crypto.internal.fips140.aes) (go/file "cast.go" :imports [


    ^{:line 8} [bytes "bytes"]
    ^{:line 9} [fips140 "crypto/internal/fips140"]
    ^{:line 10} [_ "crypto/internal/fips140/check"]
    ^{:line 11} [errors "errors"]])


^{:go/end 47} (go/func init []
  (fips140/CAST "AES-CBC" ^{:go/end 46} (fn ^error []
      (let [key ^{:go/breaks [2 10]} (lit (slice byte)
            0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08
            0x09 0x0a 0x0b 0x0c 0x0d 0x0e 0x0f 0x10)

          ^{:line 20} iv ^{:go/breaks [2 10]} (lit (array 16 byte)
            0x11 0x12 0x13 0x14 0x15 0x16 0x17 0x18
            0x19 0x1a 0x1b 0x1c 0x1d 0x1e 0x1f 0x20)

          ^{:line 24} plaintext ^{:go/breaks [2 10]} (lit (slice byte)
            0x21 0x22 0x23 0x24 0x25 0x26 0x27 0x28
            0x29 0x2a 0x2b 0x2c 0x2d 0x2e 0x2f 0x30)

          ^{:line 28} ciphertext ^{:go/breaks [2 10]} (lit (slice byte)
            0xdf 0x76 0x26 0x4b 0xd3 0xb2 0xc4 0x8d
            0x40 0xa2 0x6e 0x7a 0xc4 0xff 0xbd 0x35)

          (values b err) (New key)]
        (when (!= err nil)
          (return err))

        ^{:go/breaks [[6 45]]} (let [buf (make (slice byte) 16)]
          (.CryptBlocks (NewCBCEncrypter b iv) buf plaintext)
          (when (not (bytes/Equal buf ciphertext))
            (return (errors/New "unexpected result")))

          (.CryptBlocks (NewCBCDecrypter b iv) buf ciphertext)
          (when (not (bytes/Equal buf plaintext))
            (return (errors/New "unexpected result")))

          nil)))))

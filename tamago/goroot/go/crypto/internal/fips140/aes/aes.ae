^{:go/end 109} (go/method Encrypt [^{:tag (* Block)} c ^{:tag (slice byte)} dst ^{:tag (slice byte)} src]
  ;; AES-ECB is not approved in FIPS 140-3 mode.
  (fips140/RecordNonApproved)
  (when (< (len src) BlockSize)
    (panic "crypto/aes: input not full block"))

  (when (< (len dst) BlockSize)
    (panic "crypto/aes: output not full block"))

  (when (alias/InexactOverlap (subslice dst _ BlockSize) (subslice src _ BlockSize))
    (panic "crypto/aes: invalid buffer overlap"))

  (encryptBlock c dst src))


^{:go/end 124} (go/method Decrypt [^{:tag (* Block)} c ^{:tag (slice byte)} dst ^{:tag (slice byte)} src]
  ;; AES-ECB is not approved in FIPS 140-3 mode.
  (fips140/RecordNonApproved)
  (when (< (len src) BlockSize)
    (panic "crypto/aes: input not full block"))

  (when (< (len dst) BlockSize)
    (panic "crypto/aes: output not full block"))

  (when (alias/InexactOverlap (subslice dst _ BlockSize) (subslice src _ BlockSize))
    (panic "crypto/aes: invalid buffer overlap"))

  (decryptBlock c dst src))






^{:go/end 41} (go/method CryptBlocks [^{:tag (* CBCEncrypter)} c ^{:tag (slice byte)} dst ^{:tag (slice byte)} src]
  (when (!= (% (len src) BlockSize) 0)
    (panic "crypto/cipher: input not full blocks"))

  (when (< (len dst) (len src))
    (panic "crypto/cipher: output smaller than input"))

  (when (alias/InexactOverlap (subslice dst _ (len src)) src)

^{:go/end 130} (go/func cryptBlocksDecGeneric [^{:tag (* Block)} b ^{:tag (* (array BlockSize byte))} civ ^{:tag (slice byte)} dst ^{:tag (slice byte)} src]
  ;; For each block, we need to xor the decrypted data with the previous
  ;; block's ciphertext (the iv). To avoid making a copy each time, we loop
  ;; over the blocks backwards.
  (let [end (len src)
      ^{:line 109} start (- end BlockSize)
      ^{:line 110} prev (- start BlockSize)

      ;; Copy the last block of ciphertext as the IV of the next call.
      ^{:line 113} iv @civ]
    (copy (subslice civ) (subslice src start end))

    (while (>= start 0)
      (decryptBlock b (subslice dst start end) (subslice src start end))

      (if (> start 0)
        (subtle/XORBytes (subslice dst start end) (subslice dst start end) (subslice src prev start))

        ;; The first block is special because it uses the saved iv.
        (subtle/XORBytes (subslice dst start end) (subslice dst start end) (subslice iv)))


      (set! end - BlockSize)
      (set! start - BlockSize)
      (set! prev - BlockSize))))

^{:go/end 22} (go/func NewCBCEncrypter "NewCBCEncrypter returns a [cipher.BlockMode] which encrypts in cipher block\nchaining mode, using the given Block.\n" ^{:tag (* CBCEncrypter)} [^{:tag (* Block)} b ^{:tag (array BlockSize byte)} iv]

^{:go/end 65} (go/func cryptBlocksEncGeneric [^{:tag (* Block)} b ^{:tag (* (array BlockSize byte))} civ ^{:tag (slice byte)} dst ^{:tag (slice byte)} src]
  (let [iv (subslice civ)]
    (while (> (len src) 0)
      ;; Write the xor to dst, then encrypt in place.
      (subtle/XORBytes (subslice dst _ BlockSize) (subslice src _ BlockSize) iv)
      (encryptBlock b (subslice dst _ BlockSize) (subslice dst _ BlockSize))

      ;; Move to the next block with this block as the next iv.
      (set! iv (subslice dst _ BlockSize))
      (set! src (subslice src BlockSize))
      (set! dst (subslice dst BlockSize)))


    ;; Save the iv for the next CryptBlocks call.
    (copy (subslice civ) iv)))



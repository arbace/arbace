(ns go.crypto.internal.fips140.rsa
  (:require [arbace.go :as go]))

(go/package rsa
  :path "crypto/internal/fips140/rsa"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["cast.go" "keygen.go" "largeexponent.go" "pkcs1v15.go" "pkcs1v22.go" "rsa.go"]
  :init-order [errDivisorTooLarge primes hashPrefixes ErrMessageTooLong ErrDecryption ErrVerification fipsSelfTest]
  :positions :lines)

(load "rsa/cast")
(load "rsa/keygen")
(load "rsa/largeexponent")
(load "rsa/pkcs1v15")
(load "rsa/pkcs1v22")
(load "rsa/rsa")

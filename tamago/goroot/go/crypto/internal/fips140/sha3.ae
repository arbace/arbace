(ns go.crypto.internal.fips140.sha3
  (:require [arbace.go :as go]))

(go/package sha3
  :path "crypto/internal/fips140/sha3"
  :files ["cast.go" "hashes.go" "keccakf.go" "sha3.go" "sha3_amd64.go" "sha3_arm64.go" "shake.go"]
  :other-files ["sha3_amd64.s" "sha3_arm64.s"]
  :positions :lines)

(load "sha3/cast")
(load "sha3/hashes")
(load "sha3/keccakf")
(load "sha3/sha3")
(load "sha3/sha3_amd64")
(load "sha3/sha3_arm64")
(load "sha3/shake")

(ns go.crypto.internal.fips140.sha3
  (:require [arbace.go :as go]))

(go/package sha3
  :path "crypto/internal/fips140/sha3"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["cast.go" "hashes.go" "keccakf.go" "sha3.go" "sha3_amd64.go" "shake.go"]
  :other-files ["sha3_amd64.s"]
  :init-order [rc]
  :positions :lines)

(load "sha3/cast")
(load "sha3/hashes")
(load "sha3/keccakf")
(load "sha3/sha3")
(load "sha3/sha3_amd64")
(load "sha3/shake")

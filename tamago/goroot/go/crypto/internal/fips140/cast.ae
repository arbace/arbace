(in-ns 'go.crypto.internal.fips140) (go/file "cast.go" :imports [


    ^{:line 8} [godebug "crypto/internal/fips140deps/godebug"]
    ^{:line 9} [errors "errors"]
    ^{:line 10} [strings "strings"]
    ^{:line 11} [_ "unsafe"]]) ; for go:linkname





(go/func ^:extern ^{:go/linkname "fatal crypto/internal/fips140.fatal"} fatal "fatal is [runtime.fatal], pushed via linkname.\n" [string])




(go/var ^{:doc "failfipscast is a GODEBUG key allowing simulation of a CAST or PCT failure,\nas required during FIPS 140-3 functional testing. The value is the whole name\nof the target CAST or PCT.\n"} failfipscast (godebug/Value "#failfipscast"))














^{:go/end 56} (go/func CAST "CAST runs the named Cryptographic Algorithm Self-Test (if operated in FIPS\nmode) and aborts the program (stopping the module input/output and entering\nthe \"error state\") if the self-test fails.\n\nCASTs are mandatory self-checks that must be performed by FIPS 140-3 modules\nbefore the algorithm is used. See Implementation Guidance 10.3.A.\n\nThe name must not contain commas, colons, hashes, or equal signs.\n\nIf a package p calls CAST from its init function, an import of p should also\nbe added to crypto/internal/fips140test. If a package p calls CAST on the first\nuse of the algorithm, an invocation of that algorithm should be added to\nfipstest.TestConditionals.\n" [^string name ^{:tag (func [] [error])} f]
  (when (strings/ContainsAny name ",#=:")
    (panic (+ "fips: invalid self-test name: " name)))

  (when (not Enabled)
    (return))


  (let [err (f)]
    (when (== name failfipscast)
      (set! err (errors/New "simulated CAST failure")))

    (when (!= err nil)
      (fatal (+ "FIPS 140-3 self-test failed: " name ": " (.Error err)))
      (panic "unreachable"))

    (when debug
      (println "FIPS 140-3 self-test passed:" name))))















^{:go/end 89} (go/func PCT "PCT runs the named Pairwise Consistency Test (if operated in FIPS mode) and\naborts the program (stopping the module input/output and entering the \"error\nstate\") if the test fails.\n\nPCTs are mandatory for every generated (but not imported) key pair, including\nephemeral keys (which effectively doubles the cost of key establishment). See\nImplementation Guidance 10.3.A Additional Comment 1.\n\nThe name must not contain commas, colons, hashes, or equal signs.\n\nIf a package p calls PCT during key generation, an invocation of that\nfunction should be added to fipstest.TestConditionals.\n" [^string name ^{:tag (func [] [error])} f]
  (when (strings/ContainsAny name ",#=:")
    (panic (+ "fips: invalid self-test name: " name)))

  (when (not Enabled)
    (return))


  (let [err (f)]
    (when (== name failfipscast)
      (set! err (errors/New "simulated PCT failure")))

    (when (!= err nil)
      (fatal (+ "FIPS 140-3 self-test failed: " name ": " (.Error err)))
      (panic "unreachable"))

    (when debug
      (println "FIPS 140-3 PCT passed:" name))))

(in-ns 'go.crypto.internal.fips140.tls12) (go/file "cast.go" :imports [


    ^{:line 8} [bytes "bytes"]
    ^{:line 9} [fips140 "crypto/internal/fips140"]
    ^{:line 10} [_ "crypto/internal/fips140/check"]
    ^{:line 11} [sha256 "crypto/internal/fips140/sha256"]
    ^{:line 12} [errors "errors"]])


^{:go/end 38} (go/func init []
  (fips140/CAST "TLSv1.2-SHA2-256" ^{:go/end 37} (fn ^error []
      ^{:go/breaks [[3 36]]} (let [input ^{:go/breaks [2 10]} (lit (slice byte)
            0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08
            0x09 0x0a 0x0b 0x0c 0x0d 0x0e 0x0f 0x10)

          ^{:line 21} transcript ^{:go/breaks [2 10]} (lit (slice byte)
            0x11 0x12 0x13 0x14 0x15 0x16 0x17 0x18
            0x19 0x1a 0x1b 0x1c 0x1d 0x1e 0x1f 0x20)

          ^{:line 25} want ^{:go/breaks [2 10 18 26 34 42]} (lit (slice byte)
            0x8c 0x3e 0xed 0xa7 0x1c 0x1b 0x4c 0xc0
            0xa0 0x44 0x90 0x75 0xa8 0x8e 0xbc 0x7c
            0x5e 0x1c 0x4b 0x1e 0x4f 0xe3 0xc1 0x06
            0xeb 0xdc 0xc0 0x5d 0xc0 0xc8 0xec 0xf3
            0xe2 0xb9 0xd1 0x03 0x5e 0xb2 0x60 0x5d
            0x12 0x68 0x4f 0x49 0xdf 0xa9 0x9d 0xcc)]

        (when [got (^{:inst [(* sha256/Digest)]} MasterSecret sha256/New input transcript)] (not (bytes/Equal got want))
          (return (errors/New "unexpected result")))

        nil))))

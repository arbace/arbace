(in-ns 'go.crypto.internal.fips140.tls12) (go/file "tls12.go" :imports [


    ^{:line 8} [fips140 "crypto/internal/fips140"]
    ^{:line 9} [hmac "crypto/internal/fips140/hmac"]
    ^{:line 10} [sha256 "crypto/internal/fips140/sha256"]
    ^{:line 11} [sha512 "crypto/internal/fips140/sha512"]
    ^{:line 12} [hash "hash"]])




^{:go/end 25} (go/func PRF "PRF implements the TLS 1.2 pseudo-random function, as defined in RFC 5246,\nSection 5 and allowed by SP 800-135, Revision 1, Section 4.2.2.\n" :type-params [^hash/Hash H] ^{:tag (slice byte)} [^{:tag (func [] [H])} hash ^{:tag (slice byte)} secret ^string label ^{:tag (slice byte)} seed ^int keyLen]
  (let [labelAndSeed (make (slice byte) (+ (len label) (len seed)))]
    (copy labelAndSeed label)
    (copy (subslice labelAndSeed (len label)) seed)

    (let [result (make (slice byte) keyLen)]
      (^{:inst [H]} pHash hash result secret labelAndSeed)
      ^{:line 24} result)))



^{:go/end 45} (go/func pHash "pHash implements the P_hash function, as defined in RFC 5246, Section 5.\n" :type-params [^hash/Hash H] [^{:tag (func [] [H])} hash ^{:tag (slice byte)} result ^:go/grouped ^{:tag (slice byte)} secret ^:go/grouped ^{:tag (slice byte)} seed]
  (let [h (^{:inst [H]} hmac/New hash secret)]
    (.Write h seed)
    (let [a (.Sum h nil)]

      (while (> (len result) 0)
        (.Reset h)
        (.Write h a)
        (.Write h seed)
        (let [b (.Sum h nil)
            ^{:line 38} n (copy result b)]
          (set! result (subslice result n))

          (.Reset h)
          (.Write h a)
          (set! a (.Sum h nil)))))))



(go/const ^{:val 48} masterSecretLength 48)
(go/const ^{:val "extended master secret"} extendedMasterSecretLabel "extended master secret")



^{:go/end 70} (go/func MasterSecret "MasterSecret implements the TLS 1.2 extended master secret derivation, as\ndefined in RFC 7627 and allowed by SP 800-135, Revision 1, Section 4.2.2.\n" :type-params [^hash/Hash H] ^{:tag (slice byte)} [^{:tag (func [] [H])} hash ^{:tag (slice byte)} preMasterSecret ^:go/grouped ^{:tag (slice byte)} transcript]
  ;; "The TLS 1.2 KDF is an approved KDF when the following conditions are
  ;; satisfied: [...] (3) P_HASH uses either SHA-256, SHA-384 or SHA-512."
  (let [h (hash)]
    (type-switch (conv any h)
      (case [(* sha256/Digest)]
        (when (!= (.Size h) 32)
          (fips140/RecordNonApproved)))

      (case [(* sha512/Digest)]
        (when (and (!= (.Size h) 46) (!= (.Size h) 64))
          (fips140/RecordNonApproved)))

      (default
        (fips140/RecordNonApproved)))


    (^{:inst [H]} PRF hash preMasterSecret extendedMasterSecretLabel transcript masterSecretLength)))

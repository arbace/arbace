(ns go.crypto.internal.fips140.ecdsa
  (:require [arbace.go :as go]))

(go/package ecdsa
  :path "crypto/internal/fips140/ecdsa"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["cast.go" "ecdsa.go" "ecdsa_noasm.go" "hmacdrbg.go"]
  :init-order [p224Order _P224 p256Order _P256 p384Order _P384 p521Order _P521 fipsSelfTest fipsSelfTestDeterministic]
  :positions :lines)

(load "ecdsa/cast")
(load "ecdsa/ecdsa")
(load "ecdsa/ecdsa_noasm")
(load "ecdsa/hmacdrbg")

(in-ns 'go.crypto.internal.fips140) (go/file "indicator.go" :imports [

    ^{:line 7} [_ "unsafe"]]) ; for go:linkname

;; The service indicator lets users of the module query whether invoked services
;; are approved. Three states are stored in a per-goroutine value by the
;; runtime. The indicator starts at indicatorUnset after a reset. Invoking an
;; approved service transitions to indicatorTrue. Invoking a non-approved
;; service transitions to indicatorFalse, and it can't leave that state until a
;; reset. The idea is that functions can "delegate" checks to inner functions,
;; and if there's anything non-approved in the stack, the final result is
;; negative. Finally, we expose indicatorUnset as negative to the user, so that
;; we don't need to explicitly annotate fully non-approved services.


(go/func ^:extern ^{:go/linkname "getIndicator crypto/internal/fips140.getIndicator"} getIndicator ^uint8 [])


(go/func ^:extern ^{:go/linkname "setIndicator crypto/internal/fips140.setIndicator"} setIndicator [uint8])

(go/const
  ^{:line 26} [^{:tag uint8 :val 0} indicatorUnset iota]
  ^{:line 27} [^{:val 1} indicatorFalse]
  ^{:line 28} [^{:val 2} indicatorTrue])



^{:go/end 34} (go/func ResetServiceIndicator "ResetServiceIndicator clears the service indicator for the running goroutine.\n" []
  (setIndicator indicatorUnset))







^{:go/end 43} (go/func ServiceIndicator "ServiceIndicator returns true if and only if all services invoked by this\ngoroutine since the last ResetServiceIndicator call are approved.\n\nIf ResetServiceIndicator was not called before by this goroutine, its return\nvalue is undefined.\n" ^bool []
  (== (getIndicator) indicatorTrue))









^{:go/end 56} (go/func RecordApproved "RecordApproved is an internal function that records the use of an approved\nservice. It does not override RecordNonApproved calls in the same span.\n\nIt should be called by exposed functions that perform a whole cryptographic\nalrgorithm (e.g. by Sum, not by New, unless a cryptographic Instantiate\nalgorithm is performed) and should be called after any checks that may cause\nthe function to error out or panic.\n" []
  (when (== (getIndicator) indicatorUnset)
    (setIndicator indicatorTrue)))





^{:go/end 62} (go/func RecordNonApproved "RecordNonApproved is an internal function that records the use of a\nnon-approved service. It overrides any RecordApproved calls in the same span.\n" []
  (setIndicator indicatorFalse))

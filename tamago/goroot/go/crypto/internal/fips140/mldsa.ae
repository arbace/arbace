(ns go.crypto.internal.fips140.mldsa
  (:require [arbace.go :as go]))

(go/package mldsa
  :path "crypto/internal/fips140/mldsa"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["cast.go" "field.go" "mldsa.go" "semiexpanded.go"]
  :init-order [errUnreducedFieldElement zetas params44 params65 params87 errInvalidSeedLength errInvalidPublicKeyLength errContextTooLong errMessageHashLength errRandomLength errInvalidSignatureLength errInvalidSignatureCoeffBounds errInvalidSignatureChallenge errInvalidSignatureHintLimits errInvalidSignatureHintIndexOrder errInvalidSignatureHintExtraIndices fipsSelfTest]
  :positions :lines)

(load "mldsa/cast")
(load "mldsa/field")
(load "mldsa/mldsa")
(load "mldsa/semiexpanded")

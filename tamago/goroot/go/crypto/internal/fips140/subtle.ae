(ns go.crypto.internal.fips140.subtle
  (:require [arbace.go :as go]))

(go/package subtle
  :path "crypto/internal/fips140/subtle"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["constant_time.go" "xor.go" "xor_asm.go"]
  :other-files ["xor_amd64.s"]
  :init-order []
  :positions :lines)

(load "subtle/constant_time")
(load "subtle/xor")
(load "subtle/xor_asm")

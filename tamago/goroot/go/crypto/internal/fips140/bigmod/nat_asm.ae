(in-ns 'go.crypto.internal.fips140.bigmod) (go/file "nat_asm.go" :build ["//go:build !purego && (386 || amd64 || arm || arm64 || loong64 || ppc64 || ppc64le || riscv64 || s390x)"] :imports [


    ^{:line 10} [cpu "crypto/internal/fips140deps/cpu"]
    ^{:line 11} [impl "crypto/internal/impl"]])


;; amd64 assembly uses ADCX/ADOX/MULX if ADX is available to run two carry
;; chains in the flags in parallel across the whole operation, and aggressively
;; unrolls loops. arm64 processes four words at a time.
;;
;; It's unclear why the assembly for all other architectures, as well as for
;; amd64 without ADX, perform better than the compiler output.
;; TODO(filippo): file cmd/compile performance issue.

(go/var supportADX (and cpu/X86HasADX cpu/X86HasBMI2))

^{:go/end 28} (go/func init []
  (when cpu/AMD64
    (impl/Register "aes" "ADX" (addr supportADX))))




(go/func ^:extern ^:go/noescape addMulVVW1024 [^{:tag (* uint)} z ^{:tag (* uint)} x ^uint y] :results [^uint c])


(go/func ^:extern ^:go/noescape addMulVVW1536 [^{:tag (* uint)} z ^{:tag (* uint)} x ^uint y] :results [^uint c])


(go/func ^:extern ^:go/noescape addMulVVW2048 [^{:tag (* uint)} z ^{:tag (* uint)} x ^uint y] :results [^uint c])

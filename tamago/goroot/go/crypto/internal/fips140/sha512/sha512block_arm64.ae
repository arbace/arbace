(in-ns 'go.crypto.internal.fips140.sha512) (go/file "sha512block_arm64.go" :build ["//go:build !purego"] :imports [


    ^{:line 10} [cpu "crypto/internal/fips140deps/cpu"]
    ^{:line 11} [impl "crypto/internal/impl"]])


(go/var useSHA512 cpu/ARM64HasSHA512)

^{:go/end 18} (go/func init []
  (impl/Register "sha512" "Armv8.2" (addr useSHA512)))



(go/func ^:extern ^:go/noescape blockSHA512 [^{:tag (* Digest)} dig ^{:tag (slice byte)} p])

^{:go/end 29} (go/func block [^{:tag (* Digest)} dig ^{:tag (slice byte)} p]

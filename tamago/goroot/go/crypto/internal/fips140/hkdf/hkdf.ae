(in-ns 'go.crypto.internal.fips140.hkdf) (go/file "hkdf.go" :imports [


    ^{:line 8} [fips140 "crypto/internal/fips140"]
    ^{:line 9} [hmac "crypto/internal/fips140/hmac"]
    ^{:line 10} [hash "hash"]])


^{:go/end 25} (go/func Extract :type-params [^hash/Hash H] ^{:tag (slice byte)} [^{:tag (func [] [H])} h ^{:tag (slice byte)} secret ^:go/grouped ^{:tag (slice byte)} salt]
  (when (< (len secret) (/ 112 8))
    (fips140/RecordNonApproved))

  (when (== salt nil)
    (set! salt (make (slice byte) (.Size (h)))))

  (let [extractor (^{:inst [H]} hmac/New h salt)]
    (hmac/MarkAsUsedInKDF extractor)
    (.Write extractor secret)

    (.Sum extractor nil)))


^{:go/end 52} (go/func Expand :type-params [^hash/Hash H] ^{:tag (slice byte)} [^{:tag (func [] [H])} h ^{:tag (slice byte)} pseudorandomKey ^string info ^int keyLen]
  (let [out (make (slice byte) 0 keyLen)
      ^{:line 29} expander (^{:inst [H]} hmac/New h pseudorandomKey)]
    (hmac/MarkAsUsedInKDF expander)
    (let [^uint8 counter (zero uint8)
        ^{:line 32 :tag (slice byte)} buf (zero (slice byte))]

      (while (< (len out) keyLen)
        (inc! counter)
        (when (== counter 0)
          (panic "hkdf: counter overflow"))

        (when (> counter 1)
          (.Reset expander))

        (.Write expander buf)
        (.Write expander (conv (slice byte) info))
        (.Write expander (lit (slice byte) counter))
        (set! buf (.Sum expander (subslice buf _ 0)))
        (let [remain (- keyLen (len out))]
          (set! remain (min remain (len buf)))
          (set! out (append out (spread (subslice buf _ remain))))))


      ^{:line 51} out)))


^{:go/end 57} (go/func Key :type-params [^hash/Hash H] ^{:tag (slice byte)} [^{:tag (func [] [H])} h ^{:tag (slice byte)} secret ^:go/grouped ^{:tag (slice byte)} salt ^string info ^int keyLen]
  (let [prk (^{:inst [H]} Extract h secret salt)]
    (^{:inst [H]} Expand h prk info keyLen)))

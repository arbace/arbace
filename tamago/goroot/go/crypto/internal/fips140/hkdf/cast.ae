(in-ns 'go.crypto.internal.fips140.hkdf) (go/file "cast.go" :imports [


    ^{:line 8} [bytes "bytes"]
    ^{:line 9} [fips140 "crypto/internal/fips140"]
    ^{:line 10} [_ "crypto/internal/fips140/check"]
    ^{:line 11} [sha256 "crypto/internal/fips140/sha256"]
    ^{:line 12} [errors "errors"]])


^{:go/end 33} (go/func init []
  (fips140/CAST "HKDF-SHA2-256" ^{:go/end 32} (fn ^error []
      ^{:go/breaks [[3 31]]} (let [input ^{:go/breaks [2 10]} (lit (slice byte)
            0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08
            0x09 0x0a 0x0b 0x0c 0x0d 0x0e 0x0f 0x10)

          ^{:line 21} want ^{:go/breaks [2 10 18 26]} (lit (slice byte)
            0xb6 0x53 0x00 0x5b 0x51 0x6d 0x2b 0xc9
            0x4a 0xe4 0xf9 0x51 0x73 0x1f 0x71 0x21
            0xa6 0xc1 0xde 0x42 0x4f 0x2c 0x99 0x60
            0x64 0xdb 0x66 0x3e 0xec 0xa6 0x37 0xff)

          ^{:line 27} got (^{:inst [(* sha256/Digest)]} Key sha256/New input input (conv string input) (len want))]
        (when (not (bytes/Equal got want))
          (return (errors/New "unexpected result")))

        nil))))

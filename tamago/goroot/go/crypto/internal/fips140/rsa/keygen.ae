(go/type millerRabin (struct
    ^{:line 358 :tag (* bigmod/Modulus)} w
    ^{:line 359 :tag (slice byte)} m))






^{:go/end 391} (go/func millerRabinSetup "millerRabinSetup prepares state that's reused across multiple iterations of\nthe Miller-Rabin test.\n\nw must be a random integer equal to 3 mod 4 in big-endian order.\n" [^{:tag (slice byte)} w] :results [(* millerRabin) error]
  (let [mr (addr (lit millerRabin))]

    ;; Check that w is 3 mod 4, and precompute Montgomery parameters.
    (when (or (== (len w) 0) (!= (bit-and (aget w (- (len w) 1)) 2r11) 2r11))
      (return nil (errors/New "candidate is not 3 mod 4")))

    (let [(values wm err) (bigmod/NewModulus w)]
      (when (!= err nil)
        (return nil err))

      (set! (.-w mr) wm)

      ;; Compute m = (w-1)/2^a, where m is odd.
      ;; Since w is 3 mod 4, a is always 1, so m = (w-1)/2.
      (let [m (.ShiftRightByOne (.SubOne (.Nat (.-w mr)) (.-w mr)))]

        ;; Store mr.m as a big-endian byte slice with leading zero bytes removed,
        ;; for use with [bigmod.Nat.Exp].
        (set! (.-m mr) (.Bytes m (.-w mr)))
        (while (== (aget (.-m mr) 0) 0)
          (set! (.-m mr) (subslice (.-m mr) 1)))


        (return mr nil)))))


(go/const ^{:val false} millerRabinCOMPOSITE false)
(go/const ^{:val true} millerRabinPOSSIBLYPRIME true)

^{:go/end 421} (go/func millerRabinIteration [^{:tag (* millerRabin)} mr ^{:tag (slice byte)} bb] :results [bool error]
  ;; Reject b ≤ 1 or b ≥ w − 1.
  (when (!= (len bb) (/ (+ (.BitLen (.-w mr)) 7) 8))
    (return false (errors/New "incorrect length")))

  (let [b (bigmod/NewNat)]
    (when [(values _ err) (.SetBytes b bb (.-w mr))] (!= err nil)
      (return false err))

    (when (or (== (.IsZero b) 1) (== (.IsOne b) 1) (== (.IsMinusOne b (.-w mr)) 1))
      (return false (errors/New "out-of-range candidate")))


    ;; Compute b^(m*2^i) mod w for successive i.
    ;; If b^m mod w = 1, b is a possible prime.
    ;; If b^(m*2^i) mod w = -1 for some 0 <= i < a, b is a possible prime.
    ;; Otherwise b is composite.

    ;; Since a = 1 for our w, we only need to check b^m mod w = +/-1.
    (let [z (.Exp (bigmod/NewNat) b (.-m mr) (.-w mr))]
      (when (or (== (.IsOne z) 1) (== (.IsMinusOne z (.-w mr)) 1))
        (return millerRabinPOSSIBLYPRIME nil))


      (return millerRabinCOMPOSITE nil))))

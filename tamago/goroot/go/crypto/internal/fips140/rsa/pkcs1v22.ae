      (set! (aget db 0) bit-and ^byte (>> 0xff (- (* 8 emLen) emBits)))

      ;; 12. Let EM = maskedDB || H || 0xbc.
      (aset em (- emLen 1) 0xbc)

      ;; 13. Output EM.
      (return em nil))))


(go/const ^{:val -1} pssSaltLengthAutodetect -1)

^{:go/end 251} (go/func emsaPSSVerify ^error [^{:tag (slice byte)} mHash ^{:tag (slice byte)} em ^int emBits ^int sLen ^hash/Hash hash]
  ;; See RFC 8017, Section 9.1.2.


;; Per RFC 8017, Section 9.1
;;
;;     EM = MGF1 xor DB || H( 8*0x00 || mHash || salt ) || 0xbc
;;
;; where
;;
;;     DB = PS || 0x01 || salt
;;
;; and PS can be empty so
;;
;;     emLen = dbLen + hLen + 1 = psLen + sLen + hLen + 2
;;


^{:go/end 49} (go/func incCounter "incCounter increments a four byte, big-endian counter.\n" [^{:tag (* (array 4 byte))} c]
  (when [(inc! (aget c 3))] (!= (aget c 3) 0)
    (return))

  (when [(inc! (aget c 2))] (!= (aget c 2) 0)
    (return))

  (when [(inc! (aget c 1))] (!= (aget c 1) 0)
    (return))

  (inc! (aget c 0)))




^{:go/end 70} (go/func mgf1XOR "mgf1XOR XORs the bytes in out with a mask generated using the MGF1 function\nspecified in PKCS #1 v2.1.\n" [^{:tag (slice byte)} out ^hash/Hash hash ^{:tag (slice byte)} seed]
  (let [^{:tag (array 4 byte)} counter (zero (array 4 byte))
      ^{:line 55 :tag (slice byte)} digest (zero (slice byte))

      ^{:line 57} done 0]
    (while (< done (len out))
      (.Reset hash)
      (.Write hash seed)
      (.Write hash (subslice counter 0 4))
      (set! digest (.Sum hash (subslice digest _ 0)))

      (for [i 0] (and (< i (len digest)) (< done (len out))) (inc! i)
        (set! (aget out done) bit-xor (aget digest i))
        (inc! done))

      (incCounter (addr counter)))))



^{:go/end 145} (go/func emsaPSSEncode [^{:tag (slice byte)} mHash ^int emBits ^{:tag (slice byte)} salt ^hash/Hash hash] :results [(slice byte) error]
  ;; See RFC 8017, Section 9.1.1.


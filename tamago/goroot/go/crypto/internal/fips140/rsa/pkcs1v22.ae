        ^{:line 111 :tag (array 8 byte)} prefix (zero (array 8 byte))]

      (.Reset hash)
      (.Write hash (subslice prefix))
      (.Write hash mHash)
      (.Write hash salt)

      (set! h (.Sum hash (subslice h _ 0)))

      ;; 7.  Generate an octet string PS consisting of emLen - sLen - hLen - 2
      ;;     zero octets. The length of PS may be 0.

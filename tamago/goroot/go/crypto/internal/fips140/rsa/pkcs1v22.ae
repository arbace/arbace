^{:go/end 326} (go/func VerifyPSSWithSaltLength "VerifyPSSWithSaltLength verifies sig with RSASSA-PSS and an expected salt length.\n" ^error [^{:tag (* PublicKey)} pub ^hash/Hash hash ^{:tag (slice byte)} digest ^{:tag (slice byte)} sig ^int saltLength]

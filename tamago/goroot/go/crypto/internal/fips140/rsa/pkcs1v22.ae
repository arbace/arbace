^{:go/end 266} (go/func PSSMaxSaltLength "PSSMaxSaltLength returns the maximum salt length for a given public key and\nhash function.\n" [^{:tag (* PublicKey)} pub ^hash/Hash hash] :results [int error]
  (let [saltLength (- (/ (+ (- (.BitLen (.-N pub)) 1) 7) 8) 2 (.Size hash))]
    (when (< saltLength 0)
      (return 0 ErrMessageTooLong))

    ;; FIPS 186-5, Section 5.4(g): "the length (in bytes) of the salt (sLen)
    ;; shall satisfy 0 ≤ sLen ≤ hLen".
    (when (and fips140/Enabled (> saltLength (.Size hash)))
      (return (.Size hash) nil))

    (return saltLength nil)))



^{:go/end 313} (go/func SignPSS "SignPSS calculates the signature of hashed using RSASSA-PSS.\n" [^io/Reader rand ^{:tag (* PrivateKey)} priv ^hash/Hash hash ^{:tag (slice byte)} hashed ^int saltLength] :results [(slice byte) error]

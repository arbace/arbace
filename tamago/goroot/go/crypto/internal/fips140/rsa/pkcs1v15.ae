^{:go/end 55} (go/func SignPKCS1v15 "SignPKCS1v15 calculates an RSASSA-PKCS1-v1.5 signature.\n\nhash is the name of the hash function as returned by [crypto.Hash.String]\nor the empty string to indicate that the message is signed directly.\n" [^{:tag (* PrivateKey)} priv ^string hash ^{:tag (slice byte)} hashed] :results [(slice byte) error]
  (fipsSelfTest)
  (fips140/RecordApproved)
  (checkApprovedHashName hash)

  (signPKCS1v15 priv hash hashed))


^{:go/end 64} (go/func signPKCS1v15 [^{:tag (* PrivateKey)} priv ^string hash ^{:tag (slice byte)} hashed] :results [(slice byte) error]
  (let [(values em err) (pkcs1v15ConstructEM (addr (.-pub priv)) hash hashed)]
    (when (!= err nil)
      (return nil err))


    (decrypt priv em withCheck)))


^{:go/end 93} (go/func pkcs1v15ConstructEM [^{:tag (* PublicKey)} pub ^string hash ^{:tag (slice byte)} hashed] :results [(slice byte) error]
  ;; Special case: "" is used to indicate that the data is signed directly.
  (let [^{:tag (slice byte)} prefix (zero (slice byte))]
    (when (!= hash "")
      (let [^bool ok (zero bool)]
        (set! (values prefix ok) (aget hashPrefixes hash))
        (when (not ok)
          (return nil (errors/New "crypto/rsa: unsupported hash function")))

        (when (!= (len hashed) (hashSize hash))
          (return nil (errors/New "crypto/rsa: hashed message length does not match hash function")))))



    ;; EM = 0x00 || 0x01 || PS || 0x00 || T
    (let [k (.Size pub)]
      (when (< k (+ (len prefix) (len hashed) 2 8 1))
        (return nil ErrMessageTooLong))

      (let [em (make (slice byte) k)]
        (aset em 1 1)
        (for [i 2] (< i (- k (len prefix) (len hashed) 1)) (inc! i)
          (aset em i 0xff))

        (copy (subslice em (- k (len prefix) (len hashed))) prefix)
        (copy (subslice em (- k (len hashed))) hashed)
        (return em nil)))))






^{:go/end 105} (go/func VerifyPKCS1v15 "VerifyPKCS1v15 verifies an RSASSA-PKCS1-v1.5 signature.\n\nhash is the name of the hash function as returned by [crypto.Hash.String]\nor the empty string to indicate that the message is signed directly.\n" ^error [^{:tag (* PublicKey)} pub ^string hash ^{:tag (slice byte)} hashed ^{:tag (slice byte)} sig]
  (fipsSelfTest)
  (fips140/RecordApproved)
  (checkApprovedHashName hash)

  (verifyPKCS1v15 pub hash hashed sig))


^{:go/end 135} (go/func verifyPKCS1v15 ^error [^{:tag (* PublicKey)} pub ^string hash ^{:tag (slice byte)} hashed ^{:tag (slice byte)} sig]
  (if [(values fipsApproved err) (checkPublicKey pub)] (!= err nil)
    (return err)
    (when (not fipsApproved)
      (fips140/RecordNonApproved)))


  ;; RFC 8017 Section 8.2.2: If the length of the signature S is not k
  ;; octets (where k is the length in octets of the RSA modulus n), output
  ;; "invalid signature" and stop.
  (when (!= (.Size pub) (len sig))
    (return ErrVerification))


  (let [(values em err) (encrypt pub sig)]
    (when (!= err nil)
      (return ErrVerification))


    ^{:go/breaks [[4 134]]} (let [(values expected ^:assign err) (pkcs1v15ConstructEM pub hash hashed)]
      (when (!= err nil)
        (return ErrVerification))

      (when (not (bytes/Equal em expected))
        (return ErrVerification))


      nil)))


^{:go/end 156} (go/func hashSize ^int [^string hash]
  (switch hash
    (case ["MD5"]
      (return 16))
    (case ["SHA-1" "RIPEMD-160"]
      (return 20))
    (case ["SHA-224" "SHA-512/224" "SHA3-224"]
      (return 28))
    (case ["SHA-256" "SHA-512/256" "SHA3-256"]
      (return 32))
    (case ["SHA-384" "SHA3-384"]
      (return 48))
    (case ["SHA-512" "SHA3-512"]
      (return 64))
    (case ["MD5+SHA1"]
      (return 36))
    (default
      (return -1))))



^{:go/end 165} (go/func checkApprovedHashName [^string hash]
  (switch hash
    (case ^{:go/breaks [6]} ["SHA-224" "SHA-256" "SHA-384" "SHA-512" "SHA-512/224" "SHA-512/256"
        "SHA3-224" "SHA3-256" "SHA3-384" "SHA3-512"])
    (default
      (fips140/RecordNonApproved))))

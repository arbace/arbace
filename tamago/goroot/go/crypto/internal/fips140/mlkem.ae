(ns go.crypto.internal.fips140.mlkem
  (:require [arbace.go :as go]))

(go/package mlkem
  :path "crypto/internal/fips140/mlkem"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["cast.go" "field.go" "mlkem1024.go" "mlkem768.go"]
  :init-order [gammas zetas fipsSelfTest]
  :positions :lines)

(load "mlkem/cast")
(load "mlkem/field")
(load "mlkem/mlkem1024")
(load "mlkem/mlkem768")

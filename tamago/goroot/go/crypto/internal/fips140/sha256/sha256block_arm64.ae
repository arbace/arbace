(in-ns 'go.crypto.internal.fips140.sha256) (go/file "sha256block_arm64.go" :build ["//go:build !purego"] :imports [


    ^{:line 10} [cpu "crypto/internal/fips140deps/cpu"]
    ^{:line 11} [impl "crypto/internal/impl"]])


(go/var useSHA2 cpu/ARM64HasSHA2)

^{:go/end 18} (go/func init []
  (impl/Register "sha256" "Armv8.0" (addr useSHA2)))



(go/func ^:extern ^:go/noescape blockSHA2 [^{:tag (* Digest)} dig ^{:tag (slice byte)} p])

^{:go/end 29} (go/func block [^{:tag (* Digest)} dig ^{:tag (slice byte)} p]

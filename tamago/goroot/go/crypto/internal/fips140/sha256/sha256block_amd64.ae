(in-ns 'go.crypto.internal.fips140.sha256) (go/file "sha256block_amd64.go" :build ["//go:build !purego"] :imports [


    ^{:line 10} [cpu "crypto/internal/fips140deps/cpu"]
    ^{:line 11} [impl "crypto/internal/impl"]])


(go/var useAVX2 (and cpu/X86HasAVX cpu/X86HasAVX2 cpu/X86HasBMI2))
(go/var useSHANI (and cpu/X86HasAVX cpu/X86HasSHA cpu/X86HasSSE41 cpu/X86HasSSSE3))

^{:go/end 20} (go/func init []
  (impl/Register "sha256" "AVX2" (addr useAVX2))
  (impl/Register "sha256" "SHA-NI" (addr useSHANI)))



(go/func ^:extern ^:go/noescape blockAVX2 [^{:tag (* Digest)} dig ^{:tag (slice byte)} p])


(go/func ^:extern ^:go/noescape blockSHANI [^{:tag (* Digest)} dig ^{:tag (slice byte)} p])

^{:go/end 36} (go/func block [^{:tag (* Digest)} dig ^{:tag (slice byte)} p]
  (cond useSHANI
    (blockSHANI dig p)
    ^{:line 31} useAVX2
    (blockAVX2 dig p) :else

    (blockGeneric dig p)))

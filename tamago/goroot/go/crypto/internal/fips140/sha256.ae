(ns go.crypto.internal.fips140.sha256
  (:require [arbace.go :as go]))

(go/package sha256
  :path "crypto/internal/fips140/sha256"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["cast.go" "sha256.go" "sha256block.go" "sha256block_amd64.go"]
  :other-files ["sha256block_amd64.s"]
  :init-order [_K useAVX2 useSHANI]
  :positions :lines)

(load "sha256/cast")
(load "sha256/sha256")
(load "sha256/sha256block")
(load "sha256/sha256block_amd64")

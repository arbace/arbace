(ns go.crypto.internal.fips140.sha256
  (:require [arbace.go :as go]))

(go/package sha256
  :path "crypto/internal/fips140/sha256"
  :files ["cast.go" "sha256.go" "sha256block.go" "sha256block_amd64.go" "sha256block_arm64.go"]
  :other-files ["sha256block_amd64.s" "sha256block_arm64.s"]
  :positions :lines)

(load "sha256/cast")
(load "sha256/sha256")
(load "sha256/sha256block")
(load "sha256/sha256block_amd64")
(load "sha256/sha256block_arm64")

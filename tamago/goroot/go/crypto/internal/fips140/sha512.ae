(ns go.crypto.internal.fips140.sha512
  (:require [arbace.go :as go]))

(go/package sha512
  :path "crypto/internal/fips140/sha512"
  :files ["cast.go" "sha512.go" "sha512block.go" "sha512block_amd64.go" "sha512block_arm64.go"]
  :other-files ["sha512block_amd64.s" "sha512block_arm64.s"]
  :positions :lines)

(load "sha512/cast")
(load "sha512/sha512")
(load "sha512/sha512block")
(load "sha512/sha512block_amd64")
(load "sha512/sha512block_arm64")

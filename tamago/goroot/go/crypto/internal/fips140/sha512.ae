(ns go.crypto.internal.fips140.sha512
  (:require [arbace.go :as go]))

(go/package sha512
  :path "crypto/internal/fips140/sha512"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["cast.go" "sha512.go" "sha512block.go" "sha512block_amd64.go"]
  :other-files ["sha512block_amd64.s"]
  :init-order [_K useAVX2]
  :positions :lines)

(load "sha512/cast")
(load "sha512/sha512")
(load "sha512/sha512block")
(load "sha512/sha512block_amd64")

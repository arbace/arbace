(ns go.crypto.internal.fips140.aes
  (:require [arbace.go :as go]))

(go/package aes
  :path "crypto/internal/fips140/aes"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["aes.go" "aes_asm.go" "aes_generic.go" "cast.go" "cbc.go" "cbc_noasm.go" "const.go" "ctr.go" "ctr_asm.go"]
  :other-files ["aes_amd64.s" "ctr_amd64.s"]
  :init-order [supportsAES powx sbox0 sbox1 te0 te1 te2 te3 td0 td1 td2 td3]
  :positions :lines)

(load "aes/aes")
(load "aes/aes_asm")
(load "aes/aes_generic")
(load "aes/cast")
(load "aes/cbc")
(load "aes/cbc_noasm")
(load "aes/const")
(load "aes/ctr")
(load "aes/ctr_asm")

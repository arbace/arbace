^{:go/end 187} (go/func GenerateKey "GenerateKey generates a new ECDSA private key pair for the specified curve.\n" :type-params [^{:tag (Point P)} P] [^{:tag (* (Curve P))} c ^io/Reader rand] :results [(* PrivateKey) error]
  (fips140/RecordApproved)
  ;; This procedure is equivalent to Key Pair Generation by Testing
  ;; Candidates, specified in NIST SP 800-56A Rev. 3, Section 5.6.1.2.2.

  (while true
    (let [key (make (slice byte) (len (.-N c)))]
      (when [err (drbg/ReadWithReader rand key)] (!= err nil)
        (return nil err))

      ;; In tests, rand will return all zeros and NewPrivateKey will reject
      ;; the zero key as it generates the identity as a public key. This also
      ;; makes this function consistent with crypto/elliptic.GenerateKey.
      (set! (aget key 1) bit-xor 0x42)

      ;; Mask off any excess bits if the size of the underlying field is not a
      ;; whole number of bytes, which is only the case for P-521.
      (when (and (== (.-curve c) p521) (== (bit-and (aget (.-N c) 0) 2r11111110) 0))
        (set! (aget key 0) bit-and 2r00000001))


      (let [(values privateKey err) (^{:inst [P]} NewPrivateKey c key)]
        (when (!= err nil)
          (continue))


        ;; A "Pairwise Consistency Test" makes no sense if we just generated the
        ;; public key from an ephemeral private key. Moreover, there is no way to
        ;; check it aside from redoing the exact same computation again. SP 800-56A
        ;; Rev. 3, Section 5.6.2.1.4 acknowledges that, and doesn't require it.
        ;; However, ISO 19790:2012, Section 7.10.3.3 has a blanket requirement for a
        ;; PCT for all generated keys (AS10.35) and FIPS 140-3 IG 10.3.A, Additional
        ;; Comment 1 goes out of its way to say that "the PCT shall be performed
        ;; consistent [...], even if the underlying standard does not require a
        ;; PCT". So we do it. And make ECDH nearly 50% slower (only) in FIPS mode.
        (fips140/PCT "ECDH PCT" ^{:go/end 183} (fn ^error []
            ^{:go/breaks [[4 182]]} (let [(values p1 err) (.ScalarBaseMult ((.-newPoint c)) (.-d privateKey))]
              (when (!= err nil)
                (return err))

              (when (not (bytes/Equal (.Bytes p1) (.-q (.-pub privateKey))))
                (return (errors/New "crypto/ecdh: public key does not match private key")))

              nil)))


        (return privateKey nil)))))



^{:go/end 214} (go/func NewPrivateKey :type-params [^{:tag (Point P)} P] [^{:tag (* (Curve P))} c ^{:tag (slice byte)} key] :results [(* PrivateKey) error]
  ;; SP 800-56A Rev. 3, Section 5.6.1.2.2 checks that c <= n – 2 and then
  ;; returns d = c + 1. Note that it follows that 0 < d < n. Equivalently,
  ;; we check that 0 < d < n, and return d.
  (when (or (!= (len key) (len (.-N c))) (isZero key) (not (isLess key (.-N c))))
    (return nil (errors/New "crypto/ecdh: invalid private key")))


  (let [(values p err) (.ScalarBaseMult ((.-newPoint c)) key)]
    (when (!= err nil)
      ;; This is unreachable because the only error condition of
      ;; ScalarBaseMult is if the input is not the right size.
      (panic "crypto/ecdh: internal error: nistec ScalarBaseMult failed for a fixed-size input"))


    (let [publicKey (.Bytes p)]
      (when (== (len publicKey) 1)
        ;; The encoding of the identity is a single 0x00 byte. This is
        ;; unreachable because the only scalar that generates the identity is
        ;; zero, which is rejected above.
        (panic "crypto/ecdh: internal error: public key is the identity element"))


      (let [k (addr (lit PrivateKey :d (bytes/Clone key) :pub (lit PublicKey :curve (.-curve c) :q publicKey)))]
        (return k nil)))))


^{:go/end 231} (go/func NewPublicKey :type-params [^{:tag (Point P)} P] [^{:tag (* (Curve P))} c ^{:tag (slice byte)} key] :results [(* PublicKey) error]
  ;; Reject the point at infinity and compressed encodings.
  (when (or (== (len key) 0) (!= (aget key 0) 4))
    (return nil (errors/New "crypto/ecdh: invalid public key")))


  ;; SetBytes checks that x and y are in the interval [0, p - 1], and that
  ;; the point is on the curve. Along with the rejection of the point at
  ;; infinity (the identity element) above, this fulfills the requirements
  ;; of NIST SP 800-56A Rev. 3, Section 5.6.2.3.4.
  (when [(values _ err) (.SetBytes ((.-newPoint c)) key)] (!= err nil)
    (return nil err))


  (return (addr (lit PublicKey :curve (.-curve c) :q (bytes/Clone key))) nil))


^{:go/end 237} (go/func ECDH :type-params [^{:tag (Point P)} P] [^{:tag (* (Curve P))} c ^{:tag (* PrivateKey)} k ^{:tag (* PublicKey)} peer] :results [(slice byte) error]
  (fipsSelfTest)
  (fips140/RecordApproved)
  (^{:inst [P]} ecdh c k peer))


^{:go/end 270} (go/func ecdh :type-params [^{:tag (Point P)} P] [^{:tag (* (Curve P))} c ^{:tag (* PrivateKey)} k ^{:tag (* PublicKey)} peer] :results [(slice byte) error]
  (when (!= (.-curve c) (.-curve (.-pub k)))
    (return nil (errors/New "crypto/ecdh: mismatched curves")))

  (when (!= (.-curve (.-pub k)) (.-curve peer))
    (return nil (errors/New "crypto/ecdh: mismatched curves")))


  ;; This applies the Shared Secret Computation of the Ephemeral Unified Model
  ;; scheme specified in NIST SP 800-56A Rev. 3, Section 6.1.2.2.

  ;; Per Section 5.6.2.3.4, Step 1, reject the identity element (0x00).
  (when (== (len (.-q (.-pub k))) 1)
    (return nil (errors/New "crypto/ecdh: public key is the identity element")))


  ;; SetBytes checks that (x, y) are reduced modulo p, and that they are on
  ;; the curve, performing Steps 2-3 of Section 5.6.2.3.4.
  (let [(values p err) (.SetBytes ((.-newPoint c)) (.-q peer))]
    (when (!= err nil)
      (return nil err))


    ;; Compute P according to Section 5.7.1.2.
    (when [(values _ err) (.ScalarMult p p (.-d k))] (!= err nil)
      (return nil err))


    ;; BytesX checks that the result is not the identity element, and returns the
    ;; x-coordinate of the result, performing Steps 2-5 of Section 5.7.1.2.
    (.BytesX p)))



^{:go/end 279} (go/func isZero "isZero reports whether x is all zeroes in constant time.\n" ^bool [^{:tag (slice byte)} x]
  (let [^byte acc (zero byte)]
    (range [_ b x]
      (set! acc bit-or b))

    (== acc 0)))




^{:go/end 308} (go/func isLess "isLess reports whether a < b, where a and b are big-endian buffers of the\nsame length and shorter than 72 bytes.\n" ^bool [^{:tag (slice byte)} a ^{:tag (slice byte)} b]
  (when (!= (len a) (len b))
    (panic "crypto/ecdh: internal error: mismatched isLess inputs"))


  ;; Copy the values into a fixed-size preallocated little-endian buffer.
  ;; 72 bytes is enough for every scalar in this package, and having a fixed
  ;; size lets us avoid heap allocations.
  (when (> (len a) 72)
    (panic "crypto/ecdh: internal error: isLess input too large"))

  (let [(values bufA bufB) (values (make (slice byte) 72) (make (slice byte) 72))]
    (range [i a]
      (set! (values (aget bufA i) (aget bufB i)) (values (aget a (- (len a) i 1)) (aget b (- (len b) i 1)))))


    ;; Perform a subtraction with borrow.
    (let [^uint64 borrow (zero uint64)]
      (for [i 0] (< i (len bufA)) (set! i + 8)
        (let [(values limbA limbB) (values (byteorder/LEUint64 (subslice bufA i)) (byteorder/LEUint64 (subslice bufB i)))]
          (set! (values _ borrow) (bits/Sub64 limbA limbB borrow))))


      ;; If there is a borrow at the end of the operation, then a < b.
      (== borrow 1))))

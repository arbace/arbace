  (let [^uint64 x1 (zero uint64)]
    (p256CmovznzU64 (addr x1) arg1 (aget arg2 0) (aget arg3 0))
    (let [^uint64 x2 (zero uint64)]
      (p256CmovznzU64 (addr x2) arg1 (aget arg2 1) (aget arg3 1))
      (let [^uint64 x3 (zero uint64)]
        (p256CmovznzU64 (addr x3) arg1 (aget arg2 2) (aget arg3 2))
        (let [^uint64 x4 (zero uint64)]
          (p256CmovznzU64 (addr x4) arg1 (aget arg2 3) (aget arg3 3))
          (aset out1 0 x1)
          (aset out1 1 x2)
          (aset out1 2 x3)
          (aset out1 3 x4))))))




















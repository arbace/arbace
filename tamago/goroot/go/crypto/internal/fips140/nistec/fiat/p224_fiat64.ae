^{:go/end 1284} (go/func p224Selectznz "p224Selectznz is a multi-limb conditional select.\n\nPostconditions:\n\n\teval out1 = (if arg1 = 0 then eval arg2 else eval arg3)\n\nInput Bounds:\n\n\targ1: [0x0 ~> 0x1]\n\targ2: [[0x0 ~> 0xffffffffffffffff], [0x0 ~> 0xffffffffffffffff], [0x0 ~> 0xffffffffffffffff], [0x0 ~> 0xffffffffffffffff]]\n\targ3: [[0x0 ~> 0xffffffffffffffff], [0x0 ~> 0xffffffffffffffff], [0x0 ~> 0xffffffffffffffff], [0x0 ~> 0xffffffffffffffff]]\n\nOutput Bounds:\n\n\tout1: [[0x0 ~> 0xffffffffffffffff], [0x0 ~> 0xffffffffffffffff], [0x0 ~> 0xffffffffffffffff], [0x0 ~> 0xffffffffffffffff]]\n" [^{:tag (* (array 4 uint64))} out1 ^p224Uint1 arg1 ^{:tag (* (array 4 uint64))} arg2 ^{:tag (* (array 4 uint64))} arg3]
  (let [^uint64 x1 (zero uint64)]
    (p224CmovznzU64 (addr x1) arg1 (aget arg2 0) (aget arg3 0))
    (let [^uint64 x2 (zero uint64)]
      (p224CmovznzU64 (addr x2) arg1 (aget arg2 1) (aget arg3 1))
      (let [^uint64 x3 (zero uint64)]
        (p224CmovznzU64 (addr x3) arg1 (aget arg2 2) (aget arg3 2))
        (let [^uint64 x4 (zero uint64)]
          (p224CmovznzU64 (addr x4) arg1 (aget arg2 3) (aget arg3 3))
          (aset out1 0 x1)
          (aset out1 1 x2)
          (aset out1 2 x3)
          (aset out1 3 x4))))))




















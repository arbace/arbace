(in-ns 'go.crypto.internal.fips140.nistec) (go/file "p224_sqrt.go" :imports [


    ^{:line 8} [fiat "crypto/internal/fips140/nistec/fiat"]
    ^{:line 9} [sync "sync"]])


(go/var ^{:tag (* (array 96 fiat/P224Element))} p224GG)
(go/var ^sync/Once p224GGOnce)


^{:go/end 132} (go/func p224SqrtCandidate "p224SqrtCandidate sets r to a square root candidate for x. r and x must not overlap.\n" [^{:tag (* fiat/P224Element)} r ^{:tag (* fiat/P224Element)} x]
  ;; Since p = 1 mod 4, we can't use the exponentiation by (p + 1) / 4 like
  ;; for the other primes. Instead, implement a variation of Tonelli–Shanks.
  ;; The constant-time implementation is adapted from Thomas Pornin's ecGFp5.
  ;;
  ;; https://github.com/pornin/ecgfp5/blob/82325b965/rust/src/field.rs#L337-L385

  ;; p = q*2^n + 1 with q odd -> q = 2^128 - 1 and n = 96
  ;; g^(2^n) = 1 -> g = 11 ^ q (where 11 is the smallest non-square)
  ;; GG[j] = g^(2^j) for j = 0 to n-1

  (.Do p224GGOnce ^{:go/end 39} (fn []
      (set! p224GG (new (array 96 fiat/P224Element)))
      (range [i p224GG]
        (if (== i 0)
          (.SetBytes (aget p224GG i) ^{:go/breaks [6 14 22]} (lit (slice byte) 0x6a 0x0f 0xec 0x67
              0x85 0x98 0xa7 0x92 0x0c 0x55 0xb2 0xd4
              0x0b 0x2d 0x6f 0xfb 0xbe 0xa3 0xd8 0xce
              0xf3 0xfb 0x36 0x32 0xdc 0x69 0x1b 0x74))

          (.Square (aget p224GG i) (addr (aget p224GG (- i 1))))))))




  ;; r <- x^((q+1)/2) = x^(2^127)
  ;; v <- x^q = x^(2^128-1)

  ;; Compute x^(2^127-1) first.
  ;;
  ;; The sequence of 10 multiplications and 126 squarings is derived from the
  ;; following addition chain generated with github.com/mmcloughlin/addchain v0.4.0.
  ;;
  ;;	_10      = 2*1
  ;;	_11      = 1 + _10
  ;;	_110     = 2*_11
  ;;	_111     = 1 + _110
  ;;	_111000  = _111 << 3
  ;;	_111111  = _111 + _111000
  ;;	_1111110 = 2*_111111
  ;;	_1111111 = 1 + _1111110
  ;;	x12      = _1111110 << 5 + _111111
  ;;	x24      = x12 << 12 + x12
  ;;	i36      = x24 << 7
  ;;	x31      = _1111111 + i36
  ;;	x48      = i36 << 17 + x24
  ;;	x96      = x48 << 48 + x48
  ;;	return     x96 << 31 + x31
  ;;
  (let [^:var t0 (new fiat/P224Element)
      ^:var ^{:line 66} t1 (new fiat/P224Element)]

    (.Square r x)
    (.Mul r x r)
    (.Square r r)
    (.Mul r x r)
    (.Square t0 r)
    (for [s 1] (< s 3) (inc! s)
      (.Square t0 t0))

    (.Mul t0 r t0)
    (.Square t1 t0)
    (.Mul r x t1)
    (for [s 0] (< s 5) (inc! s)
      (.Square t1 t1))

    (.Mul t0 t0 t1)
    (.Square t1 t0)
    (for [s 1] (< s 12) (inc! s)
      (.Square t1 t1))

    (.Mul t0 t0 t1)
    (.Square t1 t0)
    (for [s 1] (< s 7) (inc! s)
      (.Square t1 t1))

    (.Mul r r t1)
    (for [s 0] (< s 17) (inc! s)
      (.Square t1 t1))

    (.Mul t0 t0 t1)
    (.Square t1 t0)
    (for [s 1] (< s 48) (inc! s)
      (.Square t1 t1))

    (.Mul t0 t0 t1)
    (for [s 0] (< s 31) (inc! s)
      (.Square t0 t0))

    (.Mul r r t0)

    ;; v = x^(2^127-1)^2 * x
    (let [v (.Square (new fiat/P224Element) r)]
      (.Mul v v x)

      ;; r = x^(2^127-1) * x
      (.Mul r r x)

      ;; for i = n-1 down to 1:
      ;;     w = v^(2^(i-1))
      ;;     if w == -1 then:
      ;;         v <- v*GG[n-i]
      ;;         r <- r*GG[n-i-1]

      (let [^:var p224MinusOne (.Sub (new fiat/P224Element)
            (new fiat/P224Element) (.One (new fiat/P224Element)))]

        (for [i (- 96 1)] (>= i 1) (dec! i)
          (let [w (.Set (new fiat/P224Element) v)]
            (for [j 0] (< j (- i 1)) (inc! j)
              (.Square w w))

            (let [cond (.Equal w p224MinusOne)]
              (.Select v (.Mul t0 v (addr (aget p224GG (- 96 i)))) v cond)
              (.Select r (.Mul t0 r (addr (aget p224GG (- 96 i 1)))) r cond))))))))

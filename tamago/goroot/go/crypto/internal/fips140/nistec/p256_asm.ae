          (p256Mul (addr (.-x r)) (addr (.-x r)) (addr rr))
          (p256Mul (addr (.-y r)) (addr (.-y r)) (addr rr))
          (when [err (p256CheckOnCurve (addr (.-x r)) (addr (.-y r)))] (!= err nil)

          (p256Mul (addr (.-x r)) (addr (.-x r)) (addr rr))

          ;; y² = x³ - 3x + b
          (p256Polynomial (addr (.-y r)) (addr (.-x r)))
          (when (not (p256Sqrt (addr (.-y r)) (addr (.-y r))))

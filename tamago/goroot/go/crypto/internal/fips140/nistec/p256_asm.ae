        0xfffffffffffffffe 0x00000004fffffffd)]

    (switch
      ;; Point at infinity.
      (case [(and (== (len b) 1) (== (aget b 0) 0))]
        (return (.Set p (NewP256Point)) nil))

      ;; Uncompressed form.
      (case [(and (== (len b) p256UncompressedLength) (== (aget b 0) 4))]
        (let [^P256Point r (zero P256Point)]
          (p256BigToLittle (addr (.-x r)) (conv (* (array 32 byte)) (subslice b 1 33)))

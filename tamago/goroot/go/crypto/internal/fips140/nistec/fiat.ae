(ns go.crypto.internal.fips140.nistec.fiat
  (:require [arbace.go :as go]))

(go/package fiat
  :path "crypto/internal/fips140/nistec/fiat"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["cast.go" "p224.go" "p224_fiat64.go" "p224_invert.go" "p256.go" "p256_fiat64.go" "p256_invert.go" "p384.go" "p384_fiat64.go" "p384_invert.go" "p521.go" "p521_fiat64.go" "p521_invert.go"]
  :init-order []
  :positions :lines)

(load "fiat/cast")
(load "fiat/p224")
(load "fiat/p224_fiat64")
(load "fiat/p224_invert")
(load "fiat/p256")
(load "fiat/p256_fiat64")
(load "fiat/p256_invert")
(load "fiat/p384")
(load "fiat/p384_fiat64")
(load "fiat/p384_invert")
(load "fiat/p521")
(load "fiat/p521_fiat64")
(load "fiat/p521_invert")

(ns go.crypto.internal.fips140.nistec
  (:require [arbace.go :as go]))

(go/package nistec
  :path "crypto/internal/fips140/nistec"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["nistec.go" "p224.go" "p224_sqrt.go" "p256_asm.go" "p256_ordinv.go" "p256_table.go" "p384.go" "p521.go"]
  :other-files ["p256_asm_amd64.s"]
  :init-order [p256One p256Zero p256P p256PrecomputedEmbed]
  :positions :lines)

(load "nistec/nistec")
(load "nistec/p224")
(load "nistec/p224_sqrt")
(load "nistec/p256_asm")
(load "nistec/p256_ordinv")
(load "nistec/p256_table")
(load "nistec/p384")
(load "nistec/p521")

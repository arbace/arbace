^{:go/end 181} (go/func NewPrivateKey "NewPrivateKey creates a new ECDSA private key from the given D and Q byte\nslices. D must be the fixed-length big-endian encoding of the private scalar,\nand Q must be the compressed or uncompressed encoding of the public point.\n" :type-params [^{:tag (Point P)} P] [^{:tag (* (Curve P))} c ^{:tag (slice byte)} D ^:go/grouped ^{:tag (slice byte)} Q] :results [(* PrivateKey) error]
  (fips140/RecordApproved)
  (let [(values pub err) (^{:inst [P]} NewPublicKey c Q)]
    (when (!= err nil)
      (return nil err))

    (when (!= (len D) (.Size (.-N c)))
      (return nil (errors/New "ecdsa: invalid private key length")))

    (let [(values d ^:assign err) (.SetBytes (bigmod/NewNat) D (.-N c))]
      (when (!= err nil)
        (return nil err))

      (when (== (.IsZero d) 1)
        (return nil (errors/New "ecdsa: private key is zero")))

      (let [priv (addr (lit PrivateKey :pub @pub :d (.Bytes d (.-N c))))]
        (return priv nil)))))




^{:go/end 197} (go/func NewPublicKey "NewPublicKey creates a new ECDSA public key from the given Q byte slice.\nQ must be the compressed or uncompressed encoding of the public point.\n" :type-params [^{:tag (Point P)} P] [^{:tag (* (Curve P))} c ^{:tag (slice byte)} Q] :results [(* PublicKey) error]
  ;; SetBytes checks that Q is a valid point on the curve, and that its
  ;; coordinates are reduced modulo p, fulfilling the requirements of SP
  ;; 800-89, Section 5.3.2.
  (when (or (< (len Q) 1) (== (aget Q 0) 0))
    (return nil (errors/New "ecdsa: invalid public key encoding")))

  (let [(values _ err) (.SetBytes ((.-newPoint c)) Q)]
    (when (!= err nil)
      (return nil err))

    (return (addr (lit PublicKey :curve (.-curve c) :q Q)) nil)))




(in-ns 'go.crypto.internal.fips140.ecdsa) (go/file "ecdsa_noasm.go" :build ["//go:build !s390x || purego"] :imports [])

^{:go/end 11} (go/func sign :type-params [^{:tag (Point P)} P] [^{:tag (* (Curve P))} c ^{:tag (* PrivateKey)} priv ^{:tag (* hmacDRBG)} drbg ^{:tag (slice byte)} hash] :results [(* Signature) error]
  (^{:inst [P]} signGeneric c priv drbg hash))


^{:go/end 15} (go/func verify :type-params [^{:tag (Point P)} P] ^error [^{:tag (* (Curve P))} c ^{:tag (* PublicKey)} pub ^{:tag (slice byte)} hash ^{:tag (* Signature)} sig]
  (^{:inst [P]} verifyGeneric c pub hash sig))

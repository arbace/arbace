^{:go/end 174} (go/method Exporter ^{:tag (slice byte)} [^{:tag (* ExporterMasterSecret)} s ^string label ^{:tag (slice byte)} context ^int length]
  (let [secret (^{:inst [hash/Hash]} deriveSecret (.-hash s) (.-secret s) label nil)
      ^{:line 171} h ((.-hash s))]

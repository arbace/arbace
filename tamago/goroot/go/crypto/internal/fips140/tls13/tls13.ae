;; Package tls13 implements the TLS 1.3 Key Schedule as specified in RFC 8446,
;; Section 7.1 and allowed by FIPS 140-3 IG 2.4.B Resolution 7.
(in-ns 'go.crypto.internal.fips140.tls13) (go/file "tls13.go" :doc "Package tls13 implements the TLS 1.3 Key Schedule as specified in RFC 8446,\nSection 7.1 and allowed by FIPS 140-3 IG 2.4.B Resolution 7.\n" :imports [


    ^{:line 10} [hkdf "crypto/internal/fips140/hkdf"]
    ^{:line 11} [byteorder "crypto/internal/fips140deps/byteorder"]
    ^{:line 12} [hash "hash"]])


;; We don't set the service indicator in this package but we delegate that to
;; the underlying functions because the TLS 1.3 KDF does not have a standard of
;; its own.


^{:go/end 40} (go/func ExpandLabel "ExpandLabel implements HKDF-Expand-Label from RFC 8446, Section 7.1.\n" :type-params [^hash/Hash H] ^{:tag (slice byte)} [^{:tag (func [] [H])} hash ^{:tag (slice byte)} secret ^string label ^{:tag (slice byte)} context ^int length]
  (when (or (> (+ (len "tls13 ") (len label)) 255) (> (len context) 255))
    ;; It should be impossible for this to panic: labels are fixed strings,
    ;; and context is either a fixed-length computed hash, or parsed from a
    ;; field which has the same length limitation.
    ;;
    ;; Another reasonable approach might be to return a randomized slice if
    ;; we encounter an error, which would break the connection, but avoid
    ;; panicking. This would perhaps be safer but significantly more
    ;; confusing to users.
    (panic "tls13: label or context too long"))

  (let [hkdfLabel (make (slice byte) 0 (+ 2 1 (len "tls13 ") (len label) 1 (len context)))]
    (set! hkdfLabel (byteorder/BEAppendUint16 hkdfLabel (conv uint16 length)))
    (set! hkdfLabel (append hkdfLabel (conv byte (+ (len "tls13 ") (len label)))))
    (set! hkdfLabel (append hkdfLabel (spread "tls13 ")))
    (set! hkdfLabel (append hkdfLabel (spread label)))
    (set! hkdfLabel (append hkdfLabel (conv byte (len context))))
    (set! hkdfLabel (append hkdfLabel (spread context)))
    (^{:inst [H]} hkdf/Expand hash secret (conv string hkdfLabel) length)))


^{:go/end 47} (go/func extract :type-params [^hash/Hash H] ^{:tag (slice byte)} [^{:tag (func [] [H])} hash ^{:tag (slice byte)} newSecret ^:go/grouped ^{:tag (slice byte)} currentSecret]
  (when (== newSecret nil)
    (set! newSecret (make (slice byte) (.Size (hash)))))

  (^{:inst [H]} hkdf/Extract hash newSecret currentSecret))


^{:go/end 54} (go/func deriveSecret :type-params [^hash/Hash H] ^{:tag (slice byte)} [^{:tag (func [] [H])} hash ^{:tag (slice byte)} secret ^string label ^hash/Hash transcript]
  (when (== transcript nil)
    (set! transcript (hash)))

  (^{:inst [H]} ExpandLabel hash secret label (.Sum transcript nil) (.Size transcript)))


(go/const
  ^{:line 57} [^{:val "res binder"} resumptionBinderLabel "res binder"]
  ^{:line 58} [^{:val "c e traffic"} clientEarlyTrafficLabel "c e traffic"]
  ^{:line 59} [^{:val "c hs traffic"} clientHandshakeTrafficLabel "c hs traffic"]
  ^{:line 60} [^{:val "s hs traffic"} serverHandshakeTrafficLabel "s hs traffic"]
  ^{:line 61} [^{:val "c ap traffic"} clientApplicationTrafficLabel "c ap traffic"]
  ^{:line 62} [^{:val "s ap traffic"} serverApplicationTrafficLabel "s ap traffic"]
  ^{:line 63} [^{:val "e exp master"} earlyExporterLabel "e exp master"]
  ^{:line 64} [^{:val "exp master"} exporterLabel "exp master"]
  ^{:line 65} [^{:val "res master"} resumptionLabel "res master"])



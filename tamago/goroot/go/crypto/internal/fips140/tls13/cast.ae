(in-ns 'go.crypto.internal.fips140.tls13) (go/file "cast.go" :imports [


    ^{:line 8} [bytes "bytes"]
    ^{:line 9} [fips140 "crypto/internal/fips140"]
    ^{:line 10} [_ "crypto/internal/fips140/check"]
    ^{:line 11} [sha256 "crypto/internal/fips140/sha256"]
    ^{:line 12} [errors "errors"]])


^{:go/end 37} (go/func init []
  (fips140/CAST "TLSv1.3-SHA2-256" ^{:go/end 36} (fn ^error []
      ^{:go/breaks [[4 35]]} (let [input ^{:go/breaks [2 10]} (lit (slice byte)
            0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08
            0x09 0x0a 0x0b 0x0c 0x0d 0x0e 0x0f 0x10)

          ^{:line 21} want ^{:go/breaks [2 10 18 26]} (lit (slice byte)
            0x78 0x20 0x71 0x75 0x52 0xfd 0x47 0x67
            0xe1 0x07 0x5c 0x83 0x74 0x2e 0x49 0x43
            0xf7 0xe3 0x08 0x6a 0x2a 0xcb 0x96 0xc7
            0xa3 0x1f 0xe3 0x23 0x56 0x6e 0x14 0x5b)

          ^{:line 27} es (^{:inst [(* sha256/Digest)]} NewEarlySecret sha256/New nil)
          ^{:line 28} hs (.HandshakeSecret es nil)
          ^{:line 29} ms (.MasterSecret hs)
          ^{:line 30} transcript (sha256/New)]
        (.Write transcript input)
        (when [got (.ResumptionMasterSecret ms transcript)] (not (bytes/Equal got want))
          (return (errors/New "unexpected result")))

        nil))))

(ns go.crypto.internal.fips140.bigmod
  (:require [arbace.go :as go]))

(go/package bigmod
  :path "crypto/internal/fips140/bigmod"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["nat.go" "nat_asm.go"]
  :other-files ["nat_amd64.s"]
  :init-order [supportADX]
  :positions :lines)

(load "bigmod/nat")
(load "bigmod/nat_asm")

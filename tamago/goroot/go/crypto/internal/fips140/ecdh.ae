(ns go.crypto.internal.fips140.ecdh
  (:require [arbace.go :as go]))

(go/package ecdh
  :path "crypto/internal/fips140/ecdh"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["cast.go" "ecdh.go"]
  :init-order [p224Order p256Order fipsSelfTest p384Order p521Order]
  :positions :lines)

(load "ecdh/cast")
(load "ecdh/ecdh")

(in-ns 'go.crypto.internal.fips140.hmac) (go/file "cast.go" :imports [


    ^{:line 8} [bytes "bytes"]
    ^{:line 9} [fips140 "crypto/internal/fips140"]
    ^{:line 10} [sha256 "crypto/internal/fips140/sha256"]
    ^{:line 11} [errors "errors"]])


^{:go/end 34} (go/func init []
  (fips140/CAST "HMAC-SHA2-256" ^{:go/end 33} (fn ^error []
      ^{:go/breaks [[5 32]]} (let [input ^{:go/breaks [2 10]} (lit (slice byte)
            0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08
            0x09 0x0a 0x0b 0x0c 0x0d 0x0e 0x0f 0x10)

          ^{:line 20} want ^{:go/breaks [2 10 18 26]} (lit (slice byte)
            0xf0 0x8d 0x82 0x8d 0x4c 0x9e 0xad 0x3d
            0xdc 0x12 0x9c 0x4e 0x70 0xc4 0x19 0x2a
            0x4f 0x12 0x73 0x23 0x73 0x77 0x66 0x05
            0x10 0xee 0x57 0x6b 0x3a 0xc7 0x14 0x41)

          ^{:line 26} h (^{:inst [(* sha256/Digest)]} New sha256/New input)]
        (.Write h input)
        (.Write h input)
        (when [got (.Sum h nil)] (not (bytes/Equal got want))
          (return (errors/New "unexpected result")))

        nil))))

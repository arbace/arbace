          (set! (aget (.-ipad hm) i) bit-xor 0x36))

        (range [i (.-opad hm)]
          (set! (aget (.-opad hm) i) bit-xor 0x5c))

        (.Write (.-inner hm) (.-ipad hm))

        ^{:line 203} hm))))




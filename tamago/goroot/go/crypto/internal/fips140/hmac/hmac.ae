;; Package hmac implements HMAC according to [FIPS 198-1].
;;
;; [FIPS 198-1]: https://doi.org/10.6028/NIST.FIPS.198-1
(in-ns 'go.crypto.internal.fips140.hmac) (go/file "hmac.go" :doc "Package hmac implements HMAC according to [FIPS 198-1].\n\n[FIPS 198-1]: https://doi.org/10.6028/NIST.FIPS.198-1\n" :imports [



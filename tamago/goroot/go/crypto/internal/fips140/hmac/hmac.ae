^{:go/end 165} (go/method Clone "Clone implements [hash.Cloner] if the underlying hash does.\nOtherwise, it returns an error wrapping [errors.ErrUnsupported].\n" [^{:tag (* HMAC)} h] :results [hash/Cloner error]
  (let [r @h
      (values ic ok) (assert hash/Cloner (.-inner h))]
    (when (not ok)
      (return nil (lit errCloneUnsupported)))

    (let [(values oc ^:assign ok) (assert hash/Cloner (.-outer h))]
      (when (not ok)
        (return nil (lit errCloneUnsupported)))

      (let [^error err (zero error)]
        (set! (values (.-inner r) err) (.Clone ic))
        (when (!= err nil)
          (return nil (lit errCloneUnsupported)))

        (set! (values (.-outer r) err) (.Clone oc))
        (when (!= err nil)
          (return nil (lit errCloneUnsupported)))

        (return (addr r) nil)))))



^{:go/end 204} (go/func New "New returns a new HMAC hash using the given [hash.Hash] type and key.\n" :type-params [^hash/Hash H] ^{:tag (* HMAC)} [^{:tag (func [] [H])} h ^{:tag (slice byte)} key]
  (let [hm (addr (lit HMAC :keyLen (len key)))]
    (set! (.-outer hm) (h))
    (set! (.-inner hm) (h))
    (let [unique true]
      (^{:go/end 181} (fn []
          (defer (^{:go/end 177} (fn []

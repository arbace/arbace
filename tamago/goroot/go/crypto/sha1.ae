(ns go.crypto.sha1
  (:require [arbace.go :as go]))

(go/package sha1
  :path "crypto/sha1"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["sha1.go" "sha1block.go" "sha1block_amd64.go"]
  :other-files ["sha1block_amd64.s"]
  :init-order [useAVX2 useSHANI]
  :positions :lines)

(load "sha1/sha1")
(load "sha1/sha1block")
(load "sha1/sha1block_amd64")

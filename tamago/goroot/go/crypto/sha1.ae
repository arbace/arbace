(ns go.crypto.sha1
  (:require [arbace.go :as go]))

(go/package sha1
  :path "crypto/sha1"
  :files ["sha1.go" "sha1block.go" "sha1block_amd64.go" "sha1block_arm64.go"]
  :other-files ["sha1block_amd64.s" "sha1block_arm64.s"]
  :positions :lines)

(load "sha1/sha1")
(load "sha1/sha1block")
(load "sha1/sha1block_amd64")
(load "sha1/sha1block_arm64")

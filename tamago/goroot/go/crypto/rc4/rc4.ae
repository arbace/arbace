;; Package rc4 implements RC4 encryption, as defined in Bruce Schneier's
;; Applied Cryptography.
;;
;; RC4 is cryptographically broken and should not be used for secure
;; applications.
(in-ns 'go.crypto.rc4) (go/file "rc4.go" :doc "Package rc4 implements RC4 encryption, as defined in Bruce Schneier's\nApplied Cryptography.\n\nRC4 is cryptographically broken and should not be used for secure\napplications.\n" :imports [


    ^{:line 13} [alias "crypto/internal/fips140/alias"]
    ^{:line 14} [fips140only "crypto/internal/fips140only"]
    ^{:line 15} [errors "errors"]
    ^{:line 16} [strconv "strconv"]])



(go/type Cipher "A Cipher is an instance of RC4 using a particular key.\n" (struct
    ^{:line 21 :tag (array 256 uint32)} s
    ^{:line 22 :tag uint8} i ^uint8 j))


(go/type KeySizeError int)

^{:go/end 29} (go/method Error ^string [^KeySizeError k]
  (+ "crypto/rc4: invalid key size " (strconv/Itoa (conv int k))))




^{:go/end 51} (go/func NewCipher "NewCipher creates and returns a new [Cipher]. The key argument should be the\nRC4 key, at least 1 byte and at most 256 bytes.\n" [^{:tag (slice byte)} key] :results [(* Cipher) error]
  (when (fips140only/Enforced)
    (return nil (errors/New "crypto/rc4: use of RC4 is not allowed in FIPS 140-only mode")))

  (let [k (len key)]
    (when (or (< k 1) (> k 256))
      (return nil (conv KeySizeError k)))

    (let [^Cipher c (zero Cipher)]
      (for [i 0] (< i 256) (inc! i)
        (aset (.-s c) i (conv uint32 i)))

      (let [^uint8 j 0]
        (for [i 0] (< i 256) (inc! i)
          (set! j + (+ (conv uint8 (aget (.-s c) i)) (aget key (% i k))))
          (set! (values (aget (.-s c) i) (aget (.-s c) j)) (values (aget (.-s c) j) (aget (.-s c) i))))

        (return (addr c) nil)))))






^{:go/end 60} (go/method Reset "Reset zeros the key data and makes the [Cipher] unusable.\n\nDeprecated: Reset can't guarantee that the key will be entirely removed from\nthe process's memory.\n" [^{:tag (* Cipher)} c]
  (clear (subslice (.-s c)))
  (set! (values (.-i c) (.-j c)) (values 0 0)))




^{:go/end 83} (go/method XORKeyStream "XORKeyStream sets dst to the result of XORing src with the key stream.\nDst and src must overlap entirely or not at all.\n" [^{:tag (* Cipher)} c ^{:tag (slice byte)} dst ^{:tag (slice byte)} src]
  (when (== (len src) 0)
    (return))

  (when (alias/InexactOverlap (subslice dst _ (len src)) src)
    (panic "crypto/rc4: invalid buffer overlap"))

  (let [(values i j) (values (.-i c) (.-j c))]
    (set! _ (aget dst (- (len src) 1)))
    (set! dst (subslice dst _ (len src))) ; eliminate bounds check from loop
    (range [k v src]
      (set! i + 1)
      (let [x (aget (.-s c) i)]
        (set! j + (conv uint8 x))
        (let [y (aget (.-s c) j)]
          (set! (values (aget (.-s c) i) (aget (.-s c) j)) (values y x))
          (aset dst k (bit-xor v (conv uint8 (aget (.-s c) (conv uint8 (+ x y)))))))))

    (set! (values (.-i c) (.-j c)) (values i j))))

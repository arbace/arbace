  (when (< (len dst) BlockSize)
    (panic "crypto/des: output not full block"))

  (when (alias/InexactOverlap (subslice dst _ BlockSize) (subslice src _ BlockSize))
    (panic "crypto/des: invalid buffer overlap"))

  (cryptBlock (subslice (.-subkeys c)) dst src true))



(go/type tripleDESCipher "A tripleDESCipher is an instance of TripleDES encryption.\n" (struct
    ^{:line 75 :tag desCipher} cipher1 ^desCipher cipher2 ^desCipher cipher3))



^{:go/end 93} (go/func NewTripleDESCipher "NewTripleDESCipher creates and returns a new [cipher.Block].\n" [^{:tag (slice byte)} key] :results [cipher/Block error]
  (when (fips140only/Enforced)
    (return nil (errors/New "crypto/des: use of TripleDES is not allowed in FIPS 140-only mode")))


  (when (!= (len key) 24)
    (return nil (conv KeySizeError (len key))))


  (let [c (new tripleDESCipher)]
    (.generateSubkeys (.-cipher1 c) (subslice key _ 8))
    (.generateSubkeys (.-cipher2 c) (subslice key 8 16))
    (.generateSubkeys (.-cipher3 c) (subslice key 16))
    (return c nil)))


^{:go/end 95} (go/method BlockSize ^int [^{:tag (* tripleDESCipher)} c] BlockSize)

^{:go/end 130} (go/method Encrypt [^{:tag (* tripleDESCipher)} c ^{:tag (slice byte)} dst ^{:tag (slice byte)} src]
  (when (< (len src) BlockSize)

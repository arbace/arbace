  (when (< (len dst) BlockSize)
    (panic "crypto/des: output not full block"))

  (when (alias/InexactOverlap (subslice dst _ BlockSize) (subslice src _ BlockSize))
    (panic "crypto/des: invalid buffer overlap"))


  (let [b (byteorder/BEUint64 src)]
    (set! b (permuteInitialBlock b))
    (let [(values left right) (values (conv uint32 (>> b 32)) (conv uint32 b))]

      (set! left (bit-or (<< left 1) (>> left 31)))
      (set! right (bit-or (<< right 1) (>> right 31)))

      (for [i 0] (< i 8) (inc! i)
        (set! (values left right) (feistel left right (aget (.-subkeys (.-cipher1 c)) (* 2 i)) (aget (.-subkeys (.-cipher1 c)) (+ (* 2 i) 1)))))

      (for [i 0] (< i 8) (inc! i)
        (set! (values right left) (feistel right left (aget (.-subkeys (.-cipher2 c)) (- 15 (* 2 i))) (aget (.-subkeys (.-cipher2 c)) (- 15 (+ (* 2 i) 1))))))

      (for [i 0] (< i 8) (inc! i)
        (set! (values left right) (feistel left right (aget (.-subkeys (.-cipher3 c)) (* 2 i)) (aget (.-subkeys (.-cipher3 c)) (+ (* 2 i) 1)))))


      (set! left (bit-or (<< left 31) (>> left 1)))
      (set! right (bit-or (<< right 31) (>> right 1)))

      (let [preOutput (bit-or (<< (conv uint64 right) 32) (conv uint64 left))]
        (byteorder/BEPutUint64 dst (permuteFinalBlock preOutput))))))



^{:go/end 58} (go/method Encrypt [^{:tag (* desCipher)} c ^{:tag (slice byte)} dst ^{:tag (slice byte)} src]
  (when (< (len src) BlockSize)
    (panic "crypto/des: input not full block"))

  (when (< (len dst) BlockSize)
    (panic "crypto/des: output not full block"))

  (when (alias/InexactOverlap (subslice dst _ BlockSize) (subslice src _ BlockSize))
    (panic "crypto/des: invalid buffer overlap"))

  (cryptBlock (subslice (.-subkeys c)) dst src false))


^{:go/end 71} (go/method Decrypt [^{:tag (* desCipher)} c ^{:tag (slice byte)} dst ^{:tag (slice byte)} src]
  (when (< (len src) BlockSize)

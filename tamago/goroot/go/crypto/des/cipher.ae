(go/const ^{:val 8 :doc "The DES block size in bytes.\n"} BlockSize 8)

(go/type KeySizeError int)

^{:go/end 23} (go/method Error ^string [^KeySizeError k]
  (+ "crypto/des: invalid key size " (strconv/Itoa (conv int k))))



(go/type desCipher "desCipher is an instance of DES encryption.\n" (struct
    ^{:line 27 :tag (array 16 uint64)} subkeys))



^{:go/end 43} (go/func NewCipher "NewCipher creates and returns a new [cipher.Block].\n" [^{:tag (slice byte)} key] :results [cipher/Block error]
  (when (fips140only/Enforced)
    (return nil (errors/New "crypto/des: use of DES is not allowed in FIPS 140-only mode")))


  (when (!= (len key) 8)
    (return nil (conv KeySizeError (len key))))


  (let [c (new desCipher)]
    (.generateSubkeys c key)
    (return c nil)))



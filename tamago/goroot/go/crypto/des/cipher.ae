(in-ns 'go.crypto.des) (go/file "cipher.go" :imports [


    ^{:line 8} [cipher "crypto/cipher"]
    ^{:line 9} [alias "crypto/internal/fips140/alias"]
    ^{:line 10} [fips140only "crypto/internal/fips140only"]

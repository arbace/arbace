(ns go.crypto.tls
  (:require [arbace.go :as go]))

(go/package tls
  :path "crypto/tls"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["alert.go" "auth.go" "cache.go" "cipher_suites.go" "common.go" "common_string.go" "conn.go" "defaults.go" "defaults_fips140.go" "ech.go" "handshake_client.go" "handshake_client_tls13.go" "handshake_messages.go" "handshake_server.go" "handshake_server_tls13.go" "key_agreement.go" "key_schedule.go" "prf.go" "quic.go" "ticket.go" "tls.go"]
  :init-order [["alert.go" 15 5] alertText signaturePadding rsaSignatureSchemes globalCertCache supportedUpToTLS12 supportedOnlyTLS12 supportedOnlyTLS13 cipherSuites cipherSuitesTLS13 cipherSuitesPreferenceOrder cipherSuitesPreferenceOrderNoAES disabledCipherSuites hasGCMAsmAMD64 hasGCMAsmARM64 hasGCMAsmS390X hasGCMAsmPPC64 hasAESGCMHardwareSupport aesgcmCiphers directSigning helloRetryRequestRandom deprecatedSessionTicketKey supportedVersions errNoCertificates tlssha1 _SignatureScheme_index_8 _SignatureScheme_index_9 _CurveID_index_0 _CurveID_index_3 _ClientAuthType_index outBufPool errShutdown errEarlyCloseWrite tlsmlkem tlssecpmlkem defaultCipherSuitesTLS13 defaultCipherSuitesTLS13NoAES allowedSupportedVersionsFIPS allowedCurvePreferencesFIPS allowedSignatureAlgorithmsFIPS allowedCipherSuitesFIPS allowedCipherSuitesTLS13FIPS errMalformedECHConfigList errMalformedECHExt errInvalidECHExt fips140ems tlsmaxrsasize errClientKeyExchange errServerKeyExchange ["tls.go" 115 5]]
  :positions :lines)

(load "tls/alert")
(load "tls/auth")
(load "tls/cache")
(load "tls/cipher_suites")
(load "tls/common")
(load "tls/common_string")
(load "tls/conn")
(load "tls/defaults")
(load "tls/defaults_fips140")
(load "tls/ech")
(load "tls/handshake_client")
(load "tls/handshake_client_tls13")
(load "tls/handshake_messages")
(load "tls/handshake_server")
(load "tls/handshake_server_tls13")
(load "tls/key_agreement")
(load "tls/key_schedule")
(load "tls/prf")
(load "tls/quic")
(load "tls/ticket")
(load "tls/tls")

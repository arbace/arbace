;; Package mlkem implements the quantum-resistant key encapsulation method
;; ML-KEM (formerly known as Kyber), as specified in [NIST FIPS 203].
;;
;; Most applications should use the ML-KEM-768 parameter set, as implemented by
;; [DecapsulationKey768] and [EncapsulationKey768].
;;
;; [NIST FIPS 203]: https://doi.org/10.6028/NIST.FIPS.203
(in-ns 'go.crypto.mlkem) (go/file "mlkem.go" :doc "Package mlkem implements the quantum-resistant key encapsulation method\nML-KEM (formerly known as Kyber), as specified in [NIST FIPS 203].\n\nMost applications should use the ML-KEM-768 parameter set, as implemented by\n[DecapsulationKey768] and [EncapsulationKey768].\n\n[NIST FIPS 203]: https://doi.org/10.6028/NIST.FIPS.203\n" :imports [


    ^{:line 15} [crypto "crypto"]
    ^{:line 16} [mlkem "crypto/internal/fips140/mlkem"]])


(go/const

  ^{:line 21} [^{:val 32 :doc "SharedKeySize is the size of a shared key produced by ML-KEM.\n"} SharedKeySize 32]


  ^{:line 24} [^{:val 64 :doc "SeedSize is the size of a seed used to generate a decapsulation key.\n"} SeedSize 64]


  ^{:line 27} [^{:val 1088 :doc "CiphertextSize768 is the size of a ciphertext produced by ML-KEM-768.\n"} CiphertextSize768 1088]


  ^{:line 30} [^{:val 1184 :doc "EncapsulationKeySize768 is the size of an ML-KEM-768 encapsulation key.\n"} EncapsulationKeySize768 1184]


  ^{:line 33} [^{:val 1568 :doc "CiphertextSize1024 is the size of a ciphertext produced by ML-KEM-1024.\n"} CiphertextSize1024 1568]


  ^{:line 36} [^{:val 1568 :doc "EncapsulationKeySize1024 is the size of an ML-KEM-1024 encapsulation key.\n"} EncapsulationKeySize1024 1568])




(go/type DecapsulationKey768 "DecapsulationKey768 is the secret key used to decapsulate a shared key\nfrom a ciphertext. It includes various precomputed values.\n" (struct
    ^{:line 42 :tag (* mlkem/DecapsulationKey768)} key))




^{:go/end 54} (go/func GenerateKey768 "GenerateKey768 generates a new decapsulation key, drawing random bytes from\na secure source. The decapsulation key must be kept secret.\n" [] :results [(* DecapsulationKey768) error]
  (let [(values key err) (mlkem/GenerateKey768)]
    (when (!= err nil)
      (return nil err))


    (return (addr (lit DecapsulationKey768 key)) nil)))




^{:go/end 65} (go/func NewDecapsulationKey768 "NewDecapsulationKey768 expands a decapsulation key from a 64-byte seed in the\n\"d || z\" form. The seed must be uniformly random.\n" [^{:tag (slice byte)} seed] :results [(* DecapsulationKey768) error]
  (let [(values key err) (mlkem/NewDecapsulationKey768 seed)]
    (when (!= err nil)
      (return nil err))


    (return (addr (lit DecapsulationKey768 key)) nil)))





^{:go/end 72} (go/method Bytes "Bytes returns the decapsulation key as a 64-byte seed in the \"d || z\" form.\n\nThe decapsulation key must be kept secret.\n" ^{:tag (slice byte)} [^{:tag (* DecapsulationKey768)} dk]
  (.Bytes (.-key dk)))









^{:go/end 83} (go/method Decapsulate "Decapsulate generates a shared key from a ciphertext and a decapsulation\nkey. If the ciphertext is not the correct length, Decapsulate returns an\nerror. A ciphertext that is the correct length but otherwise invalid will\nnot return an error; instead, it will produce a shared key that does not\nmatch the sender's, according to FIPS 203.\n\nThe shared key must be kept secret.\n" [^{:tag (* DecapsulationKey768)} dk ^{:tag (slice byte)} ciphertext] :results [^{:tag (slice byte)} sharedKey ^error err]
  (.Decapsulate (.-key dk) ciphertext))




^{:go/end 89} (go/method EncapsulationKey "EncapsulationKey returns the public encapsulation key necessary to produce\nciphertexts.\n" ^{:tag (* EncapsulationKey768)} [^{:tag (* DecapsulationKey768)} dk]
  (addr (lit EncapsulationKey768 (.EncapsulationKey (.-key dk)))))






^{:go/end 97} (go/method Encapsulator "Encapsulator returns the encapsulation key, like\n[DecapsulationKey768.EncapsulationKey].\n\nIt implements [crypto.Decapsulator].\n" ^crypto/Encapsulator [^{:tag (* DecapsulationKey768)} dk]
  (.EncapsulationKey dk))


(go/var ^crypto/Decapsulator _ (conv (* DecapsulationKey768) nil))



(go/type EncapsulationKey768 "An EncapsulationKey768 is the public key used to produce ciphertexts to be\ndecapsulated by the corresponding DecapsulationKey768.\n" (struct
    ^{:line 104 :tag (* mlkem/EncapsulationKey768)} key))




^{:go/end 116} (go/func NewEncapsulationKey768 "NewEncapsulationKey768 parses an encapsulation key from its encoded form. If\nthe encapsulation key is not valid, NewEncapsulationKey768 returns an error.\n" [^{:tag (slice byte)} encapsulationKey] :results [(* EncapsulationKey768) error]
  (let [(values key err) (mlkem/NewEncapsulationKey768 encapsulationKey)]
    (when (!= err nil)
      (return nil err))


    (return (addr (lit EncapsulationKey768 key)) nil)))



^{:go/end 121} (go/method Bytes "Bytes returns the encapsulation key as a byte slice.\n" ^{:tag (slice byte)} [^{:tag (* EncapsulationKey768)} ek]
  (.Bytes (.-key ek)))









^{:go/end 132} (go/method Encapsulate "Encapsulate generates a shared key and an associated ciphertext from an\nencapsulation key, drawing random bytes from a secure source.\n\nThe shared key must be kept secret.\n\nFor testing, derandomized encapsulation is provided by the\n[crypto/mlkem/mlkemtest] package.\n" [^{:tag (* EncapsulationKey768)} ek] :results [^{:tag (slice byte)} sharedKey ^{:tag (slice byte)} ciphertext]
  (.Encapsulate (.-key ek)))





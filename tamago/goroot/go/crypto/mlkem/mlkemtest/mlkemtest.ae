;; Package mlkemtest provides testing functions for the ML-KEM algorithm.
(in-ns 'go.crypto.mlkem.mlkemtest) (go/file "mlkemtest.go" :doc "Package mlkemtest provides testing functions for the ML-KEM algorithm.\n" :imports [


    ^:alias ^{:line 9} [fips140mlkem "crypto/internal/fips140/mlkem"]
    ^{:line 10} [fips140only "crypto/internal/fips140only"]
    ^{:line 11} [mlkem "crypto/mlkem"]
    ^{:line 12} [errors "errors"]])







^{:go/end 33} (go/func Encapsulate768 "Encapsulate768 implements derandomized ML-KEM-768 encapsulation\n(ML-KEM.Encaps_internal from FIPS 203) using the provided encapsulation key\nek and 32 bytes of randomness.\n\nIt must only be used for known-answer tests.\n" [^{:tag (* mlkem/EncapsulationKey768)} ek ^{:tag (slice byte)} random] :results [^{:tag (slice byte)} sharedKey ^{:tag (slice byte)} ciphertext ^error err]
  (when (!= (len random) 32)
    (return nil nil (errors/New "mlkemtest: Encapsulate768: random must be 32 bytes")))

  (when (fips140only/Enforced)
    (return nil nil (errors/New "crypto/mlkem/mlkemtest: use of derandomized encapsulation is not allowed in FIPS 140-only mode")))

  (let [(values k ^:assign err) (fips140mlkem/NewEncapsulationKey768 (.Bytes ek))]
    (when (!= err nil)
      (return nil nil (errors/New (+ "mlkemtest: Encapsulate768: failed to reconstruct key: " (.Error err)))))

    (set! (values sharedKey ciphertext) (.EncapsulateInternal k (conv (* (array 32 byte)) random)))
    (return sharedKey ciphertext nil)))







^{:go/end 53} (go/func Encapsulate1024 "Encapsulate1024 implements derandomized ML-KEM-1024 encapsulation\n(ML-KEM.Encaps_internal from FIPS 203) using the provided encapsulation key\nek and 32 bytes of randomness.\n\nIt must only be used for known-answer tests.\n" [^{:tag (* mlkem/EncapsulationKey1024)} ek ^{:tag (slice byte)} random] :results [^{:tag (slice byte)} sharedKey ^{:tag (slice byte)} ciphertext ^error err]
  (when (!= (len random) 32)
    (return nil nil (errors/New "mlkemtest: Encapsulate1024: random must be 32 bytes")))

  (when (fips140only/Enforced)
    (return nil nil (errors/New "crypto/mlkem/mlkemtest: use of derandomized encapsulation is not allowed in FIPS 140-only mode")))

  (let [(values k ^:assign err) (fips140mlkem/NewEncapsulationKey1024 (.Bytes ek))]
    (when (!= err nil)
      (return nil nil (errors/New (+ "mlkemtest: Encapsulate1024: failed to reconstruct key: " (.Error err)))))

    (set! (values sharedKey ciphertext) (.EncapsulateInternal k (conv (* (array 32 byte)) random)))
    (return sharedKey ciphertext nil)))

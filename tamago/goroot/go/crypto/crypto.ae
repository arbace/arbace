(go/type Decapsulator "Decapsulator is an interface for an opaque private KEM key that can be used for\ndecapsulation operations. For example, an ML-KEM key kept in a hardware module.\n\nIt is implemented, for example, by [crypto/mlkem.DecapsulationKey768].\n" (interface
    (Encapsulator ^Encapsulator [])
    (Decapsulate [^{:tag (slice byte)} ciphertext] :results [^{:tag (slice byte)} sharedKey ^error err])))






(go/type Encapsulator "Encapsulator is an interface for a public KEM key that can be used for\nencapsulation operations.\n\nIt is implemented, for example, by [crypto/mlkem.EncapsulationKey768].\n" (interface
    (Bytes ^{:tag (slice byte)} [])
    (Encapsulate [] :results [^{:tag (slice byte)} sharedKey ^{:tag (slice byte)} ciphertext])))

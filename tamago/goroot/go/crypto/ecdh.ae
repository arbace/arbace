(ns go.crypto.ecdh
  (:require [arbace.go :as go]))

(go/package ecdh
  :path "crypto/ecdh"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["ecdh.go" "nist.go" "x25519.go"]
  :init-order [["ecdh.go" 105 5] p256 p384 p521 x25519PublicKeySize x25519PrivateKeySize x25519SharedSecretSize x25519]
  :positions :lines)

(load "ecdh/ecdh")
(load "ecdh/nist")
(load "ecdh/x25519")

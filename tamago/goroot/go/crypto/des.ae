(ns go.crypto.des
  (:require [arbace.go :as go]))

(go/package des
  :path "crypto/des"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["block.go" "cipher.go" "const.go"]
  :init-order [initialPermutation finalPermutation expansionFunction permutationFunction permutedChoice1 permutedChoice2 sBoxes ksRotations]
  :positions :lines)

(load "des/block")
(load "des/cipher")
(load "des/const")

(ns go.crypto.rand
  (:require [arbace.go :as go]))

(go/package rand
  :path "crypto/rand"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["rand.go" "text.go" "util.go"]
  :init-order [Reader]
  :positions :lines)

(load "rand/rand")
(load "rand/text")
(load "rand/util")

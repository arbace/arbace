(ns go.crypto.rsa
  (:require [arbace.go :as go]))

(go/package rsa
  :path "crypto/rsa"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["fips.go" "notboring.go" "pkcs1v15.go" "rsa.go"]
  :init-order [bigOne rsa1024min ErrMessageTooLong ErrDecryption ErrVerification]
  :positions :lines)

(load "rsa/fips")
(load "rsa/notboring")
(load "rsa/pkcs1v15")
(load "rsa/rsa")

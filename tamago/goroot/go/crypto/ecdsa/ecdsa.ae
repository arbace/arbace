    (case [(elliptic/P384)]
      (return (^{:inst [(* nistec/P384Point)]} publicKeyBytes (ecdsa/P384) pub)))
    (case [(elliptic/P521)]
      (return (^{:inst [(* nistec/P521Point)]} publicKeyBytes (ecdsa/P521) pub)))
    (default

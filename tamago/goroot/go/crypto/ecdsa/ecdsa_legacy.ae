^{:go/end 37} (go/func generateLegacy [^elliptic/Curve c ^io/Reader rand] :results [(* PrivateKey) error]
  (when (fips140only/Enforced)
    (return nil (errors/New "crypto/ecdsa: use of custom curves is not allowed in FIPS 140-only mode")))


  (let [(values k err) (randFieldElement c rand)]
    (when (!= err nil)
      (return nil err))


    (let [priv (new PrivateKey)]
      (set! (.-Curve (.-PublicKey priv)) c)
      (set! (.-D priv) k)
      (set! (values (.-X (.-PublicKey priv)) (.-Y (.-PublicKey priv))) (.ScalarBaseMult c (.Bytes k)))
      (return priv nil))))





^{:go/end 55} (go/func hashToInt "hashToInt converts a hash value to an integer. Per FIPS 186-4, Section 6.4,\nwe use the left-most bits of the hash to match the bit-length of the order of\nthe curve. This also performs Step 5 of SEC 1, Version 2.0, Section 4.1.3.\n" ^{:tag (* big/Int)} [^{:tag (slice byte)} hash ^elliptic/Curve c]

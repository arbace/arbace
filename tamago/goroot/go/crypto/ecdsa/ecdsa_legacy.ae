      (when (or (not (.ReadASN1 input (addr inner) asn1/SEQUENCE))
          (not (.Empty input))
          (not (.ReadASN1Integer inner r))
          (not (.ReadASN1Integer inner s))
          (not (.Empty inner)))
        (return nil nil (errors/New "invalid ASN.1 from SignASN1")))

      (return r s nil))))



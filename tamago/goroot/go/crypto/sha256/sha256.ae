;; Package sha256 implements the SHA224 and SHA256 hash algorithms as defined
;; in FIPS 180-4.
(in-ns 'go.crypto.sha256) (go/file "sha256.go" :doc "Package sha256 implements the SHA224 and SHA256 hash algorithms as defined\nin FIPS 180-4.\n" :imports [


    ^{:line 10} [crypto "crypto"]
    ^{:line 11} [boring "crypto/internal/boring"]
    ^{:line 12} [sha256 "crypto/internal/fips140/sha256"]
    ^{:line 13} [hash "hash"]])


^{:go/end 19} (go/func init []
  (crypto/RegisterHash crypto/SHA224 New224)
  (crypto/RegisterHash crypto/SHA256 New))



(go/const ^{:val 32 :doc "The size of a SHA256 checksum in bytes.\n"} Size 32)


(go/const ^{:val 28 :doc "The size of a SHA224 checksum in bytes.\n"} Size224 28)


(go/const ^{:val 64 :doc "The blocksize of SHA256 and SHA224 in bytes.\n"} BlockSize 64)





^{:go/end 39} (go/func New "New returns a new [hash.Hash] computing the SHA256 checksum. The Hash\nalso implements [encoding.BinaryMarshaler], [encoding.BinaryAppender] and\n[encoding.BinaryUnmarshaler] to marshal and unmarshal the internal\nstate of the hash.\n" ^hash/Hash []
  (when boring/Enabled
    (return (boring/NewSHA256)))

  (sha256/New))






^{:go/end 50} (go/func New224 "New224 returns a new [hash.Hash] computing the SHA224 checksum. The Hash\nalso implements [encoding.BinaryMarshaler], [encoding.BinaryAppender] and\n[encoding.BinaryUnmarshaler] to marshal and unmarshal the internal\nstate of the hash.\n" ^hash/Hash []
  (when boring/Enabled
    (return (boring/NewSHA224)))

  (sha256/New224))



^{:go/end 62} (go/func Sum256 "Sum256 returns the SHA256 checksum of the data.\n" ^{:tag (array Size byte)} [^{:tag (slice byte)} data]
  (when boring/Enabled
    (return (boring/SHA256 data)))

  (let [h (New)]
    (.Write h data)
    (let [^{:tag (array Size byte)} sum (zero (array Size byte))]
      (.Sum h (subslice sum _ 0))
      ^{:line 61} sum)))



^{:go/end 74} (go/func Sum224 "Sum224 returns the SHA224 checksum of the data.\n" ^{:tag (array Size224 byte)} [^{:tag (slice byte)} data]
  (when boring/Enabled
    (return (boring/SHA224 data)))

  (let [h (New224)]
    (.Write h data)
    (let [^{:tag (array Size224 byte)} sum (zero (array Size224 byte))]
      (.Sum h (subslice sum _ 0))
      ^{:line 73} sum)))

(in-ns 'go.crypto.rand) (go/file "text.go" :imports [])

(go/const ^{:val "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"} base32alphabet "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567")






^{:go/end 22} (go/func Text "Text returns a cryptographically random string using the standard RFC 4648 base32 alphabet\nfor use when a secret string, token, password, or other text is needed.\nThe result contains at least 128 bits of randomness, enough to prevent brute force\nguessing attacks and to make the likelihood of collisions vanishingly small.\nA future version may return longer texts as needed to maintain those properties.\n" ^string []
  ;; ⌈log₃₂ 2¹²⁸⌉ = 26 chars
  (let [src (make (slice byte) 26)]
    (Read src)
    (range [i src]
      (aset src i (aget base32alphabet (% (aget src i) 32))))

    (conv string src)))

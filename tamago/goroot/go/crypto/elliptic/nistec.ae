(go/type nistCurve "nistCurve is a Curve implementation based on a nistec Point.\n\nIt's a wrapper that exposes the big.Int-based Curve interface and encodes the\nlegacy idiosyncrasies it requires, such as invalid and infinity point\nhandling.\n\nTo interact with the nistec package, points are encoded into and decoded from\nproperly formatted byte slices. All big.Int use is limited to this package.\nEncoding and decoding is 1/1000th of the runtime of a scalar multiplication,\nso the overhead is acceptable.\n" :type-params [^{:tag (nistPoint Point)} Point] (struct
    ^{:line 107 :tag (func [] [Point])} newPoint
    ^{:line 108 :tag (* CurveParams)} params))



(go/type nistPoint "nistPoint is a generic constraint for the nistec Point types.\n" :type-params [T] (interface
    (Bytes ^{:tag (slice byte)} [])
    (SetBytes [(slice byte)] :results [T error])
    (Add ^T [T T])
    (Double ^T [T])
    (ScalarMult [T (slice byte)] :results [T error])
    (ScalarBaseMult [(slice byte)] :results [T error])))


^{:go/end 123} (go/method Params ^{:tag (* CurveParams)} [^{:tag (* (nistCurve Point))} curve]
  (.-params curve))


^{:go/end 133} (go/method IsOnCurve ^bool [^{:tag (* (nistCurve Point))} curve ^{:tag (* big/Int)} x ^:go/grouped ^{:tag (* big/Int)} y]
  ;; IsOnCurve is documented to reject (0, 0), the conventional point at
  ;; infinity, which however is accepted by pointFromAffine.
  (when (and (== (.Sign x) 0) (== (.Sign y) 0))
    (return false))

  (let [(values _ err) (.pointFromAffine curve x y)]
    (== err nil)))


^{:go/end 155} (go/method pointFromAffine [^{:tag (* (nistCurve Point))} curve ^{:tag (* big/Int)} x ^:go/grouped ^{:tag (* big/Int)} y] :results [^Point p ^error err]
  ;; (0, 0) is by convention the point at infinity, which can't be represented
  ;; in affine coordinates. See Issue 37294.
  (when (and (== (.Sign x) 0) (== (.Sign y) 0))
    (return ((.-newPoint curve)) nil))

  ;; Reject values that would not get correctly encoded.
  (when (or (< (.Sign x) 0) (< (.Sign y) 0))
    (return p (errors/New "negative coordinate")))

  (when (or (> (.BitLen x) (.-BitSize (.-params curve))) (> (.BitLen y) (.-BitSize (.-params curve))))
    (return p (errors/New "overflowing coordinate")))

  ;; Encode the coordinates and let SetBytes reject invalid points.
  (let [byteLen (/ (+ (.-BitSize (.-params curve)) 7) 8)
      ^{:line 150} buf (make (slice byte) (+ 1 (* 2 byteLen)))]
    (aset buf 0 4) ; uncompressed point
    (.FillBytes x (subslice buf 1 (+ 1 byteLen)))
    (.FillBytes y (subslice buf (+ 1 byteLen) (+ 1 (* 2 byteLen))))
    (.SetBytes ((.-newPoint curve)) buf)))


^{:go/end 168} (go/method pointToAffine [^{:tag (* (nistCurve Point))} curve ^Point p] :results [^{:tag (* big/Int)} x ^:go/grouped ^{:tag (* big/Int)} y]
  (let [out (.Bytes p)]
    (when (and (== (len out) 1) (== (aget out 0) 0))
      ;; This is the encoding of the point at infinity, which the affine
      ;; coordinates API represents as (0, 0) by convention.
      (return (new big/Int) (new big/Int)))

    (let [byteLen (/ (+ (.-BitSize (.-params curve)) 7) 8)]
      (set! x (.SetBytes (new big/Int) (subslice out 1 (+ 1 byteLen))))
      (set! y (.SetBytes (new big/Int) (subslice out (+ 1 byteLen))))
      (return x y))))


^{:go/end 180} (go/method Add [^{:tag (* (nistCurve Point))} curve ^{:tag (* big/Int)} x1 ^:go/grouped ^{:tag (* big/Int)} y1 ^:go/grouped ^{:tag (* big/Int)} x2 ^:go/grouped ^{:tag (* big/Int)} y2] :results [(* big/Int) (* big/Int)]
  (let [(values p1 err) (.pointFromAffine curve x1 y1)]
    (when (!= err nil)
      (panic "crypto/elliptic: Add was called on an invalid point"))

    (let [(values p2 ^:assign err) (.pointFromAffine curve x2 y2)]
      (when (!= err nil)
        (panic "crypto/elliptic: Add was called on an invalid point"))

      (.pointToAffine curve (.Add p1 p1 p2)))))


^{:go/end 188} (go/method Double [^{:tag (* (nistCurve Point))} curve ^{:tag (* big/Int)} x1 ^:go/grouped ^{:tag (* big/Int)} y1] :results [(* big/Int) (* big/Int)]
  (let [(values p err) (.pointFromAffine curve x1 y1)]
    (when (!= err nil)
      (panic "crypto/elliptic: Double was called on an invalid point"))

    (.pointToAffine curve (.Double p p))))




^{:go/end 203} (go/method normalizeScalar "normalizeScalar brings the scalar within the byte size of the order of the\ncurve, as expected by the nistec scalar multiplication functions.\n" ^{:tag (slice byte)} [^{:tag (* (nistCurve Point))} curve ^{:tag (slice byte)} scalar]
  (let [byteSize (/ (+ (.BitLen (.-N (.-params curve))) 7) 8)]
    (when (== (len scalar) byteSize)
      (return scalar))

    (let [s (.SetBytes (new big/Int) scalar)]
      (when (> (len scalar) byteSize)
        (.Mod s s (.-N (.-params curve))))

      (let [out (make (slice byte) byteSize)]
        (.FillBytes s out)))))


^{:go/end 216} (go/method ScalarMult [^{:tag (* (nistCurve Point))} curve ^{:tag (* big/Int)} Bx ^:go/grouped ^{:tag (* big/Int)} By ^{:tag (slice byte)} scalar] :results [(* big/Int) (* big/Int)]
  (let [(values p err) (.pointFromAffine curve Bx By)]
    (when (!= err nil)
      (panic "crypto/elliptic: ScalarMult was called on an invalid point"))

    (set! scalar (.normalizeScalar curve scalar))
    (set! (values p err) (.ScalarMult p p scalar))
    (when (!= err nil)
      (panic "crypto/elliptic: nistec rejected normalized scalar"))

    (.pointToAffine curve p)))


^{:go/end 225} (go/method ScalarBaseMult [^{:tag (* (nistCurve Point))} curve ^{:tag (slice byte)} scalar] :results [(* big/Int) (* big/Int)]
  (set! scalar (.normalizeScalar curve scalar))
  (let [(values p err) (.ScalarBaseMult ((.-newPoint curve)) scalar)]
    (when (!= err nil)
      (panic "crypto/elliptic: nistec rejected normalized scalar"))

    (.pointToAffine curve p)))


^{:go/end 243} (go/method Unmarshal [^{:tag (* (nistCurve Point))} curve ^{:tag (slice byte)} data] :results [^{:tag (* big/Int)} x ^:go/grouped ^{:tag (* big/Int)} y]
  (when (or (== (len data) 0) (!= (aget data 0) 4))
    (return nil nil))

  ;; Use SetBytes to check that data encodes a valid point.
  (let [(values _ err) (.SetBytes ((.-newPoint curve)) data)]
    (when (!= err nil)
      (return nil nil))

    ;; We don't use pointToAffine because it involves an expensive field
    ;; inversion to convert from Jacobian to affine coordinates, which we
    ;; already have.
    (let [byteLen (/ (+ (.-BitSize (.-params curve)) 7) 8)]
      (set! x (.SetBytes (new big/Int) (subslice data 1 (+ 1 byteLen))))
      (set! y (.SetBytes (new big/Int) (subslice data (+ 1 byteLen))))
      (return x y))))


^{:go/end 254} (go/method UnmarshalCompressed [^{:tag (* (nistCurve Point))} curve ^{:tag (slice byte)} data] :results [^{:tag (* big/Int)} x ^:go/grouped ^{:tag (* big/Int)} y]
  (when (or (== (len data) 0) ^:go/paren (and (!= (aget data 0) 2) (!= (aget data 0) 3)))
    (return nil nil))

  (let [(values p err) (.SetBytes ((.-newPoint curve)) data)]
    (when (!= err nil)
      (return nil nil))

    (.pointToAffine curve p)))



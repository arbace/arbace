;; Package elliptic implements the standard NIST P-224, P-256, P-384, and P-521
;; elliptic curves over prime fields.
;;
;; Direct use of this package is deprecated, beyond the [P224], [P256], [P384],
;; and [P521] values necessary to use [crypto/ecdsa]. Most other uses
;; should migrate to the more efficient and safer [crypto/ecdh], or to
;; third-party modules for lower-level functionality.
(in-ns 'go.crypto.elliptic) (go/file "elliptic.go" :doc "Package elliptic implements the standard NIST P-224, P-256, P-384, and P-521\nelliptic curves over prime fields.\n\nDirect use of this package is deprecated, beyond the [P224], [P256], [P384],\nand [P521] values necessary to use [crypto/ecdsa]. Most other uses\nshould migrate to the more efficient and safer [crypto/ecdh], or to\nthird-party modules for lower-level functionality.\n" :imports [


    ^{:line 15} [io "io"]
    ^{:line 16} [big "math/big"]
    ^{:line 17} [sync "sync"]])













(go/type Curve "A Curve represents a short-form Weierstrass curve with a=-3.\n\nThe behavior of Add, Double, and ScalarMult when the input is not a point on\nthe curve is undefined.\n\nNote that the conventional point at infinity (0, 0) is not considered on the\ncurve, although it can be returned by Add, Double, ScalarMult, or\nScalarBaseMult (but not the [Unmarshal] or [UnmarshalCompressed] functions).\n\nUsing Curve implementations besides those returned by [P224], [P256], [P384],\nand [P521] is deprecated.\n" (interface

    (^{:doc "Params returns the parameters for the curve.\n"} Params ^{:tag (* CurveParams)} [])






    (^{:doc "IsOnCurve reports whether the given (x,y) lies on the curve.\n\nDeprecated: this is a low-level unsafe API. For ECDH, use the crypto/ecdh\npackage. The NewPublicKey methods of NIST curves in crypto/ecdh accept\nthe same encoding as the Unmarshal function, and perform on-curve checks.\n"} IsOnCurve ^bool [^{:tag (* big/Int)} x ^{:tag (* big/Int)} y])




    (^{:doc "Add returns the sum of (x1,y1) and (x2,y2).\n\nDeprecated: this is a low-level unsafe API.\n"} Add [^{:tag (* big/Int)} x1 ^{:tag (* big/Int)} y1 ^{:tag (* big/Int)} x2 ^{:tag (* big/Int)} y2] :results [^{:tag (* big/Int)} x ^{:tag (* big/Int)} y])




    (^{:doc "Double returns 2*(x,y).\n\nDeprecated: this is a low-level unsafe API.\n"} Double [^{:tag (* big/Int)} x1 ^{:tag (* big/Int)} y1] :results [^{:tag (* big/Int)} x ^{:tag (* big/Int)} y])






    (^{:doc "ScalarMult returns k*(x,y) where k is an integer in big-endian form.\n\nDeprecated: this is a low-level unsafe API. For ECDH, use the crypto/ecdh\npackage. Most uses of ScalarMult can be replaced by a call to the ECDH\nmethods of NIST curves in crypto/ecdh.\n"} ScalarMult [^{:tag (* big/Int)} x1 ^{:tag (* big/Int)} y1 ^{:tag (slice byte)} k] :results [^{:tag (* big/Int)} x ^{:tag (* big/Int)} y])







    (^{:doc "ScalarBaseMult returns k*G, where G is the base point of the group\nand k is an integer in big-endian form.\n\nDeprecated: this is a low-level unsafe API. For ECDH, use the crypto/ecdh\npackage. Most uses of ScalarBaseMult can be replaced by a call to the\nPrivateKey.PublicKey method in crypto/ecdh.\n"} ScalarBaseMult [^{:tag (slice byte)} k] :results [^{:tag (* big/Int)} x ^{:tag (* big/Int)} y])))


(go/var mask (lit (slice byte) 0xff 0x1 0x3 0x7 0xf 0x1f 0x3f 0x7f))






^{:go/end 101} (go/func GenerateKey "GenerateKey returns a public/private key pair. The private key is\ngenerated using the given reader, which must return random data.\n\nDeprecated: for ECDH, use the GenerateKey methods of the [crypto/ecdh] package;\nfor ECDSA, use the GenerateKey function of the crypto/ecdsa package.\n" [^Curve curve ^io/Reader rand] :results [^{:tag (slice byte)} priv ^{:tag (* big/Int)} x ^{:tag (* big/Int)} y ^error err]
  (let [N (.-N (.Params curve))
      ^{:line 77} bitSize (.BitLen N)
      ^{:line 78} byteLen (/ (+ bitSize 7) 8)]
    (set! priv (make (slice byte) byteLen))

    (while (== x nil)
      (set! (values _ err) (io/ReadFull rand priv))
      (when (!= err nil)
        (return))

      ;; We have to mask off any excess bits in the case that the size of the
      ;; underlying field is not a whole number of bytes.
      (set! (aget priv 0) bit-and (aget mask (% bitSize 8)))
      ;; This is because, in tests, rand will return all zeros and we don't
      ;; want to get the point at infinity and loop forever.
      (set! (aget priv 1) bit-xor 0x42)

      ;; If the scalar is out of range, sample another random number.
      (when (>= (.Cmp (.SetBytes (new big/Int) priv) N) 0)
        (continue))


      (set! (values x y) (.ScalarBaseMult curve priv)))

    (return)))








^{:go/end 121} (go/func Marshal "Marshal converts a point on the curve into the uncompressed form specified in\nSEC 1, Version 2.0, Section 2.3.3. If the point is not on the curve (or is\nthe conventional point at infinity), the behavior is undefined.\n\nDeprecated: for ECDH, use the crypto/ecdh package. This function returns an\nencoding equivalent to that of PublicKey.Bytes in crypto/ecdh.\n" ^{:tag (slice byte)} [^Curve curve ^{:tag (* big/Int)} x ^{:tag (* big/Int)} y]
  (panicIfNotOnCurve curve x y)

  (let [byteLen (/ (+ (.-BitSize (.Params curve)) 7) 8)

      ^{:line 114} ret (make (slice byte) (+ 1 (* 2 byteLen)))]
    (aset ret 0 4) ; uncompressed point

    (.FillBytes x (subslice ret 1 (+ 1 byteLen)))
    (.FillBytes y (subslice ret (+ 1 byteLen) (+ 1 (* 2 byteLen))))

    ^{:line 120} ret))





^{:go/end 133} (go/func MarshalCompressed "MarshalCompressed converts a point on the curve into the compressed form\nspecified in SEC 1, Version 2.0, Section 2.3.3. If the point is not on the\ncurve (or is the conventional point at infinity), the behavior is undefined.\n" ^{:tag (slice byte)} [^Curve curve ^{:tag (* big/Int)} x ^{:tag (* big/Int)} y]
  (panicIfNotOnCurve curve x y)
  (let [byteLen (/ (+ (.-BitSize (.Params curve)) 7) 8)
      ^{:line 129} compressed (make (slice byte) (+ 1 byteLen))]
    (aset compressed 0 (bit-or (conv byte (.Bit y 0)) 2))
    (.FillBytes x (subslice compressed 1))
    ^{:line 132} compressed))






(go/type unmarshaler "unmarshaler is implemented by curves with their own constant-time Unmarshal.\n\nThere isn't an equivalent interface for Marshal/MarshalCompressed because\nthat doesn't involve any mathematical operations, only FillBytes and Bit.\n" (interface
    (Unmarshal [(slice byte)] :results [^{:tag (* big/Int)} x ^{:tag (* big/Int)} y])
    (UnmarshalCompressed [(slice byte)] :results [^{:tag (* big/Int)} x ^{:tag (* big/Int)} y])))



(go/var ^{:doc "Assert that the known curves implement unmarshaler.\n"} _ (lit (slice unmarshaler) p224 p256 p384 p521))







^{:go/end 175} (go/func Unmarshal "Unmarshal converts a point, serialized by [Marshal], into an x, y pair. It is\nan error if the point is not in uncompressed form, is not on the curve, or is\nthe point at infinity. On error, x = nil.\n\nDeprecated: for ECDH, use the crypto/ecdh package. This function accepts an\nencoding equivalent to that of the NewPublicKey methods in crypto/ecdh.\n" [^Curve curve ^{:tag (slice byte)} data] :results [^{:tag (* big/Int)} x ^{:tag (* big/Int)} y]
  (when [(values c ok) (assert unmarshaler curve)] ok
    (return (.Unmarshal c data)))


  (let [byteLen (/ (+ (.-BitSize (.Params curve)) 7) 8)]
    (when (!= (len data) (+ 1 (* 2 byteLen)))
      (return nil nil))

    (when (!= (aget data 0) 4) ; uncompressed form
      (return nil nil))

    (let [p (.-P (.Params curve))]
      (set! x (.SetBytes (new big/Int) (subslice data 1 (+ 1 byteLen))))
      (set! y (.SetBytes (new big/Int) (subslice data (+ 1 byteLen))))
      (when (or (>= (.Cmp x p) 0) (>= (.Cmp y p) 0))
        (return nil nil))

      (when (not (.IsOnCurve curve x y))
        (return nil nil))

      (return))))





^{:go/end 210} (go/func UnmarshalCompressed "UnmarshalCompressed converts a point, serialized by [MarshalCompressed], into\nan x, y pair. It is an error if the point is not in compressed form, is not\non the curve, or is the point at infinity. On error, x = nil.\n" [^Curve curve ^{:tag (slice byte)} data] :results [^{:tag (* big/Int)} x ^{:tag (* big/Int)} y]
  (when [(values c ok) (assert unmarshaler curve)] ok
    (return (.UnmarshalCompressed c data)))


  (let [byteLen (/ (+ (.-BitSize (.Params curve)) 7) 8)]
    (when (!= (len data) (+ 1 byteLen))
      (return nil nil))

    (when (and (!= (aget data 0) 2) (!= (aget data 0) 3)) ; compressed form
      (return nil nil))

    (let [p (.-P (.Params curve))]
      (set! x (.SetBytes (new big/Int) (subslice data 1)))
      (when (>= (.Cmp x p) 0)
        (return nil nil))

      ;; y² = x³ - 3x + b
      (set! y (.polynomial (.Params curve) x))
      (set! y (.ModSqrt y y p))
      (when (== y nil)
        (return nil nil))

      (when (!= (conv byte (.Bit y 0)) (bit-and (aget data 0) 1))
        (.Mod (.Neg y y) y p))

      (when (not (.IsOnCurve curve x y))
        (return nil nil))

      (return))))


^{:go/end 222} (go/func panicIfNotOnCurve [^Curve curve ^{:tag (* big/Int)} x ^{:tag (* big/Int)} y]
  ;; (0, 0) is the point at infinity by convention. It's ok to operate on it,
  ;; although IsOnCurve is documented to return false for it. See Issue 37294.
  (when (and (== (.Sign x) 0) (== (.Sign y) 0))
    (return))


  (when (not (.IsOnCurve curve x y))
    (panic "crypto/elliptic: attempted operation on invalid point")))



(go/var ^sync/Once initonce)

^{:go/end 231} (go/func initAll []
  (initP224)
  (initP256)
  (initP384)
  (initP521))









^{:go/end 243} (go/func P224 "P224 returns a [Curve] which implements NIST P-224 (FIPS 186-3, section D.2.2),\nalso known as secp224r1. The CurveParams.Name of this [Curve] is \"P-224\".\n\nMultiple invocations of this function will return the same value, so it can\nbe used for equality checks and switch statements.\n\nThe cryptographic operations are implemented using constant-time algorithms.\n" ^Curve []
  (.Do initonce initAll)
  ^{:line 242} p224)











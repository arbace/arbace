;; Package ecdh implements Elliptic Curve Diffie-Hellman over
;; NIST curves and Curve25519.
(in-ns 'go.crypto.ecdh) (go/file "ecdh.go" :doc "Package ecdh implements Elliptic Curve Diffie-Hellman over\nNIST curves and Curve25519.\n" :imports [


    ^{:line 10} [crypto "crypto"]
    ^{:line 11} [boring "crypto/internal/boring"]
    ^{:line 12} [ecdh "crypto/internal/fips140/ecdh"]
    ^{:line 13} [subtle "crypto/subtle"]
    ^{:line 14} [errors "errors"]
    ^{:line 15} [io "io"]])


(go/type Curve (interface





    (^{:doc "GenerateKey generates a random PrivateKey.\n\nSince Go 1.26, a secure source of random bytes is always used, and rand\nis ignored unless GODEBUG=cryptocustomrand=1 is set. This setting will be\nremoved in a future Go release. Instead, use [testing/cryptotest.SetGlobalRandom].\n"} GenerateKey [^io/Reader rand] :results [(* PrivateKey) error])










    (^{:doc "NewPrivateKey checks that key is valid and returns a PrivateKey.\n\nFor NIST curves, this follows SEC 1, Version 2.0, Section 2.3.6, which\namounts to decoding the bytes as a fixed length big endian integer and\nchecking that the result is lower than the order of the curve. The zero\nprivate key is also rejected, as the encoding of the corresponding public\nkey would be irregular.\n\nFor X25519, this only checks the scalar length.\n"} NewPrivateKey [^{:tag (slice byte)} key] :results [(* PrivateKey) error])









    (^{:doc "NewPublicKey checks that key is valid and returns a PublicKey.\n\nFor NIST curves, this decodes an uncompressed point according to SEC 1,\nVersion 2.0, Section 2.3.4. Compressed encodings and the point at\ninfinity are rejected.\n\nFor X25519, this only checks the u-coordinate length. Adversarially\nselected public keys can cause ECDH to return an error.\n"} NewPublicKey [^{:tag (slice byte)} key] :results [(* PublicKey) error])






    (^{:doc "ecdh performs an ECDH exchange and returns the shared secret. It's exposed\nas the PrivateKey.ECDH method.\n\nThe private method also allow us to expand the ECDH interface with more\nmethods in the future without breaking backwards compatibility.\n"} ecdh [^{:tag (* PrivateKey)} local ^{:tag (* PublicKey)} remote] :results [(slice byte) error])))







(go/type PublicKey "PublicKey is an ECDH public key, usually a peer's ECDH share sent over the wire.\n\nThese keys can be parsed with [crypto/x509.ParsePKIXPublicKey] and encoded\nwith [crypto/x509.MarshalPKIXPublicKey]. For NIST curves, they then need to\nbe converted with [crypto/ecdsa.PublicKey.ECDH] after parsing.\n" (struct
    ^{:line 61 :tag Curve} curve
    ^{:line 62 :tag (slice byte)} publicKey
    ^{:line 63 :tag (* boring/PublicKeyECDH)} boring
    ^{:line 64 :tag (* ecdh/PublicKey)} fips))



^{:go/end 73} (go/method Bytes "Bytes returns a copy of the encoding of the public key.\n" ^{:tag (slice byte)} [^{:tag (* PublicKey)} k]
  ;; Copy the public key to a fixed size buffer that can get allocated on the
  ;; caller's stack after inlining.
  (let [^{:tag (array 133 byte)} buf (zero (array 133 byte))]
    (append (subslice buf _ 0) (spread (.-publicKey k)))))









^{:go/end 89} (go/method Equal "Equal returns whether x represents the same public key as k.\n\nNote that there can be equivalent public keys with different encodings which\nwould return false from this check but behave the same way as inputs to ECDH.\n\nThis check is performed in constant time as long as the key types and their\ncurve match.\n" ^bool [^{:tag (* PublicKey)} k ^crypto/PublicKey x]
  (let [(values xx ok) (assert (* PublicKey) x)]
    (when (not ok)
      (return false))

    (and (== (.-curve k) (.-curve xx))
      (== (subtle/ConstantTimeCompare (.-publicKey k) (.-publicKey xx)) 1))))


^{:go/end 93} (go/method Curve ^Curve [^{:tag (* PublicKey)} k]
  (.-curve k))






(go/type KeyExchanger "KeyExchanger is an interface for an opaque private key that can be used for\nkey exchange operations. For example, an ECDH key kept in a hardware module.\n\nIt is implemented by [PrivateKey].\n" (interface
    (PublicKey ^{:tag (* PublicKey)} [])
    (Curve ^Curve [])
    (ECDH [(* PublicKey)] :results [(slice byte) error])))


(go/var ^KeyExchanger _ (conv (* PrivateKey) nil))






(go/type PrivateKey "PrivateKey is an ECDH private key, usually kept secret.\n\nThese keys can be parsed with [crypto/x509.ParsePKCS8PrivateKey] and encoded\nwith [crypto/x509.MarshalPKCS8PrivateKey]. For NIST curves, they then need to\nbe converted with [crypto/ecdsa.PrivateKey.ECDH] after parsing.\n" (struct
    ^{:line 113 :tag Curve} curve
    ^{:line 114 :tag (slice byte)} privateKey
    ^{:line 115 :tag (* PublicKey)} publicKey
    ^{:line 116 :tag (* boring/PrivateKeyECDH)} boring
    ^{:line 117 :tag (* ecdh/PrivateKey)} fips))













^{:go/end 136} (go/method ECDH "ECDH performs an ECDH exchange and returns the shared secret. The [PrivateKey]\nand [PublicKey] must use the same curve.\n\nFor NIST curves, this performs ECDH as specified in SEC 1, Version 2.0,\nSection 3.3.1, and returns the x-coordinate encoded according to SEC 1,\nVersion 2.0, Section 2.3.5. The result is never the point at infinity.\nThis is also known as the Shared Secret Computation of the Ephemeral Unified\nModel scheme specified in NIST SP 800-56A Rev. 3, Section 6.1.2.2.\n\nFor [X25519], this performs ECDH as specified in RFC 7748, Section 6.1. If\nthe result is the all-zero value, ECDH returns an error.\n" [^{:tag (* PrivateKey)} k ^{:tag (* PublicKey)} remote] :results [(slice byte) error]
  (when (!= (.-curve k) (.-curve remote))
    (return nil (errors/New "crypto/ecdh: private key and public key curves do not match")))

  (.ecdh (.-curve k) k remote))



^{:go/end 144} (go/method Bytes "Bytes returns a copy of the encoding of the private key.\n" ^{:tag (slice byte)} [^{:tag (* PrivateKey)} k]
  ;; Copy the private key to a fixed size buffer that can get allocated on the
  ;; caller's stack after inlining.
  (let [^{:tag (array 66 byte)} buf (zero (array 66 byte))]
    (append (subslice buf _ 0) (spread (.-privateKey k)))))









^{:go/end 160} (go/method Equal "Equal returns whether x represents the same private key as k.\n\nNote that there can be equivalent private keys with different encodings which\nwould return false from this check but behave the same way as inputs to [ECDH].\n\nThis check is performed in constant time as long as the key types and their\ncurve match.\n" ^bool [^{:tag (* PrivateKey)} k ^crypto/PrivateKey x]
  (let [(values xx ok) (assert (* PrivateKey) x)]
    (when (not ok)
      (return false))

    (and (== (.-curve k) (.-curve xx))
      (== (subtle/ConstantTimeCompare (.-privateKey k) (.-privateKey xx)) 1))))


^{:go/end 164} (go/method Curve ^Curve [^{:tag (* PrivateKey)} k]
  (.-curve k))


^{:go/end 168} (go/method PublicKey ^{:tag (* PublicKey)} [^{:tag (* PrivateKey)} k]
  (.-publicKey k))




^{:go/end 174} (go/method Public "Public implements the implicit interface of all standard library private\nkeys. See the docs of [crypto.PrivateKey].\n" ^crypto/PublicKey [^{:tag (* PrivateKey)} k]
  (.PublicKey k))

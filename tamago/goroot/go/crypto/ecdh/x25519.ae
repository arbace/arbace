(in-ns 'go.crypto.ecdh) (go/file "x25519.go" :imports [


    ^{:line 8} [bytes "bytes"]
    ^{:line 9} [field "crypto/internal/fips140/edwards25519/field"]
    ^{:line 10} [fips140only "crypto/internal/fips140only"]
    ^{:line 11} [rand "crypto/internal/rand"]
    ^{:line 12} [errors "errors"]
    ^{:line 13} [io "io"]])


(go/var
  ^{:line 17} [x25519PublicKeySize 32]
  ^{:line 18} [x25519PrivateKeySize 32]
  ^{:line 19} [x25519SharedSecretSize 32])







^{:go/end 27} (go/func X25519 "X25519 returns a [Curve] which implements the X25519 function over Curve25519\n(RFC 7748, Section 5).\n\nMultiple invocations of this function will return the same value, so it can\nbe used for equality checks and switch statements.\n" ^Curve [] x25519)

(go/var x25519 (addr (lit x25519Curve)))

(go/type x25519Curve (struct))

^{:go/breaks [3] :go/end 35} (go/method String ^string [^{:tag (* x25519Curve)} c]
  "X25519")


^{:go/end 47} (go/method GenerateKey [^{:tag (* x25519Curve)} c ^io/Reader r] :results [(* PrivateKey) error]
  (when (fips140only/Enforced)
    (return nil (errors/New "crypto/ecdh: use of X25519 is not allowed in FIPS 140-only mode")))

  (set! r (rand/CustomReader r))
  (let [key (make (slice byte) x25519PrivateKeySize)]
    (when [(values _ err) (io/ReadFull r key)] (!= err nil)
      (return nil err))

    (.NewPrivateKey c key)))


^{:go/end 67} (go/method NewPrivateKey [^{:tag (* x25519Curve)} c ^{:tag (slice byte)} key] :results [(* PrivateKey) error]
  (when (fips140only/Enforced)
    (return nil (errors/New "crypto/ecdh: use of X25519 is not allowed in FIPS 140-only mode")))

  (when (!= (len key) x25519PrivateKeySize)
    (return nil (errors/New "crypto/ecdh: invalid private key size")))

  (let [publicKey (make (slice byte) x25519PublicKeySize)
      ^{:line 57} x25519Basepoint (lit (array 32 byte) 9)]
    (x25519ScalarMult publicKey key (subslice x25519Basepoint))
    ;; We don't check for the all-zero public key here because the scalar is
    ;; never zero because of clamping, and the basepoint is not the identity in
    ;; the prime-order subgroup(s).
    ^{:go/breaks [2]} (return (addr ^{:go/breaks [2 4 6]} (lit PrivateKey
          :curve c
          :privateKey (bytes/Clone key)
          :publicKey (addr (lit PublicKey :curve c :publicKey publicKey))))
      nil)))


^{:go/end 80} (go/method NewPublicKey [^{:tag (* x25519Curve)} c ^{:tag (slice byte)} key] :results [(* PublicKey) error]
  (when (fips140only/Enforced)
    (return nil (errors/New "crypto/ecdh: use of X25519 is not allowed in FIPS 140-only mode")))

  (when (!= (len key) x25519PublicKeySize)
    (return nil (errors/New "crypto/ecdh: invalid public key")))

  ^{:go/breaks [2]} (return (addr ^{:go/breaks [2 4]} (lit PublicKey
        :curve c
        :publicKey (bytes/Clone key)))
    nil))


^{:go/end 89} (go/method ecdh [^{:tag (* x25519Curve)} c ^{:tag (* PrivateKey)} local ^{:tag (* PublicKey)} remote] :results [(slice byte) error]
  (let [out (make (slice byte) x25519SharedSecretSize)]
    (x25519ScalarMult out (.-privateKey local) (.-publicKey remote))
    (when (isZero out)
      (return nil (errors/New "crypto/ecdh: bad X25519 remote ECDH input: low order point")))

    (return out nil)))


^{:go/end 141} (go/func x25519ScalarMult [^{:tag (slice byte)} dst ^{:tag (slice byte)} scalar ^{:tag (slice byte)} point]
  (let [^{:tag (array 32 byte)} e (zero (array 32 byte))]

    (copy (subslice e) (subslice scalar))
    (set! (aget e 0) bit-and 248)
    (set! (aget e 31) bit-and 127)
    (set! (aget e 31) bit-or 64)

    (let [(values ^field/Element x1 ^field/Element x2 ^field/Element z2 ^field/Element x3 ^field/Element z3 ^field/Element tmp0 ^field/Element tmp1) (zero field/Element)]
      (.SetBytes x1 (subslice point))
      (.One x2)
      (.Set x3 (addr x1))
      (.One z3)

      (let [swap 0]
        (for [pos 254] (>= pos 0) (dec! pos)
          (let [b (>> (aget e (/ pos 8)) (conv uint (bit-and pos 7)))]
            (set! b bit-and 1)
            (set! swap bit-xor (conv int b))
            (.Swap x2 (addr x3) swap)
            (.Swap z2 (addr z3) swap)
            (set! swap (conv int b))

            (.Subtract tmp0 (addr x3) (addr z3))
            (.Subtract tmp1 (addr x2) (addr z2))
            (.Add x2 (addr x2) (addr z2))
            (.Add z2 (addr x3) (addr z3))
            (.Multiply z3 (addr tmp0) (addr x2))
            (.Multiply z2 (addr z2) (addr tmp1))
            (.Square tmp0 (addr tmp1))
            (.Square tmp1 (addr x2))
            (.Add x3 (addr z3) (addr z2))
            (.Subtract z2 (addr z3) (addr z2))
            (.Multiply x2 (addr tmp1) (addr tmp0))
            (.Subtract tmp1 (addr tmp1) (addr tmp0))
            (.Square z2 (addr z2))

            (.Mult32 z3 (addr tmp1) 121666)
            (.Square x3 (addr x3))
            (.Add tmp0 (addr tmp0) (addr z3))
            (.Multiply z3 (addr x1) (addr z2))
            (.Multiply z2 (addr tmp1) (addr tmp0))))


        (.Swap x2 (addr x3) swap)
        (.Swap z2 (addr z3) swap)

        (.Invert z2 (addr z2))
        (.Multiply x2 (addr x2) (addr z2))
        (copy (subslice dst) (.Bytes x2))))))



^{:go/end 150} (go/func isZero "isZero reports whether x is all zeroes in constant time.\n" ^bool [^{:tag (slice byte)} x]
  (let [^byte acc (zero byte)]
    (range [_ b x]
      (set! acc bit-or b))

    (== acc 0)))

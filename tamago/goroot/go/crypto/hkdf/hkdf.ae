;; Package hkdf implements the HMAC-based Extract-and-Expand Key Derivation
;; Function (HKDF) as defined in RFC 5869.
;;
;; HKDF is a cryptographic key derivation function (KDF) with the goal of
;; expanding limited input keying material into one or more cryptographically
;; strong secret keys.
(in-ns 'go.crypto.hkdf) (go/file "hkdf.go" :doc "Package hkdf implements the HMAC-based Extract-and-Expand Key Derivation\nFunction (HKDF) as defined in RFC 5869.\n\nHKDF is a cryptographic key derivation function (KDF) with the goal of\nexpanding limited input keying material into one or more cryptographically\nstrong secret keys.\n" :imports [


    ^{:line 14} [hkdf "crypto/internal/fips140/hkdf"]
    ^{:line 15} [fips140hash "crypto/internal/fips140hash"]
    ^{:line 16} [fips140only "crypto/internal/fips140only"]
    ^{:line 17} [errors "errors"]
    ^{:line 18} [hash "hash"]])








^{:go/end 33} (go/func Extract "Extract generates a pseudorandom key for use with [Expand] from an input\nsecret and an optional independent salt.\n\nOnly use this function if you need to reuse the extracted key with multiple\nExpand invocations and different context values. Most common scenarios,\nincluding the generation of multiple keys, should use [Key] instead.\n" :type-params [^hash/Hash H] [^{:tag (func [] [H])} h ^{:tag (slice byte)} secret ^:go/grouped ^{:tag (slice byte)} salt] :results [(slice byte) error]
  (let [fh (^{:inst [H]} fips140hash/UnwrapNew h)]
    (when [err (^{:inst [hash/Hash]} checkFIPS140Only fh secret)] (!= err nil)
      (return nil err))

    (return (^{:inst [hash/Hash]} hkdf/Extract fh secret salt) nil)))









^{:go/end 54} (go/func Expand "Expand derives a key from the given hash, key, and optional context info,\nreturning a []byte of length keyLength that can be used as cryptographic key.\nThe extraction step is skipped.\n\nThe key should have been generated by [Extract], or be a uniformly\nrandom or pseudorandom cryptographically strong key. See RFC 5869, Section\n3.3. Most common scenarios will want to use [Key] instead.\n" :type-params [^hash/Hash H] [^{:tag (func [] [H])} h ^{:tag (slice byte)} pseudorandomKey ^string info ^int keyLength] :results [(slice byte) error]
  (let [fh (^{:inst [H]} fips140hash/UnwrapNew h)]
    (when [err (^{:inst [hash/Hash]} checkFIPS140Only fh pseudorandomKey)] (!= err nil)
      (return nil err))


    (let [limit (* (.Size (fh)) 255)]
      (when (> keyLength limit)
        (return nil (errors/New "hkdf: requested key length too large")))


      (return (^{:inst [hash/Hash]} hkdf/Expand fh pseudorandomKey info keyLength) nil))))





^{:go/end 71} (go/func Key "Key derives a key from the given hash, secret, salt and context info,\nreturning a []byte of length keyLength that can be used as cryptographic key.\nSalt and info can be nil.\n" :type-params [^hash/Hash Hash] [^{:tag (func [] [Hash])} h ^{:tag (slice byte)} secret ^:go/grouped ^{:tag (slice byte)} salt ^string info ^int keyLength] :results [(slice byte) error]
  (let [fh (^{:inst [Hash]} fips140hash/UnwrapNew h)]
    (when [err (^{:inst [hash/Hash]} checkFIPS140Only fh secret)] (!= err nil)
      (return nil err))


    (let [limit (* (.Size (fh)) 255)]
      (when (> keyLength limit)
        (return nil (errors/New "hkdf: requested key length too large")))


      (return (^{:inst [hash/Hash]} hkdf/Key fh secret salt info keyLength) nil))))


^{:go/breaks [[8 83]] :go/end 84} (go/func checkFIPS140Only :type-params [^hash/Hash Hash] ^error [^{:tag (func [] [Hash])} h ^{:tag (slice byte)} key]
  (when (not (fips140only/Enforced))
    (return nil))

  (when (< (len key) (/ 112 8))
    (return (errors/New "crypto/hkdf: use of keys shorter than 112 bits is not allowed in FIPS 140-only mode")))

  (when (not (fips140only/ApprovedHash (h)))
    (return (errors/New "crypto/hkdf: use of hash functions other than SHA-2 or SHA-3 is not allowed in FIPS 140-only mode")))

  nil)

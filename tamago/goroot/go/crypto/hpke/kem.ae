(go/var dhKEMP256 (addr (lit dhKEM (HKDFSHA256) 0x0010 (ecdh/P256) 32 32 65)))
(go/var dhKEMP384 (addr (lit dhKEM (HKDFSHA384) 0x0011 (ecdh/P384) 48 48 97)))
(go/var dhKEMP521 (addr (lit dhKEM (HKDFSHA512) 0x0012 (ecdh/P521) 64 66 133)))
(go/var dhKEMX25519 (addr (lit dhKEM (HKDFSHA256) 0x0020 (ecdh/X25519) 32 32 32)))









^{:go/end 163} (go/func DHKEM "DHKEM returns a KEM implementing one of\n\n  - DHKEM(P-256, HKDF-SHA256)\n  - DHKEM(P-384, HKDF-SHA384)\n  - DHKEM(P-521, HKDF-SHA512)\n  - DHKEM(X25519, HKDF-SHA256)\n\ndepending on curve.\n" ^KEM [^ecdh/Curve curve]
  (switch curve
    (case [(ecdh/P256)]
      (return dhKEMP256))
    (case [(ecdh/P384)]
      (return dhKEMP384))
    (case [(ecdh/P521)]
      (return dhKEMP521))
    (case [(ecdh/X25519)]
      (return dhKEMX25519))
    (default
      ;; The set of ecdh.Curve implementations is closed, because the
      ;; interface has unexported methods. Therefore, this default case is
      ;; only hit if a new curve is added that DHKEM doesn't support.
      (return (lit unsupportedCurveKEM)))))




^{:go/end 335} (go/method DeriveKeyPair [^{:tag (* dhKEM)} kem ^{:tag (slice byte)} ikm] :results [PrivateKey error]
  ;; DeriveKeyPair from RFC 9180 Section 7.1.3.
  (let [suiteID (byteorder/BEAppendUint16 (conv (slice byte) "KEM") (.-id kem))
      (values prk err) (.labeledExtract (.-kdf kem) suiteID nil "dkp_prk" ikm)]
    (when (!= err nil)
      (return nil err))

    (when (== kem dhKEMX25519)
      (let [(values s err) (.labeledExpand (.-kdf kem) suiteID prk "sk" nil (.-Nsk kem))]
        (when (!= err nil)
          (return nil err))

        (return (.NewPrivateKey kem s))))

    (let [^uint8 counter (zero uint8)]
      (while (< counter 4)
        (let [(values s err) (.labeledExpand (.-kdf kem) suiteID prk "candidate" (lit (slice byte) counter) (.-Nsk kem))]
          (when (!= err nil)
            (return nil err))

          (when (== kem dhKEMP521)
            (set! (aget s 0) bit-and 0x01))

          (let [(values r ^:assign err) (.NewPrivateKey kem s)]
            (when (!= err nil)
              (inc! counter)
              (continue))

            (return r nil))))

      (panic "chance of four rejections is < 2^-128"))))


^{:go/end 339} (go/method KEM ^KEM [^{:tag (* dhKEMPrivateKey)} k]

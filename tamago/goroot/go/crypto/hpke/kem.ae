(go/type KEM "A KEM is a Key Encapsulation Mechanism, one of the three components of an\nHPKE ciphersuite.\n" (interface

    (^{:doc "ID returns the HPKE KEM identifier.\n"} ID ^uint16 [])


    (^{:doc "GenerateKey generates a new key pair.\n"} GenerateKey [] :results [PrivateKey error])




    (^{:doc "NewPublicKey deserializes a public key from bytes.\n\nIt implements DeserializePublicKey, as defined in RFC 9180.\n"} NewPublicKey [(slice byte)] :results [PublicKey error])




    (^{:doc "NewPrivateKey deserializes a private key from bytes.\n\nIt implements DeserializePrivateKey, as defined in RFC 9180.\n"} NewPrivateKey [(slice byte)] :results [PrivateKey error])




    (^{:doc "DeriveKeyPair derives a key pair from the given input keying material.\n\nIt implements DeriveKeyPair, as defined in RFC 9180.\n"} DeriveKeyPair [^{:tag (slice byte)} ikm] :results [PrivateKey error])

    (encSize ^int [])))






^{:go/end 69} (go/func NewKEM "NewKEM returns the KEM implementation for the given KEM ID.\n\nApplications are encouraged to use specific implementations like [DHKEM] or\n[MLKEM768X25519] instead, unless runtime agility is required.\n" [^uint16 id] :results [KEM error]
  (switch id
    (case [0x0010] ; DHKEM(P-256, HKDF-SHA256)
      (return (DHKEM (ecdh/P256)) nil))
    (case [0x0011] ; DHKEM(P-384, HKDF-SHA384)
      (return (DHKEM (ecdh/P384)) nil))
    (case [0x0012] ; DHKEM(P-521, HKDF-SHA512)
      (return (DHKEM (ecdh/P521)) nil))
    (case [0x0020] ; DHKEM(X25519, HKDF-SHA256)
      (return (DHKEM (ecdh/X25519)) nil))
    (case [0x0041] ; ML-KEM-768
      (return (MLKEM768) nil))
    (case [0x0042] ; ML-KEM-1024
      (return (MLKEM1024) nil))
    (case [0x647a] ; MLKEM768-X25519
      (return (MLKEM768X25519) nil))
    (case [0x0050] ; MLKEM768-P256
      (return (MLKEM768P256) nil))
    (case [0x0051] ; MLKEM1024-P384
      (return (MLKEM1024P384) nil))
    (default
      (return nil (errors/New "unsupported KEM")))))








(go/type PublicKey "A PublicKey is an instantiation of a KEM (one of the three components of an\nHPKE ciphersuite) with an encapsulation key (i.e. the public key).\n\nA PublicKey is usually obtained from a method of the corresponding [KEM] or\n[PrivateKey], such as [KEM.NewPublicKey] or [PrivateKey.PublicKey].\n" (interface

    (^{:doc "KEM returns the instantiated KEM.\n"} KEM ^KEM [])


    (^{:doc "Bytes returns the public key as the output of SerializePublicKey.\n"} Bytes ^{:tag (slice byte)} [])

    (encap [] :results [^{:tag (slice byte)} sharedSecret ^{:tag (slice byte)} enc ^error err])))







(go/type PrivateKey "A PrivateKey is an instantiation of a KEM (one of the three components of\nan HPKE ciphersuite) with a decapsulation key (i.e. the secret key).\n\nA PrivateKey is usually obtained from a method of the corresponding [KEM],\nsuch as [KEM.GenerateKey] or [KEM.NewPrivateKey].\n" (interface

    (^{:doc "KEM returns the instantiated KEM.\n"} KEM ^KEM [])






    (^{:doc "Bytes returns the private key as the output of SerializePrivateKey, as\ndefined in RFC 9180.\n\nNote that for X25519 this might not match the input to NewPrivateKey.\nThis is a requirement of RFC 9180, Section 7.1.2.\n"} Bytes [] :results [(slice byte) error])


    (^{:doc "PublicKey returns the corresponding PublicKey.\n"} PublicKey ^PublicKey [])

    (decap [^{:tag (slice byte)} enc] :results [^{:tag (slice byte)} sharedSecret ^error err])))



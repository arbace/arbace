(go/var ^{:tag (func [] [(* ecdh/PrivateKey)]) :doc "testingOnlyGenerateKey is only used during testing, to provide\na fixed test key to use when checking the RFC 9180 vectors.\n"} testingOnlyGenerateKey)

^{:go/end 256} (go/method encap [^{:tag (* dhKEMPublicKey)} pk] :results [^{:tag (slice byte)} sharedSecret ^{:tag (slice byte)} encapPub ^error err]
  (let [(values privEph ^:assign err) (.GenerateKey (.Curve (.-pub pk)) rand/Reader)]
    (when (!= err nil)
      (return nil nil err))

    (when (!= testingOnlyGenerateKey nil)
      (set! privEph (testingOnlyGenerateKey)))

    (let [(values dhVal ^:assign err) (.ECDH privEph (.-pub pk))]
      (when (!= err nil)
        (return nil nil err))

      (let [encPubEph (.Bytes (.PublicKey privEph))

          ^{:line 249} encPubRecip (.Bytes (.-pub pk))
          ^{:line 250} kemContext (append encPubEph (spread encPubRecip))]
        (set! (values sharedSecret err) (.extractAndExpand (.-kem pk) dhVal kemContext))
        (when (!= err nil)
          (return nil nil err))

        (return sharedSecret encPubEph nil)))))



^{:go/end 124} (go/method extractAndExpand [^{:tag (* dhKEM)} kem ^{:tag (slice byte)} dhKey ^{:tag (slice byte)} kemContext] :results [(slice byte) error]
  (let [suiteID (byteorder/BEAppendUint16 (conv (slice byte) "KEM") (.-id kem))
      (values eaePRK err) (.labeledExtract (.-kdf kem) suiteID nil "eae_prk" dhKey)]

(in-ns 'go.crypto.hpke) (go/file "aead_fips140v1.26.go" :build ["//go:build !fips140v1.0"] :imports [


    ^{:line 10} [cipher "crypto/cipher"]
    ^{:line 11} [aes "crypto/internal/fips140/aes"]
    ^{:line 12} [gcm "crypto/internal/fips140/aes/gcm"]])


^{:go/end 21} (go/func newAESGCM [^{:tag (slice byte)} key] :results [cipher/AEAD error]
  (let [(values b err) (aes/New key)]
    (when (!= err nil)
      (return nil err))

    (gcm/NewGCMForHPKE b)))

(in-ns 'go.crypto.hpke) (go/file "kdf.go" :imports [


    ^{:line 8} [hkdf "crypto/hkdf"]
    ^{:line 9} [sha256 "crypto/sha256"]
    ^{:line 10} [sha3 "crypto/sha3"]
    ^{:line 11} [sha512 "crypto/sha512"]
    ^{:line 12} [errors "errors"]
    ^{:line 13} [fmt "fmt"]
    ^{:line 14} [hash "hash"]
    ^{:line 15} [byteorder "internal/byteorder"]])




(go/type KDF "The KDF is one of the three components of an HPKE ciphersuite, implementing\nkey derivation.\n" (interface
    (ID ^uint16 [])
    (oneStage ^bool [])
    (size ^int []) ; Nh
    (labeledDerive [^{:tag (slice byte)} suiteID ^{:tag (slice byte)} inputKey ^string label ^{:tag (slice byte)} context ^uint16 length] :results [(slice byte) error])
    (labeledExtract [^{:tag (slice byte)} suiteID ^{:tag (slice byte)} salt ^string label ^{:tag (slice byte)} inputKey] :results [(slice byte) error])
    (labeledExpand [^{:tag (slice byte)} suiteID ^{:tag (slice byte)} randomKey ^string label ^{:tag (slice byte)} info ^uint16 length] :results [(slice byte) error])))






^{:go/end 48} (go/func NewKDF "NewKDF returns the KDF implementation for the given KDF ID.\n\nApplications are encouraged to use specific implementations like [HKDFSHA256]\ninstead, unless runtime agility is required.\n" [^uint16 id] :results [KDF error]
  (switch id
    (case [0x0001] ; HKDF-SHA256
      (return (HKDFSHA256) nil))
    (case [0x0002] ; HKDF-SHA384
      (return (HKDFSHA384) nil))
    (case [0x0003] ; HKDF-SHA512
      (return (HKDFSHA512) nil))
    (case [0x0010] ; SHAKE128
      (return (SHAKE128) nil))
    (case [0x0011] ; SHAKE256
      (return (SHAKE256) nil))
    (default
      (return nil (fmt/Errorf "unsupported KDF %04x" id)))))




^{:go/end 51} (go/func HKDFSHA256 "HKDFSHA256 returns an HKDF-SHA256 KDF implementation.\n" ^KDF [] hkdfSHA256)


^{:go/end 54} (go/func HKDFSHA384 "HKDFSHA384 returns an HKDF-SHA384 KDF implementation.\n" ^KDF [] hkdfSHA384)


^{:go/end 57} (go/func HKDFSHA512 "HKDFSHA512 returns an HKDF-SHA512 KDF implementation.\n" ^KDF [] hkdfSHA512)

(go/type hkdfKDF (struct
    ^{:line 60 :tag (func [] [hash/Hash])} hash
    ^{:line 61 :tag uint16} id
    ^{:line 62 :tag int} nH))


(go/var hkdfSHA256 (addr (lit hkdfKDF :hash sha256/New :id 0x0001 :nH sha256/Size)))
(go/var hkdfSHA384 (addr (lit hkdfKDF :hash sha512/New384 :id 0x0002 :nH sha512/Size384)))
(go/var hkdfSHA512 (addr (lit hkdfKDF :hash sha512/New :id 0x0003 :nH sha512/Size)))

^{:go/end 71} (go/method ID ^uint16 [^{:tag (* hkdfKDF)} kdf]
  (.-id kdf))


^{:go/end 75} (go/method size ^int [^{:tag (* hkdfKDF)} kdf]
  (.-nH kdf))


^{:go/breaks [3] :go/end 79} (go/method oneStage ^bool [^{:tag (* hkdfKDF)} kdf]
  false)


^{:go/end 83} (go/method labeledDerive [^{:tag (* hkdfKDF)} kdf ^{:tag (slice byte)} _ ^{:tag (slice byte)} _ ^string _ ^{:tag (slice byte)} _ ^uint16 _] :results [(slice byte) error]
  (return nil (errors/New "hpke: internal error: labeledDerive called on two-stage KDF")))


^{:go/end 92} (go/method labeledExtract [^{:tag (* hkdfKDF)} kdf ^{:tag (slice byte)} suiteID ^{:tag (slice byte)} salt ^string label ^{:tag (slice byte)} inputKey] :results [(slice byte) error]
  (let [labeledIKM (make (slice byte) 0 (+ 7 (len suiteID) (len label) (len inputKey)))]
    (set! labeledIKM (append labeledIKM (spread (conv (slice byte) "HPKE-v1"))))
    (set! labeledIKM (append labeledIKM (spread suiteID)))
    (set! labeledIKM (append labeledIKM (spread label)))
    (set! labeledIKM (append labeledIKM (spread inputKey)))
    (^{:inst [hash/Hash]} hkdf/Extract (.-hash kdf) labeledIKM salt)))


^{:go/end 102} (go/method labeledExpand [^{:tag (* hkdfKDF)} kdf ^{:tag (slice byte)} suiteID ^{:tag (slice byte)} randomKey ^string label ^{:tag (slice byte)} info ^uint16 length] :results [(slice byte) error]
  (let [labeledInfo (make (slice byte) 0 (+ 2 7 (len suiteID) (len label) (len info)))]
    (set! labeledInfo (byteorder/BEAppendUint16 labeledInfo length))
    (set! labeledInfo (append labeledInfo (spread (conv (slice byte) "HPKE-v1"))))
    (set! labeledInfo (append labeledInfo (spread suiteID)))
    (set! labeledInfo (append labeledInfo (spread label)))
    (set! labeledInfo (append labeledInfo (spread info)))
    (^{:inst [hash/Hash]} hkdf/Expand (.-hash kdf) randomKey (conv string labeledInfo) (conv int length))))



^{:go/end 107} (go/func SHAKE128 "SHAKE128 returns a SHAKE128 KDF implementation.\n" ^KDF []
  ^{:line 106} shake128KDF)



^{:go/end 112} (go/func SHAKE256 "SHAKE256 returns a SHAKE256 KDF implementation.\n" ^KDF []
  ^{:line 111} shake256KDF)


(go/type shakeKDF (struct
    ^{:line 115 :tag (func [] [(* sha3/SHAKE)])} hash
    ^{:line 116 :tag uint16} id
    ^{:line 117 :tag int} nH))


(go/var shake128KDF (addr (lit shakeKDF :hash sha3/NewSHAKE128 :id 0x0010 :nH 32)))
(go/var shake256KDF (addr (lit shakeKDF :hash sha3/NewSHAKE256 :id 0x0011 :nH 64)))

^{:go/end 125} (go/method ID ^uint16 [^{:tag (* shakeKDF)} kdf]
  (.-id kdf))


^{:go/end 129} (go/method size ^int [^{:tag (* shakeKDF)} kdf]
  (.-nH kdf))


^{:go/breaks [3] :go/end 133} (go/method oneStage ^bool [^{:tag (* shakeKDF)} kdf]
  true)


^{:go/end 147} (go/method labeledDerive [^{:tag (* shakeKDF)} kdf ^{:tag (slice byte)} suiteID ^{:tag (slice byte)} inputKey ^string label ^{:tag (slice byte)} context ^uint16 length] :results [(slice byte) error]
  (let [H ((.-hash kdf))]
    (.Write H inputKey)
    (.Write H (conv (slice byte) "HPKE-v1"))
    (.Write H suiteID)
    (.Write H (lit (slice byte) (conv byte (>> (len label) 8)) (conv byte (len label))))
    (.Write H (conv (slice byte) label))
    (.Write H (lit (slice byte) (conv byte (>> length 8)) (conv byte length)))
    (.Write H context)
    (let [out (make (slice byte) length)]
      (.Read H out)
      (return out nil))))


^{:go/end 151} (go/method labeledExtract [^{:tag (* shakeKDF)} kdf ^{:tag (slice byte)} _ ^{:tag (slice byte)} _ ^string _ ^{:tag (slice byte)} _] :results [(slice byte) error]
  (return nil (errors/New "hpke: internal error: labeledExtract called on one-stage KDF")))


^{:go/end 155} (go/method labeledExpand [^{:tag (* shakeKDF)} kdf ^{:tag (slice byte)} _ ^{:tag (slice byte)} _ ^string _ ^{:tag (slice byte)} _ ^uint16 _] :results [(slice byte) error]
  (return nil (errors/New "hpke: internal error: labeledExpand called on one-stage KDF")))

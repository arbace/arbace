(in-ns 'go.crypto.hpke) (go/file "aead.go" :imports [


    ^{:line 8} [cipher "crypto/cipher"]
    ^{:line 9} [errors "errors"]
    ^{:line 10} [fmt "fmt"]

    ^{:line 12} [chacha20poly1305 "golang.org/x/crypto/chacha20poly1305"]])




(go/type AEAD "The AEAD is one of the three components of an HPKE ciphersuite, implementing\nsymmetric encryption.\n" (interface
    (ID ^uint16 [])
    (keySize ^int [])
    (nonceSize ^int [])
    (aead [^{:tag (slice byte)} key] :results [cipher/AEAD error])))






^{:go/end 41} (go/func NewAEAD "NewAEAD returns the AEAD implementation for the given AEAD ID.\n\nApplications are encouraged to use specific implementations like [AES128GCM]\nor [ChaCha20Poly1305] instead, unless runtime agility is required.\n" [^uint16 id] :results [AEAD error]
  (switch id
    (case [0x0001] ; AES-128-GCM
      (return (AES128GCM) nil))
    (case [0x0002] ; AES-256-GCM
      (return (AES256GCM) nil))
    (case [0x0003] ; ChaCha20Poly1305
      (return (ChaCha20Poly1305) nil))
    (case [0xFFFF] ; Export-only
      (return (ExportOnly) nil))
    (default
      (return nil (fmt/Errorf "unsupported AEAD %04x" id)))))




^{:go/end 44} (go/func AES128GCM "AES128GCM returns an AES-128-GCM AEAD implementation.\n" ^AEAD [] aes128GCM)


^{:go/end 47} (go/func AES256GCM "AES256GCM returns an AES-256-GCM AEAD implementation.\n" ^AEAD [] aes256GCM)


^{:go/end 50} (go/func ChaCha20Poly1305 "ChaCha20Poly1305 returns a ChaCha20Poly1305 AEAD implementation.\n" ^AEAD [] chacha20poly1305AEAD)





^{:go/end 56} (go/func ExportOnly "ExportOnly returns a placeholder AEAD implementation that cannot encrypt or\ndecrypt, but only export secrets with [Sender.Export] or [Recipient.Export].\n\nWhen this is used, [Sender.Seal] and [Recipient.Open] return errors.\n" ^AEAD [] (lit exportOnlyAEAD))

(go/type aead (struct
    ^{:line 59 :tag int} nK
    ^{:line 60 :tag int} nN
    ^{:line 61 :tag (func [(slice byte)] [cipher/AEAD error])} new
    ^{:line 62 :tag uint16} id))


(go/var aes128GCM (addr ^{:go/breaks [2 4 6 8]} (lit aead
      :nK (/ 128 8)
      :nN (/ 96 8)
      :new newAESGCM
      :id 0x0001)))


(go/var aes256GCM (addr ^{:go/breaks [2 4 6 8]} (lit aead
      :nK (/ 256 8)
      :nN (/ 96 8)
      :new newAESGCM
      :id 0x0002)))


(go/var chacha20poly1305AEAD (addr ^{:go/breaks [2 4 6 8]} (lit aead
      :nK chacha20poly1305/KeySize
      :nN chacha20poly1305/NonceSize
      :new chacha20poly1305/New
      :id 0x0003)))


^{:go/end 88} (go/method ID ^uint16 [^{:tag (* aead)} a]
  (.-id a))


^{:go/end 95} (go/method aead [^{:tag (* aead)} a ^{:tag (slice byte)} key] :results [cipher/AEAD error]
  (when (!= (len key) (.-nK a))
    (return nil (errors/New "invalid key size")))

  ((.-new a) key))


^{:go/end 99} (go/method keySize ^int [^{:tag (* aead)} a]
  (.-nK a))


^{:go/end 103} (go/method nonceSize ^int [^{:tag (* aead)} a]
  (.-nN a))


(go/type exportOnlyAEAD (struct))

^{:go/breaks [3] :go/end 109} (go/method ID ^uint16 [exportOnlyAEAD]
  0xFFFF)


^{:go/end 113} (go/method aead [exportOnlyAEAD ^{:tag (slice byte)} key] :results [cipher/AEAD error]
  (return nil nil))


^{:go/breaks [3] :go/end 117} (go/method keySize ^int [exportOnlyAEAD]
  0)


^{:go/breaks [3] :go/end 121} (go/method nonceSize ^int [exportOnlyAEAD]
  0)

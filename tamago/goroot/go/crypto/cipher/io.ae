(in-ns 'go.crypto.cipher) (go/file "io.go" :imports [

    ^{:line 7} [io "io"]])

;; The Stream* objects are so simple that all their members are public. Users
;; can create them themselves.



(go/type StreamReader "StreamReader wraps a [Stream] into an [io.Reader]. It calls XORKeyStream\nto process each slice of data which passes through.\n" (struct
    ^{:line 15 :tag Stream} S
    ^{:line 16 :tag io/Reader} R))


^{:go/end 23} (go/method Read [^StreamReader r ^{:tag (slice byte)} dst] :results [^int n ^error err]
  (set! (values n err) (.Read (.-R r) dst))
  (.XORKeyStream (.-S r) (subslice dst _ n) (subslice dst _ n))
  (return))







(go/type StreamWriter "StreamWriter wraps a [Stream] into an io.Writer. It calls XORKeyStream\nto process each slice of data which passes through. If any [StreamWriter.Write]\ncall returns short then the StreamWriter is out of sync and must be discarded.\nA StreamWriter has no internal buffering; [StreamWriter.Close] does not need\nto be called to flush write data.\n" (struct
    ^{:line 31 :tag Stream} S
    ^{:line 32 :tag io/Writer} W
    ^{:line 33 :tag error} Err)) ; unused


^{:go/end 44} (go/method Write [^StreamWriter w ^{:tag (slice byte)} src] :results [^int n ^error err]
  (let [c (make (slice byte) (len src))]
    (.XORKeyStream (.-S w) c src)
    (set! (values n err) (.Write (.-W w) c))
    (when (and (!= n (len src)) (== err nil)) ; should never happen
      (set! err io/ErrShortWrite))

    (return)))




^{:go/breaks [[5 52]] :go/end 53} (go/method Close "Close closes the underlying Writer and returns its Close return value, if the Writer\nis also an io.Closer. Otherwise it returns nil.\n" ^error [^StreamWriter w]
  (when [(values c ok) (assert io/Closer (.-W w))] ok
    (return (.Close c)))

  nil)

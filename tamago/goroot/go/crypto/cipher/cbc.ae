;; Cipher block chaining (CBC) mode.

;; CBC provides confidentiality by xoring (chaining) each plaintext block
;; with the previous ciphertext block before applying the block cipher.

;; See NIST SP 800-38A, pp 10-11

(in-ns 'go.crypto.cipher) (go/file "cbc.go" :imports [


    ^{:line 15} [bytes "bytes"]
    ^{:line 16} [aes "crypto/internal/fips140/aes"]
    ^{:line 17} [alias "crypto/internal/fips140/alias"]
    ^{:line 18} [fips140only "crypto/internal/fips140only"]
    ^{:line 19} [subtle "crypto/subtle"]])


(go/type cbc (struct
    ^{:line 23 :tag Block} b
    ^{:line 24 :tag int} blockSize
    ^{:line 25 :tag (slice byte)} iv
    ^{:line 26 :tag (slice byte)} tmp))


^{:go/end 36} (go/func newCBC ^{:tag (* cbc)} [^Block b ^{:tag (slice byte)} iv]
  (addr ^{:go/breaks [2 4 6 8]} (lit cbc
      :b b
      :blockSize (.BlockSize b)
      :iv (bytes/Clone iv)
      :tmp (make (slice byte) (.BlockSize b)))))



(go/type cbcEncrypter cbc)




(go/type cbcEncAble "cbcEncAble is an interface implemented by ciphers that have a specific\noptimized implementation of CBC encryption. crypto/aes doesn't use this\nanymore, and we'd like to eventually remove it.\n" (interface
    (NewCBCEncrypter ^BlockMode [^{:tag (slice byte)} iv])))





^{:go/end 64} (go/func NewCBCEncrypter "NewCBCEncrypter returns a BlockMode which encrypts in cipher block chaining\nmode, using the given Block. The length of iv must be the same as the\nBlock's block size.\n" ^BlockMode [^Block b ^{:tag (slice byte)} iv]
  (when (!= (len iv) (.BlockSize b))
    (panic "cipher.NewCBCEncrypter: IV length must equal block size"))

  (when [(values b ok) (assert (* aes/Block) b)] ok
    (return (aes/NewCBCEncrypter b (conv (array 16 byte) iv))))

  (when (fips140only/Enforced)
    (panic "crypto/cipher: use of CBC with non-AES ciphers is not allowed in FIPS 140-only mode"))

  (when [(values cbc ok) (assert cbcEncAble b)] ok
    (return (.NewCBCEncrypter cbc iv)))

  (conv (* cbcEncrypter) (newCBC b iv)))






^{:go/end 75} (go/func newCBCGenericEncrypter "newCBCGenericEncrypter returns a BlockMode which encrypts in cipher block chaining\nmode, using the given Block. The length of iv must be the same as the\nBlock's block size. This always returns the generic non-asm encrypter for use\nin fuzz testing.\n" ^BlockMode [^Block b ^{:tag (slice byte)} iv]
  (when (!= (len iv) (.BlockSize b))
    (panic "cipher.NewCBCEncrypter: IV length must equal block size"))

  (conv (* cbcEncrypter) (newCBC b iv)))


^{:go/end 77} (go/method BlockSize ^int [^{:tag (* cbcEncrypter)} x] (.-blockSize x))

^{:go/end 108} (go/method CryptBlocks [^{:tag (* cbcEncrypter)} x ^{:tag (slice byte)} dst ^{:tag (slice byte)} src]
  (when (!= (% (len src) (.-blockSize x)) 0)
    (panic "crypto/cipher: input not full blocks"))

  (when (< (len dst) (len src))
    (panic "crypto/cipher: output smaller than input"))

  (when (alias/InexactOverlap (subslice dst _ (len src)) src)
    (panic "crypto/cipher: invalid buffer overlap"))

  (when [(values _ ok) (assert (* aes/Block) (.-b x))] ok
    (panic "crypto/cipher: internal error: generic CBC used with AES"))


  (let [iv (.-iv x)]

    (while (> (len src) 0)
      ;; Write the xor to dst, then encrypt in place.
      (subtle/XORBytes (subslice dst _ (.-blockSize x)) (subslice src _ (.-blockSize x)) iv)
      (.Encrypt (.-b x) (subslice dst _ (.-blockSize x)) (subslice dst _ (.-blockSize x)))

      ;; Move to the next block with this block as the next iv.
      (set! iv (subslice dst _ (.-blockSize x)))
      (set! src (subslice src (.-blockSize x)))
      (set! dst (subslice dst (.-blockSize x))))


    ;; Save the iv for the next CryptBlocks call.
    (copy (.-iv x) iv)))


^{:go/end 115} (go/method SetIV [^{:tag (* cbcEncrypter)} x ^{:tag (slice byte)} iv]
  (when (!= (len iv) (len (.-iv x)))
    (panic "cipher: incorrect length IV"))

  (copy (.-iv x) iv))


(go/type cbcDecrypter cbc)




(go/type cbcDecAble "cbcDecAble is an interface implemented by ciphers that have a specific\noptimized implementation of CBC decryption. crypto/aes doesn't use this\nanymore, and we'd like to eventually remove it.\n" (interface
    (NewCBCDecrypter ^BlockMode [^{:tag (slice byte)} iv])))





^{:go/end 143} (go/func NewCBCDecrypter "NewCBCDecrypter returns a BlockMode which decrypts in cipher block chaining\nmode, using the given Block. The length of iv must be the same as the\nBlock's block size and must match the iv used to encrypt the data.\n" ^BlockMode [^Block b ^{:tag (slice byte)} iv]
  (when (!= (len iv) (.BlockSize b))
    (panic "cipher.NewCBCDecrypter: IV length must equal block size"))

  (when [(values b ok) (assert (* aes/Block) b)] ok
    (return (aes/NewCBCDecrypter b (conv (array 16 byte) iv))))

  (when (fips140only/Enforced)
    (panic "crypto/cipher: use of CBC with non-AES ciphers is not allowed in FIPS 140-only mode"))

  (when [(values cbc ok) (assert cbcDecAble b)] ok
    (return (.NewCBCDecrypter cbc iv)))

  (conv (* cbcDecrypter) (newCBC b iv)))






^{:go/end 154} (go/func newCBCGenericDecrypter "newCBCGenericDecrypter returns a BlockMode which encrypts in cipher block chaining\nmode, using the given Block. The length of iv must be the same as the\nBlock's block size. This always returns the generic non-asm decrypter for use in\nfuzz testing.\n" ^BlockMode [^Block b ^{:tag (slice byte)} iv]
  (when (!= (len iv) (.BlockSize b))
    (panic "cipher.NewCBCDecrypter: IV length must equal block size"))

  (conv (* cbcDecrypter) (newCBC b iv)))


^{:go/end 156} (go/method BlockSize ^int [^{:tag (* cbcDecrypter)} x] (.-blockSize x))

^{:go/end 200} (go/method CryptBlocks [^{:tag (* cbcDecrypter)} x ^{:tag (slice byte)} dst ^{:tag (slice byte)} src]
  (when (!= (% (len src) (.-blockSize x)) 0)
    (panic "crypto/cipher: input not full blocks"))

  (when (< (len dst) (len src))
    (panic "crypto/cipher: output smaller than input"))

  (when (alias/InexactOverlap (subslice dst _ (len src)) src)
    (panic "crypto/cipher: invalid buffer overlap"))

  (when [(values _ ok) (assert (* aes/Block) (.-b x))] ok
    (panic "crypto/cipher: internal error: generic CBC used with AES"))

  (when (== (len src) 0)
    (return))


  ;; For each block, we need to xor the decrypted data with the previous block's ciphertext (the iv).
  ;; To avoid making a copy each time, we loop over the blocks BACKWARDS.
  (let [end (len src)
      ^{:line 178} start (- end (.-blockSize x))
      ^{:line 179} prev (- start (.-blockSize x))]

    ;; Copy the last block of ciphertext in preparation as the new iv.
    (copy (.-tmp x) (subslice src start end))

    ;; Loop over all but the first block.
    (while (> start 0)
      (.Decrypt (.-b x) (subslice dst start end) (subslice src start end))
      (subtle/XORBytes (subslice dst start end) (subslice dst start end) (subslice src prev start))

      (set! end start)
      (set! start prev)
      (set! prev - (.-blockSize x)))


    ;; The first block is special because it uses the saved iv.
    (.Decrypt (.-b x) (subslice dst start end) (subslice src start end))
    (subtle/XORBytes (subslice dst start end) (subslice dst start end) (.-iv x))

    ;; Set the new iv to the first block we copied earlier.
    (set! (values (.-iv x) (.-tmp x)) (values (.-tmp x) (.-iv x)))))


^{:go/end 207} (go/method SetIV [^{:tag (* cbcDecrypter)} x ^{:tag (slice byte)} iv]
  (when (!= (len iv) (len (.-iv x)))
    (panic "cipher: incorrect length IV"))

  (copy (.-iv x) iv))

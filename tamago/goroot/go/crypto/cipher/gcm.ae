^{:go/end 194} (go/method Open [^gcmWithRandomNonce g ^{:tag (slice byte)} dst ^{:tag (slice byte)} nonce ^{:tag (slice byte)} ciphertext ^{:tag (slice byte)} additionalData] :results [(slice byte) error]

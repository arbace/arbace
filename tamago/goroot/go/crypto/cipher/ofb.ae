;; OFB (Output Feedback) Mode.

(in-ns 'go.crypto.cipher) (go/file "ofb.go" :imports [


    ^{:line 10} [alias "crypto/internal/fips140/alias"]
    ^{:line 11} [fips140only "crypto/internal/fips140only"]
    ^{:line 12} [subtle "crypto/subtle"]])


(go/type ofb (struct
    ^{:line 16 :tag Block} b
    ^{:line 17 :tag (slice byte)} cipher
    ^{:line 18 :tag (slice byte)} out
    ^{:line 19 :tag int} outUsed))











^{:go/end 53} (go/func NewOFB "NewOFB returns a [Stream] that encrypts or decrypts using the block cipher b\nin output feedback mode. The initialization vector iv's length must be equal\nto b's block size.\n\nDeprecated: OFB mode is not authenticated, which generally enables active\nattacks to manipulate and recover the plaintext. It is recommended that\napplications use [AEAD] modes instead. The standard library implementation of\nOFB is also unoptimized and not validated as part of the FIPS 140-3 module.\nIf an unauthenticated [Stream] mode is required, use [NewCTR] instead.\n" ^Stream [^Block b ^{:tag (slice byte)} iv]
  (when (fips140only/Enforced)
    (panic "crypto/cipher: use of OFB is not allowed in FIPS 140-only mode"))


  (let [blockSize (.BlockSize b)]
    (when (!= (len iv) blockSize)
      (panic "cipher.NewOFB: IV length must equal block size"))

    (let [bufSize streamBufferSize]
      (when (< bufSize blockSize)
        (set! bufSize blockSize))

      (let [x (addr ^{:go/breaks [2 4 6 8]} (lit ofb
              :b b
              :cipher (make (slice byte) blockSize)
              :out (make (slice byte) 0 bufSize)
              :outUsed 0))]


        (copy (.-cipher x) iv)
        ^{:line 52} x))))


^{:go/end 70} (go/method refill [^{:tag (* ofb)} x]
  (let [bs (.BlockSize (.-b x))
      ^{:line 57} remain (- (len (.-out x)) (.-outUsed x))]
    (when (> remain (.-outUsed x))
      (return))

    (copy (.-out x) (subslice (.-out x) (.-outUsed x)))
    (set! (.-out x) (subslice (.-out x) _ (cap (.-out x))))
    (while (< remain (- (len (.-out x)) bs))
      (.Encrypt (.-b x) (.-cipher x) (.-cipher x))
      (copy (subslice (.-out x) remain) (.-cipher x))
      (set! remain + bs))

    (set! (.-out x) (subslice (.-out x) _ remain))
    (set! (.-outUsed x) 0)))


^{:go/end 88} (go/method XORKeyStream [^{:tag (* ofb)} x ^{:tag (slice byte)} dst ^{:tag (slice byte)} src]
  (when (< (len dst) (len src))
    (panic "crypto/cipher: output smaller than input"))

  (when (alias/InexactOverlap (subslice dst _ (len src)) src)
    (panic "crypto/cipher: invalid buffer overlap"))

  (while (> (len src) 0)
    (when (>= (.-outUsed x) (- (len (.-out x)) (.BlockSize (.-b x))))
      (.refill x))

    (let [n (subtle/XORBytes dst src (subslice (.-out x) (.-outUsed x)))]
      (set! dst (subslice dst n))
      (set! src (subslice src n))
      (set! (.-outUsed x) + n))))

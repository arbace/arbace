;; Package cipher implements standard block cipher modes that can be wrapped
;; around low-level block cipher implementations.
;; See https://csrc.nist.gov/groups/ST/toolkit/BCM/current_modes.html
;; and NIST Special Publication 800-38A.
(in-ns 'go.crypto.cipher) (go/file "cipher.go" :doc "Package cipher implements standard block cipher modes that can be wrapped\naround low-level block cipher implementations.\nSee https://csrc.nist.gov/groups/ST/toolkit/BCM/current_modes.html\nand NIST Special Publication 800-38A.\n" :imports [])





(go/type Block "A Block represents an implementation of block cipher\nusing a given key. It provides the capability to encrypt\nor decrypt individual blocks. The mode implementations\nextend that capability to streams of blocks.\n" (interface

    (^{:doc "BlockSize returns the cipher's block size.\n"} BlockSize ^int [])



    (^{:doc "Encrypt encrypts the first block in src into dst.\nDst and src must overlap entirely or not at all.\n"} Encrypt [^{:tag (slice byte)} dst ^{:tag (slice byte)} src])



    (^{:doc "Decrypt decrypts the first block in src into dst.\nDst and src must overlap entirely or not at all.\n"} Decrypt [^{:tag (slice byte)} dst ^{:tag (slice byte)} src])))



(go/type Stream "A Stream represents a stream cipher.\n" (interface










    (^{:doc "XORKeyStream XORs each byte in the given slice with a byte from the\ncipher's key stream. Dst and src must overlap entirely or not at all.\n\nIf len(dst) < len(src), XORKeyStream should panic. It is acceptable\nto pass a dst bigger than src, and in that case, XORKeyStream will\nonly update dst[:len(src)] and will not touch the rest of dst.\n\nMultiple calls to XORKeyStream behave as if the concatenation of\nthe src buffers was passed in a single run. That is, Stream\nmaintains state and does not reset at each XORKeyStream call.\n"} XORKeyStream [^{:tag (slice byte)} dst ^{:tag (slice byte)} src])))




(go/type BlockMode "A BlockMode represents a block cipher running in a block-based mode (CBC,\nECB etc).\n" (interface

    (^{:doc "BlockSize returns the mode's block size.\n"} BlockSize ^int [])












    (^{:doc "CryptBlocks encrypts or decrypts a number of blocks. The length of\nsrc must be a multiple of the block size. Dst and src must overlap\nentirely or not at all.\n\nIf len(dst) < len(src), CryptBlocks should panic. It is acceptable\nto pass a dst bigger than src, and in that case, CryptBlocks will\nonly update dst[:len(src)] and will not touch the rest of dst.\n\nMultiple calls to CryptBlocks behave as if the concatenation of\nthe src buffers was passed in a single run. That is, BlockMode\nmaintains state and does not reset at each CryptBlocks call.\n"} CryptBlocks [^{:tag (slice byte)} dst ^{:tag (slice byte)} src])))





(go/type AEAD "AEAD is a cipher mode providing authenticated encryption with associated\ndata. For a description of the methodology, see\nhttps://en.wikipedia.org/wiki/Authenticated_encryption.\n" (interface


    (^{:doc "NonceSize returns the size of the nonce that must be passed to Seal\nand Open.\n"} NonceSize ^int [])



    (^{:doc "Overhead returns the maximum difference between the lengths of a\nplaintext and its ciphertext.\n"} Overhead ^int [])









    (^{:doc "Seal encrypts and authenticates plaintext, authenticates the\nadditional data and appends the result to dst, returning the updated\nslice. The nonce must be NonceSize() bytes long and unique for all\ntime, for a given key.\n\nTo reuse plaintext's storage for the encrypted output, use plaintext[:0]\nas dst. Otherwise, the remaining capacity of dst must not overlap plaintext.\ndst and additionalData may not overlap.\n"} Seal ^{:tag (slice byte)} [^{:tag (slice byte)} dst ^{:tag (slice byte)} nonce ^{:tag (slice byte)} plaintext ^{:tag (slice byte)} additionalData])













    (^{:doc "Open decrypts and authenticates ciphertext, authenticates the\nadditional data and, if successful, appends the resulting plaintext\nto dst, returning the updated slice. The nonce must be NonceSize()\nbytes long and both it and the additional data must match the\nvalue passed to Seal.\n\nTo reuse ciphertext's storage for the decrypted output, use ciphertext[:0]\nas dst. Otherwise, the remaining capacity of dst must not overlap ciphertext.\ndst and additionalData may not overlap.\n\nEven if the function fails, the contents of dst, up to its capacity,\nmay be overwritten.\n"} Open [^{:tag (slice byte)} dst ^{:tag (slice byte)} nonce ^{:tag (slice byte)} ciphertext ^{:tag (slice byte)} additionalData] :results [(slice byte) error])))

;; CFB (Cipher Feedback) Mode.

(in-ns 'go.crypto.cipher) (go/file "cfb.go" :imports [


    ^{:line 10} [alias "crypto/internal/fips140/alias"]
    ^{:line 11} [fips140only "crypto/internal/fips140only"]
    ^{:line 12} [subtle "crypto/subtle"]])


(go/type cfb (struct
    ^{:line 16 :tag Block} b
    ^{:line 17 :tag (slice byte)} next
    ^{:line 18 :tag (slice byte)} out
    ^{:line 19 :tag int} outUsed

    ^{:line 21 :tag bool} decrypt))


^{:go/end 52} (go/method XORKeyStream [^{:tag (* cfb)} x ^{:tag (slice byte)} dst ^{:tag (slice byte)} src]
  (when (< (len dst) (len src))
    (panic "crypto/cipher: output smaller than input"))

  (when (alias/InexactOverlap (subslice dst _ (len src)) src)
    (panic "crypto/cipher: invalid buffer overlap"))

  (while (> (len src) 0)
    (when (== (.-outUsed x) (len (.-out x)))
      (.Encrypt (.-b x) (.-out x) (.-next x))
      (set! (.-outUsed x) 0))


    (when (.-decrypt x)
      ;; We can precompute a larger segment of the
      ;; keystream on decryption. This will allow
      ;; larger batches for xor, and we should be
      ;; able to match CTR/OFB performance.
      (copy (subslice (.-next x) (.-outUsed x)) src))

    (let [n (subtle/XORBytes dst src (subslice (.-out x) (.-outUsed x)))]
      (when (not (.-decrypt x))
        (copy (subslice (.-next x) (.-outUsed x)) dst))

      (set! dst (subslice dst n))
      (set! src (subslice src n))
      (set! (.-outUsed x) + n))))












^{:go/end 68} (go/func NewCFBEncrypter "NewCFBEncrypter returns a [Stream] which encrypts with cipher feedback mode,\nusing the given [Block]. The iv must be the same length as the [Block]'s block\nsize.\n\nDeprecated: CFB mode is not authenticated, which generally enables active\nattacks to manipulate and recover the plaintext. It is recommended that\napplications use [AEAD] modes instead. The standard library implementation of\nCFB is also unoptimized and not validated as part of the FIPS 140-3 module.\nIf an unauthenticated [Stream] mode is required, use [NewCTR] instead.\n" ^Stream [^Block block ^{:tag (slice byte)} iv]
  (when (fips140only/Enforced)
    (panic "crypto/cipher: use of CFB is not allowed in FIPS 140-only mode"))

  (newCFB block iv false))











^{:go/end 84} (go/func NewCFBDecrypter "NewCFBDecrypter returns a [Stream] which decrypts with cipher feedback mode,\nusing the given [Block]. The iv must be the same length as the [Block]'s block\nsize.\n\nDeprecated: CFB mode is not authenticated, which generally enables active\nattacks to manipulate and recover the plaintext. It is recommended that\napplications use [AEAD] modes instead. The standard library implementation of\nCFB is also unoptimized and not validated as part of the FIPS 140-3 module.\nIf an unauthenticated [Stream] mode is required, use [NewCTR] instead.\n" ^Stream [^Block block ^{:tag (slice byte)} iv]
  (when (fips140only/Enforced)
    (panic "crypto/cipher: use of CFB is not allowed in FIPS 140-only mode"))

  (newCFB block iv true))


^{:go/end 102} (go/func newCFB ^Stream [^Block block ^{:tag (slice byte)} iv ^bool decrypt]
  (let [blockSize (.BlockSize block)]
    (when (!= (len iv) blockSize)
      ;; Stack trace will indicate whether it was de- or en-cryption.
      (panic "cipher.newCFB: IV length must equal block size"))

    (let [x (addr ^{:go/breaks [2 4 6 8 10]} (lit cfb
            :b block
            :out (make (slice byte) blockSize)
            :next (make (slice byte) blockSize)
            :outUsed blockSize
            :decrypt decrypt))]

      (copy (.-next x) iv)

      ^{:line 101} x)))

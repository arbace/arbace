(ns go.crypto.subtle
  (:require [arbace.go :as go]))

(go/package subtle
  :path "crypto/subtle"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["constant_time.go" "dit.go" "xor.go"]
  :init-order []
  :positions :lines)

(load "subtle/constant_time")
(load "subtle/dit")
(load "subtle/xor")

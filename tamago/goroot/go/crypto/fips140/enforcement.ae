(in-ns 'go.crypto.fips140) (go/file "enforcement.go" :imports [


    ^{:line 8} [godebug "internal/godebug"]
    ^{:line 9} [_ "unsafe"]]) ; for linkname











^{:go/end 29} (go/func WithoutEnforcement "WithoutEnforcement disables strict FIPS 140-3 enforcement while executing f.\nCalling WithoutEnforcement without strict enforcement enabled\n(GODEBUG=fips140=only is not set or already inside of a call to\nWithoutEnforcement) is a no-op.\n\nWithoutEnforcement is inherited by any goroutines spawned while executing f.\n\nAs this disables enforcement, it should be applied carefully to tightly\nscoped functions.\n" [^{:tag (func [])} f]
  (when (or (not (Enabled)) (not (Enforced)))
    (f)
    (return))

  (setBypass)
  (defer (unsetBypass))
  (f))


(go/var enabled (== (.Value (godebug/New "fips140")) "only"))




^{:go/end 38} (go/func Enforced "Enforced indicates if strict FIPS 140-3 enforcement is enabled. Strict\nenforcement is enabled when a program is run with GODEBUG=fips140=only and\nenforcement has not been disabled by a call to [WithoutEnforcement].\n" ^bool []
  (and enabled (not (isBypassed))))



(go/func ^:extern ^{:go/linkname "setBypass"} setBypass [])


(go/func ^:extern ^{:go/linkname "isBypassed"} isBypassed ^bool [])


(go/func ^:extern ^{:go/linkname "unsetBypass"} unsetBypass [])

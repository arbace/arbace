;; Package fips140 provides information about the FIPS 140-3 Go Cryptographic
;; Module and FIPS 140-3 mode.
;;
;; For more details, see the [FIPS 140-3 documentation].
;;
;; [FIPS 140-3 documentation]: https://go.dev/doc/security/fips140
(in-ns 'go.crypto.fips140) (go/file "fips140.go" :doc "Package fips140 provides information about the FIPS 140-3 Go Cryptographic\nModule and FIPS 140-3 mode.\n\nFor more details, see the [FIPS 140-3 documentation].\n\n[FIPS 140-3 documentation]: https://go.dev/doc/security/fips140\n" :imports [


    ^{:line 14} [fips140 "crypto/internal/fips140"]
    ^{:line 15} [check "crypto/internal/fips140/check"]])










^{:go/end 31} (go/func Enabled "Enabled reports whether the cryptography libraries are operating in FIPS\n140-3 mode.\n\nIt can be controlled at runtime using the GODEBUG setting \"fips140\". If set\nto \"on\", FIPS 140-3 mode is enabled. If set to \"only\", non-approved\ncryptography functions will additionally return errors or panic.\n\nThis can't be changed after the program has started.\n" ^bool []
  (when (and fips140/Enabled (not check/Verified))
    (panic "crypto/fips140: FIPS 140-3 mode enabled, but integrity check didn't pass"))

  ^{:line 30} fips140/Enabled)













^{:go/end 46} (go/func Version "Version returns the FIPS 140-3 Go Cryptographic Module version (such as\n\"v1.0.0\"), as referenced in the Security Policy for the module, if building\nagainst a frozen module with GOFIPS140. Otherwise, it returns \"latest\". If an\nalias is in use (such as \"inprogress\") the actual resolved version is\nreturned.\n\nThe returned version may not uniquely identify the frozen module which was\nused to build the program, if there are multiple copies of the frozen module\nat the same version. The uniquely identifying version suffix can be found by\nchecking the value of the GOFIPS140 setting in\nruntime/debug.BuildInfo.Settings.\n" ^string []
  (fips140/Version))

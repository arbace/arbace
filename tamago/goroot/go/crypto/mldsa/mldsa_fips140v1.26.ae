  (when (== opts nil)
    (set! opts (addr (lit Options))))

  (switch (.HashFunc opts)
    (case [0]
      (let [^string context (zero string)]
        (when [(values opts ok) (assert (* Options) opts)] (and ok (!= opts nil))
          (set! context (.-Context opts)))

        (return (mldsa/Sign (addr (.-k sk)) message context))))
    (case [crypto/MLDSAMu]
      (return (mldsa/SignExternalMu (addr (.-k sk)) message)))
    (default
      (return nil errInvalidSignerOpts))))






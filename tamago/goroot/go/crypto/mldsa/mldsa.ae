  ^{:line 19} [^{:val 32} PrivateKeySize 32]

  ^{:line 21} [^{:val 1312} MLDSA44PublicKeySize 1312]
  ^{:line 22} [^{:val 1952} MLDSA65PublicKeySize 1952]
  ^{:line 23} [^{:val 2592} MLDSA87PublicKeySize 2592]

  ^{:line 25} [^{:val 2420} MLDSA44SignatureSize 2420]
  ^{:line 26} [^{:val 3309} MLDSA65SignatureSize 3309]
  ^{:line 27} [^{:val 4627} MLDSA87SignatureSize 4627])









(go/type Parameters "Parameters represents one of the fixed parameter sets defined in FIPS 204.\n\nMost applications should use [MLDSA44].\n\nMultiple invocations of [MLDSA44], [MLDSA65], or [MLDSA87] will return the\nsame respective value, which can be used for equality checks and switch\nstatements. The returned value is safe for concurrent use.\n" (struct
    ^{:line 38 :tag string} name
    ^{:line 39 :tag int} publicKeySize
    ^{:line 40 :tag int} signatureSize))



^{:go/end 50} (go/func MLDSA44 "MLDSA44 returns the ML-DSA-44 parameter set defined in FIPS 204.\n" ^Parameters []
  ^{:go/breaks [2 4 6]} (lit Parameters
    :name "ML-DSA-44"
    :publicKeySize MLDSA44PublicKeySize
    :signatureSize MLDSA44SignatureSize))




^{:go/end 59} (go/func MLDSA65 "MLDSA65 returns the ML-DSA-65 parameter set defined in FIPS 204.\n" ^Parameters []
  ^{:go/breaks [2 4 6]} (lit Parameters

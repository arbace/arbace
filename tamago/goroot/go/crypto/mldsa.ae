(ns go.crypto.mldsa
  (:require [arbace.go :as go]))

(go/package mldsa
  :path "crypto/mldsa"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["mldsa.go" "mldsa_fips140v1.26.go"]
  :init-order [errInvalidParameters errInvalidSignerOpts]
  :positions :lines)

(load "mldsa/mldsa")
(load "mldsa/mldsa_fips140v1.26")

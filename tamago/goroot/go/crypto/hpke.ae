(ns go.crypto.hpke
  (:require [arbace.go :as go]))

(go/package hpke
  :path "crypto/hpke"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["aead.go" "aead_fips140v1.26.go" "hpke.go" "kdf.go" "kem.go" "pq.go"]
  :init-order [aes128GCM aes256GCM chacha20poly1305AEAD hkdfSHA256 hkdfSHA384 hkdfSHA512 shake128KDF shake256KDF dhKEMP256 dhKEMP384 dhKEMP521 dhKEMX25519 mlkem768X25519 mlkem768P256 mlkem1024P384 mlkem768 mlkem1024]
  :positions :lines)

(load "hpke/aead")
(load "hpke/aead_fips140v1.26")
(load "hpke/hpke")
(load "hpke/kdf")
(load "hpke/kem")
(load "hpke/pq")

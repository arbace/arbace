(in-ns 'go.crypto.x509) (go/file "root_tamago.go" :build ["//go:build tamago"] :imports [])


(go/var ^{:doc "Possible certificate files; stop after finding one.\n"} certFiles (lit (slice string)))


(go/var ^{:doc "Possible directories with certificate files; all will be read.\n"} certDirectories (lit (slice string)))

^{:go/end 55} (go/func isPrintable "isPrintable reports whether the given b is in the ASN.1 PrintableString set.\nThis is a simplified version of encoding/asn1.isPrintable.\n" ^bool [^byte b]
  (or (and (<= \a b) (<= b \z))
    (and (<= \A b) (<= b \Z))
    (and (<= \0 b) (<= b \9))
    (and (<= \' b) (<= b \)))
    (and (<= \+ b) (<= b \/))
    (== b \space)
    (== b \:)
    (== b \=)
    (== b \?)
    ;; This is technically not allowed in a PrintableString.
    ;; However, x509 certificates with wildcard strings don't
    ;; always use the correct string type so we permit it.
    (== b \*)

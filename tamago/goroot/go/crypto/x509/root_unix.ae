(in-ns 'go.crypto.x509) (go/file "root_unix.go" :build ["//go:build aix || dragonfly || freebsd || (js && wasm) || linux || netbsd || openbsd || solaris || wasip1 || tamago"] :imports [])

^{:go/end 11} (go/method systemVerify [^{:tag (* Certificate)} c ^{:tag (* VerifyOptions)} opts] :results [^{:tag (slice (slice (* Certificate)))} chains ^error err]
  (return nil nil))

^{:go/end 236} (go/method appendRDNs "appendRDNs appends a relativeDistinguishedNameSET to the given RDNSequence\nand returns the new value. The relativeDistinguishedNameSET contains an\nattributeTypeAndValue for each of the given values. See RFC 5280, A.1, and\nsearch for AttributeTypeAndValue.\n" ^RDNSequence [^Name n ^RDNSequence in ^{:tag (slice string)} values ^asn1/ObjectIdentifier oid]
  (when (or (== (len values) 0) (oidInAttributeTypeAndValue oid (.-ExtraNames n)))
    (return in))


  (let [s (make (slice AttributeTypeAndValue) (len values))]
    (range [i value values]
      (set! (.-Type (aget s i)) oid)
      (set! (.-Value (aget s i)) value))


    (append in s)))














^{:go/end 269} (go/method ToRDNSequence "ToRDNSequence converts n into a single [RDNSequence]. The following\nattributes are encoded as multi-value RDNs:\n\n  - Country\n  - Organization\n  - OrganizationalUnit\n  - Locality\n  - Province\n  - StreetAddress\n  - PostalCode\n\nEach ExtraNames entry is encoded as an individual RDN.\n" [^Name n] :results [^RDNSequence ret]
  (set! ret (.appendRDNs n ret (.-Country n) oidCountry))
  (set! ret (.appendRDNs n ret (.-Province n) oidProvince))
  (set! ret (.appendRDNs n ret (.-Locality n) oidLocality))
  (set! ret (.appendRDNs n ret (.-StreetAddress n) oidStreetAddress))
  (set! ret (.appendRDNs n ret (.-PostalCode n) oidPostalCode))
  (set! ret (.appendRDNs n ret (.-Organization n) oidOrganization))
  (set! ret (.appendRDNs n ret (.-OrganizationalUnit n) oidOrganizationalUnit))
  (when (> (len (.-CommonName n)) 0)
    (set! ret (.appendRDNs n ret (lit (slice string) (.-CommonName n)) oidCommonName)))

  (when (> (len (.-SerialNumber n)) 0)
    (set! ret (.appendRDNs n ret (lit (slice string) (.-SerialNumber n)) oidSerialNumber)))

  (range [_ atv (.-ExtraNames n)]
    (set! ret (append ret (lit (slice AttributeTypeAndValue) atv))))


  ^{:line 268} ret)




^{:go/end 294} (go/method String "String returns the string form of n, roughly following\nthe RFC 2253 Distinguished Names syntax.\n" ^string [^Name n]
  (let [^RDNSequence rdns (zero RDNSequence)]
    ;; If there are no ExtraNames, surface the parsed value (all entries in
    ;; Names) instead.
    (when (== (.-ExtraNames n) nil)
      (range [_ atv (.-Names n)]
        (let [t (.-Type atv)]
          (when (and (== (len t) 4) (== (aget t 0) 2) (== (aget t 1) 5) (== (aget t 2) 4))
            (switch (aget t 3)
              (case [3 5 6 7 8 9 10 11 17]
                ;; These attributes were already parsed into named fields.
                (continue))))


          ;; Place non-standard parsed values at the beginning of the sequence
          ;; so they will be at the end of the string. See Issue 39924.
          (set! rdns (append rdns (lit (slice AttributeTypeAndValue) atv))))))


    (set! rdns (append rdns (spread (.ToRDNSequence n))))
    (.String rdns)))




^{:go/breaks [[5 304]] :go/end 305} (go/func oidInAttributeTypeAndValue "oidInAttributeTypeAndValue reports whether a type with the given OID exists\nin atv.\n" ^bool [^asn1/ObjectIdentifier oid ^{:tag (slice AttributeTypeAndValue)} atv]
  (range [_ a atv]
    (when (.Equal (.-Type a) oid)
      (return true)))


  false)








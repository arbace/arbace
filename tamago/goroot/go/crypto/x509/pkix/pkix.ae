    ^{:line 140 :tag (slice byte)} Value))






(go/type Name "Name represents an X.509 distinguished name. This only includes the common\nelements of a DN. Note that Name is only an approximation of the X.509\nstructure. If an accurate representation is needed, asn1.Unmarshal the raw\nsubject or issuer as an [RDNSequence].\n" (struct
    ^{:line 148 :tag (slice string)} Country ^{:tag (slice string)} Organization ^{:tag (slice string)} OrganizationalUnit
    ^{:line 149 :tag (slice string)} Locality ^{:tag (slice string)} Province
    ^{:line 150 :tag (slice string)} StreetAddress ^{:tag (slice string)} PostalCode
    ^{:line 151 :tag string} SerialNumber ^string CommonName





    ^{:line 157 :tag (slice AttributeTypeAndValue) :doc "Names contains all parsed attributes. When parsing distinguished names,\nthis can be used to extract non-standard attributes that are not parsed\nby this package. When marshaling to RDNSequences, the Names field is\nignored, see ExtraNames.\n"} Names




    ^{:line 162 :tag (slice AttributeTypeAndValue) :doc "ExtraNames contains attributes to be copied, raw, into any marshaled\ndistinguished names. Values override any attributes with the same OID.\nThe ExtraNames field is not populated when parsing, see Names.\n"} ExtraNames))





^{:go/end 206} (go/method FillFromRDNSequence "FillFromRDNSequence populates n from the provided [RDNSequence].\nMulti-entry RDNs are flattened, all entries are added to the\nrelevant n fields, and the grouping is not preserved.\n" [^{:tag (* Name)} n ^{:tag (* RDNSequence)} rdns]
  (range [_ rdn @rdns]
    (when (== (len rdn) 0)
      (continue))


    (range [_ atv rdn]
      (set! (.-Names n) (append (.-Names n) atv))
      (let [(values value ok) (assert string (.-Value atv))]
        (when (not ok)
          (continue))


        (let [t (.-Type atv)]
          (when (and (== (len t) 4) (== (aget t 0) 2) (== (aget t 1) 5) (== (aget t 2) 4))
            (switch (aget t 3)
              (case [3]
                (set! (.-CommonName n) value))
              (case [5]
                (set! (.-SerialNumber n) value))
              (case [6]
                (set! (.-Country n) (append (.-Country n) value)))
              (case [7]
                (set! (.-Locality n) (append (.-Locality n) value)))
              (case [8]
                (set! (.-Province n) (append (.-Province n) value)))
              (case [9]
                (set! (.-StreetAddress n) (append (.-StreetAddress n) value)))
              (case [10]
                (set! (.-Organization n) (append (.-Organization n) value)))
              (case [11]
                (set! (.-OrganizationalUnit n) (append (.-OrganizationalUnit n) value)))
              (case [17]
                (set! (.-PostalCode n) (append (.-PostalCode n) value))))))))))







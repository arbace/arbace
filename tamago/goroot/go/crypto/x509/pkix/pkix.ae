^{:go/end 103} (go/method String "String returns a string representation of the sequence r,\nroughly following the RFC 2253 Distinguished Names syntax.\n" ^string [^RDNSequence r]
  (let [^strings/Builder buf (zero strings/Builder)]
    (for [i 0] (< i (len r)) (inc! i)
      (let [rdn (aget r (- (len r) 1 i))]
        (when (> i 0)
          (.WriteByte buf \,))

        (range [j tv rdn]
          (when (> j 0)
            (.WriteByte buf \+))


          (let [oidString (.String (.-Type tv))
              (values typeName ok) (aget attributeTypeNames oidString)]
            (when (not ok)
              ;; RFC 2253 §2.4: if the value's ASN.1 type has a string
              ;; representation, render it as a string; otherwise hex-encode
              ;; the DER.
              (when [(values _ ok) (assert string (.-Value tv))] (not ok)
                (let [(values derBytes err) (asn1/Marshal (.-Value tv))]
                  (when (== err nil)
                    (.WriteString buf oidString)
                    (.WriteString buf "=#")
                    (.WriteString buf (hex/EncodeToString derBytes))
                    (continue)))) ; No value escaping necessary.



              (set! typeName oidString))


            (let [valueString (fmt/Sprint (.-Value tv))
                ^{:line 73} escaped (make (slice rune) 0 (len valueString))]

              (range [k c valueString]
                (let [escape false]

                  (switch c
                    (case [\, \+ \" \\ \< \> \;]
                      (set! escape true))

                    (case [\space]
                      (set! escape (or (== k 0) (== k (- (len valueString) 1)))))

                    (case [\#]
                      (set! escape (== k 0))))


                  (if escape
                    (set! escaped (append escaped \\ c))

                    (set! escaped (append escaped c)))))



              (.WriteString buf typeName)
              (.WriteByte buf \=)
              (.WriteString buf (conv string escaped)))))))



    (.String buf)))


(go/type RelativeDistinguishedNameSET (slice AttributeTypeAndValue))

















(go/type AttributeTypeAndValue "AttributeTypeAndValue mirrors the ASN.1 structure of the same name in\nRFC 5280, Section 4.1.2.4.\n\nWhen parsed as part of a pkix.Name structure in a crypto/x509 type,\nthe Value will be\n\n  - a string if the ASN.1 type is PrintableString, IA5String,\n    NumericString, BMPString, T61String, or UTF8String;\n  - an int64 if the ASN.1 type is INTEGER;\n  - an asn1.BitString if the ASN.1 type is BIT STRING;\n  - a []byte if the ASN.1 type is OCTET STRING;\n  - an asn1.ObjectIdentifier if the ASN.1 type is OBJECT IDENTIFIER;\n  - a time.Time if the ASN.1 type is UTCTIME or GENERALIZEDTIME;\n  - a bool if the ASN.1 type is BOOLEAN;\n  - nil if the ASN.1 type is NULL;\n  - an asn1.RawValue otherwise.\n" (struct
    ^{:line 124 :tag asn1/ObjectIdentifier} Type
    ^{:line 125 :tag any} Value))




(go/type AttributeTypeAndValueSET "AttributeTypeAndValueSET represents a set of ASN.1 sequences of\n[AttributeTypeAndValue] sequences from RFC 2986 (PKCS #10).\n" (struct
    ^{:line 131 :tag asn1/ObjectIdentifier} Type
    ^{:line 132 :tag (slice (slice AttributeTypeAndValue)) :go/tag "asn1:\"set\""} Value))





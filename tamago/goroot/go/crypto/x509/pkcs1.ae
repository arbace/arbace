          :E (.-E priv)
          :N (.-N priv)))


      (set! (.-D key) (.-D priv))
      (set! (.-Primes key) (make (slice (* big/Int)) (+ 2 (len (.-AdditionalPrimes priv)))))
      (aset (.-Primes key) 0 (.-P priv))
      (aset (.-Primes key) 1 (.-Q priv))

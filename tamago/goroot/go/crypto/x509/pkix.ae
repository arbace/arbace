(ns go.crypto.x509.pkix
  (:require [arbace.go :as go]))

(go/package pkix
  :path "crypto/x509/pkix"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["pkix.go"]
  :init-order [attributeTypeNames oidCountry oidOrganization oidOrganizationalUnit oidCommonName oidSerialNumber oidLocality oidProvince oidStreetAddress oidPostalCode]
  :positions :lines)

(load "pkix/pkix")

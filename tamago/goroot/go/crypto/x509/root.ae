^{:go/end 151} (go/func loadSystemRoots [] :results [(* CertPool) error]
  (let [(values certFilePath certDirPath) (values (os/Getenv certFileEnv) (os/Getenv certDirEnv))]

    (when (or (== runtime/GOOS "windows") (== runtime/GOOS "darwin") (== runtime/GOOS "ios"))
      (when (and (== certFilePath "") (== certDirPath ""))
        (return (addr (lit CertPool :systemPool true)) nil))

      (when (== (.Value x509sslcertoverrideplatform) "0")
        (.IncNonDefault x509sslcertoverrideplatform)
        (return (addr (lit CertPool :systemPool true)) nil)))



    (loadOnDiskRoots certFilePath certDirPath)))


^{:go/end 204} (go/func loadOnDiskRoots [^string certFilePath ^string certDirPath] :results [(* CertPool) error]
  (let [roots (NewCertPool)

      ^{:line 156} files certFiles]
    (when (!= certFilePath "")
      (set! files (lit (slice string) certFilePath)))


    (let [^error firstErr (zero error)]
      (range [_ file files]
        (let [(values data err) (os/ReadFile file)]
          (when (== err nil)
            (.AppendCertsFromPEM roots data)
            (break))

          (when (and (== firstErr nil) (not (os/IsNotExist err)))
            (set! firstErr err))))



      (let [dirs certDirectories]
        (when (!= certDirPath "")
          ;; OpenSSL and BoringSSL both use ":" as the SSL_CERT_DIR separator on
          ;; Unix-like systems, and ";" on Windows.
          ;; See:
          ;;  * https://golang.org/issue/35325
          ;;  * https://docs.openssl.org/4.0/man1/openssl-rehash/#environment
          (set! dirs (filepath/SplitList certDirPath)))


        (range [_ directory dirs]
          (let [(values fis err) (readUniqueDirectoryEntries directory)]
            (when (!= err nil)
              (when (and (== firstErr nil) (not (os/IsNotExist err)))
                (set! firstErr err))

              (continue))

            (range [_ fi fis]
              (let [(values data err) (os/ReadFile (filepath/Join directory (.Name fi)))]
                (when (== err nil)
                  (.AppendCertsFromPEM roots data))))))




        (when (or (> (.len roots) 0) (== firstErr nil))
          (return roots nil))


        (return nil firstErr)))))




^{:go/end 220} (go/func readUniqueDirectoryEntries "readUniqueDirectoryEntries is like os.ReadDir but omits\nsymlinks that point within the directory.\n" [^string dir] :results [(slice fs/DirEntry) error]
  (let [(values files err) (os/ReadDir dir)]
    (when (!= err nil)
      (return nil err))

    (let [uniq (subslice files _ 0)]
      (range [_ f files]
        (when (not (isSameDirSymlink f dir))
          (set! uniq (append uniq f))))


      (return uniq nil))))




^{:go/end 230} (go/func isSameDirSymlink "isSameDirSymlink reports whether f in dir is a symlink with a\ntarget not containing a slash.\n" ^bool [^fs/DirEntry f ^string dir]
  (when (== (bit-and (.Type f) fs/ModeSymlink) 0)
    (return false))

  (let [(values target err) (os/Readlink (filepath/Join dir (.Name f)))]
    (and (== err nil) (not (strings/ContainsRune target filepath/Separator)))))

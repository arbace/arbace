^{:go/end 122} (go/func SetFallbackRoots "SetFallbackRoots sets the roots to use during certificate verification, if no\ncustom roots are specified and a platform verifier or a system certificate\npool is not available (for instance in a container which does not have a root\ncertificate bundle). SetFallbackRoots will panic if roots is nil.\n\nSetFallbackRoots may only be called once, if called multiple times it will\npanic.\n\nThe fallback behavior can be forced on all platforms, even when there is a\nsystem certificate pool, by setting GODEBUG=x509usefallbackroots=1 (note that\non Windows and macOS this will disable usage of the platform verification\nAPIs and cause the pure Go verifier to be used). Setting\nx509usefallbackroots=1 without calling SetFallbackRoots has no effect.\n" [^{:tag (* CertPool)} roots]
  (when (== roots nil)
    (panic "roots must be non-nil"))


  (.Lock systemRootsMu)
  (defer (.Unlock systemRootsMu))

  (when fallbacksSet
    (panic "SetFallbackRoots has already been called"))

  (set! fallbacksSet true)

  ;; Handle case when initSystemRoots was not yet executed.
  ;; We handle that specially instead of calling loadSystemRoots, to avoid
  ;; spending excessive amount of cpu here, since the SetFallbackRoots in most cases
  ;; is going to be called at program startup.
  (when (and (== systemRoots nil) (== systemRootsErr nil))
    (set! systemRoots roots)
    (set! useFallbackRoots (== (.Value x509usefallbackroots) "1"))
    (return))


  (.Do once ^{:go/end 108} (fn [] (panic "unreachable"))) ; asserts that system roots were indeed loaded before.

  (let [forceFallbackRoots (== (.Value x509usefallbackroots) "1")
      ^{:line 111} systemCertsAvail (and (!= systemRoots nil) ^:go/paren (or (> (.len systemRoots) 0) (.-systemPool systemRoots)))]

    (when (and (not forceFallbackRoots) systemCertsAvail)
      (return))


    (when (and forceFallbackRoots systemCertsAvail)
      (.IncNonDefault x509usefallbackroots)) ; overriding system certs with fallback certs.


    (set! (values systemRoots systemRootsErr) (values roots nil))))



(in-ns 'go.crypto.sha1) (go/file "sha1block.go" :imports [


    ^{:line 8} [bits "math/bits"]])


(go/const
  ^{:line 12} [^{:val 1518500249} _K0 0x5A827999]
  ^{:line 13} [^{:val 1859775393} _K1 0x6ED9EBA1]
  ^{:line 14} [^{:val 2400959708} _K2 0x8F1BBCDC]
  ^{:line 15} [^{:val 3395469782} _K3 0xCA62C1D6])




^{:go/end 83} (go/func blockGeneric "blockGeneric is a portable, pure Go version of the SHA-1 block step.\nIt's used by sha1block_generic.go and tests.\n" [^{:tag (* digest)} dig ^{:tag (slice byte)} p]
  (let [^{:tag (array 16 uint32)} w (zero (array 16 uint32))

      (values h0 h1 h2 h3 h4) (values (aget (.-h dig) 0) (aget (.-h dig) 1) (aget (.-h dig) 2) (aget (.-h dig) 3) (aget (.-h dig) 4))]
    (while (>= (len p) chunk)
      ;; Can interlace the computation of w with the
      ;; rounds below if needed for speed.
      (for [i 0] (< i 16) (inc! i)
        (let [j (* i 4)]
          (aset w i (bit-or (<< (conv uint32 (aget p j)) 24) (<< (conv uint32 (aget p (+ j 1))) 16) (<< (conv uint32 (aget p (+ j 2))) 8) (conv uint32 (aget p (+ j 3)))))))


      (let [(values a b c d e) (values h0 h1 h2 h3 h4)

          ;; Each of the four 20-iteration rounds
          ;; differs only in the computation of f and
          ;; the choice of K (_K0, _K1, etc).
          ^{:line 37} i 0]
        (for [] (< i 16) (inc! i)
          (let [f (bit-or (bit-and b c) (bit-and (bit-not b) d))
              ^{:line 40} t (+ (bits/RotateLeft32 a 5) f e (aget w (bit-and i 0xf)) _K0)]
            (set! (values a b c d e) (values t a (bits/RotateLeft32 b 30) c d))))

        (for [] (< i 20) (inc! i)
          (let [tmp (bit-xor (aget w (bit-and (- i 3) 0xf)) (aget w (bit-and (- i 8) 0xf)) (aget w (bit-and (- i 14) 0xf)) (aget w (bit-and i 0xf)))]
            (aset w (bit-and i 0xf) (bits/RotateLeft32 tmp 1))

            (let [f (bit-or (bit-and b c) (bit-and (bit-not b) d))
                ^{:line 48} t (+ (bits/RotateLeft32 a 5) f e (aget w (bit-and i 0xf)) _K0)]
              (set! (values a b c d e) (values t a (bits/RotateLeft32 b 30) c d)))))

        (for [] (< i 40) (inc! i)
          (let [tmp (bit-xor (aget w (bit-and (- i 3) 0xf)) (aget w (bit-and (- i 8) 0xf)) (aget w (bit-and (- i 14) 0xf)) (aget w (bit-and i 0xf)))]
            (aset w (bit-and i 0xf) (bits/RotateLeft32 tmp 1))
            (let [f (bit-xor b c d)
                ^{:line 55} t (+ (bits/RotateLeft32 a 5) f e (aget w (bit-and i 0xf)) _K1)]
              (set! (values a b c d e) (values t a (bits/RotateLeft32 b 30) c d)))))

        (for [] (< i 60) (inc! i)
          (let [tmp (bit-xor (aget w (bit-and (- i 3) 0xf)) (aget w (bit-and (- i 8) 0xf)) (aget w (bit-and (- i 14) 0xf)) (aget w (bit-and i 0xf)))]
            (aset w (bit-and i 0xf) (bits/RotateLeft32 tmp 1))
            (let [f (bit-or (bit-and (bit-or b c) d) (bit-and b c))
                ^{:line 62} t (+ (bits/RotateLeft32 a 5) f e (aget w (bit-and i 0xf)) _K2)]
              (set! (values a b c d e) (values t a (bits/RotateLeft32 b 30) c d)))))

        (for [] (< i 80) (inc! i)
          (let [tmp (bit-xor (aget w (bit-and (- i 3) 0xf)) (aget w (bit-and (- i 8) 0xf)) (aget w (bit-and (- i 14) 0xf)) (aget w (bit-and i 0xf)))]
            (aset w (bit-and i 0xf) (bits/RotateLeft32 tmp 1))
            (let [f (bit-xor b c d)
                ^{:line 69} t (+ (bits/RotateLeft32 a 5) f e (aget w (bit-and i 0xf)) _K3)]
              (set! (values a b c d e) (values t a (bits/RotateLeft32 b 30) c d)))))


        (set! h0 + a)
        (set! h1 + b)
        (set! h2 + c)
        (set! h3 + d)
        (set! h4 + e)

        (set! p (subslice p chunk))))


    (set! (values (aget (.-h dig) 0) (aget (.-h dig) 1) (aget (.-h dig) 2) (aget (.-h dig) 3) (aget (.-h dig) 4)) (values h0 h1 h2 h3 h4))))

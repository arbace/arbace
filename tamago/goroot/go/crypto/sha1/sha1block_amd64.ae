(in-ns 'go.crypto.sha1) (go/file "sha1block_amd64.go" :build ["//go:build !purego"] :imports [


    ^{:line 10} [impl "crypto/internal/impl"]
    ^{:line 11} [cpu "internal/cpu"]])



(go/func ^:extern ^:go/noescape blockAVX2 [^{:tag (* digest)} dig ^{:tag (slice byte)} p])


(go/func ^:extern ^:go/noescape blockSHANI [^{:tag (* digest)} dig ^{:tag (slice byte)} p])

(go/var useAVX2 (and (.-HasAVX cpu/X86) (.-HasAVX2 cpu/X86) (.-HasBMI1 cpu/X86) (.-HasBMI2 cpu/X86)))
(go/var useSHANI (and (.-HasAVX cpu/X86) (.-HasSHA cpu/X86) (.-HasSSE41 cpu/X86) (.-HasSSSE3 cpu/X86)))

^{:go/end 26} (go/func init []
  (impl/Register "sha1" "AVX2" (addr useAVX2))
  (impl/Register "sha1" "SHA-NI" (addr useSHANI)))


^{:go/end 46} (go/func block [^{:tag (* digest)} dig ^{:tag (slice byte)} p]
  (cond useSHANI
    (blockSHANI dig p)
    (and useAVX2 (>= (len p) 256))
    ;; blockAVX2 calculates sha1 for 2 block per iteration and also
    ;; interleaves precalculation for next block. So it may read up-to 192
    ;; bytes past end of p. We could add checks inside blockAVX2, but this
    ;; would just turn it into a copy of the old pre-AVX2 amd64 SHA1
    ;; assembly implementation, so just call blockGeneric instead.
    (let [safeLen (- (len p) 128)]
      (when (!= (% safeLen 128) 0)
        (set! safeLen - 64))

      (blockAVX2 dig (subslice p _ safeLen))
      (blockGeneric dig (subslice p safeLen))) :else

    (blockGeneric dig p)))

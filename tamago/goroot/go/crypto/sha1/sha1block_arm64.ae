(in-ns 'go.crypto.sha1) (go/file "sha1block_arm64.go" :build ["//go:build !purego"] :imports [


    ^{:line 10} [impl "crypto/internal/impl"]
    ^{:line 11} [cpu "internal/cpu"]])


(go/var useSHA1 (.-HasSHA1 cpu/ARM64))

^{:go/end 18} (go/func init []
  (impl/Register "sha1" "Armv8.0" (addr useSHA1)))


(go/var k ^{:go/breaks [2 3 4 5]} (lit (slice uint32)
    0x5A827999
    0x6ED9EBA1
    0x8F1BBCDC
    0xCA62C1D6))



(go/func ^:extern ^:go/noescape sha1block [^{:tag (slice uint32)} h ^{:tag (slice byte)} p ^{:tag (slice uint32)} k])

^{:go/end 37} (go/func block [^{:tag (* digest)} dig ^{:tag (slice byte)} p]
  (if useSHA1
    (let [h (subslice (.-h dig))]
      (sha1block h p k))

    (blockGeneric dig p)))

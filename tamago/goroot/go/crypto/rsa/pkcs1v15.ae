^{:go/end 100} (go/func EncryptPKCS1v15 "EncryptPKCS1v15 encrypts the given message with RSA and the padding\nscheme from PKCS #1 v1.5.  The message must be no longer than the\nlength of the public modulus minus 11 bytes.\n\nThe random parameter is used as a source of entropy to ensure that encrypting\nthe same message twice doesn't result in the same ciphertext. Since Go 1.26,\na secure source of random bytes is always used, and the Reader is ignored\nunless GODEBUG=cryptocustomrand=1 is set. This setting will be removed in a\nfuture Go release. Instead, use [testing/cryptotest.SetGlobalRandom].\n\nDeprecated: PKCS #1 v1.5 encryption is dangerous and should not be used.\nSee [draft-irtf-cfrg-rsa-guidance-05] for more information. Use\n[EncryptOAEP] and [DecryptOAEP] instead.\n\n[draft-irtf-cfrg-rsa-guidance-05]: https://www.ietf.org/archive/id/draft-irtf-cfrg-rsa-guidance-05.html#name-rationale\n" [^io/Reader random ^{:tag (* PublicKey)} pub ^{:tag (slice byte)} msg] :results [(slice byte) error]
  (when (fips140only/Enforced)
    (return nil (errors/New "crypto/rsa: use of PKCS#1 v1.5 encryption is not allowed in FIPS 140-only mode")))


  (when [err (checkPublicKeySize pub)] (!= err nil)
    (return nil err))


  (let [k (.Size pub)]
    (when (> (len msg) (- k 11))
      (return nil ErrMessageTooLong))


    (when (and boring/Enabled (rand/IsDefaultReader random))
      (let [(values bkey err) (boringPublicKey pub)]
        (when (!= err nil)
          (return nil err))

        (return (boring/EncryptRSAPKCS1 bkey msg))))

    (boring/UnreachableExceptTests)

    (set! random (rand/CustomReader random))

    ;; EM = 0x00 || 0x02 || PS || 0x00 || M
    (let [em (make (slice byte) k)]
      (aset em 1 2)
      (let [(values ps mm) (values (subslice em 2 (- (len em) (len msg) 1)) (subslice em (- (len em) (len msg))))
          ^{:line 79} err (nonZeroRandomBytes ps random)]
        (when (!= err nil)
          (return nil err))

        (aset em (- (len em) (len msg) 1) 0)
        (copy mm msg)

        (when boring/Enabled
          (let [^{:tag (* boring/PublicKeyRSA)} bkey (zero (* boring/PublicKeyRSA))]
            (set! (values bkey err) (boringPublicKey pub))
            (when (!= err nil)
              (return nil err))

            (return (boring/EncryptRSANoPadding bkey em))))


        (let [(values fk ^:assign err) (fipsPublicKey pub)]
          (when (!= err nil)
            (return nil err))

          (rsa/Encrypt fk em))))))













^{:go/end 138} (go/func DecryptPKCS1v15 "DecryptPKCS1v15 decrypts a plaintext using RSA and the padding scheme from\nPKCS #1 v1.5. The random parameter is legacy and ignored, and it can be nil.\n\nDeprecated: PKCS #1 v1.5 encryption is dangerous and should not be used.\nWhether this function returns an error or not discloses secret information.\nIf an attacker can cause this function to run repeatedly and learn whether\neach instance returned an error then they can decrypt and forge signatures as\nif they had the private key. See [draft-irtf-cfrg-rsa-guidance-05] for more\ninformation. Use [EncryptOAEP] and [DecryptOAEP] instead.\n\n[draft-irtf-cfrg-rsa-guidance-05]: https://www.ietf.org/archive/id/draft-irtf-cfrg-rsa-guidance-05.html#name-rationale\n" [^io/Reader random ^{:tag (* PrivateKey)} priv ^{:tag (slice byte)} ciphertext] :results [(slice byte) error]
  (when [err (checkPublicKeySize (addr (.-PublicKey priv)))] (!= err nil)
    (return nil err))


  (when (and boring/Enabled (>= (.BitLen ^{:go/via [PublicKey]} (.-N priv)) 1024))
    (let [(values bkey err) (boringPrivateKey priv)]
      (when (!= err nil)
        (return nil err))

      (let [(values out ^:assign err) (boring/DecryptRSAPKCS1 bkey ciphertext)]
        (when (!= err nil)
          (return nil ErrDecryption))

        (return out nil))))


  (let [(values valid out index err) (decryptPKCS1v15 priv ciphertext)]
    (when (!= err nil)
      (return nil err))

    (when (== valid 0)
      (return nil ErrDecryption))

    (return (subslice out index) nil)))











































^{:go/end 205} (go/func DecryptPKCS1v15SessionKey "DecryptPKCS1v15SessionKey decrypts a session key using RSA and the padding\nscheme from PKCS #1 v1.5. The random parameter is legacy and ignored, and it\ncan be nil.\n\nDecryptPKCS1v15SessionKey returns an error if the ciphertext is the wrong\nlength or if the ciphertext is greater than the public modulus. Otherwise, no\nerror is returned. If the padding is valid, the resulting plaintext message\nis copied into key. Otherwise, key is unchanged. These alternatives occur in\nconstant time. It is intended that the user of this function generate a\nrandom session key beforehand and continue the protocol with the resulting\nvalue.\n\nNote that if the session key is too small then it may be possible for an\nattacker to brute-force it. If they can do that then they can learn whether a\nrandom value was used (because it'll be different for the same ciphertext)\nand thus whether the padding was correct. This also defeats the point of this\nfunction. Using at least a 16-byte key will protect against this attack.\n\nThis method implements protections against Bleichenbacher chosen ciphertext\nattacks [0] described in RFC 3218 Section 2.3.2 [1]. While these protections\nmake a Bleichenbacher attack significantly more difficult, the protections\nare only effective if the rest of the protocol which uses\nDecryptPKCS1v15SessionKey is designed with these considerations in mind. In\nparticular, if any subsequent operations which use the decrypted session key\nleak any information about the key (e.g. whether it is a static or random\nkey) then the mitigations are defeated. This method must be used extremely\ncarefully, and typically should only be used when absolutely necessary for\ncompatibility with an existing protocol (such as TLS) that is designed with\nthese properties in mind.\n\n  - [0] “Chosen Ciphertext Attacks Against Protocols Based on the RSA Encryption\n    Standard PKCS #1”, Daniel Bleichenbacher, Advances in Cryptology (Crypto '98)\n  - [1] RFC 3218, Preventing the Million Message Attack on CMS,\n    https://www.rfc-editor.org/rfc/rfc3218.html\n\nDeprecated: PKCS #1 v1.5 encryption is dangerous and should not be used. The\nprotections implemented by this function are limited and fragile, as\nexplained above. See [draft-irtf-cfrg-rsa-guidance-05] for more information.\nUse [EncryptOAEP] and [DecryptOAEP] instead.\n\n[draft-irtf-cfrg-rsa-guidance-05]: https://www.ietf.org/archive/id/draft-irtf-cfrg-rsa-guidance-05.html#name-rationale\n" ^error [^io/Reader random ^{:tag (* PrivateKey)} priv ^{:tag (slice byte)} ciphertext ^{:tag (slice byte)} key]
  (when [err (checkPublicKeySize (addr (.-PublicKey priv)))] (!= err nil)
    (return err))


  (let [k ^{:go/via [PublicKey]} (.Size priv)]
    (when (< (- k (+ (len key) 3 8)) 0)
      (return ErrDecryption))


    ^{:go/breaks [6]} (let [(values valid em index err) (decryptPKCS1v15 priv ciphertext)]
      (when (!= err nil)
        (return err))


      (when (!= (len em) k)
        ;; This should be impossible because decryptPKCS1v15 always
        ;; returns the full slice.
        (return ErrDecryption))


      (set! valid bit-and (subtle/ConstantTimeEq (conv int32 (- (len em) index)) (conv int32 (len key))))
      (subtle/ConstantTimeCopy valid key (subslice em (- (len em) (len key))))
      nil)))








^{:go/end 267} (go/func decryptPKCS1v15 "decryptPKCS1v15 decrypts ciphertext using priv. It returns one or zero in\nvalid that indicates whether the plaintext was correctly structured.\nIn either case, the plaintext is returned in em so that it may be read\nindependently of whether it was valid in order to maintain constant memory\naccess patterns. If the plaintext was valid then index contains the index of\nthe original message in em, to allow constant time padding removal.\n" [^{:tag (* PrivateKey)} priv ^{:tag (slice byte)} ciphertext] :results [^int valid ^{:tag (slice byte)} em ^int index ^error err]
  (when (fips140only/Enforced)
    (return 0 nil 0 (errors/New "crypto/rsa: use of PKCS#1 v1.5 encryption is not allowed in FIPS 140-only mode")))


  (let [k ^{:go/via [PublicKey]} (.Size priv)]
    (when (< k 11)
      (set! err ErrDecryption)
      (return 0 nil 0 err))


    (if (and boring/Enabled (>= (.BitLen ^{:go/via [PublicKey]} (.-N priv)) 1024))
      (let [^{:tag (* boring/PrivateKeyRSA)} bkey (zero (* boring/PrivateKeyRSA))]
        (set! (values bkey err) (boringPrivateKey priv))
        (when (!= err nil)
          (return 0 nil 0 err))

        (set! (values em err) (boring/DecryptRSANoPadding bkey ciphertext))
        (when (!= err nil)
          (return 0 nil 0 ErrDecryption)))


      (let [(values fk err) (fipsPrivateKey priv)]
        (when (!= err nil)
          (return 0 nil 0 err))

        (set! (values em err) (rsa/DecryptWithoutCheck fk ciphertext))
        (when (!= err nil)
          (return 0 nil 0 ErrDecryption))))



    (let [firstByteIsZero (subtle/ConstantTimeByteEq (aget em 0) 0)
        ^{:line 246} secondByteIsTwo (subtle/ConstantTimeByteEq (aget em 1) 2)

        ;; The remainder of the plaintext must be a string of non-zero random
        ;; octets, followed by a 0, followed by the message.
        ;;   lookingForIndex: 1 iff we are still looking for the zero.
        ;;   index: the offset of the first zero byte.
        ^{:line 252} lookingForIndex 1]

      (for [i 2] (< i (len em)) (inc! i)
        (let [equals0 (subtle/ConstantTimeByteEq (aget em i) 0)]
          (set! index (subtle/ConstantTimeSelect (bit-and lookingForIndex equals0) i index))
          (set! lookingForIndex (subtle/ConstantTimeSelect equals0 0 lookingForIndex))))


      ;; The PS padding must be at least 8 bytes long, and it starts two
      ;; bytes into em.
      (let [validPS (subtle/ConstantTimeLessOrEq (+ 2 8) index)]

        (set! valid (bit-and firstByteIsZero secondByteIsTwo (bit-and (bit-not lookingForIndex) 1) validPS))
        (set! index (subtle/ConstantTimeSelect valid (+ index 1) 0))
        (return valid em index nil)))))



^{:go/end 289} (go/func nonZeroRandomBytes "nonZeroRandomBytes fills the given slice with non-zero random octets.\n" [^{:tag (slice byte)} s ^io/Reader random] :results [^error err]
  (set! (values _ err) (io/ReadFull random s))
  (when (!= err nil)
    (return))


  (for [i 0] (< i (len s)) (inc! i)
    (while (== (aget s i) 0)
      (set! (values _ err) (io/ReadFull random (subslice s i (+ i 1))))
      (when (!= err nil)
        (return))

      ;; In tests, the PRNG may return all zeros so we do
      ;; this to break the loop.
      (set! (aget s i) bit-xor 0x42)))



  (return))

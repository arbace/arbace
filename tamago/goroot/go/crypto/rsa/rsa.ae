            (.Bytes (.-Dp (.-Precomputed priv))) (.Bytes (.-Dq (.-Precomputed priv))) (.Bytes (.-Qinv (.-Precomputed priv))))]
        (when (!= err nil)
          (return precomputed err))

        (set! precomputed (.-Precomputed priv))
        (set! (.-fips precomputed) k)
        (set! (.-CRTValues precomputed) (make (slice CRTValue) 0))

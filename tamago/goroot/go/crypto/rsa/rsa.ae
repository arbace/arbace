    (let [(values k err) (rsa/NewPrivateKey (.Bytes ^{:go/via [PublicKey]} (.-N priv)) ^{:go/via [PublicKey]} (.-E priv) (.Bytes (.-D priv))
          (.Bytes (aget (.-Primes priv) 0)) (.Bytes (aget (.-Primes priv) 1)))]
      (when (!= err nil)
        (return precomputed err))


      (set! (.-fips precomputed) k)

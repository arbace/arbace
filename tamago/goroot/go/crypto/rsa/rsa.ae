^{:go/end 682} (go/method precomputeLegacy [^{:tag (* PrivateKey)} priv] :results [PrecomputedValues error]
  (let [^PrecomputedValues precomputed (zero PrecomputedValues)

      (values k err) (rsa/NewPrivateKeyWithoutCRT (.Bytes ^{:go/via [PublicKey]} (.-N priv)) ^{:go/via [PublicKey]} (.-E priv) (.Bytes (.-D priv)))]
    (when (!= err nil)
      (return precomputed err))

    (set! (.-fips precomputed) k)

    (when (< (len (.-Primes priv)) 2)
      (return precomputed nil))


    ;; Ensure the Mod and ModInverse calls below don't panic.
    (range [_ prime (.-Primes priv)]
      (when (== prime nil)
        (return precomputed (errors/New "crypto/rsa: prime factor is nil")))

      (when (<= (.Cmp prime bigOne) 0)
        (return precomputed (errors/New "crypto/rsa: prime factor is <= 1"))))



    (set! (.-Dp precomputed) (.Sub (new big/Int) (aget (.-Primes priv) 0) bigOne))
    (.Mod (.-Dp precomputed) (.-D priv) (.-Dp precomputed))

    (set! (.-Dq precomputed) (.Sub (new big/Int) (aget (.-Primes priv) 1) bigOne))
    (.Mod (.-Dq precomputed) (.-D priv) (.-Dq precomputed))

    (set! (.-Qinv precomputed) (.ModInverse (new big/Int) (aget (.-Primes priv) 1) (aget (.-Primes priv) 0)))
    (when (== (.-Qinv precomputed) nil)
      (return precomputed (errors/New "crypto/rsa: prime factors are not relatively prime")))


    (let [r (.Mul (new big/Int) (aget (.-Primes priv) 0) (aget (.-Primes priv) 1))]
      (set! (.-CRTValues precomputed) (make (slice CRTValue) (- (len (.-Primes priv)) 2)))
      (for [i 2] (< i (len (.-Primes priv))) (inc! i)
        (let [prime (aget (.-Primes priv) i)
            ^{:line 667} values (addr (aget (.-CRTValues precomputed) (- i 2)))]

          (set! (.-Exp values) (.Sub (new big/Int) prime bigOne))
          (.Mod (.-Exp values) (.-D priv) (.-Exp values))

          (set! (.-R values) (.Set (new big/Int) r))
          (set! (.-Coeff values) (.ModInverse (new big/Int) r prime))
          (when (== (.-Coeff values) nil)
            (return precomputed (errors/New "crypto/rsa: prime factors are not relatively prime")))


          (.Mul r r prime)))


      (return precomputed nil))))


^{:go/end 690} (go/func fipsPublicKey [^{:tag (* PublicKey)} pub] :results [(* rsa/PublicKey) error]
  (let [(values N err) (bigmod/NewModulus (.Bytes (.-N pub)))]
    (when (!= err nil)
      (return nil err))

    (return (addr (lit rsa/PublicKey :N N :E (.-E pub))) nil)))






^{:go/end 705} (go/func fipsPrivateKey "fipsPrivateKey returns the *rsa.PrivateKey corresponding to priv, using the\nprecomputed values if available, and calculating them if not.\n\nIt does NOT modify priv and is safe for concurrent use.\n" [^{:tag (* PrivateKey)} priv] :results [(* rsa/PrivateKey) error]
  (when (!= (.-fips (.-Precomputed priv)) nil)
    (return (.-fips (.-Precomputed priv)) nil))

  (let [(values precomputed err) (.precompute priv)]
    (when (!= err nil)
      (return nil err))

    (return (.-fips precomputed) nil)))

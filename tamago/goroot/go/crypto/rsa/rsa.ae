    (when (and (!= (.-Dp (.-Precomputed priv)) nil) (!= (.-Dq (.-Precomputed priv)) nil) (!= (.-Qinv (.-Precomputed priv)) nil))
      (let [(values k err) (rsa/NewPrivateKeyWithPrecomputation (.Bytes ^{:go/via [PublicKey]} (.-N priv)) ^{:go/via [PublicKey]} (.-E priv) (.Bytes (.-D priv))

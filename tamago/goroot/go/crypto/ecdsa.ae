(ns go.crypto.ecdsa
  (:require [arbace.go :as go]))

(go/package ecdsa
  :path "crypto/ecdsa"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["ecdsa.go" "ecdsa_legacy.go" "notboring.go"]
  :init-order [errZeroParam one]
  :positions :lines)

(load "ecdsa/ecdsa")
(load "ecdsa/ecdsa_legacy")
(load "ecdsa/notboring")

(ns go.crypto.x509
  (:require [arbace.go :as go]))

(go/package x509
  :path "crypto/x509"
  :files ["cert_pool.go" "constraints.go" "oid.go" "parser.go" "pem_decrypt.go" "pkcs1.go" "pkcs8.go" "root.go" "root_tamago.go" "root_unix.go" "sec1.go" "verify.go" "x509.go" "x509_string.go"]
  :positions :lines)

(load "x509/cert_pool")
(load "x509/constraints")
(load "x509/oid")
(load "x509/parser")
(load "x509/pem_decrypt")
(load "x509/pkcs1")
(load "x509/pkcs8")
(load "x509/root")
(load "x509/root_tamago")
(load "x509/root_unix")
(load "x509/sec1")
(load "x509/verify")
(load "x509/x509")
(load "x509/x509_string")

(in-ns 'go.crypto.subtle) (go/file "dit.go" :imports [


    ^{:line 8} [sys "internal/runtime/sys"]
    ^{:line 9} [_ "unsafe"]])






























^{:go/end 57} (go/func ^:go/noinline WithDataIndependentTiming "WithDataIndependentTiming enables architecture specific features which ensure\nthat the timing of specific instructions is independent of their inputs\nbefore executing f. On f returning it disables these features.\n\nAny goroutine spawned by f will also have data independent timing enabled for\nits lifetime, as well as any of their descendant goroutines.\n\nAny C code called via cgo from within f, or from a goroutine spawned by f, will\nalso have data independent timing enabled for the duration of the call. If the\nC code disables data independent timing, it will be re-enabled on return to Go.\n\nIf C code called via cgo, from f or elsewhere, enables or disables data\nindependent timing then calling into Go will preserve that state for the\nduration of the call.\n\nWithDataIndependentTiming should only be used when f is written to make use\nof constant-time operations. WithDataIndependentTiming does not make\nvariable-time code constant-time.\n\nCalls to WithDataIndependentTiming may be nested.\n\nOn Arm64 processors with FEAT_DIT, WithDataIndependentTiming enables\nPSTATE.DIT. See https://developer.arm.com/documentation/ka005181/1-0/?lang=en.\n\nCurrently, on all other architectures WithDataIndependentTiming executes f immediately\nwith no other side-effects.\n" [^{:tag (func [])} f]
  (when (not sys/DITSupported)
    (f)
    (return))


  (let [alreadyEnabled (setDITEnabled)]

    ;; disableDIT is called in a deferred function so that if f panics we will
    ;; still disable DIT, in case the panic is recovered further up the stack.
    (defer (^{:go/end 54} (fn []
          (when (not alreadyEnabled)
            (setDITDisabled)))))



    (f)))



(go/func ^:extern ^{:go/linkname "setDITEnabled"} setDITEnabled ^bool [])


(go/func ^:extern ^{:go/linkname "setDITDisabled"} setDITDisabled [])

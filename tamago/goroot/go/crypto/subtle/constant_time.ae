;; Package subtle implements functions that are often useful in cryptographic
;; code but require careful thought to use correctly.
(in-ns 'go.crypto.subtle) (go/file "constant_time.go" :doc "Package subtle implements functions that are often useful in cryptographic\ncode but require careful thought to use correctly.\n" :imports [


    ^{:line 10} [constanttime "crypto/internal/constanttime"]
    ^{:line 11} [subtle "crypto/internal/fips140/subtle"]])


;; These functions are forwarded to crypto/internal/constanttime for intrinsified
;; operations, and to crypto/internal/fips140/subtle for byte slice operations.





^{:go/end 23} (go/func ConstantTimeCompare "ConstantTimeCompare returns 1 if the two slices, x and y, have equal contents\nand 0 otherwise. The time taken is a function of the length of the slices and\nis independent of the contents. If the lengths of x and y do not match it\nreturns 0 immediately.\n" ^int [^{:tag (slice byte)} x ^{:tag (slice byte)} y]
  (subtle/ConstantTimeCompare x y))




^{:go/end 29} (go/func ConstantTimeSelect "ConstantTimeSelect returns x if v == 1 and y if v == 0.\nIts behavior is undefined if v takes any other value.\n" ^int [^int v ^int x ^int y]
  (constanttime/Select v x y))



^{:go/end 34} (go/func ConstantTimeByteEq "ConstantTimeByteEq returns 1 if x == y and 0 otherwise.\n" ^int [^uint8 x ^uint8 y]
  (constanttime/ByteEq x y))



^{:go/end 39} (go/func ConstantTimeEq "ConstantTimeEq returns 1 if x == y and 0 otherwise.\n" ^int [^int32 x ^int32 y]
  (constanttime/Eq x y))





^{:go/end 46} (go/func ConstantTimeCopy "ConstantTimeCopy copies the contents of y into x (a slice of equal length)\nif v == 1. If v == 0, x is left unchanged. Its behavior is undefined if v\ntakes any other value.\n" [^int v ^{:tag (slice byte)} x ^{:tag (slice byte)} y]
  (subtle/ConstantTimeCopy v x y))




^{:go/end 52} (go/func ConstantTimeLessOrEq "ConstantTimeLessOrEq returns 1 if x <= y and 0 otherwise.\nIts behavior is undefined if x or y are negative or > 2**31 - 1.\n" ^int [^int x ^int y]
  (constanttime/LessOrEq x y))

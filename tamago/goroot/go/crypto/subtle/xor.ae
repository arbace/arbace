(in-ns 'go.crypto.subtle) (go/file "xor.go" :imports [

    ^{:line 7} [subtle "crypto/internal/fips140/subtle"]])









^{:go/end 19} (go/func XORBytes "XORBytes sets dst[i] = x[i] ^ y[i] for all i < n = min(len(x), len(y)),\nreturning n, the number of bytes written to dst.\n\nIf dst does not have length at least n,\nXORBytes panics without writing anything to dst.\n\ndst and x or y may overlap exactly or not at all,\notherwise XORBytes may panic.\n" ^int [^{:tag (slice byte)} dst ^{:tag (slice byte)} x ^{:tag (slice byte)} y]
  (subtle/XORBytes dst x y))

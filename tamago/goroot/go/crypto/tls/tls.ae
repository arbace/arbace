^{:go/end 238} (go/method DialContext "DialContext connects to the given network address and initiates a TLS\nhandshake, returning the resulting TLS connection.\n\nThe provided Context must be non-nil. If the context expires before\nthe connection is complete, an error is returned. Once successfully\nconnected, any expiration of the context will not affect the\nconnection.\n\nThe returned [Conn], if any, will always be of type *[Conn].\n" [^{:tag (* Dialer)} d ^context/Context ctx ^string network ^string addr] :results [net/Conn error]
  (let [(values c err) (dial ctx (.netDialer d) network addr (.-Config d))]
    (when (!= err nil)
      ;; Don't return c (a typed nil) in an interface.
      (return nil err))

    (return c nil)))






^{:go/end 254} (go/func LoadX509KeyPair "LoadX509KeyPair reads and parses a public/private key pair from a pair of\nfiles. The files must contain PEM encoded data. The certificate file may\ncontain intermediate certificates following the leaf certificate to form a\ncertificate chain. On successful return, Certificate.Leaf will be populated.\n" [^string certFile ^string keyFile] :results [Certificate error]
  (let [(values certPEMBlock err) (os/ReadFile certFile)]
    (when (!= err nil)
      (return (lit Certificate) err))

    (let [(values keyPEMBlock ^:assign err) (os/ReadFile keyFile)]
      (when (!= err nil)
        (return (lit Certificate) err))

      (X509KeyPair certPEMBlock keyPEMBlock))))





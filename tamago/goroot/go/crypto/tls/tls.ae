^{:go/end 111} (go/func Listen "Listen creates a TLS listener accepting connections on the\ngiven network address using net.Listen.\nThe configuration config must be non-nil and must include\nat least one certificate or else set GetCertificate.\n" [^string network ^string laddr ^{:tag (* Config)} config] :results [net/Listener error]
  ;; If this condition changes, consider updating http.Server.ServeTLS too.
  (when (or (== config nil) (and (== (len (.-Certificates config)) 0)
        (== (.-GetCertificate config) nil) (== (.-GetConfigForClient config) nil)))
    (return nil (errors/New "tls: neither Certificates, GetCertificate, nor GetConfigForClient set in Config")))


(in-ns 'go.crypto.tls) (go/file "cache.go" :imports [


    ^{:line 8} [x509 "crypto/x509"]
    ^{:line 9} [runtime "runtime"]
    ^{:line 10} [sync "sync"]
    ^{:line 11} [weak "weak"]])





(go/type weakCertCache "weakCertCache provides a cache of *x509.Certificates, allowing multiple\nconnections to reuse parsed certificates, instead of re-parsing the\ncertificate for every connection, which is an expensive operation.\n" (struct sync/Map))

^{:go/end 42} (go/method newCert [^{:tag (* weakCertCache)} wcc ^{:tag (slice byte)} der] :results [(* x509/Certificate) error]
  (when [(values entry ok) ^{:go/via [Map]} (.Load wcc (conv string der))] ok
    (when [v (.Value (assert (weak/Pointer x509/Certificate) entry))] (!= v nil)
      (return v nil)))



  (let [(values cert err) (x509/ParseCertificate der)]
    (when (!= err nil)
      (return nil err))


    (let [wp (^{:inst [x509/Certificate]} weak/Make cert)]
      (if [(values entry loaded) ^{:go/via [Map]} (.LoadOrStore wcc (conv string der) wp)] (not loaded)
        (^{:inst [x509/Certificate any]} runtime/AddCleanup cert ^{:go/end 33} (fn [^any _] ^{:go/via [Map]} (.CompareAndDelete wcc (conv string der) entry)) (conv any (conv string der)))
        (if [v (.Value (assert (weak/Pointer x509/Certificate) entry))] (!= v nil)
          (return v nil)
          (do
            (when ^{:go/via [Map]} (.CompareAndSwap wcc (conv string der) entry wp)
              (^{:inst [x509/Certificate any]} runtime/AddCleanup cert ^{:go/end 38} (fn [^any _] ^{:go/via [Map]} (.CompareAndDelete wcc (conv string der) wp)) (conv any (conv string der)))))))


      (return cert nil))))


(go/var globalCertCache (new weakCertCache))

    ;; On the client side, the next two methods are called in order.



    (^{:doc "This method may not be called if the server doesn't send a\nServerKeyExchange message.\n"} processServerKeyExchange ^error [(* Config) (* clientHelloMsg) (* serverHelloMsg) (* x509/Certificate) (* serverKeyExchangeMsg)])
    (generateClientKeyExchange [(* Config) (* clientHelloMsg) (* x509/Certificate)] :results [(slice byte) (* clientKeyExchangeMsg) error])))



(in-ns 'go.crypto.tls) (go/file "alert.go" :imports [

    ^{:line 7} [strconv "strconv"]])





(go/type AlertError "An AlertError is a TLS alert.\n\nWhen using a QUIC transport, QUICConn methods will return an error\nwhich wraps AlertError rather than sending a TLS alert.\n" uint8)

(go/var ^error _ (conv AlertError 0))

^{:go/end 19} (go/method Error ^string [^AlertError e]
  (.String (conv alert e)))


(go/type alert uint8)

(go/const

  ^{:line 25} [^{:val 1 :doc "alert level\n"} alertLevelWarning 1]
  ^{:line 26} [^{:val 2} alertLevelError 2])


(go/const
  ^{:line 30} [^{:tag alert :val 0} alertCloseNotify 0]

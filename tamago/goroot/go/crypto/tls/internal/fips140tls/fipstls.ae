;; Package fips140tls controls whether crypto/tls requires FIPS-approved settings.
(in-ns 'go.crypto.tls.internal.fips140tls) (go/file "fipstls.go" :doc "Package fips140tls controls whether crypto/tls requires FIPS-approved settings.\n" :imports [


    ^{:line 9} [fips140 "crypto/fips140"]
    ^{:line 10} [atomic "sync/atomic"]])


(go/var ^atomic/Bool required)

^{:go/end 19} (go/func init []
  (when (fips140/Enabled)
    (Force)))





^{:go/end 25} (go/func Force "Force forces crypto/tls to restrict TLS configurations to FIPS-approved settings.\nBy design, this call is impossible to undo (except in tests).\n" []
  (.Store required true))






^{:go/end 33} (go/func Required "Required reports whether FIPS-approved settings are required.\n\nRequired is true if FIPS 140-3 mode is enabled with GODEBUG=fips140=on, or if\nthe crypto/tls/fipsonly package is imported by a Go+BoringCrypto build.\n" ^bool []
  (.Load required))


^{:go/end 37} (go/func TestingOnlyAbandon []
  (.Store required false))

(in-ns 'go.crypto.tls) (go/file "defaults.go" :imports [


    ^{:line 8} [godebug "internal/godebug"]
    ^{:line 9} [slices "slices"]
    ^{:line 10} [_ "unsafe"]]) ; for linkname


;; Defaults are collected in this file to allow distributions to more easily patch
;; them to apply local policies.


(go/var ^{:doc "tlsmlkem=0 restores the pre-Go 1.24 default key exchanges.\n"} tlsmlkem (godebug/New "tlsmlkem"))


(go/var ^{:doc "tlssecpmlkem=0 restores the pre-Go 1.26 default key exchanges.\n"} tlssecpmlkem (godebug/New "tlssecpmlkem"))


^{:go/end 34} (go/func defaultCurveEnabled "defaultCurveEnabled returns whether the key exchange c is enabled by default.\n" ^bool [^CurveID c]
  (switch c
    (case [X25519 CurveP256 CurveP384 CurveP521]
      (return true))
    (case [X25519MLKEM768]
      (return (!= (.Value tlsmlkem) "0")))
    (case [SecP256r1MLKEM768 SecP384r1MLKEM1024]
      (return (and (!= (.Value tlsmlkem) "0") (!= (.Value tlssecpmlkem) "0"))))
    (default
      (return false))))





^{:go/end 43} (go/func curvePreferenceOrder "curvePreferenceOrder is the fixed preference order of key exchanges. It must\ninclude every supported key exchange.\n" ^{:tag (slice CurveID)} []
  (lit (slice CurveID)
    ^{:line 40} X25519MLKEM768 SecP256r1MLKEM768 SecP384r1MLKEM1024 MLKEM1024
    ^{:line 41} X25519 CurveP256 CurveP384 CurveP521))







^{:go/end 67} (go/func defaultSupportedSignatureAlgorithms "defaultSupportedSignatureAlgorithms returns the signature and hash algorithms that\nthe code advertises and supports in a TLS 1.2+ ClientHello and in a TLS 1.2+\nCertificateRequest. The two fields are merged to match with TLS 1.3.\nNote that in TLS 1.2, the ECDSA algorithms are not constrained to P-256, etc.\n" ^{:tag (slice SignatureScheme)} []
  (lit (slice SignatureScheme)
    ^{:line 51} MLDSA44
    ^{:line 52} MLDSA65
    ^{:line 53} MLDSA87
    ^{:line 54} PSSWithSHA256
    ^{:line 55} ECDSAWithP256AndSHA256
    ^{:line 56} Ed25519
    ^{:line 57} PSSWithSHA384
    ^{:line 58} PSSWithSHA512
    ^{:line 59} PKCS1WithSHA256
    ^{:line 60} PKCS1WithSHA384
    ^{:line 61} PKCS1WithSHA512
    ^{:line 62} ECDSAWithP384AndSHA384
    ^{:line 63} ECDSAWithP521AndSHA512
    ^{:line 64} PKCS1WithSHA1
    ^{:line 65} ECDSAWithSHA1))



^{:go/end 75} (go/func supportedCipherSuites ^{:tag (slice uint16)} [^bool aesGCMPreferred]
  (if aesGCMPreferred
    (return (^{:inst [(slice uint16) uint16]} slices/Clone cipherSuitesPreferenceOrder))

    (return (^{:inst [(slice uint16) uint16]} slices/Clone cipherSuitesPreferenceOrderNoAES))))



^{:go/end 82} (go/func defaultCipherSuites ^{:tag (slice uint16)} [^bool aesGCMPreferred]
  (let [cipherSuites (supportedCipherSuites aesGCMPreferred)]
    (^{:inst [(slice uint16) uint16]} slices/DeleteFunc cipherSuites ^{:go/end 81} (fn ^bool [^uint16 c]
        (aget disabledCipherSuites c)))))

















(go/var ^{:doc "defaultCipherSuitesTLS13 is also the preference order, since there are no\ndisabled by default TLS 1.3 cipher suites. The same AES vs ChaCha20 logic as\ncipherSuitesPreferenceOrder applies.\n\ndefaultCipherSuitesTLS13 should be an internal detail,\nbut widely used packages access it using linkname.\nNotable members of the hall of shame include:\n  - github.com/quic-go/quic-go\n  - github.com/sagernet/quic-go\n\nDo not remove or change the type signature.\nSee go.dev/issue/67401.\n" :go/linkname "defaultCipherSuitesTLS13"} defaultCipherSuitesTLS13 (lit (slice uint16)
    ^{:line 99} TLS_AES_128_GCM_SHA256
    ^{:line 100} TLS_AES_256_GCM_SHA384
    ^{:line 101} TLS_CHACHA20_POLY1305_SHA256))












(go/var ^{:doc "defaultCipherSuitesTLS13NoAES should be an internal detail,\nbut widely used packages access it using linkname.\nNotable members of the hall of shame include:\n  - github.com/quic-go/quic-go\n  - github.com/sagernet/quic-go\n\nDo not remove or change the type signature.\nSee go.dev/issue/67401.\n" :go/linkname "defaultCipherSuitesTLS13NoAES"} defaultCipherSuitesTLS13NoAES (lit (slice uint16)
    ^{:line 115} TLS_CHACHA20_POLY1305_SHA256
    ^{:line 116} TLS_AES_128_GCM_SHA256
    ^{:line 117} TLS_AES_256_GCM_SHA384))

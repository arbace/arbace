(in-ns 'go.crypto.tls) (go/file "defaults_fips140.go" :build ["//go:build !boringcrypto"] :imports [


    ^{:line 10} [ecdsa "crypto/ecdsa"]
    ^{:line 11} [ed25519 "crypto/ed25519"]
    ^{:line 12} [elliptic "crypto/elliptic"]
    ^{:line 13} [boring "crypto/internal/boring"]
    ^{:line 14} [mldsa "crypto/mldsa"]
    ^{:line 15} [rsa "crypto/rsa"]
    ^{:line 16} [x509 "crypto/x509"]])


;; These FIPS 140-3 policies allow anything approved by SP 800-140C
;; and SP 800-140D, and tested as part of the Go Cryptographic Module.
;;
;; Notably, not SHA-1, 3DES, RC4, ChaCha20Poly1305, RSA PKCS #1 v1.5 key
;; transport, or TLS 1.0—1.1 (because we don't test its KDF).
;;
;; These are not default lists, but filters to apply to the default or
;; configured lists. Missing items are treated as if they were not implemented.
;;
;; They are applied when the fips140 GODEBUG is "on" or "only".

(go/var
  ^{:line 31} [allowedSupportedVersionsFIPS (lit (slice uint16)
      ^{:line 32} VersionTLS12
      ^{:line 33} VersionTLS13)]

  ^{:line 35} [allowedCurvePreferencesFIPS (lit (slice CurveID)
      ^{:line 36} X25519MLKEM768
      ^{:line 37} SecP256r1MLKEM768
      ^{:line 38} SecP384r1MLKEM1024
      ^{:line 39} MLKEM1024
      ^{:line 40} CurveP256
      ^{:line 41} CurveP384
      ^{:line 42} CurveP521)]

  ^{:line 44} [allowedSignatureAlgorithmsFIPS (lit (slice SignatureScheme)
      ^{:line 45} PSSWithSHA256
      ^{:line 46} ECDSAWithP256AndSHA256
      ^{:line 47} Ed25519
      ^{:line 48} MLDSA44
      ^{:line 49} MLDSA65
      ^{:line 50} MLDSA87
      ^{:line 51} PSSWithSHA384
      ^{:line 52} PSSWithSHA512
      ^{:line 53} PKCS1WithSHA256
      ^{:line 54} PKCS1WithSHA384
      ^{:line 55} PKCS1WithSHA512
      ^{:line 56} ECDSAWithP384AndSHA384
      ^{:line 57} ECDSAWithP521AndSHA512)]

  ^{:line 59} [allowedCipherSuitesFIPS (lit (slice uint16)
      ^{:line 60} TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
      ^{:line 61} TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384
      ^{:line 62} TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256
      ^{:line 63} TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384
      ^{:line 64} TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA256
      ^{:line 65} TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA256)]

  ^{:line 67} [allowedCipherSuitesTLS13FIPS (lit (slice uint16)
      ^{:line 68} TLS_AES_128_GCM_SHA256
      ^{:line 69} TLS_AES_256_GCM_SHA384)])



^{:go/end 87} (go/func isCertificateAllowedFIPS ^bool [^{:tag (* x509/Certificate)} c]
  (type-switch [k (.-PublicKey c)]
    (case [(* rsa/PublicKey)]
      (return (>= (.BitLen (.-N k)) 2048)))
    (case [(* ecdsa/PublicKey)]
      (return (or (== (.-Curve k) (elliptic/P256)) (== (.-Curve k) (elliptic/P384)) (== (.-Curve k) (elliptic/P521)))))
    (case [ed25519/PublicKey]
      (return true))
    (case [(* mldsa/PublicKey)]
      ;; Only for the native module.
      (return (not boring/Enabled)))
    (default
      (return false))))

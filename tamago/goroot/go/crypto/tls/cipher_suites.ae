^{:go/breaks [[6 397]] :go/end 398} (go/func isAESGCMPreferred "isAESGCMPreferred returns whether we have hardware support for AES-GCM, and the\nfirst known cipher in the peer's preference list is an AES-GCM cipher,\nimplying the peer also has hardware support for it.\n" ^bool [^{:tag (slice uint16)} ciphers]

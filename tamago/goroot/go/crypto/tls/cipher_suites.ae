    (return false))

  (range [_ cID ciphers]
    (when [c (cipherSuiteByID cID)] (!= c nil)
      (return (aget aesgcmCiphers cID)))

    (when [c (cipherSuiteTLS13ByID cID)] (!= c nil)
      (return (aget aesgcmCiphers cID))))


  false)



    (== (subtle/ConstantTimeCompare priv xx) 1)))





^{:go/end 82} (go/method Seed "Seed returns the private key seed corresponding to priv. It is provided for\ninteroperability with RFC 8032. RFC 8032's private keys correspond to seeds\nin this package.\n" ^{:tag (slice byte)} [^PrivateKey priv]
  (append (make (slice byte) 0 SeedSize) (spread (subslice priv _ SeedSize))))





^{:go/end 184} (go/func GenerateKey "GenerateKey generates a public/private key pair using entropy from random.\n\nIf random is nil, a secure random source is used. (Before Go 1.26, a custom\n[crypto/rand.Reader] was used if set by the application. That behavior can be\nrestored with GODEBUG=cryptocustomrand=1. This setting will be removed in a\nfuture Go release. Instead, use [testing/cryptotest.SetGlobalRandom].)\n\nThe output of this function is deterministic, and equivalent to reading\n[SeedSize] bytes from random, and passing them to [NewKeyFromSeed].\n" [^io/Reader random] :results [PublicKey PrivateKey error]
  (when (== random nil)
    (if (== (.Value cryptocustomrand) "1") (do
        (set! random cryptorand/Reader)
        (when (not (rand/IsDefaultReader random))
          (.IncNonDefault cryptocustomrand)))


      (set! random rand/Reader)))



  (when (and (fips140only/Enforced) (not (fips140only/ApprovedRandomReader random)))
    (return nil nil (errors/New "crypto/ed25519: only crypto/rand.Reader is allowed in FIPS 140-only mode")))


  (when (rand/IsDefaultReader random)
    (let [(values privateKey err) (ed25519/GenerateKey)]
      (when (!= err nil)
        (return nil nil err))

      (let [publicKey (conv PublicKey (.PublicKey privateKey))]
        (return publicKey (conv PrivateKey (.Bytes privateKey)) nil))))



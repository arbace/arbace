(go/type Options "Options can be used with [PrivateKey.Sign] or [VerifyWithOptions]\nto select Ed25519 variants.\n" (struct

    ^{:line 130 :tag crypto/Hash :doc "Hash can be zero for regular Ed25519, or crypto.SHA512 for Ed25519ph.\n"} Hash



    ^{:line 134 :tag string :doc "Context, if not empty, selects Ed25519ctx or provides the context string\nfor Ed25519ph. It can be at most 255 bytes in length.\n"} Context))



^{:go/end 138} (go/method HashFunc "HashFunc returns o.Hash.\n" ^crypto/Hash [^{:tag (* Options)} o] (.-Hash o))


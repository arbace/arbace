  ^{:line 36} [^{:val 64 :doc "PrivateKeySize is the size, in bytes, of private keys as used in this package.\n"} PrivateKeySize 64]

  ^{:line 38} [^{:val 64 :doc "SignatureSize is the size, in bytes, of signatures generated and verified by this package.\n"} SignatureSize 64]

  ^{:line 40} [^{:val 32 :doc "SeedSize is the size, in bytes, of private key seeds. These are the private key representations used by RFC 8032.\n"} SeedSize 32])



(go/type PublicKey "PublicKey is the type of Ed25519 public keys.\n" (slice byte))

;; Any methods implemented on PublicKey might need to also be implemented on
;; PrivateKey, as the latter embeds the former and will expose its methods.


^{:go/end 56} (go/method Equal "Equal reports whether pub and x have the same value.\n" ^bool [^PublicKey pub ^crypto/PublicKey x]
  (let [(values xx ok) (assert PublicKey x)]
    (when (not ok)
      (return false))

    (== (subtle/ConstantTimeCompare pub xx) 1)))



(go/type PrivateKey "PrivateKey is the type of Ed25519 private keys. It implements [crypto.Signer].\n" (slice byte))


^{:go/end 66} (go/method Public "Public returns the [PublicKey] corresponding to priv.\n" ^crypto/PublicKey [^PrivateKey priv]

(in-ns 'go.unique) (go/file "clone.go" :imports [


    ^{:line 8} [abi "internal/abi"]
    ^{:line 9} [stringslite "internal/stringslite"]
    ^{:line 10} [unsafe "unsafe"]])










^{:go/end 27} (go/func clone "clone makes a copy of value, and may update string values found in value\nwith a cloned version of those strings. The purpose of explicitly cloning\nstrings is to avoid accidentally giving a large string a long lifetime.\n\nNote that this will clone strings in structs and arrays found in value,\nand will clone value if it itself is a string. It will not, however, clone\nstrings if value is of interface or slice type (that is, found via an\nindirection).\n" :type-params [^comparable T] ^T [^T value ^{:tag (* cloneSeq)} seq]
  (range [_ offset (.-stringOffsets seq)]
    (let [ps (conv (* string) (conv unsafe/Pointer (+ (conv uintptr (conv unsafe/Pointer (addr value))) offset)))]
      (set! @ps (stringslite/Clone @ps))))

  (^{:inst [T]} abi/EscapeToResultNonString value))



(go/var ^{:doc "singleStringClone describes how to clone a single string.\n"} singleStringClone (lit cloneSeq :stringOffsets (lit (slice uintptr) 0)))


(go/type cloneSeq "cloneSeq describes how to clone a value of a particular type.\n" (struct
    ^{:line 34 :tag (slice uintptr)} stringOffsets))



^{:go/end 53} (go/func makeCloneSeq "makeCloneSeq creates a cloneSeq for a type.\n" ^cloneSeq [^{:tag (* abi/Type)} typ]
  (when (== typ nil)
    (return (lit cloneSeq)))

  (when (== (.Kind typ) abi/String)
    (return singleStringClone))

  (let [^cloneSeq seq (zero cloneSeq)]
    (switch (.Kind typ)
      (case [abi/Struct]
        (buildStructCloneSeq typ (addr seq) 0))
      (case [abi/Array]
        (buildArrayCloneSeq typ (addr seq) 0)))

    ^{:line 52} seq))



^{:go/end 69} (go/func buildStructCloneSeq "buildStructCloneSeq populates a cloneSeq for an abi.Type that has Kind abi.Struct.\n" [^{:tag (* abi/Type)} typ ^{:tag (* cloneSeq)} seq ^uintptr baseOffset]
  (let [styp (.StructType typ)]
    (range [i (.-Fields styp)]
      (let [f (addr (aget (.-Fields styp) i))]
        (switch (.Kind (.-Typ f))
          (case [abi/String]
            (set! (.-stringOffsets seq) (append (.-stringOffsets seq) (+ baseOffset (.-Offset f)))))
          (case [abi/Struct]
            (buildStructCloneSeq (.-Typ f) seq (+ baseOffset (.-Offset f))))
          (case [abi/Array]
            (buildArrayCloneSeq (.-Typ f) seq (+ baseOffset (.-Offset f)))))))))





^{:go/end 89} (go/func buildArrayCloneSeq "buildArrayCloneSeq populates a cloneSeq for an abi.Type that has Kind abi.Array.\n" [^{:tag (* abi/Type)} typ ^{:tag (* cloneSeq)} seq ^uintptr baseOffset]
  (let [atyp (.ArrayType typ)
      ^{:line 74} etyp (.-Elem atyp)
      ^{:line 75} offset baseOffset]
    (range [(.-Len atyp)]
      (switch (.Kind etyp)
        (case [abi/String]
          (set! (.-stringOffsets seq) (append (.-stringOffsets seq) offset)))
        (case [abi/Struct]
          (buildStructCloneSeq etyp seq offset))
        (case [abi/Array]
          (buildArrayCloneSeq etyp seq offset)))

      (set! offset + (.Size etyp))
      (let [align (conv uintptr (.FieldAlign etyp))]
        (set! offset (bit-and-not (- (+ offset align) 1) (- align 1)))))))

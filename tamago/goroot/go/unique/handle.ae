(go/var ^uintptr zero)






(go/type Handle "Handle is a globally unique identity for some value of type T.\n\nTwo handles compare equal exactly if the two values used to create the handles\nwould have also compared equal. The comparison of two handles is trivial and\ntypically much more efficient than comparing the values used to create them.\n" :type-params [^comparable T] (struct
    ^{:line 21 :tag (* T)} value))




^{:go/end 28} (go/method Value "Value returns a shallow copy of the T value that produced the Handle.\nValue is safe for concurrent use by multiple goroutines.\n" ^T [^{:tag (Handle T)} h]
  ^{:line 27} @(.-value h))





^{:go/end 53} (go/func Make "Make returns a globally unique handle for a value of type T. Handles\nare equal if and only if the values used to produce them are equal.\nMake is safe for concurrent use by multiple goroutines.\n" :type-params [^comparable T] ^{:tag (Handle T)} [^T value]
  ;; Find the map for type T.
  (let [typ ((inst abi/TypeFor T))]
    (when (== (.Size typ) 0)
      (return (lit (Handle T) (conv (* T) (conv unsafe/Pointer (addr zero))))))

    (let [(values ma ok) (.Load uniqueMaps typ)]
      (when (not ok)
        (let [m (addr (lit (uniqueMap T) :canonMap ((inst newCanonMap T)) :cloneSeq (makeCloneSeq typ)))]
          (set! (values ma _) (.LoadOrStore uniqueMaps typ m))))

      (let [m (assert (* (uniqueMap T)) ma)

          ;; Find the value in the map.
          ^{:line 47} ptr ^{:go/via [canonMap]} (.Load m value)]
        (when (== ptr nil)
          ;; Insert a new value into the map.
          (set! ptr ^{:go/via [canonMap]} (.LoadOrStore m (^{:inst [T]} clone value (addr (.-cloneSeq m))))))

        (lit (Handle T) ptr)))))











(go/var ^{:tag (isync/HashTrieMap (* abi/Type) any) :doc "uniqueMaps is an index of type-specific concurrent maps used for unique.Make.\n\nThe two-level map might seem odd at first since the HashTrieMap could have \"any\"\nas its key type, but the issue is escape analysis. We do not want to force lookups\nto escape the argument, and using a type-specific map allows us to avoid that where\npossible (for example, for strings and plain-ol'-data structs). We also get the\nbenefit of not cramming every different type into a single map, but that's certainly\nnot enough to outweigh the cost of two map lookups. What is worth it though, is saving\non those allocations.\n"} uniqueMaps) ; any is always a *uniqueMap[T].


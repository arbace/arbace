(ns go.vendor.golang_org.x.sys.cpu
  (:require [arbace.go :as go]))

(go/package cpu
  :path "vendor/golang.org/x/sys/cpu"
  :files ["byteorder.go" "cpu.go" "cpu_arm64.go" "cpu_gc_arm64.go" "cpu_gc_x86.go" "cpu_other_arm64.go" "cpu_other_x86.go" "cpu_x86.go" "endian_little.go" "parse.go" "runtime_auxv.go" "runtime_auxv_go121.go"]
  :other-files ["cpu_arm64.s" "cpu_gc_x86.s"]
  :positions :lines)

(load "cpu/byteorder")
(load "cpu/cpu")
(load "cpu/cpu_arm64")
(load "cpu/cpu_gc_arm64")
(load "cpu/cpu_gc_x86")
(load "cpu/cpu_other_arm64")
(load "cpu/cpu_other_x86")
(load "cpu/cpu_x86")
(load "cpu/endian_little")
(load "cpu/parse")
(load "cpu/runtime_auxv")
(load "cpu/runtime_auxv_go121")

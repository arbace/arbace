(ns go.vendor.golang_org.x.sys.cpu
  (:require [arbace.go :as go]))

(go/package cpu
  :path "vendor/golang.org/x/sys/cpu"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["byteorder.go" "cpu.go" "cpu_gc_x86.go" "cpu_other_x86.go" "cpu_x86.go" "endian_little.go" "parse.go" "runtime_auxv.go" "runtime_auxv_go121.go"]
  :other-files ["cpu_gc_x86.s"]
  :init-order []
  :positions :lines)

(load "cpu/byteorder")
(load "cpu/cpu")
(load "cpu/cpu_gc_x86")
(load "cpu/cpu_other_x86")
(load "cpu/cpu_x86")
(load "cpu/endian_little")
(load "cpu/parse")
(load "cpu/runtime_auxv")
(load "cpu/runtime_auxv_go121")

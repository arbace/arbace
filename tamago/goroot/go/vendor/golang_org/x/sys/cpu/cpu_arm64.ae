(in-ns 'go.vendor.golang_org.x.sys.cpu) (go/file "cpu_arm64.go" :imports [

    ^{:line 7} [runtime "runtime"]])




(go/const ^{:val 128 :doc "cacheLineSize is used to prevent false sharing of cache lines.\nWe choose 128 because Apple Silicon, a.k.a. M1, has 128-byte cache line size.\nIt doesn't cost much and is much more future-proof.\n"} cacheLineSize 128)

^{:go/end 44} (go/func initOptions []
  (set! options (lit (slice option)
      (lit _ :Name "fp" :Feature (addr (.-HasFP ARM64)))
      (lit _ :Name "asimd" :Feature (addr (.-HasASIMD ARM64)))
      (lit _ :Name "evstrm" :Feature (addr (.-HasEVTSTRM ARM64)))
      (lit _ :Name "aes" :Feature (addr (.-HasAES ARM64)))
      (lit _ :Name "fphp" :Feature (addr (.-HasFPHP ARM64)))
      (lit _ :Name "jscvt" :Feature (addr (.-HasJSCVT ARM64)))
      (lit _ :Name "lrcpc" :Feature (addr (.-HasLRCPC ARM64)))
      (lit _ :Name "pmull" :Feature (addr (.-HasPMULL ARM64)))
      (lit _ :Name "sha1" :Feature (addr (.-HasSHA1 ARM64)))
      (lit _ :Name "sha2" :Feature (addr (.-HasSHA2 ARM64)))
      (lit _ :Name "sha3" :Feature (addr (.-HasSHA3 ARM64)))
      (lit _ :Name "sha512" :Feature (addr (.-HasSHA512 ARM64)))
      (lit _ :Name "sm3" :Feature (addr (.-HasSM3 ARM64)))
      (lit _ :Name "sm4" :Feature (addr (.-HasSM4 ARM64)))
      (lit _ :Name "sve" :Feature (addr (.-HasSVE ARM64)))
      (lit _ :Name "sve2" :Feature (addr (.-HasSVE2 ARM64)))
      (lit _ :Name "crc32" :Feature (addr (.-HasCRC32 ARM64)))
      (lit _ :Name "atomics" :Feature (addr (.-HasATOMICS ARM64)))
      (lit _ :Name "asimdhp" :Feature (addr (.-HasASIMDHP ARM64)))
      (lit _ :Name "cpuid" :Feature (addr (.-HasCPUID ARM64)))
      (lit _ :Name "asimrdm" :Feature (addr (.-HasASIMDRDM ARM64)))
      (lit _ :Name "fcma" :Feature (addr (.-HasFCMA ARM64)))
      (lit _ :Name "dcpop" :Feature (addr (.-HasDCPOP ARM64)))
      (lit _ :Name "asimddp" :Feature (addr (.-HasASIMDDP ARM64)))
      (lit _ :Name "asimdfhm" :Feature (addr (.-HasASIMDFHM ARM64)))
      (lit _ :Name "dit" :Feature (addr (.-HasDIT ARM64)))
      (lit _ :Name "i8mm" :Feature (addr (.-HasI8MM ARM64))))))



^{:go/end 53} (go/func archInit []
  (if (== runtime/GOOS "freebsd")
    (readARM64Registers)

    ;; Most platforms don't seem to allow directly reading these registers.
    (doinit)))





^{:go/end 60} (go/func setMinimalFeatures "setMinimalFeatures fakes the minimal ARM64 features expected by\nTestARM64minimalFeatures.\n" []
  (set! (.-HasASIMD ARM64) true)
  (set! (.-HasFP ARM64) true))


^{:go/end 66} (go/func readARM64Registers []
  (set! Initialized true)

  (parseARM64SystemRegisters (getisar0) (getisar1) (getpfr0)))


^{:go/end 180} (go/func parseARM64SystemRegisters [^uint64 isar0 ^uint64 isar1 ^uint64 pfr0]
  ;; ID_AA64ISAR0_EL1
  (switch (extractBits isar0 4 7)
    (case [1]
      (set! (.-HasAES ARM64) true))
    (case [2]
      (set! (.-HasAES ARM64) true)
      (set! (.-HasPMULL ARM64) true)))


  (switch (extractBits isar0 8 11)
    (case [1]
      (set! (.-HasSHA1 ARM64) true)))


  (switch (extractBits isar0 12 15)
    (case [1]
      (set! (.-HasSHA2 ARM64) true))
    (case [2]
      (set! (.-HasSHA2 ARM64) true)
      (set! (.-HasSHA512 ARM64) true)))


  (switch (extractBits isar0 16 19)
    (case [1]
      (set! (.-HasCRC32 ARM64) true)))


  (switch (extractBits isar0 20 23)
    (case [2]
      (set! (.-HasATOMICS ARM64) true)))


  (switch (extractBits isar0 28 31)
    (case [1]
      (set! (.-HasASIMDRDM ARM64) true)))


  (switch (extractBits isar0 32 35)
    (case [1]
      (set! (.-HasSHA3 ARM64) true)))


  (switch (extractBits isar0 36 39)
    (case [1]
      (set! (.-HasSM3 ARM64) true)))


  (switch (extractBits isar0 40 43)
    (case [1]
      (set! (.-HasSM4 ARM64) true)))


  (switch (extractBits isar0 44 47)
    (case [1]
      (set! (.-HasASIMDDP ARM64) true)))


  ;; ID_AA64ISAR1_EL1
  (switch (extractBits isar1 0 3)
    (case [1]
      (set! (.-HasDCPOP ARM64) true)))


  (switch (extractBits isar1 12 15)
    (case [1]
      (set! (.-HasJSCVT ARM64) true)))


  (switch (extractBits isar1 16 19)
    (case [1]
      (set! (.-HasFCMA ARM64) true)))


  (switch (extractBits isar1 20 23)
    (case [1]
      (set! (.-HasLRCPC ARM64) true)))


  (switch (extractBits isar1 52 55)
    (case [1]
      (set! (.-HasI8MM ARM64) true)))


  ;; ID_AA64PFR0_EL1
  (switch (extractBits pfr0 16 19)
    (case [0]
      (set! (.-HasFP ARM64) true))
    (case [1]
      (set! (.-HasFP ARM64) true)
      (set! (.-HasFPHP ARM64) true)))


  (switch (extractBits pfr0 20 23)
    (case [0]
      (set! (.-HasASIMD ARM64) true))
    (case [1]
      (set! (.-HasASIMD ARM64) true)
      (set! (.-HasASIMDHP ARM64) true)))


  (switch (extractBits pfr0 32 35)
    (case [1]
      (set! (.-HasSVE ARM64) true)

      (parseARM64SVERegister (getzfr0))))


  (switch (extractBits pfr0 48 51)
    (case [1]
      (set! (.-HasDIT ARM64) true))))



^{:go/end 187} (go/func parseARM64SVERegister [^uint64 zfr0]
  (switch (extractBits zfr0 0 3)
    (case [1]
      (set! (.-HasSVE2 ARM64) true))))



^{:go/end 191} (go/func extractBits ^uint [^uint64 data ^uint start ^uint end]
  (bit-and (conv uint (>> data start)) (- ^uint (<< 1 (+ (- end start) 1)) 1)))

^{:go/end 258} (go/func init []
  (archInit)
  (initOptions)
  (processOptions))






(go/var ^{:tag (slice option) :doc "options contains the cpu debug options that can be used in GODEBUG.\nOptions are arch dependent and are added by the arch specific initOptions functions.\nFeatures that are mandatory for the specific GOARCH should have the Required field set\n(e.g. SSE2 on amd64).\n"} options)


(go/type option "Option names should be lower case. e.g. avx instead of AVX.\n" (struct
    ^{:line 268 :tag string} Name
    ^{:line 269 :tag (* bool)} Feature
    ^{:line 270 :tag bool} Specified ; whether feature value was specified in GODEBUG
    ^{:line 271 :tag bool} Enable ; whether feature should be enabled
    ^{:line 272 :tag bool} Required)) ; whether feature is mandatory and can not be disabled


^{:go/end 343} (go/func processOptions []
  (let [env (os/Getenv "GODEBUG")]
    (label :field
      (while (!= env "")
        (let [field ""
            ^{:line 280} i (strings/IndexByte env \,)]
          (if (< i 0)
            (set! (values field env) (values env ""))

            (set! (values field env) (values (subslice env _ i) (subslice env (+ i 1)))))

          (when (or (< (len field) 4) (!= (subslice field _ 4) "cpu."))
            (continue))

          (set! i (strings/IndexByte field \=))
          (when (< i 0)
            (print "GODEBUG sys/cpu: no value specified for \"" field "\"\n")
            (continue))

          (let [(values key value) (values (subslice field 4 i) (subslice field (+ i 1))) ; e.g. "SSE2", "on"

              ^{:line 296 :tag bool} enable (zero bool)]
            (switch value
              (case ["on"]
                (set! enable true))
              (case ["off"]
                (set! enable false))
              (default
                (print "GODEBUG sys/cpu: value \"" value "\" not supported for cpu option \"" key "\"\n")
                (continue :field)))


            (when (== key "all")
              (range [i options]
                (set! (.-Specified (aget options i)) true)
                (set! (.-Enable (aget options i)) (or enable (.-Required (aget options i)))))

              (continue :field))


            (range [i options]
              (when (== (.-Name (aget options i)) key)
                (set! (.-Specified (aget options i)) true)
                (set! (.-Enable (aget options i)) enable)
                (continue :field)))



            (print "GODEBUG sys/cpu: unknown cpu feature \"" key "\"\n")))))


    (range [_ o options]
      (when (not (.-Specified o))
        (continue))


      (when (and (.-Enable o) (not @(.-Feature o)))
        (print "GODEBUG sys/cpu: can not enable \"" (.-Name o) "\", missing CPU support\n")
        (continue))


      (when (and (not (.-Enable o)) (.-Required o))
        (print "GODEBUG sys/cpu: can not disable \"" (.-Name o) "\", required CPU feature\n")
        (continue))


      (set! @(.-Feature o) (.-Enable o)))))

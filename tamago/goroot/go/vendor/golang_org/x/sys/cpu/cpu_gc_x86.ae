(in-ns 'go.vendor.golang_org.x.sys.cpu) (go/file "cpu_gc_x86.go" :build ["//go:build (386 || amd64 || amd64p32) && gc"] :imports [])



(go/func ^:extern cpuid "cpuid is implemented in cpu_gc_x86.s for gc compiler\nand in cpu_gccgo.c for gccgo.\n" [^uint32 eaxArg ^uint32 ecxArg] :results [^uint32 eax ^uint32 ebx ^uint32 ecx ^uint32 edx])



(go/func ^:extern xgetbv "xgetbv with ecx = 0 is implemented in cpu_gc_x86.s for gc compiler\nand in cpu_gccgo.c for gccgo.\n" [] :results [^uint32 eax ^uint32 edx])

(in-ns 'go.vendor.golang_org.x.sys.cpu) (go/file "byteorder.go" :imports [


    ^{:line 8} [runtime "runtime"]])



(go/type byteOrder "byteOrder is a subset of encoding/binary.ByteOrder.\n" (interface
    (Uint32 ^uint32 [(slice byte)])
    (Uint64 ^uint64 [(slice byte)])))


(go/type littleEndian (struct))
(go/type bigEndian (struct))

^{:go/end 23} (go/method Uint32 ^uint32 [littleEndian ^{:tag (slice byte)} b]
  (set! _ (aget b 3)) ; bounds check hint to compiler; see golang.org/issue/14808
  (bit-or (conv uint32 (aget b 0)) (<< (conv uint32 (aget b 1)) 8) (<< (conv uint32 (aget b 2)) 16) (<< (conv uint32 (aget b 3)) 24)))


^{:go/end 29} (go/method Uint64 ^uint64 [littleEndian ^{:tag (slice byte)} b]
  (set! _ (aget b 7)) ; bounds check hint to compiler; see golang.org/issue/14808
  (bit-or (conv uint64 (aget b 0)) (<< (conv uint64 (aget b 1)) 8) (<< (conv uint64 (aget b 2)) 16) (<< (conv uint64 (aget b 3)) 24)
    (<< (conv uint64 (aget b 4)) 32) (<< (conv uint64 (aget b 5)) 40) (<< (conv uint64 (aget b 6)) 48) (<< (conv uint64 (aget b 7)) 56)))


^{:go/end 34} (go/method Uint32 ^uint32 [bigEndian ^{:tag (slice byte)} b]
  (set! _ (aget b 3)) ; bounds check hint to compiler; see golang.org/issue/14808
  (bit-or (conv uint32 (aget b 3)) (<< (conv uint32 (aget b 2)) 8) (<< (conv uint32 (aget b 1)) 16) (<< (conv uint32 (aget b 0)) 24)))


^{:go/end 40} (go/method Uint64 ^uint64 [bigEndian ^{:tag (slice byte)} b]
  (set! _ (aget b 7)) ; bounds check hint to compiler; see golang.org/issue/14808
  (bit-or (conv uint64 (aget b 7)) (<< (conv uint64 (aget b 6)) 8) (<< (conv uint64 (aget b 5)) 16) (<< (conv uint64 (aget b 4)) 24)
    (<< (conv uint64 (aget b 3)) 32) (<< (conv uint64 (aget b 2)) 40) (<< (conv uint64 (aget b 1)) 48) (<< (conv uint64 (aget b 0)) 56)))




^{:go/end 66} (go/func hostByteOrder "hostByteOrder returns littleEndian on little-endian machines and\nbigEndian on big-endian machines.\n" ^byteOrder []
  (switch runtime/GOARCH
    (case ^{:go/breaks [3 4 6 7 10 11 12 14]} ["386" "amd64" "amd64p32"
        "alpha"
        "arm" "arm64"
        "loong64"
        "mipsle" "mips64le" "mips64p32le"
        "nios2"
        "ppc64le"
        "riscv" "riscv64"
        "sh"]
      (return (lit littleEndian)))
    (case ^{:go/breaks [2 3 6 8 10 11]} ["armbe" "arm64be"
        "m68k"
        "mips" "mips64" "mips64p32"
        "ppc" "ppc64"
        "s390" "s390x"
        "shbe"
        "sparc" "sparc64"]
      (return (lit bigEndian))))

  (panic "unknown architecture"))

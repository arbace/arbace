(in-ns 'go.vendor.golang_org.x.sys.cpu) (go/file "runtime_auxv.go" :imports [])



(go/var ^{:tag (func [] [(slice uintptr)]) :doc "getAuxvFn is non-nil on Go 1.21+ (via runtime_auxv_go121.go init)\non platforms that use auxv.\n"} getAuxvFn)

^{:go/end 16} (go/func getAuxv ^{:tag (slice uintptr)} []
  (when (== getAuxvFn nil)
    (return nil))

  (getAuxvFn))

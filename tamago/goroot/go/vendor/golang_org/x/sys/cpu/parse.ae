(in-ns 'go.vendor.golang_org.x.sys.cpu) (go/file "parse.go" :imports [

    ^{:line 7} [strconv "strconv"]])






^{:go/end 43} (go/func parseRelease "parseRelease parses a dot-separated version number. It follows the semver\nsyntax, but allows the minor and patch versions to be elided.\n\nThis is a copy of the Go runtime's parseRelease from\nhttps://golang.org/cl/209597.\n" [^string rel] :results [^int major ^int minor ^int patch ^bool ok]
  ;; Strip anything after a dash or plus.
  (range [i (len rel)]
    (when (or (== (aget rel i) \-) (== (aget rel i) \+))
      (set! rel (subslice rel _ i))
      (break)))



  (let [next ^{:go/end 34} (fn [] :results [int bool]
        (range [i (len rel)]
          (when (== (aget rel i) \.)
            (let [(values ver err) (strconv/Atoi (subslice rel _ i))]
              (set! rel (subslice rel (+ i 1)))
              (return ver (== err nil)))))


        (let [(values ver err) (strconv/Atoi rel)]
          (set! rel "")
          (return ver (== err nil))))]

    (when [(set! (values major ok) (next))] (or (not ok) (== rel ""))
      (return))

    (when [(set! (values minor ok) (next))] (or (not ok) (== rel ""))
      (return))

    (set! (values patch ok) (next))
    (return)))

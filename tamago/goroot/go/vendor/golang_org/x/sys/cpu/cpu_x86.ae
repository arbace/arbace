      (lit _ :Name "avx512vaes" :Feature (addr (.-HasAVX512VAES X86)))
      (lit _ :Name "avx512vbmi2" :Feature (addr (.-HasAVX512VBMI2 X86)))
      (lit _ :Name "avx512bitalg" :Feature (addr (.-HasAVX512BITALG X86)))
      (lit _ :Name "avx512bf16" :Feature (addr (.-HasAVX512BF16 X86)))
      (lit _ :Name "amxtile" :Feature (addr (.-HasAMXTile X86)))
      (lit _ :Name "amxint8" :Feature (addr (.-HasAMXInt8 X86)))
      (lit _ :Name "amxbf16" :Feature (addr (.-HasAMXBF16 X86)))
      (lit _ :Name "bmi1" :Feature (addr (.-HasBMI1 X86)))
      (lit _ :Name "bmi2" :Feature (addr (.-HasBMI2 X86)))
      (lit _ :Name "cx16" :Feature (addr (.-HasCX16 X86)))
      (lit _ :Name "erms" :Feature (addr (.-HasERMS X86)))

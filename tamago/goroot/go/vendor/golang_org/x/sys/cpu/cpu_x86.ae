      (lit _ :Name "sse41" :Feature (addr (.-HasSSE41 X86)))
      (lit _ :Name "sse42" :Feature (addr (.-HasSSE42 X86)))
      (lit _ :Name "ssse3" :Feature (addr (.-HasSSSE3 X86)))
      (lit _ :Name "avxifma" :Feature (addr (.-HasAVXIFMA X86)))
      (lit _ :Name "avxvnni" :Feature (addr (.-HasAVXVNNI X86)))
      (lit _ :Name "avxvnniint8" :Feature (addr (.-HasAVXVNNIInt8 X86)))

      ;; These capabilities should always be enabled on amd64:
      (lit _ :Name "sse2" :Feature (addr (.-HasSSE2 X86)) :Required (== runtime/GOARCH "amd64")))))



^{:go/end 232} (go/func archInit []

  ;; From internal/cpu
  (let [
      ;; eax bits
      ^:const ^{:line 70 :val 16} cpuid_AVXVNNI (<< 1 4)

      ;; ecx bits
      ^:const ^:go/grouped ^{:line 73 :val 1} cpuid_SSE3 (<< 1 0)
      ^:const ^:go/grouped ^{:line 74 :val 2} cpuid_PCLMULQDQ (<< 1 1)
      ^:const ^:go/grouped ^{:line 75 :val 2} cpuid_AVX512VBMI (<< 1 1)
      ^:const ^:go/grouped ^{:line 76 :val 64} cpuid_AVX512VBMI2 (<< 1 6)
      ^:const ^:go/grouped ^{:line 77 :val 512} cpuid_SSSE3 (<< 1 9)
      ^:const ^:go/grouped ^{:line 78 :val 256} cpuid_AVX512GFNI (<< 1 8)
      ^:const ^:go/grouped ^{:line 79 :val 512} cpuid_AVX512VAES (<< 1 9)
      ^:const ^:go/grouped ^{:line 80 :val 2048} cpuid_AVX512VNNI (<< 1 11)
      ^:const ^:go/grouped ^{:line 81 :val 4096} cpuid_AVX512BITALG (<< 1 12)
      ^:const ^:go/grouped ^{:line 82 :val 4096} cpuid_FMA (<< 1 12)
      ^:const ^:go/grouped ^{:line 83 :val 16384} cpuid_AVX512VPOPCNTDQ (<< 1 14)
      ^:const ^:go/grouped ^{:line 84 :val 524288} cpuid_SSE41 (<< 1 19)
      ^:const ^:go/grouped ^{:line 85 :val 1048576} cpuid_SSE42 (<< 1 20)
      ^:const ^:go/grouped ^{:line 86 :val 8388608} cpuid_POPCNT (<< 1 23)
      ^:const ^:go/grouped ^{:line 87 :val 33554432} cpuid_AES (<< 1 25)
      ^:const ^:go/grouped ^{:line 88 :val 134217728} cpuid_OSXSAVE (<< 1 27)
      ^:const ^:go/grouped ^{:line 89 :val 268435456} cpuid_AVX (<< 1 28)

      ;; "Extended Feature Flag" bits returned in EBX for CPUID EAX=0x7 ECX=0x0
      ^:const ^:go/grouped ^{:line 92 :val 8} cpuid_BMI1 (<< 1 3)
      ^:const ^:go/grouped ^{:line 93 :val 32} cpuid_AVX2 (<< 1 5)
      ^:const ^:go/grouped ^{:line 94 :val 256} cpuid_BMI2 (<< 1 8)
      ^:const ^:go/grouped ^{:line 95 :val 512} cpuid_ERMS (<< 1 9)
      ^:const ^:go/grouped ^{:line 96 :val 65536} cpuid_AVX512F (<< 1 16)
      ^:const ^:go/grouped ^{:line 97 :val 131072} cpuid_AVX512DQ (<< 1 17)
      ^:const ^:go/grouped ^{:line 98 :val 524288} cpuid_ADX (<< 1 19)
      ^:const ^:go/grouped ^{:line 99 :val 268435456} cpuid_AVX512CD (<< 1 28)
      ^:const ^:go/grouped ^{:line 100 :val 536870912} cpuid_SHA (<< 1 29)
      ^:const ^:go/grouped ^{:line 101 :val 1073741824} cpuid_AVX512BW (<< 1 30)
      ^:const ^:go/grouped ^{:line 102 :val 2147483648} cpuid_AVX512VL (<< 1 31)

      ;; "Extended Feature Flag" bits returned in ECX for CPUID EAX=0x7 ECX=0x0
      ^:const ^:go/grouped ^{:line 105 :val 2} cpuid_AVX512_VBMI (<< 1 1)
      ^:const ^:go/grouped ^{:line 106 :val 64} cpuid_AVX512_VBMI2 (<< 1 6)
      ^:const ^:go/grouped ^{:line 107 :val 256} cpuid_GFNI (<< 1 8)
      ^:const ^:go/grouped ^{:line 108 :val 1024} cpuid_AVX512VPCLMULQDQ (<< 1 10)
      ^:const ^:go/grouped ^{:line 109 :val 4096} cpuid_AVX512_BITALG (<< 1 12)

      ;; edx bits
      ^:const ^:go/grouped ^{:line 112 :val 16} cpuid_FSRM (<< 1 4)
      ;; edx bits for CPUID 0x80000001
      ^:const ^:go/grouped ^{:line 114 :val 134217728} cpuid_RDTSCP (<< 1 27)

      ;; Additional constants not in internal/cpu

      ;; eax=1: edx
      ^:const ^{:line 119 :val 67108864} cpuid_SSE2 (<< 1 26)
      ;; eax=1: ecx
      ^:const ^:go/grouped ^{:line 121 :val 8192} cpuid_CX16 (<< 1 13)
      ^:const ^:go/grouped ^{:line 122 :val 1073741824} cpuid_RDRAND (<< 1 30)
      ;; eax=7,ecx=0: ebx
      ^:const ^:go/grouped ^{:line 124 :val 262144} cpuid_RDSEED (<< 1 18)
      ^:const ^:go/grouped ^{:line 125 :val 2097152} cpuid_AVX512IFMA (<< 1 21)
      ^:const ^:go/grouped ^{:line 126 :val 67108864} cpuid_AVX512PF (<< 1 26)
      ^:const ^:go/grouped ^{:line 127 :val 134217728} cpuid_AVX512ER (<< 1 27)
      ;; eax=7,ecx=0: edx
      ^:const ^:go/grouped ^{:line 129 :val 4} cpuid_AVX5124VNNIW (<< 1 2)
      ^:const ^:go/grouped ^{:line 130 :val 8} cpuid_AVX5124FMAPS (<< 1 3)
      ^:const ^:go/grouped ^{:line 131 :val 4194304} cpuid_AMXBF16 (<< 1 22)
      ^:const ^:go/grouped ^{:line 132 :val 16777216} cpuid_AMXTile (<< 1 24)
      ^:const ^:go/grouped ^{:line 133 :val 33554432} cpuid_AMXInt8 (<< 1 25)
      ;; eax=7,ecx=1: eax
      ^:const ^:go/grouped ^{:line 135 :val 32} cpuid_AVX512BF16 (<< 1 5)
      ^:const ^:go/grouped ^{:line 136 :val 8388608} cpuid_AVXIFMA (<< 1 23)
      ;; eax=7,ecx=1: edx
      ^:const ^:go/grouped ^{:line 138 :val 16} cpuid_AVXVNNIInt8 (<< 1 4)]


    (set! Initialized true)

    (let [(values maxID _ _ _) (cpuid 0 0)]

      (when (< maxID 1)
        (return))


      (let [(values _ _ ecx1 edx1) (cpuid 1 0)]
        (set! (.-HasSSE2 X86) (isSet edx1 cpuid_SSE2))

        (set! (.-HasSSE3 X86) (isSet ecx1 cpuid_SSE3))
        (set! (.-HasPCLMULQDQ X86) (isSet ecx1 cpuid_PCLMULQDQ))
        (set! (.-HasSSSE3 X86) (isSet ecx1 cpuid_SSSE3))
        (set! (.-HasFMA X86) (isSet ecx1 cpuid_FMA))
        (set! (.-HasCX16 X86) (isSet ecx1 cpuid_CX16))
        (set! (.-HasSSE41 X86) (isSet ecx1 cpuid_SSE41))
        (set! (.-HasSSE42 X86) (isSet ecx1 cpuid_SSE42))
        (set! (.-HasPOPCNT X86) (isSet ecx1 cpuid_POPCNT))
        (set! (.-HasAES X86) (isSet ecx1 cpuid_AES))
        (set! (.-HasOSXSAVE X86) (isSet ecx1 cpuid_OSXSAVE))
        (set! (.-HasRDRAND X86) (isSet ecx1 cpuid_RDRAND))

        (let [(values ^bool osSupportsAVX ^bool osSupportsAVX512) (zero bool)]
          ;; For XGETBV, OSXSAVE bit is required and sufficient.
          (when (.-HasOSXSAVE X86)
            (let [(values eax _) (xgetbv)]
              ;; Check if XMM and YMM registers have OS support.
              (set! osSupportsAVX (and (isSet eax (<< 1 1)) (isSet eax (<< 1 2))))

              (if (== runtime/GOOS "darwin")
                ;; Darwin requires special AVX512 checks, see cpu_darwin_x86.go
                (set! osSupportsAVX512 (and osSupportsAVX (darwinSupportsAVX512)))

                ;; Check if OPMASK and ZMM registers have OS support.
                (set! osSupportsAVX512 (and osSupportsAVX (isSet eax (<< 1 5)) (isSet eax (<< 1 6)) (isSet eax (<< 1 7)))))))



          (set! (.-HasAVX X86) (and (isSet ecx1 cpuid_AVX) osSupportsAVX))

          (when (< maxID 7)
            (return))


          (let [(values eax7 ebx7 ecx7 edx7) (cpuid 7 0)]
            (set! (.-HasBMI1 X86) (isSet ebx7 cpuid_BMI1))
            (set! (.-HasAVX2 X86) (and (isSet ebx7 cpuid_AVX2) osSupportsAVX))
            (set! (.-HasBMI2 X86) (isSet ebx7 cpuid_BMI2))
            (set! (.-HasERMS X86) (isSet ebx7 cpuid_ERMS))
            (set! (.-HasRDSEED X86) (isSet ebx7 cpuid_RDSEED))
            (set! (.-HasADX X86) (isSet ebx7 cpuid_ADX))

            (set! (.-HasAVX512 X86) (and (isSet ebx7 cpuid_AVX512F) osSupportsAVX512)) ; Because avx-512 foundation is the core required extension
            (when (.-HasAVX512 X86)
              (set! (.-HasAVX512F X86) true)
              (set! (.-HasAVX512CD X86) (isSet ebx7 cpuid_AVX512CD))
              (set! (.-HasAVX512ER X86) (isSet ebx7 cpuid_AVX512ER))
              (set! (.-HasAVX512PF X86) (isSet ebx7 cpuid_AVX512PF))
              (set! (.-HasAVX512VL X86) (isSet ebx7 cpuid_AVX512VL))
              (set! (.-HasAVX512BW X86) (isSet ebx7 cpuid_AVX512BW))
              (set! (.-HasAVX512DQ X86) (isSet ebx7 cpuid_AVX512DQ))
              (set! (.-HasAVX512IFMA X86) (isSet ebx7 cpuid_AVX512IFMA))
              (set! (.-HasAVX512VBMI X86) (isSet ecx7 cpuid_AVX512_VBMI))
              (set! (.-HasAVX5124VNNIW X86) (isSet edx7 cpuid_AVX5124VNNIW))
              (set! (.-HasAVX5124FMAPS X86) (isSet edx7 cpuid_AVX5124FMAPS))
              (set! (.-HasAVX512VPOPCNTDQ X86) (isSet ecx7 cpuid_AVX512VPOPCNTDQ))
              (set! (.-HasAVX512VPCLMULQDQ X86) (isSet ecx7 cpuid_AVX512VPCLMULQDQ))
              (set! (.-HasAVX512VNNI X86) (isSet ecx7 cpuid_AVX512VNNI))
              (set! (.-HasAVX512GFNI X86) (isSet ecx7 cpuid_AVX512GFNI))
              (set! (.-HasAVX512VAES X86) (isSet ecx7 cpuid_AVX512VAES))
              (set! (.-HasAVX512VBMI2 X86) (isSet ecx7 cpuid_AVX512VBMI2))
              (set! (.-HasAVX512BITALG X86) (isSet ecx7 cpuid_AVX512BITALG)))


            (set! (.-HasAMXTile X86) (isSet edx7 cpuid_AMXTile))
            (set! (.-HasAMXInt8 X86) (isSet edx7 cpuid_AMXInt8))
            (set! (.-HasAMXBF16 X86) (isSet edx7 cpuid_AMXBF16))

            ;; These features depend on the second level of extended features.
            (when (>= eax7 1)
              (let [(values eax71 _ _ edx71) (cpuid 7 1)]
                (when (.-HasAVX512 X86)
                  (set! (.-HasAVX512BF16 X86) (isSet eax71 cpuid_AVX512BF16)))

                (when (.-HasAVX X86)
                  (set! (.-HasAVXIFMA X86) (isSet eax71 cpuid_AVXIFMA))
                  (set! (.-HasAVXVNNI X86) (isSet eax71 cpuid_AVXVNNI))
                  (set! (.-HasAVXVNNIInt8 X86) (isSet edx71 cpuid_AVXVNNIInt8)))))))))))




^{:go/end 236} (go/func isSet ^bool [^uint32 hwc ^uint32 value]
  (!= (bit-and hwc value) 0))

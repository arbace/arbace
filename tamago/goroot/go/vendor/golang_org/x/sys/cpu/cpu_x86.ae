(go/const ^{:val 64} cacheLineSize 64)

^{:go/end 63} (go/func initOptions []
  (set! options (lit (slice option)
      (lit _ :Name "adx" :Feature (addr (.-HasADX X86)))
      (lit _ :Name "aes" :Feature (addr (.-HasAES X86)))
      (lit _ :Name "avx" :Feature (addr (.-HasAVX X86)))
      (lit _ :Name "avx2" :Feature (addr (.-HasAVX2 X86)))
      (lit _ :Name "avx512" :Feature (addr (.-HasAVX512 X86)))
      (lit _ :Name "avx512f" :Feature (addr (.-HasAVX512F X86)))
      (lit _ :Name "avx512cd" :Feature (addr (.-HasAVX512CD X86)))
      (lit _ :Name "avx512er" :Feature (addr (.-HasAVX512ER X86)))
      (lit _ :Name "avx512pf" :Feature (addr (.-HasAVX512PF X86)))
      (lit _ :Name "avx512vl" :Feature (addr (.-HasAVX512VL X86)))
      (lit _ :Name "avx512bw" :Feature (addr (.-HasAVX512BW X86)))
      (lit _ :Name "avx512dq" :Feature (addr (.-HasAVX512DQ X86)))
      (lit _ :Name "avx512ifma" :Feature (addr (.-HasAVX512IFMA X86)))
      (lit _ :Name "avx512vbmi" :Feature (addr (.-HasAVX512VBMI X86)))
      (lit _ :Name "avx512vnniw" :Feature (addr (.-HasAVX5124VNNIW X86)))
      (lit _ :Name "avx5124fmaps" :Feature (addr (.-HasAVX5124FMAPS X86)))
      (lit _ :Name "avx512vpopcntdq" :Feature (addr (.-HasAVX512VPOPCNTDQ X86)))

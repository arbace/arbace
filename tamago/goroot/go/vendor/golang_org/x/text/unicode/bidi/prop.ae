(go/type Properties "Properties provides access to BiDi properties of runes.\n" (struct
    ^{:line 11 :tag uint8} entry
    ^{:line 12 :tag uint8} last))


(go/var trie (newBidiTrie 0))

;; TODO: using this for bidirule reduces the running time by about 5%. Consider

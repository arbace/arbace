(ns go.vendor.golang_org.x.text.unicode.norm
  (:require [arbace.go :as go]))

(go/package norm
  :path "vendor/golang.org/x/text/unicode/norm"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["composition.go" "forminfo.go" "input.go" "iter.go" "normalize.go" "readwriter.go" "tables17.0.0.go" "transform.go" "trie.go"]
  :init-order [ccc decomps nfcValues nfcIndex nfcSparseOffset nfcSparseValues nfkcValues nfkcIndex nfkcSparseOffset nfkcSparseValues errs nfcSparse nfkcSparse nfcData nfkcData formTable]
  :positions :lines)

(load "norm/composition")
(load "norm/forminfo")
(load "norm/input")
(load "norm/iter")
(load "norm/normalize")
(load "norm/readwriter")
(load "norm/tables17.0.0")
(load "norm/transform")
(load "norm/trie")

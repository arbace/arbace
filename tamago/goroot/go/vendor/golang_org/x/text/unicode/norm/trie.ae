^{:go/end 54} (go/method lookup "lookup determines the type of block n and looks up the value for b.\nFor n < t.cutoff, the block is a simple lookup table. Otherwise, the block\nis a list of ranges with an accompanying value. Given a matching range r,\nthe value for b is by r.value + (b - r.lo) * stride.\n" ^uint16 [^{:tag (* sparseBlocks)} t ^uint32 n ^byte b]
  ^{:go/breaks [[3 53]]} (let [offset (aget (.-offset t) n)
      ^{:line 38} header (aget (.-values t) offset)
      ^{:line 39} lo (+ offset 1)
      ^{:line 40} hi (+ lo (conv uint16 (.-lo header)))]
    (while (< lo hi)
      (let [m (+ lo (/ (- hi lo) 2))
          ^{:line 43} r (aget (.-values t) m)]
        (when (and (<= (.-lo r) b) (<= b (.-hi r)))
          (return (+ (.-value r) (* (conv uint16 (- b (.-lo r))) (.-value header)))))

        (if (< b (.-lo r))
          (set! hi m)

          (set! lo (+ m 1)))))


    0))

        (case [(== b0 hangulBase0)]
          (return (>= b1 hangulBase1)))
        (case [(< b0 hangulEnd0)]
          (return true))
        (case [(> b0 hangulEnd0)]
          (return false))
        (case [(< b1 hangulEnd1)]

^{:go/end 356} (go/func isHangul ^bool [^{:tag (slice byte)} b]
  (when (< (len b) hangulUTF8Size)
    (return false))

  (let [b0 (aget b 0)]
    (when (< b0 hangulBase0)
      (return false))

    (let [b1 (aget b 1)]
      (switch
        (case [(== b0 hangulBase0)]
          (return (>= b1 hangulBase1)))
        (case [(< b0 hangulEnd0)]
          (return true))
        (case [(> b0 hangulEnd0)]
          (return false))
        (case [(< b1 hangulEnd1)]
          (return true)))

      (and (== b1 hangulEnd1) (< (aget b 2) hangulEnd2)))))


^{:go/end 378} (go/func isHangulString ^bool [^string b]

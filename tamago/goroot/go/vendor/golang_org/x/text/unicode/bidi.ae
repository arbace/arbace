(ns go.vendor.golang_org.x.text.unicode.bidi
  (:require [arbace.go :as go]))

(go/package bidi
  :path "vendor/golang.org/x/text/unicode/bidi"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["bidi.go" "bracket.go" "core.go" "prop.go" "tables17.0.0.go" "trieval.go"]
  :init-order [trie controlByteToClass xorMasks bidiValues bidiIndex]
  :positions :lines)

(load "bidi/bidi")
(load "bidi/bracket")
(load "bidi/core")
(load "bidi/prop")
(load "bidi/tables17.0.0")
(load "bidi/trieval")

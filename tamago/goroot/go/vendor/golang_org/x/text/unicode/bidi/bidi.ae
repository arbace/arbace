      (for [(values i j) (values 0 (- (len inRunes) 1))] (< i j) (set! (values i j) (values (+ i 1) (- j 1)))
        (set! (values (aget inRunes i) (aget inRunes j)) (values (aget inRunes j) (aget inRunes i))))

      (copy (subslice ret (len out)) (conv string inRunes))

      ^{:line 340} ret)))





^{:go/end 359} (go/func ReverseString "ReverseString reverses the order of characters in s and returns a new string.\nModifiers will still follow the runes they modify. Brackets are replaced with\ntheir counterparts.\n" ^string [^string s]

^{:go/end 126} (go/method prepareInput "Initialize the p.pairTypes, p.pairValues and p.types from the input previously\nset by p.SetBytes() or p.SetString(). Also limit the input up to (and including) a paragraph\nseparator (bidi class B).\n\nThe function p.Order() needs these values to be set, so this preparation could be postponed.\nBut since the SetBytes and SetStrings functions return the length of the input up to the paragraph\nseparator, the whole input needs to be processed anyway and should not be done twice.\n\nThe function has the same return values as SetBytes() / SetString()\n" [^{:tag (* Paragraph)} p] :results [^int n ^error err]
  (set! (.-runes p) (bytes/Runes (.-p p)))
  (let [bytecount 0]
    ;; clear slices from previous SetString or SetBytes
    (set! (.-pairTypes p) nil)
    (set! (.-pairValues p) nil)
    (set! (.-types p) nil)

    (range [_ r (.-runes p)]
      (let [(values props i) (LookupRune r)]
        (set! bytecount + i)
        (let [cls (.Class props)]
          (when (== cls B)
            (return bytecount nil))

          (set! (.-types p) (append (.-types p) cls))
          (cond (.IsOpeningBracket props) (do
              (set! (.-pairTypes p) (append (.-pairTypes p) bpOpen))
              (set! (.-pairValues p) (append (.-pairValues p) r)))
            (.IsBracket props) (do
              ;; this must be a closing bracket,
              ;; since IsOpeningBracket is not true
              (set! (.-pairTypes p) (append (.-pairTypes p) bpClose))
              (set! (.-pairValues p) (append (.-pairValues p) r))) :else
            (do
              (set! (.-pairTypes p) (append (.-pairTypes p) bpNone))
              (set! (.-pairValues p) (append (.-pairValues p) 0)))))))


    (return bytecount nil)))







^{:go/end 137} (go/method SetBytes "SetBytes configures p for the given paragraph text. It replaces text\npreviously set by SetBytes or SetString. If b contains a paragraph separator\nit will only process the first paragraph and report the number of bytes\nconsumed from b including this separator. Error may be non-nil if options are\ngiven.\n" [^{:tag (* Paragraph)} p ^{:tag (slice byte)} b & ^{:tag (slice Option)} opts] :results [^int n ^error err]
  (set! (.-p p) b)
  (set! (.-opts p) opts)
  (.prepareInput p))







^{:go/end 148} (go/method SetString "SetString configures s for the given paragraph text. It replaces text\npreviously set by SetBytes or SetString. If s contains a paragraph separator\nit will only process the first paragraph and report the number of bytes\nconsumed from s including this separator. Error may be non-nil if options are\ngiven.\n" [^{:tag (* Paragraph)} p ^string s & ^{:tag (slice Option)} opts] :results [^int n ^error err]
  (set! (.-p p) (conv (slice byte) s))
  (set! (.-opts p) opts)

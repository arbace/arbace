^{:go/end 210} (go/func calculateOrdering ^Ordering [^{:tag (slice level)} levels ^{:tag (slice rune)} runes]
  (let [^Direction curDir (zero Direction)

      ^{:line 184} prevDir Neutral
      ^{:line 185} prevI 0

      ^{:line 187} o (lit Ordering)]
    ;; lvl = 0,2,4,...: left to right
    ;; lvl = 1,3,5,...: right to left
    (range [i lvl levels]
      (if (== (% lvl 2) 0)
        (set! curDir LeftToRight)

        (set! curDir RightToLeft))

      (when (!= curDir prevDir)
        (when (> i 0)
          (set! (.-runes o) (append (.-runes o) (subslice runes prevI i)))
          (set! (.-directions o) (append (.-directions o) prevDir))
          (set! (.-startpos o) (append (.-startpos o) prevI)))

        (set! prevI i)
        (set! prevDir curDir)))


    (set! (.-runes o) (append (.-runes o) (subslice runes prevI)))
    (set! (.-directions o) (append (.-directions o) prevDir))
    (set! (.-startpos o) (append (.-startpos o) prevI))
    ^{:line 209} o))



^{:go/end 234} (go/method Order "Order computes the visual ordering of all the runs in a Paragraph.\n" [^{:tag (* Paragraph)} p] :results [Ordering error]
  (when (== (len (.-types p)) 0)
    (return (lit Ordering) nil))


  (range [_ fn (.-opts p)]
    (go/call fn (addr (.-options p))))

  (let [lvl (conv level -1)]
    (when (== (.-defaultDirection (.-options p)) RightToLeft)
      (set! lvl 1))

    (let [(values para err) (newParagraph (.-types p) (.-pairTypes p) (.-pairValues p) lvl)]
      (when (!= err nil)
        (return (lit Ordering) err))


      (let [levels (.getLevels para (lit (slice int) (len (.-types p))))]

        (set! (.-o p) (calculateOrdering levels (.-runes p)))
        (return (.-o p) nil)))))




^{:go/end 247} (go/method Line "Line computes the visual ordering of runs for a single line starting and\nending at the given positions in the original text.\n" [^{:tag (* Paragraph)} p ^int start ^int end] :results [Ordering error]
  (let [lineTypes (subslice (.-types p) start end)
      (values para err) (newParagraph lineTypes (subslice (.-pairTypes p) start end) (subslice (.-pairValues p) start end) -1)]
    (when (!= err nil)
      (return (lit Ordering) err))

    (let [levels (.getLevels para (lit (slice int) (len lineTypes)))
        ^{:line 245} o (calculateOrdering levels (subslice (.-runes p) start end))]
      (return o nil))))






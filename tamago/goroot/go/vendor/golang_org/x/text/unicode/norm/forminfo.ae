^{:go/end 289} (go/func compInfo "compInfo converts the information contained in v and sz\nto a Properties.  See the comment at the top of the file\nfor more information on the format.\n" ^Properties [^uint16 v ^int sz]
  (cond (== v 0)
    (return (lit Properties :size (conv uint8 sz)))
    (>= v 0x8000)
    (let [p ^{:go/breaks [2 4 6 8]} (lit Properties
          :size (conv uint8 sz)
          :ccc (conv uint8 v)
          :tccc (conv uint8 v)
          :flags (conv qcInfo (>> v 8)))]

      (when (or (> (.-ccc p) 0) (.combinesBackward p))
        (set! (.-nLead p) (conv uint8 (bit-and (.-flags p) 0x3))))

      (return p)))

  ;; has decomposition

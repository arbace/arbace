      ^{:line 266} f (bit-or (>> (conv qcInfo (bit-and h headerFlagsMask)) 2) 0x4)
      ^{:line 267} p (lit Properties :size (conv uint8 sz) :flags f :index v)]
    (when (>= v firstCCC)
      (let [n (conv uint16 (bit-and h headerLenMask))]
        (when (== n 31)

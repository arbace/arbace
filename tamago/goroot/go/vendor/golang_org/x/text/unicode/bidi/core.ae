^{:go/end 415} (go/method determineExplicitEmbeddingLevels "Determine explicit levels using rules X1 - X8\n" [^{:tag (* paragraph)} p]
  (let [^directionalStatusStack stack (zero directionalStatusStack)
      (values ^int overflowIsolateCount ^int overflowEmbeddingCount ^int validIsolateCount) (zero int)]

    ;; Rule X1.
    (.push stack (.-embeddingLevel p) ON false)

    (range [i t (.-resultTypes p)]

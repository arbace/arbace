^{:go/end 129} (go/func newParagraph "newParagraph initializes a paragraph. The user needs to supply a few arrays\ncorresponding to the preprocessed text input. The types correspond to the\nUnicode BiDi classes for each rune. pairTypes indicates the bracket type for\neach rune. pairValues provides a unique bracket class identifier for each\nrune (suggested is the rune of the open bracket for opening and matching\nclose brackets, after normalization). The embedding levels are optional, but\nmay be supplied to encode embedding levels of styled text.\n" [^{:tag (slice Class)} types ^{:tag (slice bracketType)} pairTypes ^{:tag (slice rune)} pairValues ^level levels] :results [(* paragraph) error]
  (let [^error err (zero error)]
    (when [(set! err (validateTypes types))] (!= err nil)
      (return nil err))

    (when [(set! err (validatePbTypes pairTypes))] (!= err nil)
      (return nil err))

    (when [(set! err (validatePbValues pairValues pairTypes))] (!= err nil)
      (return nil err))

    (when [(set! err (validateParagraphEmbeddingLevel levels))] (!= err nil)
      (return nil err))


    (let [p (addr ^{:go/breaks [2 4 [6 122] 8 [10 125]]} (lit paragraph
            :initialTypes (append (conv (slice Class) nil) (spread types))
            :embeddingLevel levels

            :pairTypes pairTypes
            :pairValues pairValues

            :resultTypes (append (conv (slice Class) nil) (spread types))))]

      (.run p)
      (return p nil))))


^{:go/end 131} (go/method Len ^int [^{:tag (* paragraph)} p] (len (.-initialTypes p)))



^{:go/end 187} (go/method run "The algorithm. Does not include line-based processing (Rules L1, L2).\nThese are applied later in the line-based phase of the algorithm.\n" [^{:tag (* paragraph)} p]
  (.determineMatchingIsolates p)

  ;; 1) determining the paragraph level
  ;; Rule P1 is the requirement for entering this algorithm.
  ;; Rules P2, P3.
  ;; If no externally supplied paragraph embedding level, use default.
  (when (== (.-embeddingLevel p) implicitLevel)
    (set! (.-embeddingLevel p) (.determineParagraphEmbeddingLevel p 0 (.Len p))))


  ;; Initialize result levels to paragraph embedding level.
  (set! (.-resultLevels p) (make (slice level) (.Len p)))
  (setLevels (.-resultLevels p) (.-embeddingLevel p))

  ;; 2) Explicit levels and directions
  ;; Rules X1-X8.
  (.determineExplicitEmbeddingLevels p)

  ;; Rule X9.
  ;; We do not remove the embeddings, the overrides, the PDFs, and the BNs
  ;; from the string explicitly. But they are not copied into isolating run
  ;; sequences when they are created, so they are removed for all
  ;; practical purposes.

  ;; Rule X10.
  ;; Run remainder of algorithm one isolating run sequence at a time
  (range [_ seq (.determineIsolatingRunSequences p)]
    ;; 3) resolving weak types
    ;; Rules W1-W7.
    (.resolveWeakTypes seq)

    ;; 4a) resolving paired brackets
    ;; Rule N0
    (resolvePairedBrackets seq)

    ;; 4b) resolving neutral types
    ;; Rules N1-N3.
    (.resolveNeutralTypes seq)

    ;; 5) resolving implicit embedding levels
    ;; Rules I1, I2.
    (.resolveImplicitLevels seq)

    ;; Apply the computed levels and types
    (.applyLevelsAndTypes seq))


  ;; Assign appropriate levels to 'hide' LREs, RLEs, LROs, RLOs, PDFs, and
  ;; BNs. This is for convenience, so the resulting level array will have
  ;; a value for every character.
  (.assignLevelsToCharactersRemovedByX9 p))

















^{:go/end 233} (go/method determineMatchingIsolates "determineMatchingIsolates determines the matching PDI for each isolate\ninitiator and vice versa.\n\nDefinition BD9.\n\nAt the end of this function:\n\n  - The member variable matchingPDI is set to point to the index of the\n    matching PDI character for each isolate initiator character. If there is\n    no matching PDI, it is set to the length of the input text. For other\n    characters, it is set to -1.\n  - The member variable matchingIsolateInitiator is set to point to the\n    index of the matching isolate initiator character for each PDI character.\n    If there is no matching isolate initiator, or the character is not a PDI,\n    it is set to -1.\n" [^{:tag (* paragraph)} p]
  (set! (.-matchingPDI p) (make (slice int) (.Len p)))
  (set! (.-matchingIsolateInitiator p) (make (slice int) (.Len p)))

  (range [i (.-matchingIsolateInitiator p)]
    (aset (.-matchingIsolateInitiator p) i -1))


  (range [i (.-matchingPDI p)]
    (aset (.-matchingPDI p) i -1)

    (when [t (aget (.-resultTypes p) i)] (.in t LRI RLI FSI)
      (let [depthCounter 1]
        (for [j (+ i 1)] (< j (.Len p)) (inc! j)
          (if [u (aget (.-resultTypes p) j)] (.in u LRI RLI FSI)
            (inc! depthCounter)
            (when (== u PDI)
              (when [(dec! depthCounter)] (== depthCounter 0)
                (aset (.-matchingPDI p) i j)
                (aset (.-matchingIsolateInitiator p) j i)
                (break)))))



        (when (== (aget (.-matchingPDI p) i) -1)
          (aset (.-matchingPDI p) i (.Len p)))))))










^{:go/end 265} (go/method determineParagraphEmbeddingLevel "determineParagraphEmbeddingLevel reports the resolved paragraph direction of\nthe substring limited by the given range [start, end).\n\nDetermines the paragraph level based on rules P2, P3. This is also used\nin rule X5c to find if an FSI should resolve to LRI or RLI.\n" ^level [^{:tag (* paragraph)} p ^int start ^int end]
  (let [^Class strongType unknownClass]

    ;; Rule P2.
    (for [i start] (< i end) (inc! i)
      (if [t (aget (.-resultTypes p) i)] (.in t L AL R) (do
          (set! strongType t)
          (break))
        (when (.in t FSI LRI RLI)
          (set! i (aget (.-matchingPDI p) i)) ; skip over to the matching PDI
          (when (> i end)
            (log/Panic "assert (i <= end)")))))



    ;; Rule P3.
    (switch strongType
      (case [unknownClass] ; none found
        ;; default embedding level when no strong types found is 0.
        (return 0))
      (case [L]
        (return 0))
      (default ; AL, R
        (return 1)))))



(go/const ^{:val 125} maxDepth 125)




                  ;; suffices.
                  (switch t
                    (case [LRO]
                      (.push stack newLevel L isIsolate))
                    (case [RLO]
                      (.push stack newLevel R isIsolate))
                    (default
                      (.push stack newLevel ON isIsolate)))


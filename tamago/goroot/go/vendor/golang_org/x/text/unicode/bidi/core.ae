^{:go/end 694} (go/method resolveImplicitLevels "7) resolving implicit embedding levels Rules I1, I2.\n" [^{:tag (* isolatingRunSequence)} s]

  ;; on entry, only these types can be in resultTypes
  (.assertOnly s L R EN AN)


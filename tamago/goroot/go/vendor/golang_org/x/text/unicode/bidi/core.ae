    ^{:line 72 :tag (slice Class)} initialTypes


    ^{:line 75 :tag (slice bracketType) :doc "Arrays of properties needed for paired bracket evaluation in N0\n"} pairTypes ; paired Bracket types for paragraph
    ^{:line 76 :tag (slice rune)} pairValues ; rune for opening bracket or pbOpen and pbClose; 0 for pbNone

    ^{:line 78 :tag level} embeddingLevel ; default: = implicitLevel;


    ^{:line 81 :tag (slice Class) :doc "at the paragraph levels\n"} resultTypes
    ^{:line 82 :tag (slice level)} resultLevels





    ^{:line 88 :tag (slice int) :doc "Index of matching PDI for isolate initiator characters. For other\ncharacters, the value of matchingPDI will be set to -1. For isolate\ninitiators with no matching PDI, matchingPDI will be set to the length of\nthe input string.\n"} matchingPDI





(in-ns 'go.vendor.golang_org.x.text.unicode.norm) (go/file "transform.go" :imports [


    ^{:line 8} [utf8 "unicode/utf8"]

    ^{:line 10} [transform "golang.org/x/text/transform"]])



^{:go/end 14} (go/method Reset "Reset implements the Reset method of the transform.Transformer interface.\n" [Form])





^{:go/end 40} (go/method Transform "Transform implements the Transform method of the transform.Transformer\ninterface. It may need to write segments of up to MaxSegmentSize at once.\nUsers should either catch ErrShortDst and allow dst to grow or have dst be at\nleast of size MaxTransformChunkSize to be guaranteed of progress.\n" [^Form f ^{:tag (slice byte)} dst ^{:tag (slice byte)} src ^bool atEOF] :results [^int nDst ^int nSrc ^error err]
  ;; Cap the maximum number of src bytes to check.
  (let [b src
      ^{:line 23} eof atEOF]
    (when [ns (len dst)] (< ns (len b))
      (set! err transform/ErrShortDst)
      (set! eof false)
      (set! b (subslice b _ ns)))

    (let [(values i ok) (.quickSpan (aget formTable f) (inputBytes b) 0 (len b) eof)
        ^{:line 30} n (copy dst (subslice b _ i))]
      (when (not ok)
        (set! (values nDst nSrc err) (.transform f (subslice dst n) (subslice src n) atEOF))
        (return (+ nDst n) (+ nSrc n) err))


      (when (and (== err nil) (< n (len src)) (not atEOF))
        (set! err transform/ErrShortSrc))

      (return n n err))))


^{:go/breaks [5] :go/end 49} (go/func flushTransform ^bool [^{:tag (* reorderBuffer)} rb]
  ;; Write out (must fully fit in dst, or else it is an ErrShortDst).
  (when (< (len (.-out rb)) (* (.-nrune rb) utf8/UTFMax))
    (return false))

  (set! (.-out rb) (subslice (.-out rb) (.flushCopy rb (.-out rb))))
  true)


(go/var errs (lit (slice error) nil transform/ErrShortDst transform/ErrShortSrc))



^{:go/end 88} (go/method transform "transform implements the transform.Transformer interface. It is only called\nwhen quickSpan does not pass for a given string.\n" [^Form f ^{:tag (slice byte)} dst ^{:tag (slice byte)} src ^bool atEOF] :results [^int nDst ^int nSrc ^error err]
  ;; TODO: get rid of reorderBuffer. See CL 23460044.
  (let [rb (lit reorderBuffer)]
    (.init rb f src)
    (while true
      ;; Load segment into reorder buffer.
      (.setFlusher rb (subslice dst nDst) flushTransform)
      (let [end (decomposeSegment (addr rb) nSrc atEOF)]
        (when (< end 0)
          (return nDst nSrc (aget errs (- end))))

        (set! nDst (- (len dst) (len (.-out rb))))
        (set! nSrc end)

        ;; Next quickSpan.
        (set! end (.-nsrc rb))
        (let [eof atEOF]
          (when [n (- (+ nSrc (len dst)) nDst)] (< n end)
            (set! err transform/ErrShortDst)
            (set! end n)
            (set! eof false))

          (let [(values ^:assign end ok) (.quickSpan (.-f rb) (.-src rb) nSrc end eof)
              ^{:line 78} n (copy (subslice dst nDst) (subslice (.-bytes (.-src rb)) nSrc end))]
            (set! nSrc + n)
            (set! nDst + n)
            (when ok
              (when (and (== err nil) (< n (.-nsrc rb)) (not atEOF))
                (set! err transform/ErrShortSrc))

              (return nDst nSrc err))))))))

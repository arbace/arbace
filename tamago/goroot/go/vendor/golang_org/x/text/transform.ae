(ns go.vendor.golang_org.x.text.transform
  (:require [arbace.go :as go]))

(go/package transform
  :path "vendor/golang.org/x/text/transform"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["transform.go"]
  :init-order [ErrShortDst ErrShortSrc ErrEndOfSpan errInconsistentByteCount errShortInternal Discard Nop]
  :positions :lines)

(load "transform/transform")

            (return oldMsg (addr (lit nestedError "SVCBResource.Params" errParamOutOfOrder))))

          (when (> (len (.-Value param)) (- (<< 1 16) 1))
            (return oldMsg (addr (lit nestedError "SVCBResource.Params" errTooLongSVCBValue))))

          (set! msg (packUint16 msg (conv uint16 (.-Key param))))

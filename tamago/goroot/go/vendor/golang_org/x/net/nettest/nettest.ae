;; Package nettest provides utilities for network testing.
(in-ns 'go.vendor.golang_org.x.net.nettest) (go/file "nettest.go" :doc "Package nettest provides utilities for network testing.\n" :imports [


    ^{:line 9} [errors "errors"]
    ^{:line 10} [fmt "fmt"]

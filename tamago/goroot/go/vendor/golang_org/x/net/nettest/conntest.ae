^{:go/end 392} (go/func testConcurrentMethods "testConcurrentMethods tests that the methods of net.Conn can safely\nbe called concurrently.\n" [^{:tag (* testing/T)} t ^net/Conn c1 ^net/Conn c2]
  (when (== runtime/GOOS "plan9")
    ^{:go/via [common]} (.Skip t "skipping on plan9; see https://golang.org/issue/20489"))

  (go (chunkedCopy c2 c2))

  ;; The results of the calls may be nonsensical, but this should
  ;; not trigger a race detector warning.
  (let [^sync/WaitGroup wg (zero sync/WaitGroup)]
    (for [i 0] (< i 100) (inc! i)
      (.Add wg 7)
      (go (^{:go/end 362} (fn []
            (defer (.Done wg))
            (.Read c1 (make (slice byte) 1024)))))

      (go (^{:go/end 366} (fn []
            (defer (.Done wg))
            (.Write c1 (make (slice byte) 1024)))))

      (go (^{:go/end 370} (fn []
            (defer (.Done wg))
            (.SetDeadline c1 (.Add (time/Now) (* 10 time/Millisecond))))))

      (go (^{:go/end 374} (fn []
            (defer (.Done wg))
            (.SetReadDeadline c1 aLongTimeAgo))))

      (go (^{:go/end 378} (fn []
            (defer (.Done wg))
            (.SetWriteDeadline c1 aLongTimeAgo))))

      (go (^{:go/end 382} (fn []
            (defer (.Done wg))
            (.LocalAddr c1))))

      (go (^{:go/end 386} (fn []
            (defer (.Done wg))
            (.RemoteAddr c1)))))


    (.Wait wg) ; At worst, the deadline is set 10ms into the future

    (resyncConn t c1)
    (testRoundtrip t c1)))




^{:go/end 409} (go/func checkForTimeoutError "checkForTimeoutError checks that the error satisfies the Error interface\nand that Timeout returns true.\n" [^{:tag (* testing/T)} t ^error err]
  ^{:go/via [common]} (.Helper t)
  (if [(values nerr ok) (assert net/Error err)] ok
    (when (not (.Timeout nerr))
      (if (and (== runtime/GOOS "windows") (== runtime/GOARCH "arm64") (== ^{:go/via [common]} (.Name t) "TestTestConn/TCP/RacyRead"))
        ^{:go/via [common]} (.Logf t "ignoring known failure mode on windows/arm64; see https://go.dev/issue/52893")

        ^{:go/via [common]} (.Errorf t "got error: %v, want err.Timeout() = true" nerr)))



    ^{:go/via [common]} (.Errorf t "got %T: %v, want net.Error" err err)))





^{:go/end 430} (go/func testRoundtrip "testRoundtrip writes something into c and reads it back.\nIt assumes that everything written into c is echoed back to itself.\n" [^{:tag (* testing/T)} t ^net/Conn c]
  ^{:go/via [common]} (.Helper t)
  (when [err (.SetDeadline c neverTimeout)] (!= err nil)
    ^{:go/via [common]} (.Errorf t "roundtrip SetDeadline error: %v" err))


  (let [^:const ^{:val "Hello, world!"} s "Hello, world!"
      ^{:line 420} buf (conv (slice byte) s)]
    (when [(values _ err) (.Write c buf)] (!= err nil)
      ^{:go/via [common]} (.Errorf t "roundtrip Write error: %v" err))

    (when [(values _ err) (io/ReadFull c buf)] (!= err nil)
      ^{:go/via [common]} (.Errorf t "roundtrip Read error: %v" err))

    (when (!= (conv string buf) s)
      ^{:go/via [common]} (.Errorf t "roundtrip data mismatch: got %q, want %q" buf s))))






^{:go/end 457} (go/func resyncConn "resyncConn resynchronizes the connection into a sane state.\nIt assumes that everything written into c is echoed back to itself.\nIt assumes that 0xff is not currently on the wire or in the read buffer.\n" [^{:tag (* testing/T)} t ^net/Conn c]
  ^{:go/via [common]} (.Helper t)
  (.SetDeadline c neverTimeout)
  (let [errCh (make (chan error))]
    (go (^{:go/end 442} (fn []
          (let [(values _ err) (.Write c (lit (slice byte) 0xff))]
            (>! errCh err)))))

    (let [buf (make (slice byte) 1024)]
      (while true
        (let [(values n err) (.Read c buf)]
          (when (and (> n 0) (== (bytes/IndexByte (subslice buf _ n) 0xff) (- n 1)))
            (break))

          (when (!= err nil)
            ^{:go/via [common]} (.Errorf t "unexpected Read error: %v" err)
            (break))))


      (when [err (<! errCh)] (!= err nil)
        ^{:go/via [common]} (.Errorf t "unexpected Write error: %v" err)))))







^{:go/end 467} (go/func chunkedCopy "chunkedCopy copies from r to w in fixed-width chunks to avoid\ncausing a Write that exceeds the maximum packet size for packet-based\nconnections like \"unixpacket\".\nWe assume that the maximum packet size is at least 1024.\n" ^error [^io/Writer w ^io/Reader r]
  (let [b (make (slice byte) 1024)
      (values _ err) (io/CopyBuffer (lit (struct io/Writer) w) (lit (struct io/Reader) r) b)]
    ^{:line 466} err))

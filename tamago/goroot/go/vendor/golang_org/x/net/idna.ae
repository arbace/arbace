(ns go.vendor.golang_org.x.net.idna
  (:require [arbace.go :as go]))

(go/package idna
  :path "vendor/golang.org/x/net/idna"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["idna.go" "punycode.go" "tables17.0.0.go" "trie.go" "trieval.go"]
  :init-order [punycode Punycode joinStates mappings mappingIndex xorData idnaValues idnaIndex idnaSparseOffset idnaSparseValues idnaSparse trie lookup Lookup display Display registration Registration]
  :positions :lines)

(load "idna/idna")
(load "idna/punycode")
(load "idna/tables17.0.0")
(load "idna/trie")
(load "idna/trieval")

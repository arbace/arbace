(ns go.vendor.golang_org.x.net.nettest
  (:require [arbace.go :as go]))

(go/package nettest
  :path "vendor/golang.org/x/net/nettest"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["conntest.go" "nettest.go" "nettest_stub.go"]
  :init-order [aLongTimeAgo neverTimeout errNoAvailableInterface errNoAvailableAddress]
  :positions :lines)

(load "nettest/conntest")
(load "nettest/nettest")
(load "nettest/nettest_stub")

^{:go/end 97} (go/func IsTokenRune ^bool [^rune r]
  (and (< r utf8/RuneSelf) (aget isTokenTable (conv byte r))))




^{:go/breaks [[5 107]] :go/end 108} (go/func HeaderValuesContainsToken "HeaderValuesContainsToken reports whether any string in values\ncontains the provided token, ASCII case-insensitively.\n" ^bool [^{:tag (slice string)} values ^string token]
  (range [_ v values]
    (when (headerValueContainsToken v token)
      (return true)))


  false)




^{:go/end 112} (go/func isOWS "isOWS reports whether b is an optional whitespace byte, as defined\nby RFC 7230 section 3.2.3.\n" ^bool [^byte b] (or (== b \space) (== b \tab)))



^{:go/end 128} (go/func trimOWS "trimOWS returns x with all optional whitespace removes from the\nbeginning and end.\n" ^string [^string x]
  ;; TODO: consider using strings.Trim(x, " \t") instead,
  ;; if and when it's fast enough. See issue 10292.
  ;; But this ASCII-only code will probably always beat UTF-8
  ;; aware code.
  (while (and (> (len x) 0) (isOWS (aget x 0)))
    (set! x (subslice x 1)))

  (while (and (> (len x) 0) (isOWS (aget x (- (len x) 1))))
    (set! x (subslice x _ (- (len x) 1))))

  ^{:line 127} x)






^{:go/end 142} (go/func headerValueContainsToken "headerValueContainsToken reports whether v (assumed to be a\n0#element, in the ABNF extension described in RFC 7230 section 7)\ncontains token amongst its comma-separated tokens, ASCII\ncase-insensitively.\n" ^bool [^string v ^string token]
  (for [comma (strings/IndexByte v \,)] (!= comma -1) (set! comma (strings/IndexByte v \,))
    (when (tokenEqual (trimOWS (subslice v _ comma)) token)
      (return true))

    (set! v (subslice v (+ comma 1))))

  (tokenEqual (trimOWS v) token))



^{:go/end 150} (go/func lowerASCII "lowerASCII returns the ASCII lowercase version of b.\n" ^byte [^byte b]
  (when (and (<= \A b) (<= b \Z))
    (return (+ b (- \a \A))))

  ^{:line 149} b)



^{:go/breaks [[6 166]] :go/end 167} (go/func tokenEqual "tokenEqual reports whether t1 and t2 are equal, ASCII case-insensitively.\n" ^bool [^string t1 ^string t2]
  (when (!= (len t1) (len t2))
    (return false))

  (range [i b t1]
    (when (>= b utf8/RuneSelf)
      ;; No UTF-8 or non-ASCII allowed in tokens.
      (return false))

    (when (!= (lowerASCII (conv byte b)) (lowerASCII (aget t2 i)))
      (return false)))


  true)






^{:go/end 173} (go/func isLWS "isLWS reports whether b is linear white space, according\nto http://www.w3.org/Protocols/rfc2616/rfc2616-sec2.html#sec2.2\n\n\tLWS            = [CRLF] 1*( SP | HT )\n" ^bool [^byte b] (or (== b \space) (== b \tab)))






^{:go/end 183} (go/func isCTL "isCTL reports whether b is a control byte, according\nto http://www.w3.org/Protocols/rfc2616/rfc2616-sec2.html#sec2.2\n\n\tCTL            = <any US-ASCII control character\n\t                 (octets 0 - 31) and DEL (127)>\n" ^bool [^byte b]
  (let [^:const ^{:val 127} del 0x7f] ; a CTL
    (or (< b \space) (== b del))))













^{:go/breaks [[6 205]] :go/end 206} (go/func ValidHeaderFieldName "ValidHeaderFieldName reports whether v is a valid HTTP/1.x header name.\nHTTP/2 imposes the additional restriction that uppercase ASCII\nletters are not allowed.\n\nRFC 7230 says:\n\n\theader-field   = field-name \":\" OWS field-value OWS\n\tfield-name     = token\n\ttoken          = 1*tchar\n\ttchar = \"!\" / \"#\" / \"$\" / \"%\" / \"&\" / \"'\" / \"*\" / \"+\" / \"-\" / \".\" /\n\t        \"^\" / \"_\" / \"`\" / \"|\" / \"~\" / DIGIT / ALPHA\n" ^bool [^string v]
  (when (== (len v) 0)
    (return false))

  (for [i 0] (< i (len v)) (inc! i)
    (when (not (aget isTokenTable (aget v i)))
      (return false)))


  true)



^{:go/breaks [[5 226]] :go/end 227} (go/func ValidHostHeader "ValidHostHeader reports whether h is a valid host header.\n" ^bool [^string h]
  ;; The latest spec is actually this:
  ;;
  ;; http://tools.ietf.org/html/rfc7230#section-5.4
  ;;     Host = uri-host [ ":" port ]
  ;;
  ;; Where uri-host is:
  ;;     http://tools.ietf.org/html/rfc3986#section-3.2.2
  ;;
  ;; But we're going to be much more lenient for now and just
  ;; search for any byte that's not a valid byte in any of those
  ;; expressions.
  (for [i 0] (< i (len h)) (inc! i)
    (when (not (aget validHostByte (aget h i)))
      (return false)))


  true)



(go/var ^{:doc "See the validHostHeader comment.\n"} validHostByte (lit (array 256 bool)

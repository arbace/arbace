(ns go.vendor.golang_org.x.net.http.httpguts
  (:require [arbace.go :as go]))

(go/package httpguts
  :path "vendor/golang.org/x/net/http/httpguts"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["guts.go" "httplex.go"]
  :init-order [badTrailer isTokenTable validHostByte]
  :positions :lines)

(load "httpguts/guts")
(load "httpguts/httplex")

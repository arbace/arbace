    ^{:line 66 :doc "Config represents the original configuration as defined above.\n"} Config


    ^{:line 69 :tag (* url/URL) :doc "httpsProxy is the parsed URL of the HTTPSProxy if defined.\n"} httpsProxy


    ^{:line 72 :tag (* url/URL) :doc "httpProxy is the parsed URL of the HTTPProxy if defined.\n"} httpProxy



    ^{:line 76 :tag (slice matcher) :doc "ipMatchers represent all values in the NoProxy that are IP address\nprefixes or an IP address in CIDR notation.\n"} ipMatchers



    ^{:line 80 :tag (slice matcher) :doc "domainMatchers represent all values in the NoProxy that are a domain\nname or hostname & domain name\n"} domainMatchers))









^{:go/end 97} (go/func FromEnvironment "FromEnvironment returns a Config instance populated from the\nenvironment variables HTTP_PROXY, HTTPS_PROXY and NO_PROXY (or the\nlowercase versions thereof).\n\nThe environment values may be either a complete URL or a\n\"host[:port]\", in which case the \"http\" scheme is assumed. An error\nis returned if the value is a different form.\n" ^{:tag (* Config)} []

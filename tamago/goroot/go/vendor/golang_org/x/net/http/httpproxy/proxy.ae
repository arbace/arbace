      (return val)))


  "")












^{:go/end 125} (go/method ProxyFunc "ProxyFunc returns a function that determines the proxy URL to use for\na given request URL. Changing the contents of cfg will not affect\nproxy functions created earlier.\n\nA nil URL and nil error are returned if no proxy is defined in the\nenvironment, or a proxy should not be used for the given request, as\ndefined by NO_PROXY.\n\nAs a special case, if reqURL.Host is \"localhost\" or a loopback address\n(with or without a port number), then a nil URL and nil error will be returned.\n" ^{:tag (func [^{:tag (* url/URL)} reqURL] [(* url/URL) error])} [^{:tag (* Config)} cfg]
  ;; Preprocess the Config settings for more efficient evaluation.
  (let [cfg1 (addr ^{:go/breaks [2]} (lit config
          :Config @cfg))]

    (.init cfg1)
    (.-proxyForURL cfg1)))


^{:go/end 145} (go/method proxyForURL [^{:tag (* config)} cfg ^{:tag (* url/URL)} reqURL] :results [(* url/URL) error]
  (let [^{:tag (* url/URL)} proxy (zero (* url/URL))]
    (cond (== (.-Scheme reqURL) "https")
      (set! proxy (.-httpsProxy cfg))
      (== (.-Scheme reqURL) "http") (do
        (set! proxy (.-httpProxy cfg))
        (when (and (!= proxy nil) ^{:go/via [Config]} (.-CGI cfg))
          (return nil (errors/New "refusing to use HTTP_PROXY value in CGI environment; see golang.org/s/cgihttpproxy")))))


    (when (== proxy nil)
      (return nil nil))

    (when (not (.useProxy cfg (canonicalAddr reqURL)))
      (return nil nil))


    (return proxy nil)))


^{:go/end 165} (go/func parseProxy [^string proxy] :results [(* url/URL) error]
  (when (== proxy "")
    (return nil nil))


  (let [(values proxyURL err) (url/Parse proxy)]
    (when (or (!= err nil) (== (.-Scheme proxyURL) "") (== (.-Host proxyURL) ""))
      ;; proxy was bogus. Try prepending "http://" to it and
      ;; see if that parses correctly. If not, we fall
      ;; through and complain about the original one.
      (when [(values proxyURL err) (url/Parse (+ "http://" proxy))] (== err nil)
        (return proxyURL nil)))


    (when (!= err nil)
      (return nil (fmt/Errorf "invalid proxy address %q: %v" proxy err)))

    (return proxyURL nil)))





^{:go/end 205} (go/method useProxy "useProxy reports whether requests to addr should use a proxy,\naccording to the NO_PROXY or no_proxy environment variable.\naddr is always a canonicalAddr with a host and port.\n" ^bool [^{:tag (* config)} cfg ^string addr]
  (when (== (len addr) 0)
    (return true))

  (let [(values host port err) (net/SplitHostPort addr)]
    (when (!= err nil)
      (return false))

    (when (== host "localhost")
      (return false))

    ^{:go/breaks [[6 204]]} (let [(values nip ^:assign err) (netip/ParseAddr host)
        ^{:line 182 :tag net/IP} ip (zero net/IP)]
      (when (== err nil)
        (set! ip (conv net/IP (.AsSlice nip)))
        (when (.IsLoopback ip)
          (return false)))



      (set! addr (strings/ToLower (strings/TrimSpace host)))

      (when (!= ip nil)
        (range [_ m (.-ipMatchers cfg)]
          (when (.match m addr port ip)
            (return false))))



      (range [_ m (.-domainMatchers cfg)]
        (when (.match m addr port ip)
          (return false)))


      true)))



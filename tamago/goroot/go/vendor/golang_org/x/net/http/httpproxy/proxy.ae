  (when [(values parsed err) (parseProxy ^{:go/via [Config]} (.-HTTPProxy c))] (== err nil)
    (set! (.-httpProxy c) parsed))

  (when [(values parsed err) (parseProxy ^{:go/via [Config]} (.-HTTPSProxy c))] (== err nil)
    (set! (.-httpsProxy c) parsed))


  (range [_ p (strings/Split ^{:go/via [Config]} (.-NoProxy c) ",")]
    (set! p (strings/ToLower (strings/TrimSpace p)))
    (when (== (len p) 0)
      (continue))


    (when (== p "*")

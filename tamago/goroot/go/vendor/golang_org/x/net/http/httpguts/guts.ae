;; Package httpguts provides functions implementing various details
;; of the HTTP specification.
;;
;; This package is shared by the standard library (which vendors it)
;; and x/net/http2. It comes with no API stability promise.
(in-ns 'go.vendor.golang_org.x.net.http.httpguts) (go/file "guts.go" :doc "Package httpguts provides functions implementing various details\nof the HTTP specification.\n\nThis package is shared by the standard library (which vendors it)\nand x/net/http2. It comes with no API stability promise.\n" :imports [


    ^{:line 13} [textproto "net/textproto"]
    ^{:line 14} [strings "strings"]])





^{:go/breaks [[6 25]] :go/end 26} (go/func ValidTrailerHeader "ValidTrailerHeader reports whether name is a valid header field name to appear\nin trailers.\nSee RFC 7230, Section 4.1.2\n" ^bool [^string name]
  (set! name (textproto/CanonicalMIMEHeaderKey name))
  (when (or (strings/HasPrefix name "If-") (aget badTrailer name))
    (return false))

  true)


(go/var badTrailer (lit (map string bool)
    ^{:line 29} ["Authorization" true]
    ^{:line 30} ["Cache-Control" true]
    ^{:line 31} ["Connection" true]
    ^{:line 32} ["Content-Encoding" true]
    ^{:line 33} ["Content-Length" true]
    ^{:line 34} ["Content-Range" true]
    ^{:line 35} ["Content-Type" true]
    ^{:line 36} ["Expect" true]
    ^{:line 37} ["Host" true]
    ^{:line 38} ["Keep-Alive" true]
    ^{:line 39} ["Max-Forwards" true]
    ^{:line 40} ["Pragma" true]
    ^{:line 41} ["Proxy-Authenticate" true]
    ^{:line 42} ["Proxy-Authorization" true]
    ^{:line 43} ["Proxy-Connection" true]
    ^{:line 44} ["Range" true]
    ^{:line 45} ["Realm" true]
    ^{:line 46} ["Te" true]
    ^{:line 47} ["Trailer" true]
    ^{:line 48} ["Transfer-Encoding" true]
    ^{:line 49} ["Www-Authenticate" true]))

(ns go.vendor.golang_org.x.net.internal.httpcommon
  (:require [arbace.go :as go]))

(go/package httpcommon
  :path "vendor/golang.org/x/net/internal/httpcommon"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["ascii.go" "headermap.go" "request.go"]
  :init-order [ErrRequestHeaderListSize]
  :positions :lines)

(load "httpcommon/ascii")
(load "httpcommon/headermap")
(load "httpcommon/request")

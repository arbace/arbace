(in-ns 'go.vendor.golang_org.x.net.internal.http3) (go/file "qpack_decode.go" :imports [


    ^{:line 8} [errors "errors"]
    ^{:line 9} [bits "math/bits"]])


(go/type qpackDecoder (struct))
;; The decoder has no state for now,
;; but that'll change once we add dynamic table support.
;;
;; TODO: dynamic table support.


^{:go/end 81} (go/method decode ^error [^{:tag (* qpackDecoder)} qd ^{:tag (* stream)} st ^{:tag (func [^indexType itype ^string name ^string value] [error])} f]
  ;; Encoded Field Section prefix.

  ;; We set SETTINGS_QPACK_MAX_TABLE_CAPACITY to 0,
  ;; so the Required Insert Count must be 0.
  (let [(values _ requiredInsertCount err) (.readPrefixedInt st 8)]
    (when (!= err nil)
      (return err))

    (when (!= requiredInsertCount 0)
      (return errQPACKDecompressionFailed))


    ;; Delta Base. We don't use the dynamic table yet, so this may be ignored.
    (set! (values _ _ err) (.readPrefixedInt st 7))
    (when (!= err nil)
      (return err))


    ^{:go/breaks [[3 80]]} (let [sawNonPseudo false]
      (while (> (.-lim st) 0)
        (let [(values firstByte err) (.ReadByte st)]
          (when (!= err nil)
            (return err))

          (let [(values ^string name ^string value) (zero string)
              ^{:line 45 :tag indexType} itype (zero indexType)]
            (switch (bits/LeadingZeros8 firstByte)
              (case [0]
                ;; Indexed Field Line
                (set! (values itype name value err) (.decodeIndexedFieldLine st firstByte)))
              (case [1]
                ;; Literal Field Line With Name Reference
                (set! (values itype name value err) (.decodeLiteralFieldLineWithNameReference st firstByte)))
              (case [2]
                ;; Literal Field Line with Literal Name
                (set! (values itype name value err) (.decodeLiteralFieldLineWithLiteralName st firstByte)))
              (case [3]
                ;; Indexed Field Line With Post-Base Index
                (set! err (errors/New "dynamic table is not supported yet")))
              (case [4]
                ;; Indexed Field Line With Post-Base Name Reference
                (set! err (errors/New "dynamic table is not supported yet"))))

            (when (!= err nil)
              (return err))

            (when (== (len name) 0)
              (return errH3MessageError))

            (if (== (aget name 0) \:)
              (when sawNonPseudo
                (return errH3MessageError))


              (set! sawNonPseudo true))

            (when [err (f itype name value)] (!= err nil)
              (return err)))))


      nil)))

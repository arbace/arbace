(in-ns 'go.vendor.golang_org.x.net.internal.http3) (go/file "settings.go" :imports [])

(go/const

  ^{:line 9} [^{:val 6 :doc "https://www.rfc-editor.org/rfc/rfc9114.html#section-7.2.4.1\n"} settingsMaxFieldSectionSize 0x06]


  ^{:line 12} [^{:val 1 :doc "https://www.rfc-editor.org/rfc/rfc9204.html#section-5\n"} settingsQPACKMaxTableCapacity 0x01]
  ^{:line 13} [^{:val 7} settingsQPACKBlockedStreams 0x07])




^{:go/end 29} (go/method writeSettings "writeSettings writes a complete SETTINGS frame.\nIts parameter is a list of alternating setting types and values.\n" [^{:tag (* stream)} st & ^{:tag (slice int64)} settings]
  (let [^int64 size (zero int64)]
    (range [_ s settings]
      ;; Settings values that don't fit in a QUIC varint ([0,2^62)) will panic here.
      (set! size + (conv int64 (sizeVarint (conv uint64 s)))))

    (.writeVarint st (conv int64 frameTypeSettings))
    (.writeVarint st size)
    (range [_ s settings]
      (.writeVarint st s))))




^{:go/end 66} (go/method readSettings "readSettings reads a complete SETTINGS frame, including the frame header.\n" ^error [^{:tag (* stream)} st ^{:tag (func [^int64 settingType ^int64 value] [error])} f]
  (let [(values frameType err) (.readFrameHeader st)]
    (when (or (!= err nil) (!= frameType frameTypeSettings))
      (return (addr ^{:go/breaks [2 4]} (lit connectionError
            :code errH3MissingSettings
            :message "settings not sent on control stream"))))


    (while (> (.-lim st) 0)
      (let [(values settingsType err) (.readVarint st)]
        (when (!= err nil)
          (return err))

        (let [(values settingsValue ^:assign err) (.readVarint st)]
          (when (!= err nil)
            (return err))


          ;; Use of HTTP/2 settings where there is no corresponding HTTP/3 setting
          ;; is an error.
          ;; https://www.rfc-editor.org/rfc/rfc9114.html#section-7.2.4.1-5
          (switch settingsType
            (case [0x02 0x03 0x04 0x05]
              (return (addr ^{:go/breaks [2 4]} (lit connectionError
                    :code errH3SettingsError
                    :message "use of reserved setting")))))



          (when [err (f settingsType settingsValue)] (!= err nil)
            (return err)))))


    (.endFrame st)))

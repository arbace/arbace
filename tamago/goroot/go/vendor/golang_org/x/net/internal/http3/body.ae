^{:go/end 34} (go/func extractTrailerFromHeader "extractTrailerFromHeader extracts the \"Trailer\" header values from a header\nmap, and populates a trailer map with those values as keys. The extracted\nheader values will be canonicalized.\n" [^http/Header header ^http/Header trailer]
  (range [_ names (aget header "Trailer")]
    (set! names (textproto/TrimString names))
    (range [name (strings/SplitSeq names ",")]
      (set! name (textproto/CanonicalMIMEHeaderKey (textproto/TrimString name)))
      (when (not (httpguts/ValidTrailerHeader name))
        (continue))

      (aset trailer name nil))))







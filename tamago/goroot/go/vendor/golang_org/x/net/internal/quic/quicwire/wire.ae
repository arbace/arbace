;; Package quicwire encodes and decode QUIC/HTTP3 wire encoding types,
;; particularly variable-length integers.
(in-ns 'go.vendor.golang_org.x.net.internal.quic.quicwire) (go/file "wire.go" :doc "Package quicwire encodes and decode QUIC/HTTP3 wire encoding types,\nparticularly variable-length integers.\n" :imports [

    ^{:line 9} [binary "encoding/binary"]])

(go/const
  ^{:line 12} [^{:val 8} MaxVarintSize 8] ; encoded size in bytes
  ^{:line 13} [^{:val 4611686018427387903} MaxVarint (- (<< 1 62) 1)])






^{:go/end 45} (go/func ConsumeVarint "ConsumeVarint parses a variable-length integer, reporting its length.\nIt returns a negative length upon an error.\n\nhttps://www.rfc-editor.org/rfc/rfc9000.html#section-16\n" [^{:tag (slice byte)} b] :results [^uint64 v ^int n]
  (when (< (len b) 1)
    (return 0 -1))

  (let [b0 (bit-and (aget b 0) 0x3f)]
    (switch (>> (aget b 0) 6)
      (case [0]
        (return (conv uint64 b0) 1))
      (case [1]
        (when (< (len b) 2)
          (return 0 -1))

        (return (bit-or (<< (conv uint64 b0) 8) (conv uint64 (aget b 1))) 2))
      (case [2]
        (when (< (len b) 4)
          (return 0 -1))

        (return (bit-or (<< (conv uint64 b0) 24) (<< (conv uint64 (aget b 1)) 16) (<< (conv uint64 (aget b 2)) 8) (conv uint64 (aget b 3))) 4))
      (case [3]
        (when (< (len b) 8)
          (return 0 -1))

        (return (bit-or (<< (conv uint64 b0) 56) (<< (conv uint64 (aget b 1)) 48) (<< (conv uint64 (aget b 2)) 40) (<< (conv uint64 (aget b 3)) 32) (<< (conv uint64 (aget b 4)) 24) (<< (conv uint64 (aget b 5)) 16) (<< (conv uint64 (aget b 6)) 8) (conv uint64 (aget b 7))) 8)))

    (return 0 -1)))



^{:go/end 52} (go/func ConsumeVarintInt64 "ConsumeVarintInt64 parses a variable-length integer as an int64.\n" [^{:tag (slice byte)} b] :results [^int64 v ^int n]
  (let [(values u ^:assign n) (ConsumeVarint b)]
    ;; QUIC varints are 62-bits large, so this conversion can never overflow.
    (return (conv int64 u) n)))





^{:go/end 70} (go/func AppendVarint "AppendVarint appends a variable-length integer to b.\n\nhttps://www.rfc-editor.org/rfc/rfc9000.html#section-16\n" ^{:tag (slice byte)} [^{:tag (slice byte)} b ^uint64 v]
  (switch
    (case [(<= v 63)]
      (return (append b (conv byte v))))
    (case [(<= v 16383)]
      (return (append b (bit-or (<< 1 6) (conv byte (>> v 8))) (conv byte v))))
    (case [(<= v 1073741823)]
      (return (append b (bit-or (<< 2 6) (conv byte (>> v 24))) (conv byte (>> v 16)) (conv byte (>> v 8)) (conv byte v))))
    (case [(<= v 4611686018427387903)]
      (return (append b (bit-or (<< 3 6) (conv byte (>> v 56))) (conv byte (>> v 48)) (conv byte (>> v 40)) (conv byte (>> v 32)) (conv byte (>> v 24)) (conv byte (>> v 16)) (conv byte (>> v 8)) (conv byte v))))
    (default
      (panic "varint too large"))))




^{:go/end 86} (go/func SizeVarint "SizeVarint returns the size of the variable-length integer encoding of f.\n" ^int [^uint64 v]
  (switch
    (case [(<= v 63)]
      (return 1))
    (case [(<= v 16383)]
      (return 2))
    (case [(<= v 1073741823)]
      (return 4))
    (case [(<= v 4611686018427387903)]
      (return 8))
    (default
      (panic "varint too large"))))





^{:go/end 95} (go/func ConsumeUint32 "ConsumeUint32 parses a 32-bit fixed-length, big-endian integer, reporting its length.\nIt returns a negative length upon an error.\n" [^{:tag (slice byte)} b] :results [uint32 int]
  (when (< (len b) 4)
    (return 0 -1))

  (return (.Uint32 binary/BigEndian b) 4))




^{:go/end 104} (go/func ConsumeUint64 "ConsumeUint64 parses a 64-bit fixed-length, big-endian integer, reporting its length.\nIt returns a negative length upon an error.\n" [^{:tag (slice byte)} b] :results [uint64 int]
  (when (< (len b) 8)
    (return 0 -1))

  (return (.Uint64 binary/BigEndian b) 8))





^{:go/end 119} (go/func ConsumeUint8Bytes "ConsumeUint8Bytes parses a sequence of bytes prefixed with an 8-bit length,\nreporting the total number of bytes consumed.\nIt returns a negative length upon an error.\n" [^{:tag (slice byte)} b] :results [(slice byte) int]
  (when (< (len b) 1)
    (return nil -1))

  (let [size (conv int (aget b 0))
      ^:const ^{:line 114 :val 1} n 1]
    (when (> size (len (subslice b n)))
      (return nil -1))

    (return (subslice (subslice b n) _ size) (+ size n))))



^{:go/end 129} (go/func AppendUint8Bytes "AppendUint8Bytes appends a sequence of bytes prefixed by an 8-bit length.\n" ^{:tag (slice byte)} [^{:tag (slice byte)} b ^{:tag (slice byte)} v]
  (when (> (len v) 0xff)
    (panic "uint8-prefixed bytes too large"))

  (set! b (append b (conv uint8 (len v))))
  (set! b (append b (spread v)))
  ^{:line 128} b)





^{:go/end 143} (go/func ConsumeVarintBytes "ConsumeVarintBytes parses a sequence of bytes preceded by a variable-length integer length,\nreporting the total number of bytes consumed.\nIt returns a negative length upon an error.\n" [^{:tag (slice byte)} b] :results [(slice byte) int]
  (let [(values size n) (ConsumeVarint b)]
    (when (< n 0)
      (return nil -1))

    (when (> size (conv uint64 (len (subslice b n))))
      (return nil -1))

    (return (subslice (subslice b n) _ size) (+ (conv int size) n))))



^{:go/end 150} (go/func AppendVarintBytes "AppendVarintBytes appends a sequence of bytes prefixed by a variable-length integer length.\n" ^{:tag (slice byte)} [^{:tag (slice byte)} b ^{:tag (slice byte)} v]
  (set! b (AppendVarint b (conv uint64 (len v))))
  (set! b (append b (spread v)))

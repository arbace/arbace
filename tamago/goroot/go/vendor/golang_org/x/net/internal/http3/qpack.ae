;; Indexed Field Line:
;;
;;       0   1   2   3   4   5   6   7
;;     +---+---+---+---+---+---+---+---+
;;     | 1 | T |      Index (6+)       |
;;     +---+---+-----------------------+
;;
;; https://www.rfc-editor.org/rfc/rfc9204.html#section-4.5.2

^{:go/end 89} (go/func appendIndexedFieldLine ^{:tag (slice byte)} [^{:tag (slice byte)} b ^tableType ttype ^int index]

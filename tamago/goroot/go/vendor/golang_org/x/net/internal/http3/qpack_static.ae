^{:go/end 20} (go/func staticTableEntry "staticTableEntry returns the static table entry with the given index.\n" [^int64 index] :results [tableEntry error]
  (when (>= index (conv int64 (len staticTableEntries)))
    (return (lit tableEntry) errQPACKDecompressionFailed))

  (return (aget staticTableEntries index) nil))


^{:go/end 31} (go/func initStaticTableMaps []
  (set! staticTableByName (make (map string int)))
  (set! staticTableByNameValue (make (map tableEntry int)))
  (range [i ent staticTableEntries]
    (when [(values _ ok) (aget staticTableByName (.-name ent))] (not ok)
      (aset staticTableByName (.-name ent) i))

    (aset staticTableByNameValue ent i)))




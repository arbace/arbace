                    (if (!= (.-Opaque (.-URL req)) "")
                      (return res (fmt/Errorf "invalid request :path %q from URL.Opaque = %q" orig (.-Opaque (.-URL req))))

                      (return res (fmt/Errorf "invalid request :path %q" orig)))))))






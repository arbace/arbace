^{:go/end 381} (go/func shouldSendReqContentLength "shouldSendReqContentLength reports whether we should send\na \"content-length\" request header. This logic is basically a copy of the net/http\ntransferWriter.shouldSendContentLength.\nThe contentLength is the corrected contentLength (so 0 means actually 0, not unknown).\n-1 means unknown.\n" ^bool [^string method ^int64 contentLength]
  (when (> contentLength 0)
    (return true))

  (when (< contentLength 0)
    (return false))

  ;; For zero bodies, whether we send a content-length depends on the method.
  ;; It also kinda doesn't matter for http2 either way, with END_STREAM.
  (switch method
    (case ["POST" "PUT" "PATCH"]
      (return true))
    (default
      (return false))))





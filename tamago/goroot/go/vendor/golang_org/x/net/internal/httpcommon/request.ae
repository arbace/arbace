^{:go/breaks [[5 288]] :go/end 289} (go/func IsRequestGzip "IsRequestGzip reports whether we should add an Accept-Encoding: gzip header\nfor a request.\n" ^bool [^string method ^{:tag (map string (slice string))} header ^bool disableCompression]
  ;; TODO(bradfitz): this is a copy of the logic in net/http. Unify somewhere?
  (when (and (not disableCompression)
      (== (len (aget header "Accept-Encoding")) 0)
      (== (len (aget header "Range")) 0)
      (!= method "HEAD"))
    ;; Request gzip only, not deflate. Deflate is ambiguous and
    ;; not as universally supported anyway.
    ;; See: https://zlib.net/zlib_faq.html#faq39
    ;;
    ;; Note that we don't request this for HEAD requests,
    ;; due to a bug in nginx:
    ;;   http://trac.nginx.org/nginx/ticket/358
    ;;   https://golang.org/issue/5522
    ;;
    ;; We don't request gzip if the request is for a range, since
    ;; auto-decoding a portion of a gzipped document will just fail
    ;; anyway. See https://golang.org/issue/8923
    (return true))

  false)










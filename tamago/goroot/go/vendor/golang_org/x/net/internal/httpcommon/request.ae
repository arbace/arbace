^{:go/end 264} (go/func EncodeHeaders "EncodeHeaders constructs request headers common to HTTP/2 and HTTP/3.\nIt validates a request and calls headerf with each pseudo-header and header\nfor the request.\nThe headerf function is called with the validated, canonicalized header name.\n" [^context/Context ctx ^EncodeHeadersParam param ^{:tag (func [^string name ^string value])} headerf] :results [^EncodeHeadersResult res ^error _]

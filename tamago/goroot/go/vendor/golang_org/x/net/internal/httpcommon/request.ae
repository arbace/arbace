^{:go/end 326} (go/func commaSeparatedTrailers [^{:tag (map string (slice string))} trailer] :results [string error]
  (let [keys (make (slice string) 0 (len trailer))]
    (range [k trailer]
      (set! k (CanonicalHeader k))
      (switch k

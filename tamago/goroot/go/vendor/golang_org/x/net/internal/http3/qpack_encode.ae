(in-ns 'go.vendor.golang_org.x.net.internal.http3) (go/file "qpack_encode.go" :imports [


    ^{:line 8} [httpcommon "golang.org/x/net/internal/httpcommon"]])


(go/type qpackEncoder (struct))
;; The encoder has no state for now,
;; but that'll change once we add dynamic table support.
;;
;; TODO: dynamic table support.


^{:go/end 20} (go/method init [^{:tag (* qpackEncoder)} qe]
  (.Do staticTableOnce initStaticTableMaps))






^{:go/end 61} (go/method encode "encode encodes a list of headers into a QPACK encoded field section.\n\nThe headers func must produce the same headers on repeated calls,\nalthough the order may vary.\n" ^{:tag (slice byte)} [^{:tag (* qpackEncoder)} qe ^{:tag (func [(func [^indexType itype ^string name ^string value])])} headers]
  ;; Encoded Field Section prefix.
  ;;
  ;; We don't yet use the dynamic table, so both values here are zero.
  (let [^{:tag (slice byte)} b (zero (slice byte))]
    (set! b (appendPrefixedInt b 0 8 0)) ; Required Insert Count
    (set! b (appendPrefixedInt b 0 7 0)) ; Delta Base

    (headers ^{:go/end 58} (fn [^indexType itype ^string name ^string value]
        ;; Technically, it is the responsibility of the protocol using HTTP/3
        ;; to ensure that all field names are already in lowercase. However,
        ;; this QPACK implementation is solely used by and live in the http3
        ;; package. So, we might as well do the lowercasing here to make sure
        ;; we do not miss any callsites or need to create yet another struct
        ;; wrapping the qpackEncoder.
        (let [(values ^:assign name ascii) (httpcommon/LowerHeader name)]
          ;; Skip writing invalid headers. Per RFC 9114 section 4.2: "Field
          ;; names are strings containing a subset of ASCII characters."
          (when (not ascii)
            (return))

          (when (== itype mayIndex)
            (when [(values i ok) (aget staticTableByNameValue (lit tableEntry name value))] ok
              (set! b (appendIndexedFieldLine b staticTable i))
              (return)))


          (if [(values i ok) (aget staticTableByName name)] ok
            (set! b (appendLiteralFieldLineWithNameReference b staticTable itype i value))

            (set! b (appendLiteralFieldLineWithLiteralName b itype name value))))))



    ^{:line 60} b))

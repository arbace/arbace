(ns go.vendor.golang_org.x.net.internal.http3
  (:require [arbace.go :as go]))

(go/package http3
  :path "vendor/golang.org/x/net/internal/http3"
  :files ["body.go" "conn.go" "doc.go" "errors.go" "http3.go" "qpack.go" "qpack_decode.go" "qpack_encode.go" "qpack_static.go" "quic.go" "roundtrip.go" "server.go" "settings.go" "stream.go" "transport.go" "varint.go"]
  :positions :lines)

(load "http3/body")
(load "http3/conn")
(load "http3/doc")
(load "http3/errors")
(load "http3/http3")
(load "http3/qpack")
(load "http3/qpack_decode")
(load "http3/qpack_encode")
(load "http3/qpack_static")
(load "http3/quic")
(load "http3/roundtrip")
(load "http3/server")
(load "http3/settings")
(load "http3/stream")
(load "http3/transport")
(load "http3/varint")

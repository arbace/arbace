(in-ns 'go.vendor.golang_org.x.net.quic) (go/file "pipe.go" :imports [


    ^{:line 8} [sync "sync"]])








(go/type pipe "A pipe is a byte buffer used in implementing streams.\n\nA pipe contains a window of stream data.\nRandom access reads and writes are supported within the window.\nWriting past the end of the window extends it.\nData may be discarded from the start of the pipe, advancing the window.\n" (struct
    ^{:line 18 :tag int64} start ; stream position of first stored byte
    ^{:line 19 :tag int64} end ; stream position just past the last stored byte
    ^{:line 20 :tag (* pipebuf)} head ; if non-nil, then head.off + len(head.b) > start
    ^{:line 21 :tag (* pipebuf)} tail)) ; if non-nil, then tail.off + len(tail.b) == end


(go/type pipebuf (struct
    ^{:line 25 :tag int64} off ; stream position of b[0]
    ^{:line 26 :tag (slice byte)} b
    ^{:line 27 :tag (* pipebuf)} next))


^{:go/end 32} (go/method end ^int64 [^{:tag (* pipebuf)} pb]
  (+ (.-off pb) (conv int64 (len (.-b pb)))))


(go/var pipebufPool ^{:go/breaks [2]} (lit sync/Pool
    :New ^{:go/end 39} (fn ^any []
      (addr ^{:go/breaks [2]} (lit pipebuf
          :b (make (slice byte) 4096))))))




^{:go/end 44} (go/func newPipebuf ^{:tag (* pipebuf)} []
  (assert (* pipebuf) (.Get pipebufPool)))


^{:go/end 50} (go/method recycle [^{:tag (* pipebuf)} b]
  (set! (.-off b) 0)
  (set! (.-next b) nil)
  (.Put pipebufPool b))






^{:go/end 98} (go/method writeAt "writeAt writes len(b) bytes to the pipe at offset off.\n\nWrites to offsets before p.start are discarded.\nWrites to offsets after p.end extend the pipe window.\n" [^{:tag (* pipe)} p ^{:tag (slice byte)} b ^int64 off]
  (let [end (+ off (conv int64 (len b)))]
    (cond (> end (.-end p))
      (set! (.-end p) end)
      (<= end (.-start p))
      (return))


    (when (< off (.-start p))
      ;; Discard the portion of b which falls before p.start.
      (let [trim (- (.-start p) off)]
        (set! b (subslice b trim))
        (set! off (.-start p))))


    (when (== (.-head p) nil)
      (set! (.-head p) (newPipebuf))
      (set! (.-off (.-head p)) (.-start p))
      (set! (.-tail p) (.-head p)))

    (let [pb (.-head p)]
      (when (>= off (.-off (.-tail p)))
        ;; Common case: Writing past the end of the pipe.
        (set! pb (.-tail p)))

      (while true
        (let [pboff (- off (.-off pb))]
          (when (< pboff (conv int64 (len (.-b pb))))
            (let [n (copy (subslice (.-b pb) pboff) b)]
              (when (== n (len b))
                (return))

              (set! off + (conv int64 n))
              (set! b (subslice b n))))

          (when (== (.-next pb) nil)
            (set! (.-next pb) (newPipebuf))
            (set! (.-off (.-next pb)) (+ (.-off pb) (conv int64 (len (.-b pb)))))
            (set! (.-tail p) (.-next pb)))

          (set! pb (.-next pb)))))))





^{:go/end 108} (go/method copy "copy copies len(b) bytes into b starting from off.\nThe pipe must contain [off, off+len(b)).\n" [^{:tag (* pipe)} p ^int64 off ^{:tag (slice byte)} b]
  (let [dst (subslice b _ 0)]
    (.read p off (len b) ^{:go/breaks [3] :go/end 107} (fn ^error [^{:tag (slice byte)} c]
        (set! dst (append dst (spread c)))
        nil))))






^{:go/breaks [[7 134]] :go/end 135} (go/method read "read calls f with the data in [off, off+n)\nThe data may be provided sequentially across multiple calls to f.\nNote that read (unlike an io.Reader) does not consume the read data.\n" ^error [^{:tag (* pipe)} p ^int64 off ^int n ^{:tag (func [(slice byte)] [error])} f]
  (when (< off (.-start p))
    (panic "invalid read range"))

  (for [pb (.-head p)] (and (!= pb nil) (> n 0)) (set! pb (.-next pb))
    (when (>= off (.end pb))
      (continue))

    (let [b (subslice (.-b pb) (- off (.-off pb)))]
      (when (> (len b) n)
        (set! b (subslice b _ n)))

      (set! off + (conv int64 (len b)))
      (set! n - (len b))
      (when [err (f b)] (!= err nil)
        (return err))))


  (when (> n 0)
    (panic "invalid read range"))

  nil)





^{:go/end 147} (go/method peek "peek returns a reference to up to n bytes of internal data buffer, starting at p.start.\nThe returned slice is valid until the next call to discardBefore.\nThe length of the returned slice will be in the range [0,n].\n" ^{:tag (slice byte)} [^{:tag (* pipe)} p ^int64 n]
  (let [pb (.-head p)]
    (when (== pb nil)
      (return nil))

    (let [b (subslice (.-b pb) (- (.-start p) (.-off pb)))]
      (subslice b _ (min (conv int64 (len b)) n)))))







^{:go/end 159} (go/method availableBuffer "availableBuffer returns the available contiguous, allocated buffer space\nfollowing the pipe window.\n\nThis is used by the stream write fast path, which makes multiple writes into the pipe buffer\nwithout a lock, and then adjusts p.end at a later time with a lock held.\n" ^{:tag (slice byte)} [^{:tag (* pipe)} p]
  (when (== (.-tail p) nil)
    (return nil))

  (subslice (.-b (.-tail p)) (- (.-end p) (.-off (.-tail p)))))



^{:go/end 173} (go/method discardBefore "discardBefore discards all data prior to off.\n" [^{:tag (* pipe)} p ^int64 off]
  (while (and (!= (.-head p) nil) (< (.end (.-head p)) off))
    (let [head (.-head p)]
      (set! (.-head p) (.-next (.-head p)))
      (.recycle head)))

  (when (== (.-head p) nil)
    (set! (.-tail p) nil))

  (set! (.-start p) off)
  (set! (.-end p) (max (.-end p) off)))

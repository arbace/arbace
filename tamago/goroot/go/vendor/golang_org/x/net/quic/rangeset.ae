(in-ns 'go.vendor.golang_org.x.net.quic) (go/file "rangeset.go" :imports [])






(go/type rangeset "A rangeset is a set of int64s, stored as an ordered list of non-overlapping,\nnon-empty ranges.\n\nRangesets are efficient for small numbers of ranges,\nwhich is expected to be the common case.\n" :type-params [^{:tag (tilde int64)} T] (slice (i64range T)))

(go/type i64range :type-params [^{:tag (tilde int64)} T] (struct
    ^{:line 15 :tag T} start ^:go/grouped ^T end)) ; [start, end)



^{:go/end 21} (go/method size "size returns the size of the range.\n" ^T [^{:tag (i64range T)} r]
  (- (.-end r) (.-start r)))



^{:go/end 26} (go/method contains "contains reports whether v is in the range.\n" ^bool [^{:tag (i64range T)} r ^T v]
  (and (<= (.-start r) v) (< v (.-end r))))



^{:go/end 64} (go/method add "add adds [start, end) to the set, combining it with existing ranges if necessary.\n" [^{:tag (* (rangeset T))} s ^T start ^:go/grouped ^T end]
  (when (== start end)
    (return))

  (range [i @s]
    (let [r (addr (aget @s i))]
      (when (> (.-start r) end)
        ;; The new range comes before range i.
        (.insertrange s i start end)
        (return))

      (when (> start (.-end r))
        ;; The new range comes after range i.
        (continue))

      ;; The new range is adjacent to or overlapping range i.
      (when (< start (.-start r))
        (set! (.-start r) start))

      (when (<= end (.-end r))
        (return))

      ;; Possibly coalesce subsequent ranges into range i.
      (set! (.-end r) end)
      (let [j (+ i 1)]
        (for [] (and (< j (len @s)) (>= (.-end r) (.-start (aget @s j)))) (inc! j)
          (when [e (.-end (aget @s j))] (> e (.-end r))
            ;; Range j ends after the new range.
            (set! (.-end r) e)))


        (.removeranges s (+ i 1) j)
        (return))))

  (set! @s (append @s (lit (i64range T) start end))))



^{:go/end 101} (go/method sub "sub removes [start, end) from the set.\n" [^{:tag (* (rangeset T))} s ^T start ^:go/grouped ^T end]
  (let [(values removefrom removeto) (values -1 -1)]
    (range [i @s]
      (let [r (addr (aget @s i))]
        (when (< end (.-start r))
          (break))

        (when (< (.-end r) start)
          (continue))

        (switch
          (case [(and (<= start (.-start r)) (>= end (.-end r)))]
            ;; Remove the entire range.
            (when (== removefrom -1)
              (set! removefrom i))

            (set! removeto (+ i 1)))
          (case [(<= start (.-start r))]
            ;; Remove a prefix.
            (set! (.-start r) end))
          (case [(>= end (.-end r))]
            ;; Remove a suffix.
            (set! (.-end r) start))
          (default
            ;; Remove the middle, leaving two new ranges.
            (let [rend (.-end r)]
              (set! (.-end r) start)
              (.insertrange s (+ i 1) end rend)
              (return))))))


    (when (!= removefrom -1)
      (.removeranges s removefrom removeto))))




^{:go/breaks [[5 114]] :go/end 115} (go/method contains "contains reports whether s contains v.\n" ^bool [^{:tag (rangeset T)} s ^T v]
  (range [_ r s]
    (when (>= v (.-end r))
      (continue))

    (when (<= (.-start r) v)
      (return true))

    (return false))

  false)



^{:go/end 129} (go/method rangeContaining "rangeContaining returns the range containing v, or the range [0,0) if v is not in s.\n" ^{:tag (i64range T)} [^{:tag (rangeset T)} s ^T v]
  (range [_ r s]
    (when (>= v (.-end r))
      (continue))

    (when (<= (.-start r) v)
      (return r))

    (break))

  (lit (i64range T) 0 0))



^{:go/end 137} (go/method min "min returns the minimum value in the set, or 0 if empty.\n" ^T [^{:tag (rangeset T)} s]
  (when (== (len s) 0)
    (return 0))

  (.-start (aget s 0)))



^{:go/end 145} (go/method max "max returns the maximum value in the set, or 0 if empty.\n" ^T [^{:tag (rangeset T)} s]
  (when (== (len s) 0)
    (return 0))

  (- (.-end (aget s (- (len s) 1))) 1))



^{:go/end 153} (go/method end "end returns the end of the last range in the set, or 0 if empty.\n" ^T [^{:tag (rangeset T)} s]
  (when (== (len s) 0)
    (return 0))

  (.-end (aget s (- (len s) 1))))



^{:go/end 158} (go/method numRanges "numRanges returns the number of ranges in the rangeset.\n" ^int [^{:tag (rangeset T)} s]
  (len s))



^{:go/end 166} (go/method size "size returns the size of all ranges in the rangeset.\n" [^{:tag (rangeset T)} s] :results [^T total]
  (range [_ r s]
    (set! total + (.size r)))

  ^{:line 165} total)



^{:go/breaks [[5 176]] :go/end 177} (go/method isrange "isrange reports if the rangeset covers exactly the range [start, end).\n" ^bool [^{:tag (rangeset T)} s ^T start ^:go/grouped ^T end]
  (switch (len s)
    (case [0]
      (return (and (== start 0) (== end 0))))
    (case [1]
      (return (and (== (.-start (aget s 0)) start) (== (.-end (aget s 0)) end)))))

  false)



^{:go/end 186} (go/method removeranges "removeranges removes ranges [i,j).\n" [^{:tag (* (rangeset T))} s ^int i ^:go/grouped ^int j]
  (when (== i j)
    (return))

  (copy (subslice @s i) (subslice @s j))
  (set! @s (subslice @s _ (- (len @s) (- j i)))))



^{:go/end 193} (go/method insertrange "insert adds a new range at index i.\n" [^{:tag (* (rangeset T))} s ^int i ^T start ^:go/grouped ^T end]
  (set! @s (append @s (lit (i64range T))))
  (copy (subslice @s (+ i 1)) (subslice @s i))
  (aset @s i (lit (i64range T) start end)))

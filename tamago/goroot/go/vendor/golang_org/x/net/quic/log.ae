(in-ns 'go.vendor.golang_org.x.net.quic) (go/file "log.go" :imports [


    ^{:line 8} [fmt "fmt"]
    ^{:line 9} [os "os"]
    ^{:line 10} [strings "strings"]])


(go/var ^bool logPackets)




^{:go/end 28} (go/func init "Parse GODEBUG settings.\n\nGODEBUG=quiclogpackets=1 -- log every packet sent and received.\n" []
  (let [s (os/Getenv "GODEBUG")]
    (while (> (len s) 0)
      (let [^string opt (zero string)]
        (set! (values opt s _) (strings/Cut s ","))
        (switch opt
          (case ["quiclogpackets=1"]
            (set! logPackets true)))))))




^{:go/end 37} (go/func logInboundLongPacket [^{:tag (* Conn)} c ^longPacket p]
  (when (not logPackets)
    (return))

  (let [prefix (.String c)]
    (fmt/Printf "%v recv %v %v\n" prefix (.-ptype p) (.-num p))
    (logFrames (+ prefix "   <- ") (.-payload p))))


^{:go/end 46} (go/func logInboundShortPacket [^{:tag (* Conn)} c ^shortPacket p]
  (when (not logPackets)
    (return))

  (let [prefix (.String c)]
    (fmt/Printf "%v recv 1-RTT %v\n" prefix (.-num p))
    (logFrames (+ prefix "   <- ") (.-payload p))))


^{:go/end 55} (go/func logSentPacket [^{:tag (* Conn)} c ^packetType ptype ^packetNumber pnum ^{:tag (slice byte)} src ^{:tag (slice byte)} dst ^{:tag (slice byte)} payload]
  (when (or (not logPackets) (== (len payload) 0))
    (return))

  (let [prefix (.String c)]
    (fmt/Printf "%v send %v %v\n" prefix ptype pnum)
    (logFrames (+ prefix "   -> ") payload)))


^{:go/end 67} (go/func logFrames [^string prefix ^{:tag (slice byte)} payload]
  (while (> (len payload) 0)
    (let [(values f n) (parseDebugFrame payload)]
      (when (< n 0)
        (fmt/Printf "%vBAD DATA\n" prefix)
        (break))

      (set! payload (subslice payload n))
      (fmt/Printf "%v%v\n" prefix f))))

(in-ns 'go.vendor.golang_org.x.net.quic) (go/file "packet_number.go" :imports [])





(go/type packetNumber "A packetNumber is a QUIC packet number.\nPacket numbers are integers in the range [0, 2^62-1].\n\nhttps://www.rfc-editor.org/rfc/rfc9000.html#section-12.3\n" int64)

(go/const ^{:val 4611686018427387903} maxPacketNumber (- (<< 1 62) 1)) ; https://www.rfc-editor.org/rfc/rfc9000.html#section-17.1-1








^{:go/end 35} (go/func decodePacketNumber "decodePacketNumber decodes a truncated packet number, given\nthe largest acknowledged packet number in this number space,\nthe truncated number received in a packet, and the size of the\nnumber received in bytes.\n\nhttps://www.rfc-editor.org/rfc/rfc9000.html#section-17.1\nhttps://www.rfc-editor.org/rfc/rfc9000.html#section-a.3\n" ^packetNumber [^packetNumber largest ^packetNumber truncated ^int numLenInBytes]
  (let [expected (+ largest 1)
      ^{:line 24} win (<< (conv packetNumber 1) (* (conv uint numLenInBytes) 8))
      ^{:line 25} hwin (/ win 2)
      ^{:line 26} mask (- win 1)
      ^{:line 27} candidate (bit-or (bit-and-not expected mask) truncated)]
    (when (and (<= candidate (- expected hwin)) (< candidate (- (<< 1 62) win)))
      (return (+ candidate win)))

    (when (and (> candidate (+ expected hwin)) (>= candidate win))
      (return (- candidate win)))

    ^{:line 34} candidate))







^{:go/end 53} (go/func appendPacketNumber "appendPacketNumber appends an encoded packet number to b.\nThe packet number must be larger than the largest acknowledged packet number.\nWhen no packets have been acknowledged yet, largestAck is -1.\n\nhttps://www.rfc-editor.org/rfc/rfc9000.html#section-17.1-5\n" ^{:tag (slice byte)} [^{:tag (slice byte)} b ^packetNumber pnum ^packetNumber largestAck]
  (switch (packetNumberLength pnum largestAck)
    (case [1]
      (return (append b (conv byte pnum))))
    (case [2]
      (return (append b (conv byte (>> pnum 8)) (conv byte pnum))))
    (case [3]
      (return (append b (conv byte (>> pnum 16)) (conv byte (>> pnum 8)) (conv byte pnum))))
    (default
      (return (append b (conv byte (>> pnum 24)) (conv byte (>> pnum 16)) (conv byte (>> pnum 8)) (conv byte pnum))))))








^{:go/end 72} (go/func packetNumberLength "packetNumberLength returns the minimum length, in bytes, needed to encode\na packet number given the largest acknowledged packet number.\nThe packet number must be larger than the largest acknowledged packet number.\n\nhttps://www.rfc-editor.org/rfc/rfc9000.html#section-17.1-5\n" ^int [^packetNumber pnum ^packetNumber largestAck]
  (let [d (- pnum largestAck)]
    (switch
      (case [(< d 0x80)]
        (return 1))
      (case [(< d 0x8000)]
        (return 2))
      (case [(< d 0x800000)]
        (return 3))
      (default
        (return 4)))))

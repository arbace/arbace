(in-ns 'go.vendor.golang_org.x.net.quic) (go/file "sent_packet_list.go" :imports [])







(go/type sentPacketList "A sentPacketList is a ring buffer of sentPackets.\n\nProcessing an ack for a packet causes all older packets past a small threshold\nto be discarded (RFC 9002, Section 6.1.1), so the list of in-flight packets is\nnot sparse and will contain at most a few acked/lost packets we no longer\ncare about.\n" (struct
    ^{:line 14 :tag packetNumber} nextNum ; next packet number to add to the buffer
    ^{:line 15 :tag int} off ; offset of first packet in the buffer
    ^{:line 16 :tag int} size ; number of packets
    ^{:line 17 :tag (slice (* sentPacket))} p))



^{:go/end 23} (go/method start "start is the first packet in the list.\n" ^packetNumber [^{:tag (* sentPacketList)} s]
  (- (.-nextNum s) (conv packetNumber (.-size s))))




^{:go/end 29} (go/method end "end is one after the last packet in the list.\nIf the list is empty, start == end.\n" ^packetNumber [^{:tag (* sentPacketList)} s]
  (.-nextNum s))



^{:go/end 34} (go/method discard "discard clears the list.\n" [^{:tag (* sentPacketList)} s]
  (set! @s (lit sentPacketList)))



^{:go/end 48} (go/method add "add appends a packet to the list.\n" [^{:tag (* sentPacketList)} s ^{:tag (* sentPacket)} sent]
  (when (!= (.-nextNum s) (.-num sent))
    (panic "inserting out-of-order packet"))

  (inc! (.-nextNum s))
  (when (>= (.-size s) (len (.-p s)))
    (.grow s))

  (let [i (% (+ (.-off s) (.-size s)) (len (.-p s)))]
    (inc! (.-size s))
    (aset (.-p s) i sent)))



^{:go/end 54} (go/method nth "nth returns a packet by index.\n" ^{:tag (* sentPacket)} [^{:tag (* sentPacketList)} s ^int n]
  (let [index (% (+ (.-off s) n) (len (.-p s)))]
    (aget (.-p s) index)))




^{:go/end 64} (go/method num "num returns a packet by number.\nIt returns nil if the packet is not in the list.\n" ^{:tag (* sentPacket)} [^{:tag (* sentPacketList)} s ^packetNumber num]
  (let [i (conv int (- num (.start s)))]
    (when (or (< i 0) (>= i (.-size s)))
      (return nil))

    (.nth s i)))



^{:go/end 79} (go/method clean "clean removes all acked or lost packets from the head of the list.\n" [^{:tag (* sentPacketList)} s]
  (while (> (.-size s) 0)
    (let [sent (aget (.-p s) (.-off s))]
      (when (== (.-state sent) sentPacketSent)
        (return))

      (.recycle sent)
      (aset (.-p s) (.-off s) nil)
      (set! (.-off s) (% (+ (.-off s) 1) (len (.-p s))))
      (dec! (.-size s))))

  (set! (.-off s) 0))



^{:go/end 93} (go/method grow "grow increases the buffer to hold more packaets.\n" [^{:tag (* sentPacketList)} s]
  (let [newSize (* (len (.-p s)) 2)]
    (when (== newSize 0)
      (set! newSize 64))

    (let [p (make (slice (* sentPacket)) newSize)]
      (for [i 0] (< i (.-size s)) (inc! i)
        (aset p i (.nth s i)))

      (set! (.-p s) p)
      (set! (.-off s) 0))))

^{:go/end 218} (go/method confirmHandshake "confirmHandshake is called when the handshake is confirmed.\nhttps://www.rfc-editor.org/rfc/rfc9001#section-4.1.2\n" [^{:tag (* Conn)} c ^time/Time now]
  ;; If handshakeConfirmed is unset, the handshake is not confirmed.
  ;; If it is unsent, the handshake is confirmed and we need to send a HANDSHAKE_DONE.
  ;; If it is sent, we have sent a HANDSHAKE_DONE.
  ;; If it is received, the handshake is confirmed and we do not need to send anything.
  (when (.isSet (.-handshakeConfirmed c))
    (return)) ; already confirmed

  (if (== (.-side c) serverSide) (do
      ;; When the server confirms the handshake, it sends a HANDSHAKE_DONE.
      (.setUnsent (.-handshakeConfirmed c))
      (.serverConnEstablished (.-endpoint c) c))

    ;; The client never sends a HANDSHAKE_DONE, so we set handshakeConfirmed
    ;; to the received state, indicating that the handshake is confirmed and we
    ;; don't need to send anything.
    (.setReceived (.-handshakeConfirmed c)))

  (.restartIdleTimer c now)
  (.confirmHandshake (.-loss c))
  ;; "An endpoint MUST discard its Handshake keys when the TLS handshake is confirmed"
  ;; https://www.rfc-editor.org/rfc/rfc9001#section-4.9.2-1
  (.discardKeys c now handshakeSpace))




^{:go/end 233} (go/method discardKeys "discardKeys discards unused packet protection keys.\nhttps://www.rfc-editor.org/rfc/rfc9001#section-4.9\n" [^{:tag (* Conn)} c ^time/Time now ^numberSpace space]

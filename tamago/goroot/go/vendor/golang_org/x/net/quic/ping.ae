(in-ns 'go.vendor.golang_org.x.net.quic) (go/file "ping.go" :imports [

    ^{:line 7} [time "time"]])

^{:go/end 14} (go/method ping [^{:tag (* Conn)} c ^numberSpace space]
  (.sendMsg c ^{:go/end 13} (fn [^time/Time now ^{:tag (* Conn)} c]
      (.setUnsent (.-testSendPing c))
      (set! (.-testSendPingSpace c) space))))

(in-ns 'go.vendor.golang_org.x.net.quic) (go/file "atomic_bits.go" :imports [

    ^{:line 7} [atomic "sync/atomic"]])


(go/type atomicBits "atomicBits is an atomic uint32 that supports setting individual bits.\n" :type-params [^{:tag (tilde uint32)} T] (struct
    ^{:line 11 :tag atomic/Uint32} bits))




^{:go/end 27} (go/method set "set sets the bits in mask to the corresponding bits in v.\nIt returns the new value.\n" ^T [^{:tag (* (atomicBits T))} a ^T v ^:go/grouped ^T mask]
  (when (!= (bit-and-not v mask) 0)
    (panic "BUG: bits in v are not in mask"))

  (while true
    (let [o (.Load (.-bits a))
        ^{:line 22} n (bit-or (bit-and-not o (conv uint32 mask)) (conv uint32 v))]
      (when (.CompareAndSwap (.-bits a) o n)
        (return (conv T n))))))




^{:go/end 31} (go/method load ^T [^{:tag (* (atomicBits T))} a]
  (conv T (.Load (.-bits a))))

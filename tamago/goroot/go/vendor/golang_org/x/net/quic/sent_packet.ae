(in-ns 'go.vendor.golang_org.x.net.quic) (go/file "sent_packet.go" :imports [


    ^{:line 8} [sync "sync"]
    ^{:line 9} [time "time"]

    ^{:line 11} [quicwire "golang.org/x/net/internal/quic/quicwire"]])




(go/type sentPacket "A sentPacket tracks state related to an in-flight packet we sent,\nto be committed when the peer acks it or resent if the packet is lost.\n" (struct
    ^{:line 17 :tag packetNumber} num
    ^{:line 18 :tag int} size ; size in bytes
    ^{:line 19 :tag time/Time} time ; time sent
    ^{:line 20 :tag packetType} ptype

    ^{:line 22 :tag sentPacketState} state
    ^{:line 23 :tag bool} ackEliciting ; https://www.rfc-editor.org/rfc/rfc9002.html#section-2-3.4.1
    ^{:line 24 :tag bool} inFlight ; https://www.rfc-editor.org/rfc/rfc9002.html#section-2-3.6.1









    ^{:line 34 :tag (slice byte) :doc "Frames sent in the packet.\n\nThis is an abbreviated version of the packet payload, containing only the information\nwe need to process an ack for or loss of this packet.\nFor example, a CRYPTO frame is recorded as the frame type (0x06), offset, and length,\nbut does not include the sent data.\n\nThis buffer is written by packetWriter.append* and read by Conn.handleAckOrLoss.\n"} b
    ^{:line 35 :tag int} n)) ; read offset into b


(go/type sentPacketState uint8)

(go/const
  ^{:line 41} [^{:val 0} sentPacketSent (conv sentPacketState iota)] ; sent but neither acked nor lost
  ^{:line 42} [^{:val 1} sentPacketAcked] ; acked
  ^{:line 43} [^{:val 2} sentPacketLost] ; declared lost
  ^{:line 44} [^{:val 3} sentPacketUnsent]) ; never sent


(go/var sentPool ^{:go/breaks [2]} (lit sync/Pool
    :New ^{:go/end 50} (fn ^any []
      (addr (lit sentPacket)))))



^{:go/end 57} (go/func newSentPacket ^{:tag (* sentPacket)} []
  (let [sent (assert (* sentPacket) (.Get sentPool))]
    (.reset sent)
    ^{:line 56} sent))



^{:go/end 62} (go/method recycle "recycle returns a sentPacket to the pool.\n" [^{:tag (* sentPacket)} sent]
  (.Put sentPool sent))


^{:go/end 68} (go/method reset [^{:tag (* sentPacket)} sent]
  (set! @sent ^{:go/breaks [2]} (lit sentPacket
      :b (subslice (.-b sent) _ 0))))




^{:go/end 74} (go/method markAckEliciting "markAckEliciting marks the packet as containing an ack-eliciting frame.\n" [^{:tag (* sentPacket)} sent]
  (set! (.-ackEliciting sent) true)
  (set! (.-inFlight sent) true))


;; The append* methods record information about frames in the packet.

^{:go/end 80} (go/method appendNonAckElicitingFrame [^{:tag (* sentPacket)} sent ^byte frameType]
  (set! (.-b sent) (append (.-b sent) frameType)))


^{:go/end 86} (go/method appendAckElicitingFrame [^{:tag (* sentPacket)} sent ^byte frameType]
  (set! (.-ackEliciting sent) true)
  (set! (.-inFlight sent) true)
  (set! (.-b sent) (append (.-b sent) frameType)))


^{:go/end 90} (go/method appendInt [^{:tag (* sentPacket)} sent ^uint64 v]
  (set! (.-b sent) (quicwire/AppendVarint (.-b sent) v)))


^{:go/end 95} (go/method appendOffAndSize [^{:tag (* sentPacket)} sent ^int64 start ^int size]
  (set! (.-b sent) (quicwire/AppendVarint (.-b sent) (conv uint64 start)))
  (set! (.-b sent) (quicwire/AppendVarint (.-b sent) (conv uint64 size))))


;; The next* methods read back information about frames in the packet.

^{:go/end 103} (go/method next [^{:tag (* sentPacket)} sent] :results [^byte frameType]
  (let [f (aget (.-b sent) (.-n sent))]
    (inc! (.-n sent))
    ^{:line 102} f))


^{:go/end 109} (go/method nextInt ^uint64 [^{:tag (* sentPacket)} sent]
  (let [(values v n) (quicwire/ConsumeVarint (subslice (.-b sent) (.-n sent)))]
    (set! (.-n sent) + n)
    ^{:line 108} v))


^{:go/end 115} (go/method nextRange [^{:tag (* sentPacket)} sent] :results [^int64 start ^int64 end]
  (set! start (conv int64 (.nextInt sent)))
  (set! end (+ start (conv int64 (.nextInt sent))))
  (return start end))


^{:go/end 119} (go/method done ^bool [^{:tag (* sentPacket)} sent]
  (== (.-n sent) (len (.-b sent))))

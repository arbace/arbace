(in-ns 'go.vendor.golang_org.x.net.quic) (go/file "sent_val.go" :imports [])















(go/type sentVal "A sentVal tracks sending some piece of information to the peer.\nIt tracks whether the information has been sent, acked, and\n(when in-flight) the most recent packet to carry it.\n\nFor example, a sentVal can track sending of a RESET_STREAM frame.\n\n  - unset: stream is active, no need to send RESET_STREAM\n  - unsent: we should send a RESET_STREAM, but have not yet\n  - sent: we have sent a RESET_STREAM, but have not received an ack\n  - received: we have sent a RESET_STREAM, and the peer has acked the packet that contained it\n\nIn the \"sent\" state, a sentVal also tracks the latest packet number to carry\nthe information. (QUIC packet numbers are always at most 62 bits in size,\nso the sentVal keeps the number in the low 62 bits and the state in the high 2 bits.)\n" uint64)

(go/const
  ^{:line 24} [^{:val 0} sentValUnset 0] ; unset
  ^{:line 25} [^{:val 4611686018427387904} sentValUnsent (<< 1 62)] ; set, not sent to the peer
  ^{:line 26} [^{:val 9223372036854775808N} sentValSent (<< 2 62)] ; set, sent to the peer but not yet acked; pnum is set
  ^{:line 27} [^{:val 13835058055282163712N} sentValReceived (<< 3 62)] ; set, peer acked receipt

  ^{:line 29} [^{:val 13835058055282163712N} sentValStateMask (<< 3 62)])



^{:go/end 33} (go/method isSet "isSet reports whether the value is set.\n" ^bool [^sentVal s] (!= s 0))


^{:go/end 36} (go/method shouldSend "shouldSend reports whether the value is set and has not been sent to the peer.\n" ^bool [^sentVal s] (== (.state s) sentValUnsent))





^{:go/end 45} (go/method shouldSendPTO "shouldSendPTO reports whether the value needs to be sent to the peer.\nThe value needs to be sent if it is set and has not been sent.\nIf pto is true, indicating that we are sending a PTO probe, the value\nshould also be sent if it is set and has not been acknowledged.\n" ^bool [^sentVal s ^bool pto]
  (let [st (.state s)]
    (or (== st sentValUnsent) ^:go/paren (and pto (== st sentValSent)))))



^{:go/end 48} (go/method isReceived "isReceived reports whether the value has been received by the peer.\n" ^bool [^sentVal s] (== s sentValReceived))



^{:go/end 56} (go/method set "set sets the value and records that it should be sent to the peer.\nIf the value has already been sent, it is not resent.\n" [^{:tag (* sentVal)} s]
  (when (== @s 0)
    (set! @s sentValUnsent)))




^{:go/end 59} (go/method setUnsent "reset sets the value to the unsent state.\n" [^{:tag (* sentVal)} s] (set! @s sentValUnsent))


^{:go/end 62} (go/method clear "clear sets the value to the unset state.\n" [^{:tag (* sentVal)} s] (set! @s sentValUnset))



^{:go/end 68} (go/method setSent "setSent sets the value to the send state and records the number of the most recent\npacket containing the value.\n" [^{:tag (* sentVal)} s ^packetNumber pnum]
  (set! @s (bit-or sentValSent (conv sentVal pnum))))



^{:go/end 71} (go/method setReceived "setReceived sets the value to the received state.\n" [^{:tag (* sentVal)} s] (set! @s sentValReceived))



^{:go/end 81} (go/method ackOrLoss "ackOrLoss reports that an acknowledgement has been received for the value,\nor that the packet carrying the value has been lost.\n" [^{:tag (* sentVal)} s ^packetNumber pnum ^packetFate fate]
  (cond (== fate packetAcked)
    (set! @s sentValReceived)
    (== @s (bit-or (conv sentVal pnum) sentValSent))
    (set! @s sentValUnsent)))











^{:go/end 101} (go/method ackLatestOrLoss "ackLatestOrLoss reports that an acknowledgement has been received for the value,\nor that the packet carrying the value has been lost.\nThe value is set to the acked state only if pnum is the latest packet containing it.\n\nWe use this to handle acks for data that varies every time it is sent.\nFor example, if we send a MAX_DATA frame followed by an updated MAX_DATA value in a\nsecond packet, we consider the data sent only upon receiving an ack for the most\nrecent value.\n" [^{:tag (* sentVal)} s ^packetNumber pnum ^packetFate fate]
  (if (== fate packetAcked)
    (when (== @s (bit-or (conv sentVal pnum) sentValSent))
      (set! @s sentValReceived))

    (do
      (when (== @s (bit-or (conv sentVal pnum) sentValSent))
        (set! @s sentValUnsent)))))




^{:go/end 103} (go/method state ^uint64 [^sentVal s] (bit-and (conv uint64 s) sentValStateMask))

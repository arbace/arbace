(in-ns 'go.vendor.golang_org.x.net.quic) (go/file "skip.go" :imports [])















(go/type skipState "skipState is state for optimistic ACK defenses.\n\nAn endpoint performs an optimistic ACK attack by sending acknowledgements for packets\nwhich it has not received, potentially convincing the sender's congestion controller to\nsend at rates beyond what the network supports.\n\nWe defend against this by periodically skipping packet numbers.\nReceiving an ACK for an unsent packet number is a PROTOCOL_VIOLATION error.\n\nWe only skip packet numbers in the Application Data number space.\nThe total data sent in the Initial/Handshake spaces should generally fit into\nthe initial congestion window.\n\nhttps://www.rfc-editor.org/rfc/rfc9000.html#section-21.4\n" (struct

    ^{:line 23 :tag packetNumber :doc "skip is the next packet number (in the Application Data space) we should skip.\n"} skip



    ^{:line 27 :tag int64 :doc "maxSkip is the maximum number of packets to send before skipping another number.\nIncreases over time.\n"} maxSkip))


^{:go/end 33} (go/method init [^{:tag (* skipState)} ss ^{:tag (* Conn)} c]
  (set! (.-maxSkip ss) 256) ; skip our first packet number within this range
  (.updateNumberSkip ss c))



^{:go/end 38} (go/method shouldSkip "shouldSkip returns whether we should skip the given packet number.\n" ^bool [^{:tag (* skipState)} ss ^packetNumber num]
  (== (.-skip ss) num))



^{:go/end 62} (go/method updateNumberSkip "updateNumberSkip schedules a packet to be skipped after skipping lastSkipped.\n" [^{:tag (* skipState)} ss ^{:tag (* Conn)} c]
  ;; Send at least this many packets before skipping.
  ;; Limits the impact of skipping a little,
  ;; plus allows most tests to ignore skipping.
  (let [^:const ^{:val 64} minSkip 64

      ^{:line 47} skip (+ minSkip (.Int64N (.-prng c) (- (.-maxSkip ss) minSkip)))]
    (set! (.-skip ss) + (conv packetNumber skip))

    ;; Double the size of the skip each time until we reach 128k.
    ;; The idea here is that an attacker needs to correctly ack ~N packets in order
    ;; to send an optimistic ack for another ~N packets.
    ;; Skipping packet numbers comes with a small cost (it causes the receiver to
    ;; send an immediate ACK rather than the usual delayed ACK), so we increase the
    ;; time between skips as a connection's lifetime grows.
    ;;
    ;; The 128k cap is arbitrary, chosen so that we skip a packet number
    ;; about once a second when sending full-size datagrams at 1Gbps.
    (when (< (.-maxSkip ss) (* 128 1024))
      (set! (.-maxSkip ss) * 2))))

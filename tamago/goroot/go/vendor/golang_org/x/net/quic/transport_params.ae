^{:go/end 165} (go/func marshalTransportParameters ^{:tag (slice byte)} [^transportParameters p]
  (let [^{:tag (slice byte)} b (zero (slice byte))]
    (when [v (.-originalDstConnID p)] (!= v nil)
      (set! b (quicwire/AppendVarint b paramOriginalDestinationConnectionID))
      (set! b (quicwire/AppendVarintBytes b v)))

    (when [v (conv uint64 (/ (.-maxIdleTimeout p) time/Millisecond))] (!= v 0)
      (set! b (quicwire/AppendVarint b paramMaxIdleTimeout))
      (set! b (quicwire/AppendVarint b (conv uint64 (quicwire/SizeVarint v))))
      (set! b (quicwire/AppendVarint b (conv uint64 v))))

    (when [v (.-statelessResetToken p)] (!= v nil)
      (set! b (quicwire/AppendVarint b paramStatelessResetToken))
      (set! b (quicwire/AppendVarintBytes b v)))

    (when [v (.-maxUDPPayloadSize p)] (!= v defaultParamMaxUDPPayloadSize)
      (set! b (quicwire/AppendVarint b paramMaxUDPPayloadSize))
      (set! b (quicwire/AppendVarint b (conv uint64 (quicwire/SizeVarint (conv uint64 v)))))
      (set! b (quicwire/AppendVarint b (conv uint64 v))))

    (when [v (.-initialMaxData p)] (!= v 0)
      (set! b (quicwire/AppendVarint b paramInitialMaxData))
      (set! b (quicwire/AppendVarint b (conv uint64 (quicwire/SizeVarint (conv uint64 v)))))
      (set! b (quicwire/AppendVarint b (conv uint64 v))))

    (when [v (.-initialMaxStreamDataBidiLocal p)] (!= v 0)
      (set! b (quicwire/AppendVarint b paramInitialMaxStreamDataBidiLocal))
      (set! b (quicwire/AppendVarint b (conv uint64 (quicwire/SizeVarint (conv uint64 v)))))
      (set! b (quicwire/AppendVarint b (conv uint64 v))))

    (when [v (.-initialMaxStreamDataBidiRemote p)] (!= v 0)
      (set! b (quicwire/AppendVarint b paramInitialMaxStreamDataBidiRemote))
      (set! b (quicwire/AppendVarint b (conv uint64 (quicwire/SizeVarint (conv uint64 v)))))
      (set! b (quicwire/AppendVarint b (conv uint64 v))))

    (when [v (.-initialMaxStreamDataUni p)] (!= v 0)
      (set! b (quicwire/AppendVarint b paramInitialMaxStreamDataUni))
      (set! b (quicwire/AppendVarint b (conv uint64 (quicwire/SizeVarint (conv uint64 v)))))
      (set! b (quicwire/AppendVarint b (conv uint64 v))))

    (when [v (.-initialMaxStreamsBidi p)] (!= v 0)
      (set! b (quicwire/AppendVarint b paramInitialMaxStreamsBidi))
      (set! b (quicwire/AppendVarint b (conv uint64 (quicwire/SizeVarint (conv uint64 v)))))
      (set! b (quicwire/AppendVarint b (conv uint64 v))))

    (when [v (.-initialMaxStreamsUni p)] (!= v 0)
      (set! b (quicwire/AppendVarint b paramInitialMaxStreamsUni))
      (set! b (quicwire/AppendVarint b (conv uint64 (quicwire/SizeVarint (conv uint64 v)))))
      (set! b (quicwire/AppendVarint b (conv uint64 v))))

    (when [v (.-ackDelayExponent p)] (!= v defaultParamAckDelayExponent)
      (set! b (quicwire/AppendVarint b paramAckDelayExponent))
      (set! b (quicwire/AppendVarint b (conv uint64 (quicwire/SizeVarint (conv uint64 v)))))
      (set! b (quicwire/AppendVarint b (conv uint64 v))))

    (when [v (conv uint64 (/ (.-maxAckDelay p) time/Millisecond))] (!= v defaultParamMaxAckDelayMilliseconds)
      (set! b (quicwire/AppendVarint b paramMaxAckDelay))
      (set! b (quicwire/AppendVarint b (conv uint64 (quicwire/SizeVarint v))))
      (set! b (quicwire/AppendVarint b v)))

    (when (.-disableActiveMigration p)
      (set! b (quicwire/AppendVarint b paramDisableActiveMigration))
      (set! b (append b 0))) ; 0-length value

    (when (!= (.-preferredAddrConnID p) nil)

                (set! (.-maxAckDelay p) (* (conv time/Duration v) time/Millisecond))))
            (case [paramDisableActiveMigration]
              (set! (.-disableActiveMigration p) true))
            (case [paramPreferredAddress]
              (when (< (len val) (+ 4 2 16 2 1))
                (return p (lit localTransportError :code errTransportParameter)))

              (set! (.-preferredAddrV4 p) (netip/AddrPortFrom
                  (netip/AddrFrom4 @(conv (* (array 4 byte)) (subslice val _ 4)))
                  (.Uint16 binary/BigEndian (subslice (subslice val 4) _ 2))))

              (set! val (subslice val (+ 4 2)))
              (set! (.-preferredAddrV6 p) (netip/AddrPortFrom
                  (netip/AddrFrom16 @(conv (* (array 16 byte)) (subslice val _ 16)))
                  (.Uint16 binary/BigEndian (subslice (subslice val 16) _ 2))))

              (set! val (subslice val (+ 16 2)))

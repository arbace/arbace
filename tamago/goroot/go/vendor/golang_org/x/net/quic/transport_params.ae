      (set! b (.AppendUint16 binary/BigEndian b (.Port (.-preferredAddrV4 p)))) ; 2 bytes
      (set! b (append b (spread (.AsSlice (.Addr (.-preferredAddrV6 p)))))) ; 16 bytes

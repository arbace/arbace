^{:go/end 283} (go/func unmarshalTransportParams [^{:tag (slice byte)} params] :results [transportParameters error]
  (let [p (defaultTransportParameters)]
    (while (> (len params) 0)
      (let [(values id n) (quicwire/ConsumeVarint params)]
        (when (< n 0)
          (return p (lit localTransportError :code errTransportParameter)))

        (set! params (subslice params n))
        (let [(values val ^:assign n) (quicwire/ConsumeVarintBytes params)]
          (when (< n 0)
            (return p (lit localTransportError :code errTransportParameter)))

          (set! params (subslice params n))
          (set! n 0)
          (switch id
            (case [paramOriginalDestinationConnectionID]
              (set! (.-originalDstConnID p) val)
              (set! n (len val)))
            (case [paramMaxIdleTimeout]
              (let [^uint64 v (zero uint64)]
                (set! (values v n) (quicwire/ConsumeVarint val))
                ;; If this is unreasonably large, consider it as no timeout to avoid
                ;; time.Duration overflows.
                (when (> v (<< 1 32))
                  (set! v 0))

                (set! (.-maxIdleTimeout p) (* (conv time/Duration v) time/Millisecond))))
            (case [paramStatelessResetToken]
              (when (!= (len val) 16)
                (return p (lit localTransportError :code errTransportParameter)))

              (set! (.-statelessResetToken p) val)
              (set! n 16))
            (case [paramMaxUDPPayloadSize]
              (set! (values (.-maxUDPPayloadSize p) n) (quicwire/ConsumeVarintInt64 val))
              (when (< (.-maxUDPPayloadSize p) 1200)
                (return p (lit localTransportError :code errTransportParameter))))

            (case [paramInitialMaxData]
              (set! (values (.-initialMaxData p) n) (quicwire/ConsumeVarintInt64 val)))
            (case [paramInitialMaxStreamDataBidiLocal]
              (set! (values (.-initialMaxStreamDataBidiLocal p) n) (quicwire/ConsumeVarintInt64 val)))
            (case [paramInitialMaxStreamDataBidiRemote]
              (set! (values (.-initialMaxStreamDataBidiRemote p) n) (quicwire/ConsumeVarintInt64 val)))
            (case [paramInitialMaxStreamDataUni]
              (set! (values (.-initialMaxStreamDataUni p) n) (quicwire/ConsumeVarintInt64 val)))
            (case [paramInitialMaxStreamsBidi]
              (set! (values (.-initialMaxStreamsBidi p) n) (quicwire/ConsumeVarintInt64 val))
              (when (> (.-initialMaxStreamsBidi p) maxStreamsLimit)
                (return p (lit localTransportError :code errTransportParameter))))

            (case [paramInitialMaxStreamsUni]
              (set! (values (.-initialMaxStreamsUni p) n) (quicwire/ConsumeVarintInt64 val))
              (when (> (.-initialMaxStreamsUni p) maxStreamsLimit)
                (return p (lit localTransportError :code errTransportParameter))))

            (case [paramAckDelayExponent]
              (let [^uint64 v (zero uint64)]
                (set! (values v n) (quicwire/ConsumeVarint val))
                (when (> v 20)
                  (return p (lit localTransportError :code errTransportParameter)))

                (set! (.-ackDelayExponent p) (conv int8 v))))
            (case [paramMaxAckDelay]
              (let [^uint64 v (zero uint64)]
                (set! (values v n) (quicwire/ConsumeVarint val))
                (when (>= v (<< 1 14))

^{:go/end 54} (go/method Read [^{:tag (* netPacketConn)} c ^{:tag (func [(* datagram)])} f]
  (while true
    (let [dgram (newDatagram)
        (values n peerAddr err) (.ReadFrom (.-c c) (.-b dgram))]
      (when (!= err nil)

(go/type netPacketConn "netPacketConn is a packetConn implementation wrapping a net.PacketConn.\n\nThis is mostly useful for tests, since PacketConn doesn't provide access to\nimportant features such as identifying the local address packets were received on.\n" (struct
    ^{:line 17 :tag net/PacketConn} c
    ^{:line 18 :tag netip/AddrPort} localAddr))


^{:go/end 30} (go/func newNetPacketConn [^net/PacketConn pc] :results [(* netPacketConn) error]
  (let [(values addr err) (addrPortFromAddr (.LocalAddr pc))]
    (when (!= err nil)
      (return nil err))

    ^{:go/breaks [2]} (return (addr ^{:go/breaks [2 4]} (lit netPacketConn
          :c pc

(in-ns 'go.vendor.golang_org.x.net.quic) (go/file "acks.go" :imports [


    ^{:line 8} [time "time"]])





(go/type ackState "ackState tracks packets received from a peer within a number space.\nIt handles packet deduplication (don't process the same packet twice) and\ndetermines the timing and content of ACK frames.\n" (struct
    ^{:line 15 :tag (rangeset packetNumber)} seen


    ^{:line 18 :tag time/Time :doc "The time at which we must send an ACK frame, even if we have no other data to send.\n"} nextAck


    ^{:line 21 :tag time/Time :doc "The time we received the largest-numbered packet in seen.\n"} maxRecvTime


    ^{:line 24 :tag packetNumber :doc "The largest-numbered ack-eliciting packet in seen.\n"} maxAckEliciting


    ^{:line 27 :tag int :doc "The number of ack-eliciting packets in seen that we have not yet acknowledged.\n"} unackedAckEliciting


    ^{:line 30 :tag ecnCounts :doc "Total ECN counters for this packet number space.\n"} ecn))


(go/type ecnCounts (struct
    ^{:line 34 :tag int} t0
    ^{:line 35 :tag int} t1
    ^{:line 36 :tag int} ce))



^{:go/breaks [[6 51]] :go/end 52} (go/method shouldProcess "shouldProcess reports whether a packet should be handled or discarded.\n" ^bool [^{:tag (* ackState)} acks ^packetNumber num]
  (when (> (conv packetNumber (.min (.-seen acks))) num)
    ;; We've discarded the state for this range of packet numbers.
    ;; Discard the packet rather than potentially processing a duplicate.
    ;; https://www.rfc-editor.org/rfc/rfc9000.html#section-13.2.3-5
    (return false))

  (when (.contains (.-seen acks) num)
    ;; Discard duplicate packets.
    (return false))

  true)



^{:go/end 109} (go/method receive "receive records receipt of a packet.\n" [^{:tag (* ackState)} acks ^time/Time now ^numberSpace space ^packetNumber num ^bool ackEliciting ^ecnBits ecn]
  (when ackEliciting
    (inc! (.-unackedAckEliciting acks))
    (cond (.mustAckImmediately acks space num ecn)
      (set! (.-nextAck acks) now)
      (.IsZero (.-nextAck acks))
      ;; This packet does not need to be acknowledged immediately,
      ;; but the ack must not be intentionally delayed by more than
      ;; the max_ack_delay transport parameter we sent to the peer.
      ;;
      ;; We always delay acks by the maximum allowed, less the timer
      ;; granularity. ("[max_ack_delay] SHOULD include the receiver's
      ;; expected delays in alarms firing.")
      ;;
      ;; https://www.rfc-editor.org/rfc/rfc9000#section-18.2-4.28.1
      (set! (.-nextAck acks) (.Add now (- maxAckDelay timerGranularity))))

    (when (> num (.-maxAckEliciting acks))
      (set! (.-maxAckEliciting acks) num)))



  (.add (.-seen acks) num (+ num 1))
  (when (== num (.max (.-seen acks)))
    (set! (.-maxRecvTime acks) now))


  (switch ecn
    (case [ecnECT0]
      (inc! (.-t0 (.-ecn acks))))
    (case [ecnECT1]
      (inc! (.-t1 (.-ecn acks))))
    (case [ecnCE]
      (inc! (.-ce (.-ecn acks)))))


  ;; Limit the total number of ACK ranges by dropping older ranges.
  ;;
  ;; Remembering more ranges results in larger ACK frames.
  ;;
  ;; Remembering a large number of ranges could result in ACK frames becoming
  ;; too large to fit in a packet, in which case we will silently drop older
  ;; ranges during packet construction.
  ;;
  ;; Remembering fewer ranges can result in unnecessary retransmissions,
  ;; since we cannot accept packets older than the oldest remembered range.
  ;;
  ;; The limit here is completely arbitrary. If it seems wrong, it probably is.
  ;;
  ;; https://www.rfc-editor.org/rfc/rfc9000#section-13.2.3
  (let [^:const ^{:val 8} maxAckRanges 8]
    (when [overflow (- (.numRanges (.-seen acks)) maxAckRanges)] (> overflow 0)
      (.removeranges (.-seen acks) 0 overflow))))





^{:go/end 168} (go/method mustAckImmediately "mustAckImmediately reports whether an ack-eliciting packet must be acknowledged immediately,\nor whether the ack may be deferred.\n" ^bool [^{:tag (* ackState)} acks ^numberSpace space ^packetNumber num ^ecnBits ecn]
  ;; https://www.rfc-editor.org/rfc/rfc9000.html#section-13.2.1
  (when (!= space appDataSpace)
    ;; "[...] all ack-eliciting Initial and Handshake packets [...]"
    ;; https://www.rfc-editor.org/rfc/rfc9000.html#section-13.2.1-2
    (return true))

  (when (< num (.-maxAckEliciting acks))
    ;; "[...] when the received packet has a packet number less than another
    ;; ack-eliciting packet that has been received [...]"
    ;; https://www.rfc-editor.org/rfc/rfc9000.html#section-13.2.1-8.1
    (return true))

  (when (!= (.-end (.rangeContaining (.-seen acks) (.-maxAckEliciting acks))) num)
    ;; "[...] when the packet has a packet number larger than the highest-numbered
    ;; ack-eliciting packet that has been received and there are missing packets
    ;; between that packet and this packet."
    ;; https://www.rfc-editor.org/rfc/rfc9000.html#section-13.2.1-8.2
    ;;
    ;; This case is a bit tricky. Let's say we've received:
    ;;   0, ack-eliciting
    ;;   1, ack-eliciting
    ;;   3, NOT ack eliciting
    ;;
    ;; We have sent ACKs for 0 and 1. If we receive ack-eliciting packet 2,
    ;; we do not need to send an immediate ACK, because there are no missing
    ;; packets between it and the highest-numbered ack-eliciting packet (1).
    ;; If we receive ack-eliciting packet 4, we do need to send an immediate ACK,
    ;; because there's a gap (the missing packet 2).
    ;;
    ;; We check for this by looking up the ACK range which contains the
    ;; highest-numbered ack-eliciting packet: [0, 1) in the above example.
    ;; If the range ends just before the packet we are now processing,
    ;; there are no gaps. If it does not, there must be a gap.
    (return true))

  ;; "[...] packets marked with the ECN Congestion Experienced (CE) codepoint
  ;; in the IP header SHOULD be acknowledged immediately [...]"
  ;; https://www.rfc-editor.org/rfc/rfc9000.html#section-13.2.1-9
  (when (== ecn ecnCE)
    (return true))

  ;; "[...] SHOULD send an ACK frame after receiving at least two ack-eliciting packets."
  ;; https://www.rfc-editor.org/rfc/rfc9000.html#section-13.2.2
  ;;
  ;; This ack frequency takes a substantial toll on performance, however.
  ;; Follow the behavior of Google QUICHE:
  ;; Ack every other packet for the first 100 packets, and then ack every 10th packet.
  ;; This keeps ack frequency high during the beginning of slow start when CWND is
  ;; increasing rapidly.
  (let [packetsBeforeAck 2]
    (when (> (.max (.-seen acks)) 100)
      (set! packetsBeforeAck 10))

    (>= (.-unackedAckEliciting acks) packetsBeforeAck)))




^{:go/end 174} (go/method shouldSendAck "shouldSendAck reports whether the connection should send an ACK frame at this time,\nin an ACK-only packet if necessary.\n" ^bool [^{:tag (* ackState)} acks ^time/Time now]
  (and (not (.IsZero (.-nextAck acks))) (not (.After (.-nextAck acks) now))))





^{:go/end 191} (go/method acksToSend "acksToSend returns the set of packet numbers to ACK at this time, and the current ack delay.\nIt may return acks even if shouldSendAck returns false, when there are unacked\nack-eliciting packets whose ack is being delayed.\n" [^{:tag (* ackState)} acks ^time/Time now] :results [^{:tag (rangeset packetNumber)} nums ^time/Duration ackDelay]
  (when (and (.IsZero (.-nextAck acks)) (== (.-unackedAckEliciting acks) 0))
    (return nil 0))

  ;; "[...] the delays intentionally introduced between the time the packet with the
  ;; largest packet number is received and the time an acknowledgement is sent."
  ;; https://www.rfc-editor.org/rfc/rfc9000#section-13.2.5-1
  (let [delay (.Sub now (.-maxRecvTime acks))]
    (when (< delay 0)
      (set! delay 0))

    (return (.-seen acks) delay)))



^{:go/end 197} (go/method sentAck "sentAck records that an ACK frame has been sent.\n" [^{:tag (* ackState)} acks]
  (set! (.-nextAck acks) (lit time/Time))
  (set! (.-unackedAckEliciting acks) 0))




^{:go/end 208} (go/method handleAck "handleAck records that an ack has been received for a ACK frame we sent\ncontaining the given Largest Acknowledged field.\n" [^{:tag (* ackState)} acks ^packetNumber largestAcked]
  ;; We can stop acking packets less or equal to largestAcked.
  ;; https://www.rfc-editor.org/rfc/rfc9000.html#section-13.2.4-1
  ;;
  ;; We rely on acks.seen containing the largest packet number that has been successfully
  ;; processed, so we retain the range containing largestAcked and discard previous ones.
  (.sub (.-seen acks) 0 (.-start (.rangeContaining (.-seen acks) largestAcked))))



^{:go/end 213} (go/method largestSeen "largestSeen reports the largest seen packet.\n" ^packetNumber [^{:tag (* ackState)} acks]
  (.max (.-seen acks)))

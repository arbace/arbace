(in-ns 'go.vendor.golang_org.x.net.quic) (go/file "math.go" :imports [])

^{:go/end 12} (go/func abs :type-params [^{:tag (| (tilde int) (tilde int64))} T] ^T [^T a]
  (when (< a 0)
    (return (- a)))

  ^{:line 11} a)

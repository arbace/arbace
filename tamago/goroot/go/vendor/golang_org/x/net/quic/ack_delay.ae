(in-ns 'go.vendor.golang_org.x.net.quic) (go/file "ack_delay.go" :imports [


    ^{:line 8} [math "math"]
    ^{:line 9} [time "time"]])




(go/type unscaledAckDelay "An unscaledAckDelay is an ACK Delay field value from an ACK packet,\nwithout the ack_delay_exponent scaling applied.\n" int64)

^{:go/end 18} (go/func unscaledAckDelayFromDuration ^unscaledAckDelay [^time/Duration d ^uint8 ackDelayExponent]
  (conv unscaledAckDelay (>> (.Microseconds d) ackDelayExponent)))


^{:go/end 26} (go/method Duration ^time/Duration [^unscaledAckDelay d ^uint8 ackDelayExponent]
  (when (> (conv int64 d) (/ ^int64 (>> math/MaxInt64 ackDelayExponent) (conv int64 time/Microsecond)))
    ;; If scaling the delay would overflow, ignore the delay.
    (return 0))

  (* (conv time/Duration (<< d ackDelayExponent)) time/Microsecond))

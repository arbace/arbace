(in-ns 'go.vendor.golang_org.x.net.quic) (go/file "queue.go" :imports [

    ^{:line 7} [context "context"]])


(go/type queue "A queue is an unbounded queue of some item (new connections and streams).\n" :type-params [T] (struct

    ^{:line 12 :tag gate :doc "The gate condition is set if the queue is non-empty or closed.\n"} gate
    ^{:line 13 :tag error} err
    ^{:line 14 :tag (slice T)} q))


^{:go/end 19} (go/func newQueue :type-params [T] ^{:tag (queue T)} []
  (lit (queue T) :gate (newGate)))




^{:go/end 29} (go/method close "close closes the queue, causing pending and future pop operations\nto return immediately with err.\n" [^{:tag (* (queue T))} q ^error err]
  (.lock (.-gate q))
  (defer (.unlock q))
  (when (== (.-err q) nil)
    (set! (.-err q) err)))





^{:go/breaks [8] :go/end 41} (go/method put "put appends an item to the queue.\nIt returns true if the item was added, false if the queue is closed.\n" ^bool [^{:tag (* (queue T))} q ^T v]
  (.lock (.-gate q))
  (defer (.unlock q))
  (when (!= (.-err q) nil)
    (return false))

  (set! (.-q q) (append (.-q q) v))
  true)




^{:go/end 59} (go/method get "get removes the first item from the queue, blocking until ctx is done, an item is available,\nor the queue is closed.\n" [^{:tag (* (queue T))} q ^context/Context ctx] :results [T error]
  (let [^T zero (zero T)]
    (when [err (.waitAndLock (.-gate q) ctx)] (!= err nil)
      (return zero err))

    (defer (.unlock q))
    (when (!= (.-err q) nil)
      (return zero (.-err q)))

    (let [v (aget (.-q q) 0)]
      (copy (subslice (.-q q)) (subslice (.-q q) 1))
      (aset (.-q q) (- (len (.-q q)) 1) zero)
      (set! (.-q q) (subslice (.-q q) _ (- (len (.-q q)) 1)))
      (return v nil))))


^{:go/end 63} (go/method unlock [^{:tag (* (queue T))} q]
  (.unlock (.-gate q) (or (!= (.-err q) nil) (> (len (.-q q)) 0))))

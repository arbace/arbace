(in-ns 'go.vendor.golang_org.x.net.quic) (go/file "udp_other.go" :build ["//go:build quicbasicnet || !(darwin || linux)"] :imports [


    ^{:line 10} [net "net"]
    ^{:line 11} [netip "net/netip"]])


;; Lowest common denominator network interface: Basic net.UDPConn, no cmsgs.
;; We will not be able to send or receive ECN bits,
;; and we will not know what our local address is.
;;
;; The quicbasicnet build tag allows selecting this interface on any platform.


(go/const "See udp.go.\n"
  ^{:line 22} [^{:val false} udpECNSupport false]
  ^{:line 23} [^{:val false} udpInvalidLocalAddrIsError false])


(go/type netUDPConn (struct
    ^{:line 27 :tag (* net/UDPConn)} c))


^{:go/end 34} (go/func newNetUDPConn [^{:tag (* net/UDPConn)} uc] :results [(* netUDPConn) error]
  ^{:go/breaks [2]} (return (addr ^{:go/breaks [2]} (lit netUDPConn
        :c uc))
    nil))


^{:go/end 36} (go/method Close ^error [^{:tag (* netUDPConn)} c] ^{:go/via [conn]} (.Close (.-c c)))

^{:go/end 41} (go/method LocalAddr ^netip/AddrPort [^{:tag (* netUDPConn)} c]
  (let [(values a _) (assert (* net/UDPAddr) ^{:go/via [conn]} (.LocalAddr (.-c c)))]
    (.AddrPort a)))


^{:go/end 57} (go/method Read [^{:tag (* netUDPConn)} c ^{:tag (func [(* datagram)])} f]
  (while true
    (let [dgram (newDatagram)
        (values n peerAddr err) (.ReadFromUDPAddrPort (.-c c) (.-b dgram))]
      (when (!= err nil)
        (return))

      (when (== n 0)
        (continue))

      (set! (.-peerAddr dgram) (unmapAddrPort peerAddr))
      (set! (.-b dgram) (subslice (.-b dgram) _ n))
      (f dgram))))



^{:go/end 62} (go/method Write ^error [^{:tag (* netUDPConn)} c ^datagram dgram]
  (let [(values _ err) (.WriteToUDPAddrPort (.-c c) (.-b dgram) (.-peerAddr dgram))]
    ^{:line 61} err))

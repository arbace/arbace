^{:go/end 194} (go/func parseVersionNegotiation "parseVersionNegotiation parses a Version Negotiation packet.\nThe returned versions is a slice of big-endian uint32s.\nIt returns (nil, nil, nil) for an invalid packet.\n" [^{:tag (slice byte)} pkt] :results [^{:tag (slice byte)} dstConnID ^{:tag (slice byte)} srcConnID ^{:tag (slice byte)} versions]

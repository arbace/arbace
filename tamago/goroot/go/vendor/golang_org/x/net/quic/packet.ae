^{:go/end 156} (go/func getPacketType "getPacketType returns the type of a packet.\n" ^packetType [^{:tag (slice byte)} b]
  (when (== (len b) 0)
    (return packetTypeInvalid))

  (when (not (isLongHeader (aget b 0)))
    (when (!= (bit-and (aget b 0) fixedBit) fixedBit)
      (return packetTypeInvalid))

    (return packetType1RTT))

  (when (< (len b) 5)
    (return packetTypeInvalid))

  (when (and (== (aget b 1) 0) (== (aget b 2) 0) (== (aget b 3) 0) (== (aget b 4) 0))
    ;; Version Negotiation packets don't necessarily set the fixed bit.
    (return packetTypeVersionNegotiation))

  (when (!= (bit-and (aget b 0) fixedBit) fixedBit)
    (return packetTypeInvalid))

  (switch (bit-and (aget b 0) 0x30)
    (case [longPacketTypeInitial]
      (return packetTypeInitial))
    (case [longPacketType0RTT]
      (return packetType0RTT))
    (case [longPacketTypeHandshake]
      (return packetTypeHandshake))
    (case [longPacketTypeRetry]
      (return packetTypeRetry)))

  ^{:line 155} packetTypeInvalid)





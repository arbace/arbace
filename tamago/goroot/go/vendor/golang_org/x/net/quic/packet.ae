^{:go/end 267} (go/func parseGenericLongHeaderPacket [^{:tag (slice byte)} b] :results [^genericLongPacket p ^bool ok]
  (when (or (< (len b) 5) (not (isLongHeader (aget b 0))))
    (return (lit genericLongPacket) false))

  (set! b (subslice b 1))
  ;; Version (32),
  (let [^int n (zero int)]
    (set! (values (.-version p) n) (quicwire/ConsumeUint32 b))
    (when (< n 0)
      (return (lit genericLongPacket) false))

    (set! b (subslice b n))
    ;; Destination Connection ID Length (8),
    ;; Destination Connection ID (0..2040),
    (set! (values (.-dstConnID p) n) (quicwire/ConsumeUint8Bytes b))
    (when (< n 0)
      (return (lit genericLongPacket) false))

    (set! b (subslice b n))
    ;; Source Connection ID Length (8),
    ;; Source Connection ID (0..2040),
    (set! (values (.-srcConnID p) n) (quicwire/ConsumeUint8Bytes b))
    (when (< n 0)
      (return (lit genericLongPacket) false))

    (set! b (subslice b n))
    (set! (.-data p) b)
    (return p true)))

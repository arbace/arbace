^{:go/end 207} (go/func appendVersionNegotiation "appendVersionNegotiation appends a Version Negotiation packet to pkt,\nreturning the result.\n" ^{:tag (slice byte)} [^{:tag (slice byte)} pkt ^{:tag (slice byte)} dstConnID ^{:tag (slice byte)} srcConnID & ^{:tag (slice uint32)} versions]
  (set! pkt (append pkt (bit-or headerFormLong fixedBit))) ; header byte
  (set! pkt (append pkt 0 0 0 0)) ; Version (0 for Version Negotiation)
  (set! pkt (quicwire/AppendUint8Bytes pkt dstConnID)) ; Destination Connection ID
  (set! pkt (quicwire/AppendUint8Bytes pkt srcConnID)) ; Source Connection ID

(go/type ApplicationError "An ApplicationError is an application protocol error code (RFC 9000, Section 20.2).\nApplication protocol errors may be sent when terminating a stream or connection.\n" (struct
    ^{:line 117 :tag uint64} Code
    ^{:line 118 :tag string} Reason))


^{:go/end 123} (go/method Error ^string [^{:tag (* ApplicationError)} e]

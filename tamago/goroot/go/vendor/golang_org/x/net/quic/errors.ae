^{:go/end 129} (go/method Is "Is reports a match if err is an *ApplicationError with a matching Code.\n" ^bool [^{:tag (* ApplicationError)} e ^error err]
  (let [(values e2 ok) (assert (* ApplicationError) err)]
    (and ok (== (.-Code e2) (.-Code e)))))

(go/type transportError "A transportError is a transport error code from RFC 9000 Section 20.1.\n\nThe transportError type doesn't implement the error interface to ensure we always\ndistinguish between errors sent to and received from the peer.\nSee the localTransportError and peerTransportError types below.\n" uint64)


(go/const "https://www.rfc-editor.org/rfc/rfc9000.html#section-20.1\n"
  ^{:line 20} [^{:val 0} errNo (conv transportError 0x00)]
  ^{:line 21} [^{:val 1} errInternal (conv transportError 0x01)]
  ^{:line 22} [^{:val 2} errConnectionRefused (conv transportError 0x02)]
  ^{:line 23} [^{:val 3} errFlowControl (conv transportError 0x03)]
  ^{:line 24} [^{:val 4} errStreamLimit (conv transportError 0x04)]
  ^{:line 25} [^{:val 5} errStreamState (conv transportError 0x05)]
  ^{:line 26} [^{:val 6} errFinalSize (conv transportError 0x06)]
  ^{:line 27} [^{:val 7} errFrameEncoding (conv transportError 0x07)]
  ^{:line 28} [^{:val 8} errTransportParameter (conv transportError 0x08)]
  ^{:line 29} [^{:val 9} errConnectionIDLimit (conv transportError 0x09)]
  ^{:line 30} [^{:val 10} errProtocolViolation (conv transportError 0x0a)]
  ^{:line 31} [^{:val 11} errInvalidToken (conv transportError 0x0b)]
  ^{:line 32} [^{:val 12} errApplicationError (conv transportError 0x0c)]
  ^{:line 33} [^{:val 13} errCryptoBufferExceeded (conv transportError 0x0d)]
  ^{:line 34} [^{:val 14} errKeyUpdateError (conv transportError 0x0e)]
  ^{:line 35} [^{:val 15} errAEADLimitReached (conv transportError 0x0f)]
  ^{:line 36} [^{:val 16} errNoViablePath (conv transportError 0x10)]
  ^{:line 37} [^{:val 256} errTLSBase (conv transportError 0x0100)]) ; 0x0100-0x01ff; base + TLS code


^{:go/end 81} (go/method String ^string [^transportError e]
  (switch e
    (case [errNo]
      (return "NO_ERROR"))
    (case [errInternal]
      (return "INTERNAL_ERROR"))
    (case [errConnectionRefused]
      (return "CONNECTION_REFUSED"))
    (case [errFlowControl]
      (return "FLOW_CONTROL_ERROR"))
    (case [errStreamLimit]
      (return "STREAM_LIMIT_ERROR"))
    (case [errStreamState]
      (return "STREAM_STATE_ERROR"))
    (case [errFinalSize]
      (return "FINAL_SIZE_ERROR"))
    (case [errFrameEncoding]
      (return "FRAME_ENCODING_ERROR"))
    (case [errTransportParameter]
      (return "TRANSPORT_PARAMETER_ERROR"))
    (case [errConnectionIDLimit]
      (return "CONNECTION_ID_LIMIT_ERROR"))
    (case [errProtocolViolation]
      (return "PROTOCOL_VIOLATION"))
    (case [errInvalidToken]
      (return "INVALID_TOKEN"))
    (case [errApplicationError]
      (return "APPLICATION_ERROR"))
    (case [errCryptoBufferExceeded]
      (return "CRYPTO_BUFFER_EXCEEDED"))
    (case [errKeyUpdateError]
      (return "KEY_UPDATE_ERROR"))
    (case [errAEADLimitReached]
      (return "AEAD_LIMIT_REACHED"))
    (case [errNoViablePath]
      (return "NO_VIABLE_PATH")))

  (when (and (>= e 0x0100) (<= e 0x01ff))
    (return (fmt/Sprintf "CRYPTO_ERROR(%v)" (bit-and (conv uint64 e) 0xff))))

  (fmt/Sprintf "ERROR %d" (conv uint64 e)))



(go/type localTransportError "A localTransportError is an error sent to the peer.\n" (struct
    ^{:line 85 :tag transportError} code
    ^{:line 86 :tag string} reason))


^{:go/end 94} (go/method Error ^string [^localTransportError e]
  (when (== (.-reason e) "")
    (return (fmt/Sprintf "closed connection: %v" (.-code e))))

  (fmt/Sprintf "closed connection: %v: %q" (.-code e) (.-reason e)))



(go/type peerTransportError "A peerTransportError is an error received from the peer.\n" (struct
    ^{:line 98 :tag transportError} code
    ^{:line 99 :tag string} reason))


^{:go/end 104} (go/method Error ^string [^peerTransportError e]

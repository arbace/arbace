^{:go/end 223} (go/method AppendJSON "AppendJSON appends a JSON encoding of the ack ranges to b, and returns it.\nThis is different than the standard json.Marshaler, but more efficient.\nSince we only use this in cooperation with the qlog package,\nencoding/json compatibility is irrelevant.\n" ^{:tag (slice byte)} [^debugAckRanges r ^{:tag (slice byte)} b]
  (set! b (append b \[))
  (range [i ar r]
    (let [(values start end) (values (.-start ar) (- (.-end ar) 1))] ; qlog ranges are closed-closed
      (when (!= i 0)
        (set! b (append b \,)))

      (set! b (append b \[))
      (set! b (strconv/AppendInt b (conv int64 start) 10))
      (when (!= start end)
        (set! b (append b \,))
        (set! b (strconv/AppendInt b (conv int64 end) 10)))

      (set! b (append b \]))))

  (set! b (append b \]))
  ^{:line 222} b)



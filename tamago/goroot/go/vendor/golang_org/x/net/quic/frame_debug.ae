(go/type debugFrame "A debugFrame is a representation of the contents of a QUIC frame,\nused for debug logs and testing but not the primary serving path.\n" (interface
    (String ^string [])
    (write ^bool [^{:tag (* packetWriter)} w])
    (LogValue ^slog/Value [])))


^{:go/end 73} (go/func parseDebugFrame [^{:tag (slice byte)} b] :results [^debugFrame f ^int n]
  (when (== (len b) 0)
    (return nil -1))

  (switch (aget b 0)
    (case [frameTypePadding]
      (set! (values f n) (parseDebugFramePadding b)))
    (case [frameTypePing]
      (set! (values f n) (parseDebugFramePing b)))
    (case [frameTypeAck frameTypeAckECN]
      (set! (values f n) (parseDebugFrameAck b)))
    (case [frameTypeResetStream]
      (set! (values f n) (parseDebugFrameResetStream b)))
    (case [frameTypeStopSending]
      (set! (values f n) (parseDebugFrameStopSending b)))
    (case [frameTypeCrypto]
      (set! (values f n) (parseDebugFrameCrypto b)))
    (case [frameTypeNewToken]
      (set! (values f n) (parseDebugFrameNewToken b)))
    (case [frameTypeStreamBase 0x09 0x0a 0x0b 0x0c 0x0d 0x0e 0x0f]
      (set! (values f n) (parseDebugFrameStream b)))
    (case [frameTypeMaxData]
      (set! (values f n) (parseDebugFrameMaxData b)))
    (case [frameTypeMaxStreamData]
      (set! (values f n) (parseDebugFrameMaxStreamData b)))
    (case [frameTypeMaxStreamsBidi frameTypeMaxStreamsUni]
      (set! (values f n) (parseDebugFrameMaxStreams b)))
    (case [frameTypeDataBlocked]
      (set! (values f n) (parseDebugFrameDataBlocked b)))
    (case [frameTypeStreamDataBlocked]
      (set! (values f n) (parseDebugFrameStreamDataBlocked b)))
    (case [frameTypeStreamsBlockedBidi frameTypeStreamsBlockedUni]
      (set! (values f n) (parseDebugFrameStreamsBlocked b)))
    (case [frameTypeNewConnectionID]
      (set! (values f n) (parseDebugFrameNewConnectionID b)))
    (case [frameTypeRetireConnectionID]
      (set! (values f n) (parseDebugFrameRetireConnectionID b)))
    (case [frameTypePathChallenge]
      (set! (values f n) (parseDebugFramePathChallenge b)))
    (case [frameTypePathResponse]
      (set! (values f n) (parseDebugFramePathResponse b)))
    (case [frameTypeConnectionCloseTransport]
      (set! (values f n) (parseDebugFrameConnectionCloseTransport b)))
    (case [frameTypeConnectionCloseApplication]
      (set! (values f n) (parseDebugFrameConnectionCloseApplication b)))
    (case [frameTypeHandshakeDone]
      (set! (values f n) (parseDebugFrameHandshakeDone b)))
    (default
      (return nil -1)))

  (return f n))




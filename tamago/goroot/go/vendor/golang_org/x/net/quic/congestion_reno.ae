        ;; However, if we have an existing range of lost packets,
        ;; this does not break it.
        (when (== (.-num sent) (.-next (aget (.-persistentCongestion c) space)))
          (set! (.-next (aget (.-persistentCongestion c) space)) (+ (.-num sent) 1)))))



    (when (not (.-inFlight sent))

        ;; or starts a new one.
        (when (!= (.-num sent) (.-next (aget (.-persistentCongestion c) space)))
          (set! (.-start (aget (.-persistentCongestion c) space)) (.-time sent)))

        (set! (.-end (aget (.-persistentCongestion c) space)) (.-time sent))

^{:go/end 258} (go/method packetBatchEnd "packetBatchEnd is called at the end of processing a batch of acked or lost packets.\n" [^{:tag (* ccReno)} c ^time/Time now ^{:tag (* slog/Logger)} log ^numberSpace space ^{:tag (* rttState)} rtt ^time/Duration maxAckDelay]

(in-ns 'go.vendor.golang_org.x.net.quic) (go/file "stateless_reset.go" :imports [


    ^{:line 8} [hmac "crypto/hmac"]
    ^{:line 9} [rand "crypto/rand"]
    ^{:line 10} [sha256 "crypto/sha256"]
    ^{:line 11} [hash "hash"]
    ^{:line 12} [sync "sync"]])


(go/const ^{:val 16} statelessResetTokenLen (/ 128 8))



(go/type statelessResetToken "A statelessResetToken is a stateless reset token.\nhttps://www.rfc-editor.org/rfc/rfc9000#section-10.3\n" (array statelessResetTokenLen byte))

(go/type statelessResetTokenGenerator (struct
    ^{:line 22 :tag bool} canReset







    ^{:line 30 :tag sync/Mutex :doc "The hash.Hash interface is not concurrency safe,\nso we need a mutex here.\n\nThere shouldn't be much contention on stateless reset token generation.\nIf this proves to be a problem, we could avoid the mutex by using a separate\ngenerator per Conn, or by using a concurrency-safe generator.\n"} mu
    ^{:line 31 :tag hash/Hash} mac))


^{:go/end 50} (go/method init [^{:tag (* statelessResetTokenGenerator)} g ^{:tag (array 32 byte)} secret]
  (let [zero true]
    (range [_ b secret]
      (when (!= b 0)
        (set! zero false)
        (break)))


    (if zero (do
        ;; Generate tokens using a random secret, but don't send stateless resets.
        (rand/Read (subslice secret))
        (set! (.-canReset g) false))

      (set! (.-canReset g) true))

    (set! (.-mac g) (hmac/New sha256/New (subslice secret)))))


^{:go/end 59} (go/method tokenForConnID [^{:tag (* statelessResetTokenGenerator)} g ^{:tag (slice byte)} cid] :results [^statelessResetToken token]

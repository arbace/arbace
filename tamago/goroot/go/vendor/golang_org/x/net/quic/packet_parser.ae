^{:go/end 332} (go/func consumeStreamFrame [^{:tag (slice byte)} b] :results [^streamID id ^int64 off ^bool fin ^{:tag (slice byte)} data ^int n]
  (set! fin (!= (bit-and (aget b 0) 0x01) 0))
  (set! n 1)
  (let [(values idInt nn) (quicwire/ConsumeVarint (subslice b n))]
    (when (< nn 0)
      (return 0 0 false nil -1))

    (set! n + nn)
    (when (!= (bit-and (aget b 0) 0x04) 0)
      (let [(values v nn) (quicwire/ConsumeVarint (subslice b n))]
        (when (< nn 0)
          (return 0 0 false nil -1))

        (set! n + nn)
        (set! off (conv int64 v))))

    (if (!= (bit-and (aget b 0) 0x02) 0) (do
        (set! (values data nn) (quicwire/ConsumeVarintBytes (subslice b n)))
        (when (< nn 0)
          (return 0 0 false nil -1))

        (set! n + nn))
      (do
        (set! data (subslice b n))
        (set! n + (len data))))

    (when (>= (+ off (conv int64 (len data))) (<< 1 62))
      (return 0 0 false nil -1))

    (return (conv streamID idInt) off fin data n)))



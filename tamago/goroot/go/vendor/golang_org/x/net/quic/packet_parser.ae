^{:go/end 453} (go/func consumeNewConnectionIDFrame [^{:tag (slice byte)} b] :results [^int64 seq ^int64 retire ^{:tag (slice byte)} connID ^statelessResetToken resetToken ^int n]
  (set! n 1)
  (let [^int nn (zero int)]
    (set! (values seq nn) (quicwire/ConsumeVarintInt64 (subslice b n)))
    (when (< nn 0)
      (return 0 0 nil (lit statelessResetToken) -1))

    (set! n + nn)
    (set! (values retire nn) (quicwire/ConsumeVarintInt64 (subslice b n)))
    (when (< nn 0)
      (return 0 0 nil (lit statelessResetToken) -1))

    (set! n + nn)
    (when (< seq retire)
      (return 0 0 nil (lit statelessResetToken) -1))

    (set! (values connID nn) (quicwire/ConsumeVarintBytes (subslice b n)))
    (when (< nn 0)
      (return 0 0 nil (lit statelessResetToken) -1))

    (when (or (< (len connID) 1) (> (len connID) 20))
      (return 0 0 nil (lit statelessResetToken) -1))

    (set! n + nn)
    (when (< (len (subslice b n)) (len resetToken))
      (return 0 0 nil (lit statelessResetToken) -1))

    (copy (subslice resetToken) (subslice b n))
    (set! n + (len resetToken))
    (return seq retire connID resetToken n)))



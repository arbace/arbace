^{:go/end 380} (go/func consumeMaxStreamsFrame [^{:tag (slice byte)} b] :results [^streamType typ ^int64 max ^int n]
  (switch (aget b 0)
    (case [frameTypeMaxStreamsBidi]
      (set! typ bidiStream))
    (case [frameTypeMaxStreamsUni]
      (set! typ uniStream))
    (default
      (return 0 0 -1)))

  (set! n 1)
  (let [(values v nn) (quicwire/ConsumeVarint (subslice b n))]
    (when (< nn 0)
      (return 0 0 -1))

    (set! n + nn)
    (when (> v maxStreamsLimit)
      (return 0 0 -1))

    (return typ (conv int64 v) n)))



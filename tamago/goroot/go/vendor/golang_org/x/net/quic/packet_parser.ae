^{:go/end 104} (go/func parseLongHeaderPacket "parseLongHeaderPacket parses a QUIC long header packet.\n\nIt does not parse Version Negotiation packets.\n\nOn input, pkt contains a long header packet (possibly followed by more packets),\nk the decryption keys for the packet, and pnumMax the largest packet number seen\nin the number space of this packet.\n\nparseLongHeaderPacket returns the parsed packet with protection removed\nand its length in bytes.\n\nIt returns an empty packet and -1 if the packet could not be parsed.\n" [^{:tag (slice byte)} pkt ^fixedKeys k ^packetNumber pnumMax] :results [^longPacket p ^int n]
  (when (or (< (len pkt) 5) (not (isLongHeader (aget pkt 0))))
    (return (lit longPacket) -1))


  ;; Header Form (1) = 1,
  ;; Fixed Bit (1) = 1,
  ;; Long Packet Type (2),
  ;; Type-Specific Bits (4),
  (let [b pkt]
    (set! (.-ptype p) (getPacketType b))
    (when (== (.-ptype p) packetTypeInvalid)
      (return (lit longPacket) -1))

    (set! b (subslice b 1))
    ;; Version (32),
    (set! (values (.-version p) n) (quicwire/ConsumeUint32 b))
    (when (< n 0)
      (return (lit longPacket) -1))

    (set! b (subslice b n))
    (when (== (.-version p) 0)
      ;; Version Negotiation packet; not handled here.
      (return (lit longPacket) -1))


    ;; Destination Connection ID Length (8),
    ;; Destination Connection ID (0..160),
    (set! (values (.-dstConnID p) n) (quicwire/ConsumeUint8Bytes b))
    (when (or (< n 0) (> (len (.-dstConnID p)) maxConnIDLen))
      (return (lit longPacket) -1))

    (set! b (subslice b n))

    ;; Source Connection ID Length (8),
    ;; Source Connection ID (0..160),
    (set! (values (.-srcConnID p) n) (quicwire/ConsumeUint8Bytes b))
    (when (or (< n 0) (> (len (.-srcConnID p)) maxConnIDLen))
      (return (lit longPacket) -1))

    (set! b (subslice b n))

    (switch (.-ptype p)
      (case [packetTypeInitial]
        ;; Token Length (i),
        ;; Token (..),
        (set! (values (.-extra p) n) (quicwire/ConsumeVarintBytes b))
        (when (< n 0)
          (return (lit longPacket) -1))

        (set! b (subslice b n)))
      (case [packetTypeRetry]
        ;; Retry Token (..),
        ;; Retry Integrity Tag (128),
        (set! (.-extra p) b)
        (return p (len pkt))))


    ;; Length (i),
    (let [(values payLen ^:assign n) (quicwire/ConsumeVarint b)]
      (when (< n 0)
        (return (lit longPacket) -1))

      (set! b (subslice b n))
      (when (< (conv uint64 (len b)) payLen)
        (return (lit longPacket) -1))


      ;; Packet Number (8..32),
      ;; Packet Payload (..),
      (let [pnumOff (- (len pkt) (len b))]
        (set! pkt (subslice pkt _ (+ pnumOff (conv int payLen))))

        (when (.isSet k)
          (let [^error err (zero error)]
            (set! (values (.-payload p) (.-num p) err) (.unprotect k pkt pnumOff pnumMax))
            (when (!= err nil)
              (return (lit longPacket) -1))))


        (return p (len pkt))))))




^{:go/end 142} (go/func skipLongHeaderPacket "skipLongHeaderPacket returns the length of the long header packet at the start of pkt,\nor -1 if the buffer does not contain a valid packet.\n" ^int [^{:tag (slice byte)} pkt]
  ;; Header byte, 4 bytes of version.
  (let [n 5]
    (when (<= (len pkt) n)
      (return -1))

    ;; Destination connection ID length, destination connection ID.
    (set! n + (+ 1 (conv int (aget pkt n))))
    (when (<= (len pkt) n)
      (return -1))

    ;; Source connection ID length, source connection ID.
    (set! n + (+ 1 (conv int (aget pkt n))))
    (when (<= (len pkt) n)
      (return -1))

    (when (== (getPacketType pkt) packetTypeInitial)
      ;; Token length, token.
      (let [(values _ nn) (quicwire/ConsumeVarintBytes (subslice pkt n))]
        (when (< nn 0)
          (return -1))

        (set! n + nn)))

    ;; Length, packet number, payload.
    (let [(values _ nn) (quicwire/ConsumeVarintBytes (subslice pkt n))]
      (when (< nn 0)
        (return -1))

      (set! n + nn)
      (when (< (len pkt) n)
        (return -1))

      ^{:line 141} n)))






^{:go/end 156} (go/func parse1RTTPacket "parse1RTTPacket parses a QUIC 1-RTT (short header) packet.\n\nOn input, pkt contains a short header packet, k the decryption keys for the packet,\nand pnumMax the largest packet number seen in the number space of this packet.\n" [^{:tag (slice byte)} pkt ^{:tag (* updatingKeyPair)} k ^int dstConnIDLen ^packetNumber pnumMax] :results [^shortPacket p ^error err]
  (let [(values pay pnum ^:assign err) (.unprotect k pkt (+ 1 dstConnIDLen) pnumMax)]
    (when (!= err nil)
      (return (lit shortPacket) err))

    (set! (.-num p) pnum)
    (set! (.-payload p) pay)
    (return p nil)))


;; Consume functions return n=-1 on conditions which result in FRAME_ENCODING_ERROR,
;; which includes both general parse failures and specific violations of frame
;; constraints.

^{:go/end 235} (go/func consumeAckFrame [^{:tag (slice byte)} frame ^{:tag (func [^int rangeIndex ^packetNumber start ^packetNumber end])} f] :results [^packetNumber largest ^unscaledAckDelay ackDelay ^ecnCounts ecn ^int n]
  (let [b (subslice frame 1) ; type

      (values largestAck ^:assign n) (quicwire/ConsumeVarint b)]
    (when (< n 0)
      (return 0 0 (lit ecnCounts) -1))

    (set! b (subslice b n))

    (let [(values v ^:assign n) (quicwire/ConsumeVarintInt64 b)]
      (when (< n 0)
        (return 0 0 (lit ecnCounts) -1))

      (set! b (subslice b n))
      (set! ackDelay (conv unscaledAckDelay v))

      (let [(values ackRangeCount ^:assign n) (quicwire/ConsumeVarint b)]
        (when (< n 0)
          (return 0 0 (lit ecnCounts) -1))

        (set! b (subslice b n))

        (let [rangeMax (conv packetNumber largestAck)]
          (for [i (conv uint64 0)] _ (inc! i)
            (let [(values rangeLen n) (quicwire/ConsumeVarint b)]
              (when (< n 0)
                (return 0 0 (lit ecnCounts) -1))

              (set! b (subslice b n))
              (let [rangeMin (- rangeMax (conv packetNumber rangeLen))]
                (when (or (< rangeMin 0) (> rangeMin rangeMax))
                  (return 0 0 (lit ecnCounts) -1))

                (f (conv int i) rangeMin (+ rangeMax 1))

                (when (== i ackRangeCount)
                  (break))


                (let [(values gap ^:assign n) (quicwire/ConsumeVarint b)]
                  (when (< n 0)
                    (return 0 0 (lit ecnCounts) -1))

                  (set! b (subslice b n))

                  (set! rangeMax (- rangeMin (conv packetNumber gap) 2))))))


          (when (!= (aget frame 0) frameTypeAckECN)
            (return (conv packetNumber largestAck) ackDelay (lit ecnCounts) (- (len frame) (len b))))


          (let [(values ect0Count ^:assign n) (quicwire/ConsumeVarint b)]
            (when (< n 0)
              (return 0 0 (lit ecnCounts) -1))

            (set! b (subslice b n))
            (let [(values ect1Count ^:assign n) (quicwire/ConsumeVarint b)]
              (when (< n 0)
                (return 0 0 (lit ecnCounts) -1))

              (set! b (subslice b n))
              (let [(values ecnCECount ^:assign n) (quicwire/ConsumeVarint b)]
                (when (< n 0)
                  (return 0 0 (lit ecnCounts) -1))

                (set! b (subslice b n))

                (set! (.-t0 ecn) (conv int ect0Count))
                (set! (.-t1 ecn) (conv int ect1Count))
                (set! (.-ce ecn) (conv int ecnCECount))

                (return (conv packetNumber largestAck) ackDelay ecn (- (len frame) (len b)))))))))))


^{:go/end 256} (go/func consumeResetStreamFrame [^{:tag (slice byte)} b] :results [^streamID id ^uint64 code ^int64 finalSize ^int n]
  (set! n 1)
  (let [(values idInt nn) (quicwire/ConsumeVarint (subslice b n))]
    (when (< nn 0)
      (return 0 0 0 -1))

    (set! n + nn)
    (set! (values code nn) (quicwire/ConsumeVarint (subslice b n)))
    (when (< nn 0)
      (return 0 0 0 -1))

    (set! n + nn)
    (let [(values v ^:assign nn) (quicwire/ConsumeVarint (subslice b n))]
      (when (< nn 0)
        (return 0 0 0 -1))

      (set! n + nn)
      (set! finalSize (conv int64 v))
      (return (conv streamID idInt) code finalSize n))))



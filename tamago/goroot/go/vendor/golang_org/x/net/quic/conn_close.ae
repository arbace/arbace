^{:go/breaks [10] :go/end 91} (go/method lifetimeAdvance "advance is called when time passes.\n" [^{:tag (* Conn)} c ^time/Time now] :results [^bool done]
  (when (or (.IsZero (.-drainEndTime (.-lifetime c))) (.After (.-drainEndTime (.-lifetime c)) now))
    (return false))

  ;; The connection drain period has ended, and we can shut down.
  ;; https://www.rfc-editor.org/rfc/rfc9000.html#section-10.2-7

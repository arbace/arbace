^{:go/end 177} (go/method sendOK "sendOK reports whether the conn can send frames at this time.\n" ^bool [^{:tag (* Conn)} c ^time/Time now]
  (switch (.-state (.-lifetime c))
    (case [connStateAlive]
      (return true))
    (case [connStatePeerClosed]
      (when (== (.-localErr (.-lifetime c)) nil)
        ;; We're waiting for the user to close the connection, providing us with
        ;; a final status to send to the peer.
        (return false))

      ;; We should send a CONNECTION_CLOSE.
      (return true))
    (case [connStateClosing]
      (when (.IsZero (.-connCloseSentTime (.-lifetime c)))
        (return true))

      (let [maxRecvTime (.-maxRecvTime (aget (.-acks c) initialSpace))]
        (when [t (.-maxRecvTime (aget (.-acks c) handshakeSpace))] (.After t maxRecvTime)
          (set! maxRecvTime t))

        (when [t (.-maxRecvTime (aget (.-acks c) appDataSpace))] (.After t maxRecvTime)
          (set! maxRecvTime t))

        (when (.Before maxRecvTime (.Add (.-connCloseSentTime (.-lifetime c)) (.-connCloseDelay (.-lifetime c))))
          ;; After sending CONNECTION_CLOSE, ignore packets from the peer for
          ;; a delay. On the next packet received after the delay, send another
          ;; CONNECTION_CLOSE.
          (return false))

        (return true)))
    (case [connStateDraining]
      ;; We are in the draining state, and will send no more packets.
      (return false))
    (case [connStateDone]
      (return false))
    (default
      (panic "BUG: unhandled connection state"))))




^{:go/end 199} (go/method sentConnectionClose "sentConnectionClose reports that the conn has sent a CONNECTION_CLOSE to the peer.\n" [^{:tag (* Conn)} c ^time/Time now]
  (switch (.-state (.-lifetime c))
    (case [connStatePeerClosed]
      (.enterDraining c now)))

  (cond (.IsZero (.-connCloseSentTime (.-lifetime c)))
    ;; Set the initial delay before we will send another CONNECTION_CLOSE.
    ;;
    ;; RFC 9000 states that we should rate limit CONNECTION_CLOSE frames,
    ;; but leaves the implementation of the limit up to us. Here, we start
    ;; with the same delay as the PTO timer (RFC 9002, Section 6.2.1),
    ;; not including max_ack_delay, and double it on every CONNECTION_CLOSE sent.
    (set! (.-connCloseDelay (.-lifetime c)) (+ (.-smoothedRTT (.-rtt (.-loss c))) (max (* 4 (.-rttvar (.-rtt (.-loss c)))) timerGranularity)))
    (not (.Equal (.-connCloseSentTime (.-lifetime c)) now))
    ;; If connCloseSentTime == now, we're sending two CONNECTION_CLOSE frames
    ;; coalesced into the same datagram. We only want to increase the delay once.
    (set! (.-connCloseDelay (.-lifetime c)) * 2))

  (set! (.-connCloseSentTime (.-lifetime c)) now))



^{:go/end 218} (go/method handlePeerConnectionClose "handlePeerConnectionClose handles a CONNECTION_CLOSE from the peer.\n" [^{:tag (* Conn)} c ^time/Time now ^error err]
  (.setFinalError c err)
  (switch (.-state (.-lifetime c))
    (case [connStateAlive]
      (.setState c now connStatePeerClosed))
    (case [connStatePeerClosed])
    ;; Duplicate CONNECTION_CLOSE, ignore.
    (case [connStateClosing]
      (if (.IsZero (.-connCloseSentTime (.-lifetime c)))
        (.setState c now connStatePeerClosed)

        (.setState c now connStateDraining)))

    (case [connStateDraining])
    (case [connStateDone])))




^{:go/end 229} (go/method setFinalError "setFinalError records the final connection status we report to the user.\n" [^{:tag (* Conn)} c ^error err]

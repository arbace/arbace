    ;; We were in the closing state, waiting for a CONNECTION_CLOSE from the peer.
    (.setFinalError c errNoPeerResponse))

  (.setState c now connStateDone)
  true)



^{:go/end 110} (go/method setState "setState sets the conn state.\n" [^{:tag (* Conn)} c ^time/Time now ^connState state]
  (when (== (.-state (.-lifetime c)) state)
    (return))

  (set! (.-state (.-lifetime c)) state)

^{:go/end 258} (go/method waitReady ^error [^{:tag (* Conn)} c ^context/Context ctx]
  (select
    (case (<! (.-readyc (.-lifetime c)))
      (return nil))
    (case (<! (.-donec (.-lifetime c)))
      (return (.-finalErr (.-lifetime c))))
    (default))


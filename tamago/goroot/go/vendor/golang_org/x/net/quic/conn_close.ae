(go/type lifetimeState "lifetimeState tracks the state of a connection.\n\nThis is fairly coupled to the rest of a Conn, but putting it in a struct of its own helps\nreason about operations that cause state transitions.\n" (struct
    ^{:line 54 :tag connState} state

    ^{:line 56 :tag (chan (struct))} readyc ; closed when TLS handshake completes
    ^{:line 57 :tag (chan (struct))} donec ; closed when finalErr is set

    ^{:line 59 :tag error} localErr ; error sent to the peer
    ^{:line 60 :tag error} finalErr ; error sent by the peer, or transport error; set before closing donec

    ^{:line 62 :tag time/Time} connCloseSentTime ; send time of last CONNECTION_CLOSE frame
    ^{:line 63 :tag time/Duration} connCloseDelay ; delay until next CONNECTION_CLOSE frame sent
    ^{:line 64 :tag time/Time} drainEndTime)) ; time the connection exits the draining state



    (case (<! (.-readyc (.-lifetime c)))
      (return nil))
    (case (<! (.-donec (.-lifetime c)))
      (return (.-finalErr (.-lifetime c))))
    (case (<! (.Done ctx))
      (return (.Err ctx)))))









^{:go/end 270} (go/method Close "Close closes the connection.\n\nClose is equivalent to:\n\n\tconn.Abort(nil)\n\terr := conn.Wait(context.Background())\n" ^error [^{:tag (* Conn)} c]

      (return false))

    (set! (.-b w) (append (.-b w) ackType))
    (set! (.-b w) (quicwire/AppendVarint (.-b w) largest))
    (set! (.-b w) (quicwire/AppendVarint (.-b w) (conv uint64 delay)))
    ;; The range count is technically a varint, but we'll reserve a single byte for it
    ;; and never add more than 62 ranges (the maximum varint that fits in a byte).
    (let [rangeCountOff (len (.-b w))]
      (set! (.-b w) (append (.-b w) 0))
      (set! (.-b w) (quicwire/AppendVarint (.-b w) firstRange))

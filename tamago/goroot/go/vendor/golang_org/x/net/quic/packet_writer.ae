^{:go/end 103} (go/method startProtectedLongHeaderPacket "startProtectedLongHeaderPacket starts writing an Initial, 0-RTT, or Handshake packet.\n" [^{:tag (* packetWriter)} w ^packetNumber pnumMaxAcked ^longPacket p]

          (set! (.-b w) (quicwire/AppendVarint (.-b w) (conv uint64 (.-t0 ecn))))
          (set! (.-b w) (quicwire/AppendVarint (.-b w) (conv uint64 (.-t1 ecn))))
          (set! (.-b w) (quicwire/AppendVarint (.-b w) (conv uint64 (.-ce ecn)))))


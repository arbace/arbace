    (set! (.-sent w) (newSentPacket)))

  (set! (.-pktOff w) (len (.-b w)))
  (let [hdrSize 1] ; packet type
    (set! hdrSize + 4) ; version
    (set! hdrSize + (+ 1 (len (.-dstConnID p))))
    (set! hdrSize + (+ 1 (len (.-srcConnID p))))
    (switch (.-ptype p)
      (case [packetTypeInitial]
        (set! hdrSize + (+ (quicwire/SizeVarint (conv uint64 (len (.-extra p)))) (len (.-extra p))))))

    (set! hdrSize + 2) ; length, hardcoded to a 2-byte varint
    (let [pnumOff (+ (len (.-b w)) hdrSize)]
      (set! hdrSize + (packetNumberLength (.-num p) pnumMaxAcked))
      (let [payOff (+ (len (.-b w)) hdrSize)]
        ;; Check if we have enough space to hold the packet, including the header,
        ;; header protection sample (RFC 9001, section 5.4.2), and encryption overhead.
        (when (>= (+ pnumOff 4 headerProtectionSampleSize aeadOverhead) (.-dgramLim w))
          ;; Set the limit on the packet size to be the current write buffer length,
          ;; ensuring that any writes to the payload fail.
          (set! (.-payOff w) (len (.-b w)))
          (set! (.-pktLim w) (len (.-b w)))
          (return))

        (set! (.-payOff w) payOff)
        (set! (.-pktLim w) (- (.-dgramLim w) aeadOverhead))
        ;; We hardcode the payload length field to be 2 bytes, which limits the payload
        ;; (including the packet number) to 16383 bytes (the largest 2-byte QUIC varint).
        ;;

^{:go/end 166} (go/method start1RTTPacket "start1RTTPacket starts writing a 1-RTT (short header) packet.\n" [^{:tag (* packetWriter)} w ^packetNumber pnum ^packetNumber pnumMaxAcked ^{:tag (slice byte)} dstConnID]

(go/type gate "An gate is a monitor (mutex + condition variable) with one bit of state.\n\nThe condition may be either set or unset.\nLock operations may be unconditional, or wait for the condition to be set.\nUnlock operations record the new state of the condition.\n" (struct


    ^{:line 17 :tag (chan (struct)) :doc "When unlocked, exactly one of set or unset contains a value.\nWhen locked, neither chan contains a value.\n"} set
    ^{:line 18 :tag (chan (struct))} unset))



^{:go/end 26} (go/func newGate "newGate returns a new, unlocked gate with the condition unset.\n" ^gate []
  (let [g (newLockedGate)]
    (.unlock g false)
    ^{:line 25} g))



^{:go/end 34} (go/func newLockedGate "newLockedGate returns a new, locked gate.\n" ^gate []
  ^{:go/breaks [2 4]} (lit gate
    :set (make (chan (struct)) 1)
    :unset (make (chan (struct)) 1)))





^{:go/end 45} (go/method lock "lock acquires the gate unconditionally.\nIt reports whether the condition is set.\n" [^{:tag (* gate)} g] :results [^bool set]
  (select
    (case (<! (.-set g))
      (return true))
    (case (<! (.-unset g))
      (return false))))





^{:go/end 61} (go/method waitAndLock "waitAndLock waits until the condition is set before acquiring the gate.\nIf the context expires, waitAndLock returns an error and does not acquire the gate.\n" ^error [^{:tag (* gate)} g ^context/Context ctx]
  (select
    (case (<! (.-set g))
      (return nil))
    (default))

  (select
    (case (<! (.-set g))
      (return nil))
    (case (<! (.Done ctx))
      (return (.Err ctx)))))




^{:go/end 71} (go/method lockIfSet "lockIfSet acquires the gate if and only if the condition is set.\n" [^{:tag (* gate)} g] :results [^bool acquired]
  (select
    (case (<! (.-set g))
      (return true))
    (default
      (return false))))




^{:go/end 80} (go/method unlock "unlock sets the condition and releases the gate.\n" [^{:tag (* gate)} g ^bool set]
  (if set
    (>! (.-set g) (lit (struct)))

    (>! (.-unset g) (lit (struct)))))





^{:go/end 86} (go/method unlockFunc "unlockFunc sets the condition to the result of f and releases the gate.\nUseful in defers.\n" [^{:tag (* gate)} g ^{:tag (func [] [bool])} f]

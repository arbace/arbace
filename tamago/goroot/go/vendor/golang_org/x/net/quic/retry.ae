    (when [(values _ err) (rand/Read nonce)] (!= err nil)
      (return nil nil err))


    (let [^{:tag (slice byte)} plaintext (zero (slice byte))]
      (set! plaintext (.AppendUint64 binary/BigEndian plaintext (conv uint64 (.Unix now))))
      (set! plaintext (append plaintext (spread origDstConnID)))

      (set! token (append token (spread (subslice nonce maxConnIDLen))))
      (set! token (.Seal (.-aead rs) token nonce plaintext (.additionalData rs srcConnID addr)))
      (return token (subslice nonce _ maxConnIDLen) nil))))



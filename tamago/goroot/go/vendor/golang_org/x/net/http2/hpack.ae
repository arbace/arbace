(ns go.vendor.golang_org.x.net.http2.hpack
  (:require [arbace.go :as go]))

(go/package hpack
  :path "vendor/golang.org/x/net/http2/hpack"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["encode.go" "hpack.go" "huffman.go" "static_table.go" "tables.go"]
  :init-order [ErrStringLength errNeedMore errVarintOverflow bufPool ErrInvalidHuffman staticTable huffmanCodes huffmanCodeLen]
  :positions :lines)

(load "hpack/encode")
(load "hpack/hpack")
(load "hpack/huffman")
(load "hpack/static_table")
(load "hpack/tables")

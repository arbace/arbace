(in-ns 'go.vendor.golang_org.x.net.http2.hpack) (go/file "tables.go" :imports [


    ^{:line 8} [fmt "fmt"]])




(go/type headerFieldTable "headerFieldTable implements a list of HeaderFields.\nThis is used to implement the static and dynamic tables.\n" (struct















    ^{:line 29 :tag (slice HeaderField) :doc "For static tables, entries are never evicted.\n\nFor dynamic tables, entries are evicted from ents[0] and added to the end.\nEach entry has a unique id that starts at one and increments for each\nentry that is added. This unique id is stable across evictions, meaning\nit can be used as a pointer to a specific entry. As in hpack, unique ids\nare 1-based. The unique id for ents[k] is k + evictCount + 1.\n\nZero is not a valid unique id.\n\nevictCount should not overflow in any remotely practical situation. In\npractice, we will have one dynamic table per HTTP/2 connection. If we\nassume a very powerful server that handles 1M QPS per connection and each\nrequest adds (then evicts) 100 entries from the table, it would still take\n2M years for evictCount to overflow.\n"} ents
    ^{:line 30 :tag uint64} evictCount



    ^{:line 34 :tag (map string uint64) :doc "byName maps a HeaderField name to the unique id of the newest entry with\nthe same name. See above for a definition of \"unique id\".\n"} byName



    ^{:line 38 :tag (map pairNameValue uint64) :doc "byNameValue maps a HeaderField name/value pair to the unique id of the newest\nentry with the same name and value. See above for a definition of \"unique id\".\n"} byNameValue))


(go/type pairNameValue (struct
    ^{:line 42 :tag string} name ^string value))


^{:go/end 48} (go/method init [^{:tag (* headerFieldTable)} t]
  (set! (.-byName t) (make (map string uint64)))
  (set! (.-byNameValue t) (make (map pairNameValue uint64))))



^{:go/end 53} (go/method len "len reports the number of entries in the table.\n" ^int [^{:tag (* headerFieldTable)} t]
  (len (.-ents t)))



^{:go/end 61} (go/method addEntry "addEntry adds a new entry.\n" [^{:tag (* headerFieldTable)} t ^HeaderField f]
  (let [id (+ (conv uint64 (.len t)) (.-evictCount t) 1)]
    (aset (.-byName t) (.-Name f) id)
    (aset (.-byNameValue t) (lit pairNameValue (.-Name f) (.-Value f)) id)
    (set! (.-ents t) (append (.-ents t) f))))



^{:go/end 87} (go/method evictOldest "evictOldest evicts the n oldest entries in the table.\n" [^{:tag (* headerFieldTable)} t ^int n]
  (when (> n (.len t))
    (panic (fmt/Sprintf "evictOldest(%v) on table with %v entries" n (.len t))))

  (for [k 0] (< k n) (inc! k)
    (let [f (aget (.-ents t) k)
        ^{:line 70} id (+ (.-evictCount t) (conv uint64 k) 1)]
      (when (== (aget (.-byName t) (.-Name f)) id)
        (delete (.-byName t) (.-Name f)))

      (when [p (lit pairNameValue (.-Name f) (.-Value f))] (== (aget (.-byNameValue t) p) id)
        (delete (.-byNameValue t) p))))


  (copy (.-ents t) (subslice (.-ents t) n))
  (for [k (- (.len t) n)] (< k (.len t)) (inc! k)
    (aset (.-ents t) k (lit HeaderField))) ; so strings can be garbage collected

  (set! (.-ents t) (subslice (.-ents t) _ (- (.len t) n)))
  (when (< (+ (.-evictCount t) (conv uint64 n)) (.-evictCount t))
    (panic "evictCount overflow"))

  (set! (.-evictCount t) + (conv uint64 n)))















^{:go/end 112} (go/method search "search finds f in the table. If there is no match, i is 0.\nIf both name and value match, i is the matched index and nameValueMatch\nbecomes true. If only name matches, i points to that index and\nnameValueMatch becomes false.\n\nThe returned index is a 1-based HPACK index. For dynamic tables, HPACK says\nthat index 1 should be the newest entry, but t.ents[0] is the oldest entry,\nmeaning t.ents is reversed for dynamic tables. Hence, when t is a dynamic\ntable, the return value i actually refers to the entry t.ents[t.len()-i].\n\nAll tables are assumed to be a dynamic tables except for the global staticTable.\n\nSee Section 2.3.3.\n" [^{:tag (* headerFieldTable)} t ^HeaderField f] :results [^uint64 i ^bool nameValueMatch]
  (when (not (.-Sensitive f))
    (when [id (aget (.-byNameValue t) (lit pairNameValue (.-Name f) (.-Value f)))] (!= id 0)
      (return (.idToIndex t id) true)))


  (when [id (aget (.-byName t) (.-Name f))] (!= id 0)
    (return (.idToIndex t id) false))

  (return 0 false))




^{:go/end 125} (go/method idToIndex "idToIndex converts a unique id to an HPACK index.\nSee Section 2.3.3.\n" ^uint64 [^{:tag (* headerFieldTable)} t ^uint64 id]
  (when (<= id (.-evictCount t))
    (panic (fmt/Sprintf "id (%v) <= evictCount (%v)" id (.-evictCount t))))

  (let [k (- id (.-evictCount t) 1)] ; convert id to an index t.ents[k]
    (when (!= t staticTable)
      (return (- (conv uint64 (.len t)) k))) ; dynamic table

    (+ k 1)))



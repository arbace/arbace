      ^{:line 51} n rootHuffmanNode
      ;; cur is the bit buffer that has not been fed into n.
      ;; cbits is the number of low order bits in cur that are valid.
      ;; sbits is the number of bits of the symbol prefix being decoded.
      (values cur cbits sbits) (values (conv uint 0) (conv uint8 0) (conv uint8 0))]
    (range [_ b v]
      (set! cur (bit-or (<< cur 8) (conv uint b)))
      (set! cbits + 8)
      (set! sbits + 8)
      (while (>= cbits 8)
        (let [idx (conv byte (>> cur (- cbits 8)))]
          (set! n (aget (.-children n) idx))
          (when (== n nil)
            (return ErrInvalidHuffman))

          (if (== (.-children n) nil) (do
              (when (and (!= maxLen 0) (== (.Len buf) maxLen))
                (return ErrStringLength))

              (.WriteByte buf (.-sym n))
              (set! cbits - (.-codeLen n))
              (set! n rootHuffmanNode)
              (set! sbits cbits))

            (set! cbits - 8)))))



    (while (> cbits 0)
      (set! n (aget (.-children n) (conv byte (<< cur (- 8 cbits)))))
      (when (== n nil)
        (return ErrInvalidHuffman))

      (when (or (!= (.-children n) nil) (> (.-codeLen n) cbits))
        (break))

      (when (and (!= maxLen 0) (== (.Len buf) maxLen))
        (return ErrStringLength))

      (.WriteByte buf (.-sym n))
      (set! cbits - (.-codeLen n))
      (set! n rootHuffmanNode)
      (set! sbits cbits))

    (when (> sbits 7)
      ;; Either there was an incomplete symbol, or overlong padding.
      ;; Both are decoding errors per RFC 7541 section 5.2.
      (return ErrInvalidHuffman))

    (when [mask (conv uint (- ^uint (<< 1 cbits) 1))] (!= (bit-and cur mask) mask)
      ;; Trailing bits must be a prefix of EOS per RFC 7541 section 5.2.
      (return ErrInvalidHuffman))


    nil))






^{:go/end 216} (go/func AppendHuffmanString "AppendHuffmanString appends s, as encoded in Huffman codes, to dst\nand returns the extended buffer.\n" ^{:tag (slice byte)} [^{:tag (slice byte)} dst ^string s]
  ;; This relies on the maximum huffman code length being 30 (See tables.go huffmanCodeLen array)
  ;; So if a uint64 buffer has less than 32 valid bits can always accommodate another huffmanCode.
  (let [
      ^{:line 175 :tag uint64} x (zero uint64) ; buffer
      ^{:line 176 :tag uint} n (zero uint)] ; number valid of bits present in x

    (for [i 0] (< i (len s)) (inc! i)
      (let [c (aget s i)]
        (set! n + (conv uint (aget huffmanCodeLen c)))
        (set! x << (% (aget huffmanCodeLen c) 64))
        (set! x bit-or (conv uint64 (aget huffmanCodes c)))
        (when (>= n 32)
          (set! n % 32) ; Normally would be -= 32 but %= 32 informs compiler 0 <= n <= 31 for upcoming shift
          (let [y (conv uint32 (>> x n))] ; Compiler doesn't combine memory writes if y isn't uint32
            (set! dst (append dst (conv byte (>> y 24)) (conv byte (>> y 16)) (conv byte (>> y 8)) (conv byte y)))))))


    ;; Add padding bits if necessary
    (when [over (% n 8)] (> over 0)
      (let [
          ^:const ^{:line 192 :val 1073741823} eosCode 0x3fffffff
          ^:const ^:go/grouped ^{:line 193 :val 30} eosNBits 30
          ^:const ^:go/grouped ^{:line 194 :val 255} eosPadByte (>> eosCode (- eosNBits 8))

          ^{:line 196} pad (- 8 over)]
        (set! x (bit-or (<< x pad) ^uint64 (>> eosPadByte over)))
        (set! n + pad))) ; 8 now divides into n exactly

    ;; n in (0, 8, 16, 24, 32)
    (switch (/ n 8)

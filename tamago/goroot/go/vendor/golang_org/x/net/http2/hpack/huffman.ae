^{:go/end 29} (go/func HuffmanDecode "HuffmanDecode decodes the string in v and writes the expanded\nresult to w, returning the number of bytes written to w and the\nWrite call's return value. At most one Write call is made.\n" [^io/Writer w ^{:tag (slice byte)} v] :results [int error]
  (let [buf (assert (* bytes/Buffer) (.Get bufPool))]
    (.Reset buf)
    (defer (.Put bufPool buf))
    (when [err (huffmanDecode buf 0 v)] (!= err nil)
      (return 0 err))

    (.Write w (.Bytes buf))))



^{:go/end 40} (go/func HuffmanDecodeToString "HuffmanDecodeToString decodes the string in v.\n" [^{:tag (slice byte)} v] :results [string error]
  (let [buf (assert (* bytes/Buffer) (.Get bufPool))]
    (.Reset buf)
    (defer (.Put bufPool buf))
    (when [err (huffmanDecode buf 0 v)] (!= err nil)
      (return "" err))

    (return (.String buf) nil)))




(go/var ^{:doc "ErrInvalidHuffman is returned for errors found decoding\nHuffman-encoded strings.\n"} ErrInvalidHuffman (errors/New "hpack: invalid Huffman-encoded data"))




^{:go/end 106} (go/func huffmanDecode "huffmanDecode decodes v to buf.\nIf maxLen is greater than 0, attempts to write more to buf than\nmaxLen bytes will return ErrStringLength.\n" ^error [^{:tag (* bytes/Buffer)} buf ^int maxLen ^{:tag (slice byte)} v]

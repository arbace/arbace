          (return (append dst (conv byte (>> y 8)) (conv byte y)))))
      (case [3]
        (let [y (conv uint16 (>> x 8))]
          (return (append dst (conv byte (>> y 8)) (conv byte y) (conv byte x))))))

    ;;	case 4:
    (let [y (conv uint32 x)]
      (append dst (conv byte (>> y 24)) (conv byte (>> y 16)) (conv byte (>> y 8)) (conv byte y)))))




^{:go/end 226} (go/func HuffmanEncodeLength "HuffmanEncodeLength returns the number of bytes required to encode\ns in Huffman codes. The result is round up to byte boundary.\n" ^uint64 [^string s]

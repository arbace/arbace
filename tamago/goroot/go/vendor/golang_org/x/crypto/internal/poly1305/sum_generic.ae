          (when (!= (.-hi h2r1) 0)
            (panic "poly1305: unexpected overflow"))


          (let [m0 h0r0
              ^{:line 220} m1 (add128 h1r0 h0r1) ; These two additions don't overflow thanks again
              ^{:line 221} m2 (add128 h2r0 h1r1) ; to the 4 masked bits at the top of r0 and r1.

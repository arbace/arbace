;; Poly1305 [RFC 7539] is a relatively simple algorithm: the authentication tag
;; for a 64 bytes message is approximately
;;
;;     s + m[0:16] * r⁴ + m[16:32] * r³ + m[32:48] * r² + m[48:64] * r  mod  2¹³⁰ - 5
;;
;; for some secret r and s. It can be computed sequentially like
;;
;;     for len(msg) > 0:
;;         h += read(msg, 16)
;;         h *= r
;;         h %= 2¹³⁰ - 5
;;     return h + s
;;
;; All the complexity is about doing performant constant-time math on numbers
;; larger than any available numeric type.

^{:go/end 35} (go/func sumGeneric [^{:tag (* (array TagSize byte))} out ^{:tag (slice byte)} msg ^{:tag (* (array 32 byte))} key]
  (let [h (newMACGeneric key)]
    (.Write h msg)
    (.Sum h out)))


^{:go/end 41} (go/func newMACGeneric ^macGeneric [^{:tag (* (array 32 byte))} key]
  (let [m (lit macGeneric)]
    (initialize key (addr (.-macState m)))
    ^{:line 40} m))




(go/type macState "macState holds numbers in saturated 64-bit little-endian limbs. That is,\nthe value of [x0, x1, x2] is x[0] + x[1] * 2⁶⁴ + x[2] * 2¹²⁸.\n" (struct



    ^{:line 49 :tag (array 3 uint64) :doc "h is the main accumulator. It is to be interpreted modulo 2¹³⁰ - 5, but\ncan grow larger during and after rounds. It must, however, remain below\n2 * (2¹³⁰ - 5).\n"} h

    ^{:line 51 :tag (array 2 uint64) :doc "r and s are the private key components.\n"} r
    ^{:line 52 :tag (array 2 uint64)} s))


(go/type macGeneric (struct
    ^{:line 56} macState

    ^{:line 58 :tag (array TagSize byte)} buffer
    ^{:line 59 :tag int} offset))




^{:go/end 84} (go/method Write "Write splits the incoming message into TagSize chunks, and passes them to\nupdate. It buffers incomplete chunks.\n" [^{:tag (* macGeneric)} h ^{:tag (slice byte)} p] :results [int error]
  (let [nn (len p)]
    (when (> (.-offset h) 0)
      (let [n (copy (subslice (.-buffer h) (.-offset h)) p)]
        (when (< (+ (.-offset h) n) TagSize)
          (set! (.-offset h) + n)
          (return nn nil))

        (set! p (subslice p n))
        (set! (.-offset h) 0)
        (updateGeneric (addr (.-macState h)) (subslice (.-buffer h)))))

    (when [n (- (len p) (% (len p) TagSize))] (> n 0)
      (updateGeneric (addr (.-macState h)) (subslice p _ n))
      (set! p (subslice p n)))

    (when (> (len p) 0)
      (set! (.-offset h) + (copy (subslice (.-buffer h) (.-offset h)) p)))

    (return nn nil)))





^{:go/end 95} (go/method Sum "Sum flushes the last incomplete chunk from the buffer, if any, and generates\nthe MAC output. It does not modify its state, in order to allow for multiple\ncalls to Sum, even if no Write is allowed after Sum.\n" [^{:tag (* macGeneric)} h ^{:tag (* (array TagSize byte))} out]
  (let [state (.-macState h)]
    (when (> (.-offset h) 0)
      (updateGeneric (addr state) (subslice (.-buffer h) _ (.-offset h))))

    (finalize out (addr (.-h state)) (addr (.-s state)))))





(go/const "[rMask0, rMask1] is the specified Poly1305 clamping mask in little-endian. It\nclears some bits of the secret coefficient to make it possible to implement\nmultiplication more efficiently.\n"
  ^{:line 101} [^{:val 1152921487695413247} rMask0 0x0FFFFFFC0FFFFFFF]
  ^{:line 102} [^{:val 1152921487695413244} rMask1 0x0FFFFFFC0FFFFFFC])



^{:go/end 111} (go/func initialize "initialize loads the 256-bit key into the two 128-bit secret values r and s.\n" [^{:tag (* (array 32 byte))} key ^{:tag (* macState)} m]
  (aset (.-r m) 0 (bit-and (.Uint64 binary/LittleEndian (subslice key 0 8)) rMask0))
  (aset (.-r m) 1 (bit-and (.Uint64 binary/LittleEndian (subslice key 8 16)) rMask1))
  (aset (.-s m) 0 (.Uint64 binary/LittleEndian (subslice key 16 24)))
  (aset (.-s m) 1 (.Uint64 binary/LittleEndian (subslice key 24 32))))




(go/type uint128 "uint128 holds a 128-bit number as two 64-bit limbs, for use with the\nbits.Mul64 and bits.Add64 intrinsics.\n" (struct
    ^{:line 116 :tag uint64} lo ^uint64 hi))


^{:go/end 122} (go/func mul64 ^uint128 [^uint64 a ^uint64 b]
  (let [(values hi lo) (bits/Mul64 a b)]
    (lit uint128 lo hi)))


^{:go/end 131} (go/func add128 ^uint128 [^uint128 a ^uint128 b]
  (let [(values lo c) (bits/Add64 (.-lo a) (.-lo b) 0)
      (values hi ^:assign c) (bits/Add64 (.-hi a) (.-hi b) c)]
    (when (!= c 0)
      (panic "poly1305: unexpected overflow"))

    (lit uint128 lo hi)))



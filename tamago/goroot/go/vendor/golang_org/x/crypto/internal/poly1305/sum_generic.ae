^{:go/end 265} (go/func updateGeneric "updateGeneric absorbs msg into the state.h accumulator. For each chunk m of\n128 bits of message, it computes\n\n\th₊ = (h + m) * r  mod  2¹³⁰ - 5\n\nIf the msg length is not a multiple of TagSize, it assumes the last\nincomplete chunk is the final one.\n" [^{:tag (* macState)} state ^{:tag (slice byte)} msg]
  (let [(values h0 h1 h2) (values (aget (.-h state) 0) (aget (.-h state) 1) (aget (.-h state) 2))
      (values r0 r1) (values (aget (.-r state) 0) (aget (.-r state) 1))]

    (while (> (len msg) 0)
      (let [^uint64 c (zero uint64)]

        ;; For the first step, h + m, we use a chain of bits.Add64 intrinsics.
        ;; The resulting value of h might exceed 2¹³⁰ - 5, but will be partially
        ;; reduced at the end of the multiplication below.
        ;;
        ;; The spec requires us to set a bit just above the message size, not to
        ;; hide leading zeroes. For full chunks, that's 1 << 128, so we can just
        ;; add 1 to the most significant (2¹²⁸) limb, h2.
        (if (>= (len msg) TagSize) (do
            (set! (values h0 c) (bits/Add64 h0 (.Uint64 binary/LittleEndian (subslice msg 0 8)) 0))
            (set! (values h1 c) (bits/Add64 h1 (.Uint64 binary/LittleEndian (subslice msg 8 16)) c))
            (set! h2 + (+ c 1))

            (set! msg (subslice msg TagSize)))

          (let [^{:tag (array TagSize byte)} buf (zero (array TagSize byte))]
            (copy (subslice buf) msg)
            (aset buf (len msg) 1)

            (set! (values h0 c) (bits/Add64 h0 (.Uint64 binary/LittleEndian (subslice buf 0 8)) 0))
            (set! (values h1 c) (bits/Add64 h1 (.Uint64 binary/LittleEndian (subslice buf 8 16)) c))
            (set! h2 + c)

            (set! msg nil)))


        ;; Multiplication of big number limbs is similar to elementary school
        ;; columnar multiplication. Instead of digits, there are 64-bit limbs.
        ;;
        ;; We are multiplying a 3 limbs number, h, by a 2 limbs number, r.
        ;;
        ;;                        h2    h1    h0  x
        ;;                              r1    r0  =
        ;;                       ----------------
        ;;                      h2r0  h1r0  h0r0     <-- individual 128-bit products
        ;;            +   h2r1  h1r1  h0r1
        ;;               ------------------------
        ;;                 m3    m2    m1    m0      <-- result in 128-bit overlapping limbs
        ;;               ------------------------
        ;;         m3.hi m2.hi m1.hi m0.hi           <-- carry propagation
        ;;     +         m3.lo m2.lo m1.lo m0.lo
        ;;        -------------------------------
        ;;           t4    t3    t2    t1    t0      <-- final result in 64-bit limbs
        ;;
        ;; The main difference from pen-and-paper multiplication is that we do
        ;; carry propagation in a separate step, as if we wrote two digit sums
        ;; at first (the 128-bit limbs), and then carried the tens all at once.

        (let [h0r0 (mul64 h0 r0)
            ^{:line 201} h1r0 (mul64 h1 r0)
            ^{:line 202} h2r0 (mul64 h2 r0)
            ^{:line 203} h0r1 (mul64 h0 r1)
            ^{:line 204} h1r1 (mul64 h1 r1)
            ^{:line 205} h2r1 (mul64 h2 r1)]


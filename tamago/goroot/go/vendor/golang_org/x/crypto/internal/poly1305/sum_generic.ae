              (set! (values h1 c) (bits/Add64 h1 (.-hi cc) c))
              (set! h2 + c)

              (set! cc (shiftRightBy2 cc))

              (set! (values h0 c) (bits/Add64 h0 (.-lo cc) 0))
              (set! (values h1 c) (bits/Add64 h1 (.-hi cc) c))
              (set! h2 + c))))))

    ;; h2 is at most 3 + 1 + 1 = 5, making the whole of h at most
    ;;
    ;;     5 * 2¹²⁸ + (2¹²⁸ - 1) = 6 * 2¹²⁸ - 1


    (set! (values (aget (.-h state) 0) (aget (.-h state) 1) (aget (.-h state) 2)) (values h0 h1 h2))))



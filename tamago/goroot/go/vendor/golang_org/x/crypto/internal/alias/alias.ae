;; Package alias implements memory aliasing tests.
(in-ns 'go.vendor.golang_org.x.crypto.internal.alias) (go/file "alias.go" :build ["//go:build !purego"] :doc "Package alias implements memory aliasing tests.\n" :imports [

    ^{:line 10} [unsafe "unsafe"]])



^{:go/end 18} (go/func AnyOverlap "AnyOverlap reports whether x and y share memory at any (not necessarily\ncorresponding) index. The memory beyond the slice length is ignored.\n" ^bool [^{:tag (slice byte)} x ^{:tag (slice byte)} y]
  (and (> (len x) 0) (> (len y) 0)
    (<= (conv uintptr (conv unsafe/Pointer (addr (aget x 0)))) (conv uintptr (conv unsafe/Pointer (addr (aget y (- (len y) 1))))))
    (<= (conv uintptr (conv unsafe/Pointer (addr (aget y 0)))) (conv uintptr (conv unsafe/Pointer (addr (aget x (- (len x) 1))))))))








^{:go/end 31} (go/func InexactOverlap "InexactOverlap reports whether x and y share memory at any non-corresponding\nindex. The memory beyond the slice length is ignored. Note that x and y can\nhave different lengths and still not have any inexact overlap.\n\nInexactOverlap can be used to implement the requirements of the crypto/cipher\nAEAD, Block, BlockMode and Stream interfaces.\n" ^bool [^{:tag (slice byte)} x ^{:tag (slice byte)} y]
  (when (or (== (len x) 0) (== (len y) 0) (== (addr (aget x 0)) (addr (aget y 0))))
    (return false))

  (AnyOverlap x y))

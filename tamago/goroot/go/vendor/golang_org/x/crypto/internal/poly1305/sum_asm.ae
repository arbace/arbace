(in-ns 'go.vendor.golang_org.x.crypto.internal.poly1305) (go/file "sum_asm.go" :build ["//go:build gc && !purego && (amd64 || loong64 || ppc64 || ppc64le)"] :imports [])


(go/func ^:extern ^:go/noescape update [^{:tag (* macState)} state ^{:tag (slice byte)} msg])






(go/type mac "mac is a wrapper for macGeneric that redirects calls that would have gone to\nupdateGeneric to update.\n\nIts Write and Sum methods are otherwise identical to the macGeneric ones, but\nusing function pointers would carry a major performance cost.\n" (struct macGeneric))

^{:go/end 39} (go/method Write [^{:tag (* mac)} h ^{:tag (slice byte)} p] :results [int error]
  (let [nn (len p)]
    (when (> ^{:go/via [macGeneric]} (.-offset h) 0)
      (let [n (copy (subslice ^{:go/via [macGeneric]} (.-buffer h) ^{:go/via [macGeneric]} (.-offset h)) p)]
        (when (< (+ ^{:go/via [macGeneric]} (.-offset h) n) TagSize)
          (set! ^{:go/via [macGeneric]} (.-offset h) + n)
          (return nn nil))

        (set! p (subslice p n))
        (set! ^{:go/via [macGeneric]} (.-offset h) 0)
        (update (addr ^{:go/via [macGeneric]} (.-macState h)) (subslice ^{:go/via [macGeneric]} (.-buffer h)))))

    (when [n (- (len p) (% (len p) TagSize))] (> n 0)
      (update (addr ^{:go/via [macGeneric]} (.-macState h)) (subslice p _ n))
      (set! p (subslice p n)))

    (when (> (len p) 0)
      (set! ^{:go/via [macGeneric]} (.-offset h) + (copy (subslice ^{:go/via [macGeneric]} (.-buffer h) ^{:go/via [macGeneric]} (.-offset h)) p)))

    (return nn nil)))


^{:go/end 47} (go/method Sum [^{:tag (* mac)} h ^{:tag (* (array 16 byte))} out]
  (let [state ^{:go/via [macGeneric]} (.-macState h)]
    (when (> ^{:go/via [macGeneric]} (.-offset h) 0)
      (update (addr state) (subslice ^{:go/via [macGeneric]} (.-buffer h) _ ^{:go/via [macGeneric]} (.-offset h))))

    (finalize out (addr (.-h state)) (addr (.-s state)))))

;; Package hkdf implements the HMAC-based Extract-and-Expand Key Derivation
;; Function (HKDF) as defined in RFC 5869.
;;
;; HKDF is a cryptographic key derivation function (KDF) with the goal of
;; expanding limited input keying material into one or more cryptographically
;; strong secret keys.
(in-ns 'go.vendor.golang_org.x.crypto.hkdf) (go/file "hkdf.go" :doc "Package hkdf implements the HMAC-based Extract-and-Expand Key Derivation\nFunction (HKDF) as defined in RFC 5869.\n\nHKDF is a cryptographic key derivation function (KDF) with the goal of\nexpanding limited input keying material into one or more cryptographically\nstrong secret keys.\n" :imports [


    ^{:line 14} [hkdf "crypto/hkdf"]
    ^{:line 15} [hmac "crypto/hmac"]
    ^{:line 16} [errors "errors"]
    ^{:line 17} [hash "hash"]
    ^{:line 18} [io "io"]])








^{:go/end 38} (go/func Extract "Extract generates a pseudorandom key for use with Expand from an input secret\nand an optional independent salt.\n\nOnly use this function if you need to reuse the extracted key with multiple\nExpand invocations and different context values. Most common scenarios,\nincluding the generation of multiple keys, should use New instead.\n" ^{:tag (slice byte)} [^{:tag (func [] [hash/Hash])} hash ^{:tag (slice byte)} secret ^{:tag (slice byte)} salt]
  ;; Use the stdlib Extract, which disables FIPS 140 enforcement of the HMAC
  ;; key (which in HKDF is the salt). The only possible error is FIPS 140
  ;; enforcement of the hash, which had to panic under this API anyway. We
  ;; don't use the stdlib Expand, because it switched to returning a []byte
  ;; instead of an io.Reader, and Expand uses the HMAC key as a key.
  (let [(values out err) (^{:inst [hash/Hash]} hkdf/Extract hash secret salt)]
    (when (!= err nil)
      (panic err))

    ^{:line 37} out))


(go/type hkdfReader (struct
    ^{:line 41 :tag hash/Hash} expander
    ^{:line 42 :tag int} size

    ^{:line 44 :tag (slice byte)} info
    ^{:line 45 :tag byte} counter

    ^{:line 47 :tag (slice byte)} prev
    ^{:line 48 :tag (slice byte)} buf))


^{:go/end 82} (go/method Read [^{:tag (* hkdfReader)} f ^{:tag (slice byte)} p] :results [int error]
  ;; Check whether enough data can be generated
  (let [need (len p)
      ^{:line 54} remains (+ (len (.-buf f)) (* (conv int (+ (- 255 (.-counter f)) 1)) (.-size f)))]
    (when (< remains need)
      (return 0 (errors/New "hkdf: entropy limit reached")))

    ;; Read any leftover from the buffer
    (let [n (copy p (.-buf f))]
      (set! p (subslice p n))

      ;; Fill the rest of the buffer
      (while (> (len p) 0)
        (when (> (.-counter f) 1)
          (.Reset (.-expander f)))

        (.Write (.-expander f) (.-prev f))
        (.Write (.-expander f) (.-info f))
        (.Write (.-expander f) (lit (slice byte) (.-counter f)))
        (set! (.-prev f) (.Sum (.-expander f) (subslice (.-prev f) _ 0)))
        (inc! (.-counter f))

        ;; Copy the new batch into p
        (set! (.-buf f) (.-prev f))
        (set! n (copy p (.-buf f)))
        (set! p (subslice p n)))

      ;; Save leftovers for next run
      (set! (.-buf f) (subslice (.-buf f) n))

      (return need nil))))








^{:go/end 93} (go/func Expand "Expand returns a Reader, from which keys can be read, using the given\npseudorandom key and optional context info, skipping the extraction step.\n\nThe pseudorandomKey should have been generated by Extract, or be a uniformly\nrandom or pseudorandom cryptographically strong key. See RFC 5869, Section\n3.3. Most common scenarios will want to use New instead.\n" ^io/Reader [^{:tag (func [] [hash/Hash])} hash ^{:tag (slice byte)} pseudorandomKey ^{:tag (slice byte)} info]
  (let [expander (hmac/New hash pseudorandomKey)]
    (addr (lit hkdfReader expander (.Size expander) info 1 nil nil))))




^{:go/end 100} (go/func New "New returns a Reader, from which keys can be read, using the given hash,\nsecret, salt and context info. Salt and info can be nil.\n" ^io/Reader [^{:tag (func [] [hash/Hash])} hash ^{:tag (slice byte)} secret ^{:tag (slice byte)} salt ^{:tag (slice byte)} info]
  (let [prk (Extract hash secret salt)]
    (Expand hash prk info)))

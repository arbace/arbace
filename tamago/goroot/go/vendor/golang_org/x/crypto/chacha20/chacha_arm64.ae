(in-ns 'go.vendor.golang_org.x.crypto.chacha20) (go/file "chacha_arm64.go" :build ["//go:build gc && !purego"] :imports [])

(go/const ^{:val 256} bufSize 256)


(go/func ^:extern ^:go/noescape xorKeyStreamVX [^{:tag (slice byte)} dst ^{:tag (slice byte)} src ^{:tag (* (array 8 uint32))} key ^{:tag (* (array 3 uint32))} nonce ^{:tag (* uint32)} counter])

^{:go/end 16} (go/method xorKeyStreamBlocks [^{:tag (* Cipher)} c ^{:tag (slice byte)} dst ^{:tag (slice byte)} src]
  (xorKeyStreamVX dst src (addr (.-key c)) (addr (.-nonce c)) (addr (.-counter c))))

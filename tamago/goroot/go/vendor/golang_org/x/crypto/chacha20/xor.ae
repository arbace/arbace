(in-ns 'go.vendor.golang_org.x.crypto.chacha20) (go/file "xor.go" :imports [

    ^{:line 7} [runtime "runtime"]])


(go/const ^{:val true :doc "Platforms that have fast unaligned 32-bit little endian accesses.\n"} unaligned (or (== runtime/GOARCH "386")
    (== runtime/GOARCH "amd64")
    (== runtime/GOARCH "arm64")
    (== runtime/GOARCH "ppc64le")
    (== runtime/GOARCH "s390x")))



^{:go/end 42} (go/func addXor "addXor reads a little endian uint32 from src, XORs it with (a + b) and\nplaces the result in little endian byte order in dst.\n" [^{:tag (slice byte)} dst ^{:tag (slice byte)} src ^uint32 a ^uint32 b]
  (set! (values _ _) (values (aget src 3) (aget dst 3))) ; bounds check elimination hint
  (if unaligned
    ;; The compiler should optimize this code into
    ;; 32-bit unaligned little endian loads and stores.
    ;; TODO: delete once the compiler does a reliably
    ;; good job with the generic code below.
    ;; See issue #25111 for more details.
    (let [v (conv uint32 (aget src 0))]
      (set! v bit-or (<< (conv uint32 (aget src 1)) 8))
      (set! v bit-or (<< (conv uint32 (aget src 2)) 16))
      (set! v bit-or (<< (conv uint32 (aget src 3)) 24))
      (set! v bit-xor (+ a b))
      (aset dst 0 (conv byte v))
      (aset dst 1 (conv byte (>> v 8)))
      (aset dst 2 (conv byte (>> v 16)))
      (aset dst 3 (conv byte (>> v 24))))
    (do
      (set! a + b)
      (aset dst 0 (bit-xor (aget src 0) (conv byte a)))
      (aset dst 1 (bit-xor (aget src 1) (conv byte (>> a 8))))
      (aset dst 2 (bit-xor (aget src 2) (conv byte (>> a 16))))
      (aset dst 3 (bit-xor (aget src 3) (conv byte (>> a 24)))))))

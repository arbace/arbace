(in-ns 'go.vendor.golang_org.x.crypto.chacha20) (go/file "chacha_noasm.go" :build ["//go:build (!arm64 && !s390x && !ppc64 && !ppc64le) || !gc || purego"] :imports [])

(go/const ^{:val 64} bufSize blockSize)

^{:go/end 13} (go/method xorKeyStreamBlocks [^{:tag (* Cipher)} s ^{:tag (slice byte)} dst ^{:tag (slice byte)} src]
  (.xorKeyStreamBlocksGeneric s dst src))

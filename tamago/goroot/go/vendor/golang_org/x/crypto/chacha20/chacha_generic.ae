^{:go/end 78} (go/func NewUnauthenticatedCipher "NewUnauthenticatedCipher creates a new ChaCha20 stream cipher with the given\n32 bytes key and a 12 or 24 bytes nonce. If a nonce of 24 bytes is provided,\nthe XChaCha20 construction will be used. It returns an error if key or nonce\nhave any other length.\n\nNote that ChaCha20, like all stream ciphers, is not authenticated and allows\nattackers to silently tamper with the plaintext. For this reason, it is more\nappropriate as a building block than as a standalone encryption mechanism.\nInstead, consider using package golang.org/x/crypto/chacha20poly1305.\n" [^{:tag (slice byte)} key ^{:tag (slice byte)} nonce] :results [(* Cipher) error]
  ;; This function is split into a wrapper so that the Cipher allocation will
  ;; be inlined, and depending on how the caller uses the return value, won't
  ;; escape to the heap.
  (let [c (addr (lit Cipher))]
    (newUnauthenticatedCipher c key nonce)))


^{:go/end 113} (go/func newUnauthenticatedCipher [^{:tag (* Cipher)} c ^{:tag (slice byte)} key ^{:tag (slice byte)} nonce] :results [(* Cipher) error]

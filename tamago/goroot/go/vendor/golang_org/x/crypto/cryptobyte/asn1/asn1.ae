;; Package asn1 contains supporting types for parsing and building ASN.1
;; messages with the cryptobyte package.
(in-ns 'go.vendor.golang_org.x.crypto.cryptobyte.asn1) (go/file "asn1.go" :doc "Package asn1 contains supporting types for parsing and building ASN.1\nmessages with the cryptobyte package.\n" :imports [])







(go/type Tag "Tag represents an ASN.1 identifier octet, consisting of a tag number\n(indicating a type) and class (such as context-specific or constructed).\n\nMethods in the cryptobyte package only support the low-tag-number form, i.e.\na single identifier octet with bits 7-8 encoding the class and bits 1-6\nencoding the tag number.\n" uint8)

(go/const
  ^{:line 18} [^{:val 32} classConstructed 0x20]
  ^{:line 19} [^{:val 128} classContextSpecific 0x80])



^{:go/end 23} (go/method Constructed "Constructed returns t with the constructed class bit set.\n" ^Tag [^Tag t] (bit-or t classConstructed))


^{:go/end 26} (go/method ContextSpecific "ContextSpecific returns t with the context-specific class bit set.\n" ^Tag [^Tag t] (bit-or t classContextSpecific))


(go/const "The following is a list of standard tag and class combinations.\n"
  ^{:line 30} [^{:val 1} BOOLEAN (conv Tag 1)]
  ^{:line 31} [^{:val 2} INTEGER (conv Tag 2)]
  ^{:line 32} [^{:val 3} BIT_STRING (conv Tag 3)]
  ^{:line 33} [^{:val 4} OCTET_STRING (conv Tag 4)]
  ^{:line 34} [^{:val 5} NULL (conv Tag 5)]
  ^{:line 35} [^{:val 6} OBJECT_IDENTIFIER (conv Tag 6)]
  ^{:line 36} [^{:val 10} ENUM (conv Tag 10)]
  ^{:line 37} [^{:val 12} UTF8String (conv Tag 12)]
  ^{:line 38} [^{:val 48} SEQUENCE (conv Tag (bit-or 16 classConstructed))]
  ^{:line 39} [^{:val 49} SET (conv Tag (bit-or 17 classConstructed))]
  ^{:line 40} [^{:val 19} PrintableString (conv Tag 19)]
  ^{:line 41} [^{:val 20} T61String (conv Tag 20)]
  ^{:line 42} [^{:val 22} IA5String (conv Tag 22)]
  ^{:line 43} [^{:val 23} UTCTime (conv Tag 23)]
  ^{:line 44} [^{:val 24} GeneralizedTime (conv Tag 24)]
  ^{:line 45} [^{:val 27} GeneralString (conv Tag 27)])

^{:go/end 185} (go/method callContinuation [^{:tag (* Builder)} b ^BuilderContinuation f ^{:tag (* Builder)} arg]
  (when (not @(.-inContinuation b))
    (set! @(.-inContinuation b) true)

    (defer (^{:go/end 181} (fn []

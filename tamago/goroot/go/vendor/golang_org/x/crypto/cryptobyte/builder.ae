^{:go/end 214} (go/method addLengthPrefixed [^{:tag (* Builder)} b ^int lenLen ^bool isASN1 ^BuilderContinuation f]
  ;; Subsequent writes can be ignored if the builder has encountered an error.
  (when (!= (.-err b) nil)
    (return))


  (let [offset (len (.-result b))]
    (.add b (spread (make (slice byte) lenLen)))

    (when (== (.-inContinuation b) nil)
      (set! (.-inContinuation b) (new bool)))


    (set! (.-child b) (addr ^{:go/breaks [2 4 6 8 10 12]} (lit Builder
          :result (.-result b)
          :fixedSize (.-fixedSize b)
          :offset offset
          :pendingLenLen lenLen
          :pendingIsASN1 isASN1
          :inContinuation (.-inContinuation b))))


    (.callContinuation b f (.-child b))
    (.flushChild b)
    (when (!= (.-child b) nil)
      (panic "cryptobyte: internal error"))))



^{:go/end 292} (go/method flushChild [^{:tag (* Builder)} b]
  (when (== (.-child b) nil)
    (return))

  (.flushChild (.-child b))
  (let [child (.-child b)]
    (set! (.-child b) nil)

    (when (!= (.-err child) nil)
      (set! (.-err b) (.-err child))
      (return))


    (let [length (- (len (.-result child)) (.-pendingLenLen child) (.-offset child))]

      (when (< length 0)
        (panic "cryptobyte: internal error")) ; result unexpectedly shrunk


      (when (.-pendingIsASN1 child)
        ;; For ASN.1, we reserved a single byte for the length. If that turned out
        ;; to be incorrect, we have to move the contents along in order to make
        ;; space.
        (when (!= (.-pendingLenLen child) 1)
          (panic "cryptobyte: internal error"))

        (let [(values ^uint8 lenLen ^uint8 lenByte) (zero uint8)]
          (cond (> (conv int64 length) 0xfffffffe) (do
              (set! (.-err b) (errors/New "pending ASN.1 child too long"))
              (return))
            (> length 0xffffff) (do
              (set! lenLen 5)
              (set! lenByte (bit-or 0x80 4)))
            (> length 0xffff) (do
              (set! lenLen 4)
              (set! lenByte (bit-or 0x80 3)))
            (> length 0xff) (do
              (set! lenLen 3)
              (set! lenByte (bit-or 0x80 2)))
            (> length 0x7f) (do
              (set! lenLen 2)
              (set! lenByte (bit-or 0x80 1))) :else
            (do
              (set! lenLen 1)
              (set! lenByte (conv uint8 length))
              (set! length 0)))


          ;; Insert the initial length byte, make space for successive length bytes,
          ;; and adjust the offset.
          (aset (.-result child) (.-offset child) lenByte)
          (let [extraBytes (conv int (- lenLen 1))]
            (when (!= extraBytes 0)
              (.add child (spread (make (slice byte) extraBytes)))
              (let [childStart (+ (.-offset child) (.-pendingLenLen child))]
                (copy (subslice (.-result child) (+ childStart extraBytes)) (subslice (.-result child) childStart))))

            (inc! (.-offset child))
            (set! (.-pendingLenLen child) extraBytes))))


      (let [l length]
        (for [i (- (.-pendingLenLen child) 1)] (>= i 0) (dec! i)
          (aset (.-result child) (+ (.-offset child) i) (conv uint8 l))
          (set! l >> 8))

        (when (!= l 0)
          (set! (.-err b) (fmt/Errorf "cryptobyte: pending child length %d exceeds %d-byte length prefix" length (.-pendingLenLen child)))
          (return))


        (when (and (.-fixedSize b) (!= (addr (aget (.-result b) 0)) (addr (aget (.-result child) 0))))
          (panic "cryptobyte: BuilderContinuation reallocated a fixed-size buffer"))


        (set! (.-result b) (.-result child))))))


^{:go/end 309} (go/method add [^{:tag (* Builder)} b & ^{:tag (slice byte)} bytes]
  (when (!= (.-err b) nil)
    (return))

  (when (!= (.-child b) nil)
    (panic "cryptobyte: attempted write while child is pending"))

  (when (< (+ (len (.-result b)) (len bytes)) (len bytes))
    (set! (.-err b) (errors/New "cryptobyte: length overflow")))

  (when (and (.-fixedSize b) (> (+ (len (.-result b)) (len bytes)) (cap (.-result b))))
    (set! (.-err b) (errors/New "cryptobyte: Builder is exceeding its fixed-size buffer"))
    (return))

  (set! (.-result b) (append (.-result b) (spread bytes))))





^{:go/end 332} (go/method Unwrite "Unwrite rolls back non-negative n bytes written directly to the Builder.\nAn attempt by a child builder passed to a continuation to unwrite bytes\nfrom its parent will panic.\n" [^{:tag (* Builder)} b ^int n]
  (when (!= (.-err b) nil)
    (return))

  (when (!= (.-child b) nil)
    (panic "cryptobyte: attempted unwrite while child is pending"))

  (let [length (- (len (.-result b)) (.-pendingLenLen b) (.-offset b))]
    (when (< length 0)
      (panic "cryptobyte: internal error"))

    (when (< n 0)
      (panic "cryptobyte: attempted to unwrite negative number of bytes"))

    (when (> n length)
      (panic "cryptobyte: attempted to unwrite more than was written"))

    (set! (.-result b) (subslice (.-result b) _ (- (len (.-result b)) n)))))



(go/type MarshalingValue "A MarshalingValue marshals itself into a Builder.\n" (interface



    (^{:doc "Marshal is called by Builder.AddValue. It receives a pointer to a builder\nto marshal itself into. It may return an error that occurred during\nmarshaling, such as unset or invalid values.\n"} Marshal ^error [^{:tag (* Builder)} b])))





^{:go/end 350} (go/method AddValue "AddValue calls Marshal on v, passing a pointer to the builder to append to.\nIf Marshal returns an error, it is set on the Builder so that subsequent\nappends don't have an effect.\n" [^{:tag (* Builder)} b ^MarshalingValue v]

;; Package cryptobyte contains types that help with parsing and constructing
;; length-prefixed, binary messages, including ASN.1 DER. (The asn1 subpackage
;; contains useful ASN.1 constants.)
;;
;; The String type is for parsing. It wraps a []byte slice and provides helper
;; functions for consuming structures, value by value.
;;
;; The Builder type is for constructing messages. It providers helper functions
;; for appending values and also for appending length-prefixed submessages –
;; without having to worry about calculating the length prefix ahead of time.
;;
;; See the documentation and examples for the Builder and String types to get
;; started.
(in-ns 'go.vendor.golang_org.x.crypto.cryptobyte) (go/file "string.go" :doc "Package cryptobyte contains types that help with parsing and constructing\nlength-prefixed, binary messages, including ASN.1 DER. (The asn1 subpackage\ncontains useful ASN.1 constants.)\n\nThe String type is for parsing. It wraps a []byte slice and provides helper\nfunctions for consuming structures, value by value.\n\nThe Builder type is for constructing messages. It providers helper functions\nfor appending values and also for appending length-prefixed submessages –\nwithout having to worry about calculating the length prefix ahead of time.\n\nSee the documentation and examples for the Builder and String types to get\nstarted.\n" :imports [])



(go/type String "String represents a string of bytes. It provides methods for parsing\nfixed-length and length-prefixed values from it.\n" (slice byte))



^{:go/end 33} (go/method read "read advances a String by n bytes and returns them. If less than n bytes\nremain, it returns nil.\n" ^{:tag (slice byte)} [^{:tag (* String)} s ^int n]
  (when (or (< (len @s) n) (< n 0))
    (return nil))

  (let [v (subslice @s _ n)]
    (set! @s (subslice @s n))
    ^{:line 32} v))



^{:go/end 38} (go/method Skip "Skip advances the String by n byte and reports whether it was successful.\n" ^bool [^{:tag (* String)} s ^int n]
  (!= (.read s n) nil))




^{:go/end 49} (go/method ReadUint8 "ReadUint8 decodes an 8-bit value into out and advances over it.\nIt reports whether the read was successful.\n" ^bool [^{:tag (* String)} s ^{:tag (* uint8)} out]
  ^{:go/breaks [4]} (let [v (.read s 1)]
    (when (== v nil)
      (return false))

    (set! @out (conv uint8 (aget v 0)))
    true))




^{:go/end 60} (go/method ReadUint16 "ReadUint16 decodes a big-endian, 16-bit value into out and advances over it.\nIt reports whether the read was successful.\n" ^bool [^{:tag (* String)} s ^{:tag (* uint16)} out]
  ^{:go/breaks [4]} (let [v (.read s 2)]
    (when (== v nil)
      (return false))

    (set! @out (bit-or (<< (conv uint16 (aget v 0)) 8) (conv uint16 (aget v 1))))
    true))




^{:go/end 71} (go/method ReadUint24 "ReadUint24 decodes a big-endian, 24-bit value into out and advances over it.\nIt reports whether the read was successful.\n" ^bool [^{:tag (* String)} s ^{:tag (* uint32)} out]
  ^{:go/breaks [4]} (let [v (.read s 3)]
    (when (== v nil)
      (return false))

    (set! @out (bit-or (<< (conv uint32 (aget v 0)) 16) (<< (conv uint32 (aget v 1)) 8) (conv uint32 (aget v 2))))
    true))




^{:go/end 82} (go/method ReadUint32 "ReadUint32 decodes a big-endian, 32-bit value into out and advances over it.\nIt reports whether the read was successful.\n" ^bool [^{:tag (* String)} s ^{:tag (* uint32)} out]
  ^{:go/breaks [4]} (let [v (.read s 4)]
    (when (== v nil)
      (return false))

    (set! @out (bit-or (<< (conv uint32 (aget v 0)) 24) (<< (conv uint32 (aget v 1)) 16) (<< (conv uint32 (aget v 2)) 8) (conv uint32 (aget v 3))))
    true))




^{:go/end 93} (go/method ReadUint48 "ReadUint48 decodes a big-endian, 48-bit value into out and advances over it.\nIt reports whether the read was successful.\n" ^bool [^{:tag (* String)} s ^{:tag (* uint64)} out]
  ^{:go/breaks [4]} (let [v (.read s 6)]
    (when (== v nil)
      (return false))

    (set! @out (bit-or (<< (conv uint64 (aget v 0)) 40) (<< (conv uint64 (aget v 1)) 32) (<< (conv uint64 (aget v 2)) 24) (<< (conv uint64 (aget v 3)) 16) (<< (conv uint64 (aget v 4)) 8) (conv uint64 (aget v 5))))
    true))




^{:go/end 104} (go/method ReadUint64 "ReadUint64 decodes a big-endian, 64-bit value into out and advances over it.\nIt reports whether the read was successful.\n" ^bool [^{:tag (* String)} s ^{:tag (* uint64)} out]
  ^{:go/breaks [4]} (let [v (.read s 8)]
    (when (== v nil)
      (return false))

    (set! @out (bit-or (<< (conv uint64 (aget v 0)) 56) (<< (conv uint64 (aget v 1)) 48) (<< (conv uint64 (aget v 2)) 40) (<< (conv uint64 (aget v 3)) 32) (<< (conv uint64 (aget v 4)) 24) (<< (conv uint64 (aget v 5)) 16) (<< (conv uint64 (aget v 6)) 8) (conv uint64 (aget v 7))))
    true))


^{:go/end 118} (go/method readUnsigned ^bool [^{:tag (* String)} s ^{:tag (* uint32)} out ^int length]
  (let [v (.read s length)]
    (when (== v nil)
      (return false))

    ^{:go/breaks [4]} (let [^uint32 result (zero uint32)]
      (for [i 0] (< i length) (inc! i)
        (set! result << 8)
        (set! result bit-or (conv uint32 (aget v i))))

      (set! @out result)
      true)))


^{:go/end 136} (go/method readLengthPrefixed ^bool [^{:tag (* String)} s ^int lenLen ^{:tag (* String)} outChild]
  (let [lenBytes (.read s lenLen)]
    (when (== lenBytes nil)
      (return false))

    (let [^uint32 length (zero uint32)]
      (range [_ b lenBytes]
        (set! length (<< length 8))
        (set! length (bit-or length (conv uint32 b))))

      ^{:go/breaks [4]} (let [v (.read s (conv int length))]
        (when (== v nil)
          (return false))

        (set! @outChild v)
        true))))




^{:go/end 142} (go/method ReadUint8LengthPrefixed "ReadUint8LengthPrefixed reads the content of an 8-bit length-prefixed value\ninto out and advances over it. It reports whether the read was successful.\n" ^bool [^{:tag (* String)} s ^{:tag (* String)} out]
  (.readLengthPrefixed s 1 out))





^{:go/end 149} (go/method ReadUint16LengthPrefixed "ReadUint16LengthPrefixed reads the content of a big-endian, 16-bit\nlength-prefixed value into out and advances over it. It reports whether the\nread was successful.\n" ^bool [^{:tag (* String)} s ^{:tag (* String)} out]
  (.readLengthPrefixed s 2 out))





^{:go/end 156} (go/method ReadUint24LengthPrefixed "ReadUint24LengthPrefixed reads the content of a big-endian, 24-bit\nlength-prefixed value into out and advances over it. It reports whether\nthe read was successful.\n" ^bool [^{:tag (* String)} s ^{:tag (* String)} out]
  (.readLengthPrefixed s 3 out))




^{:go/end 167} (go/method ReadBytes "ReadBytes reads n bytes into out and advances over them. It reports\nwhether the read was successful.\n" ^bool [^{:tag (* String)} s ^{:tag (* (slice byte))} out ^int n]
  ^{:go/breaks [4]} (let [v (.read s n)]
    (when (== v nil)
      (return false))

    (set! @out v)
    true))




^{:go/end 178} (go/method CopyBytes "CopyBytes copies len(out) bytes into out and advances over them. It reports\nwhether the copy operation was successful\n" ^bool [^{:tag (* String)} s ^{:tag (slice byte)} out]
  (let [n (len out)
      ^{:line 173} v (.read s n)]
    (when (== v nil)
      (return false))

    (== (copy out v) n)))



^{:go/end 183} (go/method Empty "Empty reports whether the string does not contain any bytes.\n" ^bool [^String s]
  (== (len s) 0))

^{:go/end 87} (go/method openGeneric [^{:tag (* chacha20poly1305)} c ^{:tag (slice byte)} dst ^{:tag (slice byte)} nonce ^{:tag (slice byte)} ciphertext ^{:tag (slice byte)} additionalData] :results [(slice byte) error]

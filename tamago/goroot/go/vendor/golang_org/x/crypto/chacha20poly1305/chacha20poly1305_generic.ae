^{:go/end 22} (go/func writeWithPadding [^{:tag (* poly1305/MAC)} p ^{:tag (slice byte)} b]
  (.Write p b)
  (when [rem (% (len b) 16)] (!= rem 0)
    (let [^{:tag (array 16 byte)} buf (zero (array 16 byte))
        ^{:line 19} padLen (- 16 rem)]
      (.Write p (subslice buf _ padLen)))))



^{:go/end 28} (go/func writeUint64 [^{:tag (* poly1305/MAC)} p ^int n]

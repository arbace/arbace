(ns go.mime
  (:require [arbace.go :as go]))

(go/package mime
  :path "mime"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["encodedword.go" "grammar.go" "mediatype.go" "type.go" "type_unix.go"]
  :init-order [errInvalidWord maxBase64Len errNoMediaType errNoSlashAfterFirstToken errNoTokenAfterSlash errUnexpectedContentAfterMediaSubtype ErrInvalidMediaParameter errDuplicateParamName builtinTypesLower mimeGlobs typeFiles]
  :positions :lines)

(load "mime/encodedword")
(load "mime/grammar")
(load "mime/mediatype")
(load "mime/type")
(load "mime/type_unix")

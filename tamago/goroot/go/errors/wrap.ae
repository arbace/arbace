          (return false)))

      (case [(interface (Unwrap ^{:tag (slice error)} []))]
        (range [_ err (.Unwrap x)]
          (when (== err nil)
            (continue))

          (when (as err target targetVal targetType)
            (return true)))


        (return false))
      (default

(in-ns 'go.structs) (go/file "hostlayout.go" :imports [])











(go/type HostLayout "HostLayout marks a struct as using host memory layout. A struct with a\nfield of type HostLayout will be laid out in memory according to host\nexpectations, generally following the host's C ABI.\n\nHostLayout does not affect layout within any other struct-typed fields\nof the containing struct, nor does it affect layout of structs\ncontaining the struct marked as host layout.\n\nBy convention, HostLayout should be used as the type of a field\nnamed \"_\", placed at the beginning of the struct type definition.\n" (struct
    ^{:line 18 :tag hostLayout} _)) ; prevent accidental conversion with plain struct{}










(go/type hostLayout "We use an unexported type within the exported type to give the marker\ntype itself, rather than merely its name, a recognizable identity in\nthe type system. The main consequence of this is that a user can give\nthe type a new name and it will still have the same properties, e.g.,\n\n\ttype HL structs.HostLayout\n\nIt also prevents unintentional conversion of struct{} to a named marker type.\n" (struct))

(ns go.unicode
  (:require [arbace.go :as go]))

(go/package unicode
  :path "unicode"
  :files ["casetables.go" "digit.go" "graphic.go" "letter.go" "tables.go"]
  :positions :lines)

(load "unicode/casetables")
(load "unicode/digit")
(load "unicode/graphic")
(load "unicode/letter")
(load "unicode/tables")

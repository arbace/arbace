(go/func ^:extern runtime_Semacquire "Semacquire waits until *s > 0 and then atomically decrements it.\nIt is intended as a simple sleep primitive for use by the synchronization\nlibrary and should not be used directly.\n" [^{:tag (* uint32)} s])


(go/func ^:extern runtime_SemacquireWaitGroup "SemacquireWaitGroup is like Semacquire, but for WaitGroup.Wait.\n" [^{:tag (* uint32)} s ^bool synctestDurable])









(go/func ^:extern runtime_SemacquireRWMutexR "Semacquire(RW)Mutex(R) is like Semacquire, but for profiling contended\nMutexes and RWMutexes.\nIf lifo is true, queue waiter at the head of wait queue.\nskipframes is the number of frames to omit during tracing, counting from\nruntime_SemacquireMutex's caller.\nThe different forms of this function just tell the runtime how to present\nthe reason for waiting in a backtrace, and is used to compute some metrics.\nOtherwise they're functionally identical.\n" [^{:tag (* uint32)} s ^bool lifo ^int skipframes])
(go/func ^:extern runtime_SemacquireRWMutex [^{:tag (* uint32)} s ^bool lifo ^int skipframes])








(go/func ^:extern runtime_Semrelease "Semrelease atomically increments *s and notifies a waiting goroutine\nif one is blocked in Semacquire.\nIt is intended as a simple wakeup primitive for use by the synchronization\nlibrary and should not be used directly.\nIf handoff is true, pass count directly to the first waiter.\nskipframes is the number of frames to omit during tracing, counting from\nruntime_Semrelease's caller.\n" [^{:tag (* uint32)} s ^bool handoff ^int skipframes])



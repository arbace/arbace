(go/type poolDequeue "poolDequeue is a lock-free fixed-size single-producer,\nmulti-consumer queue. The single producer can both push and pop\nfrom the head, and consumers can pop from the tail.\n\nIt has the added feature that it nils out unused slots to avoid\nunnecessary retention of objects. This is important for sync.Pool,\nbut not typically a property considered in the literature.\n" (struct














    ^{:line 34 :tag atomic/Uint64 :doc "headTail packs together a 32-bit head index and a 32-bit\ntail index. Both are indexes into vals modulo len(vals)-1.\n\ntail = index of oldest data in queue\nhead = index of next slot to fill\n\nSlots in the range [tail, head) are owned by consumers.\nA consumer continues to own a slot outside this range until\nit nils the slot, at which point ownership passes to the\nproducer.\n\nThe head index is stored in the most-significant bits so\nthat we can atomically add to it and the overflow is\nharmless.\n"} headTail









    ^{:line 44 :tag (slice eface) :doc "vals is a ring buffer of interface{} values stored in this\ndequeue. The size of this must be a power of 2.\n\nvals[i].typ is nil if the slot is empty and non-nil\notherwise. A slot is still in use until *both* the tail\nindex has moved beyond it and typ has been set to nil. This\nis set to nil atomically by the consumer and read\natomically by the producer.\n"} vals))


(go/type eface (struct
    ^{:line 48 :tag unsafe/Pointer} typ ^unsafe/Pointer val))


(go/const ^{:val 32} dequeueBits 32)






(go/const ^{:val 1073741824 :doc "dequeueLimit is the maximum size of a poolDequeue.\n\nThis must be at most (1<<dequeueBits)/2 because detecting fullness\ndepends on wrapping around the ring buffer without wrapping around\nthe index. We divide by 4 so this fits in an int on 32-bit.\n"} dequeueLimit (/ (<< 1 dequeueBits) 4))




(go/type dequeueNil "dequeueNil is used in poolDequeue to represent interface{}(nil).\nSince we use nil to represent empty slots, we need a sentinel value\nto represent nil.\n" (* (struct)))

^{:go/end 70} (go/method unpack [^{:tag (* poolDequeue)} d ^uint64 ptrs] :results [^uint32 head ^uint32 tail]
  (let [^:const ^{:val 4294967295} mask (- (<< 1 dequeueBits) 1)]
    (set! head (conv uint32 (bit-and (>> ptrs dequeueBits) mask)))
    (set! tail (conv uint32 (bit-and ptrs mask)))
    (return)))


^{:go/end 76} (go/method pack ^uint64 [^{:tag (* poolDequeue)} d ^uint32 head ^uint32 tail]
  (let [^:const ^{:val 4294967295} mask (- (<< 1 dequeueBits) 1)]
    (bit-or (<< (conv uint64 head) dequeueBits)
      (conv uint64 (bit-and tail mask)))))




^{:go/end 107} (go/method pushHead "pushHead adds val at the head of the queue. It returns false if the\nqueue is full. It must only be called by a single producer.\n" ^bool [^{:tag (* poolDequeue)} d ^any val]
  (let [ptrs (.Load (.-headTail d))
      (values head tail) (.unpack d ptrs)]
    (when (== (bit-and (+ tail (conv uint32 (len (.-vals d)))) (- (<< 1 dequeueBits) 1)) head)
      ;; Queue is full.
      (return false))

    ^{:go/breaks [6]} (let [slot (addr (aget (.-vals d) (bit-and head (conv uint32 (- (len (.-vals d)) 1)))))

        ;; Check if the head slot has been released by popTail.
        ^{:line 90} typ (atomic/LoadPointer (addr (.-typ slot)))]
      (when (!= typ nil)
        ;; Another goroutine is still cleaning up the tail, so
        ;; the queue is actually still full.
        (return false))


      ;; The head slot is free, so we own it.
      (when (== val nil)
        (set! val (conv dequeueNil nil)))

      (set! @(conv (* any) (conv unsafe/Pointer slot)) val)

      ;; Increment head. This passes ownership of slot to popTail
      ;; and acts as a store barrier for writing the slot.
      (.Add (.-headTail d) (<< 1 dequeueBits))

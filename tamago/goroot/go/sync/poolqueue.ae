^{:go/end 142} (go/method popHead "popHead removes and returns the element at the head of the queue.\nIt returns false if the queue is empty. It must only be called by a\nsingle producer.\n" [^{:tag (* poolDequeue)} d] :results [any bool]
  (let [^{:tag (* eface)} slot (zero (* eface))]
    (while true
      (let [ptrs (.Load (.-headTail d))
          (values head tail) (.unpack d ptrs)]
        (when (== tail head)
          ;; Queue is empty.
          (return nil false))


        ;; Confirm tail and decrement head. We do this before
        ;; reading the value to take back ownership of this
        ;; slot.
        (dec! head)
        (let [ptrs2 (.pack d head tail)]
          (when (.CompareAndSwap (.-headTail d) ptrs ptrs2)
            ;; We successfully took back slot.
            (set! slot (addr (aget (.-vals d) (bit-and head (conv uint32 (- (len (.-vals d)) 1))))))
            (break)))))



    (let [val @(conv (* any) (conv unsafe/Pointer slot))]
      (when (== val (conv dequeueNil nil))

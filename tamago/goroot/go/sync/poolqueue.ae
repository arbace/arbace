^{:go/end 185} (go/method popTail "popTail removes and returns the element at the tail of the queue.\nIt returns false if the queue is empty. It may be called by any\nnumber of consumers.\n" [^{:tag (* poolDequeue)} d] :results [any bool]
  (let [^{:tag (* eface)} slot (zero (* eface))]
    (while true
      (let [ptrs (.Load (.-headTail d))
          (values head tail) (.unpack d ptrs)]
        (when (== tail head)
          ;; Queue is empty.
          (return nil false))


        ;; Confirm head and tail (for our speculative check
        ;; above) and increment tail. If this succeeds, then
        ;; we own the slot at tail.
        (let [ptrs2 (.pack d head (+ tail 1))]
          (when (.CompareAndSwap (.-headTail d) ptrs ptrs2)
            ;; Success.
            (set! slot (addr (aget (.-vals d) (bit-and tail (conv uint32 (- (len (.-vals d)) 1))))))
            (break)))))



    ;; We now own slot.
    (let [val @(conv (* any) (conv unsafe/Pointer slot))]
      (when (== val (conv dequeueNil nil))
        (set! val nil))


      ;; Tell pushHead that we're done with this slot. Zeroing the
      ;; slot is also important so we don't leave behind references
      ;; that could keep this object live longer than necessary.
      ;;
      ;; We write to val first and then publish that we're done with
      ;; this slot by atomically writing to typ.
      (set! (.-val slot) nil)
      (atomic/StorePointer (addr (.-typ slot)) nil)
      ;; At this point pushHead owns the slot.

      (return val true))))









(go/type poolChain "poolChain is a dynamically-sized version of poolDequeue.\n\nThis is implemented as a doubly-linked list queue of poolDequeues\nwhere each dequeue is double the size of the previous one. Once a\ndequeue fills up, this allocates a new one and only ever pushes to\nthe latest dequeue. Pops happen from the other end of the list and\nonce a dequeue is exhausted, it gets removed from the list.\n" (struct


    ^{:line 197 :tag (* poolChainElt) :doc "head is the poolDequeue to push to. This is only accessed\nby the producer, so doesn't need to be synchronized.\n"} head



    ^{:line 201 :tag (atomic/Pointer poolChainElt) :doc "tail is the poolDequeue to popTail from. This is accessed\nby consumers, so reads and writes must be atomic.\n"} tail))


(go/type poolChainElt (struct
    ^{:line 205} poolDequeue











    ^{:line 217 :tag (atomic/Pointer poolChainElt) :doc "next and prev link to the adjacent poolChainElts in this\npoolChain.\n\nnext is written atomically by the producer and read\natomically by the consumer. It only transitions from nil to\nnon-nil.\n\nprev is written atomically by the consumer and read\natomically by the producer. It only transitions from\nnon-nil to nil.\n"} next ^{:tag (atomic/Pointer poolChainElt) :doc "next and prev link to the adjacent poolChainElts in this\npoolChain.\n\nnext is written atomically by the producer and read\natomically by the consumer. It only transitions from nil to\nnon-nil.\n\nprev is written atomically by the consumer and read\natomically by the producer. It only transitions from\nnon-nil to nil.\n"} prev))


^{:go/end 249} (go/method pushHead [^{:tag (* poolChain)} c ^any val]
  (let [d (.-head c)]
    (when (== d nil)
      ;; Initialize the chain.
      (let [^:const ^{:val 8} initSize 8] ; Must be a power of 2
        (set! d (new poolChainElt))
        (set! ^{:go/via [poolDequeue]} (.-vals d) (make (slice eface) initSize))
        (set! (.-head c) d)
        (.Store (.-tail c) d)))


    (when ^{:go/via [poolDequeue]} (.pushHead d val)
      (return))


    ;; The current dequeue is full. Allocate a new one of twice
    ;; the size.
    (let [newSize (* (len ^{:go/via [poolDequeue]} (.-vals d)) 2)]
      (when (>= newSize dequeueLimit)
        ;; Can't make it any bigger.
        (set! newSize dequeueLimit))


      (let [d2 (addr (lit poolChainElt))]
        (.Store (.-prev d2) d)
        (set! ^{:go/via [poolDequeue]} (.-vals d2) (make (slice eface) newSize))
        (set! (.-head c) d2)
        (.Store (.-next d) d2)
        ^{:go/via [poolDequeue]} (.pushHead d2 val)))))


^{:go/end 262} (go/method popHead [^{:tag (* poolChain)} c] :results [any bool]
  (let [d (.-head c)]
    (while (!= d nil)
      (when [(values val ok) ^{:go/via [poolDequeue]} (.popHead d)] ok
        (return val ok))

      ;; There may still be unconsumed elements in the
      ;; previous dequeue, so try backing up.
      (set! d (.Load (.-prev d))))

    (return nil false)))


^{:go/end 302} (go/method popTail [^{:tag (* poolChain)} c] :results [any bool]
  (let [d (.Load (.-tail c))]
    (when (== d nil)
      (return nil false))


    (while true
      ;; It's important that we load the next pointer
      ;; *before* popping the tail. In general, d may be
      ;; transiently empty, but if next is non-nil before
      ;; the pop and the pop fails, then d is permanently
      ;; empty, which is the only condition under which it's
      ;; safe to drop d from the chain.

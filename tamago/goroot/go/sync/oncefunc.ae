(in-ns 'go.sync) (go/file "oncefunc.go" :imports [])





^{:go/end 40} (go/func OnceFunc "OnceFunc returns a function that invokes f only once. The returned function\nmay be called concurrently.\n\nIf f panics, the returned function will panic with the same value on every call.\n" ^{:tag (func [])} [^{:tag (func [])} f]
  ;; Use a struct so that there's a single heap allocation.
  (let [d ^{:go/breaks [[2 19]]} (lit (struct
          ^{:line 14 :tag (func [])} f
          ^{:line 15 :tag Once} once
          ^{:line 16 :tag bool} valid
          ^{:line 17 :tag any} p)

        :f f)]

    ^{:go/end 39} (fn []
      (.Do (.-once d) ^{:go/end 35} (fn []
          (defer (^{:go/end 32} (fn []
                (set! (.-f d) nil) ; Do not keep f alive after invoking it.
                (set! (.-p d) (recover))
                (when (not (.-valid d))
                  ;; Re-panic immediately so on the first
                  ;; call the user gets a complete stack
                  ;; trace into f.
                  (panic (.-p d))))))


          ((.-f d))
          (set! (.-valid d) true))) ; Set only if f does not panic.

      (when (not (.-valid d))
        (panic (.-p d))))))








^{:go/end 74} (go/func OnceValue "OnceValue returns a function that invokes f only once and returns the value\nreturned by f. The returned function may be called concurrently.\n\nIf f panics, the returned function will panic with the same value on every call.\n" :type-params [T] ^{:tag (func [] [T])} [^{:tag (func [] [T])} f]
  ;; Use a struct so that there's a single heap allocation.
  (let [d ^{:go/breaks [[2 55]]} (lit (struct
          ^{:line 49 :tag (func [] [T])} f
          ^{:line 50 :tag Once} once
          ^{:line 51 :tag bool} valid
          ^{:line 52 :tag any} p
          ^{:line 53 :tag T} result)

        :f f)]

    ^{:go/end 73} (fn ^T []
      (.Do (.-once d) ^{:go/end 68} (fn []
          (defer (^{:go/end 65} (fn []
                (set! (.-f d) nil)
                (set! (.-p d) (recover))
                (when (not (.-valid d))
                  (panic (.-p d))))))


          (set! (.-result d) ((.-f d)))
          (set! (.-valid d) true)))

      (when (not (.-valid d))
        (panic (.-p d)))

      (.-result d))))







^{:go/end 109} (go/func OnceValues "OnceValues returns a function that invokes f only once and returns the values\nreturned by f. The returned function may be called concurrently.\n\nIf f panics, the returned function will panic with the same value on every call.\n" :type-params [T1 ^:go/grouped T2] ^{:tag (func [] [T1 T2])} [^{:tag (func [] [T1 T2])} f]
  ;; Use a struct so that there's a single heap allocation.
  (let [d ^{:go/breaks [[2 90]]} (lit (struct
          ^{:line 83 :tag (func [] [T1 T2])} f
          ^{:line 84 :tag Once} once
          ^{:line 85 :tag bool} valid
          ^{:line 86 :tag any} p
          ^{:line 87 :tag T1} r1
          ^{:line 88 :tag T2} r2)

        :f f)]

    ^{:go/end 108} (fn [] :results [T1 T2]
      (.Do (.-once d) ^{:go/end 103} (fn []
          (defer (^{:go/end 100} (fn []
                (set! (.-f d) nil)
                (set! (.-p d) (recover))
                (when (not (.-valid d))
                  (panic (.-p d))))))


          (set! (values (.-r1 d) (.-r2 d)) ((.-f d)))
          (set! (.-valid d) true)))

      (when (not (.-valid d))
        (panic (.-p d)))

      (return (.-r1 d) (.-r2 d)))))

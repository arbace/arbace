;; Package atomic provides low-level atomic memory primitives
;; useful for implementing synchronization algorithms.
;;
;; These functions require great care to be used correctly.
;; Except for special, low-level applications, synchronization is better
;; done with channels or the facilities of the [sync] package.
;; Share memory by communicating;
;; don't communicate by sharing memory.
;;
;; The swap operation, implemented by the SwapT functions, is the atomic
;; equivalent of:
;;
;;	old = *addr
;;	*addr = new
;;	return old
;;
;; The compare-and-swap operation, implemented by the CompareAndSwapT
;; functions, is the atomic equivalent of:
;;
;;	if *addr == old {
;;		*addr = new
;;		return true
;;	}
;;	return false
;;
;; The add operation, implemented by the AddT functions, is the atomic
;; equivalent of:
;;
;;	*addr += delta
;;	return *addr
;;
;; The load and store operations, implemented by the LoadT and StoreT
;; functions, are the atomic equivalents of "return *addr" and
;; "*addr = val".
;;
;; In the terminology of [the Go memory model], if the effect of
;; an atomic operation A is observed by atomic operation B,
;; then A “synchronizes before” B.
;; Additionally, all the atomic operations executed in a program
;; behave as though executed in some sequentially consistent order.
;; This definition provides the same semantics as
;; C++'s sequentially consistent atomics and Java's volatile variables.
;;
;; Only a few integer sizes are supported: on many architectures,
;; atomic operations on non-word-sized integers are inefficient or
;; infeasible. For example, a [Bool] may be larger than a built-in bool.
;;
;; [the Go memory model]: https://go.dev/ref/mem
(in-ns 'go.sync.atomic) (go/file "doc.go" :doc "Package atomic provides low-level atomic memory primitives\nuseful for implementing synchronization algorithms.\n\nThese functions require great care to be used correctly.\nExcept for special, low-level applications, synchronization is better\ndone with channels or the facilities of the [sync] package.\nShare memory by communicating;\ndon't communicate by sharing memory.\n\nThe swap operation, implemented by the SwapT functions, is the atomic\nequivalent of:\n\n\told = *addr\n\t*addr = new\n\treturn old\n\nThe compare-and-swap operation, implemented by the CompareAndSwapT\nfunctions, is the atomic equivalent of:\n\n\tif *addr == old {\n\t\t*addr = new\n\t\treturn true\n\t}\n\treturn false\n\nThe add operation, implemented by the AddT functions, is the atomic\nequivalent of:\n\n\t*addr += delta\n\treturn *addr\n\nThe load and store operations, implemented by the LoadT and StoreT\nfunctions, are the atomic equivalents of \"return *addr\" and\n\"*addr = val\".\n\nIn the terminology of [the Go memory model], if the effect of\nan atomic operation A is observed by atomic operation B,\nthen A “synchronizes before” B.\nAdditionally, all the atomic operations executed in a program\nbehave as though executed in some sequentially consistent order.\nThis definition provides the same semantics as\nC++'s sequentially consistent atomics and Java's volatile variables.\n\nOnly a few integer sizes are supported: on many architectures,\natomic operations on non-word-sized integers are inefficient or\ninfeasible. For example, a [Bool] may be larger than a built-in bool.\n\n[the Go memory model]: https://go.dev/ref/mem\n" :imports [


    ^{:line 56} [unsafe "unsafe"]])


;; BUG(rsc): On 386, the 64-bit functions use instructions unavailable before the Pentium MMX.
;;
;; On non-Linux ARM, the 64-bit functions use instructions unavailable before the ARMv6k core.
;;
;; On ARM, 386, and 32-bit MIPS, it is the caller's responsibility to arrange
;; for 64-bit alignment of 64-bit words accessed atomically via the primitive
;; atomic functions (types [Int64] and [Uint64] are automatically aligned).
;; The first word in an allocated struct, array, or slice; in a global
;; variable; or in a local variable (because on 32-bit architectures, the
;; subject of 64-bit atomic operations will escape to the heap) can be
;; relied upon to be 64-bit aligned.





(go/func ^:extern ^:go/noescape SwapInt32 "SwapInt32 atomically stores new into *addr and returns the previous *addr value.\nConsider using the more ergonomic and less error-prone [Int32.Swap] instead.\n" [^{:tag (* int32)} addr ^int32 new] :results [^int32 old])





(go/func ^:extern ^:go/noescape SwapUint32 "SwapUint32 atomically stores new into *addr and returns the previous *addr value.\nConsider using the more ergonomic and less error-prone [Uint32.Swap] instead.\n" [^{:tag (* uint32)} addr ^uint32 new] :results [^uint32 old])





(go/directive "//go:linknamestd SwapUintptr")
(go/func ^:extern ^:go/noescape SwapUintptr "SwapUintptr atomically stores new into *addr and returns the previous *addr value.\nConsider using the more ergonomic and less error-prone [Uintptr.Swap] instead.\n" [^{:tag (* uintptr)} addr ^uintptr new] :results [^uintptr old])



(go/func ^:extern SwapPointer "SwapPointer atomically stores new into *addr and returns the previous *addr value.\nConsider using the more ergonomic and less error-prone [Pointer.Swap] instead.\n" [^{:tag (* unsafe/Pointer)} addr ^unsafe/Pointer new] :results [^unsafe/Pointer old])





(go/func ^:extern ^:go/noescape CompareAndSwapInt32 "CompareAndSwapInt32 executes the compare-and-swap operation for an int32 value.\nConsider using the more ergonomic and less error-prone [Int32.CompareAndSwap] instead.\n" [^{:tag (* int32)} addr ^int32 old ^int32 new] :results [^bool swapped])





(go/func ^:extern ^:go/noescape CompareAndSwapUint32 "CompareAndSwapUint32 executes the compare-and-swap operation for a uint32 value.\nConsider using the more ergonomic and less error-prone [Uint32.CompareAndSwap] instead.\n" [^{:tag (* uint32)} addr ^uint32 old ^uint32 new] :results [^bool swapped])





(go/directive "//go:linknamestd CompareAndSwapUintptr")
(go/func ^:extern ^:go/noescape CompareAndSwapUintptr "CompareAndSwapUintptr executes the compare-and-swap operation for a uintptr value.\nConsider using the more ergonomic and less error-prone [Uintptr.CompareAndSwap] instead.\n" [^{:tag (* uintptr)} addr ^uintptr old ^uintptr new] :results [^bool swapped])



(go/func ^:extern CompareAndSwapPointer "CompareAndSwapPointer executes the compare-and-swap operation for a unsafe.Pointer value.\nConsider using the more ergonomic and less error-prone [Pointer.CompareAndSwap] instead.\n" [^{:tag (* unsafe/Pointer)} addr ^unsafe/Pointer old ^unsafe/Pointer new] :results [^bool swapped])





(go/func ^:extern ^:go/noescape AddInt32 "AddInt32 atomically adds delta to *addr and returns the new value.\nConsider using the more ergonomic and less error-prone [Int32.Add] instead.\n" [^{:tag (* int32)} addr ^int32 delta] :results [^int32 new])







(go/func ^:extern ^:go/noescape AddUint32 "AddUint32 atomically adds delta to *addr and returns the new value.\nTo subtract a signed positive constant value c from x, do AddUint32(&x, ^uint32(c-1)).\nIn particular, to decrement x, do AddUint32(&x, ^uint32(0)).\nConsider using the more ergonomic and less error-prone [Uint32.Add] instead.\n" [^{:tag (* uint32)} addr ^uint32 delta] :results [^uint32 new])





(go/func ^:extern ^:go/noescape AddUintptr "AddUintptr atomically adds delta to *addr and returns the new value.\nConsider using the more ergonomic and less error-prone [Uintptr.Add] instead.\n" [^{:tag (* uintptr)} addr ^uintptr delta] :results [^uintptr new])






(go/func ^:extern ^:go/noescape AndInt32 "AndInt32 atomically performs a bitwise AND operation on *addr using the bitmask provided as mask\nand returns the old value.\nConsider using the more ergonomic and less error-prone [Int32.And] instead.\n" [^{:tag (* int32)} addr ^int32 mask] :results [^int32 old])






(go/func ^:extern ^:go/noescape AndUint32 "AndUint32 atomically performs a bitwise AND operation on *addr using the bitmask provided as mask\nand returns the old value.\nConsider using the more ergonomic and less error-prone [Uint32.And] instead.\n" [^{:tag (* uint32)} addr ^uint32 mask] :results [^uint32 old])






(go/func ^:extern ^:go/noescape AndUintptr "AndUintptr atomically performs a bitwise AND operation on *addr using the bitmask provided as mask\nand returns the old value.\nConsider using the more ergonomic and less error-prone [Uintptr.And] instead.\n" [^{:tag (* uintptr)} addr ^uintptr mask] :results [^uintptr old])






(go/func ^:extern ^:go/noescape OrInt32 "OrInt32 atomically performs a bitwise OR operation on *addr using the bitmask provided as mask\nand returns the old value.\nConsider using the more ergonomic and less error-prone [Int32.Or] instead.\n" [^{:tag (* int32)} addr ^int32 mask] :results [^int32 old])






(go/func ^:extern ^:go/noescape OrUint32 "OrUint32 atomically performs a bitwise OR operation on *addr using the bitmask provided as mask\nand returns the old value.\nConsider using the more ergonomic and less error-prone [Uint32.Or] instead.\n" [^{:tag (* uint32)} addr ^uint32 mask] :results [^uint32 old])






(go/func ^:extern ^:go/noescape OrUintptr "OrUintptr atomically performs a bitwise OR operation on *addr using the bitmask provided as mask\nand returns the old value.\nConsider using the more ergonomic and less error-prone [Uintptr.Or] instead.\n" [^{:tag (* uintptr)} addr ^uintptr mask] :results [^uintptr old])





(go/func ^:extern ^:go/noescape LoadInt32 "LoadInt32 atomically loads *addr.\nConsider using the more ergonomic and less error-prone [Int32.Load] instead.\n" [^{:tag (* int32)} addr] :results [^int32 val])





(go/func ^:extern ^:go/noescape LoadUint32 "LoadUint32 atomically loads *addr.\nConsider using the more ergonomic and less error-prone [Uint32.Load] instead.\n" [^{:tag (* uint32)} addr] :results [^uint32 val])





(go/func ^:extern ^:go/noescape LoadUintptr "LoadUintptr atomically loads *addr.\nConsider using the more ergonomic and less error-prone [Uintptr.Load] instead.\n" [^{:tag (* uintptr)} addr] :results [^uintptr val])



(go/func ^:extern LoadPointer "LoadPointer atomically loads *addr.\nConsider using the more ergonomic and less error-prone [Pointer.Load] instead.\n" [^{:tag (* unsafe/Pointer)} addr] :results [^unsafe/Pointer val])





(go/func ^:extern ^:go/noescape StoreInt32 "StoreInt32 atomically stores val into *addr.\nConsider using the more ergonomic and less error-prone [Int32.Store] instead.\n" [^{:tag (* int32)} addr ^int32 val])





(go/func ^:extern ^:go/noescape StoreUint32 "StoreUint32 atomically stores val into *addr.\nConsider using the more ergonomic and less error-prone [Uint32.Store] instead.\n" [^{:tag (* uint32)} addr ^uint32 val])





(go/directive "//go:linknamestd StoreUintptr")
(go/func ^:extern ^:go/noescape StoreUintptr "StoreUintptr atomically stores val into *addr.\nConsider using the more ergonomic and less error-prone [Uintptr.Store] instead.\n" [^{:tag (* uintptr)} addr ^uintptr val])



(go/func ^:extern StorePointer "StorePointer atomically stores val into *addr.\nConsider using the more ergonomic and less error-prone [Pointer.Store] instead.\n" [^{:tag (* unsafe/Pointer)} addr ^unsafe/Pointer val])

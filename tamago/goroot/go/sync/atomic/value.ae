^{:go/end 83} (go/method Store "Store sets the value of the [Value] v to val.\nAll calls to Store for a given Value must use values of the same concrete type.\nStore of an inconsistent type panics, as does Store(nil).\n" [^{:tag (* Value)} v ^any val]
  (when (== val nil)
    (panic "sync/atomic: store of nil value into Value"))

  (let [vp (conv (* efaceWords) (conv unsafe/Pointer v))
      ^{:line 52} vlp (conv (* efaceWords) (conv unsafe/Pointer (addr val)))]
    (while true
      (let [typ (LoadPointer (addr (.-typ vp)))]
        (when (== typ nil)
          ;; Attempt to start first store.
          ;; Disable preemption so that other goroutines can use
          ;; active spin wait to wait for completion.
          (runtime_procPin)
          (when (not (CompareAndSwapPointer (addr (.-typ vp)) nil (conv unsafe/Pointer (addr firstStoreInProgress))))
            (runtime_procUnpin)
            (continue))

          ;; Complete first store.
          (StorePointer (addr (.-data vp)) (.-data vlp))
          (StorePointer (addr (.-typ vp)) (.-typ vlp))
          (runtime_procUnpin)
          (return))

        (when (== typ (conv unsafe/Pointer (addr firstStoreInProgress)))
          ;; First store in progress. Wait.
          ;; Since we disable preemption around the first store,
          ;; we can wait with active spinning.
          (continue))

        ;; First store completed. Check type and overwrite data.
        (when (!= typ (.-typ vlp))
          (panic "sync/atomic: store of inconsistently typed value into Value"))

        (StorePointer (addr (.-data vp)) (.-data vlp))
        (return)))))









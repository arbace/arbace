(in-ns 'go.sync.atomic) (go/file "doc_64.go" :build ["//go:build !(386 || arm || mips || mipsle)"] :imports [])






(go/func ^:extern ^:go/noescape SwapInt64 "SwapInt64 atomically stores new into *addr and returns the previous *addr value.\nConsider using the more ergonomic and less error-prone [Int64.Swap] instead\n(particularly if you target 32-bit platforms; see the bugs section).\n" [^{:tag (* int64)} addr ^int64 new] :results [^int64 old])






(go/func ^:extern ^:go/noescape SwapUint64 "SwapUint64 atomically stores new into *addr and returns the previous *addr value.\nConsider using the more ergonomic and less error-prone [Uint64.Swap] instead\n(particularly if you target 32-bit platforms; see the bugs section).\n" [^{:tag (* uint64)} addr ^uint64 new] :results [^uint64 old])






(go/func ^:extern ^:go/noescape CompareAndSwapInt64 "CompareAndSwapInt64 executes the compare-and-swap operation for an int64 value.\nConsider using the more ergonomic and less error-prone [Int64.CompareAndSwap] instead\n(particularly if you target 32-bit platforms; see the bugs section).\n" [^{:tag (* int64)} addr ^int64 old ^int64 new] :results [^bool swapped])






(go/func ^:extern ^:go/noescape CompareAndSwapUint64 "CompareAndSwapUint64 executes the compare-and-swap operation for a uint64 value.\nConsider using the more ergonomic and less error-prone [Uint64.CompareAndSwap] instead\n(particularly if you target 32-bit platforms; see the bugs section).\n" [^{:tag (* uint64)} addr ^uint64 old ^uint64 new] :results [^bool swapped])






(go/func ^:extern ^:go/noescape AddInt64 "AddInt64 atomically adds delta to *addr and returns the new value.\nConsider using the more ergonomic and less error-prone [Int64.Add] instead\n(particularly if you target 32-bit platforms; see the bugs section).\n" [^{:tag (* int64)} addr ^int64 delta] :results [^int64 new])








(go/func ^:extern ^:go/noescape AddUint64 "AddUint64 atomically adds delta to *addr and returns the new value.\nTo subtract a signed positive constant value c from x, do AddUint64(&x, ^uint64(c-1)).\nIn particular, to decrement x, do AddUint64(&x, ^uint64(0)).\nConsider using the more ergonomic and less error-prone [Uint64.Add] instead\n(particularly if you target 32-bit platforms; see the bugs section).\n" [^{:tag (* uint64)} addr ^uint64 delta] :results [^uint64 new])






(go/func ^:extern ^:go/noescape AndInt64 "AndInt64 atomically performs a bitwise AND operation on *addr using the bitmask provided as mask\nand returns the old value.\nConsider using the more ergonomic and less error-prone [Int64.And] instead.\n" [^{:tag (* int64)} addr ^int64 mask] :results [^int64 old])






(go/func ^:extern ^:go/noescape AndUint64 "AndUint64 atomically performs a bitwise AND operation on *addr using the bitmask provided as mask\nand returns the old.\nConsider using the more ergonomic and less error-prone [Uint64.And] instead.\n" [^{:tag (* uint64)} addr ^uint64 mask] :results [^uint64 old])






(go/func ^:extern ^:go/noescape OrInt64 "OrInt64 atomically performs a bitwise OR operation on *addr using the bitmask provided as mask\nand returns the old value.\nConsider using the more ergonomic and less error-prone [Int64.Or] instead.\n" [^{:tag (* int64)} addr ^int64 mask] :results [^int64 old])






(go/func ^:extern ^:go/noescape OrUint64 "OrUint64 atomically performs a bitwise OR operation on *addr using the bitmask provided as mask\nand returns the old value.\nConsider using the more ergonomic and less error-prone [Uint64.Or] instead.\n" [^{:tag (* uint64)} addr ^uint64 mask] :results [^uint64 old])






(go/func ^:extern ^:go/noescape LoadInt64 "LoadInt64 atomically loads *addr.\nConsider using the more ergonomic and less error-prone [Int64.Load] instead\n(particularly if you target 32-bit platforms; see the bugs section).\n" [^{:tag (* int64)} addr] :results [^int64 val])






(go/func ^:extern ^:go/noescape LoadUint64 "LoadUint64 atomically loads *addr.\nConsider using the more ergonomic and less error-prone [Uint64.Load] instead\n(particularly if you target 32-bit platforms; see the bugs section).\n" [^{:tag (* uint64)} addr] :results [^uint64 val])






(go/func ^:extern ^:go/noescape StoreInt64 "StoreInt64 atomically stores val into *addr.\nConsider using the more ergonomic and less error-prone [Int64.Store] instead\n(particularly if you target 32-bit platforms; see the bugs section).\n" [^{:tag (* int64)} addr ^int64 val])






(go/func ^:extern ^:go/noescape StoreUint64 "StoreUint64 atomically stores val into *addr.\nConsider using the more ergonomic and less error-prone [Uint64.Store] instead\n(particularly if you target 32-bit platforms; see the bugs section).\n" [^{:tag (* uint64)} addr ^uint64 val])

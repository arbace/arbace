^{:go/end 282} (go/func ^{:go/linkname "poolCleanup"} poolCleanup "poolCleanup should be an internal detail,\nbut widely used packages access it using linkname.\nNotable members of the hall of shame include:\n  - github.com/bytedance/gopkg\n  - github.com/songzhibin97/gkit\n\nDo not remove or change the type signature.\nSee go.dev/issue/67401.\n" []
  ;; This function is called with the world stopped, at the beginning of a garbage collection.
  ;; It must not allocate and probably should not call any runtime functions.

  ;; Because the world is stopped, no pool user can be in a
  ;; pinned section (in effect, this has all Ps pinned).

  ;; Drop victim caches from all pools.
  (range [_ p oldPools]
    (set! (.-victim p) nil)
    (set! (.-victimSize p) 0))


  ;; Move primary cache to victim cache.
  (range [_ p allPools]
    (set! (.-victim p) (.-local p))
    (set! (.-victimSize p) (.-localSize p))
    (set! (.-local p) nil)
    (set! (.-localSize p) 0))


  ;; The pools with non-empty primary caches now have non-empty
  ;; victim caches and no pools have primary caches.
  (set! (values oldPools allPools) (values allPools nil)))



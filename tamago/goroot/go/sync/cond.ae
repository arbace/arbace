(in-ns 'go.sync) (go/file "cond.go" :imports [


    ^{:line 8} [atomic "sync/atomic"]
    ^{:line 9} [unsafe "unsafe"]])



























(go/type Cond "Cond implements a condition variable, a rendezvous point\nfor goroutines waiting for or announcing the occurrence\nof an event.\n\nEach Cond has an associated Locker L (often a [*Mutex] or [*RWMutex]),\nwhich must be held when changing the condition and\nwhen calling the [Cond.Wait] method.\n\nA Cond must not be copied after first use.\n\nIn the terminology of [the Go memory model], Cond arranges that\na call to [Cond.Broadcast] or [Cond.Signal] “synchronizes before” any Wait call\nthat it unblocks.\n\nFor many simple use cases, users will be better off using channels than a\nCond (Broadcast corresponds to closing a channel, and Signal corresponds to\nsending on a channel).\n\nFor more on replacements for [sync.Cond], see [Roberto Clapis's series on\nadvanced concurrency patterns], as well as [Bryan Mills's talk on concurrency\npatterns].\n\n[the Go memory model]: https://go.dev/ref/mem\n[Roberto Clapis's series on advanced concurrency patterns]: https://blogtitle.github.io/categories/concurrency/\n[Bryan Mills's talk on concurrency patterns]: https://drive.google.com/file/d/1nPdvhB0PutEJzdCq5ms6UI58dp50fcAN/view\n" (struct
    ^{:line 38 :tag noCopy} noCopy


    ^{:line 41 :tag Locker :doc "L is held while observing or changing the condition\n"} L

    ^{:line 43 :tag notifyList} notify
    ^{:line 44 :tag copyChecker} checker))



^{:go/end 50} (go/func NewCond "NewCond returns a new Cond with Locker l.\n" ^{:tag (* Cond)} [^Locker l]
  (addr (lit Cond :L l)))

















^{:go/end 73} (go/method Wait "Wait atomically unlocks c.L and suspends execution\nof the calling goroutine. After later resuming execution,\nWait locks c.L before returning. Unlike in other systems,\nWait cannot return unless awoken by [Cond.Broadcast] or [Cond.Signal].\n\nBecause c.L is not locked while Wait is waiting, the caller\ntypically cannot assume that the condition is true when\nWait returns. Instead, the caller should Wait in a loop:\n\n\tc.L.Lock()\n\tfor !condition() {\n\t    c.Wait()\n\t}\n\t... make use of condition ...\n\tc.L.Unlock()\n" [^{:tag (* Cond)} c]
  (.check (.-checker c))
  (let [t (runtime_notifyListAdd (addr (.-notify c)))]
    (.Unlock (.-L c))
    (runtime_notifyListWait (addr (.-notify c)) t)
    (.Lock (.-L c))))









^{:go/end 85} (go/method Signal "Signal wakes one goroutine waiting on c, if there is any.\n\nIt is allowed but not required for the caller to hold c.L\nduring the call.\n\nSignal() does not affect goroutine scheduling priority; if other goroutines\nare attempting to lock c.L, they may be awoken before a \"waiting\" goroutine.\n" [^{:tag (* Cond)} c]
  (.check (.-checker c))
  (runtime_notifyListNotifyOne (addr (.-notify c))))








^{:go/end 96} (go/method Broadcast "Broadcast wakes all goroutines waiting on c.\n\nIt is allowed but not required for the caller to hold c.L during the call.\nThe time it takes to run Broadcast is proportional to the number of waiting goroutines;\nbe aware that holding the lock across a call to Broadcast\nwill extend the amount of time that the lock is held.\n" [^{:tag (* Cond)} c]
  (.check (.-checker c))
  (runtime_notifyListNotifyAll (addr (.-notify c))))



(go/type copyChecker "copyChecker holds back pointer to itself to detect object copying.\n" uintptr)

^{:go/end 111} (go/method check [^{:tag (* copyChecker)} c]
  ;; Check if c has been copied in three steps:
  ;; 1. The first comparison is the fast-path. If c has been initialized and not copied, this will return immediately. Otherwise, c is either not initialized, or has been copied.
  ;; 2. Ensure c is initialized. If the CAS succeeds, we're done. If it fails, c was either initialized concurrently and we simply lost the race, or c has been copied.
  ;; 3. Do step 1 again. Now that c is definitely initialized, if this fails, c was copied.
  (when (and (!= (conv uintptr @c) (conv uintptr (conv unsafe/Pointer c)))
      (not (atomic/CompareAndSwapUintptr (conv (* uintptr) c) 0 (conv uintptr (conv unsafe/Pointer c))))
      (!= (conv uintptr @c) (conv uintptr (conv unsafe/Pointer c))))
    (panic "sync.Cond is copied")))










(go/type noCopy "noCopy may be added to structs which must not be copied\nafter the first use.\n\nSee https://golang.org/issues/8005#issuecomment-190753527\nfor details.\n\nNote that it must not be embedded, due to the Lock and Unlock methods.\n" (struct))


^{:go/end 123} (go/method Lock "Lock is a no-op used by -copylocks checker from `go vet`.\n" [(* noCopy)])
^{:go/end 124} (go/method Unlock [(* noCopy)])

(ns go.reflect
  (:require [arbace.go :as go]))

(go/package reflect
  :path "reflect"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["abi.go" "badlinkname.go" "deepequal.go" "float32reg_generic.go" "iter.go" "makefunc.go" "map.go" "swapper.go" "type.go" "value.go" "visiblefields.go"]
  :other-files ["asm_amd64.s"]
  :init-order [intArgRegs floatArgRegs floatRegSize stringType kindNames bytesType uint8Type]
  :positions :lines)

(load "reflect/abi")
(load "reflect/badlinkname")
(load "reflect/deepequal")
(load "reflect/float32reg_generic")
(load "reflect/iter")
(load "reflect/makefunc")
(load "reflect/map")
(load "reflect/swapper")
(load "reflect/type")
(load "reflect/value")
(load "reflect/visiblefields")

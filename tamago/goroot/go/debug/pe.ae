(ns go.debug.pe
  (:require [arbace.go :as go]))

(go/package pe
  :path "debug/pe"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["file.go" "pe.go" "section.go" "string.go" "symbol.go"]
  :init-order []
  :positions :lines)

(load "pe/file")
(load "pe/pe")
(load "pe/section")
(load "pe/string")
(load "pe/symbol")

(ns go.debug.elf
  (:require [arbace.go :as go]))

(go/package elf
  :path "debug/elf"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["elf.go" "file.go" "reader.go"]
  :init-order [versionStrings classStrings dataStrings osabiStrings typeStrings machineStrings shnStrings shtStrings shfStrings compressionStrings ptStrings pfStrings dtStrings dflagStrings dflag1Strings ntypeStrings stbStrings sttStrings stvStrings rx86_64Strings raarch64Strings ralphaStrings rarmStrings r386Strings rmipsStrings rlarchStrings rppcStrings rppc64Strings rriscvStrings r390Strings rsparcStrings ErrNoSymbols]
  :positions :lines)

(load "elf/elf")
(load "elf/file")
(load "elf/reader")

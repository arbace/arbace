(ns go.debug.gosym
  (:require [arbace.go :as go]))

(go/package gosym
  :path "debug/gosym"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["pclntab.go" "symtab.go"]
  :init-order [littleEndianSymtab bigEndianSymtab oldLittleEndianSymtab]
  :positions :lines)

(load "gosym/pclntab")
(load "gosym/symtab")

            (let [t (new EnumType)]
              (set! typ t)
              (aset typeCache off t)
              (set! (values (.-EnumName t) _) (assert string (.Val e AttrName)))
              (set! (.-Val t) (make (slice (* EnumValue)) 0 8))
              (for [kid (next)] (!= kid nil) (set! kid (next))
                (when (== (.-Tag kid) TagEnumerator)
                  (let [f (new EnumValue)]
                    (set! (values (.-Name f) _) (assert string (.Val kid AttrName)))
                    (set! (values (.-Val f) _) (assert int64 (.Val kid AttrConstValue)))
                    (let [n (len (.-Val t))]
                      (when (>= n (cap (.-Val t)))
                        (let [val (make (slice (* EnumValue)) n (* n 2))]
                          (copy val (.-Val t))
                          (set! (.-Val t) val)))

                      (set! (.-Val t) (subslice (.-Val t) 0 (+ n 1)))
                      (aset (.-Val t) n f)))))))



          (case [TagPointerType]
            ;; Type modifier (DWARF v2 §5.2)
            ;; Attributes:
            ;;	AttrType: subtype [not required!  void* has no AttrType]
            ;;	AttrAddrClass: address class [ignored]
            (let [t (new PtrType)]
              (set! typ t)
              (aset typeCache off t)
              (when (== (.Val e AttrType) nil)
                (set! (.-Type t) (addr (lit VoidType)))
                (break))

              (set! (.-Type t) (typeOf e))))

          (case [TagSubroutineType]
            ;; Subroutine type.  (DWARF v2 §5.7)
            ;; Attributes:
            ;;	AttrType: type of return value if any
            ;;	AttrName: possible name of type [ignored]
            ;;	AttrPrototyped: whether used ANSI C prototype [ignored]
            ;; Children:
            ;;	TagFormalParameter: typed parameter
            ;;		AttrType: type of parameter
            ;;	TagUnspecifiedParameter: final ...
            (let [t (new FuncType)]
              (set! typ t)
              (aset typeCache off t)
              (when [(set! (.-ReturnType t) (typeOf e))] (!= err nil)
                (goto :Error))

              (set! (.-ParamType t) (make (slice Type) 0 8))
              (for [kid (next)] (!= kid nil) (set! kid (next))
                (let [^Type tkid (zero Type)]
                  (switch (.-Tag kid)
                    (default
                      (continue))
                    (case [TagFormalParameter]
                      (when [(set! tkid (typeOf kid))] (!= err nil)
                        (goto :Error)))

                    (case [TagUnspecifiedParameters]
                      (set! tkid (addr (lit DotDotDotType)))))

                  (set! (.-ParamType t) (append (.-ParamType t) tkid))))))


          (case [TagTypedef]
            ;; Typedef (DWARF v2 §5.3)
            ;; Attributes:
            ;;	AttrName: name [required]
            ;;	AttrType: type definition [required]
            (let [t (new TypedefType)]
              (set! typ t)
              (aset typeCache off t)
              (set! (values ^{:go/via [CommonType]} (.-Name t) _) (assert string (.Val e AttrName)))
              (set! (.-Type t) (typeOf e))))

          (case [TagUnspecifiedType]
            ;; Unspecified type (DWARF v3 §5.2)
            ;; Attributes:
            ;;	AttrName: name
            (let [t (new UnspecifiedType)]
              (set! typ t)
              (aset typeCache off t)
              (set! (values ^{:go/via [BasicType CommonType]} (.-Name t) _) (assert string (.Val e AttrName)))))

          (default
            ;; This is some other type DIE that we're currently not
            ;; equipped to handle. Return an abstract "unsupported type"
            ;; object in such cases.
            (let [t (new UnsupportedType)]
              (set! typ t)
              (aset typeCache off t)
              (set! (.-Tag t) (.-Tag e))
              (set! (values ^{:go/via [CommonType]} (.-Name t) _) (assert string (.Val e AttrName))))))


        (when (!= err nil)
          (goto :Error))


        (do
          (let [(values b ok) (assert int64 (.Val e AttrByteSize))]
            (when (not ok)
              (set! b -1)
              (type-switch [t typ]
                (case [(* TypedefType)]
                  ;; Record that we need to resolve this
                  ;; type's size once the type graph is
                  ;; constructed.
                  (set! (.-typedefs fixups) (append (.-typedefs fixups) t)))
                (case [(* PtrType)]
                  (set! b (conv int64 addressSize)))))


            (set! (.-ByteSize (.Common typ)) b)))

        (return typ nil)

        (label :Error
          ;; If the parse fails, take the type out of the cache
          ;; so that the next call with this offset doesn't hit
          ;; the cache and return success.
          (delete typeCache off))
        (return nil err)))))


^{:go/end 870} (go/func zeroArray [^{:tag (* Type)} t]
  (let [at (assert (* ArrayType) @t)]
    (when (== (.Size (.-Type at)) 0)
      (return))

    ;; Make a copy to avoid invalidating typeCache.
    (let [tt @at]
      (set! (.-Count tt) 0)
      (set! @t (addr tt)))))

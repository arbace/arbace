(ns go.debug.macho
  (:require [arbace.go :as go]))

(go/package macho
  :path "debug/macho"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["fat.go" "file.go" "macho.go" "reloctype.go" "reloctype_string.go"]
  :init-order [ErrNotFat typeStrings cpuStrings cmdStrings _RelocTypeGeneric_index _RelocTypeX86_64_index _RelocTypeARM_index _RelocTypeARM64_index]
  :positions :lines)

(load "macho/fat")
(load "macho/file")
(load "macho/macho")
(load "macho/reloctype")
(load "macho/reloctype_string")

(ns go.debug.macho
  (:require [arbace.go :as go]))

(go/package macho
  :path "debug/macho"
  :files ["fat.go" "file.go" "macho.go" "reloctype.go" "reloctype_string.go"]
  :positions :lines)

(load "macho/fat")
(load "macho/file")
(load "macho/macho")
(load "macho/reloctype")
(load "macho/reloctype_string")

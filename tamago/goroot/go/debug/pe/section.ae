(go/type SectionHeader32 "SectionHeader32 represents real PE COFF section header.\n" (struct
    ^{:line 17 :tag (array 8 uint8)} Name
    ^{:line 18 :tag uint32} VirtualSize
    ^{:line 19 :tag uint32} VirtualAddress
    ^{:line 20 :tag uint32} SizeOfRawData
    ^{:line 21 :tag uint32} PointerToRawData
    ^{:line 22 :tag uint32} PointerToRelocations
    ^{:line 23 :tag uint32} PointerToLineNumbers
    ^{:line 24 :tag uint16} NumberOfRelocations
    ^{:line 25 :tag uint16} NumberOfLineNumbers

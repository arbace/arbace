^{:go/end 41} (go/method fullName "fullName finds real name of section sh. Normally name is stored\nin sh.Name, but if it is longer then 8 characters, it is stored\nin COFF string table st instead.\n" [^{:tag (* SectionHeader32)} sh ^StringTable st] :results [string error]
  (when (!= (aget (.-Name sh) 0) \/)
    (return (cstring (subslice (.-Name sh))) nil))

  (let [(values i err) (strconv/Atoi (cstring (subslice (.-Name sh) 1)))]
    (when (!= err nil)
      (return "" err))

    (.String st (conv uint32 i))))


;; TODO(brainman): copy all IMAGE_REL_* consts from ldpe.go here



(go/type Reloc "Reloc represents a PE COFF relocation.\nEach section contains its own relocation list.\n" (struct
    ^{:line 48 :tag uint32} VirtualAddress
    ^{:line 49 :tag uint32} SymbolTableIndex
    ^{:line 50 :tag uint16} Type))


^{:go/end 67} (go/func readRelocs [^{:tag (* SectionHeader)} sh ^io/ReadSeeker r] :results [(slice Reloc) error]
  (when (<= (.-NumberOfRelocations sh) 0)
    (return nil nil))

  (let [(values _ err) (.Seek r (conv int64 (.-PointerToRelocations sh)) io/SeekStart)]
    (when (!= err nil)
      (return nil (fmt/Errorf "fail to seek to %q section relocations: %v" (.-Name sh) err)))

    (let [relocs (make (slice Reloc) (.-NumberOfRelocations sh))]
      (set! err (binary/Read r binary/LittleEndian relocs))
      (when (!= err nil)
        (return nil (fmt/Errorf "fail to read section relocations: %v" err)))

      (return relocs nil))))




(go/type SectionHeader "SectionHeader is similar to [SectionHeader32] with Name\nfield replaced by Go string.\n" (struct
    ^{:line 72 :tag string} Name
    ^{:line 73 :tag uint32} VirtualSize
    ^{:line 74 :tag uint32} VirtualAddress
    ^{:line 75 :tag uint32} Size
    ^{:line 76 :tag uint32} Offset
    ^{:line 77 :tag uint32} PointerToRelocations
    ^{:line 78 :tag uint32} PointerToLineNumbers
    ^{:line 79 :tag uint16} NumberOfRelocations
    ^{:line 80 :tag uint16} NumberOfLineNumbers
    ^{:line 81 :tag uint32} Characteristics))



(go/type Section "Section provides access to PE COFF section.\n" (struct
    ^{:line 86} SectionHeader
    ^{:line 87 :tag (slice Reloc)} Relocs







    ^{:line 95 :doc "Embed ReaderAt for ReadAt method.\nDo not embed SectionReader directly\nto avoid having Read and Seek.\nIf a client wants Read and Seek it must use\nOpen() to avoid fighting over the seek offset\nwith other clients.\n"} io/ReaderAt
    ^{:line 96 :tag (* io/SectionReader)} sr))






^{:go/end 105} (go/method Data "Data reads and returns the contents of the PE section s.\n\nIf s.Offset is 0, the section has no contents,\nand Data will always return a non-nil error.\n" [^{:tag (* Section)} s] :results [(slice byte) error]
  (saferio/ReadDataAt (.-sr s) (conv uint64 ^{:go/via [SectionHeader]} (.-Size s)) 0))






^{:go/end 113} (go/method Open "Open returns a new ReadSeeker reading the PE section s.\n\nIf s.Offset is 0, the section has no contents, and all calls\nto the returned reader will return a non-nil error.\n" ^io/ReadSeeker [^{:tag (* Section)} s]
  (io/NewSectionReader (.-sr s) 0 (- (<< 1 63) 1)))




              ;; Make sure the architecture for this image is not duplicate.
              (let [seenArch (bit-or (<< (conv uint64 ^{:go/via [FatArchHeader]} (.-Cpu fa)) 32) (conv uint64 ^{:go/via [FatArchHeader]} (.-SubCpu fa)))]
                (when [(values o k) (aget seenArches seenArch)] (or o k)
                  (return nil (addr (lit FormatError offset (fmt/Sprintf "duplicate architecture cpu=%v, subcpu=%#x" ^{:go/via [FatArchHeader]} (.-Cpu fa) ^{:go/via [FatArchHeader]} (.-SubCpu fa)) nil))))

                (aset seenArches seenArch true)

                ;; Make sure the Mach-O type matches that of the first image.
                (if (== i 0)
                  (set! machoType ^{:go/via [File FileHeader]} (.-Type fa))
                  (do
                    (when (!= ^{:go/via [File FileHeader]} (.-Type fa) machoType)
                      (return nil (addr (lit FormatError offset (fmt/Sprintf "Mach-O type for architecture #%d (type=%#x) does not match first (type=%#x)" i ^{:go/via [File FileHeader]} (.-Type fa) machoType) nil))))))



                (set! (.-Arches ff) (append (.-Arches ff) fa))))))


        (return (addr ff) nil)))))




^{:go/end 144} (go/func OpenFat "OpenFat opens the named file using [os.Open] and prepares it for use as a Mach-O\nuniversal binary.\n" [^string name] :results [(* FatFile) error]
  (let [(values f err) (os/Open name)]
    (when (!= err nil)
      (return nil err))

    (let [(values ff ^:assign err) (NewFatFile f)]
      (when (!= err nil)
        (.Close f)
        (return nil err))

      (set! (.-closer ff) f)
      (return ff nil))))


^{:go/end 153} (go/method Close ^error [^{:tag (* FatFile)} ff]

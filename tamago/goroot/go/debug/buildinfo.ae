(ns go.debug.buildinfo
  (:require [arbace.go :as go]))

(go/package buildinfo
  :path "debug/buildinfo"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["buildinfo.go"]
  :init-order [errUnrecognizedFormat errNotGoExe buildInfoMagic]
  :positions :lines)

(load "buildinfo/buildinfo")

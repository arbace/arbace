(in-ns 'go.debug.elf) (go/file "reader.go" :imports [


    ^{:line 8} [io "io"]
    ^{:line 9} [os "os"]])



(go/type errorReader "errorReader returns error from all operations.\n" (struct
    ^{:line 14 :tag error} error))


^{:go/end 19} (go/method Read [^errorReader r ^{:tag (slice byte)} p] :results [^int n ^error err]
  (return 0 (.-error r)))


^{:go/end 23} (go/method ReadAt [^errorReader r ^{:tag (slice byte)} p ^int64 off] :results [^int n ^error err]
  (return 0 (.-error r)))


^{:go/end 27} (go/method Seek [^errorReader r ^int64 offset ^int whence] :results [int64 error]
  (return 0 (.-error r)))


^{:go/end 31} (go/method Close ^error [^errorReader r]
  (.-error r))






(go/type readSeekerFromReader "readSeekerFromReader converts an io.Reader into an io.ReadSeeker.\nIn general Seek may not be efficient, but it is optimized for\ncommon cases such as seeking to the end to find the length of the\ndata.\n" (struct
    ^{:line 38 :tag (func [] [io/Reader error])} reset
    ^{:line 39 :tag io/Reader} r
    ^{:line 40 :tag int64} size
    ^{:line 41 :tag int64} offset))


^{:go/end 52} (go/method start [^{:tag (* readSeekerFromReader)} r]
  (let [(values x err) ((.-reset r))]
    (if (!= err nil)
      (set! (.-r r) (lit errorReader err))

      (set! (.-r r) x))

    (set! (.-offset r) 0)))


^{:go/end 61} (go/method Read [^{:tag (* readSeekerFromReader)} r ^{:tag (slice byte)} p] :results [^int n ^error err]
  (when (== (.-r r) nil)
    (.start r))

  (set! (values n err) (.Read (.-r r) p))
  (set! (.-offset r) + (conv int64 n))
  (return n err))


^{:go/end 108} (go/method Seek [^{:tag (* readSeekerFromReader)} r ^int64 offset ^int whence] :results [int64 error]
  (let [^int64 newOffset (zero int64)]
    (switch whence
      (case [io/SeekStart]
        (set! newOffset offset))
      (case [io/SeekCurrent]
        (set! newOffset (+ (.-offset r) offset)))
      (case [io/SeekEnd]
        (set! newOffset (+ (.-size r) offset)))
      (default
        (return 0 os/ErrInvalid)))


    (switch
      (case [(== newOffset (.-offset r))]
        (return newOffset nil))

      (case [(< newOffset 0) (> newOffset (.-size r))]
        (return 0 os/ErrInvalid))

      (case [(== newOffset 0)]
        (set! (.-r r) nil))

      (case [(== newOffset (.-size r))]
        (set! (.-r r) (lit errorReader io/EOF)))

      (default
        (when (< newOffset (.-offset r))
          ;; Restart at the beginning.
          (.start r))

        ;; Read until we reach offset.
        (let [^{:tag (array 512 byte)} buf (zero (array 512 byte))]
          (while (< (.-offset r) newOffset)
            (let [b (subslice buf)]
              (when (< (- newOffset (.-offset r)) (conv int64 (len buf)))
                (set! b (subslice buf _ (- newOffset (.-offset r)))))

              (when [(values _ err) (.Read r b)] (!= err nil)
                (return 0 err)))))))



    (set! (.-offset r) newOffset)
    (return (.-offset r) nil)))

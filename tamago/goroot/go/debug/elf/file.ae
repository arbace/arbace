                (switch ^{:go/via [FileHeader]} (.-Class f)
                  (case [ELFCLASS32]
                    (set! t (conv DynTag (.Uint32 ^{:go/via [FileHeader]} (.-ByteOrder f) (subslice d 0 4))))
                    (set! v (conv uint64 (.Uint32 ^{:go/via [FileHeader]} (.-ByteOrder f) (subslice d 4 8))))
                    (set! d (subslice d 8)))
                  (case [ELFCLASS64]
                    (set! t (conv DynTag (.Uint64 ^{:go/via [FileHeader]} (.-ByteOrder f) (subslice d 0 8))))
                    (set! v (.Uint64 ^{:go/via [FileHeader]} (.-ByteOrder f) (subslice d 8 16)))
                    (set! d (subslice d 16))))

                (when (== t tag)
                  (let [(values s ok) (getString str (conv int v))]
                    (when ok
                      (set! all (append all s)))))))



            (return all nil)))))))




^{:go/end 1848} (go/method DynValue "DynValue returns the values listed for the given tag in the file's dynamic\nsection.\n" [^{:tag (* File)} f ^DynTag tag] :results [(slice uint64) error]
  (let [ds (.SectionByType f SHT_DYNAMIC)]
    (when (== ds nil)
      (return nil nil))

    (let [(values d err) (.Data ds)]
      (when (!= err nil)
        (return nil err))


      (let [dynSize 8]
        (when (== ^{:go/via [FileHeader]} (.-Class f) ELFCLASS64)
          (set! dynSize 16))

        (when (!= (% (len d) dynSize) 0)
          (return nil (errors/New "length of dynamic section is not a multiple of dynamic entry size")))


        ;; Parse the .dynamic section as a string of bytes.
        (let [^{:tag (slice uint64)} vals (zero (slice uint64))]
          (while (> (len d) 0)
            (let [^DynTag t (zero DynTag)
                ^{:line 1832 :tag uint64} v (zero uint64)]
              (switch ^{:go/via [FileHeader]} (.-Class f)
                (case [ELFCLASS32]
                  (set! t (conv DynTag (.Uint32 ^{:go/via [FileHeader]} (.-ByteOrder f) (subslice d 0 4))))
                  (set! v (conv uint64 (.Uint32 ^{:go/via [FileHeader]} (.-ByteOrder f) (subslice d 4 8))))
                  (set! d (subslice d 8)))
                (case [ELFCLASS64]
                  (set! t (conv DynTag (.Uint64 ^{:go/via [FileHeader]} (.-ByteOrder f) (subslice d 0 8))))
                  (set! v (.Uint64 ^{:go/via [FileHeader]} (.-ByteOrder f) (subslice d 8 16)))
                  (set! d (subslice d 16))))

              (when (== t tag)
                (set! vals (append vals v)))))


          (return vals nil))))))


(go/type nobitsSectionReader (struct))

^{:go/end 1854} (go/method ReadAt [(* nobitsSectionReader) ^{:tag (slice byte)} p ^int64 off] :results [^int n ^error err]
  (return 0 (errors/New "unexpected read from SHT_NOBITS section")))









^{:go/end 1889} (go/func putUint "putUint writes a relocation to slice\nat offset start of length length (4 or 8 bytes),\nadding sym+addend to the existing value if readUint is true,\nor just writing sym+addend if readUint is false.\nIf the write would extend beyond the end of slice, putUint does nothing.\nIf the addend is negative, putUint does nothing.\nIf the addition would overflow, putUint does nothing.\n" [^binary/ByteOrder byteOrder ^{:tag (slice byte)} slice ^uint64 start ^uint64 length ^uint64 sym ^int64 addend ^bool readUint]
  (when (or (> (+ start length) (conv uint64 (len slice))) (< (- math/MaxUint64 start) length))
    (return))

  (when (< addend 0)
    (return))


  (let [s (subslice slice start (+ start length))]

    (switch length
      (case [4]
        (let [ae (conv uint32 addend)]
          (when readUint
            (set! ae + (.Uint32 byteOrder s)))

          (.PutUint32 byteOrder s (+ (conv uint32 sym) ae))))
      (case [8]
        (let [ae (conv uint64 addend)]
          (when readUint
            (set! ae + (.Uint64 byteOrder s)))

          (.PutUint64 byteOrder s (+ sym ae))))
      (default
        (panic "can't happen")))))

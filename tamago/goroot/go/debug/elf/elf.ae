^{:go/end 3658} (go/func stringName ^string [^uint32 i ^{:tag (slice intName)} names ^bool goSyntax]
  (range [_ n names]
    (when (== (.-i n) i)
      (when goSyntax
        (return (+ "elf." (.-s n))))

      (return (.-s n))))



  ;; second pass - look for smaller to add with.
  ;; assume sorted already
  (for [j (- (len names) 1)] (>= j 0) (dec! j)
    (let [n (aget names j)]
      (when (< (.-i n) i)
        (let [s (.-s n)]
          (when goSyntax
            (set! s (+ "elf." s)))

          (return (+ s "+" (strconv/FormatUint (conv uint64 (- i (.-i n))) 10)))))))



  (strconv/FormatUint (conv uint64 i) 10))


^{:go/end 3681} (go/func flagName ^string [^uint32 i ^{:tag (slice intName)} names ^bool goSyntax]
  (let [s ""]
    (range [_ n names]
      (when (== (bit-and (.-i n) i) (.-i n))
        (when (> (len s) 0)
          (set! s + "+"))

        (when goSyntax
          (set! s + "elf."))

        (set! s + (.-s n))
        (set! i - (.-i n))))


    (when (== (len s) 0)
      (return (+ "0x" (strconv/FormatUint (conv uint64 i) 16))))

    (when (!= i 0)
      (set! s + (+ "+0x" (strconv/FormatUint (conv uint64 i) 16))))

    ^{:line 3680} s))

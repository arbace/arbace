        (return "" 0))

      (return (.-path tos) (+ (- aline (.-start tos) (.-offset tos)) 1)))))


^{:go/end 732} (go/method alineFromLine [^{:tag (* Obj)} o ^string path ^int line] :results [int error]
  (when (< line 1)
    (return 0 (addr (lit UnknownLineError path line))))


  (range [i s (.-Paths o)]
    ;; Find this path
    (when (!= (.-Name s) path)
      (continue))


    ;; Find this line at this stack level
    (let [depth 0
        ^{:line 705 :tag int} incstart (zero int)]
      (set! line + (conv int (.-Value s)))
      (label :pathloop
        (range [_ s (subslice (.-Paths o) i)]
          (let [val (conv int (.-Value s))]
            (switch
              (case [(and (== depth 1) (>= val line))]
                (return (- line 1) nil))

              (case [(== (.-Name s) "")]
                (dec! depth)
                (cond (== depth 0)
                  (break :pathloop)
                  (== depth 1)
                  (set! line + (- val incstart))))


              (default
                (when (== depth 1)
                  (set! incstart val))

                (inc! depth))))))


      (return 0 (addr (lit UnknownLineError path line)))))

  (return 0 (conv UnknownFileError path)))


;; /*
;; * Errors
;; */



(go/type UnknownFileError "UnknownFileError represents a failure to find the specific file in\nthe symbol table.\n" string)

^{:go/end 742} (go/method Error ^string [^UnknownFileError e] (+ "unknown file: " (conv string e)))




(go/type UnknownLineError "UnknownLineError represents a failure to map a line to a program\ncounter, either because the line is beyond the bounds of the file\nor because there is no code on the given line.\n" (struct
    ^{:line 748 :tag string} File
    ^{:line 749 :tag int} Line))


^{:go/end 754} (go/method Error ^string [^{:tag (* UnknownLineError)} e]
  (+ "no code at " (.-File e) ":" (strconv/Itoa (.-Line e))))




(go/type DecodingError "DecodingError represents an error during the decoding of\nthe symbol table.\n" (struct
    ^{:line 759 :tag int} off
    ^{:line 760 :tag string} msg
    ^{:line 761 :tag any} val))


^{:go/end 771} (go/method Error ^string [^{:tag (* DecodingError)} e]
  (let [msg (.-msg e)]
    (when (!= (.-val e) nil)
      (set! msg + (fmt/Sprintf " '%v'" (.-val e))))

    (set! msg + (fmt/Sprintf " at byte %#x" (.-off e)))
    ^{:line 770} msg))

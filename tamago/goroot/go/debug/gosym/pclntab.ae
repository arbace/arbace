  (let [(values filenum ok) (aget (.-fileMap t) file)]
    (when (not ok)
      (return 0))


    ;; Scan all functions.
    ;; If this turns out to be a bottleneck, we could build a map[int32][]int32
    ;; mapping file number to a list of functions with code from that file.
    ^{:go/breaks [[3 651]]} (let [^{:tag (slice byte)} cutab (zero (slice byte))]
      (for [i (conv uint32 0)] (< i (.-nfunctab t)) (inc! i)
        (let [f (.funcData t i)
            ^{:line 636} entry (.entryPC f)
            ^{:line 637} filetab (.pcfile f)
            ^{:line 638} linetab (.pcln f)]

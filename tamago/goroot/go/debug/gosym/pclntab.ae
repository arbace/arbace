        ""))))



^{:go/end 652} (go/method go12LineToPC "go12LineToPC maps a (file, line) pair to a program counter for the Go 1.2+ pcln table.\n" [^{:tag (* LineTable)} t ^string file ^int line] :results [^uint64 pc]

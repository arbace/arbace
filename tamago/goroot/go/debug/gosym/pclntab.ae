(go/type LineTable "A LineTable is a data structure mapping program counters to line numbers.\n\nIn Go 1.1 and earlier, each function (represented by a [Func]) had its own LineTable,\nand the line number corresponded to a numbering of all source lines in the\nprogram, across all files. That absolute line number would then have to be\nconverted separately to a file name and line number within the file.\n\nIn Go 1.2, the format of the data changed so that there is a single LineTable\nfor the entire program, shared by all Funcs, and there are no absolute line\nnumbers, just line numbers within specific files.\n\nFor the most part, LineTable's methods should be treated as an internal\ndetail of the package; callers should use the methods on [Table] instead.\n" (struct
    ^{:line 45 :tag (slice byte)} Data
    ^{:line 46 :tag uint64} PC
    ^{:line 47 :tag int} Line


    ^{:line 50 :tag sync/Mutex :doc "This mutex is used to keep parsing of pclntab synchronous.\n"} mu


    ^{:line 53 :tag version :doc "Contains the version of the pclntab section.\n"} version


    ^{:line 56 :tag binary/ByteOrder :doc "Go 1.2/1.16/1.18 state\n"} binary
    ^{:line 57 :tag uint32} quantum
    ^{:line 58 :tag uint32} ptrsize
    ^{:line 59 :tag uint64} textStart ; address of runtime.text symbol (1.18+)
    ^{:line 60 :tag (slice byte)} funcnametab
    ^{:line 61 :tag (slice byte)} cutab
    ^{:line 62 :tag (slice byte)} funcdata
    ^{:line 63 :tag (slice byte)} functab
    ^{:line 64 :tag uint32} nfunctab
    ^{:line 65 :tag (slice byte)} filetab
    ^{:line 66 :tag (slice byte)} pctab ; points to the pctables.
    ^{:line 67 :tag uint32} nfiletab
    ^{:line 68 :tag (map uint32 string)} funcNames ; cache the function names
    ^{:line 69 :tag (map uint32 string)} strings ; interned substrings of Data, keyed by offset



    ^{:line 73 :tag (map string uint32) :doc "fileMap varies depending on the version of the object file.\nFor ver12, it maps the name to the index in the file table.\nFor ver116, it maps the name to the offset in filetab.\n"} fileMap))






(go/const ^{:val 1 :doc "NOTE(rsc): This is wrong for GOARCH=arm, which uses a quantum of 4,\nbut we have no idea whether we're using arm or not. This only\nmatters in the old (pre-Go 1.2) symbol table format, so it's not worth\nfixing.\n"} oldQuantum 1)

^{:go/end 115} (go/method parse [^{:tag (* LineTable)} t ^uint64 targetPC ^int targetLine] :results [^{:tag (slice byte)} b ^uint64 pc ^int line]
  ;; The PC/line table can be thought of as a sequence of
  ;;  <pc update>* <line update>
  ;; batches. Each update batch results in a (pc, line) pair,
  ;; where line applies to every PC from pc up to but not
  ;; including the pc of the next pair.
  ;;
  ;; Here we process each update individually, which simplifies
  ;; the code, but makes the corner cases more confusing.
  (set! (values b pc line) (values (.-Data t) (.-PC t) (.-Line t)))
  (while (and (<= pc targetPC) (!= line targetLine) (> (len b) 0))
    (let [code (aget b 0)]
      (set! b (subslice b 1))
      (switch
        (case [(== code 0)]
          (when (< (len b) 4)
            (set! b (subslice b 0 0))
            (break))

          (let [val (.Uint32 binary/BigEndian b)]
            (set! b (subslice b 4))
            (set! line + (conv int val))))
        (case [(<= code 64)]
          (set! line + (conv int code)))
        (case [(<= code 128)]
          (set! line - (conv int (- code 64))))
        (default
          (set! pc + (* oldQuantum (conv uint64 (- code 128))))
          (continue)))

      (set! pc + oldQuantum)))

  (return b pc line))



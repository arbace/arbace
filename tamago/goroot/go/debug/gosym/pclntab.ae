              (return pc)))))


      0)))



^{:go/end 678} (go/method initFileMap "initFileMap initializes the map from file name to file number.\n" [^{:tag (* LineTable)} t]
  (.Lock (.-mu t))
  (defer (.Unlock (.-mu t)))

  (when (!= (.-fileMap t) nil)
    (return))

  (let [m (make (map string uint32))]

    (if (== (.-version t) ver12)
      (for [i (conv uint32 1)] (< i (.-nfiletab t)) (inc! i)
        (let [s (.string t (.Uint32 (.-binary t) (subslice (.-filetab t) (* 4 i))))]
          (aset m s i)))


      (let [^uint32 pos (zero uint32)]
        (for [i (conv uint32 0)] (< i (.-nfiletab t)) (inc! i)
          (let [s (.stringFrom t (.-filetab t) pos)]
            (aset m s pos)
            (set! pos + (conv uint32 (+ (len s) 1)))))))


    (set! (.-fileMap t) m)))





^{:go/end 694} (go/method go12MapFiles "go12MapFiles adds to m a key for every file in the Go 1.2 LineTable.\nEvery key maps to obj. That's not a very interesting map, but it provides\na way for callers to obtain the list of files in the program.\n" [^{:tag (* LineTable)} t ^{:tag (map string (* Obj))} m ^{:tag (* Obj)} obj]

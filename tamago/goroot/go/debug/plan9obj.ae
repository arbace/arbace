(ns go.debug.plan9obj
  (:require [arbace.go :as go]))

(go/package plan9obj
  :path "debug/plan9obj"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["file.go" "plan9obj.go"]
  :init-order [ErrNoSymbols]
  :positions :lines)

(load "plan9obj/file")
(load "plan9obj/plan9obj")

(ns go.debug.dwarf
  (:require [arbace.go :as go]))

(go/package dwarf
  :path "debug/dwarf"
  :files ["attr_string.go" "buf.go" "class_string.go" "const.go" "entry.go" "line.go" "open.go" "tag_string.go" "type.go" "typeunit.go" "unit.go"]
  :positions :lines)

(load "dwarf/attr_string")
(load "dwarf/buf")
(load "dwarf/class_string")
(load "dwarf/const")
(load "dwarf/entry")
(load "dwarf/line")
(load "dwarf/open")
(load "dwarf/tag_string")
(load "dwarf/type")
(load "dwarf/typeunit")
(load "dwarf/unit")

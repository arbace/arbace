(ns go.debug.dwarf
  (:require [arbace.go :as go]))

(go/package dwarf
  :path "debug/dwarf"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["attr_string.go" "buf.go" "class_string.go" "const.go" "entry.go" "line.go" "open.go" "tag_string.go" "type.go" "typeunit.go" "unit.go"]
  :init-order [_Attr_map _Class_index attrIsExprloc attrPtrClass knownOpcodeLengths ErrUnknownPC errSegmentSelector _Tag_index_0 _Tag_index_2 _Tag_index_4 _Tag_index_5]
  :positions :lines)

(load "dwarf/attr_string")
(load "dwarf/buf")
(load "dwarf/class_string")
(load "dwarf/const")
(load "dwarf/entry")
(load "dwarf/line")
(load "dwarf/open")
(load "dwarf/tag_string")
(load "dwarf/type")
(load "dwarf/typeunit")
(load "dwarf/unit")

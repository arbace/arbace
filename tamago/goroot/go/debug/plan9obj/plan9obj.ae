;; /*
;; * Plan 9 a.out constants and data structures
;; */

(in-ns 'go.debug.plan9obj) (go/file "plan9obj.go" :imports [])


(go/type prog "Plan 9 Program header.\n" (struct
    ^{:line 13 :tag uint32} Magic ; /* magic number */
    ^{:line 14 :tag uint32} Text ; /* size of text segment */
    ^{:line 15 :tag uint32} Data ; /* size of initialized data */
    ^{:line 16 :tag uint32} Bss ; /* size of uninitialized data */
    ^{:line 17 :tag uint32} Syms ; /* size of symbol table */
    ^{:line 18 :tag uint32} Entry ; /* entry point */
    ^{:line 19 :tag uint32} Spsz ; /* size of pc/sp offset table */
    ^{:line 20 :tag uint32} Pcsz)) ; /* size of pc/line number table */



(go/type sym "Plan 9 symbol table entries.\n" (struct
    ^{:line 25 :tag uint64} value
    ^{:line 26 :tag byte} typ
    ^{:line 27 :tag (slice byte)} name))


(go/const
  ^{:line 31} [^{:val 32768} Magic64 0x8000] ; 64-bit expanded header

  ^{:line 33} [^{:val 491} Magic386 (+ (* (+ (* 4 11) 0) 11) 7)]
  ^{:line 34} [^{:val 35479} MagicAMD64 (+ (* (+ (* 4 26) 0) 26) 7 Magic64)]
  ^{:line 35} [^{:val 1607} MagicARM (+ (* (+ (* 4 20) 0) 20) 7)])

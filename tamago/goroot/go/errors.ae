(ns go.errors
  (:require [arbace.go :as go]))

(go/package errors
  :path "errors"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["errors.go" "join.go" "wrap.go"]
  :init-order [ErrUnsupported errorType]
  :positions :lines)

(load "errors/errors")
(load "errors/join")
(load "errors/wrap")

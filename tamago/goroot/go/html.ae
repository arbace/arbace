(ns go.html
  (:require [arbace.go :as go]))

(go/package html
  :path "html"
  :config {:goos "tamago" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["entity.go" "escape.go"]
  :init-order [entityMaps replacementTable htmlEscaper]
  :positions :lines)

(load "html/entity")
(load "html/escape")

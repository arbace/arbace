# Arbace's version in a tarball made by git archive (GitHub's archives, Alpine's APKBUILD):
# git archive fills the two lines below through export-subst (.gitattributes) with the commit
# and its git describe --tags. In a git checkout they stay unfilled and the build asks git
# instead (bin/lib/version.bash).
commit $Format:%H$
describe $Format:%(describe:tags)$

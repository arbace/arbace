;; Tool-build variant of com.sun.tools.javac.Main (F6, doc/classes/JAVA-DEFERRED-TRIAGE.md, "As built: F6";
;; JCS95 (c)): read by j2g only, in the world of javac's tool build. javac's programmatic entry,
;; compile(String[]) and compile(String[], PrintWriter), runs javac's launcher, com.sun.tools.javac.main.Main,
;; over its JavacFileManager, which reads through java.nio.file's file systems, which the Go build does not
;; have. Here they are javac on Arbace's command line (overlay/jdk/javac/jdk.compiler's
;; jdk.internal.jrt.javac.Main, its runOnPlatform): the same arguments, javac's own options handed to
;; JavacTool's task, the file manager's served by Arbace's, against the platform javax.tools' system compiler
;; attributes against (the property jdk.internal.jrt.javac.platform), the diagnostics to System.err or to the
;; writer, javac's exit status. As the JDK's, compile(String[]) prints to System.err. Copyright (c) the Arbace
;; authors; Eclipse Public License 1.0.
(in-ns 'com.sun.tools.javac)

(j2g/variant Main
  (method ^:public ^:static compile ^int [^String/1 args]
    (jdk.internal.jrt.javac.Main/runOnPlatform args (PrintWriter. System/err true)))

  (method ^:public ^:static compile ^int [^String/1 args ^PrintWriter out]
    (jdk.internal.jrt.javac.Main/runOnPlatform args out)))

;; Tool-build variant of java.io.InputStreamReader (doc/classes/JAVA-FRONTEND-SURVEY.md, "As
;; built: JN2", JFS18): read by j2g only, in the world of javac's tool build. The constructor with
;; a CharsetDecoder (javac's PathFileObject.openReader), a class outside the shipped world: the
;; reader decodes with the decoder's charset, as jrt's readers decode (malformed input replaced);
;; with the decoder outside the world the call of its charset() is an operation-level stub.
;; Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'java.io)

(j2g/variant InputStreamReader
  (j2g/add
    (constructor ^:public [this ^InputStream in ^java.nio.charset.CharsetDecoder dec]
      (this. in (.charset dec)))))

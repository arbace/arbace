;; Tool-build variant of java.util.ResourceBundle (doc/classes/JAVA-FRONTEND-SURVEY.md, "As built:
;; JN7", JFS18): read by j2g only, in the world of javac's tool build. jrt's getBundle finds the
;; bundles that are classes (the java.class format, overlay/jdk/java.base/java/util/ResourceBundle.java);
;; the JDK build's tools also read bundles that are properties files on their class path
;; (build.tools.cldrconverter's OtherCommonLocales.properties, java.xml's messages): when no class
;; that is a bundle has the bundle's name, newBundle reads the resource NAME.properties (the bundle
;; name's dots as slashes, by Class.getResourceAsStream: the executable's resources, then
;; ARBACE_PATH) into a PropertyResourceBundle, as the JDK's default Control's java.properties format,
;; its text read as UTF-8 (the JDK's falls back to ISO-8859-1 on a malformed file). Copyright (c) the
;; Arbace authors; Eclipse Public License 1.0.
(in-ns 'java.util)

(j2g/variant ResourceBundle
  (method ^:private ^:static newBundle ^ResourceBundle [^String name]
    (let [^:mutable ^{:tag (Class ?)} c nil]
      (try
        (set! c (Class/forName name))
        (catch [ClassNotFoundException LinkageError] e (set! c nil)))
      (if (and (some? c) (.isAssignableFrom ResourceBundle c))
        (try
          (cast ResourceBundle (.newInstance (.getConstructor c)))
          (catch ReflectiveOperationException e nil))
        (let [in (.getResourceAsStream ResourceBundle (java-str "/" (.replace name \. \/) ".properties"))]
          (when-not (nil? in)
            (try
              (PropertyResourceBundle. (java.io.InputStreamReader. in java.nio.charset.StandardCharsets/UTF_8))
              (catch java.io.IOException e2 nil))))))))

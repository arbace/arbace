;; Tool-build variant of com.sun.tools.javac.main.JavacToolProvider (JCS159 (a), doc/classes/JAVA-DEFERRED-TRIAGE.md,
;; "As built: JCS159 (write-ahead)"): read by j2g only, in the world of javac's tool build. jdk26u's run is javac's
;; launcher (com.sun.tools.javac.main.Main) over its JavacFileManager, which reads through java.nio.file's file
;; systems, which the tool has not. Here run keeps javac's launcher when an argument is one of javac's
;; information options (Option's group INFO that prints and compiles nothing: --help, -X, --help-lint,
;; --version, --full-version and their spellings): javac's own text, which needs no file manager; any other
;; command line is javac on Arbace's (jdk.internal.jrt.javac.Main.runOnPlatform, as com.sun.tools.javac.Main's
;; variant, JavacMain.ae: the platform of the property jdk.internal.jrt.javac.platform), its diagnostics to err,
;; javac's exit status. name and description are jdk26u's. Copyright (c) the Arbace authors; Eclipse Public
;; License 1.0.
(in-ns 'com.sun.tools.javac.main)

(j2g/variant JavacToolProvider
  (method ^:public run ^int [this ^PrintWriter out ^PrintWriter err & ^String/1 args]
    (let [info (java.util.EnumSet/of Option/HELP Option/X Option/HELP_LINT Option/VERSION Option/FULLVERSION)
          ^:mutable ^boolean asks false]
      (for-each [^String a args]
        (let [o (Option/lookup a)]
          (when (and (some? o) (.contains info o)) (set! asks true))))
      (if asks
          (let [compiler (Main. "javac" out err)] (.-exitCode (.compile compiler args)))
          (jdk.internal.jrt.javac.Main/runOnPlatform args err)))))

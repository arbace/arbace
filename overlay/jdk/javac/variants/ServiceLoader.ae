;; Tool-build variant of java.util.ServiceLoader (JCS159 (a), doc/classes/JAVA-DEFERRED-TRIAGE.md, "As built: JCS159
;; (write-ahead)"): read by j2g only, in the world of javac's tool build, over jrt's own ServiceLoader of that world
;; (overlay/jdk/javac/java.base, JN2: no class loaders, no META-INF/services, no provider). One service has a
;; provider, as on a JDK image: java.util.spi.ToolProvider has javac's (com.sun.tools.javac.main.JavacToolProvider,
;; JavacToolProvider.ae), so ToolProvider.findFirst("javac") and ServiceLoader.load(ToolProvider.class) find it
;; (jdk26u's java.util.spi.ToolProvider, unchanged, iterates the loader); since JCS50 (b)
;; (doc/classes/JAVA-CONFORMANCE-SURVEY.md, "As built: JCS50 (b)") com.sun.tools.javac.platform.PlatformProvider has
;; javac on Arbace's (jdk.internal.jrt.javac.ReleasePlatforms, the platform's ct.sym), which PlatformUtils finds for
;; --release N as javac's finds JDKPlatformProvider; since JCS52 (a) (doc/classes/JAVA-CONFORMANCE-SURVEY.md, "As
;; built: JCS52 (a)") com.sun.tools.doclint.DocLint has jdk.javadoc's (jdk.javadoc.internal.doclint.DocLint, which
;; jdk.javadoc's module-info provides), found by DocLint.newDocLint's stream (jrt's stream() gives this iterator's
;; providers) for -Xdoclint as on a JDK image; the others still find none (no plugin or processor).
;; Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'java.util)

(j2g/variant ServiceLoader
  (j2g/add
    (method ^:private providers ^{:tag (List S)} [this]
      (cond
        (identical? service java.util.spi.ToolProvider)
        (cast List (List/of (com.sun.tools.javac.main.JavacToolProvider.)))
        (identical? service com.sun.tools.javac.platform.PlatformProvider)
        (cast List (List/of (jdk.internal.jrt.javac.ReleasePlatforms.)))
        (identical? service com.sun.tools.doclint.DocLint)
        (cast List (List/of (jdk.javadoc.internal.doclint.DocLint.)))
        :else (List/of))))

  (method ^:public iterator ^{:tag (Iterator S)} [this]
    (.iterator (.providers this)))

  (method ^:public findFirst ^{:tag (Optional S)} [this]
    (let [ps (.providers this)]
      (if (.isEmpty ps) (Optional/empty) (Optional/of (.get ps 0))))))

;; Tool-build variant of java.util.ServiceLoader (JCS159 (a), doc/classes/JAVA-DEFERRED-TRIAGE.md, "As built: JCS159
;; (write-ahead)"): read by j2g only, in the world of javac's tool build, over jrt's own ServiceLoader of that world
;; (overlay/jdk/javac/java.base, JN2: no class loaders, no META-INF/services, no provider). One service has a
;; provider, as on a JDK image: java.util.spi.ToolProvider has javac's (com.sun.tools.javac.main.JavacToolProvider,
;; JavacToolProvider.ae), so ToolProvider.findFirst("javac") and ServiceLoader.load(ToolProvider.class) find it
;; (jdk26u's java.util.spi.ToolProvider, unchanged, iterates the loader); the others still find none, so javac runs
;; as before (no plugin, doclint, processor or platform provider). Copyright (c) the Arbace authors; Eclipse Public
;; License 1.0.
(in-ns 'java.util)

(j2g/variant ServiceLoader
  (j2g/add
    (method ^:private providers ^{:tag (List S)} [this]
      (if (identical? service java.util.spi.ToolProvider)
          (cast List (List/of (com.sun.tools.javac.main.JavacToolProvider.)))
          (List/of))))

  (method ^:public iterator ^{:tag (Iterator S)} [this]
    (.iterator (.providers this)))

  (method ^:public findFirst ^{:tag (Optional S)} [this]
    (let [ps (.providers this)]
      (if (.isEmpty ps) (Optional/empty) (Optional/of (.get ps 0))))))

;; Tool-build variant of jdk.xml.internal.SecuritySupport (doc/classes/JAVA-FRONTEND-SURVEY.md, "As
;; built: JN7", JFS18): read by j2g only, in the world of javac's tool build, where java.xml's SAX
;; parser is converted for the JDK build's tools (build.tools.cldrconverter). jrt's threads have no
;; context class loader (Thread.getContextClassLoader is not jrt's): the context loader is the system
;; class loader, which is what these methods give on a JVM whose threads have none. Copyright (c)
;; the Arbace authors; Eclipse Public License 1.0.
(in-ns 'jdk.xml.internal)

(j2g/variant SecuritySupport
  (method ^:public ^:static getContextClassLoader ^ClassLoader []
    (ClassLoader/getSystemClassLoader))

  (method ^:public ^:static getClassLoader ^ClassLoader []
    (ClassLoader/getSystemClassLoader)))

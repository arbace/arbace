;; Tool-build variant of java.nio.file.Path (doc/classes/JAVA-FRONTEND-SURVEY.md, "As built:
;; JN2", JFS18): read by j2g only, in the world of javac's tool build. getFileSystem, which javac's
;; file package names; java.nio.file.FileSystem is in javac's world (jdk/javac), not the shipped
;; program's. jrt's paths have no file system object: it throws, and javac's Arbace file manager
;; (JFS5 (b)) never calls it. Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'java.nio.file)

(j2g/variant Path
  (j2g/add
    (method ^:default getFileSystem ^FileSystem [this]
      (throw (UnsupportedOperationException. "java.nio.file.Path.getFileSystem: not in jrt")))))

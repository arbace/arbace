;; Tool-build variant of java.util.Scanner (doc/classes/JAVA-FRONTEND-SURVEY.md, "As built: JN7",
;; JFS18): read by j2g only, in the world of javac's tool build, where jdk26u's Scanner is
;; converted for the JDK build's tools (build.tools.spp's Scanner over a FileInputStream). Its File
;; constructors read through FileInputStream.getChannel, which jrt's FileInputStream has not: they
;; read the file through the stream itself, decoded as the channel's readers decode (the default
;; charset, UTF-8; the decoder's own charset). Copyright (c) the Arbace authors; Eclipse Public
;; License 1.0.
(in-ns 'java.util)

(j2g/variant Scanner
  (constructor :throws [FileNotFoundException] ^:public [this ^File source]
    (this. ^InputStream (FileInputStream. source)))

  (constructor :throws [FileNotFoundException] ^:private [this ^File source ^CharsetDecoder dec]
    (this. ^Readable (InputStreamReader. (FileInputStream. source) (.charset dec)) WHITESPACE_PATTERN)))

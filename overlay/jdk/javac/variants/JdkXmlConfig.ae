;; Tool-build variant of jdk.xml.internal.JdkXmlConfig's CatalogHolder (doc/classes/JAVA-FRONTEND-SURVEY.md,
;; "As built: JN7", JFS18): read by j2g only, in the world of javac's tool build, where java.xml's SAX
;; parser is converted for the JDK build's tools. The JDK's built-in catalog is java.xml's resource
;; jdk/xml/internal/jdkcatalog/JDKCatalog.xml, which the JDK names by its jrt:/ URL; the Go build has
;; no jrt:/ file system or URL handler, so the catalog is the same resource read from a directory on
;; ARBACE_PATH (bin/jrt-convert's generate step puts jdk26u's src/java.xml/share/classes there: the
;; module's resources as the JDK image holds them), by its file: URI, else the JDK's URL (which then
;; fails as on a JDK without the resource). Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'jdk.xml.internal)

(j2g/variant JdkXmlConfig$CatalogHolder
  (field ^:private ^:static ^:final ^Catalog JDKCATALOG
    (CatalogManager/catalog (CatalogFeatures/defaults) (CatalogHolder/jdkCatalogUri)))

  (j2g/add
    (method ^:private ^:static jdkCatalogUri ^URI []
      (let [path (System/getenv "ARBACE_PATH")]
        (when (some? path)
          (let [dirs (.split path ":")]
            (loop [^int i 0]
              (when (< i (alength dirs))
                (let [f (File. (aget dirs i) JdkXmlConfig/JDKCATALOG_FILE)]
                  (when (.isFile f) (return (.toURI f))))
                (recur (unchecked-inc-int i)))))))
      (URI/create JdkXmlConfig/JDKCATALOG_URL))))

;; Tool-build variant of java.nio.file.Files (doc/classes/JAVA-FRONTEND-SURVEY.md, "As built:
;; JN2", JFS18): read by j2g only, in the world of javac's tool build (bin/javac-vendor,
;; bin/arbace-go --build-java), not in the shipped program's. The members javac's file package
;; names (JavacFileManager, PathFileObject, Locations, CacheFSInfo, FSInfo, JRTIndex) beyond jrt's
;; Files: walks, attributes and links, whose types (FileVisitor, BasicFileAttributes, FileTime)
;; are outside the shipped world. They throw (but the walks, JN7: below): javac on Arbace reads its files through an Arbace
;; JavaFileManager (JFS5 (b)), which never calls them; javac's classes that name them are then
;; analyzed and translated. Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'java.nio.file)

(j2g/variant Files
  (j2g/add
    (method ^:public ^:static list :throws [IOException] ^{:tag (Stream Path)} [^Path dir]
      (throw (UnsupportedOperationException. "java.nio.file.Files.list: not in jrt"))))
  ;; (JN7) the walks build.tools.cldrconverter reads the time-zone database's directory with: the
  ;; tree depth first, a directory before its entries, the entries in the order jrt lists them
  ;; (File.list: sorted, where the JDK's are the file system's order), links followed (as with
  ;; FOLLOW_LINKS; without it the JDK does not follow them), eagerly
  (j2g/add
    (method ^:public ^:static walk :throws [IOException] ^{:tag (Stream Path)} [^Path start
                                                                                & ^FileVisitOption/1 options]
      (Files/walk start Integer/MAX_VALUE options)))
  (j2g/add
    (method ^:public ^:static walk :throws [IOException] ^{:tag (Stream Path)} [^Path start ^int maxDepth
                                                                                & ^FileVisitOption/1 options]
      (when (< maxDepth 0) (throw (IllegalArgumentException. "'maxDepth' is negative")))
      (when-not (.exists (.toFile start)) (throw (NoSuchFileException. (.toString start))))
      (let [out (java.util.ArrayList.)]
        (Files/walkInto out start maxDepth)
        (.stream out))))
  (j2g/add
    (method ^:private ^:static walkInto ^void [^{:tag (java.util.List Path)} out ^Path p ^int depth]
      (.add out p)
      (when (and (> depth 0) (.isDirectory (.toFile p)))
        (let [names (.list (.toFile p))]
          (when (some? names)
            (loop [^int i 0]
              (when (< i (alength names))
                (Files/walkInto out (.resolve p (aget names i)) (unchecked-dec-int depth))
                (recur (unchecked-inc-int i)))))))))
  (j2g/add
    (method ^:public ^:static find :throws [IOException] ^{:tag (Stream Path)} [^Path start ^int maxDepth
                                                                                ^java.util.function.BiPredicate matcher
                                                                                & ^FileVisitOption/1 options]
      (throw (UnsupportedOperationException. "java.nio.file.Files.find: not in jrt"))))
  (j2g/add
    (method ^:public ^:static walkFileTree :throws [IOException] ^Path [^Path start ^FileVisitor visitor]
      (throw (UnsupportedOperationException. "java.nio.file.Files.walkFileTree: not in jrt"))))
  (j2g/add
    (method ^:public ^:static walkFileTree :throws [IOException] ^Path [^Path start ^java.util.Set options
                                                                         ^int maxDepth ^FileVisitor visitor]
      (throw (UnsupportedOperationException. "java.nio.file.Files.walkFileTree: not in jrt"))))
  (j2g/add
    (method ^:public ^:static readAttributes :throws [IOException] :type-params [(A extends java.nio.file.attribute.BasicFileAttributes)]
      ^A [^Path path ^{:tag (Class A)} type & ^LinkOption/1 options]
      (throw (UnsupportedOperationException. "java.nio.file.Files.readAttributes: not in jrt"))))
  (j2g/add
    (method ^:public ^:static isSymbolicLink ^boolean [^Path path]
      (throw (UnsupportedOperationException. "java.nio.file.Files.isSymbolicLink: not in jrt"))))
  (j2g/add
    (method ^:public ^:static readSymbolicLink :throws [IOException] ^Path [^Path link]
      (throw (UnsupportedOperationException. "java.nio.file.Files.readSymbolicLink: not in jrt"))))
  (j2g/add
    (method ^:public ^:static getLastModifiedTime :throws [IOException] ^java.nio.file.attribute.FileTime [^Path path
                                                                                                          & ^LinkOption/1 options]
      (throw (UnsupportedOperationException. "java.nio.file.Files.getLastModifiedTime: not in jrt")))))

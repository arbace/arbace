;; Go-build variant of sun.security.provider.certpath.OCSP (J2G-SPEC §4.6;
;; doc/classes/JAVA-DEFERRED-TRIAGE.md, F2, "As built: F2 (write-ahead)"): read by j2g only.
;; getOCSPBytes, which sends the request to the responder over java.net.HttpURLConnection (not in
;; the Go build), fails with the IOException jdk26u's throws when the responder cannot be reached,
;; so that revocation checking ends as it does offline (RevocationChecker's soft fail, or "Unable to
;; determine revocation status"). Arbace's own code. The replacing members are jdk26u's (baf63fb;
;; Copyright (c) Oracle and/or its affiliates, GPL 2 with the Classpath Exception: LICENSE.md) as
;; repr/java converts them, with the change named; the rest Copyright (c) the Arbace authors;
;; Eclipse Public License 1.0.
(in-ns 'sun.security.provider.certpath)

(j2g/variant OCSP
  (method ^:public ^:static getOCSPBytes :throws [IOException] ^byte/1 [^{:tag (List CertId)} certIds
                                                                        ^URI responderURI
                                                                        ^{:tag (List Extension)} extensions]
    (throw (IOException. (java-str "Unable to reach the OCSP responder " responderURI
                                  ": the Go build has no HTTP client")))))

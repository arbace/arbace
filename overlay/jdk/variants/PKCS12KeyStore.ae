;; Go-build variant of sun.security.pkcs12.PKCS12KeyStore (J2G-SPEC §4.6;
;; doc/classes/JAVA-DEFERRED-TRIAGE.md, F2, "As built: F2 (write-ahead)"): read by j2g only. The key
;; specs' clearing reads JavaSecuritySpecAccess and JavaxCryptoSpecAccess from F1's
;; jdk.internal.jrt.CryptoAccess (java-jc9-jca), which EncodedKeySpec's and SecretKeySpec's static
;; initializers set, in place of SharedSecrets (jrt's does not hold them). The replacing members are
;; jdk26u's (baf63fb; Copyright (c) Oracle and/or its affiliates, GPL 2 with the Classpath
;; Exception: LICENSE.md) as repr/java converts them, with the change named; the rest Copyright (c)
;; the Arbace authors; Eclipse Public License 1.0.
(in-ns 'sun.security.pkcs12)

(j2g/variant PKCS12KeyStore
  (method ^:private internalGetKey :throws [NoSuchAlgorithmException UnrecoverableKeyException] ^Key [this
                                                                                                      ^Entry entry
                                                                                                      ^char/1 password]
    (let [^:mutable ^Key key nil]
      (when-not (not (instance? KeyEntry entry))
        (let [^:mutable ^byte/1 encrBytes nil]
          (cond
            (instance? PrivateKeyEntry entry)
              (set! encrBytes (.-protectedPrivKey (cast PrivateKeyEntry entry)))
            (instance? SecretKeyEntry entry)
              (set! encrBytes (.-protectedSecretKey (cast SecretKeyEntry entry)))
            :else (throw (UnrecoverableKeyException. "Error locating key")))
          (let [^:mutable ^byte/1 encryptedKey nil
                ^:mutable ^AlgorithmParameters algParams nil
                ^:mutable ^AlgorithmId aid nil]
            (try
              (let [encrInfo (EncryptedPrivateKeyInfo. encrBytes)]
                (set! encryptedKey (.getEncryptedData encrInfo))
                (let [val (DerValue. (.encode (.getAlgorithm encrInfo)))
                      in (.toDerInputStream val)]
                  (set! aid (AlgorithmId/parse val))
                  (set! algParams (.getParameters aid))))
              (catch IOException ioe
                (let [uke (UnrecoverableKeyException.
                            (java-str "Private key not stored as PKCS#8 EncryptedPrivateKeyInfo: "
                                      ioe))]
                  (.initCause uke ioe)
                  (throw uke))))
            (try
              (let [^:mutable ^PBEParameterSpec pbeSpec nil
                    ^:mutable ^int ic 0]
                (if (some? algParams)
                    (do
                      (try
                        (set!
                          pbeSpec
                          (cast PBEParameterSpec (.getParameterSpec algParams PBEParameterSpec)))
                        (catch InvalidParameterSpecException ipse
                          (throw (IOException. "Invalid PBE algorithm parameters"))))
                      (set! ic (.getIterationCount pbeSpec))
                      (when (> ic MAX_ITERATION_COUNT)
                        (throw (IOException. "key PBE iteration count too large"))))
                    (set! ic 0))
                (set!
                  key
                  (cast
                    Key
                    (RetryWithZero/run
                      (let [aid aid
                            algParams algParams
                            encryptedKey encryptedKey
                            ic ic]
                        (lambda RetryWithZero ^Key [^char/1 pass]
                          (let [cipher (Cipher/getInstance (.getName aid))
                                skey (.getPBEKey this pass)]
                            (try
                              (.init cipher Cipher/DECRYPT_MODE skey algParams)
                              (finally (KeyUtil/destroySecretKeys skey)))
                            (let [keyInfo (.doFinal cipher encryptedKey)
                                  val (DerValue. keyInfo)]
                              (try
                                (let [in (.toDerInputStream val)
                                      i (.getInteger in)
                                      value (.getSequence in 2)]
                                  (when (or (< (alength value) 1) (> (alength value) 2))
                                    (throw (IOException. "Invalid length for AlgorithmIdentifier")))
                                  (let [algId (AlgorithmId. (.getOID (aget value 0)))
                                        ^:mutable keyAlgo (.getName algId)]
                                    (if (instance? PrivateKeyEntry entry)
                                        (let [kfac (KeyFactory/getInstance keyAlgo)
                                              kspec (PKCS8EncodedKeySpec. keyInfo)]
                                          (try
                                            (let [^Key tmp (.generatePrivate kfac kspec)]
                                              (when (some? debug)
                                                (.println
                                                  debug
                                                  (java-str
                                                    "Retrieved a protected private key at alias '"
                                                    (.-alias entry)
                                                    "' ("
                                                    (.getName aid)
                                                    " iterations: "
                                                    ic
                                                    ")")))
                                              tmp)
                                            (finally
                                              (.clearEncodedKeySpec
                                                (jdk.internal.jrt.CryptoAccess/javaSecuritySpecAccess)
                                                kspec))))
                                        (let [keyBytes (.getOctetString in)]
                                          (cond
                                            (.equals keyAlgo (.stdName KnownOIDs/OIW_DES_CBC))
                                              (set! keyAlgo "DES")
                                            (.equals
                                              keyAlgo
                                              (.stdName KnownOIDs/RC2$CBC$PKCS5Padding))
                                              (set! keyAlgo "RC2"))
                                          (let [secretKeySpec (SecretKeySpec. keyBytes keyAlgo)]
                                            (try
                                              (let [^:mutable ^Key tmp nil]
                                                (if (.startsWith keyAlgo "PBE")
                                                    (let [sKeyFactory (SecretKeyFactory/getInstance
                                                                        keyAlgo)
                                                          pbeKeySpec (.getKeySpec
                                                                       sKeyFactory
                                                                       secretKeySpec
                                                                       PBEKeySpec)]
                                                      (try
                                                        (set!
                                                          tmp
                                                          (.generateSecret sKeyFactory pbeKeySpec))
                                                        (finally
                                                          (.clearPassword
                                                            (cast PBEKeySpec pbeKeySpec))
                                                          (.clearSecretKeySpec
                                                            (jdk.internal.jrt.CryptoAccess/javaxCryptoSpecAccess)
                                                            secretKeySpec))))
                                                    (set! tmp secretKeySpec))
                                                (when (some? debug)
                                                  (.println
                                                    debug
                                                    (java-str
                                                      "Retrieved a protected secret key at alias '"
                                                      (.-alias entry)
                                                      "' ("
                                                      (.getName aid)
                                                      " iterations: "
                                                      ic
                                                      ")")))
                                                tmp)
                                              (finally (Arrays/fill keyBytes (unchecked-byte 0)))))))))
                                (finally (.clear val) (Arrays/fill keyInfo (unchecked-byte 0))))))))
                      password))))
              (catch Exception e
                (let [uke (UnrecoverableKeyException. (java-str "Get Key failed: " (.getMessage e)))]
                  (.initCause uke e)
                  (throw uke))))
            key))))))

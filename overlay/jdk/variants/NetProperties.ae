;; Go-build variant of sun.net.NetProperties (J2G-SPEC §4.6; doc/classes/JAVA-DEFERRED-TRIAGE.md, F12, "As
;; built: F12 (write-ahead)"): read by j2g only. The JDK reads the networking defaults from
;; $JAVA_HOME/conf/net.properties; the Go build embeds the same file (bin/jrt-convert's data step makes it
;; as make/modules/java.base/Copy.gmk does, src/java.base/share/conf/net.properties then the unix one) as
;; the resource conf/net.properties, read here through Class.getResourceAsStream, as LogManager's variant
;; reads conf/logging.properties (F5). As jdk26u, a file it cannot read leaves no defaults. Copyright (c)
;; the Arbace authors; Eclipse Public License 1.0.
(in-ns 'sun.net)

(j2g/variant NetProperties
  (method ^:private ^:static loadDefaultProperties ^Properties [^Properties props]
    (try
      (let [in (.getResourceAsStream NetProperties "/conf/net.properties")]
        (when (some? in)
          (with-resources [^java.io.InputStream r in] (.load props r))))
      (catch Exception e))
    props))

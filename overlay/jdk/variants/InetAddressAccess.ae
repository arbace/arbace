;; Go-build variant of java.net.InetAddress, its second file (J2G-SPEC §4.6;
;; doc/classes/JAVA-DEFERRED-TRIAGE.md, F3, "As built: F3 (write-ahead)"): read by j2g only, after
;; InetAddress.ae (j2g applies a class's variant files in their order). A static initializer added: the
;; JDK's access object (JavaNetInetAddressAccess, jdk26u's anonymous class of InetAddress's static
;; initializer) given to jrt's jdk.internal.jrt.NetAccess in place of SharedSecrets, which
;; InetAddress.ae's first initializer leaves out; SunJSSE's SSLSocketImpl reads it (the original host
;; name). Kept apart from InetAddress.ae so that the world's file and JC9b's stay untouched. The replacing members are jdk26u's (baf63fb; Copyright (c) Oracle and/or its affiliates, GPL 2
;; with the Classpath Exception: LICENSE.md) as repr/java converts them, with the change named; the rest
;; Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'java.net)

(j2g/variant InetAddress
  (j2g/add
    (static-initializer
      (jdk.internal.jrt.NetAccess/setJavaNetInetAddressAccess
        (anon JavaNetInetAddressAccess []
          (method ^:public getOriginalHostName ^String [this ^InetAddress ia]
            (.getOriginalHostName (.-holder ia)))

          (method ^:public addressValue ^int [this ^Inet4Address inet4Address]
            (.addressValue inet4Address))

          (method ^:public addressBytes ^byte/1 [this ^Inet6Address inet6Address]
            (.addressBytes inet6Address)))))))

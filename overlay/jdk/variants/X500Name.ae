;; Go-build variant of sun.security.x509.X500Name (J2G-SPEC §4.6;
;; doc/classes/JAVA-DEFERRED-TRIAGE.md, F2, "As built: F2 (write-ahead)"): read by j2g only.
;; jdk26u's asX500Principal and asX500Name read SharedSecrets' JavaxSecurityAccess, which
;; X500Principal's static initializer sets (its variant); the variant reads it from jrt's holder
;; instead. The replacing members are jdk26u's (baf63fb; Copyright (c) Oracle and/or its affiliates,
;; GPL 2 with the Classpath Exception: LICENSE.md) as repr/java converts them, with the change
;; named; the rest Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'sun.security.x509)

(j2g/variant X500Name
  (method ^:public asX500Principal ^X500Principal [this]
    (when (nil? x500Principal)
      (set! x500Principal (.asX500Principal (jdk.internal.jrt.PkiAccess/javaxSecurityAccess) this)))
    x500Principal)

  (method ^:public ^:static asX500Name ^X500Name [^X500Principal p]
    (.asX500Name (jdk.internal.jrt.PkiAccess/javaxSecurityAccess) p)))

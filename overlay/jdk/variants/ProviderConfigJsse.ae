;; Go-build variant of sun.security.jca.ProviderConfig, its second file (J2G-SPEC §4.6;
;; doc/classes/JAVA-DEFERRED-TRIAGE.md, F3, "As built: F3 (write-ahead)"): read by j2g only, after
;; ProviderConfig.ae (j2g applies a class's variant files in their order, and a member replaced twice is
;; the second's). getProvider again, F1's (SUN, SunRsaSign, SunJCE, SunEC constructed directly) with
;; SunJSSE beside them: by its name, as the JDK's switch, and by its class name, which the JDK's default
;; branch loads by name (the Go build loads no provider by name). Kept apart from F1's file
;; so that the branches merge without conflict; once F1 and F3 are both on next, the two may be folded
;; into ProviderConfig.ae. The replacing method keeps jdk26u's code where it keeps it (baf63fb; Copyright
;; (c) Oracle and/or its affiliates, GPL 2 with the Classpath Exception: LICENSE.md); the rest Copyright
;; (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'sun.security.jca)

(j2g/variant ProviderConfig
  (method getProvider ^Provider [this]
    (let [^:mutable ^Provider p provider]
      (when (some? p)
        (return p))
      (locking this
        (set! p provider)
        (when (some? p)
          (return p))
        (when-not (.shouldLoad this)
          (return nil))
        (set! p (switch provName
                  ("SUN" "sun.security.provider.Sun") (sun.security.provider.Sun.)
                  ("SunRsaSign" "sun.security.rsa.SunRsaSign") (sun.security.rsa.SunRsaSign.)
                  ("SunJCE" "com.sun.crypto.provider.SunJCE") (com.sun.crypto.provider.SunJCE.)
                  "SunEC" (sun.security.ec.SunEC.)
                  ("SunJSSE" "sun.security.ssl.SunJSSE") (sun.security.ssl.SunJSSE.)
                  (do (.disableLoad this) nil)))
        (set! provider p))
      p)))

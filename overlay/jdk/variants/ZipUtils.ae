;; Go-build variant of java.util.zip.ZipUtils (J2G-SPEC §4.6; doc/classes/JAVA-CONFORMANCE-SURVEY.md,
;; "As built: JC6b"): read by j2g only. The JavaNioAccess of SharedSecrets (direct buffers'
;; addresses and sessions, outside the Go build's world) is cut: the checksums' and the
;; compressors' direct-buffer branches, its only users, are cut or never taken in the Go build
;; (the variants Adler32.ae, CRC32.ae, CRC32C.ae; jrt's Inflater and Deflater). Copyright (c) the
;; Arbace authors; Eclipse Public License 1.0.
(in-ns 'java.util.zip)

(j2g/variant ZipUtils
  (j2g/cut (field ^:static ^:final ^jdk.internal.access.JavaNioAccess NIO_ACCESS)))

;; Go-build variant of sun.management.BaseOperatingSystemImpl (J2G-SPEC §4.6; doc/classes/JAVA-DEFERRED-TRIAGE.md,
;; F13 slice 5): read by j2g only. getSystemLoadAverage asks Unsafe.getLoadAverage in jdk26u (getloadavg in the
;; JVM); jrt's Unsafe has no load average: the one-minute load average of jdk.internal.jrt.HostManagement
;; (/proc/loadavg), -1.0 when it cannot be read, as jdk26u's. Copyright (c) the Arbace authors; Eclipse Public
;; License 1.0.
(in-ns 'sun.management)

(j2g/variant BaseOperatingSystemImpl
  (method ^:public getSystemLoadAverage ^double [this]
    (jdk.internal.jrt.HostManagement/loadAverage0)))

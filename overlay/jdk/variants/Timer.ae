;; Go-build variant of java.util.Timer (J2G-SPEC §4.6; doc/classes/JAVA-DEFERRED-TRIAGE.md, F16,
;; "As built: F16 (write-ahead)"): read by j2g only. The timer's ThreadReaper, which jdk26u
;; registers with a Cleaner so that the timer thread ends once the timer is unreachable and its
;; queue empty, is kept in the field instead and run by cancel, as the Cleanable's clean runs it
;; (java.lang.ref.Cleaner and jdk.internal.ref.CleanerFactory are not in the Go build: F17, as
;; ZipFile's, JC6b). The difference: an unreachable timer that was never cancelled keeps its thread,
;; as a non-daemon thread with nothing to run (the JDK's ends it at the next collection). The
;; replacing members are jdk26u's (baf63fb; Copyright (c) Oracle and/or its affiliates, GPL 2 with
;; the Classpath Exception: LICENSE.md) as repr/java converts them, with the change named; the rest
;; Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'java.util)

(j2g/variant Timer
  (field ^:private ^:final ^ThreadReaper cleanup)

  (constructor ^:public [this ^String name ^boolean isDaemon]
    (set! (.-cleanup this) (ThreadReaper. queue thread))
    (.setName thread name)
    (.setDaemon thread isDaemon)
    (.start thread))

  (method ^:public cancel ^void [this]
    (locking queue (.clear queue) (.run cleanup))))

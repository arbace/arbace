;; Go-build variant of sun.security.provider.SunEntries (J2G-SPEC §4.6;
;; doc/classes/JAVA-DEFERRED-TRIAGE.md, F2 and F4, "As built: F2 (write-ahead)"): read by j2g only,
;; beside SunEntries.ae (F1's constructor, cut after the message digests). addPkiEntries, which
;; Sun's constructor calls after it (Sun.ae), adds the rest of jdk26u's constructor: the services
;; of PKI (F2) and JAAS's login configuration (F4), with the same aliases and attributes;
;; sun.security.provider.PkiServices (overlay) constructs them. The added statements are jdk26u's
;; (baf63fb; Copyright (c) Oracle and/or its affiliates, GPL 2 with the Classpath Exception:
;; LICENSE.md) as repr/java converts them; the rest Copyright (c) the Arbace authors; Eclipse
;; Public License 1.0.
(in-ns 'sun.security.provider)

(j2g/variant SunEntries
  (j2g/add
    (method addPkiEntries ^void [this ^Provider p]
      (let [^{:tag (HashMap String String)} attrs (HashMap. 3)]
        (.put attrs "ThreadSafe" "true")
        (.addWithAlias this p "CertificateFactory" "X.509" "sun.security.provider.X509Factory" attrs)
        (.add this p "KeyStore" "PKCS12" "sun.security.pkcs12.PKCS12KeyStore$DualFormatPKCS12")
        (.add this p "KeyStore" "JKS" "sun.security.provider.JavaKeyStore$DualFormatJKS" attrs)
        (.add this p "KeyStore" "CaseExactJKS" "sun.security.provider.JavaKeyStore$CaseExactJKS" attrs)
        (.add this p "KeyStore" "DKS" "sun.security.provider.DomainKeyStore$DKS" attrs)
        (.add this p "CertStore" "Collection" "sun.security.provider.certpath.CollectionCertStore" attrs)
        (.add this
              p
              "CertStore"
              "com.sun.security.IndexedCollection"
              "sun.security.provider.certpath.IndexedCollectionCertStore"
              attrs)
        (.add this p "Configuration" "JavaLoginConfig" "sun.security.provider.ConfigFile$Spi")
        (.clear attrs)
        (.put attrs "ValidationAlgorithm" "RFC5280")
        (.put attrs "ImplementedIn" "Software")
        (.add this p "CertPathBuilder" "PKIX" "sun.security.provider.certpath.SunCertPathBuilder" attrs)
        (.add this p "CertPathValidator" "PKIX" "sun.security.provider.certpath.PKIXCertPathValidator" attrs)))))

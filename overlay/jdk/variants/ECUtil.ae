;; Go-build variant of sun.security.util.ECUtil (J2G-SPEC §4.6; doc/classes/JAVA-DEFERRED-TRIAGE.md,
;; F1): read by j2g only. jdk26u's decodePKCS8ECPrivateKey (its key spec's clearing) reads
;; SharedSecrets' JavaSecuritySpecAccess, which jrt's SharedSecrets does not hold; the variant reads
;; it from jrt's jdk.internal.jrt.CryptoAccess, which EncodedKeySpec's static initializer sets (its
;; variant). The replacing members are jdk26u's (baf63fb; Copyright (c) Oracle and/or its
;; affiliates, GPL 2 with the Classpath Exception: LICENSE.md) as repr/java converts them, with the
;; change named; the rest Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'sun.security.util)

(j2g/variant ECUtil
  (method ^:public ^:static decodePKCS8ECPrivateKey :throws [InvalidKeySpecException] ^ECPrivateKey [^byte/1 encoded]
    (let [keyFactory (ECUtil/getKeyFactory)
          keySpec (PKCS8EncodedKeySpec. encoded)]
      (try
        (cast ECPrivateKey (.generatePrivate keyFactory keySpec))
        (finally (.clearEncodedKeySpec (jdk.internal.jrt.CryptoAccess/javaSecuritySpecAccess) keySpec))))))

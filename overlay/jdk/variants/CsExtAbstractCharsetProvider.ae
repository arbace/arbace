;; Go-build variant of sun.nio.cs.ext.AbstractCharsetProvider (J2G-SPEC §4.6; queue 543): read by j2g only. jdk26u's
;; lookup finds a charset's class by name, Class.forName(packagePrefix + className).newInstance(); here it asks jrt's
;; JrtExtCharsets (overlay/jdk/java.base/sun/nio/cs/ext/JrtExtCharsets.java) to construct it directly (no class
;; loading by name in the Go build), null for a class it does not know, as the JDK's ClassNotFoundException gives,
;; as CsStandardCharsets.ae does for the standard charsets. The replacing member is jdk26u's (baf63fb; Copyright (c)
;; Oracle and/or its affiliates, GPL 2 with the Classpath Exception: LICENSE.md), with the change named; the rest
;; Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'sun.nio.cs.ext)

(j2g/variant AbstractCharsetProvider
  (method ^:private lookup ^Charset [this ^String csn]
    (let [^{:tag (SoftReference Charset)} sr (cast SoftReference (.get cache csn))]
      (when (some? sr) (let [cs (cast Charset (.get sr))] (when (some? cs) (return cs))))
      (let [cln (cast String (.get classMap csn))]
        (when (some? cln)
          (let [cs (JrtExtCharsets/newCharset cln)]
            (when (some? cs)
              (.put cache csn (SoftReference. cs)))
            cs))))))

;; Go-build variant of javax.net.ssl.SNIHostName (J2G-SPEC §4.6; doc/classes/JAVA-DEFERRED-TRIAGE.md, F3,
;; "As built: F3 (write-ahead)"): read by j2g only. The encoded name is decoded as UTF-8 without a
;; CharsetDecoder (the charsets' coders are not in the Go build before F8): String's UTF-8 decoding,
;; malformed input reported as the JDK's REPORTing decoder reports it (a MalformedInputException as the
;; cause) when the decoded string does not encode back to the same bytes (UTF-8 has no unmappable
;; character). IDN.toASCII as the JDK's. The replacing members are jdk26u's (baf63fb; Copyright (c) Oracle and/or its affiliates, GPL 2
;; with the Classpath Exception: LICENSE.md) as repr/java converts them, with the change named; the rest
;; Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'javax.net.ssl)

(j2g/variant SNIHostName
  (constructor ^:public [this ^byte/1 encoded]
    (super. StandardConstants/SNI_HOST_NAME encoded)
    (try
      (let [decoded (String. encoded StandardCharsets/UTF_8)]
        (when-not (java.util.Arrays/equals (.getBytes decoded StandardCharsets/UTF_8) encoded)
          (throw (java.nio.charset.MalformedInputException. 1)))
        (set! (.-hostname this)
              (IDN/toASCII decoded IDN/USE_STD3_ASCII_RULES)))
      (catch [RuntimeException CharacterCodingException] e
        (throw (IllegalArgumentException. "The encoded server name value is invalid" e))))
    (.checkHostName this)))

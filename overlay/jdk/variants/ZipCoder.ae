;; Go-build variant of java.util.zip.ZipCoder (J2G-SPEC §4.6; doc/classes/JAVA-CONFORMANCE-SURVEY.md,
;; "As built: JC6b"): read by j2g only. Its UTF-8 coder decodes and encodes entry names and
;; comments through JavaLangAccess's newStringOrThrow and getBytesUTF8OrThrow in the JDK, which
;; jrt's JavaLangAccess lacks: the variant's do it through jrt's own jdk.internal.jrt.Utf8Coder
;; (overlay/jdk/java.base), with jdk26u's results (IllegalArgumentException wrapping the
;; CharacterCodingException; compare's EXACT_MATCH, DIRECTORY_MATCH, NO_MATCH). Copyright (c) the
;; Arbace authors; Eclipse Public License 1.0.
(in-ns 'java.util.zip)

(j2g/variant ZipCoder$UTF8ZipCoder
  (method toString ^String [this ^byte/1 ba ^int off ^int length]
    (jdk.internal.jrt.Utf8Coder/decode ba off length))

  (method getBytes ^byte/1 [this ^String s]
    (jdk.internal.jrt.Utf8Coder/encode s))

  (method compare ^byte [this ^String str ^byte/1 b ^int off ^int len ^boolean matchDirectory]
    (jdk.internal.jrt.Utf8Coder/compare str b off len matchDirectory)))

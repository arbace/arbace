;; Go-build variant of sun.nio.cs.GB18030 (J2G-SPEC §4.6; doc/classes/JAVA-DEFERRED-TRIAGE.md, F8,
;; "As built: F8 (write-ahead)"): read by j2g only. IS_2000 reads the system property
;; jdk.charset.GB18030 without asking VM.initLevel (not in the Go build): the Go build's system
;; properties are ready before any class is initialized, the case jdk26u's test guards. The
;; replacing member is jdk26u's (baf63fb; Copyright (c) Oracle and/or its affiliates, GPL 2 with the
;; Classpath Exception: LICENSE.md) as repr/java converts it, with the change named; the rest
;; Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'sun.nio.cs)

(j2g/variant GB18030
  (field ^:static ^:final ^boolean IS_2000
    (.equals "2000" (System/getProperty "jdk.charset.GB18030" ""))))

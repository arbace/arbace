;; Go-build variant of java.lang.invoke.SerializedLambda (J2G-SPEC §4.6; doc/classes/JAVA-DEFERRED-TRIAGE.md,
;; JCS169 (a), "As built: JCS169 (write-ahead)"): read by j2g only.
;; - readResolve makes the lambda again through jdk.internal.jrt.SerialLambdas.deserialize (the site its
;;   capturing class registered), not by the capturing class's $deserializeLambda$, which javac writes and
;;   the Go build's classes have not (no invokedynamic: j2g and the interpreter register the sites instead);
;;   an unknown site is jdk26u's InvalidObjectException around javac's IllegalArgumentException.
;; - toString names the implementation's kind as MethodHandleInfo.referenceKindToString does (java.lang.invoke's
;;   MethodHandleInfo is not in the Go build), its format jdk26u's.
;; The replacing members keep jdk26u's code where they keep it (baf63fb,
;; src/java.base/share/classes/java/lang/invoke/SerializedLambda.java and MethodHandleInfo.java; Copyright (c)
;; Oracle and/or its affiliates, GPL 2 with the Classpath Exception: LICENSE.md); the rest Copyright (c) the
;; Arbace authors; Eclipse Public License 1.0.
(in-ns 'java.lang.invoke)

(j2g/variant SerializedLambda
  (method ^:private readResolve :throws [ObjectStreamException] [this]
    (jdk.internal.jrt.SerialLambdas/deserialize this))

  (method ^:public toString ^String [this]
    (let [implKind (SerializedLambda/kindName implMethodKind)]
      (java-str "SerializedLambda[capturingClass=" capturingClass
                ", functionalInterfaceMethod=" functionalInterfaceClass "." functionalInterfaceMethodName ":"
                functionalInterfaceMethodSignature
                ", implementation=" implKind " " implClass "." implMethodName ":" implMethodSignature
                ", instantiatedMethodType=" instantiatedMethodType
                ", numCaptured=" (alength capturedArgs) "]")))

  (j2g/add
    (method ^:private ^:static kindName ^String [^int kind]
      (switch kind
        1 (return "getField") 2 (return "getStatic") 3 (return "putField") 4 (return "putStatic")
        5 (return "invokeVirtual") 6 (return "invokeStatic") 7 (return "invokeSpecial")
        8 (return "newInvokeSpecial") 9 (return "invokeInterface"))
      (throw (IllegalArgumentException. (java-str "invalid reference kind " kind))))))

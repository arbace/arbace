;; Go-build variant of com.sun.crypto.provider.GaloisCounterMode (J2G-SPEC §4.6;
;; doc/classes/JAVA-DEFERRED-TRIAGE.md, F1): read by j2g only. The JavaNioAccess of SharedSecrets (direct
;; buffers' addresses and sessions, outside the Go build's world, as ZipUtils') is cut, so that the
;; class initializes: its only users are the direct-buffer branches of overlapDetection and of the
;; decryption's output, which a Go build's buffer (heap only) never takes. Copyright (c) the Arbace
;; authors; Eclipse Public License 1.0.
(in-ns 'com.sun.crypto.provider)

(j2g/variant GaloisCounterMode
  (j2g/cut (field ^:private ^:static ^:final ^JavaNioAccess NIO_ACCESS)))

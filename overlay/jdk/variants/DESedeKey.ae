;; Go-build variant of com.sun.crypto.provider.DESedeKey (J2G-SPEC §4.6;
;; doc/classes/JAVA-DEFERRED-TRIAGE.md, F1): read by j2g only. The constructor does not register the
;; zeroing of the key's bytes with a Cleaner (java.lang.ref.Cleaner and
;; jdk.internal.ref.CleanerFactory are not in the Go build: F17, references); as jdk26u's ZipFile in
;; JC6b. A key's bytes are zeroed when it is destroyed or cleared, not when it becomes unreachable.
;; The replacing members are jdk26u's (baf63fb; Copyright (c) Oracle and/or its affiliates, GPL 2
;; with the Classpath Exception: LICENSE.md) as repr/java converts them, with the change named; the
;; rest Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'com.sun.crypto.provider)

(j2g/variant DESedeKey
  (constructor :throws [InvalidKeyException] [this ^byte/1 key ^int offset]
    (when (or (nil? key)
              (< (unchecked-subtract-int (alength key) offset) DESedeKeySpec/DES_EDE_KEY_LEN))
      (throw (InvalidKeyException. "Wrong key size")))
    (set! (.-key this) (new byte/1 DESedeKeySpec/DES_EDE_KEY_LEN))
    (System/arraycopy key offset (.-key this) 0 DESedeKeySpec/DES_EDE_KEY_LEN)
    (DESKeyGenerator/setParityBit (.-key this) 0)
    (DESKeyGenerator/setParityBit (.-key this) 8)
    (DESKeyGenerator/setParityBit (.-key this) 16)))

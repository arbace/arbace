;; Go-build variant of java.io.ObjectInputStream (J2G-SPEC §4.6): read by j2g only. filterCheck logs
;; the filter's decisions through the System.Logger of ObjectInputStream$Logging, which is not in the
;; Go build (JCS136): its static initializer and the field's reads were j2g's missing-class stubs, so
;; every object read through a stream with a filter (the default serial filter of the JCA's keystores,
;; an array's length check) threw "class java.lang.System$Logger is not in the closed world"
;; (doc/classes/JAVA-DEFERRED-TRIAGE.md, "As built: n-java-defer (round 54), the second pass"). The
;; variant's filterCheck is the method without its logging, as when the logger "java.io.serialization"
;; is not loggable at DEBUG or TRACE (Logging.filterLogger null, jdk26u's default). The kept code is
;; jdk26u's (baf63fb; Copyright (c) Oracle and/or its affiliates, GPL 2 with the Classpath Exception:
;; LICENSE.md); the rest Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'java.io)

(j2g/variant ObjectInputStream
  (method ^:private filterCheck :throws [InvalidClassException] ^void [this ^{:tag (Class ?)} clazz
                                                                       ^int arrayLength]
    (let [bytesRead (if (nil? bin) 0 (.getBytesRead bin))
          ^:mutable ^RuntimeException ex nil
          ^:mutable ^ObjectInputFilter$Status status nil]
      (when (some? serialFilter)
        (try
          (set! status
                (.checkInput serialFilter
                             (FilterValues. clazz arrayLength totalObjectRefs depth bytesRead)))
          (catch RuntimeException e (set! status ObjectInputFilter$Status/REJECTED) (set! ex e))))
      (when (and (some? serialFilter)
                 (or (nil? status) (identical? status ObjectInputFilter$Status/REJECTED)))
        (throw (InvalidClassException. (java-str "filter status: " status) ex))))))

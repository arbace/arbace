;; Go-build variant of java.net.ProxySelector (J2G-SPEC §4.6; doc/classes/JAVA-DEFERRED-TRIAGE.md, F12,
;; "As built: F12 (write-ahead)"): read by j2g only. jdk26u's static initializer finds the system-wide
;; default selector, sun.net.spi.DefaultProxySelector, by Class.forName and newInstance; jrt's reflection
;; holds a class's public constructors only when it is reached (J2G-SPEC §10), so the default is
;; constructed directly, as the F1 and F2 providers are (no class loading by name). The rest of the class is
;; jdk26u's. Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'java.net)

(j2g/variant ProxySelector
  (static-initializer
    (set! theProxySelector (sun.net.spi.DefaultProxySelector.))))

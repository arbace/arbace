;; Go-build variant of sun.security.util.KeyUtil (J2G-SPEC §4.6;
;; doc/classes/JAVA-DEFERRED-TRIAGE.md, F1): read by j2g only. jdk26u's destroySecretKeys and clear
;; (their keys' clearing) reads SharedSecrets' JavaxCryptoSpecAccess and JavaSecuritySpecAccess,
;; which jrt's SharedSecrets does not hold; the variant reads it from jrt's
;; jdk.internal.jrt.CryptoAccess, which SecretKeySpec's or EncodedKeySpec's static initializer sets
;; (its variant). The replacing members are jdk26u's (baf63fb; Copyright (c) Oracle and/or its
;; affiliates, GPL 2 with the Classpath Exception: LICENSE.md) as repr/java converts them, with the
;; change named; the rest Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'sun.security.util)

(j2g/variant KeyUtil
  (method ^:public ^:static destroySecretKeys ^void [& ^SecretKey/1 keys]
    (for-each [^SecretKey k keys]
      (when (some? k)
        (if-instance [^SecretKeySpec sk k]
          (.clearSecretKeySpec (jdk.internal.jrt.CryptoAccess/javaxCryptoSpecAccess) sk)
          (if-instance [^PBKDF2KeyImpl p2k k]
            (.clear p2k)
            (try (.destroy k) (catch DestroyFailedException e)))))))

  (method ^:public ^:static clear ^void [& ^Object/1 list]
    (for-each [o list]
      (switch o
        [^byte/1 b] (Arrays/fill b (unchecked-byte 0))
        [^char/1 c] (Arrays/fill c (unchecked-char 0))
        [^PKCS8Key p8] (.clear p8)
        [^PKCS8EncodedKeySpec p8]
          (.clearEncodedKeySpec (jdk.internal.jrt.CryptoAccess/javaSecuritySpecAccess) p8)
        [^PBEKeySpec pbe] (.clearPassword pbe)
        nil nil
        (throw (IllegalArgumentException.
                 (java-str (.getName (.getClass o)) " not defined in KeyUtil.clear()")))))))

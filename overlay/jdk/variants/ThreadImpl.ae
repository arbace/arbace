;; Go-build variant of sun.management.ThreadImpl (J2G-SPEC §4.6; doc/classes/JAVA-DEFERRED-TRIAGE.md, F13, "As built:
;; F13 (write-ahead)"; JCS161 (a)): read by j2g only. Its natives, HotSpot's jmm interface in the JDK, over jrt's
;; jdk.internal.jrt.HostManagement: the live threads (getThreads), their ThreadInfo as the JVM makes it (through
;; ThreadInfo's private constructors, HostManagement's factory: the thread's state as jmm reports it, its stack
;; trace to maxDepth frames, the object it is blocked or waits on with its owner, the blocked and waited counts
;; and times (slice 2), no locked monitors or synchronizers until slice 3), the settings kept by
;; HostManagement, the peak's reset. The CPU times and the
;; allocated memory are unsupported (VMManagementImpl says so, and jdk26u's code throws before reaching these):
;; they answer -1; the deadlock searches are jrt's (slice 3: cycles of waits, the monitors' and the locks'
;; owners; findDeadlockedThreads stays unsupported until the locked synchronizers, VMManagementImpl's
;; synchronizerUsageSupport). The rest is jdk26u's. Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'sun.management)

(j2g/variant ThreadImpl
  (method ^:private ^:static getThreads ^Thread/1 []
    (jdk.internal.jrt.HostManagement/threads0))

  (j2g/add
    (method ^:private ^:static jrtThread ^Thread [^long id]
      (for-each [^Thread t (jdk.internal.jrt.HostManagement/threads0)]
        (when (== (.threadId t) id) (return t)))
      nil))

  (j2g/add
    (method ^:private ^:static jrtInfo ^ThreadInfo [^Thread t ^int maxDepth]
      (let [^:mutable ^StackTraceElement/1 st (new StackTraceElement/1 0)]
        (when (not (== maxDepth 0))
          (let [all (.getStackTrace t)]
            (set! st (if (or (< maxDepth 0) (>= maxDepth (alength all)))
                         all
                         (java.util.Arrays/copyOf all maxDepth)))))
        (let [lock (jdk.internal.jrt.HostManagement/waitOn0 t)
              owner (when (some? lock) (jdk.internal.jrt.HostManagement/lockOwner0 lock))]
          (.newThreadInfo (jdk.internal.jrt.HostManagement/threadInfoFactory)
                          t (jdk.internal.jrt.HostManagement/jmmState t) lock owner
                          (jdk.internal.jrt.HostManagement/blockedCount0 t)
                          (jdk.internal.jrt.HostManagement/blockedTime0 t)
                          (jdk.internal.jrt.HostManagement/waitedCount0 t)
                          (jdk.internal.jrt.HostManagement/waitedTime0 t)
                          st (new Object/1 0) (new int/1 0) (new Object/1 0))))))

  (method ^:private ^:static getThreadInfo1 ^void [^long/1 ids ^int maxDepth ^ThreadInfo/1 result]
    (loop [^int i 0]
      (when (< i (alength ids))
        (let [t (ThreadImpl/jrtThread (aget ids i))]
          (aset result i (if (or (nil? t) (not (.isAlive t))) nil (ThreadImpl/jrtInfo t maxDepth))))
        (recur (unchecked-inc-int i)))))

  (method ^:private ^:static dumpThreads0 ^ThreadInfo/1 [^long/1 ids ^boolean lockedMonitors
                                                         ^boolean lockedSynchronizers ^int maxDepth]
    (if (nil? ids)
        (let [ts (jdk.internal.jrt.HostManagement/threads0)
              res (new ThreadInfo/1 (alength ts))]
          (loop [^int i 0]
            (when (< i (alength ts))
              (aset res i (ThreadImpl/jrtInfo (aget ts i) maxDepth))
              (recur (unchecked-inc-int i))))
          res)
        (let [res (new ThreadInfo/1 (alength ids))]
          (ThreadImpl/getThreadInfo1 ids maxDepth res)
          res)))

  (method ^:private ^:static getThreadTotalCpuTime0 ^long [^long id] -1)
  (method ^:private ^:static getThreadTotalCpuTime1 ^void [^long/1 ids ^long/1 result]
    (java.util.Arrays/fill result -1))
  (method ^:private ^:static getThreadUserCpuTime0 ^long [^long id] -1)
  (method ^:private ^:static getThreadUserCpuTime1 ^void [^long/1 ids ^long/1 result]
    (java.util.Arrays/fill result -1))
  (method ^:private ^:static getThreadAllocatedMemory0 ^long [^long id] -1)
  (method ^:private ^:static getThreadAllocatedMemory1 ^void [^long/1 ids ^long/1 result]
    (java.util.Arrays/fill result -1))
  (method ^:private ^:static getTotalThreadAllocatedMemory ^long [] -1)

  (method ^:private ^:static setThreadCpuTimeEnabled0 ^void [^boolean enable]
    (jdk.internal.jrt.HostManagement/setCpuTime enable))
  (method ^:private ^:static setThreadAllocatedMemoryEnabled0 ^void [^boolean enable]
    (jdk.internal.jrt.HostManagement/setAllocatedMemory enable))
  (method ^:private ^:static setThreadContentionMonitoringEnabled0 ^void [^boolean enable]
    (jdk.internal.jrt.HostManagement/setContentionMonitoring enable))

  (method ^:private ^:static findMonitorDeadlockedThreads0 ^Thread/1 []
    (jdk.internal.jrt.HostManagement/findMonitorDeadlocked0))
  (method ^:private ^:static findDeadlockedThreads0 ^Thread/1 []
    (jdk.internal.jrt.HostManagement/findDeadlocked0))

  (method ^:private ^:static resetPeakThreadCount0 ^void []
    (jdk.internal.jrt.HostManagement/resetPeakCount0))

  (method ^:private ^:static resetContentionTimes0 ^void [^long tid]))

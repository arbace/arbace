;; Go-build variant of java.security.Signature (J2G-SPEC §4.6; doc/classes/JAVA-DEFERRED-TRIAGE.md,
;; F2, "As built: F2 (write-ahead)"): read by j2g only. F1's variant (Signature.ae) cuts the first
;; static initializer, which gives SharedSecrets the access to Signature's initVerify and initSign
;; with parameters; F2 adds it back giving the access to jrt's jdk.internal.jrt.PkiAccess, where
;; SignatureUtil's variant reads it. The file's name sorts after Signature.ae: j2g applies a class's
;; variant members file by file in that order, the cut first. The replacing members are jdk26u's
;; (baf63fb; Copyright (c) Oracle and/or its affiliates, GPL 2 with the Classpath Exception:
;; LICENSE.md) as repr/java converts them, with the change named; the rest Copyright (c) the Arbace
;; authors; Eclipse Public License 1.0.
(in-ns 'java.security)

(j2g/variant Signature
  (j2g/add
    (static-initializer
      (jdk.internal.jrt.PkiAccess/setJavaSecuritySignatureAccess
        (anon JavaSecuritySignatureAccess []
          (method ^:public initVerify :throws [InvalidKeyException InvalidAlgorithmParameterException] ^void [this
                                                                                                              ^Signature s
                                                                                                              ^PublicKey publicKey
                                                                                                              ^AlgorithmParameterSpec params]
            (.initVerify s publicKey params))

          (method ^:public initVerify :throws [InvalidKeyException InvalidAlgorithmParameterException] ^void [this
                                                                                                              ^Signature s
                                                                                                              ^java.security.cert.Certificate certificate
                                                                                                              ^AlgorithmParameterSpec params]
            (.initVerify s certificate params))

          (method ^:public initSign :throws [InvalidKeyException InvalidAlgorithmParameterException] ^void [this
                                                                                                            ^Signature s
                                                                                                            ^PrivateKey privateKey
                                                                                                            ^AlgorithmParameterSpec params
                                                                                                            ^SecureRandom random]
            (.initSign s privateKey params random)))))))

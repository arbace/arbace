;; Go-build variant of java.net.HttpConnectSocketImpl (J2G-SPEC §4.6; doc/classes/JAVA-DEFERRED-TRIAGE.md,
;; F12, "As built: F12 (write-ahead)"): read by j2g only. A Socket(Proxy) of type HTTP tunnels through the
;; http: handler's connection: jdk26u reaches its doTunneling and its client's socket by reflection, on
;; protected members (setAccessible), which jrt's reflection tables do not hold (J2G-SPEC §10: the public
;; members); here the connection's added jrtTunnelSocket does both (HttpURLConnectionImpl.ae,
;; HttpClient.ae), its IOException the tunnel's as jdk26u rethrows the invocation's cause. The reflective
;; fields and their static initializer are gone. Otherwise jdk26u's code (baf63fb; Copyright (c) Oracle
;; and/or its affiliates, GPL 2 with the Classpath Exception: LICENSE.md); the rest Copyright (c) the Arbace
;; authors; Eclipse Public License 1.0.
(in-ns 'java.net)

(j2g/variant HttpConnectSocketImpl
  (j2g/cut (field ^:private ^:static ^:final ^String httpURLClazzStr))
  (j2g/cut (field ^:private ^:static ^:final ^String netClientClazzStr))
  (j2g/cut (field ^:private ^:static ^:final ^String doTunnelingStr))
  (j2g/cut (field ^:private ^:static ^:final ^Field httpField))
  (j2g/cut (field ^:private ^:static ^:final ^Field serverSocketField))
  (j2g/cut (field ^:private ^:static ^:final ^Method doTunneling))
  (j2g/cut (static-initializer 0))
  (j2g/cut ^:private doTunneling ^void [this ^HttpURLConnection conn])

  (method ^:private doTunnel :throws [IOException] ^Socket [this ^String urlString ^int connectTimeout]
    (let [proxy (Proxy. Proxy$Type/HTTP (InetSocketAddress. server (.-port this)))
          destURL (URL. urlString)
          conn (cast HttpURLConnection (.openConnection destURL proxy))]
      (.setConnectTimeout conn connectTimeout)
      (let [timeout (.intValue (cast Integer (.getOption this SocketOptions/SO_TIMEOUT)))]
        (when (> timeout 0) (.setReadTimeout conn timeout))
        (.connect conn)
        (.jrtTunnelSocket (cast sun.net.www.protocol.http.HttpURLConnection conn))))))

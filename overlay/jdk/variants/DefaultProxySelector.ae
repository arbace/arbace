;; Go-build variant of sun.net.spi.DefaultProxySelector (J2G-SPEC §4.6; doc/classes/JAVA-DEFERRED-TRIAGE.md,
;; F12, "As built: F12 (write-ahead)"): read by j2g only. With java.net.useSystemProxies true jdk26u loads
;; libnet and asks its native init whether the desktop's proxy settings (GNOME's GSettings or GConf, by
;; dlopen) can be read; the Go build has no native library and reads no desktop settings, so the answer is
;; the JDK's on a host without them: init answers false, hasSystemProxies stays false and select uses the
;; Java properties alone (getSystemProxies, never reached, answers null). The static initializer keeps
;; jdk26u's reading of the property (NetProperties). The rest is jdk26u's (baf63fb; Copyright (c) Oracle
;; and/or its affiliates, GPL 2 with the Classpath Exception: LICENSE.md); the variant Copyright (c) the
;; Arbace authors; Eclipse Public License 1.0.
(in-ns 'sun.net.spi)

(j2g/variant DefaultProxySelector
  (static-initializer
    (let [^:const key "java.net.useSystemProxies"
          b (NetProperties/getBoolean key)]
      (when (and (some? b) (.booleanValue b))
        (set! hasSystemProxies (DefaultProxySelector/init)))))

  (method ^:private ^:static init ^boolean []
    false)

  (method ^:private ^:synchronized getSystemProxies ^Proxy/1 [this ^String protocol ^String host]
    nil))

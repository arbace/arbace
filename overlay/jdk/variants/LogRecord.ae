;; Go-build variant of java.util.logging.LogRecord (J2G-SPEC §4.6; doc/classes/JAVA-DEFERRED-TRIAGE.md,
;; "As built: F5 (write-ahead)"): read by j2g only.
;; - inferCaller walks the stack trace of a new Throwable (jrt's frames, J2G-SPEC §7.9.6, §10.7)
;;   instead of StackWalker (not in the Go build, F20), with CallerFinder's test: past the first
;;   frame of java.util.logging.Logger (or sun.util.logging.PlatformLogger), the first frame that
;;   SimpleConsoleLogger.Formatting.isFilteredFrame does not filter, by its class name (the
;;   System.Logger implementations' test needs the frame's class, which a StackTraceElement has
;;   not; there are no System.Logger implementations in the Go build, JCS136). No such frame: the
;;   source stays unset, as the JDK's when the walk finds none.
;; - serialPersistentFields is cut: serialization is not in the Go build (J2G-SPEC §12), and its
;;   initializer names ObjectStreamField, outside the world (writeObject and readObject stay, as
;;   operation-level stubs, never called).
;; The replacing members keep jdk26u's code where they keep it (baf63fb,
;; src/java.logging/share/classes/java/util/logging/LogRecord.java and
;; src/java.base/share/classes/jdk/internal/logger/SimpleConsoleLogger.java; Copyright (c) Oracle
;; and/or its affiliates, GPL 2 with the Classpath Exception: LICENSE.md); the rest Copyright (c)
;; the Arbace authors; Eclipse Public License 1.0.
(in-ns 'java.util.logging)

(j2g/variant LogRecord
  (j2g/cut (field ^:private ^:static ^:final ^ObjectStreamField/1 serialPersistentFields))

  (method ^:private inferCaller ^void [this]
    (set! needToInferCaller false)
    (let [^StackTraceElement/1 stack (.getStackTrace (Throwable.))
          ^:mutable lookingForLogger true]
      (for-each [^StackTraceElement f stack]
        (let [cname (.getClassName f)]
          (if lookingForLogger
              (set! lookingForLogger (not (or (.equals cname "java.util.logging.Logger")
                                              (.startsWith cname "sun.util.logging.PlatformLogger"))))
              (when-not (LogRecord/isFilteredFrameName cname)
                (.setSourceClassName this cname)
                (.setSourceMethodName this (.getMethodName f))
                (return)))))))

  (j2g/add
    (method ^:private ^:static isFilteredFrameName ^boolean [^String cname]
      (let [c (if (< (.length cname) 12) \u0000 (.charAt cname 0))]
        (cond
          (== c \s)
            (when (or (.startsWith cname "sun.util.logging.") (.startsWith cname "sun.rmi.runtime.Log"))
              (return true))
          (== c \j)
            (do
              (when (.startsWith cname "jdk.internal.logger.BootstrapLogger$LogEvent") (return false))
              (when (or (.startsWith cname "jdk.internal.logger.")
                        (.startsWith cname "java.util.logging.")
                        (.startsWith cname "java.lang.invoke.MethodHandle")
                        (.startsWith cname "java.security.AccessController"))
                (return true)))))
      (let [additionalPkgs (System/getProperty "jdk.logger.packages")]
        (when (some? additionalPkgs)
          (for-each [^String skip (.split additionalPkgs ",")]
            (when (and (not (.isEmpty skip)) (.startsWith cname skip)) (return true)))))
      false)))

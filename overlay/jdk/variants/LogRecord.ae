;; Go-build variant of java.util.logging.LogRecord (J2G-SPEC §4.6; doc/classes/JAVA-DEFERRED-TRIAGE.md,
;; "As built: F5 (write-ahead)"): read by j2g only.
;; - inferCaller is jdk26u's again (java-tail2-1126): CallerFinder walks the stack with StackWalker,
;;   in the Go build since queue 416, whose default walk hides the reflection frames as the JDK's
;;   does (Method.invoke: TestInferCaller's m2.invoke(m, ...), t05766); until then it walked the
;;   stack trace of a new Throwable, which shows them (F20). CallerFinder's test keeps jdk26u's
;;   rule, past the first frame of java.util.logging.Logger (or sun.util.logging.PlatformLogger)
;;   the first frame SimpleConsoleLogger.Formatting.isFilteredFrame does not filter: a System.Logger
;;   implementation's frame by its class, the rest by its class name (isFilteredFrameName below:
;;   jdk.internal.logger, SurrogateLogger's, is not in the Go build). No such frame: the source
;;   stays unset, as the JDK's when the walk finds none.
;; (serialPersistentFields, cut until serialization came into the world, is jdk26u's since its slice
;; 4: doc/classes/JAVA-DEFERRED-TRIAGE.md, "As built: serialization slice 4".)
;; The replacing members keep jdk26u's code where they keep it (baf63fb,
;; src/java.logging/share/classes/java/util/logging/LogRecord.java and
;; src/java.base/share/classes/jdk/internal/logger/SimpleConsoleLogger.java; Copyright (c) Oracle
;; and/or its affiliates, GPL 2 with the Classpath Exception: LICENSE.md); the rest Copyright (c)
;; the Arbace authors; Eclipse Public License 1.0.
(in-ns 'java.util.logging)

(j2g/variant LogRecord
  (j2g/add
    (method ^:private ^:static isFilteredFrameName ^boolean [^String cname]
      (let [c (if (< (.length cname) 12) \u0000 (.charAt cname 0))]
        (cond
          (== c \s)
            (when (or (.startsWith cname "sun.util.logging.") (.startsWith cname "sun.rmi.runtime.Log"))
              (return true))
          (== c \j)
            (do
              (when (.startsWith cname "jdk.internal.logger.BootstrapLogger$LogEvent") (return false))
              (when (or (.startsWith cname "jdk.internal.logger.")
                        (.startsWith cname "java.util.logging.")
                        (.startsWith cname "java.lang.invoke.MethodHandle")
                        (.startsWith cname "java.security.AccessController"))
                (return true)))))
      (let [additionalPkgs (System/getProperty "jdk.logger.packages")]
        (when (some? additionalPkgs)
          (for-each [^String skip (.split additionalPkgs ",")]
            (when (and (not (.isEmpty skip)) (.startsWith cname skip)) (return true)))))
      false)))

(j2g/variant LogRecord$CallerFinder
  (method ^:public test ^boolean [this ^StackWalker$StackFrame t]
    (let [^:final cname (.getClassName t)]
      (if lookingForLogger
          (do (set! lookingForLogger (not (.isLoggerImplFrame this cname))) false)
          (not (or (.isAssignableFrom java.lang.System$Logger (.getDeclaringClass t))
                   (LogRecord/isFilteredFrameName cname)))))))

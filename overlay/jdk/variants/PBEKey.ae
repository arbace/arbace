;; Go-build variant of com.sun.crypto.provider.PBEKey (J2G-SPEC §4.6;
;; doc/classes/JAVA-DEFERRED-TRIAGE.md, F1): read by j2g only. The key's cleanable is the zeroing
;; action itself, a Runnable, run by destroy, not a Cleaner's Cleanable registered with the key
;; (readObject, serialization's, outside the Go build, cut) (java.lang.ref.Cleaner and
;; jdk.internal.ref.CleanerFactory are not in the Go build: F17, references); as jdk26u's ZipFile in
;; JC6b. A key's bytes are zeroed when it is destroyed or cleared, not when it becomes unreachable.
;; The replacing members are jdk26u's (baf63fb; Copyright (c) Oracle and/or its affiliates, GPL 2
;; with the Classpath Exception: LICENSE.md) as repr/java converts them, with the change named; the
;; rest Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'com.sun.crypto.provider)

(j2g/variant PBEKey
  (field ^:private ^:transient ^Runnable cleanable)

  (constructor :throws [InvalidKeySpecException] [this ^PBEKeySpec keySpec ^String keytype]
    (let [^:mutable passwd (.getPassword keySpec)]
      (when (nil? passwd) (set! passwd (new char/1 0)))
      (set! (.-key this) (PBEUtil/encodePassword passwd))
      (Arrays/fill passwd \u0000)
      (set! type keytype)
      (let [k (.-key this)]
        (set! cleanable
              (lambda Runnable ^void [] (Arrays/fill k (unchecked-byte 0x00)))))))

  (method ^:public destroy ^void [this]
    (when (some? cleanable) (.run cleanable) (set! cleanable nil)))

  (j2g/cut ^:private readObject ^void [^ObjectInputStream s]))

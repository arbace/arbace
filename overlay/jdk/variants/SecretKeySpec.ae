;; Go-build variant of javax.crypto.spec.SecretKeySpec (J2G-SPEC §4.6; doc/go/JRT-NOTES.md,
;; "Security"; doc/classes/JAVA-DEFERRED-TRIAGE.md, F1): read by j2g only. The static initializer gives
;; the access to SecretKeySpec.clear (for SunJCE's PBES2 ciphers, PKCS #12 and PBMAC1 MACs, HKDF and
;; KeyUtil) to jrt's jdk.internal.jrt.CryptoAccess, where the JDK gives it to SharedSecrets (jrt's
;; does not hold it); until F1 it was cut (none of its readers was in the Go build). Copyright (c) the
;; Arbace authors; Eclipse Public License 1.0.
(in-ns 'javax.crypto.spec)

(j2g/variant SecretKeySpec
  (static-initializer
    (jdk.internal.jrt.CryptoAccess/setJavaxCryptoSpecAccess
      (method-ref JavaxCryptoSpecAccess SecretKeySpec/.clear))))

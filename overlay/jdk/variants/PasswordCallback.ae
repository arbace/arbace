;; Go-build variant of javax.security.auth.callback.PasswordCallback (J2G-SPEC §4.6;
;; doc/classes/JAVA-DEFERRED-TRIAGE.md, F4, "As built: F4 (write-ahead)"): read by j2g only. The
;; password's cleanable is the clearing action itself, a Runnable, run by setPassword and
;; clearPassword, not a Cleaner's Cleanable registered with the callback (java.lang.ref.Cleaner and
;; jdk.internal.ref.CleanerFactory are not in the Go build: F17), as F1's keys; readObject
;; (serialization's) cut. A password is cleared when it is replaced or cleared, not when the
;; callback becomes unreachable. The replacing members are jdk26u's (baf63fb; Copyright (c) Oracle
;; and/or its affiliates, GPL 2 with the Classpath Exception: LICENSE.md) as repr/java converts
;; them, with the change named; the rest Copyright (c) the Arbace authors; Eclipse Public License
;; 1.0.
(in-ns 'javax.security.auth.callback)

(j2g/variant PasswordCallback
  (field ^:private ^:transient ^Runnable cleanable)

  (method ^:public setPassword ^void [this ^char/1 password]
    (when (some? cleanable) (.run cleanable) (set! cleanable nil))
    (set! (.-inputPassword this) (when (some? password) (.clone password)))
    (when (some? (.-inputPassword this))
      (set! cleanable
            (PasswordCallback/cleanerFor inputPassword))))

  (method ^:public clearPassword ^void [this]
    (when (some? cleanable) (.run cleanable) (set! cleanable nil)))

  (j2g/cut ^:private readObject ^void [this ^ObjectInputStream stream]))

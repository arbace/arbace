;; Go-build variant of javax.net.ssl.SSLContext (J2G-SPEC §4.6; doc/classes/JAVA-DEFERRED-TRIAGE.md, F3,
;; "As built: F3 (write-ahead)"): read by j2g only. The default context is published under the class's
;; monitor, not by a VarHandle: j2g compiles findVarHandle's instance fields (arbace.j2g.vh), not
;; findStaticVarHandle's static one, and java.lang.invoke is not in the Go build. The first context made
;; wins, as the JDK's compareAndSet(null, ...) makes it win. The replacing members are jdk26u's (baf63fb; Copyright (c) Oracle and/or its affiliates, GPL 2
;; with the Classpath Exception: LICENSE.md) as repr/java converts them, with the change named; the rest
;; Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'javax.net.ssl)

(j2g/variant SSLContext
  (j2g/cut (field ^:private ^:static ^:final ^VarHandle VH_DEFAULT_CONTEXT))

  (j2g/cut (static-initializer 0))

  (method ^:public ^:static getDefault :throws [NoSuchAlgorithmException] ^SSLContext []
    (let [^:mutable temporaryContext defaultContext]
      (when (nil? temporaryContext)
        (set! temporaryContext (SSLContext/getInstance "Default"))
        (locking SSLContext
          (if (nil? defaultContext)
              (set! defaultContext temporaryContext)
              (set! temporaryContext defaultContext))))
      temporaryContext)))

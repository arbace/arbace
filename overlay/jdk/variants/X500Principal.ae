;; Go-build variant of javax.security.auth.x500.X500Principal (J2G-SPEC §4.6;
;; doc/classes/JAVA-DEFERRED-TRIAGE.md, F2, "As built: F2 (write-ahead)"): read by j2g only. The
;; static initializer gives its JavaxSecurityAccess to jrt's jdk.internal.jrt.PkiAccess, which
;; X500Name's variant reads, in place of SharedSecrets (jrt's does not hold it). The replacing
;; members are jdk26u's (baf63fb; Copyright (c) Oracle and/or its affiliates, GPL 2 with the
;; Classpath Exception: LICENSE.md) as repr/java converts them, with the change named; the rest
;; Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'javax.security.auth.x500)

(j2g/variant X500Principal
  (static-initializer
    (jdk.internal.jrt.PkiAccess/setJavaxSecurityAccess
      (anon JavaxSecurityAccess []
        (method ^:public asX500Name ^X500Name [this ^X500Principal principal]
          (.-thisX500Name principal))

        (method ^:public asX500Principal ^X500Principal [this ^X500Name name]
          (X500Principal. name))))))

;; Go-build variant of java.util.PropertyResourceBundle (J2G-SPEC §4.6;
;; doc/classes/JAVA-DEFERRED-TRIAGE.md, F16, "As built: F16 (write-ahead)"): read by j2g only. The
;; InputStream constructor decodes the properties file as jdk26u's does, UTF-8, else ISO-8859-1 when
;; the bytes are not UTF-8 (sun.util.PropertyResourceBundleCharset's decoder), strict UTF-8 or
;; ISO-8859-1 alone when the java.util.PropertyResourceBundle.encoding property says so, but the
;; whole stream at once (jdk.internal.jrt.Utf8Coder.decodeOrThrow, then a StringReader) instead of
;; through a CharsetDecoder (CharsetDecoder, the charsets' newDecoder and PropertyResourceBundleCharset
;; are not in the Go build before F8). The difference: jdk26u's decoder falls back to ISO-8859-1 from
;; the start of the reader's buffer in which the malformed bytes appear (8,192 bytes), this from the
;; start of the file, the same for a file of one buffer. The replaced constructor is jdk26u's
;; (baf63fb; Copyright (c) Oracle and/or its affiliates, GPL 2 with the Classpath Exception:
;; LICENSE.md) as repr/java converts it, with the change named; the rest Copyright (c) the Arbace
;; authors; Eclipse Public License 1.0.
(in-ns 'java.util)

(j2g/variant PropertyResourceBundle
  (constructor :throws [IOException] ^:public [this ^InputStream stream]
    (this. (PropertyResourceBundle/jrtReader stream)))

  (j2g/add
    (method ^:private ^:static jrtReader :throws [IOException] ^Reader [^InputStream stream]
      (let [b (.readAllBytes stream)]
        (when-not (.equals "ISO-8859-1" encoding)
          (try
            (return (java.io.StringReader. (jdk.internal.jrt.Utf8Coder/decodeOrThrow b 0 (alength b))))
            (catch java.nio.charset.CharacterCodingException e (when (.equals "UTF-8" encoding) (throw e)))))
        (java.io.StringReader. (String. b java.nio.charset.StandardCharsets/ISO_8859_1))))))

;; Go-build variant of javax.crypto.SealedObject (J2G-SPEC §4.6; doc/classes/JAVA-DEFERRED-TRIAGE.md,
;; F1): read by j2g only. The static initializer, which gives SharedSecrets the access to the sealed
;; object's stream (for SunJCE's JCEKS key store, SealedObjectForKeyProtector: not in the Go build,
;; with java.security.KeyStore, F2), is cut. A sealed object needs serialization, outside the Go build
;; (J2G-SPEC §12): its constructor and getObject stop at ObjectOutputStream and ObjectInputStream.
;; Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'javax.crypto)

(j2g/variant SealedObject
  (j2g/cut (static-initializer 0)))

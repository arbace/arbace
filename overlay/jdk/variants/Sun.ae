;; Go-build variant of sun.security.provider.Sun (J2G-SPEC §4.6; doc/classes/JAVA-DEFERRED-TRIAGE.md,
;; F2 and F4, "As built: F2 (write-ahead)"): read by j2g only. The SUN provider registers, after the
;; services of SunEntries' constructor (its variant, F1's: up to the message digests), the rest of
;; jdk26u's list in its order, SunEntries.addPkiEntries (SunEntriesPki.ae): the X.509 certificate
;; factory, the PKCS12, JKS, CaseExactJKS and DKS key stores, the Collection and IndexedCollection
;; cert stores (F2), the JavaLoginConfig configuration (F4) and PKIX's builder and validator (F2).
;; The constructor is jdk26u's (baf63fb; Copyright (c) Oracle and/or its affiliates, GPL 2 with the
;; Classpath Exception: LICENSE.md) as repr/java converts it, with the call added; the rest Copyright
;; (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'sun.security.provider)

(j2g/variant Sun
  (constructor ^:public [this]
    (super. "SUN" SecurityConstants/PROVIDER_VER INFO)
    (let [^Provider p this
          entries (SunEntries. p)]
      (.addPkiEntries entries p)
      (let [^{:tag (Iterator Provider$Service)} serviceIter (.iterator entries)]
        (while (.hasNext serviceIter) (.putService this (cast Provider$Service (.next serviceIter))))))))

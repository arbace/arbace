;; Go-build variant of java.util.Scanner (J2G-SPEC §4.6; doc/classes/JAVA-DEFERRED-TRIAGE.md, F16,
;; "As built: F16 (write-ahead)"): read by j2g only. Until F16 jdk26u's Scanner was converted for
;; javac's tool build alone (the JDK build's tools, build.tools.spp's Scanner over a FileInputStream;
;; doc/classes/JAVA-FRONTEND-SURVEY.md, "As built: JN7", JFS18), with this variant there
;; (overlay/jdk/javac/variants); since F16 it is in the shipped closure and the variant with it. Its
;; File constructors read through FileInputStream.getChannel, which jrt's FileInputStream has not
;; (before F7): they read the file through the stream itself, decoded as the channel's readers decode
;; (the default charset, UTF-8; the decoder's own charset). Copyright (c) the Arbace authors; Eclipse
;; Public License 1.0.
(in-ns 'java.util)

(j2g/variant Scanner
  (constructor :throws [FileNotFoundException] ^:public [this ^File source]
    (this. ^InputStream (FileInputStream. source)))

  (constructor :throws [FileNotFoundException] ^:private [this ^File source ^CharsetDecoder dec]
    (this. ^Readable (InputStreamReader. (FileInputStream. source) (.charset dec)) WHITESPACE_PATTERN)))

;; Go-build variant of java.io.FilePermission (J2G-SPEC §4.6; doc/classes/JAVA-DEFERRED-TRIAGE.md,
;; F4, "As built: F4 (write-ahead)"): read by j2g only. The paths are the default file system's by
;; Path.of (jrt's java.nio.file.Path, HostPath, as sun.nio.fs.UnixPath behaves), where jdk26u asks
;; the built-in FileSystem of sun.nio.fs.DefaultFileSystemProvider for them:
;; java.nio.file.FileSystem and the providers are not in the Go build. builtInFS is cut; the four
;; path constants and init are jdk26u's with (.getPath builtInFS s) read as (Path/of s). The
;; replacing members are jdk26u's (baf63fb; Copyright (c) Oracle and/or its affiliates, GPL 2 with
;; the Classpath Exception: LICENSE.md) as repr/java converts them, with the change named; the rest
;; Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'java.io)

(j2g/variant FilePermission
  (j2g/cut (field ^:private ^:static ^:final ^java.nio.file.FileSystem builtInFS))

  (field ^:private ^:static ^:final ^Path here (Path/of (StaticProperty/userDir) (new String/1 [])))

  (field ^:private ^:static ^:final ^Path EMPTY_PATH (Path/of "" (new String/1 [])))

  (field ^:private ^:static ^:final ^Path DASH_PATH (Path/of "-" (new String/1 [])))

  (field ^:private ^:static ^:final ^Path DOTDOT_PATH (Path/of ".." (new String/1 [])))

  (method ^:private init ^void [this ^int mask]
    (when-not (== (bit-and-int mask ALL) mask)
      (throw (IllegalArgumentException. "invalid actions mask")))
    (when (== mask NONE) (throw (IllegalArgumentException. "invalid actions mask")))
    (if nb
        (let [^:mutable name (.getName this)]
          (when (nil? name) (throw (NullPointerException. "name can't be null")))
          (set! (.-mask this) mask)
          (if (.equals name "<<ALL FILES>>")
              (do (set! allFiles true) (set! npath EMPTY_PATH))
              (let [^:mutable rememberStar false]
                (when (.endsWith name "*")
                  (set! rememberStar true)
                  (set! recursive false)
                  (set! name
                        (java-str (.substring name 0 (unchecked-subtract-int (.length name) 1))
                                  "-")))
                (try
                  (set! npath (.normalize (Path/of (.getPath (File. name)) (new String/1 []))))
                  (let [lastName (.getFileName npath)]
                    (when (and (some? lastName) (.equals lastName DASH_PATH))
                      (set! directory true)
                      (set! recursive (not rememberStar))
                      (set! npath (.getParent npath)))
                    (when (nil? npath) (set! npath EMPTY_PATH))
                    (set! invalid false))
                  (catch InvalidPathException ipe
                    (set! npath (Path/of "-u-s-e-l-e-s-s-" (new String/1 [])))
                    (set! invalid true))))))
        (do
          (when (nil? (set! cpath (.getName this)))
            (throw (NullPointerException. "name can't be null")))
          (set! (.-mask this) mask)
          (if (.equals cpath "<<ALL FILES>>")
              (do
                (set! allFiles true)
                (set! directory true)
                (set! recursive true)
                (set! cpath ""))
              (do
                (try
                  (let [^String name (if (.endsWith cpath "*")
                                         (java-str
                                           (.substring
                                             cpath
                                             0
                                             (unchecked-subtract-int (.length cpath) 1))
                                           "-")
                                         cpath)]
                    (Path/of (.getPath (File. name)) (new String/1 [])))
                  (catch InvalidPathException ipe (set! invalid true) (return)))
                (try
                  (let [^:mutable path cpath]
                    (if (.endsWith cpath "*")
                        (do
                          (set! path
                                (java-str (.substring
                                            path
                                            0
                                            (unchecked-subtract-int (.length path) 1))
                                          "-"))
                          (set! path (.getCanonicalPath (File. path)))
                          (set! cpath
                                (java-str (.substring
                                            path
                                            0
                                            (unchecked-subtract-int (.length path) 1))
                                          "*")))
                        (set! cpath (.getCanonicalPath (File. path)))))
                  (catch IOException ignore))
                (let [^:mutable len (.length cpath)
                      ^char last (if (> len 0) (.charAt cpath (unchecked-subtract-int len 1)) 0)]
                  (if (and (== last RECURSIVE_CHAR)
                           (== (.charAt cpath (unchecked-subtract-int len 2)) File/separatorChar))
                      (do
                        (set! directory true)
                        (set! recursive true)
                        (set! cpath (.substring cpath 0 (set! len (unchecked-dec-int len)))))
                      (when (and (== last WILD_CHAR)
                                 (== (.charAt cpath (unchecked-subtract-int len 2))
                                     File/separatorChar))
                        (set! directory true)
                        (set! cpath (.substring cpath 0 (set! len (unchecked-dec-int len)))))))))))))

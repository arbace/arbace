;; Go-build variant of sun.nio.cs.StandardCharsets (J2G-SPEC §4.6; doc/classes/JAVA-DEFERRED-TRIAGE.md,
;; F8, "As built: F8 (write-ahead)"): read by j2g only. The class generated by the JDK build's
;; charsetmapping tool for linux (support/gensrc/java.base/sun/nio/cs/StandardCharsets.java) finds a
;; charset's class by name, Class.forName(packagePrefix + className).newInstance(); lookup asks jrt's
;; JrtCharsets (overlay/jdk/java.base/sun/nio/cs/JrtCharsets.java) to construct it directly (no class
;; loading by name in the Go build), null for a class it does not know, as the JDK's
;; ClassNotFoundException gives. The replacing member is jdk26u's generated one (baf63fb; Copyright
;; (c) Oracle and/or its affiliates, GPL 2 with the Classpath Exception: LICENSE.md) as repr/java
;; converts it, with the change named; the rest Copyright (c) the Arbace authors; Eclipse Public
;; License 1.0.
(in-ns 'sun.nio.cs)

(j2g/variant StandardCharsets
  (method ^:private lookup ^Charset [this ^String charsetName]
    (let [^:mutable ^String csn nil]
      (cond
        (.equals charsetName "UTF-8") UTF_8/INSTANCE
        (.equals charsetName "US-ASCII") US_ASCII/INSTANCE
        (.equals charsetName "ISO-8859-1") ISO_8859_1/INSTANCE
        :else
          (do
            (set! csn (.canonicalize this (StandardCharsets/toLower charsetName)))
            (let [cs (cast Charset (.get (.cache this) csn))]
              (if (some? cs)
                  cs
                  (let [cln (cast String (.get (.classMap this) csn))]
                    (when (some? cln)
                      (let [o (JrtCharsets/newCharset cln)]
                        (when (some? o)
                          (.cache this csn o))))))))))))

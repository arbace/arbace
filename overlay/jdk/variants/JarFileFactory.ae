;; Go-build variant of sun.net.www.protocol.jar.JarFileFactory (J2G-SPEC §4.6;
;; doc/classes/JAVA-CONFORMANCE-SURVEY.md, "As built: JC6b"): read by j2g only. urlFor is
;; jdk26u's on systems other than Windows, the URL itself (jdk.internal.util.OperatingSystem is
;; not in the Go build's world). Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'sun.net.www.protocol.jar)

(j2g/variant JarFileFactory
  (method ^:private urlFor :throws [IOException] ^URL [this ^URL url]
    url))

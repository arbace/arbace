;; Go-build variant of java.nio.charset.Charset (J2G-SPEC §4.6; doc/classes/JAVA-DEFERRED-TRIAGE.md,
;; F8, "As built: F8 (write-ahead)"): read by j2g only. No charset providers are found by
;; ServiceLoader (java.util.ServiceLoader is not in the Go build): providers is empty, so
;; lookupViaProviders finds nothing and needs no ScopedValue guard against recursion (IN_LOOKUP cut:
;; java.lang.ScopedValue is not in the Go build either); the extended providers, jdk.charsets'
;; ExtendedCharsets in the JDK, are none until jdk.charsets is in the Go build. The constructor copies
;; the aliases always, where jdk26u's copies them for a class outside the system domain alone
;; (VM.isSystemDomainLoader is not in the Go build; the copy of a system charset's array is not
;; observable). The replacing members are jdk26u's (baf63fb; Copyright (c) Oracle and/or its
;; affiliates, GPL 2 with the Classpath Exception: LICENSE.md) as repr/java converts them, with the
;; change named; the rest Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'java.nio.charset)

(j2g/variant Charset
  (method ^:private ^:static providers ^{:tag (Iterator CharsetProvider)} []
    (Collections/emptyIterator))

  (j2g/cut (field ^:private ^:static ^:final ^{:tag (ScopedValue Boolean)} IN_LOOKUP))

  (method ^:private ^:static lookupViaProviders ^Charset [^:final ^String charsetName]
    nil)

  (method ^:private ^:static extendedProviders0 ^{:tag (List CharsetProvider)} []
    (List/of))

  (constructor ^:protected [this ^String canonicalName ^String/1 aliases]
    (let [^String/1 as (if (nil? aliases)
                         zeroAliases
                         (cast String/1 (Arrays/copyOf aliases (alength aliases))))]
      (when (and (and (not (identical? canonicalName "ISO-8859-1"))
                      (not (identical? canonicalName "US-ASCII")))
                 (not (identical? canonicalName "UTF-8")))
        (Charset/checkName canonicalName)
        (loop [^int i 0]
          (when (< i (alength as)) (Charset/checkName (aget as i)) (recur (unchecked-inc-int i)))))
      (set! (.-name this) canonicalName)
      (set! (.-aliases this) as))))

;; Go-build variant of com.sun.net.httpserver.spi.HttpServerProvider (J2G-SPEC §4.6;
;; doc/classes/JAVA-DEFERRED-TRIAGE.md, F24, "As built: F24 (write-ahead)"): read by j2g only. The system-wide
;; provider is the class the system property com.sun.net.httpserver.HttpServerProvider names (found by
;; Class.forName in jrt's registry), else jdk.httpserver's own sun.net.httpserver.DefaultHttpServerProvider:
;; jdk26u's provider() less its ServiceLoader lookup (java.util.ServiceLoader is outside the Go build, class
;; loading by design; JCS90), as SelectorProvider's variant. The replacing method keeps jdk26u's code where it
;; keeps it (baf63fb; Copyright (c) Oracle and/or its affiliates, GPL 2 with the Classpath Exception:
;; LICENSE.md); the rest Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'com.sun.net.httpserver.spi)

(j2g/variant HttpServerProvider
  (j2g/cut ^:private ^:static loadProviderAsService ^boolean [])

  (method ^:public ^:static provider ^HttpServerProvider []
    (locking lock
      (cond
        (some? provider) provider
        (HttpServerProvider/loadProviderFromProperty) provider
        :else (do (set! provider (sun.net.httpserver.DefaultHttpServerProvider.)) provider)))))

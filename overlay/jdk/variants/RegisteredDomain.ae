;; Go-build variant of sun.security.util.RegisteredDomain (J2G-SPEC §4.6;
;; doc/classes/JAVA-DEFERRED-TRIAGE.md, F4, "As built: F4 (write-ahead)"): read by j2g only. from
;; finds no registered domain, as jdk26u's DomainName does when lib/security/public_suffix_list.dat
;; is absent: the public suffix list is not in the Go build's data, and DomainName logs through
;; sun.security.ssl.SSLLogger (F3). SocketPermission's wildcard match then compares the names alone.
;; The replacing members are jdk26u's (baf63fb; Copyright (c) Oracle and/or its affiliates, GPL 2
;; with the Classpath Exception: LICENSE.md) as repr/java converts them, with the change named; the
;; rest Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'sun.security.util)

(j2g/variant RegisteredDomain
  (method ^:static from ^{:tag (Optional RegisteredDomain)} [^String domain]
    (Optional/empty)))

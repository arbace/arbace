;; Go-build variant of sun.nio.ch.EPollSelectorProvider (J2G-SPEC §4.6; doc/go/JRT-NOTES.md, "Channels"; F10 of
;; doc/classes/JAVA-DEFERRED-TRIAGE.md, "As built: F10a"): read by j2g only. System.inheritedChannel's channel is
;; jdk26u's sun.nio.ch.InheritedChannel's, a socket channel over standard input when the launcher was given one
;; (inetd); jrt's program never is: null, as jdk26u's answer when standard input is not a socket.
;; Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'sun.nio.ch)

(j2g/variant EPollSelectorProvider
  (method ^:public inheritedChannel :throws [java.io.IOException] ^java.nio.channels.Channel [this]
    nil))

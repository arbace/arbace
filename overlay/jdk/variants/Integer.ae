;; Go-build variant of java.lang.Integer (J2G-SPEC §4.6): read by j2g only. toString(int), which
;; toString() and the decimal toString(int, int) call, is String.valueOf(int), jrt's own (Go's
;; strconv into a Latin-1 string), as Long's variant (doc/go/EVAL-SPEED.md). The same text.
;; Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'java.lang)

(j2g/variant Integer
  (method ^:public ^:static toString ^String [^int i]
    (String/valueOf i)))

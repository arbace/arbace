;; Go-build variant of sun.security.jca.ProviderConfig, its third file (J2G-SPEC §4.6;
;; doc/classes/JAVA-DEFERRED-TRIAGE.md, "As built: F23 (write-ahead)"): read by j2g only, after
;; ProviderConfig.ae and ProviderConfigJsse.ae (j2g applies a class's variant files in their order, and a
;; member replaced again is the last file's). getProvider again, F1's and F3's (SUN, SunRsaSign, SunJCE,
;; SunEC, SunJSSE constructed directly) with SunSASL beside them (java.security's provider 7), by its
;; name and by its class name, which the JDK's default branch loads through the ServiceLoader (the Go
;; build loads no provider by name; JCS133 (a): SASL after F1 and F4). Kept apart from F1's and F3's files
;; so that the branches merge without conflict; the three may be folded into ProviderConfig.ae (JCS232).
;; The replacing method keeps jdk26u's code where it keeps it (baf63fb; Copyright (c) Oracle and/or its
;; affiliates, GPL 2 with the Classpath Exception: LICENSE.md); the rest Copyright (c) the Arbace authors;
;; Eclipse Public License 1.0.
(in-ns 'sun.security.jca)

(j2g/variant ProviderConfig
  (method getProvider ^Provider [this]
    (let [^:mutable ^Provider p provider]
      (when (some? p)
        (return p))
      (locking this
        (set! p provider)
        (when (some? p)
          (return p))
        (when-not (.shouldLoad this)
          (return nil))
        (set! p (switch provName
                  ("SUN" "sun.security.provider.Sun") (sun.security.provider.Sun.)
                  ("SunRsaSign" "sun.security.rsa.SunRsaSign") (sun.security.rsa.SunRsaSign.)
                  ("SunJCE" "com.sun.crypto.provider.SunJCE") (com.sun.crypto.provider.SunJCE.)
                  "SunEC" (sun.security.ec.SunEC.)
                  ("SunJSSE" "sun.security.ssl.SunJSSE") (sun.security.ssl.SunJSSE.)
                  ("SunSASL" "com.sun.security.sasl.Provider") (com.sun.security.sasl.Provider.)
                  (do (.disableLoad this) nil)))
        (set! provider p))
      p)))

;; Go-build variant of com.sun.crypto.provider.ConstructKeys (J2G-SPEC §4.6;
;; doc/classes/JAVA-DEFERRED-TRIAGE.md, F1): read by j2g only. jdk26u's constructPrivateKey (its key
;; spec's clearing) reads SharedSecrets' JavaSecuritySpecAccess, which jrt's SharedSecrets does not
;; hold; the variant reads it from jrt's jdk.internal.jrt.CryptoAccess, which EncodedKeySpec's
;; static initializer sets (its variant). The replacing members are jdk26u's (baf63fb; Copyright (c)
;; Oracle and/or its affiliates, GPL 2 with the Classpath Exception: LICENSE.md) as repr/java
;; converts them, with the change named; the rest Copyright (c) the Arbace authors; Eclipse Public
;; License 1.0.
(in-ns 'com.sun.crypto.provider)

(j2g/variant ConstructKeys
  (method ^:private ^:static ^:final constructPrivateKey :throws [InvalidKeyException
                                                                  NoSuchAlgorithmException] ^PrivateKey [^byte/1 encodedKey
                                                                                                         ^int ofs
                                                                                                         ^int len
                                                                                                         ^String encodedKeyAlgorithm]
    (let [^:mutable ^PrivateKey key nil
          ^byte/1 keyBytes (if (and (== ofs 0) (== (alength encodedKey) len))
                               encodedKey
                               (Arrays/copyOfRange encodedKey ofs (unchecked-add-int ofs len)))
          keySpec (PKCS8EncodedKeySpec. keyBytes)]
      (try
        (let [keyFactory (KeyFactory/getInstance encodedKeyAlgorithm (SunJCE/getInstance))]
          (return (.generatePrivate keyFactory keySpec)))
        (catch NoSuchAlgorithmException nsae
          (try
            (let [keyFactory (KeyFactory/getInstance encodedKeyAlgorithm)]
              (set! key (.generatePrivate keyFactory keySpec)))
            (catch NoSuchAlgorithmException nsae2
              (throw (NoSuchAlgorithmException.
                       (java-str "No installed providers can create keys for the "
                                 encodedKeyAlgorithm
                                 "algorithm"))))
            (catch InvalidKeySpecException ikse2
              (throw (InvalidKeyException. "Cannot construct private key" ikse2)))))
        (catch InvalidKeySpecException ikse
          (throw (InvalidKeyException. "Cannot construct private key" ikse)))
        (finally
          (.clearEncodedKeySpec (jdk.internal.jrt.CryptoAccess/javaSecuritySpecAccess) keySpec)
          (when-not (identical? keyBytes encodedKey) (Arrays/fill keyBytes (unchecked-byte 0)))))
      key)))

;; Go-build variant of java.nio.channels.spi.SelectorProvider (J2G-SPEC §4.6; doc/go/JRT-NOTES.md, "Channels";
;; F10 of doc/classes/JAVA-DEFERRED-TRIAGE.md, "As built: F10a"): read by j2g only. The system-wide provider is
;; the class the system property names, else the platform's (sun.nio.ch.DefaultSelectorProvider): jdk26u's
;; Holder less its ServiceLoader lookup (java.util.ServiceLoader is outside the Go build, class loading by
;; design; JCS90). The replacing method keeps jdk26u's code where it keeps it (baf63fb; Copyright (c) Oracle
;; and/or its affiliates, GPL 2 with the Classpath Exception: LICENSE.md); the rest Copyright (c) the Arbace
;; authors; Eclipse Public License 1.0.
(in-ns 'java.nio.channels.spi)

(j2g/variant SelectorProvider$Holder
  (j2g/cut ^:private ^:static loadProviderAsService ^SelectorProvider [])

  (method ^:static provider ^SelectorProvider []
    (let [sp (SelectorProvider$Holder/loadProviderFromProperty)]
      (if (some? sp)
          sp
          (sun.nio.ch.DefaultSelectorProvider/get)))))

;; Go-build variant of java.nio.channels.spi.AbstractInterruptibleChannel (J2G-SPEC §4.6;
;; doc/classes/JAVA-DEFERRED-TRIAGE.md, F7, "As built: F7 (write-ahead)"): read by j2g only. jdk26u
;; registers the channel's Interruptible with the thread (JavaLangAccess.blockedOn), so that
;; Thread.interrupt closes a channel a thread is blocked on; jrt's Thread (hand-written) has no
;; blocker to call. blockedOn does nothing, and end also checks the thread's interrupt status: a
;; thread interrupted before an operation (begin, as jdk26u) or during it (end) closes the channel
;; and gets ClosedByInterruptException, as the JDK's; an interrupt of a thread blocked in a read of a
;; pipe or a terminal does not wake it (a file's operations do not block). begin and end keep jdk26u's
;; code but for that check (baf63fb; Copyright (c) Oracle and/or its affiliates, GPL 2 with the
;; Classpath Exception: LICENSE.md); the rest Copyright (c) the Arbace authors; Eclipse Public
;; License 1.0.
(in-ns 'java.nio.channels.spi)

(j2g/variant AbstractInterruptibleChannel
  (method ^:protected ^:final end :throws [AsynchronousCloseException] ^void [this
                                                                              ^boolean completed]
    (AbstractInterruptibleChannel/blockedOn nil)
    (let [me (Thread/currentThread)]
      (when (and (.isInterrupted me) (nil? (.-interruptedTarget this)))
        (.interrupt interruptor me)))
    (let [interruptedTarget (.-interruptedTarget this)]
      (when (some? interruptedTarget)
        (.postInterrupt interruptor)
        (when (identical? interruptedTarget (Thread/currentThread))
          (set! (.-interruptedTarget this) (Object.))
          (throw (ClosedByInterruptException.))))
      (when (and (not completed) closed) (throw (AsynchronousCloseException.)))))

  (method ^:static blockedOn ^void [^Interruptible intr]))

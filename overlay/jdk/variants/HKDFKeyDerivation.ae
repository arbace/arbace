;; Go-build variant of com.sun.crypto.provider.HKDFKeyDerivation (J2G-SPEC §4.6;
;; doc/classes/JAVA-DEFERRED-TRIAGE.md, F1): read by j2g only. jdk26u's hkdfExpand (its pseudorandom
;; key's clearing) reads SharedSecrets' JavaxCryptoSpecAccess, which jrt's SharedSecrets does not
;; hold; the variant reads it from jrt's jdk.internal.jrt.CryptoAccess, which SecretKeySpec's static
;; initializer sets (its variant). The replacing members are jdk26u's (baf63fb; Copyright (c) Oracle
;; and/or its affiliates, GPL 2 with the Classpath Exception: LICENSE.md) as repr/java converts
;; them, with the change named; the rest Copyright (c) the Arbace authors; Eclipse Public License
;; 1.0.
(in-ns 'com.sun.crypto.provider)

(j2g/variant HKDFKeyDerivation
  (method ^:private hkdfExpand :throws [InvalidKeyException NoSuchAlgorithmException] ^byte/1 [this
                                                                                               ^byte/1 prk
                                                                                               ^byte/1 info
                                                                                               ^int outLen]
    (let [^:mutable ^byte/1 kdfOutput nil]
      (when (or (nil? prk) (< (alength prk) hmacLen))
        (throw (InvalidKeyException. (java-str "prk must be at least " hmacLen " bytes"))))
      (let [pseudoRandomKey (SecretKeySpec. prk hmacAlgName)
            hmacObj (Mac/getInstance hmacAlgName)]
        (.init hmacObj pseudoRandomKey)
        (let [rounds (unchecked-divide-int
                       (unchecked-subtract-int (unchecked-add-int outLen hmacLen) 1)
                       hmacLen)]
          (set! kdfOutput (new byte/1 outLen))
          (let [^:mutable ^int i 0
                ^:mutable ^int offset 0]
            (try
              (while (< i rounds)
                (when (> i 0)
                  (.update hmacObj kdfOutput (unchecked-subtract-int offset hmacLen) hmacLen))
                (.update hmacObj info)
                (.update hmacObj (unchecked-byte (set! i (unchecked-inc-int i))))
                (if (and (== i rounds) (< (unchecked-subtract-int outLen offset) hmacLen))
                    (let [tmp (.doFinal hmacObj)]
                      (System/arraycopy tmp
                                        0
                                        kdfOutput
                                        offset
                                        (unchecked-subtract-int outLen offset))
                      (Arrays/fill tmp (unchecked-byte 0x00))
                      (set! offset outLen))
                    (do
                      (.doFinal hmacObj kdfOutput offset)
                      (set! offset (unchecked-add-int offset hmacLen)))))
              (catch ShortBufferException sbe (throw (ProviderException. sbe)))
              (finally
                (.clearSecretKeySpec (jdk.internal.jrt.CryptoAccess/javaxCryptoSpecAccess) pseudoRandomKey)))
            kdfOutput))))))

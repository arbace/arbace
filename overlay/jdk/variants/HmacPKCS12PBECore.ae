;; Go-build variant of com.sun.crypto.provider.HmacPKCS12PBECore (J2G-SPEC §4.6;
;; doc/classes/JAVA-DEFERRED-TRIAGE.md, F1): read by j2g only. jdk26u's engineInit (its MAC key's
;; clearing) reads SharedSecrets' JavaxCryptoSpecAccess, which jrt's SharedSecrets does not hold;
;; the variant reads it from jrt's jdk.internal.jrt.CryptoAccess, which SecretKeySpec's static
;; initializer sets (its variant). The replacing members are jdk26u's (baf63fb; Copyright (c) Oracle
;; and/or its affiliates, GPL 2 with the Classpath Exception: LICENSE.md) as repr/java converts
;; them, with the change named; the rest Copyright (c) the Arbace authors; Eclipse Public License
;; 1.0.
(in-ns 'com.sun.crypto.provider)

(j2g/variant HmacPKCS12PBECore
  (method ^:protected engineInit :throws [InvalidKeyException InvalidAlgorithmParameterException] ^void [this
                                                                                                         ^Key key
                                                                                                         ^AlgorithmParameterSpec params]
    (let [^:mutable ^char/1 password nil
          ^:mutable ^byte/1 derivedKey nil
          ^:mutable ^SecretKeySpec cipherKey nil
          keySpec (PBEUtil/getPBAKeySpec key params)]
      (try
        (set! password (.getPassword keySpec))
        (set! derivedKey
              (PKCS12PBECipherCore/derive password
                                          (.getSalt keySpec)
                                          (.getIterationCount keySpec)
                                          (.engineGetMacLength this)
                                          PKCS12PBECipherCore/MAC_KEY
                                          algorithm
                                          bl))
        (set! cipherKey (SecretKeySpec. derivedKey "HmacSHA1"))
        (.engineInit super cipherKey nil)
        (finally
          (when (some? cipherKey)
            (.clearSecretKeySpec (jdk.internal.jrt.CryptoAccess/javaxCryptoSpecAccess) cipherKey))
          (when (some? derivedKey) (Arrays/fill derivedKey (unchecked-byte 0)))
          (when (some? password) (Arrays/fill password \u0000))
          (.clearPassword keySpec))))))

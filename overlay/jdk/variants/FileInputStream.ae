;; Go-build variant of java.io.FileInputStream (J2G-SPEC §4.6): read by j2g only. skip is jdk26u's for a
;; regular file (skip0: lseek from the current position, backwards for a negative n, past the end allowed; the
;; displacement returned), where jrt's overlay returned 0 for n <= 0 (NegativeAvailable); on a closed stream
;; jdk26u's isRegularFile0 fails first, fstat(-1): IOException "Bad file descriptor" (OpsAfterClose's SKIP and
;; SKIP_BYTES; doc/classes/JAVA-DEFERRED-TRIAGE.md, "As built: n-java-defer (round 54), the fourth pass").
;; jrt's skip0 seeks for a file and reads for the standard streams (a negative n skips nothing there). A variant of
;; jrt's own Java so that it shows at the next build without the conversion; overlay/jdk/java.base's
;; FileInputStream.java takes it at the next bin/jrt-convert update (then this file goes). Copyright (c) the Arbace
;; authors; Eclipse Public License 1.0.
(in-ns 'java.io)

(j2g/variant FileInputStream
  (method ^:public skip :throws [IOException] ^long [this ^long n]
    (let [h (HostFiles/handle fd)]
      (when (< h 0) (throw (IOException. "Bad file descriptor")))
      (if (== n 0) 0 (HostFiles/skip h n)))))

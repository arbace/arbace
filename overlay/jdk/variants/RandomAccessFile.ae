;; Go-build variant of java.io.RandomAccessFile (J2G-SPEC §4.6; doc/classes/JAVA-CONFORMANCE-SURVEY.md,
;; "As built: JC6b"): read by j2g only. RandomAccessFile is translated from jdk26u; its natives
;; (RandomAccessFile.c, io_util.c) read the descriptor's field through JNI, which a jrt native
;; cannot (jrt builds without the translated classes, J2G-SPEC §9.1): each is replaced by a method
;; over jrt's file table (jdk.internal.jrt.HostFiles, the natives go/arbace/jrt/files.ae) with the
;; JDK's results: the modes "r", "rw", "rws" and "rwd" (the last two O_SYNC), a directory refused
;; as "Is a directory", readBytes0's and writeBytes0's null and bounds checks before the
;; descriptor's, "Stream Closed" on a closed file, setLength0's moving of the position. The writes
;; take no Blocker (the Go build's threads are goroutines, which a blocking write does not pin);
;; close has no channel to close (FileChannel is not in the Go build's world: getChannel stays an
;; operation-level stub); the static initializer, initIDs and the SharedSecrets access of
;; openAndDelete (Windows's) are cut. The replacing methods keep jdk26u's code where they keep it
;; (baf63fb; Copyright (c) Oracle and/or its affiliates, GPL 2 with the Classpath Exception:
;; LICENSE.md); the rest Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'java.io)

(j2g/variant RandomAccessFile
  (method ^:private open0 :throws [FileNotFoundException] ^void [this ^String name ^int mode]
    (let [hmode (cond (== mode RandomAccessFile/O_RDONLY) jdk.internal.jrt.HostFiles/READ
                      (not (== (bit-and-int mode RandomAccessFile/O_SYNC) 0)) jdk.internal.jrt.HostFiles/READ_WRITE_SYNC
                      (not (== (bit-and-int mode RandomAccessFile/O_DSYNC) 0)) jdk.internal.jrt.HostFiles/READ_WRITE_DSYNC
                      :else jdk.internal.jrt.HostFiles/READ_WRITE)]
      (.set fd (jdk.internal.jrt.HostFiles/open name hmode))))

  (method ^:private read0 :throws [IOException] ^int [this]
    (let [one (new byte/1 1)]
      (if (== (jdk.internal.jrt.HostFiles/read (jdk.internal.jrt.HostFiles/handle fd) one 0 1) -1)
          -1
          (bit-and-int (int (aget one 0)) 0xff))))

  (method ^:private readBytes0 :throws [IOException] ^int [this ^byte/1 b ^int off ^int len]
    (when (nil? b) (throw (NullPointerException.)))
    (when (or (< off 0) (< len 0) (< (unchecked-subtract-int (alength b) off) len))
      (throw (IndexOutOfBoundsException.)))
    (if (== len 0)
        0
        (jdk.internal.jrt.HostFiles/read (jdk.internal.jrt.HostFiles/handle fd) b off len)))

  (method ^:private implWrite :throws [IOException] ^void [this ^int b]
    (.write0 this b))

  (method ^:private write0 :throws [IOException] ^void [this ^int b]
    (let [one (new byte/1 1)]
      (aset one 0 (unchecked-byte b))
      (jdk.internal.jrt.HostFiles/write (jdk.internal.jrt.HostFiles/handle fd) one 0 1)))

  (method ^:private implWriteBytes :throws [IOException] ^void [this ^byte/1 b ^int off ^int len]
    (.writeBytes0 this b off len))

  (method ^:private writeBytes0 :throws [IOException] ^void [this ^byte/1 b ^int off ^int len]
    (when (nil? b) (throw (NullPointerException.)))
    (when (or (< off 0) (< len 0) (< (unchecked-subtract-int (alength b) off) len))
      (throw (IndexOutOfBoundsException.)))
    (when-not (== len 0)
      (jdk.internal.jrt.HostFiles/write (jdk.internal.jrt.HostFiles/handle fd) b off len)))

  (method ^:public getFilePointer :throws [IOException] ^long [this]
    (jdk.internal.jrt.HostFiles/position (jdk.internal.jrt.HostFiles/handle fd)))

  (method ^:private seek0 :throws [IOException] ^void [this ^long pos]
    (jdk.internal.jrt.HostFiles/seek (jdk.internal.jrt.HostFiles/handle fd) pos))

  (method ^:private length0 :throws [IOException] ^long [this]
    (jdk.internal.jrt.HostFiles/length (jdk.internal.jrt.HostFiles/handle fd)))

  (method ^:private setLength0 :throws [IOException] ^void [this ^long newLength]
    (jdk.internal.jrt.HostFiles/setLength (jdk.internal.jrt.HostFiles/handle fd) newLength))

  (method ^:public close :throws [IOException] ^void [this]
    (when-not closed
      (locking closeLock (when closed (return)) (set! closed true))
      (.closeAll fd
                 (anon Closeable []
                   (method ^:public close :throws [IOException] ^void [this] (.close fd))))))

  (j2g/cut ^:private ^:static ^:native initIDs ^void [])
  (j2g/cut (static-initializer 0)))

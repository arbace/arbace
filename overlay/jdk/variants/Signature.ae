;; Go-build variant of java.security.Signature (J2G-SPEC §4.6; doc/classes/JAVA-DEFERRED-TRIAGE.md, F1):
;; read by j2g only. The first static initializer, which gives SharedSecrets the access to
;; Signature's initVerify and initSign with parameters (for sun.security.util.SignatureUtil, PKI's:
;; not in the Go build until F2), is cut; the second (the debug flags) stays. Copyright (c) the
;; Arbace authors; Eclipse Public License 1.0.
(in-ns 'java.security)

(j2g/variant Signature
  (j2g/cut (static-initializer 0)))

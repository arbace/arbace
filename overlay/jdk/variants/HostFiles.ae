;; Go-build variant of jdk.internal.jrt.HostFiles (J2G-SPEC §4.6): read by j2g only. open refuses a path
;; holding a NUL character as jdk26u's file streams do before opening it (File.isInvalid, UnixFileSystem's:
;; FileNotFoundException "Invalid file path"), for every stream that opens through it (FileInputStream,
;; FileOutputStream; RandomAccessFile checks it itself, as jdk26u's): NulFile (doc/classes/JAVA-DEFERRED-TRIAGE.md,
;; "As built: n-java-defer (round 54), the fourth pass"). A variant of jrt's own Java so that it shows at the next
;; build without the conversion; overlay/jdk/java.base/jdk/internal/jrt/HostFiles.java takes it at the next
;; bin/jrt-convert update (then this file goes). Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'jdk.internal.jrt)

(j2g/variant HostFiles
  (method ^:public ^:static open :throws [FileNotFoundException] ^int [^String path ^int mode]
    (when (>= (.indexOf path 0) 0) (throw (FileNotFoundException. "Invalid file path")))
    (let [error (new String/1 1)
          h (HostFiles/open0 path mode error)]
      (when (< h 0) (throw (FileNotFoundException. (java-str path " (" (aget error 0) ")"))))
      h)))

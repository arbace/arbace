;; Go-build variant of javax.security.auth.Subject (J2G-SPEC §4.6;
;; doc/classes/JAVA-DEFERRED-TRIAGE.md, F4, "As built: F4 (write-ahead)"): read by j2g only. current
;; and callAs keep the subject in a ThreadLocal, bound for the call and restored after it, in place
;; of jdk26u's ScopedValue (java.lang.ScopedValue is not in the Go build). The difference: a
;; StructuredTaskScope's forks would inherit a ScopedValue binding; there is no StructuredTaskScope
;; in the Go build. The replacing members are jdk26u's (baf63fb; Copyright (c) Oracle and/or its
;; affiliates, GPL 2 with the Classpath Exception: LICENSE.md) as repr/java converts them, with the
;; change named; the rest Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'javax.security.auth)

(j2g/variant Subject
  (j2g/cut (field ^:private ^:static ^:final ^{:tag (ScopedValue Subject)} SCOPED_SUBJECT))

  (j2g/add
    (field ^:private ^:static ^:final ^{:tag (ThreadLocal Subject)} CURRENT_SUBJECT (ThreadLocal.)))

  (method ^:public ^:static current ^Subject []
    (cast Subject (.get CURRENT_SUBJECT)))

  (method ^:public ^:static callAs :type-params [T] :throws [CompletionException] ^T [^:final ^Subject subject
                                                                                      ^:final ^{:tag (Callable T)} action]
    (Objects/requireNonNull action)
    (let [previous (cast Subject (.get CURRENT_SUBJECT))]
      (.set CURRENT_SUBJECT subject)
      (try
        (.call action)
        (catch Exception e (throw (CompletionException. e)))
        (finally (.set CURRENT_SUBJECT previous))))))

;; Go-build variant of java.net.Inet4Address (J2G-SPEC §4.6; doc/go/JRT-NOTES.md, "Sockets"):
;; read by j2g only. The native init (JNI's field ids) has no Go meaning. Copyright (c) the
;; Arbace authors; Eclipse Public License 1.0.
(in-ns 'java.net)

(j2g/variant Inet4Address
  (j2g/cut (static-initializer 0))
  (j2g/cut ^:private ^:static ^:native init ^void []))

;; Go-build variant of sun.security.ssl.SSLSocketImpl (J2G-SPEC §4.6; doc/classes/JAVA-DEFERRED-TRIAGE.md,
;; F3, "As built: F3 (write-ahead)"): read by j2g only. InetAddress's access object (the original host
;; name) is jrt's jdk.internal.jrt.NetAccess's, set by InetAddress's variant (InetAddressAccess.ae), in
;; place of SharedSecrets (jrt has none). The replacing members are jdk26u's (baf63fb; Copyright (c) Oracle and/or its affiliates, GPL 2
;; with the Classpath Exception: LICENSE.md) as repr/java converts them, with the change named; the rest
;; Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'sun.security.ssl)

(j2g/variant SSLSocketImpl
  (method ^:private useImplicitHost ^void [this ^boolean useNameService]
    (let [inetAddress (.getInetAddress this)]
      (when (some? inetAddress)
        (let [jna (jdk.internal.jrt.NetAccess/getJavaNetInetAddressAccess)
              originalHostname (.getOriginalHostName jna inetAddress)]
          (cond
            (and (some? originalHostname) (not (.isEmpty originalHostname)))
              (do
                (set! (.-peerHost this) originalHostname)
                (when (and (.isEmpty (.-serverNames (.-sslConfig conContext)))
                           (not (.-noSniExtension (.-sslConfig conContext))))
                  (set! (.-serverNames (.-sslConfig conContext))
                        (Utilities/addToSNIServerNameList
                          (.-serverNames (.-sslConfig conContext))
                          peerHost))))
            (not useNameService) (set! (.-peerHost this) (.getHostAddress inetAddress))
            :else (set! (.-peerHost this) (.getHostName (.getInetAddress this)))))))))

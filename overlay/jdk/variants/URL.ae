;; Go-build variant of java.net.URL (J2G-SPEC §4.6; doc/go/JRT-NOTES.md, "Files"): read by j2g
;; only. URL is translated from jdk26u. The handlers are found as the JDK finds them without
;; installed providers (the ServiceLoader lookup, over ScopedValue, is outside the closed world:
;; none is found), and the default factory knows the handlers the Go build has: file:, jar:, and
;; since F12 (doc/classes/JAVA-DEFERRED-TRIAGE.md, "As built: F12 (write-ahead)") http:, https:, ftp:
;; and mailto: with their connections (jdk26u's handlers' classes; before F12 http: and https: had
;; their syntax alone), and since java-tail2-1126 jrt: (jrt's own handler: the syntax, no run-time image); since
;; java-ffm-1127 jar: is jrt's class path's handler, the JDK's for a jar file but the executable's embedded resources by
;; their URL whatever made it (jdk.internal.jrt.ClassPathResources.jarHandler). The static initializer that hands URL's handler to the JDK's other packages
;; (SharedSecrets' JavaNetURLAccess, jrt's lacks it) is gone, and so are the static fields of
;; the lookup's ScopedValue, outside the world (serialPersistentFields, cut until serialization came
;; into the world, is jdk26u's since its slice 4: doc/classes/JAVA-DEFERRED-TRIAGE.md, "As built:
;; serialization slice 4").
;; (URLStreamHandler's hashCode and hostsEqual, which resolve the host through InetAddress, are
;; the JDK's since InetAddress is in the world: JRT-NOTES.md, "Sockets".) DefaultFactory's
;; createURLStreamHandler keeps jdk26u's code where it keeps it (baf63fb; Copyright (c) Oracle
;; and/or its affiliates, GPL 2 with the Classpath Exception: LICENSE.md); the rest Copyright (c)
;; the Arbace authors; Eclipse Public License 1.0.
(in-ns 'java.net)

(j2g/variant URL
  (j2g/cut (static-initializer 0))
  (j2g/cut (field ^:private ^:static ^:final ^{:tag (ScopedValue Boolean)} IN_LOOKUP))
  (method ^:private ^:static lookupViaProviders ^URLStreamHandler [^:final ^String protocol]
    nil))

(j2g/variant URL$DefaultFactory
  (method ^:public createURLStreamHandler ^URLStreamHandler [this ^String protocol]
    (switch protocol
      "file" (return (sun.net.www.protocol.file.Handler.))
      ;; java-ffm-1127: jrt's class path's jar: handler (jdk.internal.jrt.ClassPathResources/jarHandler, a subclass of
      ;; the JDK's): a jar: URL naming the executable opens the embedded resource it names, any other jar file the JDK's way
      "jar" (return (jdk.internal.jrt.ClassPathResources/jarHandler))
      "http" (return (sun.net.www.protocol.http.Handler.))
      "https" (return (sun.net.www.protocol.https.Handler.))
      "ftp" (return (sun.net.www.protocol.ftp.Handler.))
      "mailto" (return (sun.net.www.protocol.mailto.Handler.))
      ;; java-tail2-1126: jrt's own handler (overlay/jdk/java.base/sun/net/www/protocol/jrt/Handler.java): the syntax,
      ;; no run-time image to connect to
      "jrt" (return (sun.net.www.protocol.jrt.Handler.)))
    nil))

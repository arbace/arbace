;; Go-build variant of javax.security.auth.login.Configuration (J2G-SPEC §4.6;
;; doc/classes/JAVA-DEFERRED-TRIAGE.md, F4, "As built: F4 (write-ahead)"): read by j2g only.
;; getConfiguration constructs the default configuration, sun.security.provider.ConfigFile, directly
;; (no class loading by name, as jrt's providers are constructed); a configuration class named by
;; the security property login.configuration.provider is still found by Class.forName, in jrt's
;; registry. The replacing members are jdk26u's (baf63fb; Copyright (c) Oracle and/or its
;; affiliates, GPL 2 with the Classpath Exception: LICENSE.md) as repr/java converts them, with the
;; change named; the rest Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'javax.security.auth.login)

(j2g/variant Configuration
  (method ^:public ^:static getConfiguration ^Configuration []
    (locking Configuration
      (when (nil? configuration)
        (let [^:mutable config_class (Security/getProperty "login.configuration.provider")]
          (when (or (nil? config_class) (.equals config_class "sun.security.provider.ConfigFile"))
            (Configuration/setConfiguration (sun.security.provider.ConfigFile.))
            (return configuration))
          (try
            (let [^{:tag (Class (? extends Configuration))} implClass (.asSubclass
                                                                        (Class/forName
                                                                          config_class
                                                                          false
                                                                          (.getContextClassLoader
                                                                            (Thread/currentThread)))
                                                                        Configuration)
                  result (cast Configuration (.newInstance implClass))]
              (Configuration/setConfiguration result))
            (catch ReflectiveOperationException e
              (throw (SecurityException. (java-str "Configuration error: " (.toString e) "\n") e))))))
      configuration)))

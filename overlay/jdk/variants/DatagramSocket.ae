;; Go-build variant of java.net.DatagramSocket (J2G-SPEC §4.6; doc/go/JRT-NOTES.md, "Datagrams"; F11 of
;; doc/classes/JAVA-DEFERRED-TRIAGE.md): read by j2g only. A datagram socket's delegate is jdk26u's
;; legacy NetMulticastSocket over jrt's own java.net.HostDatagramSocketImpl (overlay/jdk), the
;; host's UDP socket, in place of the NIO adaptor (sun.nio.ch.DatagramSocketAdaptor over
;; DatagramChannelImpl: java.nio's channels and selectors are outside the closed world); a
;; DatagramSocketImplFactory's impl is wrapped as in the JDK. The constructor asserts no
;; DatagramSocketAdaptor. The replacing methods keep jdk26u's code where they keep it (baf63fb;
;; Copyright (c) Oracle and/or its affiliates, GPL 2 with the Classpath Exception: LICENSE.md); the
;; rest Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'java.net)

(j2g/variant DatagramSocket
  (constructor [this ^DatagramSocket delegate]
    (java-assert (or (nil? delegate) (instance? NetMulticastSocket delegate)))
    (set! (.-delegate this) delegate))

  (method ^:static createDelegate :type-params [(T extends DatagramSocket)] :throws [SocketException] ^T [^SocketAddress bindaddr
                                                                                                          ^{:tag (Class T)} type]
    (when-not (identical? bindaddr NO_DELEGATE)
      (java-assert (or (identical? type DatagramSocket) (identical? type MulticastSocket)))
      (let [multicast (identical? type MulticastSocket)
            ^:mutable ^DatagramSocket delegate nil
            ^:mutable initialized false]
        (try
          (let [factory DatagramSocket/factory
                impl (if (some? factory)
                         (Objects/requireNonNull
                           (.createDatagramSocketImpl factory)
                           "Implementation returned by installed DatagramSocketImplFactory is null")
                         (HostDatagramSocketImpl.))]
            (set! delegate (NetMulticastSocket. impl))
            (.getImpl (cast NetMulticastSocket delegate))
            (when multicast (.setReuseAddress delegate true))
            (when (some? bindaddr) (.bind delegate bindaddr))
            (try (.setBroadcast delegate true) (catch IOException ioe))
            (set! initialized true))
          (catch IOException ioe (throw (DatagramSocket/toSocketException ioe)))
          (finally (when (and (not initialized) (some? delegate)) (.close delegate))))
        (let [^T result delegate] result)))))

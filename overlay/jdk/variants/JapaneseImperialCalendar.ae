;; Go-build variant of java.util.JapaneseImperialCalendar (J2G-SPEC §4.6; queue 543): read by j2g only. computeTime's
;; zone offsets of a zone that is no ZoneInfo: jdk26u calls the package-private TimeZone.getOffsets(long, int[]), which
;; the Go build's TimeZone has not (overlay/jdk/variants/TimeZone.ae cuts it); here the raw offset and the rest of
;; getOffset's, as jrt's GregorianCalendar (overlay) computes them. The replacing member is jdk26u's (baf63fb;
;; Copyright (c) Oracle and/or its affiliates, GPL 2 with the Classpath Exception: LICENSE.md) as repr/java converts
;; it, with the change named; the rest Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'java.util)

(j2g/variant JapaneseImperialCalendar
  (method ^:protected computeTime ^void [this]
    (when-not (.isLenient this)
      (when (nil? originalFields)
        (set! originalFields (new int/1 JapaneseImperialCalendar/FIELD_COUNT)))
      (loop [^int field 0]
        (when (< field JapaneseImperialCalendar/FIELD_COUNT)
          (let [value (.internalGet this field)]
            (when (.isExternallySet this field)
              (when (or (< value (.getMinimum this field)) (> value (.getMaximum this field)))
                (throw (IllegalArgumentException. (JapaneseImperialCalendar/getFieldName field)))))
            (aset originalFields field value)
            (recur (unchecked-inc-int field))))))
    (let [fieldMask (.selectFields this)
          ^:mutable ^int year 0
          ^:mutable ^int era 0]
      (cond
        (.isSet this JapaneseImperialCalendar/ERA)
          (do
            (set! era (.internalGet this JapaneseImperialCalendar/ERA))
            (when (>= era (alength eras)) (throw (IllegalArgumentException. "Invalid era")))
            (set! year
                  (if (.isSet this JapaneseImperialCalendar/YEAR)
                      (.internalGet this JapaneseImperialCalendar/YEAR)
                      1)))
        (.isSet this JapaneseImperialCalendar/YEAR)
          (do (set! era currentEra) (set! year (.internalGet this JapaneseImperialCalendar/YEAR)))
        :else (do (set! era SHOWA) (set! year 45)))
      (let [^:mutable timeOfDay 0]
        (if (JapaneseImperialCalendar/isFieldSet fieldMask JapaneseImperialCalendar/HOUR_OF_DAY)
            (set! timeOfDay
                  (unchecked-add timeOfDay
                                 (long (.internalGet this JapaneseImperialCalendar/HOUR_OF_DAY))))
            (do
              (set! timeOfDay
                    (unchecked-add timeOfDay (.internalGet this JapaneseImperialCalendar/HOUR)))
              (when (JapaneseImperialCalendar/isFieldSet fieldMask JapaneseImperialCalendar/AM_PM)
                (set! timeOfDay
                      (unchecked-add timeOfDay
                                     (unchecked-multiply-int
                                       12
                                       (.internalGet this JapaneseImperialCalendar/AM_PM)))))))
        (set! timeOfDay (unchecked-multiply timeOfDay 60))
        (set! timeOfDay
              (unchecked-add timeOfDay (.internalGet this JapaneseImperialCalendar/MINUTE)))
        (set! timeOfDay (unchecked-multiply timeOfDay 60))
        (set! timeOfDay
              (unchecked-add timeOfDay (.internalGet this JapaneseImperialCalendar/SECOND)))
        (set! timeOfDay (unchecked-multiply timeOfDay 1000))
        (set! timeOfDay
              (unchecked-add timeOfDay (.internalGet this JapaneseImperialCalendar/MILLISECOND)))
        (let [^:mutable fixedDate (unchecked-divide timeOfDay ONE_DAY)]
          (set! timeOfDay (unchecked-remainder timeOfDay ONE_DAY))
          (while (< timeOfDay 0)
            (set! timeOfDay (unchecked-add timeOfDay ONE_DAY))
            (set! fixedDate (unchecked-dec fixedDate)))
          (set! fixedDate (unchecked-add fixedDate (.getFixedDate this era year fieldMask)))
          (let [^:mutable millis (unchecked-add
                                   (unchecked-multiply
                                     (unchecked-subtract fixedDate EPOCH_OFFSET)
                                     ONE_DAY)
                                   timeOfDay)
                zone (.getZone this)]
            (when (nil? zoneOffsets) (set! zoneOffsets (new int/1 2)))
            (let [tzMask (bit-and-int fieldMask
                                      (bit-or-int
                                        JapaneseImperialCalendar/ZONE_OFFSET_MASK
                                        JapaneseImperialCalendar/DST_OFFSET_MASK))]
              (when-not (== tzMask
                            (bit-or-int JapaneseImperialCalendar/ZONE_OFFSET_MASK
                                        JapaneseImperialCalendar/DST_OFFSET_MASK))
                (if (instance? ZoneInfo zone)
                    (.getOffsetsByWall (cast ZoneInfo zone) millis zoneOffsets)
                    ;; Arbace: TimeZone.getOffsets(millis - rawOffset, zoneOffsets), which the Go build's
                    ;; TimeZone has not (its variant cuts it): the raw offset and the rest of the offset, as
                    ;; jrt's GregorianCalendar computes them
                    (let [raw (.getRawOffset zone)]
                      (aset zoneOffsets 0 raw)
                      (aset zoneOffsets 1 (unchecked-subtract-int (.getOffset zone (unchecked-subtract millis raw)) raw)))))
              (when-not (== tzMask 0)
                (when (JapaneseImperialCalendar/isFieldSet
                        tzMask
                        JapaneseImperialCalendar/ZONE_OFFSET)
                  (aset zoneOffsets 0 (.internalGet this JapaneseImperialCalendar/ZONE_OFFSET)))
                (when (JapaneseImperialCalendar/isFieldSet
                        tzMask
                        JapaneseImperialCalendar/DST_OFFSET)
                  (aset zoneOffsets 1 (.internalGet this JapaneseImperialCalendar/DST_OFFSET))))
              (set! millis
                    (unchecked-subtract millis
                                        (unchecked-add-int
                                          (aget zoneOffsets 0)
                                          (aget zoneOffsets 1))))
              (set! (.-time this) millis)
              (let [mask (.computeFields this
                                         (bit-or-int fieldMask (.getSetStateFields this))
                                         tzMask)]
                (when-not (.isLenient this)
                  (loop [^int field 0]
                    (when (< field JapaneseImperialCalendar/FIELD_COUNT)
                      (cond
                        (not (.isExternallySet this field)) (recur (unchecked-inc-int field))
                        (not (== (aget originalFields field) (.internalGet this field)))
                          (let [wrongValue (.internalGet this field)]
                            (System/arraycopy originalFields
                                              0
                                              (.-fields this)
                                              0
                                              (alength (.-fields this)))
                            (throw (IllegalArgumentException.
                                     (java-str (JapaneseImperialCalendar/getFieldName field)
                                               "="
                                               wrongValue
                                               ", expected "
                                               (aget originalFields field)))))
                        :else (recur (unchecked-inc-int field))))))
                (.setFieldsNormalized this mask)))))))))

;; Go-build variant of java.net.InterfaceAddress (J2G-SPEC §4.6; doc/go/JRT-NOTES.md, "Datagrams";
;; F11): read by j2g only. The JDK's natives set an address's fields through JNI; the Go build's
;; NetworkInterface (NetworkInterface.ae) makes it with this constructor, added. Copyright (c) the
;; Arbace authors; Eclipse Public License 1.0.
(in-ns 'java.net)

(j2g/variant InterfaceAddress
  (j2g/add
    (constructor [this ^InetAddress address ^Inet4Address broadcast ^short maskLength]
      (set! (.-address this) address)
      (set! (.-broadcast this) broadcast)
      (set! (.-maskLength this) maskLength))))

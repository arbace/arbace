;; Go-build variant of sun.reflect.generics.reflectiveObjects.TypeVariableImpl (J2G-SPEC §4.6;
;; doc/classes/JAVA-DEFERRED-TRIAGE.md, "As built: F25 (write-ahead)"): read by j2g only. jdk26u's
;; class is translated whole but for its annotation members, which parse the class file's
;; RuntimeVisibleTypeAnnotations through TypeAnnotationParser (the constant pool: outside the closed
;; world, which records no type annotations yet; F14's type annotations row) and map them through
;; AnnotationType: here a type variable's annotations are jdk.internal.jrt.ReflectSupport's
;; typeVariableAnnotations (none until type annotations are recorded), its lookups ReflectSupport's;
;; getAnnotatedBounds is refused; and getGenericDeclaration returns the declaration itself, where
;; jdk26u copies a Method or Constructor through ReflectionFactory (jrt's Method and Constructor hold
;; no mutable state but the accessible flag). Copyright (c) the Arbace authors; Eclipse Public
;; License 1.0.
(in-ns 'sun.reflect.generics.reflectiveObjects)

(j2g/variant TypeVariableImpl
  (method ^:public getGenericDeclaration ^D [this]
    (.-genericDeclaration this))
  (method ^:public getAnnotation :type-params [(T extends Annotation)] ^T
    [this ^{:tag (Class T)} annotationClass]
    (Objects/requireNonNull annotationClass)
    (jdk.internal.jrt.ReflectSupport/annotation (.getAnnotations this) annotationClass))
  (method ^:public getAnnotationsByType :type-params [(T extends Annotation)] ^T/1
    [this ^{:tag (Class T)} annotationClass]
    (Objects/requireNonNull annotationClass)
    (jdk.internal.jrt.ReflectSupport/annotationsByType (.getAnnotations this) annotationClass))
  (method ^:public getAnnotations ^Annotation/1 [this]
    (let [^int myIndex (.typeVarIndex this)]
      (when (< myIndex 0)
        (throw (AssertionError. "Index must be non-negative.")))
      (jdk.internal.jrt.ReflectSupport/typeVariableAnnotations (.getGenericDeclaration this) myIndex)))
  (method ^:public getAnnotatedBounds ^AnnotatedType/1 [this]
    (throw (UnsupportedOperationException. "TypeVariable.getAnnotatedBounds: the Go build records no type annotations (F25)")))
  (j2g/cut ^:private ^:static mapAnnotations ^{:tag (Map (Class (? extends Annotation)) Annotation)} [^Annotation/1 annos]))

;; Go-build variant of javax.script.ScriptEngineManager (J2G-SPEC §4.6; doc/classes/JAVA-DEFERRED-TRIAGE.md, F19,
;; "As built: F19 (write-ahead)"): read by j2g only. jdk26u's manager finds its engines' factories through
;; ServiceLoader (the context class loader's META-INF/services, or the installed modules'), outside the closed
;; world: the Go build has no class loading from jars (J2G-SPEC §12), and JDK 26's image holds no engine (Nashorn
;; left with JDK 15), so the manager finds none, as on the JDK, and its name, extension and MIME-type lookups
;; answer null; the engines a program registers (registerEngineName and the like) are jdk26u's. The no-argument
;; constructor takes the system class loader (jrt's threads have no context class loader). The rest is jdk26u's
;; (baf63fb; Copyright (c) Oracle and/or its affiliates, GPL 2 with the Classpath Exception: LICENSE.md); the
;; variant Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'javax.script)

(j2g/variant ScriptEngineManager
  (constructor ^:public [this]
    (this. (ClassLoader/getSystemClassLoader)))

  (j2g/cut ^:private getServiceLoader ^{:tag (ServiceLoader ScriptEngineFactory)} [this ^:final ^ClassLoader loader])

  (method ^:private initEngines ^void [this ^:final ^ClassLoader loader]))

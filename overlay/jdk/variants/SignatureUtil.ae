;; Go-build variant of sun.security.util.SignatureUtil (J2G-SPEC §4.6;
;; doc/classes/JAVA-DEFERRED-TRIAGE.md, F2, "As built: F2 (write-ahead)"): read by j2g only.
;; jdk26u's initVerifyWithParam and initSignWithParam read SharedSecrets'
;; JavaSecuritySignatureAccess, which Signature's static initializer sets (SignatureAccess.ae); the
;; variant reads it from jrt's holder instead. The replacing members are jdk26u's (baf63fb;
;; Copyright (c) Oracle and/or its affiliates, GPL 2 with the Classpath Exception: LICENSE.md) as
;; repr/java converts them, with the change named; the rest Copyright (c) the Arbace authors;
;; Eclipse Public License 1.0.
(in-ns 'sun.security.util)

(j2g/variant SignatureUtil
  (method ^:public ^:static initVerifyWithParam :throws [InvalidAlgorithmParameterException
                                                         InvalidKeyException] ^void [^Signature s
                                                                                     ^PublicKey key
                                                                                     ^AlgorithmParameterSpec params]
    (.initVerify (jdk.internal.jrt.PkiAccess/javaSecuritySignatureAccess) s key params))

  (method ^:public ^:static initVerifyWithParam :throws [InvalidAlgorithmParameterException
                                                         InvalidKeyException] ^void [^Signature s
                                                                                     ^Certificate cert
                                                                                     ^AlgorithmParameterSpec params]
    (.initVerify (jdk.internal.jrt.PkiAccess/javaSecuritySignatureAccess) s cert params))

  (method ^:public ^:static initSignWithParam :throws [InvalidAlgorithmParameterException
                                                       InvalidKeyException] ^void [^Signature s
                                                                                   ^PrivateKey key
                                                                                   ^AlgorithmParameterSpec params
                                                                                   ^SecureRandom sr]
    (.initSign (jdk.internal.jrt.PkiAccess/javaSecuritySignatureAccess) s key params sr)))

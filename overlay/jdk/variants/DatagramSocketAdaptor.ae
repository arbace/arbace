;; Go-build variant of sun.nio.ch.DatagramSocketAdaptor (J2G-SPEC §4.6; doc/go/JRT-NOTES.md, "Channels"; F10 of
;; doc/classes/JAVA-DEFERRED-TRIAGE.md, "As built: F10b"): read by j2g only. jdk26u's adaptor reaches three
;; non-public members of java.net through method handles and a VarHandle made by a private lookup
;; (NetworkInterface.getDefault, NetworkInterface's constructor, DatagramSocket.NO_DELEGATE); java.lang.invoke's
;; lookups are not in the Go build (J2G-SPEC §8.5: only the VarHandle constants of field accesses are), so the
;; nested holders NetworkInterfaces and DatagramSockets call jrt's public accessors of the same members, added by
;; the variants of NetworkInterface (jrtGetDefault, jrtNew) and DatagramSocket (jrtNoDelegate). Copyright (c)
;; the Arbace authors; Eclipse Public License 1.0.
(in-ns 'sun.nio.ch)

(j2g/variant DatagramSocketAdaptor$NetworkInterfaces
  (j2g/cut (static-initializer 0))

  (j2g/cut (field ^:static ^:final ^MethodHandle GET_DEFAULT))

  (j2g/cut (field ^:static ^:final ^MethodHandle CONSTRUCTOR))

  (method ^:static getDefault ^NetworkInterface []
    (java.net.NetworkInterface/jrtGetDefault))

  (method ^:static newNetworkInterface ^NetworkInterface [^String name ^int index ^InetAddress/1 addrs]
    (java.net.NetworkInterface/jrtNew name index addrs)))

(j2g/variant DatagramSocketAdaptor$DatagramSockets
  (static-initializer
    (set! NO_DELEGATE (java.net.DatagramSocket/jrtNoDelegate))))

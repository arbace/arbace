;; Go-build variant of sun.net.www.protocol.jar.URLJarFile (J2G-SPEC §4.6;
;; doc/classes/JAVA-CONFORMANCE-SURVEY.md, "As built: JC6b"): read by j2g only. A jar: URL's jar
;; file is opened at JarFile's base version: java.lang.Runtime.Version is not in the Go build's
;; world, so the constructors taking one do not exist in Go, and a URL's "#runtime" reference (a
;; multi-release jar read at the runtime's version) is read as the base version. getJarFile and
;; retrieve keep jdk26u's code but for the version (baf63fb; Copyright (c) Oracle and/or its
;; affiliates, GPL 2 with the Classpath Exception: LICENSE.md); the rest Copyright (c) the Arbace
;; authors; Eclipse Public License 1.0.
(in-ns 'sun.net.www.protocol.jar)

(j2g/variant URLJarFile
  (method ^:static getJarFile :throws [IOException] ^JarFile [^URL url
                                                              ^URLJarFileCloseController closeController]
    (if (ParseUtil/isLocalFileURL url)
        (URLJarFile. url closeController)
        (URLJarFile/retrieve url closeController)))

  (j2g/add
    (constructor :throws [IOException] ^:private [this ^File file
                                                  ^URLJarFileCloseController closeController]
      (super. file true (bit-or-int ZipFile/OPEN_READ ZipFile/OPEN_DELETE))
      (set! (.-closeController this) closeController)))

  (j2g/add
    (constructor :throws [IOException] ^:private [this ^URL url
                                                  ^URLJarFileCloseController closeController]
      (super. (File. (ParseUtil/decode (.getFile url))) true ZipFile/OPEN_READ)
      (set! (.-closeController this) closeController)))

  (method ^:private ^:static retrieve :throws [IOException] ^JarFile [^:final ^URL url
                                                                      ^:final ^URLJarFileCloseController closeController]
    (with-resources [in (.getInputStream (.openConnection url))]
      (let [tmpFile (Files/createTempFile "jar_cache" nil (new FileAttribute/1 []))]
        (try
          (Files/copy in tmpFile (new CopyOption/1 [StandardCopyOption/REPLACE_EXISTING]))
          (let [^JarFile jarFile (URLJarFile. (.toFile tmpFile) closeController)]
            (.deleteOnExit (.toFile tmpFile))
            jarFile)
          (catch Throwable thr
            (try (Files/delete tmpFile) (catch IOException ioe (.addSuppressed thr ioe)))
            (throw thr)))))))

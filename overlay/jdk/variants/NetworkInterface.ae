;; Go-build variant of java.net.NetworkInterface (J2G-SPEC §4.6; doc/go/JRT-NOTES.md, "Datagrams"; F11
;; of doc/classes/JAVA-DEFERRED-TRIAGE.md): read by j2g only. The natives, JNI over getifaddrs and
;; ioctl in the JDK, read the host's interfaces through jrt's jdk.internal.jrt.HostDatagram
;; (overlay/jdk; Go's net.Interfaces in B1a): an interface's name is its display name, its
;; addresses its bindings (InterfaceAddress's added constructor), no sub-interfaces (Linux's
;; "eth0:1" aliases, which Go's net does not list). The static initializer loads no library and
;; has no native init. Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'java.net)

(j2g/variant NetworkInterface
  ^{:j2g/nth 0}
  (static-initializer
    (set! defaultInterface (DefaultInterface/getDefault)))

  (j2g/cut ^:private ^:static ^:native init ^void [])

  (j2g/add
    (method ^:private ^:static ofRow ^NetworkInterface [^jdk.internal.jrt.HostDatagram$Row r]
      (let [addrs (.-addrs r)
            n (alength addrs)
            ni (NetworkInterface. (.-name r) (.-index r) addrs)
            b (new InterfaceAddress/1 n)]
        (loop [^int i 0]
          (when (< i n)
            (aset b i (InterfaceAddress. (aget addrs i) (aget (.-broadcasts r) i) (aget (.-prefixes r) i)))
            (recur (unchecked-inc-int i))))
        (set! (.-displayName ni) (.-name r))
        (set! (.-bindings ni) b)
        (set! (.-childs ni) (new NetworkInterface/1 0))
        ni)))

  (j2g/add
    (method ^:private ^:static orNull ^NetworkInterface [^jdk.internal.jrt.HostDatagram$Row r]
      (if (nil? r) nil (NetworkInterface/ofRow r))))

  (method ^:private ^:static getAll :throws [SocketException] ^NetworkInterface/1 []
    (let [rows (jdk.internal.jrt.HostDatagram/rows)
          n (alength rows)
          res (new NetworkInterface/1 n)]
      (loop [^int i 0]
        (when (< i n)
          (aset res i (NetworkInterface/ofRow (aget rows i)))
          (recur (unchecked-inc-int i))))
      res))

  (method ^:private ^:static getByName0 :throws [SocketException] ^NetworkInterface [^String name]
    (NetworkInterface/orNull (jdk.internal.jrt.HostDatagram/byName name)))

  (method ^:private ^:static getByIndex0 :throws [SocketException] ^NetworkInterface [^int index]
    (NetworkInterface/orNull (jdk.internal.jrt.HostDatagram/byIndex index)))

  (method ^:private ^:static boundInetAddress0 :throws [SocketException] ^boolean [^InetAddress addr]
    (some? (jdk.internal.jrt.HostDatagram/byAddress addr)))

  (method ^:private ^:static getByInetAddress0 :throws [SocketException] ^NetworkInterface [^InetAddress addr]
    (NetworkInterface/orNull (jdk.internal.jrt.HostDatagram/byAddress addr)))

  (method ^:private ^:static isUp0 :throws [SocketException] ^boolean [^String name ^int ind]
    (not (== (bit-and (.-flags (jdk.internal.jrt.HostDatagram/of name ind)) jdk.internal.jrt.HostDatagram/UP) 0)))

  (method ^:private ^:static isLoopback0 :throws [SocketException] ^boolean [^String name ^int ind]
    (not (== (bit-and (.-flags (jdk.internal.jrt.HostDatagram/of name ind)) jdk.internal.jrt.HostDatagram/LOOPBACK) 0)))

  (method ^:private ^:static supportsMulticast0 :throws [SocketException] ^boolean [^String name ^int ind]
    (not (== (bit-and (.-flags (jdk.internal.jrt.HostDatagram/of name ind)) jdk.internal.jrt.HostDatagram/MULTICAST) 0)))

  (method ^:private ^:static isP2P0 :throws [SocketException] ^boolean [^String name ^int ind]
    (not (== (bit-and (.-flags (jdk.internal.jrt.HostDatagram/of name ind)) jdk.internal.jrt.HostDatagram/POINT_TO_POINT) 0)))

  (method ^:private ^:static getMacAddr0 :throws [SocketException] ^byte/1 [^byte/1 inAddr ^String name ^int ind]
    (.-mac (jdk.internal.jrt.HostDatagram/of name ind)))

  (method ^:private ^:static getMTU0 :throws [SocketException] ^int [^String name ^int ind]
    (.-mtu (jdk.internal.jrt.HostDatagram/of name ind))))

;; Go-build variant of java.security.spec.EncodedKeySpec (J2G-SPEC §4.6;
;; doc/classes/JAVA-DEFERRED-TRIAGE.md, F1): read by j2g only. The static initializer gives the access to
;; EncodedKeySpec.clear (for ConstructKeys, PKCS8Key, ECUtil and KeyUtil) to jrt's
;; jdk.internal.jrt.CryptoAccess, where the JDK gives it to SharedSecrets (jrt's does not hold it).
;; Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'java.security.spec)

(j2g/variant EncodedKeySpec
  (static-initializer
    (jdk.internal.jrt.CryptoAccess/setJavaSecuritySpecAccess
      (method-ref JavaSecuritySpecAccess EncodedKeySpec/.clear))))

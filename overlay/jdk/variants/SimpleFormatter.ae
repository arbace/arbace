;; Go-build variant of java.util.logging.SimpleFormatter (J2G-SPEC §4.6;
;; doc/classes/JAVA-DEFERRED-TRIAGE.md, "As built: F5 (write-ahead)"): read by j2g only. The format
;; is SurrogateLogger.getSimpleFormat's (jdk.internal.logger is not in the Go build, JCS136):
;; SimpleConsoleLogger.Formatting.getSimpleFormat for the key java.util.logging.SimpleFormatter.format,
;; the system property, else the LogManager's property, validated by formatting it once, else
;; the default format, transcribed in an added method. The replacing field and the added method
;; keep jdk26u's code (baf63fb, src/java.base/share/classes/jdk/internal/logger/SimpleConsoleLogger.java;
;; Copyright (c) Oracle and/or its affiliates, GPL 2 with the Classpath Exception: LICENSE.md); the
;; rest Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'java.util.logging)

(j2g/variant SimpleFormatter
  (field ^:private ^:final ^String format
    (SimpleFormatter/simpleFormat
      (method-ref Function ^String [String] SimpleFormatter/getLoggingProperty)))

  (j2g/add
    (method ^:private ^:static simpleFormat ^String [^{:tag (Function String String)} defaultPropertyGetter]
      (let [defaultFormat "%1$tb %1$td, %1$tY %1$tl:%1$tM:%1$tS %1$Tp %2$s%n%4$s: %5$s%6$s%n"
            key "java.util.logging.SimpleFormatter.format"
            ^:mutable ^String format (System/getProperty key)]
        (when (and (nil? format) (some? defaultPropertyGetter))
          (set! format (.apply defaultPropertyGetter key)))
        (if (some? format)
            (try
              (String/format format (new Object/1 [(ZonedDateTime/now) "" "" "" "" ""]))
              (catch IllegalArgumentException e (set! format defaultFormat)))
            (set! format defaultFormat))
        format))))

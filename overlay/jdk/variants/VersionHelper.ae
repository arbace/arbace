;; Go-build variant of com.sun.naming.internal.VersionHelper (J2G-SPEC §4.6; doc/classes/JAVA-DEFERRED-TRIAGE.md,
;; F19, "As built: F19 (write-ahead)"): read by j2g only. JNDI's helper loads classes and resource files through
;; the thread's context class loader; jrt's threads have none and its ClassLoader has no getResources: the
;; loader is the system class loader (what jdk26u falls back on), Class.forName looks the name up in the one
;; registry of classes (J2G-SPEC §10.3), and the application resource files (jndi.properties on the class path,
;; ResourceManager's) are none, as on a JDK whose class path holds none. getJndiProperties reads the JNDI
;; properties one by one, System.getProperty's values (jrt has no System.getProperties for translated code). The rest is jdk26u's (baf63fb;
;; Copyright (c) Oracle and/or its affiliates, GPL 2 with the Classpath Exception: LICENSE.md); the variant
;; Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'com.sun.naming.internal)

(j2g/variant VersionHelper
  (method getResources :throws [IOException] ^{:tag (NamingEnumeration InputStream)} [this ^ClassLoader cl
                                                                                      ^String name]
    (InputStreamEnumeration. (java.util.Collections/emptyEnumeration)))

  (method getContextClassLoader ^ClassLoader [this]
    (ClassLoader/getSystemClassLoader))

  (method getJndiProperties ^String/1 [this]
    (let [jProps (new String/1 (alength PROPS))]
      (loop [^int i 0]
        (when (< i (alength PROPS))
          (aset jProps i (System/getProperty (aget PROPS i)))
          (recur (unchecked-inc-int i))))
      jProps)))

;; Go-build variant of sun.security.util.Password (J2G-SPEC §4.6;
;; doc/classes/JAVA-DEFERRED-TRIAGE.md, F4, "As built: F4 (write-ahead)"): read by j2g only.
;; readPassword reads the stream as jdk26u does when no console is available: java.io.Console,
;; jdk.internal.io.JdkConsoleImpl and the charset encoders ConsoleHolder needs are not in the Go
;; build (F8 for the encoders), nor is JavaLangAccess.initialSystemIn; ConsoleHolder is emptied. A
;; password read from System.in is echoed, as the JDK's when System.in is not the console, and the
;; warning that says so is printed when nothing is available yet. The replacing members are jdk26u's
;; (baf63fb; Copyright (c) Oracle and/or its affiliates, GPL 2 with the Classpath Exception:
;; LICENSE.md) as repr/java converts them, with the change named; the rest Copyright (c) the Arbace
;; authors; Eclipse Public License 1.0.
(in-ns 'sun.security.util)

(j2g/variant Password
  (method ^:public ^:static readPassword :throws [IOException] ^char/1 [^:mutable ^InputStream in
                                                                        ^boolean isEchoOn]
    (let [^:mutable ^char/1 consoleEntered nil
          ^:mutable ^byte/1 consoleBytes nil
          ^:mutable ^char/1 buf nil]
      (try
        (when-not isEchoOn
          (cond
            (and (and (identical? in System/in) (VM/isBooted)) (== (.available System/in) 0))
              (.print System/err (ResourcesMgr/getString "warning.input.may.be.visible.on.screen"))))
        (set! buf (new char/1 128))
        (let [^:mutable room (alength buf)
              ^:mutable ^int offset 0
              ^:mutable ^int c 0
              ^:mutable done false]
          (while (not done)
            (switch (set! c (.read in))
              (-1 \newline) (set! done true)
              \return
                (let [c2 (.read in)]
                  (if (and (not (== c2 \newline)) (not (== c2 -1)))
                      (do
                        (when-not (instance? PushbackInputStream in)
                          (set! in (PushbackInputStream. in)))
                        (.unread (cast PushbackInputStream in) c2)
                        (when (< (set! room (unchecked-dec-int room)) 0)
                          (let [oldBuf buf]
                            (set! buf (new char/1 (unchecked-add-int offset 128)))
                            (set! room
                                  (unchecked-subtract-int
                                    (unchecked-subtract-int (alength buf) offset)
                                    1))
                            (System/arraycopy oldBuf 0 buf 0 offset)
                            (Arrays/fill oldBuf \space)))
                        (aset buf offset (unchecked-char c))
                        (set! offset (unchecked-inc-int offset)))
                      (set! done true)))
              (do
                (when (< (set! room (unchecked-dec-int room)) 0)
                  (let [oldBuf buf]
                    (set! buf (new char/1 (unchecked-add-int offset 128)))
                    (set! room
                          (unchecked-subtract-int (unchecked-subtract-int (alength buf) offset) 1))
                    (System/arraycopy oldBuf 0 buf 0 offset)
                    (Arrays/fill oldBuf \space)))
                (aset buf offset (unchecked-char c))
                (set! offset (unchecked-inc-int offset)))))
          (when-not (== offset 0)
            (let [ret (new char/1 offset)] (System/arraycopy buf 0 ret 0 offset) ret)))
        (finally
          (when (some? consoleEntered) (Arrays/fill consoleEntered \space))
          (when (some? consoleBytes) (Arrays/fill consoleBytes (unchecked-byte 0)))
          (when (some? buf) (Arrays/fill buf \space))))))

  (defclass ^:private ^:static ConsoleHolder))

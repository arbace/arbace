;; Go-build variant of sun.net.www.http.HttpClient (J2G-SPEC §4.6; doc/classes/JAVA-DEFERRED-TRIAGE.md, F12,
;; "As built: F12 (write-ahead)"): read by j2g only. The static initializer reads its five system
;; properties by System.getProperty, as jdk26u reads them from System.getProperties (jrt has no
;; getProperties for translated code: the same values); otherwise jdk26u's code (baf63fb; Copyright (c)
;; Oracle and/or its affiliates, GPL 2 with the Classpath Exception: LICENSE.md). One member added:
;; jrtServerSocket, the connection's socket (NetworkClient's protected serverSocket), which
;; java.net.HttpConnectSocketImpl reads by reflection in jdk26u (HttpConnectSocketImpl.ae,
;; HttpURLConnectionImpl.ae). The rest Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'sun.net.www.http)

(j2g/variant HttpClient
  (static-initializer
    (let [keepAlive (System/getProperty "http.keepAlive")
          retryPost (System/getProperty "sun.net.http.retryPost")
          cacheNTLM (System/getProperty "jdk.ntlm.cache")
          cacheSPNEGO (System/getProperty "jdk.spnego.cache")
          s (System/getProperty "jdk.https.negotiate.cbt")]
      (set! spnegoCBT (HttpClient/normalizeCBT s))
      (if (some? keepAlive)
          (set! keepAliveProp (Boolean/parseBoolean keepAlive))
          (set! keepAliveProp true))
      (if (some? retryPost)
          (set! retryPostProp (Boolean/parseBoolean retryPost))
          (set! retryPostProp true))
      (if (some? cacheNTLM)
          (set! cacheNTLMProp (Boolean/parseBoolean cacheNTLM))
          (set! cacheNTLMProp true))
      (if (some? cacheSPNEGO)
          (set! cacheSPNEGOProp (Boolean/parseBoolean cacheSPNEGO))
          (set! cacheSPNEGOProp true))))

  (j2g/add
    (method ^:public jrtServerSocket ^java.net.Socket [this]
      serverSocket)))

;; Go-build variant of java.net.Inet4AddressImpl (J2G-SPEC §4.6; doc/go/JRT-NOTES.md,
;; "Sockets"): read by j2g only. Its natives are the host's, as Inet6AddressImpl's
;; (Inet6AddressImpl.ae), for IPv4 alone. The replacing methods keep jdk26u's code where they keep it (baf63fb; Copyright (c)
;; Oracle and/or its affiliates, GPL 2 with the Classpath Exception: LICENSE.md); the rest
;; Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'java.net)

(j2g/variant Inet4AddressImpl
  (method ^:public getLocalHostName :throws [UnknownHostException] ^String [this]
    (jdk.internal.jrt.HostNet/getLocalHostName))

  (method ^:private lookupAllHostAddr :throws [UnknownHostException] ^InetAddress/1 [this ^String hostname]
    (jdk.internal.jrt.HostNet/lookupAllHostAddr hostname java.net.spi.InetAddressResolver$LookupPolicy/IPV4))

  (method ^:public getHostByAddr :throws [UnknownHostException] ^String [this ^byte/1 addr]
    (jdk.internal.jrt.HostNet/getHostByAddr addr))

  ;; n-java-net (doc/classes/JAVA-DEFERRED-TRIAGE.md, "As built: n-java-net"): isReachable is the JDK's fallback
  ;; (Inet4AddressImpl.c's tcp_ping4, Inet6AddressImpl.c's tcp_ping6): a TCP connection to the echo port 7 within
  ;; the timeout, from the interface's address when one is given, the host reachable when the connection is made
  ;; or refused. The JDK tries ICMP's echo first where it may (a raw socket, or Linux's ping socket); jrt does not,
  ;; nor set the ttl (IP_TTL): the answer differs for a host that answers ICMP but drops TCP to port 7
  (method ^:private isReachable0 :throws [java.io.IOException] ^boolean [this ^byte/1 addr ^int timeout
                                                                 ^byte/1 ifaddr ^int ttl]
    (Inet4AddressImpl/jrtTcpEcho (InetAddress/getByAddress addr)
                                 timeout
                                 ^InetAddress (when (some? ifaddr)
                                                (InetAddress/getByAddress ifaddr))))

  (j2g/add
    (method ^:static jrtTcpEcho :throws [java.io.IOException] ^boolean [^InetAddress target ^int timeout
                                                                       ^InetAddress local]
      (let [s (Socket.)]
        (try
          (when (some? local)
            (try (.bind s (InetSocketAddress. local 0)) (catch java.io.IOException e (return false))))
          (try
            (.connect s (InetSocketAddress. target 7) (if (> timeout 0) timeout 1))
            true
            (catch ConnectException e
              (let [m (.getMessage e)] (and (some? m) (.startsWith m "Connection refused"))))
            (catch java.io.IOException e false))
          (finally (.close s)))))))

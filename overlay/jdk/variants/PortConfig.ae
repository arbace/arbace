;; Go-build variant of sun.net.PortConfig (J2G-SPEC §4.6; doc/classes/JAVA-DEFERRED-TRIAGE.md, F4,
;; "As built: F4 (write-ahead)"): read by j2g only. The static initializer loads no library and
;; takes Linux's defaults (the Go build runs on Linux and in the box), getLower0 and getUpper0 read
;; /proc/sys/net/ipv4/ip_local_port_range as libnet's PortConfig.c
;; (src/java.base/unix/native/libnet/PortConfig.c) does on Linux, -1 when it cannot be read.
;; Arbace's own code, after jdk26u's. The replacing members are jdk26u's (baf63fb; Copyright (c)
;; Oracle and/or its affiliates, GPL 2 with the Classpath Exception: LICENSE.md) as repr/java
;; converts them, with the change named; the rest Copyright (c) the Arbace authors; Eclipse Public
;; License 1.0.
(in-ns 'sun.net)

(j2g/variant PortConfig
  (static-initializer
    (let [^:mutable v (PortConfig/getLower0)]
      (when (== v -1) (set! v 32768))
      (set! lower v)
      (set! v (PortConfig/getUpper0))
      (when (== v -1) (set! v 61000))
      (set! upper v)))

  (method ^:static getLower0 ^int [] (PortConfig/procRange 0))

  (method ^:static getUpper0 ^int [] (PortConfig/procRange 1))

  (j2g/add
    (method ^:private ^:static procRange ^int [^int i]
      (try
        (let [in (java.io.FileInputStream. "/proc/sys/net/ipv4/ip_local_port_range")]
          (try
            (let [parts (.split (.trim (String. (.readAllBytes in))) "\\s+")]
              (if (== (alength parts) 2) (Integer/parseInt (aget parts i)) -1))
            (finally (.close in))))
        (catch Exception e -1)))))

;; Go-build variant of java.lang.Long (J2G-SPEC §4.6): read by j2g only. toString(long), which
;; toString() and the decimal toString(long, int) call, is String.valueOf(long), jrt's own (Go's
;; strconv into a Latin-1 string): the JDK's DecimalDigits writes the digits a pair at a time
;; through Unsafe, a call per byte on Go, and was a quarter of a str of three pieces
;; (doc/go/EVAL-SPEED.md). The same text. Copyright (c) the Arbace authors; Eclipse Public
;; License 1.0.
(in-ns 'java.lang)

(j2g/variant Long
  (method ^:public ^:static toString ^String [^long i]
    (String/valueOf i)))

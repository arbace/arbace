;; Go-build variant of sun.security.provider.SunEntries (J2G-SPEC §4.6; doc/go/JRT-NOTES.md,
;; "Security"; doc/classes/JAVA-DEFERRED-TRIAGE.md, F1): read by j2g only. The SUN provider of the Go
;; build registers the services it implements, jdk26u's constructor up to its message digests: the
;; SecureRandom generators (NativePRNG and its blocking and non-blocking kinds, over the host's random
;; source, DRBG, SHA1PRNG), the signatures (DSA in its DER and P1363 formats, HSS/LMS, ML-DSA), the key
;; pair generators (DSA, ML-DSA), DSA's parameter generator and parameters, the key factories (DSA,
;; HSS/LMS, ML-DSA) and the message digests (MD2, MD5, SHA-1, the SHA-2 and SHA-3 families,
;; SHAKE128-256, SHAKE256-512), with the JDK's aliases and attributes, in the JDK's order (since F1;
;; before it, the generators and digests alone). The rest of jdk26u's list, the certificate factory,
;; key stores, cert stores, login configuration and cert path builder and validator (X.509, PKCS12,
;; JKS, DKS, PKIX: PKI's, F2, and JAAS's, F4), is left out: their classes, and the engine classes of
;; their types (KeyStore, CertificateFactory ...), are not in the Go build, so Provider.getService
;; answers null for them and getInstance the JDK's NoSuchAlgorithmException. The replacing
;; constructor is jdk26u's (baf63fb; Copyright (c) Oracle and/or its affiliates, GPL 2 with the
;; Classpath Exception: LICENSE.md) as repr/java converts it, cut after the digests; the rest
;; Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'sun.security.provider)

(j2g/variant SunEntries
  (constructor [this ^Provider p]
    (set! services (LinkedHashSet. 50 (float 0.9)))
    (let [^{:tag (HashMap String String)} attrs (HashMap. 3)]
      (.put attrs "ThreadSafe" "true")
      (when (NativePRNG/isAvailable)
        (.add this p "SecureRandom" "NativePRNG" "sun.security.provider.NativePRNG" attrs))
      (when (NativePRNG$Blocking/isAvailable)
        (.add this
              p
              "SecureRandom"
              "NativePRNGBlocking"
              "sun.security.provider.NativePRNG$Blocking"
              attrs))
      (when (NativePRNG$NonBlocking/isAvailable)
        (.add this
              p
              "SecureRandom"
              "NativePRNGNonBlocking"
              "sun.security.provider.NativePRNG$NonBlocking"
              attrs))
      (.put attrs "ImplementedIn" "Software")
      (.add this p "SecureRandom" "DRBG" "sun.security.provider.DRBG" attrs)
      (.add this p "SecureRandom" "SHA1PRNG" "sun.security.provider.SecureRandom" attrs)
      (.clear attrs)
      (let [dsaKeyClasses
              "java.security.interfaces.DSAPublicKey|java.security.interfaces.DSAPrivateKey"]
        (.put attrs "SupportedKeyClasses" dsaKeyClasses)
        (.put attrs "ImplementedIn" "Software")
        (.put attrs "KeySize" "1024")
        (.addWithAlias this
                       p
                       "Signature"
                       "SHA1withDSA"
                       "sun.security.provider.DSA$SHA1withDSA"
                       attrs)
        (.addWithAlias this p "Signature" "NONEwithDSA" "sun.security.provider.DSA$RawDSA" attrs)
        (.put attrs "KeySize" "2048")
        (.addWithAlias this
                       p
                       "Signature"
                       "SHA224withDSA"
                       "sun.security.provider.DSA$SHA224withDSA"
                       attrs)
        (.addWithAlias this
                       p
                       "Signature"
                       "SHA256withDSA"
                       "sun.security.provider.DSA$SHA256withDSA"
                       attrs)
        (.addWithAlias this
                       p
                       "Signature"
                       "SHA3-224withDSA"
                       "sun.security.provider.DSA$SHA3_224withDSA"
                       attrs)
        (.addWithAlias this
                       p
                       "Signature"
                       "SHA3-256withDSA"
                       "sun.security.provider.DSA$SHA3_256withDSA"
                       attrs)
        (.put attrs "KeySize" "3072")
        (.addWithAlias this
                       p
                       "Signature"
                       "SHA384withDSA"
                       "sun.security.provider.DSA$SHA384withDSA"
                       attrs)
        (.addWithAlias this
                       p
                       "Signature"
                       "SHA512withDSA"
                       "sun.security.provider.DSA$SHA512withDSA"
                       attrs)
        (.addWithAlias this
                       p
                       "Signature"
                       "SHA3-384withDSA"
                       "sun.security.provider.DSA$SHA3_384withDSA"
                       attrs)
        (.addWithAlias this
                       p
                       "Signature"
                       "SHA3-512withDSA"
                       "sun.security.provider.DSA$SHA3_512withDSA"
                       attrs)
        (.remove attrs "KeySize")
        (.add this
              p
              "Signature"
              "SHA1withDSAinP1363Format"
              "sun.security.provider.DSA$SHA1withDSAinP1363Format")
        (.add this
              p
              "Signature"
              "NONEwithDSAinP1363Format"
              "sun.security.provider.DSA$RawDSAinP1363Format")
        (.add this
              p
              "Signature"
              "SHA224withDSAinP1363Format"
              "sun.security.provider.DSA$SHA224withDSAinP1363Format")
        (.add this
              p
              "Signature"
              "SHA256withDSAinP1363Format"
              "sun.security.provider.DSA$SHA256withDSAinP1363Format")
        (.add this
              p
              "Signature"
              "SHA384withDSAinP1363Format"
              "sun.security.provider.DSA$SHA384withDSAinP1363Format")
        (.add this
              p
              "Signature"
              "SHA512withDSAinP1363Format"
              "sun.security.provider.DSA$SHA512withDSAinP1363Format")
        (.add this
              p
              "Signature"
              "SHA3-224withDSAinP1363Format"
              "sun.security.provider.DSA$SHA3_224withDSAinP1363Format")
        (.add this
              p
              "Signature"
              "SHA3-256withDSAinP1363Format"
              "sun.security.provider.DSA$SHA3_256withDSAinP1363Format")
        (.add this
              p
              "Signature"
              "SHA3-384withDSAinP1363Format"
              "sun.security.provider.DSA$SHA3_384withDSAinP1363Format")
        (.add this
              p
              "Signature"
              "SHA3-512withDSAinP1363Format"
              "sun.security.provider.DSA$SHA3_512withDSAinP1363Format")
        (.clear attrs)
        (.put attrs "ImplementedIn" "Software")
        (.addWithAlias this p "Signature" "HSS/LMS" "sun.security.provider.HSS" attrs)
        (.add this p "Signature" "ML-DSA" "sun.security.provider.ML_DSA_Impls$SIG" attrs)
        (.addWithAlias this
                       p
                       "Signature"
                       "ML-DSA-44"
                       "sun.security.provider.ML_DSA_Impls$SIG2"
                       attrs)
        (.addWithAlias this
                       p
                       "Signature"
                       "ML-DSA-65"
                       "sun.security.provider.ML_DSA_Impls$SIG3"
                       attrs)
        (.addWithAlias this
                       p
                       "Signature"
                       "ML-DSA-87"
                       "sun.security.provider.ML_DSA_Impls$SIG5"
                       attrs)
        (.clear attrs)
        (.put attrs "ImplementedIn" "Software")
        (let [^:mutable dsaKPGImplClass "sun.security.provider.DSAKeyPairGenerator$"]
          (set! dsaKPGImplClass (java-str dsaKPGImplClass (if useLegacyDSA "Legacy" "Current")))
          (.put attrs "KeySize" "2048")
          (.addWithAlias this p "KeyPairGenerator" "DSA" dsaKPGImplClass attrs)
          (.remove attrs "KeySize")
          (.add this p "KeyPairGenerator" "ML-DSA" "sun.security.provider.ML_DSA_Impls$KPG" attrs)
          (.addWithAlias this
                         p
                         "KeyPairGenerator"
                         "ML-DSA-44"
                         "sun.security.provider.ML_DSA_Impls$KPG2"
                         attrs)
          (.addWithAlias this
                         p
                         "KeyPairGenerator"
                         "ML-DSA-65"
                         "sun.security.provider.ML_DSA_Impls$KPG3"
                         attrs)
          (.addWithAlias this
                         p
                         "KeyPairGenerator"
                         "ML-DSA-87"
                         "sun.security.provider.ML_DSA_Impls$KPG5"
                         attrs)
          (.put attrs "KeySize" "2048")
          (.addWithAlias this
                         p
                         "AlgorithmParameterGenerator"
                         "DSA"
                         "sun.security.provider.DSAParameterGenerator"
                         attrs)
          (.remove attrs "KeySize")
          (.addWithAlias this
                         p
                         "AlgorithmParameters"
                         "DSA"
                         "sun.security.provider.DSAParameters"
                         attrs)
          (.addWithAlias this p "KeyFactory" "DSA" "sun.security.provider.DSAKeyFactory" attrs)
          (.addWithAlias this
                         p
                         "KeyFactory"
                         "HSS/LMS"
                         "sun.security.provider.HSS$KeyFactoryImpl"
                         attrs)
          (.add this p "KeyFactory" "ML-DSA" "sun.security.provider.ML_DSA_Impls$KF" attrs)
          (.addWithAlias this
                         p
                         "KeyFactory"
                         "ML-DSA-44"
                         "sun.security.provider.ML_DSA_Impls$KF2"
                         attrs)
          (.addWithAlias this
                         p
                         "KeyFactory"
                         "ML-DSA-65"
                         "sun.security.provider.ML_DSA_Impls$KF3"
                         attrs)
          (.addWithAlias this
                         p
                         "KeyFactory"
                         "ML-DSA-87"
                         "sun.security.provider.ML_DSA_Impls$KF5"
                         attrs)
          (.addWithAlias this p "MessageDigest" "MD2" "sun.security.provider.MD2" attrs)
          (.addWithAlias this p "MessageDigest" "MD5" "sun.security.provider.MD5" attrs)
          (.addWithAlias this p "MessageDigest" "SHA-1" "sun.security.provider.SHA" attrs)
          (.addWithAlias this p "MessageDigest" "SHA-224" "sun.security.provider.SHA2$SHA224" attrs)
          (.addWithAlias this p "MessageDigest" "SHA-256" "sun.security.provider.SHA2$SHA256" attrs)
          (.addWithAlias this p "MessageDigest" "SHA-384" "sun.security.provider.SHA5$SHA384" attrs)
          (.addWithAlias this p "MessageDigest" "SHA-512" "sun.security.provider.SHA5$SHA512" attrs)
          (.addWithAlias this
                         p
                         "MessageDigest"
                         "SHA-512/224"
                         "sun.security.provider.SHA5$SHA512_224"
                         attrs)
          (.addWithAlias this
                         p
                         "MessageDigest"
                         "SHA-512/256"
                         "sun.security.provider.SHA5$SHA512_256"
                         attrs)
          (.addWithAlias this
                         p
                         "MessageDigest"
                         "SHA3-224"
                         "sun.security.provider.SHA3$SHA224"
                         attrs)
          (.addWithAlias this
                         p
                         "MessageDigest"
                         "SHA3-256"
                         "sun.security.provider.SHA3$SHA256"
                         attrs)
          (.addWithAlias this
                         p
                         "MessageDigest"
                         "SHA3-384"
                         "sun.security.provider.SHA3$SHA384"
                         attrs)
          (.addWithAlias this
                         p
                         "MessageDigest"
                         "SHA3-512"
                         "sun.security.provider.SHA3$SHA512"
                         attrs)
          (.addWithAlias this
                         p
                         "MessageDigest"
                         "SHAKE128-256"
                         "sun.security.provider.SHA3$SHAKE128Hash"
                         attrs)
          (.addWithAlias this
                         p
                         "MessageDigest"
                         "SHAKE256-512"
                         "sun.security.provider.SHA3$SHAKE256Hash"
                         attrs))))))

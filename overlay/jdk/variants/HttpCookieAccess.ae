;; Go-build variant of java.net.HttpCookie (J2G-SPEC §4.6; doc/classes/JAVA-DEFERRED-TRIAGE.md, F12, "As
;; built: F12 (write-ahead)"): read by j2g only. The second static initializer hands HttpCookie's access
;; object (JavaNetHttpCookieAccess: a Set-Cookie header parsed with its cookies' headers kept, a cookie's
;; header) to SharedSecrets, which in jrt holds no such access: it goes to jdk.internal.jrt.NetAccess, as
;; InetAddress's does since F3, and the http: handler's connection reads it there
;; (HttpURLConnectionCookies.ae). The access is jdk26u's anonymous class (baf63fb; Copyright (c) Oracle
;; and/or its affiliates, GPL 2 with the Classpath Exception: LICENSE.md); the rest Copyright (c) the
;; Arbace authors; Eclipse Public License 1.0.
(in-ns 'java.net)

(j2g/variant HttpCookie
  ^{:j2g/nth 1}
  (static-initializer
    (jdk.internal.jrt.NetAccess/setJavaNetHttpCookieAccess
      (anon jdk.internal.access.JavaNetHttpCookieAccess []
        (method ^:public parse ^{:tag (List HttpCookie)} [this ^String header]
          (HttpCookie/parse header true -1))

        (method ^:public header ^String [this ^HttpCookie cookie]
          (.-header cookie))))))

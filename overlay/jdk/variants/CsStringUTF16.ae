;; Go-build variant of sun.nio.cs.StringUTF16 (J2G-SPEC §4.6; doc/classes/JAVA-DEFERRED-TRIAGE.md,
;; F8, "As built: F8 (write-ahead)"): read by j2g only. getChar reads a String's UTF-16 byte array
;; (the ArrayEncoders' encodeFromUTF16) as jrt lays it out, little-endian (JavaLangAccess's
;; uncheckedGetUTF16Char, go/arbace/jrt/access.ae), in place of jdk26u's Unsafe.getChar at the
;; array's base offset, which reads it in the platform's order: little-endian on amd64 and arm64
;; alike, the same char. The replacing member is jdk26u's (baf63fb; Copyright (c) Oracle and/or its
;; affiliates, GPL 2 with the Classpath Exception: LICENSE.md) as repr/java converts it, with the
;; change named; the rest Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'sun.nio.cs)

(j2g/variant StringUTF16
  (method ^:public ^:static getChar ^char [^byte/1 val ^int index]
    (let [^int j (unchecked-multiply-int 2 index)]
      (unchecked-char (bit-or-int (bit-and-int (aget val j) 0xff)
                        (bit-shift-left-int (bit-and-int (aget val (unchecked-inc-int j)) 0xff) 8))))))

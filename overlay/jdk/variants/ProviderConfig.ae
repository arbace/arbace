;; Go-build variant of sun.security.jca.ProviderConfig (J2G-SPEC §4.6; doc/go/JRT-NOTES.md,
;; "Security"; doc/classes/JAVA-DEFERRED-TRIAGE.md, F1): read by j2g only. The Go build has four of the
;; JDK's providers, SUN, SunRsaSign, SunEC and SunJCE (java.base's, in plain Java; SunRsaSign and SunEC
;; since F1), made directly as jdk26u's switch makes them; the others of java.security's list
;; (SunJSSE, SunJGSS, SunSASL, XMLDSig, SunPCSC, JdkLDAP, JdkSASL, SunPKCS11) are not in it, and a
;; provider named by its class is not loaded (no ServiceLoader, no class loading by name): those
;; configs fail to load, as a provider the JDK cannot find, so Security.getProviders() lists SUN,
;; SunRsaSign, SunEC and SunJCE, in java.security's order. The replacing method keeps jdk26u's code
;; where it keeps it (baf63fb; Copyright (c) Oracle and/or its affiliates, GPL 2 with the Classpath
;; Exception: LICENSE.md); the rest Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'sun.security.jca)

(j2g/variant ProviderConfig
  (method getProvider ^Provider [this]
    (let [^:mutable ^Provider p provider]
      (when (some? p)
        (return p))
      (locking this
        (set! p provider)
        (when (some? p)
          (return p))
        (when-not (.shouldLoad this)
          (return nil))
        (set! p (switch provName
                  ("SUN" "sun.security.provider.Sun") (sun.security.provider.Sun.)
                  ("SunRsaSign" "sun.security.rsa.SunRsaSign") (sun.security.rsa.SunRsaSign.)
                  ("SunJCE" "com.sun.crypto.provider.SunJCE") (com.sun.crypto.provider.SunJCE.)
                  "SunEC" (sun.security.ec.SunEC.)
                  (do (.disableLoad this) nil)))
        (set! provider p))
      p)))

;; Go-build variant of sun.security.jca.ProviderConfig (J2G-SPEC §4.6; doc/go/JRT-NOTES.md,
;; "Security"; doc/classes/JAVA-DEFERRED-TRIAGE.md, F1, F3 and F23; JCS232 (a): F3's ProviderConfigJsse.ae
;; and F23's ProviderConfigSasl.ae folded into this file, 2026-11-08): read by j2g only. The Go build has
;; seven of the JDK's providers, SUN, SunRsaSign, SunEC and SunJCE (java.base's, in plain Java; SunRsaSign
;; and SunEC since F1), SunJSSE (F3), SunSASL (F23, java.security's provider 7) and since java-design-1123 SunJGSS
;; (provider 6: Kerberos and GSS-API in the world, java-design-1122's round 2), made directly as jdk26u's
;; switch makes them, each by its name and by its class name, which the JDK's default branch loads by name
;; or through the ServiceLoader; the others of java.security's list (XMLDSig, SunPCSC, JdkLDAP,
;; JdkSASL, SunPKCS11) are not in it, and a provider named by its class is not loaded (no ServiceLoader, no
;; class loading by name): those configs fail to load, as a provider the JDK cannot find, so
;; Security.getProviders() lists the eight in java.security's order. The replacing method keeps jdk26u's
;; code where it keeps it (baf63fb; Copyright (c) Oracle and/or its affiliates, GPL 2 with the Classpath
;; Exception: LICENSE.md); the rest Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'sun.security.jca)

(j2g/variant ProviderConfig
  (method getProvider ^Provider [this]
    (let [^:mutable ^Provider p provider]
      (when (some? p)
        (return p))
      (locking this
        (set! p provider)
        (when (some? p)
          (return p))
        (when-not (.shouldLoad this)
          (return nil))
        (set! p (switch provName
                  ("SUN" "sun.security.provider.Sun") (sun.security.provider.Sun.)
                  ("SunRsaSign" "sun.security.rsa.SunRsaSign") (sun.security.rsa.SunRsaSign.)
                  ("SunJCE" "com.sun.crypto.provider.SunJCE") (com.sun.crypto.provider.SunJCE.)
                  "SunEC" (sun.security.ec.SunEC.)
                  ("SunJSSE" "sun.security.ssl.SunJSSE") (sun.security.ssl.SunJSSE.)
                  ("SunJGSS" "sun.security.jgss.SunProvider") (sun.security.jgss.SunProvider.)
                  ("SunSASL" "com.sun.security.sasl.Provider") (com.sun.security.sasl.Provider.)
                  (do (.disableLoad this) nil)))
        (set! provider p))
      p)))

;; Go-build variant of sun.security.pkcs.PKCS8Key (J2G-SPEC §4.6;
;; doc/classes/JAVA-DEFERRED-TRIAGE.md, F1): read by j2g only. jdk26u's parseKey (its key spec's
;; clearing) reads SharedSecrets' JavaSecuritySpecAccess, which jrt's SharedSecrets does not hold;
;; the variant reads it from jrt's jdk.internal.jrt.CryptoAccess, which EncodedKeySpec's static
;; initializer sets (its variant). The replacing members are jdk26u's (baf63fb; Copyright (c) Oracle
;; and/or its affiliates, GPL 2 with the Classpath Exception: LICENSE.md) as repr/java converts
;; them, with the change named; the rest Copyright (c) the Arbace authors; Eclipse Public License
;; 1.0.
(in-ns 'sun.security.pkcs)

(j2g/variant PKCS8Key
  (method ^:public ^:static parseKey :throws [InvalidKeyException] ^PrivateKey [^byte/1 encoded
                                                                                ^Provider provider]
    (try
      (let [rawKey (PKCS8Key. encoded)
            pkcs8KeySpec (PKCS8EncodedKeySpec. (.generateEncoding rawKey))
            ^:mutable ^PrivateKey result nil]
        (try
          (if (nil? provider)
              (set! result
                    (.generatePrivate (KeyFactory/getInstance (.getName (.-algid rawKey)))
                                      pkcs8KeySpec))
              (set! result
                    (.generatePrivate (KeyFactory/getInstance (.getName (.-algid rawKey)) provider)
                                      pkcs8KeySpec)))
          (catch [NoSuchAlgorithmException InvalidKeySpecException] e (set! result rawKey))
          (finally
            (when-not (identical? result rawKey) (.clear rawKey))
            (.clearEncodedKeySpec (jdk.internal.jrt.CryptoAccess/javaSecuritySpecAccess) pkcs8KeySpec)))
        result)
      (catch IOException e (throw (InvalidKeyException. e))))))

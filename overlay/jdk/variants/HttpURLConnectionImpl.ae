;; Go-build variant of sun.net.www.protocol.http.HttpURLConnection (J2G-SPEC §4.6;
;; doc/classes/JAVA-DEFERRED-TRIAGE.md, F12, "As built: F12 (write-ahead)"): read by j2g only.
;; filterHeaderField, which drops the HttpOnly cookies of a Set-Cookie header when a cookie handler is
;; set, takes HttpCookie's access object from jdk.internal.jrt.NetAccess (HttpCookieAccess.ae), not
;; SharedSecrets. jrtTunnelSocket, added, is what java.net.HttpConnectSocketImpl reaches by reflection
;; in jdk26u (doTunneling, then the field http's serverSocket: protected members jrt's reflection
;; tables do not hold, HttpConnectSocketImpl.ae), through HttpClient's added jrtServerSocket (HttpClient.ae).
;; Otherwise jdk26u's code (baf63fb; Copyright (c) Oracle and/or its affiliates, GPL 2 with
;; the Classpath Exception: LICENSE.md); the rest Copyright (c) the Arbace authors; Eclipse Public License
;; 1.0.
(in-ns 'sun.net.www.protocol.http)

(j2g/variant HttpURLConnection
  (method ^:private filterHeaderField ^String [this ^String name ^String value]
    (when (some? value)
      (if (or (.equalsIgnoreCase SET_COOKIE name) (.equalsIgnoreCase SET_COOKIE2 name))
          (if (or (nil? cookieHandler) (.isEmpty value))
              value
              (let [access (jdk.internal.jrt.NetAccess/getJavaNetHttpCookieAccess)
                    retValue (StringJoiner. ",")
                    ^{:tag (List HttpCookie)} cookies (.parse access value)]
                (for-each [^HttpCookie cookie cookies]
                  (when-not (.isHttpOnly cookie) (.add retValue (.header access cookie))))
                (.toString retValue)))
          value)))

  (j2g/add
    (method ^:public jrtTunnelSocket :throws [java.io.IOException] ^java.net.Socket [this]
      (.doTunneling this)
      (.jrtServerSocket http))))

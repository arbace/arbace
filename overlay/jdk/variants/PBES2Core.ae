;; Go-build variant of com.sun.crypto.provider.PBES2Core (J2G-SPEC §4.6;
;; doc/classes/JAVA-DEFERRED-TRIAGE.md, F1): read by j2g only. jdk26u's engineInit (its cipher key's
;; clearing) reads SharedSecrets' JavaxCryptoSpecAccess, which jrt's SharedSecrets does not hold;
;; the variant reads it from jrt's jdk.internal.jrt.CryptoAccess, which SecretKeySpec's static
;; initializer sets (its variant). The replacing members are jdk26u's (baf63fb; Copyright (c) Oracle
;; and/or its affiliates, GPL 2 with the Classpath Exception: LICENSE.md) as repr/java converts
;; them, with the change named; the rest Copyright (c) the Arbace authors; Eclipse Public License
;; 1.0.
(in-ns 'com.sun.crypto.provider)

(j2g/variant PBES2Core
  (method ^:protected engineInit :throws [InvalidKeyException InvalidAlgorithmParameterException] ^void [this
                                                                                                         ^int opmode
                                                                                                         ^Key key
                                                                                                         ^AlgorithmParameterSpec params
                                                                                                         ^SecureRandom random]
    (let [pbeSpec (.getPBEKeySpec pbes2Params blkSize keyLength opmode key params random)
          ^:mutable ^PBKDF2KeyImpl s nil
          ^:mutable ^byte/1 derivedKey nil]
      (try
        (set! s (cast PBKDF2KeyImpl (.engineGenerateSecret kdf pbeSpec)))
        (set! derivedKey (.getEncoded s))
        (catch InvalidKeySpecException ikse
          (throw (InvalidKeyException. "Cannot construct PBE key" ikse)))
        (finally (when (some? s) (.clear s)) (.clearPassword pbeSpec)))
      (let [^:mutable ^SecretKeySpec cipherKey nil]
        (try
          (set! cipherKey (SecretKeySpec. derivedKey cipherAlgo))
          (.init cipher opmode cipherKey (.getIvSpec pbes2Params) random)
          (finally
            (when (some? cipherKey)
              (.clearSecretKeySpec (jdk.internal.jrt.CryptoAccess/javaxCryptoSpecAccess) cipherKey))
            (Arrays/fill derivedKey (unchecked-byte 0))))))))

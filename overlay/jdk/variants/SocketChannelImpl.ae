;; Go-build variant of sun.nio.ch.SocketChannelImpl (J2G-SPEC §4.6; doc/go/JRT-NOTES.md, "Channels"; F10 of
;; doc/classes/JAVA-DEFERRED-TRIAGE.md, "As built: F10a"): read by j2g only. The socket adaptor's streams read and
;; write a byte[] through a temporary direct buffer at its native address (jdk26u's tryRead, tryWrite); jrt has
;; no native memory, and its dispatcher (overlay/jdk sun.nio.ch.NativeDispatcher) reads into and writes from the
;; array itself. Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'sun.nio.ch)

(j2g/variant SocketChannelImpl
  (method ^:private tryRead :throws [java.io.IOException] ^int [this ^byte/1 b ^int off ^int len]
    (.read nd fd b off len))

  (method ^:private tryWrite :throws [java.io.IOException] ^int [this ^byte/1 b ^int off ^int len]
    (.write nd fd b off len)))

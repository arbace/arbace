;; Go-build variant of java.util.logging.Level (J2G-SPEC §4.6; doc/classes/JAVA-DEFERRED-TRIAGE.md,
;; "As built: F5 (write-ahead)"): read by j2g only.
;; - computeLocalizedLevelName looks the level's bundle up by ResourceBundle.getBundle(name,
;;   locale): jrt's ResourceBundle has one registry and no modules (Logger.ae's note); RbAccess
;;   (SharedSecrets' JavaUtilResourceBundleAccess) is cut. Without the generated bundle
;;   sun.util.logging.resources.logging (JCS137) the lookup fails and getLocalizedLevelName answers
;;   the level's name, as the JDK's does for the root locale.
;; - KnownLevel keeps a custom level's instances reachable by its class's loader in a map of its
;;   own: jdk.internal.loader.ClassLoaderValue is not in the Go build (and a loader is never
;;   collected there).
;; The replacing members keep jdk26u's code where they keep it (baf63fb,
;; src/java.logging/share/classes/java/util/logging/Level.java; Copyright (c) Oracle and/or its
;; affiliates, GPL 2 with the Classpath Exception: LICENSE.md); the rest Copyright (c) the Arbace
;; authors; Eclipse Public License 1.0.
(in-ns 'java.util.logging)

(j2g/variant Level$RbAccess
  (j2g/cut (field ^:static ^:final ^JavaUtilResourceBundleAccess RB_ACCESS)))

(j2g/variant Level
  (method ^:private computeLocalizedLevelName ^String [this ^Locale newLocale]
    (let [rb (java.util.ResourceBundle/getBundle resourceBundleName newLocale)
          localizedName (.getString rb name)
          isDefaultBundle (.equals defaultBundle resourceBundleName)]
      (if (not isDefaultBundle)
          localizedName
          (let [rbLocale (.getLocale rb)
                ^Locale locale (if (or (.equals Locale/ROOT rbLocale)
                                       (.equals name (.toUpperCase localizedName Locale/ROOT)))
                                   Locale/ROOT
                                   rbLocale)]
            (if (.equals Locale/ROOT locale) name (.toUpperCase localizedName locale)))))))

(j2g/variant Level$KnownLevel
  (j2g/cut (field ^:private ^:static ^:final ^{:tag (ClassLoaderValue (List Level))} CUSTOM_LEVEL_CLV))

  (j2g/add
    (field ^:private ^:static ^:final ^{:tag (Map ClassLoader (List Level))} CUSTOM_LEVELS (HashMap.)))

  (method ^:private ^:static registerWithClassLoader ^void [^Level customLevel]
    (let [cl (.getClassLoader (.getClass customLevel))]
      (.add (cast List
                  (.computeIfAbsent CUSTOM_LEVELS
                                    cl
                                    (lambda Function ^List [^ClassLoader c] (ArrayList.))))
            customLevel))))

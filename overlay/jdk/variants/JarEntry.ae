;; Go-build variant of java.util.jar.JarEntry (J2G-SPEC §4.6; doc/classes/JAVA-CONFORMANCE-SURVEY.md,
;; "As built: JC6b"): read by j2g only. The copy constructor copies the attributes alone: the
;; certificates and code signers are java.security's (outside the Go build's world, so their
;; fields are not in Go), and the Go build reads jars as unsigned (jrt's JarVerifier), so an
;; entry has none. Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'java.util.jar)

(j2g/variant JarEntry
  (constructor ^:public [this ^JarEntry je]
    (this. ^ZipEntry je)
    (set! (.-attr this) (.-attr je))))

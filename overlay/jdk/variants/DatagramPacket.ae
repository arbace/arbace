;; Go-build variant of java.net.DatagramPacket (J2G-SPEC §4.6; doc/go/JRT-NOTES.md, "Datagrams"; n-java-net of
;; doc/classes/JAVA-DEFERRED-TRIAGE.md, "As built: n-java-net"): read by j2g only. The variant only adds
;; jrtSetLength and jrtBufLength, the package-private fields length and bufLength for sun.nio.ch.DatagramChannelImpl's
;; holder DatagramPackets, which jdk26u reaches through a private lookup's VarHandles (java.lang.invoke's lookups are
;; not in the Go build: overlay/jdk/variants/DatagramChannelImpl.ae). Copyright (c) the Arbace authors; Eclipse Public
;; License 1.0.
(in-ns 'java.net)

(j2g/variant DatagramPacket
  (j2g/add
    (method ^:public ^:static jrtSetLength ^void [^DatagramPacket p ^int value]
      (set! (.-length p) value)))

  (j2g/add
    (method ^:public ^:static jrtBufLength ^int [^DatagramPacket p]
      (.-bufLength p))))

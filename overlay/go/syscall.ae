;; The file system of TamaGo's syscall package as the box's tool guests patch it
;; (doc/go/BOX-NOTES.md, S7), as Go forms: fs_tamago.go converted from TamaGo's go1.27.1
;; (bin/repr-go read --goos tamago syscall, from a GOROOT whose fs_tamago.go was patched) with
;; the patch's lines, marked "Arbace": a seek past the end changes no size (it shrank the file:
;; Go's linker read archives short), a write past the end sets the size to the offset (it added
;; the offset), O_TRUNC empties the size too, and MkLazy, a regular file whose contents a
;; function reads at the first use (the tool guests' input trees, read from the store on
;; demand). Not a package of a program: bin/box-tools prints this file into an overlay that
;; replaces $GOROOT/src/syscall/fs_tamago.go when it builds the tool guests.
(ns go.syscall
  (:require [arbace.go :as go]))

(go/package syscall
  :path "syscall"
  :files ["fs_tamago.go"])

(load "syscall/fs_tamago")

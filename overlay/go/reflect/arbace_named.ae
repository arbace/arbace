    ^{:line 19 :tag string} Name
    ^{:line 20 :tag string} PkgPath ; an unexported method's package path; "" for an exported method
    ^{:line 21 :tag Type} Type ; the method's type without its receiver (FuncOf's)
    ^{:line 22 :tag unsafe/Pointer} Ifn ; the code an itab and Value.Method call (the receiver one word)
    ^{:line 23 :tag unsafe/Pointer} Tfn)) ; the code of Type.Method's Func (the receiver by value); nil: unreachable


^{:go/end 47} (go/func arbaceHeader ^Type [^Kind k]
  (switch k
    (case [Struct]
      (return ((inst TypeFor structType))))
    (case [Func]
      (return ((inst TypeFor funcType))))
    (case [Pointer]
      (return ((inst TypeFor ptrType))))
    (case [Slice]
      (return ((inst TypeFor sliceType))))
    (case [Array]
      (return ((inst TypeFor arrayType))))
    (case [Chan]
      (return ((inst TypeFor chanType))))
    (case [Map]
      (return ((inst TypeFor abi/MapType))))
    (case [Interface]
      (return ((inst TypeFor interfaceType))))
    (default
      (return ((inst TypeFor abi/Type))))))







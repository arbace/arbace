#!/bin/bash
# jrt's translated input (B1a step 3, doc/go/JRT-SOURCES.md): the Java source files of the
# translation closure that bin/java-surface measured (doc/go/java-surface.edn, :closure :repl
# :sources; 184 files of java.base), converted by repr/java into Java forms (bin/repr-java, on
# javac's tool executable since JN5), compared with the committed forms, and the edge the translated classes call
# into (what jrt hand-writes). Since standalone S1 (doc/STANDALONE-SURVEY.md, D2) its
# output is a source of the repository: jdk/ (jdk/README.md) holds the converted forms
# (jdk/forms), the resource data (jdk/data), the source list (jdk/sources.txt) and the
# provenance (jdk/provenance.edn), and the Go build (bin/j2g) reads them from there, without
# javac or jdk26u's checkout. This script regenerates them (update) and proves them (verify).
# It writes under $JRT_WORK (default .tmp/jrt) and, with update, jdk/.
#
# Usage: bin/jrt-convert [verify|update] [--twice]
#   (none)    every step into $JRT_WORK (the checks), jdk/ untouched
#   verify    the same, then $JRT_WORK's conv (without repr/java's report), data, sources.txt and
#             provenance.edn compared with jdk/forms, jdk/data, jdk/sources.txt and
#             jdk/provenance.edn (diff -r, $JRT_WORK/verify.diff; the provenance's host, the tool
#             that wrote it, reported, not compared: JFS32): jdk/ is what the conversion gives,
#             byte for byte (bin/gate --full)
#   update    the same, then, when every step passed, jdk/forms, jdk/data, jdk/sources.txt and
#             jdk/provenance.edn replaced by them: after a change to what the conversion reads
#             (jrt's own Java, overlay/jdk/java.base; the closure, test/jrt/jrt_sources.ae and
#             doc/go/java-surface.edn; repr/java; jdk26u's checkout) commit jdk/ with it
#   --twice   afterwards run the generators and repr/java a second time into $JRT_WORK/again and
#             require the same files (determinism)
# Steps ($JRT_STEPS, default all, comma-separated: sources,generate,convert,javac,check,edge,report):
#   sources   the closure's files (jrt.jrt-sources/print-sources: the measured closure, the
#             files added to it, jrt.jrt-sources/added-sources) copied from $JDK, and jrt's
#             own Java (overlay/jdk/java.base, replacing or adding to jdk26u's files), into
#             $JRT_WORK/src/java.base (the tree repr/java and javac read); sources.txt lists them
#   generate  the files the JDK build generates (CharacterData*, CaseFolding,
#             IndicConjunctBreak; java.nio's heap buffers, ScopedMemoryAccess; the CLDR
#             locale data of java.base, GensrcCLDR in make/modules/java.base/Gensrc.gmk) made as
#             make/modules/java.base/gensrc/GensrcCharacterData.gmk, GensrcRegex.gmk,
#             GensrcBuffer.gmk and GensrcScopedMemoryAccess.gmk make them: the build tools of
#             make/jdk/src/classes/build/tools/ (generatecharacter, generateextraproperties, spp,
#             cldrconverter, ...) as Java forms on javac's tool executable (since JN7: jdk/javac's
#             module buildtools; until then compiled and run on a JDK, GEN_JDK) over
#             src/java.base/share/data/unicodedata, into src/java.base; compared byte for byte
#             with the JDK build's support/gensrc when $JDK/build has one (generated.edn;
#             CaseFolding's output depends on the running JDK's Unicode version: the build's,
#             its boot JDK's, is taken when they differ by its entries alone, :boot-jdk); and the resource data
#             the program embeds (uniName.dat as Gendata.gmk makes it, ICU's nfc.nrm and
#             nfkc.nrm; the time-zone database lib/tzdb.dat as GendataTZDB.gmk makes it; the
#             security properties conf/security/java.security as Gendata.gmk makes them)
#             into $JRT_WORK/data, compared with the build's jdk/modules (jdk/lib for lib/)
#   convert   bin/repr-java read-jdk --check: the tree into Java forms, $JRT_WORK/conv (java.base,
#             attributed with --patch-module against the platform of javac on Arbace, the JDK
#             build's modules of the same sources; on the JVM, REPR_JAVA_HOST=jvm, the running JDK)
#   javac     the tree compiled twice by javac (ref1, ref2; bin/repr-java javac: javac on Arbace,
#             or the JVM's) with java.base's build options: the classes the edge is read from,
#             and javac's determinism (the two the same)
#   check     forms-level (doc/STANDALONE-NOTES.md, "S4: the JVM removed", O2 (b); until S4 the
#             forms were compiled by the Java forms compiler and compared with javac's
#             classes): each converted file compared with the committed one, jdk/forms
#             (forms-check.edn: the same, different, added, removed); a report, not a
#             failure (update's change shows there; verify requires none)
#   edge      jrt.jrt-edge/write-edge on javac's classes (ref1): edge.edn (on the tools' host since
#             JN7: jrt.classfile, Arbace's class-file reader, the JDK's classes from the platform)
#   report    report.md and report.edn; manifest.sha256 (every file of src and conv)
# Environment:
#   JDK        jdk26u's checkout (default /root/jdk26u)
#   SURFACE    the java-surface data (default doc/go/java-surface.edn; `bin/java-surface F`
#              recomputes it)
#   REPR_JAVA_EXE  javac's tool executable, which runs repr/java, javac and the generators
#              (default target/arbace-go/<arch>/arbace-javac; GEN_JDK, the JDK that ran the
#              generators until JN7, is not read)
#   JRT_LOCALES  jdk.localedata's locales in the build (JRT-NOTES.md, "Text and locales"):
#              none (the default: java.base's root and English data alone), common (the 27
#              locales of jrt.jrt-sources/text-locales), all, or comma-separated language tags
#   JRT_WORK   work directory (default .tmp/jrt)
# repr/java and javac run on javac's tool executable (bin/repr-java, REPR_JAVA_EXE;
# doc/classes/JAVA-FRONTEND-SURVEY.md, "As built: JN5", "As built: JN6"); the closure's own
# namespace jrt.jrt-sources (the source list, the locales, the report) on the tools' host
# (bin/lib/tools.bash's arbace_tool, since JN6), and since JN7 the edge step's jrt.jrt-edge too
# (JFS40 (c)) and the generators on javac's tool executable: the script starts no JVM
# (doc/classes/JAVA-FRONTEND-SURVEY.md, "As built: JN7"). Exit status 0 when every file converts and javac compiles the tree
# (with --twice, the conversion is deterministic; with verify, jdk/ is the conversion's output).
set -uo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash" # TMPDIR: .tmp/tmp when unset
. "$root/bin/lib/renamed-env.bash" # stops on a stale G2A_*, J2A_*, A2G_* or C2A_*
cd "$root"
. bin/lib/tools.bash
. bin/lib/repr-java/host.bash
jdk=${JDK:-/root/jdk26u}
surface=${SURFACE:-$root/doc/go/java-surface.edn}
work=${JRT_WORK:-$root/.tmp/jrt}
case "$work" in /*) ;; *) work=$root/$work ;; esac
steps=${JRT_STEPS:-sources,generate,convert,javac,check,edge,report}
twice=0 mode=
case ${1:-} in verify|update) mode=$1; shift ;; esac
[ "${1:-}" = "--twice" ] && twice=1
# the committed tree (jdk/README.md)
committed=$root/jdk
has() { case ",$steps," in *",$1,"*) return 0 ;; esac; return 1; }
# clj EXPR: jrt.jrt-sources on the tools' host (test/ on ARBACE_PATH); edge_clj EXPR: jrt.jrt-edge
# there too (since JN7: jrt.classfile, Arbace's class-file reader, JFS40 (c))
clj() { arbace_tool -p "$root/test" -e "(require 'jrt.jrt-sources) $1"; }
edge_clj() { arbace_tool -p "$root/test" -e "(require 'jrt.jrt-edge) $1"; }
status=0
mkdir -p "$work/log"
t00=$(date +%s)

conf=$(ls -d "$jdk"/build/*/spec.gmk 2>/dev/null | head -1)
# the generators run on javac's tool executable (JN7), bin/repr-java's
. bin/lib/host.bash
gen_exe=${REPR_JAVA_EXE:-$root/target/arbace-go/$(arbace_host_arch)/arbace-javac}
gensrc_ref=${conf:+$(dirname "$conf")/support/gensrc/java.base}

# the closure's sources, then the generated ones, into tree $1
make_sources() {
  local tree=$1 m kind rel
  rm -rf "$tree"
  mkdir -p "$tree/java.base"
  clj "(jrt.jrt-sources/print-sources \"$surface\")" > "$work/sources.txt" || return 1
  while read -r m kind rel; do
    [ "$m" = java.base ] || { echo "not java.base: $m $rel" >&2; return 1; }
    if [ "$kind" = share ]; then
      mkdir -p "$tree/java.base/$(dirname "$rel")"
      cp "$jdk/src/java.base/share/classes/$rel" "$tree/java.base/$rel"
    elif [ "${kind%%:*}" = share ]; then
      # share:MODULE: another module's file, compiled as part of java.base
      mkdir -p "$tree/java.base/$(dirname "$rel")"
      cp "$jdk/src/${kind#share:}/share/classes/$rel" "$tree/java.base/$rel"
    elif [ "$kind" = unix ]; then
      # a file of src/java.base/unix/classes (the Unix file system under java.io.File)
      mkdir -p "$tree/java.base/$(dirname "$rel")"
      cp "$jdk/src/java.base/unix/classes/$rel" "$tree/java.base/$rel"
    elif [ "$kind" = overlay ]; then
      mkdir -p "$tree/java.base/$(dirname "$rel")"
      cp "$root/overlay/jdk/java.base/$rel" "$tree/java.base/$rel"
    fi
  done < "$work/sources.txt"
}

# The JDK build's tools as Java forms on Arbace (JN7): javac's tool executable holds them
# (jdk/javac/forms, module buildtools: bin/javac-vendor reads make/jdk/src/classes/build/tools), and
# this script calls a tool's main by its class name. The build runs them on its boot JDK with
# JAVA_SMALL's -Duser.language=en -Duser.country=US: the tool's default locale is en_US (jrt's
# system properties); their class path's resources (build.tools.cldrconverter's
# OtherCommonLocales.properties) and java.xml's (the JDK's catalog, the parser's messages) are
# found on ARBACE_PATH, make/jdk/src/classes and src/java.xml/share/classes
gen_tools="build.tools.generatecharacter.GenerateCharacter build.tools.generatecharacter.GenerateCaseFolding
  build.tools.generatecharacter.CharacterName build.tools.generateextraproperties.GenerateExtraProperties
  build.tools.spp.Spp build.tools.cldrconverter.CLDRConverter build.tools.generatelsrequivmaps.EquivMapsGenerator
  build.tools.tzdb.TzdbZoneRulesCompiler build.tools.generatecurrencydata.GenerateCurrencyData
  build.tools.generatebreakiteratordata.GenerateBreakIteratorData build.tools.makejavasecurity.MakeJavaSecurity"
gen_script() {
  local c
  echo ';; bin/jrt-convert'"'"'s generate step: a JDK build tool'"'"'s main (JN7)'
  echo '(let [[c & args] *command-line-args* a (into-array String args)]'
  echo '  (case c'
  for c in $gen_tools; do echo "    \"$c\" ($c/main a)"; done
  echo '    (do (println "jrt-convert: no tool" c) (System/exit 2))))'
}

generate() {
  local tree=$1 out tools=$2 u c t f
  u=$jdk/src/java.base/share/data/unicodedata
  c=$jdk/src/java.base/share/classes
  t=$jdk/make/jdk/src/classes
  out=$tree/java.base
  rm -rf "$tools"
  mkdir -p "$tools"
  gen_script > "$tools/gen.ae"
  local java=(env "ARBACE_PATH=$t:$jdk/src/java.xml/share/classes" "$gen_exe" "$tools/gen.ae")
  mkdir -p "$out/java/lang" "$out/jdk/internal/lang" "$out/jdk/internal/util/regex"
  # GensrcCharacterData.gmk: SetupCharacterData NAME, OPTIONS, -usecharforbyte ARGS (release build:
  # no -d)
  chardata() {
    "${java[@]}" build.tools.generatecharacter.GenerateCharacter $2 \
      -template "$c/java/lang/$1.java.template" -spec "$u/UnicodeData.txt" \
      -specialcasing "$u/SpecialCasing.txt" -proplist "$u/PropList.txt" \
      -derivedprops "$u/DerivedCoreProperties.txt" -emojidata "$u/emoji/emoji-data.txt" \
      -o "$out/java/lang/$1.java" -usecharforbyte $3
  }
  chardata CharacterDataLatin1 "" "-latin1 8" &&
  chardata CharacterData00 "-string -plane 0" "11 4 1" &&
  chardata CharacterData01 "-string -plane 1" "11 4 1" &&
  chardata CharacterData02 "-string -plane 2" "11 4 1" &&
  chardata CharacterData03 "-string -plane 3" "11 4 1" &&
  chardata CharacterData0E "-string -plane 14" "11 4 1" &&
  "${java[@]}" build.tools.generatecharacter.GenerateCaseFolding \
    "$c/jdk/internal/lang/CaseFolding.java.template" "$u/CaseFolding.txt" \
    "$tools/CaseFolding.java" &&
  "${java[@]}" build.tools.generateextraproperties.GenerateExtraProperties \
    "$c/jdk/internal/util/regex/IndicConjunctBreak.java.template" "$u/DerivedCoreProperties.txt" \
    "$out/jdk/internal/util/regex/IndicConjunctBreak.java" InCB=Linker InCB=Extend InCB=Consonant ||
    return 1
  # CaseFolding's regex entries depend on the running JDK's Unicode version (doc/go/JRT-SOURCES.md,
  # "The generator JDK matters"): the JDK build's is its boot JDK's (JDK 25, Unicode 16), the tool's
  # on Arbace a JDK 26's (Unicode 17, jrt's Character: the stock JDK 26's output byte for byte), 28
  # entries fewer. The program's stays the build's, the JDK 26 it is checked against: the build
  # tree's file when it differs from the tool's by entries the boot JDK keeps alone (lines of the
  # build's the tool's lacks, none the other way: generated.edn's :boot-jdk), else the tool's
  # (doc/classes/JAVA-FRONTEND-SURVEY.md, "As built: JN7", JFS43)
  local cf=jdk/internal/lang/CaseFolding.java
  if [ -n "$gensrc_ref" ] && [ -f "$gensrc_ref/$cf" ] && ! cmp -s "$tools/CaseFolding.java" "$gensrc_ref/$cf" &&
     ! diff "$tools/CaseFolding.java" "$gensrc_ref/$cf" | grep -q '^<'; then
    cp "$gensrc_ref/$cf" "$out/$cf"
  else
    cp "$tools/CaseFolding.java" "$out/$cf"
  fi || return 1
  # GensrcBuffer.gmk (SetupGenBuffer) and GensrcScopedMemoryAccess.gmk: build.tools.spp.Spp on
  # java.nio's and jdk.internal.misc's templates, with the keys and replacements of
  # make/common/modules/GensrcStreamPreProcessing.gmk's Conv
  local n=$c/java/nio m=$c/jdk/internal/misc
  mkdir -p "$out/java/nio" "$out/jdk/internal/misc"
  spp() { "${java[@]}" build.tools.spp.Spp "$@"; }
  title() { echo "${1^}"; }
  lbpv() { case $1 in byte) echo 0;; char|short) echo 1;; int|float) echo 2;; long|double) echo 3;; esac; }
  fulltype() { case $1 in char) echo character;; int) echo integer;; *) echo "$1";; esac; }
  memtype() { case $1 in float) echo int;; double) echo long;; *) echo "$1";; esac; }
  art() { [ "$1" = int ] && echo an || echo a; }
  frombits() { # TYPE BO
    case $1 in float|double) [ "$2" = U ] || echo "$(title "$1").$(memtype "$1")BitsTo$(title "$1")";; esac; }
  tobits() {
    case $1 in float|double) [ "$2" = U ] || echo "$(title "$1").$1ToRaw$(title "$(memtype "$1")")Bits";; esac; }
  nbytes() { case $(lbpv "$1") in 0) echo one;; 1) echo two;; 2) echo four;; 3) echo eight;; esac; }
  nbytes1() { case $(lbpv "$1") in 0) echo zero;; 1) echo one;; 2) echo three;; 3) echo seven;; esac; }
  # SetupGenBuffer NAME TEMPLATE TYPE BYTE_ORDER (read-write; BYTES_PER_VALUE as the make file
  # passes it, with an empty log2: "(1 << )")
  genbuffer() {
    local name=$1 tpl=$2 ty=$3 bo=$4 o=$out/java/nio/$1.java swaptype
    local keys=(-K"$ty" -Krw -Kbo"$bo")
    case $ty in float|double) keys+=(-KfloatingPointType);; *) keys+=(-KintegralType);; esac
    [ "$ty" = char ] && keys+=(-KstreamableType)
    if [ "$bo" = U ]; then swaptype=$(title "$ty"); else swaptype=$(title "$(memtype "$ty")"); fi
    [ "$name" = ByteBuffer ] && o=$o.bin-snippet.tmp
    spp "${keys[@]}" -Dtype="$ty" -DBO="$bo" -DRW= -DLG_BYTES_PER_VALUE="$(lbpv "$ty")" \
      -DBYTES_PER_VALUE="(1 << )" -Da="$(art "$ty")" -DA="$(title "$(art "$ty")")" \
      -Dfulltype="$(fulltype "$ty")" -DFulltype="$(title "$(fulltype "$ty")")" \
      -Dmemtype="$(memtype "$ty")" -DMemtype="$(title "$(memtype "$ty")")" \
      -Dstreamtype="$([ "$ty" = char ] && echo int)" -DStreamtype="$([ "$ty" = char ] && echo Int)" \
      -DType="$(title "$ty")" -Dx="${ty:0:1}" -DfromBits="$(frombits "$ty" "$bo")" \
      -DtoBits="$(tobits "$ty" "$bo")" -Dswap="$([ "$bo" = S ] && echo Bits.swap)" \
      -DSwaptype="$swaptype" -i"$n/$tpl.java.template" -o"$o" || return 1
    if [ "$name" = ByteBuffer ]; then
      # GENERATE_BIN: a snippet per non-byte type replaces the lines from #BIN on
      local snippets=() s
      for s in char short int long float double; do
        spp -be -Krw -Dtype="$s" -DRW= -DLG_BYTES_PER_VALUE="$(lbpv "$s")" \
          -DBYTES_PER_VALUE="(1 << $(lbpv "$s"))" -Da="$(art "$s")" -Dfulltype="$(fulltype "$s")" \
          -Dmemtype="$(memtype "$s")" -DMemtype="$(title "$(memtype "$s")")" -Dnbytes="$(nbytes "$s")" \
          -DnbytesButOne="$(nbytes1 "$s")" -DType="$(title "$s")" -DfromBits="$(frombits "$s" "$bo")" \
          -DtoBits="$(tobits "$s" "$bo")" -i"$n/X-Buffer-bin.java.template" -o"$o.$s" || return 1
        snippets+=("$o.$s")
      done
      { sed -e '/#BIN/,$d' < "$o"; cat "${snippets[@]}"; echo "}"; } > "$out/java/nio/$name.java"
      rm -f "$o" "${snippets[@]}"
    fi
  }
  genbuffer ByteBuffer X-Buffer byte "" && genbuffer CharBuffer X-Buffer char "" &&
  genbuffer IntBuffer X-Buffer int "" &&
  genbuffer HeapByteBuffer Heap-X-Buffer byte "" && genbuffer HeapCharBuffer Heap-X-Buffer char "" &&
  genbuffer HeapIntBuffer Heap-X-Buffer int "" &&
  genbuffer ByteBufferAsCharBufferB ByteBufferAs-X-Buffer char B &&
  genbuffer ByteBufferAsCharBufferL ByteBufferAs-X-Buffer char L &&
  genbuffer ByteBufferAsIntBufferB ByteBufferAs-X-Buffer int B &&
  genbuffer ByteBufferAsIntBufferL ByteBufferAs-X-Buffer int L || return 1
  # GensrcScopedMemoryAccess.gmk: the template, then a snippet per type (SCOPED_TYPES' order)
  local smasnips=() ty k sma=$out/jdk/internal/misc/ScopedMemoryAccess.java
  for ty in boolean byte short char int long float double; do
    k=(-K"$ty" -KCAS)
    [ "$ty" = byte ] && k+=(-Kbyte)
    case $ty in float|double) k+=(-KfloatingPoint);; esac
    case $ty in char|short|int|long) k+=(-KUnaligned);; esac
    case $ty in boolean|byte|char|short) k+=(-KShorterThanInt);; esac
    [ "$ty" = boolean ] || k+=(-KAtomicAdd)
    case $ty in float|double) ;; *) k+=(-KBitwise);; esac
    spp -nel "${k[@]}" -Dtype="$ty" -DType="$(title "$ty")" \
      -i"$m/X-ScopedMemoryAccess-bin.java.template" -o"$sma.snippet.$ty" || return 1
    smasnips+=("$sma.snippet.$ty")
  done
  { cat "$m/X-ScopedMemoryAccess.java.template"; cat "${smasnips[@]}"; echo "}"; } > "$sma"
  rm -f "${smasnips[@]}"
  # the CLDR locale data of java.base (JRT-NOTES.md, "Time"): the root and English bundles,
  # ZoneName and CLDRBaseLocaleDataMetaInfo, as make/modules/java.base/Gensrc.gmk makes them
  # (TOOL_CLDRCONVERTER, build.tools.cldrconverter.CLDRConverter with its properties, on
  # make/data/cldr/common); into a directory of their own, from which the closure's files are
  # taken (the tool writes more: other bundles, Windows' tzmappings)
  local cl=$tools/cldr-out
  "${java[@]}" build.tools.cldrconverter.CLDRConverter -base "$jdk/make/data/cldr/common" \
    -baselocales "en-US" -o "$cl" -basemodule -year "$(sed -n 's/^COPYRIGHT_YEAR := *//p' "$conf" 2>/dev/null || echo 2026)" \
    -zntempfile "$c/java/time/format/ZoneName.java.template" \
    -tzdatadir "$jdk/src/java.base/share/data/tzdata" -utf8 || return 1
  while read -r _ kind rel; do
    if [ "$kind" = gensrc ] && [ -f "$cl/$rel" ]; then
      mkdir -p "$out/$(dirname "$rel")"
      cp "$cl/$rel" "$out/$rel"
    fi
  done < "$work/sources.txt"
  # sun.util.locale.LocaleEquivalentMaps (JRT-NOTES.md, "Text and locales"; Locale's filter
  # and lookup), as make/modules/java.base/Gensrc.gmk makes it (TOOL_GENERATELSREQUIVMAPS on
  # the language subtag registry)
  mkdir -p "$out/sun/util/locale"
  "${java[@]}" build.tools.generatelsrequivmaps.EquivMapsGenerator \
    "$jdk/src/java.base/share/data/lsrdata/language-subtag-registry.txt" \
    "$out/sun/util/locale/LocaleEquivalentMaps.java" \
    "$(sed -n 's/^COPYRIGHT_YEAR := *//p' "$conf" 2>/dev/null || echo 2026)" || return 1
  # jdk.localedata's CLDR data (JRT-NOTES.md, "Text and locales"), as
  # make/modules/jdk.localedata/Gensrc.gmk makes it (TOOL_CLDRCONVERTER without -basemodule):
  # every locale's bundles, of which the selection (sources.txt's KIND locales line,
  # JRT_LOCALES) is taken with its parent locales (KIND gensrc:jdk.localedata), compiled into
  # java.base's tree; with them the selected locales' JRE collation data (hand-written sources
  # of jdk.localedata, KIND share:jdk.localedata) and jrt's index of them all,
  # jdk.internal.jrt.LocaleDataIndex (generated here, KIND jrtgen)
  local ld=$tools/cldr-ld-out
  "${java[@]}" build.tools.cldrconverter.CLDRConverter -base "$jdk/make/data/cldr/common" \
    -baselocales "en-US" -year "$(sed -n 's/^COPYRIGHT_YEAR := *//p' "$conf" 2>/dev/null || echo 2026)" \
    -o "$ld" -tzdatadir "$jdk/src/java.base/share/data/tzdata" -utf8 || return 1
  clj "(jrt.jrt-sources/expand-locales \"$work/sources.txt\" \"$ld\" \"$cl/sun/util/cldr/CLDRBaseLocaleDataMetaInfo.java\" \"$jdk\" \"$out/jdk/internal/jrt/LocaleDataIndex.java\")" || return 1
  while read -r _ kind rel; do
    case $kind in
      gensrc:jdk.localedata) mkdir -p "$out/$(dirname "$rel")"; cp "$ld/$rel" "$out/$rel" ;;
      share:jdk.localedata) mkdir -p "$out/$(dirname "$rel")"; cp "$jdk/src/jdk.localedata/share/classes/$rel" "$out/$rel" ;;
    esac
  done < "$work/sources.txt"
  # the resource data the closure reads (JRT-NOTES.md, "The JDK's resource data"), into
  # $tree/../data, which bin/j2g --program embeds: uniName.dat as make/modules/java.base/
  # Gendata.gmk makes it (TOOL_CHARACTERNAME on UnicodeData.txt), ICU's normalization data as
  # the build copies it (a resource of src/java.base/share/classes)
  local data
  data=$(dirname "$tree")/data
  rm -rf "$data"
  mkdir -p "$data/java/lang" "$data/jdk/internal/icu/impl/data/icudata"
  "${java[@]}" build.tools.generatecharacter.CharacterName "$u/UnicodeData.txt" "$data/java/lang/uniName.dat" &&
  cp "$c/jdk/internal/icu/impl/data/icudata/nfc.nrm" "$c/jdk/internal/icu/impl/data/icudata/nfkc.nrm" \
    "$data/jdk/internal/icu/impl/data/icudata/" || return 1
  # the time-zone database (JRT-NOTES.md, "Time"), the image's lib/tzdb.dat, as
  # make/modules/java.base/gendata/GendataTZDB.gmk makes it: TOOL_TZDB
  # (build.tools.tzdb.TzdbZoneRulesCompiler) with java.time.zone's ZoneRules,
  # ZoneOffsetTransition, ZoneOffsetTransitionRule and Ser copied into its package as
  # make/CopyInterimTZDB.gmk copies them (the tool's, bin/javac-vendor's KIND interim), on
  # src/java.base/share/data/tzdata's files
  mkdir -p "$data/lib"
  "${java[@]}" build.tools.tzdb.TzdbZoneRulesCompiler -srcdir "$jdk/src/java.base/share/data/tzdata" \
    -dstfile "$data/lib/tzdb.dat" africa antarctica asia australasia europe northamerica \
    southamerica backward etcetera gmt jdk11_backward || return 1
  # java.text's resource data (JRT-NOTES.md, "Text and locales"): java.util's currency.data as
  # make/modules/java.base/Gendata.gmk makes it (TOOL_GENERATECURRENCYDATA on
  # CurrencyData.properties); the break iterators' rule data as
  # make/modules/java.base/gendata/GendataBreakIterator.gmk makes it (TOOL_GENERATEBREAKITERATORDATA
  # with sun.text.resources' BreakIteratorRules and BreakIteratorInfo compiled into a patch of
  # java.base, jdk.localedata's Thai ones into a patch of jdk.localedata); ICU's bidi properties
  # (ubidi.icu) as the build copies resources
  mkdir -p "$data/java/util" "$data/sun/text/resources"
  # (the tool's sun.text.resources.BreakIteratorRules, java.base's, as the build's patch of
  # java.base; the build's patch of jdk.localedata, the Thai rules, is not read without -language)
  "${java[@]}" build.tools.generatecurrencydata.GenerateCurrencyData -o "$data/java/util/currency.data.tmp" \
    -i "$jdk/src/java.base/share/data/currency/CurrencyData.properties" &&
  mv "$data/java/util/currency.data.tmp" "$data/java/util/currency.data" || return 1
  "${java[@]}" build.tools.generatebreakiteratordata.GenerateBreakIteratorData -o "$data/sun/text/resources" \
    -spec "$u/UnicodeData.txt" || return 1
  cp "$c/jdk/internal/icu/impl/data/icudata/ubidi.icu" "$data/jdk/internal/icu/impl/data/icudata/" || return 1
  # the security properties (JRT-NOTES.md, "Security"), the image's conf/security/java.security,
  # as make/modules/java.base/Gendata.gmk makes it: TOOL_MAKEJAVASECURITY
  # (build.tools.makejavasecurity.MakeJavaSecurity) on src/java.base/share/conf/security/
  # java.security for linux, x86 (OPENJDK_TARGET_CPU_ARCH of linux-x86_64; the file has no
  # parts for other architectures) and the unlimited crypto policy, without more restricted
  # packages
  mkdir -p "$data/conf/security"
  "${java[@]}" build.tools.makejavasecurity.MakeJavaSecurity \
    "$jdk/src/java.base/share/conf/security/java.security" "$data/conf/security/java.security" \
    linux x86 unlimited || return 1
  # every gensrc file of the closure is made
  while read -r _ kind rel; do
    case $kind in gensrc|gensrc:*|jrtgen) [ ! -f "$out/$rel" ] && { echo "not generated: $rel" >&2; return 1; } ;; esac
  done < "$work/sources.txt"
  return 0
}

# the names the converted files' headers give their sources (repr/java's --origins), from sources.txt:
# jdk26u's path of a file copied from it, overlay/jdk/... for jrt's own, and the gensrc path
# of a generated one (made here as the JDK build makes it); not the tree's or repr/java's scratch
# copies, so that the output does not depend on where it was made
origins() {
  local kind rel
  echo "{"
  while read -r _ kind rel; do
    case $kind in
      share) echo "\"$rel\" \"jdk26u src/java.base/share/classes/$rel\"" ;;
      share:*) echo "\"$rel\" \"jdk26u src/${kind#share:}/share/classes/$rel\"" ;;
      unix) echo "\"$rel\" \"jdk26u src/java.base/unix/classes/$rel\"" ;;
      overlay) echo "\"$rel\" \"overlay/jdk/java.base/$rel\"" ;;
      gensrc) echo "\"$rel\" \"jdk26u support/gensrc/java.base/$rel (generated by bin/jrt-convert)\"" ;;
      gensrc:*) echo "\"$rel\" \"jdk26u support/gensrc/${kind#gensrc:}/$rel (generated by bin/jrt-convert)\"" ;;
      jrtgen) echo "\"$rel\" \"$rel (generated by bin/jrt-convert)\"" ;;
    esac
  done < "$work/sources.txt"
  echo "}"
}

convert() {
  local tree=$1 conv=$2 log=$3
  rm -rf "$conv"
  origins > "$work/origins.edn" || return 1
  # from $work: repr/java's jdk command copies the files into .tmp/repr-java-patch below the current directory
  (cd "$work" && REPR_JAVA_THREADS=4 REPR_JAVA_PATCH_ALL=1 \
     "$root/bin/repr-java" read-jdk --check --origins "$work/origins.edn" "$conv" java.base "$tree/java.base") > "$log" 2>&1
  tail -1 "$log"
  grep -q " 0 failed, 0 javac errors, .* 0 unreadable" "$log"
}

if has sources; then
  echo "== sources ($surface)"
  make_sources "$work/src" || exit 1
  echo "$(grep -vc " locales " "$work/sources.txt") files (before the locales): $(grep -c ' share ' "$work/sources.txt") from $jdk/src/java.base/share/classes, $(grep -c " unix " "$work/sources.txt") from src/java.base/unix/classes, $(grep -c ' gensrc ' "$work/sources.txt") generated, $(grep -c ' overlay ' "$work/sources.txt") of jrt's own (overlay/jdk)"
fi

if has generate; then
  echo "== generate (the JDK build's tools as Java forms on javac's tool executable, $gen_exe)"
  [ -x "$gen_exe" ] || { echo "jrt-convert: no $gen_exe (bin/javac-vendor build, or REPR_JAVA_EXE)"; exit 1; }
  t0=$(date +%s)
  generate "$work/src" "$work/gen-tools" > "$work/log/generate.log" 2>&1 || { cat "$work/log/generate.log"; exit 1; }
  {
    if [ -n "$gensrc_ref" ]; then ref="\"$gensrc_ref\""; else ref=nil; fi
    echo "{:generators \"javac's tool executable\" :jdk-gensrc $ref"
    echo " :files {"
    while read -r _ kind rel; do
      case $kind in
        gensrc) ref=$gensrc_ref ;;
        # another module's generated file (jdk.localedata's CLDR bundles), against that
        # module's support/gensrc
        gensrc:*) ref=${gensrc_ref:+$(dirname "$gensrc_ref")/${kind#gensrc:}} ;;
        *) continue ;;
      esac
      if [ -z "$ref" ] || [ ! -f "$ref/$rel" ]; then v=:no-reference
      elif [ "$rel" = jdk/internal/lang/CaseFolding.java ] && ! cmp -s "$work/gen-tools/CaseFolding.java" "$ref/$rel" &&
           cmp -s "$work/src/java.base/$rel" "$ref/$rel"; then v=:boot-jdk  # the build's, the tool's apart (above)
      elif cmp -s "$work/src/java.base/$rel" "$ref/$rel"; then v=:same
      else v=:different; status=1; fi
      echo "  \"$rel\" $v"
    done < "$work/sources.txt"
    echo " }"
    # the resource data, against the JDK build's module image (jdk/modules/java.base)
    modules_ref=${conf:+$(dirname "$conf")/jdk/modules/java.base}
    echo " :data {"
    (cd "$work/data" && find . -type f | sed 's|^\./||' | LC_ALL=C sort) | while read -r rel; do
      # lib/ and conf/: the image's own files (tzdb.dat, java.security), against the build's jdk/
      case $rel in lib/*|conf/*) ref=${conf:+$(dirname "$conf")/jdk/$rel} ;; *) ref=${modules_ref:+$modules_ref/$rel} ;; esac
      if [ -z "$ref" ] || [ ! -f "$ref" ]; then v=:no-reference
      elif cmp -s "$work/data/$rel" "$ref"; then v=:same
      else v=:different; fi
      echo "  \"$rel\" $v"
    done
    echo "}}"
  } > "$work/generated.edn"
  grep -q ':different' "$work/generated.edn" && status=1
  nsame=$(grep -c '\.java" :same' "$work/generated.edn"); dsame=$(grep -c '" :same' "$work/generated.edn")
  nboot=$(grep -c '\.java" :boot-jdk' "$work/generated.edn")
  echo "$nsame of $(grep -c ' gensrc' "$work/sources.txt") generated sources equal to $gensrc_ref ($nboot the build's, its boot JDK's: :boot-jdk), $((dsame - nsame)) of $(find "$work/data" -type f | wc -l) data files to the build's jdk/modules ($(( $(date +%s) - t0 )) s)"
fi

# provenance: what the forms and the data are made from, $work/provenance.edn (jdk/'s
# provenance.edn): jdk26u's repository and commit (and whether its checkout is clean), the JDK
# whose javac attributes the sources for repr/java, the JDK that runs the generators, the locales, the
# converter (a hash of repr/java's reader, bin/lib/repr-java/host.bash's repr_java_reader_hash; its
# host, repr_java_host: javac's tool executable by the key of its sources) and the counts; :jdk, the
# platform javac on Arbace attributes against, by its pin (repr_java_platform, JFS35 (b): no JVM is
# asked); nothing of the run's place or time, so that verify compares it too (the host but
# reported, JFS32)
provenance() {
  local q='s/\\/\\\\/g; s/"/\\"/g' url commit clean
  url=$(git -C "$jdk" remote get-url origin 2>/dev/null | sed "$q")
  commit=$(git -C "$jdk" rev-parse HEAD 2>/dev/null)
  if [ -n "$commit" ] && [ -z "$(git -C "$jdk" status --porcelain --untracked-files=no -- src make 2>/dev/null)" ]; then clean=true; else clean=false; fi
  echo ";; The provenance of jdk/ (jdk/README.md): what bin/jrt-convert made its forms and data from."
  echo ";; Written by bin/jrt-convert update; bin/jrt-convert verify compares it with a fresh run's."
  echo "{:jdk26u {:repo \"$url\" :commit \"$commit\" :clean $clean}"
  echo " :jdk \"$(repr_java_platform)\""
  echo " :generators \"the JDK build's tools on the converter's host (JN7)\""
  echo " :locales \"${JRT_LOCALES:-none}\""
  echo " :converter {:repr-java \"$(repr_java_reader_hash)\""
  echo "             :host \"$(repr_java_host)\"}"
  echo " :files {:sources $(grep -vc " locales " "$work/sources.txt") :forms $(find "$work/conv" -name '*.ae' | wc -l) :data $(find "$work/data" -type f | wc -l)}}"
}

if has convert; then
  echo "== convert"
  t0=$(date +%s)
  convert "$work/src" "$work/conv" "$work/log/convert.log" || status=1
  provenance > "$work/provenance.edn" || status=1
  echo "($(( $(date +%s) - t0 )) s)"
fi

if has javac; then
  echo "== javac (twice)"
  t0=$(date +%s)
  (cd "$work/src/java.base" && find . -name '*.java' | sed 's|^\./||' | sort) > "$work/javac.list"
  for n in 1 2; do
    rm -rf "$work/ref$n"
    mkdir -p "$work/ref$n"
    # java.base's options of the JDK build that change class files (test/repr/java/jdk.bash)
    (cd "$work/src/java.base" && "$root/bin/repr-java" javac -XDstringConcat=inline --patch-module "java.base=$work/src/java.base" \
       -implicit:none --enable-preview -source 26 -nowarn -XDsuppressNotes -d "$work/ref$n" \
       "@$work/javac.list") > "$work/log/javac$n.log" 2>&1 || { echo "javac failed: $work/log/javac$n.log"; status=1; }
  done
  echo "$(find "$work/ref1" -name '*.class' | wc -l) classes ($(( $(date +%s) - t0 )) s)"
fi

if has check; then
  echo "== the forms compared with the committed ones (${committed#$root/}/forms)"
  list() { (cd "$1" && find . -type f -name '*.ae' | sed 's|^\./||' | LC_ALL=C sort); }
  list "$work/conv" > "$work/forms.new"
  list "$committed/forms" > "$work/forms.old"
  {
    echo "{:files $(wc -l < "$work/forms.new")"
    echo " :same $(comm -12 "$work/forms.old" "$work/forms.new" | while read -r f; do cmp -s "$work/conv/$f" "$committed/forms/$f" && echo; done | wc -l)"
    echo " :different ["
    comm -12 "$work/forms.old" "$work/forms.new" | while read -r f; do cmp -s "$work/conv/$f" "$committed/forms/$f" || echo "  \"$f\""; done
    echo " ]"
    echo " :added ["; comm -13 "$work/forms.old" "$work/forms.new" | sed 's/.*/  "&"/'; echo " ]"
    echo " :removed ["; comm -23 "$work/forms.old" "$work/forms.new" | sed 's/.*/  "&"/'; echo " ]}"
  } > "$work/forms-check.edn"
  echo "$(grep -c '^  "' "$work/forms-check.edn") files differ from, are added to or removed from ${committed#$root/}/forms ($work/forms-check.edn)"
fi

if has edge; then
  echo "== the edge"
  # the JDK classes' facts from the platform of javac on Arbace (the classes of the JDK the
  # converted sources are attributed against)
  plat=$("$root/bin/javac-vendor" platform "$work/platform") &&
    edge_clj "(jrt.jrt-edge/write-edge \"$work/ref1\" \"$surface\" \"$work/edge.edn\" \"$plat\")" || status=1
fi

if has report; then
  echo "== report ($work/report.md)"
  (cd "$work" && find src conv -type f | LC_ALL=C sort | xargs sha256sum) > "$work/manifest.sha256"
  out=$(clj "(let [s (jrt.jrt-sources/report \"$work\")]
                (System/exit (if (and (= (:java-files s) (:converted s))
                                      (zero? (:convert-failures s)) (zero? (:javac-errors s))
                                      (zero? (:unreadable s)))
                               0 1)))") || status=1
  echo "$out"
fi

if [ $twice = 1 ]; then
  echo "== again: sources, generators and repr/java a second time ($work/again)"
  t0=$(date +%s)
  mkdir -p "$work/again"
  make_sources "$work/again/src" && generate "$work/again/src" "$work/again/gen-tools" > "$work/log/generate-again.log" 2>&1 \
    && convert "$work/again/src" "$work/again/conv" "$work/log/convert-again.log" || status=1
  if diff -r "$work/src" "$work/again/src" > "$work/log/again-src.diff" &&
     diff -r "$work/data" "$work/again/data" > "$work/log/again-data.diff" &&
     diff -r "$work/conv" "$work/again/conv" > "$work/log/again-conv.diff"; then
    echo "deterministic: $(find "$work/again/src" -type f | wc -l) sources and $(find "$work/again/conv" -type f | wc -l) converted files identical ($(( $(date +%s) - t0 )) s)"
  else
    echo "NOT deterministic: see $work/log/again-*.diff"; status=1
  fi
fi
# jdk/'s tree as this run makes it, $work/jdk: the forms (repr/java's report left out), the data, the
# source list and the provenance; verify compares it with jdk/, update replaces jdk/'s with it
# (README.md and .gitattributes, hand-written, edge.edn, j2g's edge, which bin/j2g-edge
# records and verifies, and javac/, javac's forms, bin/javac-vendor's, stay)
if [ -n "$mode" ]; then
  echo "== $mode (${committed#$root/})"
  fresh=$work/jdk
  rm -rf "$fresh"
  mkdir -p "$fresh"
  if [ -d "$work/conv" ] && [ -d "$work/data" ] && [ -f "$work/provenance.edn" ]; then
    cp -r "$work/conv" "$fresh/forms" && rm -f "$fresh/forms/repr-java-report.edn" &&
      cp -r "$work/data" "$fresh/data" && cp "$work/sources.txt" "$work/provenance.edn" "$fresh/" || status=1
  else
    echo "no conversion in $work (the steps sources, generate and convert)"; status=1
  fi
  if [ "$mode" = verify ]; then
    # the provenance but its host (the tool that wrote it, JFS32): reported; jdk/javac is
    # bin/javac-vendor's (since JN2; its verify compares it)
    if [ $status = 0 ] && diff -r -x README.md -x .gitattributes -x edge.edn -x javac -x provenance.edn "$committed" "$fresh" > "$work/verify.diff" &&
       repr_java_provenance_same "$committed/provenance.edn" "$fresh/provenance.edn"; then
      echo "verify: ${committed#$root/} is the conversion, byte for byte ($(find "$fresh/forms" -type f | wc -l) forms files, $(find "$fresh/data" -type f | wc -l) data files; the provenance's host $(grep -o ':host "[^ ]* [0-9a-f]\{12\}' "$committed/provenance.edn" | cut -c8-), this run's $(grep -o ':host "[^ ]* [0-9a-f]\{12\}' "$fresh/provenance.edn" | cut -c8-))"
    else
      diff -r -x README.md -x .gitattributes -x edge.edn -x javac "$committed" "$fresh" > "$work/verify.diff"
      [ -s "$work/verify.diff" ] && echo "verify: ${committed#$root/} differs from a fresh conversion ($work/verify.diff: $(wc -l < "$work/verify.diff") lines)"
      status=1
    fi
  elif [ $status = 0 ]; then
    mkdir -p "$committed"
    rm -rf "$committed/forms" "$committed/data"
    cp -r "$fresh/forms" "$fresh/data" "$fresh/sources.txt" "$fresh/provenance.edn" "$committed/" || status=1
    echo "update: ${committed#$root/} written ($(find "$committed/forms" -type f | wc -l) forms files, $(find "$committed/data" -type f | wc -l) data files): commit it"
  else
    echo "update: a step failed, ${committed#$root/} left as it was"
  fi
fi
echo "jrt-convert: $(( $(date +%s) - t00 )) s, status $status"
exit $status

#!/bin/bash
# Vendor clojure.spec into arbace/ (doc/VENDOR-NOTES.md, "Spec"): the libraries upstream Clojure
# 98d735fab02f depends on (pom.xml), at those versions, renamed clojure.* -> arbace.* by
# arbace.j2c.rename as the rest of the vendored Clojure:
#   org.clojure/spec.alpha 0.6.249               -> arbace/spec/alpha.clj, gen/alpha.clj, test/alpha.clj
#   org.clojure/core.specs.alpha 0.6.133-alpha10 -> arbace/core/specs/alpha.clj
# Writes only under OUT (default .tmp/vendor-spec/); the result was copied into arbace/ once
# (cp -r OUT/tree/arbace .) and is maintained by hand since. Check: diff -r OUT/tree/arbace/spec
# arbace/spec, and likewise arbace/core/specs.
# Usage: bin/vendor-spec [OUT]
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"
out=${1:-.tmp/vendor-spec}
rm -rf "$out"
mkdir -p "$out"

# repository, tag, the tag's commit
libs="
spec.alpha v0.6.249 3d1efb353b8a95c699b4051ba8273568c21f874e
core.specs.alpha v0.6.133-alpha10 75875946b7e827a1cec91ce645d5e1dcfc475e49
"
while read -r name tag commit; do
  [ -z "$name" ] && continue
  echo "== fetch clojure/$name $tag ($commit)"
  git -C "$out" init -q "$name"
  git -C "$out/$name" fetch -q --depth 1 "https://github.com/clojure/$name" "refs/tags/$tag:refs/tags/$tag"
  [ "$(git -C "$out/$name" rev-parse "$tag^{commit}")" = "$commit" ] \
    || { echo "$name: $tag is not $commit" >&2; exit 1; }
  git -C "$out/$name" checkout -q "$commit"
  echo "== rename into $out/tree"
  java -cp . clojure.main -m arbace.j2c.rename vendor-lib "$out/$name" "$out/tree" \
    "https://github.com/clojure/$name" "$tag ($commit)"
done <<< "$libs"
find "$out/tree" -type f | sort

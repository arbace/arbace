#!/bin/bash
# Run Clojure's upstream test suite against a Clojure, by default the frozen baseline clojure/
# on the JVM (CLOJURE_SRC; extracted from the freeze tag into .tmp/frozen/, bin/lib/tools.bash),
# or against Arbace's Go build (CLOJURE_TESTS_GO), and compare the outcome with the recorded
# reference, test/baseline-results.edn (the Go build's: test/arbace-go-results.edn). Writes
# only under .tmp/clojure-tests/.
#
# Usage: bin/clojure-tests [-j JOBS] [--no-generative|--generative] [NAMESPACE...]
#        bin/clojure-tests --java-fixtures verify|update|OUT
#        bin/clojure-tests --divergences [RESULTS]
#   -j JOBS          parallel test processes (default: number of CPUs)
#   --no-generative  skip the test.generative phase (upstream's `ant test-generative`)
#   --generative     run it (the default, with CLOJURE_TESTS_GO too)
#   NAMESPACE...     run only these test namespaces (the totals then cover only them)
#   --divergences [RESULTS]  the suite's results RESULTS (a run's RUN/results.edn; default the
#                    reference, test/arbace-go-results.edn) judged per test against the Clojure
#                    levels' classes (test/clojure/divergences*.edn; doc/FULL-SUPPORT-SURVEY.md, REAP1,
#                    RPS3): every test, spec or namespace that does not pass or does not run in a
#                    class, by design or deferred (test/reap/main.ae, bin/reap's), or the exit status 1;
#                    no run, seconds
#   --java-fixtures OUT  only convert the suite's Java fixtures (test/java), renamed as for
#                    the Go build, into Java forms under OUT with repr/java (bin/repr-java, on
#                    javac's tool executable, its only host since JN6; run CLOJURE_TESTS_RUN,
#                    default java-fixtures; javac's class path CLOJURE_SRC, default the
#                    runtime's declarations, bin/repr-java declarations; no JVM): the forms
#                    committed in test/java-fixtures/forms
#                    (test/java-fixtures/README.md), which bin/arbace-go --build-tests
#                    translates into the Go build's test executable. Each file's first line
#                    names its source as clojure/clojure's path, not the scratch copy's, so
#                    that the output does not depend on where it was made
#   --java-fixtures verify  the same into RUN/fixtures/forms, with the provenance
#                    (RUN/fixtures/provenance.edn: clojure/clojure's commit, the platform javac
#                    on Arbace attributes the sources against by its pin, the converters'
#                    versions and repr/java's host,
#                    the counts),
#                    compared byte for byte with test/java-fixtures (diff -r, README.md
#                    aside; RUN/fixtures.diff; the provenance's host, the tool that wrote it,
#                    reported, not compared: bin/lib/repr-java/host.bash's repr_java_provenance_same):
#                    the committed forms are the conversion's output (bin/gate --full)
#   --java-fixtures update  the same, then test/java-fixtures/forms and provenance.edn
#                    replaced by them: after a change to what the conversion reads (repr/java,
#                    repr/clojure, the suite's revision, the classes the fixtures name), commit them with it
# Environment:
#   CLOJURE_SRC             class path of the Clojure under test: its Java classes and .clj
#                           sources (default: .tmp/frozen, whose clojure/ is the baseline)
#   CLOJURE_TESTS_RUN       name of the run, its files go to .tmp/clojure-tests/RUN
#                           (default: baseline)
#   CLOJURE_TESTS_EXPECTED  the reference results (default: test/baseline-results.edn, the
#                           frozen baseline's, with spec stubbed out; with CLOJURE_TESTS_GO
#                           test/arbace-go-results.edn)
#   CLOJURE_TESTS_GEN_MSEC  test.generative run time in ms (default 60000, as upstream)
#   CLOJURE_TESTS_TIMEOUT   per-process timeout in seconds (default 900); the reference's
#                           :timeouts {ns seconds} gives single namespaces their own (the Go
#                           build's: a namespace slower there than the default allows)
#   CLOJURE_TESTS_GO        the Go build (B1a, doc/go/EVAL-NOTES.md, "Phase 2C"): the command that
#                           runs it, e.g. target/arbace-go/amd64/arbace-tests or
#                           "qemu-aarch64 target/arbace-go/arm64/arbace-tests". Rename mode: the
#                           Clojure under test is Arbace's, renamed clojure.* -> arbace.*
#                           (doc/VENDOR-NOTES.md); the suite, its test libraries, the runner and
#                           the names used here are translated alike by repr/clojure (doc/REPR-CLOJURE.md;
#                           bin/repr-clojure read --in-place --keep-ext) into RUN/suite and .tmp/clojure-tests/lib-arbace/
#                           (the test namespaces keep their names, so the reference applies). The
#                           test namespaces (step 5) and test.generative (step 6) run on it, each
#                           in its own process, the renamed suite and test libraries on ARBACE_PATH;
#                           repr/clojure, the listing and the report run on the tools' host, the Go
#                           executable of bin/lib/host.bash (ARBACE_HOST_EXE, else stage 0): no
#                           JVM at all. Steps 3 and 4 are skipped: the Go build loads no class
#                           files, so the AOT fixtures load from source, and the Java fixtures
#                           (test/java) are translated into the executable: it must be the test
#                           build, bin/arbace-go --build-tests's target/arbace-go/<arch>/arbace-tests
#                           (checked); the reference is test/arbace-go-results.edn (the default
#                           CLOJURE_TESTS_EXPECTED; CLOJURE_TESTS_RUN defaults to go). Each
#                           process loads every test namespace first, as upstream does: about
#                           a minute; GOGC defaults to 400 for them (half the CPU time of the
#                           default 100, about 650 MB resident each instead of 300)
# (Until standalone S4 the renamed suite also ran on Arbace's JVM stages, CLOJURE_TESTS_RENAME
# and CLOJURE_TESTS_PRECOMPILED with CLOJURE_SRC=target/stageN, against test/arbace-results.edn;
# the JVM Arbace left main with S4, and with it those runs.)
#
# Steps, mirroring upstream's build.xml and pom.xml at the pinned revision:
#   1. fetch     clojure/clojure at $rev into RUN/clojure (only test/ and src/script/ are used)
#   2. deps      the pure-Clojure test libraries from Maven Central, checked by SHA-1
#   3. build     (the baseline) AOT-compile the Clojure namespaces of the Clojure under test with direct linking
#                into RUN/classes (ant compile-clojure). Needed: AOT test fixtures compiled with
#                direct linking call clojure.core's fn classes, which must exist as class files.
#   4. fixtures  (the baseline) javac test/java and AOT-compile the fixture namespaces into
#                RUN/clojure/target/test-classes (ant compile-tests)
#   5. test      each test namespace in its own process (ant test-example), in parallel: each
#                requires all test namespaces first, as upstream's single JVM does, then runs
#                the tests of its namespace
#   6. gen       the test.generative specs (ant test-generative)
#   7. report    per-namespace counts and totals; regressions against the reference
# Results: RUN/results.edn (same shape as the reference), logs in RUN/out/.
# Exit status: 0 when nothing regressed, 1 otherwise.
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash" # TMPDIR: .tmp/tmp when unset
. "$root/bin/lib/renamed-env.bash" # stops on a stale G2A_*, J2A_*, A2G_* or C2A_*
base=$root/.tmp/clojure-tests
if [ "${1:-}" = --divergences ]; then
  . "$root/bin/lib/tools.bash"
  results=${2:-$root/test/arbace-go-results.edn}
  case $results in /*) ;; *) results=$PWD/$results ;; esac
  REAP_ROOT=$root arbace_tool -p "$root/test" -m reap.main --suite "$results"
  exit $?
fi
java_fixtures= fixtures_mode=
if [ "${1:-}" = --java-fixtures ]; then
  java_fixtures=${2:?usage: bin/clojure-tests --java-fixtures verify|update|OUT}
  case $java_fixtures in
    verify|update) fixtures_mode=$java_fixtures java_fixtures= ;;
    /*) ;;
    *) java_fixtures=$PWD/$java_fixtures ;;
  esac
  . "$root/bin/lib/repr-java/host.bash"
  : "${CLOJURE_TESTS_RUN:=java-fixtures}"
  # javac's class path for the runtime the fixtures name (arbace.lang.IFn): the checkout's runtime
  # declarations compiled by javac on Arbace (bin/repr-java declarations; the survey's JFS6, JFS27;
  # until JN6, with REPR_JAVA_HOST=jvm, the frozen jar)
  if [ -z "${CLOJURE_SRC:-}" ]; then
    CLOJURE_SRC=$("$root/bin/repr-java" declarations "$base/${CLOJURE_TESTS_RUN}/declarations") || exit 1
  fi
  unset CLOJURE_TESTS_GO
  set --
fi
# rename mode (the Clojure under test is Arbace's): the Go build and the Java fixtures
rename=
go_exe=${CLOJURE_TESTS_GO:-}
if [ -n "$go_exe" ]; then
  : "${CLOJURE_TESTS_RUN:=go}" "${CLOJURE_TESTS_EXPECTED:=$root/test/arbace-go-results.edn}"
  export CLOJURE_TESTS_GO
fi
[ -n "$go_exe$java_fixtures$fixtures_mode" ] && rename=arbace
run=${CLOJURE_TESTS_RUN:-baseline}
work=$base/$run
src=$work/clojure
suite=$src
[ -n "$rename" ] && suite=$work/suite
. "$root/bin/lib/tools.bash"
. "$root/bin/lib/host.bash"
# repr_clojure ARGS... (bin/repr-clojure read ARGS...), on the tools' host
repr_clojure() { arbace_tool "${repr_clojure_sources[@]}" -m arbace.repr.clojure read "$@"; }
# Translate a tree in place for the Clojure under test: the suite's and libraries' files keep
# their names (.clj, .cljc, .java), as the reference results name them
repr_clojure_tree() { repr_clojure -q --in-place --keep-ext "$1"; }
# Translate standard input (clojure.* -> arbace.*) in rename mode.
rn() { if [ -n "$rename" ]; then repr_clojure --stdin; else cat; fi; }
rev=98d735fab02f337cee654cb0629bddc09883a75a
runner=$root/test/run_clojure_tests.clj
[ -n "$rename" ] && runner=$work/run_clojure_tests.clj
expected=${CLOJURE_TESTS_EXPECTED:-$root/test/baseline-results.edn}
clojure_src=${CLOJURE_SRC:-}
if [ -z "$clojure_src" ] && [ -z "$go_exe" ]; then clojure_src=$(frozen_clojure); fi
gen_msec=${CLOJURE_TESTS_GEN_MSEC:-60000}
timeout_s=${CLOJURE_TESTS_TIMEOUT:-900}

# Test-scoped dependencies of upstream's pom.xml (mvn dependency:tree -Dscope=test), minus:
# spec.alpha and core.specs.alpha (the baseline stubs spec out; Arbace vendors them as
# arbace.spec.* and arbace.core.specs.alpha, doc/VENDOR-NOTES.md), and jaxws-api with its four
# dependencies (used only by annotations/java_8.clj and java_9.clj, loaded on Java 8 to 10).
deps="
org/clojure/test.generative/1.1.1 fd928b91ee8b61ca22396275cdbb69b857c430d1
org/clojure/tools.namespace/1.5.1 1ae9cc0309598c7df8551d2754f9cb22b922f6fa
org/clojure/java.classpath/1.1.1 bb1bf2e836a3d387ab1cc7be32a8648f0c7f6448
org/clojure/tools.reader/1.6.0 f38c62efb86b436661f12b69f0dbe2092ac0df85
org/clojure/data.generators/1.1.1 15ddedaccca52fbf6c14821c6d04d0a6b3aacc9d
org/clojure/test.check/1.1.3 6241f491c7bf138d9339ed928bdc2410310817ae
"

# build.xml compile-clojure.
core_nss="clojure.core clojure.core.protocols clojure.core.server clojure.main clojure.set
clojure.edn clojure.xml clojure.zip clojure.inspector clojure.walk clojure.stacktrace
clojure.template clojure.test clojure.test.tap clojure.test.junit clojure.pprint clojure.java.io
clojure.repl clojure.java.browse clojure.java.javadoc clojure.java.shell clojure.java.process
clojure.java.browse-ui clojure.java.basis.impl clojure.java.basis clojure.string clojure.data
clojure.reflect clojure.datafy clojure.instant clojure.uuid clojure.core.reducers clojure.math
clojure.tools.deps.interop clojure.repl.deps"

# build.xml compile-tests, plus clojure.test-clojure.compilation.examples: compilation.clj
# compiles it into target/test-classes when loaded, which every parallel JVM does; compiled once
# beforehand, the JVMs load the class files instead of all rewriting them at once.
fixture_nss="clojure.test-clojure.protocols.examples clojure.test-clojure.proxy.examples
clojure.test-clojure.genclass.examples clojure.test-clojure.compilation.load-ns
clojure.test-clojure.annotations"
extra_fixture_nss="clojure.test-clojure.compilation.examples"

jar_of() { echo "$base/lib/$(basename "$(dirname "$1")")-$(basename "$1").jar"; }
# In rename mode a library is its jar extracted and renamed, in lib-arbace/NAME/.
lib_of() {
  if [ -n "$rename" ]; then local j; j=$(jar_of "$1"); j=${j##*/}; echo "$base/lib-$rename/${j%.jar}"
  else jar_of "$1"; fi
}
libcp() {
  local cp="" coord sha
  while read -r coord sha; do
    if [ -n "$coord" ]; then cp="$cp$(lib_of "$coord"):"; fi
  done <<< "$deps"
  echo "$cp"
}

# Upstream's test class path: maven.test.classpath (the test libraries), target/test-classes,
# test, then the build (here: the AOT classes, then the Clojure under test).
test_cp() { echo "$(libcp)$suite/target/test-classes:$suite/test:$work/classes:$clojure_src"; }
# The Go build's ARBACE_PATH: the test libraries, then the suite's sources, then the stand-ins
# of namespaces the Go build leaves out that test namespaces require (test/suite-go:
# arbace.inspector, for java-interop's ns form)
go_path() { local cp; cp=$(libcp); echo "$cp$suite/test:$root/test/suite-go"; }
# go_run TIMEOUT ARG...: the Go build, in the suite, on the suite's ARBACE_PATH
go_run() {
  local t=$1; shift
  # shellcheck disable=SC2086
  (cd "$suite" && ARBACE_PATH=$(go_path) TMPDIR=$work/tmp GOGC=${GOGC:-400} timeout "$t" $go_exe "$@")
}
# host_run ARG...: the tools' host (bin/lib/host.bash), in the suite, on the suite's ARBACE_PATH:
# the listing and the report with the Go build, whatever the build under test
host_run() {
  local exe
  exe=$(arbace_host_exe) || return 1
  (cd "$suite" && ARBACE_PATH=$(go_path) TMPDIR=$work/tmp "$exe" "$@")
}

# The names of the Clojure under test, renamed in rename mode (computed once, passed on to the
# --run-one processes).
if [ -z "${CLOJURE_TESTS_NAMES:-}" ]; then
  CLOJURE_TESTS_NAMES=$(echo "clojure.main clojure.lang.Compile clojure.compiler.direct-linking clojure.compile.path" | rn)
  export CLOJURE_TESTS_NAMES
fi
read -r main_class compile_class direct_prop path_prop <<< "$CLOJURE_TESTS_NAMES"
# Arbace's main class is arbace.lang.Main, not the renamed clojure.main (doc/VENDOR-NOTES.md)
if [ -n "$rename" ] && [ "$main_class" = "$rename.main" ]; then main_class=$rename.lang.Main; fi

jvm_props=(-Djava.awt.headless=true -D$direct_prop=true
           -Djava.io.tmpdir="$work/tmp")

# Internal entry point: run one namespace (called in parallel by xargs).
if [ "${1:-}" = "--run-one" ]; then
  ns=$2
  cd "$suite"
  # the reference's timeout for this namespace, if it has one
  t=$(awk -v n="$ns" '$1 == n { print $2 }' "$work/timeouts.txt" 2>/dev/null)
  timeout_s=${t:-$timeout_s}
  status=0
  if [ -n "$go_exe" ]; then
    start=$(date +%s%N)
    go_run "$timeout_s" "$runner" run "$ns" "$work/out/$ns.edn" "$work/namespaces.txt" "$expected" \
      > "$work/out/$ns.log" 2>&1 || status=$?
    printf '%-62s exit %s %6d ms\n' "$ns" "$status" $(( ($(date +%s%N) - start) / 1000000 )) | tee "$work/out/$ns.time"
    exit 0
  fi
  timeout "$timeout_s" java -cp "$(test_cp)" "${jvm_props[@]}" $main_class "$runner" \
    run "$ns" "$work/out/$ns.edn" "$work/namespaces.txt" "$expected" > "$work/out/$ns.log" 2>&1 || status=$?
  printf '%-62s exit %s\n' "$ns" "$status"
  exit 0
fi

jobs=$(nproc)
generative=1
only=()
while [ $# -gt 0 ]; do
  case $1 in
    -j) jobs=$2; shift 2 ;;
    --no-generative) generative=0; shift ;;
    --generative) generative=1; shift ;;
    -*) echo "unknown option: $1" >&2; exit 2 ;;
    *) only+=("$1"); shift ;;
  esac
done

step() { echo "== $*"; }

# 1. fetch
if [ "$(git -C "$src" rev-parse HEAD 2>/dev/null || true)" != "$rev" ]; then
  step "fetch clojure/clojure $rev"
  mkdir -p "$src"
  git -C "$src" init -q
  git -C "$src" remote add origin https://github.com/clojure/clojure 2>/dev/null || true
  git -C "$src" fetch -q --depth 1 origin "$rev"
  git -C "$src" checkout -q -f FETCH_HEAD
fi
# Undo what earlier runs left in the checkout (the tests write under test/).
git -C "$src" checkout -q -f "$rev"
git -C "$src" clean -q -f -d test

# Rename mode: the renamed copy of the suite (test/ and src/script/) and of the runner.
if [ -n "$rename" ]; then
  step "[$run] rename the suite into $suite"
  rm -rf "$suite"
  mkdir -p "$suite/src"
  cp -r "$src/test" "$suite/"
  cp -r "$src/src/script" "$suite/src/"
  find "$src" -maxdepth 1 -type f -exec cp {} "$suite/" \;   # readme.txt, read by a test
  repr_clojure_tree "$suite"
  # Renaming artifact: clojure.pprint is one character longer than arbace.pprint, and
  # test_pretty.clj's expected layouts align continuation lines under "[clojure.pprint :only (".
  sed -i '/\[arbace\.pprint :only/,/]/ s/^ \(  *[a-z]\)/\1/' \
    "$suite/test/clojure/test_clojure/pprint/test_pretty.clj"
  # (test-proxy-method-order's IProxy methods, __{init,update,get}ArbaceFnMappings in Arbace,
  # are repr/clojure's rule :proxy-methods)
  rn < "$root/test/run_clojure_tests.clj" > "$runner"
fi

# --java-fixtures: the renamed test/java as Java forms (repr/java), for the Go build's test build
# (committed in test/java-fixtures: its README.md)
if [ -n "$java_fixtures$fixtures_mode" ]; then
  committed=$root/test/java-fixtures
  [ -n "$fixtures_mode" ] && java_fixtures=$work/fixtures/forms
  step "[$run] convert the Java fixtures (test/java) into $java_fixtures with repr/java"
  rm -rf "$java_fixtures"
  # javac's class path: the Clojure under test (the fixtures name arbace.lang.IFn and the
  # Java API): the runtime's declarations by default
  "$root/bin/repr-java" read \
    --javac -cp --javac "$clojure_src" "$java_fixtures" "$suite/test/java" > "$work/java-fixtures.log" 2>&1 \
    || { cat "$work/java-fixtures.log"; exit 1; }
  grep -q ' 0 failed, 0 javac errors' "$work/java-fixtures.log" || { cat "$work/java-fixtures.log"; exit 1; }
  tail -1 "$work/java-fixtures.log"
  # the first line's source: clojure/clojure's path of the file (as repr/java's --origins does for
  # bin/jrt-convert), not the renamed scratch copy's under $suite
  find "$java_fixtures" -name '*.ae' -exec sed -i \
    "1s|^;; Converted from $suite/test/java/\(.*\) by arbace\.repr\.java\.|;; Converted from clojure/clojure test/java/\1, renamed by repr/clojure, by arbace.repr.java.|" {} +
  if grep -rlF "$root" "$java_fixtures"; then echo "the forms above name the checkout ($root)"; exit 1; fi
  [ -n "$fixtures_mode" ] || exit 0
  # the provenance: what the forms are made from, nothing of the run's place or time
  {
    echo ";; The provenance of test/java-fixtures/ (its README.md): what bin/clojure-tests"
    echo ";; --java-fixtures made the forms from. Written by its update; its verify compares it."
    echo "{:clojure {:repo \"https://github.com/clojure/clojure\" :commit \"$rev\" :path \"test/java\"}"
    echo " :jdk \"$(repr_java_platform)\""
    echo " :converter {:repr-java \"$(repr_java_reader_hash)\""
    echo "             :repr-clojure \"$(cd "$root" && find arbace/repr/clojure.ae arbace/repr/clojure -type f | LC_ALL=C sort | xargs sha256sum | sha256sum | cut -c1-64)\""
    echo "             :host \"$(repr_java_host)\"}"
    echo " :files {:sources $(find "$suite/test/java" -name '*.java' | wc -l) :forms $(find "$java_fixtures" -name '*.ae' | wc -l)}}"
  } > "$work/fixtures/provenance.edn"
  if [ "$fixtures_mode" = verify ]; then
    # the provenance but its host (the tool that wrote it, JFS32): reported
    if diff -r -x README.md -x provenance.edn "$committed" "$work/fixtures" > "$work/fixtures.diff" &&
       repr_java_provenance_same "$committed/provenance.edn" "$work/fixtures/provenance.edn"; then
      echo "verify: test/java-fixtures is the conversion, byte for byte ($(find "$java_fixtures" -name '*.ae' | wc -l) forms files; the provenance's host $(grep -o ':host "[^ ]* [0-9a-f]\{12\}' "$committed/provenance.edn" | cut -c8-), this run's $(grep -o ':host "[^ ]* [0-9a-f]\{12\}' "$work/fixtures/provenance.edn" | cut -c8-))"
      exit 0
    fi
    diff -r -x README.md "$committed" "$work/fixtures" > "$work/fixtures.diff"
    echo "verify: test/java-fixtures differs from a fresh conversion ($work/fixtures.diff: $(wc -l < "$work/fixtures.diff") lines)"
    head -40 "$work/fixtures.diff"
    exit 1
  fi
  mkdir -p "$committed"
  rm -rf "$committed/forms"
  cp -r "$java_fixtures" "$committed/forms" && cp "$work/fixtures/provenance.edn" "$committed/" || exit 1
  echo "update: test/java-fixtures written ($(find "$committed/forms" -name '*.ae' | wc -l) forms files): commit it"
  exit 0
fi

# 2. deps (shared by concurrent runs, as bin/gate makes them: one at a time)
repr_clojure_stamp=$(cat "$root"/arbace/repr/clojure.ae "$root"/arbace/repr/clojure/*.ae | sha256sum | cut -c1-64)
mkdir -p "$base/lib"
exec 9> "$base/lib.lock"
flock 9
while read -r coord sha; do
  [ -z "$coord" ] && continue
  jar=$(jar_of "$coord")
  if ! echo "$sha  $jar" | sha1sum -c --status 2>/dev/null; then
    step "download $coord"
    curl -sfL -o "$jar" "https://repo1.maven.org/maven2/$coord/$(basename "$jar")"
    echo "$sha  $jar" | sha1sum -c --quiet
    # the translated copy is stale (not in plain mode: lib_of is then the jar itself)
    [ -z "$rename" ] || rm -rf "$(lib_of "$coord")"
  fi
  lib=$(lib_of "$coord")
  # translated again when repr/clojure changed (its sources' hash, in
  # lib-arbace/NAME.repr-clojure)
  if [ -n "$rename" ] && { [ ! -d "$lib" ] || [ "$(cat "$lib.repr-clojure" 2>/dev/null)" != "$repr_clojure_stamp" ]; }; then
    step "translate $coord into $lib with repr/clojure"
    rm -rf "$lib" "$lib.tmp"
    mkdir -p "$lib.tmp"
    unzip -q "$jar" -d "$lib.tmp"
    repr_clojure_tree "$lib.tmp"
    mv "$lib.tmp" "$lib"
    echo "$repr_clojure_stamp" > "$lib.repr-clojure"
  fi
done <<< "$deps"
flock -u 9

# 3. build
rm -rf "${work:?}/classes" "${suite:?}/target" "${work:?}/tmp"
mkdir -p "$work/classes" "$suite/target/test-classes" "$work/tmp"
if [ -n "$go_exe" ]; then
  step "[$run] nothing to compile: the Go build holds its namespaces, prepared in its image"
else
  step "[$run] AOT-compile the Clojure under test into $work/classes"
  # shellcheck disable=SC2086
  java -cp "$work/classes:$clojure_src" -D$path_prop="$work/classes" \
    "${jvm_props[@]}" $compile_class $(echo $core_nss | rn) > "$work/build.log" 2>&1 \
    || { cat "$work/build.log"; exit 1; }
fi

# 4. fixtures
if [ -n "$go_exe" ]; then
  step "[$run] no fixtures to compile: the Go build loads no class files; its test build holds the Java fixtures"
  if ! go_run 120 -e '(Class/forName "arbace.test.SwissArmy")' > "$work/fixtures.log" 2>&1; then
    cat "$work/fixtures.log"
    echo "CLOJURE_TESTS_GO: $go_exe lacks the suite's Java fixtures (test/java); run the suite on the" \
      "test build: bin/arbace-go --build-tests, then target/arbace-go/<arch>/arbace-tests" >&2
    exit 1
  fi
else
step "[$run] compile the test fixtures into $suite/target/test-classes"
# shellcheck disable=SC2046
javac -nowarn -g --release 17 -encoding UTF-8 -cp "$work/classes:$clojure_src" \
  -d "$suite/target/test-classes" $(find "$suite/test/java" -name '*.java') > "$work/fixtures.log" 2>&1 \
  || { cat "$work/fixtures.log"; exit 1; }
# shellcheck disable=SC2086
(cd "$suite" && java -cp "$(test_cp)" -D$path_prop=target/test-classes \
  "${jvm_props[@]}" $compile_class $fixture_nss $extra_fixture_nss) >> "$work/fixtures.log" 2>&1 \
  || { cat "$work/fixtures.log"; exit 1; }
fi

# 5. test
rm -rf "${work:?}/out"
mkdir -p "$work/out"
if [ -n "$go_exe" ]; then
  host_run "$runner" list test "$expected" "$work/timeouts.txt" > "$work/namespaces.txt"
else
  (cd "$suite" && java -cp "$(test_cp)" $main_class "$runner" list test "$expected" "$work/timeouts.txt") \
    > "$work/namespaces.txt"
fi
if [ ${#only[@]} -gt 0 ]; then
  printf '%s\n' "${only[@]}" > "$work/selected.txt"
else
  cp "$work/namespaces.txt" "$work/selected.txt"
fi
step "[$run] run $(wc -l < "$work/selected.txt") test namespaces, $jobs at a time (logs in $work/out)$([ -n "$go_exe" ] && echo ", on $go_exe")"
export CLOJURE_SRC=$clojure_src CLOJURE_TESTS_RUN=$run CLOJURE_TESTS_TIMEOUT=$timeout_s
xargs -P "$jobs" -n 1 "$0" --run-one < "$work/selected.txt" | grep -v ' exit 0$' || true

# 6. gen
if [ $generative = 1 ] && [ ${#only[@]} -eq 0 ]; then
  step "[$run] run the test.generative specs for ${gen_msec}ms (log in $work/out/generative.log)"
  status=0
  if [ -n "$go_exe" ]; then
    # test.generative's run time: its runner reads the property, which the Go build cannot be
    # given on its command line
    go_run "$timeout_s" -e "(System/setProperty \"clojure.test.generative.msec\" \"$gen_msec\")" \
      "$runner" generative test "$work/out/generative.edn" "$work/namespaces.txt" "$expected" > "$work/out/generative.log" 2>&1 || status=$?
  else
  (cd "$suite" && timeout "$timeout_s" java -cp "$(test_cp)" "${jvm_props[@]}" \
    -Dclojure.test.generative.msec="$gen_msec" $main_class "$runner" \
    generative test "$work/out/generative.edn") > "$work/out/generative.log" 2>&1 || status=$?
  fi
  [ $status = 0 ] || echo "test.generative exit $status"
fi

# 7. report
if [ -n "$go_exe" ]; then
  host_run "$runner" report "$work/out" "$expected" "$work/results.edn" "$(tr '\n' ' ' < "$work/selected.txt")"
else
  (cd "$suite" && java -cp "$(test_cp)" $main_class "$runner" report "$work/out" "$expected" \
    "$work/results.edn" "$(tr '\n' ' ' < "$work/selected.txt")")
fi

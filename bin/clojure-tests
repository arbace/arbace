#!/bin/bash
# Run Clojure's upstream test suite against a Clojure, by default the frozen baseline clojure/
# (CLOJURE_SRC; extracted from the freeze tag into .tmp/frozen/, bin/lib/tools.bash), and compare the outcome with the recorded reference,
# test/baseline-results.edn (in rename mode, against Arbace: test/arbace-results.edn). Writes
# only under .tmp/clojure-tests/.
#
# Usage: bin/clojure-tests [-j JOBS] [--no-generative] [NAMESPACE...]
#   -j JOBS          parallel test JVMs (default: number of CPUs)
#   --no-generative  skip the test.generative phase (upstream's `ant test-generative`)
#   NAMESPACE...     run only these test namespaces (the totals then cover only them)
# Environment:
#   CLOJURE_SRC             class path of the Clojure under test: its Java classes and .clj
#                           sources (default: .tmp/frozen, whose clojure/ is the baseline)
#   CLOJURE_TESTS_RUN       name of the run, its files go to .tmp/clojure-tests/RUN
#                           (default: baseline)
#   CLOJURE_TESTS_EXPECTED  the reference results (default: test/baseline-results.edn, the
#                           frozen baseline's, with spec stubbed out; in rename mode
#                           test/arbace-results.edn, Arbace's, with spec: everything passes)
#   CLOJURE_TESTS_GEN_MSEC  test.generative run time in ms (default 60000, as upstream)
#   CLOJURE_TESTS_TIMEOUT   per-JVM timeout in seconds (default 900)
#   CLOJURE_TESTS_RENAME    "arbace": the Clojure under test is Arbace's, renamed clojure.* ->
#                           arbace.* (doc/VENDOR-NOTES.md). The suite, its test libraries, the
#                           runner, the class and namespace names and the system properties
#                           used here are renamed alike with arbace.j2c.rename (run on Arbace,
#                           bin/lib/tools.bash, which needs bin/build-arbace's target/stage2),
#                           into RUN/suite and .tmp/clojure-tests/lib-arbace/.
#                           The test namespaces keep their names, so the reference applies.
#   CLOJURE_TESTS_PRECOMPILED  1: the Clojure under test already holds its namespaces
#                           AOT-compiled with direct linking, as a release jar does (Arbace's
#                           stages, bin/build-arbace); step 3 is skipped and the suite runs
#                           against those classes
#
# Steps, mirroring upstream's build.xml and pom.xml at the pinned revision:
#   1. fetch     clojure/clojure at $rev into RUN/clojure (only test/ and src/script/ are used)
#   2. deps      the pure-Clojure test libraries from Maven Central, checked by SHA-1
#   3. build     AOT-compile the Clojure namespaces of the Clojure under test with direct linking
#                into RUN/classes (ant compile-clojure). Needed: AOT test fixtures compiled with
#                direct linking call clojure.core's fn classes, which must exist as class files.
#   4. fixtures  javac test/java and AOT-compile the fixture namespaces into
#                RUN/clojure/target/test-classes (ant compile-tests)
#   5. test      each test namespace in its own JVM (ant test-example), in parallel: each JVM
#                requires all test namespaces first, as upstream's single JVM does, then runs
#                the tests of its namespace
#   6. gen       the test.generative specs (ant test-generative)
#   7. report    per-namespace counts and totals; regressions against the reference
# Results: RUN/results.edn (same shape as the reference), logs in RUN/out/.
# Exit status: 0 when nothing regressed, 1 otherwise.
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
base=$root/.tmp/clojure-tests
run=${CLOJURE_TESTS_RUN:-baseline}
work=$base/$run
src=$work/clojure
rename=${CLOJURE_TESTS_RENAME:-}
case $rename in
  "") suite=$src ;;
  arbace) suite=$work/suite ;;
  *) echo "CLOJURE_TESTS_RENAME: only arbace is known" >&2; exit 2 ;;
esac
. "$root/bin/lib/tools.bash"
# arbace.j2c.rename ARGS..., on Arbace
rename_tool() { [ -n "${ARBACE_CP:-}" ] || arbace_runtime; java -cp "$ARBACE_CP" arbace.lang.Main -m arbace.j2c.rename "$@"; }
# Rename standard input (clojure.* -> arbace.*) in rename mode.
rn() { if [ -n "$rename" ]; then rename_tool stdin; else cat; fi; }
rev=98d735fab02f337cee654cb0629bddc09883a75a
runner=$root/test/run_clojure_tests.clj
[ -n "$rename" ] && runner=$work/run_clojure_tests.clj
default_expected=$root/test/baseline-results.edn
[ -n "$rename" ] && default_expected=$root/test/arbace-results.edn
expected=${CLOJURE_TESTS_EXPECTED:-$default_expected}
clojure_src=${CLOJURE_SRC:-}
if [ -z "$clojure_src" ]; then clojure_src=$(frozen_clojure); fi
gen_msec=${CLOJURE_TESTS_GEN_MSEC:-60000}
timeout_s=${CLOJURE_TESTS_TIMEOUT:-900}

# Test-scoped dependencies of upstream's pom.xml (mvn dependency:tree -Dscope=test), minus:
# spec.alpha and core.specs.alpha (the baseline stubs spec out; Arbace vendors them as
# arbace.spec.* and arbace.core.specs.alpha, doc/VENDOR-NOTES.md), and jaxws-api with its four
# dependencies (used only by annotations/java_8.clj and java_9.clj, loaded on Java 8 to 10).
deps="
org/clojure/test.generative/1.1.1 fd928b91ee8b61ca22396275cdbb69b857c430d1
org/clojure/tools.namespace/1.5.1 1ae9cc0309598c7df8551d2754f9cb22b922f6fa
org/clojure/java.classpath/1.1.1 bb1bf2e836a3d387ab1cc7be32a8648f0c7f6448
org/clojure/tools.reader/1.6.0 f38c62efb86b436661f12b69f0dbe2092ac0df85
org/clojure/data.generators/1.1.1 15ddedaccca52fbf6c14821c6d04d0a6b3aacc9d
org/clojure/test.check/1.1.3 6241f491c7bf138d9339ed928bdc2410310817ae
"

# build.xml compile-clojure.
core_nss="clojure.core clojure.core.protocols clojure.core.server clojure.main clojure.set
clojure.edn clojure.xml clojure.zip clojure.inspector clojure.walk clojure.stacktrace
clojure.template clojure.test clojure.test.tap clojure.test.junit clojure.pprint clojure.java.io
clojure.repl clojure.java.browse clojure.java.javadoc clojure.java.shell clojure.java.process
clojure.java.browse-ui clojure.java.basis.impl clojure.java.basis clojure.string clojure.data
clojure.reflect clojure.datafy clojure.instant clojure.uuid clojure.core.reducers clojure.math
clojure.tools.deps.interop clojure.repl.deps"

# build.xml compile-tests, plus clojure.test-clojure.compilation.examples: compilation.clj
# compiles it into target/test-classes when loaded, which every parallel JVM does; compiled once
# beforehand, the JVMs load the class files instead of all rewriting them at once.
fixture_nss="clojure.test-clojure.protocols.examples clojure.test-clojure.proxy.examples
clojure.test-clojure.genclass.examples clojure.test-clojure.compilation.load-ns
clojure.test-clojure.annotations"
extra_fixture_nss="clojure.test-clojure.compilation.examples"

jar_of() { echo "$base/lib/$(basename "$(dirname "$1")")-$(basename "$1").jar"; }
# In rename mode a library is its jar extracted and renamed, in lib-arbace/NAME/.
lib_of() {
  if [ -n "$rename" ]; then local j; j=$(jar_of "$1"); j=${j##*/}; echo "$base/lib-$rename/${j%.jar}"
  else jar_of "$1"; fi
}
libcp() {
  local cp="" coord sha
  while read -r coord sha; do
    if [ -n "$coord" ]; then cp="$cp$(lib_of "$coord"):"; fi
  done <<< "$deps"
  echo "$cp"
}

# Upstream's test class path: maven.test.classpath (the test libraries), target/test-classes,
# test, then the build (here: the AOT classes, then the Clojure under test).
test_cp() { echo "$(libcp)$suite/target/test-classes:$suite/test:$work/classes:$clojure_src"; }

# The names of the Clojure under test, renamed in rename mode (computed once, passed on to the
# --run-one processes).
if [ -z "${CLOJURE_TESTS_NAMES:-}" ]; then
  CLOJURE_TESTS_NAMES=$(echo "clojure.main clojure.lang.Compile clojure.compiler.direct-linking clojure.compile.path" | rn)
  export CLOJURE_TESTS_NAMES
fi
read -r main_class compile_class direct_prop path_prop <<< "$CLOJURE_TESTS_NAMES"
# Arbace's main class is arbace.lang.Main, not the renamed clojure.main (doc/VENDOR-NOTES.md)
if [ -n "$rename" ] && [ "$main_class" = "$rename.main" ]; then main_class=$rename.lang.Main; fi

jvm_props=(-Djava.awt.headless=true -D$direct_prop=true
           -Djava.io.tmpdir="$work/tmp")

# Internal entry point: run one namespace (called in parallel by xargs).
if [ "${1:-}" = "--run-one" ]; then
  ns=$2
  cd "$suite"
  status=0
  timeout "$timeout_s" java -cp "$(test_cp)" "${jvm_props[@]}" $main_class "$runner" \
    run "$ns" "$work/out/$ns.edn" "$work/namespaces.txt" > "$work/out/$ns.log" 2>&1 || status=$?
  printf '%-62s exit %s\n' "$ns" "$status"
  exit 0
fi

jobs=$(nproc)
generative=1
only=()
while [ $# -gt 0 ]; do
  case $1 in
    -j) jobs=$2; shift 2 ;;
    --no-generative) generative=0; shift ;;
    -*) echo "unknown option: $1" >&2; exit 2 ;;
    *) only+=("$1"); shift ;;
  esac
done

step() { echo "== $*"; }

# 1. fetch
if [ "$(git -C "$src" rev-parse HEAD 2>/dev/null || true)" != "$rev" ]; then
  step "fetch clojure/clojure $rev"
  mkdir -p "$src"
  git -C "$src" init -q
  git -C "$src" remote add origin https://github.com/clojure/clojure 2>/dev/null || true
  git -C "$src" fetch -q --depth 1 origin "$rev"
  git -C "$src" checkout -q -f FETCH_HEAD
fi
# Undo what earlier runs left in the checkout (the tests write under test/).
git -C "$src" checkout -q -f "$rev"
git -C "$src" clean -q -f -d test

# Rename mode: the renamed copy of the suite (test/ and src/script/) and of the runner.
if [ -n "$rename" ]; then
  step "[$run] rename the suite into $suite"
  rm -rf "$suite"
  mkdir -p "$suite/src"
  cp -r "$src/test" "$suite/"
  cp -r "$src/src/script" "$suite/src/"
  find "$src" -maxdepth 1 -type f -exec cp {} "$suite/" \;   # readme.txt, read by a test
  rename_tool tree "$suite" .clj .cljc .java
  # Renaming artifact: clojure.pprint is one character longer than arbace.pprint, and
  # test_pretty.clj's expected layouts align continuation lines under "[clojure.pprint :only (".
  sed -i '/\[arbace\.pprint :only/,/]/ s/^ \(  *[a-z]\)/\1/' \
    "$suite/test/clojure/test_clojure/pprint/test_pretty.clj"
  # Arbace's proxies name their IProxy methods __{init,update,get}ArbaceFnMappings
  # (doc/VENDOR-NOTES.md, "After vendoring"); test-proxy-method-order lists them.
  sed -i 's/__\(init\|update\|get\)ClojureFnMappings/__\1ArbaceFnMappings/' \
    "$suite/test/clojure/test_clojure/java_interop.clj"
  rn < "$root/test/run_clojure_tests.clj" > "$runner"
fi

# 2. deps (shared by concurrent runs, as bin/gate makes them: one at a time)
mkdir -p "$base/lib"
exec 9> "$base/lib.lock"
flock 9
while read -r coord sha; do
  [ -z "$coord" ] && continue
  jar=$(jar_of "$coord")
  if ! echo "$sha  $jar" | sha1sum -c --status 2>/dev/null; then
    step "download $coord"
    curl -sfL -o "$jar" "https://repo1.maven.org/maven2/$coord/$(basename "$jar")"
    echo "$sha  $jar" | sha1sum -c --quiet
    rm -rf "$(lib_of "$coord")"
  fi
  lib=$(lib_of "$coord")
  if [ -n "$rename" ] && [ ! -d "$lib" ]; then
    step "rename $coord into $lib"
    mkdir -p "$lib.tmp"
    (cd "$lib.tmp" && jar xf "$jar")
    rename_tool tree "$lib.tmp" .clj .cljc .java
    mv "$lib.tmp" "$lib"
  fi
done <<< "$deps"
flock -u 9

# 3. build
rm -rf "${work:?}/classes" "${suite:?}/target" "${work:?}/tmp"
mkdir -p "$work/classes" "$suite/target/test-classes" "$work/tmp"
if [ "${CLOJURE_TESTS_PRECOMPILED:-}" = 1 ]; then
  step "[$run] the Clojure under test holds its namespaces AOT-compiled"
else
  step "[$run] AOT-compile the Clojure under test into $work/classes"
  # shellcheck disable=SC2086
  java -cp "$work/classes:$clojure_src" -D$path_prop="$work/classes" \
    "${jvm_props[@]}" $compile_class $(echo $core_nss | rn) > "$work/build.log" 2>&1 \
    || { cat "$work/build.log"; exit 1; }
fi

# 4. fixtures
step "[$run] compile the test fixtures into $suite/target/test-classes"
# shellcheck disable=SC2046
javac -nowarn -g --release 17 -encoding UTF-8 -cp "$work/classes:$clojure_src" \
  -d "$suite/target/test-classes" $(find "$suite/test/java" -name '*.java') > "$work/fixtures.log" 2>&1 \
  || { cat "$work/fixtures.log"; exit 1; }
# shellcheck disable=SC2086
(cd "$suite" && java -cp "$(test_cp)" -D$path_prop=target/test-classes \
  "${jvm_props[@]}" $compile_class $fixture_nss $extra_fixture_nss) >> "$work/fixtures.log" 2>&1 \
  || { cat "$work/fixtures.log"; exit 1; }

# 5. test
rm -rf "${work:?}/out"
mkdir -p "$work/out"
(cd "$suite" && java -cp "$(test_cp)" $main_class "$runner" list test "$expected") > "$work/namespaces.txt"
if [ ${#only[@]} -gt 0 ]; then
  printf '%s\n' "${only[@]}" > "$work/selected.txt"
else
  cp "$work/namespaces.txt" "$work/selected.txt"
fi
step "[$run] run $(wc -l < "$work/selected.txt") test namespaces, $jobs at a time (logs in $work/out)"
export CLOJURE_SRC=$clojure_src CLOJURE_TESTS_RUN=$run CLOJURE_TESTS_TIMEOUT=$timeout_s \
  CLOJURE_TESTS_RENAME=$rename
xargs -P "$jobs" -n 1 "$0" --run-one < "$work/selected.txt" | grep -v ' exit 0$' || true

# 6. gen
if [ $generative = 1 ] && [ ${#only[@]} -eq 0 ]; then
  step "[$run] run the test.generative specs for ${gen_msec}ms (log in $work/out/generative.log)"
  status=0
  (cd "$suite" && timeout "$timeout_s" java -cp "$(test_cp)" "${jvm_props[@]}" \
    -Dclojure.test.generative.msec="$gen_msec" $main_class "$runner" \
    generative test "$work/out/generative.edn") > "$work/out/generative.log" 2>&1 || status=$?
  [ $status = 0 ] || echo "test.generative exit $status"
fi

# 7. report
(cd "$suite" && java -cp "$(test_cp)" $main_class "$runner" report "$work/out" "$expected" \
  "$work/results.edn" "$(tr '\n' ' ' < "$work/selected.txt")")

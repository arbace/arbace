#!/bin/bash
# Java's conformance check (doc/classes/JAVA-CONFORMANCE-SURVEY.md, JC1, "As built: JC1"; JCS2-JCS13):
# jdk26u's jtreg tests, read in place at the platform's pin, each put in a package of its own
# (`package tNNNNN; ` before the first line of its files of the unnamed package, JCS4 (a)), run at
# Arbace's levels against the JDK's run of the same renamed sources, recorded as data (JCS5 (b):
# test/java/ref-jdk26.edn), so that the check itself needs no JVM. As bin/goi check is Go's. The
# data side is the namespace java.check (test/java/check.ae, on the tools' host, JCS7 (a)); the
# interpreted runs are test/java/run.ae's, on the executable under test.
#
#   bin/java-check [--levels L,...] [--jobs N] [--timeout S] [--only REGEX] [--list FILE] [--corpus C,...] [--record]
#                      the check: every test test/java/ref-jdk26.edn passes on the JDK (of the corpora
#                      C, test/java/corpora.edn; whose id or jtreg name REGEX finds), at the levels L
#                      (default read,interp; JCS6 (a)):
#                        read     repr/java's read of the renamed sources on javac's tool executable
#                                 (REPR_JAVA_EXE, bin/repr-java), every file converted (cached in
#                                 .tmp/java-check/forms/KK/KEY, cache_slot, by the sources, javac's options, the reader's
#                                 sources and the tool's key)
#                        nread    the read without javac (JFS123 (b), doc/classes/JAVA-FRONTEND-SURVEY.md,
#                                 "As built: JN9f"): bin/repr-java read --no-javac of the same sources
#                                 (cached in .tmp/java-check/forms-nojavac by the read's key), its forms
#                                 against the read level's byte for byte: pass, fallback (equal, but
#                                 files met what only javac answers and were read by javac: the reasons
#                                 counted), differ, fail; unread when javac's read failed
#                        interp   each main action of the test interpreted (arbace.classes.interp) on
#                                 the executable (JAVA_CHECK_EXE, else the gate's
#                                 ARBACE_GATE_EXES/KEY20/amd64/arbace (bin/lib/gate-cache.bash), else target/arbace-go/amd64/arbace):
#                                 the test's packages required as the REPL loads them, file by file
#                                 (--load files, the default since JC2: JCS33 (a)), its main called;
#                                 since JCV1 (the user's decision of 2026-11-07, "As built: JCV1") a
#                                 test test/java/verdicts.edn marks :status is judged by its own
#                                 verdict, jtreg's: pass when main returns normally (status 0, no
#                                 other thread's exception uncaught but a ThreadDeath, run.ae's 97),
#                                 stdout not looked at (the JDK's record judged too: a row
#                                 interp.jdk where it says otherwise, the oracle tier's); a :stdout
#                                 test as before JCV1:
#                                 pass when the status and stdout (its SHA-256 and length) are the
#                                 JDK's, the status alone for a test whose two JDK runs differ (JCS3
#                                 (a)), stdout with identity hash codes masked when the plain digest
#                                 differs or only the masked runs agreed (JCS17 (b)); load-failed,
#                                 fail, differ, timeout otherwise, stderr's first line the reason;
#                                 since F6 (doc/classes/JAVA-DEFERRED-TRIAGE.md, "As built: F6", JCS95
#                                 (c)) a test whose sources name javac's API (com.sun.tools.javac,
#                                 com.sun.source, javax.tools, javax.lang.model,
#                                 javax.annotation.processing, java.util.spi.ToolProvider; not in a
#                                 comment line) on javac's tool executable (REPR_JAVA_EXE, bin/repr-java's,
#                                 which holds javac's world), its system compiler's platform the
#                                 property jdk.internal.jrt.javac.platform (bin/repr-java platform-dir);
#                                 without the tool, on the executable as the others (a warning);
#                                 since JCS300 (c) ("As built: JCS300 (c)") a test whose sources name
#                                 java.lang.classfile or test.classes (no comment line) compiled first
#                                 by javac on Arbace into WORK/classes/ID (its test.classes), the
#                                 directory on ARBACE_PATH after the forms (its class files as
#                                 resources), at interp and compiled
#                        compiled the tests translated by j2g (JC2, survey §7.2): in shards of
#                                 --shard-size tests (default 500, JCS48 (a); a shard whose j2g dies
#                                 split in two and run again, JCS48 (b); --shard K,...: those shards
#                                 again, the others' results kept from the last run), each
#                                 one program (bin/j2g --program with the tests' forms and the
#                                 shipped build's compiled namespaces: --build-program's base
#                                 (bin/lib/program.bash's program_base, RPS161 (b)), or JAVA_CHECK_AOT
#                                 (an override), refused when not of the checkout's runtime,
#                                 JCS46 (a); bin/build-go), a test whose classes j2g
#                                 refuses or whose Go does not compile taken out (refused, j2g's or
#                                 Go's reason) and the shard translated again; each main action run
#                                 on the program and judged as interp's; JAVA_CHECK_HEAVY, a command
#                                 prefix for j2g and the build (a slot of the host's);
#                                 --analyze-only (JCS265 (b), with --save): j2g's analysis alone, a
#                                 shard's world jdk/forms and its tests' forms (bin/j2g --analyze-only),
#                                 each test refused (j2g's reason) or analyzed, nothing translated or
#                                 built: the day's light measurement (--shard-size 30 stays within
#                                 2 GiB), its results never judged or recorded
#                        classes  javac on Arbace's class files (bin/repr-java javac, -g:none -nowarn
#                                 -XDsuppressNotes -proc:none -implicit:none and the test's options):
#                                 since JCV1 pass when javac accepts the test (none is @compile/fail),
#                                 the class files against the JDK javac's, by the digest of their
#                                 listing, the oracle tier's row classes.jdk when they differ
#                        print    every read test's forms printed back by repr/java's printer (the lines
#                                 layout, --index jdk/forms; java.print, test/java/print.ae: REAP5,
#                                 doc/FULL-SUPPORT-SURVEY.md, "As built: REAP5"), judged step by step,
#                                 the first not passing the result: javac on Arbace accepts the printed
#                                 Java, its read gives F1's forms again (as data, metadata included),
#                                 mode :full (read --full, cached in WORK/forms-full) prints the source
#                                 back byte for byte, and the printed Java's class files (-g:none) are
#                                 the original's (both by javac on Arbace since JCV1), their differences named as bin/repr-java roundtrip's
#                        diagnostics  langtools' golden-diagnostics tests (the corpus
#                                 langtools-diagnostics, compile-fail-ref: JC3, "As built: JC3"), in
#                                 place and not renamed, their @build and @compile actions in order by
#                                 javac on Arbace (bin/repr-java javac) as jtreg runs them (-d one
#                                 classes directory, -sourcepath the test's directory and @library's,
#                                 @modules as --add-exports, @enablePreview, ${test.src}...): pass when
#                                 each action's status is the JDK javac's and each ref=F action's
#                                 output equals F line by line, trailing white space dropped (the
#                                 JDK javac's does: a test whose JDK output differs is not checked);
#                                 fail (a status), differ (an output: its first differing line)
#                      The run tests are the levels read, nread, interp, classes, compiled and print's, the
#                      golden-diagnostics tests diagnostics'. Results in .tmp/java-check/results.tsv,
#                      against test/java/check-LEVEL.edn (as recorded, new, now passing; a test
#                      passing there and not now fails the check), every test not passing in a class
#                      of test/java/divergences.edn (none in no class), the numbers by area; --record
#                      writes check-LEVEL.edn. A run of the levels interp and compiled prints their
#                      disagreements (a test passing at one only) against test/java/levels-known.edn
#                      (JCS45 (a)): a new one fails the check, --record writes the file. The negative
#                      controls (GTS81 (a), test/java/controls.edn): a subject test's run judged a
#                      second time, by the level's own judge (interp and compiled: judge; classes:
#                      classes_verdict; diagnostics: diag_judge, against the reference's golden file,
#                      diag_golden; print: java.print/judge's steps, against the reference's original,
#                      each crossed step required to differ, GTS84 (a)), against another test's
#                      reference, under the control's id (a print control whose reference was not
#                      printed in the run is left); a
#                      control that passes, or is not judged while its subject reached the judge,
#                      fails the run (java.check/report, --judge and --essential-compiled alike); the
#                      controls are no tests of the records, classes or lists. Default 8
#                      jobs; --timeout, each action's seconds (default 20, the interpreter's
#                      definition included; a timeout is run again once at twice the limit before
#                      it counts, JCS47 (a); a test's line in test/java/timeouts.txt raises its
#                      own, GTS102, at every level that runs a program); --load files|do
#                      (JAVA_CHECK_LOAD): how interp defines a test's classes, files (the default) or
#                      do (a top-level do per package, JCS8 (a): the comparison mode). Each side runs
#                      in .tmp/java-check/w/ID with java.io.tmpdir and TMPDIR .tmp/java-check/tmp/ID
#                      (JCS19 (b)), as the JDK's runs did, and stdout is judged with those places
#                      and the checkout masked (W, TMP, WORK, ROOT; JCS70 (a)). A would-be
#                      regression (interp, compiled) is run again once; a test whose second run
#                      passes is flaky, no regression when a :flaky class of the level names it
#                      (JCS71 (a))
#   bin/java-check ... --save DIR
#                      the runs alone (GT5, doc/GATE-SURVEY.md, "As built: GT5": bin/gate's levels, each a
#                      step keyed by what it reads): no judgment; DIR/results.tsv the results (ID LEVEL
#                      RESULT REASON), and with the level read DIR/forms.sha256 (ID<TAB>the digest of its
#                      forms, their first line, which names the scratch they were read in, left out; -
#                      when the read failed), the forms' digest that the later levels' keys hold (an early
#                      cutoff: a reader change that reads the same forms keeps them); DIR/levels the levels
#                      run, and DIR/partial for a partial run (--only, --list, --essential), DIR/corpus the
#                      corpora of a run of whole corpora (--corpus alone: the gate's parts), which --judge
#                      reads (judged whole within those corpora). --list FILE (GT8, the gate's rotation): the
#                      tests whose ids (tNNNNN) FILE lists, one a line, a partial run (no --record). Status 0 when the levels ran, whatever their results,
#                      but for rows no test earned (queue 485): a shard that failed (its tests' "error the shard failed") or
#                      a plan missing or cut (WORK/run/ID/plan.tsv: no end line, no run line; java.check writes it whole, an
#                      end line last), more than JAVA_CHECK_ERRORS_MAX (default 0) fail the run (status 1), the results saved
#                      all the same; the run's errors fail a run without --save too. One run in a WORK at a time
#                      (WORK/run.lock: a second waits; JAVA_CHECK_WORK another WORK)
#   bin/java-check saved-errors [STORE]
#                      read-only (queue 485): the saved results of the gate's Java steps in the store of passes
#                      (default ARBACE_GATE_STORE's, else the main checkout's .tmp/gate-pass) that hold rows no test
#                      earned (the shard failed, a plan missing or cut) or whose step log shows plans missing (their
#                      tests passed unrun before queue 485): step/key, pass, date, the counts, newest (what
#                      --judge --latest-saved took before it); removes nothing. --latest-saved passes over them
#   bin/java-check --judge [--oracle] [--latest-saved] [--essential] [--record] [--partial] [--levels L,...] [--held FILE] RESULTS...
#                      the judgment alone (GT5): the RESULTS files (--save's results.tsv) judged as a run
#                      of their levels is, against test/java/check-LEVEL.edn, test/java/divergences.edn and
#                      test/java/levels-known.edn (seconds: a classes file's change runs nothing again);
#                      --essential as --essential's run is judged; JCV1: the rows judged by the tests' own
#                      verdicts (java.check/own-row: rows of a run before JCV1, judged by the JDK's record,
#                      judged again; the rows LEVEL.jdk left out), the two judgments' agreement printed per
#                      level; --oracle, the oracle tier's judgment (by hand, at a tag): the JDK's record's,
#                      the rows LEVEL.jdk where a run wrote one, at interp, compiled and classes, against
#                      test/java/oracle/check-LEVEL.edn and its levels-known.edn; --latest-saved: the
#                      newest saved results of the gate's Java level steps' parts in the store of passes
#                      (ARBACE_GATE_STORE) judged, with RESULTS if any; --held FILE: the ids of the tests an
#                      :audited class held (a run --save marked as audited), one a line (java-judge's
#                      held.txt, which the gate's java-held runs again unaudited). The levels judged: --levels, else
#                      those the files' --save named (the levels file beside each) and those their rows
#                      hold; none known fails. A level judged needs a row for every test it runs (a run
#                      that lost rows fails, java.check/report), but in a partial judgment (--partial,
#                      --essential, or a partial file beside a results file)
#   bin/java-check --essential [--jobs N]
#                      the essential gate's (JCS13 (a)): the tests of test/java/essential.txt at the
#                      level interp, from their forms committed in test/java/forms/ID (no javac:
#                      the read level is the whole check's); every one must pass
#   bin/java-check --essential-compiled [--jobs N]
#                      the essential gate's compiled level (REAP8, JCS41 (a)): the tests of
#                      test/java/essential.txt that pass compiled (test/java/check-compiled.edn), from
#                      their committed forms, in one program (j2g with the compiled namespaces, JAVA_CHECK_AOT,
#                      else the gate's, else target/arbace-go/aot; bin/build-go) cached by the key of
#                      what it is made from in .tmp/java-check/essential-compiled; every one must pass
#   bin/java-check --record-ref [--jobs N] [--only REGEX]
#                      the reference (JCS5 (b)), with the JDK (the system's javac and java, OpenJDK 26
#                      built from jdk26u): the corpora's tests scanned (java.check/scan: jtreg's tags,
#                      the survey's §3.1 categories), each test's source set as javac -sourcepath DIR
#                      parses it, the files renamed, compiled by the JDK's javac (as the test's
#                      @compile options say; and with -g:none ... for the classes level), each main
#                      action run twice (in an empty .tmp/java-check/w/ID, -Dtest.src=DIR -Dtest.classes=... and jtreg's other
#                      standard properties, test.jdk, test.root, test.name, test.file, ..., JCS341 (a),
#                      HotSpot's JIT options dropped, -Xmx2g, 60 s; stdout's digest and length with the
#                      run's places masked, JCS70 (a), also with identity hash codes masked, JCS17 (b);
#                      "-" for the digests of a run the two runs disagreed on, JCS80 (a); stderr's first
#                      line with the places masked, JCS84 (a)); the golden-diagnostics tests' actions by the JDK's javac in place,
#                      each output's digest and whether it is the golden file's; written as
#                      test/java/ref-jdk26.edn (--only REGEX: the plans it finds, by a plan's text or its
#                      test's id, "ID " (JCV12 (b): none planned fails), the other tests' lines kept
#                      byte for byte and checked to be, JCS68 (a); kind.diagnostics, the golden tests).
#                      JDK names the jdk26u checkout (default /root/jdk26u), its commit the platform's.
#                      JCS330-JCS333 ("As built: JCS330-JCS333"): a corpus admitting :run-lib or :framework
#                      (test/java/corpora.edn's :base) takes the tests that name an @library or run under TestNG
#                      or JUnit; their source sets have the libraries as jtreg resolves them (java.check/
#                      library-dirs, TEST.properties' modules and lib.dirs) and, for a framework test, the check's
#                      own runner (test/java/runner, ROOT: in the reference's :files) on javac's source path
#                      (record_sources' srcroot lines), the library files in their packages, named relative to
#                      the test's directory (../ paths); a framework action runs org.arbace.jtreg.Runner KIND
#                      CLASS on both sides, judged by its status (the runner's verdict, verdicts.edn). A change
#                      to test/java/runner changes every framework test's source set: record them again
#                      (--only $'category\tframework'); test/java/runner-test.bash is the runner's own check
#   bin/java-check --forms verify|update
#                      the essential tests' forms (test/java/forms/ID, test/java/forms/provenance.edn):
#                      read on javac's tool executable through the read level's cache (JAVA_CHECK_FORMS:
#                      afresh when the reader's key, the tool's key or the sources changed, else the
#                      forms read at that key) and compared byte for byte (verify), or written (update);
#                      GTS91 (a): verify also runs the read level's negative control
#                      (test/java/controls.edn, :forms), c00001's subject t03208 fresh forms compared by
#                      the same comparison with t03209's committed ones, which must differ (one that is
#                      equal fails the verify; one whose subject or reference is not in the run is left)
#   bin/java-check sources [--jobs N] [--only REGEX] [--list FILE] [--scan DIR] [--record]
#                      JOP13 (a) (doc/classes/JAVA-FRONTEND-SURVEY.md, "As built: JOP13 (a)"): each test's source
#                      set as Arbace's own record, test/java/sources.edn: the corpora scanned (or --scan DIR's plans,
#                      a scan made before), each set made as --record-ref makes it (record_sources: javac -verbose
#                      -implicit:class -sourcepath DIR and the source roots) but by javac on Arbace (bin/repr-java javac
#                      on REPR_JAVA_EXE, GOMEMLIMIT JAVA_CHECK_SOURCES_MEM, default 1GiB; default 4 jobs), placed by
#                      rename, compared with test/java/ref-jdk26.edn's :files and with --record written (the rows of
#                      the tests not run kept); the levels' plans take a test's :files from it (java.check/plan;
#                      JAVA_CHECK_SOURCES=jdk: the JDK's)
#   bin/java-check sources --check [--complete]
#                      the oracle tier's (java-sources-oracle): the JDK's sets against the own record, every test
#                      with one, equal, differ or not made, and the negative control (a set judged against another
#                      test's, which must differ); --complete fails a test the record lacks
#   bin/java-check scan
#                      the categories of the corpora's areas (java.check/scan), printed as a table
#   bin/java-check verdicts [--verify]
#                      JCV1: whose verdict judges each test the JDK passes (java.check/verdicts: :status, the
#                      source set can fail by itself, a throw, System.exit or Runtime's exit or halt, or prints
#                      nothing; :stdout, the JDK's stdout its only reference; :golden, the golden-diagnostics
#                      tests and, JCV2, the jls programs with their reviewed golden files; JCS361 (a), the
#                      jtreg tests with theirs, test/java/golden/ID.out),
#                      from the sources at the platform's pin, written as test/java/verdicts.edn (--verify
#                      compares), the shares per level printed
#   bin/java-check golden [--oracle] [--control]
#                      JCV2: the jls programs' golden files (test/java/jls/NAME.out, their expected stdout, the
#                      :golden verdict's) against their review (test/java/jls/golden.edn: each line's text,
#                      the JLS sections, the basis :jls, :api or :jdk, why); JCS361 (a): the jtreg tests' golden
#                      files (test/java/golden/ID.out, written from the test's source) against theirs
#                      (test/java/golden/AREA.edn: each line's text, or a range's pattern, the basis :src,
#                      :jls, :api or :jdk, why); --oracle: each against the JDK's recorded stdout's digest too
#                      (the oracle tier's, by hand); --control: each jtreg golden file with one byte changed
#                      must fail the review and leave the recorded digest; queue 451: a review :masked, its
#                      golden file with identity hash codes as @HASH, judged with stdout's masked (mask_hashes),
#                      --oracle against the record's masked digest
#   bin/java-check rejudge-records
#                      JCV1: test/java/check-{interp,compiled,classes}.edn and levels-known.edn made from
#                      the oracle tier's (test/java/oracle/) by the own verdict
#   bin/java-check --stale-reasons LEVEL [--ids]
#                      D356-2 (a): test/java/check-LEVEL.edn against today's world, no run: each row neither
#                      passing nor by design whose reason cites a class or member the world holds now (jrt's
#                      manifest, jdk/forms, jdk/javac/forms, jrt's own Java in overlay/jdk) is stale, counted by
#                      the name cited (--ids: the rows); its controls first (fabricated rows citing present
#                      names flagged, absent ones and the tests' own classes not), else exit 1; seconds
#
# Environment: JDK (jdk26u, default /root/jdk26u), JAVA_CHECK_EXE (the executable that interprets),
# JAVA_CHECK_FORMS (the read level's cache of forms, default WORK/forms; bin/gate's: the main checkout's,
# shared by the worktrees, keyed by the sources, the options, the reader's sources and the tool's key),
# JAVA_CHECK_FORMS_ONLY=1 (GTS41 (c), bin/gate --clean: the levels that consume the read's output, run
# without the read level, take their forms from that cache alone; a miss fails the run, never reads),
# REPR_JAVA_EXE (javac's tool executable, bin/repr-java's), ARBACE_HOST_EXE (the tools' host),
# JAVA_CHECK_INTERP_CPUS (the interp level's processors, default 8, 0 no cap: interp_cpus, the user's 612-1 (b)).
set -euo pipefail
export CGO_ENABLED=0
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash" # TMPDIR: .tmp/tmp when unset
. "$root/bin/lib/renamed-env.bash"
. "$root/bin/lib/tools.bash"
. "$root/bin/lib/gate-cache.bash" # arbace_gate_cache: the gate's builds, ARBACE_GATE_EXES/KEY20
. "$root/bin/lib/program.bash" # the compiled level's j2g and build-go calls, as --build-program's (RPS97 (b))
. "$root/bin/lib/limit.bash" # limited: CPU-time limits with a wall cap (GT6)
. "$root/bin/lib/cover.bash" # ARBACE_COVER_DIR: the cover build, a GOCOVERDIR per test (GT8.3)
cd "$root"

jdk=${JDK:-/root/jdk26u}
jdktest=$jdk/test
work=${JAVA_CHECK_WORK:-$root/.tmp/java-check} # the scratch (JAVA_CHECK_WORK: another, for a run beside one)
formsc=${JAVA_CHECK_FORMS:-$work/forms} # the read level's cache of forms (GT5: bin/gate shares the main checkout's)
ref=$root/test/java/ref-jdk26.edn
corpora=$root/test/java/corpora.edn
pin=baf63fbe42b8758448fee570a9d9bb914272d259 # jdk/javac/platform.sha256's commit of jdk26u
jc() { arbace_tool -p "$root/test" -m java.check "$@"; }

check_pin() {
  local c
  c=$(git -C "$jdk" rev-parse HEAD 2>&1) || { echo "java-check: no jdk26u checkout $jdk (JDK)" >&2; return 1; }
  grep -q "$c" "$root/jdk/javac/platform.sha256" || { echo "java-check: $jdk is at $c, not the platform's pin (jdk/javac/platform.sha256)" >&2; return 1; }
}

# jtreg_props JDKHOME BASE PATH CLS (JCS341 (a)): jtreg's standard system properties beside test.src and
# test.classes, as jtreg gives every run of a test: test.jdk (JDKHOME: the JDK's home on the reference's
# side, on Arbace's WORK/no-jdk, a path that is no JDK, so that a test launching a JVM or a JDK tool fails
# into the class it would anyway), test.root (the directory of the TEST.ROOT above the test's file, else
# the file's own), test.name (the file's path from test.root, without a #id), test.file (BASE/PATH, the
# test's file), test.vm.opts and test.java.opts (empty: the check gives a run no VM options) and
# test.class.path (CLS, test.classes); one -Dk=v a line
jtreg_props() {
  local jh=$1 base=$2 rel=${3%%#*} cls=$4 f r
  f=$base/$rel; r=$(dirname "$f")
  while [ "$r" != "$base" ] && [ "$r" != / ] && [ ! -f "$r/TEST.ROOT" ]; do r=$(dirname "$r"); done
  [ -f "$r/TEST.ROOT" ] || r=$(dirname "$f")
  printf '%s\n' "-Dtest.jdk=$jh" "-Dtest.root=$r" "-Dtest.name=${f#"$r"/}" "-Dtest.file=$f" -Dtest.vm.opts= -Dtest.java.opts= \
    "-Dtest.class.path=$cls"
}

# the classes' digest: the SHA-256 of the sha256sum listing of the class files under DIR
classes_sha() { (cd "$1" && find . -name '*.class' | LC_ALL=C sort | xargs -r -d '\n' sha256sum) | sha256sum | cut -c1-64; }
since_t0() { echo "$((SECONDS - t0)) s"; }
first_line() { tr -d '\r' < "$1" | grep -v '^$' | head -1 | tr '\t' ' ' | cut -c1-300; }
classes_opts=(-g:none -nowarn -XDsuppressNotes -proc:none -implicit:none)
# root_cause ERR: "; caused by: C" for stderr's last "Caused by:" line, else nothing
root_cause() { local c; c=$(tr -d '\r' < "$1" | grep '^Caused by: ' | tail -1 | sed 's/^Caused by: //' | tr '\t' ' ' | cut -c1-200); [ -z "$c" ] || printf '; caused by: %s' "$c"; }
# stdout with identity hash codes masked (JCS17 (b)): an @ and 6 to 8 hex digits, as
# Object.toString writes them
mask_hashes() { sed -E 's/@[0-9a-f]{6,8}/@HASH/g'; }
# run_dirs ID: a test's working and temporary directories, the same names on the JDK's side
# (--record-ref) and Arbace's (JCS19 (b)): WORK/w/ID and WORK/tmp/ID, java.io.tmpdir and TMPDIR the
# latter, test.classes WORK/classes/ID
run_dirs() { echo "$work/w/$1 $work/tmp/$1"; }
# mask_dirs W TMP: stdout with the run's places masked before its digest and length, on both sides
# (JCS70 (a)): the test's working and temporary directories (run_dirs) W and TMP, then the scratch
# WORK and the checkout ROOT they sit under, so that a test printing them (CheckTempDir,
# UserDirChangedTest) is judged on what it computed, not on where it ran; an output naming none
# is unchanged byte for byte (its digest the reference's before JCS70)
mask_dirs() { LC_ALL=C sed -e "s|$1|W|g" -e "s|$2|TMP|g" -e "s|$work|WORK|g" -e "s|$root|ROOT|g"; }

# ---------------------------------------------------------------------------------------------
# the reference

# src_of DIR REL: a source set's file REL of a test in DIR (java.check/src-file): DIR/REL (a library's file
# too, a ../ path), or with ROOT: the checkout's (JCS331 (a): the framework runner's, test/java/runner)
src_of() { case $2 in ROOT:*) printf '%s\n' "$root/${2#ROOT:}" ;; *) printf '%s\n' "$1/$2" ;; esac; }

# src_rel DIR ABS: the source set's name of the file ABS (src_of's inverse): ROOT:REL under the checkout's
# test/java/runner, else ABS relative to DIR (a library's file under jdk26u's test/ a ../ path)
src_rel() {
  case $2 in
    "$root"/test/java/runner/*) printf 'ROOT:%s\n' "${2#"$root"/}" ;;
    *) realpath -m --relative-to="$1" "$2" ;;
  esac
}

# record_sources ID: the test's source set, javac -verbose -sourcepath DIR's parsed files; JCS330 (a), JCS331
# (a): with the plan's source roots (srcroot ABS: the test's @library directories, the framework runner's) on
# the source path after DIR, as jtreg compiles a test with its libraries, an @build class looked up in DIR and
# then in each root, and the parsed files of the roots named by src_rel
record_sources() {
  local id=$1 d=$work/record/$1 dir opts=() files=() k a b roots=() sp=. r
  dir=$(awk -F'\t' '$1=="dir"{print $2}' "$d/plan.tsv")
  grep -q '^skip' "$d/plan.tsv" && return 0
  grep -q '^kind	diagnostics' "$d/plan.tsv" && return 0 # record_diag's
  while IFS=$'\t' read -r k a b; do
    case $k in
      javac) [ "$a" = -Werror ] || opts+=("$a") ;;
      srcroot) roots+=("$a"); sp+=":$a" ;;
      compile) files+=("$a") ;;
      build|run) [ "$k" = run ] && a=$b
                 if [ -f "$dir/${a//.//}.java" ]; then files+=("${a//.//}.java")
                 else for r in ${roots[@]+"${roots[@]}"}; do [ -f "$r/${a//.//}.java" ] && { files+=("$r/${a//.//}.java"); break; }; done; fi ;;
    esac
  done < "$d/plan.tsv"
  # JOP13 (a): each file once (the plan names the main file for @compile, @build and @run alike): the JDK's javac
  # takes a file named twice once, javac on Arbace's command line (jdk.internal.jrt.javac.Main) parses it again
  # and fails on a duplicate class; the set is the same either way
  local uniq=() f2
  for f2 in "${files[@]}"; do case " ${uniq[*]+${uniq[*]}} " in *" $f2 "*) ;; *) uniq+=("$f2") ;; esac; done
  files=("${uniq[@]}")
  rm -rf "$d/s1"; mkdir -p "$d/s1"
  # JOP13 (a): JAVA_CHECK_OWN_JAVAC (bin/repr-java, bin/java-check sources) makes the set on javac on Arbace, the
  # same command line; its -verbose names every parsed file WrappedJavaFileObject[PATH] (PATH as given, or the
  # source path's element and the file's name: ./REL, ROOT/REL), each process's peak and seconds in s1.time
  local jv=(javac -J-Xmx1g)
  if [ -n "${JAVA_CHECK_OWN_JAVAC:-}" ]; then
    jv=("$JAVA_CHECK_OWN_JAVAC" javac)
    ! command -v busybox > "$d/busybox" 2>&1 || jv=(busybox time -v -o "$d/s1.time" "${jv[@]}")
    rm -f "$d/busybox"
  fi
  if (cd "$dir" && "${jv[@]}" -verbose -implicit:class -sourcepath "$sp" -d "$d/s1" -nowarn ${opts[@]+"${opts[@]}"} "${files[@]}") > "$d/s1.log" 2>&1; then
    if [ -n "${JAVA_CHECK_OWN_JAVAC:-}" ]; then
      sed -n 's|^\[parsing started WrappedJavaFileObject\[\(.*\)\]\]$|\1|p' "$d/s1.log" > "$d/parsed.txt"
      if [ ${#roots[@]} = 0 ]; then
        sed -e "s|^$dir/||" -e 's|^\./||' "$d/parsed.txt" | { grep -v '^/' || true; } | LC_ALL=C sort -u > "$d/sources.txt"
      else
        while IFS= read -r a; do case $a in /*) ;; *) a=$dir/$a ;; esac; src_rel "$dir" "$a"; done < "$d/parsed.txt" | LC_ALL=C sort -u > "$d/sources.txt"
      fi
    elif [ ${#roots[@]} = 0 ]; then
    # explicit files as SimpleFileObject[PATH], the source path's as DirectoryFileObject[.:REL]
    sed -n -e 's|^\[parsing started SimpleFileObject\[\(.*\)\]\]$|\1|p' -e 's|^\[parsing started DirectoryFileObject\[\.:\(.*\)\]\]$|\1|p' "$d/s1.log" \
      | sed -e "s|^$dir/||" -e 's|^\./||' | { grep -v '^/' || true; } | LC_ALL=C sort -u > "$d/sources.txt"
    else
    # with source roots: each parsed file made absolute (DirectoryFileObject[ROOT:REL], a SimpleFileObject's
    # path relative to DIR or absolute), then named by src_rel
    sed -n -e 's|^\[parsing started SimpleFileObject\[\(.*\)\]\]$|\1|p' -e 's|^\[parsing started DirectoryFileObject\[\(.*\):\([^:]*\)\]\]$|\1/\2|p' "$d/s1.log" \
      | while IFS= read -r a; do case $a in /*) ;; *) a=$dir/$a ;; esac; src_rel "$dir" "$a"; done | LC_ALL=C sort -u > "$d/sources.txt"
    fi
  else
    : > "$d/sources.txt"; grep -m1 'error' "$d/s1.log" | cut -c1-300 > "$d/sources.err" || true
  fi
  rm -rf "$d/s1"
}

# record_runs ID: the renamed sources compiled by the JDK's javac and each main action run twice
record_runs() {
  local id=$1 d=$work/record/$1 dir rel dst pre opts=() files=() i tmo cls k st x
  dir=$(awk -F'\t' '$1=="dir"{print $2}' "$d/plan.tsv")
  [ -s "$d/rename.tsv" ] || return 0
  grep -q '^!' "$d/rename.tsv" && return 0
  while IFS=$'\t' read -r k rel; do [ "$k" = javac ] && opts+=("$rel"); done < "$d/plan.tsv"
  local cls_dir=$work/classes/$id jexp=() o
  # JCS136 (a): the test's @modules exports (javac options --add-exports=java.base/PKG=ALL-UNNAMED) for java too
  for o in ${opts[@]+"${opts[@]}"}; do case $o in --add-exports=*) jexp+=("$o") ;; esac; done
  rm -rf "$d/src" "$cls_dir" "$d/classes-g0"; mkdir -p "$d/src" "$cls_dir" "$d/classes-g0"
  while IFS=$'\t' read -r rel dst pre; do
    mkdir -p "$(dirname "$d/src/$dst")"
    { [ "$pre" = 1 ] && printf 'package %s; ' "$id"; cat "$(src_of "$dir" "$rel")"; } > "$d/src/$dst"
    files+=("$dst")
  done < "$d/rename.tsv"
  st=0; (cd "$d/src" && javac -J-Xmx1g -nowarn -XDsuppressNotes -implicit:none -d "$cls_dir" ${opts[@]+"${opts[@]}"} "${files[@]}") > "$d/javac.log" 2>&1 || st=$?
  echo $st > "$d/javac.exit"
  [ "$st" = 0 ] || { grep -m1 'error' "$d/javac.log" | cut -c1-300 > "$d/javac.err1" || true; rm -rf "$cls_dir"; return 0; }
  # the classes level's reference: -g:none and the options bin/javac-vendor classes compiles with
  (cd "$d/src" && javac -J-Xmx1g "${classes_opts[@]}" -d "$d/classes-g0" ${opts[@]+"${opts[@]}"} "${files[@]}") > "$d/javac-g0.log" 2>&1 \
    && classes_sha "$d/classes-g0" > "$d/classes.sha"
  rm -rf "$d/classes-g0"
  : > "$work/empty"
  # the run's directories (JCS19 (b)): the working directory and the temporary one named alike
  # on both sides (run_dirs), the class files under test.classes
  local w tmp tprops=()
  read -r w tmp <<< "$(run_dirs "$id")"
  # JCS341 (a): jtreg's standard properties, test.jdk the JDK's home (the plan's path, relative to its root's place)
  mapfile -t tprops <<< "$(jtreg_props "$JAVA_CHECK_JDK" "$(awk -F'\t' '$1=="root"{print $3}' "$d/plan.tsv")" \
                                       "$(awk -F'\t' '$1=="path"{print $2}' "$d/plan.tsv")" "$cls_dir")"
  while IFS=$'\t' read -r -a x; do
    i=${x[0]}; cls=${x[2]}
    # JCS335 (a): the run's system properties (props.tsv: I, then each -Dk=v), before the class as jtreg gives them
    local jprops=() pl
    if [ -s "$d/props.tsv" ]; then pl=$(awk -F'\t' -v i="$i" '$1 == i' "$d/props.tsv"); [ -z "$pl" ] || { IFS=$'\t' read -r -a jprops <<< "$pl"; jprops=("${jprops[@]:1}"); }; fi
    for k in "" 2; do
      rm -rf "$w" "$tmp"; mkdir -p "$w" "$tmp"
      st=0; (cd "$w" && TMPDIR=$tmp timeout -k 5 "$(jdk_run_limit "${x[1]}")" java -Xmx2g ${jexp[@]+"${jexp[@]}"} -cp "$cls_dir" -Dtest.src="$dir" -Dtest.classes="$cls_dir" \
               "${tprops[@]}" -Djava.io.tmpdir="$tmp" ${jprops[@]+"${jprops[@]}"} "$cls" "${x[@]:3}" < "$work/empty" > "$d/out" 2> "$d/err") || st=$?
      echo $st > "$d/run$i.exit$k"
      # the run's directories masked (JCS70 (a)); a mark when they were in stdout
      mask_dirs "$w" "$tmp" < "$d/out" > "$d/out.m"
      cmp -s "$d/out" "$d/out.m" || echo 1 > "$d/run$i.dirs$k"
      sha256sum < "$d/out.m" | cut -c1-64 > "$d/run$i.out$k"
      # identity hash codes masked (JCS17 (b))
      mask_hashes < "$d/out.m" | sha256sum | cut -c1-64 > "$d/run$i.masked$k"
      # stderr's first line (the JDK's failure reason) with the run's places masked as stdout is (JCS84 (a))
      if [ -z "$k" ]; then stat -c %s "$d/out.m" > "$d/run$i.len"; first_line "$d/err" | mask_dirs "$w" "$tmp" > "$d/run$i.err1"; fi
    done
  done < "$d/runs.tsv"
  rm -rf "$w" "$tmp" "$cls_dir" "$d/out" "$d/out.m" "$d/err"
}

record_ref() {
  local jobs=8 only="" t0=$SECONDS
  while [ $# -gt 0 ]; do
    case $1 in
      --jobs) jobs=$2; shift 2 ;;
      --only) only=$2; shift 2 ;;
      *) echo "java-check --record-ref: unknown option $1" >&2; return 2 ;;
    esac
  done
  check_pin
  . "$root/bin/lib/java26.bash"; arbace_use_java26 || return 1
  command -v javac > "$work.javac" 2>&1 && command -v java > "$work.java" 2>&1 || { echo "java-check --record-ref: no JDK (javac, java) on PATH" >&2; return 1; }
  # CSP5 (doc/CROPS-SCORE.md): the JDK's home in a message is ${JDK} in the reference (test/java/check.ae's clean)
  JAVA_CHECK_JDK=$(cd "$(dirname "$(command -v java)")/.." && pwd -P); export JAVA_CHECK_JDK
  rm -rf "$work/record" "$work/w" "$work/tmp" "$work/classes"; mkdir -p "$work"
  echo "== java-check: scan ($jdktest)" >&2
  jc scan "$jdktest" "$corpora" "$ref" "$work" > "$work/scan.txt"
  head -1 "$work/scan.txt"
  local list=$work/record.list
  if [ -n "$only" ]; then
    # JCV12 (b): REGEX finds a plan by its text (the test's path) or by its id ("ID " as the check's --only
    # sees "ID TEST"), and a selection that plans no test fails
    { (cd "$work/record" && grep -lE "$only" */plan.tsv | cut -d/ -f1) || true
      sed 's/$/ /' "$list" | grep -E "$only" | sed 's/ $//' || true; } | sort -u > "$list.only"
    grep -Fx -f "$list.only" "$list" > "$list.o" || true; mv "$list.o" "$list"
    [ -s "$list" ] || { echo "java-check --record-ref: --only '$only' plans no test (it is matched against each plan's text and each test's id)" >&2; return 1; }
  fi
  echo "== java-check: the source sets of $(wc -l < "$list") tests (javac -verbose -sourcepath), $jobs at a time" >&2
  export -f src_of src_rel record_sources record_runs jtreg_props jdk_run_limit classes_sha first_line mask_hashes mask_dirs run_dirs
  export root work classes_opts_s="${classes_opts[*]}"
  xargs -a "$list" -P "$jobs" -I{} bash -c 'record_sources "$1"' _ {}
  jc rename "$work" > "$work/rename.txt"
  echo "== java-check: the JDK's javac and runs, twice ($((SECONDS - t0)) s)" >&2
  xargs -a "$list" -P "$jobs" -I{} bash -c 'classes_opts=($classes_opts_s); record_runs "$1"' _ {}
  echo "== java-check: the golden-diagnostics tests by the JDK's javac ($((SECONDS - t0)) s)" >&2
  export -f record_diag diag_actions diag_root diag_norm diag_first_diff diag_golden
  : > "$work/empty"
  xargs -a "$list" -P "$jobs" -I{} bash -c 'record_diag "$1"' _ {}
  cp "$ref" "$work/ref-before.edn"
  jc gather "$work" "$ref" "$corpora"
  jc gather-diag "$work" "$ref"
  # a partial run (--only) changes no line but its plans' (JCS68 (a))
  [ -z "$only" ] || jc ref-unchanged "$work" "$work/ref-before.edn" "$ref"
  echo "java-check --record-ref: $((SECONDS - t0)) s"
}

# own_sources (JOP13 (a), taken overnight round 52; doc/classes/JAVA-FRONTEND-SURVEY.md, "As built: JOP13 (a)"):
# the source sets as Arbace's own record, test/java/sources.edn: the corpora scanned (java.check/scan, the
# reference's plans), each planned test's set made by record_sources on javac on Arbace (bin/repr-java javac on
# javac's tool executable, REPR_JAVA_EXE; GOMEMLIMIT JAVA_CHECK_SOURCES_MEM, default 1GiB), placed by rename and
# compared with the JDK's (test/java/ref-jdk26.edn's :files); --record writes the rows (the other tests' kept);
# --check alone: the oracle tier's comparison of the two records (no javac), --complete a test without a row fails
own_sources() {
  local jobs=4 only="" listf="" record="" check="" complete="" scan_dir="" t0=$SECONDS exe plat=build
  while [ $# -gt 0 ]; do
    case $1 in
      --jobs) jobs=$2; shift 2 ;;
      --only) only=$2; shift 2 ;;
      --list) listf=$2; shift 2 ;;
      --record) record=1; shift ;;
      --check) check=1; shift ;;
      --complete) complete=--complete; shift ;;
      --scan) scan_dir=$2; shift 2 ;;
      *) echo "java-check sources: unknown option $1" >&2; return 2 ;;
    esac
  done
  if [ -n "$check" ]; then jc sources-check "$ref" "$root/test/java/sources.edn" ${complete:+"$complete"}; return; fi
  check_pin
  exe=${REPR_JAVA_EXE:-$root/target/arbace-go/amd64/arbace-javac}
  [ -x "$exe" ] || { echo "java-check sources: no javac tool executable $exe (REPR_JAVA_EXE)" >&2; return 1; }
  ! grep -qx '# kind: own' "$root/jdk/javac/platform.sha256" || plat=own
  local sw=$work/sources
  rm -rf "$sw/record"; mkdir -p "$sw"
  if [ -n "$scan_dir" ]; then
    # a scan of the same checkout made before (its record/*/plan.tsv and record.list), copied
    cp -r "$scan_dir/record" "$scan_dir/record.list" "$scan_dir/scan.tsv" "$sw/"
    find "$sw/record" -mindepth 2 ! -name plan.tsv -delete
  else
    echo "== java-check sources: scan ($jdktest)" >&2
    jc scan "$jdktest" "$corpora" "$ref" "$sw" > "$sw/scan.txt"; head -1 "$sw/scan.txt"
  fi
  local list=$sw/record.list
  if [ -n "$listf" ]; then grep -v '^#' "$listf" | awk '{print $1}' > "$list.ids"; grep -Fx -f "$list.ids" "$list" > "$list.o" || true; mv "$list.o" "$list"; fi
  if [ -n "$only" ]; then
    { (cd "$sw/record" && grep -lE "$only" */plan.tsv | cut -d/ -f1) || true
      sed 's/$/ /' "$list" | grep -E "$only" | sed 's/ $//' || true; } | sort -u > "$list.only"
    grep -Fx -f "$list.only" "$list" > "$list.o" || true; mv "$list.o" "$list"
  fi
  [ -s "$list" ] || { echo "java-check sources: no test planned" >&2; return 1; }
  echo "== java-check sources: $(wc -l < "$list") tests by javac on Arbace ($exe), $jobs at a time" >&2
  export -f src_of src_rel record_sources
  export root REPR_JAVA_EXE=$exe JAVA_CHECK_OWN_JAVAC=$root/bin/repr-java GOMEMLIMIT=${JAVA_CHECK_SOURCES_MEM:-1GiB}
  work=$sw xargs -a "$list" -P "$jobs" -I{} bash -c 'record_sources "$1"' _ {}
  jc rename "$sw" > "$sw/rename.txt"
  # each javac's peak (kB) and seconds, from busybox time
  for i in $(cat "$list"); do f=$sw/record/$i/s1.time; [ -f "$f" ] || continue
    printf '%s\t%s\t%s\n' "$i" "$(sed -n 's/.*Maximum resident set size (kbytes): //p' "$f")" "$(sed -n 's/.*Elapsed (wall clock) time (h:mm:ss or m:ss): //p' "$f")"
  done > "$sw/mem.tsv"
  [ ! -s "$sw/mem.tsv" ] || echo "java-check sources: javac on Arbace's peak $(cut -f2 "$sw/mem.tsv" | sort -n | tail -1) kB (of $(wc -l < "$sw/mem.tsv") runs, $sw/mem.tsv)"
  jc own-sources "$sw" "$ref" "$root/test/java/sources.edn" --platform "$plat" ${record:+--record 1}
  echo "java-check sources: $((SECONDS - t0)) s"
}

# ---------------------------------------------------------------------------------------------
# the diagnostics level (JC3, doc/classes/JAVA-CONFORMANCE-SURVEY.md, "As built: JC3"): langtools'
# golden-diagnostics tests (compile-fail-ref) run as jtreg runs them, in place (not renamed: the
# golden files name the tests' files and classes), by the JDK's javac for the reference and by
# javac on Arbace for the check

# diag_root DIR: the test's jtreg root (the nearest directory at or above DIR holding TEST.ROOT)
diag_root() { local r=$1; while [ "$r" != / ] && [ ! -f "$r/TEST.ROOT" ]; do r=$(dirname "$r"); done; echo "$r"; }

# diag_norm IN OUT: javac's output as jtreg compares it with a golden file, line by line: each
# line's trailing white space (and a CR) dropped
diag_norm() { awk '{ sub(/[ \t\r]+$/, ""); print }' "$1" > "$2"; }

# diag_first_diff A B: the first line where A (javac's output) and B (the golden file) differ
diag_first_diff() {
  awk 'FILENAME == ARGV[1] { a[FNR] = $0; na = FNR; next } { b[FNR] = $0; nb = FNR }
       END { n = (na > nb ? na : nb)
             for (i = 1; i <= n; i++) if (!(i in a) || !(i in b) || a[i] != b[i]) {
               printf "line %d: %s (the golden file: %s)", i, (i in a ? substr(a[i], 1, 160) : "nothing"), (i in b ? substr(b[i], 1, 160) : "nothing"); exit } }' "$1" "$2" | tr '\t' ' '
}

# diag_golden OUT GOLDEN PREFIX: javac's normalized output OUT against the golden file GOLDEN as jtreg
# compares them: PREFIX.golden 1 when they are equal line by line (GOLDEN normalized), else 0 and PREFIX.diff
# (the first difference, or no golden file)
diag_golden() {
  local o=$1 g=$2 x=$3
  if [ -f "$g" ]; then
    diag_norm "$g" "$x.gold"
    if cmp -s "$o" "$x.gold"; then echo 1 > "$x.golden"
    else echo 0 > "$x.golden"; diag_first_diff "$o" "$x.gold" > "$x.diff"; fi
    rm -f "$x.gold"
  else
    echo 0 > "$x.golden"; echo "no golden file $(basename "$g")" > "$x.diff"
  fi
}

# diag_actions DIR PLAN OUT JAVAC...: the test's @build and @compile actions (PLAN's act lines) in
# order, by the javac command JAVAC..., in DIR, as jtreg runs them: -d OUT/classes (one directory for
# every action), -sourcepath DIR and the @library directories, -classpath the classes; @modules as
# --add-exports (a package) or --add-modules, @enablePreview as --enable-preview --source 26; jtreg's
# substitutions ${test.src}, ${test.classes}, ${jdk.version}; /process as -proc:only. Per action I:
# OUT/dI.exit, the output normalized (dI.out, diag_norm) with its digest (dI.sha) and length (dI.len),
# its first line (dI.err1), and for a ref=F action dI.golden (1 when it equals F, else 0 and dI.diff)
diag_actions() {
  local dir=$1 plan=$2 out=$3; shift 3
  local cls=$out/classes troot sp k a m x i kind modes toks t f c files opts extra=() st ref
  troot=$(diag_root "$dir"); sp=$dir
  rm -rf "$cls"; mkdir -p "$cls"
  while IFS=$'\t' read -r k a; do
    case $k in
      library) case $a in /*) sp+=":$troot$a" ;; *) sp+=":$dir/$a" ;; esac ;;
      modules) m=${a%%:*}; case $m in */*) extra+=(--add-exports "$m=ALL-UNNAMED") ;; *) extra+=(--add-modules "$m") ;; esac ;;
      preview) extra+=(--enable-preview --source 26) ;;
    esac
  done < "$plan"
  while IFS=$'\t' read -r -a x; do
    [ "${x[0]}" = act ] || continue
    i=${x[1]} kind=${x[2]} modes=${x[3]} toks=("${x[@]:4}")
    for t in "${!toks[@]}"; do
      toks[$t]=${toks[$t]//'${test.src}'/$dir}
      toks[$t]=${toks[$t]//'${test.classes}'/$cls}
      toks[$t]=${toks[$t]//'${jdk.version}'/26}
    done
    st=0
    if [ "$kind" = build ]; then
      # @build: the classes' files found on the source path, compiled
      files=()
      for c in ${toks[@]+"${toks[@]}"}; do
        for f in ${sp//:/ }; do [ -f "$f/${c//.//}.java" ] && { files+=("$f/${c//.//}.java"); break; }; done
      done
      : > "$out/d$i.raw"
      [ ${#files[@]} = 0 ] || (cd "$dir" && "$@" ${extra[@]+"${extra[@]}"} -d "$cls" -sourcepath "$sp" -classpath "$cls" "${files[@]}") \
        < "$work/empty" > "$out/d$i.raw" 2>&1 || st=$?
    else
      opts=()
      case /$modes/ in */process/*) opts+=(-proc:only) ;; esac
      (cd "$dir" && "$@" ${extra[@]+"${extra[@]}"} -d "$cls" -sourcepath "$sp" -classpath "$cls" ${opts[@]+"${opts[@]}"} ${toks[@]+"${toks[@]}"}) \
        < "$work/empty" > "$out/d$i.raw" 2>&1 || st=$?
    fi
    echo "$st" > "$out/d$i.exit"
    diag_norm "$out/d$i.raw" "$out/d$i.out"
    sha256sum < "$out/d$i.out" | cut -c1-16 > "$out/d$i.sha"
    stat -c %s "$out/d$i.out" > "$out/d$i.len"
    first_line "$out/d$i.out" > "$out/d$i.err1"
    ref=$(printf '%s\n' "${modes//\//$'\n'}" | sed -n 's/^ref=//p')
    rm -f "$out/d$i.golden" "$out/d$i.diff"
    [ -z "$ref" ] || diag_golden "$out/d$i.out" "$dir/$ref" "$out/d$i"
    rm -f "$out/d$i.raw"
  done < "$plan"
  rm -rf "$cls"
}

# record_diag ID: a golden-diagnostics test's actions by the JDK's javac
record_diag() {
  local d=$work/record/$1 dir
  grep -q '^kind	diagnostics' "$d/plan.tsv" || return 0
  grep -q '^skip' "$d/plan.tsv" && return 0
  dir=$(awk -F'\t' '$1=="dir"{print $2}' "$d/plan.tsv")
  diag_actions "$dir" "$d/plan.tsv" "$d" javac -J-Xmx1g
}

# check_diag ID: a golden-diagnostics test's actions by javac on Arbace (bin/repr-java javac): pass
# when each action's status is the JDK javac's and each ref= action's output the golden file, as the
# JDK javac's is; fail (a status differs) or differ (an output) otherwise
check_diag() {
  local id=$1 p=$work/run/$1 dir k i e g st c gold res
  dir=$jdktest/$(awk -F'\t' '$1=="dir"{print $2}' "$p/plan.tsv")
  diag_actions "$dir" "$p/plan.tsv" "$p" "$root/bin/repr-java" javac
  awk -F'\t' '$1 == "exp"' "$p/plan.tsv" > "$p/exp.tsv"
  res=$(diag_judge "$p" "" "$p/exp.tsv")
  # GTS84 (a), test/java/controls.edn: the controls whose subject this test is (plan lines control-diag CID
  # EXIT GOLDEN, their reference's first golden action): this run's actions up to its first golden one judged
  # again by diag_judge, that action's output against the reference's golden file (diag_golden) and its status
  # against the reference's, under the control's id
  while IFS=$'\t' read -r k c e gold; do
    [ "$k" = control-diag ] || continue
    i=$(awk -F'\t' '$4 == 1 { print $2; exit }' "$p/exp.tsv")
    [ -n "$i" ] || continue
    awk -F'\t' -v OFS='\t' -v i="$i" -v e="$e" '$2 + 0 > i + 0 { exit } $2 == i { $3 = e } { print }' "$p/exp.tsv" > "$p/exp.$c.tsv"
    diag_golden "$p/d$i.out" "$jdktest/$gold" "$p/d$i.$c"
    printf '%s\tdiagnostics\t%s\n' "$c" "$(diag_judge "$p" ".$c" "$p/exp.$c.tsv")" | sed -e "s|$p|RUN|g" -e "s|$root|.|g" -e "s|$jdktest/||g"
  done < "$p/plan.tsv"
  printf '%s\tdiagnostics\t%s\n' "$id" "$res" | sed -e "s|$p|RUN|g" -e "s|$root|.|g" -e "s|$jdktest/||g"
}

# diag_judge P SUF EXP: the diagnostics level's judgment of the run in P (diag_actions' files) against the
# expectations EXP (exp I EXIT GOLDEN lines): each action's status (dI.exit) the expected one and each golden
# action's comparison with its golden file (dI.golden, a control's dI.SUF.golden: diag_golden) equal;
# prints RESULT<TAB>REASON (pass, fail: a status, differ: an output), the compiler's crash named
diag_judge() {
  local p=$1 suf=$2 k i e g st res=""
  while IFS=$'\t' read -r k i e g; do
    [ "$k" = exp ] || continue
    st=$(cat "$p/d$i.exit")
    if [ "$st" != "$e" ]; then
      res="fail	action $i: status $st (the JDK's $e): $(cat "$p/d$i.err1")"; break
    elif [ "$g" = 1 ] && [ "$(cat "$p/d$i$suf.golden")" != 1 ]; then
      res="differ	action $i: the output differs from the golden file, $(cat "$p/d$i$suf.diff")"; break
    fi
  done < "$3"
  # a crash of the compiler: its exception named in the reason
  if [ -n "$res" ] && grep -q '^An exception has occurred in the compiler' "$p/d$i.out"; then
    res="$res; the compiler's crash: $(grep -m1 -E '^[A-Za-z0-9_.$]+(Exception|Error)' "$p/d$i.out" | tr '\t' ' ' | cut -c1-200)"
  fi
  printf '%s\n' "${res:-pass	}"
}

# ---------------------------------------------------------------------------------------------
# the check

# cover_setup (GT8.3, GTS206 (a)): under ARBACE_COVER_DIR, cover_rexe the cover build's executable at the checkout's
# key (bin/lib/cover.bash; the interp level's), exported; rexe stays the
# gate's, which hosts j2g
cover_setup() {
  [ -n "${ARBACE_COVER_DIR:-}" ] || return 0
  cover_rexe=$(cover_exe "$root") || return 1
  export cover_rexe
  echo "java-check: coverage into $ARBACE_COVER_DIR (the interp level on $cover_rexe)" >&2
}

# cover_flags PROG WORK DIR: cflags, bin/build-go's cover arguments for the compiled level's program PROG
# printed into WORK (bin/lib/cover.bash's cover_go_flags), empty without ARBACE_COVER_DIR
cover_flags() {
  cflags=()
  [ -n "${ARBACE_COVER_DIR:-}" ] || return 0
  local f
  cover_go_flags "$root" "$1" "$2" "$(program_overlay)" "$3/cover-overlay.json" > "$3/cover-flags.txt" || return 1
  while IFS= read -r f; do cflags+=("$f"); done < "$3/cover-flags.txt"
}

# F6 (doc/classes/JAVA-DEFERRED-TRIAGE.md, "As built: F6", JCS95 (c)): the interp level's tool tests, whose
# sources name javac's API, which javac's tool executable holds and the shipped program does not: tool_re
# the names (a source line that is no comment line), tool_exe the tool (REPR_JAVA_EXE, else bin/repr-java's
# default; none: the tests run on run_exe's executable as before, said once), tool_platform the platform its
# system compiler attributes against (jdk.internal.jrt.javac.SystemCompiler's property, as bin/javac-vendor's
# generate step sets it), bin/repr-java's
# java-design-1123 (the user's decision of 2026-11-23: XML in javac's tool world): the tests naming java.xml's parsers,
# transform, XPath, validation, StAX and catalog, DOM and SAX, or java.xml.crypto's XML signature, run where javac's world
# holds them too, the tool at interp and javac-world shards at compiled (not javax.xml.datatype, XMLConstants or QName:
# the shipped world's since java-design-1122)
tool_re='(com\.sun\.tools\.javac|com\.sun\.source|javax\.tools|javax\.lang\.model|javax\.annotation\.processing)\.|java\.util\.spi\.ToolProvider|javax\.xml\.(parsers|transform|xpath|validation|stream|crypto|catalog)\b|(^|[^.[:alnum:]])org\.(w3c\.dom|xml\.sax)\b'
tool_exe() {
  local e
  . "$root/bin/lib/host.bash"
  e=${REPR_JAVA_EXE:-$root/target/arbace-go/$(arbace_host_arch)/arbace-javac}
  if [ -x "$e" ]; then echo "$e"; else echo "java-check: no javac tool executable $e: the tests naming javac's API run on the executable (F6)" >&2; fi
}
# tool_test (run_actions' p and dir): does a source file of the test name javac's API
tool_test() {
  local k rel dst pre
  while IFS=$'\t' read -r k rel dst pre; do
    [ "$k" = file ] || continue
    grep -vE '^[[:space:]]*(\*|//|/\*)' "$(src_of "$dir" "$rel")" 2>/dev/null | grep -qE "$tool_re" && return 0
  done < "$p/plan.tsv"
  return 1
}

# JCS300 (c) (doc/classes/JAVA-DEFERRED-TRIAGE.md, "As built: JCS300 (c)"): the tests that read their own
# class files, from test.classes (jtreg's @compile output) or as resources (Class.getResource(AsStream) of
# "X.class"): cf_re the names, a source line that is no comment line naming java.lang.classfile or
# test.classes (57 tests of the corpora at the pin); their sources compiled by javac on Arbace (bin/repr-java
# javac, the tool) as record_runs' JDK javac compiles them for the JDK's run (-nowarn -XDsuppressNotes
# -implicit:none, the test's javac options) into WORK/classes/ID, test.classes on both sides, the directory
# on ARBACE_PATH after the forms (run_actions) so that ClassPathResources finds the class files as the JDK's
# class path does; at interp and compiled
cf_re='java\.lang\.classfile|test\.classes'
# classes_test (check_one's p and dir): does a source file of the test name java.lang.classfile or test.classes
classes_test() {
  local k rel dst pre
  while IFS=$'\t' read -r k rel dst pre; do
    [ "$k" = file ] || continue
    grep -vE '^[[:space:]]*(\*|//|/\*)' "$(src_of "$dir" "$rel")" 2>&1 | grep -qE "$cf_re" && return 0
  done < "$p/plan.tsv"
  return 1
}
# test_classes ID: the test's class files (JCS300 (c)): WORK/classes/ID made afresh from P/src (check_one's p,
# opts and files) by javac on Arbace; its log P/test-classes.log, a failure said there and on stderr, the
# directory then left empty (the test runs as before, on null bytes)
test_classes() {
  local id=$1 cls=$work/classes/$1 st=0
  rm -rf "$cls"; mkdir -p "$cls"
  (cd "$p/src" && "$root/bin/repr-java" javac -nowarn -XDsuppressNotes -implicit:none -d "$cls" ${opts[@]+"${opts[@]}"} "${files[@]}") > "$p/test-classes.log" 2>&1 || st=$?
  if [ "$st" != 0 ]; then
    echo "java-check: $id: javac on Arbace did not compile the test's classes (JCS300 (c), status $st): $(grep -m1 -E 'error|release' "$p/test-classes.log" | tr '\t' ' ' | cut -c1-200)" >&2
    rm -rf "$cls"; mkdir -p "$cls"
  fi
  echo "$cls" > "$p/classes.dir"
}

# run_exe: the executable that interprets and hosts j2g: JAVA_CHECK_EXE (the gate's), else the gate's build
# at the checkout's key, else ARBACE_GATE_CACHE's or a --build's, which nothing compares with the checkout
# (report 003's finding 8): named so
run_exe() {
  local e g
  [ -n "${JAVA_CHECK_EXE:-}" ] && [ -x "$JAVA_CHECK_EXE" ] && { echo "$JAVA_CHECK_EXE"; return 0; }
  # the gate's build at the checkout's key (ARBACE_GATE_EXES/KEY20; ARBACE_GATE_CACHE overrides)
  g=$(arbace_gate_cache "$root") || g=
  for e in "$g/amd64/arbace" "$root/target/arbace-go/amd64/arbace"; do
    if [ "$e" != /amd64/arbace ] && [ -x "$e" ]; then
      { [ "$e" = "$g/amd64/arbace" ] && [ -z "${ARBACE_GATE_CACHE:-}" ]; } \
        || echo "java-check: the executable $e (built $(date -u -r "$e" '+%Y-%m-%d %H:%M UTC')), not checked against the checkout (JAVA_CHECK_EXE names one)" >&2
      echo "$e"; return 0
    fi
  done
  echo "java-check: no executable (JAVA_CHECK_EXE, bin/arbace-go --gate-build or --build)" >&2; return 1
}

# read_finished LOG: bin/repr-java read's LOG shows a read that finished (its summary line, "N Java
# files, N converted, ...", or a file's FAILED line): its failure is the sources', cached by their key;
# one that did not finish (a crash, Go's out of memory, the tool missing) is not (report 003's finding 6)
read_finished() { grep -qE '^[0-9]+ Java files, [0-9]+ converted, |^FAILED ' "$1"; }

# cache_slot CACHE KEY: the path of KEY's entry in a cache of reads (CACHE/KK/KEY, KK the key's first two
# characters), its shard made. The caches were flat until night 13 (2026-11-13): the read level's shared
# cache, .tmp/java-check/forms, reached 208,010 entries (52,000 keys, four files each) and ext4 without
# large_dir caps a directory's htree at two levels, so creating some names failed with ENOSPC ("index full,
# reach max htree level", dmesg) with the disk at 82 %: java-forms-verify's t03224 and the levels' reads
# cache_take CACHE KEY SLOT: under SLOT's lock, a flat entry of KEY (the old layout) moved into SLOT
cache_slot() { mkdir -p "$1/${2:0:2}"; echo "$1/${2:0:2}/$2"; } # the path even when mkdir fails: its errors then name the cache, not the cwd
cache_take() {
  local x
  [ -e "$1/$2.result" ] || [ -e "$1/$2.unfinished" ] || [ -e "$1/$2" ] || return 0
  for x in "" .result .unfinished .log; do
    if [ -e "$1/$2$x" ] && [ ! -e "$3$x" ]; then mv "$1/$2$x" "$3$x"; else rm -rf "$1/$2$x"; fi
  done
  rm -f "$1/$2.lock"
}

# read_opts: repr/java's read options: --line-numbers (the forms' Java lines, :java/line, and source
# files, :java/source: the interpreter's and the compiled programs' stack traces, java-stack-1124), then
# javac's options (the source level, the encoding, the exports and -parameters, which the forms record;
# the rest change javac's output, not the forms)
read_opts() {
  local o next=""
  echo "--line-numbers"
  for o in "$@"; do
    case $next in
      keep) echo "--javac"; echo "$o"; next=""; continue ;;
      drop) next=""; continue ;;
      encoding)
        # the reader reads UTF-8: -encoding utf-8 (or its alias utf8, as javac's command line on
        # Arbace takes it) is left out, which javac's API would hand its file manager, serving no
        # -encoding (invalid flag; TextBlockLang, t05973); another encoding kept, and refused
        case $(printf '%s' "$o" | tr 'A-Z' 'a-z') in utf-8|utf8) ;; *) echo "--javac"; echo "-encoding"; echo "--javac"; echo "$o" ;; esac
        next=""; continue ;;
    esac
    case $o in
      -source) echo "--javac"; echo "$o"; next=keep ;;
      -encoding) next=encoding ;;
      --release|-target) next=drop ;;
      --add-exports=*) echo "--javac"; echo "$o" ;; # JCS136 (a): the test's @modules exports
      -parameters) echo "--javac"; echo "$o" ;; # queue 563: the forms record MethodParameters' names (:parameters)
    esac
  done
}

# judge ST OUT ERR: an action's status and stdout against the reference's (x, the action's plan
# line: run I EXIT OUT LEN DET MASKED DET-MASKED MAIN ARG...); prints RESULT<TAB>REASON, nothing
# when it passes: the status, and stdout's digest and length when the JDK's two runs agreed
# (JCS3 (a)); stdout with identity hash codes masked when the plain digest differs, or alone when
# only the masked runs agreed (JCS17 (b)); stdout always with the run's directories masked
# (mask_dirs, run_actions' w and tmp: JCS70 (a)), as the reference's
judge() {
  local st=$1 out=$2 err=$3 sha len msha want
  if [ "$st" = 124 ] || [ "$st" = 137 ] || [ "$st" = 152 ]; then printf 'timeout\t%s s\n' "${lim:-$timeout}"; return 0; fi
  # the reason: stderr's first line, and its root cause when it has one (the last "Caused by:"
  # line: an ExceptionInInitializerError's, a wrapping RuntimeException's), so that the classes
  # take the cause (JC6, the catch-alls named)
  if [ "$st" != "${x[2]}" ]; then printf 'fail\tstatus %s (the JDK'"'"'s %s): %s%s\n' "$st" "${x[2]}" "$(first_line "$err")" "$(root_cause "$err")"; return 0; fi
  [ "${x[5]}" = 1 ] || [ "${x[7]}" = 1 ] || return 0
  mask_dirs "$w" "$tmp" < "$out" > "$out.m"; mv "$out.m" "$out"
  sha=$(sha256sum < "$out" | cut -c1-16); len=$(stat -c %s "$out")
  [ "${x[5]}" = 1 ] && [ "$sha" = "${x[3]}" ] && [ "$len" = "${x[4]}" ] && return 0
  msha=$(mask_hashes < "$out" | sha256sum | cut -c1-16)
  want=${x[6]}; [ "$want" = - ] && want=${x[3]}
  [ "$msha" = "$want" ] && return 0
  printf 'differ\tstdout differs (%s bytes, the JDK'"'"'s %s): %s\n' "$len" "${x[4]}" "$(head -c 2000 "$out" | tr '\t\n' '  ' | cut -c1-120)"
}

# judge_own STATUS ERR [WANT]: the test's own verdict (JCV1, doc/classes/JAVA-CONFORMANCE-SURVEY.md, "Decided (the
# user, 2026-11-07)"): jtreg's main action, passing when main returns normally (status 0, WANT pass) and failing
# when it throws or exits otherwise; status 97, run.ae's, main returned but another thread's exception went
# uncaught (jtreg's MainThreadGroup): a failure. WANT fail (a control's, the verdict inverted as jtreg's
# main/fail): passing when the status is not 0. Stdout is not looked at (the JDK's recorded stdout, the oracle
# tier's: judge). RESULT<TAB>REASON, nothing when it passes
judge_own() {
  local st=$1 err=$2 want=${3:-pass}
  if [ "$st" = 124 ] || [ "$st" = 137 ] || [ "$st" = 152 ]; then printf 'timeout\t%s s\n' "${lim:-$timeout}"; return 0; fi
  if [ "$want" = fail ]; then
    [ "$st" != 0 ] || printf 'fail\tstatus 0 (expected a failure: the verdict inverted, a control)\n'
    return 0
  fi
  if [ "$st" = 97 ]; then printf 'fail\tan uncaught exception in another thread (jtreg'"'"'s rule): %s\n' "$(grep -m1 '^java-check: uncaught: ' "$err" | sed 's/^java-check: uncaught: //' | tr '\t' ' ' | cut -c1-300)"; return 0; fi
  # JCS342 (a): an uncaught jtreg.SkippedException (jdk.test.lib's: the test cannot run here) is jtreg's skip, as on the JDK's side
  if [ "$st" != 0 ] && first_line "$err" | grep -qE '^Exception in thread "[^"]*" jtreg\.SkippedException\b'; then
    printf 'skip\t%s\n' "$(first_line "$err" | sed -E 's/^Exception in thread "[^"]*" //')"; return 0
  fi
  if [ "$st" != 0 ]; then printf 'fail\tstatus %s (expected 0): %s%s\n' "$st" "$(first_line "$err")" "$(root_cause "$err")"; return 0; fi
}

# judge_golden STATUS OUT ERR GOLDEN: the test's own verdict for a program that ships its expected stdout (JCV2,
# doc/classes/JAVA-CONFORMANCE-SURVEY.md, "As built: JCV2": Arbace's own JLS programs, test/java/jls/NAME.out,
# reviewed line by line against the JLS in test/java/jls/golden.edn): judge_own's status (0, jtreg's rule for the
# other threads' 97 a failure), then stdout (its run's directories masked, as judge masks them) equal to the golden
# file byte for byte (its identity hash codes masked too when the golden file holds @HASH, queue 451); a differ names the first line that differs (diag_first_diff). The JDK's recorded stdout is
# not looked at (the oracle tier's: judge). RESULT<TAB>REASON, nothing when it passes
judge_golden() {
  local st=$1 out=$2 err=$3 gold=$4 r
  r=$(judge_own "$st" "$err")
  if [ -n "$r" ]; then printf '%s\n' "$r"; return 0; fi
  if [ ! -f "$gold" ]; then printf 'fail\tno golden file %s\n' "${gold#"$root"/}"; return 0; fi
  # judge-rest (2026-11-20): a golden file with @TESTSRC (the test's source directory, jtreg's test.src, which the test prints:
  # where the jdk26u checkout lies, not what the test computed) is compared with stdout's test.src masked first, before the run's
  # directories (mask_dirs), as JCS70 (a) masks those; any other golden file as before
  if grep -qF '@TESTSRC' "$gold"; then LC_ALL=C sed -e "s|$dir|@TESTSRC|g" < "$out" | mask_dirs "$w" "$tmp" > "$out.g"
  else mask_dirs "$w" "$tmp" < "$out" > "$out.g"; fi
  # queue 451 (D451-1): a golden file with @HASH (identity hash codes, Object.toString's, reviewed :masked in
  # test/java/golden/AREA.edn) is compared with stdout's identity hash codes masked (mask_hashes), as the JDK's
  # record's :out-masked; any other golden file byte for byte, unmasked
  if grep -qF '@HASH' "$gold"; then mask_hashes < "$out.g" > "$out.h" && mv "$out.h" "$out.g"; fi
  if ! cmp -s "$out.g" "$gold"; then
    printf 'differ\tstdout differs from the golden file %s (%s bytes, the golden file'"'"'s %s): %s\n' "$(basename "$gold")" \
      "$(stat -c %s "$out.g")" "$(stat -c %s "$gold")" "$(diag_first_diff "$out.g" "$gold" | cut -c1-300)"
  fi
  rm -f "$out.g"
}

# test_limit NAME: the seconds a test's actions run under (limited's TMO; GTS102, redone after the
# audits): its line in test/java/timeouts.txt (JTREG-NAME SECONDS, read by limit.bash's program_tmo as
# goi's test/goi/timeouts.txt) when it is above the check's (--timeout, default 20), else the check's;
# times tmo_scale (--essential-compiled's quiet retry: 2). A missing file or a line that is no number
# leaves the check's
test_limit() {
  local t=$timeout f=$root/test/java/timeouts.txt
  [ -f "$f" ] && t=$(program_tmo "$1" "$timeout" "$f")
  case $t in ''|*[!0-9]*) t=$timeout ;; esac
  [ "$t" -gt "$timeout" ] || t=$timeout
  echo $((t * ${tmo_scale:-1}))
}

# test_wall NAME (the user's decision of 2026-11-22, java-design-1122's JD6): whether the test's line in
# test/java/timeouts.txt is "JTREG-NAME SECONDS wall": its limit then the wall clock's SECONDS (limited_cpu with no CPU
# limit) and not limited's 5 x SECONDS of CPU, for a test whose CPU time is its busy threads times a fixed wall time
# (MessageDigest's ThreadSafetyTest: 8 threads hashing for 26 rounds of 2 s)
test_wall() {
  local f=$root/test/java/timeouts.txt
  [ -f "$f" ] && awk -v p="$1" '$1 == p && $3 == "wall" { w = 1 } END { exit !w }' "$f"
}

# plan_bad RUN (queue 485, 477-3): when the test's plan RUN/plan.tsv cannot be trusted, prints why and returns 0;
# returns 1 when it is whole: present, its last line end (java.check's write-plan writes it last, the file renamed
# into place) and, but for a golden-diagnostics test, a run line. A plan missing or cut (another java-check that
# removed WORK/run under this one, a run killed while it planned) is an error of every row it covers, never a pass:
# a run without its plan read no action, and an empty result counted as a pass (104 rows of 477's second run)
plan_bad() {
  local f=$1/plan.tsv
  if [ ! -f "$f" ]; then echo "no plan: $f is missing (WORK/run removed under the run: another java-check in the same WORK?)"; return 0; fi
  if [ "$(tail -n 1 "$f")" != end ]; then echo "the plan $f is partial (no end line)"; return 0; fi
  grep -q '^kind	diagnostics' "$f" && return 1
  grep -q '^run	' "$f" || { echo "the plan $f has no run line"; return 0; }
  return 1
}

# interp_cpus ID: the CPUs an interpreted run of test ID may use (queue 612, the user's 612-1 (b), 2026-11-27), as a
# comma list for taskset, or nothing for no cap. Tests whose work the processor count decides (DoubleAdderDemo's and
# LongAdderDemo's NCPU/2 threads, ForkJoinPool's default parallelism) do 9 times the work on a 64-processor host
# as on 8: the interp level caps Runtime.availableProcessors at JAVA_CHECK_INTERP_CPUS (default 8; 0 no cap) by
# the run's CPU affinity, which jrt's availableProcessors reads (Go's runtime.NumCPU: sched_getaffinity at start),
# so the executable needs no change. The window of CPUs is taken from the allowed ones, moved along by the test's
# number so that concurrent jobs spread over the host. No cap when the host allows no more (a missing taskset: the run refuses, above)
interp_cpus() {
  local k=${JAVA_CHECK_INTERP_CPUS:-8} n i off out="" c
  local -a all=()
  [ "$k" -gt 0 ] 2>/dev/null && command -v taskset > /dev/null || return 0
  mapfile -t all < <(awk '/^Cpus_allowed_list:/ { n = split($2, r, ","); for (i = 1; i <= n; i++) { m = split(r[i], ab, "-");
    lo = ab[1]; hi = (m > 1) ? ab[2] : ab[1]; for (c = lo; c <= hi; c++) print c } }' /proc/self/status)
  n=${#all[@]}
  [ "$n" -gt "$k" ] || return 0
  off=$(( (10#${1#t} * k) % n ))
  for ((i = 0; i < k; i++)); do c=${all[$(( (off + i) % n ))]}; out=${out:+$out,}$c; done
  echo "$out"
}

# run_actions LEVEL EXE LOAD FORMS: each main action of the test (id, p, dir: check_one's) run by
# EXE's test/java/run.ae, its classes defined from FORMS as LOAD says (do, files: the interpreter;
# none: the program's own, compiled), in the run's directories (run_dirs, JCS19 (b)), judged;
# prints ID<TAB>LEVEL<TAB>RESULT<TAB>REASON, the first action not passing its result; each action
# under the test's limit (test_limit: its line in test/java/timeouts.txt, GTS102)
run_actions() {
  local level=$1 exe=$2 mode=$3 fdir=$4 res="" i st w tmp lim st0="" res0="" cres n tmo vk gold ores="" ojr jst pl why nrun=0 ended=""
  local -a x c props=() props0=() pa=()
  # queue 485: no plan, no pass (plan_bad); the loop below checks again that it read the runs and the end line
  if why=$(plan_bad "$p"); then
    printf '%s\t%s\terror\t%s\n' "$id" "$level" "$why" | sed -e "s|$root|.|g"
    return 0
  fi
  # F6: a tool test interpreted on javac's tool, its system compiler against the platform
  if [ "$level" = interp ] && [ -n "${texe:-}" ] && tool_test; then
    exe=$texe props0=(-Djdk.internal.jrt.javac.platform="$tplatform")
  elif [ "$level" = compiled ] && [ -n "${tplatform:-}" ] && tool_test; then
    # JD4 (a): its program holds javac's world (compiled_shard's javac shard), the platform as on the tool
    props0=(-Djdk.internal.jrt.javac.platform="$tplatform")
  fi
  # JCV1: whose verdict judges the test (java.check/plan's verdict line, test/java/verdicts.edn): status, the
  # test's own (judge_own; the JDK's record judged too, the oracle tier's row LEVEL.jdk when it says otherwise),
  # or stdout, the JDK's record (judge), as before; JCV2: golden, the test's own golden file (the plan's golden
  # line; judge_golden), the JDK's record the oracle tier's as for status
  vk=$(awk -F'\t' '$1 == "verdict" { print $2; exit }' "$p/plan.tsv")
  gold=$(awk -F'\t' '$1 == "golden" { print $2; exit }' "$p/plan.tsv")
  # GT8.3, GTS206 (a): under ARBACE_COVER_DIR the interp level runs the cover build's executable (cover_rexe), the
  # compiled level its programs built with the cover flags, each test with its GOCOVERDIR, ARBACE_COVER_DIR/java-LEVEL/ID
  [ -z "${ARBACE_COVER_DIR:-}" ] || [ "$level" != interp ] || exe=$cover_rexe
  read -r w tmp <<< "$(run_dirs "$id")"
  tmo=$(test_limit "$(awk -F'\t' '$1 == "test" { print $2; exit }' "$p/plan.tsv")")
  # a wall-clock limit (test_wall): the attempts' limits as wall seconds, no CPU limit
  local lcmd=(limited)
  test_wall "$(awk -F'\t' '$1 == "test" { print $2; exit }' "$p/plan.tsv")" && lcmd=(limited_cpu unlimited)
  # 612-1 (b): the interpreted runs' processors capped (interp_cpus), taskset between the limit and the executable
  local pin=() cpus
  if [ "$level" = interp ] && declare -F interp_cpus > /dev/null; then cpus=$(interp_cpus "$id"); [ -z "$cpus" ] || pin=(taskset -c "$cpus"); fi
  # JCS341 (a): jtreg's standard properties (jtreg_props), test.jdk WORK/no-jdk: no JDK on Arbace's side
  local tprops=() tbase=$jdktest
  [ "$(awk -F'\t' '$1=="root"{print $2}' "$p/plan.tsv")" != checkout ] || tbase=$root
  mapfile -t tprops <<< "$(jtreg_props "$work/no-jdk" "$tbase" "$(awk -F'\t' '$1 == "test" { print $2; exit }' "$p/plan.tsv")" "$work/classes/$id")"
  while [ -z "$res" ] && IFS=$'\t' read -r -a x; do
    [ "${x[0]}" = end ] && ended=1
    [ "${x[0]}" = run ] || continue
    i=${x[1]} nrun=$((nrun + 1))
    # JCS335 (a): the action's system properties (the plan's props line of run I), given to run.ae as -Dk=v
    props=(${props0[@]+"${props0[@]}"})
    pl=$(awk -F'\t' -v i="$i" '$1 == "props" && $2 == i' "$p/plan.tsv")
    [ -z "$pl" ] || { IFS=$'\t' read -r -a pa <<< "$pl"; props+=("${pa[@]:2}"); }
    # a timeout is run again once at twice the limit before it counts (JCS47 (a): the host's load
    # moved the tests near the limit between runs)
    n=0
    for lim in $(attempt_limits "$tmo" "${JAVA_CHECK_ONCE:-}"); do
      n=$((n + 1))
      rm -rf "$w" "$tmp"; mkdir -p "$w" "$tmp"
      # arbace.spec.skip-macros (java-tail2-1126; JAVA_TOOL_OPTIONS' -D, read at the runtime's start as the JVM reads it):
      # run.ae's and the test's ns forms are not checked against arbace.core.specs, whose loading (arbace.spec.alpha's
      # UUID.randomUUID: a SecureRandom) would load the security providers before main, as no JVM the JDK's runs start
      # does (a provider's state then fixed before the test sets its properties: StrongSeedReader's java.security.egd, t08235)
      st=0; (cd "$w" && export TMPDIR="$tmp" JAVA_TOOL_OPTIONS="-Darbace.spec.skip-macros=true${JAVA_TOOL_OPTIONS:+ $JAVA_TOOL_OPTIONS}" \
               && { [ -z "$fdir" ] || export ARBACE_PATH=$fdir; } \
               && { [ ! -f "$p/classes.dir" ] || export ARBACE_PATH=${ARBACE_PATH:+$ARBACE_PATH:}$(cat "$p/classes.dir"); } \
               && { [ -z "${ARBACE_COVER_DIR:-}" ] || export $(cover_env "java-$level" "$id"); } && "${lcmd[@]}" "$lim" ${pin[@]+"${pin[@]}"} "$exe" "$root/test/java/run.ae" --load "$mode" "${fdir:--}" "${x[8]}" \
               -Dtest.src="$dir" -Dtest.classes="$work/classes/$id" "${tprops[@]}" -Djava.io.tmpdir="$tmp" ${props[@]+"${props[@]}"} -- "${x[@]:9}" \
               < "$work/empty" > "$p/out$i" 2> "$p/err$i") || st=$?
      ojr=""
      if [ "$st" = 126 ] && grep -q '^java-check: load-failed: ' "$p/err$i"; then
        res="load-failed	$(grep -m1 '^java-check: load-failed: ' "$p/err$i" | sed 's/^java-check: load-failed: //' | tr '\t' ' ' | cut -c1-400)"
        ojr=$res
      else
        # the JDK's record (the launcher's status: run.ae's 97 is a 0 there)
        jst=$st; [ "$st" != 97 ] || jst=0
        ojr=$(judge "$jst" "$p/out$i" "$p/err$i")
        case $vk in
          status) res=$(judge_own "$st" "$p/err$i") ;;
          golden) res=$(judge_golden "$st" "$p/out$i" "$p/err$i" "$root/$gold") ;;
          *) res=$ojr ;;
        esac
      fi
      note_attempt java-check "$id" "$n" "$lim" "$st" "$res"
      cover_settle "java-$level" "$id"
      case $res in timeout*) ;; *) break ;; esac
    done
    if [ -n "${JAVA_CHECK_ONCE:-}" ]; then case $res in timeout*) res="timeout	$tmo s" ;; esac
    else case $res in timeout*) res="timeout	$tmo s, then $((tmo * 2)) s" ;; esac; fi
    [ "$i" = 0 ] && { st0=$st; res0=$res; }
    [ -n "$res" ] && [ "$i" != 0 ] && res="${res%%	*}	action $i: ${res#*	}"
    # the oracle's first action not passing (a timeout's limits as the test's)
    if [ -z "$ores" ] && [ -n "$ojr" ]; then
      case $ojr in
        timeout*|load-failed*) ores=$res ;; # the run's own (its limits, its action named)
        *) ores=$ojr; [ "$i" = 0 ] || ores="${ores%%	*}	action $i: ${ores#*	}" ;;
      esac
    fi
  done < "$p/plan.tsv"
  # queue 485: a pass is a plan read to its end line with a run line in it (a plan removed or cut while the
  # test ran is an error, never the empty result that counts as a pass)
  if [ -z "$res" ] && { [ "$nrun" = 0 ] || [ -z "$ended" ]; }; then
    res="error	the plan $p/plan.tsv was cut while the test ran (${nrun} run lines read, $( [ -n "$ended" ] && echo "its end line read" || echo "no end line"))"
    ores=$res
  fi
  # GTS81 (a), test/java/controls.edn: the controls whose subject this test is (plan lines control CID
  # EXIT OUT LEN DET MASKED DET-MASKED, their reference's first action): its first action's run judged
  # again by judge, against the reference's status and stdout; printed under the control's id. JCV2:
  # control-golden CID GOLDEN, its first action's run judged again by judge_golden against another
  # program's golden file
  if [ -n "$st0" ]; then
    while IFS=$'\t' read -r -a c; do
      [ "${c[0]}" = control ] || [ "${c[0]}" = control-own ] || [ "${c[0]}" = control-golden ] || continue
      case $res0 in
        load-failed*|timeout*) cres=$res0 ;;
        *) case ${c[0]} in
             control-own) cres=$(judge_own "$st0" "$p/err0" fail) ;;
             control-golden) cres=$(judge_golden "$st0" "$p/out0" "$p/err0" "$root/${c[2]}") ;;
             *) cres=$(x=(run 0 "${c[@]:2:6}"); judge "$st0" "$p/out0" "$p/err0") ;;
           esac ;;
      esac
      printf '%s\t%s\t%s\n' "${c[1]}" "$level" "${cres:-pass	}" | sed -e "s|$w|W|g" -e "s|$tmp|TMP|g" ${fdir:+-e "s|$fdir|FORMS|g"} \
        -e "s|$p|RUN|g" -e "s|$root|.|g" -e "s|$jdktest/||g"
    done < "$p/plan.tsv"
  fi
  # the reason without this run's places (the recorded results name no checkout)
  printf '%s\t%s\t%s\n' "$id" "$level" "${res:-pass	}" | sed -e "s|$w|W|g" -e "s|$tmp|TMP|g" ${fdir:+-e "s|$fdir|FORMS|g"} \
    -e "s|$p|RUN|g" -e "s|$root|.|g" -e "s|$jdktest/||g"
  # JCV1: the oracle tier's judgment (the JDK's record) when it says otherwise, as the row LEVEL.jdk
  if [ "${ores:-pass	}" != "${res:-pass	}" ]; then
    printf '%s\t%s.jdk\t%s\n' "$id" "$level" "${ores:-pass	}" | sed -e "s|$w|W|g" -e "s|$tmp|TMP|g" ${fdir:+-e "s|$fdir|FORMS|g"} \
      -e "s|$p|RUN|g" -e "s|$root|.|g" -e "s|$jdktest/||g"
  fi
  rm -rf "$w" "$tmp"
}

# again LEVEL RESULTS RUNNER: JCS71 (a): each would-be regression of RESULTS (a test of LEVEL not
# passing that test/java/check-LEVEL.edn records :pass or :flaky) run again once by RUNNER (an
# exported function taking the test's id and printing its result line, as check_one's); a test
# whose second run passes is reported flaky (its first result and reason kept in the reason), which
# java.check's report takes as no regression when a :flaky class of test/java/divergences.edn
# names it, and as a test in no class otherwise; a test failing again keeps its first result
again() {
  local level=$1 res=$2 runner=$3 ids=$2.again
  [ -s "$res" ] || return 0
  sed -n 's/^ \["\(t[0-9]*\)" "[^"]*" :\(pass\|flaky\) .*/\1/p' "$root/test/java/check-$level.edn" > "$ids.rec"
  awk -F'\t' -v l="$level" '$2 == l && $3 != "pass" { print $1 }' "$res" | { grep -Fx -f "$ids.rec" || true; } > "$ids"
  if [ -s "$ids" ]; then
    echo "== java-check $level: $(wc -l < "$ids") would-be regressions run again (JCS71 (a)): $(tr '\n' ' ' < "$ids")" >&2
    xargs -a "$ids" -P "$jobs" -I{} bash -c "$runner"' "$1"' _ {} > "$ids.tsv"
    # (FILENAME, not NR == FNR: an empty rerun file must not take the results for its own, report
    # 003's finding 3; a test without a rerun line keeps its first result)
    awk -F'\t' -v l="$level" 'FILENAME == ARGV[1] { if ($2 == l && $3 == "pass") ok[$1] = 1; next }
      $2 == l && ($1 in ok) { print $1 "\t" $2 "\tflaky\t" $3 " " $4 "; passed when run again (JCS71 (a))"; next } { print }' \
      "$ids.tsv" "$res" > "$res.a" && mv "$res.a" "$res"
    awk -F'\t' -v l="$level" '$2 == l && $3 == "flaky" { print "java-check " l ": flaky: " $1 " " $4 }' "$res" >&2
  fi
  rm -f "$ids" "$ids.rec" "$ids.tsv"
}

# interp_one ID: the test's interp level again (again's runner: check_one's forms, run_actions)
interp_one() {
  local id=$1 p=$work/run/$1 dir
  dir=$(test_dir "$p")
  run_actions interp "$rexe" "$load" "$(cat "$p/forms.dir")"
}

# test_dir RUN: the test's directory: under jdk26u's test/, or the checkout's (Arbace's own corpus)
test_dir() {
  case $(awk -F'\t' '$1=="root"{print $2}' "$1/plan.tsv") in
    checkout) echo "$root/$(awk -F'\t' '$1=="dir"{print $2}' "$1/plan.tsv")" ;;
    *) echo "$jdktest/$(awk -F'\t' '$1=="dir"{print $2}' "$1/plan.tsv")" ;;
  esac
}

# compiled_one ID EXE: the test's main actions run on the program EXE that holds its classes (the
# compiled level, JC2)
compiled_one() {
  local id=$1 p=$work/run/$1 dir
  dir=$(test_dir "$p")
  run_actions compiled "$2" none ""
}

# compiled_one_on EXE ID: compiled_one with its arguments in again's order
compiled_one_on() { compiled_one "$2" "$1" | sed -e "s|$root|.|g"; }

# compiled_shard K DIR: the tests of shard K (DIR/tests.txt, java.check/shards: WORK/j2g/sK, or a
# half of a split one, run_shard) translated by
# j2g into one program (--program: every public member of the tests' classes a root, every main
# among them; the shipped build's compiled namespaces as the test build takes them, without goi's
# table unless JAVA_CHECK_GOTABLE names one, as diffcheck's program), refused tests taken out and the rest translated again until j2g refuses none (a refusal
# is its test's result, never the shard's: survey §7.2), then built by bin/build-go, a test whose
# Go does not compile taken out likewise (go build -gcflags=-e, every error of package lang), and
# each test's actions run on the program; the program and its trees removed after the runs. Prints
# the results (ID compiled RESULT REASON) into DIR/results.tsv. It runs with errexit off (run_shard
# calls it on the left of ||), so each step's failure is tested: a shard whose eighth round still
# refused tests (no program for the rest) fails, run_shard gives its tests error (report 003's
# finding 2)
# prog_arch: the architecture of the compiled level's programs, the host's (they run here: an arm64 host
# has no amd64 to run them on, queue 471); prog_goarch_env: go build's GOARCH and its level for it
prog_arch() { case $(uname -m) in aarch64) echo arm64 ;; *) echo amd64 ;; esac; }
prog_goarch_env() { if [ "$(prog_arch)" = arm64 ]; then echo GOARCH=arm64 GOARM64=v8.0; else echo GOARCH=amd64 GOAMD64=v1; fi; }

# javac_tests: the tests of WORK/run.list whose source files name javac's API (tool_test), into WORK/javac.list: JD4 (a)
# (the user's decision of 2026-11-22, java-design-1122) puts them into shards of their own (java.check/shards), each one
# compiled program with javac's world as javac's tool is built (bin/arbace-go --build-java's j2g inputs: jdk/javac/forms,
# overlay/jdk/javac/variants, both edges), cached by key (javac_shard_key)
javac_tests() {
  local id p dir
  : > "$work/javac.list"
  while read -r id; do
    p=$work/run/$id
    [ -f "$p/plan.tsv" ] || continue
    dir=$(test_dir "$p")
    tool_test && echo "$id"
  done < "$work/run.list" > "$work/javac.list"
}

# javac_shard_key DIR: the key of a javac shard's program: javac's world as j2g takes it (the files of compiled_shard's jargs),
# the compiled namespaces (AOT.key, the runtime's key with Arbace's sources, j2g's among them), the executable that runs j2g
# and the shard's tests' forms (each run directory's forms.key, else, read from the committed forms, the digest of its forms'
# files), so that the program is built once while they hold (only the files j2g reads: the gate's audit holds the step to them)
javac_shard_key() {
  local id fk
  { (cd "$root" && find jdk/javac/forms overlay/jdk/javac/variants -type f | LC_ALL=C sort; echo jdk/edge.edn; echo jdk/javac/edge.edn) |
      (cd "$root" && xargs -d '\n' sha256sum)
    cat "$aot.key" 2>/dev/null; sha256sum < "$rexe"; echo "--"
    while read -r id; do
      fk=$(cat "$work/run/$id/forms.key" 2>/dev/null) ||
        fk=$(cd "$(cat "$work/run/$id/forms.dir")" && find . -type f | LC_ALL=C sort | xargs -d '\n' sha256sum | sha256sum | cut -c1-24)
      printf '%s %s\n' "$id" "$fk"
    done < "$1/tests.txt"; } | sha256sum | cut -c1-40
}

compiled_shard() {
  local k=$1 s=$2 round st n overlay jargs=() jkey="" jc_dir=""
  overlay=$(program_overlay) || return 1
  : > "$s/refused.tsv"
  if [ -f "$s/javac" ]; then
    jargs=(--input "$root/jdk/javac/forms" --variants "$root/overlay/jdk/javac/variants"
           --edge "$root/jdk/edge.edn" --edge "$root/jdk/javac/edge.edn")
    jkey=$(javac_shard_key "$s")
    jc_dir=${JAVA_CHECK_JAVAC_CACHE:-$root/.tmp/java-check/javac-prog}/$jkey
    if [ -x "$jc_dir/prog" ] && [ -f "$jc_dir/built.txt" ]; then
      echo "== java-check compiled: shard $k (javac's world): the program of key ${jkey:0:12} ($jc_dir)" >&2
      cp "$jc_dir/refused.tsv" "$s/refused.tsv"; cp "$jc_dir/built.txt" "$s/built.txt"; cp "$jc_dir/prog" "$s/prog"
    fi
  fi
  for round in 1 2 3 4 5 6 7 8; do
    [ -x "$s/prog" ] && break
    jc merge "$work" "$s" > "$s/merge.log" || { cat "$s/merge.log"; return 1; }
    [ -s "$s/built.txt" ] || break
    echo "== java-check compiled: shard $k, round $round: j2g, $(wc -l < "$s/built.txt") tests ($(since_t0))" >&2
    rm -rf "$s/out" "$s/work" "$s/prog"
    st=0; program_heavy=$heavy program_j2g "$rexe" "$s/j2g$round.log" "$s/out" --input "$s/forms" --input "$aot" ${gotable:+--gotable "$gotable"} \
      ${jargs[@]+"${jargs[@]}"} || st=$?
    if [ ! -f "$s/out/report.edn" ]; then
      # j2g died (no report: the host's memory, JCS48): status 3, the caller splits the shard
      tail -20 "$s/j2g$round.log" >&2; echo "java-check compiled: shard $k: j2g failed ($s/j2g$round.log)" >&2; return 3
    fi
    jc refusals "$work" "$s" > "$s/refusals$round.log"; cat "$s/refusals$round.log" >&2
    n=$(sed -n 's/^java-check refused: \([0-9]*\) tests.*/\1/p' "$s/refusals$round.log")
    [ "${n:-0}" = 0 ] || continue
    [ "$st" = 0 ] || { echo "java-check compiled: shard $k: j2g's errors not attributed to a test ($s/j2g$round.log)" >&2; return 1; }
    echo "== java-check compiled: shard $k, round $round: bin/build-go ($(since_t0))" >&2
    cover_flags "$s/out/prog" "$s/work" "$s" || return 1
    st=0; program_heavy=$heavy program_build_go "$rexe" "$(prog_arch)" "$s/work" "$s/prog" "$s/build$round.log" "$s/out/prog" ${cflags[@]+"${cflags[@]}"} || st=$?
    [ "$st" = 0 ] && break
    # every Go error of the package lang: the tests whose Go does not compile
    (cd "$s/work/mod" && env GOROOT="$goroot" GOTOOLCHAIN=local GOFLAGS= GOWORK=off GO111MODULE=on GOPROXY=off GOEXPERIMENT= \
       CGO_ENABLED=0 GOOS=linux $(prog_goarch_env) "$goroot/bin/go" build -trimpath -buildvcs=false -overlay "$overlay" \
       -gcflags=arbace/lang=-e -o "$s/prog.x" arbace/cmd/arbace) > "$s/goerrs$round.log" 2>&1 || true
    rm -f "$s/prog.x"
    jc goerrors "$work" "$s" "$s/goerrs$round.log" > "$s/goerrors$round.log"; cat "$s/goerrors$round.log" >&2
    n=$(sed -n 's/^java-check refused: \([0-9]*\) tests.*/\1/p' "$s/goerrors$round.log")
    [ "${n:-0}" != 0 ] || { grep -v '^==' "$s/build$round.log" | tail -20 >&2; echo "java-check compiled: shard $k: the build failed, no test to blame ($s/build$round.log)" >&2; return 1; }
  done
  if [ -s "$s/built.txt" ] && [ ! -x "$s/prog" ]; then
    echo "java-check compiled: shard $k: j2g still refused tests in round $round, no program for the other $(wc -l < "$s/built.txt") ($s/refusals$round.log)" >&2
    return 1
  fi
  rm -rf "$s/out" "$s/work"
  # a javac shard's program kept by its key (JD4 (a)), with its refusals and the tests it holds
  if [ -n "$jc_dir" ] && [ -x "$s/prog" ] && [ ! -x "$jc_dir/prog" ]; then
    mkdir -p "$jc_dir.new" && cp "$s/prog" "$s/refused.tsv" "$s/built.txt" "$jc_dir.new/" && rm -rf "$jc_dir" && mv "$jc_dir.new" "$jc_dir"
  fi
  {
    awk -F'\t' '{print $1 "\tcompiled\trefused\t" $2}' "$s/refused.tsv"
    if [ -x "$s/prog" ]; then
      echo "== java-check compiled: shard $k: the runs of $(wc -l < "$s/built.txt") tests ($(since_t0))" >&2
      xargs -a "$s/built.txt" -P "$jobs" -I{} bash -c 'compiled_one "$1" "$2"' _ {} "$s/prog"
    fi
  } | sed -e "s|$root|.|g" > "$s/results.tsv"
  # a would-be regression run again once on the program, before it goes (JCS71 (a))
  [ -x "$s/prog" ] && again compiled "$s/results.tsv" "compiled_one_on $s/prog"
  rm -rf "$s/prog" "$s/forms"
}

# analyze_shard K DIR: --analyze-only's shard (JCS265 (b), J2G-SPEC §4.1, "The analysis alone"): the
# tests of DIR/tests.txt merged as compiled_shard merges them, j2g's world loaded and analyzed over
# jdk/forms (JRT_CONV) and their forms alone (bin/j2g --analyze-only on the executable; no program, no
# runtime's forms, no compiled namespaces: a test names none of them), within 2 GiB for 30 tests (with
# --shard-size 30); j2g's analysis failures attributed as the compiled level's refusals are
# (java.check/refusals); a test refused, the others "analyzed" (none of their classes refused: what a
# translation and a build would meet after it is not measured). DIR/results.tsv; DIR/out/report.edn
# kept. Status 3 when j2g died (run_shard splits the shard)
analyze_shard() {
  local k=$1 s=$2 st=0
  : > "$s/refused.tsv"
  jc merge "$work" "$s" > "$s/merge.log" || { cat "$s/merge.log"; return 1; }
  if [ ! -s "$s/built.txt" ]; then : > "$s/results.tsv"; return 0; fi
  echo "== java-check compiled --analyze-only: shard $k: j2g's analysis, $(wc -l < "$s/built.txt") tests ($(since_t0))" >&2
  rm -rf "$s/out"
  (cd "$root" && J2G_GO_EXE=$rexe bin/j2g --analyze-only --jdk "${JRT_CONV:-jdk/forms}" --input "$s/forms" --out "$s/out") > "$s/j2g1.log" 2>&1 || st=$?
  if [ ! -f "$s/out/report.edn" ]; then
    tail -20 "$s/j2g1.log" >&2; echo "java-check compiled --analyze-only: shard $k: j2g failed ($s/j2g1.log)" >&2; return 3
  fi
  jc refusals "$work" "$s" > "$s/refusals1.log"; cat "$s/refusals1.log" >&2
  {
    awk -F'\t' '{print $1 "\tcompiled\trefused\t" $2}' "$s/refused.tsv"
    awk -F'\t' 'FILENAME == ARGV[1] { r[$1] = 1; next } !($1 in r) { print $1 "\tcompiled\tanalyzed\tj2g'"'"'s analysis refused none of its classes (--analyze-only)" }' "$s/refused.tsv" "$s/built.txt"
  } | sed -e "s|$root|.|g" > "$s/results.tsv"
  rm -rf "$s/forms"
}

# run_shard K DIR: shard K (DIR/tests.txt) by compiled_shard, its results in DIR/results.tsv; a
# shard whose j2g dies (compiled_shard's status 3) split in two halves (DIR/h1, DIR/h2) and each
# run again likewise (JCS48 (b)), down to JAVA_CHECK_SPLIT_MIN tests (default 25); a shard that
# fails otherwise (a j2g or build failure no test is blamed for) gives its tests the result error:
# the other shards go on, the report fails on them (no class takes error)
run_shard() {
  local k=$1 d=$2 st=0 n h
  rm -f "$d/results.tsv"; rm -rf "$d/h1" "$d/h2"
  "${shard_fn:-compiled_shard}" "$k" "$d" || st=$?
  [ "$st" = 0 ] && return 0
  n=$(wc -l < "$d/tests.txt")
  if [ "$st" = 3 ] && [ "$n" -gt "${JAVA_CHECK_SPLIT_MIN:-25}" ]; then
    echo "== java-check compiled: shard $k: j2g died, split in two ($n tests)" >&2
    rm -rf "$d/out" "$d/work" "$d/prog" "$d/forms"
    mkdir -p "$d/h1" "$d/h2"
    [ ! -f "$d/javac" ] || { cp "$d/javac" "$d/h1/javac"; cp "$d/javac" "$d/h2/javac"; }
    head -n $((n / 2)) "$d/tests.txt" > "$d/h1/tests.txt"
    tail -n +$((n / 2 + 1)) "$d/tests.txt" > "$d/h2/tests.txt"
    for h in 1 2; do run_shard "$k.$h" "$d/h$h"; done
    cat "$d/h1/results.tsv" "$d/h2/results.tsv" > "$d/results.tsv"
    return 0
  fi
  awk -F'\t' '{print $1 "\tcompiled\terror\tthe shard failed (" FILENAME ")"}' "$d/tests.txt" | sed -e "s|$root|.|g" > "$d/results.tsv"
}

# java_check_base: sets aot, the compiled namespaces the compiled level's j2g runs take: JAVA_CHECK_AOT
# when set (an explicit override), else the base of bin/arbace-go --build-program (bin/lib/program.bash's
# program_base, RPS161 (b)): ARBACE_PROGRAM_BASE, target/arbace-go, the gate's cache, stage 0's, the
# first of the checkout's key and runtime, else stage 0's compiled again, else a --build
java_check_base() {
  if [ -n "${JAVA_CHECK_AOT:-}" ]; then aot=$JAVA_CHECK_AOT; return 0; fi
  local base_exe base_aot
  dir=$root/target/arbace-go programs=$dir/programs
  mkdir -p "$programs" "$TMPDIR"
  discard=$TMPDIR/arbace-go.discard
  since() { echo "$(( $(date +%s) - $1 )) s"; }
  build() { (cd "$root" && ARBACE_GO_ARCHES=${arches:-amd64} bin/arbace-go --build) >&2; }
  program_base >&2 || return 1
  aot=$base_aot
}

# aot_fresh: the compiled namespaces' tree was made from the checkout's runtime (JCS46 (a)):
# arbace_runtime_key (bin/lib/version.bash) against the tree's, read from AOT.runtime beside AOT.key
# (bin/arbace-go writes it, JCS76 (a)), else, for a tree made before it, from the runtime of the
# executable bin/arbace-go --build made with it (AOT/../amd64/arbace's *arbace-version* :runtime;
# aot.key hashes the runtime's key with Arbace's sources, so it cannot be read back). j2g's own
# sources and the namespaces' are not the runtime's: a tree of other ones serves (the tests'
# programs do not call the compiled j2g). JAVA_CHECK_AOT_STALE_OK=1 warns instead of refusing
aot_fresh() {
  local want have="" src=""
  . "$root/bin/lib/version.bash"
  want=$(arbace_runtime_key "$root")
  # AOT.runtime (JCS76 (a)), else the build's executable beside the tree: a --build's
  # DIR/amd64/arbace, or the gate's build's ARBACE_GATE_EXES/KEY20/amd64/arbace beside its aot/
  for src in "$(dirname "$aot")/amd64/arbace" "$(dirname "$aot")/arbace" ""; do [ -x "$src" ] && break; done
  if [ -f "$aot.runtime" ]; then
    src=$aot.runtime
    have=$(cat "$aot.runtime")
  elif [ -n "$src" ]; then
    have=$(env -u ARBACE_NO_AOT "$src" -e '(print (:runtime *arbace-version*))' 2> "$work/aot-runtime.err") || have=""
  fi
  [ "${have:-}" = "$want" ] && return 0
  if [ "${JAVA_CHECK_AOT_STALE_OK:-}" = 1 ]; then
    echo "java-check compiled: warning: the compiled namespaces $aot are not of the checkout's runtime (${have:-unknown}${src:+, $src}; the checkout's $want); used anyway (JAVA_CHECK_AOT_STALE_OK=1)" >&2
    return 0
  fi
  echo "java-check compiled: the compiled namespaces $aot are not of the checkout's runtime (its key ${have:-unknown}${src:+, from $src}; the checkout's $want)" >&2
  echo "java-check compiled: build them: bin/arbace-go --build (or JAVA_CHECK_AOT names a tree of this runtime; JAVA_CHECK_AOT_STALE_OK=1 to use it anyway)" >&2
  return 1
}

# compiled_level: the compiled level of the tests WORK/run.list holds (their read level passed),
# in shards of SHARD_SIZE tests (--shard-size), one after another (a j2g run takes up to 20 GiB);
# their results appended to WORK/results.tsv; unread tests 'unread'. check calls it on the left of
# ||, so errexit is off here and in what it calls: java.check's shards failing or a shard without
# results fails it (report 003's finding 2)
compiled_level() {
  gotable=${JAVA_CHECK_GOTABLE:-} heavy=${JAVA_CHECK_HEAVY:-}
  if [ -n "${analyze_only:-}" ]; then
    # JCS265 (b): no program, so no compiled namespaces and no Go toolchain
    shard_fn=analyze_shard
    [ -n "$shard_only" ] || rm -rf "$work/j2g"
    mkdir -p "$work/j2g"
    javac_tests
  jc shards "$work" "$shard_size" >&2 || { echo "java-check compiled: java.check's shards failed" >&2; return 1; }
    local s
    for s in $(cd "$work/j2g" && ls -d s* | sed 's/^s//' | sort -n); do
      if [ -z "$shard_only" ] || [[ ",$shard_only," == *",$s,"* ]]; then
        run_shard "$s" "$work/j2g/s$s"
      fi
      [ -f "$work/j2g/s$s/results.tsv" ] || { echo "java-check compiled: shard $s has no results ($work/j2g/s$s)" >&2; return 1; }
      cat "$work/j2g/s$s/results.tsv"
    done
    return 0
  fi
  shard_fn=compiled_shard
  java_check_base || return 1
  goroot=${ARBACE_GOROOT:-/root/tamago-go}
  [ -f "$aot/packages.edn" ] || { echo "java-check compiled: no compiled namespaces $aot (bin/arbace-go --build, or JAVA_CHECK_AOT)" >&2; return 1; }
  [ -z "$gotable" ] || [ -d "$gotable" ] || { echo "java-check compiled: no goi table $gotable (JAVA_CHECK_GOTABLE)" >&2; return 1; }
  aot_fresh || return 1
  # --shard K: that shard again, the others' results kept (the same plan makes the same shards)
  [ -n "$shard_only" ] || rm -rf "$work/j2g"
  mkdir -p "$work/j2g"
  javac_tests
  jc shards "$work" "$shard_size" >&2 || { echo "java-check compiled: java.check's shards failed" >&2; return 1; }
  local s
  for s in $(cd "$work/j2g" && ls -d s* | sed 's/^s//' | sort -n); do
    if [ -z "$shard_only" ] || [[ ",$shard_only," == *",$s,"* ]]; then
      run_shard "$s" "$work/j2g/s$s"
    fi
    [ -f "$work/j2g/s$s/results.tsv" ] || { echo "java-check compiled: shard $s has no results ($work/j2g/s$s)" >&2; return 1; }
    cat "$work/j2g/s$s/results.tsv"
  done
  # the golden-diagnostics tests (the diagnostics level's, JC3) have no compiled level
  local why
  while read -r id; do
    # queue 485: a test whose plan is missing or cut: an error, unless a shard's results hold its row (run_actions')
    if why=$(plan_bad "$work/run/$id"); then
      cat "$work"/j2g/s*/results.tsv 2>/dev/null | grep -q "^$id	" || printf '%s\tcompiled\terror\t%s\n' "$id" "$why" | sed -e "s|$root|.|g"
      continue
    fi
    grep -q '^kind	diagnostics' "$work/run/$id/plan.tsv" && continue
    [ -f "$work/run/$id/forms.dir" ] || printf '%s\tcompiled\tunread\tthe read failed\n' "$id"
  done < "$work/run.list"
}

# classes_verdict SHA WANT: the classes level's judgment, the class files' digest against the JDK javac's:
# RESULT<TAB>REASON
classes_verdict() {
  if [ "$1" = "$2" ]; then printf 'pass\t'
  else printf 'differ\tthe class files differ from the JDK javac'"'"'s'; fi
}

# check_one ID: the test's levels; prints ID<TAB>LEVEL<TAB>RESULT<TAB>REASON per level
check_one() {
  local id=$1 p=$work/run/$1 dir rel dst pre k x forms key st reason r i tmo opts=() files=() res why l
  # queue 485: a plan missing or cut is an error at each of check_one's levels of the run (compiled and print:
  # their own, compiled_level and print_level), never a pass
  if why=$(plan_bad "$p"); then
    for l in read nread interp classes diagnostics; do
      case ",$levels," in *,$l,*) printf '%s\t%s\terror\t%s\n' "$id" "$l" "$why" | sed -e "s|$root|.|g" ;; esac
    done
    return 0
  fi
  grep -q '^kind	diagnostics' "$p/plan.tsv" && { check_diag "$id"; return; } # the diagnostics level's
  dir=$(test_dir "$p")
  while IFS=$'\t' read -r k rel; do [ "$k" = javac ] && opts+=("$rel"); done < "$p/plan.tsv"
  if [ -n "$from_committed" ]; then
    forms=$root/test/java/forms/$id
    echo "$forms" > "$p/forms.dir"
  else
    rm -rf "$p/src"; mkdir -p "$p/src"
    while IFS=$'\t' read -r k rel dst pre; do
      [ "$k" = file ] || continue
      mkdir -p "$(dirname "$p/src/$dst")"
      { printf '%s' "$pre"; cat "$(src_of "$dir" "$rel")"; } > "$p/src/$dst"
      files+=("$dst")
    done < "$p/plan.tsv"
  fi
  case ",$levels," in
    *,read,*|*,nread,*|*,interp,*|*,compiled,*|*,print,*)
      if [ -z "$from_committed" ]; then
        ro=()
        while IFS= read -r k; do [ -n "$k" ] && ro+=("$k"); done <<< "$(read_opts ${opts[@]+"${opts[@]}"})"
        key=$( { echo "$reader_key"; printf '%s\n' ${ro[@]+"${ro[@]}"}; (cd "$p/src" && find . -type f | LC_ALL=C sort | xargs -d '\n' sha256sum); } | sha256sum | cut -c1-24)
        forms=$(cache_slot "$formsc" "$key")
        echo "$key" > "$p/forms.key"
        # one reader per key: two descriptions of one file share their source set
        exec 7> "$forms.lock"; flock 7
        cache_take "$formsc" "$key" "$forms"
        if [ ! -f "$forms.result" ] && [ -n "${forms_only:-}" ] && [ -f "$forms.unfinished" ]; then
          # the read ran and did not finish (not cached, report 003's finding 6): the test unread, no miss
          cp "$forms.unfinished" "$p/read.result"
        elif [ ! -f "$forms.result" ] && [ -n "${forms_only:-}" ]; then
          # GTS41 (c), GT7: the read's cache forced (JAVA_CHECK_FORMS_ONLY=1): a level that consumes the
          # read's output never reads; a miss is the test's failure and the run's (forms-misses)
          printf 'fail\tthe forms cache missed (JAVA_CHECK_FORMS_ONLY=1): %s\n' "$forms" > "$p/read.result"
          echo "$id $forms" >> "$work/forms-misses"
        elif [ ! -f "$forms.result" ]; then
          rm -rf "$forms" "$forms.tmp"
          st=0
          (cd "$root" && bin/repr-java read ${ro[@]+"${ro[@]}"} "$forms.tmp" "$p/src") > "$forms.log" 2>&1 || st=$?
          # GTS35 (a): the result written to a temporary and renamed, once complete; a read killed by a
          # signal (status above 128: an OOM kill, the audit's) is no result and is not cached, nor is a
          # read that did not finish (no summary line, no FAILED line: Go's out of memory exits 2, the
          # tool or the platform missing; report 003's finding 6): the test's failure (the same reason),
          # read again next time, KEY.unfinished telling a forced cache's consumers that the read ran
          rm -f "$forms.unfinished"
          if [ "$st" = 0 ] && grep -q ' converted, 0 failed, 0 javac errors' "$forms.log"; then
            mv "$forms.tmp" "$forms"; printf 'pass\t\n' > "$forms.result.$$" && mv "$forms.result.$$" "$forms.result"
          elif [ "$st" -gt 128 ]; then
            rm -rf "$forms.tmp"; printf 'fail\tthe read was killed (status %s), not cached\n' "$st" > "$p/read.result"
          else
            reason=$( { grep -m1 '^FAILED ' "$forms.log" | sed 's|^FAILED [^ ]* ||'; grep -m1 -E 'error|Exception|failed' "$forms.log"; } | head -1 | tr '\t' ' ' | cut -c1-300)
            rm -rf "$forms.tmp"
            if read_finished "$forms.log"; then
              printf 'fail\t%s\n' "${reason:-status $st}" > "$forms.result.$$" && mv "$forms.result.$$" "$forms.result"
            else
              printf 'fail\t%s\n' "${reason:-status $st}" > "$p/read.result"; cp "$p/read.result" "$forms.unfinished"
            fi
          fi
        fi
        flock -u 7; exec 7>&-
        [ -f "$forms.result" ] || cp "$p/read.result" "$forms.result.$$"
        if [ -f "$forms.result" ]; then res=$forms.result; else res=$forms.result.$$; fi
        grep -q '^pass' "$res" && echo "$forms" > "$p/forms.dir"
        # --save (GT5): the forms' digest, their first line (the scratch they were read in) left out
        if [ -n "${save:-}" ]; then
          if grep -q '^pass' "$res"; then
            (cd "$forms" && find . -type f ! -name 'repr-java-*.edn' | LC_ALL=C sort | xargs -r -d '\n' \
               awk 'FNR == 1 { print "@@ " FILENAME; if (/^;; Converted from /) next } { print }') | sha256sum | cut -c1-64 > "$p/forms.sha"
          else
            echo - > "$p/forms.sha"
          fi
        fi
        case ",$levels," in *,read,*) printf '%s\tread\t%s\n' "$id" "$(cat "$res")" | sed -e "s|$p|RUN|g" -e "s|$root|.|g" ;; esac
        rm -f "$forms.result.$$"
      fi ;;
  esac
  case ",$levels," in *,nread,*) [ -z "$from_committed" ] && nread_one "$id" "$p" "$key" "$forms" ;; esac
  # JCS300 (c): the class files of a test that reads its own, for interp and compiled (the read passed)
  rm -f "$p/classes.dir"
  case ",$levels," in
    *,interp,*|*,compiled,*)
      if [ -z "$from_committed" ] && grep -qs '^pass' "$forms.result" && classes_test; then test_classes "$id"; fi ;;
  esac
  case ",$levels," in
    *,interp,*)
      if [ -z "$from_committed" ] && ! grep -qs '^pass' "$forms.result"; then
        printf '%s\tinterp\tunread\tthe read failed\n' "$id"
      else
        local t0=$SECONDS
        run_actions interp "$rexe" "$load" "$forms"
        echo $((SECONDS - t0)) > "$p/interp.secs"
      fi ;;
  esac
  case ",$levels," in
    *,classes,*)
      rm -rf "$p/classes"; mkdir -p "$p/classes"
      st=0; (cd "$p/src" && "$root/bin/repr-java" javac "${classes_opts[@]}" -d "$p/classes" ${opts[@]+"${opts[@]}"} "${files[@]}") > "$p/javac.log" 2>&1 || st=$?
      if [ "$st" != 0 ]; then
        printf '%s\tclasses\tfail\tjavac on Arbace: %s\n' "$id" "$(grep -m1 -E 'error|release' "$p/javac.log" | tr '\t' ' ' | cut -c1-300)"
        awk -F'\t' '$1=="control-own"{print $2}' "$p/plan.tsv" | while read -r x; do printf '%s\tclasses\tpass\t\n' "$x"; done
      else
        k=$(classes_sha "$p/classes" | cut -c1-16)
        # JCV1: the test's own verdict, javac's acceptance (no corpus test is @compile/fail); the class files
        # against the JDK javac's the oracle tier's row classes.jdk when they differ
        printf '%s\tclasses\tpass\t\n' "$id"
        r=$(classes_verdict "$k" "$(awk -F'\t' '$1=="classes"{print $2}' "$p/plan.tsv")")
        case $r in pass*) ;; *) printf '%s\tclasses.jdk\t%s\n' "$id" "$r" ;; esac
        # JCV1's control: the verdict inverted (the test must fail to compile), which javac's acceptance fails
        awk -F'\t' '$1=="control-own"{print $2}' "$p/plan.tsv" | while read -r x; do
          printf '%s\tclasses\tfail\tstatus 0 (expected a failure: the verdict inverted, a control)\n' "$x"
        done
        # GTS81 (a): the controls whose subject this test is, the same digest against their reference's
        awk -F'\t' '$1=="control-classes"{print $2 "\t" $3}' "$p/plan.tsv" | while IFS=$'\t' read -r x r; do
          printf '%s\tclasses\t%s\n' "$x" "$(classes_verdict "$k" "$r")"
        done
      fi
      rm -rf "$p/classes" ;;
  esac
}

# nread_one ID P KEY FORMS: the level nread (JFS123 (b), doc/classes/JAVA-FRONTEND-SURVEY.md, "As built:
# JN9f"): the test's sources read without javac (bin/repr-java read --no-javac: the native parser's trees
# and the native provider's answers alone, a file that meets what only javac answers read again by javac,
# the fallback), cached in WORK/forms-nojavac by the read level's key, its forms against the read level's
# (javac's, FORMS) byte for byte. Prints ID nread RESULT REASON: pass (every file read natively, the forms
# javac's), fallback (the forms javac's, but N files fell back: the reasons, \"no javac:\"'s map), differ
# (a forms file differs: its path), fail (the read failed), unread (javac's read failed)
nread_one() {
  local id=$1 p=$2 key=$3 forms=$4 nf st reason d
  if ! grep -qs '^pass' "$forms.result"; then printf '%s\tnread\tunread\tthe read failed\n' "$id"; return 0; fi
  nf=$(cache_slot "$work/forms-nojavac" "$key")
  exec 6> "$nf.lock"; flock 6
  cache_take "$work/forms-nojavac" "$key" "$nf"
  if [ ! -f "$nf.result" ]; then
    rm -rf "$nf" "$nf.tmp"
    st=0
    (cd "$root" && bin/repr-java read --no-javac ${ro[@]+"${ro[@]}"} "$nf.tmp" "$p/src") > "$nf.log" 2>&1 || st=$?
    # GTS35 (a): a read killed by a signal is no result: not cached (the .new result renamed below)
    if [ "$st" -gt 128 ]; then
      rm -rf "$nf.tmp"; flock -u 6; exec 6>&-
      printf '%s\tnread\tfail\tthe read was killed (status %s), not cached\n' "$id" "$st"; return 0
    fi
    if [ "$st" != 0 ] || ! grep -q ' converted, 0 failed, 0 javac errors' "$nf.log"; then
      reason=$( { grep -m1 '^FAILED ' "$nf.log" | sed 's|^FAILED [^ ]* ||'; grep -m1 -E 'error|Exception|failed' "$nf.log"; } | head -1 | tr '\t' ' ' | cut -c1-300)
      # a read that did not finish is not cached either (report 003's finding 6)
      if ! read_finished "$nf.log"; then
        rm -rf "$nf.tmp"; flock -u 6; exec 6>&-
        printf '%s\tnread\tfail\t%s\n' "$id" "${reason:-status $st}" | sed -e "s|$p|RUN|g" -e "s|$root|.|g"; return 0
      fi
      printf 'fail\t%s\n' "${reason:-status $st}" > "$nf.result.new"
    # (each file's first line names the source it was read from: the test whose read filled the cache)
    elif ! diff -r -x 'repr-java-*.edn' -I '^;; Converted from ' "$forms" "$nf.tmp" > "$nf.diff" 2>&1; then
      d=$( { grep -m1 '^diff ' "$nf.diff" | awk '{print $NF}'; grep -m1 '^Only in ' "$nf.diff"; } | head -1 | sed "s|$nf.tmp/||; s|$forms/||" | cut -c1-200)
      printf 'differ\tthe forms differ from the read level'"'"'s: %s\n' "$d" > "$nf.result.new"
    elif grep -q '^no javac: .* [1-9][0-9]* fallbacks to javac' "$nf.log"; then
      # the reasons: the "no javac:" line's map, {"reason" n, ...}, as "reason n; reason n"
      reason=$(grep -m1 '^no javac: ' "$nf.log" | sed -e 's/^[^{]*{//' -e 's/}$//' -e 's/" \([0-9][0-9]*\)\(, \)\{0,1\}/ \1; /g' -e 's/"//g' -e 's/; $//' | tr '\t' ' ' | cut -c1-300)
      printf 'fallback\t%s\n' "$reason" > "$nf.result.new"
    else
      printf 'pass\t\n' > "$nf.result.new"
    fi
    rm -rf "$nf.tmp"
    mv "$nf.result.new" "$nf.result"
  fi
  flock -u 6; exec 6>&-
  printf '%s\tnread\t%s\n' "$id" "$(cat "$nf.result")" | sed -e "s|$p|RUN|g" -e "s|$root|.|g"
}

# mark_audited SAVE LEVELS: --save's marker SAVE/audited when the run was under the gate's audit
# (bin/gate --clean: strace -f), so that the judgment knows its timeouts may be strace's
# (test/java/divergences.edn's :audited class, GT7 rerun 8). The gate says so (GATE_AUDITED=1, set by
# bin/lib/gate-run.bash's step for an audited step) and the tracer is the cross-check (TracerPid of this
# process): the mark needs both, GATE_AUDITED naming what the run is and TracerPid that strace is really
# on it. One without the other (a person's strace or gdb on an unaudited run; an audited step whose tracer
# is not attached) is said on stderr and not marked: the judgment is then the stricter (review 070).
mark_audited() {
  local save=$1 levels=$2 traced=0
  rm -f "$save/audited"
  awk '$1 == "TracerPid:" && $2 != 0 { t = 1 } END { exit !t }' /proc/self/status && traced=1
  if [ "${GATE_AUDITED:-}" = 1 ] && [ $traced = 1 ]; then
    printf '%s\n' "$levels" > "$save/audited"
  elif [ "${GATE_AUDITED:-}" = 1 ]; then
    echo "java-check: --save: GATE_AUDITED=1 but no tracer is attached (TracerPid 0): not marked audited, its timeouts are judged as they are" >&2
  elif [ $traced = 1 ]; then
    echo "java-check: --save: a tracer is attached (TracerPid) but GATE_AUDITED is not 1, not the gate's audit: not marked audited, its timeouts are judged as they are" >&2
  fi
}

# run_errors RESULTS (queue 485): the rows of RESULTS that are the run's own errors, not a test's: result error
# with the reason the shard failed (run_shard) or a plan missing or cut (plan_bad, run_actions)
run_errors() {
  awk -F'\t' '$3 == "error" && ($4 ~ /^the shard failed/ || $4 ~ /^no plan/ || $4 ~ /^the plan .* (is partial|has no run line|was cut)/) { n++ } END { print n + 0 }' "$1"
}

# run_errors_ok RESULTS (queue 485): 1, and the reason on stderr, when RESULTS holds more of the run's own errors
# (run_errors) than JAVA_CHECK_ERRORS_MAX (default 0); else 0
run_errors_ok() {
  local n
  n=$(run_errors "$1")
  [ "$n" -gt "${JAVA_CHECK_ERRORS_MAX:-0}" ] || return 0
  echo "java-check: FAILED: $n rows of the run's own errors (the shard failed, a plan missing or cut), above JAVA_CHECK_ERRORS_MAX=${JAVA_CHECK_ERRORS_MAX:-0}: no test earned them; the first: $(awk -F'\t' '$3 == "error"' "$1" | head -1 | cut -c1-300)" >&2
  return 1
}

check() {
  local only="" corpus="" record="" essential="" list=""
  save=""
  jobs=8 t0=$SECONDS shard_size=${JAVA_CHECK_SHARD_SIZE:-500} shard_only=""
  levels=read,interp timeout=20 from_committed="" load=${JAVA_CHECK_LOAD:-files} analyze_only=""
  while [ $# -gt 0 ]; do
    case $1 in
      --levels) levels=$2; shift 2 ;;
      --jobs) jobs=$2; shift 2 ;;
      --timeout) timeout=$2; shift 2 ;;
      --load) load=$2; shift 2 ;;
      --only) only=$2; shift 2 ;;
      --list) list=$(realpath -m "$2"); shift 2 ;;
      --corpus) corpus=$2; shift 2 ;;
      --shard-size) shard_size=$2; shift 2 ;;
      --shard) shard_only=$2; shift 2 ;;
      --record) record=1; shift ;;
      --essential) essential=1; shift ;;
      --save) save=$2; shift 2 ;;
      --analyze-only) analyze_only=1; shift ;;
      *) echo "java-check: unknown option $1 (bin/java-check --help)" >&2; return 2 ;;
    esac
  done
  # JCS265 (b): --analyze-only, the compiled level's j2g analysis alone, its results saved, never judged
  if [ -n "$analyze_only" ]; then
    case ",$levels," in *,compiled,*) ;; *) echo "java-check: --analyze-only is the compiled level's (--levels ...,compiled)" >&2; return 2 ;; esac
    [ -n "$save" ] || { echo "java-check: --analyze-only saves its results (--save DIR): they are no compiled level's to judge or record" >&2; return 2; }
  fi
  # GT8 (the rotation's lists): --list FILE, the tests' ids (tNNNNN) one a line, blank and # lines left out (plan's --list)
  if [ -n "$list" ]; then
    [ -f "$list" ] || { echo "java-check: --list $list: no such file" >&2; return 2; }
    [ -z "$essential" ] || { echo "java-check: --list with --essential (its own list)" >&2; return 2; }
    [ -z "$record" ] || { echo "java-check: --record writes the levels' whole records: no --list (a partial run's --record updates its tests' lines only through --only)" >&2; return 2; }
  fi
  # --record under a tracer (the gate's audit, a person's strace or gdb): its timeouts may be the tracer's, and
  # recording them would make a real timeout no regression. The judgment's --record refuses --audited
  # (check.ae, review 070); this is the run's own judgment, which no marker reaches (queue 093, report 088
  # finding 3). --save never records (it returns before the judgment)
  if [ -n "$record" ] && [ -z "$save" ] && awk '$1 == "TracerPid:" && $2 != 0 { t = 1 } END { exit !t }' /proc/self/status; then
    echo "java-check: --record under a tracer (TracerPid): its timeouts may be the tracer's; recording them would make a real timeout no regression. Record from an untraced run." >&2
    return 2
  fi
  # the executable interprets and hosts j2g: the levels read, nread, classes, print and diagnostics need none
  case ",$levels," in *,interp,*|*,compiled,*) rexe=$(run_exe) || return 1 ;; *) rexe=none ;; esac
  # F6: the tool tests' executable and platform (interp)
  texe= tplatform=
  case ",$levels," in
    *,interp,*|*,compiled,*)
      # JD4 (a): the compiled level's tests naming javac's API run javac on Arbace in their program against the platform
      if [ -z "${ARBACE_COVER_DIR:-}" ]; then
        texe=$(tool_exe)
        if [ -n "$texe" ]; then
          tplatform=$(REPR_JAVA_EXE=$texe "$root/bin/repr-java" platform-dir) || { echo "java-check: no platform for javac's tool (bin/repr-java platform-dir)" >&2; return 1; }
        fi
      fi ;;
  esac
  cover_setup || return 1
  mkdir -p "$formsc" "$work"; : > "$work/empty"
  # queue 485 (477-3): one run in a WORK at a time. A second run removed WORK/run under the first, whose compiled runs
  # then found no plan and passed 104 rows unrun. The lock (fd 8, closed for the runs' children below, so that no
  # process a test leaves behind holds it) makes the second wait for the first (JAVA_CHECK_WORK: a run beside it)
  exec 8>> "$work/run.lock"
  if ! flock -n 8; then
    echo "java-check: another java-check runs in $work (its lock $work/run.lock): waiting for it (JAVA_CHECK_WORK names another WORK, for a run beside it)" >&2
    flock 8
  fi
  rm -rf "$work/run"; rm -f "$work/forms-misses"
  # GTS41 (c): JAVA_CHECK_FORMS_ONLY=1 forces the read's cache for the levels that consume its output
  # (interp, compiled, print run without the read level); a run with the read level reads as ever
  case ",$levels," in *,read,*|*,nread,*) forms_only= ;; *) forms_only=${JAVA_CHECK_FORMS_ONLY:-} ;; esac
  local pargs=()
  [ -z "$list" ] || pargs+=(--list "$list")
  [ -n "$only" ] && pargs+=(--only "$only")
  [ -n "$corpus" ] && pargs+=(--corpus "$corpus")
  if [ -n "$essential" ]; then
    levels=interp from_committed=1
    pargs+=(--list "$root/test/java/essential.txt")
  else
    check_pin
    case ",$levels," in *,read,*|*,nread,*|*,interp,*|*,classes,*|*,compiled,*|*,diagnostics,*|*,print,*)
      . "$root/bin/lib/repr-java/host.bash"
      reader_key="$(repr_java_reader_hash) $(repr_java_host)" || return 1 ;;
    esac
  fi
  # 612-1 (b): the interp level's processor cap is part of the run's terms: refuse rather than run uncapped when
  # taskset is missing (JAVA_CHECK_INTERP_CPUS=0 is the explicit off), so an uncapped run is never recorded by mistake
  case ",$levels," in *,interp,*)
    if [ "${JAVA_CHECK_INTERP_CPUS:-8}" != 0 ] && ! command -v taskset > /dev/null; then
      echo "java-check: the interp level caps its runs' processors at JAVA_CHECK_INTERP_CPUS=${JAVA_CHECK_INTERP_CPUS:-8} by taskset (util-linux-misc), which is missing; install it, or set JAVA_CHECK_INTERP_CPUS=0 to run uncapped" >&2
      return 1
    fi ;;
  esac
  jc plan "$ref" "$work" ${pargs[@]+"${pargs[@]}"} >&2
  jc plan-diag "$ref" "$work" "$levels" >&2
  echo "== java-check: $(wc -l < "$work/run.list") tests at the levels $levels, $jobs at a time (the executable $rexe${texe:+; the tests naming the javac API on $texe})" >&2
  export -f src_of cache_slot cache_take tool_test classes_test test_classes cover_env cover_settle limited limited_cpu attempt_limits timeout_kind note_attempt program_tmo test_limit test_wall check_one nread_one read_opts read_finished first_line root_cause classes_sha classes_verdict judge run_actions jtreg_props run_dirs mask_hashes mask_dirs test_dir plan_bad check_diag diag_actions diag_root diag_norm diag_first_diff diag_golden diag_judge judge_own judge_golden interp_cpus
  reset_timeout_log "$work/timeout-attempts.tsv"
  export root work formsc forms_only save jdktest levels timeout from_committed load rexe texe tplatform tool_re cf_re reader_key="${reader_key:-}" classes_opts_s="${classes_opts[*]}"
  xargs -a "$work/run.list" -P "$jobs" -I{} bash -c 'classes_opts=($classes_opts_s); check_one "$1"' _ {} 8>&- | LC_ALL=C sort > "$work/results.tsv"
  case ",$levels," in *,interp,*) export -f again interp_one; export jobs; again interp "$work/results.tsv" interp_one 8>&- ;; esac
  case ",$levels," in
    *,compiled,*)
      export -f compiled_one compiled_one_on again
      export jobs
      compiled_level > "$work/results-compiled.tsv" 8>&- || return 1
      LC_ALL=C sort -o "$work/results.tsv" "$work/results.tsv" "$work/results-compiled.tsv" ;;
  esac
  case ",$levels," in *,print,*) print_level > "$work/results-print.tsv" 8>&- || return 1; LC_ALL=C sort -o "$work/results.tsv" "$work/results.tsv" "$work/results-print.tsv" ;; esac
  echo "java-check: $(wc -l < "$work/run.list") tests in $((SECONDS - t0)) s"
  # queue 485: the rows no test earned, the run's own errors (a shard that failed: its tests' "error the shard
  # failed"; a plan missing or cut), above JAVA_CHECK_ERRORS_MAX (default 0) fail the run, with --save too: the
  # gate records no pass of a level step whose shards failed (night 11-20's langtools-run part: 514 such rows
  # saved as a pass, which --judge --latest-saved would take). Its results are still saved, for the triage
  local errs=0
  run_errors_ok "$work/results.tsv" || errs=1
  if [ -s "$work/forms-misses" ]; then
    echo "java-check: FAILED: $(wc -l < "$work/forms-misses") tests' forms not in the read's cache $formsc (JAVA_CHECK_FORMS_ONLY=1; $work/forms-misses), the first: $(head -1 "$work/forms-misses")" >&2
    return 1
  fi
  # --save (GT5): the runs alone, their results and the forms' digests kept, judged by --judge
  if [ -n "$save" ]; then
    mkdir -p "$save"
    cp "$work/results.tsv" "$save/results.tsv"
    mark_audited "$save" "$levels"
    # the levels run and whether the run was partial, for --judge (a level without rows judged too)
    echo "$levels" > "$save/levels"
    # GT8: a run of whole corpora (--corpus alone, the gate's parts) is no partial run: DIR/corpus names them, and
    # --judge judges whole runs of those corpora (each test of theirs needs a row), partial only the other selections
    rm -f "$save/partial" "$save/corpus"
    if [ -n "$only" ] || [ -n "$list" ] || [ -n "$essential" ]; then : > "$save/partial"
    elif [ -n "$corpus" ]; then echo "$corpus" | tr ',' '\n' > "$save/corpus"; fi
    case ",$levels," in
      *,read,*)
        while read -r id; do
          grep -q '^kind	diagnostics' "$work/run/$id/plan.tsv" && continue
          printf '%s\t%s\n' "$id" "$( [ -f "$work/run/$id/forms.sha" ] && cat "$work/run/$id/forms.sha" || echo -)"
        done < "$work/run.list" | LC_ALL=C sort > "$save/forms.sha256" ;;
    esac
    echo "java-check: the results of $levels saved in $save ($(wc -l < "$save/results.tsv") lines; judged by bin/java-check --judge)"
    return "$errs"
  fi
  local rargs=()
  [ -n "$record" ] && rargs+=(--record)
  [ -n "$essential" ] && rargs+=(--essential "$root/test/java/essential.txt")
  { [ -n "$only" ] || [ -n "$list" ]; } && rargs+=(--partial)
  [ -n "$only$list" ] || [ -z "$corpus" ] || rargs+=(--corpora "$corpus")
  jc report "$ref" "$work" "$root/test/java/divergences.edn" "$root/test/java" "$levels" ${rargs[@]+"${rargs[@]}"} || return 1
  return "$errs"
}

# ---------------------------------------------------------------------------------------------
# the print level (REAP5, doc/FULL-SUPPORT-SURVEY.md, "As built: REAP5"; RPS9 (a)): every read
# test's forms printed back to Java by repr/java's printer and judged (java.print, test/java/print.ae):
# javac on Arbace accepts the printed Java, its read gives the forms again, mode :full prints the
# source back byte for byte, and the printed Java's class files are the original's

jp() { arbace_tool -p "$root/test" -m java.print "$@"; }

# print_ro P: repr/java read's options for the test of run directory P (check_one's), into ro
print_ro() {
  local k rel o=()
  ro=()
  while IFS=$'\t' read -r k rel; do [ "$k" = javac ] && o+=("$rel"); done < "$1/plan.tsv"
  while IFS= read -r k; do [ -n "$k" ] && ro+=("$k"); done <<< "$(read_opts ${o[@]+"${o[@]}"})"
}

# print_read OUT-LINK SRC CACHE FLAG...: repr/java read of SRC (with ro and FLAGs) cached in CACHE/KEY
# by the sources, the options and the reader (as check_one's read level); writes OUT-LINK.dir (the
# forms) or OUT-LINK.err (the reason)
print_read() {
  local link=$1 src=$2 cache=$3 key f st reason unfinished=""
  shift 3
  key=$( { echo "$reader_key"; printf '%s\n' "$@" ${ro[@]+"${ro[@]}"}; (cd "$src" && find . -type f -name '*.java' | LC_ALL=C sort | xargs -d '\n' sha256sum); } | sha256sum | cut -c1-24)
  f=$(cache_slot "$cache" "$key")
  exec 8> "$f.lock"; flock 8
  cache_take "$cache" "$key" "$f"
  if [ ! -f "$f.result" ]; then
    rm -rf "$f" "$f.tmp"
    st=0
    (cd "$root" && bin/repr-java read "$@" ${ro[@]+"${ro[@]}"} "$f.tmp" "$src") > "$f.log" 2>&1 || st=$?
    # GTS35 (a): the result renamed once complete; a read killed by a signal not cached, nor one that
    # did not finish (report 003's finding 6)
    if [ "$st" = 0 ] && grep -q ' converted, 0 failed, 0 javac errors' "$f.log"; then
      mv "$f.tmp" "$f"; printf 'pass\t\n' > "$f.result.$$" && mv "$f.result.$$" "$f.result"
    elif [ "$st" -gt 128 ]; then
      rm -rf "$f.tmp"
    elif ! read_finished "$f.log"; then
      rm -rf "$f.tmp"
      unfinished=$( { grep -m1 -E 'error|Exception|failed' "$f.log" || echo "status $st"; } | tr '\t' ' ' | cut -c1-300)
    else
      reason=$( { grep -m1 '^FAILED ' "$f.log" | sed 's|^FAILED [^ ]* ||'; grep -m1 -E 'error|Exception|failed' "$f.log"; } | head -1 | tr '\t' ' ' | cut -c1-300)
      rm -rf "$f.tmp"; printf 'fail\t%s\n' "${reason:-status $st}" > "$f.result.$$" && mv "$f.result.$$" "$f.result"
    fi
  fi
  flock -u 8; exec 8>&-
  rm -f "$link.dir" "$link.err"
  if grep -qs '^pass' "$f.result"; then echo "$f" > "$link.dir"
  elif [ -f "$f.result" ]; then cut -f2- "$f.result" > "$link.err"
  elif [ -n "$unfinished" ]; then echo "$unfinished" > "$link.err"
  else echo "the read was killed (status $st), not cached" > "$link.err"; fi
}

# print_full_one ID: the test's sources read in mode :full (read --full), cached in WORK/forms-full
print_full_one() {
  local p=$work/run/$1 ro
  print_ro "$p"
  print_read "$p/full" "$p/src" "$work/forms-full" --full
}

# print_check_one ID: after java.print's print: javac on Arbace over the printed Java (the classes
# level's options), its class files against the JDK javac's digest (the original's) or, when they
# differ, against javac on Arbace's of the original, kept for java.print's judge; then the printed
# Java read again (F2, cached in WORK/forms as the read level's)
print_check_one() {
  local id=$1 p=$work/run/$1 pp=$work/run/$1/print k rel opts=() st ro
  [ -f "$pp/print.tsv" ] && grep -q '^pass' "$pp/print.tsv" || return 0
  while IFS=$'\t' read -r k rel; do [ "$k" = javac ] && opts+=("$rel"); done < "$p/plan.tsv"
  (cd "$pp/lines" && find . -name '*.java' | sed 's|^\./||' | LC_ALL=C sort) > "$pp/files.txt"
  rm -rf "$pp/c1" "$pp/c2"; mkdir -p "$pp/c2"
  st=0; (cd "$pp/lines" && "$root/bin/repr-java" javac "${classes_opts[@]}" -d "$pp/c2" ${opts[@]+"${opts[@]}"} "@$pp/files.txt") > "$pp/javac.log" 2>&1 || st=$?
  echo "$st" > "$pp/javac.exit"
  if [ "$st" != 0 ]; then
    { grep -m1 ': error: ' "$pp/javac.log" || grep -m1 -E 'error|Exception' "$pp/javac.log"; } | sed -e "s|^$pp/lines/||" -e 's|^\./||' | tr '\t' ' ' | cut -c1-300 > "$pp/javac.err1" || true
    rm -rf "$pp/c2"; return 0
  fi
  k=$(classes_sha "$pp/c2" | cut -c1-16)
  # GTS84 (a): a control's subject (control-print CID REF) judges its printed class files' digest again, against
  # the reference's (control-classes CID DIGEST), into classes.res.CID; it and a control's reference
  # (control-reference CID) keep them (print/c2) for java.print's judge of the control
  awk -F'\t' '$1 == "control-print" { print $2 }' "$p/plan.tsv" | while read -r rel; do
    classes_verdict "$k" "$(awk -F'\t' -v c="$rel" '$1 == "control-classes" && $2 == c { print $3 }' "$p/plan.tsv")" | cut -f1 > "$pp/classes.res.$rel"
  done
  # JCV1: against the test's own original, compiled by javac on Arbace (not the JDK javac's digest, the oracle's)
  awk -F'\t' '$1=="file"{print $3}' "$p/plan.tsv" > "$pp/files-orig.txt"
  mkdir -p "$pp/c1"
  (cd "$p/src" && "$root/bin/repr-java" javac "${classes_opts[@]}" -d "$pp/c1" ${opts[@]+"${opts[@]}"} "@$pp/files-orig.txt") > "$pp/javac-orig.log" 2>&1 || true
  if [ "$k" = "$(classes_sha "$pp/c1" | cut -c1-16)" ]; then
    echo pass > "$pp/classes.res"
    rm -rf "$pp/c1"
    grep -q '^control-print	\|^control-reference	' "$p/plan.tsv" || rm -rf "$pp/c2"
  else
    echo differ > "$pp/classes.res"
  fi
  print_ro "$p"
  print_read "$pp/f2" "$pp/lines" "$formsc"
}

# print_level: the print level of the tests WORK/run.list holds (the read level's forms in
# WORK/run/ID/forms.dir); prints ID print RESULT REASON per test; unread tests 'unread'
print_level() {
  local list=$work/print.list id why
  : > "$list"
  while read -r id; do
    # queue 485: a plan missing or cut is the test's error, never printed
    if why=$(plan_bad "$work/run/$id"); then printf '%s\tprint\terror\t%s\n' "$id" "$why" | sed -e "s|$root|.|g"; continue; fi
    grep -q '^kind	diagnostics' "$work/run/$id/plan.tsv" && continue
    if [ -f "$work/run/$id/forms.dir" ]; then echo "$id" >> "$list"; else printf '%s\tprint\tunread\tthe read failed\n' "$id"; fi
  done < "$work/run.list"
  export -f cache_slot cache_take print_ro print_read read_finished print_full_one print_check_one classes_sha classes_verdict
  echo "== java-check print: $(wc -l < "$list") tests read in mode :full ($(since_t0))" >&2
  xargs -a "$list" -P "$jobs" -I{} bash -c 'print_full_one "$1"' _ {}
  echo "== java-check print: printed (java.print, the tools' host) ($(since_t0))" >&2
  # queue 520 (t07835): the printer's declarations of a class the tools' host does not hold (jdk.jdi's,
  # java.desktop's) from the platform the read attributed against, made by bin/repr-java for its pin
  local pplat=$root/.tmp/repr-java-platform
  cmp -s "$root/jdk/javac/platform.sha256" "$pplat/.pin" || pplat=
  REPR_JAVA_PLATFORM=$pplat jp print "$work" "$list" "$root/jdk/forms" >&2 || return 1
  echo "== java-check print: javac on Arbace and the read of the printed Java ($(since_t0))" >&2
  xargs -a "$list" -P "$jobs" -I{} bash -c 'classes_opts=($classes_opts_s); print_check_one "$1"' _ {}
  echo "== java-check print: judged ($(since_t0))" >&2
  jp judge "$work" "$list" | sed -e "s|$work/run/t[0-9]*/|RUN/|g" -e "s|$work|WORK|g" -e "s|$root|.|g"
}

# ---------------------------------------------------------------------------------------------
# the essential tests' committed forms

# the comparison of --forms verify: two trees of forms equal byte for byte (the provenance apart, which
# repr_java_provenance_same compares); its diff in WORK/forms.diff
forms_same() { diff -r -x provenance.edn "$1" "$2" > "$work/forms.diff"; }

# GTS91 (a), the read level's negative control (test/java/controls.edn, the controls with :forms in their
# :levels): the subject's fresh forms ($2/SUBJECT) judged by forms_same against the reference's committed
# forms ($1/REFERENCE); they must differ. One that is the same fails the verify (the comparison passes what
# differs); one whose subject was not read fresh or whose reference is not committed (a selection) is left.
forms_controls() {
  local out=$1 new=$2 line cid sub ref rc=0
  grep -E '^ *\{:id ".*:levels \[[^]]*:forms' "$root/test/java/controls.edn" > "$work/forms-controls.txt" || true
  while read -r line; do
    cid=$(sed -n 's/^ *{:id "\([^"]*\)".*/\1/p' <<< "$line")
    sub=$(sed -n 's/.* :subject "\([^"]*\)".*/\1/p' <<< "$line")
    ref=$(sed -n 's/.* :reference "\([^"]*\)".*/\1/p' <<< "$line")
    if [ ! -d "$new/$sub" ] || [ ! -d "$out/$ref" ]; then
      echo "control $cid (forms): left (${sub}'s fresh forms or ${ref}'s committed forms are not in this run)"; continue
    fi
    if forms_same "$out/$ref" "$new/$sub"; then
      echo "control passed: $cid (forms): $sub's fresh forms equal $ref's committed forms (the comparison passes what differs)"; rc=1
    else
      echo "control $cid (forms): $sub's fresh forms differ from $ref's committed forms, as they must"
    fi
  done < "$work/forms-controls.txt"
  return $rc
}

forms_cmd() {
  local mode=${1:?usage: bin/java-check --forms verify|update} out=$root/test/java/forms id f n=0
  check_pin
  mkdir -p "$work"
  . "$root/bin/lib/repr-java/host.bash"
  reader_key="$(repr_java_reader_hash) $(repr_java_host)" || return 1
  local rst=0
  check --levels read --only "^($(grep -v '^#' "$root/test/java/essential.txt" | awk '{print $1}' | paste -sd'|')) " > "$work/forms-read.txt" 2>&1 || rst=$?
  tail -3 "$work/forms-read.txt"
  rm -rf "$work/forms-new"; mkdir -p "$work/forms-new"
  grep -v '^#' "$root/test/java/essential.txt" | awk 'NF{print $1}' > "$work/essential.list"
  local key
  while read -r id; do
    key=
    [ ! -f "$work/run/$id/forms.key" ] || key=$(cat "$work/run/$id/forms.key")
    if [ -z "$key" ] || [ ! -d "$formsc/${key:0:2}/$key" ]; then
      # the read did not reach the test: say why (javac's tool missing or stale, the read's own failure)
      echo "java-check --forms: $id was not read (the read level exited $rst; ${key:+$formsc/${key:0:2}/$key.log, }$work/forms-read.txt):" >&2
      grep -E 'java-check|repr_java_host|rebuild|error|no javac tool' "$work/forms-read.txt" | head -5 >&2
      return 1
    fi
    cp -r "$formsc/${key:0:2}/$key" "$work/forms-new/$id"
    n=$((n + 1))
  done < "$work/essential.list"
  # the first line's source: the test's file in jdk26u's test/ (or the checkout's test/java/jls), not
  # the scratch copy's
  local f1 t dst origin
  find "$work/forms-new" -name '*.ae' | LC_ALL=C sort > "$work/forms-new.list"
  while read -r f1; do
    # (the reading test's scratch path: a test of the same sources may have read them)
    t=${f1#$work/forms-new/}; t=${t%%/*}
    # (a shared cache's forms may have been read in another checkout's scratch: any .../run/tN/src/)
    dst=$(sed -n "1s|^;; Converted from .*/run/t[0-9]*/src/\(.*\) by arbace\.repr\.java\..*|\1|p" "$f1")
    [ -n "$dst" ] || continue
    origin=$(awk -F'\t' -v d="$dst" '$1=="root"{r=$2} $1=="dir"{dir=$2} $1=="file" && $3==d {f=$2} END{print (r=="checkout" ? "" : "jdk26u test/") dir "/" f}' "$work/run/$t/plan.tsv")
    sed -i "1s|^;; Converted from .* by arbace\.repr\.java\.|;; Converted from $origin (the test $t, renamed: $dst) by arbace.repr.java.|" "$f1"
  done < "$work/forms-new.list"
  if grep -rlF "$root" "$work/forms-new" | head -3 | grep .; then echo "java-check --forms: the forms above name the checkout" >&2; return 1; fi
  {
    echo ";; The provenance of test/java/forms/ (bin/java-check --forms): the essential tests' forms"
    echo ";; (test/java/essential.txt), read by repr/java from jdk26u's tests renamed (JCS4 (a))."
    echo "{:jdk26u {:repo \"https://github.com/openjdk/jdk26u\" :commit \"$pin\" :path \"test\"}"
    echo " :jdk \"$(repr_java_platform)\""
    echo " :converter {:repr-java \"$(repr_java_reader_hash)\""
    echo "             :host \"$(repr_java_host)\"}"
    echo " :tests $n :files $(find "$work/forms-new" -name '*.ae' | wc -l)}"
  } > "$work/forms-new/provenance.edn"
  if [ "$mode" = verify ]; then
    local crc=0
    forms_controls "$out" "$work/forms-new" || crc=1
    if forms_same "$out" "$work/forms-new" &&
       repr_java_provenance_same "$out/provenance.edn" "$work/forms-new/provenance.edn"; then
      echo "verify: test/java/forms is the conversion, byte for byte ($n tests)"; return $crc
    fi
    diff -r "$out" "$work/forms-new" > "$work/forms.diff" || true
    echo "verify: test/java/forms differs from a fresh conversion ($work/forms.diff)"; head -30 "$work/forms.diff"; return 1
  fi
  rm -rf "$out"; cp -r "$work/forms-new" "$out"
  echo "update: test/java/forms written ($n tests, $(find "$out" -name '*.ae' | wc -l) files): commit it"
}

# ---------------------------------------------------------------------------------------------
# the compiled level's essential subset (REAP8, doc/classes/JAVA-CONFORMANCE-SURVEY.md JCS41 (a),
# doc/FULL-SUPPORT-SURVEY.md "As built: REAP8"): the tests of test/java/essential.txt that pass at
# the level compiled (test/java/check-compiled.edn), from their committed forms (test/java/forms/ID),
# translated by j2g into one program with the compiled namespaces (JAVA_CHECK_AOT, else the gate's
# ARBACE_GATE_EXES/KEY20/amd64/aot, else target/arbace-go/aot; their key the checkout's) and built by
# bin/build-go, as diffcheck's program: cached in WORK/essential-compiled by the key of what it is
# made from (Arbace's sources, j2g's among them, the runtime, go/, overlay/, jdk/, the forms, the
# tools' scripts, the host executable, Go's version): seconds when unchanged, a j2g pass and a build
# when they change. Every test must pass: j2g refusing one, the build failing or a run not passing
# fails the check (no shard rounds, no refusals taken out). Its own scratch (WORK/essential-compiled),
# so that it runs beside --essential.
essential_compiled() {
  local jobs=8 t0=$SECONDS id n st key akey
  while [ $# -gt 0 ]; do
    case $1 in
      --jobs) jobs=$2; shift 2 ;;
      *) echo "java-check --essential-compiled: unknown option $1" >&2; return 2 ;;
    esac
  done
  timeout=20 from_committed=1 levels=compiled load=none
  rexe=$(run_exe) || return 1
  cover_setup || return 1
  # (a cover build's program is kept apart: the essential gate's is cached by key)
  work=$work/essential-compiled${ARBACE_COVER_DIR:+-cover}
  local s=$work/prog aot goroot=${ARBACE_GOROOT:-/root/tamago-go}
  java_check_base || return 1
  [ -f "$aot/packages.edn" ] || { echo "java-check --essential-compiled: no compiled namespaces $aot (bin/arbace-go --build, or JAVA_CHECK_AOT)" >&2; return 1; }
  # the compiled namespaces' key (bin/arbace-go's aot_key: the runtime and the embedded sources,
  # bin/lib/version.bash's arbace_aot_key) the checkout's (JCS46 (a))
  . "$root/bin/lib/version.bash"
  akey=$(arbace_aot_key "$root")
  program_aot_current "$aot" \
    || { echo "java-check --essential-compiled: $aot was compiled from other sources ($aot.key; bin/arbace-go --gate-build or --build)" >&2; return 1; }
  mkdir -p "$work" "$s"; : > "$work/empty"
  # the subset: the essential tests the compiled level's reference passes
  grep -v '^#' "$root/test/java/essential.txt" | awk 'NF{print $1}' > "$work/essential.ids"
  sed -n 's/^ \["\(t[0-9]*\)" "[^"]*" :pass .*/\1/p' "$root/test/java/check-compiled.edn" > "$work/compiled-pass.ids"
  grep -Fx -f "$work/compiled-pass.ids" "$work/essential.ids" > "$work/subset.ids" || true
  rm -rf "$work/run"
  jc plan "$ref" "$work" --list "$work/subset.ids" >&2
  while read -r id; do echo "$root/test/java/forms/$id" > "$work/run/$id/forms.dir"; done < "$work/run.list"
  key=$( { sha256sum < "$rexe"; echo "$akey"; cat "$goroot/VERSION"; cat "$work/run.list"
           (cd "$root" && find arbace go overlay jdk x509roots -type f | LC_ALL=C sort | xargs -d '\n' sha256sum
            sed "s|^|test/java/forms/|" "$work/run.list" | xargs -d '\n' -I{} find {} -type f | LC_ALL=C sort | xargs -d '\n' sha256sum
            sha256sum bin/j2g bin/build-go bin/jrt bin/java-check bin/lib/program.bash test/java/check.ae
            # under coverage the cover flags' and the hook's sources too (review 182, finding 5)
            [ -z "${ARBACE_COVER_DIR:-}" ] || sha256sum bin/lib/cover.bash tools/covsubset/hook/cover.go); } | sha256sum | cut -c1-64)
  if [ -x "$s/arbace-ec" ] && [ "$([ ! -f "$s/key" ] || cat "$s/key")" = "$key" ]; then
    echo "java-check --essential-compiled: the cached program (key ${key:0:12})" >&2
  else
    rm -rf "$s"; mkdir -p "$work/j2g"
    jc shards "$work" 100000 >&2
    [ ! -d "$work/j2g/s1" ] || { echo "java-check --essential-compiled: the tests' files do not fit one program ($work/j2g)" >&2; return 1; }
    mkdir -p "$s"; mv "$work/j2g/s0" "$s/shard"
    : > "$s/shard/refused.tsv"
    jc merge "$work" "$s/shard" > "$s/merge.log" || { cat "$s/merge.log"; return 1; }
    echo "== java-check --essential-compiled: j2g, $(wc -l < "$s/shard/built.txt") tests ($(since_t0))" >&2
    st=0; program_heavy= program_j2g "$rexe" "$s/j2g.log" "$s/shard/out" --input "$s/shard/forms" --input "$aot" || st=$?
    [ -f "$s/shard/out/report.edn" ] || { tail -20 "$s/j2g.log" >&2; echo "java-check --essential-compiled: j2g failed ($s/j2g.log)" >&2; return 1; }
    jc refusals "$work" "$s/shard" > "$s/refusals.log"
    if [ -s "$s/shard/refused.tsv" ] || [ "$st" != 0 ]; then
      cat "$s/refusals.log" "$s/shard/refused.tsv" >&2
      echo "java-check --essential-compiled: j2g refused tests that pass compiled ($s/j2g.log)" >&2; return 1
    fi
    echo "== java-check --essential-compiled: bin/build-go ($(since_t0))" >&2
    cover_flags "$s/shard/out/prog" "$s/work" "$s" || return 1
    program_heavy= program_build_go "$rexe" "$(prog_arch)" "$s/work" "$s/arbace-ec" "$s/build.log" "$s/shard/out/prog" ${cflags[@]+"${cflags[@]}"} \
      || { grep -v '^==' "$s/build.log" | tail -20 >&2; echo "java-check --essential-compiled: the build failed ($s/build.log)" >&2; return 1; }
    rm -rf "$s/shard/out" "$s/work" "$s/shard/forms"
    echo "$key" > "$s/key"
  fi
  echo "== java-check --essential-compiled: the runs of $(wc -l < "$work/run.list") tests, $jobs at a time ($(since_t0))" >&2
  export -f cover_env cover_settle limited limited_cpu attempt_limits timeout_kind note_attempt program_tmo test_limit test_wall compiled_one run_actions interp_cpus tool_test src_of plan_bad jtreg_props judge judge_own judge_golden diag_first_diff first_line root_cause mask_hashes mask_dirs run_dirs test_dir
  reset_timeout_log "$work/timeout-attempts.tsv"
  export root work jdktest timeout
  xargs -a "$work/run.list" -P "$jobs" -I{} bash -c 'compiled_one "$1" "$2"' _ {} "$s/arbace-ec" | LC_ALL=C sort > "$work/results.tsv"
  # a timeout runs again once, alone, with twice its test's limit (JCS47 (a); tmo_scale=2, GTS102): beside the gate's other
  # checks a test of a fraction of a second can miss the limit; its second result stands
  # GTS81 (a): the controls' rows (test/java/controls.edn's ids) apart, after the retry: each must not pass.
  # A control is not run again itself (no test of that id): its subject's retry brings its fresh row, which
  # replaces the timed-out one (review 001, finding 2), as the subject's replaces the subject's
  sed -n 's/^ *{:id "\([^"]*\)".*/\1/p' "$root/test/java/controls.edn" > "$work/controls.ids"
  # re-review 020, finding 6: no id read (controls.edn emptied, or its lines of another shape than one
  # control a line) splits no control off, and a control's row would be judged as a test's (its differ a
  # "not passing" line, the count still whole): an error, as GTS81 (a) has every family keep its control
  [ -s "$work/controls.ids" ] || { echo "java-check --essential-compiled: no control id in $root/test/java/controls.edn (one {:id \"...\" ...} a line: GTS81 (a))" >&2; return 1; }
  # (FILENAME, not NR == FNR, report 003's finding 3: with no control id, an empty controls.ids, NR == FNR
  # would take results.tsv for the ids: no timeout retried, every row a control's and results.tsv emptied)
  awk -F'\t' 'FILENAME == ARGV[1] { c[$1] = 1; next } $3 == "timeout" && !($1 in c) { print $1 }' "$work/controls.ids" "$work/results.tsv" > "$work/timeouts.ids"
  if [ -s "$work/timeouts.ids" ]; then
    echo "== java-check --essential-compiled: $(wc -l < "$work/timeouts.ids") timed out, run again one at a time at twice their limits" >&2
    JAVA_CHECK_ONCE=1 tmo_scale=2 xargs -a "$work/timeouts.ids" -P 1 -I{} bash -c 'compiled_one "$1" "$2"' _ {} "$s/arbace-ec" > "$work/retried.tsv"
    # (FILENAME, not NR == FNR: an empty retry file must not take the results for its own, report 003's
    # finding 3; a subject's retry brings its controls' fresh rows, review 001's finding 2: those added)
    awk -F'\t' 'FILENAME == ARGV[1] { r[$1] = $0; next } ($1 in r) { print r[$1]; delete r[$1]; next } { print }
      END { for (k in r) print r[k] }' "$work/retried.tsv" "$work/results.tsv" \
      | LC_ALL=C sort > "$work/results.r" && mv "$work/results.r" "$work/results.tsv"
  fi
  # JCV1: the oracle tier's rows (compiled.jdk: the JDK's record where it says otherwise) apart, not judged here
  awk -F'\t' '$2 ~ /\.jdk$/' "$work/results.tsv" > "$work/oracle.tsv"
  awk -F'\t' '$2 !~ /\.jdk$/' "$work/results.tsv" > "$work/results.o" && mv "$work/results.o" "$work/results.tsv"
  awk -F'\t' 'FILENAME == ARGV[1] { c[$1] = 1; next } ($1 in c)' "$work/controls.ids" "$work/results.tsv" > "$work/controls.tsv"
  awk -F'\t' 'FILENAME == ARGV[1] { c[$1] = 1; next } !($1 in c)' "$work/controls.ids" "$work/results.tsv" > "$work/results.t" && mv "$work/results.t" "$work/results.tsv"
  n=$(awk -F'\t' '$3 == "pass"' "$work/results.tsv" | wc -l)
  echo "java-check essential-compiled: $(wc -l < "$work/run.list") tests: $n pass; $((SECONDS - t0)) s"
  awk -F'\t' '$3 != "pass" { print "   not passing: " $1 " " $3 " " $4 }' "$work/results.tsv"
  # a control (GTS81 (a)) whose subject passed must be judged, and not pass: its subject's run against
  # another test's reference
  local cbad sub
  cbad=$(awk -F'\t' '$3 != "fail" && $3 != "differ"' "$work/controls.tsv")
  awk -F'\t' '$3 == "fail" || $3 == "differ" { print "   control " $1 ": " $3 ", as a control must (GTS81 (a))" }' "$work/controls.tsv"
  while read -r id; do
    grep -q "^$id	" "$work/controls.tsv" && continue
    sub=$(sed -n "s/^ *{:id \"$id\" :subject \"\([^\"]*\)\".*/\1/p" "$root/test/java/controls.edn")
    grep -q "^$sub	compiled	pass" "$work/results.tsv" && cbad="$cbad${cbad:+
}$id	compiled	missing	no result, its subject $sub passed"
  done < "$work/controls.ids"
  if [ -n "$cbad" ]; then
    printf '%s\n' "$cbad" | awk -F'\t' '{ print "   control " ($3 == "pass" ? "passed" : "not judged") ": " $1 " " $3 " " $4 }'
    return 1
  fi
  [ "$n" = "$(wc -l < "$work/run.list")" ]
}

usage() { sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; }

# gate_store: the store of passes (ARBACE_GATE_STORE, default the main checkout's .tmp/gate-pass/)
gate_store() { echo "${ARBACE_GATE_STORE:-$(cd "$(git -C "$root" rev-parse --git-common-dir)/.." && pwd)/.tmp/gate-pass}"; }

# saved_bad OUT (queue 485): when the saved results OUT (a pass's KEY.out in the store, --save's DIR) hold rows no test
# earned, prints why and returns 0: rows of the run's own errors (run_errors: the shard failed, a plan missing or cut),
# or a log beside it (KEY.log, the step's) that shows plans missing while the run ran (before queue 485 such a run's
# tests passed unrun: 477-3); returns 1 otherwise
saved_bad() {
  local o=$1 n m log=${1%.out}.log
  n=$(run_errors "$o/results.tsv")
  m=0
  [ ! -f "$log" ] || m=$(plan_missing_ids "$log" | wc -l)
  [ "$n" = 0 ] && [ "$m" = 0 ] && return 1
  echo "$n rows of the run's own errors, $m tests whose plan was missing in its log"
}

# plan_missing_ids LOG: the ids of the tests whose plan LOG says was missing (awk's or bash's error on WORK/run/ID/plan.tsv)
plan_missing_ids() {
  { grep -oE "run/t[0-9]+/plan\.tsv('? for reading)?: No such file" "$1" || true; } | sed -E 's|^run/(t[0-9]+)/.*|\1|' | LC_ALL=C sort -u
}

# saved_errors [STORE] (queue 485): read-only, removes nothing: the saved results of the gate's Java steps in the store of
# passes (default gate_store's) that saved_bad finds; a line each: STEP/KEY, whether it is a pass (KEY.edn), its date, the
# rows of the run's own errors (the shard failed; a plan missing or cut), the tests whose plan its log shows missing
# (passed unrun before queue 485), the rows saved, and whether --judge --latest-saved took it before queue 485 (newest)
saved_errors() {
  local store=${1:-$(gate_store)} d o n m tot date newest k nb=0 ns=0
  [ -d "$store" ] || { echo "java-check saved-errors: no store $store" >&2; return 1; }
  printf 'step/key\tpass\tdate\tshard-or-plan-errors\tplan-missing-in-log\trows\tnewest\n'
  for d in "$store"/java-*; do
    [ -d "$d" ] || continue
    newest=$(ls -td "$d"/*.out 2>/dev/null | head -1) || true
    for o in "$d"/*.out; do
      [ -f "$o/results.tsv" ] || continue
      ns=$((ns + 1))
      saved_bad "$o" > /dev/null || continue
      nb=$((nb + 1))
      k=${o%.out}
      n=$(run_errors "$o/results.tsv")
      m=0; [ ! -f "$k.log" ] || m=$(plan_missing_ids "$k.log" | wc -l)
      tot=$(wc -l < "$o/results.tsv")
      date=$(sed -n 's/.*:date "\([^"]*\)".*/\1/p' "$k.edn" 2>/dev/null | head -1) || true
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "${d##*/}/${k##*/}" "$( [ -f "$k.edn" ] && echo pass || echo no)" "${date:--}" "$n" "$m" "$tot" \
        "$( [ "$o" = "$newest" ] && echo newest || echo -)"
    done
  done
  echo "java-check saved-errors: $nb of $ns saved results in $store hold rows no test earned (nothing removed)" >&2
}

# judge_saved [--essential] [--record] [--partial] [--levels L,...] [--held FILE] RESULTS...: the judgment of saved
# runs (GT5); not named judge, the run's judgment above (a second definition replaced it: every run of
# interp and compiled passed whatever its status and output, 2026-10-28 to 2026-10-31). The levels:
# --levels, else the levels files --save wrote beside the results and the rows' own (report 003's
# finding 1: a level whose rows are all lost is still judged); a partial file beside one, --partial
judge_saved() {
  local rargs=() f levels="" partial="" aud d checkdir=$root/test/java oracle="" latest="" store st
  local -a saved=()
  while [ $# -gt 0 ]; do
    case $1 in
      --oracle) oracle=1; rargs+=(--oracle); checkdir=$root/test/java/oracle; shift ;;
      --latest-saved) latest=1; shift ;;
      --essential) rargs+=(--essential "$root/test/java/essential.txt"); shift ;;
      --record) rargs+=(--record); shift ;;
      --partial) partial=1; shift ;;
      --levels) levels=$2; shift 2 ;;
      --held) rargs+=(--held "$2"); shift 2 ;;
      *) break ;;
    esac
  done
  # JCV1: --latest-saved, the newest saved results of each of the gate's Java level steps' parts in the store of
  # passes (ARBACE_GATE_STORE, default the main checkout's .tmp/gate-pass/): the whole corpus judged again from
  # saved runs alone (the night's re-judgment, bin/java-check --judge [--oracle] --latest-saved)
  if [ -n "$latest" ]; then
    store=$(gate_store)
    local o why
    for st in java-read java-interp java-classes java-diagnostics java-compiled-full java-print; do
      for d in "$store/$st".*; do
        case $d in *.sub) continue ;; esac
        [ -d "$d" ] || continue
        # queue 485: the newest saved results that hold none of the run's own errors and whose log shows no plan
        # missing (saved_bad); a newer one that does is named and passed over
        f=""
        for o in $(ls -td "$d"/*.out 2>/dev/null); do
          [ -f "$o/results.tsv" ] || continue
          if why=$(saved_bad "$o"); then echo "java-check --judge --latest-saved: $o passed over: $why" >&2; continue; fi
          f=$o; break
        done
        [ -n "$f" ] && saved+=("$f/results.tsv")
      done
    done
    [ ${#saved[@]} -gt 0 ] || { echo "java-check --judge --latest-saved: no saved results in $store" >&2; return 1; }
    set -- "$@" "${saved[@]}"
  fi
  [ $# -gt 0 ] || { echo "java-check --judge: no results" >&2; return 2; }
  rm -rf "$work/judge"; mkdir -p "$work/judge"
  for f in "$@"; do [ -f "$f" ] || { echo "java-check --judge: no results $f" >&2; return 1; }; done
  # the levels saved under the audit (--save's marker beside a results file), by file (queue 093, report 088
  # finding 5): a level is audited only when every results file with rows at it is marked for it; one
  # unmarked file of a level (an untraced run judged with a traced one) makes the level unaudited, the
  # stricter judgment, since the held timeouts could be that file's
  local lvf=$work/judge/levels-by-file m l
  for f in "$@"; do
    d=$(dirname "$f") m=","
    if [ -f "$d/audited" ]; then m=",$(tr '\n' ',' < "$d/audited"),"; fi
    for l in $(cut -f2 "$f" | sed 's/\.jdk$//' | LC_ALL=C sort -u); do
      case $m in *",$l,"*) echo "$l yes" ;; *) echo "$l no" ;; esac
    done
  done > "$lvf"
  aud=$(awk '$2 == "yes" { y[$1] = 1 } $2 == "no" { n[$1] = 1 } END { for (l in y) if (!(l in n)) print l }' "$lvf" | LC_ALL=C sort | paste -sd, -)
  local mixed; mixed=$(awk '$2 == "yes" { y[$1] = 1 } $2 == "no" { n[$1] = 1 } END { for (l in y) if (l in n) print l }' "$lvf" | LC_ALL=C sort | paste -sd, -)
  if [ -n "$mixed" ]; then
    echo "java-check --judge: the levels $mixed have marked and unmarked results files: judged as unaudited"
  fi
  if [ -n "$aud" ]; then
    rargs+=(--audited "$aud"); echo "java-check --judge: the levels $aud ran under the audit"
  fi
  LC_ALL=C sort "$@" > "$work/judge/results.tsv"
  if [ -z "$levels" ]; then
    levels=$( { cut -f2 "$work/judge/results.tsv" | sed 's/\.jdk$//'
                for f in "$@"; do [ ! -f "$(dirname "$f")/levels" ] || tr ',' '\n' < "$(dirname "$f")/levels"; done; } \
              | { grep -v '^$' || true; } | LC_ALL=C sort -u | paste -sd, -)
  fi
  [ -n "$levels" ] || { echo "java-check --judge: no level to judge ($*: no rows, no levels file beside them; --levels names them)" >&2; return 1; }
  for f in "$@"; do [ ! -e "$(dirname "$f")/partial" ] || partial=1; done
  [ -z "$partial" ] || rargs+=(--partial)
  # GT8: whole runs of corpora (the gate's parts, a corpus marker beside each results file): judged whole within their
  # corpora; a results file without a marker is a run of every corpus, and then no restriction
  local cs="" whole=""
  for f in "$@"; do
    if [ -f "$(dirname "$f")/corpus" ]; then cs="$cs $(paste -sd' ' "$(dirname "$f")/corpus")"
    elif [ ! -e "$(dirname "$f")/partial" ]; then whole=1; fi
  done
  if [ -z "$partial" ] && [ -z "$whole" ] && [ -n "${cs// /}" ]; then
    rargs+=(--corpora "$(echo $cs | tr ' ' '\n' | LC_ALL=C sort -u | paste -sd, -)")
  fi
  if [ -n "$oracle" ]; then
    # JCV1: the oracle tier's judgment has records of its own (test/java/oracle/check-LEVEL.edn: the JDK's record's
    # judgment) at the levels the own verdict changed alone, interp, compiled and classes
    levels=$(echo "$levels" | tr ',' '\n' | grep -xE 'interp|compiled|classes' | paste -sd, -)
    [ -n "$levels" ] || { echo "java-check --judge --oracle: none of the levels interp, compiled, classes in $*" >&2; return 1; }
  fi
  echo "java-check --judge: $(wc -l < "$work/judge/results.tsv") results at the levels $levels ($*)${oracle:+, the oracle tier's judgment (the JDK's record, JCV1)}"
  jc report "$ref" "$work/judge" "$root/test/java/divergences.edn" "$checkdir" "$levels" ${rargs[@]+"${rargs[@]}"}
}

case ${1:-} in
  -h|--help|help) usage ;;
  --judge) shift; judge_saved "$@" ;;
  --record-ref) shift; record_ref "$@" ;;
  --forms) shift; forms_cmd "$@" ;;
  --essential-compiled) shift; essential_compiled "$@" ;;
  scan) check_pin; mkdir -p "$work/scan"; jc scan "$jdktest" "$corpora" "$ref" "$work/scan" ;;
  sources) shift; own_sources "$@" ;;
  rejudge-records) jc rejudge-records "$ref" "$root/test/java" "$root/test/java/oracle" ;;
  --stale-reasons) shift; [ $# -ge 1 ] || usage; jc stale-reasons "$root" "$@" ;;
  golden) shift; jc golden "$ref" "$root/test/java/jls/golden.edn" --jdktest "$jdktest" "$@" ;;
  saved-errors) shift; saved_errors "$@" ;;
  verdicts) shift; check_pin; jc verdicts "$jdktest" "$ref" "$root/test/java/verdicts.edn" "$@" ;;
  *) check "$@" ;;
esac

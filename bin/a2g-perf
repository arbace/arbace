#!/bin/bash
# a2g's micro benchmarks (doc/go/A2G-NOTES.md, "Phase 2D"): test/a2g/bench/BnWork.ae's
# workloads on the JVM Arbace and translated by a2g into Go (linux/amd64), with a table of
# ns per element and the ratio.
#
# Usage: bin/a2g-perf [--only NAME,...] [--jvm-only|--go-only] [-- A2G-OPTIONS]
# Environment: A2G_PERF_OUT (default .tmp/a2g/perf), A2G_PERF_SECS (default 2),
#   A2G_JVM_OPTS (default -Xmx8g), GOGC (passed to the Go program).
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tools.bash"
arbace_runtime
cd "$root"
conv=${JRT_CONV:-$root/.tmp/jrt/conv}
[ -d "$conv" ] || { echo "bin/a2g-perf: no $conv; run bin/jrt-convert first" >&2; exit 1; }
# shellcheck disable=SC2086
exec java -Xss64m ${A2G_JVM_OPTS:--Xmx8g} --add-modules ALL-SYSTEM -cp "$ARBACE_CP:$root/test" arbace.lang.Main -m a2g.perf "$@"

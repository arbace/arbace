#!/bin/bash
# g2c, Go as Arbace forms: the front end helper tools/godump and its reading on Arbace.
# See doc/go/HELPER-NOTES.md.
#
#   bin/g2c build                 build the helper into .tmp/godump/godump (TamaGo's go)
#   bin/g2c dump [FLAGS] ARGS...  run the helper (built first): godump's flags and packages, or
#                                 -files and single-file programs; output in -o DIR (default
#                                 .tmp/godump/out), one .edn per package
#   bin/g2c read [--jobs N] [--quiet] FILE|DIR...
#                                 read dumps with Arbace's reader (arbace.g2c.read), print a
#                                 summary; needs a prior bin/build-arbace
#   bin/g2c corpus [CORPUS]...
#                                 dump a corpus into .tmp/godump/corpus/CORPUS, then read every
#                                 dump on Arbace. CORPUS is [GOOS-]WHAT, GOOS tamago (the
#                                 default, no prefix) or linux, WHAT one of: amd64, arm64 (std
#                                 outside cmd for GOOS/ARCH), test, test-arm64 ($GOROOT/test's
#                                 single-file programs, the oracle's list, bin/g2c-check
#                                 --list-tests, for amd64 or arm64), tests (std for GOOS/amd64
#                                 with its _test.go files, godump -tests). Default: amd64 arm64
#                                 test. E.g. linux-amd64, linux-test-arm64. cgo is off.
#   bin/g2c convert [--full] [--tests] [--goos GOOS] [--goarch ARCH] [--out DIR] PKG...
#                                 dump the packages (godump [-tests], for GOOS/ARCH, default
#                                 tamago/amd64) into .tmp/g2c/dumps, then
#                                 convert them to Go forms (arbace.g2c.main) under DIR (default
#                                 .tmp/g2c/forms/pkgs), each file read back and checked
#   bin/g2c convert [--full] --corpus CORPUS
#                                 convert a corpus of `bin/g2c corpus` (dumped first if missing)
#                                 into .tmp/g2c/forms/CORPUS[-full]; report in
#                                 .tmp/g2c/forms/CORPUS[-full].report.edn
#   bin/g2c roundtrip [[GOOS/]ARCH] [--goos GOOS] [--record]
#                                 the round trip: convert std and $GOROOT/test's programs for
#                                 GOOS/ARCH (default tamago/amd64; GOOS tamago or linux, ARCH
#                                 amd64 or arm64), print the forms (arbace.g2c.print) into the
#                                 candidate .tmp/g2c/cand-ARCH (tamago) or cand-GOOS-ARCH, and
#                                 compare with bin/g2c-check against the reference
#                                 test/g2c/roundtrip-ARCH.edn (tamago) or
#                                 roundtrip-GOOS-ARCH.edn: exits non-zero on a regression (an
#                                 entry and level passing there and not now). --record writes
#                                 the results as the new reference. --tests: std for
#                                 tamago/amd64 with its _test.go files (corpus tests) into
#                                 .tmp/g2c/cand-tests, checked with g2c-check --with-tests,
#                                 reference test/g2c/roundtrip-tests.edn, known differences
#                                 (with reasons) test/g2c/roundtrip-tests-known.edn
#   bin/g2c print ARGS...         the printer (bin/g2c-print, arbace.g2c.print)
#   bin/g2c test                  the converter's tests (test/g2c/convert_test.clj and the spec's
#                                 examples, test/g2c/convert/)
#
# Environment: G2C_GOROOT, the TamaGo Go tree (go1.27.1, default /root/tamago-go), also for
# linux (its std differs from upstream's only by build constraints and GOOS tables);
# G2C_JVM_OPTS, the JVM's heap options for read (default -Xmx16g).
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
goroot=${G2C_GOROOT:-/root/tamago-go}
work=$root/.tmp/godump
helper=$work/godump

build() {
  if [ ! -x "$goroot/bin/go" ]; then
    echo "no $goroot/bin/go: set G2C_GOROOT to TamaGo's Go tree (go1.27.1)" >&2
    return 1
  fi
  mkdir -p "$work"
  # for the host: GOOS=tamago is the configuration of the code converted, not of the helper
  (cd "$root/tools/godump" &&
     env -u GOOS -u GOARCH GOROOT="$goroot" GOFLAGS= GOTOOLCHAIN=local CGO_ENABLED=0 \
       "$goroot/bin/go" build -trimpath -o "$helper" .)
}

godump() {
  GOROOT="$goroot" "$helper" -go "$goroot/bin/go" "$@"
}

has_out_flag() {
  local a
  for a in "$@"; do
    case $a in -o|-o=*|--o|--o=*) return 0 ;; esac
  done
  return 1
}

read_dumps() {
  . "$root/bin/lib/tools.bash"
  # arbace.g2c loads from source, like arbace.j2c: not a stale runtime
  arbace_runtime
  # shellcheck disable=SC2086
  java ${G2C_JVM_OPTS:--Xmx16g} -Xss16m -cp "$ARBACE_CP" arbace.lang.Main -m arbace.g2c.read "$@"
}

# The single-file programs of $GOROOT/test for tamago/ARCH: the oracle's list (bin/g2c-check
# --list-tests, `gocmp tests`), so that the helper's corpus and the oracle's agree: Go's test
# driver's directories and actions that compile one program, no other GOEXPERIMENT, build
# constraints and file names matched by go/build. Extra .go files named on the action line
# join the program (FILE,FILE). Prints one argument per line.
test_programs() {
  "$root/bin/g2c-check" --arch "$1" --list-tests
}

# corpus_config CORPUS: sets cgoos, cwhat (amd64, arm64, test, test-arm64, tests) and carch
corpus_config() {
  cgoos=tamago
  cwhat=$1
  case $1 in
    tamago-*) cwhat=${1#tamago-} ;;
    linux-*) cgoos=linux; cwhat=${1#linux-} ;;
  esac
  case $cwhat in
    amd64|test|tests) carch=amd64 ;;
    arm64|test-arm64) carch=arm64 ;;
    *) echo "corpus: [linux-]amd64, arm64, test, test-arm64 or tests, not $1" >&2; return 2 ;;
  esac
}

# corpus_name GOOS WHAT: the corpus's directory name (tamago's without a prefix)
corpus_name() {
  if [ "$1" = tamago ]; then echo "$2"; else echo "$1-$2"; fi
}

corpus() {
  local what out t0 t1 cgoos cwhat carch name
  build
  [ $# -gt 0 ] || set -- amd64 arm64 test
  mkdir -p "$work/corpus"
  for what in "$@"; do
    corpus_config "$what"
    name=$(corpus_name "$cgoos" "$cwhat")
    out=$work/corpus/$name
    rm -rf "$out"
    t0=$(date +%s.%N)
    case $cwhat in
      amd64|arm64)
        godump -goos "$cgoos" -goarch "$carch" -o "$out" std > "$out.tsv" || true ;;
      tests)
        godump -tests -goos "$cgoos" -goarch "$carch" -o "$out" std > "$out.tsv" || true ;;
      test|test-arm64)
        G2C_GOOS=$cgoos test_programs "$carch" > "$work/corpus/$name-programs.txt"
        (cd "$goroot/test" && xargs -a "$work/corpus/$name-programs.txt" \
           env GOROOT="$goroot" "$helper" -go "$goroot/bin/go" -goos "$cgoos" -goarch "$carch" -files -o "$out") \
          > "$out.tsv" || true ;;
    esac
    t1=$(date +%s.%N)
    awk -F'\t' -v what="$name" -v secs="$(echo "$t1 - $t0" | bc)" '
      { n[$1]++ } $1 == "ok" || $1 == "errors" { files += $3; bytes += $4 } $4 > max { max = $4; big = $2 }
      END { printf "%s: %d dumped (%d ok, %d with type errors, %d failed, %d excluded by the configuration), %d files, %.1f MB (largest %s, %.1f MB), %.1f s\n",
            what, n["ok"] + n["errors"], n["ok"], n["errors"], n["fail"], n["excluded"], files, bytes / 1e6, big, max / 1e6, secs }' "$out.tsv"
    grep -v -P '^(ok|excluded)\t' "$out.tsv" || true
  done
  for what in "$@"; do
    corpus_config "$what"
    name=$(corpus_name "$cgoos" "$cwhat")
    echo "reading $name on Arbace:"
    read_dumps --jobs "$(nproc)" --quiet "$work/corpus/$name"
  done
}

convert_main() {
  . "$root/bin/lib/tools.bash"
  arbace_runtime
  # shellcheck disable=SC2086
  java ${G2C_JVM_OPTS:--Xmx12g} -Xss64m -cp "$ARBACE_CP" arbace.lang.Main -m arbace.g2c.main convert "$@"
}

convert() {
  local full="" tests="" out="" corpus="" print="" jobs cfg=()
  jobs=${G2C_JOBS:-$(( $(nproc) / 2 ))}
  while [ $# -gt 0 ]; do
    case $1 in
      --full) full=--full; shift ;;
      --tests) tests=-tests; shift ;;
      --out) out=$2; shift 2 ;;
      --corpus) corpus=$2; shift 2 ;;
      --print) print=$2; shift 2 ;;
      --goos) cfg+=(-goos "$2"); shift 2 ;;
      --goarch) cfg+=(-goarch "$2"); shift 2 ;;
      *) break ;;
    esac
  done
  if [ -n "$corpus" ]; then
    local cgoos cwhat carch
    corpus_config "$corpus"
    corpus=$(corpus_name "$cgoos" "$cwhat")
    local dumps=$work/corpus/$corpus
    [ -d "$dumps" ] || corpus "$corpus"
    out=${out:-$root/.tmp/g2c/forms/$corpus${full:+-full}}
    rm -rf "$out"
    convert_main --out "$out" --jobs "$jobs" --goroot "$goroot" --quiet $full ${print:+--print "$print"} \
      --report "$out.report.edn" "$dumps"
  else
    [ $# -gt 0 ] || { echo "convert: packages or --corpus" >&2; return 2; }
    build
    local dumps=$root/.tmp/g2c/dumps
    rm -rf "$dumps"
    mkdir -p "$dumps"
    godump $tests ${cfg[@]+"${cfg[@]}"} -o "$dumps" "$@" > "$dumps.tsv" || true
    out=${out:-$root/.tmp/g2c/forms/pkgs}
    convert_main --out "$out" --jobs "$jobs" --goroot "$goroot" $full ${print:+--print "$print"} "$dumps"
  fi
}

roundtrip() {
  local goos=tamago arch=amd64 record="" cand ref t0 t1 t2 status with_tests="" check prefix
  while [ $# -gt 0 ]; do
    case $1 in
      amd64|arm64) arch=$1; shift ;;
      tamago/amd64|tamago/arm64|linux/amd64|linux/arm64) goos=${1%/*}; arch=${1#*/}; shift ;;
      --goos) goos=$2; shift 2 ;;
      --record) record=1; shift ;;
      --tests) with_tests=1; shift ;;
      *) echo "roundtrip: [[GOOS/]amd64|arm64] [--goos tamago|linux] [--tests] [--record], not $1" >&2; return 2 ;;
    esac
  done
  case $goos in
    tamago) prefix= ;;
    linux) prefix=linux- ;;
    *) echo "roundtrip: GOOS tamago or linux, not $goos" >&2; return 2 ;;
  esac
  cand=$root/.tmp/g2c/cand-$prefix$arch
  ref=$root/test/g2c/roundtrip-$prefix$arch.edn
  check=("$root/bin/g2c-check" --goos "$goos" --arch "$arch")
  if [ -n "$with_tests" ]; then
    [ "$goos/$arch" = tamago/amd64 ] || { echo "roundtrip --tests: tamago/amd64 only (the corpus tests)" >&2; return 2; }
    cand=$root/.tmp/g2c/cand-tests
    ref=$root/test/g2c/roundtrip-tests.edn
    check+=(--with-tests --no-tests --known "$root/test/g2c/roundtrip-tests-known.edn")
  fi
  rm -rf "$cand"
  t0=$(date +%s.%N)
  if [ -n "$with_tests" ]; then
    convert --corpus tests --print "$cand" || true
  else
    local tests=test
    [ "$arch" = arm64 ] && tests=test-arm64
    convert --corpus "$prefix$arch" --print "$cand" || true
    convert --corpus "$prefix$tests" --print "$cand" || true
  fi
  t1=$(date +%s.%N)
  status=0
  if [ -n "$record" ]; then
    "${check[@]}" --record "$ref" "$cand" || status=$?
  elif [ -f "$ref" ]; then
    "${check[@]}" --reference "$ref" "$cand" || status=$?
  else
    echo "no reference ${ref#$root/} (bin/g2c roundtrip ... --record): any failure fails" >&2
    "${check[@]}" "$cand" || status=$?
  fi
  t2=$(date +%s.%N)
  printf 'roundtrip %s: convert and print %.1f s, check %.1f s\n' "$goos/$arch${with_tests:+ with tests}" \
    "$(echo "$t1 - $t0" | bc)" "$(echo "$t2 - $t1" | bc)"
  return $status
}

cmd=${1:-}
[ $# -gt 0 ] && shift
case $cmd in
  build) build ;;
  dump)
    build
    if has_out_flag "$@"; then godump "$@"; else godump -o "$work/out" "$@"; fi ;;
  read) read_dumps "$@" ;;
  corpus) corpus "$@" ;;
  convert) convert "$@" ;;
  roundtrip) roundtrip "$@" ;;
  print) exec "$root/bin/g2c-print" "$@" ;;
  test) exec "$root/bin/g2c-convert-tests" "$@" ;;
  *) sed -n '2,/^set -/p' "$0" | sed '$d; s/^# \{0,1\}//' >&2; exit 2 ;;
esac

#!/bin/bash
# g2c, Go as Arbace forms: the front end helper tools/godump and its reading on Arbace.
# See doc/go/HELPER-NOTES.md.
#
#   bin/g2c build                 build the helper into .tmp/godump/godump (TamaGo's go)
#   bin/g2c dump [FLAGS] ARGS...  run the helper (built first): godump's flags and packages, or
#                                 -files and single-file programs; output in -o DIR (default
#                                 .tmp/godump/out), one .edn per package
#   bin/g2c read [--jobs N] [--quiet] FILE|DIR...
#                                 read dumps with Arbace's reader (arbace.g2c.read), print a
#                                 summary; needs a prior bin/build-arbace
#   bin/g2c corpus [amd64|arm64|test|tests]...
#                                 dump $GOROOT/src outside cmd (std) for tamago/amd64 and
#                                 tamago/arm64, $GOROOT/test's single-file programs, and (tests,
#                                 not by default) std for tamago/amd64 with its _test.go files
#                                 (godump -tests), into .tmp/godump/corpus/, then read every
#                                 dump on Arbace
#   bin/g2c convert [--full] [--tests] [--out DIR] PKG...
#                                 dump the packages (godump [-tests]) into .tmp/g2c/dumps, then
#                                 convert them to Go forms (arbace.g2c.main) under DIR (default
#                                 .tmp/g2c/forms/pkgs), each file read back and checked
#   bin/g2c convert [--full] --corpus amd64|arm64|test|tests
#                                 convert a corpus of `bin/g2c corpus` (dumped first if missing)
#                                 into .tmp/g2c/forms/CORPUS[-full]; report in
#                                 .tmp/g2c/forms/CORPUS[-full].report.edn
#   bin/g2c roundtrip [amd64|arm64]
#                                 the round trip: convert std (and, for amd64, $GOROOT/test),
#                                 print the forms (arbace.g2c.print) into the candidate
#                                 .tmp/g2c/cand-ARCH, and compare with bin/g2c-check
#   bin/g2c print ARGS...         the printer (bin/g2c-print, arbace.g2c.print)
#   bin/g2c test                  the converter's tests (test/g2c/convert_test.clj and the spec's
#                                 examples, test/g2c/convert/)
#
# Environment: G2C_GOROOT, the TamaGo Go tree (go1.27.1, default /root/tamago-go);
# G2C_JVM_OPTS, the JVM's heap options for read (default -Xmx16g).
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
goroot=${G2C_GOROOT:-/root/tamago-go}
work=$root/.tmp/godump
helper=$work/godump

build() {
  if [ ! -x "$goroot/bin/go" ]; then
    echo "no $goroot/bin/go: set G2C_GOROOT to TamaGo's Go tree (go1.27.1)" >&2
    return 1
  fi
  mkdir -p "$work"
  # for the host: GOOS=tamago is the configuration of the code converted, not of the helper
  (cd "$root/tools/godump" &&
     env -u GOOS -u GOARCH GOROOT="$goroot" GOFLAGS= GOTOOLCHAIN=local CGO_ENABLED=0 \
       "$goroot/bin/go" build -trimpath -o "$helper" .)
}

godump() {
  GOROOT="$goroot" "$helper" -go "$goroot/bin/go" "$@"
}

has_out_flag() {
  local a
  for a in "$@"; do
    case $a in -o|-o=*|--o|--o=*) return 0 ;; esac
  done
  return 1
}

read_dumps() {
  . "$root/bin/lib/tools.bash"
  # arbace.g2c loads from source, like arbace.j2c: not a stale runtime
  arbace_runtime
  # shellcheck disable=SC2086
  java ${G2C_JVM_OPTS:--Xmx16g} -Xss16m -cp "$ARBACE_CP" arbace.lang.Main -m arbace.g2c.read "$@"
}

# The single-file programs of $GOROOT/test, as Go's test driver (cmd/internal/testdir) finds
# them: the .go files of its directories whose action compiles one program (run, compile,
# build, runoutput, buildrun, asmcheck). Extra .go files named on the action line join the
# program (FILE,FILE). Programs needing another GOEXPERIMENT are left out (another
# configuration). Prints one argument per line.
test_programs() {
  local d f line action extra
  cd "$goroot/test"
  for d in . ken chan interface internal/runtime/sys syntax dwarf fixedbugs codegen abi \
           typeparam typeparam/mdempsky arenas simd; do
    for f in "$d"/*.go; do
      [ -f "$f" ] || continue
      line=$(awk 'NF && !/^\/\/go:build/ && !/^\/\/ \+build/ {print; exit}' "$f")
      action=$(echo "$line" | awk '{print $2}')
      case $action in run|compile|build|runoutput|buildrun|asmcheck) ;; *) continue ;; esac
      case $line in *-goexperiment*) echo "skip-config ${f#./}" >&2; continue ;; esac
      extra=$(echo "$line" | tr ' ' '\n' | grep '\.go$' | grep -v '^\./' | paste -sd, - || true)
      echo "${f#./}${extra:+,$extra}"
    done
  done
}

corpus() {
  local what out t0 t1
  build
  [ $# -gt 0 ] || set -- amd64 arm64 test
  mkdir -p "$work/corpus"
  for what in "$@"; do
    out=$work/corpus/$what
    rm -rf "$out"
    t0=$(date +%s.%N)
    case $what in
      amd64|arm64)
        godump -goarch "$what" -o "$out" std > "$out.tsv" || true ;;
      tests)
        godump -tests -goarch amd64 -o "$out" std > "$out.tsv" || true ;;
      test)
        test_programs > "$work/corpus/test-programs.txt" 2> "$work/corpus/test-skipped.txt"
        (cd "$goroot/test" && xargs -a "$work/corpus/test-programs.txt" \
           env GOROOT="$goroot" "$helper" -go "$goroot/bin/go" -files -o "$out") \
          > "$out.tsv" || true ;;
      *) echo "corpus: amd64, arm64, test or tests, not $what" >&2; return 2 ;;
    esac
    t1=$(date +%s.%N)
    awk -F'\t' -v what="$what" -v secs="$(echo "$t1 - $t0" | bc)" '
      { n[$1]++ } $1 == "ok" || $1 == "errors" { files += $3; bytes += $4 } $4 > max { max = $4; big = $2 }
      END { printf "%s: %d dumped (%d ok, %d with type errors, %d failed, %d excluded by the configuration), %d files, %.1f MB (largest %s, %.1f MB), %.1f s\n",
            what, n["ok"] + n["errors"], n["ok"], n["errors"], n["fail"], n["excluded"], files, bytes / 1e6, big, max / 1e6, secs }' "$out.tsv"
    grep -v -P '^(ok|excluded)\t' "$out.tsv" || true
  done
  for what in "$@"; do
    echo "reading $what on Arbace:"
    read_dumps --jobs "$(nproc)" --quiet "$work/corpus/$what"
  done
}

convert_main() {
  . "$root/bin/lib/tools.bash"
  arbace_runtime
  # shellcheck disable=SC2086
  java ${G2C_JVM_OPTS:--Xmx12g} -Xss64m -cp "$ARBACE_CP" arbace.lang.Main -m arbace.g2c.main convert "$@"
}

convert() {
  local full="" tests="" out="" corpus="" print="" jobs
  jobs=${G2C_JOBS:-$(( $(nproc) / 2 ))}
  while [ $# -gt 0 ]; do
    case $1 in
      --full) full=--full; shift ;;
      --tests) tests=-tests; shift ;;
      --out) out=$2; shift 2 ;;
      --corpus) corpus=$2; shift 2 ;;
      --print) print=$2; shift 2 ;;
      *) break ;;
    esac
  done
  if [ -n "$corpus" ]; then
    local dumps=$work/corpus/$corpus
    [ -d "$dumps" ] || corpus "$corpus"
    out=${out:-$root/.tmp/g2c/forms/$corpus${full:+-full}}
    rm -rf "$out"
    convert_main --out "$out" --jobs "$jobs" --goroot "$goroot" --quiet $full ${print:+--print "$print"} \
      --report "$out.report.edn" "$dumps"
  else
    [ $# -gt 0 ] || { echo "convert: packages or --corpus" >&2; return 2; }
    build
    local dumps=$root/.tmp/g2c/dumps
    rm -rf "$dumps"
    mkdir -p "$dumps"
    godump $tests -o "$dumps" "$@" > "$dumps.tsv" || true
    out=${out:-$root/.tmp/g2c/forms/pkgs}
    convert_main --out "$out" --jobs "$jobs" --goroot "$goroot" $full ${print:+--print "$print"} "$dumps"
  fi
}

roundtrip() {
  local arch=${1:-amd64} cand
  cand=$root/.tmp/g2c/cand-$arch
  rm -rf "$cand"
  convert --corpus "$arch" --print "$cand" || true
  if [ "$arch" = amd64 ]; then
    convert --corpus test --print "$cand" || true
    "$root/bin/g2c-check" --arch "$arch" "$cand"
  else
    "$root/bin/g2c-check" --arch "$arch" --no-tests "$cand"
  fi
}

cmd=${1:-}
[ $# -gt 0 ] && shift
case $cmd in
  build) build ;;
  dump)
    build
    if has_out_flag "$@"; then godump "$@"; else godump -o "$work/out" "$@"; fi ;;
  read) read_dumps "$@" ;;
  corpus) corpus "$@" ;;
  convert) convert "$@" ;;
  roundtrip) roundtrip "$@" ;;
  print) exec "$root/bin/g2c-print" "$@" ;;
  test) exec "$root/bin/g2c-convert-tests" "$@" ;;
  *) sed -n '2,/^set -/p' "$0" | sed '$d; s/^# \{0,1\}//' >&2; exit 2 ;;
esac

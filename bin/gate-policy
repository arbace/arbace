#!/bin/bash
# The gate's disk and memory policy as the tools ask it (GD4: doc/GATE-DIET-SURVEY.md, GDS12 (a), GDS13 (a), "As built: GD4").
# The gate owns the disk and the memory: its runner (bin/lib/gate-run.bash) admits each step by the free disk (a floor,
# GATE_DISK_FLOOR, and the step's :disk-gib: below them the step is deferred, not failed) and by its memory (the larger of
# its declared :mem-gib and 1.1 x its recorded peak), exports ARBACE_DISK_POLICY=gate and GATE_STEP_MEM_GIB (that admission,
# GiB) into the step, and the tools' own guards yield to it:
#   bin/gate-policy mem DEFAULT     a tool's GOMEMLIMIT default (DEFAULT, e.g. 6GiB or 1500MiB) printed as it is, or capped at
#                                   the step's admission (GATE_STEP_MEM_GIB) when that is smaller: a process of the step is
#                                   never given a soft limit above what the step was admitted with. Outside the gate (no
#                                   GATE_STEP_MEM_GIB): DEFAULT. A tool's own variable (CPPI_CI_MEMLIMIT, ...) still wins
#   bin/gate-policy disk-ok PCT     exit 0 when the tool may go on writing: always under ARBACE_DISK_POLICY=gate (the gate's
#                                   floor decides, before the step), else when the checkout's disk is at most PCT% full; exit 3
#                                   with a line on stderr when not (cppi's and rsi's light-tier guards)
# Not in any key: it reads the environment only (bin/ outside gate_key's build scripts).
set -u
root=$(cd "$(dirname "$0")/.." && pwd)
case ${1:-} in
  mem)
    d=${2:?usage: bin/gate-policy mem DEFAULT}
    g=${GATE_STEP_MEM_GIB:-}
    [ -n "$g" ] || { printf '%s\n' "$d"; exit 0; }
    awk -v d="$d" -v g="$g" 'BEGIN {
      v = d; u = d; sub(/[A-Za-z]+$/, "", v); sub(/^[0-9.]+/, "", u)
      m = (u == "GiB") ? v * 1024 : (u == "MiB") ? v : (u == "KiB") ? v / 1024 : (u == "" || u == "B") ? v / 1048576 : -1
      c = int(g * 1024)
      if (m < 0 || c <= 0 || m <= c) print d; else print c "MiB" }' ;;
  disk-ok)
    p=${2:?usage: bin/gate-policy disk-ok PCT}
    [ "${ARBACE_DISK_POLICY:-}" = gate ] && exit 0
    u=$(df --output=pcent "$root" | tail -1 | tr -dc 0-9)
    [ "$u" -le "$p" ] && exit 0
    echo "the disk is at $u% (more than $p%), stopping (outside the gate; under it the gate's floor decides)" >&2
    exit 3 ;;
  *) sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac

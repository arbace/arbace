#!/bin/bash
# Run the tests of the class forms native to Arbace (test/native/*_test.clj, doc/classes/SPEC.md
# §9.5) on a stage of the bootstrap built by bin/build-arbace: the stage's runtime with
# arbace.test, no boot step.
# Usage: bin/native-tests [STAGE] [TEST-NAMESPACE...]   default stage 1, all of test/native
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"
stage=${1:-1}
[ $# -gt 0 ] && shift
if [ $# -eq 0 ]; then
  set -- $(cd test && ls native/*_test.clj | sed 's/\.clj$//; s/_/-/g; s/\//./g')
fi
nss=""
for n in "$@"; do nss="$nss '$n"; done
# -XX:-OmitStackTraceInFastThrow: C2 throws a frequent implicit NullPointerException as a
# preallocated one without a message, and the reflection tests compare messages (they failed
# about one run in five under load)
exec java -Xss16m -XX:-OmitStackTraceInFastThrow -Darbace.tmp="$root/.tmp" -cp "$root/target/stage$stage:$root:$root/test" arbace.lang.Main -e "
(require 'arbace.test)
(apply require [$nss])
(let [r (apply arbace.test/run-tests [$nss])]
  (shutdown-agents)
  (System/exit (if (zero? (+ (:fail r) (:error r))) 0 1)))"

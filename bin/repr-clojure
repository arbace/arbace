#!/bin/bash
# repr/clojure, Clojure's bridge (doc/REPR-CLOJURE.md; c2a until 2026-10-17): Clojure source read
# into Arbace's (read) and Arbace's printed back as Clojure (print), run on Arbace's Go executable
# (bin/lib/tools.bash's arbace_tool: the host of the tools), arbace.repr.clojure loaded from the
# checkout.
#
#   bin/repr-clojure read [OPTION...] -o OUT SRC...       translate files and trees into OUT
#   bin/repr-clojure read --in-place [OPTION...] SRC...   translate them where they are
#   bin/repr-clojure read --stdin [--kind K] [--ae]       standard input to standard output
#   bin/repr-clojure read --rules                         the rules, how print reverses each,
#                                                         and the dialect divergences
#   bin/repr-clojure print [OPTION...] -o OUT SRC...      print Arbace files and trees as Clojure
#                                                         into OUT (x.ae becomes x.clj)
#   bin/repr-clojure print --in-place [OPTION...] SRC...  print them where they are
#   bin/repr-clojure print --stdin [--kind K] [--ae]      standard input to standard output
#                       Options: --keep-ext (read), --full (read: a .cljc's conditionals
#                       recorded in the .ae, which print gives back as the .cljc byte for
#                       byte), --text EXT, --skip ID,..., -q
#                       (arbace.repr.clojure's doc string).
#   bin/repr-clojure roundtrip [--keep-ext | --full] [--from-arbace] [--known EDN --corpus NAME] [-v] SRC...
#                       read then print each tree in memory (--from-arbace: print then read),
#                       every file back byte for byte, but the known differences
#   bin/repr-clojure check [--suite | --roundtrip | --libs [GO-EXE]]
#                       the bridge's checks (bin/lib/repr-clojure/check, its header): the unit
#                       tests, Clojure's suite translated against test/repr/clojure/suite.sha256
#                       and printed back, the round trips, the suite's libraries
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/renamed-env.bash" # stops on a stale G2A_*, J2A_*, A2G_* or C2A_*
cmd=${1:-}
[ $# -gt 0 ] && shift
case $cmd in
  read|print|roundtrip) ;;
  check) exec "$root/bin/lib/repr-clojure/check" "$@" ;;
  *) sed -n '2,/^set -/p' "$0" | sed '$d; s/^# \{0,1\}//' >&2; exit 2 ;;
esac
. "$root/bin/lib/tools.bash"
# arbace.repr.clojure is embedded in the executable: its namespaces load from the checkout instead
arbace_tool "${repr_clojure_sources[@]}" -m arbace.repr.clojure "$cmd" "$@"

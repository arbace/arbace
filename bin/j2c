#!/bin/sh
# Run Clojure (the vendored clojure/ tree) with access to javac internals.
# Usage: bin/j2c [clojure.main args...]; bin/j2c -m arbace.j2c.main ... converts Java to class forms.
root=$(cd "$(dirname "$0")/.." && pwd)
exports=""
for p in api tree util parser code file main comp jvm; do
  exports="$exports --add-exports jdk.compiler/com.sun.tools.javac.$p=ALL-UNNAMED --add-opens jdk.compiler/com.sun.tools.javac.$p=ALL-UNNAMED"
done
exec java -Xss64m $exports -cp "$root" clojure.main "$@"

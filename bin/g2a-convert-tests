#!/bin/bash
# Tests of g2a's converter (test/g2a/convert_test.ae, doc/go/CONVERTER-NOTES.md): dumps the
# Go inputs with the helper (test/g2a/convert/*.go and units/*.go as single files, sort and
# unicode/utf8 from std) into .tmp/g2a-convert-tests/dumps, then runs the tests on Arbace's
# Go executable (bin/lib/tools.bash's arbace_tool: the tools' host).
# Usage: bin/g2a-convert-tests [--regen]
#   --regen  rewrite the expected forms of the unit files (test/g2a/convert/expected/units/)
#            from the converter's output, without layout metadata; review the diff
set -euo pipefail
export CGO_ENABLED=0 # Go's builds never use cgo (doc/go/BOX-NOTES.md, "... cgo dropped", 2026-10-16)
root=$(cd "$(dirname "$0")/.." && pwd)
goroot=${G2A_GOROOT:-/root/tamago-go}
work=$root/.tmp/g2a-convert-tests
"$root/bin/g2a" build
rm -rf "$work/dumps"
mkdir -p "$work/dumps/std"
(cd "$root/test/g2a/convert" &&
   GOROOT="$goroot" "$root/.tmp/godump/godump" -go "$goroot/bin/go" -files -o "$work/dumps" \
     sample.go search.go units/*.go > "$work/dumps.tsv")
GOROOT="$goroot" "$root/.tmp/godump/godump" -go "$goroot/bin/go" -o "$work/dumps/std" \
  sort unicode/utf8 >> "$work/dumps.tsv"
. "$root/bin/lib/tools.bash"
cd "$root"
if [ "${1:-}" = --regen ]; then
  arbace_tool -p "$root/test" -D g2a.dumps="$work/dumps" -e "
(require 'g2a.convert-test)
(in-ns 'g2a.convert-test)
(defn strip [x]
  (let [m (some-> (meta x) (as-> m (apply dissoc m :column layout-keys)) not-empty)
        x (cond (seq? x) (apply list (map strip x)) (vector? x) (mapv strip x)
                (map? x) (into {} (map (fn [[k v]] [k (strip v)])) x) :else x)
        m (when m (into {} (map (fn [[k v]] [k (strip v)])) m))]
    (if (instance? arbace.lang.IObj x) (with-meta x m) x)))
(doseq [u units]
  (let [fs (decls (first (:files (convert (str \"units/\" u \".go.edn\")))))]
    (spit (str expected-dir \"/units/\" u \".ae\")
          (apply str \";; Expected forms of test/g2a/convert/units/\" u \".go (bin/g2a-convert-tests --regen; reviewed)\n\"
                 (for [f fs] (str (arbace.g2a.layout/text (strip f)) \"\n\"))))))
(shutdown-agents)"
  exit
fi
arbace_tool -p "$root/test" -D g2a.dumps="$work/dumps" -e "
(require 'arbace.test 'g2a.convert-test)
(let [r (arbace.test/run-tests 'g2a.convert-test)]
  (shutdown-agents)
  (System/exit (if (zero? (+ (:fail r) (:error r))) 0 1)))"

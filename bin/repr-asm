#!/bin/bash
# repr/asm, assembly's bridge (doc/asm/SPEC.md; doc/asm/AMD64-SURVEY.md §4, §5, §10, AX1; doc/asm/ARM64-SURVEY.md §4.1, AR1): GNU
# as's text in AT&T syntax for amd64, and for arm64 in GNU syntax (ELF, Apple's spelling) and Plan 9's (lexically), as assembly
# forms and back, arbace.repr.asm on the tools' host (evaluated from the checkout: a crop's namespace,
# bin/lib/version.bash's arbace_crop_paths). No assembler runs: every judge is the text's own (the forms read again equal,
# mode :full printed back byte for byte); gas and llvm-mc are the oracle tier's (AX2 on).
#
#   --arch amd64|arm64 (anywhere; default amd64)    the architecture: its corpora, record, classes and controls (amd64's
#                                                    test/asm/{roundtrip-results-amd64,divergences-read,controls}, arm64's
#                                                    test/asm/{roundtrip-results-arm64,divergences-read-arm64,controls-arm64})
#   bin/repr-asm read [--syntax S] [--full] FILE.s [-o OUT.ae]  FILE's assembly forms as .ae text (a header, an item a line);
#                                                    --full: mode :full, the text's layer kept in the .ae's last line; S att
#                                                    (amd64), gnu, apple or plan9 (arm64); a .S is read as the C preprocessor's
#   bin/repr-asm print [--full] FILE.ae [-o OUT.s]   the forms printed canonically; --full: with the layer, the original text
#                                                    byte for byte
#   bin/repr-asm corpus extract                      the corpora of test/asm/corpora.edn out of their pinned tarballs (musl
#                                                    1.2.6's, llvm-project 23.1.5's, gcc 15.2.0's) into $REPR_ASM_SRC (default
#                                                    MAIN/.tmp/asm/src), each tarball's SHA-256 checked against its pin first (Go's
#                                                    testdata are read in place in $ARBACE_GOROOT, the box's in the checkout)
#   bin/repr-asm corpus lists [CORPUS...]            each corpus's list (NAME<tab>PATH) into .tmp/repr-asm/lists/CORPUS.list
#   bin/repr-asm roundtrip [--record] [CORPUS...]    each file of each corpus (default: every corpus of test/asm/corpora.edn): read
#                                                    in :full, the .ae text read back (forms and layer equal), printed back byte for
#                                                    byte, the canonical print read again to the same forms with no layer; rows
#                                                    against test/asm/roundtrip-results-amd64.edn (every recorded :pass passes,
#                                                    every file recorded; --record rewrites the corpora's rows from the run), every
#                                                    non-pass in a class of test/asm/divergences-read.edn, and the negative
#                                                    controls of test/asm/controls.txt fail; WORK .tmp/repr-asm/rt/CORPUS
#   bin/repr-asm divergences [RESULTS]               the results' non-passes judged against the classes (none unclassed)
#   bin/repr-asm --arch arm64 table [--check]        AR2: A64's encoding table, arbace/repr/asm/arm64/table.ae, generated from Go's
#                                                    arm64asm and cmd/internal/obj/arm64 in $ARBACE_GOROOT (VERSION checked) by
#                                                    arbace.repr.asm.arm64.tablegen; --check: the committed table equal to a fresh one
#   bin/repr-asm --arch arm64 encode-check [--record] [CORPUS...]
#                                                    AR2: every MC/AArch64 line that states an encoding encoded from its CHECK text
#                                                    (or the input line a text-less block pairs with) and judged by the stated bytes,
#                                                    the CHECK text printed back (:print), each error test's `error:` lines' instructions
#                                                    rejected (:reject); against test/asm/encode-results-arm64.edn (--record rewrites it),
#                                                    the classes test/asm/divergences-encode-arm64.edn and the negative controls
#                                                    test/asm/controls-encode-arm64.txt (default corpora mc-aarch64, mc-asmparser-aarch64)
set -euo pipefail
arch=amd64 args=()
while [ $# -gt 0 ]; do case $1 in --arch) arch=$2; shift 2 ;; *) args+=("$1"); shift ;; esac; done
set -- "${args[@]+"${args[@]}"}"
case $arch in amd64|arm64) ;; *) echo "repr-asm: --arch amd64|arm64" >&2; exit 2 ;; esac
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash"
. "$root/bin/lib/tools.bash"
export GOMAXPROCS=${GOMAXPROCS:-4} GOMEMLIMIT=${GOMEMLIMIT:-1500MiB}
main=$(cd "$(git -C "$root" rev-parse --git-common-dir)/.." && pwd)
case $root in */.tmp/gate-clean/*) main=${root%%/.tmp/gate-clean/*} ;; esac
src=${REPR_ASM_SRC:-$main/.tmp/asm/src}
corpora=$root/test/asm/corpora.edn
goroot=${ARBACE_GOROOT:-/root/tamago-go}
results=$root/test/asm/roundtrip-results-$arch.edn
case $arch in
  amd64) classes=$root/test/asm/divergences-read.edn controls=$root/test/asm/controls.txt ;;
  *) classes=$root/test/asm/divergences-read-$arch.edn controls=$root/test/asm/controls-$arch.txt ;;
esac
lists=$root/.tmp/repr-asm/lists

edn() { arbace_tool -e "(let [c (read-string (slurp \"$corpora\"))] $1)"; }

# corpus_ids: the corpora's ids of the architecture, in order
corpus_ids() { edn "(doseq [x (:corpora c) :when (= (or (:arch x) :amd64) :$arch)] (println (name (:id x))))"; }

extract() {
  local id tar sum top want
  mkdir -p "$src"
  edn '(doseq [[k p] (:pins c) :when (:sha256 p)] (println (name k) (:fetched-into p) (:sha256 p) (:top p)))' > "$TMPDIR/asm-pins.txt"
  while read -r id tar sum top; do
    [ -f "$main/$tar" ] || { echo "repr-asm: the pin $id's tarball $main/$tar is not on this host (a fetch by its pin, the user's)" >&2; return 1; }
    want=$(sha256sum "$main/$tar" | cut -d' ' -f1)
    [ "$want" = "$sum" ] || { echo "repr-asm: $tar's SHA-256 $want is not the pin's $sum" >&2; return 1; }
    edn "(doseq [x (:corpora c) :when (= (:pin x) :$id) m (:extract x)] (println m))" > "$TMPDIR/asm-members.txt"
    echo "repr-asm: extracting $(wc -l < "$TMPDIR/asm-members.txt") members of $id"
    case $tar in
      *.tar.gz) tar -xzf "$main/$tar" -C "$src" --wildcards -T "$TMPDIR/asm-members.txt" ;;
      *.tar.xz) tar -xJf "$main/$tar" -C "$src" --wildcards -T "$TMPDIR/asm-members.txt" ;;
    esac
  done < "$TMPDIR/asm-pins.txt"
}

# make_list ID: the corpus's files (its :dir under its :root, src by default, $ARBACE_GOROOT for :goroot, the checkout for
# :checkout; its :match and not its :exclude), NAME<tab>PATH<tab>FLAGS
make_list() {
  local id=$1 dir match exclude rt syn base
  read -r dir match exclude rt syn < <(edn "(let [x (first (filter #(= (:id %) :$id) (:corpora c)))] (println (:dir x) (:match x) (or (:exclude x) \"^\$\") (name (or (:root x) :src)) (name (or (:syntax x) :default))))")
  case $rt in
    goroot) base=$goroot
      [ "$(head -1 "$goroot/VERSION" 2>"$TMPDIR/asm-ver.err")" = "$(edn '(println (:version (:tamago-go (:pins c))))')" ] ||
        { echo "repr-asm: $goroot/VERSION is not the pin's (seed/goroot.sha256's toolchain)" >&2; return 1; } ;;
    checkout) base=$root ;;
    *) base=$src ;;
  esac
  [ -d "$base/$dir" ] || { echo "repr-asm: $base/$dir missing: bin/repr-asm corpus extract" >&2; return 1; }
  mkdir -p "$lists"
  local sd=$root/.tmp/repr-asm/split/$id f n p flags
  rm -rf "$sd"
  : > "$lists/$id.list"
  (cd "$base/$dir" && find . -type f | sed 's|^\./||' | LC_ALL=C sort | grep -E "$match" | grep -vE "$exclude" || true) > "$TMPDIR/asm-files.txt"
  while read -r f; do
    p=$base/$dir/$f n=${f%.[sS]}; n=${n//\//-}
    # the test's own verdict and target from its RUN lines (llvm/test's lit tests): reject when one runs `not llvm-mc`, other-arch
    # when its triples name no x86
    if [ "$arch" = amd64 ]; then
    flags=$(awk '/RUN:/ { r = r " " $0 } END { f = ""; if (r ~ /not llvm-mc/) f = f " reject"
                 if (r ~ /-triple|-mtriple|--triple/ && r !~ /(i[3-6]86|x86_64|x86-64|amd64)/) f = f " other-arch"
                 if (r ~ /-x86-asm-syntax=intel/) f = f " intel"
                 if (r != "" && r !~ /llvm-mc[^|]*%s/ && r !~ /split-file/) f = f " not-input"; print f }' "$p")
    else
    # arm64: apple when every triple the RUN lines name is Darwin's (`;` comments), other-arch when none is AArch64's
    flags=$(awk '/RUN:/ { r = r " " $0 } END { f = ""; if (r ~ /not llvm-mc/) f = f " reject"
                 n = 0; a = 0; d = 0; s = r
                 while (match(s, /-?-m?triple[= ]+[^ ]+/)) { t = substr(s, RSTART, RLENGTH); s = substr(s, RSTART + RLENGTH)
                   sub(/^-?-m?triple[= ]+/, "", t); n++; if (t ~ /^(aarch64|arm64)/) a++; if (t ~ /(apple|darwin|ios|macos)/) d++ }
                 if (n > 0 && a == 0) f = f " other-arch"
                 if (n > 0 && d == n) f = f " apple"
                 if (r != "" && r !~ /llvm-mc[^|]*%s/ && r !~ /split-file/) f = f " not-input"; print f }' "$p")
    fi
    [ "$syn" = plan9 ] && flags="$flags plan9"
    if grep -qE '^(#|//)--- ' "$p"; then
      # a split-file test (`split-file %s %t`): its parts are the files llvm-mc reads, each listed as NAME.PART
      mkdir -p "$sd/$n"
      awk -v o="$sd/$n" '/^(#|\/\/)--- / { f = o "/" $2; printf "" > f; next } f { print > f }' "$p"
      for q in $(cd "$sd/$n" && ls | grep -E '\.[sS]$' | LC_ALL=C sort); do
        printf '%s\t%s\t%s\n' "$n.${q%.[sS]}" "$sd/$n/$q" "${flags# }" >> "$lists/$id.list"
      done
    else
      printf '%s\t%s\t%s\n' "$n" "$p" "${flags# }" >> "$lists/$id.list"
    fi
  done < "$TMPDIR/asm-files.txt"
  echo "repr-asm: $id: $(wc -l < "$lists/$id.list") files"
}

# rows WORK ID: the check's rows [ID RESULT REASON], ID CORPUS/NAME
rows() {
  awk -F'\t' -v c="$2" 'function q(s) { gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s); return "\"" s "\"" }
    FILENAME == ARGV[1] { fl[$1] = $3; next }
    { why = $2 ($6 != "" ? " " $6 : "")
      # a refusal of a test whose RUN lines say it is rejected, or that runs on another target, says so first
      if ($2 == "refused" && fl[$1] ~ /intel/) why = "intel-run " why
      else if ($2 == "refused" && fl[$1] ~ /reject/) why = "error-test " why
      else if ($2 != "ok" && fl[$1] ~ /other-arch/) why = "other-arch " why
      else if ($2 != "ok" && fl[$1] ~ /not-input/) why = "not-input " why
      r = ($2 == "ok") ? ":pass \"\"" : ":fail " q(why)
      print "[" q(c "/" $1) " " r "]" }' "$3" "$1/check.tsv"
}

case ${1:-} in
  read|print) v=$1; shift; arbace_tool -m arbace.repr.asm "$v" --arch "$arch" "$@" ;;
  corpus)
    case ${2:-} in
      extract) extract ;;
      lists) shift 2; ids=("$@"); [ ${#ids[@]} -gt 0 ] || mapfile -t ids < <(corpus_ids); for id in "${ids[@]}"; do make_list "$id"; done ;;
      *) echo "repr-asm corpus extract|lists [CORPUS...]" >&2; exit 2 ;;
    esac ;;
  roundtrip)
    shift; record=; ids=()
    for a in "$@"; do case $a in --record) record=1 ;; *) ids+=("$a") ;; esac; done
    [ ${#ids[@]} -gt 0 ] || mapfile -t ids < <(corpus_ids)
    all=$root/.tmp/repr-asm/rt/rows.edn; mkdir -p "${all%/*}"; : > "$all"
    for id in "${ids[@]}"; do
      make_list "$id"
      work=$root/.tmp/repr-asm/rt/$id; rm -rf "$work"; mkdir -p "$work"
      arbace_tool -m arbace.repr.asm check --arch "$arch" "$lists/$id.list" "$work"
      rows "$work" "$id" "$lists/$id.list" >> "$all"
    done
    fails=0
    # the negative controls: a subject's :full .ae printed back must differ from the reference's original
    while read -r cid subj ref; do
      case $cid in ''|'#'*) continue ;; esac
      sc=${subj%%/*} sn=${subj#*/} rc=${ref%%/*} rn=${ref#*/}
      sa=$root/.tmp/repr-asm/rt/$sc/ae/$sn.ae
      rp=$(awk -F'\t' -v n="$rn" '$1 == n { print $2 }' "$lists/$rc.list" 2>"$TMPDIR/asm-ctl.err" || true)
      if [ ! -f "$sa" ] || [ -z "$rp" ]; then echo "control $cid: left (not in this run)"; continue; fi
      v=$(arbace_tool -m arbace.repr.asm control "$sa" "$rp" | tail -1)
      if [ "$v" = differs ]; then echo "control $cid: fails as it must"; else echo "FAIL: control $cid: $v"; fails=$((fails + 1)); fi
    done < "$controls"
    judge=(-e "(do (load-file \"$root/test/asm/judge.ae\") nil)" -e "(asm.judge/main \"$results\" \"$all\" \"$classes\" \"${record:-}\" \"${ids[*]}\")")
    arbace_tool "${judge[@]}" || fails=$((fails + 1))
    [ $fails = 0 ] ;;
  table)
    [ "$arch" = arm64 ] || { echo "repr-asm: table is arm64's (--arch arm64)" >&2; exit 2; }
    [ "$(head -1 "$goroot/VERSION" 2>"$TMPDIR/asm-ver.err")" = "$(edn '(println (:version (:tamago-go (:pins c))))')" ] ||
      { echo "repr-asm: $goroot/VERSION is not the pin's (seed/goroot.sha256's toolchain)" >&2; exit 1; }
    arbace_tool -m arbace.repr.asm.arm64.tablegen "$goroot" "$root/arbace/repr/asm/arm64/table.ae" "${2:-}" ;;
  encode-check)
    [ "$arch" = arm64 ] || { echo "repr-asm: encode-check is arm64's (--arch arm64)" >&2; exit 2; }
    shift; record=; ids=()
    for a in "$@"; do case $a in --record) record=1 ;; *) ids+=("$a") ;; esac; done
    [ ${#ids[@]} -gt 0 ] || ids=(mc-aarch64 mc-asmparser-aarch64)
    specs=()
    for id in "${ids[@]}"; do make_list "$id"; specs+=("$id=$lists/$id.list"); done
    arbace_tool -m arbace.repr.asm.arm64.encheck "$root/test/asm/encode-results-arm64.edn" "$root/test/asm/divergences-encode-arm64.edn" \
      "$root/test/asm/controls-encode-arm64.txt" "${record:-}" "${specs[@]}" ;;
  divergences)
    arbace_tool -e "(do (load-file \"$root/test/asm/judge.ae\") nil)" -e "(asm.judge/main \"$results\" \"${2:-$results}\" \"$classes\" \"\" \"\")" ;;
  *) sed -n '2,/^set -euo/p' "$0" | sed '$d' >&2; exit 2 ;;
esac

#!/bin/bash
# repr/c's token check (doc/C23-SURVEY.md, "As built: C2"; CS40 (a)): every file of the corpora read in
# place lexed and preprocessed by the port (arbace.repr.c.lex, arbace.repr.c.pp, evaluated on the tools'
# host) and by cc (tools/ccdump, built by bin/repr-c ccdump-build), the dumps compared line for line
# (arbace.repr.c.ppcheck); a file whose dumps differ passes when test/repr/c/pp-check-known.edn lists it
# with its class and the port's tokens are gcc -E's (the digest it records). Run through
# bin/repr-c check (from the repository root); writes only under .tmp/repr-c-check/ (REPR_C_CHECK_WORK).
#
# Usage: bin/repr-c check --tokens [--corpus C,...] [--level lex,pp] [--record] [--judge-all]
#   --corpus   test/c/corpora.edn's ids (default: every corpus read in place, `all`; lua's tarball not)
#   --level    lex (each file's own tokens), pp (the preprocessed stream); default both
#   --record   gcc -E -P run on each file whose pp dump differs (SOURCE_DATE_EPOCH at the host's epoch,
#              the file's modelled options, gcc's include directory first), and the known file
#              rewritten from what agrees with it (bin/repr-c's record; the classes kept or guessed),
#              then the check again
#   --judge-all  the reference on every file too, not only where cc differs: gcc -E -P run on each
#              (16 at a time), its tokens against the port's, WORK/CORPUS/gcc-agree.tsv and a summary
#              (where the port follows cc and cc is wrong: informative, the check's status unchanged)
# Each corpus: WORK/CORPUS/list.jsonl, files.edn, cc-lex/, cc-pp/ (ccdump's dumps), port-lex/,
# port-pp/ (the port's), files.tsv (name, lex, pp: equal, gcc, differ, crash, the port's tokens'
# digest), differ.txt (the failing files and their first differing line), report.edn, missing.tsv
# (the __has answers not recorded: bin/repr-c host record adds them), headers.txt.
#   REPR_C_THREADS (default 8) the port's threads; REPR_C_CCDUMP_TIMEOUT (default 600 s) a ccdump run's
#   time before the file it hangs on is marked and the run resumed
# Exit status: 0 when every corpus passes.
set -uo pipefail
root=$(cd "$(dirname "$0")/../../.." && pwd)
. "$root/bin/lib/tmpdir.bash"
. "$root/bin/lib/tools.bash"
cd "$root"

all=c23conf,torture-execute,torture-execute-mirror,torture-compile,tcc-tests2,tcc-pp,compcert,mir,cxgo,benchmarksgame,sqlite,zlib,quickjs,gcc-c23,gcc-cpp-c23,gcc-c23-sub,gcc-gnu23,gcc-embed,gcc-va-opt,gcc-bitint
corpora=$all levels=lex,pp record= tokens= judge_all=
while [ $# -gt 0 ]; do
  case $1 in
    --tokens) tokens=1; shift ;;
    --corpus) corpora=$2; shift 2 ;;
    --level) levels=$2; shift 2 ;;
    --record) record=1; shift ;;
    --judge-all) judge_all=1; shift ;;
    *) sed -n '9,19p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
  esac
done
[ -n "$tokens" ] || { echo "check: --tokens (the only level of C2)" >&2; exit 2; }
[ "$corpora" = all ] && corpora=$all
work=${REPR_C_CHECK_WORK:-$root/.tmp/repr-c-check}
mkdir -p "$work"
gowhim=${GOWHIM:-$(cd "${root%%/.tmp/worktrees/*}/.." && pwd)/go-whim}
modcache=$(GOFLAGS= "${ARBACE_GOROOT:-/root/tamago-go}/bin/go" env GOMODCACHE)
gi=$(gcc -print-file-name=include)
epoch=$(sed -n 's/^ *:epoch \([0-9]*\).*/\1/p' test/c/host/host.edn)

ccdump=$(bin/repr-c ccdump-build) || { echo "check: ccdump-build failed"; exit 1; }
gccroot=
case ,$corpora, in *,gcc-*) gccroot=$(bin/repr-c gcc-tests) || exit 1 ;; esac
roots="{:gomodcache \"$modcache\" :go-whim \"$gowhim\" :gcc-15.2.0 \"$gccroot\"}"

IFS=, read -r -a ids <<< "$corpora"
for id in "${ids[@]}"; do rm -rf "${work:?}/$id"; done
arbace_tool -m arbace.repr.c.ppcheck lists "$work" "$roots" "${ids[@]}" || exit 1

# cc's dumps, a run resumed past a file it hangs on
ccdump_run() { # MODE ID
  local mode=$1 id=$2 d=$work/$2 st cur
  while :; do
    timeout "${REPR_C_CCDUMP_TIMEOUT:-600}" "$ccdump" -mode "$mode" -host test/c/host -list "$d/list.jsonl" \
      -o "$d/cc-$mode" -base "$(cat "$d/base.txt")" -skip-done > "$d/cc-$mode.log" 2>&1
    st=$?
    [ $st = 0 ] && return 0
    cur=$(cat "$d/cc-$mode/.current" 2>"$TMPDIR/repr-c-cur.err") || return 1
    mkdir -p "$(dirname "$d/cc-$mode/$cur")"
    if [ $st = 124 ]; then printf '#panic\ttimeout\n' > "$d/cc-$mode/$cur"; else printf '#panic\tccdump exited %s\n' "$st" > "$d/cc-$mode/$cur"; fi
    echo "$id: ccdump $mode stopped on $cur (status $st), resumed"
  done
}

status=0
for id in "${ids[@]}"; do
  for l in ${levels//,/ }; do ccdump_run "$l" "$id" || { echo "$id: ccdump $l failed ($work/$id/cc-$l.log)"; status=1; }; done
done
arbace_tool -m arbace.repr.c.ppcheck check "$work" "$levels" "${ids[@]}" || status=1

# gcc_run DIR NAME STD ARGS READ: the reference's -E -P of one file, its status beside
gcc_run() {
  local d=$1 f=$2 std=$3 args=$4 rd=$5 base gstd
  base=$(cat "$d/base.txt"); gstd=$std; [ "$std" = c94 ] && gstd=iso9899:199409
  mkdir -p "$(dirname "$d/gcc/$f.i")"
  # shellcheck disable=SC2086
  (cd "$base" && SOURCE_DATE_EPOCH=$epoch LC_ALL=C gcc -std=$gstd $args -isystem "$gi" -E -P "$rd") \
    > "$d/gcc/$f.i" 2> "$d/gcc/$f.err"
  echo $? > "$d/gcc/$f.status"
}
export -f gcc_run
export epoch gi

if [ -n "$judge_all" ]; then
  for id in "${ids[@]}"; do
    d=$work/$id
    # the fields separated by \037 (a tab is white space to read, and an empty field would vanish)
    awk -F'\t' -v d="$d" '{print d "\037" $1 "\037" $2 "\037" $3 "\037" $4}' "$d/gcc.list" | tr '\n' '\0' \
      | xargs -0 -P 16 -I{} bash -c 'IFS=$'"'"'\037'"'"' read -r d f std args rd <<< "$1"; gcc_run "$d" "$f" "$std" "$args" "$rd"' _ {}
  done
  arbace_tool -m arbace.repr.c.ppcheck agree "$work" "${ids[@]}" || status=1
fi

if [ -n "$record" ]; then
  for id in "${ids[@]}"; do
    d=$work/$id
    awk -F'\t' '$3 == "differ" || $3 == "gcc" {print $1}' "$d/files.tsv" | while read -r f; do
      line=$(awk -F'\t' -v f="$f" '$1 == f' "$d/gcc.list")
      gcc_run "$d" "$f" "$(echo "$line" | cut -f2)" "$(echo "$line" | cut -f3)" "$(echo "$line" | cut -f4)"
    done
  done
  arbace_tool -m arbace.repr.c.ppcheck record "$work" "${ids[@]}" || exit 1
  status=0
  arbace_tool -m arbace.repr.c.ppcheck check "$work" "$levels" "${ids[@]}" || status=1
fi
exit $status

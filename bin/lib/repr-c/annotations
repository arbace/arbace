#!/bin/bash
# The checker's check (doc/C23-SURVEY.md, "As built: C4"; bin/ci annotations): every file of the corpora read in
# place by repr/c into C forms and checked by arbace.c.check (evaluated on the tools' host), its annotations
# (every main-file item's declarators with their linkage and type, its expressions' types and integer values,
# the structs' and unions' layouts, the enumerators' values; tools/ccdump's types format) compared item by item
# with cc's checker's (tools/ccdump's types mode, cc.Translate, built by bin/repr-c ccdump-build), and the
# checker's errors judged by the reference's acceptance (gcc 15.2 -fsyntax-only's recorded status,
# test/repr/c/parse-gcc.tsv): a file passes when its annotations equal cc's (or cc does not translate it: cc's
# gaps, not compared) and the checker gives no error on a file gcc accepts; else test/repr/c/annot-known.edn lists
# it with its class, or it fails (arbace.repr.c.annot). Writes only under .tmp/ci-annot/ (CI_ANNOT_WORK).
#
# Usage: bin/ci annotations [--corpus C,...] [--only LIST] [--record] [--resume] [--judge]
#   --corpus   test/c/corpora.edn's ids (default every corpus read in place, `all`; lua's tarball not)
#   --only     GT8: a file of ids CORPUS/NAME (bin/lib/repr-c/only.bash), those files alone, judged on what the run holds
#              (a known entry of a file not run is not stale, a control whose files are not run is left); not with --record
#              or --resume; --judge --record after a partial run is refused too
#   --record   the known file's entries of the corpora rewritten from the files that do not pass (one of no class printed,
#              left out and the run failed), then judged again,
#              and the results file test/repr/c/annot-results.edn (CS240 (a): every file's row [ID RESULT REASON];
#              the other corpora's rows kept; REPR_C_RESULTS_FILE another path), whose passes bin/reap counts
#   --resume   a corpus whose lists and cc's dumps a run left keeps them (the checker's side run again)
#   --judge    the corpora's port.tsv judged again, nothing run
# Each corpus: WORK/CORPUS/list.jsonl, files.edn, base.txt (bin/repr-c check's lists), cc/ (ccdump's dumps, in
# chunks of 50 on REPR_C_THREADS runs), port/ (the checker's dumps), port.tsv (name, annotations: equal, differ,
# no-cc, cc-fails, read-error, ...; the checker's errors; detail), files.tsv (name, status: pass, known, fail;
# annotations, errors against gcc: agree, false-error, both-reject, gcc-only-rejects; class, detail), report.edn.
#   REPR_C_THREADS (default 6) the checker's threads and ccdump's runs; GOMEMLIMIT (default 6GiB)
# The negative control (GTS81 (a), test/c/controls.edn, :level :annot; queue 144): a file's annotations judged against
# another's cc annotations as a file is (annot-status: equal, or every difference cc's gap, passes) must not pass, else the
# judgment fails (--judge too); no row of files.tsv, the known file, the results file or the counts.
# Exit status: 0 when every corpus passes.
set -uo pipefail
root=$(cd "$(dirname "$0")/../../.." && pwd)
. "$root/bin/lib/tmpdir.bash"
. "$root/bin/lib/tools.bash"
. "$root/bin/lib/repr-c/only.bash"
cd "$root"

all=c23conf,c23,torture-execute,torture-execute-mirror,torture-compile,tcc-tests2,tcc-pp,compcert,mir,cxgo,benchmarksgame,sqlite,zlib,quickjs,gcc-c23,gcc-cpp-c23,gcc-c23-sub,gcc-gnu23,gcc-embed,gcc-va-opt,gcc-bitint
corpora=$all record= resume= judge_only= only=
while [ $# -gt 0 ]; do
  case $1 in
    --corpus) corpora=$2; shift 2 ;;
    --only) only=$2; shift 2 ;;
    --record) record=1; shift ;;
    --resume) resume=1; shift ;;
    --judge) judge_only=1; shift ;;
    *) sed -n '12,22p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
  esac
done
[ "$corpora" = all ] && corpora=$all
unset REPR_C_ONLY
[ -z "$only" ] || c_only_set "$only" "$corpora" "ci annotations"
[ -z "$record" ] || c_only_refuse "ci annotations" --record
[ -z "$resume" ] || c_only_refuse "ci annotations" "--resume (a kept corpus's lists)"
# review 188, L4: --judge judges the last run as it was listed
[ -z "$judge_only" ] || c_only_refuse "ci annotations" "--judge (the last run's own list)"
work=${CI_ANNOT_WORK:-$root/.tmp/ci-annot}
threads=${REPR_C_THREADS:-6}
export REPR_C_THREADS=$threads GOMEMLIMIT=${GOMEMLIMIT:-6GiB}
mkdir -p "$work"
# a partial run's judgment never records (review 027's rule for the run level): --judge --record after an --only run
if [ -n "$record" ] && { [ -n "$judge_only" ] || [ -n "$resume" ]; } && c_only_marked "$work" "$corpora"; then
  echo "ci annotations: --judge --record: the last run was partial (--only; CORPUS/only.txt)" >&2; exit 2
fi
# the main checkout: a worktree's (.tmp/worktrees/NAME) or the clean run's clone's (.tmp/gate-clean/SHA, also of a worktree), else this one (queue 150)
cmain=${root%%/.tmp/gate-clean/*}; cmain=${cmain%%/.tmp/worktrees/*}
gowhim=${GOWHIM:-$(cd "$cmain/.." && pwd)/go-whim}
modcache=$(GOFLAGS= "${ARBACE_GOROOT:-/root/tamago-go}/bin/go" env GOMODCACHE)

ccdump=$(GOMAXPROCS=$threads bin/repr-c ccdump-build) || { echo "annotations: ccdump-build failed"; exit 1; }
gccroot=
case ,$corpora, in *,gcc-*) gccroot=$(bin/repr-c gcc-tests) || exit 1 ;; esac
roots="{:gomodcache \"$modcache\" :go-whim \"$gowhim\" :gcc-15.2.0 \"$gccroot\" :checkout \"$root\"}"

IFS=, read -r -a ids <<< "$corpora"
todo=() fresh=()
for id in "${ids[@]}"; do
  [ -n "$judge_only" ] && continue
  todo+=("$id")
  # review 188, L3: a corpus a partial run left is listed again (a whole --resume is whole)
  if [ -n "$resume" ] && [ -s "$work/$id/list.jsonl" ] && [ -d "$work/$id/cc" ] && [ ! -f "$work/$id/only.txt" ]; then continue; fi
  rm -rf "${work:?}/$id"; fresh+=("$id")
done
[ ${#fresh[@]} = 0 ] || arbace_tool -m arbace.repr.c.ppcheck lists "$work" "$roots" "${fresh[@]}" || exit 1

# one chunk of cc's dumps, a run resumed past a file it hangs on
ccdump_chunk() { # DIR CHUNK
  local d=$1 c=$2 st cur
  while :; do
    GOMAXPROCS=2 timeout "${REPR_C_CCDUMP_TIMEOUT:-600}" "$ccdump" -mode types -host test/c/host -list "$c" \
      -o "$d/cc" -base "$(cat "$d/base.txt")" -skip-done -current "$c.current" > "$c.log" 2>&1
    st=$?
    [ $st = 0 ] && return 0
    cur=$(cat "$c.current" 2>"$TMPDIR/ci-cur.$$.err") || return 1
    mkdir -p "$(dirname "$d/cc/$cur")"
    if [ $st = 124 ]; then printf '#panic\ttimeout\n' > "$d/cc/$cur"; else printf '#panic\tccdump exited %s\n' "$st" > "$d/cc/$cur"; fi
  done
}
export -f ccdump_chunk
export ccdump TMPDIR

status=0
for id in "${todo[@]}"; do
  d=$work/$id
  if [[ " ${fresh[*]} " == *" $id "* ]]; then
    mkdir -p "$d/chunks"
    split -l 50 -d -a 4 "$d/list.jsonl" "$d/chunks/c"
    ls "$d"/chunks/c???? | xargs -P "$threads" -I{} bash -c 'ccdump_chunk "$1" "$2"' _ "$d" {} \
      || { echo "$id: ccdump failed ($d/chunks/*.log)"; status=1; }
  fi
  rm -rf "$d/port"
  arbace_tool -m arbace.repr.c.annot run "$work" "$id" 2> "$d/run.err" || { echo "$id: the checker's run failed ($d/run.err)"; status=1; }
done
arbace_tool -m arbace.repr.c.annot judge "$work" "${ids[@]}" 2> "$work/judge.err" || status=1
if [ -n "$record" ]; then
  # 3: the known file written with failing files of no class left out (printed; no placeholder class, queue 122 F1): the
  # judgment and the results go on, and the run fails
  arbace_tool -m arbace.repr.c.annot record "$work" "${ids[@]}" 2> "$work/record.err"
  rst=$?
  [ $rst = 0 ] || [ $rst = 3 ] || { echo "annotations: the record failed ($work/record.err)"; exit 1; }
  status=0
  [ $rst = 0 ] || status=1
  arbace_tool -m arbace.repr.c.annot judge "$work" "${ids[@]}" 2> "$work/judge.err" || status=1
  # CS240 (a): every file's row [ID RESULT REASON] (the passes bin/reap counts), the other corpora's rows kept
  arbace_tool -m arbace.repr.c.results annot "$work" "${REPR_C_RESULTS_FILE:-test/repr/c/annot-results.edn}" "${ids[@]}" 2> "$work/results.err" || status=1
fi
exit $status

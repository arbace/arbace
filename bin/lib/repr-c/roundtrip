#!/bin/bash
# repr/c's round trip (doc/c/SPEC.md §3.1; doc/C23-SURVEY.md, "As built: C3b"): every file of the corpora read
# in place by repr/c (arbace.repr.c, evaluated on the tools' host) into C forms, and
#   level 1  the :lines print read again, the forms equal (N3's grouping and the lines aside);
#   level 2  the file read in mode :full and printed, the original byte for byte;
#   level 3  the :lines print and the original compiled by the reference (gcc -std=STD OPTIONS -O0
#            -fno-stack-protector -fpermissive -w -c, gcc's include directory first, the fixed epoch; each from
#            its own directory under the same relative name, the print with the original's directory as -iquote),
#            the object files byte for byte;
#   level 4  for the run corpora (test/c/corpora.edn's :action :run), both linked (-lm) and run (10 s, an empty
#            standard input, in a scratch directory), the status and the standard output equal (E2's measure);
# and the reader's acceptance against the reference's (CS61 (a): gcc -fsyntax-only's status of every file,
# recorded in test/repr/c/parse-gcc.tsv by --record-gcc). A file passes when every level it reaches passes and
# the reader rejects no file the reference accepts; else test/repr/c/roundtrip-known.edn lists it with its class,
# or it fails (arbace.repr.c.rtcheck). Run through bin/repr-c roundtrip (from the repository root); writes only
# under .tmp/repr-c-roundtrip/ (REPR_C_RT_WORK).
#
# Since the oracles' records (doc/ORACLE-RECORDS-SURVEY.md, ORS1-ORS10 (a), CS77 (a) generalized; "As built: the tooling and C"):
# the originals' half of levels 3 and 4 (gcc's object of each original, its link and run: status and standard output) is the
# pack c-roundtrip-orig-CORPUS (test/repr/c/records/), recorded by hand (--record-orig); a run reads it in place of compiling
# the originals, and only the print is compiled (gcc on Arbace's output: the oracle tier's half, class D). --no-gcc runs levels
# 1 and 2 and the acceptance alone (no gcc at all: the gate's --full), the known entries of the classes only levels 3 and 4
# give (:objects, :objects-macro-body, :run-address, :print-grammar) deferred to the oracle tier when the file passes the rest.
#
# Usage: bin/repr-c roundtrip [--corpus C,...] [--record] [--record-gcc] [--no-run] [--no-gcc|--record-orig|--verify-orig [--sample N]]
#   --corpus      test/c/corpora.edn's ids (default every corpus read in place, `all`; lua's tarball not)
#   --record      the known file's entries of the corpora rewritten from the files that do not pass, then judged
#                 again, and the results file test/repr/c/roundtrip-results.edn (CS240 (a): every file's row
#                 [ID RESULT REASON]; the other corpora's rows kept; REPR_C_RESULTS_FILE another path; not with
#                 --no-run), whose passes bin/reap counts
#   --record-gcc  gcc -fsyntax-only run on every file of the corpora, test/repr/c/parse-gcc.tsv rewritten
#                 for them (the other corpora's lines kept)
#   --no-run      levels 1-3 only
#   --no-gcc      levels 1-2 and the acceptance (test/repr/c/parse-gcc.tsv) only: gcc never run; not with --record
#   --record-orig the originals compiled, linked and run by gcc (levels 3 and 4's original half) and packed per corpus as
#                 c-roundtrip-orig-CORPUS, its pin and manifest in test/repr/c/records/ (by hand on the host with gcc, ORS5 (a));
#                 then the run goes on as without it
#   --verify-orig the originals compiled and run afresh (--sample N: N files a corpus, spread evenly) against the packs and
#                 test/repr/c/parse-gcc.tsv's acceptance afresh against the record; the crossed pair (one file's object
#                 against another's member must differ, ORS7 (a)); nothing printed or judged; another gcc reported (ORS6 (a))
#   --resume      a corpus whose forms.tsv a run left keeps it (its lists, prints and levels 1-2); the rest again
#   --only LIST   GT8: a file of ids CORPUS/NAME (bin/lib/repr-c/only.bash), those files alone, judged on what the run holds
#                 (a known entry of a file not run is not stale, a control whose files are not run is left); not with
#                 --record, --record-gcc or --resume
# Each corpus: WORK/CORPUS/forms.tsv (name, read, level 1, level 2, detail, fixpoint), print/NAME.d/NAME (the :lines prints),
# obj.tsv (name, the original's compile status, the print's, the objects equal or differ), run.tsv (name, the
# original's run status, the print's, same or differ), files.tsv (name, status: pass, known, fail; read, levels
# 1-4, acceptance, class, detail), report.edn.
#   REPR_C_THREADS (default 8): the reader's threads and gcc's jobs.
# The negative control (GTS81 (a), test/c/controls.edn, :level :roundtrip; queue 144): a file's own row with levels 3 and
# 4 crossed, its print's object and run against another file's original's (obj/orig/, run/NAME/o/), judged by the judge's
# row rule, must not pass, else the judgment fails; no row of files.tsv, the known file, the results file or the counts.
# Levels 1 and 2 crossed likewise (:level :roundtrip-forms, :roundtrip-full; queue 159): the subject's reread forms against
# the reference's read forms, its :full print against the reference's original, by the level's own comparison; the run
# keeps those texts for the controls' files alone (CORPUS/control/NAME.read, .reread, .orig, .full).
# Exit status: 0 when every corpus passes.
set -uo pipefail
root=$(cd "$(dirname "$0")/../../.." && pwd)
. "$root/bin/lib/tmpdir.bash"
. "$root/bin/lib/tools.bash"
. "$root/bin/lib/repr-c/only.bash"
cd "$root"

all=c23conf,torture-execute,torture-execute-mirror,torture-compile,tcc-tests2,tcc-pp,compcert,mir,cxgo,benchmarksgame,sqlite,zlib,quickjs,gcc-c23,gcc-cpp-c23,gcc-c23-sub,gcc-gnu23,gcc-embed,gcc-va-opt,gcc-bitint
corpora=$all record= record_gcc= run=1 resume= only= nogcc= record_orig= verify_orig= sample=
while [ $# -gt 0 ]; do
  case $1 in
    --no-gcc) nogcc=1; shift ;;
    --record-orig) record_orig=1; shift ;;
    --verify-orig) verify_orig=1; shift ;;
    --sample) sample=$2; shift 2 ;;
    --corpus) corpora=$2; shift 2 ;;
    --only) only=$2; shift 2 ;;
    --record) record=1; shift ;;
    --record-gcc) record_gcc=1; shift ;;
    --no-run) run=; shift ;;
    --resume) resume=1; shift ;;
    *) sed -n '18,30p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
  esac
done
[ "$corpora" = all ] && corpora=$all
unset REPR_C_ONLY
[ -z "$only" ] || c_only_set "$only" "$corpora" "repr-c roundtrip"
[ -z "$record" ] || c_only_refuse "repr-c roundtrip" --record
[ -z "$record_gcc" ] || c_only_refuse "repr-c roundtrip" --record-gcc
[ -z "$resume" ] || c_only_refuse "repr-c roundtrip" "--resume (a kept corpus's lists)"
[ -z "$nogcc" ] || [ -z "$record$record_gcc$record_orig$verify_orig" ] || { echo "repr-c roundtrip: --no-gcc records nothing (no level 3 or 4)" >&2; exit 2; }
[ -z "$record_orig$verify_orig" ] || [ -z "$only$resume" ] || { echo "repr-c roundtrip: --record-orig and --verify-orig take whole corpora" >&2; exit 2; }
work=${REPR_C_RT_WORK:-$root/.tmp/repr-c-roundtrip}
[ -z "$verify_orig" ] || work=${REPR_C_RT_WORK:-$root/.tmp/repr-c-roundtrip-verify}
. "$root/test/oracle-records/oracle.bash"
orig_pin() { echo "$root/test/repr/c/records/c-roundtrip-orig-$1.sha256"; }
threads=${REPR_C_THREADS:-8}
export REPR_C_THREADS=$threads
mkdir -p "$work"
# a partial run's judgment never records (its marks CORPUS/only.txt, left by the last run --resume would keep)
[ -z "$record" ] || ! c_only_marked "$work" "$corpora" || [ -z "$resume" ] || { echo "repr-c roundtrip: --record: the kept run was partial (--only)" >&2; exit 2; }
# the main checkout: a worktree's (.tmp/worktrees/NAME) or the clean run's clone's (.tmp/gate-clean/SHA, also of a worktree), else this one (queue 150)
cmain=${root%%/.tmp/gate-clean/*}; cmain=${cmain%%/.tmp/worktrees/*}
gowhim=${GOWHIM:-$(cd "$cmain/.." && pwd)/go-whim}
modcache=$(GOFLAGS= "${ARBACE_GOROOT:-/root/tamago-go}/bin/go" env GOMODCACHE)
gi=; [ -n "$nogcc" ] || gi=$(gcc -print-file-name=include)
epoch=$(sed -n 's/^ *:epoch \([0-9]*\).*/\1/p' test/c/host/host.edn)
gccroot=
case ,$corpora, in *,gcc-*) gccroot=$(bin/repr-c gcc-tests) || exit 1 ;; esac
roots="{:gomodcache \"$modcache\" :go-whim \"$gowhim\" :gcc-15.2.0 \"$gccroot\" :checkout \"$root\"}"
: > "$TMPDIR/repr-c-empty-stdin"

IFS=, read -r -a ids <<< "$corpora"
todo=()
for id in "${ids[@]}"; do
  # review 188, L3: a corpus a partial run left is listed again (a whole --resume is whole)
  if [ -n "$resume" ] && [ -s "$work/$id/forms.tsv" ] && [ ! -f "$work/$id/only.txt" ]; then continue; fi
  rm -rf "${work:?}/$id"; todo+=("$id")
done
[ ${#todo[@]} = 0 ] || arbace_tool -m arbace.repr.c.ppcheck lists "$work" "$roots" "${todo[@]}" || exit 1

# CS61 (a): the reference's acceptance of each file, at its standard and modelled options
if [ -n "$record_gcc" ]; then
  syn() { # DIR NAME STD ARGS READ
    local base gstd; base=$(cat "$1/base.txt"); gstd=$3; [ "$3" = c94 ] && gstd=iso9899:199409
    # shellcheck disable=SC2086
    (cd "$base" && SOURCE_DATE_EPOCH=$epoch LC_ALL=C gcc -std=$gstd $4 -isystem "$gi" -fsyntax-only -w "$5") \
      > "$1/syn/$2.out" 2>&1
    echo "$?	$(basename "$1")/$2"
  }
  export -f syn; export epoch gi
  for id in "${ids[@]}"; do
    d=$work/$id; mkdir -p "$d/syn"
    awk -F'\t' '{print $1}' "$d/gcc.list" | while read -r f; do mkdir -p "$(dirname "$d/syn/$f")"; done
    awk -F'\t' -v d="$d" '{print d "\037" $1 "\037" $2 "\037" $3 "\037" $4}' "$d/gcc.list" | tr '\n' '\0' \
      | xargs -0 -P "$threads" -I{} bash -c 'IFS=$'"'"'\037'"'"' read -r d f std args rd <<< "$1"; syn "$d" "$f" "$std" "$args" "$rd"' _ {} \
      > "$d/syn.tsv"
  done
  { echo "# gcc 15.2 -fsyntax-only's status of every file of the corpora (CS61 (a); bin/repr-c roundtrip --record-gcc):"
    echo "# STATUS<tab>CORPUS/NAME, each at its standard and modelled options, gcc's include directory first."
    [ -f test/repr/c/parse-gcc.tsv ] && grep -v '^#' test/repr/c/parse-gcc.tsv | awk -F'\t' -v ids=",$corpora," '{split($2, a, "/"); if (index(ids, "," a[1] ",") == 0) print}'
    for id in "${ids[@]}"; do cat "$work/$id/syn.tsv"; done
  } | awk 'NR <= 2 {print; next} {print | "LC_ALL=C sort -t\"\t\" -k2"}' > "$TMPDIR/parse-gcc.tsv"
  mv "$TMPDIR/parse-gcc.tsv" test/repr/c/parse-gcc.tsv
  echo "recorded test/repr/c/parse-gcc.tsv"
fi

# the originals' half of levels 3 and 4 (CS77 (a)): ORIG_KEY the entry's key (the original's bytes, its standard and options:
# what the pack's member depends on besides gcc, whose identity the manifest's header names)
orig_one() { # DIR NAME STD ARGS BASE RUN READ OUT: the original compiled (and linked and run) by gcc into OUT/NAME.{o,cc,stdout}
  local d=$1 f=$2 std=$3 args=$4 base=$5 run=$6 rd=${7:-$2} out=$8 gstd o os ro r
  gstd=$std; [ "$std" = c94 ] && gstd=iso9899:199409
  o=$out/$f.o; mkdir -p "$(dirname "$o")"
  # shellcheck disable=SC2086
  (cd "$base" && SOURCE_DATE_EPOCH=$epoch LC_ALL=C timeout 120 gcc -std=$gstd $args -isystem "$gi" -O0 -fno-stack-protector -fpermissive -w -c "$rd" -o "$o") > "$o.err" 2>&1
  os=$?; rm -f "$o.err"; [ $os = 0 ] || rm -f "$o"
  ro=-
  if [ "$run" = 1 ] && [ $os = 0 ]; then
    r=$out/.run/$f; mkdir -p "$r"
    if gcc "$o" -o "$r/a.out" -lm > "$r/link.err" 2>&1; then
      (cd "$r" && timeout 10 ./a.out < "$TMPDIR/repr-c-empty-stdin" > stdout 2> stderr); ro=$?
      cp "$r/stdout" "$out/$f.stdout"
    else ro=link; fi
    rm -rf "$r"
  fi
  printf '%s\n%s\n' "$os" "$ro" > "$out/$f.cc"
}
orig_key() { # BASE READ STD ARGS
  local f=$1/$2; case $2 in /*) f=$2 ;; esac
  { sha256sum < "$f" | cut -c1-64; printf '%s\n%s\n' "$3" "$4"; } | sha256sum | cut -c1-64
}
export -f orig_one orig_key
if [ -n "$record_orig$verify_orig" ]; then
  export epoch gi TMPDIR
  vst=0; tot=0; ndiff=0
  for id in "${ids[@]}"; do
    d=$work/$id; o=$d/orig-pack/c-roundtrip-orig-$id; rm -rf "$d/orig-pack"; mkdir -p "$o"
    isrun=0
    arbace_tool -e "(println (= :run (:action (first (filter #(= (:id %) :$id) (:corpora (read-string (slurp \"test/c/corpora.edn\"))))))))" | grep -q true && isrun=1
    # every file of the corpus (gcc.list: name, standard, options, the name read; from the corpus's base), whatever repr/c reads
    base=$(cat "$d/base.txt")
    awk -F'\t' -v b="$base" '{print $1 "\t" $2 "\t" $3 "\t" b "\t" $4}' "$d/gcc.list" > "$d/orig.list"
    list=$d/orig.list
    if [ -n "$sample" ]; then
      n=$(wc -l < "$list"); k=$(( n > sample ? n / sample : 1 ))
      awk -v k="$k" -v s="$sample" 'NR % k == 1 % k && c < s {print; c++}' "$list" > "$d/orig.sample"; list=$d/orig.sample
    fi
    awk -F'\t' -v d="$d" -v r="$isrun" -v o="$o" '{print d "\037" $1 "\037" $2 "\037" $3 "\037" $4 "\037" r "\037" $5 "\037" o}' "$list" | tr '\n' '\0' \
      | xargs -0 -P "$threads" -I{} bash -c 'IFS=$'"'"'\037'"'"' read -r d f std args base r rd o <<< "$1"; orig_one "$d" "$f" "$std" "$args" "$base" "$r" "$rd" "$o"' _ {}
    # the members and their keys: NAME.cc (the compile's status, the run's: a status, link or -), NAME.o, NAME.stdout
    tr '\t' '\037' < "$list" | while IFS=$'\037' read -r f std args base rd; do
      k=$(orig_key "$base" "${rd:-$f}" "$std" "$args")
      for x in cc o stdout; do [ -f "$o/$f.$x" ] && printf '%s.%s\t%s\n' "$f" "$x" "$k"; done
    done > "$d/orig.ids"
    if [ -n "$record_orig" ]; then
      oracle_make "$(orig_pin "$id")" "$d/orig-pack" "$d/orig.ids" "bin/repr-c roundtrip --record-orig --corpus $id" gcc || exit 1
    else
      p=$(orig_pin "$id")
      [ -f "$p" ] || { echo "verify: $id: no pack pinned ($p)"; vst=1; continue; }
      u=$(oracle_unpack "$p") || { vst=1; continue; }
      man=$(oracle_manifest "$p")
      while IFS=$'\t' read -r m k; do
        tot=$((tot + 1))
        want=$(awk -F'\t' -v m="$m" -v k="$k" '$1 == m {print ($2 == k ? $3 : "stale")}' "$man")
        got=$(sha256sum < "$o/$m" | cut -c1-64)
        [ "$want" = "$got" ] || { ndiff=$((ndiff + 1)); [ $ndiff -le 10 ] && echo "DIFF $id/$m: ${want:-unrecorded} recorded, $got afresh"; }
      done < "$d/orig.ids"
      # the crossed pair: the first two objects of the sample that differ, one's afresh against the other's member
      a=$(awk -F'\t' '$1 ~ /\.o$/ {print $1}' "$d/orig.ids" | head -1); b=$(awk -F'\t' '$1 ~ /\.o$/ {print $1}' "$d/orig.ids" | sed -n 2p)
      if [ -n "$a" ] && [ -n "$b" ] && ! cmp -s "$o/$a" "$o/$b"; then
        if [ "$(sha256sum < "$o/$a" | cut -c1-64)" = "$(awk -F'\t' -v m="$b" '$1 == m {print $3}' "$man")" ]; then echo "verify: FAILED: control: $id/$a afresh taken for $b's member"; vst=1
        else echo "verify: control: $id/$a afresh against $b's member differs, as it must"; fi
      fi
      # the acceptance (test/repr/c/parse-gcc.tsv's lines of the sample's files) afresh
      tr '\t' '\037' < "$list" | while IFS=$'\037' read -r f std args base rd; do
        gstd=$std; [ "$std" = c94 ] && gstd=iso9899:199409
        # shellcheck disable=SC2086
        (cd "$base" && SOURCE_DATE_EPOCH=$epoch LC_ALL=C gcc -std=$gstd $args -isystem "$gi" -fsyntax-only -w "${rd:-$f}") > "$TMPDIR/rt-syn.out" 2>&1
        sy=$?; tot=$((tot + 1))
        want=$(awk -F'\t' -v n="$id/$f" '$2 == n {print $1}' test/repr/c/parse-gcc.tsv)
        [ "$want" = "$sy" ] || echo "DIFF parse-gcc.tsv $id/$f: ${want:-unrecorded} recorded, $sy afresh"
        echo "ACCEPT"
      done > "$d/accept.out"
      grep '^DIFF' "$d/accept.out" | head -10
      tot=$((tot + $(grep -c '^ACCEPT' "$d/accept.out"))); ndiff=$((ndiff + $(grep -c '^DIFF' "$d/accept.out" || true)))
    fi
  done
  if [ -n "$verify_orig" ]; then
    oracle_verdict gcc "$(oracle_manifest "$(orig_pin "${ids[0]}")")" "$ndiff" "$tot" || vst=1
    exit $vst
  fi
fi

[ ${#todo[@]} = 0 ] || arbace_tool -m arbace.repr.c.rtcheck forms "$work" "${todo[@]}" || exit 1

# level 3: both compiled, the objects compared; level 4: both linked and run
cc_pair() { # DIR NAME STD ARGS BASE RUN READ [ORIG]: ORIG the unpacked c-roundtrip-orig-CORPUS (the originals' half recorded)
  local d=$1 f=$2 std=$3 args=$4 base=$5 run=$6 rd=${7:-$2} og=${8:-} gstd o p os ps cmp rdir ro rp same oro=
  gstd=$std; [ "$std" = c94 ] && gstd=iso9899:199409
  o=$d/obj/orig/$f.o; p=$d/obj/print/$f.o
  mkdir -p "$(dirname "$o")" "$(dirname "$p")"
  if [ -n "$og" ]; then
    # CS77 (a): the original's object, link and run from the pack, keyed by its bytes, standard and options (stale or
    # unrecorded: the row says so, and the run fails)
    if ! awk -F'\t' -v m="$f.cc" -v k="$(orig_key "$base" "$rd" "$std" "$args")" '$1 == m && $2 == k {ok = 1} END {exit !ok}' "$d/orig.tsv"; then
      printf '%s\tunrecorded\n' "$f" >> "$d/orig-missing.part.$$"; return
    fi
    os=$(sed -n 1p "$og/$f.cc"); oro=$(sed -n 2p "$og/$f.cc")
    [ "$os" = 0 ] && cp "$og/$f.o" "$o"
  else
  # shellcheck disable=SC2086
  (cd "$base" && SOURCE_DATE_EPOCH=$epoch LC_ALL=C timeout 120 gcc -std=$gstd $args -isystem "$gi" -O0 -fno-stack-protector -fpermissive -w -c "$rd" -o "$o") > "$o.err" 2>&1
  os=$?
  fi
  # shellcheck disable=SC2086
  (cd "$d/print/$f.d" && SOURCE_DATE_EPOCH=$epoch LC_ALL=C timeout 120 gcc -std=$gstd $args -iquote "$base/$(dirname "$f")" --embed-dir="$base/$(dirname "$f")" -isystem "$gi" -O0 -fno-stack-protector -fpermissive -w -c "$f" -o "$p") > "$p.err" 2>&1
  ps=$?
  cmp=-
  [ $os = 0 ] && [ $ps = 0 ] && { if cmp -s "$o" "$p"; then cmp=equal; else cmp=differ; fi; }
  printf '%s\t%s\t%s\t%s\n' "$f" "$os" "$ps" "$cmp" >> "$d/obj.part.$$"
  if [ "$run" = 1 ] && [ $os = 0 ] && [ $ps = 0 ]; then
    rdir=$d/run/$f; mkdir -p "$rdir/o" "$rdir/p"
    if [ -n "$og" ]; then
      [ "$oro" != link ] && gcc "$p" -o "$rdir/p/a.out" -lm > "$rdir/p/link.err" 2>&1 || { printf '%s\tlink\tlink\t-\n' "$f" >> "$d/run.part.$$"; return; }
      ro=$oro; [ -f "$og/$f.stdout" ] && cp "$og/$f.stdout" "$rdir/o/stdout" || : > "$rdir/o/stdout"
    else
    gcc "$o" -o "$rdir/o/a.out" -lm > "$rdir/o/link.err" 2>&1 && gcc "$p" -o "$rdir/p/a.out" -lm > "$rdir/p/link.err" 2>&1 || { printf '%s\tlink\tlink\t-\n' "$f" >> "$d/run.part.$$"; return; }
    (cd "$rdir/o" && timeout 10 ./a.out < "$TMPDIR/repr-c-empty-stdin" > stdout 2> stderr); ro=$?
    fi
    (cd "$rdir/p" && timeout 10 ./a.out < "$TMPDIR/repr-c-empty-stdin" > stdout 2> stderr); rp=$?
    same=differ; [ $ro = $rp ] && cmp -s "$rdir/o/stdout" "$rdir/p/stdout" && same=same
    printf '%s\t%s\t%s\t%s\n' "$f" "$ro" "$rp" "$same" >> "$d/run.part.$$"
    rm -f "$rdir/o/a.out" "$rdir/p/a.out"
  fi
}
export -f cc_pair; export epoch gi TMPDIR

status=0
for id in "${ids[@]}"; do
  [ -z "$nogcc" ] || break
  d=$work/$id
  # CS77 (a): the originals from their pack when the corpus has one pinned, else (not recorded yet) compiled as before
  og=
  if [ -f "$(orig_pin "$id")" ]; then
    u=$(oracle_unpack "$(orig_pin "$id")") || exit 1
    og=$u/c-roundtrip-orig-$id; cp "$(oracle_manifest "$(orig_pin "$id")")" "$d/orig.tsv"
  else echo "roundtrip: $id: no pack of the originals pinned ($(orig_pin "$id")): the originals compiled by gcc"; fi
  rm -f "$d"/orig-missing.part.*
  isrun=0
  if [ -n "$run" ] && arbace_tool -e "(println (= :run (:action (first (filter #(= (:id %) :$id) (:corpora (read-string (slurp \"test/c/corpora.edn\"))))))))" | grep -q true; then isrun=1; fi
  rm -f "$d"/obj.part.* "$d"/run.part.*
  awk -F'\t' -v d="$d" -v r="$isrun" -v og="$og" '{print d "\037" $1 "\037" $2 "\037" $3 "\037" $4 "\037" r "\037" $5 "\037" og}' "$d/gcc3.list" | tr '\n' '\0' \
    | xargs -0 -P "$threads" -I{} bash -c 'IFS=$'"'"'\037'"'"' read -r d f std args base r rd og <<< "$1"; cc_pair "$d" "$f" "$std" "$args" "$base" "$r" "$rd" "$og"' _ {}
  cat "$d"/obj.part.* 2>"$TMPDIR/repr-c-rt.err" > "$d/obj.tsv"; cat "$d"/run.part.* 2>"$TMPDIR/repr-c-rt.err" > "$d/run.tsv"
  rm -f "$d"/obj.part.* "$d"/run.part.*
  # ORS10 (a): an original the pack lacks (or whose bytes, standard or options changed) fails the run
  if ls "$d"/orig-missing.part.* > "$TMPDIR/repr-c-rt.ls" 2>&1; then
    cat "$d"/orig-missing.part.* | sort | while IFS=$'\t' read -r f why; do echo "FAIL $id/$f	the original's half is $why in $(orig_pin "$id") (bin/repr-c roundtrip --record-orig --corpus $id)"; done
    status=1; rm -f "$d"/orig-missing.part.*
  fi
done
if [ -n "$nogcc" ]; then
  # no gcc: the judge's stale known entries of the classes only levels 3 and 4 give, for files that pass the rest, deferred to
  # the oracle tier (the judge itself, arbace.repr.c.rtcheck, is embedded: its own --no-gcc lands with gate_key's next change)
  for id in "${ids[@]}"; do rm -f "$work/$id/obj.tsv" "$work/$id/run.tsv"; done
  arbace_tool -m arbace.repr.c.rtcheck judge "$work" "${ids[@]}" > "$work/judge.out" 2>&1; jst=$?
  arbace_tool -e "(doseq [[c es] (:roundtrip (read-string (slurp \"test/repr/c/roundtrip-known.edn\"))) [f e] es] (println (str (name c) \"/\" f \"\t\" (name (:class e)))))" > "$work/known-classes.tsv"
  awk -F'\t' 'NR == FNR {k[$1] = $2; next}
       /^FAIL / && $2 == "known entry stale" {id = substr($1, 6); c = k[id]
         if (c == "objects" || c == "objects-macro-body" || c == "run-address" || c == "print-grammar") {print "deferred " id "\t" c " (levels 3-4: the oracle tier)"; next}}
       {print}' "$work/known-classes.tsv" "$work/judge.out" > "$work/judge-nogcc.out"
  cat "$work/judge-nogcc.out"
  # the judge failed for a reason other than the deferred entries: a failing file, a stale entry of another class, a file of
  # no class, a control that passed or was not judged (each a FAIL line or a summary's words), or no judgment at all
  if [ "$jst" != 0 ] && { grep -q '^FAIL \| of no class\|control passed\|control not judged' "$work/judge-nogcc.out" || ! grep -q ' files ' "$work/judge-nogcc.out"; }; then status=1; fi
  echo "roundtrip --no-gcc: levels 1-2 and the acceptance; $(grep -c '^deferred ' "$work/judge-nogcc.out") known entries deferred to the oracle tier"
else
arbace_tool -m arbace.repr.c.rtcheck judge "$work" "${ids[@]}" || status=1
fi
if [ -n "$record" ]; then
  # 3: the known file written with files of no class left out (printed; no placeholder class, queue 122 F1): the
  # judgment and the results go on, and the run fails
  arbace_tool -m arbace.repr.c.rtcheck record "$work" "${ids[@]}"
  rst=$?
  [ $rst = 0 ] || [ $rst = 3 ] || { echo "the record failed"; exit 1; }
  status=0
  arbace_tool -m arbace.repr.c.rtcheck judge "$work" "${ids[@]}" || status=1
  # CS240 (a): every file's row [ID RESULT REASON] (the passes bin/reap counts), the other corpora's rows kept; not
  # with --no-run, whose level 4 is not the check's
  if [ -n "$run" ]; then
    arbace_tool -m arbace.repr.c.results roundtrip "$work" "${REPR_C_RESULTS_FILE:-test/repr/c/roundtrip-results.edn}" "${ids[@]}" || status=1
  else
    echo "roundtrip: no results file written (--no-run)"
  fi
fi
[ -z "$record" ] || [ "${rst:-0}" = 0 ] || status=1
exit $status

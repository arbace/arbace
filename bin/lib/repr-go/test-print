#!/bin/bash
# The tests of repr/go's printer (test/repr/go/print_test.ae, doc/go/PRINTER-NOTES.md), run on Arbace's
# Go executable (bin/lib/tools.bash's arbace_tool: the tools' host). Each case test/repr/go/cases/NAME.ae (Go forms) is printed
# in both layouts (gofmt, lines) into .tmp/repr-go-print-tests/NAME/; the gofmt layout must be left
# as it is by gofmt, the lines layout must parse; when the original Go of the case exists
# (NAME.go, or a directory NAME/), the printed files are compared with it by tools/gocmp at the
# levels the case names (default tree, export, code), and, for cases marked lines, by
# test/repr/go/golines (the lines of declarations, statements and closing braces).
#
# Usage: bin/repr-go test print [REGEX]    only the cases whose name matches REGEX
# Environment: ARBACE_GOROOT (default /root/tamago-go), REPR_GO_GOARCH (default amd64).
set -euo pipefail
export CGO_ENABLED=0 # Go's builds never use cgo (doc/go/BOX-NOTES.md, "... cgo dropped", 2026-10-16)
root=$(cd "$(dirname "$0")/../../.." && pwd)
. "$root/bin/lib/renamed-env.bash" # stops on a stale G2A_GOROOT or A2G_*
. "$root/bin/lib/tools.bash"
goroot=${ARBACE_GOROOT:-/root/tamago-go}
work=$root/.tmp/repr-go-print-tests
mkdir -p "$work/bin"
for tool in tools/gocmp:gocmp test/repr/go/golines:golines; do
  (cd "$root/${tool%%:*}" && env -u GOOS -u GOARCH GOROOT="$goroot" GOTOOLCHAIN=local GOFLAGS= GOWORK=off \
     "$goroot/bin/go" build -o "$work/bin/${tool##*:}" .) || { echo "cannot build ${tool%%:*}" >&2; exit 2; }
done
arbace_tool -p "$root/test" -D repr.go.root="$root" -D repr.go.work="$work" \
  -D repr.go.goroot="$goroot" -D repr.go.goarch="${REPR_GO_GOARCH:-amd64}" -D repr.go.only="${1:-}" -e "
(require 'arbace.test)
(require 'repr.go.print-test)
(let [r (arbace.test/run-tests 'repr.go.print-test)]
  (shutdown-agents)
  (System/exit (if (zero? (+ (:fail r) (:error r))) 0 1)))"

#!/bin/bash
# C++'s dg check (doc/cpp/CPP-SURVEY.md, "As built: CX9 (write-ahead)"; arbace.repr.cpp.dg, its header): gcc 15.2.0's g++.dg
# tests by their DejaGnu directives, in three parts, each file of g++.dg in at most one:
#   dg-error    the files with a dg-error directive (not preprocess, not modules/): each run as DejaGnu runs it at one
#               standard; the oracle (clang 23.1.5 through tools/cxxdump) accepts the unit, then repr/cpp reads it into
#               forms, or rejects it with its errors; the errors' lines judged against the dg-error lines (C's verdicts);
#               since CP247 (a) the oracle's dumps are read from the pack test/repr/cpp/records/cxxdump-dg-error (cxxdump
#               -records, no clang; `bin/repr-cpp record-dumps dg-error` by hand), REPR_CPP_LIVE=1 runs clang (the oracle tier's
#               cpp-dg-oracle, and the recording);
#   preprocess  the dg-do preprocess files: the shared preprocessor's errors judged the same way;
#   modules     modules/ but its preprocess files: each file read and printed as a single translation unit by the round
#               trip (bin/lib/repr-cpp/roundtrip --no-objects, key gxx-modules-*: test/repr/cpp/roundtrip-oracle.edn,
#               roundtrip-results/gxx-modules-*.edn, roundtrip-known.edn), an importer the oracle's rejection.
# g++ 15.2, the reference, is run on the dg-error and preprocess files with the same options (-S, -E for preprocess) only
# with --record-ref (its errors by line recorded in test/cpp/ref-dg-gxx15.edn; the judge reads the record).
#
# Usage: bin/repr-cpp dg [--corpus dg-error,preprocess,modules] [--dirs D,...] [--only LIST] [--sample N]
#                        [--record] [--record-ref] [--judge] [--own] [--reader native|clang] [--rt-judge own|clang] [--dumps-only]
#   --corpus   the parts (default dg-error,preprocess)
#   --dirs     only the files under these directories of g++.dg (`.` its top level)
#   --only     only the files of LIST (names under g++.dg/ or gxx-dg/NAME, one a line)
#   --sample   every Nth file of the part
#   --record   the part's record rewritten from the run (test/cpp/check-dg-linux-amd64.edn, the preprocess part's
#              test/repr/cpp/dg-preprocess-results.edn; the rows of files not run kept) and the seconds (test/cpp/dg-times.edn);
#              for modules, the round trip's --record-oracle --record-known-rejected --record-results (CPR1: the rejected units read natively)
#   --record-ref  g++ run on the files, its errors merged into test/cpp/ref-dg-gxx15.edn
#   --judge    the last run judged again, nothing run
#   --own      each part by its own verdict alone, no toolchain (cpp-target, ORS31 (a)): preprocess as always (the shared preprocessor's
#              errors against the dg directives), modules' round trip --judge own (levels 1 and 5 on the native parser); the dg-error part,
#              clang's acceptance and errors, from the recorded dumps (CP247 (a); refused with REPR_CPP_LIVE; with no pack pinned yet it
#              prints "no record yet" and is skipped, exit 0)
#   --dumps-only  the dg-error part's oracle run alone (bin/repr-cpp record-dumps's), no read, no judgment
#   --reader   clang (the default): an accepted unit's forms from the oracle's dump; native: by the native parser (CX11,
#              doc/cpp/NATIVE.md), the oracle still judging acceptance and errors, and the modules part's round trip --reader native
#   --rt-judge the modules part's round trip judge (cpp-compl): clang (the default) or own (roundtrip --judge own, cpp-90: no dump;
#              with --record only --record-results, into test/repr/cpp/roundtrip-results/own/gxx-modules-*.edn)
# Writes under .tmp/repr-cpp-dg/ (REPR_CPP_DG_WORK): PART/{dg.edn,run.tsv,clang/,forms/,read.edn,rows.edn,gxx/}.
# The light tier: REPR_CPP_THREADS (default 4) jobs, GOMAXPROCS=4 and GOMEMLIMIT=1500MiB unless set.
set -uo pipefail
root=$(cd "$(dirname "$0")/../../.." && pwd)
. "$root/bin/lib/tmpdir.bash"
. "$root/bin/lib/tools.bash"
cd "$root"
parts=dg-error,preprocess dirs= only= sample= record= recref= judge= reader=clang rtjudge=clang own= dumps_only=
while [ $# -gt 0 ]; do
  case $1 in
    --corpus) parts=$2; shift 2 ;;
    --dirs) dirs=$2; shift 2 ;;
    --only) only=$(cd "$(dirname "$2")" && pwd)/$(basename "$2"); shift 2 ;;
    --sample) sample=$2; shift 2 ;;
    --record) record=1; shift ;;
    --record-ref) recref=1; shift ;;
    --judge) judge=1; shift ;;
    --own) own=1; shift ;;
    --dumps-only) dumps_only=1; shift ;;
    --reader) case $2 in native|clang) reader=$2 ;; *) echo "repr-cpp dg: --reader native|clang" >&2; exit 2 ;; esac; shift 2 ;;
    --rt-judge) case $2 in own|clang) rtjudge=$2 ;; *) echo "repr-cpp dg: --rt-judge own|clang" >&2; exit 2 ;; esac; shift 2 ;;
    *) sed -n '17,38p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
  esac
done
live=${REPR_CPP_LIVE:-}
. "$root/test/oracle-records/oracle.bash"
. "$root/test/oracle-records/cpp.bash"
case ",$parts," in *,dg-error,*) [ -z "$own" ] || [ -z "$live" ] || { echo "repr-cpp dg: --own reads the dg-error part's recorded dumps; REPR_CPP_LIVE runs clang (the oracle tier's)" >&2; exit 2; } ;; esac
[ -z "$dumps_only" ] || [ "$parts" = dg-error ] || { echo "repr-cpp dg: --dumps-only is the dg-error part's" >&2; exit 2; }
[ -z "$dumps_only" ] || [ -n "$live" ] || { echo "repr-cpp dg: --dumps-only makes the dumps: REPR_CPP_LIVE=1 (bin/repr-cpp record-dumps)" >&2; exit 2; }
# the records' paths name the checkout as @ROOT@ and the g++.dg tree as @TREE@ (tools/cxxdump's rootRel): a pack is every checkout's
# the records are the clang reader's
if [ "$reader" = native ] && [ -n "$record$recref" ]; then echo "repr-cpp dg: --record and --record-ref are the clang reader's" >&2; exit 2; fi
export GOMAXPROCS=${GOMAXPROCS:-4} GOMEMLIMIT=${GOMEMLIMIT:-1500MiB} REPR_CPP_READER=$reader
jobs=${REPR_CPP_THREADS:-4}; export REPR_CPP_THREADS=$jobs
work=${REPR_CPP_DG_WORK:-$root/.tmp/repr-cpp-dg}
mkdir -p "$work"; work=$(cd "$work" && pwd)
main=$root
case $root in */.tmp/worktrees/*) main=${root%%/.tmp/worktrees/*} ;; esac
# g++.dg: the pinned tarball's tree (pp-check's extraction, else C's), its count checked by the lists
gxxdg=${REPR_CPP_GXX_DG:-}
for c in "$root/.tmp/cpp-gcc/gcc-15.2.0/gcc/testsuite/g++.dg" "$main/.tmp/cpp-gcc/gcc-15.2.0/gcc/testsuite/g++.dg" "$main/.tmp/repr-c/gcc-15.2.0/gcc/testsuite/g++.dg"; do
  [ -n "$gxxdg" ] || { [ -d "$c" ] && gxxdg=$c; }
done
[ -n "$gxxdg" ] || { echo "repr-cpp dg: no g++.dg tree (bin/repr-cpp pp-check extracts the pinned tarball; or REPR_CPP_GXX_DG)" >&2; exit 1; }
exe=${REPR_CPP_CXXDUMP_EXE:-$root/.tmp/repr-cpp/cxxdump}
export CXXDUMP_ROOT=$root CXXDUMP_TREE=$gxxdg
cache=${REPR_CPP_CXXDUMP_CACHE:-$root/.tmp/repr-cpp/cxxdump-cache}
mkdir -p "$cache"
# the oracle's filter, from the checkout's tools/cxxdump, for the dg-error part (live: into the cache; else: the records, no clang)
cacheargs=
case ",$parts," in
  *,dg-error,*)
    [ -n "${REPR_CPP_CXXDUMP_EXE:-}" ] || "$root/bin/repr-cpp" cxxdump-ensure >&2 || exit 1
    if [ -n "$live" ]; then cacheargs="-cache $cache"
    elif [ -z "$judge" ]; then
      if ! ls "$root"/test/repr/cpp/records/cxxdump-dg-error.sha256 > "$TMPDIR/repr-cpp-dg-pin.out" 2>&1; then
        # CP247 (a)'s write-ahead: until the night records the pack the part has no record to read
        echo "dg-error: no record yet (CP247 (a): bin/repr-cpp record-dumps dg-error, by hand on a host with clang); skipped"
        parts=$(echo ",$parts," | sed 's/,dg-error,/,/; s/^,//; s/,$//')
        [ -n "$parts" ] || exit 0
      else
        recs=$(cpr_dump_dirs) || { echo "repr-cpp dg: the dg-error part's records are refused (bin/oracle-records check)" >&2; exit 1; }
        cacheargs="-records $recs"
        export CXXDUMP_CLANG_ID; CXXDUMP_CLANG_ID=$(cpr_clang_line)
      fi
    fi ;;
esac
# arbace.c.dg is embedded in the executable (C9): -s loads the checkout's (its dg-line names, review 196's finding 4)
filt() { grep -v 'Reflection\|recur arg\|Auto-boxing' | head -c 200000; }

# the --dirs filter as an --only list
if [ -n "$dirs" ] && [ -z "$only" ]; then
  only=$work/dirs.list; : > "$only"
  IFS=, read -r -a ds <<< "$dirs"
  for d in "${ds[@]}"; do
    if [ "$d" = . ]; then (cd "$gxxdg" && find . -maxdepth 1 -type f | sed 's#^\./##') >> "$only"
    else (cd "$gxxdg" && find "$d" -type f) >> "$only"; fi
  done
fi

clang1() { # NAME CLANG-ARGS: the oracle's dump of the file, its status, diagnostics and seconds
  local n=$1 cargs=$2 o t0 t1
  o=$wd/clang/${n//\//__}
  t0=$(date +%s%N)
  # shellcheck disable=SC2086
  (cd "$gxxdg" && timeout 300 "$exe" -implicit=false $cacheargs -o "$o.edn" -- -x c++ -std=$3 $cargs -ferror-limit=0 -Wno-unknown-warning-option -iquote "$(dirname "$gxxdg/$n")" --embed-dir="$gxxdg" "$n") > "$o.err" 2>&1
  echo $? > "$o.status"
  t1=$(date +%s%N)
  echo "$(( (t1 - t0) / 1000000 ))" | awk '{printf "%.3f\n", $1/1000}' > "$o.secs"
}
gxx1() { # NAME STD G++-ARGS ACTION: g++'s diagnostics of the file (-S, or -E), filtered to its diagnostic lines
  local n=$1 std=$2 gargs=$3 act=$4 o
  o=$wd/gxx/${n//\//__}
  # shellcheck disable=SC2086
  (cd "$gxxdg" && LC_ALL=C timeout 300 g++ -x c++ -std=$std $gargs -fdiagnostics-plain-output -iquote "$(dirname "$gxxdg/$n")" --embed-dir="$gxxdg" $([ "$act" = preprocess ] && printf %s -E || printf %s -S) -o "$o.out" "$n") 2>&1 \
    | grep -a -E '^[^ ][^ ]*:[0-9]+:([0-9]+:)? (fatal error|error|warning|note): |^[^ :][^ :]*: (fatal error|error): ' | head -c 1000000 > "$o.txt"
  echo "${PIPESTATUS[0]}" > "$o.status"
  rm -f "$o.out"
}
export -f clang1 gxx1; export exe cache gxxdg cacheargs

status=0
IFS=, read -r -a ps <<< "$parts"
for part in "${ps[@]}"; do
  wd=$work/$part; export wd
  if [ "$part" = modules ]; then
    if [ -z "$judge" ]; then
      arbace_tool -s arbace.c.dg -m arbace.repr.cpp.dg lists "$work" "$gxxdg" modules "${only:--}" "${sample:--}" 2>&1 | filt
    fi
    if [ "$rtjudge" = own ] || [ -n "$own" ]; then
      rt=(--judge own)
      [ -z "$record" ] || rt+=(--record-results --replace-results)
    else
      rt=(--no-objects --reader "$reader")
      [ -z "$record" ] || rt+=(--record-oracle --replace-oracle --record-known-rejected --record-results --replace-results)
    fi
    "$root/bin/lib/repr-cpp/roundtrip" "$wd/roundtrip.list" "$wd/rt" "${rt[@]}" --jobs "$jobs" 2>&1 | filt
    [ "${PIPESTATUS[0]}" -eq 0 ] || status=1
    continue
  fi
  if [ -z "$judge" ]; then
    rm -rf "${wd:?}/clang" "$wd/forms" "$wd/gxx" "$wd/read.edn" "$wd/gxx.edn"
    mkdir -p "$wd/clang" "$wd/gxx"
    arbace_tool -s arbace.c.dg -m arbace.repr.cpp.dg lists "$work" "$gxxdg" "$part" "${only:--}" "${sample:--}" 2>&1 | filt
    [ "${PIPESTATUS[0]}" -eq 0 ] || { echo "repr-cpp dg: the lists failed" >&2; exit 1; }
    t0=$(date +%s)
    if [ "$part" = dg-error ]; then
      tr '\t\n' '\037\0' < "$wd/run.tsv" | xargs -0 -r -P "$jobs" -I{} nice bash -c 'IFS=$'"'"'\037'"'"' read -r n s g c <<< "$1"; clang1 "$n" "$c" "$s"' _ {}
    fi
    t1=$(date +%s)
    if [ -n "$dumps_only" ]; then echo "$part: oracle $((t1-t0)) s (--dumps-only)"; continue; fi
    arbace_tool -s arbace.c.dg -m arbace.repr.cpp.dg read "$work" "$part" 2>&1 | filt
    t2=$(date +%s)
    if [ -n "$recref" ]; then
      act=compile; [ "$part" = preprocess ] && act=preprocess
      tr '\t\n' '\037\0' < "$wd/run.tsv" | xargs -0 -r -P "$jobs" -I{} nice bash -c 'IFS=$'"'"'\037'"'"' read -r n s g c <<< "$1"; gxx1 "$n" "$s" "$g" '"$act" _ {}
      arbace_tool -s arbace.c.dg -m arbace.repr.cpp.dg ref "$work" "$part" --record 2>&1 | filt
    fi
    t3=$(date +%s)
    echo "$part: oracle $((t1-t0)) s, read $((t2-t1)) s, g++ $((t3-t2)) s" | tee "$wd/times.txt"
  fi
  arbace_tool -s arbace.c.dg -m arbace.repr.cpp.dg judge "$work" ${record:+--record} "$part" 2>&1 | filt
  [ "${PIPESTATUS[0]}" -eq 0 ] || status=1
done
exit $status

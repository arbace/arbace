}

prepare() {
  local d st have
  d=$(srcdir)
  [ -f "$d.ok" ] && { echo "$d"; return 0; }
  [ -f "$tb" ] || { echo "ppref: no gcc tarball at $tb (REPR_CPP_GCC_TARBALL)" >&2; return 1; }
  have=$(sha256sum < "$tb" | cut -c1-64)
  [ "$have" = "$want" ] || { echo "ppref: $tb is not the pinned gcc 15.2.0 ($have, want $want)" >&2; return 1; }
  st=$d.$$; rm -rf "$st"; mkdir -p "$st"
  local files=(gcc-15.2.0/libcpp gcc-15.2.0/include gcc-15.2.0/gcc/config/i386/cpuid.h)
  for f in $iberty; do files+=("gcc-15.2.0/libiberty/$f.c"); done
  for f in $iberty_h; do files+=("gcc-15.2.0/libiberty/$f"); done
  nice tar -xJf "$tb" -C "$st" "${files[@]}" || { rm -rf "$st"; echo "ppref: the extraction failed" >&2; return 1; }
  write_configs "$st"
  rm -rf "$d"; mv "$st" "$d"; : > "$d.ok"
  echo "$d"
}

harness_key() { cat tools/ppref/ppref.cc tools/ppref/shim.c "$0" | digest; }
native_key() { { src_key; harness_key; g++ --version | head -1; gcc --version | head -1; } | digest; }
own_key() {
  { src_key; harness_key
    # what the build is made by: the code generator, the lowering, repr/cpp's and repr/c's readers, ci's checker, builder and cf2g, ci's
    # back end, the C target, the exceptions' layer, TamaGo's go
    git ls-files -s arbace/cpp arbace/repr/cpp arbace/repr/c arbace/c arbace/c.ae go/arbace/ci go/arbace/crt c/target cpp/target \
      arbace/repr/llvm arbace/repr/llvm.ae
    git diff HEAD -- arbace/cpp arbace/repr/cpp arbace/repr/c arbace/c arbace/c.ae go/arbace/ci go/arbace/crt c/target cpp/target \
      arbace/repr/llvm arbace/repr/llvm.ae | sha256sum
    cat "$root/seed/goroot.sha256" 2>/dev/null
  } | digest
}

build_native() {
  local s o k t
  s=$(prepare) || return 1
  k=$(native_key); o=$store/native-$k
  [ -x "$o/ppref" ] && { echo "$o/ppref"; return 0; }
  t=$o.$$; rm -rf "$t"; mkdir -p "$t/obj"
  local G=$s/gcc-15.2.0 u
  for u in $units; do
    g++ -std=gnu++17 -O1 -fno-exceptions -fno-rtti -w -I"$s/cfg" -I"$G/libcpp" -I"$G/libcpp/include" -I"$G/include" -I"$G" \
      -c "$G/libcpp/$u.cc" -o "$t/obj/$u.o" || { echo "ppref: g++ failed on $u.cc" >&2; return 1; }
  done
  g++ -std=gnu++17 -O1 -fno-exceptions -fno-rtti -w -I"$s/cfg" -I"$G/libcpp" -I"$G/libcpp/include" -I"$G/include" \
    -c tools/ppref/ppref.cc -o "$t/obj/ppref.o" || return 1
  for u in $iberty; do
    gcc -std=gnu17 -O1 -w -DHAVE_CONFIG_H -I"$s/iberty-cfg" -I"$G/include" -c "$G/libiberty/$u.c" -o "$t/obj/iberty-$u.o" || return 1
  done
  g++ -o "$t/ppref" "$t"/obj/*.o || return 1
  rm -rf "$o"; mv "$t" "$o"
  echo "$o/ppref"
}

build_own() {
  local s o k t G u n
  ulimit -v "${PPREF_ULIMIT_KIB:-8388608}"
  mkdir -p "$store"
  exec 7> "$store/build.lock"; flock 7
  s=$(prepare) || return 1
  k=$(own_key); o=$store/own-$k
  [ -x "$o/ppref" ] && { echo "$o/ppref"; return 0; }
  t=$o.work; mkdir -p "$t/gen" "$t/lib"
  G=$s/gcc-15.2.0
  # 1. libcpp's units and the harness by Arbace's C++ front end and code generator, a unit's lowered C each (gen.c)
  local opts="-U__GNUC__ -fno-exceptions -I$s/cfg -I$G/libcpp -I$G/libcpp/include -I$G/include"
  : > "$t/gen.tsv"
  for u in $units; do printf '%s\t%s\t%s\t%s\n' "$G/libcpp/$u.cc" c++17 "$t/gen/$u" "$opts" >> "$t/gen.tsv"; done
  printf '%s\t%s\t%s\t%s\n' "$root/tools/ppref/ppref.cc" c++17 "$t/gen/ppref" "$opts" >> "$t/gen.tsv"
  local todo=$t/gen.todo
  while IFS=$'\t' read -r p std d a; do
    [ -f "$d/gen.c" ] && [ ! -f "$d/gen.refused" ] && continue
    rm -rf "$d"; mkdir -p "$d"; printf '%s\t%s\t%s\t%s\n' "$p" "$std" "$d" "$a"
  done < "$t/gen.tsv" > "$todo"
  if [ -s "$todo" ]; then
    split -n "l/${PPREF_JOBS:-1}" -d "$todo" "$todo."
    for c in "$todo".*; do
      [ -s "$c" ] || continue
      ( . "$root/bin/lib/repr-cpp/sysroot.bash"; cpp_sysroot || exit 1
        GOMEMLIMIT=3GiB arbace_tool -m arbace.cpp.codegen gen-batch "$c" > "$c.log" 2>&1 ) &
    done
    wait
    rm -f "$todo".*
  fi
  local refused=0
  while IFS=$'\t' read -r p _ d _; do
    if [ -f "$d/gen.refused" ] || [ ! -f "$d/gen.c" ]; then
      refused=$((refused + 1)); echo "ppref: $(basename "$p"): refused: $(cut -c1-300 "$d/gen.refused" 2>/dev/null || echo 'no gen.c')" >&2
    fi
  done < "$t/gen.tsv"
  [ "$refused" = 0 ] || { echo "ppref: $refused units refused by the code generator: the reference is not built (the code generator's gaps)" >&2; return 3; }
  # 2. the library: the units' lowered C, libiberty's C units with their options, the exceptions' layer, the shim
  "$root/bin/cppi" runtime "$t/lib/eh.c" > "$t/lib/eh.log" 2>&1 || { cat "$t/lib/eh.log" >&2; return 1; }
  {
    for u in $units; do printf '%s\t%s\t\n' "cpp_$u" "$t/gen/$u/gen.c"; done
    for u in $iberty; do printf '%s\t%s\t%s\n' "iberty_$u" "$G/libiberty/$u.c" "-std=gnu17 -DHAVE_CONFIG_H -I$s/iberty-cfg -I$G/include"; done
    printf '%s\t%s\t\n' eh "$t/lib/eh.c"
    printf '%s\t%s\t%s\n' shim "$root/tools/ppref/shim.c" "-std=gnu17"
  } > "$t/lib/list.tsv"
  ( . "$root/bin/lib/repr-c/sysroot.bash"; c_sysroot && c_target_host || exit 1
    . "$root/bin/lib/crops/musl-hold.bash"; ci_musl_hold || exit 1
    . "$root/bin/lib/host.bash"; exe=$(arbace_host_exe) || exit 1
    # libcpp's charset unit is 10 MB of lowered C (its tables), its read about 6 GB
    GOMEMLIMIT=${PPREF_READ_MEMLIMIT:-5GiB} ARBACE_PATH=$root${ARBACE_PATH:+:$ARBACE_PATH} "$exe" -m arbace.cpp.run read-lib-opts "$t/lib" "$t/lib/list.tsv" "${PPREF_THREADS:-1}" ) > "$t/lib/read.log" 2>&1 \
    || { tail -20 "$t/lib/read.log" >&2; return 1; }
  # 3. the harness's lowered C linked with the library and translated by cf2g into a Go package
  "$root/bin/ci" cirun-build --ensure > "$t/cirun-build.log" 2>&1 || { tail -5 "$t/cirun-build.log" >&2; return 1; }
  local mod=$t/go
  rm -rf "$mod"; mkdir -p "$mod/progs" "$mod/main"
  cp -r "$root/.tmp/ci/go/ci" "$root/.tmp/ci/go/crt" "$mod/"
  printf 'module arbace\n\ngo 1.27\n' > "$mod/go.mod"
  printf 'ppref\t%s\t\tppref\n' "$t/gen/ppref/gen.c" > "$t/compile.list"
  ( . "$root/bin/lib/repr-c/sysroot.bash"; c_sysroot && c_target_host || exit 1
    . "$root/bin/lib/crops/musl-hold.bash"; ci_musl_hold || exit 1
    . "$root/bin/lib/host.bash"; exe=$(arbace_host_exe) || exit 1
    GOMEMLIMIT=6GiB ARBACE_PATH=$root${ARBACE_PATH:+:$ARBACE_PATH} "$exe" -m arbace.cpp.run compile-list "$mod" "$t/compile.list" "$t/lib" 2 ) > "$t/compile.log" 2>&1
  n=$(awk -F'\t' '$2 == "ok"' "$mod/nodes.tsv" 2>/dev/null | wc -l)
  [ "$n" = 1 ] || { echo "ppref: the link or cf2g failed:" >&2; cat "$mod/nodes.tsv" >&2 2>/dev/null; tail -5 "$t/compile.log" >&2; return 1; }
  printf 'package main\n\nimport (\n\t"os"\n\tppref "arbace/progs/ppref"\n)\n\nfunc main() {\n\tppref.Main(os.Args[1:])\n}\n' > "$mod/main/main.go"
  local go=${ARBACE_GOROOT:-/root/tamago-go}/bin/go
  (cd "$mod" && env CGO_ENABLED=0 GOFLAGS=-mod=mod GOCACHE=${PPREF_GOCACHE:-$root/.tmp/gocache} GOMAXPROCS=4 GOMEMLIMIT=6GiB \
     "$go" build -p 2 -trimpath -o "$t/ppref" ./main) > "$t/go-build.log" 2>&1 || { tail -20 "$t/go-build.log" >&2; return 1; }
  mkdir -p "$o"; mv "$t/ppref" "$o/ppref"; cp "$t/lib/read.log" "$mod/nodes.tsv" "$o/" 2>/dev/null
  echo "$o/ppref"
}

native=
verb=${1:-}; shift || true
[ "${1:-}" = --native ] && native=1
case $verb in
  prepare) prepare ;;
  build) if [ -n "$native" ]; then build_native; else build_own; fi ;;
  exe) if [ -n "$native" ]; then f=$store/native-$(native_key)/ppref; else f=$store/own-$(own_key)/ppref; fi
       [ -x "$f" ] && echo "$f" || { echo "ppref: not built at the checkout's key ($f): bin/repr-cpp ppref build${native:+ --native}" >&2; exit 1; } ;;
  key) if [ -n "$native" ]; then native_key; else own_key; fi ;;
  fidelity) # the oracle tier's: the native build against the records over the recorded samplings (pp-check --fidelity-only)
    exe=$(build_native) || exit 1
    st=0
    for c in "cpp-lexical" "gxx-dg --sample 10" "libstdcxx-headers --sample 8"; do
      # shellcheck disable=SC2086
      REPR_CPP_PPREF=$exe "$root/bin/repr-cpp" pp-check --fidelity-only --corpus $c || st=1
    done
    exit $st ;;
  *) sed -n '2,23p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac

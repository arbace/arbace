#!/bin/bash
# The token checks' reference (doc/cpp/CPP-SURVEY.md, "As built: pp-ref"; CP413 (a), CP414 (a), the user's rulings of 2026-11-20):
# GCC 15.2.0's libcpp, unmodified from the pinned gcc-15.2.0 tarball (test/cpp/corpora.edn's :gcc-15.2.0), behind Arbace's own
# harness tools/ppref/ppref.cc, built into .tmp only: nothing it makes is committed, packed or pushed (libcpp is
# GPL-3.0-or-later; LICENSE.md). Run through bin/repr-cpp ppref (from the repository root).
#
# Usage: bin/repr-cpp ppref prepare|build|exe|key|fidelity [--native]
#   prepare   the tarball checked against its pin, libcpp/, include/ and the libiberty files libcpp calls extracted into
#             .tmp/ppref/src-KEY/ with the configuration headers this script writes (libcpp's config.h and localedir.h,
#             libiberty's config.h: x86_64-linux-musl, the answers configure gives; ENABLE_CANONICAL_SYSTEM_HEADERS as Alpine's gcc)
#   build     Arbace's own build, the judge's (REPR_CPP_PP_JUDGE=own): libcpp's 14 units and the harness compiled by Arbace's C++
#             front end and code generator (arbace.cpp.codegen gen-batch: no clang, no g++; -U__GNUC__, libcpp's portable paths,
#             -fno-exceptions as GCC builds it), lowered to C, read by repr/c with libiberty's C units, the exceptions' layer
#             (arbace/cpp/rt/eh.c.ae) and tools/ppref/shim.c, linked and translated by cf2g, built by TamaGo's go into
#             .tmp/ppref/own-KEY/ppref (KEY: the sources', the harness's, the code generator's, the lowering's, repr/c's and ci's,
#             this script's); a unit the code generator refuses stops it (exit 3, the refusals listed: the code generator's gaps)
#   build --native  the same sources built by the host's g++ and gcc into .tmp/ppref/native-KEY/ppref: the oracle tier's and the
#             harness's development build, never the check's judge
#   exe [--native]  the build's executable at the checkout's key on the standard output, exit 1 when not built
#   key [--native]  the key
#   fidelity  the oracle tier's: the native build's runs against g++ -E's and clang's recorded digests over the token check's
#             recorded samplings (bin/repr-cpp pp-check --fidelity-only), every difference in the known file's :ref
# PPREF_JOBS (default 1): gen-batch's processes, each at GOMEMLIMIT 3GiB (a unit's peak about 3.3 GB); the library's read
# (PPREF_THREADS, default 1, at GOMEMLIMIT 5GiB: charset's 10 MB of lowered C, about 6 GB; two threads passed the cap), the link with cf2g's translation and TamaGo's go build at
# GOMEMLIMIT 6GiB: every process capped at 8 GiB of address space (ulimit -v, the host's rule of 2026-11-20 for jobs under 8 GiB:
# no heavy lock). The builds live in the main checkout's .tmp/ppref (PPREF_STORE), shared by key, one at a time (its build.lock).
set -uo pipefail
root=$(cd "$(dirname "$0")/../../.." && pwd)
. "$root/bin/lib/tmpdir.bash"
. "$root/bin/lib/tools.bash"
cd "$root"

main=${root%%/.tmp/gate-clean/*}; main=${main%%/.tmp/worktrees/*}
tb=${REPR_CPP_GCC_TARBALL:-$main/.tmp/c1/gcc/gcc-15.2.0.tar.xz}
want=$(sed -n '/:gcc-15.2.0/,/:sha256/p' test/cpp/corpora.edn | sed -n 's/.*:sha256 "\([0-9a-f]*\)".*/\1/p' | head -1)
units="charset directives errors expr files identifiers init lex line-map macro mkdeps pch symtab traditional"
iberty="hex obstack safe-ctype fopen_unlocked filename_cmp hashtab lbasename lrealpath md5 xmalloc xmemdup xstrdup xstrerror xvasprintf vprintf-support xexit"
iberty_h="vprintf-support.h"

digest() { sha256sum | cut -c1-16; }
src_key() { { echo "$want"; sed -n '/^write_configs() {/,/^}/p' "$0"; echo "$units $iberty $iberty_h"; } | digest; }
# the builds live in the main checkout's .tmp/ppref, shared by key by its worktrees and kept there alone (a worktree's or the clean
# run's clone's main checkout is the one it was made from; never committed, packed or pushed)
store=${PPREF_STORE:-$main/.tmp/ppref}
srcdir() { echo "$store/src-$(src_key)"; }

# the configuration headers (Arbace's own text: configure's answers for x86_64-linux-musl)

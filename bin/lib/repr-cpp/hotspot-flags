#!/bin/bash
# CP76 (b): the HotSpot corpus' flags against the JDK build's own: for each file of a list (pp-check's gxx.list format) the -D, -I and
# -std options of its object's command line (build/linux-x86_64-server-release/hotspot/variant-server/libjvm/objs/NAME.o.cmdline of the
# host's JDK checkout, JDK=/root/jdk26u) in order (the first of a repeated one; the -std options as a set), less the precompiled header's -I, against those of the list's g++ options (the
# entry's :cxx-args); the options of the command line the list does not have, or the other way round, are printed. The options that
# are g++'s alone or the build's (warnings, debug-prefix, -fno-lifetime-dse, -include precompiled.hpp, -o, -c) are not compared.
# Usage: bin/repr-cpp hotspot-flags LIST
set -uo pipefail
list=$1
jdk=${JDK:-/root/jdk26u}
objs=$jdk/build/linux-x86_64-server-release/hotspot/variant-server/libjvm/objs
cmpset() { local t; t=$(tr ' ' '\n' | sed "s/'//g" | grep -E '^-(D|I|std=)' | grep -v '/precompiled$'); printf '%s\n' "$t" | grep -E '^-(D|I)' | awk '!s[$0]++'; printf '%s\n' "$t" | grep '^-std=' | LC_ALL=C sort -u; }
. "$(dirname "$0")/../tmpdir.bash"
tmp=$TMPDIR/hotspot-flags.$$
n=0 bad=0 missing=0
while IFS=$'\t' read -r name std gargs path cargs; do
  n=$((n+1))
  b=$(basename "$name" .cpp)
  f=$objs/$b.o.cmdline
  case $name in share/adlc/*) f=$jdk/build/linux-x86_64-server-release/hotspot/variant-server/tools/adlc/objs/$b.o.cmdline ;; esac
  if [ ! -f "$f" ]; then missing=$((missing+1)); echo "no command line: $name"; continue; fi
  want=$(cmpset < "$f"); have=$(printf '%s' "$gargs" | cmpset)
  printf '%s\n' "$want" > "$tmp.w"; printf '%s\n' "$have" > "$tmp.h"
  d=$(diff "$tmp.w" "$tmp.h" | grep '^[<>]')
  if [ -n "$d" ]; then bad=$((bad+1)); echo "differs: $name"; printf '%s\n' "$d" | head -5; fi
done < "$list"
rm -f "$tmp.w" "$tmp.h"
echo "hotspot-flags: $n files, $bad differ from the build's command line, $missing without one"
[ "$bad" = 0 ]

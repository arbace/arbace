#!/bin/bash
# cppi's AOT check (doc/cpp/CPP-SURVEY.md §6, "As built: CX8 (write-ahead)"), C's bin/ci check --aot for C++: every program of the
# run corpora compiled to IR by the oracle, lowered, read, checked, linked with the lowered runtime and musl and built into its
# node program as bin/cppi check does (arbace.cpp.run's compile-list), then translated by cf2g (arbace.c.cf2g/translate) into a
# Go package over go/arbace/ci and go/arbace/crt, built by TamaGo's go in shards of programs (one package each, a shard one
# executable) and run with an empty standard input, no arguments, the budget (30 s; test/cpp/check-budget.edn), its status,
# standard output and standard error against g++ 15.2's -O0 run (test/cpp/ref-gxx15.edn); every program that does not pass in a
# class of test/cpp/divergences-aot.edn or test/cpp/divergences.edn (arbace.cpp.check's run-judge, level aot), against the
# committed record test/cpp/check-aot-linux-amd64.edn and, per program, the interpreted record (test/cpp/check-linux-amd64.edn).
# A program's Go is about 4 MB (it holds the runtime's linked part): the shards are small (CPPI_SHARD, default 4) and each
# shard's go build runs through the host's heavy slots when CPPI_HEAVY names the wrapper (.tmp/heavy). Each shard's sources and
# executable are deleted once run.
#
# Usage: bin/cppi check --aot [--corpus C,...] [--only LIST] [--sample N] [--record] [--judge] [--resume]
#   (the options of bin/cppi check); CPPI_JOBS (default 4) the runs', CPPI_THREADS (default 3) the builder's, CPPI_GO_P
#   (default 2) go build's -p; CPPI_AOT_WORK (default .tmp/cppi-aot)
set -uo pipefail
root=$(cd "$(dirname "$0")/../../.." && pwd)
. "$root/bin/lib/tmpdir.bash"
. "$root/bin/lib/tools.bash"
. "$root/bin/lib/cppi/lists.bash"
cd "$root"
corpora=$cppi_corpora_recorded only= sample=1 record= judge= resume=
while [ $# -gt 0 ]; do
  case $1 in
    --corpus) corpora=$2; shift 2 ;;
    --only) only=$(cd "$(dirname "$2")" && pwd)/$(basename "$2"); shift 2 ;;
    --sample) sample=$2; shift 2 ;;
    --record) record=1; shift ;;
    --judge) judge=1; shift ;;
    --resume) resume=1; shift ;;
    *) sed -n '15,17p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
  esac
done
if [ -n "$only" ] || [ "$sample" != 1 ]; then
  [ -n "$record" ] && { echo "bin/cppi check --aot: --record records whole corpora, not --only's or --sample's subset" >&2; exit 2; }
  export CI_SUBSET=1
fi
work=${CPPI_AOT_WORK:-$root/.tmp/cppi-aot}
jobs=${CPPI_JOBS:-4}; threads=${CPPI_THREADS:-3}; gop=${CPPI_GO_P:-2}; shard=${CPPI_SHARD:-4}
go=${ARBACE_GOROOT:-/root/tamago-go}/bin/go
mod=$work/go
mkdir -p "$work"
IFS=, read -r -a ids <<< "$corpora"
if [ -n "$judge" ]; then
  for id in "${ids[@]}"; do [ -f "$work/$id/subset" ] && export CI_SUBSET=1; done
  [ -n "${CI_SUBSET:-}" ] && [ -n "$record" ] && { echo "bin/cppi check --aot: --judge --record: the last run was a subset" >&2; exit 2; }
fi
budget() {
  local b; b=$(sed -n "s|^[{ ]*\"$1\" *\\([0-9][0-9]*\\).*|\\1|p" "$root/test/cpp/check-budget.edn" 2>"$TMPDIR/cppi-budget.err" | head -1)
  echo "${b:-${CPPI_BUDGET:-30}}"
}
gobuild() { # the shard's executable (CPPI_HEAVY: the host's heavy-slot wrapper, around go build alone)
  (cd "$mod" && ${CPPI_HEAVY:-} env CGO_ENABLED=0 GOFLAGS=-mod=mod GOCACHE=${CPPI_GOCACHE:-$root/.tmp/gocache} GOMAXPROCS=4 GOMEMLIMIT=4GiB \
     "$go" build -p "$gop" -trimpath -o "$@")
}

if [ -z "$judge" ]; then
  rtlib=$("$root/bin/cppi" runtime-ci) || exit 1
  "$root/bin/ci" cirun-build --ensure > "$work/cirun-build.log" 2>&1 || { cat "$work/cirun-build.log"; exit 1; }
  "$root/bin/ci" musl ensure || exit 1
  : > "$work/empty-stdin"
  ir1() {
    local d=$work/files/$1 t0
    rm -rf "$d"; mkdir -p "$d"; t0=$(date +%s.%N)
    # shellcheck disable=SC2086
    (cd "$d" && timeout 300 clang++ -x c++ -std=$2 $3 -O0 -S -emit-llvm "$4" -o x.ll; echo $? > ir.status) > "$d/ir.log" 2>&1
    echo "$(date +%s.%N) $t0" | awk '{printf "%.1f\n", $1 - $2}' > "$d/ir.secs"
  }
  export -f ir1; export work
  for id in "${ids[@]}"; do
    d=$work/$id
    if [ -z "$resume" ]; then rm -rf "${d:?}" "${work:?}/files/$id"; fi
    mkdir -p "$d"
    if [ -n "$only" ] || [ "$sample" != 1 ]; then printf '%s %s\n' "${only:-all}" "$sample" > "$d/subset"; else rm -f "$d/subset"; fi
    run_list "$id" > "$d/all.tsv" || exit 1
    grep -o '{:id "[^"]*" :status :no-build' test/cpp/ref-gxx15.edn | cut -d'"' -f2 > "$d/no-build.txt"
    awk -F'\t' -v only="${only:-}" -v nb="$d/no-build.txt" -v sm="$sample" '
      BEGIN { while ((getline l < nb) > 0) skip[l] = 1
              if (only != "") { while ((getline l < only) > 0) want[l] = 1 } }
      { n++; if ((n - 1) % sm != 0) next; if ($1 in skip) next; if (only != "" && !($1 in want)) next; print }' "$d/all.tsv" > "$d/list.tsv"
    # every program judged has g++'s run recorded (review 191, F4; 185's DECISION (a)): the sampled corpora's reference holds every
    # 25th program only, so a run of another selection is refused before anything runs, not failed program by program
    grep -o '^{:id "[^"]*"' test/cpp/ref-gxx15.edn | cut -d'"' -f2 > "$d/ref-ids.txt"
    nref=$(awk -F'\t' 'BEGIN { while ((getline l < ARGV[2]) > 0) r[l] = 1; ARGV[2] = "" } !($1 in r)' "$d/list.tsv" "$d/ref-ids.txt" | wc -l)
    if [ "$nref" != 0 ]; then
      echo "bin/cppi check: $nref programs of $id have no g++ run in test/cpp/ref-gxx15.edn (bin/cppi record-ref --corpus $id first; the recorded part of libstdcxx and gxx-dg-run is --sample 25)" >&2
      exit 2
    fi
    : > "$d/done.txt"
    if [ -n "$resume" ] && [ -f "$d/nodes.tsv" ]; then cut -f1 "$d/nodes.tsv" > "$d/done.txt"; fi
    awk -F'\t' 'BEGIN { while ((getline l < ARGV[2]) > 0) done[l] = 1; ARGV[2] = "" } !($1 in done)' "$d/list.tsv" "$d/done.txt" > "$d/todo.tsv"
    [ -s "$d/todo.tsv" ] || continue
    tr '\t\n' '\037\0' < "$d/todo.tsv" | xargs -0 -P "$jobs" -I{} nice bash -c 'IFS=$'"'"'\037'"'"' read -r i s a p <<< "$1"; ir1 "$i" "$s" "$a" "$p"' _ {}
    xlib=
    if [ "$id" = libstdcxx ]; then
      xlib=$work/util
      if [ ! -f "$xlib/index.edn" ]; then
        rm -rf "$xlib"; mkdir -p "$xlib"
        for f in testsuite_abi testsuite_allocator testsuite_character testsuite_hooks; do
          mkdir -p "$xlib/src/$f"
          clang++ -std=gnu++17 -O0 -S -emit-llvm -I"$cppi_ts/util" "$cppi_ts/util/$f.cc" -o "$xlib/src/$f/x.ll" || exit 1
          printf '%s\t%s\n' "$f" "$xlib/src/$f/x.ll"
        done > "$xlib/ll.tsv"
        GOMEMLIMIT=${CPPI_CI_MEMLIMIT:-6GiB} arbace_tool -m arbace.cpp.run lower-lib "$xlib" "$xlib/ll.tsv" "$threads" > "$xlib/read.log" 2>&1 || { tail -5 "$xlib/read.log"; exit 1; }
      fi
    fi
    rm -f "$d"/shard.*
    split -l "$shard" -d -a 5 "$d/todo.tsv" "$d/shard."
    for s in "$d"/shard.[0-9][0-9][0-9][0-9][0-9]; do
      [ -f "$s" ] || continue
      awk -F'\t' -v w="$work" -v x="$xlib" '{ st = ""; f = w "/files/" $1 "/ir.status"; if ((getline st < f) <= 0) st = ""; close(f)
                                               print $1 "\t" (st == "0" ? w "/files/" $1 "/x.ll" : "-") "\t" x "\tp" NR }' "$s" > "$s.list"
      rm -rf "$mod"; mkdir -p "$mod/progs" "$mod/shard"
      cp -r "$root/.tmp/ci/go/ci" "$root/.tmp/ci/go/crt" "$mod/"
      printf 'module arbace\n\ngo 1.27\n' > "$mod/go.mod"
      GOMEMLIMIT=${CPPI_CI_MEMLIMIT:-6GiB} arbace_tool -m arbace.cpp.run compile-list "$mod" "$s.list" "$rtlib" "$threads" > "$s.compile.log" 2>&1
      [ -f "$mod/nodes.tsv" ] && cat "$mod/nodes.tsv" >> "$d/nodes.tsv"
      awk -F'\t' '$2 == "ok" {print $1}' "$mod/nodes.tsv" 2>"$TMPDIR/cppi-aot.err" | sort > "$s.ok"
      awk -F'\t' '{print $1 "\t" $4}' "$s.list" | sort > "$s.pkgs"
      join -t "$(printf '\t')" "$s.ok" "$s.pkgs" > "$s.built" 2>>"$s.compile.log" || true
      if [ -s "$s.built" ]; then
        {
          echo 'package main'; echo; echo 'import ('; echo '	"os"'
          cut -f2 "$s.built" | while read -r p; do echo "	$p \"arbace/progs/$p\""; done
          echo ')'; echo; echo 'func main() {'; echo '	switch os.Args[1] {'
          cut -f2 "$s.built" | while read -r p; do echo "	case \"$p\":"; echo "		$p.Main(os.Args[2:])"; done
          echo '	}'; echo '	println("ciaot: internal: no package", os.Args[1])'; echo '	os.Exit(70)'; echo '}'
        } > "$mod/shard/main.go"
        exe=$work/shard.exe
        t0=$(date +%s)
        if ! gobuild "$exe" ./shard > "$s.build.log" 2>&1; then
          cut -f2 "$s.built" | while read -r p; do
            if ! gobuild "$work/pkg.a" "./progs/$p" > "$s.$p.log" 2>&1; then
              i=$(awk -F'\t' -v p="$p" '$2 == p {print $1}' "$s.built")
              printf '%s\tgo-error\t\t%s\t\t\n' "$i" "$(grep -m1 'prog.go' "$s.$p.log" | cut -c1-200 | tr '\t' ' ')" >> "$d/go-errors.tsv"
              awk -F'\t' -v p="$p" '$2 != p' "$s.built" > "$s.built.new" && mv "$s.built.new" "$s.built"
              sed -i "/\"arbace\/progs\/$p\"\$/d; /case \"$p\":/,+1d" "$mod/shard/main.go"
            fi
            rm -f "$work/pkg.a" "$s.$p.log"
          done
          [ -s "$s.built" ] && gobuild "$exe" ./shard >> "$s.build.log" 2>&1
        fi
        echo "$(basename "$s") $(( $(date +%s) - t0 ))" >> "$d/go-build.secs"
        run1() { # ID PKG
          local rd st t0 t1
          rd=$(mktemp -d "$work/run.XXXXXX"); t0=$(date +%s.%N)
          (cd "$rd" && ulimit -f 1024 && timeout "$(budget "$1")" "$exe" "$2" < "$work/empty-stdin" > out 2> err); st=$?
          t1=$(date +%s.%N)
          [ $st = 124 ] && st=timeout
          printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$1" "$st" "$(sha256sum < "$rd/out" | cut -d' ' -f1)" "$(wc -c < "$rd/out")" \
            "$(grep -m1 '^\(ciaot: \(fault\|internal\)\|fatal error: \|runtime: \)' "$rd/err" | cut -c1-200 | tr '\t' ' ')" \
            "$(sha256sum < "$rd/err" | cut -d' ' -f1)" "$(echo "$t1 $t0" | awk '{printf "%.1f", $1 - $2}')"
          rm -rf "$rd"
        }
        export -f run1 budget; export exe root
        [ -x "$exe" ] && while IFS=$'\t' read -r i p; do printf '%s\037%s\0' "$i" "$p"; done < "$s.built" \
          | xargs -0 -P "$jobs" -I{} bash -c 'IFS=$'"'"'\037'"'"' read -r i p <<< "$1"; run1 "$i" "$p"' _ {} >> "$d/run.tsv"
        rm -f "$exe"
      fi
      rm -rf "$mod"
      rm -f "$s" "$s.pkgs" "$s.ok"
      find "${CPPI_GOCACHE:-$root/.tmp/gocache}" -type f -mmin +15 -delete 2>> "$work/gocache-trim.log" || true
      echo "cppi aot: $id $(basename "$s"): $(wc -l < "$s.list") programs, $(wc -l < "$s.built") built, $(df -h "$root" | awk 'NR==2 {print $5}') disk"
    done
    if [ -s "$d/go-errors.tsv" ]; then
      awk -F'\t' 'BEGIN { while ((getline l < ARGV[2]) > 0) { split(l, f, "\t"); e[f[1]] = l }; ARGV[2] = "" }
                  ($1 in e) { print e[$1]; next } { print }' "$d/nodes.tsv" "$d/go-errors.tsv" > "$d/nodes.tsv.new" && mv "$d/nodes.tsv.new" "$d/nodes.tsv"
    fi
    # the seconds: IR, ci's build (lowering+build+translation), the shard's go build shared out, the run
    awk -F'\t' -v w="$work" 'BEGIN { while ((getline l < ARGV[2]) > 0) { split(l, f, "\t"); b[f[1]] = f[6] }
                                     while ((getline l < ARGV[3]) > 0) { split(l, f, "\t"); r[f[1]] = f[7] }; ARGV[2] = ""; ARGV[3] = "" }
      { s = "-"; if ((getline s < (w "/files/" $1 "/ir.secs")) <= 0) s = "-"; close(w "/files/" $1 "/ir.secs")
        lb = ($1 in b) ? b[$1] : "-+-+-"; n = split(lb, x, "+"); print $1 "\t" s "\t" x[1] + x[2] "\t" (n > 2 ? x[3] : "-") "\t" (($1 in r) ? r[$1] : "-") }' \
      "$d/list.tsv" "$d/nodes.tsv" "$d/run.tsv" > "$d/times.tsv"
    [ -n "${CPPI_KEEP:-}" ] || find "$work/files/$id" \( -name x.ll -o -name lowered.c \) -delete
  done
fi
arbace_tool -m arbace.cpp.check run-judge "$work" aot "${record:+--record}" "${ids[@]}"

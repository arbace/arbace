#!/bin/bash
# bin/lib/hsi/cdata-gen SRC-TREE: the C data tables the libraries read (HE5): bytestring's cbits/aligned-static-hs-data.c
# (hs_bytestring_lower_hex_table, hs_bytestring_digit_pairs_table, the Ryu tables) as a Go file for go/arbace/hs
# (cdata.go on stdout). Origin: bytestring-0.12.x of GHC 9.14.1's source tarball (libraries/bytestring/cbits), BSD-3-Clause
# (LICENSE.md, "bytestring"). Deterministic: the same tarball, the same bytes.
set -euo pipefail
# the output is gofmt-formatted (TamaGo's gofmt), as the runtime's Go is
if [ -z "${CDATA_GEN_PLAIN:-}" ]; then CDATA_GEN_PLAIN=1 "$0" "$@" | "${ARBACE_GOROOT:-/root/tamago-go}/bin/gofmt"; exit; fi
f=${1:?usage: cdata-gen SRC-TREE}/libraries/bytestring/cbits/aligned-static-hs-data.c
echo "package hs"
echo
echo "// Generated by bin/lib/hsi/cdata-gen from bytestring's cbits/aligned-static-hs-data.c (BSD-3-Clause); do not edit."
echo
echo "var cdataBytes = map[string]string{"
awk '
/^const char [a-z_0-9]+\[/ { name = $3; sub(/\[.*/, "", name); inb = 1; s = ""; next }
inb { if ($0 ~ /__attribute__/) next
      line = $0
      while (match(line, /"[^"]*"/)) { s = s substr(line, RSTART + 1, RLENGTH - 2); line = substr(line, RSTART + RLENGTH) }
      if ($0 ~ /;/) { printf "\t\"%s\": \"%s\",\n", name, s; inb = 0 } }
' "$f"
echo "}"
echo
echo "var cdataWords = map[string][]uint64{"
awk '
/^const uint64_t [a-z_0-9]+\[/ { name = $3; sub(/\[.*/, "", name); inw = 1; printf "\t\"%s\": {", name; n = 0; next }
inw { line = $0; sub(/\/\/.*/, "", line)
      while (match(line, /0x[0-9a-fA-F]+/)) { printf "%s%s", (n++ ? ", " : ""), substr(line, RSTART, RLENGTH); line = substr(line, RSTART + RLENGTH) }
      if ($0 ~ /\}/) { print "},"; inw = 0 } }
' "$f"
echo "}"

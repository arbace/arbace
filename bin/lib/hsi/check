    pcmd="exec $(printf '%q ' "$hsi" run "${la[@]}" ${stg:+--prog "$stg"} --name "$name" --) $ro"
    # (its run is hsi's: kept to compare the compiled run with, :vs-hsi, and its seconds, :hsi-run)
    local pt0 pt1; pt0=$(date +%s.%N); pst=0

       timeout -s KILL $((HSI_TIMEOUT * 3)) sh -c "ulimit -v $((${ARBACE_MEM_GIB:-16} * 1048576)); export GOMEMLIMIT=$((${ARBACE_MEM_GIB:-16} * 768))MiB; ulimit -t $HSI_TIMEOUT; $pcmd" \
       < "$pw/$stdin" > "$prog/aot-hsi.stdout" 2> "$prog/aot-hsi.stderr") || pst=$?

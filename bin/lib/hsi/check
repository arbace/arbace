  fi
  IFS=$'\t' read -r c cres cmsg crsn < <(awk -v id="\"$id\"" '
    /^ *\{:id :/ {cls=$2; res=""; msg=""; rsn=""}
    /^ *:results \[/ {res=$0; sub(/.*:results \[/, "", res); sub(/\].*/, "", res)}
    /^ *:reasons \[/ {rsn=$0; sub(/.*:reasons \[/, "", rsn); sub(/\].*/, "", rsn)}
    /^ *:message "/ {msg=$0; sub(/.*:message "/, "", msg); sub(/".*/, "", msg)}
    index($0, id) {printf "%s\t%s\t%s\t%s\n", cls, (res == "" ? "-" : res), (msg == "" ? "-" : msg), (rsn == "" ? "-" : rsn); exit}' $([ "$divs1" != "$divs" ] && [ -f "$divs1" ] && echo "$divs1") "$divs") || true
  # "-" for a field the class has not (a tab is IFS whitespace: empty fields would run together)
  [ "$cres" = - ] && cres=""; [ "$cmsg" = - ] && cmsg=""; [ "$crsn" = - ] && crsn=""
  if [ -z "$c" ]; then echo "hsi check: $id in no class"; unclassed=$((unclassed + 1)); continue; fi
  if [ -n "$cres" ] && [[ " $cres " != *" :$kind "* ]]; then
    echo "hsi check: $id in class $c, but its result :$kind is not the class's ($cres)"; unclassed=$((unclassed + 1)); continue
  fi
  # a class's :reasons (HES43 (b)): a member's result with a reason has one of them
  local_r=$(sed -n 's/.* :reason :\([a-z-]*\).*/\1/p' <<< "$line")
  if [ -n "$crsn" ] && [ -n "$local_r" ] && [[ " $crsn " != *" :$local_r "* ]]; then
    echo "hsi check: $id in class $c, but its reason :$local_r is not the class's ($crsn)"; unclassed=$((unclassed + 1)); continue
  fi
  if [ -n "$cmsg" ] && [ "$kind" = hsi ] && [[ $line != *"$cmsg"* ]]; then
    echo "hsi check: $id in class $c, but hsi's message is not the class's (\"$cmsg\")"; unclassed=$((unclassed + 1)); continue
  fi
  echo "hsi check: $id in class $c"
done < <(grep '^{' "$out" | grep -v ':result :pass' | grep -v ':result :oracle-pending')
echo "hsi check: $unclassed not passing in no class of test/haskell/divergences$sfx.edn${sfx:+ or test/haskell/divergences.edn}$([ "$libs_set" != own ] || echo " or test/haskell/divergences-own.edn")"
[ "$libs_set" != own ] || echo "hsi check: own-fallback.txt: $fbad problems"
unclassed=$((unclassed + fbad))
if [ -n "$record" ]; then
  rec=$root/test/haskell/check-hsi$sfx.edn; [ -z "$aot" ] || rec=$root/test/haskell/check-hsi-aot$sfx.edn
  # a front that is not the default records apart (HFS-I1 (a): check-hsi-native.edn beside check-hsi.edn until the switch)
  if [ "$libs_set" = own ]; then rec=${rec%.edn}-own.edn
  elif [ "$front" != "$default_front" ]; then rec=${rec%.edn}-$front.edn; fi
  # the other programs' lines kept (another corpus's, or those --only left out)
  { grep '^;;' "$out" | grep -v '^;; corpora:'
    echo ";; corpora: $(cat "$out" $([ -f "$rec" ] && echo "$rec") | grep -h "^;; corpora:" | sed 's/^;; corpora: //' | tr ',' '\n' | sort -u | grep . | paste -sd, -)"
    { grep '^{' "$out"
      # (an if: under pipefail a missing record's false test failed the first --record)
      if [ -f "$rec" ]; then grep '^{' "$rec" | while IFS= read -r l; do
        i=$(sed 's/^{:id "\([^"]*\)".*/\1/' <<< "$l"); grep -qF "{:id \"$i\" " "$out" || echo "$l"; done; fi
    } | sort; } > "$rec.part"
  mv "$rec.part" "$rec"; echo "hsi check: recorded ${rec#"$root"/}"
fi
# the negative controls (test/haskell/hsi-controls.txt): a subject's run judged against another program's reference
cbad=0 cran=0
while read -r subj refid over; do
  case $subj in ''|\#*) continue ;; esac
  o=$work/out/${subj//\//_}
  [ -f "$o.stdout" ] || { echo "hsi check: control $subj not run"; continue; }
  cran=$((cran + 1))
  rl=$(grep -F "{:id \"$refid\" " "$ref" || true)
  rst=$(sed -n 's/.* :status \([^ ]*\) .*/\1/p' <<< "$rl"); rso=$(sed -n 's/.* :stdout "\([0-9a-f]*\)".*/\1/p' <<< "$rl")
  rse=$(sed -n 's/.* :stderr "\([0-9a-f]*\)".*/\1/p' <<< "$rl")
  # a reference with its own verdict is judged by it, as its program is (the own judge's control)
  ownr=$(own_ref "$refid"); [ -z "$ownr" ] || { read -r rst rso rse _ <<< "$ownr"; refid="$refid (its own verdict)"; }
  # (queue 325g: a reference the arm64 reference records is judged by it on an arm64 host, as its program is)
  al=""; [ -z "$arch_ref" ] || al=$(arch_ref_line "${refid%% (*}")
  if [ -n "$al" ]; then
    rst=$(sed -n 's/.* :status \([^ ]*\) .*/\1/p' <<< "$al"); rso=$(sed -n 's/.* :stdout "\([0-9a-f]*\)".*/\1/p' <<< "$al")
    rse=$(sed -n 's/.* :stderr "\([0-9a-f]*\)".*/\1/p' <<< "$al"); refid="${refid%% (*} (arm64's run)"
  fi
  # status=N: the reference with another status (a control of the status's comparison alone)
  case $over in status=*) rst=${over#status=}; refid="$refid ($over)" ;; esac
  so=$(sha256sum < "$o.stdout" | cut -c1-64); se=$(sha256sum < "$o.stderr" | cut -c1-64)
  # HES90: a subject all.T gives ignore_stdout is judged without its stdout, as the check does
  ! ignore_stdout "$subj" || rso=$so
  if [ "$(cat "$o.status")" = "$rst" ] && [ "$so" = "$rso" ] && [ "$se" = "$rse" ]; then
    echo "hsi check: control $subj against $refid passes: the judge does not discriminate"; cbad=1
  else
    echo "hsi check: control $subj against $refid fails, as it must"
  fi
done < "$root/test/haskell/hsi-controls.txt"
# a check in which no control ran proves nothing about its judge (review 189, L3)
[ $cran -gt 0 ] || { echo "hsi check: no negative control ran"; cbad=1; }
[ $unclassed = 0 ] && [ $cbad = 0 ]

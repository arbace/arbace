# every program that does not pass in a class of test/haskell/divergences.edn (by its :ids), with the result the class
# records (its :results, and for :hsi its :message's text in hsi's message; review 189, F6): a classed program whose
# result changed kind is in no class
unclassed=0
# review 1111b (findings 3, 4): --libs own's judge. outcome LINE: what a result says failed (kind, status, differs, reason)
outcome() {
  local k st d
  k=$(sed -n 's/^{:id "[^"]*" :result \(:[a-z-]*\).*/\1/p' <<< "$1"); st=$(sed -n 's/^{:id "[^"]*" :result :[a-z-]* :status \([0-9]*\).*/\1/p' <<< "$1")
  d=$(sed -n 's/.* :differs \(\[[^]]*\]\).*/\1/p' <<< "$1"); echo "${k:+:result $k}${st:+ :status $st}${d:+ :differs $d}"
}
packrec=$root/test/haskell/check-hsi$sfx.edn; [ -z "$aot" ] || packrec=$root/test/haskell/check-hsi-aot$sfx.edn
divs_own=$root/test/haskell/divergences-own.edn
fbad=0
if [ "$libs_set" = own ] && [ -f "$own_fallback_list" ]; then

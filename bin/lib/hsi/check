  # flags' -D), kept by the files', the reader's and its headers' digests, loaded by hsi run --cmm
  if [ ${#cmmfiles[@]} -gt 0 ]; then
    local ck; ck=$( { (cd "$src" && sha256sum "${cmmfiles[@]}"); printf '%s\n' ${cflags[@]+"${cflags[@]}"}
                      sha256sum "$root/arbace/repr/haskell/cmm.ae" "$root"/test/haskell/eval/cmm/*.h; } | sha256sum | cut -c1-64)
    if [ ! -f "$prog/cmm.key" ] || [ "$(cat "$prog/cmm.key")" != "$ck" ]; then
      rm -f "$prog/cmm.key"

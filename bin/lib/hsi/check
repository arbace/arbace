  fi
  if [ ! -f "$prog/ok" ]; then
    rm -rf "$root/.tmp/hsi/progs$sfx/$id"; mkdir -p "$prog"
    t0=$(date +%s.%N)
    # HES92 (a): all.T's pre_cmd `{compiler} --run ./GEN.hs` run first when it writes the main (ManyUbxSums), the file removed
    # after the dump (the extracted testsuite stays as its pin has it)
    local gen made=""; gen=$(hsi_pre_gen "$id")
    if [ -n "$gen" ] && [ ! -f "$src/$main" ]; then
      (cd "$src" && timeout 300 ghc -no-user-package-db --run "./$gen") > "$prog/pre.log" 2>&1 || true; made=1
    fi
    if ! (cd "$src" && timeout 300 "$helper" stg -o "$prog/stg" --libdir "$libdir" --helper-hash "sha256:$helper_hash" --ghc -$opt \
            ${fl[@]+"${fl[@]}"} -outputdir "$prog/obj" --files "$main" ${hsf[@]+"${hsf[@]}"}) > "$prog/dump.log" 2>&1; then
      local e; e=$( (grep -m1 -E 'error' "$prog/dump.log" || tail -n 1 "$prog/dump.log") | cut -c1-160 | sed 's/\\/\\\\/g; s/"/\\"/g')
      echo "{:id \"$id\" :result :no-dump :error \"$e\"}" > "$res"; printf '%s' "$e" > "$prog/dump-failed.txt"; rm -rf "$prog/obj"
      [ -z "$made" ] || rm -f "$src/$main"; return 0
    fi
    [ -z "$made" ] || rm -f "$src/$main"
    t1=$(date +%s.%N); td=$(printf '%.2f' "$(echo "$t1 - $t0" | bc)")
    rm -rf "$prog/obj"; touch "$prog/ok"
  fi
  local la=() l
  # the modules' foreign stubs (HES60 (a)): a program whose Haskell exports a function or imports a wrapper gets the C
  # GHC writes for them (bin/hsi stubs-build's stubprobe --stubs, live: made with the dump and recorded with it in
  # haskell-stg-progs, ID/stubs/), compiled by ci with its own C
  if [ ! -f "$prog/stubs.ok" ]; then
    rm -rf "$prog/stubs"
    if (cd "$src" && grep -qE 'foreign +export|"wrapper"|foreign +import +capi' "$main" $( [ "$kind" != plain ] && [ "$kind" != compile_and_run ] && find . -name '*.hs' -o -name '*.lhs' ) 2> "$prog/stubs.grep"); then
      # queue 364 (report 346's item 5): a program the native front end compiled takes the stubs it wrote beside its STG
      # (front/out/stubs/NAME/FILE_stub.{h,c}, typecheck.ae's foreign stubs: GHC's text byte for byte), not GHC's
      if [ "${srcs#:stg :native}" != "$srcs" ]; then
        if [ -n "$(ls "$work/front/out/stubs/$ob" 2>"$TMPDIR/hsi-stubs.err")" ]; then cp -r "$work/front/out/stubs/$ob" "$prog/stubs"
        else mkdir -p "$prog/stubs"; touch "$prog/stubs/NONE"; fi
      elif [ -n "$live" ]; then
        # the probe built first: a failed build is the recording's failure, never a program without stubs (NONE)
        local sp; sp=$("$root/bin/hsi" stubs-build) && [ -x "$sp" ] || { echo "hsi check: stubs-build failed for $id" >&2; exit 1; }
        (cd "$src" && timeout 300 "$sp" --stubs "$libdir" "$prog/stubs" -$opt ${fl[@]+"${fl[@]}"} -outputdir "$prog/stubobj" -- "$main") > "$prog/stubs.log" 2>&1 || true
        rm -rf "$prog/stubobj"
        # GHC wrote none (a capi import of a function, no wrapper): recorded as such, so the records' run knows it
        [ -n "$(ls "$prog/stubs" 2>"$TMPDIR/hsi-stubs.err")" ] || { mkdir -p "$prog/stubs"; touch "$prog/stubs/NONE"; }
      elif [ -d "$progs_pack/$id/stubs" ]; then cp -r "$progs_pack/$id/stubs" "$prog/stubs"
      else
        echo "{:id \"$id\" :result :unrecorded :error \"UNRECORDED: its foreign stubs are not in haskell-stg-progs (bin/hsi check --live --dump-only --record-progs)\"}" > "$res"; return 0
      fi
    fi
    touch "$prog/stubs.ok"
  fi
  [ -z "$dump_only" ] || { echo "{:id \"$id\" :result :dumped :dump $td}" > "$res"; return 0; }
  fi
  local sf; for sf in "$prog"/stubs/*_stub.c; do [ -f "$sf" ] && cfiles+=("$sf"); done
  # a wrapper's stub whose parameters hold the x86-64 adjustor's original_return_addr: its name and that parameter's
  # index (the stable pointer's 0), for hsi's createAdjustor (NODES.adjust, read beside the node program)
  if [ -d "$prog/stubs" ] && [ ! -f "$prog/c.ok" ]; then
    cat "$prog"/stubs/*_stub.c 2> "$prog/adjust.err" | awk '/the_stableptr.*original_return_addr/ {
      h = $0; sub(/\(.*/, "", h); n = split(h, w, /[ \t*]+/); name = w[n]
      p = $0; sub(/^[^(]*\(/, "", p); sub(/\).*/, "", p); k = split(p, ps, ",")
      for (i = 1; i <= k; i++) if (ps[i] ~ /original_return_addr/) print name, i - 1 }' > "$prog/c.nodes.adjust" || true

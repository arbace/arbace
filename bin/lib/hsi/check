        local e; e=$(grep -m1 '^cmm: ' "$prog/cmm.log" | cut -c1-160 | sed 's/\\/\\\\/g; s/"/\\"/g')
        echo "{:id \"$id\" :result :hsi :status 3 :message \"hsi: ${e:-cmm: the reader failed}\" :reason :cmm-read :dump $td :run 0}" > "$res"; return 0

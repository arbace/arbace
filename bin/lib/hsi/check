#!/bin/bash
# bin/hsi check [--corpus C,...] [--only ID,...|@FILE] [--jobs N] [--record] [--keep]: Haskell's eval level (HE4a,
# HE4c; doc/haskell/HASKELL-EVAL-SURVEY.md, "As built: HE4a (write-ahead)", "As built: HE4b, HE4c (write-ahead)"):
# each program of the run corpora (samples, synthetic, testsuite-core: the run tests of eval-corpora.edn's
# :testsuite-core directories, record-ref's plan, test/haskell/eval/run_plan.ae; default samples,synthetic; nofib, HE5: the Makefiles' flags, arguments and stdin as record-ref plans them) compiled
# to STG at -O0 by the helper (tools/hsdump stg; a testsuite test with its all.T flags and its directory's modules,
# GHC following the imports; its dump cached by the sources', the flags' and the helper's digests in
# .tmp/hsi/progs/), run on hsi (bin/hsi build's light driver) over the libraries' dumps (HSI_LIBS, default
# .tmp/hsi/dumps/stg, .tmp/hsi/dumps-extra/stg and .tmp/hsi/dumps-more/stg, bin/hsi dumps' outputs; their images, HE4d,
# made first by hsi image into HSI_IMAGE, default .tmp/hsi/image, none for the forms read every run) as record-ref ran
# GHC's build: in a fresh copy of its directory, env -i, LANG=C.UTF-8, TZ=UTC, its stdin, its arguments (a sample's
# NAME.args; a test's extra_run_opts through sh, its +RTS options left to the driver, which drops them as GHC's RTS
# does) and its program name; HSI_TIMEOUT seconds of CPU, default 60, three times that of wall time. Judged against
# test/haskell/ref-ghc914.edn (HES16 (a)): :pass when the status, stdout's SHA-256 and stderr's SHA-256 are the
# reference's; else :fail with what differs (:status, :stdout, :stderr), :hsi when hsi itself stopped (an
# unimplemented primop or C function, its message), :no-dump (the helper failed: its first error), :no-ref.
# Every result carries :dump (the helper's seconds, 0 when cached) and :run (hsi's wall seconds): GT8's per-program
# times. The results into .tmp/hsi/check/results.edn; --record: into test/haskell/check-hsi.edn (a run of some
# corpora or --only keeps the other programs' lines). --only takes ids, or @FILE a file of ids (one a line, # a
# comment): GT8's lists. --keep keeps each run's outputs in .tmp/hsi/check/out/. Every program that does not pass
# must be in a class of test/haskell/divergences.edn (its :ids), and every negative control of
# test/haskell/hsi-controls.txt (a subject's run judged against another program's reference) whose subject ran
# must fail; else the check fails.
set -euo pipefail
root=$(cd "$(dirname "$0")/../../.." && pwd)
. "$root/bin/lib/tmpdir.bash"
corpora=samples,synthetic only="" jobs=${HSI_JOBS:-3} record="" keep=""
while [ $# -gt 0 ]; do
  case $1 in
    --corpus) corpora=$2; shift 2 ;;
    --only) if [[ $2 == @* ]]; then only=,$(grep -v '^#' "${2#@}" | grep . | tr '\n' ',' ); else only=,$2,; fi; shift 2 ;;
    --jobs) jobs=$2; shift 2 ;;
    --record) record=1; shift ;;
    --keep) keep=1; shift ;;
    *) echo "usage: bin/hsi check [--corpus C,...] [--only ID,...|@FILE] [--jobs N] [--record] [--keep]" >&2; exit 2 ;;
  esac
done
pin=$(cat "$root/tools/hsdump/GHC_VERSION")
[ "$(ghc --numeric-version)" = "$pin" ] || { echo "hsi check: the host's GHC is not $pin" >&2; exit 1; }
ref=$root/test/haskell/ref-ghc914.edn
work=$root/.tmp/hsi/check
rm -rf "$work"; mkdir -p "$work/res" "$work/out" "$work/run"
hsi=$("$root/bin/hsi" build)
libs=${HSI_LIBS:-$root/.tmp/hsi/dumps/stg:$root/.tmp/hsi/dumps-extra/stg:$root/.tmp/hsi/dumps-more/stg}
"$root/bin/repr-haskell" helper >&2
helper=$root/.tmp/hsdump/hsdump
helper_hash=$(cat "$root"/tools/hsdump/*.hs "$root/tools/hsdump/GHC_VERSION" | sha256sum | cut -c1-64)
libdir=$(ghc --print-libdir)
# the libraries' images (HES32 (a), HE4d): made once for the dumps as they are, every run loads them
images=${HSI_IMAGE:-$root/.tmp/hsi/image}
if [ "$images" != none ]; then
  ia=(); IFS=: read -r -a dirs <<< "$libs"
  for l in "${dirs[@]}"; do [ -d "$l" ] && ia+=(--lib "$l"); done
  "$hsi" image --out "$images" "${ia[@]}" >&2 || { echo "hsi check: hsi image failed" >&2; exit 1; }
fi
# the RTS's headers (HsFFI.h, Rts.h) for a program's own C, as ghc gives its C compiler
rtsinc=$(ls -d "$libdir"/../lib/*-ghc-"$pin"-*/rts-*/include 2>&1 | head -1)
export root work hsi libs helper helper_hash libdir ref keep images rtsinc
export HSI_TIMEOUT=${HSI_TIMEOUT:-60}
# programs that need more than ARBACE_MEM_GIB name their own cap (ID=GIB ...); none today: the deepest stacks, Loop
# (7.3 GB of RSS) and T16846 (9.7 GB), pass under the default 16 GiB (measured alone, 2026-11-03)
export HSI_MEM_CAPS=${HSI_MEM_CAPS:-}

# the plan: ID SRC MAIN FLAGS RUN-OPTS NAME STDIN KIND, separated by U+001F ("-" for none)
plan=$work/plan.txt
: > "$plan"
add() { printf '%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\n' "$@" >> "$plan"; }
for c in ${corpora//,/ }; do
  case $c in
    samples|synthetic)
      d=$root/test/haskell/eval/$c
      for f in "$d"/*.hs; do
        n=$(basename "$f" .hs) a=-
        [ -f "$d/$n.args" ] && a=$(cat "$d/$n.args")
        add "$c/$n" "$d" "$n.hs" - "$a" "$n" "$([ -f "$d/$n.stdin" ] && echo "$n.stdin" || echo -)" plain
      done ;;
    testsuite-core)
      tests=$root/.tmp/hsi/ghc-9.14.1/testsuite/tests
      "$root/bin/hsi" pins --fetch > "$work/fetch.log" 2>&1 || { cat "$work/fetch.log" >&2; exit 1; }
      ae() { ARBACE_PATH=$root "$("$root/bin/hsi" exe)" "$@"; }
      dirs=$(ae -e "(println (apply str (interpose \",\" (get-in (some #(when (= :testsuite-core (:id %)) %) (:corpora (read-string (slurp \"$root/test/haskell/eval-corpora.edn\")))) [:where :dirs]))))")
      ae "$root/test/haskell/eval/run_plan.ae" "$root/test/haskell/eval/testsuite-run.edn" "$tests" "$dirs" 2> "$work/plan.notes" |
      while IFS=$'\t' read -r id dir kind main flags ropts exit name; do
        sin=-; [ -f "$tests/$dir/$name.stdin" ] && sin=$name.stdin
        add "$id" "$tests/$dir" "$main" "$flags" "$ropts" "$name" "$sin" "$kind"
      done ;;
    nofib)
      # nofib's programs as record-ref plans them (the Makefile's FAST_OPTS, PROG_ARGS, SRC_HC_OPTS, SRC_DEPS; HE5)
      for s in imaginary spectral real shootout gc parallel smp; do
        for p in "$root/.tmp/hsi/nofib/$s"/*/; do
          [ -f "$p/Makefile" ] || continue
          n=$(basename "$p"); mk=$p/Makefile
          main=-; for m in Main.hs Main.lhs "$n.hs" "$n.lhs"; do [ -f "$p/$m" ] && { main=$m; break; }; done
          fo=$(sed -n 's/^FAST_OPTS *= *//p' "$mk" | head -1)
          pa=$(sed -n 's/^PROG_ARGS *+\{0,1\}= *//p' "$mk" | tr '\n' ' ')
          hc=$(sed -n 's/^SRC_HC_OPTS *+\{0,1\}= *//p' "$mk" | tr '\n' ' ')
          deps=$(sed -n 's/^SRC_DEPS *= *//p' "$mk" | head -1)
          for dpk in $deps; do hc="$hc -package $dpk"; done
          sin=-; for f in "$n.faststdin" "$n.stdin"; do [ -f "$p/$f" ] && { sin=$f; break; }; done
          args=$(echo "$pa ${fo:-}" | xargs)
          hcf=$(echo "$hc" | xargs)
          add "nofib/$s/$n" "${p%/}" "$main" "${hcf:--}" "${args:--}" "$n" "$sin" nofib
        done
      done ;;
    *) echo "hsi check: no corpus $c" >&2; exit 2 ;;
  esac
done
if [ -n "$only" ]; then
  awk -F'\037' -v o="$only" 'index(o, "," $1 ",")' "$plan" > "$plan.only"; mv "$plan.only" "$plan"
fi
echo "== hsi check: $(wc -l < "$plan") programs, $jobs at a time" >&2

one() {
  local id src main flags ropts name sin kind
  IFS=$'\037' read -r id src main flags ropts name sin kind <<< "$1"
  local res=$work/res/${id//\//_}
  if [ "$main" = - ]; then echo "{:id \"$id\" :result :no-dump :error \"no main file\"}" > "$res"; return 0; fi
  # the dump's flags: all.T's, less a test's own C, Cmm, assembly and objects (the helper compiles Haskell only); its
  # C files built by ci into a node program hsi loads (HES64 (a), bin/hsi cnodes), with the flags the C reads (-I, -D)
  local fl=() f cfiles=() cflags=() optc=""; if [ "$flags" != - ]; then for f in $flags; do
    # -optcX: X for the C compiler, a lone -D, -I or -U joined to the next one's (-optc-D -optcFOO is -DFOO)
    if [[ $f == -optc* ]]; then
      f=${f#-optc}
      if [ -n "$optc" ]; then cflags+=("$optc$f"); optc=""; continue; fi
      case $f in -D|-I|-U) optc=$f ;; -D*|-I*|-U*) cflags+=("$f") ;; esac
      continue
    fi
    case $f in *.c) cfiles+=("$f") ;; *.o) [ -f "$src/${f%.o}.c" ] && cfiles+=("${f%.o}.c") ;; *.cmm|*.s|*.S|*.h|*.cpp|*.cc) ;; -I*|-D*|-U*) fl+=("$f"); cflags+=("$f") ;; *) fl+=("$f") ;; esac; done; fi
  # the dump's key: the main file, the flags, the helper; a test of several modules: its directory's sources too
  local key prog
  key=$( { echo "$flags $kind"; cat "$src/$main"
           for f in ${cfiles[@]+"${cfiles[@]}"}; do cat "$src/$f" 2>&1; done
           if [ "$kind" != plain ] && [ "$kind" != compile_and_run ]; then
             (cd "$src" && find . -type f \( -name '*.hs' -o -name '*.lhs' -o -name '*.hs-boot' -o -name '*.c' -o -name '*.h' \) | LC_ALL=C sort | xargs sha256sum)
           fi; } | sha256sum | cut -c1-16)-${helper_hash:0:16}
  prog=$root/.tmp/hsi/progs/$id/$key
  local td=0 t0 t1
  if [ ! -f "$prog/ok" ]; then
    rm -rf "$root/.tmp/hsi/progs/$id"; mkdir -p "$prog"
    t0=$(date +%s.%N)
    if ! (cd "$src" && timeout 300 "$helper" stg -o "$prog/stg" --libdir "$libdir" --helper-hash "sha256:$helper_hash" --ghc -O0 \
            ${fl[@]+"${fl[@]}"} -outputdir "$prog/obj" --files "$main") > "$prog/dump.log" 2>&1; then
      local e; e=$( (grep -m1 -E 'error' "$prog/dump.log" || tail -n 1 "$prog/dump.log") | cut -c1-160 | sed 's/\\/\\\\/g; s/"/\\"/g')
      echo "{:id \"$id\" :result :no-dump :error \"$e\"}" > "$res"; rm -rf "$prog/obj"; return 0
    fi
    t1=$(date +%s.%N); td=$(printf '%.2f' "$(echo "$t1 - $t0" | bc)")
    rm -rf "$prog/obj"; touch "$prog/ok"
  fi
  local la=() l
  if [ ${#cfiles[@]} -gt 0 ]; then
    if [ ! -f "$prog/c.ok" ]; then
      if ! (cd "$src" && "$root/bin/hsi" cnodes "$prog/c.nodes" ${cflags[@]+"${cflags[@]}"} -I"$rtsinc" "${cfiles[@]}") > "$prog/c.log" 2>&1; then
        local e; e=$(grep -v '^==\|^Reflection\|^$' "$prog/c.log" | tail -n 1 | cut -c1-160 | sed 's/\\/\\\\/g; s/"/\\"/g')
        echo "{:id \"$id\" :result :hsi :status 3 :message \"hsi: ci: $e\" :dump $td :run 0}" > "$res"; return 0
      fi
      touch "$prog/c.ok"
    fi
    la+=(--c "$prog/c.nodes")
  fi
  IFS=: read -r -a dirs <<< "$libs"
  for l in "${dirs[@]}"; do [ -d "$l" ] && la+=(--lib "$l"); done
  [ "$images" != none ] && la+=(--image "$images")
  # the run in a fresh copy of the program's directory (a test reads its files and may write some)
  local w=$work/run/${id//\//_}
  rm -rf "$w"; mkdir -p "$w"; cp -r "$src"/. "$w"/ 2> "$w.cp.log" || true; rm -f "$w.cp.log"
  : > "$w/.empty"
  local stdin=.empty; [ "$sin" != - ] && stdin=$sin
  local ro=""; [ "$ropts" != - ] && ro=${ropts//\/dev\/null/.empty}
  [[ $ro == *"<"* ]] && stdin=.empty
  local cmd; cmd="exec $(printf '%q ' "$hsi" run "${la[@]}" --prog "$prog/stg" --name "$name" --) $ro"
  local o=$work/out/${id//\//_} st=0
  # the memory cap (bin/lib/limit.bash's ARBACE_MEM_GIB, default 16 GiB: ulimit -v at it, GOMEMLIMIT at three
  # quarters), so a leaking program fails alone; the deep-stack programs name their own (HSI_MEM_CAPS, ID=GIB)
  local mem=${ARBACE_MEM_GIB:-16} c
  for c in $HSI_MEM_CAPS; do [ "${c%%=*}" = "$id" ] && mem=${c#*=}; done
  local memlim=""; [ "$mem" = 0 ] || memlim="ulimit -v $((mem * 1048576)); export GOMEMLIMIT=$((mem * 768))MiB; "
  # a test all.T skips unconditionally (the class :skipped) is not run: its 180 s at the wall cap spared (review 189, L8)
  if awk '/^ *\{:id :skipped/ {s=1; next} /^ *\{:id :/ {s=0} s' "$root/test/haskell/divergences.edn" | grep -qF "\"$id\""; then
    rm -rf "$w"; echo "{:id \"$id\" :result :skipped :dump $td :run 0}" > "$res"; return 0
  fi
  t0=$(date +%s.%N)
  (cd "$w" && env -i PATH=/usr/bin:/bin LANG=C.UTF-8 TZ=UTC HOME="$w" \
     timeout -s KILL $((HSI_TIMEOUT * 3)) sh -c "${memlim}ulimit -t $HSI_TIMEOUT; $cmd" \
     < "$w/$stdin" > "$o.stdout" 2> "$o.stderr") || st=$?
  t1=$(date +%s.%N)
  rm -rf "$w"
  local so se rl rst rso rse
  so=$(sha256sum < "$o.stdout" | cut -c1-64); se=$(sha256sum < "$o.stderr" | cut -c1-64)
  rl=$(grep -F "{:id \"$id\" " "$ref" || true)
  local secs; secs=$(printf '%.2f' "$(echo "$t1 - $t0" | bc)")
  local tm=":dump $td :run $secs"
  echo "$st" > "$o.status"
  if [ -z "$rl" ]; then echo "{:id \"$id\" :result :no-ref $tm}" > "$res"; return 0; fi
  rst=$(sed -n 's/.* :status \([^ ]*\) .*/\1/p' <<< "$rl")
  rso=$(sed -n 's/.* :stdout "\([0-9a-f]*\)".*/\1/p' <<< "$rl")
  rse=$(sed -n 's/.* :stderr "\([0-9a-f]*\)".*/\1/p' <<< "$rl")
  if grep -q '^hsi: ' "$o.stderr"; then
    local msg; msg=$(grep -m1 '^hsi: ' "$o.stderr" | cut -c1-200 | sed 's/\\/\\\\/g; s/"/\\"/g')
    echo "{:id \"$id\" :result :hsi :status $st :message \"$msg\" $tm}" > "$res"
  elif [ "$st" = "$rst" ] && [ "$so" = "$rso" ] && [ "$se" = "$rse" ]; then
    echo "{:id \"$id\" :result :pass $tm}" > "$res"
  else
    local why=""
    [ "$st" = "$rst" ] || why="$why :status"
    [ "$so" = "$rso" ] || why="$why :stdout"
    [ "$se" = "$rse" ] || why="$why :stderr"
    echo "{:id \"$id\" :result :fail :status $st :differs [${why# }] $tm}" > "$res"
  fi
  [ -n "$keep" ] || grep -q "^$id " "$root/test/haskell/hsi-controls.txt" || rm -f "$o.stdout" "$o.stderr"
}
export -f one
tr '\n' '\0' < "$plan" | xargs -0 -P "$jobs" -I{} bash -c 'one "$1"' _ {}

out=$work/results.edn
{
  echo ";; hsi's check (bin/hsi check, HE4a): each program of the run corpora on hsi against GHC 9.14.1's -O0 run"
  echo ";; (test/haskell/ref-ghc914.edn): :pass (status, stdout and stderr byte for byte), :fail (:differs), :hsi (hsi stopped:"
  echo ";; its message), :no-dump (the helper's first error), :no-ref; :dump the helper's seconds (0: cached), :run hsi's wall"
  echo ";; seconds (GT8)."
  echo ";; corpora: $corpora"
  cat "$work"/res/* | sort
} > "$out"
total=$(grep -c '^{' "$out" || true)
for r in pass fail hsi skipped no-dump no-ref; do
  echo "hsi check: $r $(grep -c ":result :$r" "$out" || true)"
done
echo "hsi check: $total programs ($out)"
# every program that does not pass in a class of test/haskell/divergences.edn (by its :ids), with the result the class
# records (its :results, and for :hsi its :message's text in hsi's message; review 189, F6): a classed program whose
# result changed kind is in no class
unclassed=0
while IFS= read -r line; do
  id=$(sed 's/^{:id "\([^"]*\)".*/\1/' <<< "$line"); kind=$(sed -n 's/.* :result :\([a-z-]*\).*/\1/p' <<< "$line")
  IFS=$'\t' read -r c cres cmsg < <(awk -v id="\"$id\"" '
    /^ *\{:id :/ {cls=$2; res=""; msg=""}
    /^ *:results \[/ {res=$0; sub(/.*:results \[/, "", res); sub(/\].*/, "", res)}
    /^ *:message "/ {msg=$0; sub(/.*:message "/, "", msg); sub(/".*/, "", msg)}
    index($0, id) {printf "%s\t%s\t%s\n", cls, res, msg; exit}' "$root/test/haskell/divergences.edn") || true
  if [ -z "$c" ]; then echo "hsi check: $id in no class"; unclassed=$((unclassed + 1)); continue; fi
  if [ -n "$cres" ] && [[ " $cres " != *" :$kind "* ]]; then
    echo "hsi check: $id in class $c, but its result :$kind is not the class's ($cres)"; unclassed=$((unclassed + 1)); continue
  fi
  if [ -n "$cmsg" ] && [ "$kind" = hsi ] && [[ $line != *"$cmsg"* ]]; then
    echo "hsi check: $id in class $c, but hsi's message is not the class's (\"$cmsg\")"; unclassed=$((unclassed + 1)); continue
  fi
  echo "hsi check: $id in class $c"
done < <(grep '^{' "$out" | grep -v ':result :pass')
echo "hsi check: $unclassed not passing in no class of test/haskell/divergences.edn"
if [ -n "$record" ]; then
  rec=$root/test/haskell/check-hsi.edn
  # the other programs' lines kept (another corpus's, or those --only left out)
  { grep '^;;' "$out" | grep -v '^;; corpora:'
    echo ";; corpora: $(cat "$out" $([ -f "$rec" ] && echo "$rec") | grep -h "^;; corpora:" | sed 's/^;; corpora: //' | tr ',' '\n' | sort -u | grep . | paste -sd, -)"
    { grep '^{' "$out"
      [ -f "$rec" ] && grep '^{' "$rec" | while IFS= read -r l; do
        i=$(sed 's/^{:id "\([^"]*\)".*/\1/' <<< "$l"); grep -qF "{:id \"$i\" " "$out" || echo "$l"; done
    } | sort; } > "$rec.part"
  mv "$rec.part" "$rec"; echo "hsi check: recorded test/haskell/check-hsi.edn"
fi
# the negative controls (test/haskell/hsi-controls.txt): a subject's run judged against another program's reference
cbad=0 cran=0
while read -r subj refid over; do
  case $subj in ''|\#*) continue ;; esac
  o=$work/out/${subj//\//_}
  [ -f "$o.stdout" ] || { echo "hsi check: control $subj not run"; continue; }
  cran=$((cran + 1))
  rl=$(grep -F "{:id \"$refid\" " "$ref" || true)
  rst=$(sed -n 's/.* :status \([^ ]*\) .*/\1/p' <<< "$rl"); rso=$(sed -n 's/.* :stdout "\([0-9a-f]*\)".*/\1/p' <<< "$rl")
  # status=N: the reference with another status (a control of the status's comparison alone)
  case $over in status=*) rst=${over#status=}; refid="$refid ($over)" ;; esac
  rse=$(sed -n 's/.* :stderr "\([0-9a-f]*\)".*/\1/p' <<< "$rl")
  so=$(sha256sum < "$o.stdout" | cut -c1-64); se=$(sha256sum < "$o.stderr" | cut -c1-64)
  if [ "$(cat "$o.status")" = "$rst" ] && [ "$so" = "$rso" ] && [ "$se" = "$rse" ]; then
    echo "hsi check: control $subj against $refid passes: the judge does not discriminate"; cbad=1
  else
    echo "hsi check: control $subj against $refid fails, as it must"
  fi
done < "$root/test/haskell/hsi-controls.txt"
# a check in which no control ran proves nothing about its judge (review 189, L3)
[ $cran -gt 0 ] || { echo "hsi check: no negative control ran"; cbad=1; }
[ $unclassed = 0 ] && [ $cbad = 0 ]

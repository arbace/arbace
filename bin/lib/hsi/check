    local t2 t3; t2=$(date +%s.%N)
    exe=$(HSI_LIBS=$plibs HSI_IMAGE=$pimages "$root/bin/lib/hsi/aot" build --prog "$stg" --closures "$prog/aot-closures.txt" --out "$prog/aot" 2> "$prog/aot-build.err") || {
      local e; e=$(head -c 160 "$prog/aot-build.err" | tr '\n' ' ' | sed 's/\\/\\\\/g; s/"/\\"/g')
      [ -n "${HSI_KEEP_BINS:-}" ] || rm -rf "$prog/aot/hsi-aot.new" "$prog/aot/gen" "$prog/aot/mod"
      rm -rf "$w"; echo "{:id \"$id\" :result :hsi :status 3 :message \"hsi aot: $e\" :dump $td :run 0}" > "$res"; return 0; }

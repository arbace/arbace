      grep -oh '(ffi (static "[^"]*"' "$stg"/*.ae 2> "$prog/refs.err" | sed 's/.*"\([^"]*\)"$/\1/' | sort -u > "$prog/c.refs" || true
      if ! (cd "$src" && "$root/bin/hsi" cnodes "$prog/c.nodes" --refs "$prog/c.refs" ${cflags[@]+"${cflags[@]}"} -I"$rtsinc" "${cfiles[@]}") > "$prog/c.log" 2>&1; then
        local e; e=$(grep -v '^==\|^Reflection\|^$' "$prog/c.log" | tail -n 1 | cut -c1-160 | sed 's/\\/\\\\/g; s/"/\\"/g')
        echo "{:id \"$id\" :result :hsi :status 3 :message \"hsi: ci: $e\" :reason :c-build :dump $td :run 0}" > "$res"; return 0
      fi

export -f ignore_stdout

one() {
  local id src main flags ropts name sin kind
  IFS=$'\037' read -r id src main flags ropts name sin kind <<< "$1"
  local res=$work/res/${id//\//_}
  if [ "$main" = - ]; then echo "{:id \"$id\" :result :no-dump :error \"no main file\"}" > "$res"; return 0; fi
  # a test all.T skips (the class :skipped) is not run, nor dumped: its 180 s at the wall cap spared (review 189, L8); since HES92 (a)
  # before the dump, T24809 (req_profiling) has none on this GHC
  if awk '/^ *\{:id :skipped/ {s=1; next} /^ *\{:id :/ {s=0} s' "$divs" | grep -qF "\"$id\""; then
    echo "{:id \"$id\" :result :skipped :dump 0 :run 0}" > "$res"; return 0
  fi
  # a Cmm main (all.T's cmm_src, T17920; HES92 (a)): no Haskell, no STG; since queue 332 (HES67's design) the .cmm read by
  # arbace.repr.haskell.cmm and run by hsi (hsi run --cmm FORMS --cmm-main), the dump and the records skipped
  local cmm_main=""; case $main in *.cmm) cmm_main=1 ;; esac
  # the dump's flags: all.T's, less a test's own C, Cmm, assembly and objects (the helper compiles Haskell only); its
  # C files built by ci into a node program hsi loads (HES64 (a), bin/hsi cnodes), with the flags the C reads (-I, -D)
  # (an extra Haskell source of all.T's, multi_compile_and_run's ManyUbxSums_Addr.hs, given the helper as a file: HES92 (a))
  local fl=() f cfiles=() cflags=() cmmfiles=() optc="" hsf=(); if [ "$flags" != - ]; then for f in $flags; do
    # -optcX: X for the C compiler, a lone -D, -I or -U joined to the next one's (-optc-D -optcFOO is -DFOO)
    if [[ $f == -optc* ]]; then
      f=${f#-optc}
      if [ -n "$optc" ]; then cflags+=("$optc$f"); optc=""; continue; fi
      case $f in -D|-I|-U) optc=$f ;; -D*|-I*|-U*) cflags+=("$f") ;; esac
      continue
    fi
    case $f in *.c) cfiles+=("$f") ;; *.o) [ -f "$src/${f%.o}.c" ] && cfiles+=("${f%.o}.c") ;; *.cmm) cmmfiles+=("$f") ;; *.s|*.S|*.h|*.cpp|*.cc) ;; *.hs|*.lhs) hsf+=("$f") ;; -I*|-D*|-U*) fl+=("$f"); cflags+=("$f") ;; *) fl+=("$f") ;; esac; done; fi
  # the dump's key: the main file, the flags, the helper; a test of several modules: its directory's sources too
  local key prog stg="" srcs="" td=0
  if [ -n "$cmm_main" ]; then
    cmmfiles+=("$main"); prog=$root/.tmp/hsi/progs$sfx/$id/cmm-main; mkdir -p "$prog"; srcs=":stg :none"
    local plibs=$libs pimages=$images la=() l
    [ -z "$dump_only" ] || { echo "{:id \"$id\" :result :dumped :dump 0}" > "$res"; return 0; }
  else
  key=$(prog_key "$src" "$main" "$flags" "$kind" "$id")
  prog=$root/.tmp/hsi/progs$sfx/$id/$key
  local td=0 t0 t1
  # HFS-I1 (a): the native front end's STG when it compiled the program (its own work directory: no pack, no helper)
  local stg=$prog/stg srcs=":stg :ghc" ob=${id//\//_} fst
  if [ "$front" = native ]; then
    fst=$(awk -v b="$ob" '$1 == b {print $2; exit}' "$work/front/front.txt")
    if [ "$fst" = ok ] && [ -d "$work/front/out/stg/$ob" ]; then
      prog=$work/front/prog/$ob; rm -rf "$prog"; mkdir -p "$prog"; stg=$work/front/out/stg/$ob; srcs=":stg :native"; touch "$prog/ok"
    else
      srcs=":stg :ghc :front :${fst:-ineligible}"
      # queue 325: an ineligible program's reason (front_eligible's front_why)
      if [ -z "$fst" ]; then
        local why; why=$(awk -F'\t' -v b="$ob" '$1 == b {print $2; exit}' "$work/front/ineligible.tsv" 2>"$TMPDIR/hsi-why.err" | tr -d '"\\')
        [ -z "$why" ] || srcs="$srcs :why \"$why\""
      fi
    fi
  fi
  # HF10-P19 (a): the native STG of the own interfaces runs on the own libraries alone (:libs :own), the rest on the pack
  local plibs=$libs pimages=$images
  if [ "$libs_set" = own ]; then
    if [ "$srcs" = ":stg :native" ]; then plibs=$own_libs; pimages=$own_images; srcs="$srcs :libs :own"; else srcs="$srcs :libs :pack"; fi
  fi
  if [ ! -f "$prog/ok" ] && [ -z "$live" ]; then
    # the record's STG (ORS12): an entry whose key is not this program's is STALE, an absent one UNRECORDED (both :unrecorded, in no class)
    local man=$root/test/haskell/records/haskell-stg-progs.tsv pk
    pk=$(awk -F'\t' -v p="$id/" -v k="$key" 'index($1, p) == 1 {n++; if ($2 != k) bad = 1} END {print (n == 0 ? "none" : (bad ? "stale" : "ok"))}' "$man")
    # HF10-P35 (a): a test GHC's runs are not recorded for yet runs only from the native front end's STG until the oracle window
    if [ "$pk" = none ] && oracle_pending "$id"; then
      echo "{:id \"$id\" :result :oracle-pending $srcs :error \"no GHC record yet (test/haskell/own-verdicts-pending.tsv): bin/hsi record-ref --only, bin/hsi check --live --dump-only --record-progs at the oracle window\"}" > "$res"; return 0
    fi
    if [ "$pk" != ok ]; then
      echo "{:id \"$id\" :result :unrecorded :error \"$([ "$pk" = none ] && echo UNRECORDED || echo STALE): no current entry in haskell-stg-progs (bin/hsi check --live --dump-only --record-progs)\"}" > "$res"; return 0
    fi
    if [ -f "$progs_pack/$id/dump-failed.txt" ]; then
      echo "{:id \"$id\" :result :no-dump :error \"$(cat "$progs_pack/$id/dump-failed.txt")\"}" > "$res"; return 0
    fi

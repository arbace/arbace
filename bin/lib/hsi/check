  local memlim=""; [ "$mem" = 0 ] || memlim="ulimit -v $((mem * 1048576)); export GOMEMLIMIT=$((mem * 768))MiB; "
  # a profiled run (HSI_CPUPROFILE_DIR) under the soft limit alone: SIGXCPU stops it with its profile written
  # (and ten times its wall time: a loaded host)
  local tl="ulimit -t $HSI_TIMEOUT" wl=$((HSI_TIMEOUT * 3))
  [ -z "${HSI_CPUPROFILE_DIR:-}" ] || { tl="ulimit -S -t $HSI_TIMEOUT"; wl=$((HSI_TIMEOUT * 10)); }
  t0=$(date +%s.%N)
  (cd "$w" && env -i PATH=/usr/bin:/bin LANG=C.UTF-8 TZ=UTC HOME="$w" \
     timeout -s KILL $wl sh -c "${memlim}$tl; $cmd" \
     < "$w/$stdin" > "$o.stdout" 2> "$o.stderr") || st=$?
  t1=$(date +%s.%N)
  rm -rf "$w"
  # the program's executable and its generated Go and build module (20-50 MB a program: ~800 programs filled the disk, night 11) are
  # removed once the run is made: the verdicts, logs (aot-build.err, aot/*.log, aot/key), aot-closures.txt and the hsi run's outputs stay,
  # and a rerun of the program rebuilds (bin/lib/hsi/aot's build is kept by key only while DIR/hsi-aot exists). HSI_KEEP_BINS=1 keeps them.
  [ -z "$aot" ] || [ -n "${HSI_KEEP_BINS:-}" ] || rm -rf "$prog/aot/hsi-aot" "$prog/aot/hsi-aot.new" "$prog/aot/gen" "$prog/aot/mod"
  local so se rl rst rso rse
  so=$(sha256sum < "$o.stdout" | cut -c1-64); se=$(sha256sum < "$o.stderr" | cut -c1-64)
  rl=$(grep -F "{:id \"$id\" " "$ref" || true)
  local ign=""; ! ignore_stdout "$id" || ign=1
  local secs; secs=$(printf '%.2f' "$(echo "$t1 - $t0" | bc)")
  local tm=":dump $td :run $secs $srcs"
  if [ -n "$aot" ]; then
    # the compiled run against hsi's (diffcheck's kind): status, stdout and stderr
    local vs=same
    { [ "$st" = "$pst" ] && [ "$so" = "$(sha256sum < "$prog/aot-hsi.stdout" | cut -c1-64)" ] &&
      [ "$se" = "$(sha256sum < "$prog/aot-hsi.stderr" | cut -c1-64)" ]; } || vs=differs
    tm="$tm :aot-build $ab :hsi-run $hrun :vs-hsi :$vs"
  fi
  echo "$st" > "$o.status"
  local own; own=$(own_ref "$id")
  # queue 325g, DECISION 5 (a): on an arm64 host a program the arm64 reference records is judged by GHC's arm64 run
  local al=""; [ -z "$arch_ref" ] || al=$(arch_ref_line "$id")
  if [ -n "$al" ]; then
    rst=$(sed -n 's/.* :status \([^ ]*\) .*/\1/p' <<< "$al")
    rso=$(sed -n 's/.* :stdout "\([0-9a-f]*\)".*/\1/p' <<< "$al")
    rse=$(sed -n 's/.* :stderr "\([0-9a-f]*\)".*/\1/p' <<< "$al")
    tm="$tm :ref :arm64"
  elif [ -n "$own" ]; then
    # the program's own verdict: its expected status and shipped outputs, the record not read
    local opend; read -r rst rso rse opend <<< "$own"; tm="$tm :judge :own"
    # HF10-P35 (a): a pending test's outputs compared as the driver compares (the last newline not compared)
    if [ -n "$opend" ]; then so=$(awk 1 "$o.stdout" | sha256sum | cut -c1-64); se=$(awk 1 "$o.stderr" | sha256sum | cut -c1-64); tm="$tm :pending true"; fi
  else
  if [ -z "$rl" ]; then echo "{:id \"$id\" :result :no-ref $tm}" > "$res"; return 0; fi
  rst=$(sed -n 's/.* :status \([^ ]*\) .*/\1/p' <<< "$rl")
  rso=$(sed -n 's/.* :stdout "\([0-9a-f]*\)".*/\1/p' <<< "$rl")
  rse=$(sed -n 's/.* :stderr "\([0-9a-f]*\)".*/\1/p' <<< "$rl")
  fi
  # D-HSJ-3 (a) (the main session, 2026-11-20): a run killed at the check's limits (SIGKILL at the wall cap, 137; SIGXCPU at the
  # CPU limit, 152) never passes, even against a reference killed the same way (GHC's record of fannkuch-redux and minimax at
  # record-ref's 10 s limit): no program's verdict is a kill. Its status counts as differing; the reason :limit
  local killed=""; case $st in 137|152) killed=1 ;; esac
  if grep -q '^hsi: ' "$o.stderr"; then
    local msg rsn; msg=$(grep -m1 '^hsi: ' "$o.stderr" | cut -c1-200 | sed 's/\\/\\\\/g; s/"/\\"/g')
    # why hsi stopped, as hsi words it (HES43 (b)): its hsi-reason line
    rsn=$(sed -n 's/^hsi-reason: \([a-z-]*\)$/\1/p' "$o.stderr" | head -1)
    echo "{:id \"$id\" :result :hsi :status $st :message \"$msg\"${rsn:+ :reason :$rsn} $tm}" > "$res"
  elif [ -z "$killed" ] && [ "$st" = "$rst" ] && { [ "$so" = "$rso" ] || [ -n "$ign" ]; } && [ "$se" = "$rse" ]; then
    # HES87 (a): a test all.T runs only in the threaded ways whose recorded normal-way run is not its own verdict (the
    # non-threaded RTS's refusal: test/haskell/threaded-way.tsv, bin/hsi own-verdicts) is no evidence of the test's
    # behaviour: matching it is :threaded-way (deferred, until HES84 (a)'s threaded references), not a pass
    if [ "${HSI_JUDGE:-}" != ref ] && awk -F'\t' -v i="$id" '$1 == i {f = 1} END {exit !f}' "$root/test/haskell/threaded-way.tsv"; then
      echo "{:id \"$id\" :result :threaded-way :would :pass $tm}" > "$res"
    else
      echo "{:id \"$id\" :result :pass $tm}" > "$res"
    fi
  else
    local why=""
    { [ "$st" = "$rst" ] && [ -z "$killed" ]; } || why="$why :status"
    [ "$so" = "$rso" ] || [ -n "$ign" ] || why="$why :stdout"
    [ "$se" = "$rse" ] || why="$why :stderr"
    # killed at the check's limits (SIGKILL at the wall cap, SIGXCPU at the CPU limit): the reason :limit
    local lim=""; case $st in 137|152) lim=" :reason :limit" ;; esac
    # review 1111b (finding 3): a failure on the own libraries says what failed, stderr's first line (judged by
    # test/haskell/divergences-own.edn's :message when it fails otherwise than on the pack)
    local err=""
    if [[ $tm == *":libs :own"* ]] && [ "$se" != "$rse" ]; then
      err=$(grep -m1 . "$o.stderr" | cut -c1-120 | sed 's/\\/\\\\/g; s/"/\\"/g'); [ -z "$err" ] || err=" :err \"$err\""
    fi
    echo "{:id \"$id\" :result :fail :status $st :differs [${why# }]$lim$err $tm}" > "$res"
  fi
  [ -n "$keep" ] || grep -q "^$id " "$root/test/haskell/hsi-controls.txt" || rm -f "$o.stdout" "$o.stderr"
}
export -f one
export dump_only

# ORS12: --verify-progs [--sample N]: N programs (default all) of the plan (evenly spread) dumped again by the helper into .tmp/hsi/check/verify and compared with the
# pack's STG file for file (ORS6 (a)'s verdict), and the crossed pair (the first program's live dump against the last one's record)
verify_progs_run() {
  local n=$1 total ids=() i j row id src main flags ropts name sin kind fl f d ndiff=0 cmpd=0 first="" last="" key
  mapfile -t rows < "$plan"; total=${#rows[@]}
  [ "$n" -lt "$total" ] || n=$total
  for ((i = 0; i < n; i++)); do ids+=("${rows[$(( i * total / n ))]}"); done
  for row in "${ids[@]}"; do
    IFS=$'\037' read -r id src main flags ropts name sin kind <<< "$row"
    [ "$main" != - ] || continue
    fl=() hsf=(); if [ "$flags" != - ]; then for f in $flags; do case $f in *.c|*.cmm|*.s|*.S|*.o|*.h|*.cpp|*.cc) ;; *.hs|*.lhs) hsf+=("$f") ;; *) fl+=("$f") ;; esac; done; fi
    d=$work/verify/${id//\//_}; rm -rf "$d"; mkdir -p "$d"
    # HES92 (a): the main a pre_cmd's generator writes, made first (removed after)
    local gen made=""; gen=$(hsi_pre_gen "$id")
    if [ -n "$gen" ] && [ ! -f "$src/$main" ]; then (cd "$src" && timeout 300 ghc -no-user-package-db --run "./$gen") > "$d/pre.log" 2>&1 || true; made=1; fi
    key=$(prog_key "$src" "$main" "$flags" "$kind" "$id")
    pk=$(awk -F'\t' -v p="$id/" -v k="$key" 'index($1, p) == 1 {n++; if ($2 != k) bad = 1} END {print (n == 0 ? "none" : (bad ? "stale" : "ok"))}' "$root/test/haskell/records/haskell-stg-progs.tsv")
    if [ "$pk" != ok ]; then echo "verify: $id: $pk"; ndiff=$((ndiff + 1)); cmpd=$((cmpd + 1)); continue; fi
    cmpd=$((cmpd + 1))
    if (cd "$src" && timeout 300 "$helper" stg -o "$d/stg" --libdir "$libdir" --helper-hash "sha256:$helper_hash" --ghc -O0 \
          ${fl[@]+"${fl[@]}"} -outputdir "$d/obj" --files "$main" ${hsf[@]+"${hsf[@]}"}) > "$d/dump.log" 2>&1; then
      if [ -f "$progs_dir/$id/dump-failed.txt" ]; then echo "verify: $id: DIFFERS (recorded as failing, now compiles)"; ndiff=$((ndiff + 1))
      elif diff -r "$d/stg" "$progs_dir/$id/stg" > "$d/diff.txt" 2>&1; then echo "verify: $id: equal"
      else echo "verify: $id: DIFFERS ($d/diff.txt)"; ndiff=$((ndiff + 1)); fi
      [ -n "$first" ] || first=$d/stg; last=$progs_dir/$id/stg
    else
      if [ -f "$progs_dir/$id/dump-failed.txt" ]; then echo "verify: $id: equal (fails as recorded)"
      else echo "verify: $id: DIFFERS (fails, recorded as compiling)"; ndiff=$((ndiff + 1)); fi
    fi
    [ -z "$made" ] || rm -f "$src/$main"
  done
  oracle_verdict ghc "$root/test/haskell/records/haskell-stg-progs.tsv" "$ndiff" "$cmpd" || return 1
  if [ -n "$first" ] && [ -n "$last" ] && [ "$first" != "$last" ]; then
    if diff -r "$first" "$last" > "$work/verify/crossed.diff" 2>&1; then echo "verify: FAILED: the crossed pair is equal: control not judged"; return 1
    else echo "verify: the crossed pair differs (control passed)"; fi
  fi
}
# --record-progs: each program of the plan (live, dumped by the run just made or the cache) packed into haskell-stg-progs; a program
# not in the plan keeps its members
record_progs_run() {
  local stage=$root/.tmp/hsi/records/progs name man d row id src main flags ropts nm sin kind key prog n=0
  name=$(oracle_pin_name "$hsi_progs_pin"); man=$(oracle_manifest "$hsi_progs_pin")
  rm -rf "$stage"; mkdir -p "$stage/$name"; : > "$stage/ids"
  if [ -f "$man" ] && [ -f "$hsi_progs_pin" ] && d=$(oracle_unpack "$hsi_progs_pin" 2>"$TMPDIR/hsi-records.err"); then
    cp -a "$d/$name/." "$stage/$name/"; awk -F'\t' '!/^#/ && NF {print $1 "\t" $2}' "$man" > "$stage/ids"
  fi
  while IFS= read -r row; do
    IFS=$'\037' read -r id src main flags ropts nm sin kind <<< "$row"
    [ "$main" != - ] || continue
    key=$(prog_key "$src" "$main" "$flags" "$kind" "$id"); prog=$root/.tmp/hsi/progs/$id/$key
    awk -F'\t' -v p="$id/" 'index($1, p) != 1' "$stage/ids" > "$stage/ids.new"; mv "$stage/ids.new" "$stage/ids"
    rm -rf "${stage:?}/$name/$id"
    if [ -f "$prog/ok" ]; then
      mkdir -p "$stage/$name/$id/stg"; cp -r "$prog/stg/." "$stage/$name/$id/stg/"
      # the foreign stubs GHC wrote for it (HES60 (a)), when it has any
      if [ -n "$(ls "$prog/stubs" 2>"$TMPDIR/hsi-stubs.err")" ]; then mkdir -p "$stage/$name/$id/stubs"; cp -r "$prog/stubs/." "$stage/$name/$id/stubs/"; fi
      (cd "$stage/$name" && find "$id/stg" "$id/stubs" -type f 2>"$TMPDIR/hsi-find.err" | LC_ALL=C sort) | while IFS= read -r m; do printf '%s\t%s\n' "$m" "$key"; done >> "$stage/ids"
    elif [ -f "$prog/dump-failed.txt" ]; then
      mkdir -p "$stage/$name/$id"; cp "$prog/dump-failed.txt" "$stage/$name/$id/dump-failed.txt"; printf '%s/dump-failed.txt\t%s\n' "$id" "$key" >> "$stage/ids"
    else echo "record: $id has no dump (not run)" >&2; continue; fi
    n=$((n + 1))
  done < "$plan"
  [ "$n" -gt 0 ] || { echo "record: no program to record" >&2; return 1; }
  oracle_make "$hsi_progs_pin" "$stage" "$stage/ids" "bin/hsi check --live --dump-only --record-progs --corpus $corpora${only:+ --only ...}" ghc || return 1
  rm -rf "$stage"
}

  # the RTS the program is linked with: -threaded's and -with-rtsopts' (the RTS's options and its usage text, rtsflags)
  if [ "$flags" != - ]; then for f in $flags; do
    case $f in -threaded) la+=(--threaded) ;; -with-rtsopts=*) la+=(--with-rtsopts "${f#-with-rtsopts=}") ;; esac
  done; fi

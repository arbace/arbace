#!/bin/bash
# bin/hsi check [--corpus C,...] [--only ID,...|@FILE] [--jobs N] [--record] [--keep]: Haskell's eval level (HE4a,
# HE4c; doc/haskell/HASKELL-EVAL-SURVEY.md, "As built: HE4a (write-ahead)", "As built: HE4b, HE4c (write-ahead)"):
# each program of the run corpora (samples, synthetic, testsuite-core: the run tests of eval-corpora.edn's
# :testsuite-core directories, record-ref's plan, test/haskell/eval/run_plan.ae; default samples,synthetic; nofib, HE5: the Makefiles' flags, arguments and stdin as record-ref plans them) compiled
# to STG at -O0 by the helper (tools/hsdump stg; a testsuite test with its all.T flags and its directory's modules,
# GHC following the imports; its dump cached by the sources', the flags' and the helper's digests in
# .tmp/hsi/progs/), run on hsi (bin/hsi build's light driver) over the libraries' dumps (HSI_LIBS, default
# .tmp/hsi/dumps/stg, .tmp/hsi/dumps-extra/stg and .tmp/hsi/dumps-more/stg, bin/hsi dumps' outputs; their images, HE4d,
# made first by hsi image into HSI_IMAGE, default .tmp/hsi/image, none for the forms read every run) as record-ref ran
# GHC's build: in a fresh copy of its directory, env -i, LANG=C.UTF-8, TZ=UTC, its stdin, its arguments (a sample's
# NAME.args; a test's extra_run_opts through sh, its +RTS options left to the driver, which drops them as GHC's RTS
# does) and its program name; HSI_TIMEOUT seconds of CPU, default 60, three times that of wall time (HSI_CPUPROFILE_DIR: each
# run's CPU profile into DIR/ID.prof, bin/hsi pgo's training; a run stopped at the limit keeps its profile). Judged against
# test/haskell/ref-ghc914.edn (HES16 (a)): :pass when the status, stdout's SHA-256 and stderr's SHA-256 are the
# reference's; else :fail with what differs (:status, :stdout, :stderr), :hsi when hsi itself stopped (an
# unimplemented primop or C function, its message), :no-dump (the helper failed: its first error), :no-ref.
# Every result carries :dump (the helper's seconds, 0 when cached) and :run (hsi's wall seconds): GT8's per-program
# times. The results into .tmp/hsi/check/results.edn; --record: into test/haskell/check-hsi.edn (a run of some
# corpora or --only keeps the other programs' lines). --only takes ids, or @FILE a file of ids (one a line, # a
# comment): GT8's lists. --keep keeps each run's outputs in .tmp/hsi/check/out/. Every program that does not pass
# must be in a class of test/haskell/divergences.edn (its :ids), and every negative control of
# test/haskell/hsi-controls.txt (a subject's run judged against another program's reference) whose subject ran
# must fail; else the check fails.
# ORS12 (doc/ORACLE-RECORDS-SURVEY.md, "As built: Haskell"): GHC's part is recorded. The libraries' STG (HSI_LIBS) and each program's -O0 STG
# are read from the packs haskell-stg-libs and haskell-stg-progs (bin/lib/hsi/records.bash), no GHC and no helper run; a program whose
# entry is absent or whose key changed (its sources, flags, the helper) is :unrecorded, in no class: the check fails (ORS10 (a)).
#   --live              the helper dumps the programs and the dumps directories are the libraries (HSI_LIVE=1), as before
#   --dump-only         with --live: only the programs' dumps, no hsi run, no image (the recording's first half)
#   --record-progs      with --live: each program's STG (or the helper's first error) packed into haskell-stg-progs, the programs not in
#                       the plan kept; by hand, a commit of its own naming :ghc's identity
#   --verify-progs [--sample N]   N programs of the plan (default all, evenly spread) dumped again by the helper and compared with the
#                       pack file for file (ORS6 (a)'s verdict) and the crossed pair
# HFS-I1 (a) (doc/haskell/FRONTEND-SURVEY.md, "As built: HFS-I1 (a)"): the program's STG from Arbace's native front end.
#   --front native|ghc  (HSI_FRONT; default ghc, default_front below) native: each program the front end can take (every module its
#                       main file imports a library's, in the interfaces pack, or since HF10-P24 (a) one of the program's own, its
#                       source in the program's directory, M.hs or M.lhs, compiled first in dependency order, no hs-boot file; no C of its own, no foreign export,
#                       wrapper or capi import) compiled by arbace.repr.haskell.front (native read, rename, elaborate, desugar, the
#                       simple optimiser, CorePrep, CoreToStg, Unarise) over the pack haskell-ifaces-ghc-9.14.1 and the libraries' STG,
#                       with its all.T -X flags (none: GHC2021, as GHC compiled the pack's STG), in HSI_FRONT_SHARDS processes (default 4,
#                       Go's heap near HSI_FRONT_MEM, default 1536MiB), and run from that STG; the others, and a program the front end
#                       stops, from haskell-stg-progs as before. Each result names its source: :stg :native, or :stg :ghc with :front
#                       the stage that stopped the front end (:ineligible: not tried). Work .tmp/hsi/check-native (check-aot-native);
#                       --record writes test/haskell/check-hsi-native.edn (-aot-native) while ghc is the default (the switch:
#                       default_front=native, then check-hsi.edn is native's and --front ghc writes check-hsi-ghc.edn).
#                       bin/hsi compare-front compares the two records program by program.
#   --record-ifaces     with --front native, live (GHC): the helper's iface closure of every module the plan's eligible programs import
#                       (and Prelude), with ghc-pkg's reexports, packed into haskell-ifaces-ghc-9.14.1; by hand, the oracle tier
# HF10-P19 (a), P22 (a), P23 (a) (doc/haskell/FRONTEND-SURVEY.md, "As built: HF10-P21, P19, P22, P23"): programs on Arbace's own libraries.
#   --libs own|pack     (HSI_LIBS_SET; default pack) own: a program the native front end can take on the own interfaces alone (every
#                       module it imports is an own package's, ghc-internal's, base's or since P17 HSI_OWN_PACKAGES' and HSI_OWN_TARS',
#                       or a reexport of one: ghc-prim's, ghc-bignum's: the own pools' modules decide) and that is not
#                       in test/haskell/own-fallback.txt is compiled by the front end against the own interfaces (HSI_OWN_IFACES:
#                       DIR:DIR..., default lib-check --ifaces own's pools of ghc-internal, its wired-in GHC.Internal.Prim and base's)
#                       and run over the own libraries' STG alone (HSI_OWN_STG: DIR:DIR..., default lib-stg --ifaces own's STG of
#                       ghc-internal and base; no other package, no GHC-made module: a run that needs one stops): :libs :own, its
#                       case Arbace's own (1); every other program as --front ghc runs it (haskell-stg-progs over haskell-stg-libs):
#                       :libs :pack with :front the reason (:ineligible: an import not own, a C file, a foreign stub;
#                       :fallback: the list; else the stage that stopped the front end; queue 325: an :ineligible line's :why "CATEGORY
#                       DETAIL" names its refusal: kind, no-main, c, main-is, pragma, local-boot (an hs-boot file of its own), import (a
#                       module no interface here has), summed at the end). Work .tmp/hsi/check-own (check-aot-own);
#                       --record writes test/haskell/check-hsi-own.edn (-aot-own). own-fallback.txt (P23 (a)): the eligible programs
#                       that did not pass on the own libraries, each with its class, run on the pack; it may only shrink: review
#                       1111b (finding 4), HSI_OWN_FALLBACK=try runs them on the own libraries too (no --record) and fails on one
#                       that passes; a run without --only fails on a listed id its corpora lack. Review 1111b (finding 3): a
#                       non-pass on the own libraries is judged by divergences.edn only when it fails as check-hsi.edn's line does
#                       (kind, status, differs); else by test/haskell/divergences-own.edn (:outcome, :message against :err, its
#                       stderr's first line). HF10-P29 (a): HSI_OWN_TARS=TAR:... in place of HSI_OWN_IFACES and HSI_OWN_STG, the
#                       gate producers' outputs (lib-stg --ifaces own's LIB_STG_OWN_OUT: pool/, wired/, stg/UNIT/ a tar)
set -euo pipefail
root=$(cd "$(dirname "$0")/../../.." && pwd)
. "$root/bin/lib/tmpdir.bash"
. "$root/bin/lib/hsi/records.bash"
default_front=ghc
corpora=samples,synthetic only="" jobs=${HSI_JOBS:-3} front=${HSI_FRONT:-$default_front} record_ifaces="" record="" keep="" aot="" live=${HSI_LIVE:-} dump_only="" record_progs="" verify_progs="" sample="" opt=${HSI_OPT:-O0} libs_set=${HSI_LIBS_SET:-pack}
while [ $# -gt 0 ]; do
  case $1 in
    --live) live=1; shift ;;
    --dump-only) dump_only=1; live=1; shift ;;
    --record-progs) record_progs=1; live=1; shift ;;
    --verify-progs) verify_progs=1; live=1; shift ;;
    --sample) sample=$2; shift 2 ;;
    --corpus) corpora=${2//+/,}; shift 2 ;;   # (C+C...: a gate part's name, n-gate-parts)
    --only) if [[ $2 == @* ]]; then only=,$(grep -v '^#' "${2#@}" | grep . | tr '\n' ',' ); else only=,$2,; fi; shift 2 ;;
    --jobs) jobs=$2; shift 2 ;;
    --record) record=1; shift ;;
    --keep) keep=1; shift ;;
    --aot) aot=1; shift ;;
    --opt) opt=$2; shift 2 ;;
    --front) front=$2; shift 2 ;;
    --libs) libs_set=$2; shift 2 ;;
    --record-ifaces) record_ifaces=1; shift ;;
    *) echo "usage: bin/hsi check [--corpus C,...] [--only ID,...|@FILE] [--jobs N] [--record] [--keep] [--aot] [--opt O0|O1] [--front native|ghc] [--libs own|pack] [--record-ifaces] [--live] [--dump-only] [--record-progs] [--verify-progs [--sample N]]" >&2; exit 2 ;;
  esac
done
case $front in native|ghc) ;; *) echo "hsi check: --front native or ghc, not $front" >&2; exit 2 ;; esac
case $libs_set in own|pack) ;; *) echo "hsi check: --libs own or pack, not $libs_set" >&2; exit 2 ;; esac
# review 1111b (finding 4): HSI_OWN_FALLBACK=try (--libs own): own-fallback.txt's programs tried on the own libraries too
own_fallback=${HSI_OWN_FALLBACK:-}
# (HSI_OWN_FALLBACK_LIST: another list, for the try mode's own test)
own_fallback_list=${HSI_OWN_FALLBACK_LIST:-$root/test/haskell/own-fallback.txt}
case $own_fallback in ''|try) ;; *) echo "hsi check: HSI_OWN_FALLBACK=try or unset, not $own_fallback" >&2; exit 2 ;; esac
[ -z "$own_fallback" ] || { [ "$libs_set" = own ] && [ -z "$record" ]; } || { echo "hsi check: HSI_OWN_FALLBACK=try is --libs own's, without --record (its listed programs' lines are the pack's)" >&2; exit 2; }
# --libs own: the eligible programs' front is the native one over the own interfaces, the others' GHC's (the pack)
[ "$libs_set" = pack ] || { [ "$opt" = O0 ] && [ -z "$live" ] && [ -z "$record_ifaces" ]; } || { echo "hsi check: --libs own is -O0's, on the records (no --live, --record-ifaces)" >&2; exit 2; }
[ "$libs_set" = pack ] || front=native
[ -z "$record_ifaces" ] || [ "$front" = native ] || { echo "hsi check: --record-ifaces goes with --front native" >&2; exit 2; }
[ -z "$record_ifaces" ] || live=1
# -O1's programs are not in haskell-stg-progs (its records are -O0's): --opt O1 dumps them live, and records none; the native
# front end's STG is -O0's
if [ "$opt" != O0 ]; then
  { [ -z "$record_progs" ] && [ -z "$verify_progs" ]; } || { echo "hsi check: --record-progs and --verify-progs are -O0's (haskell-stg-progs)" >&2; exit 2; }
  [ "$front" = ghc ] || { echo "hsi check: --front native is -O0's" >&2; exit 2; }
  live=1
fi
pin=$(cat "$root/tools/hsdump/GHC_VERSION")
# GHC is needed only by --live (the helper dumps the programs; HSI_LIVE=1), --dump-only, --record-progs and --verify-progs: the libraries'
# and the programs' STG are the records' otherwise (ORS12, bin/lib/hsi/records.bash)
export live
if [ -n "$live" ]; then [ "$(ghc --numeric-version)" = "$pin" ] || { echo "hsi check: the host's GHC is not $pin" >&2; exit 1; }; fi
ref=$root/test/haskell/ref-ghc914.edn
work=$root/.tmp/hsi/check
# --opt O1 (HES74 (c)): the programs dumped at -O1 (GHC's optimiser: strictness analysis, worker/wrapper, specialisation),
# judged against GHC's -O1 runs (test/haskell/ref-ghc914-O1.edn, bin/hsi record-ref --opt O1); the dumps cached apart
# (.tmp/hsi/progs-O1), the results in .tmp/hsi/check[-aot]-O1, --record into test/haskell/check-hsi[-aot]-O1.edn, a
# non-pass's class looked up in test/haskell/divergences-O1.edn first (the classes only -O1 has: :eval-order), then in
# test/haskell/divergences.edn. The compiled level's runs at -O1 (--aot --opt O1); hsi's own level stays at -O0.
case $opt in O0) sfx="" ;; O1) sfx=-O1 ;; *) echo "hsi check: --opt O0 or O1" >&2; exit 2 ;; esac
ref=${HSI_REF:-$root/test/haskell/ref-ghc914$sfx.edn} # HSI_REF: another record (a scratch reference: queue 332's arm64 probes)
divs=$root/test/haskell/divergences.edn divs1=$root/test/haskell/divergences$sfx.edn
work=$work$sfx
# --aot (HE8, the first slice): each program built by bin/hsi aot build (its modules and the library closures a first
# run on hsi entered compiled to Go) and run on its executable; results into .tmp/hsi/check-aot, --record into
# test/haskell/check-hsi-aot.edn
[ -z "$aot" ] || work=$root/.tmp/hsi/check-aot$sfx
# a front that is not the default works apart (HFS-I1 (a)): its results beside the default's; --libs own apart too
if [ "$libs_set" = own ]; then work=$work-own
elif [ "$front" != "$default_front" ]; then work=$work-$front; fi
# n-gate-parts (2026-11-19): a gate step's part (HSI_CHECK_PART, its corpora) works apart, so that two parts run side by side
[ -z "${HSI_CHECK_PART:-}" ] || work=$work.$HSI_CHECK_PART
rm -rf "$work"; mkdir -p "$work/res" "$work/out" "$work/run"
hsi=""; if [ -z "$dump_only" ] && [ -z "$verify_progs" ] && [ -z "$record_ifaces" ]; then hsi=$("$root/bin/hsi" build); fi
if [ -n "$dump_only" ] || [ -n "$verify_progs" ] || [ -n "$record_ifaces" ]; then libs=""; else libs=$(hsi_libs) || exit 1; fi
helper=$root/.tmp/hsdump/hsdump
helper_hash=$(hsr_helper_hash)
libdir=""
if [ -n "$live" ]; then "$root/bin/repr-haskell" helper >&2; libdir=$(ghc --print-libdir); fi
progs_pack=""
if [ -z "$live" ]; then progs_pack=$(hsi_progs_dir) || exit 1; fi  # (--verify-progs is live: it reads the pack itself)
export progs_pack
# the libraries' images (HES32 (a), HE4d): made once for the dumps as they are, every run loads them
images=${HSI_IMAGE:-$root/.tmp/hsi/image}
if [ "$images" != none ] && [ -z "$dump_only" ] && [ -z "$verify_progs" ] && [ -z "$record_ifaces" ]; then
  ia=(); IFS=: read -r -a dirs <<< "$libs"
  for l in "${dirs[@]}"; do [ -d "$l" ] && ia+=(--lib "$l"); done
  "$hsi" image --out "$images" "${ia[@]}" >&2 || { echo "hsi check: hsi image failed" >&2; exit 1; }
fi
# HF10-P19 (a): the own libraries and interfaces, composed into WORK/own: if/ the own interfaces (and, since queue 325's
# DECISION 4 (a), the .cabal files' reexports whose module is own; HSI_OWN_REEXPORTS=pack: the pack's reexports.edn's
# entries whose module is own), stg/PKG/ the own STG (links), image/ their image
own_libs="" own_images="" own_if=""
if [ "$libs_set" = own ]; then
  oi=${HSI_OWN_IFACES:-$root/.tmp/repr-haskell/lib-check/own/ghc-internal/pool:$root/.tmp/repr-haskell/lib-check/own/ghc-internal/wired:$root/.tmp/repr-haskell/lib-check/own/base/pool}
  os=${HSI_OWN_STG:-$root/.tmp/repr-haskell/lib-stg-own/out/stg/ghc-internal:$({ ls -d "$root"/.tmp/repr-haskell/lib-stg-own/base/out/stg/base-* 2>"$TMPDIR/hsi-own.err" || :; } | head -1)}
  # HF10-P30 (a), P17: HSI_OWN_PACKAGES=P,... (in dependency order: deepseq,array,stm) the packages above base made own too,
  # their pools (lib-check --package P --ifaces own) and STG (lib-stg --package P --ifaces own) in .tmp after base's; an import
  # is eligible when one of the own pools holds its interface (or a reexport of one): the eligibility is the own pools' modules
  if [ -z "${HSI_OWN_IFACES:-}" ] && [ -z "${HSI_OWN_STG:-}" ] && [ -n "${HSI_OWN_PACKAGES:-}" ]; then
    for p in ${HSI_OWN_PACKAGES//,/ }; do
      u=$({ ls -d "$root"/.tmp/repr-haskell/lib-stg-own/"$p"/out/stg/"$p"-* 2>"$TMPDIR/hsi-own.err" || :; } | head -1)
      [ -d "$root/.tmp/repr-haskell/lib-check/own/$p/pool" ] && [ -n "$u" ] ||
        { echo "hsi check --libs own: HSI_OWN_PACKAGES names $p: no own pool or STG of it (bin/repr-haskell lib-check, lib-stg --package $p --ifaces own)" >&2; exit 1; }
      oi=$oi:$root/.tmp/repr-haskell/lib-check/own/$p/pool os=$os:$u
    done
  fi
  # HF10-P29 (a): HSI_OWN_TARS=TAR:TAR... (the gate's hsi-check, hsi-check-aot: haskell-lib-stg-own's ghc-internal-own.tar and
  # haskell-lib-own-base's base-own.tar, GATE_OUTS), each lib-stg's LIB_STG_OWN_OUT: pool/, wired/ (ghc-internal's) and
  # stg/UNIT/; unpacked into WORK/own-tars/N, they replace HSI_OWN_IFACES and HSI_OWN_STG
  if [ -n "${HSI_OWN_TARS:-}" ]; then
    oi="" os="" n=0
    IFS=: read -r -a tars <<< "$HSI_OWN_TARS"
    for t in "${tars[@]}"; do
      [ -f "$t" ] || { echo "hsi check --libs own: no $t (HSI_OWN_TARS: the own libraries' producers' outputs)" >&2; exit 1; }
      n=$((n + 1)); d=$work/own-tars/$n; mkdir -p "$d"; tar -C "$d" -xf "$t"
      [ -d "$d/pool" ] && [ -d "$d/stg" ] || { echo "hsi check --libs own: $t holds no pool/ and stg/ (bin/repr-haskell lib-stg --ifaces own with LIB_STG_OWN_OUT)" >&2; exit 1; }
      oi=$oi${oi:+:}$d/pool; [ ! -d "$d/wired" ] || oi=$oi:$d/wired
      for u in "$d"/stg/*/; do os=$os${os:+:}${u%/}; done
    done
  fi
  own_if=$work/own/if; own_libs=$work/own/stg; own_images=$work/own/image
  mkdir -p "$own_if" "$own_libs"
  IFS=: read -r -a dirs <<< "$oi"
  for l in "${dirs[@]}"; do
    [ -n "$(ls "$l"/*.iface.edn 2>"$TMPDIR/hsi-own.err")" ] || { echo "hsi check --libs own: no own interfaces in $l (bin/repr-haskell lib-check --ifaces own; --package base --ifaces own)" >&2; exit 1; }
    cp "$l"/*.iface.edn "$own_if"/
  done
  # DECISION 4 (a) of queue 325 (the user, 2026-11-17): the reexported modules from the packages' .cabal files (ghc-prim's,
  # ghc-bignum's: libcheck's cabal-reexports, test/haskell/eval/own_reexports.ae) whose module the own interfaces hold, not
  # ghc-pkg's answers in the pack haskell-ifaces-ghc-9.14.1 (HSI_OWN_REEXPORTS=pack: the pack's, as before, for a comparison)
  if [ "${HSI_OWN_REEXPORTS:-cabal}" = pack ]; then
    pif=$(hsi_ifaces_dir) || exit 1
    { echo "{"; grep '^ *"' "$pif/reexports.edn" | while read -r a b; do if [ -f "$own_if/${b//\"/}.iface.edn" ]; then echo " $a $b"; fi; done; echo "}"; } > "$own_if/reexports.edn"
  else
    osrc=$("$root/bin/repr-haskell" corpus fetch | tail -1) || { echo "hsi check --libs own: no source tree for the .cabal files (bin/repr-haskell corpus fetch)" >&2; exit 1; }
    ARBACE_PATH=$root "$("$root/bin/hsi" exe)" "$root/test/haskell/eval/own_reexports.ae" "$root/test/haskell/corpus-ghc-9.14.1.edn" "$osrc" "$own_if" > "$own_if/reexports.edn.new" 2> "$work/own-reexports.err" &&
      grep -q '"GHC.Prim" "GHC.Internal.Prim"' "$own_if/reexports.edn.new" ||
      { cat "$work/own-reexports.err" >&2; echo "hsi check --libs own: the .cabal files' reexports (test/haskell/eval/own_reexports.ae) failed or lack ghc-prim's GHC.Prim" >&2; exit 1; }
    mv "$own_if/reexports.edn.new" "$own_if/reexports.edn"
  fi
  IFS=: read -r -a dirs <<< "$os"
  for l in "${dirs[@]}"; do
    [ -n "$(ls "$l"/*.stg.ae 2>"$TMPDIR/hsi-own.err")" ] || { echo "hsi check --libs own: no own STG in $l (bin/repr-haskell lib-stg --ifaces own; --package base --ifaces own)" >&2; exit 1; }
    mkdir -p "$own_libs/$(basename "$l")"
    for f in "$l"/*.stg.ae; do ln -sf "$f" "$own_libs/$(basename "$l")/"; done
  done
  "$hsi" image --out "$own_images" --lib "$own_libs" >&2 || { echo "hsi check: hsi image of the own libraries failed" >&2; exit 1; }
  echo "== hsi check --libs own: $(ls "$own_if" | grep -c '\.iface\.edn$') own interfaces, $(find "$own_libs" -name '*.stg.ae' | wc -l) own modules' STG" >&2
fi
# the RTS's headers (HsFFI.h, Rts.h) for a program's own C, as ghc gives its C compiler: the installation's (live), else
# the pack haskell-native-inputs-ghc-9.14.1's copy of them (its sysroot, as repr/haskell's native reads take it)
if [ -n "$live" ]; then rtsinc=$(ls -d "$libdir"/../lib/*-ghc-"$pin"-*/rts-*/include 2>&1 | head -1)
else nlibdir=$("$root/bin/repr-haskell" native-libdir); rtsinc=$(ls -d "$nlibdir"/*-ghc-"$pin"-*/rts-*/include 2>&1 | head -1); fi
# HF10-P63 (a): the installation the native front end preprocesses a CPP module with (arbace.repr.haskell.driver, GHC's doCpp's
# arguments, __GLASGOW_HASKELL__ from its ghcversion.h): the derived tree's sysroot and libdir (as repr/haskell's native reads),
# else the host's (live)
if [ -n "$live" ]; then front_inst=(--libdir "$libdir")
else front_sysroot=${nlibdir%%/sysroot/*}/sysroot; front_inst=(--sysroot "$front_sysroot" --libdir "${nlibdir#"$front_sysroot"}"); fi
export libs_set own_libs own_images own_if own_fallback
export root work hsi libs helper helper_hash libdir ref keep images aot rtsinc opt sfx divs divs1 front
export HSI_TIMEOUT=${HSI_TIMEOUT:-60}
# programs that need more than ARBACE_MEM_GIB name their own cap (ID=GIB ...); none today: the deepest stacks, Loop
# (7.3 GB of RSS) and T16846 (9.7 GB), pass under the default 16 GiB (measured alone, 2026-11-03)
export HSI_MEM_CAPS=${HSI_MEM_CAPS:-}

# the plan: ID SRC MAIN FLAGS RUN-OPTS NAME STDIN KIND, separated by U+001F ("-" for none)
plan=$work/plan.txt
: > "$plan"
add() { printf '%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\n' "$@" >> "$plan"; }
for c in ${corpora//,/ }; do
  case $c in
    samples|synthetic)
      d=$root/test/haskell/eval/$c
      for f in "$d"/*.hs; do
        n=$(basename "$f" .hs) a=-
        [ -f "$d/$n.args" ] && a=$(cat "$d/$n.args")
        add "$c/$n" "$d" "$n.hs" - "$a" "$n" "$([ -f "$d/$n.stdin" ] && echo "$n.stdin" || echo -)" plain
      done ;;
    testsuite-core)
      tests=$root/.tmp/hsi/ghc-9.14.1/testsuite/tests
      "$root/bin/hsi" pins --fetch testsuite > "$work/fetch.log" 2>&1 || { cat "$work/fetch.log" >&2; exit 1; }
      ae() { ARBACE_PATH=$root "$("$root/bin/hsi" exe)" "$@"; }
      dirs=$(ae -e "(println (apply str (interpose \",\" (get-in (some #(when (= :testsuite-core (:id %)) %) (:corpora (read-string (slurp \"$root/test/haskell/eval-corpora.edn\")))) [:where :dirs]))))")
      ae "$root/test/haskell/eval/run_plan.ae" "$root/test/haskell/eval/testsuite-run.edn" "$tests" "$dirs" 2> "$work/plan.notes" |
      while IFS=$'\t' read -r id dir kind main flags ropts exit name; do
        sin=-; [ -f "$tests/$dir/$name.stdin" ] && sin=$name.stdin
        add "$id" "$tests/$dir" "$main" "$flags" "$ropts" "$name" "$sin" "$kind"
      done ;;
    nofib)
      # nofib's programs as record-ref plans them (the Makefile's FAST_OPTS, PROG_ARGS, SRC_HC_OPTS, SRC_DEPS; HE5)
      for s in imaginary spectral real shootout gc parallel smp; do
        for p in "$root/.tmp/hsi/nofib/$s"/*/; do
          [ -f "$p/Makefile" ] || continue
          n=$(basename "$p"); mk=$p/Makefile
          main=$(nofib_main "${p%/}" "$n")
          fo=$(sed -n 's/^FAST_OPTS *= *//p' "$mk" | head -1)
          pa=$(sed -n 's/^PROG_ARGS *+\{0,1\}= *//p' "$mk" | tr '\n' ' ')
          hc=$(sed -n 's/^SRC_HC_OPTS *+\{0,1\}= *//p' "$mk" | tr '\n' ' ')
          deps=$(nofib_src_deps "$mk")
          for dpk in $deps; do hc="$hc -package $dpk"; done
          # the C nofib's make links with the program (C_SRCS: SRCS' .c and .S, the Makefile's SRCS when it sets it, less
          # EXCLUDED_SRCS; HES86 (a): record-ref's plan, nofib_c_srcs in bin/lib/hsi/records.bash; HES64 (a) took every .c)
          for cf in $(nofib_c_srcs "${p%/}"); do hc="$hc $cf"; done
          sin=-; for f in "$n.faststdin" "$n.stdin"; do [ -f "$p/$f" ] && { sin=$f; break; }; done
          args=$(echo "$pa ${fo:-}" | xargs)
          hcf=$(echo "$hc" | xargs)
          add "nofib/$s/$n" "${p%/}" "$main" "${hcf:--}" "${args:--}" "$n" "$sin" nofib
        done
      done ;;
    *) echo "hsi check: no corpus $c" >&2; exit 2 ;;
  esac
done
if [ -n "$only" ]; then
  awk -F'\037' -v o="$only" 'index(o, "," $1 ",")' "$plan" > "$plan.only"; mv "$plan.only" "$plan"
fi
[ -s "$plan" ] || { echo "hsi check: 0 programs planned (corpora: $corpora${only:+, --only}): a corpus missing under $root/.tmp/hsi, or --only matching none" >&2; exit 1; }
echo "== hsi check: $(wc -l < "$plan") programs, $jobs at a time" >&2

# HFS-I1 (a): the native front end's STG of the programs it can take (--front native), before the runs
front_why=""
front_eligible() { # SRC MAIN FLAGS KIND IFACES: the main module and its own modules (HF10-P24 (a)) on the libraries' imports alone, no Cmm main or assembly
  # queue 325: a refusal names its reason in front_why (CATEGORY DETAIL: kind, no-main, c, pragma, local, import),
  # which the run's line of the program carries as :why (the rest named: what keeps it on GHC's STG)
  local src=$1 main=$2 flags=$3 kind=$4 ifs=$5 m f hit
  front_why=""
  # (HF10-P24 (a): multimod_compile_and_run, a main file and the modules it imports, as GHC's --make compiles them)
  # (queue 422, report 346's item 8: multi_compile_and_run, a main and all.T's extra sources, as multimod's: its C files taken
  # as a program's own C, an extra Haskell source as one of its modules (found by the imports' scan below), its .cmm taken below)
  case $kind in plain|compile_and_run|multimod_compile_and_run|multi_compile_and_run|nofib) ;; *) front_why="kind $kind"; return 1 ;; esac
  [ "$main" != - ] && [ -f "$src/$main" ] || { front_why="no-main $main"; return 1; }
  # (queue 422: a Cmm main, all.T's cmm_src (T17920), is no Haskell module: refused, not read as one)
  case $main in *.cmm) front_why="c $main"; return 1 ;; esac
  # (HF10-P32: an OPTIONS or OPTIONS_GHC pragma's -cpp or -XCPP is CPP too: cgrun044, conc036, conc037 read as empty modules;
  # RULES: rewrite rules, which the front end does not apply, as GHC's -O0 does for a rule of the module's own, tcrun022)
  # (queue 369, 346's item 7: -fdefer-type-errors, on the command line or in an OPTIONS_GHC pragma, is taken: the elaborator
  # defers a type error to run time in GHC's words, typecheck.ae's defer-errors!; a typed hole still stops the front end)
  # (queue 352, 346-2 (a): a program's own C, its .c files and a .o whose .c is beside it (the run builds that .c), with -optc
  # flags, goes through the front end as the pack's program does: its C made by bin/hsi cnodes; Cmm, assembly and a .o alone
  # are still refused; queue 364: a program whose modules need foreign stubs is taken too, its stubs the front end's)
  if [ "$flags" != - ]; then for f in $flags; do case $f in
    *.o) [ -f "$src/${f%.o}.c" ] || { front_why="c $f"; return 1; } ;;
    # (queue 422, after 332's merge: a test's own .cmm read by arbace.repr.haskell.cmm and loaded by hsi run --cmm beside the
    # native STG, as beside GHC's; a Cmm main stays refused above; assembly refused)
    *.s|*.S) front_why="c $f"; return 1 ;;
    # (HF10-P59 (a): GHC's -main-is FN names Main's entry, an unqualified FN resolved in Main's scope by the front end:
    # T16453M6, T19397M2-M4; a module's name, M or M.fn, another main module, is refused)
    -main-is) case $(echo "$flags" | sed 's/.*-main-is *//; s/ .*//') in [a-z_]*) ;;
      *) front_why="main-is $(echo "$flags" | sed 's/.*-main-is *//; s/ .*//')"; return 1 ;; esac ;; esac; done; fi
  # HF10-P24 (a): the program's own modules (an import whose source is in the program's directory, M.hs or M.lhs, as GHC's
  # finder finds it on ".") are scanned as the main file is, to their imports' closure; an hs-boot file of one refuses
  # (local-boot: the front end compiles no boot file of a program yet)
  local todo=("$main") seen=" " cur txt sp d
  # the search path after "." (HF10-P59's round): all.T's -iDIR (T5462Yes2's -iGFunctor), and for nofib its mk's EXTRA_SRCS
  # (../../nofib-common, whose NofibUtils mk/boilerplate.mk compiles with every program); front_search, the plan's flags
  front_search=""
  sp=(); if [ "$flags" != - ]; then for f in $flags; do case $f in -i?*) sp+=("${f#-i}") ;; esac; done; fi
  [ "$kind" != nofib ] || [ ! -d "$src/../../nofib-common" ] || sp+=(../../nofib-common)
  for d in ${sp[@]+"${sp[@]}"}; do front_search="$front_search -i$d"; done
  while [ ${#todo[@]} -gt 0 ]; do
    cur=${todo[0]}; todo=("${todo[@]:1}")
    case $seen in *" $cur "*) continue ;; esac
    seen="$seen$cur "
    # a literate module's code (gate B1): its bird-tracked lines without the track (a \begin{code} block's lines are plain), so
    # that its imports and pragmas are scanned as the front end reads them after unlit
    txt=$src/$cur
    case $cur in *.lhs) txt=$TMPDIR/hsi-front-unbird.$BASHPID; sed 's/^>[ \t]*//' "$src/$cur" > "$txt" ;; esac
    # (HF10-P63 (a), round 52: a CPP module, its LANGUAGE CPP or OPTIONS' -cpp/-XCPP, is taken: the front end preprocesses it)
    # (queue 352, 346-2 (a) refused a foreign import "dynamic" as "wrapper"; queue 364 (report 346's item 5): typecheck.ae
    # desugars foreign exports, "wrapper", "dynamic" and capi imports as GHC does and writes their stubs (GHC's text byte for
    # byte), which the run takes (one() below): none is refused; queue 369: an OPTIONS_GHC's -fdefer-type-errors is taken too)
    hit=$(grep -oE '\{-# *RULES' "$txt" | head -1) || true
    if [ -n "$hit" ]; then
      case $hit in
        *RULES*) front_why="pragma RULES" ;; *) front_why="pragma ${hit//\"/}" ;;
      esac
      [ "$cur" = "$main" ] || front_why="$front_why (in $cur)"
      return 1
    fi
    # (hs-r5: an import only under a CPP conditional, #if .. #endif, is the front end's to decide, as GHC preprocesses before it
    # reads the imports: nofib/gc/happy's Grammar.lhs imports IOExts under #ifdef DEBUG; one not found there refuses nothing)
    local condm; condm=" $(awk '/^#[ \t]*if/ {d++} /^#[ \t]*endif/ {if (d > 0) d--} d > 0' "$txt" | sed -n 's/^import *\({-# *SOURCE *#-} *\)\?\(safe \)\?\(qualified \)\?\([A-Z][A-Za-z0-9_.]*\).*/\4/p' | sort -u | tr '\n' ' ')"
    local topm; topm=" $(awk '/^#[ \t]*if/ {d++} /^#[ \t]*endif/ {if (d > 0) d--; next} d == 0' "$txt" | sed -n 's/^import *\({-# *SOURCE *#-} *\)\?\(safe \)\?\(qualified \)\?\([A-Z][A-Za-z0-9_.]*\).*/\4/p' | sort -u | tr '\n' ' ')"
    for m in $(sed -n 's/^import *\({-# *SOURCE *#-} *\)\?\(safe \)\?\(qualified \)\?\([A-Z][A-Za-z0-9_.]*\).*/\4/p' "$txt" | sort -u); do
      # a module of the program's own first (GHC's home modules shadow the packages'), then a library's: its interface, or a
      # package's reexport of one (GHC.Prim is ghc-internal's GHC.Internal.Prim)
      if [ -f "$src/${m//.//}.hs-boot" ] || [ -f "$src/${m//.//}.lhs-boot" ]; then front_why="local-boot $m"; return 1
      elif [ -f "$src/${m//.//}.hs" ]; then todo+=("${m//.//}.hs")
      elif [ -f "$src/${m//.//}.lhs" ]; then todo+=("${m//.//}.lhs")
      elif d=$(for d in ${sp[@]+"${sp[@]}"}; do for e in hs lhs hs-boot lhs-boot; do [ -f "$src/$d/${m//.//}.$e" ] && { echo "$d/${m//.//}.$e"; break 2; }; done; done) && [ -n "$d" ]; then
        case $d in *-boot) front_why="local-boot $m"; return 1 ;; esac
        todo+=("$d")
      elif [ -f "$ifs/$m.iface.edn" ] || grep -qF "\"$m\" " "$ifs/reexports.edn"; then :
      elif [[ $condm == *" $m "* ]] && [[ $topm != *" $m "* ]]; then :
      else front_why="import $m"; [ "$cur" = "$main" ] || front_why="$front_why (in $cur)"; return 1; fi
    done
  done
}
if [ "$front" = native ]; then
  fw=$work/front; mkdir -p "$fw"
  if [ -n "$record_ifaces" ]; then
    # the oracle tier, by hand (GHC): every module the eligible programs import, the helper's closure below them, and the reexports
    "$root/bin/repr-haskell" helper >&2
    : > "$fw/mods"
    while IFS=$'\037' read -r id src main flags ropts name sin kind; do
      case $kind in plain|compile_and_run|nofib) ;; *) continue ;; esac
      [ "$main" != - ] && [ -f "$src/$main" ] || continue
      sed -n 's/^import *\(safe \)\?\(qualified \)\?\([A-Z][A-Za-z0-9_.]*\).*/\3/p' "$src/$main" >> "$fw/mods"
    done < "$plan"
    # a program's own modules are no library's: the helper finds no interface for them and goes on (its log names them)
    rm -rf "$fw/if"; mkdir -p "$fw/if"
    # shellcheck disable=SC2046
    "$helper" iface --libdir "$libdir" -o "$fw/if" --ghc -XHaskell2010 --files Prelude $(sort -u "$fw/mods") > "$fw/if.log" 2>&1 || true
    ghc-pkg field '*' exposed-modules 2> "$fw/pkg.err" | tr ',' '\n' \
      | sed -n 's/^ *\(exposed-modules: *\)\?\([A-Z][A-Za-z0-9.]*\) from [^:]*:\([A-Z][A-Za-z0-9.]*\).*/"\2" "\3"/p' | sort -u \
      | awk 'BEGIN{print "{"} {print " " $0} END{print "}"}' > "$fw/if/reexports.edn"
    echo "hsi check: $(ls "$fw/if" | grep -c '\.iface\.edn$') interfaces of $(sort -u "$fw/mods" | wc -l) imported modules" >&2
    hsi_record_ifaces "$fw/if" "bin/hsi check --front native --record-ifaces --corpus $corpora" || exit 1
    exit 0
  fi
  ifaces=$(hsi_ifaces_dir) || exit 1
  flibs=$libs
  # --libs own: the own interfaces and the own libraries' constructors; the fallback list's programs not tried (P23 (a))
  if [ "$libs_set" = own ]; then ifaces=$own_if; flibs=$own_libs; fi
  # T13688 (hs-r7): a quasi-quote's splice run on hsi by the front end (arbace.repr.haskell.front's th-expand!), over the
  # libraries the programs run on (the own set and its image under --libs own)
  th_args=()
  if [ -n "$hsi" ]; then
    if [ "$libs_set" = own ]; then th_args=(--hsi "$hsi" --hsi-libs "$own_libs" --hsi-image "$own_images")
    else th_args=(--hsi "$hsi" --hsi-libs "${libs//:/,}"); [ "$images" = none ] || th_args+=(--hsi-image "$images"); fi
  fi
  fb=$own_fallback_list
  # front_gen ID SRC GEN MAIN (queue 422, report 346's item 8; HES92 (a)'s pre_cmd on the native path): the main all.T's pre_cmd
  # `{compiler} --run ./GEN.hs` writes (unboxedsums/ManyUbxSums), made by this compiler, not GHC's: GEN through the native front
  # end over the same interfaces and run on hsi over the same libraries (as `one` runs a program, under the caps) in a copy of
  # SRC, $fw/gen/ID, whose directory then stands for SRC in the front end's plan; prints that directory, or fails (the reason in
  # front_why's form on stdout)
  front_gen() {
    local id=$1 src=$2 gen=$3 main=$4 ob=${1//\//_} g gl l la=() mem=${ARBACE_MEM_GIB:-16}
    g=$fw/gen/$ob; rm -rf "$g"; mkdir -p "$g/src"; cp -r "$src"/. "$g/src"/
    printf '%s@%s\t\n' "$g/src/$gen" "${ob}_gen" > "$g/plan.tsv"
    (export GOMEMLIMIT=${HSI_FRONT_MEM:-1536MiB}; cd "$root" && exec env ARBACE_PATH=$root "$("$root/bin/hsi" exe)" -m arbace.repr.haskell.front build \
       --ifaces "$ifaces" --libs "${flibs//:/,}" ${front_inst[@]+"${front_inst[@]}"} ${th_args[@]+"${th_args[@]}"} -o "$g/out" --plan "$g/plan.tsv") > "$g/front.log" 2>&1 || true
    gl=$(grep -E "^${ob}_gen (ok|read|rename|typecheck|typecheck-errors|stg|crash) " "$g/front.log" | head -1)
    case $gl in "${ob}_gen ok"*) ;; *) gl="$gl (not ok)" ;; esac
    [ "${gl% (not ok)}" = "$gl" ] && [ -d "$g/out/stg/${ob}_gen" ] || { echo "pre-gen $gen: the front end: ${gl:-no line}" | cut -c1-120; return 1; }
    local plibs=$libs pimages=$images
    [ "$libs_set" != own ] || { plibs=$own_libs; pimages=$own_images; }
    IFS=: read -r -a dirs <<< "$plibs"; for l in "${dirs[@]}"; do [ -d "$l" ] && la+=(--lib "$l"); done
    [ "$pimages" != none ] && la+=(--image "$pimages")
    (cd "$g/src" && env -i PATH=/usr/bin:/bin LANG=C.UTF-8 TZ=UTC HOME="$g/src" timeout -s KILL $((HSI_TIMEOUT * 3)) \
       sh -c "ulimit -v $((mem * 1048576)); export GOMEMLIMIT=$((mem * 768))MiB; ulimit -t $HSI_TIMEOUT; exec $(printf '%q ' "$hsi" run "${la[@]}" --prog "$g/out/stg/${ob}_gen" --name "${gen%.*}" --)" \
       < /dev/null > "$g/gen.stdout" 2> "$g/gen.stderr") || { echo "pre-gen $gen: its run on hsi failed ($(head -c 80 "$g/gen.stderr" | tr '\n' ' '))"; return 1; }
    [ -f "$g/src/$main" ] || { echo "pre-gen $gen: wrote no $main"; return 1; }
    echo "$g/src"
  }
  : > "$fw/plan.tsv"; : > "$fw/ineligible.tsv"
  while IFS=$'\037' read -r id src main flags ropts name sin kind; do
    if [ "$main" != - ] && [ ! -f "$src/$main" ] && gen=$(hsi_pre_gen "$id") && [ -n "$gen" ]; then
      if ! src=$(front_gen "$id" "$src" "$gen" "$main"); then printf '%s\t%s\n' "${id//\//_}" "$src" >> "$fw/ineligible.tsv"; continue; fi
    fi
    # review 1111b (finding 4): HSI_OWN_FALLBACK=try runs the listed programs on the own libraries too (a pass fails the check:
    # the list may only shrink)
    if [ "$libs_set" = own ] && [ "$own_fallback" != try ] && [ -f "$fb" ] && awk -v i="$id" '$1 == i {f = 1} END {exit !f}' "$fb"; then
      echo "${id//\//_} fallback in test/haskell/own-fallback.txt" >> "$fw/front.fallback.log"; continue
    fi
    if front_eligible "$src" "$main" "$flags" "$kind" "$ifaces"; then
      xf=""; if [ "$flags" != - ]; then for f in $flags; do case $f in -X*) xf="$xf $f" ;; esac; done; fi
      # (HF10-P59 (a): -main-is FN to the front end, which takes it out of the reader's flags)
      case " $flags " in *" -main-is "*) xf="$xf -main-is $(echo "$flags" | sed 's/.*-main-is *//; s/ .*//')" ;; esac
      # (HF10-P63 (a): CPP's flags of all.T, -cpp, -D, -U, -I (relative to the program's directory), -optP)
      # (queue 369: -fdefer-type-errors, which the elaborator reads, as an OPTIONS_GHC pragma's; hs-r5: -fdefer-typed-holes)
      if [ "$flags" != - ]; then for f in $flags; do case $f in -cpp|-D?*|-U?*|-I?*|-optP?*|-fdefer-type-errors|-fno-defer-type-errors|-fdefer-typed-holes|-fno-defer-typed-holes) xf="$xf $f" ;; esac; done; fi
      xf="$xf$front_search"
      printf '%s@%s\t%s\n' "$src/$main" "${id//\//_}" "${xf# }" >> "$fw/plan.tsv"
    else printf '%s\t%s\n' "${id//\//_}" "${front_why:-unknown}" >> "$fw/ineligible.tsv"
    fi
  done < "$plan"
  # HSI_FRONT_REUSE=DIR: an earlier run's front directory (its out/ and front.*.log), the front end run only on the programs it
  # holds no line for (a rerun of the judging after an interrupted run)
  if [ -n "${HSI_FRONT_REUSE:-}" ]; then
    mkdir -p "$fw/out"; cp -r "$HSI_FRONT_REUSE/out/." "$fw/out/"
    cat "$HSI_FRONT_REUSE"/front.*.log | grep -E '^[^ ]+ (ok|read|rename|typecheck|typecheck-errors|stg|crash) ' > "$fw/front.reused.log" || true
    awk -F'\t' 'BEGIN { while ((getline l < ARGV[2]) > 0) { split(l, w, " "); done[w[1]] = 1 }; ARGV[2] = "" }
                 { b = $1; sub(/^.*@/, "", b) } !(b in done)' "$fw/plan.tsv" "$fw/front.reused.log" > "$fw/plan.rest"
    echo "== hsi check: the front end's results of $(grep -c . "$fw/front.reused.log" || true) programs reused from $HSI_FRONT_REUSE" >&2
    mv "$fw/plan.rest" "$fw/plan.tsv"
  fi
  n=$(grep -c . "$fw/plan.tsv" || true); k=${HSI_FRONT_SHARDS:-4}
  [ -z "${HSI_FRONT_DRY:-}" ] || { echo "== hsi check: $n of $(wc -l < "$plan") programs eligible for the native front end ($fw/plan.tsv)" >&2; exit 0; }
  echo "== hsi check: the native front end on $n of $(wc -l < "$plan") programs, $k processes" >&2
  # a shard: one process for its programs; a program that gives no line for HSI_FRONT_TIMEOUT seconds (default 600: a front end
  # that loops; queue 422: 300 before, under ManyUbxSums' generated module of 1,331 functions, 342 s on the Mac VM's arm64)
  # is stopped, recorded "NAME timeout", and a fresh process takes the rest
  front_shard() { # PLAN LOG
    local pl=$1 log=$2 rest=$1.rest pid n n0 last now nm
    : > "$log"
    while [ -s "$pl" ]; do
      (export GOMEMLIMIT=${HSI_FRONT_MEM:-1536MiB}; cd "$root" && exec env ARBACE_PATH=$root "$("$root/bin/hsi" exe)" -m arbace.repr.haskell.front build \
         --ifaces "$ifaces" --libs "${flibs//:/,}" ${front_inst[@]+"${front_inst[@]}"} ${th_args[@]+"${th_args[@]}"} -o "$fw/out" --plan "$pl") >> "$log" 2>&1 &
      pid=$!; last=$(date +%s); n0=$(grep -cE '^[^ ]+ (ok|read|rename|typecheck|typecheck-errors|stg|crash|timeout) ' "$log" || true)
      while kill -0 "$pid" 2>"$TMPDIR/hsi-front-kill.err"; do
        sleep 5; now=$(date +%s)
        n=$(grep -cE '^[^ ]+ (ok|read|rename|typecheck|typecheck-errors|stg|crash|timeout) ' "$log" || true)
        if [ "$n" != "$n0" ]; then n0=$n; last=$now
        elif [ $((now - last)) -gt "${HSI_FRONT_TIMEOUT:-600}" ]; then kill "$pid" 2>"$TMPDIR/hsi-front-kill.err"; break; fi
      done
      wait "$pid" 2>"$TMPDIR/hsi-front-kill.err" || true
      awk -F'\t' 'BEGIN { while ((getline l < ARGV[2]) > 0) { split(l, w, " "); done[w[1]] = 1 }; ARGV[2] = "" }
                   { b = $1; sub(/^.*@/, "", b) } !(b in done)' "$pl" "$log" > "$rest"
      [ -s "$rest" ] || break
      # the first program without a line stopped the process (a loop, or a crash of the process itself)
      nm=$(head -1 "$rest" | cut -f1 | sed 's/^.*@//'); echo "$nm timeout no line in ${HSI_FRONT_TIMEOUT:-600} s, or the process ended" >> "$log"
      tail -n +2 "$rest" > "$pl.next"; mv "$pl.next" "$pl"
    done
    rm -f "$rest"
  }
  pids=()
  for i in $(seq 0 $((k - 1))); do
    awk -v i="$i" -v k="$k" '(NR - 1) % k == i' "$fw/plan.tsv" > "$fw/plan.$i"
    [ -s "$fw/plan.$i" ] || continue
    front_shard "$fw/plan.$i" "$fw/front.$i.log" &
    pids+=($!)
  done
  for p in ${pids[@]+"${pids[@]}"}; do wait "$p" || true; done
  cat "$fw"/front.*.log 2>"$TMPDIR/hsi-front.err" | grep -E '^[^ ]+ (ok|read|rename|typecheck|typecheck-errors|stg|crash|timeout|fallback) ' | sort > "$fw/front.txt" || true
  echo "== hsi check: the front end compiled $(grep -c '^[^ ]* ok ' "$fw/front.txt" || true) of $(grep -c . "$fw/front.txt" || true) eligible programs" >&2
  # HSI_FRONT_DRY=1: the eligible programs listed (front/plan.tsv), the front end not run, nothing run
  [ -z "${HSI_FRONT_DRY:-}" ] || exit 0
fi

# prog_key SRC MAIN FLAGS KIND: the program's key (what .tmp/hsi/progs/ID/KEY names and haskell-stg-progs's entries carry): its main
# file, its flags, and for a test of several modules its directory's sources, then the helper's identity
prog_key() {  # (a program's own C is not in it: the helper's STG is the Haskell's alone)
  local src=$1 main=$2 flags=$3 kind=$4 gen=""
  # HES92 (a): a main all.T's pre_cmd generates (hsi_pre_gen) is no source: its generator is keyed in its place
  [ -z "${5:-}" ] || gen=$(hsi_pre_gen "$5")
  { echo "$flags $kind${sfx:+ $opt}"; if [ -n "$gen" ]; then cat "$src/$gen"; else cat "$src/$main"; fi
    if [ "$kind" != plain ] && [ "$kind" != compile_and_run ]; then
      (cd "$src" && find . -type f \( -name '*.hs' -o -name '*.lhs' -o -name '*.hs-boot' -o -name '*.c' -o -name '*.h' \) ${gen:+! -path "./$main"} | LC_ALL=C sort | xargs sha256sum)
    fi; } | sha256sum | cut -c1-16 | tr -d '\n'
  printf -- '-%s\n' "${helper_hash:0:16}"
}
export -f prog_key hsi_pre_gen

# own_ref ID: "STATUS STDOUT-SHA STDERR-SHA" of the program's own verdict (test/haskell/own-verdicts.tsv: the expected status
# and the expected outputs shipped with the test, read from its directory), or nothing when it has none (the user's decision
# of 2026-11-07: a test's own verdict is a judge no toolchain made; the others are judged by GHC's recorded run). HSI_JUDGE=ref:
# every program by the record (the oracle's comparison of the two judges)
own_ref() {
  [ "${HSI_JUDGE:-}" != ref ] || return 0
  local id=$1 line ex so se d e
  line=$(awk -F'\t' -v i="$id" '$1 == i' "$root/test/haskell/own-verdicts.tsv")
  # HF10-P35 (a): a testsuite-core test GHC's record does not have yet (own-verdicts-pending.tsv): its shipped files compared
  # as the testsuite driver compares them (modify_lines' join: the last line's newline not compared), each given one
  local pending=""
  [ -n "$line" ] || { line=$(awk -F'\t' -v i="$id" '$1 == i' "$root/test/haskell/own-verdicts-pending.tsv"); pending=1; }
  [ -n "$line" ] || return 0
  IFS=$'\t' read -r _ ex so se <<< "$line"
  case $so in
    # queue 435: a testsuite or nofib program's reviewed golden file (test/haskell/eval/golden/ID.stdout, .stderr), at -O0 as
    # the samples' (bin/hsi golden reviews them, bin/hsi own-verdicts lists them when GHC's recorded -O0 run agrees)
    golden:*) [ -z "${sfx:-}" ] || return 0
      d=$root/test/haskell/eval/golden/$(dirname "$id"); so=${so#golden:}; se=${se#golden:} ;;
    *)
  case $id in
    testsuite/*) d=$root/.tmp/hsi/ghc-9.14.1/testsuite/tests/$(dirname "${id#testsuite/}") ;;
    nofib/*) d=$root/.tmp/hsi/nofib/${id#nofib/} ;;
    # queue 325g, DECISION 2 (a): Arbace's samples and the synthetic corpus by their reviewed golden files (NAME.stdout,
    # NAME.stderr, NAME.exit beside the program; the synthetic corpus's written by gen.ae), at -O0: at -O1 GHC's optimiser's
    # choices are -O1's record's (five synthetic programs print otherwise at -O1, ref-ghc914-O1.edn)
    samples/*|synthetic/*) [ -z "${sfx:-}" ] || return 0; d=$root/test/haskell/eval/${id%%/*} ;;
    *) return 0 ;;
  esac ;;
  esac
  e=$(printf '' | sha256sum | cut -c1-64)
  # D435-2 (a): "ignore", all.T's ignore_stdout: no digest, the check does not compare the stdout (ign). D-HSJ-2 (a): boot:NAME, the
  # digest test/haskell/eval/boot.edn keeps of the output the program's boot.sh makes (Arbace made it: bin/hsi boot)
  local sod=""
  case $so in
    ignore) sod=ignore ;;
    boot:*) sod=$(grep -F " \"$id\" {" "$root/test/haskell/eval/boot.edn" | sed -n 's/.* :stdout "\([0-9a-f]*\)".*/\1/p'); [ -n "$sod" ] || return 0 ;;
  esac
  if [ -n "$pending" ]; then
    # (an expected stdout of "-": none shipped, an empty one, as for stderr; gate B1's unpack_sums_3)
    echo "$ex $(if [ "$so" = - ]; then echo "$e"; elif [ -n "$sod" ]; then echo "$sod"; else awk 1 "$d/$so" | sha256sum | cut -c1-64; fi) $(if [ "$se" = - ]; then echo "$e"; else awk 1 "$d/$se" | sha256sum | cut -c1-64; fi) pending"
  else
    echo "$ex $(if [ "$so" = - ]; then echo "$e"; elif [ -n "$sod" ]; then echo "$sod"; else sha256sum < "$d/$so" | cut -c1-64; fi) $(if [ "$se" = - ]; then echo "$e"; else sha256sum < "$d/$se" | cut -c1-64; fi)"
  fi
}
export -f own_ref
# queue 325g, DECISION 5 (a) (the user, 2026-11-17): on an arm64 host (uname -m; HSI_REF_ARCH=arm64|amd64 says it), at -O0,
# a program test/haskell/ref-ghc914-arm64.edn records (GHC 9.14.1's run on linux/arm64, bin/hsi record-ref on such a host:
# the programs whose result is the machine's, test/haskell/arm64-ref.txt) is judged by that run, before its own verdict and
# the amd64 record; its result says :ref :arm64. The amd64 records and the golden files are amd64's and stay so.
arch_ref=""
case ${HSI_REF_ARCH:-$(uname -m)} in
  aarch64|arm64) [ -n "${sfx:-}" ] || [ "${HSI_JUDGE:-}" = ref ] || arch_ref=$root/test/haskell/ref-ghc914-arm64.edn ;;
esac
[ -z "$arch_ref" ] || [ -f "$arch_ref" ] || arch_ref=""
export arch_ref
arch_ref_line() { grep -F "{:id \"$1\" " "$arch_ref" || true; }
export -f arch_ref_line
# oracle_pending ID: success when the program waits for GHC's records at the oracle window (own-verdicts-pending.tsv)
oracle_pending() { awk -F'\t' -v i="$1" '$1 == i {f = 1} END {exit !f}' "$root/test/haskell/own-verdicts-pending.tsv"; }
export -f oracle_pending

# ignore_stdout ID: success when all.T gives the test ignore_stdout unconditionally (HES90): the testsuite driver does not
# compare its stdout, so neither does the judge (status and stderr still are); test/haskell/eval/testsuite-run.edn's
# :ignore-stdout, made by test/haskell/eval/allt.ae
ignore_stdout() {
  case $1 in testsuite/*) ;; *) return 1 ;; esac
  local id=${1#testsuite/} dir name
  dir=${id%/*}; name=${id##*/}
  grep -F ":dir \"$dir\", :name \"$name\"," "$root/test/haskell/eval/testsuite-run.edn" | grep -q ':ignore-stdout true'

#!/bin/bash
# bin/hsi compare-front [--aot] [NATIVE [GHC]] (HFS-I1 (a), doc/haskell/FRONTEND-SURVEY.md, "As built: HFS-I1 (a)"): hsi check's
# results with the programs' STG from the native front end (bin/hsi check --front native: NATIVE, default the last run's
# .tmp/hsi/check-native/results.edn, else test/haskell/check-hsi-native.edn) against the results from GHC's STG (GHC, default the
# record test/haskell/check-hsi.edn), program by program over the programs both hold: both pass, a pass lost (GHC's STG passes,
# the native run does not), a pass gained, both fail; the native run's sources (:stg :native, :stg :ghc with the front end's
# stage). Fails when a program run from native STG lost a pass: the switch's condition (default_front=native in bin/lib/hsi/check).
# --aot: the AOT level's (check-aot-native, check-hsi-aot.edn).
set -euo pipefail
root=$(cd "$(dirname "$0")/../../.." && pwd)
. "$root/bin/lib/tmpdir.bash"
aot=""; [ "${1:-}" = --aot ] && { aot=-aot; shift; }
nat=${1:-}
if [ -z "$nat" ]; then
  nat=$root/.tmp/hsi/check$aot-native/results.edn
  [ -f "$nat" ] || nat=$root/test/haskell/check-hsi$aot-native.edn
fi
ghc=${2:-$root/test/haskell/check-hsi$aot.edn}
[ -f "$nat" ] && [ -f "$ghc" ] || { echo "compare-front: no $nat or $ghc" >&2; exit 2; }
awk '
  function field(l, k,   r) { r = l; if (!sub(".*" k " :", "", r)) return ""; sub(/[ }].*/, "", r); return r }
  function idof(l,   r) { r = l; sub(/^\{:id "/, "", r); sub(/".*/, "", r); return r }
  FNR == 1 { f++ }
  !/^\{/ { next }
  f == 1 { i = idof($0); nr[i] = field($0, ":result"); ns[i] = field($0, ":stg"); nf[i] = field($0, ":front"); next }
  f == 2 { i = idof($0); gr[i] = field($0, ":result") }
  END {
    for (i in nr) {
      src = (ns[i] == "native") ? "native" : ("ghc" (nf[i] != "" ? "/" nf[i] : ""))
      srcs[src]++
      if (!(i in gr)) { only++; continue }
      both++
      p1 = (gr[i] == "pass"); p2 = (nr[i] == "pass")
      if (p1 && p2) { k = "both pass" } else if (p1) { k = "LOST"; if (ns[i] == "native") lost++ } else if (p2) { k = "gained" } else { k = "both fail" }
      cls[k " (" (ns[i] == "native" ? "native" : "ghc") ")"]++
      if (k == "LOST" || k == "gained") printf "%s %s: ghc %s, native run %s (%s)\n", k, i, gr[i], nr[i], src
    }
    printf "compare-front: %d programs in both (%d only in the native run)\n", both, only
    for (k in cls) printf "  %-22s %d\n", k, cls[k]
    printf "compare-front: the native run'"'"'s sources:"; for (s in srcs) printf " %s %d", s, srcs[s]; printf "\n"
    if (lost > 0) { printf "compare-front: %d passes lost from native STG: not yet the default\n", lost; exit 1 }
    print "compare-front: no pass lost from native STG"
  }' "$nat" "$ghc"

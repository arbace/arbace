#!/bin/bash
# bin/hsi generate [--check]: the synthetic corpus (doc/haskell/HASKELL-EVAL-SURVEY.md §8.3) written by its generator
# test/haskell/eval/gen.ae from GHC 9.14.1's primops.txt.pp (the pinned source tarball's, through cpp as hadrian
# makes primops.txt: bin/repr-haskell genprimopcode) into test/haskell/eval/synthetic/; --check: written into .tmp
# and compared with the committed files, byte for byte. Seconds.
set -euo pipefail
root=$(cd "$(dirname "$0")/../../.." && pwd)
. "$root/bin/lib/tmpdir.bash"
read -r _ primops <<< "$("$root/bin/repr-haskell" genprimopcode | tail -1)"
exe=$("$root/bin/hsi" exe)
out=$root/test/haskell/eval/synthetic
if [ "${1:-}" = --check ]; then
  t=$root/.tmp/hsi/synthetic-check
  rm -rf "$t"
  ARBACE_PATH=$root "$exe" "$root/test/haskell/eval/gen.ae" "$primops" "$t"
  if diff -r "$out" "$t" > "$t.diff"; then echo "hsi generate: the committed synthetic corpus is the generator's"
  else echo "hsi generate: test/haskell/eval/synthetic differs from the generator's output ($t.diff)" >&2; exit 1; fi
else
  ARBACE_PATH=$root "$exe" "$root/test/haskell/eval/gen.ae" "$primops" "$out"
fi

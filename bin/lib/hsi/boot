#!/bin/bash
# bin/hsi boot [ID...]: D-HSJ-2 (a) (the main session, 2026-11-20; hs-judge-1120): the expected outputs of test/haskell/eval/boot.edn
# remade as each program's nofib boot.sh makes them, by Arbace: the shipped generator's C run by ci (bin/ci run FILE -- ARGS),
# its output through tr -d '\r' as boot.sh pipes it, then its SHA-256 and size against the entry's (a difference fails). By hand
# (fasta: about 10 s and 0.9 GB); bin/hsi own-verdicts and bin/lib/hsi/check's own_ref read the kept digest. Outputs in
# .tmp/hsi/boot/ID/ (the made file kept for a reader).
set -euo pipefail
root=$(cd "$(dirname "$0")/../../.." && pwd)
. "$root/bin/lib/tmpdir.bash"
rec=$root/test/haskell/eval/boot.edn nofib=$root/.tmp/hsi/nofib
[ -d "$nofib" ] || "$root/bin/hsi" pins --fetch nofib >&2
ids=("$@")
[ ${#ids[@]} -gt 0 ] || mapfile -t ids < <(sed -n 's/^ "\([^"]*\)" {.*/\1/p' "$rec")
st=0
for id in "${ids[@]}"; do
  bl=$(grep -F " \"$id\" {" "$rec" || true); [ -n "$bl" ] || { echo "hsi boot: $id: no entry in ${rec#"$root"/}"; st=1; continue; }
  c=$(sed -n 's/.*[{ ]:c "\([^"]*\)".*/\1/p' <<< "$bl")
  args=$(sed -n 's/.* :args \[\([^]]*\)\].*/\1/p' <<< "$bl" | tr -d '"')
  sha=$(sed -n 's/.* :stdout "\([0-9a-f]*\)".*/\1/p' <<< "$bl"); bytes=$(sed -n 's/.* :bytes \([0-9]*\).*/\1/p' <<< "$bl")
  w=$root/.tmp/hsi/boot/$id; rm -rf "$w"; mkdir -p "$w"
  cp "$nofib/${id#nofib/}/$c" "$w/"
  # shellcheck disable=SC2086
  (cd "$w" && "$root/bin/ci" run "$c" -- $args 2> run.log | tr -d '\r' > out.stdout) || { echo "hsi boot: $id: ci failed ($w/run.log)"; st=1; continue; }
  msha=$(sha256sum < "$w/out.stdout" | cut -c1-64); mbytes=$(wc -c < "$w/out.stdout")
  if [ "$msha" = "$sha" ] && [ "$mbytes" = "$bytes" ]; then
    echo "hsi boot: $id: $c $args on ci: $mbytes bytes, sha256 ${msha:0:16}, the kept digest"
  else
    echo "hsi boot: $id: $c $args on ci: $mbytes bytes, sha256 ${msha:0:16}; the kept ${bytes} bytes, ${sha:0:16}: DIFFERS"; st=1
  fi
done
exit $st

#!/bin/bash
# bin/hsi divergences [--results FILE] [--programs]: hsi check's recorded results (default test/haskell/check-hsi.edn) judged
# against test/haskell/divergences.edn with no run (HE6; test/haskell/eval/divergences.ae): each non-pass in a class, its
# result of a kind the class allows, a summary by class; fails on a non-pass in no class or of another kind.
# bin/hsi slice K [--results FILE] [--slices N]: the ids of the recorded programs in rotation slice K of N (default 7;
# GTS203 (a): a program's slice is the first 8 hex digits of its id's SHA-256 mod N, a function of the name alone), one a line.
set -euo pipefail
root=$(cd "$(dirname "$0")/../../.." && pwd)
. "$root/bin/lib/tmpdir.bash"
verb=$1; shift
results=$root/test/haskell/check-hsi.edn programs="" slices=7 k=""
[ "$verb" = slice ] && { k=${1:?usage: bin/hsi slice K [--results FILE] [--slices N]}; shift; }
while [ $# -gt 0 ]; do
  case $1 in
    --results) results=$2; shift 2 ;;
    --programs) programs=--programs; shift ;;
    --slices) slices=$2; shift 2 ;;
    *) echo "usage: bin/hsi divergences [--results FILE] [--programs] | slice K [--results FILE] [--slices N]" >&2; exit 2 ;;
  esac
done
exe=$("$root/bin/hsi" exe)
case $verb in
  divergences)
    ARBACE_PATH=$root "$exe" "$root/test/haskell/eval/divergences.ae" "$results" "$root/test/haskell/divergences.edn" $programs ;;
  slice)
    grep '^{' "$results" | sed 's/^{:id "\([^"]*\)".*/\1/' | while IFS= read -r id; do
      h=$(printf '%s' "$id" | sha256sum | cut -c1-8)
      [ $(( 16#$h % slices )) = "$k" ] && echo "$id" || true
    done ;;
esac

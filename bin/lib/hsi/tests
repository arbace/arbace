#!/bin/bash
# bin/hsi tests [--out DIR]: GHC 9.14.1's testsuite's all.T files read (test/haskell/eval/allt.ae, HES17 (a)), every
# test into DIR/tests.edn (default .tmp/hsi), the run tests (compile_and_run, multimod_compile_and_run,
# multi_compile_and_run) into test/haskell/eval/testsuite-run.edn and the counts into
# test/haskell/eval/testsuite-summary.edn (committed: record-ref's plan and the corpora's counts). The testsuite is
# fetched by its pin first (bin/hsi pins --fetch). Seconds (about 15 on stage 0).
set -euo pipefail
root=$(cd "$(dirname "$0")/../../.." && pwd)
. "$root/bin/lib/tmpdir.bash"
out=$root/.tmp/hsi
[ "${1:-}" = --out ] && out=$2
"$root/bin/hsi" pins --fetch > "$TMPDIR/hsi-tests-fetch.log"
ARBACE_PATH=$root "$("$root/bin/hsi" exe)" "$root/test/haskell/eval/allt.ae" "$root/.tmp/hsi/ghc-9.14.1/testsuite/tests" \
  "$out/tests.edn" "$out/tests-summary.edn"
{ sed -n '/^;;/p' "$out/tests.edn" | sed 's/^;; GHC 9.14.1.s testsuite.s tests,/;; GHC 9.14.1'"'"'s testsuite'"'"'s run tests (compile_and_run, multimod_compile_and_run, multi_compile_and_run),/'
  grep -E ':func (compile_and_run|multimod_compile_and_run|multi_compile_and_run)[,}]' "$out/tests.edn"; } \
  > "$root/test/haskell/eval/testsuite-run.edn"
{ echo ";; GHC 9.14.1's testsuite's all.T files read by test/haskell/eval/allt.ae (bin/hsi tests): the counts"
  cat "$out/tests-summary.edn"; } > "$root/test/haskell/eval/testsuite-summary.edn"
echo "hsi tests: $(grep -c '^{' "$root/test/haskell/eval/testsuite-run.edn") run tests in test/haskell/eval/testsuite-run.edn"

#!/bin/bash
# One job of bin/repr-haskell's tree_jobs: HELPER MODE LIBDIR JOB, JOB the fields SRC OUT FLAGSFILE
# FILES separated by US (\x1f): the helper's trees (hsdump tree MODE) of FILES, from inside SRC,
# into OUT, under the GHC flags in FLAGSFILE (word-split, as the corpus writes them); the
# helper's messages appended to OUT.err
helper=$1 mode=$2 libdir=$3
IFS=$'\x1f' read -r src out ff fs <<< "$4"
mkdir -p "$out"
cd "$src" || exit 0
# shellcheck disable=SC2046,SC2086
IFS=$' \t\n' "$helper" tree $mode -o "$out" --libdir "$libdir" --ghc $(cat "$ff") --files $fs 2>> "$out.err"
exit 0

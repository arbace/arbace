#!/bin/bash
# repr/haskell's own cases (bin/repr-haskell test; doc/haskell/HASKELL-NOTES.md, "Checks"):
#   1. the reader's samples (test/haskell/reader-samples.txt, SPEC Appendix A, E1): read again by
#      test/haskell/reader_samples.ae, the same as test/haskell/reader-samples.out;
#   2. the worked example (SPEC Appendix B): test/haskell/sample/Shape.hs dumped by the helper and
#      converted, the same forms as the spec's hand-written test/haskell/sample/Shape.ae (as data,
#      its :config the keys the spec writes), and at the same lines;
#   3. its round trip: printed (braces layout), parsed by GHC to the same tree and lines;
#   4. the interface level (SPEC §9.3): test/haskell/iface/'s module and its braces copy (columns
#      moved) equal under mode :lines's normalizations, not under :full, a changed value
#      differing; the worked example's original and printed module, compiled, equal;
#   5. mode :full (SPEC §7.2, the text level): the worked example dumped with --full, converted
#      and printed in the full layout, byte for byte the original; the same forms with a name
#      changed (area to size, as long) print the original with that name changed (the text is
#      printed from the forms, at their positions); test/haskell/full/Space.hs (tabs, a CRLF,
#      trailing blanks, a form feed, explicit braces and semicolons, literals' and pragmas'
#      spellings, Unicode syntax, a string gap, no final newline) printed back byte for byte;
#   6. the layout layout (SPEC §7.4, 2; R4): the worked example and test/haskell/layout/Layout.hs
#      (blocks closed by a line, by a token GHC's parse-error(t) rule takes, braced after the fact,
#      explicit braces kept) converted and printed by the layout rule, byte for byte the texts
#      test/haskell/layout/expected/ holds (the style), parsed by GHC to the same trees and lines;
#      the worked example's printed module compiled to an interface equal to the original's.
# Usage: bin/lib/repr-haskell/test (from bin/repr-haskell test). Scratch in .tmp/repr-haskell/test.
set -euo pipefail
root=$(cd "$(dirname "$0")/../../.." && pwd)
. "$root/bin/lib/tools.bash"
"$root/bin/repr-haskell" helper
helper=$root/.tmp/hsdump/hsdump
libdir=$(ghc --print-libdir)
work=$root/.tmp/repr-haskell/test
rm -rf "$work"; mkdir -p "$work"
fail=0

echo "== 1. the reader's samples (test/haskell/reader-samples.txt)"
(cd "$root" && arbace_tool test/haskell/reader_samples.ae test/haskell/reader-samples.txt) > "$work/reader-samples.out" 2>&1
if diff -u "$root/test/haskell/reader-samples.out" "$work/reader-samples.out" > "$work/reader-samples.diff"; then
  echo "ok: $(grep -c '=>\|!!' "$work/reader-samples.out") samples read as recorded"
else
  echo "FAIL: the reader's samples differ ($work/reader-samples.diff)"; fail=1
fi

echo "== 2. the worked example converted (test/haskell/sample/Shape.hs)"
(cd "$root/test/haskell/sample" && "$helper" dump -o "$work/dumps" --libdir "$libdir" --ghc -haddock --files Shape.hs)
(cd "$root" && arbace_tool -m arbace.repr.haskell read -o "$work/forms" "$work/dumps/Shape.hs.edn") > "$work/read.log"
(cd "$root" && arbace_tool -e '
(let [rd (fn [f] (let [r (arbace.lang.LineNumberingPushbackReader. (java.io.StringReader. (slurp f)))]
                   (loop [acc []] (let [x (read {:eof ::e} r)] (if (= x ::e) acc (recur (conj acc x)))))))
      spec (rd "test/haskell/sample/Shape.ae")
      conv (rd "'"$work"'/forms/hs/Data/Shape.ae")
      ;; the spec writes :config with fewer keys
      trim (fn [f] (if (and (seq? f) (= (quote hs/module) (first f)))
                     (let [v (vec f) i (.indexOf v :config) c (get v (inc i))]
                       (with-meta (apply list (assoc v (inc i) (select-keys c (keys (get (vec (first (filter #(and (seq? %) (= (quote hs/module) (first %))) spec))) (inc i))))))
                                  (meta f)))
                     f))
      conv (mapv trim conv)
      bad (remove (fn [[a b]] (and (= a b) (= (:line (meta a)) (:line (meta b))))) (map vector spec conv))]
  (doseq [[a b] bad] (println "spec:     " (:line (meta a)) (pr-str a)) (println "converted:" (:line (meta b)) (pr-str b)))
  (if (and (empty? bad) (= (count spec) (count conv)))
    (println "ok:" (count conv) "forms, as the spec writes them, at the same lines")
    (do (println "FAIL: the converted forms differ from the spec'"'"'s") (System/exit 1))))') || fail=1

echo "== 3. the worked example's round trip"
(cd "$root" && arbace_tool -m arbace.repr.haskell print -o "$work/printed" "$work/forms/hs/Data/Shape.ae") > "$work/print.log"
(cd "$root/test/haskell/sample" && "$helper" tree -o "$work/orig" --libdir "$libdir" --ghc -haddock --files Shape.hs)
(cd "$work/printed" && "$helper" tree -o "$work/cand" --libdir "$libdir" --ghc -haddock --files Shape.hs)
if cmp -s "$work/orig/Shape.hs.tree" "$work/cand/Shape.hs.tree" && cmp -s "$work/orig/Shape.hs.lines" "$work/cand/Shape.hs.lines"; then
  echo "ok: the printed module parses to the same tree and lines ($(wc -l < "$work/orig/Shape.hs.lines") located nodes)"
else
  echo "FAIL: the printed module ($work/printed/Shape.hs) parses to another tree or other lines"; fail=1
fi

echo "== 4. the interface level's normalizations (test/haskell/iface/, SPEC §9.3)"
# each N.hs compiled from inside its directory (the same relative path), ghc --show-iface of its
# interface; same: layout/ and braces/ under mode :lines, not under :full (the ABI hash, an
# unfolding's span and a SrcLoc's columns differ); changed/ differs from layout/ under :lines
for d in layout braces changed; do
  (cd "$root/test/haskell/iface/$d" && ghc -O1 -haddock -c N.hs -outputdir "$work/iface/$d" > /dev/null &&
     ghc --show-iface "$work/iface/$d/N.hi" > "$work/iface/$d.iface") || { echo "FAIL: $d/N.hs did not compile"; fail=1; }
done
# the worked example: the original and its printed module (step 3), compiled the same way
(cd "$root/test/haskell/sample" && ghc -O1 -haddock -c Shape.hs -outputdir "$work/iface/shape-orig" > /dev/null &&
   ghc --show-iface "$work/iface/shape-orig/Data/Shape.hi" > "$work/iface/shape-orig.iface") || fail=1
(cd "$work/printed" && ghc -O1 -haddock -c Shape.hs -outputdir "$work/iface/shape-cand" > /dev/null &&
   ghc --show-iface "$work/iface/shape-cand/Data/Shape.hi" > "$work/iface/shape-cand.iface") || fail=1
(cd "$root" && arbace_tool -e '
(require (quote arbace.repr.haskell))
(let [w "'"$work"'/iface/"
      same? (fn [a b mode] (let [n #(arbace.repr.haskell/normalize-iface (slurp (str w % ".iface")) mode)]
                             (= (arbace.repr.haskell/iface-units (n a) mode) (arbace.repr.haskell/iface-units (n b) mode))))
      cases [["layout" "braces" :lines true] ["layout" "braces" :full false]
             ["layout" "changed" :lines false] ["shape-orig" "shape-cand" :lines true]]
      bad (remove (fn [[a b mode want]] (= want (same? a b mode))) cases)]
  (doseq [[a b mode want] bad] (println "FAIL:" a b mode (if want "differ" "are equal")))
  (if (empty? bad)
    (println "ok:" (count cases) "interface comparisons as expected (braces equal under :lines, not :full; a changed value differs; the worked example equal)")
    (System/exit 1)))') || fail=1

echo "== 5. mode :full: the worked example printed back byte for byte (SPEC §7.2, §9.1)"
(cd "$root/test/haskell/sample" && "$helper" dump --full -o "$work/dumps-full" --libdir "$libdir" --ghc -haddock --files Shape.hs)
(cd "$root" && arbace_tool -m arbace.repr.haskell read -o "$work/forms-full" "$work/dumps-full/Shape.hs.edn") > "$work/read-full.log" || fail=1
(cd "$root" && arbace_tool -m arbace.repr.haskell print -o "$work/printed-full" "$work/forms-full/hs/Data/Shape.ae") > "$work/print-full.log" || fail=1
mkdir -p "$work/renamed/hs/Data" "$work/printed-renamed"
sed 's/\<area\>/size/g' "$work/forms-full/hs/Data/Shape.ae" > "$work/renamed/hs/Data/Shape.ae"
sed 's/\<area\>/size/g' "$root/test/haskell/sample/Shape.hs" > "$work/renamed/Shape.hs"
(cd "$root" && arbace_tool -m arbace.repr.haskell print -o "$work/printed-renamed" "$work/renamed/hs/Data/Shape.ae") > "$work/print-renamed.log" || fail=1
if cmp -s "$root/test/haskell/sample/Shape.hs" "$work/printed-full/Shape.hs" &&
   cmp -s "$work/renamed/Shape.hs" "$work/printed-renamed/Shape.hs" &&
   ! cmp -s "$work/renamed/Shape.hs" "$root/test/haskell/sample/Shape.hs"; then
  echo "ok: printed byte for byte ($(wc -c < "$work/printed-full/Shape.hs") bytes), and with a name changed in its forms"
else
  echo "FAIL: mode :full does not print the worked example back ($work/printed-full/Shape.hs, $work/printed-renamed/Shape.hs)"; fail=1
fi
(cd "$root/test/haskell/full" && "$helper" dump --full -o "$work/dumps-full" --libdir "$libdir" --ghc -haddock --files Space.hs)
(cd "$root" && arbace_tool -m arbace.repr.haskell read -o "$work/forms-full" "$work/dumps-full/Space.hs.edn") >> "$work/read-full.log" || fail=1
(cd "$root" && arbace_tool -m arbace.repr.haskell print -o "$work/printed-full" "$work/forms-full/hs/Space.ae") >> "$work/print-full.log" || fail=1
if cmp -s "$root/test/haskell/full/Space.hs" "$work/printed-full/Space.hs"; then
  echo "ok: test/haskell/full/Space.hs printed byte for byte ($(wc -c < "$work/printed-full/Space.hs") bytes)"
else
  echo "FAIL: mode :full does not print test/haskell/full/Space.hs back ($work/printed-full/Space.hs)"; fail=1
fi
echo "== 6. the layout layout (SPEC §7.4, 2)"
mkdir -p "$work/layout"
(cd "$root/test/haskell/layout" && "$helper" dump -o "$work/dumps" --libdir "$libdir" --ghc -haddock --files Layout.hs)
(cd "$root" && arbace_tool -m arbace.repr.haskell read -o "$work/forms" "$work/dumps/Layout.hs.edn") >> "$work/read.log" || fail=1
(cd "$root" && arbace_tool -m arbace.repr.haskell print --layout layout -o "$work/layout" "$work/forms/hs/Data/Shape.ae" "$work/forms/hs/Layout.ae") > "$work/print-layout.log" || fail=1
(cd "$root/test/haskell/layout" && "$helper" tree -o "$work/orig" --libdir "$libdir" --ghc -haddock --files Layout.hs)
(cd "$work/layout" && "$helper" tree -o "$work/cand-layout" --libdir "$libdir" --ghc -haddock --files Shape.hs Layout.hs)
for f in Shape Layout; do
  if ! cmp -s "$root/test/haskell/layout/expected/$f.hs" "$work/layout/$f.hs"; then
    echo "FAIL: $f.hs printed in the layout layout differs from test/haskell/layout/expected/$f.hs ($work/layout/$f.hs)"; fail=1
  elif ! cmp -s "$work/orig/$f.hs.tree" "$work/cand-layout/$f.hs.tree" || ! cmp -s "$work/orig/$f.hs.lines" "$work/cand-layout/$f.hs.lines"; then
    echo "FAIL: $f.hs printed in the layout layout parses to another tree or other lines ($work/layout/$f.hs)"; fail=1
  else
    echo "ok: $f.hs printed in the layout layout as expected, the same tree and lines ($(wc -l < "$work/orig/$f.hs.lines") located nodes)"
  fi
done
(cd "$work/layout" && ghc -O1 -haddock -c Shape.hs -outputdir "$work/iface/shape-layout" > /dev/null &&
   ghc --show-iface "$work/iface/shape-layout/Data/Shape.hi" > "$work/iface/shape-layout.iface") || fail=1
(cd "$root" && arbace_tool -e '
(require (quote arbace.repr.haskell))
(let [n #(arbace.repr.haskell/normalize-iface (slurp (str "'"$work"'/iface/" % ".iface")) :lines)]
  (if (= (arbace.repr.haskell/iface-units (n "shape-orig") :lines) (arbace.repr.haskell/iface-units (n "shape-layout") :lines))
    (println "ok: the worked example printed in the layout layout compiles to an equal interface")
    (do (println "FAIL: the worked example printed in the layout layout compiles to another interface") (System/exit 1))))') || fail=1
exit $fail

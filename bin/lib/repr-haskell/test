#!/bin/bash
# repr/haskell's own cases (bin/repr-haskell test; doc/haskell/HASKELL-NOTES.md, "Checks"):
#   1. the reader's samples (test/haskell/reader-samples.txt, SPEC Appendix A, E1): read again by
#      test/haskell/reader_samples.ae, the same as test/haskell/reader-samples.out;
#   2. the worked example (SPEC Appendix B): test/haskell/sample/Shape.hs dumped by the helper and
#      converted, the same forms as the spec's hand-written test/haskell/sample/Shape.ae (as data,
#      its :config the keys the spec writes), and at the same lines;
#   3. its round trip: printed (braces layout), parsed by GHC to the same tree and lines;
#   4. the interface level (SPEC §9.3): test/haskell/iface/'s module and its braces copy (columns
#      moved) equal under mode :lines's normalizations, not under :full, a changed value
#      differing; the worked example's original and printed module, compiled, equal;
#   5. mode :full (SPEC §7.2, the text level): the worked example dumped with --full, converted
#      and printed in the full layout, byte for byte the original; the same forms with a name
#      changed (area to size, as long) print the original with that name changed (the text is
#      printed from the forms, at their positions); test/haskell/full/Space.hs (tabs, a CRLF,
#      trailing blanks, a form feed, explicit braces and semicolons, literals' and pragmas'
#      spellings, Unicode syntax, a string gap, no final newline) printed back byte for byte;
#   6. the layout layout (SPEC §7.4, 2; R4): the worked example and test/haskell/layout/Layout.hs
#      (blocks closed by a line, by a token GHC's parse-error(t) rule takes, braced after the fact,
#      explicit braces kept) converted and printed by the layout rule, byte for byte the texts
#      test/haskell/layout/expected/ holds (the style), parsed by GHC to the same trees and lines;
#      the worked example's printed module compiled to an interface equal to the original's;
#   7. R5's cases (test/haskell/r5/): Cases.hs (an operator ending a CPP line in \\, ?~, the
#      variable quote applied, a respelled operator beginning a line, a constructor's
#      documentation after its |, a class's context on its own lines, a DEPRECATED pragma on its
#      own line, a GADT's forall on a later line, documentation before the LANGUAGE pragma) and
#      Incl.hs (its text another file's, Incl/Body.hs, a CPP inclusion, then its own again)
#      converted, printed in the braces and the layout layouts, parsed by GHC to the same trees
#      and lines; Incl's forms name the other file (:hs/file);
#   8. R6's cases (test/haskell/r6/, copied into the scratch: the helper writes hsc2hs's output
#      beside the .hsc): a Backpack signature (Str.hsig), a boot file (Boot.hs-boot, with Boot.hs
#      and User.hs, which imports it {-# SOURCE #-}), two literate modules (Bird.lhs: bird tracks,
#      a #! line, prose with a tab and trailing blanks; Latex.lhs: \begin{code} blocks), an .hsc
#      module (Codes.hsc: an #{enum} that makes more lines than it takes, so that GHC's positions
#      repeat, #{size}, #if), two generated modules (HR25: Alex.hs, AlexCpp.hs through CPP, whose
#      {-# LINE #-} pragmas name their alex sources) converted, printed in the braces and the layout layouts and parsed by
#      GHC to the same trees and lines; in mode :full printed back byte for byte (the .lhs, the
#      .hsig, the .hs-boot themselves, the .hsc's hsc2hs output's module view) with the same trees
#      of mode :full; and compiled to interfaces equal to the originals' (the signature's .hi, the
#      boot file's .hi-boot).
#   9. HR26's opt-in (test/haskell/hr26/AlexDir.hs: a {-# LINE #-} pragma into AlexDir.x, then an
#      #include, after which CPP's line marker names the module's own lines): in mode :full printed
#      back byte for byte to its module view, whose trees of mode :full differ from the original's
#      (the known difference of HR25); with the helper's --view-markers the module view gets the
#      marker as a pragma (:cpp's :view-markers), printed back byte for byte with the same trees and
#      lines of mode :full; the forms of mode :lines are unchanged by the option.
# Usage: bin/lib/repr-haskell/test (from bin/repr-haskell test). Scratch in .tmp/repr-haskell/test.
set -euo pipefail
root=$(cd "$(dirname "$0")/../../.." && pwd)
. "$root/bin/lib/tools.bash"
"$root/bin/repr-haskell" helper
helper=$root/.tmp/hsdump/hsdump
libdir=$(ghc --print-libdir)
work=$root/.tmp/repr-haskell/test
rm -rf "$work"; mkdir -p "$work"
fail=0
# the tools' host first, so that stage 0's build messages (after the seed changed) are not in an
# output compared below
. "$root/bin/lib/host.bash"
arbace_host_exe > "$work/host-exe.txt" || exit 1

echo "== 1. the reader's samples (test/haskell/reader-samples.txt)"
(cd "$root" && arbace_tool test/haskell/reader_samples.ae test/haskell/reader-samples.txt) > "$work/reader-samples.out" 2>&1
if diff -u "$root/test/haskell/reader-samples.out" "$work/reader-samples.out" > "$work/reader-samples.diff"; then
  echo "ok: $(grep -c '=>\|!!' "$work/reader-samples.out") samples read as recorded"
else
  echo "FAIL: the reader's samples differ ($work/reader-samples.diff)"; fail=1
fi

echo "== 2. the worked example converted (test/haskell/sample/Shape.hs)"
(cd "$root/test/haskell/sample" && "$helper" dump -o "$work/dumps" --libdir "$libdir" --ghc -haddock --files Shape.hs)
(cd "$root" && arbace_tool -m arbace.repr.haskell read -o "$work/forms" "$work/dumps/Shape.hs.edn") > "$work/read.log"
(cd "$root" && arbace_tool -e '
(let [rd (fn [f] (let [r (arbace.lang.LineNumberingPushbackReader. (java.io.StringReader. (slurp f)))]
                   (loop [acc []] (let [x (read {:eof ::e} r)] (if (= x ::e) acc (recur (conj acc x)))))))
      spec (rd "test/haskell/sample/Shape.ae")
      conv (rd "'"$work"'/forms/hs/Data/Shape.ae")
      ;; the spec writes :config with fewer keys
      trim (fn [f] (if (and (seq? f) (= (quote hs/module) (first f)))
                     (let [v (vec f) i (.indexOf v :config) c (get v (inc i))]
                       (with-meta (apply list (assoc v (inc i) (select-keys c (keys (get (vec (first (filter #(and (seq? %) (= (quote hs/module) (first %))) spec))) (inc i))))))
                                  (meta f)))
                     f))
      conv (mapv trim conv)
      bad (remove (fn [[a b]] (and (= a b) (= (:line (meta a)) (:line (meta b))))) (map vector spec conv))]
  (doseq [[a b] bad] (println "spec:     " (:line (meta a)) (pr-str a)) (println "converted:" (:line (meta b)) (pr-str b)))
  (if (and (empty? bad) (= (count spec) (count conv)))
    (println "ok:" (count conv) "forms, as the spec writes them, at the same lines")
    (do (println "FAIL: the converted forms differ from the spec'"'"'s") (System/exit 1))))') || fail=1

echo "== 3. the worked example's round trip"
(cd "$root" && arbace_tool -m arbace.repr.haskell print -o "$work/printed" "$work/forms/hs/Data/Shape.ae") > "$work/print.log"
(cd "$root/test/haskell/sample" && "$helper" tree -o "$work/orig" --libdir "$libdir" --ghc -haddock --files Shape.hs)
(cd "$work/printed" && "$helper" tree -o "$work/cand" --libdir "$libdir" --ghc -haddock --files Shape.hs)
if cmp -s "$work/orig/Shape.hs.tree" "$work/cand/Shape.hs.tree" && cmp -s "$work/orig/Shape.hs.lines" "$work/cand/Shape.hs.lines"; then
  echo "ok: the printed module parses to the same tree and lines ($(wc -l < "$work/orig/Shape.hs.lines") located nodes)"
else
  echo "FAIL: the printed module ($work/printed/Shape.hs) parses to another tree or other lines"; fail=1
fi

echo "== 4. the interface level's normalizations (test/haskell/iface/, SPEC §9.3)"
# each N.hs compiled from inside its directory (the same relative path), ghc --show-iface of its
# interface; same: layout/ and braces/ under mode :lines, not under :full (the ABI hash, an
# unfolding's span and a SrcLoc's columns differ); changed/ differs from layout/ under :lines
for d in layout braces changed; do
  (cd "$root/test/haskell/iface/$d" && ghc -O1 -haddock -c N.hs -outputdir "$work/iface/$d" > /dev/null &&
     ghc --show-iface "$work/iface/$d/N.hi" > "$work/iface/$d.iface") || { echo "FAIL: $d/N.hs did not compile"; fail=1; }
done
# the worked example: the original and its printed module (step 3), compiled the same way
(cd "$root/test/haskell/sample" && ghc -O1 -haddock -c Shape.hs -outputdir "$work/iface/shape-orig" > /dev/null &&
   ghc --show-iface "$work/iface/shape-orig/Data/Shape.hi" > "$work/iface/shape-orig.iface") || fail=1
(cd "$work/printed" && ghc -O1 -haddock -c Shape.hs -outputdir "$work/iface/shape-cand" > /dev/null &&
   ghc --show-iface "$work/iface/shape-cand/Data/Shape.hi" > "$work/iface/shape-cand.iface") || fail=1
(cd "$root" && arbace_tool -e '
(require (quote arbace.repr.haskell))
(let [w "'"$work"'/iface/"
      same? (fn [a b mode] (let [n #(arbace.repr.haskell/normalize-iface (slurp (str w % ".iface")) mode)]
                             (= (arbace.repr.haskell/iface-units (n a) mode) (arbace.repr.haskell/iface-units (n b) mode))))
      cases [["layout" "braces" :lines true] ["layout" "braces" :full false]
             ["layout" "changed" :lines false] ["shape-orig" "shape-cand" :lines true]]
      bad (remove (fn [[a b mode want]] (= want (same? a b mode))) cases)]
  (doseq [[a b mode want] bad] (println "FAIL:" a b mode (if want "differ" "are equal")))
  (if (empty? bad)
    (println "ok:" (count cases) "interface comparisons as expected (braces equal under :lines, not :full; a changed value differs; the worked example equal)")
    (System/exit 1)))') || fail=1

echo "== 5. mode :full: the worked example printed back byte for byte (SPEC §7.2, §9.1)"
(cd "$root/test/haskell/sample" && "$helper" dump --full -o "$work/dumps-full" --libdir "$libdir" --ghc -haddock --files Shape.hs)
(cd "$root" && arbace_tool -m arbace.repr.haskell read -o "$work/forms-full" "$work/dumps-full/Shape.hs.edn") > "$work/read-full.log" || fail=1
(cd "$root" && arbace_tool -m arbace.repr.haskell print -o "$work/printed-full" "$work/forms-full/hs/Data/Shape.ae") > "$work/print-full.log" || fail=1
mkdir -p "$work/renamed/hs/Data" "$work/printed-renamed"
sed 's/\<area\>/size/g' "$work/forms-full/hs/Data/Shape.ae" > "$work/renamed/hs/Data/Shape.ae"
sed 's/\<area\>/size/g' "$root/test/haskell/sample/Shape.hs" > "$work/renamed/Shape.hs"
(cd "$root" && arbace_tool -m arbace.repr.haskell print -o "$work/printed-renamed" "$work/renamed/hs/Data/Shape.ae") > "$work/print-renamed.log" || fail=1
if cmp -s "$root/test/haskell/sample/Shape.hs" "$work/printed-full/Shape.hs" &&
   cmp -s "$work/renamed/Shape.hs" "$work/printed-renamed/Shape.hs" &&
   ! cmp -s "$work/renamed/Shape.hs" "$root/test/haskell/sample/Shape.hs"; then
  echo "ok: printed byte for byte ($(wc -c < "$work/printed-full/Shape.hs") bytes), and with a name changed in its forms"
else
  echo "FAIL: mode :full does not print the worked example back ($work/printed-full/Shape.hs, $work/printed-renamed/Shape.hs)"; fail=1
fi
(cd "$root/test/haskell/full" && "$helper" dump --full -o "$work/dumps-full" --libdir "$libdir" --ghc -haddock --files Space.hs)
(cd "$root" && arbace_tool -m arbace.repr.haskell read -o "$work/forms-full" "$work/dumps-full/Space.hs.edn") >> "$work/read-full.log" || fail=1
(cd "$root" && arbace_tool -m arbace.repr.haskell print -o "$work/printed-full" "$work/forms-full/hs/Space.ae") >> "$work/print-full.log" || fail=1
if cmp -s "$root/test/haskell/full/Space.hs" "$work/printed-full/Space.hs"; then
  echo "ok: test/haskell/full/Space.hs printed byte for byte ($(wc -c < "$work/printed-full/Space.hs") bytes)"
else
  echo "FAIL: mode :full does not print test/haskell/full/Space.hs back ($work/printed-full/Space.hs)"; fail=1
fi
echo "== 6. the layout layout (SPEC §7.4, 2)"
mkdir -p "$work/layout"
(cd "$root/test/haskell/layout" && "$helper" dump -o "$work/dumps" --libdir "$libdir" --ghc -haddock --files Layout.hs)
(cd "$root" && arbace_tool -m arbace.repr.haskell read -o "$work/forms" "$work/dumps/Layout.hs.edn") >> "$work/read.log" || fail=1
(cd "$root" && arbace_tool -m arbace.repr.haskell print --layout layout -o "$work/layout" "$work/forms/hs/Data/Shape.ae" "$work/forms/hs/Layout.ae") > "$work/print-layout.log" || fail=1
(cd "$root/test/haskell/layout" && "$helper" tree -o "$work/orig" --libdir "$libdir" --ghc -haddock --files Layout.hs)
(cd "$work/layout" && "$helper" tree -o "$work/cand-layout" --libdir "$libdir" --ghc -haddock --files Shape.hs Layout.hs)
for f in Shape Layout; do
  if ! cmp -s "$root/test/haskell/layout/expected/$f.hs" "$work/layout/$f.hs"; then
    echo "FAIL: $f.hs printed in the layout layout differs from test/haskell/layout/expected/$f.hs ($work/layout/$f.hs)"; fail=1
  elif ! cmp -s "$work/orig/$f.hs.tree" "$work/cand-layout/$f.hs.tree" || ! cmp -s "$work/orig/$f.hs.lines" "$work/cand-layout/$f.hs.lines"; then
    echo "FAIL: $f.hs printed in the layout layout parses to another tree or other lines ($work/layout/$f.hs)"; fail=1
  else
    echo "ok: $f.hs printed in the layout layout as expected, the same tree and lines ($(wc -l < "$work/orig/$f.hs.lines") located nodes)"
  fi
done
(cd "$work/layout" && ghc -O1 -haddock -c Shape.hs -outputdir "$work/iface/shape-layout" > /dev/null &&
   ghc --show-iface "$work/iface/shape-layout/Data/Shape.hi" > "$work/iface/shape-layout.iface") || fail=1
(cd "$root" && arbace_tool -e '
(require (quote arbace.repr.haskell))
(let [n #(arbace.repr.haskell/normalize-iface (slurp (str "'"$work"'/iface/" % ".iface")) :lines)]
  (if (= (arbace.repr.haskell/iface-units (n "shape-orig") :lines) (arbace.repr.haskell/iface-units (n "shape-layout") :lines))
    (println "ok: the worked example printed in the layout layout compiles to an equal interface")
    (do (println "FAIL: the worked example printed in the layout layout compiles to another interface") (System/exit 1))))') || fail=1

echo "== 7. R5's cases (test/haskell/r5/)"
mkdir -p "$work/r5"
(cd "$root/test/haskell/r5" && "$helper" dump -o "$work/r5/dumps" --libdir "$libdir" --ghc -haddock --files Cases.hs Incl.hs)
(cd "$root" && arbace_tool -m arbace.repr.haskell read -o "$work/r5/forms" "$work/r5/dumps/Cases.hs.edn" "$work/r5/dumps/Incl.hs.edn") > "$work/r5/read.log" || fail=1
(cd "$root/test/haskell/r5" && "$helper" tree -o "$work/r5/orig" --libdir "$libdir" --ghc -haddock --files Cases.hs Incl.hs)
for lay in braces layout; do
  (cd "$root" && arbace_tool -m arbace.repr.haskell print --layout $lay -o "$work/r5/$lay" "$work/r5/forms/hs/Cases.ae" "$work/r5/forms/hs/Incl.ae") > "$work/r5/print-$lay.log" || fail=1
  (cd "$work/r5/$lay" && "$helper" tree -o "$work/r5/cand-$lay" --libdir "$libdir" --ghc -haddock --files Cases.hs Incl.hs) || fail=1
  for f in Cases Incl; do
    if cmp -s "$work/r5/orig/$f.hs.tree" "$work/r5/cand-$lay/$f.hs.tree" && cmp -s "$work/r5/orig/$f.hs.lines" "$work/r5/cand-$lay/$f.hs.lines"; then
      echo "ok: $f.hs printed in the $lay layout, the same tree and lines ($(wc -l < "$work/r5/orig/$f.hs.lines") located nodes)"
    else
      echo "FAIL: $f.hs printed in the $lay layout parses to another tree or other lines ($work/r5/$lay/$f.hs)"; fail=1
    fi
  done
done
if grep -q ':hs/file "Incl/Body.hs"' "$work/r5/forms/hs/Incl.ae" && grep -q ':hs/file "Incl.hs"' "$work/r5/forms/hs/Incl.ae"; then
  echo "ok: Incl's forms name the other file and their own (:hs/file)"
else
  echo "FAIL: Incl's forms do not name the files of their nodes ($work/r5/forms/hs/Incl.ae)"; fail=1
fi

echo "== 8. R6's cases (test/haskell/r6/)"
w8=$work/r6
mkdir -p "$w8/src"
cp -a "$root/test/haskell/r6/." "$w8/src/"
r6in="Str.hsig Boot.hs-boot Bird.lhs Latex.lhs Codes.hsc Alex.hs AlexCpp.hs"
# the files the helper names its outputs after and the printer writes (an .hsc's: X.hs)
r6out="Str.hsig Boot.hs-boot Bird.lhs Latex.lhs Codes.hs Alex.hs AlexCpp.hs"
# shellcheck disable=SC2086
(cd "$w8/src" && "$helper" dump -o "$w8/dumps" --libdir "$libdir" --ghc -haddock --files $r6in &&
   "$helper" dump --full -o "$w8/dumps-full" --libdir "$libdir" --ghc -haddock --files $r6in &&
   "$helper" tree -o "$w8/orig" --libdir "$libdir" --ghc -haddock --files $r6in &&
   "$helper" tree --full -o "$w8/orig-full" --libdir "$libdir" --ghc -haddock --files $r6in) || fail=1
# shellcheck disable=SC2046
(cd "$root" && arbace_tool -m arbace.repr.haskell read -o "$w8/forms" $(for f in $r6out; do echo "$w8/dumps/$f.edn"; done) &&
   arbace_tool -m arbace.repr.haskell read -o "$w8/forms-full" $(for f in $r6out; do echo "$w8/dumps-full/$f.edn"; done)) > "$w8/read.log" || fail=1
for lay in braces layout full; do
  fs=$w8/forms; [ $lay = full ] && fs=$w8/forms-full
  # shellcheck disable=SC2046
  (cd "$root" && arbace_tool -m arbace.repr.haskell print --layout $lay -o "$w8/$lay" $(find "$fs" -name '*.ae' | sort)) > "$w8/print-$lay.log" || fail=1
done
for lay in braces layout; do
  # shellcheck disable=SC2086
  (cd "$w8/$lay" && "$helper" tree -o "$w8/cand-$lay" --libdir "$libdir" --ghc -haddock --files $r6out) || fail=1
  for f in $r6out; do
    if cmp -s "$w8/orig/$f.tree" "$w8/cand-$lay/$f.tree" && cmp -s "$w8/orig/$f.lines" "$w8/cand-$lay/$f.lines"; then
      echo "ok: $f printed in the $lay layout, the same tree and lines ($(wc -l < "$w8/orig/$f.lines") located nodes)"
    else
      echo "FAIL: $f printed in the $lay layout parses to another tree or other lines ($w8/$lay/$f)"; fail=1
    fi
  done
done
# shellcheck disable=SC2086
(cd "$w8/full" && "$helper" tree --full -o "$w8/cand-full" --libdir "$libdir" --ghc -haddock --files $r6out) || fail=1
for f in $r6out; do
  ref=$w8/src/$f; [ -f "$w8/dumps-full/$f.view" ] && ref=$w8/dumps-full/$f.view
  if ! cmp -s "$ref" "$w8/full/$f"; then
    echo "FAIL: $f in mode :full is not printed back byte for byte ($w8/full/$f against $ref)"; fail=1
  elif ! cmp -s "$w8/orig-full/$f.tree" "$w8/cand-full/$f.tree" || ! cmp -s "$w8/orig-full/$f.lines" "$w8/cand-full/$f.lines"; then
    echo "FAIL: $f printed in mode :full parses to another tree of mode :full ($w8/full/$f)"; fail=1
  else
    echo "ok: $f in mode :full printed back byte for byte ($(wc -c < "$ref") bytes), the same tree of mode :full"
  fi
done
if grep -q ':kind :sig' "$w8/forms/hs/Str/sig.ae" && grep -q ':kind :boot' "$w8/forms/hs/Boot/boot.ae" &&
   grep -q ':unlit true' "$w8/forms/hs/Bird.ae" && grep -q ':hsc2hs {' "$w8/forms/hs/Codes.ae"; then
  echo "ok: the forms name their kinds (hs.Str.sig, hs.Boot.boot: :kind), unlit and hsc2hs (:unlit, :hsc2hs)"
else
  echo "FAIL: the forms of R6's cases do not record their kinds, unlit or hsc2hs ($w8/forms)"; fail=1
fi
# the interfaces: each original and its printed module (the braces layout's) compiled the same way;
# the signature as an indefinite unit's (-instantiated-with), the boot file with Boot.hs and
# User.hs (its .hi-boot)
for side in orig cand; do
  d=$w8/iface-$side; mkdir -p "$d/src"
  cp "$w8/src/"*.hs "$w8/src/"*.hsig "$w8/src/"*.hs-boot "$w8/src/"*.lhs "$d/src/"
  [ $side = cand ] && cp "$w8/braces/"* "$d/src/"
  (cd "$d/src" && ghc --make -this-unit-id p -this-component-id p -instantiated-with 'Str=<Str>' -fno-code -fwrite-interface \
       -haddock -outputdir "$d/sig" Str.hsig > "$d/build.log" 2>&1 &&
     ghc --make -O1 -haddock -no-link -outputdir "$d/o" User.hs Boot.hs Bird.lhs Latex.lhs Codes.hs Alex.hs AlexCpp.hs >> "$d/build.log" 2>&1 &&
     ghc --show-iface "$d/sig/Str.hi" > "$d/Str.iface" && ghc --show-iface "$d/o/Boot.hi-boot" > "$d/Boot.iface" &&
     for m in Bird Latex Codes Alex AlexCpp; do ghc --show-iface "$d/o/$m.hi" > "$d/$m.iface"; done) ||
    { echo "FAIL: R6's cases ($side) did not compile ($d/build.log)"; fail=1; }
done
(cd "$root" && arbace_tool -e '
(require (quote arbace.repr.haskell))
(let [w "'"$w8"'/"
      n (fn [side m] (arbace.repr.haskell/iface-units (arbace.repr.haskell/normalize-iface (slurp (str w "iface-" side "/" m ".iface")) :lines) :lines))
      ms ["Str" "Boot" "Bird" "Latex" "Codes" "Alex" "AlexCpp"]
      bad (remove #(= (n "orig" %) (n "cand" %)) ms)]
  (doseq [m bad] (println "FAIL: the interface of" m "differs from the original'"'"'s"))
  (if (empty? bad)
    (println "ok:" (count ms) "interfaces equal (the signature'"'"'s, the boot file'"'"'s .hi-boot, the literate, the .hsc and the generated modules'"'"')")
    (System/exit 1)))') || fail=1

echo "== 9. HR26's opt-in (test/haskell/hr26/)"
w9=$work/hr26
mkdir -p "$w9/src"
cp -a "$root/test/haskell/hr26/." "$w9/src/"
for v in plain markers; do
  vm=""; [ $v = markers ] && vm=--view-markers
  # shellcheck disable=SC2086
  (cd "$w9/src" && "$helper" dump --full $vm -o "$w9/$v/dumps" --libdir "$libdir" --ghc -haddock --files AlexDir.hs &&
     "$helper" dump $vm -o "$w9/$v/dumps-lines" --libdir "$libdir" --ghc -haddock --files AlexDir.hs) || fail=1
  (cd "$root" && arbace_tool -m arbace.repr.haskell read -o "$w9/$v/forms" "$w9/$v/dumps/AlexDir.hs.edn" &&
     arbace_tool -m arbace.repr.haskell read -o "$w9/$v/forms-lines" "$w9/$v/dumps-lines/AlexDir.hs.edn" &&
     arbace_tool -m arbace.repr.haskell print --layout full -o "$w9/$v/full" "$w9/$v/forms/hs/AlexDir.ae") > "$w9/$v.log" || fail=1
  cp "$w9/src/AlexDir.h" "$w9/$v/full/"
  (cd "$w9/$v/full" && "$helper" tree --full -o "$w9/$v/cand" --libdir "$libdir" --ghc -haddock --files AlexDir.hs) || fail=1
done
(cd "$w9/src" && "$helper" tree --full -o "$w9/orig" --libdir "$libdir" --ghc -haddock --files AlexDir.hs) || fail=1
same_full() { cmp -s "$w9/orig/AlexDir.hs.tree" "$w9/$1/cand/AlexDir.hs.tree" && cmp -s "$w9/orig/AlexDir.hs.lines" "$w9/$1/cand/AlexDir.hs.lines"; }
if ! cmp -s "$w9/plain/dumps/AlexDir.hs.view" "$w9/plain/full/AlexDir.hs"; then
  echo "FAIL: AlexDir.hs in mode :full is not printed back byte for byte to its module view ($w9/plain/full/AlexDir.hs)"; fail=1
elif same_full plain; then
  echo "FAIL: AlexDir.hs's module view without --view-markers has the original's trees of mode :full (HR25's difference expected)"; fail=1
else
  echo "ok: AlexDir.hs printed back byte for byte to its module view, its trees of mode :full differing (HR25)"
fi
if ! cmp -s "$w9/markers/dumps/AlexDir.hs.view" "$w9/markers/full/AlexDir.hs"; then
  echo "FAIL: AlexDir.hs with --view-markers is not printed back byte for byte to its module view ($w9/markers/full/AlexDir.hs)"; fail=1
elif ! grep -q ':view-markers \[10\]' "$w9/markers/forms/hs/AlexDir.ae" || ! grep -qx '{-# LINE 11 "AlexDir.hs" #-}' "$w9/markers/full/AlexDir.hs"; then
  echo "FAIL: AlexDir.hs's module view with --view-markers has no pragma at line 10 (:cpp's :view-markers; $w9/markers)"; fail=1
elif ! same_full markers; then
  echo "FAIL: AlexDir.hs with --view-markers parses to another tree of mode :full ($w9/markers/full/AlexDir.hs)"; fail=1
else
  echo "ok: AlexDir.hs with --view-markers ({-# LINE 11 \"AlexDir.hs\" #-} at line 10) printed back byte for byte, the same trees and lines of mode :full"
fi
if cmp -s "$w9/plain/forms-lines/hs/AlexDir.ae" "$w9/markers/forms-lines/hs/AlexDir.ae"; then
  echo "ok: AlexDir.hs's forms of mode :lines the same with --view-markers"
else
  echo "FAIL: --view-markers changes AlexDir.hs's forms of mode :lines ($w9/markers/forms-lines)"; fail=1
fi
exit $fail

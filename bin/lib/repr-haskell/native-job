#!/bin/bash
# One job of bin/repr-haskell's native_dump_corpus: MODE LIBDIR SYSROOT JOB, JOB the fields SRC OUT FLAGS FILES HSPP
# separated by US (\x1f): FILES read natively (arbace.repr.haskell.native read, mode MODE: lines or full) from inside SRC
# into OUT, under the GHC flags FLAGS, the GHC installation LIBDIR read under SYSROOT (- for the host's own files), an
# .hsc module's hsc2hs record from HSPP (- for none); the reader's messages appended to OUT.log. No GHC: the reader is
# Arbace's (doc/haskell/NATIVE.md).
root=$(cd "$(dirname "$0")/../../.." && pwd)
. "$root/bin/lib/tmpdir.bash"
. "$root/bin/lib/tools.bash"
mode=$1 libdir=$2 sysroot=$3
IFS=$'\x1f' read -r src out flags fs hspp <<< "$4"
mkdir -p "$out"
cd "$src" || exit 0
sr=(); [ "$sysroot" != - ] && sr=(--sysroot "$sysroot")
hs=(); [ -n "$hspp" ] && [ "$hspp" != - ] && hs=(--hspp "$hspp")
# shellcheck disable=SC2086
arbace_tool -m arbace.repr.haskell.native read -o "$out" --libdir "$libdir" ${sr[@]+"${sr[@]}"} ${hs[@]+"${hs[@]}"} \
  --mode "$mode" --flags "$flags" $fs >> "$out.log" 2>&1
exit 0

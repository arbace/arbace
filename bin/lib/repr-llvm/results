#!/bin/bash
# bin/reap's records of repr/llvm's checks (test/reap/cells.edn, the :llvm row): a check's work directory written as rows
# [ID RESULT REASON] (test/llvm/check-*.edn; the format of goi's check, test/goi/check-linux-amd64.edn), one a module,
# on stdout:
#   results verify WORK [KNOWN]   WORK of `bin/repr-llvm verify-check` (verify.tsv, full.tsv): :pass when Arbace's verdict, first
#                                 message and whole stderr are the reference's (the module's own verdict and declared fragment, else opt's); else :verdict, :message or :stderr with the mutant's kind
#                                 (the name's second last field: NAME.KIND.INDEX) and opt's first line; a name of KNOWN (NAME<tab>CLASS<tab>
#                                 reason, test/llvm/probes-known.tsv) that does not pass :known "CLASS: reason"
#   results roundtrip WORK        WORK of `bin/repr-llvm roundtrip` (rt.tsv, verifier.tsv, objects.tsv, bitcode.tsv): :pass when the forms
#                                 are equal, no judge differs or is unjudged, and one judge is the same: Arbace's verifier (the own
#                                 verdict, the default), the bitcode (the canonical-text judge, LLS5 (a)) or the object; else :fail
#   results text WORK             WORK of `bin/repr-llvm roundtrip --text` (text.tsv): :pass when ok, else :fail
set -euo pipefail
esc='function q(s) { gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s); return "\"" s "\"" }'
case ${1:-} in
  verify)
    work=$2 known=${3:-}
    [ -n "$known" ] || { known=$work/known.tsv; : > "$known"; }
    awk -F'\t' "$esc"'
      FILENAME == ARGV[1] { kc[$1] = $2; kr[$1] = $3; next }
      FILENAME == ARGV[2] { full[$1] = $2; next }
      { n = $1; kind = n; sub(/\.[0-9]+$/, "", kind); k = (kind != n) ? kind : ""; sub(/^.*\./, "", k)
        first = ($6 != "") ? $6 : $7
        if ($4 != "same") r = ":verdict " q((k != "" ? k ": " : "") ($8 == "own" ? "the test says " : "opt says ") $2 ", verify says " $3 ": " first)
        else if ($5 == "differs") r = ":message " q((k != "" ? k ": " : "") "the first message differs: " $6 " | " $7)
        else if (full[$1] == "differs") r = ":stderr " q((k != "" ? k ": " : "") "the whole stderr differs: " first)
        else r = ":pass \"\""
        if ((n in kc) && r != ":pass \"\"") r = ":known " q(kc[n] ": " kr[n])
        print "[" q(n) " " r "]" }' "$known" "$work/full.tsv" "$work/verify.tsv" ;;
  roundtrip)
    work=$2
    [ -f "$work/verifier.tsv" ] || : > "$work/verifier.tsv"
    awk -F'\t' "$esc"'
      FILENAME == ARGV[1] { ob[$1] = $2; next }
      FILENAME == ARGV[2] { bc[$1] = $2; next }
      FILENAME == ARGV[3] { vf[$1] = $2; next }
      { n = $1; bad = (ob[n] == "differs" || bc[n] == "differs" || vf[n] == "differs" || ob[n] == "unjudged" || bc[n] == "unjudged")
        if ($2 == "ok" && !bad && (bc[n] == "same" || ob[n] == "same" || vf[n] == "same")) r = ":pass \"\""
        else r = ":fail " q("forms " $2 ", object " (n in ob ? ob[n] : "-") ", bitcode " (n in bc ? bc[n] : "-") ", verifier " (n in vf ? vf[n] : "-") " " $3)
        print "[" q(n) " " r "]" }' "$work/objects.tsv" "$work/bitcode.tsv" "$work/verifier.tsv" "$work/rt.tsv" ;;
  text)
    work=$2
    awk -F'\t' "$esc"'{ if ($2 == "ok") r = ":pass \"\""; else r = ":fail " q($2 " " $3); print "[" q($1) " " r "]" }' "$work/text.tsv" ;;
  *) echo "usage: results verify WORK [KNOWN] | roundtrip WORK | text WORK" >&2; exit 2 ;;
esac

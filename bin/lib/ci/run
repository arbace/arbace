#!/bin/bash
# bin/ci run [--std S] [OPTION...] FILE... [-- ARG...]: FILE... (one program) read by repr/c, checked, linked with
# musl's forms and built (arbace.c.run's nodes), then run by ci's back end (tools/cirun, the light path; bin/ci
# cirun-build when absent) with ARG...; the program's status is the command's.
set -uo pipefail
root=$(cd "$(dirname "$0")/../../.." && pwd)
. "$root/bin/lib/tmpdir.bash"
. "$root/bin/lib/tools.bash"
opts=() files=() pargs=()
while [ $# -gt 0 ]; do
  case $1 in
    --) shift; pargs=("$@"); break ;;
    --std) opts+=("--std=$2"); shift 2 ;;
    -*) opts+=("$1"); shift ;;
    *) files+=("$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"); shift ;;
  esac
done
cirun=${CIRUN:-$root/.tmp/ci/cirun}
[ -x "$cirun" ] || "$root/bin/ci" cirun-build > "$TMPDIR/ci-cirun-build.log" 2>&1 || { cat "$TMPDIR/ci-cirun-build.log" >&2; exit 1; }
"$root/bin/ci" musl prepare
n=$TMPDIR/ci-run-$$.nodes
(cd "$root" && arbace_tool -m arbace.c.run test/c/host nodes "${opts[@]}" -o "$n" "${files[@]}") || exit 1
"$cirun" "$n" "${pargs[@]}"; st=$?
rm -f "$n"
exit $st

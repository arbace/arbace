#!/bin/bash
# ci's back end built outside Arbace's executable (doc/C23-SURVEY.md, "As built: C5 (write-ahead)"): the Go forms of
# go/arbace/crt and go/arbace/ci printed by repr/go (lines layout) into the module .tmp/ci/go (module arbace),
# tools/cirun's main beside them, built by TamaGo's go (CGO_ENABLED=0, a private GOCACHE) into .tmp/ci/cirun:
# a small single-package build, std only, the light path's runner of node programs. CI_GO_SRC names a Go tree
# holding crt/ and ci/ to build from instead of the printed forms.
# Keyed (queue 138, finding 4): .tmp/ci/key holds the digest of what the build is made from (go/arbace/{ci,crt}.ae and their
# trees, tools/cirun/, repr/go's printer: bin/repr-go, bin/lib/repr-go-host.bash, arbace/repr/go{.ae,/}, this script, TamaGo's
# go by its path and VERSION); `--ensure` keeps .tmp/ci/cirun and .tmp/ci/go when the key is the checkout's, else builds (the
# callers' way: before, a cirun once built was never rebuilt, so a change to the back end ran on the old one). CI_GO_SRC: always built.
# Usage: bin/ci cirun-build [--ensure]
set -euo pipefail
root=$(cd "$(dirname "$0")/../../.." && pwd)
. "$root/bin/lib/tmpdir.bash"
out=$root/.tmp/ci
goroot=${ARBACE_GOROOT:-/root/tamago-go}
go=$goroot/bin/go
key() {
  (cd "$root" && { find go/arbace/ci.ae go/arbace/ci go/arbace/crt.ae go/arbace/crt tools/cirun bin/repr-go bin/lib/repr-go-host.bash \
                        arbace/repr/go.ae arbace/repr/go bin/lib/ci/cirun-build -type f 2>"$TMPDIR/cirun-key.err" | LC_ALL=C sort | xargs -d '\n' sha256sum
                   printf 'go %s %s\n' "$goroot" "$(head -1 "$goroot/VERSION" 2>"$TMPDIR/cirun-key.err")"; } | sha256sum | cut -c1-64)
}
if [ "${1:-}" = --ensure ]; then
  if [ -z "${CI_GO_SRC:-}" ] && [ -x "$out/cirun" ] && [ -d "$out/go/ci" ] && [ "$(cat "$out/key" 2>"$TMPDIR/cirun-key.err")" = "$(key)" ]; then
    echo "kept $out/cirun (its key the checkout's)"; exit 0
  fi
  [ -x "$out/cirun" ] && echo "cirun-build: $out/cirun is not of this checkout's back end (.tmp/ci/key): rebuilt" >&2
elif [ -n "${1:-}" ]; then echo "usage: bin/ci cirun-build [--ensure]" >&2; exit 2
fi
k=$(key)
rm -f "$out/key"
rm -rf "$out/go"; mkdir -p "$out/go/cirun"
printf 'module arbace\n\ngo 1.27\n' > "$out/go/go.mod"
if [ -n "${CI_GO_SRC:-}" ]; then
  cp -r "$CI_GO_SRC/crt" "$CI_GO_SRC/ci" "$out/go/"
  rm -f "$out/go"/*/*_test.go
else
  for p in crt ci; do
    mkdir -p "$out/go/$p"
    "$root/bin/repr-go" print --layout lines --no-line-directives "$root/go/arbace/$p.ae" "$out/go/$p" > "$out/print-$p.log" 2>&1 \
      || { cat "$out/print-$p.log" >&2; exit 1; }
  done
fi
cp "$root/tools/cirun/main.go" "$out/go/cirun/"
(cd "$out/go" && CGO_ENABLED=0 GOFLAGS=-mod=mod GOCACHE=$out/gocache GOMAXPROCS=4 "$go" build -p 2 -trimpath -o "$out/cirun" ./cirun)
[ -n "${CI_GO_SRC:-}" ] || printf '%s\n' "$k" > "$out/key"
echo "built $out/cirun"

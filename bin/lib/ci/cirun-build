#!/bin/bash
# ci's back end built outside Arbace's executable (doc/C23-SURVEY.md, "As built: C5 (write-ahead)"): the Go forms of
# go/arbace/crt and go/arbace/ci printed by repr/go (lines layout) into the module .tmp/ci/go (module arbace),
# tools/cirun's main beside them, built by TamaGo's go (CGO_ENABLED=0, a private GOCACHE) into .tmp/ci/cirun:
# a small single-package build, std only, the light path's runner of node programs. CI_GO_SRC names a Go tree
# holding crt/ and ci/ to build from instead of the printed forms.
set -euo pipefail
root=$(cd "$(dirname "$0")/../../.." && pwd)
. "$root/bin/lib/tmpdir.bash"
out=$root/.tmp/ci
go=${ARBACE_GOROOT:-/root/tamago-go}/bin/go
rm -rf "$out/go"; mkdir -p "$out/go/cirun"
printf 'module arbace\n\ngo 1.27\n' > "$out/go/go.mod"
if [ -n "${CI_GO_SRC:-}" ]; then
  cp -r "$CI_GO_SRC/crt" "$CI_GO_SRC/ci" "$out/go/"
  rm -f "$out/go"/*/*_test.go
else
  for p in crt ci; do
    mkdir -p "$out/go/$p"
    "$root/bin/repr-go" print --layout lines --no-line-directives "$root/go/arbace/$p.ae" "$out/go/$p" > "$out/print-$p.log" 2>&1 \
      || { cat "$out/print-$p.log" >&2; exit 1; }
  done
fi
cp "$root/tools/cirun/main.go" "$out/go/cirun/"
(cd "$out/go" && CGO_ENABLED=0 GOFLAGS=-mod=mod GOCACHE=$out/gocache GOMAXPROCS=4 "$go" build -p 2 -trimpath -o "$out/cirun" ./cirun)
echo "built $out/cirun"

#!/bin/bash
# ci's AOT check (doc/C23-SURVEY.md §7, "As built: C6 (write-ahead)"; CS13 (a)): every program of the run corpora
# read by repr/c, checked, linked with musl 1.2.6's forms and built into its node program as bin/ci check does, then
# translated by cf2g (arbace.c.cf2g) into Go forms over go/arbace/ci and go/arbace/crt, printed by repr/go and built
# by TamaGo's go, in shards of programs (one package each, a shard one executable); each program run with an empty
# standard input, no arguments, 10 s (more for the programs of test/c/check-budget.edn, CS216), its status and standard output's SHA-256 against gcc 15.2's -O0 run
# (test/c/ref-gcc15.edn), every program that does not pass in a class of test/c/divergences-aot.edn or
# test/c/divergences.edn (cf2g's judge); and against the interpreted check's runs (CI_INTERP: CORPUS/run.tsv, the
# same status and stdout: diffcheck's kind). The light tier's: a shard's Arbace process (CI_THREADS threads),
# then its go build (-p CI_GO_P), then its runs (CI_JOBS), one after another; each shard's sources and
# executable deleted once run (the disk).
#
# Usage: bin/ci check --aot [--corpus C,...] [--only LIST] [--sample N] [--record] [--judge] [--resume]
#   --corpus   the run corpora (default those test/c/ref-gcc15.edn records)
#   --only     a file of ids (CORPUS/NAME) to check alone
#   --sample   every Nth program of each corpus only
#   --record   test/c/check-aot-linux-amd64.edn rewritten from the run (the other corpora's lines kept; not with --only
#              or --sample)
#   --judge    the last run judged again, nothing run
#   --resume   the programs already run kept
#   CI_AOT_NODES=1: each node program also run by the interpreter (tools/cirun), into .tmp/ci-aot/interp/CORPUS/run.tsv,
#   the comparison's other side (CI_INTERP then names .tmp/ci-aot/interp by default; without it and without
#   CI_INTERP the runs are not compared with the interpreter's: CS214)
#   CI_THREADS (default 3), CI_JOBS (default 4, at most 4), CI_GO_P (default 2), CI_SHARD (default 40 programs)
# Writes under .tmp/ci-aot/ (CI_AOT_WORK): CORPUS/list.tsv, nodes.tsv, run.tsv, build.log; results.edn.
set -uo pipefail
root=$(cd "$(dirname "$0")/../../.." && pwd)
. "$root/bin/lib/tmpdir.bash"
. "$root/bin/lib/tools.bash"
. "$root/bin/lib/ci/budget.bash"
cd "$root"

all=torture-execute,torture-execute-mirror,tcc-tests2,compcert,mir,cxgo,benchmarksgame
corpora=$all only= record= judge= resume= sample=1
while [ $# -gt 0 ]; do
  case $1 in
    --corpus) corpora=$2; shift 2 ;;
    --only) only=$(cd "$(dirname "$2")" && pwd)/$(basename "$2"); shift 2 ;;
    --sample) sample=$2; shift 2 ;;
    --record) record=1; shift ;;
    --judge) judge=1; shift ;;
    --resume) resume=1; shift ;;
    *) sed -n '13,23p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
  esac
done
# a subset's run never rewrites the corpora's record (review 006, finding 5); its judge does not fail on the
# record's rows it leaves out (CI_SUBSET)
if [ -n "$only" ] || [ "$sample" != 1 ]; then
  [ -n "$record" ] && { echo "bin/ci check --aot: --record records whole corpora, not --only's or --sample's subset" >&2; exit 2; }
  export CI_SUBSET=1
fi
work=${CI_AOT_WORK:-$root/.tmp/ci-aot}
# the interpreted side: this run's (CI_AOT_NODES), else CI_INTERP's directory when named, else none: not compared (CS214, R3:
# bin/ci check's scratch, .tmp/ci-check, has no key and may be an older state or a subset)
if [ -n "${CI_AOT_NODES:-}" ]; then interp=${CI_INTERP:-$work/interp}; else interp=${CI_INTERP:-}; fi
threads=${CI_THREADS:-3}
jobs=${CI_JOBS:-4}; [ "$jobs" -gt 4 ] && jobs=4
gop=${CI_GO_P:-2}
shard=${CI_SHARD:-40}
go=${ARBACE_GOROOT:-/root/tamago-go}/bin/go
mod=$work/go
cirun=${CIRUN:-$root/.tmp/ci/cirun}
mkdir -p "$work"
IFS=, read -r -a ids <<< "$corpora"
# the last run's subset (review 027, finding 3): a run with --only or --sample leaves CORPUS/subset, which --judge reads, so
# --judge --record never rewrites a corpus's record from a subset either
if [ -n "$judge" ]; then
  for id in "${ids[@]}"; do [ -f "$work/$id/subset" ] && export CI_SUBSET=1; done
  if [ -n "${CI_SUBSET:-}" ] && [ -n "$record" ]; then
    echo "bin/ci check --aot: --judge --record: the last run was a subset (--only or --sample; CORPUS/subset), not whole corpora" >&2; exit 2
  fi
fi

# the module: go/arbace/ci and go/arbace/crt printed (bin/ci cirun-build's), the shards' packages beside them
module() {
  "$root/bin/ci" cirun-build --ensure > "$work/cirun-build.log" 2>&1 || { cat "$work/cirun-build.log"; exit 1; }
  rm -rf "$mod"; mkdir -p "$mod/progs" "$mod/shard"
  cp -r "$root/.tmp/ci/go/ci" "$root/.tmp/ci/go/crt" "$mod/"
  printf 'module arbace\n\ngo 1.27\n' > "$mod/go.mod"
}

if [ -z "$judge" ]; then
  "$root/bin/ci" musl ensure || exit 1
  module
  gowhim=${GOWHIM:-$(cd "${root%%/.tmp/*}/.." && pwd)/go-whim}
  modcache=$(GOFLAGS= "$go" env GOMODCACHE)
  gccroot=; case ,$corpora, in *,gcc-*) gccroot=$("$root/bin/repr-c" gcc-tests) || exit 1 ;; esac
  roots="{:gomodcache \"$modcache\" :go-whim \"$gowhim\" :gcc-15.2.0 \"$gccroot\" :checkout \"$root\"}"
  : > "$work/empty-stdin"
  for id in "${ids[@]}"; do
    d=$work/$id
    if [ -z "$resume" ]; then rm -rf "${d:?}" "$work/interp/$id"; fi
    mkdir -p "$d"
    if [ -n "$only" ] || [ "$sample" != 1 ]; then printf '%s %s\n' "${only:-all}" "$sample" > "$d/subset"; else rm -f "$d/subset"; fi
    if [ ! -s "$d/gcc.list" ]; then
      # the corpus's list made here, never taken from another work directory (review 006, finding 11)
      arbace_tool -m arbace.repr.c.ppcheck lists "$work" "$roots" "$id" > "$d.lists.log" 2>&1 || { cat "$d.lists.log"; exit 1; }
    fi
    base=$(cat "$d/base.txt")
    grep -o '{:id "[^"]*" :status :no-build' test/c/ref-gcc15.edn | cut -d'"' -f2 > "$d/no-build.txt"
    : > "$d/done.txt"
    if [ -n "$resume" ] && [ -f "$d/run.tsv" ]; then cut -f1 "$d/nodes.tsv" > "$d/done.txt"; fi
    awk -F'\t' -v c="$id" -v b="$base" -v only="${only:-}" -v nb="$d/no-build.txt" -v done="$d/done.txt" -v sm="$sample" '
      BEGIN { while ((getline l < nb) > 0) skip[l] = 1
              if (only != "") { while ((getline l < only) > 0) want[l] = 1 } }
      { i = c "/" $1; if (i in skip) next; if (only != "" && !(i in want)) next
        n++; if ((n - 1) % sm != 0) next
        print i "\t" b "\t" $2 "\t" $3 "\t" $4 }' "$d/gcc.list" > "$d/list.tsv"
    awk -F'\t' 'BEGIN { while ((getline l < ARGV[2]) > 0) done[l] = 1; ARGV[2] = "" } !($1 in done)' "$d/list.tsv" "$d/done.txt" > "$d/todo.tsv"
    split -l "$shard" -d -a 4 "$d/todo.tsv" "$d/shard."
    for s in "$d"/shard.[0-9][0-9][0-9][0-9]; do
      [ -f "$s" ] || continue
      # the shard's programs read, built and translated: package pN of the shard
      awk -F'\t' '{ print $0 "\tp" NR }' "$s" > "$s.list"
      rm -rf "$mod/progs" "$mod/shard"; mkdir -p "$mod/progs" "$mod/shard"
      (cd "$root" && GOMAXPROCS=4 GOMEMLIMIT=${CI_GOMEMLIMIT:-1800MiB} arbace_tool -m arbace.c.cf2g compile-list test/c/host "$mod" "$s.list" "$threads") > "$s.compile.log" 2>&1
      [ -f "$mod/nodes.tsv" ] && cat "$mod/nodes.tsv" >> "$d/nodes.tsv" && rm -f "$mod/nodes.tsv"
      # the shard's executable: a main naming each translated package
      awk -F'\t' '$2 == "ok" {print $1}' "$d/nodes.tsv" | sort > "$s.ok"
      awk -F'\t' '{print $1 "\t" $6}' "$s.list" | sort > "$s.pkgs"
      join -t "$(printf '\t')" "$s.ok" "$s.pkgs" > "$s.built" 2>> "$s.compile.log" || true
      rm -f "$s.ok"
      if [ -s "$s.built" ]; then
        {
          echo 'package main'; echo; echo 'import ('; echo '	"os"'
          cut -f2 "$s.built" | while read -r p; do echo "	$p \"arbace/progs/$p\""; done
          echo ')'; echo; echo 'func main() {'; echo '	switch os.Args[1] {'
          cut -f2 "$s.built" | while read -r p; do echo "	case \"$p\":"; echo "		$p.Main(os.Args[2:])"; done
          echo '	}'; echo '	println("ciaot: internal: no package", os.Args[1])'; echo '	os.Exit(70)'; echo '}'
        } > "$mod/shard/main.go"
        exe=$work/shard.exe
        if ! (cd "$mod" && CGO_ENABLED=0 GOFLAGS=-mod=mod GOCACHE=${CI_GOCACHE:-$root/.tmp/gocache} GOMAXPROCS=4 \
                "$go" build -p "$gop" -trimpath -o "$exe" ./shard) > "$s.build.log" 2>&1; then
          # the shard did not build: each package built alone, those whose Go does not compile taken out
          cut -f2 "$s.built" | while read -r p; do
            if ! (cd "$mod" && CGO_ENABLED=0 GOFLAGS=-mod=mod GOCACHE=${CI_GOCACHE:-$root/.tmp/gocache} GOMAXPROCS=4 "$go" build -p "$gop" -o "$work/pkg.a" "./progs/$p") > "$s.$p.log" 2>&1; then
              i=$(awk -F'\t' -v p="$p" '$2 == p {print $1}' "$s.built")
              printf '%s\tgo-error\t\t%s\n' "$i" "$(grep -m1 'prog.go' "$s.$p.log" | cut -c1-200 | tr '\t' ' ')" >> "$d/go-errors.tsv"
              sed -i "/^$(printf '%s' "$i" | sed 's/[\/&.]/\\&/g')\t/d" "$s.built"
              sed -i "/\"arbace\/progs\/$p\"\$/d; /case \"$p\":/,+1d" "$mod/shard/main.go"
            fi
            rm -f "$work/pkg.a" "$s.$p.log"
          done
          [ -s "$s.built" ] && (cd "$mod" && CGO_ENABLED=0 GOFLAGS=-mod=mod GOCACHE=${CI_GOCACHE:-$root/.tmp/gocache} GOMAXPROCS=4 \
                "$go" build -p "$gop" -trimpath -o "$exe" ./shard) >> "$s.build.log" 2>&1
        fi
        run1() { # ID PKG
          local rd st sum
          rd=$(mktemp -d "$work/run.XXXXXX")
          (cd "$rd" && timeout "$(ci_budget "$1")" "$exe" "$2" < "$work/empty-stdin" > out 2> err); st=$?
          [ $st = 124 ] && st=timeout
          sum=$(sha256sum < "$rd/out" | cut -d' ' -f1)
          printf '%s\t%s\t%s\t%s\t%s\n' "$1" "$st" "$sum" "$(wc -c < "$rd/out")" "$(grep -m1 '^\(ciaot: \(fault\|internal\)\|fatal error: \|runtime: \)' "$rd/err" | cut -c1-200 | tr '\t' ' ')"
          rm -rf "$rd"
          # the interpreted run of the same node program (tools/cirun), diffcheck's other side
          if [ -n "${CI_AOT_NODES:-}" ] && [ -f "$mod/progs/$2/prog.nodes" ]; then
            rd=$(mktemp -d "$work/run.XXXXXX")
            (cd "$rd" && timeout "$(ci_budget "$1")" "$cirun" "$mod/progs/$2/prog.nodes" < "$work/empty-stdin" > out 2> err); st=$?
            [ $st = 124 ] && st=timeout
            printf '%s\t%s\t%s\t%s\t%s\n' "$1" "$st" "$(sha256sum < "$rd/out" | cut -d' ' -f1)" "$(wc -c < "$rd/out")" "$(grep -m1 '^\(cirun: \(fault\|internal\)\|fatal error: \|runtime: \)' "$rd/err" | cut -c1-200 | tr '\t' ' ')" >> "$ilog.$BASHPID"
            rm -rf "$rd"
          fi
        }
        ilog=$work/interp/$id/run.tsv
        mkdir -p "$work/interp/$id"
        export -f run1 ci_budget; export work exe mod ilog cirun root
        # ID PKG lines (an id may hold spaces): the package names the program, the id is looked up again
        [ -x "$exe" ] && cut -f2 "$s.built" | xargs -P "$jobs" -I{} bash -c 'run1 "$(awk -F"\t" -v p="$1" '"'"'$2 == p {print $1}'"'"' "$2")" "$1"' _ {} "$s.built" >> "$d/run.tsv"
        for f in "$ilog".[0-9]*; do [ -f "$f" ] && cat "$f" >> "$ilog" && rm -f "$f"; done
        # the quiet retry (review 027, finding 6): a program of the shard that timed out, compiled or interpreted, which
        # the level's record passes, is run again alone, once (compiled: the shard's executable; interpreted: cirun on
        # its node program), and that run is the one judged
        cut -f1 "$s.built" | while IFS= read -r i; do
          p=$(awk -F'\t' -v i="$i" '$1 == i {print $2}' "$s.built")
          if awk -F'\t' -v i="$i" '$1 == i && $2 == "timeout" {f = 1} END {exit !f}' "$d/run.tsv" \
             && grep -qF "[\"$i\" :pass " test/c/check-aot-linux-amd64.edn; then
            r=$(CI_AOT_NODES= run1 "$i" "$p")
            echo "ci aot: $i timed out compiled; run again alone: $(printf '%s' "$r" | cut -f2)"
            R=$r awk -F'\t' -v i="$i" '$1 == i { print ENVIRON["R"]; next } { print }' "$d/run.tsv" > "$d/run.tsv.new" && mv "$d/run.tsv.new" "$d/run.tsv"
          fi
          if [ -f "$ilog" ] && [ -f "$mod/progs/$p/prog.nodes" ] \
             && awk -F'\t' -v i="$i" '$1 == i && $2 == "timeout" {f = 1} END {exit !f}' "$ilog" \
             && grep -qF "[\"$i\" :pass " test/c/check-linux-amd64.edn; then
            rd=$(mktemp -d "$work/run.XXXXXX")
            (cd "$rd" && timeout "$(ci_budget "$i")" "$cirun" "$mod/progs/$p/prog.nodes" < "$work/empty-stdin" > out 2> err); st=$?
            [ $st = 124 ] && st=timeout
            r=$(printf '%s\t%s\t%s\t%s\t%s' "$i" "$st" "$(sha256sum < "$rd/out" | cut -d' ' -f1)" "$(wc -c < "$rd/out")" "$(grep -m1 '^\(cirun: \(fault\|internal\)\|fatal error: \|runtime: \)' "$rd/err" | cut -c1-200 | tr '\t' ' ')")
            rm -rf "$rd"
            echo "ci aot: $i timed out interpreted; run again alone: $st"
            R=$r awk -F'\t' -v i="$i" '$1 == i { print ENVIRON["R"]; next } { print }' "$ilog" > "$ilog.new" && mv "$ilog.new" "$ilog"
          fi
        done
        rm -f "$exe"
      fi
      rm -rf "$mod/progs" "$mod/shard"
      rm -f "$s" "$s.pkgs"
      # the disk: the programs' compiled packages are not used again
      find "${CI_GOCACHE:-$root/.tmp/gocache}" -type f -mmin +15 -delete 2>> "$work/gocache-trim.log" || true
      echo "ci aot: $id $(basename "$s"): $(wc -l < "$s.list") programs, $(wc -l < "$s.built") built, $(df -h "$root" | awk 'NR==2 {print $5}') disk"
    done
    # the interpreted side's work directory, for arbace.c.run's judge (cf2g's refusals and Go errors are not its)
    if [ -n "${CI_AOT_NODES:-}" ]; then
      cp "$d/list.tsv" "$work/interp/$id/"
      awk -F'\t' -v OFS='\t' '$2 == "refused" && $3 ~ /^aot-/ {$2 = "ok"; $3 = ""; $4 = ""} {print}' "$d/nodes.tsv" > "$work/interp/$id/nodes.tsv"
    fi
    # a program whose Go did not compile: its status for the judge
    if [ -s "$d/go-errors.tsv" ]; then
      awk -F'\t' 'BEGIN { while ((getline l < ARGV[2]) > 0) { split(l, f, "\t"); e[f[1]] = l }; ARGV[2] = "" }
                  ($1 in e) { print e[$1]; next } { print }' "$d/nodes.tsv" "$d/go-errors.tsv" > "$d/nodes.tsv.new" && mv "$d/nodes.tsv.new" "$d/nodes.tsv"
    fi
  done
fi
if [ -n "${CI_AOT_NODES:-}" ] && [ "$interp" = "$work/interp" ]; then
  echo "== the interpreted runs (arbace.c.run's judge${record:+, test/c/check-linux-amd64.edn recorded})"
  arbace_tool -m arbace.c.run test/c/host judge "$work/interp" test/c/ref-gcc15.edn test/c/divergences.edn "${record:+--record}" "${ids[@]}"
  echo "== the compiled runs"
fi
arbace_tool -m arbace.c.cf2g judge "$work" test/c/ref-gcc15.edn test/c/divergences.edn test/c/divergences-aot.edn "$interp" "${record:+--record}" "${ids[@]}"

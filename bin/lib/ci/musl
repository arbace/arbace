#!/bin/bash
# ci's libc (doc/C23-SURVEY.md §6.5, CS11 (a), CS12 (a); arbace.c.musl's header):
#   prepare  musl 1.2.6's release tarball (test/c/corpora.edn's :musl-1.2.6: fetched into .tmp/ci-musl/ when absent,
#            CI_MUSL_TARBALL another copy) checked by its SHA-256, extracted into .tmp/ci-musl/musl-1.2.6, configured
#            (CC=gcc ./configure --disable-shared --target=x86_64: ci's musl is x86_64's on any host, its syscall numbers
#            the ones go/arbace/crt serves; queue 152: on an arm64 host configure took aarch64's, exit_group 94, and every
#            program crashed in exit) and its generated headers made (obj/include/bits/alltypes.h,
#            syscall.h, obj/src/internal/version.h); .tmp/ci-musl/ldbl53/bits/float.h is musl's arch/arm/bits/float.h
#            (LDBL_MANT_DIG 53, CS35, SPEC §12.5). Nothing when done.
#   read     its sources read by repr/c into the forms cache .tmp/ci-musl/forms and indexed (CI_THREADS, default 4); the
#            cache is keyed (CS211): forms/key holds the digest of repr/c's files, the libc's reader (arbace/repr/c{.ae,/},
#            arbace/c/musl.ae), the host (test/c/host) and configure's generated headers, and a read whose key differs rereads the whole cache
#   verify-derived  the oracle tier: the headers prepare derives without a compiler (Arbace's target, the default;
#            ARBACE_C_TARGET=gcc: gcc's configure) against gcc's configure's, byte for byte
#   fresh    exit 0 when the cache's key is the checkout's; `ensure`: prepare, then read when the key differs
#   pack     ORS9 (a) (doc/ORACLE-RECORDS-SURVEY.md): gcc's configure's products (config.mak, alltypes.h, syscall.h, version.h)
#            made afresh in scratch and packed as c-musl-1.2.6-x86_64 (test/c/records/), by hand on the host with gcc; under
#            ARBACE_C_TARGET=gcc prepare takes them from the pack, and configures with gcc only when the store lacks it
#   verify-pack  gcc's configure's products made afresh against the pack (another gcc reported, not failed: ORS6 (a))
set -euo pipefail
root=$(cd "$(dirname "$0")/../../.." && pwd)
. "$root/bin/lib/tmpdir.bash"
. "$root/bin/lib/tools.bash"
d=$root/.tmp/ci-musl
m=$d/musl-1.2.6
forms=${CI_MUSL_FORMS:-$d/forms}
# the key also covers configure's generated headers (queue 152: forms read with another architecture's are stale)
key() { (cd "$root" && { find arbace/repr/c.ae arbace/repr/c arbace/c/musl.ae test/c/host c/target -type f | LC_ALL=C sort | xargs sha256sum
                         for h in "$m/obj/include/bits/alltypes.h" "$m/obj/include/bits/syscall.h"; do
                           [ -f "$h" ] && sha256sum < "$h"; done; true; } | sha256sum | cut -d' ' -f1); }
fresh() { [ -f "$forms/key" ] && [ "$(cat "$forms/key")" = "$(key)" ]; }
# the target description the reader reads musl with (arbace.repr.c.host/load-host): Arbace's c/target, or gcc's recorded
# answers under ARBACE_C_TARGET=gcc (bin/lib/repr-c/sysroot.bash's c_target_host)
. "$root/bin/lib/repr-c/sysroot.bash"
. "$root/test/oracle-records/oracle.bash"
# ORS9 (a) (doc/ORACLE-RECORDS-SURVEY.md): gcc's configure's products, the pack c-musl-1.2.6-x86_64 (test/c/records/)
pin=$root/test/c/records/c-musl-1.2.6-x86_64.sha256
generated="config.mak obj/include/bits/alltypes.h obj/include/bits/syscall.h obj/src/internal/version.h"
configure_tree() { # DIR: configured by the host's gcc, its generated headers made
  mkdir -p "$d"
  (cd "$1" && CC=gcc ./configure --disable-shared --target=x86_64 > "$d/configure.log" 2>&1 \
     && make obj/include/bits/alltypes.h obj/include/bits/syscall.h obj/src/internal/version.h > "$d/make.log" 2>&1)
}
tarball() { # the checked tarball's path (the main checkout's C1 copy when this one has none)
  local sum tb cmain c1
  sum=$(sed -n '/:musl-1.2.6/,/:top/s/^ *:sha256 "\(.*\)"/\1/p' "$root/test/c/corpora.edn")
  tb=${CI_MUSL_TARBALL:-$d/musl-1.2.6.tar.gz}
  cmain=${root%%/.tmp/gate-clean/*}; cmain=${cmain%%/.tmp/worktrees/*}
  c1=$cmain/.tmp/c1/musl/musl-1.2.6.tar.gz
  if [ ! -f "$tb" ] && [ -f "$c1" ]; then tb=$c1; fi
  echo "$sum  $tb" | sha256sum -c --quiet >&2 || { echo "musl: $tb does not match the pin" >&2; return 1; }
  echo "$tb"
}
pack_tree() { # gcc's configure's products made afresh in scratch, under DIR/c-musl-1.2.6-x86_64
  local w=$1 tb; tb=$(tarball) || return 1
  rm -rf "$w"; mkdir -p "$w/src"; tar -xzf "$tb" -C "$w/src" || return 1
  configure_tree "$w/src/musl-1.2.6" || { echo "musl: configure failed ($d/configure.log)" >&2; return 1; }
  mkdir -p "$w/c-musl-1.2.6-x86_64"
  for f in $generated; do mkdir -p "$w/c-musl-1.2.6-x86_64/$(dirname "$f")"; cp "$w/src/musl-1.2.6/$f" "$w/c-musl-1.2.6-x86_64/$f"; done
  rm -rf "$w/src"
}
c_target_host
# derive_tree DIR: configure's four products without a compiler (Arbace's target, c/README.md; ARBACE_C_TARGET=gcc: gcc's
# configure as before). The three headers are musl's Makefile's rules (obj/include/bits/alltypes.h:
# tools/mkalltypes.sed over arch/x86_64/bits/alltypes.h.in and include/alltypes.h.in; obj/include/bits/syscall.h:
# arch/x86_64/bits/syscall.h.in and its __NR_ lines as SYS_; obj/src/internal/version.h: tools/version.sh's VERSION),
# byte for byte gcc's configure's (bin/ci musl verify-derived, the oracle tier, with gcc); config.mak is configure's file for
# --target=x86_64 --disable-shared with every compiler probe left out (ci reads musl's sources itself: only ARCH is read)
derive_tree() {
  local t=$1
  mkdir -p "$t/obj/include/bits" "$t/obj/src/internal"
  (cd "$t" && sed -f tools/mkalltypes.sed arch/x86_64/bits/alltypes.h.in include/alltypes.h.in > obj/include/bits/alltypes.h \
     && cp arch/x86_64/bits/syscall.h.in obj/include/bits/syscall.h \
     && sed -n -e s/__NR_/SYS_/p < arch/x86_64/bits/syscall.h.in >> obj/include/bits/syscall.h \
     && printf '#define VERSION "%s"\n' "$(cat VERSION)" > obj/src/internal/version.h) || return 1
  cat > "$t/config.mak" <<'MAK'
# This version of config.mak was written by bin/ci musl prepare (Arbace's target, c/README.md) from musl's
# configure rules for --disable-shared --target=x86_64, with no compiler probed (ci reads musl's sources itself)
ARCH = x86_64
SUBARCH = 
ASMSUBARCH = 
srcdir = .
prefix = /usr/local/musl
exec_prefix = $(prefix)
bindir = $(exec_prefix)/bin
libdir = $(prefix)/lib
includedir = $(prefix)/include
syslibdir = /lib
MALLOC_DIR = mallocng
SHARED_LIBS =
MAK
}

case ${1:-} in
  prepare)
    [ -f "$m/obj/include/bits/alltypes.h" ] && [ -f "$d/ldbl53/bits/float.h" ] && grep -qx 'ARCH = x86_64' "$m/config.mak" && exit 0
    mkdir -p "$d"
    url=$(sed -n '/:musl-1.2.6/,/:top/s/^ *:url "\(.*\)"/\1/p' "$root/test/c/corpora.edn")
    sum=$(sed -n '/:musl-1.2.6/,/:top/s/^ *:sha256 "\(.*\)"/\1/p' "$root/test/c/corpora.edn")
    tb=${CI_MUSL_TARBALL:-$d/musl-1.2.6.tar.gz}
    # the main checkout: a worktree's (.tmp/worktrees/NAME) or the clean run's clone's (.tmp/gate-clean/SHA, also of a worktree), else this one (queue 150)
    cmain=${root%%/.tmp/gate-clean/*}; cmain=${cmain%%/.tmp/worktrees/*}
    c1=$cmain/.tmp/c1/musl/musl-1.2.6.tar.gz  # C1's fetch (the survey's C1.5)
    if [ ! -f "$tb" ] && [ -f "$c1" ]; then tb=$c1; fi
    # fetched through a temporary name (queue 152: wget -O leaves an empty file when the fetch fails, which every later
    # run took for the tarball and refused by the pin, until removed by hand)
    if [ ! -f "$tb" ]; then
      wget -q -O "$tb.part" "$url" || { rm -f "$tb.part"; echo "musl: fetching $url failed" >&2; exit 1; }
      mv "$tb.part" "$tb"
    fi
    echo "$sum  $tb" | sha256sum -c --quiet || { echo "musl: $tb does not match the pin" >&2; exit 1; }
    rm -rf "$m"; tar -xzf "$tb" -C "$d"
    if [ "${ARBACE_C_TARGET:-arbace}" = arbace ]; then
      derive_tree "$m" || { echo "musl: deriving configure's products failed" >&2; exit 1; }
      echo "musl: configure's products derived without a compiler (Arbace's target)"
    elif pd=$(oracle_unpack "$pin" 2>"$TMPDIR/ci-musl-pack.err"); then
      # ORS9 (a): gcc's configure's products from the pack c-musl-1.2.6-x86_64 (no gcc); without the pack in the store,
      # configured by gcc (ORS14 (a): the toolchain asked only by a miss)
      for f in $generated; do mkdir -p "$m/$(dirname "$f")"; cp "$pd/c-musl-1.2.6-x86_64/$f" "$m/$f"; done
      echo "musl: gcc's configure's products from the pack $(oracle_pin_sha "$pin" | cut -c1-16)"
    else
      echo "musl: $(head -1 "$TMPDIR/ci-musl-pack.err"); configured by the host's gcc" >&2
      configure_tree "$m" || { echo "musl: configure failed ($d/configure.log, $d/make.log)" >&2; exit 1; }
    fi
    mkdir -p "$d/ldbl53/bits"; cp "$m/arch/arm/bits/float.h" "$d/ldbl53/bits/float.h"
    echo "musl prepared in $m" ;;
  verify-derived)
    # the headers derive_tree makes against gcc's configure's, byte for byte: against the pack c-musl-1.2.6-x86_64 when the
    # store has it (no gcc; the pack itself against gcc is verify-pack's), else against gcc's configure run here (the oracle
    # tier, by hand, with gcc)
    w=$TMPDIR/ci-musl-derived.$$; rm -rf "$w"; mkdir -p "$w/a" "$w/b"
    tb=$(tarball) || exit 1
    tar -xzf "$tb" -C "$w/a" || exit 1
    derive_tree "$w/a/musl-1.2.6" || exit 1
    if pd=$(oracle_unpack "$pin" 2>"$w/pack.err"); then
      ref=$pd/c-musl-1.2.6-x86_64; echo "musl: against the pack $(oracle_pin_sha "$pin" | cut -c1-16)"
    else
      cp -R "$w/a/musl-1.2.6" "$w/b/" || exit 1; rm -rf "$w/b/musl-1.2.6/obj"
      (cd "$w/b/musl-1.2.6" && CC=gcc ./configure --disable-shared --target=x86_64 > "$w/configure.log" 2>&1 \
         && make obj/include/bits/alltypes.h obj/include/bits/syscall.h obj/src/internal/version.h > "$w/make.log" 2>&1) || { echo "musl: no pack and gcc's configure failed" >&2; exit 1; }
      ref=$w/b/musl-1.2.6; echo "musl: against gcc's configure"
    fi
    st=0; for f in obj/include/bits/alltypes.h obj/include/bits/syscall.h obj/src/internal/version.h; do
      if cmp -s "$w/a/musl-1.2.6/$f" "$ref/$f"; then echo "musl: $f equal to gcc's configure's"; else echo "musl: $f DIFFERS"; st=1; fi; done
    rm -rf "$w"; exit $st ;;
  pack)
    w=$TMPDIR/ci-musl-pack.$$; pack_tree "$w" || exit 1
    for f in $generated; do printf '%s\ttree\n' "$f"; done > "$w.ids"
    oracle_make "$pin" "$w" "$w.ids" "bin/ci musl pack" gcc && rm -rf "$w" "$w.ids" ;;
  verify-pack)
    w=$TMPDIR/ci-musl-vpack.$$; pack_tree "$w" || exit 1
    man=$(oracle_manifest "$pin")
    dn=0; oracle_check_members "$w/c-musl-1.2.6-x86_64" "$man" 2>"$w.diff" || dn=$(grep -c 'FAILED\|not in the manifest\|No such' "$w.diff" || echo 1)
    n=$(grep -vc '^#' "$man")
    st=0; oracle_verdict gcc "$man" "$dn" "$n" || st=1; rm -rf "$w" "$w.diff"; exit $st ;;
  key) key ;;
  fresh) fresh ;;
  ensure) "$0" prepare && { fresh || "$0" read; } ;;
  read)
    "$0" prepare
    k=$(key)
    if ! fresh; then
      [ -d "$forms" ] && echo "musl: the forms cache's key is not the checkout's (repr/c or the host changed): reread" >&2
      rm -rf "$forms"
    fi
    cd "$m" && arbace_tool -p "$root" -e "(require 'arbace.c.musl 'arbace.repr.c.host)" \
      -e "(let [h (arbace.repr.c.host/load-host \"$root/test/c/host\") errs (arbace.c.musl/read-all h \"$root\" ${CI_THREADS:-4})] (doseq [[s e] (sort errs)] (println \"musl: not read:\" s e)) (arbace.c.musl/index \"$root\") (println \"musl: read, the index\" (count errs) \"not read\"))" && printf '%s\n' "$k" > "$forms/key" ;;
  *) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac

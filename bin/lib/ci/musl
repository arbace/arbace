#!/bin/bash
# ci's libc (doc/C23-SURVEY.md §6.5, CS11 (a), CS12 (a); arbace.c.musl's header):
#   prepare  musl 1.2.6's release tarball (test/c/corpora.edn's :musl-1.2.6: fetched into .tmp/ci-musl/ when absent,
#            CI_MUSL_TARBALL another copy) checked by its SHA-256, extracted into .tmp/ci-musl/musl-1.2.6, configured
#            (CC=gcc ./configure --disable-shared --target=x86_64: ci's musl is x86_64's on any host, its syscall numbers
#            the ones go/arbace/crt serves; queue 152: on an arm64 host configure took aarch64's, exit_group 94, and every
#            program crashed in exit) and its generated headers made (obj/include/bits/alltypes.h,
#            syscall.h, obj/src/internal/version.h); .tmp/ci-musl/ldbl53/bits/float.h is musl's arch/arm/bits/float.h
#            (LDBL_MANT_DIG 53, CS35, SPEC §12.5). Nothing when done.
#   read     its sources read by repr/c into the forms cache .tmp/ci-musl/forms and indexed (CI_THREADS, default 4); the
#            cache is keyed (CS211): forms/key holds the digest of repr/c's files, the libc's reader (arbace/repr/c{.ae,/},
#            arbace/c/musl.ae), the host (test/c/host) and configure's generated headers, and a read whose key differs rereads the whole cache
#   fresh    exit 0 when the cache's key is the checkout's; `ensure`: prepare, then read when the key differs
#   pack     ORS9 (a) (doc/ORACLE-RECORDS-SURVEY.md): configure's products (config.mak, alltypes.h, syscall.h, version.h) made
#            afresh by gcc in scratch and packed as c-musl-1.2.6-x86_64 (test/c/records/), by hand on the host with gcc;
#            prepare takes them from the pack, and configures with gcc only when the store lacks it
#   verify-pack  configure's products made afresh against the pack (another gcc reported, not failed: ORS6 (a))
set -euo pipefail
root=$(cd "$(dirname "$0")/../../.." && pwd)
. "$root/bin/lib/tmpdir.bash"
. "$root/bin/lib/tools.bash"
d=$root/.tmp/ci-musl
m=$d/musl-1.2.6
forms=${CI_MUSL_FORMS:-$d/forms}
# the key also covers configure's generated headers (queue 152: forms read with another architecture's are stale)
key() { (cd "$root" && { find arbace/repr/c.ae arbace/repr/c arbace/c/musl.ae test/c/host -type f | LC_ALL=C sort | xargs sha256sum
                         for h in "$m/obj/include/bits/alltypes.h" "$m/obj/include/bits/syscall.h"; do
                           [ -f "$h" ] && sha256sum < "$h"; done; true; } | sha256sum | cut -d' ' -f1); }
fresh() { [ -f "$forms/key" ] && [ "$(cat "$forms/key")" = "$(key)" ]; }
. "$root/test/oracle-records/oracle.bash"
# ORS9 (a) (doc/ORACLE-RECORDS-SURVEY.md): configure's products, the pack c-musl-1.2.6-x86_64 (test/c/records/)
pin=$root/test/c/records/c-musl-1.2.6-x86_64.sha256
generated="config.mak obj/include/bits/alltypes.h obj/include/bits/syscall.h obj/src/internal/version.h"
configure_tree() { # DIR: configured by the host's gcc, its generated headers made
  mkdir -p "$d"
  (cd "$1" && CC=gcc ./configure --disable-shared --target=x86_64 > "$d/configure.log" 2>&1 \
     && make obj/include/bits/alltypes.h obj/include/bits/syscall.h obj/src/internal/version.h > "$d/make.log" 2>&1)
}
tarball() { # the checked tarball's path (fetched when absent)
  local url sum tb cmain c1
  url=$(sed -n '/:musl-1.2.6/,/:top/s/^ *:url "\(.*\)"/\1/p' "$root/test/c/corpora.edn")
  sum=$(sed -n '/:musl-1.2.6/,/:top/s/^ *:sha256 "\(.*\)"/\1/p' "$root/test/c/corpora.edn")
  tb=${CI_MUSL_TARBALL:-$d/musl-1.2.6.tar.gz}
  cmain=${root%%/.tmp/gate-clean/*}; cmain=${cmain%%/.tmp/worktrees/*}
  c1=$cmain/.tmp/c1/musl/musl-1.2.6.tar.gz
  if [ ! -f "$tb" ] && [ -f "$c1" ]; then tb=$c1; fi
  echo "$sum  $tb" | sha256sum -c --quiet >&2 || { echo "musl: $tb does not match the pin" >&2; return 1; }
  echo "$tb"
}
pack_tree() { # the products configured afresh in scratch, under DIR/c-musl-1.2.6-x86_64
  local w=$1 tb; tb=$(tarball) || return 1
  rm -rf "$w"; mkdir -p "$w/src"; tar -xzf "$tb" -C "$w/src" || return 1
  configure_tree "$w/src/musl-1.2.6" || { echo "musl: configure failed ($d/configure.log)" >&2; return 1; }
  mkdir -p "$w/c-musl-1.2.6-x86_64"
  for f in $generated; do mkdir -p "$w/c-musl-1.2.6-x86_64/$(dirname "$f")"; cp "$w/src/musl-1.2.6/$f" "$w/c-musl-1.2.6-x86_64/$f"; done
  rm -rf "$w/src"
}
case ${1:-} in
  prepare)
    [ -f "$m/obj/include/bits/alltypes.h" ] && [ -f "$d/ldbl53/bits/float.h" ] && grep -qx 'ARCH = x86_64' "$m/config.mak" && exit 0
    mkdir -p "$d"
    url=$(sed -n '/:musl-1.2.6/,/:top/s/^ *:url "\(.*\)"/\1/p' "$root/test/c/corpora.edn")
    sum=$(sed -n '/:musl-1.2.6/,/:top/s/^ *:sha256 "\(.*\)"/\1/p' "$root/test/c/corpora.edn")
    tb=${CI_MUSL_TARBALL:-$d/musl-1.2.6.tar.gz}
    # the main checkout: a worktree's (.tmp/worktrees/NAME) or the clean run's clone's (.tmp/gate-clean/SHA, also of a worktree), else this one (queue 150)
    cmain=${root%%/.tmp/gate-clean/*}; cmain=${cmain%%/.tmp/worktrees/*}
    c1=$cmain/.tmp/c1/musl/musl-1.2.6.tar.gz  # C1's fetch (the survey's C1.5)
    if [ ! -f "$tb" ] && [ -f "$c1" ]; then tb=$c1; fi
    # fetched through a temporary name (queue 152: wget -O leaves an empty file when the fetch fails, which every later
    # run took for the tarball and refused by the pin, until removed by hand)
    if [ ! -f "$tb" ]; then
      wget -q -O "$tb.part" "$url" || { rm -f "$tb.part"; echo "musl: fetching $url failed" >&2; exit 1; }
      mv "$tb.part" "$tb"
    fi
    echo "$sum  $tb" | sha256sum -c --quiet || { echo "musl: $tb does not match the pin" >&2; exit 1; }
    rm -rf "$m"; tar -xzf "$tb" -C "$d"
    # ORS9 (a): configure's products from the pack c-musl-1.2.6-x86_64 (no gcc); without the pack in the store, configured by
    # gcc when the host has it (ORS14 (a): the toolchain asked only by a miss)
    if pd=$(oracle_unpack "$pin" 2>"$TMPDIR/ci-musl-pack.err"); then
      for f in $generated; do mkdir -p "$m/$(dirname "$f")"; cp "$pd/c-musl-1.2.6-x86_64/$f" "$m/$f"; done
      echo "musl: configure's products from the pack $(oracle_pin_sha "$pin" | cut -c1-16)"
    elif command -v gcc > "$TMPDIR/ci-musl-gcc.out" 2>&1; then
      echo "musl: $(head -1 "$TMPDIR/ci-musl-pack.err"); configured by the host's gcc" >&2
      configure_tree "$m" || { echo "musl: configure failed ($d/configure.log, $d/make.log)" >&2; exit 1; }
    else
      cat "$TMPDIR/ci-musl-pack.err" >&2; echo "musl: no pack c-musl-1.2.6-x86_64 and no gcc to configure musl" >&2; exit 1
    fi
    mkdir -p "$d/ldbl53/bits"; cp "$m/arch/arm/bits/float.h" "$d/ldbl53/bits/float.h"
    echo "musl prepared in $m" ;;
  pack)
    w=$TMPDIR/ci-musl-pack.$$; pack_tree "$w" || exit 1
    for f in $generated; do printf '%s\ttree\n' "$f"; done > "$w.ids"
    oracle_make "$pin" "$w" "$w.ids" "bin/ci musl pack" gcc && rm -rf "$w" "$w.ids" ;;
  verify-pack)
    w=$TMPDIR/ci-musl-vpack.$$; pack_tree "$w" || exit 1
    man=$(oracle_manifest "$pin")
    dn=0; oracle_check_members "$w/c-musl-1.2.6-x86_64" "$man" 2>"$w.diff" || dn=$(grep -c 'FAILED\|not in the manifest\|No such' "$w.diff" || echo 1)
    n=$(grep -vc '^#' "$man")
    st=0; oracle_verdict gcc "$man" "$dn" "$n" || st=1; rm -rf "$w" "$w.diff"; exit $st ;;
  key) key ;;
  fresh) fresh ;;
  ensure) "$0" prepare && { fresh || "$0" read; } ;;
  read)
    "$0" prepare
    k=$(key)
    if ! fresh; then
      [ -d "$forms" ] && echo "musl: the forms cache's key is not the checkout's (repr/c or the host changed): reread" >&2
      rm -rf "$forms"
    fi
    cd "$m" && arbace_tool -p "$root" -e "(require 'arbace.c.musl 'arbace.repr.c.host)" \
      -e "(let [h (arbace.repr.c.host/load-host \"$root/test/c/host\") errs (arbace.c.musl/read-all h \"$root\" ${CI_THREADS:-4})] (doseq [[s e] (sort errs)] (println \"musl: not read:\" s e)) (arbace.c.musl/index \"$root\") (println \"musl: read, the index\" (count errs) \"not read\"))" && printf '%s\n' "$k" > "$forms/key" ;;
  *) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac

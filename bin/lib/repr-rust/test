#!/bin/bash
# repr/rust's own cases (bin/repr-rust test; doc/rust/RUST-NOTES.md, "Checks"):
#   1. the reader's samples (test/rust/reader-samples.txt, SPEC Appendix A, E1): read again by
#      test/rust/reader_samples.ae, the same as test/rust/reader-samples.out;
#   2. the worked example (SPEC Appendix B): test/rust/sample/shapes.rs dumped by the helper and
#      converted (the crate shapes, a binary, the namespace rs.sample.shapes), the same forms as the
#      spec's hand-written test/rust/sample/shapes.ae (as data, rs/file and its :config on the keys
#      the spec writes), each top-level form at the same line;
#   3. its round trip: printed, parsed by rustc to the same tree and lines (rsdump tree);
#   4. the round trip of test/rust/sample/constructs.rs, constructs std's five crates use rarely or
#      not at all (shebang, unions, trait aliases, C variadics, labeled blocks, let-else, try
#      blocks, literals of every kind, attributes on expressions...);
#   5. the interface level (SPEC §11.3, RR2): rustdoc's JSON of the worked example and of
#      test/rust/sample/attrs.rs (cfg'd items, whose attributes' texts hold spans; indented by two
#      spaces, so the printed file's columns differ) equal to their printed files' without spans,
#      and that of a copy of shapes.rs with one doc comment changed found different;
#   6. mode :full (SPEC §9.2, RR3): the worked example, constructs.rs, attrs.rs and
#      test/rust/sample/space.rs (tabs, trailing blanks, a form feed, raw identifiers, an identifier
#      not in NFC, trailing commas, comments everywhere, no final newline), and a copy of space.rs
#      with a byte order mark and CRLF line ends, converted with --full and printed in the full
#      layout byte for byte; the worked example's forms with a name changed (largest, highest)
#      print as the original with that name changed; in mode :lines the plain comments of
#      space.rs are ; comments of its forms text.
# Usage: bin/lib/repr-rust/test (from bin/repr-rust test). Scratch in .tmp/repr-rust/test.
set -euo pipefail
root=$(cd "$(dirname "$0")/../../.." && pwd)
. "$root/bin/lib/tools.bash"
"$root/bin/repr-rust" helper
helper=$root/.tmp/repr-rust/rsdump
work=$root/.tmp/repr-rust/test
rm -rf "$work"; mkdir -p "$work"
fail=0

echo "== 1. the reader's samples (test/rust/reader-samples.txt)"
(cd "$root" && arbace_tool test/rust/reader_samples.ae test/rust/reader-samples.txt) > "$work/reader-samples.out" 2>&1
if diff -u "$root/test/rust/reader-samples.out" "$work/reader-samples.out" > "$work/reader-samples.diff"; then
  echo "ok: $(grep -c '=>\|!!' "$work/reader-samples.out") samples read as recorded"
else
  echo "FAIL: the reader's samples differ ($work/reader-samples.diff)"; fail=1
fi

echo "== 2. the worked example converted (test/rust/sample/shapes.rs)"
(cd "$root/test/rust/sample" && "$helper" dump -o "$work/dumps" --edition 2024 shapes.rs)
(cd "$root" && arbace_tool -m arbace.repr.rust read --pin "$root/tools/rsdump/RUSTC_VERSION" -o "$work/forms" --crate shapes --crate-type bin \
   --ns-root rs.sample "$work/dumps/shapes.rs.edn") > "$work/read.log" || { cat "$work/read.log"; fail=1; }
(cd "$root" && arbace_tool -e '
(let [rd (fn [f] (let [r (arbace.lang.LineNumberingPushbackReader. (java.io.StringReader. (slurp f)))]
                   (loop [acc []] (let [x (read {:eof ::e} r)] (if (= x ::e) acc (recur (conj acc x)))))))
      spec (rd "test/rust/sample/shapes.ae")
      conv (rd "'"$work"'/forms/rs/sample/shapes.ae")
      file-of (fn [fs] (first (filter #(and (seq? %) (= (quote rs/file) (first %))) fs)))
      opts (fn [f] (apply hash-map (rest f)))
      want (opts (file-of spec))
      ;; the spec writes rs/file and its :config with fewer keys
      trim (fn [f] (if (and (seq? f) (= (quote rs/file) (first f)))
                     (let [o (opts f)
                           o (select-keys o (keys want))
                           o (update o :config select-keys (keys (:config want)))]
                       (with-meta (apply list (quote rs/file) (mapcat (fn [k] [k (get o k)]) (map first (partition 2 (rest (file-of spec)))))) (meta f)))
                     f))
      conv (mapv trim conv)
      bad (remove (fn [[a b]] (and (= a b) (= (:line (meta a)) (:line (meta b))))) (map vector spec conv))]
  (doseq [[a b] bad] (println "spec:     " (:line (meta a)) (pr-str a)) (println "converted:" (:line (meta b)) (pr-str b)))
  (if (and (empty? bad) (= (count spec) (count conv)))
    (println "ok:" (count conv) "forms, as the spec writes them, at the same lines")
    (do (println "FAIL: the converted forms differ from the spec'"'"'s") (System/exit 1))))') || fail=1

echo "== 3. the worked example's round trip"
(cd "$root" && arbace_tool -m arbace.repr.rust print -o "$work/printed" "$work/forms/rs/sample/shapes.ae") > "$work/print.log" || { cat "$work/print.log"; fail=1; }
(cd "$root/test/rust/sample" && "$helper" tree -o "$work/orig" --edition 2024 shapes.rs)
(cd "$work/printed" && "$helper" tree -o "$work/cand" --edition 2024 shapes.rs) || true
if cmp -s "$work/orig/shapes.rs.tree" "$work/cand/shapes.rs.tree" && cmp -s "$work/orig/shapes.rs.lines" "$work/cand/shapes.rs.lines"; then
  echo "ok: the printed file parses to the same tree and lines ($(wc -l < "$work/orig/shapes.rs.lines") spans)"
else
  echo "FAIL: the printed file ($work/printed/shapes.rs) parses to another tree or other lines"; fail=1
fi
echo "== 4. the round trip of test/rust/sample/constructs.rs"
(cd "$root/test/rust/sample" && "$helper" dump -o "$work/dumps" --edition 2024 constructs.rs)
(cd "$root" && arbace_tool -m arbace.repr.rust read --pin "$root/tools/rsdump/RUSTC_VERSION" -o "$work/forms" \
   "$work/dumps/constructs.rs.edn") > "$work/read4.log" || { cat "$work/read4.log"; fail=1; }
(cd "$root" && arbace_tool -m arbace.repr.rust print -o "$work/printed" "$work/forms/rs/main/constructs.ae") > "$work/print4.log" || { cat "$work/print4.log"; fail=1; }
(cd "$root/test/rust/sample" && "$helper" tree -o "$work/orig" --edition 2024 constructs.rs)
(cd "$work/printed" && "$helper" tree -o "$work/cand" --edition 2024 constructs.rs) || true
if cmp -s "$work/orig/constructs.rs.tree" "$work/cand/constructs.rs.tree" && cmp -s "$work/orig/constructs.rs.lines" "$work/cand/constructs.rs.lines"; then
  echo "ok: the printed file parses to the same tree and lines ($(wc -l < "$work/orig/constructs.rs.lines") spans)"
else
  echo "FAIL: the printed file ($work/printed/constructs.rs) parses to another tree or other lines"; fail=1
fi
echo "== 5. the interface level of the worked example and of test/rust/sample/attrs.rs"
(cd "$root/test/rust/sample" && "$helper" dump -o "$work/dumps" --edition 2024 attrs.rs)
(cd "$root" && arbace_tool -m arbace.repr.rust read --pin "$root/tools/rsdump/RUSTC_VERSION" -o "$work/forms" \
   "$work/dumps/attrs.rs.edn") > "$work/read5.log" || { cat "$work/read5.log"; fail=1; }
(cd "$root" && arbace_tool -m arbace.repr.rust print -o "$work/printed" "$work/forms/rs/main/attrs.ae") > "$work/print5.log" || { cat "$work/print5.log"; fail=1; }
doc() { # DIR OUT CRATE TYPE: rustdoc's JSON of DIR/CRATE.rs into OUT/CRATE/CRATE.json
  mkdir -p "$2/$3"
  (cd "$1" && RUSTC_BOOTSTRAP=1 rustdoc --edition 2024 --crate-name "$3" --crate-type "$4" -Zunstable-options \
     --output-format json -o "$2/$3" "$3.rs") > "$2/$3/$3.log" 2>&1 || { echo "FAIL: rustdoc failed ($2/$3/$3.log)"; fail=1; }
}
mkdir -p "$work/mutated"
sed 's|^/// A shape\.$|/// A form.|' "$root/test/rust/sample/shapes.rs" > "$work/mutated/shapes.rs"
doc "$root/test/rust/sample" "$work/iface/orig" shapes bin; doc "$work/printed" "$work/iface/cand" shapes bin
doc "$work/mutated" "$work/iface/mutated" shapes bin
doc "$root/test/rust/sample" "$work/iface/orig" attrs lib; doc "$work/printed" "$work/iface/cand" attrs lib
iface() { (cd "$root" && arbace_tool -m arbace.repr.rust compare-iface --crates "$1" --orig "$work/iface/orig" --cand "$work/iface/$2"); }
for c in shapes attrs; do
  if iface $c cand > "$work/iface/$c.log" 2>&1; then
    echo "ok: rustdoc's JSON of the printed $c.rs is the original's without spans: $(grep "^ok $c" "$work/iface/$c.log" | cut -d' ' -f3-)"
  else
    cat "$work/iface/$c.log"; echo "FAIL: rustdoc's JSON of the printed $c.rs differs"; fail=1
  fi
done
if iface shapes mutated > "$work/iface/mutated.log" 2>&1; then
  echo "FAIL: a changed doc comment was not found ($work/iface/mutated.log)"; fail=1
elif grep -q '^DIFFERS shapes .*:differs' "$work/iface/mutated.log"; then
  echo "ok: a changed doc comment is found (shapes.rs, item $(sed -n 's/^  original, item \([0-9]*\).*/\1/p' "$work/iface/mutated.log"))"
else
  cat "$work/iface/mutated.log"; echo "FAIL: the changed copy's comparison failed otherwise"; fail=1
fi
echo "== 6. mode :full: the samples printed back byte for byte"
mkdir -p "$work/full/src"
cp "$root"/test/rust/sample/{shapes,constructs,attrs,space}.rs "$work/full/src/"
(printf '\xef\xbb\xbf'; sed 's/$/\r/' "$root/test/rust/sample/space.rs") > "$work/full/src/crlf.rs"
for f in shapes constructs attrs space crlf; do
  (cd "$work/full/src" && "$helper" dump --full -o "$work/full/dumps" --edition 2024 $f.rs) || fail=1
done
(cd "$root" && arbace_tool -m arbace.repr.rust read --full --pin "$root/tools/rsdump/RUSTC_VERSION" -o "$work/full/forms" \
   "$work"/full/dumps/*.edn) > "$work/full/read.log" || { cat "$work/full/read.log"; fail=1; }
(cd "$root" && arbace_tool -m arbace.repr.rust print --layout full -o "$work/full/printed" "$work"/full/forms/rs/main/*.ae) > "$work/full/print.log" ||
  { cat "$work/full/print.log"; fail=1; }
for f in shapes constructs attrs space crlf; do
  if cmp -s "$work/full/src/$f.rs" "$work/full/printed/$f.rs"; then
    echo "ok: $f.rs printed back byte for byte ($(wc -c < "$work/full/src/$f.rs") bytes)"
  else
    echo "FAIL: $f.rs printed in the full layout differs ($work/full/printed/$f.rs)"; fail=1
  fi
done
mkdir -p "$work/full/renamed/forms" "$work/full/renamed/want"
sed 's/\blargest\b/highest/g' "$work/full/forms/rs/main/shapes.ae" > "$work/full/renamed/forms/shapes.ae"
sed 's/\blargest\b/highest/g' "$root/test/rust/sample/shapes.rs" > "$work/full/renamed/want/shapes.rs"
(cd "$root" && arbace_tool -m arbace.repr.rust print --layout full -o "$work/full/renamed/printed" "$work/full/renamed/forms/shapes.ae") > "$work/full/renamed.log" ||
  { cat "$work/full/renamed.log"; fail=1; }
if cmp -s "$work/full/renamed/want/shapes.rs" "$work/full/renamed/printed/shapes.rs" && ! cmp -s "$work/full/renamed/want/shapes.rs" "$root/test/rust/sample/shapes.rs"; then
  echo "ok: the worked example's forms with a name changed print as the original with the name changed"
else
  echo "FAIL: the renamed forms print otherwise ($work/full/renamed/printed/shapes.rs)"; fail=1
fi
(cd "$work/full/src" && "$helper" dump -o "$work/full/lines-dumps" --edition 2024 space.rs) || fail=1
(cd "$root" && arbace_tool -m arbace.repr.rust read --pin "$root/tools/rsdump/RUSTC_VERSION" -o "$work/full/lines" \
   "$work/full/lines-dumps/space.rs.edn") > "$work/full/lines.log" || { cat "$work/full/lines.log"; fail=1; }
n=$(grep -c ';' "$work/full/lines/rs/main/space.ae" || true)
if grep -q '^;; the end, with no newline$' "$work/full/lines/rs/main/space.ae" && grep -q ' ; tab, then spaces$' "$work/full/lines/rs/main/space.ae"; then
  echo "ok: mode :lines writes space.rs's plain comments as ; comments ($n lines)"
else
  echo "FAIL: space.rs's comments are not in its forms text of mode :lines ($work/full/lines/rs/main/space.ae)"; fail=1
fi
exit $fail

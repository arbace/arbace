#!/bin/bash
# repr/rust's own cases (bin/repr-rust test; doc/rust/RUST-NOTES.md, "Checks"):
#   1. the reader's samples (test/rust/reader-samples.txt, SPEC Appendix A, E1): read again by
#      test/rust/reader_samples.ae, the same as test/rust/reader-samples.out;
#   2. the worked example (SPEC Appendix B): test/rust/sample/shapes.rs dumped by the helper and
#      converted (the crate shapes, a binary, the namespace rs.sample.shapes), the same forms as the
#      spec's hand-written test/rust/sample/shapes.ae (as data, rs/file and its :config on the keys
#      the spec writes), each top-level form at the same line;
#   3. its round trip: printed, parsed by rustc to the same tree and lines (rsdump tree);
#   4. the round trip of test/rust/sample/constructs.rs, constructs std's five crates use rarely or
#      not at all (shebang, unions, trait aliases, C variadics, labeled blocks, let-else, try
#      blocks, literals of every kind, attributes on expressions...);
#   5. the interface level (SPEC §11.3, RR2): rustdoc's JSON of the worked example and of
#      test/rust/sample/attrs.rs (cfg'd items, whose attributes' texts hold spans; indented by two
#      spaces, so the printed file's columns differ) equal to their printed files' without spans,
#      and that of a copy of shapes.rs with one doc comment changed found different;
#   6. mode :full (SPEC §9.2, RR3): the worked example, constructs.rs, attrs.rs and
#      test/rust/sample/space.rs (tabs, trailing blanks, a form feed, raw identifiers, an identifier
#      not in NFC, trailing commas, comments everywhere, no final newline), and a copy of space.rs
#      with a byte order mark and CRLF line ends, converted with --full and printed in the full
#      layout byte for byte; the worked example's forms with a name changed (largest, highest)
#      print as the original with that name changed; in mode :lines the plain comments of
#      space.rs are ; comments of its forms text;
#   7. edition 2015 (RR4): test/rust/sample/edition2015.rs (anonymous parameters, bare trait
#      objects, dyn, async, await, try and gen as names, ... ranges), which edition 2018 rejects,
#      round-tripped at --edition 2015: trees and lines, and mode :full byte for byte;
#   8. the pretty layout (SPEC §9.4, 2; RR4): the samples' forms of mode :lines without their
#      positions printed in the pretty layout, parsed by rustc to the original's tree;
#   9. the behaviour level (RR5): test/rust/sample/behaviour.rs (attributes on operands and in
#      fixed places, an empty binder, a closure's _ type, a struct named union, a panic), its trees
#      and lines and mode :full byte for byte, then built and run by bin/lib/repr-rust/run-program
#      from the original and from its printed file of mode :lines: the same stdout and exit status,
#      its stderr the same once the panic's column is normalized (same-cols), not before;
#  10. the lowered and code levels and an expression file of include! (RR6):
#      test/rust/sample/lowered_table.rs, an expression over lines, dumped with --expr, converted
#      to one (rs/expr ...) form, its trees and lines equal printed in the three layouts and mode
#      :full byte for byte; test/rust/sample/lowered.rs (a closure, an impl, a cfg'd item, a panic,
#      a box dropped at a closing brace of its own, the include!) built by bin/lib/repr-rust/
#      code-unit from the originals and from the printed files of each layout: its HIR, MIR and
#      objects the same (mode :lines' objects once the locations' lines are left out), and a copy
#      with one literal changed found different at the three levels.
# rustc's part (ORS12, doc/ORACLE-RECORDS-SURVEY.md, "As built: Rust"): two kinds of call. What rustc says of a fixed input (the helper's
# dumps and trees of the originals, rustdoc's JSON of the originals, whether edition 2018 parses edition2015.rs) is recorded:
# test/rust/records/test/ with its manifest test/rust/records/test.tsv (committed, ORS2 (a): the essential step needs no store), made by
# --record, the dumps' :abs written @WORK@/... (the converter reads the file it names: the unpack puts the scratch directory back). What
# rustc says of Arbace's output (the helper's trees of the printed files, rustdoc of them, their builds and runs, their HIR, MIR and objects)
# is class D and runs only with --oracle.
# Usage: bin/lib/repr-rust/test [--oracle | --record | --verify-records] (from bin/repr-rust test). Scratch in .tmp/repr-rust/test.
#   (none)            every case on the records: no rustc; the checks that judge rustc's reading of the printed files are listed as skipped
#   --oracle          every case, rustc live (the oracle tier's rust-test-oracle; the day's work on the helper)
#   --record          the originals' outputs made live and recorded in test/rust/records/ (by hand, a commit of its own naming :rustc's identity)
#   --verify-records  the originals' outputs made live again and compared with the records byte for byte (ORS6 (a)'s verdict; the crossed pair)
set -euo pipefail
root=$(cd "$(dirname "$0")/../../.." && pwd)
. "$root/bin/lib/tools.bash"
. "$root/bin/lib/repr-rust/records.bash"
oracle="" record="" verify=""
while [ $# -gt 0 ]; do
  case $1 in
    --oracle) oracle=1; shift ;;
    --record) record=1; shift ;;
    --verify-records) verify=1; shift ;;
    *) echo "usage: bin/repr-rust test [--oracle | --record | --verify-records]" >&2; exit 2 ;;
  esac
done
live=""; { [ -n "$oracle" ] || [ -n "$record" ] || [ -n "$verify" ]; } && live=1
work=$root/.tmp/repr-rust/test
rm -rf "$work"; mkdir -p "$work"
fail=0
if [ -n "$live" ]; then
  "$root/bin/repr-rust" helper
  helper=$root/.tmp/repr-rust/rsdump
fi
# the tools' host first, so that stage 0's build messages (after the seed changed) are not in an
# output compared below
. "$root/bin/lib/host.bash"
arbace_host_exe > "$work/host-exe.txt" || exit 1

skip() { echo "skipped: $1 (class D: --oracle, the oracle tier's rust-test-oracle)"; }

# the inputs' copies (the dumps name them by :abs and the converter reads them): the full layout's, edition 2015's, the behaviour level's and
# the code levels'; the mutated worked example (one doc comment changed), the CRLF copy of space.rs
mkdir -p "$work/full/src" "$work/e15/src" "$work/behaviour/src" "$work/code/src" "$work/mutated"
cp "$root"/test/rust/sample/{shapes,constructs,attrs,space}.rs "$work/full/src/"
(printf '\xef\xbb\xbf'; sed 's/$/\r/' "$root/test/rust/sample/space.rs") > "$work/full/src/crlf.rs"
cp "$root/test/rust/sample/edition2015.rs" "$work/e15/src/"
cp "$root/test/rust/sample/behaviour.rs" "$work/behaviour/src/"
cp "$root/test/rust/sample/lowered.rs" "$root/test/rust/sample/lowered_table.rs" "$work/code/src/"
sed 's|^/// A shape\.$|/// A form.|' "$root/test/rust/sample/shapes.rs" > "$work/mutated/shapes.rs"

# live_origs: rustc's answers about the fixed inputs (the originals), into $work: the helper's dumps (both modes, the expression file)
# and trees, rustdoc's JSON, and whether edition 2018 parses edition2015.rs. The cases' inputs: test/rust/sample. Recorded by --record.
doc() { # DIR OUT CRATE TYPE: rustdoc's JSON of DIR/CRATE.rs into OUT/CRATE/CRATE.json
  mkdir -p "$2/$3"
  (cd "$1" && RUSTC_BOOTSTRAP=1 rustdoc --edition 2024 --crate-name "$3" --crate-type "$4" -Zunstable-options \
     --output-format json -o "$2/$3" "$3.rs") > "$2/$3/$3.log" 2>&1 || { echo "FAIL: rustdoc failed ($2/$3/$3.log)"; fail=1; }
}
live_origs() {
  local f
  # 2-4: the worked example, constructs.rs, attrs.rs
  (cd "$root/test/rust/sample" && "$helper" dump -o "$work/dumps" --edition 2024 shapes.rs constructs.rs attrs.rs &&
     "$helper" tree -o "$work/orig" --edition 2024 shapes.rs constructs.rs)
  # 5: rustdoc's JSON of the worked example and attrs.rs, and of the mutated copy
  doc "$root/test/rust/sample" "$work/iface/orig" shapes bin; doc "$root/test/rust/sample" "$work/iface/orig" attrs lib
  doc "$work/mutated" "$work/iface/mutated" shapes bin
  # 6: mode :full's dumps of the five files, and space.rs's lines dump
  for f in shapes constructs attrs space crlf; do
    (cd "$work/full/src" && "$helper" dump --full -o "$work/full/dumps" --edition 2024 $f.rs) || fail=1
  done
  (cd "$work/full/src" && "$helper" dump -o "$work/full/lines-dumps" --edition 2024 space.rs) || fail=1
  # 7: edition 2015
  (cd "$work/e15/src" && "$helper" dump -o "$work/e15/dumps" --edition 2015 edition2015.rs && "$helper" dump --full -o "$work/e15/full-dumps" --edition 2015 edition2015.rs &&
     "$helper" tree -o "$work/e15/orig" --edition 2015 edition2015.rs) || fail=1
  if (cd "$work/e15/src" && "$helper" tree -o "$work/e15/as2018" --edition 2018 edition2015.rs) > "$work/e15/as2018.log" 2>&1; then echo parses > "$work/e15/as2018.verdict"
  else echo rejected > "$work/e15/as2018.verdict"; fi
  # 8: the pretty layout's originals' trees (shapes, constructs, attrs, space at 2024; edition2015 at 2015)
  mkdir -p "$work/pretty/orig"
  for f in shapes constructs attrs space; do (cd "$root/test/rust/sample" && "$helper" tree -o "$work/pretty/orig" --edition 2024 $f.rs) || fail=1; done
  (cd "$work/e15/src" && "$helper" tree -o "$work/pretty/orig" --edition 2015 edition2015.rs) || fail=1
  # 9: the behaviour level's file
  (cd "$work/behaviour/src" && "$helper" dump -o "$work/behaviour/dumps" --edition 2021 behaviour.rs && "$helper" dump --full -o "$work/behaviour/full-dumps" --edition 2021 behaviour.rs &&
     "$helper" tree -o "$work/behaviour/orig" --edition 2021 behaviour.rs) || fail=1
  # 10: the lowered and code levels' files, one an expression file of include!
  (cd "$work/code/src" && "$helper" dump --expr -o "$work/code/dumps" --edition 2024 lowered_table.rs && "$helper" dump -o "$work/code/dumps" --edition 2024 lowered.rs &&
     "$helper" dump --full --expr -o "$work/code/full-dumps" --edition 2024 lowered_table.rs && "$helper" dump --full -o "$work/code/full-dumps" --edition 2024 lowered.rs &&
     "$helper" tree --expr -o "$work/code/orig" --edition 2024 lowered_table.rs) || fail=1
}

# the records: test/rust/records/test/ID for each line of the manifest test/rust/records/test.tsv (ID, KEY, SHA256, SIZE; the files are
# the helper's outputs and rustdoc's JSON under $work, the dumps' :abs normalized to @WORK@ and @ROOT@), one key for all of them: the
# helper's digest (its source, its pins) and the digest of every input of the cases and of live_origs' text, so a change of any of them
# makes the records STALE (ORS10 (a))
rec_dir=$root/test/rust/records/test
rec_man=$root/test/rust/records/test.tsv
rec_key() {
  { rsr_helper_hash
    (cd "$root/test/rust" && find sample -type f | LC_ALL=C sort | xargs sha256sum)
    sed -n '/^live_origs() {/,/^}/p' "$root/bin/lib/repr-rust/test"; } | sha256sum | cut -c1-64
}
rec_files() { # the recorded files under $work (right after live_origs: nothing else made yet but the inputs' copies and logs)
  (cd "$work" && find . -type f \( -name '*.edn' -o -name '*.tree' -o -name '*.lines' -o -name '*.json' -o -name '*.verdict' \) | sed 's|^\./||' | LC_ALL=C sort)
}
abs_norm() { # the dumps' :abs: the scratch directory is @WORK@, the checkout @ROOT@ (and back, when a record is unpacked)
  local f
  for f in $(cd "$work" && find . -name '*.edn' | sed 's|^\./||'); do sed -i "s|$work|@WORK@|g; s|$root|@ROOT@|g" "$work/$f"; done
}
abs_back() {
  local f
  for f in $(cd "$work" && find . -name '*.edn' | sed 's|^\./||'); do sed -i "s|@WORK@|$work|g; s|@ROOT@|$root|g" "$work/$f"; done
}
if [ -z "$live" ]; then
  rsr_records_unpack "$rec_man" "$rec_dir" "$(rec_key)" "$work" || { echo "FAIL: the records ($rec_man)"; exit 1; }
  abs_back
else
  live_origs
  if [ -n "$record" ]; then abs_norm; rec_files > "$work/rec.files"; rsr_records_make "$rec_man" "$rec_dir" "$work" "$work/rec.files" "$(rec_key)" "bin/repr-rust test --record"; exit $?; fi
  if [ -n "$verify" ]; then abs_norm; rec_files > "$work/rec.files"; rsr_records_verify "$rec_man" "$rec_dir" "$work" "$work/rec.files"; exit $?; fi
fi

echo "== 1. the reader's samples (test/rust/reader-samples.txt)"
(cd "$root" && arbace_tool test/rust/reader_samples.ae test/rust/reader-samples.txt) > "$work/reader-samples.out" 2>&1
if diff -u "$root/test/rust/reader-samples.out" "$work/reader-samples.out" > "$work/reader-samples.diff"; then
  echo "ok: $(grep -c '=>\|!!' "$work/reader-samples.out") samples read as recorded"
else
  echo "FAIL: the reader's samples differ ($work/reader-samples.diff)"; fail=1
fi

echo "== 2. the worked example converted (test/rust/sample/shapes.rs)"
(cd "$root" && arbace_tool -m arbace.repr.rust read --pin "$root/tools/rsdump/RUSTC_VERSION" -o "$work/forms" --crate shapes --crate-type bin \
   --ns-root rs.sample "$work/dumps/shapes.rs.edn") > "$work/read.log" || { cat "$work/read.log"; fail=1; }
(cd "$root" && arbace_tool -e '
(let [rd (fn [f] (let [r (arbace.lang.LineNumberingPushbackReader. (java.io.StringReader. (slurp f)))]
                   (loop [acc []] (let [x (read {:eof ::e} r)] (if (= x ::e) acc (recur (conj acc x)))))))
      spec (rd "test/rust/sample/shapes.ae")
      conv (rd "'"$work"'/forms/rs/sample/shapes.ae")
      file-of (fn [fs] (first (filter #(and (seq? %) (= (quote rs/file) (first %))) fs)))
      opts (fn [f] (apply hash-map (rest f)))
      want (opts (file-of spec))
      ;; the spec writes rs/file and its :config with fewer keys
      trim (fn [f] (if (and (seq? f) (= (quote rs/file) (first f)))
                     (let [o (opts f)
                           o (select-keys o (keys want))
                           o (update o :config select-keys (keys (:config want)))]
                       (with-meta (apply list (quote rs/file) (mapcat (fn [k] [k (get o k)]) (map first (partition 2 (rest (file-of spec)))))) (meta f)))
                     f))
      conv (mapv trim conv)
      bad (remove (fn [[a b]] (and (= a b) (= (:line (meta a)) (:line (meta b))))) (map vector spec conv))]
  (doseq [[a b] bad] (println "spec:     " (:line (meta a)) (pr-str a)) (println "converted:" (:line (meta b)) (pr-str b)))
  (if (and (empty? bad) (= (count spec) (count conv)))
    (println "ok:" (count conv) "forms, as the spec writes them, at the same lines")
    (do (println "FAIL: the converted forms differ from the spec'"'"'s") (System/exit 1))))') || fail=1

# tree_same ORIGDIR CANDDIR FILE [lines|nolines]: rustc's tree (and lines) of the original and of the printed file equal (class D: the candidate's is rustc's
# reading of Arbace's print, made only with --oracle)
echo "== 3. the worked example's round trip"
(cd "$root" && arbace_tool -m arbace.repr.rust print -o "$work/printed" "$work/forms/rs/sample/shapes.ae") > "$work/print.log" || { cat "$work/print.log"; fail=1; }
if [ -n "$oracle" ]; then
  (cd "$work/printed" && "$helper" tree -o "$work/cand" --edition 2024 shapes.rs) || true
  if cmp -s "$work/orig/shapes.rs.tree" "$work/cand/shapes.rs.tree" && cmp -s "$work/orig/shapes.rs.lines" "$work/cand/shapes.rs.lines"; then
    echo "ok: the printed file parses to the same tree and lines ($(wc -l < "$work/orig/shapes.rs.lines") spans)"
  else
    echo "FAIL: the printed file ($work/printed/shapes.rs) parses to another tree or other lines"; fail=1
  fi
else skip "the printed worked example's tree and lines by rustc"; fi
echo "== 4. the round trip of test/rust/sample/constructs.rs"
(cd "$root" && arbace_tool -m arbace.repr.rust read --pin "$root/tools/rsdump/RUSTC_VERSION" -o "$work/forms" \
   "$work/dumps/constructs.rs.edn") > "$work/read4.log" || { cat "$work/read4.log"; fail=1; }
(cd "$root" && arbace_tool -m arbace.repr.rust print -o "$work/printed" "$work/forms/rs/main/constructs.ae") > "$work/print4.log" || { cat "$work/print4.log"; fail=1; }
if [ -n "$oracle" ]; then
  (cd "$work/printed" && "$helper" tree -o "$work/cand" --edition 2024 constructs.rs) || true
  if cmp -s "$work/orig/constructs.rs.tree" "$work/cand/constructs.rs.tree" && cmp -s "$work/orig/constructs.rs.lines" "$work/cand/constructs.rs.lines"; then
    echo "ok: the printed file parses to the same tree and lines ($(wc -l < "$work/orig/constructs.rs.lines") spans)"
  else
    echo "FAIL: the printed file ($work/printed/constructs.rs) parses to another tree or other lines"; fail=1
  fi
else skip "the printed constructs.rs's tree and lines by rustc"; fi
echo "== 5. the interface level of the worked example and of test/rust/sample/attrs.rs"
(cd "$root" && arbace_tool -m arbace.repr.rust read --pin "$root/tools/rsdump/RUSTC_VERSION" -o "$work/forms" \
   "$work/dumps/attrs.rs.edn") > "$work/read5.log" || { cat "$work/read5.log"; fail=1; }
(cd "$root" && arbace_tool -m arbace.repr.rust print -o "$work/printed" "$work/forms/rs/main/attrs.ae") > "$work/print5.log" || { cat "$work/print5.log"; fail=1; }
iface() { (cd "$root" && arbace_tool -m arbace.repr.rust compare-iface --crates "$1" --orig "$work/iface/orig" --cand "$work/iface/$2"); }
if [ -n "$oracle" ]; then
  doc "$work/printed" "$work/iface/cand" shapes bin; doc "$work/printed" "$work/iface/cand" attrs lib
  for c in shapes attrs; do
    if iface $c cand > "$work/iface/$c.log" 2>&1; then
      echo "ok: rustdoc's JSON of the printed $c.rs is the original's without spans: $(grep "^ok $c" "$work/iface/$c.log" | cut -d' ' -f3-)"
    else
      cat "$work/iface/$c.log"; echo "FAIL: rustdoc's JSON of the printed $c.rs differs"; fail=1
    fi
  done
else skip "rustdoc's JSON of the printed shapes.rs and attrs.rs"; fi
# the changed doc comment: rustdoc's JSON of two originals (the worked example and its mutated copy, both recorded)
if iface shapes mutated > "$work/iface/mutated.log" 2>&1; then
  echo "FAIL: a changed doc comment was not found ($work/iface/mutated.log)"; fail=1
elif grep -q '^DIFFERS shapes .*:differs' "$work/iface/mutated.log"; then
  echo "ok: a changed doc comment is found (shapes.rs, item $(sed -n 's/^  original, item \([0-9]*\).*/\1/p' "$work/iface/mutated.log"))"
else
  cat "$work/iface/mutated.log"; echo "FAIL: the changed copy's comparison failed otherwise"; fail=1
fi
echo "== 6. mode :full: the samples printed back byte for byte"
(cd "$root" && arbace_tool -m arbace.repr.rust read --full --pin "$root/tools/rsdump/RUSTC_VERSION" -o "$work/full/forms" \
   "$work"/full/dumps/*.edn) > "$work/full/read.log" || { cat "$work/full/read.log"; fail=1; }
(cd "$root" && arbace_tool -m arbace.repr.rust print --layout full -o "$work/full/printed" "$work"/full/forms/rs/main/*.ae) > "$work/full/print.log" ||
  { cat "$work/full/print.log"; fail=1; }
for f in shapes constructs attrs space crlf; do
  if cmp -s "$work/full/src/$f.rs" "$work/full/printed/$f.rs"; then
    echo "ok: $f.rs printed back byte for byte ($(wc -c < "$work/full/src/$f.rs") bytes)"
  else
    echo "FAIL: $f.rs printed in the full layout differs ($work/full/printed/$f.rs)"; fail=1
  fi
done
mkdir -p "$work/full/renamed/forms" "$work/full/renamed/want"
sed 's/\blargest\b/highest/g' "$work/full/forms/rs/main/shapes.ae" > "$work/full/renamed/forms/shapes.ae"
sed 's/\blargest\b/highest/g' "$root/test/rust/sample/shapes.rs" > "$work/full/renamed/want/shapes.rs"
(cd "$root" && arbace_tool -m arbace.repr.rust print --layout full -o "$work/full/renamed/printed" "$work/full/renamed/forms/shapes.ae") > "$work/full/renamed.log" ||
  { cat "$work/full/renamed.log"; fail=1; }
if cmp -s "$work/full/renamed/want/shapes.rs" "$work/full/renamed/printed/shapes.rs" && ! cmp -s "$work/full/renamed/want/shapes.rs" "$root/test/rust/sample/shapes.rs"; then
  echo "ok: the worked example's forms with a name changed print as the original with the name changed"
else
  echo "FAIL: the renamed forms print otherwise ($work/full/renamed/printed/shapes.rs)"; fail=1
fi
(cd "$root" && arbace_tool -m arbace.repr.rust read --pin "$root/tools/rsdump/RUSTC_VERSION" -o "$work/full/lines" \
   "$work/full/lines-dumps/space.rs.edn") > "$work/full/lines.log" || { cat "$work/full/lines.log"; fail=1; }
n=$(grep -c ';' "$work/full/lines/rs/main/space.ae" || true)
if grep -q '^;; the end, with no newline$' "$work/full/lines/rs/main/space.ae" && grep -q ' ; tab, then spaces$' "$work/full/lines/rs/main/space.ae"; then
  echo "ok: mode :lines writes space.rs's plain comments as ; comments ($n lines)"
else
  echo "FAIL: space.rs's comments are not in its forms text of mode :lines ($work/full/lines/rs/main/space.ae)"; fail=1
fi
echo "== 7. edition 2015 (test/rust/sample/edition2015.rs): its round trip, mode :full"
(cd "$root" && arbace_tool -m arbace.repr.rust read --pin "$root/tools/rsdump/RUSTC_VERSION" -o "$work/e15/forms" "$work/e15/dumps/edition2015.rs.edn" &&
   arbace_tool -m arbace.repr.rust read --full --pin "$root/tools/rsdump/RUSTC_VERSION" -o "$work/e15/full-forms" "$work/e15/full-dumps/edition2015.rs.edn" &&
   arbace_tool -m arbace.repr.rust print -o "$work/e15/printed" "$work/e15/forms/rs/main/edition2015.ae" &&
   arbace_tool -m arbace.repr.rust print --layout full -o "$work/e15/full-printed" "$work/e15/full-forms/rs/main/edition2015.ae") > "$work/e15/log" 2>&1 ||
  { cat "$work/e15/log"; fail=1; }
if [ -n "$oracle" ]; then
  (cd "$work/e15/printed" && "$helper" tree -o "$work/e15/cand" --edition 2015 edition2015.rs) || true
  if cmp -s "$work/e15/orig/edition2015.rs.tree" "$work/e15/cand/edition2015.rs.tree" && cmp -s "$work/e15/orig/edition2015.rs.lines" "$work/e15/cand/edition2015.rs.lines"; then
    echo "ok: the printed file parses at edition 2015 to the same tree and lines ($(wc -l < "$work/e15/orig/edition2015.rs.lines") spans)"
  else
    echo "FAIL: the printed edition2015.rs parses to another tree or other lines ($work/e15/printed)"; fail=1
  fi
else skip "the printed edition2015.rs's tree and lines by rustc"; fi
if cmp -s "$work/e15/src/edition2015.rs" "$work/e15/full-printed/edition2015.rs"; then
  echo "ok: edition2015.rs printed back byte for byte in mode :full"
else
  echo "FAIL: edition2015.rs printed in the full layout differs ($work/e15/full-printed/edition2015.rs)"; fail=1
fi
if [ "$(cat "$work/e15/as2018.verdict")" = parses ]; then
  echo "FAIL: edition2015.rs parses at edition 2018 too: it tests nothing of 2015"; fail=1
else
  echo "ok: edition2015.rs does not parse at edition 2018"
fi
echo "== 8. the pretty layout: the samples' forms without positions, printed, parse to the same trees"
mkdir -p "$work/pretty"
for f in shapes constructs attrs space edition2015; do
  case $f in edition2015) ed=2015; fm=$work/e15/forms/rs/main/$f.ae ;;
              shapes) ed=2024; fm=$work/forms/rs/sample/$f.ae ;;
              space) ed=2024; fm=$work/full/lines/rs/main/$f.ae ;;
              *) ed=2024; fm=$work/forms/rs/main/$f.ae ;; esac
  (cd "$root" && arbace_tool -m arbace.repr.rust print --layout pretty -o "$work/pretty/printed" "$fm") > "$work/pretty/$f.log" 2>&1 ||
    { cat "$work/pretty/$f.log"; fail=1; }
  if [ -n "$oracle" ]; then
    (cd "$work/pretty/printed" && "$helper" tree -o "$work/pretty/cand" --edition $ed $f.rs) || true
    if cmp -s "$work/pretty/orig/$f.rs.tree" "$work/pretty/cand/$f.rs.tree"; then
      echo "ok: $f.rs in the pretty layout parses to the same tree ($(wc -l < "$work/pretty/printed/$f.rs") lines, the longest $(awk '{ if (length > m) m = length } END { print m }' "$work/pretty/printed/$f.rs") columns)"
    else
      echo "FAIL: $f.rs in the pretty layout parses to another tree ($work/pretty/printed/$f.rs)"; fail=1
    fi
  else skip "$f.rs in the pretty layout, parsed by rustc"; fi
done
echo "== 9. the behaviour level (test/rust/sample/behaviour.rs): built and run from the original and the printed file"
b9=$work/behaviour
(cd "$root" && arbace_tool -m arbace.repr.rust read --pin "$root/tools/rsdump/RUSTC_VERSION" -o "$b9/forms" "$b9/dumps/behaviour.rs.edn" &&
   arbace_tool -m arbace.repr.rust read --full --pin "$root/tools/rsdump/RUSTC_VERSION" -o "$b9/full-forms" "$b9/full-dumps/behaviour.rs.edn" &&
   arbace_tool -m arbace.repr.rust print -o "$b9/printed" "$b9/forms/rs/main/behaviour.ae" &&
   arbace_tool -m arbace.repr.rust print --layout full -o "$b9/full-printed" "$b9/full-forms/rs/main/behaviour.ae") > "$b9/log" 2>&1 ||
  { cat "$b9/log"; fail=1; }
if [ -n "$oracle" ]; then
  (cd "$b9/printed" && "$helper" tree -o "$b9/cand" --edition 2021 behaviour.rs) || true
  if cmp -s "$b9/orig/behaviour.rs.tree" "$b9/cand/behaviour.rs.tree" && cmp -s "$b9/orig/behaviour.rs.lines" "$b9/cand/behaviour.rs.lines" &&
     cmp -s "$b9/src/behaviour.rs" "$b9/full-printed/behaviour.rs"; then
    echo "ok: behaviour.rs's trees and lines equal, and mode :full byte for byte"
  else
    echo "FAIL: behaviour.rs's round trip ($b9/printed, $b9/full-printed)"; fail=1
  fi
  printf 'behaviour.rs\x1fbehaviour.rs\x1f2021\x1f\x1f\x1f\x1f\n' > "$b9/plan.tsv"
  : > "$b9/empty"
  "$root/bin/lib/repr-rust/run-program" "$b9/plan.tsv" 1 "$b9/jobs" "$b9/empty" "orig:$b9/src:" "lines:$b9/printed::cols" "raw:$b9/printed:" > "$b9/results.tsv"
  if [ "$(cut -f1 "$b9/results.tsv" | tr '\n' ' ')" = "same-cols differs " ]; then
    echo "ok: behaviour.rs behaves the same printed, once its panic's column is normalized ($(cut -f1,2 "$b9/results.tsv" | tr '\t\n' ': '))"
  else
    echo "FAIL: behaviour.rs's runs: $(tr '\t\n' ' ;' < "$b9/results.tsv") ($b9)"; fail=1
  fi
else
  # the byte for byte half needs no rustc
  if cmp -s "$b9/src/behaviour.rs" "$b9/full-printed/behaviour.rs"; then echo "ok: behaviour.rs printed back byte for byte in mode :full"
  else echo "FAIL: behaviour.rs printed in the full layout differs ($b9/full-printed)"; fail=1; fi
  skip "behaviour.rs's trees and lines, built and run printed"
fi
echo "== 10. the lowered and code levels, an expression file (test/rust/sample/lowered.rs, lowered_table.rs)"
b10=$work/code
# the expression file: dumped as one expression (--expr), converted in both modes, printed in the
# three layouts; its trees and lines equal, mode :full byte for byte
(cd "$root" && arbace_tool -m arbace.repr.rust read --pin "$root/tools/rsdump/RUSTC_VERSION" -o "$b10/forms" "$b10"/dumps/*.edn &&
   arbace_tool -m arbace.repr.rust read --full --pin "$root/tools/rsdump/RUSTC_VERSION" -o "$b10/full-forms" "$b10"/full-dumps/*.edn &&
   arbace_tool -m arbace.repr.rust print -o "$b10/lines" "$b10"/forms/rs/main/*.ae &&
   arbace_tool -m arbace.repr.rust print --layout pretty -o "$b10/pretty" "$b10"/forms/rs/main/*.ae &&
   arbace_tool -m arbace.repr.rust print --layout full -o "$b10/full" "$b10"/full-forms/rs/main/*.ae) > "$b10/log" 2>&1 ||
  { cat "$b10/log"; fail=1; }
if grep -q '^(rs/expr ' "$b10/forms/rs/main/lowered_table.ae" && grep -q ':kind :include-expr' "$b10/forms/rs/main/lowered_table.ae"; then
  echo "ok: lowered_table.rs is (rs/file ... :kind :include-expr) and one (rs/expr ...) form"
else
  echo "FAIL: lowered_table.rs's forms ($b10/forms/rs/main/lowered_table.ae)"; fail=1
fi
if [ -n "$oracle" ]; then
  ok=1
  for l in lines pretty full; do
    (cd "$b10/$l" && "$helper" tree --expr -o "$b10/$l.trees" --edition 2024 lowered_table.rs) || true
    cmp -s "$b10/orig/lowered_table.rs.tree" "$b10/$l.trees/lowered_table.rs.tree" || ok=0
    if [ $l != pretty ]; then cmp -s "$b10/orig/lowered_table.rs.lines" "$b10/$l.trees/lowered_table.rs.lines" || ok=0; fi
  done
  cmp -s "$b10/src/lowered_table.rs" "$b10/full/lowered_table.rs" || ok=0
  if [ $ok = 1 ]; then
    echo "ok: lowered_table.rs's trees equal in the three layouts, its lines in mode :lines and :full, mode :full byte for byte"
  else
    echo "FAIL: lowered_table.rs's round trip ($b10)"; fail=1
  fi
  # the crate built by bin/lib/repr-rust/code-unit from the originals and from each layout's printed
  # files: its HIR and MIR the same (positions as the layout keeps them), its objects the same (mode
  # :lines: once the locations' lines are left out, a box dropped at a closing brace of its own)
  printf 'lowered\x1flowered.rs\x1flib\x1f--edition 2024 --crate-name lowered --crate-type lib lowered.rs\x1f\n' > "$b10/plan.tsv"
  "$root/bin/lib/repr-rust/code-unit" "$b10/plan.tsv" 1 "$b10/jobs" "orig:$b10/src" "lines:$b10/lines:lines" "full:$b10/full:exact" \
    "pretty:$b10/pretty:pos" > "$b10/results.tsv"
  want="same lines hir|same lines mir|same-lines lines obj|same full hir|same full mir|same full obj|same pretty hir|same pretty mir|same pretty obj"
  got=$(awk -F'\t' '{ printf "%s%s %s %s", (NR > 1 ? "|" : ""), $1, $2, $4 }' "$b10/results.tsv")
  if [ "$got" = "$want" ]; then
    echo "ok: lowered.rs's HIR, MIR and objects the same in the three layouts (mode :lines' objects once the locations' lines are left out)"
  else
    echo "FAIL: lowered.rs's code levels: $got ($b10/results.tsv)"; fail=1
  fi
  # a printed file with one literal changed: found at the three levels
  mkdir -p "$b10/mutated"
  cp "$b10/lines/lowered_table.rs" "$b10/mutated/"
  sed 's/v\[i\] + 1/v[i] + 2/' "$b10/lines/lowered.rs" > "$b10/mutated/lowered.rs"
  "$root/bin/lib/repr-rust/code-unit" "$b10/plan.tsv" 1 "$b10/jobs" "orig:$b10/src" "mutated:$b10/mutated:lines" > "$b10/mutated.tsv"
  if [ "$(cut -f1 "$b10/mutated.tsv" | tr '\n' ' ')" = "differs differs differs " ]; then
    echo "ok: a changed literal is found in the HIR, the MIR and the objects"
  else
    echo "FAIL: the changed copy: $(tr '\t\n' ' ;' < "$b10/mutated.tsv")"; fail=1
  fi
else
  if cmp -s "$b10/src/lowered_table.rs" "$b10/full/lowered_table.rs" && cmp -s "$b10/src/lowered.rs" "$b10/full/lowered.rs"; then
    echo "ok: lowered_table.rs and lowered.rs printed back byte for byte in mode :full"
  else echo "FAIL: the code levels' files in mode :full ($b10/full)"; fail=1; fi
  skip "lowered_table.rs's trees by rustc in the three layouts, and lowered.rs's HIR, MIR and objects (built by rustc)"
fi
exit $fail

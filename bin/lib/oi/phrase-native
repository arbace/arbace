#!/bin/bash
# The toplevel on the native path (bin/oi repl --native, doc/ocaml/TYPER.md, T11): phrase N of the session (on stdin)
# typed and translated by Arbace's typer (arbace.repr.ocaml.typer's phrase verb, on stage 0) as the unit Top_N of WORKDIR,
# the earlier units opened (their signatures kept as WORKDIR/top_K.mli): the same protocol as bin/lib/oi/phrase, no ocamlc.
set -uo pipefail
w=$1 n=$2
root=$(cd "$(dirname "$0")/../../.." && pwd)
cat > "$w/phrase.txt"
exe=${ARBACE_HOST_EXE:-$root/target/seed/amd64/arbace}
ARBACE_PATH="$root" GOMEMLIMIT=${OI_TYPER_GOMEMLIMIT:-1200MiB} GOMAXPROCS=${OI_TYPER_THREADS:-1} "$exe" -m arbace.repr.ocaml.typer \
  phrase --dir "$w" --n "$n" --stdlib "${OI_TYPER_STDLIB:-$root/.tmp/oi/stdlib-native-build}" 2> "$w/typer.err" || { head -c 400 "$w/typer.err"; echo; }

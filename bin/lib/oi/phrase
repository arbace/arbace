#!/bin/bash
# The toplevel's oracle (bin/oi repl, OC12 (a)): phrase N of the session (on stdin) typed and lowered by the
# host's compiler as the unit Top_N of WORKDIR, the earlier units opened: first as an expression (let it__ =
# (PHRASE), printed "- : T = V"), else as structure items. Prints "ok" (WORKDIR/top_N.ae the Lambda dump,
# WORKDIR/top_N.typed the typed dump), or the compiler's error.
set -uo pipefail
w=$1 n=$2
ocd=$(cd "$(dirname "$0")/../../.." && pwd)/.tmp/ocdump/ocdump
cat > "$w/phrase.txt"
opens=""
for f in $(ls "$w" | grep -E '^top_[0-9]+\.cmi$' | sort -t_ -k2 -n); do m=${f%.cmi}; opens="$opens open! ${m^} "; done
try() {
  { echo "$opens"; cat; } > "$w/top_$n.ml"
  (cd "$w" && ocamlc -c -w -a -I . "top_$n.ml") > "$w/err.txt" 2>&1
}
if ! { echo "let it__ = ("; cat "$w/phrase.txt"; echo ")"; } | try; then
  if ! cat "$w/phrase.txt" | try; then cat "$w/err.txt"; rm -f "$w/top_$n.ml"; exit 0; fi
fi
(cd "$w" && "$ocd" --mode types -I . --prefix "top_$n" "top_$n.ml" > "top_$n.typed" && "$ocd" --mode lambda --simplify -I . --prefix "top_$n" "top_$n.ml" > "top_$n.ae")
echo ok

#!/bin/bash
# The lowered side's build of a program (bin/rsi lower-check; doc/rust/EVAL.md §4): run-program's WRAP, called as
#   wrap rustc ARGS...
# in the program's source root with the original's command line, to which it adds what the lowered build needs: one codegen
# unit, the IR (--emit=llvm-ir) without debug records (-C debuginfo=0 after the program's own -g: repr/llvm does not read them,
# and they change only backtraces), the temporaries kept (-C save-temps: the allocator shim's bitcode, survey P5) and the linker
# bin/lib/rsi/link, which lowers the program's IR and the shim's and links their gcc objects in place of rustc's. The unit's
# files go to $RSI_WORK/files/KEY/ (KEY: run-program's RUN_PROGRAM_ID with / and # written %), which RSI_LOW names for the linker.
set -u
here=$(cd "$(dirname "$0")" && pwd)
key=$(printf '%s' "${RUN_PROGRAM_ID:?}" | tr '/#' '%%')
low=${RSI_WORK:?}/files/$key
rm -rf "$low"; mkdir -p "$low"
export RSI_LOW=$low
exec "$@" -C debuginfo=0 -C codegen-units=1 -C save-temps --emit=llvm-ir,link -C linker="$here/link" -C linker-flavor=gcc

#!/bin/bash
# The ci leg's build of a program (bin/rsi check, run; doc/rust/EVAL.md §9): bin/lib/rsi/wrap's command line (one codegen unit,
# the IR without debug records, the temporaries kept) with the linker bin/lib/rsi/link-ir, which keeps the program's IR and the
# allocator shim's in RSI_LOW and links nothing: ci runs the lowered C, not an executable.
#   wrap-ir rustc ARGS...      (RSI_LOW: the program's directory)
set -u
here=$(cd "$(dirname "$0")" && pwd)
mkdir -p "${RSI_LOW:?}"
exec "$@" -C debuginfo=0 -C codegen-units=1 -C save-temps --emit=llvm-ir,link -C linker="$here/link-ir" -C linker-flavor=gcc

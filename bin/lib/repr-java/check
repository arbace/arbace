#!/bin/bash
# Checks of the Java -> Java forms converter (arbace.repr.java), forms-level (doc/STANDALONE-NOTES.md,
# "S4: the JVM removed", O2 (b)): repr/java's output compared with the expected forms committed under
# test/repr/java/expected/, no class files compared with javac's. Writes only under .tmp/repr-java-check/.
#
# Usage: bin/repr-java check [--suite | --update]
#        bin/repr-java check --jdk [MODULE...]   (long; not part of the default checks, see below)
# repr/java runs on the frozen JVM Arbace (bin/repr-java, bin/lib/frozen.bash). The baseline is the frozen
# clojure/ (upstream Clojure and ASM), extracted from the freeze tag into .tmp/frozen/
# (bin/lib/tools.bash's frozen_clojure).
#   1. converts the baseline's 183 Java files (clojure/) with --check: no failures, every file
#      read by arbace.core/read; the converted files equal the expected ones, by their SHA-256
#      (test/repr/java/expected/baseline.sha256: the forms themselves are 2.2 MB, about the size of their
#      Java, and the suite of step 4 is their semantic check);
#   2. converts test/repr/java/java (the language features the baseline does not use) the same way;
#      the converted files equal test/repr/java/expected/java/, byte for byte;
#   3. converts test/repr/java/module (a module declaration and package annotations) likewise, against
#      test/repr/java/expected/module/;
#   4. with --suite: compiles the converted baseline into class files with the frozen jar's own
#      Java forms compiler (test/repr/java/build.ae: the checkout has no back end, O2 (a)) and runs
#      Clojure's test suite on them (bin/clojure-tests, run "converted"), which must show no
#      regressions against test/baseline-results.edn; REPR_JAVA_TEST_JOBS parallel test JVMs
#      (default 16), REPR_JAVA_JVM_OPTS as for bin/repr-java.
# Each converted file's first line names its source: the checkout's path is left out of it
# (clojure/..., test/repr/java/...), so that the output does not depend on where it was made. repr/java's
# report (repr-java-report.edn: timings) is not compared.
# With --update, steps 1-3 then write the expected files from this run (after a change to repr/java or
# to the samples: commit test/repr/java/expected with it).
# With --jdk it instead converts jdk26u's modules (all of $JDK_SRC/*/share/classes, or the
# MODULEs) with --check: no conversion failures (test/repr/java/jdk.bash; work under .tmp/repr-java-jdk/;
# doc/classes/CONVERTER-NOTES.md, "The converted JDK").
#   JDK_SRC     jdk26u's src directory (default /root/jdk26u/src)
# REPR_JAVA_CHECK_WORK names another work directory; REPR_JAVA_HOST=arbace runs read on javac's tool
# executable (bin/repr-java; bin/lib/repr-java/host-check).
# Exit status: 0 when all checks pass.
set -uo pipefail
root=$(cd "$(dirname "$0")/../../.." && pwd)
. "$root/bin/lib/renamed-env.bash" # stops on a stale G2A_*, J2A_*, A2G_* or C2A_*
cd "$root"
. bin/lib/tools.bash
. bin/lib/frozen.bash

if [ "${1:-}" = "--jdk" ]; then
  shift
  exec bash test/repr/java/jdk.bash "$@"
fi
mode=${1:-}
case $mode in ""|--suite|--update) ;; *) sed -n '5,6p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;; esac
work=${REPR_JAVA_CHECK_WORK:-.tmp/repr-java-check}
expected=test/repr/java/expected
rm -rf "$work"
mkdir -p "$work"
status=0
frozen=$(frozen_clojure) || exit 1

# convert NAME SRC-DIR PREFIX [ARGS...]: SRC-DIR into $work/NAME with --check, then each file's
# first line without PREFIX (the checkout's path)
convert() {
  local name=$1 src=$2 prefix=$3
  shift 3
  bin/repr-java read --check "$work/$name" "$src" "$@" | grep -v '^slowest' | tee "$work/$name.log"
  grep -q " 0 failed, 0 javac errors, .* 0 unreadable" "$work/$name.log" || { echo "$name: conversion failures"; return 1; }
  find "$work/$name" -name '*.ae' -exec sed -i "1s|^;; Converted from $prefix/|;; Converted from |" {} +
  if grep -rlF "$root" "$work/$name"; then echo "$name: the forms above name the checkout ($root)"; return 1; fi
}

# manifest DIR: the SHA-256 of every converted file of DIR, by path
manifest() { (cd "$1" && find . -name '*.ae' | sed 's|^\./||' | LC_ALL=C sort | xargs sha256sum); }

echo "== 1. convert the baseline"
if convert baseline "$frozen" "$frozen" clojure; then
  manifest "$work/baseline" > "$work/baseline.sha256"
  if [ "$mode" = --update ]; then
    mkdir -p "$expected" && cp "$work/baseline.sha256" "$expected/baseline.sha256"
  elif diff "$expected/baseline.sha256" "$work/baseline.sha256" > "$work/baseline.diff"; then
    echo "baseline: $(wc -l < "$work/baseline.sha256") files, as expected ($expected/baseline.sha256)"
  else
    echo "baseline: the converted files differ from $expected/baseline.sha256 ($work/baseline.diff):"
    grep '^[<>]' "$work/baseline.diff" | awk '{print $1, $3}' | sort -k2 -u | head -20
    status=1
  fi
else
  status=1
fi

# sample NAME: test/repr/java/NAME converted and compared with (or, --update, written to) expected/NAME
sample() {
  local name=$1
  convert "$name" "$root/test/repr/java/$name" "$root" || return 1
  if [ "$mode" = --update ]; then
    rm -rf "${expected:?}/$name" && mkdir -p "$expected" && cp -r "$work/$name" "$expected/$name" &&
      rm -f "$expected/$name/repr-java-report.edn"
  elif diff -r -x repr-java-report.edn "$expected/$name" "$work/$name" > "$work/$name.diff"; then
    echo "$name: $(find "$work/$name" -name '*.ae' | wc -l) files, as expected ($expected/$name)"
  else
    echo "$name: the converted files differ from $expected/$name ($work/$name.diff):"
    head -40 "$work/$name.diff"
    return 1
  fi
}

echo "== 2. language features (test/repr/java/java)"
sample java || status=1

echo "== 3. a module declaration and package annotations (test/repr/java/module)"
sample module || status=1

[ "$mode" = --update ] && echo "update: $expected written: commit it"

if [ "$mode" = --suite ]; then
  echo "== 4. Clojure's test suite on the converted baseline, compiled by the frozen jar's compiler"
  # compiled against the frozen tree's javac classes (the classes the converted ones replace)
  FROZEN_CP=$frozen frozen_java test -Xss64m ${REPR_JAVA_JVM_OPTS:--Xmx24g} -- \
    -m repr.java.build "$work/baseline" "$work/run/classes" || status=1
  mkdir -p "$work/run/src"
  (cd "$frozen" && find clojure -type f ! -name '*.java' ! -name '*.class' | while read -r f; do
     mkdir -p "$root/$work/run/src/$(dirname "$f")"; cp "$f" "$root/$work/run/src/$f"; done)
  CLOJURE_SRC="$root/$work/run/classes:$root/$work/run/src" CLOJURE_TESTS_RUN=converted \
    bin/clojure-tests -j "${REPR_JAVA_TEST_JOBS:-16}" | tail -6 || status=1
fi
exit $status

#!/bin/bash
# The converter on the native trees (doc/classes/JAVA-FRONTEND-SURVEY.md, "As built: JFS66 (b)"): every
# Java file of the corpora read by bin/repr-java read --front both --split (read-jdk for a module): javac
# on Arbace attributes the files once, the converter converts each unit twice, from javac's attributed
# trees (arbace.repr.java.tree over JCTrees) and from the native parser's trees of the same text
# (arbace.repr.java.parse), its attribution javac's answered by position (arbace.repr.java.attr), and
# the two outputs must be equal, byte for byte (but the known files, below); the native conversion measures the split (which
# attribution facts the converter asks, what each output list needed: OUT/repr-java-split.edn),
# summed by corpus by arbace.repr.java.split (WORK/split.md, split.edn) with the static split of the
# converter's code (WORK/static.edn). Run through bin/repr-java front-check (from the repository root);
# writes only under .tmp/repr-java-front-check/ (REPR_JAVA_FRONT_WORK).
#
# Usage: bin/repr-java front-check [--corpus C,...] [--attr native | --no-javac]
#        bin/repr-java attr-check [--corpus C,...]   (front-check --attr native)
#        bin/repr-java nojavac-check [--corpus C,...] (front-check --no-javac)
# With --attr native (doc/classes/JAVA-FRONTEND-SURVEY.md, "As built: JN9a"; bin/repr-java attr-check), the
# native trees' scope and declarations tiers are answered by the native provider (arbace.repr.java.nattr:
# arbace.repr.java.decls and arbace.repr.java.scope over the native trees and the platform's class
# files) and the rest by javac, each native answer checked against javac's, fact by fact
# (OUT/repr-java-attr.edn): the forms must still equal javac's trees' (but the known files) and no fact
# differ beyond the known counts, both in test/repr/java/attr-check-known.edn, each corpus with at least
# one fact answered natively and equal, and no more facts declined than the known file's {:CORPUS
# {:declined N}} when it gives one (a declined fact is javac's: the forms stay equal); the outcomes summed by
# corpus and tier (WORK/attr.md, attr.edn), the split's share of lists the provider wrote alone
# (WORK/split.md); work under .tmp/repr-java-attr-check/. Since JN9b the provider answers the members
# and types tiers too (arbace.repr.java.expr, arbace.repr.java.types), and the model's reads that bridge
# (a native object's read answered by javac's symbol) must be the known file's :bridges (JFS94 (b)).
# With --no-javac (doc/classes/JAVA-FRONTEND-SURVEY.md, "As built: JN9e"; bin/repr-java nojavac-check), each
# corpus is read twice: by javac's trees (read --front javac, the reference, into .../javac) and without
# javac (read --no-javac: the native parser's trees and the native provider's answers alone, a file that
# meets what only javac answers converted again with javac, counted: OUT/repr-java-nojavac.edn, into
# .../native), the forms equal byte for byte (but test/repr/java/nojavac-check-known.edn's files), the
# reads without javac timed (their wall times summed in WORK/CORPUS.time; the peak memory, each read's
# process's own, in its repr-java-nojavac.edn); the files, fallbacks by reason,
# time and memory summed by corpus (WORK/nojavac.md, nojavac.edn); an inference size limit that fired
# (JFS113 (c)) fails it, and so do fallbacks beyond the known file's {:CORPUS {:fallbacks N}} (none
# when absent: a fallback's forms are javac's, equal by construction); work under .tmp/repr-java-nojavac-check/.
# Corpora (default samples,baseline,jdk,javac; all adds jdk26u):
#   samples   test/repr/java/java and test/repr/java/module (17 files), as bin/repr-java check reads them
#   baseline  the frozen clojure/ (183 files), as bin/repr-java check reads it
#   jdk       java.base's closure (838 files), read-jdk as bin/jrt-convert's convert step reads it, on
#             the originals bin/repr-java parse-check makes (its WORK, jdk-originals)
#   javac     javac's own sources (824 files) module by module, as bin/javac-vendor convert reads them
#   jdk26u    jdk26u's 68 modules (12,730 files), read-jdk module by module as bin/repr-java check
#             --jdk reads them (long: about half an hour)
# Each corpus: WORK/CORPUS/[MODULE/]javac and .../native (the forms), the logs, WORK/CORPUS.diff.
#   JDK_SRC   jdk26u's src directory (default /root/jdk26u/src)
# REPR_JAVA_EXE (bin/repr-java) names javac's tool executable.
# The files whose forms may differ are test/repr/java/front-check-known.edn's, by corpus: none since
# JFS70, which made the converter's pins independent of the history of the javac run (until then three
# files of jdk26u).
# Each read must exit 0 and print both sides' summaries with the same counts (a read that died or
# never started writes nothing, or the same partial set, to both sides), diff (GNU diff) must not
# fail, and a corpus must give at least one forms file.
# Exit status: 0 when every corpus converts without failure and the differing files are known ones.
set -uo pipefail
root=$(cd "$(dirname "$0")/../../.." && pwd)
. "$root/bin/lib/renamed-env.bash" # stops on a stale G2A_*, J2A_*, A2G_* or C2A_*
cd "$root"
. bin/lib/tools.bash
. bin/lib/repr-java/originals.bash
. bin/lib/repr-java/judge.bash
. bin/lib/heavy.bash # heavy_run: the corpus reads under the gate's lock (GTS31 (b))

corpora=samples,baseline,jdk,javac
attr=
nojavac=
while [ $# -gt 0 ]; do
  case $1 in
    --corpus) corpora=$2; shift 2 ;;
    --no-javac) nojavac=1; shift ;;
    --attr) attr=$2; shift 2
            [ "$attr" = native ] || { echo "front-check: --attr native (or none)" >&2; exit 2; } ;;
    *) sed -n '12,14p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
  esac
done
[ "$corpora" = all ] && corpora=samples,baseline,jdk,javac,jdk26u
if [ -n "$nojavac" ]; then
  [ -z "$attr" ] || { echo "front-check: --attr native or --no-javac, not both" >&2; exit 2; }
  work=${REPR_JAVA_FRONT_WORK:-$root/.tmp/repr-java-nojavac-check}
  known=test/repr/java/nojavac-check-known.edn
  attr_opts=()
elif [ -n "$attr" ]; then
  work=${REPR_JAVA_FRONT_WORK:-$root/.tmp/repr-java-attr-check}
  known=test/repr/java/attr-check-known.edn
  attr_opts=(--attr native)
  judge_bridges_empty "$known" || exit 2 # the bridges are uncounted (GT7's audit 061 #7)
else
  work=${REPR_JAVA_FRONT_WORK:-$root/.tmp/repr-java-front-check}
  known=test/repr/java/front-check-known.edn
  attr_opts=()
fi
case $work in /*) ;; *) work=$root/$work ;; esac
judge_jdk_paths || exit 2 # jdk_src, jdk: one tree (GT7's audit 061 #5)
mkdir -p "$work"
status=0
# the comparison needs GNU diff (diffutils, doc/ALPINE.md): busybox's takes no -x, and a diff that
# fails on every pair would leave every corpus "equal"
diff --version 2> /dev/null | grep -q GNU \
  || { echo "front-check: $(command -v diff) is not GNU diff (diffutils, doc/ALPINE.md)" >&2; exit 2; }

# same DIR LOG STATUS: the read (or the two reads) exited 0 (STATUS: the first non-zero status), LOG
# holds both sides' summaries ("N Java files, M converted, ...": javac's trees' and the native trees',
# or the two reads') with the same counts and no failures (a read that died, or never started, wrote
# nothing or the same partial set to both sides: their diff alone would call them equal); the forms
# files of DIR/javac and DIR/native that differ (the reports aside; GNU diff, binary files too)
# listed in DIR.differ (the corpus's paths, MODULE/...), DIR.diff the differences. A failure is
# also written into LOG as a line FAILED: ..., which the corpus's verdict reads.
same() {
  local d=$1 log=$2 st=$3 rel sums ds
  same_fail() { echo "FAILED: $1" >> "$log"; echo "  $(basename "$d"): FAILED: $1 ($log)"; }
  if [ "$st" != 0 ]; then
    tail -5 "$log" | sed 's/^/    /'; same_fail "the read exited $st"; return 1
  fi
  if grep -q '^FAILED\| [1-9][0-9]* failed' "$log"; then
    echo "  $(basename "$d"): conversion failures ($log):"; grep '^FAILED' "$log" | head -5; return 1
  fi
  sums=$(grep -E '^[0-9]+ Java files, [0-9]+ converted, ' "$log" | sed -E 's/^([0-9]+) Java files, ([0-9]+) converted, .*/\1 \2/')
  if [ "$(echo "$sums" | grep -c .)" != 2 ]; then
    same_fail "$(echo "$sums" | grep -c .) summaries of the read, not 2 (javac's side and the native side)"; return 1
  fi
  if [ "$(echo "$sums" | LC_ALL=C sort -u | wc -l)" != 1 ]; then
    same_fail "the two sides read different files: $(echo "$sums" | sed 's/\(.*\) \(.*\)/\1 files, \2 converted/' | paste -sd ';' -)"; return 1
  fi
  diff -rq -x 'repr-java-*.edn' "$d/javac" "$d/native" > "$d.list" 2> "$d.err"; ds=$?
  if [ "$ds" -gt 1 ]; then
    head -5 "$d.err" | sed 's/^/    /'; same_fail "diff exited $ds"; return 1
  fi
  if [ -s "$d.list" ]; then diff -r -x 'repr-java-*.edn' "$d/javac" "$d/native" > "$d.diff" 2>&1; else : > "$d.diff"; fi
  rel=$(basename "$d")
  [ "$(basename "$(dirname "$d")")" = "$c" ] || rel=""
  # every line of diff -rq counts: Files A and B differ (the path), Only in ..., any other
  { grep '^Files .* differ$' "$d.list" | sed "s|^Files $d/javac/.* and $d/native/\(.*\) differ\$|\1|; s|^|${rel:+$rel/}|"
    grep -v '^Files .* differ$' "$d.list" | sed 's/ /_/g'; } > "$d.differ"
  return 0
}

# read_both DIR ARGS...: bin/repr-java read --front both --split into DIR/javac, DIR/native
read_both() {
  local d=$1 st=0 s; shift
  rm -rf "$d"; mkdir -p "$d"
  if [ -n "$nojavac" ]; then
    bin/repr-java read --check --front javac "$d/javac" "$@" > "$d.log" 2>&1 || st=$?
    local t0; t0=$(date +%s.%N)
    bin/repr-java read --check --no-javac "$d/native" "$@" >> "$d.log" 2>&1 || { s=$?; [ "$st" != 0 ] || st=$s; }
    awk -v a="$t0" -v b="$(date +%s.%N)" 'BEGIN {printf "%.1f\n", b - a}' > "$d.time"
  else
    bin/repr-java read --check --front both --split "${attr_opts[@]}" --native-out "$d/native" "$d/javac" "$@" > "$d.log" 2>&1 || st=$?
  fi
  same "$d" "$d.log" "$st"
}

# read_jdk DIR MODULE SRC THREADS [all]: read-jdk --front both --split, from WORK (its patch
# directories), REPR_JAVA_THREADS chunks; with all, REPR_JAVA_PATCH_ALL (the vendoring scripts')
read_jdk() {
  local d=$1 m=$2 src=$3 threads=$4 all=${5:-} st=0 s
  rm -rf "$d"; mkdir -p "$d"
  if [ -n "$nojavac" ]; then
    jdk_read "$threads" "$all" --front javac "$d/javac" "$m" "$src" > "$d.log" 2>&1 || st=$?
    local t0; t0=$(date +%s.%N)
    jdk_read "$threads" "$all" --no-javac "$d/native" "$m" "$src" >> "$d.log" 2>&1 || { s=$?; [ "$st" != 0 ] || st=$s; }
    awk -v a="$t0" -v b="$(date +%s.%N)" 'BEGIN {printf "%.1f\n", b - a}' > "$d.time"
  else
    jdk_read "$threads" "$all" --front both --split "${attr_opts[@]}" --native-out "$d/native" "$d/javac" "$m" "$src" > "$d.log" 2>&1 || st=$?
  fi
  same "$d" "$d.log" "$st"
}

# jdk_read THREADS ALL ARGS...: bin/repr-java read-jdk --check ARGS... from WORK
jdk_read() {
  local threads=$1 all=$2
  shift 2
  (cd "$work" && export REPR_JAVA_THREADS=$threads && { [ -n "$all" ] && export REPR_JAVA_PATCH_ALL=1 || unset REPR_JAVA_PATCH_ALL; } &&
     heavy_run "$root/bin/repr-java" read-jdk --check "$@")
}

summary_line() { grep ' Java files, ' "$1" | sed 's/ in [0-9.]*s$//' | paste -sd ';' -; }

for c in ${corpora//,/ }; do
  t0=$SECONDS
  case $c in
    samples)
      read_both "$work/samples/java" "$root/test/repr/java/java" || status=1
      read_both "$work/samples/module" "$root/test/repr/java/module" || status=1 ;;
    baseline)
      frozen=$(frozen_clojure) && read_both "$work/baseline/clojure" "$frozen" clojure || status=1 ;;
    jdk)
      orig=$root/.tmp/repr-java-parse-check/jdk-originals
      arbace_jdk_originals "$orig" "$work/jrt.log" | sed 's/^/jdk: /'
      [ "${PIPESTATUS[0]}" = 0 ] || { status=1; continue; }
      read_jdk "$work/jdk/java.base" java.base "$orig/src/java.base" 4 all || status=1 ;;
    javac)
      gensrc=; for x in "$jdk"/build/*/support/gensrc; do if [ -e "$x" ]; then gensrc=$x; break; fi; done
      # every file of the list copied, the generated ones from the JDK build's tree, as parse-check's
      # javac_sources (a file that fails to copy would leave both reads a smaller corpus)
      [ -n "$gensrc" ] || { echo "javac: FAILED (no JDK build tree's support/gensrc under $jdk/build)"; status=1; continue; }
      s=$work/javac-src
      rm -rf "$s"
      copied=1
      while read -r m kind rel; do
        mkdir -p "$s/$m/$(dirname "$rel")"
        case $kind in
          share) cp "$jdk/src/$m/share/classes/$rel" "$s/$m/$rel" ;;
          gensrc|gensrc-build) cp "$gensrc/$m/$rel" "$s/$m/$rel" ;;
          overlay) cp "overlay/jdk/javac/$m/$rel" "$s/$m/$rel" ;;
          make) cp "$jdk/make/jdk/src/classes/$rel" "$s/$m/$rel" ;;
          langtools) cp "$jdk/make/langtools/tools/$rel" "$s/$m/$rel" ;;
          interim) sed -e "s/package java.time.zone/package build.tools.tzdb/" \
                     < "$jdk/src/java.base/share/classes/java/time/zone/$(basename "$rel")" > "$s/$m/$rel" ;;
          *) echo "jdk/javac/sources.txt: unknown kind $kind" >&2; false ;;
        esac || { echo "javac: not copied: $m $kind $rel"; copied=; }
      done < jdk/javac/sources.txt
      [ -n "$copied" ] || { echo "javac: FAILED (javac's sources not all copied)"; status=1; continue; }
      for m in $(cut -d' ' -f1 jdk/javac/sources.txt | LC_ALL=C sort -u); do
        if [ "$m" = buildtools ]; then
          read_both "$work/javac/$m" --javac --add-exports --javac java.base/sun.text=ALL-UNNAMED "$s/$m" || status=1
        else
          read_jdk "$work/javac/$m" "$m" "$s/$m" 8 all || status=1
        fi
      done ;;
    jdk26u)
      compgen -G "$jdk_src/*/share/classes" > /dev/null \
        || { echo "jdk26u: FAILED (no jdk26u modules at $jdk_src/*/share/classes: JDK_SRC)"; status=1; continue; }
      for d in "$jdk_src"/*/share/classes; do
        m=${d#"$jdk_src"/}; m=${m%%/*}
        read_jdk "$work/jdk26u/$m" "$m" "$d" 4 || status=1
      done ;;
    *) echo "front-check: no corpus $c (samples, baseline, jdk, javac, jdk26u)" >&2; exit 2 ;;
  esac
  n=$(judge_count_javac_forms "$work" "$c")
  # the reads without javac's time: wall times summed, the peak the largest
  if [ -n "$nojavac" ]; then
    find "$work/$c" -maxdepth 2 -name '*.time' -exec cat {} + | awk '{w+=$1} END {printf "%.1f\n", w}' > "$work/$c.time"
  fi
  # the differing files against the known ones (test/repr/java/front-check-known.edn)
  find "$work/$c" -maxdepth 2 -name '*.differ' -exec cat {} + | LC_ALL=C sort > "$work/$c.differ"
  arbace_tool -e "(let [k (get (read-string (slurp \"$known\")) :$c)] (doseq [f (sort (if (map? k) (:forms k) k))] (println f)))" \
    | LC_ALL=C sort > "$work/$c.known"
  if grep -qs '^FAILED' $(find "$work/$c" -maxdepth 2 -name '*.log'); then
    verdict="FAILED (failed reads or conversions: the logs' FAILED lines)"; status=1
  elif [ "$n" = 0 ]; then
    verdict="FAILED (no forms file: the corpus read nothing)"; status=1
  elif ! cmp -s "$work/$c.differ" "$work/$c.known" && [ -n "$(LC_ALL=C comm -23 "$work/$c.differ" "$work/$c.known")" ]; then
    verdict="DIFFERENT beyond the known ($known):"; status=1
  elif [ -s "$work/$c.differ" ]; then
    verdict="equal but $(wc -l < "$work/$c.differ") known files ($known)"
  else
    verdict=equal
  fi
  echo "$c: $n forms files from javac's trees, the native trees'${nojavac:+ (read without javac)} $verdict [$((SECONDS - t0)) s]"
  case $verdict in DIFFERENT*) LC_ALL=C comm -23 "$work/$c.differ" "$work/$c.known" | head -20 ;; esac
  for l in $(find "$work/$c" -maxdepth 2 -name '*.log' | LC_ALL=C sort); do echo "  ${l#"$work/"}: $(summary_line "$l")"; done
done
# the split, by corpus, and the static split of the converter's code
dirs=()
for c in ${corpora//,/ }; do [ -d "$work/$c" ] && dirs+=("$work/$c"); done
if [ -z "$nojavac" ]; then
  arbace_tool -m arbace.repr.java.split summary "$work" "${dirs[@]}" > "$work/split.log" 2>&1 || { tail -5 "$work/split.log"; status=1; }
  arbace_tool -m arbace.repr.java.split static > "$work/static.edn" 2>&1 || status=1
  echo "the split: $work/split.md; the static split: $work/static.edn"
fi
if [ -n "$nojavac" ]; then
  arbace_tool -m arbace.repr.java.split nojavac "$work" "${dirs[@]}" > "$work/nojavac.log" 2>&1 || status=1
  cat "$work/nojavac.log"
  grep -q '^nojavac: .* beyond the known' "$work/nojavac.log" && status=1
  # the fallbacks against the known: a file converted again with javac has javac's forms, equal to
  # the reference by construction, so a read that falls back on every file would pass the forms;
  # {:CORPUS {:fallbacks N}} in the known file, none when absent (JN9f: none in any corpus)
  if [ -f "$work/nojavac.edn" ]; then
    arbace_tool -e "(let [k (read-string (slurp \"$known\")) s (read-string (slurp \"$work/nojavac.edn\"))]
  (doseq [[c v] s :let [n (get v :fallbacks 0) m (get-in k [(keyword c) :fallbacks] 0)]]
    (when (zero? (get v :files 0)) (println (str \"nojavac: \" c \": no file read without javac, beyond the known\")))
    (when (> n m) (println (str \"nojavac: \" c \": \" n \" fallbacks to javac, beyond the known \" m)))))" > "$work/nojavac-known.log" 2>&1 || status=1
  else
    echo "nojavac: no $work/nojavac.edn, beyond the known" > "$work/nojavac-known.log"
  fi
  cat "$work/nojavac-known.log"
  grep -q '^nojavac: .* beyond the known' "$work/nojavac-known.log" && status=1
  echo "the read without javac: $work/nojavac.md"
fi
if [ -n "$attr" ]; then
  # the native provider's check: its outcomes by corpus, no fact different beyond the known counts
  arbace_tool -m arbace.repr.java.split attr "$work" "$known" "${dirs[@]}" > "$work/attr.log" 2>&1 || status=1
  grep '^attr: ' "$work/attr.log"
  grep -q '^attr: .* beyond the known' "$work/attr.log" && status=1
  # the provider must answer: a fact it declines goes to javac, whose answer keeps the forms equal,
  # so a provider that declines every fact would pass; each corpus needs an equal answer, and no more
  # declines than the known file's {:CORPUS {:declined N}} when it gives one
  if [ -f "$work/attr.edn" ]; then
    arbace_tool -e "(let [k (read-string (slurp \"$known\")) s (read-string (slurp \"$work/attr.edn\"))]
  (doseq [[c v] s :let [t (:totals v) d (get t :declined 0) m (get-in k [(keyword c) :declined])]]
    (when (zero? (get t :equal 0)) (println (str \"attr: \" c \": the native provider answered no fact (\" d \" declined), beyond the known\")))
    (when (and m (> d m)) (println (str \"attr: \" c \": \" d \" facts declined, beyond the known \" m)))))" > "$work/attr-known.log" 2>&1 || status=1
  else
    echo "attr: no $work/attr.edn, beyond the known" > "$work/attr-known.log"
  fi
  cat "$work/attr-known.log"
  grep -q '^attr: .* beyond the known' "$work/attr-known.log" && status=1
  echo "the native provider's outcomes: $work/attr.md"
fi
if [ -n "$nojavac" ]; then
  [ $status = 0 ] && echo "nojavac-check: the reads without javac's forms equal javac's, in every corpus" || echo "nojavac-check: FAILED"
elif [ -n "$attr" ]; then
  [ $status = 0 ] && echo "attr-check: the native provider's facts equal javac's, and the forms, in every corpus" || echo "attr-check: FAILED"
else
  [ $status = 0 ] && echo "front-check: the native trees' forms equal javac's in every corpus" || echo "front-check: FAILED"
fi
exit $status

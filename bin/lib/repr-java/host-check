#!/bin/bash
# repr/java's read on javac's tool executable (REPR_JAVA_HOST=arbace, bin/repr-java;
# doc/classes/JAVA-FRONTEND-SURVEY.md, "As built: JN4") against today's JVM-hosted read, over the
# corpora of the survey's §6. Writes under $REPR_JAVA_HOST_CHECK_WORK (default
# .tmp/repr-java-host-check).
#
# Usage: bin/repr-java host-check [CORPUS...]   (default: check jdk fixtures full)
#   check     bin/repr-java check on the tool: the baseline's 183 files (the frozen clojure/) by
#             their SHA-256, test/repr/java/expected/baseline.sha256; the samples
#             test/repr/java/java and module against test/repr/java/expected/java, module
#   jdk       java.base's closure (838 files): bin/jrt-convert's sources, generate and convert steps
#             with repr/java on the tool (read-jdk's --patch-module against the platform), its forms
#             against jdk/forms (diff -r) and its provenance against jdk/provenance.edn but the
#             converter's host
#   fixtures  the suite's Java fixtures (bin/clojure-tests --java-fixtures OUT on the tool, javac's
#             class path the checkout's runtime declarations, bin/repr-java declarations) against
#             test/java-fixtures/forms
#   full      mode :full (read --full) of the round trip's three corpora, the baseline, the samples
#             and the jdk corpus's originals (those of the jdk step), on the tool and on the frozen
#             JVM, byte for byte
# The reads' wall times are in WORK/times.txt (the tool's, and for full the JVM's too).
# Environment: REPR_JAVA_EXE (bin/repr-java), JDK (jdk26u's checkout, default /root/jdk26u).
# Exit status: 0 when every corpus reads as on the JVM.
set -uo pipefail
root=$(cd "$(dirname "$0")/../../.." && pwd)
. "$root/bin/lib/renamed-env.bash" # stops on a stale G2A_*, J2A_*, A2G_* or C2A_*
cd "$root"
. bin/lib/tools.bash
work=${REPR_JAVA_HOST_CHECK_WORK:-$root/.tmp/repr-java-host-check}
case $work in /*) ;; *) work=$root/$work ;; esac
[ $# -gt 0 ] || set -- check jdk fixtures full
mkdir -p "$work"
: > "$work/times.txt"
status=0
frozen=$(frozen_clojure) || exit 1

# timed NAME CMD...: CMD's wall time in WORK/times.txt
timed() {
  local name=$1 t0 st
  shift
  t0=$(date +%s%N)
  "$@"; st=$?
  echo "$name $(( ($(date +%s%N) - t0) / 1000000 )) ms" >> "$work/times.txt"
  return $st
}

# originals: the jdk corpus's originals and its tool-read forms, WORK/jrt (bin/jrt-convert)
jdk_corpus() {
  rm -rf "$work/jrt"
  REPR_JAVA_HOST=arbace JRT_WORK=$work/jrt JRT_STEPS=sources,generate,convert timed jdk-read-arbace "$root/bin/jrt-convert" \
    > "$work/jrt.log" 2>&1
  local st=$?
  grep '^== \|files, \| converted' "$work/jrt.log"
  return $st
}

# jdk_origins: the names the round trip's headers give the jdk corpus's files (jdk/sources.txt)
jdk_origins() {
  while read -r _ kind rel; do
    case $kind in
      share) echo "\"$rel\" \"jdk26u src/java.base/share/classes/$rel\"" ;;
      share:*) echo "\"$rel\" \"jdk26u src/${kind#share:}/share/classes/$rel\"" ;;
      unix) echo "\"$rel\" \"jdk26u src/java.base/unix/classes/$rel\"" ;;
      overlay) echo "\"$rel\" \"overlay/jdk/java.base/$rel\"" ;;
      gensrc) echo "\"$rel\" \"jdk26u support/gensrc/java.base/$rel (generated by bin/jrt-convert)\"" ;;
      gensrc:*) echo "\"$rel\" \"jdk26u support/gensrc/${kind#gensrc:}/$rel (generated by bin/jrt-convert)\"" ;;
      jrtgen) echo "\"$rel\" \"$rel (generated by bin/jrt-convert)\"" ;;
    esac
  done < jdk/sources.txt | { echo "{"; cat; echo "}"; }
}

# full_read HOST: the three corpora read --full on HOST into WORK/full/HOST
full_read() {
  local h=$1 o=$work/full/$1 s
  rm -rf "$o"; mkdir -p "$o/cwd"
  REPR_JAVA_HOST=$h timed "full-baseline-$h" bin/repr-java read --full "$o/baseline" "$frozen" clojure > "$o/baseline.log" 2>&1
  find "$o/baseline" -name '*.ae' -exec sed -i "1s|^;; Converted from $frozen/|;; Converted from |" {} +
  for s in java module; do
    REPR_JAVA_HOST=$h timed "full-$s-$h" bin/repr-java read --full "$o/$s" "$root/test/repr/java/$s" > "$o/$s.log" 2>&1
    find "$o/$s" -name '*.ae' -exec sed -i "1s|^;; Converted from $root/test/repr/java/$s/|;; Converted from |" {} +
  done
  (cd "$o/cwd" && REPR_JAVA_HOST=$h REPR_JAVA_THREADS=4 REPR_JAVA_PATCH_ALL=1 timed "full-jdk-$h" "$root/bin/repr-java" read-jdk --full \
     --origins "$work/origins.edn" "$o/jdk" java.base "$work/jrt/src/java.base") > "$o/jdk.log" 2>&1
  for s in baseline java module jdk; do echo "   $h: full $s: $(tail -1 "$o/$s.log")"; done
}

for c in "$@"; do
  case $c in
    check)
      echo "== check: bin/repr-java check on the tool"
      REPR_JAVA_HOST=arbace REPR_JAVA_CHECK_WORK=$work/check timed check-arbace bin/repr-java check || status=1 ;;
    jdk)
      echo "== jdk: java.base's closure, bin/jrt-convert's convert on the tool"
      if jdk_corpus; then
        if diff -r -x repr-java-report.edn "$work/jrt/conv" jdk/forms > "$work/jdk.diff"; then
          echo "jdk: $(find "$work/jrt/conv" -name '*.ae' | wc -l) files, as jdk/forms"
        else
          echo "jdk: the forms differ from jdk/forms ($work/jdk.diff: $(grep -c '^diff \|^Only' "$work/jdk.diff") files)"; status=1
        fi
        if diff <(grep -v ':host ' jdk/provenance.edn) <(grep -v ':host ' "$work/jrt/provenance.edn") > "$work/jdk-provenance.diff"; then
          echo "jdk: the provenance as jdk/provenance.edn's but the host ($(grep -o ':host "[^"]*"' "$work/jrt/provenance.edn" | cut -c1-34))"
        else
          echo "jdk: the provenance differs from jdk/provenance.edn ($work/jdk-provenance.diff)"; status=1
        fi
      else
        echo "jdk: bin/jrt-convert failed ($work/jrt.log)"; tail -5 "$work/jrt.log"; status=1
      fi ;;
    fixtures)
      echo "== fixtures: the suite's Java fixtures on the tool"
      if REPR_JAVA_HOST=arbace CLOJURE_TESTS_RUN=host-check-fixtures timed fixtures-arbace bin/clojure-tests --java-fixtures "$work/fixtures" \
           > "$work/fixtures.log" 2>&1; then
        if diff -r test/java-fixtures/forms "$work/fixtures" > "$work/fixtures.diff"; then
          echo "fixtures: $(find "$work/fixtures" -name '*.ae' | wc -l) files, as test/java-fixtures/forms"
        else
          echo "fixtures: the forms differ from test/java-fixtures/forms ($work/fixtures.diff)"; head -20 "$work/fixtures.diff"; status=1
        fi
      else
        echo "fixtures: the conversion failed ($work/fixtures.log)"; tail -10 "$work/fixtures.log"; status=1
      fi ;;
    full)
      echo "== full: mode :full on the tool and on the frozen JVM"
      [ -d "$work/jrt/src/java.base" ] || jdk_corpus || { echo "full: no jdk originals"; status=1; continue; }
      jdk_origins > "$work/origins.edn"
      full_read arbace
      full_read jvm
      for s in baseline java module jdk; do
        if diff -r -x repr-java-report.edn "$work/full/jvm/$s" "$work/full/arbace/$s" > "$work/full-$s.diff"; then
          echo "full $s: $(find "$work/full/arbace/$s" -name '*.ae' | wc -l) files, as on the JVM"
        else
          echo "full $s: the forms differ from the JVM's ($work/full-$s.diff)"; status=1
        fi
      done ;;
    *) sed -n '7,22p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
  esac
done
cat "$work/times.txt"
[ $status = 0 ] && echo "host-check: repr/java's read on javac's tool executable is the JVM's over $*" ||
  echo "host-check: repr/java's read on javac's tool executable differs from the JVM's"
exit $status

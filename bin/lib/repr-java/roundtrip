#!/bin/bash
# repr/java's round trip (doc/classes/PRINTER-NOTES.md, "The round trip"): Java -> forms F1 (repr/java
# read, on javac's tool executable, its only host since JN6) -> Java (repr/java print, arbace.repr.java.print, on the tools' host) -> forms
# F2 (read again), judged per converted file by arbace.repr.java.roundtrip at three levels: forms (F1's
# and F2's files the same forms as data, metadata included), ae (the same text, byte for byte, after
# the first line naming the Java file), classes (javac's class files of the original and of the
# printed Java, -g:none, byte for byte; bin/repr-java javac: javac on Arbace, whose class files are
# the JVM's javac's, JN3, bin/javac-vendor classes). Writes under
# .tmp/repr-java-roundtrip/CORPUS/.
#
# Usage: bin/repr-java roundtrip [--corpus C,...] [--no-classes] [--text | --text-only] [--record]
#   --corpus     baseline (Clojure's Java, the frozen clojure/: 183 files), samples
#                (test/repr/java/java and module), jdk (jdk/forms: java.base's closure, F1 the
#                committed forms; its originals made by bin/jrt-convert's sources and generate
#                steps). Default: baseline,samples
#   --no-classes the forms and ae levels only
#   --text       then the text level (PRINTER-NOTES.md, "Mode :full"): the corpus's Java read in mode
#                :full (read --full) into forms FF, printed in the full layout and judged per file:
#                record (FF without its record = the forms of mode :lines), text (the printed Java
#                = the original, byte for byte), classes (javac's, -g:none, byte for byte), anew
#                (javac accepts the full layout's print with every member printed anew, --anew);
#                references CORPUS-text.edn, CORPUS-text-known.edn
#   --text-only  the text level alone
#   --record     write each corpus's results as its reference, test/repr/java/roundtrip/CORPUS.edn,
#                and its differences with their reasons, test/repr/java/roundtrip/CORPUS-known.edn
# The corpora run concurrently, each logged into .tmp/repr-java-roundtrip/CORPUS.log and shown in
# order when all are done (JN5: the reads on javac's tool executable take longer than the JVM's did).
# Each corpus's results are compared with its reference, test/repr/java/roundtrip/CORPUS.edn (an
# entry and level passing there and not now fails the run); its known differences with their
# reasons, CORPUS-known.edn, are expected. Results: .tmp/repr-java-roundtrip/CORPUS/results.edn.
# Environment: REPR_JAVA_EXE (bin/repr-java), JDK (jdk26u's checkout, default /root/jdk26u),
# JRT_WORK_RT (the jdk corpus's originals, default .tmp/repr-java-roundtrip/jdk-originals, made again
# when what they are made from changed, originals.key; their copied files checked against their sources).
set -uo pipefail
root=$(cd "$(dirname "$0")/../../.." && pwd)
. "$root/bin/lib/renamed-env.bash" # stops on a stale G2A_*, J2A_* or A2G_*
cd "$root"
. bin/lib/tools.bash
. bin/lib/repr-java/originals.bash

corpora=baseline,samples classes=1 record= text= lines=1
while [ $# -gt 0 ]; do
  case $1 in
    --corpus) corpora=$2; shift 2 ;;
    --no-classes) classes=; shift ;;
    --record) record=1; shift ;;
    --text) text=1; shift ;;
    --text-only) text=1; lines=; shift ;;
    *) sed -n '/^# Usage/,/^# Each corpus/p' "$0" | sed '$d; s/^# \{0,1\}//' >&2; exit 2 ;;
  esac
done
work=.tmp/repr-java-roundtrip
ref=test/repr/java/roundtrip
status=0 pids=()
mkdir -p "$work"

# print F1 OUT [OPTION...]: the forms into Java (on the tools' host)
print() {
  local t0=$SECONDS f1=$1 out=$2
  shift 2
  arbace_tool -m arbace.repr.java.print --quiet --index jdk/forms "$@" "$f1" "$out" | tail -3
  local st=${PIPESTATUS[0]}
  echo "print: $((SECONDS - t0)) s"
  [ "$st" = 0 ] || { status=1; return 1; }
}

# read NAME OUT ROOT [PATH...]: Java into forms, the first lines without ROOT's path
read_forms() {
  local name=$1 out=$2 src=$3 t0=$SECONDS
  shift 3
  bin/repr-java read --check "$out" "$src" "$@" | grep -v '^slowest' | grep -v '^arbace.edn' | tee "$work/$name.read.log"
  find "$out" -name '*.ae' -exec sed -i "1s|^;; Converted from $src/|;; Converted from |" {} +
  echo "read: $((SECONDS - t0)) s"
}

# compile OUT SRC [JAVAC-OPTION...]: every .java under SRC, -g:none (no LineNumberTable,
# LocalVariableTable, SourceFile), into OUT
compile() {
  local out=$1 src=$2 t0=$SECONDS
  shift 2
  rm -rf "$out"; mkdir -p "$out"
  (cd "$src" && find . -name '*.java' | sed 's|^\./||' | LC_ALL=C sort > "$root/$out.list" &&
     "$root/bin/repr-java" javac -Xmaxerrs 100000 -g:none -nowarn -XDsuppressNotes -proc:none -implicit:none -d "$root/$out" "$@" "@$root/$out.list") \
     > "$out.log" 2>&1 || echo "javac failed in $src: $out.log ($(grep -c 'error:' "$out.log") errors)"
  echo "javac $src: $(find "$out" -name '*.class' | wc -l) classes, $((SECONDS - t0)) s"
}

# compile_printed OUT PRINTED ORIGINAL [JAVAC-OPTION...]: the printed tree compiled; the files
# javac rejects are listed in OUT.rejected and replaced by their originals (in a copy), so that
# the other files' classes are compiled and compared all the same
compile_printed() {
  local out=$1 printed=$2 orig=$3 tree=$1.tree n
  shift 3
  compile "$out" "$printed" "$@"
  cp "$out.log" "$out.first.log"
  cp "$out.log" "$out.all.log" # every pass's errors (the text level's reasons)
  : > "$out.rejected"
  rm -rf "$tree"; cp -r "$printed" "$tree"
  # javac reports the errors of a phase at a time: again until it accepts the tree
  for n in 1 2 3 4 5 6; do
    grep -q 'error:' "$out.log" || break
    grep -o '^[^ :]*\.java:[0-9]*: error:' "$out.log" | sed 's/:[0-9]*: error:$//; s|^\./||' |
      sed "s|^$root/$printed/||; s|^$root/$tree/||" >> "$out.rejected"
    sort -u -o "$out.rejected" "$out.rejected"
    while read -r f; do cp "$orig/$f" "$tree/$f"; done < "$out.rejected"
    echo "javac rejects $(wc -l < "$out.rejected") printed files ($out.rejected): compiled again with their originals"
    compile "$out" "$tree" "${@//$printed/$tree}"
    cat "$out.log" >> "$out.all.log"
  done
}

# judge NAME F1 F2 [C1 C2]
judge() {
  local name=$1 f1=$2 f2=$3 c1=${4:-} c2=${5:-} r=() o=()
  [ -f "$ref/$name.edn" ] && [ -z "$record" ] && r=(--reference "$ref/$name.edn")
  [ -n "$record" ] && o=(--record "$ref/$name.edn")
  [ -n "$c1" ] && o+=(--c1 "$c1" --c2 "$c2" --rejected "$(cat "$w"/c2.rejected "$w"/c2/*.rejected 2>/dev/null | sort -u | tr '\n' ' ')"
                     --javac-logs "$(ls "$w"/c2.first.log "$w"/c2/*.first.log 2>/dev/null | tr '\n' ' ')")
  [ -n "$record" ] && o+=(--known-out "$ref/$name-known.edn")
  arbace_tool -m arbace.repr.java.roundtrip compare --corpus "$name" --f1 "$f1" --f2 "$f2" \
    --out "$work/$name/results.edn" --known "$ref/$name-known.edn" "${r[@]}" "${o[@]}" || status=1
}

# jdk_origins: the headers name each file as bin/jrt-convert's origins do (jdk/sources.txt)
jdk_origins() {
  while read -r _ kind rel; do
    case $kind in
      share) echo "\"$rel\" \"jdk26u src/java.base/share/classes/$rel\"" ;;
      share:*) echo "\"$rel\" \"jdk26u src/${kind#share:}/share/classes/$rel\"" ;;
      unix) echo "\"$rel\" \"jdk26u src/java.base/unix/classes/$rel\"" ;;
      overlay) echo "\"$rel\" \"overlay/jdk/java.base/$rel\"" ;;
      gensrc) echo "\"$rel\" \"jdk26u support/gensrc/java.base/$rel (generated by bin/jrt-convert)\"" ;;
      gensrc:*) echo "\"$rel\" \"jdk26u support/gensrc/${kind#gensrc:}/$rel (generated by bin/jrt-convert)\"" ;;
      jrtgen) echo "\"$rel\" \"$rel (generated by bin/jrt-convert)\"" ;;
    esac
  done < jdk/sources.txt | { echo "{"; cat; echo "}"; }
}

# jdk_originals: the jdk corpus's originals (bin/jrt-convert's sources and generate steps), made
# again when what they are made from changed, then checked (bin/lib/repr-java/originals.bash)
jdk_originals() { arbace_jdk_originals "$orig" "$w/jrt.log" "${JRT_WORK_RT:-}"; }
jopts=(-XDstringConcat=inline --enable-preview -source 26)

# text_level CORPUS: the text level of a corpus, in $w/text (its forms of mode :lines in $w/f1)
text_level() {
  local corpus=$1 t=$w/text s r=() o=() anew=() tt0=$SECONDS
  rm -rf "$t"; mkdir -p "$t"
  echo "-- $corpus: the text level"
  case $corpus in
    baseline)
      frozen=$(frozen_clojure) || return 1
      bin/repr-java read --full "$t/full" "$frozen" clojure | grep -v '^slowest' | tail -1
      find "$t/full" -name '*.ae' -exec sed -i "1s|^;; Converted from $frozen/|;; Converted from |" {} +
      print "$t/full" "$t/java"
      if [ -n "$classes" ]; then
        print "$t/full" "$t/anew" --anew
        [ -d "$w/c1" ] || compile "$w/c1" "$frozen" -sourcepath "$frozen"
        compile "$t/c2" "$t/java" -sourcepath "$root/$t/java"
        compile_printed "$t/c3" "$t/anew" "$frozen" -sourcepath "$root/$t/anew"
        anew=(--c1 "$w/c1" --c2 "$t/c2" --anew-rejected "$(sort -u "$t/c3.rejected" | tr '\n' ' ')" --javac-logs "$t/c3.all.log")
      fi
      originals=$frozen ;;
    samples)
      for s in java module; do
        bin/repr-java read --full "$t/full/$s" "$root/test/repr/java/$s" | grep -v '^slowest' | tail -1
        find "$t/full/$s" -name '*.ae' -exec sed -i "1s|^;; Converted from $root/test/repr/java/$s/|;; Converted from |" {} +
        print "$t/full/$s" "$t/java/$s"
        if [ -n "$classes" ]; then
          print "$t/full/$s" "$t/anew/$s" --anew
          [ -d "$w/c1/$s" ] || compile "$w/c1/$s" "test/repr/java/$s"
          compile "$t/c2/$s" "$t/java/$s"
          compile_printed "$t/c3/$s" "$t/anew/$s" "test/repr/java/$s"
        fi
      done
      # edited forms of mode :full print the edited member anew, the rest from the record:
      # test/repr/java/full/NAME-edited.java (a string literal changed in Square's compact
      # constructor, Shapes' area renamed surface)
      mkdir -p "$t/edited/sample"
      sed 's/"side"/"length"/' "$t/full/java/sample/Square.ae" > "$t/edited/sample/Square.ae"
      sed 's/\^:static area /^:static surface /' "$t/full/java/sample/Shapes.ae" > "$t/edited/sample/Shapes.ae"
      print "$t/edited" "$t/edited-java"
      for s in Square Shapes; do
        if cmp -s "$t/edited-java/sample/$s.java" "test/repr/java/full/$s-edited.java"; then echo "edited $s: as expected"
        else echo "edited $s: UNEXPECTED, not test/repr/java/full/$s-edited.java"; status=1; fi
      done
      [ -n "$classes" ] && { compile "$t/c-edited" "$t/edited-java" -sourcepath "$root/test/repr/java/java"; grep -q 'error:' "$t/c-edited.log" && { echo "edited: javac rejects them"; status=1; }; }
      # one tree of each, as the comparator takes them
      mkdir -p "$t/fullall" "$t/javaall" "$t/origall"
      for s in java module; do
        cp -r "$t/full/$s/." "$t/fullall/"; cp -r "$t/java/$s/." "$t/javaall/"; cp -r "test/repr/java/$s/." "$t/origall/"
      done
      rm -f "$t"/fullall/repr-java-report.edn
      if [ -n "$classes" ]; then
        mkdir -p "$t/c1all" "$t/c2all"
        for s in java module; do cp -r "$w/c1/$s/." "$t/c1all/"; cp -r "$t/c2/$s/." "$t/c2all/"; done
        anew=(--c1 "$t/c1all" --c2 "$t/c2all" --anew-rejected "$(cat "$t"/c3/*.rejected | sort -u | tr '\n' ' ')"
              --javac-logs "$(ls "$t"/c3/*.all.log | tr '\n' ' ')")
      fi
      originals=$t/origall ;;
    jdk)
      jdk_originals || return 1
      [ -f "$w/origins.edn" ] || jdk_origins > "$w/origins.edn"
      local t0=$SECONDS
      (cd "$w" && REPR_JAVA_THREADS=4 REPR_JAVA_PATCH_ALL=1 \
         "$root/bin/repr-java" read-jdk --full --origins "$root/$w/origins.edn" "$root/$t/full" java.base "$root/$orig/src/java.base") \
         > "$t/read.log" 2>&1
      tail -1 "$t/read.log"; echo "read --full: $((SECONDS - t0)) s"
      print "$t/full" "$t/java/java.base"
      if [ -n "$classes" ]; then
        # the anew print while the full layout's print compiles
        print "$t/full" "$t/anew/java.base" --anew > "$t/print-anew.log" 2>&1 & local pp=$!
        [ -d "$w/c1" ] || compile "$w/c1" "$orig/src/java.base" --patch-module "java.base=$root/$orig/src/java.base" "${jopts[@]}"
        compile "$t/c2" "$t/java/java.base" --patch-module "java.base=$root/$t/java/java.base" "${jopts[@]}"
        wait "$pp" || status=1; cat "$t/print-anew.log"
        compile_printed "$t/c3" "$t/anew/java.base" "$orig/src/java.base" --patch-module "java.base=$root/$t/anew/java.base" "${jopts[@]}"
        anew=(--c1 "$w/c1" --c2 "$t/c2" --anew-rejected "$(sort -u "$t/c3.rejected" | tr '\n' ' ')" --javac-logs "$t/c3.all.log")
      fi
      originals=$orig/src/java.base ;;
  esac
  local full=$t/full printed=$t/java lines=$w/f1
  case $corpus in
    samples) full=$t/fullall printed=$t/javaall lines=$w/f1all ;;
    jdk) lines=jdk/forms printed=$t/java/java.base ;;
  esac
  rm -f "$full/repr-java-report.edn"
  [ -f "$ref/$corpus-text.edn" ] && [ -z "$record" ] && r=(--reference "$ref/$corpus-text.edn")
  [ -n "$record" ] && o=(--record "$ref/$corpus-text.edn" --known-out "$ref/$corpus-text-known.edn")
  arbace_tool -m arbace.repr.java.roundtrip text --corpus "$corpus" --full "$full" --lines "$lines" \
    --printed "$printed" --originals "$originals" --out "$t/results.edn" --known "$ref/$corpus-text-known.edn" \
    "${anew[@]}" "${r[@]}" "${o[@]}" || status=1
  echo "text level: $((SECONDS - tt0)) s"
}

# lines_forms CORPUS: the forms of mode :lines the text level compares with, for --text-only
lines_forms() {
  case $1 in
    baseline)
      frozen=$(frozen_clojure) || return 1
      bin/repr-java read "$w/f1" "$frozen" clojure | tail -1 ;;
    samples)
      for s in java module; do bin/repr-java read "$w/f1/$s" "$root/test/repr/java/$s" | tail -1; done ;;
  esac
}

# corpus_run CORPUS: one corpus's round trip, its status the run's
corpus_run() {
  corpus=$1
  w=$work/$corpus
  orig=${JRT_WORK_RT:-$work/jdk-originals}
  rm -rf "$w"; mkdir -p "$w"
  echo "== $corpus"
  if [ -z "$lines" ]; then
    lines_forms "$corpus"
    if [ "$corpus" = samples ]; then mkdir -p "$w/f1all"; for s in java module; do cp -r "$w/f1/$s/." "$w/f1all/"; done; rm -f "$w/f1all/repr-java-report.edn"; fi
    text_level "$corpus"
    return $status
  fi
  case $corpus in
    baseline)
      frozen=$(frozen_clojure) || return 1
      bin/repr-java read --check "$w/f1" "$frozen" clojure | grep -v '^slowest' | grep -v '^arbace.edn'
      find "$w/f1" -name '*.ae' -exec sed -i "1s|^;; Converted from $frozen/|;; Converted from |" {} +
      print "$w/f1" "$w/java"
      # a Java file named like a .clj beside it converts to NAME_class.ae (SPEC §9.1): the .clj
      # files that do so come along
      (cd "$frozen" && find clojure -name '*.java') | while read -r f; do
        [ -f "$frozen/${f%.java}.clj" ] && cp "$frozen/${f%.java}.clj" "$w/java/${f%.java}.clj"
      done
      read_forms baseline "$w/f2" "$root/$w/java" clojure
      if [ -n "$classes" ]; then
        compile "$w/c1" "$frozen" -sourcepath "$frozen"
        compile_printed "$w/c2" "$w/java" "$frozen" -sourcepath "$root/$w/java"
        judge baseline "$w/f1" "$w/f2" "$w/c1" "$w/c2"
      else
        judge baseline "$w/f1" "$w/f2"
      fi ;;
    samples)
      for s in java module; do
        bin/repr-java read --check "$w/f1/$s" "$root/test/repr/java/$s" | grep -v '^slowest' | grep -v '^arbace.edn'
        find "$w/f1/$s" -name '*.ae' -exec sed -i "1s|^;; Converted from $root/test/repr/java/$s/|;; Converted from |" {} +
        print "$w/f1/$s" "$w/java/$s"
        read_forms samples-$s "$w/f2/$s" "$root/$w/java/$s"
        [ -n "$classes" ] && { compile "$w/c1/$s" "test/repr/java/$s"; compile_printed "$w/c2/$s" "$w/java/$s" "test/repr/java/$s"; }
      done
      rm -f "$w"/f1/*/repr-java-report.edn "$w"/f2/*/repr-java-report.edn
      if [ -n "$classes" ]; then
        mkdir -p "$w/c1all" "$w/c2all"
        for s in java module; do cp -r "$w/c1/$s/." "$w/c1all/"; cp -r "$w/c2/$s/." "$w/c2all/"; done
        judge samples "$w/f1" "$w/f2" "$w/c1all" "$w/c2all"
      else
        judge samples "$w/f1" "$w/f2"
      fi ;;
    jdk)
      if [ -n "$classes" ] || [ -n "$text" ]; then jdk_originals || return 1; fi
      cp -r jdk/forms "$w/f1"
      print "$w/f1" "$w/java/java.base"
      jdk_origins > "$w/origins.edn"
      # the originals compiled while F2 is read
      c1p=
      if [ -n "$classes" ]; then compile "$w/c1" "$orig/src/java.base" --patch-module "java.base=$root/$orig/src/java.base" "${jopts[@]}" > "$w/c1.out" 2>&1 & c1p=$!; fi
      t0=$SECONDS
      (cd "$w" && REPR_JAVA_THREADS=4 REPR_JAVA_PATCH_ALL=1 \
         "$root/bin/repr-java" read-jdk --check --origins "$root/$w/origins.edn" "$root/$w/f2" java.base "$root/$w/java/java.base") \
         > "$w/jdk.read.log" 2>&1
      tail -1 "$w/jdk.read.log"; echo "read: $((SECONDS - t0)) s"
      rm -f "$w"/f1/repr-java-report.edn "$w"/f2/repr-java-report.edn
      [ -z "$c1p" ] || { wait "$c1p"; cat "$w/c1.out"; }
      if [ -n "$classes" ]; then
        compile_printed "$w/c2" "$w/java/java.base" "$orig/src/java.base" --patch-module "java.base=$root/$w/java/java.base" "${jopts[@]}"
        judge jdk "$w/f1" "$w/f2" "$w/c1" "$w/c2"
      else
        judge jdk "$w/f1" "$w/f2"
      fi ;;
    *) echo "unknown corpus $corpus" >&2; return 2 ;;
  esac
  if [ -n "$text" ]; then
    if [ "$corpus" = samples ]; then mkdir -p "$w/f1all"; for s in java module; do cp -r "$w/f1/$s/." "$w/f1all/"; done; fi
    text_level "$corpus"
  fi
  return $status
}

# the corpora concurrently (JN5: the reads on javac's tool executable take longer than on the JVM,
# the jdk corpus most), each into $work/CORPUS.log, shown in order when all are done
for corpus in ${corpora//,/ }; do
  case $corpus in baseline|samples|jdk) ;; *) echo "unknown corpus $corpus" >&2; exit 2 ;; esac
  (corpus_run "$corpus") > "$work/$corpus.log" 2>&1 &
  pids+=("$!")
done
n=0
for corpus in ${corpora//,/ }; do
  wait "${pids[$n]}" || status=1
  cat "$work/$corpus.log"
  n=$((n + 1))
done
exit $status

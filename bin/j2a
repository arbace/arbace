#!/bin/bash
# Run Arbace (bin/lib/tools.bash: target/stage2, built by bin/build-arbace) with access to
# javac internals.
# Usage: bin/j2a [arbace.lang.Main args...]; bin/j2a -m arbace.j2a.main ... converts Java to
# class forms. J2A_JVM_OPTS: heap options (default -Xmx24g). J2A_CP: more class path.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tools.bash"
arbace_runtime
exports=""
for p in api tree util parser code file main comp jvm; do
  exports="$exports --add-exports jdk.compiler/com.sun.tools.javac.$p=ALL-UNNAMED --add-opens jdk.compiler/com.sun.tools.javac.$p=ALL-UNNAMED"
done
# shellcheck disable=SC2086
exec java -Xss64m ${J2A_JVM_OPTS:--Xmx24g} $exports -cp "$ARBACE_CP${J2A_CP:+:$J2A_CP}" arbace.lang.Main "$@"

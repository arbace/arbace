#!/bin/bash
# Run the class forms compiler's tests (test/classes/*_test.clj) on the frozen baseline
# (stage 0). Writes only under .tmp/class-forms-tests/.
# Usage: bin/class-forms-tests [TEST-NAMESPACE...]   e.g. classes.basic-test
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"
mkdir -p .tmp/class-forms-tests
if [ $# -eq 0 ]; then
  set -- $(cd test && ls classes/*_test.clj | sed 's/\.clj$//; s/_/-/g; s/\//./g')
fi
nss=""
for n in "$@"; do nss="$nss '$n"; done
exec java -cp "$root:$root/test" -Darbace.tmp="$root/.tmp" clojure.main -e "
(require 'arbace.classes.boot)
(require 'clojure.test)
(apply require [$nss])
(let [r (apply clojure.test/run-tests [$nss])]
  (System/exit (if (zero? (+ (:fail r) (:error r))) 0 1)))"

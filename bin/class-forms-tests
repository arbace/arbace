#!/bin/bash
# Run the class forms compiler's tests (test/classes/*_test.clj) on Arbace (bin/lib/tools.bash:
# target/stage2, built by bin/build-arbace), with the frozen clojure/'s javac classes on the
# class path (extracted from the freeze tag into .tmp/frozen/): some tests compare with them.
# Writes only under .tmp/class-forms-tests/.
# Usage: bin/class-forms-tests [TEST-NAMESPACE...]   e.g. classes.basic-test
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"
. bin/lib/tools.bash
arbace_runtime
frozen=$(frozen_clojure)
mkdir -p .tmp/class-forms-tests
if [ $# -eq 0 ]; then
  set -- $(cd test && ls classes/*_test.clj | sed 's/\.clj$//; s/_/-/g; s/\//./g')
fi
nss=""
for n in "$@"; do nss="$nss '$n"; done
exec java -Xss16m -cp "$ARBACE_CP:$root/test:$frozen" -Darbace.tmp="$root/.tmp" arbace.lang.Main -e "
(require 'arbace.test)
(apply require [$nss])
(let [r (apply arbace.test/run-tests [$nss])]
  (shutdown-agents)
  (System/exit (if (zero? (+ (:fail r) (:error r))) 0 1)))"

#!/bin/bash
# c2g: class forms to Go forms (doc/go/C2G-SPEC.md, doc/go/C2G-NOTES.md), on Arbace
# (bin/lib/tools.bash: target/stage2, built by bin/build-arbace).
#
# Usage: bin/c2g [OPTIONS] (see arbace/c2g/main.clj, or bin/c2g --help)
# Environment: C2G_JVM_OPTS (default -Xmx12g), JRT_CONV (default .tmp/jrt/conv, from
# bin/jrt-convert).
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tools.bash"
arbace_runtime
cd "$root"
# shellcheck disable=SC2086
exec java -Xss64m ${C2G_JVM_OPTS:--Xmx12g} --add-modules ALL-SYSTEM -cp "$ARBACE_CP" arbace.lang.Main -m arbace.c2g.main "$@"

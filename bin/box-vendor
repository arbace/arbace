#!/bin/bash
# box/'s Go forms (B1b, doc/go/BOX-NOTES.md): go-whim's box, vendored at S0 and Arbace's own since
# (box/README.md; "go-whim vendored whole", 2026-10-16: nothing is taken from go-whim any more),
# purego for the launcher on darwin/arm64, and the box's own packages; their checks.
#
#   bin/box-vendor print DIR   box/ printed with its tests into DIR/mod (bin/build-go --print-only
#                              --tests --goos tamago --layout lines): a module arbace that builds,
#                              type-checks and tests every configuration, TamaGo's goos module
#                              required, so that its Go guests build too
#   bin/box-vendor convert DIR PKG...
#                              the packages PKG (box/'s paths: guest, guest/demo, ...) of the module
#                              DIR (a printing, edited, or a package written as Go) converted
#                              (bin/repr-go read --tests) for each configuration that holds some of
#                              their files, merged (file forms identical across configurations,
#                              package files without :config, other files copied) and put in place
#                              of theirs in OUT/go/arbace/box. The forms of a package converted so
#                              are its Go's, `;` comments and all; a package edited as forms keeps
#                              them only when converted from its own Go (BOX-NOTES.md, "How box/
#                              was changed": the edit three-way merged into box/'s forms instead)
#   bin/box-vendor roundtrip   the round trip of box/: print it (with tests) into WORK/rt-print,
#                              convert the printed Go for each configuration (bin/repr-go read
#                              --tests) and merge, as `convert` does, into WORK/rt-box, print that
#                              into WORK/rt-print2, and compare each package of the two printings
#                              with gocmp (tree, export, code; with tests) per configuration. In
#                              bin/gate --full
#   bin/box-vendor kvm-tests   box/'s tests on /dev/kvm, on box/ printed (`print`): hv's, vmm's
#                              and tree's, and the guest tests (package guest: the bare guest, Go's
#                              assembly with no runtime; the demo and faulty Go guests on the
#                              board; each built by TamaGo's go as the test runs). In bin/gate --full
#   bin/box-vendor kvm-tests-arm64 DIR
#                              the same tests compiled for linux/arm64 into DIR (hv.test,
#                              vmm.test, guest.test) and the guests built for arm64 into
#                              DIR/guests (guest's TestImages), to run on KVM/arm64 with
#                              ARBACE_BOX_GUESTS=DIR/guests: in the aarch64 VM, which has no Go
#                              (bin/box-arm64-vm hv; doc/go/BOX-NOTES.md, S4)
#   bin/box-vendor purego      purego (BX62) converted from Go's module cache into
#                              OUT/go/arbace/box/purego*
#   bin/box-vendor purego-check
#                              purego's forms proved: printed against the module's files (gocmp),
#                              and the darwin/arm64 launcher built from them byte-identical to one
#                              built from the module's. In bin/gate --full
#
# Options (before the command): --work DIR (default .tmp/box-vendor), --out DIR (default box/, the
# forms' source root: OUT/go/arbace/box). Until 2026-10-16 the script also replayed S0's
# derivation from a clone of go-whim (`convert`, `check`, `all`: doc/go/BOX-NOTES.md, S0) and ran
# go-whim's tests on box/ in one (`kvm-tests`, `kvm-tests-arm64`); retired with go-whim's tests
# vendored into box/ (BOX-NOTES.md, "go-whim vendored whole").
# Environment: ARBACE_GOROOT / TAMAGO_ROOT (default /root/tamago-go: TamaGo's go1.27.1, the guests'
# and repr/go's toolchain, also the tests': none uses the host's `go`, so a system upgrade of Go
# changes nothing here). Nothing here uses cgo (CGO_ENABLED=0).
# repr/go runs on Arbace's Go executable (bin/repr-go, bin/lib/repr-go-host.bash: the tools' host).
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/renamed-env.bash" # stops on a stale G2A_*, J2A_*, A2G_* or C2A_*
work=$root/.tmp/box-vendor out=$root/box
while [ $# -gt 0 ]; do
  case $1 in
    --work) work=$2; shift 2 ;;
    --out) out=$2; shift 2 ;;
    *) break ;;
  esac
done
cmd=${1:-}
case $work in /*) ;; *) work=$root/$work ;; esac
case $out in /*) ;; *) out=$root/$out ;; esac
tg=${TAMAGO_ROOT:-${ARBACE_GOROOT:-/root/tamago-go}}
export GOPROXY=off GOFLAGS= GOTOOLCHAIN=local GOWORK=off CGO_ENABLED=0
# `go` is TamaGo's (its linux and darwin builds are upstream Go's), never the host's
export GOROOT=$tg PATH=$tg/bin:$PATH
# the packages vendored from go-whim at S0 (abi, board, hv, libsys, vmm), purego's (BX62:
# vendored from its module for darwin/arm64, the one configuration that imports it), and Arbace's
# own: the launcher (S1), the trees and the tool guests' shim (S7), the test guests (2026-10-16)
whim_pkgs="abi board hv libsys vmm"
purego_pkgs="purego purego/internal/fakecgo purego/internal/strings"
own_pkgs="cmd/arbace-box tree tool guest guest/demo guest/cmd/bare guest/cmd/demo guest/cmd/faulty kernel guest/cmd/ktest"
pkgs="$whim_pkgs $purego_pkgs $own_pkgs"
purego_mod=github.com/ebitengine/purego purego_ver=v0.11.1 purego_zip=h1:2zpWRSQNVKN4eKsKO9eM1ILDgWfYMY9GwqRmK6XeQ/0=

usage() { sed -n '2,/^set -/p' "$0" | sed '$d; s/^# \{0,1\}//' >&2; exit 2; }

# the configurations, and the packages each holds files of: the monitor and the launcher
# (linux, darwin/arm64 with purego: BX61, BX62), the guests' (tamago); the test guests' host side
# and the bare guest on linux, the Go guests on tamago
configs="linux/amd64:abi,hv,vmm,cmd/arbace-box,tree,guest,guest/demo,guest/cmd/bare
linux/arm64:abi,hv,vmm,cmd/arbace-box,tree,guest,guest/demo,guest/cmd/bare
darwin/arm64:abi,hv,libsys,vmm,cmd/arbace-box,purego,purego/internal/fakecgo,purego/internal/strings,tree
tamago/amd64:abi,board,kernel,tree,tool,guest/demo,guest/cmd/demo,guest/cmd/faulty,guest/cmd/ktest
tamago/arm64:abi,board,tree,tool,guest/demo,guest/cmd/demo,guest/cmd/faulty"

# convert_configs DIR FORMS LOGPREFIX [PKG...]: the packages of the module DIR (all of each
# configuration's, or those of PKG it holds) converted per configuration into FORMS/GOOS-GOARCH
convert_configs() {
  local dir=$1 forms=$2 logp=$3 c goos goarch list args p; shift 3
  local sel=" $* "
  rm -rf "$forms"
  for c in $configs; do
    goos=${c%%/*}; goarch=${c#*/}; goarch=${goarch%%:*}; list=${c#*:}
    args=(); for p in ${list//,/ }; do
      if [ $# -eq 0 ] || [[ $sel == *" $p "* ]]; then args+=("arbace/box/$p"); fi
    done
    [ ${#args[@]} -gt 0 ] || continue
    echo "== convert $goos/$goarch: ${args[*]}" >&2
    (cd "$dir" && "$root/bin/repr-go" read --tests --goos "$goos" --goarch "$goarch" \
       --out "$forms/$goos-$goarch" "${args[@]}") > "$logp-$goos-$goarch.log" 2>&1 \
      || { tail -20 "$logp-$goos-$goarch.log" >&2; return 1; }
    if grep -v '^ok' "$forms/$goos-$goarch.tsv" >&2; then
      echo "convert $goos/$goarch: a package did not read without errors ($logp-$goos-$goarch.log)" >&2; return 1
    fi
  done
}

# convert DIR PKG...: the packages PKG of the module DIR into OUT/go/arbace/box
convert() {
  local dir p
  [ $# -ge 2 ] || usage
  dir=$(cd "$1" && pwd); shift
  for p; do
    [ -d "$dir/box/$p" ] || { echo "box-vendor: no package $dir/box/$p" >&2; return 1; }
    [[ " $pkgs " == *" $p "* ]] || { echo "box-vendor: $p is not one of box/'s packages ($pkgs): add it here first" >&2; return 1; }
  done
  mkdir -p "$work"
  convert_configs "$dir" "$work/cv-forms" "$work/cv-convert" "$@" || return 1
  merge_pkgs="$*" merge_src=$dir/box merge_forms=$work/cv-forms merge
}

# purego_dir: purego's module in Go's module cache, its hash checked
purego_dir() {
  local c
  c=$(env -u GOOS -u GOARCH GOROOT="$tg" "$tg/bin/go" env GOMODCACHE)
  [ "$(cat "$c/cache/download/$purego_mod/@v/$purego_ver.ziphash" 2>/dev/null)" = "$purego_zip" ] \
    || { echo "box-vendor: $purego_mod@$purego_ver is not in Go's module cache with the pinned hash $purego_zip" >&2; return 1; }
  echo "$c/$purego_mod@$purego_ver"
}

# purego_renamed DIR: purego's files that build for darwin/arm64 (its packages purego,
# internal/fakecgo and internal/strings: their Go files, assembly and headers) in DIR/box/purego of
# a module arbace (DIR/go.mod), every import of them rewritten to arbace/box/purego (the only
# change to their text, as go-whim's packages were renamed)
purego_renamed() {
  local d=$1 m p f
  m=$(purego_dir) || return 1
  rm -rf "$d"; mkdir -p "$d/box/purego"
  printf 'module arbace\n\ngo 1.27\n' > "$d/go.mod"
  for p in . internal/fakecgo internal/strings; do
    mkdir -p "$d/box/purego/$p"
    for f in $(cd "$m/$p" && env GOOS=darwin GOARCH=arm64 CGO_ENABLED=0 GOFLAGS=-mod=mod GOROOT="$tg" "$tg/bin/go" list \
                 -f '{{range .GoFiles}}{{.}} {{end}}{{range .SFiles}}{{.}} {{end}}{{range .HFiles}}{{.}} {{end}}' .); do
      cp "$m/$p/$f" "$d/box/purego/$p/$f"
    done
  done
  chmod -R u+w "$d"
  find "$d/box/purego" -type f \( -name '*.go' -o -name '*.s' \) -print0 \
    | xargs -0 sed -i "s#\"$purego_mod/internal/#\"arbace/box/purego/internal/#; s#\"$purego_mod\"#\"arbace/box/purego\"#"
}

# purego_convert: purego (BX62) converted for darwin/arm64 into OUT/go/arbace/box/purego*, as
# go-whim's packages are: from WORK/purego (purego_renamed), merged as one configuration
purego_convert() {
  local args=() p
  purego_renamed "$work/purego" || return 1
  rm -rf "$work/purego-forms"
  for p in $purego_pkgs; do args+=("arbace/box/$p"); done
  echo "== convert darwin/arm64: ${args[*]} (purego $purego_ver)" >&2
  (cd "$work/purego" && "$root/bin/repr-go" read --goos darwin --goarch arm64 --out "$work/purego-forms/darwin-arm64" "${args[@]}") >&2
  if grep -v '^ok' "$work/purego-forms/darwin-arm64.tsv" >&2; then
    echo "convert purego: a package did not read without errors" >&2; return 1
  fi
  rm -rf "$work/purego-merged"
  merge_pkgs=$purego_pkgs merge_src=$work/purego/box merge_forms=$work/purego-forms \
    merge_dst=$work/purego-merged/go/arbace/box merge || return 1
  rm -rf "$out/go/arbace/box/purego" "$out/go/arbace/box/purego.ae"
  cp -r "$work/purego-merged/go/arbace/box/purego" "$work/purego-merged/go/arbace/box/purego.ae" "$out/go/arbace/box/"
  echo "purego: $(find "$out/go/arbace/box/purego" "$out/go/arbace/box/purego.ae" -type f | wc -l) files into ${out#$root/}/go/arbace/box/purego" >&2
}

# merge: the configurations' trees of the packages merge_pkgs (default all) into one,
# merge_dst (default OUT/go/arbace/box), from the Go of merge_src (a module's box/) and the forms of
# merge_forms (GOOS-GOARCH/...), each package's forms and package file put in place of
# what was there (its subpackages' left)
merge() {
  local dst=${merge_dst:-$out/go/arbace/box} src=$merge_src p fp c f b files tests others
  mkdir -p "$dst"
  for p in ${merge_pkgs:-$pkgs}; do
    [ -d "$src/$p" ] || continue
    # the forms' directory and file names: the path's, - as _ (SPEC §4.1, as the converter writes)
    fp=${p//-/_}
    # (a file X.ae beside a directory X is the package file of the subpackage X, not a form)
    if [ -d "$dst/$fp" ]; then
      for f in "$dst/$fp"/*; do
        [ -f "$f" ] && [ ! -d "${f%.ae}" ] && rm -f "$f"
      done
    fi
    mkdir -p "$dst/$fp"
    for c in "$merge_forms"/*/; do
      [ -d "$c/go/arbace/box/$fp" ] || continue
      for f in "$c/go/arbace/box/$fp"/*.ae; do
        [ -f "$f" ] && [ ! -d "${f%.ae}" ] || continue
        b=$(basename "$f")
        if [ -f "$dst/$fp/$b" ]; then
          cmp -s "$f" "$dst/$fp/$b" || { echo "merge: $p/$b differs by configuration" >&2; return 1; }
        else
          cp "$f" "$dst/$fp/$b"
        fi
      done
    done
    files=() tests=() others=()
    for f in $(cd "$dst/$fp" && LC_ALL=C ls | grep '\.ae$'); do
      [ -f "$dst/$fp/$f" ] && [ ! -d "$dst/$fp/${f%.ae}" ] || continue
      b=${f%.ae}
      case $b in *_test) tests+=("$b") ;; *) files+=("$b") ;; esac
    done
    for f in $(cd "$src/$p" && LC_ALL=C ls); do
      [ -f "$src/$p/$f" ] || continue
      case $f in *.go) ;; *) others+=("$f"); cp "$src/$p/$f" "$dst/$fp/" ;; esac
    done
    {
      case $p in
        cmd/*) echo ";; The box's launcher (doc/go/BOX-NOTES.md, S1): the package arbace/box/$p, Arbace's own." ;;
        tree|tool) echo ";; The box's tool guests (doc/go/BOX-NOTES.md, S7): the package arbace/box/$p, Arbace's own." ;;
        kernel) echo ";; The box's kernel: processes at ring 3 (doc/go/PROCESS-SPEC.md, KU1): the package"
                echo ";; arbace/box/$p, Arbace's own." ;;
        guest*) echo ";; The box's test guests (doc/go/BOX-NOTES.md, \"go-whim vendored whole\"): the package"
                echo ";; arbace/box/$p, Arbace's own." ;;
        purego*) echo ";; purego $purego_ver, vendored (box/README.md; doc/go/BOX-NOTES.md, S4, BX62): the package"
                 echo ";; arbace/box/$p, its files for darwin/arm64." ;;
        *) echo ";; go-whim's box, vendored (box/README.md): the package arbace/box/$p, one tree for"
           echo ";; every target (its files' build constraints select them)." ;;
      esac
      fp=${fp//\//.}
      echo "(ns go.arbace.box.$fp"
      echo "  (:require [arbace.go :as go]))"
      echo
      echo "(go/package $(pkg_name "$p")"
      echo "  :path \"arbace/box/$p\""
      echo "  :files [$(names .go "${files[@]}")]"
      [ ${#others[@]} -eq 0 ] || echo "  :other-files [$(names "" "${others[@]}")]"
      [ ${#tests[@]} -eq 0 ] || echo "  :test-files [$(names .go "${tests[@]}")]"
      echo "  :positions :lines)"
      echo
      for b in "${files[@]}" ${tests[@]+"${tests[@]}"}; do echo "(load \"$(basename "${p//-/_}")/$b\")"; done
    } > "$dst/${p//-/_}.ae"
  done
  echo "merged into ${dst#$root/}: $(find "$dst" -name '*.ae' | wc -l) forms files" >&2
}

# pkg_name P: the Go package name of the box's package P (a command's is main)
pkg_name() {
  case $1 in cmd/*|*/cmd/*) echo main ;; *) basename "$1" ;; esac
}

# names SUFFIX NAME...: "NAME1SUFFIX" "NAME2SUFFIX" ...
names() {
  local suffix=$1 s="" n; shift
  for n in "$@"; do s+="${s:+ }\"$n$suffix\""; done
  echo "$s"
}

# print_box DIR SRC [BUILD-GO-OPTION...]: SRC (a forms' root holding go/arbace/box) printed with its
# tests into DIR/mod, a module arbace that builds and type-checks every configuration (purego for
# darwin vendored in it since S4, BX62)
print_box() {
  local d=$1 s=$2; shift 2
  rm -rf "$d"
  "$root/bin/build-go" --print-only --tests --module arbace --layout lines "$@" --work "$d" "$s" >&2 || return 1
}

# roundtrip: box/ printed, converted back and printed again; the two printings compared (gocmp)
roundtrip() {
  local status=0 c goos goarch list p f r gocmp=$work/gocmp
  mkdir -p "$work"
  echo "== print ${out#$root/}" >&2
  print_box "$work/rt-print" "$out" || return 1
  convert_configs "$work/rt-print/mod" "$work/rt-forms" "$work/rt-convert" || return 1
  rm -rf "$work/rt-box"
  merge_src=$work/rt-print/mod/box merge_forms=$work/rt-forms merge_dst=$work/rt-box/go/arbace/box merge || return 1
  echo "== print the converted forms" >&2
  print_box "$work/rt-print2" "$work/rt-box" || return 1
  (cd "$root/tools/gocmp" && env -u GOOS -u GOARCH GOROOT="$tg" "$tg/bin/go" build -o "$gocmp" .)
  echo "== the printings compared (gocmp: tree, export, code; with tests)" >&2
  for c in $configs; do
    goos=${c%%/*}; goarch=${c#*/}; goarch=${goarch%%:*}; list=${c#*:}
    for p in ${list//,/ }; do
      f=$work/rt-gocmp-$goos-$goarch-${p//\//_}.log
      if (cd "$work/rt-print/mod" && env GOOS=$goos GOARCH=$goarch GOROOT="$tg" \
            "$gocmp" -tests "$work/rt-print/mod/box/$p" "$work/rt-print2/mod/box/$p") > "$f" 2>&1; then
        r=pass
      else
        r=FAIL; status=1
      fi
      printf '%-14s %-18s %s  %s\n' "$goos/$goarch" "$p" "$r" "$(tail -1 "$f")"
    done
  done
  return $status
}

# purego_check: purego's forms (BX62) proved, after purego_convert's WORK/purego exists (the
# renamed originals): 1. each package printed against its renamed original, gocmp (tree, export,
# code) for darwin/arm64; 2. the darwin/arm64 launcher built from box/ printed is byte-identical
# to one built with the renamed originals in place of the printed purego; 3. at purego's own
# path (hv's and libsys' imports renamed back): the launcher built against purego's module (its
# files from Go's module cache) is byte-identical to one built against the printed purego (its
# imports renamed back, its go.mod purego's), each by a replace to the same directory. Builds
# -trimpath -buildvcs=false -ldflags=-buildid=, with DWARF: the printer places each name of a
# parameter list that spans lines on its own line (until 2026-10-12 it linked with -w, the names
# all on the list's first line moving their DWARF declaration lines; doc/go/BOX-NOTES.md, S4)
purego_check() {
  local status=0 p f r gocmp=$work/gocmp pc=$work/purego-check m b
  [ -d "$work/purego/box/purego" ] || purego_renamed "$work/purego" || return 1
  m=$(purego_dir) || return 1
  print_box "$work/purego-print" "$out" || return 1
  (cd "$root/tools/gocmp" && env -u GOOS -u GOARCH GOROOT="$tg" "$tg/bin/go" build -o "$gocmp" .)
  echo "== 1. purego printed against its renamed original (gocmp: tree, export, code; darwin/arm64)" >&2
  for p in $purego_pkgs; do
    f=$work/purego-gocmp-${p//\//_}.log
    if (cd "$work/purego" && env GOOS=darwin GOARCH=arm64 GOROOT="$tg" CGO_ENABLED=0 \
          "$gocmp" "$work/purego/box/$p" "$work/purego-print/mod/box/$p") > "$f" 2>&1; then
      r=pass
    else
      r=FAIL; status=1
    fi
    printf '%-14s %-26s %s  %s\n' darwin/arm64 "$p" "$r" "$(tail -1 "$f")"
  done
  launcher() { # MODULE-DIR OUT
    (cd "$1" && env GOOS=darwin GOARCH=arm64 GOARM64=v8.0 CGO_ENABLED=0 GOROOT="$tg" GOTOOLCHAIN=local GOFLAGS= \
       GOWORK=off GOPROXY=off "$tg/bin/go" build -trimpath -buildvcs=false -ldflags=-buildid= -o "$2" ./box/cmd/arbace-box)
  }
  rm -rf "$pc"; mkdir -p "$pc"
  echo "== 2. the darwin/arm64 launcher: printed purego, renamed originals" >&2
  launcher "$work/purego-print/mod" "$pc/printed" || return 1
  cp -r "$work/purego-print/mod" "$pc/renamed-mod"
  rm -rf "$pc/renamed-mod/box/purego"; cp -r "$work/purego/box/purego" "$pc/renamed-mod/box/purego"
  launcher "$pc/renamed-mod" "$pc/renamed" || return 1
  if cmp -s "$pc/printed" "$pc/renamed"; then r=identical; else r=DIFFERENT; status=1; fi
  printf 'arbace-box darwin/arm64, arbace/box/purego: %d bytes, printed %s\n' "$(stat -c %s "$pc/renamed")" "$r"
  echo "== 3. at purego's path: its module's files and the printed ones, by a replace (one directory)" >&2
  cp -r "$work/purego-print/mod" "$pc/at-mod"
  rm -rf "$pc/at-mod/box/purego"
  sed -i "s#\"arbace/box/purego\"#\"$purego_mod\"#" "$pc/at-mod/box/hv/hvf_darwin.go" "$pc/at-mod/box/libsys/libsys.go"
  printf '\nrequire %s %s\n\nreplace %s %s => %s\n' "$purego_mod" "$purego_ver" "$purego_mod" "$purego_ver" "$pc/purego-at" \
    >> "$pc/at-mod/go.mod"
  # the module's own files (Go's module cache), then the printed ones, at the same directory
  rm -rf "$pc/purego-at"; cp -r "$m" "$pc/purego-at"; chmod -R u+w "$pc/purego-at"
  launcher "$pc/at-mod" "$pc/at-module" || return 1
  rm -rf "$pc/purego-at"; cp -r "$work/purego-print/mod/box/purego" "$pc/purego-at"
  find "$pc/purego-at" -name '*.go' -print0 | xargs -0 sed -i "s#\"arbace/box/purego#\"$purego_mod#"
  cp "$m/go.mod" "$pc/purego-at/go.mod"
  launcher "$pc/at-mod" "$pc/at-printed" || return 1
  if cmp -s "$pc/at-module" "$pc/at-printed"; then r=identical; else r=DIFFERENT; status=1; fi
  printf 'arbace-box darwin/arm64, %s %s: %d bytes, printed %s\n' "$purego_mod" "$purego_ver" "$(stat -c %s "$pc/at-module")" "$r"
  return $status
}

# kvm_tests [DIR]: box/'s tests on /dev/kvm, on box/ printed; with DIR, compiled for linux/arm64
# into DIR and the guests built for arm64 into DIR/guests
kvm_tests() {
  local arm64=${1:-} d=$work/kvm-print/mod p
  mkdir -p "$work"
  echo "== print ${out#$root/}" >&2
  print_box "$work/kvm-print" "$out" --goos tamago || return 1
  if [ -n "$arm64" ]; then
    mkdir -p "$arm64/guests"
    echo "== box/'s KVM tests compiled for linux/arm64 into $arm64, the guests into $arm64/guests" >&2
    (cd "$d" && for p in hv vmm guest; do
       GOOS=linux GOARCH=arm64 go test -c -o "$arm64/$p.test" arbace/box/$p || exit 1
     done) || return 1
    (cd "$d" && env -u GOOS -u GOARCH TAMAGO_ROOT="$tg" ARBACE_BOX_GUESTS_OUT="$arm64/guests" ARBACE_BOX_GUESTS_ARCH=arm64 \
       go test -count=1 -run '^TestImages$' arbace/box/guest) || return 1
    ls "$arm64/guests" >&2
    return
  fi
  echo "== box/'s tests (/dev/kvm)" >&2
  (
    cd "$d"
    export TAMAGO_ROOT=$tg
    s=0
    go test -count=1 -v arbace/box/hv arbace/box/vmm arbace/box/tree > "$work/kvm-box.log" 2>&1 || s=1
    grep -E '^(--- |ok|FAIL|panic)' "$work/kvm-box.log"
    go test -count=1 -v arbace/box/guest > "$work/kvm-guest.log" 2>&1 || s=1
    grep -E '^(--- |ok|FAIL|panic)' "$work/kvm-guest.log"
    exit $s
  )
}

case $cmd in
  print) [ $# -eq 2 ] || usage; print_box "$2" "$out" --goos tamago && echo "box-vendor: ${out#$root/} printed into $2/mod" >&2 ;;
  convert) shift; convert "$@" ;;
  roundtrip) roundtrip ;;
  kvm-tests) kvm_tests ;;
  kvm-tests-arm64) [ $# -ge 2 ] || usage
    kvm_tests "$(mkdir -p "$2" && cd "$2" && pwd)" ;;
  purego) purego_convert ;;
  purego-check) purego_check ;;
  *) usage ;;
esac

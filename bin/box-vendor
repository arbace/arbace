#!/bin/bash
# go-whim's box vendored as Go forms (B1b stage S0, doc/go/BOX-NOTES.md): replays the derivation
# of box/ from go-whim, and proves it.
#
#   bin/box-vendor convert   clone go-whim at its commit into WORK/orig and WORK/renamed, move the
#                            box's packages in WORK/renamed into a module `arbace` (paths
#                            arbace/box/{abi,board,hv,libsys,vmm}) and rewrite every import of
#                            them; convert them (bin/g2a convert --tests) for each configuration
#                            that holds some of their files (linux/amd64, linux/arm64,
#                            darwin/arm64, tamago/amd64, tamago/arm64) into WORK/forms; merge the
#                            five trees into OUT/go/arbace/box (one tree for every target: file
#                            forms identical across configurations, package files without
#                            :config or :init-order, the assembly copied as other files)
#   bin/box-vendor check     print OUT (bin/g2a build --print-only --tests --layout lines) into
#                            WORK/print, put the printed packages in place of the renamed ones in a
#                            third clone WORK/printed, and check:
#                            1. gocmp (the round trip's oracle: tree, export, code) of each package
#                               printed against the renamed original, with tests, per configuration
#                            2. go-whim's monitor (vmm/cmd/whim-guest: linux/amd64, linux/arm64,
#                               darwin/arm64) and TamaGo guests (guest/tamago: the editor and
#                               ./faulty, amd64 and arm64) built from WORK/printed are byte-identical
#                               to those built from WORK/renamed (-ldflags=-buildid=: the build ID
#                               hashes the source text, which the printer does not keep), and
#                               built from WORK/orig (go-whim itself) for comparison
#                            3. go-whim's tests on WORK/printed, on /dev/kvm: hv, vmm, and the guest
#                               tests that run the C and the TamaGo guests
#   bin/box-vendor all       both
#   bin/box-vendor roundtrip the round trip of box/ as it is (S1 on: Arbace's own changes made): print
#                            it (with tests) into WORK/rt-print, convert the printed Go for each
#                            configuration (bin/g2a convert --tests) and merge, as `convert` does,
#                            into WORK/rt-box, print that into WORK/rt-print2, and compare each
#                            package of the two printings with gocmp (tree, export, code; with
#                            tests) per configuration. In bin/gate --full
#   bin/box-vendor kvm-tests go-whim's tests on box/ as it is, on /dev/kvm: a clone of go-whim at the
#                            commit, renamed, its box packages replaced by box/ printed, and one
#                            adaptation: go-whim's editor.Exit given the method ExitCode, which
#                            vmm.Run recovers since S1 (vmm no longer imports the editor); then
#                            hv's, vmm's and the guest tests (C and TamaGo guests on the monitor;
#                            the Go editor guest on the board). In bin/gate --full
#   bin/box-vendor kvm-tests-arm64 DIR
#                            the same clone, hv's and vmm's tests compiled for linux/arm64
#                            into DIR (hv.test, vmm.test), to run on KVM/arm64: in the
#                            aarch64 VM (bin/box-arm64-vm hv; doc/go/BOX-NOTES.md, S4). The guest
#                            tests build their guests with TamaGo and a C compiler as they run:
#                            not compiled (the box's smoke test runs Arbace's guest there)
#
# Options (before the command): --src DIR (default /root/go-whim, read only: cloned), --commit REV
# (default 80c49bf, S0's), --work DIR (default .tmp/box-vendor), --out DIR (default box/, the
# forms' source root: OUT/go/arbace/box; check prints OUT), --from DIR (convert: a renamed clone
# whose box packages, edited, are converted in place of go-whim's: how S1's changes were made,
# doc/go/BOX-NOTES.md). The byte-identity proof (check) holds for box/ as S0 vendored it: since
# S1 changed vmm's dispatch, `check` shows the change; roundtrip and kvm-tests are box/'s checks.
# Environment: G2A_GOROOT / TAMAGO_ROOT (default /root/tamago-go: TamaGo's go1.27.1, the guests'
# and g2a's toolchain, also the monitor's and go-whim's tests': none uses the host's `go`, so
# a system upgrade of Go changes nothing here).
# g2a runs on Arbace's Go executable (bin/g2a, bin/lib/g2a-host.bash: the tools' host).
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
src=/root/go-whim commit=80c49bf work=$root/.tmp/box-vendor out=$root/box from=
while [ $# -gt 0 ]; do
  case $1 in
    --src) src=$2; shift 2 ;;
    --commit) commit=$2; shift 2 ;;
    --work) work=$2; shift 2 ;;
    --out) out=$2; shift 2 ;;
    --from) from=$2; shift 2 ;;
    *) break ;;
  esac
done
cmd=${1:-}
case $work in /*) ;; *) work=$root/$work ;; esac
case $out in /*) ;; *) out=$root/$out ;; esac
tg=${TAMAGO_ROOT:-${G2A_GOROOT:-/root/tamago-go}}
export GOPROXY=off GOFLAGS= GOTOOLCHAIN=local
# `go` is TamaGo's (its linux and darwin builds are upstream Go's), never the host's
export GOROOT=$tg PATH=$tg/bin:$PATH
# go-whim's packages (and the launcher, Arbace's own), and purego's (BX62: vendored from its
# module for darwin/arm64, the one configuration that imports it)
whim_pkgs="abi board hv libsys vmm cmd/arbace-box"
purego_pkgs="purego purego/internal/fakecgo purego/internal/strings"
pkgs="$whim_pkgs $purego_pkgs"
purego_mod=github.com/ebitengine/purego purego_ver=v0.11.1 purego_zip=h1:2zpWRSQNVKN4eKsKO9eM1ILDgWfYMY9GwqRmK6XeQ/0=

# clone DIR: go-whim at the commit, read only from its repository
clone() {
  rm -rf "$1"
  git clone -q "$src" "$1"
  git -C "$1" checkout -q --detach "$commit"
}

# rename DIR: the box's packages of the clone DIR moved into the module arbace at DIR/_arbace
# (a sibling module: arbace/box/... cannot be under github.com/arbace/go-whim), every import of
# them rewritten; the go.mod files require and replace it. libsys leaves internal/: editor/term
# (darwin) imports it, and arbace/box/internal would refuse it.
rename() {
  local d=$1 p=github.com/arbace/go-whim f m
  (
    cd "$d"
    mkdir -p _arbace/box/vmm
    git mv hv _arbace/box/hv
    for f in vmm/*; do [ "$f" = vmm/cmd ] || git mv "$f" _arbace/box/vmm/; done
    git mv guest/abi _arbace/box/abi
    git mv guest/tamago/board _arbace/box/board
    git mv internal/libsys _arbace/box/libsys
    git ls-files -z '*.go' | xargs -0 sed -i \
      -e "s#\"$p/hv\"#\"arbace/box/hv\"#" \
      -e "s#\"$p/vmm\"#\"arbace/box/vmm\"#" \
      -e "s#\"$p/guest/abi\"#\"arbace/box/abi\"#" \
      -e "s#\"$p/guest/tamago/board\"#\"arbace/box/board\"#" \
      -e "s#\"$p/internal/libsys\"#\"arbace/box/libsys\"#"
    cat > _arbace/go.mod <<'EOF'
module arbace

go 1.27.1

require (
	github.com/arbace/go-whim v0.0.0
	github.com/ebitengine/purego v0.11.1
)

// for building and comparing this module alone (gocmp); ignored when it is a dependency
replace (
	github.com/arbace/go-whim => ../
	github.com/arbace/go-whim/crefactor => ../crefactor
)
EOF
    grep purego go.sum > _arbace/go.sum
    printf '\nrequire arbace v0.0.0\n\nreplace arbace => ./_arbace\n' >> go.mod
    for m in guest/tamago guest/joker; do
      printf '\nrequire arbace v0.0.0\n\nreplace arbace => ../../_arbace\n' >> $m/go.mod
    done
    grep purego go.sum >> guest/tamago/go.sum
    git add -A .
    git -c user.name=box-vendor -c user.email=box-vendor@localhost commit -q -m "box: renamed"
  )
}

# the configurations converted, and the packages each holds files of
configs="linux/amd64:abi,hv,vmm,cmd/arbace-box linux/arm64:abi,hv,vmm,cmd/arbace-box darwin/arm64:abi,hv,libsys,vmm tamago/amd64:abi,board tamago/arm64:abi,board"
# box/'s configurations as it is (the round trip): go-whim's, the launcher on darwin (BX61), purego
rt_configs="linux/amd64:abi,hv,vmm,cmd/arbace-box linux/arm64:abi,hv,vmm,cmd/arbace-box darwin/arm64:abi,hv,libsys,vmm,cmd/arbace-box,purego,purego/internal/fakecgo,purego/internal/strings tamago/amd64:abi,board tamago/arm64:abi,board"

convert() {
  local c goos goarch list args p dir f b
  if [ -n "$from" ]; then
    # S1 on (BOX-NOTES.md): the box's Go as edited in FROM, a renamed clone (its packages under
    # FROM/_arbace/box), converted in place of go-whim's
    rm -rf "$work/renamed"
    mkdir -p "$work"
    cp -a "$from" "$work/renamed"
  else
    clone "$work/orig"
    clone "$work/renamed"
    rename "$work/renamed"
  fi
  rm -rf "$work/forms"
  for c in $configs; do
    goos=${c%%/*}; goarch=${c#*/}; goarch=${goarch%%:*}; list=${c#*:}
    args=(); for p in ${list//,/ }; do args+=("arbace/box/$p"); done
    # the guests' packages from the guest module (GOOS=tamago), the rest from go-whim's
    dir=$work/renamed; [ "$goos" = tamago ] && dir=$work/renamed/guest/tamago
    echo "== convert $goos/$goarch: ${args[*]}" >&2
    (cd "$dir" && "$root/bin/g2a" convert --tests --goos "$goos" --goarch "$goarch" \
       --out "$work/forms/$goos-$goarch" "${args[@]}") >&2
    if grep -v '^ok' "$root/.tmp/g2a/dumps.tsv" >&2; then
      echo "convert $goos/$goarch: a package did not dump" >&2; return 1
    fi
  done
  merge_pkgs=$whim_pkgs merge
  purego_convert
}

# purego_dir: purego's module in Go's module cache, its hash checked
purego_dir() {
  local c
  c=$(env -u GOOS -u GOARCH GOROOT="$tg" "$tg/bin/go" env GOMODCACHE)
  [ "$(cat "$c/cache/download/$purego_mod/@v/$purego_ver.ziphash" 2>/dev/null)" = "$purego_zip" ] \
    || { echo "box-vendor: $purego_mod@$purego_ver is not in Go's module cache with the pinned hash $purego_zip" >&2; return 1; }
  echo "$c/$purego_mod@$purego_ver"
}

# purego_renamed DIR: purego's files that build for darwin/arm64 (its packages purego,
# internal/fakecgo and internal/strings: their Go files, assembly and headers) in DIR/box/purego of
# a module arbace (DIR/go.mod), every import of them rewritten to arbace/box/purego (the only
# change to their text, as go-whim's packages were renamed)
purego_renamed() {
  local d=$1 m p f
  m=$(purego_dir) || return 1
  rm -rf "$d"; mkdir -p "$d/box/purego"
  printf 'module arbace\n\ngo 1.27\n' > "$d/go.mod"
  for p in . internal/fakecgo internal/strings; do
    mkdir -p "$d/box/purego/$p"
    for f in $(cd "$m/$p" && env GOOS=darwin GOARCH=arm64 CGO_ENABLED=0 GOFLAGS=-mod=mod GOROOT="$tg" "$tg/bin/go" list \
                 -f '{{range .GoFiles}}{{.}} {{end}}{{range .SFiles}}{{.}} {{end}}{{range .HFiles}}{{.}} {{end}}' .); do
      cp "$m/$p/$f" "$d/box/purego/$p/$f"
    done
  done
  chmod -R u+w "$d"
  find "$d/box/purego" -type f \( -name '*.go' -o -name '*.s' \) -print0 \
    | xargs -0 sed -i "s#\"$purego_mod/internal/#\"arbace/box/purego/internal/#; s#\"$purego_mod\"#\"arbace/box/purego\"#"
}

# purego_convert: purego (BX62) converted for darwin/arm64 into OUT/go/arbace/box/purego*, as
# go-whim's packages are: from WORK/purego (purego_renamed), merged as one configuration
purego_convert() {
  local args=() p
  purego_renamed "$work/purego" || return 1
  rm -rf "$work/purego-forms"
  for p in $purego_pkgs; do args+=("arbace/box/$p"); done
  echo "== convert darwin/arm64: ${args[*]} (purego $purego_ver)" >&2
  (cd "$work/purego" && "$root/bin/g2a" convert --goos darwin --goarch arm64 --out "$work/purego-forms/darwin-arm64" "${args[@]}") >&2
  if grep -v '^ok' "$root/.tmp/g2a/dumps.tsv" >&2; then
    echo "convert purego: a package did not dump" >&2; return 1
  fi
  rm -rf "$work/purego-merged"
  merge_pkgs=$purego_pkgs merge_src=$work/purego/box merge_forms=$work/purego-forms \
    merge_dst=$work/purego-merged/go/arbace/box merge || return 1
  rm -rf "$out/go/arbace/box/purego" "$out/go/arbace/box/purego.ae"
  cp -r "$work/purego-merged/go/arbace/box/purego" "$work/purego-merged/go/arbace/box/purego.ae" "$out/go/arbace/box/"
  echo "purego: $(find "$out/go/arbace/box/purego" "$out/go/arbace/box/purego.ae" -type f | wc -l) files into ${out#$root/}/go/arbace/box/purego" >&2
}

# merge: the configurations' trees into one, OUT/go/arbace/box
merge() {
  local dst=${merge_dst:-$out/go/arbace/box} src=${merge_src:-$work/renamed/_arbace/box} p fp c f b files tests others
  rm -rf "$dst"; mkdir -p "$dst"
  for p in ${merge_pkgs:-$pkgs}; do
    [ -d "$src/$p" ] || continue
    # the forms' directory and file names: the path's, - as _ (SPEC §4.1, as the converter writes)
    fp=${p//-/_}
    mkdir -p "$dst/$fp"
    for c in "${merge_forms:-$work/forms}"/*/; do
      [ -d "$c/go/arbace/box/$fp" ] || continue
      for f in "$c/go/arbace/box/$fp"/*.ae; do
        b=$(basename "$f")
        if [ -f "$dst/$fp/$b" ]; then
          cmp -s "$f" "$dst/$fp/$b" || { echo "merge: $p/$b differs by configuration" >&2; return 1; }
        else
          cp "$f" "$dst/$fp/$b"
        fi
      done
    done
    files=() tests=() others=()
    for f in $(cd "$dst/$fp" && LC_ALL=C ls | grep '\.ae$'); do
      b=${f%.ae}
      case $b in *_test) tests+=("$b") ;; *) files+=("$b") ;; esac
    done
    for f in $(cd "$src/$p" && LC_ALL=C ls); do
      [ -f "$src/$p/$f" ] || continue
      case $f in *.go) ;; *) others+=("$f"); cp "$src/$p/$f" "$dst/$fp/" ;; esac
    done
    {
      case $p in
        cmd/*) echo ";; The box's launcher (doc/go/BOX-NOTES.md, S1): the package arbace/box/$p, Arbace's own." ;;
        purego*) echo ";; purego $purego_ver, vendored (box/README.md; doc/go/BOX-NOTES.md, S4, BX62): the package"
                 echo ";; arbace/box/$p, its files for darwin/arm64." ;;
        *) echo ";; go-whim's box, vendored (box/README.md): the package arbace/box/$p, one tree for"
           echo ";; every target (its files' build constraints select them)." ;;
      esac
      fp=${fp//\//.}
      echo "(ns go.arbace.box.$fp"
      echo "  (:require [arbace.go :as go]))"
      echo
      echo "(go/package $(pkg_name "$p")"
      echo "  :path \"arbace/box/$p\""
      echo "  :files [$(names .go "${files[@]}")]"
      [ ${#others[@]} -eq 0 ] || echo "  :other-files [$(names "" "${others[@]}")]"
      [ ${#tests[@]} -eq 0 ] || echo "  :test-files [$(names .go "${tests[@]}")]"
      echo "  :positions :lines)"
      echo
      for b in "${files[@]}" ${tests[@]+"${tests[@]}"}; do echo "(load \"$(basename "${p//-/_}")/$b\")"; done
    } > "$dst/${p//-/_}.ae"
  done
  echo "merged into ${dst#$root/}: $(find "$dst" -name '*.ae' | wc -l) forms files" >&2
}

wp=github.com/arbace/go-whim

# pkg_name P: the Go package name of the box's package P (a command's is main)
pkg_name() {
  case $1 in cmd/*) echo main ;; *) basename "$1" ;; esac
}

# orig_dir PKG: the package's directory in go-whim
orig_dir() {
  case $1 in
    abi) echo guest/abi ;;
    board) echo guest/tamago/board ;;
    libsys) echo internal/libsys ;;
    *) echo "$1" ;;
  esac
}

# names SUFFIX NAME...: "NAME1SUFFIX" "NAME2SUFFIX" ...
names() {
  local suffix=$1 s="" n; shift
  for n in "$@"; do s+="${s:+ }\"$n$suffix\""; done
  echo "$s"
}

# bins DIR OUT [LDFLAGS]: go-whim's monitor and TamaGo guests built from the clone DIR
bins() {
  local d=$1 o=$2 extra=${3:-} t a p n
  rm -rf "$o"; mkdir -p "$o"
  for t in linux/amd64 linux/arm64 darwin/arm64; do
    (cd "$d" && env GOOS=${t%/*} GOARCH=${t#*/} CGO_ENABLED=0 \
       go build -trimpath -buildvcs=false ${extra:+-ldflags "$extra"} -o "$o/whim-guest-${t%/*}-${t#*/}" ./vmm/cmd/whim-guest)
  done
  for a in amd64 arm64; do
    for p in . ./faulty; do
      n=editor; [ $p = . ] || n=faulty
      # go-whim's guest build (guest/gotamago.go, tamagoBuild)
      (cd "$d/guest/tamago" && env GOOS=tamago GOARCH=$a GOOSPKG=github.com/usbarmory/tamago GOROOT="$tg" \
         CGO_ENABLED=0 "$tg/bin/go" build -trimpath -buildvcs=false -ldflags "-T 0x201000 -R 0x1000${extra:+ $extra}" \
         -o "$o/guest-$n-$a.elf" $p)
    done
  done
}

check() {
  local status=0 c goos goarch list p r f gocmp=$work/gocmp
  [ -d "$work/renamed/_arbace" ] || { echo "no $work/renamed: bin/box-vendor convert first" >&2; return 1; }
  echo "== print ${out#$root/}/go/arbace/box" >&2
  rm -rf "$work/print"
  "$root/bin/g2a" build --print-only --tests --module arbace --layout lines --work "$work/print" "$out" >&2
  clone "$work/printed"
  rename "$work/printed"
  for p in $whim_pkgs; do
    rm -f "$work/printed/_arbace/box/$p"/*
    cp "$work/print/mod/box/$p"/* "$work/printed/_arbace/box/$p/"
  done
  # purego, vendored since S4 (BX62), which the printed hv and libsys import on darwin
  cp -r "$work/print/mod/box/purego" "$work/printed/_arbace/box/"
  # and at go-whim's own paths: the printed files, their imports renamed back, in a clone of
  # go-whim itself
  clone "$work/printed-orig"
  for p in $whim_pkgs; do
    f=$(orig_dir $p)
    rm -f "$work/printed-orig/$f"/*.go "$work/printed-orig/$f"/*.s
    cp "$work/print/mod/box/$p"/* "$work/printed-orig/$f/"
    sed -i -e "s#\"arbace/box/hv\"#\"$wp/hv\"#" -e "s#\"arbace/box/vmm\"#\"$wp/vmm\"#" \
      -e "s#\"arbace/box/abi\"#\"$wp/guest/abi\"#" -e "s#\"arbace/box/board\"#\"$wp/guest/tamago/board\"#" \
      -e "s#\"arbace/box/libsys\"#\"$wp/internal/libsys\"#" -e "s#\"arbace/box/purego\"#\"$purego_mod\"#" \
      "$work/printed-orig/$f"/*.go
  done
  echo "== the printed packages against the renamed originals (gocmp: tree, export, code; with tests)" >&2
  (cd "$root/tools/gocmp" && env -u GOOS -u GOARCH GOROOT="$tg" "$tg/bin/go" build -o "$gocmp" .)
  for c in $configs; do
    goos=${c%%/*}; goarch=${c#*/}; goarch=${goarch%%:*}; list=${c#*:}
    for p in ${list//,/ }; do
      f=$work/gocmp-$goos-$goarch-$p.log
      if (cd "$work/renamed/_arbace" && env GOOS=$goos GOARCH=$goarch GOROOT="$tg" CGO_ENABLED=0 \
            "$gocmp" -tests "$work/renamed/_arbace/box/$p" "$work/printed/_arbace/box/$p") > "$f" 2>&1; then
        r=pass
      else
        r=FAIL; status=1
      fi
      printf '%-14s %-7s %s  %s\n' "$goos/$goarch" "$p" "$r" "$(tail -1 "$f")"
    done
  done
  echo "== go-whim's binaries from the printed packages, byte for byte (without build IDs or VCS stamps)" >&2
  bins "$work/orig" "$work/bin-orig" -buildid=
  bins "$work/renamed" "$work/bin-renamed" -buildid=
  bins "$work/printed" "$work/bin-printed" -buildid=
  bins "$work/printed-orig" "$work/bin-printed-orig" -buildid=
  for f in "$work/bin-renamed"/*; do
    b=$(basename "$f")
    if cmp -s "$f" "$work/bin-printed/$b"; then r=identical; else r=DIFFERENT; status=1; fi
    if cmp -s "$work/bin-orig/$b" "$work/bin-printed-orig/$b"; then r2=identical; else r2=DIFFERENT; status=1; fi
    printf '%-24s arbace/box: %8d bytes, printed %s; go-whim'"'"'s paths: %8d bytes, printed %s\n' "$b" \
      "$(stat -c %s "$f")" "$r" "$(stat -c %s "$work/bin-orig/$b")" "$r2"
  done
  echo "== go-whim's tests on the printed copy (/dev/kvm)" >&2
  (
    cd "$work/printed"
    export TAMAGO_ROOT=$tg CGO_ENABLED=1
    go test -count=1 -v arbace/box/hv arbace/box/vmm arbace/box/abi 2>&1 | grep -E '^(--- |ok|FAIL|panic)'
    go test -count=1 -v -run 'TestHello|TestFault|TestWatchdog|TestGoGuest|TestGoGuestFault|TestGoGuestSMP|TestReadAheadGo|TestReadAheadC' \
      ./guest/ 2>&1 | grep -E '^(--- |ok|FAIL|panic)'
  ) || status=1
  return $status
}

# go_sum MODULE VERSION: go.sum's two lines for a module in Go's module cache
go_sum() {
  local d
  d=$(env -u GOOS -u GOARCH GOROOT="$tg" "$tg/bin/go" env GOMODCACHE)/cache/download/$1/@v
  [ -f "$d/$2.ziphash" ] || { echo "$1@$2 is not in Go's module cache" >&2; return 1; }
  printf '%s %s %s\n%s %s/go.mod %s\n' "$1" "$2" "$(cat "$d/$2.ziphash")" "$1" "$2" \
    "$(python3 -c 'import sys,hashlib,base64; d=open(sys.argv[1],"rb").read(); print("h1:"+base64.b64encode(hashlib.sha256(("%s  go.mod\n" % hashlib.sha256(d).hexdigest()).encode()).digest()).decode())' "$d/$2.mod")"
}

# print_box DIR: box/ printed with its tests into DIR/mod, a module arbace that builds and
# type-checks every configuration (purego for darwin vendored in it since S4, BX62)
print_box() {
  rm -rf "$1"
  "$root/bin/g2a" build --print-only --tests --module arbace --layout lines --work "$1" "$2" >&2 || return 1
}

# roundtrip: box/ printed, converted back and printed again; the two printings compared (gocmp)
roundtrip() {
  local status=0 c goos goarch list args p f r gocmp=$work/gocmp
  mkdir -p "$work"
  echo "== print ${out#$root/}" >&2
  print_box "$work/rt-print" "$out" || return 1
  rm -rf "$work/rt-forms"
  for c in $rt_configs; do
    goos=${c%%/*}; goarch=${c#*/}; goarch=${goarch%%:*}; list=${c#*:}
    args=(); for p in ${list//,/ }; do args+=("arbace/box/$p"); done
    echo "== convert $goos/$goarch: ${args[*]}" >&2
    (cd "$work/rt-print/mod" && "$root/bin/g2a" convert --tests --goos "$goos" --goarch "$goarch" \
       --out "$work/rt-forms/$goos-$goarch" "${args[@]}") > "$work/rt-convert-$goos-$goarch.log" 2>&1
    if grep -v '^ok' "$root/.tmp/g2a/dumps.tsv" >&2; then
      echo "roundtrip $goos/$goarch: a package did not dump ($work/rt-convert-$goos-$goarch.log)" >&2; return 1
    fi
  done
  rm -rf "$work/rt-box"
  merge_src=$work/rt-print/mod/box merge_forms=$work/rt-forms merge_dst=$work/rt-box/go/arbace/box merge || return 1
  echo "== print the converted forms" >&2
  print_box "$work/rt-print2" "$work/rt-box" || return 1
  (cd "$root/tools/gocmp" && env -u GOOS -u GOARCH GOROOT="$tg" "$tg/bin/go" build -o "$gocmp" .)
  echo "== the printings compared (gocmp: tree, export, code; with tests)" >&2
  for c in $rt_configs; do
    goos=${c%%/*}; goarch=${c#*/}; goarch=${goarch%%:*}; list=${c#*:}
    for p in ${list//,/ }; do
      f=$work/rt-gocmp-$goos-$goarch-${p//\//_}.log
      if (cd "$work/rt-print/mod" && env GOOS=$goos GOARCH=$goarch GOROOT="$tg" CGO_ENABLED=0 \
            "$gocmp" -tests "$work/rt-print/mod/box/$p" "$work/rt-print2/mod/box/$p") > "$f" 2>&1; then
        r=pass
      else
        r=FAIL; status=1
      fi
      printf '%-14s %-16s %s  %s\n' "$goos/$goarch" "$p" "$r" "$(tail -1 "$f")"
    done
  done
  return $status
}

# purego_check: purego's forms (BX62) proved, after purego_convert's WORK/purego exists (the
# renamed originals): 1. each package printed against its renamed original, gocmp (tree, export,
# code) for darwin/arm64; 2. the darwin/arm64 launcher built from box/ printed is byte-identical
# to one built with the renamed originals in place of the printed purego; 3. at purego's own
# path (hv's and libsys' imports renamed back): the launcher built against purego's module (its
# files from Go's module cache) is byte-identical to one built against the printed purego (its
# imports renamed back, its go.mod purego's), each by a replace to the same directory. Builds
# -trimpath -buildvcs=false -ldflags=-buildid=, with DWARF: the printer places each name of a
# parameter list that spans lines on its own line (until 2026-10-12 it linked with -w, the names
# all on the list's first line moving their DWARF declaration lines; doc/go/BOX-NOTES.md, S4)
purego_check() {
  local status=0 p f r gocmp=$work/gocmp pc=$work/purego-check m b
  [ -d "$work/purego/box/purego" ] || purego_renamed "$work/purego" || return 1
  m=$(purego_dir) || return 1
  print_box "$work/purego-print" "$out" || return 1
  (cd "$root/tools/gocmp" && env -u GOOS -u GOARCH GOROOT="$tg" "$tg/bin/go" build -o "$gocmp" .)
  echo "== 1. purego printed against its renamed original (gocmp: tree, export, code; darwin/arm64)" >&2
  for p in $purego_pkgs; do
    f=$work/purego-gocmp-${p//\//_}.log
    if (cd "$work/purego" && env GOOS=darwin GOARCH=arm64 GOROOT="$tg" CGO_ENABLED=0 \
          "$gocmp" "$work/purego/box/$p" "$work/purego-print/mod/box/$p") > "$f" 2>&1; then
      r=pass
    else
      r=FAIL; status=1
    fi
    printf '%-14s %-26s %s  %s\n' darwin/arm64 "$p" "$r" "$(tail -1 "$f")"
  done
  launcher() { # MODULE-DIR OUT
    (cd "$1" && env GOOS=darwin GOARCH=arm64 GOARM64=v8.0 CGO_ENABLED=0 GOROOT="$tg" GOTOOLCHAIN=local GOFLAGS= \
       GOWORK=off GOPROXY=off "$tg/bin/go" build -trimpath -buildvcs=false -ldflags=-buildid= -o "$2" ./box/cmd/arbace-box)
  }
  rm -rf "$pc"; mkdir -p "$pc"
  echo "== 2. the darwin/arm64 launcher: printed purego, renamed originals" >&2
  launcher "$work/purego-print/mod" "$pc/printed" || return 1
  cp -r "$work/purego-print/mod" "$pc/renamed-mod"
  rm -rf "$pc/renamed-mod/box/purego"; cp -r "$work/purego/box/purego" "$pc/renamed-mod/box/purego"
  launcher "$pc/renamed-mod" "$pc/renamed" || return 1
  if cmp -s "$pc/printed" "$pc/renamed"; then r=identical; else r=DIFFERENT; status=1; fi
  printf 'arbace-box darwin/arm64, arbace/box/purego: %d bytes, printed %s\n' "$(stat -c %s "$pc/renamed")" "$r"
  echo "== 3. at purego's path: its module's files and the printed ones, by a replace (one directory)" >&2
  cp -r "$work/purego-print/mod" "$pc/at-mod"
  rm -rf "$pc/at-mod/box/purego"
  sed -i "s#\"arbace/box/purego\"#\"$purego_mod\"#" "$pc/at-mod/box/hv/hvf_darwin.go" "$pc/at-mod/box/libsys/libsys.go"
  printf '\nrequire %s %s\n\nreplace %s %s => %s\n' "$purego_mod" "$purego_ver" "$purego_mod" "$purego_ver" "$pc/purego-at" \
    >> "$pc/at-mod/go.mod"
  # the module's own files (Go's module cache), then the printed ones, at the same directory
  rm -rf "$pc/purego-at"; cp -r "$m" "$pc/purego-at"; chmod -R u+w "$pc/purego-at"
  launcher "$pc/at-mod" "$pc/at-module" || return 1
  rm -rf "$pc/purego-at"; cp -r "$work/purego-print/mod/box/purego" "$pc/purego-at"
  find "$pc/purego-at" -name '*.go' -print0 | xargs -0 sed -i "s#\"arbace/box/purego#\"$purego_mod#"
  cp "$m/go.mod" "$pc/purego-at/go.mod"
  launcher "$pc/at-mod" "$pc/at-printed" || return 1
  if cmp -s "$pc/at-module" "$pc/at-printed"; then r=identical; else r=DIFFERENT; status=1; fi
  printf 'arbace-box darwin/arm64, %s %s: %d bytes, printed %s\n' "$purego_mod" "$purego_ver" "$(stat -c %s "$pc/at-module")" "$r"
  return $status
}

# kvm_tests: go-whim's tests on box/ (printed) in a renamed clone of go-whim, on /dev/kvm
kvm_tests() {
  local p d=$work/kvm arm64=${1:-}
  mkdir -p "$work"
  echo "== print ${out#$root/}" >&2
  print_box "$work/kvm-print" "$out" || return 1
  clone "$d"
  rename "$d"
  for p in $whim_pkgs; do
    [ -d "$work/kvm-print/mod/box/$p" ] || continue
    mkdir -p "$d/_arbace/box/$p"
    rm -f "$d/_arbace/box/$p"/*
    cp "$work/kvm-print/mod/box/$p"/* "$d/_arbace/box/$p/"
  done
  # vmm.Run recovers an exit panic by its ExitCode method (S1): go-whim's editor.Exit, which
  # its tests' recording hosts panic with (they serve editor.Main too), given it
  printf '\n// ExitCode is the code, for arbace/box/vmm.Run (bin/box-vendor kvm-tests).\nfunc (e Exit) ExitCode() int { return int(e) }\n' \
    >> "$d/editor/host.go"
  if [ -n "$arm64" ]; then
    mkdir -p "$arm64"
    echo "== go-whim's hv and vmm tests on box/, compiled for linux/arm64 into $arm64" >&2
    (cd "$d" && for p in hv vmm; do
       GOOS=linux GOARCH=arm64 CGO_ENABLED=0 go test -c -o "$arm64/$p.test" arbace/box/$p || exit 1
     done)
    return
  fi
  echo "== go-whim's tests on box/ (/dev/kvm)" >&2
  (
    cd "$d"
    export TAMAGO_ROOT=$tg CGO_ENABLED=1
    s=0
    go test -count=1 -v arbace/box/hv arbace/box/vmm arbace/box/abi > "$work/kvm-box.log" 2>&1 || s=1
    grep -E '^(--- |ok|FAIL|panic)' "$work/kvm-box.log"
    go test -count=1 -v -run 'TestHello|TestFault|TestWatchdog|TestGoGuest|TestGoGuestFault|TestGoGuestSMP|TestReadAheadGo|TestReadAheadC' \
      ./guest/ > "$work/kvm-guest.log" 2>&1 || s=1
    grep -E '^(--- |ok|FAIL|panic)' "$work/kvm-guest.log"
    exit $s
  )
}

case $cmd in
  convert) convert ;;
  check) check ;;
  all) convert && check ;;
  roundtrip) roundtrip ;;
  kvm-tests) kvm_tests ;;
  purego) purego_convert ;;
  purego-check) purego_check ;;
  kvm-tests-arm64) [ $# -ge 2 ] || { echo "box-vendor: kvm-tests-arm64 DIR" >&2; exit 2; }
    kvm_tests "$(mkdir -p "$2" && cd "$2" && pwd)" ;;
  *) sed -n '2,/^set -/p' "$0" | sed '$d; s/^# \{0,1\}//' >&2; exit 2 ;;
esac

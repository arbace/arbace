#!/bin/bash
# The browser side of the WebAssembly crop (doc/wasm/WEB.md; doc/wasm/WASM-SURVEY.md §9, WAS15 (a), WA12): the shim's page written
# out, and a development server. Nothing here runs a browser, and no check runs `serve` (the network is the person's).
#
#   bin/wasm build DIR [MODULE]   write the page into DIR: wasm/web/index.html, wasm/web/arbace.js and MODULE as arbace.wasm
#                                 (default: the demo scene, built for js/wasm by bin/wai's harness); a file writer only
#   bin/wasm serve DIR [PORT]     serve DIR on http://127.0.0.1:PORT/ (default 8080) with .wasm as application/wasm: the tool
#                                 wasm/serve built by TamaGo's go into .tmp/wasm-serve; run by hand, never by a check
#   bin/wasm check                the shim's checks (bin/wai shim-check)
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash"
goroot=${ARBACE_GOROOT:-/root/tamago-go}
case ${1:-} in
  build)
    [ -n "${2:-}" ] || { echo "bin/wasm build DIR [MODULE]" >&2; exit 2; }
    mkdir -p "$2"
    cp "$root/wasm/web/index.html" "$root/wasm/web/arbace.js" "$2/"
    if [ -n "${3:-}" ]; then
      cp "$3" "$2/arbace.wasm"
    else
      mod=$("$root/bin/wai" scene-build | tail -1)
      cp "$mod" "$2/arbace.wasm"
    fi
    echo "bin/wasm: wrote $2/index.html, arbace.js, arbace.wasm ($(wc -c < "$2/arbace.wasm") bytes)" ;;
  serve)
    [ -n "${2:-}" ] || { echo "bin/wasm serve DIR [PORT]" >&2; exit 2; }
    exe=$root/.tmp/wasm-serve/serve
    if [ ! -x "$exe" ] || [ "$root/wasm/serve/main.go" -nt "$exe" ]; then
      mkdir -p "$root/.tmp/wasm-serve"
      (cd "$root/wasm/serve" && GOROOT="$goroot" GOTOOLCHAIN=local GOFLAGS= GO111MODULE=off GOPROXY=off CGO_ENABLED=0 \
        GOCACHE="$root/.tmp/wasm-serve/gocache" "$goroot/bin/go" build -o "$exe" main.go)
    fi
    exec "$exe" "$2" "${3:-8080}" ;;
  check) exec "$root/bin/wai" shim-check ;;
  *) sed -n '2,12p' "$0" >&2; exit 2 ;;
esac

#!/bin/bash
# Coverage subsets of the checks' corpora (doc/GATE-SURVEY.md, GT8.3; GTS205 (a), the subset rule; GTS206 (a), the
# cover build): Go's coverage of Arbace's executables, the crops' code under check (bin/lib/cover.bash), per test.
#
#   bin/cover build      the cover build (bin/arbace-go --gate-build --cover): the gate's executable and test build
#                        with -cover, kept in ARBACE_GATE_EXES/cover-KEY20; run it under the heavy lock
#   bin/cover exe [NAME] the cover build's executable at the checkout's key (arbace, arbace-tests)
#   ARBACE_COVER_DIR=RUN CHECK...
#                        a check run with coverage: bin/java-check (the interp and compiled levels; --essential,
#                        --essential-compiled) and bin/goi check run the cover build (the compiled level its programs
#                        built with the same flags), each test with its GOCOVERDIR, RUN/TOOL/ID (TOOL java-interp,
#                        java-compiled, goi); bin/ci check (TOOL ci: the node programs on the cover build; with
#                        CI_COVER_READ=1 also ci-read: each program read, checked and built by a process of its own on
#                        it), bin/ci check --aot (ci-aot: the shards built with -cover of arbace/ci and arbace/crt),
#                        bin/clojure-tests (clojure: the eval level on the cover build's arbace-tests; --aot,
#                        clojure-aot: the compiled suite's program built with the cover flags), a namespace a test;
#                        RUN/key the cover build's key, a run of another build into RUN refused and bin/cover blocks
#                        refusing a RUN of another build than ARBACE_COVER_CACHE's (review 182 L5)
#   bin/cover blocks RUN [--tool TOOL,...] [--crop CROP] [--pkgs ERE] [-o OUT]
#                        each test's covered blocks of a crop's code under check (tools/covsubset blocks): for each
#                        TOOL of RUN (default all) OUT/TOOL (default RUN/blocks/TOOL): tests.tsv (ID, its blocks,
#                        their count), blocks/N.txt, files.tsv (each source file's blocks and the covered share),
#                        summary.tsv (tests-without-counters: runs that wrote none, a SIGKILL before the first flush
#                        or a Go panic's exit). The crop: --crop, else the tool's (java-* java, goi go, ci c,
#                        clojure clojure); the files of cover_exclude (j2g's user classes in arbace/lang) left out;
#                        --pkgs: only the crop's packages ERE matches (a level's part of its crop: C's run level
#                        '^arbace/(ci|crt|cinterp|aot_arbace_c_(cinterp|repl))$', its read level
#                        '^arbace/aot_arbace_(repr_c|c_check|c_build|c_musl)')
#   bin/cover classes DIVERGENCES RESULTS [--level L] [--controls FILE] -o OUT
#                        each test's class (the subset's --classes and --keep): RESULTS a check's rows, ID [LEVEL]
#                        RESULT REASON tab-separated (bin/goi check's results.tsv, bin/java-check's), a non-pass
#                        classed by the first class of DIVERGENCES (several files comma-separated, read in order as the
#                        level's judge reads them: C's AOT levels test/c/divergences-aot.edn,test/c/divergences.edn;
#                        a non-pass in no class warned on the standard error; review 195) (test/goi/divergences.edn's format: :tests, or a
#                        :match finding "RESULT REASON"; :level when L is given) as the judges do: OUT.classes
#                        (ID<TAB>CLASS), OUT.keep (the tests of a class whose :kind is one whose work remains,
#                        test/cover/classes.ae's keep-kinds, and the controls' subjects and references: test/java/controls.edn's :subject and :reference, or
#                        test/goi/controls.txt's LEVEL ID SUBJECT REFERENCE lines, LEVEL interp, or --control-level)
#   bin/cover clojure-classes RESULTS -o OUT [--aot]
#                        Clojure's suite's classes per test namespace (test/cover/clojure_rows.ae): RESULTS the
#                        suite's results (test/arbace-go-results.edn; --aot test/arbace-go-aot-results.edn), each
#                        namespace's cases as bin/reap judges them against upstream's, classed by the level's files
#                        (test/clojure/divergences-read.edn and divergences.edn; --aot divergences-aot.edn); a
#                        namespace of several classes classed by their set (A+B); OUT.classes, OUT.keep (the kept
#                        kinds' namespaces and test/clojure/controls.edn's), OUT.cases
#   bin/cover subset OUT [--keep FILE] [--classes FILE] [--times FILE] [--seeds N] [--corpus C]
#                        the subset of a tool's tests by GTS205 (a) (tools/covsubset reduce, queue 160's and 161's
#                        reducer): the tests of --keep (one id a line: the controls' subjects and references, the
#                        deferred and gap classes' tests) first, then one test per class (--classes: ID<TAB>CLASS,
#                        a test of a class not kept), then by greedy set cover every covered block; --times
#                        (ID<TAB>SECONDS) breaks ties; --corpus C: only the ids C/... of tests.tsv, --classes
#                        and --keep (a corpus's subset from a whole record's classes, review 195's medium 2).
#                        Writes OUT/index.tsv, OUT/subset.txt, OUT/curve.tsv,
#                        OUT/reduce.tsv
#
# Environment: ARBACE_GOROOT (TamaGo's go, default /root/tamago-go; its `go tool covdata` reads the profiles),
# ARBACE_COVER_CACHE (another cover build), COVER_JOBS (textfmt runs at once, default 8).
set -uo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash"
. "$root/bin/lib/gate-cache.bash"
. "$root/bin/lib/cover.bash"
goroot=${ARBACE_GOROOT:-/root/tamago-go}
discard=$TMPDIR/cover.discard

# the tool, built by TamaGo's go into .tmp/cover-tool when its sources changed (as gate-run.bash's gateaudit)
tool() {
  local d=$root/.tmp/cover-tool k
  mkdir -p "$d"
  k=$(cat "$root"/tools/covsubset/*.go "$root/tools/covsubset/go.mod" "$goroot/VERSION" | sha256sum | cut -c1-64)
  if [ "$(cat "$d/covsubset.key" 2>"$discard")" != "$k" ] || [ ! -x "$d/covsubset" ]; then
    (cd "$root/tools/covsubset" && env -u GOOS -u GOARCH GOROOT="$goroot" GOFLAGS= GOTOOLCHAIN=local CGO_ENABLED=0 \
       "$goroot/bin/go" build -trimpath -buildvcs=false -o "$d/covsubset.new" .) > "$d/build.log" 2>&1 \
      && mv -f "$d/covsubset.new" "$d/covsubset" && echo "$k" > "$d/covsubset.key" \
      || { cat "$d/build.log" >&2; echo "cover: tools/covsubset did not build" >&2; return 1; }
  fi
  echo "$d/covsubset"
}

crop_of() {
  case $1 in java-*) echo java ;; goi*) echo go ;; ci*|c-*) echo c ;; clojure*) echo clojure ;; *) echo "cover: no crop for tool $1 (--crop)" >&2; return 1 ;; esac
}

blocks() {
  local run=${1:?bin/cover blocks RUN} tools="" crop="" out="" pre="" t c cache pk ex
  shift
  while [ $# -gt 0 ]; do
    case $1 in
      --tool) tools=${2//,/ }; shift 2 ;;
      --crop) crop=$2; shift 2 ;;
      --pkgs) pre=$2; shift 2 ;;
      -o) out=$2; shift 2 ;;
      *) echo "cover blocks: unknown option $1" >&2; return 2 ;;
    esac
  done
  [ -d "$run" ] || { echo "cover blocks: no run $run" >&2; return 1; }
  [ -n "$tools" ] || tools=$(cd "$run" && for t in *; do [ -d "$t" ] && [ "$t" != meta ] && [ "$t" != blocks ] && echo "$t"; done)
  cache=$(cover_cache "$root") || return 1
  # the run's build (RUN/key, cover_claim) is the one whose packages are read (review 182 L5)
  if [ ! -f "$run/key" ]; then
    echo "cover blocks: $run names no cover build (RUN/key, written since review 182 L5): read with $cache's packages, not compared" >&2
  elif [ "$(cat "$run/key")" != "$(cat "$cache/key" 2>"$discard")" ]; then
    echo "cover blocks: $run holds the data of cover build $(cut -c1-12 "$run/key"), not of $cache ($(cut -c1-12 "$cache/key" 2>"$discard")): ARBACE_COVER_CACHE naming the run's build" >&2
    return 1
  fi
  ex=$(tool) || return 1
  for t in $tools; do
    c=${crop:-$(crop_of "$t")} || return 1
    pk=${out:-$run/blocks}/$t.pkgs
    mkdir -p "${out:-$run/blocks}/$t"
    # the crop's packages of the cover builds (the executable's and the test build's)
    cat "$cache"/pkgs-*.txt 2>"$discard" | LC_ALL=C sort -u | grep -E "$(cover_pkg_re "$c")" | grep -E "${pre:-.}" > "$pk" \
      || { echo "cover blocks: no package of crop $c in $cache/pkgs-*.txt" >&2; return 1; }
    echo "== $t ($c: $(wc -l < "$pk") packages)"
    find "$run/$t" -mindepth 1 -maxdepth 1 -type d | LC_ALL=C sort > "${out:-$run/blocks}/$t.dirs"
    # the directories as a list, one run of the tool (xargs split a corpus's 3,321 into two runs, the second's
    # tests.tsv, 131 tests, overwriting the first's: night 3's java-interp)
    [ -s "${out:-$run/blocks}/$t.dirs" ] || { echo "cover blocks: $run/$t holds no test's directory" >&2; continue; }
    "$ex" blocks -go "$goroot/bin/go" -pkgs "$pk" -exclude "$(cover_exclude "$c")" -o "${out:-$run/blocks}/$t" -j "${COVER_JOBS:-8}" -dirs "${out:-$run/blocks}/$t.dirs" \
      || echo "cover blocks: $t: some profiles were not read (above)" >&2
  done
}

subset() {
  local o=${1:?bin/cover subset OUT} keep="" classes="" times="" seeds=20 corpus="" ex
  shift
  while [ $# -gt 0 ]; do
    case $1 in
      --keep) keep=$2; shift 2 ;;
      --classes) classes=$2; shift 2 ;;
      --times) times=$2; shift 2 ;;
      --seeds) seeds=$2; shift 2 ;;
      --corpus) corpus=$2; shift 2 ;;
      *) echo "cover subset: unknown option $1" >&2; return 2 ;;
    esac
  done
  [ -f "$o/tests.tsv" ] || { echo "cover subset: no $o/tests.tsv (bin/cover blocks)" >&2; return 1; }
  ex=$(tool) || return 1
  # the index: ID PROFILE KEEP SECONDS CLASS (tools/cicover's, queue 160; removed with bin/ci cover, GT8.3)
  # --corpus C: an id outside C/ is no id of this subset, in tests.tsv, --classes and --keep alike
  awk -F'\t' -v keep="${keep:-/nonexistent}" -v cls="${classes:-/nonexistent}" -v tm="${times:-/nonexistent}" -v cp="${corpus:+$corpus/}" '
    function mine(i) { return cp == "" || substr(i, 1, length(cp)) == cp }
    BEGIN { while ((getline l < keep) > 0) if (l != "" && mine(l)) k[l] = 1
            while ((getline l < cls) > 0) { split(l, a, "\t"); if (a[2] != "" && mine(a[1])) c[a[1]] = a[2] }
            while ((getline l < tm) > 0) { split(l, a, "\t"); t[a[1]] = a[2] } }
    !mine($1) { next }
    { seen[$1] = 1; print $1 "\t" $2 "\t" (($1 in k) ? 1 : 0) "\t" (($1 in t) ? t[$1] : 0) "\t" (($1 in c) ? c[$1] : "-") }
    # a test of --classes or --keep that wrote no counters (not run: a program refused before its run, by design) is
    # still the subset'"'"'s, its profile - (tools/cicover'"'"'s index: every judged program, a kept one costs no run)
    END { for (i in c) if (!(i in seen)) { seen[i] = 1; print i "\t-\t" ((i in k) ? 1 : 0) "\t" ((i in t) ? t[i] : 0) "\t" c[i] }
          for (i in k) if (!(i in seen)) print i "\t-\t1\t" ((i in t) ? t[i] : 0) "\t-" }' "$o/tests.tsv" | LC_ALL=C sort > "$o/index.tsv"
  "$ex" reduce -seeds "$seeds" -o "$o/subset.txt" -curve "$o/curve.tsv" "$o/index.tsv" | tee "$o/reduce.tsv"
}

classes() {
  local div=${1:?} res=${2:?} level="" controls="" clevel=interp o="" exe
  shift 2
  while [ $# -gt 0 ]; do
    case $1 in
      --level) level=$2; shift 2 ;;
      --controls) controls=$2; shift 2 ;;
      --control-level) clevel=$2; shift 2 ;;
      -o) o=$2; shift 2 ;;
      *) echo "cover classes: unknown option $1" >&2; return 2 ;;
    esac
  done
  [ -n "$o" ] || { echo "cover classes: -o OUT" >&2; return 2; }
  exe=$(. "$root/bin/lib/host.bash" && arbace_host_exe) || return 1
  "$exe" "$root/test/cover/classes.ae" "$div" "$res" "$level" "$controls" "$o" "$clevel"
}

case ${1:-} in
  classes) shift; classes "$@" ;;
  clojure-classes)
    shift; res=${1:?bin/cover clojure-classes RESULTS -o OUT [--aot]}; shift; o="" divs="test/clojure/divergences-read.edn test/clojure/divergences.edn"
    while [ $# -gt 0 ]; do case $1 in -o) o=$2; shift 2 ;; --aot) divs=test/clojure/divergences-aot.edn; shift ;; *) echo "cover clojure-classes: unknown option $1" >&2; exit 2 ;; esac; done
    [ -n "$o" ] || { echo "cover clojure-classes: -o OUT" >&2; exit 2; }
    res=$(realpath "$res"); o=$(realpath -m "$o")
    exe=$(. "$root/bin/lib/host.bash" && arbace_host_exe) || exit 1
    # shellcheck disable=SC2086
    cd "$root" && ARBACE_PATH=$root:$root/test "$exe" test/cover/clojure_rows.ae "$res" test/baseline-results.edn test/clojure/controls.edn "$o" $divs ;;
  build) shift; exec "$root/bin/arbace-go" --gate-build --cover "$@" ;;
  exe) cover_exe "$root" "${2:-arbace}" ;;
  blocks) shift; blocks "$@" ;;
  subset) shift; subset "$@" ;;
  *) sed -n '2,/^set -/p' "$0" | sed '$d; s/^# \{0,1\}//' >&2; exit 2 ;;
esac

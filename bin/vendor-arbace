#!/bin/bash
# Derive the vendored Clojure under arbace/ from the frozen clojure/ (agenda step 4), as it was
# done once on 2026-10-07 (doc/VENDOR-NOTES.md). The result has been committed as arbace/ and is
# maintained by hand since: this script writes only under OUT (default .tmp/vendor/), to
# reproduce or audit that derivation (diff -r OUT/tree/arbace arbace, ignoring the tools'
# directories classes/, j2c/, javalisp/).
#   1. bin/j2c ... convert --rename clojure=arbace OUT/converted . clojure
#      the 183 Java files of clojure/ as class forms, class and namespace names renamed;
#   2. arbace.j2c.rename vendor: the converted files with their string literals renamed and the
#      Java files' notices as headers, plus clojure/**/*.clj renamed, with two hand edits
#      (version.properties folded into arbace/core.clj, the arbace.server.* properties), into
#      OUT/tree (arbace.clj and arbace/);
#   3. check: the Java of clojure/ renamed by the same arbace.j2c.rename, compiled by javac, has
#      the same class shapes (doc/classes/SPEC.md §3) as OUT/tree's class forms compiled at
#      stage 0.
# Usage: bin/vendor-arbace [OUT]
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"
out=${1:-.tmp/vendor}
rm -rf "$out"
mkdir -p "$out"

echo "== 1. convert clojure/ with --rename clojure=arbace"
bin/j2c -m arbace.j2c.main convert --rename clojure=arbace "$out/converted" . clojure | grep -v '^slowest'

echo "== 2. rename strings and the .clj sources into $out/tree"
java -cp . clojure.main -m arbace.j2c.rename vendor "$out/converted" . "$out/tree"

echo "== 3. compare with javac's classes of the renamed Java"
(cd clojure && find . -name '*.java') | while read -r f; do
  mkdir -p "$out/java/arbace/$(dirname "$f")"
  cp "clojure/$f" "$out/java/arbace/$f"
done
java -cp . clojure.main -m arbace.j2c.rename tree "$out/java" .java
sed -i 's/^package clojure;/package arbace;/' "$out/java/arbace/main.java"
# shellcheck disable=SC2046
javac -g -nowarn -d "$out/javac" $(find "$out/java" -name '*.java') 2>&1 | grep -v '^Note:' || true
java -Xss64m -Xmx8g -cp "$out/tree:." clojure.main -e "
(require 'arbace.classes.boot)
(let [{:keys [failed]} (arbace.classes.build/build! \"$out/tree\" \"$out/classes\"
                         [\"arbace\" \"arbace/lang\" \"arbace/asm\" \"arbace/asm/commons\"
                          \"arbace/asm/signature\" \"arbace/java/api\"])
      ds (arbace.classes.shape/diff-dirs \"$out/javac\" \"$out/classes\")]
  (doseq [f failed] (println \"ERROR\" f))
  (doseq [[p d] (take 20 ds)] (println p (pr-str (take 3 d))))
  (println (count (filter #(.endsWith (str %) \".class\") (file-seq (java.io.File. \"$out/javac\"))))
           \"classes of javac,\" (count ds) \"differ from the class forms' classes\")
  (shutdown-agents)
  (System/exit (if (or (seq failed) (seq ds)) 1 0)))"

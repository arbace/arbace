#!/bin/bash
# wai, Arbace's WebAssembly engine (doc/wasm/WAI.md; doc/wasm/WASM-SURVEY.md §6, §10.1, WAS6 (a), WAS7 (a), WA4): go/arbace/wai (Go
# forms, a crop path: out of every key) and its light driver test/wasm/wai-driver, printed by repr/go and built alone by TamaGo's go
# (as x86i's and a64i's: no Arbace build); the testsuite's scripts planned by arbace.wasm.check on the tools' host (repr/wasm reads
# them; each module written as its binary) and run by the driver, each command judged by its own assertion (WAS8 (a)). No Wasm tool
# runs (wabt, wasmtime and node are the oracle tier's).
#
#   bin/wai light                         build the light driver into .tmp/wai/wai (kept by its sources' digest)
#   bin/wai check [--record] [--only LIST]  the testsuite's scripts, the root's then proposals/, legacy/ and custom/'s (a non-pass's
#                                         reason beyond the root prefixed by its proposal, as bin/repr-wasm wast's) (test/wasm/corpora.edn's
#                                         :testsuite; --only LIST: a path under
#                                         the testsuite a line) planned and run: module (decoded, linked, instantiated), assert_return
#                                         (the results by the spec's patterns: nan:canonical, nan:arithmetic, the references' kinds,
#                                         either), assert_trap (trapped; its message a second level, msg/ rows, by prefix),
#                                         assert_exhaustion, assert_exception, assert_unlinkable, assert_uninstantiable, register,
#                                         get, invoke across modules; rows against test/wasm/eval-results.edn (--record rewrites the
#                                         run's scripts' rows), every non-pass in a class of test/wasm/divergences-eval.edn, the
#                                         negative controls of test/wasm/controls-eval.txt failing; WORK .tmp/wai/check
#   bin/wai essential                     check --only test/wasm/essential-eval.txt
#                                         every module the planner writes and every assert_invalid's module also validated by wai's
#                                         own validator (WAS30 (a)), its verdict against arbace.wasm.valid's: valid/ rows, beside
#   bin/wai go [--record] [--essential] [--list FILE]
#                                         the Go run corpus (WAS11 (a), WA5; doc/wasm/WAI.md §8, bin/lib/wai/go-run.bash): $GOROOT/test's
#                                         run programs (goi's record's run actions) and test/wasm/go-run.txt's own programs, built for
#                                         wasip1/wasm by TamaGo's go, run by the driver under WASI preview 1, judged against gc's run
#                                         (goi's references) and want.out; rows against test/wasm/go-results.edn, classes
#                                         test/wasm/divergences-go.edn, controls test/wasm/controls-go.txt; --essential:
#                                         test/wasm/essential-go.txt's (the own programs and a sample of goi's essential run programs)
#   bin/wai run [WAIDRIVER-RUN-ARGS...]   one WASI program run by the light driver (waidriver run: --dir GUEST=HOST[:ro], --env K=V,
#                                         --seed N, MODULE ARG...)
#   bin/wai gojs [WAIDRIVER-GOJS-ARGS...]  one GOOS=js program on the headless world (waidriver gojs: --dir GUEST=HOST[:ro],
#                                         --env K=V, --cwd DIR, --seed N, --frames N, --input FILE, --record FRAMES.EDN, MODULE ARG...)
#   bin/wai js [--record] [--essential] [--list FILE]
#                                         WA11, WA12 (doc/wasm/WAI.md §10, doc/wasm/WEB.md, bin/lib/wai/js-run.bash): Go's js/wasm programs
#                                         built by TamaGo's go and run on gojs's headless world, each by its own statement: syscall/js's
#                                         tests, test/wasm/js-run.txt's own programs (want.out), the demo scene's frames
#                                         (test/wasm/js/scene/expected/), the shim's checks; rows against test/wasm/js-results.edn,
#                                         classes test/wasm/divergences-js.edn, controls test/wasm/controls-js.txt
#   bin/wai shim-check                    the shim's gojs import names against Go's, wasm_exec.js's and the world's, its WebGPU
#                                         operation table against the world's (WAS15 (a))
#   bin/wai divergences [RESULTS]         the record's non-passes judged against the classes
#   bin/wai check --aot [--record] [--only LIST]
#                                         WA7 (doc/wasm/WAI.md §9, bin/lib/wai/aot.bash): the same plans, every module translated by w2g
#                                         and the scripts run by AOT programs (the light driver built by TamaGo's go with the modules'
#                                         functions compiled, WAI_AOT_BATCH scripts a program), judged by the same assertions; a command
#                                         that called a function the interpreter ran fails ("w2g: ..."); rows against
#                                         test/wasm/aot-results.edn, classes test/wasm/divergences-aot.edn, controls test/wasm/controls-aot.txt
#   bin/wai aot-essential                 check --aot --only test/wasm/essential-aot.txt
#   bin/wai go --aot --vs-eval [--list FILE]  WAS40 (a)'s rotation: the list's programs (default the whole corpus) at AOT judged
#                                         against eval's record (test/wasm/go-results.edn), program for program
#   bin/wai go --aot [--record] [--list FILE]
#                                         the Go programs of test/wasm/go-aot.txt as AOT programs, judged as bin/wai go judges them; rows
#                                         against test/wasm/go-aot-results.edn. Since WAS50 (a) the programs are built and their modules
#                                         collected first, then translated by shape (w2g --shared: each shape of their functions once, the
#                                         runtime and libraries shared) into one AOT program kept by key in the main checkout's
#                                         .tmp/wai-go/aot-shared, which runs them all (WAI_GO_JOBS, default 2); WAI_AOT_SHARED=0: WA7's
#                                         program a module (.tmp/wai-go/aot)
#   bin/wai w2g gen DIR|check             w2g's instruction bodies (wai/w2gcases.go) and wai's exports (wai/w2gexports.go) generated from
#                                         the interpreter's exec.go; check compares them with the committed ones, entry by entry
#   bin/wai ops gen|check                 go/arbace/wai's instruction table (optab.go) from repr/wasm's arbace/repr/wasm/ops.ae
#                                         (test/wasm/gen_wai_ops.awk, gofmt'd: gen prints it, to be converted by repr/go's native
#                                         reader with the package); check compares the driver's table (waidriver ops) with ops.ae
#
# WAI_EXE names another build of the driver (e.g. one built from a module copy). Memory: the planner under GOMEMLIMIT (default
# 1500MiB), the driver under WAI_GOMEMLIMIT (default 1500MiB), one script at a time.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash"
. "$root/bin/lib/tools.bash"
export GOMAXPROCS=${GOMAXPROCS:-4} GOMEMLIMIT=${GOMEMLIMIT:-1500MiB}
main=$(cd "$(git -C "$root" rev-parse --git-common-dir)/.." && pwd)
case $root in */.tmp/gate-clean/*) main=${root%%/.tmp/gate-clean/*} ;; esac
tree=${REPR_WASM_TREE:-$main/.tmp/wasm/tree}
corpora=$root/test/wasm/corpora.edn
goroot=${ARBACE_GOROOT:-/root/tamago-go}
results=$root/test/wasm/eval-results.edn
classes=$root/test/wasm/divergences-eval.edn
controls=$root/test/wasm/controls-eval.txt
wai_dir=$root/.tmp/wai
wai_exe=${WAI_EXE:-$wai_dir/wai}
aot_results=$root/test/wasm/aot-results.edn
aot_classes=$root/test/wasm/divergences-aot.edn
aot_controls=$root/test/wasm/controls-aot.txt

edn() { arbace_tool -e "(let [c (read-string (slurp \"$corpora\"))] $1)"; }

srcs_key() {
  { (cd "$root" && find go/arbace/wai.ae go/arbace/wai test/wasm/wai-driver -type f | LC_ALL=C sort | xargs sha256sum)
    head -1 "$goroot/VERSION"; } | sha256sum | cut -c1-64
}

# the light driver: go/arbace/wai and test/wasm/wai-driver printed by repr/go (bin/build-go --print-only), built by TamaGo's go
light() {
  [ -z "${WAI_EXE:-}" ] || return 0
  local key out=$wai_dir/print src=$wai_dir/print-root
  key=$(srcs_key)
  if [ -x "$wai_exe" ] && [ "$(cat "$wai_dir/key" 2>"$TMPDIR/wai-key.err")" = "$key" ]; then return 0; fi
  rm -rf "$out" "$src"; mkdir -p "$src/go/arbace"
  ln -s "$root/go/arbace/wai.ae" "$root/go/arbace/wai" "$root/test/wasm/wai-driver/go/arbace/waidriver.ae" \
    "$root/test/wasm/wai-driver/go/arbace/waidriver" "$src/go/arbace/"
  "$root/bin/build-go" --print-only --module arbace --work "$out" "$src" >&2
  (cd "$out/mod" && export GOROOT="$goroot" GOTOOLCHAIN=local GOFLAGS= GOWORK=off GO111MODULE=on GOPROXY=off CGO_ENABLED=0 \
     GOCACHE="${WAI_GOCACHE:-$wai_dir/gocache}" GOMAXPROCS=${GOMAXPROCS:-4} &&
     "$goroot/bin/go" build -p 2 -trimpath -o "$wai_exe" ./waidriver/)
  echo "$key" > "$wai_dir/key"
}

judge() { # RESULTS ROWS CLASSES RECORD IDS [KIND]
  local kind=${6:-eval} label="wai check"
  case $kind in go) label="wai go" ;; js) label="wai js" ;; go-aot) label="wai go --aot" ;; aot) label="wai check --aot" ;; esac
  arbace_tool -e "(do (load-file \"$root/test/wasm/judge.ae\") nil)" \
    -e "(wasm.judge/main \"$label\" \"$kind\" \"$1\" \"$2\" \"$3\" \"${4:-}\" \"${5:-}\")"
}

check() {
  local record=$1 only=$2 ts work lst fails=0 res=$results cls=$classes ctl=$controls kind=eval label="wai check" ids="testsuite msg valid"
  if [ -n "${aot:-}" ]; then res=$aot_results cls=$aot_classes ctl=$aot_controls kind=aot label="wai check --aot" ids="testsuite msg"; fi
  ts=$tree/$(edn '(println (:top (:testsuite (:pins c))))')
  [ -d "$ts" ] || { echo "wai: $ts missing: bin/repr-wasm corpus fetch" >&2; return 1; }
  work=$wai_dir/check${aot:+-aot}; rm -rf "$work"; mkdir -p "$work"
  lst=$work/scripts.list
  if [ -n "$only" ]; then
    grep -v '^#' "$only" | sed '/^$/d' | while read -r f; do printf 'testsuite/%s\t%s\n' "$f" "$ts/$f"; done > "$lst"
  else
    # the root scripts (Wasm 3.0's), then proposals/, legacy/ and custom/ (classed by proposal, WAS4 (a), WAS5 (a)), as bin/repr-wasm wast
    { (cd "$ts" && ls *.wast); (cd "$ts" && find proposals legacy custom -name '*.wast' | LC_ALL=C sort); } |
      while read -r f; do printf 'testsuite/%s\t%s\n' "$f" "$ts/$f"; done > "$lst"
  fi
  light
  echo "wai check: planning $(wc -l < "$lst") scripts"
  arbace_tool -m arbace.wasm.check plan "$lst" "$work"
  if [ -n "${aot:-}" ]; then
    # WA7: the scripts' modules translated by w2g and run as AOT programs; the validator's rows are eval's (the same code)
    echo "wai check --aot: translating and building"
    aot_run_batches "$work" || return 1
    grep -v '^\["valid/' "$work/rows.raw" > "$work/rows.aot" || true
    mv -f "$work/rows.aot" "$work/rows.raw"
  else
    echo "wai check: running"
    GOMEMLIMIT=${WAI_GOMEMLIMIT:-1500MiB} timeout "${WAI_TIMEOUT:-1800}" "$wai_exe" wast "$work/plans.list" "$work/rows.raw"
  fi
  # a non-pass's reason beyond the root scripts prefixed by what its script tests (arbace.repr.wasm.wast/tag-of's tags)
  awk '$2 != ":pass" { if (match($1, /^\["[a-z]+\/proposals\/[^\/]+\//)) { t = substr($1, RSTART, RLENGTH); sub(/^\["[a-z]+\/proposals\//, "", t); sub(/\/$/, "", t); tag = "[proposal " t "] " }
         else if ($1 ~ /^\["[a-z]+\/legacy\//) tag = "[legacy exceptions] "
         else if (match($1, /^\["[a-z]+\/custom\/[^#.]+/)) { t = substr($1, RSTART, RLENGTH); sub(/^\["[a-z]+\/custom\//, "", t); tag = "[custom " t "] " }
         else tag = ""
         if (tag != "") { i = index($0, ":fail \""); $0 = substr($0, 1, i + 6) tag substr($0, i + 7) } }
       { print }' "$work/rows.raw" > "$work/rows.edn"
  while read -r cid subj mode other; do
    case $cid in ''|'#'*) continue ;; esac
    sp=${subj%#*} sk=${subj##*#}
    slug=$(printf '%s' "$sp" | sed 's|/|__|g')
    grep -q "^testsuite/$sp	" "$lst" || { echo "control $cid: left (not in this run)"; continue; }
    local cexe=$wai_exe
    [ -z "${aot:-}" ] || cexe=$(awk -F'\t' -v p="$work/plans/$slug.plan" '$1 == p { print $2; exit }' "$work/aot/exe.tsv")
    if [ -n "${other:-}" ]; then
      op=${other%#*} ok=${other##*#}; oslug=$(printf '%s' "$op" | sed 's|/|__|g')
      [ -f "$work/plans/$oslug.plan" ] || { echo "control $cid: left (its other script not in this run)"; continue; }
      v=$(GOMEMLIMIT=${WAI_GOMEMLIMIT:-1500MiB} "$cexe" control "$work/plans/$slug.plan" "$work/mods/$slug" "$sk" "$mode" "$work/plans/$oslug.plan" "$ok")
    else
      v=$(GOMEMLIMIT=${WAI_GOMEMLIMIT:-1500MiB} "$cexe" control "$work/plans/$slug.plan" "$work/mods/$slug" "$sk" "$mode")
    fi
    case $cid in
      _check/*) if [ "$v" = same ]; then echo "check $cid: passes, as it must"; else echo "FAIL: check $cid: $v"; fails=$((fails + 1)); fi ;;
      *) if [ "$v" = differs ]; then echo "control $cid: fails as it must"; else echo "FAIL: control $cid: $v"; fails=$((fails + 1)); fi ;;
    esac
  done < "$ctl"
  if [ -n "$only" ]; then
    # a partial run: judged on its scripts' rows alone
    arbace_tool -e "(let [run (set (map #(first (arbace.string/split (first %) #\"#\")) (read-string (str \"[\" (slurp \"$work/rows.edn\") \"]\")))) old (if (.exists (java.io.File. \"$res\")) (read-string (slurp \"$res\")) [])] (spit \"$work/old.edn\" (pr-str (vec (filter #(run (first (arbace.string/split (first %) #\"#\"))) old)))))"
    judge "$work/old.edn" "$work/rows.edn" "$cls" "" "" "$kind" || fails=$((fails + 1))
  else
    judge "$res" "$work/rows.edn" "$cls" "$record" "$ids" "$kind" || fails=$((fails + 1))
  fi
  [ $fails = 0 ]
}

. "$root/bin/lib/wai/go-run.bash"
. "$root/bin/lib/wai/aot.bash"
. "$root/bin/lib/wai/js-run.bash"

case ${1:-} in
  light) light; echo "wai: $wai_exe" ;;
  run) shift; light; exec "$wai_exe" run "$@" ;;
  gojs) shift; light; exec "$wai_exe" gojs "$@" ;;
  js)
    shift; record=; list=
    while [ $# -gt 0 ]; do
      case $1 in
        --record) record=1; shift ;;
        --list) list=$2; shift 2 ;;
        --essential) list=$root/test/wasm/essential-js.txt; shift ;;
        *) echo "wai js: $1?" >&2; exit 2 ;;
      esac
    done
    [ -z "$record" ] || [ -z "$list" ] || { echo "wai js: --record takes the whole corpus" >&2; exit 2; }
    jsrun_check "$record" "$list" ;;
  scene-build) mkdir -p "$jsrun_dir"; jsrun_build_scene ;;
  shim-check) light; mkdir -p "$jsrun_dir"; jsrun_shim_check; jsrun_ops_check ;;
  go)
    shift; record=; list=; gorun_aot=
    while [ $# -gt 0 ]; do
      case $1 in
        --record) record=1; shift ;;
        --list) list=$2; shift 2 ;;
        --essential) list=$root/test/wasm/essential-go.txt; shift ;;
        --aot) gorun_aot=1; shift ;;
        --vs-eval) gorun_vs_eval=1; shift ;;
        *) echo "wai go: $1?" >&2; exit 2 ;;
      esac
    done
    # --aot (WA7): the programs of test/wasm/go-aot.txt through w2g, recorded as their own record
    if [ -n "${gorun_aot:-}" ] && [ -z "$list" ] && [ -z "${gorun_vs_eval:-}" ]; then list=$root/test/wasm/go-aot.txt; fi
    [ -z "$record" ] || [ -z "$list" ] || [ -n "${gorun_aot:-}" ] || { echo "wai go: --record takes the whole corpus" >&2; exit 2; }
    [ -z "${gorun_vs_eval:-}" ] || { [ -n "${gorun_aot:-}" ] && [ -z "$record" ]; } || { echo "wai go: --vs-eval takes --aot, no --record" >&2; exit 2; }
    gorun_check "$record" "$list" ;;
  check)
    shift; record=; only=; aot=
    while [ $# -gt 0 ]; do case $1 in --record) record=1; shift ;; --only) only=$2; shift 2 ;; --aot) aot=1; shift ;; *) echo "wai check: $1?" >&2; exit 2 ;; esac; done
    check "$record" "$only" ;;
  essential) check "" "$root/test/wasm/essential-eval.txt" ;;
  aot-essential) aot=1; check "" "$root/test/wasm/essential-aot.txt" ;;
  divergences)
    if [ "${2:-}" = --aot ]; then r=${3:-$aot_results}; judge "$r" "$r" "$aot_classes" "" "" aot
    else r=${2:-$results}; judge "$r" "$r" "$classes" "" ""; fi ;;
  w2g)
    # w2g's instruction bodies and wai's exports for its packages, generated from the interpreter's exec.go (doc/wasm/WAI.md §9):
    # gen writes them into DIR (to be converted by repr/go's native reader with the package); check regenerates them from the light
    # build's printed exec.go and compares them with the printed w2gcases.go and w2gexports.go, entry by entry
    [ -z "${WAI_EXE:-}" ] || { echo "wai w2g: needs the light build (WAI_EXE unset)" >&2; exit 2; }
    light
    case ${2:-} in
      gen) [ -n "${3:-}" ] || { echo "wai w2g gen DIR" >&2; exit 2; }; mkdir -p "$3"; "$wai_exe" w2g-cases "$wai_dir/print/mod/wai" "$3" ;;
      check) "$wai_exe" w2g-check "$wai_dir/print/mod/wai" ;;
      *) echo "wai w2g gen DIR|check" >&2; exit 2 ;;
    esac ;;
  ops)
    case ${2:-} in
      gen) awk -f "$root/test/wasm/gen_wai_ops.awk" "$root/arbace/repr/wasm/ops.ae" | "$goroot/bin/gofmt" ;;
      check)
        [ -z "${WAI_EXE:-}" ] || { echo "wai ops check: needs the light build (WAI_EXE unset)" >&2; exit 2; }
        light
        "$wai_exe" ops > "$TMPDIR/wai-ops-go.txt"
        sed -n 's/^   \[\(nil\|0x[0-9a-f]*\) \(0x[0-9a-f]*\) "\([^"]*\)" \(:[a-z0-9-]*\)\]$/\1 \2 \3 \4/p' "$root/arbace/repr/wasm/ops.ae" > "$TMPDIR/wai-ops-ae.txt"
        if [ -s "$TMPDIR/wai-ops-ae.txt" ] && cmp -s "$TMPDIR/wai-ops-go.txt" "$TMPDIR/wai-ops-ae.txt"; then
          echo "wai ops check: the driver's $(wc -l < "$TMPDIR/wai-ops-go.txt") instructions are ops.ae's, row for row"
        else echo "FAIL: wai ops check: the driver's table is not ops.ae's (bin/wai ops gen, then convert)"; exit 1; fi ;;
      *) echo "wai ops gen|check" >&2; exit 2 ;;
    esac ;;
  *) sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac

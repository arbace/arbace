#!/bin/sh
# Run the vendored javac (built by bin/build-javac into target/javac). It accepts .java and
# javalisp (.jls) sources. Usage: bin/javac [javac options and files...]
root=$(cd "$(dirname "$0")/.." && pwd)
exec java -Xss16m \
  --add-exports java.base/jdk.internal.javac=ALL-UNNAMED \
  --add-exports java.base/jdk.internal.misc=ALL-UNNAMED \
  --add-exports java.base/jdk.internal.module=ALL-UNNAMED \
  --add-exports java.base/jdk.internal.jmod=ALL-UNNAMED \
  --add-exports java.base/sun.reflect.annotation=ALL-UNNAMED \
  --add-exports jdk.internal.opt/jdk.internal.opt=ALL-UNNAMED \
  -cp "$root/target/javac" arbace.javac.Main "$@"

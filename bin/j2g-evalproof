#!/bin/bash
# The evaluator boundary's proof (doc/go/EVAL-PLAN.md, "The proof"; J2G-NOTES.md, phase 2B):
# j2g translates Compiler (with its Go-build variants, arbace/lang/go/), the reader
# and RT, adds the Go program test/j2g/eval (forms read by the translated LispReader,
# analyzed by the translated Compiler, their Expr trees shown from Go, evaluated by Expr.eval
# and by Compiler.eval through the evaluator), builds it for each architecture of
# $J2G_ARCH (default amd64,arm64; arm64 runs under qemu-aarch64) and compares its output with
# test/j2g/eval/expected.txt.
#
# Usage: bin/j2g-evalproof [--record]
#   --record  write the amd64 output to test/j2g/eval/expected.txt instead of comparing
# Environment: J2G_ARCH, J2G_OUT (default .tmp/j2g/evalproof), J2G_GO_EXE (bin/j2g's).
# Exit status 0 when every architecture's program builds and prints the expected output.
set -uo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash" # TMPDIR: .tmp/tmp when unset
. "$root/bin/lib/renamed-env.bash" # stops on a stale G2A_*, J2A_*, A2G_* or C2A_*
cd "$root"
record=
case ${1:-} in
  "") ;;
  --record) record=1 ;;
  *) echo "usage: bin/j2g-evalproof [--record]" >&2; exit 2 ;;
esac
out=${J2G_OUT:-$root/.tmp/j2g/evalproof}
arches=${J2G_ARCH:-amd64,arm64}
expected=test/j2g/eval/expected.txt
bin/j2g --root 'arbace.lang.Compiler$*' \
  --root arbace.lang.LispReader --root arbace.lang.RT --root arbace.lang.Numbers \
  --root arbace.lang.RestFn \
  --main test/j2g/eval --out "$out" 2>&1 | grep -v '^WARNING' || exit 1
overlay=$(bin/jrt overlay) || exit 1
status=0
for arch in ${arches//,/ }; do
  exe=$out/bin/$arch/evalproof
  mkdir -p "$(dirname "$exe")"
  if ! bin/build-go --arch "$arch" --work "$out/work-$arch" -o "$exe" --overlay "$overlay" --root x509roots \
         "$out/prog" > "$out/build-$arch.log" 2>&1; then
    tail -30 "$out/build-$arch.log"; echo "j2g-evalproof: $arch: build failed"; status=1; continue
  fi
  if [ "$arch" = arm64 ]; then run=(/usr/bin/qemu-aarch64 "$exe"); else run=("$exe"); fi
  "${run[@]}" > "$out/output-$arch.txt" 2>&1
  if [ -n "$record" ] && [ "$arch" = amd64 ]; then
    cp "$out/output-$arch.txt" "$expected"; echo "j2g-evalproof: recorded $expected"
  elif diff -u "$expected" "$out/output-$arch.txt" > "$out/diff-$arch.txt"; then
    echo "j2g-evalproof: $arch: as expected ($(grep -c '^form' "$expected") forms; $(stat -c %s "$exe") bytes)"
  else
    head -40 "$out/diff-$arch.txt"; echo "j2g-evalproof: $arch: differs from $expected"; status=1
  fi
done
exit $status

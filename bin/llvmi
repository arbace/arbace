#!/bin/bash
# llvmi, LLVM IR's evaluator (doc/llvm/LLVM-CROP-SURVEY.md §5, §7; "As built: llvmi (LL2's run, LL6, LL7)"): an IR module
# read as LLVM forms by repr/llvm, lowered to C forms by the shared lowering (arbace.cpp.lower, doc/llvm/LOWER.md), printed
# as C with the personality-free layer (arbace/llvm/rt/none.c.ae) as one translation unit (arbace.llvm.run), then run by
# ci (eval: C's checker, its builder with musl 1.2.6 as C forms, tools/cirun) or translated by cf2g into Go and built by
# TamaGo's go (AOT). The judge: the module's own run by LLVM 23's lli (the host's llvm23, LLS8 as the brief of 2026-11-05
# took it: the same module, not a build of its source), status, stdout and stderr, recorded as data
# (test/llvm/ref-lli23.edn), so the check runs without lli. All on the tools' host, light (each process under 2 GiB).
#
#   bin/llvmi lower FILE.ll [-o OUT.c]   FILE lowered into one C unit (default FILE.c); exit 3 when refused
#   bin/llvmi run FILE.ll [-- ARG...]    FILE lowered and run by ci; the program's status is the command's
#   bin/llvmi modules [--corpus C,...] [WORK]
#                                        the corpora's modules into WORK/modules.tsv (ID PATH IR-SHA256): ee (llvm/test/ExecutionEngine's
#                                        modules lli runs plainly, read in place from $LLVM_SRC), c-O0 and c-O2 (test/c/synth's and
#                                        test/c/run's programs through clang 23 -S -emit-llvm at -O0 and -O2, into WORK/ir/), cpp (C++'s
#                                        samples and runtime samples through clang++ -O0)
#   bin/llvmi ir-make [PACK...]          the pinned IR made afresh by clang (packs tx, c; test/llvm/ir/): a pack per corpus set, its manifest
#                                        and command; the check reads the IR from the packs and needs no clang (LLVMI_CLANG=1: compiled now)
#   bin/llvmi ir-make c --stale          (n-llvm-indep) only the manifest's c-O0, c-O2 and cpp modules whose checkout source changed
#                                        compiled again by clang with the corpus' command, the others' IR kept from the pack (no new
#                                        module: a file the manifest does not name is not added); c.cmd names the refreshed ids
#   bin/llvmi ir-make rt [--mutants]     the pack rt (LLS31 (a)): test/llvm/rt-builds.tsv's modules by clang, clang++, rustc and llvm-stress
#                                        with Arbace's mutants of them (repr/llvm's families roundtrip-rt, text-rt, verify-rt, verify-rt-heldout);
#                                        --mutants: the mutants made again from the pack's modules, no compiler
#   bin/llvmi rt-list [RECORD]           test/llvm/rt-builds.tsv from the first records' ids (the corners dropped)
#   bin/llvmi record-ref [--corpus C,...] [--only LIST]
#                                        lli's runs (empty stdin, no arguments, 10 s) recorded into test/llvm/ref-lli23.edn (--only:
#                                        those ids rewritten, the others kept)
#   bin/llvmi check [--aot] [--corpus C,...] [--only LIST | --essential] [--record] [--judge]
#                                        every module lowered, run by ci (--aot: built by cf2g and go) and judged by its own verdict
#                                        (llvm/test's lit RUN and CHECK lines, gcc's torture harness: exit 0), else against lli's
#                                        recorded run (LLVMI_JUDGE=lli: every module against lli's, the oracle tier; doc/llvm/
#                                        LLVM-CROP-SURVEY.md, "As built: LL9a"); --essential: test/llvm/essential-check.txt:
#                                        rows [ID RESULT REASON] in WORK/results.edn (WORK .tmp/llvmi/eval or .tmp/llvmi/aot), every
#                                        non-pass in a class of test/llvm/divergences-eval.edn (--aot: divergences-aot.edn, then eval's),
#                                        a recorded pass that does not pass a failure, the negative controls of test/llvm/controls.edn
#                                        (a subject's run judged against another module's reference) failing as they must; --record
#                                        rewrites test/llvm/check-eval-linux-amd64.edn (--aot: check-aot-linux-amd64.edn), with --only its rows alone;
#                                        --judge: the last run judged again
#   bin/llvmi divergences [--aot]        the recorded check judged against its classes, nothing run
# LLVMI_TX_ALL=1: the torture corpora whole (3,040 modules) instead of test/llvm/tx-sample.txt (304).
# LLVMI_AOT_HEAVY=1: --aot builds test/llvm/aot-heavy.txt's modules too (else their recorded rows are kept). LLVMI_JOBS (default 3)
# programs at once, LLVMI_THREADS (default 2) the Arbace processes' threads, LLVMI_SHARD (default 40) AOT's programs a Go build; GOMEMLIMIT 1500MiB.
set -uo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash"
. "$root/bin/lib/tools.bash"
# C's target (c/README.md; doc/C23-SURVEY.md, "As built: C's own target"): ci reads Arbace's description c/target and its sysroot
# by default, gcc's recorded test/c/host under ARBACE_C_TARGET=gcc (the oracle tier's); LLS27 (a), batch 2
. "$root/bin/lib/repr-c/sysroot.bash"
main=$root
# the main checkout (its .tmp/llvm/src, the pinned tarball's extraction): a worktree's (.tmp/worktrees/NAME) or the clean run's
# clone's (.tmp/gate-clean/SHA, also of a worktree), else this one
main=${root%%/.tmp/gate-clean/*}; main=${main%%/.tmp/worktrees/*}
export GOMAXPROCS=${GOMAXPROCS:-4} GOMEMLIMIT=${GOMEMLIMIT:-1500MiB}
llvm_bin=${LLVM_BIN:-/usr/lib/llvm23/bin}
lli=$llvm_bin/lli
src=${LLVM_SRC:-$main/.tmp/llvm/src}/llvm-project-23.1.5.src
jobs=${LLVMI_JOBS:-3} threads=${LLVMI_THREADS:-2}
all_corpora=ee,c-O0,c-O2,cpp,tx-O0,tx-O2
# the torture corpora's sample (every 10th module, test/llvm/tx-sample.txt) unless LLVMI_TX_ALL=1: the whole, 3,040 modules, is the night's
tx_sample=$root/test/llvm/tx-sample.txt
ref=$root/test/llvm/ref-lli23.edn
# the torture corpus (tx-O0, tx-O2): ccorpus2 in Go's module cache, as bin/ci's corpora (test/c/corpora.edn's :torture-execute)
tx=${LLVMI_TORTURE:-${GOMODCACHE:-/root/go/pkg/mod}/modernc.org/ccorpus2@v1.6.0/assets/gcc-9.1.0/gcc/testsuite/gcc.c-torture/execute}
tx_flags="-Wno-error=implicit-function-declaration -Wno-error=implicit-int -Wno-error=int-conversion -Wno-error=incompatible-pointer-types -Wno-error=return-mismatch -Wno-error=incompatible-function-pointer-types"
# tx_dg_options FILE (LLS54 (a), the user 2026-11-17): the options gcc's harness adds to the torture test FILE (relative to $tx), its
# dg-options and dg-additional-options, after the torture level's (gcc's order: an -O2 of them wins over tx-O0's -O0), one line: a
# directive without a target selector, or whose selector names x86_64-*-* (not with ia32), or fpic, applies; of its options -f*, -std=*,
# -O*, -D* and -m* that clang accepts (a gcc-only one clang refuses, -mpc64, is left out), never -W* (the build is -w) nor -Wl,* (no link)
tx_dg_options() {
  local f=$1 probe=$TMPDIR/llvmi-dg-probe.c
  [ -f "$probe" ] || : > "$probe"
  grep -h 'dg-\(additional-\)\{0,1\}options' "$tx/$f" 2>"$TMPDIR/llvmi-dg.err" | while IFS= read -r line; do
    local opts sel o
    opts=$(printf '%s\n' "$line" | sed -n 's/.*dg-\(additional-\)\{0,1\}options *{\{0,1\} *"\([^"]*\)".*/\2/p')
    sel=$(printf '%s\n' "$line" | sed -n 's/.*dg-\(additional-\)\{0,1\}options *{\{0,1\} *"[^"]*" *}\{0,1\} *\(.*\)$/\2/p')
    case $sel in
      *target*)
        case $sel in *ia32*|*'!'*) continue ;; esac
        case $sel in *'x86_64-*-*'*|*' fpic '*) ;; *) continue ;; esac ;;
    esac
    for o in $opts; do
      case $o in
        -W*) ;;
        -f*|-std=*|-O*|-D*|-m*) clang -fsyntax-only -x c "$o" "$probe" 2>"$TMPDIR/llvmi-dg.err" && printf ' %s' "$o" ;;
      esac
    done
  done
  rm -f "$TMPDIR/llvmi-dg.err"
}
quiet() { grep -v '^Reflection warning\|recur arg for primitive\|^Auto-boxing' || true; }
tool() { # an Arbace tool on the tools' host, its compiler's warnings filtered out of stderr
  local e st; e=$(mktemp "$TMPDIR/llvmi-err.XXXXXX")
  (cd "$root" && arbace_tool -p "$root" "$@") 2> "$e"; st=$?
  quiet < "$e" >&2; rm -f "$e"; return $st
}

# The IR clang makes is pinned (doc/llvm/LLVM-CROP-SURVEY.md, "Decided (2026-11-06, the user: the torture corpora's IR pinned)"):
# test/llvm/ir/PACK.tar.xz (deterministic), its SHA-256 PACK.tar.xz.sha256, its manifest PACK.tsv (ID, SOURCE, SOURCE-SHA256,
# IR-SHA256) and PACK.cmd (the clang and the command that made it, bin/llvmi ir-make PACK); the check reads the IR from the pack and needs
# no clang (LLVMI_CLANG=1: compiled afresh, as before). Packs: tx (tx-O0, tx-O2), c (c-O0, c-O2, cpp).
irdir=${LLVMI_IRDIR:-$root/test/llvm/ir}  # LLVMI_IRDIR: another directory (a subset's proof, not the pins)
pack_of() { case $1 in tx-O0|tx-O2) echo tx ;; c-O0|c-O2|cpp) echo c ;; *) return 1 ;; esac; }
# pinned WORK PACK CORPUS: the corpus' modules (ID<tab>PATH) out of the pack, extracted once into WORK/pin/PACK; a source the manifest
# names that exists here with another digest makes the pack stale (an error: bin/llvmi ir-make PACK)
pinned() {
  local work=$1 pk=$2 c=$3 d=$1/pin/$2 bad
  [ -f "$irdir/$pk.tar.xz" ] || { echo "llvmi: no $irdir/$pk.tar.xz (bin/llvmi ir-make $pk)" >&2; return 1; }
  if [ ! -f "$d/.ok" ]; then
    (cd "$irdir" && sha256sum -c --quiet "$pk.tar.xz.sha256") >&2 || { echo "llvmi: $pk.tar.xz does not match its pin" >&2; return 1; }
    # -m: the files dated now, not the pack's 1970 (a WORK under TMPDIR, controls-test's, lost its modules to the gate's cheap
    # prune of TMPDIR's files older than 2 days, gate_cache_cap, run before another step: stack-w2's llvm-controls-test, 2026-11-17)
    rm -rf "$d"; mkdir -p "$d"; xz -dc "$irdir/$pk.tar.xz" | tar -xmf - -C "$d" && : > "$d/.ok"
  fi
  bad=$(awk -F'\t' -v c="$c." -v root="$root" -v tx="$tx" 'index($1, c) == 1 {
          s = $2; p = (sub(/^checkout:/, "", s) ? root "/" s : (sub(/^torture:/, "", s) ? tx "/" s : ""))
          if (p != "" && (getline l < p) >= 0) { close(p); cmd = "sha256sum < \"" p "\""; cmd | getline h; close(cmd); split(h, a, " ")
            if (a[1] != $3) print $1 }
        }' "$irdir/$pk.tsv")
  [ -z "$bad" ] || { echo "llvmi: the pinned IR of $pk is stale for: $(echo $bad | head -c 400) (bin/llvmi ir-make $pk)" >&2; return 1; }
  awk -F'\t' -v c="$c." -v d="$d" 'index($1, c) == 1 { print $1 "\t" d "/" $1 ".ll" }' "$irdir/$pk.tsv" |
    if [ -n "${only_ids:-}" ]; then awk -F'\t' 'FILENAME == ARGV[1] { w[$1] = 1; next } ($1 in w)' "$only_ids" -; else cat; fi
}

# The pack rt (LLS31 (a); doc/llvm/LLVM-CROP-SURVEY.md, "As built: LLS31 (a)"): the first records' 282-module lists made again
# but their 21 corner modules (sources lost), the input of repr/llvm's families roundtrip-rt, text-rt, verify-rt and verify-rt-heldout
# (bin/repr-llvm check), not of llvmi's run. test/llvm/rt-builds.tsv (ID, SOURCE, BUILD; bin/llvmi rt-list) names each module: SOURCE
# gcc15:NAME.c (gcc 15.2.0's gcc.c-torture/execute from the pinned tarball, test/c/corpora.edn's :gcc-15.2.0: all 41 programs of the
# first records are there, 5 of them not in gcc 9.1.0's), checkout:PATH (the C++ samples, Rust's sample) or llvm-stress:SEED; BUILD its command
# (rt_compile). The pack holds the modules (ID.ll) and Arbace's mutants of them (mut/NAME.KIND.K.ll, rt_mutant_sets), its manifest
# rt.tsv: ID, SOURCE (for a mutant mutant-SET:BASE), SOURCE-SHA256 (a mutant's: its base module's IR), IR-SHA256.
rt_builds=$root/test/llvm/rt-builds.tsv
# the mutant sets, SET N FIRST FAMILY INPUT (bin/repr-llvm mutants LIST OUT N FIRST FAMILY): the first records' (their names' indices:
# a fitted set 0-339 and 1000-1339 of the base family's 17 kinds, the held-out sets 500000-500599 and 600000-600599 of every kind),
# over the pack's modules and test/llvm/hw.list in that order (`modules`); ctl, ctlh and ctlu one mutant each of hw.list, the negative
# controls' subjects and references (test/repr/llvm/verify-controls.txt): two :noterm (index 2 mod 17; the bases hw-dbg and hw-notes by
# the mutator's start) and one :undef (7 mod 17, hw-implicit), known by day, whatever the pack holds
rt_mutant_sets="a 340 0 base modules
b 340 1000 base modules
h1 600 500000 - modules
h2 600 600000 - modules
ctl 1 900016 base hw
ctlh 1 900050 base hw
ctlu 1 900055 base hw"
# rt_cpp_isystem: the -isystem flags of C++'s headers made without g++ (bin/lib/repr-cpp/sysroot.bash's cpp_full_sysroot: libstdc++'s
# from the pinned gcc-15.2.0 tarball, musl's from its tarball), the Mach-O build's (the host has no macOS SDK)
rt_cpp_isystem() {
  local s r
  s=$( (. "$root/bin/lib/repr-cpp/sysroot.bash"; cpp_full_sysroot) ) || return 1
  while read -r r; do
    case $r in */lib/clang/*) continue ;; esac  # clang's own resource directory stays clang's (-nostdlibinc keeps it)
    [ -d "$s$r" ] && printf -- '-isystem %s ' "$s$r"
  done < "$s/roots.txt"
  return 0
}
# rt_torture: gcc 15.2.0's gcc.c-torture/execute's programs rt-builds.tsv names, extracted once from the pinned tarball (the main
# checkout's .tmp/c1/gcc/gcc-15.2.0.tar.xz, as C's and C++'s crops take it; REPR_CPP_GCC_TARBALL another) into .tmp/llvmi/rt-gcc15
rt_torture() {
  local t=${REPR_CPP_GCC_TARBALL:-$main/.tmp/c1/gcc/gcc-15.2.0.tar.xz} d=$root/.tmp/llvmi/rt-gcc15 want e=gcc-15.2.0/gcc/testsuite/gcc.c-torture/execute
  if [ ! -f "$d/.ok" ]; then
    want=$(sed -n '/^ {:gcc-15.2.0$/,/:sha256/s/^ *:sha256 "\([0-9a-f]*\)".*/\1/p' "$root/test/c/corpora.edn" | head -1)
    [ -f "$t" ] || { echo "llvmi: no $t (gcc 15.2.0's tarball, test/c/corpora.edn's :gcc-15.2.0)" >&2; return 1; }
    [ "$(sha256sum < "$t" | cut -c1-64)" = "$want" ] || { echo "llvmi: $t is not the pinned gcc-15.2.0 tarball" >&2; return 1; }
    rm -rf "$d"; mkdir -p "$d"
    awk -F'\t' -v e="$e" '$2 ~ /^gcc15:/ { f = $2; sub(/^gcc15:/, "", f); if (!s[f]++) print e "/" f }' "$rt_builds" > "$d.names"
    tar -xJf "$t" -C "$d" -T "$d.names" || return 1
    rm -f "$d.names"; : > "$d/.ok"
  fi
  echo "$d/$e"
}
# rt_compile ID SOURCE BUILD OUT: one module made into OUT (its log OUT.log); status 0 when made
rt_compile() {
  local id=$1 so=$2 b=$3 out=$4 f o rd
  case $so in
    gcc15:*)
      f=${so#gcc15:}
      case $b in g0) o="-O0 -g" ;; g2) o="-O2 -g" ;; o2) o=-O2 ;; lto) o="-O2 -flto" ;; win) o="-O2 --target=x86_64-pc-windows-msvc" ;; *) return 2 ;; esac
      (cd "$rt_tx" && clang $o -S -emit-llvm -std=gnu17 -w -fno-strict-aliasing $tx_flags -ffile-prefix-map="$rt_tx/"= -fdebug-compilation-dir=. -o "$out" "$f") 2> "$out.log" ;;
    checkout:*.cpp)
      f=${so#checkout:}
      case $b in g0) o="-O0 -g" ;; g2) o="-O2 -g" ;; lto) o="-O2 -flto" ;; win) o="-O2 --target=x86_64-pc-windows-msvc" ;;
        mac) o="-O0 --target=x86_64-apple-macosx -nostdlibinc -nostdinc++ $rt_isystem" ;; *) return 2 ;; esac
      (cd "$root" && clang++ $o -S -emit-llvm -std=c++23 -w -ffile-prefix-map="$root/"= -fdebug-compilation-dir=. -o "$out" "$f") 2> "$out.log" ;;
    checkout:*.rs)
      # rustc (the oracle tier's, by hand) into a scratch directory: -C lto=fat writes one module
      f=${so#checkout:}
      case $b in g0) o="-C opt-level=0 -g" ;; g2) o="-C opt-level=2 -g" ;; lt) o="-C opt-level=2 -C lto=fat" ;; *) return 2 ;; esac
      rd=$(mktemp -d "$TMPDIR/llvmi-rs.XXXXXX")
      (cd "$root" && rustc $o -C codegen-units=1 --emit=llvm-ir --crate-type=bin --edition 2021 --remap-path-prefix="$root/"= -o "$rd/m.ll" "$f") 2> "$out.log" \
        && mv "$rd/m.ll" "$out"; local st=$?; rm -rf "$rd"; return $st ;;
    llvm-stress:*)
      [ "$b" = stress ] || return 2
      "$llvm_bin/llvm-stress" -size=60 -seed="${so#llvm-stress:}" -o "$out" 2> "$out.log" ;;
    *) return 2 ;;
  esac
}
# rt_source_sha SOURCE: the digest a manifest row records for it (a file's; llvm-stress's seed has none: -)
rt_source_sha() {
  case $1 in
    gcc15:*) sha256sum < "$rt_tx/${1#gcc15:}" | cut -d' ' -f1 ;;
    checkout:*) sha256sum < "$root/${1#checkout:}" | cut -d' ' -f1 ;;
    *) echo - ;;
  esac
}
# rt_make [--mutants]: the pack made into $irdir/rt.{tar.xz,tar.xz.sha256,tsv,cmd} (LLVMI_RT_ONLY=LIST: only those ids of
# rt-builds.tsv, LLVMI_RT_MUT_N=N: at most N mutants a set, a subset's proof; with LLVMI_IRDIR elsewhere than the pins);
# --mutants: the modules taken from the existing pack, no compiler run, the mutants made again (the mutator or the reader changed)
rt_make() {
  local w=$root/.tmp/llvmi/ir-make/rt mutonly= id so b set n first fam inp list
  [ "${1:-}" = --mutants ] && mutonly=1
  [ -f "$rt_builds" ] || { echo "llvmi ir-make rt: no $rt_builds (bin/llvmi rt-list)" >&2; return 1; }
  rm -rf "$w"; mkdir -p "$w/stage/mut" "$w/log"
  if [ -n "$mutonly" ]; then
    [ -f "$irdir/rt.tar.xz" ] || { echo "llvmi ir-make rt --mutants: no $irdir/rt.tar.xz" >&2; return 1; }
    (cd "$irdir" && sha256sum -c --quiet rt.tar.xz.sha256) >&2 || { echo "llvmi: rt.tar.xz does not match its pin" >&2; return 1; }
    mkdir -p "$w/old"; xz -dc "$irdir/rt.tar.xz" | tar -xmf - -C "$w/old" || return 1
    awk -F'\t' '$2 !~ /^mutant-/' "$irdir/rt.tsv" > "$w/modules.tsv"
    cut -f1 "$w/modules.tsv" | while read -r id; do cp "$w/old/$id.ll" "$w/stage/$id.ll"; done
  else
    rt_isystem=$(rt_cpp_isystem) || { echo "llvmi ir-make rt: C++'s headers (cpp_full_sysroot) failed" >&2; return 1; }
    rt_tx=$(rt_torture) || return 1
    : > "$w/modules.tsv"
    while IFS=$'\t' read -r id so b; do
      case $id in ''|'#'*) continue ;; esac
      [ -z "${LLVMI_RT_ONLY:-}" ] || grep -qxF "$id" "$LLVMI_RT_ONLY" || continue
      if rt_compile "$id" "$so" "$b" "$w/stage/$id.ll"; then
        printf '%s\t%s\t%s\t%s\n' "$id" "$so" "$(rt_source_sha "$so")" "$(sha256sum < "$w/stage/$id.ll" | cut -d' ' -f1)" >> "$w/modules.tsv"
      else
        rm -f "$w/stage/$id.ll"; echo "llvmi ir-make rt: $id not made ($b of ${so}): $(head -1 "$w/stage/$id.ll.log" | cut -c1-160)" >&2
      fi
      [ -f "$w/stage/$id.ll.log" ] && mv "$w/stage/$id.ll.log" "$w/log/$id.log"
    done < "$rt_builds"
  fi
  # the mutator's inputs: the pack's modules in the manifest's order, then the hand-written modules (their committed files)
  awk -F'\t' -v d="$w/stage" '{ print $1 "\t" d "/" $1 ".ll" }' "$w/modules.tsv" > "$w/in-modules.list"
  awk -F'\t' -v r="$root" 'NF { print $1 "\t" r "/" $2 }' "$root/test/llvm/hw.list" > "$w/in-hw.list"
  cat "$w/in-modules.list" "$w/in-hw.list" > "$w/in-all.list"
  : > "$w/mutants.tsv"
  while read -r set n first fam inp; do
    [ "$inp" = hw ] && list=$w/in-hw.list || list=$w/in-all.list
    [ -n "${LLVMI_RT_MUT_N:-}" ] && [ "$n" -gt "$LLVMI_RT_MUT_N" ] && n=$LLVMI_RT_MUT_N
    [ "$fam" = - ] && fam=
    "$root/bin/repr-llvm" mutants "$list" "$w/mut-$set" "$n" "$first" $fam > "$w/log/mutants-$set.log" 2>&1 \
      || { cat "$w/log/mutants-$set.log" >&2; return 1; }
    while IFS=$'\t' read -r id p; do
      [ -n "$id" ] || continue
      base=$(echo "$id" | sed -E 's/\.[^.]+\.[0-9]+$//')
      bp=$(awk -F'\t' -v n="$base" '$1 == n { print $2; exit }' "$list")
      mv "$p" "$w/stage/mut/$id.ll"
      printf '%s\tmutant-%s:%s\t%s\t%s\n' "$id" "$set" "$base" "$(sha256sum < "$bp" | cut -d' ' -f1)" "$(sha256sum < "$w/stage/mut/$id.ll" | cut -d' ' -f1)" >> "$w/mutants.tsv"
    done < "$w/mut-$set/mutants.list"
    echo "llvmi ir-make rt: mutant set $set: $(grep -c "	mutant-$set:" "$w/mutants.tsv") of $n"
  done <<< "$rt_mutant_sets"
  mkdir -p "$irdir"
  cat "$w/modules.tsv" "$w/mutants.tsv" > "$irdir/rt.tsv"
  (cd "$w/stage" && LC_ALL=C tar --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner --format=gnu -cf - .) | xz -9e -T1 > "$irdir/rt.tar.xz"
  (cd "$irdir" && sha256sum rt.tar.xz > rt.tar.xz.sha256)
  if [ -z "$mutonly" ] || [ ! -f "$irdir/rt.cmd" ]; then
    { echo ";; the pack rt's IR (bin/llvmi ir-make rt; doc/llvm/LLVM-CROP-SURVEY.md, \"As built: LLS31 (a)\"): test/llvm/rt-builds.tsv's modules and Arbace's mutants"
      echo "clang: $(clang --version | head -1)"
      echo "rustc: $(rustc --version 2>&1 | head -1)"
      echo "llvm-stress: $("$llvm_bin/llvm-stress" --version 2>&1 | grep -m1 -i version | sed 's/^ *//')"
      echo "torture BUILD: clang -O0 -g (g0) | -O2 -g (g2) | -O2 (o2) | -O2 -flto (lto) | -O2 --target=x86_64-pc-windows-msvc (win) -S -emit-llvm -std=gnu17 -w -fno-strict-aliasing $tx_flags -ffile-prefix-map=TX/= -fdebug-compilation-dir=. NAME.c (TX: gcc-15.2.0.tar.xz's gcc/testsuite/gcc.c-torture/execute)"
      echo "C++ BUILD: clang++ -O0 -g (g0) | -O2 -g (g2) | -O2 -flto (lto) | -O2 --target=x86_64-pc-windows-msvc (win) | -O0 --target=x86_64-apple-macosx -nostdlibinc -nostdinc++ -isystem TREE/... (mac; TREE: cpp_full_sysroot, the headers made without g++) -S -emit-llvm -std=c++23 -w -ffile-prefix-map=ROOT/= -fdebug-compilation-dir=. test/cpp/samples/NAME.cpp"
      echo "Rust BUILD: rustc -C opt-level=0 -g (g0) | -C opt-level=2 -g (g2) | -C opt-level=2 -C lto=fat (lt) -C codegen-units=1 --emit=llvm-ir --crate-type=bin --edition 2021 --remap-path-prefix=ROOT/= test/rust/sample/shapes.rs"
      echo "stress: llvm-stress -size=60 -seed=N"
      echo "mutants (bin/repr-llvm mutants LIST OUT N FIRST FAMILY, arbace.repr.llvm.mutate; SET N FIRST FAMILY INPUT):"
      echo "$rt_mutant_sets" | sed 's/^/  /'
      echo "modules: a build the compiler refuses is not one; the manifest rt.tsv: ID, SOURCE (mutant-SET:BASE), SOURCE-SHA256 (a mutant's base's IR), IR-SHA256"; } > "$irdir/rt.cmd"
  fi
  echo "llvmi ir-make: rt: $(wc -l < "$w/modules.tsv") modules, $(wc -l < "$w/mutants.tsv") mutants, $(wc -c < "$irdir/rt.tar.xz") bytes"
}

# modules WORK CORPORA: WORK/modules.tsv
modules() {
  local work=$1 corpora=$2 c f n
  mkdir -p "$work/ir"
  work=$(cd "$work" && pwd)
  : > "$work/modules.tsv"
  : > "$work/sources.tsv"
  IFS=, read -r -a cs <<< "$corpora"
  for c in "${cs[@]}"; do
    if [ -z "${LLVMI_CLANG:-}" ] && pk=$(pack_of "$c"); then
      pinned "$work" "$pk" "$c" > "$work/pinned.tsv" || exit 1
      case $c in tx-*) if [ -z "${LLVMI_TX_ALL:-}" ]; then awk -F'\t' 'FILENAME == ARGV[1] { w[$1] = 1; next } ($1 in w)' "$tx_sample" "$work/pinned.tsv" > "$work/pinned.new"; mv "$work/pinned.new" "$work/pinned.tsv"; fi ;; esac
      cat "$work/pinned.tsv" >> "$work/modules.tsv"; rm -f "$work/pinned.tsv"; continue
    fi
    case $c in
      ee)
        [ -d "$src/llvm/test/ExecutionEngine" ] || { echo "llvmi: no $src/llvm/test (bin/llvm-corpus extract)" >&2; exit 1; }
        # a module with a main whose first RUN line is a plain lli run (no extra modules, no remote target, no lazy JIT, no `not`)
        (cd "$src/llvm/test" && grep -l 'define.*@main' -r ExecutionEngine --include='*.ll' | LC_ALL=C sort) | while read -r f; do
          r=$(grep -m1 '^; RUN:' "$src/llvm/test/$f")
          case $r in *extra-module*|*remote*|*orc-lazy*|*'jit-kind=orc '*|*' not '*|*'<'*) continue ;; esac
          case $r in '; RUN: %lli'*|'; RUN:  %lli'*|'; RUN: lli'*) ;; *) continue ;; esac
          n=ee.$(echo "${f#ExecutionEngine/}" | sed 's/\.ll$//; s|/|.|g')
          printf '%s\t%s\n' "$n" "$src/llvm/test/$f"
        done >> "$work/modules.tsv" ;;
      c-O0|c-O2)
        for f in "$root"/test/c/synth/*.c "$root"/test/c/run/*.c; do
          n=$c.$(basename "$(dirname "$f")").$(basename "$f" .c)
          (cd "$root" && clang -${c#c-} -S -emit-llvm -std=gnu23 -w -I test/c/synth -ffile-prefix-map="$root/"= \
             -o "$work/ir/$n.ll" "${f#$root/}") 2> "$work/ir/$n.clang.log" || { rm -f "$work/ir/$n.ll"; continue; }
          printf '%s\tcheckout:%s\t%s\n' "$n" "${f#$root/}" "$f" >> "$work/sources.tsv"
          printf '%s\t%s\n' "$n" "$work/ir/$n.ll"
        done >> "$work/modules.tsv" ;;
      tx-O0|tx-O2)
        # gcc 9.1.0's gcc.c-torture/execute (test/c/corpora.edn's :torture-execute, ccorpus2 at its pin) with ieee/, not builtins/ (its
        # tests link builtins/lib/): through clang 23 in gnu17 with gcc's leniencies as warnings (implicit declarations, implicit int,
        # int conversions: the 1990s tests rely on them); a program clang refuses is not a module
        [ -d "$tx" ] || { echo "llvmi: no $tx (Go's module cache: modernc.org/ccorpus2@v1.6.0)" >&2; exit 1; }
        (cd "$tx" && ls *.c ieee/*.c | LC_ALL=C sort) | while read -r f; do
          n=$c.$(echo "${f%.c}" | tr / .)
          [ -z "${only_ids:-}" ] || grep -qxF "$n" "$only_ids" || continue  # --only: compile only the ids asked
          # LLS54 (a): the test's own dg-options after the level's (tx_dg_options)
          dgo=$(tx_dg_options "$f")
          (cd "$tx" && clang -${c#tx-} -S -emit-llvm -std=gnu17 -w -fno-strict-aliasing $tx_flags $dgo \
             -ffile-prefix-map="$tx/"= -o "$work/ir/$n.ll" "$f") 2> "$work/ir/$n.clang.log" || { rm -f "$work/ir/$n.ll"; continue; }
          [ -z "$dgo" ] || printf '%s\t%s\n' "$n" "${dgo# }" >> "$work/dg-options.tsv"
          grep -q '^define .*@main(' "$work/ir/$n.ll" || { rm -f "$work/ir/$n.ll"; continue; }
          printf '%s\ttorture:%s\t%s\n' "$n" "$f" "$tx/$f" >> "$work/sources.tsv"
          printf '%s\t%s\n' "$n" "$work/ir/$n.ll"
        done >> "$work/modules.tsv" ;;
      cpp)
        for f in "$root"/test/cpp/samples/*.cpp "$root"/test/cpp/runtime/samples/*.cpp; do
          case $f in */runtime/samples/*) n=cpp.runtime.$(basename "$f" .cpp) ;; *) n=cpp.samples.$(basename "$f" .cpp) ;; esac
          (cd "$root" && clang++ -O0 -S -emit-llvm -std=c++23 -w -ffile-prefix-map="$root/"= -o "$work/ir/$n.ll" "${f#$root/}") \
            2> "$work/ir/$n.clang.log" || { rm -f "$work/ir/$n.ll"; continue; }
          grep -q '^define .*@main(' "$work/ir/$n.ll" || continue  # a sample without a main is not run-capable
          printf '%s\tcheckout:%s\t%s\n' "$n" "${f#$root/}" "$f" >> "$work/sources.tsv"
          printf '%s\t%s\n' "$n" "$work/ir/$n.ll"
        done >> "$work/modules.tsv" ;;
      *) echo "llvmi: no corpus $c ($all_corpora)" >&2; exit 2 ;;
    esac
  done
  # the IR's digest: a reference recorded from other IR (another clang) is stale, not a divergence
  while IFS=$'\t' read -r n f; do printf '%s\t%s\t%s\n' "$n" "$f" "$(sha256sum < "$f" | cut -d' ' -f1)"; done < "$work/modules.tsv" > "$work/modules.tsv.new"
  mv "$work/modules.tsv.new" "$work/modules.tsv"
}

only_filter() { # WORK LIST: keep the ids of LIST in WORK/modules.tsv
  [ -n "$2" ] || return 0
  awk -F'\t' 'FILENAME == ARGV[1] { if ($0 !~ /^#/ && NF) w[$1] = 1; next } ($1 in w)' "$2" "$1/modules.tsv" > "$1/modules.tsv.new"
  mv "$1/modules.tsv.new" "$1/modules.tsv"
}

# run_budget ID: the CPU seconds of a C++ program bin/cppi check budgets (test/cpp/check-budget.edn's entry for the same program:
# cpp.runtime.N is runtime/N.cpp, cpp.samples.N samples/N.cpp; its :cpu, else its seconds; a program it does not list bin/cppi
# check's default, 30 s of CPU, CPPI_BUDGET: runtime/threads.cpp takes 17 s of CPU and 21 s of wall on a loaded host, past the flat
# 10 s, h-haskell-deferred 2026-11-17), nothing for any other module. The
# programs are the same and so is their cost on ci: runtime/atomics.cpp's four spinning threads take 14-35 s where lli's
# recording and llvmi's default give 10 (gate b1-1115's llvmi-check timed it out), and the inherited GOMEMLIMIT=1500MiB under its
# 2.8 GB heap makes the collector run without end (bin/lib/cppi/runprog.bash)
run_budget() {
  local p
  case $1 in cpp.runtime.*) p=runtime/${1#cpp.runtime.}.cpp ;; cpp.samples.*) p=samples/${1#cpp.samples.}.cpp ;; *) return 0 ;; esac
  sed -n "s|^[{ ]*\"$p\" *\\([0-9][0-9]*\\)\\( *:cpu *\\([0-9][0-9]*\\)\\)\\{0,1\\}.*|\\1 \\3|p" "$root/test/cpp/check-budget.edn" 2>"$TMPDIR/llvmi-budget.$$.err" |
    head -1 | awk '{ print ($2 != "") ? $2 : $1 } END { if (NR == 0) print '"${CPPI_BUDGET:-30}"' }'
  rm -f "$TMPDIR/llvmi-budget.$$.err"
}
# run1 ID EXE [ARG...]: one run in a scratch directory (empty stdin, 10 s; a program run_budget names: bin/cppi check's run, its CPU
# seconds under bin/lib/cppi/runprog.bash's cppi_run_prog, its own memory cap and no inherited GOMEMLIMIT): ID STATUS OUT-SHA
# OUT-BYTES ERR-SHA ERR-BYTES ERR-FIRST
run1() {
  local id=$1 rd st b; shift
  rd=$(mktemp -d "$TMPDIR/llvmi-run.XXXXXX")
  : > "$rd/in"
  b=$(run_budget "$id")
  if [ -n "$b" ]; then
    . "$root/bin/lib/cppi/runprog.bash"
    (cd "$rd" && cppi_run_prog "$b" 0 "$rd/st" "$@" < in > out 2> err); st=$(cat "$rd/st")
  else
    { (cd "$rd" && timeout 10 "$@" < in > out 2> err); } 2> "$rd/sh"; st=$?
  fi
  [ $st = 124 ] && st=timeout
  [ -n "${LLVMI_RUN_OUT:-}" ] && head -c 65536 "$rd/out" > "$LLVMI_RUN_OUT/$id.out"  # the own verdicts' CHECK lines read it
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$st" "$(sha256sum < "$rd/out" | cut -d' ' -f1)" "$(wc -c < "$rd/out")" \
    "$(sha256sum < "$rd/err" | cut -d' ' -f1)" "$(wc -c < "$rd/err")" "$(head -1 "$rd/err" | cut -c1-200 | tr '\t' ' ')"
  rm -rf "$rd"
}
# run_args ID: the program's arguments its own verdict's RUN lines give (WORK/args.tsv, arbace.llvm.check run-args: `%lli %s test`),
# none for a module without (lli's record ran every module with none); queue 358
run_args() { [ -n "${LLVMI_ARGS:-}" ] && [ -f "$LLVMI_ARGS" ] && awk -F'\t' -v i="$1" '$1 == i { print $2; exit }' "$LLVMI_ARGS"; return 0; }
export -f run1 run_budget run_args; export root

# musl_prepare: ci's libc (bin/ci musl prepare) without a compiler. ci's prepare configures musl with the host's gcc
# (CC=gcc ./configure) when its tree is absent; llvmi makes configure's products first as musl's Makefile makes them
# (sed over arch/x86_64's .in files: obj/include/bits/alltypes.h, syscall.h; tools/version.sh's VERSION: version.h) with
# config.mak's ARCH, the only line ci reads, so no toolchain runs in llvmi's check (doc/llvm/LLVM-CROP-SURVEY.md, "As built:
# LL9a"); C's own prepare does the same since the C crop's target (c/README.md) and then takes over
musl_prepare() {
  local d=$root/.tmp/ci-musl m=$root/.tmp/ci-musl/musl-1.2.6 tb sum c1
  if ! { [ -f "$m/obj/include/bits/alltypes.h" ] && [ -f "$d/ldbl53/bits/float.h" ] && [ -f "$m/config.mak" ] && grep -qx 'ARCH = x86_64' "$m/config.mak"; }; then
    sum=$(sed -n '/:musl-1.2.6/,/:top/s/^ *:sha256 "\(.*\)"/\1/p' "$root/test/c/corpora.edn")
    tb=${CI_MUSL_TARBALL:-$d/musl-1.2.6.tar.gz}; c1=$main/.tmp/c1/musl/musl-1.2.6.tar.gz
    [ -f "$tb" ] || tb=$c1
    [ -f "$tb" ] || { echo "llvmi: no musl tarball ($d/musl-1.2.6.tar.gz or $c1): bin/ci musl prepare fetches it" >&2; return 1; }
    echo "$sum  $tb" | sha256sum -c --quiet || { echo "llvmi: $tb does not match the pin" >&2; return 1; }
    mkdir -p "$d"; rm -rf "$m"; tar -xzf "$tb" -C "$d" || return 1
    mkdir -p "$m/obj/include/bits" "$m/obj/src/internal"
    (cd "$m" && sed -f tools/mkalltypes.sed arch/x86_64/bits/alltypes.h.in include/alltypes.h.in > obj/include/bits/alltypes.h \
       && cp arch/x86_64/bits/syscall.h.in obj/include/bits/syscall.h \
       && sed -n -e s/__NR_/SYS_/p < arch/x86_64/bits/syscall.h.in >> obj/include/bits/syscall.h \
       && printf '#define VERSION "%s"\n' "$(cat VERSION)" > obj/src/internal/version.h \
       && printf '# written by bin/llvmi (musl_prepare): configure'"'"'s products for --target=x86_64 with no compiler probed\nARCH = x86_64\nsrcdir = .\n' > config.mak) || return 1
    mkdir -p "$d/ldbl53/bits"; cp "$m/arch/arm/bits/float.h" "$d/ldbl53/bits/float.h"
    echo "llvmi: musl's configure products derived without a compiler in $m"
  fi
  "$root/bin/ci" musl prepare
}

# llvm-eh (doc/llvm/LLVM-CROP-SURVEY.md, "As built: llvm-eh"): a module that unwinds (arbace.llvm.run's :eh, its C lowered as C++'s
# check route lowers a program) is linked with C++'s lowered runtime, bin/cppi runtime-ci's library (libsupc++, libstdc++ and the
# pending-flag layer arbace/cpp/rt/eh.c.ae, lowered from the recorded IR pack cpp-runtime-ir: no clang, no gcc; built when stale,
# LLVMI_CPP_RUNTIME names another), and musl's forms by arbace.cpp.run, then run by ci's back end (tools/cirun)
eh_rtlib() {
  [ -n "${eh_rt:-}" ] && { echo "$eh_rt"; return 0; }
  # LLVMI_CPP_RTLIB: a library read already (a directory of bin/cppi runtime-ci's, used as it is, its key unchecked: by hand)
  [ -n "${LLVMI_CPP_RTLIB:-}" ] && { eh_rt=$LLVMI_CPP_RTLIB; echo "$eh_rt"; return 0; }
  eh_rt=$(CPPI_RUNTIME=${LLVMI_CPP_RUNTIME:-${CPPI_RUNTIME:-}} "$root/bin/cppi" runtime-ci 2> "$TMPDIR/llvmi-rt.$$.log") || { cat "$TMPDIR/llvmi-rt.$$.log" >&2; rm -f "$TMPDIR/llvmi-rt.$$.log"; return 1; }
  rm -f "$TMPDIR/llvmi-rt.$$.log"; echo "$eh_rt"
}
eh_cirun() {
  local c=${CIRUN:-$root/.tmp/ci/cirun}
  { [ -n "${CIRUN:-}" ] && [ -x "$c" ]; } || "$root/bin/ci" cirun-build --ensure > "$TMPDIR/llvmi-cirun.$$.log" 2>&1 || { cat "$TMPDIR/llvmi-cirun.$$.log" >&2; return 1; }
  rm -f "$TMPDIR/llvmi-cirun.$$.log"; echo "$c"
}
eh_link() { # eh_link C NODES: the lowered C of a module that unwinds linked with the runtime into a node program
  local rt; rt=$(eh_rtlib) || return 1
  . "$root/bin/lib/crops/musl-hold.bash"; ci_musl_hold >&2 || return 1
  (cd "$root" && GOMEMLIMIT=${LLVMI_EH_MEMLIMIT:-2GiB} tool -m arbace.cpp.run nodes "$rt" "" "$2" "$1") >&2
  [ -f "$2" ]
}

# c_refresh (ir-make c --stale): the pack c with the modules whose checkout source's digest is not the manifest's compiled again (the
# corpus' own clang command, as modules does), every other module's IR the pack's; the manifest's lines in their order
c_refresh() {
  local w=$root/.tmp/llvmi/ir-make/c-stale n lab sh h p o f ids=""
  [ -f "$irdir/c.tar.xz" ] || { echo "llvmi ir-make c --stale: no $irdir/c.tar.xz" >&2; return 1; }
  (cd "$irdir" && sha256sum -c --quiet c.tar.xz.sha256) >&2 || { echo "llvmi ir-make c --stale: c.tar.xz does not match its pin" >&2; return 1; }
  rm -rf "$w"; mkdir -p "$w/stage"; xz -dc "$irdir/c.tar.xz" | tar -xf - -C "$w/stage" || return 1
  while IFS=$'\t' read -r n lab sh h; do
    f=${lab#checkout:}
    if [ "$f" != "$lab" ] && [ -f "$root/$f" ] && [ "$(sha256sum < "$root/$f" | cut -d' ' -f1)" != "$sh" ]; then
      case $n in
        c-O0.*|c-O2.*) o=${n%%.*}; o=${o#c-}
          (cd "$root" && clang -$o -S -emit-llvm -std=gnu23 -w -I test/c/synth -ffile-prefix-map="$root/"= -o "$w/stage/$n.ll" "$f") || return 1 ;;
        cpp.*) (cd "$root" && clang++ -O0 -S -emit-llvm -std=c++23 -w -ffile-prefix-map="$root/"= -o "$w/stage/$n.ll" "$f") || return 1 ;;
        *) echo "llvmi ir-make c --stale: $n: no corpus" >&2; return 1 ;;
      esac
      sh=$(sha256sum < "$root/$f" | cut -d' ' -f1); h=$(sha256sum < "$w/stage/$n.ll" | cut -d' ' -f1); ids="$ids $n"
    fi
    printf '%s\t%s\t%s\t%s\n' "$n" "$lab" "$sh" "$h"
  done < "$irdir/c.tsv" > "$w/c.tsv"
  [ -n "$ids" ] || { echo "llvmi ir-make c --stale: no module's source changed"; return 0; }
  mv "$w/c.tsv" "$irdir/c.tsv"
  (cd "$w/stage" && LC_ALL=C tar --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner --format=gnu -cf - .) | xz -9e -T1 > "$irdir/c.tar.xz"
  (cd "$irdir" && sha256sum c.tar.xz > c.tar.xz.sha256)
  { grep -v '^refreshed' "$irdir/c.cmd"; echo "refreshed (bin/llvmi ir-make c --stale, $(clang --version | head -1)):$ids"; } > "$w/c.cmd"; mv "$w/c.cmd" "$irdir/c.cmd"
  echo "llvmi ir-make c --stale: $(echo $ids | wc -w) modules compiled again:$ids"
  rm -rf "$w"
}

cmd=${1:-}; [ $# -gt 0 ] && shift
# the checkout's ci, not the host's embedded copy of an older one: the lowered C is checked and built by arbace.c's builder on the
# tools' host, and RT.toolSource evaluates a ci namespace that differs from the embedded copy (CS281 (a), since W2's re-seed;
# bin/lib/ci/fresh.bash before it, llvm-compl2 2026-11-10, retired by W's R)
case $cmd in
  lower)
    f=$1 o=${3:-${1%.ll}.c}
    [ "${2:-}" = -o ] || o=${1%.ll}.c
    tool -m arbace.llvm.run lower "$(cd "$(dirname "$f")" && pwd)/$(basename "$f")" "$(cd "$(dirname "$o")" && pwd)/$(basename "$o")" ;;
  run)
    f=$(cd "$(dirname "$1")" && pwd)/$(basename "$1"); shift
    [ "${1:-}" = -- ] && shift
    c=$TMPDIR/llvmi-$$-$(basename "$f" .ll).c
    tool -m arbace.llvm.run lower "$f" "$c" || exit $?
    if [ -f "$c.eh" ]; then
      # llvm-eh: a module that unwinds, linked with C++'s lowered runtime (eh_link), its exceptions the pending flag's on ci
      eh_link "$c" "$c.nodes" || { rm -f "$c" "$c.eh"; exit 1; }
      "$(eh_cirun)" "$c.nodes" "$@"; st=$?
      rm -f "$c" "$c.eh" "$c.nodes"; exit $st
    fi
    "$root/bin/ci" run "$c" -- "$@"; st=$?
    rm -f "$c"; exit $st ;;
  modules)
    corpora=$all_corpora
    [ "${1:-}" = --corpus ] && { corpora=$2; shift 2; }
    work=${1:-$root/.tmp/llvmi/modules}
    modules "$work" "$corpora"; echo "llvmi: $(wc -l < "$work/modules.tsv") modules in $work/modules.tsv" ;;
  ir-make)
    # the packs made afresh by clang (the pin's: clang 23.1.5) into test/llvm/ir/: the IR, its manifest, its command
    [ $# -gt 0 ] || set -- tx c
    mkdir -p "$irdir"
    if [ "$1" = rt ]; then shift; rt_make "$@"; exit; fi
    if [ "$1" = c ] && [ "${2:-}" = --stale ]; then c_refresh; exit; fi
    for pk in "$@"; do
      case $pk in tx) cs=tx-O0,tx-O2 ;; c) cs=c-O0,c-O2,cpp ;; *) echo "llvmi ir-make: no pack $pk (tx, c; rt alone: bin/llvmi ir-make rt [--mutants])" >&2; exit 2 ;; esac
      w=$root/.tmp/llvmi/ir-make/$pk
      rm -rf "$w"; mkdir -p "$w/stage"
      corp=$cs  # (modules makes cs its array: the command's line names the pack's corpora, not the first, LLS54)
      LLVMI_CLANG=1 modules "$w" "$cs"
      awk -F'\t' 'FILENAME == ARGV[1] { s[$1] = $2; p[$1] = $3; next } { print $1 "\t" s[$1] "\t" p[$1] "\t" $3 "\t" $2 }' "$w/sources.tsv" "$w/modules.tsv" |
        while IFS=$'\t' read -r n lab sp h f; do
          cp "$f" "$w/stage/$n.ll"
          printf '%s\t%s\t%s\t%s\n' "$n" "$lab" "$(sha256sum < "$sp" | cut -d' ' -f1)" "$h"
        done > "$irdir/$pk.tsv"
      (cd "$w/stage" && LC_ALL=C tar --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner --format=gnu -cf - .) | xz -9e -T1 > "$irdir/$pk.tar.xz"
      (cd "$irdir" && sha256sum "$pk.tar.xz" > "$pk.tar.xz.sha256")
      { echo ";; the pack $pk's IR (bin/llvmi ir-make $pk; doc/llvm/LLVM-CROP-SURVEY.md, \"Decided (2026-11-06, the user: the torture corpora's IR pinned)\")"
        echo "clang: $(clang --version | head -1)"
        echo "corpora: $corp"
        echo "c-O0, c-O2: clang -O0|-O2 -S -emit-llvm -std=gnu23 -w -I test/c/synth -ffile-prefix-map=ROOT/= test/c/{synth,run}/*.c"
        echo "tx-O0, tx-O2: clang -O0|-O2 -S -emit-llvm -std=gnu17 -w -fno-strict-aliasing $tx_flags DG -ffile-prefix-map=TX/= {*,ieee/*}.c (TX: $(echo "$tx" | sed 's|^.*/pkg/mod/||'); DG: the test's dg-options and dg-additional-options as bin/llvmi's tx_dg_options selects them, LLS54 (a))"
        [ ! -s "$w/dg-options.tsv" ] || { echo "dg-options (ID, the options added):"; LC_ALL=C sort "$w/dg-options.tsv" | sed 's/^/  /'; }
        echo "cpp: clang++ -O0 -S -emit-llvm -std=c++23 -w -ffile-prefix-map=ROOT/= test/cpp/{samples,runtime/samples}/*.cpp"
        echo "modules: a file clang refuses, or without a main, is not one; the manifest $pk.tsv: ID, SOURCE, SOURCE-SHA256, IR-SHA256"; } > "$irdir/$pk.cmd"
      echo "llvmi ir-make: $pk: $(wc -l < "$irdir/$pk.tsv") modules, $(wc -c < "$irdir/$pk.tar.xz") bytes"
    done ;;
  rt-list)
    # rt-list [RECORD]: test/llvm/rt-builds.tsv written from the first records' ids (test/llvm/check-roundtrip-rt-linux-amd64.edn): the
    # suffix gives the build, the name the source; the hand-written hw-* are committed (test/llvm/hw.list), the 21 corners dropped
    from=${1:-$root/test/llvm/check-roundtrip-rt-linux-amd64.edn}
    # gcc 15.2.0's torture programs: the pinned tarball's names (tar -t) under gcc.c-torture/execute
    t=${REPR_CPP_GCC_TARBALL:-$main/.tmp/c1/gcc/gcc-15.2.0.tar.xz} gl=$root/.tmp/llvmi/rt-gcc15.names
    [ -f "$t" ] || { echo "llvmi rt-list: no $t (gcc 15.2.0's tarball, test/c/corpora.edn's :gcc-15.2.0)" >&2; exit 1; }
    mkdir -p "$root/.tmp/llvmi"; tar -tJf "$t" --wildcards 'gcc-15.2.0/gcc/testsuite/gcc.c-torture/execute/*.c' > "$gl" || exit 1
    grep -o '^\["[^"]*"' "$from" | sed 's/^\["//; s/"$//' | while read -r id; do
      n=${id%.*} b=${id##*.}
      case $id in
        hw-*) ;;
        stress[0-9]*) printf '%s\tllvm-stress:%s\tstress\n' "$id" "${id#stress}" ;;
        rs.g0|rs.g2|rs.lt) printf '%s\tcheckout:test/rust/sample/shapes.rs\t%s\n' "$id" "$b" ;;
        *.g0|*.g2|*.o2|*.lto|*.win|*.mac)
          if [ -f "$root/test/cpp/samples/$n.cpp" ]; then printf '%s\tcheckout:test/cpp/samples/%s.cpp\t%s\n' "$id" "$n" "$b"
          elif grep -qxF "gcc-15.2.0/gcc/testsuite/gcc.c-torture/execute/$n.c" "$gl"; then printf '%s\tgcc15:%s.c\t%s\n' "$id" "$n" "$b"
          else echo "llvmi rt-list: no source for $id" >&2; fi ;;
        *) echo "llvmi rt-list: $id dropped (a corner module, its source lost)" >&2 ;;
      esac
    done | LC_ALL=C sort > "$rt_builds.new"
    { echo "# the pack rt's modules (bin/llvmi rt-list from ${from#$root/}; bin/llvmi ir-make rt): ID, SOURCE, BUILD"; cat "$rt_builds.new"; } > "$rt_builds"
    rm -f "$rt_builds.new"
    echo "llvmi rt-list: $(grep -vc '^#' "$rt_builds") modules in ${rt_builds#$root/}" ;;
  record-ref)
    corpora=$all_corpora only=
    while [ $# -gt 0 ]; do
      case $1 in --corpus) corpora=$2; shift 2 ;; --only) only=$(cd "$(dirname "$2")" && pwd)/$(basename "$2"); shift 2 ;; *) echo "llvmi record-ref: $1?" >&2; exit 2 ;; esac
    done
    work=$root/.tmp/llvmi/ref
    rm -rf "$work"; only_ids=$only modules "$work" "$corpora"; only_filter "$work" "$only"
    cut -f1,2 "$work/modules.tsv" | tr '\t' '\n' | xargs -d '\n' -n 2 -P "$jobs" bash -c 'run1 "$1" '"$lli"' "$2"' _ > "$work/lli.tsv"
    "$lli" --version | grep -m1 -i 'version' > "$work/lli.version"
    # the second opinion (LLS8 (a)'s reference): the same module built by clang 23 -O0 and run; recorded as whether it agrees with lli
    mkdir -p "$work/native"
    cut -f1,2 "$work/modules.tsv" | tr '\t' '\n' | xargs -d '\n' -n 2 -P "$jobs" bash -c \
      'if clang -O0 -w "$2" -o "'"$work"'/native/$1" -lm > "'"$work"'/native/$1.log" 2>&1; then run1 "$1" "'"$work"'/native/$1"; else printf "%s\tno-build\t\t0\t\t0\t\n" "$1"; fi' _ > "$work/clang.tsv"
    LLVM_BIN=$llvm_bin tool -m arbace.llvm.check record-ref "$work" "$ref" ${only:+--only} ;;
  check)
    aot= corpora=$all_corpora only= record= judge=
    while [ $# -gt 0 ]; do
      case $1 in
        --aot) aot=1; shift ;;
        --corpus) corpora=$2; shift 2 ;;
        --only) only=$(cd "$(dirname "$2")" && pwd)/$(basename "$2"); shift 2 ;;
        --essential) only=$root/test/llvm/essential-check.txt; shift ;;
        --record) record=1; shift ;;
        --judge) judge=1; shift ;;
        *) sed -n '24,34p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
      esac
    done
    level=eval; [ -n "$aot" ] && level=aot
    work=${LLVMI_WORK:-$root/.tmp/llvmi/$level}
    if [ -z "$judge" ]; then
      rm -rf "$work"; mkdir -p "$work"
      only_ids=$only modules "$work" "$corpora"; only_filter "$work" "$only"
      if [ -n "$only" ] || [ "$corpora" != "$all_corpora" ]; then echo "${only:-all} $corpora" > "$work/subset"; fi
      tool -m arbace.llvm.check run-args "$work/modules.tsv" > "$work/args.tsv" || exit 1
      export LLVMI_ARGS=$work/args.tsv
      musl_prepare > "$work/musl.log" 2>&1 || { cat "$work/musl.log" >&2; exit 1; }
      c_sysroot >> "$work/musl.log" 2>&1 || { cat "$work/musl.log" >&2; exit 1; }
      # (review 300's finding 2: the shared lock is bin/lib/crops/musl-hold.bash's ci_musl_hold, every reader's of the cache)
      # musl's forms cache (.tmp/ci-musl/forms) is ci's: read by `bin/ci musl read` under an exclusive flock on FORMS.lock, which
      # removes and rereads it when its key moves. Gate 13c (2026-11-14 11:17) ran llvm-controls-test while a C step reread it, and
      # llvmi's index found no forms ("no build line" for every module). So: ensure it fresh first (a read under ci's lock when
      # stale, else nothing), then hold a shared lock on FORMS.lock for the run, so no reader removes it underneath.
      . "$root/bin/lib/crops/musl-hold.bash"; ci_musl_hold >> "$work/musl.log" 2>&1 || { cat "$work/musl.log" >&2; exit 1; }
      mkdir -p "$work/out"; export LLVMI_RUN_OUT=$work/out
      t0=$(date +%s)
      tool -m arbace.llvm.run lower-list "$work/modules.tsv" "$work/c" "$threads"
      t1=$(date +%s)
      awk -F'\t' '$2 == "ok" && $3 != "eh" {print $1 "\t'"$work"'/c\tgnu23\t\t" $1 ".c"}' "$work/c/lower.tsv" > "$work/build.list"
      # llvm-eh: the modules that unwind, linked with C++'s lowered runtime by arbace.cpp.run (ID LOWERED.C EXTRA-LIB)
      awk -F'\t' '$2 == "ok" && $3 == "eh" {print $1 "\t'"$work"'/c/" $1 ".c\t"}' "$work/c/lower.tsv" > "$work/build-eh.list"
      if [ -s "$work/build-eh.list" ]; then rtlib=$(eh_rtlib) || exit 1; fi
      # AOT's heavy modules (test/llvm/aot-heavy.txt: Go's compiler above 2 GiB on their package) only with LLVMI_AOT_HEAVY=1 (the night's);
      # else not built, their rows kept from the record (WORK/kept.txt)
      if [ -n "$aot" ] && [ -z "${LLVMI_AOT_HEAVY:-}" ]; then
        grep -v '^#' "$root/test/llvm/aot-heavy.txt" | grep . > "$work/kept.txt" || true
        for bl in build build-eh; do
          awk -F'\t' 'FILENAME == ARGV[1] { k[$1] = 1; next } !($1 in k)' "$work/kept.txt" "$work/$bl.list" > "$work/$bl.list.new"
          mv "$work/$bl.list.new" "$work/$bl.list"
        done
      fi
      if [ -z "$aot" ]; then
        { [ -n "${CIRUN:-}" ] && [ -x "$CIRUN" ]; } || "$root/bin/ci" cirun-build --ensure > "$work/cirun-build.log" 2>&1 || { cat "$work/cirun-build.log" >&2; exit 1; }
        cirun=${CIRUN:-$root/.tmp/ci/cirun}
        mkdir -p "$work/nodes"
        tool -m arbace.c.run "$ARBACE_C_HOST" nodes-list "$work/nodes" "$work/build.list" "$threads" > "$work/nodes.log" 2>&1
        cp "$work/nodes/nodes.tsv" "$work/build.tsv" 2>/dev/null || : > "$work/build.tsv"
        if [ -s "$work/build-eh.list" ]; then
          mkdir -p "$work/nodes-eh"; . "$root/bin/lib/crops/musl-hold.bash"; ci_musl_hold > "$work/nodes-eh.log" 2>&1
          GOMEMLIMIT=${LLVMI_EH_MEMLIMIT:-2GiB} tool -m arbace.cpp.run nodes-list "$work/nodes-eh" "$work/build-eh.list" "$rtlib" "$threads" >> "$work/nodes-eh.log" 2>&1
          [ -f "$work/nodes-eh/nodes.tsv" ] && grep . "$work/nodes-eh/nodes.tsv" >> "$work/build.tsv"
          # (a node program kept under its build's directory: the run below finds it by the directory of its list)
          awk -F'\t' '$2 == "ok" {print $1}' "$work/nodes-eh/nodes.tsv" 2>"$TMPDIR/llvmi-eh.err" > "$work/run-eh.ids" || : > "$work/run-eh.ids"
        fi
        t2=$(date +%s)
        awk -F'\t' '$2 == "ok" {print $1}' "$work/nodes/nodes.tsv" 2>"$TMPDIR/llvmi-nodes.err" | xargs -d '\n' -P "$jobs" -I{} bash -c 'run1 "$1" '"$cirun"' "$2/$1.nodes" $(run_args "$1")' _ {} "$work/nodes" > "$work/run.tsv"
        [ -s "$work/run-eh.ids" ] && xargs -d '\n' -P "$jobs" -I{} bash -c 'run1 "$1" '"$cirun"' "$2/$1.nodes" $(run_args "$1")' _ {} "$work/nodes-eh" < "$work/run-eh.ids" >> "$work/run.tsv"
      else
        go=${ARBACE_GOROOT:-/root/tamago-go}/bin/go
        mod=$work/mod
        # the prebuilt libraries' cache (RES34, RES40 (a)): CI_AOT_LIB, else the main checkout's .tmp/ci-aot-lib, as bin/lib/ci/check-aot
        export CI_AOT_LIB=${CI_AOT_LIB:-${root%%/.tmp/worktrees/*}/.tmp/ci-aot-lib}
        "$root/bin/ci" cirun-build --ensure > "$work/cirun-build.log" 2>&1 || { cat "$work/cirun-build.log" >&2; exit 1; }
        : > "$work/build.tsv"; : > "$work/run.tsv"; : > "$work/go-errors.tsv"
        split -l "${LLVMI_SHARD:-40}" -d -a 3 "$work/build.list" "$work/shard."
        # llvm-eh: the modules that unwind in shards of their own, compiled with C++'s runtime by arbace.cpp.run's compile-list
        [ -s "$work/build-eh.list" ] && split -l "${LLVMI_SHARD:-40}" -d -a 3 "$work/build-eh.list" "$work/shard.eh"
        for s in "$work"/shard.[0-9][0-9][0-9] "$work"/shard.eh[0-9][0-9][0-9]; do
          [ -f "$s" ] || continue
          rm -rf "$mod"; mkdir -p "$mod/progs" "$mod/shard"
          cp -r "$root/.tmp/ci/go/ci" "$root/.tmp/ci/go/crt" "$mod/"
          printf 'module arbace\n\ngo 1.27\n' > "$mod/go.mod"
          # cf2g's prebuilt libraries' units (RES34) as arbace/cilib/..., bin/lib/ci/check-aot's module: without the link every
          # program importing musl's units fails to build (llvm-compl2, 2026-11-10)
          mkdir -p "$CI_AOT_LIB"; ln -sfn "$CI_AOT_LIB" "$mod/cilib"
          awk -F'\t' '{ print $0 "\tp" NR }' "$s" > "$s.list"
          case $s in
            */shard.eh*) GOMEMLIMIT=${LLVMI_EH_MEMLIMIT:-2GiB} tool -m arbace.cpp.run compile-list "$mod" "$s.list" "$rtlib" "$threads" > "$s.compile.log" 2>&1 ;;
            *) tool -m arbace.c.cf2g compile-list "$ARBACE_C_HOST" "$mod" "$s.list" "$threads" > "$s.compile.log" 2>&1 ;;
          esac
          [ -f "$mod/nodes.tsv" ] && grep . "$mod/nodes.tsv" >> "$work/build.tsv"
          # the package is the list's last column (pN, appended above): the sixth of a C shard's six, the fourth of an llvm-eh
          # shard's (ID LOWERED.C EXTRA-LIB pN; queue 358: $6 was empty there, so no eh shard ever built: "arbace/progs/": trailing slash)
          awk -F'\t' 'FILENAME == ARGV[1] { if ($2 == "ok") ok[$1] = 1; next } ($1 in ok) { print $1 "\t" $NF }' "$mod/nodes.tsv" "$s.list" > "$s.built"
          [ -s "$s.built" ] || continue
          gen_main() {
            { echo 'package main'; echo; echo 'import ('; echo '	"os"'
              cut -f2 "$s.built" | while read -r p; do echo "	$p \"arbace/progs/$p\""; done
              echo ')'; echo; echo 'func main() {'; echo '	switch os.Args[1] {'
              cut -f2 "$s.built" | while read -r p; do echo "	case \"$p\":"; echo "		$p.Main(os.Args[2:])"; done
              echo '	}'; echo '	println("llvmi aot: internal: no package", os.Args[1])'; echo '	os.Exit(70)'; echo '}'; } > "$mod/shard/main.go"
          }
          gen_main
          gb() { (cd "$mod" && CGO_ENABLED=0 GOFLAGS=-mod=mod GOCACHE=${LLVMI_GOCACHE:-$root/.tmp/gocache} GOMAXPROCS=4 "$go" build -p 2 -trimpath "$@"); }
          if ! gb -o "$work/shard.exe" ./shard > "$s.build.log" 2>&1; then
            # each package alone: those whose Go does not compile taken out
            cut -f2 "$s.built" | while read -r p; do
              if ! gb -o "$work/pkg.a" "./progs/$p" > "$s.$p.log" 2>&1; then
                i=$(awk -F'\t' -v p="$p" '$2 == p {print $1}' "$s.built")
                printf '%s\t%s\n' "$i" "$(grep -m1 'prog.go' "$s.$p.log" | cut -c1-200 | tr '\t' ' ')" >> "$work/go-errors.tsv"
              fi
              rm -f "$work/pkg.a" "$s.$p.log"
            done
            awk -F'\t' 'FILENAME == ARGV[1] { bad[$1] = 1; next } !($1 in bad)' "$work/go-errors.tsv" "$s.built" > "$s.built.new" && mv "$s.built.new" "$s.built"
            gen_main
            [ -s "$s.built" ] && gb -o "$work/shard.exe" ./shard >> "$s.build.log" 2>&1
          fi
          [ -x "$work/shard.exe" ] && awk -F'\t' '{print $1 "\n" $2}' "$s.built" | xargs -d '\n' -n 2 -P "$jobs" bash -c 'run1 "$1" '"$work"'/shard.exe "$2" $(run_args "$1")' _ >> "$work/run.tsv"
          rm -rf "$work/shard.exe" "$mod"
          echo "llvmi aot: $(basename "$s"): $(wc -l < "$s") programs, $(wc -l < "$s.built") built"
        done
        t2=$(date +%s)
      fi
      t3=$(date +%s)
      printf 'lower %s\nbuild %s\nrun %s\n' "$((t1 - t0))" "$((t2 - t1))" "$((t3 - t2))" > "$work/seconds"
    fi
    rec=$root/test/llvm/check-$level-linux-amd64.edn
    tool -m arbace.llvm.check judge "$work" "$level" "$ref" "$rec" "${LLVMI_CONTROLS:-$root/test/llvm/controls.edn}" ${record:+--record} ;;
  divergences)
    level=eval; [ "${1:-}" = --aot ] && level=aot
    tool -m arbace.llvm.check divergences "$level" "$root/test/llvm/check-$level-linux-amd64.edn" ;;
  *) sed -n '2,34p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac

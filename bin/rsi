#!/bin/bash
# rsi, Rust's eval (doc/rust/EVAL.md; doc/rust/RUST-EVAL-SURVEY.md, RES1 (b), "As built: RE1-RE2"): the oracle (rustc 1.99.1
# -O0) compiles a Rust program to LLVM IR, repr/llvm reads it as LLVM forms (arbace.repr.llvm) and the lowering
# (arbace.cpp.lower, C++'s; RES16's rename to arbace.llvm.lower after C++'s CX8) lowers them to C forms, printed as C by repr/c.
# Until RE3 lowers std and RE4 runs ci, the program is linked with the host's native std (the native-std leg, EVAL.md §4) and
# gcc -O0 is the second judge; the original is RR5's run-program's build and run (bin/lib/repr-rust/run-program). All of it on
# the tools' host (stage 0, evaluated from the checkout); the light tier by default (RSI_JOBS 4).
#
#   bin/rsi lower FILE.ll [-o OUT.c] [--native-std]
#                               FILE's IR lowered to C forms and printed as C (default FILE.c); --native-std: the native-std
#                               leg's substitution (__rust_try called as the native cx_rust_try)
#   bin/rsi list [--set all|run|threads|process|net|samples] [--sample N [--offset K]] [--only REGEX] [-o PLAN]
#                               the UI suite's programs (test/rust/corpus-rustc-1.99.1-ui.edn's :programs, RR5) as
#                               run-program's plan (default the standard output): the set (EVAL.md §6,
#                               test/rust/eval-programs.edn: threads, process and net set apart; run: the rest; default all),
#                               every Nth line from the Kth (default 1, 0), those whose id REGEX finds; samples, synthetic: rsi's own (test/rust/eval/, test/rust/synthetic/,
#                               built from the checkout)
#   bin/rsi sets                test/rust/eval-programs.edn made again: each program's file searched for threads, processes and
#                               sockets (the source tree of the corpus fetched by bin/repr-rust corpus fetch rustc-1.99.1-ui)
#   bin/rsi std-build [--update] [--jobs N]
#                               std's sysroot with its IR (RES3 (a), RES17 (b), EVAL.md §3; test/rust/runtime/std.edn: the oracle's
#                               and the assembler's versions, the profile, the per-package overrides, the flags, the package and
#                               its features): rust-src's library/ (the pinned apk, bin/repr-rust corpus fetch) mirrored into
#                               .tmp/rsi/std/ (RSI_STD_DIR: any place gives the same IR) and built as rust's bootstrap builds it,
#                               Cargo on library/'s own workspace offline (the vendored crates by source replacement), each codegen
#                               unit's bitcode made IR text (ir/CRATE/UNIT.ll) and its digest checked against
#                               test/rust/runtime/ir.sha256 (--update rewrites it); the sysroot beside it (sysroot/)
#   bin/rsi runtime-build [OUT] [--jobs N]
#                               std's IR lowered (RE3, EVAL.md §8): std-build first when its IR is not at the pin; each unit of
#                               std's crates but compiler_builtins (native, as libgcc) read, round-tripped through LLVM forms (the
#                               objects equal), given the runtime's pre-pass (arbace.rust.lower's runtime-forms: std_detect's cpuid
#                               and xgetbv answered, the functions the lowering does not take made stubs, OUT/stubbed.tsv), lowered,
#                               compiled by gcc -O0 and archived by crate (OUT/lib/libCRATE.a), the pending-flag layer
#                               (arbace/rust/rt/eh.c.ae) as OUT/rt.o; OUT/results.tsv, OUT/key (default OUT .tmp/rsi/runtime)
#   bin/rsi synthetic [generate|check|ref]
#                               RE5: the synthetic corpus (test/rust/synthetic/) generated from test/rust/synthetic.edn and
#                               test/rust/synthetic-templates/; check: the committed files are what they give; ref: the table's
#                               expected statuses against the judge's runs (test/rust/ref-rustc-1.99.1.edn)
#   bin/rsi judge-test          RE5: the check's judge without ci (the samples and the synthetic corpus judged from the judge's own
#                               runs, one output changed, the controls)
#   bin/rsi lower-unit [FILE.ll...]
#                               the lowering's unit cases (default test/rust/lower/*.ll): each IR run by lli (LLI, default
#                               /usr/lib/llvm23/bin/lli) and lowered, compiled by gcc -O0 with the pending-flag layer and run,
#                               the outputs and statuses equal
#   bin/rsi lower-check PLAN WORK [--jobs N] [--record] [--leg lowered|native] [--runtime OUT]
#                               each program of PLAN built and run by run-program from the original (rustc) and from its
#                               lowered IR (bin/lib/rsi/wrap, bin/lib/rsi/link: the IR, its round trip through LLVM forms, the
#                               lowering, gcc -O0, the original's link with the gcc objects in place of rustc's), the status,
#                               stdout and stderr compared; judged by arbace.rust.check against test/rust/divergences-lower.edn
#                               (every program that does not pass in a class) into WORK/results.tsv and WORK/summary.edn;
#                               --record: WORK's results into test/rust/lower-std-results.edn (by id; other ids kept); the leg
#                               (RE3) lowered: both sides compiled against std's build (std-build's sysroot), the lowered side linked
#                               with the lowered std (runtime-build first when OUT is not at the checkout's key); native: RE2's
#                               native-std leg (the host's sysroot, its record test/rust/lower-results.edn)
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash"
. "$root/bin/lib/tools.bash"
. "$root/test/oracle-records/oracle.bash"
export GOMAXPROCS=${GOMAXPROCS:-4} GOMEMLIMIT=${GOMEMLIMIT:-1500MiB}
corpus=$root/test/rust/corpus-rustc-1.99.1-ui.edn
srcroot=$root/.tmp/repr-rust/src/rustc-1.99.1-src
GCC_FLAGS="-std=gnu23 -O0 -w -fno-builtin -fno-strict-aliasing -ffp-contract=off"

need_src() {
  [ -d "$srcroot/tests/ui" ] || { echo "rsi: no $srcroot/tests/ui (bin/repr-rust corpus fetch rustc-1.99.1-ui)" >&2; exit 1; }
}

list() {
  local set=all n=1 off=0 only="" out=""
  while [ $# -gt 0 ]; do case $1 in --set) set=$2; shift 2 ;; --sample) n=$2; shift 2 ;; --offset) off=$2; shift 2 ;; --only) only=$2; shift 2 ;; -o) out=$2; shift 2 ;;
    *) echo "list: unknown option $1" >&2; exit 2 ;; esac; done
  [ -z "$out" ] || mkdir -p "$(dirname "$out")"
  if [ "$set" = samples ] || [ "$set" = synthetic ]; then # rsi's own programs (test/rust/eval/*.rs, test/rust/synthetic/*.rs: edition 2021, built from the checkout)
    local f dir=eval us=$'\x1f' text=""
    [ "$set" = synthetic ] && dir=synthetic
    for f in "$root"/test/rust/$dir/*.rs; do
      [ -f "$f" ] || continue
      f=test/rust/$dir/$(basename "$f"); text+="$f$us$f${us}2021$us$us$us$us"$'\n'
    done
    if [ -n "$out" ]; then printf '%s' "$text" > "$out"; else printf '%s' "$text"; fi
    return 0
  fi
  local tmp; tmp=$(mktemp "$TMPDIR/rsi-plan.XXXXXX")
  GOMEMLIMIT=1GiB arbace_tool -m arbace.repr.rust run-plan --corpus "$corpus" -o "$tmp" ${only:+--only "$only"}
  GOMEMLIMIT=1GiB arbace_tool -m arbace.rust.check plan-set "$tmp" "$root/test/rust/eval-programs.edn" "$set" "$n" "$off" > "$tmp.out"
  if [ -n "$out" ]; then mv "$tmp.out" "$out"; else cat "$tmp.out"; rm -f "$tmp.out"; fi
  rm -f "$tmp"
}

sets() { # the sets of EVAL.md §6: each program's file searched (its own text, not its modules')
  need_src
  local tmp; tmp=$(mktemp "$TMPDIR/rsi-files.XXXXXX")
  GOMEMLIMIT=1GiB arbace_tool -e "(doseq [p (:programs (read-string (slurp \"$corpus\")))] (println (:file p)))" | sort -u > "$tmp"
  ( cd "$srcroot"
    xargs grep -l -E 'thread::(spawn|scope|Builder)|std::thread\b|use std::thread|\bthread::sleep|mpsc::|Barrier|spawn\(' < "$tmp" > "$tmp.threads" || true
    xargs grep -l -E 'process::Command|Command::new|\bfork\(|execv|process::Stdio|\.spawn\(\)|current_exe' < "$tmp" > "$tmp.process" || true
    xargs grep -l -E 'std::net|TcpListener|TcpStream|UdpSocket|net::' < "$tmp" > "$tmp.net" || true )
  GOMEMLIMIT=1GiB arbace_tool -m arbace.rust.check write-sets "$root/test/rust/eval-programs.edn" "$tmp.threads" "$tmp.process" "$tmp.net"
  rm -f "$tmp" "$tmp.threads" "$tmp.process" "$tmp.net"
}

rt_build() { # RT: the native-std leg's layer (arbace/rust/rt/native.c.ae by gcc, test/rust/runtime/native/try.rs by rustc)
  local rt=$1
  mkdir -p "$rt"
  arbace_tool -m arbace.cpp.lower lower-rt "$root/arbace/rust/rt/native.c.ae" "$rt/native.c"
  # shellcheck disable=SC2086
  gcc $GCC_FLAGS -c "$rt/native.c" -o "$rt/native.o"
  RUSTC_BOOTSTRAP=1 rustc --edition 2024 --crate-type=lib --emit=obj -Copt-level=0 -Cdebuginfo=0 \
    "$root/test/rust/runtime/native/try.rs" -o "$rt/try.o" 2> "$rt/try.log"
}

std_build() {
  local update="" jobs=${RSI_JOBS:-8} pins=$root/test/rust/runtime/std.edn sb=${RSI_STD_DIR:-$root/.tmp/rsi/std}
  while [ $# -gt 0 ]; do case $1 in --update) update=1; shift ;; --jobs) jobs=$2; shift 2 ;; *) echo "std-build: unknown option $1" >&2; exit 2 ;; esac; done
  local libsrc=$root/.tmp/repr-rust/apks/rust-src/usr/src/rust/library
  [ -d "$libsrc" ] || { echo "rsi: no $libsrc (bin/repr-rust corpus fetch)" >&2; exit 1; }
  local want_rustc want_clang target profile flags pkg features cfgs
  pin() { arbace_tool -e "(let [p (read-string (slurp \"$pins\"))] $1)"; }
  want_rustc=$(pin '(print (:rustc p))')
  want_clang=$(pin '(print (:clang p))')
  [ "$(rustc --version)" = "$want_rustc" ] || { echo "rsi std-build: rustc is '$(rustc --version)', $pins pins '$want_rustc'" >&2; exit 1; }
  [ "$(clang --version | head -1)" = "$want_clang" ] || { echo "rsi std-build: clang is '$(clang --version | head -1)', $pins pins '$want_clang'" >&2; exit 1; }
  target=$(pin '(print (:target p))')
  profile=$(pin '(doseq [[k v] (:profile p)] (println (str "CARGO_PROFILE_RELEASE_" k "=" v)))')
  flags=$(pin '(print (apply str (interpose " " (:rustflags p))))')
  pkg=$(pin '(print (:package p))')
  features=$(pin '(print (:features p))')
  # the workspace's own per-package profile (library/Cargo.toml: compiler_builtins' codegen units, the backtrace crates' opt-level "s")
  # overridden by Cargo's --config, which takes precedence over the manifest (RES17 (b): std.edn's :package-profile)
  mapfile -t cfgs < <(pin '(doseq [[pk kvs] (:package-profile p) [k v] kvs] (println "--config") (println (str "profile.release.package." pk "." k "=" (pr-str v))))')
  # one build at a time in the place; the place no longer matters (RES17 (b)): Cargo hashes the workspace's members by their path in it
  mkdir -p "$(dirname "$sb")"
  exec 9> "$sb.lock"; flock 9
  rm -rf "$sb"; mkdir -p "$sb/home" "$sb/ir"
  cp -rs "$libsrc" "$sb/library"
  local t0 t1 t2 f u c
  t0=$(date +%s)
  # library/'s own workspace, built as rust's bootstrap builds it (its package sysroot, the vendored crates by source replacement);
  # -Zforce-unstable-if-unmarked as bootstrap gives every std crate (hashbrown's const fns under std's stability rules)
  # shellcheck disable=SC2086
  (cd "$sb/library" && env $profile CARGO_HOME=$sb/home CARGO_TARGET_DIR=$sb/target RUSTC_BOOTSTRAP=1 RUSTFLAGS="$flags" \
     cargo build --offline --release -j "$jobs" --target "$target" -p "$pkg" --features "$features" -Ztrim-paths \
       --config 'source.crates-io.replace-with="vendored-sources"' --config 'source.vendored-sources.directory="vendor"' "${cfgs[@]}") \
     > "$sb/build.log" 2>&1 || { tail -20 "$sb/build.log" >&2; exit 1; }
  t1=$(date +%s)
  # each codegen unit's optimized bitcode (at -O0: the IR codegen read) as IR text: deps/CRATE-HASH.CRATE.HASH-cgu.N.rcgu.bc (std's:
  # std.std.HASH-cgu.N, its dylib's), named relative to deps/ (the IR's ModuleID names the file clang read); the package sysroot's
  # own unit and the std dylib's allocator shim (no -cgu.) are not std's code
  for f in "$sb/target/$target/release/deps/"*-cgu.*.rcgu.bc; do
    u=$(basename "$f" .rcgu.bc); c=${u%%.*}; c=${c%%-*}
    [ "$c" = "$pkg" ] && continue
    mkdir -p "$sb/ir/$c"
    printf '%s\t%s\n' "$f" "$sb/ir/$c/$u.ll"
  done > "$sb/units.tsv"
  tr '\t\n' '\037\0' < "$sb/units.tsv" | xargs -0 -P "$jobs" -I{} bash -c 'IFS=$'"'"'\037'"'"' read -r b l <<< "$1"; cd "$(dirname "$b")" && clang -S -emit-llvm "$(basename "$b")" -o "$l"' _ {}
  (cd "$sb/ir" && find . -name '*.ll' | LC_ALL=C sort | sed 's|^\./||' | while read -r f; do printf '%s  %s\n' "$(sha256sum < "$f" | cut -d' ' -f1)" "$f"; done) > "$sb/ir.sha256"
  t2=$(date +%s)
  # the sysroot: the host's but for its rlibs, which are the build's (std's dylib left out: a -C prefer-dynamic program does not build)
  local tl=$sb/sysroot/lib/rustlib/$target host; host=$(rustc --print sysroot)
  mkdir -p "$tl/lib"
  ln -s "$host/lib/rustlib/$target/bin" "$tl/bin"
  for f in "$host/lib/rustlib/$target/lib/"*; do case $f in *.rlib|*.rmeta|*.so) ;; *) ln -s "$f" "$tl/lib/" ;; esac; done
  for f in "$sb/target/$target/release/deps/"lib*.rlib; do case $(basename "$f") in "lib$pkg-"*) ;; *) cp "$f" "$tl/lib/" ;; esac; done
  find "$sb/target" -name '*.rcgu.*' -delete
  echo "std-build: cargo $((t1-t0)) s, IR $((t2-t1)) s; $(wc -l < "$sb/ir.sha256") units, $(du -sm "$sb/ir" | cut -f1) MB of IR" | tee "$sb/times.txt"
  if [ -n "$update" ]; then
    cp "$sb/ir.sha256" "$root/test/rust/runtime/ir.sha256"
  elif ! diff "$root/test/rust/runtime/ir.sha256" "$sb/ir.sha256" > "$sb/ir.diff"; then
    echo "rsi std-build: the IR differs from test/rust/runtime/ir.sha256 (--update after a look):" >&2; head -20 "$sb/ir.diff" >&2; exit 1
  fi
  sha256sum < "$sb/ir.sha256" | cut -d' ' -f1 > "$sb/key"
}

# ---- std's IR as a record (ORS12): the pack rust-std-ir (test/rust/records/), the members CRATE/UNIT.ll of std-build's ir/, keyed by the std
# pin (the apk's SHA-256, std.edn, the committed ir.sha256); a host with no rustc reads it instead of building std (RSI_LIVE=1: builds)
std_pin() { echo "$root/test/rust/records/rust-std-ir.sha256"; }
std_key() { cat "$root/tools/rsdump/apks.sha256" "$root/test/rust/runtime/std.edn" "$root/test/rust/runtime/ir.sha256" | sha256sum | cut -c1-64; }
std_ir_current() { # SB: its ir/ at the committed pin (no sysroot needed)
  local sb=$1
  [ -f "$sb/ir.sha256" ] && [ -d "$sb/ir" ] && cmp -s "$sb/ir.sha256" "$root/test/rust/runtime/ir.sha256" &&
    [ "$(cd "$sb/ir" && find . -name '*.ll' | wc -l)" = "$(wc -l < "$sb/ir.sha256")" ]
}
std_ir_get() { # SB: the pack's members into SB/ir, the units' digests those of ir.sha256, the pack's key the std pin's
  local sb=$1 pin man name u
  pin=$(std_pin); name=$(oracle_pin_name "$pin"); man=$(oracle_manifest "$pin")
  [ -f "$pin" ] && [ -f "$man" ] || { echo "rsi: UNRECORDED: no $pin (bin/rsi std-record, by hand on a host with rustc)" >&2; return 1; }
  if [ -n "$(awk -F'\t' -v k="$(std_key)" '!/^#/ && NF && $2 != k {print "x"; exit}' "$man")" ]; then
    echo "rsi: STALE: $man: the apk, std.edn or ir.sha256 changed since the record (bin/rsi std-record)" >&2; return 1
  fi
  u=$(oracle_unpack "$pin") || return 1
  rm -rf "$sb/ir" "$sb/ir.sha256"; mkdir -p "$sb/ir"
  cp -r "$u/$name/." "$sb/ir/"
  (cd "$sb/ir" && find . -name '*.ll' | LC_ALL=C sort | sed 's|^\./||' | while read -r f; do printf '%s  %s\n' "$(sha256sum < "$f" | cut -d' ' -f1)" "$f"; done) > "$sb/ir.sha256"
  cmp -s "$sb/ir.sha256" "$root/test/rust/runtime/ir.sha256" || { echo "rsi: the pack's units are not test/rust/runtime/ir.sha256's: refused" >&2; return 1; }
}
std_record() { # the live std's IR packed (bin/rsi std-build first), by hand
  local sb=${RSI_STD_DIR:-$root/.tmp/rsi/std} pin name stage
  std_current "$sb" || { echo "rsi std-record: no std build at the pin in $sb (bin/rsi std-build)" >&2; return 1; }
  pin=$(std_pin); name=$(oracle_pin_name "$pin"); stage=$root/.tmp/rsi/std-record
  rm -rf "$stage"; mkdir -p "$stage/$name"; cp -r "$sb/ir/." "$stage/$name/"
  (cd "$stage/$name" && find . -name '*.ll' | LC_ALL=C sort | sed 's|^\./||') | while IFS= read -r f; do printf '%s\t%s\n' "$f" "$(std_key)"; done > "$stage/ids"
  oracle_make "$pin" "$stage" "$stage/ids" "bin/rsi std-record" rustc || return 1
  rm -rf "$stage"
}
std_verify() { # std built afresh in a scratch directory, its IR against the pack's members byte for byte (ORS6 (a)'s verdict), the crossed pair
  local sb=$root/.tmp/rsi/std-verify pin name man u nd=0 n=0 f first="" last=""
  pin=$(std_pin); name=$(oracle_pin_name "$pin"); man=$(oracle_manifest "$pin")
  u=$(oracle_unpack "$pin") || return 1
  ( RSI_STD_DIR=$sb std_build ) > "$root/.tmp/rsi/std-verify.log" 2>&1 || { tail -5 "$root/.tmp/rsi/std-verify.log" >&2; return 1; }
  while IFS= read -r f; do
    n=$((n + 1)); [ -n "$first" ] || first=$sb/ir/$f; last=$u/$name/$f
    if [ ! -f "$u/$name/$f" ]; then echo "verify: $name/$f: UNRECORDED"; nd=$((nd + 1))
    elif cmp -s "$sb/ir/$f" "$u/$name/$f"; then :; else echo "verify: $name/$f: DIFFERS"; nd=$((nd + 1)); fi
  done < <(cd "$sb/ir" && find . -name '*.ll' | LC_ALL=C sort | sed 's|^\./||')
  oracle_verdict rustc "$man" "$nd" "$n" || return 1
  if [ "$n" -ge 2 ] && cmp -s "$first" "$last"; then echo "verify: FAILED: the crossed pair is equal: control not judged"; return 1
  elif [ "$n" -ge 2 ]; then echo "verify: the crossed pair differs (control passed)"; fi
}

std_current() { # std's build at the checkout's pin: its ir.sha256 the committed one, its sysroot there
  local sb=$1
  [ -f "$sb/ir.sha256" ] && [ -d "$sb/sysroot" ] && cmp -s "$sb/ir.sha256" "$root/test/rust/runtime/ir.sha256"
}

runtime_key() { # what the lowered std is built from, a digest a line (as bin/cppi's runtime-key): the namespaces the lowering
  # loads, the layer, std's IR pin and profile, runtime-build's own steps, gcc's flags, gcc, clang and the tools' host
  local exe
  ( cd "$root" && sha256sum arbace/cpp/lower.ae arbace/rust/lower.ae arbace/rust/rt/eh.c.ae arbace/repr/llvm.ae arbace/repr/llvm/*.ae \
      arbace/repr/c.ae arbace/repr/c/*.ae test/rust/runtime/std.edn test/rust/runtime/ir.sha256 )
  printf '%s  bin/rsi:runtime_build,rt_unit\n' "$(declare -f runtime_build rt_unit | sha256sum | cut -d' ' -f1)"
  printf '%s  GCC_FLAGS\n' "$(printf '%s' "$GCC_FLAGS" | sha256sum | cut -d' ' -f1)"
  printf '%s  gcc --version\n' "$(gcc --version | head -1 | sha256sum | cut -d' ' -f1)"
  printf '%s  clang --version\n' "$(clang --version | head -1 | sha256sum | cut -d' ' -f1)"
  . "$root/bin/lib/host.bash"
  exe=$(arbace_host_exe)
  printf '%s  the tools'"'"' host\n' "$(sha256sum < "$exe" | cut -d' ' -f1)"
}

runtime_current() { # runtime_current OUT: OUT's lowered std at the checkout's key
  local out=$1
  [ -f "$out/key" ] && [ "$(cat "$out/key")" = "$(runtime_key | sha256sum | cut -d' ' -f1)" ]
}

rt_unit() { # rt_unit DIR: one unit's print's object against its IR's, gcc -O0 on its lowered C
  local d=$1 ll; ll=$(cat "$d/ll")
  ( cd "$d" && clang -c "$ll" -o x.o 2> obj.log && clang -c print.ll -o print.o 2>> obj.log && { cmp -s x.o print.o && echo same || echo differs; } > object ) || echo none > "$d/object"
  rm -f "$d/x.o" "$d/print.o" "$d/print.ll" "$d/forms.ae"
  [ -f "$d/lowered.c" ] || return 0
  # shellcheck disable=SC2086
  ( cd "$d" && timeout 900 gcc $GCC_FLAGS -c lowered.c -o lowered.o > gcc.log 2>&1; echo $? > gcc.status )
  # the lowered C kept: bin/rsi runtime-ci reads it as ci's library (RE4)
}
export -f rt_unit; export GCC_FLAGS

runtime_build() { # bin/rsi runtime-build [OUT] [--jobs N]: std's IR lowered (EVAL.md §8)
  local out=$root/.tmp/rsi/runtime jobs=${RSI_JOBS:-4} sb=${RSI_STD_DIR:-$root/.tmp/rsi/std}
  while [ $# -gt 0 ]; do case $1 in --jobs) jobs=$2; shift 2 ;; -*) echo "runtime-build: unknown option $1" >&2; exit 2 ;; *) out=$1; shift ;; esac; done
  # std's IR: at the pin already, or the pack's (no rustc), or built (RSI_LIVE=1, or no pack)
  std_ir_current "$sb" || { [ -z "${RSI_LIVE:-}" ] && std_ir_get "$sb"; } || std_current "$sb" || ( std_build )
  disk_ok
  mkdir -p "$out"; out=$(cd "$out" && pwd)
  rm -rf "$out/units" "$out/lib" "$out/key" "$out/key.txt"; mkdir -p "$out/units" "$out/lib"
  # the key of what the build starts from (an edit during the build gives a runtime stale at its end)
  runtime_key > "$out/key.start"
  # every unit but compiler_builtins', which stays native as libgcc does for the lowered C++ (EVAL.md §8: the C compiler's
  # builtins, f16 and f128 arithmetic and the global asm of its probestack)
  local f u c t0 t1 t2
  (cd "$sb/ir" && find . -name '*.ll' | LC_ALL=C sort | sed 's|^\./||') | grep -v '^compiler_builtins/' | while read -r f; do
    u=${f%.ll}; mkdir -p "$out/units/$u"; echo "$sb/ir/$f" > "$out/units/$u/ll"
    printf '%s\t%s\t%s\n' "$(basename "$u")" "$sb/ir/$f" "$out/units/$u"
  done > "$out/lower.tsv"
  t0=$(date +%s)
  GOMAXPROCS=$jobs GOMEMLIMIT=${RSI_RT_GOMEMLIMIT:-4GiB} RSI_THREADS=$jobs arbace_tool -m arbace.rust.lower lower-list "$out/lower.tsv" --runtime > "$out/lower.log" 2>&1 || true
  t1=$(date +%s)
  cut -f3 "$out/lower.tsv" | tr '\n' '\0' | xargs -0 -P "$jobs" -I{} nice bash -c 'rt_unit "$1"' _ {}
  for d in "$out"/units/*; do
    c=$(basename "$d")
    find "$d" -name lowered.o | LC_ALL=C sort | xargs -r ar rcs "$out/lib/lib$c.a"
  done
  arbace_tool -m arbace.cpp.lower lower-rt "$root/arbace/rust/rt/eh.c.ae" "$out/rt.c" 2> "$out/rt.log"
  # shellcheck disable=SC2086
  gcc $GCC_FLAGS -c "$out/rt.c" -o "$out/rt.o"
  t2=$(date +%s)
  # the units' levels: UNIT, the round trip, the objects, the lowering (lowered or refused CLASS), gcc, the stubs
  local bad=0 n=0 rt ob lo gc st
  for d in $(cut -f3 "$out/lower.tsv"); do
    n=$((n+1)); u=${d#"$out/units/"}
    rt=$(cut -f1 "$d/rt.status" 2>/dev/null || echo none); ob=$(cat "$d/object" 2>/dev/null || echo none)
    if [ -f "$d/lower.refused" ]; then lo="refused $(cut -f1 "$d/lower.refused")"; else lo=lowered; fi
    gc=$(cat "$d/gcc.status" 2>/dev/null || echo -); st=$(wc -l < "$d/stubbed.tsv" 2>/dev/null || echo 0)
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$u" "$rt" "$ob" "$lo" "$gc" "$st"
    { [ "$ob" = same ] && [ "$lo" = lowered ] && [ "$gc" = 0 ]; } || bad=$((bad+1))
  done > "$out/results.tsv"
  cat "$out"/units/*/*/stubbed.tsv > "$out/stubbed.tsv" 2>/dev/null || true
  echo "runtime-build: $n units, $((n-bad)) lowered and compiled with their objects equal, $(wc -l < "$out/stubbed.tsv") functions stubbed; read, print and lower $((t1-t0)) s, gcc $((t2-t1)) s" | tee "$out/times.txt"
  [ "$bad" = 0 ] || { awk -F'\t' '$3 != "same" || $4 != "lowered" || $5 != "0"' "$out/results.tsv" | head -20 >&2; exit 1; }
  mv "$out/key.start" "$out/key.txt"
  sha256sum < "$out/key.txt" | cut -d' ' -f1 > "$out/key"
}

runtime_ci() { # runtime_ci [OUT]: OUT/ci (RE4, EVAL.md §9): std's lowered units and the layer read by repr/c as ci's library
  # (OUT/ci/std), ci's ports (test/rust/runtime/ci/*.c, OUT/ci/ports), made again when its key (OUT's key, the reader's
  # sources and options: arbace/rust/run.ae's marked part, repr/c, test/c/host, the ports) changed; runtime-build first when OUT
  # is not at the checkout's key. Prints OUT/ci.
  local out=${1:-${RSI_RUNTIME_DIR:-$root/.tmp/rsi/runtime}} k f u d sb=${RSI_STD_DIR:-$root/.tmp/rsi/std}
  if ! runtime_current "$out" || [ ! -f "$out/rt.c" ] \
     || cut -f3 "$out/lower.tsv" | while read -r d; do [ -f "$d/lowered.c" ] || echo missing; done | grep -q missing; then
    echo "runtime-ci: the lowered std in $out is not at the checkout's key (or has no lowered C): runtime-build" >&2
    ( runtime_build "$out" ) >&2 || exit 1
  fi
  out=$(cd "$out" && pwd)
  k=$( { cat "$out/key"; (cd "$root" && sed -n '/^;; runtime-ci-key begin/,/^;; runtime-ci-key end/p' arbace/rust/run.ae | sha256sum
                                 find arbace/repr/c.ae arbace/repr/c test/c/host -type f | LC_ALL=C sort | xargs sha256sum); } | sha256sum | cut -d' ' -f1)
  if [ "$(cat "$out/ci/key" 2>"$TMPDIR/rsi-cikey.err")" != "$k" ]; then
    # an interrupted read at the same key (ci/pending) resumes: read-lib keeps the units read whole
    [ "$(cat "$out/ci/pending" 2>"$TMPDIR/rsi-cikey.err")" = "$k" ] || rm -rf "$out/ci"
    rm -rf "$out/ci/cb" "$out/ci/ports" "$out/ci/key"; mkdir -p "$out/ci/std"; echo "$k" > "$out/ci/pending"
    { while IFS=$'\t' read -r u _ d; do printf '%s\t%s\n' "$u" "$d/lowered.c"; done < "$out/lower.tsv"; printf 'rsi-rt\t%s\n' "$out/rt.c"; } > "$out/ci/std/list.tsv"
    echo "runtime-ci: reading the lowered std into $out/ci/std (minutes)" >&2
    (cd "$root" && GOMEMLIMIT=${RSI_CI_MEMLIMIT:-6GiB} arbace_tool -m arbace.rust.run read-lib "$out/ci/std" "$out/ci/std/list.tsv" "${RSI_JOBS:-4}") > "$out/ci/std/read.log" 2>&1 \
      || { grep -v -E 'Reflection|recur arg|Auto-boxing' "$out/ci/std/read.log" | tail -5 >&2; exit 1; }
    # compiler_builtins lowered for ci (RE4, RES25 (b) on ci): its units given the runtime's pre-pass (f16, f128 and inline
    # assembly stubbed) and lowered into OUT/ci/cb-src, read as a library linked after musl (musl's mem* and the rest first);
    # a unit repr/llvm does not read (global_asm!'s module asm: probestack) left out, listed in OUT/ci/cb/left.tsv
    mkdir -p "$out/ci/cb-src" "$out/ci/cb"
    (cd "$sb/ir" && find compiler_builtins -name '*.ll' | LC_ALL=C sort) | while read -r f; do
      u=$(basename "$f" .ll); mkdir -p "$out/ci/cb-src/$u"; printf '%s\t%s\t%s\n' "$u" "$sb/ir/$f" "$out/ci/cb-src/$u"; done > "$out/ci/cb-src/lower.tsv"
    (cd "$root" && GOMAXPROCS=${RSI_JOBS:-4} RSI_THREADS=${RSI_JOBS:-4} GOMEMLIMIT=${RSI_RT_GOMEMLIMIT:-4GiB} arbace_tool -m arbace.rust.lower lower-list "$out/ci/cb-src/lower.tsv" --runtime) > "$out/ci/cb-src/lower.log" 2>&1 || true
    while IFS=$'\t' read -r u _ d; do
      if [ -f "$d/lowered.c" ]; then printf '%s\t%s\n' "$u" "$d/lowered.c" >> "$out/ci/cb/list.tsv"; else printf '%s\t%s\n' "$u" "$(cut -c1-200 "$d/lower.refused" 2>"$TMPDIR/rsi-cb.err")" >> "$out/ci/cb/left.tsv"; fi
    done < "$out/ci/cb-src/lower.tsv"
    (cd "$root" && GOMEMLIMIT=${RSI_CI_MEMLIMIT:-6GiB} arbace_tool -m arbace.rust.run read-lib "$out/ci/cb" "$out/ci/cb/list.tsv" "${RSI_JOBS:-4}") > "$out/ci/cb/read.log" 2>&1 \
      || { grep -v -E 'Reflection|recur arg|Auto-boxing' "$out/ci/cb/read.log" | tail -5 >&2; exit 1; }
    echo "$k" > "$out/ci/key"; rm -f "$out/ci/pending"
  fi
  # ci's ports (test/rust/runtime/ci/*.c, linked before std): what the lowered C needs that ci does not give (__builtin_ldexpl);
  # keyed apart (the reader's options and sources, the ports), so that a port does not read std again
  local kp
  kp=$( (cd "$root" && sed -n '/^;; runtime-ci-key begin/,/^;; runtime-ci-key end/p' arbace/rust/run.ae | sha256sum
         find arbace/repr/c.ae arbace/repr/c test/c/host test/rust/runtime/ci -type f | LC_ALL=C sort | xargs sha256sum) | sha256sum | cut -d' ' -f1)
  if [ "$(cat "$out/ci/ports/key" 2>"$TMPDIR/rsi-cikey.err")" != "$kp" ]; then
    rm -rf "$out/ci/ports"; mkdir -p "$out/ci/ports"
    for f in "$root"/test/rust/runtime/ci/*.c; do [ -f "$f" ] && printf '%s\t%s\n' "ci-$(basename "$f" .c)" "$f"; done > "$out/ci/ports/list.tsv"
    if [ -s "$out/ci/ports/list.tsv" ]; then
      (cd "$root" && GOMEMLIMIT=${RSI_CI_MEMLIMIT:-6GiB} arbace_tool -m arbace.rust.run read-lib "$out/ci/ports" "$out/ci/ports/list.tsv" 1) > "$out/ci/ports/read.log" 2>&1 \
        || { grep -v -E 'Reflection|recur arg|Auto-boxing' "$out/ci/ports/read.log" | tail -5 >&2; exit 1; }
    fi
    echo "$kp" > "$out/ci/ports/key"
  fi
  echo "$out/ci"
}

disk_ok() { # the light tier's disk rule: stop past 80% (RSI_DISK_MAX)
  local u; u=$(df --output=pcent "$root" | tail -1 | tr -dc 0-9)
  [ "$u" -le "${RSI_DISK_MAX:-80}" ] || { echo "rsi: the disk is at $u%, stopping" >&2; exit 3; }
}

lower_check() {
  local plan=$1 work=$2; shift 2
  local jobs=${RSI_JOBS:-4} record="" src=$srcroot leg=lowered sb=${RSI_STD_DIR:-$root/.tmp/rsi/std} rtdir=$root/.tmp/rsi/runtime
  while [ $# -gt 0 ]; do case $1 in --jobs) jobs=$2; shift 2 ;; --record) record=1; shift ;; --leg) leg=$2; shift 2 ;; --runtime) rtdir=$2; shift 2 ;;
    *) echo "lower-check: unknown option $1" >&2; exit 2 ;; esac; done
  case $leg in lowered|native) ;; *) echo "lower-check: --leg lowered or native" >&2; exit 2 ;; esac
  case $(head -1 "$plan") in test/rust/eval/*|test/rust/synthetic/*) ;; *) need_src ;; esac
  grep -q . "$plan" || { echo "lower-check: $plan has no program" >&2; exit 2; }
  # rsi's samples are built from the checkout (bin/rsi list --set samples)
  case $(head -1 "$plan") in test/rust/eval/*|test/rust/synthetic/*) src=$root ;; esac
  disk_ok
  mkdir -p "$work"; work=$(cd "$work" && pwd)
  rm -rf "$work/files" "$work/jobs" "$work/diffs" "$work/results.tsv" "$work/summary.edn"
  cp "$plan" "$work/plan.tsv"
  : > "$work/empty"
  mkdir -p "$work/native"
  cc -c -O2 -fPIC -o "$work/native/rust_test_helpers.o" "$srcroot/tests/auxiliary/rust_test_helpers.c" > "$work/native/build.log" 2>&1
  ar rcs "$work/native/librust_test_helpers.a" "$work/native/rust_test_helpers.o"
  export REPR_RUST_NATIVE=$work/native RSI_WORK=$work
  local sysroot="" results=$root/test/rust/lower-results.edn
  if [ "$leg" = lowered ]; then
    # RE3 (EVAL.md §8): both sides against std's build (RES3 (a)), the lowered side linked with std's lowered units
    if ! runtime_current "$rtdir"; then echo "lower-check: the lowered std in $rtdir is not at the checkout's key: runtime-build" >&2; ( runtime_build "$rtdir" --jobs "$jobs" ); fi
    rtdir=$(cd "$rtdir" && pwd)
    sysroot=$(cd "$sb/sysroot" && pwd)
    export RSI_RUNTIME=$rtdir RSI_SYSROOT=$sysroot
    results=$root/test/rust/lower-std-results.edn
  else
    # RE2's native-std leg (EVAL.md §4): the host's sysroot, the native layer
    rt_build "$work/rt"; export RSI_RT=$work/rt
  fi
  local n t0 t1
  n=$(wc -l < "$work/plan.tsv")
  echo "== rsi lower-check ($leg): $n programs, built and run from the originals and from their lowered IR ($jobs at a time)" >&2
  t0=$(date +%s)
  seq 1 "$n" | xargs -P "$jobs" -I{} nice "$root/bin/lib/repr-rust/run-program" "$work/plan.tsv" {} "$work/jobs" "$work/empty" \
    "orig:$src:$sysroot" "lowered:$src:$sysroot::$root/bin/lib/rsi/wrap" > "$work/results.tsv"
  t1=$(date +%s)
  [ ! -d "$work/files" ] || find "$work/files" -name lowered.o -delete
  rm -rf "$work/jobs"
  echo "lower-check: build and run $((t1-t0)) s" | tee "$work/times.txt"
  arbace_tool -m arbace.rust.check judge "$work" "$src" "$root/test/rust/divergences-lower.edn" --leg "$leg" ${record:+--record "$results"}
}

case ${1:-} in
  lower) shift; arbace_tool -m arbace.rust.lower lower "$@" ;;
  list) shift; list "$@" ;;
  sets) sets ;;
  std-build) shift; std_build "$@" ;;
  runtime-build) shift; runtime_build "$@" ;;
  std-record) std_record ;;
  std-verify) std_verify ;;
  lower-check) shift; lower_check "$@" ;;
  runtime-ci) shift; runtime_ci "$@" ;;
  lower-unit) shift # the lowering's unit cases (test/rust/lower/*.ll, or FILE.ll...): each run by lli and lowered, compiled by gcc -O0 and run, the outputs equal
    lli=${LLI:-/usr/lib/llvm23/bin/lli}; [ -x "$lli" ] || { echo "lower-unit: no lli ($lli)" >&2; exit 1; }
    [ $# -gt 0 ] || set -- "$root"/test/rust/lower/*.ll
    ud=$(mktemp -d "$TMPDIR/rsi-unit.XXXXXX"); ubad=0
    # the pending-flag layer the lowered C calls (cx$pending)
    arbace_tool -m arbace.cpp.lower lower-rt "$root/arbace/rust/rt/eh.c.ae" "$ud/rt.c" > "$ud/rt.log" 2>&1 && gcc $GCC_FLAGS -c "$ud/rt.c" -o "$ud/rt.o" >> "$ud/rt.log" 2>&1 \
      || { cat "$ud/rt.log" >&2; exit 1; }
    for f in "$@"; do
      b=$(basename "$f" .ll)
      "$lli" "$f" > "$ud/$b.lli" 2>&1; echo "status $?" >> "$ud/$b.lli"
      if arbace_tool -m arbace.rust.lower lower "$f" -o "$ud/$b.c" > "$ud/$b.lower.log" 2>&1 \
         && gcc $GCC_FLAGS -o "$ud/$b" "$ud/$b.c" "$ud/rt.o" > "$ud/$b.gcc.log" 2>&1; then
        "$ud/$b" > "$ud/$b.out" 2>&1; echo "status $?" >> "$ud/$b.out"
      else cat "$ud/$b.lower.log" "$ud/$b.gcc.log" > "$ud/$b.out"; fi
      if cmp -s "$ud/$b.lli" "$ud/$b.out"; then echo "lower-unit: $b: as lli"; else echo "lower-unit: $b: DIFFERS from lli"; diff "$ud/$b.lli" "$ud/$b.out" | head -10; ubad=1; fi
    done
    rm -rf "$ud"; exit $ubad ;;
  record-ref) shift
    rplan=$TMPDIR/rsi-ref-plan.$$; rset=all rsample=1 roff=0 ronly="" rcorp=samples,synthetic,ui
    while [ $# -gt 0 ]; do case $1 in --corpus) rcorp=$2; shift 2 ;; --set) rset=$2; shift 2 ;; --sample) rsample=$2; shift 2 ;; --offset) roff=$2; shift 2 ;;
      --only) ronly=$2; shift 2 ;; *) echo "record-ref: unknown option $1" >&2; exit 2 ;; esac; done
    : > "$rplan"
    case ",$rcorp," in *,samples,*) list --set samples >> "$rplan" ;; esac
    case ",$rcorp," in *,synthetic,*) list --set synthetic >> "$rplan" ;; esac
    case ",$rcorp," in *,ui,*) need_src; list --set "$rset" --sample "$rsample" --offset "$roff" >> "$rplan" ;; esac
    if [ -n "$ronly" ]; then grep -v '^#' "$ronly" | grep . > "$rplan.ids"; awk -F'\x1f' 'BEGIN { while ((getline l < ARGV[2]) > 0) w[l] = 1; ARGV[2] = "" } ($1 in w)' "$rplan" "$rplan.ids" > "$rplan.only"; mv "$rplan.only" "$rplan"; rm -f "$rplan.ids"; fi
    std_current "${RSI_STD_DIR:-$root/.tmp/rsi/std}" || ( std_build )
    "$root/bin/lib/rsi/record-ref" "$rplan" "${RSI_REF_WORK:-$root/.tmp/rsi-ref}"; st=$?; rm -f "$rplan"; exit $st ;;
  synthetic) shift; v=${1:-generate}; [ $# -gt 0 ] && shift; v=${v#--}; cd "$root" && GOMEMLIMIT=1GiB arbace_tool -m arbace.rust.synthetic "$v" "$@" ;;
  judge-test) shift # the check's judge without ci (RE5): every program of the samples and the synthetic corpus judged from the judge's own recorded run (all pass),
    # then with one program's output changed (it must fail), the controls differing
    cd "$root"; jw=$(mktemp -d "$TMPDIR/rsi-judge-test.XXXXXX"); jbad=0
    export GOMEMLIMIT=1GiB
    arbace_tool -m arbace.rust.check make-fake "$jw" - samples synthetic
    if arbace_tool -m arbace.rust.check run-judge "$jw" eval samples synthetic > "$jw/same.out" 2>&1; then echo "judge-test: the judge's own runs pass"; else echo "judge-test: the judge's own runs DO NOT pass"; cat "$jw/same.out"; jbad=1; fi
    grep -q 'differs, as a control must' "$jw/same.out" || { echo "judge-test: no control reported as differing"; jbad=1; }
    arbace_tool -m arbace.rust.check make-fake "$jw" test/rust/synthetic/fmt.rs samples synthetic
    if arbace_tool -m arbace.rust.check run-judge "$jw" eval samples synthetic > "$jw/mut.out" 2>&1; then echo "judge-test: a changed output PASSES"; jbad=1
    elif grep -q 'FAIL test/rust/synthetic/fmt.rs differ stdout' "$jw/mut.out"; then echo "judge-test: a changed output fails, as it must"; else echo "judge-test: the changed output failed otherwise"; cat "$jw/mut.out"; jbad=1; fi
    rm -rf "$jw"; exit $jbad ;;
  check) shift; exec "$root/bin/lib/rsi/check" "$@" ;;
  run) shift; exec "$root/bin/lib/rsi/run" "$@" ;;
  divergences) shift; lvl=eval; [ "${1:-}" = --aot ] && lvl=aot; GOMEMLIMIT=1GiB arbace_tool -m arbace.rust.check divergences "$lvl" ;;
  *) sed -n '2,/^set -e/p' "$0" | sed '$d;s/^# \{0,1\}//' >&2; exit 2 ;;
esac

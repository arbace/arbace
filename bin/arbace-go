#!/bin/bash
# Arbace as a static Go executable (B1a; doc/go/EVAL-NOTES.md, doc/go/EXEC-NOTES.md): run it
# (any arbace.main option: -e, -m, a script, - for stdin, none for the REPL), build it, or
# smoke-test it. Since standalone S4 (doc/STANDALONE-NOTES.md, "S4: the JVM removed") the build is
# Go-hosted: j2g and repr/go run on the host executable (bin/lib/host.bash: stage 0, built from the
# Go-source seed by bin/seed --build, unless ARBACE_HOST_EXE names another).
#
# Usage: bin/arbace-go [ARG...]        run target/arbace-go/<arch>/arbace (built first when
#                                      missing); arm64 runs under qemu-aarch64
#        bin/arbace-go --build         translate (bin/j2g --program, on the host executable) and
#                                      build the executables of $ARBACE_GO_ARCHES into
#                                      target/arbace-go/<arch>/arbace
#        bin/arbace-go --build --pgo   the same, then a profile-guided build (doc/go/SPEED-NOTES.md):
#                                      the host's executable runs test/arbace-go-pgo.ae with a
#                                      CPU profile (target/arbace-go/pgo.pprof), and every
#                                      executable is built again with it (go build -pgo)
#        bin/arbace-go --build-tests [DIR]
#                                      the test build (doc/go/EVAL-NOTES.md, "The suite's Java
#                                      fixtures"): the same program with the Java forms of DIR
#                                      (default: Clojure's suite's Java fixtures, test/java, as
#                                      repr/java converts them, committed in test/java-fixtures/forms:
#                                      test/java-fixtures/README.md; bin/clojure-tests
#                                      --java-fixtures OUT converts them afresh)
#                                      translated into it, built into
#                                      target/arbace-go/<arch>/arbace-tests for
#                                      $ARBACE_GO_ARCHES; what bin/clojure-tests runs the suite
#                                      on. The shipped executable does not carry them
#        bin/arbace-go --build-java [DIR...]
#                                      javac's tool build (doc/classes/JAVA-FRONTEND-SURVEY.md,
#                                      JFS4 (b), "As built: JN2"): the same program with javac's
#                                      forms (jdk/javac/forms, bin/javac-vendor), the tool's
#                                      variants (overlay/jdk/javac/variants) and the Java forms of
#                                      the DIRs (a driver) translated into it, with the edges
#                                      jdk/edge.edn and jdk/javac/edge.edn ($J2G_JAVA_ARGS: more
#                                      of j2g's arguments, e.g. --qualify for a driver's package,
#                                      --edge for its edge), built into
#                                      target/arbace-go/<arch>/arbace-javac for
#                                      $ARBACE_GO_ARCHES; with repr/java's namespaces embedded
#                                      and compiled into it (the survey's "As built: JN4",
#                                      JFS28: repr/java's read on javac's tool executable,
#                                      bin/repr-java's only host since JN6) by c2j on a first
#                                      tool build, target/arbace-go/aot-reader, kept while its
#                                      key holds (Arbace's sources, the runtime, javac's world;
#                                      ARBACE_AOT=0: the reader evaluated); the key of its
#                                      sources beside it, arbace-javac.key
#                                      (bin/lib/javac-key.bash: the provenance files repr/java
#                                      writes on it name it, JFS30 (b)). Not shipped; in
#                                      bin/gate --full's javac step
#        bin/arbace-go --build-program DIR [--arch ARCH[,ARCH]] [-o OUT]
#                                      a user's program (REAP7, doc/go/BUILD.md, "A user's
#                                      program"): DIR's Clojure namespaces (src/, compiled by
#                                      c2j), Java forms (java/, translated by j2g) and Go forms
#                                      (go/: embedded, goi's; or, with no :main and no
#                                      :main-class in DIR/program.edn, a Go program built by
#                                      arbace.build.go alone) with the shipped build's compiled
#                                      namespaces (reused when their key is the checkout's: else
#                                      a --build first), into target/arbace-go/programs/NAME/
#                                      ARCH/NAME (and OUT), cached by key; prints where it is.
#                                      j2g runs under J2G_LOCK when set (bin/j2g)
#        bin/arbace-go --build-program --check [NAME...]
#                                      test/programs' samples built and run against their
#                                      runs/ (stdout, exit code, stderr; each namespace compiled)
#        bin/arbace-go --fixpoint      the Go-hosted fixpoint (standalone S3, S4;
#                                      doc/STANDALONE-NOTES.md): G1 built by the host executable
#                                      (stage 0 by default), G2 by G1 (j2g and repr/go on G1), G3 by
#                                      G2, for amd64, into target/arbace-go/fixpoint/g{1,2,3}. The
#                                      fixpoint holds when j2g's program trees of G2 and G3 are
#                                      identical (diff -r, but report.edn's times) and G2 = G3
#                                      byte for byte; G1 = G2 and the host = G1 are reported (they
#                                      hold when the host is stage 0 of a seed printed from these
#                                      sources: bin/seed --verify); prints the hashes
#        bin/arbace-go --image         prepare the namespaces again (the image of their analyzed
#                                      forms, doc/go/EXEC-NOTES.md) with the built executables
#                                      and link them again with it
#        bin/arbace-go --gate-build    the essential bin/gate's builds: the executable and the
#                                      test build (amd64), cached in .tmp/arbace-go-gate/amd64/
#                                      (arbace, arbace-tests; and the compiled namespaces, aot/
#                                      and aot.key, since REAP8) and built again only when what
#                                      they are built from changed (gate_key), by stage 0
#        bin/arbace-go --gate          --gate-build, then --smoke on the cached executable
#        bin/arbace-go --smoke         the smoke test: -e, a script, the REPL on stdin, an
#                                      error's exit status, for each of $ARBACE_GO_ARCHES; on
#                                      amd64 the REPL under rlwrap on a pseudo-terminal
#                                      (test/arbace-go-rlwrap.py)
#        bin/arbace-go --build --box   the box (B1b, doc/go/BOX-NOTES.md, S1): the same program
#                                      (j2g's output and the image of prepared namespaces of the
#                                      last --build, made first when missing) built for TamaGo,
#                                      GOOS=tamago, with the board of box/, into
#                                      target/arbace-go/box-<arch>/arbace.elf, and the launcher
#                                      (box/'s arbace/box/cmd/arbace-box, a linux program) with
#                                      the image appended, target/arbace-go/box-<arch>/arbace-box,
#                                      for $ARBACE_BOX_ARCHES (default amd64)
#        bin/arbace-go --smoke --box   the box's smoke test (bin/box-smoke) on /dev/kvm, on 4 and 1
#                                      vCPUs, for the host's architecture (arm64: bin/box-arm64-vm
#                                      smoke)
#        bin/arbace-go --box [ARG...]  run the box's launcher (built first when missing)
# Environment:
#   ARBACE_GO_ARCH    the architecture run (default amd64)
#   ARBACE_GO_ARCHES  the architectures built and smoke-tested (default amd64,arm64)
#   ARBACE_GO_SYMBOLS 1: keep the executables' symbol table and DWARF (stripped by default),
#                     and the box guest's whole symbol table (cut to the monitor's symbols by
#                     default: tools/elfsyms)
#   ARBACE_BOX_ARCHES the box's architectures built (default amd64; arm64 runs on KVM/arm64, in the
#                     aarch64 VM here (bin/box-arm64-vm), or Hypervisor.framework: S4)
#   ARBACE_BOX_GO     the box guest's own Go (amd64, arm64): forms (default), TamaGo's std and goos
#                     module printed from tamago/ (bin/tamago-vendor print, into
#                     target/arbace-go/tamago); orig, the toolchain's tree and Go's module cache
#   ARBACE_BOX_*      the launcher's settings (box/go/arbace/box/cmd/arbace_box/main.ae: CPUS,
#                     WATCHDOG, STATS, IMAGE, ...)
#   ARBACE_PATH       directories (separated by :) where RT.load finds namespaces after the
#                     sources embedded in the executable (the JVM's class path)
#   ARBACE_AOT        1 (default): the namespaces compiled into the program (standalone S6,
#                     doc/STANDALONE-NOTES.md, "S6: Arbace compiled to Go"): compiled by the
#                     host when its runtime is the checkout's (one j2g run), else by a first
#                     build of the program (two); 0: the namespaces evaluated (the image of
#                     prepared namespaces), as before S6
#   ARBACE_PROGRAM_BASE  --build-program: a shipped build to reuse (a --build's directory, or one
#                     holding arbace, aot/ and aot.key, as .tmp/arbace-go-gate/amd64), when its
#                     compiled namespaces' key is the checkout's; ARBACE_PROGRAM_KEEP=1 keeps the
#                     program's intermediate trees (c2j's, j2g's, the work modules)
#   ARBACE_HOST_EXE   the executable that runs the build's Arbace tools, j2g and repr/go (bin/lib/
#                     host.bash; default stage 0, target/seed/<arch>/arbace, which bin/seed --build
#                     makes from the seed when missing); J2G_GO_EXE and REPR_GO_EXE name one per tool
# The build reads the JDK's Java forms and resource data committed under jdk/ (bin/j2g;
# regenerated by bin/jrt-convert update), and the test build the suite's Java fixtures' forms
# committed under test/java-fixtures (regenerated by bin/clojure-tests --java-fixtures update);
# no JVM, javac or jdk26u's checkout. Exit status: the program's; for --build and --smoke 0 when
# all went well.
set -uo pipefail
export CGO_ENABLED=0 # Go's builds never use cgo (doc/go/BOX-NOTES.md, "... cgo dropped", 2026-10-16)
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash" # TMPDIR: .tmp/tmp when unset
discard=$TMPDIR/arbace-go.discard # stderr of probes whose failures are expected (a file, not the null device)
. "$root/bin/lib/renamed-env.bash" # stops on a stale G2A_*, J2A_*, A2G_* or C2A_*
. "$root/bin/lib/gocache.bash"
dir=$root/target/arbace-go
arch=${ARBACE_GO_ARCH:-amd64}
arches=${ARBACE_GO_ARCHES:-amd64,arm64}

# the build's environment for go build, as bin/build-go sets it (arbace.build.go/go-env):
# GOOS linux, or tamago (the box) with TamaGo's goos module as GOOSPKG
go_env() { # go_env ARCH [GOOS]
  local a=$1 goos=${2:-linux} goroot=${ARBACE_GOROOT:-/root/tamago-go}
  echo GOROOT="$goroot" GOTOOLCHAIN=local GOFLAGS= GOWORK=off GO111MODULE=on GOPROXY=off \
    GOEXPERIMENT= CGO_ENABLED=0 GOOS="$goos" GOARCH="$a" \
    "$( [ "$a" = amd64 ] && echo GOAMD64=v1 || echo GOARM64=v8.0 )" \
    $( [ "$goos" = tamago ] && echo GOOSPKG=github.com/usbarmory/tamago )
}

# the linker's flags of the executables' final links (image, pgo_build), set in ldflags by
# link_flags: without the symbol table and DWARF (-s -w; amendment SZ1): Go's own tables
# (pclntab), which panics' traces, jrt's stack traces and profiles read, stay;
# ARBACE_GO_SYMBOLS=1 keeps them (go tool nm, debuggers). And Arbace's version
# (bin/lib/version.bash; J2G-SPEC §10.6): the main package's arbaceVersion, set with -X, read
# from the checkout (or VERSION in a tarball) at link time, so j2g's output and the image of
# prepared namespaces hold none. The first link (bin/build-go) leaves it empty: its executable
# only prepares the image
. "$root/bin/lib/version.bash"
. "$root/bin/lib/javac-key.bash"
. "$root/bin/lib/box-overlay.bash"
link_flags() {
  local v f
  v=$(arbace_version "$root") || return 1
  f="-X 'main.arbaceVersion=$v'"
  [ "${ARBACE_GO_SYMBOLS:-}" = 1 ] || f="-s -w $f"
  ldflags=("-ldflags=$f")
}

# the seconds since $1 (date +%s)
since() { echo "$(( $(date +%s) - $1 )) s"; }

# what a build makes: the shipped executable (the defaults), or the test build (--build-tests:
# its own j2g output, work modules, executables and logs, beside the shipped one's)
variant=          # "" or "-tests"
j2g_args=()       # bin/j2g's extra arguments (--input DIR for the test build)
exe=arbace        # the executable's name in target/arbace-go/<arch>/

build() {
  mkdir -p "$dir"
  local t0
  t0=$(date +%s)
  # Go's build cache, trimmed before each build (bin/lib/gocache.bash)
  gocache_trim "${ARBACE_GOROOT:-/root/tamago-go}/bin/go" >&2
  build_go_print_cache_trim "$root/.tmp/repr-go-print-cache"
  local hostexe
  hostexe=${J2G_GO_EXE:-$(. "$root/bin/lib/host.bash" && arbace_host_exe)} || return 1
  # goi's table of compiled packages (doc/go/GOI-SPEC.md §6), for every configuration, by the
  # host (bin/goi table; kept when its inputs are unchanged): j2g puts it in the program
  echo "== bin/goi table (on $hostexe)" >&2
  (cd "$root" && GOI_EXE=$hostexe bin/goi table --out "$dir/gotable") > "$dir/gotable.log" 2>&1 \
    || { tail -20 "$dir/gotable.log" >&2; echo "arbace-go: goi's table failed ($dir/gotable.log)" >&2; return 1; }
  # standalone S6, one j2g run (SA144): a host of the checkout's runtime (its version's
  # :runtime, bin/lib/version.bash) compiles the checkout's namespaces itself, as the program
  # built from them would
  local saved1=("${j2g_args[@]}") onepass= j2g_pid=
  if [ "${ARBACE_AOT:-1}" = 1 ] && [ -z "${aot_phase2:-}" ] && [ -n "$variant" ] && aot_reusable "$hostexe"; then
    # the test build: the shipped build's compiled namespaces, when made from the same
    # namespaces and runtime (SA157)
    echo "== the namespaces compiled: the shipped build's ($dir/aot, key ${aot_key:0:12})" >&2
    onepass=1
    j2g_args+=(--input "$dir/aot")
  elif [ "${ARBACE_AOT:-1}" = 1 ] && [ -z "${aot_phase2:-}" ] && host_compiles "$hostexe"; then
    # j2g started at once: it loads the runtime and analyzes it while the host compiles the
    # namespaces, and reads them when they are there (--await: DIR/aot.edn, the compiling's
    # last file)
    onepass=1
    rm -rf "$dir/aot$variant" "$dir/aot$variant.key"
    echo "== bin/j2g --program ${j2g_args[*]} --await $dir/aot$variant (on $hostexe), at the same time" >&2
    (cd "$root" && bin/j2g --program "${j2g_args[@]}" --gotable "$dir/gotable" --await "$dir/aot$variant" --out "$dir/j2g$variant") > "$dir/j2g$variant.log" 2>&1 &
    j2g_pid=$!
    if ! host_compile "$hostexe" "$dir/aot$variant"; then
      kill "$j2g_pid" 2>"$discard"; wait "$j2g_pid" 2>"$discard"
      return 1
    fi
    aot_key_write "$dir/aot$variant"
  fi
  if [ -n "$j2g_pid" ]; then
    wait "$j2g_pid" \
      || { tail -20 "$dir/j2g$variant.log" >&2; echo "arbace-go: j2g failed ($dir/j2g$variant.log)" >&2; return 1; }
  else
    echo "== bin/j2g --program ${j2g_args[*]} (on $hostexe)" >&2
    (cd "$root" && bin/j2g --program "${j2g_args[@]}" --gotable "$dir/gotable" --out "$dir/j2g$variant") > "$dir/j2g$variant.log" 2>&1 \
      || { tail -20 "$dir/j2g$variant.log" >&2; echo "arbace-go: j2g failed ($dir/j2g$variant.log)" >&2; return 1; }
  fi
  echo "   j2g: $(since "$t0")" >&2
  local overlay host
  overlay=$(cd "$root" && bin/jrt overlay | tail -1) || return 1
  host=$(host_arch)
  # the architectures at once (each its own work module and log; the print cache's entries are
  # written atomically, and Go's build cache is shared safely)
  local pids=() archs=() st=0 i
  t0=$(date +%s)
  for a in $(build_order); do
    echo "== bin/build-go $a" >&2
    mkdir -p "$dir/$a"
    (cd "$root" && bin/build-go --line-file --arch "$a" --work "$dir/work$variant-$a" -o "$dir/$a/$exe" \
       --print-cache "$root/.tmp/repr-go-print-cache" \
       --overlay "$overlay" --root "$root/x509roots" "$dir/j2g$variant/prog") > "$dir/build$variant-$a.log" 2>&1 &
    pids+=($!); archs+=("$a")
  done
  for i in "${!pids[@]}"; do
    a=${archs[$i]}
    if wait "${pids[$i]}"; then
      echo "   build-go $a: $(since "$t0")" >&2
    else
      grep -v '^==' "$dir/build$variant-$a.log" | tail -20 >&2; echo "arbace-go: $a: build failed" >&2; st=1
    fi
  done
  [ $st = 0 ] || return 1
  if [ -n "$onepass" ]; then j2g_args=("${saved1[@]}"); fi
  if [ "${ARBACE_AOT:-1}" = 1 ] && [ -z "${aot_phase2:-}" ] && [ -z "$onepass" ]; then
    # standalone S6: the program just built prepares its namespaces and compiles them to class
    # forms ($dir/aot$variant); j2g translates the program again with them, and that program,
    # built and given the image of what stays evaluated, is the build's
    echo "== the namespaces compiled (arbace.c2j)" >&2
    t0=$(date +%s)
    aot_out=$dir/aot$variant prepare "$dir/$(host_arch)/$exe" "$dir/aot$variant.image" || return 1
    aot_key_write "$dir/aot$variant"
    echo "   compiled: $(since "$t0")" >&2
    local saved=("${j2g_args[@]}")
    j2g_args+=(--input "$dir/aot$variant")
    # j2g and repr/go run again on the host, or on that first program when the host has no id
    # spaces (a program older than S6: RT.ID_SPACE, SA143), so that the second run translates as
    # a one-run build's host would
    local host2=$hostexe
    if [ "$(env -u ARBACE_NO_AOT "$hostexe" -e '(print (some? (try (.getField arbace.lang.RT "ID_SPACE") (catch Throwable _ nil))))' 2>"$discard")" != true ]; then
      cp "$dir/$(host_arch)/$exe" "$dir/aot-host$variant"
      host2=$dir/aot-host$variant
    fi
    J2G_GO_EXE=$host2 REPR_GO_EXE=$host2 aot_phase2=1 build
    local st=$?
    j2g_args=("${saved[@]}")
    return $st
  fi
  image || return 1
  # what printed the module (bin/seed --make records it in the seed's SEED.edn)
  [ -n "$variant" ] || echo "bin/arbace-go --build: j2g and repr/go on the host executable" > "$dir/printed-by"
  [ "${pgo:-}" ] || return 0
  pgo_build
}

# aot_key: what the compiled namespaces' tree is a function of (standalone S6, SA144, SA157):
# the runtime key (bin/lib/version.bash; the program that compiles them has that runtime) and
# Arbace's sources (the namespaces compiled and the back end, arbace.c2j, which compiles them)
aot_key() {
  (cd "$root" && { arbace_runtime_key "$root"; find arbace -type f | LC_ALL=C sort | xargs -d '\n' sha256sum; } \
     | sha256sum | cut -c1-64)
}

# aot_key_write DIR: records the key of the tree DIR just made, in DIR.key
aot_key_write() { aot_key > "$1.key"; }

# aot_reusable HOST: does the shipped build's tree ($dir/aot) hold what the test build would
# compile (its key the checkout's)? Not when HOST has no id spaces (a program older than S6:
# the test build then compiles as before, SA151); sets aot_key
aot_reusable() {
  [ -f "$dir/aot/packages.edn" ] && [ -f "$dir/aot.key" ] || return 1
  aot_key=$(aot_key)
  [ "$(cat "$dir/aot.key")" = "$aot_key" ] || return 1
  [ "$(env -u ARBACE_NO_AOT "$1" -e '(print (some? (try (.getField arbace.lang.RT "ID_SPACE") (catch Throwable _ nil))))' 2>"$discard")" = true ]
}

# host_compile HOST OUT: the checkout's namespaces compiled to Java forms into OUT by HOST, when
# HOST's runtime is the checkout's (the :runtime of its version map, SA144): HOST prepares them
# from the checkout's sources (ARBACE_PATH_FIRST, as embedded ones, analyzed afresh: no compiled
# loader, no image), in the order the program's namespaces.txt lists them, then arbace.c2j
# compiles the units (host_compiles first: status 1 when HOST's runtime differs); status 2 when
# the compiling failed
host_compiles() {
  local host=$1 key hkey
  . "$root/bin/lib/version.bash"
  key=$(arbace_runtime_key "$root")
  hkey=$(env -u ARBACE_NO_AOT "$host" -e '(print (:runtime *arbace-version*))' 2>"$discard")
  # ARBACE_AOT_ONEPASS=force: one run whatever the host (measurements; not for a fixpoint)
  if [ "$key" != "$hkey" ] && [ "${ARBACE_AOT_ONEPASS:-}" != force ]; then
    echo "== the namespaces compiled after a first build (the host's runtime is not the checkout's)" >&2
    return 1
  fi
}
host_compile() {
  local host=$1 out=$2 nss t0
  t0=$(date +%s)
  echo "== the namespaces compiled by the host (arbace.c2j; its runtime is the checkout's)" >&2
  mkdir -p "$dir"
  # the embedded namespaces as j2g lists them (namespaces.txt)
  nss=$(cd "$root" && ARBACE_PATH=$root "$host" -e '(require (quote arbace.j2g.embed) (quote arbace.string))
(doseq [[p text] (sort (arbace.j2g.embed/sources "."))
        :when (and (arbace.string/starts-with? p "arbace/") (arbace.string/ends-with? p ".ae") (re-find #"(?m)^\(ns( |$)" text))]
  (println (-> (subs p 0 (- (count p) 3)) (arbace.string/replace "/" ".") (arbace.string/replace "_" "-"))))' | tr '
' ' ') || return 1
  rm -rf "$out"
  printf '(doseq [n (quote [%s])]
  (try (require n) (catch Throwable e (println "image: not prepared:" n (.getMessage e)))))
(require (quote arbace.c2j.main))
(let [r (arbace.c2j.main/run "%s" nil)]
  (println "aot:" (count (:compiled r)) "sources compiled," (:classes r) "classes;" (count (:failed r)) "failed")
  (doseq [[s m] (:failed r)] (println "aot: not compiled:" s m)))
' "$nss" "$out"     > "$dir/host-compile$variant.ae"
  (cd "$root" && GOGC=${GOGC:-400} ARBACE_COMPILE=1 ARBACE_NO_AOT=1 ARBACE_NO_IMAGE=1 ARBACE_PATH_FIRST=1 \
     ARBACE_PATH=$root ARBACE_AOT_ROOT=$root ARBACE_PREPARE=$dir/host-compile$variant.image \
     "$host" "$dir/host-compile$variant.ae") > "$dir/host-compile$variant.log" 2>&1 \
    || { tail -20 "$dir/host-compile$variant.log" >&2; echo "arbace-go: the host's compilation failed" >&2; return 2; }
  grep '^aot:' "$dir/host-compile$variant.log" >&2
  [ -f "$out/packages.edn" ] || { echo "arbace-go: the host compiled nothing ($dir/host-compile$variant.log)" >&2; return 2; }
  echo "   compiled: $(since "$t0")" >&2
}

# pgo_build: the training run of the host's executable with a CPU profile, then each
# architecture's executable built again with it (the profile names functions, so the host's
# serves the others; the image stays in each work module)
pgo_build() {
  local overlay t0 a
  overlay=$(cd "$root" && bin/jrt overlay | tail -1) || return 1
  link_flags || return 1
  t0=$(date +%s)
  echo "== the training run (test/arbace-go-pgo.ae)" >&2
  rm -f "$dir/pgo.pprof"
  ARBACE_CPUPROFILE=$dir/pgo.pprof "$dir/$(host_arch)/arbace" "$root/test/arbace-go-pgo.ae" > "$dir/pgo.log" 2>&1 \
    || { tail -20 "$dir/pgo.log" >&2; echo "arbace-go: the training run failed ($dir/pgo.log)" >&2; return 1; }
  echo "   training: $(since "$t0")" >&2
  for a in $(build_order); do
    t0=$(date +%s)
    (cd "$dir/work-$a/mod" && env $(go_env "$a") "${ARBACE_GOROOT:-/root/tamago-go}/bin/go" build -trimpath \
       -buildvcs=false "${ldflags[@]}" -overlay "$overlay" -pgo "$dir/pgo.pprof" -o "$dir/$a/arbace" arbace/cmd/arbace) >> "$dir/build-$a.log" 2>&1 \
      || { tail -20 "$dir/build-$a.log" >&2; echo "arbace-go: $a: the profile-guided build failed" >&2; return 1; }
    echo "arbace-go: $dir/$a/arbace ($(stat -c %s "$dir/$a/arbace") bytes, profile-guided; built in $(since "$t0"))" >&2
  done
}

host_arch() { case $(uname -m) in aarch64) echo arm64 ;; *) echo amd64 ;; esac; }

# the host's architecture first: its executable prepares the namespaces
build_order() {
  local host order
  host=$(host_arch); order=$host
  for a in ${arches//,/ }; do [ "$a" = "$host" ] || order="$order $a"; done
  echo $order
}

# image: prepare the namespaces with the host's executable (built without an image or with
# a previous one, which preparing ignores), then link each architecture's executable again
# with the image, the main package's embedded file (the other packages are in go build's
# cache: only the main package changes)
image() {
  local overlay main=$dir/j2g$variant/prog/go/arbace/cmd/arbace a
  overlay=$(cd "$root" && bin/jrt overlay | tail -1) || return 1
  local t0
  t0=$(date +%s)
  prepare "$dir/$(host_arch)/$exe" "$main/image.bin" || return 1
  link_flags || return 1
  echo "   prepare: $(since "$t0")" >&2
  for a in $(build_order); do
    t0=$(date +%s)
    [ -d "$dir/work$variant-$a/mod" ] || { echo "arbace-go: $a: not built" >&2; return 1; }
    cp "$main/image.bin" "$dir/work$variant-$a/mod/cmd/arbace/image.bin"
    (cd "$dir/work$variant-$a/mod" && env $(go_env "$a") "${ARBACE_GOROOT:-/root/tamago-go}/bin/go" build -trimpath \
       -buildvcs=false "${ldflags[@]}" -overlay "$overlay" -o "$dir/$a/$exe" arbace/cmd/arbace) >> "$dir/build$variant-$a.log" 2>&1 \
      || { tail -20 "$dir/build$variant-$a.log" >&2; echo "arbace-go: $a: link with the image failed" >&2; return 1; }
    echo "arbace-go: $dir/$a/$exe ($(stat -c %s "$dir/$a/$exe") bytes; linked in $(since "$t0"))" >&2
  done
}

# build_tests [DIR]: the test build, the program with the Java forms of DIR (default: the
# suite's Java fixtures as committed, test/java-fixtures/forms; bin/clojure-tests
# --java-fixtures verify proves them repr/java's output), into target/arbace-go/<arch>/arbace-tests
build_tests() {
  local fx=${1:-$root/test/java-fixtures/forms} t0
  t0=$(date +%s)
  [ -d "$fx" ] || { echo "arbace-go: --build-tests: no directory $fx" >&2; return 1; }
  echo "== the Java forms of $fx" >&2
  fx=$(cd "$fx" && pwd)
  variant=-tests exe=arbace-tests j2g_args=(--input "$fx")
  build || return 1
  echo "arbace-go: the test build in $(since "$t0")" >&2
}

# reader_key: what repr/java's reader compiled for javac's tool ($dir/aot-reader) is a function of:
# the compiled namespaces' key (aot_key: the runtime, Arbace's sources, c2j among them) and
# javac's world, whose classes the reader's code names (jdk/javac, overlay/jdk/javac, the edges)
reader_key() {
  (cd "$root" && { aot_key; find jdk/javac overlay/jdk/javac jdk/edge.edn -type f | LC_ALL=C sort | xargs -d '\n' sha256sum; } \
     | sha256sum | cut -c1-64)
}

# reader_compile TOOL OUT: repr/java's namespaces (arbace/repr/java{.ae,/}) compiled to Java forms
# by c2j into OUT, on TOOL (a javac tool executable of the checkout's runtime, whose world holds
# the javac classes the reader names): loaded from the checkout as embedded sources
# (ARBACE_PATH_FIRST), the program's own compiled namespaces kept, so that only the reader's
# units are recorded (each source in its own id space)
reader_compile() {
  local tool=$1 out=$2 nss t0
  t0=$(date +%s)
  echo "== repr/java's reader compiled (arbace.c2j, on $tool)" >&2
  nss=$(cd "$root" && find arbace/repr/java.ae arbace/repr/java -name '*.ae' | LC_ALL=C sort | sed 's/\.ae$//; s|/|.|g; s/_/-/g' | tr '\n' ' ')
  rm -rf "$out"
  printf '(doseq [n (quote [%s])] (require n))
(require (quote arbace.c2j.main))
(let [srcs (vec (distinct (filter #(re-find #"^arbace/repr/java[./]" %%) (map #(aget ^objects %% 0) (arbace.lang.Compiler$AST/units)))))
      r (arbace.c2j.main/run "%s" srcs)]
  (println "aot:" (count (:compiled r)) "sources compiled," (:classes r) "classes;" (count (:failed r)) "failed")
  (doseq [[s m] (:failed r)] (println "aot: not compiled:" s m))
  (System/exit (if (seq (:failed r)) 1 0)))
' "$nss" "$out" > "$dir/reader-compile.ae"
  (cd "$root" && GOGC=${GOGC:-400} ARBACE_COMPILE=1 ARBACE_NO_IMAGE=1 ARBACE_PATH_FIRST=1 ARBACE_PATH=$root \
     ARBACE_AOT_ROOT=$root ARBACE_PREPARE=$dir/reader-compile.image "$tool" "$dir/reader-compile.ae") \
    > "$dir/reader-compile.log" 2>&1 \
    || { tail -20 "$dir/reader-compile.log" >&2; echo "arbace-go: repr/java's reader was not compiled" >&2; return 1; }
  grep '^aot:' "$dir/reader-compile.log" >&2
  [ -f "$out/packages.edn" ] || { echo "arbace-go: the reader compiled nothing ($dir/reader-compile.log)" >&2; return 1; }
  echo "   compiled: $(since "$t0")" >&2
}

# build_java DIR...: javac's tool build (--build-java)
build_java() {
  local t0 d extra=() saved rkey jkey a
  t0=$(date +%s)
  # the key of the tool's sources (bin/lib/javac-key.bash, JFS30 (b)), recorded beside each
  # executable when it is built: the provenance files repr/java writes on it name it
  jkey=$(arbace_javac_key "$root")
  for a in ${arches//,/ }; do rm -f "$dir/$a/arbace-javac.key"; done
  [ -d "$root/jdk/javac/forms" ] || { echo "arbace-go: --build-java: no jdk/javac/forms (bin/javac-vendor convert)" >&2; return 1; }
  # shellcheck disable=SC2206
  extra=(${J2G_JAVA_ARGS:-})
  variant=-javac exe=arbace-javac
  j2g_args=(--input "$root/jdk/javac/forms" --variants "$root/overlay/jdk/javac/variants"
            --edge "$root/jdk/edge.edn" --edge "$root/jdk/javac/edge.edn")
  for d in "$@"; do
    [ -d "$d" ] || { echo "arbace-go: --build-java: no directory $d" >&2; return 1; }
    j2g_args+=(--input "$(cd "$d" && pwd)")
  done
  j2g_args+=("${extra[@]}")
  if [ "${ARBACE_AOT:-1}" = 1 ]; then
    # repr/java's reader compiled into the tool (doc/classes/JAVA-FRONTEND-SURVEY.md, "As built:
    # JN4", JFS28): by a first tool build when the compiled reader's tree is not of this key
    rkey=$(reader_key)
    if [ "$(cat "$dir/aot-reader.key" 2>"$discard")" != "$rkey" ] || [ ! -f "$dir/aot-reader/packages.edn" ]; then
      echo "== javac's tool build, first (the host that compiles repr/java's reader): ${j2g_args[*]}" >&2
      rm -f "$dir/aot-reader.key"
      saved=("${j2g_args[@]}")
      build || return 1
      j2g_args=("${saved[@]}")
      reader_compile "$dir/$(host_arch)/$exe" "$dir/aot-reader" || return 1
      echo "$rkey" > "$dir/aot-reader.key"
    else
      echo "== repr/java's reader compiled: $dir/aot-reader (key ${rkey:0:12})" >&2
    fi
    j2g_args+=(--input "$dir/aot-reader" --embed arbace/repr/java)
  fi
  echo "== javac's tool build: ${j2g_args[*]}" >&2
  build || return 1
  for a in ${arches//,/ }; do echo "$jkey" > "$dir/$a/$exe.key"; done
  echo "arbace-go: javac's tool build in $(since "$t0") (key ${jkey:0:12}, $exe.key)" >&2
}

# ---------------------------------------------------------------------------------------
# A user's program (REAP7, doc/FULL-SUPPORT-SURVEY.md, "As built: REAP7"; doc/go/BUILD.md, "A
# user's program"): bin/arbace-go --build-program DIR, the tool bin/clojure-tests --aot and
# bin/java-check's compiled level build for their corpora, made general. DIR:
#   program.edn  {:main NS} (a Clojure program: NS's -main), {:main-class CLASS} (a Java forms
#                program: CLASS's static main), or neither (a Go program); :name, the executable's
#                name (default DIR's); a Go program's :module and :go (bin/build-go's)
#   src/         Clojure namespaces (.ae, .clj, .cljc) and resources, as a directory of the class
#                path: compiled by c2j (the namespaces) and embedded
#   java/        Java forms (doc/classes/SPEC.md §9.2: a package's ns file, its classes' files),
#                translated by j2g: classes of the program, which namespaces import
#   go/          Go forms (doc/go/SPEC.md §4.1): with :main or :main-class, namespaces of Go forms
#                (go.P) embedded as go/..., interpreted by goi at run time; without, a Go program
#                built by arbace.build.go alone
#   runs/        the program's runs for --check (bin/build-go test's format)
# The executable: target/arbace-go/programs/NAME/ARCH/NAME (-o OUT: there too), cached by the key
# of what it is built from (programs/NAME/key)

programs=$dir/programs

# program_edn DIR: program.edn's :main, :main-class and :name, one per line (empty when absent),
# read by the tools' host with the Clojure reader; status 1 on an unknown key
program_edn() {
  local exe
  exe=$(. "$root/bin/lib/host.bash" && arbace_host_exe) || return 1
  "$exe" -e "(let [f (java.io.File. \"$1/program.edn\")
      m (if (.isFile f) (read-string (slurp f)) {})
      bad (remove #{:main :main-class :name :module :go} (keys m))]
  (when-not (map? m) (println \"program.edn: not a map\") (System/exit 1))
  (when (seq bad) (println \"program.edn: unknown keys\" (vec bad)) (System/exit 1))
  (when (and (:main m) (:main-class m)) (println \"program.edn: :main and :main-class\") (System/exit 1))
  (doseq [k [:main :main-class :name]] (println (str (get m k \"\")))))"
}

# program_base: the shipped build whose compiled namespaces the program reuses (sets base_exe,
# base_aot): ARBACE_PROGRAM_BASE (a --build's directory, or a directory holding arbace, aot/ and
# aot.key, as the gate's cache), else target/arbace-go, else the gate's cache .tmp/arbace-go-gate/
# amd64, the first whose compiled namespaces' key is the checkout's (aot_key: the runtime and
# Arbace's sources) and whose executable's runtime is the checkout's; else a --build for the
# host's architecture first
program_base() {
  local k rk c e
  k=$(aot_key); rk=$(arbace_runtime_key "$root")
  for c in ${ARBACE_PROGRAM_BASE:-} "$dir" "$root/.tmp/arbace-go-gate/amd64"; do
    e=$c/$(host_arch)/arbace; [ -x "$e" ] || e=$c/arbace
    [ -x "$e" ] && [ -f "$c/aot/packages.edn" ] && [ -f "$c/aot.key" ] && [ "$(cat "$c/aot.key")" = "$k" ] || continue
    mkdir -p "$programs"
    [ "$(env -u ARBACE_NO_AOT "$e" -e '(print (:runtime *arbace-version*))' 2> "$programs/.runtime.err")" = "$rk" ] || continue
    base_exe=$e base_aot=$c/aot
    echo "== the shipped build's compiled namespaces: $base_aot (key ${k:0:12}; $base_exe)" >&2
    return 0
  done
  echo "== no shipped build of the checkout's compiled namespaces (key ${k:0:12}): --build for $(host_arch) first" >&2
  (arches=$(host_arch) build) || return 1
  base_exe=$dir/$(host_arch)/arbace base_aot=$dir/aot
}

# program_key SRC GOTABLE: what the executable of SRC is built from (beside the base's executable
# and compiled namespaces): SRC's files, goi's table, the runtime and the build's scripts
program_key() {
  { sha256sum < "$base_exe"; cat "$base_aot/../aot.key"; echo "$base_aot"
    cat "$2/key"
    (cd "$1" && find . -type f ! -path './runs/*' | LC_ALL=C sort | xargs -d '\n' sha256sum)
    arbace_runtime_key "$root"
    (cd "$root" && find x509roots jdk/edge.edn -type f | LC_ALL=C sort | xargs -d '\n' sha256sum
     sha256sum bin/arbace-go bin/j2g bin/build-go)
    cat "${ARBACE_GOROOT:-/root/tamago-go}/VERSION"; echo "${ARBACE_GO_SYMBOLS:-}"; } | sha256sum | cut -c1-64
}

# build_program DIR [--arch ARCH[,ARCH]] [-o OUT]
build_program() {
  local src="" out="" parch main cls name w t0 t1 a nss jnss usrc go_prog
  parch=$(host_arch)
  while [ $# -gt 0 ]; do
    case $1 in
      --arch) parch=$2; shift 2 ;;
      -o) out=$2; shift 2 ;;
      -*) echo "arbace-go --build-program: unknown option $1" >&2; return 2 ;;
      *) [ -z "$src" ] || { echo "arbace-go --build-program: one DIR" >&2; return 2; }; src=$1; shift ;;
    esac
  done
  [ -n "$src" ] && [ -d "$src" ] || { echo "arbace-go --build-program: no program directory ${src:-(none)}" >&2; return 2; }
  src=$(cd "$src" && pwd)
  t0=$(date +%s)
  mkdir -p "$programs"
  local edn=$programs/.program-edn.$$
  if ! program_edn "$src" > "$edn" 2>&1; then
    echo "arbace-go --build-program: $src/$(head -1 "$edn")" >&2; rm -f "$edn"; return 1
  fi
  { read -r main; read -r cls; read -r name; } < "$edn"
  rm -f "$edn"
  [ -n "$name" ] || name=$(basename "$src")
  w=$programs/$name
  mkdir -p "$w"
  link_flags || return 1
  if [ -z "$main" ] && [ -z "$cls" ]; then
    # a Go program: arbace.build.go alone
    [ -d "$src/go" ] || { echo "arbace-go --build-program: $src: no :main, no :main-class and no go/" >&2; return 1; }
    for a in src java; do
      [ ! -d "$src/$a" ] || { echo "arbace-go --build-program: $src/$a/ needs :main or :main-class (program.edn)" >&2; return 1; }
    done
    for a in ${parch//,/ }; do
      mkdir -p "$w/$a"
      echo "== bin/build-go $a (a Go program: $src)" >&2
      (cd "$root" && bin/build-go --line-file --arch "$a" --work "$w/work-$a" -o "$w/$a/$name" \
         --print-cache "$root/.tmp/repr-go-print-cache" --go-flag "-ldflags=-s -w" "$src") > "$w/build-$a.log" 2>&1 \
        || { grep -v '^==' "$w/build-$a.log" | tail -20 >&2; echo "arbace-go: $name: $a: the build failed ($w/build-$a.log)" >&2; return 1; }
      program_done "$a" ""
    done
    return 0
  fi
  # an Arbace program: the shipped build's compiled namespaces, the program's compiled by c2j,
  # its Go packages compiled through a goi table of its own, j2g, bin/build-go
  program_base || return 1
  # src/'s .clj and .cljc sources translated into .ae by repr/clojure first (RPS94 (c), as
  # bin/clojure-tests translates the suite): the tree compiled and embedded is then
  # programs/NAME/src
  local ssrc=
  if [ -d "$src/src" ]; then
    ssrc=$src/src
    if [ -n "$(cd "$src/src" && find . -type f \( -name '*.clj' -o -name '*.cljc' \) | head -1)" ]; then
      ssrc=$w/src
      echo "== bin/repr-clojure read -o $ssrc $src/src (the .clj and .cljc sources into .ae)" >&2
      rm -rf "$ssrc"
      (cd "$root" && bin/repr-clojure read -q -o "$ssrc" "$src/src") > "$w/repr-clojure.log" 2>&1 \
        || { tail -20 "$w/repr-clojure.log" >&2; echo "arbace-go: $name: repr/clojure failed ($w/repr-clojure.log)" >&2; return 1; }
    fi
  fi
  # goi's table: with go/, a table of the program's own (RPS92 (b)): its Go packages listed with
  # the list's, compiled into the program (printed into the module by bin/build-go --root DIR); a
  # package that does not check for the table is left to goi (embedded as go/..., interpreted, as
  # REAP7 built them: RPS92 (a), the fallback)
  local gotable=$dir/gotable configs="" goi_interp=
  if [ -d "$src/go" ]; then
    gotable=$w/gotable
    for a in ${parch//,/ }; do configs+=${configs:+,}linux/$a; done
    local gopaths
    gopaths=$(cd "$src/go" && grep -rlE '^\(ns( |$)' --include='*.ae' . | LC_ALL=C sort | xargs -r -d '\n' grep -h -o ':path "[^"]*"' | sed 's/^:path //' | tr '\n' ' ')
    printf '{:packages [%s]}\n' "${gopaths% }" > "$w/gotable-program.edn"
    echo "== bin/goi table --program-list $w/gotable-program.edn --program-root $src (on $base_exe; $(cat "$w/gotable-program.edn"))" >&2
    (cd "$root" && GOI_EXE=$base_exe bin/goi table --out "$gotable" --configs "$configs" \
       --program-list "$w/gotable-program.edn" --program-root "$src") > "$w/gotable.log" 2>&1 \
      || { tail -20 "$w/gotable.log" >&2; echo "arbace-go: $name: goi's table failed ($w/gotable.log)" >&2; return 1; }
    goi_interp=$(env -u ARBACE_NO_AOT "$base_exe" -e "(apply print (keys (:refused-program (read-string (slurp \"$gotable/report.edn\")))))" 2> "$w/gotable-report.err") \
      || { cat "$w/gotable-report.err" >&2; return 1; }
    if [ -n "$goi_interp" ]; then
      echo "arbace-go: $name: warning: Go packages that do not check for the table, interpreted by goi: $goi_interp ($gotable/report.edn)" >&2
    else
      echo "   the Go packages compiled: $(sed 's/^{:packages \[//; s/\]}$//' "$w/gotable-program.edn")" >&2
    fi
  else
    echo "== bin/goi table (on $base_exe)" >&2
    (cd "$root" && GOI_EXE=$base_exe bin/goi table --out "$gotable") > "$w/gotable.log" 2>&1 \
      || { tail -20 "$w/gotable.log" >&2; echo "arbace-go: goi's table failed ($w/gotable.log)" >&2; return 1; }
  fi
  local key; key=$(program_key "$src" "$gotable")
  local cached=1
  for a in ${parch//,/ }; do [ -x "$w/$a/$name" ] || cached=; done
  if [ -n "$cached" ] && [ -f "$w/key" ] && [ "$(cat "$w/key")" = "$key" ]; then
    echo "== the cached program (key ${key:0:12})" >&2
    for a in ${parch//,/ }; do program_done "$a" cached; done
    return 0
  fi
  rm -rf "$w/key" "$w/aot" "$w/j2g" "$w"/work-*
  local j2g_in=(--input "$base_aot") go_root=()
  if [ -n "$main" ]; then
    [ -n "$ssrc" ] || { echo "arbace-go --build-program: $src: :main $main but no src/" >&2; return 1; }
    j2g_in+=(--entry-arg -m --entry-arg "$main" --resources "$ssrc")
  else
    j2g_in+=(--entry "$cls")
  fi
  if [ -d "$src/go" ]; then
    go_root=(--root "$src")
    [ -z "$goi_interp" ] || j2g_in+=(--resources "$src/go=go")
  fi
  # java/'s package namespaces embedded as no-op loaders (RPS93 (c))
  [ ! -d "$src/java" ] || j2g_in+=(--java-namespaces "$src/java")
  if [ -n "$ssrc" ]; then
    # the program's namespaces (src/'s, and go/'s that they load when goi interprets them)
    # compiled by c2j on the base's executable, as bin/arbace-go --build-java compiles repr/java's
    # reader: the runtime's from their compiled loaders, the program's sources
    # (ARBACE_PATH_FIRST) recorded as embedded ones, java/'s packages loaded first (their
    # classes, which the namespaces import); only the program's units compiled (src/'s, and
    # go/'s interpreted ones); a namespace of src/ requiring a Java package's namespace warned
    # of (RPS93: a no-op loader in the program)
    t1=$(date +%s)
    echo "== the program's namespaces compiled (arbace.c2j, on $base_exe)" >&2
    nss=$(cd "$ssrc" && grep -rlE '^\(ns( |$)' --include='*.ae' . | LC_ALL=C sort \
            | sed 's|^\./||; s/\.ae$//; s|/|.|g; s/_/-/g' | tr '\n' ' ')
    jnss=$( [ -d "$src/java" ] && cd "$src/java" && grep -rlE '^\(ns( |$)' --include='*.ae' . | LC_ALL=C sort \
            | sed 's|^\./||; s/\.ae$//; s|/|.|g; s/_/-/g' | tr '\n' ' ')
    usrc=$( { (cd "$ssrc" && find . -type f -name '*.ae') | sed 's|^\./||'
              [ ! -d "$src/go" ] || [ -z "$goi_interp" ] || (cd "$src/go" && find . -type f -name '*.ae') | sed 's|^\./|go/|'; } \
            | LC_ALL=C sort | sed 's/.*/"&"/' | tr '\n' ' ')
    printf '(doseq [n (quote [%s])] (require n))
(let [jns (set (quote [%s]))
      libs (fn [form] (for [c (rest form) :when (and (seq? c) (= :require (first c)))
                            x (rest c)
                            l (cond (symbol? x) [x]
                                    (vector? x) [(first x)]
                                    (seq? x) (for [y (rest x)] (symbol (str (first x) "." (if (vector? y) (first y) y))))
                                    :else [])]
                        l))]
  (doseq [n (quote [%s])
          :let [form (try (read-string (slurp (str "%s/" (.replace (.replace (str n) "-" "_") "." "/") ".ae"))) (catch Throwable _ nil))]
          :when (and (seq? form) (= (quote ns) (first form)))
          l (libs form)
          :when (jns l)]
    (println "aot: warning:" n "requires the Java package" l "(a no-op loader in the program: its classes are the program'"'"'s, RPS93)")))
(doseq [n (quote [%s])]
  (try (require n) (catch Throwable e (println "aot: not loaded:" n (.getMessage e)) (System/exit 1))))
(require (quote arbace.c2j.main))
(let [srcs (vec (distinct (filter #{%s} (map #(aget ^objects %% 0) (arbace.lang.Compiler$AST/units)))))
      r (arbace.c2j.main/run "%s" srcs)]
  (println "aot:" (count (:compiled r)) "sources compiled," (:classes r) "classes;" (count (:failed r)) "failed")
  (doseq [[s m] (:failed r)] (println "aot: not compiled:" s m))
  (shutdown-agents)
  (System/exit 0))
' "$jnss" "$jnss" "$nss" "$ssrc" "$nss" "$usrc" "$w/aot" > "$w/compile.ae"
    (cd "$src" && GOGC=${GOGC:-400} ARBACE_COMPILE=1 ARBACE_NO_IMAGE=1 ARBACE_PATH_FIRST=1 \
       ARBACE_PATH=$ssrc${jnss:+:$src/java}:$src ARBACE_AOT_ROOT=$root ARBACE_PREPARE=$w/compile.image \
       "$base_exe" "$w/compile.ae") > "$w/compile.log" 2>&1 \
      || { tail -20 "$w/compile.log" >&2; echo "arbace-go: $name: the namespaces were not compiled ($w/compile.log)" >&2; return 1; }
    grep '^aot:' "$w/compile.log" >&2
    [ -f "$w/aot/packages.edn" ] || { echo "arbace-go: $name: c2j compiled nothing ($w/compile.log)" >&2; return 1; }
    echo "   compiled: $(since "$t1")" >&2
    j2g_in+=(--input "$w/aot")
  fi
  [ ! -d "$src/java" ] || j2g_in+=(--input "$src/java")
  t1=$(date +%s)
  echo "== bin/j2g --program ${j2g_in[*]} (on $base_exe)" >&2
  (cd "$root" && J2G_GO_EXE=$base_exe bin/j2g --program "${j2g_in[@]}" --gotable "$gotable" --out "$w/j2g") \
    > "$w/j2g.log" 2>&1 \
    || { tail -20 "$w/j2g.log" >&2; echo "arbace-go: $name: j2g failed ($w/j2g.log)" >&2; return 1; }
  grep '^j2g: error\|analysis failure' "$w/j2g.log" | head -20 >&2
  echo "   j2g: $(since "$t1")" >&2
  local overlay; overlay=$(cd "$root" && bin/jrt overlay | tail -1) || return 1
  for a in ${parch//,/ }; do
    t1=$(date +%s)
    mkdir -p "$w/$a"
    echo "== bin/build-go $a ${go_root[*]:-}" >&2
    (cd "$root" && REPR_GO_EXE=$base_exe bin/build-go --line-file --arch "$a" --work "$w/work-$a" -o "$w/$a/$name" \
       --print-cache "$root/.tmp/repr-go-print-cache" --overlay "$overlay" --root "$root/x509roots" ${go_root[@]+"${go_root[@]}"} \
       --go-flag "${ldflags[0]}" "$w/j2g/prog") > "$w/build-$a.log" 2>&1 \
      || { grep -v '^==' "$w/build-$a.log" | tail -20 >&2; echo "arbace-go: $name: $a: the build failed ($w/build-$a.log)" >&2; return 1; }
    echo "   build-go $a: $(since "$t1")" >&2
  done
  echo "$key" > "$w/key"
  # the intermediate trees removed (hundreds of MB; ARBACE_PROGRAM_KEEP=1 keeps them)
  [ "${ARBACE_PROGRAM_KEEP:-}" = 1 ] || rm -rf "$w/aot" "$w/j2g" "$w"/work-* "$w/compile.image" "$w/src"
  for a in ${parch//,/ }; do program_done "$a" ""; done
  echo "arbace-go: $name built in $(since "$t0")" >&2
}

# program_done ARCH CACHED: the executable copied to -o OUT when given, and where it is printed
program_done() {
  local exe=$w/$1/$name
  if [ -n "$out" ]; then
    mkdir -p "$(dirname "$out")" && cp -f "$exe" "$out.new.$$" && mv -f "$out.new.$$" "$out" || return 1
    exe=$(cd "$(dirname "$out")" && pwd)/$(basename "$out")
  fi
  echo "arbace-go: the program $name ($1${2:+, $2}): $exe ($(stat -c %s "$exe") bytes)"
}

# check_programs [NAME...]: test/programs' samples (default all), each built (--build-program, for
# the host's architecture) and run on its runs/NAME.args (arguments, one per line), stdin NAME.in
# (none: empty): stdout must equal NAME.out, the exit code NAME.code (default 0), stderr begin with
# NAME.err (none: empty); an Arbace program's runs with ARBACE_LOAD_TIMES=1, and none of its
# sources may load from source (each ran compiled)
check_programs() {
  local pdir=$root/test/programs t p n b st code want out_dir names=("$@") fails=0 total=0 bad loads
  [ ${#names[@]} -gt 0 ] || names=($(cd "$pdir" && ls -d */ | tr -d /))
  out_dir=$root/.tmp/programs-check
  rm -rf "$out_dir"; mkdir -p "$out_dir"
  : > "$out_dir/empty.in"
  for p in "${names[@]}"; do
    [ -d "$pdir/$p" ] || { echo "arbace-go --build-program --check: no sample $pdir/$p" >&2; return 2; }
    echo "== $p"
    if ! build_program "$pdir/$p" > "$out_dir/$p.build" 2> "$out_dir/$p.build.log"; then
      tail -20 "$out_dir/$p.build.log"; echo "  FAIL $p: not built ($out_dir/$p.build.log)"; fails=$((fails+1)); total=$((total+1)); continue
    fi
    local exe; exe=$(sed -n 's/^arbace-go: the program .*: \(.*\) ([0-9]* bytes)$/\1/p' "$out_dir/$p.build" | tail -1)
    grep '^   \|^aot:\|^arbace-go:' "$out_dir/$p.build.log" "$out_dir/$p.build" | sed 's/^[^:]*://; s/^/  /'
    for t in "$pdir/$p"/runs/*.args; do
      [ -e "$t" ] || continue
      n=$(basename "$t" .args) b=${t%.args} bad=
      mapfile -t args < "$t"
      local in=$b.in; [ -f "$in" ] || in=$out_dir/empty.in
      ARBACE_LOAD_TIMES=1 timeout 120 "$exe" "${args[@]}" < "$in" > "$out_dir/$p.$n.out" 2> "$out_dir/$p.$n.err.raw"; code=$?
      grep -v '^load .* [0-9]* ms$' "$out_dir/$p.$n.err.raw" > "$out_dir/$p.$n.err"
      want=0; [ -f "$b.code" ] && want=$(cat "$b.code")
      [ "$code" = "$want" ] || bad="exit $code, not $want"
      cmp -s "$b.out" "$out_dir/$p.$n.out" || bad="$bad${bad:+; }stdout differs (diff $b.out $out_dir/$p.$n.out)"
      if [ -f "$b.err" ]; then
        head -c "$(stat -c %s "$b.err")" "$out_dir/$p.$n.err" | cmp -s "$b.err" - || bad="$bad${bad:+; }stderr does not begin with $b.err"
      elif [ -s "$out_dir/$p.$n.err" ]; then
        bad="$bad${bad:+; }stderr not empty ($out_dir/$p.$n.err)"
      fi
      # the program's own sources ran compiled: none loaded from source
      loads=$( { [ ! -d "$pdir/$p/src" ] || (cd "$pdir/$p/src" && find . -type f | sed 's|^\./||; s/\.cljc\{0,1\}$/.ae/')
                 [ ! -d "$pdir/$p/src" ] || [ ! -d "$pdir/$p/go" ] || (cd "$pdir/$p/go" && find . -type f | sed 's|^\./|go/|'); } \
               | while read -r f; do grep -F "load $f " "$out_dir/$p.$n.err.raw"; done)
      [ -z "$loads" ] || bad="$bad${bad:+; }loaded from source: $(echo "$loads" | tr '\n' ' ')"
      total=$((total+1))
      if [ -z "$bad" ]; then echo "  ok   $p $n"; else echo "  FAIL $p $n: $bad"; fails=$((fails+1)); fi
    done
  done
  echo "arbace-go --build-program --check: $((total - fails)) of $total passed"
  [ $fails = 0 ]
}

# prepare EXE IMAGE: run the executable once with ARBACE_PREPARE, requiring every namespace
# embedded in it (the sources whose first form is ns), and write the image of their analyzed
# forms (Compiler$Image)
prepare() {
  local exe=$1 image=$2 nss
  echo "== prepare the namespaces (the image)" >&2
  # the embedded namespaces, as j2g lists them (its sources may be compressed: amendment SZ2)
  nss=$(tr '\n' ' ' < "$dir/j2g$variant/prog/namespaces.txt")
  rm -f "$image"
  printf '(doseq [n (quote [%s])]\n  (try (require n) (catch Throwable e (println "image: not prepared:" n (.getMessage e)))))\n' "$nss" \
    > "$dir/prepare$variant.ae"
  # the namespaces compiled to Java forms too (standalone S6, arbace.c2j): the units the run
  # records, compiled when all are loaded into the tree $aot_out
  local compile=()
  if [ -n "${aot_out:-}" ]; then
    rm -rf "$aot_out"
    printf '(require (quote arbace.c2j.main))\n(let [r (arbace.c2j.main/run "%s" nil)]\n  (println "aot:" (count (:compiled r)) "sources compiled," (:classes r) "classes;" (count (:failed r)) "failed")\n  (doseq [[s m] (:failed r)] (println "aot: not compiled:" s m)))\n' "$aot_out" \
      >> "$dir/prepare$variant.ae"
    compile=(env ARBACE_COMPILE=1 ARBACE_PATH="$root" ARBACE_AOT_ROOT="$root")
  fi
  "${compile[@]}" env GOGC=${GOGC:-400} ARBACE_PREPARE=$image "$exe" "$dir/prepare$variant.ae" > "$dir/prepare$variant.log" 2>&1 \
    || { tail -20 "$dir/prepare$variant.log" >&2; echo "arbace-go: prepare failed ($dir/prepare$variant.log)" >&2; return 1; }
  [ -s "$image" ] || { echo "arbace-go: prepare wrote no image ($dir/prepare$variant.log)" >&2; return 1; }
  grep '^image:\|^aot:' "$dir/prepare$variant.log" >&2
  echo "arbace-go: image $(stat -c %s "$image") bytes" >&2
}

run() { # run ARCH ARG...
  local a=$1; shift
  if [ "$a" = arm64 ]; then
    exec_cmd=(/usr/bin/qemu-aarch64 "$dir/$a/arbace")
  else
    exec_cmd=("$dir/$a/arbace")
  fi
  "${exec_cmd[@]}" "$@"
}

run_for() { # run_for SECONDS ARCH ARG...: run, killed after SECONDS (status 124)
  local s=$1 a=$2; shift 2
  if [ "$a" = arm64 ]; then
    exec_cmd=(/usr/bin/qemu-aarch64 "$dir/$a/arbace")
  else
    exec_cmd=("$dir/$a/arbace")
  fi
  timeout "$s" "${exec_cmd[@]}" "$@"
}

# store_checks: bin/lib/store-checks.bash (shared with bin/box-smoke)
. "$root/bin/lib/store-checks.bash"
# tls_checks, tls_server: bin/lib/tls-checks.bash (shared with bin/box-smoke)
. "$root/bin/lib/tls-checks.bash"

smoke() {
  local status=0 t
  t=$(mktemp -d "$root/.tmp/arbace-go-smoke.XXXXXX")
  cat > "$t/script.ae" <<'EOF'
(ns smoke.script (:require [arbace.string :as str]))
(defprotocol Shape (area [s]))
(defrecord Rect [w h] Shape (area [_] (* w h)))
(deftype Circle [r] Shape (area [_] (* 3 r r)))
(defn total [shapes] (reduce + (map area shapes)))
(println (total [(->Rect 2 3) (Circle. 2)]) (str/join "," (map inc [1 2 3])))
(println (try (throw (ex-info "boom" {:a 1})) (catch Exception e [(ex-message e) (ex-data e)])))
(println (loop [i 0 acc []] (if (< i 5) (recur (inc i) (conj acc (* i i))) acc)))
EOF
  mkdir -p "$t/dr/dr"
  echo '{dr.ae/tag dr.fns/from-ae}' > "$t/dr/data_readers.ae"
  echo '{dr.clj/tag dr.fns/from-clj}' > "$t/dr/data_readers.clj"
  echo '(ns dr.fns) (defn from-ae [x] [:ae x]) (defn from-clj [x] [:clj x])' > "$t/dr/dr/fns.ae"
  # a package of Java forms whose first file names a class of its second (SPEC §9.2 (3), the
  # source lookup; JC4, doc/classes/JAVA-CONFORMANCE-SURVEY.md, JCS8 (b))
  mkdir -p "$t/jl/jl"
  printf '(ns jl)\n(load "jl/A")\n(load "jl/B")\n' > "$t/jl/jl.ae"
  printf '%s\n' "(in-ns 'jl)" '(defclass ^:public A' '  (method ^:public ^:static make ^B [^int n] (B. n))' \
    '  (method ^:public ^:static run ^String [] (java-str (B/name) " " (.-n (A/make 3)))))' > "$t/jl/jl/A.ae"
  printf '%s\n' "(in-ns 'jl)" '(defclass ^:public B' '  (field ^:public ^int n)' \
    '  (constructor ^:public [this ^int n] (set! (.-n this) n))' '  (method ^:public ^:static name ^String [] "B"))' \
    > "$t/jl/jl/B.ae"
  printf '(+ 1 2)\n(* *1 10)\n(defn twice\n  "Doubles x."\n  [x]\n  (* 2 x))\n(twice 21)\n(doc twice)\n(/ 1 0)\n(class *e)\n(ex-message *e)\n[*1 *2 *3]\n"multi\nline"\n' \
    > "$t/repl.in"
  cat > "$t/repl.expected" <<'EOF'
Arbace DESCRIBE (HASH)
user=> 3
user=> 30
user=> #'user/twice
user=> 42
user=> -------------------------
user/twice
([x])
  Doubles x.
nil
user=> Execution error (ArithmeticException) at user/evalN (REPL:1).
Divide by zero
user=> java.lang.ArithmeticException
user=> "Divide by zero"
user=> ["Divide by zero" java.lang.ArithmeticException nil]
user=> "multi\nline"
user=> 
EOF
  # TLS's test server (bin/lib/tls-checks.bash), when Go's toolchain builds it
  if tls_build_server "$t/tlsserver" > "$t/tlsserver.log" 2>&1; then
    tls_server "$t/tlsserver" "$t/tls" || TLS_SERVER_PID=""
  fi
  for a in ${arches//,/ }; do
    local fails=0
    check() { # check NAME EXPECTED ACTUAL
      if [ "$2" = "$3" ]; then echo "  ok   $1"; else echo "  FAIL $1"; echo "    expected: $2"; echo "    got:      $3"; fails=$((fails+1)); fi
    }
    echo "== $a"
    check "-e (+ 1 2)" "3" "$(run "$a" -e '(+ 1 2)' 2>&1)"
    check "a script" "$(printf '18 2,3,4\n[boom {:a 1}]\n[0 1 4 9 16]')" "$(run "$a" "$t/script.ae" 2>&1)"
    check "the REPL on stdin" "$(printf 'user=> 3\nuser=> #'"'"'user/sq\nuser=> 49\nuser=> ')" \
      "$(printf '(+ 1 2)\n(defn sq [x] (* x x))\n(sq 7)\n' | run "$a" 2>&1 | tail -n +2)"
    # the REPL as a user process: multi-line input, doc, an error and the REPL going on, *1
    # *2 *3 and *e, end of input ending it with status 0 (the transcript was the JVM Arbace's
    # until S4, but for the eval class's number)
    run "$a" < "$t/repl.in" > "$t/repl.out" 2>&1; st=$?
    check "a REPL session" "$(cat "$t/repl.expected")" \
      "$(sed -e 's/user\/eval[0-9]*/user\/evalN/' -e '1s/^Arbace [^ ]* ([0-9a-f]\{7\})$/Arbace DESCRIBE (HASH)/' "$t/repl.out")"
    # Arbace's version (the link's -X; doc/VENDOR-NOTES.md, hand change 20): the banner says
    # the describe and the commit of *arbace-version* (a cached gate executable keeps the
    # commit it was built at: gate_key), *clojure-version* stays
    check "the banner is *arbace-version*'s" "$(head -1 "$t/repl.out")" \
      "$(run "$a" -e '(let [{:keys [describe commit dirty]} *arbace-version*] (if (and (string? commit) (re-matches #"[0-9a-f]{40}" commit) (boolean? dirty) (= describe (arbace-version))) (println "Arbace" describe (str "(" (subs commit 0 7) ")")) (prn *arbace-version*)))' 2>&1)"
    check "(clojure-version)" "1.13.0-master-SNAPSHOT" "$(run "$a" -e '(print (clojure-version))' 2>&1)"
    # data_readers.ae (doc/VENDOR-NOTES.md, hand change 21) beside a data_readers.clj, at the
    # root of ARBACE_PATH
    check "data_readers.ae and .clj on ARBACE_PATH" "[[:ae 1] [:clj 2]]" \
      "$(ARBACE_PATH=$t/dr run "$a" -e '(require (quote dr.fns)) (prn (read-string "[#dr.ae/tag 1 #dr.clj/tag 2]"))' 2>&1)"
    check "Java forms: a class of a later file of the package (the source lookup)" "B 3" \
      "$(ARBACE_PATH=$t/jl run "$a" -e '(require (quote jl)) (print (jl.A/run))' 2>&1)"
    check "the REPL's exit status at end of input" "0" "$st"
    # an embedded namespace is loaded once, as the JVM initializes an AOT-compiled one's class
    # once (doc/go/BOX-NOTES.md, S2): a require of arbace.core keeps its protocols' interfaces
    check "an embedded namespace loaded once" "true" \
      "$(run "$a" -e '(let [c arbace.core.protocols.CollReduce] (require (quote arbace.core) :reload) (print (identical? c arbace.core.protocols.CollReduce)))' 2>&1)"
    run "$a" -e '(/ 1 0)' > "$t/err.txt" 2>&1; local st=$?
    check "an error's exit status" "1" "$st"
    check "an error's message" "Divide by zero" "$(grep -o 'Divide by zero' "$t/err.txt" | head -1)"
    check "stdin as a script (-)" "6" "$(echo '(println (* 2 3))' | run "$a" - 2>&1)"
    # goi (doc/go/GOI-SPEC.md, GR1): Arbace calling compiled Go through the table of compiled
    # packages, against expected values written by hand
    run "$a" "$root/test/goi/calls.ae" > "$t/goi.txt" 2>&1; st=$?
    check "goi: Arbace calls compiled Go (test/goi/calls.ae: $(tail -1 "$t/goi.txt" | grep -o '[0-9]* passed'))" \
      "0 failed 0" "$(tail -1 "$t/goi.txt" | grep -o '[0-9]* failed') $st"
    [ "$st" = 0 ] || grep -v '^goi calls:' "$t/goi.txt" | head -40 | sed 's/^/    /'
    # goi (GR3): Go forms at the REPL, against expected values written by hand, and interpreted
    # programs in program mode, against gc's outputs recorded (bin/goi test)
    ARBACE_PATH=$root/test/goi/repl-pkgs run "$a" "$root/test/goi/repl.ae" > "$t/goi-repl.txt" 2>&1; st=$?
    check "goi: Go forms at the REPL (test/goi/repl.ae: $(tail -1 "$t/goi-repl.txt" | grep -o '[0-9]* passed'))" \
      "0 failed 0" "$(tail -1 "$t/goi-repl.txt" | grep -o '[0-9]* failed') $st"
    [ "$st" = 0 ] || grep -v '^goi repl:' "$t/goi-repl.txt" | head -40 | sed 's/^/    /'
    # goi (GR5): GOI-SPEC.md §1.4's session typed at the REPL, against its transcript
    run "$a" < "$root/test/goi/session.in" > "$t/goi-session.out" 2>&1
    check "goi: §1.4's session at the REPL (test/goi/session.in)" "$(cat "$root/test/goi/session.expected")" \
      "$(sed -e '1s/^Arbace [^ ]* ([0-9a-f]\{7\})$/Arbace DESCRIBE (HASH)/' "$t/goi-session.out")"
    local gp=0 gfail="" gn gf
    for gf in "$root"/test/goi/run/go/t/*.ae; do
      gn=$(basename "$gf" .ae)
      run "$a" -m arbace.go.run "$root/test/goi/run" "go.t.$gn" > "$t/goi-$gn.out" 2> "$t/goi-$gn.err.raw"; st=$?
      awk '/^goroutine /{exit} {print}' "$t/goi-$gn.err.raw" > "$t/goi-$gn.err"
      if [ "$st" = "$(cat "${gf%.ae}.exit")" ] && cmp -s "$t/goi-$gn.out" "${gf%.ae}.out" && cmp -s "$t/goi-$gn.err" "${gf%.ae}.err"; then
        gp=$((gp + 1))
      else
        gfail="$gfail $gn"
      fi
    done
    check "goi: interpreted programs (test/goi/run: $gp passed)" "" "$gfail"
    # main's end (doc/go/JRT-NOTES.md, "Concurrency", JC9): the process waits for the
    # non-daemon threads, as the JVM does; threads that wait forever (agents' fixed pool
    # without shutdown-agents) keep it, as they keep the JVM, without Go's deadlock crash
    check "non-daemon threads at main's end" "$(printf 'main ends\nthread ends')" \
      "$(run "$a" -e '(do (.start (Thread. (fn [] (Thread/sleep 200) (println "thread ends")))) (println "main ends"))' 2>&1)"
    run_for 5 "$a" -e '(send (agent 1) inc)' > "$t/agents.txt" 2>&1; st=$?
    check "agents without shutdown-agents keep the process (killed after 5 s)" "124" "$st"
    check "... without Go's deadlock crash" "" "$(grep -o 'fatal error.*' "$t/agents.txt")"
    run_for 60 "$a" -e '(do (send (agent 1) inc) (deref (future 2)) (shutdown-agents))' > "$t/agents-ok.txt" 2>&1; st=$?
    check "agents with shutdown-agents end the process" "0" "$st"
    # the store (doc/go/BOX-NOTES.md, S3), a directory natively; snapshots of a named directory
    native() { run "$a" "$@"; }
    store_checks native "$t"
    mkdir -p "$t/fsrc/d" && echo A > "$t/fsrc/a.txt" && echo B > "$t/fsrc/d/b.ae"
    check "a directory's snapshot saved to the store and loaded into another" "[\"A\\n\" \"B\\n\" true]" \
      "$(ARBACE_BOX_STORE=$t/store run "$a" -e "(require (quote [arbace.box :as box])) (let [h (box/save-fs! \"snap\" \"$t/fsrc\")] (box/load-fs! \"snap\" \"$t/fdst\") (prn [(slurp \"$t/fdst/a.txt\") (slurp \"$t/fdst/d/b.ae\") (= h (box/save-fs! \"snap2\" \"$t/fdst\"))]))" 2>&1)"
    check "natively, a snapshot names its directory" "java.lang.IllegalArgumentException" \
      "$(ARBACE_BOX_STORE=$t/store run "$a" -e '(require (quote arbace.box))' -e '(try (arbace.box/save-fs! "snap") (catch Exception e (print (.getName (class e)))))' 2>&1)"
    # TLS (doc/go/BOX-NOTES.md, "TLS (option 2)"): arbace.tls and arbace.http against the test
    # server on the loopback (tools/tlsserver)
    if [ -n "${TLS_SERVER_PID:-}" ]; then
      tls_checks native "$t/tls" "$t/tls/ca.pem"
    else
      echo "  skip TLS (tools/tlsserver not built: Go's toolchain needed)"
    fi
    # the interactive REPL under rlwrap (doc/go/EXEC-NOTES.md, "Line editing: rlwrap"), on a
    # pseudo-terminal: amd64 only (under qemu-aarch64 rlwrap would run the arm64 executable
    # directly), when python3 and rlwrap are installed. The checks above run without a
    # terminal, so without rlwrap
    if [ "$a" = amd64 ] && [ -n "$(command -v python3)" ] && [ -n "$(command -v rlwrap)" ]; then
      "$root/test/arbace-go-rlwrap.py" "$dir/$a/arbace" "$t" || fails=$((fails+1))
    else
      echo "  skip the REPL under rlwrap (amd64, python3 and rlwrap needed)"
    fi
    [ $fails -eq 0 ] || status=1
  done
  tls_server_stop
  rm -rf "$t"
  return $status
}

# gate_key: the hash of what the executables are built from (not the commit: a commit that
# changes none of these keeps the cached executables, whose *arbace-version* then names the
# commit they were built at; right for the smoke test, which checks only that the banner shows
# the executable's own version, and it keeps the gate's hits; a release builds anew): Arbace's
# sources (the runtime's Java forms and their Go variants, the embedded namespaces, j2g, repr/go,
# the Java forms' analysis), the JDK's forms and resource data (jdk/), jrt's forms and the
# overlays, the suite's Java fixtures' forms (the test build), the scripts of the build, the
# seed and the toolchain's pins (stage 0, the host of j2g and repr/go, is built from the seed; or the
# host executable ARBACE_HOST_EXE names), and Go's version
gate_key() {
  (cd "$root" && {
    find arbace go overlay jdk x509roots bin/lib test/java-fixtures -type f | sort
    printf '%s\n' seed/arbace-seed-go.tar.xz.sha256 seed/goroot.sha256 bin/arbace-go bin/j2g bin/repr-go bin/build-go bin/jrt bin/seed bin/goi
  } | xargs sha256sum
    [ -z "${ARBACE_HOST_EXE:-}" ] || sha256sum < "$ARBACE_HOST_EXE"
    cat "${ARBACE_GOROOT:-/root/tamago-go}/VERSION") | sha256sum | cut -c1-64
}

# gate_build: the essential bin/gate's builds (amd64), cached under .tmp/arbace-go-gate: the
# executable (--build) and the test build (--build-tests), built again only when gate_key
# changed. A hit takes seconds; a miss two Go-hosted builds. Prints where they are
gate_build() {
  local cache=$root/.tmp/arbace-go-gate key t0
  t0=$(date +%s)
  key=$(gate_key)
  if [ -x "$cache/amd64/arbace" ] && [ -x "$cache/amd64/arbace-tests" ] && [ "$(cat "$cache/key" 2>"$discard")" = "$key" ]; then
    echo "arbace-go: the cached executables (their inputs unchanged, key ${key:0:12})"
  else
    echo "arbace-go: building the executables (key ${key:0:12})"
    rm -rf "$cache"
    arches=amd64 build 2>&1 || return 1
    arches=amd64 build_tests 2>&1 || return 1
    mkdir -p "$cache/amd64"
    cp "$dir/amd64/arbace" "$dir/amd64/arbace-tests" "$cache/amd64/"
    # the compiled namespaces they hold (REAP8: bin/java-check --essential-compiled's program)
    cp -r "$dir/aot" "$cache/amd64/aot" && cp "$dir/aot.key" "$cache/amd64/aot.key"
    echo "$key" > "$cache/key"
    echo "   built in $(since "$t0")"
  fi
  echo "arbace-go: $cache/amd64/arbace $cache/amd64/arbace-tests"
}

# gate: gate_build, then the smoke test on the cached executable
gate() {
  gate_build || return 1
  dir=$root/.tmp/arbace-go-gate arches=amd64 smoke
}

# fixpoint: the Go-hosted fixpoint (standalone S3, S4, doc/STANDALONE-NOTES.md): G1 built by the
# host executable (stage 0 by default, or ARBACE_HOST_EXE), G2 by G1 (j2g and repr/go on G1), G3 by
# G2; each a whole --build for amd64 in its own directory (target/arbace-go/fixpoint/gN: j2g's
# output, the work module, the executable). Then j2g's program trees are compared (diff -r,
# report.edn's times left out) and the executables byte for byte. Status 0 when G2 = G3 (the
# trees and the executables); G1 = G2 and host = G1 are reported: they hold when the host is
# the fixpoint of these sources already (stage 0 of a seed printed from them)
fixpoint() {
  local fp=$root/target/arbace-go/fixpoint n prev status=0 t0 h host
  [ "$(host_arch)" = amd64 ] || { echo "arbace-go: --fixpoint runs on amd64" >&2; return 1; }
  host=$(. "$root/bin/lib/host.bash" && arbace_host_exe) || return 1
  rm -rf "$fp"
  mkdir -p "$fp"
  cp "$host" "$fp/host"
  for n in 1 2 3; do
    t0=$(date +%s)
    if [ $n = 1 ]; then prev=$fp/host; else prev=$fp/g$((n-1))/amd64/arbace; fi
    echo "== G$n: built by $( [ $n = 1 ] && echo "the host ($host)" || echo "G$((n-1))")" >&2
    (dir=$fp/g$n arches=amd64 J2G_GO_EXE=$prev REPR_GO_EXE=$prev build) || return 1
    echo "   G$n in $(since "$t0"); j2g: $(grep -o ':times {[^}]*}' "$fp/g$n/j2g/report.edn")" >&2
    # report.edn's times differ from run to run: the rest of it is compared
    sed -i 's/ :times {[^}]*}//' "$fp/g$n/j2g/report.edn"
  done
  for n in 2 3; do
    if diff -r "$fp/g$((n-1))/j2g" "$fp/g$n/j2g" > "$fp/diff-j2g-$((n-1))-$n.txt"; then
      echo "fixpoint: j2g's program G$((n-1)) = G$n (diff -r)"
    else
      echo "fixpoint: j2g's program G$((n-1)) != G$n: $fp/diff-j2g-$((n-1))-$n.txt"
      [ $n = 3 ] && status=1
    fi
  done
  h=$(sha256sum < "$fp/host" | cut -c1-64)
  echo "fixpoint: host $h $(stat -c %s "$fp/host") bytes"
  for n in 1 2 3; do
    h=$(sha256sum < "$fp/g$n/amd64/arbace" | cut -c1-64)
    echo "fixpoint: G$n $h $(stat -c %s "$fp/g$n/amd64/arbace") bytes"
  done
  # what bin/seed --make records when it packs G3 (ARBACE_SEED_GO_BUILD=$fp/g3): the procedure,
  # not the host, so that bin/seed --verify, which runs it from the seed's own stage 0, prints
  # the same seed
  echo "the Go-hosted fixpoint (bin/arbace-go --fixpoint): G3, j2g and repr/go on G2, G2 built by G1, G1 by the host executable" > "$fp/g3/printed-by"
  cmp -s "$fp/host" "$fp/g1/amd64/arbace" && echo "fixpoint: host = G1 byte for byte" || echo "fixpoint: host != G1"
  for n in 2 3; do
    if cmp -s "$fp/g$((n-1))/amd64/arbace" "$fp/g$n/amd64/arbace"; then
      echo "fixpoint: G$((n-1)) = G$n byte for byte"
    else
      echo "fixpoint: G$((n-1)) != G$n"; [ $n = 3 ] && status=1
    fi
  done
  [ $status = 0 ] && echo "fixpoint: holds (G2 = G3)" || echo "fixpoint: does not hold"
  return $status
}

# ---------------------------------------------------------------------------------------
# The box (B1b; doc/go/BOX-NOTES.md, S1)

box_arches=${ARBACE_BOX_ARCHES:-amd64}
# the guest's own Go (B1b S6, doc/go/BOX-NOTES.md): forms (the default), TamaGo's std and goos
# module printed from tamago/ (bin/tamago-vendor print), or orig, the toolchain's tree and Go's
# module cache, from which the forms were converted (the two give the same image but for its
# build ID: bin/tamago-vendor check)
box_go=${ARBACE_BOX_GO:-forms}
# a box guest's link (arbace.build.go/tamago-ldflags): text at 0x201000, 4 KiB segments,
# the symbol table kept (the monitor reads it), DWARF dropped
box_ldflags="-T 0x201000 -R 0x1000 -w"
# the symbols the monitor reads (vmm: the vectors, the other vCPUs' entry, a TamaGo image's
# mark): the guest's symbol table is cut to them (tools/elfsyms; doc/go/BOX-NOTES.md, S2,
# BX11), unless ARBACE_GO_SYMBOLS=1
box_symbols="whim_vectors whim_apentry runtime/goos.RamStart"

# box_key: what the box's guest is built from, beside box/: j2g's program (the image's types)
# and the image of prepared namespaces it embeds (R6: the image is valid for the same program)
box_key() {
  local main=$dir/j2g/prog/go/arbace/cmd/arbace
  cat "$main/image_types.ae" "$main/image.bin" | sha256sum | cut -c1-64
}

# box_build: the guest image and the launcher for each of $box_arches, from the last --build's
# j2g output and image (a --build for the host's architecture first, when there is none)
box_build() {
  local main=$dir/j2g/prog/go/arbace/cmd/arbace overlay ovl0 a t0 v goroot goos go
  if [ ! -s "$main/image.bin" ] || [ ! -x "$dir/$(host_arch)/arbace" ]; then
    echo "== no image of prepared namespaces: --build for $(host_arch) first" >&2
    arches=$(host_arch) build || return 1
  fi
  ovl0=$(cd "$root" && bin/jrt overlay | tail -1) || return 1
  if [ "$box_go" = forms ]; then
    # the guest's own Go from its forms (B1b S6): tamago/ printed into $dir/tamago, a GOROOT
    # (std) and TamaGo's goos module, with jrt's runtime overlay for that GOROOT
    (cd "$root" && bin/tamago-vendor print "$dir/tamago") || return 1
  fi
  v=$(arbace_version "$root") || return 1
  for a in ${box_arches//,/ }; do
    mkdir -p "$dir/box-$a"
    t0=$(date +%s)
    # tamago/ holds tamago/amd64's and tamago/arm64's Go (S6; BX63): one printing serves both
    goroot=${ARBACE_GOROOT:-/root/tamago-go} overlay=$ovl0 goos=() go=orig
    if [ "$box_go" = forms ]; then
      goroot=$dir/tamago/goroot overlay=$dir/tamago/overlay.json goos=(--goos-dir "$dir/tamago/goos") go=forms
    fi
    # and the guests' file system patched (overlay/go/syscall.ae; BX95, doc/go/BOX-NOTES.md, S7)
    box_overlay "$overlay" "$goroot" "$dir/box-overlay-$a.json" || return 1
    overlay=$dir/box-overlay-$a.json
    echo "== bin/build-go --goos tamago $a (the guest; its Go: $go)" >&2
    (cd "$root" && ARBACE_GOROOT=$goroot bin/build-go --goos tamago ${goos[@]+"${goos[@]}"} --root "$root/box" --root "$root/x509roots" --line-file \
       --arch "$a" --work "$dir/work-box-$a" -o "$dir/box-$a/arbace.elf" --overlay "$overlay" "$dir/j2g/prog") \
       > "$dir/build-box-$a.log" 2>&1 \
      || { grep -v '^==' "$dir/build-box-$a.log" | tail -20 >&2; echo "arbace-go: box $a: build failed" >&2; return 1; }
    # linked again with Arbace's version (as the executables' final links)
    (cd "$dir/work-box-$a/mod" && env $(ARBACE_GOROOT=$goroot go_env "$a" tamago) "$goroot/bin/go" build -trimpath \
       -buildvcs=false "-ldflags=$box_ldflags -X 'main.arbaceVersion=$v'" -overlay "$overlay" -o "$dir/box-$a/arbace.elf" arbace/cmd/arbace) \
       >> "$dir/build-box-$a.log" 2>&1 \
      || { tail -20 "$dir/build-box-$a.log" >&2; echo "arbace-go: box $a: link failed" >&2; return 1; }
    if [ "${ARBACE_GO_SYMBOLS:-}" != 1 ]; then
      (cd "$root/tools/elfsyms" && env -u GOOS -u GOARCH GOROOT="${ARBACE_GOROOT:-/root/tamago-go}" GOTOOLCHAIN=local \
         GOFLAGS= GOWORK=off GOPROXY=off CGO_ENABLED=0 "${ARBACE_GOROOT:-/root/tamago-go}/bin/go" build -o "$dir/elfsyms" .) \
         >> "$dir/build-box-$a.log" 2>&1 \
        && "$dir/elfsyms" "$dir/box-$a/arbace.elf" "$dir/box-$a/arbace.elf.new" $box_symbols >> "$dir/build-box-$a.log" 2>&1 \
        && mv -f "$dir/box-$a/arbace.elf.new" "$dir/box-$a/arbace.elf" \
        || { tail -5 "$dir/build-box-$a.log" >&2; echo "arbace-go: box $a: the symbol table not cut" >&2; return 1; }
    fi
    box_key > "$dir/box-$a/image.key"
    echo "   guest $a: $(since "$t0")" >&2
    echo "== bin/build-go $a (the launcher, box/)" >&2
    (cd "$root" && bin/build-go --module arbace --main arbace/box/cmd/arbace-box --arch "$a" --work "$dir/work-box-launcher-$a" \
       -o "$dir/box-$a/arbace-box.bin" "$root/box") >> "$dir/build-box-$a.log" 2>&1 \
      || { grep -v '^==' "$dir/build-box-$a.log" | tail -20 >&2; echo "arbace-go: box $a: the launcher failed" >&2; return 1; }
    box_append "$dir/box-$a/arbace-box.bin" "$dir/box-$a/arbace.elf" "$dir/box-$a/arbace-box" || return 1
    echo "arbace-go: $dir/box-$a/arbace-box ($(stat -c %s "$dir/box-$a/arbace-box") bytes: the launcher $(stat -c %s "$dir/box-$a/arbace-box.bin"), the guest $(stat -c %s "$dir/box-$a/arbace.elf"); built in $(since "$t0"))" >&2
  done
}

# box_append LAUNCHER ELF OUT: the launcher with the guest appended (vmm.Append: zeros to the
# next multiple of 64 KiB, vmm.ImageAlign, so that the monitor maps the image's segments from
# the file; the image, its length as 8 bytes little-endian, the magic WHIMGST1)
box_append() {
  local n p i len=""
  n=$(stat -c %s "$2")
  p=$(( (65536 - $(stat -c %s "$1") % 65536) % 65536 ))
  for i in 0 1 2 3 4 5 6 7; do len+=$(printf '\\x%02x' $(( (n >> (8 * i)) & 255 ))); done
  { cat "$1"; printf "%*s" "$p" "" | tr " " "\\0"; cat "$2"; printf "$len"; printf 'WHIMGST1'; } > "$3.new" \
    && chmod +x "$3.new" && mv -f "$3.new" "$3"
}

# box_smoke: the box's smoke test (bin/box-smoke, doc/go/BOX-NOTES.md, S1, S4), on /dev/kvm, for
# each of $box_arches the host runs; arm64's runs in the aarch64 VM (bin/box-arm64-vm smoke)
box_smoke() {
  local status=0 a
  for a in ${box_arches//,/ }; do
    [ "$a" = "$(host_arch)" ] || { echo "== box $a: not run here (bin/box-arm64-vm smoke; the Mac: bin/box-mac-bundle)"; continue; }
    [ -x "$dir/box-$a/arbace-box" ] || { echo "== box $a: not built (--build --box)"; status=1; continue; }
    "$root/bin/box-smoke" --arch "$a" ${dir:+--native "$dir/$a/arbace"} "$dir/box-$a/arbace-box" || status=1
  done
  return $status
}

case ${1:-} in
  --gate) gate ;;
  --gate-build) gate_build ;;
  --fixpoint) fixpoint ;;
  --build) if [ "${2:-}" = --box ]; then box_build; else [ "${2:-}" = --pgo ] && pgo=1; build; fi ;;
  --build-tests) build_tests "${2:-}" ;;
  --build-java) shift; build_java "$@" ;;
  --build-program)
    shift
    if [ "${1:-}" = --check ]; then shift; check_programs "$@"; else build_program "$@"; fi ;;
  --image) image ;;
  --smoke)
    if [ "${2:-}" = --box ]; then box_smoke; exit; fi
    for a in ${arches//,/ }; do [ -x "$dir/$a/arbace" ] || { build || exit 1; break; }; done; smoke ;;
  --box)
    shift
    [ -x "$dir/box-$arch/arbace-box" ] || box_arches=$arch box_build || exit 1
    exec "$dir/box-$arch/arbace-box" "$@" ;;
  *)
    if [ ! -x "$dir/$arch/arbace" ]; then arches=$arch build || exit 1; fi
    run "$arch" "$@" ;;
esac

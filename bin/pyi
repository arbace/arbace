#!/bin/bash
# pyi, the evaluator of Python forms (doc/python/PYTHON-SURVEY.md §6, PYS2 (a)): so far (PY4) no interpreter, only its
# corpora and their references, CPython 3.14.10's runs (GTS207 (a), PYS14 (a), PYS15 (a)). Out of gate_key and the gate
# (PYS18 (a)); stage 0 only runs the generator (test/python/gen.ae); the programs and Lib/test's modules are run by the
# oracle under .tmp/repr-python/pyi only (HOME and TMPDIR there, regrtest's resources off: no network).
#
#   bin/pyi gen [--check]          the synthetic corpus (survey §8.3): test/python/gen.ae on stage 0 writes
#                                  test/python/synth/ (ops, datamodel, builtins, constructs, paths; MANIFEST); --check
#                                  generates it into .tmp and requires it equal to the committed files (a negative control,
#                                  queue 235: the generated ops/ against the committed datamodel/ must differ), the constructs
#                                  covering every node class of the ast, the builtins every public method of their types,
#                                  every program compiling
#   bin/pyi record-ref [--check] [CORPUS...]
#                                  the reference runs (default: synthetic samples language-core; lib-test-all, PY6i: every
#                                  module of Lib/test as regrtest finds it, PYI_LIB_TEST_JOBS shards at once, into
#                                  test/python/ref-cpython314-lib-test-all.edn): each program of
#                                  synthetic and samples run by CPython 3.14.10 with PYTHONHASHSEED=0 (tools/pydump/refs.py),
#                                  twice; status, stdout's SHA-256, size, first line and stderr's last line into
#                                  test/python/ref-cpython314.edn; Lib/test's language-core modules (corpora.edn) by
#                                  regrtest, each test method's outcome into test/python/ref-cpython314-lib-test.edn
#                                  (sys.implementation.name "cpython"); an entry the two runs disagree on or whose output
#                                  names the machine is written :excluded with its reason; the seconds into
#                                  test/python/ref-costs.edn. --check: two more runs, each reproducing every reference
#   bin/pyi scope-check [--record] [CORPUS...]
#                                  PY5a: every read file's symbol table by arbace.python.scope against CPython's own
#                                  (tools/pydump/pydump.py scopes): the corpora of test/python/corpora.edn (default:
#                                  samples synthetic errors stdlib site-packages lib-test), against test/python/scope-known.edn;
#                                  then its negative control (PY7, GTS81 (a)): classes.py's tree against functions.py's tables
#   bin/pyi compile-check [--full] [--record] [CORPUS...]
#                                  PY5a: every read file compiled to pyi's IR (arbace.python.compile) and the IR
#                                  verified (doc/python/PYI-SPEC.md §4), against test/python/compile-known.edn;
#                                  --full (PY5b): the forms of mode :full, the runs' (check :compile-full); then its negative
#                                  control (PY7, GTS81 (a)): classes.py's tree judged as errors/annotated-global.py
#   bin/pyi run FILE.py            PY5b0: FILE read in mode :full (the native reader since queue 213, no CPython; PYI_READER=helper:
#                                  tools/pydump/pydump.py tree --full, as before), compiled to
#                                  the IR and run by pyi's runtime go/arbace/py, interpreted by goi on stage 0 (PY5a's DECISION
#                                  (a)); the program's stdout, stderr and exit status
#   bin/pyi run FILE.py ARGS...    PY5e: sys.argv [FILE ARGS...], sys.path [FILE's directory, the pinned tarball's Lib];
#                                  imports, exec, eval and compile compiled by the host (arbace.python.run, the IR kept in
#                                  .tmp/repr-python/pyi/ir-cache by the source's and the compiler's SHA-256)
#   bin/pyi ir FILE.py OUT         queue 229: FILE's IR text (arbace.python/ir-text), mode exec, into OUT
#   bin/pyi bytecode-check [FILE.py...]
#                                  queue 229: each code object of FILE (default: dis.py, textwrap.py, argparse.py of the
#                                  pinned Lib) by the runtime's view (go/arbace/py/bytecode*.go) against python3's: co_code,
#                                  co_consts, co_stacksize, co_linetable, co_exceptiontable, the first differences counted
#                                  (TestBytecodeDiff); PYI_BC_SHOW=N: the first N code objects that differ; queue 238: under
#                                  REPR_PYTHON_VERSION=3.15 the view of 3.15 (the runtime's switch) against the 3.15.2 oracle's
#                                  (REPR_PYTHON_ORACLE_315), in .tmp/repr-python/pyi/bytecode-check-315; PYI_BC_DEBUG=1: a
#                                  code object whose view cannot be made prints the panic and its stack
#   bin/pyi repl [--check]         PY5e: python3's basic REPL (go/arbace/py's repl.go): statements from stdin, prompts on
#                                  stderr, expression statements' values displayed (sys.displayhook, builtins._); --check:
#                                  test/python/pyi/*.in fed to it and to python3 -q -i, stdout, status and stderr
#                                  byte for byte
#   bin/pyi lib-test [--oracle] [--record] [--aot] [--corpus ID] [--judge DIR] [--verdict own|ref] [MODULE...]
#                                  PY5e: Lib/test's language-core modules (--corpus ID: another lib-test corpus of
#                                  corpora.edn, e.g. lib-test-asyncio; --aot: the driver compiled by pyi's AOT, the test
#                                  modules on its loop, PY6h) run by pyi (test/python/libtest.py: unittest's
#                                  loader, each test's outcome), judged per method against ref-cpython314-lib-test.edn
#                                  (test/python/libtest_judge.ae, PY6a; since PY7 bin/pyi check's judge): a method not
#                                  equal passes in its class of test/python/divergences.edn unless the check's record passes
#                                  it; --record writes the record's rows of the modules run (exit 3 on a method of no class);
#                                  --judge DIR: judged again, nothing run; --oracle: the driver by python3; --verdict own|ref
#                                  (queue 234: own, the default, each test's own; ref, against CPython's references);
#                                  pyi's runs skip test/python/lib-test-skip.tsv's tests (PYI_LIB_TEST_SKIP, the driver's)
#   bin/pyi python [OPTION...] [-c CMD | -m MOD | FILE | -] [ARGS...]
#                                  PY6e: CPython's command line over run (sys.executable, tools/pyi/python3), for
#                                  script_helper's and subprocess's children: the options taken and ignored, run in
#                                  the caller's directory
#   bin/pyi lib-test-all [--oracle] [--record] [--judge DIR] [--fresh] [--all] [--verdict own|ref] [MODULE...]
#                                  PY6i: Lib/test as regrtest finds it, less the families' modules (tools/pyi/libtest_all.py; the
#                                  modules the :module lines of ref-cpython314-lib-test-all.edn): each module by pyi through test/python/libtest_run.py,
#                                  a test's crash or timeout ending that test alone (the driver started again on the rest),
#                                  judged by libtest_judge.ae against the references, divergences.edn's classes and the record, then the
#                                  negative controls (test/python/controls.edn) and the table (RUN/table.md); the
#                                  modules a family owns (test/python/lib-test-all-owners.tsv) left out, its rows the family's,
#                                  but with --all, --oracle (the driver's control, every module) or named; the
#                                  run in .tmp/repr-python/pyi/lib-test-all/run resumes (--fresh: anew); --record: the record's
#                                  rows of the modules run written (exit 3
#                                  on a method of no class). PYI_LIB_TEST_JOBS (default 2), PYI_LIB_TEST_TEST_TIMEOUT (300 s),
#                                  PYI_LIB_TEST_IDLE_TIMEOUT (90 s: a test whose processes stay idle that long is a hang, killed
#                                  then; 0 off; queue 275), each test's wall and CPU seconds in RUN/MODULE.times,
#                                  PYI_LIB_TEST_TIMEOUT (a module's cap, 3600 s), PYI_LIB_TEST_TMP (the runs' short TMPDIRs, default
#                                  .tmp/t6i: multiprocessing's AF_UNIX paths fit; /tmp checked and cleaned after each module)
#   bin/pyi check [--corpus ID,...] [--only FILE] [--record] [--judge DIR] [--oracle] [--fresh] [--verdict own|ref] [MODULE...]
#                                  PY7: the check over Lib/test (survey §7-§8, "As built: PY7 (the check)"), as goi's and Java's:
#                                  every module of the universe (the lib-test corpora of corpora.edn and lib-test-all's) through
#                                  the restartable runner (since queue 234 compiled by pyi's AOT: bin/pyi runner; no python3),
#                                  each method judged by its own verdict (queue 234, "As built: 234": unittest's ok under pyi
#                                  passes; --verdict ref, PYI_VERDICT=ref: against CPython's references, the oracle tier's),
#                                  the methods the recorded universe's (queue 256: test/python/universe-cpython314.edn, bin/pyi
#                                  universe; refused when stale) with every test the run reports,
#                                  every non-pass in a
#                                  class of test/python/divergences.edn (GR10's format), a method the record
#                                  (test/python/check-lib-test-linux-amd64.edn, PYI_CHECK_RECORD) passes that does not pass now a
#                                  regression, "   failing: ID" a line each; the negative controls (test/python/controls.edn);
#                                  --only FILE: MODULE or MODULE/TEST-ID lines (the gate's rotation's lists); --record writes the
#                                  record (the main host's); --judge DIR judged again, nothing run; RUN/results.tsv the rows;
#                                  py-footprint-1127: the drivers' children (sys.executable) by the compiled launcher (bin/pyi
#                                  launcher), as --aot's; PYI_CHILD_LAUNCHER=0: by pyi on the tools' host (tools/pyi/python3)
#   bin/pyi runner [VERB ARGS...]  queue 234: tools/pyi/libtest_all.py compiled by pyi's AOT (kept by the runtime's key, the
#                                  generator's and the script's digests), its path; with VERB, that verb run by it (owned,
#                                  run, controls, table: the check's; PYI_RUNNER=python3 or pyi another runner)
#   bin/pyi script SCRIPT [ARGS...]  queue 240: a script of tools/pyi or tools/pydump compiled by pyi's AOT the same way and run
#                                  (tools/pydump/syntax_cases.py at check time: no python3); PYI_RUNNER=pyi or python3 another
#   bin/pyi universe [--check]     queue 256: Lib/test's universe as data, test/python/universe-cpython314.edn (the modules and
#                                  test ids of CPython 3.14.10's recorded runs, the tests they skipped on the recording platform;
#                                  test/python/universe.ae on stage 0, no python3; record-ref writes it after Lib/test's
#                                  references): check's inventory (libtest_judge.ae --universe, no outcome read), refused when
#                                  its key is not its inputs'; --check: written afresh, compared byte for byte, a control
#   bin/pyi records [--slice N] [--dir DIR] [--only aot|lib-test]
#                                  queue 321: the eval and AOT cells' records night in one command (the main host's, linux/amd64):
#                                  the host checked to run the checkout's runtime (the gate's build at the checkout's key taken for
#                                  a stale stage 0), check --aot --record, check --fresh --record, each timed with its peak memory,
#                                  the recorded sources' :until dropped from test/reap/cells.edn, bin/reap --record, bin/crops-score
#                                  --record; --slice N: the dry run, every Nth program and module, the records under DIR, read by
#                                  bin/reap and bin/crops-score through an overlay of the checkout (nothing of it written)
#   bin/pyi divergences [--table | --methods] [--results FILE...]
#                                  PY7: the record's non-passes classified by test/python/divergences.edn, no run (GR10, as
#                                  bin/goi divergences): a non-pass in no class, or a :tests name another class takes first, fails
#   bin/pyi cover run|blocks|subset [--only FILE] [--write]
#                                  PY7: the coverage subset (GT8.3, GTS205 (a)): the driver compiled by pyi's AOT with Go's -cover
#                                  of the runtime (go/arbace/py), each module on its loop with its GOCOVERDIR (run: the main
#                                  host's night); blocks: tools/covsubset's block sets per module; subset: the modules of every
#                                  covered block, one per class, the controls (bin/cover subset); --write: corpora.edn's :subset
#   bin/pyi runtime print|read|read-pytls|vet|check|programs|tables|gen-tables
#                                  PY5b0, the runtime's sources (doc/python/PYI-SPEC.md §8): go/arbace/py's Go forms (mode :full,
#                                  lossless) printed as a Go module into .tmp/repr-python/pyi/runtime (print), edited there,
#                                  read back into go/arbace/py (read; go/arbace/libm, go/arbace/expat and go/arbace/pyexpat,
#                                  printed beside it, not read back; queue 208: ci's back end go/arbace/ci and crt, and
#                                  the libraries' node programs go/arbace/clib/{bzip2,xz,zstd,sqlite}, printed beside it, the C library
#                                  host go/arbace/clib and the glue of _bz2, _lzma, _zstd and _sqlite3, go/arbace/{pybz2,pylzma,pyzstd,pysqlite3}, read back too);
#                                  vet: the Go there (printed first when absent)
#                                  gofmt clean, then go vet and go test by TamaGo's go (py, expat, pyexpat, clib, pybz2, pylzma, pyzstd, pysqlite3, pyctypes);
#                                  check: printed and read again equal to the committed forms (py, expat, pyexpat, clib, pybz2, pylzma, pyzstd, pysqlite3, pyctypes), the runtime's operations
#                                  arbace.python.ir/ops's (runtime-ops), the programs of test/python/pyi/ run by bin/pyi run
#                                  equal to the oracle's runs (stdout, status, stderr's last line), and repl --check;
#                                  also the Unicode tables and the CJK codecs' (tools/pyi/unicodedata_table.py and
#                                  cjkcodecs_table.py --check on the printed files) where the oracle runs live; queue 213: the
#                                  oracle's runs and sessions from test/python/records/outcomes/{smoke,repl}/ in records mode,
#                                  PYI_SMOKE_ONLY=REGEX a sample of them; queue 235: a failure prints each side's status (124 a
#                                  timeout) and stderr's last line after the diff's first lines, and the negative controls of
#                                  test/python/controls-runtime.edn (a program's and a session's run against another's outcome;
#                                  their subjects run with every sample; PYI_RUNTIME_CONTROLS another file) end each family;
#                                  tables: the two generators alone (the oracle tier's); queue 238: also the bytecode view's
#                                  tables (tools/pyi/bytecode_table.py, 3.14.10's and --suffix 315's; opcode_table.py --suffix
#                                  315 by the 3.15.2 oracle), each 3.15 one with its negative control (3.14.10's made into it);
#                                  queue 265: also the five tables gen-tables makes, against tools/pyi/{errno,opcode,fcntl,socket,posix}_table.py;
#                                  queue 290: builtins_textsig_table.go against tools/pyi/textsig_table.py (the oracle's __text_signature__)
#                                  gen-tables [TABLE...] (queue 265): builtins_{opcode,errno,fcntl,socket,posix}_table.go (queue 350: and slotdocs.go, builtins_ast_table.go; queue 357: bytecode_table{,315}.go, builtins_opcode_table315.go, statConsts, builtins_cjk_table.go, builtins_unicodedata_table{,315}.go and the rest) made by
#                                  Arbace from pinned sources (tools/pyi/runtime_tables.ae on stage 0: the modules' own C preprocessed
#                                  by repr/c's preprocessor against the CPython 3.14.10 and musl 1.2.6 tarballs, configure.ac's answers (queue 357),
#                                  Linux's and BlueZ's headers, tools/pyi/header-apks.sha256, and Go's syscall), gofmt'd, byte for
#                                  byte the printed runtime's; a control per table (one source fact changed must differ); no
#                                  python3 (tools/pyi/*_table.py of the five: the oracle tier's)
#                                  read-pytls (queue 552): the vendored crypto/tls (go/arbace/pytls, TamaGo's go1.27.1 crypto/tls with its
#                                  internal packages; doc/python/PYTHON-SURVEY.md, "As built: 552") read back alone (read reads it too)
#   bin/pyi aot FILE.py [ARGS...]  PY8: FILE compiled by pyi's AOT (arbace.python.aot: the IR to Go forms over go/arbace/py, its
#                                  module-level imports compiled ahead; printed by repr/go, built by TamaGo's go in
#                                  .tmp/repr-python/pyi/aot/mod) and run; source compiled at run time by the host's compiler
#   bin/pyi check --aot [--record] [--no-pyi] [--only ID]... [--only-list FILE]
#                                  PY8: the synthetic corpus and the samples compiled and run, judged against CPython's
#                                  references (ref-cpython314.edn), the same executable on the loop (PYI_AOT_LOOP) and pyi's run
#                                  on goi (kept by digest; --no-pyi: not run; --only-list FILE: FILE's ids, one a
#                                  line, # and blank lines ignored); classes test/python/divergences-aot.edn and the
#                                  rule :as-pyi; a negative control; --record: test/python/check-aot-linux-ARCH.edn
#                                  (PYI_CHECK_AOT_RECORD another: a dry run's scratch record, queue 279)
#   bin/pyi check --aot --judge [DIR] [--record]
#                                  queue 353: a kept run (DIR/runs.tsv, default the last check --aot's) judged again, nothing
#                                  compiled or run (as check --judge RUN for Lib/test): the morning after a class changed;
#                                  --record of a run lacking programs refused into the committed record
#   bin/pyi check --aot --lib-test [check's options] [MODULE...]
#                                  queue 279: Lib/test by pyi's AOT, the check's run and judge (bin/pyi check) with each
#                                  module's driver (libtest_run.py) compiled with the module and its imports ahead
#                                  (WORK/aot/bin/lt/MODULE; RUN/aot-compile.tsv: seconds, peak KB, built|refused|no-build;
#                                  a module not built is not run; RUN/MODULE.mem: each driver run's busybox time -v), in
#                                  WORK/check/run-aot; judged against
#                                  test/python/check-aot-lib-test-linux-ARCH.edn (queue 284: its --record the main host's;
#                                  none yet: no regressions; PYI_CHECK_AOT_LIB_RECORD another, a dry run's scratch record);
#                                  queue 284: the drivers' children (sys.executable: script_helper, subprocess) run by the
#                                  compiled launcher (tools/pyi/launcher.py, WORK/aot/bin/python3), not pyi on goi
#                                  (PYI_AOT_LAUNCHER=0: on goi as before); queue 287: in batches of PYI_AOT_LIB_BATCH
#                                  modules (default 40, 0 all at once), each batch's drivers compiled, run and removed
#                                  before the next's (a driver is 170-260 MB)
#   bin/pyi launcher               queue 284: the compiled launcher (tools/pyi/launcher.py by pyi's AOT) built when stale; prints its
#                                  wrapper, a sys.executable that runs CPython's command line compiled (check --aot --lib-test's)
#   bin/pyi golden                 queue 247: the programs' own verdict: test/python/golden/ID.out is a program's expected stdout, reviewed
#                                  line by line against the Language Reference and the library docs (review-*.edn: the status, the digest
#                                  of the reviewed text, entries [LINES SECTIONS BASIS WHY], the implementation-defined lines named); checks
#                                  every line is in one entry, the digest, the agreement with CPython's recorded run, a negative control;
#                                  check --aot judges a program that has one by it (1 each of compiled, loop and pyi), the rest by the record
#   bin/pyi bench [--pyi] [--record] [BM...]
#                                  PY8: pyperformance 1.14.0's pure benchmarks (test/python/bench) run by CPython, compiled and
#                                  on the loop (--pyi: by pyi on goi too), the milliseconds; --record: bench-aot-linux-ARCH.edn
#   bin/pyi wheels fetch|install|verify|path|run SCRIPT [ARGS...]|check [NAME...]|pip-probe|suite NAME [TEST...]
#                                  queue 205 (PYS23-PYS25 (a), survey "As built: 205"): the pinned pure-Python wheels of
#                                  test/python/wheels.edn; fetch: each into ${REPR_PYTHON_SRC:-.tmp/repr-python}/wheels
#                                  (the one network step, checked by SHA-256 and size); install: the site site-KEY beside
#                                  it (lib/, bin/) by arbace.python.wheels, Arbace's own installer (RECORD verified, no
#                                  pip), its path printed; verify: the wheels against their pins, the site against its
#                                  RECORDs; path: its lib/, for PYI_SITE (run, python and repl put PYI_SITE's directories
#                                  on sys.path after the stdlib); run: a console script's launcher; check: install, verify,
#                                  the layout against the host pip's --target, each pin's sample (test/python/wheels/) and
#                                  console script by pyi and by python3 -I -S with the same site, two negative controls;
#                                  pip-probe: a check (queue 207): the apks' pip on pyi and on python3 -I -S, --version,
#                                  list, an offline --target install of each pin and one --find-links install of all,
#                                  list --path: each run and each installed tree equal to CPython's, but the classed
#                                  differences (the no-ssl warning, a console script's #! line)
#                                  suite NAME [TEST...]: queue 232, a pin's own test suite (the pins' :suites: tomli,
#                                  click; its source archive fetched by fetch) run by pyi against the installed wheels and
#                                  the test site (:test-wheels: pytest), each test by its own verdict (queue 234: passed and
#                                  xfail pass; PYI_VERDICT=ref: also by CPython, test for test, every difference equal), a
#                                  non-pass classed in test/python/divergences.edn (wheels-NAME/ID) or failing;
#                                  TEST... a sample of the suite in place of its :args; a negative control
#   bin/pyi c2j-check              queue 206 (AFTER-PY11.md §4.4, the re-seed window's light check, as bin/ci c2j-check): the
#                                  namespaces of arbace/python and arbace/repr/python compiled by c2j alone on stage 0 (no j2g,
#                                  no Go build), as the build's first pass compiles an embedded namespace; ends "N namespaces:
#                                  N compiled, 0 failed", each failure "c2j-check: not compiled: SOURCE MESSAGE"; then its
#                                  negative control, test/python/c2j/pyi/c2j_control.ae, which must fail with its message
#   bin/pyi table-check [--configs C,...] [--tables]
#                                  queue 214 (PYS28 (a), doc/W-WINDOW.md §5): pyi's runtime listed in goi's table, checked
#                                  without an executable, as bin/oi table-check (test/python/table_check.ae on stage 0):
#                                  go/arbace/gotable.edn lists arbace/libm, arbace/py, arbace/crt and arbace/ci, program-path?
#                                  takes them, goi's checker checks each in every configuration (default linux/amd64,
#                                  linux/arm64, tamago/amd64, tamago/arm64; linux's by bin/goi table-configs, which converts
#                                  linux's std once) with no error; --tables: the generator tables a list of them alone
#                                  (.tmp/repr-python/pyi/table/), the members counted
# Environment: REPR_PYTHON_SRC as for bin/repr-python (the tarball's source). REPR_PYTHON_VERSION=3.15 (queue 237, the
# reader's switch of queue 236): the runtime and the reader follow Python 3.15 (go/arbace/py's version.go: 3.15's
# additions present), the standard library, the references and the records stay 3.14.10's (the pins fetched as 3.14's). python3 (the oracle) is looked for only by
# the verbs that run it (queue 213): run, python, repl, aot, check --aot --no-pyi, c2j-check and table-check need none.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash"
caller_pwd=$PWD
cd "$root"
# py-os-1124: pyi's hashes are CPython's, randomized when PYTHONHASHSEED is unset (go/arbace/py's hash.go); bin/pyi's own
# verbs run with PYTHONHASHSEED=0 when it is unset (deterministic, as the references' runs), so their children inherit
# it, and only sys.executable (bin/pyi python) started with an environment that drops it is randomized, as CPython is
# likewise PYTHONDONTWRITEBYTECODE=1, the references' (sys.flags.dont_write_bytecode, which -B and the variable set since
# py-os-1124; pyi writes no bytecode cache in any case)
[ "${1:-}" = python ] || export PYTHONHASHSEED="${PYTHONHASHSEED-0}" PYTHONDONTWRITEBYTECODE="${PYTHONDONTWRITEBYTECODE-1}"

WORK="$root/.tmp/repr-python/pyi"
SYNTH="$root/test/python/synth"
# queue 252 (PY315-SURVEY P7): the records' version. Under REPR_PYTHON_VERSION=3.15 every record is 3.15.2's own file
# beside 3.14's (RECV 315: ref-cpython315*.edn, universe-cpython315.edn; RECS -315 for the files whose names carry no
# version: ref-costs*-315.edn, divergences*-315.edn, check-*-315.edn), as 236 named repr-python's; absent until the main
# host records them from its own 3.15.2 build. 3.14's names are unchanged.
RECV=314 RECS=
[ "${REPR_PYTHON_VERSION:-}" != 3.15 ] || RECV=315 RECS=-315
REF="$root/test/python/ref-cpython$RECV.edn"
GOLDEN="$root/test/python/golden"   # queue 247: the programs' reviewed expected outputs, their own verdict (bin/pyi golden)
REF_LT="$root/test/python/ref-cpython$RECV-lib-test.edn"
COSTS="$root/test/python/ref-costs$RECS.edn"
COSTS_LT="$root/test/python/ref-costs-lib-test$RECS.edn"
REF_ALL="$root/test/python/ref-cpython$RECV-lib-test-all.edn"
COSTS_ALL="$root/test/python/ref-costs-lib-test-all$RECS.edn"
# PY7 (queue 201): the classes, the check's record (the main host's, amd64: PYI_CHECK_RECORD another) and the controls
DIV="$root/test/python/divergences$RECS.edn"
CHECK_RECORD="${PYI_CHECK_RECORD:-$root/test/python/check-lib-test-linux-amd64$RECS.edn}"
CONTROLS="$root/test/python/controls.edn"
# queue 256: Lib/test's universe as data (bin/pyi universe), the check's inventory
UNIVERSE="$root/test/python/universe-cpython$RECV.edn"
die() { echo "pyi: $*" >&2; exit 1; }

arbace_exe() {
  if [ -n "${ARBACE_HOST_EXE:-}" ]; then echo "$ARBACE_HOST_EXE"; return; fi
  local arch main
  case $(uname -m) in x86_64) arch=amd64 ;; aarch64) arch=arm64 ;; *) arch=$(uname -m) ;; esac
  if [ -x "$root/target/seed/$arch/arbace" ]; then echo "$root/target/seed/$arch/arbace"; return; fi
  main=$(cd "$(git rev-parse --git-common-dir)/.." && pwd)
  if [ -x "$main/target/seed/$arch/arbace" ]; then echo "$main/target/seed/$arch/arbace"; return; fi
  die "no stage 0 (bin/seed --build, or ARBACE_HOST_EXE)"
}

# runtime_from_source (the user's DECISION of 2026-11-17, Mac task 317's DECISION 2): pyi's runtime, go/arbace/py, and the
# libm port it imports are compiled into the executable since W2's re-seed (goi's table lists them), so a run on stage 0
# ran the seed's runtime, not the checkout's, until the next re-seed. Here the executable's commit (its version map,
# *arbace-version*, kept in WORK/exe-version by the executable's path, size and time) is compared with the checkout's
# go/arbace/py{.ae,/} and go/arbace/libm{.ae,/} (git diff against that commit, the working tree's changes included): equal,
# the compiled runtime runs (ARBACE_GOI_FROM_SOURCE empty); else goi interprets the checkout's (ARBACE_GOI_FROM_SOURCE
# arbace/py, with arbace/libm when libm differs: arbace.go.repl/from-source, arbace.python.run/require-runtime!), about
# 50 s more a start. An executable of no commit of this repository or built dirty: the checkout's. The namespaces
# (arbace/python, arbace/repr/python, goi's arbace/go) need none of this: RT.toolSource loads a changed one from the
# checkout. Since queue 473 (456-3 (a), the main session 2026-11-20) the C back end the runtime's C modules run on,
# go/arbace/ci and go/arbace/crt (compiled into the executable too; ci imports crt, pyctypes and the C glue import ci), is
# compared likewise: crt differing interprets crt and ci, ci differing ci, beside py's decision (with an executable of
# no commit here or built dirty, both too), so a targeted bin/pyi check runs on a base whose ci or crt moved since stage 0
# (the gate's PYI_RUNTIME_REQUIRE=compiled is unchanged: interpreted is not compiled). Decided once by the outermost
# bin/pyi and exported, so its children (sys.executable, the checks' runs)
# inherit it; PYI_RUNTIME=compiled|checkout overrides; the decision is printed once on stderr (PYI_RUNTIME_NOTED), but not
# by bin/pyi python (sys.executable) nor, when the compiled runtime runs, by run and repl (the program's stderr).
pyi_runtime_paths=(go/arbace/py.ae go/arbace/py go/arbace/libm.ae go/arbace/libm)
exe_version() {
  local exe=$1 k f
  k=$(stat -L -c '%n %s %Y %i' "$exe" | sha256sum | cut -c1-16)
  f="$WORK/exe-version/$k"
  if [ ! -s "$f" ]; then
    mkdir -p "$WORK/exe-version"
    env -u ARBACE_PATH "$exe" -e '(print (System/getProperty "arbace.version"))' > "$f.$$" 2>"$f.$$.err" || true
    mv -f "$f.$$" "$f"; rm -f "$f.$$.err"
  fi
  cat "$f"
}
# runtime_c_from_source EXE: ci and crt's part of ARBACE_GOI_FROM_SOURCE (queue 473): arbace/crt,arbace/ci when crt differs
# from EXE's commit (ci imports crt, so a listed ci would keep the compiled crt), arbace/ci when ci alone differs, both
# for an executable of no commit here or built dirty, else nothing
runtime_c_from_source() {
  local v commit
  v=$(exe_version "$1"); commit=$(sed -n 's/.*:commit "\([0-9a-f]*\)".*/\1/p' <<< "$v")
  if [ -z "$commit" ] || grep -q ':dirty true' <<< "$v" || ! git -C "$root" cat-file -e "$commit^{commit}" 2>/dev/null; then
    echo arbace/crt,arbace/ci
  elif ! git -C "$root" diff --quiet "$commit" -- go/arbace/crt.ae go/arbace/crt; then echo arbace/crt,arbace/ci
  elif ! git -C "$root" diff --quiet "$commit" -- go/arbace/ci.ae go/arbace/ci; then echo arbace/ci
  fi
}
# runtime_clib_from_source EXE CSET SET (queue 521, DECISION 521-2 (b)): the C library host and _ctypes's package, listed in
# goi's table since 521 (pyctypes imports py, ci, crt and clib; clib ci and crt), for ARBACE_GOI_FROM_SOURCE: arbace/clib (its
# interpreted copy never sees the compiled worlds' registrations: the node program is loaded, the fallback) when ci or crt
# come from source (CSET) or go/arbace/clib differs from EXE's commit (a world's node program or its compiled package with
# it), arbace/pyctypes with it and when py comes from source (SET) or go/arbace/pyctypes differs; nothing when EXE lists no
# arbace/pyctypes (an executable before 521: both interpreted from their forms on first import, as lazy modules)
runtime_clib_from_source() {
  local exe=$1 cset=$2 set=$3 v commit k f out="" clib=""
  k=$(stat -L -c '%n %s %Y %i' "$exe" | sha256sum | cut -c1-16); f="$WORK/exe-version/$k.pyctypes"
  if [ ! -s "$f" ]; then
    mkdir -p "$WORK/exe-version" "$WORK/tmp"
    (cd "$WORK/tmp" && ARBACE_PATH= "$exe" -e '(println (boolean (some #{"arbace/pyctypes"} (arbace.lang.GoInterp/paths))))' 2>/dev/null | tail -1) > "$f.$$" || true
    mv -f "$f.$$" "$f"
  fi
  [ "$(cat "$f")" = true ] || return 0
  v=$(exe_version "$exe"); commit=$(sed -n 's/.*:commit "\([0-9a-f]*\)".*/\1/p' <<< "$v")
  if [ -n "$cset" ] || [ -z "$commit" ] || grep -q ':dirty true' <<< "$v" || ! git -C "$root" cat-file -e "$commit^{commit}" 2>/dev/null \
     || ! git -C "$root" diff --quiet "$commit" -- go/arbace/clib.ae go/arbace/clib; then clib=1; fi
  if [ -n "$clib" ]; then out=arbace/clib,arbace/pyctypes
  elif [ -n "$set" ] || ! git -C "$root" diff --quiet "$commit" -- go/arbace/pyctypes.ae go/arbace/pyctypes; then out=arbace/pyctypes; fi
  # py-speed-1126: the glue of _bz2, _lzma and _zstd, listed too when EXE lists arbace/pybz2: from source with clib or py, or
  # when its own forms differ from EXE's commit (an interpreted py registers no compiled package's module)
  if [ "$(exe_lists "$exe" arbace/pybz2)" = true ]; then
    local g
    for g in pybz2 pylzma pyzstd; do
      if [ -n "$clib" ] || [ -n "$set" ] || ! git -C "$root" diff --quiet "$commit" -- "go/arbace/$g.ae" "go/arbace/$g"; then
        out+=${out:+,}arbace/$g
      fi
    done
  fi
  echo "$out"
}
# exe_lists EXE PATH: true when EXE's goi table lists the Go package PATH (kept by the executable's identity), else false
exe_lists() {
  local exe=$1 p=$2 k f
  k=$(stat -L -c '%n %s %Y %i' "$exe" | sha256sum | cut -c1-16); f="$WORK/exe-version/$k.${p//\//_}"
  if [ ! -s "$f" ]; then
    mkdir -p "$WORK/exe-version" "$WORK/tmp"
    (cd "$WORK/tmp" && ARBACE_PATH= "$exe" -e "(println (boolean (some #{\"$p\"} (arbace.lang.GoInterp/paths))))" 2>/dev/null | tail -1) > "$f.$$" || true
    mv -f "$f.$$" "$f"
  fi
  cat "$f"
}
runtime_from_source() {
  local verb=${1:-} exe v commit set="" why
  if [ -z "${ARBACE_GOI_FROM_SOURCE+x}" ]; then
    exe=$(arbace_exe 2>&1) || return 0   # no stage 0: the verb's own run says so
    case ${PYI_RUNTIME:-auto} in
      compiled) why="PYI_RUNTIME=compiled" ;;
      checkout) set=arbace/libm,arbace/py; why="PYI_RUNTIME=checkout" ;;
      auto)
        v=$(exe_version "$exe")
        commit=$(sed -n 's/.*:commit "\([0-9a-f]*\)".*/\1/p' <<< "$v")
        if [ -z "$commit" ] || ! git -C "$root" cat-file -e "$commit^{commit}" 2>/dev/null; then
          set=arbace/libm,arbace/py; why="the executable's commit ${commit:-(none)} is none of this repository's"
        elif grep -q ':dirty true' <<< "$v"; then
          set=arbace/libm,arbace/py; why="the executable was built from a dirty tree at ${commit:0:12}"
        elif ! git -C "$root" diff --quiet "$commit" -- go/arbace/libm.ae go/arbace/libm; then
          set=arbace/libm,arbace/py; why="go/arbace/libm differs from the executable's ${commit:0:12}"
        elif ! git -C "$root" diff --quiet "$commit" -- go/arbace/py.ae go/arbace/py; then
          set=arbace/py; why="go/arbace/py differs from the executable's ${commit:0:12}"
        else why="go/arbace/py and libm are the executable's ${commit:0:12}"; fi ;;
      *) die "PYI_RUNTIME: compiled, checkout or auto, not ${PYI_RUNTIME}" ;;
    esac
    # the C back end (queue 473, 456-3 (a)): ci and crt from source when they differ from the executable's commit
    # (py interpreted with them, also when py is the executable's: runtime_state's compiled means nothing from source)
    if [ "${PYI_RUNTIME:-auto}" != compiled ]; then
      local cset
      cset=$(runtime_c_from_source "$exe")
      if [ -n "$cset" ]; then
        if [ -z "$set" ]; then set=arbace/py; why="go/arbace/py is the executable's ${commit:0:12}, interpreted with the C back end"; fi
        set="$cset,$set"; why="$why; go/${cset//,/ and go\/} differ from the executable's"
      fi
    fi
    if [ "${PYI_RUNTIME:-auto}" != compiled ]; then
      local xset
      xset=$(runtime_clib_from_source "$exe" "${cset:-}" "$set")
      if [ -n "$xset" ]; then set="$xset${set:+,$set}"; why="$why; go/${xset//,/ and go\/} interpreted"; fi
    fi
    export ARBACE_GOI_FROM_SOURCE=$set
    if [ -z "${PYI_RUNTIME_NOTED:-}" ] && [ "$verb" != python ] && { [ -n "$set" ] || { [ "$verb" != run ] && [ "$verb" != repl ]; }; }; then
      if [ -n "$set" ]; then echo "pyi: the checkout's runtime (${set//,/ and }) interpreted by goi: $why" >&2
      else echo "pyi: the compiled runtime of ${exe#$root/}: $why" >&2; fi
    fi
  fi
  export PYI_RUNTIME_NOTED=1
}
# runtime_state (queue 321, on runtime_from_source since the merge with next's h-pyi-runtime): which pyi runtime the
# tools' host runs here, after runtime_from_source decided (ARBACE_GOI_FROM_SOURCE). Prints
#   interpreted       the executable lists no arbace/py (before W2): goi interprets the checkout's runtime
#   compiled COMMIT   listed, none from source, and the checkout's runtime packages (go/arbace/{py,libm,ci,crt}, and since
#                     queue 521 clib and pyctypes when the executable lists arbace/pyctypes) are COMMIT's
#   checkout COMMIT   listed at COMMIT, the checkout's go/arbace/py (and libm) interpreted from source (runtime_from_source):
#                     the checkout's runtime, at goi's speed and with goi's own divergences
#   stale COMMIT N    what runs compiled is not the checkout's: N files of the packages not loaded from source differ from
#                     COMMIT's (PYI_RUNTIME=compiled on an older executable; since queue 473 runtime_from_source interprets ci and
#                     crt too when they differ), or N "?": an executable of no commit here or built dirty
RUNTIME_PKGS=(go/arbace/py.ae go/arbace/py go/arbace/libm.ae go/arbace/libm go/arbace/ci.ae go/arbace/ci go/arbace/crt.ae go/arbace/crt)
runtime_state() {
  local out listed v commit n src=",${ARBACE_GOI_FROM_SOURCE:-}," p pkgs=()
  mkdir -p "$WORK/tmp"
  out=$(cd "$WORK/tmp" && ARBACE_PATH= "$(arbace_exe)" -e '(println (boolean (some #{"arbace/py"} (arbace.lang.GoInterp/paths))))' 2>/dev/null | tail -1) || true
  case $out in false) echo interpreted; return ;; true) ;; *) die "runtime_state: the tools' host $(arbace_exe) did not answer (${out:-no output})" ;; esac
  v=$(exe_version "$(arbace_exe)"); commit=$(sed -n 's/.*:commit "\([0-9a-f]*\)".*/\1/p' <<< "$v")
  if [ -z "$commit" ] || grep -q ':dirty true' <<< "$v" || ! git -C "$root" cat-file -e "$commit^{commit}" 2>/dev/null; then
    case $src in *,arbace/py,*) echo "checkout ${commit:--}" ;; *) echo "stale ${commit:--} ?" ;; esac; return
  fi
  # queue 521 (finding 6): an executable that lists arbace/pyctypes compiles clib (with the worlds) and pyctypes too
  local ps=(py libm ci crt)
  out=$(cd "$WORK/tmp" && ARBACE_PATH= "$(arbace_exe)" -e '(println (boolean (some #{"arbace/pyctypes"} (arbace.lang.GoInterp/paths))))' 2>/dev/null | tail -1) || true
  [ "$out" != true ] || ps+=(clib pyctypes)
  # py-speed-1126: and the glue of _bz2, _lzma and _zstd when it lists arbace/pybz2
  [ "$(exe_lists "$(arbace_exe)" arbace/pybz2)" != true ] || ps+=(pybz2 pylzma pyzstd)
  for p in "${ps[@]}"; do case $src in *",arbace/$p,"*) ;; *) pkgs+=("go/arbace/$p.ae" "go/arbace/$p") ;; esac; done
  # every package from source: nothing runs compiled (an empty pathspec would diff the whole checkout)
  n=0; [ ${#pkgs[@]} = 0 ] || n=$( { git -C "$root" diff --name-only "$commit" -- "${pkgs[@]}"; git -C "$root" ls-files --others --exclude-standard -- "${pkgs[@]}"; } | wc -l)
  if [ "$n" != 0 ]; then echo "stale $commit $n"
  else case $src in *,arbace/py,*) echo "checkout $commit" ;; *) echo "compiled $commit" ;; esac; fi
}
# runtime_guard WHAT RECORD (queue 321): before a check that runs pyi on the tools' host (WHAT names it), after
# runtime_from_source. A record (RECORD non-empty) is the checkout's runtime compiled, as the gate's checks that judge
# against it run it (DECISION 1 (a), the user 2026-11-17: pyi-check, pyi-check-aot-goi, pyi-runtime on the gate's
# executable at the checkout's key): any other state refuses it, the checkout's interpreted too (goi's speed moves the
# timeouts and goi has divergences of its own: queue 321's slice, 1 h 54 min against 31 min, test_manager's 82 and three
# more failing on goi alone); PYI_RUNTIME_STALE=1 records anyway (a dry run's record, never one to commit).
# PYI_RUNTIME_REQUIRE=compiled (the gate's steps) fails any state but compiled. Otherwise a stale runtime fails (it is not
# the checkout's), unless PYI_RUNTIME=compiled asked for it (then a warning). The executable that runs the checkout's runtime
# compiled is the gate's build at the checkout's key (bin/arbace-go --gate-build; bin/pyi records takes it).
runtime_guard() {
  local what=$1 record=$2 s; s=$(runtime_state)
  local hint="the checkout's runtime compiled is the gate's build at its key: ARBACE_HOST_EXE=\$(. bin/lib/gate-cache.bash; arbace_gate_cache \"\$PWD\")/amd64/arbace after bin/arbace-go --gate-build (bin/pyi records takes it)"
  case $s in compiled*) return 0 ;; esac
  local msg="$what: pyi's runtime on $(arbace_exe) is '$s'"
  case $s in
    stale*) msg="$msg: what runs compiled is not the checkout's go/arbace/{py,libm,ci,crt}" ;;
    checkout*) msg="$msg: the checkout's runtime interpreted by goi (runtime_from_source)" ;;
    interpreted) msg="$msg: an executable with no compiled runtime, goi interprets the checkout's" ;;
  esac
  if [ -n "$record" ]; then
    if [ "${PYI_RUNTIME_STALE:-}" != 1 ]; then die "$msg: --record refused (a record is the checkout's runtime compiled); $hint"; fi
    echo "pyi: WARNING $msg (PYI_RUNTIME_STALE=1: recorded anyway, a dry run's record, never one to commit)" >&2; return 0
  fi
  if [ "${PYI_RUNTIME_REQUIRE:-}" = compiled ]; then die "$msg: PYI_RUNTIME_REQUIRE=compiled; $hint"; fi
  case $s in
    stale*) if [ "${PYI_RUNTIME:-}" = compiled ]; then echo "pyi: WARNING $msg (PYI_RUNTIME=compiled)" >&2; else die "$msg; $hint"; fi ;;
  esac
  return 0
}
# the oracle, CPython (queue 213): looked for only when a verb runs it (the records, the native read and the AOT need none;
# doc/ORACLE-RECORDS-SURVEY.md, ORS14 (a)); a call through env, timeout or a list (smoke_run, run_one) checks first
need_python() { type -P python3 >/dev/null || die "no python3 (the oracle, CPython 3.14.10): ${1:-this verb} runs it (doc/ALPINE.md)"; }
python3() { need_python; command python3 "$@"; }
py() { local s=$1; shift; python3 -I -S -B "$root/tools/pydump/$s" "$@"; }
# the oracle's records (queue 213): REPR_PYTHON_ORACLE records|live|record, tools/pydump/records.bash
. "$root/tools/pydump/records.bash"
PYREC_VERB="bin/pyi $*"
trap 'rc=$?; pyrec_flush || rc=1; exit $rc' EXIT
pyall() { python3 -I -S -B "$root/tools/pyi/libtest_all.py" "$@"; }
# pyrun VERB ...: the check's verbs of tools/pyi/libtest_all.py (owned, run, controls, table) with no python3 (queue 234:
# Lib/test's judge by each test's own verdict needs no CPython at check time, and its runner none either): the runner
# compiled by pyi's AOT (runner_exe), run as aot_run runs a program; PYI_RUNNER=python3: by python3 as before (pyall),
# PYI_RUNNER=pyi: by bin/pyi run (slow: about 45 s a start on the VM)
pyrun() {
  case ${PYI_RUNNER:-aot} in
    python3) pyall "$@" ;;
    pyi) "$root/bin/pyi" run "$root/tools/pyi/libtest_all.py" "$@" ;;
    aot) local r; r=$(runner_exe) || return 1; PYI_AOT_COMPILER="$AOT/compiler.sh" "$r" "$root/tools/pyi/libtest_all.py" "$@" ;;
    *) die "PYI_RUNNER=$PYI_RUNNER: aot, pyi or python3" ;;
  esac
}
# judge_verdict ORACLE: Lib/test's verdict (queue 234): PYI_VERDICT, else own (each test's own, unittest's outcome under
# pyi: the user's rule of 2026-11-07), ref with --oracle (python3's runs judged against CPython's records, the runner's
# control)
judge_verdict() { if [ -n "${PYI_VERDICT:-}" ]; then echo "$PYI_VERDICT"; elif [ -n "$1" ]; then echo ref; else echo own; fi; }
# runner_exe: tools/pyi/libtest_all.py compiled by pyi's AOT into WORK/aot/bin/p_libtest_all, kept by the runtime's key,
# the generator's digest and the script's (compiled again when one changes); prints its path. Its progress on stderr
runner_exe() { script_exe "$root/tools/pyi/libtest_all.py"; }
# launcher_py (queue 284, 279's DECISION (a)): the compiled launcher, tools/pyi/launcher.py compiled by pyi's AOT (script_exe),
# and its wrapper WORK/aot/bin/python3, sys.executable of a compiled Lib/test driver: CPython's command line by bin/pyi python
# (cmd_python), the program run by the launcher's executable, not pyi on goi (a child's start about 3 s where goi's took 30 s
# and more). The paths are written into the wrapper, so a child started with an empty environment starts compiled too.
# py-footprint-1127: a child's collector at GOGC 100 (PYI_CHILD_GOGC another; set after PYI_ENTRY_ENV, so os.environ is the
# caller's), not a compiled program's 400 (AotMain's, a benchmark's): its heap about twice its live data, a spawn worker
# importing test._test_multiprocessing about 120 MB of its own where 400 gave about 145 MB.
# Prints the wrapper's path
launcher_py() {
  local exe w="$AOT/bin/python3" arch
  # queue 594: lib-dynload on the launcher's sys.path after the stdlib, as bin/pyi python's --site has it
  exe=$(PYI_AOT_SITE="$root/tools/pyi/lib-dynload" script_exe "$root/tools/pyi/launcher.py") || return 1
  arch=$(uname -m)
  # platform.libc_ver(sys.executable) reads the next line as tools/pyi/python3's (test.support.linked_to_musl)
  printf '#!/bin/sh
# bin/pyi'"'"'s compiled launcher (queue 284): pyi'"'"'s C library semantics are musl'"'"'s, ld-musl-%s.so.1
PYI_ENTRY_ENV=$(env -u PYI_ENTRY_ENV -0 | tr '"'"'\\0\\n'"'"' '"'"'\\036\\035'"'"') GOGC=${PYI_CHILD_GOGC:-100} PYI_LAUNCHER=%q PYI_LAUNCHER_PY=%q PYI_LAUNCHER_COMPILER=%q exec %q python "$@"
' \
    "$arch" "$exe" "$w" "$AOT/compiler.sh" "$root/bin/pyi" > "$w.$$"
  chmod +x "$w.$$"; mv "$w.$$" "$w"
  echo "$w"
}
# script_exe SCRIPT (queue 240): a tool's Python script (tools/pyi, tools/pydump) compiled by pyi's AOT into
# WORK/aot/bin/p_NAME, kept by the runtime's key, the generator's digest and the script's; prints its path
script_exe() {
  local f=$1 pkg out key
  pkg=p_$(basename "$f" .py | tr -c 'A-Za-z0-9\n' '_'); out="$AOT/bin/$pkg"
  aot_module >&2
  key="$(cat "$AOT/mod/runtime.key") $(aot_gen) $(sha256sum < "$f" | cut -c1-16)${PYI_AOT_SITE:+ site=$PYI_AOT_SITE}"
  if [ "$(cat "$out.key" 2>/dev/null)" != "$key" ] || [ ! -x "$out" ]; then
    echo "pyi: ${f#$root/} compiled by pyi's AOT" >&2
    aot_compile "$pkg" "$f" "$out" >&2
    [ ! -f "$out.refused" ] || die "${f#$root/} is refused by pyi's AOT: $(cat "$out.refused")"
    [ -x "$out" ] || die "${f#$root/} did not build ($AOT/log/$pkg.*)"
    echo "$key" > "$out.key"
  fi
  echo "$out"
}
# script SCRIPT ARGS... (queue 240): a tool's script run by pyi (compiled by its AOT, script_exe) where python3 ran it: the
# check-time tools that read the pinned tarball's text (tools/pydump/syntax_cases.py: the syntax-error cases and their
# own verdicts) need no CPython; PYI_RUNNER=pyi runs it on goi (bin/pyi run), =python3 by the oracle
cmd_script() {
  [ $# -ge 1 ] || die "usage: bin/pyi script SCRIPT [ARGS...]"
  local f; f=$(cd "$caller_pwd" && realpath "$1"); shift
  case $f in "$root"/tools/pyi/*.py|"$root"/tools/pydump/*.py) ;; *) die "script: a script of tools/pyi or tools/pydump (not $f)" ;; esac
  case ${PYI_RUNNER:-aot} in
    python3) python3 -I -S -B "$f" "$@" ;;
    pyi) "$root/bin/pyi" run "$f" "$@" ;;
    aot) local r; r=$(script_exe "$f") || return 1; (cd "$caller_pwd" && PYI_AOT_COMPILER="$AOT/compiler.sh" "$r" "$f" "$@") ;;
    *) die "PYI_RUNNER=$PYI_RUNNER: aot, pyi or python3" ;;
  esac
}

check_oracle() {
  local want have
  want=$(sed -n 's/^sys\.version //p' "$root/tools/pydump/PYTHON_VERSION")
  have=$(python3 -I -c 'import sys; print(sys.version)')
  [ "$want" = "$have" ] || die "the oracle is '$have', tools/pydump/PYTHON_VERSION pins '$want'"
  [ "$(python3 -I -c 'import sys; print(sys.implementation.name)')" = cpython ] || die "the oracle is not CPython"
}

cmd_gen() {
  local check=${1:-}
  if [ "$check" = --check ]; then
    local d="$WORK/gen"; rm -rf "$d"; mkdir -p "$d"
    "$(arbace_exe)" "$root/test/python/gen.ae" "$d"
    local bad=0
    diff -r "$d" "$SYNTH" > "$WORK/gen.diff" || { echo "gen --check: the generated corpus differs from test/python/synth (bin/pyi gen):"; head -20 "$WORK/gen.diff"; bad=1; }
    # the negative control (GTS81 (a), queue 235): the same comparison on a crossed pair, the generated ops/ against the
    # committed datamodel/, must find them different ("control passed" or "control not judged" fails the check)
    if [ ! -d "$d/ops" ] || [ ! -d "$SYNTH/datamodel" ]; then echo "control not judged: gen --check: no generated ops/ or committed datamodel/"; bad=1
    elif diff -r "$d/ops" "$SYNTH/datamodel" > /dev/null 2>&1; then echo "control passed: gen --check: the generated ops/ judged equal to the committed datamodel/"; bad=1
    else echo "control failed as it must: gen --check: the generated ops/ against the committed datamodel/"; fi
    # CPython's verdicts (corpus.py: the programs parsed and compiled, the node classes and the builtins' methods covered),
    # live or recorded (queue 213), keyed by corpus.py and the files each reads
    local cp="$root/tools/pydump/corpus.py" out
    gen_samples() { (cd "$1" && command python3 -I -S -B "$cp" samples . .); }
    pyrec_outcome gen-constructs "$(pyrec_key "$cp" $(find "$SYNTH/constructs" -name '*.py' | LC_ALL=C sort))" gen_samples "$SYNTH/constructs" || bad=1
    { pyrec_outcome gen-synth "$(pyrec_key "$cp" $(find "$SYNTH" -name '*.py' | LC_ALL=C sort))" gen_samples "$SYNTH" || true; } | tail -1
    local t
    for t in str bytes list tuple dict set frozenset int float complex bool range memoryview slice bytearray; do
      local -a fs=("$SYNTH/builtins/$t.py"); [ "$t" != bytearray ] || fs+=("$SYNTH/builtins/bytearray-shared.py")
      if out=$(pyrec_outcome "gen-methods-$t" "$(pyrec_key "$cp" "${fs[@]}")" command python3 -I -S -B "$cp" methods "$t" "${fs[@]}"); then
        tail -1 <<< "$out" | grep -q ' of ' || bad=1
      else grep UNCOVERED <<< "$out" || true; bad=1; fi
    done
    if [ $bad = 0 ]; then echo "gen --check: $(wc -l < "$SYNTH/MANIFEST") programs as committed; every node class and builtin method covered"; else return 1; fi
  else
    rm -rf "$SYNTH"; mkdir -p "$SYNTH"
    "$(arbace_exe)" "$root/test/python/gen.ae" "$SYNTH"
  fi
}

# corpus_modules ID: a lib-test corpus's modules, comma-separated: each path's module, a directory's test_*.py as
# PACKAGE.MODULE (PY6h's REQUEST, queue 200: test_asyncio)
corpus_modules() {
  local p out=()
  for p in $("$(arbace_exe)" -e "(println (arbace.string/join \" \" (get-in (first (filter #(= :$1 (:id %)) (:corpora (read-string (slurp \"$root/test/python/corpora.edn\"))))) [:where :paths])))"); do
    p=${p#Lib/test/}
    if [ -d "$(pytop)/Lib/test/$p" ]; then
      local f; for f in "$(pytop)/Lib/test/$p"/test_*.py; do f=$(basename "$f" .py); out+=("$p.$f"); done
    else out+=("${p%.py}"); fi
  done
  [ ${#out[@]} -gt 0 ] || die "no lib-test corpus $1 in test/python/corpora.edn"
  (IFS=,; echo "${out[*]}")
}

# lib-test's modules, from test/python/corpora.edn (the corpora :language-core's and :stdlib-tests' paths, as module
# names; a package is its directory)
core_modules() {
  "$(arbace_exe)" -e "(println (arbace.string/join \",\" (map #(-> % (subs 9) (arbace.string/replace #\"\\.py\$\" \"\")) (mapcat #(get-in % [:where :paths]) (filter #(#{:language-core :stdlib-tests} (:id %)) (:corpora (read-string (slurp \"$root/test/python/corpora.edn\"))))))))"
}

tarball_test() {
  local top; top=$(pytop)
  mkdir -p "$WORK/pypath"; ln -sfn "$top/Lib/test" "$WORK/pypath/test"
}

# run_programs TAG: the synthetic corpus and the samples, one TSV
run_programs() {
  local tag=$1 d="$WORK/$1"
  rm -rf "$d"; mkdir -p "$d"
  { sed 's|^|synth/|' "$SYNTH/MANIFEST"; (cd "$root/test/python/samples" && ls *.py | sed 's|^|samples/|'); } > "$d/list"
  mkdir -p "$d/base"; ln -sfn "$SYNTH" "$d/base/synth"; ln -sfn "$root/test/python/samples" "$d/base/samples"
  py refs.py programs --base "$d/base" --list "$d/list" --work "$d" --out "$d/programs.tsv"
}

run_libtest() {
  local tag=$1 d="$WORK/$1" mods=${2:-$(core_modules)}
  mkdir -p "$d"
  tarball_test
  py refs.py libtest --pypath "$WORK/pypath" --modules "$mods" --work "$d" --out "$d/libtest.tsv"
}

header() { # FILE WHAT
  cat > "$1" <<HDR
;; CPython 3.14.10's reference runs of $2, as data (doc/python/PYTHON-SURVEY.md §8.1, PYS14 (a), PYS15 (a); GTS207 (a)):
;; one map per line, sorted by :id. Programs: :status the exit status (128+signal, :timeout), :stdout the SHA-256 of
;; the standard output, :bytes its size, :first its first line (80 chars), :stderr-last the last non-blank line of the
;; standard error. Lib/test: :outcome :ok, :skipped (:reason), :failure or :error per test method, :module true lines
;; with regrtest's exit status. :excluded names an entry kept out of the references: the two recording runs disagree,
;; or its output names the machine (an address, the architecture, the C library, a size): bin/pyi record-ref --check
;; reproduces the others. Made by: bin/pyi record-ref ($(python3 -I -c 'import sys; print(sys.version.split()[0], sys.implementation.name)'),
;; python3 -s -P -B, PYTHONHASHSEED=0 LC_ALL=C.UTF-8 TZ=UTC PYTHONIOENCODING=utf-8; regrtest -u none --randseed 1).
;; date: $(date -u +%F)
HDR
}

cmd_record_ref() {
  need_python "record-ref (CPython's runs; --check is the oracle tier's verify)"
  local check="" ids=()
  while [ $# -gt 0 ]; do case $1 in --check) check=1; shift ;; *) ids+=("$1"); shift ;; esac; done
  [ ${#ids[@]} -gt 0 ] || ids=(programs language-core)
  check_oracle
  local id rc=0
  for id in "${ids[@]}"; do
    case $id in
      synthetic|samples|programs)
        if [ -n "$check" ]; then
          run_programs check1; run_programs check2
          py refs.py check --kind programs --ref "$REF" --run "$WORK/check1/programs.tsv" || rc=1
          py refs.py check --kind programs --ref "$REF" --run "$WORK/check2/programs.tsv" || rc=1
        else
          run_programs rec1; run_programs rec2
          header "$WORK/header.txt" "the synthetic corpus (test/python/synth) and the samples (test/python/samples)"
          py refs.py record --kind programs --a "$WORK/rec1/programs.tsv" --b "$WORK/rec2/programs.tsv" --out "$REF" \
            --header "$WORK/header.txt" --costs "$COSTS"
        fi ;;
      language-core)
        if [ -n "$check" ]; then
          run_libtest check1; run_libtest check2
          py refs.py check --kind libtest --ref "$REF_LT" --run "$WORK/check1/libtest.tsv" || rc=1
          py refs.py check --kind libtest --ref "$REF_LT" --run "$WORK/check2/libtest.tsv" || rc=1
        else
          run_libtest rec1; run_libtest rec2
          header "$WORK/header.txt" "Lib/test's language-core modules (test/python/corpora.edn), per test method"
          py refs.py record --kind libtest --a "$WORK/rec1/libtest.tsv" --b "$WORK/rec2/libtest.tsv" --out "$REF_LT" \
            --header "$WORK/header.txt" --costs "$COSTS_LT"
        fi ;;
      lib-test-all)
        local L="$WORK/lib-test-all"; mkdir -p "$L"; tarball_test
        # the modules outside every family's (test/python/lib-test-all-owners.tsv): the families' are lib-test's references
        pyall list --pypath "$WORK/pypath" --work "$L" --out "$L/all-modules.txt"
        pyall owned --owners "$root/test/python/lib-test-all-owners.tsv" --modules "$L/all-modules.txt" --invert > "$L/modules.txt"
        local t runs="rec1 rec2"; [ -z "$check" ] || runs="check1 check2"
        for t in $runs; do
          rm -rf "${L:?}/$t"; mkdir -p "$L/$t"
          # PYTHONPATH the tarball's Lib, as pyi and the driver's control see it (its Tools/ and i18n data, its paths),
          # then the reference's copies of the C library modules the oracle lacks (queue 215: _zstd, CPython's glue
          # over the pinned zstd, tools/pyi/clib/refmod.bash)
          pyall refs --pypath "$(stdlib_lib):$("$root/tools/pyi/clib/refmod.bash" zstd "$WORK/refmods")" --modules "$L/modules.txt" --work "$L/$t" --out "$L/$t/libtest.tsv" --jobs "${PYI_LIB_TEST_JOBS:-2}" \
            --tmp-base "${PYI_LIB_TEST_TMP:-$root/.tmp/t6i}" || true
        done
        if [ -n "$check" ]; then
          py refs.py check --kind libtest --ref "$REF_ALL" --run "$L/check1/libtest.tsv" || rc=1
          py refs.py check --kind libtest --ref "$REF_ALL" --run "$L/check2/libtest.tsv" || rc=1
        else
          header "$WORK/header.txt" "Lib/test as regrtest finds it (python3 -m test --list-tests) but the PY6 families' modules (test/python/lib-test-all-owners.tsv): $(wc -l < "$L/modules.txt") of $(wc -l < "$L/all-modules.txt") modules, PYTHONPATH the tarball's Lib; per test method"
          py refs.py record --kind libtest --a "$L/rec1/libtest.tsv" --b "$L/rec2/libtest.tsv" --out "$REF_ALL" \
            --header "$WORK/header.txt" --costs "$COSTS_ALL"
          pyall fixrefs --ref "$REF_ALL" --root "$root"
        fi ;;
      lib-test-*)
        # another lib-test corpus (PY6h's REQUEST, queue 200): its references in ref-cpython314-ID.edn
        local mods ref="$root/test/python/ref-cpython$RECV-$id.edn"; mods=$(corpus_modules "$id")
        if [ -n "$check" ]; then
          run_libtest "check1-$id" "$mods"; run_libtest "check2-$id" "$mods"
          py refs.py check --kind libtest --ref "$ref" --run "$WORK/check1-$id/libtest.tsv" || rc=1
          py refs.py check --kind libtest --ref "$ref" --run "$WORK/check2-$id/libtest.tsv" || rc=1
        else
          run_libtest "rec1-$id" "$mods"; run_libtest "rec2-$id" "$mods"
          header "$WORK/header.txt" "Lib/test's $id corpus (test/python/corpora.edn), per test method"
          py refs.py record --kind libtest --a "$WORK/rec1-$id/libtest.tsv" --b "$WORK/rec2-$id/libtest.tsv" --out "$ref" \
            --header "$WORK/header.txt" --costs "$root/test/python/ref-costs-$id$RECS.edn"
        fi ;;
      *) die "no corpus $id (programs, language-core, lib-test-all, lib-test-*)" ;;
    esac
  done
  # queue 256: the universe follows Lib/test's references (written afresh after a lib-test corpus is recorded)
  if [ -z "$check" ] && printf '%s\n' "${ids[@]}" | grep -q '^\(language-core\|lib-test-.*\)$'; then cmd_universe || rc=1; fi
  return $rc
}

# corpus_list ID DIR: the corpus's base directory (stdout) and its files' list into DIR/list
corpus_list() {
  local id=$1 d=$2 line base paths excl
  line=$("$(arbace_exe)" -e "(let [c (first (filter #(= :$id (:id %)) (:corpora (read-string (slurp \"$root/test/python/corpora.edn\")))))] (when c (let [w (:where c)] (println (if (:pin w) (name (:pin w)) (str \"root:\" (:root w))) (arbace.string/join \",\" (:paths w)) (if (seq (:exclude w)) (arbace.string/join \",\" (:exclude w)) \"-\")))))")
  [ -n "$line" ] || die "no corpus $id in test/python/corpora.edn"
  read -r base paths excl <<< "$line"
  case $base in
    cpython-3.14.10) base="$root/.tmp/repr-python/Python-3.14.10"; [ -d "$base/Lib" ] || env -u REPR_PYTHON_VERSION "$root/bin/repr-python" pins --fetch >/dev/null ;;
    site-packages) base="$root/.tmp/repr-python/site-packages/$(uname -m)"; [ -d "$base" ] || env -u REPR_PYTHON_VERSION "$root/bin/repr-python" pins --fetch >/dev/null ;;
    root:*) base="$root/${base#root:}" ;;
  esac
  local -a args=(); IFS=, read -ra pa <<< "$paths"; args+=("${pa[@]}")
  if [ "$excl" != - ]; then IFS=, read -ra ea <<< "$excl"; for e in "${ea[@]}"; do args+=(--exclude "$e"); done; fi
  mkdir -p "$d"
  pyrec_list "$base" "${args[@]}" > "$d/list"
  echo "$base"
}

# pyi_gogc (py-mods-1122): a pyi process's collector at GOGC 100 (PYI_GOGC another; a GOGC of the environment kept), not
# the executable's default 200 (jrt's DefaultGOGC, a heap three times the live data as a JVM keeps for a Java program): a
# pyi process's heap then about twice its live data. Measured on the gate's executable (b2a5b50d4819): a spawned child's
# import of test._test_multiprocessing 2.54 GB resident at 200, 1.86 GB at 100 (its 17.5 s the same), an allocation loop
# 5% slower; so multiprocessing's tests, whose children each import their test module, pass the runner's memory cap
# less often (:host-memory)
pyi_gogc() { echo "${GOGC:-${PYI_GOGC:-100}}"; }

pa_arbace() {
  # x509roots/ is a source root of its own: _ssl's fallback store (arbace/pyssl over arbace/x509roots/fallback/bundle,
  # queue 209) loads its forms from there. GOGC: pyi_gogc
  ARBACE_PATH="$root:$root/x509roots" GOGC=$(pyi_gogc) GOMEMLIMIT=${PYI_GOMEMLIMIT:-$("$root/bin/gate-policy" mem 3GiB)} GOMAXPROCS=${PYI_THREADS:-4} "$(arbace_exe)" -m arbace.python "$@"
}

cmd_scope_check() {
  local record="" ids=() rc=0 worst=0 id
  while [ $# -gt 0 ]; do case $1 in --record) record=1; shift ;; *) ids+=("$1"); shift ;; esac; done
  [ ${#ids[@]} -gt 0 ] || ids=(samples synthetic errors stdlib site-packages lib-test)
  for id in "${ids[@]}"; do
    local d="$WORK/scope/$id" base t0
    rm -rf "$d"
    base=$(corpus_list "$id" "$d")
    t0=$(date +%s)
    rc=0
    pyrec_dump tree "$id" "$base" "$d/list" "$d/dumps" "$d/dumps.tsv" && pyrec_dump scopes "$id" "$base" "$d/list" "$d/scopes" \
      || { echo "scope-check $id: FAILED: no reference (the oracle's records, above)"; worst=1; continue; }
    pa_arbace scope-check --corpus "$id" --dumps "$d/dumps" --scopes "$d/scopes" --known "$root/test/python/scope-known.edn" \
      --results "$d/results.edn" ${record:+--record} || rc=$?
    echo "  $(( $(date +%s) - t0 )) s"
    [ $rc -gt $worst ] && worst=$rc
  done
  cscontrol scope || { [ $worst -gt 0 ] || worst=1; }
  return $worst
}

# cscontrol KIND [FULL] (GTS81 (a), PY10's R3, queue 201): the negative control of scope-check (KIND scope)
# and compile-check (KIND compile): a crossed pair judged by the check's own judge, which must fail it. scope: the
# sample classes.py's tree judged against functions.py's CPython symbol tables; compile: the sample classes.py's
# tree under the name of the error program annotated-global.py, against that program's CPython row (a compile error
# CPython raises and pyi, compiling classes.py, does not). Seconds; "control passed" or "control not judged" fails
cscontrol() {
  local kind=$1 full=${2:-} c="$WORK/controls/$1${2:+-full}" sb eb rc=0 out
  rm -rf "$c"; mkdir -p "$c/s" "$c/run/dumps" "$c/run/scopes"
  sb=$(corpus_list samples "$c/s")
  printf 'classes.py\nfunctions.py\n' > "$c/s/list"
  pyrec_dump "$([ -n "$full" ] && echo full || echo tree)" samples "$sb" "$c/s/list" "$c/s/dumps" "$c/s/dumps.tsv" \
    || { echo "control not judged: $kind${full:+ --full}: no reference"; return 1; }
  if [ "$kind" = scope ]; then
    pyrec_dump scopes samples "$sb" "$c/s/list" "$c/s/scopes" || { echo "control not judged: $kind: no reference"; return 1; }
    cp "$c/s/dumps/classes.py.ae" "$c/run/dumps/classes.py.ae"
    cp "$c/s/scopes/functions.py.scopes.ae" "$c/run/scopes/classes.py.scopes.ae"
    grep '^classes\.py	' "$c/s/dumps.tsv" > "$c/run/dumps.tsv"; echo classes.py > "$c/run/list"
    out=$(pa_arbace scope-check --corpus samples --dumps "$c/run/dumps" --scopes "$c/run/scopes" --known "$root/test/python/scope-known.edn" \
      --results "$c/run/results.edn" 2>&1) || rc=$?
  else
    mkdir -p "$c/e"; eb=$(corpus_list errors "$c/e"); echo annotated-global.py > "$c/e/list"
    pyrec_dump "$([ -n "$full" ] && echo full || echo tree)" errors "$eb" "$c/e/list" "$c/e/dumps" "$c/e/dumps.tsv" \
      || { echo "control not judged: $kind${full:+ --full}: no reference"; return 1; }
    cp "$c/s/dumps/classes.py.ae" "$c/run/dumps/annotated-global.py.ae"
    cp "$c/e/dumps.tsv" "$c/run/dumps.tsv"
    out=$(pa_arbace compile-check ${full:+--check compile-full} --corpus errors --dumps "$c/run/dumps" --tsv "$c/run/dumps.tsv" \
      --known "$root/test/python/compile-known.edn" --results "$c/run/results.edn" --ops "$c/run/ops.edn" 2>&1) || rc=$?
  fi
  if ! grep -q ': 1 files: ' <<< "$out"; then echo "control not judged: $kind${full:+ --full}: $(tail -2 <<< "$out")"; return 1
  elif [ $rc = 0 ] || grep -q ': 1 files: 1 equal' <<< "$out"; then echo "control passed: $kind${full:+ --full}: $(grep ': 1 files: ' <<< "$out")"; return 1
  else echo "control failed as it must: $kind${full:+ --full}: $(grep ': 1 files: ' <<< "$out")"; fi
}

cmd_compile_check() {
  local record="" full="" ids=() rc=0 worst=0 id
  while [ $# -gt 0 ]; do case $1 in --record) record=1; shift ;; --full) full=1; shift ;; *) ids+=("$1"); shift ;; esac; done
  [ ${#ids[@]} -gt 0 ] || ids=(samples synthetic errors stdlib site-packages lib-test)
  for id in "${ids[@]}"; do
    local d="$WORK/compile${full:+-full}/$id" base t0
    rm -rf "$d"
    base=$(corpus_list "$id" "$d")
    t0=$(date +%s)
    rc=0
    pyrec_dump "$([ -n "$full" ] && echo full || echo tree)" "$id" "$base" "$d/list" "$d/dumps" "$d/dumps.tsv" \
      || { echo "compile-check $id: FAILED: no reference (the oracle's records, above)"; worst=1; continue; }
    pa_arbace compile-check ${full:+--check compile-full} --corpus "$id" --dumps "$d/dumps" --tsv "$d/dumps.tsv" --known "$root/test/python/compile-known.edn" \
      --results "$d/results.edn" --ops "$d/ops.edn" ${record:+--record} || rc=$?
    echo "  $(( $(date +%s) - t0 )) s"
    [ $rc -gt $worst ] && worst=$rc
  done
  cscontrol compile "$full" || { [ $worst -gt 0 ] || worst=1; }
  return $worst
}

# stdlib_lib: the pinned tarball's Lib, sys.path's standard library until python/Lib is vendored (PY6; survey §6.6)
stdlib_lib() { echo "$(pytop)/Lib"; }

# pytop: the pinned CPython tree whose Lib pyi runs and whose Lib/test lib-test reads: 3.14.10's, or 3.15.2's under
# REPR_PYTHON_VERSION=3.15 (queue 252, PY315-SURVEY P7: the standard library moves with the language, 1.1; 3.14's
# unchanged), extracted when missing or not whole (no .extracted: queue 481)
pytop() {
  local top
  if [ "${REPR_PYTHON_VERSION:-}" = 3.15 ]; then
    top="$root/.tmp/repr-python/Python-3.15.2"
    [ -f "$top/.extracted" ] && [ -d "$top/Lib/test" ] || "$root/bin/repr-python" pins --fetch >/dev/null
  else
    top="$root/.tmp/repr-python/Python-3.14.10"
    [ -f "$top/.extracted" ] && [ -d "$top/Lib/test" ] || env -u REPR_PYTHON_VERSION "$root/bin/repr-python" pins --fetch >/dev/null
  fi
  echo "$top"
}

# PYI_SITE (queue 205): directories, colon-separated, on sys.path after the stdlib (a site of pinned wheels, bin/pyi
# wheels install); exported, so pyi's children (sys.executable) see the same site
# py-capi-1122: tools/pyi/lib-dynload first, CPython's lib-dynload: the export tables of the C world's extension modules
# (_testsinglephase, _testmultiphase), NAME.arbace-314.so, that _imp.create_dynamic loads
site_args=(--site "$root/tools/pyi/lib-dynload${PYI_SITE:+:$PYI_SITE}")

# the host's side of the runtime (arbace.python.run): its work directory and a run's id for its scratch
# py-footprint-1127: PYI_CHILD_EXECUTABLE another sys.executable (bin/pyi check's: the compiled launcher's wrapper, launcher_py)
pyi_env() { export PYI_ROOT="$root" PYI_WORK="$WORK" PYI_RUN_ID="$$" PYI_EXECUTABLE="${PYI_CHILD_EXECUTABLE:-$root/tools/pyi/python3}"; }

cmd_repl() {
  if [ "${1:-}" = --check ]; then repl_check; return; fi
  pyi_env
  pa_arbace repl --lib "$(stdlib_lib)" ${site_args[@]+"${site_args[@]}"}
}

# repl_check: test/python/pyi/*.in fed to bin/pyi repl and to the oracle's basic REPL (python3 -q -i): stdout, the
# status and stderr (prompts, tracebacks with their source lines and carets) equal byte for byte
repl_check() {
  local p n=0 bad=0 want got b
  local -A gots=()
  for p in "$root"/test/python/pyi/*.in; do
    b=$(basename "$p")
    # PYI_SMOKE_ONLY's sample, and the controls' subjects with every selection (queue 235)
    [[ $b =~ ${PYI_SMOKE_ONLY:-.} ]] || smoke_control_subject repl "$b" || continue
    n=$((n + 1))
    want=$(repl_want "$p") || { echo "  FAIL $b: no reference (the oracle's records)"; bad=$((bad + 1)); continue; }
    got=$(repl_run "$p" "$root/bin/pyi" repl); gots[$b]=$got
    smoke_verdict "$b" "$want" "$got" repl || bad=$((bad + 1))
  done
  echo "repl: $n sessions of test/python/pyi run by pyi's REPL as by the oracle's: $((n - bad)) equal"
  smoke_controls repl gots || bad=$((bad + 1))
  [ $bad -eq 0 ]
}
repl_want() { pyrec_outcome "repl/$(basename "$1")" "$(smoke_key "$1")" repl_run "$1" python3 -q -i; }

repl_run() {
  local in=$1 o e rc=0; shift
  o=$(mktemp "$WORK/smoke.XXXXXX"); e=$(mktemp "$WORK/smoke.XXXXXX")
  timeout 300 env HOME="$WORK" TMPDIR="$WORK" "$@" < "$in" > "$o" 2> "$e" || rc=$?
  cat "$o"; echo "status $rc"; cat "$e"
  rm -f "$o" "$e"
}

cmd_run() {
  [ $# -ge 1 ] || die "usage: bin/pyi run FILE.py [ARGS...]"
  local f d name argv0=$1
  case $1 in /*) f=$1 ;; *) f=$caller_pwd/$1 ;; esac
  f=$(cd "$(dirname "$f")" && pwd)/$(basename "$f")
  [ -f "$f" ] || die "no file $1"
  name=$(basename "$f")
  d=$(mktemp -d "$WORK/run.XXXXXX")
  local -a dump=()
  if [ "${PYI_READER:-native}" = helper ]; then
    echo "$name" > "$d/list"
    py pydump.py tree --full --base "$(dirname "$f")" --list "$d/list" --out "$d/dumps" --tsv "$d/tsv" >/dev/null
    dump=(--dump "$d/dumps/$name.ae")
  fi
  local rc=0
  shift
  pyi_env
  # in the caller's directory, as python3 runs a program (PY6e's REQUEST 5: lib-test's TESTFN files were made in the
  # checkout's root)
  (cd "$caller_pwd" && pa_arbace run ${dump[@]+"${dump[@]}"} --file "$f" --lib "$(stdlib_lib)" ${site_args[@]+"${site_args[@]}"} --argv0 "$argv0" -- "$@") || rc=$?
  rm -rf "$d"
  return $rc
}

# pyi_pystr S: S as a Python str literal ('...', backslashes and quotes escaped; a byte that is not UTF-8 kept as
# surrogateescape's \udcXX, as CPython decodes argv); pyi_is_zip FILE: a zip archive (its end of central directory
# record in the last 64 KiB, as zipimport finds it); pyi_is_pyc FILE: maybe_pyc_file (the .pyc suffix, or the first two
# bytes of importlib's magic number: pyi's, 'a' and a byte of its IR's digest, marshal_code.go's PycMagic, then \r\n)
pyi_pystr() {
  printf '%s' "$1" | od -An -v -tu1 | tr -s ' \n' '\n\n' | LC_ALL=C awk 'BEGIN { printf "\x27" }
    NF { b[n++] = $1 } END {
      for (i = 0; i < n; i++) { c = b[i]; l = 0
        if (c >= 194 && c <= 223) l = 1; else if (c >= 224 && c <= 239) l = 2; else if (c >= 240 && c <= 244) l = 3
        ok = (l > 0 && i + l < n); for (j = 1; ok && j <= l; j++) if (b[i+j] < 128 || b[i+j] > 191) ok = 0
        if (c < 128) { if (c == 39 || c == 92) printf "\\%c", c; else if (c < 32 || c == 127) printf "\\x%02x", c; else printf "%c", c }
        else if (ok) { for (j = 0; j <= l; j++) printf "%c", b[i+j]; i += l }
        else printf "\\udc%02x", c }
      printf "\x27" }'
}
pyi_is_zip() { tail -c 65557 "$1" 2>/dev/null | LC_ALL=C grep -qa $'PK\x05\x06'; }
pyi_is_pyc() { case $1 in *.pyc) return 0 ;; esac; [[ $(head -c 4 "$1" 2>/dev/null | od -An -tx1 | tr -d ' \n') =~ ^61..0d0a$ ]]; }

# python ARGS...: CPython's command line over bin/pyi run (PY6e, sys.executable: tools/pyi/python3 runs it), for
# test.support's script_helper and subprocess's children: -c CMD, -m MOD, FILE or - (stdin), the options before them
# taken and ignored (-I -E -s -S -B -u -b -q -O -P -R -d -v, -X OPT, -W ARG) but -E, -I, -P, -q, -u, -X, -W and -b (-q, -E, -I: sys.flags; queue 296;
# -W and -b: sys.warnoptions, -b sys.flags.bytes_warning, queue 328; -u: the standard streams' write_through); run in the caller's
# directory, sys.path[0] as CPython's sys_path_0 (the runtime's start, queue 250): '' for -c and stdin, the working
# directory for -m, the script's directory for FILE, none under -P or -I (safe_path, PYI_SAFE_PATH); -i (queue 289):
# the REPL on stdin after the code, or as the run when there is none (PYI_INSPECT), as on a terminal without -i (queue 313)
cmd_python() {
  local code="" mod="" file="" have="" xopts="" wopts="" bwarn=0 noenv="" safe=0 inspect="" quiet="" sflags="" stdinrepl="" unbuf=""
  # sys.orig_argv (queue 242): the executable and the command line as given, joined by the unit separator
  local oa="${PYI_LAUNCHER_PY:-${PYI_EXECUTABLE:-$root/tools/pyi/python3}}" oarg
  for oarg in "$@"; do oa+=$'\x1f'"$oarg"; done
  export PYI_ORIG_ARGV="$oa"
  while [ $# -gt 0 ]; do
    case $1 in
      -c) code=$2; have=c; shift 2; break ;;
      -m) mod=$2; have=m; shift 2; break ;;
      # -mMOD and -cCMD joined (py-os-1124: test_quopri's "-mquopri")
      -m?*) mod=${1#-m}; have=m; shift; break ;;
      -c?*) code=${1#-c}; have=c; shift; break ;;
      # -X options to the runtime (sys._xoptions, -X faulthandler; queue 220), -W options too (sys.warnoptions; queue 328)
      -X) xopts+="$2"$'\n'; shift 2 ;;
      -X*) xopts+="${1#-X}"$'\n'; shift ;;
      -W) wopts+="$2"$'\n'; shift 2 ;;
      -W*) wopts+="${1#-W}"$'\n'; shift ;;
      -) have=s; shift; break ;;
      --) shift; [ $# -gt 0 ] && { file=$1; have=f; shift; }; break ;;
      # -mMOD and -cCODE alone too (queue 574: test_quopri's [sys.executable, "-mquopri"])
      -[IEsSBubqOPRdvicm]*)
        local o=${1#-} rest pre
        # -i: interactive after the code, or the REPL on stdin when there is none (queue 289); -q: no banner then
        case ${o%%[cm]*} in *i*) inspect=1 ;; esac
        case ${o%%[cm]*} in *q*) quiet=1; sflags+=q ;; esac
        # -E and -I: sys.flags.ignore_environment, -I sys.flags.isolated too (PYI_START_FLAGS, queue 296)
        case ${o%%[cm]*} in *E*) sflags+=E ;; esac
        case ${o%%[cm]*} in *I*) sflags+=I ;; esac  # and no site hook before the REPL (queue 298)
        # -O (each), -v, -d, -B and -R (py-os-1124): sys.flags' optimize (the compiler's level), verbose, debug,
        # dont_write_bytecode and hash randomization under PYTHONHASHSEED=0
        local lv=${o%%[cm]*}; lv=${lv//[^OvdBR]/}; sflags+=$lv
        # -b, -bb: sys.flags.bytes_warning and the BytesWarning filter (PYI_BYTES_WARNING; queue 328)
        local bs=${o%%[cm]*}; bs=${bs//[^b]/}; bwarn=$((bwarn + ${#bs}))
        # -E and -I: the runtime's start ignores PYTHONFAULTHANDLER and PYTHONTRACEMALLOC (queue 220)
        case ${o%%[cm]*} in *[EI]*) noenv=1 ;; esac
        # -P and -I: safe_path, no script or working directory put first on sys.path (queue 250)
        case ${o%%[cm]*} in *[PI]*) safe=1 ;; esac
        # -u: the standard streams written through, write_through (PYI_UNBUFFERED; py-mods-1122)
        case ${o%%[cm]*} in *u*) unbuf=1 ;; esac
        # the first c or m ends the flags, the rest its argument (-Imcalendar: -m calendar)
        pre=${o%%[cm]*}
        case ${o:${#pre}:1} in
          c) rest=${o#"$pre"c}; if [ -n "$rest" ]; then code=$rest; shift; else code=$2; shift 2; fi; have=c; break ;;
          m) rest=${o#"$pre"m}; if [ -n "$rest" ]; then mod=$rest; shift; else mod=$2; shift 2; fi; have=m; break ;;
        esac
        shift ;;
      -*) echo "pyi python: unknown option $1" >&2; exit 2 ;;
      *) file=$1; have=f; shift; break ;;
    esac
  done
  local d src argv0 p
  # the directories of earlier runs whose interpreter has ended (each exec'd, below, so none removes its own); quietly:
  # another bin/pyi python may remove one between the test and the read (py-eval-1122: "cat: .../python.XXXXXX/pid: No
  # such file or directory" on a child's stderr failed test_sys's test_c_locale_surrogateescape)
  local pid
  for p in "$WORK"/python.*/pid; do
    pid=$(cat "$p" 2>/dev/null) || continue
    [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null && rm -rf "${p%/pid}" 2>/dev/null
  done
  d=$(mktemp -d "$WORK/python.XXXXXX")
  case $have in
    # -c: the code dedented as CPython 3.14's -c does (_PyUnicode_Dedent: the lines' common leading whitespace removed,
    # whitespace-only lines emptied; queue 230); the runtime runs the file __pyi_c.py as "<string>" with sys.path[0] ""
    # (queue 220)
    c) argv0=-c; src=$d/__pyi_c.py
       printf '%s\n' "$code" | awk '{ l[NR] = $0; if ($0 ~ /[^ \t]/) { match($0, /^[ \t]*/); p = substr($0, 1, RLENGTH)
           if (!set) { c = p; set = 1 } else { n = 0; while (n < length(c) && n < length(p) && substr(c, n+1, 1) == substr(p, n+1, 1)) n++; c = substr(c, 1, n) } } }
         END { for (i = 1; i <= NR; i++) { if (l[i] !~ /[^ \t]/) print ""; else print substr(l[i], length(c) + 1) } }' > "$src" ;;
    # -m: pymain_run_module, runpy._run_module_as_main(MOD, alter_argv=True) (queue 457: runpy's errors, "No module
    # named", "is a package and cannot be directly executed", "No code object available", a package's __main__ and a
    # .pyc module run as CPython's; pyi's loaders have get_code since PY6b), from a prologue that binds no name
    m) argv0=-m; src=$d/__pyi_m.py
       printf "__import__('runpy')._run_module_as_main(%s, True)\n" "$(pyi_pystr "$mod")" > "$src" ;;
    # no code, or - : pymain_run_stdin. Under -i or on a terminal (stdin_is_interactive, queue 313: CPython runs its REPL
    # on a terminal without -i too, review 307's finding 6) the REPL on stdin, run as an empty stdin module the REPL
    # follows; else stdin read to its end as the script. sys.argv [''], or ['-'] for -
    ""|s) src=$d/__pyi_stdin.py; argv0=""; [ "$have" = s ] && argv0=-
       if [ -n "$inspect" ] || [ -t 0 ]; then : > "$src"; stdinrepl=1
       else cat > "$src"; fi ;;
    # FILE (queue 457): pymain_run_python's main importer, a directory or a zip file that sys.path_hooks takes, put first on
    # sys.path (even under -P) and its __main__ run by runpy._run_module_as_main('__main__', False); a compiled file
    # (maybe_pyc_file: the .pyc suffix or the magic number's first two bytes) run as run_pyc_file runs it, its code
    # object marshalled after the 16 bytes of header, __loader__ a SourcelessFileLoader; else the script itself. A prologue
    # in the -m mode file (sys.path[0] the working directory, set to the path's by the prologue)
    f) case $file in /*) src=$file ;; *) src=$caller_pwd/$file ;; esac; argv0=$file
       local abs=$src
       # a path inside a zip file (py-os-1124, test_argparse's test_directory_in_zipfile: ARCHIVE.zip/package/subpackage)
       # is a main importer too, zipimport's path hook taking it
       local inzip="" zp=$src
       if [ ! -e "$src" ]; then
         while [ "$zp" != "${zp%/*}" ] && [ -n "${zp%/*}" ]; do
           zp=${zp%/*}
           if [ -e "$zp" ]; then { [ -f "$zp" ] && pyi_is_zip "$zp"; } && inzip=1; break; fi
         done
       fi
       if [ -d "$src" ] || [ -n "$inzip" ] || { [ -f "$src" ] && pyi_is_zip "$src"; }; then
         src=$d/__pyi_m.py
         printf "(lambda s, p: (s.path.insert(0, p) if s.flags.safe_path else s.path.__setitem__(0, p), __import__('runpy')._run_module_as_main('__main__', False)))(__import__('sys'), %s)\n" "$(pyi_pystr "$abs")" > "$src"
       elif [ -f "$src" ] && pyi_is_pyc "$src"; then
         local real; real=$(realpath "$src")
         src=$d/__pyi_m.py
         { printf '__pyi_pyc_args = (%s, %s)\n' "$(pyi_pystr "$abs")" "$(pyi_pystr "${real%/*}")"
           cat <<'PYI_PYC'
def __pyi_pyc(file, dir):
    import sys, marshal, importlib.util, importlib.machinery
    g = sys.modules["__main__"].__dict__
    del g["__pyi_pyc"], g["__pyi_pyc_args"]
    if sys.flags.safe_path:
        pass
    elif sys.path:
        sys.path[0] = dir
    with open(file, "rb") as f:
        data = f.read()
    if data[:4] != importlib.util.MAGIC_NUMBER:
        raise RuntimeError("Bad magic number in .pyc file")
    code = marshal.loads(data[16:])
    if not isinstance(code, type((lambda: 0).__code__)):
        raise RuntimeError("Bad code object in .pyc file")
    g["__file__"], g["__cached__"] = file, None
    g.setdefault("__package__", None)
    g.setdefault("__spec__", None)
    g["__loader__"] = importlib.machinery.SourcelessFileLoader("__main__", file)
    exec(code, g)
__pyi_pyc(*__pyi_pyc_args)
PYI_PYC
         } > "$src"
       elif [ -f "$src" ] && case $(pyi_pystr "$src") in *'\udc'*) true ;; *) false ;; esac; then
         # a script whose path is not UTF-8 (py-os-1124, test_cmd_line_script's test_non_ascii): the host reads files by
         # its strings, which lose such a byte, so a prologue reads and compiles it as run_file does, its path the
         # surrogate-escaped str (__file__, the code's filename, sys.path[0]'s directory)
         local real; real=$(realpath "$src")
         src=$d/__pyi_m.py
         { printf '__pyi_script_args = (%s, %s)\n' "$(pyi_pystr "$abs")" "$(pyi_pystr "${real%/*}")"
           cat <<'PYI_SCRIPT'
def __pyi_script(file, dir):
    import sys, importlib.machinery
    g = sys.modules["__main__"].__dict__
    del g["__pyi_script"], g["__pyi_script_args"]
    if not sys.flags.safe_path and sys.path:
        sys.path[0] = dir
    with open(file, "rb") as f:
        code = compile(f.read(), file, "exec")
    g["__file__"], g["__cached__"] = file, None
    g["__loader__"] = importlib.machinery.SourceFileLoader("__main__", file)
    exec(code, g)
__pyi_script(*__pyi_script_args)
PYI_SCRIPT
         } > "$src"
       fi ;;
  esac
  # pymain_run_file's message: the program's name and the file made absolute (config's run_filename)
  [ -f "$src" ] || { case $file in /*) ;; *) file=$caller_pwd/$file ;; esac
    printf "%s: can't open file %s: [Errno 2] No such file or directory\n" "${PYI_LAUNCHER_PY:-${PYI_EXECUTABLE:-$root/tools/pyi/python3}}" "$(pyi_pystr "$file")" >&2; rm -rf "$d"; exit 2; }
  local name dir rc=0
  src=$(cd "$(dirname "$src")" && pwd)/$(basename "$src")
  name=$(basename "$src"); dir=$(dirname "$src")
  local -a dump=()
  if [ "${PYI_READER:-native}" = helper ]; then
    echo "$name" > "$d/list"
    py pydump.py tree --full --base "$dir" --list "$d/list" --out "$d/dumps" --tsv "$d/tsv" >/dev/null
    dump=(--dump "$d/dumps/$name.ae")
  fi
  pyi_env
  # the interpreter exec'd in this process, so the pid the caller holds is the interpreter's: a test's kill of its child
  # (subprocess's timeout, Popen.kill) ends the run. Run as a child, the interpreter outlived the kill with parent 1
  # (test_subprocess's test_call_timeout, test_signal's SiginterruptTest; queue 200, round 7). $d goes with the next
  # bin/pyi python once this pid has ended.
  local lib; lib=$(stdlib_lib)
  echo $$ > "$d/pid"
  cd "$caller_pwd"
  # sys.argv's bytes (py-os-1124): the runtime decodes them with surrogateescape, as Py_DecodeLocale does
  local av="$argv0" a1; for a1 in "$@"; do av+=$'\x1f'"$a1"; done; export PYI_ARGV="$av"
  if [ -n "$xopts" ]; then export PYI_XOPTIONS="$xopts"; else unset PYI_XOPTIONS; fi
  if [ -n "$wopts" ]; then export PYI_WARNOPTIONS="$wopts"; else unset PYI_WARNOPTIONS; fi
  if [ "$bwarn" -gt 0 ]; then export PYI_BYTES_WARNING=$bwarn; else unset PYI_BYTES_WARNING; fi
  if [ -n "$noenv" ]; then export PYI_IGNORE_ENV=1; else unset PYI_IGNORE_ENV; fi
  if [ -n "$unbuf" ]; then export PYI_UNBUFFERED=1; else unset PYI_UNBUFFERED; fi
  export PYI_SAFE_PATH=$safe
  # descriptor 0 closed (queue 553: posix_spawn's POSIX_SPAWN_CLOSE 0, test_posix's test_close_file): Go's runtime opens
  # /dev/null on it at its start (runtime.checkfds), so the runtime closes it again (PYI_STDIN_CLOSED) before the program
  if { : 9<&0; } 2>/dev/null; then unset PYI_STDIN_CLOSED; else export PYI_STDIN_CLOSED=1; fi
  if [ -n "$sflags" ]; then export PYI_START_FLAGS=$sflags; else unset PYI_START_FLAGS; fi
  # the signal mask this shell was started with (py-mp-1125): Go's runtime unblocks SIGINT, SIGTERM and its other
  # signals on its threads before any of the program runs, and a SIGINT or SIGTERM pending then is the process's death by
  # Go's default action. So the runtime takes the mask from here (PYI_START_SIGBLK, builtins_signal_wait.go's init: those
  # signals blocked for the program and notified, one that arrives held, sigpending), with the ones already pending
  # (PYI_START_SIGPND: ShdPnd and SigPnd); a blocked SIGINT or SIGTERM is ignored from here to the exec, which discards
  # one pending (counted above) and keeps a later one from killing the runtime's start (the runtime reads an inherited
  # SIG_IGN of SIGHUP alone; its notify replaces this one). resource_tracker's parent blocks SIGINT and SIGTERM around its
  # spawn, and the test's SIGINT or SIGTERM, sent while this child starts, must be held until its main ignores it.
  unset PYI_START_SIGBLK PYI_START_SIGPND
  local sigblk="" sigpnd=0 l v
  while read -r l v; do
    case $l in SigBlk:) sigblk=$v ;; ShdPnd:|SigPnd:) case $v in *[!0-9a-fA-F]*|"") ;; *) sigpnd=$(( sigpnd | 16#$v )) ;; esac ;; esac
  done < "/proc/$$/status" 2>/dev/null || true
  case $sigblk in ""|*[!0-9a-fA-F]*|0000000000000000) ;; *)
    export PYI_START_SIGBLK=$sigblk
    sigpnd=$(( sigpnd & 16#$sigblk ))
    [ "$sigpnd" = 0 ] || export PYI_START_SIGPND=$(printf '%x' "$sigpnd")
    if (( 16#$sigblk & 0x2 )); then trap '' INT; fi
    if (( 16#$sigblk & 0x4000 )); then trap '' TERM; fi ;;
  esac
  # -i (queue 289): the runtime's REPL after the main module (PYI_INSPECT=1), or as the run (repl, repl-quiet: -q); on a
  # terminal without -i the REPL as the run with sys.flags' inspect and interactive 0 (tty, tty-quiet; queue 313)
  if [ -n "$stdinrepl" ] && [ -n "$inspect" ]; then export PYI_INSPECT=repl${quiet:+-quiet}
  elif [ -n "$stdinrepl" ]; then export PYI_INSPECT=tty${quiet:+-quiet}
  elif [ -n "$inspect" ]; then export PYI_INSPECT=1
  else unset PYI_INSPECT; fi
  # the compiled launcher (queue 284; its wrapper WORK/aot/bin/python3 sets PYI_LAUNCHER, launcher_py): the program run by
  # tools/pyi/launcher.py's executable, PYI_AOT_MAIN naming it (AotMain compiles its source at run time), sys.executable
  # the wrapper, so the child's children start compiled too; no executable (a runtime change since): pyi on goi
  if [ -n "${PYI_LAUNCHER:-}" ] && [ -x "$PYI_LAUNCHER" ]; then
    export PYI_EXECUTABLE="$PYI_LAUNCHER_PY" PYI_AOT_COMPILER="$PYI_LAUNCHER_COMPILER" PYI_AOT_MAIN="$src"
    exec "$PYI_LAUNCHER" "$argv0" "$@"
  fi
  ARBACE_PATH="$root:$root/x509roots" GOGC=$(pyi_gogc) GOMEMLIMIT=${PYI_GOMEMLIMIT:-$("$root/bin/gate-policy" mem 3GiB)} GOMAXPROCS=${PYI_THREADS:-4} \
    exec "$(arbace_exe)" -m arbace.python run ${dump[@]+"${dump[@]}"} --file "$src" --lib "$lib" ${site_args[@]+"${site_args[@]}"} --argv0 "$argv0" -- "$@"
}

# in_group CMD...: CMD in a session and process group of its own (setsid), waited for, then the whole group killed: a
# test's child that outlives its module's run (a timeout's, or one the test's own kill missed) does not run on with
# parent 1 (queue 200, round 7)
in_group() {
  local pid rc=0
  setsid "$@" & pid=$!
  wait "$pid" || rc=$?
  kill -KILL -- "-$pid" 2>/dev/null || true
  return $rc
}

# lib-test [--oracle] [--record] [--judge DIR] [MODULE...]: Lib/test's language-core modules (corpora.edn) run by pyi
# through test/python/libtest.py (unittest's loader, each test's outcome), judged per test method by
# test/python/libtest_judge.ae against 177's references (test/python/ref-cpython314-lib-test.edn): equal outcomes pass;
# a method that is not equal passes only in a class test/python/lib-test-known.edn names it with; anything else fails.
# --record: the known file's methods of the modules run written again (a method's class kept, else the first class
# whose :match finds its line; one of no class printed and left out, the run exits 3). --judge DIR: the runs in DIR
# judged again, nothing run. --oracle runs the driver by python3 instead, judged with no class (the judge's control:
# every method equal but the references' :excluded). PYI_LIB_TEST_JOBS modules at once (default 1),
# PYI_LIB_TEST_TIMEOUT seconds a module (default 1800; 5400 for test_queue, whose *_in_many_threads tests pass 65,536 items
# each, test_subprocess, test_socket and test_os, whose children are pyi runs, and test_pickle, 994 methods).
# pyi's runs skip the tests of test/python/lib-test-skip.tsv (PYI_LIB_TEST_SKIP; ID<TAB>REASON, each an error naming
# the reason, which the known file classes): those that would wait forever on what pyi cannot do yet
cmd_lib_test() {
  local oracle="" record="" judge="" aot="" corpus="" verdict="" mods=() m d="$WORK/lib-test" lib rc=0
  while [ $# -gt 0 ]; do case $1 in --oracle) oracle=1; shift ;; --record) record=1; shift ;; --aot) aot=1; shift ;;
    --corpus) corpus=$2; shift 2 ;; --judge) judge=$2; shift 2 ;; --verdict) verdict=$2; shift 2 ;; *) mods+=("$1"); shift ;; esac; done
  verdict=${verdict:-$(judge_verdict "$oracle")}
  [ -n "$oracle$aot$judge" ] || runtime_guard "lib-test" "$record"
  if [ ${#mods[@]} -eq 0 ]; then
    if [ -n "$corpus" ]; then IFS=, read -ra mods <<< "$(corpus_modules "$corpus")"; else IFS=, read -ra mods <<< "$(core_modules)"; fi
  fi
  # the references: the language core's and every other lib-test corpus's (ref-cpython314-lib-test-*.edn), one file
  local refs="$WORK/lib-test-refs.edn"; cat "$REF_LT" "$root"/test/python/ref-cpython$RECV-lib-test-*.edn > "$refs" 2>/dev/null || true
  # --aot: the driver compiled once (its imports ahead), each module's tests then on the loop of that executable
  local drv=""
  if [ -n "$aot" ] && [ -z "$judge" ] && [ -z "$oracle" ]; then
    aot_module; drv="$AOT/bin/p_libtest"; aot_compile p_libtest "$root/test/python/libtest.py" "$drv"
    [ -f "$drv.refused" ] && die "lib-test --aot: the driver is refused: $(cat "$drv.refused")"
  fi
  if [ -n "$judge" ]; then
    d=$(cd "$caller_pwd" && cd "$judge" && pwd); rm -f "$d/summary.tsv"
  else
    lib=$(stdlib_lib); rm -rf "$d"; mkdir -p "$d"
    # PYI_LIB_TEST_JOBS modules at once (default 1; each pyi run takes up to a few GB)
    local jobs=${PYI_LIB_TEST_JOBS:-1} running=0
    for m in "${mods[@]}"; do
      if [ "$running" -ge "$jobs" ]; then wait -n || true; running=$((running - 1)); fi
      (
        if [ -n "$oracle" ]; then
          (cd "$d" && in_group timeout 900 env PYTHONHASHSEED=0 LC_ALL=C.UTF-8 TZ=UTC PYTHONIOENCODING=utf-8 HOME="$WORK" TMPDIR="$WORK" PYTHONPATH="$lib" \
            python3 -s -P -B "$root/test/python/libtest.py" "$m" > "$d/$m.out" 2> "$d/$m.err"; echo $? > "$d/$m.status") || true
        else
          local tmo=1800; case $m in test_queue|test_subprocess|test_socket|test_os|test_pickle) tmo=5400 ;; esac
          if [ -n "$drv" ]; then
            (cd "$d" && PYI_LIB_TEST_SKIP="${PYI_LIB_TEST_SKIP-$root/test/python/lib-test-skip.tsv}" \
              in_group timeout "${PYI_LIB_TEST_TIMEOUT:-$tmo}" env PYI_AOT_COMPILER="$AOT/compiler.sh" "$drv" "$root/test/python/libtest.py" "$m" > "$d/$m.out" 2> "$d/$m.err"; echo $? > "$d/$m.status") || true
          else
            (cd "$d" && PYI_LIB_TEST_SKIP="${PYI_LIB_TEST_SKIP-$root/test/python/lib-test-skip.tsv}" \
              in_group timeout "${PYI_LIB_TEST_TIMEOUT:-$tmo}" "$root/bin/pyi" run "$root/test/python/libtest.py" "$m" > "$d/$m.out" 2> "$d/$m.err"; echo $? > "$d/$m.status") || true
          fi
        fi
        echo "lib-test: $m run"
      ) &
      running=$((running + 1))
    done
    wait
  fi
  local m2c="$d/modules.tsv"; [ -n "$judge" ] && [ -f "$m2c" ] || module_corpora "${mods[@]}" > "$m2c"
  "$(arbace_exe)" "$root/test/python/libtest_judge.ae" --dir "$d" --ref "$refs" --modules "$m2c" --verdict "$verdict" \
    $(if [ -n "$oracle" ]; then echo --no-classes; else echo --classes "$DIV" --record "$CHECK_RECORD"; fi) ${record:+--write-record} || rc=$?
  return $rc
}

# pyi's AOT (PY8; doc/python/PYTHON-SURVEY.md §7, PYS13 (a); PYI-SPEC.md §10): the IR translated to Go forms by
# arbace.python.aot (on the tools' host), printed by repr/go (bin/build-go --print-only) and built with TamaGo's go over
# go/arbace/py as printed by runtime print (the light tier, as bin/si's AOT: not Arbace's executable), one small
# executable per program; its modules' packages printed once, kept by their IR's hash (AOT/pkgs-GEN, GEN the
# generator's digest), so the stdlib's modules are compiled once for every program
AOT="$WORK/aot"
aot_go() {
  (cd "$AOT/mod" && env GOROOT="${ARBACE_GOROOT:-/root/tamago-go}" GOTOOLCHAIN=local GOFLAGS= GOWORK=off GO111MODULE=on \
     GOPROXY=off CGO_ENABLED=0 GOCACHE="${PYI_AOT_GOCACHE:-$(aot_shared)/gocache}" GOMAXPROCS=${GOMAXPROCS:-4} \
     "${ARBACE_GOROOT:-/root/tamago-go}/bin/go" "$@")
}
# aot_shared: what pyi's AOT keeps across worktrees (R4, queue 201: a cold check --aot paid once per runtime, not in
# every worktree): the compiled modules' printed packages (pkgs-GEN, by the generator's digest and each module's IR hash)
# and Go's build cache, under the main checkout's .tmp/repr-python/pyi/aot-shared (PYI_AOT_SHARED another; =$AOT: the
# worktree's own); the runtime's module, the programs and their logs stay the worktree's ($AOT)
aot_shared() {
  local d=${PYI_AOT_SHARED:-}
  if [ -z "$d" ]; then
    local main; main=$(cd "$root" && cd "$(git rev-parse --git-common-dir 2>/dev/null || echo .git)/.." 2>/dev/null && pwd) || main=$root
    d="$main/.tmp/repr-python/pyi/aot-shared"
  fi
  mkdir -p "$d"; echo "$d"
}
# (queue 329: PYI_AOT_BINARY_IR=0, the packages' IR as text, is a generator of its own)
aot_gen() { { cat "$root/arbace/python/aot.ae"; [ "${PYI_AOT_BINARY_IR:-}" != 0 ] || echo "PYI_AOT_BINARY_IR=0"; } | sha256sum | cut -c1-16; }
# aot_module: the module the compiled programs build in: the runtime (go/arbace/py, go/arbace/libm and go/arbace/expat printed,
# kept by their forms' digest), the packages of arbace/pyaot. Its rebuild one at a time (queue 481, 475-3 (a); as
# 9f322d9a4's cirun-build): two pyi runs of one checkout that both see a stale key no longer rebuild it at once (one's
# rm -rf took the other's files: "cf2g's Main not found"); the run that waited finds the key the checkout's and keeps the
# build. The lock is AOT/mod.lock, taken only when the key is stale (a fresh module is read under no lock).
# For test/python/aot-lock-test.bash: PYI_AOT_MODULE_HOLD=S holds the lock S seconds after the rebuild, and
# PYI_AOT_MODULE_LOCK=0 takes none (its negative control: such a run rebuilds while another holds the lock).
aot_module() {
  mkdir -p "$AOT/mod/pyaot"
  printf 'module arbace\n\ngo 1.27\n' > "$AOT/mod/go.mod"
  local key; key=$( (cd "$root" && find go/arbace/py.ae go/arbace/py go/arbace/libm.ae go/arbace/libm go/arbace/expat.ae go/arbace/expat go/arbace/pyexpat.ae go/arbace/pyexpat \
                       go/arbace/ci.ae go/arbace/ci go/arbace/crt.ae go/arbace/crt go/arbace/clib.ae go/arbace/clib go/arbace/pybz2.ae go/arbace/pybz2 go/arbace/pylzma.ae go/arbace/pylzma go/arbace/pyzstd.ae go/arbace/pyzstd go/arbace/pysqlite3.ae go/arbace/pysqlite3 go/arbace/pyctypes.ae go/arbace/pyctypes go/arbace/pyssl.ae go/arbace/pyssl go/arbace/pytls.ae go/arbace/pytls x509roots/go bin/pyi-clib tools/pyi/clib/aot_text.ae -type f | LC_ALL=C sort | xargs sha256sum) | sha256sum | cut -c1-16)
  if [ "$(cat "$AOT/mod/runtime.key" 2>/dev/null)" != "$key" ]; then
    local lk; exec {lk}>"$AOT/mod.lock"; [ "${PYI_AOT_MODULE_LOCK:-1}" = 0 ] || flock "$lk"
    if [ "$(cat "$AOT/mod/runtime.key" 2>/dev/null)" != "$key" ]; then
      echo "pyi: rebuilding the AOT module (runtime key $key)" >&2
      aot_module_rebuild "$key"
      echo "pyi: the AOT module rebuilt (runtime key $key)" >&2
    fi
    [ -z "${PYI_AOT_MODULE_HOLD:-}" ] || sleep "$PYI_AOT_MODULE_HOLD"
    flock -u "$lk"; exec {lk}>&-
  fi
  aot_compiler_sh "$key"
}
# aot_module_rebuild KEY: the module's runtime printed and copied, the C libraries compiled by cf2g, KEY written last
# (under aot_module's lock)
aot_module_rebuild() {
  local key=$1
  {
    # queue 321: the key goes first, so a rebuild cut short (killed) is not taken for done by the next run
    rm -f "$AOT/mod/runtime.key"
    runtime_print "$AOT/rt"
    rm -rf "$AOT/mod/py" "$AOT/mod/libm" "$AOT/mod/expat" "$AOT/mod/pyexpat" "$AOT/mod/pyssl" "$AOT/mod/x509roots"
    mkdir -p "$AOT/mod/py" "$AOT/mod/libm" "$AOT/mod/expat" "$AOT/mod/pyexpat" "$AOT/mod/pyssl" "$AOT/mod/x509roots/fallback/bundle"
    local f
    for f in "$AOT/rt"/py/*.go; do case $f in *_test.go) ;; *) cp "$f" "$AOT/mod/py/" ;; esac; done
    for f in "$AOT/rt"/libm/*.go; do case $f in *_test.go) ;; *) cp "$f" "$AOT/mod/libm/" ;; esac; done
    for f in "$AOT/rt"/expat/*.go; do case $f in *_test.go) ;; *) cp "$f" "$AOT/mod/expat/" ;; esac; done
    for f in "$AOT/rt"/pyexpat/*.go; do case $f in *_test.go) ;; *) cp "$f" "$AOT/mod/pyexpat/" ;; esac; done
    # queue 208: ci's back end, the C library host, bzip2's node program and _bz2's glue, and the library compiled by
    # cf2g (bin/pyi-clib aot: arbace/clib/bzip2/aot, its init registering the compiled functions); liblzma's and
    # _lzma's likewise, and zstd's and _zstd's, SQLite's and _sqlite3's (queue 215)
    local p keep="$AOT/clib-aot-keep"
    # py-core-1124: the libraries' cf2g translations set aside and put back (bin/pyi-clib aot keeps one whose key, the node
    # program's and the translator's digest, is current: a runtime change no longer translates the five libraries again)
    rm -rf "$keep"; mkdir -p "$keep"
    for p in bzip2 xz zstd sqlite ctypestest; do [ ! -d "$AOT/mod/clib/$p/aot" ] || mv "$AOT/mod/clib/$p/aot" "$keep/$p"; done
    # queue 244: ctypes's world (clib/ctypestest, compiled by cf2g too) and _ctypes's package (pyctypes)
    for p in ci crt clib clib/bzip2 clib/xz clib/zstd clib/sqlite clib/ctypestest pybz2 pylzma pyzstd pysqlite3 pyctypes; do
      rm -rf "$AOT/mod/$p"; mkdir -p "$AOT/mod/$p"
      for f in "$AOT/rt/$p"/*.go; do case $f in *_test.go) ;; *) cp "$f" "$AOT/mod/$p/" ;; esac; done
    done
    for p in bzip2 xz zstd sqlite ctypestest; do
      [ ! -d "$keep/$p" ] || { rm -rf "$AOT/mod/clib/$p/aot"; mv "$keep/$p" "$AOT/mod/clib/$p/aot"; }
      "$root/bin/pyi-clib" aot "$p" "$AOT/mod/clib/$p/aot" || die "bin/pyi-clib aot $p failed"
    done
    rm -rf "$keep"
    for f in "$AOT/rt"/pyssl/*.go; do case $f in *_test.go) ;; *) cp "$f" "$AOT/mod/pyssl/" ;; esac; done
    # queue 552: the vendored crypto/tls's packages
    rm -rf "$AOT/mod/pytls"
    for p in $(pytls_pkgs); do
      mkdir -p "$AOT/mod/$p"
      for f in "$AOT/rt/$p"/*.go; do case $f in *_test.go) ;; *) cp "$f" "$AOT/mod/$p/" ;; esac; done
    done
    for f in "$AOT/rt"/x509roots/fallback/bundle/*; do case $f in *_test.go) ;; *) cp "$f" "$AOT/mod/x509roots/fallback/bundle/" ;; esac; done
    echo "$key" > "$AOT/mod/runtime.key"
  }
}
# aot_compiler_sh KEY: AOT/compiler.sh
aot_compiler_sh() {
  local key=$1
  # the host's compiler for what a compiled program compiles at run time (arbace.python.aot compile-server); its IR
  # cache and compiler digest on the "# ir-cache:" line, read by the compiled program first (aot.go's irCacheRead, 202b);
  # the runtime's key on the "# ir-bin:" line, the stamp of the binary IR the compiled programs keep beside the cache's
  # answers (queue 329: a sidecar another runtime wrote is written again)
  cat > "$AOT/compiler.sh" <<SH
#!/bin/sh
# ir-cache: $WORK/ir-cache $(compiler_digest)
# ir-bin: $key
exec env ARBACE_PATH="$root" PYI_ROOT="$root" PYI_WORK="$WORK" PYI_RUN_ID="aot\$\$" GOMEMLIMIT=\${PYI_GOMEMLIMIT:-3GiB} \
  GOMAXPROCS=\${PYI_THREADS:-4} "$(arbace_exe)" -m arbace.python.aot compile-server
SH
  chmod +x "$AOT/compiler.sh"
}
# compiler_digest: arbace.python.run's compiler-digest (the key of its IR cache), the SHA-256 of each compiler source's
# name and text, NUL-terminated: compile, ir, scope, run and libpatch (queue 535), then arbace/repr/python's namespaces in name order
compiler_digest() {
  local f
  # under REPR_PYTHON_VERSION=3.15 the reader's version first (queue 237; arbace.python.run's compiler-digest)
  { [ "${REPR_PYTHON_VERSION:-}" != 3.15 ] || printf 'REPR_PYTHON_VERSION=3.15\0'
    for f in arbace/python/compile.ae arbace/python/ir.ae arbace/python/scope.ae arbace/python/run.ae arbace/python/libpatch.ae \
             $(cd "$root" && ls arbace/repr/python/*.ae | LC_ALL=C sort); do
      [ -f "$root/$f" ] || continue
      printf '%s\0' "$f"; cat "$root/$f"; printf '\0'
    done; } | sha256sum | cut -c1-64
}
# aot_compile PKG FILE OUT: FILE compiled into the executable OUT; on a refusal OUT.refused holds the reason, on a
# compile-time error of the program OUT.cout, .cerr, .crc its outcome (CPython's: the SyntaxError, status 1)
aot_compile() {
  local pkg=$1 file=$2 out=$3 gen; gen=$(aot_gen)
  local src="$AOT/src/$pkg" w="$AOT/print/$pkg" log="$AOT/log/$pkg" cache="$(aot_shared)/pkgs-$gen"
  mkdir -p "$AOT/log" "$cache" "$(dirname "$out")"
  # the module's packages are the generator's: another generator's (named by the same IR hash) are dropped first
  if [ "$(cat "$AOT/mod/pyaot.gen" 2>/dev/null)" != "$gen" ]; then
    rm -rf "$AOT"/mod/pyaot/m*; echo "$gen" > "$AOT/mod/pyaot.gen"
  fi
  rm -rf "$src" "$w" "$AOT/mod/pyaot/$pkg" "$out" "$out".{refused,cout,cerr,crc}
  local rc=0
  pyi_env
  ARBACE_PATH="$root" GOMEMLIMIT=${PYI_GOMEMLIMIT:-$("$root/bin/gate-policy" mem 3GiB)} GOMAXPROCS=${PYI_THREADS:-4} \
    "$(arbace_exe)" -m arbace.python.aot program "$file" "$src" "$pkg" "$(stdlib_lib)" "$cache" > "$log.compile" 2>&1 || rc=$?
  if [ $rc = 4 ]; then
    local e; e=$(sed -n 's/^error //p' "$log.compile" | head -1)
    case $e in
      SyntaxError:*) : > "$out.cout"; echo "${e%%$'\x00'*}" > "$out.cerr"; echo 1 > "$out.crc"; return 0 ;;
    esac
    echo "the compiler refuses it: $e" > "$out.refused"; return 0
  elif [ $rc != 0 ]; then
    echo "arbace.python.aot fails: $(grep -m1 'rror\|xception' "$log.compile" || tail -1 "$log.compile")" > "$out.refused"; return 0
  fi
  if [ -d "$src/go" ] && ! "$root/bin/build-go" --print-only --module arbace --layout lines --work "$w" "$src" > "$log.print" 2>&1; then
    echo "repr/go does not print it: $(tail -1 "$log.print")" > "$out.refused"; return 0
  fi
  local nm st
  while read -r nm st; do
    # into the shared cache through a name of its own, then renamed (another worktree may write the same package:
    # its content is the same, keyed by the IR's hash)
    if [ "$st" = new ] || [ ! -d "$cache/$nm" ]; then
      rm -rf "$cache/.$nm.$$"; cp -r "$w/mod/pyaot/$nm" "$cache/.$nm.$$"
      rm -rf "$cache/$nm.old.$$"; [ ! -d "$cache/$nm" ] || mv "$cache/$nm" "$cache/$nm.old.$$" 2>/dev/null || true
      mv "$cache/.$nm.$$" "$cache/$nm" 2>/dev/null || rm -rf "$cache/.$nm.$$"; rm -rf "$cache/$nm.old.$$"
    fi
    # through a name of its own (queue 279: check --aot --lib-test compiles drivers in parallel in one module)
    if [ ! -d "$AOT/mod/pyaot/$nm" ]; then
      rm -rf "$AOT/mod/pyaot/.$nm.$$"; cp -r "$cache/$nm" "$AOT/mod/pyaot/.$nm.$$"
      mv -T "$AOT/mod/pyaot/.$nm.$$" "$AOT/mod/pyaot/$nm" 2>/dev/null || rm -rf "$AOT/mod/pyaot/.$nm.$$"
    fi
  done < <(awk '$1 == "module" && $4 != "-" {print $4, $5} $1 == "main" {print $2, $3}' "$log.compile")
  mkdir -p "$AOT/mod/pyaot/$pkg"; cp -r "$w/mod/pyaot/$pkg/prog" "$AOT/mod/pyaot/$pkg/"
  rm -rf "$src" "$w"
  if ! aot_go build -p 2 -trimpath ${PYI_AOT_GOFLAGS:-} -o "$out" "./pyaot/$pkg/prog" > "$log.build" 2>&1; then
    echo "go build fails: $(grep -m1 . "$log.build")" > "$out.refused"; return 0
  fi
}
# aot_run OUT ARGS...: the compiled program run as bin/pyi run runs pyi (its compile-time outcome when it has one)
aot_run() {
  local out=$1; shift
  if [ -f "$out.crc" ]; then cat "$out.cout"; cat "$out.cerr" >&2; return "$(cat "$out.crc")"; fi
  PYI_AOT_COMPILER="$AOT/compiler.sh" "$out" "$@"
}

# check --aot: the synthetic corpus and the samples (177's references, test/python/ref-cpython314.edn) compiled and run,
# each judged against CPython's reference (status, stdout's SHA-256, stderr's last line) and against the same program on
# the loop (PYI_AOT_LOOP: the same executable, every code object on the dispatch loop) and pyi's run (bin/pyi run, on
# goi; kept by the runtime's, the compiler's and the program's digest); see cmd_check_aot
aot_list() {
  { sed 's|^|synth/|' "$SYNTH/MANIFEST"; (cd "$root/test/python/samples" && ls *.py | sed 's|^|samples/|'); }
}
aot_file() { case $1 in synth/*) echo "$SYNTH/${1#synth/}" ;; samples/*) echo "$root/test/python/samples/${1#samples/}" ;; esac; }
# run_one DIR NAME CMD...: CMD in a fresh directory as refs.py runs the oracle (an empty stdin, HOME and TMPDIR inside
# WORK, the fixed environment, 120 s): DIR/NAME.out, .err, .rc, .time
run_one() {
  local d=$1 nm=$2; shift 2
  local cwd="$d/$nm.cwd"; rm -rf "$cwd"; mkdir -p "$cwd" "$WORK/home" "$WORK/tmp"
  local t0 t1 rc=0
  t0=$(date +%s%N)
  (cd "$cwd" && timeout "${PYI_AOT_TIMEOUT:-120}" env -i PATH=/usr/bin:/bin HOME="$WORK/home" TMPDIR="$WORK/tmp" PYTHONHASHSEED=0 \
     LC_ALL=C.UTF-8 TZ=UTC PYTHONIOENCODING=utf-8 PYTHONDONTWRITEBYTECODE=1 ARBACE_HOST_EXE="${ARBACE_HOST_EXE:-}" \
     ${PYI_AOT_LOOP:+PYI_AOT_LOOP=1} PYI_AOT_COMPILER="$AOT/compiler.sh" PYI_AOT_STATS="$d/$nm.stats" \
     "$@" < /dev/null > "$d/$nm.out" 2> "$d/$nm.err") || rc=$?
  t1=$(date +%s%N)
  [ $rc = 124 ] && rc=timeout
  echo "$rc" > "$d/$nm.rc"; echo $(( (t1 - t0) / 1000000 )) > "$d/$nm.time"
  rm -rf "$cwd"
}
# outcome DIR NAME: "STATUS SHA256 STDERR-LAST" of a run (the reference's fields)
outcome() {
  printf '%s\t%s\t%s\n' "$(cat "$1/$2.rc")" "$(sha256sum < "$1/$2.out" | cut -c1-64)" "$(grep -v '^[[:space:]]*$' "$1/$2.err" | tail -1)"
}
pyi_key() {
  { (cd "$root" && find go/arbace/py.ae go/arbace/py go/arbace/libm.ae go/arbace/libm go/arbace/expat.ae go/arbace/expat go/arbace/pyexpat.ae go/arbace/pyexpat arbace/python arbace/python.ae \
       go/arbace/clib.ae go/arbace/clib go/arbace/pybz2.ae go/arbace/pybz2 go/arbace/pylzma.ae go/arbace/pylzma go/arbace/pyzstd.ae go/arbace/pyzstd go/arbace/pysqlite3.ae go/arbace/pysqlite3 \
       go/arbace/pyctypes.ae go/arbace/pyctypes \
       arbace/repr/python tools/pydump/pydump.py -type f | LC_ALL=C sort | xargs sha256sum); sha256sum < "$1"
    # queue 321: and the runtime that runs (runtime_state: a stale executable's runs are not the checkout's runtime's)
    echo "${2:-}"; } | sha256sum | cut -c1-24
}

cmd_check_aot() {
  # --lib-test (queue 279): Lib/test's modules, each compiled ahead with its driver (cmd_check_lib --aot)
  if [ "${1:-}" = --lib-test ]; then shift; cmd_check_lib --aot "$@"; return; fi
  local record="" pyi=1 ids=() id judge=""
  while [ $# -gt 0 ]; do case $1 in --record) record=1; shift ;; --no-pyi) pyi=""; shift ;; --only) ids+=("$2"); shift 2 ;;
    --judge) judge=$AOT/check; if [ $# -gt 1 ] && [ "${2#--}" = "$2" ]; then judge=$(cd "$caller_pwd" && cd "$2" && pwd) || die "check --aot --judge: no directory $2"; shift; fi; shift ;;
    --only-list) local lst n0=${#ids[@]}; lst=$(cd "$caller_pwd" && realpath -e "$2" 2>/dev/null) || die "check --aot: no list $2"
                 mapfile -t -O "${#ids[@]}" ids < <(grep -v '^[[:space:]]*\(#\|$\)' "$lst" | sed 's/[[:space:]]*$//')
                 [ ${#ids[@]} -gt "$n0" ] || die "check --aot: no id in $2"; shift 2 ;;
    *) die "check --aot: unknown $1" ;; esac; done
  if [ -n "$judge" ]; then
    [ ${#ids[@]} = 0 ] && [ -n "$pyi" ] || die "check --aot --judge: the run's own programs, no --only, --only-list or --no-pyi"
    aot_judge "$judge" "$record"; return
  fi
  [ ${#ids[@]} -gt 0 ] || mapfile -t ids < <(aot_list)
  local rstate=""; if [ -n "$pyi" ]; then runtime_guard "check --aot (pyi's runs)" "$record"; rstate=$(runtime_state); fi
  aot_module
  local d="$AOT/check" pc="$AOT/pyi-runs"; mkdir -p "$d" "$pc"
  : > "$d/runs.tsv"
  for id in "${ids[@]}"; do
    local f nm pkg exe t0 ct
    f=$(aot_file "$id"); [ -f "$f" ] || die "no program $id"
    nm=${id//\//__}; pkg=p_$(echo "$nm" | tr -c 'A-Za-z0-9\n' '_'); exe="$AOT/bin/$pkg"
    t0=$(date +%s%N); aot_compile "$pkg" "$f" "$exe"; ct=$(( ($(date +%s%N) - t0) / 1000000 ))
    rm -f "$d/$nm".*
    if [ -f "$exe.refused" ]; then
      printf '%s\trefused\t%s\t%s\n' "$id" "$ct" "$(cat "$exe.refused")" >> "$d/runs.tsv"; echo "  $id: refused: $(cat "$exe.refused")"; continue
    fi
    if [ -f "$exe.crc" ]; then
      cp "$exe.cout" "$d/$nm.aot.out"; cp "$exe.cerr" "$d/$nm.aot.err"; cp "$exe.crc" "$d/$nm.aot.rc"; echo 0 > "$d/$nm.aot.time"
      cp "$exe.cout" "$d/$nm.loop.out"; cp "$exe.cerr" "$d/$nm.loop.err"; cp "$exe.crc" "$d/$nm.loop.rc"; echo 0 > "$d/$nm.loop.time"
    else
      run_one "$d" "$nm.aot" "$exe" "$f"
      PYI_AOT_LOOP=1 run_one "$d" "$nm.loop" "$exe" "$f"
    fi
    local pk="" pyo=$'-\t-\t-'
    if [ -n "$pyi" ]; then
      pk=$(pyi_key "$f" "$rstate")
      if [ ! -f "$pc/$pk.rc" ]; then run_one "$pc" "$pk" "$root/bin/pyi" run "$f"; fi
      pyo=$(outcome "$pc" "$pk")
    fi
    printf '%s\tran\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$ct" "$(outcome "$d" "$nm.aot")" "$(outcome "$d" "$nm.loop")" "$pyo" \
      "$(cat "$d/$nm.aot.time")" "$(cat "$d/$nm.loop.time")" "$(cat "$pc/$pk.time" 2>/dev/null || echo -)" >> "$d/runs.tsv"
    [ -f "$d/$nm.aot.stats" ] && sed "s|^|$id\t|" "$d/$nm.aot.stats" >> "$d/stats.tsv"
    rm -f "$exe"
    echo "  $id: compiled $(cat "$d/$nm.aot.rc"), loop $(cat "$d/$nm.loop.rc")${pk:+, pyi $(cat "$pc/$pk.rc")}"
  done
  aot_cache_trim
  aot_judge "$d" "$record"
}
# aot_judge DIR [RECORD] (queue 353, 347's DECISION 2 (a), the user 2026-11-18): DIR/runs.tsv judged (arbace.python.aot judge:
# CPython's references, the golden texts, test/python/divergences-aot.edn) into DIR/results.edn, and with RECORD into
# test/python/check-aot-linux-ARCH.edn (PYI_CHECK_AOT_RECORD another). check --aot's last step, and check --aot --judge
# [DIR] alone: a kept run judged again after a class changed, nothing compiled or run (as check --judge RUN for Lib/test).
# A re-judge's record of a run that lacks programs of aot_list (an --only run's) is refused into the committed record
aot_judge() {
  local d=$1 record=${2:-} arch rec
  [ -s "$d/runs.tsv" ] || die "check --aot --judge: no runs in $d (runs.tsv: bin/pyi check --aot first)"
  case $(uname -m) in x86_64) arch=amd64 ;; aarch64) arch=arm64 ;; *) arch=$(uname -m) ;; esac
  rec="${PYI_CHECK_AOT_RECORD:-$root/test/python/check-aot-linux-$arch.edn}"
  if [ -n "$record" ] && [ -z "${PYI_CHECK_AOT_RECORD:-}" ]; then
    # grep -v exits 1 when it keeps no line (every program ran): under pipefail and set -e that ended the script silently
    local miss; miss=$(aot_list | { grep -vxF -f <(cut -f1 "$d/runs.tsv") || true; } | wc -l)
    [ "$miss" = 0 ] || die "check --aot: $d's runs lack $miss of the $(aot_list | wc -l) programs: --record into ${rec#$root/} refused (PYI_CHECK_AOT_RECORD: a scratch record)"
  fi
  pa_arbace_aot judge --runs "$d/runs.tsv" --ref "$REF" --classes "$root/test/python/divergences-aot$RECS.edn" --golden "$GOLDEN" \
    --results "$d/results.edn" ${record:+--record "$rec"}
}
# golden: the programs' own verdict (queue 247): test/python/golden's reviews against their texts (every line in one entry, the digest of the
# reviewed text) and against CPython's recorded runs (ref-cpython314.edn), with a negative control; seconds, no CPython, no build
cmd_golden() {
  [ $# = 0 ] || die "golden: no arguments"
  local rc=0 id model args n=0 first="" second=""
  pa_arbace_aot golden --dir "$GOLDEN" --root "$root/test/python" --ref "$REF" || rc=1
  # the programs that also have a model (models/models.tsv: ID, an awk script, its awk arguments): the model's output must equal the golden
  # text; the negative control runs one program's model against another program's golden text, which must differ. An .ae model (ID, the
  # script, its argument: models/ops.ae, the 24 arithmetic and bitwise tables, the user's decision of 2026-11-21) runs once on stage 0
  # over all its programs: each table against its golden text, each program's negative control (a changed rule) differing
  local -A ae_args=()
  while IFS=$'\t' read -r id model args; do
    [ -n "$id" ] || continue
    n=$((n + 1))
    case $model in *.ae) ae_args[$model]+=" $args"; continue ;; esac
    # shellcheck disable=SC2086
    if awk $args -f "$GOLDEN/models/$model" | cmp -s - "$GOLDEN/${id%.py}.out"; then :; else echo "  FAIL $id: model $model differs from the golden text"; rc=1; fi
    if [ -z "$first" ]; then first="$id|$model|$args"; elif [ -z "$second" ]; then second="$id"; fi
  done < "$GOLDEN/models/models.tsv"
  IFS='|' read -r id model args <<< "$first"
  # shellcheck disable=SC2086
  if awk $args -f "$GOLDEN/models/$model" | cmp -s - "$GOLDEN/${second%.py}.out"; then echo "  FAIL control passed: $id's model equals $second's golden text"; rc=1
  else echo "  the models' negative control: $id's model against $second's text differs, as it must"; fi
  for model in "${!ae_args[@]}"; do
    # shellcheck disable=SC2086
    "$(arbace_exe)" "$GOLDEN/models/$model" --check "$GOLDEN" ${ae_args[$model]} || rc=1
  done
  echo "golden models: $n programs computed by a model as well (awk, or Arbace on stage 0)"
  return $rc
}
pa_arbace_aot() {
  ARBACE_PATH="$root" GOMEMLIMIT=${PYI_GOMEMLIMIT:-$("$root/bin/gate-policy" mem 3GiB)} GOMAXPROCS=${PYI_THREADS:-4} "$(arbace_exe)" -m arbace.python.aot "$@"
}
# aot_cache_trim: Go's cache of the compiled programs kept under 2 GB
# (queue 235: past PYI_AOT_GOCACHE_MB, the entries unused for PYI_AOT_GOCACHE_KEEP_MIN minutes, default 90, as
# bin/lib/gocache.bash trims; it was go clean -cache, which dropped the runtime's compiled packages too, so the next AOT
# step compiled arbace/py again at a 13 GiB peak: the essential chain's pyi-aot-essential with it. Go refreshes an
# entry's time when a build uses it, at most hourly, and every program's build uses the runtime's)
aot_cache_trim() {
  local c=${PYI_AOT_GOCACHE:-$(aot_shared)/gocache}
  [ -d "$c" ] || return 0
  if [ "$(du -sm "$c" | cut -f1)" -gt "${PYI_AOT_GOCACHE_MB:-2000}" ]; then
    find "$c" -type f -mmin +"${PYI_AOT_GOCACHE_KEEP_MIN:-90}" -delete 2>/dev/null || true
    find "$c" -mindepth 1 -type d -empty -delete 2>/dev/null || true
  fi
}

# bench [--pyi] [--record] [BM...]: pyperformance's pure-Python benchmarks (test/python/bench/benchmarks.tsv) as plain
# programs with fixed loops (the pyperf stand-in test/python/bench/pyperf.py), each run by CPython, compiled (pyi's AOT)
# and on the loop of the same executable (and with --pyi by pyi on goi): the whole process's seconds, the outputs
# compared with CPython's; --record writes test/python/bench-aot-linux-ARCH.edn
cmd_bench() {
  need_python "bench (CPython's timings: the oracle tier's)"
  local record="" pyi="" bms=() b loops
  while [ $# -gt 0 ]; do case $1 in --record) record=1; shift ;; --pyi) pyi=1; shift ;; *) bms+=("$1"); shift ;; esac; done
  # the sdist's full benchmark directories (data files, variants' tomls: PY6h's REQUEST, queue 200)
  local src="$root/.tmp/repr-python/pyperformance-1.14.0/pyperformance/data-files/benchmarks"
  [ -d "$src" ] || env -u REPR_PYTHON_VERSION "$root/bin/repr-python" pins --fetch >/dev/null
  aot_module
  local d="$AOT/bench"; mkdir -p "$d"; : > "$d/bench.tsv"
  local -A cls=()
  while IFS=$'\t' read -r b c; do cls[$b]=$c; done < <(sed -n 's/^{:id "\([^"]*\)" :class \(:[a-z0-9-]*\).*/\1\t\2/p' "$root/test/python/bench/classes.edn")
  local unclassed=0 bdir bargs
  while IFS=$'\t' read -r b loops bdir bargs; do
    case $b in '#'*|'') continue ;; esac
    if [ ${#bms[@]} -gt 0 ]; then case " ${bms[*]} " in *" $b "*) ;; *) continue ;; esac; fi
    # NAME LOOPS [DIR [ARGS]]: a variant runs DIR's benchmark with the toml's extra_opts as its arguments
    [ -n "$bdir" ] || bdir=$b
    local -a ba=(); [ -n "$bargs" ] && read -ra ba <<< "$bargs"
    local w="$d/$b"; rm -rf "$w"; mkdir -p "$w"
    cp -r "$src/$bdir/." "$w/"; cp "$root/test/python/bench/pyperf.py" "$w/"
    echo "LOOPS = $loops" > "$w/pyperf_loops.py"
    run_one "$d" "$b.cpython" python3 -s -B "$w/run_benchmark.py" "${ba[@]}"
    local pkg=p_bench_$b exe="$AOT/bin/p_bench_$b" ct t0
    t0=$(date +%s%N); aot_compile "$pkg" "$w/run_benchmark.py" "$exe"; ct=$(( ($(date +%s%N) - t0) / 1000000 ))
    local st=ran why=""
    if [ -f "$exe.refused" ]; then st=refused; why=$(cat "$exe.refused")
    else
      run_one "$d" "$b.aot" "$exe" "$w/run_benchmark.py" "${ba[@]}"
      PYI_AOT_LOOP=1 run_one "$d" "$b.loop" "$exe" "$w/run_benchmark.py" "${ba[@]}"
      [ -n "$pyi" ] && run_one "$d" "$b.pyi" "$root/bin/pyi" run "$w/run_benchmark.py" "${ba[@]}"
      rm -f "$exe"
      if [ "$(outcome "$d" "$b.aot")" != "$(outcome "$d" "$b.cpython")" ]; then st=differs; why="$(grep -v '^[[:space:]]*$' "$d/$b.aot.err" | tail -1 || true)"
        case $why in ModuleNotFoundError:*) st=module-import ;; esac  # a C module of PY6's (the survey's §6.6): classed until it merges
      elif [ "$(cat "$d/$b.cpython.rc")" != 0 ]; then st=fails; why="CPython's run: $(grep -v '^[[:space:]]*$' "$d/$b.cpython.err" | tail -1 || true)"; fi
    fi
    # a benchmark that does not run as CPython's needs its class (test/python/bench/classes.edn, each with its owner)
    if [ "$st" != ran ]; then
      if [ -n "${cls[$b]:-}" ]; then why="${cls[$b]} $why"; else why="UNCLASSED $why"; unclassed=$((unclassed + 1)); fi
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$b" "$loops" "$st" "$(cat "$d/$b.cpython.time")" "$(cat "$d/$b.aot.time" 2>/dev/null || echo -)" \
      "$(cat "$d/$b.loop.time" 2>/dev/null || echo -)" "$(cat "$d/$b.pyi.time" 2>/dev/null || echo -)" "$ct" "$why" | tee -a "$d/bench.tsv"
  done < "$root/test/python/bench/benchmarks.tsv"
  awk -F'\t' '$3 == "ran" {n++; c += $4; a += $5; l += $6} END {if (n) printf "bench: %d benchmarks ran as CPython: CPython %d ms, compiled %d ms, the loop %d ms (loop/compiled %.2f, compiled/CPython %.1f)\n", n, c, a, l, l / a, a / c}' "$d/bench.tsv"
  if [ -n "$record" ]; then
    local arch; case $(uname -m) in x86_64) arch=amd64 ;; aarch64) arch=arm64 ;; *) arch=$(uname -m) ;; esac
    { echo ";; pyi's AOT's speed (bin/pyi bench --record; doc/python/PYTHON-SURVEY.md, \"As built: PY8\"): pyperformance 1.14.0's"
      echo ";; pure-Python benchmarks as plain programs (test/python/bench), the whole process's milliseconds on the recording"
      echo ";; machine ($(uname -m), $(date -u +%F)): CPython 3.14.10, compiled, the loop of the same executable, pyi on goi (- not run);"
      echo ";; :result :ran (the output CPython's), :module-import (a C module of PY6's missing: classed until PY6), :differs,"
      echo ";; :fails (CPython's run fails) or :refused, with the reason. Machine-dependent: not a reference."
      awk -F'\t' 'function esc(s) { gsub(/[\\"]/, "_", s); return s } {printf "{:id \"%s\" :loops %s :result :%s :cpython-ms %s :aot-ms %s :loop-ms %s :pyi-ms %s :compile-ms %s%s}\n", $1, $2, $3, $4, ($5 == "-" ? "nil" : $5), ($6 == "-" ? "nil" : $6), ($7 == "-" ? "nil" : $7), $8, ($9 == "" ? "" : " :reason \"" esc($9) "\"")}' "$d/bench.tsv"
    } > "$root/test/python/bench-aot-linux-$arch.edn"
  fi
  awk -F'\t' '$3 != "ran" {n++} END {printf "bench: %d not run as CPython, each classed in test/python/bench/classes.edn or UNCLASSED\n", n}' "$d/bench.tsv"
  [ "$unclassed" -eq 0 ] || { echo "bench: $unclassed benchmarks not run as CPython and of no class"; return 1; }
}

cmd_aot() {
  [ $# -ge 1 ] || die "usage: bin/pyi aot FILE.py [ARGS...]"
  local f argv0=$1; shift
  case $argv0 in /*) f=$argv0 ;; *) f=$caller_pwd/$argv0 ;; esac
  [ -f "$f" ] || die "no file $argv0"
  aot_module
  local pkg; pkg=p_$(basename "$f" .py | tr -c 'A-Za-z0-9\n' '_')
  aot_compile "$pkg" "$f" "$AOT/bin/$pkg"
  [ -f "$AOT/bin/$pkg.refused" ] && die "aot: refused: $(cat "$AOT/bin/$pkg.refused")"
  aot_run "$AOT/bin/$pkg" "$argv0" "$@"
}

# lib-test-all [--oracle] [--record] [--judge DIR] [--fresh] [--all] [MODULE...] (PY6i): see the header
cmd_lib_test_all() {
  local oracle="" record="" judge="" fresh="" all="" verdict="" mods=() d rc=0 runner=pyrun
  while [ $# -gt 0 ]; do case $1 in --oracle) oracle=1; shift ;; --record) record=1; shift ;; --fresh) fresh=1; shift ;; --all) all=1; shift ;;
    --judge) judge=$2; shift 2 ;; --verdict) verdict=$2; shift 2 ;; *) mods+=("$1"); shift ;; esac; done
  verdict=${verdict:-$(judge_verdict "$oracle")}; [ -z "$oracle" ] || runner=pyall
  [ -n "$oracle$judge" ] || runtime_guard "lib-test-all" "$record"
  [ -f "$REF_ALL" ] || die "no $REF_ALL (bin/pyi record-ref lib-test-all)"
  local owners="$root/test/python/lib-test-all-owners.tsv" refmods="$WORK/lib-test-all/ref-modules.txt"
  mkdir -p "$WORK/lib-test-all"; sed -n 's/^{:id "\([^"/]*\)" :module true.*/\1/p' "$REF_ALL" > "$refmods"
  # the modules a family owns are the family's to measure (test/python/lib-test-all-owners.tsv), but by --all or --oracle
  if [ ${#mods[@]} -eq 0 ]; then
    if [ -n "$all$oracle" ]; then mapfile -t mods < "$refmods"
    else mapfile -t mods < <($runner owned --owners "$owners" --modules "$refmods" --invert); fi
  fi
  if [ -n "$judge" ]; then
    d=$(cd "$caller_pwd" && cd "$judge" && pwd)
  else
    d="$WORK/lib-test-all/run${oracle:+-oracle}"
    [ -z "$fresh" ] || rm -rf "$d"
    mkdir -p "$d"; printf '%s\n' "${mods[@]}" > "$d/modules.txt"
    PYI_LIB_TEST_SKIP="${PYI_LIB_TEST_SKIP-$root/test/python/lib-test-skip.tsv}" $runner run --root "$root" --modules "$d/modules.txt" --dir "$d" --jobs "${PYI_LIB_TEST_JOBS:-2}" \
      --test-timeout "${PYI_LIB_TEST_TEST_TIMEOUT:-300}" --idle-timeout "${PYI_LIB_TEST_IDLE_TIMEOUT:-90}" --mem-max "${PYI_LIB_TEST_MEM_MAX:-8192}" --module-timeout "${PYI_LIB_TEST_TIMEOUT:-3600}" ${oracle:+--oracle "$(stdlib_lib)"} \
      --tmp-base "${PYI_LIB_TEST_TMP:-$root/.tmp/t6i}"
  fi
  rm -f "$d/summary.tsv"
  [ -n "$judge" ] && [ -f "$d/modules.tsv" ] || printf '%s\tlib-test-all\n' "${mods[@]}" > "$d/modules.tsv"
  "$(arbace_exe)" "$root/test/python/libtest_judge.ae" --dir "$d" --ref "$REF_ALL" --modules "$d/modules.tsv" --verdict "$verdict" \
    $(if [ -n "$oracle" ]; then echo --no-classes; else echo --classes "$DIV" --record "$CHECK_RECORD"; fi) ${record:+--write-record} > "$d/judge.log" || rc=$?
  grep -v '^  FAIL ' "$d/judge.log" | tail -n 1
  echo "lib-test-all: $(grep -c '^  FAIL ' "$d/judge.log") methods failing (listed in $d/judge.log)"
  # the table's rows of the families' and the not-run modules: regrtest's whole list (record-ref lib-test-all's)
  local allmods="$WORK/lib-test-all/all-modules.txt"; [ -f "$allmods" ] || allmods=$refmods
  $runner table --dir "$d" --summary "$d/summary.tsv" --out "$d/table.md" ${oracle:---owners "$owners" --modules "$allmods"}
  $runner controls --dir "$d" --controls "$CONTROLS" --ref "$REF_ALL" \
    --judge "$(arbace_exe)" "$root/test/python/libtest_judge.ae" --verdict "$verdict" || rc=1
  return $rc
}

# queue 256: Lib/test's universe as data (doc/python/PYTHON-SURVEY.md, "As built: 256"): test/python/universe-cpython314.edn,
# the modules and test ids CPython 3.14.10's recorded runs name (the references, bin/pyi record-ref) and the tests they skipped
# on the recording platform, a line a module, written by test/python/universe.ae on stage 0 (no python3), keyed by the
# SHA-256 of the generator and the references (universe_key); bin/pyi check's own verdict takes its inventory from it
# (libtest_judge.ae --universe: no CPython outcome read) and refuses a universe whose key is not its inputs'
universe_refs() { echo "$REF_LT"; ls "$root"/test/python/ref-cpython$RECV-lib-test-*.edn; }
universe_key() { cat "$root/test/python/universe.ae" $(universe_refs) | sha256sum | cut -c1-16; }
universe_write() { "$(arbace_exe)" "$root/test/python/universe.ae" --key "$(universe_key)" --out "$1" $(universe_refs); }
# universe_current: dies unless the committed universe's key is its inputs' (the references changed: bin/pyi universe)
universe_current() {
  [ -f "$UNIVERSE" ] || die "no $UNIVERSE (bin/pyi universe)"
  local have; have=$(sed -n 's/^;; key \([0-9a-f]*\)$/\1/p' "$UNIVERSE" | head -1)
  [ "$have" = "$(universe_key)" ] || die "the universe ${UNIVERSE#$root/} is stale: key ${have:-none}, its inputs' $(universe_key) (bin/pyi universe)"
}
# universe [--check]: the universe written (bin/pyi record-ref does it after Lib/test's references); --check: written afresh
# into WORK and compared byte for byte, then its negative control (a universe written from one reference less must differ)
cmd_universe() {
  if [ "${1:-}" = --check ]; then
    mkdir -p "$WORK"; universe_write "$WORK/universe-check.edn" >/dev/null
    local bad=0
    if cmp -s "$WORK/universe-check.edn" "$UNIVERSE"; then echo "universe --check: ${UNIVERSE#$root/} equal, byte for byte, to the one written afresh ($(sed -n 's/^;; \([0-9]* modules, .*\)$/\1/p' "$UNIVERSE"))"
    else echo "universe --check: ${UNIVERSE#$root/} differs from the one written afresh (bin/pyi universe):"; diff "$WORK/universe-check.edn" "$UNIVERSE" | cut -c1-200 | head -6; bad=1; fi
    "$(arbace_exe)" "$root/test/python/universe.ae" --key "$(universe_key)" --out "$WORK/universe-control.edn" $(universe_refs | tail -n +2) >/dev/null
    if cmp -s "$WORK/universe-control.edn" "$UNIVERSE"; then echo "control passed: universe --check: a universe without ${REF_LT#$root/} judged equal"; bad=1
    else echo "control failed as it must: universe --check: a universe without ${REF_LT#$root/} differs"; fi
    return $bad
  fi
  universe_write "$UNIVERSE"
}

# PY7 (queue 201): the check over Lib/test (doc/python/PYTHON-SURVEY.md, "As built: PY7 (the check)").
# check_universe: every module of the check, MODULE<TAB>CORPUS, in the corpora's order: the lib-test corpora of
# corpora.edn (language-core, stdlib-tests, lib-test-asyncio: the families') and lib-test-all (the others less the
# families', test/python/lib-test-all-owners.tsv). The modules (queue 240) are those regrtest's findtests finds in the
# pinned tarball's Lib/test, by pyi (tools/pyi/libtest_all.py find on the compiled runner: no CPython, no record), a
# split directory's (test.test_asyncio.X) named X's package's way for the families (test_asyncio.X, libtest.py's); each
# family's those one of whose paths names it or the package above it (test_importlib's one module, test_asyncio's each).
# The references' :module lines (CPython's regrtest --list-tests, recorded) are not read: a difference with them is
# printed (universe-diff), never a module more or less. Kept in WORK/universe.tsv by the digest of corpora.edn, the owners
# and the runner's script
check_universe() {
  local u="$WORK/universe.tsv" k
  k=$( { cat "$root/test/python/corpora.edn" "$root/test/python/lib-test-all-owners.tsv" "$root/tools/pyi/libtest_all.py"; [ "${REPR_PYTHON_VERSION:-}" != 3.15 ] || stdlib_lib; } | sha256sum | cut -c1-16)
  if [ "$(cat "$u.key" 2>/dev/null)" != "$k" ]; then
    "$(arbace_exe)" -e "(doseq [c (:corpora (read-string (slurp \"$root/test/python/corpora.edn\"))) :when (#{:language-core :stdlib-tests :lib-test-asyncio} (:id c)) p (get-in c [:where :paths])] (println (str (-> p (subs 9) (arbace.string/replace #\"\\.py\$\" \"\")) \"\t\" (name (:id c)))))" > "$WORK/corpus-names.tsv"
    pyrun find --testdir "$(stdlib_lib)/test" > "$WORK/found-modules.txt" || die "check: regrtest's findtests did not run on pyi (bin/pyi runner find)"
    [ -s "$WORK/found-modules.txt" ] || die "check: findtests found no module in $(stdlib_lib)/test"
    sed 's/^test\.\(test_[A-Za-z0-9_]*\)\./\1./' "$WORK/found-modules.txt" \
      | awk -F'\t' 'NR == FNR {n[$1] = $2; order[$2] = FNR; next}
                   {m = $1; c = n[m]; if (c == "") { split(m, q, "."); c = n[q[1]] } if (c != "") print order[c] "\t" m "\t" c}' "$WORK/corpus-names.tsv" - \
      | sort -t$'\t' -k1,1n -k2,2 | cut -f2- > "$u.new"
    pyrun owned --owners "$root/test/python/lib-test-all-owners.tsv" --modules "$WORK/found-modules.txt" --invert | sed 's/$/\tlib-test-all/' >> "$u.new"
    awk -F'\t' '!seen[$1]++' "$u.new" > "$u"; rm -f "$u.new"; echo "$k" > "$u.key"
    universe_diff >&2
  fi
  cat "$u"
}
# universe_diff: the universe against the recorded universe's modules (queue 256: the references' :module lines, what
# CPython's recorded runs named), printed only
universe_diff() {
  local r="$WORK/universe-refs.txt"
  sed -n 's/^{:module "\([^"]*\)".*/\1/p' "$UNIVERSE" | LC_ALL=C sort -u > "$r"
  cut -f1 "$WORK/universe.tsv" | LC_ALL=C sort -u > "$r.u"
  local more; more=$(comm -23 "$r.u" "$r" | wc -l)
  echo "pyi check: the universe, $(wc -l < "$r.u") modules by findtests on pyi; $more no reference names (judged by their own verdict alone), $(comm -13 "$r.u" "$r" | wc -l) named by the references not in it$(comm -13 "$r.u" "$r" | head -4 | sed 's/^/ /' | tr -d '\n')"
}
# module_corpora MODULE...: each module with its corpus of the universe (lib-test-all when it has none)
module_corpora() {
  local m; check_universe > "$WORK/universe.now"
  for m in "$@"; do awk -F'\t' -v m="$m" '$1 == m {print; f=1; exit} END {if (!f) print m "\tlib-test-all"}' "$WORK/universe.now"; done
}

# check [--corpus ID,...] [--only FILE] [--record] [--judge DIR] [--oracle] [--fresh] [MODULE...]: Lib/test under pyi,
# every module of the universe (check_universe; --corpus some corpora, MODULE some modules, --only FILE a selection:
# lines MODULE or MODULE/TEST-ID, # and blank lines ignored, the gate's rotation's lists) run through the restartable
# runner (tools/pyi/libtest_all.py run: a test's crash or timeout ends that test alone) into WORK/check/run (resumed;
# --fresh: anew; a selection's own directory, by its list's digest), then judged by libtest_judge.ae: every method
# against CPython's references, a non-pass in a class of test/python/divergences.edn, a method the record passes
# that does not pass now a regression (test/python/check-lib-test-linux-amd64.edn, PYI_CHECK_RECORD another); the
# rows in RUN/results.tsv (ID RESULT REASON CORPUS: bin/cover classes' RESULTS), the failing methods' lines
# "   failing: ID"; then the negative controls (test/python/controls.edn, GTS81 (a): a subject's run judged as another
# module, against its references, with no classes; one that passes, or is not judged, fails the check; a subject not
# run is left). --record: the record's rows of the modules run written again (refused with --only; exit 3 on a method
# of no class); --judge DIR: DIR's run judged again, nothing run; --oracle: the driver by python3 (the runner's control:
# every method equal but the references' :excluded and the 2 of test_tracemalloc's frames, PY6i).
cmd_check_lib() {
  local corpora="" only="" record="" judge="" oracle="" fresh="" cover="" verdict="" mods=() d rc=0 onlyf="" runner=pyrun aot=""
  while [ $# -gt 0 ]; do case $1 in --corpus) corpora=$2; shift 2 ;; --only) only=$(cd "$caller_pwd" && realpath "$2"); shift 2 ;;
    --cover) cover=$2; shift 2 ;; --verdict) verdict=$2; shift 2 ;; --aot) aot=1; shift ;;
    --record) record=1; shift ;; --judge) judge=$2; shift 2 ;; --oracle) oracle=1; shift ;; --fresh) fresh=1; shift ;;
    -*) die "check: unknown option $1" ;; *) mods+=("$1"); shift ;; esac; done
  [ -z "$record" ] || [ -z "$only$oracle$cover" ] || die "check --record of a selection, the oracle or the cover run: refused"
  # --aot (bin/pyi check --aot --lib-test, queue 279): each module's driver compiled with the module ahead (aot_lib_drivers),
  # the run in WORK/check/run-aot, judged against test/python/check-aot-lib-test-linux-ARCH.edn (queue 284, 279's DECISION
  # (a): the AOT cell's Lib/test record, written by the main host's --record; none yet: no regression judged;
  # PYI_CHECK_AOT_LIB_RECORD another, a dry run's scratch record)
  local rec="$CHECK_RECORD"
  if [ -n "$aot" ]; then
    [ -z "$oracle$cover" ] || die "check --aot --lib-test: no --oracle or --cover"
    local arch; case $(uname -m) in x86_64) arch=amd64 ;; aarch64) arch=arm64 ;; *) arch=$(uname -m) ;; esac
    rec="${PYI_CHECK_AOT_LIB_RECORD:-$root/test/python/check-aot-lib-test-linux-$arch$RECS.edn}"
  fi
  verdict=${verdict:-$(judge_verdict "$oracle")}
  # queue 321: pyi on the tools' host must be the checkout's runtime for a record (the compiled drivers carry the checkout's)
  [ -n "$oracle$cover$aot$judge" ] || runtime_guard "check" "$record"
  # the oracle's runs and the cover run (its own AOT module, WORK/aot-cover) keep python3's runner
  [ -z "$oracle$cover" ] || runner=pyall
  local refs=(--ref "$REF_LT"); local r; for r in "$root"/test/python/ref-cpython$RECV-lib-test-*.edn; do refs+=(--ref "$r"); done
  # queue 256: the inventory from the recorded universe (its key checked first); the references only for --verdict ref
  universe_current
  local uni=(--universe "$UNIVERSE")
  if [ -n "$judge" ]; then
    d=$(cd "$caller_pwd" && cd "$judge" && pwd)
    [ -f "$d/modules.tsv" ] || die "check --judge: no $d/modules.tsv"
  else
    check_universe > "$WORK/universe.now"
    local sel="$WORK/universe.now"
    if [ -n "$corpora" ]; then awk -F'\t' -v cs=",$corpora," 'index(cs, "," $2 ",")' "$sel" > "$WORK/check-sel.tsv"; sel="$WORK/check-sel.tsv"; fi
    if [ ${#mods[@]} -gt 0 ]; then module_corpora "${mods[@]}" > "$WORK/check-mods.tsv"; sel="$WORK/check-mods.tsv"; fi
    d="$WORK/check/run${oracle:+-oracle}${aot:+-aot}"; [ -z "$cover" ] || d="$cover/run"
    if [ -n "$only" ]; then
      local ok="$WORK/check-only.txt"
      # the controls' subjects (GTS81 (a)) run whole with every selection, so every rotated run judges its controls
      { grep -v '^[[:space:]]*\(#\|$\)' "$only" | sed 's/[[:space:]]*$//'; sed -n 's/.*:subject "\([^"]*\)".*/\1/p' "$CONTROLS"; } | sort -u > "$ok" || true
      awk -F'\t' 'NR == FNR {split($1, p, "/"); want[p[1]] = 1; next} want[$1]' "$ok" "$sel" > "$WORK/check-only.tsv"
      sel="$WORK/check-only.tsv"
      d="$WORK/check/only-$(sha256sum < "$ok" | cut -c1-12)${oracle:+-oracle}${aot:+-aot}"; [ -z "$cover" ] || d="$cover/run-$(sha256sum < "$ok" | cut -c1-12)"
    fi
    [ -s "$sel" ] || die "check: no module selected"
    [ -z "$fresh" ] || rm -rf "$d"
    mkdir -p "$d"; cp "$sel" "$d/modules.tsv"; cut -f1 "$sel" > "$d/modules.txt"
    local lib=""; [ -z "$oracle" ] || lib=$(stdlib_lib)
    # --cover DIR (bin/pyi cover run): the driver compiled by pyi's AOT with Go's coverage of the runtime (cover_driver),
    # each test's counters in DIR/tests/N (tools/pyi/libtest_cover.go)
    local drv="" ctests=""
    if [ -n "$cover" ]; then AOT="$WORK/aot-cover"; drv=$(cover_driver) || return 1; ctests="$cover/tests"; mkdir -p "$ctests"; fi
    # queue 287: with --aot the modules go in batches of PYI_AOT_LIB_BATCH (default 40; 0: all at once): each batch's
    # drivers compiled, run and removed before the next's, so the drivers on disk are a batch's (about 170-260 MB
    # each: the whole universe at once held about 529 of them, over 100 GB)
    local parts=("$d/modules.txt") part batch=${PYI_AOT_LIB_BATCH:-40}
    if [ -n "$aot" ] && [ "$batch" -gt 0 ] 2>/dev/null; then
      rm -f "$d"/_batch.*; split -l "$batch" -d -a 3 "$d/modules.txt" "$d/_batch."
      parts=("$d"/_batch.*)
    fi
    # py-footprint-1127: pyi's drivers' children (sys.executable: script_helper's, subprocess's, multiprocessing's spawn and
    # forkserver) by the compiled launcher too, as --aot's (queue 284), not a whole pyi on the tools' host each: a spawn
    # worker about 70-150 MB of its own and started in about 0.5-1 s, where pyi on the host's was 260-320 MB at train 7
    # (500-650 MB on train 6's stage 0) and 3-12 s (Pool(200) about 61 GB; _TestBarrier's parties late,
    # :spawn-children-timing). PYI_CHILD_LAUNCHER=0: tools/pyi/python3 (pyi on the host) as before
    if [ -z "$aot$oracle$cover" ] && [ "${PYI_CHILD_LAUNCHER:-1}" != 0 ]; then
      local cpy; cpy=$(launcher_py) || return 1; export PYI_CHILD_EXECUTABLE="$cpy"
    fi
    for part in "${parts[@]}"; do
      local drvdir=""; if [ -n "$aot" ]; then drvdir=$(aot_lib_drivers "$d" "$part") || return 1; fi
      # a compiled driver is a compiled program: bin/pyi run's environment (pyi_env: sys.executable tools/pyi/python3, so
      # script_helper's and subprocess's children start pyi as bin/pyi run's do; it was '': "[Errno 13] Permission denied")
      [ -z "$drv$drvdir" ] || pyi_env
      # queue 284: the drivers' children by the compiled launcher (launcher_py), sys.executable its wrapper
      if [ -n "$drvdir" ] && [ "${PYI_AOT_LAUNCHER:-1}" != 0 ]; then
        local lpy; lpy=$(launcher_py) || return 1; export PYI_EXECUTABLE="$lpy"
      fi
      PYI_LIB_TEST_DRIVER_EXE="$drv" PYI_LIB_TEST_DRIVER_DIR="$drvdir" PYI_AOT_COMPILER="${drv:+$AOT/compiler.sh}${drvdir:+$AOT/compiler.sh}" PYI_LIB_TEST_COVER_TESTS="$ctests" \
      PYI_LIB_TEST_ONLY="${only:+$WORK/check-only.txt}" PYI_LIB_TEST_SKIP="${PYI_LIB_TEST_SKIP-$root/test/python/lib-test-skip.tsv}" \
      PYI_LIB_TEST_LIMITS="${PYI_LIB_TEST_LIMITS-$root/test/python/lib-test-limits.tsv}" \
        $runner run --root "$root" --modules "$part" --dir "$d" --jobs "${PYI_LIB_TEST_JOBS:-2}" \
        --test-timeout "${PYI_LIB_TEST_TEST_TIMEOUT:-300}" --idle-timeout "${PYI_LIB_TEST_IDLE_TIMEOUT:-90}" --mem-max "${PYI_LIB_TEST_MEM_MAX:-8192}" --module-timeout "${PYI_LIB_TEST_TIMEOUT:-3600}" ${oracle:+--oracle "$lib"} \
        --tmp-base "${PYI_LIB_TEST_TMP:-$root/.tmp/t6i}"
      # the compiled drivers (about 220 MB each) not kept past their run
      [ -z "$drvdir" ] || { rm -rf "$drvdir"; aot_cache_trim; }
    done
    rm -f "$d"/_batch.*
    if [ -n "$only" ]; then cp "$WORK/check-only.txt" "$d/only.txt"; else rm -f "$d/only.txt"; fi
  fi
  [ ! -f "$d/only.txt" ] || onlyf="$d/only.txt"
  "$(arbace_exe)" "$root/test/python/libtest_judge.ae" --name "pyi check" --dir "$d" --modules "$d/modules.tsv" "${refs[@]}" "${uni[@]}" --verdict "$verdict" \
    ${onlyf:+--only "$onlyf"} --save "$d/results.tsv" \
    $(if [ -n "$oracle" ]; then echo --no-classes; else echo --classes "$DIV" --record "$rec"; fi) ${record:+--write-record} > "$d/judge.log" || rc=$?
  grep -v '^  FAIL \|^   failing: \|^pyi check test' "$d/judge.log" || true
  grep '^   failing: ' "$d/judge.log" | head -n "${PYI_CHECK_SHOW:-200}" || true
  echo "pyi check: $(grep -c '^   failing: ' "$d/judge.log") methods failing (listed in $d/judge.log)"
  if [ -z "$oracle" ]; then
    local refsc; refsc=$(printf '%s\n' "${refs[@]}" | grep -v '^--ref$' | paste -sd,)
    $runner controls --dir "$d" --controls "$CONTROLS" --ref "$refsc" --judge "$(arbace_exe)" "$root/test/python/libtest_judge.ae" "${uni[@]}" --verdict "$verdict" || rc=1
  fi
  return $rc
}

# aot_lib_drivers RUN [LIST] (queue 279, check --aot --lib-test): for each module of LIST (default RUN/modules.txt; queue 287: a batch's), test/python/libtest_run.py with
# the module's import put in its module-level code where it never runs (the driver's own import of it at run time, after
# regrtest's setup, takes the module compiled ahead: AotRegister's key is its source's), compiled by pyi's AOT into
# WORK/aot/bin/lt/MODULE.exe (bin/pyi aot-compile, under busybox time; MODULE runs it under busybox time, RUN/MODULE.mem
# each driver run's seconds and peak memory); each module's compile in RUN/aot-compile.tsv (MODULE
# SECONDS PEAK-KB STATE REASON; STATE built, refused or no-build). A module not built is not run (its methods "no result":
# failing, not left to the loop). Prints the drivers' directory
aot_lib_drivers() {
  local run=$1 list=${2:-$1/modules.txt} m n=0 jobs=${PYI_AOT_LIB_JOBS:-${PYI_LIB_TEST_JOBS:-2}} running=0; local dir="$AOT/bin/lt" src="$AOT/lt-src"
  aot_module >&2; mkdir -p "$dir" "$src"; : >> "$run/aot-compile.tsv"
  # PYI_AOT_LIB_JOBS drivers at once (default PYI_LIB_TEST_JOBS; about 1-2.5 GB each, a cold generator's first 4.5 GB):
  # the first alone (a new generator's packages dropped and made once, aot_compile), then the rest in parallel
  while IFS= read -r m; do
    [ -n "$m" ] || continue
    [ ! -f "$run/$m.status" ] || continue  # run already (the runner keeps it: the run resumes)
    n=$((n + 1))
    if [ "$n" = 1 ]; then aot_lib_driver "$run" "$m" "$dir" "$src"; continue; fi
    if [ "$running" -ge "$jobs" ]; then wait -n || true; running=$((running - 1)); fi
    aot_lib_driver "$run" "$m" "$dir" "$src" &
    running=$((running + 1))
  done < "$list"
  wait
  echo "$dir"
}
# aot_lib_driver RUN MODULE DIR SRC: one module's driver (aot_lib_drivers)
aot_lib_driver() {
  local run=$1 m=$2 dir=$3 src=$4 w pkg out t0 st why kb
  w="$src/$m.py"; pkg=p_lt_$(echo "$m" | tr -c 'A-Za-z0-9\n' '_'); out="$dir/$m.exe"
  { cat "$root/test/python/libtest_run.py"
    printf '\n# queue 279: compiled ahead with the driver; never run here (main imports it after regrtest_setup)\nif sys.argv is None:\n    import %s\n' \
      "$(case $m in test.*) echo "$m" ;; *) echo "test.$m" ;; esac)"; } > "$w"
  t0=$(date +%s%N)
  # queue 594: the driver's sys.path has lib-dynload after the stdlib, as bin/pyi python's --site has it (the C world's
  # extension modules: test_import's and test_importlib's _testsinglephase and _testmultiphase)
  PYI_AOT_SITE="$root/tools/pyi/lib-dynload" busybox time -v -o "$run/$m.aot-compile.time" "$root/bin/pyi" aot-compile "$pkg" "$w" "$out" \
    > "$run/$m.aot-compile.log" 2>&1 || true
  kb=$(sed -n 's/.*Maximum resident set size (kbytes): //p' "$run/$m.aot-compile.time"); st=built why=""
  if [ -f "$out.refused" ]; then st=refused why=$(head -c 200 "$out.refused" | tr '\t\n' '  '); rm -f "$out"
  elif [ ! -x "$out" ]; then st=no-build why="see ${AOT#$root/}/log/$pkg.build"; fi
  # a module not built: its run written as the driver's IMPORT line (the runner keeps it; the judge: every method no result)
  if [ "$st" != built ]; then printf '\nIMPORT\tpyi AOT %s: %s\n' "$st" "$why" > "$run/$m.out"; : > "$run/$m.err"; echo aot > "$run/$m.status"
  else
    # DIR/MODULE runs the driver under busybox time: each driver run's seconds and peak memory appended to RUN/MODULE.mem
    printf '#!/bin/sh\nexec busybox time -v -a -o %q %q "$@"\n' "$run/$m.mem" "$out" > "$dir/$m"; chmod +x "$dir/$m"; rm -f "$run/$m.mem"
  fi
  printf '%s\t%s\t%s\t%s\t%s\n' "$m" $(( ($(date +%s%N) - t0) / 1000000000 )) "${kb:--}" "$st" "$why" >> "$run/aot-compile.tsv"
  echo "pyi check --aot: $m's driver $st" >&2
}

# cover_driver: test/python/libtest_run.py compiled by pyi's AOT (PY8) in the module of WORK/aot-cover, its runtime with
# tools/pyi/libtest_cover.go and built with -cover -covermode=atomic -coverpkg=arbace/py and its main package (Go sets
# its coverage up only from an instrumented main; the main's blocks are no runtime's): the runtime's blocks are Go's
# there (under goi, bin/pyi run's, Go's -cover sees only goi's own); prints its path
cover_driver() {
  AOT="$WORK/aot-cover"; aot_module
  cp "$root/tools/pyi/libtest_cover.go" "$AOT/mod/py/zz_libtest_cover.go"
  local drv="$AOT/bin/p_libtestrun"
  PYI_AOT_GOFLAGS="-cover -covermode=atomic -coverpkg=arbace/py,arbace/pyaot/p_libtestrun/prog" aot_compile p_libtestrun "$root/test/python/libtest_run.py" "$drv" >&2
  [ ! -f "$drv.refused" ] || die "cover: the driver is refused: $(cat "$drv.refused")"
  echo "$drv"
}

# cover run [check's options] | blocks | subset [--write]: the coverage subset of Lib/test's methods (GT8.3, GTS205 (a)'s
# rule, GTS206 (a)): run, the check through the cover driver (cover_driver) into WORK/cover (the main host's night: every
# module, each method's own block set); blocks, tools/covsubset blocks over WORK/cover/tests (bin/cover's tool): each
# method's blocks of arbace/py; subset, the methods that reach every covered block, one method per class of
# divergences.edn (the cheapest), every method of a :deferred class, the controls' subjects and references
# (tools/covsubset reduce via bin/cover subset), per corpus into WORK/cover/subset/CORPUS.txt; --write puts them into
# test/python/corpora.edn as each corpus's :subset (lib-test-all's in its :lib-test-all map)
cmd_cover() {
  local verb=${1:-}; shift || true
  local C="$WORK/cover" goroot=${ARBACE_GOROOT:-/root/tamago-go}
  case $verb in
    run) mkdir -p "$C"; cmd_check_lib --cover "$C" "$@" ;;
    blocks)
      [ -d "$C/tests" ] || die "cover blocks: no $C/tests (bin/pyi cover run)"
      # tools/covsubset, built by TamaGo's go as bin/cover builds it (into .tmp/cover-tool, by its sources' digest)
      local ex="$root/.tmp/cover-tool/covsubset" k
      k=$(cat "$root"/tools/covsubset/*.go "$root/tools/covsubset/go.mod" "$goroot/VERSION" | sha256sum | cut -c1-64)
      if [ "$(cat "$ex.key" 2>/dev/null)" != "$k" ] || [ ! -x "$ex" ]; then
        mkdir -p "$root/.tmp/cover-tool"
        (cd "$root/tools/covsubset" && env -u GOOS -u GOARCH GOROOT="$goroot" GOFLAGS= GOTOOLCHAIN=local CGO_ENABLED=0 \
          "$goroot/bin/go" build -trimpath -buildvcs=false -o "$ex.new" .) && mv -f "$ex.new" "$ex" && echo "$k" > "$ex.key" \
          || die "cover blocks: tools/covsubset did not build"
      fi
      echo arbace/py > "$C/pkgs.txt"
      find "$C/tests" -mindepth 1 -maxdepth 1 -type d ! -name meta | LC_ALL=C sort > "$C/dirs.txt"
      rm -rf "$C/blocks"
      xargs -a "$C/dirs.txt" -d '\n' "$ex" blocks -go "$goroot/bin/go" -pkgs "$C/pkgs.txt" -o "$C/blocks" -j "${COVER_JOBS:-8}" ;;
    subset)
      local write=""; [ "${1:-}" != --write ] || write=1
      [ -f "$C/blocks/tests.tsv" ] || die "cover subset: no $C/blocks/tests.tsv (bin/pyi cover blocks)"
      local res; res=$(ls -t "$C"/run*/results.tsv 2>/dev/null | head -1); [ -n "$res" ] || die "cover subset: no results"
      # the keep list: every method of a :deferred class, the controls' modules' methods, one method per class (the
      # first in the record's order: the reducer's --classes picks one a class, the cheapest by --times)
      "$root/bin/cover" classes "$DIV" "$res" -o "$C/classes" > /dev/null
      awk -F'\t' 'NR == FNR {c[$1] = 1; next} {split($1, p, "/"); if (p[1] in c) print $1}' \
        <(sed -n 's/.*:subject "\([^"]*\)" :reference "\([^"]*\)".*/\1\n\2/p' "$CONTROLS") "$res" >> "$C/classes.keep"
      LC_ALL=C sort -u -o "$C/classes.keep" "$C/classes.keep"
      "$root/bin/cover" subset "$C/blocks" --keep "$C/classes.keep" --classes "$C/classes.classes" ${PYI_COVER_TIMES:+--times "$PYI_COVER_TIMES"}
      mkdir -p "$C/subset"
      awk -F'\t' 'NR == FNR {s[$1] = 1; next} ($1 in s) {print $1 > (out "/" $4 ".txt")}' out="$C/subset" "$C/blocks/subset.txt" "$res"
      wc -l "$C"/subset/*.txt
      [ -z "$write" ] || "$(arbace_exe)" "$root/test/python/corpora_subset.ae" "$root/test/python/corpora.edn" "$C/subset" ;;
    *) die "usage: bin/pyi cover run [check's options] | blocks | subset [--write]" ;;
  esac
}

# divergences [--table | --methods] [--results FILE...]: the record's non-passes (or a run's saved rows), each in a class
# of test/python/divergences.edn, counted by class; a non-pass in no class, or a name of :tests another class takes
# first, fails (GR10, as bin/goi divergences); --table the classes as a Markdown table, --methods every method by class
cmd_divergences() {
  local args=() f
  while [ $# -gt 0 ]; do case $1 in --table|--methods) args+=("$1"); shift ;;
    --results) f=$(cd "$caller_pwd" && realpath "$2"); args+=(--results "$f"); shift 2 ;; *) die "divergences: unknown option $1" ;; esac; done
  if [ ! -f "$CHECK_RECORD" ] && ! printf '%s\n' "${args[@]+"${args[@]}"}" | grep -q -- --results; then
    echo "pyi divergences: no record yet ($CHECK_RECORD: bin/pyi check --record on the main host)"; return 0
  fi
  "$(arbace_exe)" "$root/test/python/libtest_judge.ae" --name pyi --divergences --classes "$DIV" --record "$CHECK_RECORD" "${args[@]+"${args[@]}"}"
}

RT="$WORK/runtime"
# (queue 265: $RT made first: in a fresh checkout gen-tables' and tables' gofmt ran before any runtime print made it)
tamago_go() { (mkdir -p "$RT" && cd "$RT" && env GOROOT= PATH="${ARBACE_GOROOT:-/root/tamago-go}/bin:$PATH" GOCACHE="$WORK/gocache" GOFLAGS=-mod=mod CGO_ENABLED=0 GOTOOLCHAIN=local "$@"); }

runtime_print() {
  local out=$1
  rm -rf "$out"; mkdir -p "$out/py"
  printf 'module arbace\n\ngo 1.27\n' > "$out/go.mod"
  ARBACE_PATH="$root" "$root/bin/repr-go" print "$root/go/arbace/py.ae" "$out/py" >/dev/null
  # the musl libm port the runtime imports (go/arbace/libm, shared with hsi): printed beside it, not read back
  mkdir -p "$out/libm"
  ARBACE_PATH="$root" "$root/bin/repr-go" print "$root/go/arbace/libm.ae" "$out/libm" >/dev/null
  # expat's port the module pyexpat imports (go/arbace/expat, queue 202e): printed beside it, not read back
  mkdir -p "$out/expat"
  ARBACE_PATH="$root" "$root/bin/repr-go" print "$root/go/arbace/expat.ae" "$out/expat" >/dev/null
  # pyexpat's package (go/arbace/pyexpat, over py and expat), loaded on the module's first import: printed beside them
  mkdir -p "$out/pyexpat"
  ARBACE_PATH="$root" "$root/bin/repr-go" print "$root/go/arbace/pyexpat.ae" "$out/pyexpat" >/dev/null
  # queue 208: ci's back end (go/arbace/ci, crt) and bzip2's node program (go/arbace/clib/bzip2, bin/pyi-clib's), printed
  # beside it, not read back (liblzma's, zstd's and SQLite's, go/arbace/clib/{xz,zstd,sqlite}, too); the C library host (go/arbace/clib) and
  # the glue of _bz2, _lzma, _zstd and _sqlite3 (go/arbace/pybz2, pylzma, pyzstd, pysqlite3), read back
  local p
  for p in ci crt clib clib/bzip2 clib/xz clib/zstd clib/sqlite pybz2 pylzma pyzstd pysqlite3; do
    mkdir -p "$out/$p"
    ARBACE_PATH="$root" "$root/bin/repr-go" print "$root/go/arbace/$p.ae" "$out/$p" >/dev/null
  done
  # queue 244: ctypes's world (go/arbace/clib/ctypestest, bin/pyi-clib's: CPython's _ctypes_test.c and musl, not read
  # back) and pyctypes (libffi's part over ci, read back)
  for p in clib/ctypestest pyctypes; do
    mkdir -p "$out/$p"
    ARBACE_PATH="$root" "$root/bin/repr-go" print "$root/go/arbace/$p.ae" "$out/$p" >/dev/null
  done
  # _ssl's fallback store (queue 209): arbace/pyssl over x509roots/'s bundle (its bundle.der beside it, as go:embed
  # wants), printed beside them, not read back
  mkdir -p "$out/pyssl" "$out/x509roots/fallback/bundle"
  ARBACE_PATH="$root" "$root/bin/repr-go" print "$root/go/arbace/pyssl.ae" "$out/pyssl" >/dev/null
  ARBACE_PATH="$root:$root/x509roots" "$root/bin/repr-go" print "$root/x509roots/go/arbace/x509roots/fallback/bundle.ae" \
    "$out/x509roots/fallback/bundle" >/dev/null
  cp "$root/x509roots/go/arbace/x509roots/fallback/bundle/bundle.der" "$out/x509roots/fallback/bundle/"
  # queue 552: the crypto/tls _ssl imports, vendored from TamaGo's go1.27.1 with its dependencies (go/arbace/pytls and
  # its internal packages), printed beside it, not read back (bin/pyi tls-vendor makes their forms)
  for p in $(pytls_pkgs); do
    mkdir -p "$out/$p"
    ARBACE_PATH="$root" "$root/bin/repr-go" print "$root/go/arbace/$p.ae" "$out/$p" >/dev/null
  done
}

# pytls_pkgs: the vendored crypto/tls's packages under go/arbace (pytls, pytls/internal/...), as paths below go/arbace
pytls_pkgs() {
  [ -f "$root/go/arbace/pytls.ae" ] || return 0
  echo pytls
  (cd "$root/go/arbace" && find pytls -name '*.ae' | while read -r f; do [ -d "${f%.ae}" ] && echo "${f%.ae}"; done | LC_ALL=C sort)
}

# runtime_read_pkgs SRC: the C library host and _bz2's glue (queue 208) read back from SRC into go/arbace
runtime_read_pkgs() {
  local src=$1 p out f
  for p in clib pybz2 pylzma pyzstd pysqlite3 pyctypes; do
    out="$WORK/runtime-forms-$p"; rm -rf "$out"
    (cd "$src" && "$root/bin/repr-go" read --full --tests --goos linux --goarch amd64 --out "$out" "./$p") > "$out.log" 2>&1 \
      || { cat "$out.log" >&2; die "go/arbace/$p's Go does not read (log $out.log)"; }
    # the package's own files only: go/arbace/clib/ also holds the libraries' packages (bin/pyi-clib's)
    rm -f "$root/go/arbace/$p".ae
    for f in "$root/go/arbace/$p"/*.ae; do [ -d "${f%.ae}" ] || rm -f "$f"; done
    mkdir -p "$root/go/arbace/$p"
    cp "$out/go/arbace/$p.ae" "$root/go/arbace/"; cp "$out/go/arbace/$p"/*.ae "$root/go/arbace/$p/"
  done
}

# runtime_read_pytls SRC (queue 552): the vendored crypto/tls's packages (SRC/pytls and its internal packages) read back into
# go/arbace/pytls{.ae,/}, its _test files with them; the forms of a package no longer in SRC removed
runtime_read_pytls() {
  local src=$1 p out
  [ -d "$src/pytls" ] || return 0
  local pkgs; pkgs=$(cd "$src" && find pytls -name '*.go' -printf '%h\n' | LC_ALL=C sort -u)
  rm -rf "$root/go/arbace/pytls" "$root/go/arbace/pytls.ae"
  for p in $pkgs; do
    out="$WORK/runtime-forms-$(echo "$p" | tr / -)"; rm -rf "$out"
    (cd "$src" && "$root/bin/repr-go" read --full --tests --goos linux --goarch amd64 --out "$out" "./$p") > "$out.log" 2>&1 \
      || { cat "$out.log" >&2; die "go/arbace/$p's Go does not read (log $out.log)"; }
    mkdir -p "$root/go/arbace/$p"
    cp "$out/go/arbace/$p.ae" "$root/go/arbace/$p.ae"; cp "$out/go/arbace/$p"/*.ae "$root/go/arbace/$p/"
  done
}

runtime_read() {
  local src=$1 out=$2
  rm -rf "$out"
  (cd "$src" && "$root/bin/repr-go" read --full --tests --goos linux --goarch amd64 --out "$out" ./py) > "$out.log" 2>&1 \
    || { cat "$out.log" >&2; die "the runtime's Go does not read (log $out.log)"; }
  runtime_read_other "$src" "$out"
}

# runtime_read_other SRC OUT (queue 214): the runtime's files that linux/amd64's read leaves out (//go:build !linux: pyi's system
# interface where TamaGo's syscall has no Linux, builtins_os_other.go, for goi's table's tamago configurations) read under
# tamago/arm64 and merged into OUT's forms: each such file's forms, its name in py.ae's :files and its (load ...) line, in
# order. Nothing when SRC/py has no such file.
runtime_read_other() {
  local src=$1 out=$2 others f n t="$2-tamago" idx="$2/go/arbace/py.ae"
  others=$(cd "$src/py" && grep -l '^//go:build !linux$' -- *.go 2>/dev/null | grep -v '_test\.go$' || true)
  [ -n "$others" ] || return 0
  rm -rf "$t"
  (cd "$src" && "$root/bin/repr-go" read --full --tests --goos tamago --goarch arm64 --out "$t" ./py) > "$t.log" 2>&1 \
    || { cat "$t.log" >&2; die "the runtime's Go does not read under tamago/arm64 (log $t.log)"; }
  for f in $others; do
    n=${f%.go}
    [ -f "$t/go/arbace/py/$n.ae" ] || die "runtime_read_other: no forms of $f under tamago/arm64 ($t)"
    cp "$t/go/arbace/py/$n.ae" "$out/go/arbace/py/"
    awk -v f="\"$f\"" -v l="(load \"py/$n\")" '
      /^  :files \[/ { s = substr($0, 11, length($0) - 11); k = split(s, a, " "); a[++k] = f
                       for (i = 2; i <= k; i++) { v = a[i]; j = i - 1; while (j > 0 && a[j] > v) { a[j + 1] = a[j]; j-- } a[j + 1] = v }
                       o = a[1]; for (i = 2; i <= k; i++) o = o " " a[i]; print "  :files [" o "]"; next }
      /^\(load "py\// && !done && $0 !~ /_test"\)$/ && $0 > l { print l; done = 1 }
      /^\(load "py\// && !done && $0 ~ /_test"\)$/ { print l; done = 1 }
      { print }
      END { if (!done) print l }' "$idx" > "$idx.new" && mv "$idx.new" "$idx"
  done
  rm -rf "$t"
}

# oracle315: the 3.15.2 oracle (queue 236's default, REPR_PYTHON_ORACLE_315: the main checkout's .tmp/oracle315 build)
oracle315() {
  local m=${root%%/.tmp/gate-clean/*}; m=${m%%/.tmp/worktrees/*}
  echo "${REPR_PYTHON_ORACLE_315:-$m/.tmp/oracle315/src/Python-3.15.2/python}"
}

cmd_bytecode_check() {
  local d="$WORK/bytecode-check" f b irs="" refs="" py=python3
  # under REPR_PYTHON_VERSION=3.15 (queue 238): the view of 3.15 (the runtime's switch) against the 3.15.2 oracle's
  if [ "${REPR_PYTHON_VERSION:-}" = 3.15 ]; then
    py=$(oracle315); d="$WORK/bytecode-check-315"
    [ -x "$py" ] || die "REPR_PYTHON_VERSION=3.15: no 3.15.2 oracle at $py (REPR_PYTHON_ORACLE_315)"
  fi
  mkdir -p "$d"
  [ $# -gt 0 ] || { local l; l=$(stdlib_lib); set -- "$l/dis.py" "$l/textwrap.py" "$l/argparse.py"; }
  [ -d "$RT/py" ] || runtime_print "$RT"
  for f in "$@"; do
    b="$d/$(echo "$f" | tr '/' '_')"
    pa_arbace ir --file "$f" --out "$b.ir"
    "$py" -I -B "$root/tools/pyi/bytecode_ref.py" "$f" "$b.json"
    irs="$irs $b.ir"; refs="$refs $b.json"
  done
  PYI_BC_SHOW=${PYI_BC_SHOW:-0} PYI_BC_IR="$irs" PYI_BC_REF="$refs" tamago_go go test ./py -run TestBytecodeDiff -count=1 -v | grep -v '^=== RUN\|^--- PASS\|^PASS\|^ok '
}

cmd_runtime() {
  local verb=${1:-}
  case $verb in
    print) runtime_print "$RT"; echo "the runtime's Go in $RT/py: edit it there, then bin/pyi runtime read" ;;
    read-pytls) [ -d "$RT/pytls" ] || die "no $RT/pytls: bin/pyi runtime print first"; runtime_read_pytls "$RT"
      echo "go/arbace/pytls read from $RT/pytls" ;;
    read)
      [ -d "$RT/py" ] || die "no $RT/py: bin/pyi runtime print first"
      runtime_read "$RT" "$WORK/runtime-forms"
      rm -rf "$root/go/arbace/py" "$root/go/arbace/py.ae"
      cp -r "$WORK/runtime-forms/go/arbace/py" "$WORK/runtime-forms/go/arbace/py.ae" "$root/go/arbace/"
      runtime_read_pkgs "$RT"
      runtime_read_pytls "$RT"
      echo "go/arbace/py read from $RT/py ($(ls "$root/go/arbace/py" | wc -l) files)" ;;
    vet)
      [ -d "$RT/py" ] || runtime_print "$RT"
      tamago_go gofmt -l py | sed 's/^/not gofmt: /' | grep . && die "gofmt the runtime's Go first"
      tamago_go go vet ./py ./pytls/... ./expat ./pyexpat ./clib ./pybz2 ./pylzma ./pyzstd ./pysqlite3 ./pyctypes
      tamago_go go test ./py ./expat ./pyexpat ./clib ./pybz2 ./pylzma ./pyzstd ./pysqlite3 ./pyctypes ;;
    check)
      local rc=0 t="$WORK/runtime-check" p
      # queue 321: its programs and REPL sessions run pyi on the tools' host (PYI_RUNTIME_REQUIRE=compiled in the gate)
      runtime_guard "runtime check" ""
      runtime_print "$t/src"
      runtime_read "$t/src" "$t/forms"
      if diff -r "$root/go/arbace/py" "$t/forms/go/arbace/py" >/dev/null && cmp -s "$root/go/arbace/py.ae" "$t/forms/go/arbace/py.ae"; then
        echo "runtime: go/arbace/py printed and read again: the same forms"
      else
        echo "runtime: go/arbace/py printed and read again DIFFERS (diff -r go/arbace/py $t/forms/go/arbace/py)"; rc=1
      fi
      # expat's port and pyexpat's package (queue 202e): printed and read again the same forms
      for p in expat pyexpat clib pybz2 pylzma pyzstd pysqlite3 pyssl pyctypes; do
        (cd "$t/src" && "$root/bin/repr-go" read --full --tests --goos linux --goarch amd64 --out "$t/$p-forms" "./$p") \
          > "$t/$p-forms.log" 2>&1 || { cat "$t/$p-forms.log" >&2; rc=1; }
        # the package's own files (go/arbace/clib/ also holds the libraries' packages, bin/pyi-clib's)
        if diff <(cd "$root/go/arbace/$p" && for f in *.ae; do [ -d "${f%.ae}" ] || echo "$f"; done) <(ls "$t/$p-forms/go/arbace/$p") >/dev/null \
           && (for f in "$t/$p-forms/go/arbace/$p"/*.ae; do cmp -s "$f" "$root/go/arbace/$p/${f##*/}" || exit 1; done) \
           && cmp -s "$root/go/arbace/$p.ae" "$t/$p-forms/go/arbace/$p.ae"; then
          echo "runtime: go/arbace/$p printed and read again: the same forms"
        else
          echo "runtime: go/arbace/$p printed and read again DIFFERS (diff -r go/arbace/$p $t/$p-forms/go/arbace/$p)"; rc=1
        fi
      done
      # the Unicode database's tables (PY6c): builtins_unicodedata_table.go as tools/pyi/unicodedata_table.py makes it
      # from the pinned tarball's generated headers
      local top="$root/.tmp/repr-python/Python-3.14.10"
      [ -d "$top/Lib" ] || env -u REPR_PYTHON_VERSION "$root/bin/repr-python" pins --fetch >/dev/null
      # (queue 213: python3's generators over the tarball's headers, the committed tables their record: the oracle tier's,
      # bin/pyi runtime tables; here only where the oracle runs live)
      if ! pyrec_live; then
        echo "runtime: builtins_unicodedata_table.go and builtins_cjk_table.go against their generators: the oracle tier's (bin/pyi runtime tables)"
      elif python3 -I -S -B "$root/tools/pyi/unicodedata_table.py" "$top" "$t/src/py/builtins_unicodedata_table.go" --check; then
        echo "runtime: builtins_unicodedata_table.go is unicodedata_table.py's from the tarball's headers"
        ucd315_check "$t/src/py" || rc=1
        bc_tables_check "$t/src/py" || rc=1
      else
        echo "runtime: builtins_unicodedata_table.go DIFFERS from unicodedata_table.py's"; rc=1
      fi
      # the CJK codecs' tables (PY6c2): builtins_cjk_table.go as tools/pyi/cjkcodecs_table.py makes it from the pinned
      # tarball's Modules/cjkcodecs/mappings_*.h
      if ! pyrec_live; then :
      elif python3 -I -S -B "$root/tools/pyi/cjkcodecs_table.py" "$top" "$t/src/py/builtins_cjk_table.go" --check; then
        echo "runtime: builtins_cjk_table.go is cjkcodecs_table.py's from the tarball's headers"
      else
        echo "runtime: builtins_cjk_table.go DIFFERS from cjkcodecs_table.py's"; rc=1
      fi
      pa_arbace runtime-ops || rc=1
      runtime_programs || rc=1
      repl_check || rc=1
      return $rc ;;
    programs)
      # the programs of test/python/pyi and their controls, then repl --check, without check's print, read and tables: a light
      # proof of the runtime a run loads (runtime_from_source)
      local rc=0
      runtime_programs || rc=1
      repl_check || rc=1
      return $rc ;;
    tables)
      # the oracle tier's (queue 213): the generated tables against python3's generators over the tarball's headers
      need_python "runtime tables"
      local t="$WORK/runtime-tables" top="$root/.tmp/repr-python/Python-3.14.10" rc=0
      [ -d "$top/Lib" ] || env -u REPR_PYTHON_VERSION "$root/bin/repr-python" pins --fetch >/dev/null
      rm -rf "$t"; mkdir -p "$t"; runtime_print "$t/src"
      py_spelling "$t/src/py"
      python3 -I -S -B "$root/tools/pyi/unicodedata_table.py" "$top" "$t/src/py/builtins_unicodedata_table.go" --check \
        && echo "runtime: builtins_unicodedata_table.go is unicodedata_table.py's from the tarball's headers" || { echo "runtime: builtins_unicodedata_table.go DIFFERS"; rc=1; }
      ucd315_check "$t/src/py" || rc=1
      bc_tables_check "$t/src/py" || rc=1
      # queue 290: the built-ins' __text_signature__, recorded from the oracle's own (CPython 3.14.10's) built-ins
      python3 -I -S -B "$root/tools/pyi/textsig_table.py" "$t/textsig.go" && tamago_go gofmt "$t/textsig.go" > "$t/textsig.fmt" \
        && cmp -s "$t/textsig.fmt" "$t/src/py/builtins_textsig_table.go" \
        && echo "runtime: builtins_textsig_table.go is textsig_table.py's from the oracle's built-ins" || { echo "runtime: builtins_textsig_table.go DIFFERS from textsig_table.py's"; rc=1; }
      python3 -I -S -B "$root/tools/pyi/cjkcodecs_table.py" "$top" "$t/src/py/builtins_cjk_table.go" --check \
        && echo "runtime: builtins_cjk_table.go is cjkcodecs_table.py's from the tarball's headers" || { echo "runtime: builtins_cjk_table.go DIFFERS"; rc=1; }
      # queue 265: the five tables Arbace makes (bin/pyi runtime gen-tables) against the python3 generators that recorded them
      # from CPython's own modules (the oracle's: this machine's CPython 3.14.10); fcntl's, socket's and posix's with the build
      # line the committed files carry (their header in the python3 generator's spelling, py_spelling)
      local g
      for g in errno opcode fcntl socket posix; do
        case $g in
          errno|opcode) python3 -I -S -B "$root/tools/pyi/${g}_table.py" "$t/$g.go" ;;
          *) python3 -I -S -B "$root/tools/pyi/${g}_table.py" "${ARBACE_GOROOT:-/root/tamago-go}" "$t/$g.go" ;;
        esac && tamago_go gofmt "$t/$g.go" > "$t/$g.fmt" \
          && { case $g in fcntl|socket|posix) { printf '//go:build linux\n\n'; cat "$t/$g.fmt"; } > "$t/$g.fmt2" && mv "$t/$g.fmt2" "$t/$g.fmt" ;; esac; } \
          && cmp -s "$t/$g.fmt" "$t/src/py/builtins_${g}_table.go" \
          && echo "runtime: builtins_${g}_table.go is ${g}_table.py's from the oracle's $g" || { echo "runtime: builtins_${g}_table.go DIFFERS from ${g}_table.py's"; rc=1; }
      done
      return $rc ;;
    gen-tables) shift; runtime_gen_tables "$@" ;;
    *) die "usage: bin/pyi runtime print|read|read-pytls|vet|check|programs|tables|gen-tables" ;;
  esac
}

# runtime_programs (runtime check's and runtime programs'): the programs of test/python/pyi run by bin/pyi run against the
# oracle's recorded runs (PYI_SMOKE_ONLY=REGEX a sample), then their controls (smoke_controls)
runtime_programs() {
  local n=0 bad=0 b p
  local -A gots=()
  for p in "$root"/test/python/pyi/*.py; do
    b=$(basename "$p")
    # PYI_SMOKE_ONLY=REGEX: the programs (and sessions) whose names match, a sample (queue 213); the controls'
    # subjects run with every selection (queue 235)
    [[ $b =~ ${PYI_SMOKE_ONLY:-.} ]] || smoke_control_subject smoke "$b" || continue
    n=$((n + 1))
    local want got
    want=$(smoke_want "$p") || { echo "  FAIL $b: no reference (the oracle's records)"; bad=$((bad + 1)); continue; }
    got=$(cd "$(dirname "$p")" && smoke_run "$root/bin/pyi" run "$b"); gots[$b]=$got
    smoke_verdict "$b" "$want" "$got" smoke || bad=$((bad + 1))
  done
  echo "runtime: $n programs of test/python/pyi run by pyi as by the oracle: $((n - bad)) equal"
  smoke_controls smoke gots || bad=$((bad + 1))
  [ $bad -eq 0 ]
}

# musl_src: musl 1.2.6's release tarball (test/c/corpora.edn's :musl-1.2.6, the C crop's pin) checked by its SHA-256 and
# extracted into $WORK/musl/musl-1.2.6 (queue 265: the runtime tables' libc headers and strerror table); the tarball from
# bin/lib/ci/musl's place, the main checkout's C1 fetch, or fetched; its directory printed
musl_src() {
  local d="$WORK/musl" m="$WORK/musl/musl-1.2.6" url sum tb cmain
  url=$(sed -n '/:musl-1.2.6/,/:top/s/^ *:url "\(.*\)"/\1/p' "$root/test/c/corpora.edn")
  sum=$(sed -n '/:musl-1.2.6/,/:top/s/^ *:sha256 "\(.*\)"/\1/p' "$root/test/c/corpora.edn")
  [ -f "$m/.pinned" ] && [ "$(cat "$m/.pinned")" = "$sum" ] && { echo "$m"; return 0; }
  cmain=${root%%/.tmp/gate-clean/*}; cmain=${cmain%%/.tmp/worktrees/*}
  tb=${CI_MUSL_TARBALL:-$root/.tmp/ci-musl/musl-1.2.6.tar.gz}
  [ -f "$tb" ] || tb=$cmain/.tmp/c1/musl/musl-1.2.6.tar.gz
  mkdir -p "$d"
  if [ ! -f "$tb" ]; then
    tb=$d/musl-1.2.6.tar.gz
    wget -q -O "$tb.part" "$url" || { rm -f "$tb.part"; die "musl: fetching $url failed"; }
    mv "$tb.part" "$tb"
  fi
  echo "$sum  $tb" | sha256sum -c --quiet >&2 || die "musl: $tb does not match test/c/corpora.edn's pin"
  rm -rf "$m"; tar -xzf "$tb" -C "$d" && echo "$sum" > "$m/.pinned"
  echo "$m"
}

# header_roots: tools/pyi/header-apks.sha256's apks (Alpine's python3, linux-headers and bluez-headers the oracle was built
# with, x86_64 and aarch64) checked by their SHA-256 (from REPR_PYTHON_SRC/ARCH/, the main checkout's copy, or the mirror)
# and their usr/include extracted into $WORK/header-apks/root-ARCH (queue 265: Linux's UAPI and BlueZ's headers; pyconfig.h no more, queue 357)
header_roots() {
  local pins="$root/tools/pyi/header-apks.sha256" d="$WORK/header-apks" mirror sha rel a f key m
  mirror=$(sed -n 's/^ *:mirror "\(.*\)"$/\1/p' "$root/test/python/corpora.edn" | head -1)
  key=$(grep -v '^#' "$pins" | sha256sum | cut -c1-64)
  m=${root%%/.tmp/gate-clean/*}; m=${m%%/.tmp/worktrees/*}
  if [ "$(cat "$d/.extracted" 2>/dev/null)" != "$key" ]; then
    rm -rf "$d/root-x86_64" "$d/root-aarch64"
    while read -r sha rel; do
      case $sha in '#'*|'') continue ;; esac
      a=${rel%%/*}; f="$d/$a/$(basename "$rel")"; mkdir -p "$d/$a"
      if [ ! -f "$f" ] || [ "$(sha256sum < "$f" | cut -c1-64)" != "$sha" ]; then
        if [ -n "${REPR_PYTHON_SRC:-}" ] && [ -f "$REPR_PYTHON_SRC/$a/$(basename "$rel")" ]; then cp "$REPR_PYTHON_SRC/$a/$(basename "$rel")" "$f.part"
        elif [ "$m" != "$root" ] && [ -f "$m/.tmp/repr-python/pyi/header-apks/$a/$(basename "$rel")" ]; then cp "$m/.tmp/repr-python/pyi/header-apks/$a/$(basename "$rel")" "$f.part"
        else local repo=${rel#*/}; repo=${repo%%/*}
             curl -fsSL -m 600 -o "$f.part" "$mirror/$repo/$a/$(basename "$rel")" || { rm -f "$f.part"; die "header apks: fetching $rel failed"; }
        fi
        mv "$f.part" "$f"
      fi
      [ "$(sha256sum < "$f" | cut -c1-64)" = "$sha" ] || die "$f: SHA-256 differs from tools/pyi/header-apks.sha256's (moving the pin is a recorded decision)"
      mkdir -p "$d/root-$a"
      tar --warning=no-unknown-keyword -xzf "$f" -C "$d/root-$a" usr/include 2>/dev/null || [ -d "$d/root-$a/usr/include" ] || die "$f: no usr/include"
    done < "$pins"
    echo "$key" > "$d/.extracted"
  fi
  echo "$d"
}

# the runtime tables Arbace makes (queue 265) and the sources the generator reads (CPython's tree: the negative controls'
# copies hold these)
RT_GEN_TABLES="opcode errno fcntl socket posix slotdocs ast bytecode bytecode315 opcode315 stat cjk unicodedata unicodedata315"
# queue 357: textsig (builtins_textsig_table.go from the tarball's C sources, every module's: about 2.5 minutes and 2 GB, its control as
# long) apart: gen-tables textsig, the --full step pyi-runtime-textsig; gen-tables --all both
# py-core-1124: docs (builtins_docs_table.go, the built-ins' __doc__) from the same reading, made with textsig in one run
RT_GEN_SLOW="textsig docs"
# rt_gen_file TABLE: the runtime's file a table is (queue 350: slotdocs is slotdocs.go)
rt_gen_file() { case $1 in slotdocs) echo slotdocs.go ;; stat) echo builtins_stat_table.go ;; bytecode) echo bytecode_table.go ;; bytecode315) echo bytecode_table315.go ;;
  *315) echo "builtins_${1%315}_table315.go" ;; *) echo "builtins_$1_table.go" ;; esac; }
# rt_gen_same TABLE GEN PRINTED: the generated table equal to the runtime's: byte for byte, but stat's, whose constants live in the
# hand-written builtins_stat.go (queue 357): its statConsts' "NAME": VALUE pairs, the generated file's the same set
rt_gen_same() {
  case $1 in
    stat) local p; p=$(dirname "$3")/builtins_stat.go
          cmp -s <(grep -o '"[A-Z_]*": *[0-9]*' "$2" | tr -d ' ' | LC_ALL=C sort) \
                 <(sed -n '/^var statConsts/,/^$/p' "$p" | grep -o '"[A-Z_]*": *[0-9]*' | tr -d ' ' | LC_ALL=C sort) ;;
    *) cmp -s "$2" "$3" ;;
  esac
}
# the 3.15.2 tree's files the 315 tables read (queue 357), copied for their controls
RT_GEN_CPY315="Include/opcode_ids.h Include/opcode.h Include/internal/pycore_opcode_metadata.h Include/internal/pycore_intrinsics.h
  Include/internal/pycore_ceval.h Python/intrinsics.c Python/ceval.c Modules/_opcode.c Lib/_opcode_metadata.py Include/patchlevel.h
  Objects/unicodetype_db.h Modules/unicodedata_db.h Modules/unicodename_db.h"
RT_GEN_CPY="Include/opcode_ids.h Include/opcode.h Include/internal/pycore_opcode_metadata.h Include/internal/pycore_intrinsics.h
  Include/internal/pycore_ceval.h Python/intrinsics.c Python/ceval.c Modules/_opcode.c Lib/_opcode_metadata.py Modules/errnomodule.c
  Modules/fcntlmodule.c Modules/socketmodule.c Modules/socketmodule.h Modules/posixmodule.c Objects/typeobject.c Parser/Python.asdl Include/patchlevel.h Modules/_stat.c configure.ac pyconfig.h.in
  Modules/cjkcodecs/mappings_cn.h Modules/cjkcodecs/mappings_hk.h Modules/cjkcodecs/mappings_jp.h Modules/cjkcodecs/mappings_jisx0213_pair.h
  Modules/cjkcodecs/mappings_kr.h Modules/cjkcodecs/mappings_tw.h Objects/unicodetype_db.h Modules/unicodedata_db.h Modules/unicodename_db.h"

# runtime_gen_tables [TABLE...] (queue 265): go/arbace/py's tables tools/pyi/*_table.py recorded from CPython's own modules,
# made by Arbace (tools/pyi/runtime_tables.ae on stage 0: the modules' C sources preprocessed by repr/c's preprocessor
# against the pinned headers) from the pinned CPython 3.14.10 tarball and musl 1.2.6's, gofmt'd by TamaGo's gofmt and
# compared with the printed runtime's file byte for byte; then each table's negative control (GTS81 (a)): the same
# generator over the sources with one fact changed (opcode: BINARY_OP's metadata without HAS_ARG_FLAG; errno: musl's
# strerror text of EPERM; fcntl: musl's F_ADD_SEALS; socket: musl's AI_NUMERICSERV; posix: musl's sysconf table's
# _SC_CLK_TCK) must differ from the committed file. fcntl, socket and posix also read configure.ac's answers (not Alpine's pyconfig.h, queue 357), Linux's and
# BlueZ's headers (header_roots, tools/pyi/header-apks.sha256) and Go's syscall (zerrors_linux_{amd64,arm64}.go: the
# names written syscall.NAME). No python3: the python3 generators are the oracle tier's
# (bin/pyi runtime tables, where the oracle runs live)
runtime_gen_tables() {
  local tables=("$@") t="$WORK/runtime-gen" top="$root/.tmp/repr-python/Python-3.14.10" musl rc=0 tb f
  [ "${tables[*]:-}" = --all ] && read -ra tables <<< "$RT_GEN_TABLES $RT_GEN_SLOW"
  [ ${#tables[@]} -gt 0 ] || read -ra tables <<< "$RT_GEN_TABLES"
  [ -d "$top/Lib" ] || env -u REPR_PYTHON_VERSION "$root/bin/repr-python" pins --fetch >/dev/null
  musl=$(musl_src) || return 1
  # the header apks only for the tables that read them (queue 350: opcode, errno and slotdocs run without them)
  local hr="" roots=()
  case " ${tables[*]} " in *" fcntl "*|*" socket "*|*" posix "*|*" textsig "*|*" docs "*)
    hr=$(header_roots) || return 1; roots=(--root-amd64 "$hr/root-x86_64" --root-arm64 "$hr/root-aarch64") ;; esac
  # queue 357: the 315 tables read 3.15.2's tree (extracted by REPR_PYTHON_VERSION=3.15 bin/repr-python pins --fetch); absent: said and
  # not judged, as ucd315_check
  local top315="$root/.tmp/repr-python/Python-3.15.2" g315=() kept=()
  for tb in "${tables[@]}"; do
    case $tb in *315)
      if [ ! -f "$top315/Include/patchlevel.h" ]; then echo "runtime: $(rt_gen_file "$tb") not judged: no 3.15.2 tree (REPR_PYTHON_VERSION=3.15 bin/repr-python pins --fetch)"; continue; fi
      g315=(--cpython315 "$top315") ;; esac
    kept+=("$tb")
  done
  tables=("${kept[@]}"); [ ${#tables[@]} -gt 0 ] || return 0
  rm -rf "$t"; mkdir -p "$t/out" "$t/ctl/out"; runtime_print "$t/src"
  gen() { (cd "$root" && ARBACE_PATH="$root" "$(arbace_exe)" "$root/tools/pyi/runtime_tables.ae" --cpython "$1" --musl "$2" \
             --goroot "${ARBACE_GOROOT:-/root/tamago-go}" "${roots[@]}" "${g315[@]}" "$3" "${@:4}") \
            2>&1 | { grep -v '^Reflection warning\|recur arg\|^Auto-boxing' || true; }; return "${PIPESTATUS[0]}"; }
  gen "$top" "$musl" "$t/out" "${tables[@]}" || return 1
  for tb in "${tables[@]}"; do
    f=$(rt_gen_file "$tb")
    tamago_go gofmt "$t/out/$f" > "$t/out/$f.fmt" || { rc=1; continue; }
    if rt_gen_same "$tb" "$t/out/$f.fmt" "$t/src/py/$f"; then
      if [ "$tb" = stat ]; then echo "runtime: $f is Arbace's from the pinned sources (tools/pyi/runtime_tables.ae stat), its constants builtins_stat.go's statConsts, name for name and value for value"
      else echo "runtime: $f is Arbace's from the pinned sources (tools/pyi/runtime_tables.ae $tb), byte for byte"; fi
    else
      echo "runtime: $f DIFFERS from Arbace's (diff $t/out/$f.fmt $t/src/py/$f)"; rc=1
    fi
  done
  # the controls: copies of the sources read, one fact changed in each
  local c="$t/ctl/cpython" m="$t/ctl/musl"
  for f in $RT_GEN_CPY; do mkdir -p "$c/$(dirname "$f")"; cp "$top/$f" "$c/$f"; done
  mkdir -p "$m/src"; cp -r "$musl/include" "$musl/arch" "$m/"; cp -r "$musl/src/." "$m/src/"
  # textsig reads the tree's C sources whole
  case " ${tables[*]} " in *" textsig "*)
    cp -r "$top/Objects" "$top/Python" "$top/Modules" "$top/Include" "$c/"
    sed -i 's|^"_abc_init(\$module, self, /)\\n"|"_abc_init($module, self2, /)\\n"|' "$c/Modules/clinic/_abc.c.h" ;; esac
  # docs (py-core-1124): bin()'s doc one word changed
  case " ${tables[*]} " in *" docs "*)
    [ -f "$c/Python/clinic/bltinmodule.c.h" ] || cp -r "$top/Objects" "$top/Python" "$top/Modules" "$top/Include" "$c/"
    sed -i 's|^"Return the binary representation of an integer.\\n"|"Return the binary form of an integer.\\n"|' "$c/Python/clinic/bltinmodule.c.h" ;; esac
  sed -i 's/^\(    \[BINARY_OP\] = { true, INSTR_FMT_IBC0000, \)HAS_ARG_FLAG | /\1/' "$c/Include/internal/pycore_opcode_metadata.h"
  sed -i 's/^E(EPERM, *"Operation not permitted")/E(EPERM, "Operation not allowed")/' "$m/src/errno/__strerror.h"
  sed -i 's/^#define F_ADD_SEALS\t1033$/#define F_ADD_SEALS\t1039/' "$m/include/fcntl.h"
  sed -i 's/^#define AI_NUMERICSERV  0x400$/#define AI_NUMERICSERV  0x800/' "$m/include/netdb.h"
  sed -i 's/^#define S_ISVTX 01000$/#define S_ISVTX 01001/' "$m/include/sys/stat.h"
  sed -i 's/^\t\t\[_SC_CLK_TCK\] = 100,$/\t\t[_SC_CLK_TCK] = 250,/' "$m/src/conf/sysconf.c"
  sed -i 's|^\(           "__repr__(\$self, /)\\n--\\n\\n\)Return repr(self).")|\1Return the repr(self).")|' "$c/Objects/typeobject.c"
  sed -i 's/^          | Return(expr? value)$/          | Return(expr value)/' "$c/Parser/Python.asdl"
  sed -i 's/^    \[LOAD_ATTR\] = 9,$/    [LOAD_ATTR] = 8,/' "$c/Include/internal/pycore_opcode_metadata.h"
  sed -i '3s/^12288,12289,/12288,12290,/' "$c/Modules/cjkcodecs/mappings_kr.h"
  sed -i 's/^#define UNIDATA_VERSION "16.0.0"$/#define UNIDATA_VERSION "16.0.1"/' "$c/Modules/unicodedata_db.h"
  if [ ${#g315[@]} -gt 0 ]; then
    local c315="$t/ctl/cpython315"
    for f in $RT_GEN_CPY315; do mkdir -p "$c315/$(dirname "$f")"; cp "$top315/$f" "$c315/$f"; done
    sed -i 's/^    \[BINARY_OP\] = 5,$/    [BINARY_OP] = 6,/' "$c315/Include/internal/pycore_opcode_metadata.h"
    sed -i 's/^#define UNIDATA_VERSION "17.0.0"$/#define UNIDATA_VERSION "17.0.1"/' "$c315/Modules/unicodedata_db.h"
    sed -i 's/^\(    \[BINARY_OP\] = { true, INSTR_FMT_IBC0000, \)HAS_ARG_FLAG | /\1/' "$c315/Include/internal/pycore_opcode_metadata.h"
    g315=(--cpython315 "$c315")
  fi
  gen "$c" "$m" "$t/ctl/out" "${tables[@]}" >/dev/null || { echo "control not judged: runtime gen-tables: the generator failed on the controls' sources"; return 1; }
  for tb in "${tables[@]}"; do
    f=$(rt_gen_file "$tb")
    tamago_go gofmt "$t/ctl/out/$f" > "$t/ctl/out/$f.fmt" 2>/dev/null
    if rt_gen_same "$tb" "$t/ctl/out/$f.fmt" "$t/src/py/$f"; then
      echo "control passed: runtime gen-tables $tb: a changed source made the committed table"; rc=1
    else
      echo "runtime gen-tables control $tb (one source fact changed): differs as it must"
    fi
  done
  return $rc
}

# py_spelling DIR (queue 375): the printed tables' headers in DIR respelled from their Arbace generator, "Code generated by
# tools/pyi/runtime_tables.ae (TABLE[ --suffix S]) from", to the python3 generator's that the oracle tier compares them with
# ("tools/pyi/TABLE_table.py[ --suffix S]"; cjk's cjkcodecs_table.py, ast's asdl_table.py; unicodedata_table.py names no suffix),
# the rest of each file byte for byte
py_spelling() {
  local f
  for f in "$1"/*.go; do
    grep -q '^// Code generated by tools/pyi/runtime_tables.ae (' "$f" || continue
    sed -i -E 's#^// Code generated by tools/pyi/runtime_tables\.ae \(cjk\) from #// Code generated by tools/pyi/cjkcodecs_table.py from #
               s#^// Code generated by tools/pyi/runtime_tables\.ae \(ast\) from #// Code generated by tools/pyi/asdl_table.py from #
               s#^// Code generated by tools/pyi/runtime_tables\.ae \(unicodedata( --suffix [0-9]+)?\) from #// Code generated by tools/pyi/unicodedata_table.py from #
               s#^// Code generated by tools/pyi/runtime_tables\.ae \(([a-z]+)( --suffix [0-9]+)?\) from #// Code generated by tools/pyi/\1_table.py\2 from #' "$f"
  done
}

# ucd315_check DIR (queue 237): DIR's builtins_unicodedata_table315.go (UCD 17.0.0, the 3.15 switch's) against
# unicodedata_table.py --suffix 315 over the 3.15.2 tarball's headers (extracted by REPR_PYTHON_VERSION=3.15
# bin/repr-python pins --fetch; absent: said and not judged), then its negative control (GTS81 (a)): 3.14.10's table
# judged against 3.15.2's headers must differ ("control passed" fails)
ucd315_check() {
  local dir=$1 top="$root/.tmp/repr-python/Python-3.15.2" c="$WORK/ucd315-control"
  [ -d "$top/Modules" ] || REPR_PYTHON_VERSION=3.15 "$root/bin/repr-python" pins --fetch >/dev/null 2>&1 || true
  if [ ! -f "$top/Modules/unicodedata_db.h" ]; then
    echo "runtime: builtins_unicodedata_table315.go not judged: no 3.15.2 tarball (REPR_PYTHON_VERSION=3.15 bin/repr-python pins --fetch)"
    return 0
  fi
  python3 -I -S -B "$root/tools/pyi/unicodedata_table.py" "$top" "$dir/builtins_unicodedata_table315.go" --check --suffix 315 \
    || { echo "runtime: builtins_unicodedata_table315.go DIFFERS from unicodedata_table.py --suffix 315's"; return 1; }
  rm -rf "$c"; mkdir -p "$c"
  sed 's/^\(\(const\|var\) [A-Za-z0-9]*\)\b/\1315/; s/^\t\([A-Za-z0-9]*\)\( *=\)/\t\1315\2/; s/^const ucdBlob = "/const ucdBlob315 = "/' \
    "$dir/builtins_unicodedata_table.go" > "$c/builtins_unicodedata_table315.go"
  if python3 -I -S -B "$root/tools/pyi/unicodedata_table.py" "$top" "$c/builtins_unicodedata_table315.go" --check --suffix 315 >/dev/null 2>&1; then
    echo "control passed: ucd315: 3.14.10's table judged equal to 3.15.2's headers"; return 1
  fi
  echo "control failed as it must: ucd315: 3.14.10's table against 3.15.2's headers"
}

# bc_tables_check DIR (queue 238): the bytecode view's tables in DIR against their generators: bytecode_table.go
# (bytecode_table.py over 3.14.10's headers), bytecode_table315.go (--suffix 315 over 3.15.2's, 3.14.10's the base) and,
# where the 3.15.2 oracle runs, builtins_opcode_table315.go (opcode_table.py --suffix 315 run by it); the negative
# controls: 3.14.10's headers (and python3's _opcode) made into a 3.15 table must differ from the committed one.
bc_tables_check() {
  local dir=$1 a="$root/.tmp/repr-python/Python-3.14.10" b="$root/.tmp/repr-python/Python-3.15.2" c="$WORK/bc-tables" o rc=0
  rm -rf "$c"; mkdir -p "$c"
  python3 -I -S -B "$root/tools/pyi/bytecode_table.py" "$a" "$c/t314.go" && tamago_go gofmt "$c/t314.go" > "$c/t314f.go" \
    && cmp -s "$c/t314f.go" "$dir/bytecode_table.go" \
    && echo "runtime: bytecode_table.go is bytecode_table.py's from 3.14.10's headers" || { echo "runtime: bytecode_table.go DIFFERS"; rc=1; }
  [ -d "$b/Include" ] || REPR_PYTHON_VERSION=3.15 "$root/bin/repr-python" pins --fetch >/dev/null 2>&1 || true
  if [ ! -f "$b/Include/opcode_ids.h" ]; then
    echo "runtime: bytecode_table315.go not judged: no 3.15.2 tarball (REPR_PYTHON_VERSION=3.15 bin/repr-python pins --fetch)"
    return $rc
  fi
  python3 -I -S -B "$root/tools/pyi/bytecode_table.py" "$b" "$c/t315.go" --suffix 315 --base "$a" && tamago_go gofmt "$c/t315.go" > "$c/t315f.go" \
    && cmp -s "$c/t315f.go" "$dir/bytecode_table315.go" \
    && echo "runtime: bytecode_table315.go is bytecode_table.py --suffix 315's from 3.15.2's headers" || { echo "runtime: bytecode_table315.go DIFFERS"; rc=1; }
  python3 -I -S -B "$root/tools/pyi/bytecode_table.py" "$a" "$c/x315.go" --suffix 315 --base "$a" && tamago_go gofmt "$c/x315.go" > "$c/x315f.go"
  if cmp -s "$c/x315f.go" "$dir/bytecode_table315.go"; then
    echo "control passed: bc315: 3.14.10's headers judged equal to bytecode_table315.go"; rc=1
  else
    echo "control failed as it must: bc315: 3.14.10's headers against bytecode_table315.go"
  fi
  o=$(oracle315)
  if [ ! -x "$o" ]; then
    echo "runtime: builtins_opcode_table315.go not judged: no 3.15.2 oracle at $o (REPR_PYTHON_ORACLE_315)"
    return $rc
  fi
  "$o" -I -S -B "$root/tools/pyi/opcode_table.py" "$c/o315.go" --suffix 315 && tamago_go gofmt "$c/o315.go" > "$c/o315f.go" \
    && cmp -s "$c/o315f.go" "$dir/builtins_opcode_table315.go" \
    && echo "runtime: builtins_opcode_table315.go is opcode_table.py --suffix 315's run by the 3.15.2 oracle" || { echo "runtime: builtins_opcode_table315.go DIFFERS"; rc=1; }
  python3 -I -S -B "$root/tools/pyi/opcode_table.py" "$c/y315.go" --suffix 315 && tamago_go gofmt "$c/y315.go" > "$c/y315f.go"
  if sed 1d "$c/y315f.go" | cmp -s - <(sed 1d "$dir/builtins_opcode_table315.go"); then
    echo "control passed: opcode315: python3's _opcode judged equal to builtins_opcode_table315.go"; rc=1
  else
    echo "control failed as it must: opcode315: python3's _opcode against builtins_opcode_table315.go"
  fi
  return $rc
}

# smoke_key FILE: a smoke program's or session's key: its bytes and test/python/pyi's subdirectories' files (the data it reads)
smoke_key() { pyrec_key "$1" $(find "$root/test/python/pyi" -mindepth 2 -type f | LC_ALL=C sort); }
smoke_cpython() { (cd "$(dirname "$1")" && smoke_run python3 -I "$(basename "$1")"); }
smoke_want() { pyrec_outcome "smoke/$(basename "$1")" "$(smoke_key "$1")" smoke_cpython "$1"; }
# smoke_verdict NAME WANT GOT KIND (queue 235, 230's low): "pass NAME", or "FAIL NAME", the outputs' first differing lines
# (at most 10) and then, never cut off, each side's status (124: the 120 s or 300 s timeout) and stderr's last line, so a
# timeout, a crash and a wrong output are told apart; KIND smoke (stdout, "status N", "stderr LINE") or repl (stdout,
# "status N", the whole stderr)
smoke_verdict() {
  local name=$1 want=$2 got=$3 kind=$4
  if [ "$want" = "$got" ]; then echo "  pass $name"; return 0; fi
  echo "  FAIL $name"
  { diff <(echo "$want") <(echo "$got") | head -10 || true; } | sed 's/^/    /'
  echo "    want: $(smoke_tail "$kind" "$want")"
  echo "    got:  $(smoke_tail "$kind" "$got")"
  return 1
}
# smoke_tail KIND OUTCOME: the outcome's status (with "timeout" for 124) and stderr's last line, on one line
smoke_tail() {
  local st err
  if [ "$1" = smoke ]; then st=$(tail -n 2 <<< "$2" | head -n 1); err=$(tail -n 1 <<< "$2")
  else st=$(grep '^status [0-9]*$' <<< "$2" | tail -n 1); err="stderr $(sed -n '/^status [0-9]*$/,$p' <<< "$2" | tail -n +2 | grep . | tail -n 1)"; fi
  [ "$st" = "status 124" ] && st="status 124 (timeout)"
  echo "${st:-no status line}; ${err:0:200}"
}
# The runtime check's negative controls (GTS81 (a), queue 235): test/python/controls-runtime.edn's crossed pairs, the subject's
# run by pyi (a smoke program's, a REPL session's) judged by the check's own judge, string equality, against the reference's
# outcome by the oracle, which must differ. "control passed:" or "control not judged:" fails the check; the subjects run with
# every PYI_SMOKE_ONLY selection. No control is a program or session of the counts. PYI_RUNTIME_CONTROLS another file.
RUNTIME_CONTROLS="${PYI_RUNTIME_CONTROLS:-$root/test/python/controls-runtime.edn}"
smoke_control_pairs() {  # KIND: "ID SUBJECT REFERENCE" lines of the controls of that family
  sed -n 's/.*:id "\([^"]*\)" :family :'"$1"' :subject "\([^"]*\)" :reference "\([^"]*\)".*/\1 \2 \3/p' "$RUNTIME_CONTROLS"
}
smoke_control_subject() { smoke_control_pairs "$1" | awk -v s="$2" '$2 == s { f = 1 } END { exit !f }'; }
# smoke_controls KIND GOTS: each control of KIND judged; GOTS the name of the associative array of the subjects' runs
smoke_controls() {
  local kind=$1 id s r want bad=0 n=0; local -n runs=$2
  [ -f "$RUNTIME_CONTROLS" ] || { echo "control not judged: $kind: no $RUNTIME_CONTROLS"; return 1; }
  while read -r id s r; do
    n=$((n + 1))
    if [ -z "${runs[$s]+x}" ]; then echo "control not judged: $kind $id: $s not run"; bad=1; continue; fi
    if [ "$kind" = smoke ]; then want=$(smoke_want "$root/test/python/pyi/$r") || { echo "control not judged: $kind $id: no reference for $r"; bad=1; continue; }
    else want=$(repl_want "$root/test/python/pyi/$r") || { echo "control not judged: $kind $id: no reference for $r"; bad=1; continue; }; fi
    if [ "$want" = "${runs[$s]}" ]; then echo "control passed: $kind $id: $s's run judged equal to $r's reference"; bad=1
    else echo "control failed as it must: $kind $id: $s's run against $r's reference"; fi
  done < <(smoke_control_pairs "$kind")
  [ $n -gt 0 ] || { echo "control not judged: $kind: no control in $RUNTIME_CONTROLS"; bad=1; }
  [ $bad = 0 ]
}
# smoke_run CMD...: the run's stdout, its exit status and stderr's last line, for comparing pyi with the oracle
smoke_run() {
  local o e rc=0
  o=$(mktemp "$WORK/smoke.XXXXXX"); e=$(mktemp "$WORK/smoke.XXXXXX")
  timeout 120 env HOME="$WORK" TMPDIR="$WORK" "$@" > "$o" 2> "$e" || rc=$?
  cat "$o"; echo "status $rc"; echo "stderr $(tail -n 1 "$e")"
  rm -f "$o" "$e"
}

# c2j_check (queue 206): arbace/python's and arbace/repr/python's namespaces compiled by c2j (arbace.c2j.main/run over
# the units ARBACE_COMPILE records), no j2g and no Go build, as bin/lib/ci/c2j-check does for ci and repr/c. ARBACE_NO_AOT=1
# and the rest as there: once the namespaces are embedded compiled (PYS28's re-seed) their compiled loaders would record
# no units; every source is analyzed afresh. The negative control (GTS81 (a)): test/python/c2j/pyi/c2j_control.ae, a macro
# expanding to an evaluated fn that closes over a local; c2j must refuse it with "a fn closing over locals as a constant", else
# the check fails. The log: .tmp/repr-python/pyi/c2j/compile.log.
cmd_c2j_check() {
  [ $# = 0 ] || die "usage: bin/pyi c2j-check"
  local w="$WORK/c2j" nss n f ctl=test/python/c2j/pyi/c2j_control.ae
  rm -rf "$w"; mkdir -p "$w"
  nss=$(for f in arbace/python.ae arbace/python/*.ae arbace/repr/python.ae arbace/repr/python/*.ae; do echo "$f"; done \
          | sed 's/\.ae$//; s|/|.|g; s/_/-/g' | tr '\n' ' ')
  n=$(echo $nss | wc -w)
  cat > "$w/compile.ae" <<A
(doseq [n (quote [$nss pyi.c2j-control])]
  (try (require n) (catch Throwable e (println "c2j-check: not loaded:" n (.getMessage e)))))
(require (quote arbace.c2j.main))
(let [ours? (fn [^String s] (or (.startsWith s "arbace/python/") (.startsWith s "arbace/repr/python/")
                                (= s "arbace/python.ae") (= s "arbace/repr/python.ae") (= s "pyi/c2j_control.ae")))
      srcs (vec (distinct (filter ours? (map #(aget ^objects % 0) (arbace.lang.Compiler\$AST/units)))))
      r (arbace.c2j.main/run "$w/out" srcs)
      ctl "pyi/c2j_control.ae"
      failed (dissoc (:failed r) ctl)
      compiled (remove #{ctl} (:compiled r))]
  (doseq [[s m] failed] (println "c2j-check: not compiled:" s m))
  (println "c2j-check:" (+ (count compiled) (count failed)) "namespaces:" (count compiled) "compiled," (count failed) "failed;" (:classes r) "classes")
  (let [m (get (:failed r) ctl)]
    (println "c2j-check: negative control" ctl
             (cond (nil? m) (if (some #{ctl} (:compiled r)) "compiled: control passed" "not loaded: control not judged")
                   (.contains ^String m "a fn closing over locals as a constant") "refused, as it must"
                   :else (str "refused with another message: control not judged: " m))))
  (shutdown-agents)
  (System/exit 0))
A
  local host t0=$SECONDS; host=$(arbace_exe)
  GOMEMLIMIT=${GOMEMLIMIT:-$("$root/bin/gate-policy" mem 3GiB)} GOGC=200 ARBACE_COMPILE=1 ARBACE_NO_AOT=1 ARBACE_NO_IMAGE=1 ARBACE_PATH_FIRST=1 \
    ARBACE_PATH="$root:$root/test/python/c2j" ARBACE_AOT_ROOT="$root" ARBACE_PREPARE="$w/compile.image" \
    "$host" "$w/compile.ae" > "$w/compile.log" 2>&1 || { tail -20 "$w/compile.log" >&2; die "c2j-check: the host failed (the log: $w/compile.log)"; }
  grep '^c2j-check:' "$w/compile.log" || true
  echo "c2j-check: $((SECONDS - t0)) s"
  grep -q "^c2j-check: not loaded:" "$w/compile.log" && die "c2j-check: a namespace did not load"
  grep -q "^c2j-check: $n namespaces: $n compiled, 0 failed;" "$w/compile.log" || die "c2j-check: FAILED (expected $n namespaces, all compiled)"
  grep -q "^c2j-check: negative control .* refused, as it must$" "$w/compile.log" || die "c2j-check: the negative control FAILED"
  echo "c2j-check: ok ($n namespaces, the negative control refused)"
}

# table_check (queue 214): pyi's runtime in goi's table, checked on stage 0 (test/python/table_check.ae)
cmd_table_check() {
  local w="$WORK/table" configs=linux/amd64,linux/arm64,tamago/amd64,tamago/arm64 tables= args=() c host t0=$SECONDS
  while [ $# -gt 0 ]; do
    case $1 in
      --configs) configs=$2; shift 2 ;;
      --tables) tables=--tables; shift ;;
      *) die "usage: bin/pyi table-check [--configs C,...] [--tables]" ;;
    esac
  done
  rm -rf "$w"; mkdir -p "$w"
  host=$(arbace_exe)
  for c in ${configs//,/ }; do
    case $c in
      tamago/amd64|tamago/arm64) args+=(--config "$c=$root/tamago/goroot,$root/tamago/goroot/arch/${c#tamago/}") ;;
      linux/amd64|linux/arm64)
        # the linux configurations' std forms as bin/goi table converts them (bin/goi table-configs: embed-gaps', OC170)
        local cfgs; cfgs=$(ARBACE_HOST_EXE=$host "$root/bin/goi" table-configs) \
          || die "table-check: $c needs bin/goi table-configs (embed-gaps, OC170); --configs tamago/amd64,tamago/arm64 without it"
        args+=(--config "$(printf '%s\n' "$cfgs" | grep "^$c=")") ;;
      *) die "table-check: no configuration $c" ;;
    esac
  done
  (cd "$root" && ARBACE_PATH="$root" GOMEMLIMIT=${PYI_TABLE_GOMEMLIMIT:-$("$root/bin/gate-policy" mem 4GiB)} \
     "$host" "$root/test/python/table_check.ae" "$root/go/arbace/gotable.edn" "$w/out" arbace/libm,arbace/py,arbace/crt,arbace/ci,arbace/clib,arbace/pyctypes,arbace/clib/worlds,arbace/pybz2,arbace/pylzma,arbace/pyzstd \
       "${args[@]}" $tables) 2>&1 | { grep -v '^Reflection warning\|recur arg\|^Auto-boxing' || true; } | tee "$w/table-check.log"
  local rc=${PIPESTATUS[0]}
  echo "table-check: $((SECONDS - t0)) s"
  return "$rc"
}

# ---- wheels (queue 205; survey "As built: 205", PYS23-PYS25 (a)) ----
# the pins test/python/wheels.edn; the wheels fetched once into WHEELS_CACHE/wheels (the one network step), the site
# WHEELS_CACHE/site-KEY (lib/, bin/) built from the cache alone by arbace.python.wheels (no pip, no Python)
WHEELS_PINS="${PYI_WHEELS_PINS:-$root/test/python/wheels.edn}"
WHEELS_CACHE="${REPR_PYTHON_SRC:-$root/.tmp/repr-python}"

wheels_arbace() { ARBACE_PATH="$root" "$(arbace_exe)" -m arbace.python.wheels "$@"; }

# the site's directory: KEY the first 20 characters of the SHA-256 of the pins and the installer's source
wheels_site() {
  local key; key=$(cat "$WHEELS_PINS" "$root/arbace/python/wheels.ae" | sha256sum | cut -c1-20)
  echo "$WHEELS_CACHE/site-$key"
}

# the suites' site (queue 232): the pins' :test-wheels (pytest and its dependencies), site-test-KEY beside the site
wheels_test_site() {
  local key; key=$(cat "$WHEELS_PINS" "$root/arbace/python/wheels.ae" | sha256sum | cut -c1-20)
  echo "$WHEELS_CACHE/site-test-$key"
}

# wheels_fetch_one SUBDIR FILE URL SHA256 BYTES: one pinned file into WHEELS_CACHE/SUBDIR unless it is there as pinned;
# 0 when fetched, 1 when cached already
wheels_fetch_one() {
  local sub=$1 file=$2 url=$3 sha=$4 bytes=$5 f="$WHEELS_CACHE/$1/$2"
  mkdir -p "$WHEELS_CACHE/$sub"
  if [ -f "$f" ] && [ "$(sha256sum < "$f" | cut -c1-64)" = "$sha" ]; then return 1; fi
  rm -f "$f.part.$$"
  # GTS212 (a), queue 212: a worktree's or the clean clone's file from the main checkout's cache when it holds it
  local m=${root%%/.tmp/gate-clean/*}; m=${m%%/.tmp/worktrees/*}
  if [ -z "${REPR_PYTHON_SRC:-}" ] && [ "$m" != "$root" ] && [ -f "$m/.tmp/repr-python/$sub/$file" ]; then
    cp "$m/.tmp/repr-python/$sub/$file" "$f.part.$$"
  else
    curl -fsSL --retry 2 -o "$f.part.$$" "$url" || { rm -f "$f.part.$$"; die "wheels fetch: $url failed"; }
  fi
  [ "$(sha256sum < "$f.part.$$" | cut -c1-64)" = "$sha" ] && [ "$(stat -c %s "$f.part.$$")" = "$bytes" ] \
    || { rm -f "$f.part.$$"; die "wheels fetch: $file's SHA-256 or size is not the pin's (moving a pin is a recorded decision)"; }
  mv "$f.part.$$" "$f"
}

# the pins' wheels and test wheels into WHEELS_CACHE/wheels, the suites' source archives into WHEELS_CACHE/sdists
wheels_fetch() {
  local file url sha bytes rest name n=0 got=0 ns=0
  while IFS=$'\t' read -r file url sha bytes rest; do
    n=$((n + 1)); if wheels_fetch_one wheels "$file" "$url" "$sha" "$bytes"; then got=$((got + 1)); fi
  done < <(wheels_arbace list --pins "$WHEELS_PINS"; wheels_arbace list --pins "$WHEELS_PINS" --set test-wheels)
  while IFS=$'\t' read -r name file url sha bytes rest; do
    ns=$((ns + 1)); if wheels_fetch_one sdists "$file" "$url" "$sha" "$bytes"; then got=$((got + 1)); fi
  done < <(wheels_arbace suites --pins "$WHEELS_PINS")
  echo "wheels fetch: $n pinned wheels in $WHEELS_CACHE/wheels, $ns suites' sources in $WHEELS_CACHE/sdists ($got fetched)"
}

# wheels_cmp NAME A B: two runs' stdout, status and stderr's last line
wheels_cmp() {
  local a=$1 b=$2
  if cmp -s "$a.out" "$b.out" && [ "$(cat "$a.rc")" = "$(cat "$b.rc")" ] \
     && [ "$(grep -v '^[[:space:]]*$' "$a.err" | tail -1)" = "$(grep -v '^[[:space:]]*$' "$b.err" | tail -1)" ]; then return 0; fi
  { diff "$a.out" "$b.out" | head -10; echo "  status $(cat "$a.rc") / $(cat "$b.rc")"; tail -n 2 "$a.err" "$b.err"; } | sed 's/^/    /'
  return 1
}

# the oracle's side: python3 -I -S, sys.path [the program's directory, the stdlib, the site's lib]: python3 -c "$WHEELS_RUNPY"
# FILE SITE ARGS...
export WHEELS_RUNPY='import os, runpy, sys
f, site = sys.argv[1], sys.argv[2]
sys.path.insert(0, os.path.dirname(f)); sys.path.append(site); sys.argv = [f] + sys.argv[3:]
runpy.run_path(f, run_name="__main__")'

# wheels_run_cpython NAME KEY OUT CMD...: CPython's run as OUT.out, OUT.err (its last line) and OUT.rc, live or recorded
# (queue 213): the outcome's text is "rc N", "err LAST-LINE", then stdout; the site's directory is @WHEELS in the record
wheels_run_cpython() {
  local name=$1 key=$2 text rc=0; WHEELS_RUN_O=$3; shift 3
  # (WHEELS_RUN_O, not a local: pyrec_outcome has an o of its own, and bash scopes dynamically)
  wheels_run_enc() { local rc=0; "$@" > "$WHEELS_RUN_O.out" 2> "$WHEELS_RUN_O.err" || rc=$?
    echo "rc $rc"; echo "err $(grep -v '^[[:space:]]*$' "$WHEELS_RUN_O.err" | tail -1)"; sed "s|$WHEELS_CACHE|@WHEELS|g" "$WHEELS_RUN_O.out"; }
  text=$(pyrec_outcome "$name" "$key" wheels_run_enc "$@"; echo .) || true
  [ "${text:0:3}" = "rc " ] || { echo 1 > "$WHEELS_RUN_O.rc"; echo "no reference (the oracle's records): ${text%.}" > "$WHEELS_RUN_O.err"; : > "$WHEELS_RUN_O.out"; return 0; }
  text=${text%.}
  sed -n '1s/^rc //p' <<< "$text" > "$WHEELS_RUN_O.rc"
  sed -n '2s/^err //p' <<< "$text" > "$WHEELS_RUN_O.err"
  tail -n +3 <<< "$text" | sed "s|@WHEELS|$WHEELS_CACHE|g" | head -c -1 > "$WHEELS_RUN_O.out"
}

# wheels_layout LIB BIN: a tree's layout as lines: "file PATH SHA256" (but INSTALLER, RECORD, REQUESTED, direct_url.json and
# LIB/bin), "record DIST ROW" (each RECORD's rows but those files' and ../, sorted, without \r), "bin NAME"
wheels_layout() {
  local lib=$1 bin=$2 r skip='/(INSTALLER|RECORD|REQUESTED|direct_url\.json),|^\.\./'
  (cd "$lib" && find . -type f ! -name INSTALLER ! -name RECORD ! -name REQUESTED ! -name direct_url.json ! -path './bin/*' \
     | sed 's|^\./||' | LC_ALL=C sort | while IFS= read -r r; do echo "file $r $(sha256sum < "$r" | cut -c1-64)"; done)
  for r in "$lib"/*.dist-info/RECORD; do
    [ -f "$r" ] || continue
    tr -d '\r' < "$r" | grep -Ev "$skip" | LC_ALL=C sort | sed "s|^|record $(basename "$(dirname "$r")") |"
  done
  [ -d "$bin" ] && ls "$bin" | LC_ALL=C sort | sed 's/^/bin /'
  return 0
}
# wheels_pip_layout DIR WHEEL...: CPython's pip --target DIR over the wheels, its layout
wheels_pip_layout() {
  local d=$1; shift
  python3 -I -m pip --version >/dev/null 2>&1 || { echo "no pip for python3"; return 1; }
  rm -rf "$d"
  python3 -I -m pip install -q --no-index --no-deps --no-compile --disable-pip-version-check --root-user-action=ignore \
    --target "$d" "$@" > "$d.log" 2>&1 || { echo "pip failed: $(tail -1 "$d.log")"; return 1; }
  wheels_layout "$d" "$d/bin"
}

wheels_check() {
  local site W="$WORK/wheels" T="$root/test/python/wheels" bad=0 n=0 file url sha bytes sample script only=("$@")
  site=$(wheels_site)
  wheels_arbace install --pins "$WHEELS_PINS" --cache "$WHEELS_CACHE/wheels" --site "$site" || return 1
  wheels_arbace verify --pins "$WHEELS_PINS" --cache "$WHEELS_CACHE/wheels" --site "$site" || return 1
  rm -rf "$W"; mkdir -p "$W/runs"
  # the layout against the host CPython's pip on the same wheels (all at once: their bin/ is one directory): pip's tree as a
  # listing (wheels_layout), live or recorded (queue 213), against the site's
  local -a whls=()
  while IFS=$'\t' read -r file url sha bytes sample script; do whls+=("$WHEELS_CACHE/wheels/$file"); done < <(wheels_arbace list --pins "$WHEELS_PINS")
  if pyrec_outcome wheels/layout "$(pyrec_key "$WHEELS_PINS")" wheels_pip_layout "$W/pip" "${whls[@]}" > "$W/layout.pip"; then
    wheels_layout "$site/lib" "$site/bin" > "$W/layout.site"
    if diff "$W/layout.pip" "$W/layout.site" > "$W/layout.diff"; then
      echo "  layout: lib/ as pip --target lays it out, $(grep -c '^record ' "$W/layout.site") RECORD rows equal; scripts $(ls "$site/bin" | tr '\n' ' ')"
    else echo "  layout: differs from pip --target's (< pip's, > the site's):"; head -10 "$W/layout.diff" | sed 's/^/    /'; bad=1; fi
  else echo "  layout: pip's not known: $(tail -1 "$W/layout.pip")"; bad=1; fi
  # each pin's sample, and its console script, by pyi and by CPython with the same site
  while IFS=$'\t' read -r file url sha bytes sample script; do
    if [ ${#only[@]} -gt 0 ] && ! printf '%s\n' "${only[@]}" | grep -qx "${file%%-*}"; then continue; fi
    if [ "$sample" != - ]; then
      n=$((n + 1)); local r="$W/runs/${sample%.py}" c="$W/runs/${sample%.py}.cpython" t0=$SECONDS
      mkdir -p "$r.d" "$c.d"
      wheels_run_cpython "wheels/$sample" "$(pyrec_key "$WHEELS_PINS" "$T/$sample")" "$c" \
        bash -c 'cd "$1" && shift && PYTHONHASHSEED=0 LC_ALL=C.UTF-8 TZ=UTC python3 -I -S -B -c "$WHEELS_RUNPY" "$@"' - "$c.d" "$T/$sample" "$site/lib"
      (cd "$r.d" && PYTHONHASHSEED=0 LC_ALL=C.UTF-8 TZ=UTC PYI_SITE="$site/lib" "$root/bin/pyi" run "$T/$sample" > "$r.out" 2> "$r.err"; echo $? > "$r.rc") || true
      if wheels_cmp "$c" "$r"; then echo "  pass $sample ($(wc -l < "$r.out") lines, $((SECONDS - t0)) s)"; else echo "  FAIL $sample"; bad=1; fi
    fi
    if [ "$script" != - ]; then
      local name=${script%% *} args=(); [[ $script != *" "* ]] || read -ra args <<< "${script#* }"
      local r="$W/runs/script-$name" c="$W/runs/script-$name.cpython" mod attr
      mod=$(sed -n "s/^${name}[[:space:]]*=[[:space:]]*\([^: ]*\):.*/\1/p" "$site/lib/"*.dist-info/entry_points.txt | head -1)
      attr=$(sed -n "s/^${name}[[:space:]]*=[[:space:]]*[^:]*:\([A-Za-z0-9_.]*\).*/\1/p" "$site/lib/"*.dist-info/entry_points.txt | head -1)
      wheels_run_cpython "wheels/script-$name" "$(pyrec_key "$WHEELS_PINS")" "$c" \
        bash -c 'cd "$1" && shift && PYTHONHASHSEED=0 python3 -I -S -B -c "$@"' - "$T" "import sys; sys.path.append(sys.argv.pop(1)); sys.argv[0] = '$name'
from $mod import ${attr%%.*}; sys.exit($attr())" "$site/lib" "${args[@]}"
      (cd "$T" && PYTHONHASHSEED=0 PYI_EXECUTABLE="$root/tools/pyi/python3" "$site/bin/$name" "${args[@]}" > "$r.out" 2> "$r.err"; echo $? > "$r.rc") || true
      if wheels_cmp "$c" "$r"; then echo "  pass the console script $name ${args[*]} (status $(cat "$r.rc"))"; else echo "  FAIL the console script $name"; bad=1; fi
    fi
  done < <(wheels_arbace list --pins "$WHEELS_PINS")
  # the negative controls: a platform wheel and a wheel whose RECORD digest is wrong, each refused, nothing installed
  local six; six=$(printf '%s\n' "${whls[@]}" | grep '/six-' | head -1)
  mkdir -p "$W/controls"
  cp "$six" "$W/controls/six-1.17.0-cp314-cp314-linux_x86_64.whl"
  # six.py with a line appended, its RECORD digest left (zip, not python3: queue 213)
  cp "$six" "$W/controls/six-1.17.0-py3-none-any.whl"; mkdir -p "$W/controls/t"
  unzip -p "$six" six.py > "$W/controls/t/six.py"; echo "# tampered" >> "$W/controls/t/six.py"
  (cd "$W/controls/t" && zip -q "$W/controls/six-1.17.0-py3-none-any.whl" six.py)
  local w want
  for w in "six-1.17.0-cp314-cp314-linux_x86_64.whl:are not py3-none-any" "six-1.17.0-py3-none-any.whl:differs from RECORD"; do
    want=${w#*:}; w=${w%%:*}
    if wheels_arbace install-one --wheel "$W/controls/$w" --site "$W/controls/site-${want// /-}" > "$W/controls/out" 2>&1; then
      echo "  FAIL control: $w installed"; bad=1
    elif grep -q "$want" "$W/controls/out"; then echo "  control refused: $(grep 'pyi wheels:' "$W/controls/out" | sed "s|$W/controls/||")"
    else echo "  FAIL control: $w refused otherwise: $(tail -1 "$W/controls/out")"; bad=1; fi
  done
  if [ $bad = 0 ]; then echo "wheels check: ${#whls[@]} pinned wheels installed by arbace.python.wheels into $site and verified; $n samples equal to CPython's; 2 controls refused"
  else echo "wheels check: FAILED (runs in $W/runs)"; return 1; fi
}

# pip on pyi, a check (PYS24 (a), queue 207): the apks' pip 26.2.1 alone on sys.path, run by pyi (PYI_SITE) and by
# python3 -I -S -B with the same argv and directories: pip --version, pip list, pip install --no-index --no-deps
# --no-compile --target DIR WHEEL for each pinned wheel, pip install --no-index --find-links CACHE --no-compile --target
# DIR for the pins' names, pip list --path DIR; each run's status, stdout and stderr equal to CPython's, each installed
# tree equal file for file (RECORD, dist-info, files), but the classed differences:
# - stderr's "WARNING: Disabling truststore since ssl support is missing" (pyi has no _ssl, class :ssl, queue 209's
#   module: pip's truststore, the system's trust store, is used by no offline verb);
# - a console script's first line, #! and the run's sys.executable, and its RECORD row's digest and size, which follow it.
# --no-compile on both sides: pyi compiles to __pycache__/NAME.arbace-314.pyc, its own code (class :pyc-magic), where
# CPython writes NAME.cpython-314.pyc (the RECORD rows of both without digest, as pip writes them).
pip_run() { # SIDE NAME ARGS...: SIDE pyi or cpython; NAME.out .err .rc in $W/SIDE
  local side=$1 n=$2 rc=0; shift 2
  case $side in
    pyi) (cd "$W" && PYI_SITE="$W/path" "$root/bin/pyi" python -m pip "$@") > "$W/$side/$n.out" 2> "$W/$side/$n.err" || rc=$? ;;
    cpython) (cd "$W" && python3 -I -S -B -c 'import runpy, sys
sys.path.insert(0, sys.argv.pop(1)); sys.argv[0] = "pip"
runpy.run_module("pip", run_name="__main__", alter_sys=True)' "$W/path" "$@") > "$W/$side/$n.out" 2> "$W/$side/$n.err" || rc=$? ;;
  esac
  echo $rc > "$W/$side/$n.rc"
}

# pip_tree DIR EXE: DIR's files, each a line "PATH SHA256", a console script's first line checked to be #!EXE and left
# out, its RECORD row (csv's lines, \r\n) without digest and size
pip_tree() {
  local d=$1 exe=$2 f
  [ -d "$d" ] || { echo "(no tree)"; return; }
  (cd "$d" && find . -type f | LC_ALL=C sort | while read -r f; do
    case $f in
      ./bin/*) if [ "$(head -1 "$f")" = "#!$exe" ]; then echo "$f $(tail -n +2 "$f" | sha256sum | cut -c1-64) (#! the run's)"
               else echo "$f its first line $(head -1 "$f"), not #!$exe"; fi ;;
      */RECORD) echo "$f $(sed -E 's|^(\.\./\.\./bin/[^,]*),[^,]*,[0-9]*(\r?)$|\1,(the run'"'"'s),\2|' "$f" | sha256sum | cut -c1-64)" ;;
      *) echo "$f $(sha256sum < "$f" | cut -c1-64)" ;;
    esac
  done)
}

wheels_pip_probe() {
  need_python "wheels pip-probe (CPython's pip beside pyi's: the oracle tier's)"
  local W="$WORK/wheels/pip-probe" sp="$root/.tmp/repr-python/site-packages/$(uname -m)/usr/lib/python3.14/site-packages"
  [ -d "$sp/pip" ] || env -u REPR_PYTHON_VERSION "$root/bin/repr-python" pins --fetch >/dev/null
  rm -rf "$W"; mkdir -p "$W/path" "$W/pyi" "$W/cpython"; ln -s "$sp/pip" "$W/path/pip"
  local whls=() names=() file url sha bytes rest
  while IFS=$'\t' read -r file url sha bytes rest; do
    [ -f "$WHEELS_CACHE/wheels/$file" ] || die "wheels pip-probe: run bin/pyi wheels fetch first ($file)"
    whls+=("$WHEELS_CACHE/wheels/$file"); names+=("${file%%-*}")
  done < <(wheels_arbace list --pins "$WHEELS_PINS")
  local o=(--disable-pip-version-check) i=(--no-index --no-compile --disable-pip-version-check --root-user-action=ignore)
  local runs=() side w n
  for side in cpython pyi; do
    pip_run $side version --version
    pip_run $side list list "${o[@]}"
    for w in "${whls[@]}"; do n=${w##*/}; n=${n%%-*}
      pip_run $side "target-$n" install "${i[@]}" --no-deps --target "$W/$side/tree-$n" "$w"; done
    pip_run $side find-links install "${i[@]}" --find-links "$WHEELS_CACHE/wheels" --target "$W/$side/tree-find-links" "${names[@]}"
    pip_run $side list-path list "${o[@]}" --path "$W/$side/tree-find-links"
  done
  local bad=0 trees=0 files=0 exe_p exe_c
  exe_p="$root/tools/pyi/python3"; exe_c=$(python3 -I -S -c 'import sys; print(sys.executable)')
  local why ssl=0
  for n in version list $(printf 'target-%s ' "${names[@]}") find-links list-path; do
    why=""
    [ "$(cat "$W/pyi/$n.rc")" = "$(cat "$W/cpython/$n.rc")" ] || why="status $(cat "$W/pyi/$n.rc"), CPython's $(cat "$W/cpython/$n.rc")"
    # the outputs name each side's own tree: the same text once the side's directory is the other's
    sed "s|$W/pyi/|$W/cpython/|g" "$W/pyi/$n.out" | cmp -s - "$W/cpython/$n.out" || why="${why:+$why; }stdout differs"
    grep -q '^WARNING: Disabling truststore since ssl support is missing$' "$W/pyi/$n.err" && ssl=$((ssl + 1))
    sed '/^WARNING: Disabling truststore since ssl support is missing$/d' "$W/pyi/$n.err" | cmp -s - "$W/cpython/$n.err" \
      || why="${why:+$why; }stderr differs: $(sed '/truststore/d; /^[[:space:]]*$/d' "$W/pyi/$n.err" | tail -1)"
    case $n in
      target-*|find-links)
        local t=${n#target-}; t=tree-$t
        pip_tree "$W/pyi/$t" "$exe_p" > "$W/pyi/$t.files"; pip_tree "$W/cpython/$t" "$exe_c" > "$W/cpython/$t.files"
        if cmp -s "$W/pyi/$t.files" "$W/cpython/$t.files"; then
          trees=$((trees + 1)); files=$((files + $(wc -l < "$W/pyi/$t.files")))
          n="$n ($(wc -l < "$W/pyi/$t.files") files, $(cat "$W/pyi/$t"/*.dist-info/RECORD | wc -l) RECORD rows)"
        else why="${why:+$why; }its tree differs: $(diff "$W/cpython/$t.files" "$W/pyi/$t.files" | sed -n '/^[<>]/{p;q}' || true)"; fi ;;
    esac
    if [ -z "$why" ]; then echo "  pass pip $n"; else echo "  FAIL pip $n: $why"; bad=1; fi
  done
  # the negative controls: the judge on CPython's own trees, one file changed, and a launcher of another executable
  rm -rf "$W/control"; cp -r "$W/cpython/tree-six" "$W/control"; echo "# tampered" >> "$W/control/six.py"
  if pip_tree "$W/control" "$exe_c" | cmp -s - "$W/cpython/tree-six.files"; then echo "  FAIL control: a changed six.py judged equal"; bad=1
  else echo "  control refused: six.py changed in CPython's tree"; fi
  if pip_tree "$W/cpython/tree-idna" "$exe_p" | cmp -s - "$W/cpython/tree-idna.files"; then echo "  FAIL control: CPython's launcher judged pyi's"; bad=1
  else echo "  control refused: CPython's console script idna judged with pyi's executable"; fi
  if [ $bad = 0 ]; then
    echo "wheels pip-probe: pip 26.2.1 on pyi: $((${#names[@]} + 4)) runs equal to CPython's; $trees installed trees ($files files) equal; truststore's no-ssl warning on $ssl runs (classed); 2 controls refused"
  else echo "wheels pip-probe: FAILED (runs in $W)"; return 1; fi
}

# a pin's own test suite (queue 232; the user's decision 2026-11-08: tomli, click): the pins' :suites entry NAME, its
# source archive extracted afresh for each side under $WORK/wheels-suite/NAME/{cpython,pyi} (not under wheels check's $WORK/wheels, which it removes), its :runner run in :root
# with :args (TEST... in their place: a sample of the suite) against the installed wheels (the site and the test site,
# the archive's src/ not on the path), by python3 -S -B with PYTHONPATH the sites and by pyi with PYI_SITE the sites
# (both exported, so a test's child interpreter sees them); each log read as its tests' outcomes (arbace.python.wheels
# outcomes), CPython's as an outcome of the oracle's records (live on the VM; the main host records it), judged test for
# test by arbace.python.wheels judge against test/python/divergences.edn; a negative control: CPython's outcomes with
# its first passed test made failed, judged as pyi's, must fail
wheels_suite_run() { # SIDE DIR RUNNER LOG ARGS...: the run's status on LOG's last line
  local side=$1 d=$2 runner=$3 log=$4 rc=0 sites; shift 4
  sites="$(wheels_site)/lib:$(wheels_test_site)/lib"
  # the tests' temporary files under the run's own directory, never /tmp (TMPDIR; pytest's tmp_path under --basetemp)
  local tmp="${log%.log}.tmp"; rm -rf "$tmp"; mkdir -p "$tmp/t"
  local argv=()
  case $runner in
    unittest) argv=(-m unittest "$@" -v) ;;
    pytest) argv=(-m pytest -p no:cacheprovider -v --color=no --basetemp="$tmp/pytest" "$@") ;;
    *) die "wheels suite: runner $runner: unittest or pytest" ;;
  esac
  case $side in
    cpython) (cd "$d" && TMPDIR="$tmp/t" PYTHONDONTWRITEBYTECODE=1 PYTHONHASHSEED=0 LC_ALL=C.UTF-8 TZ=UTC COLUMNS=200 PYTHONPATH="$sites" \
                timeout "${PYI_SUITE_TIMEOUT:-3600}" python3 -S -B "${argv[@]}") > "$log" 2>&1 || rc=$? ;;
    pyi) (cd "$d" && TMPDIR="$tmp/t" PYTHONDONTWRITEBYTECODE=1 PYTHONHASHSEED=0 LC_ALL=C.UTF-8 TZ=UTC COLUMNS=200 PYI_SITE="$sites" \
            timeout "${PYI_SUITE_TIMEOUT:-3600}" "$root/bin/pyi" python "${argv[@]}") > "$log" 2>&1 || rc=$? ;;
  esac
  echo "status $rc" >> "$log"
}
wheels_suite_cpython() { # DIR RUNNER LOG ARGS...: CPython's outcomes (stdout), its log beside
  local d=$1 runner=$2 log=$3; shift 3
  wheels_suite_run cpython "$d" "$runner" "$log" "$@"
  wheels_arbace outcomes --runner "$runner" --log "$log"
}
wheels_suite() {
  # queue 234: each test judged by its own verdict (PYI_VERDICT own, the default): pyi's run alone; ref: against CPython's
  # run of the same suite (the oracle tier's)
  local verdict; verdict=$(judge_verdict "")
  [ "$verdict" = own ] || need_python "wheels suite (CPython's run of the same suite: the oracle tier's)"
  [ $# -ge 1 ] || die "usage: bin/pyi wheels suite NAME [TEST...]"
  local want=$1; shift
  local name file url sha bytes sroot runner args found=0 bad=0 site tsite
  site=$(wheels_site); tsite=$(wheels_test_site)
  wheels_arbace install --pins "$WHEELS_PINS" --cache "$WHEELS_CACHE/wheels" --site "$site" > /dev/null || return 1
  wheels_arbace install --pins "$WHEELS_PINS" --cache "$WHEELS_CACHE/wheels" --site "$tsite" --set test-wheels > /dev/null || return 1
  while IFS=$'\t' read -r name file url sha bytes sroot runner args; do
    [ "$name" = "$want" ] || continue
    found=1
    local src="$WHEELS_CACHE/sdists/$file" W="$WORK/wheels-suite/$name" sel=()
    [ -f "$src" ] && [ "$(sha256sum < "$src" | cut -c1-64)" = "$sha" ] || die "wheels suite: $src not as pinned (bin/pyi wheels fetch)"
    if [ $# -gt 0 ]; then sel=("$@"); else read -ra sel <<< "$args"; fi
    rm -rf "$W"; mkdir -p "$W/cpython" "$W/pyi"
    tar xzf "$src" -C "$W/pyi"
    local t0=$SECONDS key
    : > "$W/cpython.tsv"
    if [ "$verdict" = ref ]; then
      tar xzf "$src" -C "$W/cpython"
      key=$(pyrec_key "$WHEELS_PINS" "$root/arbace/python/wheels.ae" "$src"; printf '%s\n' "${sel[@]}" | sha256sum | cut -c1-16)
      key=$(echo "$key" | tr '\n' ':')
      pyrec_outcome "wheels/suite-$name-$(printf '%s ' "${sel[@]}" | sha256sum | cut -c1-8)" "$key" \
        wheels_suite_cpython "$W/cpython/$sroot" "$runner" "$W/cpython.log" "${sel[@]}" > "$W/cpython.tsv" || true
      echo "  CPython: $(wc -l < "$W/cpython.tsv") tests, $(tail -1 "$W/cpython.log" 2>/dev/null) ($((SECONDS - t0)) s)"
    fi
    t0=$SECONDS
    wheels_suite_run pyi "$W/pyi/$sroot" "$runner" "$W/pyi.log" "${sel[@]}"
    wheels_arbace outcomes --runner "$runner" --log "$W/pyi.log" > "$W/pyi.tsv"
    echo "  pyi: $(wc -l < "$W/pyi.tsv") tests, $(tail -1 "$W/pyi.log") ($((SECONDS - t0)) s)"
    wheels_arbace judge --suite "$name" --verdict "$verdict" --divergences "$DIV" --cpython "$W/cpython.tsv" --pyi "$W/pyi.tsv" || bad=1
    # the negative control: the judged side's outcomes (own: pyi's; ref: CPython's own, judged as pyi's), the first passed
    # test made failed
    local base="$W/cpython.tsv"; [ "$verdict" = ref ] || base="$W/pyi.tsv"
    awk -F'\t' 'BEGIN { OFS = "\t" } !d && $2 == "passed" { $2 = "failed"; d = 1 } { print }' "$base" > "$W/control.tsv"
    if wheels_arbace judge --suite "$name" --verdict "$verdict" --divergences "$DIV" --cpython "$W/cpython.tsv" --pyi "$W/control.tsv" > "$W/control.out"; then
      echo "  FAIL control: a passed test made failed judged equal"; bad=1
    else echo "  control refused: $(grep -m1 '^  FAIL' "$W/control.out" | sed 's/^  FAIL //')"; fi
  done < <(wheels_arbace suites --pins "$WHEELS_PINS")
  [ $found = 1 ] || die "wheels suite: no suite $want in $WHEELS_PINS"
  return $bad
}

cmd_wheels() {
  local verb=${1:-}; shift || true
  case $verb in
    fetch) wheels_fetch ;;
    install) local site; site=$(wheels_site)
             wheels_arbace install --pins "$WHEELS_PINS" --cache "$WHEELS_CACHE/wheels" --site "$site"; echo "$site" ;;
    verify) wheels_arbace verify --pins "$WHEELS_PINS" --cache "$WHEELS_CACHE/wheels" --site "$(wheels_site)" ;;
    path) echo "$(wheels_site)/lib" ;;
    run) [ $# -ge 1 ] || die "usage: bin/pyi wheels run SCRIPT [ARGS...]"
         local s; s="$(wheels_site)/bin/$1"; shift; [ -x "$s" ] || die "no console script $s (bin/pyi wheels install)"
         cd "$caller_pwd"; PYI_EXECUTABLE="$root/tools/pyi/python3" exec "$s" "$@" ;;
    check) mkdir -p "$WORK"; wheels_check "$@" ;;
    pip-probe) mkdir -p "$WORK"; wheels_pip_probe ;;
    suite) mkdir -p "$WORK"; wheels_suite "$@" ;;
    *) die "usage: bin/pyi wheels fetch|install|verify|path|run SCRIPT [ARGS...]|check [NAME...]|pip-probe|suite NAME [TEST...]" ;;
  esac
}

# records [--slice N] [--dir DIR] [--only aot|lib-test] (queue 321): the main host's records night for the eval and AOT
# cells in one command. The host first: the checkout's runtime must be what pyi runs (runtime_state; a stale stage 0, a
# W2 seed older than the checkout's go/arbace/py, is replaced by the gate's build at the checkout's key when there is one,
# else refused with the command that builds it). Then, each under busybox time with a 5 s sampler of its processes' summed
# memory (DIR/STEP.time, DIR/STEP.mem: the night's wall and peak), bin/pyi check --aot --record (the 151 programs, pyi's runs
# too: test/python/check-aot-linux-amd64.edn, reap's :pyi-aot, the AOT cell and the eval cell's loop and goi columns) and
# bin/pyi check --fresh --record (Lib/test's every module, each method by its own verdict: check-lib-test-linux-amd64.edn,
# reap's :results); then the :until of each source whose record is written dropped from test/reap/cells.edn, bin/reap
# --record and bin/crops-score --record (where it is). Night mode is linux/amd64's and writes the checkout's files; its
# outcome is to commit (the records, cells.edn, matrix.edn, scores.edn).
# The two records are committed together, never the AOT record alone (queue 347's DECISION 1 (a), the user 2026-11-18):
# with check-aot-linux-amd64.edn there the eval cell's loop sources lose their :until, so without the Lib/test record bin/reap
# counts the eval cell checked by the loop's 151 programs alone (eval about 99, not Lib/test's about 68). When Lib/test's
# methods need classes first (the judge's exit 3), hold both: class them, bin/pyi check --judge RUN --record (and, for the
# AOT record, bin/pyi check --aot --judge --record), then bin/reap --record and bin/crops-score --record, one commit.
# --slice N: the dry run. Every Nth program of aot_list and every Nth module of the check's universe, the records under
# DIR (default WORK/records-slice; named as the cells name them, never to commit), then read through an overlay of the
# checkout (DIR/overlay: links to the checkout but test/python's two records, a reference of the slice's programs alone
# and cells.edn without the :until and with that reference) by bin/reap --record and bin/crops-score --crop python. Nothing
# of the checkout is written. PYI_RUNTIME_STALE=1 lets a slice run on a stale host (its outcomes then the stale runtime's).
cmd_records() {
  local slice="" dir="" only="" arch rc=0 s
  while [ $# -gt 0 ]; do case $1 in --slice) slice=$2; shift 2 ;; --dir) dir=$(cd "$caller_pwd" && mkdir -p "$2" && cd "$2" && pwd); shift 2 ;;
    --only) only=$2; shift 2 ;; *) die "usage: bin/pyi records [--slice N] [--dir DIR] [--only aot|lib-test]" ;; esac; done
  case $only in ""|aot|lib-test) ;; *) die "records: --only aot or lib-test" ;; esac
  [ -z "$slice" ] || [ "$slice" -ge 1 ] 2>/dev/null || die "records: --slice N, N a positive number"
  case $(uname -m) in x86_64) arch=amd64 ;; aarch64) arch=arm64 ;; *) arch=$(uname -m) ;; esac
  if [ -z "$slice" ]; then
    [ "$arch" = amd64 ] || die "records: the records are linux/amd64's (the main host's); --slice N for a dry run here"
    [ -z "$dir" ] || die "records: --dir is the slice's"
    dir="$WORK/records"
  else
    dir=${dir:-$WORK/records-slice}
  fi
  mkdir -p "$dir"
  # the host: the state its checks will run in (each bin/pyi check decides by runtime_from_source, auto unless PYI_RUNTIME)
  s=$(records_state)
  case $s in
    stale*|checkout*|interpreted)
      # the gate's key without ARBACE_HOST_EXE (gate_key hashes its bytes when set; the gate unsets it): the gate's build
      local g; g="$(unset ARBACE_HOST_EXE; . "$root/bin/lib/gate-cache.bash"; arbace_gate_cache "$root" 2>/dev/null)/amd64/arbace"
      if [ "$arch" = amd64 ] && [ -x "$g" ]; then
        echo "records: the tools' host $(arbace_exe) runs pyi's runtime as '$s', not the checkout's compiled: the gate's build at the checkout's key instead, $g"
        export ARBACE_HOST_EXE=$g; s=$(records_state)
      fi ;;
  esac
  case $s in
    compiled*) ;;
    *) if [ -n "$slice" ] && [ "${PYI_RUNTIME_STALE:-}" = 1 ]; then echo "records: WARNING the host's runtime is '$s', not the checkout's compiled: the slice's outcomes are that runtime's"
       else die "records: the tools' host $(arbace_exe) runs pyi's runtime as '$s', not the checkout's compiled (a record's): bin/arbace-go --gate-build, then again (it takes the gate's build at the checkout's key)"; fi ;;
  esac
  echo "records: host $(arbace_exe) ($s), $(nproc) cores, PYI_LIB_TEST_JOBS=${PYI_LIB_TEST_JOBS:-2}, GOGC=${GOGC:-}${slice:+, slice 1/$slice}"
  local aot_rec lib_rec aot_args=() lib_args=()
  if [ -n "$slice" ]; then
    aot_rec="$dir/check-aot-linux-amd64.edn" lib_rec="$dir/check-lib-test-linux-amd64.edn"
    aot_list | awk -v n="$slice" 'NR % n == 1 || n == 1' > "$dir/aot-slice.txt"
    check_universe | cut -f1 | awk -v n="$slice" 'NR % n == 1 || n == 1' > "$dir/lib-slice.txt"
    aot_args=(--only-list "$dir/aot-slice.txt"); mapfile -t lib_args < "$dir/lib-slice.txt"
    [ "$only" = lib-test ] || rm -f "$aot_rec"
    [ "$only" = aot ] || rm -f "$lib_rec"
    echo "records: the slice: $(wc -l < "$dir/aot-slice.txt") programs, $(wc -l < "$dir/lib-slice.txt") modules ($dir/*-slice.txt)"
  else
    aot_rec="$root/test/python/check-aot-linux-amd64.edn" lib_rec="$CHECK_RECORD"
  fi
  if [ "$only" != lib-test ]; then
    records_step "$dir" aot env PYI_CHECK_AOT_RECORD="$aot_rec" "$root/bin/pyi" check --aot ${aot_args[@]+"${aot_args[@]}"} --record || rc=1
  fi
  if [ "$only" != aot ]; then
    records_step "$dir" lib-test env PYI_CHECK_RECORD="$lib_rec" "$root/bin/pyi" check --fresh --record ${lib_args[@]+"${lib_args[@]}"} || rc=1
  fi
  # the cells: the sources whose records are written lose their :until; then the matrix and the scores
  local tree=$root
  if [ -n "$slice" ]; then tree=$(records_overlay "$dir" "$aot_rec" "$lib_rec"); fi
  [ ! -f "$aot_rec" ] || sed -i 's/ :until "PY8 (the main host'"'"'s record)"//' "$tree/test/reap/cells.edn"
  [ ! -f "$lib_rec" ] || sed -i 's/ :until "PY7 (the main host'"'"'s record)"//' "$tree/test/reap/cells.edn"
  echo "== bin/reap --record${slice:+ (the overlay $tree)}"
  local reap_ok=1; "$tree/bin/reap" --record > "$dir/reap.log" 2>&1 || { rc=1; reap_ok=""; }
  # the Python cells and their sources (not each class's line), then the summary and its problems
  awk '/^\| Python / {print} /^[^ |].* (read|eval|AOT|print): / {py = /^Python /} /^reap: [0-9]/ {py = 0; tail = 1} (py && !/^ +[0-9,]+ /) || tail' "$dir/reap.log" | head -60
  if [ -z "$reap_ok" ]; then echo "== bin/crops-score: not run (reap's problems: test/reap/matrix.edn not written)"
  elif [ -x "$tree/bin/crops-score" ]; then
    if [ -n "$slice" ]; then echo "== bin/crops-score --crop python"; else echo "== bin/crops-score --record"; fi
    if [ -n "$slice" ]; then "$tree/bin/crops-score" --crop python > "$dir/crops-score.log" 2>&1 || rc=1
    else "$tree/bin/crops-score" --record > "$dir/crops-score.log" 2>&1 || rc=1; fi
    grep -i 'python' "$dir/crops-score.log" | head -20
  fi
  echo "records: the steps' wall and peak:"
  local st
  for st in aot lib-test; do
    [ -f "$dir/$st.time" ] || continue
    printf '  %-9s %s wall, %s s CPU, peak %s MB summed (%s MB the largest process)%s\n' "$st" \
      "$(sed -n 's/.*Elapsed (wall clock) time (h:mm:ss or m:ss): //p' "$dir/$st.time")" \
      "$(awk -F': ' '/User time|System time/ {s += $2} END {printf "%.0f", s}' "$dir/$st.time")" \
      "$(cat "$dir/$st.mem" 2>/dev/null || echo ?)" \
      "$(awk -F': ' '/Maximum resident/ {printf "%.0f", $2 / 1024}' "$dir/$st.time")" \
      "${slice:+; the whole run about $slice times the wall at the same jobs}"
  done
  if [ -n "$slice" ]; then echo "records: logs and the slice's records in $dir (not for commit)"; else echo "records: logs in $dir"; fi
  return $rc
}
# records_state: runtime_state as a bin/pyi check started now would see it (its own runtime_from_source decision)
records_state() { ( unset ARBACE_GOI_FROM_SOURCE PYI_RUNTIME_NOTED; runtime_from_source records 2>/dev/null; runtime_state ); }
# records_step DIR NAME CMD...: CMD under busybox time (DIR/NAME.time), its log DIR/NAME.log, the peak of its processes'
# summed resident memory sampled every 5 s (DIR/NAME.mem, MB)
records_step() {
  local dir=$1 nm=$2; shift 2
  echo "== $nm: $*"
  busybox time -v -o "$dir/$nm.time" "$@" > "$dir/$nm.log" 2>&1 &
  local pid=$! peak=0 now
  while kill -0 "$pid" 2>/dev/null; do
    now=$(ps -eo pid=,ppid=,rss= | awk -v root="$pid" '{p[$1] = $2; r[$1] = $3} END {
            n = 0; for (k in p) { q = k; while (q != "" && q != 0 && q != 1) { if (q == root) { n += r[k]; break } q = p[q] } } print int(n / 1024) }')
    [ "$now" -le "$peak" ] || peak=$now
    echo "$peak" > "$dir/$nm.mem"; sleep 5
  done
  local rc=0; wait "$pid" || rc=$?
  grep -E '^check --aot: |^pyi check: [0-9]+ modules|^pyi check: |control|written' "$dir/$nm.log" | tail -8
  echo "== $nm: exit $rc"
  return $rc
}
# records_overlay DIR AOT LIB: DIR/overlay, the checkout's top level as links but test/, test/python and test/reap real
# directories of links, the two records and test/python/ref-cpython314-slice.edn (the slice's programs' references) in
# test/python, cells.edn and matrix.edn copies (the cells' :pyi-aot sources on the slice's reference); prints its path
records_overlay() {
  local dir=$1 aot=$2 lib=$3 o="$1/overlay" f
  rm -rf "$o"; mkdir -p "$o/test/python" "$o/test/reap"
  for f in "$root"/* "$root"/.[!.]*; do case ${f##*/} in .git|test) ;; *) ln -s "$f" "$o/${f##*/}" ;; esac; done
  for f in "$root"/test/*; do case ${f##*/} in python|reap) ;; *) ln -s "$f" "$o/test/${f##*/}" ;; esac; done
  for f in "$root"/test/python/*; do ln -s "$f" "$o/test/python/${f##*/}"; done
  for f in "$root"/test/reap/*; do ln -s "$f" "$o/test/reap/${f##*/}"; done
  rm -f "$o/test/reap/cells.edn" "$o/test/reap/matrix.edn"; cp "$root/test/reap/cells.edn" "$root/test/reap/matrix.edn" "$o/test/reap/"
  for f in "$aot" "$lib"; do [ ! -f "$f" ] || { rm -f "$o/test/python/${f##*/}"; cp "$f" "$o/test/python/"; }; done
  awk 'NR == FNR {want["\"" $0 "\""] = 1; next} match($0, /^\{:id "[^"]*"/) {id = substr($0, 6, RLENGTH - 5); if (id in want) print}' \
    "$dir/aot-slice.txt" "$REF" > "$o/test/python/ref-cpython$RECV-slice.edn"
  sed -i "s|:py-ref \"test/python/ref-cpython$RECV.edn\"|:py-ref \"test/python/ref-cpython$RECV-slice.edn\"|" "$o/test/reap/cells.edn"
  echo "$o"
}

# adopt_host_env (py-cli-1125, test_subprocess's test_empty_env): a child that a test starts with env={} (or an environment
# without ARBACE_HOST_EXE) is bin/pyi python on no host of its own: it would take the checkout's or the main checkout's stage 0,
# whose compiled runtime is another commit's (the checkout's go/arbace/py then interpreted by goi, which cannot, for the
# runtime's packages that import weak), where CPython's python3 is an installed program that works in any environment. The
# host's choice is read from the process tree instead: the nearest ancestor whose environment (/proc/PID/environ, what it was
# started with) holds ARBACE_HOST_EXE gives it, with the runtime's decision and tuning it was started with. No ancestor that
# has one (a process reparented to init, a bare shell), the default as before. os.environ stays what the caller gave
# (PYI_ENTRY_ENV, tools/pyi/python3).
adopt_host_env() {
  local p=$PPID n=0 e v name
  [ -z "${ARBACE_HOST_EXE:-}" ] || return 0
  while [ "$p" -gt 1 ] 2>/dev/null && [ "$n" -lt 64 ]; do
    if e=$(tr '\0' '\n' < "/proc/$p/environ" 2>/dev/null) && grep -q '^ARBACE_HOST_EXE=.' <<< "$e"; then
      for name in ARBACE_HOST_EXE ARBACE_GOI_FROM_SOURCE PYI_RUNTIME PYI_RUNTIME_NOTED PYI_GOMEMLIMIT PYI_THREADS; do
        if grep -q "^$name=" <<< "$e"; then v=$(sed -n "s/^$name=//p" <<< "$e" | head -n 1); export "$name=$v"; fi
      done
      return 0
    fi
    p=$(sed 's/.*) //' "/proc/$p/stat" 2>/dev/null | cut -d' ' -f2) || return 0
    [ -n "$p" ] || return 0
    n=$((n + 1))
  done
  return 0
}
[ "${1:-}" != python ] || adopt_host_env

# the verbs that run pyi on goi decide its runtime first (runtime_from_source), for their children too
case "${1:-}" in
  run|ir|repl|lib-test|python|lib-test-all|runtime|aot|bench|check|cover|wheels|runner|script) mkdir -p "$WORK"; runtime_from_source "$1" ;;
esac
case "${1:-}" in
  gen) shift; cmd_gen "$@" ;;
  golden) shift; cmd_golden "$@" ;;
  record-ref) shift; cmd_record_ref "$@" ;;
  scope-check) shift; cmd_scope_check "$@" ;;
  compile-check) shift; cmd_compile_check "$@" ;;
  run) shift; mkdir -p "$WORK"; cmd_run "$@" ;;
  ir) shift; mkdir -p "$WORK"; pa_arbace ir --file "$1" --out "$2" ;;
  bytecode-check) shift; mkdir -p "$WORK"; cmd_bytecode_check "$@" ;;
  repl) shift; mkdir -p "$WORK"; cmd_repl "$@" ;;
  lib-test) shift; mkdir -p "$WORK"; cmd_lib_test "$@" ;;
  python) shift; mkdir -p "$WORK"; cmd_python "$@" ;;
  lib-test-all) shift; mkdir -p "$WORK"; cmd_lib_test_all "$@" ;;
  runtime) shift; mkdir -p "$WORK"; cmd_runtime "$@" ;;
  aot) shift; mkdir -p "$WORK"; cmd_aot "$@" ;;
  aot-compile) shift; mkdir -p "$WORK"; aot_module >&2; aot_compile "$@" ;;
  launcher) shift; mkdir -p "$WORK"; [ $# = 0 ] || die "usage: bin/pyi launcher"; launcher_py ;;
  bench) shift; mkdir -p "$WORK"; cmd_bench "$@" ;;
  check) shift; mkdir -p "$WORK"; if [ "${1:-}" = --aot ]; then shift; cmd_check_aot "$@"; else cmd_check_lib "$@"; fi ;;
  divergences) shift; mkdir -p "$WORK"; cmd_divergences "$@" ;;
  records) shift; mkdir -p "$WORK"; cmd_records "$@" ;;
  cover) shift; mkdir -p "$WORK"; cmd_cover "$@" ;;
  wheels) shift; cmd_wheels "$@" ;;
  c2j-check) shift; mkdir -p "$WORK"; cmd_c2j_check "$@" ;;
  table-check) shift; mkdir -p "$WORK"; cmd_table_check "$@" ;;
  runner) shift; mkdir -p "$WORK"; if [ $# -eq 0 ]; then runner_exe; else pyrun "$@"; fi ;;
  script) shift; mkdir -p "$WORK"; cmd_script "$@" ;;
  universe) shift; cmd_universe "$@" ;;
  *) sed -n '2,/^# Environment:/p' "$0"; exit 2 ;;
esac

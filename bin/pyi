#!/bin/bash
# pyi, the evaluator of Python forms (doc/python/PYTHON-SURVEY.md §6, PYS2 (a)): so far (PY4) no interpreter, only its
# corpora and their references, CPython 3.14.10's runs (GTS207 (a), PYS14 (a), PYS15 (a)). Out of gate_key and the gate
# (PYS18 (a)); stage 0 only runs the generator (test/python/gen.ae); the programs and Lib/test's modules are run by the
# oracle under .tmp/repr-python/pyi only (HOME and TMPDIR there, regrtest's resources off: no network).
#
#   bin/pyi gen [--check]          the synthetic corpus (survey §8.3): test/python/gen.ae on stage 0 writes
#                                  test/python/synth/ (ops, datamodel, builtins, constructs, paths; MANIFEST); --check
#                                  generates it into .tmp and requires it equal to the committed files, the constructs
#                                  covering every node class of the ast, the builtins every public method of their types,
#                                  every program compiling
#   bin/pyi record-ref [--check] [CORPUS...]
#                                  the reference runs (default: synthetic samples language-core): each program of
#                                  synthetic and samples run by CPython 3.14.10 with PYTHONHASHSEED=0 (tools/pydump/refs.py),
#                                  twice; status, stdout's SHA-256, size, first line and stderr's last line into
#                                  test/python/ref-cpython314.edn; Lib/test's language-core modules (corpora.edn) by
#                                  regrtest, each test method's outcome into test/python/ref-cpython314-lib-test.edn
#                                  (sys.implementation.name "cpython"); an entry the two runs disagree on or whose output
#                                  names the machine is written :excluded with its reason; the seconds into
#                                  test/python/ref-costs.edn. --check: two more runs, each reproducing every reference
#   bin/pyi scope-check [--record] [CORPUS...]
#                                  PY5a: every read file's symbol table by arbace.python.scope against CPython's own
#                                  (tools/pydump/pydump.py scopes): the corpora of test/python/corpora.edn (default:
#                                  samples synthetic errors stdlib site-packages lib-test), against test/python/scope-known.edn
#   bin/pyi compile-check [--record] [CORPUS...]
#                                  PY5a: every read file compiled to pyi's IR (arbace.python.compile) and the IR
#                                  verified (doc/python/PYI-SPEC.md §4), against test/python/compile-known.edn
#   bin/pyi run FILE.py            PY5b0: FILE read in mode :full (tools/pydump/pydump.py tree --full: its lines), compiled to
#                                  the IR and run by pyi's runtime go/arbace/py, interpreted by goi on stage 0 (PY5a's DECISION
#                                  (a)); the program's stdout, stderr and exit status
#   bin/pyi run FILE.py ARGS...    PY5e: sys.argv [FILE ARGS...], sys.path [FILE's directory, the pinned tarball's Lib];
#                                  imports, exec, eval and compile compiled by the host (arbace.python.run, the IR kept in
#                                  .tmp/repr-python/pyi/ir-cache by the source's and the compiler's SHA-256)
#   bin/pyi repl                   PY5e: python3's basic REPL (go/arbace/py's repl.go): statements from stdin, prompts on
#                                  stderr, expression statements' values displayed (sys.displayhook, builtins._)
#   bin/pyi runtime print|read|vet|check
#                                  PY5b0, the runtime's sources (doc/python/PYI-SPEC.md §8): go/arbace/py's Go forms (mode :full,
#                                  lossless) printed as a Go module into .tmp/repr-python/pyi/runtime (print), edited there,
#                                  read back into go/arbace/py (read); vet: the Go there (printed first when absent) gofmt
#                                  clean, then go vet and go test by TamaGo's go;
#                                  check: printed and read again equal to the committed forms, the runtime's operations
#                                  arbace.python.ir/ops's (runtime-ops), the programs of test/python/pyi/ run by bin/pyi run
#                                  equal to the oracle's runs (stdout, status, stderr's last line)
# Environment: REPR_PYTHON_SRC as for bin/repr-python (the tarball's source).
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash"
caller_pwd=$PWD
cd "$root"

WORK="$root/.tmp/repr-python/pyi"
SYNTH="$root/test/python/synth"
REF="$root/test/python/ref-cpython314.edn"
REF_LT="$root/test/python/ref-cpython314-lib-test.edn"
COSTS="$root/test/python/ref-costs.edn"
COSTS_LT="$root/test/python/ref-costs-lib-test.edn"
die() { echo "pyi: $*" >&2; exit 1; }

arbace_exe() {
  if [ -n "${ARBACE_HOST_EXE:-}" ]; then echo "$ARBACE_HOST_EXE"; return; fi
  local arch main
  case $(uname -m) in x86_64) arch=amd64 ;; aarch64) arch=arm64 ;; *) arch=$(uname -m) ;; esac
  if [ -x "$root/target/seed/$arch/arbace" ]; then echo "$root/target/seed/$arch/arbace"; return; fi
  main=$(cd "$(git rev-parse --git-common-dir)/.." && pwd)
  if [ -x "$main/target/seed/$arch/arbace" ]; then echo "$main/target/seed/$arch/arbace"; return; fi
  die "no stage 0 (bin/seed --build, or ARBACE_HOST_EXE)"
}
py() { local s=$1; shift; python3 -I -S -B "$root/tools/pydump/$s" "$@"; }

check_oracle() {
  local want have
  want=$(sed -n 's/^sys\.version //p' "$root/tools/pydump/PYTHON_VERSION")
  have=$(python3 -I -c 'import sys; print(sys.version)')
  [ "$want" = "$have" ] || die "the oracle is '$have', tools/pydump/PYTHON_VERSION pins '$want'"
  [ "$(python3 -I -c 'import sys; print(sys.implementation.name)')" = cpython ] || die "the oracle is not CPython"
}

cmd_gen() {
  local check=${1:-}
  if [ "$check" = --check ]; then
    local d="$WORK/gen"; rm -rf "$d"; mkdir -p "$d"
    "$(arbace_exe)" "$root/test/python/gen.ae" "$d"
    local bad=0
    diff -r "$d" "$SYNTH" > "$WORK/gen.diff" || { echo "gen --check: the generated corpus differs from test/python/synth (bin/pyi gen):"; head -20 "$WORK/gen.diff"; bad=1; }
    (cd "$SYNTH/constructs" && py corpus.py samples . .) || bad=1
    (cd "$SYNTH" && py corpus.py samples . . | tail -1)
    local t
    for t in str bytes list tuple dict set frozenset int float complex bool range memoryview slice; do
      py corpus.py methods "$t" "$SYNTH/builtins/$t.py" | tail -1 | grep -q ' of ' || bad=1
      py corpus.py methods "$t" "$SYNTH/builtins/$t.py" >/dev/null || { py corpus.py methods "$t" "$SYNTH/builtins/$t.py" | grep UNCOVERED; bad=1; }
    done
    py corpus.py methods bytearray "$SYNTH/builtins/bytearray.py" "$SYNTH/builtins/bytearray-shared.py" >/dev/null \
      || { py corpus.py methods bytearray "$SYNTH/builtins/bytearray.py" "$SYNTH/builtins/bytearray-shared.py" | grep UNCOVERED; bad=1; }
    if [ $bad = 0 ]; then echo "gen --check: $(wc -l < "$SYNTH/MANIFEST") programs as committed; every node class and builtin method covered"; else return 1; fi
  else
    rm -rf "$SYNTH"; mkdir -p "$SYNTH"
    "$(arbace_exe)" "$root/test/python/gen.ae" "$SYNTH"
  fi
}

# the language core's modules, from test/python/corpora.edn (the corpus :language-core's paths, as module names)
core_modules() {
  "$(arbace_exe)" -e "(println (arbace.string/join \",\" (map #(-> % (subs 9) (arbace.string/replace #\"\\.py\$\" \"\")) (get-in (first (filter #(= :language-core (:id %)) (:corpora (read-string (slurp \"$root/test/python/corpora.edn\"))))) [:where :paths]))))"
}

tarball_test() {
  local top="$root/.tmp/repr-python/Python-3.14.10"
  [ -d "$top/Lib/test" ] || "$root/bin/repr-python" pins --fetch >/dev/null
  mkdir -p "$WORK/pypath"; ln -sfn "$top/Lib/test" "$WORK/pypath/test"
}

# run_programs TAG: the synthetic corpus and the samples, one TSV
run_programs() {
  local tag=$1 d="$WORK/$1"
  rm -rf "$d"; mkdir -p "$d"
  { sed 's|^|synth/|' "$SYNTH/MANIFEST"; (cd "$root/test/python/samples" && ls *.py | sed 's|^|samples/|'); } > "$d/list"
  mkdir -p "$d/base"; ln -sfn "$SYNTH" "$d/base/synth"; ln -sfn "$root/test/python/samples" "$d/base/samples"
  py refs.py programs --base "$d/base" --list "$d/list" --work "$d" --out "$d/programs.tsv"
}

run_libtest() {
  local tag=$1 d="$WORK/$1"
  mkdir -p "$d"
  tarball_test
  py refs.py libtest --pypath "$WORK/pypath" --modules "$(core_modules)" --work "$d" --out "$d/libtest.tsv"
}

header() { # FILE WHAT
  cat > "$1" <<HDR
;; CPython 3.14.10's reference runs of $2, as data (doc/python/PYTHON-SURVEY.md §8.1, PYS14 (a), PYS15 (a); GTS207 (a)):
;; one map per line, sorted by :id. Programs: :status the exit status (128+signal, :timeout), :stdout the SHA-256 of
;; the standard output, :bytes its size, :first its first line (80 chars), :stderr-last the last non-blank line of the
;; standard error. Lib/test: :outcome :ok, :skipped (:reason), :failure or :error per test method, :module true lines
;; with regrtest's exit status. :excluded names an entry kept out of the references: the two recording runs disagree,
;; or its output names the machine (an address, the architecture, the C library, a size): bin/pyi record-ref --check
;; reproduces the others. Made by: bin/pyi record-ref ($(python3 -I -c 'import sys; print(sys.version.split()[0], sys.implementation.name)'),
;; python3 -s -P -B, PYTHONHASHSEED=0 LC_ALL=C.UTF-8 TZ=UTC PYTHONIOENCODING=utf-8; regrtest -u none --randseed 1).
;; date: $(date -u +%F)
HDR
}

cmd_record_ref() {
  local check="" ids=()
  while [ $# -gt 0 ]; do case $1 in --check) check=1; shift ;; *) ids+=("$1"); shift ;; esac; done
  [ ${#ids[@]} -gt 0 ] || ids=(programs language-core)
  check_oracle
  local id rc=0
  for id in "${ids[@]}"; do
    case $id in
      synthetic|samples|programs)
        if [ -n "$check" ]; then
          run_programs check1; run_programs check2
          py refs.py check --kind programs --ref "$REF" --run "$WORK/check1/programs.tsv" || rc=1
          py refs.py check --kind programs --ref "$REF" --run "$WORK/check2/programs.tsv" || rc=1
        else
          run_programs rec1; run_programs rec2
          header "$WORK/header.txt" "the synthetic corpus (test/python/synth) and the samples (test/python/samples)"
          py refs.py record --kind programs --a "$WORK/rec1/programs.tsv" --b "$WORK/rec2/programs.tsv" --out "$REF" \
            --header "$WORK/header.txt" --costs "$COSTS"
        fi ;;
      language-core)
        if [ -n "$check" ]; then
          run_libtest check1; run_libtest check2
          py refs.py check --kind libtest --ref "$REF_LT" --run "$WORK/check1/libtest.tsv" || rc=1
          py refs.py check --kind libtest --ref "$REF_LT" --run "$WORK/check2/libtest.tsv" || rc=1
        else
          run_libtest rec1; run_libtest rec2
          header "$WORK/header.txt" "Lib/test's language-core modules (test/python/corpora.edn), per test method"
          py refs.py record --kind libtest --a "$WORK/rec1/libtest.tsv" --b "$WORK/rec2/libtest.tsv" --out "$REF_LT" \
            --header "$WORK/header.txt" --costs "$COSTS_LT"
        fi ;;
      *) die "no corpus $id (programs, language-core)" ;;
    esac
  done
  return $rc
}

# corpus_list ID DIR: the corpus's base directory (stdout) and its files' list into DIR/list
corpus_list() {
  local id=$1 d=$2 line base paths excl
  line=$("$(arbace_exe)" -e "(let [c (first (filter #(= :$id (:id %)) (:corpora (read-string (slurp \"$root/test/python/corpora.edn\")))))] (when c (let [w (:where c)] (println (if (:pin w) (name (:pin w)) (str \"root:\" (:root w))) (arbace.string/join \",\" (:paths w)) (if (seq (:exclude w)) (arbace.string/join \",\" (:exclude w)) \"-\")))))")
  [ -n "$line" ] || die "no corpus $id in test/python/corpora.edn"
  read -r base paths excl <<< "$line"
  case $base in
    cpython-3.14.10) base="$root/.tmp/repr-python/Python-3.14.10"; [ -d "$base/Lib" ] || "$root/bin/repr-python" pins --fetch >/dev/null ;;
    site-packages) base="$root/.tmp/repr-python/site-packages/$(uname -m)"; [ -d "$base" ] || "$root/bin/repr-python" pins --fetch >/dev/null ;;
    root:*) base="$root/${base#root:}" ;;
  esac
  local -a args=(); IFS=, read -ra pa <<< "$paths"; args+=("${pa[@]}")
  if [ "$excl" != - ]; then IFS=, read -ra ea <<< "$excl"; for e in "${ea[@]}"; do args+=(--exclude "$e"); done; fi
  mkdir -p "$d"
  (cd "$base" && py corpus.py list "$base" "${args[@]}") > "$d/list"
  echo "$base"
}

pa_arbace() {
  ARBACE_PATH="$root" GOMEMLIMIT=${PYI_GOMEMLIMIT:-1500MiB} GOMAXPROCS=${PYI_THREADS:-4} "$(arbace_exe)" -m arbace.python "$@"
}

cmd_scope_check() {
  local record="" ids=() rc=0 worst=0 id
  while [ $# -gt 0 ]; do case $1 in --record) record=1; shift ;; *) ids+=("$1"); shift ;; esac; done
  [ ${#ids[@]} -gt 0 ] || ids=(samples synthetic errors stdlib site-packages lib-test)
  for id in "${ids[@]}"; do
    local d="$WORK/scope/$id" base t0
    rm -rf "$d"
    base=$(corpus_list "$id" "$d")
    t0=$(date +%s)
    py pydump.py tree --base "$base" --list "$d/list" --out "$d/dumps" --tsv "$d/dumps.tsv"
    py pydump.py scopes --base "$base" --list "$d/list" --out "$d/scopes"
    rc=0
    pa_arbace scope-check --corpus "$id" --dumps "$d/dumps" --scopes "$d/scopes" --known "$root/test/python/scope-known.edn" \
      --results "$d/results.edn" ${record:+--record} || rc=$?
    echo "  $(( $(date +%s) - t0 )) s"
    [ $rc -gt $worst ] && worst=$rc
  done
  return $worst
}

cmd_compile_check() {
  local record="" ids=() rc=0 worst=0 id
  while [ $# -gt 0 ]; do case $1 in --record) record=1; shift ;; *) ids+=("$1"); shift ;; esac; done
  [ ${#ids[@]} -gt 0 ] || ids=(samples synthetic errors stdlib site-packages lib-test)
  for id in "${ids[@]}"; do
    local d="$WORK/compile/$id" base t0
    rm -rf "$d"
    base=$(corpus_list "$id" "$d")
    t0=$(date +%s)
    py pydump.py tree --base "$base" --list "$d/list" --out "$d/dumps" --tsv "$d/dumps.tsv"
    rc=0
    pa_arbace compile-check --corpus "$id" --dumps "$d/dumps" --tsv "$d/dumps.tsv" --known "$root/test/python/compile-known.edn" \
      --results "$d/results.edn" --ops "$d/ops.edn" ${record:+--record} || rc=$?
    echo "  $(( $(date +%s) - t0 )) s"
    [ $rc -gt $worst ] && worst=$rc
  done
  return $worst
}

# stdlib_lib: the pinned tarball's Lib, sys.path's standard library until python/Lib is vendored (PY6; survey §6.6)
stdlib_lib() {
  local top="$root/.tmp/repr-python/Python-3.14.10"
  [ -d "$top/Lib" ] || "$root/bin/repr-python" pins --fetch >/dev/null
  echo "$top/Lib"
}

# the host's side of the runtime (arbace.python.run): its work directory and a run's id for its scratch
pyi_env() { export PYI_ROOT="$root" PYI_WORK="$WORK" PYI_RUN_ID="$$"; }

cmd_repl() {
  pyi_env
  pa_arbace repl --lib "$(stdlib_lib)"
}

cmd_run() {
  [ $# -ge 1 ] || die "usage: bin/pyi run FILE.py [ARGS...]"
  local f d name argv0=$1
  case $1 in /*) f=$1 ;; *) f=$caller_pwd/$1 ;; esac
  f=$(cd "$(dirname "$f")" && pwd)/$(basename "$f")
  [ -f "$f" ] || die "no file $1"
  name=$(basename "$f")
  d=$(mktemp -d "$WORK/run.XXXXXX")
  echo "$name" > "$d/list"
  py pydump.py tree --full --base "$(dirname "$f")" --list "$d/list" --out "$d/dumps" --tsv "$d/tsv" >/dev/null
  local rc=0
  shift
  pyi_env
  pa_arbace run --dump "$d/dumps/$name.ae" --file "$f" --lib "$(stdlib_lib)" --argv0 "$argv0" -- "$@" || rc=$?
  rm -rf "$d"
  return $rc
}

RT="$WORK/runtime"
tamago_go() { (cd "$RT" && env GOROOT= PATH="${ARBACE_GOROOT:-/root/tamago-go}/bin:$PATH" GOCACHE="$WORK/gocache" GOFLAGS=-mod=mod CGO_ENABLED=0 GOTOOLCHAIN=local "$@"); }

runtime_print() {
  local out=$1
  rm -rf "$out"; mkdir -p "$out/py"
  printf 'module arbace\n\ngo 1.27\n' > "$out/go.mod"
  ARBACE_PATH="$root" "$root/bin/repr-go" print "$root/go/arbace/py.ae" "$out/py" >/dev/null
}

runtime_read() {
  local src=$1 out=$2
  rm -rf "$out"
  (cd "$src" && "$root/bin/repr-go" read --full --tests --goos linux --goarch amd64 --out "$out" ./py) > "$out.log" 2>&1 \
    || { cat "$out.log" >&2; die "the runtime's Go does not read (log $out.log)"; }
}

cmd_runtime() {
  local verb=${1:-}
  case $verb in
    print) runtime_print "$RT"; echo "the runtime's Go in $RT/py: edit it there, then bin/pyi runtime read" ;;
    read)
      [ -d "$RT/py" ] || die "no $RT/py: bin/pyi runtime print first"
      runtime_read "$RT" "$WORK/runtime-forms"
      rm -rf "$root/go/arbace/py" "$root/go/arbace/py.ae"
      cp -r "$WORK/runtime-forms/go/arbace/py" "$WORK/runtime-forms/go/arbace/py.ae" "$root/go/arbace/"
      echo "go/arbace/py read from $RT/py ($(ls "$root/go/arbace/py" | wc -l) files)" ;;
    vet)
      [ -d "$RT/py" ] || runtime_print "$RT"
      tamago_go gofmt -l py | sed 's/^/not gofmt: /' | grep . && die "gofmt the runtime's Go first"
      tamago_go go vet ./py
      tamago_go go test ./py ;;
    check)
      local rc=0 t="$WORK/runtime-check" p
      runtime_print "$t/src"
      runtime_read "$t/src" "$t/forms"
      if diff -r "$root/go/arbace/py" "$t/forms/go/arbace/py" >/dev/null && cmp -s "$root/go/arbace/py.ae" "$t/forms/go/arbace/py.ae"; then
        echo "runtime: go/arbace/py printed and read again: the same forms"
      else
        echo "runtime: go/arbace/py printed and read again DIFFERS (diff -r go/arbace/py $t/forms/go/arbace/py)"; rc=1
      fi
      pa_arbace runtime-ops || rc=1
      local n=0 bad=0
      for p in "$root"/test/python/pyi/*.py; do
        n=$((n + 1))
        local want got
        want=$(cd "$(dirname "$p")" && smoke_run python3 -I "$(basename "$p")")
        got=$(cd "$(dirname "$p")" && smoke_run "$root/bin/pyi" run "$(basename "$p")")
        if [ "$want" = "$got" ]; then echo "  pass $(basename "$p")"; else
          echo "  FAIL $(basename "$p")"; diff <(echo "$want") <(echo "$got") | head -10; bad=$((bad + 1)); fi
      done
      echo "runtime: $n programs of test/python/pyi run by pyi as by the oracle: $((n - bad)) equal"
      [ $bad -eq 0 ] || rc=1
      return $rc ;;
    *) die "usage: bin/pyi runtime print|read|vet|check" ;;
  esac
}

# smoke_run CMD...: the run's stdout, its exit status and stderr's last line, for comparing pyi with the oracle
smoke_run() {
  local o e rc=0
  o=$(mktemp "$WORK/smoke.XXXXXX"); e=$(mktemp "$WORK/smoke.XXXXXX")
  timeout 120 env HOME="$WORK" TMPDIR="$WORK" "$@" > "$o" 2> "$e" || rc=$?
  cat "$o"; echo "status $rc"; echo "stderr $(tail -n 1 "$e")"
  rm -f "$o" "$e"
}

command -v python3 >/dev/null || die "no python3 (the oracle)"
case "${1:-}" in
  gen) shift; cmd_gen "$@" ;;
  record-ref) shift; cmd_record_ref "$@" ;;
  scope-check) shift; cmd_scope_check "$@" ;;
  compile-check) shift; cmd_compile_check "$@" ;;
  run) shift; mkdir -p "$WORK"; cmd_run "$@" ;;
  repl) shift; mkdir -p "$WORK"; cmd_repl "$@" ;;
  runtime) shift; mkdir -p "$WORK"; cmd_runtime "$@" ;;
  *) sed -n '2,44p' "$0"; exit 2 ;;
esac

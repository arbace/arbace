#!/bin/bash
# pyi, the evaluator of Python forms (doc/python/PYTHON-SURVEY.md §6, PYS2 (a)): so far (PY4) no interpreter, only its
# corpora and their references, CPython 3.14.10's runs (GTS207 (a), PYS14 (a), PYS15 (a)). Out of gate_key and the gate
# (PYS18 (a)); stage 0 only runs the generator (test/python/gen.ae); the programs and Lib/test's modules are run by the
# oracle under .tmp/repr-python/pyi only (HOME and TMPDIR there, regrtest's resources off: no network).
#
#   bin/pyi gen [--check]          the synthetic corpus (survey §8.3): test/python/gen.ae on stage 0 writes
#                                  test/python/synth/ (ops, datamodel, builtins, constructs, paths; MANIFEST); --check
#                                  generates it into .tmp and requires it equal to the committed files, the constructs
#                                  covering every node class of the ast, the builtins every public method of their types,
#                                  every program compiling
#   bin/pyi record-ref [--check] [CORPUS...]
#                                  the reference runs (default: synthetic samples language-core): each program of
#                                  synthetic and samples run by CPython 3.14.10 with PYTHONHASHSEED=0 (tools/pydump/refs.py),
#                                  twice; status, stdout's SHA-256, size, first line and stderr's last line into
#                                  test/python/ref-cpython314.edn; Lib/test's language-core modules (corpora.edn) by
#                                  regrtest, each test method's outcome into test/python/ref-cpython314-lib-test.edn
#                                  (sys.implementation.name "cpython"); an entry the two runs disagree on or whose output
#                                  names the machine is written :excluded with its reason; the seconds into
#                                  test/python/ref-costs.edn. --check: two more runs, each reproducing every reference
#   bin/pyi scope-check [--record] [CORPUS...]
#                                  PY5a: every read file's symbol table by arbace.python.scope against CPython's own
#                                  (tools/pydump/pydump.py scopes): the corpora of test/python/corpora.edn (default:
#                                  samples synthetic errors stdlib site-packages lib-test), against test/python/scope-known.edn
#   bin/pyi compile-check [--full] [--record] [CORPUS...]
#                                  PY5a: every read file compiled to pyi's IR (arbace.python.compile) and the IR
#                                  verified (doc/python/PYI-SPEC.md §4), against test/python/compile-known.edn;
#                                  --full (PY5b): the forms of mode :full, the runs' (check :compile-full)
#   bin/pyi run FILE.py            PY5b0: FILE read in mode :full (tools/pydump/pydump.py tree --full: its lines), compiled to
#                                  the IR and run by pyi's runtime go/arbace/py, interpreted by goi on stage 0 (PY5a's DECISION
#                                  (a)); the program's stdout, stderr and exit status
#   bin/pyi run FILE.py ARGS...    PY5e: sys.argv [FILE ARGS...], sys.path [FILE's directory, the pinned tarball's Lib];
#                                  imports, exec, eval and compile compiled by the host (arbace.python.run, the IR kept in
#                                  .tmp/repr-python/pyi/ir-cache by the source's and the compiler's SHA-256)
#   bin/pyi repl [--check]         PY5e: python3's basic REPL (go/arbace/py's repl.go): statements from stdin, prompts on
#                                  stderr, expression statements' values displayed (sys.displayhook, builtins._); --check:
#                                  test/python/pyi/*.in fed to it and to python3 -q -i, stdout, status and stderr
#                                  byte for byte
#   bin/pyi lib-test [--oracle] [MODULE...]
#                                  PY5e: Lib/test's language-core modules run by pyi (test/python/libtest.py: unittest's
#                                  loader, each test's outcome), judged per method against ref-cpython314-lib-test.edn;
#                                  a module that does not import classed :module-import; --oracle: the driver by python3
#   bin/pyi runtime print|read|vet|check
#                                  PY5b0, the runtime's sources (doc/python/PYI-SPEC.md §8): go/arbace/py's Go forms (mode :full,
#                                  lossless) printed as a Go module into .tmp/repr-python/pyi/runtime (print), edited there,
#                                  read back into go/arbace/py (read); vet: the Go there (printed first when absent) gofmt
#                                  clean, then go vet and go test by TamaGo's go;
#                                  check: printed and read again equal to the committed forms, the runtime's operations
#                                  arbace.python.ir/ops's (runtime-ops), the programs of test/python/pyi/ run by bin/pyi run
#                                  equal to the oracle's runs (stdout, status, stderr's last line), and repl --check
# Environment: REPR_PYTHON_SRC as for bin/repr-python (the tarball's source).
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash"
caller_pwd=$PWD
cd "$root"

WORK="$root/.tmp/repr-python/pyi"
SYNTH="$root/test/python/synth"
REF="$root/test/python/ref-cpython314.edn"
REF_LT="$root/test/python/ref-cpython314-lib-test.edn"
COSTS="$root/test/python/ref-costs.edn"
COSTS_LT="$root/test/python/ref-costs-lib-test.edn"
die() { echo "pyi: $*" >&2; exit 1; }

arbace_exe() {
  if [ -n "${ARBACE_HOST_EXE:-}" ]; then echo "$ARBACE_HOST_EXE"; return; fi
  local arch main
  case $(uname -m) in x86_64) arch=amd64 ;; aarch64) arch=arm64 ;; *) arch=$(uname -m) ;; esac
  if [ -x "$root/target/seed/$arch/arbace" ]; then echo "$root/target/seed/$arch/arbace"; return; fi
  main=$(cd "$(git rev-parse --git-common-dir)/.." && pwd)
  if [ -x "$main/target/seed/$arch/arbace" ]; then echo "$main/target/seed/$arch/arbace"; return; fi
  die "no stage 0 (bin/seed --build, or ARBACE_HOST_EXE)"
}
py() { local s=$1; shift; python3 -I -S -B "$root/tools/pydump/$s" "$@"; }

check_oracle() {
  local want have
  want=$(sed -n 's/^sys\.version //p' "$root/tools/pydump/PYTHON_VERSION")
  have=$(python3 -I -c 'import sys; print(sys.version)')
  [ "$want" = "$have" ] || die "the oracle is '$have', tools/pydump/PYTHON_VERSION pins '$want'"
  [ "$(python3 -I -c 'import sys; print(sys.implementation.name)')" = cpython ] || die "the oracle is not CPython"
}

cmd_gen() {
  local check=${1:-}
  if [ "$check" = --check ]; then
    local d="$WORK/gen"; rm -rf "$d"; mkdir -p "$d"
    "$(arbace_exe)" "$root/test/python/gen.ae" "$d"
    local bad=0
    diff -r "$d" "$SYNTH" > "$WORK/gen.diff" || { echo "gen --check: the generated corpus differs from test/python/synth (bin/pyi gen):"; head -20 "$WORK/gen.diff"; bad=1; }
    (cd "$SYNTH/constructs" && py corpus.py samples . .) || bad=1
    (cd "$SYNTH" && py corpus.py samples . . | tail -1)
    local t
    for t in str bytes list tuple dict set frozenset int float complex bool range memoryview slice; do
      py corpus.py methods "$t" "$SYNTH/builtins/$t.py" | tail -1 | grep -q ' of ' || bad=1
      py corpus.py methods "$t" "$SYNTH/builtins/$t.py" >/dev/null || { py corpus.py methods "$t" "$SYNTH/builtins/$t.py" | grep UNCOVERED; bad=1; }
    done
    py corpus.py methods bytearray "$SYNTH/builtins/bytearray.py" "$SYNTH/builtins/bytearray-shared.py" >/dev/null \
      || { py corpus.py methods bytearray "$SYNTH/builtins/bytearray.py" "$SYNTH/builtins/bytearray-shared.py" | grep UNCOVERED; bad=1; }
    if [ $bad = 0 ]; then echo "gen --check: $(wc -l < "$SYNTH/MANIFEST") programs as committed; every node class and builtin method covered"; else return 1; fi
  else
    rm -rf "$SYNTH"; mkdir -p "$SYNTH"
    "$(arbace_exe)" "$root/test/python/gen.ae" "$SYNTH"
  fi
}

# the language core's modules, from test/python/corpora.edn (the corpus :language-core's paths, as module names)
core_modules() {
  "$(arbace_exe)" -e "(println (arbace.string/join \",\" (map #(-> % (subs 9) (arbace.string/replace #\"\\.py\$\" \"\")) (get-in (first (filter #(= :language-core (:id %)) (:corpora (read-string (slurp \"$root/test/python/corpora.edn\"))))) [:where :paths]))))"
}

tarball_test() {
  local top="$root/.tmp/repr-python/Python-3.14.10"
  [ -d "$top/Lib/test" ] || "$root/bin/repr-python" pins --fetch >/dev/null
  mkdir -p "$WORK/pypath"; ln -sfn "$top/Lib/test" "$WORK/pypath/test"
}

# run_programs TAG: the synthetic corpus and the samples, one TSV
run_programs() {
  local tag=$1 d="$WORK/$1"
  rm -rf "$d"; mkdir -p "$d"
  { sed 's|^|synth/|' "$SYNTH/MANIFEST"; (cd "$root/test/python/samples" && ls *.py | sed 's|^|samples/|'); } > "$d/list"
  mkdir -p "$d/base"; ln -sfn "$SYNTH" "$d/base/synth"; ln -sfn "$root/test/python/samples" "$d/base/samples"
  py refs.py programs --base "$d/base" --list "$d/list" --work "$d" --out "$d/programs.tsv"
}

run_libtest() {
  local tag=$1 d="$WORK/$1"
  mkdir -p "$d"
  tarball_test
  py refs.py libtest --pypath "$WORK/pypath" --modules "$(core_modules)" --work "$d" --out "$d/libtest.tsv"
}

header() { # FILE WHAT
  cat > "$1" <<HDR
;; CPython 3.14.10's reference runs of $2, as data (doc/python/PYTHON-SURVEY.md §8.1, PYS14 (a), PYS15 (a); GTS207 (a)):
;; one map per line, sorted by :id. Programs: :status the exit status (128+signal, :timeout), :stdout the SHA-256 of
;; the standard output, :bytes its size, :first its first line (80 chars), :stderr-last the last non-blank line of the
;; standard error. Lib/test: :outcome :ok, :skipped (:reason), :failure or :error per test method, :module true lines
;; with regrtest's exit status. :excluded names an entry kept out of the references: the two recording runs disagree,
;; or its output names the machine (an address, the architecture, the C library, a size): bin/pyi record-ref --check
;; reproduces the others. Made by: bin/pyi record-ref ($(python3 -I -c 'import sys; print(sys.version.split()[0], sys.implementation.name)'),
;; python3 -s -P -B, PYTHONHASHSEED=0 LC_ALL=C.UTF-8 TZ=UTC PYTHONIOENCODING=utf-8; regrtest -u none --randseed 1).
;; date: $(date -u +%F)
HDR
}

cmd_record_ref() {
  local check="" ids=()
  while [ $# -gt 0 ]; do case $1 in --check) check=1; shift ;; *) ids+=("$1"); shift ;; esac; done
  [ ${#ids[@]} -gt 0 ] || ids=(programs language-core)
  check_oracle
  local id rc=0
  for id in "${ids[@]}"; do
    case $id in
      synthetic|samples|programs)
        if [ -n "$check" ]; then
          run_programs check1; run_programs check2
          py refs.py check --kind programs --ref "$REF" --run "$WORK/check1/programs.tsv" || rc=1
          py refs.py check --kind programs --ref "$REF" --run "$WORK/check2/programs.tsv" || rc=1
        else
          run_programs rec1; run_programs rec2
          header "$WORK/header.txt" "the synthetic corpus (test/python/synth) and the samples (test/python/samples)"
          py refs.py record --kind programs --a "$WORK/rec1/programs.tsv" --b "$WORK/rec2/programs.tsv" --out "$REF" \
            --header "$WORK/header.txt" --costs "$COSTS"
        fi ;;
      language-core)
        if [ -n "$check" ]; then
          run_libtest check1; run_libtest check2
          py refs.py check --kind libtest --ref "$REF_LT" --run "$WORK/check1/libtest.tsv" || rc=1
          py refs.py check --kind libtest --ref "$REF_LT" --run "$WORK/check2/libtest.tsv" || rc=1
        else
          run_libtest rec1; run_libtest rec2
          header "$WORK/header.txt" "Lib/test's language-core modules (test/python/corpora.edn), per test method"
          py refs.py record --kind libtest --a "$WORK/rec1/libtest.tsv" --b "$WORK/rec2/libtest.tsv" --out "$REF_LT" \
            --header "$WORK/header.txt" --costs "$COSTS_LT"
        fi ;;
      *) die "no corpus $id (programs, language-core)" ;;
    esac
  done
  return $rc
}

# corpus_list ID DIR: the corpus's base directory (stdout) and its files' list into DIR/list
corpus_list() {
  local id=$1 d=$2 line base paths excl
  line=$("$(arbace_exe)" -e "(let [c (first (filter #(= :$id (:id %)) (:corpora (read-string (slurp \"$root/test/python/corpora.edn\")))))] (when c (let [w (:where c)] (println (if (:pin w) (name (:pin w)) (str \"root:\" (:root w))) (arbace.string/join \",\" (:paths w)) (if (seq (:exclude w)) (arbace.string/join \",\" (:exclude w)) \"-\")))))")
  [ -n "$line" ] || die "no corpus $id in test/python/corpora.edn"
  read -r base paths excl <<< "$line"
  case $base in
    cpython-3.14.10) base="$root/.tmp/repr-python/Python-3.14.10"; [ -d "$base/Lib" ] || "$root/bin/repr-python" pins --fetch >/dev/null ;;
    site-packages) base="$root/.tmp/repr-python/site-packages/$(uname -m)"; [ -d "$base" ] || "$root/bin/repr-python" pins --fetch >/dev/null ;;
    root:*) base="$root/${base#root:}" ;;
  esac
  local -a args=(); IFS=, read -ra pa <<< "$paths"; args+=("${pa[@]}")
  if [ "$excl" != - ]; then IFS=, read -ra ea <<< "$excl"; for e in "${ea[@]}"; do args+=(--exclude "$e"); done; fi
  mkdir -p "$d"
  (cd "$base" && py corpus.py list "$base" "${args[@]}") > "$d/list"
  echo "$base"
}

pa_arbace() {
  ARBACE_PATH="$root" GOMEMLIMIT=${PYI_GOMEMLIMIT:-1500MiB} GOMAXPROCS=${PYI_THREADS:-4} "$(arbace_exe)" -m arbace.python "$@"
}

cmd_scope_check() {
  local record="" ids=() rc=0 worst=0 id
  while [ $# -gt 0 ]; do case $1 in --record) record=1; shift ;; *) ids+=("$1"); shift ;; esac; done
  [ ${#ids[@]} -gt 0 ] || ids=(samples synthetic errors stdlib site-packages lib-test)
  for id in "${ids[@]}"; do
    local d="$WORK/scope/$id" base t0
    rm -rf "$d"
    base=$(corpus_list "$id" "$d")
    t0=$(date +%s)
    py pydump.py tree --base "$base" --list "$d/list" --out "$d/dumps" --tsv "$d/dumps.tsv"
    py pydump.py scopes --base "$base" --list "$d/list" --out "$d/scopes"
    rc=0
    pa_arbace scope-check --corpus "$id" --dumps "$d/dumps" --scopes "$d/scopes" --known "$root/test/python/scope-known.edn" \
      --results "$d/results.edn" ${record:+--record} || rc=$?
    echo "  $(( $(date +%s) - t0 )) s"
    [ $rc -gt $worst ] && worst=$rc
  done
  return $worst
}

cmd_compile_check() {
  local record="" full="" ids=() rc=0 worst=0 id
  while [ $# -gt 0 ]; do case $1 in --record) record=1; shift ;; --full) full=1; shift ;; *) ids+=("$1"); shift ;; esac; done
  [ ${#ids[@]} -gt 0 ] || ids=(samples synthetic errors stdlib site-packages lib-test)
  for id in "${ids[@]}"; do
    local d="$WORK/compile${full:+-full}/$id" base t0
    rm -rf "$d"
    base=$(corpus_list "$id" "$d")
    t0=$(date +%s)
    py pydump.py tree ${full:+--full} --base "$base" --list "$d/list" --out "$d/dumps" --tsv "$d/dumps.tsv"
    rc=0
    pa_arbace compile-check ${full:+--check compile-full} --corpus "$id" --dumps "$d/dumps" --tsv "$d/dumps.tsv" --known "$root/test/python/compile-known.edn" \
      --results "$d/results.edn" --ops "$d/ops.edn" ${record:+--record} || rc=$?
    echo "  $(( $(date +%s) - t0 )) s"
    [ $rc -gt $worst ] && worst=$rc
  done
  return $worst
}

# stdlib_lib: the pinned tarball's Lib, sys.path's standard library until python/Lib is vendored (PY6; survey §6.6)
stdlib_lib() {
  local top="$root/.tmp/repr-python/Python-3.14.10"
  [ -d "$top/Lib" ] || "$root/bin/repr-python" pins --fetch >/dev/null
  echo "$top/Lib"
}

# the host's side of the runtime (arbace.python.run): its work directory and a run's id for its scratch
pyi_env() { export PYI_ROOT="$root" PYI_WORK="$WORK" PYI_RUN_ID="$$"; }

cmd_repl() {
  if [ "${1:-}" = --check ]; then repl_check; return; fi
  pyi_env
  pa_arbace repl --lib "$(stdlib_lib)"
}

# repl_check: test/python/pyi/*.in fed to bin/pyi repl and to the oracle's basic REPL (python3 -q -i): stdout, the
# status and stderr (prompts, tracebacks with their source lines and carets) equal byte for byte
repl_check() {
  local p n=0 bad=0 want got
  for p in "$root"/test/python/pyi/*.in; do
    n=$((n + 1))
    want=$(repl_run "$p" python3 -q -i)
    got=$(repl_run "$p" "$root/bin/pyi" repl)
    if [ "$want" = "$got" ]; then echo "  pass $(basename "$p")"; else
      echo "  FAIL $(basename "$p")"; diff <(echo "$want") <(echo "$got") | head -10; bad=$((bad + 1)); fi
  done
  echo "repl: $n sessions of test/python/pyi run by pyi's REPL as by the oracle's: $((n - bad)) equal"
  [ $bad -eq 0 ]
}

repl_run() {
  local in=$1 o e rc=0; shift
  o=$(mktemp "$WORK/smoke.XXXXXX"); e=$(mktemp "$WORK/smoke.XXXXXX")
  timeout 300 env HOME="$WORK" TMPDIR="$WORK" "$@" < "$in" > "$o" 2> "$e" || rc=$?
  cat "$o"; echo "status $rc"; cat "$e"
  rm -f "$o" "$e"
}

cmd_run() {
  [ $# -ge 1 ] || die "usage: bin/pyi run FILE.py [ARGS...]"
  local f d name argv0=$1
  case $1 in /*) f=$1 ;; *) f=$caller_pwd/$1 ;; esac
  f=$(cd "$(dirname "$f")" && pwd)/$(basename "$f")
  [ -f "$f" ] || die "no file $1"
  name=$(basename "$f")
  d=$(mktemp -d "$WORK/run.XXXXXX")
  echo "$name" > "$d/list"
  py pydump.py tree --full --base "$(dirname "$f")" --list "$d/list" --out "$d/dumps" --tsv "$d/tsv" >/dev/null
  local rc=0
  shift
  pyi_env
  pa_arbace run --dump "$d/dumps/$name.ae" --file "$f" --lib "$(stdlib_lib)" --argv0 "$argv0" -- "$@" || rc=$?
  rm -rf "$d"
  return $rc
}

# lib-test [--oracle] [MODULE...]: Lib/test's language-core modules (corpora.edn) run by pyi through
# test/python/libtest.py (unittest's loader, each test's outcome), judged per test method against 177's references
# (test/python/ref-cpython314-lib-test.edn): equal outcomes pass; a module that does not import is one case, its
# methods classed :module-import with the first error (survey §8.1); anything else fails. --oracle runs the driver
# by python3 instead (the judge's control: every method equal but the references' :excluded)
cmd_lib_test() {
  local oracle="" mods=() m d="$WORK/lib-test" lib rc=0
  while [ $# -gt 0 ]; do case $1 in --oracle) oracle=1; shift ;; *) mods+=("$1"); shift ;; esac; done
  [ ${#mods[@]} -gt 0 ] || IFS=, read -ra mods <<< "$(core_modules)"
  lib=$(stdlib_lib); rm -rf "$d"; mkdir -p "$d"
  for m in "${mods[@]}"; do
    if [ -n "$oracle" ]; then
      (cd "$d" && timeout 900 env PYTHONHASHSEED=0 LC_ALL=C.UTF-8 TZ=UTC PYTHONIOENCODING=utf-8 HOME="$WORK" TMPDIR="$WORK" PYTHONPATH="$lib" \
        python3 -s -P -B "$root/test/python/libtest.py" "$m" > "$d/$m.out" 2> "$d/$m.err") || true
    else
      (cd "$d" && timeout 1800 "$root/bin/pyi" run "$root/test/python/libtest.py" "$m" > "$d/$m.out" 2> "$d/$m.err") || true
    fi
    [ -s "$d/$m.out" ] || echo "IMPORT	$(grep -v '^ ' "$d/$m.err" | tail -1)" > "$d/$m.out"
    awk -F'\t' -v m="$m" -v ref="$REF_LT" '
      BEGIN {
        while ((getline l < ref) > 0) {
          if (l !~ /^\{:id "/) continue
          id = l; sub(/^\{:id "/, "", id); sub(/".*/, "", id)
          if (index(id, m "/") != 1 || l ~ /:module true/) continue
          if (l ~ /:excluded/) { excl[substr(id, length(m) + 2)] = 1; continue }
          o = l; sub(/.*:outcome :/, "", o); sub(/[ }].*/, "", o)
          want[substr(id, length(m) + 2)] = o; n++
        }
      }
      $1 == "IMPORT" { imp = $2 }
      $1 == "CASE" { got[$2] = $3; why[$2] = $4 }
      END {
        for (t in want) {
          if (t in got && got[t] == want[t]) pass++
          else if (imp != "") classed++
          else { fail++; if (shown++ < 5) printf "  FAIL %s/%s: %s, CPython %s %s\n", m, t, (t in got ? got[t] : "not run"), want[t], why[t] }
        }
        printf "%s\t%d\t%d\t%d\t%d\t%s\n", m, n, pass, classed, fail, imp > "/dev/stderr"
        printf "lib-test %s: %d methods: %d equal, %d classed :module-import, %d failing%s\n", m, n, pass, classed, fail, (imp != "" ? " (" imp ")" : "")
        exit (fail > 0)
      }' "$d/$m.out" 2>> "$d/summary.tsv" || rc=1
  done
  awk -F'\t' '{n += $2; p += $3; c += $4; f += $5} END {printf "lib-test: %d modules, %d methods: %d equal, %d classed, %d failing\n", NR, n, p, c, f}' "$d/summary.tsv"
  return $rc
}

# pyi's AOT (PY8; doc/python/PYTHON-SURVEY.md §7, PYS13 (a); PYI-SPEC.md §10): the IR translated to Go forms by
# arbace.python.aot (on the tools' host), printed by repr/go (bin/build-go --print-only) and built with TamaGo's go over
# go/arbace/py as printed by runtime print (the light tier, as bin/si's AOT: not Arbace's executable), one small
# executable per program; its modules' packages printed once, kept by their IR's hash (AOT/pkgs-GEN, GEN the
# generator's digest), so the stdlib's modules are compiled once for every program
AOT="$WORK/aot"
aot_go() {
  (cd "$AOT/mod" && env GOROOT="${ARBACE_GOROOT:-/root/tamago-go}" GOTOOLCHAIN=local GOFLAGS= GOWORK=off GO111MODULE=on \
     GOPROXY=off CGO_ENABLED=0 GOCACHE="${PYI_AOT_GOCACHE:-$AOT/gocache}" GOMAXPROCS=${GOMAXPROCS:-4} \
     "${ARBACE_GOROOT:-/root/tamago-go}/bin/go" "$@")
}
aot_gen() { cat "$root/arbace/python/aot.ae" | sha256sum | cut -c1-16; }
# aot_module: the module the compiled programs build in: the runtime (go/arbace/py and go/arbace/libm printed,
# kept by their forms' digest), the packages of arbace/pyaot
aot_module() {
  mkdir -p "$AOT/mod/pyaot"
  printf 'module arbace\n\ngo 1.27\n' > "$AOT/mod/go.mod"
  local key; key=$( (cd "$root" && find go/arbace/py.ae go/arbace/py go/arbace/libm.ae go/arbace/libm -type f | LC_ALL=C sort | xargs sha256sum) | sha256sum | cut -c1-16)
  if [ "$(cat "$AOT/mod/runtime.key" 2>/dev/null)" != "$key" ]; then
    runtime_print "$AOT/rt"
    rm -rf "$AOT/mod/py" "$AOT/mod/libm"; mkdir -p "$AOT/mod/py" "$AOT/mod/libm"
    local f
    for f in "$AOT/rt"/py/*.go; do case $f in *_test.go) ;; *) cp "$f" "$AOT/mod/py/" ;; esac; done
    for f in "$AOT/rt"/libm/*.go; do case $f in *_test.go) ;; *) cp "$f" "$AOT/mod/libm/" ;; esac; done
    echo "$key" > "$AOT/mod/runtime.key"
  fi
  # the host's compiler for what a compiled program compiles at run time (arbace.python.aot compile-server)
  cat > "$AOT/compiler.sh" <<SH
#!/bin/sh
exec env ARBACE_PATH="$root" PYI_ROOT="$root" PYI_WORK="$WORK" PYI_RUN_ID="aot\$\$" GOMEMLIMIT=\${PYI_GOMEMLIMIT:-1500MiB} \
  GOMAXPROCS=\${PYI_THREADS:-4} "$(arbace_exe)" -m arbace.python.aot compile-server
SH
  chmod +x "$AOT/compiler.sh"
}
# aot_compile PKG FILE OUT: FILE compiled into the executable OUT; on a refusal OUT.refused holds the reason, on a
# compile-time error of the program OUT.cout, .cerr, .crc its outcome (CPython's: the SyntaxError, status 1)
aot_compile() {
  local pkg=$1 file=$2 out=$3 gen; gen=$(aot_gen)
  local src="$AOT/src/$pkg" w="$AOT/print/$pkg" log="$AOT/log/$pkg" cache="$AOT/pkgs-$gen"
  mkdir -p "$AOT/log" "$cache" "$(dirname "$out")"
  rm -rf "$src" "$w" "$AOT/mod/pyaot/$pkg" "$out" "$out".{refused,cout,cerr,crc}
  local rc=0
  pyi_env
  ARBACE_PATH="$root" GOMEMLIMIT=${PYI_GOMEMLIMIT:-1500MiB} GOMAXPROCS=${PYI_THREADS:-4} \
    "$(arbace_exe)" -m arbace.python.aot program "$file" "$src" "$pkg" "$(stdlib_lib)" "$cache" > "$log.compile" 2>&1 || rc=$?
  if [ $rc = 4 ]; then
    local e; e=$(sed -n 's/^error //p' "$log.compile" | head -1)
    case $e in
      SyntaxError:*) : > "$out.cout"; echo "${e%%$'\x00'*}" > "$out.cerr"; echo 1 > "$out.crc"; return 0 ;;
    esac
    echo "the compiler refuses it: $e" > "$out.refused"; return 0
  elif [ $rc != 0 ]; then
    echo "arbace.python.aot fails: $(grep -m1 'rror\|xception' "$log.compile" || tail -1 "$log.compile")" > "$out.refused"; return 0
  fi
  if [ -d "$src/go" ] && ! "$root/bin/build-go" --print-only --module arbace --layout lines --work "$w" "$src" > "$log.print" 2>&1; then
    echo "repr/go does not print it: $(tail -1 "$log.print")" > "$out.refused"; return 0
  fi
  local nm st
  while read -r nm st; do
    if [ "$st" = new ]; then rm -rf "$cache/$nm"; cp -r "$w/mod/pyaot/$nm" "$cache/$nm"; fi
    [ -d "$AOT/mod/pyaot/$nm" ] || cp -r "$cache/$nm" "$AOT/mod/pyaot/$nm"
  done < <(awk '$1 == "module" && $4 != "-" {print $4, $5} $1 == "main" {print $2, $3}' "$log.compile")
  mkdir -p "$AOT/mod/pyaot/$pkg"; cp -r "$w/mod/pyaot/$pkg/prog" "$AOT/mod/pyaot/$pkg/"
  rm -rf "$src" "$w"
  if ! aot_go build -p 2 -trimpath -o "$out" "./pyaot/$pkg/prog" > "$log.build" 2>&1; then
    echo "go build fails: $(grep -m1 . "$log.build")" > "$out.refused"; return 0
  fi
}
# aot_run OUT ARGS...: the compiled program run as bin/pyi run runs pyi (its compile-time outcome when it has one)
aot_run() {
  local out=$1; shift
  if [ -f "$out.crc" ]; then cat "$out.cout"; cat "$out.cerr" >&2; return "$(cat "$out.crc")"; fi
  PYI_AOT_COMPILER="$AOT/compiler.sh" "$out" "$@"
}

# check --aot: the synthetic corpus and the samples (177's references, test/python/ref-cpython314.edn) compiled and run,
# each judged against CPython's reference (status, stdout's SHA-256, stderr's last line) and against the same program on
# the loop (PYI_AOT_LOOP: the same executable, every code object on the dispatch loop) and pyi's run (bin/pyi run, on
# goi; kept by the runtime's, the compiler's and the program's digest); see cmd_check_aot
aot_list() {
  { sed 's|^|synth/|' "$SYNTH/MANIFEST"; (cd "$root/test/python/samples" && ls *.py | sed 's|^|samples/|'); }
}
aot_file() { case $1 in synth/*) echo "$SYNTH/${1#synth/}" ;; samples/*) echo "$root/test/python/samples/${1#samples/}" ;; esac; }
# run_one DIR NAME CMD...: CMD in a fresh directory as refs.py runs the oracle (an empty stdin, HOME and TMPDIR inside
# WORK, the fixed environment, 120 s): DIR/NAME.out, .err, .rc, .time
run_one() {
  local d=$1 nm=$2; shift 2
  local cwd="$d/$nm.cwd"; rm -rf "$cwd"; mkdir -p "$cwd" "$WORK/home" "$WORK/tmp"
  local t0 t1 rc=0
  t0=$(date +%s%N)
  (cd "$cwd" && timeout "${PYI_AOT_TIMEOUT:-120}" env -i PATH=/usr/bin:/bin HOME="$WORK/home" TMPDIR="$WORK/tmp" PYTHONHASHSEED=0 \
     LC_ALL=C.UTF-8 TZ=UTC PYTHONIOENCODING=utf-8 PYTHONDONTWRITEBYTECODE=1 ARBACE_HOST_EXE="${ARBACE_HOST_EXE:-}" \
     ${PYI_AOT_LOOP:+PYI_AOT_LOOP=1} PYI_AOT_COMPILER="$AOT/compiler.sh" PYI_AOT_STATS="$d/$nm.stats" \
     "$@" < /dev/null > "$d/$nm.out" 2> "$d/$nm.err") || rc=$?
  t1=$(date +%s%N)
  [ $rc = 124 ] && rc=timeout
  echo "$rc" > "$d/$nm.rc"; echo $(( (t1 - t0) / 1000000 )) > "$d/$nm.time"
  rm -rf "$cwd"
}
# outcome DIR NAME: "STATUS SHA256 STDERR-LAST" of a run (the reference's fields)
outcome() {
  printf '%s\t%s\t%s\n' "$(cat "$1/$2.rc")" "$(sha256sum < "$1/$2.out" | cut -c1-64)" "$(grep -v '^[[:space:]]*$' "$1/$2.err" | tail -1)"
}
pyi_key() {
  { (cd "$root" && find go/arbace/py.ae go/arbace/py go/arbace/libm.ae go/arbace/libm arbace/python arbace/python.ae \
       arbace/repr/python tools/pydump/pydump.py -type f | LC_ALL=C sort | xargs sha256sum); sha256sum < "$1"; } | sha256sum | cut -c1-24
}

cmd_check_aot() {
  local record="" pyi=1 ids=() id
  while [ $# -gt 0 ]; do case $1 in --record) record=1; shift ;; --no-pyi) pyi=""; shift ;; --only) ids+=("$2"); shift 2 ;; *) die "check --aot: unknown $1" ;; esac; done
  [ ${#ids[@]} -gt 0 ] || mapfile -t ids < <(aot_list)
  aot_module
  local d="$AOT/check" pc="$AOT/pyi-runs"; mkdir -p "$d" "$pc"
  : > "$d/runs.tsv"
  for id in "${ids[@]}"; do
    local f nm pkg exe t0 ct
    f=$(aot_file "$id"); [ -f "$f" ] || die "no program $id"
    nm=${id//\//__}; pkg=p_$(echo "$nm" | tr -c 'A-Za-z0-9\n' '_'); exe="$AOT/bin/$pkg"
    t0=$(date +%s%N); aot_compile "$pkg" "$f" "$exe"; ct=$(( ($(date +%s%N) - t0) / 1000000 ))
    rm -f "$d/$nm".*
    if [ -f "$exe.refused" ]; then
      printf '%s\trefused\t%s\t%s\n' "$id" "$ct" "$(cat "$exe.refused")" >> "$d/runs.tsv"; echo "  $id: refused: $(cat "$exe.refused")"; continue
    fi
    if [ -f "$exe.crc" ]; then
      cp "$exe.cout" "$d/$nm.aot.out"; cp "$exe.cerr" "$d/$nm.aot.err"; cp "$exe.crc" "$d/$nm.aot.rc"; echo 0 > "$d/$nm.aot.time"
      cp "$exe.cout" "$d/$nm.loop.out"; cp "$exe.cerr" "$d/$nm.loop.err"; cp "$exe.crc" "$d/$nm.loop.rc"; echo 0 > "$d/$nm.loop.time"
    else
      run_one "$d" "$nm.aot" "$exe" "$f"
      PYI_AOT_LOOP=1 run_one "$d" "$nm.loop" "$exe" "$f"
    fi
    local pk="" pyo=$'-\t-\t-'
    if [ -n "$pyi" ]; then
      pk=$(pyi_key "$f")
      if [ ! -f "$pc/$pk.rc" ]; then run_one "$pc" "$pk" "$root/bin/pyi" run "$f"; fi
      pyo=$(outcome "$pc" "$pk")
    fi
    printf '%s\tran\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$ct" "$(outcome "$d" "$nm.aot")" "$(outcome "$d" "$nm.loop")" "$pyo" \
      "$(cat "$d/$nm.aot.time")" "$(cat "$d/$nm.loop.time")" "$(cat "$pc/$pk.time" 2>/dev/null || echo -)" >> "$d/runs.tsv"
    [ -f "$d/$nm.aot.stats" ] && sed "s|^|$id\t|" "$d/$nm.aot.stats" >> "$d/stats.tsv"
    rm -f "$exe"
    echo "  $id: compiled $(cat "$d/$nm.aot.rc"), loop $(cat "$d/$nm.loop.rc")${pk:+, pyi $(cat "$pc/$pk.rc")}"
  done
  aot_cache_trim
  local arch; case $(uname -m) in x86_64) arch=amd64 ;; aarch64) arch=arm64 ;; *) arch=$(uname -m) ;; esac
  pa_arbace_aot judge --runs "$d/runs.tsv" --ref "$REF" --classes "$root/test/python/divergences-aot.edn" \
    --results "$d/results.edn" ${record:+--record "$root/test/python/check-aot-linux-$arch.edn"}
}
pa_arbace_aot() {
  ARBACE_PATH="$root" GOMEMLIMIT=${PYI_GOMEMLIMIT:-1500MiB} GOMAXPROCS=${PYI_THREADS:-4} "$(arbace_exe)" -m arbace.python.aot "$@"
}
# aot_cache_trim: Go's cache of the compiled programs kept under 2 GB
aot_cache_trim() {
  local c=${PYI_AOT_GOCACHE:-$AOT/gocache}
  [ -d "$c" ] || return 0
  if [ "$(du -sm "$c" | cut -f1)" -gt "${PYI_AOT_GOCACHE_MB:-2000}" ]; then aot_go clean -cache; fi
}

# bench [--pyi] [--record] [BM...]: pyperformance's pure-Python benchmarks (test/python/bench/benchmarks.tsv) as plain
# programs with fixed loops (the pyperf stand-in test/python/bench/pyperf.py), each run by CPython, compiled (pyi's AOT)
# and on the loop of the same executable (and with --pyi by pyi on goi): the whole process's seconds, the outputs
# compared with CPython's; --record writes test/python/bench-aot-linux-ARCH.edn
cmd_bench() {
  local record="" pyi="" bms=() b loops
  while [ $# -gt 0 ]; do case $1 in --record) record=1; shift ;; --pyi) pyi=1; shift ;; *) bms+=("$1"); shift ;; esac; done
  local src="$root/.tmp/repr-python/pyperformance-1.14.0/benchmarks"
  [ -d "$src" ] || "$root/bin/repr-python" pins --fetch >/dev/null
  aot_module
  local d="$AOT/bench"; mkdir -p "$d"; : > "$d/bench.tsv"
  while IFS=$'\t' read -r b loops; do
    case $b in '#'*|'') continue ;; esac
    if [ ${#bms[@]} -gt 0 ]; then case " ${bms[*]} " in *" $b "*) ;; *) continue ;; esac; fi
    local w="$d/$b"; rm -rf "$w"; mkdir -p "$w"
    cp "$src/$b/run_benchmark.py" "$root/test/python/bench/pyperf.py" "$w/"
    echo "LOOPS = $loops" > "$w/pyperf_loops.py"
    run_one "$d" "$b.cpython" python3 -s -B "$w/run_benchmark.py"
    local pkg=p_bench_$b exe="$AOT/bin/p_bench_$b" ct t0
    t0=$(date +%s%N); aot_compile "$pkg" "$w/run_benchmark.py" "$exe"; ct=$(( ($(date +%s%N) - t0) / 1000000 ))
    local st=ran why=""
    if [ -f "$exe.refused" ]; then st=refused; why=$(cat "$exe.refused")
    else
      run_one "$d" "$b.aot" "$exe" "$w/run_benchmark.py"
      PYI_AOT_LOOP=1 run_one "$d" "$b.loop" "$exe" "$w/run_benchmark.py"
      [ -n "$pyi" ] && run_one "$d" "$b.pyi" "$root/bin/pyi" run "$w/run_benchmark.py"
      rm -f "$exe"
      if [ "$(outcome "$d" "$b.aot")" != "$(outcome "$d" "$b.cpython")" ]; then st=differs; why="$(grep -v '^[[:space:]]*$' "$d/$b.aot.err" | tail -1)"; fi
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$b" "$loops" "$st" "$(cat "$d/$b.cpython.time")" "$(cat "$d/$b.aot.time" 2>/dev/null || echo -)" \
      "$(cat "$d/$b.loop.time" 2>/dev/null || echo -)" "$(cat "$d/$b.pyi.time" 2>/dev/null || echo -)" "$ct" "$why" | tee -a "$d/bench.tsv"
  done < "$root/test/python/bench/benchmarks.tsv"
  awk -F'\t' '$3 == "ran" {n++; c += $4; a += $5; l += $6} END {if (n) printf "bench: %d benchmarks ran as CPython: CPython %d ms, compiled %d ms, the loop %d ms (loop/compiled %.2f, compiled/CPython %.1f)\n", n, c, a, l, l / a, a / c}' "$d/bench.tsv"
  if [ -n "$record" ]; then
    local arch; case $(uname -m) in x86_64) arch=amd64 ;; aarch64) arch=arm64 ;; *) arch=$(uname -m) ;; esac
    { echo ";; pyi's AOT's speed (bin/pyi bench --record; doc/python/PYTHON-SURVEY.md, \"As built: PY8\"): pyperformance 1.14.0's"
      echo ";; pure-Python benchmarks as plain programs (test/python/bench), the whole process's milliseconds on the recording"
      echo ";; machine ($(uname -m), $(date -u +%F)): CPython 3.14.10, compiled, the loop of the same executable, pyi on goi (- not run);"
      echo ";; :result :ran (the output CPython's), :differs or :refused with the reason. Machine-dependent: not a reference."
      awk -F'\t' 'function esc(s) { gsub(/[\\"]/, "_", s); return s } {printf "{:id \"%s\" :loops %s :result :%s :cpython-ms %s :aot-ms %s :loop-ms %s :pyi-ms %s :compile-ms %s%s}\n", $1, $2, $3, $4, ($5 == "-" ? "nil" : $5), ($6 == "-" ? "nil" : $6), ($7 == "-" ? "nil" : $7), $8, ($9 == "" ? "" : " :reason \"" esc($9) "\"")}' "$d/bench.tsv"
    } > "$root/test/python/bench-aot-linux-$arch.edn"
  fi
}

cmd_aot() {
  [ $# -ge 1 ] || die "usage: bin/pyi aot FILE.py [ARGS...]"
  local f argv0=$1; shift
  case $argv0 in /*) f=$argv0 ;; *) f=$caller_pwd/$argv0 ;; esac
  [ -f "$f" ] || die "no file $argv0"
  aot_module
  local pkg; pkg=p_$(basename "$f" .py | tr -c 'A-Za-z0-9\n' '_')
  aot_compile "$pkg" "$f" "$AOT/bin/$pkg"
  [ -f "$AOT/bin/$pkg.refused" ] && die "aot: refused: $(cat "$AOT/bin/$pkg.refused")"
  aot_run "$AOT/bin/$pkg" "$argv0" "$@"
}

RT="$WORK/runtime"
tamago_go() { (cd "$RT" && env GOROOT= PATH="${ARBACE_GOROOT:-/root/tamago-go}/bin:$PATH" GOCACHE="$WORK/gocache" GOFLAGS=-mod=mod CGO_ENABLED=0 GOTOOLCHAIN=local "$@"); }

runtime_print() {
  local out=$1
  rm -rf "$out"; mkdir -p "$out/py"
  printf 'module arbace\n\ngo 1.27\n' > "$out/go.mod"
  ARBACE_PATH="$root" "$root/bin/repr-go" print "$root/go/arbace/py.ae" "$out/py" >/dev/null
  # the musl libm port the runtime imports (go/arbace/libm, shared with hsi): printed beside it, not read back
  mkdir -p "$out/libm"
  ARBACE_PATH="$root" "$root/bin/repr-go" print "$root/go/arbace/libm.ae" "$out/libm" >/dev/null
}

runtime_read() {
  local src=$1 out=$2
  rm -rf "$out"
  (cd "$src" && "$root/bin/repr-go" read --full --tests --goos linux --goarch amd64 --out "$out" ./py) > "$out.log" 2>&1 \
    || { cat "$out.log" >&2; die "the runtime's Go does not read (log $out.log)"; }
}

cmd_runtime() {
  local verb=${1:-}
  case $verb in
    print) runtime_print "$RT"; echo "the runtime's Go in $RT/py: edit it there, then bin/pyi runtime read" ;;
    read)
      [ -d "$RT/py" ] || die "no $RT/py: bin/pyi runtime print first"
      runtime_read "$RT" "$WORK/runtime-forms"
      rm -rf "$root/go/arbace/py" "$root/go/arbace/py.ae"
      cp -r "$WORK/runtime-forms/go/arbace/py" "$WORK/runtime-forms/go/arbace/py.ae" "$root/go/arbace/"
      echo "go/arbace/py read from $RT/py ($(ls "$root/go/arbace/py" | wc -l) files)" ;;
    vet)
      [ -d "$RT/py" ] || runtime_print "$RT"
      tamago_go gofmt -l py | sed 's/^/not gofmt: /' | grep . && die "gofmt the runtime's Go first"
      tamago_go go vet ./py
      tamago_go go test ./py ;;
    check)
      local rc=0 t="$WORK/runtime-check" p
      runtime_print "$t/src"
      runtime_read "$t/src" "$t/forms"
      if diff -r "$root/go/arbace/py" "$t/forms/go/arbace/py" >/dev/null && cmp -s "$root/go/arbace/py.ae" "$t/forms/go/arbace/py.ae"; then
        echo "runtime: go/arbace/py printed and read again: the same forms"
      else
        echo "runtime: go/arbace/py printed and read again DIFFERS (diff -r go/arbace/py $t/forms/go/arbace/py)"; rc=1
      fi
      pa_arbace runtime-ops || rc=1
      local n=0 bad=0
      for p in "$root"/test/python/pyi/*.py; do
        n=$((n + 1))
        local want got
        want=$(cd "$(dirname "$p")" && smoke_run python3 -I "$(basename "$p")")
        got=$(cd "$(dirname "$p")" && smoke_run "$root/bin/pyi" run "$(basename "$p")")
        if [ "$want" = "$got" ]; then echo "  pass $(basename "$p")"; else
          echo "  FAIL $(basename "$p")"; diff <(echo "$want") <(echo "$got") | head -10; bad=$((bad + 1)); fi
      done
      echo "runtime: $n programs of test/python/pyi run by pyi as by the oracle: $((n - bad)) equal"
      [ $bad -eq 0 ] || rc=1
      repl_check || rc=1
      return $rc ;;
    *) die "usage: bin/pyi runtime print|read|vet|check" ;;
  esac
}

# smoke_run CMD...: the run's stdout, its exit status and stderr's last line, for comparing pyi with the oracle
smoke_run() {
  local o e rc=0
  o=$(mktemp "$WORK/smoke.XXXXXX"); e=$(mktemp "$WORK/smoke.XXXXXX")
  timeout 120 env HOME="$WORK" TMPDIR="$WORK" "$@" > "$o" 2> "$e" || rc=$?
  cat "$o"; echo "status $rc"; echo "stderr $(tail -n 1 "$e")"
  rm -f "$o" "$e"
}

command -v python3 >/dev/null || die "no python3 (the oracle)"
case "${1:-}" in
  gen) shift; cmd_gen "$@" ;;
  record-ref) shift; cmd_record_ref "$@" ;;
  scope-check) shift; cmd_scope_check "$@" ;;
  compile-check) shift; cmd_compile_check "$@" ;;
  run) shift; mkdir -p "$WORK"; cmd_run "$@" ;;
  repl) shift; mkdir -p "$WORK"; cmd_repl "$@" ;;
  lib-test) shift; mkdir -p "$WORK"; cmd_lib_test "$@" ;;
  runtime) shift; mkdir -p "$WORK"; cmd_runtime "$@" ;;
  aot) shift; mkdir -p "$WORK"; cmd_aot "$@" ;;
  bench) shift; mkdir -p "$WORK"; cmd_bench "$@" ;;
  check) shift; mkdir -p "$WORK"; [ "${1:-}" = --aot ] || die "usage: bin/pyi check --aot [--record] [--no-pyi] [--only ID]..."; shift; cmd_check_aot "$@" ;;
  *) sed -n '2,51p' "$0"; exit 2 ;;
esac

#!/bin/bash
# pyi, the evaluator of Python forms (doc/python/PYTHON-SURVEY.md §6, PYS2 (a)): so far (PY4) no interpreter, only its
# corpora and their references, CPython 3.14.10's runs (GTS207 (a), PYS14 (a), PYS15 (a)). Out of gate_key and the gate
# (PYS18 (a)); stage 0 only runs the generator (test/python/gen.ae); the programs and Lib/test's modules are run by the
# oracle under .tmp/repr-python/pyi only (HOME and TMPDIR there, regrtest's resources off: no network).
#
#   bin/pyi gen [--check]          the synthetic corpus (survey §8.3): test/python/gen.ae on stage 0 writes
#                                  test/python/synth/ (ops, datamodel, builtins, constructs, paths; MANIFEST); --check
#                                  generates it into .tmp and requires it equal to the committed files, the constructs
#                                  covering every node class of the ast, the builtins every public method of their types,
#                                  every program compiling
#   bin/pyi record-ref [--check] [CORPUS...]
#                                  the reference runs (default: synthetic samples language-core; lib-test-all, PY6i: every
#                                  module of Lib/test as regrtest finds it, PYI_LIB_TEST_JOBS shards at once, into
#                                  test/python/ref-cpython314-lib-test-all.edn): each program of
#                                  synthetic and samples run by CPython 3.14.10 with PYTHONHASHSEED=0 (tools/pydump/refs.py),
#                                  twice; status, stdout's SHA-256, size, first line and stderr's last line into
#                                  test/python/ref-cpython314.edn; Lib/test's language-core modules (corpora.edn) by
#                                  regrtest, each test method's outcome into test/python/ref-cpython314-lib-test.edn
#                                  (sys.implementation.name "cpython"); an entry the two runs disagree on or whose output
#                                  names the machine is written :excluded with its reason; the seconds into
#                                  test/python/ref-costs.edn. --check: two more runs, each reproducing every reference
#   bin/pyi scope-check [--record] [CORPUS...]
#                                  PY5a: every read file's symbol table by arbace.python.scope against CPython's own
#                                  (tools/pydump/pydump.py scopes): the corpora of test/python/corpora.edn (default:
#                                  samples synthetic errors stdlib site-packages lib-test), against test/python/scope-known.edn;
#                                  then its negative control (PY7, GTS81 (a)): classes.py's tree against functions.py's tables
#   bin/pyi compile-check [--full] [--record] [CORPUS...]
#                                  PY5a: every read file compiled to pyi's IR (arbace.python.compile) and the IR
#                                  verified (doc/python/PYI-SPEC.md §4), against test/python/compile-known.edn;
#                                  --full (PY5b): the forms of mode :full, the runs' (check :compile-full); then its negative
#                                  control (PY7, GTS81 (a)): classes.py's tree judged as errors/annotated-global.py
#   bin/pyi run FILE.py            PY5b0: FILE read in mode :full (tools/pydump/pydump.py tree --full: its lines), compiled to
#                                  the IR and run by pyi's runtime go/arbace/py, interpreted by goi on stage 0 (PY5a's DECISION
#                                  (a)); the program's stdout, stderr and exit status
#   bin/pyi run FILE.py ARGS...    PY5e: sys.argv [FILE ARGS...], sys.path [FILE's directory, the pinned tarball's Lib];
#                                  imports, exec, eval and compile compiled by the host (arbace.python.run, the IR kept in
#                                  .tmp/repr-python/pyi/ir-cache by the source's and the compiler's SHA-256)
#   bin/pyi repl [--check]         PY5e: python3's basic REPL (go/arbace/py's repl.go): statements from stdin, prompts on
#                                  stderr, expression statements' values displayed (sys.displayhook, builtins._); --check:
#                                  test/python/pyi/*.in fed to it and to python3 -q -i, stdout, status and stderr
#                                  byte for byte
#   bin/pyi lib-test [--oracle] [--record] [--aot] [--corpus ID] [--judge DIR] [MODULE...]
#                                  PY5e: Lib/test's language-core modules (--corpus ID: another lib-test corpus of
#                                  corpora.edn, e.g. lib-test-asyncio; --aot: the driver compiled by pyi's AOT, the test
#                                  modules on its loop, PY6h) run by pyi (test/python/libtest.py: unittest's
#                                  loader, each test's outcome), judged per method against ref-cpython314-lib-test.edn
#                                  (test/python/libtest_judge.ae, PY6a; since PY7 bin/pyi check's judge): a method not
#                                  equal passes in its class of test/python/divergences.edn unless the check's record passes
#                                  it; --record writes the record's rows of the modules run (exit 3 on a method of no class);
#                                  --judge DIR: judged again, nothing run; --oracle: the driver by python3;
#                                  pyi's runs skip test/python/lib-test-skip.tsv's tests (PYI_LIB_TEST_SKIP, the driver's)
#   bin/pyi python [OPTION...] [-c CMD | -m MOD | FILE | -] [ARGS...]
#                                  PY6e: CPython's command line over run (sys.executable, tools/pyi/python3), for
#                                  script_helper's and subprocess's children: the options taken and ignored, run in
#                                  the caller's directory
#   bin/pyi lib-test-all [--oracle] [--record] [--judge DIR] [--fresh] [--all] [MODULE...]
#                                  PY6i: Lib/test as regrtest finds it, less the families' modules (tools/pyi/libtest_all.py; the
#                                  modules the :module lines of ref-cpython314-lib-test-all.edn): each module by pyi through test/python/libtest_run.py,
#                                  a test's crash or timeout ending that test alone (the driver started again on the rest),
#                                  judged by libtest_judge.ae against the references, divergences.edn's classes and the record, then the
#                                  negative controls (test/python/controls.edn) and the table (RUN/table.md); the
#                                  modules a family owns (test/python/lib-test-all-owners.tsv) left out, its rows the family's,
#                                  but with --all, --oracle (the driver's control, every module) or named; the
#                                  run in .tmp/repr-python/pyi/lib-test-all/run resumes (--fresh: anew); --record: the record's
#                                  rows of the modules run written (exit 3
#                                  on a method of no class). PYI_LIB_TEST_JOBS (default 2), PYI_LIB_TEST_TEST_TIMEOUT (300 s),
#                                  PYI_LIB_TEST_TIMEOUT (a module's cap, 3600 s), PYI_LIB_TEST_TMP (the runs' short TMPDIRs, default
#                                  .tmp/t6i: multiprocessing's AF_UNIX paths fit; /tmp checked and cleaned after each module)
#   bin/pyi check [--corpus ID,...] [--only FILE] [--record] [--judge DIR] [--oracle] [--fresh] [MODULE...]
#                                  PY7: the check over Lib/test (survey §7-§8, "As built: PY7 (the check)"), as goi's and Java's:
#                                  every module of the universe (the lib-test corpora of corpora.edn and lib-test-all's) through
#                                  the restartable runner, each method judged against CPython's references, every non-pass in a
#                                  class of test/python/divergences.edn (GR10's format), a method the record
#                                  (test/python/check-lib-test-linux-amd64.edn, PYI_CHECK_RECORD) passes that does not pass now a
#                                  regression, "   failing: ID" a line each; the negative controls (test/python/controls.edn);
#                                  --only FILE: MODULE or MODULE/TEST-ID lines (the gate's rotation's lists); --record writes the
#                                  record (the main host's); --judge DIR judged again, nothing run; RUN/results.tsv the rows
#   bin/pyi divergences [--table | --methods] [--results FILE...]
#                                  PY7: the record's non-passes classified by test/python/divergences.edn, no run (GR10, as
#                                  bin/goi divergences): a non-pass in no class, or a :tests name another class takes first, fails
#   bin/pyi cover run|blocks|subset [--only FILE] [--write]
#                                  PY7: the coverage subset (GT8.3, GTS205 (a)): the driver compiled by pyi's AOT with Go's -cover
#                                  of the runtime (go/arbace/py), each module on its loop with its GOCOVERDIR (run: the main
#                                  host's night); blocks: tools/covsubset's block sets per module; subset: the modules of every
#                                  covered block, one per class, the controls (bin/cover subset); --write: corpora.edn's :subset
#   bin/pyi runtime print|read|vet|check
#                                  PY5b0, the runtime's sources (doc/python/PYI-SPEC.md §8): go/arbace/py's Go forms (mode :full,
#                                  lossless) printed as a Go module into .tmp/repr-python/pyi/runtime (print), edited there,
#                                  read back into go/arbace/py (read; go/arbace/libm, go/arbace/expat and go/arbace/pyexpat,
#                                  printed beside it, not read back); vet: the Go there (printed first when absent)
#                                  gofmt clean, then go vet and go test by TamaGo's go (py, expat and pyexpat);
#                                  check: printed and read again equal to the committed forms (py, expat, pyexpat), the runtime's operations
#                                  arbace.python.ir/ops's (runtime-ops), the programs of test/python/pyi/ run by bin/pyi run
#                                  equal to the oracle's runs (stdout, status, stderr's last line), and repl --check;
#                                  also the Unicode tables and the CJK codecs' (tools/pyi/unicodedata_table.py and
#                                  cjkcodecs_table.py --check on the printed files)
#   bin/pyi aot FILE.py [ARGS...]  PY8: FILE compiled by pyi's AOT (arbace.python.aot: the IR to Go forms over go/arbace/py, its
#                                  module-level imports compiled ahead; printed by repr/go, built by TamaGo's go in
#                                  .tmp/repr-python/pyi/aot/mod) and run; source compiled at run time by the host's compiler
#   bin/pyi check --aot [--record] [--no-pyi] [--only ID]... [--only-list FILE]
#                                  PY8: the synthetic corpus and the samples compiled and run, judged against CPython's
#                                  references (ref-cpython314.edn), the same executable on the loop (PYI_AOT_LOOP) and pyi's run
#                                  on goi (kept by digest; --no-pyi: not run; --only-list FILE: FILE's ids, one a
#                                  line, # and blank lines ignored); classes test/python/divergences-aot.edn and the
#                                  rule :as-pyi; a negative control; --record: test/python/check-aot-linux-ARCH.edn
#   bin/pyi bench [--pyi] [--record] [BM...]
#                                  PY8: pyperformance 1.14.0's pure benchmarks (test/python/bench) run by CPython, compiled and
#                                  on the loop (--pyi: by pyi on goi too), the milliseconds; --record: bench-aot-linux-ARCH.edn
# Environment: REPR_PYTHON_SRC as for bin/repr-python (the tarball's source).
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash"
caller_pwd=$PWD
cd "$root"

WORK="$root/.tmp/repr-python/pyi"
SYNTH="$root/test/python/synth"
REF="$root/test/python/ref-cpython314.edn"
REF_LT="$root/test/python/ref-cpython314-lib-test.edn"
COSTS="$root/test/python/ref-costs.edn"
COSTS_LT="$root/test/python/ref-costs-lib-test.edn"
REF_ALL="$root/test/python/ref-cpython314-lib-test-all.edn"
COSTS_ALL="$root/test/python/ref-costs-lib-test-all.edn"
# PY7 (queue 201): the classes, the check's record (the main host's, amd64: PYI_CHECK_RECORD another) and the controls
DIV="$root/test/python/divergences.edn"
CHECK_RECORD="${PYI_CHECK_RECORD:-$root/test/python/check-lib-test-linux-amd64.edn}"
CONTROLS="$root/test/python/controls.edn"
die() { echo "pyi: $*" >&2; exit 1; }

arbace_exe() {
  if [ -n "${ARBACE_HOST_EXE:-}" ]; then echo "$ARBACE_HOST_EXE"; return; fi
  local arch main
  case $(uname -m) in x86_64) arch=amd64 ;; aarch64) arch=arm64 ;; *) arch=$(uname -m) ;; esac
  if [ -x "$root/target/seed/$arch/arbace" ]; then echo "$root/target/seed/$arch/arbace"; return; fi
  main=$(cd "$(git rev-parse --git-common-dir)/.." && pwd)
  if [ -x "$main/target/seed/$arch/arbace" ]; then echo "$main/target/seed/$arch/arbace"; return; fi
  die "no stage 0 (bin/seed --build, or ARBACE_HOST_EXE)"
}
py() { local s=$1; shift; python3 -I -S -B "$root/tools/pydump/$s" "$@"; }
pyall() { python3 -I -S -B "$root/tools/pyi/libtest_all.py" "$@"; }

check_oracle() {
  local want have
  want=$(sed -n 's/^sys\.version //p' "$root/tools/pydump/PYTHON_VERSION")
  have=$(python3 -I -c 'import sys; print(sys.version)')
  [ "$want" = "$have" ] || die "the oracle is '$have', tools/pydump/PYTHON_VERSION pins '$want'"
  [ "$(python3 -I -c 'import sys; print(sys.implementation.name)')" = cpython ] || die "the oracle is not CPython"
}

cmd_gen() {
  local check=${1:-}
  if [ "$check" = --check ]; then
    local d="$WORK/gen"; rm -rf "$d"; mkdir -p "$d"
    "$(arbace_exe)" "$root/test/python/gen.ae" "$d"
    local bad=0
    diff -r "$d" "$SYNTH" > "$WORK/gen.diff" || { echo "gen --check: the generated corpus differs from test/python/synth (bin/pyi gen):"; head -20 "$WORK/gen.diff"; bad=1; }
    (cd "$SYNTH/constructs" && py corpus.py samples . .) || bad=1
    (cd "$SYNTH" && py corpus.py samples . . | tail -1)
    local t
    for t in str bytes list tuple dict set frozenset int float complex bool range memoryview slice; do
      py corpus.py methods "$t" "$SYNTH/builtins/$t.py" | tail -1 | grep -q ' of ' || bad=1
      py corpus.py methods "$t" "$SYNTH/builtins/$t.py" >/dev/null || { py corpus.py methods "$t" "$SYNTH/builtins/$t.py" | grep UNCOVERED; bad=1; }
    done
    py corpus.py methods bytearray "$SYNTH/builtins/bytearray.py" "$SYNTH/builtins/bytearray-shared.py" >/dev/null \
      || { py corpus.py methods bytearray "$SYNTH/builtins/bytearray.py" "$SYNTH/builtins/bytearray-shared.py" | grep UNCOVERED; bad=1; }
    if [ $bad = 0 ]; then echo "gen --check: $(wc -l < "$SYNTH/MANIFEST") programs as committed; every node class and builtin method covered"; else return 1; fi
  else
    rm -rf "$SYNTH"; mkdir -p "$SYNTH"
    "$(arbace_exe)" "$root/test/python/gen.ae" "$SYNTH"
  fi
}

# corpus_modules ID: a lib-test corpus's modules, comma-separated: each path's module, a directory's test_*.py as
# PACKAGE.MODULE (PY6h's REQUEST, queue 200: test_asyncio)
corpus_modules() {
  local p out=()
  for p in $("$(arbace_exe)" -e "(println (arbace.string/join \" \" (get-in (first (filter #(= :$1 (:id %)) (:corpora (read-string (slurp \"$root/test/python/corpora.edn\"))))) [:where :paths])))"); do
    p=${p#Lib/test/}
    if [ -d "$root/.tmp/repr-python/Python-3.14.10/Lib/test/$p" ]; then
      local f; for f in "$root/.tmp/repr-python/Python-3.14.10/Lib/test/$p"/test_*.py; do f=$(basename "$f" .py); out+=("$p.$f"); done
    else out+=("${p%.py}"); fi
  done
  [ ${#out[@]} -gt 0 ] || die "no lib-test corpus $1 in test/python/corpora.edn"
  (IFS=,; echo "${out[*]}")
}

# lib-test's modules, from test/python/corpora.edn (the corpora :language-core's and :stdlib-tests' paths, as module
# names; a package is its directory)
core_modules() {
  "$(arbace_exe)" -e "(println (arbace.string/join \",\" (map #(-> % (subs 9) (arbace.string/replace #\"\\.py\$\" \"\")) (mapcat #(get-in % [:where :paths]) (filter #(#{:language-core :stdlib-tests} (:id %)) (:corpora (read-string (slurp \"$root/test/python/corpora.edn\"))))))))"
}

tarball_test() {
  local top="$root/.tmp/repr-python/Python-3.14.10"
  [ -d "$top/Lib/test" ] || "$root/bin/repr-python" pins --fetch >/dev/null
  mkdir -p "$WORK/pypath"; ln -sfn "$top/Lib/test" "$WORK/pypath/test"
}

# run_programs TAG: the synthetic corpus and the samples, one TSV
run_programs() {
  local tag=$1 d="$WORK/$1"
  rm -rf "$d"; mkdir -p "$d"
  { sed 's|^|synth/|' "$SYNTH/MANIFEST"; (cd "$root/test/python/samples" && ls *.py | sed 's|^|samples/|'); } > "$d/list"
  mkdir -p "$d/base"; ln -sfn "$SYNTH" "$d/base/synth"; ln -sfn "$root/test/python/samples" "$d/base/samples"
  py refs.py programs --base "$d/base" --list "$d/list" --work "$d" --out "$d/programs.tsv"
}

run_libtest() {
  local tag=$1 d="$WORK/$1" mods=${2:-$(core_modules)}
  mkdir -p "$d"
  tarball_test
  py refs.py libtest --pypath "$WORK/pypath" --modules "$mods" --work "$d" --out "$d/libtest.tsv"
}

header() { # FILE WHAT
  cat > "$1" <<HDR
;; CPython 3.14.10's reference runs of $2, as data (doc/python/PYTHON-SURVEY.md §8.1, PYS14 (a), PYS15 (a); GTS207 (a)):
;; one map per line, sorted by :id. Programs: :status the exit status (128+signal, :timeout), :stdout the SHA-256 of
;; the standard output, :bytes its size, :first its first line (80 chars), :stderr-last the last non-blank line of the
;; standard error. Lib/test: :outcome :ok, :skipped (:reason), :failure or :error per test method, :module true lines
;; with regrtest's exit status. :excluded names an entry kept out of the references: the two recording runs disagree,
;; or its output names the machine (an address, the architecture, the C library, a size): bin/pyi record-ref --check
;; reproduces the others. Made by: bin/pyi record-ref ($(python3 -I -c 'import sys; print(sys.version.split()[0], sys.implementation.name)'),
;; python3 -s -P -B, PYTHONHASHSEED=0 LC_ALL=C.UTF-8 TZ=UTC PYTHONIOENCODING=utf-8; regrtest -u none --randseed 1).
;; date: $(date -u +%F)
HDR
}

cmd_record_ref() {
  local check="" ids=()
  while [ $# -gt 0 ]; do case $1 in --check) check=1; shift ;; *) ids+=("$1"); shift ;; esac; done
  [ ${#ids[@]} -gt 0 ] || ids=(programs language-core)
  check_oracle
  local id rc=0
  for id in "${ids[@]}"; do
    case $id in
      synthetic|samples|programs)
        if [ -n "$check" ]; then
          run_programs check1; run_programs check2
          py refs.py check --kind programs --ref "$REF" --run "$WORK/check1/programs.tsv" || rc=1
          py refs.py check --kind programs --ref "$REF" --run "$WORK/check2/programs.tsv" || rc=1
        else
          run_programs rec1; run_programs rec2
          header "$WORK/header.txt" "the synthetic corpus (test/python/synth) and the samples (test/python/samples)"
          py refs.py record --kind programs --a "$WORK/rec1/programs.tsv" --b "$WORK/rec2/programs.tsv" --out "$REF" \
            --header "$WORK/header.txt" --costs "$COSTS"
        fi ;;
      language-core)
        if [ -n "$check" ]; then
          run_libtest check1; run_libtest check2
          py refs.py check --kind libtest --ref "$REF_LT" --run "$WORK/check1/libtest.tsv" || rc=1
          py refs.py check --kind libtest --ref "$REF_LT" --run "$WORK/check2/libtest.tsv" || rc=1
        else
          run_libtest rec1; run_libtest rec2
          header "$WORK/header.txt" "Lib/test's language-core modules (test/python/corpora.edn), per test method"
          py refs.py record --kind libtest --a "$WORK/rec1/libtest.tsv" --b "$WORK/rec2/libtest.tsv" --out "$REF_LT" \
            --header "$WORK/header.txt" --costs "$COSTS_LT"
        fi ;;
      lib-test-all)
        local L="$WORK/lib-test-all"; mkdir -p "$L"; tarball_test
        # the modules outside every family's (test/python/lib-test-all-owners.tsv): the families' are lib-test's references
        pyall list --pypath "$WORK/pypath" --work "$L" --out "$L/all-modules.txt"
        pyall owned --owners "$root/test/python/lib-test-all-owners.tsv" --modules "$L/all-modules.txt" --invert > "$L/modules.txt"
        local t runs="rec1 rec2"; [ -z "$check" ] || runs="check1 check2"
        for t in $runs; do
          rm -rf "${L:?}/$t"; mkdir -p "$L/$t"
          # PYTHONPATH the tarball's Lib, as pyi and the driver's control see it (its Tools/ and i18n data, its paths)
          pyall refs --pypath "$(stdlib_lib)" --modules "$L/modules.txt" --work "$L/$t" --out "$L/$t/libtest.tsv" --jobs "${PYI_LIB_TEST_JOBS:-2}" \
            --tmp-base "${PYI_LIB_TEST_TMP:-$root/.tmp/t6i}" || true
        done
        if [ -n "$check" ]; then
          py refs.py check --kind libtest --ref "$REF_ALL" --run "$L/check1/libtest.tsv" || rc=1
          py refs.py check --kind libtest --ref "$REF_ALL" --run "$L/check2/libtest.tsv" || rc=1
        else
          header "$WORK/header.txt" "Lib/test as regrtest finds it (python3 -m test --list-tests) but the PY6 families' modules (test/python/lib-test-all-owners.tsv): $(wc -l < "$L/modules.txt") of $(wc -l < "$L/all-modules.txt") modules, PYTHONPATH the tarball's Lib; per test method"
          py refs.py record --kind libtest --a "$L/rec1/libtest.tsv" --b "$L/rec2/libtest.tsv" --out "$REF_ALL" \
            --header "$WORK/header.txt" --costs "$COSTS_ALL"
          pyall fixrefs --ref "$REF_ALL" --root "$root"
        fi ;;
      lib-test-*)
        # another lib-test corpus (PY6h's REQUEST, queue 200): its references in ref-cpython314-ID.edn
        local mods ref="$root/test/python/ref-cpython314-$id.edn"; mods=$(corpus_modules "$id")
        if [ -n "$check" ]; then
          run_libtest "check1-$id" "$mods"; run_libtest "check2-$id" "$mods"
          py refs.py check --kind libtest --ref "$ref" --run "$WORK/check1-$id/libtest.tsv" || rc=1
          py refs.py check --kind libtest --ref "$ref" --run "$WORK/check2-$id/libtest.tsv" || rc=1
        else
          run_libtest "rec1-$id" "$mods"; run_libtest "rec2-$id" "$mods"
          header "$WORK/header.txt" "Lib/test's $id corpus (test/python/corpora.edn), per test method"
          py refs.py record --kind libtest --a "$WORK/rec1-$id/libtest.tsv" --b "$WORK/rec2-$id/libtest.tsv" --out "$ref" \
            --header "$WORK/header.txt" --costs "$root/test/python/ref-costs-$id.edn"
        fi ;;
      *) die "no corpus $id (programs, language-core, lib-test-all, lib-test-*)" ;;
    esac
  done
  return $rc
}

# corpus_list ID DIR: the corpus's base directory (stdout) and its files' list into DIR/list
corpus_list() {
  local id=$1 d=$2 line base paths excl
  line=$("$(arbace_exe)" -e "(let [c (first (filter #(= :$id (:id %)) (:corpora (read-string (slurp \"$root/test/python/corpora.edn\")))))] (when c (let [w (:where c)] (println (if (:pin w) (name (:pin w)) (str \"root:\" (:root w))) (arbace.string/join \",\" (:paths w)) (if (seq (:exclude w)) (arbace.string/join \",\" (:exclude w)) \"-\")))))")
  [ -n "$line" ] || die "no corpus $id in test/python/corpora.edn"
  read -r base paths excl <<< "$line"
  case $base in
    cpython-3.14.10) base="$root/.tmp/repr-python/Python-3.14.10"; [ -d "$base/Lib" ] || "$root/bin/repr-python" pins --fetch >/dev/null ;;
    site-packages) base="$root/.tmp/repr-python/site-packages/$(uname -m)"; [ -d "$base" ] || "$root/bin/repr-python" pins --fetch >/dev/null ;;
    root:*) base="$root/${base#root:}" ;;
  esac
  local -a args=(); IFS=, read -ra pa <<< "$paths"; args+=("${pa[@]}")
  if [ "$excl" != - ]; then IFS=, read -ra ea <<< "$excl"; for e in "${ea[@]}"; do args+=(--exclude "$e"); done; fi
  mkdir -p "$d"
  (cd "$base" && py corpus.py list "$base" "${args[@]}") > "$d/list"
  echo "$base"
}

pa_arbace() {
  ARBACE_PATH="$root" GOMEMLIMIT=${PYI_GOMEMLIMIT:-3GiB} GOMAXPROCS=${PYI_THREADS:-4} "$(arbace_exe)" -m arbace.python "$@"
}

cmd_scope_check() {
  local record="" ids=() rc=0 worst=0 id
  while [ $# -gt 0 ]; do case $1 in --record) record=1; shift ;; *) ids+=("$1"); shift ;; esac; done
  [ ${#ids[@]} -gt 0 ] || ids=(samples synthetic errors stdlib site-packages lib-test)
  for id in "${ids[@]}"; do
    local d="$WORK/scope/$id" base t0
    rm -rf "$d"
    base=$(corpus_list "$id" "$d")
    t0=$(date +%s)
    py pydump.py tree --base "$base" --list "$d/list" --out "$d/dumps" --tsv "$d/dumps.tsv"
    py pydump.py scopes --base "$base" --list "$d/list" --out "$d/scopes"
    rc=0
    pa_arbace scope-check --corpus "$id" --dumps "$d/dumps" --scopes "$d/scopes" --known "$root/test/python/scope-known.edn" \
      --results "$d/results.edn" ${record:+--record} || rc=$?
    echo "  $(( $(date +%s) - t0 )) s"
    [ $rc -gt $worst ] && worst=$rc
  done
  cscontrol scope || { [ $worst -gt 0 ] || worst=1; }
  return $worst
}

# cscontrol KIND [FULL] (GTS81 (a), PY10's R3, queue 201): the negative control of scope-check (KIND scope)
# and compile-check (KIND compile): a crossed pair judged by the check's own judge, which must fail it. scope: the
# sample classes.py's tree judged against functions.py's CPython symbol tables; compile: the sample classes.py's
# tree under the name of the error program annotated-global.py, against that program's CPython row (a compile error
# CPython raises and pyi, compiling classes.py, does not). Seconds; "control passed" or "control not judged" fails
cscontrol() {
  local kind=$1 full=${2:-} c="$WORK/controls/$1${2:+-full}" sb eb rc=0 out
  rm -rf "$c"; mkdir -p "$c/s" "$c/run/dumps" "$c/run/scopes"
  sb=$(corpus_list samples "$c/s")
  printf 'classes.py\nfunctions.py\n' > "$c/s/list"
  py pydump.py tree ${full:+--full} --base "$sb" --list "$c/s/list" --out "$c/s/dumps" --tsv "$c/s/dumps.tsv"
  if [ "$kind" = scope ]; then
    py pydump.py scopes --base "$sb" --list "$c/s/list" --out "$c/s/scopes"
    cp "$c/s/dumps/classes.py.ae" "$c/run/dumps/classes.py.ae"
    cp "$c/s/scopes/functions.py.scopes.ae" "$c/run/scopes/classes.py.scopes.ae"
    grep '^classes\.py	' "$c/s/dumps.tsv" > "$c/run/dumps.tsv"; echo classes.py > "$c/run/list"
    out=$(pa_arbace scope-check --corpus samples --dumps "$c/run/dumps" --scopes "$c/run/scopes" --known "$root/test/python/scope-known.edn" \
      --results "$c/run/results.edn" 2>&1) || rc=$?
  else
    mkdir -p "$c/e"; eb=$(corpus_list errors "$c/e"); echo annotated-global.py > "$c/e/list"
    py pydump.py tree ${full:+--full} --base "$eb" --list "$c/e/list" --out "$c/e/dumps" --tsv "$c/e/dumps.tsv"
    cp "$c/s/dumps/classes.py.ae" "$c/run/dumps/annotated-global.py.ae"
    cp "$c/e/dumps.tsv" "$c/run/dumps.tsv"
    out=$(pa_arbace compile-check ${full:+--check compile-full} --corpus errors --dumps "$c/run/dumps" --tsv "$c/run/dumps.tsv" \
      --known "$root/test/python/compile-known.edn" --results "$c/run/results.edn" --ops "$c/run/ops.edn" 2>&1) || rc=$?
  fi
  if ! grep -q ': 1 files: ' <<< "$out"; then echo "control not judged: $kind${full:+ --full}: $(tail -2 <<< "$out")"; return 1
  elif [ $rc = 0 ] || grep -q ': 1 files: 1 equal' <<< "$out"; then echo "control passed: $kind${full:+ --full}: $(grep ': 1 files: ' <<< "$out")"; return 1
  else echo "control failed as it must: $kind${full:+ --full}: $(grep ': 1 files: ' <<< "$out")"; fi
}

cmd_compile_check() {
  local record="" full="" ids=() rc=0 worst=0 id
  while [ $# -gt 0 ]; do case $1 in --record) record=1; shift ;; --full) full=1; shift ;; *) ids+=("$1"); shift ;; esac; done
  [ ${#ids[@]} -gt 0 ] || ids=(samples synthetic errors stdlib site-packages lib-test)
  for id in "${ids[@]}"; do
    local d="$WORK/compile${full:+-full}/$id" base t0
    rm -rf "$d"
    base=$(corpus_list "$id" "$d")
    t0=$(date +%s)
    py pydump.py tree ${full:+--full} --base "$base" --list "$d/list" --out "$d/dumps" --tsv "$d/dumps.tsv"
    rc=0
    pa_arbace compile-check ${full:+--check compile-full} --corpus "$id" --dumps "$d/dumps" --tsv "$d/dumps.tsv" --known "$root/test/python/compile-known.edn" \
      --results "$d/results.edn" --ops "$d/ops.edn" ${record:+--record} || rc=$?
    echo "  $(( $(date +%s) - t0 )) s"
    [ $rc -gt $worst ] && worst=$rc
  done
  cscontrol compile "$full" || { [ $worst -gt 0 ] || worst=1; }
  return $worst
}

# stdlib_lib: the pinned tarball's Lib, sys.path's standard library until python/Lib is vendored (PY6; survey §6.6)
stdlib_lib() {
  local top="$root/.tmp/repr-python/Python-3.14.10"
  [ -d "$top/Lib" ] || "$root/bin/repr-python" pins --fetch >/dev/null
  echo "$top/Lib"
}

# the host's side of the runtime (arbace.python.run): its work directory and a run's id for its scratch
pyi_env() { export PYI_ROOT="$root" PYI_WORK="$WORK" PYI_RUN_ID="$$" PYI_EXECUTABLE="$root/tools/pyi/python3"; }

cmd_repl() {
  if [ "${1:-}" = --check ]; then repl_check; return; fi
  pyi_env
  pa_arbace repl --lib "$(stdlib_lib)"
}

# repl_check: test/python/pyi/*.in fed to bin/pyi repl and to the oracle's basic REPL (python3 -q -i): stdout, the
# status and stderr (prompts, tracebacks with their source lines and carets) equal byte for byte
repl_check() {
  local p n=0 bad=0 want got
  for p in "$root"/test/python/pyi/*.in; do
    n=$((n + 1))
    want=$(repl_run "$p" python3 -q -i)
    got=$(repl_run "$p" "$root/bin/pyi" repl)
    if [ "$want" = "$got" ]; then echo "  pass $(basename "$p")"; else
      echo "  FAIL $(basename "$p")"; { diff <(echo "$want") <(echo "$got") | head -10 || true; }; bad=$((bad + 1)); fi
  done
  echo "repl: $n sessions of test/python/pyi run by pyi's REPL as by the oracle's: $((n - bad)) equal"
  [ $bad -eq 0 ]
}

repl_run() {
  local in=$1 o e rc=0; shift
  o=$(mktemp "$WORK/smoke.XXXXXX"); e=$(mktemp "$WORK/smoke.XXXXXX")
  timeout 300 env HOME="$WORK" TMPDIR="$WORK" "$@" < "$in" > "$o" 2> "$e" || rc=$?
  cat "$o"; echo "status $rc"; cat "$e"
  rm -f "$o" "$e"
}

cmd_run() {
  [ $# -ge 1 ] || die "usage: bin/pyi run FILE.py [ARGS...]"
  local f d name argv0=$1
  case $1 in /*) f=$1 ;; *) f=$caller_pwd/$1 ;; esac
  f=$(cd "$(dirname "$f")" && pwd)/$(basename "$f")
  [ -f "$f" ] || die "no file $1"
  name=$(basename "$f")
  d=$(mktemp -d "$WORK/run.XXXXXX")
  echo "$name" > "$d/list"
  py pydump.py tree --full --base "$(dirname "$f")" --list "$d/list" --out "$d/dumps" --tsv "$d/tsv" >/dev/null
  local rc=0
  shift
  pyi_env
  # in the caller's directory, as python3 runs a program (PY6e's REQUEST 5: lib-test's TESTFN files were made in the
  # checkout's root)
  (cd "$caller_pwd" && pa_arbace run --dump "$d/dumps/$name.ae" --file "$f" --lib "$(stdlib_lib)" --argv0 "$argv0" -- "$@") || rc=$?
  rm -rf "$d"
  return $rc
}

# python ARGS...: CPython's command line over bin/pyi run (PY6e, sys.executable: tools/pyi/python3 runs it), for
# test.support's script_helper and subprocess's children: -c CMD, -m MOD, FILE or - (stdin), the options before them
# taken and ignored (-I -E -s -S -B -u -b -q -O -P -R -d -v, -X OPT, -W ARG); run in the caller's directory, sys.path[0]
# '' for -c, -m and stdin
cmd_python() {
  local code="" mod="" file="" have=""
  while [ $# -gt 0 ]; do
    case $1 in
      -c) code=$2; have=c; shift 2; break ;;
      -m) mod=$2; have=m; shift 2; break ;;
      -X|-W) shift 2 ;;
      -X*|-W*) shift ;;
      -) have=s; shift; break ;;
      --) shift; [ $# -gt 0 ] && { file=$1; have=f; shift; }; break ;;
      -[IEsSBubqOPRdv]*)
        local o=${1#-} rest
        case $o in
          *c*) rest=${o#*c}; if [ -n "$rest" ]; then code=$rest; shift; else code=$2; shift 2; fi; have=c; break ;;
          *m*) rest=${o#*m}; if [ -n "$rest" ]; then mod=$rest; shift; else mod=$2; shift 2; fi; have=m; break ;;
        esac
        shift ;;
      -*) echo "pyi python: unknown option $1" >&2; exit 2 ;;
      *) file=$1; have=f; shift; break ;;
    esac
  done
  local d src argv0 p
  # the directories of earlier runs whose interpreter has ended (each exec'd, below, so none removes its own)
  for p in "$WORK"/python.*/pid; do
    [ -f "$p" ] && ! kill -0 "$(cat "$p")" 2>/dev/null && rm -rf "${p%/pid}"
  done
  d=$(mktemp -d "$WORK/python.XXXXXX")
  case $have in
    c) argv0=-c; src=$d/__pyi_c.py; printf 'import sys as __pyi_sys; __pyi_sys.path[0] = ""; del __pyi_sys\n%s\n' "$code" > "$src" ;;
    m) argv0=-m; src=$d/__pyi_m.py
       # runpy's _run_module_as_main needs the loader's get_code, which pyi's loader has not (PY6b): the module's
       # source found by its spec and run as __main__
       { printf 'import sys as __pyi_sys; __pyi_sys.path[0] = ""; __pyi_mod = %s\n' \
           "$(python3 -I -c 'import sys; print(repr(sys.argv[1]))' "$mod")"
         cat <<'PYI_M'
def __pyi_main(name):
    import importlib.util, sys, types
    spec = importlib.util.find_spec(name)
    if spec is None:
        sys.exit("%s: No module named %s" % (sys.executable, name))
    if spec.submodule_search_locations is not None:
        spec = importlib.util.find_spec(name + ".__main__")
    with open(spec.origin, encoding="utf-8") as f:
        code = compile(f.read(), spec.origin, "exec")
    sys.argv[0] = spec.origin
    m = types.ModuleType("__main__")
    m.__file__, m.__spec__, m.__package__, m.__loader__ = spec.origin, spec, spec.parent, spec.loader
    sys.modules["__main__"] = m
    exec(code, m.__dict__)
__pyi_main(__pyi_mod)
PYI_M
       } > "$src" ;;
    s|"") argv0=-; src=$d/__pyi_stdin.py
       { printf 'import sys as __pyi_sys; __pyi_sys.path[0] = ""; del __pyi_sys\n'; cat; } > "$src" ;;
    f) case $file in /*) src=$file ;; *) src=$caller_pwd/$file ;; esac; argv0=$file ;;
  esac
  [ -f "$src" ] || { echo "python: can't open file '$file': [Errno 2] No such file or directory" >&2; rm -rf "$d"; exit 2; }
  local name dir rc=0
  src=$(cd "$(dirname "$src")" && pwd)/$(basename "$src")
  name=$(basename "$src"); dir=$(dirname "$src")
  echo "$name" > "$d/list"
  py pydump.py tree --full --base "$dir" --list "$d/list" --out "$d/dumps" --tsv "$d/tsv" >/dev/null
  pyi_env
  # the interpreter exec'd in this process, so the pid the caller holds is the interpreter's: a test's kill of its child
  # (subprocess's timeout, Popen.kill) ends the run. Run as a child, the interpreter outlived the kill with parent 1
  # (test_subprocess's test_call_timeout, test_signal's SiginterruptTest; queue 200, round 7). $d goes with the next
  # bin/pyi python once this pid has ended.
  local lib; lib=$(stdlib_lib)
  echo $$ > "$d/pid"
  cd "$caller_pwd"
  ARBACE_PATH="$root" GOMEMLIMIT=${PYI_GOMEMLIMIT:-3GiB} GOMAXPROCS=${PYI_THREADS:-4} \
    exec "$(arbace_exe)" -m arbace.python run --dump "$d/dumps/$name.ae" --file "$src" --lib "$lib" --argv0 "$argv0" -- "$@"
}

# in_group CMD...: CMD in a session and process group of its own (setsid), waited for, then the whole group killed: a
# test's child that outlives its module's run (a timeout's, or one the test's own kill missed) does not run on with
# parent 1 (queue 200, round 7)
in_group() {
  local pid rc=0
  setsid "$@" & pid=$!
  wait "$pid" || rc=$?
  kill -KILL -- "-$pid" 2>/dev/null || true
  return $rc
}

# lib-test [--oracle] [--record] [--judge DIR] [MODULE...]: Lib/test's language-core modules (corpora.edn) run by pyi
# through test/python/libtest.py (unittest's loader, each test's outcome), judged per test method by
# test/python/libtest_judge.ae against 177's references (test/python/ref-cpython314-lib-test.edn): equal outcomes pass;
# a method that is not equal passes only in a class test/python/lib-test-known.edn names it with; anything else fails.
# --record: the known file's methods of the modules run written again (a method's class kept, else the first class
# whose :match finds its line; one of no class printed and left out, the run exits 3). --judge DIR: the runs in DIR
# judged again, nothing run. --oracle runs the driver by python3 instead, judged with no class (the judge's control:
# every method equal but the references' :excluded). PYI_LIB_TEST_JOBS modules at once (default 1),
# PYI_LIB_TEST_TIMEOUT seconds a module (default 1800; 5400 for test_queue, whose *_in_many_threads tests pass 65,536 items
# each, test_subprocess, test_socket and test_os, whose children are pyi runs, and test_pickle, 994 methods).
# pyi's runs skip the tests of test/python/lib-test-skip.tsv (PYI_LIB_TEST_SKIP; ID<TAB>REASON, each an error naming
# the reason, which the known file classes): those that would wait forever on what pyi cannot do yet
cmd_lib_test() {
  local oracle="" record="" judge="" aot="" corpus="" mods=() m d="$WORK/lib-test" lib rc=0
  while [ $# -gt 0 ]; do case $1 in --oracle) oracle=1; shift ;; --record) record=1; shift ;; --aot) aot=1; shift ;;
    --corpus) corpus=$2; shift 2 ;; --judge) judge=$2; shift 2 ;; *) mods+=("$1"); shift ;; esac; done
  if [ ${#mods[@]} -eq 0 ]; then
    if [ -n "$corpus" ]; then IFS=, read -ra mods <<< "$(corpus_modules "$corpus")"; else IFS=, read -ra mods <<< "$(core_modules)"; fi
  fi
  # the references: the language core's and every other lib-test corpus's (ref-cpython314-lib-test-*.edn), one file
  local refs="$WORK/lib-test-refs.edn"; cat "$REF_LT" "$root"/test/python/ref-cpython314-lib-test-*.edn > "$refs" 2>/dev/null || true
  # --aot: the driver compiled once (its imports ahead), each module's tests then on the loop of that executable
  local drv=""
  if [ -n "$aot" ] && [ -z "$judge" ] && [ -z "$oracle" ]; then
    aot_module; drv="$AOT/bin/p_libtest"; aot_compile p_libtest "$root/test/python/libtest.py" "$drv"
    [ -f "$drv.refused" ] && die "lib-test --aot: the driver is refused: $(cat "$drv.refused")"
  fi
  if [ -n "$judge" ]; then
    d=$(cd "$caller_pwd" && cd "$judge" && pwd); rm -f "$d/summary.tsv"
  else
    lib=$(stdlib_lib); rm -rf "$d"; mkdir -p "$d"
    # PYI_LIB_TEST_JOBS modules at once (default 1; each pyi run takes up to a few GB)
    local jobs=${PYI_LIB_TEST_JOBS:-1} running=0
    for m in "${mods[@]}"; do
      if [ "$running" -ge "$jobs" ]; then wait -n || true; running=$((running - 1)); fi
      (
        if [ -n "$oracle" ]; then
          (cd "$d" && in_group timeout 900 env PYTHONHASHSEED=0 LC_ALL=C.UTF-8 TZ=UTC PYTHONIOENCODING=utf-8 HOME="$WORK" TMPDIR="$WORK" PYTHONPATH="$lib" \
            python3 -s -P -B "$root/test/python/libtest.py" "$m" > "$d/$m.out" 2> "$d/$m.err"; echo $? > "$d/$m.status") || true
        else
          local tmo=1800; case $m in test_queue|test_subprocess|test_socket|test_os|test_pickle) tmo=5400 ;; esac
          if [ -n "$drv" ]; then
            (cd "$d" && PYI_LIB_TEST_SKIP="${PYI_LIB_TEST_SKIP-$root/test/python/lib-test-skip.tsv}" \
              in_group timeout "${PYI_LIB_TEST_TIMEOUT:-$tmo}" env PYI_AOT_COMPILER="$AOT/compiler.sh" "$drv" "$root/test/python/libtest.py" "$m" > "$d/$m.out" 2> "$d/$m.err"; echo $? > "$d/$m.status") || true
          else
            (cd "$d" && PYI_LIB_TEST_SKIP="${PYI_LIB_TEST_SKIP-$root/test/python/lib-test-skip.tsv}" \
              in_group timeout "${PYI_LIB_TEST_TIMEOUT:-$tmo}" "$root/bin/pyi" run "$root/test/python/libtest.py" "$m" > "$d/$m.out" 2> "$d/$m.err"; echo $? > "$d/$m.status") || true
          fi
        fi
        echo "lib-test: $m run"
      ) &
      running=$((running + 1))
    done
    wait
  fi
  local m2c="$d/modules.tsv"; [ -n "$judge" ] && [ -f "$m2c" ] || module_corpora "${mods[@]}" > "$m2c"
  "$(arbace_exe)" "$root/test/python/libtest_judge.ae" --dir "$d" --ref "$refs" --modules "$m2c" \
    $(if [ -n "$oracle" ]; then echo --no-classes; else echo --classes "$DIV" --record "$CHECK_RECORD"; fi) ${record:+--write-record} || rc=$?
  return $rc
}

# pyi's AOT (PY8; doc/python/PYTHON-SURVEY.md §7, PYS13 (a); PYI-SPEC.md §10): the IR translated to Go forms by
# arbace.python.aot (on the tools' host), printed by repr/go (bin/build-go --print-only) and built with TamaGo's go over
# go/arbace/py as printed by runtime print (the light tier, as bin/si's AOT: not Arbace's executable), one small
# executable per program; its modules' packages printed once, kept by their IR's hash (AOT/pkgs-GEN, GEN the
# generator's digest), so the stdlib's modules are compiled once for every program
AOT="$WORK/aot"
aot_go() {
  (cd "$AOT/mod" && env GOROOT="${ARBACE_GOROOT:-/root/tamago-go}" GOTOOLCHAIN=local GOFLAGS= GOWORK=off GO111MODULE=on \
     GOPROXY=off CGO_ENABLED=0 GOCACHE="${PYI_AOT_GOCACHE:-$(aot_shared)/gocache}" GOMAXPROCS=${GOMAXPROCS:-4} \
     "${ARBACE_GOROOT:-/root/tamago-go}/bin/go" "$@")
}
# aot_shared: what pyi's AOT keeps across worktrees (R4, queue 201: a cold check --aot paid once per runtime, not in
# every worktree): the compiled modules' printed packages (pkgs-GEN, by the generator's digest and each module's IR hash)
# and Go's build cache, under the main checkout's .tmp/repr-python/pyi/aot-shared (PYI_AOT_SHARED another; =$AOT: the
# worktree's own); the runtime's module, the programs and their logs stay the worktree's ($AOT)
aot_shared() {
  local d=${PYI_AOT_SHARED:-}
  if [ -z "$d" ]; then
    local main; main=$(cd "$root" && cd "$(git rev-parse --git-common-dir 2>/dev/null || echo .git)/.." 2>/dev/null && pwd) || main=$root
    d="$main/.tmp/repr-python/pyi/aot-shared"
  fi
  mkdir -p "$d"; echo "$d"
}
aot_gen() { cat "$root/arbace/python/aot.ae" | sha256sum | cut -c1-16; }
# aot_module: the module the compiled programs build in: the runtime (go/arbace/py, go/arbace/libm and go/arbace/expat printed,
# kept by their forms' digest), the packages of arbace/pyaot
aot_module() {
  mkdir -p "$AOT/mod/pyaot"
  printf 'module arbace\n\ngo 1.27\n' > "$AOT/mod/go.mod"
  local key; key=$( (cd "$root" && find go/arbace/py.ae go/arbace/py go/arbace/libm.ae go/arbace/libm go/arbace/expat.ae go/arbace/expat go/arbace/pyexpat.ae go/arbace/pyexpat -type f | LC_ALL=C sort | xargs sha256sum) | sha256sum | cut -c1-16)
  if [ "$(cat "$AOT/mod/runtime.key" 2>/dev/null)" != "$key" ]; then
    runtime_print "$AOT/rt"
    rm -rf "$AOT/mod/py" "$AOT/mod/libm" "$AOT/mod/expat" "$AOT/mod/pyexpat"; mkdir -p "$AOT/mod/py" "$AOT/mod/libm" "$AOT/mod/expat" "$AOT/mod/pyexpat"
    local f
    for f in "$AOT/rt"/py/*.go; do case $f in *_test.go) ;; *) cp "$f" "$AOT/mod/py/" ;; esac; done
    for f in "$AOT/rt"/libm/*.go; do case $f in *_test.go) ;; *) cp "$f" "$AOT/mod/libm/" ;; esac; done
    for f in "$AOT/rt"/expat/*.go; do case $f in *_test.go) ;; *) cp "$f" "$AOT/mod/expat/" ;; esac; done
    for f in "$AOT/rt"/pyexpat/*.go; do case $f in *_test.go) ;; *) cp "$f" "$AOT/mod/pyexpat/" ;; esac; done
    echo "$key" > "$AOT/mod/runtime.key"
  fi
  # the host's compiler for what a compiled program compiles at run time (arbace.python.aot compile-server); its IR
  # cache and compiler digest on the "# ir-cache:" line, read by the compiled program first (aot.go's irCacheRead, 202b)
  cat > "$AOT/compiler.sh" <<SH
#!/bin/sh
# ir-cache: $WORK/ir-cache $(compiler_digest)
exec env ARBACE_PATH="$root" PYI_ROOT="$root" PYI_WORK="$WORK" PYI_RUN_ID="aot\$\$" GOMEMLIMIT=\${PYI_GOMEMLIMIT:-3GiB} \
  GOMAXPROCS=\${PYI_THREADS:-4} "$(arbace_exe)" -m arbace.python.aot compile-server
SH
  chmod +x "$AOT/compiler.sh"
}
# compiler_digest: arbace.python.run's compiler-digest (the key of its IR cache), the SHA-256 of each compiler source's
# name and text, NUL-terminated: compile, ir, scope and run, then arbace/repr/python's namespaces in name order
compiler_digest() {
  local f
  { for f in arbace/python/compile.ae arbace/python/ir.ae arbace/python/scope.ae arbace/python/run.ae \
             $(cd "$root" && ls arbace/repr/python/*.ae | LC_ALL=C sort); do
      [ -f "$root/$f" ] || continue
      printf '%s\0' "$f"; cat "$root/$f"; printf '\0'
    done; } | sha256sum | cut -c1-64
}
# aot_compile PKG FILE OUT: FILE compiled into the executable OUT; on a refusal OUT.refused holds the reason, on a
# compile-time error of the program OUT.cout, .cerr, .crc its outcome (CPython's: the SyntaxError, status 1)
aot_compile() {
  local pkg=$1 file=$2 out=$3 gen; gen=$(aot_gen)
  local src="$AOT/src/$pkg" w="$AOT/print/$pkg" log="$AOT/log/$pkg" cache="$(aot_shared)/pkgs-$gen"
  mkdir -p "$AOT/log" "$cache" "$(dirname "$out")"
  # the module's packages are the generator's: another generator's (named by the same IR hash) are dropped first
  if [ "$(cat "$AOT/mod/pyaot.gen" 2>/dev/null)" != "$gen" ]; then
    rm -rf "$AOT"/mod/pyaot/m*; echo "$gen" > "$AOT/mod/pyaot.gen"
  fi
  rm -rf "$src" "$w" "$AOT/mod/pyaot/$pkg" "$out" "$out".{refused,cout,cerr,crc}
  local rc=0
  pyi_env
  ARBACE_PATH="$root" GOMEMLIMIT=${PYI_GOMEMLIMIT:-3GiB} GOMAXPROCS=${PYI_THREADS:-4} \
    "$(arbace_exe)" -m arbace.python.aot program "$file" "$src" "$pkg" "$(stdlib_lib)" "$cache" > "$log.compile" 2>&1 || rc=$?
  if [ $rc = 4 ]; then
    local e; e=$(sed -n 's/^error //p' "$log.compile" | head -1)
    case $e in
      SyntaxError:*) : > "$out.cout"; echo "${e%%$'\x00'*}" > "$out.cerr"; echo 1 > "$out.crc"; return 0 ;;
    esac
    echo "the compiler refuses it: $e" > "$out.refused"; return 0
  elif [ $rc != 0 ]; then
    echo "arbace.python.aot fails: $(grep -m1 'rror\|xception' "$log.compile" || tail -1 "$log.compile")" > "$out.refused"; return 0
  fi
  if [ -d "$src/go" ] && ! "$root/bin/build-go" --print-only --module arbace --layout lines --work "$w" "$src" > "$log.print" 2>&1; then
    echo "repr/go does not print it: $(tail -1 "$log.print")" > "$out.refused"; return 0
  fi
  local nm st
  while read -r nm st; do
    # into the shared cache through a name of its own, then renamed (another worktree may write the same package:
    # its content is the same, keyed by the IR's hash)
    if [ "$st" = new ] || [ ! -d "$cache/$nm" ]; then
      rm -rf "$cache/.$nm.$$"; cp -r "$w/mod/pyaot/$nm" "$cache/.$nm.$$"
      rm -rf "$cache/$nm.old.$$"; [ ! -d "$cache/$nm" ] || mv "$cache/$nm" "$cache/$nm.old.$$" 2>/dev/null || true
      mv "$cache/.$nm.$$" "$cache/$nm" 2>/dev/null || rm -rf "$cache/.$nm.$$"; rm -rf "$cache/$nm.old.$$"
    fi
    [ -d "$AOT/mod/pyaot/$nm" ] || cp -r "$cache/$nm" "$AOT/mod/pyaot/$nm"
  done < <(awk '$1 == "module" && $4 != "-" {print $4, $5} $1 == "main" {print $2, $3}' "$log.compile")
  mkdir -p "$AOT/mod/pyaot/$pkg"; cp -r "$w/mod/pyaot/$pkg/prog" "$AOT/mod/pyaot/$pkg/"
  rm -rf "$src" "$w"
  if ! aot_go build -p 2 -trimpath ${PYI_AOT_GOFLAGS:-} -o "$out" "./pyaot/$pkg/prog" > "$log.build" 2>&1; then
    echo "go build fails: $(grep -m1 . "$log.build")" > "$out.refused"; return 0
  fi
}
# aot_run OUT ARGS...: the compiled program run as bin/pyi run runs pyi (its compile-time outcome when it has one)
aot_run() {
  local out=$1; shift
  if [ -f "$out.crc" ]; then cat "$out.cout"; cat "$out.cerr" >&2; return "$(cat "$out.crc")"; fi
  PYI_AOT_COMPILER="$AOT/compiler.sh" "$out" "$@"
}

# check --aot: the synthetic corpus and the samples (177's references, test/python/ref-cpython314.edn) compiled and run,
# each judged against CPython's reference (status, stdout's SHA-256, stderr's last line) and against the same program on
# the loop (PYI_AOT_LOOP: the same executable, every code object on the dispatch loop) and pyi's run (bin/pyi run, on
# goi; kept by the runtime's, the compiler's and the program's digest); see cmd_check_aot
aot_list() {
  { sed 's|^|synth/|' "$SYNTH/MANIFEST"; (cd "$root/test/python/samples" && ls *.py | sed 's|^|samples/|'); }
}
aot_file() { case $1 in synth/*) echo "$SYNTH/${1#synth/}" ;; samples/*) echo "$root/test/python/samples/${1#samples/}" ;; esac; }
# run_one DIR NAME CMD...: CMD in a fresh directory as refs.py runs the oracle (an empty stdin, HOME and TMPDIR inside
# WORK, the fixed environment, 120 s): DIR/NAME.out, .err, .rc, .time
run_one() {
  local d=$1 nm=$2; shift 2
  local cwd="$d/$nm.cwd"; rm -rf "$cwd"; mkdir -p "$cwd" "$WORK/home" "$WORK/tmp"
  local t0 t1 rc=0
  t0=$(date +%s%N)
  (cd "$cwd" && timeout "${PYI_AOT_TIMEOUT:-120}" env -i PATH=/usr/bin:/bin HOME="$WORK/home" TMPDIR="$WORK/tmp" PYTHONHASHSEED=0 \
     LC_ALL=C.UTF-8 TZ=UTC PYTHONIOENCODING=utf-8 PYTHONDONTWRITEBYTECODE=1 ARBACE_HOST_EXE="${ARBACE_HOST_EXE:-}" \
     ${PYI_AOT_LOOP:+PYI_AOT_LOOP=1} PYI_AOT_COMPILER="$AOT/compiler.sh" PYI_AOT_STATS="$d/$nm.stats" \
     "$@" < /dev/null > "$d/$nm.out" 2> "$d/$nm.err") || rc=$?
  t1=$(date +%s%N)
  [ $rc = 124 ] && rc=timeout
  echo "$rc" > "$d/$nm.rc"; echo $(( (t1 - t0) / 1000000 )) > "$d/$nm.time"
  rm -rf "$cwd"
}
# outcome DIR NAME: "STATUS SHA256 STDERR-LAST" of a run (the reference's fields)
outcome() {
  printf '%s\t%s\t%s\n' "$(cat "$1/$2.rc")" "$(sha256sum < "$1/$2.out" | cut -c1-64)" "$(grep -v '^[[:space:]]*$' "$1/$2.err" | tail -1)"
}
pyi_key() {
  { (cd "$root" && find go/arbace/py.ae go/arbace/py go/arbace/libm.ae go/arbace/libm go/arbace/expat.ae go/arbace/expat go/arbace/pyexpat.ae go/arbace/pyexpat arbace/python arbace/python.ae \
       arbace/repr/python tools/pydump/pydump.py -type f | LC_ALL=C sort | xargs sha256sum); sha256sum < "$1"; } | sha256sum | cut -c1-24
}

cmd_check_aot() {
  local record="" pyi=1 ids=() id
  while [ $# -gt 0 ]; do case $1 in --record) record=1; shift ;; --no-pyi) pyi=""; shift ;; --only) ids+=("$2"); shift 2 ;;
    --only-list) local lst n0=${#ids[@]}; lst=$(cd "$caller_pwd" && realpath -e "$2" 2>/dev/null) || die "check --aot: no list $2"
                 mapfile -t -O "${#ids[@]}" ids < <(grep -v '^[[:space:]]*\(#\|$\)' "$lst" | sed 's/[[:space:]]*$//')
                 [ ${#ids[@]} -gt "$n0" ] || die "check --aot: no id in $2"; shift 2 ;;
    *) die "check --aot: unknown $1" ;; esac; done
  [ ${#ids[@]} -gt 0 ] || mapfile -t ids < <(aot_list)
  aot_module
  local d="$AOT/check" pc="$AOT/pyi-runs"; mkdir -p "$d" "$pc"
  : > "$d/runs.tsv"
  for id in "${ids[@]}"; do
    local f nm pkg exe t0 ct
    f=$(aot_file "$id"); [ -f "$f" ] || die "no program $id"
    nm=${id//\//__}; pkg=p_$(echo "$nm" | tr -c 'A-Za-z0-9\n' '_'); exe="$AOT/bin/$pkg"
    t0=$(date +%s%N); aot_compile "$pkg" "$f" "$exe"; ct=$(( ($(date +%s%N) - t0) / 1000000 ))
    rm -f "$d/$nm".*
    if [ -f "$exe.refused" ]; then
      printf '%s\trefused\t%s\t%s\n' "$id" "$ct" "$(cat "$exe.refused")" >> "$d/runs.tsv"; echo "  $id: refused: $(cat "$exe.refused")"; continue
    fi
    if [ -f "$exe.crc" ]; then
      cp "$exe.cout" "$d/$nm.aot.out"; cp "$exe.cerr" "$d/$nm.aot.err"; cp "$exe.crc" "$d/$nm.aot.rc"; echo 0 > "$d/$nm.aot.time"
      cp "$exe.cout" "$d/$nm.loop.out"; cp "$exe.cerr" "$d/$nm.loop.err"; cp "$exe.crc" "$d/$nm.loop.rc"; echo 0 > "$d/$nm.loop.time"
    else
      run_one "$d" "$nm.aot" "$exe" "$f"
      PYI_AOT_LOOP=1 run_one "$d" "$nm.loop" "$exe" "$f"
    fi
    local pk="" pyo=$'-\t-\t-'
    if [ -n "$pyi" ]; then
      pk=$(pyi_key "$f")
      if [ ! -f "$pc/$pk.rc" ]; then run_one "$pc" "$pk" "$root/bin/pyi" run "$f"; fi
      pyo=$(outcome "$pc" "$pk")
    fi
    printf '%s\tran\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$ct" "$(outcome "$d" "$nm.aot")" "$(outcome "$d" "$nm.loop")" "$pyo" \
      "$(cat "$d/$nm.aot.time")" "$(cat "$d/$nm.loop.time")" "$(cat "$pc/$pk.time" 2>/dev/null || echo -)" >> "$d/runs.tsv"
    [ -f "$d/$nm.aot.stats" ] && sed "s|^|$id\t|" "$d/$nm.aot.stats" >> "$d/stats.tsv"
    rm -f "$exe"
    echo "  $id: compiled $(cat "$d/$nm.aot.rc"), loop $(cat "$d/$nm.loop.rc")${pk:+, pyi $(cat "$pc/$pk.rc")}"
  done
  aot_cache_trim
  local arch; case $(uname -m) in x86_64) arch=amd64 ;; aarch64) arch=arm64 ;; *) arch=$(uname -m) ;; esac
  pa_arbace_aot judge --runs "$d/runs.tsv" --ref "$REF" --classes "$root/test/python/divergences-aot.edn" \
    --results "$d/results.edn" ${record:+--record "$root/test/python/check-aot-linux-$arch.edn"}
}
pa_arbace_aot() {
  ARBACE_PATH="$root" GOMEMLIMIT=${PYI_GOMEMLIMIT:-3GiB} GOMAXPROCS=${PYI_THREADS:-4} "$(arbace_exe)" -m arbace.python.aot "$@"
}
# aot_cache_trim: Go's cache of the compiled programs kept under 2 GB
aot_cache_trim() {
  local c=${PYI_AOT_GOCACHE:-$(aot_shared)/gocache}
  [ -d "$c" ] || return 0
  if [ "$(du -sm "$c" | cut -f1)" -gt "${PYI_AOT_GOCACHE_MB:-2000}" ]; then aot_go clean -cache; fi
}

# bench [--pyi] [--record] [BM...]: pyperformance's pure-Python benchmarks (test/python/bench/benchmarks.tsv) as plain
# programs with fixed loops (the pyperf stand-in test/python/bench/pyperf.py), each run by CPython, compiled (pyi's AOT)
# and on the loop of the same executable (and with --pyi by pyi on goi): the whole process's seconds, the outputs
# compared with CPython's; --record writes test/python/bench-aot-linux-ARCH.edn
cmd_bench() {
  local record="" pyi="" bms=() b loops
  while [ $# -gt 0 ]; do case $1 in --record) record=1; shift ;; --pyi) pyi=1; shift ;; *) bms+=("$1"); shift ;; esac; done
  # the sdist's full benchmark directories (data files, variants' tomls: PY6h's REQUEST, queue 200)
  local src="$root/.tmp/repr-python/pyperformance-1.14.0/pyperformance/data-files/benchmarks"
  [ -d "$src" ] || "$root/bin/repr-python" pins --fetch >/dev/null
  aot_module
  local d="$AOT/bench"; mkdir -p "$d"; : > "$d/bench.tsv"
  local -A cls=()
  while IFS=$'\t' read -r b c; do cls[$b]=$c; done < <(sed -n 's/^{:id "\([^"]*\)" :class \(:[a-z0-9-]*\).*/\1\t\2/p' "$root/test/python/bench/classes.edn")
  local unclassed=0 bdir bargs
  while IFS=$'\t' read -r b loops bdir bargs; do
    case $b in '#'*|'') continue ;; esac
    if [ ${#bms[@]} -gt 0 ]; then case " ${bms[*]} " in *" $b "*) ;; *) continue ;; esac; fi
    # NAME LOOPS [DIR [ARGS]]: a variant runs DIR's benchmark with the toml's extra_opts as its arguments
    [ -n "$bdir" ] || bdir=$b
    local -a ba=(); [ -n "$bargs" ] && read -ra ba <<< "$bargs"
    local w="$d/$b"; rm -rf "$w"; mkdir -p "$w"
    cp -r "$src/$bdir/." "$w/"; cp "$root/test/python/bench/pyperf.py" "$w/"
    echo "LOOPS = $loops" > "$w/pyperf_loops.py"
    run_one "$d" "$b.cpython" python3 -s -B "$w/run_benchmark.py" "${ba[@]}"
    local pkg=p_bench_$b exe="$AOT/bin/p_bench_$b" ct t0
    t0=$(date +%s%N); aot_compile "$pkg" "$w/run_benchmark.py" "$exe"; ct=$(( ($(date +%s%N) - t0) / 1000000 ))
    local st=ran why=""
    if [ -f "$exe.refused" ]; then st=refused; why=$(cat "$exe.refused")
    else
      run_one "$d" "$b.aot" "$exe" "$w/run_benchmark.py" "${ba[@]}"
      PYI_AOT_LOOP=1 run_one "$d" "$b.loop" "$exe" "$w/run_benchmark.py" "${ba[@]}"
      [ -n "$pyi" ] && run_one "$d" "$b.pyi" "$root/bin/pyi" run "$w/run_benchmark.py" "${ba[@]}"
      rm -f "$exe"
      if [ "$(outcome "$d" "$b.aot")" != "$(outcome "$d" "$b.cpython")" ]; then st=differs; why="$(grep -v '^[[:space:]]*$' "$d/$b.aot.err" | tail -1)"
        case $why in ModuleNotFoundError:*) st=module-import ;; esac  # a C module of PY6's (the survey's §6.6): classed until it merges
      elif [ "$(cat "$d/$b.cpython.rc")" != 0 ]; then st=fails; why="CPython's run: $(grep -v '^[[:space:]]*$' "$d/$b.cpython.err" | tail -1)"; fi
    fi
    # a benchmark that does not run as CPython's needs its class (test/python/bench/classes.edn, each with its owner)
    if [ "$st" != ran ]; then
      if [ -n "${cls[$b]:-}" ]; then why="${cls[$b]} $why"; else why="UNCLASSED $why"; unclassed=$((unclassed + 1)); fi
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$b" "$loops" "$st" "$(cat "$d/$b.cpython.time")" "$(cat "$d/$b.aot.time" 2>/dev/null || echo -)" \
      "$(cat "$d/$b.loop.time" 2>/dev/null || echo -)" "$(cat "$d/$b.pyi.time" 2>/dev/null || echo -)" "$ct" "$why" | tee -a "$d/bench.tsv"
  done < "$root/test/python/bench/benchmarks.tsv"
  awk -F'\t' '$3 == "ran" {n++; c += $4; a += $5; l += $6} END {if (n) printf "bench: %d benchmarks ran as CPython: CPython %d ms, compiled %d ms, the loop %d ms (loop/compiled %.2f, compiled/CPython %.1f)\n", n, c, a, l, l / a, a / c}' "$d/bench.tsv"
  if [ -n "$record" ]; then
    local arch; case $(uname -m) in x86_64) arch=amd64 ;; aarch64) arch=arm64 ;; *) arch=$(uname -m) ;; esac
    { echo ";; pyi's AOT's speed (bin/pyi bench --record; doc/python/PYTHON-SURVEY.md, \"As built: PY8\"): pyperformance 1.14.0's"
      echo ";; pure-Python benchmarks as plain programs (test/python/bench), the whole process's milliseconds on the recording"
      echo ";; machine ($(uname -m), $(date -u +%F)): CPython 3.14.10, compiled, the loop of the same executable, pyi on goi (- not run);"
      echo ";; :result :ran (the output CPython's), :module-import (a C module of PY6's missing: classed until PY6), :differs,"
      echo ";; :fails (CPython's run fails) or :refused, with the reason. Machine-dependent: not a reference."
      awk -F'\t' 'function esc(s) { gsub(/[\\"]/, "_", s); return s } {printf "{:id \"%s\" :loops %s :result :%s :cpython-ms %s :aot-ms %s :loop-ms %s :pyi-ms %s :compile-ms %s%s}\n", $1, $2, $3, $4, ($5 == "-" ? "nil" : $5), ($6 == "-" ? "nil" : $6), ($7 == "-" ? "nil" : $7), $8, ($9 == "" ? "" : " :reason \"" esc($9) "\"")}' "$d/bench.tsv"
    } > "$root/test/python/bench-aot-linux-$arch.edn"
  fi
  awk -F'\t' '$3 != "ran" {n++} END {printf "bench: %d not run as CPython, each classed in test/python/bench/classes.edn or UNCLASSED\n", n}' "$d/bench.tsv"
  [ "$unclassed" -eq 0 ] || { echo "bench: $unclassed benchmarks not run as CPython and of no class"; return 1; }
}

cmd_aot() {
  [ $# -ge 1 ] || die "usage: bin/pyi aot FILE.py [ARGS...]"
  local f argv0=$1; shift
  case $argv0 in /*) f=$argv0 ;; *) f=$caller_pwd/$argv0 ;; esac
  [ -f "$f" ] || die "no file $argv0"
  aot_module
  local pkg; pkg=p_$(basename "$f" .py | tr -c 'A-Za-z0-9\n' '_')
  aot_compile "$pkg" "$f" "$AOT/bin/$pkg"
  [ -f "$AOT/bin/$pkg.refused" ] && die "aot: refused: $(cat "$AOT/bin/$pkg.refused")"
  aot_run "$AOT/bin/$pkg" "$argv0" "$@"
}

# lib-test-all [--oracle] [--record] [--judge DIR] [--fresh] [--all] [MODULE...] (PY6i): see the header
cmd_lib_test_all() {
  local oracle="" record="" judge="" fresh="" all="" mods=() d rc=0
  while [ $# -gt 0 ]; do case $1 in --oracle) oracle=1; shift ;; --record) record=1; shift ;; --fresh) fresh=1; shift ;; --all) all=1; shift ;;
    --judge) judge=$2; shift 2 ;; *) mods+=("$1"); shift ;; esac; done
  [ -f "$REF_ALL" ] || die "no $REF_ALL (bin/pyi record-ref lib-test-all)"
  local owners="$root/test/python/lib-test-all-owners.tsv" refmods="$WORK/lib-test-all/ref-modules.txt"
  mkdir -p "$WORK/lib-test-all"; sed -n 's/^{:id "\([^"/]*\)" :module true.*/\1/p' "$REF_ALL" > "$refmods"
  # the modules a family owns are the family's to measure (test/python/lib-test-all-owners.tsv), but by --all or --oracle
  if [ ${#mods[@]} -eq 0 ]; then
    if [ -n "$all$oracle" ]; then mapfile -t mods < "$refmods"
    else mapfile -t mods < <(pyall owned --owners "$owners" --modules "$refmods" --invert); fi
  fi
  if [ -n "$judge" ]; then
    d=$(cd "$caller_pwd" && cd "$judge" && pwd)
  else
    d="$WORK/lib-test-all/run${oracle:+-oracle}"
    [ -z "$fresh" ] || rm -rf "$d"
    mkdir -p "$d"; printf '%s\n' "${mods[@]}" > "$d/modules.txt"
    PYI_LIB_TEST_SKIP="${PYI_LIB_TEST_SKIP-$root/test/python/lib-test-skip.tsv}" pyall run --root "$root" --modules "$d/modules.txt" --dir "$d" --jobs "${PYI_LIB_TEST_JOBS:-2}" \
      --test-timeout "${PYI_LIB_TEST_TEST_TIMEOUT:-300}" --module-timeout "${PYI_LIB_TEST_TIMEOUT:-3600}" ${oracle:+--oracle "$(stdlib_lib)"} \
      --tmp-base "${PYI_LIB_TEST_TMP:-$root/.tmp/t6i}"
  fi
  rm -f "$d/summary.tsv"
  [ -n "$judge" ] && [ -f "$d/modules.tsv" ] || printf '%s\tlib-test-all\n' "${mods[@]}" > "$d/modules.tsv"
  "$(arbace_exe)" "$root/test/python/libtest_judge.ae" --dir "$d" --ref "$REF_ALL" --modules "$d/modules.tsv" \
    $(if [ -n "$oracle" ]; then echo --no-classes; else echo --classes "$DIV" --record "$CHECK_RECORD"; fi) ${record:+--write-record} > "$d/judge.log" || rc=$?
  grep -v '^  FAIL ' "$d/judge.log" | tail -n 1
  echo "lib-test-all: $(grep -c '^  FAIL ' "$d/judge.log") methods failing (listed in $d/judge.log)"
  # the table's rows of the families' and the not-run modules: regrtest's whole list (record-ref lib-test-all's)
  local allmods="$WORK/lib-test-all/all-modules.txt"; [ -f "$allmods" ] || allmods=$refmods
  pyall table --dir "$d" --summary "$d/summary.tsv" --out "$d/table.md" ${oracle:---owners "$owners" --modules "$allmods"}
  pyall controls --dir "$d" --controls "$CONTROLS" --ref "$REF_ALL" \
    --judge "$(arbace_exe)" "$root/test/python/libtest_judge.ae" || rc=1
  return $rc
}

# PY7 (queue 201): the check over Lib/test (doc/python/PYTHON-SURVEY.md, "As built: PY7 (the check)").
# check_universe: every module of the check, MODULE<TAB>CORPUS, in the corpora's order: the lib-test corpora of
# corpora.edn (language-core, stdlib-tests, lib-test-asyncio: the families') and lib-test-all (the modules of
# ref-cpython314-lib-test-all.edn less the families', test/python/lib-test-all-owners.tsv); kept in WORK/universe.tsv by
# the digest of corpora.edn, the owners and the references' module lines
check_universe() {
  local u="$WORK/universe.tsv" k c m
  k=$(cat "$root/test/python/corpora.edn" "$root/test/python/lib-test-all-owners.tsv" <(grep -h ':module true' "$REF_LT" "$root"/test/python/ref-cpython314-lib-test-*.edn) | sha256sum | cut -c1-16)
  if [ "$(cat "$u.key" 2>/dev/null)" != "$k" ]; then
    # the families' corpora: each reference module (ref-cpython314-lib-test.edn's and lib-test-asyncio's :module lines) in
    # the corpus one of whose paths names it or the package above it (test_importlib's one module, test_asyncio's each)
    "$(arbace_exe)" -e "(doseq [c (:corpora (read-string (slurp \"$root/test/python/corpora.edn\"))) :when (#{:language-core :stdlib-tests :lib-test-asyncio} (:id c)) p (get-in c [:where :paths])] (println (str (-> p (subs 9) (arbace.string/replace #\"\\.py\$\" \"\")) \"\t\" (name (:id c)))))" > "$WORK/corpus-names.tsv"
    grep -h ':module true' "$REF_LT" "$root/test/python/ref-cpython314-lib-test-asyncio.edn" | sed 's/^{:id "\([^"]*\)".*/\1/' \
      | awk -F'\t' 'NR == FNR {n[$1] = $2; order[$2] = FNR; next}
                   {m = $1; c = n[m]; if (c == "") { split(m, q, "."); c = n[q[1]] } if (c != "") print order[c] "\t" m "\t" c}' "$WORK/corpus-names.tsv" - \
      | sort -t$'\t' -k1,1n -k2,2 | cut -f2- > "$u.new"
    sed -n 's/^{:id "\([^"/]*\)" :module true.*/\1/p' "$REF_ALL" > "$WORK/ref-all-modules.txt"
    pyall owned --owners "$root/test/python/lib-test-all-owners.tsv" --modules "$WORK/ref-all-modules.txt" --invert | sed 's/$/\tlib-test-all/' >> "$u.new"
    awk -F'\t' '!seen[$1]++' "$u.new" > "$u"; rm -f "$u.new"; echo "$k" > "$u.key"
  fi
  cat "$u"
}
# module_corpora MODULE...: each module with its corpus of the universe (lib-test-all when it has none)
module_corpora() {
  local m; check_universe > "$WORK/universe.now"
  for m in "$@"; do awk -F'\t' -v m="$m" '$1 == m {print; f=1; exit} END {if (!f) print m "\tlib-test-all"}' "$WORK/universe.now"; done
}

# check [--corpus ID,...] [--only FILE] [--record] [--judge DIR] [--oracle] [--fresh] [MODULE...]: Lib/test under pyi,
# every module of the universe (check_universe; --corpus some corpora, MODULE some modules, --only FILE a selection:
# lines MODULE or MODULE/TEST-ID, # and blank lines ignored, the gate's rotation's lists) run through the restartable
# runner (tools/pyi/libtest_all.py run: a test's crash or timeout ends that test alone) into WORK/check/run (resumed;
# --fresh: anew; a selection's own directory, by its list's digest), then judged by libtest_judge.ae: every method
# against CPython's references, a non-pass in a class of test/python/divergences.edn, a method the record passes
# that does not pass now a regression (test/python/check-lib-test-linux-amd64.edn, PYI_CHECK_RECORD another); the
# rows in RUN/results.tsv (ID RESULT REASON CORPUS: bin/cover classes' RESULTS), the failing methods' lines
# "   failing: ID"; then the negative controls (test/python/controls.edn, GTS81 (a): a subject's run judged as another
# module, against its references, with no classes; one that passes, or is not judged, fails the check; a subject not
# run is left). --record: the record's rows of the modules run written again (refused with --only; exit 3 on a method
# of no class); --judge DIR: DIR's run judged again, nothing run; --oracle: the driver by python3 (the runner's control:
# every method equal but the references' :excluded and the 2 of test_tracemalloc's frames, PY6i).
cmd_check_lib() {
  local corpora="" only="" record="" judge="" oracle="" fresh="" cover="" mods=() d rc=0 onlyf=""
  while [ $# -gt 0 ]; do case $1 in --corpus) corpora=$2; shift 2 ;; --only) only=$(cd "$caller_pwd" && realpath "$2"); shift 2 ;;
    --cover) cover=$2; shift 2 ;;
    --record) record=1; shift ;; --judge) judge=$2; shift 2 ;; --oracle) oracle=1; shift ;; --fresh) fresh=1; shift ;;
    -*) die "check: unknown option $1" ;; *) mods+=("$1"); shift ;; esac; done
  [ -z "$record" ] || [ -z "$only$oracle$cover" ] || die "check --record of a selection, the oracle or the cover run: refused"
  local refs=(--ref "$REF_LT"); local r; for r in "$root"/test/python/ref-cpython314-lib-test-*.edn; do refs+=(--ref "$r"); done
  if [ -n "$judge" ]; then
    d=$(cd "$caller_pwd" && cd "$judge" && pwd)
    [ -f "$d/modules.tsv" ] || die "check --judge: no $d/modules.tsv"
  else
    check_universe > "$WORK/universe.now"
    local sel="$WORK/universe.now"
    if [ -n "$corpora" ]; then awk -F'\t' -v cs=",$corpora," 'index(cs, "," $2 ",")' "$sel" > "$WORK/check-sel.tsv"; sel="$WORK/check-sel.tsv"; fi
    if [ ${#mods[@]} -gt 0 ]; then module_corpora "${mods[@]}" > "$WORK/check-mods.tsv"; sel="$WORK/check-mods.tsv"; fi
    d="$WORK/check/run${oracle:+-oracle}"; [ -z "$cover" ] || d="$cover/run"
    if [ -n "$only" ]; then
      local ok="$WORK/check-only.txt"
      # the controls' subjects (GTS81 (a)) run whole with every selection, so every rotated run judges its controls
      { grep -v '^[[:space:]]*\(#\|$\)' "$only" | sed 's/[[:space:]]*$//'; sed -n 's/.*:subject "\([^"]*\)".*/\1/p' "$CONTROLS"; } | sort -u > "$ok" || true
      awk -F'\t' 'NR == FNR {split($1, p, "/"); want[p[1]] = 1; next} want[$1]' "$ok" "$sel" > "$WORK/check-only.tsv"
      sel="$WORK/check-only.tsv"
      d="$WORK/check/only-$(sha256sum < "$ok" | cut -c1-12)${oracle:+-oracle}"; [ -z "$cover" ] || d="$cover/run-$(sha256sum < "$ok" | cut -c1-12)"
    fi
    [ -s "$sel" ] || die "check: no module selected"
    [ -z "$fresh" ] || rm -rf "$d"
    mkdir -p "$d"; cp "$sel" "$d/modules.tsv"; cut -f1 "$sel" > "$d/modules.txt"
    local lib=""; [ -z "$oracle" ] || lib=$(stdlib_lib)
    # --cover DIR (bin/pyi cover run): the driver compiled by pyi's AOT with Go's coverage of the runtime (cover_driver),
    # each test's counters in DIR/tests/N (tools/pyi/libtest_cover.go)
    local drv="" ctests=""
    if [ -n "$cover" ]; then AOT="$WORK/aot-cover"; drv=$(cover_driver) || return 1; ctests="$cover/tests"; mkdir -p "$ctests"; fi
    PYI_LIB_TEST_DRIVER_EXE="$drv" PYI_AOT_COMPILER="${drv:+$AOT/compiler.sh}" PYI_LIB_TEST_COVER_TESTS="$ctests" \
    PYI_LIB_TEST_ONLY="${only:+$WORK/check-only.txt}" PYI_LIB_TEST_SKIP="${PYI_LIB_TEST_SKIP-$root/test/python/lib-test-skip.tsv}" \
      pyall run --root "$root" --modules "$d/modules.txt" --dir "$d" --jobs "${PYI_LIB_TEST_JOBS:-2}" \
      --test-timeout "${PYI_LIB_TEST_TEST_TIMEOUT:-300}" --module-timeout "${PYI_LIB_TEST_TIMEOUT:-3600}" ${oracle:+--oracle "$lib"} \
      --tmp-base "${PYI_LIB_TEST_TMP:-$root/.tmp/t6i}"
    if [ -n "$only" ]; then cp "$WORK/check-only.txt" "$d/only.txt"; else rm -f "$d/only.txt"; fi
  fi
  [ ! -f "$d/only.txt" ] || onlyf="$d/only.txt"
  "$(arbace_exe)" "$root/test/python/libtest_judge.ae" --name "pyi check" --dir "$d" --modules "$d/modules.tsv" "${refs[@]}" \
    ${onlyf:+--only "$onlyf"} --save "$d/results.tsv" \
    $(if [ -n "$oracle" ]; then echo --no-classes; else echo --classes "$DIV" --record "$CHECK_RECORD"; fi) ${record:+--write-record} > "$d/judge.log" || rc=$?
  grep -v '^  FAIL \|^   failing: \|^pyi check test' "$d/judge.log" || true
  grep '^   failing: ' "$d/judge.log" | head -n "${PYI_CHECK_SHOW:-200}" || true
  echo "pyi check: $(grep -c '^   failing: ' "$d/judge.log") methods failing (listed in $d/judge.log)"
  if [ -z "$oracle" ]; then
    local refsc; refsc=$(printf '%s\n' "${refs[@]}" | grep -v '^--ref$' | paste -sd,)
    pyall controls --dir "$d" --controls "$CONTROLS" --ref "$refsc" --judge "$(arbace_exe)" "$root/test/python/libtest_judge.ae" || rc=1
  fi
  return $rc
}

# cover_driver: test/python/libtest_run.py compiled by pyi's AOT (PY8) in the module of WORK/aot-cover, its runtime with
# tools/pyi/libtest_cover.go and built with -cover -covermode=atomic -coverpkg=arbace/py and its main package (Go sets
# its coverage up only from an instrumented main; the main's blocks are no runtime's): the runtime's blocks are Go's
# there (under goi, bin/pyi run's, Go's -cover sees only goi's own); prints its path
cover_driver() {
  AOT="$WORK/aot-cover"; aot_module
  cp "$root/tools/pyi/libtest_cover.go" "$AOT/mod/py/zz_libtest_cover.go"
  local drv="$AOT/bin/p_libtestrun"
  PYI_AOT_GOFLAGS="-cover -covermode=atomic -coverpkg=arbace/py,arbace/pyaot/p_libtestrun/prog" aot_compile p_libtestrun "$root/test/python/libtest_run.py" "$drv" >&2
  [ ! -f "$drv.refused" ] || die "cover: the driver is refused: $(cat "$drv.refused")"
  echo "$drv"
}

# cover run [check's options] | blocks | subset [--write]: the coverage subset of Lib/test's methods (GT8.3, GTS205 (a)'s
# rule, GTS206 (a)): run, the check through the cover driver (cover_driver) into WORK/cover (the main host's night: every
# module, each method's own block set); blocks, tools/covsubset blocks over WORK/cover/tests (bin/cover's tool): each
# method's blocks of arbace/py; subset, the methods that reach every covered block, one method per class of
# divergences.edn (the cheapest), every method of a :deferred class, the controls' subjects and references
# (tools/covsubset reduce via bin/cover subset), per corpus into WORK/cover/subset/CORPUS.txt; --write puts them into
# test/python/corpora.edn as each corpus's :subset (lib-test-all's in its :lib-test-all map)
cmd_cover() {
  local verb=${1:-}; shift || true
  local C="$WORK/cover" goroot=${ARBACE_GOROOT:-/root/tamago-go}
  case $verb in
    run) mkdir -p "$C"; cmd_check_lib --cover "$C" "$@" ;;
    blocks)
      [ -d "$C/tests" ] || die "cover blocks: no $C/tests (bin/pyi cover run)"
      # tools/covsubset, built by TamaGo's go as bin/cover builds it (into .tmp/cover-tool, by its sources' digest)
      local ex="$root/.tmp/cover-tool/covsubset" k
      k=$(cat "$root"/tools/covsubset/*.go "$root/tools/covsubset/go.mod" "$goroot/VERSION" | sha256sum | cut -c1-64)
      if [ "$(cat "$ex.key" 2>/dev/null)" != "$k" ] || [ ! -x "$ex" ]; then
        mkdir -p "$root/.tmp/cover-tool"
        (cd "$root/tools/covsubset" && env -u GOOS -u GOARCH GOROOT="$goroot" GOFLAGS= GOTOOLCHAIN=local CGO_ENABLED=0 \
          "$goroot/bin/go" build -trimpath -buildvcs=false -o "$ex.new" .) && mv -f "$ex.new" "$ex" && echo "$k" > "$ex.key" \
          || die "cover blocks: tools/covsubset did not build"
      fi
      echo arbace/py > "$C/pkgs.txt"
      find "$C/tests" -mindepth 1 -maxdepth 1 -type d ! -name meta | LC_ALL=C sort > "$C/dirs.txt"
      rm -rf "$C/blocks"
      xargs -a "$C/dirs.txt" -d '\n' "$ex" blocks -go "$goroot/bin/go" -pkgs "$C/pkgs.txt" -o "$C/blocks" -j "${COVER_JOBS:-8}" ;;
    subset)
      local write=""; [ "${1:-}" != --write ] || write=1
      [ -f "$C/blocks/tests.tsv" ] || die "cover subset: no $C/blocks/tests.tsv (bin/pyi cover blocks)"
      local res; res=$(ls -t "$C"/run*/results.tsv 2>/dev/null | head -1); [ -n "$res" ] || die "cover subset: no results"
      # the keep list: every method of a :deferred class, the controls' modules' methods, one method per class (the
      # first in the record's order: the reducer's --classes picks one a class, the cheapest by --times)
      "$root/bin/cover" classes "$DIV" "$res" -o "$C/classes" > /dev/null
      awk -F'\t' 'NR == FNR {c[$1] = 1; next} {split($1, p, "/"); if (p[1] in c) print $1}' \
        <(sed -n 's/.*:subject "\([^"]*\)" :reference "\([^"]*\)".*/\1\n\2/p' "$CONTROLS") "$res" >> "$C/classes.keep"
      LC_ALL=C sort -u -o "$C/classes.keep" "$C/classes.keep"
      "$root/bin/cover" subset "$C/blocks" --keep "$C/classes.keep" --classes "$C/classes.classes" ${PYI_COVER_TIMES:+--times "$PYI_COVER_TIMES"}
      mkdir -p "$C/subset"
      awk -F'\t' 'NR == FNR {s[$1] = 1; next} ($1 in s) {print $1 > (out "/" $4 ".txt")}' out="$C/subset" "$C/blocks/subset.txt" "$res"
      wc -l "$C"/subset/*.txt
      [ -z "$write" ] || "$(arbace_exe)" "$root/test/python/corpora_subset.ae" "$root/test/python/corpora.edn" "$C/subset" ;;
    *) die "usage: bin/pyi cover run [check's options] | blocks | subset [--write]" ;;
  esac
}

# divergences [--table | --methods] [--results FILE...]: the record's non-passes (or a run's saved rows), each in a class
# of test/python/divergences.edn, counted by class; a non-pass in no class, or a name of :tests another class takes
# first, fails (GR10, as bin/goi divergences); --table the classes as a Markdown table, --methods every method by class
cmd_divergences() {
  local args=() f
  while [ $# -gt 0 ]; do case $1 in --table|--methods) args+=("$1"); shift ;;
    --results) f=$(cd "$caller_pwd" && realpath "$2"); args+=(--results "$f"); shift 2 ;; *) die "divergences: unknown option $1" ;; esac; done
  if [ ! -f "$CHECK_RECORD" ] && ! printf '%s\n' "${args[@]+"${args[@]}"}" | grep -q -- --results; then
    echo "pyi divergences: no record yet ($CHECK_RECORD: bin/pyi check --record on the main host)"; return 0
  fi
  "$(arbace_exe)" "$root/test/python/libtest_judge.ae" --name pyi --divergences --classes "$DIV" --record "$CHECK_RECORD" "${args[@]+"${args[@]}"}"
}

RT="$WORK/runtime"
tamago_go() { (cd "$RT" && env GOROOT= PATH="${ARBACE_GOROOT:-/root/tamago-go}/bin:$PATH" GOCACHE="$WORK/gocache" GOFLAGS=-mod=mod CGO_ENABLED=0 GOTOOLCHAIN=local "$@"); }

runtime_print() {
  local out=$1
  rm -rf "$out"; mkdir -p "$out/py"
  printf 'module arbace\n\ngo 1.27\n' > "$out/go.mod"
  ARBACE_PATH="$root" "$root/bin/repr-go" print "$root/go/arbace/py.ae" "$out/py" >/dev/null
  # the musl libm port the runtime imports (go/arbace/libm, shared with hsi): printed beside it, not read back
  mkdir -p "$out/libm"
  ARBACE_PATH="$root" "$root/bin/repr-go" print "$root/go/arbace/libm.ae" "$out/libm" >/dev/null
  # expat's port the module pyexpat imports (go/arbace/expat, queue 202e): printed beside it, not read back
  mkdir -p "$out/expat"
  ARBACE_PATH="$root" "$root/bin/repr-go" print "$root/go/arbace/expat.ae" "$out/expat" >/dev/null
  # pyexpat's package (go/arbace/pyexpat, over py and expat), loaded on the module's first import: printed beside them
  mkdir -p "$out/pyexpat"
  ARBACE_PATH="$root" "$root/bin/repr-go" print "$root/go/arbace/pyexpat.ae" "$out/pyexpat" >/dev/null
}

runtime_read() {
  local src=$1 out=$2
  rm -rf "$out"
  (cd "$src" && "$root/bin/repr-go" read --full --tests --goos linux --goarch amd64 --out "$out" ./py) > "$out.log" 2>&1 \
    || { cat "$out.log" >&2; die "the runtime's Go does not read (log $out.log)"; }
}

cmd_runtime() {
  local verb=${1:-}
  case $verb in
    print) runtime_print "$RT"; echo "the runtime's Go in $RT/py: edit it there, then bin/pyi runtime read" ;;
    read)
      [ -d "$RT/py" ] || die "no $RT/py: bin/pyi runtime print first"
      runtime_read "$RT" "$WORK/runtime-forms"
      rm -rf "$root/go/arbace/py" "$root/go/arbace/py.ae"
      cp -r "$WORK/runtime-forms/go/arbace/py" "$WORK/runtime-forms/go/arbace/py.ae" "$root/go/arbace/"
      echo "go/arbace/py read from $RT/py ($(ls "$root/go/arbace/py" | wc -l) files)" ;;
    vet)
      [ -d "$RT/py" ] || runtime_print "$RT"
      tamago_go gofmt -l py | sed 's/^/not gofmt: /' | grep . && die "gofmt the runtime's Go first"
      tamago_go go vet ./py ./expat ./pyexpat
      tamago_go go test ./py ./expat ./pyexpat ;;
    check)
      local rc=0 t="$WORK/runtime-check" p
      runtime_print "$t/src"
      runtime_read "$t/src" "$t/forms"
      if diff -r "$root/go/arbace/py" "$t/forms/go/arbace/py" >/dev/null && cmp -s "$root/go/arbace/py.ae" "$t/forms/go/arbace/py.ae"; then
        echo "runtime: go/arbace/py printed and read again: the same forms"
      else
        echo "runtime: go/arbace/py printed and read again DIFFERS (diff -r go/arbace/py $t/forms/go/arbace/py)"; rc=1
      fi
      # expat's port and pyexpat's package (queue 202e): printed and read again the same forms
      for p in expat pyexpat; do
        (cd "$t/src" && "$root/bin/repr-go" read --full --tests --goos linux --goarch amd64 --out "$t/$p-forms" "./$p") \
          > "$t/$p-forms.log" 2>&1 || { cat "$t/$p-forms.log" >&2; rc=1; }
        if diff -r "$root/go/arbace/$p" "$t/$p-forms/go/arbace/$p" >/dev/null \
           && cmp -s "$root/go/arbace/$p.ae" "$t/$p-forms/go/arbace/$p.ae"; then
          echo "runtime: go/arbace/$p printed and read again: the same forms"
        else
          echo "runtime: go/arbace/$p printed and read again DIFFERS (diff -r go/arbace/$p $t/$p-forms/go/arbace/$p)"; rc=1
        fi
      done
      # the Unicode database's tables (PY6c): builtins_unicodedata_table.go as tools/pyi/unicodedata_table.py makes it
      # from the pinned tarball's generated headers
      local top="$root/.tmp/repr-python/Python-3.14.10"
      [ -d "$top/Lib" ] || "$root/bin/repr-python" pins --fetch >/dev/null
      if python3 -I -S -B "$root/tools/pyi/unicodedata_table.py" "$top" "$t/src/py/builtins_unicodedata_table.go" --check; then
        echo "runtime: builtins_unicodedata_table.go is unicodedata_table.py's from the tarball's headers"
      else
        echo "runtime: builtins_unicodedata_table.go DIFFERS from unicodedata_table.py's"; rc=1
      fi
      # the CJK codecs' tables (PY6c2): builtins_cjk_table.go as tools/pyi/cjkcodecs_table.py makes it from the pinned
      # tarball's Modules/cjkcodecs/mappings_*.h
      if python3 -I -S -B "$root/tools/pyi/cjkcodecs_table.py" "$top" "$t/src/py/builtins_cjk_table.go" --check; then
        echo "runtime: builtins_cjk_table.go is cjkcodecs_table.py's from the tarball's headers"
      else
        echo "runtime: builtins_cjk_table.go DIFFERS from cjkcodecs_table.py's"; rc=1
      fi
      pa_arbace runtime-ops || rc=1
      local n=0 bad=0
      for p in "$root"/test/python/pyi/*.py; do
        n=$((n + 1))
        local want got
        want=$(cd "$(dirname "$p")" && smoke_run python3 -I "$(basename "$p")")
        got=$(cd "$(dirname "$p")" && smoke_run "$root/bin/pyi" run "$(basename "$p")")
        if [ "$want" = "$got" ]; then echo "  pass $(basename "$p")"; else
          echo "  FAIL $(basename "$p")"; { diff <(echo "$want") <(echo "$got") | head -10 || true; }; bad=$((bad + 1)); fi
      done
      echo "runtime: $n programs of test/python/pyi run by pyi as by the oracle: $((n - bad)) equal"
      [ $bad -eq 0 ] || rc=1
      repl_check || rc=1
      return $rc ;;
    *) die "usage: bin/pyi runtime print|read|vet|check" ;;
  esac
}

# smoke_run CMD...: the run's stdout, its exit status and stderr's last line, for comparing pyi with the oracle
smoke_run() {
  local o e rc=0
  o=$(mktemp "$WORK/smoke.XXXXXX"); e=$(mktemp "$WORK/smoke.XXXXXX")
  timeout 120 env HOME="$WORK" TMPDIR="$WORK" "$@" > "$o" 2> "$e" || rc=$?
  cat "$o"; echo "status $rc"; echo "stderr $(tail -n 1 "$e")"
  rm -f "$o" "$e"
}

command -v python3 >/dev/null || die "no python3 (the oracle)"
case "${1:-}" in
  gen) shift; cmd_gen "$@" ;;
  record-ref) shift; cmd_record_ref "$@" ;;
  scope-check) shift; cmd_scope_check "$@" ;;
  compile-check) shift; cmd_compile_check "$@" ;;
  run) shift; mkdir -p "$WORK"; cmd_run "$@" ;;
  repl) shift; mkdir -p "$WORK"; cmd_repl "$@" ;;
  lib-test) shift; mkdir -p "$WORK"; cmd_lib_test "$@" ;;
  python) shift; mkdir -p "$WORK"; cmd_python "$@" ;;
  lib-test-all) shift; mkdir -p "$WORK"; cmd_lib_test_all "$@" ;;
  runtime) shift; mkdir -p "$WORK"; cmd_runtime "$@" ;;
  aot) shift; mkdir -p "$WORK"; cmd_aot "$@" ;;
  bench) shift; mkdir -p "$WORK"; cmd_bench "$@" ;;
  check) shift; mkdir -p "$WORK"; if [ "${1:-}" = --aot ]; then shift; cmd_check_aot "$@"; else cmd_check_lib "$@"; fi ;;
  divergences) shift; mkdir -p "$WORK"; cmd_divergences "$@" ;;
  cover) shift; mkdir -p "$WORK"; cmd_cover "$@" ;;
  *) sed -n '2,/^# Environment:/p' "$0"; exit 2 ;;
esac

#!/bin/bash
# The box on the Mac (B1b S4, doc/go/BOX-NOTES.md, "S4", BX66): a tarball for a Mac with Apple
# silicon (Hypervisor.framework), built here, that the user copies to the Mac and runs there:
#
#   target/arbace-go/arbace-box-mac-arm64.tar.gz
#     arbace-box-mac-arm64/arbace-box               the launcher, darwin/arm64, cgo off (purego,
#                                                   box/go/arbace/box/purego: BX62)
#     arbace-box-mac-arm64/arbace-box.elf           the arm64 guest (bin/arbace-go --build --box,
#                                                   ARBACE_BOX_ARCHES=arm64), beside the launcher:
#                                                   the code signature covers the Mach-O alone
#     arbace-box-mac-arm64/hv.test                  hv's tests for darwin/arm64 (the framework's)
#     arbace-box-mac-arm64/arbace-box.entitlements  com.apple.security.hypervisor
#     arbace-box-mac-arm64/mac.sh                   the checklist (box/mac/mac.sh), after go-whim's
#                                                   guest/mac/mac.sh
#     arbace-box-mac-arm64/README.txt, VERSION
#     arbace-box-mac-arm64/goi/                     goi's check in the box (doc/go/GOI-SPEC.md, "As
#                                                   built: the arm64 box check", GC76): the programs
#                                                   of test/goi/box.txt as bin/goi check --box
#                                                   --bundle writes them (each one's input, gc's
#                                                   console on Linux, programs.tsv, known.tsv), for
#                                                   mac.sh goi
#     arbace-box-mac-arm64/rebuild/store            S8's rebuild (doc/go/BOX-NOTES.md, "S8: the
#                                                   rebuild in the box"): a store holding the commit's
#                                                   sources (the ref src, as bin/box-rebuild prepare
#                                                   makes it), the arm64 tool guests and the
#                                                   toolchain's facts (bin/box-tools put)
#     arbace-box-mac-arm64/rebuild/expected.txt     the image the same steps give on Linux with the
#                                                   host's tools (bin/box-rebuild --arch arm64 host:
#                                                   the ref rebuilt.host.arm64 of its store)
#
#   bin/box-mac-bundle            build the arm64 guest when missing or stale, the launcher and
#                                 hv.test, and the tarball; the rebuild's expected image from
#                                 MAC_REBUILD_DIR (default .tmp/box-rebuild/arm64: bin/box-rebuild
#                                 --arch arm64 [--dir DIR] prepare host first, for the commit HEAD)
#
# Everything bundled is HEAD's (bin/lib/fresh.bash): the arm64 guest, when it does not carry the
# version of HEAD (clean unless the checkout is dirty) or was not linked from the program of the
# last bin/arbace-go --build (its image.key), is built again, as bin/arbace-go --build --box
# builds the guests: from that program, so the native executable that build made
# (target/arbace-go/<host arch>/arbace) must be HEAD's, else the bundle stops (bin/arbace-go
# --build: minutes, left to the user, as the expected image is); the store tool (the host's
# launcher) must be HEAD's; the expected image must come from bin/box-rebuild's host step on
# HEAD's executables (MAC_REBUILD_DIR/host.verified). A stale file stops the bundle with the
# command that rebuilds it; ARBACE_BOX_STALE_OK=1 (experiments) only warns. The launcher and
# hv.test are built here, always.
#
# On the Mac: tar xzf arbace-box-mac-arm64.tar.gz && cd arbace-box-mac-arm64 && ./mac.sh all;
# then send back mac-results.tar.gz (README.txt).
set -euo pipefail
export CGO_ENABLED=0 # Go's builds never use cgo (doc/go/BOX-NOTES.md, "... cgo dropped", 2026-10-16)
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/renamed-env.bash" # stops on a stale G2A_*, J2A_*, A2G_* or C2A_*
dir=$root/target/arbace-go
tg=${ARBACE_GOROOT:-/root/tamago-go}
name=arbace-box-mac-arm64
b=$dir/$name
. "$root/bin/lib/version.bash"
v=$(arbace_version "$root")
. "$root/bin/lib/fresh.bash"
head=$(git -C "$root" rev-parse HEAD)
harch=$(case $(uname -m) in aarch64) echo arm64 ;; *) echo amd64 ;; esac)
elf=$dir/box-arm64/arbace.elf
gcmd="ARBACE_BOX_ARCHES=arm64 bin/arbace-go --build --box"

# the guest: HEAD's, else built again (from the last --build's program: HEAD's native executable)
if ! (ARBACE_BOX_STALE_OK= arbace_fresh box-mac-bundle "$elf" "$head" "$gcmd" \
      && ARBACE_BOX_STALE_OK= arbace_guest_key_fresh box-mac-bundle "$elf" "$gcmd") 2>/dev/null; then
  if [ "${ARBACE_BOX_STALE_OK:-}" = 1 ] && [ -s "$elf" ]; then
    arbace_fresh box-mac-bundle "$elf" "$head" "$gcmd"; arbace_guest_key_fresh box-mac-bundle "$elf" "$gcmd"
  else
    arbace_fresh box-mac-bundle "$dir/$harch/arbace" "$head" "bin/arbace-go --build, then bin/box-mac-bundle again"
    echo "== the arm64 guest, missing or stale ($gcmd)" >&2
    (cd "$root" && ARBACE_BOX_ARCHES=arm64 bin/arbace-go --build --box) >&2
    arbace_fresh box-mac-bundle "$elf" "$head" "$gcmd"
    arbace_guest_key_fresh box-mac-bundle "$elf" "$gcmd"
  fi
fi
# the store tool (the rebuild's store, the tool guests' refs)
l=$dir/box-$harch/arbace-box
arbace_fresh box-mac-bundle "$l" "$head" "ARBACE_BOX_ARCHES=$harch bin/arbace-go --build --box"
# the expected image: bin/box-rebuild's host step, on HEAD's executables
rd=${MAC_REBUILD_DIR:-$root/.tmp/box-rebuild/arm64}
if [ "$(cat "$rd/host.verified" 2>/dev/null)" != "$head" ]; then
  arbace_stale box-mac-bundle "$rd/host" \
    "its expected image not made by bin/box-rebuild's host step on HEAD's executables ($rd/host.verified: $(cat "$rd/host.verified" 2>/dev/null || echo none))" \
    "bin/box-rebuild --arch arm64${MAC_REBUILD_DIR:+ --dir $rd} prepare host"
fi
rm -rf "$b" "$dir/$name.tar.gz"
mkdir -p "$b"
echo "== the launcher for darwin/arm64 (bin/build-go --goos darwin)" >&2
(cd "$root" && bin/build-go --module arbace --main arbace/box/cmd/arbace-box --goos darwin --arch arm64 --work "$dir/work-box-launcher-darwin" \
   -o "$b/arbace-box" "$root/box") > "$dir/build-box-mac.log" 2>&1 \
  || { tail -20 "$dir/build-box-mac.log" >&2; exit 1; }
echo "== hv's tests for darwin/arm64" >&2
(cd "$root" && bin/build-go --print-only --tests --module arbace --layout lines --work "$dir/work-box-mac-tests" box) \
  >> "$dir/build-box-mac.log" 2>&1
(cd "$dir/work-box-mac-tests/mod" && env GOOS=darwin GOARCH=arm64 GOARM64=v8.0 CGO_ENABLED=0 GOROOT="$tg" \
   GOTOOLCHAIN=local GOFLAGS= GOWORK=off GOPROXY=off "$tg/bin/go" test -c -o "$b/hv.test" arbace/box/hv) \
  >> "$dir/build-box-mac.log" 2>&1 || { tail -20 "$dir/build-box-mac.log" >&2; exit 1; }
cp "$dir/box-arm64/arbace.elf" "$b/arbace-box.elf"
echo "== the rebuild's store (S8) and the expected image" >&2
hs=$rd/host
want=$(ARBACE_BOX_STORE_MAX=off "$l" --store "$hs" ref rebuilt.host.arm64 2>/dev/null) \
  || { echo "box-mac-bundle: no rebuilt.host.arm64 in $hs (bin/box-rebuild --arch arm64 prepare host)" >&2; exit 1; }
[ "$(ARBACE_BOX_STORE_MAX=off "$l" --store "$hs" tree ls src | sha256sum)" = \
  "$(git -C "$root" archive --format=tar HEAD VERSION arbace box go jdk overlay tamago/goroot tamago/goos x509roots | ARBACE_BOX_STORE_MAX=off "$l" --store "$b/rebuild/store" tree tar - src > /dev/null && ARBACE_BOX_STORE_MAX=off "$l" --store "$b/rebuild/store" tree ls src | sha256sum)" ] \
  || { echo "box-mac-bundle: $hs's sources are not HEAD's (bin/box-rebuild --arch arm64 prepare host)" >&2; exit 1; }
ARBACE_BOX_LAUNCHER=$l "$root/bin/box-tools" put "$b/rebuild/store" arm64 > /dev/null
echo "$want" > "$b/rebuild/expected.txt"
echo "== goi's check: the programs' inputs and gc's consoles (bin/goi check --box --bundle)" >&2
(cd "$root" && bin/goi check --box --arch arm64 --bundle "$b/goi") > "$dir/bundle-goi.log" 2>&1 \
  || { tail -20 "$dir/bundle-goi.log" >&2; exit 1; }
cp "$root/box/mac/mac.sh" "$root/box/mac/arbace-box.entitlements" "$root/box/mac/README.txt" "$b/"
chmod +x "$b/mac.sh" "$b/arbace-box" "$b/hv.test"
{
  echo "arbace $v"
  echo "built $(date -u +%Y-%m-%dT%H:%M:%SZ) on $(uname -m) Linux"
  (cd "$b" && sha256sum arbace-box arbace-box.elf hv.test mac.sh rebuild/expected.txt goi/programs.tsv goi/known.tsv)
} > "$b/VERSION"
tar -C "$dir" --owner=0 --group=0 -czf "$dir/$name.tar.gz" "$name"
echo "box-mac-bundle: $dir/$name.tar.gz ($(stat -c %s "$dir/$name.tar.gz") bytes): the launcher $(stat -c %s "$b/arbace-box"), the guest $(stat -c %s "$b/arbace-box.elf"), hv.test $(stat -c %s "$b/hv.test"), goi's $(wc -l < "$b/goi/programs.tsv") programs" >&2

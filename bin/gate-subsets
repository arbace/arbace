#!/bin/bash
# GD2 (doc/GATE-DIET-SURVEY.md, GDS5 (a), GDS6 (a), "As built: GD2"): the nightly rotation's subsets (GT8.4's NAME.PART.sub)
# made by one stated rule from the committed records: per part the controls' subjects, the tests a class names, the ids that
# ever failed in the rotation (test/gate/failed-ever.tsv) and one per class held by :match alone, then each area filled to a
# fifth in ascending SHA-256 of the id. The logic and the rule's full statement: test/gate/subsets.ae (gate.subsets), on the
# tools' host; it runs nothing and keys nothing (seconds).
#
# Usage: bin/gate-subsets [java|c|go|cpp|all] [--check]   the subsets written into test/java/corpora.edn, test/c/corpora.edn,
#                                                         test/repr/go/native-check-subsets.edn, test/cpp/subsets.edn (default
#                                                         all), a table of the parts; --check: exit 1 when a file differs
#        bin/gate-subsets snapshot [STORE]                test/gate/failed-ever.tsv extended with STORE/_rotation's "fail"
#                                                         events (default the gate's store, ARBACE_GATE_STORE)
# Environment: ARBACE_HOST_EXE, the tools' host (bin/lib/host.bash; default stage 0).
set -uo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash"
. "$root/bin/lib/tools.bash"
cd "$root" || exit 1
set_=all check=
case "${1:-}" in
  snapshot)
    main=$(git -C "$root" worktree list --porcelain | sed -n '1s/^worktree //p')
    arbace_tool -p "$root/test" -m gate.subsets "$root" snapshot "${2:-${ARBACE_GATE_STORE:-$main/.tmp/gate-pass}}"
    exit $? ;;
esac
for a in "$@"; do
  case $a in
    java|c|go|cpp|all) set_=$a ;;
    --check) check=--check ;;
    *) echo "usage: bin/gate-subsets [java|c|go|cpp|all] [--check] | bin/gate-subsets snapshot [STORE]" >&2; exit 2 ;;
  esac
done
arbace_tool -p "$root/test" -m gate.subsets "$root" "$set_" $check

#!/bin/sh
# Build the vendored javac (arbace/javac, packages arbace.javac.*) with the system javac.
# Output: target/javac (gitignored): class files, the message bundles (.properties),
# version.properties and the service registrations. Usage: bin/build-javac
set -e
root=$(cd "$(dirname "$0")/.." && pwd)
out="$root/target/javac"
rm -rf "$out"
mkdir -p "$out"
# The internal JDK packages that javac uses (as declared by jdk.compiler's module-info).
exports="--add-exports java.base/jdk.internal.javac=ALL-UNNAMED
  --add-exports java.base/jdk.internal.misc=ALL-UNNAMED
  --add-exports java.base/jdk.internal.module=ALL-UNNAMED
  --add-exports java.base/jdk.internal.jmod=ALL-UNNAMED
  --add-exports java.base/sun.reflect.annotation=ALL-UNNAMED
  --add-exports jdk.internal.opt/jdk.internal.opt=ALL-UNNAMED"
cd "$root"
find arbace/javac -name '*.java' > "$out/sources.txt"
javac -g -nowarn -XDsuppressNotes -encoding UTF-8 $exports -d "$out" @"$out/sources.txt"
rm "$out/sources.txt"
# Message bundles stay .properties resources (the JDK build compiles them to
# ListResourceBundle classes with the same content).
find arbace/javac -name '*.properties' | while read -r f; do
  mkdir -p "$out/$(dirname "$f")"
  cp "$f" "$out/$f"
done
# The JDK build writes version.properties from version.properties-template.
printf 'jdk=%s\nfull=%s\nrelease=%s\n' 26.0.2.1 26.0.2.1-arbace 26.0.2.1 \
  > "$out/arbace/javac/resources/version.properties"
# The platform provider service that jdk.compiler's module-info declares (needed for --release).
mkdir -p "$out/META-INF/services"
echo arbace.javac.platform.JDKPlatformProvider > "$out/META-INF/services/arbace.javac.platform.PlatformProvider"
echo "built $out"

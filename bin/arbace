#!/bin/bash
# Run Arbace from target/arbace.jar, made by bin/build-arbace: arbace.lang.Main with the given
# arguments (any arbace.main option: -e, -m, a script, none for the REPL).
# With the JDK AOT cache target/arbace.aot (JEP 483, 514, 515) the classes come from the cache,
# already loaded and linked. The cache holds only when it was made by this JDK build from this
# jar with these JVM options: the launcher uses it only when it is newer than the jar, and the
# JVM checks the rest; if the check fails, the JVM runs without it, silently (its AOT logging is
# off). Without the cache (or with ARBACE_AOT=off) the launch takes the jar alone.
#
# Usage: bin/arbace [ARG...]
#        bin/arbace --aot-train < WORKLOAD   make the cache: a training run of the jar
#                                            (-XX:AOTCacheOutput), the REPL reading WORKLOAD
# Inside a runtime image (bin/arbace-image) it runs the image's java and lib/arbace/arbace.jar.
# Environment:
#   ARBACE_JAR        the jar (default target/arbace.jar, or the image's lib/arbace/arbace.jar);
#                     its cache is the same path with .aot
#   ARBACE_CLASSPATH  appended to the class path (the cache allows appending)
#   ARBACE_JAVA_OPTS  further JVM options (a cache made without them may then not apply)
#   ARBACE_AOT        off: do not use the cache
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
# In a runtime image made by bin/arbace-image this script is the image's bin/arbace: it runs the
# image's own java with the image's lib/arbace/arbace.jar (and its cache, trained by that java)
if [ -x "$root/bin/java" ] && [ -f "$root/lib/arbace/arbace.jar" ]; then
  java=$root/bin/java
  jar=${ARBACE_JAR:-$root/lib/arbace/arbace.jar}
else
  java=java
  jar=${ARBACE_JAR:-$root/target/arbace.jar}
fi
cache=${jar%.jar}.aot
if [ ! -f "$jar" ]; then
  echo "bin/arbace: no $jar; build it with bin/build-arbace," \
       "or run a stage with java -cp target/stageN:. arbace.lang.Main" >&2
  exit 1
fi
cp=$jar${ARBACE_CLASSPATH:+:$ARBACE_CLASSPATH}
# The options the cache is made and used with
opts=(-XX:+UseCompactObjectHeaders)
# shellcheck disable=SC2206
opts+=(${ARBACE_JAVA_OPTS:-})
if [ "${1:-}" = "--aot-train" ]; then
  shift
  rm -f "$cache"
  # options bin/arbace-image found the image's training to need (lib/arbace/aot-train-options)
  if [ -f "$root/lib/arbace/aot-train-options" ]; then
    # shellcheck disable=SC2207
    opts+=($(cat "$root/lib/arbace/aot-train-options"))
  fi
  exec "$java" "${opts[@]}" -XX:AOTCacheOutput="$cache" -cp "$jar" arbace.lang.Main "$@"
fi
if [ "${ARBACE_AOT:-}" != off ] && [ "$cache" -nt "$jar" ]; then
  opts+=(-XX:AOTCache="$cache" '-Xlog:aot*=off' '-Xlog:cds*=off')
fi
exec "$java" "${opts[@]}" -cp "$cp" arbace.lang.Main "$@"

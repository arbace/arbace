#!/bin/bash
# The box guest's own Go as Go forms (B1b stage S6, doc/go/BOX-NOTES.md; tamago/README.md):
# the standard library of TamaGo's Go distribution (GOROOT/src: the runtime and every package of
# `go list std` for tamago/amd64 and tamago/arm64) and TamaGo's goos module (github.com/usbarmory/tamago v1.27.1,
# the runtime/goos a guest names as GOOSPKG), converted by g2a into tamago/, which is their
# source from then on; printed back to Go for the box's build (bin/arbace-go --build --box).
#
#   bin/tamago-vendor convert  convert them into OUT (default tamago/), for tamago/amd64 and
#                              tamago/arm64, and merge the two (BX63, doc/go/BOX-NOTES.md "S4"):
#                              std with `bin/g2a convert --corpus ARCH` (dumped afresh), the
#                              packages that have Go files for tamago/ARCH (371 for amd64, 370
#                              for arm64: the packages of test files only left out, and the 2
#                              that embed third-party data and only cmd/ or tests import:
#                              internal/trace/traceviewer, encoding/json/internal/jsontest), each
#                              package's other files (.s, .h) and embedded files copied from
#                              GOROOT/src into its forms directory (SPEC §9.5, §9.6); the goos
#                              module (from Go's module cache, its hash checked) with `bin/g2a
#                              convert --goos tamago --goarch ARCH ./...` in a copy of it, the
#                              packages that dump without errors (69 for amd64, 62 for arm64: the
#                              others are other ISAs' boards and SoCs), their other files
#                              likewise; then one tree, OUT/goroot/go and OUT/goos/go: a file
#                              both convert alike once, a file one architecture only builds
#                              beside them (its build constraints select it), the package files
#                              merged (their files' union, no :config, no :init-order), and the
#                              few files whose forms differ by the configuration's facts only
#                              (constants' values, a selector's path: the printer prints neither)
#                              in OUT/goroot/arch/ARCH/go; GOROOT/src's go.mod, go.sum,
#                              vendor/modules.txt and the headers included from outside the
#                              packages into OUT/goroot/src, the module's go.mod into OUT/goos
#   bin/tamago-vendor verify   convert into WORK/fresh and compare it with OUT (diff -r): the tree
#                              is what the conversion gives, byte for byte
#   bin/tamago-vendor print [DIR]
#                              print OUT into DIR (default WORK/print): DIR/goroot, a GOROOT whose
#                              src holds std printed (lines layout: the forms' lines are Go's; the
#                              shared tree with arch/amd64's files, which print the Go arm64's do)
#                              and GOROOT/src's files, the rest of the toolchain's tree linked
#                              (bin, pkg, lib ...: the compiler, the linker, pkg/include); DIR/goos,
#                              the goos module printed; DIR/overlay.json, jrt's runtime overlay
#                              (bin/jrt overlay) for that GOROOT; DIR/key, the hash of OUT printed
#                              (a print whose key is OUT's is reused). One printing serves both
#                              architectures
#   bin/tamago-vendor check [ARCH]
#                              the proofs, for amd64 and arm64 (or ARCH), after bin/arbace-go
#                              --build --box for them (ARBACE_BOX_ARCHES=amd64,arm64; its guest's
#                              module, target/arbace-go/work-box-ARCH/mod):
#                              0. arch/arm64's files printed in place of arch/amd64's: the same Go
#                              1. std printed against GOROOT/src, package by package (bin/g2a-check:
#                                 gocmp's tree, export and code levels) against the round trip's
#                                 reference test/g2a/roundtrip-ARCH.edn (but the 2 packages left
#                                 out, which fail here)
#                              2. the goos module's packages that build for tamago/ARCH printed
#                                 against the originals (gocmp)
#                              3. the guest image built from the originals (GOROOT /root/tamago-go,
#                                 the goos module from Go's module cache) and from the printed
#                                 forms (GOROOT DIR/goroot, the goos module DIR/goos by a replace),
#                                 both with an empty build ID (-ldflags=-buildid=: the build ID
#                                 hashes the source text, and the printer keeps no comments):
#                                 byte-identical, as linked and with the symbol table cut as
#                                 bin/arbace-go ships it (tools/elfsyms)
#   bin/tamago-vendor all      convert, then check
#
# Options (before the command): --work DIR (default .tmp/tamago-vendor), --out DIR (default
# tamago/). Environment: G2A_GOROOT / TAMAGO_ROOT (default /root/tamago-go: TamaGo's go1.27.1,
# the source of std and the toolchain). g2a runs on Arbace's Go executable (bin/g2a,
# bin/lib/g2a-host.bash: the tools' host).
set -euo pipefail
export CGO_ENABLED=0 # Go's builds never use cgo (doc/go/BOX-NOTES.md, "... cgo dropped", 2026-10-16)
root=$(cd "$(dirname "$0")/.." && pwd)
work=$root/.tmp/tamago-vendor out=$root/tamago
while [ $# -gt 0 ]; do
  case $1 in
    --work) work=$2; shift 2 ;;
    --out) out=$2; shift 2 ;;
    *) break ;;
  esac
done
cmd=${1:-}
[ $# -gt 0 ] && shift
case $work in /*) ;; *) work=$root/$work ;; esac
case $out in /*) ;; *) out=$root/$out ;; esac
tg=${TAMAGO_ROOT:-${G2A_GOROOT:-/root/tamago-go}}
# the architectures held (BX63): the merge takes both
arches="amd64 arm64"
export G2A_GOROOT=$tg GOPROXY=off GOFLAGS= GOTOOLCHAIN=local

# The origin, pinned: TamaGo's go1.27.1 tree (https://github.com/usbarmory/tamago-go, VERSION
# "go1.27.1", 2026-08-28), the hash of every file of its src/ but src/cmd/ (sha256sum of the
# sorted list, then of that), and the goos module's go.sum hashes (arbace.g2a.build/tamago-goos)
src_hash=415d2301a19dfc6890100c6dc5e04496856c29cb77db3ab822168a916a6f5202
goos_mod=github.com/usbarmory/tamago goos_ver=v1.27.1
goos_zip=h1:Zl4w3hu5DaogGvcLzunS4gjwNEqdjFFJedMO3pDQa5k=

fail() { echo "tamago-vendor: $*" >&2; exit 1; }

src_digest() {
  (cd "$tg/src" && find . -type f ! -path './cmd/*' | LC_ALL=C sort | xargs -d '\n' sha256sum | sha256sum | cut -c1-64)
}

goos_dir() {
  local c
  c=$(env -u GOOS -u GOARCH GOROOT="$tg" "$tg/bin/go" env GOMODCACHE)
  [ "$(cat "$c/cache/download/$goos_mod/@v/$goos_ver.ziphash" 2>/dev/null)" = "$goos_zip" ] \
    || fail "$goos_mod@$goos_ver is not in Go's module cache with the pinned hash $goos_zip"
  echo "$c/$goos_mod@$goos_ver"
}

# go_sum: go.sum's two lines for the goos module, from Go's module cache (as bin/g2a build
# --goos tamago writes them)
go_sum() {
  local c
  c=$(env -u GOOS -u GOARCH GOROOT="$tg" "$tg/bin/go" env GOMODCACHE)/cache/download/$goos_mod/@v
  printf '%s %s %s\n%s %s/go.mod %s\n' "$goos_mod" "$goos_ver" "$(cat "$c/$goos_ver.ziphash")" "$goos_mod" "$goos_ver" \
    "$(python3 -I -c 'import sys,hashlib,base64; d=open(sys.argv[1],"rb").read(); print("h1:"+base64.b64encode(hashlib.sha256(("%s  go.mod\n" % hashlib.sha256(d).hexdigest()).encode()).digest()).decode())' "$c/$goos_ver.mod")"
}

# assemble FORMS ORIG DST [OK-LIST]: the converter's tree FORMS/go into DST/go, without the
# package files whose :files is empty (std's 6 packages of test files only) or whose path is not
# in OK-LIST (a file of import paths: the goos module's packages that dumped without errors),
# and without the files they load; each kept package's :other-files and :embed-files copied
# from ORIG/<its directory> (ORIG GOROOT/src, or the module's root with PREFIX stripped) into
# its forms directory, embedded files checked against their hashes
assemble() {
  python3 -I - "$@" <<'EOF'
import hashlib, os, re, shutil, sys
forms, orig, dst = sys.argv[1], sys.argv[2], sys.argv[3]
ok = set(open(sys.argv[4]).read().split()) if len(sys.argv) > 4 else None
prefix = sys.argv[5] + "/" if len(sys.argv) > 5 else ""
src = os.path.join(forms, "go")
shutil.rmtree(os.path.join(dst, "go"), ignore_errors=True)
shutil.copytree(src, os.path.join(dst, "go"))
kept = dropped = others = embeds = 0
for d, _, fs in sorted(os.walk(os.path.join(dst, "go"))):
    for f in sorted(fs):
        p = os.path.join(d, f)
        if not f.endswith(".ae") or not os.path.exists(p):
            continue
        s = open(p, encoding="utf-8").read()
        if "\n(go/package " not in s:
            continue
        path = re.search(r'\n  :path "([^"]+)"', s).group(1)
        files = re.search(r'\n  :files \[([^\]]*)\]', s).group(1)
        if not files.strip() or (ok is not None and path not in ok):
            os.remove(p)
            for l in re.findall(r'\n\(load "([^"]+)"\)', s):
                os.remove(os.path.join(d, l + ".ae"))
            dropped += 1
            continue
        kept += 1
        fdir = p[:-3]
        pdir = os.path.join(orig, path[len(prefix):] if prefix and path.startswith(prefix) else path)
        m = re.search(r'\n  :other-files \[([^\]]*)\]', s)
        for o in re.findall(r'"([^"]+)"', m.group(1)) if m else []:
            os.makedirs(fdir, exist_ok=True)
            shutil.copyfile(os.path.join(pdir, o), os.path.join(fdir, o))
            others += 1
        m = re.search(r'\n  :embed-files \[(.*?)\]\n', s)
        for e, h in re.findall(r'\["([^"]+)" "([0-9a-f]+)"\]', m.group(1)) if m else []:
            t = os.path.join(fdir, e)
            os.makedirs(os.path.dirname(t), exist_ok=True)
            shutil.copyfile(os.path.join(pdir, e), t)
            if hashlib.sha256(open(t, "rb").read()).hexdigest() != h:
                sys.exit("embedded file %s of %s: not the hash the forms record" % (e, path))
            embeds += 1
# directories left empty by the dropped packages
for d, ds, fs in sorted(os.walk(os.path.join(dst, "go")), reverse=True):
    if not os.listdir(d):
        os.rmdir(d)
print("%s: %d packages (%d left out), %d other files, %d embedded files"
      % (os.path.relpath(dst), kept, dropped, others, embeds), file=sys.stderr)
EOF
}

# headers DST: the headers that the kept packages' assembly includes from outside their own
# files (runtime's asm_amd64.s includes "cgo/abi_amd64.h", runtime/cgo's, a package without Go
# files when cgo is off), copied from GOROOT/src to DST/src at their paths; followed through the
# headers they include
headers() {
  python3 -I - "$tg/src" "$1" <<'EOF'
import os, re, shutil, sys
src, dst = sys.argv[1], sys.argv[2]
fdirs = {}
for d, _, fs in os.walk(os.path.join(dst, "go")):
    for f in fs:
        if f.endswith(".ae"):
            s = open(os.path.join(d, f), encoding="utf-8").read()
            m = re.search(r'\n  :path "([^"]+)"', s) if "\n(go/package " in s else None
            if m:
                fdirs[m.group(1)] = os.path.join(d, f[:-3])
todo = []
for path, fdir in fdirs.items():
    if os.path.isdir(fdir):
        for f in os.listdir(fdir):
            if f.endswith((".s", ".h")):
                todo.append((os.path.join(fdir, f), path))
copied = set()
while todo:
    f, path = todo.pop()
    for inc in re.findall(r'^#include "([^"]+)"', open(f, encoding="utf-8", errors="replace").read(), re.M):
        rel = os.path.normpath(os.path.join(path, inc))
        if rel in copied or not os.path.isfile(os.path.join(src, rel)):
            continue
        # the package's own file (in its forms directory) needs nothing
        if path in fdirs and os.path.isfile(os.path.join(fdirs[path], inc)):
            continue
        t = os.path.join(dst, "src", rel)
        os.makedirs(os.path.dirname(t), exist_ok=True)
        shutil.copyfile(os.path.join(src, rel), t)
        copied.add(rel)
        todo.append((t, os.path.dirname(rel)))
print("%s/src: %d headers included from outside the packages: %s"
      % (os.path.relpath(dst), len(copied), " ".join(sorted(copied))), file=sys.stderr)
EOF
}

# merge_trees AMD64 ARM64 DST: the two architectures' trees of forms (each assembled: AMD64/go,
# ARM64/go) into one, DST/go (BX63): a file whose forms both convert alike once; a file one
# architecture only builds as it is (its build constraints select it); the package files merged:
# :files, :other-files and the loads the union of both, sorted, without :config and :init-order
# (which differ by configuration; the printer and gc derive them); the few files both build whose
# forms differ by the configuration's facts only (constants' values, a selector's path through
# embedded fields), which the printer does not print, each architecture's as converted, in
# DST/arch/ARCH/go at the same path. Other files (assembly, headers, embedded) once.
merge_trees() {
  python3 -I - "$@" <<'EOF'
import os, re, shutil, sys
a, b, dst = sys.argv[1], sys.argv[2], sys.argv[3]
for d in ("go", "arch"):
    shutil.rmtree(os.path.join(dst, d), ignore_errors=True)
def files(root):
    out = {}
    base = os.path.join(root, "go")
    for d, _, fs in os.walk(base):
        for f in fs:
            p = os.path.join(d, f)
            out[os.path.relpath(p, base)] = p
    return out
fa, fb = files(a), files(b)
def read(p):
    return open(p, encoding="utf-8").read()
def lst(s, key):
    m = re.search(r'\n  :%s \[([^\]]*)\]' % key, s)
    return re.findall(r'"([^"]+)"', m.group(1)) if m else []
def put(rel, text, sub="go"):
    t = os.path.join(dst, sub, rel)
    os.makedirs(os.path.dirname(t), exist_ok=True)
    open(t, "w", encoding="utf-8").write(text)
def merge_pkg(rel, sa, sb):
    texts = [x for x in (sa, sb) if x is not None]
    fs = sorted(set(sum((lst(x, "files") for x in texts), [])))
    os_ = sorted(set(sum((lst(x, "other-files") for x in texts), [])))
    loads = set(sum((re.findall(r'\n\(load "([^"]+)"\)', x) for x in texts), []))
    loads = sorted(loads, key=lambda l: l.rsplit("/", 1)[-1] + ".go")
    heads = []
    for x in texts:
        h = x[:x.index("\n(go/package ")]
        m = re.search(r'\n\(go/package [^\n]*\n  :path "[^"]+"', x)
        rest = x[m.end():x.index("\n\n(load ") if "\n\n(load " in x else len(x)]
        keys = [l for l in rest.split("\n") if l.startswith("  :") and not re.match(r'  :(config|init-order|files|other-files) ', l)]
        heads.append((h + m.group(0), keys))
    if len(heads) == 2 and heads[0] != heads[1]:
        sys.exit("merge: %s: the package files differ beyond their files and configuration" % rel)
    h, keys = heads[0]
    out = h + "\n  :files [%s]" % " ".join('"%s"' % f for f in fs)
    if os_:
        out += "\n  :other-files [%s]" % " ".join('"%s"' % f for f in os_)
    for k in keys:
        out += "\n" + k
    if not keys or not keys[-1].endswith(")"):
        sys.exit("merge: %s: unexpected package file" % rel)
    out += "\n\n" + "".join('(load "%s")\n' % l for l in loads)
    put(rel, out)
shared = per = pkgs = 0
for rel in sorted(set(fa) | set(fb)):
    pa, pb = fa.get(rel), fb.get(rel)
    if rel.endswith(".ae"):
        sa = read(pa) if pa else None
        sb = read(pb) if pb else None
        if "\n(go/package " in (sa or sb):
            merge_pkg(rel, sa, sb); pkgs += 1
        elif sa is not None and sb is not None and sa != sb:
            put(rel, sa, "arch/amd64/go"); put(rel, sb, "arch/arm64/go"); per += 1
        else:
            put(rel, sa if sa is not None else sb); shared += 1
    else:
        if pa and pb and open(pa, "rb").read() != open(pb, "rb").read():
            sys.exit("merge: %s differs by architecture" % rel)
        t = os.path.join(dst, "go", rel)
        os.makedirs(os.path.dirname(t), exist_ok=True)
        shutil.copyfile(pa or pb, t)
print("%s: %d package files merged, %d files once, %d per architecture (arch/ARCH/go)"
      % (os.path.relpath(dst), pkgs, shared, per), file=sys.stderr)
EOF
}

# convert_arch ARCH W: std and the goos module for tamago/ARCH, each assembled (assemble,
# headers) into W/goroot and W/goos
convert_arch() {
  local a=$1 w=$2 gd n
  gd=$(goos_dir)
  echo "== std for tamago/$a (bin/g2a convert --corpus $a)" >&2
  # dumped afresh: bin/g2a reuses a corpus's dumps when they exist
  rm -rf "$root/.tmp/godump/corpus/$a" "$root/.tmp/godump/corpus/$a.tsv"
  "$root/bin/g2a" convert --corpus "$a" --out "$work/forms-std-$a" > "$work/convert-std-$a.log" 2>&1 \
    || { tail -20 "$work/convert-std-$a.log" >&2; fail "std $a: the conversion failed ($work/convert-std-$a.log)"; }
  grep -q '; 0 failed, 0 did not read back$' "$work/convert-std-$a.log" \
    || { tail -3 "$work/convert-std-$a.log" >&2; fail "std $a: packages failed to convert ($work/convert-std-$a.log)"; }
  grep -v -P '^ok\t' "$root/.tmp/godump/corpus/$a.tsv" >&2 && fail "std $a: packages failed to dump"
  rm -rf "$w"; mkdir -p "$w/goroot"
  # left out: the two std packages that embed third-party data, internal to std and imported
  # only by cmd/trace (internal/trace/traceviewer: Catapult's trace viewer, 2.7 MB) and by
  # encoding/json's tests (encoding/json/internal/jsontest: JSON corpora, 0.3 MB); no program
  # outside GOROOT can import them
  awk -F'\t' '$1 == "ok" { print $2 }' "$root/.tmp/godump/corpus/$a.tsv" \
    | grep -v -x -e internal/trace/traceviewer -e encoding/json/internal/jsontest > "$work/std-ok-$a.txt"
  assemble "$work/forms-std-$a" "$tg/src" "$w/goroot" "$work/std-ok-$a.txt"
  headers "$w/goroot"
  echo "== the goos module $goos_mod@$goos_ver for tamago/$a (bin/g2a convert ./...)" >&2
  rm -rf "$work/goosmod"
  cp -r "$gd" "$work/goosmod"
  chmod -R u+w "$work/goosmod"
  (cd "$work/goosmod" && "$root/bin/g2a" convert --goos tamago --goarch "$a" --out "$work/forms-goos-$a" ./...) \
    > "$work/convert-goos-$a.log" 2>&1 || true
  awk -F'\t' '$1 == "ok" { print $2 }' "$root/.tmp/g2a/dumps.tsv" > "$work/goos-ok-$a.txt"
  n=$(wc -l < "$work/goos-ok-$a.txt")
  echo "   $n of $(wc -l < "$root/.tmp/g2a/dumps.tsv") packages dump without errors for tamago/$a" >&2
  grep -q "^$goos_mod/goos\$" "$work/goos-ok-$a.txt" || fail "goos $a: $goos_mod/goos did not convert ($work/convert-goos-$a.log)"
  # every package that dumped converted
  if grep '^FAIL' "$work/convert-goos-$a.log" | awk '{ print $2 }' | grep -qxF -f "$work/goos-ok-$a.txt"; then
    fail "goos $a: a package that dumped failed to convert ($work/convert-goos-$a.log)"
  fi
  mkdir -p "$w/goos"
  assemble "$work/forms-goos-$a" "$work/goosmod" "$w/goos" "$work/goos-ok-$a.txt" "$goos_mod"
}

convert() {
  local o=$1 a
  [ "$(src_digest)" = "$src_hash" ] || fail "$tg/src is not the pinned tree (digest $(src_digest), pinned $src_hash)"
  mkdir -p "$work" "$o"
  for a in $arches; do convert_arch "$a" "$work/arch-$a"; done
  echo "== merged: the files both architectures convert alike once (BX63)" >&2
  rm -rf "$o/goroot" "$o/goos"; mkdir -p "$o/goroot/src/vendor" "$o/goos"
  merge_trees "$work/arch-amd64/goroot" "$work/arch-arm64/goroot" "$o/goroot"
  merge_trees "$work/arch-amd64/goos" "$work/arch-arm64/goos" "$o/goos"
  # GOROOT/src's files of no package: the module files, and the headers both architectures'
  # assembly includes from outside the packages
  cp "$tg/src/go.mod" "$tg/src/go.sum" "$o/goroot/src/"
  cp "$tg/src/vendor/modules.txt" "$o/goroot/src/vendor/"
  for a in $arches; do [ ! -d "$work/arch-$a/goroot/src" ] || cp -r "$work/arch-$a/goroot/src/." "$o/goroot/src/"; done
  cp "$(goos_dir)/go.mod" "$o/goos/go.mod"
  echo "converted into ${o#$root/}: $(find "$o" -name '*.ae' | wc -l) forms files, $(find "$o" -type f | wc -l) files, $(du -sb "$o" | cut -f1) bytes" >&2
}

# tree_key: the hash of OUT (every file, by path and content) and of the printer that prints it
# (arbace/g2a, bin/g2a: a printer change prints another tree from the same forms)
tree_key() {
  { (cd "$out" && find goroot goos -type f | LC_ALL=C sort | xargs -d '\n' sha256sum)
    (cd "$root" && find arbace/g2a bin/g2a -type f | LC_ALL=C sort | xargs -d '\n' sha256sum)
    cat "$tg/VERSION"; } | sha256sum | cut -c1-64
}

# overlay_json DIR: jrt's runtime overlay (bin/jrt overlay: proc.go, runtime2.go and
# arbace_local.go printed from overlay/go) for the GOROOT DIR/goroot, DIR/overlay.json
overlay_json() {
  local ovl
  ovl=$(cd "$root" && bin/jrt overlay | tail -1)
  sed "s#\"$tg/src/runtime/#\"$1/goroot/src/runtime/#" "$ovl" > "$1/overlay.json"
}

# forms_root TREE ARCH DST: a root of forms to print, DST/go: TREE/go with TREE/arch/ARCH/go laid
# over it (hard links)
forms_root() {
  rm -rf "$3"; mkdir -p "$3"
  cp -al "$1/go" "$3/go"
  [ ! -d "$1/arch/$2/go" ] || cp -al "$1/arch/$2/go/." "$3/go/"
}

# print_tree DIR: OUT printed into DIR (goroot, goos, overlay.json), unless DIR/key is OUT's
print_tree() {
  local d=$1 key e
  key=$(tree_key)
  if [ -f "$d/key" ] && [ "$(cat "$d/key")" = "$key" ]; then
    echo "== tamago/ printed (unchanged, key ${key:0:12}): ${d#$root/}" >&2
    overlay_json "$d"
    return 0
  fi
  echo "== print tamago/ into ${d#$root/}" >&2
  rm -rf "$d"; mkdir -p "$d/goroot"
  # the toolchain's tree but src, linked; src printed
  for e in "$tg"/* "$tg"/.[!.]*; do
    [ -e "$e" ] || continue
    [ "$(basename "$e")" = src ] || ln -s "$e" "$d/goroot/"
  done
  # the forms printed: the shared tree with amd64's files of arch/ (BX63; arm64's print the same
  # Go, which check proves)
  forms_root "$out/goroot" amd64 "$d/forms-goroot"
  forms_root "$out/goos" amd64 "$d/forms-goos"
  "$root/bin/g2a" build --print-only --module std --layout lines --work "$d/std" "$d/forms-goroot" >&2
  mv "$d/std/mod" "$d/goroot/src"; rmdir "$d/std"
  cp -r "$out/goroot/src/." "$d/goroot/src/"
  "$root/bin/g2a" build --print-only --module "$goos_mod" --layout lines --work "$d/g" "$d/forms-goos" >&2
  mv "$d/g/mod" "$d/goos"; rmdir "$d/g"
  rm -rf "$d/forms-goroot" "$d/forms-goos"
  cp "$out/goos/go.mod" "$d/goos/go.mod"
  overlay_json "$d"
  echo "$key" > "$d/key"
  echo "   $(find "$d/goroot/src" "$d/goos" -name '*.go' | wc -l) Go files, $(du -sbL "$d/goroot/src" "$d/goos" | awk '{ s += $1 } END { print s }') bytes" >&2
}

# check_arch ARCH D: the proofs for tamago/ARCH, on the printing D (print_tree)
check_arch() {
  local a=$1 d=$2 mod=$root/target/arbace-go/work-box-$1/mod status=0 gocmp=$work/gocmp p f v ae
  [ -f "$mod/go.mod" ] || fail "no $mod: ARBACE_BOX_ARCHES=$a bin/arbace-go --build --box first"
  [ "$a" = amd64 ] && ae=GOAMD64=v1 || ae=GOARM64=v8.0
  echo "== $a 1. std printed against GOROOT/src (bin/g2a-check, reference test/g2a/roundtrip-$a.edn)" >&2
  # the reference without the two packages convert leaves out (they fail here: not printed)
  grep -v -e '"internal/trace/traceviewer"' -e '"encoding/json/internal/jsontest"' \
    "$root/test/g2a/roundtrip-$a.edn" > "$work/roundtrip-$a.edn"
  G2A_GOOS=tamago G2A_GOARCH=$a "$root/bin/g2a-check" --no-tests -j "${TAMAGO_VENDOR_JOBS:-16}" \
    --reference "$work/roundtrip-$a.edn" "$d/goroot" > "$work/check-std-$a.log" 2>&1 || status=1
  tail -4 "$work/check-std-$a.log"
  echo "== $a 2. the goos module's packages printed against the originals (gocmp: tree, export, code)" >&2
  (cd "$root/tools/gocmp" && env -u GOOS -u GOARCH GOROOT="$tg" "$tg/bin/go" build -o "$gocmp" .)
  [ -d "$work/goosmod" ] || { rm -rf "$work/goosmod"; cp -r "$(goos_dir)" "$work/goosmod"; chmod -R u+w "$work/goosmod"; }
  # the module's packages that build for tamago/ARCH (compiled: the others are other machines')
  (cd "$work/goosmod" && env GOOS=tamago GOARCH=$a $ae GOROOT="$tg" GOTOOLCHAIN=local GOFLAGS= CGO_ENABLED=0 \
     "$tg/bin/go" list -e -export -f '{{if not .Error}}{{if not .DepsErrors}}{{if .GoFiles}}{{.ImportPath}}{{end}}{{end}}{{end}}' ./...) \
    2> /dev/null | sed "s#^$goos_mod/\?##; s#^\$#.#" > "$work/goos-build-$a.txt"
  local np=0 nf=0
  for p in $(cat "$work/goos-build-$a.txt"); do
    f=$work/gocmp-goos-$a-${p//\//_}.log
    [ -d "$d/goos/$p" ] || { nf=$((nf + 1)); status=1; echo "FAIL $goos_mod/$p: not printed"; continue; }
    if (cd "$work/goosmod" && env GOOS=tamago GOARCH=$a $ae GOROOT="$tg" CGO_ENABLED=0 \
          "$gocmp" "$work/goosmod/$p" "$d/goos/$p") > "$f" 2>&1; then
      np=$((np + 1))
    else
      nf=$((nf + 1)); status=1
      echo "FAIL $goos_mod/$p  $(tail -1 "$f")"
    fi
  done
  echo "goos module, $a: $np of $((np + nf)) packages pass at all three levels"
  echo "== $a 3. the guest image from the originals and from the printed forms (build ID empty)" >&2
  . "$root/bin/lib/version.bash"
  v=$(arbace_version "$root")
  local pr=$work/proof-$a
  mkdir -p "$pr"
  # the guest's module (bin/arbace-go --build --box) with two go.mod files (-modfile): TamaGo's
  # goos module from Go's module cache (as bin/g2a build --goos tamago writes it), or printed
  grep -v -e '^replace ' -e '^// from its Go forms' "$mod/go.mod" > "$pr/orig.mod"
  go_sum > "$pr/orig.sum"
  { cat "$pr/orig.mod"; printf '\nreplace %s %s => %s\n' "$goos_mod" "$goos_ver" "$d/goos"; } > "$pr/printed.mod"
  : > "$pr/printed.sum"
  local ovl
  ovl=$(cd "$root" && bin/jrt overlay | tail -1)
  build_guest() { # GOROOT MODFILE OVERLAY OUT
    (cd "$mod" && env GOROOT="$1" GOTOOLCHAIN=local GOFLAGS= GOWORK=off GO111MODULE=on GOPROXY=off GOEXPERIMENT= \
       CGO_ENABLED=0 GOOS=tamago GOARCH=$a $ae GOOSPKG=$goos_mod \
       "$1/bin/go" build -trimpath -buildvcs=false -modfile "$2" \
       "-ldflags=-T 0x201000 -R 0x1000 -w -X 'main.arbaceVersion=$v' -buildid=" -overlay "$3" -o "$4" arbace/cmd/arbace)
  }
  # both with the guests' file system patched, as bin/arbace-go --build --box (BX95)
  . "$root/bin/lib/box-overlay.bash"
  box_overlay "$ovl" "$tg" "$pr/orig-overlay.json" || fail "$a: the file system's overlay"
  box_overlay "$d/overlay.json" "$d/goroot" "$pr/printed-overlay.json" || fail "$a: the file system's overlay"
  build_guest "$tg" "$pr/orig.mod" "$pr/orig-overlay.json" "$pr/arbace-orig.elf" || fail "$a: the guest from the originals failed to build"
  build_guest "$d/goroot" "$pr/printed.mod" "$pr/printed-overlay.json" "$pr/arbace-printed.elf" \
    || fail "$a: the guest from the printed forms failed to build"
  # and as bin/arbace-go ships it: the symbol table cut to the monitor's symbols (tools/elfsyms)
  (cd "$root/tools/elfsyms" && env -u GOOS -u GOARCH GOROOT="$tg" GOTOOLCHAIN=local GOFLAGS= GOWORK=off \
     GOPROXY=off CGO_ENABLED=0 "$tg/bin/go" build -o "$work/elfsyms" .)
  for f in orig printed; do
    "$work/elfsyms" "$pr/arbace-$f.elf" "$pr/arbace-$f-cut.elf" \
      whim_vectors whim_apentry runtime/goos.RamStart > /dev/null
  done
  for f in orig printed orig-cut printed-cut; do
    printf '%-6s %-26s %10d bytes  sha256 %s\n' "$a" "arbace-$f.elf" "$(stat -c %s "$pr/arbace-$f.elf")" \
      "$(sha256sum < "$pr/arbace-$f.elf" | cut -c1-64)"
  done
  for f in "" -cut; do
    if cmp -s "$pr/arbace-orig$f.elf" "$pr/arbace-printed$f.elf"; then
      echo "$a: the guest image${f:+ (symbols cut)}: identical"
    else
      echo "$a: the guest image${f:+ (symbols cut)}: DIFFERENT ($(cmp -l "$pr/arbace-orig$f.elf" "$pr/arbace-printed$f.elf" | wc -l) bytes)"
      status=1
    fi
  done
  return $status
}

# check [ARCH...]: the proofs (default: both architectures), and that the files held per
# architecture (arch/ARCH) print the same Go whichever is printed
check() {
  local d=$work/print status=0 a t
  print_tree "$d"
  echo "== 0. arch/arm64's files printed in place of arch/amd64's: the same Go" >&2
  t=$work/print-arm64
  rm -rf "$t"; mkdir -p "$t"
  forms_root "$out/goroot" arm64 "$t/forms-goroot"
  forms_root "$out/goos" arm64 "$t/forms-goos"
  "$root/bin/g2a" build --print-only --module std --layout lines --work "$t/std" "$t/forms-goroot" > "$t/print.log" 2>&1 \
    && "$root/bin/g2a" build --print-only --module "$goos_mod" --layout lines --work "$t/g" "$t/forms-goos" >> "$t/print.log" 2>&1 \
    || fail "arch/arm64's printing failed ($t/print.log)"
  if diff -r -q "$t/std/mod" "$d/goroot/src" 2>&1 | grep -v '^Only in '"$d"'/goroot/src' | grep . \
     || diff -r -q -x go.mod "$t/g/mod" "$d/goos" | grep .; then
    echo "arch/: the architectures' files print different Go"; status=1
  else
    echo "arch/: arm64's files print the Go amd64's do ($(find "$out/goroot/arch/arm64" "$out/goos/arch/arm64" -name '*.ae' 2>/dev/null | wc -l) files)"
  fi
  rm -rf "$t"
  for a in ${1:-$arches}; do check_arch "$a" "$d" || status=1; done
  return $status
}

case $cmd in
  convert) convert "$out" ;;
  verify)
    convert "$work/fresh"
    # its two roots (tamago/cmd/ is bin/toolchain-vendor's, S9)
    if { diff -r "$out/goroot" "$work/fresh/goroot" && diff -r "$out/goos" "$work/fresh/goos"; } > "$work/verify.diff"; then
      echo "verify: ${out#$root/} is the conversion, byte for byte"
    else
      echo "verify: ${out#$root/} differs from a fresh conversion ($work/verify.diff: $(wc -l < "$work/verify.diff") lines)"; exit 1
    fi ;;
  print) print_tree "${1:-$work/print}" ;;
  check) check "${1:-}" ;;
  all) convert "$out" && check ;;
  *) sed -n '2,/^set -/p' "$0" | sed '$d; s/^# \{0,1\}//' >&2; exit 2 ;;
esac

#!/bin/bash
# A14 (the Ghidra case study's G2 plan; doc/go/J2G-SPEC.md §4.1, "The run-path ranking"): which of j2g's stubs each run
# meets, by cause, and the causes ranked by the runs each would unblock (test/j2g/rank.ae, on the tools' host). Light.
#
# Usage: bin/j2g-rank OUT REPORT RUNS...
#   REPORT  j2g --analyze-only's report.edn, made with J2G_MISSING (its :missing) and its :analysis-failures
#   RUNS    the classes runs loaded: an EDN map of :runs [{:class NAME :loaded [...]}...], or of :loaded {name origin}
#           (one run), or text, a binary name or a JDK -Xlog:class+load line a line (one run)
#   OUT     the ranking, an EDN map (:ranking first: :cause, :sole, :runs, :classes; then :per-run)
# Its unit test: bin/j2g-unit's rank: checks (the fixture test/j2g/unit/rank, with its controls).
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash"
. "$root/bin/lib/tools.bash"
[ $# -ge 3 ] || { sed -n '2,/^set -/p' "$0" | sed '$d; s/^# \{0,1\}//' >&2; exit 2; }
arbace_tool -p "$root/test" -m j2g.rank "$@"

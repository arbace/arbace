#!/bin/bash
# Each crop's completeness, maturity and independence as percentages (doc/CROPS-SCORE.md), from the
# recorded results alone (no runs; seconds), like bin/reap: completeness per REAP cell from the
# tree's test/reap/matrix.edn (bin/reap's judged record), maturity a checklist measured on the tree
# (cells recorded, none unclassed, negative controls, gate steps, a REAP row, records without an
# absolute path), independence per stage from test/crops/independence.edn cross-checked with the
# tree's gate steps' hosts. The logic is the namespace crops.score (test/crops/score.ae), on the
# tools' host; the crops are data, test/crops/crops.edn.
#
# Usage: bin/crops-score [--ref REF | --newest] [--crop C] [--tsv] [--input FILE]... [--judge]
#   --ref REF     score REF's records (read by git show, no checkout); default the checkout
#   --newest      each crop on its newest held branch (crops.edn's :branches, refs/remotes/mac)
#   --crop C      one crop (clojure java go c cpp ocaml scheme haskell rust llvm python)
#   --tsv         one line a crop, tab-separated, every number
#   --input FILE  REAP cell records in test/reap/matrix.edn's format (a vector, or {:cells [...]}) over
#                 the tree's: a crop whose numbers are reported apart (Python's from the Mac VM)
#   --judge       the checkout's matrix judged afresh by reap.main, a difference from
#                 test/reap/matrix.edn a problem
# Environment: ARBACE_HOST_EXE, the tools' host (bin/lib/host.bash; default stage 0).
# Exit status: 0 unless a fact of test/crops/independence.edn is refuted by the tree's gate steps
# (a stage claimed independent whose step runs on a toolchain host) or --judge differs.
set -uo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash"
. "$root/bin/lib/tools.bash"
cd "$root" || exit 1
CROPS_ROOT=$root arbace_tool -p "$root/test" -m crops.score "$@"

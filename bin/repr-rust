#!/bin/bash
# repr/rust, Rust's bridge (doc/rust/SPEC.md, doc/rust/RUST-NOTES.md): Rust files as Rust forms
# (read) and Rust forms as Rust files (print), through the helper tools/rsdump, a rustc_private
# driver on the host's rustc (Alpine's rust 1.99.1, pinned by tools/rsdump/RUSTC_VERSION; SPEC
# §10, RS8, RS9), linked to its librustc_driver dynamically against rustc-dev's metadata (fetched
# as an apk, pinned by tools/rsdump/apks.sha256; nothing installed on the host). The converter and
# the printer are Arbace (arbace.repr.rust, .convert, .print), evaluated from the checkout:
# repr/rust is not one of the tools the executable embeds (arbace/j2g/embed.ae's excluded list).
#
#   bin/repr-rust helper          build the helper into .tmp/repr-rust/rsdump (the host's rustc,
#                                 with a sysroot of links to its std and rustc-dev's crates; rebuilt
#                                 when its source, its pins or rustc --version change)
#   bin/repr-rust corpus fetch [CORPUS]
#                                 the apks rustc-dev and rust-src into .tmp/repr-rust/apks/ (apk fetch
#                                 once when missing, checked by their SHA-256), each extracted into a
#                                 directory of its own (default CORPUS rustc-1.99.1:
#                                 test/rust/corpus-rustc-1.99.1.edn, std's five crates in rust-src)
#   bin/repr-rust corpus list [CORPUS]
#                                 the corpus's files, one per line: crate, file
#   bin/repr-rust dump [--full] --corpus [CORPUS]
#                                 dump the corpus into .tmp/repr-rust/dumps/CORPUS/FILE.edn
#                                 (CORPUS-full/ with --full: rustc_lexer's tokens and comments too)
#   bin/repr-rust dump [--full] [-o DIR] [--edition E] FILE...
#                                 run the helper on files (relative to the current directory; their
#                                 path is the name of every span): DIR/FILE.edn each (default
#                                 .tmp/repr-rust/out), edition 2024 by default
#   bin/repr-rust read [--full] [-o DIR] [--crate NAME --crate-type T --ns-root NS] DUMP.edn...
#                                 convert dumps to Rust forms: one .ae per file under DIR (default
#                                 .tmp/repr-rust/forms/files), each read back and compared; plain
#                                 comments as ; comments; with --full (dumps of dump --full) mode
#                                 :full, every position of the text (SPEC §9.2)
#   bin/repr-rust read [--full] --corpus [CORPUS]
#                                 dump the corpus and convert it into .tmp/repr-rust/forms/CORPUS/
#                                 (CORPUS-full/; SPEC §2.1); report .tmp/repr-rust/forms/CORPUS.report.edn
#   bin/repr-rust print [--layout lines|full] [-o DIR] FORMS.ae...
#                                 the printer (SPEC §9.4): one .rs per forms file into DIR (default
#                                 .tmp/repr-rust/printed), at its rs/file's :path; mode :lines' layout,
#                                 or the full layout of forms of mode :full (the original text)
#   bin/repr-rust roundtrip [--only REGEX | --iface] [--text | --text-only] [CORPUS]
#                                 the round trip's tree level (SPEC §11.1, §11.2; RR1) over the
#                                 corpus: dump, read, print into .tmp/repr-rust/cand/CORPUS/, and
#                                 compare rustc's trees (rsdump tree: the parsed tree's Debug text
#                                 without spans, node and attribute ids, token spacing and collected
#                                 token streams, N1-N4) and the start lines of every span (rsdump
#                                 tree's .lines) of the original and the printed file; fails on a
#                                 difference test/rust/roundtrip-CORPUS-known.edn does not list, and
#                                 on a listed one that no longer occurs. Report
#                                 .tmp/repr-rust/cand/CORPUS.report.edn. With --iface, then the
#                                 interface level (SPEC §11.3; RR2): each crate of the corpus
#                                 documented by rustdoc as JSON (the corpus's :iface: its root,
#                                 externs from the host's sysroot, --cfg flags, environment) from
#                                 the originals and from a mirror of the library with every corpus
#                                 file printed in its place (.tmp/repr-rust/iface/CORPUS/), compared
#                                 without spans; fails on a difference
#                                 test/rust/roundtrip-CORPUS-iface-known.edn does not list. Report
#                                 .tmp/repr-rust/iface/CORPUS.report.edn. With --text, then the text
#                                 level (SPEC §11.1; RR3): the corpus dumped with --full, converted in
#                                 mode :full, printed in the full layout into
#                                 .tmp/repr-rust/cand/CORPUS-full/ and compared byte for byte with the
#                                 originals (test/rust/roundtrip-CORPUS-text-known.edn), then those
#                                 printed files' trees and lines; --text-only: that level alone
#   bin/repr-rust test            the spec's cases (test/rust/; bin/lib/repr-rust/test): the reader's
#                                 samples, the worked example converted and its round trip, the
#                                 interface level's cases, mode :full's cases
#
# Environment: REPR_RUST_APKS (a directory of apks to take the pinned ones from, checked by their
# SHA-256, before apk fetch); REPR_RUST_JOBS (parallel helper and converter runs, default the cores, at most
# 32); ARBACE_HOST_EXE (the Arbace executable, bin/lib/host.bash; default stage 0).
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tools.bash"
work=$root/.tmp/repr-rust
helper=$work/rsdump
apks=$work/apks
sysroot=$work/sysroot
jobs=${REPR_RUST_JOBS:-$(nproc)}
[ "$jobs" -gt 32 ] && jobs=32
pin() { sed -n "s/^$1 //p" "$root/tools/rsdump/RUSTC_VERSION"; }
catf() { if [ -f "$1" ]; then cat "$1"; fi; }

rustc_check() {
  [ -n "$(command -v rustc)" ] || { echo "repr-rust: no rustc (Alpine's rust package, doc/ALPINE.md)" >&2; return 1; }
  local v want
  v=$(rustc --version)
  want="rustc $(pin version) ($(pin commit) "
  case $v in
    "$want"*) ;;
    *) echo "repr-rust: the host's rustc is '$v'; tools/rsdump/RUSTC_VERSION pins $(pin version) ($(pin commit)) (SPEC §10.5: moving the pin is a recorded decision)" >&2
       return 1 ;;
  esac
  host_sysroot=$(rustc --print sysroot)
  target=$(rustc -vV | sed -n 's/^host: //p')
  if [ ! -f "$host_sysroot/lib/librustc_driver-$(pin driver).so" ]; then
    echo "repr-rust: no $host_sysroot/lib/librustc_driver-$(pin driver).so (tools/rsdump/RUSTC_VERSION pins that build)" >&2
    return 1
  fi
}

# apks_fetch: rustc-dev and rust-src of the pinned build into $apks/, checked by their SHA-256,
# each extracted into $apks/NAME/ (an apk is a gzip'd tar; nothing is installed)
apks_fetch() {
  mkdir -p "$apks"
  (
    flock 8
    local sha f name
    while read -r sha f; do
      name=${f%-*-r*.apk}
      if { [ ! -f "$apks/$f" ] || [ "$(sha256sum < "$apks/$f" | cut -c1-64)" != "$sha" ]; } &&
         [ -n "${REPR_RUST_APKS:-}" ] && [ -f "$REPR_RUST_APKS/$f" ] &&
         [ "$(sha256sum < "$REPR_RUST_APKS/$f" | cut -c1-64)" = "$sha" ]; then
        echo "== repr-rust: $f from the cache $REPR_RUST_APKS" >&2
        cp "$REPR_RUST_APKS/$f" "$apks/$f.part.$$" && mv "$apks/$f.part.$$" "$apks/$f"
      fi
      if [ ! -f "$apks/$f" ] || [ "$(sha256sum < "$apks/$f" | cut -c1-64)" != "$sha" ]; then
        # by name (apk fetch cannot select NAME=VERSION alone): the repositories' current build,
        # which must be the pinned one
        echo "== repr-rust: apk fetch $name (pinned: $f)" >&2
        rm -f "$apks/$f"
        apk fetch --no-cache -o "$apks" "$name" >&2 || { echo "repr-rust: apk fetch $name failed" >&2; exit 1; }
        [ -f "$apks/$f" ] || { echo "repr-rust: apk fetch $name gave $(cd "$apks" && ls "$name"-*.apk | tr '\n' ' '), not the pinned $f (SPEC §10.5: moving the pin is a recorded decision; REPR_RUST_APKS names a directory holding the pinned apks)" >&2; exit 1; }
      fi
      if [ "$(sha256sum < "$apks/$f" | cut -c1-64)" != "$sha" ]; then
        echo "repr-rust: $apks/$f: SHA-256 differs from tools/rsdump/apks.sha256's $sha" >&2
        exit 1
      fi
      if [ "$(catf "$apks/$name.extracted")" != "$sha" ]; then
        rm -rf "${apks:?}/$name"; mkdir -p "$apks/$name"
        tar --warning=no-unknown-keyword -xzf "$apks/$f" -C "$apks/$name"
        echo "$sha" > "$apks/$name.extracted"
      fi
    done < "$root/tools/rsdump/apks.sha256"
  ) 8> "$work/fetch.lock"
}

helper_hash() {
  cat "$root/tools/rsdump/rsdump.rs" "$root/tools/rsdump/RUSTC_VERSION" "$root/tools/rsdump/apks.sha256" | sha256sum | cut -c1-64
}

build() {
  rustc_check
  mkdir -p "$work"
  apks_fetch
  local key
  key="$(helper_hash) $(rustc --version)"
  (
    flock 7
    if [ -x "$helper" ] && [ "$(catf "$work/key")" = "$key" ]; then exit 0; fi
    echo "== repr-rust: building the helper (rustc $(pin version), librustc_driver-$(pin driver))" >&2
    local lib=$sysroot/lib/rustlib/$target/lib f
    rm -rf "$sysroot"; mkdir -p "$lib"
    for f in "$host_sysroot/lib/rustlib/$target/lib/"*; do ln -s "$f" "$lib/"; done
    for f in "$apks/rustc-dev/usr/lib/rustlib/$target/lib/"*; do ln -sf "$f" "$lib/"; done
    RUSTC_BOOTSTRAP=1 rustc --edition 2024 -O --sysroot "$sysroot" "$root/tools/rsdump/rsdump.rs" \
      -o "$helper.new.$$" > "$work/build.log" 2>&1 ||
      { cat "$work/build.log" >&2; rm -f "$helper.new.$$"; exit 1; }
    mv -f "$helper.new.$$" "$helper"
    echo "$key" > "$work/key"
  ) 7> "$work/build.lock"
}

corpus_file() {
  local c=${1:-rustc-1.99.1} f
  f=$root/test/rust/corpus-$c.edn
  [ -f "$f" ] || { echo "repr-rust: no corpus $c ($f)" >&2; return 1; }
  echo "$f"
}

# edition_plan CORPUS: as corpus_plan, one line per edition (its name the edition): the helper
# runs over all the files of an edition at once
edition_plan() {
  local f
  f=$(corpus_file "$1")
  arbace_tool -e "(let [c (read-string (slurp \"$f\"))]
    (doseq [[ed ks] (sort-by key (group-by :edition (:crates c))) :let [fs (mapcat :files ks)] :when (seq fs)]
      (println (str ed \"\t\" ed \"\t\" (apply str (interpose \" \" fs))))))"
}

# corpus_plan CORPUS: one line per crate, tab-separated: name, edition, the files (space-separated)
corpus_plan() {
  local f
  f=$(corpus_file "$1")
  arbace_tool -e "(let [c (read-string (slurp \"$f\"))]
    (doseq [k (:crates c)]
      (println (str (:name k) \"\t\" (:edition k) \"\t\" (apply str (interpose \" \" (:files k)))))))"
}

# corpus_root CORPUS: sets srcroot, the directory the corpus's paths are relative to: in the
# rust-src apk (a corpus's :apk :root), or for a crate set (:crates-io) the crates extracted from
# their pinned .crate files (crates_fetch)
corpus_root() {
  local f src kind where pins
  f=$(corpus_file "$1")
  src=$(arbace_tool -e "(let [c (read-string (slurp \"$f\"))]
    (if-let [a (:apk c)] (println \"apk\" (:root a)) (println \"crates\" (:root (:crates-io c)) (:pins (:crates-io c)))))")
  read -r kind where pins <<< "$src"
  corpus_kind=$kind
  if [ "$kind" = crates ]; then
    crates_fetch "$root/$pins"
    srcroot=$work/crates/$where
  else
    srcroot=$apks/rust-src/$where
  fi
  [ -d "$srcroot" ] || { echo "repr-rust: no $srcroot (bin/repr-rust corpus fetch)" >&2; return 1; }
}

# crates_fetch PINS [DEST]: each crate of PINS (lines SHA-256, two spaces, NAME-VERSION.crate;
# RR4's pinned crate set) into $work/crates/cache/, checked by its SHA-256: from REPR_RUST_CRATES,
# a directory of .crate files, else the host's Cargo cache ($CARGO_HOME/registry/cache/*/), when it
# holds the file with the pinned hash, else from crates.io (static.crates.io); then each extracted
# into DEST/NAME-VERSION/ (default $work/crates/src; DEST empty: none; a .crate is a gzip'd tar of
# that directory)
crates_fetch() {
  local pins=$1 cache=$work/crates/cache src=${2-$work/crates/src} sha f n d got
  mkdir -p "$cache"
  (
    flock 8
    while read -r sha f; do
      [ -n "$f" ] || continue
      if [ ! -f "$cache/$f" ] || [ "$(sha256sum < "$cache/$f" | cut -c1-64)" != "$sha" ]; then
        rm -f "$cache/$f"; got=""
        for d in ${REPR_RUST_CRATES:-} "${CARGO_HOME:-$HOME/.cargo}"/registry/cache/*; do
          if [ -f "$d/$f" ] && [ "$(sha256sum < "$d/$f" | cut -c1-64)" = "$sha" ]; then
            cp "$d/$f" "$cache/$f.part.$$" && mv "$cache/$f.part.$$" "$cache/$f"; got=$d; break
          fi
        done
        if [ -z "$got" ]; then
          n=$(echo "${f%.crate}" | awk '{i=match($0,/-[0-9]+\.[0-9]+\.[0-9]+/); print substr($0,1,i-1)}')
          echo "== repr-rust: fetching $f from crates.io" >&2
          curl -fsSL -o "$cache/$f.part.$$" "https://static.crates.io/crates/$n/$f" && mv "$cache/$f.part.$$" "$cache/$f" ||
            { rm -f "$cache/$f.part.$$"; echo "repr-rust: could not fetch $f (REPR_RUST_CRATES names a directory holding the pinned .crate files)" >&2; exit 1; }
        fi
        if [ "$(sha256sum < "$cache/$f" | cut -c1-64)" != "$sha" ]; then
          echo "repr-rust: $cache/$f: SHA-256 differs from the pin $sha ($pins)" >&2; exit 1
        fi
      fi
      d=${f%.crate}
      [ -n "$src" ] || continue
      mkdir -p "$src"
      if [ "$(catf "$src/$d.extracted")" != "$sha" ]; then
        rm -rf "${src:?}/$d"
        tar -xzf "$cache/$f" -C "$src" --no-same-owner || { echo "repr-rust: $f does not extract" >&2; exit 1; }
        [ -d "$src/$d" ] || { echo "repr-rust: $f holds no $d/" >&2; exit 1; }
        echo "$sha" > "$src/$d.extracted"
      fi
    done < "$pins"
  ) 8> "$work/crates.lock"
}

# run_helper VERB OUT EDITION FILE...: the helper over files in parallel (relative to the current
# directory); a file it fails on is written as (rsdump/error ...), which the steps after report
run_helper() {
  local verb=$1 out=$2 ed=$3 flags=(); shift 3
  [ "$verb" = dump ] && [ "${dump_full:-0}" = 1 ] && flags=(--full)
  printf '%s\n' "$@" | xargs -r -P "$jobs" -n 8 "$helper" "$verb" "${flags[@]}" -o "$out" --edition "$ed" --helper-hash "sha256:$(helper_hash)"
}

# dump_corpus CORPUS OUT [--full]: the helper's dumps of the corpus (with --full, its tokens and
# comments too: mode :full, SPEC §9.2)
dump_corpus() {
  local c=$1 out=$2 name ed files dump_full=0
  [ "${3:-}" = --full ] && dump_full=1
  rm -rf "$out" "$out.err"; mkdir -p "$out"
  while IFS=$'\t' read -r name ed files; do
    # shellcheck disable=SC2086
    (cd "$srcroot" && run_helper dump "$out" "$ed" $files) 2>> "$out.err" || true
  done < <(edition_plan "$c")
}

read_files() {
  arbace_tool -m arbace.repr.rust read --pin "$root/tools/rsdump/RUSTC_VERSION" "$@"
}

# the corpora (SPEC §11.4): std's five crates (RR1-RR3), then RR4's
all_corpora="rustc-1.99.1 rustc-1.99.1-library rustc-1.99.1-compiler crates-2026-10-18"

roundtrip() {
  local cs=() only="" iface=0 text=0 text_only=0 pretty=0 pretty_only=0 st=0 c
  while [ $# -gt 0 ]; do
    case $1 in
      --only) only=$2; shift 2 ;;
      --iface) iface=1; shift ;;
      --text) text=1; shift ;;
      --text-only) text=1; text_only=1; shift ;;
      --pretty) pretty=1; shift ;;
      --pretty-only) pretty=1; pretty_only=1; shift ;;
      all) read -ra cs <<< "$all_corpora"; shift ;;
      *) cs+=("$1"); shift ;;
    esac
  done
  [ ${#cs[@]} -gt 0 ] || cs=(rustc-1.99.1)
  if [ "$iface" = 1 ] && [ -n "$only" ]; then echo "repr-rust: --iface documents whole crates: not with --only" >&2; return 2; fi
  build
  for c in "${cs[@]}"; do
    roundtrip_one "$c" || st=1
  done
  return $st
}

roundtrip_one() {
  local c=$1 st=0
  corpus_root "$c"
  if [ "$text_only" = 1 ] || [ "$pretty_only" = 1 ]; then
    if [ "$pretty_only" = 1 ]; then pretty_level "$c" "$only" || st=1; fi
    if [ "$text_only" = 1 ]; then text_level "$c" "$only" || st=1; fi
    return $st
  fi
  local dumps=$work/dumps/$c forms=$work/forms/$c cand=$work/cand/$c orig=$work/orig/$c t0 t1 t2 t3 t4
  t0=$(date +%s)
  echo "== repr-rust roundtrip $c: dump" >&2
  dump_corpus "$c" "$dumps"
  t1=$(date +%s)
  echo "== repr-rust roundtrip $c: convert ($((t1 - t0)) s dumping)" >&2
  rm -rf "$forms"; mkdir -p "$(dirname "$forms")"
  read_files --jobs "$jobs" -o "$forms" --report "$forms.report.edn" --root "$dumps" --corpus "$(corpus_file "$c")" \
    ${only:+--only "$only"} > "$forms.log" 2>&1 ||
    { grep -v '^error\|^misread' "$forms.log" | tail -5 >&2; grep -c '^error\|^misread' "$forms.log" | sed 's/$/ files failed to convert (see the report)/' >&2; }
  t2=$(date +%s)
  echo "== repr-rust roundtrip $c: print ($((t2 - t1)) s converting)" >&2
  rm -rf "$cand" "$cand.trees" "$cand.trees.err"; mkdir -p "$cand"
  # a file the printer fails on is reported by the comparison (not printed)
  arbace_tool -m arbace.repr.rust print --jobs "$jobs" -o "$cand" --root "$forms" > "$cand.print.log" 2>&1 ||
    grep -v '^error' "$cand.print.log" | tail -3 >&2
  t3=$(date +%s)
  echo "== repr-rust roundtrip $c: trees ($((t3 - t2)) s printing)" >&2
  # the trees: of the originals (in the corpus's tree) and of the printed files (in the
  # candidate's, under the same relative paths: the spans name the same files)
  rm -rf "$orig" "$orig.err"; mkdir -p "$orig" "$cand.trees"
  local name ed files f
  while IFS=$'\t' read -r name ed files; do
    # shellcheck disable=SC2086
    (cd "$srcroot" && run_helper tree "$orig" "$ed" $files) 2>> "$orig.err" || true
    # shellcheck disable=SC2086
    (cd "$cand" && run_helper tree "$cand.trees" "$ed" $(for f in $files; do [ -f "$f" ] && echo "$f"; done)) 2>> "$cand.trees.err" || true
  done < <(edition_plan "$c")
  t4=$(date +%s)
  echo "== repr-rust roundtrip $c: compare ($((t4 - t3)) s parsing)" >&2
  arbace_tool -m arbace.repr.rust compare --corpus "$(corpus_file "$c")" --orig "$orig" --cand "$cand" \
    --forms-report "$forms.report.edn" --known "$root/test/rust/roundtrip-$c-known.edn" \
    --report "$cand.report.edn" ${only:+--only "$only"} --prune \
    --times "dump $((t1 - t0)) convert $((t2 - t1)) print $((t3 - t2)) parse $((t4 - t3))" || st=1
  if [ "$iface" = 1 ]; then
    iface_level "$c" || st=1
  fi
  if [ "$pretty" = 1 ]; then
    pretty_level "$c" "$only" || st=1
  fi
  if [ "$text" = 1 ]; then
    text_level "$c" "$only" || st=1
  fi
  return $st
}

# pretty_level CORPUS [ONLY]: the pretty layout (SPEC §9.4, 2; RR4) judged at the tree level: the
# forms of mode :lines (the tree level's, $work/forms/CORPUS/, converted again when missing) without
# their positions printed in the pretty layout into $work/cand/CORPUS-pretty/, and those files'
# trees compared with the originals' (their lines are the layout's own); known differences
# test/rust/roundtrip-CORPUS-pretty-known.edn; report $work/cand/CORPUS-pretty.report.edn
pretty_level() {
  local c=$1 only=${2:-} dumps=$work/dumps/$1 forms=$work/forms/$1 cand=$work/cand/$1-pretty orig=$work/orig/$1-pretty
  local t0 t1 t2 name ed files f
  t0=$(date +%s)
  if [ ! -f "$forms.report.edn" ]; then
    echo "== repr-rust roundtrip $c: pretty layout: dump, convert" >&2
    dump_corpus "$c" "$dumps"
    rm -rf "$forms"; mkdir -p "$(dirname "$forms")"
    read_files --jobs "$jobs" -o "$forms" --report "$forms.report.edn" --root "$dumps" --corpus "$(corpus_file "$c")" \
      ${only:+--only "$only"} > "$forms.log" 2>&1 || true
  fi
  echo "== repr-rust roundtrip $c: pretty layout: print the forms without positions" >&2
  rm -rf "$cand" "$cand.trees" "$cand.trees.err"; mkdir -p "$cand"
  arbace_tool -m arbace.repr.rust print --layout pretty --jobs "$jobs" -o "$cand" --root "$forms" ${only:+--only "$only"} > "$cand.print.log" 2>&1 ||
    grep -v '^error' "$cand.print.log" | tail -3 >&2
  t1=$(date +%s)
  rm -rf "$orig" "$orig.err"; mkdir -p "$orig" "$cand.trees"
  while IFS=$'\t' read -r name ed files; do
    # shellcheck disable=SC2086
    (cd "$srcroot" && run_helper tree "$orig" "$ed" $files) 2>> "$orig.err" || true
    # shellcheck disable=SC2086
    (cd "$cand" && run_helper tree "$cand.trees" "$ed" $(for f in $files; do [ -f "$f" ] && echo "$f"; done)) 2>> "$cand.trees.err" || true
  done < <(edition_plan "$c")
  t2=$(date +%s)
  arbace_tool -m arbace.repr.rust compare --trees-only --corpus "$(corpus_file "$c")" --orig "$orig" --cand "$cand" \
    --forms-report "$forms.report.edn" --known "$root/test/rust/roundtrip-$c-pretty-known.edn" \
    --report "$cand.report.edn" ${only:+--only "$only"} --prune --times "print $((t1 - t0)) parse $((t2 - t1))" |
    sed 's/(tree level)/(tree level, the pretty layout)/'
  return "${PIPESTATUS[0]}"
}

# text_level CORPUS [ONLY]: the round trip's text level (SPEC §11.1, §11.3; RR3): the corpus dumped
# with --full, converted in mode :full into $work/forms/CORPUS-full/, printed in the full layout
# into $work/cand/CORPUS-full/ and compared byte for byte with the originals (arbace.repr.rust
# compare-text, known differences test/rust/roundtrip-CORPUS-text-known.edn), then the tree level
# of those printed files (rustc's trees and lines, as mode :lines'); reports
# $work/cand/CORPUS-full.text.edn and .report.edn
text_level() {
  local c=$1 only=${2:-} dumps=$work/dumps/$1-full forms=$work/forms/$1-full cand=$work/cand/$1-full orig=$work/orig/$1-full
  local t0 t1 t2 t3 t4 st=0 name ed files f
  t0=$(date +%s)
  echo "== repr-rust roundtrip $c: text level: dump --full" >&2
  dump_corpus "$c" "$dumps" --full
  t1=$(date +%s)
  echo "== repr-rust roundtrip $c: text level: convert in mode :full ($((t1 - t0)) s dumping)" >&2
  rm -rf "$forms"; mkdir -p "$(dirname "$forms")"
  read_files --full --jobs "$jobs" -o "$forms" --report "$forms.report.edn" --root "$dumps" --corpus "$(corpus_file "$c")" \
    ${only:+--only "$only"} > "$forms.log" 2>&1 ||
    { grep -v '^error\|^misread' "$forms.log" | tail -5 >&2; grep -c '^error\|^misread' "$forms.log" | sed 's/$/ files failed to convert (see the report)/' >&2; }
  t2=$(date +%s)
  echo "== repr-rust roundtrip $c: text level: print, the full layout ($((t2 - t1)) s converting)" >&2
  rm -rf "$cand" "$cand.trees" "$cand.trees.err"; mkdir -p "$cand"
  arbace_tool -m arbace.repr.rust print --layout full --jobs "$jobs" -o "$cand" --root "$forms" > "$cand.print.log" 2>&1 ||
    grep -v '^error' "$cand.print.log" | tail -3 >&2
  t3=$(date +%s)
  arbace_tool -m arbace.repr.rust compare-text --corpus "$(corpus_file "$c")" --orig "$srcroot" --cand "$cand" \
    --forms-report "$forms.report.edn" --known "$root/test/rust/roundtrip-$c-text-known.edn" \
    --report "$cand.text.edn" ${only:+--only "$only"} \
    --times "dump $((t1 - t0)) convert $((t2 - t1)) print $((t3 - t2))" || st=1
  echo "== repr-rust roundtrip $c: text level: the tree level of mode :full's printed files" >&2
  rm -rf "$orig" "$orig.err"; mkdir -p "$orig" "$cand.trees"
  while IFS=$'\t' read -r name ed files; do
    # shellcheck disable=SC2086
    (cd "$srcroot" && run_helper tree "$orig" "$ed" $files) 2>> "$orig.err" || true
    # shellcheck disable=SC2086
    (cd "$cand" && run_helper tree "$cand.trees" "$ed" $(for f in $files; do [ -f "$f" ] && echo "$f"; done)) 2>> "$cand.trees.err" || true
  done < <(edition_plan "$c")
  t4=$(date +%s)
  arbace_tool -m arbace.repr.rust compare --corpus "$(corpus_file "$c")" --orig "$orig" --cand "$cand" \
    --forms-report "$forms.report.edn" --known "$root/test/rust/roundtrip-$c-known.edn" \
    --report "$cand.report.edn" ${only:+--only "$only"} --prune --times "parse $((t4 - t3))" | sed 's/(tree level)/(tree level, mode :full)/' || st=1
  return $st
}

# iface_plan CORPUS: one line per crate, fields separated by | (they may be empty): name, edition,
# crate type, root, the externs, the --cfg values, the environment (NAME=VALUE), space-separated,
# the library directory of the externs (empty: the host's sysroot; rustc-dev: rustc-dev's)
iface_plan() {
  local f
  f=$(corpus_file "$1")
  arbace_tool -e "(let [c (read-string (slurp \"$f\"))
                        j (fn [xs] (apply str (interpose \" \" xs)))]
    (doseq [k (:crates c) :let [i (:iface k)] :when i]
      (println (str (:name k) \"|\" (:edition k) \"|\" (:crate-type k) \"|\" (:root i) \"|\" (j (:externs i)) \"|\"
                    (j (:cfg i)) \"|\" (j (for [[n v] (:env i)] (str n \"=\" (.replace (str v) \" \" \"\\\\x20\")))) \"|\" (or (:libdir i) \"\")))))"
}

# rustdoc_json DIR OUT NAME EDITION TYPE ROOT EXTERNS CFGS ENV: rustdoc's JSON of one crate (SPEC
# §11.3) documented from DIR into OUT/NAME/NAME.json, its log OUT/NAME/NAME.log; the externs the
# host sysroot's .rmeta of each name (exactly one)
rustdoc_json() {
  local dir=$1 out=$2/$3 name=$3 ed=$4 type=$5 croot=$6 externs=$7 cfgs=$8 envs=$9 libdir=${10:-} args=() n m lib envv=()
  lib=$host_sysroot/lib/rustlib/$target/lib
  if [ "$libdir" = rustc-dev ]; then
    # the compiler's crates: rustc-dev's builds of their dependencies, each named by its file
    lib=$apks/rustc-dev/usr/lib/rustlib/$target/lib
    args+=(-L "dependency=$lib")
  fi
  rm -rf "$out"; mkdir -p "$out"
  for n in $externs; do
    case $n in
      *=*) [ -f "$lib/${n#*=}" ] || { echo "repr-rust: no $lib/${n#*=}" > "$out/$name.log"; return 1; }
           args+=(--extern "${n%%=*}=$lib/${n#*=}") ;;
      *) m=("$lib/lib$n"-*.rmeta)
         [ ${#m[@]} -eq 1 ] && [ -f "${m[0]}" ] || { echo "repr-rust: not one $lib/lib$n-*.rmeta (${m[*]})" > "$out/$name.log"; return 1; }
         args+=(--extern "$n=${m[0]}") ;;
    esac
  done
  for n in $cfgs; do args+=(--cfg "$n"); done
  for n in $envs; do envv+=("$(printf '%b' "$n")"); done
  (cd "$dir" && env RUSTC_BOOTSTRAP=1 "${envv[@]}" rustdoc --edition "$ed" --crate-name "$name" --crate-type "$type" \
     -Zforce-unstable-if-unmarked -Zunstable-options --output-format json -o "$out.part" "${args[@]}" "$croot") > "$out/$name.log" 2>&1 &&
    mv "$out.part/$name.json" "$out/$name.json"
  local st=$?
  rm -rf "$out.part"
  return $st
}

# iface_level CORPUS: the round trip's interface level (SPEC §11.1, §11.3; RR2), after the tree
# level printed the corpus into $work/cand/CORPUS: the library tree mirrored as links into
# $work/iface/CORPUS/src, each corpus file a link to its printed file (none when it was not
# printed), then each crate documented by rustdoc as JSON from the originals (orig/) and from the
# mirror (cand/), all ten runs at once, and compared without spans (arbace.repr.rust
# compare-iface); report $work/iface/CORPUS.report.edn
iface_level() {
  local c=$1 ib=$work/iface/$1 cand=$work/cand/$1 t0 t1 f name ed type croot externs cfgs envs pids=()
  t0=$(date +%s)
  echo "== repr-rust roundtrip $c: interface level (rustdoc's JSON of the originals and of the printed files)" >&2
  rm -rf "$ib" "$ib.report.edn"; mkdir -p "$ib"
  cp -rs "$srcroot/." "$ib/src"
  while read -r _ f; do
    rm -f "$ib/src/$f"
    if [ -f "$cand/$f" ]; then ln -s "$cand/$f" "$ib/src/$f"; fi
  done < <(corpus_plan "$c" | while IFS=$'\t' read -r n _ fs; do for f in $fs; do echo "$n $f"; done; done)
  if [ "$corpus_kind" = crates ]; then
    crates_docs "$c" "$ib" || return 1
  else
    while IFS='|' read -r name ed type croot externs cfgs envs libdir; do
      # at most 32 rustdoc runs at a time
      while [ "$(jobs -rp | wc -l)" -ge 32 ]; do wait -n || true; done
      rustdoc_json "$srcroot" "$ib/orig" "$name" "$ed" "$type" "$croot" "$externs" "$cfgs" "$envs" "$libdir" & pids+=($!)
      rustdoc_json "$ib/src" "$ib/cand" "$name" "$ed" "$type" "$croot" "$externs" "$cfgs" "$envs" "$libdir" & pids+=($!)
    done < <(iface_plan "$c")
    for f in "${pids[@]}"; do wait "$f" || true; done
  fi
  t1=$(date +%s)
  arbace_tool -m arbace.repr.rust compare-iface --corpus "$(corpus_file "$c")" --orig "$ib/orig" --cand "$ib/cand" \
    --known "$root/test/rust/roundtrip-$c-iface-known.edn" --report "$ib.report.edn" --prune \
    --times "rustdoc $((t1 - t0))" || return 1
}

# crates_docs CORPUS IB: the interface level's rustdoc runs for a crate set (RR4; RUST-NOTES.md,
# "RR4"): Cargo documents the corpus's crates of :iface {:cargo NAME@VERSION} in a workspace of
# its own, $work/cargo/ws (one package depending on each without its default features, with the
# corpus's :features), its dependencies locked by test/rust/CORPUS.lock and read from a directory
# source of their .crate files, each checked by the lock's SHA-256 (the corpus's own extractions
# as links; the others fetched as crates_fetch fetches): no registry index, nothing of the host's
# Cargo state. cargo doc -vv prints each crate's rustdoc command (its flags, features, cfgs of
# build scripts, environment, dependencies' metadata), which is then run twice: on the corpus's
# extraction of the crate (IB/orig/C/C.json) and on the mirror with its printed files
# (IB/cand/C/C.json)
crates_docs() {
  local c=$1 ib=$2 cw=$work/cargo lock sha f d name cmd specs=()
  lock=$root/test/rust/$c.lock
  [ -f "$lock" ] || { echo "repr-rust: no $lock" >&2; return 1; }
  mkdir -p "$cw"
  awk '/^name = /{n=$3} /^version = /{v=$3} /^checksum = /{k=$3; gsub(/"/,"",n); gsub(/"/,"",v); gsub(/"/,"",k); print k"  "n"-"v".crate"}' \
    "$lock" > "$cw/lock.sha256"
  crates_fetch "$cw/lock.sha256" ""
  echo "== repr-rust roundtrip $c: interface level: the directory source, cargo doc" >&2
  rm -rf "$cw/vendor" "$cw/extra"; mkdir -p "$cw/vendor" "$cw/extra"
  while read -r sha f; do
    d=${f%.crate}
    if [ "$(catf "$work/crates/src/$d.extracted")" = "$sha" ]; then
      mkdir -p "$cw/vendor/$d" && cp -rs "$work/crates/src/$d/." "$cw/vendor/$d/"
    else
      tar -xzf "$work/crates/cache/$f" -C "$cw/vendor" --no-same-owner
    fi
    printf '{"files":{},"package":"%s"}' "$sha" > "$cw/vendor/$d/.cargo-checksum.json"
  done < "$cw/lock.sha256"
  rm -rf "$cw/ws"; mkdir -p "$cw/ws/src" "$cw/ws/.cargo" "$cw/home"
  {
    printf '[package]\nname = "repr-rust-crates"\nversion = "0.0.0"\nedition = "2021"\npublish = false\n[lib]\npath = "src/lib.rs"\n[dependencies]\n'
    arbace_tool -e "(let [c (read-string (slurp \"$(corpus_file "$c")\"))]
      (doseq [[i k] (map-indexed vector (filter #(:cargo (:iface %)) (:crates c)))
              :let [[p v] (.split ^String (:cargo (:iface k)) \"@\")]]
        (println (str \"c\" (inc i) \" = { package = \\\"\" p \"\\\", version = \\\"=\" v \"\\\", default-features = false\"
                      (when-let [fs (:features (:iface k))] (str \", features = [\" (apply str (interpose \", \" (map pr-str fs))) \"]\"))
                      \" }\"))))"
  } > "$cw/ws/Cargo.toml"
  : > "$cw/ws/src/lib.rs"
  cp "$lock" "$cw/ws/Cargo.lock"
  printf '[source.crates-io]\nreplace-with = "pinned"\n[source.pinned]\ndirectory = "%s"\n' "$cw/vendor" > "$cw/ws/.cargo/config.toml"
  while read -r f; do specs+=(-p "$f"); done < <(sed -n 's/^c[0-9]* = { package = "\([^"]*\)", version = "=\([^"]*\)".*/\1@\2/p' "$cw/ws/Cargo.toml")
  rm -rf "$cw/target/doc"
  (cd "$cw/ws" && CARGO_HOME=$cw/home CARGO_TARGET_DIR=$cw/target RUSTC_BOOTSTRAP=1 \
     RUSTDOCFLAGS="-Zunstable-options --output-format json" \
     cargo doc --offline --locked --no-deps --keep-going -j "$jobs" -vv "${specs[@]}") > "$cw/doc.log" 2>&1 || true
  # each crate's rustdoc command, as cargo -vv prints it (`ENV=... rustdoc ...`, maybe on several lines)
  rm -rf "$cw/cmds"; mkdir -p "$cw/cmds"
  awk -v out="$cw/cmds" '
    { if (!q) { if (index($0, "     Running `") != 1) next; b = substr($0, 15); q = 1 } else b = b "\n" $0 }
    q && substr(b, length(b), 1) == "`" { q = 0; x = substr(b, 1, length(b) - 1)
      if (x ~ / rustdoc --edition/ && match(x, /--crate-name [A-Za-z0-9_]+/)) { f = out "/" substr(x, RSTART + 13, RLENGTH - 13) ".sh"; print x > f; close(f) } }' "$cw/doc.log"
  echo "== repr-rust roundtrip $c: interface level: $(ls "$cw/cmds" | wc -l) crates documented by cargo, again from the originals and the printed files" >&2
  local pids=() k
  while read -r name d; do
    for k in orig cand; do
      while [ "$(jobs -rp | wc -l)" -ge 32 ]; do wait -n || true; done
      mkdir -p "$ib/$k/$name"
      if [ ! -f "$cw/cmds/$name.sh" ]; then
        echo "repr-rust: cargo did not document $name ($cw/doc.log)" > "$ib/$k/$name/$name.log"; continue
      fi
      cmd=$(cat "$cw/cmds/$name.sh")
      if [ $k = orig ]; then cmd=${cmd//"$cw/vendor/$d"/"$srcroot/$d"}; else cmd=${cmd//"$cw/vendor/$d"/"$ib/src/$d"}; fi
      cmd=${cmd//"-o $cw/target/doc"/"-o $ib/$k/$name.part"}
      ( rm -rf "$ib/$k/$name.part"
        if (cd "$cw/ws" && RUSTC_BOOTSTRAP=1 bash -c "$cmd") > "$ib/$k/$name/$name.log" 2>&1 && [ -f "$ib/$k/$name.part/$name.json" ]; then
          mv "$ib/$k/$name.part/$name.json" "$ib/$k/$name/$name.json"
        fi
        rm -rf "$ib/$k/$name.part" ) & pids+=($!)
    done
  done < <(arbace_tool -e "(doseq [k (:crates (read-string (slurp \"$(corpus_file "$c")\"))) :when (:cargo (:iface k))] (println (:name k) (:dir k)))")
  for k in "${pids[@]}"; do wait "$k" || true; done
}

cmd=${1:-}
[ $# -gt 0 ] && shift
case $cmd in
  helper) build ;;
  corpus)
    sub=${1:-list}; [ $# -gt 0 ] && shift
    case $sub in
      fetch) mkdir -p "$work"; apks_fetch; corpus_root "${1:-rustc-1.99.1}"; echo "$srcroot" ;;
      list) corpus_plan "${1:-rustc-1.99.1}" | while IFS=$'\t' read -r n _ fs; do
              for f in $fs; do echo "$n $f"; done
            done ;;
      *) echo "usage: bin/repr-rust corpus fetch|list [CORPUS]" >&2; exit 2 ;;
    esac ;;
  dump)
    build
    full=()
    if [ "${1:-}" = --full ]; then full=(--full); shift; fi
    if [ "${1:-}" = --corpus ]; then
      c=${2:-rustc-1.99.1}; corpus_root "$c"
      if [ ${#full[@]} -gt 0 ]; then dump_corpus "$c" "$work/dumps/$c-full" --full; cat "$work/dumps/$c-full.err" >&2
      else dump_corpus "$c" "$work/dumps/$c"; cat "$work/dumps/$c.err" >&2; fi
      exit 0
    fi
    out=$work/out; ed=2024; files=()
    while [ $# -gt 0 ]; do
      case $1 in
        -o) out=$2; shift 2 ;;
        --edition) ed=$2; shift 2 ;;
        *) files+=("$1"); shift ;;
      esac
    done
    "$helper" dump "${full[@]}" -o "$out" --edition "$ed" --helper-hash "sha256:$(helper_hash)" "${files[@]}" ;;
  read)
    full=(); sfx=""
    if [ "${1:-}" = --full ] && [ "${2:-}" = --corpus ]; then full=(--full); sfx=-full; shift; fi
    if [ "${1:-}" = --corpus ]; then
      shift; c=${1:-rustc-1.99.1}
      build; corpus_root "$c"
      dump_corpus "$c" "$work/dumps/$c$sfx" "${full[@]}"
      out=$work/forms/$c$sfx
      rm -rf "$out"
      read_files "${full[@]}" --jobs "$jobs" -o "$out" --report "$out.report.edn" --root "$work/dumps/$c$sfx" --corpus "$(corpus_file "$c")"
    else
      read_files --jobs "$jobs" "$@"
    fi ;;
  print) arbace_tool -m arbace.repr.rust print --jobs "$jobs" "$@" ;;
  roundtrip) rustc_check; roundtrip "$@" ;;
  test) exec "$root/bin/lib/repr-rust/test" "$@" ;;
  *) sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; exit 2 ;;
esac

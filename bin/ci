#!/bin/bash
# ci, C's eval (doc/C23-SURVEY.md §6, CS17 (a); "As built: C4", "As built: C5 (write-ahead)"): its checker,
# arbace.c.check (types, conversions, constants, layout, linkage, _BitInt, constexpr, typeof, auto, _Generic
# over C forms; evaluated from the checkout on the tools' host, CS36 (a)) and its oracle, cc's checker run by
# tools/ccdump's types mode (cc.Translate); its builder arbace.c.build, its libc musl 1.2.6 as C forms
# (arbace.c.musl) and its back end go/arbace/ci over go/arbace/crt, run on the light path by tools/cirun.
#
#   bin/ci run [--std S] [OPTION...] FILE... [-- ARG...]
#                              FILE... (one program) read, checked, linked with musl, built and run by ci's back
#                              end with ARG...; the program's status is the command's
#   bin/ci nodes [--std S] [OPTION...] -o OUT FILE...
#                              the program's node program (arbace.c.build's output) written to OUT
#   bin/ci check [--corpus C,...] [--only LIST] [--record] [--judge] [--resume]
#                              ci's check (bin/lib/ci/check, its header): every program of the run corpora run
#                              against gcc 15.2's recorded run, every non-pass in a class of test/c/divergences.edn
#   bin/ci check --aot [--corpus C,...] [--only LIST] [--sample N] [--record] [--judge] [--resume]
#                              ci's AOT check (bin/lib/ci/check-aot, its header): every program of the run corpora
#                              translated by cf2g (arbace.c.cf2g) into Go over go/arbace/ci and go/arbace/crt, built
#                              by TamaGo's go in shards and run against gcc 15.2's recorded run and the interpreted
#                              check's, every non-pass in a class of test/c/divergences-aot.edn or divergences.edn
#   bin/ci dg [--corpus C,...] [--only LIST] [--record] [--judge] [--essential]
#                              the C23 corpus's dg check (bin/lib/ci/dg, its header): gcc 15.2's c23 tests by their
#                              DejaGnu directives, the checker's errors judged by line and kind
#   bin/ci aot NODES OUT       a node program (bin/ci nodes') translated by cf2g into OUT/prog.go, a main package
#   bin/ci repl-session        the REPL session of doc/C23-SURVEY.md §6.6 (test/c/repl/letters.ae) run on the tools'
#                              host, its output against test/c/repl/letters.out
#   bin/ci c2j-check           ci's and repr/c's namespaces compiled by c2j alone (the re-seed embeds them; a minute, 2 GB), every source must compile
#   bin/ci cinterp-check [--regen]
#                              go/arbace/cinterp (arbace.lang.CInterp's Go side) built with a stand-in jrt and run on the fixtures of
#                              test/c/cinterp/ beside tools/cirun, against their .expect (C9 preparation, doc/C23-SURVEY.md)
#   bin/ci judge-test          the judges' unit tests (test/c/judge_test.ae: the dg verdict, the run level's result and
#                              record comparison, the checker's rules review 027 found, the scripts' subset refusal
#                              and quiet retry: bin/ci check on ci-run's ptr-sub-unsigned.c), on the tools' host
#   bin/ci divergences         the recorded check (test/c/check-linux-amd64.edn) judged against the classes
#   bin/ci musl prepare        musl 1.2.6's tarball (test/c/corpora.edn's pin) extracted and configured into
#                              .tmp/ci-musl/musl-1.2.6, its generated headers made
#   bin/ci musl read           musl's sources read by repr/c into the forms cache .tmp/ci-musl/forms, indexed
#   bin/ci musl fresh|ensure   exit 0 when the forms cache was read by this checkout's repr/c (forms/key, CS211); ensure: prepare,
#                              then read when it was not (bin/ci check and check --aot do)
#   bin/ci aot-lib build|prune     cf2g's prebuilt libraries (RES34, doc/rust/RUST-EVAL-SURVEY.md, "As built: RES34 (write-ahead)"): build:
#                              every musl unit translated once into its Go package in .tmp/ci-aot-lib/musl_KEY/ (CI_AOT_LIB; a
#                              program's AOT build makes the ones it lacks itself); prune: per library the newest 3 keys kept, an
#                              older one removed when unused for a day. CI_AOT_LIB_OFF=1: each program translated whole, as before
#   bin/ci runtime build|key|dir|prune
#                              ci's prebuilt runtime (doc/C23-SURVEY.md, "As built: ci's prebuilt runtime"): build: every musl
#                              unit checked and built once into its fragment, cached in .tmp/ci-runtime/musl-KEY/ (CI_RUNTIME;
#                              CI_THREADS, default 4; a program's build makes the fragments it lacks itself); key: the runtime's key
#                              (the fragments' format, the target, musl's forms cache's key, ci's checker and builder as loaded); dir: its
#                              directory; prune: the other keys' directories unused for a day removed (build does too). CI_PREBUILT=0 builds each program with its runtime as before; CI_LINK_CHECK=1 builds both ways
#                              and requires the same node program
#   bin/ci cirun-build         ci's back end, go/arbace/crt and go/arbace/ci printed by repr/go, with tools/cirun
#                              built by TamaGo's go into .tmp/ci/cirun (CI_GO_SRC: a Go tree of the packages instead)
#   bin/ci diagnose [--std S] [OPTION...] FILE...
#                              each FILE read by repr/c and checked: the checker's errors (those gcc 15.2 gives)
#   bin/ci annot [--std S] [OPTION...] FILE...
#                              each FILE's annotations, in tools/ccdump's types format (arbace.repr.c.annot), and
#                              its errors
#   bin/ci annotations [--corpus C,...] [--only LIST] [--record]
#                              the checker's check (bin/lib/repr-c/annotations, its header): every file of the
#                              corpora checked, its annotations equal to cc's checker's item by item where cc
#                              translates it, its errors none where gcc accepts it, or the file in
#                              test/repr/c/annot-known.edn with its class
#   bin/ci synth [--check]     synth-c23's programs (test/c/corpora.edn's :synth-c23, GT8.6) written into test/c/synth/ from
#                              its table, test/c/synth/table.edn, by test/c/synth/gen.ae on the tools' host; --check: the
#                              committed files and the corpus' :count against the table's, nothing written
#   bin/ci record-ref [--corpus C,...] [--only]
#                              gcc 15.2's runs of the single-file run corpora recorded as data,
#                              test/c/ref-gcc15.edn (bin/lib/ci/record-ref, its header; CS14 (a))
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash"
. "$root/bin/lib/tools.bash"
cmd=${1:-}
[ $# -gt 0 ] && shift
case $cmd in
  diagnose) arbace_tool -m arbace.repr.c.annot check "$root/test/c/host" "$@" ;;
  annot) arbace_tool -m arbace.repr.c.annot "$cmd" "$root/test/c/host" "$@" ;;
  run) exec "$root/bin/lib/ci/run" "$@" ;;
  nodes) "$root/bin/ci" musl ensure && arbace_tool -m arbace.c.run "$root/test/c/host" nodes "$@" ;;
  check)
    for a in "$@"; do [ "$a" = --aot ] && { args=(); for b in "$@"; do [ "$b" = --aot ] || args+=("$b"); done; exec "$root/bin/lib/ci/check-aot" "${args[@]}"; }; done
    exec "$root/bin/lib/ci/check" "$@" ;;
  dg) exec "$root/bin/lib/ci/dg" "$@" ;;
  c2j-check) exec "$root/bin/lib/ci/c2j-check" "$@" ;;
  cinterp-check) exec "$root/bin/lib/ci/cinterp-check" "$@" ;;
  judge-test)
    cd "$root" && arbace_tool -p "$root/test" -e "(require 'c.judge-test) (let [r (arbace.test/run-tests 'c.judge-test)] (shutdown-agents) (System/exit (if (zero? (+ (:fail r) (:error r))) 0 1)))" 2>&1 \
      | { grep -v '^Reflection warning\|recur arg\|^Auto-boxing' || true; } | head -c 200000
    exit "${PIPESTATUS[0]}" ;;
  divergences) arbace_tool -m arbace.c.run "$root/test/c/host" divergences test/c/check-linux-amd64.edn test/c/divergences.edn ;;
  aot) arbace_tool -m arbace.c.cf2g translate "$(cd "$(dirname "$1")" && pwd)/$(basename "$1")" "$2" ;;
  musl) exec "$root/bin/lib/ci/musl" "$@" ;;
  repl-session)
    "$root/bin/ci" musl ensure
    { [ -n "${CIRUN:-}" ] && [ -x "$CIRUN" ]; } || "$root/bin/ci" cirun-build --ensure
    out=$TMPDIR/ci-repl-session.out
    (cd "$root" && arbace_tool "$root/test/c/repl/letters.ae") 2>&1 | { grep -v '^Reflection warning\|recur arg\|^Auto-boxing' || true; } > "$out"
    if diff "$root/test/c/repl/letters.out" "$out"; then echo "ci: the REPL session passes"; else echo "ci: the REPL session differs" >&2; exit 1; fi ;;
  aot-lib)
    # RES34 (doc/rust/RUST-EVAL-SURVEY.md, "As built: RES34 (write-ahead)"): cf2g's prebuilt libraries, .tmp/ci-aot-lib/LIB_KEY/
    case ${1:-} in
      # RES40 (a): the cache shared by the worktrees, the main checkout's (CI_AOT_LIB overrides), as bin/lib/ci/check-aot takes it
      build) export CI_AOT_LIB=${CI_AOT_LIB:-${root%%/.tmp/worktrees/*}/.tmp/ci-aot-lib}
        "$root/bin/ci" musl ensure && arbace_tool -m arbace.c.aotlib translate-musl "${CI_THREADS:-2}" ;;
      prune)
        # per library (the name before its key) the newest 3 directories kept, an older one removed when unused for a day
        c=${CI_AOT_LIB:-${root%%/.tmp/worktrees/*}/.tmp/ci-aot-lib}; [ -d "$c" ] || exit 0   # RES40 (a): the main checkout's
        for n in $(ls "$c" | sed 's/_[0-9a-f]\{16\}$//' | sort -u); do
          ls -dt "$c/${n}"_???????????????? 2>"$TMPDIR/ci-aot-lib.err" | tail -n +4 | while read -r d; do
            [ -n "$(find "$d" -maxdepth 0 -mmin +1440)" ] && { echo "ci aot-lib: removed $d"; rm -rf "${d:?}"; }
          done
        done ;;
      *) echo "usage: bin/ci aot-lib build|prune" >&2; exit 2 ;;
    esac ;;
  runtime)
    "$root/bin/ci" musl ensure
    case ${1:-} in
      build) arbace_tool -p "$root" -e "(require 'arbace.c.runtime 'arbace.repr.c.host)" \
               -e "(let [lib (arbace.c.runtime/library (arbace.repr.c.host/load-host \"$root/test/c/host\") \"$root\") r (arbace.c.runtime/prebuild lib ${CI_THREADS:-4})] (println \"ci runtime:\" (:units r) \"units,\" (:made r) \"fragments made,\" (:items-refused r) \"items refused (an error only when linked), in\" (:dir r)) (shutdown-agents))" ;;
      key|dir) arbace_tool -p "$root" -e "(require 'arbace.c.runtime 'arbace.repr.c.host)" \
               -e "(let [lib (arbace.c.runtime/library (arbace.repr.c.host/load-host \"$root/test/c/host\") \"$root\")] (println (if (= \"$1\" \"key\") (:runtime-key lib) (:frag-dir lib))))" ;;
      prune) ;;
      *) echo "usage: bin/ci runtime build|key|dir|prune" >&2; exit 2 ;;
    esac
    # CS272 (a): build and prune remove the other keys' directories unused for a day (review 187: a younger one may be another
    # process's, a stage 0's ci or a worktree's; each build marks its key's directory used); bin/gate --prune trims the cache
    # too: per library the newest 3, an older one when a day old
    case ${1:-} in
      build|prune)
        cur=$("$root/bin/ci" runtime dir 2>"$TMPDIR/ci-runtime-dir.err" | tail -1)
        case $cur in */musl-*) ;; *) echo "bin/ci runtime: no current directory ($TMPDIR/ci-runtime-dir.err)" >&2; exit 1 ;; esac
        for d in "$(dirname "$cur")"/musl-*; do
          [ -d "$d" ] && [ "$d" != "$cur" ] || continue
          [ -n "$(find "$d" -maxdepth 0 -mmin +1440)" ] || continue
          echo "ci runtime: removed $d (another key, unused for a day)"; rm -rf "${d:?}"
        done ;;
    esac ;;
  cirun-build) exec "$root/bin/lib/ci/cirun-build" "$@" ;;
  annotations) exec "$root/bin/lib/repr-c/annotations" "$@" ;;
  synth)
    v=write; [ "${1:-}" = --check ] && v=check
    cd "$root" && arbace_tool -p "$root/test" -m c.synth.gen "$v" ;;
  record-ref) exec "$root/bin/lib/ci/record-ref" "$@" ;;
  *) sed -n '2,/^set -/p' "$0" | sed '$d; s/^# \{0,1\}//' >&2; exit 2 ;;
esac

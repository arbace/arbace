#!/bin/bash
# repr/java, Java's bridge: Java source as Java forms (read) and Java forms as Java source (print).
# read runs on the frozen JVM Arbace with access to javac's internals: javac is its front end, so it
# runs on a JVM (doc/STANDALONE-NOTES.md, "S4: the JVM removed", O1): the frozen jar
# (bin/lib/frozen.bash), with arbace.repr.java and the Java forms' front end
# (arbace.classes.types, env, parse, lower, analyze) loaded from the checkout's sources
# (frozen_view tools). print needs no javac and runs on the tools' host (bin/lib/tools.bash's
# arbace_tool, as repr/go's printer). See doc/classes/CONVERTER-NOTES.md, PRINTER-NOTES.md.
#
#   bin/repr-java read [OPTIONS] OUT ROOT [PATH...]
#                       convert the .java files under ROOT (or the PATHs) into Java forms under
#                       OUT (arbace.repr.java: --rename FROM=TO, --javac OPT, --check)
#   bin/repr-java read-jdk [OPTIONS] OUT MODULE SRC [PATH...]
#                       the same for a module of the JDK itself, attributed with --patch-module
#                       (bin/jrt-convert's java.base)
#   bin/repr-java print [--index DIR]... [--quiet] FORMS... OUT
#                       print Java forms as Java (arbace.repr.java.print, on the tools' host): every
#                       converted file under the FORMS (files or directories) holding Java forms
#                       becomes OUT/<package path>/<Name>.java; --index DIR, more converted files
#                       the printer consults (which classes are generic), e.g. jdk/forms
#   bin/repr-java roundtrip [--corpus C,...] [--no-classes] [--record]
#                       the round trip Java -> forms -> Java -> forms, judged at three levels: forms,
#                       ae (the converted text), classes (bin/lib/repr-java/roundtrip, its header;
#                       corpora baseline, samples, jdk), against test/repr/java/roundtrip/
#   bin/repr-java coverage REPORT.edn...
#                       a Markdown summary of conversion reports (arbace.repr.java.coverage)
#   bin/repr-java check [--suite | --update | --jdk [MODULE...]]
#                       the converter's checks (bin/lib/repr-java/check, its header): the
#                       output compared with the expected forms under test/repr/java/expected
#   bin/repr-java main ARGS...
#                       arbace.lang.Main's arguments, on the same JVM (e.g. -m NS ...)
#
# Environment: REPR_JAVA_JVM_OPTS, heap options (default -Xmx24g); REPR_JAVA_CP, more class path
# (javac's class path for the classes the sources name is read's --javac -cp); REPR_JAVA_THREADS,
# read-jdk's parallel chunks (default 12); REPR_JAVA_PATCH_ALL, REPR_JAVA_DEBUG (arbace.repr.java).
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/renamed-env.bash" # stops on a stale G2A_*, J2A_* or A2G_*
cmd=${1:-}
[ $# -gt 0 ] && shift
case $cmd in
  read|read-jdk) set -- -m arbace.repr.java "$cmd" "$@" ;;
  coverage) set -- -m arbace.repr.java.coverage "$@" ;;
  check) exec "$root/bin/lib/repr-java/check" "$@" ;;
  roundtrip) exec "$root/bin/lib/repr-java/roundtrip" "$@" ;;
  print) . "$root/bin/lib/tools.bash"
         arbace_tool -m arbace.repr.java.print "$@"; exit $? ;;
  main) ;;
  *) sed -n '2,/^set -/p' "$0" | sed '$d; s/^# \{0,1\}//' >&2; exit 2 ;;
esac
. "$root/bin/lib/frozen.bash"
exports=()
for p in api tree util parser code file main comp jvm; do
  exports+=(--add-exports "jdk.compiler/com.sun.tools.javac.$p=ALL-UNNAMED" --add-opens "jdk.compiler/com.sun.tools.javac.$p=ALL-UNNAMED")
done
# shellcheck disable=SC2086
FROZEN_CP=${REPR_JAVA_CP:-} frozen_java tools -Xss64m ${REPR_JAVA_JVM_OPTS:--Xmx24g} "${exports[@]}" -- "$@"

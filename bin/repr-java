#!/bin/bash
# repr/java, Java's bridge: Java source as Java forms (read) and Java forms as Java source (print).
# read needs javac's attribution, so it runs where javac does: on javac's tool executable, javac's
# forms and the reader compiled into Arbace (javac on Arbace; doc/classes/JAVA-FRONTEND-SURVEY.md,
# "As built: JN4", "As built: JN5"), the only host since JN6 (until then also the frozen JVM Arbace,
# REPR_JAVA_HOST=jvm, the reference: "As built: JN6"; nothing of repr/java starts a JVM). print needs
# no javac and runs on the tools' host (bin/lib/tools.bash's arbace_tool, as repr/go's printer). See
# doc/classes/CONVERTER-NOTES.md, PRINTER-NOTES.md.
#
#   bin/repr-java read [OPTIONS] OUT ROOT [PATH...]
#                       convert the .java files under ROOT (or the PATHs) into Java forms under
#                       OUT (arbace.repr.java: --rename FROM=TO, --javac OPT, --check; --full, mode
#                       :full: the forms also record the Java text, for print to give it back byte
#                       for byte, arbace.repr.java.full)
#   bin/repr-java read-jdk [OPTIONS] OUT MODULE SRC [PATH...]
#                       the same for a module of the JDK itself, attributed with --patch-module
#                       against the platform, which holds every module of the JDK image (bin/jrt-convert's
#                       java.base, bin/javac-vendor's javac, bin/repr-java check --jdk)
#   bin/repr-java print [--index DIR]... [--layout full|lines] [--anew] [--quiet] FORMS... OUT
#                       print Java forms as Java (arbace.repr.java.print, on the tools' host): every
#                       converted file under the FORMS (files or directories) holding Java forms
#                       becomes OUT/<package path>/<Name>.java; --index DIR, more converted files
#                       the printer consults (which classes are generic), e.g. jdk/forms; forms of
#                       mode :full print in the full layout (the default), the declarations that are
#                       the ones recorded as their Java text, the others anew (--anew: every member);
#                       --layout lines prints every file anew
#   bin/repr-java roundtrip [--corpus C,...] [--no-classes] [--text | --text-only] [--record]
#                       the round trip Java -> forms -> Java -> forms, judged at three levels: forms,
#                       ae (the converted text), classes (bin/lib/repr-java/roundtrip, its header;
#                       corpora baseline, samples, jdk), against test/repr/java/roundtrip/; --text,
#                       then the text level: mode :full printed back byte for byte
#   bin/repr-java declarations OUT
#                       the declarations of Arbace's runtime (doc/classes/JAVA-FRONTEND-SURVEY.md,
#                       JFS6, JFS27): the checkout's arbace/lang and arbace/java/api printed by print
#                       --layout declarations (no code: bodies throw null) into OUT/java, compiled by
#                       javac on Arbace (-g:none) into OUT/classes, whose path it prints: javac's
#                       class path for Java that names the runtime (the suite's fixtures,
#                       arbace.lang.IFn)
#   bin/repr-java parse [--javac] FILE...
#   bin/repr-java parse [--javac] --time PATH...
#                       each Java file's tree, as arbace.repr.java.parse's native parser gives it
#                       (Java 26's parser in Arbace, on the tools' host, evaluated from the checkout),
#                       one node per line (parse/dump); --javac: javac on Arbace's tree of it, the
#                       same data (arbace.repr.java.jtree, on javac's tool executable); --time: the
#                       parse time of the .java files under the PATHs, on one thread (with --javac,
#                       javac's and the native parser's, compiled, on the tool)
#   bin/repr-java parse-check [--corpus C,...]
#                       the native parser's tree level (bin/lib/repr-java/parse-check, its header;
#                       doc/classes/JAVA-FRONTEND-SURVEY.md, "As built: JN8"): every file of the
#                       corpora samples, baseline, jdk, javac, jdk26u, mutants and tests parsed by
#                       javac on Arbace and natively, the trees equal, positions included, against
#                       test/repr/java/parse-check-known.edn
#   bin/repr-java platform-pack [OUT]
#                       the java.base pack (arbace.repr.java.platform, doc/classes/JAVA-FRONTEND-SURVEY.md,
#                       JN10 part 2, JFS131 (b), JFS135 (a)): java.base's class files of the platform
#                       jdk/javac/platform.sha256 pins (REPR_JAVA_PLATFORM, else bin/javac-vendor platform's
#                       .tmp/repr-java-platform) stripped to what arbace.repr.java.classfile's parse reads,
#                       one deterministic file, jdk/platform/java.base.decls (and its provenance,
#                       jdk/platform/provenance.edn), on the tools' host; no javac's tool
#   bin/repr-java platform-check [PACK]
#                       the pack's proof: for every java.base class (parse (strip b)) = (parse b), the
#                       pack equal to a fresh one byte for byte and, read as a platform, the directory's
#                       modules, packages, names and classes; its hash and strip's sources the provenance's
#   bin/repr-java closure-check [--known FILE] [--update]
#                       the guard of JN10 (doc/classes/JAVA-FRONTEND-SURVEY.md, "JN10: the plan"), on the
#                       tools' host, no javac: repr/java's read closure (arbace.repr.java and what it
#                       requires, less javac's half) counted per file for the javac classes it names,
#                       against test/repr/java/closure-known.edn (a ratchet: no file over its count, a
#                       file not in it clean), and the clean namespaces required in one process;
#                       --update rewrites the known file (FILE relative to the checkout's root)
#   bin/repr-java front-check [--corpus C,...]
#                       the converter on the native parser's trees (bin/lib/repr-java/front-check, its
#                       header; doc/classes/JAVA-FRONTEND-SURVEY.md, "As built: JFS66 (b)"): the
#                       corpora samples, baseline, jdk and javac (all: and jdk26u's 68 modules) read
#                       with read --front both --split, the forms of the native trees (javac's
#                       attribution answered by position, arbace.repr.java.attr) equal to those of
#                       javac's trees, byte for byte, and the split summed (arbace.repr.java.split)
#   bin/repr-java attr-check [--corpus C,...]
#                       the native attribution provider (doc/classes/JAVA-FRONTEND-SURVEY.md, "As built:
#                       JN9a"): front-check --attr native, the native trees' scope and declarations
#                       tiers answered by arbace.repr.java.nattr without javac (the platform's class
#                       files read by arbace.repr.java.classfile), each fact compared with javac on
#                       Arbace's, the forms still equal to javac's trees', against
#                       test/repr/java/attr-check-known.edn
#   bin/repr-java nojavac-check [--corpus C,...]
#                       the read without javac (doc/classes/JAVA-FRONTEND-SURVEY.md, "As built: JN9e"):
#                       front-check --no-javac, every corpus read by javac's trees and by read
#                       --no-javac (the native parser's trees and the native provider's answers alone, a
#                       file that meets what only javac answers converted again with javac, counted),
#                       the forms equal file for file, the fallbacks, time and peak memory summed
#                       (WORK/nojavac.md), against test/repr/java/nojavac-check-known.edn
#   bin/repr-java coverage REPORT.edn...
#                       a Markdown summary of conversion reports (arbace.repr.java.coverage)
#   bin/repr-java check [--suite | --update | --jdk [--update] [MODULE...]]
#                       the converter's checks (bin/lib/repr-java/check, its header): the
#                       output compared with the expected forms under test/repr/java/expected
#   bin/repr-java main ARGS...
#                       arbace.lang.Main's arguments, on javac's tool executable (e.g. -m NS ...)
#   bin/repr-java javac ARGS...
#                       javac's command line on javac's tool executable, javac on Arbace
#                       (jdk.internal.jrt.javac.Main) against the platform; the round trip's
#                       classes level and bin/jrt-convert's javac step compile with it
#   bin/repr-java platform-dir
#                       the platform's directory (made as javac's command line makes it), printed: what
#                       javax.tools' system compiler on the tool attributes against when the property
#                       jdk.internal.jrt.javac.platform names it (bin/java-check's tool tests, F6)
#
# Environment: REPR_JAVA_EXE, javac's tool executable (default target/arbace-go/<arch>/arbace-javac,
# bin/javac-vendor build, which records the key of its sources beside it, EXE.key,
# bin/lib/javac-key.bash; the provenance files name it, bin/lib/repr-java/host.bash), with
# arbace.repr.java compiled into it (a namespace whose source in the checkout differs from its
# embedded copy loaded from the checkout, ARBACE_PATH) and javac on Arbace attributing against the
# platform of jdk/javac/platform.sha256 (bin/javac-vendor platform, made once into
# .tmp/repr-java-platform); REPR_JAVA_CP, javac's class path for the classes the sources name when
# read's --javac -cp gives none; REPR_JAVA_THREADS, read-jdk's parallel chunks (default 12);
# REPR_JAVA_PATCH_ALL, REPR_JAVA_DEBUG (arbace.repr.java); REPR_JAVA_PACK=1, the native provider's
# java.base from the pack jdk/platform/java.base.decls and the other modules from REPR_JAVA_PLATFORM's
# directory (arbace.repr.java.platform's default-platform; JN10 part 2). REPR_JAVA_HOST: unset or arbace; jvm, the
# frozen JVM's read, left with JN6 (JFS36, JFS38).
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash" # TMPDIR: .tmp/tmp when unset
. "$root/bin/lib/renamed-env.bash" # stops on a stale G2A_*, J2A_*, A2G_* or C2A_*
cmd=${1:-}
[ $# -gt 0 ] && shift
case $cmd in
  read|read-jdk) set -- -m arbace.repr.java "$cmd" "$@" ;;
  coverage) set -- -m arbace.repr.java.coverage "$@" ;;
  check) exec "$root/bin/lib/repr-java/check" "$@" ;;
  closure-check) . "$root/bin/lib/tools.bash"
                 cd "$root" && arbace_tool -p "$root/test" -m repr.java.closure "$@"; exit $? ;;
  parse-check) exec "$root/bin/lib/repr-java/parse-check" "$@" ;;
  front-check) exec "$root/bin/lib/repr-java/front-check" "$@" ;;
  attr-check) exec "$root/bin/lib/repr-java/front-check" --attr native "$@" ;;
  nojavac-check) exec "$root/bin/lib/repr-java/front-check" --no-javac "$@" ;;
  platform-pack|platform-check)
         # JN10 part 2 (JFS131 (b), JFS135 (a)): the java.base pack, on the tools' host, from the platform
         # at jdk/javac/platform.sha256's pin (REPR_JAVA_PLATFORM, else .tmp/repr-java-platform made by
         # bin/javac-vendor platform); no javac's tool
         . "$root/bin/lib/tools.bash"; . "$root/bin/lib/repr-java/host.bash"
         plat=${REPR_JAVA_PLATFORM:-$root/.tmp/repr-java-platform}
         if [ -z "${REPR_JAVA_PLATFORM:-}" ] && ! cmp -s "$root/jdk/javac/platform.sha256" "$plat/.pin"; then
           made=$("$root/bin/javac-vendor" platform "$plat") && [ "$made" = "$plat" ] || { echo "repr-java: no platform (bin/javac-vendor platform)" >&2; exit 1; }
           cp "$root/jdk/javac/platform.sha256" "$plat/.pin"
         fi
         pin=$(grep '  java\.base$' "$root/jdk/javac/platform.sha256" | cut -c1-64)
         have=$( (cd "$plat/java.base" && find -L . -type f ! -name '_the.*' | LC_ALL=C sort | xargs -d '\n' sha256sum) | sha256sum | cut -c1-64)
         if ! { [ -n "$pin" ] && [ "$pin" = "$have" ]; }; then
           echo "repr-java: warning: $plat/java.base is not the pin's ($have, pinned $pin)" >&2
           # review 010, finding 2: a pack of another platform must not be written with a provenance naming the pin
           # (platform-check keeps the warning: its byte comparison decides); REPR_JAVA_PACK_ANY=1 asks otherwise
           # explicitly, and the provenance then records the directory's hash as :java.base
           if [ "$cmd" = platform-pack ]; then
             if [ "${REPR_JAVA_PACK_ANY:-}" = 1 ]; then pin=$have
             else echo "repr-java: platform-pack refuses: $plat/java.base is not the pin's (REPR_JAVA_PACK_ANY=1 packs it anyway, recording its hash)" >&2; exit 1; fi
           fi
         fi
         pack=$root/jdk/platform/java.base.decls prov=$root/jdk/platform/provenance.edn
         strip_hash() { (cd "$root" && sha256sum arbace/repr/java/classfile.ae arbace/repr/java/platform.ae | sha256sum | cut -c1-64); }
         if [ "$cmd" = platform-pack ]; then
           out=${1:-$pack}
           arbace_tool -m arbace.repr.java.platform pack "$plat" "$out" java.base || exit 1
           if [ "$out" = "$pack" ]; then
             printf '%s\n' ";; jdk/platform/java.base.decls: java.base's declarations-only class files (doc/classes/JAVA-FRONTEND-SURVEY.md," \
               ";; JN10 part 2, JFS131 (b), JFS135 (a)), written by bin/repr-java platform-pack from the platform" \
               ";; jdk/javac/platform.sha256 pins; bin/repr-java platform-check proves it, bin/provenance-check checks the hash" \
               "{:pack \"jdk/platform/java.base.decls\"" \
               " :sha256 \"$(sha256sum < "$pack" | cut -c1-64)\"" \
               " :bytes $(stat -c %s "$pack")" \
               " :jdk \"$(repr_java_platform)\"" \
               " :java.base \"$pin\"" \
               " :writer \"bin/repr-java platform-pack\"" \
               " :strip \"$(strip_hash)\"}" > "$prov"
           fi
           exit 0
         else
           st=0
           arbace_tool -m arbace.repr.java.platform check "$plat" "${1:-$pack}" java.base || st=1
           want=$(sed -n 's/.*:sha256 "\([0-9a-f]*\)".*/\1/p' "$prov")
           [ "$want" = "$(sha256sum < "${1:-$pack}" | cut -c1-64)" ] && echo "platform-check: the pack's hash is the provenance's" \
             || { echo "platform-check: the pack's hash is not $prov's (bin/repr-java platform-pack)"; st=1; }
           ws=$(sed -n 's/.*:strip "\([0-9a-f]*\)".*/\1/p' "$prov")
           [ "$ws" = "$(strip_hash)" ] && echo "platform-check: strip's sources are the provenance's" \
             || { echo "platform-check: classfile.ae or platform.ae changed since the pack was written (bin/repr-java platform-pack)"; st=1; }
           exit $st
         fi ;;
  parse) if [ "${1:-}" = --javac ]; then
           shift
           if [ "${1:-}" = --time ]; then shift; set -- -m arbace.repr.java.jtree time "$@"
           else set -- -m arbace.repr.java.jtree dump "$@"; fi
         else
           . "$root/bin/lib/tools.bash"
           arbace_tool -m arbace.repr.java.parse "$@"; exit $?
         fi ;;
  declarations) declarations=1 ;;
  roundtrip) exec "$root/bin/lib/repr-java/roundtrip" "$@" ;;
  print) . "$root/bin/lib/tools.bash"
         arbace_tool -m arbace.repr.java.print "$@"; exit $? ;;
  main) ;;
  javac) javac=1 ;;
  platform-dir) platform_dir=1 ;;
  *) sed -n '2,/^set -/p' "$0" | sed '$d; s/^# \{0,1\}//' >&2; exit 2 ;;
esac
case ${REPR_JAVA_HOST:-arbace} in
  arbace) ;;
  jvm) echo "repr-java: REPR_JAVA_HOST=jvm, the frozen JVM's read, left with JN6 (doc/classes/JAVA-FRONTEND-SURVEY.md, \"As built: JN6\"): repr/java runs on javac's tool executable alone" >&2; exit 2 ;;
  *) echo "repr-java: REPR_JAVA_HOST is arbace (or unset), not $REPR_JAVA_HOST" >&2; exit 2 ;;
esac
. "$root/bin/lib/host.bash"
exe=${REPR_JAVA_EXE:-$root/target/arbace-go/$(arbace_host_arch)/arbace-javac}
[ -x "$exe" ] || { echo "repr-java: no javac tool executable $exe (bin/javac-vendor build, or REPR_JAVA_EXE)" >&2; exit 1; }
platform=$root/.tmp/repr-java-platform
mkdir -p "$root/.tmp"
(
  # made once for the pin (bin/javac-vendor platform checks it), one maker at a time
  flock 9
  if ! cmp -s "$root/jdk/javac/platform.sha256" "$platform/.pin"; then
    made=$("$root/bin/javac-vendor" platform "$platform") || exit 1
    [ "$made" = "$platform" ] || exit 1
    cp "$root/jdk/javac/platform.sha256" "$platform/.pin"
  fi
  # javac's command line on Arbace, the tool's script
  s='(System/exit (jdk.internal.jrt.javac.Main/run (into-array String *command-line-args*)))'
  [ "$([ ! -f "$platform.javac.ae" ] || cat "$platform.javac.ae")" = "$s" ] || printf '%s\n' "$s" > "$platform.javac.ae"
) 9> "$root/.tmp/repr-java-platform.lock" || { echo "repr-java: no platform (bin/javac-vendor platform)" >&2; exit 1; }
if [ -n "${javac:-}" ]; then exec "$exe" "$platform.javac.ae" --platform "$platform" "$@"; fi
if [ -n "${platform_dir:-}" ]; then echo "$platform"; exit 0; fi
if [ -n "${declarations:-}" ]; then
  out=${1:?usage: bin/repr-java declarations OUT}
  case $out in /*) ;; *) out=$PWD/$out ;; esac
  rm -rf "$out"; mkdir -p "$out/classes"
  . "$root/bin/lib/tools.bash"
  (cd "$root" && arbace_tool -m arbace.repr.java.print --quiet --layout declarations --index jdk/forms \
     arbace/lang/*.ae arbace/java/api "$out/java") > "$out/print.log" 2>&1 \
    || { cat "$out/print.log" >&2; echo "repr-java declarations: the print failed" >&2; exit 1; }
  (cd "$out/java" && find . -name '*.java' | sed 's|^\./||' | LC_ALL=C sort) > "$out/files.list"
  (cd "$out/java" && "$exe" "$platform.javac.ae" --platform "$platform" -g:none -nowarn -XDsuppressNotes -proc:none \
     -Xmaxerrs 100000 -sourcepath . -d "$out/classes" "@$out/files.list") > "$out/javac.log" 2>&1 \
    || { head -40 "$out/javac.log" >&2; echo "repr-java declarations: javac on Arbace failed ($out/javac.log)" >&2; exit 1; }
  echo "$out/classes"
  exit 0
fi
REPR_JAVA_PLATFORM=$platform ARBACE_PATH=$root${ARBACE_PATH:+:$ARBACE_PATH} exec "$exe" "$@"

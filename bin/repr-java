#!/bin/bash
# repr/java, Java's bridge: Java source as Java forms (read) and Java forms as Java source (print).
# read needs javac's attribution, so it runs where javac does: since JN5 by default on javac's
# tool executable, javac's forms and the reader compiled into Arbace (javac on Arbace; the host
# below, doc/classes/JAVA-FRONTEND-SURVEY.md, "As built: JN4", "As built: JN5"), or, until JN6,
# on the frozen JVM Arbace (REPR_JAVA_HOST=jvm, the reference: bin/lib/frozen.bash, with
# arbace.repr.java and the Java forms' front end, arbace.classes.types, env, parse, lower,
# analyze, loaded from the checkout's sources, frozen_view tools). print needs no javac and runs
# on the tools' host (bin/lib/tools.bash's arbace_tool, as repr/go's printer). See
# doc/classes/CONVERTER-NOTES.md, PRINTER-NOTES.md.
#
#   bin/repr-java read [OPTIONS] OUT ROOT [PATH...]
#                       convert the .java files under ROOT (or the PATHs) into Java forms under
#                       OUT (arbace.repr.java: --rename FROM=TO, --javac OPT, --check; --full, mode
#                       :full: the forms also record the Java text, for print to give it back byte
#                       for byte, arbace.repr.java.full)
#   bin/repr-java read-jdk [OPTIONS] OUT MODULE SRC [PATH...]
#                       the same for a module of the JDK itself, attributed with --patch-module
#                       (bin/jrt-convert's java.base)
#   bin/repr-java print [--index DIR]... [--layout full|lines] [--anew] [--quiet] FORMS... OUT
#                       print Java forms as Java (arbace.repr.java.print, on the tools' host): every
#                       converted file under the FORMS (files or directories) holding Java forms
#                       becomes OUT/<package path>/<Name>.java; --index DIR, more converted files
#                       the printer consults (which classes are generic), e.g. jdk/forms; forms of
#                       mode :full print in the full layout (the default), the declarations that are
#                       the ones recorded as their Java text, the others anew (--anew: every member);
#                       --layout lines prints every file anew
#   bin/repr-java roundtrip [--corpus C,...] [--no-classes] [--text | --text-only] [--record]
#                       the round trip Java -> forms -> Java -> forms, judged at three levels: forms,
#                       ae (the converted text), classes (bin/lib/repr-java/roundtrip, its header;
#                       corpora baseline, samples, jdk), against test/repr/java/roundtrip/; --text,
#                       then the text level: mode :full printed back byte for byte
#   bin/repr-java declarations OUT
#                       the declarations of Arbace's runtime (doc/classes/JAVA-FRONTEND-SURVEY.md,
#                       JFS6, JFS27): the checkout's arbace/lang and arbace/java/api printed by print
#                       --layout declarations (no code: bodies throw null) into OUT/java, compiled by
#                       javac on Arbace (javac's tool executable, as REPR_JAVA_HOST=arbace below,
#                       -g:none) into OUT/classes, whose path it prints: javac's class path for Java
#                       that names the runtime (the suite's fixtures, arbace.lang.IFn) without the
#                       frozen jar
#   bin/repr-java host-check [CORPUS...]
#                       read on javac's tool executable (REPR_JAVA_HOST=arbace) against the frozen
#                       JVM's read, every corpus (bin/lib/repr-java/host-check, its header; until
#                       JN6, the JVM's read the reference)
#   bin/repr-java coverage REPORT.edn...
#                       a Markdown summary of conversion reports (arbace.repr.java.coverage)
#   bin/repr-java check [--suite | --update | --jdk [MODULE...]]
#                       the converter's checks (bin/lib/repr-java/check, its header): the
#                       output compared with the expected forms under test/repr/java/expected
#   bin/repr-java main ARGS...
#                       arbace.lang.Main's arguments, on the same JVM (e.g. -m NS ...)
#
#   bin/repr-java javac ARGS...
#                       javac's command line on the host below: on javac's tool executable, javac
#                       on Arbace (jdk.internal.jrt.javac.Main) against the platform; on the JVM the
#                       frozen JDK's javac (javac on $PATH, -J-Xmx4g); the round trip's classes
#                       level and bin/jrt-convert's javac step compile with it
#
# Environment: REPR_JAVA_HOST, the host of read, read-jdk, coverage, main and javac: arbace (the
# default since JN5), javac's tool executable (doc/classes/JAVA-FRONTEND-SURVEY.md, "As built:
# JN4", "As built: JN5"): REPR_JAVA_EXE (default target/arbace-go/<arch>/arbace-javac,
# bin/javac-vendor build, which records the key of its sources beside it, EXE.key,
# bin/lib/javac-key.bash; the provenance files name it), with arbace.repr.java compiled into it
# (a namespace whose source in the checkout differs from its embedded copy loaded from the
# checkout, ARBACE_PATH) and javac on Arbace attributing against the platform of
# jdk/javac/platform.sha256 (bin/javac-vendor platform, made once into .tmp/repr-java-platform),
# REPR_JAVA_CP its class path; jvm, the frozen JVM (bin/lib/frozen.bash, the reference until JN6):
# REPR_JAVA_JVM_OPTS, heap options (default -Xmx24g); REPR_JAVA_CP, more class path (javac's
# class path for the classes the sources name is read's --javac -cp). Both: REPR_JAVA_THREADS,
# read-jdk's parallel chunks (default 12); REPR_JAVA_PATCH_ALL, REPR_JAVA_DEBUG
# (arbace.repr.java). The output is the same on both (bin/lib/repr-java/host-check).
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/renamed-env.bash" # stops on a stale G2A_*, J2A_*, A2G_* or C2A_*
cmd=${1:-}
[ $# -gt 0 ] && shift
case $cmd in
  read|read-jdk) set -- -m arbace.repr.java "$cmd" "$@" ;;
  coverage) set -- -m arbace.repr.java.coverage "$@" ;;
  check) exec "$root/bin/lib/repr-java/check" "$@" ;;
  host-check) exec "$root/bin/lib/repr-java/host-check" "$@" ;;
  declarations) declarations=1 ;;
  roundtrip) exec "$root/bin/lib/repr-java/roundtrip" "$@" ;;
  print) . "$root/bin/lib/tools.bash"
         arbace_tool -m arbace.repr.java.print "$@"; exit $? ;;
  main) ;;
  javac) javac=1 ;;
  *) sed -n '2,/^set -/p' "$0" | sed '$d; s/^# \{0,1\}//' >&2; exit 2 ;;
esac
host=${REPR_JAVA_HOST:-arbace}
case $host in arbace|jvm) ;; *) echo "repr-java: REPR_JAVA_HOST is arbace or jvm, not $host" >&2; exit 2 ;; esac
if [ -n "${javac:-}" ] && [ "$host" = jvm ]; then exec javac -J-Xmx4g "$@"; fi
if [ "$host" = arbace ] || [ -n "${declarations:-}" ]; then
  . "$root/bin/lib/host.bash"
  exe=${REPR_JAVA_EXE:-$root/target/arbace-go/$(arbace_host_arch)/arbace-javac}
  [ -x "$exe" ] || { echo "repr-java: no javac tool executable $exe (bin/javac-vendor build, or REPR_JAVA_EXE)" >&2; exit 1; }
  platform=$root/.tmp/repr-java-platform
  mkdir -p "$root/.tmp"
  (
    # made once for the pin (bin/javac-vendor platform checks it), one maker at a time
    flock 9
    if ! cmp -s "$root/jdk/javac/platform.sha256" "$platform/.pin"; then
      made=$("$root/bin/javac-vendor" platform "$platform") || exit 1
      [ "$made" = "$platform" ] || exit 1
      cp "$root/jdk/javac/platform.sha256" "$platform/.pin"
    fi
    # javac's command line on Arbace, the tool's script
    s='(System/exit (jdk.internal.jrt.javac.Main/run (into-array String *command-line-args*)))'
    [ "$(cat "$platform.javac.ae" 2>/dev/null)" = "$s" ] || printf '%s\n' "$s" > "$platform.javac.ae"
  ) 9> "$root/.tmp/repr-java-platform.lock" || { echo "repr-java: no platform (bin/javac-vendor platform)" >&2; exit 1; }
  if [ -n "${javac:-}" ]; then exec "$exe" "$platform.javac.ae" --platform "$platform" "$@"; fi
  if [ -n "${declarations:-}" ]; then
    out=${1:?usage: bin/repr-java declarations OUT}
    case $out in /*) ;; *) out=$PWD/$out ;; esac
    rm -rf "$out"; mkdir -p "$out/classes"
    . "$root/bin/lib/tools.bash"
    (cd "$root" && arbace_tool -m arbace.repr.java.print --quiet --layout declarations --index jdk/forms \
       arbace/lang/*.ae arbace/java/api "$out/java") > "$out/print.log" 2>&1 \
      || { cat "$out/print.log" >&2; echo "repr-java declarations: the print failed" >&2; exit 1; }
    (cd "$out/java" && find . -name '*.java' | sed 's|^\./||' | LC_ALL=C sort) > "$out/files.list"
    (cd "$out/java" && "$exe" "$platform.javac.ae" --platform "$platform" -g:none -nowarn -XDsuppressNotes -proc:none \
       -Xmaxerrs 100000 -sourcepath . -d "$out/classes" "@$out/files.list") > "$out/javac.log" 2>&1 \
      || { head -40 "$out/javac.log" >&2; echo "repr-java declarations: javac on Arbace failed ($out/javac.log)" >&2; exit 1; }
    echo "$out/classes"
    exit 0
  fi
  REPR_JAVA_PLATFORM=$platform ARBACE_PATH=$root${ARBACE_PATH:+:$ARBACE_PATH} exec "$exe" "$@"
fi
. "$root/bin/lib/frozen.bash"
exports=()
for p in api tree util parser code file main comp jvm; do
  exports+=(--add-exports "jdk.compiler/com.sun.tools.javac.$p=ALL-UNNAMED" --add-opens "jdk.compiler/com.sun.tools.javac.$p=ALL-UNNAMED")
done
# shellcheck disable=SC2086
FROZEN_CP=${REPR_JAVA_CP:-} frozen_java tools -Xss64m ${REPR_JAVA_JVM_OPTS:--Xmx24g} "${exports[@]}" -- "$@"

#!/bin/bash
# Run j2a, the Java -> class forms converter (arbace.j2a), on the frozen JVM Arbace with access to
# javac internals: javac is j2a's front end, so j2a runs on a JVM (doc/STANDALONE-NOTES.md, "S4:
# the JVM removed", O1): the frozen jar (bin/lib/frozen.bash), with arbace.j2a and the class
# forms' front end (arbace.classes.types, env, parse, lower, analyze) loaded from the checkout's
# sources (frozen_view tools).
# Usage: bin/j2a [arbace.lang.Main args...]; bin/j2a -m arbace.j2a.main ... converts Java to
# class forms. J2A_JVM_OPTS: heap options (default -Xmx24g). J2A_CP: more class path (javac's
# class path for the classes the sources name is j2a's --javac -cp).
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/frozen.bash"
exports=()
for p in api tree util parser code file main comp jvm; do
  exports+=(--add-exports "jdk.compiler/com.sun.tools.javac.$p=ALL-UNNAMED" --add-opens "jdk.compiler/com.sun.tools.javac.$p=ALL-UNNAMED")
done
# shellcheck disable=SC2086
FROZEN_CP=${J2A_CP:-} frozen_java tools -Xss64m ${J2A_JVM_OPTS:--Xmx24g} "${exports[@]}" -- "$@"

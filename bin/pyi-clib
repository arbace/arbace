#!/bin/bash
# pyi's C library cores (queue 208; doc/python/PYTHON-SURVEY.md, "As built: 208"; PYS22 (a), doc/python/AFTER-PY11.md
# §1.7): the stdlib modules whose core is a C library (_bz2 over bzip2) run the library itself, built by ci's builder
# (bin/ci nodes: repr/c's read, arbace.c.check, arbace.c.build, linked with musl 1.2.6's forms) into one node program,
# with the module's glue in Go over pyi's objects (go/arbace/pybz2) calling it through go/arbace/clib. Each library
# is a directory of tools/pyi/clib/ (lib.conf: its tarball's URL and SHA-256, its files and flags; its C glue).
#
#   bin/pyi-clib fetch LIB       the tarball fetched once into the main checkout's .tmp/cache/clib/ (the one network
#                                step), checked by lib.conf's SHA-256
#   bin/pyi-clib build LIB       the node program built (the tarball extracted into .tmp/pyi-clib/LIB/src) and
#                                written as go/arbace/clib/LIB (package arbace/clib/LIB: Nodes, the node program's
#                                text, and Key, its build's key), kept by the key: lib.conf, the glue, the tarball's
#                                pin, repr/c's, ci's builder's and musl's reader's sources and the musl forms' key; the
#                                checkout's builder runs (evaluated, not a stage 0's embedded copy)
#   bin/pyi-clib verify LIB      built afresh into .tmp/pyi-clib/LIB/verify and compared with the committed forms
#   bin/pyi-clib key LIB         the build's key
#   bin/pyi-clib undefined LIB   the committed node program's undefined data symbols, NAME SIZE a line: the statics
#                                ci's link placed at address 0 ((at N 0)) that no alias resolves (queue 481, 475-1
#                                (a)); status 1 when one is not the linker's own (__init_array_*, __fini_array_*,
#                                _DYNAMIC: a static link's empty arrays and no dynamic section, 0 as ld gives them),
#                                which `build` and `verify` refuse: a C module reading one reads address 0
#   bin/pyi-clib exe LIB [OUT]   a program's committed node program (its glue has a main; queue 489: pytokenizer)
#                                translated whole by cf2g into a main package and built by TamaGo's go with ci's back end
#                                (bin/ci cirun-build's printed go/arbace/{ci,crt}) into OUT/LIB (default the main
#                                checkout's .tmp/pyi-clib/LIB/exe), kept by the Nodes' digest and the back end's key;
#                                the executable's path printed
#   bin/pyi-clib aot LIB OUT     the committed node program translated by cf2g (arbace.c.cf2g) into OUT/prog.go, the
#                                package arbace/clib/LIB/aot whose init registers its compiled functions with
#                                arbace/clib (pyi's AOT links it: the library compiled), kept by the Nodes' digest; a world
#                                with committed forms of that package (lib.conf's compiled=1) printed from them instead
#   bin/pyi-clib aot-forms LIB   queue 521 (DECISION 521-2 (b)): a compiled world's package arbace/clib/LIB/aot as Go forms,
#                                go/arbace/clib/LIB/aot.ae and aot/prog.ae (tools/pyi/clib/aot_forms.ae on stage 0, cf2g's
#                                forms with aot's setup), committed as repr/go's generated packages are: goi's table links
#                                it into the executable through arbace/clib/worlds (eval's world compiled, no node program
#                                loaded); build writes them for a lib.conf with compiled=1 and verify compares them too
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash"
. "$root/bin/lib/tools.bash"
die() { echo "pyi-clib: $*" >&2; exit 1; }
cmd=${1:-}; lib=${2:-}
[ -n "$cmd" ] && [ -n "$lib" ] || { sed -n '2,/^set -/p' "$0" | sed '$d; s/^# \{0,1\}//' >&2; exit 2; }
dir=$root/tools/pyi/clib/$lib
[ -f "$dir/lib.conf" ] || die "no library $lib (tools/pyi/clib/$lib/lib.conf)"
url= sha256= top= cflags= sources= glue= includes= cache_var= members= root_includes= inline= compiled=
. "$dir/lib.conf"
work=$root/.tmp/pyi-clib/$lib
cmain=${root%%/.tmp/gate-clean/*}; cmain=${cmain%%/.tmp/worktrees/*}
cache=${PYI_CLIB_CACHE:-$cmain/.tmp/cache/clib}
# queue 244: a library whose sources are in a tarball another pin already fetches (CPython's own, for
# Modules/_ctypes/_ctypes_test.c) names that cache's variable (cache_var=REPR_PYTHON_SRC) and the members to extract
if [ -n "$cache_var" ] && [ -n "${!cache_var:-}" ]; then cache=${!cache_var}; fi
tb=$cache/$(basename "$url")

fetch() {
  mkdir -p "$cache"
  if [ ! -f "$tb" ]; then
    wget -q -O "$tb.part" "$url" || { rm -f "$tb.part"; die "fetching $url failed"; }
    mv "$tb.part" "$tb"
  fi
  echo "$sha256  $tb" | sha256sum -c --quiet || die "$tb does not match lib.conf's pin"
}

key() {
  "$root/bin/ci" musl prepare >/dev/null
  { echo "$sha256"
    # shellcheck disable=SC2086
    (cd "$root" && find "tools/pyi/clib/$lib" $root_includes arbace/repr/c.ae arbace/repr/c arbace/c/build.ae arbace/c/check.ae \
       arbace/c/run.ae arbace/c/musl.ae test/c/host bin/pyi-clib -type f | LC_ALL=C sort | xargs sha256sum)
    "$root/bin/lib/ci/musl" key; } | sha256sum | cut -c1-64
}

# undefined_syms NODES: the undefined data symbols of a node program (its text, or a nodes.ae's Nodes literal), NAME
# SIZE a line, the linker's own marked "(the linker's)"; status 1 when another is among them
undefined_syms() {
  python3 -I -S -B - "$1" <<'PY'
import re, sys
text = open(sys.argv[1], encoding='ascii').read()
if sys.argv[1].endswith('.ae'):
    # the Go literal of nodes.ae (bin/pyi-clib build's q): \" and \\ and \n escaped, one line
    i = text.index('Nodes "') + len('Nodes "')
    lit = re.match(r'((?:[^"\\]|\\.)*)"', text[i:]).group(1)
    text = re.sub(r'\\(x[0-9a-f]{2}|.)', lambda m: {'n': '\n', '"': '"', '\\': '\\'}.get(m.group(1)) or chr(int(m.group(1)[1:], 16)), lit)
linker = {'__init_array_start', '__init_array_end', '__fini_array_start', '__fini_array_end', '_DYNAMIC'}
names, sizes, at0, aliased = {}, {}, [], set()
for line in text.split('\n'):
    m = re.match(r'\(static (\d+) (\d+) \d+ \d+ "(.*)"\)$', line)
    if m:
        names[m.group(1)], sizes[m.group(1)] = m.group(3), m.group(2)
    elif re.match(r'\(at \d+ 0\)$', line):
        at0.append(line.split()[1])
    elif line.startswith('(alias '):
        aliased.add(line.split()[1])
bad = 0
for n in at0:
    if n in aliased:
        continue
    nm = names.get(n, '?%s' % n)
    own = nm in linker
    bad |= not own
    print('%s %s%s' % (nm, sizes.get(n, '?'), " (the linker's)" if own else ''))
sys.exit(bad)
PY
}

# build_into OUT: the node program written as Go (OUT/go/LIB/nodes.go) and read into forms (OUT/forms)
build_into() {
  local out=$1 k src
  k=$(key)
  fetch
  . "$root/bin/lib/crops/musl-hold.bash"; ci_musl_hold >/dev/null
  rm -rf "$work/src"; mkdir -p "$work/src"
  # shellcheck disable=SC2086
  tar -xf "$tb" -C "$work/src" $members
  src=$work/src/$top
  # queue 269: lib.conf's inline (FILE:FRAGMENT): FILE's line #include "FRAGMENT's name" replaced by FRAGMENT's text
  local il
  for il in $inline; do
    awk -v inc="$src/${il##*:}" -v line="#include \"$(basename "${il##*:}")\"" \
      '$0 == line { while ((getline l < inc) > 0) print l; next } { print }' "$src/${il%%:*}" > "$src/${il%%:*}.inl"
    mv "$src/${il%%:*}.inl" "$src/${il%%:*}"
  done
  # queue 270: every path ci sees relative to the checkout, ci run from it, so __FILE__ (assert's messages) and the
  # statics' sizes do not depend on where the checkout lives (261's build at another path differed at the same key)
  local rdir=${dir#"$root"/} rsrc=${src#"$root"/}
  local files=() f
  for f in $glue; do files+=("$rdir/$f"); done
  for f in $sources; do files+=("$rsrc/$f"); done
  # the include path: the glue's directory first (a library's configured config.h lives there), the tarball's top,
  # then lib.conf's includes (directories of the tarball)
  local incs=(-I"$rdir" -I"$rsrc")
  for f in $includes; do incs+=(-I"$rsrc/$f"); done
  # queue 244: lib.conf's root_includes, directories of the checkout (Arbace's clean-room Python.h), after the glue's
  for f in $root_includes; do incs+=(-I"$f"); done
  rm -rf "$out"; mkdir -p "$out/go/clib/$lib"
  # shellcheck disable=SC2086
  # the checkout's builder, evaluated (a stage 0 embeds the arbace/c it was built from, which the key does not name:
  # RULES' ARBACE_PATH_FIRST=1 ARBACE_NO_AOT=1 ARBACE_NO_IMAGE=1, about 5 times slower)
  (cd "$root" && ARBACE_PATH_FIRST=1 ARBACE_NO_AOT=1 ARBACE_NO_IMAGE=1 \
  "$root/bin/ci" nodes $cflags "${incs[@]}" -o "$out/$lib.nodes" "${files[@]}") > "$out/nodes.log" 2>&1 \
    || { grep -v '^Reflection\|^Auto-boxing\|recur arg' "$out/nodes.log" >&2; die "ci's builder refused $lib"; }
  # queue 481 (475-1 (a)): a data symbol no unit defines is placed at address 0 by ci's link; refused but the linker's own
  undefined_syms "$out/$lib.nodes" > "$out/undefined.txt" \
    || { grep -v "(the linker's)" "$out/undefined.txt" >&2; die "$lib's world has undefined data symbols (above, NAME SIZE): define them in its glue"; }
  printf 'module arbace\n\ngo 1.27\n' > "$out/go/go.mod"
  python3 -I -S -B - "$out/$lib.nodes" "$out/go/clib/$lib/nodes.go" "$lib" "$k" "$sha256" "$url" <<'PY'
import sys
nodes, out, lib, key, sha, url = sys.argv[1:]
text = open(nodes, 'rb').read().decode('ascii')
# a static's fifth field is a name the loader ignores; for an anonymous object (a static local, a compound literal,
# a temporary) the builder prints its key's identity ("java.lang.Object@HEX"), which depends on the executable that
# ran the builder: one stable word instead, so the committed node program is the same from any host
import re
text = re.sub(r'"java\.lang\.Object@[0-9a-f]+"', '"anon"', text)
def q(s):
    r = []
    for c in s:
        o = ord(c)
        if c == '\\': r.append('\\\\')
        elif c == '"': r.append('\\"')
        elif c == '\n': r.append('\\n')
        elif o < 32 or o == 127: r.append('\\x%02x' % o)
        else: r.append(c)
    return '"' + ''.join(r) + '"'
lines = text.split('\n')
with open(out, 'w') as f:
    f.write('// Code generated by bin/pyi-clib build %s; DO NOT EDIT.\n\n' % lib)
    f.write('// Package %s is the C library %s as ci\'s node program (arbace.c.build\'s output, linked with musl 1.2.6), for\n' % (lib, lib))
    f.write('// arbace/clib: built by ci\'s builder from %s (SHA-256 %s) and the C glue of\n// tools/pyi/clib/%s (queue 208; doc/python/PYTHON-SURVEY.md, "As built: 208"). Its licenses: LICENSE.md.\n' % (url, sha, lib))
    f.write('package %s\n\n' % lib)
    f.write('// Key is the build\'s key (bin/pyi-clib key %s).\nconst Key = "%s"\n\n' % (lib, key))
    f.write('// Nodes is the node program\'s text, one command a line (one literal).\nvar Nodes = ')
    f.write(q(text))
    f.write('\n')
PY
  (cd "$out/go" && "$root/bin/repr-go" read --goos linux --goarch amd64 --out "$out/forms" "./clib/$lib") > "$out/read.log" 2>&1 \
    || { cat "$out/read.log" >&2; die "the node program's Go does not read"; }
  echo "$k" > "$out/key"
}

# aot_forms_into DIR: the compiled package's forms (DIR/aot.ae, DIR/aot/prog.ae) from DIR/nodes.ae's node program (DIR the
# library's go/arbace/clib/LIB, committed or a verify's), keyed by nodes.ae's SHA-256 on their first line
aot_forms_into() {
  local d=$1 sha t=$work/aot-forms
  sha=$(sha256sum < "$d/nodes.ae" | cut -c1-64)
  if [ -f "$d/aot.ae" ] && grep -q "SHA-256 $sha)" "$d/aot.ae"; then return 0; fi
  rm -rf "$t" "$d/aot" "$d/aot.ae"; mkdir -p "$t"
  ARBACE_PATH="$root" "$root/bin/repr-go" print "$(dirname "$d")/$lib.ae" "$t/go" > "$t/print.log" 2>&1 \
    || { cat "$t/print.log" >&2; die "the node program of $lib does not print"; }
  arbace_tool "$root/tools/pyi/clib/aot_text.ae" nodes "$t/go/nodes.go" "$t/aot.nodes" || die "the node program's text of $lib"
  (cd "$root" && arbace_tool "$root/tools/pyi/clib/aot_forms.ae" "$t/aot.nodes" "$d" "$lib" "$sha") > "$t/forms.log" 2>&1 \
    || { cat "$t/forms.log" >&2; die "cf2g refused $lib"; }
  rm -rf "$t"
}

case $cmd in
  fetch) fetch; echo "$tb" ;;
  key) key ;;
  undefined) undefined_syms "$root/go/arbace/clib/$lib/nodes.ae" ;;
  build)
    k=$(key)
    if [ -f "$root/go/arbace/clib/$lib.ae" ] && grep -q "$k" "$root/go/arbace/clib/$lib/nodes.ae" 2>/dev/null; then
      echo "go/arbace/clib/$lib is the build of key $k: kept"; exit 0
    fi
    build_into "$work/build"
    mkdir -p "$root/go/arbace/clib"
    rm -rf "$root/go/arbace/clib/$lib" "$root/go/arbace/clib/$lib.ae"
    cp -r "$work/build/forms/go/arbace/clib/$lib" "$work/build/forms/go/arbace/clib/$lib.ae" "$root/go/arbace/clib/"
    [ "$compiled" != 1 ] || aot_forms_into "$root/go/arbace/clib/$lib"
    echo "go/arbace/clib/$lib built ($(wc -c < "$work/build/$lib.nodes") bytes of node program, key $k)" ;;
  verify)
    build_into "$work/verify"
    [ "$compiled" != 1 ] || aot_forms_into "$work/verify/forms/go/arbace/clib/$lib"
    if diff -r "$root/go/arbace/clib/$lib" "$work/verify/forms/go/arbace/clib/$lib" >/dev/null \
       && cmp -s "$root/go/arbace/clib/$lib.ae" "$work/verify/forms/go/arbace/clib/$lib.ae"; then
      echo "pyi-clib: go/arbace/clib/$lib is the build's, byte for byte"
    else
      echo "pyi-clib: go/arbace/clib/$lib DIFFERS from the build (diff -r go/arbace/clib/$lib $work/verify/forms/go/arbace/clib/$lib)"; exit 1
    fi ;;
  exe)
    # one build at a time (two lex-checks at once wait, then keep it); its key: the Nodes' digest and ci's back end's
    out=${3:-$cmain/.tmp/pyi-clib/$lib/exe}
    mkdir -p "$out"
    exec {lk}>"$out.lock"; flock "$lk"
    "$root/bin/ci" cirun-build --ensure > "$out/cirun-build.log" 2>&1 || { cat "$out/cirun-build.log" >&2; die "ci's back end did not build"; }
    nk=$( { sha256sum < "$root/go/arbace/clib/$lib/nodes.ae"; cat "$root/.tmp/ci/key"; } | sha256sum | cut -c1-64)
    if [ -x "$out/$lib" ] && [ "$(cat "$out/exe.key" 2>/dev/null)" = "$nk" ]; then echo "$out/$lib"; exit 0; fi
    rm -f "$out/exe.key" "$out/$lib"
    n=$out/prog.nodes
    rm -rf "$out/src" "$out/mod"; mkdir -p "$out/src" "$out/mod/prog"
    ARBACE_PATH="$root" "$root/bin/repr-go" print "$root/go/arbace/clib/$lib.ae" "$out/src" > "$out/print.log" 2>&1 \
      || { cat "$out/print.log" >&2; die "the node program of $lib does not print"; }
    arbace_tool "$root/tools/pyi/clib/aot_text.ae" nodes "$out/src/nodes.go" "$n" || die "the node program's text of $lib"
    (cd "$root" && arbace_tool -m arbace.c.cf2g translate "$n" "$out/mod/prog") > "$out/cf2g.log" 2>&1 \
      || { cat "$out/cf2g.log" >&2; die "cf2g refused $lib"; }
    cp -r "$root/.tmp/ci/go/ci" "$root/.tmp/ci/go/crt" "$out/mod/"
    printf 'module arbace\n\ngo 1.27\n' > "$out/mod/go.mod"
    (cd "$out/mod" && CGO_ENABLED=0 GOFLAGS=-mod=mod GOCACHE=${GOCACHE:-$root/.tmp/gocache} GOMAXPROCS=4 \
       "${ARBACE_GOROOT:-/root/tamago-go}/bin/go" build -p 2 -trimpath -o "$out/$lib" ./prog) > "$out/build.log" 2>&1 \
      || { tail -20 "$out/build.log" >&2; die "$lib's Go does not build"; }
    rm -rf "$out/src" "$n"
    echo "$nk" > "$out/exe.key"
    echo "$out/$lib" ;;
  aot-forms) aot_forms_into "$root/go/arbace/clib/$lib"; echo "go/arbace/clib/$lib/aot: $(wc -c < "$root/go/arbace/clib/$lib/aot/prog.ae") bytes of forms" ;;
  aot)
    out=${3:?bin/pyi-clib aot LIB OUT}
    mkdir -p "$out"
    # py-core-1124: the key also the translator's sources (cf2g and the namespaces it loads, arbace/c), so bin/pyi's AOT module
    # can keep a translation across its rebuilds (aot_module_rebuild)
    nk=$(cat "$root/go/arbace/clib/$lib/nodes.ae" "$root/tools/pyi/clib/aot_text.ae" "$root/arbace/c.ae" "$root/arbace/c"/*.ae \
         | sha256sum | cut -c1-64)
    if [ -f "$out/prog.go" ] && [ "$(cat "$out/nodes.key" 2>/dev/null)" = "$nk" ]; then exit 0; fi
    # queue 521: a compiled world's committed forms (aot-forms), printed when they are of this node program
    if [ "$compiled" = 1 ] && grep -q "SHA-256 $nk)" "$root/go/arbace/clib/$lib/aot.ae" 2>/dev/null; then
      rm -f "$out/prog.go"; mkdir -p "$work"
      ARBACE_PATH="$root" "$root/bin/repr-go" print "$root/go/arbace/clib/$lib/aot.ae" "$out" > "$work/aot-print.log" 2>&1 \
        || { cat "$work/aot-print.log" >&2; die "go/arbace/clib/$lib/aot does not print"; }
      echo "$nk" > "$out/nodes.key"; exit 0
    fi
    n=$work/aot.nodes
    rm -rf "$work/aot-src"; mkdir -p "$work/aot-src"
    ARBACE_PATH="$root" "$root/bin/repr-go" print "$root/go/arbace/clib/$lib.ae" "$work/aot-src" >/dev/null
    # the node program's text and the setup rewrite on stage 0 (queue 213: no python3 in pyi's AOT)
    arbace_tool "$root/tools/pyi/clib/aot_text.ae" nodes "$work/aot-src/nodes.go" "$n" || die "the node program's text of $lib"
    (cd "$root" && arbace_tool -m arbace.c.cf2g translate "$n" "$out" aot "arbace/clib/$lib/aot") > "$work/aot.log" 2>&1 \
      || { cat "$work/aot.log" >&2; die "cf2g refused $lib"; }
    # the library's setup: cf2g's Main runs a program (ci.AotMain); a library's package registers its setup instead
    arbace_tool "$root/tools/pyi/clib/aot_text.ae" setup "$out/prog.go" "$lib" || die "cf2g's Main of $lib"
    echo "$nk" > "$out/nodes.key" ;;
  *) sed -n '2,/^set -/p' "$0" | sed '$d; s/^# \{0,1\}//' >&2; exit 2 ;;
esac

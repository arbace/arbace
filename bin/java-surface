#!/bin/bash
# The Java surface of Arbace (B1a step 1, doc/go/JAVA-SURFACE.md): every JDK class, method,
# constructor and field that the classes of target/stage2 reference, read from their bytecode
# (test/g2c/java_surface.clj), grouped by who uses them (arbace.lang, arbace.asm, arbace.core
# and the namespaces loaded at a REPL's start, the other shipped namespaces, arbace.classes),
# classified, and given a proposed treatment. Run on Arbace (bin/lib/tools.bash: target/stage2).
#
# The namespaces loaded at a REPL's start are measured by starting one (stage 2's REPL, its
# loaded-libs after the first prompt).
#
# Usage: bin/java-surface [OUT]     default OUT doc/go/java-surface.edn; the tables of
#                                   doc/go/JAVA-SURFACE.md go to .tmp/java-surface-tables.md
# Environment: JDK_SRC, the jdk26u checkout whose sources are counted (default /root/jdk26u);
#   J2C_JDK_WORK, the work directory of a `bin/j2c-check --jdk java.base` run (default
#   .tmp/j2c-jdk), whose per-file results say which sources of the translation closure j2c
#   converts to javac's class shapes (recorded as :unchecked when absent).
# Deterministic: the output depends only on the stage, the sources and the JDK.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tools.bash"
arbace_runtime
out=${1:-$root/doc/go/java-surface.edn}
jdk=${JDK_SRC:-/root/jdk26u}
mkdir -p "$root/.tmp"
repl=$(echo '(prn (sort (map str (loaded-libs))))' |
       java -cp "$ARBACE_CP" arbace.lang.Main 2>&1 | grep -o '("arbace[^)]*)' | head -1)
[ -n "$repl" ] || { echo "cannot measure the REPL's namespaces" >&2; exit 1; }
exec java -Xss64m -Xmx4g -cp "$ARBACE_CP:$root/test" arbace.lang.Main -e "
(require 'g2c.java-surface)
(let [d (g2c.java-surface/run \"$root\" \"$root/target/stage2\" \"$jdk\" \"$out\" '$repl \"${J2C_JDK_WORK:-$root/.tmp/j2c-jdk}\")]
  (spit \"$root/.tmp/java-surface-tables.md\" (g2c.java-surface/tables d))
  (println \"wrote $out:\" (count (:classes d)) \"JDK classes; tables in .tmp/java-surface-tables.md\"))"

#!/bin/bash
# g2c's printer: Go forms -> Go source (doc/go/SPEC.md §12, doc/go/PRINTER-NOTES.md), run on
# Arbace (bin/lib/tools.bash: target/stage2, built by bin/build-arbace). arbace.g2c loads from
# source, like arbace.j2c.
#
# Usage: bin/g2c-print [--layout lines|gofmt] [--no-line-directives] [--src DIR [--build]]
#                      [--gofmt] FORMS.clj OUTDIR
# Writes one .go file per go/file form of the package FORMS.clj into OUTDIR. With --src, copies
# the package's .s/.h/.syso and embedded files from the original directory DIR and writes
# OUTDIR/overlay.json; --build then runs go build -trimpath -overlay in DIR under the forms'
# configuration. Environment: G2C_GOROOT (default /root/tamago-go), G2C_JVM_OPTS.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tools.bash"
arbace_runtime
# shellcheck disable=SC2086
exec java ${G2C_JVM_OPTS:--Xmx4g} -Xss64m -cp "$ARBACE_CP" arbace.lang.Main -m arbace.g2c.print "$@"

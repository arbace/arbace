#!/bin/bash
# The seed of the bootstrap (doc/STANDALONE-NOTES.md, "S4: the Go-source seed", "S4: the JVM
# removed"; the standalone survey's D3): Arbace's Go program as j2g and repr/go print it at the
# Go-hosted fixpoint, the module bin/arbace-go --build compiles, in one deterministic tar.xz
# (bin/lib/seed-go.bash), seed/arbace-seed-go.tar.xz, pinned by its SHA-256 in
# seed/arbace-seed-go.tar.xz.sha256; the Go toolchain that builds it pinned by seed/goroot.sha256.
# Built by Go's toolchain alone it gives stage 0, the executable that hosts Arbace's tools (j2g,
# repr/go, repr/clojure: bin/lib/host.bash) and so builds Arbace again from its sources. (Until S4 the seed
# was a jar, the frozen JVM Arbace of arbace-for-java-26-v1: on that branch.)
#
# Usage: bin/seed --check    the seed has its pinned hash (fast)
#        bin/seed --build [-o DIR] [--arch A[,B]] [--no-aot]
#                            stage 0: build the executables from the seed (checked first) with
#                            Go's toolchain, into DIR/<arch>/arbace (default target/seed;
#                            architectures default the host's); the image of prepared namespaces
#                            made by the executable itself; DIR/seed.sha256 names the seed (about
#                            20 s with Go's build cache warm, a few minutes cold); then, when its
#                            runtime is the checkout's, the checkout's namespaces compiled by it
#                            into DIR/aot with DIR/aot.key and DIR/aot.runtime (RPS95 (b): the
#                            base of bin/arbace-go --build-program on a fresh clone; --no-aot:
#                            not)
#        bin/seed --make [ARCHIVE]
#                            pack a build's printed module into ARCHIVE (default the seed) and pin
#                            its hash in ARCHIVE.sha256: the last bin/arbace-go --build, or
#                            ARBACE_SEED_GO_BUILD (the fixpoint's G3, target/arbace-go/fixpoint/g3,
#                            which is what a seed to commit is: SA7)
#        bin/seed --verify [REV]
#                            print the seed again from REV (default the commit SEED.edn names), as
#                            it was made: in a temporary git worktree under .tmp/, stage 0 built
#                            from this seed hosts the Go-hosted fixpoint of REV's sources
#                            (bin/arbace-go --fixpoint: G1 by stage 0, G2 by G1, G3 by G2), whose
#                            G3 is packed (bin/seed --make); then the tars are compared byte for
#                            byte (and the archives), and stage 0 = G1 = G2 = G3 byte for byte:
#                            the seed's executable rebuilds itself (three Go-hosted builds)
# Environment:
#   ARBACE_SEED_GO    the seed's archive (default seed/arbace-seed-go.tar.xz)
#   ARBACE_GOROOT     Go's toolchain (default /root/tamago-go, TamaGo's go1.27.1): its VERSION
#                     and the SHA-256 of its sources (VERSION and src/) must be those pinned in
#                     seed/goroot.sha256 and named by SEED.edn (SA4)
# Exit status: 0 when the hash matches (and, for --build, the executables are built; for
# --verify, the seed printed again is identical and its executable rebuilds itself).
set -uo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash" # TMPDIR: .tmp/tmp when unset
. "$root/bin/lib/renamed-env.bash" # stops on a stale G2A_*, J2A_*, A2G_* or C2A_*
cd "$root"
. "$root/bin/lib/seed-go.bash"
goseed=${ARBACE_SEED_GO:-seed/arbace-seed-go.tar.xz}
case $goseed in /*) ;; *) goseed=$root/$goseed ;; esac

# go_check: the Go-source seed has its pinned hash
go_check() {
  [ -f "$goseed" ] && [ -f "$goseed.sha256" ] || { echo "no Go-source seed $goseed (or its .sha256)" >&2; return 1; }
  local want got
  want=$(cut -d' ' -f1 "$goseed.sha256"); got=$(sha256sum "$goseed" | cut -d' ' -f1)
  if [ "$want" = "$got" ]; then
    echo "$goseed: $want, as pinned"
  else
    echo "$goseed: SHA-256 $got, pinned $want" >&2; return 1
  fi
}

case ${1:-} in
  --check) go_check ;;
  --make)
    [ -n "${2:-}" ] && { goseed=$2; case $goseed in /*) ;; *) goseed=$PWD/$goseed ;; esac; }
    mkdir -p "$root/.tmp"
    seed_go_make "$goseed" || exit 1
    (cd "$(dirname "$goseed")" && sha256sum "$(basename "$goseed")") > "$goseed.sha256"
    echo "pinned in $goseed.sha256" ;;
  --build)
    shift
    out=$root/target/seed archs=$(seed_go_host_arch) aot=1
    while [ $# -gt 0 ]; do
      case $1 in
        -o) out=$2; shift 2 ;;
        --arch) archs=$2; shift 2 ;;
        --no-aot) aot=""; shift ;;
        *) echo "usage: bin/seed --build [-o DIR] [--arch A[,B]] [--no-aot]" >&2; exit 2 ;;
      esac
    done
    case $out in /*) ;; *) out=$PWD/$out ;; esac
    go_check || exit 1
    rm -f "$out/seed.sha256"
    seed_go_build "$goseed" "$out" ${archs//,/ } || exit 1
    # what stage 0 was built from (bin/lib/host.bash rebuilds it when the seed changes)
    cut -d' ' -f1 "$goseed.sha256" > "$out/seed.sha256"
    # stage 0's compiled namespaces (RPS95 (b)): the host's executable compiles the checkout's
    # namespaces into DIR/aot (aot.key, aot.runtime), as --gate-build keeps them, so that
    # bin/arbace-go --build-program takes DIR as its base without a --build first; only when its
    # runtime is the checkout's (else the seed is older than the runtime: a re-seed), and a failure
    # leaves stage 0 as it is
    if [ -n "$aot" ]; then
      h=$(seed_go_host_arch)
      if [ -x "$out/$h/arbace" ]; then
        "$root/bin/arbace-go" --compile-aot "$out/$h/arbace" "$out" \
          || echo "bin/seed: stage 0 keeps no compiled namespaces (its runtime is not the checkout's, or the compiling failed; bin/arbace-go --build-program then builds first)" >&2
      fi
    fi ;;
  --verify)
    go_check || exit 1
    # the pinned toolchain, the one the seed names (SA4)
    mkdir -p "$root/.tmp"
    xz -dc "$goseed" | tar -xOf - "$seed_go_top/SEED.edn" > "$root/.tmp/seed-verify.edn"
    toolchain_hash=$(seed_go_toolchain_check "$root/.tmp/seed-verify.edn") || exit 1
    rev=${2:-$(sed -n 's/.*:commit "\([0-9a-f]*\)".*/\1/p' "$root/.tmp/seed-verify.edn" | head -1)}
    [ -n "$rev" ] || { echo "bin/seed: no commit to print the seed from" >&2; exit 1; }
    wt=$root/.tmp/seed-verify
    git worktree remove --force "$wt" 2> "$TMPDIR/seed-verify.discard"; rm -rf "$wt"
    git worktree add --detach "$wt" "$rev" > "$TMPDIR/seed-verify.discard" 2>&1 || { echo "no worktree of $rev" >&2; exit 1; }
    log=$root/.tmp/seed-verify.log
    h=$(seed_go_host_arch)
    s0=$wt/.tmp/seed-verify/stage0
    again=$wt/.tmp/seed-verify/arbace-seed-go.tar.xz
    fp=$wt/target/arbace-go/fixpoint
    echo "== at $(git rev-parse --short "$rev^{commit}"), in $wt (log $log): stage 0 from the seed, the fixpoint, the seed packed again"
    t0=$(date +%s)
    (export ARBACE_HOST_EXE=$s0/$h/arbace
     seed_go_build "$goseed" "$s0" "$h" \
       && cd "$wt" && bin/arbace-go --fixpoint \
       && ARBACE_SEED_GO_BUILD=$fp/g3 bin/seed --make "$again") > "$log" 2>&1
    st=$?
    grep '^fixpoint:' "$log"
    if [ $st != 0 ] || [ ! -f "$again" ]; then
      git worktree remove --force "$wt"; echo "the build failed (exit $st), see $log" >&2; exit 1
    fi
    xz -dc "$goseed" > "$TMPDIR/seed-verify.a.tar"; xz -dc "$again" > "$TMPDIR/seed-verify.b.tar"
    cmp -s "$TMPDIR/seed-verify.a.tar" "$TMPDIR/seed-verify.b.tar"; same=$?
    rm -f "$TMPDIR/seed-verify.a.tar" "$TMPDIR/seed-verify.b.tar"
    if [ $same = 0 ]; then
      echo "printed again at $rev: the same tree, byte for byte ($(xz -dc "$again" | sha256sum | cut -d' ' -f1), the tar)"
      if cmp -s "$goseed" "$again"; then echo "and the same archive: $(sha256sum "$again" | cut -d' ' -f1)"
      else echo "the archives differ (xz $(xz --version | head -1 | cut -d' ' -f4)): the tree is what counts"; fi
      # the seed's executable rebuilds itself: stage 0 = G1 = G2 = G3
      if cmp -s "$s0/$h/arbace" "$fp/g1/amd64/arbace" && cmp -s "$fp/g1/amd64/arbace" "$fp/g2/amd64/arbace" \
         && cmp -s "$fp/g2/amd64/arbace" "$fp/g3/amd64/arbace"; then
        echo "stage 0 = G1 = G2 = G3, byte for byte: $(sha256sum < "$s0/$h/arbace" | cut -c1-64)"
      else
        st=1; echo "stage 0, G1, G2, G3 are not all identical (log $log)" >&2
      fi
    else
      st=1; echo "printed again at $rev: the trees differ" >&2
      rm -rf "$root/.tmp/seed-verify-diff"; mkdir -p "$root/.tmp/seed-verify-diff/a" "$root/.tmp/seed-verify-diff/b"
      xz -dc "$goseed" | tar -C "$root/.tmp/seed-verify-diff/a" -xf -; xz -dc "$again" | tar -C "$root/.tmp/seed-verify-diff/b" -xf -
      diff -rq "$root/.tmp/seed-verify-diff/a" "$root/.tmp/seed-verify-diff/b" | head -20 >&2
    fi
    echo "   in $(( $(date +%s) - t0 )) s"
    git worktree remove --force "$wt"
    exit $st ;;
  *) echo "usage: bin/seed --check | --make [ARCHIVE] | --build [-o DIR] [--arch A,B] | --verify [REV]" >&2; exit 2 ;;
esac

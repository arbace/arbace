#!/bin/bash
# j2g's unit tests (test/j2g/unit.ae, doc/go/J2G-SPEC.md): each over a small fixture of test/j2g/unit/
# or a function alone, with the edge and no JDK forms: seconds, light. Prints each test's name with
# pass or FAIL; the status is 1 when one failed.
#
# Usage: bin/j2g-unit
# Environment: J2G_UNIT_EXE, the executable that runs them (default: the gate's build at the checkout's
# key, bin/lib/gate-cache.bash, when it exists, as bin/java-check's compiled level hosts j2g: its
# arbace.classes.* are the checkout's; else the tools' host, bin/lib/host.bash, whose analysis is the
# seed's); j2g's namespaces load from the checkout when they differ from the embedded ones
# (RT.toolSource). J2G_UNIT_SOURCES: namespaces loaded from the checkout first (arbace_tool -s, in
# order), for an executable whose analysis is older than the checkout's. J2G_UNIT_PLATFORM, J2G_UNIT_OUTSIDE_CLASSES:
# test-outside's sources (A8, A8b; default the checkout's bin/repr-java platform-dir, else the main checkout's at
# the same pin, and the toy jar org.example:toyext:1.0 unpacked into TMPDIR).
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash" # TMPDIR: .tmp/tmp when unset
. "$root/bin/lib/renamed-env.bash"
. "$root/bin/lib/tools.bash"
. "$root/bin/lib/gate-cache.bash"
cd "$root"
if [ -z "${J2G_UNIT_EXE:-}" ]; then
  g=$(arbace_gate_cache "$root") || g=
  [ -n "$g" ] && [ -x "$g/amd64/arbace" ] && J2G_UNIT_EXE=$g/amd64/arbace
fi
[ -z "${J2G_UNIT_EXE:-}" ] || export ARBACE_HOST_EXE=$J2G_UNIT_EXE
# A8, A8b (test-outside): the platform's exploded modules (bin/repr-java platform-dir: the checkout's, else the
# main checkout's at the same pin) and the binary-only toy jar org.example:toyext:1.0 unpacked
if [ -z "${J2G_UNIT_PLATFORM:-}" ]; then
  for d in "$root/.tmp/repr-java-platform" "${root%%/.tmp/*}/.tmp/repr-java-platform"; do
    if cmp -s "$root/jdk/javac/platform.sha256" "$d/.pin"; then J2G_UNIT_PLATFORM=$d; break; fi
  done
fi
if [ -z "${J2G_UNIT_OUTSIDE_CLASSES:-}" ]; then
  J2G_UNIT_OUTSIDE_CLASSES=$TMPDIR/j2g-unit-toyext
  rm -rf "$J2G_UNIT_OUTSIDE_CLASSES"; mkdir -p "$J2G_UNIT_OUTSIDE_CLASSES"
  unzip -q "$root/test/programs/java-project/maven/org/example/toyext/1.0/toyext-1.0.jar" -d "$J2G_UNIT_OUTSIDE_CLASSES"
fi
export J2G_UNIT_PLATFORM=${J2G_UNIT_PLATFORM:-} J2G_UNIT_OUTSIDE_CLASSES
srcs=()
for n in ${J2G_UNIT_SOURCES:-}; do srcs+=(-s "$n"); done
arbace_tool ${srcs[@]+"${srcs[@]}"} -p "$root/test" -m j2g.unit "$@"

#!/bin/bash
# repr/llvm, LLVM IR's bridge (doc/cpp/LLVM.md; doc/cpp/CPP-SURVEY.md §5.2, "As built: CX6"): LLVM IR text as LLVM forms
# and back, arbace.repr.llvm on the tools' host (evaluated from the checkout). The judges are clang as the assembler and
# LLVM 23's llvm-as.
#
#   bin/repr-llvm read [--full] FILE.ll [-o OUT.ae]   FILE's LLVM forms as .ae text; --full: mode :full, the text's
#                                              layer kept in the .ae's last line (comments, blank lines, spacing, spellings)
#   bin/repr-llvm print [--full] FILE.ae [-o OUT.ll]  the forms printed as IR; --full: with the layer, the original text
#                                              byte for byte
#   bin/repr-llvm verify FILE.ll|FILE.ae...    LLVM 23's LLParser checks and Verifier rules over the forms
#                                              (arbace.repr.llvm.verify): what `opt -passes=verify` prints to stderr for
#                                              each file, line for line (LLParser's error with file:line:col, the source
#                                              line and its caret; the Verifier's every message with the values it
#                                              prints; the debug info's warnings), or nothing; exit 1 when one is invalid
#   bin/repr-llvm verify-check LIST WORK       verify against opt -passes=verify (REPR_LLVM_OPT, default
#                                              /usr/lib/llvm23/bin/opt) on each NAME<tab>PATH.ll of LIST: the same
#                                              verdict and, for a rejection, the same first message (WORK/verify.tsv),
#                                              and the whole of opt's stderr (WORK/full.tsv; opt's in WORK/opt/NAME.log,
#                                              verify's in WORK/arb/NAME.err); REPR_LLVM_KNOWN names a file of the known
#                                              differences, counted apart; exit 1 on a different verdict
#   bin/repr-llvm mutants LIST OUT [N [FIRST [FAMILY]]] N mutants (default 300; the FIRST-th on, default 0) of LIST's
#                                              modules, each one change meant to be invalid, into OUT/, OUT/mutants.list;
#                                              FAMILY: base, attrs, cc, musttail, bundles, ... (arbace.repr.llvm.mutate/families)
#   bin/repr-llvm roundtrip LIST WORK          each NAME<tab>PATH.ll of LIST: read, the .ae text read back equal, printed,
#                                              read again equal (WORK/forms/NAME.ae, WORK/print/NAME.ll); clang -c of the
#                                              print against clang -c of the original, for the module's own target triple
#                                              (COFF without its time stamp), byte for byte (WORK/objects.tsv), and llvm-as's
#                                              bitcode of both, module summaries included (WORK/bitcode.tsv; REPR_LLVM_AS,
#                                              default /usr/lib/llvm23/bin/llvm-as, the judge skipped when it is missing);
#                                              WORK/rt.tsv. A judge is `same`, `differs` (the print's output differs or the
#                                              print does not build where the original does) or `none` (the original does
#                                              not build: a target the back end does not take). Exit 1 unless every file's
#                                              forms are equal, no judge differs, and each file has one judge `same`
#   bin/repr-llvm list hw|probes|runtime|all   the lists of the records (NAME<tab>PATH): the hand-written modules, the probes, C++'s lowered runtime's IR
#   bin/repr-llvm record-orig LIST | verify-orig LIST [--sample N]   ORS12 (a), by hand on a host with clang and llvm-as: the originals' `clang -c` and llvm-as
#                                              digests (test/llvm/records/roundtrip-orig.tsv); the round trip reads them, the print's half (class D) is
#                                              REPR_LLVM_LIVE=1, the oracle tier's
#   bin/repr-llvm record-opt LIST | verify-opt LIST [--sample N]     opt -passes=verify's answers (the pack llvm-opt-verify), which verify-check reads
#   bin/repr-llvm roundtrip --text LIST WORK   mode :full's round trip: each file read in :full, its .ae text read
#                                              back (forms and layer equal, the forms the plain mode's), printed back
#                                              byte for byte, and the plain print read in :full without a layer
#                                              (WORK/full/NAME.ae, WORK/text.tsv); exit 1 unless every file is ok
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash"
. "$root/bin/lib/tools.bash"
. "$root/test/oracle-records/oracle.bash"
. "$root/test/oracle-records/cpp.bash"
. "$root/test/oracle-records/llvm.bash"
export GOMAXPROCS=${GOMAXPROCS:-4} GOMEMLIMIT=${GOMEMLIMIT:-1500MiB}

# judge NAME ORIG PRINT CMD...: CMD ORIG ORIG-OUT, CMD PRINT PRINT-OUT, the verdict on the two outputs
judge() {
  local o=$1 a=$2 b=$3; shift 3
  if ! "$@" "$a" -o "$o.orig" 2> "$o.log"; then echo none
  elif [ -f "$b" ] && "$@" "$b" -o "$o.print" 2>> "$o.log" && cmp -s "$o.orig" "$o.print"; then echo same
  else echo differs; fi
}

record_orig() { # record-orig LIST: the record rewritten for LIST's modules (the others' rows kept)
  local list; list=$(lrr_listfile "$1"); local n p key d tmp=$TMPDIR/lrr-orig.$$
  command -v clang > "$TMPDIR/lrr.err" && [ -x "${REPR_LLVM_AS:-/usr/lib/llvm23/bin/llvm-as}" ] || { echo "record-orig: needs clang and llvm-as" >&2; exit 2; }
  mkdir -p "$(dirname "$lrr_orig")"
  [ -f "$lrr_orig" ] && grep -v '^;;' "$lrr_orig" > "$tmp.old" || : > "$tmp.old"
  while IFS=$'\t' read -r n p; do
    [ -n "$n" ] || continue
    printf '%s\t%s\t%s\n' "$n" "$(lrr_key "$p")" "$(lrr_orig_digests "$p")"
  done < "$list" > "$tmp.new"
  awk -F'\t' 'NR == FNR { new[$1] = 1; next } !($1 in new)' "$tmp.new" "$tmp.old" | cat - "$tmp.new" | LC_ALL=C sort -t "$(printf '\t')" -k1,1 > "$tmp.all"
  { echo ";; The round trip's originals as records (doc/ORACLE-RECORDS-SURVEY.md, ORS12): NAME<TAB>KEY<TAB>OBJECT<TAB>BITCODE, the SHA-256 of clang -c's object for the module's own triple"
    echo ";; and of llvm-as's bitcode, none when the original does not build (test/oracle-records/llvm.bash)."
    oracle_record_header ';;' llvm 'bin/repr-llvm record-orig LIST' 
    cat "$tmp.all"; } > "$lrr_orig"
  rm -f "$tmp".*
  echo "record-orig: $(grep -vc '^;;' "$lrr_orig") modules in $lrr_orig"
}
verify_orig() { # verify-orig LIST [--sample N]
  local list; list=$(lrr_listfile "$1"); local n=0 bad=0 want got p name k=0 sample=${3:-}
  [ "${2:-}" = --sample ] || sample=
  while IFS=$'\t' read -r name p; do
    [ -n "$name" ] || continue
    k=$((k+1)); [ -z "$sample" ] || [ $((k % sample)) = 1 ] || continue
    n=$((n+1)); want=$(lrr_orig_get "$name" "$p" 2>"$TMPDIR/lrr.err") || { bad=$((bad+1)); continue; }
    got=$(lrr_orig_digests "$p"); [ "$got" = "$want" ] || bad=$((bad+1))
  done < "$list"
  oracle_verdict llvm "$lrr_orig" "$bad" "$n" || return 1
  # ORS7 (a), the crossed pair: one module's live digests against another's record, which must differ
  local a b ra rb pa
  a=$(awk -F'\t' '!/^;;/ && $3 != "none" {print $1; exit}' "$lrr_orig"); b=$(awk -F'\t' -v a="$a" '!/^;;/ && $3 != "none" && $1 != a {print $1; exit}' "$lrr_orig")
  pa=$(awk -F'\t' -v n="$a" '$1 == n {print $2}' "$list")
  if [ -n "$a" ] && [ -n "$b" ] && [ -f "$pa" ]; then
    got=$(lrr_orig_digests "$pa"); want=$(awk -F'\t' -v n="$b" '$1 == n {print $3 "\t" $4}' "$lrr_orig")
    if [ "$got" = "$want" ]; then echo "verify: FAILED: the crossed pair ($a live, $b recorded) is equal: the verify is blind"; return 1; fi
    echo "verify: the crossed pair ($a live against $b's record) differs, as a control must"
  fi
}
opt_live() { # NAME FILE DIR: opt -passes=verify -disable-output into DIR/log, DIR/rc
  local opt=${REPR_LLVM_OPT:-/usr/lib/llvm23/bin/opt}
  local rc=0
  "$opt" -passes=verify -disable-output "$2" > "$3/log" 2>&1 || rc=$?
  echo "$rc" > "$3/rc"
}
record_opt() { # record-opt LIST
  local list; list=$(lrr_listfile "$1"); local n p st=$root/.tmp/repr-llvm/record-opt d
  [ -x "${REPR_LLVM_OPT:-/usr/lib/llvm23/bin/opt}" ] || { echo "record-opt: needs opt" >&2; exit 2; }
  rm -rf "$st"; mkdir -p "$st/llvm-opt-verify"; : > "$st/ids.tsv"
  while IFS=$'\t' read -r n p; do
    [ -n "$n" ] || continue
    d=$st/llvm-opt-verify/$n; mkdir -p "$d"; opt_live "$n" "$p" "$d"
    # the module's own path in opt's messages: the file as named (a message names no directory but the file's name as given)
    lrr_norm "$d/log"
    printf '%s/rc\t%s\n%s/log\t%s\n' "$n" "$(lrr_key "$p")" "$n" "$(lrr_key "$p")" >> "$st/ids.tsv"
  done < "$list"
  oracle_make "$lrr_opt_pin" "$st" "$st/ids.tsv" "bin/repr-llvm record-opt LIST" llvm
}
verify_opt() { # verify-opt LIST [--sample N]
  local list; list=$(lrr_listfile "$1"); local n=0 bad=0 name p k=0 d=$root/.tmp/repr-llvm/verify-opt sample=${3:-}
  [ "${2:-}" = --sample ] || sample=
  mkdir -p "$d"
  while IFS=$'\t' read -r name p; do
    [ -n "$name" ] || continue
    k=$((k+1)); [ -z "$sample" ] || [ $((k % sample)) = 1 ] || continue
    n=$((n+1)); opt_live "$name" "$p" "$d"; lrr_norm "$d/log"
    cmp -s "$d/log" "$(oracle_get "$lrr_opt_pin" "$name/log" 2>"$TMPDIR/lrr.err")" && cmp -s "$d/rc" "$(oracle_get "$lrr_opt_pin" "$name/rc" 2>"$TMPDIR/lrr.err")" || bad=$((bad+1))
  done < "$list"
  oracle_verdict llvm "$(oracle_manifest "$lrr_opt_pin")" "$bad" "$n" || return 1
  # ORS7 (a), the crossed pair: the first module that opt rejects, its live answer against the record of the first valid one: must differ
  local a b pa
  a=$(awk -F'\t' '!/^#/ && $1 ~ /\/rc$/ && $3 != "'"$(printf '0\n' | sha256sum | cut -c1-64)"'" {sub(/\/rc$/, "", $1); print $1; exit}' "$(oracle_manifest "$lrr_opt_pin")")
  b=$(awk -F'\t' '!/^#/ && $1 ~ /\/rc$/ && $3 == "'"$(printf '0\n' | sha256sum | cut -c1-64)"'" {sub(/\/rc$/, "", $1); print $1; exit}' "$(oracle_manifest "$lrr_opt_pin")")
  pa=$(awk -F'\t' -v n="$a" '$1 == n {print $2}' "$list")
  if [ -n "$a" ] && [ -n "$b" ] && [ -f "$pa" ]; then
    opt_live "$a" "$pa" "$d"; lrr_norm "$d/log"
    if cmp -s "$d/log" "$(oracle_get "$lrr_opt_pin" "$b/log")"; then echo "verify: FAILED: the crossed pair ($a live, $b recorded) is equal: the verify is blind"; return 1; fi
    echo "verify: the crossed pair ($a live against $b's record) differs, as a control must"
  fi
}

case ${1:-} in
  list) lrr_list "${2:-all}" ;;
  record-orig) record_orig "$2" ;;
  verify-orig) shift; verify_orig "$@" ;;
  record-opt) record_opt "$2" ;;
  verify-opt) shift; verify_opt "$@" ;;
  read|print|verify) arbace_tool -m arbace.repr.llvm "$@" ;;
  roundtrip)
    if [ "${2:-}" = --text ]; then
      list=$(lrr_listfile "$3") work=$4
      mkdir -p "$work"; work=$(cd "$work" && pwd)
      REPR_LLVM_THREADS=${REPR_LLVM_THREADS:-4} arbace_tool -m arbace.repr.llvm rt-text "$list" "$work"
      nf=$(wc -l < "$work/text.tsv"); nok=$(cut -f2 "$work/text.tsv" | grep -c '^ok$' || true)
      echo "roundtrip --text: $nok of $nf printed back byte for byte"
      [ "$nf" -gt 0 ] && [ "$nok" = "$nf" ] && [ "$nf" = "$(grep -c . "$list")" ]
      exit
    fi
    list=$(lrr_listfile "$2") work=$3
    mkdir -p "$work"; work=$(cd "$work" && pwd)
    REPR_LLVM_THREADS=${REPR_LLVM_THREADS:-4} arbace_tool -m arbace.repr.llvm rt "$list" "$work"
    llvm_as=${REPR_LLVM_AS:-/usr/lib/llvm23/bin/llvm-as}
    [ -x "$llvm_as" ] || llvm_as=
    : > "$work/objects.tsv"; : > "$work/bitcode.tsv"
    if ! lrr_live; then
      # ORS12 (a): no clang or llvm-as. The originals' objects and bitcode are the records' (test/llvm/records/roundtrip-orig.tsv, found and not stale: `skipped`,
      # else `unrecorded`); the print's half, clang -c and llvm-as on Arbace's own output (class D), is REPR_LLVM_LIVE=1, the oracle tier's; the substitute
      # here is the native verifier (arbace.repr.llvm.verify, LLVM 23's LLParser and Verifier rules): each print must be as valid as opt found the original
      : > "$work/print-verify.list"; rec_bad=0
      while IFS=$'\t' read -r n p; do
        [ -n "$n" ] || continue
        if lrr_orig_get "$n" "$p" > /dev/null 2> "$work/orig-record.err"; then v=skipped; else v=$(head -c 9 "$work/orig-record.err" | tr -d ':'); rec_bad=$((rec_bad+1)); fi
        printf '%s\t%s\n' "$n" "$v" >> "$work/objects.tsv"; printf '%s\t%s\n' "$n" "$v" >> "$work/bitcode.tsv"
        [ -f "$work/print/$n.ll" ] && printf '%s\t%s\n' "$n" "$work/print/$n.ll" >> "$work/print-verify.list"
      done < "$list"
      mkdir -p "$work/print-verify"
      REPR_LLVM_THREADS=${REPR_LLVM_THREADS:-4} arbace_tool -m arbace.repr.llvm verify-list "$work/print-verify.list" "$work/print-verify.tsv" "$work/print-verify"
      pv_bad=0
      while IFS=$'\t' read -r n v m; do
        d=$work/pv; mkdir -p "$d"; lrr_opt_get "$n" "$work/print/$n.ll" "$d" 2>/dev/null || continue
        if [ "$(cat "$d/rc")" = 0 ]; then want=valid; else want=invalid; fi
        got=$v; [ "$got" = valid ] || got=invalid
        if [ "$want" != "$got" ]; then pv_bad=$((pv_bad+1)); printf '%s\tdiffers\n' "$n" >> "$work/objects.tsv"; fi
      done < "$work/print-verify.tsv"
      nf=$(wc -l < "$work/rt.tsv"); nok=$(cut -f2 "$work/rt.tsv" | grep -c '^ok$' || true)
      echo "roundtrip: $nok of $nf forms equal; records mode: $((nf - rec_bad)) originals' objects and bitcode recorded ($rec_bad not), $pv_bad prints the native verifier judges otherwise than opt the original; the print's objects and bitcode are the oracle tier's"
      [ "$nf" -gt 0 ] && [ "$nok" = "$nf" ] && [ "$rec_bad" = 0 ] && [ "$pv_bad" = 0 ] && [ "$nf" = "$(grep -c . "$list")" ]
      exit
    fi
    while IFS=$'\t' read -r n p; do
      [ -n "$n" ] || continue
      mkdir -p "$work/obj/$(dirname "$n")"
      tr=$(sed -n '/^target triple = /{s/^target triple = "\(.*\)"$/\1/p;q;}' "$p")
      printf '%s\t%s\n' "$n" "$(judge "$work/obj/$n.o" "$p" "$work/print/$n.ll" \
        clang -c -mno-incremental-linker-compatible ${tr:+-target "$tr"})" >> "$work/objects.tsv"
      if [ -n "$llvm_as" ]; then
        printf '%s\t%s\n' "$n" "$(judge "$work/obj/$n.bc" "$p" "$work/print/$n.ll" "$llvm_as")" >> "$work/bitcode.tsv"
      fi
    done < "$list"
    nf=$(wc -l < "$work/rt.tsv"); nok=$(cut -f2 "$work/rt.tsv" | grep -c '^ok$' || true)
    no=$(wc -l < "$work/objects.tsv"); nsame=$(grep -c '	same$' "$work/objects.tsv" || true)
    nb=$(wc -l < "$work/bitcode.tsv"); nbsame=$(grep -c '	same$' "$work/bitcode.tsv" || true)
    echo "roundtrip: $nok of $nf forms equal, $nsame of $no objects equal${llvm_as:+, $nbsame of $nb bitcode equal}"
    # a check: every form equal, no judge differing, and every file judged same by one of them (review 007's finding 11)
    judged=$(cat "$work/objects.tsv" "$work/bitcode.tsv" | awk -F'\t' '$2 == "same" { print $1 }' | sort -u | wc -l)
    [ "$nf" -gt 0 ] && [ "$nok" = "$nf" ] && awk -F'\t' '$2 == "differs" { d = 1 } END { exit d }' "$work/objects.tsv" "$work/bitcode.tsv" \
      && [ "$no" = "$(grep -c . "$list")" ] && [ "$judged" = "$no" ] ;;
  mutants)
    list=$2 out=$3
    mkdir -p "$out"; out=$(cd "$out" && pwd)
    arbace_tool -m arbace.repr.llvm.mutate "$list" "$out" "${4:-300}" "${5:-0}" ${6:+"$6"} ;;
  verify-check)
    list=$(lrr_listfile "$2") work=$3
    mkdir -p "$work/opt"; work=$(cd "$work" && pwd)
    opt=${REPR_LLVM_OPT:-/usr/lib/llvm23/bin/opt}
    ! lrr_live && { oracle_unpack "$lrr_opt_pin" > "$TMPDIR/lrr-unpack.out" || exit 1; }
    rm -rf "$work/arb"; mkdir -p "$work/arb"
    REPR_LLVM_OPT=$opt REPR_LLVM_THREADS=${REPR_LLVM_THREADS:-4} arbace_tool -m arbace.repr.llvm verify-list "$list" "$work/arbace.tsv" "$work/arb"
    # opt's verdict and first message: the first line that is not a warning, without its program and position
    : > "$work/opt.tsv"
    while IFS=$'\t' read -r n p; do
      [ -n "$n" ] || continue
      if ! lrr_live; then
        # ORS12 (a): opt's answer from the pack llvm-opt-verify (a module not in it is UNRECORDED: the check fails)
        mkdir -p "$work/opt/$n.d"
        if lrr_opt_get "$n" "$p" "$work/opt/$n.d" 2> "$work/opt/$n.rec"; then cp "$work/opt/$n.d/log" "$work/opt/$n.log"; orc=$(cat "$work/opt/$n.d/rc")
        else cp "$work/opt/$n.rec" "$work/opt/$n.log"; orc=99; fi
      else orc=0; ( "$opt" -passes=verify -disable-output "$p"; ) > "$work/opt/$n.log" 2>&1 || orc=$?; fi
      if [ "$orc" = 0 ]; then
        # opt takes a module whose debug info is broken: it prints the message, then warns and strips the debug info (the
        # verdict `debug`, the message its first line); a debug info version it does not know is stripped with a warning only
        v=valid m=
        first=$(head -1 "$work/opt/$n.log")
        case $first in
          "warning: ignoring debug info with an invalid version"*) v=debug; m=$(printf '%s' "$first" | sed -E 's/^warning: //; s/ in [^ ]*$//') ;;
          "") ;;
          "warning: "*) ;;
          *) v=debug; m=$first ;;
        esac
      else
        v=invalid
        m=$(awk '/error: input module is broken/ { next } { sub(/^[^ ]*opt: /, "") } /^warning: / { next } { if (sub(/^[^ ]*:[0-9]+:[0-9]+: error: /, "") || sub(/^[^ ]*: error: /, "")) { print; exit } print; exit }' "$work/opt/$n.log")
      fi
      printf '%s\t%s\t%s\n' "$n" "$v" "$m" >> "$work/opt.tsv"
    done < "$list"
    # the verdicts side by side: NAME, opt's, Arbace's, same-verdict, same-message, opt's message, Arbace's
    awk -F'\t' 'NR == FNR { v[$1] = $2; m[$1] = $3; next }
      { sv = (v[$1] == $2) ? "same" : "differs"; sm = (v[$1] == "valid" && $2 == "valid") ? "-" : (m[$1] == $3 ? "same" : "differs")
        print $1 "\t" v[$1] "\t" $2 "\t" sv "\t" sm "\t" m[$1] "\t" $3 }' "$work/opt.tsv" "$work/arbace.tsv" > "$work/verify.tsv"
    # the whole of opt's stderr against what verify prints (WORK/full.tsv: NAME, same or differs)
    : > "$work/full.tsv"
    while IFS=$'\t' read -r n p; do
      [ -n "$n" ] || continue
      if cmp -s "$work/opt/$n.log" "$work/arb/$n.err"; then f=same; else f=differs; fi
      printf '%s\t%s\n' "$n" "$f" >> "$work/full.tsv"
    done < "$list"
    n=$(wc -l < "$work/verify.tsv")
    sv=$(awk -F'\t' '$4 == "same"' "$work/verify.tsv" | wc -l)
    ninv=$(awk -F'\t' '$2 == "invalid" || $2 == "debug"' "$work/verify.tsv" | wc -l)
    sm=$(awk -F'\t' '($2 == "invalid" || $2 == "debug") && $5 == "same"' "$work/verify.tsv" | wc -l)
    nf=$(grep -c '	same$' "$work/full.tsv" || true)
    # the names of a known file (REPR_LLVM_KNOWN: NAME<tab>CLASS<tab>reason) that differ are counted apart
    nk=0
    if [ -n "${REPR_LLVM_KNOWN:-}" ] && [ -f "$REPR_LLVM_KNOWN" ]; then
      nk=$(awk -F'\t' 'NR == FNR { k[$1] = 1; next } $2 == "differs" && ($1 in k)' "$REPR_LLVM_KNOWN" "$work/full.tsv" | wc -l)
    fi
    echo "verify-check: $sv of $n verdicts as opt's; $sm of $ninv rejections with opt's first message; $nf of $n whole stderr equal${REPR_LLVM_KNOWN:+ ($nk more differ in the known classes)}"
    [ "$n" -gt 0 ] && [ "$sv" = "$n" ] ;;
  *) sed -n '2,/^set -e/p' "$0" | sed '$d;s/^# \{0,1\}//' >&2; exit 2 ;;
esac

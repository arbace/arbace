#!/bin/bash
# repr/llvm, LLVM IR's bridge (doc/cpp/LLVM.md; doc/cpp/CPP-SURVEY.md §5.2, "As built: CX6"): LLVM IR text as LLVM forms
# and back, arbace.repr.llvm on the tools' host (evaluated from the checkout). The judge is clang as the assembler.
#
#   bin/repr-llvm read FILE.ll [-o OUT.ae]     FILE's LLVM forms as .ae text
#   bin/repr-llvm print FILE.ae [-o OUT.ll]    the forms printed as IR
#   bin/repr-llvm roundtrip LIST WORK          each NAME<tab>PATH.ll of LIST: read, the .ae text read back equal, printed,
#                                              read again equal (WORK/forms/NAME.ae, WORK/print/NAME.ll), and clang -c of the
#                                              print equal byte for byte to clang -c of the original (WORK/rt.tsv, WORK/objects.tsv);
#                                              exit 1 unless every file's forms are equal and its objects the same, and every
#                                              negative control (test/repr/llvm/roundtrip-controls.txt, REPR_LLVM_CONTROLS; GT9,
#                                              doc/GATE-SURVEY.md, "As built: GT9's controls") fails as it must: a line `ID SUBJECT
#                                              REFERENCE` (names of LIST, both round-tripping) crosses the SUBJECT's print with the
#                                              REFERENCE's original, the forms read again against the original's forms (arbace.repr.llvm
#                                              control) and the objects (cmp); either the same is `control passed`, a control whose
#                                              names LIST lacks is left
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash"
. "$root/bin/lib/tools.bash"
export GOMAXPROCS=${GOMAXPROCS:-4} GOMEMLIMIT=${GOMEMLIMIT:-1500MiB}

case ${1:-} in
  read|print) arbace_tool -m arbace.repr.llvm "$@" ;;
  roundtrip)
    list=$2 work=$3
    mkdir -p "$work"; work=$(cd "$work" && pwd)
    REPR_LLVM_THREADS=${REPR_LLVM_THREADS:-4} arbace_tool -m arbace.repr.llvm rt "$list" "$work"
    while IFS=$'\t' read -r n p; do
      mkdir -p "$work/obj/$(dirname "$n")"
      if clang -c "$p" -o "$work/obj/$n.orig.o" 2> "$work/obj/$n.log" && [ -f "$work/print/$n.ll" ] \
         && clang -c "$work/print/$n.ll" -o "$work/obj/$n.print.o" 2>> "$work/obj/$n.log"; then
        if cmp -s "$work/obj/$n.orig.o" "$work/obj/$n.print.o"; then echo "$n	same"; else echo "$n	differs"; fi
      else echo "$n	none"; fi
    done < "$list" > "$work/objects.tsv"
    nf=$(wc -l < "$work/rt.tsv"); nok=$(cut -f2 "$work/rt.tsv" | grep -c '^ok$' || true)
    no=$(wc -l < "$work/objects.tsv"); nsame=$(grep -c '	same$' "$work/objects.tsv" || true)
    echo "roundtrip: $nok of $nf forms equal, $nsame of $no objects equal"
    # a check: every form equal and every object the same, else exit 1 (review 007's finding 11)
    ctl=0
    controls=${REPR_LLVM_CONTROLS:-$root/test/repr/llvm/roundtrip-controls.txt}
    if [ -f "$controls" ]; then
      while read -r cid csub cref _; do
        case $cid in ''|'#'*) continue ;; esac
        cpath=$(awk -F'\t' -v n="$cref" '$1 == n {print $2; exit}' "$list")
        if [ -z "$cpath" ] || ! grep -q "^$csub	" "$list"; then echo "control $cid left: $csub or $cref is not in the list"; continue; fi
        if ! grep -q "^$csub	same\$" "$work/objects.tsv" || ! grep -q "^$cref	same\$" "$work/objects.tsv"; then echo "control $cid left: $csub or $cref did not round-trip"; continue; fi
        cf=$(arbace_tool -m arbace.repr.llvm control "$work" "$csub" "$cpath" 2>/dev/null | tail -1)
        if [ -f "$work/obj/$csub.print.o" ] && [ -f "$work/obj/$cref.orig.o" ]; then
          if cmp -s "$work/obj/$csub.print.o" "$work/obj/$cref.orig.o"; then co=same; else co=differs; fi
        else co=none; fi
        if [ "$cf" = differs ] && [ "$co" = differs ]; then echo "control $cid fails as it must (forms and objects differ)"
        elif [ "$cf" != same ] && [ "$cf" != differs ] || [ "$co" = none ]; then echo "control not judged: $cid ($csub against $cref: forms $cf, objects $co)"; ctl=1
        else echo "control passed: $cid ($csub against $cref): forms $cf, objects $co"; ctl=1; fi
      done < "$controls"
    fi
    [ "$ctl" = 0 ] && [ "$nf" -gt 0 ] && [ "$nok" = "$nf" ] && [ "$nsame" = "$no" ] && [ "$no" = "$(grep -c . "$list")" ] ;;
  *) sed -n '2,/^set -e/p' "$0" | sed '$d;s/^# \{0,1\}//' >&2; exit 2 ;;
esac

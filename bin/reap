#!/bin/bash
# The REAP matrix (doc/FULL-SUPPORT-SURVEY.md, REAP1, RPS13): read, eval, AOT and print for
# Clojure, Java and Go, each cell judged from its checks' recorded results and its classes alone
# (no runs; seconds): every non-pass of a cell's references falls into a class of its classes
# file (test/goi/divergences.edn's format, RPS3), by design or deferred and where decided. The
# cells and their sources are data, test/reap/cells.edn; the reading and judging is the namespace
# reap.main (test/reap/main.ae), on the tools' host.
#
# Usage: bin/reap [--entries]
#          the matrix (pass / by design / deferred per cell), each cell's sources and its classes
#          with their counts (--entries: every non-pass under its class), and the classes whose
#          decision is pending (the user's). Fails on a non-pass no class takes, a class of
#          another kind, or a reference gone; a cell whose check is not recorded yet (Clojure AOT
#          until REAP3, Go AOT until REAP2, Java's until JC1, JC2, REAP5) prints "no check yet"
#        bin/reap record-native-check [REPORT]
#          test/repr/go/native-check-results.edn (Go's read level's numbers) written from bin/repr-go
#          native-check's report (default .tmp/repr-go/native-check.report.edn), after a run of
#          bin/repr-go native-check over every corpus (bin/gate --full's)
# Environment: ARBACE_HOST_EXE, the tools' host (bin/lib/host.bash; default stage 0).
# Exit status: 0 when every non-pass of every recorded check is in a class.
set -uo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash" # TMPDIR: .tmp/tmp when unset
. "$root/bin/lib/tools.bash"
cd "$root" || exit 1
case ${1:-} in
  ""|--entries) REAP_ROOT=$root arbace_tool -p "$root/test" -m reap.main "$@" ;;
  record-native-check)
    REAP_ROOT=$root arbace_tool -p "$root/test" -m reap.main record-native-check \
      "${2:-$root/.tmp/repr-go/native-check.report.edn}" "$root/test/repr/go/native-check-results.edn" ;;
  *) echo "usage: bin/reap [--entries] | record-native-check [REPORT]" >&2; exit 2 ;;
esac

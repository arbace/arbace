#!/bin/bash
# The REAP matrix (doc/FULL-SUPPORT-SURVEY.md, REAP1, RPS13): read, eval, AOT and print for
# Clojure, Java, Go and C (C's row since C8), each cell judged from its checks' recorded results and its classes alone
# (no runs; seconds): every non-pass of a cell's references falls into a class of its classes
# file (test/goi/divergences.edn's format, RPS3), by design or deferred and where decided. The
# cells and their sources are data, test/reap/cells.edn; the reading and judging is the namespace
# reap.main (test/reap/main.ae), on the tools' host.
#
# Usage: bin/reap [--record] [--entries]
#          the matrix (pass / by design / deferred per cell), each cell's sources and its classes
#          with their counts (--entries: every non-pass under its class), and the classes whose
#          decision is pending (the user's). Fails on a non-pass no class takes, a class of
#          another kind, a reference gone, a source's cases not those it must have (Java's
#          records against test/java/ref-jdk26.edn, goi's AOT level against its eval level), or
#          a difference from the matrix's record test/reap/matrix.edn (report 021's finding 1:
#          every change of a check's record is a change of the matrix, recorded on purpose);
#          --record writes test/reap/matrix.edn from the matrix when nothing else fails (after a
#          check's record changed; the diff shows what moved). Every file a source names must
#          exist (report 021's finding 3), but the record of a check not recorded yet (a source's
#          :until in test/reap/cells.edn: its cell prints "no check yet"; an :until whose record
#          exists is stale, a problem); a source of passes with no case, or an :include selecting
#          nothing, fails too
#        bin/reap record-native-check [REPORT]
#          test/repr/go/native-check-results.edn (Go's read level's numbers) written from bin/repr-go
#          native-check's report (default .tmp/repr-go/native-check.report.edn), after a run of
#          bin/repr-go native-check over every corpus (bin/gate --full's); refused (not written)
#          when the report lacks a corpus of bin/repr-go's native_corpora (report 021's finding 3)
# Environment: ARBACE_HOST_EXE, the tools' host (bin/lib/host.bash; default stage 0).
# Exit status: 0 when every non-pass of every recorded check is in a class and the matrix is
# test/reap/matrix.edn's (--record: once written).
set -uo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash" # TMPDIR: .tmp/tmp when unset
. "$root/bin/lib/tools.bash"
cd "$root" || exit 1
case ${1:-} in
  ""|--entries|--record) REAP_ROOT=$root arbace_tool -p "$root/test" -m reap.main "$@" ;;
  record-native-check)
    # bin/repr-go's native_corpora (every corpus of native-check), the report must have them all
    corpora=$(sed -n '/^native_corpora="/,/"$/p' "$root/bin/repr-go" | sed 's/^native_corpora=//' | tr -d '"' | tr -s ' \n' '  ')
    [ -n "${corpora// /}" ] || { echo "reap: no native_corpora in bin/repr-go" >&2; exit 1; }
    REAP_ROOT=$root arbace_tool -p "$root/test" -m reap.main record-native-check \
      "${2:-$root/.tmp/repr-go/native-check.report.edn}" "$root/test/repr/go/native-check-results.edn" "$corpora" ;;
  *) echo "usage: bin/reap [--record] [--entries] | record-native-check [REPORT]" >&2; exit 2 ;;
esac

#!/bin/bash
# The differential oracle for Arbace on Go (B1a, doc/go/ORACLE.md): corpora of forms, class
# scripts and regex cases under test/oracle/, their expected results recorded from the frozen
# JVM Arbace (below) in test/oracle/expected/, and a runner that checks any implementation
# against them. The runner (test/oracle/runner.ae) runs on the frozen JVM Arbace; each corpus file is one run of the implementation, fed the driver
# test/oracle/driver.ae and then the cases on its standard input.
#
# Usage: bin/oracle record [-j JOBS] [--timeout S] [--goi IMPL] [SEL...]
#            regenerate the expected files from the frozen JVM Arbace (and its JDK, for regex);
#            the output is byte-identical across runs (but for the noisy cases, ORACLE.md); the
#            files of Go forms (their first line ";; oracle: recorded by goi", forms/go.ae) from
#            the Go build IMPL with --goi, reviewed (doc/go/GOI-SPEC.md S54), else skipped
#        bin/oracle check IMPL [-j JOBS] [--timeout S] [--expected FILE | --write-expected FILE]
#                         [--exclude PART]... [SEL...]
#            run the expected files against IMPL, a shell command that evaluates the forms on
#            its standard input as `arbace.main -` does and lets them print to its standard
#            output; `jvm` stands for the frozen jar's `arbace.lang.Main -`. Reports the mismatches (all of them in
#            .tmp/oracle/check.txt); exit status 0 when every case matches, or with
#            --expected FILE when the mismatching cases are exactly those FILE records (a
#            reference of known mismatches with their reasons, e.g. test/oracle/known-go-amd64-frozen.edn);
#            --write-expected FILE rewrites FILE from this run's mismatches, keeping the
#            reasons of the cases still recorded (new ones get a placeholder reason)
#        bin/oracle harvest [SUITE]
#            regenerate test/oracle/forms/harvest/ from Clojure's test suite as bin/clojure-tests
#            renames it (default SUITE .tmp/clojure-tests/go/suite, CLOJURE_TESTS_GO's run)
#   SEL      parts (forms, classes, regex) or parts of file paths (forms/numbers); default all;
#            --exclude PART leaves out the files whose path holds PART (the box's subset,
#            doc/go/BOX-NOTES.md: --exclude forms/files. --exclude forms/processes., with
#            ARBACE_BOX_NET=loopback for forms/net)
#   -j JOBS  concurrent runs (default 16); --timeout S per run (default 300)
# The reference (doc/STANDALONE-NOTES.md, "S4: the oracle's reference", "S4: the JVM removed";
# the survey's D4): the frozen JVM Arbace, the jar of the frozen branch's last release, run by
# java alone (bin/lib/frozen.bash: built once from its tag into .tmp/oracle-frozen/TAG.jar and
# checked against its pinned hash, test/oracle/frozen-jar.sha256). The frozen jar reads .clj
# only, so the runner's namespaces are given to it as .clj links (frozen_view test).
# Environment:
#   ARBACE_ORACLE_TAG       the frozen release (default arbace-for-java-26-v4: v1, the seed's,
#                           still has the NaN comparisons that v2 fixed); FROZEN_TAG likewise
#   ARBACE_ORACLE_JAR       an already built frozen jar instead, unchecked; FROZEN_JAR likewise
#   ARBACE_ORACLE_EXPECTED  the expected files' directory (default test/oracle/expected): record
#                           writes there, check reads there
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash" # TMPDIR: .tmp/tmp when unset
cd "$root"
. bin/lib/frozen.bash
case ${ARBACE_ORACLE_REF:-frozen} in
  frozen) ;;
  *) echo "bin/oracle: the reference is the frozen jar only since S4 (ARBACE_ORACLE_REF=$ARBACE_ORACLE_REF)" >&2; exit 2 ;;
esac
jar=$(frozen_jar) || exit 1
view=$(frozen_view test) || exit 1
# as Arbace's jar ran: compact object headers; the reference keeps its messages under load
# (runner.ae's default-impl)
export ARBACE_ORACLE_JVM="java -XX:+UseCompactObjectHeaders -XX:-OmitStackTraceInFastThrow -cp $jar arbace.lang.Main -"
jvm() { java -XX:+UseCompactObjectHeaders -cp "$jar:$view:$root/test" arbace.lang.Main "$@"; }
cmd=${1:-}
case $cmd in
  record|check) shift ;;
  harvest)
    shift
    suite=${1:-$root/.tmp/clojure-tests/go/suite}
    jvm -m oracle.harvest "$suite"; exit ;;
  *) sed -n '8,30p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac
jvm -m oracle.runner "$cmd" "$@"

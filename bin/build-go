#!/bin/bash
# The program build (arbace.build.go, doc/go/BUILD.md): a Go program held as Go forms, printed by
# repr/go's printer into a module and built by Go's toolchain (TamaGo's go1.27.1) into a static
# executable. Until 2026-10-17 bin/g2a build (arbace.g2a.build).
#
#   bin/build-go [--arch amd64|arm64] [--goos linux|tamago|darwin] [-o OUT] [--overlay FILE]
#                [--root ROOT]... [OPTIONS] DIR
#                        build the program DIR into a static linux/ARCH executable, or with
#                        --goos tamago a box guest (TamaGo's goos module as GOOSPKG, from Go's
#                        module cache; doc/go/BOX-NOTES.md); --root adds another source root's
#                        packages (the box's, box/); --goos-dir DIR takes the goos module from
#                        DIR (printed from tamago/: bin/tamago-vendor) instead of the module
#                        cache. The options: arbace.build.go's
#   bin/build-go --print-only --work W [--tests] [--module PATH] DIR
#                        print DIR's module into W/mod without building (a library; --tests
#                        with its _test files), as bin/jrt does; --module std: the standard
#                        library at GOROOT/src's paths
#   bin/build-go test [--arch amd64|arm64]... [PROG...]
#                        the build's tests (bin/lib/build-go/test): the programs of
#                        test/build/go built, checked static, reproducible and run
#
# Environment: ARBACE_GOROOT, the TamaGo Go tree (default /root/tamago-go); REPR_GO_EXE, the Go
# executable that runs arbace.build.go (bin/lib/repr-go-host.bash: default the tools' host).
set -euo pipefail
export CGO_ENABLED=0 # Go's builds never use cgo (doc/go/BOX-NOTES.md, "... cgo dropped", 2026-10-16)
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash" # TMPDIR: .tmp/tmp when unset
. "$root/bin/lib/renamed-env.bash" # stops on a stale G2A_*, J2A_*, A2G_* or C2A_*
case ${1:-} in
  test) shift; exec "$root/bin/lib/build-go/test" "$@" ;;
  ""|-h|--help) sed -n '2,/^set -/p' "$0" | sed '$d; s/^# \{0,1\}//' >&2; exit 2 ;;
esac
. "$root/bin/lib/repr-go-host.bash"
repr_go_exec arbace.build.go "$@"

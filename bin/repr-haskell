#!/bin/bash
# repr/haskell, Haskell's bridge (doc/haskell/SPEC.md, doc/haskell/HASKELL-NOTES.md): Haskell
# modules as Haskell forms (read) and Haskell forms as Haskell modules (print), through the
# helper tools/hsdump on the host's GHC (Alpine's ghc 9.14.1, pinned by tools/hsdump/GHC_VERSION;
# SPEC §8, HS9). The converter and the printer are Arbace (arbace.repr.haskell, .convert,
# .print), evaluated from the checkout: repr/haskell is not one of the tools the executable
# embeds (arbace/j2g/embed.ae's excluded list).
#
#   bin/repr-haskell helper       build the helper into .tmp/hsdump/hsdump (the host's ghc; rebuilt
#                                 when its sources, its pin or the ghc library's unit change)
#   bin/repr-haskell corpus fetch [CORPUS]
#                                 the corpus's tarball into .tmp/repr-haskell/corpus/ (downloaded
#                                 once when missing, checked by its SHA-256), its packages
#                                 extracted, their configure scripts run where the corpus says
#                                 (:configure; default CORPUS ghc-9.14.1: test/haskell/corpus-ghc-9.14.1.edn)
#   bin/repr-haskell corpus list [CORPUS]
#                                 the corpus's modules, one per line: modules|hsc|boot, package, file
#                                 (the modules, R6's .hsc modules and boot files; every one converted)
#   bin/repr-haskell dump --corpus [CORPUS]   dump the corpus into .tmp/repr-haskell/dumps/CORPUS/PKG/
#   bin/repr-haskell dump [--full] --corpus [CORPUS]   the same with --full into dumps/CORPUS-full/
#   bin/repr-haskell dump [--full] [-o DIR] FILE... [--ghc FLAG...]
#                                 run the helper on modules (relative to the current directory) with
#                                 GHC flags; one DIR/FILE.edn each (default .tmp/hsdump/out); --full
#                                 (mode :full, SPEC §7.2, §8.2) adds the exact-print annotations (as
#                                 discarded forms), the text and GHC's lexer's tokens with the comments,
#                                 and a CPP module's module view (DIR/FILE.view). R6: an .hsc FILE
#                                 through hsc2hs first (--hsc2hs-arg A, before --ghc; its output X.hs
#                                 beside it, the module), a literate one through unlit, an .hsig as a
#                                 signature
#   bin/repr-haskell read [-o DIR] FILE.edn...
#                                 convert dumps to Haskell forms: one .ae per module under DIR (default
#                                 .tmp/repr-haskell/forms/files), each read back and compared; a dump
#                                 --full to forms of mode :full
#   bin/repr-haskell read [--full] --corpus [CORPUS]
#                                 dump the corpus (.tmp/repr-haskell/dumps/CORPUS/PKG/) and convert it
#                                 into .tmp/repr-haskell/forms/CORPUS/PKG/ (SPEC §2.1);
#                                 report .tmp/repr-haskell/forms/CORPUS.report.edn; --full: mode :full,
#                                 into dumps/CORPUS-full/ and forms/CORPUS-full/
#   bin/repr-haskell print [-o DIR] [--layout braces|layout|full] FORMS.ae...
#                                 the printer (SPEC §7.4): one .hs per forms file into DIR (default
#                                 .tmp/repr-haskell/printed), at the forms' :file; the braces layout,
#                                 or for forms of mode :full the full layout (the original text, byte
#                                 for byte; --layout braces: the braces layout); --layout layout: the
#                                 layout layout (Haskell's layout rule, as a person writes it; R4)
#   bin/repr-haskell roundtrip [--only REGEX] [CORPUS]
#                                 the round trip's tree level (SPEC §9.1, §9.2) over the corpus:
#                                 read, print into .tmp/repr-haskell/cand/CORPUS/PKG/, and compare
#                                 GHC's trees (hsdump tree: showAstData BlankSrcSpan
#                                 BlankEpAnnotations after eraseEpLayout) and the start lines of
#                                 every located node (hsdump lines) of the original and the printed
#                                 module; fails on a difference test/haskell/roundtrip-CORPUS-known.edn
#                                 does not list, and on a listed one that no longer occurs. Report
#                                 .tmp/repr-haskell/cand/CORPUS.report.edn
#   bin/repr-haskell roundtrip --iface [CORPUS]
#                                 the tree level, then the interface level (SPEC §9.1, §9.3; R2):
#                                 each package compiled by ghc --make (the corpus's :iface :opt,
#                                 -haddock), once from the originals and once with the printed
#                                 modules in their places, under .tmp/repr-haskell/iface/CORPUS/;
#                                 ghc --show-iface of each converted module's two interfaces, compared
#                                 after the normalizations of mode :lines (the self-recompilation
#                                 hashes dropped, spans and SrcLoc columns in unfoldings as lines,
#                                 fingerprints blanked); fails on a difference
#                                 test/haskell/roundtrip-CORPUS-iface-known.edn does not list, and on
#                                 a listed one that no longer occurs. Report
#                                 .tmp/repr-haskell/iface/CORPUS.report.edn. --iface-only: the
#                                 interface level alone, over the modules printed by an earlier run
#   bin/repr-haskell roundtrip --text [CORPUS]
#                                 then the text level (SPEC §9.1, mode :full; R3): the corpus dumped
#                                 with --full, converted in mode :full, printed in the full layout into
#                                 .tmp/repr-haskell/cand-text/CORPUS/PKG/, each module compared byte for
#                                 byte with its original (a CPP module: its module view, SPEC §2.8),
#                                 then GHC's trees in mode :full (hsdump tree --full: every span,
#                                 annotation and comment) and lines of both; fails on a difference
#                                 test/haskell/roundtrip-CORPUS-text-known.edn does not list, and on a
#                                 listed one that no longer occurs. Report
#                                 .tmp/repr-haskell/cand-text/CORPUS.report.edn. --text-only: the text
#                                 level alone. With --iface too: tree, interface, text
#   bin/repr-haskell roundtrip --layout [CORPUS]
#                                 then the tree level of the layout layout (SPEC §7.4, 2; R4): the
#                                 same forms printed by Haskell's layout rule into
#                                 .tmp/repr-haskell/cand-layout/CORPUS/PKG/, GHC's trees and lines
#                                 compared as the braces layout's; known differences
#                                 test/haskell/roundtrip-CORPUS-layout-known.edn, report
#                                 .tmp/repr-haskell/cand-layout/CORPUS.report.edn. With --iface, the
#                                 interface level of both layouts, each package's three sides
#                                 compiled concurrently (known differences
#                                 test/haskell/roundtrip-CORPUS-layout-iface-known.edn, report
#                                 .tmp/repr-haskell/iface/CORPUS.layout.report.edn). --layout-only:
#                                 the layout layout alone (dump, convert, print, trees; with --iface
#                                 its interfaces only)
#   bin/repr-haskell read --reader native [-o DIR] FILE... [--hsc2hs-arg A...] [--ghc FLAG...]
#                                 the native reader (doc/haskell/NATIVE.md): each module read by
#                                 Arbace code alone (arbace.repr.haskell.native: GHC 9.14.1's lexer,
#                                 its Happy grammar's tables and actions, the Haddock pass), its dump
#                                 into DIR/FILE.edn (default .tmp/repr-haskell/native), then converted
#                                 to forms as the helper's dumps are (DIR/forms/); a module that needs
#                                 CPP (or unlit, hsc2hs) read from the text GHC's driver makes, the
#                                 helper's `cpp` verb (the preprocessing stays GHC's: DIR/hspp/)
#   bin/repr-haskell tables [--check]
#                                 the native parser's tables (arbace/repr/haskell/tables.ae) generated
#                                 from GHC's grammar, the pinned tarball's compiler/GHC/Parser.y,
#                                 by arbace.repr.haskell.happy (Happy's LALR(1) construction in
#                                 Arbace); --check: the productions and the tables against the
#                                 tarball's generated Parser.hs (Happy's own), state for state, and
#                                 the committed tables.ae against a fresh generation
#   bin/repr-haskell native-check [LIST]
#                                 the native reader against the helper over a list of modules
#                                 (default test/haskell/native-check.txt: lines DIR FILE [FLAG...],
#                                 DIR a corpus package or test:SUBDIR of test/haskell/): each module
#                                 dumped by the helper (mode :lines), read natively, the trees and
#                                 header pragmas compared as data, then both converted and the forms
#                                 compared as text; report .tmp/repr-haskell/native-check/report.edn
#   bin/repr-haskell test         the spec's cases (test/haskell/; bin/lib/repr-haskell/test): the
#                                 reader's samples, the worked example converted and its round trip,
#                                 the interface level's normalizations (test/haskell/iface/), the
#                                 worked example in mode :full printed back byte for byte
#   bin/repr-haskell rn-dump [-o DIR] FILE... [--ghc FLAG...]
#                                 HF1: GHC's renamer's output (the helper's rn verb, tools/hsdump/HsRn.hs) as the
#                                 reduced GhcRn forms, one DIR/FILE.rn.edn per module (the modules load together,
#                                 in dependency order; -i. finds the ones the others import): every located name
#                                 resolved, the operator trees, the binding groups, the imports, the exports
#   bin/repr-haskell iface [-o DIR] MODULE... [--ghc FLAG...]
#                                 HF1: the libraries' interfaces as forms (the helper's iface verb: exports with
#                                 each name's defining module, fixities, the things defined with their types as
#                                 GHC prints them), the modules defining the names too; one DIR/MODULE.iface.edn each
#   bin/repr-haskell tc-dump [-o DIR] FILE... [--ghc FLAG...]
#                                 HF3: GHC's typed output (the helper's tc verb): the module's things with their types in the
#                                 iface verb's forms, its instances, its desugared Core (-O0) with the types erased, DIR/FILE.tc.edn
#   bin/repr-haskell typecheck-check [DIR|LIST.txt]
#                                 HF3: the elaborator (arbace.repr.haskell.typecheck) against the tc dump over DIR's T*.hs
#                                 (default test/haskell/typecheck): types and evidence equal, the negative control differs;
#                                 HF4: a LIST.txt (test/haskell/typecheck-check.txt) the nofib programs it names instead,
#                                 each a session of its own, the known non-passes in their recorded classes
#   bin/repr-haskell rename-check [LIST]
#                                 HF2: the renamer (arbace.repr.haskell.rename) against the rn dump over the lists'
#                                 modules (default test/haskell/rename-check.txt: 47 samples, 33 modules of
#                                 ghc-internal's source and 21 nofib programs); the names, operator trees, groups, imports and exports
#                                 equal; reports in .tmp/repr-haskell/rename-check/NAME/
#
# Environment: REPR_HASKELL_HELPER (a helper executable already built, for the verbs that run it); REPR_HASKELL_JOBS (parallel helper and converter runs, default the cores, at most
# 32); REPR_HASKELL_PACKAGES (the packages the interface level compiles at once, default 4);
# ARBACE_HOST_EXE (the Arbace executable, bin/lib/host.bash; default stage 0).
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash" # TMPDIR: .tmp/tmp when unset
. "$root/bin/lib/tools.bash"
work=$root/.tmp/hsdump
helper=${REPR_HASKELL_HELPER:-$work/hsdump}
rh=$root/.tmp/repr-haskell
jobs=${REPR_HASKELL_JOBS:-$(nproc)}
[ "$jobs" -gt 32 ] && jobs=32
pin=$(cat "$root/tools/hsdump/GHC_VERSION")

ghc_check() {
  command -v ghc > "$TMPDIR/repr-haskell-which.txt" || { echo "repr-haskell: no ghc (Alpine's ghc package, doc/ALPINE.md)" >&2; return 1; }
  local v
  v=$(ghc --numeric-version)
  if [ "$v" != "$pin" ]; then
    echo "repr-haskell: the host's GHC is $v, tools/hsdump/GHC_VERSION pins $pin (SPEC §8.4: moving the pin is a recorded decision)" >&2
    return 1
  fi
  libdir=$(ghc --print-libdir)
}

# the unit id of the ghc library: ghc-VERSION-HASH
ghc_unit() {
  local f
  for f in "$libdir"/package.conf.d/ghc-"$pin"-*.conf; do basename "$f" .conf; return; done
}

helper_hash() {
  cat "$root"/tools/hsdump/*.hs "$root/tools/hsdump/GHC_VERSION" | sha256sum | cut -c1-64
}

build() {
  ghc_check
  [ -z "${REPR_HASKELL_HELPER:-}" ] || return 0
  mkdir -p "$work"
  local key
  key="$(helper_hash) $(ghc_unit)"
  (
    flock 7
    if [ -x "$helper" ] && [ -f "$work/key" ] && [ "$(cat "$work/key")" = "$key" ]; then exit 0; fi
    echo "== repr-haskell: building the helper (ghc $pin, $(ghc_unit))" >&2
    mkdir -p "$work/obj"
    ghc -O1 -package ghc "-optP-DGHC_PIN=\"$pin\"" "-i$root/tools/hsdump" -outputdir "$work/obj" -o "$helper.new.$$" \
      "$root/tools/hsdump/HsDump.hs" > "$work/build.log" 2>&1 ||
      { cat "$work/build.log" >&2; rm -f "$helper.new.$$"; exit 1; }
    mv -f "$helper.new.$$" "$helper"
    echo "$key" > "$work/key"
  ) 7> "$work/build.lock"
}

hsdump() {
  "$helper" "$1" --libdir "$libdir" --helper-hash "sha256:$(helper_hash)" "${@:2}"
}

corpus_file() {
  local c=${1:-ghc-9.14.1} f
  f=$root/test/haskell/corpus-$c.edn
  [ -f "$f" ] || { echo "repr-haskell: no corpus $c ($f)" >&2; return 1; }
  echo "$f"
}

# corpus_plan CORPUS WHAT: one line per package, tab-separated: name, directory (in the tarball's
# root), the GHC flags (space-separated, $libdir expanded), then the files (WHAT: modules, hsc, boot;
# all: the three, every module the corpus converts, R6), and for all a fifth field: the helper's
# hsc2hs arguments (--hsc2hs-arg A for each of the package's :hsc-flags; $repo expanded)
corpus_plan() {
  local f
  f=$(corpus_file "$1")
  arbace_tool -e "(let [c (read-string (slurp \"$f\")) what (keyword \"$2\")
                        j (fn [xs] (apply str (interpose \" \" xs)))]
    (doseq [p (:packages c)]
      (println (str (:name p) \"\t\" (:dir p) \"\t\"
        (j (concat [(str \"-X\" (:language p))] (map #(str \"-X\" %) (:extensions p)) [\"-haddock\"] (:ghc-flags p)))
        \"\t\" (j (map #(if (vector? %) (second %) %) (if (= what :all) (concat (:modules p) (:hsc p) (:boot p)) (get p what))))
        (if (= what :all) (str \"\t\" (j (mapcat (fn [a] [\"--hsc2hs-arg\" a]) (:hsc-flags p)))) \"\")))))" |
    sed -e "s|\\\$libdir|$libdir|g" -e "s|\\\$repo|$root|g"
}

corpus_fetch() {
  local c=${1:-ghc-9.14.1} f url sha size name dir tb
  f=$(corpus_file "$c")
  read -r url sha size name <<< "$(arbace_tool -e "(let [t (:tarball (read-string (slurp \"$f\")))] (println (:url t) (:sha256 t) (:size t) (:root t)))")"
  dir=$rh/corpus
  tb=$dir/$(basename "$url")
  mkdir -p "$dir"
  (
    flock 8
    if [ ! -f "$tb" ]; then
      echo "== repr-haskell: fetching $url" >&2
      curl -fsSL -o "$tb.part" "$url" && mv "$tb.part" "$tb"
    fi
    if [ "$(sha256sum < "$tb" | cut -c1-64)" != "$sha" ]; then
      echo "repr-haskell: $tb: SHA-256 differs from the corpus's $sha" >&2
      exit 1
    fi
    local dirs
    # each package's :dir, or its :extract when the tarball hard-links its files from a sibling
    # (containers/containers' from containers/containers-tests)
    # (each once: R6's Setup scripts share their packages' directories)
    dirs=$(arbace_tool -e "(doseq [d (distinct (map #(or (:extract %) (:dir %)) (:packages (read-string (slurp \"$f\")))))] (println d))" | sed "s|^|$name/|" | tr '\n' ' ')
    # what the interface level needs of the tarball besides the packages (genprimopcode)
    dirs="$dirs $(iface_conf "$c" :extract | tr ' ' '\n' | sed "s|^|$name/|" | tr '\n' ' ')"
    if [ ! -f "$dir/$name.extracted" ] || [ "$(cat "$dir/$name.extracted")" != "$sha $dirs" ]; then
      rm -rf "${dir:?}/$name"
      # shellcheck disable=SC2086
      tar -xJf "$tb" -C "$dir" $dirs
      echo "$sha $dirs" > "$dir/$name.extracted"
    fi
    # the headers a package's configure script makes (Cabal's build-type Configure: unix,
    # directory, process, time; R5), made once in the extracted tree, as Cabal makes them
    local pname pdir pfiles f need
    local pl; pl=$(mktemp "$TMPDIR/repr-haskell-plan.XXXXXX")
    corpus_configure "$c" > "$pl"
    while IFS=$'\t' read -r pname pdir pfiles; do
      need=""
      for f in $pfiles; do [ -f "$dir/$name/$pdir/$f" ] || need=1; done
      [ -n "$need" ] || continue
      echo "== repr-haskell: $pname: configure" >&2
      (cd "$dir/$name/$pdir" && sh ./configure > configure.log 2>&1) ||
        { tail -20 "$dir/$name/$pdir/configure.log" >&2; echo "repr-haskell: $pname: configure failed" >&2; exit 1; }
    done < "$pl"
    rm -f "$pl"
  ) 8> "$dir/fetch.lock"
  srcroot=$dir/$name
}

# corpus_configure CORPUS: one line per package with a :configure, tab-separated: name, directory,
# the files its configure script makes
corpus_configure() {
  local f
  f=$(corpus_file "$1")
  arbace_tool -e "(let [c (read-string (slurp \"$f\"))]
    (doseq [p (:packages c) :when (seq (:configure p))]
      (println (str (:name p) \"\t\" (:dir p) \"\t\" (apply str (interpose \" \" (:configure p)))))))"
}

# dump_corpus CORPUS OUT: every module of the corpus dumped into OUT/PKG/FILE.edn (a module the
# helper fails on is written as (hsdump/error ...), which the conversion reports); R6: the .hsc
# modules through hsc2hs (by the helper, its output X.hs beside X.hsc in the extracted tree, as a
# Cabal build's; the dump X.hs.edn), the boot files and the literate modules too
dump_corpus() {
  local c=$1 out=$2 full=${3:-} name dir flags files hargs hh
  rm -rf "$out"
  mkdir -p "$out"
  hh=sha256:$(helper_hash)
  local pl; pl=$(mktemp "$TMPDIR/repr-haskell-plan.XXXXXX")
  corpus_plan "$c" all > "$pl"
  while IFS=$'\t' read -r name dir flags files hargs; do
    [ -n "$files" ] || continue
    # shellcheck disable=SC2086
    (cd "$srcroot/$dir" && printf '%s\n' $files | xargs -P "$jobs" -n 8 \
      "$helper" dump $full -o "$out/$name" --libdir "$libdir" --corpus "$c" --helper-hash "$hh" \
        --repo "$root" $hargs --ghc $flags --files) 2> "$out/$name.err" || true
  done < "$pl"
  rm -f "$pl"
}

# tree_jobs MODE ORIG CAND CANDOUT [reuse]: the helper's trees (hsdump tree, MODE "" or --full)
# of the originals (in the corpus's tree, into ORIG/PKG) unless reuse, and of the printed modules
# (in CAND/PKG, under the original's relative paths, so that spans name the same files, into
# CANDOUT(PKG)), each parsed under its package's configuration: one job list over the whole corpus,
# 8 modules a job, JOBS at a time (R5: package by package, the corpus's 37 small packages left the
# cores idle); the helper's messages in each output's .err
tree_jobs() {
  local mode=$1 o=$2 k=$3 kout=$4 reuse=${5:-} name dir flags files hargs jl
  jl=$(mktemp "$rh/tree-jobs.XXXXXX")
  local pl; pl=$(mktemp "$TMPDIR/repr-haskell-plan.XXXXXX")
  corpus_plan "$c" all > "$pl"
  while IFS=$'\t' read -r name dir flags files hargs; do
    [ -n "$files" ] || continue
    # the helper's options: hsc2hs's arguments (R6: an original .hsc goes through hsc2hs), the
    # GHC flags
    printf '%s --ghc %s\n' "$hargs" "$flags" > "$jl.$name.flags"
    if [ -z "$reuse" ]; then
      # shellcheck disable=SC2086
      printf '%s\n' $files | xargs -n 8 echo | while read -r fs; do
        printf '%s\x1f%s\x1f%s\x1f%s\n' "$srcroot/$dir" "$o/$name" "$jl.$name.flags" "$fs"; done >> "$jl"
    fi
    if [ -d "$k/$name" ]; then
      # the printed modules: an .hsc module's is its X.hs (R6)
      # shellcheck disable=SC2086
      (cd "$k/$name" && printf '%s\n' $files | sed 's/\.hsc$/.hs/' | while read -r f; do [ -f "$f" ] && echo "$f"; done) | xargs -r -n 8 echo |
        while read -r fs; do
          printf '%s\x1f%s\x1f%s\x1f%s\n' "$k/$name" "${kout//PKG/$name}" "$jl.$name.flags" "$fs"; done >> "$jl"
    fi
  done < "$pl"
  rm -f "$pl"
  xargs -P "$jobs" -d '\n' -n 1 "$root/bin/lib/repr-haskell/tree-job" "$helper" "$mode" "$libdir" < "$jl" || true
  rm -f "$jl" "$jl".*.flags
}

read_files() {
  arbace_tool -m arbace.repr.haskell read "$@"
}

# iface_plan CORPUS: one line per package, its fields separated by US (\x1f, so that an empty
# field stays one; a tab is white space to read): name, directory, the GHC flags of the
# parse (as corpus_plan's), the targets ghc --make builds (the module names of the converted, the
# .hsc, the generated; a Main module's file, R6), the converted modules as NAME=FILE (R6: an .hsc
# module's FILE its X.hs, a boot file's NAME M@boot), the .hsc files, hsc2hs's flags, the
# generated files as FILE=FLAG (genprimopcode's); $libdir expanded
iface_plan() {
  local f
  f=$(corpus_file "$1")
  arbace_tool -e "(let [c (read-string (slurp \"$f\")) j (fn [xs] (apply str (interpose \" \" xs)))]
    (doseq [p (:packages c)]
      (println (str (:name p) \"\u001f\" (:dir p) \"\u001f\"
        (j (concat [(str \"-X\" (:language p))] (map #(str \"-X\" %) (:extensions p)) [\"-haddock\"] (:ghc-flags p)
             (distinct (for [[m f] (:modules p) :when (not= (str m) \"Main\")] (let [n (- (count f) (count (str m)) 3)] (if (pos? n) (str \"-i\" (subs f 0 (dec n))) \"-i.\"))))))
        \"\u001f\" (j (concat (map (fn [[m f]] (if (= (str m) \"Main\") f m)) (:modules p)) (map first (:hsc p)) (:generated p)))
        \"\u001f\" (j (concat (map (fn [[m f]] (str m \"=\" f)) (:modules p))
                          (map (fn [[m f]] (str m \"=\" (subs f 0 (dec (count f))))) (:hsc p))
                          (map (fn [f] (str (or (some (fn [[m g]] (when (= g (subs f 0 (- (count f) 5))) m)) (:modules p)) f) \"@boot=\" f)) (:boot p))))
        \"\u001f\" (j (map second (:hsc p)))
        \"\u001f\" (j (:hsc-flags p))
        \"\u001f\" (j (map (fn [[f g]] (str f \"=\" g)) (:genprimopcode p)))
        \"\u001f\" (j (map (fn [[f g]] (str f \"=\" g)) (:generated-files p)))))))" |
    sed -e "s|\\\$libdir|$libdir|g" -e "s|\\\$repo|$root|g"
}

# iface_conf CORPUS KEY...: a value of the corpus's :iface, space-separated when a vector
iface_conf() {
  local f
  f=$(corpus_file "$1"); shift
  arbace_tool -e "(let [v (get-in (:iface (read-string (slurp \"$f\"))) [$*])] (println (cond (nil? v) \"\" (sequential? v) (apply str (interpose \" \" v)) :else v)))"
}

# genprimopcode_build CORPUS: GHC's genprimopcode (the tarball's utils/genprimopcode, with its
# generated Lexer.hs and Parser.hs) built by the host's GHC into .tmp/repr-haskell/tools/, and
# primops.txt from primops.txt.pp, as hadrian's rules do; sets genprimopcode and primops
genprimopcode_build() {
  local c=$1 d main pkgs pp cpp key tw=$rh/tools/$1
  d=$(iface_conf "$c" :genprimopcode :dir); main=$(iface_conf "$c" :genprimopcode :main)
  pkgs=$(iface_conf "$c" :genprimopcode :packages); pp=$(iface_conf "$c" :genprimopcode :primops)
  cpp=$(iface_conf "$c" :genprimopcode :cpp)
  genprimopcode=$tw/genprimopcode; primops=$tw/primops.txt
  key="$(cat "$srcroot/$d"/*.hs "$srcroot/$pp" | sha256sum | cut -c1-64) $pkgs $cpp $(ghc_unit)"
  if [ -x "$genprimopcode" ] && [ -f "$primops" ] && [ -f "$tw/key" ] && [ "$(cat "$tw/key")" = "$key" ]; then return; fi
  echo "== repr-haskell: building genprimopcode ($d)" >&2
  rm -rf "$tw"; mkdir -p "$tw/obj"
  # shellcheck disable=SC2046
  ghc -O0 $(for p in $pkgs; do echo -package "$p"; done) -outputdir "$tw/obj" -o "$genprimopcode" \
    -i"$srcroot/$d" "$srcroot/$d/$main" > "$tw/build.log" 2>&1 || { cat "$tw/build.log" >&2; return 1; }
  # shellcheck disable=SC2086
  $cpp "$srcroot/$pp" -o "$primops"
  rm -rf "$tw/obj"
  echo "$key" > "$tw/key"
}

# iface_level CORPUS SIDE CAND [SIDE CAND]: the round trip's interface level (SPEC §9.1, §9.3)
# over the modules printed into CAND/PKG/ (SIDE cand: the braces layout's; cand-layout: the layout
# layout's, R4): each package's source tree copied under .tmp/repr-haskell/iface/CORPUS/{orig,SIDE}/PKG
# (the .hsc modules through hsc2hs, the generated ones by genprimopcode, the same on every side; the
# converted ones replaced by the printed on a printed side), each compiled by ghc --make from inside
# its tree (the same relative paths: the spans name the same files), all sides of a package
# concurrently, the interfaces of the converted modules shown (ghc --show-iface) into
# {orig,SIDE}.ifaces/PKG/M.iface, the objects removed, and each printed side compared with the
# originals (arbace.repr.haskell compare-iface)
iface_level() {
  local c=$1 ib=$rh/iface/$1 opt t0 t1 t2 t3 name dir flags mods files hscs hflags gens gfiles
  shift
  local sides=() cands=()
  while [ $# -gt 0 ]; do sides+=("$1"); cands+=("$2"); shift 2; done
  ghc_check
  genprimopcode_build "$c"
  opt=$(iface_conf "$c" :opt)
  rm -rf "${ib:?}"; mkdir -p "$ib/orig"
  t0=$(date +%s)
  local pl; pl=$(mktemp "$TMPDIR/repr-haskell-plan.XXXXXX")
  iface_plan "$c" > "$pl"
  while IFS=$'\x1f' read -r name dir flags mods files hscs hflags gens gfiles; do
    local o=$ib/orig/$name h g mf i k
    mkdir -p "$o"
    (cd "$srcroot/$dir" && tar --exclude=./tests -cf - .) | tar -xf - -C "$o"
    for g in $gfiles; do mkdir -p "$(dirname "$o/${g%%=*}")"; cp "$root/${g#*=}" "$o/${g%%=*}"; done
    for h in $hscs; do
      # shellcheck disable=SC2086
      (cd "$o" && hsc2hs $hflags "$h" -o "${h%.hsc}.hs") > "$o.hsc2hs.log" 2>&1 ||
        { cat "$o.hsc2hs.log" >&2; echo "repr-haskell: hsc2hs failed on $name/$h" >&2; return 1; }
    done
    for g in $gens; do "$genprimopcode" "${g#*=}" < "$primops" > "$o/${g%%=*}"; done
    for i in "${!sides[@]}"; do
      k=$ib/${sides[$i]}/$name
      mkdir -p "$ib/${sides[$i]}"
      cp -a "$o" "$k"
      for mf in $files; do
        mf=${mf#*=}
        if [ -f "${cands[$i]}/$name/$mf" ]; then cp "${cands[$i]}/$name/$mf" "$k/$mf"; else rm -f "${k:?}/${mf:?}"; fi
      done
    done
  done < "$pl"
  rm -f "$pl"
  t1=$(date +%s)
  echo "== repr-haskell roundtrip $c: interfaces: compile ($opt; orig ${sides[*]}; $((t1 - t0)) s preparing)" >&2
  # all sides of each package concurrently, and up to REPR_HASKELL_PACKAGES packages at once (each
  # compiles against the installed packages alone, so the packages are independent; R5's 37,
  # most of them small, left the cores idle one by one), in the corpus's order
  local np=${REPR_HASKELL_PACKAGES:-4}
  local pl; pl=$(mktemp "$TMPDIR/repr-haskell-plan.XXXXXX")
  iface_plan "$c" > "$pl"
  while IFS=$'\x1f' read -r name dir flags mods files hscs hflags gens gfiles; do
    while [ "$(jobs -rp | wc -l)" -ge $((np * (1 + ${#sides[@]}))) ]; do wait -n || true; done
    local side
    for side in orig "${sides[@]}"; do
      # shellcheck disable=SC2086
      (cd "$ib/$side/$name" && ghc --make $flags $opt -j"$jobs" -fkeep-going -no-link \
        -outputdir "../$name.out" $mods) > "$ib/$side/$name.build.log" 2>&1 &
    done
  done < "$pl"
  rm -f "$pl"
  wait || true
  t2=$(date +%s)
  echo "== repr-haskell roundtrip $c: interfaces: show and compare ($((t2 - t1)) s compiling)" >&2
  # one ghc --show-iface per converted module, over every package and side at once (R5); a
  # missing .hi leaves no .iface (reported)
  local pl; pl=$(mktemp "$TMPDIR/repr-haskell-plan.XXXXXX")
  iface_plan "$c" > "$pl"
  while IFS=$'\x1f' read -r name dir flags mods files hscs hflags gens gfiles; do
    local side
    for side in orig "${sides[@]}"; do
      mkdir -p "$ib/$side.ifaces/$name"
      # shellcheck disable=SC2086
      # a boot file's interface M.hi-boot (R6)
      printf '%s\n' $files | sed 's/=.*//' | while read -r m; do
        case $m in
          *@boot) printf '%s %s\n' "$ib/$side/$name.out/$(echo "${m%@boot}" | tr . /).hi-boot" "$ib/$side.ifaces/$name/$m.iface" ;;
          *) printf '%s %s\n' "$ib/$side/$name.out/$(echo "$m" | tr . /).hi" "$ib/$side.ifaces/$name/$m.iface" ;;
        esac; done
    done
  done < "$pl" | xargs -P "$jobs" -n 2 sh -c \
    '[ -f "$1" ] && ghc --show-iface "$1" > "$2.part" 2>&1 && mv "$2.part" "$2"; rm -f "$2.part"; :' _
  rm -f "$pl"
  local pl; pl=$(mktemp "$TMPDIR/repr-haskell-plan.XXXXXX")
  iface_plan "$c" > "$pl"
  while IFS=$'\x1f' read -r name dir flags mods files hscs hflags gens gfiles; do
    local side
    for side in orig "${sides[@]}"; do rm -rf "${ib:?}/$side/$name.out" "${ib:?}/$side/${name:?}"; done
  done < "$pl"
  rm -f "$pl"
  t3=$(date +%s)
  local st=0 n=${#sides[@]} keep
  for i in "${!sides[@]}"; do
    local side=${sides[$i]} known=$root/test/haskell/roundtrip-$c-iface-known.edn report=$ib.report.edn label=""
    if [ "$side" = cand-layout ]; then
      known=$root/test/haskell/roundtrip-$c-layout-iface-known.edn; report=$ib.layout.report.edn; label="the layout layout"
    fi
    # the originals' texts of the equal modules are pruned by the last comparison only
    keep=""; [ "$i" -lt $((n - 1)) ] && keep=--keep-orig
    arbace_tool -m arbace.repr.haskell compare-iface --corpus "$(corpus_file "$c")" --orig "$ib/orig.ifaces" \
      --cand "$ib/$side.ifaces" --printed "${cands[$i]}" --builds "$ib" --side "$side" --prune $keep \
      ${label:+--label "$label"} --known "$known" --report "$report" \
      --times "prepare $((t1 - t0)) compile $((t2 - t1)) show $((t3 - t2))" || st=1
  done
  return $st
}

roundtrip() {
  local c=ghc-9.14.1 only="" iface="" tree=1 text="" layout="" st=0
  while [ $# -gt 0 ]; do
    case $1 in
      --only) only=$2; shift 2 ;;
      --iface) iface=1; shift ;;
      --iface-only) iface=1; tree=""; shift ;;
      --text) text=1; shift ;;
      --text-only) text=1; tree=""; shift ;;
      --layout) layout=1; shift ;;
      --layout-only) layout=1; tree=""; shift ;;
      *) c=$1; shift ;;
    esac
  done
  build
  corpus_fetch "$c"
  local cand=$rh/cand/$c lcand=$rh/cand-layout/$c sides=()
  if [ -n "$tree" ]; then tree_level "$c" "$only" || st=1; fi
  if [ -n "$layout" ]; then tree_level "$c" "$only" layout ${tree:+reuse} || st=1; fi
  if [ -n "$iface" ]; then
    [ -z "$only" ] || { echo "repr-haskell: --only is for the tree and text levels" >&2; return 2; }
    # the braces layout's printed modules unless --layout-only, the layout layout's with --layout
    if [ -n "$tree" ] || [ -z "$layout" ]; then
      [ -d "$cand" ] || { echo "repr-haskell: no printed modules in $cand (run the tree level first)" >&2; return 1; }
      sides+=(cand "$cand")
    fi
    if [ -n "$layout" ]; then
      [ -d "$lcand" ] || { echo "repr-haskell: no printed modules in $lcand (run roundtrip --layout first)" >&2; return 1; }
      sides+=(cand-layout "$lcand")
    fi
    iface_level "$c" "${sides[@]}" || st=1
  fi
  if [ -n "$text" ]; then text_level "$c" "$only" || st=1; fi
  return $st
}

# text_level CORPUS ONLY: the text level (SPEC §9.1, mode :full; R3): the corpus dumped with
# --full (.tmp/repr-haskell/dumps/CORPUS-full/PKG/, with CPP's module views as FILE.view),
# converted in mode :full (.tmp/repr-haskell/forms/CORPUS-full/PKG/), printed in the full layout
# (.tmp/repr-haskell/cand-text/CORPUS/PKG/), each printed module compared byte for byte with its
# original (a CPP module: its module view), then GHC's trees in mode :full (hsdump tree --full:
# showAstData NoBlankSrcSpan NoBlankEpAnnotations, comments kept) and lines of both
# (.tmp/repr-haskell/trees-full/CORPUS/{orig,cand}/PKG/)
text_level() {
  local c=$1 only=$2
  local dumps=$rh/dumps/$c-full forms=$rh/forms/$c-full cand=$rh/cand-text/$c trees=$rh/trees-full/$c t0 t1 t2 t3 t4
  t0=$(date +%s)
  echo "== repr-haskell roundtrip $c: text level: dump (--full)" >&2
  dump_corpus "$c" "$dumps" --full
  t1=$(date +%s)
  echo "== repr-haskell roundtrip $c: text level: convert (mode :full; $((t1 - t0)) s dumping)" >&2
  rm -rf "$forms"; mkdir -p "$(dirname "$forms")"
  read_files --jobs "$jobs" -o "$forms" --report "$forms.report.edn" --root "$dumps" ${only:+--only "$only"} > "$forms.log" 2>&1 ||
    { grep -v '^error' "$forms.log" | tail -5 >&2; grep -c '^error' "$forms.log" | sed 's/$/ modules failed to convert (see the report)/' >&2; }
  t2=$(date +%s)
  echo "== repr-haskell roundtrip $c: text level: print (the full layout; $((t2 - t1)) s converting)" >&2
  rm -rf "$cand"; mkdir -p "$(dirname "$cand")"
  arbace_tool -m arbace.repr.haskell print --jobs "$jobs" -o "$cand" --root "$forms" > "$cand.print.log" 2>&1 ||
    grep -v '^error' "$cand.print.log" | tail -3 >&2
  t3=$(date +%s)
  echo "== repr-haskell roundtrip $c: text level: trees in mode :full ($((t3 - t2)) s printing)" >&2
  rm -rf "$trees"; mkdir -p "$trees/orig" "$trees/cand"
  tree_jobs --full "$trees/orig" "$cand" "$trees/cand/PKG"
  t4=$(date +%s)
  echo "== repr-haskell roundtrip $c: text level: compare ($((t4 - t3)) s parsing)" >&2
  arbace_tool -m arbace.repr.haskell compare-text --corpus "$(corpus_file "$c")" --src "$srcroot" --views "$dumps" \
    --cand "$cand" --trees "$trees" --forms-report "$forms.report.edn" \
    --known "$root/test/haskell/roundtrip-$c-text-known.edn" --report "$cand.report.edn" ${only:+--only "$only"} \
    --times "dump $((t1 - t0)) convert $((t2 - t1)) print $((t3 - t2)) parse $((t4 - t3))"
}

# tree_level CORPUS ONLY [LAYOUT [reuse]]: the tree level (SPEC §9.2): dump, convert, print into
# .tmp/repr-haskell/cand/CORPUS/PKG/ (LAYOUT braces, the default) or cand-layout/CORPUS/PKG/ (layout:
# the layout layout, R4), the helper's trees and lines of both sides compared; reuse: the dumps,
# the forms and the originals' trees of the tree level just run
tree_level() {
  local c=$1 only=$2 layout=${3:-braces} reuse=${4:-}
  local dumps=$rh/dumps/$c forms=$rh/forms/$c orig=$rh/orig/$c cand=$rh/cand/$c t0 t1 t2 t3 t4
  local known=$root/test/haskell/roundtrip-$c-known.edn label="" what=""
  if [ "$layout" = layout ]; then
    cand=$rh/cand-layout/$c; known=$root/test/haskell/roundtrip-$c-layout-known.edn
    label="the layout layout"; what=" (the layout layout)"
  fi
  t0=$(date +%s)
  if [ -z "$reuse" ]; then
    echo "== repr-haskell roundtrip $c$what: dump" >&2
    dump_corpus "$c" "$dumps"
  fi
  t1=$(date +%s)
  if [ -z "$reuse" ]; then
    echo "== repr-haskell roundtrip $c$what: convert ($((t1 - t0)) s dumping)" >&2
    rm -rf "${forms:?}"; mkdir -p "$(dirname "$forms")"
    read_files --jobs "$jobs" -o "$forms" --report "$forms.report.edn" --root "$dumps" ${only:+--only "$only"} > "$forms.log" 2>&1 ||
      { tail -20 "$forms.log" >&2; echo "repr-haskell: the conversion failed ($forms.log)" >&2; return 1; }
  fi
  t2=$(date +%s)
  echo "== repr-haskell roundtrip $c$what: print ($((t2 - t1)) s converting)" >&2
  rm -rf "${cand:?}"; mkdir -p "$(dirname "$cand")"
  # a module the printer fails on is reported by the comparison (not printed)
  arbace_tool -m arbace.repr.haskell print --jobs "$jobs" --layout "$layout" -o "$cand" --root "$forms" > "$cand.print.log" 2>&1 ||
    grep -v '^error' "$cand.print.log" | tail -3 >&2
  t3=$(date +%s)
  echo "== repr-haskell roundtrip $c$what: trees ($((t3 - t2)) s printing)" >&2
  # the trees: of the originals (in the corpus's tree) and of the printed modules (in the
  # candidate's), each parsed by the helper under its package's configuration
  if [ -z "$reuse" ]; then rm -rf "${orig:?}"; mkdir -p "$orig"; fi
  tree_jobs "" "$orig" "$cand" "$cand/PKG.trees" $reuse
  t4=$(date +%s)
  echo "== repr-haskell roundtrip $c$what: compare ($((t4 - t3)) s parsing)" >&2
  arbace_tool -m arbace.repr.haskell compare --corpus "$(corpus_file "$c")" --orig "$orig" --cand "$cand" \
    --forms-report "$forms.report.edn" --known "$known" ${label:+--label "$label"} \
    --report "$cand.report.edn" ${only:+--only "$only"} \
    --times "dump $((t1 - t0)) convert $((t2 - t1)) print $((t3 - t2)) parse $((t4 - t3))"
}

# native_read [-o DIR] FILE... [--ghc FLAG...]: the native reader over modules (relative to the
# current directory), dumps into DIR/FILE.edn and forms into DIR/forms/; a module that needs CPP,
# unlit or hsc2hs first preprocessed by the helper's cpp verb (GHC's driver) into DIR/hspp/
native_read() {
  local out=$rh/native files=() gflags=() hargs=() f need=() hspp=""
  while [ $# -gt 0 ]; do
    case $1 in
      -o) out=$2; shift 2 ;;
      --hsc2hs-arg) hargs+=("$1" "$2"); shift 2 ;;
      --ghc) shift; gflags=("$@"); break ;;
      *) files+=("$1"); shift ;;
    esac
  done
  mkdir -p "$out"
  for f in "${files[@]}"; do
    case $f in
      *.lhs|*.lhs-boot|*.lhsig|*.hsc) need+=("$f") ;;
      *) if grep -q -E -i '^[[:space:]]*\{-#[[:space:]]*(LANGUAGE[^#]*\bCPP\b|OPTIONS(_GHC)?[^#]*(-cpp|-XCPP))' "$f" ||
            printf '%s\n' "${gflags[@]}" | grep -q -x -E -e '-XCPP|-cpp'; then need+=("$f"); fi ;;
    esac
  done
  if [ ${#need[@]} -gt 0 ]; then
    ghc_check; build
    hsdump cpp -o "$out/hspp" "${hargs[@]}" --ghc "${gflags[@]}" --files "${need[@]}" || return 1
    hspp=$out/hspp
  fi
  local st=0 dumps=() m
  for f in "${files[@]}"; do m=$f; [ "${f%.hsc}" != "$f" ] && m=${f%c}; rm -f "$out/$m.edn"; done
  arbace_tool -m arbace.repr.haskell.native read -o "$out" ${hspp:+--hspp "$hspp"} \
    --cpp-files "$(printf '%s ' "${need[@]}")" --flags "$(printf '%s ' "${gflags[@]}")" "${files[@]}" || st=1
  # the modules read (an .hsc module's dump is its X.hs's), converted as the helper's dumps are
  for f in "${files[@]}"; do
    m=$f; [ "${f%.hsc}" != "$f" ] && m=${f%c}
    [ -f "$out/$m.edn" ] && dumps+=("$out/$m.edn")
  done
  [ ${#dumps[@]} -eq 0 ] || read_files --jobs "$jobs" -o "$out/forms" "${dumps[@]}" || st=1
  return $st
}

# parser_src: GHC's grammar and its Happy-generated parser, extracted from the pinned tarball (the
# corpus's) into .tmp/repr-haskell/parser/, read in place by arbace.repr.haskell.happy
parser_src() {
  corpus_fetch ghc-9.14.1 > "$TMPDIR/repr-haskell-fetch.txt"
  local f url tb d=$rh/parser
  f=$(corpus_file ghc-9.14.1)
  url=$(arbace_tool -e "(println (:url (:tarball (read-string (slurp \"$f\")))))")
  tb=$rh/corpus/$(basename "$url")
  mkdir -p "$d"
  if [ ! -f "$d/ghc-9.14.1/compiler/GHC/Parser.y.source" ] || [ ! -f "$d/ghc-9.14.1/compiler/GHC/Parser.hs" ]; then
    tar -xJf "$tb" -C "$d" ghc-9.14.1/compiler/GHC/Parser.y.source ghc-9.14.1/compiler/GHC/Parser.hs
  fi
  parser_y=$d/ghc-9.14.1/compiler/GHC/Parser.y.source
  parser_hs=$d/ghc-9.14.1/compiler/GHC/Parser.hs
}

tables() {
  parser_src
  if [ "${1:-}" = --check ]; then
    arbace_tool -m arbace.repr.haskell.happy check --parser-y "$parser_y" --parser-hs "$parser_hs"
  else
    arbace_tool -m arbace.repr.haskell.happy gen --parser-y "$parser_y" --out "$root/arbace/repr/haskell/tables.ae"
  fi
}


# rename_check [LIST]: the renamer's check (test/haskell/rename-check.txt by default; HF2): GHC's renamer by the
# helper's rn verb (the reduced GhcRn forms, tools/hsdump/HsRn.hs) against arbace.repr.haskell.rename over the native
# reader's trees, each list entry in .tmp/repr-haskell/rename-check/NAME/
rename_check() {
  local list=${1:-$root/test/haskell/rename-check.txt} w=$rh/rename-check kind a b rest st=0
  local tb=$rh/corpus/ghc-9.14.1-src.tar.xz
  mkdir -p "$w"
  while read -r kind a b rest; do
    case $kind in ''|'#'*) continue ;; esac
    local d name files=() own="" need="" m f ifs
    if [ "$kind" = nofib ]; then
      # single-module programs of nofib/spectral, each in a session of its own (Haskell 2010)
      [ -f "$tb" ] || { echo "rename-check: $tb is missing (bin/repr-haskell corpus fetch)" >&2; st=1; continue; }
      local prog ok=0 n=0 pw
      for prog in $a $b $rest; do
        pw=$w/nofib/$prog; rm -rf "${pw:?}"; mkdir -p "$pw/src"
        tar -xJf "$tb" -C "$pw/src" --strip-components=4 "ghc-9.14.1/nofib/spectral/$prog/Main.hs"
        n=$((n + 1))
        (cd "$pw/src" && "$helper" rn --libdir "$libdir" -o "$pw/ghc" --ghc -XHaskell2010 --files Main.hs) > "$pw/ghc.log" 2>&1 || { echo "nofib $prog: GHC rejects it" >&2; st=1; continue; }
        need="Prelude $(cd "$pw/src" && grep -h '^import' Main.hs | sed 's/qualified//' | awk '{print $2}' | sed 's/(.*//' | sort -u | tr '\n' ' ')"
        # shellcheck disable=SC2086
        "$helper" iface --libdir "$libdir" -o "$pw/if" --ghc -XHaskell2010 --files $need > "$pw/if.log" 2>&1 || true
        (cd "$pw/src" && arbace_tool -m arbace.repr.haskell.native read -o "$pw/nd" --flags "-XHaskell2010" Main.hs > "$pw/read.log") || { echo "nofib $prog: the native reader rejects it" >&2; st=1; continue; }
        if arbace_tool -m arbace.repr.haskell.rename check --ifaces "$pw/if" --local "$pw/ifl" --ghc "$pw/ghc" -o "$pw/out" "$pw/nd/Main.hs.edn" > "$pw/report.txt" 2>&1 \
           && grep -q '1 of 1 modules equal' "$pw/report.txt"; then ok=$((ok + 1)); else echo "nofib $prog: differs ($pw/report.txt)" >&2; st=1; fi
      done
      echo "== rename-check nofib: $ok of $n programs equal"
      continue
    fi
    if [ "$kind" = samples ]; then
      name=samples; d=$root/$a; ifs="$b $rest"
      rm -rf "${w:?}/$name"; mkdir -p "$w/$name"
      files=($(cd "$d" && ls R*.hs))
      (cd "$d" && "$helper" rn --libdir "$libdir" -o "$w/$name/ghc" --ghc -XGHC2021 -i. --files "${files[@]}") 2> "$w/$name/ghc.err" || { tail -5 "$w/$name/ghc.err" >&2; st=1; continue; }
      need=$ifs
    else
      name=$a; d=$w/$name/src
      [ -f "$tb" ] || { echo "rename-check: $tb is missing (bin/repr-haskell corpus fetch)" >&2; st=1; continue; }
      rm -rf "${w:?}/$name"; mkdir -p "$d"
      local paths=() fl=($b $rest)
      for f in "${fl[@]}"; do paths+=("ghc-9.14.1/libraries/ghc-internal/src/GHC/Internal/$f.hs"); done
      tar -xJf "$tb" -C "$d" --strip-components=4 "${paths[@]}"
      for f in "${fl[@]}"; do files+=("GHC/Internal/$f.hs"); own="$own $(echo "GHC/Internal/$f" | tr / .)"; done
      (cd "$d" && "$helper" rn --libdir "$libdir" -o "$w/$name/ghc" --ghc -XGHC2021 -package ghc-internal -this-unit-id ghc-internal-x --files "${files[@]}") 2> "$w/$name/ghc.err" || { tail -5 "$w/$name/ghc.err" >&2; st=1; continue; }
      for m in $(cd "$d" && grep -h '^import' "${files[@]}" | sed 's/{-# SOURCE #-}//; s/qualified//' | awk '{print $2}' | sed 's/(.*//' | sort -u); do
        case " $own " in *" $m "*) ;; *) need="$need $m" ;; esac
      done
      need="Prelude $need"
    fi
    # the interfaces of what the modules import (and of the modules defining those names)
    local pk=""; [ "$kind" = prelude ] && pk="-package ghc-internal"
    # shellcheck disable=SC2086
    "$helper" iface --libdir "$libdir" -o "$w/$name/if" --ghc -XGHC2021 $pk --files $need 2> "$w/$name/if.err" || true
    # the native reader's trees
    local dumps=()
    (cd "$d" && arbace_tool -m arbace.repr.haskell.native read -o "$w/$name/nd" --flags "-XGHC2021" "${files[@]}" > "$w/$name/read.log") || { tail -5 "$w/$name/read.log" >&2; st=1; continue; }
    for f in "${files[@]}"; do dumps+=("$w/$name/nd/$f.edn"); done
    echo "== rename-check $name: ${#files[@]} modules"
    arbace_tool -m arbace.repr.haskell.rename check --ifaces "$w/$name/if" --local "$w/$name/ifl" --root "$w/$name/nd" \
      --ghc "$w/$name/ghc" -o "$w/$name/out" "${dumps[@]}" | tee "$w/$name/report.txt" | grep -v '^ok' || true
    grep -q '^rename-check: \([0-9]*\) of \1 modules equal' "$w/$name/report.txt" || st=1
  done < "$list"
  return $st
}

# typecheck_check [DIR]: the elaborator's check (HF3; doc/haskell/FRONTEND-SURVEY.md, "As built: HF3 (start)"): every
# T*.hs of DIR (default test/haskell/typecheck, Haskell 2010) read natively, renamed (rename-check's judge first), elaborated
# by arbace.repr.haskell.typecheck and judged against the helper's tc verb (GHC's types of the module's things, its
# desugared Core with the types erased): the types alpha-equivalent, the evidence equal; then the negative control (the
# elaborator with defaulting's order reversed and superclass-implied constraints kept) must differ from GHC on some module.
# Light: a few seconds a module. Work in .tmp/repr-haskell/typecheck-check/
typecheck_check() {
  case ${1:-} in *.txt) typecheck_list "$1"; return ;; esac
  local d=${1:-$root/test/haskell/typecheck} w=$rh/typecheck-check files trees=() f st=0
  rm -rf "${w:?}"; mkdir -p "$w"
  files=($(cd "$d" && ls T*.hs))
  (cd "$d" && "$helper" tc --libdir "$libdir" -o "$w/ghc" --ghc -XHaskell2010 -i. --files "${files[@]}") > "$w/ghc.log" 2>&1 || { tail -5 "$w/ghc.log" >&2; return 1; }
  (cd "$d" && "$helper" rn --libdir "$libdir" -o "$w/rn" --ghc -XHaskell2010 -i. --files "${files[@]}") > "$w/rn.log" 2>&1 || { tail -5 "$w/rn.log" >&2; return 1; }
  "$helper" iface --libdir "$libdir" -o "$w/if" --ghc -XHaskell2010 --files Prelude Data.List Data.Maybe Data.Char Control.Monad Data.Ix Data.Foldable Data.Traversable Data.Functor > "$w/if.log" 2>&1 || true
  (cd "$d" && arbace_tool -m arbace.repr.haskell.native read -o "$w/nd" --flags "-XHaskell2010" "${files[@]}" > "$w/read.log") || { tail -5 "$w/read.log" >&2; return 1; }
  local dumps=(); for f in "${files[@]}"; do dumps+=("$w/nd/$f.edn"); trees+=("$w/tree/$f.rn-tree.edn"); done
  arbace_tool -m arbace.repr.haskell.rename check --ifaces "$w/if" --local "$w/ifl" --ghc "$w/rn" -o "$w/tree" "${dumps[@]}" > "$w/rename.txt" 2>&1 || st=1
  grep '^rename-check:' "$w/rename.txt"
  arbace_tool -m arbace.repr.haskell.typecheck check --ifaces "$w/if" --local "$w/tifl" --ghc "$w/ghc" -o "$w/core" "${trees[@]}" | tee "$w/report.txt" | grep -v '^ok' || true
  grep -q '^typecheck-check: \([0-9]*\) of \1 modules equal' "$w/report.txt" || st=1
  arbace_tool -m arbace.repr.haskell.typecheck check --control true --ifaces "$w/if" --local "$w/tifl-control" --ghc "$w/ghc" -o "$w/control" "${trees[@]}" > "$w/control.txt" 2>&1 || true
  if grep -q '^typecheck-check: \([0-9]*\) of \1 modules equal' "$w/control.txt"; then
    echo "typecheck-check: the negative control passed: the judge does not tell it from GHC" >&2; st=1
  else
    echo "typecheck-check: the negative control differs from GHC ($(grep '^typecheck-check:' "$w/control.txt"))"
  fi
  return $st
}

# typecheck_list LIST: the elaborator over programs of nofib (HF4, doc/haskell/FRONTEND-SURVEY.md, "As built: HF4"), each
# a session of its own (Haskell 2010): GHC's rn and tc dumps, the interfaces of its imports, the native read, the
# renamer, then the elaborator judged as typecheck_check does. LIST's lines: `nofib PATH...` (paths under the pinned
# GHC tarball's nofib/, Main.hs or the program's own file), `known PATH CLASS...` (a program whose recorded non-pass
# is allowed, the class in words). Fails on a program neither ok nor known, or a known one whose rename differs.
# Work in .tmp/repr-haskell/typecheck-list/NAME/
typecheck_list() {
  local list=$1 w=$rh/typecheck-list kind a rest st=0 ok=0 n=0 nk=0 f pw need line
  local tb=$rh/corpus/ghc-9.14.1-src.tar.xz
  [ -f "$tb" ] || { echo "typecheck-check: $tb is missing (bin/repr-haskell corpus fetch)" >&2; return 1; }
  local -A known=()
  while read -r kind a rest; do if [ "$kind" = known ]; then known[$a]=1; fi; done < "$list"
  mkdir -p "$w"
  while read -r kind a rest <&3; do
    case $kind in nofib) ;; *) continue ;; esac
    for f in $a $rest; do
      n=$((n + 1)); pw=$w/$(echo "$f" | tr / _); rm -rf "${pw:?}"; mkdir -p "$pw/src"
      tar -xJf "$tb" -O "ghc-9.14.1/nofib/$f" > "$pw/src/Main.hs" 2> "$pw/tar.log" || { echo "nofib $f: not in the tarball" >&2; st=1; continue; }
      (cd "$pw/src" && "$helper" rn --libdir "$libdir" -o "$pw/ghc-rn" --ghc -XHaskell2010 --files Main.hs) > "$pw/ghc.log" 2>&1 \
        && (cd "$pw/src" && "$helper" tc --libdir "$libdir" -o "$pw/ghc" --ghc -XHaskell2010 --files Main.hs) >> "$pw/ghc.log" 2>&1 \
        || { echo "nofib $f: GHC rejects it" >&2; st=1; continue; }
      need="Prelude $(grep -h '^import' "$pw/src/Main.hs" | sed 's/qualified//; s/safe//' | awk '{print $2}' | sed 's/(.*//' | sort -u | tr '\n' ' ')"
      # shellcheck disable=SC2086
      "$helper" iface --libdir "$libdir" -o "$pw/if" --ghc -XHaskell2010 --files $need > "$pw/if.log" 2>&1 || true
      (cd "$pw/src" && arbace_tool -m arbace.repr.haskell.native read -o "$pw/nd" --flags "-XHaskell2010" Main.hs) > "$pw/read.log" 2>&1 || { echo "nofib $f: the native reader rejects it" >&2; st=1; continue; }
      arbace_tool -m arbace.repr.haskell.rename check --ifaces "$pw/if" --local "$pw/ifl" --ghc "$pw/ghc-rn" -o "$pw/out" "$pw/nd/Main.hs.edn" > "$pw/rn.txt" 2>&1 || true
      grep -q '1 of 1 modules equal' "$pw/rn.txt" || { echo "nofib $f: the renamer differs ($pw/rn.txt)" >&2; st=1; continue; }
      arbace_tool -m arbace.repr.haskell.typecheck check --ifaces "$pw/if" --local "$pw/tifl" --ghc "$pw/ghc" -o "$pw/core" "$pw/out/Main.hs.rn-tree.edn" > "$pw/tc.txt" 2>&1 || true
      line=$(head -1 "$pw/tc.txt")
      case $line in
        ok*) ok=$((ok + 1)); [ -z "${known[$f]:-}" ] || echo "nofib $f: known, and ok now" ;;
        *) if [ -n "${known[$f]:-}" ]; then nk=$((nk + 1)); else echo "nofib $f: $line ($pw/tc.txt)" >&2; st=1; fi ;;
      esac
    done
  done 3< "$list"
  echo "typecheck-check list: $ok of $n programs equal, $nk known non-passes"
  return $st
}

# native_check [LIST]: the native check (test/haskell/native-check.txt by default)
native_check() {
  local list=${1:-$root/test/haskell/native-check.txt} w=$rh/native-check dir flags key src
  corpus_fetch ghc-9.14.1 > "$TMPDIR/repr-haskell-fetch.txt"
  rm -rf "$w"; mkdir -p "$w"
  local pl; pl=$(mktemp "$TMPDIR/repr-haskell-plan.XXXXXX")
  corpus_plan ghc-9.14.1 all > "$pl"
  : > "$w/list.txt"
  local d f rest hargs mf
  while read -r d f rest; do
    case $d in ''|'#'*) continue ;; esac
    hargs=""
    if [ "${d#test:}" != "$d" ]; then
      # a copy of the test directory (hsc2hs writes its output beside the .hsc)
      dir=$w/src/${d#test:}; flags=${rest:--XGHC2021 -haddock}; key=test/${d#test:}
      [ -d "$dir" ] || { mkdir -p "$dir" && cp -R "$root/test/haskell/${d#test:}/." "$dir/"; }
    else
      IFS=$'\t' read -r _ dir flags _ hargs < <(grep -P "^$d\t" "$pl")
      [ -n "$dir" ] || { echo "repr-haskell: native-check: no package $d" >&2; continue; }
      dir=$srcroot/$dir; key=$d
    fi
    # the helper's options as the corpus's dumps give them: hsc2hs's arguments (R6), the flags
    # shellcheck disable=SC2086
    (cd "$dir" && "$helper" dump -o "$w/dumps/$key" --libdir "$libdir" --corpus ghc-9.14.1 \
       --helper-hash "sha256:$(helper_hash)" --repo "$root" $hargs --ghc $flags --files "$f") 2>> "$w/helper.err" || true
    # an .hsc module is its hsc2hs output X.hs (R6); a module the helper preprocessed (CPP,
    # unlit, hsc2hs) is read from the text GHC parses, the helper's cpp verb's X.hspp
    mf=$f; [ "${f%.hsc}" != "$f" ] && mf=${f%c}
    src=$dir/$f
    if [ "$mf" != "$f" ] || grep -q ':cpp {\|:unlit true\|:hsc2hs {' "$w/dumps/$key/$mf.edn" 2> "$TMPDIR/repr-haskell-grep.txt"; then
      # shellcheck disable=SC2086
      (cd "$dir" && "$helper" cpp -o "$w/hspp/$key" --libdir "$libdir" --repo "$root" $hargs \
         --ghc $flags --files "$f") 2>> "$w/helper.err" || true
      src=$w/hspp/$key/$mf.hspp
    fi
    printf '%s %s %s\n' "$w/dumps/$key/$mf.edn" "$src" "$mf" >> "$w/list.txt"
  done < "$list"
  rm -f "$pl"
  arbace_tool -m arbace.repr.haskell.native check --list "$w/list.txt" --report "$w/report.edn"
}

cmd=${1:-}
[ $# -gt 0 ] && shift
case $cmd in
  helper) build ;;
  corpus)
    sub=${1:-list}; [ $# -gt 0 ] && shift
    case $sub in
      fetch) ghc_check; corpus_fetch "$@"; echo "$srcroot" ;;
      list) ghc_check
            for w in modules hsc boot; do
              corpus_plan "${1:-ghc-9.14.1}" $w | while IFS=$'\t' read -r n _ _ fs; do
                for f in $fs; do echo "$w $n $f"; done
              done
            done ;;
      *) echo "usage: bin/repr-haskell corpus fetch|list [CORPUS]" >&2; exit 2 ;;
    esac ;;
  dump)
    ghc_check; build
    if [ "${1:-}" = --full ] && [ "${2:-}" = --corpus ]; then
      c=${3:-ghc-9.14.1}; corpus_fetch "$c"; dump_corpus "$c" "$rh/dumps/$c-full" --full
      cat "$rh/dumps/$c-full"/*.err >&2; exit 0
    fi
    if [ "${1:-}" = --corpus ]; then
      c=${2:-ghc-9.14.1}; corpus_fetch "$c"; dump_corpus "$c" "$rh/dumps/$c"
      cat "$rh/dumps/$c"/*.err >&2; exit 0
    fi
    out=$work/out; full=""; files=(); gflags=()
    while [ $# -gt 0 ]; do
      case $1 in
        -o) out=$2; shift 2 ;;
        --full) full=--full; shift ;;
        --ghc) shift; gflags=("$@"); break ;;
        *) files+=("$1"); shift ;;
      esac
    done
    hsdump dump $full -o "$out" --ghc "${gflags[@]}" --files "${files[@]}" ;;
  read)
    if [ "${1:-}" = --reader ]; then
      reader=${2:-helper}; shift 2
      if [ "$reader" = native ]; then native_read "$@"; exit $?; fi
      [ "$reader" = helper ] || { echo "repr-haskell: --reader native|helper" >&2; exit 2; }
    fi
    full=""
    if [ "${1:-}" = --full ] && [ "${2:-}" = --corpus ]; then full=--full; shift; fi
    if [ "${1:-}" = --corpus ]; then
      shift; c=${1:-ghc-9.14.1}
      ghc_check; build; corpus_fetch "$c"
      dump_corpus "$c" "$rh/dumps/$c${full:+-full}" $full
      out=$rh/forms/$c${full:+-full}
      rm -rf "$out"
      read_files --jobs "$jobs" -o "$out" --report "$out.report.edn" --root "$rh/dumps/$c${full:+-full}"
    else
      read_files --jobs "$jobs" "$@"
    fi ;;
  print) arbace_tool -m arbace.repr.haskell print --jobs "$jobs" "$@" ;;
  roundtrip) ghc_check; roundtrip "$@" ;;
  native-check) ghc_check; build; native_check "$@" ;;
  tables) ghc_check; tables "$@" ;;
  rn-dump) ghc_check; build; out=$work/out; [ "${1:-}" = -o ] && { out=$2; shift 2; }; flags=(); files=()
           while [ $# -gt 0 ]; do case $1 in --ghc) shift; flags=("$@"); break ;; *) files+=("$1"); shift ;; esac; done
           hsdump rn -o "$out" --ghc "${flags[@]}" --files "${files[@]}" ;;
  iface) ghc_check; build; out=$work/out; [ "${1:-}" = -o ] && { out=$2; shift 2; }; flags=(); mods=()
         while [ $# -gt 0 ]; do case $1 in --ghc) shift; flags=("$@"); break ;; *) mods+=("$1"); shift ;; esac; done
         hsdump iface -o "$out" --ghc "${flags[@]}" --files "${mods[@]}" ;;
  rename-check) ghc_check; build; rename_check "$@" ;;
  tc-dump) ghc_check; build; out=$work/out; [ "${1:-}" = -o ] && { out=$2; shift 2; }; flags=(); files=()
           while [ $# -gt 0 ]; do case $1 in --ghc) shift; flags=("$@"); break ;; *) files+=("$1"); shift ;; esac; done
           hsdump tc -o "$out" --ghc "${flags[@]}" --files "${files[@]}" ;;
  typecheck-check) ghc_check; build; typecheck_check "$@" ;;
  test) exec "$root/bin/lib/repr-haskell/test" "$@" ;;
  *) sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; exit 2 ;;
esac

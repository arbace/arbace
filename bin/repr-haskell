#!/bin/bash
# repr/haskell, Haskell's bridge (doc/haskell/SPEC.md, doc/haskell/HASKELL-NOTES.md): Haskell
# modules as Haskell forms (read) and Haskell forms as Haskell modules (print), through the
# helper tools/hsdump on the host's GHC (Alpine's ghc 9.14.1, pinned by tools/hsdump/GHC_VERSION;
# SPEC §8, HS9). The converter and the printer are Arbace (arbace.repr.haskell, .convert,
# .print), evaluated from the checkout: repr/haskell is not one of the tools the executable
# embeds (arbace/j2g/embed.ae's excluded list).
#
#   bin/repr-haskell genprimopcode [CORPUS]  build GHC's genprimopcode and primops.txt (the interface
#                                 level's, below) and print their paths (bin/hsi dumps' generated modules)
#   bin/repr-haskell helper       build the helper into .tmp/hsdump/hsdump (the host's ghc; rebuilt
#                                 when its sources, its pin or the ghc library's unit change)
#   bin/repr-haskell corpus fetch [CORPUS]
#                                 the corpus's tarball into .tmp/repr-haskell/corpus/ (downloaded
#                                 once when missing, checked by its SHA-256; in a linked worktree or the
#                                 clean clone the main checkout's, hard-linked, never downloaded: batch 2's
#                                 proposal 8 (a), bin/lib/repr-haskell/inputs.bash), its packages
#                                 extracted, their configure scripts run where the corpus says
#                                 (:configure; default CORPUS ghc-9.14.1: test/haskell/corpus-ghc-9.14.1.edn)
#   bin/repr-haskell corpus list [CORPUS]
#                                 the corpus's modules, one per line: modules|hsc|boot, package, file
#                                 (the modules, R6's .hsc modules and boot files; every one converted)
#   bin/repr-haskell dump --corpus [CORPUS]   dump the corpus into .tmp/repr-haskell/dumps/CORPUS/PKG/ (live: the helper, GHC)
#   bin/repr-haskell record-corpus [CORPUS]    ORS12: the corpus's originals dumped (both modes) and parsed to trees (both modes) by the helper
#                                 and packed into test/haskell/records/haskell-{dumps,dumps-full,trees,trees-full}-CORPUS (pins and manifests committed, the packs in
#                                 the store, test/oracle-records/oracle.bash); by hand, a commit of its own naming :ghc's identity;
#                                 REPR_HASKELL_ONLY_PACKAGES="P Q" the packages named alone (the others' members kept from the pack)
#   bin/repr-haskell verify-corpus [--sample N] [CORPUS]
#                                 the helper's live outputs of N packages (default all) against the pack's members byte for byte
#                                 (ORS6 (a)'s verdict) and the crossed pair; exit 1 when entries differ under the identity the record names
#   REPR_HASKELL_LIVE=1           read --corpus and roundtrip's originals' dumps and trees made by the helper, not read from the pack
#   bin/repr-haskell dump [--full] --corpus [CORPUS]   the same with --full into dumps/CORPUS-full/
#   bin/repr-haskell dump [--full] [-o DIR] FILE... [--ghc FLAG...]
#                                 run the helper on modules (relative to the current directory) with
#                                 GHC flags; one DIR/FILE.edn each (default .tmp/hsdump/out); --full
#                                 (mode :full, SPEC §7.2, §8.2) adds the exact-print annotations (as
#                                 discarded forms), the text and GHC's lexer's tokens with the comments,
#                                 and a CPP module's module view (DIR/FILE.view). R6: an .hsc FILE
#                                 through hsc2hs first (--hsc2hs-arg A, before --ghc; its output X.hs
#                                 beside it, the module), a literate one through unlit, an .hsig as a
#                                 signature
#   bin/repr-haskell read [-o DIR] FILE.edn...
#                                 convert dumps to Haskell forms: one .ae per module under DIR (default
#                                 .tmp/repr-haskell/forms/files), each read back and compared; a dump
#                                 --full to forms of mode :full
#   bin/repr-haskell read [--full] --corpus [CORPUS]
#                                 dump the corpus (.tmp/repr-haskell/dumps/CORPUS/PKG/) and convert it
#                                 into .tmp/repr-haskell/forms/CORPUS/PKG/ (SPEC §2.1);
#                                 report .tmp/repr-haskell/forms/CORPUS.report.edn; --full: mode :full,
#                                 into dumps/CORPUS-full/ and forms/CORPUS-full/
#   bin/repr-haskell print [-o DIR] [--layout braces|layout|full] FORMS.ae...
#                                 the printer (SPEC §7.4): one .hs per forms file into DIR (default
#                                 .tmp/repr-haskell/printed), at the forms' :file; the braces layout,
#                                 or for forms of mode :full the full layout (the original text, byte
#                                 for byte; --layout braces: the braces layout); --layout layout: the
#                                 layout layout (Haskell's layout rule, as a person writes it; R4)
#   bin/repr-haskell roundtrip [--only REGEX] [CORPUS]
#                                 the round trip's tree level (SPEC §9.1, §9.2) over the corpus:
#                                 read, print into .tmp/repr-haskell/cand/CORPUS/PKG/, and compare
#                                 GHC's trees (hsdump tree: showAstData BlankSrcSpan
#                                 BlankEpAnnotations after eraseEpLayout) and the start lines of
#                                 every located node (hsdump lines) of the original and the printed
#                                 module; fails on a difference test/haskell/roundtrip-CORPUS-known.edn
#                                 does not list, and on a listed one that no longer occurs. Report
#                                 .tmp/repr-haskell/cand/CORPUS.report.edn
#   bin/repr-haskell roundtrip --iface [CORPUS]
#                                 the tree level, then the interface level (SPEC §9.1, §9.3; R2):
#                                 each package compiled by ghc --make (the corpus's :iface :opt,
#                                 -haddock), once from the originals and once with the printed
#                                 modules in their places, under .tmp/repr-haskell/iface/CORPUS/;
#                                 ghc --show-iface of each converted module's two interfaces, compared
#                                 after the normalizations of mode :lines (the self-recompilation
#                                 hashes dropped, spans and SrcLoc columns in unfoldings as lines,
#                                 fingerprints blanked); fails on a difference
#                                 test/haskell/roundtrip-CORPUS-iface-known.edn does not list, and on
#                                 a listed one that no longer occurs. Report
#                                 .tmp/repr-haskell/iface/CORPUS.report.edn. --iface-only: the
#                                 interface level alone, over the modules printed by an earlier run
#   bin/repr-haskell roundtrip --text [CORPUS]
#                                 then the text level (SPEC §9.1, mode :full; R3): the corpus dumped
#                                 with --full, converted in mode :full, printed in the full layout into
#                                 .tmp/repr-haskell/cand-text/CORPUS/PKG/, each module compared byte for
#                                 byte with its original (a CPP module: its module view, SPEC §2.8),
#                                 then GHC's trees in mode :full (hsdump tree --full: every span,
#                                 annotation and comment) and lines of both; fails on a difference
#                                 test/haskell/roundtrip-CORPUS-text-known.edn does not list, and on a
#                                 listed one that no longer occurs. Report
#                                 .tmp/repr-haskell/cand-text/CORPUS.report.edn. --text-only: the text
#                                 level alone. With --iface too: tree, interface, text
#   bin/repr-haskell roundtrip --layout [CORPUS]
#                                 then the tree level of the layout layout (SPEC §7.4, 2; R4): the
#                                 same forms printed by Haskell's layout rule into
#                                 .tmp/repr-haskell/cand-layout/CORPUS/PKG/, GHC's trees and lines
#                                 compared as the braces layout's; known differences
#                                 test/haskell/roundtrip-CORPUS-layout-known.edn, report
#                                 .tmp/repr-haskell/cand-layout/CORPUS.report.edn. With --iface, the
#                                 interface level of both layouts, each package's three sides
#                                 compiled concurrently (known differences
#                                 test/haskell/roundtrip-CORPUS-layout-iface-known.edn, report
#                                 .tmp/repr-haskell/iface/CORPUS.layout.report.edn). --layout-only:
#                                 the layout layout alone (dump, convert, print, trees; with --iface
#                                 its interfaces only)
#   bin/repr-haskell read --reader native [--full] [-o DIR] FILE... [--hsc2hs-arg A...] [--ghc FLAG...]
#                                 the native reader (doc/haskell/NATIVE.md): each module read by
#                                 Arbace code alone (arbace.repr.haskell.native: GHC 9.14.1's lexer,
#                                 its Happy grammar's tables and actions, the Haddock pass), its dump
#                                 into DIR/FILE.edn (default .tmp/repr-haskell/native), then converted
#                                 to forms as the helper's dumps are (DIR/forms/); unlit and CPP as
#                                 GHC's driver runs them, natively (arbace.repr.haskell.driver, the GHC
#                                 installation read as data); an .hsc module through hsc2hs by the
#                                 helper's `cpp` verb first (DIR/hspp/)
#   bin/repr-haskell tables [--check]
#                                 the native parser's tables (arbace/repr/haskell/tables.ae) generated
#                                 from GHC's grammar, the pinned tarball's compiler/GHC/Parser.y,
#                                 by arbace.repr.haskell.happy (Happy's LALR(1) construction in
#                                 Arbace); --check: the productions and the tables against the
#                                 tarball's generated Parser.hs (Happy's own), state for state, and
#                                 the committed tables.ae against a fresh generation
#   bin/repr-haskell native-check [--full] [LIST]
#                                 the native reader against the helper over a list of modules
#                                 (default test/haskell/native-check.txt: lines DIR FILE [FLAG...],
#                                 DIR a corpus package or test:SUBDIR of test/haskell/): each module
#                                 dumped by the helper (mode :lines), preprocessed natively (against
#                                 the helper's cpp verb's text, byte for byte), read natively, the
#                                 trees and header pragmas compared as data, then both converted and
#                                 the forms compared as text; report
#                                 .tmp/repr-haskell/native-check/report.edn; --full: mode :full (the
#                                 helper's dump --full; the text and the lexer's tokens with the
#                                 comments compared too, the native forms printed in the full layout
#                                 against the text, byte for byte)
#   bin/repr-haskell test [--oracle | --record | --verify-records]
#                                 (ORS12: on the records, no GHC; --oracle with GHC reading the print; bin/lib/repr-haskell/test)
#                                 the spec's cases (test/haskell/; bin/lib/repr-haskell/test): the
#                                 reader's samples, the worked example converted and its round trip,
#                                 the interface level's normalizations (test/haskell/iface/), the
#                                 worked example in mode :full printed back byte for byte
#   bin/repr-haskell rn-dump [-o DIR] FILE... [--ghc FLAG...]
#                                 HF1: GHC's renamer's output (the helper's rn verb, tools/hsdump/HsRn.hs) as the
#                                 reduced GhcRn forms, one DIR/FILE.rn.edn per module (the modules load together,
#                                 in dependency order; -i. finds the ones the others import): every located name
#                                 resolved, the operator trees, the binding groups, the imports, the exports
#   bin/repr-haskell iface [-o DIR] MODULE... [--ghc FLAG...]
#                                 HF1: the libraries' interfaces as forms (the helper's iface verb: exports with
#                                 each name's defining module, fixities, the things defined with their types as
#                                 GHC prints them), the modules defining the names too; one DIR/MODULE.iface.edn each
#   bin/repr-haskell tc-dump [-o DIR] FILE... [--ghc FLAG...]
#                                 HF3: GHC's typed output (the helper's tc verb): the module's things with their types in the
#                                 iface verb's forms, its instances, its desugared Core (-O0) with the types erased, DIR/FILE.tc.edn
#   bin/repr-haskell stg-check [DIR]
#                                 HF5-HF6: the match compiler, CorePrep, CoreToStg over DIR's S*.hs (default test/haskell/stg):
#                                 Core against the tc dump, STG against GHC's -O0 STG, each program run on hsi from our STG
#                                 against GHC's output (HSI_LIBS: the libraries' STG dumps); the -O0 Simplifier's Core
#                                 (arbace.repr.haskell.simplify) against GHC's after its Simplifier (arbace.repr.haskell.simplcmp)
#                                 The front end runs GHC's -O0 Simplifier (doc/haskell/FRONTEND-SURVEY.md, "As built: the -O0
#                                 Simplifier") unless REPR_HASKELL_SIMPL=0 (the desugarer's simple optimiser alone)
#   bin/repr-haskell run-check [--nofib] [--record] [--record-ref] [ID...]
#                                 HF5-HF6's decision 3 (a): the run corpus (hsi's samples and synthetic programs,
#                                 test/haskell/eval/) compiled by Arbace's front end alone (arbace.repr.haskell.front: native
#                                 read, rename, elaborate, desugar with the simple optimiser, STG; no GHC but the pinned
#                                 interfaces) and run on hsi, each judged against GHC's -O0 run (test/haskell/ref-ghc914.edn:
#                                 status, stdout and stderr) and the record test/haskell/run-check.edn (a change either way
#                                 fails; --record rewrites it, the classes kept); the negative control (each run against the
#                                 next program's reference) must fail. HSI_LIBS: the libraries' STG dumps. --nofib: the
#                                 single-module nofib programs of test/haskell/run-check-nofib.txt (the pinned GHC tarball's
#                                 nofib/, REPR_HASKELL_NOFIB an extracted copy) against test/haskell/ref-nofib.edn (GHC's -O0
#                                 runs in fast mode, --record-ref with the host's GHC), record test/haskell/run-check-nofib.edn;
#                                 hsi's caps ARBACE_MEM_GIB (GiB, default 2) and HSI_TIMEOUT (CPU seconds, default 120)
#   bin/repr-haskell typecheck-check [DIR|LIST.txt]
#                                 HF3: the elaborator (arbace.repr.haskell.typecheck) against the tc dump over DIR's T*.hs
#                                 (default test/haskell/typecheck): types and evidence equal, the negative control differs;
#                                 HF4: a LIST.txt (test/haskell/typecheck-check.txt) the nofib programs it names instead,
#                                 each a session of its own, the known non-passes in their recorded classes
#   bin/repr-haskell rename-check [LIST]
#                                 HF2: the renamer (arbace.repr.haskell.rename) against the rn dump over the lists'
#                                 modules (default test/haskell/rename-check.txt: 47 samples, 33 modules of
#                                 ghc-internal's source and 21 nofib programs); the names, operator trees, groups, imports and exports
#                                 equal; reports in .tmp/repr-haskell/rename-check/NAME/
#
# Environment: REPR_HASKELL_HELPER (a helper executable already built, for the verbs that run it); REPR_HASKELL_JOBS (parallel helper and converter runs, default the cores, at most
# 32); REPR_HASKELL_PACKAGES (the packages the interface level compiles at once, default 4);
# ARBACE_HOST_EXE (the Arbace executable, bin/lib/host.bash; default stage 0).
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash" # TMPDIR: .tmp/tmp when unset
. "$root/bin/lib/tools.bash"
. "$root/bin/lib/repr-haskell/records.bash"
. "$root/bin/lib/repr-haskell/inputs.bash" # batch 2's proposal 8 (a): the main checkout's fetched inputs
work=$root/.tmp/hsdump
helper=${REPR_HASKELL_HELPER:-$work/hsdump}
rh=$root/.tmp/repr-haskell
jobs=${REPR_HASKELL_JOBS:-$(nproc)}
[ "$jobs" -gt 32 ] && jobs=32
pin=$(cat "$root/tools/hsdump/GHC_VERSION")
libdir=${libdir:-}
# ORS12 (doc/ORACLE-RECORDS-SURVEY.md, "As built: Haskell"): GHC's reading of the corpus's originals (the helper's dumps and trees) is
# read from the packs haskell-KIND-CORPUS (test/haskell/records/) unless REPR_HASKELL_LIVE=1 (the helper runs, as before)
live=${REPR_HASKELL_LIVE:-}

ghc_check() {
  command -v ghc > "$TMPDIR/repr-haskell-which.txt" || { echo "repr-haskell: no ghc (Alpine's ghc package, doc/ALPINE.md)" >&2; return 1; }
  local v
  v=$(ghc --numeric-version)
  if [ "$v" != "$pin" ]; then
    echo "repr-haskell: the host's GHC is $v, tools/hsdump/GHC_VERSION pins $pin (SPEC §8.4: moving the pin is a recorded decision)" >&2
    return 1
  fi
  libdir=$(ghc --print-libdir)
}

# the unit id of the ghc library: ghc-VERSION-HASH
ghc_unit() {
  local f
  for f in "$libdir"/package.conf.d/ghc-"$pin"-*.conf; do basename "$f" .conf; return; done
}

helper_hash() {
  cat "$root"/tools/hsdump/*.hs "$root/tools/hsdump/GHC_VERSION" | sha256sum | cut -c1-64
}

build() {
  ghc_check
  [ -z "${REPR_HASKELL_HELPER:-}" ] || return 0
  mkdir -p "$work"
  local key
  key="$(helper_hash) $(ghc_unit) -threaded"
  (
    flock 7
    if [ -x "$helper" ] && [ -f "$work/key" ] && [ "$(cat "$work/key")" = "$key" ]; then exit 0; fi
    echo "== repr-haskell: building the helper (ghc $pin, $(ghc_unit))" >&2
    mkdir -p "$work/obj"
    ghc -O1 -threaded -package ghc "-optP-DGHC_PIN=\"$pin\"" "-i$root/tools/hsdump" -outputdir "$work/obj" -o "$helper.new.$$" \
      "$root/tools/hsdump/HsDump.hs" > "$work/build.log" 2>&1 ||
      { cat "$work/build.log" >&2; rm -f "$helper.new.$$"; exit 1; }
    mv -f "$helper.new.$$" "$helper"
    echo "$key" > "$work/key"
  ) 7> "$work/build.lock"
}

hsdump() {
  "$helper" "$1" --libdir "$libdir" --helper-hash "sha256:$(helper_hash)" "${@:2}"
}

corpus_file() {
  local c=${1:-ghc-9.14.1} f
  f=$root/test/haskell/corpus-$c.edn
  [ -f "$f" ] || { echo "repr-haskell: no corpus $c ($f)" >&2; return 1; }
  echo "$f"
}

# corpus_plan CORPUS WHAT: one line per package, tab-separated: name, directory (in the tarball's
# root), the GHC flags (space-separated, $libdir expanded), then the files (WHAT: modules, hsc, boot;
# all: the three, every module the corpus converts, R6), and for all a fifth field: the helper's
# hsc2hs arguments (--hsc2hs-arg A for each of the package's :hsc-flags; $repo expanded)
corpus_plan() {
  corpus_plan_raw "$@" | sed -e "s|\\\$libdir|$libdir|g" -e "s|\\\$repo|$root|g"
}
# the plan as the corpus writes it ($libdir and $repo not expanded: the records' keys name no path of the host); the packages
# named by REPR_HASKELL_ONLY_PACKAGES alone when it is set (the sample recordings and verifies)
corpus_plan_raw() {
  local f
  f=$(corpus_file "$1")
  arbace_tool -e "(let [c (read-string (slurp \"$f\")) what (keyword \"$2\")
                        j (fn [xs] (apply str (interpose \" \" xs)))]
    (doseq [p (:packages c)]
      (println (str (:name p) \"\t\" (:dir p) \"\t\"
        (j (concat [(str \"-X\" (:language p))] (map #(str \"-X\" %) (:extensions p)) [\"-haddock\"] (:ghc-flags p)))
        \"\t\" (j (map #(if (vector? %) (second %) %) (if (= what :all) (concat (:modules p) (:hsc p) (:boot p)) (get p what))))
        (if (= what :all) (str \"\t\" (j (mapcat (fn [a] [\"--hsc2hs-arg\" a]) (:hsc-flags p)))) \"\")))))" |
    awk -F'\t' -v o="${REPR_HASKELL_ONLY_PACKAGES:-}" 'o == "" || index(" " o " ", " " $1 " ")'
}

corpus_fetch() {
  local c=${1:-ghc-9.14.1} f url sha size name dir tb
  f=$(corpus_file "$c")
  read -r url sha size name <<< "$(arbace_tool -e "(let [t (:tarball (read-string (slurp \"$f\")))] (println (:url t) (:sha256 t) (:size t) (:root t)))")"
  dir=$rh/corpus
  tb=$dir/$(basename "$url")
  mkdir -p "$dir"
  (
    flock 8
    # a linked worktree's or the clean clone's tarball is the main checkout's (haskell_take: no download there)
    if [ ! -f "$tb" ] && ! haskell_take "$tb"; then
      echo "== repr-haskell: fetching $url" >&2
      curl -fsSL -o "$tb.part" "$url" && mv "$tb.part" "$tb"
    fi
    if [ "$(sha256sum < "$tb" | cut -c1-64)" != "$sha" ]; then
      echo "repr-haskell: $tb: SHA-256 differs from the corpus's $sha" >&2
      exit 1
    fi
    local dirs
    # each package's :dir, or its :extract when the tarball hard-links its files from a sibling
    # (containers/containers' from containers/containers-tests)
    # (each once: R6's Setup scripts share their packages' directories)
    dirs=$(arbace_tool -e "(doseq [d (distinct (map #(or (:extract %) (:dir %)) (:packages (read-string (slurp \"$f\")))))] (println d))" | sed "s|^|$name/|" | tr '\n' ' ')
    # what the interface level needs of the tarball besides the packages (genprimopcode)
    dirs="$dirs $(iface_conf "$c" :extract | tr ' ' '\n' | sed "s|^|$name/|" | tr '\n' ' ')"
    if [ ! -f "$dir/$name.extracted" ] || [ "$(cat "$dir/$name.extracted")" != "$sha $dirs" ]; then
      rm -rf "${dir:?}/$name"
      # shellcheck disable=SC2086
      tar -xJf "$tb" -C "$dir" $dirs
      echo "$sha $dirs" > "$dir/$name.extracted"
    fi
    # the headers a package's configure script makes (Cabal's build-type Configure: unix,
    # directory, process, time; R5), made once in the extracted tree, as Cabal makes them
    local pname pdir pfiles f need
    local pl; pl=$(mktemp "$TMPDIR/repr-haskell-plan.XXXXXX")
    corpus_configure "$c" > "$pl"
    while IFS=$'\t' read -r pname pdir pfiles; do
      # the native reads take the products from the pack (native_place_inputs): no C compiler at check time
      [ -n "$live" ] || [ ! -f "$ninputs_pin" ] || [ -n "${REPR_HASKELL_CONFIGURE:-}" ] && continue
      need=""
      for f in $pfiles; do [ -f "$dir/$name/$pdir/$f" ] || need=1; done
      [ -n "$need" ] || continue
      echo "== repr-haskell: $pname: configure" >&2
      (cd "$dir/$name/$pdir" && sh ./configure > configure.log 2>&1) ||
        { tail -20 "$dir/$name/$pdir/configure.log" >&2; echo "repr-haskell: $pname: configure failed" >&2; exit 1; }
    done < "$pl"
    rm -f "$pl"
  ) 8> "$dir/fetch.lock"
  srcroot=$dir/$name
}

# corpus_configure CORPUS: one line per package with a :configure, tab-separated: name, directory,
# the files its configure script makes
corpus_configure() {
  local f
  f=$(corpus_file "$1")
  arbace_tool -e "(let [c (read-string (slurp \"$f\"))]
    (doseq [p (:packages c) :when (seq (:configure p))]
      (println (str (:name p) \"\t\" (:dir p) \"\t\" (apply str (interpose \" \" (:configure p)))))))"
}

# ---- the corpus's records (ORS12): four packs haskell-KIND-CORPUS (test/haskell/records/), KIND one of dumps (the helper's dump, mode
# :lines), dumps-full (--full, with CPP's module views), trees and trees-full (the helper's tree of the original modules, FILE.tree and
# FILE.lines), the members PKG/FILE; a package's entries keyed by pkg_key: the source tarball's SHA-256, the helper's identity, the
# kind and the package's plan line as the corpus writes it, and the files of test/haskell/generated (cabal_macros.h, a CPP include)
corpus_kinds="dumps dumps-full trees trees-full"
corpus_pin() { echo "$root/test/haskell/records/haskell-$2-$1.sha256"; } # CORPUS KIND
pkg_key() { # CORPUS KIND PKG-PLAN-LINE
  { arbace_tool -e "(println (:sha256 (:tarball (read-string (slurp \"$(corpus_file "$1")\")))))"
    hsr_helper_hash; echo "$2"; printf '%s\n' "$3"
    (cd "$root/test/haskell/generated" && find . -type f | LC_ALL=C sort | xargs sha256sum); } | sha256sum | cut -c1-64
}
# corpus_records_get CORPUS KIND OUT: the selected packages' members into OUT/PKG/, their keys checked
corpus_records_get() {
  local c=$1 kind=$2 out=$3 pin u man name pk line want n dir flags files hargs
  pin=$(corpus_pin "$c" "$kind"); name=$(oracle_pin_name "$pin"); man=$(oracle_manifest "$pin")
  [ -f "$pin" ] && [ -f "$man" ] || { echo "UNRECORDED: no $pin (bin/repr-haskell record-corpus, by hand on a host with GHC; REPR_HASKELL_LIVE=1 runs the helper)" >&2; return 1; }
  u=$(oracle_unpack "$pin") || return 1
  mkdir -p "$out"
  corpus_plan_raw "$c" all > "$TMPDIR/repr-haskell-recplan.$$"
  while IFS=$'\t' read -r pk dir flags files hargs; do
    [ -n "$files" ] || continue
    line=$(printf '%s\t%s\t%s\t%s\t%s' "$pk" "$dir" "$flags" "$files" "$hargs")
    want=$(pkg_key "$c" "$kind" "$line")
    n=$(awk -F'\t' -v p="$pk/" 'index($1, p) == 1 {n++} END {print n + 0}' "$man")
    [ "$n" -gt 0 ] || { echo "UNRECORDED $name: $pk has no entry in $man (bin/repr-haskell record-corpus)" >&2; rm -f "$TMPDIR/repr-haskell-recplan.$$"; return 1; }
    if [ -n "$(awk -F'\t' -v p="$pk/" -v k="$want" 'index($1, p) == 1 && $2 != k {print "x"; exit}' "$man")" ]; then
      echo "STALE $name: $pk's sources' pin, the helper, the corpus's plan or test/haskell/generated changed since the record" >&2; rm -f "$TMPDIR/repr-haskell-recplan.$$"; return 1
    fi
    mkdir -p "$out/$pk"; cp -r "$u/$name/$pk/." "$out/$pk/"
  done < "$TMPDIR/repr-haskell-recplan.$$"
  rm -f "$TMPDIR/repr-haskell-recplan.$$"
}
# ---- the native reads (the crop's independence, 2026-11-07; doc/haskell/NATIVE.md, "The native reads' inputs"): the round
# trip's tree and text levels read the corpus's originals and the printed modules with the native reader (Arbace's own lexer,
# parser, unlit and C preprocessor), no GHC at check time. What GHC's installation and the host's C toolchain made, which the
# reads still consume, is the pinned pack haskell-native-inputs-ghc-9.14.1 (test/haskell/records/), recorded by hand on a host
# with GHC (bin/repr-haskell record-native-inputs): sysroot/ the host's files the native preprocessing reads under their
# absolute paths (GHC's settings, its package database, its units' include directories, the system headers the corpus's CPP
# reads), configured/ the headers the packages' configure scripts make (Cabal's build-type Configure: unix, directory,
# process, time), hsc/PKG/ the corpus's .hsc modules through hsc2hs (X.hs, and the helper's record X.hs.hspp.edn), LIBDIR the
# installation's path the reads name. REPR_HASKELL_LIVE=1: the host's GHC installation and hsc2hs, as before.
ninputs_pin=$root/test/haskell/records/haskell-native-inputs-ghc-9.14.1.sha256
nsysroot="" nin=""
# the pack's key: the source tarball's SHA-256, the helper's identity (its cpp verb ran hsc2hs) and the corpus's plan
native_inputs_key() {
  { arbace_tool -e "(println (:sha256 (:tarball (read-string (slurp \"$(corpus_file ghc-9.14.1)\")))))"
    hsr_helper_hash; REPR_HASKELL_ONLY_PACKAGES="" corpus_plan_raw ghc-9.14.1 all; corpus_configure ghc-9.14.1; } | sha256sum | cut -c1-64
}
# native_env: libdir, nsysroot and nin for the native reads: the pack's (checked: its bytes, its members, its key), or live
native_env() {
  if [ -n "$live" ]; then ghc_check; nsysroot=""; nin=""; return 0; fi
  local man u k want
  man=$(oracle_manifest "$ninputs_pin")
  [ -f "$ninputs_pin" ] && [ -f "$man" ] || { echo "repr-haskell: UNRECORDED: no $ninputs_pin (bin/repr-haskell record-native-inputs, by hand on a host with GHC; REPR_HASKELL_LIVE=1 the host's GHC)" >&2; return 1; }
  want=$(native_inputs_key)
  k=$(awk -F'\t' '!/^#/ && NF {print $2; exit}' "$man")
  [ "$k" = "$want" ] || { echo "repr-haskell: STALE haskell-native-inputs-ghc-9.14.1: the tarball's pin, the helper or the corpus's plan changed since the record (bin/repr-haskell record-native-inputs)" >&2; return 1; }
  u=$(oracle_unpack "$ninputs_pin") || return 1
  nin=$u/$(oracle_pin_name "$ninputs_pin"); nsysroot=$nin/sysroot; libdir=$(cat "$nin/LIBDIR")
  # the system include directories the preprocessor probes for (cpp.ae's host), as directories
  mkdir -p "$nsysroot/usr/include/fortify" "$nsysroot/usr/include" "$nsysroot/usr/lib/gcc/x86_64-alpine-linux-musl/15.2.0/include"
}
# native_place_inputs CORPUS: the pack's configure products and hsc2hs outputs put into the extracted tree, where Cabal's
# build would make them (corpus_fetch's configure step and the helper's hsc2hs run, live, do the same)
native_place_inputs() {
  [ -n "$nin" ] || return 0
  [ ! -d "$nin/configured" ] || cp -r "$nin/configured/." "$srcroot/"
  local name dir flags files hargs f
  while IFS=$'\t' read -r name dir flags files hargs; do
    [ -d "$nin/hsc/$name" ] || continue
    for f in $files; do case $f in *.hsc) [ -f "$nin/hsc/$name/${f%c}" ] && cp "$nin/hsc/$name/${f%c}" "$srcroot/$dir/${f%c}" ;; esac; done
  done < <(corpus_plan "$1" all)
}
# native_dump_corpus CORPUS OUT MODE [CANDDIR]: every module of the corpus read natively (mode lines or full) into
# OUT/PKG/FILE.edn, from the extracted tree, or with CANDDIR the printed modules CANDDIR/PKG/FILE (an .hsc module's X.hs);
# 40 modules a job, JOBS at a time; the reader's messages in OUT/PKG.log
native_dump_corpus() {
  local c=$1 out=$2 mode=$3 cdir=${4:-} jl name dir flags files hargs base fs hsp
  rm -rf "$out"; mkdir -p "$out"
  jl=$(mktemp "$TMPDIR/repr-haskell-njobs.XXXXXX")
  while IFS=$'\t' read -r name dir flags files hargs; do
    [ -n "$files" ] || continue
    if [ -z "$cdir" ]; then
      base=$srcroot/$dir; hsp=-
      if [ -n "$nin" ] && [ -d "$nin/hsc/$name" ]; then hsp=$nin/hsc/$name
      elif [ -n "$live" ] && printf '%s\n' $files | grep -q '\.hsc$'; then
        # live: the helper's cpp verb runs hsc2hs (X.hs beside X.hsc) and writes its record
        hsp=$out/hspp/$name; mkdir -p "$hsp"
        # shellcheck disable=SC2086
        (cd "$base" && "$helper" cpp -o "$hsp" --libdir "$libdir" --helper-hash "sha256:$(helper_hash)" --repo "$root" $hargs --ghc $flags \
           --files $(printf '%s\n' $files | grep '\.hsc$')) > "$out/$name.hsc.log" 2>&1 || true
      fi
      fs=$files
    else
      base=$cdir/$name; hsp=-
      [ -d "$base" ] || continue
      # shellcheck disable=SC2086
      fs=$(cd "$base" && printf '%s\n' $files | sed 's/\.hsc$/.hs/' | while read -r f; do [ -f "$f" ] && echo "$f"; done)
    fi
    [ -n "$fs" ] || continue
    # shellcheck disable=SC2086
    printf '%s\n' $fs | xargs -r -n 40 echo | while read -r f; do
      printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\n' "$base" "$out/$name" "$flags" "$f" "$hsp"; done >> "$jl"
  done < <(corpus_plan "$c" all)
  xargs -P "$jobs" -d '\n' -n 1 "$root/bin/lib/repr-haskell/native-job" "$mode" "$libdir" "${nsysroot:--}" < "$jl" || true
  rm -f "$jl"
}
# record_native_inputs: the pack haskell-native-inputs-ghc-9.14.1, by hand on a host with GHC (the oracle tier's): the
# configure products (corpus_fetch runs the scripts), hsc2hs's outputs (the helper's cpp verb), and the sysroot: GHC's
# settings and package database, and every host file a live native read of the whole corpus (both modes) reads in its
# preprocessing (the :cpp records' :files outside the tree)
record_native_inputs() {
  local c=ghc-9.14.1 st=$rh/records/native-inputs name nd f p pname pdir pfiles key verify=""
  [ "${1:-}" = --verify ] && { verify=1; st=$rh/records/native-inputs-verify; }
  live=1; ghc_check; build; corpus_fetch "$c"
  name=$(oracle_pin_name "$ninputs_pin"); rm -rf "$st"; nd=$st/$name; mkdir -p "$nd"
  echo "$libdir" > "$nd/LIBDIR"
  while IFS=$'\t' read -r pname pdir pfiles; do
    for f in $pfiles; do mkdir -p "$nd/configured/$pdir/$(dirname "$f")"; cp "$srcroot/$pdir/$f" "$nd/configured/$pdir/$f"; done
  done < <(corpus_configure "$c")
  echo "== record-native-inputs: a live native read of the corpus (mode :lines, then :full)" >&2
  native_dump_corpus "$c" "$st/dumps" lines
  native_dump_corpus "$c" "$st/dumps-full" full
  # hsc2hs's outputs: X.hs (beside X.hsc in the tree) and the helper's record X.hs.hspp.edn (the text X.hs.hspp is not read)
  for p in "$st"/dumps/hspp/*; do
    [ -d "$p" ] || continue
    pname=$(basename "$p"); mkdir -p "$nd/hsc/$pname"
    pdir=$(corpus_plan_raw "$c" all | awk -F'\t' -v n="$pname" '$1 == n {print $2}')
    (cd "$p" && find . -name '*.hs.hspp.edn' -printf '%P\n') | while read -r f; do
      mkdir -p "$nd/hsc/$pname/$(dirname "$f")"; cp "$p/$f" "$nd/hsc/$pname/$f"; cp "$srcroot/$pdir/${f%.hspp.edn}" "$nd/hsc/$pname/${f%.hspp.edn}"
    done
  done
  # the sysroot: the installation's settings and units, and every file outside the tree the reads' :cpp records name
  mkdir -p "$nd/sysroot$libdir/package.conf.d"
  cp "$libdir/settings" "$nd/sysroot$libdir/settings"; cp "$libdir"/package.conf.d/*.conf "$nd/sysroot$libdir/package.conf.d/"
  # the units' include directories whole (hsi's programs' own C reads the RTS's headers, HsFFI.h and Rts.h, through ci: bin/hsi check)
  for p in "$libdir"/../lib/*-ghc-"$pin"-*/*/include; do
    [ -d "$p" ] || continue
    p=$(cd "$p" && pwd); mkdir -p "$nd/sysroot$p"; cp -r "$p/." "$nd/sysroot$p/"
  done
  grep -rhoE '"(\$libdir|/)[^" ]*" "sha256:[0-9a-f]{64}"' "$st/dumps" "$st/dumps-full" --include='*.edn' | sed 's/^"\([^"]*\)".*/\1/' | sort -u |
    sed "s|^\\\$libdir|$libdir|" | while read -r p; do
      [ -f "$p" ] || continue
      mkdir -p "$nd/sysroot$(dirname "$p")"; cp "$p" "$nd/sysroot$p"
    done
  key=$(native_inputs_key)
  (cd "$nd" && find . -type f -printf '%P\n' | LC_ALL=C sort) | awk -v k="$key" '{print $0 "\t" k}' > "$st/ids"
  if [ -n "$verify" ]; then
    # the live inputs against the pack, member for member (ORS6 (a)'s verdict: a moved toolchain reported, not failed)
    local man u nd2=0 tot=0
    man=$(oracle_manifest "$ninputs_pin")
    (cd "$nd" && find . -type f -printf '%P\n' | LC_ALL=C sort | xargs sha256sum | awk '{print $2 "\t" $1}') > "$st/live.tsv"
    awk -F'\t' '!/^#/ && NF {print $1 "\t" $3}' "$man" | LC_ALL=C sort > "$st/pack.tsv"
    tot=$(wc -l < "$st/pack.tsv"); nd2=$(diff "$st/pack.tsv" "$st/live.tsv" | grep -c '^[<>]' || true)
    diff "$st/pack.tsv" "$st/live.tsv" | head -10 || true
    oracle_verdict ghc "$man" "$nd2" "$tot"
    return
  fi
  oracle_make "$ninputs_pin" "$st" "$st/ids" "bin/repr-haskell record-native-inputs" ghc
}

# corpus_live_kind CORPUS KIND DEST: the helper's outputs of KIND for the selected packages into DEST/PKG (live)
corpus_live_kind() {
  local c=$1 kind=$2 dest=$3
  case $kind in
    dumps) dump_corpus_live "$c" "$dest" ;;
    dumps-full) dump_corpus_live "$c" "$dest" --full ;;
    trees) rm -rf "$dest"; mkdir -p "$dest"; tree_jobs_live "" "$dest" /nonexistent /nonexistent ;;
    trees-full) rm -rf "$dest"; mkdir -p "$dest"; tree_jobs_live --full "$dest" /nonexistent /nonexistent ;;
  esac
  rm -f "$dest"/*.err
}
# record_corpus CORPUS: the selected packages' four kinds made live and packed (a pack a kind), the packages not selected kept from
# the pack in place; by hand (a commit of its own naming :ghc's identity)
record_corpus() {
  local c=$1 kind pin stage man name d pk line dir flags files hargs m
  for kind in $corpus_kinds; do
    pin=$(corpus_pin "$c" "$kind"); man=$(oracle_manifest "$pin"); name=$(oracle_pin_name "$pin"); stage=$rh/records/$kind
    rm -rf "$stage"; mkdir -p "$stage/$name"; : > "$stage/ids"
    if [ -f "$man" ] && [ -f "$pin" ] && d=$(oracle_unpack "$pin" 2>"$TMPDIR/repr-haskell.err"); then
      cp -a "$d/$name/." "$stage/$name/"; awk -F'\t' '!/^#/ && NF {print $1 "\t" $2}' "$man" > "$stage/ids"
    fi
    corpus_live_kind "$c" "$kind" "$stage/live"
    corpus_plan_raw "$c" all > "$stage/plan.tsv"
    while IFS=$'\t' read -r pk dir flags files hargs; do
      [ -n "$files" ] || continue
      line=$(printf '%s\t%s\t%s\t%s\t%s' "$pk" "$dir" "$flags" "$files" "$hargs")
      # the package's members replaced by the live outputs
      awk -F'\t' -v p="$pk/" 'index($1, p) != 1' "$stage/ids" > "$stage/ids.new"; mv "$stage/ids.new" "$stage/ids"
      rm -rf "${stage:?}/$name/$pk"
      [ -d "$stage/live/$pk" ] || continue
      mkdir -p "$stage/$name/$pk"; cp -r "$stage/live/$pk/." "$stage/$name/$pk/"
      (cd "$stage/$name" && find "$pk" -type f | LC_ALL=C sort) | while IFS= read -r m; do
        printf '%s\t%s\n' "$m" "$(pkg_key "$c" "$kind" "$line")"; done >> "$stage/ids"
    done < "$stage/plan.tsv"
    rm -rf "${stage:?}/live"
    oracle_make "$pin" "$stage" "$stage/ids" "bin/repr-haskell record-corpus${REPR_HASKELL_ONLY_PACKAGES:+ (REPR_HASKELL_ONLY_PACKAGES=$REPR_HASKELL_ONLY_PACKAGES)} $c" ghc || return 1
    rm -rf "$stage"
  done
}
# verify_corpus CORPUS [N]: the live outputs of N packages (default all, evenly spread) against the packs' members byte for byte,
# ORS6 (a)'s verdict, and the crossed pair
verify_corpus() {
  local c=$1 sample=${2:-} pin man name u kind pk ndiff=0 total=0 d=$rh/verify first="" last="" pks=() i j m
  mkdir -p "$rh"; corpus_plan_raw "$c" all | cut -f1 > "$rh/verify.pkgs"; mapfile -t pks < "$rh/verify.pkgs"
  if [ -n "$sample" ] && [ "$sample" -lt "${#pks[@]}" ]; then
    local picked=(); for ((i = 0; i < sample; i++)); do j=$(( i * ${#pks[@]} / sample )); picked+=("${pks[$j]}"); done; pks=("${picked[@]}")
  fi
  rm -rf "$d"; mkdir -p "$d"
  for kind in $corpus_kinds; do
    pin=$(corpus_pin "$c" "$kind"); man=$(oracle_manifest "$pin"); name=$(oracle_pin_name "$pin")
    u=$(oracle_unpack "$pin") || return 1
    REPR_HASKELL_ONLY_PACKAGES="${pks[*]}" corpus_live_kind "$c" "$kind" "$d/$kind"
    for pk in "${pks[@]}"; do
      [ -d "$d/$kind/$pk" ] || continue
      while IFS= read -r m; do
        total=$((total + 1)); [ -n "$first" ] || first=$d/$kind/$pk/$m; last=$u/$name/$pk/$m
        if [ ! -f "$u/$name/$pk/$m" ]; then echo "verify: $name/$pk/$m: UNRECORDED"; ndiff=$((ndiff + 1))
        elif cmp -s "$d/$kind/$pk/$m" "$u/$name/$pk/$m"; then :
        else echo "verify: $name/$pk/$m: DIFFERS"; ndiff=$((ndiff + 1)); fi
      done < <(cd "$d/$kind/$pk" && find . -type f | sed 's|^\./||' | LC_ALL=C sort)
    done
  done
  oracle_verdict ghc "$(oracle_manifest "$(corpus_pin "$c" dumps)")" "$ndiff" "$total" || return 1
  if [ "$total" -ge 2 ] && cmp -s "$first" "$last"; then echo "verify: FAILED: the crossed pair is equal: control not judged"; return 1
  elif [ "$total" -ge 2 ]; then echo "verify: the crossed pair differs (control passed)"; fi
}

# dump_corpus CORPUS OUT: every module of the corpus dumped into OUT/PKG/FILE.edn (a module the
# helper fails on is written as (hsdump/error ...), which the conversion reports); R6: the .hsc
# modules through hsc2hs (by the helper, its output X.hs beside X.hsc in the extracted tree, as a
# Cabal build's; the dump X.hs.edn), the boot files and the literate modules too
dump_corpus() {
  if [ -z "$live" ]; then rm -rf "$2"; corpus_records_get "$1" "dumps${3:+-full}" "$2"; return; fi
  dump_corpus_live "$@"
}
dump_corpus_live() {
  local c=$1 out=$2 full=${3:-} name dir flags files hargs hh
  rm -rf "$out"
  mkdir -p "$out"
  hh=sha256:$(helper_hash)
  local pl; pl=$(mktemp "$TMPDIR/repr-haskell-plan.XXXXXX")
  corpus_plan "$c" all > "$pl"
  while IFS=$'\t' read -r name dir flags files hargs; do
    [ -n "$files" ] || continue
    # shellcheck disable=SC2086
    (cd "$srcroot/$dir" && printf '%s\n' $files | xargs -P "$jobs" -n 8 \
      "$helper" dump $full -o "$out/$name" --libdir "$libdir" --corpus "$c" --helper-hash "$hh" \
        --repo "$root" $hargs --ghc $flags --files) 2> "$out/$name.err" || true
  done < "$pl"
  rm -f "$pl"
}

# tree_jobs MODE ORIG CAND CANDOUT [reuse]: the helper's trees (hsdump tree, MODE "" or --full)
# of the originals (in the corpus's tree, into ORIG/PKG) unless reuse, and of the printed modules
# (in CAND/PKG, under the original's relative paths, so that spans name the same files, into
# CANDOUT(PKG)), each parsed under its package's configuration: one job list over the whole corpus,
# 8 modules a job, JOBS at a time (R5: package by package, the corpus's 37 small packages left the
# cores idle); the helper's messages in each output's .err
tree_jobs() {
  local mode=$1 o=$2 k=$3 kout=$4 reuse=${5:-}
  # the originals' trees from the records (the printed modules' are class D: the helper runs on them)
  if [ -z "$reuse" ] && [ -z "$live" ]; then corpus_records_get "$c" "trees${mode:+-full}" "$o" || return 1; reuse=records; fi
  tree_jobs_live "$mode" "$o" "$k" "$kout" "$reuse"
}
tree_jobs_live() {
  local mode=$1 o=$2 k=$3 kout=$4 reuse=${5:-} name dir flags files hargs jl
  jl=$(mktemp "$rh/tree-jobs.XXXXXX")
  local pl; pl=$(mktemp "$TMPDIR/repr-haskell-plan.XXXXXX")
  corpus_plan "$c" all > "$pl"
  while IFS=$'\t' read -r name dir flags files hargs; do
    [ -n "$files" ] || continue
    # the helper's options: hsc2hs's arguments (R6: an original .hsc goes through hsc2hs), the
    # GHC flags
    printf '%s --ghc %s\n' "$hargs" "$flags" > "$jl.$name.flags"
    if [ -z "$reuse" ]; then
      # shellcheck disable=SC2086
      printf '%s\n' $files | xargs -n 8 echo | while read -r fs; do
        printf '%s\x1f%s\x1f%s\x1f%s\n' "$srcroot/$dir" "$o/$name" "$jl.$name.flags" "$fs"; done >> "$jl"
    fi
    if [ -d "$k/$name" ]; then
      # the printed modules: an .hsc module's is its X.hs (R6)
      # shellcheck disable=SC2086
      (cd "$k/$name" && printf '%s\n' $files | sed 's/\.hsc$/.hs/' | while read -r f; do [ -f "$f" ] && echo "$f"; done) | xargs -r -n 8 echo |
        while read -r fs; do
          printf '%s\x1f%s\x1f%s\x1f%s\n' "$k/$name" "${kout//PKG/$name}" "$jl.$name.flags" "$fs"; done >> "$jl"
    fi
  done < "$pl"
  rm -f "$pl"
  xargs -P "$jobs" -d '\n' -n 1 "$root/bin/lib/repr-haskell/tree-job" "$helper" "$mode" "$libdir" < "$jl" || true
  rm -f "$jl" "$jl".*.flags
}

read_files() {
  arbace_tool -m arbace.repr.haskell read "$@"
}

# iface_plan CORPUS: one line per package, its fields separated by US (\x1f, so that an empty
# field stays one; a tab is white space to read): name, directory, the GHC flags of the
# parse (as corpus_plan's), the targets ghc --make builds (the module names of the converted, the
# .hsc, the generated; a Main module's file, R6), the converted modules as NAME=FILE (R6: an .hsc
# module's FILE its X.hs, a boot file's NAME M@boot), the .hsc files, hsc2hs's flags, the
# generated files as FILE=FLAG (genprimopcode's); $libdir expanded
iface_plan() {
  local f
  f=$(corpus_file "$1")
  arbace_tool -e "(let [c (read-string (slurp \"$f\")) j (fn [xs] (apply str (interpose \" \" xs)))]
    (doseq [p (:packages c)]
      (println (str (:name p) \"\u001f\" (:dir p) \"\u001f\"
        (j (concat [(str \"-X\" (:language p))] (map #(str \"-X\" %) (:extensions p)) [\"-haddock\"] (:ghc-flags p)
             (distinct (for [[m f] (:modules p) :when (not= (str m) \"Main\")] (let [n (- (count f) (count (str m)) 3)] (if (pos? n) (str \"-i\" (subs f 0 (dec n))) \"-i.\"))))))
        \"\u001f\" (j (concat (map (fn [[m f]] (if (= (str m) \"Main\") f m)) (:modules p)) (map first (:hsc p)) (:generated p)))
        \"\u001f\" (j (concat (map (fn [[m f]] (str m \"=\" f)) (:modules p))
                          (map (fn [[m f]] (str m \"=\" (subs f 0 (dec (count f))))) (:hsc p))
                          (map (fn [f] (str (or (some (fn [[m g]] (when (= g (subs f 0 (- (count f) 5))) m)) (:modules p)) f) \"@boot=\" f)) (:boot p))))
        \"\u001f\" (j (map second (:hsc p)))
        \"\u001f\" (j (:hsc-flags p))
        \"\u001f\" (j (map (fn [[f g]] (str f \"=\" g)) (:genprimopcode p)))
        \"\u001f\" (j (map (fn [[f g]] (str f \"=\" g)) (:generated-files p)))))))" |
    sed -e "s|\\\$libdir|$libdir|g" -e "s|\\\$repo|$root|g"
}

# iface_conf CORPUS KEY...: a value of the corpus's :iface, space-separated when a vector
iface_conf() {
  local f
  f=$(corpus_file "$1"); shift
  arbace_tool -e "(let [v (get-in (:iface (read-string (slurp \"$f\"))) [$*])] (println (cond (nil? v) \"\" (sequential? v) (apply str (interpose \" \" v)) :else v)))"
}

# genprimopcode_build CORPUS: GHC's genprimopcode (the tarball's utils/genprimopcode, with its
# generated Lexer.hs and Parser.hs) built by the host's GHC into .tmp/repr-haskell/tools/, and
# primops.txt from primops.txt.pp, as hadrian's rules do; sets genprimopcode and primops
genprimopcode_build() {
  local c=$1 d main pkgs pp cpp key tw=$rh/tools/$1
  d=$(iface_conf "$c" :genprimopcode :dir); main=$(iface_conf "$c" :genprimopcode :main)
  pkgs=$(iface_conf "$c" :genprimopcode :packages); pp=$(iface_conf "$c" :genprimopcode :primops)
  cpp=$(iface_conf "$c" :genprimopcode :cpp)
  genprimopcode=$tw/genprimopcode; primops=$tw/primops.txt
  key="$(cat "$srcroot/$d"/*.hs "$srcroot/$pp" | sha256sum | cut -c1-64) $pkgs $cpp $(ghc_unit)"
  if [ -x "$genprimopcode" ] && [ -f "$primops" ] && [ -f "$tw/key" ] && [ "$(cat "$tw/key")" = "$key" ]; then return; fi
  echo "== repr-haskell: building genprimopcode ($d)" >&2
  rm -rf "$tw"; mkdir -p "$tw/obj"
  # shellcheck disable=SC2046
  ghc -O0 $(for p in $pkgs; do echo -package "$p"; done) -outputdir "$tw/obj" -o "$genprimopcode" \
    -i"$srcroot/$d" "$srcroot/$d/$main" > "$tw/build.log" 2>&1 || { cat "$tw/build.log" >&2; return 1; }
  # shellcheck disable=SC2086
  $cpp "$srcroot/$pp" -o "$primops"
  rm -rf "$tw/obj"
  echo "$key" > "$tw/key"
}

# iface_level CORPUS SIDE CAND [SIDE CAND]: the round trip's interface level (SPEC §9.1, §9.3)
# over the modules printed into CAND/PKG/ (SIDE cand: the braces layout's; cand-layout: the layout
# layout's, R4): each package's source tree copied under .tmp/repr-haskell/iface/CORPUS/{orig,SIDE}/PKG
# (the .hsc modules through hsc2hs, the generated ones by genprimopcode, the same on every side; the
# converted ones replaced by the printed on a printed side), each compiled by ghc --make from inside
# its tree (the same relative paths: the spans name the same files), all sides of a package
# concurrently, the interfaces of the converted modules shown (ghc --show-iface) into
# {orig,SIDE}.ifaces/PKG/M.iface, the objects removed, and each printed side compared with the
# originals (arbace.repr.haskell compare-iface)
iface_level() {
  local c=$1 ib=$rh/iface/$1 opt t0 t1 t2 t3 name dir flags mods files hscs hflags gens gfiles
  shift
  local sides=() cands=()
  while [ $# -gt 0 ]; do sides+=("$1"); cands+=("$2"); shift 2; done
  ghc_check
  genprimopcode_build "$c"
  opt=$(iface_conf "$c" :opt)
  rm -rf "${ib:?}"; mkdir -p "$ib/orig"
  t0=$(date +%s)
  local pl; pl=$(mktemp "$TMPDIR/repr-haskell-plan.XXXXXX")
  iface_plan "$c" > "$pl"
  while IFS=$'\x1f' read -r name dir flags mods files hscs hflags gens gfiles; do
    local o=$ib/orig/$name h g mf i k
    mkdir -p "$o"
    (cd "$srcroot/$dir" && tar --exclude=./tests -cf - .) | tar -xf - -C "$o"
    for g in $gfiles; do mkdir -p "$(dirname "$o/${g%%=*}")"; cp "$root/${g#*=}" "$o/${g%%=*}"; done
    for h in $hscs; do
      # shellcheck disable=SC2086
      (cd "$o" && hsc2hs $hflags "$h" -o "${h%.hsc}.hs") > "$o.hsc2hs.log" 2>&1 ||
        { cat "$o.hsc2hs.log" >&2; echo "repr-haskell: hsc2hs failed on $name/$h" >&2; return 1; }
    done
    for g in $gens; do "$genprimopcode" "${g#*=}" < "$primops" > "$o/${g%%=*}"; done
    for i in "${!sides[@]}"; do
      k=$ib/${sides[$i]}/$name
      mkdir -p "$ib/${sides[$i]}"
      cp -a "$o" "$k"
      for mf in $files; do
        mf=${mf#*=}
        if [ -f "${cands[$i]}/$name/$mf" ]; then cp "${cands[$i]}/$name/$mf" "$k/$mf"; else rm -f "${k:?}/${mf:?}"; fi
      done
    done
  done < "$pl"
  rm -f "$pl"
  t1=$(date +%s)
  echo "== repr-haskell roundtrip $c: interfaces: compile ($opt; orig ${sides[*]}; $((t1 - t0)) s preparing)" >&2
  # all sides of each package concurrently, and up to REPR_HASKELL_PACKAGES packages at once (each
  # compiles against the installed packages alone, so the packages are independent; R5's 37,
  # most of them small, left the cores idle one by one), in the corpus's order
  local np=${REPR_HASKELL_PACKAGES:-4}
  local pl; pl=$(mktemp "$TMPDIR/repr-haskell-plan.XXXXXX")
  iface_plan "$c" > "$pl"
  while IFS=$'\x1f' read -r name dir flags mods files hscs hflags gens gfiles; do
    while [ "$(jobs -rp | wc -l)" -ge $((np * (1 + ${#sides[@]}))) ]; do wait -n || true; done
    local side
    for side in orig "${sides[@]}"; do
      # shellcheck disable=SC2086
      (cd "$ib/$side/$name" && ghc --make $flags $opt -j"$jobs" -fkeep-going -no-link \
        -outputdir "../$name.out" $mods) > "$ib/$side/$name.build.log" 2>&1 &
    done
  done < "$pl"
  rm -f "$pl"
  wait || true
  t2=$(date +%s)
  echo "== repr-haskell roundtrip $c: interfaces: show and compare ($((t2 - t1)) s compiling)" >&2
  # one ghc --show-iface per converted module, over every package and side at once (R5); a
  # missing .hi leaves no .iface (reported)
  local pl; pl=$(mktemp "$TMPDIR/repr-haskell-plan.XXXXXX")
  iface_plan "$c" > "$pl"
  while IFS=$'\x1f' read -r name dir flags mods files hscs hflags gens gfiles; do
    local side
    for side in orig "${sides[@]}"; do
      mkdir -p "$ib/$side.ifaces/$name"
      # shellcheck disable=SC2086
      # a boot file's interface M.hi-boot (R6)
      printf '%s\n' $files | sed 's/=.*//' | while read -r m; do
        case $m in
          *@boot) printf '%s %s\n' "$ib/$side/$name.out/$(echo "${m%@boot}" | tr . /).hi-boot" "$ib/$side.ifaces/$name/$m.iface" ;;
          *) printf '%s %s\n' "$ib/$side/$name.out/$(echo "$m" | tr . /).hi" "$ib/$side.ifaces/$name/$m.iface" ;;
        esac; done
    done
  done < "$pl" | xargs -P "$jobs" -n 2 sh -c \
    '[ -f "$1" ] && ghc --show-iface "$1" > "$2.part" 2>&1 && mv "$2.part" "$2"; rm -f "$2.part"; :' _
  rm -f "$pl"
  local pl; pl=$(mktemp "$TMPDIR/repr-haskell-plan.XXXXXX")
  iface_plan "$c" > "$pl"
  while IFS=$'\x1f' read -r name dir flags mods files hscs hflags gens gfiles; do
    local side
    for side in orig "${sides[@]}"; do rm -rf "${ib:?}/$side/$name.out" "${ib:?}/$side/${name:?}"; done
  done < "$pl"
  rm -f "$pl"
  t3=$(date +%s)
  local st=0 n=${#sides[@]} keep
  for i in "${!sides[@]}"; do
    local side=${sides[$i]} known=$root/test/haskell/roundtrip-$c-iface-known.edn report=$ib.report.edn label=""
    if [ "$side" = cand-layout ]; then
      known=$root/test/haskell/roundtrip-$c-layout-iface-known.edn; report=$ib.layout.report.edn; label="the layout layout"
    fi
    # the originals' texts of the equal modules are pruned by the last comparison only
    keep=""; [ "$i" -lt $((n - 1)) ] && keep=--keep-orig
    arbace_tool -m arbace.repr.haskell compare-iface --corpus "$(corpus_file "$c")" --orig "$ib/orig.ifaces" \
      --cand "$ib/$side.ifaces" --printed "${cands[$i]}" --builds "$ib" --side "$side" --prune $keep \
      ${label:+--label "$label"} --known "$known" --report "$report" --controls "$root/test/haskell/roundtrip-controls.edn" \
      --times "prepare $((t1 - t0)) compile $((t2 - t1)) show $((t3 - t2))" || st=1
  done
  return $st
}

roundtrip() {
  local c=ghc-9.14.1 only="" iface="" tree=1 text="" layout="" st=0
  while [ $# -gt 0 ]; do
    case $1 in
      --only) only=$2; shift 2 ;;
      --iface) iface=1; shift ;;
      --iface-only) iface=1; tree=""; shift ;;
      --text) text=1; shift ;;
      --text-only) text=1; tree=""; shift ;;
      --layout) layout=1; shift ;;
      --layout-only) layout=1; tree=""; shift ;;
      *) c=$1; shift ;;
    esac
  done
  # the reader of both sides (2026-11-07): native by default, no GHC (the round trip's verdict its own: the printed modules
  # read again give the originals' forms, the text level's print the original text byte for byte); REPR_HASKELL_READER=helper:
  # GHC's trees of both sides, the oracle tier's; the interface level is GHC's (the oracle tier's) whatever the reader
  local reader=${REPR_HASKELL_READER:-native}
  if [ "$reader" = helper ] || [ -n "$iface" ]; then ghc_check; build; fi
  corpus_fetch "$c"
  if [ "$reader" = native ]; then native_env; native_place_inputs "$c"; fi
  local cand=$rh/cand/$c lcand=$rh/cand-layout/$c sides=()
  if [ -n "$tree" ]; then tree_level "$c" "$only" braces "" "$reader" || st=1; fi
  if [ -n "$layout" ]; then tree_level "$c" "$only" layout "${tree:+reuse}" "$reader" || st=1; fi
  if [ -n "$iface" ]; then
    [ -z "$only" ] || { echo "repr-haskell: --only is for the tree and text levels" >&2; return 2; }
    # the braces layout's printed modules unless --layout-only, the layout layout's with --layout
    if [ -n "$tree" ] || [ -z "$layout" ]; then
      [ -d "$cand" ] || { echo "repr-haskell: no printed modules in $cand (run the tree level first)" >&2; return 1; }
      sides+=(cand "$cand")
    fi
    if [ -n "$layout" ]; then
      [ -d "$lcand" ] || { echo "repr-haskell: no printed modules in $lcand (run roundtrip --layout first)" >&2; return 1; }
      sides+=(cand-layout "$lcand")
    fi
    iface_level "$c" "${sides[@]}" || st=1
  fi
  if [ -n "$text" ]; then text_level "$c" "$only" "$reader" || st=1; fi
  return $st
}

# text_level CORPUS ONLY: the text level (SPEC §9.1, mode :full; R3): the corpus dumped with
# --full (.tmp/repr-haskell/dumps/CORPUS-full/PKG/, with CPP's module views as FILE.view),
# converted in mode :full (.tmp/repr-haskell/forms/CORPUS-full/PKG/), printed in the full layout
# (.tmp/repr-haskell/cand-text/CORPUS/PKG/), each printed module compared byte for byte with its
# original (a CPP module: its module view), then GHC's trees in mode :full (hsdump tree --full:
# showAstData NoBlankSrcSpan NoBlankEpAnnotations, comments kept) and lines of both
# (.tmp/repr-haskell/trees-full/CORPUS/{orig,cand}/PKG/)
text_level() {
  local c=$1 only=$2 reader=${3:-helper}
  local dumps=$rh/dumps/$c-full forms=$rh/forms/$c-full cand=$rh/cand-text/$c trees=$rh/trees-full/$c t0 t1 t2 t3 t4
  [ "$reader" = native ] && dumps=$rh/ndumps/$c-full
  t0=$(date +%s)
  echo "== repr-haskell roundtrip $c: text level: dump (--full, the $reader reader)" >&2
  if [ "$reader" = native ]; then native_dump_corpus "$c" "$dumps" full; else dump_corpus "$c" "$dumps" --full; fi
  t1=$(date +%s)
  echo "== repr-haskell roundtrip $c: text level: convert (mode :full; $((t1 - t0)) s dumping)" >&2
  rm -rf "$forms"; mkdir -p "$(dirname "$forms")"
  read_files --jobs "$jobs" -o "$forms" --report "$forms.report.edn" --root "$dumps" ${only:+--only "$only"} > "$forms.log" 2>&1 ||
    { grep -v '^error' "$forms.log" | tail -5 >&2; grep -c '^error' "$forms.log" | sed 's/$/ modules failed to convert (see the report)/' >&2; }
  t2=$(date +%s)
  echo "== repr-haskell roundtrip $c: text level: print (the full layout; $((t2 - t1)) s converting)" >&2
  rm -rf "$cand"; mkdir -p "$(dirname "$cand")"
  arbace_tool -m arbace.repr.haskell print --jobs "$jobs" -o "$cand" --root "$forms" > "$cand.print.log" 2>&1 ||
    grep -v '^error' "$cand.print.log" | tail -3 >&2
  t3=$(date +%s)
  if [ "$reader" = native ]; then
    # the native verdict: the print against the original text (a CPP module's module view, the native preprocessing's)
    # byte for byte, which is the text itself: no tree of either side is made
    t4=$t3
  else
  echo "== repr-haskell roundtrip $c: text level: trees in mode :full ($((t3 - t2)) s printing)" >&2
  rm -rf "$trees"; mkdir -p "$trees/orig" "$trees/cand"
  tree_jobs --full "$trees/orig" "$cand" "$trees/cand/PKG"
  t4=$(date +%s)
  fi
  echo "== repr-haskell roundtrip $c: text level: compare ($((t4 - t3)) s parsing)" >&2
  arbace_tool -m arbace.repr.haskell compare-text --corpus "$(corpus_file "$c")" --src "$srcroot" --views "$dumps" \
    --cand "$cand" --trees "$trees" --forms-report "$forms.report.edn" $([ "$reader" = native ] && echo "--bytes-only true --controls $root/test/haskell/roundtrip-controls.edn") \
    --known "$root/test/haskell/roundtrip-$c-text-known.edn" --report "$cand.report.edn" ${only:+--only "$only"} \
    --times "dump $((t1 - t0)) convert $((t2 - t1)) print $((t3 - t2)) parse $((t4 - t3))"
}

# tree_level CORPUS ONLY [LAYOUT [reuse]]: the tree level (SPEC §9.2): dump, convert, print into
# .tmp/repr-haskell/cand/CORPUS/PKG/ (LAYOUT braces, the default) or cand-layout/CORPUS/PKG/ (layout:
# the layout layout, R4), the helper's trees and lines of both sides compared; reuse: the dumps,
# the forms and the originals' trees of the tree level just run
tree_level() {
  local c=$1 only=$2 layout=${3:-braces} reuse=${4:-} reader=${5:-helper}
  local dumps=$rh/dumps/$c forms=$rh/forms/$c orig=$rh/orig/$c cand=$rh/cand/$c t0 t1 t2 t3 t4
  [ "$reader" = native ] && { dumps=$rh/ndumps/$c; forms=$rh/nforms/$c; }
  local known=$root/test/haskell/roundtrip-$c-known.edn label="" what=""
  if [ "$layout" = layout ]; then
    cand=$rh/cand-layout/$c; known=$root/test/haskell/roundtrip-$c-layout-known.edn
    label="the layout layout"; what=" (the layout layout)"
  fi
  t0=$(date +%s)
  if [ -z "$reuse" ]; then
    echo "== repr-haskell roundtrip $c$what: dump (the $reader reader)" >&2
    if [ "$reader" = native ]; then native_dump_corpus "$c" "$dumps" lines; else dump_corpus "$c" "$dumps"; fi
  fi
  t1=$(date +%s)
  if [ -z "$reuse" ]; then
    echo "== repr-haskell roundtrip $c$what: convert ($((t1 - t0)) s dumping)" >&2
    rm -rf "${forms:?}"; mkdir -p "$(dirname "$forms")"
    read_files --jobs "$jobs" -o "$forms" --report "$forms.report.edn" --root "$dumps" ${only:+--only "$only"} > "$forms.log" 2>&1 ||
      { tail -20 "$forms.log" >&2; echo "repr-haskell: the conversion failed ($forms.log)" >&2; return 1; }
  fi
  t2=$(date +%s)
  echo "== repr-haskell roundtrip $c$what: print ($((t2 - t1)) s converting)" >&2
  rm -rf "${cand:?}"; mkdir -p "$(dirname "$cand")"
  # a module the printer fails on is reported by the comparison (not printed)
  arbace_tool -m arbace.repr.haskell print --jobs "$jobs" --layout "$layout" -o "$cand" --root "$forms" > "$cand.print.log" 2>&1 ||
    grep -v '^error' "$cand.print.log" | tail -3 >&2
  t3=$(date +%s)
  if [ "$reader" = native ]; then
    # the native verdict (the user's decision of 2026-11-07: the round trip's reread forms equal): the printed modules read
    # natively and converted, their forms against the originals' (the preprocessing's records aside: the print is CPP's output)
    echo "== repr-haskell roundtrip $c$what: the printed modules read again ($((t3 - t2)) s printing)" >&2
    native_dump_corpus "$c" "$cand.ndumps" lines "$cand"
    rm -rf "$cand.forms"
    read_files --jobs "$jobs" -o "$cand.forms" --report "$cand.forms.report.edn" --root "$cand.ndumps" ${only:+--only "$only"} > "$cand.forms.log" 2>&1 || true
    t4=$(date +%s)
    echo "== repr-haskell roundtrip $c$what: compare the forms ($((t4 - t3)) s reading)" >&2
    arbace_tool -m arbace.repr.haskell compare-forms --corpus "$(corpus_file "$c")" --orig "$forms" --cand "$cand.forms" \
      --forms-report "$forms.report.edn" --known "${known%-known.edn}-native-known.edn" ${label:+--label "$label"} \
      --controls "$root/test/haskell/roundtrip-controls.edn" --report "$cand.report.edn" ${only:+--only "$only"} \
      --times "dump $((t1 - t0)) convert $((t2 - t1)) print $((t3 - t2)) reread $((t4 - t3))"
    return
  fi
  echo "== repr-haskell roundtrip $c$what: trees ($((t3 - t2)) s printing)" >&2
  # the trees: of the originals (in the corpus's tree) and of the printed modules (in the
  # candidate's), each parsed by the helper under its package's configuration
  if [ -z "$reuse" ]; then rm -rf "${orig:?}"; mkdir -p "$orig"; fi
  tree_jobs "" "$orig" "$cand" "$cand/PKG.trees" $reuse
  t4=$(date +%s)
  echo "== repr-haskell roundtrip $c$what: compare ($((t4 - t3)) s parsing)" >&2
  arbace_tool -m arbace.repr.haskell compare --corpus "$(corpus_file "$c")" --orig "$orig" --cand "$cand" \
    --forms-report "$forms.report.edn" --known "$known" ${label:+--label "$label"} \
    --report "$cand.report.edn" ${only:+--only "$only"} \
    --times "dump $((t1 - t0)) convert $((t2 - t1)) print $((t3 - t2)) parse $((t4 - t3))"
}

# native_read [-o DIR] FILE... [--ghc FLAG...]: the native reader over modules (relative to the
# current directory), dumps into DIR/FILE.edn and forms into DIR/forms/; unlit and CPP native (the
# GHC installation, $libdir, read as data), an .hsc module first through hsc2hs by the helper's cpp
# verb (DIR/hspp/: its output X.hs beside it, the record of the run)
native_read() {
  local out=$rh/native files=() gflags=() hargs=() f need=() hspp="" mode=lines
  while [ $# -gt 0 ]; do
    case $1 in
      -o) out=$2; shift 2 ;;
      --full) mode=full; shift ;;
      --hsc2hs-arg) hargs+=("$1" "$2"); shift 2 ;;
      --ghc) shift; gflags=("$@"); break ;;
      *) files+=("$1"); shift ;;
    esac
  done
  mkdir -p "$out"
  for f in "${files[@]}"; do
    case $f in *.hsc) need+=("$f") ;; esac
  done
  native_env
  if [ ${#need[@]} -gt 0 ]; then
    ghc_check; build
    hsdump cpp -o "$out/hspp" "${hargs[@]}" --ghc "${gflags[@]}" --files "${need[@]}" || return 1
    hspp=$out/hspp
  fi
  local st=0 dumps=() m
  for f in "${files[@]}"; do m=$f; [ "${f%.hsc}" != "$f" ] && m=${f%c}; rm -f "$out/$m.edn"; done
  arbace_tool -m arbace.repr.haskell.native read -o "$out" --libdir "$libdir" ${nsysroot:+--sysroot "$nsysroot"} ${hspp:+--hspp "$hspp"} --mode $mode \
    --flags "$(printf '%s ' "${gflags[@]}")" "${files[@]}" || st=1
  # the modules read (an .hsc module's dump is its X.hs's), converted as the helper's dumps are
  for f in "${files[@]}"; do
    m=$f; [ "${f%.hsc}" != "$f" ] && m=${f%c}
    [ -f "$out/$m.edn" ] && dumps+=("$out/$m.edn")
  done
  [ ${#dumps[@]} -eq 0 ] || read_files --jobs "$jobs" -o "$out/forms" "${dumps[@]}" || st=1
  return $st
}

# parser_src: GHC's grammar and its Happy-generated parser, extracted from the pinned tarball (the
# corpus's) into .tmp/repr-haskell/parser/, read in place by arbace.repr.haskell.happy
parser_src() {
  corpus_fetch ghc-9.14.1 > "$TMPDIR/repr-haskell-fetch.txt"
  local f url tb d=$rh/parser
  f=$(corpus_file ghc-9.14.1)
  url=$(arbace_tool -e "(println (:url (:tarball (read-string (slurp \"$f\")))))")
  tb=$rh/corpus/$(basename "$url")
  mkdir -p "$d"
  if [ ! -f "$d/ghc-9.14.1/compiler/GHC/Parser.y.source" ] || [ ! -f "$d/ghc-9.14.1/compiler/GHC/Parser.hs" ]; then
    tar -xJf "$tb" -C "$d" ghc-9.14.1/compiler/GHC/Parser.y.source ghc-9.14.1/compiler/GHC/Parser.hs
  fi
  parser_y=$d/ghc-9.14.1/compiler/GHC/Parser.y.source
  parser_hs=$d/ghc-9.14.1/compiler/GHC/Parser.hs
}

tables() {
  parser_src
  if [ "${1:-}" = --check ]; then
    arbace_tool -m arbace.repr.haskell.happy check --parser-y "$parser_y" --parser-hs "$parser_hs"
  else
    arbace_tool -m arbace.repr.haskell.happy gen --parser-y "$parser_y" --out "$root/arbace/repr/haskell/tables.ae"
  fi
}


# rename_check [LIST]: the renamer's check (test/haskell/rename-check.txt by default; HF2): GHC's renamer by the
# helper's rn verb (the reduced GhcRn forms, tools/hsdump/HsRn.hs) against arbace.repr.haskell.rename over the native
# reader's trees, each list entry in .tmp/repr-haskell/rename-check/NAME/
rename_check() {
  local list=${1:-$root/test/haskell/rename-check.txt} w=$rh/rename-check kind a b rest st=0
  local tb=$rh/corpus/ghc-9.14.1-src.tar.xz
  mkdir -p "$w"
  while read -r kind a b rest; do
    case $kind in ''|'#'*) continue ;; esac
    local d name files=() own="" need="" m f ifs
    if [ "$kind" = nofib ]; then
      # single-module programs of nofib/spectral, each in a session of its own (Haskell 2010)
      [ -f "$tb" ] || { echo "rename-check: $tb is missing (bin/repr-haskell corpus fetch)" >&2; st=1; continue; }
      local prog ok=0 n=0 pw
      for prog in $a $b $rest; do
        pw=$w/nofib/$prog; rm -rf "${pw:?}"; mkdir -p "$pw/src"
        tar -xJf "$tb" -C "$pw/src" --strip-components=4 "ghc-9.14.1/nofib/spectral/$prog/Main.hs"
        n=$((n + 1))
        (cd "$pw/src" && "$helper" rn --libdir "$libdir" -o "$pw/ghc" --ghc -XHaskell2010 --files Main.hs) > "$pw/ghc.log" 2>&1 || { echo "nofib $prog: GHC rejects it" >&2; st=1; continue; }
        need="Prelude $(cd "$pw/src" && grep -h '^import' Main.hs | sed 's/qualified//' | awk '{print $2}' | sed 's/(.*//' | sort -u | tr '\n' ' ')"
        # shellcheck disable=SC2086
        "$helper" iface --libdir "$libdir" -o "$pw/if" --ghc -XHaskell2010 --files $need > "$pw/if.log" 2>&1 || true
        (cd "$pw/src" && arbace_tool -m arbace.repr.haskell.native read -o "$pw/nd" --flags "-XHaskell2010" Main.hs > "$pw/read.log") || { echo "nofib $prog: the native reader rejects it" >&2; st=1; continue; }
        if arbace_tool -m arbace.repr.haskell.rename check --ifaces "$pw/if" --local "$pw/ifl" --ghc "$pw/ghc" -o "$pw/out" "$pw/nd/Main.hs.edn" > "$pw/report.txt" 2>&1 \
           && grep -q '1 of 1 modules equal' "$pw/report.txt"; then ok=$((ok + 1)); else echo "nofib $prog: differs ($pw/report.txt)" >&2; st=1; fi
      done
      echo "== rename-check nofib: $ok of $n programs equal"
      continue
    fi
    if [ "$kind" = samples ]; then
      name=samples; d=$root/$a; ifs="$b $rest"
      rm -rf "${w:?}/$name"; mkdir -p "$w/$name"
      files=($(cd "$d" && ls R*.hs))
      (cd "$d" && "$helper" rn --libdir "$libdir" -o "$w/$name/ghc" --ghc -XGHC2021 -i. --files "${files[@]}") 2> "$w/$name/ghc.err" || { tail -5 "$w/$name/ghc.err" >&2; st=1; continue; }
      need=$ifs
    else
      name=$a; d=$w/$name/src
      [ -f "$tb" ] || { echo "rename-check: $tb is missing (bin/repr-haskell corpus fetch)" >&2; st=1; continue; }
      rm -rf "${w:?}/$name"; mkdir -p "$d"
      local paths=() fl=($b $rest)
      for f in "${fl[@]}"; do paths+=("ghc-9.14.1/libraries/ghc-internal/src/GHC/Internal/$f.hs"); done
      tar -xJf "$tb" -C "$d" --strip-components=4 "${paths[@]}"
      for f in "${fl[@]}"; do files+=("GHC/Internal/$f.hs"); own="$own $(echo "GHC/Internal/$f" | tr / .)"; done
      (cd "$d" && "$helper" rn --libdir "$libdir" -o "$w/$name/ghc" --ghc -XGHC2021 -package ghc-internal -this-unit-id ghc-internal-x --files "${files[@]}") 2> "$w/$name/ghc.err" || { tail -5 "$w/$name/ghc.err" >&2; st=1; continue; }
      for m in $(cd "$d" && grep -h '^import' "${files[@]}" | sed 's/{-# SOURCE #-}//; s/qualified//' | awk '{print $2}' | sed 's/(.*//' | sort -u); do
        case " $own " in *" $m "*) ;; *) need="$need $m" ;; esac
      done
      need="Prelude $need"
    fi
    # the interfaces of what the modules import (and of the modules defining those names)
    local pk=""; [ "$kind" = prelude ] && pk="-package ghc-internal"
    # shellcheck disable=SC2086
    "$helper" iface --libdir "$libdir" -o "$w/$name/if" --ghc -XGHC2021 $pk --files $need 2> "$w/$name/if.err" || true
    # the native reader's trees
    local dumps=()
    (cd "$d" && arbace_tool -m arbace.repr.haskell.native read -o "$w/$name/nd" --flags "-XGHC2021" "${files[@]}" > "$w/$name/read.log") || { tail -5 "$w/$name/read.log" >&2; st=1; continue; }
    for f in "${files[@]}"; do dumps+=("$w/$name/nd/$f.edn"); done
    echo "== rename-check $name: ${#files[@]} modules"
    arbace_tool -m arbace.repr.haskell.rename check --ifaces "$w/$name/if" --local "$w/$name/ifl" --root "$w/$name/nd" \
      --ghc "$w/$name/ghc" -o "$w/$name/out" "${dumps[@]}" | tee "$w/$name/report.txt" | grep -v '^ok' || true
    grep -q '^rename-check: \([0-9]*\) of \1 modules equal' "$w/$name/report.txt" || st=1
  done < "$list"
  return $st
}

# stg_check [DIR]: HF5-HF6 (doc/haskell/FRONTEND-SURVEY.md, "As built: HF5-HF6"): every S*.hs of DIR (default
# test/haskell/stg, Haskell 2010 programs with a main) read natively, renamed, elaborated, desugared by the match
# compiler (arbace.repr.haskell.desugar) and translated to STG (arbace.repr.haskell.tostg); the desugared Core judged
# against the helper's tc verb (Core in full, after the judge's normalisation), our STG compared with GHC's -O0 STG
# (the helper's stg mode) by arbace.repr.haskell.stgcmp, and the final judge: each program run on hsi from our STG
# (bin/hsi's driver, the libraries' dumps of HSI_LIBS) against GHC's -O0 build's output. Light: seconds a program.
# Work in .tmp/repr-haskell/stg-check/
stg_check() {
  local d=${1:-$root/test/haskell/stg} w=$rh/stg-check files trees=() f st=0 n pass=0 total=0
  rm -rf "${w:?}"; mkdir -p "$w"
  files=($(cd "$d" && ls S*.hs))
  "$helper" iface --libdir "$libdir" -o "$w/if" --ghc -XHaskell2010 --files Prelude Data.List Data.Maybe Data.Char Control.Monad > "$w/if.log" 2>&1 || true
  local libs=${HSI_LIBS:-$root/.tmp/hsi/dumps/stg}
  # every program is a module Main: one at a time
  for f in "${files[@]}"; do
    n=${f%.hs}
    (cd "$d" && "$helper" tc --libdir "$libdir" -o "$w/ghc" --ghc -XHaskell2010 -i. --files "$f") > "$w/$n.ghc.log" 2>&1 || { tail -5 "$w/$n.ghc.log" >&2; st=1; continue; }
    (cd "$d" && "$helper" rn --libdir "$libdir" -o "$w/rn" --ghc -XHaskell2010 -i. --files "$f") > "$w/$n.rn.log" 2>&1 || { tail -5 "$w/$n.rn.log" >&2; st=1; continue; }
    (cd "$d" && arbace_tool -m arbace.repr.haskell.native read -o "$w/nd" --flags "-XHaskell2010" "$f" > "$w/$n.read.log") || { tail -5 "$w/$n.read.log" >&2; st=1; continue; }
    arbace_tool -m arbace.repr.haskell.rename check --ifaces "$w/if" --local "$w/ifl-$n" --ghc "$w/rn" -o "$w/tree" "$w/nd/$f.edn" > "$w/$n.rename.txt" 2>&1 || st=1
    grep '^rename-check:' "$w/$n.rename.txt"
    arbace_tool -m arbace.repr.haskell.tostg compile --ifaces "$w/if" --local "$w/tifl-$n" --libs "${libs//:/,}" --ghc "$w/ghc" -o "$w/stg" "$w/tree/$f.rn-tree.edn" | tee -a "$w/compile.txt"
  done
  local exe; exe=$("$root/bin/hsi" build)
  local img=${HSI_IMAGE:-$root/.tmp/hsi/image} la=() l
  IFS=: read -r -a dirs <<< "$libs"; for l in "${dirs[@]}"; do la+=(--lib "$l"); done
  "$exe" image --out "$img" "${la[@]}" 2> "$w/image.log" || { cat "$w/image.log" >&2; return 1; }
  for f in "${files[@]}"; do
    n=${f%.hs}; total=$((total + 1))
    mkdir -p "$w/ref/$n"
    (cd "$d" && "$helper" stg --core -o "$w/ref/$n" --libdir "$libdir" --ghc -O0 -outputdir "$w/ref/$n/obj" -o "$w/ref/$n/prog" --files "$f") > "$w/ref/$n.log" 2>&1 || true
    arbace_tool -m arbace.repr.haskell.simplcmp "$w/ref/$n/Main.core.ae" "$w/stg/$n/Main.simpl.edn" > "$w/$n.simplcmp" 2>&1 || true
    (cd "$d" && ghc -O0 -outputdir "$w/ref/$n/gobj" -o "$w/ref/$n/ghc-prog" "$f") > "$w/ref/$n.ghc.log" 2>&1 && "$w/ref/$n/ghc-prog" > "$w/ref/$n.out" 2> "$w/ref/$n.err" || true
    arbace_tool -m arbace.repr.haskell.stgcmp "$w/ref/$n/Main.stg.ae" "$w/stg/$n/Main.stg.ae" > "$w/$n.stgcmp" 2>&1 || true
    (ulimit -v $((${ARBACE_MEM_GIB:-3} * 1048576)); timeout 60 "$exe" run "${la[@]}" --image "$img" --prog "$w/stg/$n" --name "$n" > "$w/$n.out" 2> "$w/$n.err") || true
    if cmp -s "$w/$n.out" "$w/ref/$n.out"; then pass=$((pass + 1)); echo "run ok $n ($(head -1 "$w/$n.stgcmp"); $(head -1 "$w/$n.simplcmp"))"
    else echo "run FAIL $n ($(head -1 "$w/$n.stgcmp"); $(head -1 "$w/$n.simplcmp")): $(head -c 300 "$w/$n.err" | tr '\n' ' ')"; st=1; fi
  done
  echo "stg-check: $pass of $total programs run on hsi from Arbace's STG with GHC's output"
  awk '/^simpl /{e+=$2; c+=$4} END{print "stg-check: simplified Core equal to GHC'"'"'s -O0 Core (after its Simplifier) in " e " of " c " bindings of the programs"}' "$w"/*.simplcmp
  awk '/^stg /{e+=$2; c+=$4} END{print "stg-check: STG equal to GHC'"'"'s -O0 STG in " e " of " c " bindings of the programs"}' "$w"/*.stgcmp
  # the negative control: each program's run judged against the next program's reference must fail
  local prev="" ctl=0
  for f in "${files[@]}"; do n=${f%.hs}; if [ -n "$prev" ] && cmp -s "$w/$prev.out" "$w/ref/$n.out"; then ctl=1; fi; prev=$n; done
  if [ "$ctl" = 1 ] || [ "$total" -lt 2 ]; then echo "stg-check: the negative control passed: the run judge does not tell programs apart" >&2; st=1
  else echo "stg-check: the negative control fails as it must (each run against the next program's reference)"; fi
  # HF5's Core judge over the elaborator's samples (DIR2, default test/haskell/typecheck): desugared Core against the tc verb's
  local d2=${2:-$root/test/haskell/typecheck} t2=() files2
  files2=($(cd "$d2" && ls T*.hs))
  (cd "$d2" && "$helper" tc --libdir "$libdir" -o "$w/tghc" --ghc -XHaskell2010 -i. --files "${files2[@]}") > "$w/tghc.log" 2>&1 || { tail -5 "$w/tghc.log" >&2; return 1; }
  (cd "$d2" && "$helper" rn --libdir "$libdir" -o "$w/trn" --ghc -XHaskell2010 -i. --files "${files2[@]}") > "$w/trn.log" 2>&1 || { tail -5 "$w/trn.log" >&2; return 1; }
  (cd "$d2" && arbace_tool -m arbace.repr.haskell.native read -o "$w/tnd" --flags "-XHaskell2010" "${files2[@]}" > "$w/tread.log" 2>&1) || { tail -5 "$w/tread.log" >&2; return 1; }
  local tds=(); for f in "${files2[@]}"; do tds+=("$w/tnd/$f.edn"); t2+=("$w/ttree/$f.rn-tree.edn"); done
  arbace_tool -m arbace.repr.haskell.rename check --ifaces "$w/if" --local "$w/tifl0" --ghc "$w/trn" -o "$w/ttree" "${tds[@]}" > "$w/trename.txt" 2>&1 || true
  arbace_tool -m arbace.repr.haskell.tostg compile --ifaces "$w/if" --local "$w/tifl" --libs "${libs//:/,}" --ghc "$w/tghc" -o "$w/tstg" "${t2[@]}" 2> "$w/tcompile.err" | tee "$w/tcompile.txt" | grep -v '^ *error' || true
  awk '/ core /{split($NF,a,"/"); e+=a[1]; c+=a[2]} END{print "stg-check: desugared Core equal to GHC'"'"'s in " e " of " c " bindings of the typecheck samples (after the judge'"'"'s normalisation)"}' "$w/tcompile.txt"
  awk '/ core /{split($NF,a,"/"); e+=a[1]; c+=a[2]} END{print "stg-check: desugared Core equal to GHC'"'"'s in " e " of " c " bindings of the programs"}' "$w/compile.txt"
  return $st
}

# run_check [--nofib] [--record] [--record-ref] [ID...]: HF5-HF6's decision 3 (a) (doc/haskell/FRONTEND-SURVEY.md, "As built:
# HF5-HF6's second slice, HF7 (first light), HF3's second slice"): programs through Arbace's front end
# (arbace.repr.haskell.front, one process a shard) and hsi, judged against GHC's recorded -O0 runs and a record of
# their results. The corpora: by default the samples and synthetic programs of test/haskell/eval/ (references
# test/haskell/ref-ghc914.edn, record test/haskell/run-check.edn); --nofib the single-module nofib programs of
# test/haskell/run-check-nofib.txt, read from the pinned GHC source tarball's nofib/ (REPR_HASKELL_NOFIB: an extracted
# copy of it; references test/haskell/ref-nofib.edn, which --record-ref makes with the host's GHC at -O0 in fast mode,
# FAST_OPTS and PROG_ARGS of each Makefile, its NAME.faststdin or NAME.stdin; record test/haskell/run-check-nofib.edn).
# The interfaces are the helper's iface dump of the corpus's imports (Tier S's pinned data, HFS3 (a)) with the packages'
# reexports (ghc-pkg). Light: each front shard about 1.6 GiB, hsi's runs capped at 2 GiB and 120 s of CPU.
# Work in .tmp/repr-haskell/run-check/ (--nofib: run-check-nofib/)
run_check() {
  local record="" recref="" nofib="" ids=() st=0
  while [ $# -gt 0 ]; do
    case $1 in --record) record=1; shift ;; --record-ref) recref=1; shift ;; --nofib) nofib=1; shift ;; *) ids+=("$1"); shift ;; esac
  done
  local w=$rh/run-check rec=$root/test/haskell/run-check.edn ref=$root/test/haskell/ref-ghc914.edn
  [ -n "$nofib" ] && { w=$rh/run-check-nofib; rec=$root/test/haskell/run-check-nofib.edn; ref=$root/test/haskell/ref-nofib.edn; }
  local libs=${HSI_LIBS:-$root/.tmp/hsi/dumps/stg}
  rm -rf "${w:?}"; mkdir -p "$w/if" "$w/out" "$w/run" "$w/src"
  # the plan: ID|SOURCE|RUNDIR|ARGS|STDIN|NAME|OUT (the program's name in the front's output)
  local plan=$w/plan.txt f id d nm
  : > "$plan"
  if [ -z "$nofib" ]; then
    if [ ${#ids[@]} = 0 ]; then
      for f in "$root"/test/haskell/eval/samples/*.hs "$root"/test/haskell/eval/synthetic/*.hs; do ids+=("$(basename "$(dirname "$f")")/$(basename "$f" .hs)"); done
    fi
    for id in "${ids[@]}"; do
      f=$root/test/haskell/eval/$id.hs; d=$(dirname "$f"); nm=$(basename "$f" .hs)
      echo "$id|$f|$d|$([ -f "$d/$nm.args" ] && cat "$d/$nm.args")|$([ -f "$d/$nm.stdin" ] && echo "$nm.stdin")|$nm|$nm" >> "$plan"
    done
  else
    local nf=${REPR_HASKELL_NOFIB:-$rh/corpus/ghc-9.14.1/nofib}
    if [ ! -d "$nf" ]; then
      local tb=$rh/corpus/ghc-9.14.1-src.tar.xz
      [ -f "$tb" ] || { echo "run-check: no nofib (REPR_HASKELL_NOFIB, or $tb: bin/repr-haskell corpus fetch)" >&2; return 1; }
      mkdir -p "$rh/corpus"; tar -xJf "$tb" -C "$rh/corpus" ghc-9.14.1/nofib
    fi
    if [ ${#ids[@]} = 0 ]; then
      while read -r f; do case $f in ''|\#*) continue ;; esac; ids+=("nofib/$(dirname "$f")"); done < "$root/test/haskell/run-check-nofib.txt"
    fi
    for id in "${ids[@]}"; do
      local p=${id#nofib/} mk main="" fo pa sin="" s n
      n=$(basename "$p"); mk=$nf/$p/Makefile
      main=$(grep -F "$p/" "$root/test/haskell/run-check-nofib.txt" | head -1); main=$nf/$main
      fo=$( [ ! -f "$mk" ] || sed -n 's/^FAST_OPTS *= *//p' "$mk" | head -1 | sed 's/#.*//')
      pa=$( [ ! -f "$mk" ] || sed -n 's/^PROG_ARGS *+\{0,1\}= *//p' "$mk" | tr '\n' ' ' | perl -pe 's/\+RTS.*?-RTS//g')
      for s in "$n.faststdin" "$n.stdin"; do [ -f "$nf/$p/$s" ] && { sin=$s; break; }; done
      echo "$id|$main|$nf/$p|$(echo "$pa $fo" | xargs)|$sin|$n|$(echo "$p" | tr '/' '_')" >> "$plan"
    done
  fi
  # --record-ref: GHC's -O0 runs of the programs as the references (the host's GHC, at the pin)
  if [ -n "$recref" ]; then
    : > "$w/ref.edn"
    while IFS='|' read -r id f d a sin nm ob; do
      local r=$w/ref/$ob s=0
      rm -rf "$r"; mkdir -p "$r"; cp -r "$d"/. "$r"/; : > "$r/.empty"
      # the executable named as nofib names it (its messages start with the program's name)
      (cd "$r" && ghc -O0 -outputdir obj -o "$nm.ghcbin" "$(basename "$f")" > build.log 2>&1) || { echo "{:id \"$id\" :no-build true}" >> "$w/ref.edn"; continue; }
      mkdir -p "$r/bin"; mv "$r/$nm.ghcbin" "$r/bin/$nm"
      (cd "$r" && env -i PATH=/usr/bin:/bin LANG=C.UTF-8 TZ=UTC HOME="$r" timeout -s KILL 360 \
         sh -c "ulimit -v $((4 * 1048576)); ulimit -t 120; exec ./bin/$nm $a" < "$r/${sin:-.empty}" > "$r/out" 2> "$r/err") || s=$?
      echo "{:id \"$id\" :status $s :stdout \"$(sha256sum < "$r/out" | cut -c1-64)\" :stderr \"$(sha256sum < "$r/err" | cut -c1-64)\" :bytes $(wc -c < "$r/out")}" >> "$w/ref.edn"
    done < "$plan"
    { echo ";; GHC 9.14.1's -O0 runs of the nofib programs of test/haskell/run-check-nofib.txt (bin/repr-haskell run-check --nofib"
      echo ";; --record-ref): each built by the host's ghc -O0 in a copy of its directory and run as nofib's fast mode runs it (FAST_OPTS,"
      echo ";; PROG_ARGS less +RTS options, NAME.faststdin or NAME.stdin) under env -i, LANG=C.UTF-8, TZ=UTC; :stdout and :stderr SHA-256."
      # a run of some programs keeps the others' lines
      sed -n 's/^\({:id "[^"]*" \).*/\1/p' "$w/ref.edn" > "$w/ref.ids"
      { [ ! -f "$ref" ] || grep '^{' "$ref" | grep -v -F -f "$w/ref.ids" || true; cat "$w/ref.edn"; } | sort; } > "$ref.new"
    mv "$ref.new" "$ref"
    echo "run-check: recorded $(grep -c '^{' "$ref") references into $ref"
  fi
  local files=() srcs=(); while IFS='|' read -r id f d a sin nm ob; do files+=("$f@$ob"); srcs+=("$f"); done < "$plan"
  # the interfaces: every module the programs import, the helper's closure below them
  local mods; mods=$(cat "${srcs[@]}" | sed -n 's/^import *\(qualified \)\?\([A-Z][A-Za-z0-9.]*\).*/\2/p' | sort -u | tr '\n' ' ')
  # shellcheck disable=SC2086
  "$helper" iface --libdir "$libdir" -o "$w/if" --ghc -XHaskell2010 --files Prelude $mods > "$w/if.log" 2>&1 || true
  ghc-pkg field '*' exposed-modules 2> "$w/pkg.err" | tr ',' '\n' \
    | sed -n 's/^ *\(exposed-modules: *\)\?\([A-Z][A-Za-z0-9.]*\) from [^:]*:\([A-Z][A-Za-z0-9.]*\).*/"\2" "\3"/p' | sort -u \
    | awk 'BEGIN{print "{"} {print " " $0} END{print "}"}' > "$w/if/reexports.edn"
  # the front end in shards (REPR_HASKELL_FRONT_SHARDS, default 4), one process each, Go's heap held near
  # REPR_HASKELL_FRONT_MEM (default 1536MiB)
  local n=${#files[@]} k=${REPR_HASKELL_FRONT_SHARDS:-4} i pids=()
  for i in $(seq 0 $((k - 1))); do
    local shard=()
    for f in $(seq $i $k $((n - 1))); do shard+=("${files[$f]}"); done
    [ ${#shard[@]} = 0 ] && continue
    (export GOMEMLIMIT=${REPR_HASKELL_FRONT_MEM:-1536MiB}; arbace_tool -m arbace.repr.haskell.front build --ifaces "$w/if" --libs "${libs//:/,}" -o "$w/out" "${shard[@]}") \
      > "$w/front.$i.log" 2>&1 &
    pids+=($!)
  done
  for i in "${pids[@]}"; do wait "$i" || true; done
  cat "$w"/front.*.log | grep -E '^[^ ]+ (ok|read|rename|typecheck|typecheck-errors|stg|crash) ' | sort > "$w/front.txt" || true
  local exe; exe=$("$root/bin/hsi" build)
  local img=${HSI_IMAGE:-$root/.tmp/hsi/image} la=() l
  # hsi's caps (the user's decision 4, 2026-11-06): ARBACE_MEM_GIB (address space, GiB; Go's heap limit three quarters
  # of it) and HSI_TIMEOUT (CPU seconds), as bin/hsi check takes them; the light defaults 2 GiB and 120 s, the gate's
  # night run 16 GiB
  local gib=${ARBACE_MEM_GIB:-2} cpu=${HSI_TIMEOUT:-120}
  IFS=: read -r -a dirs <<< "$libs"; for l in "${dirs[@]}"; do la+=(--lib "$l"); done
  "$exe" image --out "$img" "${la[@]}" 2> "$w/image.log" || { cat "$w/image.log" >&2; return 1; }
  : > "$w/results.edn"
  local pass=0 total=0
  while IFS='|' read -r id f d a sin nm b <&3; do
    local so se rl rs rso rse dif res="" s=0 r
    total=$((total + 1))
    if [ ! -f "$w/out/stg/$b/Main.stg.ae" ]; then
      res="{:id \"$id\" :result :no-stg :stage \"$(grep "^$b " "$w/front.txt" | cut -d' ' -f2 | head -1)\"}"
    else
      r=$w/run/$b
      rm -rf "$r"; mkdir -p "$r"; cp -r "$d"/. "$r"/; : > "$r/.empty"
      (cd "$r" && env -i PATH=/usr/bin:/bin LANG=C.UTF-8 TZ=UTC HOME="$r" timeout -s KILL $((cpu * 3)) \
         sh -c "ulimit -v $((gib * 1048576)); export GOMEMLIMIT=$((gib * 768))MiB; ulimit -t $cpu; exec $(printf '%q ' "$exe" run "${la[@]}" --image "$img" --prog "$w/out/stg/$b" --name "$nm" --) $a" \
         < "$r/${sin:-.empty}" > "$w/$b.stdout" 2> "$w/$b.stderr") || s=$?
      rm -rf "$r"
      echo "$s" > "$w/$b.status"
      so=$(sha256sum < "$w/$b.stdout" | cut -c1-64); se=$(sha256sum < "$w/$b.stderr" | cut -c1-64)
      rl=$(grep -F "{:id \"$id\" " "$ref" || true)
      rs=$(echo "$rl" | sed -n 's/.*:status \([0-9]*\).*/\1/p'); rso=$(echo "$rl" | sed -n 's/.*:stdout "\([0-9a-f]*\)".*/\1/p'); rse=$(echo "$rl" | sed -n 's/.*:stderr "\([0-9a-f]*\)".*/\1/p')
      dif=""; [ "$s" = "$rs" ] || dif="$dif :status"; [ "$so" = "$rso" ] || dif="$dif :stdout"; [ "$se" = "$rse" ] || dif="$dif :stderr"
      if [ -z "$rs" ]; then res="{:id \"$id\" :result :no-ref}"
      elif [ -z "$dif" ]; then res="{:id \"$id\" :result :pass}"; pass=$((pass + 1))
      else res="{:id \"$id\" :result :fail :differs [${dif# }]}"; fi
    fi
    echo "$res" >> "$w/results.edn"
  done 3< "$plan"
  echo "run-check: $pass of $total programs run on hsi from Arbace's own STG with GHC's -O0 output"
  # the negative control: each program's run against the next program's reference (a pair whose two references are
  # the same run, two programs printing nothing, is no control: skipped), the judge's three parts
  local prev="" prevref="" ctl=0 npairs=0
  while IFS='|' read -r id f d a sin nm b <&3; do
    local rl2 key2
    rl2=$(grep -F "{:id \"$id\" " "$ref" || true)
    key2="$(echo "$rl2" | sed -n 's/.*:status \([0-9]*\).*/\1/p') $(echo "$rl2" | sed -n 's/.*:stdout "\([0-9a-f]*\)".*/\1/p') $(echo "$rl2" | sed -n 's/.*:stderr "\([0-9a-f]*\)".*/\1/p')"
    if [ -n "$prev" ] && [ -f "$w/$prev.stdout" ] && [ "$key2" != "$prevref" ]; then
      npairs=$((npairs + 1))
      if [ "$(cat "$w/$prev.status") $(sha256sum < "$w/$prev.stdout" | cut -c1-64) $(sha256sum < "$w/$prev.stderr" | cut -c1-64)" = "$key2" ]; then ctl=1; fi
    fi
    prev=$b; prevref=$key2
  done 3< "$plan"
  if [ "$ctl" = 1 ] || { [ "$npairs" -lt 1 ] && [ "$total" -ge 2 ]; }; then echo "run-check: the negative control passed: the judge does not tell programs apart" >&2; st=1
  else echo "run-check: the negative control fails as it must (each run against the next program's reference, $npairs pairs)"; fi
  # the record: each result against its line (the class a line carries is kept by --record)
  if [ -n "$record" ]; then
    arbace_tool "$root/test/haskell/run_record.ae" record "$rec" "$w/results.edn" || st=1
  else
    arbace_tool "$root/test/haskell/run_record.ae" judge "$rec" "$w/results.edn" || st=1
  fi
  return $st
}

# typecheck_check [DIR]: the elaborator's check (HF3; doc/haskell/FRONTEND-SURVEY.md, "As built: HF3 (start)"): every
# T*.hs of DIR (default test/haskell/typecheck, Haskell 2010) read natively, renamed (rename-check's judge first), elaborated
# by arbace.repr.haskell.typecheck and judged against the helper's tc verb (GHC's types of the module's things, its
# desugared Core with the types erased): the types alpha-equivalent, the evidence equal; then the negative control (the
# elaborator with defaulting's order reversed and superclass-implied constraints kept) must differ from GHC on some module.
# Light: a few seconds a module. Work in .tmp/repr-haskell/typecheck-check/
typecheck_check() {
  case ${1:-} in *.txt) typecheck_list "$1"; return ;; esac
  local d=${1:-$root/test/haskell/typecheck} w=$rh/typecheck-check files trees=() f st=0
  rm -rf "${w:?}"; mkdir -p "$w"
  files=($(cd "$d" && ls T*.hs))
  (cd "$d" && "$helper" tc --libdir "$libdir" -o "$w/ghc" --ghc -XHaskell2010 -i. --files "${files[@]}") > "$w/ghc.log" 2>&1 || { tail -5 "$w/ghc.log" >&2; return 1; }
  (cd "$d" && "$helper" rn --libdir "$libdir" -o "$w/rn" --ghc -XHaskell2010 -i. --files "${files[@]}") > "$w/rn.log" 2>&1 || { tail -5 "$w/rn.log" >&2; return 1; }
  "$helper" iface --libdir "$libdir" -o "$w/if" --ghc -XHaskell2010 --files Prelude Data.List Data.Maybe Data.Char Control.Monad Data.Ix Data.Foldable Data.Traversable Data.Functor > "$w/if.log" 2>&1 || true
  (cd "$d" && arbace_tool -m arbace.repr.haskell.native read -o "$w/nd" --flags "-XHaskell2010" "${files[@]}" > "$w/read.log") || { tail -5 "$w/read.log" >&2; return 1; }
  local dumps=(); for f in "${files[@]}"; do dumps+=("$w/nd/$f.edn"); trees+=("$w/tree/$f.rn-tree.edn"); done
  arbace_tool -m arbace.repr.haskell.rename check --ifaces "$w/if" --local "$w/ifl" --ghc "$w/rn" -o "$w/tree" "${dumps[@]}" > "$w/rename.txt" 2>&1 || st=1
  grep '^rename-check:' "$w/rename.txt"
  arbace_tool -m arbace.repr.haskell.typecheck check --ifaces "$w/if" --local "$w/tifl" --ghc "$w/ghc" -o "$w/core" "${trees[@]}" | tee "$w/report.txt" | grep -v '^ok' || true
  grep -q '^typecheck-check: \([0-9]*\) of \1 modules equal' "$w/report.txt" || st=1
  arbace_tool -m arbace.repr.haskell.typecheck check --control true --ifaces "$w/if" --local "$w/tifl-control" --ghc "$w/ghc" -o "$w/control" "${trees[@]}" > "$w/control.txt" 2>&1 || true
  if grep -q '^typecheck-check: \([0-9]*\) of \1 modules equal' "$w/control.txt"; then
    echo "typecheck-check: the negative control passed: the judge does not tell it from GHC" >&2; st=1
  else
    echo "typecheck-check: the negative control differs from GHC ($(grep '^typecheck-check:' "$w/control.txt"))"
  fi
  return $st
}

# typecheck_list LIST: the elaborator over programs of nofib (HF4, doc/haskell/FRONTEND-SURVEY.md, "As built: HF4"), each
# a session of its own (Haskell 2010): GHC's rn and tc dumps, the interfaces of its imports, the native read, the
# renamer, then the elaborator judged as typecheck_check does. LIST's lines: `nofib PATH...` (paths under the pinned
# GHC tarball's nofib/, Main.hs or the program's own file), `known PATH CLASS...` (a program whose recorded non-pass
# is allowed, the class in words). Fails on a program neither ok nor known, or a known one whose rename differs.
# Work in .tmp/repr-haskell/typecheck-list/NAME/
typecheck_list() {
  local list=$1 w=$rh/typecheck-list kind a rest st=0 ok=0 n=0 nk=0 f pw need line
  local tb=$rh/corpus/ghc-9.14.1-src.tar.xz
  [ -f "$tb" ] || { echo "typecheck-check: $tb is missing (bin/repr-haskell corpus fetch)" >&2; return 1; }
  local -A known=()
  while read -r kind a rest; do if [ "$kind" = known ]; then known[$a]=1; fi; done < "$list"
  mkdir -p "$w"
  while read -r kind a rest <&3; do
    case $kind in nofib) ;; *) continue ;; esac
    for f in $a $rest; do
      n=$((n + 1)); pw=$w/$(echo "$f" | tr / _); rm -rf "${pw:?}"; mkdir -p "$pw/src"
      tar -xJf "$tb" -O "ghc-9.14.1/nofib/$f" > "$pw/src/Main.hs" 2> "$pw/tar.log" || { echo "nofib $f: not in the tarball" >&2; st=1; continue; }
      (cd "$pw/src" && "$helper" rn --libdir "$libdir" -o "$pw/ghc-rn" --ghc -XHaskell2010 --files Main.hs) > "$pw/ghc.log" 2>&1 \
        && (cd "$pw/src" && "$helper" tc --libdir "$libdir" -o "$pw/ghc" --ghc -XHaskell2010 --files Main.hs) >> "$pw/ghc.log" 2>&1 \
        || { echo "nofib $f: GHC rejects it" >&2; st=1; continue; }
      need="Prelude $(grep -h '^import' "$pw/src/Main.hs" | sed 's/qualified//; s/safe//' | awk '{print $2}' | sed 's/(.*//' | sort -u | tr '\n' ' ')"
      # shellcheck disable=SC2086
      "$helper" iface --libdir "$libdir" -o "$pw/if" --ghc -XHaskell2010 --files $need > "$pw/if.log" 2>&1 || true
      (cd "$pw/src" && arbace_tool -m arbace.repr.haskell.native read -o "$pw/nd" --flags "-XHaskell2010" Main.hs) > "$pw/read.log" 2>&1 || { echo "nofib $f: the native reader rejects it" >&2; st=1; continue; }
      arbace_tool -m arbace.repr.haskell.rename check --ifaces "$pw/if" --local "$pw/ifl" --ghc "$pw/ghc-rn" -o "$pw/out" "$pw/nd/Main.hs.edn" > "$pw/rn.txt" 2>&1 || true
      grep -q '1 of 1 modules equal' "$pw/rn.txt" || { echo "nofib $f: the renamer differs ($pw/rn.txt)" >&2; st=1; continue; }
      arbace_tool -m arbace.repr.haskell.typecheck check --ifaces "$pw/if" --local "$pw/tifl" --ghc "$pw/ghc" -o "$pw/core" "$pw/out/Main.hs.rn-tree.edn" > "$pw/tc.txt" 2>&1 || true
      line=$(head -1 "$pw/tc.txt")
      case $line in
        ok*) ok=$((ok + 1)); [ -z "${known[$f]:-}" ] || echo "nofib $f: known, and ok now" ;;
        *) if [ -n "${known[$f]:-}" ]; then nk=$((nk + 1)); else echo "nofib $f: $line ($pw/tc.txt)" >&2; st=1; fi ;;
      esac
    done
  done 3< "$list"
  echo "typecheck-check list: $ok of $n programs equal, $nk known non-passes"
  return $st
}

# native_check [LIST]: the native check (test/haskell/native-check.txt by default)
native_check() {
  local full="" mode=lines
  if [ "${1:-}" = --full ]; then full=--full; mode=full; shift; fi
  local list=${1:-$root/test/haskell/native-check.txt} w=$rh/native-check dir flags key src
  corpus_fetch ghc-9.14.1 > "$TMPDIR/repr-haskell-fetch.txt"
  rm -rf "$w"; mkdir -p "$w"
  local pl; pl=$(mktemp "$TMPDIR/repr-haskell-plan.XXXXXX")
  corpus_plan ghc-9.14.1 all > "$pl"
  : > "$w/list.txt"
  local d f rest hargs mf
  while read -r d f rest; do
    case $d in ''|'#'*) continue ;; esac
    hargs=""
    if [ "${d#test:}" != "$d" ]; then
      # a copy of the test directory (hsc2hs writes its output beside the .hsc)
      dir=$w/src/${d#test:}; flags=${rest:--XGHC2021 -haddock}; key=test/${d#test:}
      [ -d "$dir" ] || { mkdir -p "$dir" && cp -R "$root/test/haskell/${d#test:}/." "$dir/"; }
    else
      IFS=$'\t' read -r _ dir flags _ hargs < <(grep -P "^$d\t" "$pl")
      [ -n "$dir" ] || { echo "repr-haskell: native-check: no package $d" >&2; continue; }
      dir=$srcroot/$dir; key=$d
    fi
    # the helper's options as the corpus's dumps give them: hsc2hs's arguments (R6), the flags
    # shellcheck disable=SC2086
    (cd "$dir" && "$helper" dump $full -o "$w/dumps/$key" --libdir "$libdir" --corpus ghc-9.14.1 \
       --helper-hash "sha256:$(helper_hash)" --repo "$root" $hargs --ghc $flags --files "$f") 2>> "$w/helper.err" || true
    # an .hsc module is its hsc2hs output X.hs (R6); a module the helper preprocessed (CPP,
    # unlit, hsc2hs) has the text GHC parses written by the helper's cpp verb, X.hspp
    mf=$f; [ "${f%.hsc}" != "$f" ] && mf=${f%c}
    src=$dir/$f
    if [ "$mf" != "$f" ] || grep -q ':cpp {\|:unlit true\|:hsc2hs {' "$w/dumps/$key/$mf.edn" 2> "$TMPDIR/repr-haskell-grep.txt"; then
      # shellcheck disable=SC2086
      (cd "$dir" && "$helper" cpp -o "$w/hspp/$key" --libdir "$libdir" --repo "$root" $hargs \
         --ghc $flags --files "$f") 2>> "$w/helper.err" || true
      src=$w/hspp/$key/$mf.hspp
    fi
    # the native reader preprocesses natively from the module's directory; the helper's text is
    # the reference its preprocessing is compared with
    [ "$src" = "$dir/$f" ] && src=-
    printf '%s %s %s %s\n' "$w/dumps/$key/$mf.edn" "$dir" "$mf" "$src" >> "$w/list.txt"
  done < "$list"
  rm -f "$pl"
  arbace_tool -m arbace.repr.haskell.native check --list "$w/list.txt" --libdir "$libdir" --mode $mode --report "$w/report.edn"
}

cmd=${1:-}
[ $# -gt 0 ] && shift
case $cmd in
  helper) build ;;
  genprimopcode) ghc_check; c=${1:-ghc-9.14.1}; corpus_fetch "$c"; genprimopcode_build "$c"; echo "$genprimopcode $primops" ;;
  corpus)
    sub=${1:-list}; [ $# -gt 0 ] && shift
    case $sub in
      fetch) corpus_fetch "$@"; echo "$srcroot" ;;
      list) ghc_check
            for w in modules hsc boot; do
              corpus_plan "${1:-ghc-9.14.1}" $w | while IFS=$'\t' read -r n _ _ fs; do
                for f in $fs; do echo "$w $n $f"; done
              done
            done ;;
      *) echo "usage: bin/repr-haskell corpus fetch|list [CORPUS]" >&2; exit 2 ;;
    esac ;;
  record-corpus)
    live=1; ghc_check; build; c=${1:-ghc-9.14.1}; corpus_fetch "$c"; record_corpus "$c" ;;
  verify-corpus)
    live=1; sample=""; [ "${1:-}" = --sample ] && { sample=$2; shift 2; }
    ghc_check; build; c=${1:-ghc-9.14.1}; corpus_fetch "$c"; verify_corpus "$c" "$sample" ;;
  dump)
    live=1; ghc_check; build
    if [ "${1:-}" = --full ] && [ "${2:-}" = --corpus ]; then
      c=${3:-ghc-9.14.1}; corpus_fetch "$c"; dump_corpus "$c" "$rh/dumps/$c-full" --full
      cat "$rh/dumps/$c-full"/*.err >&2; exit 0
    fi
    if [ "${1:-}" = --corpus ]; then
      c=${2:-ghc-9.14.1}; corpus_fetch "$c"; dump_corpus "$c" "$rh/dumps/$c"
      cat "$rh/dumps/$c"/*.err >&2; exit 0
    fi
    out=$work/out; full=""; files=(); gflags=()
    while [ $# -gt 0 ]; do
      case $1 in
        -o) out=$2; shift 2 ;;
        --full) full=--full; shift ;;
        --ghc) shift; gflags=("$@"); break ;;
        *) files+=("$1"); shift ;;
      esac
    done
    hsdump dump $full -o "$out" --ghc "${gflags[@]}" --files "${files[@]}" ;;
  read)
    # the reader: native by default for the corpus (2026-11-07), the helper's dumps (the records', or live) with --reader helper
    reader=${REPR_HASKELL_READER:-native}
    if [ "${1:-}" = --reader ]; then
      reader=${2:-helper}; shift 2
      [ "$reader" = helper ] || [ "$reader" = native ] || { echo "repr-haskell: --reader native|helper" >&2; exit 2; }
      if [ "$reader" = native ] && [ "${1:-}" != --corpus ] && [ "${2:-}" != --corpus ]; then native_read "$@"; exit $?; fi
    fi
    full=""
    if [ "${1:-}" = --full ] && [ "${2:-}" = --corpus ]; then full=--full; shift; fi
    if [ "${1:-}" = --corpus ]; then
      shift; c=${1:-ghc-9.14.1}
      # the corpus's dumps are the records' unless REPR_HASKELL_LIVE=1 (the helper, GHC)
      if [ "$reader" = native ]; then
        corpus_fetch "$c"; native_env; native_place_inputs "$c"
        native_dump_corpus "$c" "$rh/ndumps/$c${full:+-full}" "$([ -n "$full" ] && echo full || echo lines)"
        out=$rh/nforms/$c${full:+-full}
        rm -rf "$out"
        read_files --jobs "$jobs" -o "$out" --report "$out.report.edn" --root "$rh/ndumps/$c${full:+-full}"
      else
      if [ -n "$live" ]; then ghc_check; build; corpus_fetch "$c"; fi
      dump_corpus "$c" "$rh/dumps/$c${full:+-full}" $full
      out=$rh/forms/$c${full:+-full}
      rm -rf "$out"
      read_files --jobs "$jobs" -o "$out" --report "$out.report.edn" --root "$rh/dumps/$c${full:+-full}"
      fi
    else
      read_files --jobs "$jobs" "$@"
    fi ;;
  print) arbace_tool -m arbace.repr.haskell print --jobs "$jobs" "$@" ;;
  roundtrip) roundtrip "$@" ;;
  native-check) ghc_check; build; native_check "$@" ;;
  tables) ghc_check; tables "$@" ;;
  rn-dump) ghc_check; build; out=$work/out; [ "${1:-}" = -o ] && { out=$2; shift 2; }; flags=(); files=()
           while [ $# -gt 0 ]; do case $1 in --ghc) shift; flags=("$@"); break ;; *) files+=("$1"); shift ;; esac; done
           hsdump rn -o "$out" --ghc "${flags[@]}" --files "${files[@]}" ;;
  iface) ghc_check; build; out=$work/out; [ "${1:-}" = -o ] && { out=$2; shift 2; }; flags=(); mods=()
         while [ $# -gt 0 ]; do case $1 in --ghc) shift; flags=("$@"); break ;; *) mods+=("$1"); shift ;; esac; done
         hsdump iface -o "$out" --ghc "${flags[@]}" --files "${mods[@]}" ;;
  rename-check) ghc_check; build; rename_check "$@" ;;
  tc-dump) ghc_check; build; out=$work/out; [ "${1:-}" = -o ] && { out=$2; shift 2; }; flags=(); files=()
           while [ $# -gt 0 ]; do case $1 in --ghc) shift; flags=("$@"); break ;; *) files+=("$1"); shift ;; esac; done
           hsdump tc -o "$out" --ghc "${flags[@]}" --files "${files[@]}" ;;
  typecheck-check) ghc_check; build; typecheck_check "$@" ;;
  stg-check) ghc_check; build; stg_check "$@" ;;
  run-check) ghc_check; build; run_check "$@" ;;
  test) exec "$root/bin/lib/repr-haskell/test" "$@" ;;
  record-native-inputs) record_native_inputs "$@" ;;
  native-libdir) corpus_fetch ghc-9.14.1 > "$TMPDIR/repr-haskell-fetch.txt"; native_env; echo "$nsysroot$libdir" ;;
  *) sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; exit 2 ;;
esac

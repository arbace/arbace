#!/bin/bash
# The gate's own scripts' tests (GTS114 (a), audit 041): every test/gate/*-test.bash, each on a
# fabricated tree and fake executables under .tmp/ (seconds, no build, no JVM). The ones that need an
# Arbace executable (edge-verdict, edge-mark, frozen-env) take the tools' host (bin/lib/host.bash, stage 0).
#
# Usage: bin/gate-tests [DIR]    DIR: another directory of *-test.bash (the tests' own test)
# Exit status: 0 when every test passes.
set -uo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash" # TMPDIR: .tmp/tmp when unset
. "$root/bin/lib/host.bash"
cd "$root" || exit 1
dir=${1:-$root/test/gate}
ARBACE_HOST_EXE=$(arbace_host_exe) || exit 1
export ARBACE_HOST_EXE
n=0 failed=
for t in "$dir"/*-test.bash; do
  [ -f "$t" ] || continue
  n=$((n + 1))
  if "$t" > "$TMPDIR/gate-tests.$(basename "$t").log" 2>&1; then
    echo "gate-tests: $(basename "$t") passed"
  else
    echo "gate-tests: $(basename "$t") FAILED (log $TMPDIR/gate-tests.$(basename "$t").log)"
    tail -20 "$TMPDIR/gate-tests.$(basename "$t").log"
    failed="$failed $(basename "$t")"
  fi
done
if [ "$n" = 0 ]; then echo "gate-tests: no test in $dir"; exit 1; fi
if [ -n "$failed" ]; then echo "gate-tests: $n tests, failed:$failed"; exit 1; fi
echo "gate-tests: $n tests passed"

#!/bin/bash
# cppi, C++'s eval (doc/cpp/CPP-SURVEY.md §5, "As built: CX6"; doc/cpp/LLVM.md): the oracle (clang -O0) compiles a C++
# translation unit to LLVM IR, repr/llvm reads it as LLVM forms (arbace.repr.llvm), and arbace.cpp.lower lowers them to C
# forms, printed as C by repr/c. Until ci (C23's C5) runs C forms, gcc -O0 is the second judge: it compiles the printed
# C with the runtime of exceptions (arbace/cpp/rt/eh.c.ae, C forms) and the program runs as the original. All of it on the
# tools' host (stage 0, evaluated from the checkout); the light tier by default (CPPI_JOBS 4, GOMEMLIMIT 1500MiB). The
# testsuite's programs link its util/ library (libtestc++, compiled by g++ once a run) and libstdc++exp, natively, as
# libstdc++ itself for the original. Since CX7 the lowered program links the lowered runtime instead: libsupc++ and
# libstdc++-v3/src compiled by the oracle and lowered (runtime-build), the testsuite's util/ library lowered with it.
#
#   bin/cppi lower FILE.ll [-o OUT.c] [--forms OUT.ae]
#                               FILE's IR lowered to C forms (OUT.ae) and printed as C (OUT.c, default FILE.c)
#   bin/cppi runtime OUT.c      the runtime of exceptions printed as C
#   bin/cppi testsuite          libstdc++-v3/testsuite extracted from the pinned gcc 15.2.0 tarball into .tmp/cppi/gcc/
#                               (REPR_CPP_GCC_TARBALL, default the main checkout's .tmp/c1/gcc/gcc-15.2.0.tar.xz)
#   bin/cppi list samples|runtime|samples+runtime|essential|libstdcxx [--sample N]
#                               a check list on the standard output (NAME, STD, ARGS, PATH, tab-separated; a first line `#list KEY` names the recorded list
#                               it is, `#part NAME` a part of one; `samples+runtime`: the recorded `samples`): test/cpp/samples,
#                               test/cpp/runtime/samples (CX7), or
#                               the testsuite's run tests (no compile/link/preprocess/error directive, no threads, no shared
#                               libraries, named locales, file I/O or debug mode requirements, no xfail), every Nth (default 15)
#   bin/cppi runtime-build [OUT] [--update] [--jobs N]
#                               the lowered runtime (CX7; test/cpp/runtime/units.edn): libsupc++ and libstdc++-v3/src of the
#                               pinned tarball compiled to IR by the oracle (clang++ -O0, the build's flags) against the host's
#                               configured headers at their digests (test/cpp/host/headers.sha256, CP101 (c)), the IR's digests
#                               against test/cpp/runtime/ir.sha256 (--update rewrites them), each unit's round trip through LLVM
#                               forms (the objects equal), lowered, compiled by gcc -O0, archived: OUT/liblstdc++.a,
#                               OUT/liblstdc++exp.a and the pending-flag layer OUT/rt.o (arbace/cpp/rt/eh.c.ae); the units'
#                               levels in OUT/results.tsv and OUT/summary.edn (default OUT .tmp/cppi/runtime); OUT/key.txt the
#                               digests of what it was built from (runtime-key), OUT/key their digest, written once it passes
#   bin/cppi runtime-key [OUT|--print]
#                               OUT's key against the checkout's (the lowering, repr/llvm, repr/c, eh.c.ae, units.edn and the
#                               shims, the IR's pin, runtime-build's own steps, gcc's flags, gcc, clang and the tools' host):
#                               "current", or "stale" and the inputs that differ (exit 1); --print: the checkout's key lines
#   bin/cppi codegen FILE OUT   FILE compiled without clang (doc/cpp/CODEGEN.md): the native parser, arbace.cpp.sema and
#                               arbace.cpp.codegen into LLVM forms (OUT/forms.ae, printed as OUT/gen.ll), lowered (OUT/gen.c),
#                               gcc -O0 with the lowered runtime (--runtime DIR, default .tmp/cppi/runtime) and run: OUT/gen.out,
#                               OUT/gen.status
#   bin/cppi codegen-check [LIST] WORK [--runtime DIR]
#                               each sample of test/cpp/codegen (or LIST: NAME<tab>PATH lines) by both routes: clang's IR
#                               (clang++ -O0 -S -emit-llvm) lowered and run, and the code generator's forms lowered and run with
#                               the same runtime (and its IR built by clang++ and run natively): status and stdout equal, every
#                               name it defines one clang's IR defines; against test/cpp/codegen/known.edn (arbace.cpp.codegen's
#                               judge: WORK/results.tsv, WORK/summary.edn). The runtime need not be at the checkout's key: both
#                               routes link the same one
#   bin/cppi lower-corpus samples|libstdcxx-every-15th [WORK] [--only-list FILE] [lower-check's options]
#                               lower-check over a recorded list of test/cpp/lower-results.edn, made by its key (CX10: the gate's cpp-lower
#                               parts; the testsuite extracted first when it is not; WORK default .tmp/cppi/lower-KEY; --only-list FILE (GT9,
#                               the gate's rotation): only the names FILE lists, one a line, a partial run: held to the record's results by
#                               name, not to the whole list; a failing file prints as `  failing: NAME ...`)
#   bin/cppi lower-essential [WORK] [lower-check's options]
#                               lower-check over test/cpp/essential-lower.txt's programs (CX10: the gate's cpp-lower-essential; `bin/cppi list
#                               essential`, a part never held to the record; WORK default .tmp/cppi/essential)
#   bin/cppi selftest [--accept-skips] [NAME...] the checks' own tests (test/cpp/selftest/NAME.sh: the review 007 cases; ARBACE_HOST_EXE=/bin/true: the dry mode, which skips the tests that need the tools and exits 3, 0 with --accept-skips)
# The judges are arbace.cpp.check's (apart from the lowering, so they are not in the runtime's key).
#   bin/cppi lower-check LIST WORK [--jobs N] [--runtime OUT] [--recorded KEY|none|auto]
#                               each file of LIST: the IR (clang++ -O0 -S -emit-llvm), the original (the IR linked by clang++)
#                               run, g++'s build run (the reference's opinion, recorded), the IR's round trip through LLVM
#                               forms (read, print, clang -c: the object equal to the original IR's), the lowering, gcc -O0
#                               on the lowered C linked with the lowered runtime (no native libstdc++; runtime-build first when
#                               OUT has none or its key is not the checkout's, CPPI_RUNTIME_STALE=refuse: refused instead, exit
#                               4) and its run: the status, stdout and stderr equal to the original's; judged against
#                               test/cpp/lower-known.edn and the recorded test/cpp/lower-results.edn (a recorded pass that does
#                               not pass fails; an IR clang did not reject with its own diagnostics fails) into
#                               WORK/results.tsv and WORK/summary.edn; an empty LIST is refused. A run of a recorded list (KEY:
#                               samples, libstdcxx-every-15th; auto: the one more than half of whose names the run holds)
#                               fails on a recorded name missing from it or a count other than the record's (review 018, R4)
#                               and on its negative control (GTS81 (a), test/cpp/controls.edn): a sample's lowered run judged
#                               against another's original run must differ (selftest controls). ORS12 (a), ORS27: unless CPPI_LIVE=1
#                               (the oracle tier) the IR and the native steps' outcomes come from the records (test/cpp/records/), the
#                               print's object is `skipped`, and gcc and the lowered run are too: the lowered C is read by repr/c and
#                               checked by ci's checker instead (FILES/NAME/ci-check.status, a refusal in a class of test/cpp/divergences.edn
#                               known); the runtime is built without gcc (OUT/key.records; a live build writes key and key.records)
#   bin/cppi record-ir [--corpus C,...] [--every N,M] [--runtime] [--verify [--sample N]]
#                               the IR packs (test/cpp/records/; test/oracle-records/cpp.bash), by hand with clang++ and g++: the run
#                               corpora's programs (--every: the samplings, ORS26 (b); libstdcxx with its util library's IR) or the runtime's units
#   bin/cppi run [--std S] [OPTION...] FILE.cpp [-- ARG...]
#                               FILE (one translation unit) compiled to IR by the oracle, lowered, read and built by ci with the
#                               lowered runtime and musl (arbace.cpp.run), run by ci's back end with ARG...; its status the command's
#   bin/cppi runtime-ci [OUT]   the lowered runtime's units read by repr/c as ci's library, OUT/ci (CX8; keyed)
#   bin/cppi record-ref [--corpus C,...] [--only] [--sample N] [--ids LIST]
#                               g++ 15.2's -O0 runs of the run corpora recorded, test/cpp/ref-gxx15.edn (bin/lib/cppi/record-ref)
#   bin/cppi check [--corpus C,...] [--only LIST] [--sample N] [--record] [--judge] [--resume]
#                               the run corpora on ci against g++'s runs, every non-pass in a class of test/cpp/divergences.edn,
#                               against test/cpp/check-linux-amd64.edn (bin/lib/cppi/check, its header; CX8)
#   bin/cppi check --aot [the same options]
#                               the same programs' node programs translated by cf2g and built by TamaGo's go, against g++'s runs
#                               and test/cpp/check-aot-linux-amd64.edn, classes divergences-aot.edn then divergences.edn
#                               (bin/lib/cppi/check-aot)
#   bin/cppi divergences [--aot] [--sample N]  the recorded check (or the sampling's record, check[-aot]-every-N) judged against the classes
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash"
. "$root/bin/lib/tools.bash"
. "$root/test/oracle-records/oracle.bash"
. "$root/test/oracle-records/cpp.bash"
. "$root/bin/lib/cppi/lists.bash"
# the main checkout: a worktree's (.tmp/worktrees/NAME) or the clean run's clone's (.tmp/gate-clean/SHA), else this one (CX10, as C's
# tools since queue 150)
main_checkout=${root%%/.tmp/gate-clean/*}; main_checkout=${main_checkout%%/.tmp/worktrees/*}
export GOMAXPROCS=${GOMAXPROCS:-4} GOMEMLIMIT=${GOMEMLIMIT:-1500MiB}
ts_root=$root/.tmp/cppi/gcc/gcc-15.2.0/libstdc++-v3/testsuite
GCC_FLAGS="-std=gnu23 -O0 -w -fno-builtin -fno-strict-aliasing -ffp-contract=off"

testsuite() {
  local t; t=$(tarball_check)
  mkdir -p "$root/.tmp/cppi/gcc"
  tar -xJf "$t" -C "$root/.tmp/cppi/gcc" gcc-15.2.0/libstdc++-v3/testsuite
  echo "testsuite: $ts_root"
}

# A list may begin with a header line `#list KEY` (review 018's CP132 (b)): the recorded list of test/cpp/lower-results.edn it is
# (samples, libstdcxx-every-15th), which lower-check holds the run to. No header: no recorded list. `#part NAME` marks a part of
# one, never held.
list_samples() {
  local f
  [ "${1:-}" = body ] || echo "#part samples"
  for f in "$root"/test/cpp/samples/*.cpp; do printf '%s\t%s\t%s\t%s\n' "samples/$(basename "$f")" c++23 "" "$f"; done
}

list_essential() { # CX10: test/cpp/essential-lower.txt's files of the samples and the runtime's samples, a part (never held to a record)
  echo "#part essential"
  { list_samples body; list_runtime body; } | awk -F'\t' 'NR == FNR { if ($0 !~ /^#/ && $0 != "") want[$0] = 1; next } ($1 in want)' "$root/test/cpp/essential-lower.txt" -
}

list_runtime() { # CX7's samples of the runtime (test/cpp/runtime/samples)
  local f
  [ "${1:-}" = body ] || echo "#part runtime"
  for f in "$root"/test/cpp/runtime/samples/*.cpp; do printf '%s\t%s\t%s\t%s\n' "runtime/$(basename "$f")" c++23 "" "$f"; done
}

list_libstdcxx() { # the run tests: no directive but run, no threads, shared libraries, named locales or file I/O
  local n=${1:-15} f std opts
  [ -d "$ts_root" ] || { echo "list: no testsuite (bin/cppi testsuite)" >&2; exit 1; }
  if [ "$n" = 15 ]; then echo "#list libstdcxx-every-15th"; else echo "#part libstdcxx-every-$n"; fi
  ( cd "$ts_root" && find . -name '*.cc' -path './[0-9][0-9]_*' | LC_ALL=C sort ) | sed 's|^\./||' > "$TMPDIR/cppi-all.list"
  ( cd "$ts_root" && grep -L -E "dg-do (compile|link|preprocess)|dg-error|dg-additional-sources|dg-require-(thread|effective-target pthread)|-pthread|dg-require-sharedlib|dg-require-namedlocale|dg-require-fileio|dg-require-gthreads|dg-require-debug-mode|xfail" $(cat "$TMPDIR/cppi-all.list") ) \
    | grep -v '^30_threads' | awk -v n="$n" 'NR % n == 1' > "$TMPDIR/cppi-run.list"
  while read -r f; do
    std=gnu++17
    if grep -q -E 'target c\+\+26' "$ts_root/$f"; then std=gnu++26
    elif grep -q -E 'target c\+\+23' "$ts_root/$f"; then std=gnu++23
    elif grep -q -E 'target c\+\+2[0a]' "$ts_root/$f"; then std=gnu++20; fi
    opts=$(grep -o 'dg-options "[^"]*"' "$ts_root/$f" | head -1 | sed 's/dg-options "//; s/"$//' || true)
    s=$(printf '%s' "$opts" | grep -o -- '-std=[a-z+0-9]*' | tail -1 | sed 's/-std=//' || true)
    [ -n "$s" ] && std=$s
    # the options of bin/lib/cppi/lists.bash's run_list (cppi_opts): one program has one IR record's key in the lowering and in the run
    # check (ORS26 (b); the lowering's filter was a subset of the check's: -fno-elide-constructors and the others were given to neither oracle)
    opts=$(printf '%s' "$opts" | cppi_opts)
    printf '%s\t%s\t%s\t%s\n' "$f" "$std" "-I$ts_root/util $opts" "$ts_root/$f"
  done < "$TMPDIR/cppi-run.list"
}

gcc_root=$root/.tmp/cppi/gcc/gcc-15.2.0
export root gcc_root

tarball_check() { # the pinned gcc 15.2.0 tarball's path, its digest checked
  local t=${REPR_CPP_GCC_TARBALL:-$main_checkout/.tmp/c1/gcc/gcc-15.2.0.tar.xz} want
  want=$(GOMEMLIMIT=1GiB arbace_tool -e "(print (get-in (read-string (slurp \"$root/test/cpp/corpora.edn\")) [:pins :gcc-15.2.0 :sha256]))")
  [ "$(sha256sum "$t" | cut -d' ' -f1)" = "$want" ] || { echo "cppi: $t is not the pinned tarball" >&2; exit 1; }
  echo "$t"
}

cap() { # cap FILE: standard input into FILE, at most 1 MB (a compiler's errors over a binary can be gigabytes); a run's stderr is
  # held to the same by ulimit -f 1024 (1 MiB; a program writing past it dies of SIGXFSZ, status 153: not comparable), review 018's R7
  head -c 1048576 > "$1"
}

one() { # one NAME STD ARGS PATH: the native steps of one file into $work/files/NAME/ (emptied first: no level file of an earlier
  # run in a reused WORK stands for this one's, review 007's finding 5)
  local n=$1 std=$2 args=$3 p=$4 d=$work/files/$1
  rm -rf "$d"; mkdir -p "$d"
  # ORS12 (a): the oracle's products and outcomes from the records (test/oracle-records/cpp.bash), the toolchain only when CPPI_LIVE is set
  if ! cpr_live; then cpr_ir_or_fail "$n" "$std" "$args" "$p" "$d"; return 0; fi
  # shellcheck disable=SC2086
  ( cd "$d" && timeout 300 clang++ -x c++ -std=$std $args -O0 -S -emit-llvm "$p" -o x.ll; echo $? > ir.status ) 2>&1 | cap "$d/ir.log"
  [ "$(cat "$d/ir.status")" = 0 ] || return 0
  ( cd "$d" && timeout 300 clang++ x.ll -o orig $LIBS; echo $? > orig-link.status ) 2>&1 | cap "$d/orig-link.log"
  ( cd "$d" && timeout 300 clang -c x.ll -o x.o ) 2>&1 | cap "$d/obj.log"
  grep -q "undefined reference to \`main'" "$d/orig-link.log" && echo 1 > "$d/no-main"
  if [ "$(cat "$d/orig-link.status")" = 0 ]; then
    ( cd "$d" && ulimit -f 1024 && timeout "${CPPI_RUN_TIMEOUT:-120}" ./orig 2> orig.err | cap orig.out; echo "${PIPESTATUS[0]}" > orig.status )
  fi
  # shellcheck disable=SC2086
  ( cd "$d" && timeout 300 g++ -x c++ -std=$std $args -O0 "$p" -x none -o gxx $LIBS; echo $? > gxx-link.status ) 2>&1 | cap "$d/gxx-link.log"
  if [ "$(cat "$d/gxx-link.status")" = 0 ]; then
    ( cd "$d" && ulimit -f 1024 && timeout "${CPPI_RUN_TIMEOUT:-120}" ./gxx 2> gxx.err | cap gxx.out; echo "${PIPESTATUS[0]}" > gxx.status )
  fi
  rm -f "$d/gxx" "$d/x.o.tmp"; return 0
}

two() { # two NAME: the print's object, gcc on the lowered C and its run
  local n=$1 d=$work/files/$1
  # the print's object (class D: the oracle compiling Arbace's own output) is judged in the oracle tier (CPPI_LIVE=1); from the records it is `skipped`
  [ -f "$d/print.ll" ] && cpr_live && { ( cd "$d" && timeout 300 clang -c print.ll -o print.o; echo $? > print-obj.status ) 2>&1 | cap "$d/print-obj.log"; }
  # the objects compared here and dropped, with the forms' texts (the disk: a few MB a file)
  if [ -f "$d/x.o" ] && [ -f "$d/print.o" ]; then
    if cmp -s "$d/x.o" "$d/print.o"; then echo same > "$d/object"; else echo differs > "$d/object"; fi
  elif ! cpr_live && [ -f "$d/ir.status" ] && [ "$(cat "$d/ir.status")" = 0 ]; then echo skipped > "$d/object"
  fi
  rm -f "$d/x.o" "$d/print.o" "$d/forms.ae" "$d/print.ll" "$d/lowered.c.ae" "$d/lowered.o"
  # ORS27: gcc compiling the lowered C and its run are the oracle tier's (class D: gcc judging Arbace's own output, cpp-lower-oracle,
  # CPPI_LIVE=1); from the records the lowered C is read by repr/c and checked by ci's checker instead (lower_check's check-c, after two)
  if [ -f "$d/lowered.c" ] && ! cpr_gcc; then echo skipped > "$d/gcc.status"; rm -f "$d/orig"; return 0; fi
  if [ -f "$d/lowered.c" ]; then
    # shellcheck disable=SC2086
    if [ -f "$d/no-main" ]; then
      ( cd "$d" && timeout 300 gcc $GCC_FLAGS -c lowered.c -o lowered.o; echo $? > gcc.status ) 2>&1 | cap "$d/gcc.log"
      return 0
    fi
    ( cd "$d" && timeout 300 gcc $GCC_FLAGS lowered.c -o low $LOW_LIBS; echo $? > gcc.status ) 2>&1 | cap "$d/gcc.log"
    if [ "$(cat "$d/gcc.status")" = 0 ]; then
      ( cd "$d" && ulimit -f 1024 && timeout "${CPPI_RUN_TIMEOUT:-120}" ./low 2> low.err | cap low.out; echo "${PIPESTATUS[0]}" > low.status )
    fi
  fi
  rm -f "$d/low" "$d/orig"; return 0
}
export -f cap one two; export GCC_FLAGS LIBS LOW_LIBS

rt_ir() { # rt_ir UNIT SOURCE STD FLAGS: one runtime unit's IR (cwd the tarball's root, so the IR names the sources by their path in it)
  local u=$1 src=$2 std=$3 fl=$4 d=$rt/units/$1 shim
  rm -rf "$d"; mkdir -p "$d" # no level file of an earlier build stands for this one's
  shim=$(grep -F -x -A1 "$src" "$rt/shims.txt" | sed -n 2p || true)
  # ORS12 (a): the unit's IR from the pack cpp-runtime-ir unless CPPI_LIVE is set
  if ! cpr_live; then rt_ir_records "$u" "$src" "$std" "$fl" "$shim" "$d"; return 0; fi
  # the shim named relative to the tarball's root, where clang runs: the IR's ModuleID and source_filename are the path as
  # given, which no -ffile-prefix-map rewrites, so an absolute one made the IR's digest the checkout's place (CX8)
  [ -n "$shim" ] && src=$(realpath --relative-to="$gcc_root" "$root/test/cpp/runtime/shims/$shim")
  local maps="-ffile-prefix-map=$gcc_root/= -ffile-prefix-map=$rt/gen/=gen/ -ffile-prefix-map=$root/test/cpp/runtime/=test/cpp/runtime/"
  # shellcheck disable=SC2086
  if [ "$std" = c ]; then
    ( cd "$gcc_root" && timeout 600 clang -x c -O0 -S -emit-llvm $maps -DHAVE_STDLIB_H -DHAVE_STRING_H -DIN_GLIBCPP_V3 -Iinclude $fl "$src" -o "$d/x.ll"; echo $? > "$d/ir.status" ) 2>&1 | cap "$d/ir.log"
  else
    ( cd "$gcc_root" && timeout 600 clang++ -x c++ -std=$std -O0 -S -emit-llvm $maps -D_GNU_SOURCE -Wno-init-priority-reserved \
        -nostdinc++ -isystem /usr/include/c++/15.2.0 -isystem /usr/include/c++/15.2.0/x86_64-alpine-linux-musl \
        -isystem /usr/include/c++/15.2.0/backward -I"$rt/gen" -Ilibgcc -Ilibstdc++-v3/libsupc++ -I"$(dirname "$2")" $fl "$src" -o "$d/x.ll"
      echo $? > "$d/ir.status" ) 2>&1 | cap "$d/ir.log"
  fi
  # CX10: a shim's IR names its source by its absolute path in the module's ID and source_filename, which -ffile-prefix-map does not
  # touch: written relative to the checkout as the maps write the rest, so test/cpp/runtime/ir.sha256 holds in any checkout (it held
  # cpp-cx7's worktree path: assert_fail.cc's and random.cc's digests differed everywhere else)
  [ "$(cat "$d/ir.status")" = 0 ] && sed -i "1,2s|$root/test/cpp/runtime/|test/cpp/runtime/|" "$d/x.ll"
  [ "$(cat "$d/ir.status")" = 0 ] && ( cd "$d" && timeout 600 clang -c x.ll -o x.o ) 2>&1 | cap "$d/obj.log"
  return 0
}

rt_key() { # rt_key UNIT SRC STD FLAGS SHIM: the key of a unit's IR record (ORS4 (a)): the unit's line, its shim's bytes, the gcc tarball's pin, the recorded
  # clang line, the headers' pin, the recipe (this function's text and rt_ir's)
  local sh=-
  [ -n "$5" ] && sh=$(sha256sum < "$root/test/cpp/runtime/shims/$5" | cut -c1-64)
  { printf '%s\n%s\n%s %s %s\n%s\n%s\n%s\n%s\n' cpr-rt-1 "$1" "$2" "$3" "$4" "$sh" \
      "$(sed -n '/^ {:gcc-15.2.0$/,/:sha256/s/^ *:sha256 "\([0-9a-f]*\)".*/\1/p' "$root/test/cpp/corpora.edn" | head -1)" "$(cpr_clang_line)" "$(cpr_headers_digest)"
    declare -f rt_ir | sha256sum; } | sha256sum | cut -c1-64
}
rt_ir_records() { # rt_ir_records UNIT SRC STD FLAGS SHIM DIR
  local pin=$root/test/cpp/records/cpp-runtime-ir.sha256 man want f n names
  man=$(oracle_manifest "$pin")
  want=$(awk -F'\t' -v i="$1/ir.status" '!/^#/ && $1 == i {print $2; exit}' "$man" 2>"$TMPDIR/cppi-rtir.err")
  if [ -z "$want" ]; then echo 99 > "$6/ir.status"; echo "UNRECORDED: $1 is not in $man (bin/cppi record-ir --runtime, by hand on a host with clang)" > "$6/ir.log"; return 0; fi
  if [ "$want" != "$(rt_key "$1" "$2" "$3" "$4" "$5")" ]; then echo 99 > "$6/ir.status"; echo "STALE: $1's key moved: record again by hand" > "$6/ir.log"; return 0; fi
  names=$(awk -F'\t' -v i="$1/" '!/^#/ && index($1, i) == 1 { r = substr($1, length(i) + 1); if (r !~ /\//) print r }' "$man")
  for n in $names; do f=$(oracle_get "$pin" "$1/$n") || { echo 99 > "$6/ir.status"; echo "refused: $1/$n" > "$6/ir.log"; return 0; }; cp "$f" "$6/$n"; done
}
rt_two() { # rt_two UNIT: the print's object against the IR's, gcc -O0 on the lowered C; the texts dropped once judged
  local d=$rt/units/$1
  [ -f "$d/print.ll" ] && cpr_live && { ( cd "$d" && timeout 600 clang -c print.ll -o print.o; echo $? > print-obj.status ) 2>&1 | cap "$d/print-obj.log"; }
  if [ -f "$d/x.o" ] && [ -f "$d/print.o" ]; then
    if cmp -s "$d/x.o" "$d/print.o"; then echo same > "$d/object"; else echo differs > "$d/object"; fi
  elif ! cpr_live && [ "$(cat "$d/ir.status" 2>"$TMPDIR/cppi-rt2.err")" = 0 ]; then echo skipped > "$d/object"
  fi
  rm -f "$d/x.o" "$d/print.o" "$d/forms.ae" "$d/print.ll" "$d/lowered.c.ae"
  # ORS27: gcc's objects of the lowered units only when CPPI_LIVE is set (the lowered programs' gcc link is the oracle tier's); from the
  # records the units' lowered C is what the runtime is for, ci's library (bin/cppi runtime-ci)
  if [ -f "$d/lowered.c" ] && ! cpr_gcc; then echo skipped > "$d/gcc.status"
  elif [ -f "$d/lowered.c" ]; then
    # shellcheck disable=SC2086
    ( cd "$d" && timeout 900 gcc $GCC_FLAGS -c lowered.c -o lowered.o; echo $? > gcc.status ) 2>&1 | cap "$d/gcc.log"
    # the lowered C kept: bin/cppi runtime-ci reads it as ci's library (CX8)
  fi
  return 0
}
export -f rt_ir rt_two rt_key rt_ir_records

runtime_key() { # what the lowered runtime is built from, a digest a line (review 007's finding 1): the namespaces the lowering
  # loads, the pending-flag layer, the units and their shims, the IR's pin, runtime-build's own steps, gcc's flags, the
  # toolchain and the tools' host
  local exe
  ( cd "$root" && sha256sum arbace/cpp/lower.ae arbace/cpp/rt/eh.c.ae arbace/repr/llvm.ae arbace/repr/llvm/*.ae arbace/repr/c.ae \
      arbace/repr/c/*.ae test/cpp/runtime/units.edn test/cpp/runtime/shims/* test/cpp/runtime/ir.sha256 )
  # the pin runtime-build checks the headers against (the one CPPI_HEADERS_PIN names, else the default; review 018's R5), and the
  # musl headers the units compile against beyond c++/15.2.0: the package, and the top-level headers' digests
  printf '%s  headers pin %s\n' "$(sha256sum < "${CPPI_HEADERS_PIN:-$root/test/cpp/host/headers.sha256}" | cut -d' ' -f1)" "${CPPI_HEADERS_PIN:+(CPPI_HEADERS_PIN)}"
  printf '%s  musl-dev package\n' "$( (apk list -I musl-dev musl 2>&1 || true) | sha256sum | cut -d' ' -f1)"
  printf '%s  /usr/include/*.h\n' "$(sha256sum /usr/include/*.h | sha256sum | cut -d' ' -f1)"
  printf '%s  bin/cppi:rt_ir,rt_two,runtime_build\n' "$(declare -f rt_ir rt_two runtime_build | sha256sum | cut -d' ' -f1)"
  printf '%s  GCC_FLAGS\n' "$(printf '%s' "$GCC_FLAGS" | sha256sum | cut -d' ' -f1)"
  # ORS27: gcc builds the runtime's objects only when CPPI_LIVE is set; the records' key names no gcc (OUT/key.records, which a live
  # build writes too, so that a runtime built by the oracle tier serves the gate's records mode)
  if cpr_gcc; then printf '%s  gcc --version\n' "$(gcc --version | head -1 | sha256sum | cut -d' ' -f1)"
  else printf 'records  gcc: none (ORS27: the lowered C under gcc is the oracle tier'"'"'s)\n'; fi
  # the recorded clang line unless CPPI_LIVE (ORS12 (a): no clang in the records' mode; the host's when live, the same text when the host is the recorded one)
  if cpr_live; then printf '%s  clang --version\n' "$(clang --version | head -1 | sha256sum | cut -d' ' -f1)"
  else printf '%s  clang --version\n' "$(cpr_clang_line | sha256sum | cut -d' ' -f1)"; fi
  . "$root/bin/lib/host.bash"
  exe=$(arbace_host_exe)
  printf '%s  the tools'"'"' host\n' "$(sha256sum < "$exe" | cut -d' ' -f1)"
}

# ORS27: gcc's half of the lowering (gcc compiling the lowered C, its run, the runtime's archives) runs when CPPI_LIVE is set (the oracle tier)
# or CPPI_GCC=1 (the gate's lowering steps until cpp-check-essential covers test/cpp/essential-lower.txt, the user's condition); else the
# lowered C is read by repr/c and checked by ci's checker in its place
cpr_gcc() { cpr_live || [ -n "${CPPI_GCC:-}" ]; }
export -f cpr_gcc
rt_key_name() { if cpr_gcc; then echo key; else echo key.records; fi; } # the runtime's key file of the mode

runtime_key_check() { # runtime_key_check OUT: 0 when OUT's key is the checkout's, else 1 and the inputs that differ on stderr
  local out=$1 want kn; kn=$(rt_key_name)
  runtime_key > "$TMPDIR/cppi-key.$$"
  want=$(sha256sum < "$TMPDIR/cppi-key.$$" | cut -d' ' -f1)
  # live: the gcc archives too; from the records (ORS27) the lowered C alone, keyed by OUT/key.records
  if { ! cpr_gcc || [ -f "$out/liblstdc++.a" ]; } && [ -f "$out/$kn" ] && [ "$(cat "$out/$kn")" = "$want" ]; then rm -f "$TMPDIR/cppi-key.$$"; return 0; fi
  if [ ! -f "$out/$kn.txt" ]; then echo "  no key (built before keys, or not built, or built from the records and asked live): $out" >&2
  else diff "$out/$kn.txt" "$TMPDIR/cppi-key.$$" | sed -n 's/^> [0-9a-f]*  /  differs: /p' >&2 || true; fi
  rm -f "$TMPDIR/cppi-key.$$"; return 1
}

runtime_ir() { # runtime_ir: the units' IR into $rt/units (rt and jobs set): from the records, or by clang when CPPI_LIVE is set (ORS12 (a))
  local t
  cpr_prepare || exit 1
  # CP101 (c): the configured headers the IR is compiled against (the host's libstdc++ 15.2.0) at their pinned digests, so a
  # changed IR is named by its cause first (the pin is bin/repr-cpp host record's; CPPI_HEADERS_PIN names another)
  if cpr_live; then # the sources and the host's headers are the IR's inputs: needed only when the IR is made (ORS12 (a))
    local pin=${CPPI_HEADERS_PIN:-$root/test/cpp/host/headers.sha256}
    if ! ( cd / && sha256sum --quiet -c "$pin" ) > "$rt/headers.check" 2>&1; then
      echo "runtime-build: the configured headers differ from $pin (bin/repr-cpp host record after a look):" >&2
      head -20 "$rt/headers.check" >&2; exit 1
    fi
    t=$(tarball_check)
    mkdir -p "$root/.tmp/cppi/gcc"
    tar -xJf "$t" -C "$root/.tmp/cppi/gcc" gcc-15.2.0/libstdc++-v3/src gcc-15.2.0/libstdc++-v3/libsupc++ gcc-15.2.0/libstdc++-v3/config \
      gcc-15.2.0/libiberty/cp-demangle.c gcc-15.2.0/libiberty/cp-demangle.h gcc-15.2.0/include/demangle.h gcc-15.2.0/include/libiberty.h \
      gcc-15.2.0/include/ansidecl.h gcc-15.2.0/libgcc/unwind-pe.h
    # the build's generated files (test/cpp/runtime/units.edn, :generated)
    mkdir -p "$rt/gen/bits"
    : > "$rt/gen/bits/largefile-config.h"
    { echo 'static const char tzdata_chars[] = R"__libstdcxx__('; cat "$gcc_root/libstdc++-v3/src/c++20/tzdata.zi"; echo ')__libstdcxx__";'; } > "$rt/gen/tzdata.zi.h"
  fi
  GOMEMLIMIT=1GiB arbace_tool -e "(let [u (read-string (slurp \"$root/test/cpp/runtime/units.edn\"))]
    (spit \"$rt/units.tsv\" (apply str (for [r (:units u)] (str (apply str (interpose \"\t\" r)) \"\n\"))))
    (spit \"$rt/shims.txt\" (apply str (for [[k v] (:shims u)] (str k \"\n\" v \"\n\")))))"
  tr '\t\n' '\037\0' < "$rt/units.tsv" | xargs -0 -P "$jobs" -I{} nice bash -c 'IFS=$'"'"'\037'"'"' read -r u s a f <<< "$1"; rt_ir "$u" "$s" "$a" "$f"' _ {}
}

runtime_build() {
  rt=$root/.tmp/cppi/runtime; local update="" jobs=${CPPI_JOBS:-4} t
  while [ $# -gt 0 ]; do case $1 in --update) update=1; shift ;; --jobs) jobs=$2; shift 2 ;; -*) echo "runtime-build: unknown option $1" >&2; exit 2 ;; *) rt=$1; shift ;; esac; done
  mkdir -p "$rt"; rt=$(cd "$rt" && pwd); export rt
  rm -f "$rt/key" "$rt/key.txt" "$rt/key.start" "$rt/key.records" "$rt/key.records.txt" "$rt/key.records.start"
  # the key of what the build starts from (review 018's R5): an edit during the build's minutes gives a runtime that is stale at
  # the end, not one keyed to the edit and built from the old file; a live build also the records' key (ORS27: it serves both)
  if cpr_gcc; then runtime_key > "$rt/key.start"; fi
  ( unset CPPI_LIVE CPPI_GCC; runtime_key ) > "$rt/key.records.start"
  disk_ok
  local t0 t1 t2 t3
  t0=$(date +%s)
  runtime_ir
  cut -f1 "$rt/units.tsv" | while read -r u; do
    if [ -f "$rt/units/$u/x.ll" ]; then printf '%s  %s\n' "$(sha256sum < "$rt/units/$u/x.ll" | cut -d' ' -f1)" "$u"; fi
  done > "$rt/ir.sha256"
  if [ -n "$update" ]; then
    cp "$rt/ir.sha256" "$root/test/cpp/runtime/ir.sha256"
  elif ! cmp -s "$rt/ir.sha256" "$root/test/cpp/runtime/ir.sha256"; then
    echo "runtime-build: the IR differs from test/cpp/runtime/ir.sha256 (the oracle or the headers changed: --update after a look)" >&2
    diff "$root/test/cpp/runtime/ir.sha256" "$rt/ir.sha256" | head -20 >&2; exit 1
  fi
  t1=$(date +%s)
  disk_ok
  cut -f1 "$rt/units.tsv" | while read -r u; do
    if [ -f "$rt/units/$u/x.ll" ]; then printf '%s\t%s\t%s\n' "$u" "$rt/units/$u/x.ll" "$rt/units/$u"; fi
  done > "$rt/lower.tsv"
  CPPI_THREADS=$jobs arbace_tool -m arbace.cpp.lower lower-list "$rt/lower.tsv"
  t2=$(date +%s)
  disk_ok
  cut -f1 "$rt/units.tsv" | tr '\n' '\0' | xargs -0 -P "$jobs" -I{} nice bash -c 'rt_two "$1"' _ {}
  arbace_tool -m arbace.cpp.lower lower-rt "$root/arbace/cpp/rt/eh.c.ae" "$rt/rt.c"
  rm -f "$rt/liblstdc++.a" "$rt/liblstdc++exp.a" "$rt/rt.o"
  if cpr_gcc; then # ORS27: the archives the lowered programs link under gcc
    # shellcheck disable=SC2086
    gcc $GCC_FLAGS -c "$rt/rt.c" -o "$rt/rt.o"
    cut -f1 "$rt/units.tsv" | grep -v '^exp/' | while read -r u; do if [ -f "$rt/units/$u/lowered.o" ]; then echo "$rt/units/$u/lowered.o"; fi; done | xargs ar rcs "$rt/liblstdc++.a"
    cut -f1 "$rt/units.tsv" | grep '^exp/' | while read -r u; do if [ -f "$rt/units/$u/lowered.o" ]; then echo "$rt/units/$u/lowered.o"; fi; done | xargs ar rcs "$rt/liblstdc++exp.a"
  fi
  t3=$(date +%s)
  echo "runtime-build: IR $((t1-t0)) s, read, print and lower $((t2-t1)) s, $(cpr_gcc && echo gcc || echo "judged, no gcc (ORS27)") $((t3-t2)) s" | tee "$rt/times.txt"
  arbace_tool -m arbace.cpp.check runtime-judge "$rt"
  # every unit passed (runtime-judge exits 1 otherwise): the key of what it was built from
  if [ -f "$rt/key.start" ]; then mv "$rt/key.start" "$rt/key.txt"; sha256sum < "$rt/key.txt" | cut -d' ' -f1 > "$rt/key"; fi
  mv "$rt/key.records.start" "$rt/key.records.txt"; sha256sum < "$rt/key.records.txt" | cut -d' ' -f1 > "$rt/key.records"
}

disk_ok() { # the light tier's disk rule: stop past 80% (CPPI_DISK_MAX)
  local u; u=$(df --output=pcent "$root" | tail -1 | tr -dc 0-9)
  [ "$u" -le "${CPPI_DISK_MAX:-80}" ] || { echo "lower-check: the disk is at $u%, stopping" >&2; exit 3; }
}

runtime_ci() { # runtime_ci [OUT]: OUT/ci, the lowered runtime's units read by repr/c as ci's library (CX8; arbace.cpp.run's
  # read-lib), made again when its key (OUT's key, the reader's sources and opts: arbace/cpp/run.ae, repr/c, test/c/host)
  # changed; runtime-build first when OUT is not at the checkout's key. Prints OUT/ci.
  local out=${1:-${CPPI_RUNTIME:-$root/.tmp/cppi/runtime}} k u
  if ! runtime_key_check "$out" 2>"$TMPDIR/cppi-rtkey.log" || [ ! -f "$out/rt.c" ] \
     || cut -f1 "$out/units.tsv" | while read -r u; do [ -f "$out/units/$u/lowered.c" ] || echo missing; done | grep -q missing; then
    echo "runtime-ci: the runtime in $out is not at the checkout's key (or has no lowered C): runtime-build" >&2
    ( runtime_build "$out" ) >&2 || exit 1
  fi
  out=$(cd "$out" && pwd)
  # the reader's key (its sources and options) apart from the runtime's: a unit read by the same reader from the same lowered C is
  # read again to the same forms (cppi-deferred)
  rk=$( (cd "$root" && sed -n '/^;; runtime-ci-key begin/,/^;; runtime-ci-key end/p' arbace/cpp/run.ae | sha256sum
         find arbace/repr/c.ae arbace/repr/c arbace/c/musl.ae test/c/host test/cpp/runtime/ci -type f | LC_ALL=C sort | xargs sha256sum) | sha256sum | cut -d' ' -f1)
  k=$( { cat "$out/key.records"; (cd "$root" && sed -n '/^;; runtime-ci-key begin/,/^;; runtime-ci-key end/p' arbace/cpp/run.ae | sha256sum
                                 find arbace/repr/c.ae arbace/repr/c arbace/c/musl.ae test/c/host test/cpp/runtime/ci -type f | LC_ALL=C sort | xargs sha256sum); } | sha256sum | cut -d' ' -f1)
  if [ "$(cat "$out/ci/key" 2>"$TMPDIR/cppi-cikey.err")" != "$k" ]; then
    { cut -f1 "$out/units.tsv" | while read -r u; do printf '%s\t%s\n' "$u" "$out/units/$u/lowered.c"; done; printf 'cx-rt\t%s\n' "$out/rt.c"; } > "$TMPDIR/cppi-ci-list.$$"
    cut -f2 "$TMPDIR/cppi-ci-list.$$" | xargs sha256sum | awk '{ print $1 }' | paste "$TMPDIR/cppi-ci-list.$$" - | cut -f1,3 > "$TMPDIR/cppi-ci-sums.$$"
    if [ "$(cat "$out/ci/reader-key" 2>"$TMPDIR/cppi-cikey.err")" = "$rk" ] && [ -f "$out/ci/units.sha256" ] && [ -f "$out/ci/read.tsv" ]; then
      # the same reader: only the units whose lowered C changed are read again (read-lib keeps the rows read.tsv says are read;
      # the index is made again from every unit), seconds after a lowering change that touches a few units, not the whole read
      awk -F'\t' 'NR == FNR { old[$1] = $2; next } old[$1] != $2 { print $1 }' "$out/ci/units.sha256" "$TMPDIR/cppi-ci-sums.$$" > "$TMPDIR/cppi-ci-changed.$$"
      awk -F'\t' 'NR == FNR { ch[$1] = 1; next } !($1 in ch)' "$TMPDIR/cppi-ci-changed.$$" "$out/ci/read.tsv" > "$out/ci/read.tsv.new"
      mv "$out/ci/read.tsv.new" "$out/ci/read.tsv"; rm -f "$out/ci/key"
      echo "runtime-ci: reading $(wc -l < "$TMPDIR/cppi-ci-changed.$$") changed units of the lowered runtime into $out/ci" >&2
    else
      rm -rf "$out/ci"; mkdir -p "$out/ci"
      echo "runtime-ci: reading the lowered runtime into $out/ci (about 3 minutes)" >&2
    fi
    mv "$TMPDIR/cppi-ci-list.$$" "$out/ci/list.tsv"; rm -f "$TMPDIR/cppi-ci-changed.$$"
    (cd "$root" && GOMEMLIMIT=${CPPI_CI_MEMLIMIT:-6GiB} arbace_tool -m arbace.cpp.run read-lib "$out/ci" "$out/ci/list.tsv" "${CPPI_JOBS:-4}") > "$out/ci/read.log" 2>&1 \
      || { grep -v -E 'Reflection|recur arg|Auto-boxing' "$out/ci/read.log" | tail -5 >&2; exit 1; }
    # ci's overrides (test/cpp/runtime/ci/*.c, arbace.cpp.run's libs-fn links them before the runtime): C for ci of what the
    # lowered runtime does in a way ci cannot (clang's inline va_arg)
    mkdir -p "$out/ci/over"
    for f in "$root"/test/cpp/runtime/ci/*.c; do printf '%s	%s
' "ci/$(basename "$f" .c)" "$f"; done > "$out/ci/over/list.tsv"
    (cd "$root" && GOMEMLIMIT=${CPPI_CI_MEMLIMIT:-6GiB} arbace_tool -m arbace.cpp.run read-lib "$out/ci/over" "$out/ci/over/list.tsv" 1) > "$out/ci/over/read.log" 2>&1 \
      || { grep -v -E 'Reflection|recur arg|Auto-boxing' "$out/ci/over/read.log" | tail -5 >&2; exit 1; }
    mv "$TMPDIR/cppi-ci-sums.$$" "$out/ci/units.sha256"; echo "$rk" > "$out/ci/reader-key"
    echo "$k" > "$out/ci/key"
  fi
  echo "$out/ci"
}

lower_check() {
  local list=$1; work=$2; shift 2
  local jobs=${CPPI_JOBS:-4} rtdir=$root/.tmp/cppi/runtime recorded=auto
  while [ $# -gt 0 ]; do case $1 in --jobs) jobs=$2; shift 2 ;; --runtime) rtdir=$2; shift 2 ;; --recorded) recorded=$2; shift 2 ;; *) echo "lower-check: unknown option $1" >&2; exit 2 ;; esac; done
  # an empty list is a list maker's failure (bin/cppi list libstdcxx > L without the testsuite), not a check that passes
  # one grep: `grep -v | grep -q` under pipefail failed when grep -q's early exit killed the first grep (SIGPIPE), refusing a long list
  grep -q -v -e '^#' -e '^$' "$list" || { echo "lower-check: $list has no file" >&2; exit 2; }
  # the runtime is used only at the checkout's key (review 007's finding 1): rebuilt, or refused (CPPI_RUNTIME_STALE=refuse)
  if ! runtime_key_check "$rtdir"; then
    if [ "${CPPI_RUNTIME_STALE:-rebuild}" = refuse ]; then
      echo "lower-check: the runtime in $rtdir is not at the checkout's key (bin/cppi runtime-build $rtdir)" >&2; exit 4
    fi
    echo "lower-check: the runtime in $rtdir is not at the checkout's key: runtime-build" >&2
    ( runtime_build "$rtdir" --jobs "$jobs" )
    runtime_key_check "$rtdir" || { echo "lower-check: the runtime in $rtdir is still not at the checkout's key" >&2; exit 4; }
  fi
  rtdir=$(cd "$rtdir" && pwd)
  mkdir -p "$work"; work=$(cd "$work" && pwd); export work
  grep -v '^#' "$list" > "$work/list.tsv" || true
  rm -f "$work/list.key"; sed -n 's/^#list //p' "$list" | head -1 > "$work/list.key"
  disk_ok
  # the testsuite's own library (testsuite_hooks.cc and the others of util/), native as libstdc++ is: compiled by g++ once
  # the lowered programs link the lowered runtime (runtime-build) and, for the testsuite, util/ lowered with them: no native
  # libstdc++
  LIBS="-lstdc++ -lm -latomic"
  LOW_LIBS="$rtdir/rt.o -Wl,--start-group $rtdir/liblstdc++.a -Wl,--end-group -lm -latomic"
  local util=""
  if [ -d "$ts_root/util" ] && grep -q "$ts_root" "$work/list.tsv"; then
    util="testsuite_abi testsuite_allocator testsuite_character testsuite_hooks"
    rm -rf "$work/libtestc++" "$work/util"; mkdir -p "$work/libtestc++"
    for f in $util; do
      mkdir -p "$work/util/$f"
      # ORS26 (b): the util library's IR from the records (cpp-ir-libstdcxx's libstdcxx/util/NAME.cc, bin/cppi record-ir --corpus libstdcxx),
      # g++'s objects of it (the original's and g++'s link) only when CPPI_LIVE is set
      if cpr_live; then
        g++ -std=gnu++17 -O0 -I"$ts_root/util" -c "$ts_root/util/$f.cc" -o "$work/libtestc++/$f.o"
        clang++ -std=gnu++17 -O0 -S -emit-llvm -I"$ts_root/util" "$ts_root/util/$f.cc" -o "$work/util/$f/x.ll"
      else cpr_ir_get "libstdcxx/util/$f.cc" gnu++17 "-I$ts_root/util" "$ts_root/util/$f.cc" "$work/util/$f" && [ "$(cat "$work/util/$f/ir.status")" = 0 ] \
             || { echo "lower-check: the util library's IR is not recorded (bin/cppi record-ir --corpus libstdcxx, by hand)" >&2; exit 1; }
      fi
    done
    if cpr_live; then ar rcs "$work/libtestc++.a" "$work"/libtestc++/*.o; fi
    LIBS="$work/libtestc++.a -lstdc++exp -lstdc++ -lm -latomic"
    LOW_LIBS="$rtdir/rt.o -Wl,--start-group $work/libltestc++.a $rtdir/liblstdc++exp.a $rtdir/liblstdc++.a -Wl,--end-group -lm -latomic"
  fi
  export LIBS LOW_LIBS
  cpr_prepare || exit 1
  local t0 t1 t2 t3
  t0=$(date +%s)
  tr '\t\n' '\037\0' < "$work/list.tsv" | xargs -0 -P "$jobs" -I{} nice bash -c 'IFS=$'"'"'\037'"'"' read -r n s a p <<< "$1"; one "$n" "$s" "$a" "$p"' _ {}
  t1=$(date +%s)
  disk_ok
  cut -f1 "$work/list.tsv" | while read -r n; do
    if [ -f "$work/files/$n/x.ll" ]; then printf '%s\t%s\t%s\n' "$n" "$work/files/$n/x.ll" "$work/files/$n"; fi
  done > "$work/lower.tsv"
  for f in $util; do printf '%s\t%s\t%s\n' "util/$f.cc" "$work/util/$f/x.ll" "$work/util/$f"; done >> "$work/lower.tsv"
  CPPI_THREADS=$jobs arbace_tool -m arbace.cpp.lower lower-list "$work/lower.tsv"
  if [ -n "$util" ] && cpr_gcc; then
    for f in $util; do
      # shellcheck disable=SC2086
      ( cd "$work/util/$f" && gcc $GCC_FLAGS -c lowered.c -o lowered.o ) 2>&1 | cap "$work/util/$f/gcc.log"
      rm -f "$work/util/$f/forms.ae" "$work/util/$f/print.ll" "$work/util/$f/lowered.c.ae"
    done
    rm -f "$work/libltestc++.a"
    ar rcs "$work/libltestc++.a" "$work"/util/*/lowered.o
  fi
  t2=$(date +%s)
  disk_ok
  cut -f1 "$work/list.tsv" | tr '\n' '\0' | xargs -0 -P "$jobs" -I{} nice bash -c 'two "$1"' _ {}
  # ORS27: from the records the lowered C is read by repr/c and checked by ci's checker (arbace.cpp.run check-c: FILES/NAME/ci-check.status),
  # the level gcc's compile was; gcc and the run are cpp-lower-oracle's
  if ! cpr_gcc; then
    cut -f1 "$work/list.tsv" | while read -r n; do if [ -f "$work/files/$n/lowered.c" ]; then printf '%s\t%s\n' "$n" "$work/files/$n"; fi; done > "$work/check-c.tsv"
    (cd "$root" && GOMEMLIMIT=${CPPI_CI_MEMLIMIT:-2GiB} arbace_tool -m arbace.cpp.run check-c "$work/check-c.tsv" "${CPPI_THREADS:-2}") > "$work/check-c.log" 2>&1 \
      || { grep -v -E 'Reflection|recur arg|Auto-boxing' "$work/check-c.log" | tail -5 >&2; exit 1; }
  fi
  t3=$(date +%s)
  echo "lower-check: native $((t1-t0)) s, read, print and lower $((t2-t1)) s, $(cpr_gcc && echo "gcc and runs" || echo "repr/c and ci's checker") $((t3-t2)) s" | tee "$work/times.txt"
  arbace_tool -m arbace.cpp.check judge "$work" "$root/test/cpp/lower-known.edn" "$root/test/cpp/lower-results.edn" "$recorded"
}

cg_runtime() { # the runtime a codegen check links: DIR's archives (runtime-build makes them; not rebuilt here)
  local d=$1
  [ -f "$d/liblstdc++.a" ] && [ -f "$d/rt.o" ] || { echo "codegen: no runtime in $d (bin/cppi runtime-build $d, or --runtime DIR)" >&2; exit 4; }
  (cd "$d" && pwd)
}

cg_run() { # cg_run DIR KIND: KIND.c compiled by gcc with the lowered runtime and run (KIND.out, KIND.status)
  local d=$1 k=$2
  [ -f "$d/$k.c" ] || return 0
  # shellcheck disable=SC2086
  ( cd "$d" && timeout 300 gcc $GCC_FLAGS $k.c -o $k.exe $CG_LIBS; echo $? > $k-build.status ) 2>&1 | cap "$d/$k-build.log"
  if [ "$(cat "$d/$k-build.status")" = 0 ]; then
    ( cd "$d" && ulimit -f 1024 && timeout "${CPPI_RUN_TIMEOUT:-60}" ./$k.exe 2> $k.err | cap $k.out; echo "${PIPESTATUS[0]}" > $k.status )
  fi
  rm -f "$d/$k.exe"
}

cg_native() { # cg_native DIR: the code generator's IR built by clang++ (LLVM's verifier, the native libraries) and run
  local d=$1
  [ -f "$d/gen.ll" ] || return 0
  ( cd "$d" && timeout 300 clang++ gen.ll -o nat.exe -lm; echo $? > nat-build.status ) 2>&1 | cap "$d/nat-build.log"
  if [ "$(cat "$d/nat-build.status")" = 0 ]; then
    ( cd "$d" && ulimit -f 1024 && timeout "${CPPI_RUN_TIMEOUT:-60}" ./nat.exe 2> nat.err | cap nat.out; echo "${PIPESTATUS[0]}" > nat.status )
  fi
  rm -f "$d/nat.exe"
}
export -f cg_run cg_native

codegen_one() {
  local f=$1 out=$2 rtdir=$root/.tmp/cppi/runtime
  shift 2
  while [ $# -gt 0 ]; do case $1 in --runtime) rtdir=$2; shift 2 ;; *) echo "codegen: unknown option $1" >&2; exit 2 ;; esac; done
  rtdir=$(cg_runtime "$rtdir")
  mkdir -p "$out"; out=$(cd "$out" && pwd); f=$(cd "$(dirname "$f")" && pwd)/$(basename "$f")
  rm -f "$out"/gen.*
  . "$root/bin/lib/repr-cpp/sysroot.bash"; cpp_sysroot || exit 1  # CP241 (b): libstdc++ from the tree made without g++
  arbace_tool -m arbace.cpp.codegen gen "$f" "$out" || exit $?
  CG_LIBS="$rtdir/rt.o -Wl,--start-group $rtdir/liblstdc++.a -Wl,--end-group -lm -latomic"; export CG_LIBS
  cg_run "$out" gen
  [ -f "$out/gen.status" ] || { echo "codegen: gcc failed on $out/gen.c (gen-build.log)" >&2; exit 1; }
  cat "$out/gen.out"; echo "codegen: status $(cat "$out/gen.status")" >&2
}

codegen_check() {
  local list="" work rtdir=$root/.tmp/cppi/runtime jobs=${CPPI_JOBS:-4}
  if [ $# -ge 2 ] && [ "${2#--}" = "$2" ]; then list=$1; shift; fi
  work=$1; shift
  while [ $# -gt 0 ]; do case $1 in --runtime) rtdir=$2; shift 2 ;; --jobs) jobs=$2; shift 2 ;; *) echo "codegen-check: unknown option $1" >&2; exit 2 ;; esac; done
  rtdir=$(cg_runtime "$rtdir")
  mkdir -p "$work"; work=$(cd "$work" && pwd)
  if [ -n "$list" ]; then grep -v '^#' "$list" | cut -f1,2 > "$work/list.tsv"
  else for f in "$root"/test/cpp/codegen/*.cpp; do printf '%s\t%s\n' "$(basename "$f" .cpp)" "$f"; done > "$work/list.tsv"; fi
  grep -q . "$work/list.tsv" || { echo "codegen-check: no sample" >&2; exit 2; }
  rm -rf "$work/files"; mkdir -p "$work/files"
  CG_LIBS="$rtdir/rt.o -Wl,--start-group $rtdir/liblstdc++.a -Wl,--end-group -lm -latomic"; export CG_LIBS
  local t0 t1 t2; t0=$(date +%s)
  # clang's IR, the reference
  while IFS=$'\t' read -r n p; do
    mkdir -p "$work/files/$n"
    ( cd "$work/files/$n" && timeout 300 clang++ -x c++ -std=c++23 -O0 -S -emit-llvm "$p" -o x.ll ) 2>&1 | cap "$work/files/$n/ir.log"
  done < "$work/list.tsv"
  while IFS=$'\t' read -r n p; do printf '%s\t%s\t%s\n' "$n" "$p" "$work/files/$n"; done < "$work/list.tsv" > "$work/gen.tsv"
  . "$root/bin/lib/repr-cpp/sysroot.bash"; cpp_sysroot || exit 1
  arbace_tool -m arbace.cpp.codegen gen-list "$work/gen.tsv"
  t1=$(date +%s)
  cut -f1 "$work/list.tsv" | tr '\n' '\0' | xargs -0 -P "$jobs" -I{} nice bash -c 'd='"$work"'/files/$1; cg_run "$d" ref; cg_run "$d" gen; cg_native "$d"' _ {}
  t2=$(date +%s)
  echo "codegen-check: generate and lower $((t1-t0)) s, gcc, clang and runs $((t2-t1)) s" | tee "$work/times.txt"
  arbace_tool -m arbace.cpp.codegen judge "$work" "$root/test/cpp/codegen/known.edn"
}

record_ir() { # record-ir [--corpus C,...] [--every N[,M...]] [--runtime] [--verify [--sample N]]: ORS12 (a), by hand on a host with clang++ and g++ (ORS5 (a))
  # --every N,M: of each corpus's list (bin/lib/cppi/lists.bash's run_list) the programs a sampling every Nth or every Mth holds (the
  # selection of bin/cppi check --sample N and of bin/cppi list libstdcxx --sample N: the list's 1st, N+1th, ...), ORS26 (b)'s samplings
  local corpora=samples,runtime rtonly= verify= sample= every= jobs=${CPPI_JOBS:-4} c st pack
  while [ $# -gt 0 ]; do case $1 in
    --corpus) corpora=$2; shift 2 ;; --runtime) rtonly=1; shift ;; --verify) verify=1; shift ;; --sample) sample=$2; shift 2 ;;
    --every) every=$2; shift 2 ;;
    --jobs) jobs=$2; shift 2 ;; *) echo "record-ir: unknown option $1" >&2; exit 2 ;; esac; done
  command -v clang++ > "$TMPDIR/cppi-rec.err" && command -v g++ > "$TMPDIR/cppi-rec.err" || { echo "record-ir: needs clang++ and g++ (the host :cxx)" >&2; exit 2; }
  export CPPI_LIVE=1
  st=$root/.tmp/cppi/record-ir; rm -rf "$st"; mkdir -p "$st"
  local cmd="bin/cppi record-ir${rtonly:+ --runtime}${rtonly:- --corpus $corpora}${every:+ --every $every}"
  if [ -n "$rtonly" ]; then
    rt=$st/rt; mkdir -p "$rt"; rt=$(cd "$rt" && pwd); export rt jobs
    runtime_ir
    pack=cpp-runtime-ir; mkdir -p "$st/$pack"; : > "$st/ids.tsv"
    while IFS= read -r line; do
      u=$(printf '%s' "$line" | cut -f1); src=$(printf '%s' "$line" | cut -f2); std=$(printf '%s' "$line" | cut -f3); fl=$(printf '%s' "$line" | cut -f4)
      [ -f "$rt/units/$u/x.ll" ] || { echo "record-ir: $u has no IR (ir.status $(cat "$rt/units/$u/ir.status" 2>"$TMPDIR/cppi-rec.err"))" >&2; continue; }
      local shim; shim=$(grep -F -x -A1 "$src" "$rt/shims.txt" | sed -n 2p || true)
      local key; key=$(rt_key "$u" "$src" "$std" "$fl" "$shim")
      mkdir -p "$st/$pack/$u"
      for f in x.ll ir.status ir.log obj.log; do [ -f "$rt/units/$u/$f" ] && cp "$rt/units/$u/$f" "$st/$pack/$u/$f"; done
      [ -f "$rt/units/$u/x.o" ] && sha256sum < "$rt/units/$u/x.o" | cut -c1-64 > "$st/$pack/$u/x.o.sha256"
      for f in "$st/$pack/$u"/*; do printf '%s/%s\t%s\n' "$u" "$(basename "$f")" "$key"; done >> "$st/ids.tsv"
    done < "$rt/units.tsv"
    if [ -n "$verify" ]; then verify_ir_pack "$root/test/cpp/records/$pack.sha256" "$st/$pack" "$st/ids.tsv" "$sample"; return; fi
    oracle_make "$root/test/cpp/records/$pack.sha256" "$st" "$st/ids.tsv" "$cmd" cxx; return
  fi
  work=$st/work; mkdir -p "$work/files"; export work
  : > "$st/list.tsv"
  for c in ${corpora//,/ }; do
    run_list "$c" > "$st/all-$c.tsv" || exit 1
    awk -v ev="$every" 'BEGIN { n = split(ev, e, ",") } { k = (n == 0); for (i = 1; i <= n; i++) if ((NR - 1) % e[i] == 0) k = 1; if (k) print }' "$st/all-$c.tsv" > "$st/list-$c.tsv"
    # the libraries the corpus's programs link natively (the original's link and g++'s: libstdcxx's util/ library by g++)
    LIBS=$(cppi_native_libs "$c" "$work") || { echo "record-ir: $c's native libraries" >&2; exit 1; }; export LIBS
    tr '\t\n' '\037\0' < "$st/list-$c.tsv" | xargs -0 -P "$jobs" -I{} nice bash -c 'IFS=$'"'"'\037'"'"' read -r n s a p <<< "$1"; one "$n" "$s" "$a" "$p"' _ {}
    cat "$st/list-$c.tsv" >> "$st/list.tsv"
    if [ "$c" = libstdcxx ]; then # ORS26 (b): the util library's IR, which the lowering and the run check lower as the corpus's own library
      for f in testsuite_abi testsuite_allocator testsuite_character testsuite_hooks; do
        local ud=$work/files/libstdcxx/util/$f.cc; rm -rf "$ud"; mkdir -p "$ud"
        ( cd "$ud" && timeout 300 clang++ -std=gnu++17 -O0 -S -emit-llvm -I"$cppi_ts/util" "$cppi_ts/util/$f.cc" -o x.ll; echo $? > ir.status ) 2>&1 | cap "$ud/ir.log"
        printf 'libstdcxx/util/%s.cc\tgnu++17\t%s\t%s\n' "$f" "-I$cppi_ts/util" "$cppi_ts/util/$f.cc" >> "$st/list.tsv"
      done
    fi
  done
  # what is kept of each program: the members of the header comment of test/oracle-records/cpp.bash
  local pk id std args p key d f
  for pack in cpp-ir-samples cpp-ir-libstdcxx cpp-ir-gxx-dg-run; do
    mkdir -p "$st/$pack"; : > "$st/ids-$pack.tsv"
    while IFS= read -r line; do
      id=$(printf '%s' "$line" | cut -f1); std=$(printf '%s' "$line" | cut -f2); args=$(printf '%s' "$line" | cut -f3); p=$(printf '%s' "$line" | cut -f4)
      [ "$(basename "$(cpr_pin "$id")" .sha256)" = "$pack" ] || continue
      d=$work/files/$id
      [ -f "$d/x.o" ] && { sha256sum < "$d/x.o" | cut -c1-64 > "$d/x.o.sha256"; rm -f "$d/x.o"; }
      key=$(cpr_key "$id" "$std" "$args" "$p")
      mkdir -p "$st/$pack/$id"
      for f in "$d"/*; do
        case $(basename "$f") in
          *.secs) continue ;;
          # the linkers' messages name the drivers' temporary objects (g++'s ccXXXXXX.o, clang's NAME-XXXXXX.o, random): the record and its verify
          # keep them as such
          *-link.log) sed 's#/cc[A-Za-z0-9]\{6\}\.o#/ccXXXXXX.o#g; s#/\([^/ :]*\)-[0-9a-f]\{6\}\.o#/\1-XXXXXX.o#g' "$f" > "$st/$pack/$id/$(basename "$f")" ;;
          *) cp "$f" "$st/$pack/$id/" ;;
        esac
        printf '%s/%s\t%s\n' "$id" "$(basename "$f")" "$key" >> "$st/ids-$pack.tsv"
      done
    done < "$st/list.tsv"
    [ -s "$st/ids-$pack.tsv" ] || { rm -rf "${st:?}/$pack"; continue; }
    if [ -n "$verify" ]; then verify_ir_pack "$root/test/cpp/records/$pack.sha256" "$st/$pack" "$st/ids-$pack.tsv" "$sample"
    else oracle_make "$root/test/cpp/records/$pack.sha256" "$st" "$st/ids-$pack.tsv" "$cmd" cxx; fi
  done
}

verify_ir_pack() { # PIN DIR IDS SAMPLE: the live run's members against the pack's, entries by ID (the program or unit), toolchain moved reported (ORS6 (a))
  local pin=$1 d=$2 ids=$3 sample=$4 id n=0 bad=0 all f got want k
  all=$(cut -f1 "$ids" | sed 's|/[^/]*$||' | LC_ALL=C sort -u)
  [ -z "$sample" ] || all=$(echo "$all" | awk -v n="$sample" 'NR % n == 1')
  for id in $all; do
    n=$((n+1)); k=0
    for f in "$d/$id"/*; do
      want=$(oracle_get "$pin" "$id/$(basename "$f")" 2>"$TMPDIR/cppi-ver.err") || { k=1; continue; }
      cmp -s "$f" "$want" || k=1
    done
    bad=$((bad+k))
  done
  # ORS7 (a), the crossed pair: the first two entries with IR, the first's live x.ll against the second's record: must differ
  local ab; ab=$(for id in $all; do [ -f "$d/$id/x.ll" ] && echo "$id"; done | head -2 | tr '\n' ' ')
  set -- $ab
  if [ $# = 2 ]; then
    want=$(oracle_get "$pin" "$2/x.ll" 2>"$TMPDIR/cppi-ver.err") || want=
    if [ -n "$want" ] && cmp -s "$d/$1/x.ll" "$want"; then echo "verify: FAILED: the crossed pair ($1 live, $2 recorded) is equal: the verify is blind"; return 1; fi
    echo "verify: the crossed pair ($1 live against $2's record) differs, as a control must"
  fi
  oracle_verdict cxx "$(oracle_manifest "$pin")" "$bad" "$n"
}

case ${1:-} in
  record-ir) shift; record_ir "$@" ;;
  lower) shift; arbace_tool -m arbace.cpp.lower lower "$@" ;;
  runtime) arbace_tool -m arbace.cpp.lower lower-rt "$root/arbace/cpp/rt/eh.c.ae" "$2" ;;
  runtime-build) shift; runtime_build "$@" ;;
  runtime-key) if [ "${2:-}" = --print ]; then runtime_key; exit 0; fi
               out=${2:-$root/.tmp/cppi/runtime}; if runtime_key_check "$out"; then echo current; else echo stale; exit 1; fi ;;
  selftest) shift; exec "$root/test/cpp/selftest/run" "$@" ;;
  testsuite) testsuite ;;
  list) case ${2:-} in
          samples) list_samples ;;
          runtime) list_runtime ;;
          samples+runtime) echo "#list samples"; list_samples body; list_runtime body ;;
          essential) list_essential ;;
          libstdcxx) n=15; [ "${3:-}" = --sample ] && n=$4; list_libstdcxx "$n" ;;
          *) echo "list: samples, runtime, samples+runtime, essential or libstdcxx" >&2; exit 2 ;;
        esac ;;
  lower-check) shift; lower_check "$@" ;;
  codegen) shift; codegen_one "$@" ;;
  codegen-check) shift; codegen_check "$@" ;;
  runtime-ci) shift; runtime_ci "$@" ;;
  record-ref) shift; exec "$root/bin/lib/cppi/record-ref" "$@" ;;
  check) shift
    for a in "$@"; do [ "$a" = --aot ] && { args=(); for b in "$@"; do [ "$b" = --aot ] || args+=("$b"); done; exec "$root/bin/lib/cppi/check-aot" "${args[@]}"; }; done
    exec "$root/bin/lib/cppi/check" "$@" ;;
  divergences) shift; lvl=eval; n=; [ "${1:-}" = --aot ] && { lvl=aot; shift; }; [ "${1:-}" = --sample ] && n=${2:?--sample N}
                arbace_tool -m arbace.cpp.check divergences "$lvl" $n ;;
  run) shift; exec "$root/bin/lib/cppi/run" "$@" ;;
  lower-corpus) shift; k=${1:?lower-corpus KEY [WORK] [--only-list FILE]: samples or libstdcxx-every-15th}; shift; w=$root/.tmp/cppi/lower-$k
                case ${1:-} in ""|--*) ;; *) w=$1; shift ;; esac
                # GT9 --only-list FILE (the gate's rotation): the names FILE lists, one a line, as test/cpp/lower-results.edn names them
                only_list=""; rest=()
                while [ $# -gt 0 ]; do
                  case $1 in
                    --only-list) [ -f "${2:-}" ] || { echo "lower-corpus: no list ${2:-}" >&2; exit 2; }; only_list=$2; shift 2 ;;
                    *) rest+=("$1"); shift ;;
                  esac
                done
                set -- "${rest[@]+"${rest[@]}"}"
                case $k in
                  samples) { echo "#list samples"; list_samples body; list_runtime body; } > "$TMPDIR/cppi-$k.list" ;;
                  libstdcxx-every-15th) [ -d "$ts_root" ] || testsuite; list_libstdcxx 15 > "$TMPDIR/cppi-$k.list" ;;
                  *) echo "lower-corpus: samples or libstdcxx-every-15th, the recorded lists of test/cpp/lower-results.edn" >&2; exit 2 ;;
                esac
                if [ -n "$only_list" ]; then
                  # a partial run: the key's list cut to the names (the header kept, so the list is of its key), held to the record's :files
                  # by name (a recorded :pass that does not pass fails) but not to the whole list (--recorded none: no count, no missing names)
                  awk -F'\t' 'NR == FNR { want[$0] = 1; next } /^#/ || ($1 in want)' "$only_list" "$TMPDIR/cppi-$k.list" > "$TMPDIR/cppi-$k.only"
                  grep -q -v -e '^#' -e '^$' "$TMPDIR/cppi-$k.only" || { echo "lower-corpus: $only_list names no file of $k" >&2; exit 2; }
                  lower_check "$TMPDIR/cppi-$k.only" "$w" --recorded none "$@"; exit $?
                fi
                lower_check "$TMPDIR/cppi-$k.list" "$w" --recorded "$k" "$@" ;;
  lower-essential) shift; w=${1:-$root/.tmp/cppi/essential}; [ $# -gt 0 ] && shift
                   list_essential > "$TMPDIR/cppi-essential.list"; lower_check "$TMPDIR/cppi-essential.list" "$w" "$@" ;;
  *) sed -n '2,/^set -e/p' "$0" | sed '$d;s/^# \{0,1\}//' >&2; exit 2 ;;
esac

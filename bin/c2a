#!/bin/bash
# c2a, the Clojure -> Arbace translator (doc/C2A.md), run on Arbace (bin/lib/tools.bash:
# target/stage2, built by bin/build-arbace).
#
# Usage: bin/c2a [OPTION...] -o OUT SRC...       translate files and trees into OUT
#        bin/c2a --in-place [OPTION...] SRC...   translate them where they are
#        bin/c2a --stdin [--kind K] [--ae]       standard input to standard output
#        bin/c2a --rules                         the rules and the dialect divergences
# Options: --keep-ext, --text EXT, --skip ID,..., -q (arbace.c2a.main's doc string).
# C2A_JVM_OPTS: the JVM's options (default -Xss16m -Xmx2g).
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tools.bash"
arbace_runtime
# shellcheck disable=SC2086
exec java ${C2A_JVM_OPTS:--Xss16m -Xmx2g} -cp "$ARBACE_CP" arbace.lang.Main -m arbace.c2a.main "$@"

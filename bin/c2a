#!/bin/bash
# c2a, the Clojure -> Arbace translator (doc/C2A.md), run on Arbace's Go executable
# (bin/lib/tools.bash's arbace_tool: the host of the tools), arbace.c2a loaded from the checkout.
#
# Usage: bin/c2a [OPTION...] -o OUT SRC...       translate files and trees into OUT
#        bin/c2a --in-place [OPTION...] SRC...   translate them where they are
#        bin/c2a --stdin [--kind K] [--ae]       standard input to standard output
#        bin/c2a --rules                         the rules and the dialect divergences
# Options: --keep-ext, --text EXT, --skip ID,..., -q (arbace.c2a.main's doc string).
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tools.bash"
# arbace.c2a is embedded in the executable: its namespaces load from the checkout instead
arbace_tool "${c2a_sources[@]}" -m arbace.c2a.main "$@"

#!/bin/bash
# The records against their known files (GD4: doc/GATE-DIET-SURVEY.md §5.2, GDS15 (a), "As built: GD4"), judge-only, seconds, no
# run: each recorded results file (a check's --record: rows [ID RESULT REASON], :pass or :known) against the known file that
# accounts for its non-passes (the :c-known sources of test/reap/cells.edn with a :results, and test/records/pairs.edn's): a
# :known row the known file no longer lists, a known entry the results pass (stale), a row neither :pass nor :known, a known
# entry the results lack; then the negative controls (mutated copies the judge must fail). The namespace records.check
# (test/records/check.ae) on the tools' host. The essential step records-check, beside reap.
#
# Usage: bin/records-check                 every pair and the controls
#        bin/records-check --hook          the pre-commit hook's run: the check only when the staged files touch a known,
#                                          results or divergences file (test/**/*known*.edn, *results*.edn, divergences*.edn)
#        bin/records-check --install-hook  writes the opt-in pre-commit hook (make hooks: the user's choice; git's hooks
#                                          directory of this checkout, an existing hook kept)
# Environment: ARBACE_HOST_EXE, the tools' host (bin/lib/host.bash; default stage 0).
# Exit status: 0 when every pair holds and every control fails as it must.
set -uo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash"
. "$root/bin/lib/tools.bash"
cd "$root" || exit 1
case ${1:-} in
  "") arbace_tool -p "$root/test" -m records.check check "$root" ;;
  --hook)
    git diff --cached --name-only | grep -qE '^test/.*(known|results|divergences)[^/]*\.edn$' || exit 0
    exec "$0" ;;
  --install-hook)
    h=$(git rev-parse --git-path hooks)/pre-commit
    [ -e "$h" ] && { echo "records-check: $h exists: kept (add \"bin/records-check --hook\" to it by hand)"; exit 1; }
    mkdir -p "$(dirname "$h")"
    printf '#!/bin/sh\n# records-check (GD4, GDS15 (a)): the records against their known files, when a commit touches them\nexec "$(git rev-parse --show-toplevel)/bin/records-check" --hook\n' > "$h"
    chmod +x "$h"; echo "records-check: the pre-commit hook written: $h" ;;
  *) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac

#!/bin/bash
# The class-file loader's, interpreter's and verifier's check (doc/classes/BYTECODE-SURVEY.md, JD3; test/bytecode/check.ae):
# test/bytecode/classes' programs run and their verifier cases and mutants judged by arbace.lang.Bytecode on EXE, against
# test/bytecode/expected.edn, the JDK's results; with its negative control (one set's verdicts against another's).
#
# Usage: bin/bytecode-check [EXE]
#            the check (EXE: default JAVA_CHECK_EXE, else target/arbace-go/amd64/arbace); status 0 when every result is
#            the JDK's and the control fails as it must. Seconds, under 1 GB
#        bin/bytecode-check --record-jdk [EXE]
#            rewrites test/bytecode/expected.edn: the mutants written by EXE (check.ae mutants), judged by jdk26u's own
#            java -Xverify:all (test/bytecode/HotSpotVerdicts.java), the programs run on it (bin/lib/java26.bash)
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash"
cd "$root"
record=
[ "${1:-}" = --record-jdk ] && { record=1; shift; }
exe=${1:-${JAVA_CHECK_EXE:-$root/target/arbace-go/amd64/arbace}}
[ -x "$exe" ] || { echo "bytecode-check: no executable $exe" >&2; exit 2; }
if [ -z "$record" ]; then
  exec "$exe" test/bytecode/check.ae check
fi
. "$root/bin/lib/java26.bash"; arbace_use_java26
work=$root/.tmp/bytecode-check; rm -rf "$work"; mkdir -p "$work/cls" "$work/plain"
"$exe" test/bytecode/check.ae mutants "$work/mutants"
javac -d "$work/cls" test/bytecode/HotSpotVerdicts.java
cp test/bytecode/classes/Plain49.class "$work/plain/Plain.class"
hs() { java -Xverify:all -cp "$work/cls" HotSpotVerdicts "$@"; }
vec() { printf '['; sed 's/.*/"&"/' | tr '\n' ' ' | sed 's/ $//'; printf ']'; }
q() { sed 's/\\/\\\\/g; s/"/\\"/g'; }
{
  echo ';; test/bytecode/check.ae'"'"'s expected results: the programs'"'"' on jdk26u'"'"'s java and HotSpot'"'"'s verdicts of the mutants'
  echo ';; (java -Xverify:all, test/bytecode/HotSpotVerdicts.java); written by bin/bytecode-check --record-jdk.'
  echo '{:programs'
  printf ' {"hello" "%s"\n' "$(hs run test/bytecode/classes Hello main2 | q)"
  printf '  "t2" "%s"\n' "$(hs run test/bytecode/classes T2 main2 | q)"
  printf '  "plain49" "%s"\n' "$(hs run "$work/plain" Plain run 4 | q)"
  printf '  "jsr" "%s"}\n' "$(hs run test/bytecode/classes J f 5 | q)"
  echo ' :mutants'
  printf ' {"hello" %s\n' "$(hs verdicts Hello "$work/mutants/hello" test/bytecode/classes | vec)"
  printf '  "t2" %s\n' "$(hs verdicts T2 "$work/mutants/t2" test/bytecode/classes | vec)"
  printf '  "plain49" %s}}\n' "$(hs verdicts Plain "$work/mutants/plain49" "$work/plain" | vec)"
} > test/bytecode/expected.edn
echo "bytecode-check: test/bytecode/expected.edn written"

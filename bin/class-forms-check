#!/bin/bash
# Compile converted class-form files and compare their class shapes with javac's classes on the
# class path. See test/classes/check_converted.clj for the arguments and options.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
# shellcheck disable=SC2086
# CLASS_FORMS_CP: more class path, e.g. the converted sources themselves, so that classes found
# nowhere else are entered from their converted source (SPEC §9.2)
exec java ${JAVA_OPTS:-} -Xss16m -cp "$root${CLASS_FORMS_CP:+:$CLASS_FORMS_CP}" clojure.main "$root/test/classes/check_converted.clj" "$@"

#!/bin/bash
# Compile converted class-form files and compare their class shapes with javac's classes on the
# class path, on Arbace (bin/lib/tools.bash). See test/classes/check_converted.clj for the
# arguments and options.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tools.bash"
arbace_runtime
# CLASS_FORMS_CP: more class path: javac's classes to compare with (the frozen clojure/'s), or
# the converted sources themselves, so that classes found nowhere else are entered from their
# converted source (SPEC §9.2)
# shellcheck disable=SC2086
exec java ${JAVA_OPTS:-} -Xss16m -cp "$ARBACE_CP${CLASS_FORMS_CP:+:$CLASS_FORMS_CP}" arbace.lang.Main "$root/test/classes/check_converted.clj" "$@"

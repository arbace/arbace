#!/bin/bash
# jrt, the Java runtime of Arbace on Go (B1a step 3, doc/go/JRT-NOTES.md): its hand-written
# Go forms under go/arbace/jrt (the package arbace/jrt of the module arbace, J2G-SPEC §4.2,
# §4.3), printed by the printer (arbace.repr.go.print, through bin/build-go --print-only) into a
# module and built, vetted and tested by gc.
#
# Usage: bin/jrt build [--arch amd64|arm64|all] [--prog DIR]
#            print the module into .tmp/jrt-go/mod (with the test files), then go build and
#            go vet the package for linux/ARCH (default all: amd64 and arm64)
#        bin/jrt test [--arch amd64|arm64|all] [--prog DIR] [GO-TEST-FLAGS...]
#            print the module with its test files (the forms' _test files, SPEC §15 Q14),
#            add the test data (made first if missing or older than test/jrt), and go test the
#            package: amd64 natively, arm64
#            under qemu-aarch64 (go test -exec); other flags go to go test (-run RE, -v,
#            -bench RE, -count N ...). No -race: Go's race detector needs cgo, which Arbace
#            does not use (--race removed on 2026-10-16, doc/go/BOX-NOTES.md)
#        --prog DIR: build or test the program root DIR instead of go/: j2g's (bin/j2g --tests
#            --out OUT writes OUT/prog: jrt with the stand-ins replaced by the translated JDK
#            classes), printed into .tmp/jrt-go/prog/mod
#        bin/jrt testdata [--check]
#            regenerate the differential tests' expected values from the JVM into
#            $JRT_WORK/testdata (test/jrt/testdata.ae on the frozen JVM Arbace,
#            bin/lib/frozen.bash, as the generators below; regenerated, not tracked, about 12 MB
#            in 4 s); --check makes them twice and compares (determinism)
#        bin/jrt standins
#            regenerate go/arbace/jrt/standin_lang.ae, standin_character.ae and
#            standin_reflect.ae, the stand-ins for JDK classes j2g will translate
#            (test/jrt/standins.ae, standins_reflect.ae; $JDK, default /root/jdk26u, for
#            SpecialCasing.txt)
#        bin/jrt manifest
#            regenerate go/arbace/jrt/manifest.edn (J2G-SPEC §9.1: jrt's hand-written classes
#            as j2g declares them, derived from the forms and the JDK) and manifest_test.ae
#            (refers to each member by its Go name), and print the coverage of the edge
#            (.tmp/jrt/edge.edn, from bin/jrt-convert, when present) (test/jrt/manifest.ae);
#            first the member tables of jrt's classes, go/arbace/jrt/reflect_tables.ae
#            (test/jrt/tables.ae)
#        bin/jrt modules [--check]
#            regenerate go/arbace/jrt/module_table.ae, the package-to-module table of Class.getModule
#            (RPS80 (b)): the packages of the named modules but java.base that jdk/javac/sources.txt
#            lists (java.compiler, java.xml, jdk.compiler, jdk.internal.opt), from the sources' lists
#            alone (no JVM); --check requires the committed file to be what it makes
#        bin/jrt print OUTDIR
#            print the module (with tests) into OUTDIR/mod only
#        bin/jrt overlay [--check]
#            print the patched Go runtime (overlay/go/runtime.ae: the goroutine-local slot,
#            J2G-SPEC §9.3) and reflect's addition (overlay/go/reflect.ae: goi's run-time named
#            types, GOI-SPEC.md "As built: GR9a-c") into $JRT_WORK/overlay/runtime and
#            $JRT_WORK/overlay/reflect and write the overlay $JRT_WORK/overlay/overlay.json for
#            $ARBACE_GOROOT (build and test use it; give it to bin/build-go --overlay for a
#            program using jrt); prints the overlay's path.
#            --check also converts $ARBACE_GOROOT's runtime again (bin/repr-go read) and requires
#            the forms of proc.go and runtime2.go to equal it but for the lines marked "; Arbace"
# Environment: ARBACE_GOROOT (default /root/tamago-go, go1.27.1), JRT_WORK (default .tmp/jrt-go).
# build, test, print and overlay run repr/go on Arbace's Go executable (bin/repr-go, bin/lib/repr-go-host.bash:
# the tools' host); testdata, standins and manifest generate data on a JVM Arbace.
set -euo pipefail
export CGO_ENABLED=0 # Go's builds never use cgo (doc/go/BOX-NOTES.md, "... cgo dropped", 2026-10-16)
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash" # TMPDIR: .tmp/tmp when unset
. "$root/bin/lib/renamed-env.bash" # stops on a stale G2A_*, J2A_*, A2G_* or C2A_*
cd "$root"
goroot=${ARBACE_GOROOT:-/root/tamago-go}
work=${JRT_WORK:-$root/.tmp/jrt-go}
case "$work" in /*) ;; *) work=$root/$work ;; esac
go=$goroot/bin/go
qemu=${QEMU_AARCH64:-/usr/bin/qemu-aarch64}

usage() { sed -n '2,/^set -/p' "$0" | sed '$d; s/^# \{0,1\}//' >&2; exit 2; }

# frozen ARGS...: arbace.lang.Main ARGS on the frozen JVM Arbace with test/'s and the tools' namespaces (the data
# generators: test/jrt/*.ae; jrt.manifest prints with arbace.repr.go.print)
frozen() { (. "$root/bin/lib/frozen.bash" && frozen_java tools -XX:+UseCompactObjectHeaders -- "$@"); }

# make_testdata DIR: the expected values of the differential tests, from the JVM
make_testdata() {
  rm -rf "$1"; mkdir -p "$1"
  frozen -m jrt.testdata "$1"
}

# print_module DIR: the module of go/ (package arbace/jrt) with its tests into DIR/mod, and
# the test data (made when missing or older than its generator)
print_module() {
  local out=$1 src=${2:-$root}
  mkdir -p "$out"
  # with the packages jrt imports from other forms roots: Mozilla's roots (x509roots/, tls.ae)
  bin/build-go --print-only --tests --module arbace --root "$root/x509roots" --work "$out" "$src" >&2
  if [ ! -f "$work/testdata/.done" ] || [ -n "$(find test/jrt -name 'testdata*.ae' -newer "$work/testdata/.done")" ]; then
    echo "== test data from the JVM (test/jrt/testdata.ae)" >&2
    make_testdata "$work/testdata" && touch "$work/testdata/.done"
  fi
  rm -rf "$out/mod/jrt/testdata"
  cp -r "$work/testdata" "$out/mod/jrt/testdata"
}

# the Go packages overlay/go patches or adds to for every build: the runtime's goroutine-local
# slot and event hook (J2G-SPEC §9.3), reflect's run-time named types (goi, GR9a: GOI-SPEC.md,
# "As built: GR9a-c"); the box's rebuild has the same list, arbace.box.print/overlay-packages
# (arbace/box/print.ae; GOI-SPEC.md, "As built: GC81"), and stops on a package it does not name
overlay_pkgs="runtime reflect"

# make_overlay: the patched runtime and reflect printed from overlay/go (when missing or older
# than their forms) and the overlay file naming them; prints the overlay file's path
make_overlay() {
  local dir=$work/overlay
  local json=$dir/overlay.json
  if [ ! -f "$json" ] || [ -n "$(find overlay/go -newer "$json")" ] || ! grep -q "\"$goroot/src/reflect/" "$json"; then
    echo "== the patched runtime and reflect (overlay/go/runtime.ae, reflect.ae)" >&2
    rm -rf "$dir"; mkdir -p "$dir"
    local pkg
    for pkg in $overlay_pkgs; do
      bin/repr-go print --layout gofmt "overlay/go/$pkg.ae" "$dir/$pkg" >&2
    done
    {
      printf '{"Replace": {'
      local sep=
      for pkg in $overlay_pkgs; do
        for f in "$dir/$pkg"/*.go; do
          printf '%s\n "%s": "%s"' "$sep" "$goroot/src/$pkg/$(basename "$f")" "$f"
          sep=,
        done
      done
      printf '}}\n'
    } > "$json.new"
    mv "$json.new" "$json"
  fi
  echo "$json"
}

# check_overlay: the overlay's converted runtime files equal a fresh conversion of
# $ARBACE_GOROOT's runtime, but for the patch's lines (marked "; Arbace")
check_overlay() {
  local out=$work/overlay-check
  rm -rf "$out"
  ARBACE_GOROOT=$goroot bin/repr-go read --goos linux --goarch amd64 --out "$out" runtime >&2
  local status=0 f
  for f in proc runtime2; do
    grep -v '; Arbace' "overlay/go/runtime/$f.ae" > "$out/$f.unpatched" || true
    if diff "$out/$f.unpatched" "$out/go/runtime/$f.ae" > "$out/$f.diff"; then
      echo "overlay: runtime/$f.ae is the conversion of $goroot/src/runtime/$f.go plus the patch" >&2
    else
      echo "overlay: runtime/$f.ae differs from the conversion (beyond the patch): $out/$f.diff" >&2
      status=1
    fi
  done
  return $status
}

goenv() {
  local arch=$1
  local level
  case $arch in amd64) level=GOAMD64=v1 ;; arm64) level=GOARM64=v8.0 ;; esac
  echo GOROOT="$goroot" GOTOOLCHAIN=local GOFLAGS= GOWORK=off GO111MODULE=on GOPROXY=off \
    CGO_ENABLED=0 GOEXPERIMENT= GOOS=linux GOARCH="$arch" "$level"
}

arches() {
  case $1 in
    all) echo amd64 arm64 ;;
    amd64|arm64) echo "$1" ;;
    *) echo "bin/jrt: --arch amd64|arm64|all" >&2; exit 2 ;;
  esac
}

cmd=${1:-}
[ $# -gt 0 ] && shift
case $cmd in
  build)
    arch=all prog=
    while [ $# -gt 0 ]; do
      case $1 in --arch) arch=$2; shift 2 ;; --prog) prog=$2; shift 2 ;; *) usage ;; esac
    done
    mod=$work
    if [ -n "$prog" ]; then mod=$work/prog; print_module "$mod" "$(cd "$prog" && pwd)"; else print_module "$mod"; fi
    ovl=$(make_overlay)
    status=0
    for a in $(arches "$arch"); do
      echo "== linux/$a: go build, go vet" >&2
      # shellcheck disable=SC2046
      (cd "$mod/mod" && env $(goenv "$a") "$go" build -trimpath -overlay "$ovl" ./... &&
         env $(goenv "$a") "$go" vet -overlay "$ovl" ./...) || status=1
    done
    exit $status ;;
  test)
    arch=all prog=
    flags=()
    while [ $# -gt 0 ]; do
      case $1 in
        --arch) arch=$2; shift 2 ;;
        --prog) prog=$2; shift 2 ;;
        *) flags+=("$1"); shift ;;
      esac
    done
    mod=$work
    if [ -n "$prog" ]; then mod=$work/prog; print_module "$mod" "$(cd "$prog" && pwd)"; else print_module "$mod"; fi
    ovl=$(make_overlay)
    status=0
    for a in $(arches "$arch"); do
      extra=(-overlay "$ovl")
      if [ "$a" = arm64 ]; then
        extra+=(-exec "$qemu")
      fi
      echo "== linux/$a: go test ${extra[*]} ${flags[*]}" >&2
      # shellcheck disable=SC2046
      (cd "$mod/mod" && env $(goenv "$a") "$go" test -trimpath "${extra[@]}" "${flags[@]}" ./...) || status=1
    done
    exit $status ;;
  testdata)
    make_testdata "$work/testdata" && touch "$work/testdata/.done"
    if [ "${1:-}" = --check ]; then
      make_testdata "$work/testdata-again"
      diff -r -x .done "$work/testdata" "$work/testdata-again" && echo "testdata: two runs identical" >&2
    fi ;;
  manifest)
    frozen -m jrt.tables go/arbace/jrt/reflect_tables.ae
    frozen -m jrt.manifest "$root/.tmp/jrt/edge.edn" ;;
  standins)
    frozen -m jrt.standins go/arbace/jrt/standin_lang.ae go/arbace/jrt/standin_character.ae
    frozen -m jrt.standins-reflect go/arbace/jrt/standin_reflect.ae ;;
  modules)
    out=go/arbace/jrt/module_table.ae
    tmp=$root/.tmp/module_table.ae.new
    mkdir -p "$root/.tmp"
    {
      echo ';; jrt: the package-to-module table of Class.getModule (RPS80 (b)), GENERATED by bin/jrt modules from'
      echo ';; jdk/sources.txt and jdk/javac/sources.txt: one "package module" per line, the packages of the named'
      echo ';; modules but java.base (the JDK classes of every other package are java.base'"'"'s: module.ae).'
      echo '(in-ns '"'"'go.arbace.jrt)'
      echo
      echo '(go/file "module_table.go")'
      echo
      echo '(go/var ^string modulePackages'
      printf '  "'
      cat jdk/sources.txt jdk/javac/sources.txt |
        awk '$1 != "java.base" && $1 != "buildtools" { n = split($3, a, "/"); p = a[1]; for (i = 2; i < n; i++) p = p "." a[i]; print p " " $1 }' |
        LC_ALL=C sort -u
      echo '")'
    } > "$tmp"
    if [ "${1:-}" = --check ]; then
      cmp "$tmp" "$out" && echo "modules: $out is current" >&2
    else
      mv "$tmp" "$out"
    fi ;;
  overlay)
    make_overlay
    if [ "${1:-}" = --check ]; then check_overlay; fi ;;
  print)
    [ $# -eq 1 ] || usage
    print_module "$1" ;;
  *) usage ;;
esac

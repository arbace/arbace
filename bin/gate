#!/bin/bash
# The gate: the checks a change must pass before it is committed to main. Since standalone S4
# (doc/STANDALONE-NOTES.md, "S4: the JVM removed") the bootstrap starts from the Go-source seed
# and every build is Go-hosted; the JVM runs only the oracle's reference (the frozen v4 jar) and,
# with --full, the checks of what the JVM made (the edges), the reference javac, the frozen
# back end of repr/java's check --suite, jrt-convert's edge step and the JDK build's generators;
# since JN5 repr/java's checks run on javac's tool executable, and since JN6 nothing of repr/java
# starts a JVM (doc/classes/JAVA-FRONTEND-SURVEY.md, JFS9, "As built: JN5", "As built: JN6").
#
# Since GT1-GT3 (doc/GATE-SURVEY.md, "As built: GT1-GT3") the steps are data, test/gate/steps.edn:
# each with its command, the steps it needs and its declared inputs (files, hosts, pins,
# environment). After stage 0 the planner (test/gate/plan.ae, gate.plan on stage 0) computes each
# check's key over them (GTS2 (a): never the commit) and looks it up in the store of passes
# (ARBACE_GATE_STORE, default the main checkout's .tmp/gate-pass/, shared by the worktrees; GTS6
# (a)): a check that passed at its key is skipped (the summary's "skipped NAME (passed at ...)"),
# one that runs and passes is recorded there (GTS7 (a): STORE/NAME/KEY.edn with the commit, the
# worktree, the date, the seconds, the peak memory and the log's digest; KEY.log, KEY.inputs). A
# build (go-build, javac-tool) runs when a check that runs needs it. Every step runs under busybox
# time -v (GT1, GTS15 (a)): its wall and CPU seconds and its largest process's peak RSS in
# .tmp/gate/NAME.mem, beside the 5 s sampler's .tmp/gate/mem.tsv (the host's MemAvailable, the
# gate's processes' RSS, each running step's), whose per-step peak the .mem file holds too.
#
# Since GT4-GT6 (doc/GATE-SURVEY.md, "As built: GT4, GT6") what decides a step's outcome is the runner
# library bin/lib/gate-run.bash (with the planner, the only gate logic in a key, GTS22 (a): this file's
# header, summary and option parsing are not); the heavy steps (:heavy, with their measured :mem-gib)
# run under GATE_HEAVY_CMD, by default the host's big-job lock ARBACE_HEAVY_LOCK, the gate itself not
# (GTS25 (a)); the gate's executables and javac's tool are kept by their keys in ARBACE_GATE_EXES
# (default the main checkout's .tmp/gate-exe), shared by the worktrees (GTS24 (a)); a step over three
# times its latest passes' time is flagged in the summary (GTS17 (a)).
#
# Since GT5 (doc/GATE-SURVEY.md, "As built: GT5") the inner keys: a step's :parts are one check each
# (NAME.PART: native-check and repr/java's tree checks per corpus; :clean-only parts with
# GATE_ALL_PARTS=1), :outputs kept with a pass and put back on a skip, :uses keying a step by its
# producers' outputs (the decision "after": an early cutoff), Java's check a step per level with its
# judgment apart, the program hosts :prog and :javac-prog (the build's units less a step's :never-loads);
# the builds run before every check and the plan is made again after them; GATE_HEAVY_CMD's default is
# bin/heavy-lock (the lock taken in turn, GTS32 (a)), and a :heavy :inner step's tools lock around their
# heavy process alone (GTS31 (b), bin/lib/heavy.bash); --full ends with --prune (GTS34 (a)).
#
# Usage: bin/gate [--full] [--rerun]
#        bin/gate --nightly [--plan] (GT8.4, GT8.7; doc/GATE-SURVEY.md, "As built: GT8.4, GT8.7 (write-ahead)")
#                                   the nightly tier: --full's steps keyed as --full keys them, each part whose
#                                   step declares :rotate (and whose corpus has a :subset smaller than it) run as
#                                   NAME.PART.sub, its subset and the files that failed since, and NAME.PART.sK,
#                                   one slice of the rest (a file's slice: its name's SHA-256 mod 7), the slice
#                                   whose latest run failed, else never ran, else ran longest ago (ties: the
#                                   night's index, GATE_NIGHT), each a check with its own key and passes; every
#                                   run noted in STORE/_rotation/
#        bin/gate --rotation-status [--days N]  the rotation's record complete? every slice of every rotated part
#                                   passed (or skipped at its pass) with its current list within 7 days (N), no
#                                   file failed since; exit 1 when not. bin/gate --full --clean checks it first and
#                                   runs the subsets alone (GTS204 (a); GATE_CLEAN_WHOLE=1: whole parts;
#                                   GATE_CLEAN_ROTATION=0: not checked, its record says :unchecked)
#        bin/gate [--full] --plan   the plan alone: each step, run, skipped, built or not needed,
#                                   and why (the inputs changed since its latest pass); stage 0
#                                   first when missing
#        bin/gate --why STEP        STEP's material (its key's inputs but the files), its passes,
#                                   and every line changed since the latest one (--full's plan)
#        bin/gate --audit [STEP...] each check named (default every check, --full's table) run under
#                                   strace; the files it reads under the checkout against its declared
#                                   inputs: an undeclared read fails the audit and names the file
#                                   (GT4; needs the executables and javac's tool built: bin/gate
#                                   --full first; a heavy step takes the lock; .tmp/gate-audit/)
#        bin/gate --prune [--dry-run]  the store of passes trimmed: per step the last 5 and every pass
#                                   younger than 30 days kept; the executables' directories but the
#                                   newest 3 of each, older than a day, removed (GTS27)
#        --rerun                    every check runs (and records its pass), as at a clean run
#        bin/gate [--full] --plan --builds  the builds the plan needs run first, then the plan on their
#                                   program units (GTS42 (a)'s demonstrations, bin/gate-demos)
#        bin/gate [--full] --clean [--tag TAG]  (GT7, doc/GATE-SURVEY.md §7, "As built: GT7 (tooling)")
#                                   the clean run at a tag: a fresh `git clone --shared` of HEAD's commit
#                                   in .tmp/gate-clean/SHA, its own empty .tmp/, target/ and GOCACHE, the
#                                   environment's Arbace and gate variables dropped (but ARBACE_GOROOT,
#                                   ARBACE_HEAVY_LOCK, GATE_HEAVY_CMD, ARBACE_HEAVY_HELD, GATE_TEST_JOBS,
#                                   JDK), the clone's bin/gate run there: the pins first (--pins), stage
#                                   0, the executables and javac's tool built fresh (its ARBACE_GATE_EXES,
#                                   its store: no pass read, every check run), serial, every step (the
#                                   builds too) run under the audit (strace, the reducer tools/gateaudit,
#                                   gate.audit: an undeclared read fails the gate and its pass is not
#                                   recorded; GTS30 (a)), every part (GATE_ALL_PARTS=1, GTS19 (a)), Java's
#                                   levels that consume the read's output on its cache alone
#                                   (JAVA_CHECK_FORMS_ONLY=1: a miss fails, GTS41 (c)), each limited
#                                   program's CPU time in .tmp/gate/NAME.cpu.tsv (GTS33 (a)); then its
#                                   record test/gate/clean-TAG.edn (TAG default the short SHA,
#                                   GATE_CLEAN_TAG) in this checkout, its logs in .tmp/gate-clean/SHA.logs/,
#                                   its passes (:clean) into the store and, when it passed, its builds into
#                                   ARBACE_GATE_EXES where absent (GATE_CLEAN_PUBLISH=0: not), the clone
#                                   removed (kept on a failure, GATE_CLEAN_KEEP=1). A caller holding the
#                                   big lock for the whole run sets GATE_HEAVY_CMD=env; the frozen jar is
#                                   the main checkout's .tmp/oracle-frozen/ one (FROZEN_JAR), checked by its
#                                   pin, else built in the clone from its tag
#        bin/gate [--full] --clean --plan  the plan such a run makes (an empty store, every part)
#        bin/gate [--full] --clean --tag TAG --only STEP,...|failed|changed  (GT7's fix round, doc/GATE-SURVEY.md,
#                                   "As built: GT7's fix round") a clean rerun of some steps: a fresh clone of HEAD's
#                                   commit as above, the builds the selected steps need made fresh, those steps
#                                   alone run and audited, their entries merged into test/gate/clean-TAG.edn (each
#                                   step naming the run it passed clean at, :run of :runs). The selection: the steps
#                                   named (a step with parts names its parts), failed (the record's steps that did not
#                                   pass clean, audit ok, or that it lacks), changed (those whose key material differs
#                                   from the run they passed at, .tmp/gate-clean/SHA.logs/gate/plan/), closed over :uses
#                                   both ways; every other check skipped on its clean pass, and the run stopped when
#                                   one of them changed since (its key is not the one it passed clean at): the rule
#                                   that makes the merged record mean every step passed clean at its key
#        bin/gate --pins [FILE]     what a clean run takes from outside its clone, by its pins: TamaGo's go
#                                   (seed/goroot.sha256), jdk26u's commit and its build tree's platform
#                                   (jdk/javac/platform.sha256), the system JDK (javac 26), the frozen jar
#                                   (test/oracle/frozen-jar.sha256, when FROZEN_JAR names it), the frozen
#                                   tree's tag; $GOROOT/test's digest recorded; C's: gcc 15.2.0's and musl 1.2.6's
#                                   tarballs (test/c/corpora.edn), the host's gcc against test/c/host/ (bin/repr-c
#                                   host check) (FILE: as a map)
#        bin/gate --outside-pins    (queue 023, report 022 finding 4; the ordinary gate's pre-step outside)
#                                   TamaGo's go and \$GOROOT/test hashed against seed/goroot.sha256 and
#                                   seed/goroot-test.sha256, jdk26u's work tree clean (when there)
#        bin/gate [--full] --costs [--last N] [--tsv]  (GT8.1, queue 170) each step's and part's cost from the
#                                   store of passes (the last N passes, default 5: wall, CPU, peak, median and
#                                   max; a step the store does not record, its latest run's .tmp/gate/NAME.mem;
#                                   else unmeasured), its tier and its crop (steps.edn's :crops), then the sums per
#                                   crop and per tier against steps.edn's :budgets (test/gate/costs.ae, on the
#                                   tools' host: the caller's ARBACE_HOST_EXE when set; reads only, no key); --full
#                                   the full gate's steps too, --tsv the rows as TSV
#        bin/gate --full --concurrent  (GTS37 (a)) --full's chains at once (GATE_FULL_PARALLEL=1) under the
#                                   host's big lock taken once for the whole run (bin/heavy-lock;
#                                   GATE_CONCURRENT_HELD=1 or GATE_HEAVY_CMD=env: the caller holds it); since
#                                   GTS227 (a) in the memory lanes: every step admitted by its declared :mem-gib
#                                   (bin/gate-lane: within GATE_MEM_BUDGET_GIB, default MemTotal less
#                                   GATE_MEM_RESERVE_GIB 4; the steps of GATE_LANE_BIG_GIB, 16, or more one at a
#                                   time, lane 1; the rest beside, lane 2; the plan's order decides), its tools
#                                   taking no lock; GATE_LANES=0: GTS37 (a)'s one heavy step at a time on a lock of
#                                   its own (GATE_CONCURRENT_LOCK, default .tmp/gate-concurrent.lock)
#        bin/gate --full --clean --concurrent [--tag TAG]  (GTS227 (a)) the clean run in the memory lanes: as
#                                   --clean, the big lock taken once around it, the clone's essential and full
#                                   chains at once, each step admitted as above (the record's :lanes, each step's
#                                   :mem-gib, :lane and :start-s); not with --only (its reruns stay serial)
#        bin/gate --full [--clean] --concurrent --plan  the plan with its lanes: each step's lane and a schedule
#                                   simulated by the same rule (test/gate/lanes.ae's view; durations: the main
#                                   store's passes, else the clean records', GATE_LANES_RECORDS more of them,
#                                   GATE_LANES_PREFER=clean the records first)
#        bin/gate [--full] --mem-check  (GTS227 (a)) every step's :mem-gib against the store's passes' and the
#                                   committed clean records' peaks: exit 1 on one over its declaration by 10%
#                                   and 0.5 GiB, or a step without one (test/gate/lanes.ae's mem-check)
#        (GATE_STEPS: another table, GATE_PROG_UNITS, GATE_JAVAC_PROG_UNITS: the units given: the gate's
#        own tests, a toy table)
#   (default)  the essential gate:
#                0. makefile      make check-makefile: every bin/ script the Makefile (the
#                                 newcomers' interface) runs exists (seconds)
#                1. seed          bin/seed --check: the seed is the pinned one
#                   outside       bin/gate --outside-pins: TamaGo's go, its $GOROOT/test and jdk26u
#                                 against their pins (queue 023; not in the clean run, whose pins step does it)
#                2. stage0        bin/seed --build --no-aot: stage 0, the host of the build's tools,
#                                 built from the seed by Go's toolchain (target/seed; kept by the
#                                 seed's and Go's pins since GT3, GTS12 (a); seconds with Go's
#                                 build cache warm; its compiled namespaces, RPS95 (b), are the
#                                 gate build's business here: --no-aot); in a linked worktree
#                                 without a current one of its own, the main checkout's linked
#                                 into its target/seed first (bin/seed --link), when its pins are
#                                 this worktree's (GTS83 (a), review 001's fixes)
#                   (then the plan: above)
#                3. go-build      bin/arbace-go --gate-build: the executable and the test build
#                                 (amd64), j2g and repr/go on stage 0, cached in
#                                 ARBACE_GATE_EXES/KEY20 (bin/lib/gate-cache.bash) and built again only when what they are
#                                 built from changed (gate_key: Arbace's embedded sources, go/,
#                                 overlay/ and jdk/ but javac's world's, the fixtures' forms, the
#                                 build's scripts, the seed's and the toolchain's pins; narrowed
#                                 by GT2, GTS5 (a)): seconds on a hit, two Go-hosted builds on a
#                                 miss; a build, run when a check that runs needs it
#                4. concurrently, on the cached executables:
#                   go-smoke      bin/arbace-go --gate: the smoke test (seconds)
#                   suite-go      Clojure's suite on the test build, against
#                                 test/arbace-go-results.edn (repr/clojure's translation on stage 0)
#                   oracle-go     bin/oracle check on the executable against the frozen JVM
#                                 Arbace's expected results, with its known mismatches,
#                                 test/oracle/known-go-amd64-frozen.edn
#                   goi-check     bin/goi check --essential: the programs of $GOROOT/test listed in
#                                 test/goi/essential.txt interpreted by goi against gc, against
#                                 test/goi/check-linux-amd64.edn (doc/go/GOI-SPEC.md §11.5, GS12;
#                                 gc's references cached in .tmp/goi-check)
#                   java-check    bin/java-check --essential: the jtreg tests of test/java/essential.txt
#                                 interpreted from their committed forms (test/java/forms) against the
#                                 JDK's recorded runs, test/java/ref-jdk26.edn (doc/classes/
#                                 JAVA-CONFORMANCE-SURVEY.md, JCS13 (a), "As built: JC1"; about a minute)
#                   goi-aot-essential  (REAP8, RPS33 (a); after goi-check, which reads the corpora
#                                 when missing) bin/goi check --aot --essential: the programs of
#                                 test/goi/essential-aot.txt at Go's AOT level (built by
#                                 arbace.build.go on the gate's executable and run, or printed from
#                                 mode :full and compiled by gc) against gc on the originals, against
#                                 test/goi/check-aot-linux-amd64.edn (about 70 s on gc's cached references)
#                   java-compiled (REAP8, JCS41 (a)) bin/java-check --essential-compiled: the
#                                 essential tests that pass compiled, from their committed forms, in
#                                 one program (j2g with the gate's compiled namespaces, bin/build-go)
#                                 cached by its key in .tmp/java-check/essential-compiled, every one
#                                 passing (seconds cached, about 5 minutes when j2g, the runtime or
#                                 the forms change)
#                   suite-aot-essential  (REAP8, RPS40 (b)) bin/clojure-tests --aot --essential:
#                                 the namespaces of test/clojure/essential-aot.txt compiled alone by
#                                 c2j, their program built by j2g and bin/build-go (cached by its
#                                 key) and run, against test/arbace-go-aot-results.edn
#                   programs      (REAP7b, RPS98 (c)) bin/arbace-go --build-program --check mixed bad-go (the sample
#                                 that must not build, RPS102 (b)):
#                                 test/programs/mixed (Clojure, Java forms, Go forms compiled
#                                 through its own goi table) built on the gate's executable and
#                                 compiled namespaces (ARBACE_PROGRAM_BASE, cached by its key) and
#                                 run on its runs (seconds cached, about 4 minutes when its key
#                                 changes)
#                   (the whole-program j2g runs, diffcheck's, java-compiled's,
#                   suite-aot-essential's and programs', one at a time: J2G_LOCK, bin/j2g)
#                   j2g-edge      (essential since 2026-10-24) bin/j2g-edge verify, on the frozen
#                                 JVM (bin/lib/frozen.bash): j2g's edge recorded afresh and compared
#                                 byte for byte with jdk/edge.edn (about 1.5 minutes)
#                   reap          bin/reap: the REAP matrix from the checks' recorded results
#                                 (doc/FULL-SUPPORT-SURVEY.md, REAP1, RPS13): every non-pass of a
#                                 recorded check in a class of its level's classes file (seconds)
#                   repr-java-closure bin/repr-java closure-check (JN10: repr/java's read closure
#                                 names no javac class, as a ratchet, test/repr/java/closure-known.edn;
#                                 its clean namespaces loaded on stage 0; seconds)
#   --full     also, once those are done, one after another in this order (GTS13 (a); by chain,
#              concurrently, with GATE_FULL_PARALLEL=1):
#                   go            the chain of the gate's executables (no fresh build of the program
#                                 since GT3, GTS10 (a): the gate's cached build is the fixpoint's G1;
#                                 its smoke test is the essential go-smoke):
#                     javac-tool    javac's tool executable (doc/classes/JAVA-FRONTEND-SURVEY.md, JN2,
#                                   JN3, JN5), built once per arbace_javac_key and kept in
#                                   .tmp/gate-javac across gates (GTS11 (a)): bin/javac-vendor tool
#                                   (bin/arbace-go --build-java, j2g on the gate's executable with its
#                                   compiled namespaces); a build, run when a check that runs needs it
#                     javac-check   bin/javac-vendor check --from: j2g translates javac's world, read
#                                   from the tool build's own j2g run (javac's world translated once)
#                     javac-verify  bin/javac-vendor verify (jdk/javac read afresh by javac on
#                                   Arbace, the fixpoint, its edge recorded on the frozen JVM: byte
#                                   for byte)
#                     javac-classes bin/javac-vendor classes baseline samples jdk java.base (javac on
#                                   Arbace's class files against the JVM's javac's, byte for byte,
#                                   and java.base's against the JDK build's)
#                     java          after javac-tool (GATE_FULL_PARALLEL=1: concurrently with the
#                                   rest of the go chain), repr/java's checks on the tool executable
#                                   (REPR_JAVA_EXE), one after the other:
#                       repr-java     bin/repr-java check --suite (the converter's checks, and
#                                     Clojure's suite on the converted baseline, compiled by the
#                                     frozen jar's back end and run on the JVM)
#                       repr-java-roundtrip  bin/repr-java roundtrip --corpus baseline,samples,jdk
#                                     --text (Java -> forms -> Java -> forms, levels forms, ae and
#                                     classes by javac on Arbace, then the text level: mode :full
#                                     printed back byte for byte, against test/repr/java/roundtrip/)
#                       jrt-convert   bin/jrt-convert verify (jdk/'s forms converted afresh by
#                                     repr/java and compared byte for byte: jdk/README.md; its
#                                     generators on a JDK, its edge step on the frozen JVM)
#                       java-fixtures bin/clojure-tests --java-fixtures verify (the suite's Java
#                                     fixtures converted afresh by repr/java, compared with
#                                     test/java-fixtures)
#                       repr-java-parse  bin/repr-java parse-check (repr/java's native parser:
#                                     every file of the samples, the baseline, the jdk corpus's and
#                                     javac's sources, jdk26u's 68 modules, the mutants and
#                                     jdk26u's tests parsed
#                                     to javac on Arbace's trees, positions included, against
#                                     test/repr/java/parse-check-known.edn; doc/classes/
#                                     JAVA-FRONTEND-SURVEY.md, "As built: JN8", JFS60)
#                       repr-java-front  bin/repr-java front-check (the converter on the native
#                                     parser's trees, javac's attribution by position: its forms
#                                     equal to javac's trees' over the samples, the baseline, the
#                                     jdk corpus and javac's sources, the split measured; "As
#                                     built: JFS66 (b)", JFS67)
#                       repr-java-attr   bin/repr-java attr-check (the native attribution provider:
#                                     the native trees' scope and declarations tiers answered
#                                     without javac, each fact equal to javac on Arbace's, the forms
#                                     still javac's trees', over the same corpora, against
#                                     test/repr/java/attr-check-known.edn; "As built: JN9a", JFS74)
#                       repr-java-nojavac bin/repr-java nojavac-check (the read without javac:
#                                     every corpus read by javac's trees and by read --no-javac, the
#                                     forms equal file for file, the fallbacks counted, against
#                                     test/repr/java/nojavac-check-known.edn; "As built: JN9f", JFS121)
#                       repr-java-platform bin/repr-java platform-check (JN10 part 2: the java.base
#                                     pack's proof on stage 0, (parse (strip b)) = (parse b) for every
#                                     java.base class, the pack a fresh one's; about 3 minutes)
#                       java-check-full  bin/java-check --levels read,interp,classes,compiled,diagnostics,print
#                                     (Java's conformance check, every corpus: jdk26u's jtreg run tests
#                                     read on the tool, interpreted on the gate's executable, compiled
#                                     by javac on Arbace, translated by j2g in shards with the Go build's
#                                     compiled namespaces and run (JC2), langtools' golden-diagnostics
#                                     tests by javac on Arbace against their golden files, "As built:
#                                     JC3", every read test's forms printed back by repr/java's
#                                     printer and judged, "As built: REAP5"; against test/java/ref-jdk26.edn and
#                                     test/java/check-*.edn, every test not passing in a class of
#                                     test/java/divergences.edn), then bin/java-check --forms verify
#                                     (the essential tests' committed forms read afresh; "As built: JC1")
#                     fixpoint      bin/arbace-go --fixpoint --g1 "$GATE_CACHE": G1 the
#                                   gate's build (GT3, ARBACE_GATE_EXES/KEY20; GATE_FRESH_G1=1: built afresh), G2 by G1, G3 by G2; G2 = G3 (j2g's trees and
#                                   the executables); G1 = G2 and stage 0 = G1 reported (they hold
#                                   when the seed is current and G1 was built at this commit)
#                     suite-aot     bin/clojure-tests --aot (after the fixpoint, in its chain):
#                                   Clojure's suite compiled by c2j with the runtime's, against
#                                   test/arbace-go-aot-results.edn, the levels compared (REAP3)
#                     programs-full bin/arbace-go --build-program --check (REAP7b, RPS98 (c)):
#                                   every sample of test/programs on the gate's executable
#                   repr-go       bin/repr-go roundtrip amd64, then linux/amd64 (Go -> forms -> Go
#                                 over std and $GOROOT/test, against test/repr/go/roundtrip-*.edn);
#                                 bin/repr-go roundtrip --text amd64 (mode :full, each file printed
#                                 back byte for byte, but test/repr/go/roundtrip-text-known.edn's);
#                                 $GOROOT/test's directory tests: roundtrip --dirs amd64, then
#                                 linux/amd64 (with the level run), --text --dirs amd64 (about 20
#                                 s together; test/repr/go/roundtrip-dirtest-*.edn);
#                                 then bin/x509roots-vendor verify and check
#                   repr-go-native after repr-go: bin/repr-go native-check --fresh (the native
#                                 reader's trees, go/parser run by goi, equal to the helper's
#                                 dumps over every corpus, afresh; its raw forms resolved by the
#                                 final ones; the final forms of its dumps annotated by goi's
#                                 checker equal to the helper's; against
#                                 test/repr/go/native-known.edn; doc/go/GO-PARSER-SURVEY.md,
#                                 GPS8 (a), "As built: GP1", "As built: GP4")
#                   goi           after repr-go, on its fresh conversions: bin/goi annotations
#                                 (goi's checker over tamago/goroot, the linux std, $GOROOT/test and
#                                 its directory tests: no error, every annotation verified, against
#                                 test/goi/annotations-*.edn; doc/go/GOI-SPEC.md §11.4), bin/goi
#                                 test --gc (the checker's tests, gc's messages; the interpreter's
#                                 programs against gc, the REPL's tests) and bin/goi check --jobs 8
#                                 (every run program of $GOROOT/test against gc, §11; 8 jobs, as
#                                 its reference was recorded: with 16 beside the other steps
#                                 nosplit.go and bug358.go exceed the 10 s), on the gate's executable
#                   goi-aot       after goi: bin/goi check --aot --jobs 8 (Go's AOT level, REAP2: the
#                                 same corpora's forms built by arbace.build.go and run, the
#                                 errorcheck programs printed from mode :full and compiled by gc,
#                                 against gc on the originals; test/goi/check-aot-linux-amd64.edn,
#                                 the classes of test/goi/divergences-aot.edn), the gate's
#                                 executable the tools' host
#                   repr-clojure  bin/repr-clojure check (read's and print's unit tests), --suite
#                                 (Clojure's suite translated against its digest, then printed
#                                 back byte for byte) and --roundtrip (Clojure -> Arbace ->
#                                 Clojure over the frozen clojure/, the suite and its libraries,
#                                 Arbace -> Clojure -> Arbace over arbace/, against
#                                 test/repr/clojure/roundtrip-known.edn); on the tools' host
#                                 (about 1 minute)
#                   diffcheck     (in the essential steps since 2026-10-17, F2.1) bin/diffcheck: the per-form differential check (Futamura
#                                 F2, doc/FUTAMURA-SURVEY.md "F2 as built"): the oracle's forms
#                                 evaluated against compiled by the back end, the Java forms
#                                 interpreted against translated by j2g, in a program built for
#                                 it from the gate's executable, against test/diffcheck/known.edn
#                   generated     (essential, F7.3) bin/generated-check: arbace/lang/go/CompilerNodes.ae
#                                 and CompilerAOTFn.ae regenerated by test/c2j/gen_nodes.ae and
#                                 gen_fns.ae on the gate's executable, compared with the committed
#                                 files (seconds)
#              (arm64, under qemu, stays out: its suite takes hours)
# Parked by the user, 2026-10-26: the box, repr/haskell and repr/rust (and tamago/, tamago/cmd/ with the
# box) are out of --full, kept as they are and revisited later piece by piece. The steps box-forms,
# box-smoke, box-oracle, box-suite, box-goi, repr-haskell, repr-rust and toolchain, and repr-go's
# bin/box-vendor roundtrip, kvm-tests, purego-check and bin/tamago-vendor verify, do not run here:
# run by hand with their scripts (bin/arbace-go --build --box, bin/box-suite, bin/goi check --box,
# bin/repr-haskell, bin/repr-rust, bin/toolchain-vendor, bin/tamago-vendor, bin/box-vendor).
# Every build and tool needs TamaGo's go (ARBACE_GOROOT, default /root/tamago-go), never the host's.
# The gate first trims Go's build cache of entries unused for 90 minutes (bin/lib/gocache.bash,
# ARBACE_GOCACHE_KEEP_MIN). ARBACE_HOST_EXE is ignored: the gate's host is stage 0 (in a linked worktree
# without a current one of its own, the main checkout's linked into its target/seed, bin/seed --link,
# when bin/seed --kept finds its pins this worktree's, GTS83 (a); the clean run's clone builds its own).
# Logs go to .tmp/gate/NAME.log (NAME.status, .secs, .time, .mem; plan.tsv, plan/NAME.inputs,
# mem.tsv); the summary prints each step's outcome, wall and CPU time and peak memory.
# Environment: ARBACE_HEAVY_LOCK (the host's big-job lock: default the main checkout's .tmp/big.lock),
# GATE_HEAVY_CMD (the command a heavy step runs under: default `flock $ARBACE_HEAVY_LOCK`; `env` when
# the caller holds the lock already), ARBACE_GATE_EXES (the executables' root), GATE_TEST_JOBS, the suite's parallel processes (default 12); ARBACE_GATE_STORE, the
# store of passes; GATE_FULL_PARALLEL=1: --full's chains concurrently, the java chain after
# javac-tool (serial is the default since GT3, GTS13 (a): the chains at once overload a 62 GB host,
# 20 GiB j2g runs, repr-go-native's reads, REAP9, 2026-10-26; GATE_FULL_SERIAL is accepted, a
# no-op); GATE_FRESH_G1=1: the fixpoint builds its G1 (the clean run's hook, GT7); ARBACE_SEED_LINK_WAIT, in a
# linked worktree the stage0 step's longest wait for the main checkout's stage 0 build (bin/seed). Every other variable
# of the tools' families (ARBACE_*, GATE_*, J2G_*, REPR_*, JAVA_CHECK_*, CLOJURE_TESTS_*, GOI_*, FROZEN_*,
# ...: gate_scrub_env) is dropped and named on stderr, since no key holds it (queue 023, report 022
# finding 1); GATE_STEPS, GATE_PROG_UNITS, GATE_JAVAC_PROG_UNITS need ARBACE_GATE_STORE.
# Exit status: 0 when every step passed or was skipped.

set -uo pipefail
export CGO_ENABLED=0 # Go's builds never use cgo (doc/go/BOX-NOTES.md, "... cgo dropped", 2026-10-16)
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash" # TMPDIR: .tmp/tmp when unset
. "$root/bin/lib/renamed-env.bash" # stops on a stale G2A_*, J2A_*, A2G_* or C2A_*
cd "$root"
caller_host_exe=${ARBACE_HOST_EXE-} # --costs only (it reads, keys nothing): the caller's tools' host
unset ARBACE_HOST_EXE J2G_GO_EXE REPR_GO_EXE
usage() { echo "usage: bin/gate [--full|--nightly] [--rerun] | bin/gate --rotation-status [--days N] | bin/gate [--full] --plan [--builds] | bin/gate [--full] --costs [--last N] [--tsv] | bin/gate --why STEP | bin/gate --audit [STEP...] | bin/gate --prune [--dry-run] | bin/gate [--full] --clean [--tag TAG] [--only STEP,...|failed|changed] [--plan] | bin/gate --pins [FILE] | bin/gate --full [--clean] --concurrent [--plan] | bin/gate [--full] --mem-check" >&2; exit 2; }
full= plan_only= why= rerun= audit= prune= dry= clean= clean_tag= pins= pins_out= concurrent= builds= only= outside=
nightly= rotation_status= rot_days=
costs= costs_last=5 costs_fmt=text mem_check=
steps_arg=() orig_args=("$@")
while [ $# -gt 0 ]; do
  case $1 in
    --full) full=1 ;;
    --nightly) nightly=1; full=1 ;;
    --rotation-status) rotation_status=1 ;;
    --days) [ $# -ge 2 ] || usage; rot_days=$2; shift ;;
    --plan) plan_only=1 ;;
    --builds) builds=1 ;;
    --clean) clean=1 ;;
    --tag) [ $# -ge 2 ] || usage; clean_tag=$2; shift ;;
    --only) [ $# -ge 2 ] || usage; only=$2; shift ;;
    --pins) pins=1; if [ $# -ge 2 ] && [ "${2#-}" = "$2" ]; then pins_out=$2; shift; fi ;;
    --concurrent) concurrent=1; full=1 ;;
    --outside-pins) outside=1 ;;
    --why) [ $# -ge 2 ] || usage; why=$2; full=1; shift ;;
    --rerun) rerun=1 ;;
    --audit) audit=1; full=1 ;;
    --prune) prune=1 ;;
    --dry-run) dry=--dry-run ;;
    --costs) costs=1 ;;
    --mem-check) mem_check=1 ;;
    --last) [ $# -ge 2 ] && [ "$2" -gt 0 ] 2>/dev/null || usage; costs_last=$2; shift ;;
    --tsv) costs_fmt=tsv ;;
    -*) usage ;;
    *) [ -n "$audit" ] || usage; steps_arg+=("$1") ;;
  esac
  shift
done
mode=essential; [ -n "$full" ] && mode=full
# GT8.4, GT8.7 (doc/GATE-SURVEY.md, "As built: GT8.4, GT8.7 (write-ahead)"): --nightly, --full's steps with each
# rotated part's subset and the night's slice (the night: the day of the run's start less 12 hours, so that a
# night that crosses midnight is one; GATE_NIGHT gives it); the clean run its subsets alone (GATE_CLEAN_WHOLE=1:
# whole parts, as --full)
plan_rot=()
if [ -n "$nightly" ]; then
  [ -n "$clean$concurrent$audit" ] && usage
  mode=nightly; plan_rot=(--night "${GATE_NIGHT:-$(( ($(date +%s) - 43200) / 86400 ))}")
elif [ -n "$clean" ] && [ -n "$full" ] && [ "${GATE_CLEAN_WHOLE:-}" != 1 ]; then
  plan_rot=(--rotation subset)
fi
[ -n "$builds" ] && [ -z "$plan_only" ] && usage
[ -n "$clean" ] && { [ -n "$audit$why$prune" ] && usage; }
# GTS227 (a): --concurrent with --clean (the clean run in the memory lanes), with --plan (the plan and its lanes); not --only
[ -n "$concurrent" ] && [ -n "$only" ] && usage
[ -n "$only" ] && { [ -n "$clean" ] && [ -z "$plan_only" ] || usage; }
[ -z "$costs" ] && { [ "$costs_last" != 5 ] || [ "$costs_fmt" != text ]; } && usage
[ -n "$costs" ] && { [ -n "$plan_only$why$rerun$audit$prune$clean$pins$concurrent$builds$outside$mem_check" ] && usage; }
[ -n "$mem_check" ] && { [ -n "$plan_only$why$rerun$audit$prune$clean$pins$concurrent$builds$outside" ] && usage; }

# --costs (GT8.1, queue 170): the cost table, from the store of passes and the latest run's logs (.tmp/gate/NAME.mem),
# by test/gate/costs.ae on the tools' host; before the environment's scrub and gate_env: it runs nothing and keys nothing
if [ -n "$costs" ]; then
  . "$root/bin/lib/gate-cache.bash"
  . "$root/bin/lib/tools.bash"
  [ -n "$caller_host_exe" ] && export ARBACE_HOST_EXE=$caller_host_exe
  store=${ARBACE_GATE_STORE:-$(arbace_main_checkout "$root")/.tmp/gate-pass}
  arbace_tool -p "$root/test" -m gate.costs costs "$root" "$store" "$root/.tmp/gate" "$mode" "$costs_last" "$costs_fmt"
  exit
fi
# --mem-check (GTS227 (a)): every step's and part's declared :mem-gib against the peaks recorded, the store's passes and
# the committed clean records (test/gate/clean-*.edn): exit 1 when a step declares none or a recorded peak exceeds its
# declaration by the margin (test/gate/lanes.ae's mem-check; reads only, keys nothing; test/gate/lanes-test.bash holds
# the committed records to it)
if [ -n "$mem_check" ]; then
  . "$root/bin/lib/gate-cache.bash"
  . "$root/bin/lib/tools.bash"
  [ -n "$caller_host_exe" ] && export ARBACE_HOST_EXE=$caller_host_exe
  store=${ARBACE_GATE_STORE:-$(arbace_main_checkout "$root")/.tmp/gate-pass}
  GATE_ALL_PARTS=1 arbace_tool -p "$root/test" -m gate.lanes mem-check "$root" "$store" "$root"/test/gate/clean-*.edn
  exit
fi

# Queue 023 (report 022, finding 1): the caller's environment. A key holds a step's declared :env alone,
# so a variable the steps' tools read that changes a verdict (CLOJURE_TESTS_EXPECTED, FROZEN_JAR,
# REPR_JAVA_STALE_OK, JAVA_CHECK_LOAD, REPR_GO_READER, ARBACE_PATH, ...) would make a pass at a key that
# does not hold it, in the store the worktrees share. The rule: the tools' own variable families are
# dropped, as clean_launch drops them (ARBACE_*, GATE_*, J2G_*, REPR_*, JAVA_CHECK_*, CLOJURE_TESTS_*,
# GOI_*, FROZEN_*, JAVAC_*, BOX_*, JRT_*, GOCMP_*, NETHTTP_*, GOWHIM_*, TAMAGO_*, ORACLE_*, REAP_*,
# SMOKE_*, SURFACE*, the Go toolchain's GOFLAGS, GOROOT, GOOS, GOARCH, GOMEMLIMIT), but those that choose
# only where things are kept, how the steps are scheduled and locked, and how the audit and the report
# work (never what passes), and those a step of the table declares in :env (keyed; queue 085:
# gate_declared_env_of, test/gate/declared-env-test.bash): gate_keep_env. GATE_STEPS,
# GATE_PROG_UNITS and GATE_JAVAC_PROG_UNITS (the gate's own tests: a toy table, units given) are refused
# unless ARBACE_GATE_STORE names a store of their own. Not in the clean run (clean_launch drops its own
# list and passes FROZEN_JAR on, checked by the pins) nor --pins (it checks what it is given).
gate_keep_env() {
  case $1 in
    ARBACE_GOROOT|ARBACE_HEAVY_LOCK|ARBACE_HEAVY_HELD|ARBACE_GATE_STORE|ARBACE_GATE_EXES|ARBACE_GATE_KEEP|ARBACE_GATE_KEEP_DAYS) return 0 ;;
    ARBACE_GOCACHE_KEEP_MIN) return 0 ;;
    # re-review 020, finding 2: how long stage0_choose's bin/seed --link waits for the main checkout's stage 0 build
    ARBACE_SEED_LINK_WAIT) return 0 ;;
    GATE_HEAVY_CMD|GATE_TEST_JOBS|GATE_FRESH_G1|GATE_FULL_PARALLEL|GATE_FULL_SERIAL|GATE_CANARY|GATE_ALL_PARTS) return 0 ;;
    # GT8.4: which slice a night runs, the clock of --rotation-status (the gate's own tests), the clean run's corpora
    GATE_NIGHT|GATE_CLEAN_WHOLE|GATE_CLEAN_ROTATION) return 0 ;;
    # review 181, L6: the clock moved only for the gate's own tests, with a store of their own (as GATE_STEPS)
    GATE_NOW) [ -n "${ARBACE_GATE_STORE:-}" ] ;;
    GATE_CONCURRENT_HELD|GATE_CONCURRENT_LOCK|GATE_CPU_LOG|GATE_AUDIT_*) return 0 ;;
    # GTS227 (a): the memory lanes' scheduling (never what passes)
    GATE_LANES|GATE_MEM_BUDGET_GIB|GATE_MEM_RESERVE_GIB|GATE_LANE_BIG_GIB|GATE_LANE_POLL) return 0 ;;
    # (and the --plan view's durations: another store, more records of walls, the records first)
    GATE_LANES_STORE|GATE_LANES_RECORDS|GATE_LANES_PREFER) return 0 ;;
    GATE_STEPS|GATE_PROG_UNITS|GATE_JAVAC_PROG_UNITS) [ -n "${ARBACE_GATE_STORE:-}" ] ;;
    # queue 085 (report 084 finding 5, GTS112 (b)): a name a step of the table declares in :env, which its key
    # holds (plan.ae: "env NAME=VALUE" or "env NAME unset"): the frozen JVM's FROZEN_CP, FROZEN_TAG and
    # ARBACE_ORACLE_*, j2g-edge's J2G_FIXTURES and J2G_EDGE_WORK
    *) case " ${gate_declared_env-} " in *" $1 "*) return 0 ;; esac; return 1 ;;
  esac
}
# gate_declared_env_of TABLE: the names TABLE's steps declare in :env, one a line: the strings of every `:env [...]`
# outside strings and comments (read as the Clojure reader would: no stage 0 yet, the scrub runs before it)
gate_declared_env_of() {
  awk '{ b = b $0 "\n" }
    END {
      n = length(b); i = 1; inv = 0
      while (i <= n) {
        c = substr(b, i, 1)
        if (c == "\"") {
          j = i + 1
          while (j <= n && substr(b, j, 1) != "\"") { if (substr(b, j, 1) == "\\") j++; j++ }
          if (inv) print substr(b, i + 1, j - i - 1)
          i = j + 1; continue
        }
        if (c == ";") { while (i <= n && substr(b, i, 1) != "\n") i++; continue }
        if (c == "\\") { i += 2; continue }
        if (!inv && substr(b, i, 4) == ":env") {
          k = i + 4
          while (k <= n && substr(b, k, 1) ~ /[ \t\n,]/) k++
          if (substr(b, k, 1) == "[") { inv = 1; i = k + 1; continue }
        }
        if (inv && c == "]") inv = 0
        i++
      }
    }' "$1"
}
gate_scrub_env() {
  local v dropped=()
  for v in GATE_STEPS GATE_PROG_UNITS GATE_JAVAC_PROG_UNITS; do
    if [ -n "${!v+x}" ] && [ -z "${ARBACE_GATE_STORE:-}" ]; then
      echo "gate: $v is set (the gate's own tests: another table or the units given) but ARBACE_GATE_STORE is not: its passes would go into the shared store; set ARBACE_GATE_STORE to a store of its own, or unset $v" >&2
      exit 2
    fi
  done
  gate_declared_env=$(gate_declared_env_of "${GATE_STEPS:-$root/test/gate/steps.edn}" | tr '\n' ' ') || gate_declared_env=
  for v in $(compgen -e); do
    gate_keep_env "$v" && continue
    case $v in
      ARBACE_*|GATE_*|J2G_*|REPR_*|JAVA_CHECK_*|CLOJURE_TESTS_*|GOI_*|FROZEN_*|JAVAC_*|BOX_*|HEAVY_LOCK_*|JRT_*|GOCMP_*|NETHTTP_*|GOWHIM_*|TAMAGO_*|ORACLE_*|REAP_*|SMOKE_*|SURFACE*|GOFLAGS|GOROOT|GOOS|GOARCH|GOMEMLIMIT)
        unset "$v"; dropped+=("$v") ;;
    esac
  done
  [ ${#dropped[@]} -eq 0 ] || echo "gate: the environment's ${dropped[*]} dropped (no key holds them; doc/GATE-SURVEY.md, queue 023)" >&2
}
if [ -z "${GATE_CLEAN_INNER:-}" ] && [ -z "$pins" ] && { [ -z "$clean" ] || [ -n "$plan_only" ]; }; then
  gate_scrub_env
fi
. "$root/bin/lib/gate-run.bash"
. "$root/bin/lib/gate-cache.bash" # arbace_main_checkout, arbace_gate_exes
. "$root/bin/lib/tools.bash"

# ---- GT9 (doc/GATE-SURVEY.md, "As built: GT9 (write-ahead)"; GTS210 (a), GTS216 (a)): the crops' hosts as data and their
# light chains at night. Here, not in bin/lib/gate-run.bash, so that GT9 rekeys none of the four crops' steps (the runner and
# the planner are in every key): a host's identity reaches only the keys of the steps on that host, and the order the steps
# run in decides no outcome. The move into the runner, with :gcc's gate_gcc_id dropped, waits for its next change (Proposed
# GTS240). Between the markers below: test/gate/crops-test.bash extracts these functions.
# --- gt9-hosts begin
gate_host_expand() {  # gate_host_expand TOKEN: ${NAME:-DEFAULT} as NAME's value (else DEFAULT), {dir} as the recipe's :dir
  local t=$1 re='\$\{([A-Za-z_][A-Za-z0-9_]*):-([^}]*)\}' v
  while [[ $t =~ $re ]]; do v=${!BASH_REMATCH[1]:-${BASH_REMATCH[2]}}; t=${t/"${BASH_REMATCH[0]}"/$v}; done
  printf '%s' "${t//\{dir\}/${hdir:-}}"
}
gate_host_id() {  # gate_host_id RECIPE: a host's identity from its recipe (OP<TAB>ARG... lines, test/gate/steps.edn's :host-ids
  # as test/gate/crops.ae prints them): the SHA-256 of the items' lines; none when a :require command is missing
  local f=$1 line op x p g m hdir= a=()
  while IFS= read -r -u 3 line; do
    IFS=$'\t' read -r -a a <<< "$line"
    [ "${a[0]}" = require ] || continue
    for x in "${a[@]:1}"; do command -v "$(gate_host_expand "$x")" > "$TMPDIR/gate-host.which" || { echo none; return; }; done
  done 3< "$f"
  { while IFS= read -r -u 3 line; do
      IFS=$'\t' read -r -a a <<< "$line"; op=${a[0]}; a=("${a[@]:1}")
      for x in "${!a[@]}"; do a[$x]=$(gate_host_expand "${a[$x]}"); done
      case $op in
        require) ;;
        version) "${a[@]}" 2>"$TMPDIR/gate-host.err" | head -1 ;;
        version-any) "${a[@]}" 2>&1 | head -1 ;;
        lines) "${a[@]}" 2>"$TMPDIR/gate-host.err" ;;
        exe) sha256sum < "$(readlink -f "$(command -v "${a[0]}")")" | cut -c1-64 ;;
        prog) m=${a[0]}; p=$(readlink -f "$("${a[@]:1}" 2>"$TMPDIR/gate-host.err")" 2>"$TMPDIR/gate-host.err")
              if [ -f "$p" ]; then sha256sum < "$p" | cut -c1-64; else echo "$m"; fi ;;
        dir) hdir=$("${a[@]}" 2>"$TMPDIR/gate-host.err") ;;
        file) for g in "${a[@]}"; do
                m=0
                for p in $g; do [ -f "$p" ] && { sha256sum < "$p" | cut -c1-64; m=1; }; done
                [ $m = 1 ] || echo "missing $g"
              done ;;
        digest-list) awk '{print $2}' "$root/${a[0]}" 2>"$TMPDIR/gate-host.err" | while read -r p; do
                       if [ -f "$p" ]; then sha256sum "$p"; else echo "missing $p"; fi; done ;;
        *) echo "unknown $op" ;;
      esac
    done 3< "$f"; } | sha256sum | cut -c1-64
}
gate_host_ids() {  # gate_host_ids DIR: DIR/hosts.edn gains the :host-ids hosts a step names that plan_inputs does not write
  local d=$1 f h add=
  rm -rf "${d:?}/host-recipes"; mkdir -p "$d/host-recipes"
  arbace_tool -p "$root/test" -m gate.crops host-recipes "${GATE_STEPS:-$root/test/gate/steps.edn}" "$d/hosts.edn" \
    > "$d/host-recipes.tsv" 2> "$d/host-recipes.err" || { echo "gate: the hosts' recipes (test/gate/crops.ae):" >&2; cat "$d/host-recipes.err" >&2; return 1; }
  [ -s "$d/host-recipes.tsv" ] || return 0
  awk -F'\t' -v o="$d/host-recipes" '{ f = o "/" $1 ".tsv"; sub(/^[^\t]*\t/, ""); print > f }' "$d/host-recipes.tsv"
  for f in "$d"/host-recipes/*.tsv; do
    h=$(basename "$f" .tsv); add="$add :$h \"$(gate_host_id "$f")\""$'\n'
  done
  # the map's closing brace, the file's last character, after the new hosts
  { sed '$ s/}$//' "$d/hosts.edn"; printf '%s}\n' "$add"; } > "$d/hosts.edn.new" && mv "$d/hosts.edn.new" "$d/hosts.edn"
}
# --- gt9-hosts end
# plan_inputs (bin/lib/gate-run.bash) followed by the table's hosts, for every plan (run_plan, the audit's, the clean run's)
eval "gate_plan_inputs_base() $(declare -f plan_inputs | tail -n +2)"
plan_inputs() { gate_plan_inputs_base "$@" && gate_host_ids "$1"; }
# GTS216 (a): the :full chains run beside the serial run (test/gate/crops.ae's concurrent): none in the clean run (serial, §7),
# with GATE_FULL_PARALLEL (every chain at once already) or GATE_CROPS_CONCURRENT=0
gate_crop_chains() {
  [ -z "${GATE_CLEAN_INNER:-}" ] && [ -z "${GATE_FULL_PARALLEL:-}" ] && [ "${GATE_CROPS_CONCURRENT:-1}" != 0 ] || return 0
  arbace_tool -p "$root/test" -m gate.crops concurrent "${GATE_STEPS:-$root/test/gate/steps.edn}"
}

# ---- GT7 (doc/GATE-SURVEY.md, §7, "As built: GT7 (tooling)"): the clean run at a tag, the pins of
# what a clone cannot make fresh, the concurrent --full (GTS37 (a)). Here, not in bin/lib: none of it
# decides a step's outcome (the runner's audit_all, audit_compare and the :clean mark are
# bin/lib/gate-run.bash's), so no key holds it.

# GTS211 (a): the gated new crops' pins (test/gate/steps.edn's :crop-pins, one [CROP "WHAT" "COMMAND"] a line), read with awk:
# the clean run's pins step runs before stage 0 exists. A crop is gated when :crops has an entry for it with a step; the
# new crops are :budgets :new-crops's. Prints CROP<TAB>WHAT<TAB>COMMAND; test/gate/crops-test.bash compares it with
# test/gate/crops.ae's pins
gate_crop_pins_list() {  # gate_crop_pins_list TABLE
  awk '
    /^ :crops \{/ { incrops = 1 }
    incrops && /^ :budgets/ { incrops = 0 }
    incrops { s = $0; sub(/;.*/, "", s)
              while (match(s, /:[a-z][a-z0-9-]* \[[^]]*[a-z]/)) { k = substr(s, RSTART + 1, RLENGTH); sub(/ .*/, "", k); gated[k] = 1; s = substr(s, RSTART + RLENGTH) } }
    /:new-crops \[/ { s = $0; sub(/.*:new-crops \[/, "", s); sub(/\].*/, "", s); n = split(s, a, / +/); for (i = 1; i <= n; i++) { k = a[i]; sub(/^:/, "", k); if (k != "") isnew[k] = 1 } }
    /^ :crop-pins/ { inpins = 1; next }
    inpins && /^ :[a-z]/ { inpins = 0 }
    inpins && match($0, /\[:[a-z][a-z0-9-]* "[^"]*" "[^"]*"\]/) {
      e = substr($0, RSTART + 2, RLENGTH - 3); k = e; sub(/ .*/, "", k)
      sub(/^[^ ]* "/, "", e); w = e; sub(/" ".*/, "", w); c = e; sub(/^[^"]*" "/, "", c); sub(/"$/, "", c)
      line[++np] = k "\t" w "\t" c; key[np] = k }
    END { for (i = 1; i <= np; i++) if (isnew[key[i]] && gated[key[i]]) print line[i] }' "$1"
}
# clean_pins [FILE]: what the clean run takes from outside its clone, checked by its pins (§7):
# TamaGo's go (seed/goroot.sha256), jdk26u and the JDK build tree's platform (jdk/javac/platform.sha256),
# the frozen jar (test/oracle/frozen-jar.sha256, when FROZEN_JAR gives it: else the clone builds it from
# its tag and frozen_jar checks it), the system JDK (the reference javac, named by its version and its
# release file), $GOROOT/test (seed/goroot-test.sha256, GTS50 (a)), C's gcc and musl tarballs, test/c/host/, go-whim's commit and ccorpus2's module hash,
# the gated crops' :crop-pins commands (GTS211; C++'s pins and test/cpp/host/ among them, CX10); FILE gets them as a map. Exit 1 on a pin that fails
clean_pins() {
  local out=${1:-} st=0 g pv ph have gt tp jdk c jv jrel fj want got pd ft
  . "$root/bin/lib/seed-go.bash"
  g=$(seed_go_goroot)
  ph=$(grep -v '^#' "$seed_go_pin" | awk 'NF {print $1; exit}'); pv=$(grep -v '^#' "$seed_go_pin" | awk 'NF {print $2; exit}')
  have=$(seed_go_goroot_hash "$g") || have=none
  if [ "$have" = "$ph" ] && [ "$(head -1 "$g/VERSION")" = "$pv" ]; then echo "pins: TamaGo's go $g, $pv, its sources $(echo "$have" | cut -c1-16): seed/goroot.sha256's"
  else echo "pins: FAILED: TamaGo's go $g is $(head -1 "$g/VERSION" 2>"$TMPDIR/pins.err") with sources $have; seed/goroot.sha256 pins $pv, $ph"; st=1; fi
  # $GOROOT/test (GTS50 (a)): pinned by seed/goroot-test.sha256 (the steps that read it declare it)
  gt=$(seed_go_test_hash "$g" 2>"$TMPDIR/pins.err") || gt=none
  tp=$(grep -v '^#' "$root/seed/goroot-test.sha256" 2>"$TMPDIR/pins.err" | awk 'NF {print $1; exit}')
  if [ -n "$tp" ] && [ "$gt" = "$tp" ]; then echo "pins: \$GOROOT/test $(echo "$gt" | cut -c1-16) ($(cd "$g" && find test -type f | wc -l) files): seed/goroot-test.sha256's"
  else echo "pins: FAILED: \$GOROOT/test of $g is $gt; seed/goroot-test.sha256 pins ${tp:-nothing}"; st=1; fi
  . "$root/bin/lib/repr-java/judge.bash"
  jdk=$(judge_jdk_root 2>"$TMPDIR/pins.err") || { echo "pins: FAILED: $(cat "$TMPDIR/pins.err")"; st=1; jdk=${JDK:-/root/jdk26u}; }
  c=$(git -C "$jdk" rev-parse HEAD 2>"$TMPDIR/pins.err") || c=none
  if grep -q "^# .* at $c," "$root/jdk/javac/platform.sha256" 2>"$TMPDIR/pins.err" || grep -q "$c" "$root/jdk/javac/platform.sha256"; then
    echo "pins: jdk26u $jdk at $c: jdk/javac/platform.sha256's"
  else echo "pins: FAILED: jdk26u $jdk at $c, not jdk/javac/platform.sha256's commit"; st=1; fi
  pd=$root/.tmp/pins-platform
  if "$root/bin/javac-vendor" platform "$pd" > "$TMPDIR/pins-platform.log" 2>&1; then
    echo "pins: the JDK build tree's platform: its $(ls "$pd" | wc -l) modules jdk/javac/platform.sha256's"
  else echo "pins: FAILED: the JDK build tree's platform ($TMPDIR/pins-platform.log):"; grep -m3 'javac-vendor' "$TMPDIR/pins-platform.log" | sed 's/^/   /'; st=1; fi
  rm -rf "${pd:?}"
  jv=none jrel=none
  . "$root/bin/lib/java26.bash"
  if arbace_use_java26 && c=$(command -v javac); then
    jv=$(javac -version 2>&1 | head -1); c=$(readlink -f "$c")
    [ -f "${c%/bin/javac}/release" ] && jrel=$(sha256sum < "${c%/bin/javac}/release" | cut -c1-64)
    echo "pins: the system JDK (the reference javac): $jv, ${c%/bin/javac}, its release file $(echo "$jrel" | cut -c1-16)"
    case $jv in "javac 26"*) ;; *) echo "pins: FAILED: the reference runs (test/java/ref-jdk26.edn) are JDK 26's, the system JDK is $jv"; st=1 ;; esac
  else echo "pins: FAILED: no JDK 26 (ARBACE_FROZEN_JAVA_HOME, else jdk26u's own image, ${JDK:-/root/jdk26u}/build/linux-x86_64-server-release/images/jdk): the reference javac"; st=1; fi
  fj=none
  if [ -n "${FROZEN_JAR:-}" ]; then
    want=$(sed -n "s/^\([0-9a-f]\{64\}\)  $(basename "$FROZEN_JAR")\$/\1/p" "$root/test/oracle/frozen-jar.sha256")
    got=$(sha256sum < "$FROZEN_JAR" 2>"$TMPDIR/pins.err" | cut -c1-64)
    if [ -n "$want" ] && [ "$got" = "$want" ]; then fj=$FROZEN_JAR; echo "pins: the frozen jar $FROZEN_JAR: test/oracle/frozen-jar.sha256's"
    else echo "pins: FAILED: the frozen jar $FROZEN_JAR is ${got:-missing}, pinned ${want:-nothing for its name}"; st=1; fi
  else
    fj=built; echo "pins: the frozen jar: built in the checkout from its tag, checked by frozen_jar against test/oracle/frozen-jar.sha256"
  fi
  ft=$(git -C "$root" rev-parse -q --verify 'refs/tags/arbace-for-java-26-v1^{commit}' 2>"$TMPDIR/pins.err") || ft=none
  if [ "$ft" != none ]; then echo "pins: the frozen tree clojure/: arbace-for-java-26-v1 at $ft (extracted into .tmp/frozen by the checkout's git)"
  else echo "pins: FAILED: no tag arbace-for-java-26-v1 (the frozen clojure/)"; st=1; fi
  # C's (the user, 2026-11-02; doc/C23-SURVEY.md, "As built: C's full checks in the gate"): gcc 15.2.0's and musl 1.2.6's
  # tarballs against test/c/corpora.edn's SHA-256 (the copy the tools take: REPR_C_GCC_TARBALL or CI_MUSL_TARBALL, the
  # checkout's .tmp, then the main checkout's; none: the tool fetches it from the pin's URL and checks it there), and
  # test/c/host/'s recorded answers of the host's gcc (bin/repr-c host check: its predefined macros, the headers' digests)
  local ct cw ch=false cg=nil cm=nil
  c_tarball() { # KEY ENV-COPY CANDIDATE...: the tarball found and checked against corpora.edn's pin KEY
    local key=$1 env=$2 want f got; shift 2
    want=$(sed -n "/^ *{\\{0,1\\}:$key\$/,/:top/s/^ *:sha256 \"\([0-9a-f]*\)\"/\1/p" "$root/test/c/corpora.edn" | head -1)
    for f in $env "$@"; do [ -f "$f" ] && break; f=; done
    if [ -z "$f" ]; then echo "pins: $key's tarball: no copy here (the tool fetches it from test/c/corpora.edn's URL and checks it by the pin)"; echo nil > "$TMPDIR/pins-c.$key"; return 0; fi
    got=$(sha256sum < "$f" | cut -c1-64)
    printf '{:path "%s" :sha256 "%s"}\n' "$f" "$got" > "$TMPDIR/pins-c.$key"
    if [ -n "$want" ] && [ "$got" = "$want" ]; then echo "pins: $key's tarball $f: test/c/corpora.edn's"
    else echo "pins: FAILED: $key's tarball $f is $got, test/c/corpora.edn pins ${want:-nothing}"; return 1; fi
  }
  # the main checkout as the C tools find it (bin/repr-c gcc_tests, bin/lib/ci/musl): a worktree's or the clean run's
  # clone's (.tmp/gate-clean/SHA, its own .git: arbace_main_checkout names the clone itself there; queue 150)
  # (only the two known layouts stripped, so a main checkout under some other /.tmp/ is itself; queue 150, finding 3)
  cw=${root%%/.tmp/gate-clean/*}; cw=${cw%%/.tmp/worktrees/*}
  c_tarball gcc-15.2.0 "${REPR_C_GCC_TARBALL:-}" "$root/.tmp/repr-c/gcc-15.2.0.tar.xz" "$cw/.tmp/repr-c/gcc-15.2.0.tar.xz" || st=1
  c_tarball musl-1.2.6 "${CI_MUSL_TARBALL:-}" "$root/.tmp/ci-musl/musl-1.2.6.tar.gz" "$cw/.tmp/c1/musl/musl-1.2.6.tar.gz" || st=1
  cg=$(cat "$TMPDIR/pins-c.gcc-15.2.0"); cm=$(cat "$TMPDIR/pins-c.musl-1.2.6")
  # go-whim's commit (the C tools' checkout beside the main checkout, GOWHIM; the constant bin/repr-c's ccdump-build checks too:
  # test/c/corpora.edn's :go-whim-80c49bf5 :commit) and ccorpus2's module hash (Go's module cache, TamaGo's go: the ziphash
  # beside the download, against :ccorpus2-v1.6.0 :h1; no network)
  local gw gwh gwant mc cch ccwant
  gw=${GOWHIM:-$(cd "$cw/.." && pwd)/go-whim}
  gwant=$(sed -n '/^ *:go-whim-80c49bf5$/,/:root/s/.*:commit "\([0-9a-f]*\)".*/\1/p' "$root/test/c/corpora.edn" | head -1)
  gwh=$(git -C "$gw" rev-parse HEAD 2>"$TMPDIR/pins.err") || gwh=none
  if [ -n "$gwant" ] && [ "$gwh" = "$gwant" ]; then echo "pins: go-whim $gw at $gwh: test/c/corpora.edn's"
  else echo "pins: FAILED: go-whim $gw is at $gwh, test/c/corpora.edn pins ${gwant:-nothing}"; st=1; fi
  mc=$(GOFLAGS= "${ARBACE_GOROOT:-/root/tamago-go}/bin/go" env GOMODCACHE 2>"$TMPDIR/pins.err") || mc=none
  cch=$(cat "$mc/cache/download/modernc.org/ccorpus2/@v/v1.6.0.ziphash" 2>"$TMPDIR/pins.err") || cch=none
  ccwant=$(sed -n '/^ *:ccorpus2-v1.6.0$/,/:zip-sha256/s/^ *:h1 "\(h1:[^"]*\)".*/\1/p' "$root/test/c/corpora.edn" | head -1)
  if [ -n "$ccwant" ] && [ "$cch" = "$ccwant" ]; then echo "pins: modernc.org/ccorpus2 v1.6.0 in $mc: $cch, test/c/corpora.edn's"
  else echo "pins: FAILED: modernc.org/ccorpus2 v1.6.0 in $mc is $cch, test/c/corpora.edn pins ${ccwant:-nothing}"; st=1; fi
  if ct=$("$root/bin/repr-c" host check 2>&1); then ch=true; echo "pins: the host's gcc ($(gcc --version 2>"$TMPDIR/pins.err" | head -1)): test/c/host/'s answers ($(ls "$root/test/c/host/predefined" | wc -l) standards, $(wc -l < "$root/test/c/host/headers.sha256") headers)"
  else echo "pins: FAILED: the host's gcc against test/c/host/ (bin/repr-c host check):"; printf '%s\n' "$ct" | grep -v ': OK$' | head -5 | sed 's/^/   /'; st=1; fi
  # the oracles' packs (doc/ORACLE-RECORDS-SURVEY.md, ORS3 (a), ORS4 (a)): every pin of test/*/records/*.sha256 in the store
  # (ARBACE_ORACLE_PACKS, the main checkout's .tmp/oracle-packs by default) with its bytes and its members, and the
  # tampered-pack control (ORS7 (a))
  local op=false
  if "$root/bin/oracle-records" pins > "$TMPDIR/pins-oracle.log" 2>&1; then op=true; sed 's/^pins: //; s/^/pins: oracle-records: /' "$TMPDIR/pins-oracle.log"
  else echo "pins: FAILED: the oracles' packs (bin/oracle-records pins):"; grep 'FAILED' "$TMPDIR/pins-oracle.log" | head -5 | sed 's/^/   /'; st=1; fi
  # GTS211 (a): the gated new crops' pins verbs, each run in the checkout; recorded as :crops (absent while no new crop is gated)
  local crop what cmd cok crops_edn=
  esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
  gate_crop_pins_list "${GATE_STEPS:-$root/test/gate/steps.edn}" > "$TMPDIR/pins-crops.tsv"
  while IFS=$'\t' read -r crop what cmd; do
    if (cd "$root" && bash -c "$cmd") > "$TMPDIR/pins-crop.$crop.log" 2>&1; then cok=true; echo "pins: $crop: $what ($cmd)"
    else cok=false; st=1; echo "pins: FAILED: $crop: $what ($cmd; $TMPDIR/pins-crop.$crop.log):"; tail -5 "$TMPDIR/pins-crop.$crop.log" | sed 's/^/   /'; fi
    crops_edn="$crops_edn {:crop :$crop :what \"$(esc "$what")\" :cmd \"$(esc "$cmd")\" :ok $cok}"
  done < "$TMPDIR/pins-crops.tsv"
  [ -z "$crops_edn" ] || crops_edn=$'\n'"  :crops [${crops_edn# }]"
  [ -n "$out" ] && printf '{:go {:goroot "%s" :version "%s" :sources-sha256 "%s"} :goroot-test-sha256 "%s"\n  :jdk26u {:dir "%s" :commit "%s"} :system-jdk {:version "%s" :release-sha256 "%s"}\n  :frozen-jar "%s" :frozen-tree "%s"\n  :c {:gcc-tarball %s :musl-tarball %s :host-check %s :go-whim {:dir "%s" :commit "%s"} :ccorpus2 {:version "v1.6.0" :h1 "%s"}}%s\n  :oracle-packs %s :ok %s}\n' \
    "$g" "$pv" "$have" "$gt" "$jdk" "$(git -C "$jdk" rev-parse HEAD 2>"$TMPDIR/pins.err")" "$jv" "$jrel" "$fj" "$ft" "$cg" "$cm" "$ch" "$gw" "$gwh" "$cch" "$crops_edn" "$op" "$([ $st = 0 ] && echo true || echo false)" > "$out"
  [ $st = 0 ] && echo "pins: ok" || echo "pins: FAILED"
  return $st
}

# outside_pins (queue 023, report 022 finding 4): the trees outside the checkout that the keys know by their
# pins alone, checked against them by every ordinary gate before stage 0 (the clean run's pins step does it
# there): TamaGo's go, its sources' hash and VERSION (seed/goroot.sha256: the :go identity is its VERSION
# alone, and bin/seed checks the sources only when it builds), $GOROOT/test (seed/goroot-test.sha256: the
# steps that read it declare the pin, whose tree only --pins hashed), jdk26u's work tree clean of changes to
# tracked files when it is there (java-check's check_pin compares its commit alone). About 2-5 s. Exit 1 on
# a mismatch
outside_pins() {
  local st=0 g ph pv have gt tp jdk dirty
  . "$root/bin/lib/seed-go.bash"
  g=$(seed_go_goroot)
  ph=$(grep -v '^#' "$seed_go_pin" | awk 'NF {print $1; exit}'); pv=$(grep -v '^#' "$seed_go_pin" | awk 'NF {print $2; exit}')
  have=$(seed_go_goroot_hash "$g" 2>"$TMPDIR/outside-pins.err") || have=none
  if [ "$have" = "$ph" ] && [ "$(head -1 "$g/VERSION" 2>"$TMPDIR/outside-pins.err")" = "$pv" ]; then
    echo "outside: TamaGo's go $g, $pv, its sources seed/goroot.sha256's"
  else echo "outside: FAILED: TamaGo's go $g is $(head -1 "$g/VERSION" 2>"$TMPDIR/outside-pins.err") with sources $have; seed/goroot.sha256 pins $pv, $ph"; st=1; fi
  gt=$(seed_go_test_hash "$g" 2>"$TMPDIR/outside-pins.err") || gt=none
  tp=$(grep -v '^#' "$root/seed/goroot-test.sha256" 2>"$TMPDIR/outside-pins.err" | awk 'NF {print $1; exit}')
  if [ -n "$tp" ] && [ "$gt" = "$tp" ]; then echo "outside: \$GOROOT/test seed/goroot-test.sha256's"
  else echo "outside: FAILED: \$GOROOT/test of $g is $gt; seed/goroot-test.sha256 pins ${tp:-nothing}"; st=1; fi
  jdk=${JDK:-/root/jdk26u}
  if [ -e "$jdk/.git" ]; then
    dirty=$(git -C "$jdk" status --porcelain --untracked-files=no 2>&1 | head -5)
    if [ -z "$dirty" ]; then echo "outside: jdk26u $jdk, no change to its tracked files"
    else echo "outside: FAILED: jdk26u $jdk has changes to tracked files (the platform's pin names its commit): $(echo "$dirty" | tr '\n' ' ')"; st=1; fi
  else echo "outside: jdk26u: no checkout at $jdk (JDK; the steps that read it fail on their own)"; fi
  return $st
}

# the main checkout (git's common directory), as gate_env finds it
main_checkout() {
  arbace_main_checkout "$root"
}

# clean_launch: bin/gate [--full] --clean in the invoking checkout. A fresh `git clone --shared` of HEAD's
# commit in .tmp/gate-clean/SHA, its own empty .tmp/ and target/ and GOCACHE, the environment's Arbace
# and gate variables dropped but the caller's lock options (ARBACE_HEAVY_LOCK, GATE_HEAVY_CMD,
# ARBACE_HEAVY_HELD), GATE_TEST_JOBS, ARBACE_GOROOT and JDK; the clone's own bin/gate run in it with
# GATE_CLEAN_INNER=1 (below); then its record copied to test/gate/clean-TAG.edn, its logs to
# .tmp/gate-clean/SHA.logs/, its passes (marked :clean) into the store and its executables' directories
# into ARBACE_GATE_EXES where absent (GATE_CLEAN_PUBLISH=0: not), and the clone removed (on a failure
# kept, its Go cache removed; GATE_CLEAN_KEEP=1: kept)
# publish_passes FROM TO: the clean run's passes (FROM/NAME/KEY.{edn,log,inputs,out}) into the store TO:
# a pass TO holds already and that reads (pass_reads, its log's digest too: GTS95 (b)) is kept; one absent, empty or cut (GT7's rerun 4:
# written on a full disk, then kept by cp -an against rerun 5's) is replaced, its files through
# temporary names, the record last (GTS80 (a)); a FROM pass that does not read is not published
publish_passes() {
  local from=$1 to=$2 d n e k t f pub=0 rep=0 kept=0 bad=0
  for d in "$from"/*/; do
    [ -d "$d" ] || continue
    n=$(basename "$d")
    mkdir -p "$to/$n" || return 1
    for e in "$d"*.edn; do
      [ -f "$e" ] || continue
      k=$(basename "$e" .edn)
      pass_reads "$e" "$n" "$k" || { echo "   gate --clean: warning: $e does not read: not published" >&2; bad=$((bad + 1)); continue; }
      if pass_reads "$to/$n/$k.edn" "$n" "$k"; then kept=$((kept + 1)); continue; fi
      [ -e "$to/$n/$k.edn" ] && rep=$((rep + 1))
      t=$to/$n/.$k.pub.$$
      rm -rf "${t:?}".*
      for f in log inputs out; do
        [ -e "$d$k.$f" ] || continue
        cp -a "$d$k.$f" "$t.$f.tmp" && rm -rf "${to:?}/$n/$k.$f" && mv -T "$t.$f.tmp" "$to/$n/$k.$f" \
          || { rm -rf "${t:?}".*; echo "   gate --clean: warning: the pass $n/$k not published" >&2; continue 2; }
      done
      cp "$e" "$t.edn.tmp" && pass_reads "$t.edn.tmp" "$n" "$k" "$to/$n/$k.log" && mv -f "$t.edn.tmp" "$to/$n/$k.edn" \
        || { rm -rf "${t:?}".*; echo "   gate --clean: warning: the pass $n/$k not published" >&2; continue; }
      pub=$((pub + 1))
    done
  done
  echo "   $pub passes (:clean) published into $to ($rep of them replacing one that did not read), $kept there already$( [ "$bad" = 0 ] || echo ", $bad not reading not published")"
}
clean_launch() {
  local sha tag main common dir base st v keep=() unset=() frozen out t0 n d e store_to exes_to
  t0=$(date +%s)
  sha=$(git rev-parse HEAD) || return 1
  tag=${clean_tag:-${GATE_CLEAN_TAG:-$(git rev-parse --short=12 HEAD)}}
  case $tag in */*|"") echo "gate --clean: a tag names a file (test/gate/clean-TAG.edn): $tag" >&2; return 2 ;; esac
  [ -z "$(git status --porcelain --untracked-files=no 2>"$TMPDIR/gate-git.err")" ] \
    || echo "gate --clean: warning: the checkout has uncommitted changes; the clean run tests the commit $sha alone"
  main=$(main_checkout)
  common=$(git rev-parse --path-format=absolute --git-common-dir)
  base=${GATE_CLEAN_ROOT:-$root/.tmp/gate-clean}
  dir=$base/$sha out=$base/$sha.logs
  mkdir -p "$base" || return 1
  [ -e "$dir" ] && { chmod -R u+w "$dir" 2>"$TMPDIR/gate-clean.err"; rm -rf "${dir:?}"; }
  echo "== gate$( [ -n "$full" ] && echo ' --full') --clean: $(git log -1 --format='%h %s'), tag $tag, in $dir"
  # GT8.4, GTS204 (a): the clean run runs the compressed corpora (the subsets); the rest is the rotation's record,
  # which must be complete first (GATE_CLEAN_ROTATION=0: not checked, said in the record; GATE_CLEAN_WHOLE=1: whole parts)
  local rot=whole
  if [ -n "$full" ] && [ "${GATE_CLEAN_WHOLE:-}" != 1 ]; then
    if rotation_check --edn "$base/$sha.rotation.edn" > "$base/$sha.rotation.txt" 2>&1; then
      # review 181, finding 5: :none when no part rotates (every part ran whole), else :complete with its evidence
      rot=complete; grep -q ':status :none' "$base/$sha.rotation.edn" && rot=none
    elif [ "${GATE_CLEAN_ROTATION:-}" = 0 ]; then rot=unchecked; echo "   gate --clean: warning: the rotation's record is incomplete (GATE_CLEAN_ROTATION=0)"
    else
      sed 's/^/   /' "$base/$sha.rotation.txt"
      echo "== gate --clean FAILED: the rotation's record is incomplete (bin/gate --rotation-status; GATE_CLEAN_ROTATION=0 to run anyway)"; return 1
    fi
    sed 's/^/   /' "$base/$sha.rotation.txt"
  fi
  git clone -q --shared --no-checkout "$common" "$dir" && git -C "$dir" checkout -q --detach "$sha" \
    || { echo "gate --clean: the clone failed" >&2; return 1; }
  mkdir -p "$dir/.tmp/tmp" "$dir/.tmp/gocache"
  # --only (GT7's fix round): the record so far is the base; the rerun's logs beside the earlier runs'
  local only_env=() logs_name=$sha.logs i=1
  if [ -n "$only" ]; then
    [ -f "$root/test/gate/clean-$tag.edn" ] || { echo "gate --clean --only: no record test/gate/clean-$tag.edn to rerun steps of" >&2; return 2; }
    cp "$root/test/gate/clean-$tag.edn" "$dir/.tmp/clean-base.edn" || return 1
    while [ -e "$base/$logs_name" ]; do logs_name=$sha.logs.$i; i=$((i + 1)); done
    out=$base/$logs_name
    only_env=(GATE_CLEAN_ONLY="$only" GATE_CLEAN_BASE="$dir/.tmp/clean-base.edn" GATE_CLEAN_LOGS_ROOT="$base" GATE_CLEAN_LOGS_NAME="$logs_name")
    echo "   --only $only: the steps that failed or changed since test/gate/clean-$tag.edn's runs, merged into it"
  fi
  # GTS227 (a): the memory lanes (--concurrent): the clone's run schedules its steps by their declared memory, the big
  # lock held by this run (above) for its whole length
  local lanes_env=()
  [ -n "$lanes" ] && lanes_env=(GATE_LANES=1 GATE_HEAVY_CMD=env GATE_MEM_BUDGET_GIB="$GATE_MEM_BUDGET_GIB"
                                ${GATE_LANE_BIG_GIB:+GATE_LANE_BIG_GIB="$GATE_LANE_BIG_GIB"} ${GATE_LANE_POLL:+GATE_LANE_POLL="$GATE_LANE_POLL"})
  # the frozen jar: the main checkout's (pinned: the clone's pins step checks it), else the clone builds it
  frozen=${FROZEN_JAR:-$main/.tmp/oracle-frozen/arbace-for-java-26-v4.jar}
  [ -f "$frozen" ] || frozen=
  for v in $(compgen -e); do
    case $v in
      ARBACE_GOROOT|ARBACE_HEAVY_LOCK|ARBACE_HEAVY_HELD|GATE_HEAVY_CMD|GATE_TEST_JOBS) ;;
      ARBACE_*|GATE_*|J2G_*|REPR_*|JAVA_CHECK_*|CLOJURE_TESTS_*|GOI_*|FROZEN_*|JAVAC_*|BOX_*|HEAVY_LOCK_*|TMPDIR|GOCACHE|GOFLAGS|GOROOT|GOOS|GOARCH|GOMEMLIMIT) unset+=(-u "$v") ;;
    esac
  done
  env ${unset[@]+"${unset[@]}"} TMPDIR="$dir/.tmp/tmp" GOCACHE="$dir/.tmp/gocache" GATE_CLEAN_INNER=1 GATE_CLEAN_TAG="$tag" \
      GATE_CLEAN_ROTATION_STATUS="$rot" GATE_CLEAN_ROTATION_EDN="$base/$sha.rotation.edn" ${GATE_CLEAN_WHOLE:+GATE_CLEAN_WHOLE="$GATE_CLEAN_WHOLE"} \
      ARBACE_HEAVY_LOCK="${ARBACE_HEAVY_LOCK:-$main/.tmp/big.lock}" ${frozen:+FROZEN_JAR="$frozen"} ${only_env[@]+"${only_env[@]}"} \
      ${lanes_env[@]+"${lanes_env[@]}"} "$dir/bin/gate" ${full:+--full} --clean 2>&1 | tee "$base/$sha.out"
  st=${PIPESTATUS[0]}
  rm -rf "${out:?}"; mkdir -p "$out"
  for e in txt edn; do [ -f "$base/$sha.rotation.$e" ] && cp "$base/$sha.rotation.$e" "$out/rotation.$e"; done
  cp -a "$dir/.tmp/gate" "$out/gate" 2>"$TMPDIR/gate-clean.err"
  cp "$base/$sha.out" "$out/summary.txt"
  if [ -f "$dir/.tmp/gate/clean-record.edn" ]; then
    cp "$dir/.tmp/gate/clean-record.edn" "$root/test/gate/clean-$tag.edn"
    echo "   the record: test/gate/clean-$tag.edn"
  else
    echo "gate --clean: no record (the run stopped before its end: $out)"; st=1
  fi
  echo "   the logs: ${out#$root/}/"
  if [ "${GATE_CLEAN_PUBLISH:-1}" != 0 ]; then
    # the passes (:clean) into the store the everyday gate reads, beside its own (none replaced but one
    # that is empty or does not read, GTS80 (a): publish_passes); the executables and javac's tool, when
    # the run passed, into the shared directory where absent
    store_to=${ARBACE_GATE_STORE:-$main/.tmp/gate-pass} exes_to=$(arbace_gate_exes "$root")
    publish_passes "$dir/.tmp/gate-pass" "$store_to"
    # GT8.4: the clean run's rotated runs (a whole part's, GATE_CLEAN_WHOLE=1, is a run of every slice; the subsets')
    # appended to the shared store's record of the rotation
    # appended to the shared store's record of the rotation, renumbered after its sequence (review 181, finding 2: the
    # clone's runs are the later), under its lock
    local rf off cmax c
    if [ -d "$dir/.tmp/gate-pass/_rotation" ]; then
      mkdir -p "$store_to/_rotation"
      {
        flock 9
        off=$(cat "$store_to/_rotation/.seq" 2>"$TMPDIR/gate-clean.err" || echo 0)
        cmax=$(cat "$dir/.tmp/gate-pass/_rotation/.seq" 2>"$TMPDIR/gate-clean.err" || echo 0)
        for rf in "$dir/.tmp/gate-pass/_rotation"/*.runs "$dir/.tmp/gate-pass/_rotation"/*.failed; do
          [ -f "$rf" ] || continue
          case $rf in *.runs) c=8 ;; *) c=1 ;; esac
          awk -F'\t' -v OFS='\t' -v c="$c" -v o="$off" '{ $c = $c + o; print }' "$rf" >> "$store_to/_rotation/$(basename "$rf")" \
            && echo "   the rotation's $(basename "$rf") ($(wc -l < "$rf") lines) appended to $store_to/_rotation"
        done
        echo $((off + cmax)) > "$store_to/_rotation/.seq"
      } 9>>"$store_to/_rotation/.lock"
    fi
    if [ "$st" = 0 ]; then
      for e in "$dir/.tmp/gate-exe"/*; do
        [ -d "$e" ] || continue
        if [ -e "$exes_to/$(basename "$e")" ]; then echo "   the executables $(basename "$e") kept in $exes_to (there already)"
        else mkdir -p "$exes_to" && mv "$e" "$exes_to/" && echo "   the executables $(basename "$e") published into $exes_to"; fi
      done
    fi
  fi
  if [ "$st" = 0 ] && [ -z "${GATE_CLEAN_KEEP:-}" ]; then
    chmod -R u+w "$dir" 2>"$TMPDIR/gate-clean.err"; rm -rf "${dir:?}"; echo "   the clone removed"
  else
    rm -rf "${dir:?}/.tmp/gocache"
    echo "   the clone kept (its Go cache removed): $dir; rm -rf it when done"
  fi
  if [ "$st" = 0 ]; then echo "== gate --clean passed ($(secs "$t0"))"; else echo "== gate --clean FAILED ($(secs "$t0"))"; fi
  return "$st"
}

# clean_record: the clean run's record (test/gate/clean-TAG.edn, the Clojure reader's format): the
# commit, the pins, the hosts' identities, and each step's key, outcome, wall and CPU seconds, peaks,
# lock waits, audit and the programs its limits measured (GTS33 (a))
clean_record() {
  local n st s a ex k cpus prog
  echo ";; bin/gate$( [ -n "$full" ] && echo ' --full') --clean's record (doc/GATE-SURVEY.md, §7, GT7, \"As built: GT7 (tooling)\"):"
  echo ";; a fresh clone of the commit, empty caches, every step run and audited; written by bin/gate."
  printf '{:tag "%s"\n :commit "%s"\n :date "%s"\n :mode :%s\n :status :%s\n :wall-s %s\n' \
    "${GATE_CLEAN_TAG:-}" "$commit" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$mode" "$([ "$status" = 0 ] && echo passed || echo failed)" $(( $(date +%s) - start ))
  printf ' :host {:cpus %s :mem-kib %s :kernel "%s"}\n' "$(nproc)" "$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)" "$(uname -r)"
  printf ' :env {:all-parts true :forms-only true :heavy-cmd "%s"}\n' "$GATE_HEAVY_CMD"
  # GTS227 (a): the memory lanes' budget and big step, when the run used them (else serial)
  [ -n "${GATE_LANES:-}" ] && printf ' :lanes {:budget-gib %s :big-gib %s}\n' "$GATE_MEM_BUDGET_GIB" "${GATE_LANE_BIG_GIB:-16}"
  # GT8.4: the rotated parts (review 181, finding 5): :status :complete (the record checked first, its evidence:
  # rotation-status's period, each slice's covering run, from this commit's clean ancestors), :unchecked
  # (GATE_CLEAN_ROTATION=0, the evidence as found), :none (no part rotates: every part ran whole), :whole (GATE_CLEAN_WHOLE=1)
  local rs=${GATE_CLEAN_ROTATION_STATUS:-whole}
  if [ "$rs" = complete ] || [ "$rs" = unchecked ] && [ -s "${GATE_CLEAN_ROTATION_EDN:-}" ]; then
    printf ' :rotation {:status :%s :check %s}\n' "$rs" "$(cat "$GATE_CLEAN_ROTATION_EDN")"
  else
    printf ' :rotation {:status :%s}\n' "$rs"
  fi
  printf ' :pins %s\n' "$(cat "$logs/pins.edn" 2>"$logs/count.err" || echo nil)"
  printf ' :hosts %s\n' "$(cat "$logs/hosts.edn")"
  # GTS150 (a): the producers --only did not rerun whose outputs were copied from an earlier run's logs
  [ -s "$logs/reused.tsv" ] && printf ' :reused [%s]\n' "$(awk -F'\t' '{printf "%s{:step \"%s\" :from \"%s\"}", (NR > 1 ? " " : ""), $1, $2}' "$logs/reused.tsv")"
  printf ' :steps\n ['
  local first=1
  for n in pins "${order[@]}"; do
    [ -f "$logs/$n.status" ] || continue
    st=$(cat "$logs/$n.status"); ex=
    case $st in 0) s=:pass ;; skip) s=:skip ;; none) s=:not-needed ;; notrun*) s=:not-run ;; *) s=:fail ex=" :exit $st" ;; esac
    [ "$s" = :not-needed ] && continue
    a=:none
    if [ -f "$logs/$n.audit-status" ]; then
      case $(cat "$logs/$n.audit-status") in ok) a=:ok ;; step-failed) a=:step-failed ;; *) a="\"$(cat "$logs/$n.audit-status")\"" ;; esac
    fi
    # GT7's fix round: a stalled reducer (its watchdog killed the step)
    [ -f "$logs/$n.reduce.stalled" ] && a="\"reducer stalled: $(head -1 "$logs/$n.reduce.stalled" | tr -d '"')\""
    k=${key[$n]:-}; [ "$k" = - ] && k=
    prog=
    if [ -f "$logs/$n.cpu.tsv" ]; then
      prog=$(awk -F'\t' '{n++; c += $3 + $4; if ($1 == 124 || $1 == 137 || $1 == 152) t++} END {printf " :programs %d :programs-cpu-s %.1f :programs-timeouts %d", n, c, t}' "$logs/$n.cpu.tsv")
    fi
    [ -n "$first" ] || printf '\n  '
    first=
    # GTS227 (a): the step's declared memory, and with the lanes its lane and its start (seconds after the run's start)
    local lm= mg=${memgib[$n]:--}
    [ "$mg" = - ] || lm=" :mem-gib $mg"
    if [ -n "${GATE_LANES:-}" ] && [ -f "$logs/$n.start" ] && [ "$mg" != - ]; then
      lm="$lm :lane $(awk -v g="$mg" -v b="${GATE_LANE_BIG_GIB:-16}" 'BEGIN {print (g + 0 >= b + 0 ? 1 : 2)}') :start-s $(( $(cat "$logs/$n.start") - start ))"
    fi
    printf '{:step "%s" :kind :%s :status %s%s :key "%s" :wall-s %s :cpu-s %s :maxrss-kib %s :tree-peak-kib %s :wait-s %s :inner-wait-s %s :audit %s%s%s%s}' \
      "$n" "${kind[$n]:-pre}" "$s" "$ex" "$k" "$(mem_of "$n" wall-s)" "$(mem_of "$n" cpu-s)" "$(mem_of "$n" maxrss-kib)" "$(mem_of "$n" tree-peak-kib)" \
      "$(mem_of "$n" wait-s)" "$(mem_of "$n" inner-wait-s)" "$a" \
      "$( [ -f "$logs/$n.audit-aborts" ] && echo " :audit-aborts $(cat "$logs/$n.audit-aborts")")" "$prog" "$lm"
  done
  printf ']}\n'
}

# GT8.4, GTS204 (a): the rotation's record complete (bin/gate --rotation-status; gate.plan's rotation-status): every
# slice of every rotated part passed within the period, no file failed since
rotation_check() {
  # review 181 (the user's (a)): only this commit's ancestors' runs from clean trees count
  local anc=$TMPDIR/gate-ancestors.$$ st
  git rev-list HEAD > "$anc" || return 1
  arbace_tool -p "$root/test" -m gate.plan rotation-status "$root" "${ARBACE_GATE_STORE:-$(main_checkout)/.tmp/gate-pass}" \
    --ancestors "$anc" ${rot_days:+--days "$rot_days"} "$@"; st=$?
  rm -f "$anc"; return $st
}
if [ -n "$rotation_status" ]; then rotation_check; exit; fi
if [ -n "$pins" ]; then clean_pins "$pins_out"; exit; fi
if [ -n "$outside" ]; then outside_pins; exit; fi
# GTS227 (a), the memory lanes: --concurrent (and --clean --concurrent) schedules every step by its declared :mem-gib
# (bin/gate-lane: the budget GATE_MEM_BUDGET_GIB, default MemTotal less GATE_MEM_RESERVE_GIB 4; lane 1 the steps of
# GATE_LANE_BIG_GIB, 16, or more, one at a time; lane 2 the rest beside it), under the host's big lock held once for the
# whole run (bin/heavy-lock: its FIFO; GATE_CONCURRENT_HELD=1 or GATE_HEAVY_CMD=env: the caller holds it); GATE_LANES=0:
# GTS37 (a)'s one heavy step at a time on a lock of the gate's own (not with --clean)
lanes=
if [ -n "$concurrent" ]; then
  if [ "${GATE_LANES:-1}" != 0 ]; then
    lanes=1
    GATE_MEM_BUDGET_GIB=${GATE_MEM_BUDGET_GIB:-$(awk -v r="${GATE_MEM_RESERVE_GIB:-4}" '/^MemTotal:/ {b = int($2 / 1048576 - r); print (b < 1 ? 1 : b)}' /proc/meminfo)}
    export GATE_MEM_BUDGET_GIB
  elif [ -n "$clean" ]; then usage
  fi
  if [ -z "$plan_only" ] && [ -z "${GATE_CONCURRENT_HELD:-}" ] && [ "${GATE_HEAVY_CMD:-}" != env ]; then
    echo "== gate --full$( [ -n "$clean" ] && echo ' --clean') --concurrent: the host's big lock first (${ARBACE_HEAVY_LOCK:-$(main_checkout)/.tmp/big.lock}, in turn)"
    exec "$root/bin/heavy-lock" env GATE_CONCURRENT_HELD=1 "$root/bin/gate" "${orig_args[@]}"
  fi
fi
if [ -n "$clean" ] && [ -z "${GATE_CLEAN_INNER:-}" ]; then
  if [ -z "$plan_only" ]; then clean_launch; exit; fi
  # --clean --plan: the plan a clean run makes (an empty store and executables' directory, every part,
  # every check run), here, on this checkout's stage 0
  export ARBACE_GATE_STORE=$root/.tmp/gate-clean-plan/store ARBACE_GATE_EXES=$root/.tmp/gate-clean-plan/exes GATE_ALL_PARTS=1
  rm -rf "$root/.tmp/gate-clean-plan"; rerun=1
fi
# --concurrent (GTS37 (a)): --full's chains at once, the host's big lock held once from outside for the
# whole run (bin/heavy-lock: in turn; GATE_CONCURRENT_HELD=1 when the caller holds it already), the
# heavy steps and the tools' heavy processes serialized on a lock of the gate's own (GATE_CONCURRENT_LOCK,
# default .tmp/gate-concurrent.lock): one heavy process at a time, the light work beside it
if [ -n "$concurrent" ] && [ -z "$plan_only" ]; then
  export GATE_FULL_PARALLEL=1
  if [ -n "$lanes" ]; then
    # the lanes (GTS227 (a)): the admission is the lock; the big lock is this run's, so nothing locks again
    export GATE_LANES=1; GATE_HEAVY_CMD=env
  else
    unset ARBACE_HEAVY_HELD # the private lock below is the one the steps and the tools take
    GATE_HEAVY_CMD="flock ${GATE_CONCURRENT_LOCK:-$root/.tmp/gate-concurrent.lock}"
  fi
fi
# (the lanes are --concurrent's alone: a GATE_LANES of the caller's environment does not make an ordinary gate use them)
[ -n "$lanes" ] || [ -n "${GATE_CLEAN_INNER:-}" ] || unset GATE_LANES
gate_env || { echo "gate: the environment failed" >&2; exit 1; }
# the clean run itself (GATE_CLEAN_INNER=1, in the clone clean_launch made): passes not read (an empty
# store, every check run: --rerun), serial, every step under the audit, every part (GTS19 (a)), Java's
# levels on the read's cache forced (GTS41 (c)), the programs' CPU times measured (GTS33 (a))
audit_all= serial=
if [ -n "${GATE_CLEAN_INNER:-}" ]; then
  rerun=1 audit_all=1 serial=1
  export GATE_ALL_PARTS=1 JAVA_CHECK_FORMS_ONLY=1 GATE_CPU_LOG=1
  unset GATE_FULL_PARALLEL
  # GTS227 (a): the clean run in the memory lanes (bin/gate --full --clean --concurrent): the chains at once, every step
  # admitted by its declared memory (bin/gate-lane), the big lock the launcher's
  if [ "${GATE_LANES:-}" = 1 ]; then
    serial=; export GATE_FULL_PARALLEL=1 GATE_LANES GATE_MEM_BUDGET_GIB; GATE_HEAVY_CMD=env
  else
    unset GATE_LANES
  fi
fi

# GTS83 (a), review 001's fixes: the stage0 step in a linked worktree (git's common dir another checkout's .git).
# Its own target/seed when bin/seed --build would keep it; else the main checkout's linked into it (bin/seed --link:
# the executable hard-linked, seed.sha256 and pins copied, when bin/seed --kept says main's is the one --build would
# keep here: its pins line this worktree's, the seed, Go's pin, the scripts' digest, the toolchain's root, the
# architecture; the :stage0 host's identity; checked again after linking), so that the step's bin/seed --build keeps
# the worktree's own and main's rebuild cannot pull it away; else (not linked) the build as in the main checkout.
# Not in the clean run (a clone of its own, every step audited: its stage 0 built fresh)
stage0_cmd=(bin/seed --build --no-aot)
stage0_choose() {
  local m
  [ -z "${GATE_CLEAN_INNER:-}" ] || return 0
  m=$(main_checkout)
  [ "$(cd "$m" && pwd -P)" != "$(pwd -P)" ] || return 0
  # GTS101 (b): bin/seed's stderr (its "waiting for CHECKOUT's stage 0 build" line, re-review 020's finding 2:
  # up to ARBACE_SEED_LINK_WAIT s) printed as it comes, so that a gate waiting for the main checkout's rebuild
  # says so; its stdout (the outcome) after, as before
  bin/seed --link "$m/target/seed" 2>&1 > "$TMPDIR/gate-stage0-link.txt" \
    | while IFS= read -r l; do printf '     %s\n' "$l"; done
  grep -v 'nothing linked' "$TMPDIR/gate-stage0-link.txt" | sed 's/^/     /'
}

if [ -n "$prune" ]; then gate_prune $dry; exit; fi
if [ -n "$audit" ]; then
  stage0_choose
  "${stage0_cmd[@]}" > "$root/.tmp/gate-audit-stage0.log" 2>&1 || { tail -5 "$root/.tmp/gate-audit-stage0.log"; exit 1; }
  rm -f "${GATE_AUDIT_DIR:-$root/.tmp/gate-audit}"/*.reduce.stalled
  gate_audit "${steps_arg[@]}"; st=$?
  for f in "${GATE_AUDIT_DIR:-$root/.tmp/gate-audit}"/*.reduce.stalled; do
    [ -f "$f" ] && { echo "AUDIT STALLED $(basename "$f" .reduce.stalled): $(cat "$f")"; st=1; }
  done
  exit $st
fi
if [ -n "$plan_only$why" ]; then
  d=$root/.tmp/gate-plan
  rm -rf "${d:?}"
  if [ -n "$why" ]; then
    run_plan "$d" > "$d.txt" 2>&1 || { cat "$d.txt"; exit 1; }
    arbace_tool -p "$root/test" -m gate.plan why "$root" "$d" "$store" "$why"
  elif [ -n "$builds" ]; then
    # --plan --builds (GTS42 (a)'s demonstrations): the builds the plan needs (go-build, with --full
    # javac-tool), run as the gate runs them, then the plan again on their program units
    echo "== gate$( [ -n "$full" ] && echo ' --full') --plan --builds: $(git log -1 --format='%h %s'), store $store"
    logs=$d
    run_plan "$d" > "$d.first.txt" 2>&1 || { cat "$d.first.txt"; exit 1; }
    load_plan
    for n in "${order[@]}"; do
      [ "${kind[$n]}" = build ] && [ "${dec[$n]}" = build ] || continue
      run_one "$n"; report "$n"
      ok_status "$n" || { tail -20 "$d/$n.log"; exit 1; }
    done
    rm -f "$d"/*.done
    run_plan "$d"
  else
    echo "== gate$( [ -n "$nightly" ] && echo ' --nightly' || { [ -n "$full" ] && echo ' --full'; })$( [ -n "$clean" ] && echo ' --clean')$( [ -n "$concurrent" ] && echo ' --concurrent') --plan: $(git log -1 --format='%h %s'), store $store"
    run_plan "$d" ${rerun:+--rerun} || exit 1
    # GTS216 (a): the chains a --full or --nightly would run beside its serial run (said only when there are some)
    if [ -n "$full" ] && [ -z "$clean" ] && [ -z "$concurrent" ]; then
      cc=$(gate_crop_chains | tr '\n' ' ')
      [ -z "$cc" ] || echo "   the crops' chains beside the serial run (GTS216 (a)): $cc"
    fi
    # GTS227 (a): the lanes the run would use, each step's lane and a simulated schedule (durations: the main store's
    # passes, GATE_LANES_STORE's, else the newest clean record's, the committed ones and GATE_LANES_RECORDS' files, a
    # record of estimates among them; GATE_LANES_PREFER=clean: the records first)
    if [ -n "$lanes" ]; then
      read -r -a extra <<< "${GATE_LANES_RECORDS:-}"
      arbace_tool -p "$root/test" -m gate.lanes view "$d" "${GATE_LANES_STORE:-$(main_checkout)/.tmp/gate-pass}" \
        "$GATE_MEM_BUDGET_GIB" "${GATE_LANE_BIG_GIB:-16}" "$root"/test/gate/clean-*.edn ${extra[@]+"${extra[@]}"}
    fi
  fi
  exit
fi

logs=$root/.tmp/gate
rm -rf "${logs:?}"
mkdir -p "$logs"
start=$(date +%s)
status=0
commit=$(git rev-parse HEAD 2>"$TMPDIR/gate-git.err" || echo unknown)
dirty=false; [ -z "$(git status --porcelain --untracked-files=no 2>"$TMPDIR/gate-git.err")" ] || dirty=true

echo "== gate$( [ -n "$nightly" ] && echo ' --nightly' || { [ -n "$full" ] && echo ' --full'; }): $(git log -1 --format='%h %s')"
# Go's build cache, trimmed by every gate run (bin/lib/gocache.bash)
. "$root/bin/lib/gocache.bash"
gocache_trim

sampler &
sampler_pid=$!
trap 'kill "$sampler_pid" 2>"$logs/sampler.err"' EXIT

# GT7's fix round: a reducer's watchdog that found it stalled (tools/gateaudit/watch.go) left NAME.reduce.stalled
# beside the step's FIFO and killed the step: said loudly in the summary, and the gate fails
stall_report() {
  local f n
  for f in "$logs"/*.reduce.stalled; do
    [ -f "$f" ] || continue
    n=$(basename "$f" .reduce.stalled)
    echo "   AUDIT STALLED  $n: $(cat "$f") (the reducer's watchdog killed the step; $logs/$n.reduce.err)"
    status=1
  done
}
# --clean --only (GT7's fix round): which steps this rerun runs (test/gate/clean.ae's select, against the base
# record and the logs of its runs): MODE builds after the first plan (a build no selected check needs is not
# made), checks once the builds are made (a check not selected skipped on its clean pass, and the run stopped
# when one of them changed since)
only_apply() {
  local m=$1 d n w
  arbace_tool -p "$root/test" -m gate.clean select "$root" "$logs" "$GATE_CLEAN_BASE" "$GATE_CLEAN_LOGS_ROOT" "$GATE_CLEAN_ONLY" "$m" \
    > "$logs/only-$m.tsv" 2> "$logs/only-$m.err"
  local st=$?
  if [ $st != 0 ]; then
    grep '^error' "$logs/only-$m.tsv" | cut -f3; cat "$logs/only-$m.err"; echo "== gate FAILED: --only's selection ($(secs "$start"))"; exit 1
  fi
  local src
  while IFS=$'\t' read -r d n w src; do
    case $d in
      none) dec[$n]=none ;;
      skip) dec[$n]=skip; why[$n]=$w; echo "$w" > "$logs/$n.why"; echo skip > "$logs/$n.status"; touch "$logs/$n.done" ;;
      # GTS150 (a): a producer not rerun, its clean output (digests checked by the selection) copied whole from the
      # logs of the run it passed at into this run's out/, where its consumers read it and are keyed over it
      reuse)
        rm -rf "${logs:?}/out/$n"; mkdir -p "$logs/out"
        if [ -z "$src" ] || ! cp -a "$src" "$logs/out/$n" 2>"$logs/$n.reuse.err" || ! diff -rq "$src" "$logs/out/$n" >> "$logs/$n.reuse.err" 2>&1; then
          echo "   FAILED  $n: its output not copied from ${src:-(no source)} ($logs/$n.reuse.err)"
          echo "== gate FAILED: --only's reuse of $n's output ($(secs "$start"))"; exit 1
        fi
        printf '%s\t%s\n' "$n" "${src#"$GATE_CLEAN_LOGS_ROOT"/}" >> "$logs/reused.tsv"
        dec[$n]=skip; why[$n]=$w; echo "$w" > "$logs/$n.why"; echo skip > "$logs/$n.status"; touch "$logs/$n.done" ;;
    esac
  done < "$logs/only-$m.tsv"
  echo "   ok  --only $GATE_CLEAN_ONLY ($m): $(grep -c '^run' "$logs/only-$m.tsv") to run, $(grep -c '^skip\|^none\|^reuse' "$logs/only-$m.tsv") not, $(grep -c '^reuse' "$logs/only-$m.tsv") of them with their outputs reused ($logs/only-$m.tsv)"
}

# the clean run (GT7): first what it takes from outside the clone, by its pins; the audit's reducer
if [ -n "${GATE_CLEAN_INNER:-}" ]; then
  pre_step pins '^pins:' 12 "$root/bin/gate" --pins "$logs/pins.edn"
  audit_reducer "$root/.tmp/gate-audit"
fi
# before the plan, one after the other: each needs the one before (steps.edn's :pre)
pre_step makefile - 0 make -s check-makefile
pre_step seed 'pinned' 1 bin/seed --check
# queue 023, report 022 finding 4: the trees outside the checkout against their pins (the clean run's pins step above)
[ -n "${GATE_CLEAN_INNER:-}" ] || pre_step outside '^outside:' 3 "$root/bin/gate" --outside-pins
stage0_choose
audit_step=${audit_all:+1} pre_step stage0 'bin/seed: .*arbace|stage 0 in|stage 0 kept' 2 "${stage0_cmd[@]}"
# the plan (GT2): each step's key, run or skipped
t0=$(date +%s)
if ! run_plan "$logs" ${rerun:+--rerun} > "$logs/plan.log" 2>&1; then
  cat "$logs/plan.log"; echo "== gate FAILED: no plan ($(secs "$start"))"; exit 1
fi
load_plan
echo "   ok  plan ($(secs "$t0"); store $store; .tmp/gate/plan.log)"
# GTS53 (a): stage 0's own build, traced above (the clean run), against its declarations (the plan's files)
if [ -n "$audit_all" ]; then
  audit_compare stage0 0
  if [ "$(cat "$logs/stage0.audit-status")" != ok ]; then
    grep -A8 '^UNDECLARED' "$logs/stage0.audit" | sed 's/^/     /'
    echo "== gate FAILED: stage0's audit is $(cat "$logs/stage0.audit-status") ($logs/stage0.audit)"; exit 1
  fi
  echo "   ok  stage0's audit"
fi
sed -n '1p' "$logs/plan.log" | sed 's/^/     /'
[ -n "${GATE_CLEAN_ONLY:-}" ] && only_apply builds

# the builds (go-build; with --full javac-tool), one after the other, when needed: all of them before
# the checks (GT5), so that the program hosts' units are known to a second plan
built=
for n in "${order[@]}"; do
  [ "${kind[$n]}" = build ] || continue
  [ "${dec[$n]}" = build ] && built=1
  run_one "$n"; report "$n"
  if ! ok_status "$n" && [ "${dec[$n]}" = build ]; then
    tail -20 "$logs/$n.log"; echo "== gate FAILED ($(secs "$start"))"; exit 1
  fi
done
# the second plan (GT5): a check on a program host (:prog, :javac-prog) whose build was not there was
# planned to run; now its identity is the build's units, and it may be skipped
if [ -n "$built" ]; then
  cp "$logs/plan.tsv" "$logs/plan1.tsv"; cp "$logs/plan.log" "$logs/plan1.log"
  t0=$(date +%s)
  if ! run_plan "$logs" ${rerun:+--rerun} > "$logs/plan.log" 2>&1; then
    cat "$logs/plan.log"; echo "== gate FAILED: no second plan ($(secs "$start"))"; exit 1
  fi
  load_plan
  echo "   ok  plan, again after the builds ($(secs "$t0"); .tmp/gate/plan.log, the first .tmp/gate/plan1.log)"
  sed -n '1p' "$logs/plan.log" | sed 's/^/     /'
fi
[ -n "${GATE_CLEAN_ONLY:-}" ] && only_apply checks

# the essential checks, concurrently on the cached executables. The heavy ones (the whole-program
# j2g runs, the suite's 12 processes) take the heavy lock each, one at a time (GT6: it replaces
# bin/j2g's J2G_LOCK here), the light ones run beside them
if [ -n "$serial" ]; then
  # the clean run: one after another in the table's order (§7)
  for n in $(names_of essential); do run_one "$n"; done
else
  pids=()
  for c in $(chains_of essential); do run_chain essential "$c" & pids+=($!); done
  wait "${pids[@]}"
fi
for n in $(names_of essential); do [ "${kind[$n]}" = build ] || report "$n"; done
stall_report

if [ -n "$full" ]; then
  if [ -n "${GATE_FULL_PARALLEL:-}" ]; then
    pids=()
    for c in $(chains_of full); do run_chain full "$c" & pids+=($!); done
    wait "${pids[@]}"
  else
    # GTS216 (a): the new crops' light chains beside the serial run (none: the serial run alone, as before)
    cchains=" $(gate_crop_chains | tr '\n' ' ')" cpids=()
    for c in $cchains; do run_chain full "$c" & cpids+=($!); done
    for n in $(names_of full); do case $cchains in *" ${chain[$n]} "*) continue ;; esac; run_one "$n"; done
    [ ${#cpids[@]} -eq 0 ] || wait "${cpids[@]}"
  fi
  for n in $(names_of full); do [ "${kind[$n]}" = build ] || report "$n"; done
  stall_report
  # GTS34 (a): the store trimmed at the end of every --full (seconds)
  gate_prune > "$logs/prune.log" 2>&1 || echo "gate: warning: the store's prune failed ($logs/prune.log)"
  tail -1 "$logs/prune.log" | sed 's/^/   /'
fi
ran=0 skipped=0
for n in "${order[@]}"; do
  case $(cat "$logs/$n.status" 2>"$logs/count.err") in skip) skipped=$((skipped + 1)) ;; none) ;; ?*) ran=$((ran + 1)) ;; esac
done
peak=$(awk -F'\t' '$2 == "gate" && $3 > m {m = $3} END {print m + 0}' "$logs/mem.tsv" 2>"$logs/count.err")
low=$(awk -F'\t' '$2 == "MemAvailable" && (m == "" || $3 < m) {m = $3} END {print m + 0}' "$logs/mem.tsv" 2>"$logs/count.err")
echo "   $ran steps run, $skipped skipped; the gate's processes at most $(gib "$peak"), the host's MemAvailable at least $(gib "$low") (.tmp/gate/mem.tsv)"
if [ -n "${GATE_CLEAN_INNER:-}" ]; then
  clean_record > "$logs/clean-record.edn"
  # --only: the record merged with the base's (the steps of earlier runs kept, each with its run)
  if [ -n "${GATE_CLEAN_ONLY:-}" ]; then
    mv "$logs/clean-record.edn" "$logs/clean-record.run.edn"
    arbace_tool -p "$root/test" -m gate.clean merge "$GATE_CLEAN_BASE" "$logs/clean-record.run.edn" "$GATE_CLEAN_ONLY" \
      "${GATE_CLEAN_LOGS_NAME:-}" "$logs/clean-record.edn" "$root" | sed 's/^/   /'
  fi
fi
if [ $status = 0 ]; then echo "== gate passed ($(secs "$start"))"; else echo "== gate FAILED ($(secs "$start"))"; fi
exit $status

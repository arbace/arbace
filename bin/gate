#!/bin/bash
# The gate: the checks a change must pass before it is committed to main.
#
# Usage: bin/gate [--full]
#   (default)  the essential gate:
#                1. bin/seed --check                the seed is the pinned one
#                2. bin/build-arbace                the bootstrap: stages 1-3 (2 = 3 byte for
#                                                   byte), the verifier, the native tests, the
#                                                   jar and the AOT cache
#                3. concurrently:
#                   suite-stage2  Clojure's test suite on stage 2, the stage the jar ships
#                   cft           bin/class-forms-tests
#   --full     also, concurrently with step 3:
#                   suite-stage1  Clojure's suite on stage 1 (built by the seed's compiler; it
#                                 matters when stage 1 differs from stage 2)
#                   j2c           bin/j2c-check --suite (the converter on the frozen clojure/
#                                 and its samples, and Clojure's suite on the converted baseline)
#                   g2c           bin/g2c roundtrip amd64, then linux/amd64 (B1a's target): Go ->
#                                 forms -> Go over std and $GOROOT/test, against
#                                 test/g2c/roundtrip-amd64.edn and roundtrip-linux-amd64.edn;
#                                 one after the other, since two converters at once exhaust
#                                 the memory beside the suites; needs TamaGo's go, G2C_GOROOT
#                   go            the Go build on amd64 (doc/go/EVAL-NOTES.md), one chain:
#                     jrt-convert   bin/jrt-convert (jrt's JDK sources into .tmp/jrt/conv)
#                     go-build      ARBACE_GO_ARCHES=amd64 bin/arbace-go --build
#                     then concurrently:
#                     go-smoke      ARBACE_GO_ARCHES=amd64 bin/arbace-go --smoke
#                     suite-go      Clojure's suite on the Go build, against
#                                   test/arbace-go-results.edn
#                     oracle-go     bin/oracle check on the Go build, against its known
#                                   mismatches, test/oracle/known-go-amd64.edn
#                   (arm64, under qemu, stays out: its suite takes hours)
#              g2c and the go chain start, concurrently, when suite-stage1, suite-stage2 and
#              j2c (whose suite runs on the converted baseline) are done: their converters
#              beside the three suites exhaust the memory
# The suite on stage 1 is not essential: the build requires stage 2 = stage 3, and reports
# whether stage 1 = stage 2; when they are equal, the suite on stage 1 tests the same classes.
# With --full the gate first trims Go's build cache of entries unused for a day (Go itself keeps
# them five days; c2g's programs and the round trips fill it by tens of GB a day).
# Logs go to .tmp/gate/NAME.log; the summary prints each check's outcome and wall time.
# Environment: GATE_TEST_JOBS, parallel test JVMs of each suite run (default 24; the concurrent
#   runs share the machine), and what the scripts above read (ARBACE_JVM_OPTS, J2C_JVM_OPTS).
# Exit status: 0 when every check passed.
set -uo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"
full=
case ${1:-} in
  "") ;;
  --full) full=1 ;;
  *) echo "usage: bin/gate [--full]" >&2; exit 2 ;;
esac
logs=$root/.tmp/gate
rm -rf "$logs"
mkdir -p "$logs"
jobs=${GATE_TEST_JOBS:-24}
start=$(date +%s)
secs() { local s=$(( $(date +%s) - $1 )); printf '%dm%02ds' $((s / 60)) $((s % 60)); }
summary() { grep -E "$2" "$logs/$1.log" | tail -${3:-2} | sed 's/^/     /'; }

echo "== gate$( [ -n "$full" ] && echo ' --full'): $(git log -1 --format='%h %s')"
if [ -n "$full" ]; then
  # Go refreshes an entry's time when it uses it (at most hourly), so a day is safe for runs in
  # progress; GOCACHE as Go resolves it
  gocache=$(go env GOCACHE 2>/dev/null || true)
  if [ -n "$gocache" ] && [ -d "$gocache" ]; then
    before=$(du -sm "$gocache" | cut -f1)
    find "$gocache" -type f -mmin +1440 -delete 2>/dev/null || true
    find "$gocache" -mindepth 1 -type d -empty -delete 2>/dev/null || true
    echo "   Go build cache trimmed: $before MB -> $(du -sm "$gocache" | cut -f1) MB"
  fi
fi
t=$(date +%s)
if ! bin/seed --check > "$logs/seed.log" 2>&1; then
  cat "$logs/seed.log"; echo "== gate FAILED: the seed"; exit 1
fi
if ! bin/build-arbace > "$logs/build.log" 2>&1; then
  tail -20 "$logs/build.log"; echo "== gate FAILED: bin/build-arbace (log $logs/build.log)"; exit 1
fi
echo "   ok  build ($(secs "$t"))"
summary build 'identical|differ|^Ran|failures' 4

suite() {  # suite N: Clojure's suite on stage N, as bin/build-arbace --suite runs it
  CLOJURE_TESTS_RENAME=arbace CLOJURE_TESTS_RUN=stage$1 CLOJURE_SRC="$root/target/stage$1:$root" \
    CLOJURE_TESTS_PRECOMPILED=1 bin/clojure-tests -j "$jobs"
}
step() {  # step NAME COMMAND...: one check of the go chain, logged as launch logs its checks
  local name=$1 t0; shift; t0=$(date +%s)
  "$@" > "$logs/$name.log" 2>&1
  local st=$?
  echo $st > "$logs/$name.status"; echo $(( $(date +%s) - t0 )) > "$logs/$name.secs"
  return $st
}
go_chain() {  # the Go build on amd64, then its three checks concurrently
  step jrt-convert bin/jrt-convert || return 1
  step go-build env ARBACE_GO_ARCHES=amd64 bin/arbace-go --build || return 1
  step go-smoke env ARBACE_GO_ARCHES=amd64 bin/arbace-go --smoke &
  step suite-go env CLOJURE_TESTS_GO="$root/target/arbace-go/amd64/arbace" bin/clojure-tests -j 12 &
  # --timeout: the reducers file takes about 285 s of the default 300 (EVAL-NOTES.md, part 4)
  step oracle-go bin/oracle check 'target/arbace-go/amd64/arbace -' --timeout 900 \
    --expected test/oracle/known-go-amd64.edn &
  wait
}
converters() {  # g2c and the go chain, once the three suites are done: a converter (g2c's
  # takes up to 12 GB, jrt-convert's 8) beside the suites (up to 43 GB at once, 24 JVMs each)
  # exhausts the memory (the OOM killer took g2c's in both runs of 2026-10-09 that tried)
  until [ -f "$logs/suite-stage1.status" ] && [ -f "$logs/suite-stage2.status" ] \
          && [ -f "$logs/j2c.status" ]; do sleep 2; done
  step g2c sh -c 'bin/g2c roundtrip amd64 && bin/g2c roundtrip linux/amd64' &
  go_chain &
  wait
}
declare -A pids starts
launch() {  # launch NAME COMMAND...
  local name=$1; shift
  starts[$name]=$(date +%s)
  ( "$@" > "$logs/$name.log" 2>&1; echo $? > "$logs/$name.status"; echo $(( $(date +%s) - ${starts[$name]} )) > "$logs/$name.secs" ) &
  pids[$name]=$!
}
launch suite-stage2 suite 2
launch cft bin/class-forms-tests
if [ -n "$full" ]; then
  launch suite-stage1 suite 1
  launch j2c env J2C_TEST_JOBS="$jobs" bin/j2c-check --suite
  launch converters converters
fi
report() {  # report NAME: a check's outcome, wall time and summary lines
  local name=$1
  if [ ! -f "$logs/$name.status" ]; then
    echo "   FAILED  $name (not run: an earlier step failed)"; status=1; return
  fi
  s=$(cat "$logs/$name.secs"); w=$(printf '%dm%02ds' $((s / 60)) $((s % 60)))
  if [ "$(cat "$logs/$name.status")" = 0 ]; then
    echo "   ok  $name ($w)"
  else
    echo "   FAILED  $name ($w; log $logs/$name.log)"; status=1
  fi
  case $name in
    suite-*|j2c) summary "$name" 'TOTAL|regressions' ;;
    g2c) summary g2c '^package|^test |regressions' 6 ;;
    cft) summary cft '^Ran|failures' ;;
    jrt-convert) summary jrt-convert . 1 ;;
    go-build) summary go-build . 1 ;;
    go-smoke) summary go-smoke 'ok|FAIL' 1 ;;
    oracle-go) summary oracle-go '^== ' ;;
  esac
}
status=0
for name in suite-stage2 cft ${full:+suite-stage1 j2c converters}; do
  wait "${pids[$name]}"
  if [ "$name" = converters ]; then
    for g in g2c jrt-convert go-build go-smoke suite-go oracle-go; do report "$g"; done
  else
    report "$name"
  fi
done
if [ $status = 0 ]; then echo "== gate passed ($(secs "$start"))"; else echo "== gate FAILED ($(secs "$start"))"; fi
exit $status

#!/bin/bash
# The gate: the checks a change must pass before it is committed to main.
#
# Usage: bin/gate [--full]
#   (default)  the essential gate:
#                1. bin/seed --check                the seed is the pinned one
#                2. bin/build-arbace                the bootstrap: stages 1-3 (2 = 3 byte for
#                                                   byte), the verifier, the native tests, the
#                                                   jar and the AOT cache
#                3. concurrently:
#                   suite-stage2  Clojure's test suite on stage 2, the stage the jar ships
#                   cft           bin/class-forms-tests
#                   go            bin/arbace-go --gate: the Go executable's smoke test (amd64,
#                                 seconds) on the executable cached in .tmp/arbace-go-gate,
#                                 built again only when what it is built from changed (its key:
#                                 the hash of Arbace's sources, go/, overlay/, the build's
#                                 scripts and toolchains): then bin/jrt-convert's conversion,
#                                 a2g, the Go build and the image, about 5 minutes beside the
#                                 suite (doc/go/EXEC-NOTES.md); needs TamaGo's go, G2A_GOROOT.
#                                 Not with --full, whose go chain builds and smoke-tests anew
#   --full     also, concurrently with step 3:
#                   suite-stage1  Clojure's suite on stage 1 (built by the seed's compiler; it
#                                 matters when stage 1 differs from stage 2)
#                   j2a           bin/j2a-check --suite (the converter on the frozen clojure/
#                                 and its samples, and Clojure's suite on the converted baseline)
#                   g2a           bin/g2a roundtrip amd64, then linux/amd64 (B1a's target): Go ->
#                                 forms -> Go over std and $GOROOT/test, against
#                                 test/g2a/roundtrip-amd64.edn and roundtrip-linux-amd64.edn;
#                                 one after the other, since two converters at once exhaust
#                                 the memory beside the suites; needs TamaGo's go, G2A_GOROOT
#                   go            the Go build on amd64 (doc/go/EVAL-NOTES.md), one chain:
#                     jrt-convert   bin/jrt-convert (jrt's JDK sources into .tmp/jrt/conv)
#                     go-build      ARBACE_GO_ARCHES=amd64 bin/arbace-go --build
#                     then concurrently:
#                     go-smoke      ARBACE_GO_ARCHES=amd64 bin/arbace-go --smoke
#                     go-build-tests  ARBACE_GO_ARCHES=amd64 bin/arbace-go --build-tests: the
#                                   test build, with the suite's Java fixtures; then
#                     suite-go      Clojure's suite on the test build, against
#                                   test/arbace-go-results.edn
#                     oracle-go     bin/oracle check on the Go build, against its known
#                                   mismatches, test/oracle/known-go-amd64.edn
#                     box-forms     bin/arbace-go --build --box for amd64 and arm64 (the guests
#                                   from tamago/'s forms), then bin/tamago-vendor check: each
#                                   guest built from the printed forms byte-identical to one
#                                   built from TamaGo's originals (doc/go/BOX-NOTES.md, S6, S4)
#                   (arm64, under qemu, stays out: its suite takes hours)
#                   box           the box's vendored packages (box/, doc/go/BOX-NOTES.md):
#                                 bin/box-vendor roundtrip (box/ printed, converted back and
#                                 printed again, the printings compared by gocmp per
#                                 configuration), then bin/box-vendor kvm-tests (go-whim's KVM
#                                 tests, at go-whim's commit, on box/: hv, vmm, the C and TamaGo
#                                 guests on the monitor, on /dev/kvm); needs /root/go-whim
#                                 (cloned, read only) and TamaGo's go; then bin/tamago-vendor
#                                 verify (tamago/ converted afresh, compared byte for byte)
#              g2a, box and the go chain start, concurrently, when suite-stage1, suite-stage2 and
#              j2a (whose suite runs on the converted baseline) are done: their converters
#              beside the three suites exhaust the memory
# The suite on stage 1 is not essential: the build requires stage 2 = stage 3, and reports
# whether stage 1 = stage 2; when they are equal, the suite on stage 1 tests the same classes.
# The gate first trims Go's build cache of entries unused for six hours (bin/lib/gocache.bash,
# ARBACE_GOCACHE_KEEP_MIN; Go itself keeps them five days, and a2g's programs, the round trips
# and parallel builds fill it by tens of GB in hours).
# Logs go to .tmp/gate/NAME.log; the summary prints each check's outcome and wall time.
# Environment: GATE_TEST_JOBS, parallel test JVMs of each suite run (default 12, since 24 with --full's three concurrent JVM suites ran out of memory on 2026-10-11; the concurrent
#   runs share the machine), and what the scripts above read (ARBACE_JVM_OPTS, J2A_JVM_OPTS).
# Exit status: 0 when every check passed.
set -uo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"
full=
case ${1:-} in
  "") ;;
  --full) full=1 ;;
  *) echo "usage: bin/gate [--full]" >&2; exit 2 ;;
esac
logs=$root/.tmp/gate
rm -rf "$logs"
mkdir -p "$logs"
jobs=${GATE_TEST_JOBS:-12}
start=$(date +%s)
secs() { local s=$(( $(date +%s) - $1 )); printf '%dm%02ds' $((s / 60)) $((s % 60)); }
summary() { grep -E "$2" "$logs/$1.log" | tail -${3:-2} | sed 's/^/     /'; }

echo "== gate$( [ -n "$full" ] && echo ' --full'): $(git log -1 --format='%h %s')"
# Go's build cache, trimmed by every gate run (bin/lib/gocache.bash)
. "$root/bin/lib/gocache.bash"
gocache_trim
t=$(date +%s)
if ! bin/seed --check > "$logs/seed.log" 2>&1; then
  cat "$logs/seed.log"; echo "== gate FAILED: the seed"; exit 1
fi
if ! bin/build-arbace > "$logs/build.log" 2>&1; then
  tail -20 "$logs/build.log"; echo "== gate FAILED: bin/build-arbace (log $logs/build.log)"; exit 1
fi
echo "   ok  build ($(secs "$t"))"
summary build 'identical|differ|^Ran|failures' 4

suite() {  # suite N: Clojure's suite on stage N, as bin/build-arbace --suite runs it
  CLOJURE_TESTS_RENAME=arbace CLOJURE_TESTS_RUN=stage$1 CLOJURE_SRC="$root/target/stage$1:$root" \
    CLOJURE_TESTS_PRECOMPILED=1 bin/clojure-tests -j "$jobs"
}
step() {  # step NAME COMMAND...: one check of the go chain, logged as launch logs its checks
  local name=$1 t0; shift; t0=$(date +%s)
  "$@" > "$logs/$name.log" 2>&1
  local st=$?
  echo $st > "$logs/$name.status"; echo $(( $(date +%s) - t0 )) > "$logs/$name.secs"
  return $st
}
go_chain() {  # the Go build on amd64, then its three checks concurrently
  step jrt-convert bin/jrt-convert || return 1
  step go-build env ARBACE_GO_ARCHES=amd64 bin/arbace-go --build || return 1
  step go-smoke env ARBACE_GO_ARCHES=amd64 bin/arbace-go --smoke &
  # the suite on the test build (the shipped executable does not carry the suite's Java
  # fixtures: doc/go/EVAL-NOTES.md, "The suite's Java fixtures")
  { step go-build-tests env ARBACE_GO_ARCHES=amd64 bin/arbace-go --build-tests \
      && step suite-go env CLOJURE_TESTS_GO="$root/target/arbace-go/amd64/arbace-tests" bin/clojure-tests -j 12; } &
  # --timeout: the reducers file takes about 285 s of the default 300 (EVAL-NOTES.md, part 4)
  step oracle-go bin/oracle check 'target/arbace-go/amd64/arbace -' --timeout 900 \
    --expected test/oracle/known-go-amd64.edn &
  step box-forms sh -c 'env ARBACE_GO_ARCHES=amd64 ARBACE_BOX_ARCHES=amd64,arm64 bin/arbace-go --build --box && bin/tamago-vendor check' &
  wait
}
converters() {  # g2a and the go chain, once the three suites are done: a converter (g2a's
  # takes up to 12 GB, jrt-convert's 8) beside the suites (up to 43 GB at once, 24 JVMs each)
  # exhausts the memory (the OOM killer took g2a's in both runs of 2026-10-09 that tried)
  until [ -f "$logs/suite-stage1.status" ] && [ -f "$logs/suite-stage2.status" ] \
          && [ -f "$logs/j2a.status" ]; do sleep 2; done
  step g2a sh -c 'bin/g2a roundtrip amd64 && bin/g2a roundtrip linux/amd64' &
  step box sh -c 'bin/box-vendor roundtrip && bin/box-vendor kvm-tests && bin/tamago-vendor verify' &
  go_chain &
  wait
}
declare -A pids starts
launch() {  # launch NAME COMMAND...
  local name=$1; shift
  starts[$name]=$(date +%s)
  ( "$@" > "$logs/$name.log" 2>&1; echo $? > "$logs/$name.status"; echo $(( $(date +%s) - ${starts[$name]} )) > "$logs/$name.secs" ) &
  pids[$name]=$!
}
launch suite-stage2 suite 2
launch cft bin/class-forms-tests
[ -n "$full" ] || launch go bin/arbace-go --gate
if [ -n "$full" ]; then
  launch suite-stage1 suite 1
  launch j2a env J2A_TEST_JOBS="$jobs" bin/j2a-check --suite
  launch converters converters
fi
report() {  # report NAME: a check's outcome, wall time and summary lines
  local name=$1
  if [ ! -f "$logs/$name.status" ]; then
    echo "   FAILED  $name (not run: an earlier step failed)"; status=1; return
  fi
  s=$(cat "$logs/$name.secs"); w=$(printf '%dm%02ds' $((s / 60)) $((s % 60)))
  if [ "$(cat "$logs/$name.status")" = 0 ]; then
    echo "   ok  $name ($w)"
  else
    echo "   FAILED  $name ($w; log $logs/$name.log)"; status=1
  fi
  case $name in
    suite-*|j2a) summary "$name" 'TOTAL|regressions' ;;
    g2a) summary g2a '^package|^test |regressions' 6 ;;
    box) summary box 'FAIL|^ok|^--- ' 3 ;;
    cft) summary cft '^Ran|failures' ;;
    go) summary go 'cached executable|building the executable|built in|FAIL' 4 ;;
    jrt-convert) summary jrt-convert . 1 ;;
    go-build|go-build-tests) summary "$name" . 1 ;;
    go-smoke) summary go-smoke 'ok|FAIL' 1 ;;
    oracle-go) summary oracle-go '^== ' ;;
    box-forms) summary box-forms 'identical|differ|FAIL' 3 ;;
  esac
}
status=0
for name in suite-stage2 cft $( [ -n "$full" ] || echo go ) ${full:+suite-stage1 j2a converters}; do
  wait "${pids[$name]}"
  if [ "$name" = converters ]; then
    for g in g2a box jrt-convert go-build go-smoke go-build-tests suite-go oracle-go box-forms; do report "$g"; done
  else
    report "$name"
  fi
done
if [ $status = 0 ]; then echo "== gate passed ($(secs "$start"))"; else echo "== gate FAILED ($(secs "$start"))"; fi
exit $status

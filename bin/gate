#!/bin/bash
# The gate: the checks a change must pass before it is committed to main. Since standalone S4
# (doc/STANDALONE-NOTES.md, "S4: the JVM removed") the bootstrap starts from the Go-source seed
# and every build is Go-hosted; the JVM runs only the oracle's reference (the frozen v4 jar) and,
# with --full, j2a and the checks of what j2a and the JVM made (jdk/, the edge, the fixtures).
#
# Usage: bin/gate [--full]
#   (default)  the essential gate:
#                1. seed          bin/seed --check: the seed is the pinned one
#                2. stage0        bin/seed --build: stage 0, the host of the build's tools, built
#                                 from the seed by Go's toolchain (target/seed; seconds with Go's
#                                 build cache warm)
#                3. go-build      bin/arbace-go --gate-build: the executable and the test build
#                                 (amd64), a2g and g2a on stage 0, cached in
#                                 .tmp/arbace-go-gate and built again only when what they are
#                                 built from changed (gate_key: Arbace's sources, go/, overlay/,
#                                 jdk/, the fixtures' forms, the build's scripts, the seed's and
#                                 the toolchain's pins): seconds on a hit, two Go-hosted builds
#                                 on a miss
#                4. concurrently, on the cached executables:
#                   go-smoke      bin/arbace-go --gate: the smoke test (seconds)
#                   suite-go      Clojure's suite on the test build, against
#                                 test/arbace-go-results.edn (c2a's translation on stage 0)
#                   oracle-go     bin/oracle check on the executable against the frozen JVM
#                                 Arbace's expected results, with its known mismatches,
#                                 test/oracle/known-go-amd64-frozen.edn
#   --full     also, once those are done, concurrently:
#                   jvm           on the frozen JVM (bin/lib/frozen.bash), one after the other:
#                     j2a           bin/j2a-check --suite (the converter's checks, and Clojure's
#                                   suite on the converted baseline)
#                     jrt-convert   bin/jrt-convert verify (jdk/'s forms converted afresh by j2a
#                                   and compared byte for byte: jdk/README.md)
#                     a2g-edge      bin/a2g-edge verify (a2g's edge recorded afresh on the JVM and
#                                   compared byte for byte with jdk/edge.edn)
#                     java-fixtures bin/clojure-tests --java-fixtures verify (the suite's Java
#                                   fixtures converted afresh by j2a, compared with
#                                   test/java-fixtures)
#                   go            the Go build afresh, one after the other:
#                     go-build-full ARBACE_GO_ARCHES=amd64 bin/arbace-go --build, then --smoke
#                     box-forms     bin/arbace-go --build --box for amd64 and arm64 (the guests
#                                   from tamago/'s forms), then bin/tamago-vendor check: each
#                                   guest byte-identical to one built from TamaGo's originals
#                     box-smoke     ARBACE_BOX_ARCHES=amd64 bin/arbace-go --smoke --box (the
#                                   box's smoke test on /dev/kvm)
#                     fixpoint      bin/arbace-go --fixpoint: G1 by stage 0, G2 by G1, G3 by G2;
#                                   G2 = G3 (a2g's trees and the executables); G1 = G2 and stage
#                                   0 = G1 reported (they hold when the seed is current)
#                   g2a           bin/g2a roundtrip amd64, then linux/amd64 (Go -> forms -> Go
#                                 over std and $GOROOT/test, against test/g2a/roundtrip-*.edn);
#                                 then the box's vendored packages: bin/box-vendor roundtrip,
#                                 kvm-tests (go-whim's KVM tests on box/, on /dev/kvm; needs
#                                 /root/go-whim), purego-check; bin/tamago-vendor verify
#                                 (tamago/ converted afresh, compared byte for byte);
#                                 bin/x509roots-vendor verify and check
#              (arm64, under qemu, stays out: its suite takes hours)
# Every build and tool needs TamaGo's go (G2A_GOROOT, default /root/tamago-go), never the host's.
# The gate first trims Go's build cache of entries unused for six hours (bin/lib/gocache.bash,
# ARBACE_GOCACHE_KEEP_MIN). ARBACE_HOST_EXE is ignored: the gate's host is stage 0.
# Logs go to .tmp/gate/NAME.log; the summary prints each check's outcome and wall time.
# Environment: GATE_TEST_JOBS, the suite's parallel processes (default 12).
# Exit status: 0 when every check passed.
set -uo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"
unset ARBACE_HOST_EXE A2G_GO_EXE G2A_GO_EXE
full=
case ${1:-} in
  "") ;;
  --full) full=1 ;;
  *) echo "usage: bin/gate [--full]" >&2; exit 2 ;;
esac
logs=$root/.tmp/gate
rm -rf "$logs"
mkdir -p "$logs"
jobs=${GATE_TEST_JOBS:-12}
start=$(date +%s)
secs() { local s=$(( $(date +%s) - $1 )); printf '%dm%02ds' $((s / 60)) $((s % 60)); }
summary() { grep -E "$2" "$logs/$1.log" | tail -${3:-2} | sed 's/^/     /'; }
status=0

echo "== gate$( [ -n "$full" ] && echo ' --full'): $(git log -1 --format='%h %s')"
# Go's build cache, trimmed by every gate run (bin/lib/gocache.bash)
. "$root/bin/lib/gocache.bash"
gocache_trim

step() {  # step NAME COMMAND...: one check, logged, its status and seconds recorded
  local name=$1 t0; shift; t0=$(date +%s)
  "$@" > "$logs/$name.log" 2>&1
  local st=$?
  echo $st > "$logs/$name.status"; echo $(( $(date +%s) - t0 )) > "$logs/$name.secs"
  return $st
}
report() {  # report NAME: a check's outcome, wall time and summary lines
  local name=$1 s w
  if [ ! -f "$logs/$name.status" ]; then
    echo "   FAILED  $name (not run: an earlier step failed)"; status=1; return
  fi
  s=$(cat "$logs/$name.secs"); w=$(printf '%dm%02ds' $((s / 60)) $((s % 60)))
  if [ "$(cat "$logs/$name.status")" = 0 ]; then
    echo "   ok  $name ($w)"
  else
    echo "   FAILED  $name ($w; log $logs/$name.log)"; status=1
  fi
  case $name in
    seed) summary seed 'pinned' 1 ;;
    stage0) summary stage0 'bin/seed: .*arbace|stage 0 in' 2 ;;
    go-build) summary go-build 'cached executables|building the executables|built in|FAIL' 3 ;;
    go-smoke|go-build-full) summary "$name" 'ok|FAIL' 1 ;;
    suite-go|j2a) summary "$name" 'TOTAL|regressions' ;;
    oracle-go) summary oracle-go '^== ' ;;
    jrt-convert) summary jrt-convert '^verify:|^jrt-convert:' 2 ;;
    a2g-edge) summary a2g-edge '^a2g-edge:' 1 ;;
    java-fixtures) summary java-fixtures '^verify:' 1 ;;
    box-forms) summary box-forms 'identical|differ|FAIL' 3 ;;
    box-smoke) summary box-smoke 'checks|ok|FAIL' 2 ;;
    fixpoint) summary fixpoint '^fixpoint:' 9 ;;
    g2a) summary g2a '^package|^test |regressions|FAIL|^ok' 8 ;;
  esac
}

# 1-3, one after the other: each needs the one before
for s in "seed bin/seed --check" "stage0 bin/seed --build" "go-build bin/arbace-go --gate-build"; do
  set -- $s
  name=$1; shift
  step "$name" "$@"; report "$name"
  if [ "$(cat "$logs/$name.status")" != 0 ]; then
    tail -20 "$logs/$name.log"; echo "== gate FAILED ($(secs "$start"))"; exit 1
  fi
done

# 4: the checks of the cached executables, concurrently
cache=$root/.tmp/arbace-go-gate/amd64
step go-smoke bin/arbace-go --gate &
step suite-go env CLOJURE_TESTS_GO="$cache/arbace-tests" bin/clojure-tests -j "$jobs" &
# --timeout: the reducers file takes about 285 s of the default 300 (EVAL-NOTES.md, part 4)
step oracle-go bin/oracle check "$cache/arbace -" --timeout 900 --expected test/oracle/known-go-amd64-frozen.edn &
wait
for name in go-smoke suite-go oracle-go; do report "$name"; done

if [ -n "$full" ]; then
  jvm_chain() {
    step j2a env J2A_TEST_JOBS="$jobs" bin/j2a-check --suite
    step jrt-convert bin/jrt-convert verify
    step a2g-edge bin/a2g-edge verify
    step java-fixtures bin/clojure-tests --java-fixtures verify
  }
  go_chain() {
    step go-build-full sh -c 'ARBACE_GO_ARCHES=amd64 bin/arbace-go --build && ARBACE_GO_ARCHES=amd64 bin/arbace-go --smoke' || return 1
    step box-forms sh -c 'ARBACE_GO_ARCHES=amd64 ARBACE_BOX_ARCHES=amd64,arm64 bin/arbace-go --build --box && bin/tamago-vendor check' \
      && step box-smoke env ARBACE_BOX_ARCHES=amd64 bin/arbace-go --smoke --box
    step fixpoint bin/arbace-go --fixpoint
  }
  g2a_chain() {
    step g2a sh -c 'bin/g2a roundtrip amd64 && bin/g2a roundtrip linux/amd64 && bin/box-vendor roundtrip && bin/box-vendor kvm-tests && bin/box-vendor purego-check && bin/tamago-vendor verify && bin/x509roots-vendor verify && bin/x509roots-vendor check'
  }
  jvm_chain & go_chain & g2a_chain &
  wait
  for name in j2a jrt-convert a2g-edge java-fixtures go-build-full box-forms box-smoke fixpoint g2a; do report "$name"; done
fi
if [ $status = 0 ]; then echo "== gate passed ($(secs "$start"))"; else echo "== gate FAILED ($(secs "$start"))"; fi
exit $status

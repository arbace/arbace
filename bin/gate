#!/bin/bash
# The gate: the checks a change must pass before it is committed to main. Since standalone S4
# (doc/STANDALONE-NOTES.md, "S4: the JVM removed") the bootstrap starts from the Go-source seed
# and every build is Go-hosted; the JVM runs only the oracle's reference (the frozen v4 jar) and,
# with --full, the checks of what the JVM made (the edges), the reference javac, the frozen
# back end of repr/java's check --suite, jrt-convert's edge step and the JDK build's generators;
# since JN5 repr/java's checks run on javac's tool executable, and since JN6 nothing of repr/java
# starts a JVM (doc/classes/JAVA-FRONTEND-SURVEY.md, JFS9, "As built: JN5", "As built: JN6").
#
# Since GT1-GT3 (doc/GATE-SURVEY.md, "As built: GT1-GT3") the steps are data, test/gate/steps.edn:
# each with its command, the steps it needs and its declared inputs (files, hosts, pins,
# environment). After stage 0 the planner (test/gate/plan.ae, gate.plan on stage 0) computes each
# check's key over them (GTS2 (a): never the commit) and looks it up in the store of passes
# (ARBACE_GATE_STORE, default the main checkout's .tmp/gate-pass/, shared by the worktrees; GTS6
# (a)): a check that passed at its key is skipped (the summary's "skipped NAME (passed at ...)"),
# one that runs and passes is recorded there (GTS7 (a): STORE/NAME/KEY.edn with the commit, the
# worktree, the date, the seconds, the peak memory and the log's digest; KEY.log, KEY.inputs). A
# build (go-build, javac-tool) runs when a check that runs needs it. Every step runs under busybox
# time -v (GT1, GTS15 (a)): its wall and CPU seconds and its largest process's peak RSS in
# .tmp/gate/NAME.mem, beside the 5 s sampler's .tmp/gate/mem.tsv (the host's MemAvailable, the
# gate's processes' RSS, each running step's), whose per-step peak the .mem file holds too.
#
# Since GT4-GT6 (doc/GATE-SURVEY.md, "As built: GT4, GT6") what decides a step's outcome is the runner
# library bin/lib/gate-run.bash (with the planner, the only gate logic in a key, GTS22 (a): this file's
# header, summary and option parsing are not); the heavy steps (:heavy, with their measured :mem-gib)
# run under GATE_HEAVY_CMD, by default the host's big-job lock ARBACE_HEAVY_LOCK, the gate itself not
# (GTS25 (a)); the gate's executables and javac's tool are kept by their keys in ARBACE_GATE_EXES
# (default the main checkout's .tmp/gate-exe), shared by the worktrees (GTS24 (a)); a step over three
# times its latest passes' time is flagged in the summary (GTS17 (a)).
#
# Since GT5 (doc/GATE-SURVEY.md, "As built: GT5") the inner keys: a step's :parts are one check each
# (NAME.PART: native-check and repr/java's tree checks per corpus; :clean-only parts with
# GATE_ALL_PARTS=1), :outputs kept with a pass and put back on a skip, :uses keying a step by its
# producers' outputs (the decision "after": an early cutoff), Java's check a step per level with its
# judgment apart, the program hosts :prog and :javac-prog (the build's units less a step's :never-loads);
# the builds run before every check and the plan is made again after them; GATE_HEAVY_CMD's default is
# bin/heavy-lock (the lock taken in turn, GTS32 (a)), and a :heavy :inner step's tools lock around their
# heavy process alone (GTS31 (b), bin/lib/heavy.bash); --full ends with --prune (GTS34 (a)).
#
# Usage: bin/gate [--full] [--rerun]
#        bin/gate [--full] --plan   the plan alone: each step, run, skipped, built or not needed,
#                                   and why (the inputs changed since its latest pass); stage 0
#                                   first when missing
#        bin/gate --why STEP        STEP's material (its key's inputs but the files), its passes,
#                                   and every line changed since the latest one (--full's plan)
#        bin/gate --audit [STEP...] each check named (default every check, --full's table) run under
#                                   strace; the files it reads under the checkout against its declared
#                                   inputs: an undeclared read fails the audit and names the file
#                                   (GT4; needs the executables and javac's tool built: bin/gate
#                                   --full first; a heavy step takes the lock; .tmp/gate-audit/)
#        bin/gate --prune [--dry-run]  the store of passes trimmed: per step the last 5 and every pass
#                                   younger than 30 days kept; the executables' directories but the
#                                   newest 3 of each, older than a day, removed (GTS27)
#        --rerun                    every check runs (and records its pass), as at a clean run
#        bin/gate [--full] --plan --builds  the builds the plan needs run first, then the plan on their
#                                   program units (GTS42 (a)'s demonstrations, bin/gate-demos)
#        bin/gate [--full] --clean [--tag TAG]  (GT7, doc/GATE-SURVEY.md §7, "As built: GT7 (tooling)")
#                                   the clean run at a tag: a fresh `git clone --shared` of HEAD's commit
#                                   in .tmp/gate-clean/SHA, its own empty .tmp/, target/ and GOCACHE, the
#                                   environment's Arbace and gate variables dropped (but ARBACE_GOROOT,
#                                   ARBACE_HEAVY_LOCK, GATE_HEAVY_CMD, ARBACE_HEAVY_HELD, GATE_TEST_JOBS,
#                                   JDK), the clone's bin/gate run there: the pins first (--pins), stage
#                                   0, the executables and javac's tool built fresh (its ARBACE_GATE_EXES,
#                                   its store: no pass read, every check run), serial, every step (the
#                                   builds too) run under the audit (strace, the reducer tools/gateaudit,
#                                   gate.audit: an undeclared read fails the gate and its pass is not
#                                   recorded; GTS30 (a)), every part (GATE_ALL_PARTS=1, GTS19 (a)), Java's
#                                   levels that consume the read's output on its cache alone
#                                   (JAVA_CHECK_FORMS_ONLY=1: a miss fails, GTS41 (c)), each limited
#                                   program's CPU time in .tmp/gate/NAME.cpu.tsv (GTS33 (a)); then its
#                                   record test/gate/clean-TAG.edn (TAG default the short SHA,
#                                   GATE_CLEAN_TAG) in this checkout, its logs in .tmp/gate-clean/SHA.logs/,
#                                   its passes (:clean) into the store and, when it passed, its builds into
#                                   ARBACE_GATE_EXES where absent (GATE_CLEAN_PUBLISH=0: not), the clone
#                                   removed (kept on a failure, GATE_CLEAN_KEEP=1). A caller holding the
#                                   big lock for the whole run sets GATE_HEAVY_CMD=env; the frozen jar is
#                                   the main checkout's .tmp/oracle-frozen/ one (FROZEN_JAR), checked by its
#                                   pin, else built in the clone from its tag
#        bin/gate [--full] --clean --plan  the plan such a run makes (an empty store, every part)
#        bin/gate --pins [FILE]     what a clean run takes from outside its clone, by its pins: TamaGo's go
#                                   (seed/goroot.sha256), jdk26u's commit and its build tree's platform
#                                   (jdk/javac/platform.sha256), the system JDK (javac 26), the frozen jar
#                                   (test/oracle/frozen-jar.sha256, when FROZEN_JAR names it), the frozen
#                                   tree's tag; $GOROOT/test's digest recorded (FILE: as a map)
#        bin/gate --full --concurrent  (GTS37 (a)) --full's chains at once (GATE_FULL_PARALLEL=1) under the
#                                   host's big lock taken once for the whole run (bin/heavy-lock;
#                                   GATE_CONCURRENT_HELD=1: the caller holds it), its heavy steps and the
#                                   tools' heavy processes serialized on a lock of its own
#                                   (GATE_CONCURRENT_LOCK, default .tmp/gate-concurrent.lock)
#        (GATE_STEPS: another table, GATE_PROG_UNITS, GATE_JAVAC_PROG_UNITS: the units given: the gate's
#        own tests, a toy table)
#   (default)  the essential gate:
#                0. makefile      make check-makefile: every bin/ script the Makefile (the
#                                 newcomers' interface) runs exists (seconds)
#                1. seed          bin/seed --check: the seed is the pinned one
#                2. stage0        bin/seed --build --no-aot: stage 0, the host of the build's tools,
#                                 built from the seed by Go's toolchain (target/seed; kept by the
#                                 seed's and Go's pins since GT3, GTS12 (a); seconds with Go's
#                                 build cache warm; its compiled namespaces, RPS95 (b), are the
#                                 gate build's business here: --no-aot)
#                   (then the plan: above)
#                3. go-build      bin/arbace-go --gate-build: the executable and the test build
#                                 (amd64), j2g and repr/go on stage 0, cached in
#                                 .tmp/arbace-go-gate and built again only when what they are
#                                 built from changed (gate_key: Arbace's embedded sources, go/,
#                                 overlay/ and jdk/ but javac's world's, the fixtures' forms, the
#                                 build's scripts, the seed's and the toolchain's pins; narrowed
#                                 by GT2, GTS5 (a)): seconds on a hit, two Go-hosted builds on a
#                                 miss; a build, run when a check that runs needs it
#                4. concurrently, on the cached executables:
#                   go-smoke      bin/arbace-go --gate: the smoke test (seconds)
#                   suite-go      Clojure's suite on the test build, against
#                                 test/arbace-go-results.edn (repr/clojure's translation on stage 0)
#                   oracle-go     bin/oracle check on the executable against the frozen JVM
#                                 Arbace's expected results, with its known mismatches,
#                                 test/oracle/known-go-amd64-frozen.edn
#                   goi-check     bin/goi check --essential: the programs of $GOROOT/test listed in
#                                 test/goi/essential.txt interpreted by goi against gc, against
#                                 test/goi/check-linux-amd64.edn (doc/go/GOI-SPEC.md §11.5, GS12;
#                                 gc's references cached in .tmp/goi-check)
#                   java-check    bin/java-check --essential: the jtreg tests of test/java/essential.txt
#                                 interpreted from their committed forms (test/java/forms) against the
#                                 JDK's recorded runs, test/java/ref-jdk26.edn (doc/classes/
#                                 JAVA-CONFORMANCE-SURVEY.md, JCS13 (a), "As built: JC1"; about a minute)
#                   goi-aot-essential  (REAP8, RPS33 (a); after goi-check, which reads the corpora
#                                 when missing) bin/goi check --aot --essential: the programs of
#                                 test/goi/essential-aot.txt at Go's AOT level (built by
#                                 arbace.build.go on the gate's executable and run, or printed from
#                                 mode :full and compiled by gc) against gc on the originals, against
#                                 test/goi/check-aot-linux-amd64.edn (about 70 s on gc's cached references)
#                   java-compiled (REAP8, JCS41 (a)) bin/java-check --essential-compiled: the
#                                 essential tests that pass compiled, from their committed forms, in
#                                 one program (j2g with the gate's compiled namespaces, bin/build-go)
#                                 cached by its key in .tmp/java-check/essential-compiled, every one
#                                 passing (seconds cached, about 5 minutes when j2g, the runtime or
#                                 the forms change)
#                   suite-aot-essential  (REAP8, RPS40 (b)) bin/clojure-tests --aot --essential:
#                                 the namespaces of test/clojure/essential-aot.txt compiled alone by
#                                 c2j, their program built by j2g and bin/build-go (cached by its
#                                 key) and run, against test/arbace-go-aot-results.edn
#                   programs      (REAP7b, RPS98 (c)) bin/arbace-go --build-program --check mixed bad-go (the sample
#                                 that must not build, RPS102 (b)):
#                                 test/programs/mixed (Clojure, Java forms, Go forms compiled
#                                 through its own goi table) built on the gate's executable and
#                                 compiled namespaces (ARBACE_PROGRAM_BASE, cached by its key) and
#                                 run on its runs (seconds cached, about 4 minutes when its key
#                                 changes)
#                   (the whole-program j2g runs, diffcheck's, java-compiled's,
#                   suite-aot-essential's and programs', one at a time: J2G_LOCK, bin/j2g)
#                   j2g-edge      (essential since 2026-10-24) bin/j2g-edge verify, on the frozen
#                                 JVM (bin/lib/frozen.bash): j2g's edge recorded afresh and compared
#                                 byte for byte with jdk/edge.edn (about 1.5 minutes)
#                   reap          bin/reap: the REAP matrix from the checks' recorded results
#                                 (doc/FULL-SUPPORT-SURVEY.md, REAP1, RPS13): every non-pass of a
#                                 recorded check in a class of its level's classes file (seconds)
#   --full     also, once those are done, one after another in this order (GTS13 (a); by chain,
#              concurrently, with GATE_FULL_PARALLEL=1):
#                   go            the chain of the gate's executables (no fresh build of the program
#                                 since GT3, GTS10 (a): the gate's cached build is the fixpoint's G1;
#                                 its smoke test is the essential go-smoke):
#                     javac-tool    javac's tool executable (doc/classes/JAVA-FRONTEND-SURVEY.md, JN2,
#                                   JN3, JN5), built once per arbace_javac_key and kept in
#                                   .tmp/gate-javac across gates (GTS11 (a)): bin/javac-vendor tool
#                                   (bin/arbace-go --build-java, j2g on the gate's executable with its
#                                   compiled namespaces); a build, run when a check that runs needs it
#                     javac-check   bin/javac-vendor check --from: j2g translates javac's world, read
#                                   from the tool build's own j2g run (javac's world translated once)
#                     javac-verify  bin/javac-vendor verify (jdk/javac read afresh by javac on
#                                   Arbace, the fixpoint, its edge recorded on the frozen JVM: byte
#                                   for byte)
#                     javac-classes bin/javac-vendor classes baseline samples jdk java.base (javac on
#                                   Arbace's class files against the JVM's javac's, byte for byte,
#                                   and java.base's against the JDK build's)
#                     java          after javac-tool (GATE_FULL_PARALLEL=1: concurrently with the
#                                   rest of the go chain), repr/java's checks on the tool executable
#                                   (REPR_JAVA_EXE), one after the other:
#                       repr-java     bin/repr-java check --suite (the converter's checks, and
#                                     Clojure's suite on the converted baseline, compiled by the
#                                     frozen jar's back end and run on the JVM)
#                       repr-java-roundtrip  bin/repr-java roundtrip --corpus baseline,samples,jdk
#                                     --text (Java -> forms -> Java -> forms, levels forms, ae and
#                                     classes by javac on Arbace, then the text level: mode :full
#                                     printed back byte for byte, against test/repr/java/roundtrip/)
#                       jrt-convert   bin/jrt-convert verify (jdk/'s forms converted afresh by
#                                     repr/java and compared byte for byte: jdk/README.md; its
#                                     generators on a JDK, its edge step on the frozen JVM)
#                       java-fixtures bin/clojure-tests --java-fixtures verify (the suite's Java
#                                     fixtures converted afresh by repr/java, compared with
#                                     test/java-fixtures)
#                       repr-java-parse  bin/repr-java parse-check (repr/java's native parser:
#                                     every file of the samples, the baseline, the jdk corpus's and
#                                     javac's sources, jdk26u's 68 modules, the mutants and
#                                     jdk26u's tests parsed
#                                     to javac on Arbace's trees, positions included, against
#                                     test/repr/java/parse-check-known.edn; doc/classes/
#                                     JAVA-FRONTEND-SURVEY.md, "As built: JN8", JFS60)
#                       repr-java-front  bin/repr-java front-check (the converter on the native
#                                     parser's trees, javac's attribution by position: its forms
#                                     equal to javac's trees' over the samples, the baseline, the
#                                     jdk corpus and javac's sources, the split measured; "As
#                                     built: JFS66 (b)", JFS67)
#                       repr-java-attr   bin/repr-java attr-check (the native attribution provider:
#                                     the native trees' scope and declarations tiers answered
#                                     without javac, each fact equal to javac on Arbace's, the forms
#                                     still javac's trees', over the same corpora, against
#                                     test/repr/java/attr-check-known.edn; "As built: JN9a", JFS74)
#                       repr-java-nojavac bin/repr-java nojavac-check (the read without javac:
#                                     every corpus read by javac's trees and by read --no-javac, the
#                                     forms equal file for file, the fallbacks counted, against
#                                     test/repr/java/nojavac-check-known.edn; "As built: JN9f", JFS121)
#                       java-check-full  bin/java-check --levels read,interp,classes,compiled,diagnostics,print
#                                     (Java's conformance check, every corpus: jdk26u's jtreg run tests
#                                     read on the tool, interpreted on the gate's executable, compiled
#                                     by javac on Arbace, translated by j2g in shards with the Go build's
#                                     compiled namespaces and run (JC2), langtools' golden-diagnostics
#                                     tests by javac on Arbace against their golden files, "As built:
#                                     JC3", every read test's forms printed back by repr/java's
#                                     printer and judged, "As built: REAP5"; against test/java/ref-jdk26.edn and
#                                     test/java/check-*.edn, every test not passing in a class of
#                                     test/java/divergences.edn), then bin/java-check --forms verify
#                                     (the essential tests' committed forms read afresh; "As built: JC1")
#                     fixpoint      bin/arbace-go --fixpoint --g1 .tmp/arbace-go-gate: G1 the
#                                   gate's build (GT3), G2 by G1, G3 by G2; G2 = G3 (j2g's trees and
#                                   the executables); G1 = G2 and stage 0 = G1 reported (they hold
#                                   when the seed is current and G1 was built at this commit)
#                     suite-aot     bin/clojure-tests --aot (after the fixpoint, in its chain):
#                                   Clojure's suite compiled by c2j with the runtime's, against
#                                   test/arbace-go-aot-results.edn, the levels compared (REAP3)
#                     programs-full bin/arbace-go --build-program --check (REAP7b, RPS98 (c)):
#                                   every sample of test/programs on the gate's executable
#                   repr-go       bin/repr-go roundtrip amd64, then linux/amd64 (Go -> forms -> Go
#                                 over std and $GOROOT/test, against test/repr/go/roundtrip-*.edn);
#                                 bin/repr-go roundtrip --text amd64 (mode :full, each file printed
#                                 back byte for byte, but test/repr/go/roundtrip-text-known.edn's);
#                                 $GOROOT/test's directory tests: roundtrip --dirs amd64, then
#                                 linux/amd64 (with the level run), --text --dirs amd64 (about 20
#                                 s together; test/repr/go/roundtrip-dirtest-*.edn);
#                                 then bin/x509roots-vendor verify and check
#                   repr-go-native after repr-go: bin/repr-go native-check --fresh (the native
#                                 reader's trees, go/parser run by goi, equal to the helper's
#                                 dumps over every corpus, afresh; its raw forms resolved by the
#                                 final ones; the final forms of its dumps annotated by goi's
#                                 checker equal to the helper's; against
#                                 test/repr/go/native-known.edn; doc/go/GO-PARSER-SURVEY.md,
#                                 GPS8 (a), "As built: GP1", "As built: GP4")
#                   goi           after repr-go, on its fresh conversions: bin/goi annotations
#                                 (goi's checker over tamago/goroot, the linux std, $GOROOT/test and
#                                 its directory tests: no error, every annotation verified, against
#                                 test/goi/annotations-*.edn; doc/go/GOI-SPEC.md §11.4), bin/goi
#                                 test --gc (the checker's tests, gc's messages; the interpreter's
#                                 programs against gc, the REPL's tests) and bin/goi check --jobs 8
#                                 (every run program of $GOROOT/test against gc, §11; 8 jobs, as
#                                 its reference was recorded: with 16 beside the other steps
#                                 nosplit.go and bug358.go exceed the 10 s), on the gate's executable
#                   goi-aot       after goi: bin/goi check --aot --jobs 8 (Go's AOT level, REAP2: the
#                                 same corpora's forms built by arbace.build.go and run, the
#                                 errorcheck programs printed from mode :full and compiled by gc,
#                                 against gc on the originals; test/goi/check-aot-linux-amd64.edn,
#                                 the classes of test/goi/divergences-aot.edn), the gate's
#                                 executable the tools' host
#                   repr-clojure  bin/repr-clojure check (read's and print's unit tests), --suite
#                                 (Clojure's suite translated against its digest, then printed
#                                 back byte for byte) and --roundtrip (Clojure -> Arbace ->
#                                 Clojure over the frozen clojure/, the suite and its libraries,
#                                 Arbace -> Clojure -> Arbace over arbace/, against
#                                 test/repr/clojure/roundtrip-known.edn); on the tools' host
#                                 (about 1 minute)
#                   diffcheck     (in the essential steps since 2026-10-17, F2.1) bin/diffcheck: the per-form differential check (Futamura
#                                 F2, doc/FUTAMURA-SURVEY.md "F2 as built"): the oracle's forms
#                                 evaluated against compiled by the back end, the Java forms
#                                 interpreted against translated by j2g, in a program built for
#                                 it from the gate's executable, against test/diffcheck/known.edn
#                   generated     (essential, F7.3) bin/generated-check: arbace/lang/go/CompilerNodes.ae
#                                 and CompilerAOTFn.ae regenerated by test/c2j/gen_nodes.ae and
#                                 gen_fns.ae on the gate's executable, compared with the committed
#                                 files (seconds)
#              (arm64, under qemu, stays out: its suite takes hours)
# Parked by the user, 2026-10-26: the box, repr/haskell and repr/rust (and tamago/, tamago/cmd/ with the
# box) are out of --full, kept as they are and revisited later piece by piece. The steps box-forms,
# box-smoke, box-oracle, box-suite, box-goi, repr-haskell, repr-rust and toolchain, and repr-go's
# bin/box-vendor roundtrip, kvm-tests, purego-check and bin/tamago-vendor verify, do not run here:
# run by hand with their scripts (bin/arbace-go --build --box, bin/box-suite, bin/goi check --box,
# bin/repr-haskell, bin/repr-rust, bin/toolchain-vendor, bin/tamago-vendor, bin/box-vendor).
# Every build and tool needs TamaGo's go (ARBACE_GOROOT, default /root/tamago-go), never the host's.
# The gate first trims Go's build cache of entries unused for 90 minutes (bin/lib/gocache.bash,
# ARBACE_GOCACHE_KEEP_MIN). ARBACE_HOST_EXE is ignored: the gate's host is stage 0.
# Logs go to .tmp/gate/NAME.log (NAME.status, .secs, .time, .mem; plan.tsv, plan/NAME.inputs,
# mem.tsv); the summary prints each step's outcome, wall and CPU time and peak memory.
# Environment: ARBACE_HEAVY_LOCK (the host's big-job lock: default the main checkout's .tmp/big.lock),
# GATE_HEAVY_CMD (the command a heavy step runs under: default `flock $ARBACE_HEAVY_LOCK`; `env` when
# the caller holds the lock already), ARBACE_GATE_EXES (the executables' root), GATE_TEST_JOBS, the suite's parallel processes (default 12); ARBACE_GATE_STORE, the
# store of passes; GATE_FULL_PARALLEL=1: --full's chains concurrently, the java chain after
# javac-tool (serial is the default since GT3, GTS13 (a): the chains at once overload a 62 GB host,
# 20 GiB j2g runs, repr-go-native's reads, REAP9, 2026-10-26; GATE_FULL_SERIAL is accepted, a
# no-op); GATE_FRESH_G1=1: the fixpoint builds its G1 (the clean run's hook, GT7).
# Exit status: 0 when every step passed or was skipped.

set -uo pipefail
export CGO_ENABLED=0 # Go's builds never use cgo (doc/go/BOX-NOTES.md, "... cgo dropped", 2026-10-16)
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash" # TMPDIR: .tmp/tmp when unset
. "$root/bin/lib/renamed-env.bash" # stops on a stale G2A_*, J2A_*, A2G_* or C2A_*
cd "$root"
unset ARBACE_HOST_EXE J2G_GO_EXE REPR_GO_EXE
usage() { echo "usage: bin/gate [--full] [--rerun] | bin/gate [--full] --plan [--builds] | bin/gate --why STEP | bin/gate --audit [STEP...] | bin/gate --prune [--dry-run] | bin/gate [--full] --clean [--tag TAG] [--plan] | bin/gate --pins [FILE] | bin/gate --full --concurrent" >&2; exit 2; }
full= plan_only= why= rerun= audit= prune= dry= clean= clean_tag= pins= pins_out= concurrent= builds=
steps_arg=() orig_args=("$@")
while [ $# -gt 0 ]; do
  case $1 in
    --full) full=1 ;;
    --plan) plan_only=1 ;;
    --builds) builds=1 ;;
    --clean) clean=1 ;;
    --tag) [ $# -ge 2 ] || usage; clean_tag=$2; shift ;;
    --pins) pins=1; if [ $# -ge 2 ] && [ "${2#-}" = "$2" ]; then pins_out=$2; shift; fi ;;
    --concurrent) concurrent=1; full=1 ;;
    --why) [ $# -ge 2 ] || usage; why=$2; full=1; shift ;;
    --rerun) rerun=1 ;;
    --audit) audit=1; full=1 ;;
    --prune) prune=1 ;;
    --dry-run) dry=--dry-run ;;
    -*) usage ;;
    *) [ -n "$audit" ] || usage; steps_arg+=("$1") ;;
  esac
  shift
done
mode=essential; [ -n "$full" ] && mode=full
[ -n "$builds" ] && [ -z "$plan_only" ] && usage
[ -n "$clean" ] && { [ -n "$concurrent$audit$why$prune" ] && usage; }
. "$root/bin/lib/gate-run.bash"
. "$root/bin/lib/tools.bash"

# ---- GT7 (doc/GATE-SURVEY.md, §7, "As built: GT7 (tooling)"): the clean run at a tag, the pins of
# what a clone cannot make fresh, the concurrent --full (GTS37 (a)). Here, not in bin/lib: none of it
# decides a step's outcome (the runner's audit_all, audit_compare and the :clean mark are
# bin/lib/gate-run.bash's), so no key holds it.

# clean_pins [FILE]: what the clean run takes from outside its clone, checked by its pins (§7):
# TamaGo's go (seed/goroot.sha256), jdk26u and the JDK build tree's platform (jdk/javac/platform.sha256),
# the frozen jar (test/oracle/frozen-jar.sha256, when FROZEN_JAR gives it: else the clone builds it from
# its tag and frozen_jar checks it), the system JDK (the reference javac, named by its version and its
# release file), $GOROOT/test (seed/goroot-test.sha256, GTS50 (a)); FILE gets them as a map. Exit 1 on a pin that fails
clean_pins() {
  local out=${1:-} st=0 g pv ph have gt tp jdk c jv jrel fj want got pd ft
  . "$root/bin/lib/seed-go.bash"
  g=$(seed_go_goroot)
  ph=$(grep -v '^#' "$seed_go_pin" | awk 'NF {print $1; exit}'); pv=$(grep -v '^#' "$seed_go_pin" | awk 'NF {print $2; exit}')
  have=$(seed_go_goroot_hash "$g") || have=none
  if [ "$have" = "$ph" ] && [ "$(head -1 "$g/VERSION")" = "$pv" ]; then echo "pins: TamaGo's go $g, $pv, its sources $(echo "$have" | cut -c1-16): seed/goroot.sha256's"
  else echo "pins: FAILED: TamaGo's go $g is $(head -1 "$g/VERSION" 2>"$TMPDIR/pins.err") with sources $have; seed/goroot.sha256 pins $pv, $ph"; st=1; fi
  # $GOROOT/test (GTS50 (a)): pinned by seed/goroot-test.sha256 (the steps that read it declare it)
  gt=$(seed_go_test_hash "$g" 2>"$TMPDIR/pins.err") || gt=none
  tp=$(grep -v '^#' "$root/seed/goroot-test.sha256" 2>"$TMPDIR/pins.err" | awk 'NF {print $1; exit}')
  if [ -n "$tp" ] && [ "$gt" = "$tp" ]; then echo "pins: \$GOROOT/test $(echo "$gt" | cut -c1-16) ($(cd "$g" && find test -type f | wc -l) files): seed/goroot-test.sha256's"
  else echo "pins: FAILED: \$GOROOT/test of $g is $gt; seed/goroot-test.sha256 pins ${tp:-nothing}"; st=1; fi
  jdk=${JDK:-/root/jdk26u}
  c=$(git -C "$jdk" rev-parse HEAD 2>"$TMPDIR/pins.err") || c=none
  if grep -q "^# .* at $c," "$root/jdk/javac/platform.sha256" 2>"$TMPDIR/pins.err" || grep -q "$c" "$root/jdk/javac/platform.sha256"; then
    echo "pins: jdk26u $jdk at $c: jdk/javac/platform.sha256's"
  else echo "pins: FAILED: jdk26u $jdk at $c, not jdk/javac/platform.sha256's commit"; st=1; fi
  pd=$root/.tmp/pins-platform
  if "$root/bin/javac-vendor" platform "$pd" > "$TMPDIR/pins-platform.log" 2>&1; then
    echo "pins: the JDK build tree's platform: its $(ls "$pd" | wc -l) modules jdk/javac/platform.sha256's"
  else echo "pins: FAILED: the JDK build tree's platform ($TMPDIR/pins-platform.log):"; grep -m3 'javac-vendor' "$TMPDIR/pins-platform.log" | sed 's/^/   /'; st=1; fi
  rm -rf "${pd:?}"
  jv=none jrel=none
  if c=$(command -v javac); then
    jv=$(javac -version 2>&1 | head -1); c=$(readlink -f "$c")
    [ -f "${c%/bin/javac}/release" ] && jrel=$(sha256sum < "${c%/bin/javac}/release" | cut -c1-64)
    echo "pins: the system JDK (the reference javac): $jv, ${c%/bin/javac}, its release file $(echo "$jrel" | cut -c1-16)"
    case $jv in "javac 26"*) ;; *) echo "pins: FAILED: the reference runs (test/java/ref-jdk26.edn) are JDK 26's, the system JDK is $jv"; st=1 ;; esac
  else echo "pins: FAILED: no system JDK (javac on PATH): the reference javac"; st=1; fi
  fj=none
  if [ -n "${FROZEN_JAR:-}" ]; then
    want=$(sed -n "s/^\([0-9a-f]\{64\}\)  $(basename "$FROZEN_JAR")\$/\1/p" "$root/test/oracle/frozen-jar.sha256")
    got=$(sha256sum < "$FROZEN_JAR" 2>"$TMPDIR/pins.err" | cut -c1-64)
    if [ -n "$want" ] && [ "$got" = "$want" ]; then fj=$FROZEN_JAR; echo "pins: the frozen jar $FROZEN_JAR: test/oracle/frozen-jar.sha256's"
    else echo "pins: FAILED: the frozen jar $FROZEN_JAR is ${got:-missing}, pinned ${want:-nothing for its name}"; st=1; fi
  else
    fj=built; echo "pins: the frozen jar: built in the checkout from its tag, checked by frozen_jar against test/oracle/frozen-jar.sha256"
  fi
  ft=$(git -C "$root" rev-parse -q --verify 'refs/tags/arbace-for-java-26-v1^{commit}' 2>"$TMPDIR/pins.err") || ft=none
  if [ "$ft" != none ]; then echo "pins: the frozen tree clojure/: arbace-for-java-26-v1 at $ft (extracted into .tmp/frozen by the checkout's git)"
  else echo "pins: FAILED: no tag arbace-for-java-26-v1 (the frozen clojure/)"; st=1; fi
  [ -n "$out" ] && printf '{:go {:goroot "%s" :version "%s" :sources-sha256 "%s"} :goroot-test-sha256 "%s"\n  :jdk26u {:dir "%s" :commit "%s"} :system-jdk {:version "%s" :release-sha256 "%s"}\n  :frozen-jar "%s" :frozen-tree "%s" :ok %s}\n' \
    "$g" "$pv" "$have" "$gt" "$jdk" "$(git -C "$jdk" rev-parse HEAD 2>"$TMPDIR/pins.err")" "$jv" "$jrel" "$fj" "$ft" "$([ $st = 0 ] && echo true || echo false)" > "$out"
  [ $st = 0 ] && echo "pins: ok" || echo "pins: FAILED"
  return $st
}

# the main checkout (git's common directory), as gate_env finds it
main_checkout() {
  local common
  common=$(git rev-parse --path-format=absolute --git-common-dir 2>"$TMPDIR/gate-git.err") && [ -d "$common" ] \
    && [ "$(basename "$common")" = .git ] && dirname "$common" || echo "$root"
}

# clean_launch: bin/gate [--full] --clean in the invoking checkout. A fresh `git clone --shared` of HEAD's
# commit in .tmp/gate-clean/SHA, its own empty .tmp/ and target/ and GOCACHE, the environment's Arbace
# and gate variables dropped but the caller's lock options (ARBACE_HEAVY_LOCK, GATE_HEAVY_CMD,
# ARBACE_HEAVY_HELD), GATE_TEST_JOBS, ARBACE_GOROOT and JDK; the clone's own bin/gate run in it with
# GATE_CLEAN_INNER=1 (below); then its record copied to test/gate/clean-TAG.edn, its logs to
# .tmp/gate-clean/SHA.logs/, its passes (marked :clean) into the store and its executables' directories
# into ARBACE_GATE_EXES where absent (GATE_CLEAN_PUBLISH=0: not), and the clone removed (on a failure
# kept, its Go cache removed; GATE_CLEAN_KEEP=1: kept)
clean_launch() {
  local sha tag main common dir base st v keep=() unset=() frozen out t0 n d e store_to exes_to
  t0=$(date +%s)
  sha=$(git rev-parse HEAD) || return 1
  tag=${clean_tag:-${GATE_CLEAN_TAG:-$(git rev-parse --short=12 HEAD)}}
  case $tag in */*|"") echo "gate --clean: a tag names a file (test/gate/clean-TAG.edn): $tag" >&2; return 2 ;; esac
  [ -z "$(git status --porcelain --untracked-files=no 2>"$TMPDIR/gate-git.err")" ] \
    || echo "gate --clean: warning: the checkout has uncommitted changes; the clean run tests the commit $sha alone"
  main=$(main_checkout)
  common=$(git rev-parse --path-format=absolute --git-common-dir)
  base=${GATE_CLEAN_ROOT:-$root/.tmp/gate-clean}
  dir=$base/$sha out=$base/$sha.logs
  mkdir -p "$base" || return 1
  [ -e "$dir" ] && { chmod -R u+w "$dir" 2>"$TMPDIR/gate-clean.err"; rm -rf "${dir:?}"; }
  echo "== gate$( [ -n "$full" ] && echo ' --full') --clean: $(git log -1 --format='%h %s'), tag $tag, in $dir"
  git clone -q --shared --no-checkout "$common" "$dir" && git -C "$dir" checkout -q --detach "$sha" \
    || { echo "gate --clean: the clone failed" >&2; return 1; }
  mkdir -p "$dir/.tmp/tmp" "$dir/.tmp/gocache"
  # the frozen jar: the main checkout's (pinned: the clone's pins step checks it), else the clone builds it
  frozen=${FROZEN_JAR:-$main/.tmp/oracle-frozen/arbace-for-java-26-v4.jar}
  [ -f "$frozen" ] || frozen=
  for v in $(compgen -e); do
    case $v in
      ARBACE_GOROOT|ARBACE_HEAVY_LOCK|ARBACE_HEAVY_HELD|GATE_HEAVY_CMD|GATE_TEST_JOBS) ;;
      ARBACE_*|GATE_*|J2G_*|REPR_*|JAVA_CHECK_*|CLOJURE_TESTS_*|GOI_*|FROZEN_*|JAVAC_*|BOX_*|HEAVY_LOCK_*|TMPDIR|GOCACHE|GOFLAGS|GOROOT|GOOS|GOARCH|GOMEMLIMIT) unset+=(-u "$v") ;;
    esac
  done
  env ${unset[@]+"${unset[@]}"} TMPDIR="$dir/.tmp/tmp" GOCACHE="$dir/.tmp/gocache" GATE_CLEAN_INNER=1 GATE_CLEAN_TAG="$tag" \
      ARBACE_HEAVY_LOCK="${ARBACE_HEAVY_LOCK:-$main/.tmp/big.lock}" ${frozen:+FROZEN_JAR="$frozen"} \
      "$dir/bin/gate" ${full:+--full} --clean 2>&1 | tee "$base/$sha.out"
  st=${PIPESTATUS[0]}
  rm -rf "${out:?}"; mkdir -p "$out"
  cp -a "$dir/.tmp/gate" "$out/gate" 2>"$TMPDIR/gate-clean.err"
  cp "$base/$sha.out" "$out/summary.txt"
  if [ -f "$dir/.tmp/gate/clean-record.edn" ]; then
    cp "$dir/.tmp/gate/clean-record.edn" "$root/test/gate/clean-$tag.edn"
    echo "   the record: test/gate/clean-$tag.edn"
  else
    echo "gate --clean: no record (the run stopped before its end: $out)"; st=1
  fi
  echo "   the logs: ${out#$root/}/"
  if [ "${GATE_CLEAN_PUBLISH:-1}" != 0 ]; then
    # the passes (:clean) into the store the everyday gate reads, beside its own (none replaced); the
    # executables and javac's tool, when the run passed, into the shared directory where absent
    store_to=${ARBACE_GATE_STORE:-$main/.tmp/gate-pass} exes_to=${ARBACE_GATE_EXES:-$main/.tmp/gate-exe}
    n=0
    for d in "$dir/.tmp/gate-pass"/*/; do
      [ -d "$d" ] || continue
      mkdir -p "$store_to/$(basename "$d")" && cp -an "$d". "$store_to/$(basename "$d")/" && n=$((n + $(ls "$d" | grep -c '\.edn$')))
    done
    echo "   $n passes (:clean) published into $store_to"
    if [ "$st" = 0 ]; then
      for e in "$dir/.tmp/gate-exe"/*; do
        [ -d "$e" ] || continue
        if [ -e "$exes_to/$(basename "$e")" ]; then echo "   the executables $(basename "$e") kept in $exes_to (there already)"
        else mkdir -p "$exes_to" && mv "$e" "$exes_to/" && echo "   the executables $(basename "$e") published into $exes_to"; fi
      done
    fi
  fi
  if [ "$st" = 0 ] && [ -z "${GATE_CLEAN_KEEP:-}" ]; then
    chmod -R u+w "$dir" 2>"$TMPDIR/gate-clean.err"; rm -rf "${dir:?}"; echo "   the clone removed"
  else
    rm -rf "${dir:?}/.tmp/gocache"
    echo "   the clone kept (its Go cache removed): $dir; rm -rf it when done"
  fi
  if [ "$st" = 0 ]; then echo "== gate --clean passed ($(secs "$t0"))"; else echo "== gate --clean FAILED ($(secs "$t0"))"; fi
  return "$st"
}

# clean_record: the clean run's record (test/gate/clean-TAG.edn, the Clojure reader's format): the
# commit, the pins, the hosts' identities, and each step's key, outcome, wall and CPU seconds, peaks,
# lock waits, audit and the programs its limits measured (GTS33 (a))
clean_record() {
  local n st s a ex k cpus prog
  echo ";; bin/gate$( [ -n "$full" ] && echo ' --full') --clean's record (doc/GATE-SURVEY.md, §7, GT7, \"As built: GT7 (tooling)\"):"
  echo ";; a fresh clone of the commit, empty caches, every step run and audited; written by bin/gate."
  printf '{:tag "%s"\n :commit "%s"\n :date "%s"\n :mode :%s\n :status :%s\n :wall-s %s\n' \
    "${GATE_CLEAN_TAG:-}" "$commit" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$mode" "$([ "$status" = 0 ] && echo passed || echo failed)" $(( $(date +%s) - start ))
  printf ' :host {:cpus %s :mem-kib %s :kernel "%s"}\n' "$(nproc)" "$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)" "$(uname -r)"
  printf ' :env {:all-parts true :forms-only true :heavy-cmd "%s"}\n' "$GATE_HEAVY_CMD"
  printf ' :pins %s\n' "$(cat "$logs/pins.edn" 2>"$logs/count.err" || echo nil)"
  printf ' :hosts %s\n' "$(cat "$logs/hosts.edn")"
  printf ' :steps\n ['
  local first=1
  for n in pins "${order[@]}"; do
    [ -f "$logs/$n.status" ] || continue
    st=$(cat "$logs/$n.status"); ex=
    case $st in 0) s=:pass ;; skip) s=:skip ;; none) s=:not-needed ;; notrun*) s=:not-run ;; *) s=:fail ex=" :exit $st" ;; esac
    [ "$s" = :not-needed ] && continue
    a=:none
    if [ -f "$logs/$n.audit-status" ]; then
      case $(cat "$logs/$n.audit-status") in ok) a=:ok ;; step-failed) a=:step-failed ;; *) a="\"$(cat "$logs/$n.audit-status")\"" ;; esac
    fi
    k=${key[$n]:-}; [ "$k" = - ] && k=
    prog=
    if [ -f "$logs/$n.cpu.tsv" ]; then
      prog=$(awk -F'\t' '{n++; c += $3 + $4; if ($1 == 124 || $1 == 137 || $1 == 152) t++} END {printf " :programs %d :programs-cpu-s %.1f :programs-timeouts %d", n, c, t}' "$logs/$n.cpu.tsv")
    fi
    [ -n "$first" ] || printf '\n  '
    first=
    printf '{:step "%s" :kind :%s :status %s%s :key "%s" :wall-s %s :cpu-s %s :maxrss-kib %s :tree-peak-kib %s :wait-s %s :inner-wait-s %s :audit %s%s%s}' \
      "$n" "${kind[$n]:-pre}" "$s" "$ex" "$k" "$(mem_of "$n" wall-s)" "$(mem_of "$n" cpu-s)" "$(mem_of "$n" maxrss-kib)" "$(mem_of "$n" tree-peak-kib)" \
      "$(mem_of "$n" wait-s)" "$(mem_of "$n" inner-wait-s)" "$a" \
      "$( [ -f "$logs/$n.audit-aborts" ] && echo " :audit-aborts $(cat "$logs/$n.audit-aborts")")" "$prog"
  done
  printf ']}\n'
}

if [ -n "$pins" ]; then clean_pins "$pins_out"; exit; fi
if [ -n "$clean" ] && [ -z "${GATE_CLEAN_INNER:-}" ]; then
  if [ -z "$plan_only" ]; then clean_launch; exit; fi
  # --clean --plan: the plan a clean run makes (an empty store and executables' directory, every part,
  # every check run), here, on this checkout's stage 0
  export ARBACE_GATE_STORE=$root/.tmp/gate-clean-plan/store ARBACE_GATE_EXES=$root/.tmp/gate-clean-plan/exes GATE_ALL_PARTS=1
  rm -rf "$root/.tmp/gate-clean-plan"; rerun=1
fi
# --concurrent (GTS37 (a)): --full's chains at once, the host's big lock held once from outside for the
# whole run (bin/heavy-lock: in turn; GATE_CONCURRENT_HELD=1 when the caller holds it already), the
# heavy steps and the tools' heavy processes serialized on a lock of the gate's own (GATE_CONCURRENT_LOCK,
# default .tmp/gate-concurrent.lock): one heavy process at a time, the light work beside it
if [ -n "$concurrent" ]; then
  [ -n "$plan_only" ] && usage
  if [ -z "${GATE_CONCURRENT_HELD:-}" ]; then
    echo "== gate --full --concurrent: the host's big lock first (${ARBACE_HEAVY_LOCK:-$(main_checkout)/.tmp/big.lock}, in turn)"
    exec "$root/bin/heavy-lock" env GATE_CONCURRENT_HELD=1 "$root/bin/gate" "${orig_args[@]}"
  fi
  unset ARBACE_HEAVY_HELD # the private lock below is the one the steps and the tools take
  export GATE_FULL_PARALLEL=1
  GATE_HEAVY_CMD="flock ${GATE_CONCURRENT_LOCK:-$root/.tmp/gate-concurrent.lock}"
fi
gate_env || { echo "gate: the environment failed" >&2; exit 1; }
# the clean run itself (GATE_CLEAN_INNER=1, in the clone clean_launch made): passes not read (an empty
# store, every check run: --rerun), serial, every step under the audit, every part (GTS19 (a)), Java's
# levels on the read's cache forced (GTS41 (c)), the programs' CPU times measured (GTS33 (a))
audit_all= serial=
if [ -n "${GATE_CLEAN_INNER:-}" ]; then
  rerun=1 audit_all=1 serial=1
  export GATE_ALL_PARTS=1 JAVA_CHECK_FORMS_ONLY=1 GATE_CPU_LOG=1
  unset GATE_FULL_PARALLEL
fi

if [ -n "$prune" ]; then gate_prune $dry; exit; fi
if [ -n "$audit" ]; then
  bin/seed --build --no-aot > "$root/.tmp/gate-audit-stage0.log" 2>&1 || { tail -5 "$root/.tmp/gate-audit-stage0.log"; exit 1; }
  gate_audit "${steps_arg[@]}"; exit
fi
if [ -n "$plan_only$why" ]; then
  d=$root/.tmp/gate-plan
  rm -rf "${d:?}"
  if [ -n "$why" ]; then
    run_plan "$d" > "$d.txt" 2>&1 || { cat "$d.txt"; exit 1; }
    arbace_tool -p "$root/test" -m gate.plan why "$root" "$d" "$store" "$why"
  elif [ -n "$builds" ]; then
    # --plan --builds (GTS42 (a)'s demonstrations): the builds the plan needs (go-build, with --full
    # javac-tool), run as the gate runs them, then the plan again on their program units
    echo "== gate$( [ -n "$full" ] && echo ' --full') --plan --builds: $(git log -1 --format='%h %s'), store $store"
    logs=$d
    run_plan "$d" > "$d.first.txt" 2>&1 || { cat "$d.first.txt"; exit 1; }
    load_plan
    for n in "${order[@]}"; do
      [ "${kind[$n]}" = build ] && [ "${dec[$n]}" = build ] || continue
      run_one "$n"; report "$n"
      ok_status "$n" || { tail -20 "$d/$n.log"; exit 1; }
    done
    rm -f "$d"/*.done
    run_plan "$d"
  else
    echo "== gate$( [ -n "$full" ] && echo ' --full')$( [ -n "$clean" ] && echo ' --clean') --plan: $(git log -1 --format='%h %s'), store $store"
    run_plan "$d" ${rerun:+--rerun}
  fi
  exit
fi

logs=$root/.tmp/gate
rm -rf "${logs:?}"
mkdir -p "$logs"
start=$(date +%s)
status=0
commit=$(git rev-parse HEAD 2>"$TMPDIR/gate-git.err" || echo unknown)
dirty=false; [ -z "$(git status --porcelain --untracked-files=no 2>"$TMPDIR/gate-git.err")" ] || dirty=true

echo "== gate$( [ -n "$full" ] && echo ' --full'): $(git log -1 --format='%h %s')"
# Go's build cache, trimmed by every gate run (bin/lib/gocache.bash)
. "$root/bin/lib/gocache.bash"
gocache_trim

sampler &
sampler_pid=$!
trap 'kill "$sampler_pid" 2>"$logs/sampler.err"' EXIT

# the clean run (GT7): first what it takes from outside the clone, by its pins; the audit's reducer
if [ -n "${GATE_CLEAN_INNER:-}" ]; then
  pre_step pins '^pins:' 12 "$root/bin/gate" --pins "$logs/pins.edn"
  audit_reducer "$root/.tmp/gate-audit"
fi
# before the plan, one after the other: each needs the one before (steps.edn's :pre)
pre_step makefile - 0 make -s check-makefile
pre_step seed 'pinned' 1 bin/seed --check
audit_step=${audit_all:+1} pre_step stage0 'bin/seed: .*arbace|stage 0 in|stage 0 kept' 2 bin/seed --build --no-aot
# the plan (GT2): each step's key, run or skipped
t0=$(date +%s)
if ! run_plan "$logs" ${rerun:+--rerun} > "$logs/plan.log" 2>&1; then
  cat "$logs/plan.log"; echo "== gate FAILED: no plan ($(secs "$start"))"; exit 1
fi
load_plan
echo "   ok  plan ($(secs "$t0"); store $store; .tmp/gate/plan.log)"
# GTS53 (a): stage 0's own build, traced above (the clean run), against its declarations (the plan's files)
if [ -n "$audit_all" ]; then
  audit_compare stage0 0
  if [ "$(cat "$logs/stage0.audit-status")" != ok ]; then
    grep -A8 '^UNDECLARED' "$logs/stage0.audit" | sed 's/^/     /'
    echo "== gate FAILED: stage0's audit is $(cat "$logs/stage0.audit-status") ($logs/stage0.audit)"; exit 1
  fi
  echo "   ok  stage0's audit"
fi
sed -n '1p' "$logs/plan.log" | sed 's/^/     /'

# the builds (go-build; with --full javac-tool), one after the other, when needed: all of them before
# the checks (GT5), so that the program hosts' units are known to a second plan
built=
for n in "${order[@]}"; do
  [ "${kind[$n]}" = build ] || continue
  [ "${dec[$n]}" = build ] && built=1
  run_one "$n"; report "$n"
  if ! ok_status "$n" && [ "${dec[$n]}" = build ]; then
    tail -20 "$logs/$n.log"; echo "== gate FAILED ($(secs "$start"))"; exit 1
  fi
done
# the second plan (GT5): a check on a program host (:prog, :javac-prog) whose build was not there was
# planned to run; now its identity is the build's units, and it may be skipped
if [ -n "$built" ]; then
  cp "$logs/plan.tsv" "$logs/plan1.tsv"; cp "$logs/plan.log" "$logs/plan1.log"
  t0=$(date +%s)
  if ! run_plan "$logs" ${rerun:+--rerun} > "$logs/plan.log" 2>&1; then
    cat "$logs/plan.log"; echo "== gate FAILED: no second plan ($(secs "$start"))"; exit 1
  fi
  load_plan
  echo "   ok  plan, again after the builds ($(secs "$t0"); .tmp/gate/plan.log, the first .tmp/gate/plan1.log)"
  sed -n '1p' "$logs/plan.log" | sed 's/^/     /'
fi

# the essential checks, concurrently on the cached executables. The heavy ones (the whole-program
# j2g runs, the suite's 12 processes) take the heavy lock each, one at a time (GT6: it replaces
# bin/j2g's J2G_LOCK here), the light ones run beside them
if [ -n "$serial" ]; then
  # the clean run: one after another in the table's order (§7)
  for n in $(names_of essential); do run_one "$n"; done
else
  pids=()
  for c in $(chains_of essential); do run_chain essential "$c" & pids+=($!); done
  wait "${pids[@]}"
fi
for n in $(names_of essential); do [ "${kind[$n]}" = build ] || report "$n"; done

if [ -n "$full" ]; then
  if [ -n "${GATE_FULL_PARALLEL:-}" ]; then
    pids=()
    for c in $(chains_of full); do run_chain full "$c" & pids+=($!); done
    wait "${pids[@]}"
  else
    for n in $(names_of full); do run_one "$n"; done
  fi
  for n in $(names_of full); do [ "${kind[$n]}" = build ] || report "$n"; done
  # GTS34 (a): the store trimmed at the end of every --full (seconds)
  gate_prune > "$logs/prune.log" 2>&1 || echo "gate: warning: the store's prune failed ($logs/prune.log)"
  tail -1 "$logs/prune.log" | sed 's/^/   /'
fi
ran=0 skipped=0
for n in "${order[@]}"; do
  case $(cat "$logs/$n.status" 2>"$logs/count.err") in skip) skipped=$((skipped + 1)) ;; none) ;; ?*) ran=$((ran + 1)) ;; esac
done
peak=$(awk -F'\t' '$2 == "gate" && $3 > m {m = $3} END {print m + 0}' "$logs/mem.tsv" 2>"$logs/count.err")
low=$(awk -F'\t' '$2 == "MemAvailable" && (m == "" || $3 < m) {m = $3} END {print m + 0}' "$logs/mem.tsv" 2>"$logs/count.err")
echo "   $ran steps run, $skipped skipped; the gate's processes at most $(gib "$peak"), the host's MemAvailable at least $(gib "$low") (.tmp/gate/mem.tsv)"
[ -n "${GATE_CLEAN_INNER:-}" ] && clean_record > "$logs/clean-record.edn"
if [ $status = 0 ]; then echo "== gate passed ($(secs "$start"))"; else echo "== gate FAILED ($(secs "$start"))"; fi
exit $status

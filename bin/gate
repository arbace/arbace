#!/bin/bash
# The gate: the checks a change must pass before it is committed to main. Since standalone S4
# (doc/STANDALONE-NOTES.md, "S4: the JVM removed") the bootstrap starts from the Go-source seed
# and every build is Go-hosted; the JVM runs only the oracle's reference (the frozen v4 jar) and,
# with --full, the checks of what the JVM made (the edges), the reference javac, the frozen
# back end of repr/java's check --suite, jrt-convert's edge step and the JDK build's generators;
# since JN5 repr/java's checks run on javac's tool executable, and since JN6 nothing of repr/java
# starts a JVM (doc/classes/JAVA-FRONTEND-SURVEY.md, JFS9, "As built: JN5", "As built: JN6").
#
# Usage: bin/gate [--full]
#   (default)  the essential gate:
#                0. makefile      make check-makefile: every bin/ script the Makefile (the
#                                 newcomers' interface) runs exists (seconds)
#                1. seed          bin/seed --check: the seed is the pinned one
#                2. stage0        bin/seed --build: stage 0, the host of the build's tools, built
#                                 from the seed by Go's toolchain (target/seed; seconds with Go's
#                                 build cache warm)
#                3. go-build      bin/arbace-go --gate-build: the executable and the test build
#                                 (amd64), j2g and repr/go on stage 0, cached in
#                                 .tmp/arbace-go-gate and built again only when what they are
#                                 built from changed (gate_key: Arbace's sources, go/, overlay/,
#                                 jdk/, the fixtures' forms, the build's scripts, the seed's and
#                                 the toolchain's pins): seconds on a hit, two Go-hosted builds
#                                 on a miss
#                4. concurrently, on the cached executables:
#                   go-smoke      bin/arbace-go --gate: the smoke test (seconds)
#                   suite-go      Clojure's suite on the test build, against
#                                 test/arbace-go-results.edn (repr/clojure's translation on stage 0)
#                   oracle-go     bin/oracle check on the executable against the frozen JVM
#                                 Arbace's expected results, with its known mismatches,
#                                 test/oracle/known-go-amd64-frozen.edn
#                   goi-check     bin/goi check --essential: the programs of $GOROOT/test listed in
#                                 test/goi/essential.txt interpreted by goi against gc, against
#                                 test/goi/check-linux-amd64.edn (doc/go/GOI-SPEC.md §11.5, GS12;
#                                 gc's references cached in .tmp/goi-check)
#                   j2g-edge      (essential since 2026-10-24) bin/j2g-edge verify, on the frozen
#                                 JVM (bin/lib/frozen.bash): j2g's edge recorded afresh and compared
#                                 byte for byte with jdk/edge.edn (about 1.5 minutes)
#                   reap          bin/reap: the REAP matrix from the checks' recorded results
#                                 (doc/FULL-SUPPORT-SURVEY.md, REAP1, RPS13): every non-pass of a
#                                 recorded check in a class of its level's classes file (seconds)
#   --full     also, once those are done, concurrently:
#                   go            the Go build afresh, one after the other:
#                     go-build-full ARBACE_GO_ARCHES=amd64 bin/arbace-go --build, then --smoke
#                     javac         javac's forms and javac on Arbace (doc/classes/
#                                   JAVA-FRONTEND-SURVEY.md, JN2, JN3, JN5, JFS26, JFS9): bin/javac-vendor
#                                   check (j2g translates javac's world), build (the tool
#                                   executable, j2g on the build just made; copied into
#                                   .tmp/gate-javac, the java chain's), verify (jdk/javac read
#                                   afresh by javac on Arbace, the fixpoint, its edge recorded on
#                                   the frozen JVM: byte for byte), classes baseline samples jdk
#                                   java.base (javac on Arbace's class files against the JVM's
#                                   javac's, byte for byte, and java.base's against the JDK
#                                   build's)
#                     java          after javac, concurrently with the rest of the go chain,
#                                   repr/java's checks on the tool executable just built
#                                   (REPR_JAVA_EXE), one after the other:
#                       repr-java     bin/repr-java check --suite (the converter's checks, and
#                                     Clojure's suite on the converted baseline, compiled by the
#                                     frozen jar's back end and run on the JVM)
#                       repr-java-roundtrip  bin/repr-java roundtrip --corpus baseline,samples,jdk
#                                     --text (Java -> forms -> Java -> forms, levels forms, ae and
#                                     classes by javac on Arbace, then the text level: mode :full
#                                     printed back byte for byte, against test/repr/java/roundtrip/)
#                       jrt-convert   bin/jrt-convert verify (jdk/'s forms converted afresh by
#                                     repr/java and compared byte for byte: jdk/README.md; its
#                                     generators on a JDK, its edge step on the frozen JVM)
#                       java-fixtures bin/clojure-tests --java-fixtures verify (the suite's Java
#                                     fixtures converted afresh by repr/java, compared with
#                                     test/java-fixtures)
#                       repr-java-parse  bin/repr-java parse-check (repr/java's native parser:
#                                     every file of the samples, the baseline, the jdk corpus's and
#                                     javac's sources, jdk26u's 68 modules, the mutants and
#                                     jdk26u's tests parsed
#                                     to javac on Arbace's trees, positions included, against
#                                     test/repr/java/parse-check-known.edn; doc/classes/
#                                     JAVA-FRONTEND-SURVEY.md, "As built: JN8", JFS60)
#                       repr-java-front  bin/repr-java front-check (the converter on the native
#                                     parser's trees, javac's attribution by position: its forms
#                                     equal to javac's trees' over the samples, the baseline, the
#                                     jdk corpus and javac's sources, the split measured; "As
#                                     built: JFS66 (b)", JFS67)
#                       repr-java-attr   bin/repr-java attr-check (the native attribution provider:
#                                     the native trees' scope and declarations tiers answered
#                                     without javac, each fact equal to javac on Arbace's, the forms
#                                     still javac's trees', over the same corpora, against
#                                     test/repr/java/attr-check-known.edn; "As built: JN9a", JFS74)
#                     box-forms     bin/arbace-go --build --box for amd64 and arm64 (the guests
#                                   from tamago/'s forms), then bin/tamago-vendor check: each
#                                   guest byte-identical to one built from TamaGo's originals
#                     box-smoke     ARBACE_BOX_ARCHES=amd64 bin/arbace-go --smoke --box (the
#                                   box's smoke test on /dev/kvm)
#                     box-oracle    the oracle's subset in the box (amd64, /dev/kvm; every corpus
#                                   but the host's files and processes, goi's crossings included
#                                   since GR7a, ARBACE_BOX_NET=loopback)
#                                   against test/oracle/known-go-box-amd64.edn (about 1 minute)
#                     box-suite     bin/box-suite: Clojure's suite's subset in the box, against
#                                   test/arbace-box-results.edn (suite-go's renamed suite; about
#                                   3 minutes)
#                     fixpoint      bin/arbace-go --fixpoint: G1 by stage 0, G2 by G1, G3 by G2;
#                                   G2 = G3 (j2g's trees and the executables); G1 = G2 and stage
#                                   0 = G1 reported (they hold when the seed is current)
#                   repr-go       bin/repr-go roundtrip amd64, then linux/amd64 (Go -> forms -> Go
#                                 over std and $GOROOT/test, against test/repr/go/roundtrip-*.edn);
#                                 bin/repr-go roundtrip --text amd64 (mode :full, each file printed
#                                 back byte for byte, but test/repr/go/roundtrip-text-known.edn's);
#                                 $GOROOT/test's directory tests: roundtrip --dirs amd64, then
#                                 linux/amd64 (with the level run), --text --dirs amd64 (about 20
#                                 s together; test/repr/go/roundtrip-dirtest-*.edn);
#                                 then the box's vendored packages: bin/box-vendor roundtrip,
#                                 kvm-tests (box/'s KVM tests: hv, vmm, tree and the guest
#                                 tests, on /dev/kvm), purego-check; bin/tamago-vendor verify
#                                 (tamago/ converted afresh, compared byte for byte);
#                                 bin/x509roots-vendor verify and check
#                   repr-go-native after repr-go: bin/repr-go native-check --fresh (the native
#                                 reader's trees, go/parser run by goi, equal to the helper's
#                                 dumps over every corpus, afresh; its raw forms resolved by the
#                                 final ones; the final forms of its dumps annotated by goi's
#                                 checker equal to the helper's; against
#                                 test/repr/go/native-known.edn; doc/go/GO-PARSER-SURVEY.md,
#                                 GPS8 (a), "As built: GP1", "As built: GP4")
#                   goi           after repr-go, on its fresh conversions: bin/goi annotations
#                                 (goi's checker over tamago/goroot, the linux std, $GOROOT/test and
#                                 its directory tests: no error, every annotation verified, against
#                                 test/goi/annotations-*.edn; doc/go/GOI-SPEC.md §11.4), bin/goi
#                                 test --gc (the checker's tests, gc's messages; the interpreter's
#                                 programs against gc, the REPL's tests) and bin/goi check --jobs 8
#                                 (every run program of $GOROOT/test against gc, §11; 8 jobs, as
#                                 its reference was recorded: with 16 beside the other steps
#                                 nosplit.go and bug358.go exceed the 10 s), on the gate's executable
#                   box-goi       after every chain: bin/goi check --box (goi's check in the box,
#                                 GS13, GR7a: test/goi/box.txt's programs run by the amd64 guest
#                                 on /dev/kvm against gc, against test/goi/check-box-amd64.edn;
#                                 about 5 minutes with 8 boxes)
#                   repr-haskell  bin/repr-haskell roundtrip --iface --text --layout (Haskell -> forms ->
#                                 Haskell over GHC 9.14.1's boot libraries, 41 packages (R1, R5):
#                                 GHC's trees and lines, against test/haskell/roundtrip-ghc-9.14.1-known.edn;
#                                 the same forms printed by the layout rule, against
#                                 test/haskell/roundtrip-ghc-9.14.1-layout-known.edn; then the
#                                 interfaces of the originals and of both printings compiled at -O1,
#                                 against test/haskell/roundtrip-ghc-9.14.1-iface-known.edn and
#                                 -layout-iface-known.edn; then mode :full printed back byte for byte
#                                 and GHC's trees of mode :full, against
#                                 test/haskell/roundtrip-ghc-9.14.1-text-known.edn), then
#                                 bin/repr-haskell test (the reader's samples, the spec's worked
#                                 example, the interface level's cases, mode :full, the layout
#                                 layout, R5's cases); on the host's GHC
#                                 (doc/haskell/HASKELL-NOTES.md; about 10 minutes)
#                   repr-rust     bin/repr-rust roundtrip --iface --text --pretty (Rust -> forms -> Rust
#                                 over std's five crates of the pinned rustc, 1.99.1's rust-src:
#                                 rustc's trees and lines, against
#                                 test/rust/roundtrip-rustc-1.99.1-known.edn; then rustdoc's JSON of
#                                 each crate from the originals and from the printed files, compared
#                                 without spans, against test/rust/roundtrip-rustc-1.99.1-iface-known.edn;
#                                 then the forms without positions in the pretty layout, their trees;
#                                 then mode :full printed back to the original text byte for byte,
#                                 against test/rust/roundtrip-rustc-1.99.1-text-known.edn), then
#                                 bin/repr-rust test (the reader's samples, the spec's worked
#                                 example and its round trip, the interface level's cases, mode
#                                 :full's, edition 2015's, the pretty layout's, the behaviour case,
#                                 the lowered and code levels' case and an expression file);
#                                 on the host's rustc, with rustc-dev and rust-src fetched as apks
#                                 into .tmp/ (doc/rust/RUST-NOTES.md; about 3 minutes).
#                                 REPR_RUST_CORPORA=all adds RR4's corpora (the rest of library/,
#                                 the compiler, the pinned crate set: about 40 minutes more) and
#                                 RR5's UI suite (rustc-1.99.1-src.tar.xz's tests/ui: about 4
#                                 minutes more); REPR_RUST_CORPORA='all --run --std' the behaviour
#                                 level too (the UI suite's run-pass programs run from the originals
#                                 and the printed files, then against std built from its printed
#                                 files: about 5 minutes more); REPR_RUST_CORPORA='all --code' the
#                                 lowered and code levels (the HIR, MIR and objects of the library
#                                 corpora's crates and of the UI suite's programs, built from the
#                                 originals and the printed files: about 13 minutes more)
#                   repr-clojure  bin/repr-clojure check (read's and print's unit tests), --suite
#                                 (Clojure's suite translated against its digest, then printed
#                                 back byte for byte) and --roundtrip (Clojure -> Arbace ->
#                                 Clojure over the frozen clojure/, the suite and its libraries,
#                                 Arbace -> Clojure -> Arbace over arbace/, against
#                                 test/repr/clojure/roundtrip-known.edn); on the tools' host
#                                 (about 1 minute)
#                   diffcheck     (in the essential steps since 2026-10-17, F2.1) bin/diffcheck: the per-form differential check (Futamura
#                                 F2, doc/FUTAMURA-SURVEY.md "F2 as built"): the oracle's forms
#                                 evaluated against compiled by the back end, the Java forms
#                                 interpreted against translated by j2g, in a program built for
#                                 it from the gate's executable, against test/diffcheck/known.edn
#                   generated     (essential, F7.3) bin/generated-check: arbace/lang/go/CompilerNodes.ae
#                                 and CompilerAOTFn.ae regenerated by test/c2j/gen_nodes.ae and
#                                 gen_fns.ae on the gate's executable, compared with the committed
#                                 files (seconds)
#                   toolchain     Go's toolchain as forms (standalone S9): bin/toolchain-vendor
#                                 verify (tamago/cmd/ converted afresh for linux/amd64,
#                                 tamago/amd64 and tamago/arm64, compared byte for byte), then
#                                 check (compile, link and asm built from the printed forms and
#                                 from the originals, byte-identical, for the three)
#              (arm64, under qemu, stays out: its suite takes hours)
# Every build and tool needs TamaGo's go (ARBACE_GOROOT, default /root/tamago-go), never the host's.
# The gate first trims Go's build cache of entries unused for 90 minutes (bin/lib/gocache.bash,
# ARBACE_GOCACHE_KEEP_MIN). ARBACE_HOST_EXE is ignored: the gate's host is stage 0.
# Logs go to .tmp/gate/NAME.log; the summary prints each check's outcome and wall time.
# Environment: GATE_TEST_JOBS, the suite's parallel processes (default 12).
# Exit status: 0 when every check passed.
set -uo pipefail
export CGO_ENABLED=0 # Go's builds never use cgo (doc/go/BOX-NOTES.md, "... cgo dropped", 2026-10-16)
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash" # TMPDIR: .tmp/tmp when unset
. "$root/bin/lib/renamed-env.bash" # stops on a stale G2A_*, J2A_*, A2G_* or C2A_*
cd "$root"
unset ARBACE_HOST_EXE J2G_GO_EXE REPR_GO_EXE
full=
case ${1:-} in
  "") ;;
  --full) full=1 ;;
  *) echo "usage: bin/gate [--full]" >&2; exit 2 ;;
esac
logs=$root/.tmp/gate
rm -rf "$logs"
mkdir -p "$logs"
jobs=${GATE_TEST_JOBS:-12}
start=$(date +%s)
secs() { local s=$(( $(date +%s) - $1 )); printf '%dm%02ds' $((s / 60)) $((s % 60)); }
summary() { grep -E "$2" "$logs/$1.log" | tail -${3:-2} | sed 's/^/     /'; }
status=0

echo "== gate$( [ -n "$full" ] && echo ' --full'): $(git log -1 --format='%h %s')"
# Go's build cache, trimmed by every gate run (bin/lib/gocache.bash)
. "$root/bin/lib/gocache.bash"
gocache_trim

step() {  # step NAME COMMAND...: one check, logged, its status and seconds recorded
  local name=$1 t0; shift; t0=$(date +%s)
  "$@" > "$logs/$name.log" 2>&1
  local st=$?
  echo $st > "$logs/$name.status"; echo $(( $(date +%s) - t0 )) > "$logs/$name.secs"
  return $st
}
report() {  # report NAME: a check's outcome, wall time and summary lines
  local name=$1 s w
  if [ ! -f "$logs/$name.status" ]; then
    echo "   FAILED  $name (not run: an earlier step failed)"; status=1; return
  fi
  s=$(cat "$logs/$name.secs"); w=$(printf '%dm%02ds' $((s / 60)) $((s % 60)))
  if [ "$(cat "$logs/$name.status")" = 0 ]; then
    echo "   ok  $name ($w)"
  else
    echo "   FAILED  $name ($w; log $logs/$name.log)"; status=1
  fi
  case $name in
    seed) summary seed 'pinned' 1 ;;
    stage0) summary stage0 'bin/seed: .*arbace|stage 0 in' 2 ;;
    go-build) summary go-build 'cached executables|building the executables|built in|FAIL' 3 ;;
    go-smoke|go-build-full) summary "$name" 'ok|FAIL' 1 ;;
    suite-go|repr-java) summary "$name" 'TOTAL|regressions' ;;
    oracle-go|box-oracle) summary "$name" '^== ' ;;
    box-suite) summary box-suite '^TOTAL|FAIL' 2 ;;
    jrt-convert) summary jrt-convert '^verify:|^jrt-convert:' 2 ;;
    j2g-edge) summary j2g-edge '^j2g-edge:' 1 ;;
    java-fixtures) summary java-fixtures '^verify:' 1 ;;
    repr-java-parse) summary repr-java-parse '^[a-z0-9]*: [0-9]* files|^parse-check:' 7 ;;
    repr-java-front) summary repr-java-front '^[a-z0-9]*: [0-9]* forms files|^front-check:' 5 ;;
    repr-java-attr) summary repr-java-attr '^[a-z0-9]*: [0-9]* forms files|^attr: |^attr-check:' 8 ;;
    javac) summary javac '^javac-vendor|^   [a-z.-]*: ' 11 ;;
    box-forms) summary box-forms 'identical|differ|FAIL' 3 ;;
    box-smoke) summary box-smoke 'checks|ok|FAIL' 2 ;;
    fixpoint) summary fixpoint '^fixpoint:' 9 ;;
    repr-go) summary repr-go '^package|^test |regressions|FAIL|^ok' 8 ;;
    repr-go-native) summary repr-go-native '^E-tree:|DIFF|FAIL' 4 ;;
    repr-haskell) summary repr-haskell '^repr-haskell roundtrip|^ok|FAIL' 8 ;;
    repr-rust) summary repr-rust '^repr-rust roundtrip|FAIL' 6 ;;
    repr-clojure) summary repr-clojure '^Ran |failures|^repr-clojure suite|^repr-clojure roundtrip' 10 ;;
    diffcheck) summary diffcheck '^== |^diffcheck: the runs' 5 ;;
    generated) summary generated '^generated-check:' 2 ;;
    goi-check|box-goi) summary "$name" '^goi check:|regression|no reference' 3 ;;
    reap) summary reap '^\| (Clojure|Java|Go) \||^reap: [0-9]+ of' 4 ;;
    toolchain) summary toolchain '^verify:|identical|DIFFERENT' 10 ;;
  esac
}

# 0-3, one after the other: each needs the one before
for s in "makefile make -s check-makefile" "seed bin/seed --check" "stage0 bin/seed --build" "go-build bin/arbace-go --gate-build"; do
  set -- $s
  name=$1; shift
  step "$name" "$@"; report "$name"
  if [ "$(cat "$logs/$name.status")" != 0 ]; then
    tail -20 "$logs/$name.log"; echo "== gate FAILED ($(secs "$start"))"; exit 1
  fi
done

# 4: the checks of the cached executables, concurrently
cache=$root/.tmp/arbace-go-gate/amd64
step go-smoke bin/arbace-go --gate &
step suite-go env CLOJURE_TESTS_GO="$cache/arbace-tests" bin/clojure-tests -j "$jobs" &
# --timeout: the reducers file takes about 285 s of the default 300 (EVAL-NOTES.md, part 4)
step oracle-go bin/oracle check "$cache/arbace -" --timeout 900 --expected test/oracle/known-go-amd64-frozen.edn &
# the per-form differential check (F2), in the essential gate since 2026-10-17 (F2.1)
step diffcheck bin/diffcheck &
# goi's check, its essential subset (GOI-SPEC.md §11.5, GS12): GOROOT/test's programs listed in
# test/goi/essential.txt interpreted against gc
step goi-check env GOI_RUN_EXE="$cache/arbace" bin/goi check --essential --jobs 8 &
# the generated Go-build variants as their generators write them (F7.3)
step generated bin/generated-check "$cache/arbace" &
# j2g's edge recorded afresh on the frozen JVM, in the essential gate since 2026-10-24 (the user):
# an embedded namespace's new JDK class makes jdk/edge.edn stale (GP7's, GP8's)
step j2g-edge bin/j2g-edge verify &
# the REAP matrix: every non-pass of the recorded checks in a class (REAP1, RPS13; seconds)
step reap bin/reap &
wait
for name in go-smoke suite-go oracle-go diffcheck goi-check generated j2g-edge reap; do report "$name"; done

if [ -n "$full" ]; then
  # repr/java's checks on javac's tool executable (JFS9 (a), JN5), the javac step's copy of it
  java_chain() {
    export REPR_JAVA_EXE=$root/.tmp/gate-javac/arbace-javac JAVAC_EXE=$root/.tmp/gate-javac/arbace-javac
    step repr-java env REPR_JAVA_TEST_JOBS="$jobs" bin/repr-java check --suite
    step repr-java-roundtrip bin/repr-java roundtrip --corpus baseline,samples,jdk --text
    step jrt-convert bin/jrt-convert verify
    step java-fixtures bin/clojure-tests --java-fixtures verify
    step repr-java-parse bin/repr-java parse-check
    step repr-java-front bin/repr-java front-check
    step repr-java-attr bin/repr-java attr-check
  }
  go_chain() {
    step go-build-full sh -c 'ARBACE_GO_ARCHES=amd64 bin/arbace-go --build && ARBACE_GO_ARCHES=amd64 bin/arbace-go --smoke' || return 1
    # repr/java's checks wait for the tool, then run beside the rest of the chain
    if step javac sh -c 'bin/javac-vendor check && ARBACE_GO_ARCHES=amd64 bin/javac-vendor build &&
      rm -rf .tmp/gate-javac && mkdir -p .tmp/gate-javac &&
      cp target/arbace-go/amd64/arbace-javac target/arbace-go/amd64/arbace-javac.key .tmp/gate-javac/ &&
      REPR_JAVA_EXE=$PWD/.tmp/gate-javac/arbace-javac bin/javac-vendor verify &&
      JAVAC_EXE=$PWD/.tmp/gate-javac/arbace-javac bin/javac-vendor classes baseline samples jdk java.base'; then
      java_chain &
    fi
    step box-forms sh -c 'ARBACE_GO_ARCHES=amd64 ARBACE_BOX_ARCHES=amd64,arm64 bin/arbace-go --build --box && bin/tamago-vendor check' \
      && step box-smoke env ARBACE_BOX_ARCHES=amd64 bin/arbace-go --smoke --box \
      && step box-oracle env ARBACE_BOX_NET=loopback bin/oracle check 'target/arbace-go/box-amd64/arbace-box -' -j 8 --timeout 900 \
           --exclude forms/files. --exclude forms/processes. --expected test/oracle/known-go-box-amd64.edn \
      && step box-suite bin/box-suite
    step fixpoint bin/arbace-go --fixpoint
    wait
  }
  repr_go_chain() {
    step repr-go sh -c 'bin/repr-go roundtrip amd64 && bin/repr-go roundtrip linux/amd64 && bin/repr-go roundtrip --text amd64 && bin/repr-go roundtrip --dirs amd64 && bin/repr-go roundtrip --dirs linux/amd64 && bin/repr-go roundtrip --text --dirs amd64 && bin/box-vendor roundtrip && bin/box-vendor kvm-tests && bin/box-vendor purego-check && bin/tamago-vendor verify && bin/x509roots-vendor verify && bin/x509roots-vendor check'
    step repr-go-native bin/repr-go native-check --fresh
    # the executable by its absolute path: goi's test runs its programs from their own directories
    step goi sh -c "bin/goi annotations && GOI_RUN_EXE='$cache/arbace' bin/goi test --gc && GOI_RUN_EXE='$cache/arbace' bin/goi check --jobs 8"
  }
  repr_haskell_chain() {
    step repr-haskell sh -c 'bin/repr-haskell roundtrip --iface --text --layout && bin/repr-haskell test'
  }
  repr_rust_chain() {
    step repr-rust sh -c 'bin/repr-rust roundtrip --iface --text --pretty ${REPR_RUST_CORPORA:-} && bin/repr-rust test'
  }
  repr_clojure_chain() {
    step repr-clojure sh -c 'bin/repr-clojure check && bin/repr-clojure check --suite && bin/repr-clojure check --roundtrip'
  }
  toolchain_chain() {
    step toolchain sh -c 'bin/toolchain-vendor verify && bin/toolchain-vendor check'
  }
  go_chain & repr_go_chain & repr_haskell_chain & repr_rust_chain & repr_clojure_chain & toolchain_chain &
  wait
  # goi's check in the box (GS13, GR7a): after the chains, on the box's guest and repr-go's
  # fresh conversions of $GOROOT/test, gc's reference shared with the goi step's
  [ -x target/arbace-go/box-amd64/arbace-box ] && step box-goi bin/goi check --box
  for name in repr-java repr-java-roundtrip jrt-convert java-fixtures repr-java-parse repr-java-front repr-java-attr go-build-full javac box-forms box-smoke box-oracle box-suite fixpoint repr-go repr-go-native goi box-goi repr-haskell repr-rust repr-clojure toolchain; do report "$name"; done
fi
if [ $status = 0 ]; then echo "== gate passed ($(secs "$start"))"; else echo "== gate FAILED ($(secs "$start"))"; fi
exit $status

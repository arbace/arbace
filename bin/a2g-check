#!/bin/bash
# The differential check of c2g (doc/go/C2G-NOTES.md, "The harness"): translates what the
# oracle's class scripts call (test/oracle/classes, doc/go/ORACLE.md), builds a Go program
# running their recorded steps with the translated classes for linux/amd64 and linux/arm64
# (qemu-aarch64), and compares each step with the JVM's recorded result. Prints pass counts
# per script and architecture and their totals; writes .tmp/c2g/check/results.edn. Failing
# steps listed in test/c2g/needs-core.edn (they need arbace.core loaded) count as "need core".
#
# Usage: bin/c2g-check [SCRIPT...] [-- C2G-OPTIONS...]
#   SCRIPT: names of test/oracle/expected/classes/*.edn, e.g. Murmur3, or fixtures (the
#   classes of test/c2g/fixtures, recorded on this JVM first); default all
#   C2G-OPTIONS: bin/c2g's (--slice REGEX ..., --lang, --jdk DIR)
# Environment: C2G_ARCH (default amd64,arm64), C2G_OUT (default .tmp/c2g/check), C2G_SHOW=1
# (print the first failures; all: every failure and every need-core step), C2G_JVM_OPTS.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tools.bash"
arbace_runtime
cd "$root"
# shellcheck disable=SC2086
exec java -Xss64m ${C2G_JVM_OPTS:--Xmx12g} --add-modules ALL-SYSTEM -cp "$ARBACE_CP:$root/test" arbace.lang.Main -m c2g.check "$@"

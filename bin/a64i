#!/usr/bin/env bash
# a64i, arm64's machine (doc/asm/ARM64-SURVEY.md §4.2, AR5; ARS14 (a)): A64's integer core on the emulator frame
# (go/arbace/emu, go/arbace/a64i), its light driver built alone by TamaGo's go (bin/repr-asm --arch arm64 a64i light).
#
#   bin/a64i light                                   the light driver into .tmp/a64i/a64i (A64I_EXE: another build of it)
#   bin/a64i run [--forms FORMS] EXE [ARG...]        the static arm64 executable run on a64i, its bytes decoded (AOT); with
#                                                    --forms its instructions from their forms (eval: EXE an eval build)
#   bin/a64i decode-text EXE                         its code sections as a64i decodes them, an instruction a line
#   bin/a64i forms-check EXE FORMS                   each form lowered at its address against EXE's word there decoded
#   bin/a64i trace --mode sys|step|bisect EXE        the lockstep against this arm64 CPU (ptrace): compared at each system
#                                                    call, after every instruction, or bisected to the first differing one
#   bin/a64i eval-build LIST WORK                    LIST's programs (NAME<tab>PATH) laid out for eval (arbace.asm.arm64.eval)
#   bin/a64i claimed                                 the instructions a64i claims (every decodable word's name and family:
#                                                    the coverage's, AR6)
#   bin/a64i synth DIR [--record]                    the synthetic programs (test/asm/a64i/gen.ae, seeded, self-checking) into
#                                                    DIR, their digests held to test/asm/a64i/synth-digests.edn; --record runs
#                                                    them under qemu-aarch64 first (AR6, ARS42 (b))
#   bin/a64i table-check                             goi's checker over arbace/crt, arbace/emu and arbace/a64i in linux/arm64 (the
#                                                    package header's :init-order and the forms' annotations against the checker's;
#                                                    queue 277, ARS70 (a)), then test/asm/controls-a64i-table.txt's controls, which
#                                                    must fail
#   bin/a64i go-check [NAME...]                      real Go programs (test/asm/a64i-go/NAME/main.go) built for linux/arm64 by TamaGo's
#                                                    go and run on a64i to their end, judged by their own output (NAME/want.txt); on an
#                                                    arm64 host also natively (AR19, queue 288)
#   bin/a64i go-check --tools [--record] [NAME...]   Go tools (test/asm/a64i-go/NAME/tool: gofmt, vet; compile, asm, AR22; link, pack, AR23) built from
#                                                    GOROOT for linux/arm64, their runs (NAME/runs over NAME/inputs) judged by NAME/want/
#                                                    (--record: written from the native runs, arm64); natively too on arm64 (AR21, queue 292)
#   bin/a64i check [--record] [--only LIST|NAME,...] [--essential]
#                                                    the check: bin/repr-asm --arch arm64 a64i-check (with the synthetic
#                                                    programs and the coverage, test/asm/a64i-coverage-arm64.txt); --only those
#                                                    programs, judged on what they ran with a slice-foreign control, --essential
#                                                    test/asm/subsets.edn's :a64i (the essential gate's; AR7, ARS46 (b))
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
case ${1:-} in
  check) shift; exec "$root/bin/repr-asm" --arch arm64 a64i-check "$@" ;;
  light|run|decode-text|forms-check|trace|eval-build|claimed|synth|table-check|go-check) exec "$root/bin/repr-asm" --arch arm64 a64i "$@" ;;
  *) sed -n '2,/^set -euo/p' "$0" | sed '$d' >&2; exit 2 ;;
esac

#!/usr/bin/env bash
# a64i, arm64's machine (doc/asm/ARM64-SURVEY.md §4.2, AR5; ARS14 (a)): A64's integer core on the emulator frame
# (go/arbace/emu, go/arbace/a64i), its light driver built alone by TamaGo's go (bin/repr-asm --arch arm64 a64i light).
#
#   bin/a64i light                                   the light driver into .tmp/a64i/a64i (A64I_EXE: another build of it)
#   bin/a64i run [--forms FORMS] EXE [ARG...]        the static arm64 executable run on a64i, its bytes decoded (AOT); with
#                                                    --forms its instructions from their forms (eval: EXE an eval build)
#   bin/a64i decode-text EXE                         its code sections as a64i decodes them, an instruction a line
#   bin/a64i forms-check EXE FORMS                   each form lowered at its address against EXE's word there decoded
#   bin/a64i trace --mode sys|step|bisect EXE        the lockstep against this arm64 CPU (ptrace): compared at each system
#                                                    call, after every instruction, or bisected to the first differing one
#   bin/a64i eval-build LIST WORK                    LIST's programs (NAME<tab>PATH) laid out for eval (arbace.asm.arm64.eval)
#   bin/a64i check [--record] [--only NAME,...]      the check: bin/repr-asm --arch arm64 a64i-check
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
case ${1:-} in
  check) shift; exec "$root/bin/repr-asm" --arch arm64 a64i-check "$@" ;;
  light|run|decode-text|forms-check|trace|eval-build) exec "$root/bin/repr-asm" --arch arm64 a64i "$@" ;;
  *) sed -n '2,/^set -euo/p' "$0" | sed '$d' >&2; exit 2 ;;
esac

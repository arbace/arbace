#!/bin/bash
# How much of java.base's exported API the Go build implements (doc/go/JAVA-BASE.md): the API
# by reflection on the running JDK 26 (the exported packages, their public and accessible member
# classes, and their public and protected methods, constructors and fields), each class and
# member classified by what the Go build provides: translated by a2g, hand-written in jrt,
# stubbed, cut, or absent (test/jrt/jrt_coverage.ae). Run on the frozen JVM Arbace
# (bin/lib/frozen.bash: its jar, with the checkout's a2g and repr/go namespaces jrt_coverage.ae uses;
# the API reflected is the running JDK's, whichever Arbace reflects on it).
#
# Usage: bin/jrt-coverage [OUT]   default OUT doc/go/java-base-coverage.edn (the counts, per
#                                 package and class); every member's status goes to
#                                 $JRT_COVERAGE_WORK/members.edn, the tables to
#                                 $JRT_COVERAGE_WORK/summary.md
# Environment:
#   A2G_OUT  a2g's output for the program (default target/arbace-go/a2g: bin/arbace-go --build;
#            its report.edn and prog/)
#   JRT_WORK bin/jrt-convert's work directory, whose sources.txt tells the classes translated
#            from jrt's own Java (overlay/) from jdk26u's (default: the committed one,
#            jdk/sources.txt, which matches a2g's default input jdk/forms)
#   SURFACE  Arbace's use of the JDK (default doc/go/java-surface.edn: bin/java-surface)
#   JRT_COVERAGE_WORK  default .tmp/jrt-coverage
# Deterministic: the output depends on the JDK, a2g's output and jrt's sources (go/arbace/jrt).
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/frozen.bash"
out=${1:-$root/doc/go/java-base-coverage.edn}
a2g=${A2G_OUT:-$root/target/arbace-go/a2g}
surface=${SURFACE:-$root/doc/go/java-surface.edn}
sources=${JRT_WORK:-$root/jdk}/sources.txt
work=${JRT_COVERAGE_WORK:-$root/.tmp/jrt-coverage}
[ -f "$a2g/report.edn" ] && [ -d "$a2g/prog/go/arbace/jrt" ] || {
  echo "bin/jrt-coverage: no a2g output in $a2g: run bin/arbace-go --build (or set A2G_OUT)" >&2
  exit 1
}
mkdir -p "$work"
cd "$root"
frozen_java tools -Xss64m -Xmx6g -- -e "
(require 'jrt.jrt-coverage)
(let [r (jrt.jrt-coverage/run \"$root\" \"$a2g\" \"$sources\" \"$surface\" \"$out\" \"$work/members.edn\" \"$work/summary.md\")
      t (:total r)]
  (println (str \"java.base: \" (:classes t) \" classes, \" (:members t) \" members; provided \"
                (:provided t) \" (\" (format \"%.1f%%\" (* 100.0 (/ (double (:provided t)) (:members t)))) \")\"))
  (println \"members by status:\" (:members-by-status t))
  (println \"cross-check mismatches:\" (:mismatches (:cross-check r)))
  (println \"wrote $out, $work/members.edn, $work/summary.md\"))"

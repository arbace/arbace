#!/bin/bash
# g2a's printer: Go forms -> Go source (doc/go/SPEC.md §12, doc/go/PRINTER-NOTES.md), run on
# Arbace's Go executable (bin/lib/g2a-host.bash: G2A_GO_EXE, else the tools' host); arbace.g2a
# is compiled into it since S6 (SA133), a source of it in the checkout that differs from the
# embedded copy loaded from the checkout instead, evaluated.
#
# Usage: bin/g2a-print [--layout lines|gofmt] [--no-line-directives] [--line-file]
#                      [--src DIR [--build]] [--gofmt] FORMS.ae OUTDIR
# Writes one .go file per go/file form of the package FORMS.ae into OUTDIR. With --src, copies
# the package's .s/.h/.syso and embedded files from the original directory DIR and writes
# OUTDIR/overlay.json; --build then runs go build -trimpath -overlay in DIR under the forms'
# configuration. Environment: G2A_GOROOT (default /root/tamago-go), G2A_GO_EXE
# (bin/lib/g2a-host.bash).
# --line-file names the forms file in gc's positions (SPEC §12.3). The options: arbace.g2a.print.
set -euo pipefail
export CGO_ENABLED=0 # Go's builds never use cgo (doc/go/BOX-NOTES.md, "... cgo dropped", 2026-10-16)
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/g2a-host.bash"
g2a_exec arbace.g2a.print "$@"

#!/bin/bash
# Go's compile, link and asm as the box's tool guests (doc/go/BOX-NOTES.md, S7): TamaGo's go1.27.1
# built for GOOS=tamago from its Go forms, tamago/cmd/ printed for tamago/ARCH (bin/toolchain-vendor
# print: GOROOT/src/cmd printed, the rest of the toolchain's tree, $ARBACE_GOROOT, default
# /root/tamago-go, linked; standalone S9, SA203), with the board of box/ and the tool guests' shim
# (box/'s arbace/box/tool, which gives the tool its command line, its environment and, spawned,
# its file system: the request's trees in, the output tree out).
#
#   bin/box-tools build [ARCH...]       the tool guests for each ARCH (amd64, arm64; default both)
#                                       into target/box-tools/<arch>/{compile,link,asm}.elf
#   bin/box-tools put STORE [ARCH...]   build them when missing, put them into the store directory
#                                       STORE and point the refs tool.<tool>.<arch> at them; prints
#                                       each hash and ref (the store tool of ARBACE_BOX_LAUNCHER, else
#                                       target/arbace-go/box-<host arch>/arbace-box); and the
#                                       toolchain's facts for the box's planner (arbace.box.plan,
#                                       doc/go/BOX-NOTES.md, S8) under tool.config.<arch>:
#                                       {:tool-tags [...] :release-tags [...] :include TREE
#                                       :goversion "go1.N.M"}, go list's context.ToolTags and
#                                       ReleaseTags for tamago/<arch>, GOROOT/pkg/include as a tree
#
# How: box/ printed (bin/build-go --print-only --goos tamago: abi, board, tree, tool), and the
# patched file system of TamaGo's syscall (overlay/go/syscall.ae) printed; a -overlay adds them to
# GOROOT's cmd module, which cannot import the module arbace: the board at cmd/internal (its
# assembly needs a directory that exists: the go command runs asm there), abi, tree and tool
# under cmd/internal/arbacebox, their imports rewritten, and one file in each tool's main
# package whose init calls tool.Start; it replaces syscall/fs_tamago.go. Linked as the box's
# guests are (-T 0x201000 -R 0x1000 -w), from the module the printing makes (GOOSPKG, TamaGo's
# goos module from Go's module cache). No build uses the host's go.
# Environment: BOX_TOOLS_GO=orig, the tools from the toolchain's own tree ($ARBACE_GOROOT), not from
# tamago/cmd/; BOX_TOOLS_GOROOT, the tools from that GOROOT (bin/toolchain-vendor check);
# BOX_TOOLS_OUT, the output directory (default target/box-tools); BOX_TOOLS_LDFLAGS, more link
# flags (bin/toolchain-vendor check: its empty build IDs).
set -euo pipefail
export CGO_ENABLED=0 # Go's builds never use cgo (doc/go/BOX-NOTES.md, "... cgo dropped", 2026-10-16)
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/goroot.bash" # stops on a stale G2A_GOROOT
goroot=${ARBACE_GOROOT:-/root/tamago-go}
out=${BOX_TOOLS_OUT:-$root/target/box-tools}
work=$out/work
tools="compile link asm"
. "$root/bin/lib/box-overlay.bash"

usage() { sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

# arch_goroot ARCH: the GOROOT the tools for tamago/ARCH are built from: BOX_TOOLS_GOROOT, the
# toolchain's own (BOX_TOOLS_GO=orig), else tamago/cmd/ printed for tamago/ARCH (reused while its
# key holds: bin/toolchain-vendor print)
arch_goroot() {
  if [ -n "${BOX_TOOLS_GOROOT:-}" ]; then echo "$BOX_TOOLS_GOROOT"
  elif [ "${BOX_TOOLS_GO:-}" = orig ]; then echo "$goroot"
  else
    local d=$root/.tmp/toolchain-vendor/print-tamago-$1
    "$root/bin/toolchain-vendor" print "tamago-$1" "$d" >&2 || return 1
    echo "$d/goroot"
  fi
}

# prepare: box/ and the patched syscall printed: the overlay's files in $work/ov
prepare() {
  local ov=$work/ov
  rm -rf "$work"; mkdir -p "$ov"
  echo "== print box/ (GOOS=tamago) and overlay/go/syscall.ae" >&2
  (cd "$root" && bin/build-go --print-only --goos tamago --module arbace --work "$work/print" box) > "$work/print.log" 2>&1 \
    || { tail -20 "$work/print.log" >&2; return 1; }
}

# overlay GOROOT ARCH: the overlay for building from GOROOT, $work/overlay-ARCH.json
overlay() {
  local g=$1/src ov=$work/ov f b fs
  fs=$(box_fs_file) || return 1
  local p=$work/print/mod/box
  rw() { sed -e 's#"arbace/box/abi"#"cmd/internal/arbacebox/abi"#' -e 's#"arbace/box/board"#"cmd/internal"#' \
             -e 's#"arbace/box/tree"#"cmd/internal/arbacebox/tree"#' "$1" > "$2"; }
  {
    echo '{"Replace": {'
    for f in "$p"/board/*; do
      b=$(basename "$f"); rw "$f" "$ov/board_$b"; echo " \"$g/cmd/internal/$b\": \"$ov/board_$b\","
    done
    for d in abi tree tool; do
      for f in "$p"/$d/*.go; do
        b=$(basename "$f"); case $b in *_test.go) continue ;; esac
        mkdir -p "$ov/$d"; rw "$f" "$ov/$d/$b"; echo " \"$g/cmd/internal/arbacebox/$d/$b\": \"$ov/$d/$b\","
      done
    done
    echo " \"$g/syscall/fs_tamago.go\": \"$fs\","
    printf '//go:build tamago\n\n// Arbace: a tool guest (doc/go/BOX-NOTES.md, S7).\n\npackage main\n\nimport "cmd/internal/arbacebox/tool"\n\nfunc init() { tool.Start() }\n' > "$ov/main_tool.go"
    local sep=,
    for t in $tools; do
      [ "$t" = asm ] && sep=
      echo " \"$g/cmd/$t/arbace_tool.go\": \"$ov/main_tool.go\"$sep"
    done
    echo '}}'
  } > "$work/overlay-$2.json"
}

build() {
  local a t t0 g
  [ $# -gt 0 ] || set -- amd64 arm64
  prepare || return 1
  for a in "$@"; do
    case $a in amd64|arm64) ;; *) echo "box-tools: no architecture $a" >&2; return 2 ;; esac
    mkdir -p "$out/$a"
    g=$(arch_goroot "$a") || return 1
    overlay "$g" "$a" || return 1
    echo "== the tool guests for tamago/$a from ${g#$root/}" >&2
    for t in $tools; do
      t0=$(date +%s)
      (cd "$work/print/mod" && env GOROOT="$g" GOTOOLCHAIN=local GOFLAGS= GOWORK=off GO111MODULE=on GOPROXY=off \
         GOEXPERIMENT= CGO_ENABLED=0 GOOS=tamago GOARCH="$a" GOAMD64=v1 GOARM64=v8.0 GOOSPKG=github.com/usbarmory/tamago \
         "$g/bin/go" build -trimpath -buildvcs=false "-ldflags=-T 0x201000 -R 0x1000 -w${BOX_TOOLS_LDFLAGS:+ $BOX_TOOLS_LDFLAGS}" \
         -overlay "$work/overlay-$a.json" -o "$out/$a/$t.elf" "cmd/$t") > "$work/build-$t-$a.log" 2>&1 \
        || { tail -20 "$work/build-$t-$a.log" >&2; echo "box-tools: $t for $a failed" >&2; return 1; }
      echo "box-tools: $out/$a/$t.elf ($(stat -c %s "$out/$a/$t.elf") bytes, $(( $(date +%s) - t0 )) s)" >&2
    done
  done
}

# the launcher for its store tool: ARBACE_BOX_LAUNCHER, else the host architecture's of
# bin/arbace-go --build --box
launcher() {
  [ -z "${ARBACE_BOX_LAUNCHER:-}" ] || { echo "$ARBACE_BOX_LAUNCHER"; return; }
  local a; case $(uname -m) in aarch64) a=arm64 ;; *) a=amd64 ;; esac
  local l=$root/target/arbace-go/box-$a/arbace-box
  [ -x "$l" ] || { echo "box-tools: no launcher $l (bin/arbace-go --build --box)" >&2; return 1; }
  echo "$l"
}

put() {
  local store=$1 a t l h; shift
  [ $# -gt 0 ] || set -- amd64 arm64
  for a in "$@"; do
    for t in $tools; do [ -f "$out/$a/$t.elf" ] || { build "$a" || return 1; break; }; done
  done
  l=$(launcher) || return 1
  for a in "$@"; do
    for t in $tools; do
      h=$(ARBACE_BOX_STORE_MAX=off "$l" --store "$store" put "$out/$a/$t.elf" "tool.$t.$a") || return 1
      echo "$h tool.$t.$a"
    done
    config "$store" "$a" "$l" || return 1
  done
}

# config STORE ARCH LAUNCHER: the toolchain's facts for tamago/ARCH under tool.config.ARCH
config() {
  local store=$1 a=$2 l=$3 inc line x v=tags h tags=() rel=()
  inc=$("$l" --store "$store" tree put "$goroot/pkg/include") || return 1
  line=$(env -i PATH=/usr/bin:/bin HOME="$work" GOROOT="$goroot" GOTOOLCHAIN=local GOFLAGS= GOWORK=off \
    GO111MODULE=off CGO_ENABLED=0 GOOS=tamago GOARCH="$a" GOAMD64=v1 GOARM64=v8.0 "$goroot/bin/go" list \
    -f '{{join context.ToolTags " "}} | {{join context.ReleaseTags " "}}' runtime) || return 1
  for x in $line; do
    if [ "$x" = "|" ]; then v=rel; elif [ $v = tags ]; then tags+=("\"$x\""); else rel+=("\"$x\""); fi
  done
  mkdir -p "$work"
  printf '{:tool-tags [%s]\n :release-tags [%s]\n :include "%s"\n :goversion "%s"}\n' "${tags[*]}" "${rel[*]}" "$inc" \
    "$(sed -n 1p "$goroot/VERSION")" > "$work/config-$a.edn"
  h=$("$l" --store "$store" put "$work/config-$a.edn" "tool.config.$a") || return 1
  echo "$h tool.config.$a"
}

case ${1:-} in
  build) shift; build "$@" ;;
  put) [ $# -ge 2 ] || usage; shift; put "$@" ;;
  *) usage ;;
esac

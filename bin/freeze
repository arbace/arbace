#!/bin/bash
# Freeze the JVM state of the art (doc/FREEZE.md): create the branch arbace-for-java-26 and the
# annotated tag arbace-for-java-26-v1 at the current main commit, and push both to origin.
#
# Usage: bin/freeze [--dry-run] [--yes] [--run-gate]
#   --dry-run   (the default) check everything and print what would be done; change nothing
#   --yes       do it: the user's confirmation that the freeze should happen now
#   --run-gate  run the gate here on the commit first (bin/build-arbace --suite,
#               bin/class-forms-tests, bin/j2c-check --suite; about 10 to 40 minutes) instead
#               of requiring a successful GitHub Actions run of gate.yml on the commit
# Environment: FREEZE_BRANCH (default arbace-for-java-26), FREEZE_TAG (default
#   arbace-for-java-26-v1), FREEZE_REMOTE (default origin).
# Checks, all before anything is created:
#   - the working tree is clean and HEAD is main, equal to the remote's main after a fetch
#   - doc/FREEZE.md exists and README.md has its "## Arbace for Java 26" section
#   - neither the branch nor the tag exists, locally or on the remote
#   - the gate passed on this very commit: a successful run of .github/workflows/gate.yml
#     whose head is the commit (start one with `gh workflow run gate.yml --ref main`), or,
#     with --run-gate, the gate run here
# Exit status: 0 when all checks pass (and, with --yes, the branch and tag are pushed).
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"
branch=${FREEZE_BRANCH:-arbace-for-java-26}
tag=${FREEZE_TAG:-arbace-for-java-26-v1}
remote=${FREEZE_REMOTE:-origin}
doit= run_gate=
for a in "$@"; do
  case $a in
    --dry-run) doit= ;;
    --yes) doit=1 ;;
    --run-gate) run_gate=1 ;;
    *) echo "usage: bin/freeze [--dry-run] [--yes] [--run-gate]" >&2; exit 2 ;;
  esac
done
fail() { echo "bin/freeze: $*" >&2; exit 1; }
say() { echo "== $*"; }

# The tree
[ -z "$(git status --porcelain)" ] || fail "the working tree is not clean"
[ "$(git rev-parse --abbrev-ref HEAD)" = main ] || fail "HEAD is not main"
git fetch -q "$remote" main --tags
sha=$(git rev-parse HEAD)
[ "$sha" = "$(git rev-parse "$remote/main")" ] || fail "main ($sha) is not $remote/main ($(git rev-parse "$remote/main"))"
say "commit $(git log -1 --format='%h %s' "$sha")"
# The docs advertise the branch (doc/FREEZE.md, the README's section)
[ -f doc/FREEZE.md ] || fail "no doc/FREEZE.md"
grep -q "^## Arbace for Java 26" README.md ||
  fail "README.md has no \"## Arbace for Java 26\" section advertising $branch"

# The branch and the tag must be new
git rev-parse -q --verify "refs/heads/$branch" > /dev/null && fail "branch $branch exists locally"
git rev-parse -q --verify "refs/tags/$tag" > /dev/null && fail "tag $tag exists locally"
[ -z "$(git ls-remote "$remote" "refs/heads/$branch" "refs/tags/$tag")" ] ||
  fail "$branch or $tag exists on $remote"
say "neither $branch nor $tag exists yet"

# The gate on this commit
if [ -n "$run_gate" ]; then
  say "running the gate here"
  bin/build-arbace --suite || fail "bin/build-arbace --suite failed"
  bin/class-forms-tests || fail "bin/class-forms-tests failed"
  bin/j2c-check --suite || fail "bin/j2c-check --suite failed"
  [ -z "$(git status --porcelain)" ] || fail "the gate left the working tree changed"
  gate="the gate run locally by bin/freeze --run-gate on $(date -u +%Y-%m-%dT%H:%MZ), $(java -version 2>&1 | head -1)"
else
  url=$(gh run list --workflow gate.yml --commit "$sha" --status success --limit 1 \
          --json url -q '.[0].url' 2>/dev/null || true)
  [ -n "$url" ] || fail "no successful gate.yml run on $sha; start one with" \
    "\`gh workflow run gate.yml --ref main\`, or pass --run-gate"
  gate="the gate on GitHub Actions: $url"
fi
say "gate passed: $gate"

msg="Arbace for Java 26, v1

The JVM state of the art of Arbace, frozen before Arbace breaks away from the JVM and the
.class format (doc/FREEZE.md). Main commit $sha.

Gate: $gate."

cmds=("git branch $branch $sha"
      "git tag -a $tag -m <message> $sha"
      "git push $remote refs/heads/$branch refs/tags/$tag")
if [ -z "$doit" ]; then
  say "dry run; with --yes bin/freeze would run:"
  printf '   %s\n' "${cmds[@]}"
  echo "   with the tag message:"
  echo "$msg" | sed 's/^/     | /'
  exit 0
fi
git branch "$branch" "$sha"
git tag -a "$tag" -m "$msg" "$sha"
git push "$remote" "refs/heads/$branch" "refs/tags/$tag"
say "created and pushed $branch and $tag at $sha"

#!/bin/bash
# a2g's edge (doc/STANDALONE-NOTES.md, S2): jdk/edge.edn, what a2g knows of the classes outside
# the forms (the JDK's classes jrt hand-writes or the world does not hold, the cut classes,
# Arbace's runtime classes on the JVM), as data. a2g reads it by default and then loads no class,
# reflects on none and runs no ASM (arbace.a2g.edge; arbace.classes.env's *declared*). This
# script records it on a JVM (update), proves it (verify) and proves a2g's run free of the
# JVM's reflection and ASM (trace). The JVM is the frozen JVM Arbace since standalone S4
# (bin/lib/frozen.bash; doc/STANDALONE-NOTES.md, "S4: the JVM removed"): its jar, with a2g and
# the class forms' front end loaded from the checkout's sources (frozen_view tools); its
# runtime's classes (arbace.lang, arbace.asm) are the frozen release's, which the answers
# about the classes the world does not hold do not depend on (the world's own classes are
# compiled from the checkout's forms).
#
# Usage: bin/a2g-edge update|verify|trace
#   update   bin/a2g --record-edge for the builds' two worlds, the program (bin/a2g --program)
#            and the test build (--program --input FIXTURES), merged into jdk/edge.edn: after a
#            change to what a2g asks of the JVM (arbace/lang's or the JDK forms' references
#            outside the world, a2g, the class forms' analysis) commit jdk/edge.edn with it
#   verify   the same into $A2G_EDGE_WORK/edge.edn, compared with jdk/edge.edn (diff): the edge
#            is what the JVM answers, byte for byte, and a2g with it asks nothing it lacks
#   trace    bin/a2g --program (with the edge) under JFR's method tracing of the JVM's
#            reflection (Class.forName, getDeclared*, getMethods ..., annotations, enum
#            constants, record components, Field.get, the class path's resources, the module
#            layer, RT's class loading) and of ASM's classes (ClassReader, ClassWriter, the
#            visitors, Type, TypeReference): fails when any traced call is made inside a2g's
#            run by a2g itself (test/a2g/edge_trace.ae): the JVM's own machinery (linkage,
#            stack traces, class constants), the runtime on a2g's own objects (Reflector's
#            member lookup for untyped interop, protocol dispatch) and TypeReference's
#            arithmetic (the analysis's type annotation targets: no class file;
#            arbace.classes.go on the Go build) are counted apart; with
#            A2G_EDGE_TRACE_ARGS=--jvm-reflection it lists what the edge replaces. The
#            recording and the listing: $A2G_EDGE_WORK/trace.jfr, trace-a2g.txt
# Environment: A2G_EDGE_WORK (default .tmp/a2g-edge), A2G_FIXTURES (the suite's Java fixtures as
# class forms: default the committed test/java-fixtures/forms), A2G_JVM_OPTS (a2g's JVM options,
# default -Xmx12g), JRT_CONV (as bin/a2g's).
set -uo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"
. bin/lib/frozen.bash
frozen_jar > /dev/null || exit 1
# a2g ARGS...: a2g on the frozen JVM Arbace (bin/a2g runs it on the Go executable)
a2g() {
  # shellcheck disable=SC2086
  frozen_java tools -Xss64m ${A2G_JVM_OPTS:--Xmx12g} --add-modules ALL-SYSTEM -- -m arbace.a2g.main "$@"
}
work=${A2G_EDGE_WORK:-$root/.tmp/a2g-edge}
case "$work" in /*) ;; *) work=$root/$work ;; esac
mkdir -p "$work"

fixtures() {
  local fx=${A2G_FIXTURES:-$root/test/java-fixtures/forms}
  [ -d "$fx" ] || { echo "a2g-edge: no fixtures $fx" >&2; return 1; }
  (cd "$fx" && pwd)
}

# record OUT: the edge of the builds' two a2g runs into OUT
record() {
  local out=$1 fx
  fx=$(fixtures) || return 1
  echo "== a2g --program --record-edge (on the frozen JVM Arbace)" >&2
  a2g --program --record-edge "$work/edge-program.edn" --out "$work/a2g" > "$work/record-program.log" 2>&1 ||
    { tail -20 "$work/record-program.log" >&2; return 1; }
  echo "== a2g --program --input $fx --record-edge" >&2
  a2g --program --input "$fx" --record-edge "$work/edge-tests.edn" --out "$work/a2g-tests" > "$work/record-tests.log" 2>&1 ||
    { tail -20 "$work/record-tests.log" >&2; return 1; }
  frozen_java tools -Xss64m -Xmx4g -- -m arbace.a2g.edge merge "$out" \
    "$work/edge-program.edn" "$work/edge-tests.edn"
}

# the methods traced: the JVM's reflection and class loading, and ASM's objects
traced=(
  java.lang.Class::forName java.lang.Class::getDeclaredMethods java.lang.Class::getDeclaredFields
  java.lang.Class::getDeclaredConstructors java.lang.Class::getDeclaredMethod
  java.lang.Class::getDeclaredField java.lang.Class::getDeclaredConstructor
  java.lang.Class::getMethods java.lang.Class::getFields java.lang.Class::getConstructors
  java.lang.Class::getMethod java.lang.Class::getField java.lang.Class::getConstructor
  java.lang.Class::getTypeParameters java.lang.Class::getGenericSuperclass
  java.lang.Class::getGenericInterfaces java.lang.Class::getAnnotation
  java.lang.Class::isAnnotationPresent java.lang.Class::getEnumConstants
  java.lang.Class::getRecordComponents java.lang.Class::getNestHost
  java.lang.Class::getDeclaringClass java.lang.Class::getInterfaces
  java.lang.Class::getResourceAsStream java.lang.ClassLoader::getResourceAsStream
  java.lang.ClassLoader::getResource java.lang.ModuleLayer::boot java.lang.reflect.Field::get
  arbace.lang.RT::classForName arbace.lang.RT::classForNameNonLoading
  'arbace.asm.ClassReader::<init>' 'arbace.asm.ClassWriter::<init>' 'arbace.asm.ClassVisitor::<init>'
  'arbace.asm.MethodVisitor::<init>' 'arbace.asm.FieldVisitor::<init>'
  'arbace.asm.AnnotationVisitor::<init>' 'arbace.asm.Type::<init>' 'arbace.asm.TypeReference::<init>')

trace() {
  local filter jfr=$work/trace.jfr
  filter=$(IFS=';'; echo "${traced[*]}")
  echo "== a2g --program ${A2G_EDGE_TRACE_ARGS:-} under JFR's method tracing" >&2
  rm -f "$jfr"
  # shellcheck disable=SC2086
  A2G_JVM_OPTS="${A2G_JVM_OPTS:--Xmx12g} -XX:FlightRecorderOptions:stackdepth=2048 -XX:StartFlightRecording:method-trace=$filter,maxsize=0,filename=$jfr" \
    a2g --program ${A2G_EDGE_TRACE_ARGS:-} --out "$work/a2g-trace" > "$work/trace-a2g.log" 2>&1 ||
    { tail -20 "$work/trace-a2g.log" >&2; return 1; }
  # each traced call inside a2g's run, by what made it (test/a2g/edge_trace.ae)
  frozen_java test -Xmx4g -- -m a2g.edge-trace "$jfr" "$work/trace-a2g.txt"
  local status=$?
  if [ -s "$work/trace-a2g.txt" ]; then head -40 "$work/trace-a2g.txt"; fi
  return $status
}

case ${1:-} in
  update)
    record "$work/edge.edn" || exit 1
    cp "$work/edge.edn" jdk/edge.edn
    echo "a2g-edge: jdk/edge.edn updated"
    ;;
  verify)
    record "$work/edge.edn" || exit 1
    if diff "$work/edge.edn" jdk/edge.edn > "$work/verify.diff"; then
      echo "a2g-edge: jdk/edge.edn is the JVM's answer (verify passed)"
    else
      head -40 "$work/verify.diff"
      echo "a2g-edge: jdk/edge.edn differs from the JVM's answer ($work/verify.diff): bin/a2g-edge update" >&2
      exit 1
    fi
    ;;
  trace)
    trace || { echo "a2g-edge: a2g's run used the JVM's reflection or ASM ($work/trace-a2g.txt)" >&2; exit 1; }
    echo "a2g-edge: trace passed: a2g's run neither reflects on classes nor runs ASM"
    ;;
  *) echo "usage: bin/a2g-edge update|verify|trace" >&2; exit 2 ;;
esac

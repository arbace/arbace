#!/bin/bash
# javac's forms (doc/classes/JAVA-FRONTEND-SURVEY.md, JN2, JFS3 (b)): jdk26u's javac, its modules
# jdk.compiler (with the sources the JDK build generates for it), java.compiler and
# jdk.internal.opt's CommandLine, read by repr/java into Java forms in jdk/javac/, with the
# java.base classes javac's world needs beyond the program's (the 19 of the survey's JN1.2 and JN3's 4, from
# jdk26u, and jrt's own for javac, overlay/jdk/javac/java.base: a ServiceLoader that finds no
# provider; and, in jdk.compiler, javac's command line and file manager on Arbace,
# jdk.internal.jrt.javac, JN3); since JN7 the JDK build's tools bin/jrt-convert's generate step runs
# on the tool (make/jdk/src/classes/build/tools, module buildtools, with the interim copies of
# java.time.zone), with the JDK's classes they need (overlay/jdk/javac/closure.txt: java.xml's SAX
# parser, java.base's) and jrt's own zlib Deflater; and the edge of javac's world (JFS14 (b)); the tool executable's
# input (JFS4 (b)), as jdk/forms is the program's. jdk26u is pinned (JFS8 (a)): $JDK's commit must be the provenance's.
# Since JFS48 (b) jdk.compiler's generated sources are generated here as the JDK build generates them
# (make/modules/jdk.compiler/Gensrc.gmk), by its langtools tools (make/langtools/tools:
# compileproperties, the resource bundles' classes; propertiesparser, CompilerProperties and
# LauncherProperties) read into module buildtools and run on javac's tool executable, and compared
# with the build tree's support/gensrc/jdk.compiler (WORK/generated.edn); since JFS52 (b) FlagsEnum
# too, by flagsgenerator, which compiles Flags.java through javax.tools' API: javac on Arbace's
# JavaCompiler (overlay/jdk/javac/jdk.compiler's SystemCompiler, ToolProvider's tool-world variant)
# against the platform (below), so that no generated source is copied from the build tree
# (doc/classes/JAVA-FRONTEND-SURVEY.md, "As built: JFS48 (b)", "As built: JFS52 (b)").
#
#   bin/javac-vendor convert  the sources copied from $JDK (and overlay/jdk/javac/MODULE) into
#                             WORK/src/MODULE, converted by `bin/repr-java read-jdk --check` (on
#                             javac's tool executable, bin/repr-java's only host since JN6: javac
#                             on Arbace reading javac's own sources, the fixpoint) module by
#                             module, merged into OUT/forms
#                             (repr/java's reports left out); OUT/sources.txt (MODULE KIND PATH:
#                             share, a file of jdk26u's src/MODULE/share/classes; gensrc, of
#                             support/gensrc/MODULE as this script generates it (below);
#                             gensrc-build, of the JDK build's support/gensrc/MODULE, copied
#                             (none since JFS52 (b)); overlay, of overlay/jdk/javac/MODULE; make, of
#                             make/jdk/src/classes; langtools, of make/langtools/tools; interim,
#                             a java.time.zone file as make/CopyInterimTZDB.gmk copies it), OUT/provenance.edn; then the edge
#                             (module buildtools by bin/repr-java read, the class path, with
#                             --add-exports java.base/sun.text=ALL-UNNAMED as the build's).
#                             First the generate step (JFS48 (b)): version.properties as
#                             GensrcCommon.gmk's SetupVersionProperties writes it (the build's
#                             spec.gmk's VERSION_NUMBER, VERSION_STRING, VERSION_SHORT),
#                             compileproperties.CompileProperties over jdk.compiler's .properties
#                             and it, propertiesparser.PropertiesParser over compiler.properties
#                             and launcher.properties, flagsgenerator.FlagsGenerator over
#                             Flags.java into FlagsEnum.java (JFS52 (b): javac on Arbace's
#                             JavaCompiler, its standard file manager's platform the platform
#                             below, WORK/platform, checked against its pin, as the system
#                             property jdk.internal.jrt.javac.platform), each tool's main called on javac's tool
#                             executable ($REPR_JAVA_EXE, bin/repr-java's) with
#                             make/langtools/tools on ARBACE_PATH (propertiesparser's templates),
#                             into WORK/gensrc/jdk.compiler; each output compared with the build
#                             tree's (WORK/generated.edn: :same, :different, :no-reference): a
#                             difference fails. JAVAC_VENDOR_BOOTSTRAP=1 takes the build tree's
#                             files instead (a tool that does not yet hold the generators; the
#                             provenance says so, and verify, which always generates, then differs)
#   bin/javac-vendor edge     the edge of javac's world alone: bin/j2g --program --record-edge on
#                             the frozen JVM over the program and OUT/forms (with the tool's
#                             variants, overlay/jdk/javac/variants), less what jdk/edge.edn
#                             answers alike (arbace.j2g.edge's subtract), into OUT/edge.edn;
#                             jdk/edge.edn stays the shipped build's
#   bin/javac-vendor verify   convert into WORK/fresh and compare with OUT (diff -r; the
#                             provenance's host, the tool that wrote it, reported, not compared:
#                             JFS32): the tree is what the conversion and the recording give, byte
#                             for byte
#   bin/javac-vendor check    j2g translates javac's world (bin/j2g --program with OUT/forms,
#                             the tool's variants and both edges): status 0 and no class failing
#                             its analysis (WORK/check/j2g.log, report.edn). On the program built
#                             from the checkout (target/arbace-go/amd64/arbace, bin/arbace-go
#                             --build; J2G_GO_EXE names another), whose Java forms' analysis is the
#                             checkout's: j2g runs on its host's own (bin/j2g)
#   bin/javac-vendor build    the tool executable: bin/arbace-go --build-java (its header), j2g on
#                             target/arbace-go/amd64/arbace when it exists (JFS22; J2G_GO_EXE)
#   bin/javac-vendor classes [CORPUS...]
#                             javac on Arbace (JN3): the tool executable ($JAVAC_EXE, default
#                             target/arbace-go/amd64/arbace-javac) runs javac's command line on
#                             Arbace (jdk.internal.jrt.javac.Main, overlay/jdk/javac/jdk.compiler)
#                             against the platform (below), and the JVM's javac (javac on $PATH,
#                             the frozen JDK) the same; their class files are compared byte for
#                             byte, and their diagnostics (the JVM's javac, a JDK, not the frozen
#                             jar: the reference while a JDK is at hand, JFS41). Corpora (default
#                             baseline samples jdk):
#                             baseline (the frozen clojure/'s 183 files), samples
#                             (test/repr/java/java and module), jdk (java.base's closure, 838
#                             files, made by bin/jrt-convert's sources and generate steps into
#                             WORK/jdk-originals; JRT_WORK_RT names others), with the round
#                             trip's javac options (bin/lib/repr-java/roundtrip, -g:none); and
#                             java.base (JFS2 (a)): jdk26u's java.base as the JDK build compiles it,
#                             also compared with the build's own class files. In WORK/classes/
#   bin/javac-vendor platform [DIR]
#                             the platform made into DIR (default WORK/platform) and checked
#                             against OUT/platform.sha256; prints DIR (repr/java on Arbace,
#                             bin/repr-java, JN4)
#   bin/javac-vendor platform-pin
#                             the platform made and pinned alone: OUT/platform.sha256 (JFS15 (b),
#                             JFS23 (b): the build tree's exploded modules with their jmods' module
#                             descriptors), which convert writes too (and verify so compares)
#
# Options (before the command): --work DIR (default .tmp/javac-vendor), --out DIR (default
# jdk/javac). Environment: JDK (jdk26u's checkout, default /root/jdk26u, with its build tree,
# whose support/gensrc holds the generated sources), REPR_JAVA_EXE (bin/repr-java's tool),
# J2G_JVM_OPTS (the edge's recording on the frozen JVM, default -Xmx16g).
set -uo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash" # TMPDIR: .tmp/tmp when unset
. "$root/bin/lib/renamed-env.bash" # stops on a stale G2A_*, J2A_*, A2G_* or C2A_*
cd "$root"
work=$root/.tmp/javac-vendor out=$root/jdk/javac
while [ $# -gt 0 ]; do
  case $1 in
    --work) work=$2; shift 2 ;;
    --out) out=$2; shift 2 ;;
    *) break ;;
  esac
done
cmd=${1:-}
[ $# -gt 0 ] && shift
case $work in /*) ;; *) work=$root/$work ;; esac
case $out in /*) ;; *) out=$root/$out ;; esac
jdk=${JDK:-/root/jdk26u}
fail() { echo "javac-vendor: $*" >&2; exit 1; }
since() { echo "$(( $(date +%s) - $1 )) s"; }

# The origin, pinned (JFS8 (a)): jdk26u at the commit of jdk/'s forms
pinned=baf63fbe42b8758448fee570a9d9bb914272d259
# javac's modules: jdk.compiler's and java.compiler's share/classes whole (module-info.java,
# which repr/java cannot patch, and the javadoc's snippet-files left out, as repr/java leaves
# them), jdk.compiler's generated sources (the JDK build's support/gensrc/jdk.compiler: the
# properties' classes, FlagsEnum, the resource bundles), and of jdk.internal.opt the one class
# javac's launcher uses
modules="jdk.compiler java.compiler jdk.internal.opt java.base java.xml buildtools"
# (JFS48 (b)) jdk.compiler's generated sources: generated here by the JDK build's langtools tools
# (make/langtools/tools, read into module buildtools, KIND langtools) on the tool, but those of
# gensrc_build, copied from the build tree (KIND gensrc-build): none since JFS52 (b), when
# flagsgenerator makes FlagsEnum on the tool too (until then copied)
langtools_dirs="compileproperties flagsgenerator propertiesparser"
gensrc_build=""
opt_files="jdk/internal/opt/CommandLine.java"
# java.base's classes javac's world needs beyond the program's (the survey's JN1.2): declarations
# of javac's classes (annotation types, supertypes, exceptions) and TypeTag's range checks; and
# (JN3) ClassWriter's: DataOutputStream (javac's ByteBuffer.appendLong, appendFloat, appendDouble)
# with its interface, exception and ModifiedUtf, in the program's world since JC6b
# (doc/classes/JAVA-CONFORMANCE-SURVEY.md, "As built: JC6b") with FilterWriter and
# ExactConversionsSupport
base_files="java/io/IOError.java java/lang/SafeVarargs.java
  java/lang/annotation/AnnotationTypeMismatchException.java java/lang/annotation/Documented.java
  java/lang/annotation/Inherited.java java/lang/annotation/Repeatable.java
  java/lang/module/InvalidModuleDescriptorException.java
  java/nio/file/ClosedFileSystemException.java java/nio/file/DirectoryIteratorException.java
  java/nio/file/FileSystem.java java/nio/file/FileSystemNotFoundException.java
  java/nio/file/FileVisitOption.java java/nio/file/FileVisitResult.java
  java/nio/file/ProviderNotFoundException.java java/nio/file/ReadOnlyFileSystemException.java
  java/util/spi/ToolProvider.java sun/reflect/annotation/ExceptionProxy.java"
overlay=$root/overlay/jdk/javac
variants=$overlay/variants
# (JN7) the JDK build's tools bin/jrt-convert's generate step runs on Arbace: the build's own
# sources of make/jdk/src/classes/build/tools (module buildtools: the class path, as the build's
# BUILD_TOOLS_JDK compiles them; KIND make), the interim copies of java.time.zone that
# build.tools.tzdb compiles with it (KIND interim: make/CopyInterimTZDB.gmk's, the package renamed),
# and the JDK's classes they need beyond the program's and javac's (overlay/jdk/javac/closure.txt:
# java.xml's SAX parser, java.base's)
tool_dirs="cldrconverter generatebreakiteratordata generatecharacter generatecurrencydata
  generateextraproperties generatelsrequivmaps makejavasecurity spp tzdb"
interim_tzdb="ZoneOffsetTransition ZoneOffsetTransitionRule ZoneRules Ser"
closure=$overlay/closure.txt

conf() { ls -d "$jdk"/build/*/spec.gmk 2>/dev/null | head -1; }
# spec VAR: a value of the build's spec.gmk (VAR := VALUE)
spec() { sed -n "s/^$1 := //p" "$(conf)" | head -1; }

# The generators (JFS48 (b)): the JDK build's langtools tools as Java forms on javac's tool
# executable, each main called by its class name, as bin/jrt-convert's generate step calls
# make/jdk/src/classes' (JN7)
gen_exe() { . "$root/bin/lib/host.bash"; echo "${REPR_JAVA_EXE:-$root/target/arbace-go/$(arbace_host_arch)/arbace-javac}"; }
gen_tools="compileproperties.CompileProperties flagsgenerator.FlagsGenerator propertiesparser.PropertiesParser"
# gen_script PLATFORM: the script; javax.tools' system compiler on the tool (JFS52 (b),
# jdk.internal.jrt.javac.SystemCompiler) attributes against PLATFORM, as the JDK's against its image
gen_script() {
  local c
  echo ';; bin/javac-vendor'"'"'s generate step: a JDK build langtools tool'"'"'s main (JFS48 (b), JFS52 (b))'
  echo "(System/setProperty \"jdk.internal.jrt.javac.platform\" \"$1\")"
  echo '(let [[c & args] *command-line-args* a (into-array String args)]'
  echo '  (case c'
  for c in $gen_tools; do echo "    \"$c\" ($c/main a)"; done
  echo '    (do (println "javac-vendor: no tool" c) (System/exit 2))))'
}
vprops=com/sun/tools/javac/resources/version.properties

# generate: WORK/gensrc/jdk.compiler as make/modules/jdk.compiler/Gensrc.gmk makes it, then
# WORK/generated.edn, each output against the build tree's
generate() {
  local c ref g=$work/gensrc/jdk.compiler src=$jdk/src/jdk.compiler/share/classes rel v st=0 exe t0
  t0=$(date +%s)
  c=$(conf); [ -n "$c" ] || fail "no JDK build tree in $jdk/build (its spec.gmk)"
  ref=$(dirname "$c")/support/gensrc/jdk.compiler
  rm -rf "$work/gensrc" "$work/gen-tools"
  mkdir -p "$g/$(dirname "$vprops")" "$work/gen-tools" "$work/tmp"
  if [ "${JAVAC_VENDOR_BOOTSTRAP:-}" = 1 ]; then
    echo "   bootstrap (JAVAC_VENDOR_BOOTSTRAP=1): the build tree's files, not generated" >&2
    (cd "$ref" && find . -name '*.java' -o -name '*.properties' | sed 's|^\./||') | while read -r rel; do
      case " $gensrc_build " in *" $rel "*) continue ;; esac
      mkdir -p "$g/$(dirname "$rel")" && cp "$ref/$rel" "$g/$rel"
    done
  else
    exe=$(gen_exe)
    [ -x "$exe" ] || fail "no $exe (bin/javac-vendor build, or REPR_JAVA_EXE)"
    platform "$work/platform" || { echo "javac-vendor: the platform differs from its pin" >&2; return 1; }
    gen_script "$work/platform" > "$work/gen-tools/gen.ae"
    local tool=(env "TMPDIR=$work/tmp" "ARBACE_PATH=$jdk/make/langtools/tools" "$exe" "$work/gen-tools/gen.ae")
    # GensrcCommon.gmk's SetupVersionProperties: jdk.compiler's version.properties
    printf 'jdk=%s\nfull=%s\nrelease=%s\n' "$(spec VERSION_NUMBER)" "$(spec VERSION_STRING)" "$(spec VERSION_SHORT)" > "$g/$vprops"
    # GensrcProperties.gmk's SetupCompileProperties (TYPE langtools, CLASS
    # java.util.ListResourceBundle, EXTRA_FILES version.properties; no translation excluded):
    # -compile PROPERTIES JAVA CLASS for each, in an @-file, -quiet
    {
      (cd "$src" && find . -name '*.properties' | sed 's|^\./||' | LC_ALL=C sort) | while read -r rel; do
        printf -- '-compile\n%s\n%s\n%s\n' "$src/$rel" "$g/${rel%.properties}.java" java.util.ListResourceBundle
      done
      printf -- '-compile\n%s\n%s\n%s\n' "$g/$vprops" "$g/${vprops%.properties}.java" java.util.ListResourceBundle
    } > "$work/gen-tools/compileproperties.cmdline"
    sed -n '3~4p' "$work/gen-tools/compileproperties.cmdline" | while read -r f; do mkdir -p "$(dirname "$f")"; done
    "${tool[@]}" compileproperties.CompileProperties -quiet "@$work/gen-tools/compileproperties.cmdline" \
      > "$work/log/compileproperties.log" 2>&1 || { cat "$work/log/compileproperties.log" >&2; return 1; }
    # Gensrc.gmk's PARSEPROPERTIES: compiler.properties and launcher.properties into their factories
    "${tool[@]}" propertiesparser.PropertiesParser \
      -compile "$src/com/sun/tools/javac/resources/compiler.properties" "$g/com/sun/tools/javac/resources/" \
      -compile "$src/com/sun/tools/javac/resources/launcher.properties" "$g/com/sun/tools/javac/resources/" \
      > "$work/log/propertiesparser.log" 2>&1 || { cat "$work/log/propertiesparser.log" >&2; return 1; }
    # Gensrc.gmk's FLAGSGENERATOR: Flags.java's flags into FlagsEnum (JFS52 (b)), compiled by javac
    # on Arbace through javax.tools' API against the platform
    mkdir -p "$g/com/sun/tools/javac/code"
    "${tool[@]}" flagsgenerator.FlagsGenerator \
      "$src/com/sun/tools/javac/code/Flags.java" "$g/com/sun/tools/javac/code/FlagsEnum.java" \
      > "$work/log/flagsgenerator.log" 2>&1 || { cat "$work/log/flagsgenerator.log" >&2; return 1; }
  fi
  # against the build tree's support/gensrc/jdk.compiler (the generated files and those the build
  # has)
  {
    echo ";; bin/javac-vendor's generate step (JFS48 (b)): each output against the JDK build's"
    echo "{:generators \"$([ "${JAVAC_VENDOR_BOOTSTRAP:-}" = 1 ] && echo "the JDK build tree (bootstrap)" || echo "javac's tool executable")\" :jdk-gensrc \"$ref\""
    echo " :files {"
    { (cd "$g" && find . -type f | sed 's|^\./||'); (cd "$ref" && find . -name '*.java' -o -name '*.properties' | sed 's|^\./||'); } |
      LC_ALL=C sort -u | while read -r rel; do
      case " $gensrc_build " in *" $rel "*) continue ;; esac
      if [ ! -f "$g/$rel" ]; then v=:not-generated
      elif [ ! -f "$ref/$rel" ]; then v=:no-reference
      elif cmp -s "$g/$rel" "$ref/$rel"; then v=:same
      else v=:different; fi
      echo "  \"$rel\" $v"
    done
    echo "}}"
  } > "$work/generated.edn"
  grep -q ':different\|:not-generated' "$work/generated.edn" && st=1
  echo "   $(grep -c '" :same' "$work/generated.edn") of $(grep -c '^  "' "$work/generated.edn") generated files equal to the build tree's ($work/generated.edn; $(since "$t0"))" >&2
  return $st
}

# sources: WORK/src/MODULE and WORK/sources.txt
sources() {
  local c gensrc m rel
  c=$(conf); [ -n "$c" ] || fail "no JDK build tree in $jdk/build (its support/gensrc)"
  gensrc=$(dirname "$c")/support/gensrc
  [ "$(git -C "$jdk" rev-parse HEAD 2>/dev/null)" = "$pinned" ] || fail "$jdk is not jdk26u at $pinned"
  rm -rf "$work/src"
  {
    (cd "$jdk/src/jdk.compiler/share/classes" && find . -name '*.java' ! -name module-info.java ! -path '*/snippet-files/*' | sed 's|^\./||' | LC_ALL=C sort) |
      sed 's/^/jdk.compiler share /'
    { (cd "$work/gensrc/jdk.compiler" && find . -name '*.java' | sed 's|^\./||'); for rel in $gensrc_build; do echo "$rel"; done; } |
      LC_ALL=C sort | while read -r rel; do
      case " $gensrc_build " in *" $rel "*) echo "jdk.compiler gensrc-build $rel" ;; *) echo "jdk.compiler gensrc $rel" ;; esac
    done
    (cd "$overlay/jdk.compiler" && find . -name '*.java' | sed 's|^\./||' | LC_ALL=C sort) | sed 's/^/jdk.compiler overlay /'
    (cd "$jdk/src/java.compiler/share/classes" && find . -name '*.java' ! -name module-info.java ! -path '*/snippet-files/*' | sed 's|^\./||' | LC_ALL=C sort) |
      sed 's/^/java.compiler share /'
    for rel in $opt_files; do echo "jdk.internal.opt share $rel"; done
    for rel in $base_files; do echo "java.base share $rel"; done
    sed -n 's/^java.base //p' "$closure" | sed 's/^/java.base share /'
    (cd "$overlay/java.base" && find . -name '*.java' | sed 's|^\./||' | LC_ALL=C sort) | sed 's/^/java.base overlay /'
    sed -n 's/^java.xml //p' "$closure" | LC_ALL=C sort | sed 's/^/java.xml share /'
    for d in $tool_dirs; do (cd "$jdk/make/jdk/src/classes" && ls build/tools/$d/*.java); done | LC_ALL=C sort | sed 's/^/buildtools make /'
    for f in $interim_tzdb; do echo "build/tools/tzdb/$f.java"; done | LC_ALL=C sort | sed 's/^/buildtools interim /'
    (cd "$jdk/make/langtools/tools" && find $langtools_dirs -name '*.java') | LC_ALL=C sort | sed 's/^/buildtools langtools /'
  } > "$work/sources.txt"
  while read -r m kind rel; do
    mkdir -p "$work/src/$m/$(dirname "$rel")"
    case $kind in
      share) cp "$jdk/src/$m/share/classes/$rel" "$work/src/$m/$rel" ;;
      gensrc) cp "$work/gensrc/$m/$rel" "$work/src/$m/$rel" ;;
      gensrc-build) cp "$gensrc/$m/$rel" "$work/src/$m/$rel" ;;
      overlay) cp "$overlay/$m/$rel" "$work/src/$m/$rel" ;;
      make) cp "$jdk/make/jdk/src/classes/$rel" "$work/src/$m/$rel" ;;
      langtools) cp "$jdk/make/langtools/tools/$rel" "$work/src/$m/$rel" ;;
      interim) sed -e "s/package java.time.zone/package build.tools.tzdb/" \
                 < "$jdk/src/java.base/share/classes/java/time/zone/$(basename "$rel")" > "$work/src/$m/$rel" ;;
    esac || return 1
  done < "$work/sources.txt"
}

# origins MODULE: the names the converted files' headers give their sources (repr/java's
# --origins): not the work tree's copies, so that the output does not depend on where it was made
origins() {
  local m kind rel
  echo "{"
  while read -r m kind rel; do
    [ "$m" = "$1" ] || continue
    case $kind in
      share) echo "\"$rel\" \"jdk26u src/$m/share/classes/$rel\"" ;;
      gensrc) echo "\"$rel\" \"jdk26u support/gensrc/$m/$rel (generated by bin/javac-vendor)\"" ;;
      gensrc-build) echo "\"$rel\" \"jdk26u support/gensrc/$m/$rel (generated by the JDK build)\"" ;;
      overlay) echo "\"$rel\" \"overlay/jdk/javac/$m/$rel\"" ;;
      make) echo "\"$rel\" \"jdk26u make/jdk/src/classes/$rel\"" ;;
      langtools) echo "\"$rel\" \"jdk26u make/langtools/tools/$rel\"" ;;
      interim) echo "\"$rel\" \"jdk26u src/java.base/share/classes/java/time/zone/$(basename "$rel") (package build.tools.tzdb, as make/CopyInterimTZDB.gmk copies it)\"" ;;
    esac
  done < "$work/sources.txt"
  echo "}"
}

# convert_module MODULE CONV: WORK/src/MODULE converted into CONV/MODULE
convert_module() {
  local m=$1 conv=$2 log=$work/log/convert-$1.log n
  n=$(grep -c "^$m " "$work/sources.txt")
  origins "$m" > "$work/origins-$m.edn"
  rm -rf "${conv:?}/$m"
  if [ "$m" = buildtools ]; then
    # the build's tools on the class path (the unnamed module), with the build's --add-exports
    # for sun.text (make/CompileToolsJdk.gmk)
    (cd "$work" && "$root/bin/repr-java" read --check --origins "$work/origins-$m.edn" \
       --javac --add-exports --javac java.base/sun.text=ALL-UNNAMED "$conv/$m" "$work/src/$m") > "$log" 2>&1
  else
  # from WORK: read-jdk copies the files into .tmp/repr-java-patch below the current directory
  (cd "$work" && REPR_JAVA_THREADS=8 REPR_JAVA_PATCH_ALL=1 \
     "$root/bin/repr-java" read-jdk --check --origins "$work/origins-$m.edn" "$conv/$m" "$m" "$work/src/$m") > "$log" 2>&1
  fi
  echo "   $m: $(tail -1 "$log")" >&2
  grep -q "^$n Java files, $n converted, 0 failed, 0 javac errors, .* 0 unreadable" "$log" ||
    { echo "javac-vendor: $m: not every file converted ($log)" >&2; return 1; }
}

# provenance OUT HOST: HOST, the converter's tool as convert found it before writing (JFS57 (b))
provenance() {
  local q='s/\\/\\\\/g; s/"/\\"/g' url clean c
  . "$root/bin/lib/repr-java/host.bash"
  url=$(git -C "$jdk" remote get-url origin 2>/dev/null | sed "$q")
  if [ -z "$(git -C "$jdk" status --porcelain --untracked-files=no -- src make 2>/dev/null)" ]; then clean=true; else clean=false; fi
  c=$(conf)
  echo ";; The provenance of jdk/javac/ (bin/javac-vendor, doc/classes/JAVA-FRONTEND-SURVEY.md, JN2): what"
  echo ";; its forms and its edge were made from. Written by bin/javac-vendor convert; verify compares it."
  echo "{:jdk26u {:repo \"$url\" :commit \"$(git -C "$jdk" rev-parse HEAD)\" :clean $clean"
  echo "          :gensrc \"build/$(basename "$(dirname "$c")")/support/gensrc/jdk.compiler\"}"
  echo " :generated {:by \"$([ "${JAVAC_VENDOR_BOOTSTRAP:-}" = 1 ] && echo "the JDK build tree (bootstrap)" || echo "make/langtools/tools' compileproperties, flagsgenerator, propertiesparser on javac's tool executable")\""
  echo "             :files $(grep -c ' gensrc ' "$work/sources.txt") :equal-to-the-build $(grep -c '\.java" :same' "$work/generated.edn")"
  echo "             :copied [$(for rel in $gensrc_build; do printf '"%s"' "$rel"; done)]}"
  echo " :jdk \"$(repr_java_platform)\""
  echo " :converter {:repr-java \"$(repr_java_reader_hash)\""
  echo "             :host \"$2\"}"
  echo " :edge {:recorded-by \"bin/j2g --program --record-edge, less jdk/edge.edn\""
  echo "        :jdk-edge \"$(sha256sum < "$root/jdk/edge.edn" | cut -c1-64)\"}"
  echo " :files {:sources $(wc -l < "$work/sources.txt")"
  for m in $modules; do echo "         :$m $(grep -c "^$m " "$work/sources.txt")"; done
  echo "         :forms $(find "$1/forms" -name '*.ae' | wc -l)}}"
}

# the tool world's j2g arguments (on a JVM or the tools' host): javac's forms and the variants
tool_args() { echo --input "$1/forms" --variants "$variants"; }

# record_edge OUT: the edge of javac's world into OUT/edge.edn
record_edge() {
  local o=$1 t0
  t0=$(date +%s)
  . "$root/bin/lib/frozen.bash"
  frozen_jar > /dev/null || return 1
  mkdir -p "$work/log" "$work/tmp"
  echo "== the edge of javac's world (bin/j2g --program --record-edge, on the frozen JVM)" >&2
  # shellcheck disable=SC2046
  frozen_java tools -Xss64m ${J2G_JVM_OPTS:--Xmx16g} -Djava.io.tmpdir="$work/tmp" --add-modules ALL-SYSTEM -- \
    -m arbace.j2g.main --program $(tool_args "$o") --record-edge "$work/edge-full.edn" --out "$work/j2g-jvm" \
    > "$work/log/edge-record.log" 2>&1 || { tail -20 "$work/log/edge-record.log" >&2; return 1; }
  frozen_java tools -Xss64m -Xmx4g -- -m arbace.j2g.edge subtract "$o/edge.edn" "$work/edge-full.edn" "$root/jdk/edge.edn" \
    >> "$work/log/edge-record.log" 2>&1 || { tail -20 "$work/log/edge-record.log" >&2; return 1; }
  echo "   $(grep -c '^  "' "$o/edge.edn") classes beyond jdk/edge.edn's, $(stat -c %s "$o/edge.edn") bytes ($(since "$t0"))" >&2
}

# convert OUT: the whole tree into OUT
convert() {
  local o=$1 t0 m
  t0=$(date +%s)
  mkdir -p "$work/log" "$work/tmp" "$o"
  [ "$(git -C "$jdk" rev-parse HEAD 2>/dev/null)" = "$pinned" ] || fail "$jdk is not jdk26u at $pinned"
  # the tool that converts, named by its key while the checkout is still the one it was built
  # from (JFS57 (b)): the conversion rewrites jdk/javac, which is in the key, so that asked after
  # writing a changed tree the tool no longer looked fresh and the provenance's host was empty
  local host
  host=$(. "$root/bin/lib/repr-java/host.bash" && repr_java_host) || fail "the tool is not fresh (bin/javac-vendor build)"
  echo "== generate (jdk.compiler's generated sources, the JDK build's langtools tools on javac's tool executable)" >&2
  generate || fail "jdk.compiler's generated sources differ from the build tree's ($work/generated.edn)"
  echo "== sources (jdk26u at $pinned, $jdk)" >&2
  sources || fail "the sources were not copied"
  echo "   $(wc -l < "$work/sources.txt") files: $(for m in $modules; do printf '%s %s, ' "$m" "$(grep -c "^$m " "$work/sources.txt")"; done)" >&2
  echo "== repr/java read-jdk (on javac's tool executable)" >&2
  rm -rf "$work/conv"
  for m in $modules; do convert_module "$m" "$work/conv" || return 1; done
  rm -rf "$o/forms"
  mkdir -p "$o/forms"
  for m in $modules; do
    (cd "$work/conv/$m" && find . -type f -name '*.ae' | while read -r f; do
       [ -e "$o/forms/$f" ] && { echo "javac-vendor: $f from two modules" >&2; exit 1; }
       mkdir -p "$o/forms/$(dirname "$f")" && cp "$f" "$o/forms/$f"
     done) || return 1
  done
  cp "$work/sources.txt" "$o/sources.txt"
  record_edge "$o" || return 1
  provenance "$o" "$host" > "$o/provenance.edn" || return 1
  platform_pin "$o" || return 1
  echo "javac-vendor: ${o#$root/}: $(find "$o/forms" -name '*.ae' | wc -l) forms files, $(du -sb "$o/forms" | cut -f1) bytes ($(since "$t0"))" >&2
}

# The platform javac on Arbace compiles against (JFS15 (b), JFS23 (b)): the JDK build tree's
# exploded modules ($JDK/build/*/jdk/modules), since JN6 every one of them (JFS37: the 68 modules of
# the JDK image the JVM's javac sees, so that bin/repr-java check --jdk reads any module of jdk26u
# on javac on Arbace; until JN6 the ten the corpora and javac's own sources name: java.base,
# java.compiler, java.datatransfer, java.desktop, java.logging, java.prefs, java.xml, jdk.compiler,
# jdk.internal.opt, jdk.zipfs), each with its module descriptor as the build's jmod holds it
# (images/jmods/MODULE.jmod's classes/module-info.class, which is the image's: it carries the
# module's version, which javac writes into a module's requires; the exploded descriptor has
# none), assembled into WORK/platform (a tree of links, the descriptor copied) and pinned by
# jdk/javac/platform.sha256 (one line per module: the SHA-256 of its files' sha256sum listing,
# sorted, without the build's _the.* marks)
platform_modules() {
  local c
  c=$(conf); [ -n "$c" ] || fail "no JDK build tree in $jdk/build (its jdk/modules, images/jmods)"
  (cd "$(dirname "$c")/jdk/modules" && ls | LC_ALL=C sort)
}
module_hash() { (cd "$1" && find -L . -type f ! -name '_the.*' | LC_ALL=C sort | xargs -d '\n' sha256sum | sha256sum | cut -c1-64); }
# platform_make DIR: DIR/MODULE for each module
platform_make() {
  local d=$1 c b m
  c=$(conf); [ -n "$c" ] || fail "no JDK build tree in $jdk/build (its jdk/modules, images/jmods)"
  b=$(dirname "$c")
  rm -rf "$d"; mkdir -p "$d"
  for m in $(platform_modules); do
    [ -f "$b/jdk/modules/$m/module-info.class" ] && [ -f "$b/images/jmods/$m.jmod" ] || fail "no module $m in $b/jdk/modules, images/jmods"
    cp -rs "$b/jdk/modules/$m" "$d/$m" || return 1
    rm -f "$d/$m/module-info.class"
    # a jmod is a zip after its 4-byte header (unzip warns of it)
    unzip -p "$b/images/jmods/$m.jmod" classes/module-info.class > "$d/$m/module-info.class" 2> "$d/.unzip.log"
    [ "$(head -c 4 "$d/$m/module-info.class" | od -An -tx1 | tr -d ' ')" = cafebabe ] || fail "no module descriptor in $b/images/jmods/$m.jmod"
  done
}
# platform DIR: the platform made, each module checked against the pin
platform() {
  local d=$1 m h want st=0
  platform_make "$d" || return 1
  for m in $(platform_modules); do
    h=$(module_hash "$d/$m")
    want=$(sed -n "s/^\([0-9a-f]\{64\}\)  $m\$/\1/p" "$out/platform.sha256" 2>/dev/null)
    if [ "$h" != "$want" ]; then echo "javac-vendor: the platform's $m: $h, pinned ${want:-none} ($out/platform.sha256)" >&2; st=1; fi
  done
  return $st
}
# platform_pin OUT: OUT/platform.sha256
platform_pin() {
  local o=$1 m
  platform_make "$work/platform" || return 1
  {
    echo "# The platform of javac on Arbace (bin/javac-vendor classes; doc/classes/JAVA-FRONTEND-SURVEY.md,"
    echo "# JFS15 (b), JFS23 (b), \"As built: JN3\"): jdk26u's build tree at $pinned,"
    echo "# build/$(basename "$(dirname "$(conf)")")/jdk/modules with each module's module-info.class from images/jmods;"
    echo "# per module the SHA-256 of its files' sha256sum listing (sorted, without _the.*)"
    for m in $(platform_modules); do echo "$(module_hash "$work/platform/$m")  $m"; done
  } > "$o/platform.sha256"
}

# javac's options for the corpora, as bin/lib/repr-java/roundtrip's compile gives them
classes_opts=(-Xmaxerrs 100000 -g:none -nowarn -XDsuppressNotes -proc:none -implicit:none)
jdk_opts=(-XDstringConcat=inline --enable-preview -source 26)

# compile_both NAME SRC [OPTION...]: every .java under SRC (sorted, relative to SRC, as the round
# trip lists them) compiled by the JVM's javac into WORK/classes/NAME/jvm and by javac on Arbace
# into WORK/classes/NAME/arbace, then compared byte for byte
compile_both() {
  local name=$1 src=$2 w=$work/classes/$1 t0 t1 n1 n2 st=0
  shift 2
  rm -rf "$w"; mkdir -p "$w/jvm" "$w/arbace"
  (cd "$src" && find . -name '*.java' | sed 's|^\./||' | LC_ALL=C sort) > "$w/files.list"
  t0=$(date +%s%N)
  (cd "$src" && javac -J-Xmx4g "${classes_opts[@]}" -d "$w/jvm" "$@" "@$w/files.list") > "$w/jvm.log" 2>&1 || st=1
  t1=$(date +%s%N); echo $(( (t1 - t0) / 1000000 )) > "$w/jvm.ms"
  (cd "$src" && TMPDIR=$work/tmp "$javac_exe" "$work/javac.ae" --platform "$work/platform" "${classes_opts[@]}" -d "$w/arbace" "$@" "@$w/files.list") > "$w/arbace.log" 2>&1 || st=$((st + 2))
  t0=$(date +%s%N); echo $(( (t0 - t1) / 1000000 )) > "$w/arbace.ms"
  n1=$(find "$w/jvm" -name '*.class' | wc -l); n2=$(find "$w/arbace" -name '*.class' | wc -l)
  [ $((st & 1)) = 0 ] || echo "   $name: the JVM's javac failed ($w/jvm.log)"
  [ $((st & 2)) = 0 ] || echo "   $name: javac on Arbace failed ($w/arbace.log: $(grep -c 'error:' "$w/arbace.log") errors)"
  if diff -r "$w/jvm" "$w/arbace" > "$w/classes.diff" && cmp -s "$w/jvm.log" "$w/arbace.log" && [ $st = 0 ]; then
    echo "   $name: $(wc -l < "$w/files.list") files, $n1 classes: equal byte for byte (the JVM's javac $(cat "$w/jvm.ms") ms, javac on Arbace $(cat "$w/arbace.ms") ms)"
  else
    echo "   $name: $(wc -l < "$w/files.list") files, $n1 classes by the JVM's javac, $n2 on Arbace: DIFFER ($w/classes.diff: $(grep -c '^Files\|^Only\|^Binary' "$w/classes.diff") files; logs equal: $(cmp -s "$w/jvm.log" "$w/arbace.log" && echo yes || echo no))"
    return 1
  fi
}

# base_corpus: java.base by javac on Arbace and by the JVM's javac, as the JDK build compiles it,
# against the build's classes
base_corpus() {
  local c b w=$work/classes/java.base t0 t1 st=0 n
  c=$(conf); b=$(dirname "$c")
  rm -rf "$w"; mkdir -p "$w/jvm" "$w/arbace" "$w/build"
  grep -v '^$' "$b/jdk/modules/java.base/_the.java.base_batch.filelist" > "$w/files.list"
  local opts=(-g -source 26 -target 26 -implicit:none -Xprefer:source -XDignore.symbol.file=true -XDstringConcat=inline
              --module-source-path "$b/support/gensrc/*:$jdk/src/*/linux/classes:$jdk/src/*/unix/classes:$jdk/src/*/share/classes"
              --module-path "" --system none -encoding utf-8)
  t0=$(date +%s%N)
  (cd "$w" && javac -J-Xmx4g "${opts[@]}" -d "$w/jvm" "@$w/files.list") > "$w/jvm.log" 2>&1 || st=1
  t1=$(date +%s%N); echo $(( (t1 - t0) / 1000000 )) > "$w/jvm.ms"
  (cd "$w" && TMPDIR=$work/tmp "$javac_exe" "$work/javac.ae" "${opts[@]}" -d "$w/arbace" "@$w/files.list") > "$w/arbace.log" 2>&1 || st=$((st + 2))
  t0=$(date +%s%N); echo $(( (t0 - t1) / 1000000 )) > "$w/arbace.ms"
  # the build's class files of java.base, but its module-info.class, which the build rewrites
  # after javac (make/ExplodedImageOptimize.gmk: build.tools.jigsaw.AddPackagesAttribute adds a
  # ModulePackages attribute): javac's own is compared with the JVM's javac's only
  (cd "$b/jdk/modules" && find java.base -name '*.class' ! -path java.base/module-info.class | while read -r f; do mkdir -p "$w/build/$(dirname "$f")"; ln -s "$b/jdk/modules/$f" "$w/build/$f"; done)
  [ $((st & 1)) = 0 ] || echo "   java.base: the JVM's javac failed ($w/jvm.log)"
  [ $((st & 2)) = 0 ] || echo "   java.base: javac on Arbace failed ($w/arbace.log: $(grep -c 'error:' "$w/arbace.log") errors)"
  n=$(find -L "$w/build" -name '*.class' | wc -l)
  diff -r "$w/jvm" "$w/arbace" > "$w/classes.diff"; local d1=$?
  diff -r -x module-info.class "$w/build" "$w/arbace" > "$w/build.diff"; local d2=$?
  echo "   java.base: $(wc -l < "$w/files.list") files, $n classes in the build, $(find "$w/arbace" -name '*.class' | wc -l) by javac on Arbace, $(find "$w/jvm" -name '*.class' | wc -l) by the JVM's (the JVM's javac $(cat "$w/jvm.ms") ms, javac on Arbace $(cat "$w/arbace.ms") ms)"
  echo "   java.base: javac on Arbace against the JVM's: $([ $d1 = 0 ] && echo 'equal byte for byte' || echo "DIFFER ($w/classes.diff: $(grep -c '^Files\|^Only\|^Binary' "$w/classes.diff") files)")"
  echo "   java.base: javac on Arbace against the build's classes (but module-info.class): $([ $d2 = 0 ] && echo 'equal byte for byte' || echo "DIFFER ($w/build.diff: $(grep -c '^Files\|^Only\|^Binary' "$w/build.diff") files)")"
  [ $st = 0 ] && [ $d1 = 0 ] && [ $d2 = 0 ]
}

# classes CORPUS...: javac on Arbace against the JVM's javac (JN3)
classes() {
  local c st=0 frozen orig
  javac_exe=${JAVAC_EXE:-$root/target/arbace-go/amd64/arbace-javac}
  [ -x "$javac_exe" ] || fail "no $javac_exe (bin/arbace-go --build-java, or JAVAC_EXE)"
  mkdir -p "$work/classes" "$work/tmp"
  printf '(System/exit (jdk.internal.jrt.javac.Main/run (into-array String *command-line-args*)))\n' > "$work/javac.ae"
  platform "$work/platform" || return 1
  echo "== javac on Arbace ($javac_exe) against the JVM's ($(javac -version 2>&1)); the platform ${out#$root/}/platform.sha256"
  for c in "$@"; do
    case $c in
      baseline)
        . "$root/bin/lib/tools.bash"
        frozen=$(frozen_clojure) || return 1
        compile_both baseline "$frozen" -sourcepath "$frozen" || st=1 ;;
      samples)
        compile_both samples-java "$root/test/repr/java/java" || st=1
        compile_both samples-module "$root/test/repr/java/module" || st=1 ;;
      jdk)
        orig=${JRT_WORK_RT:-$work/jdk-originals}
        # made again when what they are made from changed, checked (bin/lib/repr-java/originals.bash)
        . "$root/bin/lib/repr-java/originals.bash"
        arbace_jdk_originals "$orig" "$work/classes/jrt.log" "${JRT_WORK_RT:-}" | sed "s|^|   |; s|$root/||g"
        [ "${PIPESTATUS[0]}" = 0 ] || { echo "javac-vendor: the jdk corpus's originals ($work/classes/jrt.log)" >&2; return 1; }
        compile_both jdk "$orig/src/java.base" --patch-module "java.base=$orig/src/java.base" "${jdk_opts[@]}" || st=1 ;;
      java.base)
        # JFS2 (a): java.base compiled as the JDK build compiles it (its batch's file list and
        # options, jdk/modules/java.base/_the.java.base_batch.cmdline: multi-module, no system
        # modules), compared with the build's own class files, jdk/modules/java.base. Left out
        # of the build's options: -h (the native headers), -Xplugin:depend and the -XD options of
        # its javacserver, -Xlint:all, -Xdoclint and -Werror (diagnostics only)
        base_corpus || st=1 ;;
      *) fail "no corpus $c (baseline, samples, jdk, java.base)" ;;
    esac
  done
  return $st
}

case $cmd in
  convert) convert "$out" || exit 1 ;;
  edge) record_edge "$out" || exit 1 ;;
  verify)
    unset JAVAC_VENDOR_BOOTSTRAP
    rm -rf "$work/fresh"
    convert "$work/fresh" || exit 1
    . "$root/bin/lib/repr-java/host.bash"
    # the provenance but its host (the tool that wrote it, JFS32): reported
    if diff -r -x provenance.edn "$out" "$work/fresh" > "$work/verify.diff" &&
       repr_java_provenance_same "$out/provenance.edn" "$work/fresh/provenance.edn"; then
      echo "javac-vendor verify: ${out#$root/} is the conversion and the recording, byte for byte ($(find "$out" -type f | wc -l) files; the provenance's host $(grep -o ':host "[^ ]* [0-9a-f]\{12\}' "$out/provenance.edn" | cut -c8-), this run's $(grep -o ':host "[^ ]* [0-9a-f]\{12\}' "$work/fresh/provenance.edn" | cut -c8-))"
    else
      diff -r "$out" "$work/fresh" > "$work/verify.diff"
      echo "javac-vendor verify: ${out#$root/} differs from a fresh conversion ($work/verify.diff: $(wc -l < "$work/verify.diff") lines)"
      exit 1
    fi ;;
  check)
    mkdir -p "$work/check"
    t0=$(date +%s)
    exe=${J2G_GO_EXE:-$root/target/arbace-go/amd64/arbace}
    [ -x "$exe" ] || fail "no $exe (bin/arbace-go --build, or J2G_GO_EXE)"
    echo "== j2g on $exe"
    # shellcheck disable=SC2046
    J2G_GO_EXE=$exe bin/j2g --program $(tool_args "$out") --edge "$root/jdk/edge.edn" --edge "$out/edge.edn" --out "$work/check/j2g" \
      > "$work/check/j2g.log" 2>&1
    st=$?
    grep '^j2g: .*classes analyzed\|^j2g: reachability\|^j2g: error' "$work/check/j2g.log"
    [ $st = 0 ] || { tail -20 "$work/check/j2g.log"; fail "j2g failed ($work/check/j2g.log)"; }
    if grep -q '^j2g: .*classes analyzed.*failures' "$work/check/j2g.log"; then
      awk '/^ :analysis-failures/,/^ :variants/' "$work/check/j2g/report.edn" | head -40
      fail "classes of javac's world failed their analysis ($work/check/j2g/report.edn)"
    fi
    echo "javac-vendor check: j2g translates javac's world, no failures ($(since "$t0"))" ;;
  build)
    # j2g on the program built from the checkout (JFS22 (a)), when there is one
    [ -z "${J2G_GO_EXE:-}" ] && [ -x "$root/target/arbace-go/amd64/arbace" ] && export J2G_GO_EXE=$root/target/arbace-go/amd64/arbace
    exec bin/arbace-go --build-java "$@" ;;
  classes)
    [ $# -gt 0 ] || set -- baseline samples jdk
    t0=$(date +%s)
    classes "$@" || { echo "javac-vendor classes: javac on Arbace differs from the JVM's ($(since "$t0"))"; exit 1; }
    echo "javac-vendor classes: javac on Arbace compiles $* as the JVM's javac, byte for byte ($(since "$t0"))" ;;
  platform)
    d=${1:-$work/platform}
    case $d in /*) ;; *) d=$root/$d ;; esac
    platform "$d" || exit 1
    echo "$d" ;;
  platform-pin) platform_pin "$out" && cat "$out/platform.sha256" ;;
  *) sed -n '2,/^set -/p' "$0" | sed '$d; s/^# \{0,1\}//' >&2; exit 2 ;;
esac

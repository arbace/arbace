#!/bin/bash
# javac's forms (doc/classes/JAVA-FRONTEND-SURVEY.md, JN2, JFS3 (b)): jdk26u's javac, its modules
# jdk.compiler (with the sources the JDK build generates for it), java.compiler and
# jdk.internal.opt's CommandLine, read by repr/java into Java forms in jdk/javac/, with the
# java.base classes javac's world needs beyond the program's (the 19 of the survey's JN1.2 and JN3's 4, from
# jdk26u, and jrt's own for javac, overlay/jdk/javac/java.base: a ServiceLoader that finds no
# provider; and, in jdk.compiler, javac's command line and file manager on Arbace,
# jdk.internal.jrt.javac, JN3); since JN7 the JDK build's tools bin/jrt-convert's generate step runs
# on the tool (make/jdk/src/classes/build/tools, module buildtools, with the interim copies of
# java.time.zone), with the JDK's classes they need (overlay/jdk/javac/closure.txt: java.xml's SAX
# parser, java.base's) and jrt's own zlib Deflater; and the edge of javac's world (JFS14 (b)); the tool executable's
# input (JFS4 (b)), as jdk/forms is the program's. jdk26u is pinned (JFS8 (a)): $JDK's commit must be the provenance's.
# Since JFS48 (b) jdk.compiler's generated sources are generated here as the JDK build generates them
# (make/modules/jdk.compiler/Gensrc.gmk), by its langtools tools (make/langtools/tools:
# compileproperties, the resource bundles' classes; propertiesparser, CompilerProperties and
# LauncherProperties) read into module buildtools and run on javac's tool executable, and compared
# with the build tree's support/gensrc/jdk.compiler (WORK/generated.edn); since JFS52 (b) FlagsEnum
# too, by flagsgenerator, which compiles Flags.java through javax.tools' API: javac on Arbace's
# JavaCompiler (overlay/jdk/javac/jdk.compiler's SystemCompiler, ToolProvider's tool-world variant)
# against the platform (below), so that no generated source is copied from the build tree
# (doc/classes/JAVA-FRONTEND-SURVEY.md, "As built: JFS48 (b)", "As built: JFS52 (b)").
#
#   bin/javac-vendor convert  the sources copied from $JDK (and overlay/jdk/javac/MODULE) into
#                             WORK/src/MODULE, converted by `bin/repr-java read-jdk --check` (on
#                             javac's tool executable, bin/repr-java's only host since JN6: javac
#                             on Arbace reading javac's own sources, the fixpoint) module by
#                             module, merged into OUT/forms
#                             (repr/java's reports left out); OUT/sources.txt (MODULE KIND PATH:
#                             share, a file of jdk26u's src/MODULE/share/classes; gensrc, of
#                             support/gensrc/MODULE as this script generates it (below);
#                             gensrc-build, of the JDK build's support/gensrc/MODULE, copied
#                             (none since JFS52 (b)); overlay, of overlay/jdk/javac/MODULE; make, of
#                             make/jdk/src/classes; langtools, of make/langtools/tools; interim,
#                             a java.time.zone file as make/CopyInterimTZDB.gmk copies it), OUT/provenance.edn; then the edge
#                             (module buildtools by bin/repr-java read, the class path, with
#                             --add-exports java.base/sun.text=ALL-UNNAMED as the build's).
#                             First the generate step (JFS48 (b)): version.properties as
#                             GensrcCommon.gmk's SetupVersionProperties writes it (the build's
#                             spec.gmk's VERSION_NUMBER, VERSION_STRING, VERSION_SHORT),
#                             compileproperties.CompileProperties over jdk.compiler's .properties
#                             and it, propertiesparser.PropertiesParser over compiler.properties
#                             and launcher.properties, flagsgenerator.FlagsGenerator over
#                             Flags.java into FlagsEnum.java (JFS52 (b): javac on Arbace's
#                             JavaCompiler, its standard file manager's platform the platform
#                             below, WORK/platform, checked against its pin, as the system
#                             property jdk.internal.jrt.javac.platform), each tool's main called on javac's tool
#                             executable ($REPR_JAVA_EXE, bin/repr-java's) with
#                             make/langtools/tools on ARBACE_PATH (propertiesparser's templates),
#                             into WORK/gensrc/jdk.compiler; each output compared with the build
#                             tree's (WORK/generated.edn: :same, :different, :no-reference): a
#                             difference fails. JAVAC_VENDOR_BOOTSTRAP=1 takes the build tree's
#                             files instead (a tool that does not yet hold the generators; the
#                             provenance says so, and verify, which always generates, then differs)
#   bin/javac-vendor edge     the edge of javac's world alone: bin/j2g --program --record-edge on
#                             the frozen JVM over the program and OUT/forms (with the tool's
#                             variants, overlay/jdk/javac/variants), less what jdk/edge.edn
#                             answers alike (arbace.j2g.edge's subtract), into OUT/edge.edn;
#                             jdk/edge.edn stays the shipped build's
#   bin/javac-vendor verify   convert into WORK/fresh and compare with OUT (diff -r; the
#                             provenance's host, the tool that wrote it, reported, not compared:
#                             JFS32): the tree is what the conversion and the recording give, byte
#                             for byte
#   bin/javac-vendor check    j2g translates javac's world (bin/j2g --program with OUT/forms,
#                             the tool's variants and both edges): status 0 and no class failing
#                             its analysis (WORK/check/j2g.log, report.edn). On the program built
#                             from the checkout (target/arbace-go/amd64/arbace, bin/arbace-go
#                             --build; J2G_GO_EXE names another), whose Java forms' analysis is the
#                             checkout's: j2g runs on its host's own (bin/j2g)
#   bin/javac-vendor build    the tool executable: bin/arbace-go --build-java (its header), j2g on
#                             target/arbace-go/amd64/arbace when it exists (JFS22; J2G_GO_EXE)
#   bin/javac-vendor tool DIR --check
#                             only whether DIR holds the tool at the checkout's key (exit 0 for a
#                             hit, 1 for a miss; GTS57 (a): bin/gate takes no heavy lock for a hit)
#   bin/javac-vendor tool DIR [--host EXE] [--aot-base DIR]
#                             the tool kept by its key (GT3, doc/GATE-SURVEY.md, GTS11 (a); bin/gate
#                             --full's javac-tool): DIR/arbace-javac when its key is the checkout's
#                             arbace_javac_key, else built (--build-java for amd64, j2g on EXE, the
#                             compiled namespaces of DIR's aot/ when of the checkout's key) and
#                             copied into DIR with its j2g run's log and report
#   bin/javac-vendor check --from DIR
#                             check's verdict from the tool build's own j2g run in DIR (javac's world
#                             translated once): the tool of the checkout's key, status 0 and no class
#                             failing its analysis
#   bin/javac-vendor classes [CORPUS...]
#                             javac on Arbace (JN3): the tool executable ($JAVAC_EXE, default
#                             target/arbace-go/amd64/arbace-javac) runs javac's command line on
#                             Arbace (jdk.internal.jrt.javac.Main, overlay/jdk/javac/jdk.compiler)
#                             against the platform (below), and the JVM's javac (javac on $PATH,
#                             the frozen JDK) the same; their class files are compared byte for
#                             byte, and their diagnostics (the JVM's javac, a JDK, not the frozen
#                             jar: the reference while a JDK is at hand, JFS41). Corpora (default
#                             baseline samples jdk):
#                             baseline (the frozen clojure/'s 183 files), samples
#                             (test/repr/java/java and module), jdk (java.base's closure, 838
#                             files, made by bin/jrt-convert's sources and generate steps into
#                             WORK/jdk-originals; JRT_WORK_RT names others), with the round
#                             trip's javac options (bin/lib/repr-java/roundtrip, -g:none); and
#                             java.base (JFS2 (a)): jdk26u's java.base as the JDK build compiles it,
#                             also compared with the build's own class files; modules (JCS359's
#                             first step): every module of the platform (JAVAC_VENDOR_MODULES: some) as
#                             the JDK build compiles it, by javac on Arbace alone, against the build's
#                             class files (no JVM; WORK/classes/modules/summary.tsv). Since JCS359's stage 1
#                             (JCS362 (a), JCS360 (a)) its options and sources are OUT/platform-build.edn's, not
#                             the build tree's command lines, and every difference is judged against
#                             OUT/platform-own-known.edn (known, or the module fails; a stale entry fails too;
#                             then two negative controls on the run's own results); --jobs N: N modules at once
#                             (a module of more than JAVAC_VENDOR_ALONE files, default 1000, alone). In WORK/classes/
#   bin/javac-vendor platform [DIR]
#                             the platform made into DIR (default WORK/platform) and checked
#                             against OUT/platform.sha256; prints DIR (repr/java on Arbace,
#                             bin/repr-java, JN4)
#   bin/javac-vendor platform-build [--check]
#                             the JDK build's configuration as data (JCS362 (a)): each module's javac options,
#                             sources (roots and excludes), the version strings, the C preprocessor's flags and
#                             the jmod flags, each with its origin, derived from the build tree into
#                             OUT/platform-build.edn; --check (the oracle tier's): derived afresh and compared
#   bin/javac-vendor platform-gensrc [--check]
#                             the generated sources' configuration as data (JCS359 (a)(2), JCS362 (a)): the tool runs the
#                             JDK build recorded (support/gensrc's command lines), its text substitutions, module lists,
#                             spec.gmk's values and each module's resource-only packages, derived from the build tree into
#                             OUT/platform-gensrc.edn; --check (the oracle tier's): derived afresh and compared
#   bin/javac-vendor gensrc [MODULE...]
#                             JCS359 (a)(2): the 16 modules' generated sources (default all) made into WORK/gensrc/out as
#                             the JDK build makes them, by its own tools on javac's tool executable (the recorded runs
#                             replayed, make's other rules ported: test/javac-platform/gensrc.bash, its header; the tools the
#                             tool does not hold compiled read and interpreted, with their tool-world variants,
#                             overlay/jdk/javac/buildtools{,-world}; the two C-preprocessed sources by repr/c, JCS369 (a)),
#                             each .java against the build's support/gensrc and OUT/platform-gensrc-known.edn
#                             (WORK/gensrc/summary.tsv, generated.edn); two negative controls
#   bin/javac-vendor descriptors [MODULE...]
#                             JCS359 (a)(3): each module's descriptor (default all 68) extended as AddPackagesAttribute and
#                             jmod create extend it (test/javac-platform/modinfo.ae), from classes modules' own descriptor
#                             when it ran, else from the build's exploded one; against the exploded and the jmod's
#                             descriptors and OUT/platform-descriptors-known.edn (WORK/descriptors/summary.tsv); a negative
#                             control
#   bin/javac-vendor platform-pin
#                             the platform made and pinned alone: OUT/platform.sha256 (JFS15 (b),
#                             JFS23 (b): the build tree's exploded modules with their jmods' module
#                             descriptors), which convert writes too (and verify so compares)
#
# Options (before the command): --work DIR (default .tmp/javac-vendor), --out DIR (default
# jdk/javac). Environment: JDK (jdk26u's checkout, default /root/jdk26u, with its build tree,
# whose support/gensrc holds the generated sources), REPR_JAVA_EXE (bin/repr-java's tool),
# J2G_JVM_OPTS (the edge's recording on the frozen JVM, default -Xmx16g).
set -uo pipefail
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
. "$root/bin/lib/tmpdir.bash" # TMPDIR: .tmp/tmp when unset
. "$root/bin/lib/heavy.bash" # heavy_run: the corpus read under the gate's lock (GTS31 (b))
. "$root/bin/lib/renamed-env.bash" # stops on a stale G2A_*, J2A_*, A2G_* or C2A_*
cd "$root"
work=$root/.tmp/javac-vendor out=$root/jdk/javac
while [ $# -gt 0 ]; do
  case $1 in
    --work) work=$2; shift 2 ;;
    --out) out=$2; shift 2 ;;
    *) break ;;
  esac
done
cmd=${1:-}
[ $# -gt 0 ] && shift
case $work in /*) ;; *) work=$root/$work ;; esac
case $out in /*) ;; *) out=$root/$out ;; esac
jdk=${JDK:-/root/jdk26u}
fail() { echo "javac-vendor: $*" >&2; exit 1; }
since() { echo "$(( $(date +%s) - $1 )) s"; }

# The origin, pinned (JFS8 (a)): jdk26u at the commit of jdk/'s forms
pinned=baf63fbe42b8758448fee570a9d9bb914272d259
# javac's modules: jdk.compiler's and java.compiler's share/classes whole (module-info.java,
# which repr/java cannot patch, and the javadoc's snippet-files left out, as repr/java leaves
# them), jdk.compiler's generated sources (the JDK build's support/gensrc/jdk.compiler: the
# properties' classes, FlagsEnum, the resource bundles), and of jdk.internal.opt the one class
# javac's launcher uses
modules="jdk.compiler java.compiler jdk.internal.opt java.base java.xml buildtools"
# (JFS48 (b)) jdk.compiler's generated sources: generated here by the JDK build's langtools tools
# (make/langtools/tools, read into module buildtools, KIND langtools) on the tool, but those of
# gensrc_build, copied from the build tree (KIND gensrc-build): none since JFS52 (b), when
# flagsgenerator makes FlagsEnum on the tool too (until then copied)
langtools_dirs="compileproperties flagsgenerator propertiesparser"
gensrc_build=""
opt_files="jdk/internal/opt/CommandLine.java"
# java.base's classes javac's world needs beyond the program's (the survey's JN1.2): declarations
# of javac's classes (annotation types, supertypes, exceptions) and TypeTag's range checks; and
# (JN3) ClassWriter's: DataOutputStream (javac's ByteBuffer.appendLong, appendFloat, appendDouble)
# with its interface, exception and ModifiedUtf, in the program's world since JC6b
# (doc/classes/JAVA-CONFORMANCE-SURVEY.md, "As built: JC6b") with FilterWriter and
# ExactConversionsSupport; java.nio.file's FileSystem and its kin in the program's world since F9
# (doc/classes/JAVA-DEFERRED-TRIAGE.md, "As built: F9 (write-ahead)"), with jrt's FileSystems overlay of this
# world removed (SafeVarargs and java.lang.annotation's AnnotationTypeMismatchException, Documented, Inherited,
# Repeatable left with F14, doc/classes/JAVA-DEFERRED-TRIAGE.md: the shipped closure has them)
base_files="java/io/IOError.java
  java/lang/module/InvalidModuleDescriptorException.java
  java/util/spi/ToolProvider.java sun/reflect/annotation/ExceptionProxy.java"
overlay=$root/overlay/jdk/javac
variants=$overlay/variants
# (JN7) the JDK build's tools bin/jrt-convert's generate step runs on Arbace: the build's own
# sources of make/jdk/src/classes/build/tools (module buildtools: the class path, as the build's
# BUILD_TOOLS_JDK compiles them; KIND make), the interim copies of java.time.zone that
# build.tools.tzdb compiles with it (KIND interim: make/CopyInterimTZDB.gmk's, the package renamed),
# and the JDK's classes they need beyond the program's and javac's (overlay/jdk/javac/closure.txt:
# java.xml's SAX parser, java.base's); since F1 (doc/classes/JAVA-DEFERRED-TRIAGE.md) intpoly's
# FieldGen, the JCA's field arithmetic
tool_dirs="cldrconverter generatebreakiteratordata generatecharacter generatecurrencydata
  generateextraproperties generatelsrequivmaps intpoly makejavasecurity spp tzdb"
interim_tzdb="ZoneOffsetTransition ZoneOffsetTransitionRule ZoneRules Ser"
closure=$overlay/closure.txt
# since F4 (doc/classes/JAVA-DEFERRED-TRIAGE.md): the JDK build's CompileProperties, which makes
# java.base's security messages (sun.security.util.resources) in bin/jrt-convert's generate step
tool_dirs="$tool_dirs compileproperties"
# since F8 (doc/classes/JAVA-DEFERRED-TRIAGE.md): the JDK build's charsetmapping tool, which makes
# java.base's charset tables and StandardCharsets (sun.nio.cs) in bin/jrt-convert's generate step
tool_dirs="$tool_dirs charsetmapping"

# quiet: the scratch file the output nobody wants goes to (stderr of probes, a result unused)
quiet=$TMPDIR/javac-vendor.quiet
conf() { local f; for f in "$jdk"/build/*/spec.gmk; do if [ -e "$f" ]; then echo "$f"; return 0; fi; done; }
# spec VAR: a value of the build's spec.gmk (VAR := VALUE)
spec() { sed -n "s/^$1 := //p" "$(conf)" | head -1; }

# The generators (JFS48 (b)): the JDK build's langtools tools as Java forms on javac's tool
# executable, each main called by its class name, as bin/jrt-convert's generate step calls
# make/jdk/src/classes' (JN7)
gen_exe() { . "$root/bin/lib/host.bash"; echo "${REPR_JAVA_EXE:-$root/target/arbace-go/$(arbace_host_arch)/arbace-javac}"; }
gen_tools="compileproperties.CompileProperties flagsgenerator.FlagsGenerator propertiesparser.PropertiesParser"
# gen_script PLATFORM: the script; javax.tools' system compiler on the tool (JFS52 (b),
# jdk.internal.jrt.javac.SystemCompiler) attributes against PLATFORM, as the JDK's against its image
gen_script() {
  local c
  echo ';; bin/javac-vendor'"'"'s generate step: a JDK build langtools tool'"'"'s main (JFS48 (b), JFS52 (b))'
  echo "(System/setProperty \"jdk.internal.jrt.javac.platform\" \"$1\")"
  echo '(let [[c & args] *command-line-args* a (into-array String args)]'
  echo '  (case c'
  for c in $gen_tools; do echo "    \"$c\" ($c/main a)"; done
  echo '    (do (println "javac-vendor: no tool" c) (System/exit 2))))'
}
vprops=com/sun/tools/javac/resources/version.properties

# generate: WORK/gensrc/jdk.compiler as make/modules/jdk.compiler/Gensrc.gmk makes it, then
# WORK/generated.edn, each output against the build tree's
generate() {
  local c ref g=$work/gensrc/jdk.compiler src=$jdk/src/jdk.compiler/share/classes rel v st=0 exe t0
  t0=$(date +%s)
  c=$(conf); [ -n "$c" ] || fail "no JDK build tree in $jdk/build (its spec.gmk)"
  ref=$(dirname "$c")/support/gensrc/jdk.compiler
  rm -rf "$work/gensrc" "$work/gen-tools"
  mkdir -p "$g/$(dirname "$vprops")" "$work/gen-tools" "$work/tmp"
  if [ "${JAVAC_VENDOR_BOOTSTRAP:-}" = 1 ]; then
    echo "   bootstrap (JAVAC_VENDOR_BOOTSTRAP=1): the build tree's files, not generated" >&2
    (cd "$ref" && find . -name '*.java' -o -name '*.properties' | sed 's|^\./||') | while read -r rel; do
      case " $gensrc_build " in *" $rel "*) continue ;; esac
      mkdir -p "$g/$(dirname "$rel")" && cp "$ref/$rel" "$g/$rel"
    done
  else
    exe=$(gen_exe)
    [ -x "$exe" ] || fail "no $exe (bin/javac-vendor build, or REPR_JAVA_EXE)"
    platform "$work/platform" || { echo "javac-vendor: the platform differs from its pin" >&2; return 1; }
    gen_script "$work/platform" > "$work/gen-tools/gen.ae"
    local tool=(env "TMPDIR=$work/tmp" "ARBACE_PATH=$jdk/make/langtools/tools" "$exe" "$work/gen-tools/gen.ae")
    # GensrcCommon.gmk's SetupVersionProperties: jdk.compiler's version.properties
    printf 'jdk=%s\nfull=%s\nrelease=%s\n' "$(spec VERSION_NUMBER)" "$(spec VERSION_STRING)" "$(spec VERSION_SHORT)" > "$g/$vprops"
    # GensrcProperties.gmk's SetupCompileProperties (TYPE langtools, CLASS
    # java.util.ListResourceBundle, EXTRA_FILES version.properties; no translation excluded):
    # -compile PROPERTIES JAVA CLASS for each, in an @-file, -quiet
    {
      (cd "$src" && find . -name '*.properties' | sed 's|^\./||' | LC_ALL=C sort) | while read -r rel; do
        printf -- '-compile\n%s\n%s\n%s\n' "$src/$rel" "$g/${rel%.properties}.java" java.util.ListResourceBundle
      done
      printf -- '-compile\n%s\n%s\n%s\n' "$g/$vprops" "$g/${vprops%.properties}.java" java.util.ListResourceBundle
    } > "$work/gen-tools/compileproperties.cmdline"
    sed -n '3~4p' "$work/gen-tools/compileproperties.cmdline" | while read -r f; do mkdir -p "$(dirname "$f")"; done
    "${tool[@]}" compileproperties.CompileProperties -quiet "@$work/gen-tools/compileproperties.cmdline" \
      > "$work/log/compileproperties.log" 2>&1 || { cat "$work/log/compileproperties.log" >&2; return 1; }
    # Gensrc.gmk's PARSEPROPERTIES: compiler.properties and launcher.properties into their factories
    "${tool[@]}" propertiesparser.PropertiesParser \
      -compile "$src/com/sun/tools/javac/resources/compiler.properties" "$g/com/sun/tools/javac/resources/" \
      -compile "$src/com/sun/tools/javac/resources/launcher.properties" "$g/com/sun/tools/javac/resources/" \
      > "$work/log/propertiesparser.log" 2>&1 || { cat "$work/log/propertiesparser.log" >&2; return 1; }
    # Gensrc.gmk's FLAGSGENERATOR: Flags.java's flags into FlagsEnum (JFS52 (b)), compiled by javac
    # on Arbace through javax.tools' API against the platform
    mkdir -p "$g/com/sun/tools/javac/code"
    "${tool[@]}" flagsgenerator.FlagsGenerator \
      "$src/com/sun/tools/javac/code/Flags.java" "$g/com/sun/tools/javac/code/FlagsEnum.java" \
      > "$work/log/flagsgenerator.log" 2>&1 || { cat "$work/log/flagsgenerator.log" >&2; return 1; }
  fi
  # against the build tree's support/gensrc/jdk.compiler (the generated files and those the build
  # has)
  {
    echo ";; bin/javac-vendor's generate step (JFS48 (b)): each output against the JDK build's"
    echo "{:generators \"$([ "${JAVAC_VENDOR_BOOTSTRAP:-}" = 1 ] && echo "the JDK build tree (bootstrap)" || echo "javac's tool executable")\" :jdk-gensrc \"$ref\""
    echo " :files {"
    { (cd "$g" && find . -type f | sed 's|^\./||'); (cd "$ref" && find . -name '*.java' -o -name '*.properties' | sed 's|^\./||'); } |
      LC_ALL=C sort -u | while read -r rel; do
      case " $gensrc_build " in *" $rel "*) continue ;; esac
      if [ ! -f "$g/$rel" ]; then v=:not-generated
      elif [ ! -f "$ref/$rel" ]; then v=:no-reference
      elif cmp -s "$g/$rel" "$ref/$rel"; then v=:same
      else v=:different; fi
      echo "  \"$rel\" $v"
    done
    echo "}}"
  } > "$work/generated.edn"
  grep -q ':different\|:not-generated' "$work/generated.edn" && st=1
  echo "   $(grep -c '" :same' "$work/generated.edn") of $(grep -c '^  "' "$work/generated.edn") generated files equal to the build tree's ($work/generated.edn; $(since "$t0"))" >&2
  return $st
}

# sources: WORK/src/MODULE and WORK/sources.txt
sources() {
  local c gensrc m rel
  c=$(conf); [ -n "$c" ] || fail "no JDK build tree in $jdk/build (its support/gensrc)"
  gensrc=$(dirname "$c")/support/gensrc
  [ "$(git -C "$jdk" rev-parse HEAD 2>"$quiet")" = "$pinned" ] || fail "$jdk is not jdk26u at $pinned"
  rm -rf "$work/src"
  {
    (cd "$jdk/src/jdk.compiler/share/classes" && find . -name '*.java' ! -name module-info.java ! -path '*/snippet-files/*' | sed 's|^\./||' | LC_ALL=C sort) |
      sed 's/^/jdk.compiler share /'
    { (cd "$work/gensrc/jdk.compiler" && find . -name '*.java' | sed 's|^\./||'); for rel in $gensrc_build; do echo "$rel"; done; } |
      LC_ALL=C sort | while read -r rel; do
      case " $gensrc_build " in *" $rel "*) echo "jdk.compiler gensrc-build $rel" ;; *) echo "jdk.compiler gensrc $rel" ;; esac
    done
    (cd "$overlay/jdk.compiler" && find . -name '*.java' | sed 's|^\./||' | LC_ALL=C sort) | sed 's/^/jdk.compiler overlay /'
    (cd "$jdk/src/java.compiler/share/classes" && find . -name '*.java' ! -name module-info.java ! -path '*/snippet-files/*' | sed 's|^\./||' | LC_ALL=C sort) |
      sed 's/^/java.compiler share /'
    for rel in $opt_files; do echo "jdk.internal.opt share $rel"; done
    for rel in $base_files; do echo "java.base share $rel"; done
    sed -n 's/^java.base //p' "$closure" | sed 's/^/java.base share /'
    (cd "$overlay/java.base" && find . -name '*.java' | sed 's|^\./||' | LC_ALL=C sort) | sed 's/^/java.base overlay /'
    sed -n 's/^java.xml //p' "$closure" | LC_ALL=C sort | sed 's/^/java.xml share /'
    for d in $tool_dirs; do (cd "$jdk/make/jdk/src/classes" && ls build/tools/$d/*.java); done | LC_ALL=C sort | sed 's/^/buildtools make /'
    for f in $interim_tzdb; do echo "build/tools/tzdb/$f.java"; done | LC_ALL=C sort | sed 's/^/buildtools interim /'
    (cd "$jdk/make/langtools/tools" && find $langtools_dirs -name '*.java') | LC_ALL=C sort | sed 's/^/buildtools langtools /'
  } > "$work/sources.txt"
  while read -r m kind rel; do
    mkdir -p "$work/src/$m/$(dirname "$rel")"
    case $kind in
      share) cp "$jdk/src/$m/share/classes/$rel" "$work/src/$m/$rel" ;;
      gensrc) cp "$work/gensrc/$m/$rel" "$work/src/$m/$rel" ;;
      gensrc-build) cp "$gensrc/$m/$rel" "$work/src/$m/$rel" ;;
      overlay) cp "$overlay/$m/$rel" "$work/src/$m/$rel" ;;
      make) cp "$jdk/make/jdk/src/classes/$rel" "$work/src/$m/$rel" ;;
      langtools) cp "$jdk/make/langtools/tools/$rel" "$work/src/$m/$rel" ;;
      interim) sed -e "s/package java.time.zone/package build.tools.tzdb/" \
                 < "$jdk/src/java.base/share/classes/java/time/zone/$(basename "$rel")" > "$work/src/$m/$rel" ;;
    esac || return 1
  done < "$work/sources.txt"
}

# origins MODULE: the names the converted files' headers give their sources (repr/java's
# --origins): not the work tree's copies, so that the output does not depend on where it was made
origins() {
  local m kind rel
  echo "{"
  while read -r m kind rel; do
    [ "$m" = "$1" ] || continue
    case $kind in
      share) echo "\"$rel\" \"jdk26u src/$m/share/classes/$rel\"" ;;
      gensrc) echo "\"$rel\" \"jdk26u support/gensrc/$m/$rel (generated by bin/javac-vendor)\"" ;;
      gensrc-build) echo "\"$rel\" \"jdk26u support/gensrc/$m/$rel (generated by the JDK build)\"" ;;
      overlay) echo "\"$rel\" \"overlay/jdk/javac/$m/$rel\"" ;;
      make) echo "\"$rel\" \"jdk26u make/jdk/src/classes/$rel\"" ;;
      langtools) echo "\"$rel\" \"jdk26u make/langtools/tools/$rel\"" ;;
      interim) echo "\"$rel\" \"jdk26u src/java.base/share/classes/java/time/zone/$(basename "$rel") (package build.tools.tzdb, as make/CopyInterimTZDB.gmk copies it)\"" ;;
    esac
  done < "$work/sources.txt"
  echo "}"
}

# convert_module MODULE CONV: WORK/src/MODULE converted into CONV/MODULE
convert_module() {
  local m=$1 conv=$2 log=$work/log/convert-$1.log n ro
  n=$(grep -c "^$m " "$work/sources.txt")
  origins "$m" > "$work/origins-$m.edn"
  rm -rf "${conv:?}/$m"
  # the read (JFS120 (b), doc/classes/JAVA-FRONTEND-SURVEY.md, "As built: JN9f"): without javac by
  # default, a file that falls back read by javac (counted in the log's "no javac:" line)
  . "$root/bin/lib/repr-java/host.bash"
  ro=$(repr_java_vendor_read_opts) || return 1
  if [ "$m" = buildtools ]; then
    # the build's tools on the class path (the unnamed module), with the build's --add-exports
    # for sun.text (make/CompileToolsJdk.gmk)
    (cd "$work" && "$root/bin/repr-java" read --check $ro --origins "$work/origins-$m.edn" \
       --javac --add-exports --javac java.base/sun.text=ALL-UNNAMED "$conv/$m" "$work/src/$m") > "$log" 2>&1
  else
  # from WORK: read-jdk copies the files into .tmp/repr-java-patch below the current directory
  (cd "$work" && REPR_JAVA_THREADS=8 REPR_JAVA_PATCH_ALL=1 \
     heavy_run "$root/bin/repr-java" read-jdk --check $ro --origins "$work/origins-$m.edn" "$conv/$m" "$m" "$work/src/$m") > "$log" 2>&1
  fi
  repr_java_nojavac_take "$conv/$m" "$log.d"
  echo "   $m: $(tail -1 "$log")${ro:+; $(grep '^no javac: ' "$log" | sed 's/^no javac: /without javac: /')}" >&2
  grep -q "^$n Java files, $n converted, 0 failed, 0 javac errors, .* 0 unreadable" "$log" ||
    { echo "javac-vendor: $m: not every file converted ($log)" >&2; return 1; }
}

# provenance OUT HOST: HOST, the converter's tool as convert found it before writing (JFS57 (b))
provenance() {
  local q='s/\\/\\\\/g; s/"/\\"/g' url clean c
  . "$root/bin/lib/repr-java/host.bash"
  url=$(git -C "$jdk" remote get-url origin 2>"$quiet" | sed "$q")
  if [ -z "$(git -C "$jdk" status --porcelain --untracked-files=no -- src make 2>"$quiet")" ]; then clean=true; else clean=false; fi
  c=$(conf)
  echo ";; The provenance of jdk/javac/ (bin/javac-vendor, doc/classes/JAVA-FRONTEND-SURVEY.md, JN2): what"
  echo ";; its forms and its edge were made from. Written by bin/javac-vendor convert; verify compares it."
  echo "{:jdk26u {:repo \"$url\" :commit \"$(git -C "$jdk" rev-parse HEAD)\" :clean $clean"
  echo "          :gensrc \"build/$(basename "$(dirname "$c")")/support/gensrc/jdk.compiler\"}"
  echo " :generated {:by \"$([ "${JAVAC_VENDOR_BOOTSTRAP:-}" = 1 ] && echo "the JDK build tree (bootstrap)" || echo "make/langtools/tools' compileproperties, flagsgenerator, propertiesparser on javac's tool executable")\""
  echo "             :files $(grep -c ' gensrc ' "$work/sources.txt") :equal-to-the-build $(grep -c '\.java" :same' "$work/generated.edn")"
  echo "             :copied [$(for rel in $gensrc_build; do printf '"%s"' "$rel"; done)]}"
  echo " :jdk \"$(repr_java_platform)\""
  echo " :converter {:repr-java \"$(repr_java_reader_hash)\""
  echo "             :read :$(repr_java_vendor_read)"
  echo "             :host \"$2\"}"
  echo " :edge {:recorded-by \"bin/j2g --program --record-edge, less jdk/edge.edn\""
  echo "        :jdk-edge \"$(sha256sum < "$root/jdk/edge.edn" | cut -c1-64)\"}"
  echo " :files {:sources $(wc -l < "$work/sources.txt")"
  for m in $modules; do echo "         :$m $(grep -c "^$m " "$work/sources.txt")"; done
  echo "         :forms $(find "$1/forms" -name '*.ae' | wc -l)}}"
}

# the tool world's j2g arguments (on a JVM or the tools' host): javac's forms and the variants
tool_args() { echo --input "$1/forms" --variants "$variants"; }

# record_edge OUT: the edge of javac's world into OUT/edge.edn
record_edge() {
  local o=$1 t0
  t0=$(date +%s)
  . "$root/bin/lib/frozen.bash"
  frozen_jar > "$quiet" || return 1
  mkdir -p "$work/log" "$work/tmp"
  echo "== the edge of javac's world (bin/j2g --program --record-edge, on the frozen JVM)" >&2
  # shellcheck disable=SC2046
  frozen_java tools -Xss64m ${J2G_JVM_OPTS:--Xmx16g} -Djava.io.tmpdir="$work/tmp" --add-modules ALL-SYSTEM -- \
    -m arbace.j2g.main --program $(tool_args "$o") --record-edge "$work/edge-full.edn" --out "$work/j2g-jvm" \
    > "$work/log/edge-record.log" 2>&1 || { tail -20 "$work/log/edge-record.log" >&2; return 1; }
  frozen_java tools -Xss64m -Xmx4g -- -m arbace.j2g.edge subtract "$o/edge.edn" "$work/edge-full.edn" "$root/jdk/edge.edn" \
    >> "$work/log/edge-record.log" 2>&1 || { tail -20 "$work/log/edge-record.log" >&2; return 1; }
  echo "   $(grep -c '^  "' "$o/edge.edn") classes beyond jdk/edge.edn's, $(stat -c %s "$o/edge.edn") bytes ($(since "$t0"))" >&2
  # GTS36 (b): the provenance's hash of jdk/edge.edn, which the edge is made less, rewritten with it
  if [ -f "$o/provenance.edn" ]; then
    local h
    h=$(sha256sum < "$root/jdk/edge.edn" | cut -c1-64)
    sed -i "s/\(:jdk-edge \"\)[0-9a-f]*\"/\1$h\"/" "$o/provenance.edn"
    grep -q ":jdk-edge \"$h\"" "$o/provenance.edn" || { echo "javac-vendor edge: $o/provenance.edn has no :jdk-edge to rewrite" >&2; return 1; }
    echo "   ${o#$root/}/provenance.edn's :jdk-edge ${h:0:12}, jdk/edge.edn's" >&2
  fi
}

# convert OUT: the whole tree into OUT
convert() {
  local o=$1 t0 m
  t0=$(date +%s)
  mkdir -p "$work/log" "$work/tmp" "$o"
  [ "$(git -C "$jdk" rev-parse HEAD 2>"$quiet")" = "$pinned" ] || fail "$jdk is not jdk26u at $pinned"
  # the tool that converts, named by its key while the checkout is still the one it was built
  # from (JFS57 (b)): the conversion rewrites jdk/javac, which is in the key, so that asked after
  # writing a changed tree the tool no longer looked fresh and the provenance's host was empty
  local host
  host=$(. "$root/bin/lib/repr-java/host.bash" && repr_java_host) || fail "the tool is not fresh (bin/javac-vendor build)"
  echo "== generate (jdk.compiler's generated sources, the JDK build's langtools tools on javac's tool executable)" >&2
  generate || fail "jdk.compiler's generated sources differ from the build tree's ($work/generated.edn)"
  echo "== sources (jdk26u at $pinned, $jdk)" >&2
  sources || fail "the sources were not copied"
  echo "   $(wc -l < "$work/sources.txt") files: $(for m in $modules; do printf '%s %s, ' "$m" "$(grep -c "^$m " "$work/sources.txt")"; done)" >&2
  echo "== repr/java read-jdk (on javac's tool executable)" >&2
  rm -rf "$work/conv"
  for m in $modules; do convert_module "$m" "$work/conv" || return 1; done
  rm -rf "$o/forms"
  mkdir -p "$o/forms"
  for m in $modules; do
    (cd "$work/conv/$m" && find . -type f -name '*.ae' | while read -r f; do
       [ -e "$o/forms/$f" ] && { echo "javac-vendor: $f from two modules" >&2; exit 1; }
       mkdir -p "$o/forms/$(dirname "$f")" && cp "$f" "$o/forms/$f"
     done) || return 1
  done
  cp "$work/sources.txt" "$o/sources.txt"
  record_edge "$o" || return 1
  provenance "$o" "$host" > "$o/provenance.edn" || return 1
  platform_pin "$o" || return 1
  echo "javac-vendor: ${o#$root/}: $(find "$o/forms" -name '*.ae' | wc -l) forms files, $(du -sb "$o/forms" | cut -f1) bytes ($(since "$t0"))" >&2
}

# The platform javac on Arbace compiles against (JFS15 (b), JFS23 (b)): the JDK build tree's
# exploded modules ($JDK/build/*/jdk/modules), since JN6 every one of them (JFS37: the 68 modules of
# the JDK image the JVM's javac sees, so that bin/repr-java check --jdk reads any module of jdk26u
# on javac on Arbace; until JN6 the ten the corpora and javac's own sources name: java.base,
# java.compiler, java.datatransfer, java.desktop, java.logging, java.prefs, java.xml, jdk.compiler,
# jdk.internal.opt, jdk.zipfs), each with its module descriptor as the build's jmod holds it
# (images/jmods/MODULE.jmod's classes/module-info.class, which is the image's: it carries the
# module's version, which javac writes into a module's requires; the exploded descriptor has
# none), assembled into WORK/platform (a tree of links, the descriptor copied) and pinned by
# jdk/javac/platform.sha256 (one line per module: the SHA-256 of its files' sha256sum listing,
# sorted, without the build's _the.* marks)
platform_modules() {
  local c
  c=$(conf); [ -n "$c" ] || fail "no JDK build tree in $jdk/build (its jdk/modules, images/jmods)"
  (cd "$(dirname "$c")/jdk/modules" && ls | LC_ALL=C sort)
}
module_hash() { (cd "$1" && find -L . -type f ! -name '_the.*' | LC_ALL=C sort | xargs -d '\n' sha256sum | sha256sum | cut -c1-64); }
# platform_make DIR: DIR/MODULE for each module
platform_make() {
  local d=$1 c b m
  c=$(conf); [ -n "$c" ] || fail "no JDK build tree in $jdk/build (its jdk/modules, images/jmods)"
  b=$(dirname "$c")
  rm -rf "$d"; mkdir -p "$d"
  for m in $(platform_modules); do
    [ -f "$b/jdk/modules/$m/module-info.class" ] && [ -f "$b/images/jmods/$m.jmod" ] || fail "no module $m in $b/jdk/modules, images/jmods"
    cp -rs "$b/jdk/modules/$m" "$d/$m" || return 1
    rm -f "$d/$m/module-info.class"
    # a jmod is a zip after its 4-byte header (unzip warns of it)
    unzip -p "$b/images/jmods/$m.jmod" classes/module-info.class > "$d/$m/module-info.class" 2> "$d/.unzip.log"
    [ "$(head -c 4 "$d/$m/module-info.class" | od -An -tx1 | tr -d ' ')" = cafebabe ] || fail "no module descriptor in $b/images/jmods/$m.jmod"
  done
}
# platform DIR: the platform made, each module checked against the pin
platform() {
  local d=$1 m h want st=0 c
  if [ "$(platform_kind)" = own ]; then
    # the own platform (JOP2 (a), JOP3 (a)): a tree of links to the cache of the pin, ARBACE_GATE_EXES/platform-PIN20 (built
    # on a miss), each module checked against the pin as the build tree's are
    c=$(own_cache) || return 1
    rm -rf "$d"; mkdir -p "$d"
    for m in $(pin_modules); do cp -rs "$c/modules/$m" "$d/$m" || return 1; done
    for m in $(pin_modules); do
      h=$(module_hash "$d/$m"); want=$(pin_line "$out/platform.sha256" "$m")
      [ "$h" = "$want" ] || { echo "javac-vendor: the own platform's $m: $h, pinned ${want:-none} ($out/platform.sha256)" >&2; st=1; }
    done
    return $st
  fi
  platform_make "$d" || return 1
  for m in $(platform_modules); do
    h=$(module_hash "$d/$m")
    want=$(sed -n "s/^\([0-9a-f]\{64\}\)  $m\$/\1/p" "$out/platform.sha256" 2>"$quiet")
    if [ "$h" != "$want" ]; then echo "javac-vendor: the platform's $m: $h, pinned ${want:-none} ($out/platform.sha256)" >&2; st=1; fi
  done
  return $st
}
# platform_pin OUT: OUT/platform.sha256
platform_pin() {
  local o=$1 m
  # the own platform's pin is written by platform-own --pin alone (JOP4 (a)); convert and verify keep it
  if [ "$(platform_kind)" = own ]; then [ "$o/platform.sha256" -ef "$out/platform.sha256" ] || cp "$out/platform.sha256" "$o/platform.sha256"; return; fi
  platform_make "$work/platform" || return 1
  {
    echo "# The platform of javac on Arbace (bin/javac-vendor classes; doc/classes/JAVA-FRONTEND-SURVEY.md,"
    echo "# JFS15 (b), JFS23 (b), \"As built: JN3\"): jdk26u's build tree at $pinned,"
    echo "# build/$(basename "$(dirname "$(conf)")")/jdk/modules with each module's module-info.class from images/jmods;"
    echo "# per module the SHA-256 of its files' sha256sum listing (sorted, without _the.*)"
    for m in $(platform_modules); do echo "$(module_hash "$work/platform/$m")  $m"; done
  } > "$o/platform.sha256"
}

# javac's options for the corpora, as bin/lib/repr-java/roundtrip's compile gives them
classes_opts=(-Xmaxerrs 100000 -g:none -nowarn -XDsuppressNotes -proc:none -implicit:none)
jdk_opts=(-XDstringConcat=inline --enable-preview -source 26)

# compile_both NAME SRC [OPTION...]: every .java under SRC (sorted, relative to SRC, as the round
# trip lists them) compiled by the JVM's javac into WORK/classes/NAME/jvm and by javac on Arbace
# into WORK/classes/NAME/arbace, then compared byte for byte
compile_both() {
  local name=$1 src=$2 w=$work/classes/$1 t0 t1 n1 n2 st=0
  shift 2
  rm -rf "$w"; mkdir -p "$w/jvm" "$w/arbace"
  (cd "$src" && find . -name '*.java' | sed 's|^\./||' | LC_ALL=C sort) > "$w/files.list"
  t0=$(date +%s%N)
  (cd "$src" && javac -J-Xmx4g "${classes_opts[@]}" -d "$w/jvm" "$@" "@$w/files.list") > "$w/jvm.log" 2>&1 || st=1
  t1=$(date +%s%N); echo $(( (t1 - t0) / 1000000 )) > "$w/jvm.ms"
  (cd "$src" && TMPDIR=$work/tmp "$javac_exe" "$work/javac.ae" --platform "$work/platform" "${classes_opts[@]}" -d "$w/arbace" "$@" "@$w/files.list") > "$w/arbace.log" 2>&1 || st=$((st + 2))
  t0=$(date +%s%N); echo $(( (t0 - t1) / 1000000 )) > "$w/arbace.ms"
  n1=$(find "$w/jvm" -name '*.class' | wc -l); n2=$(find "$w/arbace" -name '*.class' | wc -l)
  [ $((st & 1)) = 0 ] || echo "   $name: the JVM's javac failed ($w/jvm.log)"
  [ $((st & 2)) = 0 ] || echo "   $name: javac on Arbace failed ($w/arbace.log: $(grep -c 'error:' "$w/arbace.log") errors)"
  if diff -r "$w/jvm" "$w/arbace" > "$w/classes.diff" && cmp -s "$w/jvm.log" "$w/arbace.log" && [ $st = 0 ]; then
    echo "   $name: $(wc -l < "$w/files.list") files, $n1 classes: equal byte for byte (the JVM's javac $(cat "$w/jvm.ms") ms, javac on Arbace $(cat "$w/arbace.ms") ms)"
  else
    echo "   $name: $(wc -l < "$w/files.list") files, $n1 classes by the JVM's javac, $n2 on Arbace: DIFFER ($w/classes.diff: $(grep -c '^Files\|^Only\|^Binary' "$w/classes.diff") files; logs equal: $(cmp -s "$w/jvm.log" "$w/arbace.log" && echo yes || echo no))"
    return 1
  fi
}

# base_corpus: java.base by javac on Arbace and by the JVM's javac, as the JDK build compiles it,
# against the build's classes
base_corpus() {
  local c b w=$work/classes/java.base t0 t1 st=0 n
  c=$(conf); b=$(dirname "$c")
  rm -rf "$w"; mkdir -p "$w/jvm" "$w/arbace" "$w/build"
  grep -v '^$' "$b/jdk/modules/java.base/_the.java.base_batch.filelist" > "$w/files.list"
  local opts=(-g -source 26 -target 26 -implicit:none -Xprefer:source -XDignore.symbol.file=true -XDstringConcat=inline
              --module-source-path "$b/support/gensrc/*:$jdk/src/*/linux/classes:$jdk/src/*/unix/classes:$jdk/src/*/share/classes"
              --module-path "" --system none -encoding utf-8)
  t0=$(date +%s%N)
  (cd "$w" && javac -J-Xmx4g "${opts[@]}" -d "$w/jvm" "@$w/files.list") > "$w/jvm.log" 2>&1 || st=1
  t1=$(date +%s%N); echo $(( (t1 - t0) / 1000000 )) > "$w/jvm.ms"
  (cd "$w" && TMPDIR=$work/tmp "$javac_exe" "$work/javac.ae" "${opts[@]}" -d "$w/arbace" "@$w/files.list") > "$w/arbace.log" 2>&1 || st=$((st + 2))
  t0=$(date +%s%N); echo $(( (t0 - t1) / 1000000 )) > "$w/arbace.ms"
  # the build's class files of java.base, but its module-info.class, which the build rewrites
  # after javac (make/ExplodedImageOptimize.gmk: build.tools.jigsaw.AddPackagesAttribute adds a
  # ModulePackages attribute): javac's own is compared with the JVM's javac's only
  (cd "$b/jdk/modules" && find java.base -name '*.class' ! -path java.base/module-info.class | while read -r f; do mkdir -p "$w/build/$(dirname "$f")"; ln -s "$b/jdk/modules/$f" "$w/build/$f"; done)
  [ $((st & 1)) = 0 ] || echo "   java.base: the JVM's javac failed ($w/jvm.log)"
  [ $((st & 2)) = 0 ] || echo "   java.base: javac on Arbace failed ($w/arbace.log: $(grep -c 'error:' "$w/arbace.log") errors)"
  n=$(find -L "$w/build" -name '*.class' | wc -l)
  diff -r "$w/jvm" "$w/arbace" > "$w/classes.diff"; local d1=$?
  diff -r -x module-info.class "$w/build" "$w/arbace" > "$w/build.diff"; local d2=$?
  echo "   java.base: $(wc -l < "$w/files.list") files, $n classes in the build, $(find "$w/arbace" -name '*.class' | wc -l) by javac on Arbace, $(find "$w/jvm" -name '*.class' | wc -l) by the JVM's (the JVM's javac $(cat "$w/jvm.ms") ms, javac on Arbace $(cat "$w/arbace.ms") ms)"
  echo "   java.base: javac on Arbace against the JVM's: $([ $d1 = 0 ] && echo 'equal byte for byte' || echo "DIFFER ($w/classes.diff: $(grep -c '^Files\|^Only\|^Binary' "$w/classes.diff") files)")"
  echo "   java.base: javac on Arbace against the build's classes (but module-info.class): $([ $d2 = 0 ] && echo 'equal byte for byte' || echo "DIFFER ($w/build.diff: $(grep -c '^Files\|^Only\|^Binary' "$w/build.diff") files)")"
  [ $st = 0 ] && [ $d1 = 0 ] && [ $d2 = 0 ]
}

# module_opts B MODULE: the javac options the build compiled MODULE with (opts), from its batch's command line
# (jdk/modules/MODULE/_the.MODULE_batch.cmdline, the build tree's own file, split as the shell that ran it
# split it), the javacserver's arguments less the diagnostics' (-Xlint, -Xdoclint, -Werror), the dependency
# plugin's and the server's -XD options, -cp, -d, -h and the file list: 63 modules take java.base's but
# -XDstringConcat=inline, four with it, jdk.internal.vm.ci -source 25 and -parameters. Since JCS362 (a) read
# only by platform-build (the derivation of OUT/platform-build.edn and its re-check, the oracle tier's)
module_opts() {
  local f=$1/jdk/modules/$2/_the.$2_batch.cmdline
  opts=()
  [ -f "$f" ] || return 1
  eval "set -- $(cat "$f")"
  while [ $# -gt 0 ] && [ "$1" != javacserver.Main ]; do shift; done
  shift 2
  while [ $# -gt 0 ]; do
    case $1 in
      -Xlint*|-Xdoclint*|-Werror|-XDinternalAPIPath=*|-XDLOG_LEVEL=*|-XDmodifiedInputs=*|'-Xplugin:depend '*|@*) shift ;;
      -cp|-d|-h) shift 2 ;;
      *) opts+=("$1"); shift ;;
    esac
  done
}

# The build's configuration as data (JCS362 (a), doc/classes/JAVA-CONFORMANCE-SURVEY.md, "As built: JCS359 stage 1
# tooling"): OUT/platform-build.edn, derived once from the JDK build tree (platform-build) with each value's origin, and
# re-checked against the build only by the oracle tier (platform-build --check); classes modules reads it in place of the
# build tree's command lines and file lists. Its layout is line-oriented so that the shell reads it (pb_get), and every
# line is the Clojure reader's: a module's name alone on its line, then its fields, each vector on one line. Paths are
# written with placeholders: {gensrc} the build tree's support/gensrc (stage 2 makes it), {src} jdk26u's src, {build}
# the build tree, {jdk} jdk26u's checkout. A module's sources: its roots in the build's order (gensrc, linux, unix,
# share: {gensrc}/MODULE, {src}/MODULE/OS/classes), each root's *.java sorted (C), less :exclude (ROOT/PATH: javadoc's
# snippet-files, a root's file shadowed by an earlier root's, the make files' excludes), checked by :files and
# :files-sha256 (the list with placeholders, a line a file)
pbuild=$out/platform-build.edn
pb_roots="gensrc linux unix share"
pb_str() { local s=$1; s=${s//\\/\\\\}; s=${s//\"/\\\"}; printf '"%s"' "$s"; }
pb_vec() { local a sep=; printf '['; for a in "$@"; do printf '%s' "$sep"; pb_str "$a"; sep=' '; done; printf ']'; }
# pb_abs B PATH...: each path with its placeholders, a line each
pb_abs() {
  local b=$1 s; shift
  for s in "$@"; do
    s=${s//"$b/support/gensrc"/"{gensrc}"}; s=${s//"$b"/"{build}"}; s=${s//"$jdk/src"/"{src}"}; s=${s//"$jdk"/"{jdk}"}
    printf '%s\n' "$s"
  done
}
# pb_concrete B: stdin's placeholders replaced (the gensrc root GENSRC, default B/support/gensrc)
pb_concrete() { local g=${PB_GENSRC:-$1/support/gensrc}; sed -e "s|{gensrc}|$g|g" -e "s|{src}|$jdk/src|g" -e "s|{build}|$1|g" -e "s|{jdk}|$jdk|g"; }
# pb_root_dir ROOT MODULE: the root's directory, with placeholders
pb_root_dir() { case $1 in gensrc) echo "{gensrc}/$2" ;; *) echo "{src}/$2/$1/classes" ;; esac; }
# pb_get MODULE FIELD [FILE]: the strings of MODULE's vector FIELD, a line each
pb_get() {
  awk -v mod="$1" -v field=":$2 [" '
    /^  "[^"]*"$/ { cur = substr($0, 4, length($0) - 4); next }
    cur == mod && (i = index($0, field)) {
      s = substr($0, i + length(field)); ins = 0; buf = ""
      for (j = 1; j <= length(s); j++) {
        c = substr(s, j, 1)
        if (ins) {
          if (c == "\\") { j++; buf = buf substr(s, j, 1) }
          else if (c == "\"") { print buf; ins = 0; buf = "" }
          else buf = buf c
        } else if (c == "\"") ins = 1
        else if (c == "]") exit
      }
      exit
    }' "${3:-$pbuild}"
}
# pb_scalar MODULE FIELD [FILE]: MODULE's scalar FIELD (a number or a string, unquoted)
pb_scalar() {
  awk -v mod="$1" -v field=":$2 " '
    /^  "[^"]*"$/ { cur = substr($0, 4, length($0) - 4); next }
    cur == mod && (i = index($0, field)) { s = substr($0, i + length(field)); sub(/[ }].*/, "", s); gsub(/"/, "", s); print s; exit }' "${3:-$pbuild}"
}
pb_modules() { sed -n 's/^  "\([^"]*\)"$/\1/p' "${1:-$pbuild}"; }
# pb_has_module MODULE [FILE]: the data has the module. Not a pipe into grep -q: under pipefail, grep's early exit
# killed sed by SIGPIPE when the module was among the file's first (java.base, refused as "no module", 2026-11-17)
pb_has_module() { pb_modules "${2:-$pbuild}" > "$TMPDIR/javac-vendor.pbm" && grep -qx -- "$1" "$TMPDIR/javac-vendor.pbm"; }
# pb_files_rel MODULE [FILE]: the module's sources with placeholders, in the build's order
pb_files_rel() {
  local m=$1 f=${2:-$pbuild} r d dd ex
  ex=$TMPDIR/javac-vendor.pb-exclude.$$.$BASHPID
  pb_get "$m" exclude "$f" > "$ex"
  for r in $pb_roots; do
    d=$(pb_root_dir "$r" "$m"); dd=$(echo "$d" | pb_concrete "$PB_B")
    [ -d "$dd" ] || continue
    (cd "$dd" && find . -name '*.java' | sed 's|^\./||' | LC_ALL=C sort) |
      awk -v r="$r" -v d="$d" 'FILENAME == ARGV[1] { x[$0] = 1; next } !((r "/" $0) in x) { print d "/" $0 }' "$ex" -
  done
  rm -f "$ex"
}
# platform_build_make FILE: the derivation (the build tree's command lines, file lists and spec.gmk)
platform_build_make() {
  local o=$1 c b m r d dd f rel cpp jm st=0 a
  c=$(conf); [ -n "$c" ] || fail "no JDK build tree in $jdk/build"
  b=$(dirname "$c"); local bb=build/$(basename "$b")
  PB_B=$b
  {
    echo ";; The JDK build's configuration as data (JCS362 (a), doc/classes/JAVA-CONFORMANCE-SURVEY.md, \"As built: JCS359"
    echo ";; stage 1 tooling\"): derived by bin/javac-vendor platform-build from jdk26u's build tree at $pinned,"
    echo ";; re-checked against it by platform-build --check (the oracle tier's) and never read from it otherwise: each module's"
    echo ";; javac options and sources (classes modules), the version strings, the C preprocessor's flags and the jmod flags"
    echo ";; (stages 2 and 3). Generated; do not edit by hand. Its layout is the shell's too (bin/javac-vendor's pb_get)."
    echo "{:jdk $(pb_str "$pinned")"
    echo " :build $(pb_str "$bb")"
    echo " :placeholders {\"{gensrc}\" \"$bb/support/gensrc\" \"{src}\" \"src\" \"{build}\" \"$bb\" \"{jdk}\" \"jdk26u's checkout\"}"
    echo " :origins"
    echo " {:options \"$bb/jdk/modules/MODULE/_the.MODULE_batch.cmdline, javacserver.Main's arguments less -Xlint*, -Xdoclint*, -Werror, -XDinternalAPIPath, -XDLOG_LEVEL, -XDmodifiedInputs, -Xplugin:depend, -cp, -d, -h and the @file list\""
    echo "  :files \"$bb/jdk/modules/MODULE/_the.MODULE_batch.filelist: the roots' sources less :exclude\""
    echo "  :version \"$bb/spec.gmk's VERSION_* := VALUE\""
    echo "  :cpp \"$bb/support/gensrc/java.base/_UnixConstants.java.cmdline and _SocketOptionRegistry.java.cmdline: gcc -E's flags (spec.gmk's CFLAGS_JDKLIB)\""
    echo "  :jmod \"$bb/support/images/jmods/_create_MODULE.jmod_exec.cmdline: jmod create's arguments less -J* and the jmod file (make/CreateJmods.gmk)\"}"
    echo " :roots $(pb_vec $pb_roots)"
    echo " :version"
    printf ' {'
    sed -n 's/^\(VERSION_[A-Z0-9_]*\) := \(.*\)$/\1\t\2/p' "$c" | { a=; while IFS=$'\t' read -r k v; do printf '%s%s %s\n' "$a" "$(pb_str "$k")" "$(pb_str "$v")"; a='  '; done; }
    echo '  }'
    cpp=
    for f in UnixConstants SocketOptionRegistry; do
      a=$(sed -n 's|.* -E -x c \(.*\) /[^ ]*\.java\.template 2> .*|\1|p' "$b/support/gensrc/java.base/_$f.java.cmdline")
      [ -n "$a" ] || { echo "javac-vendor: no gcc -E flags in $b/support/gensrc/java.base/_$f.java.cmdline" >&2; return 1; }
      [ -z "$cpp" ] || [ "$cpp" = "$a" ] || { echo "javac-vendor: the two gcc -E command lines differ in their flags" >&2; return 1; }
      cpp=$a
    done
    set -f; eval "set -- $cpp"; set +f
    pb_abs "$b" "$@" > "$TMPDIR/javac-vendor.pb-c"; mapfile -t pc < "$TMPDIR/javac-vendor.pb-c"
    echo " :cpp $(pb_vec "${pc[@]}")"
    echo " :modules {"
    for m in $(platform_modules); do
      module_opts "$b" "$m" || { echo "javac-vendor: no $b/jdk/modules/$m/_the.${m}_batch.cmdline" >&2; return 1; }
      f=$b/jdk/modules/$m/_the.${m}_batch.filelist
      [ -f "$f" ] || { echo "javac-vendor: no $f" >&2; return 1; }
      # the excluded: under the roots, not in the list
      grep -v '^$' "$f" | LC_ALL=C sort > "$TMPDIR/javac-vendor.pb-list"
      : > "$TMPDIR/javac-vendor.pb-ex"
      for r in $pb_roots; do
        d=$(pb_root_dir "$r" "$m"); dd=$(echo "$d" | pb_concrete "$b")
        [ -d "$dd" ] || continue
        (cd "$dd" && find . -name '*.java' | sed 's|^\./||' | LC_ALL=C sort) | while IFS= read -r rel; do printf '%s\t%s\n' "$dd/$rel" "$r/$rel"; done
      done | LC_ALL=C sort -t $'\t' -k1,1 | awk -F'\t' 'FILENAME == ARGV[1] { x[$0] = 1; next } !($1 in x) { print $2 }' "$TMPDIR/javac-vendor.pb-list" - |
        LC_ALL=C sort > "$TMPDIR/javac-vendor.pb-ex"
      mapfile -t ex < "$TMPDIR/javac-vendor.pb-ex"
      mapfile -t fl < "$f"
      local n=0; for rel in "${fl[@]}"; do [ -n "$rel" ] && n=$((n + 1)); done
      jm=$b/support/images/jmods/_create_$m.jmod_exec.cmdline
      [ -f "$jm" ] || { echo "javac-vendor: no $jm" >&2; return 1; }
      set -f; eval "set -- $(sed 's|^.*/jdk/bin/jmod ||' "$jm")"; set +f
      local jargs=()
      while [ $# -gt 1 ]; do case $1 in -J*|create) ;; *) jargs+=("$1") ;; esac; shift; done
      echo "  \"$m\""
      pb_abs "$b" "${opts[@]}" > "$TMPDIR/javac-vendor.pb-o"; mapfile -t po < "$TMPDIR/javac-vendor.pb-o"
      pb_abs "$b" "${jargs[@]}" > "$TMPDIR/javac-vendor.pb-j"; mapfile -t pj < "$TMPDIR/javac-vendor.pb-j"
      echo "  {:options $(pb_vec "${po[@]}")"
      echo "   :exclude $(pb_vec "${ex[@]}")"
      echo "   :files $n"
      echo "   :files-sha256 \"$(grep -v '^$' "$f" | while IFS= read -r rel; do pb_abs "$b" "$rel"; done | sha256sum | cut -c1-64)\""
      echo "   :jmod $(pb_vec "${pj[@]}")}"
    done
    echo ' }}'
  } > "$o.tmp" || { rm -f "$o.tmp"; return 1; }
  # the sources as the data gives them must be the build's list, file for file and in its order
  for m in $(pb_modules "$o.tmp"); do
    pb_files_rel "$m" "$o.tmp" > "$TMPDIR/javac-vendor.pb-a"
    grep -v '^$' "$b/jdk/modules/$m/_the.${m}_batch.filelist" | while IFS= read -r rel; do pb_abs "$b" "$rel"; done > "$TMPDIR/javac-vendor.pb-b"
    cmp -s "$TMPDIR/javac-vendor.pb-a" "$TMPDIR/javac-vendor.pb-b" || { echo "javac-vendor: $m's sources from the data are not the build's list" >&2; st=1; }
  done
  [ $st = 0 ] || { mv "$o.tmp" "$TMPDIR/platform-build.failed.edn"; return 1; }
  mv "$o.tmp" "$o"
}

# The known differences (JCS360 (a)): OUT/platform-own-known.edn, each class whose own class file (javac on Arbace's, from
# source) differs from the build's, with both digests and its reason; a line an entry, the Clojure reader's. A module
# whose every differing class is listed with both its digests is `known`; a differing class not listed (or listed with
# other digests) makes it `differ`; a listed class that does not differ makes it `stale`. Both fail. JAVAC_VENDOR_KNOWN
# names another file
pknown=${JAVAC_VENDOR_KNOWN:-$out/platform-own-known.edn}
# the generated sources (JCS359 (a)(2)): platform-gensrc, gensrc
. "$root/test/javac-platform/gensrc.bash"
# the own platform (JOP1-JOP8 (a)): the pin's kind, own_build, own_cache
. "$root/test/javac-platform/own.bash"
# known_tsv FILE: MODULE CLASS BUILD OWN WHY, a line an entry
known_tsv() {
  [ -f "$1" ] || return 0
  sed -n 's/^.*{:module "\([^"]*\)" :class "\([^"]*\)" :build "\([^"]*\)" :own "\([^"]*\)" :why :\([^ }]*\)}.*$/\1\t\2\t\3\t\4\t\5/p' "$1"
}
# module_sums DIR: CLASS<TAB>SHA-256 of every class file under DIR but module-info.class, sorted
module_sums() {
  (cd "$1" && find -L . -name '*.class' ! -path ./module-info.class | sed 's|^\./||' | LC_ALL=C sort |
     xargs -d '\n' -r sha256sum | awk '{h = $1; sub(/^[0-9a-f]+  /, ""); print $0 "\t" h}')
}
# module_diffs BUILD-SUMS OWN-SUMS: CLASS<TAB>BUILD<TAB>OWN for each class that differs ("-" for none), sorted
module_diffs() {
  awk -F'\t' 'FILENAME == ARGV[1] { b[$1] = $2; next } { o[$1] = $2 }
    END { for (k in b) if (!(k in o)) print k "\t" b[k] "\t-"; else if (b[k] != o[k]) print k "\t" b[k] "\t" o[k]
          for (k in o) if (!(k in b)) print k "\t-\t" o[k] }' "$1" "$2" | LC_ALL=C sort
}
# module_judge MODULE DIFFS KNOWN-TSV: prints KNOWN UNEXPLAINED STALE, then the lines that explain them (unexplained CLASS
# BUILD OWN, stale CLASS)
module_judge() {
  awk -F'\t' -v m="$1" '
    FILENAME == ARGV[1] { if ($1 == m) { kb[$2] = $3; ko[$2] = $4 } ; next }
    { if (($1 in kb) && kb[$1] == $2 && ko[$1] == $3) { k++; used[$1] = 1 } else { u++; out = out "unexplained\t" $1 "\t" $2 "\t" $3 "\n" } }
    END { for (c in kb) if (!(c in used)) { s++; out = out "stale\t" c "\n" }
          printf "%d %d %d\n%s", k, u, s, out }' "$3" "$2"
}
# module_result K U S: equal, known, differ or stale
module_result() { if [ "$2" -gt 0 ]; then echo differ; elif [ "$3" -gt 0 ]; then echo stale; elif [ "$1" -gt 0 ]; then echo known; else echo equal; fi; }

# module_run MODULE: one module by javac on Arbace as the build compiles it (the data's options and sources), judged
# against the build's class files and the known file; WORK/classes/modules/MODULE/{out.txt,summary.line}
module_run() {
  local m=$1 w=$work/classes/modules/$1 r n1 n2 t0 t1 ms kb j k u s o=() fl
  rm -rf "$w"; mkdir -p "$w/arbace"
  pb_get "$m" options > "$w/options.raw"
  pb_concrete "$PB_B" < "$w/options.raw" > "$w/options.txt"
  mapfile -t o < "$w/options.txt"
  pb_files_rel "$m" | pb_concrete "$PB_B" > "$w/files.list"
  fl=$(wc -l < "$w/files.list")
  if [ "$fl" != "$(pb_scalar "$m" files)" ] ||
     [ "$(pb_files_rel "$m" | sha256sum | cut -c1-64)" != "$(pb_scalar "$m" files-sha256)" ]; then
    echo "   $m: the sources are not the data's ($fl files, :files $(pb_scalar "$m" files); jdk26u's checkout moved?)" > "$w/out.txt"
    printf '%s\t%s\t-\t-\tsources\t-\t-\t-\t-\t-\n' "$m" "$fl" > "$w/summary.line"
    return 1
  fi
  t0=$(date +%s%N)
  r=ok
  (cd "$w" && TMPDIR=$work/tmp busybox time -v "$javac_exe" "$work/javac.ae" "${o[@]}" -d "$w/arbace" "@$w/files.list") > "$w/arbace.log" 2> "$w/arbace.err" || r=failed
  t1=$(date +%s%N); ms=$(( (t1 - t0) / 1000000 ))
  kb=$(sed -n 's/.*Maximum resident set size (kbytes): *//p' "$w/arbace.err" | tail -1)
  module_sums "$PB_B/jdk/modules/$m" > "$w/build.sums"
  : > "$w/own.sums"; [ ! -d "$w/arbace/$m" ] || module_sums "$w/arbace/$m" > "$w/own.sums"
  n1=$(wc -l < "$w/build.sums"); n2=$(wc -l < "$w/own.sums")
  k=0 u=0 s=0
  if [ $r = ok ]; then
    module_diffs "$w/build.sums" "$w/own.sums" > "$w/diffs.tsv"
    module_judge "$m" "$w/diffs.tsv" "$work/classes/modules/known.tsv" > "$w/judgment.txt"
    read -r k u s < "$w/judgment.txt"
    r=$(module_result "$k" "$u" "$s")
  fi
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$m" "$fl" "$n1" "$n2" "$r" "$ms" "${kb:--}" "$k" "$u" "$s" > "$w/summary.line"
  {
    echo "   $m: $fl files, $n1 classes in the build (but module-info), $n2 by javac on Arbace: $r ($ms ms, peak ${kb:-?} kB$([ "$k" = 0 ] || echo ", $k known"))"
    [ $r != failed ] || echo "      javac on Arbace failed ($w/arbace.log: $(grep -c 'error:' "$w/arbace.log") errors)"
    [ ! -f "$w/judgment.txt" ] || tail -n +2 "$w/judgment.txt" | sed 's/^/      /; s/\t/ /g'
  } > "$w/out.txt"
  # the own descriptor and the packages of the own class files, stage 3's input (JCS359 (a)(3), descriptors)
  if [ -f "$w/arbace/$m/module-info.class" ]; then
    cp "$w/arbace/$m/module-info.class" "$w/module-info.class"
    (cd "$w/arbace/$m" && find . -name '*.class' ! -path ./module-info.class | sed 's|^\./||; s|/[^/]*$||' | LC_ALL=C sort -u | tr / .) > "$w/packages.txt"
  fi
  # the own class files are kept only for the evidence (a module neither equal nor known)
  case $r in equal|known) rm -rf "$w/arbace" ;; esac
  case $r in equal|known) return 0 ;; *) return 1 ;; esac
}

# control2_pick DIR: "MODULE CLASS", control 2's subject: the first module of DIR/summary.tsv equal or known that has a class
# that does not differ (DIR/MODULE/build.sums less DIR/MODULE/diffs.tsv); a module without one (a descriptor shell: java.se,
# no class) is passed over, not the end of the search (the 19-module run of 2026-11-17 took none though 12 were equal)
control2_pick() {
  local m c
  for m in $(awk -F'\t' '$5 == "equal" || $5 == "known" {print $1}' "$1/summary.tsv"); do
    [ -f "$1/$m/build.sums" ] && [ -f "$1/$m/diffs.tsv" ] || continue
    c=$(awk -F'\t' 'FILENAME == ARGV[1] { d[$1] = 1; next } !($1 in d) {print $1; exit}' "$1/$m/diffs.tsv" "$1/$m/build.sums")
    [ -z "$c" ] || { echo "$m $c"; return 0; }
  done
  echo
}
# modules_controls: the judgment's negative controls (GTS81 (a)), judged again on this run's own results with the known
# file changed: (1) a known entry taken away, its module must differ; (2) an entry added for an equal class of a module
# that ran, its module must be stale. A control that passes fails the run
modules_controls() {
  local d=$work/classes/modules m c st=0 k u s line
  line=$(awk -F'\t' '$5 == "known" {print $1; exit}' "$d/summary.tsv")
  if [ -n "$line" ]; then
    m=$line
    c=$(awk -F'\t' -v m="$m" '$1 == m {print $2; exit}' "$d/known.tsv")
    awk -F'\t' -v m="$m" -v c="$c" '!($1 == m && $2 == c)' "$d/known.tsv" > "$d/control-1.tsv"
    module_judge "$m" "$d/$m/diffs.tsv" "$d/control-1.tsv" > "$d/control-1.txt"; read -r k u s < "$d/control-1.txt"
    if [ "$(module_result "$k" "$u" "$s")" = differ ]; then echo "   control 1 ($m without its known $c): differ, as it must"
    else echo "   control 1 ($m without its known $c): $(module_result "$k" "$u" "$s"): PASSES, it must fail"; st=1; fi
  else echo "   control 1: no known module in this run (none taken)"; fi
  read -r m c < <(control2_pick "$d")
  if [ -n "$c" ]; then
    { cat "$d/known.tsv"; printf '%s\t%s\t%s\t%s\tcontrol\n' "$m" "$c" "$(awk -F'\t' -v c="$c" '$1 == c {print $2}' "$d/$m/build.sums")" "$(awk -F'\t' -v c="$c" '$1 == c {print $2}' "$d/$m/build.sums")"; } > "$d/control-2.tsv"
    module_judge "$m" "$d/$m/diffs.tsv" "$d/control-2.tsv" > "$d/control-2.txt"; read -r k u s < "$d/control-2.txt"
    if [ "$(module_result "$k" "$u" "$s")" = stale ]; then echo "   control 2 ($m with a known entry for its equal $c): stale, as it must"
    else echo "   control 2 ($m with a known entry for its equal $c): $(module_result "$k" "$u" "$s"): PASSES, it must fail"; st=1; fi
  else echo "   control 2: no equal class in this run (none taken)"; fi
  return $st
}

# modules_corpus: every module of the platform (JAVAC_VENDOR_MODULES: some, by name) compiled by javac on Arbace as the JDK
# build compiles it, its options and sources from OUT/platform-build.edn (JCS362 (a); the build tree's generated sources
# still, {gensrc}, until stage 2), from jdk26u's sources alone (--module-source-path, --system none: no class file read),
# each against the build's class files byte for byte but its module-info.class (rewritten after javac, base_corpus),
# every difference judged against OUT/platform-own-known.edn (JCS360 (a)); no JVM: the build's classes are the JDK's
# javac's. JCS359's stage 1 (doc/classes/JAVA-CONFORMANCE-SURVEY.md, "As built: JCS359 stage 1 tooling"). --jobs N (jobs)
# modules at once, but a module of more than JAVAC_VENDOR_ALONE files (default 1000: java.base, java.desktop, java.xml,
# jdk.localedata) alone, so that the peak is the larger of one big module's and N small ones'. WORK/classes/modules/MODULE,
# a line a module in WORK/classes/modules/summary.tsv (MODULE FILES BUILD-CLASSES ARBACE-CLASSES RESULT MS PEAK-KB KNOWN
# UNEXPLAINED STALE), then the controls (modules_controls)
modules_corpus() {
  local c m st=0 mods n big=${JAVAC_VENDOR_ALONE:-1000} d=$work/classes/modules
  c=$(conf); [ -n "$c" ] || fail "no JDK build tree in $jdk/build (its class files are the reference)"
  PB_B=$(dirname "$c")
  [ -f "$pbuild" ] || fail "no $pbuild (bin/javac-vendor platform-build)"
  [ "$(sed -n 's/^{:jdk "\([0-9a-f]*\)"$/\1/p' "$pbuild")" = "$pinned" ] || fail "$pbuild is not of jdk26u at $pinned"
  mkdir -p "$d"
  known_tsv "$pknown" > "$d/known.tsv"
  mods=${JAVAC_VENDOR_MODULES:-$(pb_modules)}
  for m in $mods; do pb_has_module "$m" || fail "no module $m in $pbuild"; done
  echo "   ${njobs:-1} at once (a module of more than $big files alone); the build's configuration ${pbuild#$root/}, the known differences ${pknown#$root/} ($(wc -l < "$d/known.tsv") classes)"
  for m in $mods; do
    n=$(pb_scalar "$m" files)
    if [ "$n" -gt "$big" ] || [ "${njobs:-1}" -le 1 ]; then
      wait
      module_run "$m"; cat "$d/$m/out.txt"
    else
      while [ "$(jobs -rp | wc -l)" -ge "$njobs" ]; do wait -n; done
      (module_run "$m"; cat "$d/$m/out.txt") &
    fi
  done
  wait
  : > "$d/summary.tsv"
  for m in $mods; do
    if [ -f "$d/$m/summary.line" ]; then cat "$d/$m/summary.line" >> "$d/summary.tsv"
    else printf '%s\t-\t-\t-\tnot-run\t-\t-\t-\t-\t-\n' "$m" >> "$d/summary.tsv"; fi
  done
  awk -F'\t' '$5 != "equal" && $5 != "known" {bad++} END {exit bad > 0}' "$d/summary.tsv" || st=1
  awk -F'\t' '{n[$5]++; k += $8} END {printf "   modules: %d; ", NR; for (r in n) printf "%s %d ", r, n[r]; printf "(%d known classes)\n", k}' "$d/summary.tsv"
  awk -F'\t' '$7 != "-" && $7 > p {p = $7; m = $1} END {if (p) printf "   peak: %s, %d MB\n", m, p / 1024}' "$d/summary.tsv"
  modules_controls || st=1
  return $st
}

# classes CORPUS...: javac on Arbace against the JVM's javac (JN3)
classes() {
  local c st=0 frozen orig
  # the reference javac: Java 26 (but for the modules corpus alone, which compares with the build's classes)
  if [ "$*" != modules ]; then . "$root/bin/lib/java26.bash"; arbace_use_java26 || return 1; fi
  javac_exe=${JAVAC_EXE:-$root/target/arbace-go/amd64/arbace-javac}
  [ -x "$javac_exe" ] || fail "no $javac_exe (bin/arbace-go --build-java, or JAVAC_EXE)"
  mkdir -p "$work/classes" "$work/tmp"
  printf '(System/exit (jdk.internal.jrt.javac.Main/run (into-array String *command-line-args*)))\n' > "$work/javac.ae"
  # the modules corpus attributes against no platform (--system none): none assembled for it alone
  [ "$*" = modules ] || platform "$work/platform" || return 1
  if [ "$*" = modules ]; then echo "== javac on Arbace ($javac_exe) against the JDK build's class files (JCS359 stage 1)"
  else echo "== javac on Arbace ($javac_exe) against the JVM's ($(javac -version 2>&1)); the platform ${out#$root/}/platform.sha256"; fi
  for c in "$@"; do
    case $c in
      baseline)
        . "$root/bin/lib/tools.bash"
        frozen=$(frozen_clojure) || return 1
        compile_both baseline "$frozen" -sourcepath "$frozen" || st=1 ;;
      samples)
        compile_both samples-java "$root/test/repr/java/java" || st=1
        compile_both samples-module "$root/test/repr/java/module" || st=1 ;;
      jdk)
        orig=${JRT_WORK_RT:-$work/jdk-originals}
        # made again when what they are made from changed, checked (bin/lib/repr-java/originals.bash)
        . "$root/bin/lib/repr-java/originals.bash"
        arbace_jdk_originals "$orig" "$work/classes/jrt.log" "${JRT_WORK_RT:-}" | sed "s|^|   |; s|$root/||g"
        [ "${PIPESTATUS[0]}" = 0 ] || { echo "javac-vendor: the jdk corpus's originals ($work/classes/jrt.log)" >&2; return 1; }
        compile_both jdk "$orig/src/java.base" --patch-module "java.base=$orig/src/java.base" "${jdk_opts[@]}" || st=1 ;;
      java.base)
        # JFS2 (a): java.base compiled as the JDK build compiles it (its batch's file list and
        # options, jdk/modules/java.base/_the.java.base_batch.cmdline: multi-module, no system
        # modules), compared with the build's own class files, jdk/modules/java.base. Left out
        # of the build's options: -h (the native headers), -Xplugin:depend and the -XD options of
        # its javacserver, -Xlint:all, -Xdoclint and -Werror (diagnostics only)
        base_corpus || st=1 ;;
      modules) modules_corpus || st=1 ;;
      *) fail "no corpus $c (baseline, samples, jdk, java.base, modules)" ;;
    esac
  done
  return $st
}

# JAVAC_VENDOR_LIB=1: sourced for its functions (test/gate/javac-platform-test.bash), no command run
if [ -n "${JAVAC_VENDOR_LIB:-}" ]; then return 0 2>"$quiet" || exit 0; fi
case $cmd in
  convert) convert "$out" || exit 1 ;;
  edge) record_edge "$out" || exit 1 ;;
  verify)
    unset JAVAC_VENDOR_BOOTSTRAP
    rm -rf "$work/fresh"
    convert "$work/fresh" || exit 1
    . "$root/bin/lib/repr-java/host.bash"
    # the provenance but its host (the tool that wrote it, JFS32): reported
    if diff -r -x provenance.edn "$out" "$work/fresh" > "$work/verify.diff" &&
       repr_java_provenance_same "$out/provenance.edn" "$work/fresh/provenance.edn"; then
      echo "javac-vendor verify: ${out#$root/} is the conversion and the recording, byte for byte ($(find "$out" -type f | wc -l) files; the provenance's host $(grep -o ':host "[^ ]* [0-9a-f]\{12\}' "$out/provenance.edn" | cut -c8-), this run's $(grep -o ':host "[^ ]* [0-9a-f]\{12\}' "$work/fresh/provenance.edn" | cut -c8-))"
    else
      diff -r "$out" "$work/fresh" > "$work/verify.diff"
      echo "javac-vendor verify: ${out#$root/} differs from a fresh conversion ($work/verify.diff: $(wc -l < "$work/verify.diff") lines)"
      exit 1
    fi ;;
  check)
    if [ "${1:-}" = --from ]; then
      # the verdict of the tool build's own j2g run (GT3, doc/GATE-SURVEY.md, GTS11 (a)): javac's
      # world translated once, by the build of the tool in DIR (bin/javac-vendor tool), whose
      # key must be the checkout's
      d=${2:?check --from DIR}
      . "$root/bin/lib/javac-key.bash"
      k=$(arbace_javac_fresh "javac-vendor check" "$d/arbace-javac") || exit 1
      [ -f "$d/j2g.log" ] && [ -f "$d/report.edn" ] || fail "no j2g report of the tool build in $d (bin/javac-vendor tool $d)"
      echo "== j2g's run of javac's tool build (key ${k:0:12}, $d/j2g.log)"
      grep '^j2g: .*classes analyzed\|^j2g: reachability\|^j2g: error' "$d/j2g.log"
      if grep -q '^j2g: .*classes analyzed.*failures' "$d/j2g.log"; then
        awk '/^ :analysis-failures/,/^ :variants/' "$d/report.edn" | head -40
        fail "classes of javac's world failed their analysis ($d/report.edn)"
      fi
      echo "javac-vendor check: j2g translates javac's world, no failures (the tool build's run)"
      exit 0
    fi
    mkdir -p "$work/check"
    t0=$(date +%s)
    exe=${J2G_GO_EXE:-$root/target/arbace-go/amd64/arbace}
    [ -x "$exe" ] || fail "no $exe (bin/arbace-go --build, or J2G_GO_EXE)"
    echo "== j2g on $exe"
    # shellcheck disable=SC2046
    J2G_GO_EXE=$exe bin/j2g --program $(tool_args "$out") --edge "$root/jdk/edge.edn" --edge "$out/edge.edn" --out "$work/check/j2g" \
      > "$work/check/j2g.log" 2>&1
    st=$?
    grep '^j2g: .*classes analyzed\|^j2g: reachability\|^j2g: error' "$work/check/j2g.log"
    [ $st = 0 ] || { tail -20 "$work/check/j2g.log"; fail "j2g failed ($work/check/j2g.log)"; }
    if grep -q '^j2g: .*classes analyzed.*failures' "$work/check/j2g.log"; then
      awk '/^ :analysis-failures/,/^ :variants/' "$work/check/j2g/report.edn" | head -40
      fail "classes of javac's world failed their analysis ($work/check/j2g/report.edn)"
    fi
    echo "javac-vendor check: j2g translates javac's world, no failures ($(since "$t0"))" ;;
  tool)
    # javac's tool kept by its key (GT3, doc/GATE-SURVEY.md, GTS11 (a)): DIR/arbace-javac when
    # DIR/arbace-javac.key is the checkout's arbace_javac_key, else built (bin/arbace-go
    # --build-java, amd64, j2g on HOST, the compiled namespaces of AOT-BASE when of the checkout's
    # key) and copied into DIR with its j2g run's log and report (check --from DIR reads them)
    d=${1:?tool DIR [--host EXE] [--aot-base DIR]}; shift
    case $d in /*) ;; *) d=$root/$d ;; esac
    host= base= check=
    while [ $# -gt 0 ]; do
      case $1 in
        --check) check=1; shift ;;
        --host) host=$2; shift 2 ;;
        --aot-base) base=$2; shift 2 ;;
        *) fail "tool: unknown option $1" ;;
      esac
    done
    . "$root/bin/lib/javac-key.bash"
    want=$(arbace_javac_key "$root")
    if [ -x "$d/arbace-javac" ] && [ "$(cat "$d/arbace-javac.key" 2>"$quiet")" = "$want" ] && [ -f "$d/j2g.log" ] && [ -f "$d/report.edn" ]; then
      echo "javac-vendor tool: kept, $d/arbace-javac (key ${want:0:12}, the checkout's)"
      # JOP3 (a): with the own pin, the tool's step also makes the platform on a miss (the javac-tool step builds both: the
      # Java steps that need the tool need the platform; 15-20 minutes at --jobs 3, about 6.5 GB, under the step's lock)
      [ "$(platform_kind)" = own ] || exit 0
      if [ -n "$check" ]; then JAVAC_VENDOR_PLATFORM_BUILD=0 own_cache > "$quiet" 2>&1 || { echo "javac-vendor tool: no own platform of the pin yet"; exit 1; }; exit 0; fi
      own_jobs=${JAVAC_VENDOR_PLATFORM_JOBS:-3}; JAVAC_EXE=$d/arbace-javac REPR_JAVA_EXE=$d/arbace-javac own_cache || fail "tool: the own platform"
      exit 0
    fi
    # --check (GTS57 (a)): only whether the tool is there at its key (exit 0 for a hit), so that bin/gate takes no lock for it
    [ -z "$check" ] || { echo "javac-vendor tool: none at the checkout's key (${want:0:12}) in $d"; exit 1; }
    t0=$(date +%s)
    echo "== javac's tool build (key ${want:0:12}; j2g on ${host:-the default host}${base:+, compiled namespaces of $base})"
    t=$root/target/arbace-go
    (export ARBACE_GO_ARCHES=amd64
     [ -z "$host" ] || export J2G_GO_EXE=$host
     [ -z "$base" ] || export ARBACE_AOT_BASE=$base
     bin/arbace-go --build-java) || fail "tool: the build failed"
    [ "$(cat "$t/amd64/arbace-javac.key")" = "$want" ] || fail "tool: the build's key is not the checkout's (a source changed during the build?)"
    rm -rf "$d"; mkdir -p "$d"
    cp "$t/amd64/arbace-javac" "$t/amd64/arbace-javac.key" "$d/" && cp "$t/j2g-javac.log" "$d/j2g.log" \
      && cp "$t/j2g-javac/report.edn" "$d/report.edn" || fail "tool: not copied into $d"
    # the tool's units (GT5, doc/GATE-SURVEY.md: bin/gate's program host :javac-prog)
    . "$root/bin/lib/prog-units.bash"
    prog_units "$t/j2g-javac/prog:prog" > "$d/units.tsv.tmp" && mv "$d/units.tsv.tmp" "$d/units.tsv" \
      || { rm -f "$d/units.tsv.tmp"; echo "javac-vendor tool: no units of the tool's program" >&2; }
    echo "javac-vendor tool: built, $d/arbace-javac (key ${want:0:12}, $(since "$t0"))"
    if [ "$(platform_kind)" = own ]; then
      own_jobs=${JAVAC_VENDOR_PLATFORM_JOBS:-3}; JAVAC_EXE=$d/arbace-javac REPR_JAVA_EXE=$d/arbace-javac own_cache || fail "tool: the own platform"
    fi ;;
  build)
    # j2g on the program built from the checkout (JFS22 (a)), when there is one
    [ -z "${J2G_GO_EXE:-}" ] && [ -x "$root/target/arbace-go/amd64/arbace" ] && export J2G_GO_EXE=$root/target/arbace-go/amd64/arbace
    exec bin/arbace-go --build-java "$@" ;;
  classes)
    # --jobs N: the modules corpus's modules at once (JCS359 stage 1)
    a=()
    while [ $# -gt 0 ]; do case $1 in --jobs) njobs=$2; shift 2 ;; *) a+=("$1"); shift ;; esac; done
    set -- "${a[@]}"
    case ${njobs:-1} in ''|*[!0-9]*|0) fail "classes: --jobs takes a number" ;; esac
    [ $# -gt 0 ] || set -- baseline samples jdk
    t0=$(date +%s)
    if [ "$*" = modules ]; then
      classes modules || { echo "javac-vendor classes: javac on Arbace differs from the build beyond the known differences, or a control passed ($(since "$t0"))"; exit 1; }
      echo "javac-vendor classes: javac on Arbace compiles the modules as the build, byte for byte or known ($(since "$t0"))"; exit 0
    fi
    classes "$@" || { echo "javac-vendor classes: javac on Arbace differs from the JVM's ($(since "$t0"))"; exit 1; }
    echo "javac-vendor classes: javac on Arbace compiles $* as the JVM's javac, byte for byte ($(since "$t0"))" ;;
  platform)
    d=${1:-$work/platform}
    case $d in /*) ;; *) d=$root/$d ;; esac
    platform "$d" || exit 1
    echo "$d" ;;
  platform-pin) platform_pin "$out" && cat "$out/platform.sha256" ;;
  platform-own)
    # JOP3 (a), JOP4 (a): the own platform built into DIR (default WORK/own) [--gensrc DIR: from those generated sources,
    # else the committed pack] [--jobs N]; --pin: then OUT/platform.sha256 rewritten as its pin (the switch); --pack: the
    # generated sources packed into OUT/platform-gensrc.tar.xz first (from --gensrc's DIR)
    d=$work/own g= pin= pack=
    while [ $# -gt 0 ]; do
      case $1 in
        --gensrc) g=$2; shift 2 ;;
        --jobs) own_jobs=$2; shift 2 ;;
        --pin) pin=1; shift ;;
        --pack) pack=1; shift ;;
        *) d=$1; shift ;;
      esac
    done
    case $d in /*) ;; *) d=$root/$d ;; esac
    if [ -n "$pack" ]; then
      [ -n "$g" ] || fail "platform-own --pack needs --gensrc DIR"
      own_gensrc_pack "$g" "$own_pack" || fail "platform-own: the pack"
      echo "javac-vendor platform-own: ${own_pack#$root/}, $(stat -c %s "$own_pack") bytes"
    fi
    t0=$(date +%s)
    own_build "$d" "$g" || fail "platform-own: the build ($d)"
    if [ -n "$pin" ]; then cp "$d/pin.sha256" "$out/platform.sha256"; echo "javac-vendor platform-own: ${out#$root/}/platform.sha256 is the own platform's pin"; fi
    echo "javac-vendor platform-own: $d/modules ($(since "$t0"))" ;;
  platform-cache)
    # JOP3 (a): the own pin's platform, ARBACE_GATE_EXES/platform-PIN20, built on a miss (--check: only whether it is there)
    [ "$(platform_kind)" = own ] || { echo "javac-vendor platform-cache: the pin is the build tree's (no own platform to keep)"; exit 0; }
    case ${1:-} in
      --check) JAVAC_VENDOR_PLATFORM_BUILD=0 own_cache || exit 1 ;;
      --seed)
        # a platform built by platform-own DIR, checked against the pin and moved into the cache (the switch night's)
        sd=${2:?platform-cache --seed DIR}
        own_check "$sd" "$out/platform.sha256" || fail "platform-cache --seed: $sd is not the pin's platform"
        c=$(. "$root/bin/lib/gate-cache.bash" && arbace_gate_exes "$root")/platform-$(sha256sum < "$out/platform.sha256" | cut -c1-20)
        mkdir -p "$(dirname "$c")"
        cp "$out/platform.sha256" "$sd/pin.committed" && rm -rf "$c" "$sd/classes" "$sd/tmp" && mv "$sd" "$c" && touch "$c/ok" || fail "platform-cache --seed: not moved into $c"
        echo "$c" ;;
      --jobs) own_jobs=$2; own_cache || exit 1 ;;
      '') own_cache || exit 1 ;;
      *) fail "platform-cache [--check | --jobs N]" ;;
    esac ;;
  platform-oracle)
    # JOP6 (a): the oracle tier's comparison of the own platform with the JDK build tree (javac-platform-oracle)
    t0=$(date +%s)
    platform_oracle || { echo "javac-vendor platform-oracle: the own platform differs from the build tree beyond the known differences, or a control passed ($(since "$t0"))"; exit 1; }
    echo "javac-vendor platform-oracle: the own platform is the build tree's, byte for byte or known ($(since "$t0"))" ;;
  platform-rebuild)
    # JOP3 (a)'s weekly proof: the generated sources made again on the current javac tool against the own platform, the
    # platform built again from them, both required to be the pin's, byte for byte [--jobs N]
    [ "$(platform_kind)" = own ] || { echo "javac-vendor platform-rebuild: the pin is the build tree's (nothing to rebuild)"; exit 0; }
    [ "${1:-}" != --jobs ] || own_jobs=$2
    t0=$(date +%s)
    gensrc || { echo "javac-vendor platform-rebuild: the generated sources made again are not the pin's ($(since "$t0"))"; exit 1; }
    own_build "$work/rebuild" "$work/gensrc/out" || fail "platform-rebuild: the build"
    own_check "$work/rebuild" "$out/platform.sha256" || { echo "javac-vendor platform-rebuild: the platform built again is not the pin's ($(since "$t0"))"; exit 1; }
    echo "javac-vendor platform-rebuild: the generated sources and the platform made again are the pin's, byte for byte ($(since "$t0"))" ;;
  platform-build)
    # JCS362 (a): OUT/platform-build.edn derived from the build tree; --check (the oracle tier's): derived afresh and
    # compared, the committed file untouched
    if [ "${1:-}" = --check ]; then
      mkdir -p "$work"
      platform_build_make "$work/platform-build.edn" || exit 1
      if cmp -s "$pbuild" "$work/platform-build.edn"; then
        echo "javac-vendor platform-build --check: ${pbuild#$root/} is the build tree's configuration ($(pb_modules | wc -l) modules)"
      else
        diff "$pbuild" "$work/platform-build.edn" > "$work/platform-build.diff"
        echo "javac-vendor platform-build --check: ${pbuild#$root/} differs from the build tree's ($work/platform-build.diff: $(wc -l < "$work/platform-build.diff") lines)"; exit 1
      fi
    else
      platform_build_make "$pbuild" || exit 1
      echo "javac-vendor platform-build: ${pbuild#$root/}, $(pb_modules | wc -l) modules, $(stat -c %s "$pbuild") bytes"
    fi ;;
  platform-gensrc)
    # JCS359 (a)(2), JCS362 (a): OUT/platform-gensrc.edn derived from the build tree; --check (the oracle tier's)
    if [ "${1:-}" = --check ]; then
      mkdir -p "$work"
      platform_gensrc_make "$work/platform-gensrc.edn" || exit 1
      if cmp -s "$pgensrc" "$work/platform-gensrc.edn"; then
        echo "javac-vendor platform-gensrc --check: ${pgensrc#$root/} is the build tree's ($(pg_records | wc -l) records)"
      else
        diff "$pgensrc" "$work/platform-gensrc.edn" > "$work/platform-gensrc.diff"
        echo "javac-vendor platform-gensrc --check: ${pgensrc#$root/} differs from the build tree's ($work/platform-gensrc.diff)"; exit 1
      fi
    else
      platform_gensrc_make "$pgensrc" || exit 1
      echo "javac-vendor platform-gensrc: ${pgensrc#$root/}, $(pg_records | wc -l) records, $(stat -c %s "$pgensrc") bytes"
    fi ;;
  gensrc)
    # JCS359 (a)(2): the modules' generated sources by the build's tools on javac's tool, against the build's
    t0=$(date +%s)
    gensrc "$@" || { echo "javac-vendor gensrc: the generated sources differ from the build's beyond the known differences, a run failed, or a control passed ($(since "$t0"))"; exit 1; }
    echo "javac-vendor gensrc: the generated sources are the build's, byte for byte or known ($(since "$t0"))" ;;
  descriptors)
    # JCS359 (a)(3): the module descriptors as the image holds them, against the build's
    t0=$(date +%s)
    descriptors "$@" || { echo "javac-vendor descriptors: a descriptor differs from the build's beyond the known differences ($(since "$t0"))"; exit 1; }
    echo "javac-vendor descriptors: the descriptors are the build's, byte for byte or known ($(since "$t0"))" ;;
  *) sed -n '2,/^set -/p' "$0" | sed '$d; s/^# \{0,1\}//' >&2; exit 2 ;;
esac

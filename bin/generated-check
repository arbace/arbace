#!/bin/bash
# The generated Go-build variants regenerated and compared with the committed files (Futamura
# F7.3, doc/FUTAMURA-SURVEY.md, "F7 as built"): a definition changed without regenerating them
# would otherwise go unnoticed until it mattered (CompilerOps.ae had gone stale so).
#   arbace/lang/go/CompilerNodes.ae   test/c2j/gen_nodes.ae (the evaluator's half of defnode's kinds)
#   arbace/lang/go/CompilerAOTFn.ae   test/c2j/gen_fns.ae (the run-time classes of compiled fns)
# Both read the program's reflection, so they run on an executable built from the checkout: the
# gate's (bin/arbace-go --gate-build, cached in .tmp/arbace-go-gate; a hit after bin/gate's
# build), or EXE.
#
# Usage: bin/generated-check [--update] [EXE]
#   --update  write the regenerated files over the committed ones instead of comparing
set -uo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash" # TMPDIR: .tmp/tmp when unset
cd "$root" || exit 1
update=
[ "${1:-}" = --update ] && { update=1; shift; }
exe=${1:-}
if [ -z "$exe" ]; then
  bin/arbace-go --gate-build || exit 1
  exe=$root/.tmp/arbace-go-gate/amd64/arbace
fi
[ -x "$exe" ] || { echo "generated-check: no executable $exe" >&2; exit 2; }
out=$root/.tmp/generated-check
mkdir -p "$out"
status=0
for pair in CompilerNodes.ae:test/c2j/gen_nodes.ae CompilerAOTFn.ae:test/c2j/gen_fns.ae; do
  file=${pair%%:*} gen=${pair#*:}
  if ! "$exe" "$gen" > "$out/$file" 2> "$out/$file.err"; then
    echo "generated-check: $gen failed (see $out/$file.err)"; status=1; continue
  fi
  if [ -n "$update" ]; then
    cp "$out/$file" "arbace/lang/go/$file" && echo "generated-check: arbace/lang/go/$file written"
  elif cmp -s "$out/$file" "arbace/lang/go/$file"; then
    echo "generated-check: arbace/lang/go/$file as $gen writes it"
  else
    diff -u "arbace/lang/go/$file" "$out/$file" > "$out/$file.diff"
    echo "generated-check: arbace/lang/go/$file is stale: $gen writes otherwise ($out/$file.diff;" \
      "bin/generated-check --update)"
    status=1
  fi
done
exit $status

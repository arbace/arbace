#!/bin/bash
# repr/go, Go's bridge: Go source as Go forms (read) and Go forms as Go source (print); read
# natively (doc/go/GO-PARSER-SURVEY.md), the helper tools/godump its oracle (doc/go/HELPER-NOTES.md,
# CONVERTER-NOTES.md, PRINTER-NOTES.md). Building
# a program held as Go forms is bin/build-go's (arbace.build.go, doc/go/BUILD.md).
#
#   bin/repr-go helper            build the helper into .tmp/godump/godump (TamaGo's go)
#   bin/repr-go dump [FLAGS] ARGS...  run the helper (built first): godump's flags and packages, or
#                                 -files and single-file programs; output in -o DIR (default
#                                 .tmp/godump/out), one .edn per package
#   bin/repr-go corpus [CORPUS]...
#                                 dump a corpus into .tmp/godump/corpus/CORPUS, then read every
#                                 dump on Arbace. CORPUS is [GOOS-]WHAT, GOOS tamago (the
#                                 default, no prefix) or linux, WHAT one of: amd64, arm64 (std
#                                 outside cmd for GOOS/ARCH), test, test-arm64 ($GOROOT/test's
#                                 single-file programs, the oracle's list, bin/repr-go check
#                                 --list-tests, for amd64 or arm64), tests (std for GOOS/amd64
#                                 with its _test.go files, godump -tests), dirtest,
#                                 dirtest-arm64 ($GOROOT/test's directory tests, bin/repr-go
#                                 check --list-dirtests: godump -dirs), errtest ($GOROOT/test's
#                                 error tests of one program, bin/repr-go check
#                                 --list-errorchecks: godump -files, programs with type errors
#                                 dumped with them; goi's check). Default: amd64 arm64
#                                 test. E.g. linux-amd64, linux-test-arm64. cgo is off.
#   bin/repr-go read --dump [--jobs N] [--quiet] FILE|DIR...
#                                 read dumps with Arbace's reader (arbace.repr.go.read), print a
#                                 summary
#   bin/repr-go read [--reader native|helper] [--full] [--tests] [--goos GOOS] [--goarch ARCH] [--out DIR] PKG...
#   bin/repr-go read [--reader native|helper] [--full] --corpus CORPUS [--out DIR]
#                                 Go into Go forms (arbace.repr.go's converter) under DIR (default
#                                 .tmp/repr-go/forms/pkgs, or .tmp/repr-go/forms/CORPUS[-full]),
#                                 mode :lines (--full: :full), each file read back and checked;
#                                 PKG as go list takes them in the working directory's module, for
#                                 GOOS/ARCH (default tamago/amd64; --tests: with the test variants);
#                                 CORPUS one of `bin/repr-go corpus`'s or native-check's. The
#                                 summary DIR.tsv, a line per package in the helper's format
#                                 (STATUS KEY FILES BYTES MS ERRORS [MSG]: ok, errors (type
#                                 errors, the first as MSG), fail (go/parser rejects a file, the
#                                 loader fails), excluded), and the report DIR.report.edn.
#                                 The reader (default $REPR_GO_READER, else native; GPS7):
#                                 native: without the helper and without the go command
#                                 (doc/go/GO-PARSER-SURVEY.md, GP1-GP5): the files and the dumps'
#                                 headers from the loader (arbace.repr.go.load: go list's part in
#                                 arbace.box.plan), each Go file parsed by go/parser from
#                                 tamago/goroot's forms, run by goi, and dumped as the dump's tree
#                                 (arbace.repr.go.parse), converted raw (arbace.repr.go.raw),
#                                 checked by goi's checker in its resolve mode, its answers
#                                 written as go/types' annotations (arbace.repr.go.annotate) and
#                                 converted as the helper's dumps are: the helper's forms byte for
#                                 byte (E-forms, native-check); the type errors goi's checker's.
#                                 helper (the oracle): the packages dumped by tools/godump
#                                 (go list, go/parser, go/types) into .tmp/repr-go/dumps
#                                 (REPR_GO_DUMPS: the dumps' directory, for concurrent runs), a
#                                 corpus's into .tmp/godump/corpus/CORPUS (`bin/repr-go corpus`,
#                                 dumped first if missing), converted; the type errors go/types'
#   bin/repr-go read --reader native --trees [--tests] [--goos GOOS] [--goarch ARCH] [--out DIR] PKG...
#   bin/repr-go read --reader native --trees --corpus CORPUS [--out DIR]
#                                 the native reader's trees alone (GP1, GP2): native dumps without
#                                 annotations under DIR/NAME (default .tmp/repr-go/native; NAME
#                                 pkgs or the corpus), report DIR/NAME.report.edn
#   bin/repr-go read --reader native --raw [--tests] [--goos GOOS] [--goarch ARCH] [--out DIR] PKG...
#   bin/repr-go read --reader native --raw --corpus CORPUS [--out DIR]
#                                 raw forms (doc/go/GO-PARSER-SURVEY.md, GP3; their shape in
#                                 doc/go/CONVERTER-NOTES.md, "Raw forms"; private to repr/go and
#                                 the checker): the native reader's trees converted with every
#                                 decision that needs types left open (arbace.repr.go.raw), mode
#                                 :full's positions, each file read back; the open decisions
#                                 counted by kind. Under DIR/NAME (default .tmp/repr-go/raw),
#                                 report DIR/NAME.report.edn
#   bin/repr-go native-check [--fresh] [--headers] [CORPUS...]
#                                 the native reader against the helper over the corpora (default
#                                 all): repr/go's corpora above (std with linux-errtest) and the
#                                 vendored trees' sources (bin/lib/repr-go/native-corpus:
#                                 goos-amd64, goos-arm64, cmd-linux-amd64, cmd-tamago-amd64,
#                                 cmd-tamago-arm64, box, purego, x509roots), each dump read once
#                                 (GPS23 (c)): E-tree (the loader's headers and files, the trees,
#                                 and the sets of dumps), the raw forms (GP3) resolved by the final
#                                 ones, and E-ann (GP4: the final forms the converter makes of the
#                                 native dump annotated by goi's checker equal, metadata and
#                                 positions included, those of the helper's), and E-forms (GP5:
#                                 their .ae text byte for byte in modes :lines and :full; where the
#                                 helper's conversion fails, the native one failing with its
#                                 message). The helper's dumps
#                                 made when missing (--fresh: afresh); --headers: the loader alone,
#                                 the headers and the sets, no parse (seconds); exits non-zero on
#                                 a difference that test/repr/go/native-known.edn does not list;
#                                 report in .tmp/repr-go/native-check[-headers].report.edn
#   bin/repr-go roundtrip [[GOOS/]ARCH] [--goos GOOS] [--record]
#                                 the round trip: convert std and $GOROOT/test's programs for
#                                 GOOS/ARCH (default tamago/amd64; GOOS tamago or linux, ARCH
#                                 amd64 or arm64), print the forms (arbace.repr.go.print) into the
#                                 candidate .tmp/repr-go/cand-ARCH (tamago) or cand-GOOS-ARCH, and
#                                 compare with bin/repr-go check against the reference
#                                 test/repr/go/roundtrip-ARCH.edn (tamago) or
#                                 roundtrip-GOOS-ARCH.edn: exits non-zero on a regression (an
#                                 entry and level passing there and not now). --record writes
#                                 the results as the new reference. --tests: std for
#                                 tamago/amd64 with its _test.go files (corpus tests) into
#                                 .tmp/repr-go/cand-tests, checked with bin/repr-go check --with-tests,
#                                 reference test/repr/go/roundtrip-tests.edn, known differences
#                                 (with reasons) test/repr/go/roundtrip-tests-known.edn.
#                                 --dirs: $GOROOT/test's directory tests for GOOS/ARCH (corpus
#                                 [linux-]dirtest[-arm64]: several packages each, local imports)
#                                 into .tmp/repr-go/cand-dirtest-[GOOS-]ARCH, checked with
#                                 bin/repr-go check --dirtests (levels tree, export, code, run),
#                                 reference test/repr/go/roundtrip-dirtest-[GOOS-]ARCH.edn, known
#                                 differences test/repr/go/roundtrip-dirtest-known.edn
#   bin/repr-go roundtrip --text [[GOOS/]ARCH] [--tests|--dirs]
#                                 the text level (doc/go/SPEC.md §3.1): convert the same corpora
#                                 with --full, print them in the full layout into
#                                 .tmp/repr-go/cand-text-[GOOS-]ARCH (or cand-text-tests) and compare
#                                 every printed file with its original byte for byte; no build.
#                                 Exits non-zero when a file differs that the known differences
#                                 (with reasons) test/repr/go/roundtrip-text-known.edn do not list
#   bin/repr-go print [--layout lines|gofmt] [--no-line-directives] [--line-file]
#                     [--src DIR [--build]] [--gofmt] FORMS.ae OUTDIR
#                                 the printer: Go forms -> Go source (doc/go/SPEC.md §12,
#                                 doc/go/PRINTER-NOTES.md; arbace.repr.go.print, its options):
#                                 one .go file per go/file form of the package FORMS.ae into
#                                 OUTDIR. With --src, copies the package's .s/.h/.syso and
#                                 embedded files from the original directory DIR and writes
#                                 OUTDIR/overlay.json; --build then runs go build -trimpath
#                                 -overlay in DIR under the forms' configuration. --line-file
#                                 names the forms file in gc's positions (SPEC §12.3)
#   bin/repr-go check [OPTIONS] CANDIDATE
#                                 the round trip's oracle over a corpus (bin/lib/repr-go/check,
#                                 doc/go/ROUNDTRIP.md; `bin/repr-go check --help`)
#   bin/repr-go test read [--regen]
#                                 the reader's tests (bin/lib/repr-go/test-read:
#                                 test/repr/go/convert_test.ae and the spec's examples,
#                                 test/repr/go/convert/)
#   bin/repr-go test print [REGEX]
#                                 the printer's tests (bin/lib/repr-go/test-print:
#                                 test/repr/go/print_test.ae, the cases test/repr/go/cases/)
#
# Environment: ARBACE_GOROOT, the TamaGo Go tree (go1.27.1, default /root/tamago-go), also for
# linux (its std differs from upstream's only by build constraints and GOOS tables);
# REPR_GO_EXE, the Go executable that runs repr/go's namespaces (read, print; and bin/build-go's; default
# the tools' host, bin/lib/host.bash: ARBACE_HOST_EXE, else stage 0; bin/lib/repr-go-host.bash;
# doc/STANDALONE-NOTES.md, "S3: repr/go on Go"; the JVM host left with S4).
set -euo pipefail
export CGO_ENABLED=0 # Go's builds never use cgo (doc/go/BOX-NOTES.md, "... cgo dropped", 2026-10-16)
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/renamed-env.bash" # stops on a stale G2A_*, J2A_*, A2G_* or C2A_*
goroot=${ARBACE_GOROOT:-/root/tamago-go}
work=$root/.tmp/godump
helper=$work/godump

build() {
  if [ ! -x "$goroot/bin/go" ]; then
    echo "no $goroot/bin/go: set ARBACE_GOROOT to TamaGo's Go tree (go1.27.1)" >&2
    return 1
  fi
  mkdir -p "$work"
  # Concurrent runs (bin/gate --full runs two round trips) share the helper: build one at a
  # time, into a temporary file moved into place, so a running helper is never overwritten.
  (
    flock 7
    # for the host: GOOS=tamago is the configuration of the code converted, not of the helper
    cd "$root/tools/godump" &&
      env -u GOOS -u GOARCH GOROOT="$goroot" GOFLAGS= GOTOOLCHAIN=local CGO_ENABLED=0 \
        "$goroot/bin/go" build -trimpath -o "$helper.new.$$" . &&
      mv -f "$helper.new.$$" "$helper"
  ) 7> "$work/build.lock"
}

godump() {
  GOROOT="$goroot" "$helper" -go "$goroot/bin/go" "$@"
}

has_out_flag() {
  local a
  for a in "$@"; do
    case $a in -o|-o=*|--o|--o=*) return 0 ;; esac
  done
  return 1
}

read_dumps() {
  . "$root/bin/lib/repr-go-host.bash"
  repr_go_run arbace.repr.go.read "$@"
}

# The single-file programs of $GOROOT/test for tamago/ARCH: the oracle's list (bin/repr-go check
# --list-tests, `gocmp tests`), so that the helper's corpus and the oracle's agree: Go's test
# driver's directories and actions that compile one program, no other GOEXPERIMENT, build
# constraints and file names matched by go/build. Extra .go files named on the action line
# join the program (FILE,FILE). Prints one argument per line.
test_programs() {
  "$root/bin/repr-go" check --arch "$1" --list-tests
}

# The error tests of one program of $GOROOT/test for GOOS/ARCH (bin/repr-go check
# --list-errorchecks, `gocmp tests -errorcheck`). Prints one per line.
errorcheck_programs() {
  "$root/bin/repr-go" check --arch "$1" --list-errorchecks
}

# The directory tests of $GOROOT/test for GOOS/ARCH (bin/repr-go check --list-dirtests, `gocmp
# tests -dirs`): FILE.go whose action is compiledir, rundir, builddir or buildrundir, its
# packages in FILE.dir. Prints one per line.
dir_tests() {
  "$root/bin/repr-go" check --arch "$1" --list-dirtests
}

# corpus_config CORPUS: sets cgoos, cwhat (amd64, arm64, test, test-arm64, tests, dirtest,
# dirtest-arm64) and carch
corpus_config() {
  cgoos=tamago
  cwhat=$1
  case $1 in
    tamago-*) cwhat=${1#tamago-} ;;
    linux-*) cgoos=linux; cwhat=${1#linux-} ;;
  esac
  case $cwhat in
    amd64|test|tests|dirtest|errtest) carch=amd64 ;;
    arm64|test-arm64|dirtest-arm64) carch=arm64 ;;
    *) echo "corpus: [linux-]amd64, arm64, test, test-arm64, tests, dirtest, dirtest-arm64 or errtest, not $1" >&2; return 2 ;;
  esac
}

# corpus_name GOOS WHAT: the corpus's directory name (tamago's without a prefix)
corpus_name() {
  if [ "$1" = tamago ]; then echo "$2"; else echo "$1-$2"; fi
}

# corpus_dump CORPUS: the helper's dumps of a corpus into .tmp/godump/corpus/NAME (NAME.tsv the
# helper's summary), afresh; prints the summary line and the packages not dumped
corpus_dump() {
  local out t0 t1 cgoos cwhat carch name
  corpus_config "$1"
  name=$(corpus_name "$cgoos" "$cwhat")
  out=$work/corpus/$name
  mkdir -p "$work/corpus"
  rm -rf "$out"
  t0=$(date +%s.%N)
  case $cwhat in
    amd64|arm64)
      godump -goos "$cgoos" -goarch "$carch" -o "$out" std > "$out.tsv" || true ;;
    tests)
      godump -tests -goos "$cgoos" -goarch "$carch" -o "$out" std > "$out.tsv" || true ;;
    test|test-arm64)
      REPR_GO_GOOS=$cgoos test_programs "$carch" > "$work/corpus/$name-programs.txt"
      (cd "$goroot/test" && xargs -a "$work/corpus/$name-programs.txt" \
         env GOROOT="$goroot" "$helper" -go "$goroot/bin/go" -goos "$cgoos" -goarch "$carch" -files -o "$out") \
        > "$out.tsv" || true ;;
    errtest)
      REPR_GO_GOOS=$cgoos errorcheck_programs "$carch" > "$work/corpus/$name-programs.txt"
      (cd "$goroot/test" && xargs -a "$work/corpus/$name-programs.txt" \
         env GOROOT="$goroot" "$helper" -go "$goroot/bin/go" -goos "$cgoos" -goarch "$carch" -files -o "$out") \
        > "$out.tsv" || true ;;
    dirtest|dirtest-arm64)
      REPR_GO_GOOS=$cgoos dir_tests "$carch" > "$work/corpus/$name-list.txt"
      (cd "$goroot/test" && xargs -a "$work/corpus/$name-list.txt" \
         env GOROOT="$goroot" "$helper" -go "$goroot/bin/go" -goos "$cgoos" -goarch "$carch" -dirs -o "$out") \
        > "$out.tsv" || true ;;
  esac
  t1=$(date +%s.%N)
  awk -F'\t' -v what="$name" -v secs="$(echo "$t1 - $t0" | bc)" '
    { n[$1]++ } $1 == "ok" || $1 == "errors" { files += $3; bytes += $4 } $4 > max { max = $4; big = $2 }
    END { printf "%s: %d dumped (%d ok, %d with type errors, %d failed, %d excluded by the configuration), %d files, %.1f MB (largest %s, %.1f MB), %.1f s\n",
          what, n["ok"] + n["errors"], n["ok"], n["errors"], n["fail"], n["excluded"], files, bytes / 1e6, big, max / 1e6, secs }' "$out.tsv"
  grep -v -P '^(ok|excluded)\t' "$out.tsv" || true
}

corpus() {
  local what cgoos cwhat carch name
  build
  [ $# -gt 0 ] || set -- amd64 arm64 test
  for what in "$@"; do corpus_config "$what"; done
  for what in "$@"; do corpus_dump "$what"; done
  for what in "$@"; do
    corpus_config "$what"
    name=$(corpus_name "$cgoos" "$cwhat")
    echo "reading $name on Arbace:"
    read_dumps --jobs "$(nproc)" --quiet "$work/corpus/$name"
  done
}

# The native reader (doc/go/GO-PARSER-SURVEY.md, GP1: the tree; GP2: the loader): go/parser from
# tamago/goroot's forms run by goi, the dumper generated from go/ast's forms (arbace.repr.go.parse),
# the files and the dumps' headers from the loader (arbace.repr.go.load, go list's part in
# arbace.box.plan); checked against the helper's dumps (E-tree: headers, trees, the sets of dumps).

# the corpora of native-check: repr/go's (corpus_config) and the vendored trees'
# (bin/lib/repr-go/native-corpus)
native_corpora="amd64 arm64 linux-amd64 linux-arm64 tests test test-arm64 linux-test linux-test-arm64
  dirtest dirtest-arm64 linux-dirtest linux-dirtest-arm64 linux-errtest
  goos-amd64 goos-arm64 cmd-linux-amd64 cmd-tamago-amd64 cmd-tamago-arm64 box purego x509roots"

# native_spec CORPUS: the loader's spec of one of repr/go's corpora ($work/corpus/NAME.load.edn:
# {:name :dumps :tsv :loads [...]}, the helper's arguments as data; the programs' lists made when
# missing); prints its path
native_spec() {
  local c=$1 cgoos cwhat carch name mode="" more="" list="" cwd=$root spec
  corpus_config "$c"
  name=$(corpus_name "$cgoos" "$cwhat")
  mkdir -p "$work/corpus"
  case $cwhat in
    amd64|arm64) mode=:packages more=':args ["std"]' ;;
    tests) mode=:packages more=':args ["std"] :tests true' ;;
    test|test-arm64)
      mode=:files cwd=$goroot/test list=$work/corpus/$name-programs.txt
      [ -s "$list" ] || REPR_GO_GOOS=$cgoos test_programs "$carch" > "$list" ;;
    errtest)
      mode=:files cwd=$goroot/test list=$work/corpus/$name-programs.txt
      [ -s "$list" ] || REPR_GO_GOOS=$cgoos errorcheck_programs "$carch" > "$list" ;;
    dirtest|dirtest-arm64)
      mode=:dirs cwd=$goroot/test list=$work/corpus/$name-list.txt
      [ -s "$list" ] || REPR_GO_GOOS=$cgoos dir_tests "$carch" > "$list" ;;
  esac
  [ -z "$list" ] || more=":args-file \"$list\""
  spec=$work/corpus/$name.load.edn
  printf '{:name "%s" :dumps "%s" :tsv "%s.tsv"\n :loads [{:goroot "%s" :goos "%s" :goarch "%s" :mode %s :cwd "%s" %s}]}\n' \
    "$name" "$work/corpus/$name" "$work/corpus/$name" "$goroot" "$cgoos" "$carch" "$mode" "$cwd" "$more" > "$spec"
  echo "$spec"
}

# native_dumps CORPUS FRESH: the helper's dumps of CORPUS (made when missing, or FRESH) and the
# loader's spec of it; prints the spec's path
native_dumps() {
  local c=$1 fresh=$2 cgoos cwhat carch name
  case $c in
    goos-*|cmd-*|box|purego|x509roots)
      if [ -n "$fresh" ] || [ ! -d "$work/corpus/$c" ] || [ ! -f "$work/corpus/$c.load.edn" ]; then
        "$root/bin/lib/repr-go/native-corpus" "$c" "$work/corpus/$c" >&2
      fi
      echo "$work/corpus/$c.load.edn" ;;
    *)
      corpus_config "$c"
      name=$(corpus_name "$cgoos" "$cwhat")
      if [ -n "$fresh" ] || [ ! -d "$work/corpus/$name" ]; then build >&2; corpus_dump "$c" >&2; fi
      native_spec "$c" ;;
  esac
}

native_run() {
  . "$root/bin/lib/repr-go-host.bash"
  repr_go_run "${native_ns:-arbace.repr.go.parse}" "$1" --jobs "${REPR_GO_JOBS:-$(( $(nproc) / 2 ))}" --forms "$root/tamago/goroot" "${@:2}"
}

# native_read RAW TESTS OUT CORPUS FORMS FULL PRINT TEXT... [-goos G -goarch A] -- PKG...: read
# with the native reader, the loader's files and headers, no helper. FORMS non-empty: the final
# forms (arbace.repr.go.annotate, the default reader's), written into OUT as the helper's path
# writes them (default .tmp/repr-go/forms/CORPUS[-full] or .tmp/repr-go/forms/pkgs; FULL: mode
# :full; PRINT, TEXT: the round trip's --print DIR and --text [--text-known FILE]), the summary
# OUT.tsv and the report OUT.report.edn; RAW non-empty: the raw forms (arbace.repr.go.raw); else
# the trees (arbace.repr.go.parse), under OUT/NAME
native_read() {
  local raw=$1 tests=$2 out=$3 corpus=$4 forms=$5 full=$6 print=$7 goos=tamago goarch=amd64 spec name pkgs="" native_ns=arbace.repr.go.parse text=()
  shift 7
  while [ "$1" != -goos ] && [ "$1" != -goarch ] && [ "$1" != -- ]; do text+=("$1"); shift; done
  [ -z "$raw" ] || native_ns=arbace.repr.go.raw
  [ -z "$forms" ] || native_ns=arbace.repr.go.annotate
  while [ "$1" != -- ]; do
    case $1 in -goos) goos=$2 ;; -goarch) goarch=$2 ;; esac
    shift 2
  done
  shift
  if [ -n "$corpus" ]; then
    case $corpus in
      goos-*|cmd-*|box|purego|x509roots)
        spec=$work/corpus/$corpus.load.edn
        [ -f "$spec" ] || "$root/bin/lib/repr-go/native-corpus" --src-only "$corpus" "$work/corpus/$corpus" >&2 ;;
      *) spec=$(native_spec "$corpus") ;;
    esac
    name=$(sed -n 's/^{:name "\([^"]*\)".*/\1/p' "$spec")
  else
    [ $# -gt 0 ] || { echo "read: packages or --corpus" >&2; return 2; }
    for p in "$@"; do pkgs="$pkgs \"$p\""; done
    name=pkgs
    if [ -n "$forms" ]; then spec=${out:-$root/.tmp/repr-go/forms/pkgs}.load.edn
    else spec=${out:-$root/.tmp/repr-go/native}/pkgs.load.edn; fi
    mkdir -p "$(dirname "$spec")"
    printf '{:name "pkgs"\n :loads [{:goroot "%s" :goos "%s" :goarch "%s" :mode :packages :cwd "%s" :args [%s] %s}]}\n' \
      "$goroot" "$goos" "$goarch" "$PWD" "$pkgs" "${tests:+:tests true}" > "$spec"
  fi
  if [ -n "$forms" ]; then
    out=${out:-$root/.tmp/repr-go/forms/$name${full:+-full}}
    rm -rf "$out"
    mkdir -p "$out"
    native_run read ${full:+--full} --out "$out" --quiet --report "$out.report.edn" --tsv "$out.tsv" \
      ${print:+--print "$print"} ${text[@]+"${text[@]}"} "$spec"
  else
    if [ -n "$raw" ]; then out=${out:-$root/.tmp/repr-go/raw}; else out=${out:-$root/.tmp/repr-go/native}; fi
    mkdir -p "$out"
    rm -rf "$out/$name"
    native_run read --out "$out" --report "$out/$name.report.edn" "$spec"
  fi
}

# native_check [--fresh] [--headers] [CORPUS...]: E-tree, the raw forms and E-ann over the
# corpora (default all of native_corpora; arbace.repr.go.annotate), or the headers alone
# (--headers: arbace.repr.go.parse)
native_check() {
  local fresh="" headers="" specs=() c native_ns=arbace.repr.go.annotate
  while [ $# -gt 0 ]; do
    case $1 in
      --fresh) fresh=1; shift ;;
      --headers) headers=--headers; native_ns=arbace.repr.go.parse; shift ;;
      *) break ;;
    esac
  done
  [ $# -gt 0 ] || set -- $native_corpora
  for c in "$@"; do specs+=("$(native_dumps "$c" "$fresh")"); done
  mkdir -p "$root/.tmp/repr-go"
  native_run check $headers --known "$root/test/repr/go/native-known.edn" \
    --report "$root/.tmp/repr-go/native-check${headers:+-headers}.report.edn" "${specs[@]}"
}

convert_main() {
  . "$root/bin/lib/repr-go-host.bash"
  repr_go_run arbace.repr.go read "$@"
}

convert() {
  local full="" tests="" out="" corpus="" print="" text=() jobs cfg=() reader=${REPR_GO_READER:-native} raw="" trees=""
  jobs=${REPR_GO_JOBS:-$(( $(nproc) / 2 ))}
  while [ $# -gt 0 ]; do
    case $1 in
      --reader) reader=$2; shift 2 ;;
      --raw) raw=1; shift ;;
      --trees) trees=1; shift ;;
      --full) full=--full; shift ;;
      --tests) tests=-tests; shift ;;
      --out) out=$2; shift 2 ;;
      --corpus) corpus=$2; shift 2 ;;
      --print) print=$2; shift 2 ;;
      --text) text+=(--text); shift ;;
      --text-known) text+=(--text-known "$2"); shift 2 ;;
      --goos) cfg+=(-goos "$2"); shift 2 ;;
      --goarch) cfg+=(-goarch "$2"); shift 2 ;;
      *) break ;;
    esac
  done
  case $reader in
    helper) [ -z "$raw$trees" ] || { echo "read --raw, --trees: the native reader's (--reader native)" >&2; return 2; } ;;
    native)
      [ -z "$raw" ] || [ -z "$trees" ] || { echo "read: --raw or --trees" >&2; return 2; }
      if [ -n "$raw$trees" ]; then
        [ -z "$full$print${text[*]+x}" ] || { echo "read --raw, --trees: no --full, --print or --text (the final forms')" >&2; return 2; }
        native_read "$raw" "$tests" "$out" "$corpus" "" "" "" ${cfg[@]+"${cfg[@]}"} -- "$@"
      else
        native_read "" "$tests" "$out" "$corpus" 1 "$full" "$print" ${text[@]+"${text[@]}"} ${cfg[@]+"${cfg[@]}"} -- "$@"
      fi
      return ;;
    *) echo "read: --reader native or helper, not $reader" >&2; return 2 ;;
  esac
  if [ -n "$corpus" ]; then
    local cgoos cwhat carch
    corpus_config "$corpus"
    corpus=$(corpus_name "$cgoos" "$cwhat")
    local dumps=$work/corpus/$corpus
    [ -d "$dumps" ] || corpus "$corpus"
    out=${out:-$root/.tmp/repr-go/forms/$corpus${full:+-full}}
    rm -rf "$out"
    mkdir -p "$(dirname "$out")"
    cp "$dumps.tsv" "$out.tsv"
    convert_main --out "$out" --jobs "$jobs" --goroot "$goroot" --quiet $full ${print:+--print "$print"} \
      ${text[@]+"${text[@]}"} --report "$out.report.edn" "$dumps"
  else
    [ $# -gt 0 ] || { echo "convert: packages or --corpus" >&2; return 2; }
    build
    local dumps=${REPR_GO_DUMPS:-$root/.tmp/repr-go/dumps}
    rm -rf "$dumps"
    mkdir -p "$dumps"
    godump $tests ${cfg[@]+"${cfg[@]}"} -o "$dumps" "$@" > "$dumps.tsv" || true
    out=${out:-$root/.tmp/repr-go/forms/pkgs}
    mkdir -p "$(dirname "$out")"
    cp "$dumps.tsv" "$out.tsv"
    convert_main --out "$out" --jobs "$jobs" --goroot "$goroot" $full ${print:+--print "$print"} \
      ${text[@]+"${text[@]}"} "$dumps"
  fi
}

# roundtrip_text GOOS ARCH PREFIX WITH_TESTS DIRS: the text level (roundtrip --text)
roundtrip_text() {
  local goos=$1 arch=$2 prefix=$3 with_tests=$4 dirs=$5 cand status=0 s t0 t1 known
  known=$root/test/repr/go/roundtrip-text-known.edn
  if [ -n "$dirs" ]; then
    cand=$root/.tmp/repr-go/cand-text-dirtest-$prefix$arch
  elif [ -n "$with_tests" ]; then
    [ "$goos/$arch" = tamago/amd64 ] || { echo "roundtrip --text --tests: tamago/amd64 only (the corpus tests)" >&2; return 2; }
    cand=$root/.tmp/repr-go/cand-text-tests
  else
    cand=$root/.tmp/repr-go/cand-text-$prefix$arch
  fi
  rm -rf "$cand"
  t0=$(date +%s.%N)
  if [ -n "$dirs" ]; then
    if [ "$arch" = arm64 ]; then set -- "${prefix}dirtest-arm64"; else set -- "${prefix}dirtest"; fi
  elif [ -n "$with_tests" ]; then
    set -- tests
  else
    local tests=test
    [ "$arch" = arm64 ] && tests=test-arm64
    set -- "$prefix$arch" "$prefix$tests"
  fi
  for c in "$@"; do
    s=0
    convert --full --corpus "$c" --print "$cand" --text --text-known "$known" || s=$?
    if [ $s -ge 128 ]; then
      echo "roundtrip --text: the converter died (exit status $s)" >&2
      return 1
    fi
    [ $s -eq 0 ] || status=1
  done
  t1=$(date +%s.%N)
  printf 'roundtrip --text %s: %.1f s\n' "$goos/$arch${with_tests:+ with tests}${dirs:+, directory tests}" "$(echo "$t1 - $t0" | bc)"
  return $status
}

roundtrip() {
  local goos=tamago arch=amd64 record="" cand ref t0 t1 t2 status with_tests="" check prefix text="" dirs=""
  while [ $# -gt 0 ]; do
    case $1 in
      amd64|arm64) arch=$1; shift ;;
      tamago/amd64|tamago/arm64|linux/amd64|linux/arm64) goos=${1%/*}; arch=${1#*/}; shift ;;
      --goos) goos=$2; shift 2 ;;
      --record) record=1; shift ;;
      --tests) with_tests=1; shift ;;
      --text) text=1; shift ;;
      --dirs) dirs=1; shift ;;
      *) echo "roundtrip: [[GOOS/]amd64|arm64] [--goos tamago|linux] [--tests|--dirs] [--record] [--text], not $1" >&2; return 2 ;;
    esac
  done
  case $goos in
    tamago) prefix= ;;
    linux) prefix=linux- ;;
    *) echo "roundtrip: GOOS tamago or linux, not $goos" >&2; return 2 ;;
  esac
  [ -n "$dirs" ] && [ -n "$with_tests" ] && { echo "roundtrip: --tests or --dirs, not both" >&2; return 2; }
  if [ -n "$text" ]; then
    roundtrip_text "$goos" "$arch" "$prefix" "$with_tests" "$dirs"
    return
  fi
  cand=$root/.tmp/repr-go/cand-$prefix$arch
  ref=$root/test/repr/go/roundtrip-$prefix$arch.edn
  check=("$root/bin/repr-go" check --goos "$goos" --arch "$arch")
  if [ -n "$with_tests" ]; then
    [ "$goos/$arch" = tamago/amd64 ] || { echo "roundtrip --tests: tamago/amd64 only (the corpus tests)" >&2; return 2; }
    cand=$root/.tmp/repr-go/cand-tests
    ref=$root/test/repr/go/roundtrip-tests.edn
    check+=(--with-tests --no-tests --known "$root/test/repr/go/roundtrip-tests-known.edn")
  fi
  if [ -n "$dirs" ]; then
    cand=$root/.tmp/repr-go/cand-dirtest-$prefix$arch
    ref=$root/test/repr/go/roundtrip-dirtest-$prefix$arch.edn
    check+=(--dirtests --known "$root/test/repr/go/roundtrip-dirtest-known.edn")
  fi
  rm -rf "$cand"
  t0=$(date +%s.%N)
  # A conversion's failures are the check's to report; a converter killed by a signal (the
  # out-of-memory killer, 137) leaves a partial candidate, so the round trip stops there.
  converted() {
    local s=0
    convert "$@" || s=$?
    if [ $s -ge 128 ]; then
      echo "roundtrip: the converter died (exit status $s); the candidate is incomplete" >&2
      return 1
    fi
  }
  if [ -n "$dirs" ]; then
    local dt=dirtest
    [ "$arch" = arm64 ] && dt=dirtest-arm64
    converted --corpus "$prefix$dt" --print "$cand" || return 1
  elif [ -n "$with_tests" ]; then
    converted --corpus tests --print "$cand" || return 1
  else
    local tests=test
    [ "$arch" = arm64 ] && tests=test-arm64
    converted --corpus "$prefix$arch" --print "$cand" || return 1
    converted --corpus "$prefix$tests" --print "$cand" || return 1
  fi
  t1=$(date +%s.%N)
  status=0
  if [ -n "$record" ]; then
    "${check[@]}" --record "$ref" "$cand" || status=$?
  elif [ -f "$ref" ]; then
    "${check[@]}" --reference "$ref" "$cand" || status=$?
  else
    echo "no reference ${ref#$root/} (bin/repr-go roundtrip ... --record): any failure fails" >&2
    "${check[@]}" "$cand" || status=$?
  fi
  t2=$(date +%s.%N)
  printf 'roundtrip %s: convert and print %.1f s, check %.1f s\n' "$goos/$arch${with_tests:+ with tests}${dirs:+, directory tests}" \
    "$(echo "$t1 - $t0" | bc)" "$(echo "$t2 - $t1" | bc)"
  return $status
}

cmd=${1:-}
[ $# -gt 0 ] && shift
case $cmd in
  helper) build ;;
  dump)
    build
    if has_out_flag "$@"; then godump "$@"; else godump -o "$work/out" "$@"; fi ;;
  read)
    if [ "${1:-}" = --dump ]; then shift; read_dumps "$@"; else convert "$@"; fi ;;
  corpus) corpus "$@" ;;
  native-check) native_check "$@" ;;
  roundtrip) roundtrip "$@" ;;
  print)
    . "$root/bin/lib/repr-go-host.bash"
    repr_go_exec arbace.repr.go.print "$@" ;;
  check) exec "$root/bin/lib/repr-go/check" "$@" ;;
  test)
    case ${1:-} in
      read|print) t=$1; shift; exec "$root/bin/lib/repr-go/test-$t" "$@" ;;
      *) echo "test: read or print, not ${1:-nothing}" >&2; exit 2 ;;
    esac ;;
  *) sed -n '2,/^set -/p' "$0" | sed '$d; s/^# \{0,1\}//' >&2; exit 2 ;;
esac

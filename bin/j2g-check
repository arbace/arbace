#!/bin/bash
# The differential check of j2g (doc/go/J2G-NOTES.md, "The harness"): translates what the
# oracle's class scripts call (test/oracle/classes, doc/go/ORACLE.md), builds a Go program
# running their recorded steps with the translated classes for linux/amd64 and linux/arm64
# (qemu-aarch64), and compares each step with the JVM's recorded result. Prints pass counts
# per script and architecture and their totals; writes .tmp/j2g/check/results.edn. Failing
# steps listed in test/j2g/needs-core.edn (they need arbace.core loaded) count as "need core".
#
# Usage: bin/j2g-check [SCRIPT...] [-- J2G-OPTIONS...]
#        bin/j2g-check --record-fixtures
#   SCRIPT: names of test/oracle/expected/classes/*.edn, e.g. Murmur3, or fixtures (the
#   classes of test/j2g/fixtures, their results recorded on a JVM in test/j2g/fixtures.edn);
#   default all
#   --record-fixtures: record test/j2g/fixtures.edn again, on the frozen JVM Arbace
#   (bin/lib/frozen.bash; test/j2g/record_fixtures.ae), after a change to the fixtures
#   J2G-OPTIONS: bin/j2g's (--slice REGEX ..., --lang, --jdk DIR)
# Environment: J2G_ARCH (default amd64,arm64), J2G_OUT (default .tmp/j2g/check), J2G_SHOW=1
# (print the first failures; all: every failure and every need-core step), J2G_GO_EXE (the Go
# executable that runs the check and j2g, default the tools' host, bin/lib/host.bash; GOGC 400
# and GOMEMLIMIT 12GiB unless set, as bin/j2g). The fixtures are recorded in-process on that
# executable (their Java forms evaluated, their methods called by reflection), as they were
# on the JVM until standalone S4.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash" # TMPDIR: .tmp/tmp when unset
. "$root/bin/lib/renamed-env.bash" # stops on a stale G2A_*, J2A_*, A2G_* or C2A_*
. "$root/bin/lib/tools.bash"
cd "$root"
if [ "${1:-}" = --record-fixtures ]; then
  . "$root/bin/lib/frozen.bash"
  frozen_java jar -- test/j2g/record_fixtures.ae test/j2g/fixtures.edn
  exit
fi
ARBACE_HOST_EXE=${J2G_GO_EXE:-${ARBACE_HOST_EXE:-}} GOGC=${GOGC:-400} GOMEMLIMIT=${GOMEMLIMIT:-12GiB} \
  arbace_tool -p "$root/test" -m j2g.check "$@"

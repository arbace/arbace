#!/bin/bash
# The differential check of a2g (doc/go/A2G-NOTES.md, "The harness"): translates what the
# oracle's class scripts call (test/oracle/classes, doc/go/ORACLE.md), builds a Go program
# running their recorded steps with the translated classes for linux/amd64 and linux/arm64
# (qemu-aarch64), and compares each step with the JVM's recorded result. Prints pass counts
# per script and architecture and their totals; writes .tmp/a2g/check/results.edn. Failing
# steps listed in test/a2g/needs-core.edn (they need arbace.core loaded) count as "need core".
#
# Usage: bin/a2g-check [SCRIPT...] [-- A2G-OPTIONS...]
#        bin/a2g-check --record-fixtures
#   SCRIPT: names of test/oracle/expected/classes/*.edn, e.g. Murmur3, or fixtures (the
#   classes of test/a2g/fixtures, their results recorded on a JVM in test/a2g/fixtures.edn);
#   default all
#   --record-fixtures: record test/a2g/fixtures.edn again, on the frozen JVM Arbace
#   (bin/lib/frozen.bash; test/a2g/record_fixtures.ae), after a change to the fixtures
#   A2G-OPTIONS: bin/a2g's (--slice REGEX ..., --lang, --jdk DIR)
# Environment: A2G_ARCH (default amd64,arm64), A2G_OUT (default .tmp/a2g/check), A2G_SHOW=1
# (print the first failures; all: every failure and every need-core step), A2G_GO_EXE (the Go
# executable that runs the check and a2g, default the tools' host, bin/lib/host.bash; GOGC 400
# and GOMEMLIMIT 12GiB unless set, as bin/a2g). The fixtures are recorded in-process on that
# executable (their class forms evaluated, their methods called by reflection), as they were
# on the JVM until standalone S4.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tools.bash"
cd "$root"
if [ "${1:-}" = --record-fixtures ]; then
  . "$root/bin/lib/frozen.bash"
  frozen_java jar -- test/a2g/record_fixtures.ae test/a2g/fixtures.edn
  exit
fi
ARBACE_HOST_EXE=${A2G_GO_EXE:-${ARBACE_HOST_EXE:-}} GOGC=${GOGC:-400} GOMEMLIMIT=${GOMEMLIMIT:-12GiB} \
  arbace_tool -p "$root/test" -m a2g.check "$@"

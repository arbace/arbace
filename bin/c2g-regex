#!/bin/bash
# The oracle's regex corpus on java.util.regex as c2g translates it (doc/go/C2G-NOTES.md,
# phase 2C; test/c2g/regex_check.clj): c2g translates the JDK closure with
# test/c2g/regex/RegexCheck.clj, a Go program runs every recorded case
# (test/oracle/expected/regex) through it, and the results are compared with the JVM's. Prints
# pass counts per file, per case (pattern and flag set) and per input; writes
# .tmp/c2g/regex/results.edn.
#
# Usage: bin/c2g-regex [FILE...]   (parts of the expected files' names, e.g. basics; default all)
# Environment: C2G_ARCH (default amd64; amd64,arm64 for both, arm64 under qemu-aarch64),
# C2G_OUT (default .tmp/c2g/regex), C2G_SHOW=1|all (print failures), C2G_JVM_OPTS, JRT_CONV.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tools.bash"
arbace_runtime
cd "$root"
# shellcheck disable=SC2086
exec java -Xss64m ${C2G_JVM_OPTS:--Xmx10g} --add-modules ALL-SYSTEM -cp "$ARBACE_CP:$root/test" arbace.lang.Main -m c2g.regex-check "$@"

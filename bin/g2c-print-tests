#!/bin/bash
# The tests of g2c's printer (test/g2c/print_test.clj, doc/go/PRINTER-NOTES.md), run on Arbace
# (bin/lib/tools.bash: target/stage2). Each case test/g2c/cases/NAME.clj (Go forms) is printed
# in both layouts (gofmt, lines) into .tmp/g2c-print-tests/NAME/; the gofmt layout must be left
# as it is by gofmt, the lines layout must parse; when the original Go of the case exists
# (NAME.go, or a directory NAME/), the printed files are compared with it by tools/gocmp at the
# levels the case names (default tree, export, code), and, for cases marked lines, by
# test/g2c/golines (the lines of declarations, statements and closing braces).
#
# Usage: bin/g2c-print-tests [REGEX]    only the cases whose name matches REGEX
# Environment: G2C_GOROOT (default /root/tamago-go), G2C_GOARCH (default amd64).
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tools.bash"
arbace_runtime
goroot=${G2C_GOROOT:-/root/tamago-go}
work=$root/.tmp/g2c-print-tests
mkdir -p "$work/bin"
for tool in tools/gocmp:gocmp test/g2c/golines:golines; do
  (cd "$root/${tool%%:*}" && env -u GOOS -u GOARCH GOROOT="$goroot" GOTOOLCHAIN=local GOFLAGS= GOWORK=off \
     "$goroot/bin/go" build -o "$work/bin/${tool##*:}" .) || { echo "cannot build ${tool%%:*}" >&2; exit 2; }
done
exec java -Xss64m -Xmx8g -cp "$ARBACE_CP:$root/test" -Dg2c.root="$root" -Dg2c.work="$work" \
  -Dg2c.goroot="$goroot" -Dg2c.goarch="${G2C_GOARCH:-amd64}" -Dg2c.only="${1:-}" arbace.lang.Main -e "
(require 'arbace.test)
(require 'g2c.print-test)
(let [r (arbace.test/run-tests 'g2c.print-test)]
  (shutdown-agents)
  (System/exit (if (zero? (+ (:fail r) (:error r))) 0 1)))"

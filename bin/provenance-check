#!/bin/bash
# The provenance files' repr/java hash against the reader's (doc/GATE-SURVEY.md, GTS21 (a), "As built:
# GT4, GT6"): each of jdk/provenance.edn, jdk/javac/provenance.edn, test/java-fixtures/provenance.edn
# and test/java/forms/provenance.edn names the hash of repr/java's reader (:converter :repr-java,
# bin/lib/repr-java/host.bash's repr_java_reader_hash: arbace/repr/java.ae and its reader files,
# bin/repr-java) that wrote it. An edit of the reader, or of bin/repr-java, that does not rewrite
# them leaves a stale hash that the verifies of --full (javac-verify, jrt-convert, java-fixtures,
# java-check-full's --forms verify) fail on a day later (8d621e91, GT1-GT3's slip). This is a hash
# comparison, seconds, no executable. jdk/javac/provenance.edn also names the hash of jdk/edge.edn
# (:jdk-edge, bin/javac-vendor convert): `bin/j2g-edge update` rewrites the edge and leaves it stale,
# which `bin/javac-vendor verify` of --full found at the first audit of GT4 (9ff8d44b, 2026-10-28); since
# GT5 (GTS36 (b)) j2g-edge update runs bin/javac-vendor edge, which rewrites both, and each file's :jdk
# (the platform, by the hash of its pin) is compared too. A stale hash is not a stale conversion: the fix is the
# writers' update (bin/jrt-convert update, bin/javac-vendor convert, bin/clojure-tests
# --java-fixtures update, bin/java-check --forms update), which rewrite the forms.
#
# Usage: bin/provenance-check
set -uo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash"
cd "$root" || exit 1
. "$root/bin/lib/repr-java/host.bash"
want=$(repr_java_reader_hash) || exit 1
plat=$(repr_java_platform) || exit 1
status=0
# writer FILE: the update that rewrites it (GTS36 (b): run in the same commit as the change)
writer() {
  case $1 in
    jdk/provenance.edn) echo "bin/jrt-convert update" ;;
    jdk/javac/provenance.edn) echo "bin/javac-vendor convert" ;;
    test/java-fixtures/provenance.edn) echo "bin/clojure-tests --java-fixtures update" ;;
    test/java/forms/provenance.edn) echo "bin/java-check --forms update" ;;
  esac
}
for f in jdk/provenance.edn jdk/javac/provenance.edn test/java-fixtures/provenance.edn test/java/forms/provenance.edn; do
  have=$(sed -n 's/.*:repr-java "\([0-9a-f]*\)".*/\1/p' "$f" | head -1)
  if [ "$have" = "$want" ]; then
    echo "provenance-check: $f: ${have:0:12}, the reader's"
  else
    echo "provenance-check: $f: ${have:-none} is not the reader's $want (rewrite it: $(writer "$f"))"
    status=1
  fi
  # GTS36 (a): the platform it was read against, by its pin (jdk/javac/platform.sha256)
  hp=$(sed -n 's/.*:jdk "\(platform [0-9a-f]*\)".*/\1/p' "$f" | head -1)
  if [ "$hp" != "$plat" ]; then
    echo "provenance-check: $f: :jdk ${hp:-none} is not the platform's pin, $plat (rewrite it: $(writer "$f"))"
    status=1
  fi
done
want=$(sha256sum < jdk/edge.edn | cut -c1-64)
have=$(sed -n 's/.*:jdk-edge "\([0-9a-f]*\)".*/\1/p' jdk/javac/provenance.edn | head -1)
if [ "$have" = "$want" ]; then
  echo "provenance-check: jdk/javac/provenance.edn: :jdk-edge ${have:0:12}, jdk/edge.edn's"
else
  echo "provenance-check: jdk/javac/provenance.edn: :jdk-edge ${have:-none} is not jdk/edge.edn's $want (bin/javac-vendor edge rewrites it with javac's edge; bin/j2g-edge update runs it since GTS36 (b))"
  status=1
fi
exit $status

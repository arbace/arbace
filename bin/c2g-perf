#!/bin/bash
# c2g's micro benchmarks (doc/go/C2G-NOTES.md, "Phase 2D"): test/c2g/bench/BnWork.clj's
# workloads on the JVM Arbace and translated by c2g into Go (linux/amd64), with a table of
# ns per element and the ratio.
#
# Usage: bin/c2g-perf [--only NAME,...] [--jvm-only|--go-only] [-- C2G-OPTIONS]
# Environment: C2G_PERF_OUT (default .tmp/c2g/perf), C2G_PERF_SECS (default 2),
#   C2G_JVM_OPTS (default -Xmx8g), GOGC (passed to the Go program).
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tools.bash"
arbace_runtime
cd "$root"
conv=${JRT_CONV:-$root/.tmp/jrt/conv}
[ -d "$conv" ] || { echo "bin/c2g-perf: no $conv; run bin/jrt-convert first" >&2; exit 1; }
# shellcheck disable=SC2086
exec java -Xss64m ${C2G_JVM_OPTS:--Xmx8g} --add-modules ALL-SYSTEM -cp "$ARBACE_CP:$root/test" arbace.lang.Main -m c2g.perf "$@"

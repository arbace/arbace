#!/bin/bash
# a2g: class forms to Go forms (doc/go/A2G-SPEC.md, doc/go/A2G-NOTES.md), on Arbace
# (bin/lib/tools.bash: target/stage2, built by bin/build-arbace).
#
# Usage: bin/a2g [OPTIONS] (see arbace/a2g/main.ae, or bin/a2g --help). The classes outside the
# forms come from jdk/edge.edn (--edge; bin/a2g-edge, doc/STANDALONE-NOTES.md, S2), not from the
# JVM's reflection.
# Environment: A2G_JVM_OPTS (default -Xmx12g), JRT_CONV (the converted JDK closure, --jdk's
# default: by default jdk/forms, the committed forms, jdk/README.md; .tmp/jrt/conv for
# bin/jrt-convert's latest output); A2G_HOST, what runs a2g (doc/STANDALONE-NOTES.md, S3):
#   jvm (the default): Arbace on the JVM, target/stage2 plus the checkout (bin/lib/tools.bash);
#   go: the native Go executable, A2G_GO_EXE (default target/arbace-go/<host arch>/arbace, built
#       by bin/arbace-go --build), run from a copy in .tmp/a2g-host/ (a build replaces the
#       executable), the checkout first on ARBACE_PATH: a2g's namespaces (not embedded in the
#       executable) load from the checkout's sources, the class forms' analysis
#       (arbace.classes.*) is the executable's own, as embedded and prepared. GOGC is 400 unless
#       set (a2g allocates much and keeps little of it), GOMEMLIMIT 12GiB (A2G_JVM_OPTS' heap).
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"
# Without the JDK closure a2g still translates, but the JDK's types come out as any and the Go
# does not build: say so up front
conv=${JRT_CONV:-$root/jdk/forms}
if [ ! -d "$conv" ]; then
  echo "bin/a2g: no $conv (the JDK closure as class forms; jdk/forms, or bin/jrt-convert's)" >&2
  exit 1
fi
case ${A2G_HOST:-jvm} in
  jvm) ;;
  go)
    case $(uname -m) in aarch64) arch=arm64 ;; *) arch=amd64 ;; esac
    exe=${A2G_GO_EXE:-$root/target/arbace-go/$arch/arbace}
    [ -x "$exe" ] || { echo "bin/a2g: A2G_HOST=go: no executable $exe (bin/arbace-go --build first, or set A2G_GO_EXE)" >&2; exit 1; }
    host=$root/.tmp/a2g-host
    mkdir -p "$host"
    # one refresh at a time; a running copy is replaced by a rename, never written in place
    ( flock 9
      cmp -s "$exe" "$host/arbace" || { cp "$exe" "$host/arbace.new.$$" && mv -f "$host/arbace.new.$$" "$host/arbace"; }
    ) 9> "$host/lock"
    ARBACE_PATH=$root${ARBACE_PATH:+:$ARBACE_PATH} GOGC=${GOGC:-400} GOMEMLIMIT=${GOMEMLIMIT:-12GiB} \
      exec "$host/arbace" -m arbace.a2g.main "$@" ;;
  *) echo "bin/a2g: A2G_HOST is jvm or go, not $A2G_HOST" >&2; exit 2 ;;
esac
. "$root/bin/lib/tools.bash"
arbace_runtime
# shellcheck disable=SC2086
exec java -Xss64m ${A2G_JVM_OPTS:--Xmx12g} --add-modules ALL-SYSTEM -cp "$ARBACE_CP" arbace.lang.Main -m arbace.a2g.main "$@"

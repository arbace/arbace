#!/bin/bash
# a2g: class forms to Go forms (doc/go/A2G-SPEC.md, doc/go/A2G-NOTES.md), on Arbace
# (bin/lib/tools.bash: target/stage2, built by bin/build-arbace).
#
# Usage: bin/a2g [OPTIONS] (see arbace/a2g/main.ae, or bin/a2g --help). The classes outside the
# forms come from jdk/edge.edn (--edge; bin/a2g-edge, doc/STANDALONE-NOTES.md, S2), not from the
# JVM's reflection.
# Environment: A2G_JVM_OPTS (default -Xmx12g), JRT_CONV (the converted JDK closure, --jdk's
# default: by default jdk/forms, the committed forms, jdk/README.md; .tmp/jrt/conv for
# bin/jrt-convert's latest output).
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tools.bash"
arbace_runtime
cd "$root"
# Without the JDK closure a2g still translates, but the JDK's types come out as any and the Go
# does not build: say so up front
conv=${JRT_CONV:-$root/jdk/forms}
if [ ! -d "$conv" ]; then
  echo "bin/a2g: no $conv (the JDK closure as class forms; jdk/forms, or bin/jrt-convert's)" >&2
  exit 1
fi
# shellcheck disable=SC2086
exec java -Xss64m ${A2G_JVM_OPTS:--Xmx12g} --add-modules ALL-SYSTEM -cp "$ARBACE_CP" arbace.lang.Main -m arbace.a2g.main "$@"

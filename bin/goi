#!/bin/bash
# goi, the interpreter of Go forms (doc/go/GOI-SPEC.md): its tools. The checker (arbace.go.check,
# GR2, §3) runs on the tools' host evaluated from the checkout here (annotations, test), and in
# the executable as the REPL's (GR3: embedded); the table's generator (arbace.go.table, GR1, §6)
# runs on the tools' host. `run` and `check` (§11, GR3) run the built executable.
#
#   bin/goi table [--out DIR] [--configs C,...] [--no-invokers] [--min-sharing N]
#                  [--program-list FILE --program-root DIR]
#                      the table and the digests (arbace.go.table on the tools' host): from the
#                      list go/arbace/gotable.edn and the listed packages' Go forms for each
#                      configuration C (GOOS/GOARCH; default linux/amd64, linux/arm64,
#                      tamago/amd64, tamago/arm64): linux's converted by bin/repr-go read (cached
#                      under .tmp/goi-table/, keyed by the list, repr/go's sources, godump and Go's
#                      version), tamago's tamago/goroot's (its arch/ARCH files laid over). Writes
#                      DIR (default target/arbace-go/gotable): go/arbace/gotable.ae and
#                      go/arbace/gotable/ (the package arbace/gotable, its digests embedded),
#                      report.edn; DIR/key names its inputs, and an unchanged key keeps DIR.
#                      bin/arbace-go --build runs it and gives j2g --gotable DIR; with
#                      --program-list FILE --program-root DIR ({:packages [path ...]}, the forms
#                      under DIR/go: bin/arbace-go --build-program, REAP7b) a user's program's Go
#                      packages listed too, each that checks (report.edn's :program; the
#                      others, :refused-program, left to goi)
#        bin/goi table --size [WORK]
#                      the table's cost (§6.6, GS4): the work module of the last build (default
#                      target/arbace-go/work-amd64/mod) linked as the build links it (stripped),
#                      without the table (an empty arbace/gotable) and with the table but no
#                      typed invokers (every call by reflect.Value.Call), the sizes printed:
#                      the table's whole size and the invokers' part (GS4: above 1 MB, the
#                      threshold variant, --min-sharing)
#   bin/goi annotations [--record] [--jobs N] [CORPUS...]
#                                 the annotation check (§11.4): every package of the corpora
#                                 type-checked by goi's checker, without running anything: zero
#                                 errors on these valid packages and every annotation of §3.6
#                                 verified (:val, :tag, :go/via, ^:assign, conv, :init-order, and
#                                 :inst since GR6) in every declaration, generic ones included (S53
#                                 ended at GR6; a declaration left unchecked fails it). CORPUS: tamago-amd64, tamago-arm64 (tamago/goroot,
#                                 its arch/ARCH/ laid over it), linux-amd64 (std), linux-test
#                                 ($GOROOT/test's single-file programs), linux-dirtest (its
#                                 directory tests); default all five. The linux corpora are
#                                 repr/go's conversions (bin/repr-go read --corpus CORPUS, run first
#                                 when .tmp/repr-go/forms/CORPUS is missing). The counts are
#                                 compared with test/goi/annotations-CORPUS.edn (--record writes it);
#                                 reports in .tmp/goi/annotations-CORPUS.report.edn (--work DIR:
#                                 DIR's). --forms DIR: the corpora's forms are DIR's (DIR/amd64,
#                                 DIR/arm64 for tamago's std, one tree each; DIR/linux-amd64,
#                                 DIR/linux-test, DIR/linux-dirtest: the native reader's, bin/repr-go
#                                 read --reader native --forms --out DIR); --reference DIR: the
#                                 counts compared with another run's reports in DIR (the same
#                                 corpora's conversions by the helper)
#   bin/goi test [--gc] [--regen]
#                                 the checker's tests (test/goi/check_test.ae): the invalid forms of
#                                 test/goi/errors/ (each ; ERROR comment the checker's message at its
#                                 line) and the checked trees of test/goi/checked/ against their
#                                 .edn; --gc also builds the invalid forms printed by repr/go with gc
#                                 and requires its messages to be the ERROR comments'
#                                 (test/goi/gc_errors.ae); --regen rewrites test/goi/checked/*.edn.
#                                 Then the interpreter's tests (GR3), on the built executable
#                                 (GOI_RUN_EXE, else target/arbace-go/amd64/arbace): the programs
#                                 test/goi/run/go/t/NAME.ae run by bin/goi run, their standard output,
#                                 standard error (to the goroutines' traces) and status against
#                                 NAME.out, .err, .exit (--gc: those are gc's, the forms printed by
#                                 repr/go and built; --regen: written from gc's run); and Go forms at
#                                 the REPL, test/goi/repl.ae (its package in test/goi/repl-pkgs), every
#                                 user std package imported at the REPL, test/goi/std.ae (GR8a), and
#                                 §1.4's session typed at the REPL, test/goi/session.in against
#                                 its transcript test/goi/session.expected (GR5)
#   bin/goi run ROOT NS [ARG...]  (arbace.go.run --errorcheck [--lang goV] ROOT NS: the package
#                                 checked only, its errors printed as gc prints them with -C)
#                                 an interpreted Go program in program mode (GOI-SPEC.md §2.7,
#                                 §11; arbace.go.run on the executable, GOI_RUN_EXE): the package
#                                 of namespace NS from the forms root ROOT, checked, built, run;
#                                 os.Exit exits, an uncaught panic is reported as gc's (status 2).
#                                 goi: unsupported: REASON (status 125) for what goi does not run
#                                 yet, goi: error: MESSAGE (126) for its failures
#   bin/goi check [--record] [--jobs N] [--essential] [--only REGEX] [--list FILE]
#                                 the check (§11): the run programs of $GOROOT/test (repr/go's
#                                 conversion, the corpus linux-test: bin/repr-go read --corpus
#                                 linux-test when missing or stale: each corpus below is kept by
#                                 a key, DIR.goi-key, of Go's version, $GOROOT/test's pin and
#                                 repr/go's sources, and read again when it changes) each interpreted by bin/goi run against
#                                 gc's build and run of the original (RPS12, since REAP2; until
#                                 then of the forms printed), as Go's test driver builds it (GOPATH
#                                 mode, in its directory; cached in .tmp/goi-check/gcref, by the
#                                 original's, the arguments' and the toolchain's hashes): exit status, standard
#                                 output, standard error to the goroutines' traces (skip when gc's
#                                 own run does not pass the test: a status not 0, or output other
#                                 than the golden .out); and its
#                                 directory tests (rundir, buildrundir, runindir: the corpus
#                                 linux-dirtest), the main package interpreted with the packages it
#                                 imports, against the test's golden output (standard output and
#                                 error combined, status 0). Each is pass,
#                                 fail, error, unsupported (the reason), known
#                                 (test/goi/check-known.edn, with the reason; a reason "speed: ..."
#                                 only for a timeout, "positions: ", "runs the go command: ", "runtime.GOROOT "
#                                 only for a fail, "go build's -complete: " an AOT build error, "errorcheck: "
#                                 a fail but not of the printing; apply_known) or skip (an action
#                                 setting -goexperiment or -godebug; its go build flags, -gcflags,
#                                 -ldflags and -tags, build gc's reference alone, goi running the
#                                 program as written); a run program's time limit 10 s, its action's
#                                 -t, or its line in test/goi/timeouts.txt; the results against
#                                 test/goi/check-linux-amd64.edn: a program passing there and not
#                                 now fails the check, as does a listed program with no result (its
#                                 job killed) and, in a whole check, a program of the reference
#                                 this run did not list (its forms gone); --record writes it (not
#                                 over a program with no result). The negative controls
#                                 (GTS81 (a), test/goi/controls.txt): a subject's run judged against
#                                 another program's gc run, // ERROR comments (errorcheck) or golden
#                                 output (directory tests: GTS85 (b)), by the subject's own checker
#                                 from its own run (GTS86 (b): no run of its own), in every run but
#                                 the box's; one that passes, or whose subject is not in the run
#                                 (but with --only), fails the check; they are no programs of the
#                                 list, so no "no result" or "missing" line names them. --list FILE (GT8.7, the
#                                 gate's nightly rotation; at both levels): the run restricted to the programs
#                                 FILE names, one id a line (the ids of the records, $GOROOT/test-relative
#                                 paths such as fixedbugs/issue1.go; blank lines and # lines ignored), run
#                                 programs, directory tests and errorcheck programs alike; a selection as --only
#                                 is (what ran is judged: no "missing" line for an unlisted program of the
#                                 reference, the divergences not classified, a control whose subject is not
#                                 listed left; --record refused); with --only, the intersection (--only
#                                 applied to the listed ids); an id of FILE the run does not list is not run
#                                 ("missing" when the reference has it). The run's own results are classified
#                                 (goi.divergences --partial: no box records, no essential subset); every program
#                                 that fails the run (a regression, no result, missing, a fail or error row, a
#                                 program in no class) is also printed on a line of its own, `   failing: ID`
#                                 (read with sed -nE 's/^   failing: (.+)$/\1/p'). --essential: the
#                                 programs of test/goi/essential.txt (GS12, the essential gate's).
#                                 GR7b: and its errorcheck programs (the corpus linux-errtest:
#                                 bin/repr-go read --corpus linux-errtest when missing), each
#                                 checked by goi's checker without running (arbace.go.run
#                                 --errorcheck), its errors judged against the // ERROR comments
#                                 by Go's test driver's judge (tools/gocmp errorcheck) when gc's own
#                                 errors pass it (else skip); GP6 (doc/go/GO-PARSER-SURVEY.md): a
#                                 program with a syntax error by gc's syntax (bin/repr-go
#                                 syntax-errors: gc's parser from tamago/cmd's forms, compiled since GP7;
#                                 gc stops after them) or that go/parser rejects is judged on gc's
#                                 syntax errors, an invalid program repr/go cannot convert on its
#                                 raw forms (bin/repr-go read --reader native --raw --corpus
#                                 linux-errtest when needed and missing; arbace.go.run --errorcheck
#                                 --raw: the checker's resolve mode); the others with gc's front
#                                 end's errors beside its type checker (GPS41 (c): arbace.go.run
#                                 --errorcheck --gc-front: gc's syntax's branch checks in place of
#                                 goi's, noder's pragmas', then its writer's declaration checks);
#                                 unsupported: an action flag
#                                 of gc's later phases (-m, -l, -live, -d=..., -race, -std, -+),
#                                 /*line directives (a //line maps the checker's lines), or errors go/types does not report either (gc's
#                                 phases after type checking)
#   bin/goi check --aot [--record] [--jobs N] [--essential] [--only REGEX] [--list FILE]
#                                 the AOT level (REAP2, doc/FULL-SUPPORT-SURVEY.md "As built:
#                                 REAP2"; RPS10-RPS12, RPS17): the same corpora, each run
#                                 program's forms built by arbace.build.go (bin/build-go --layout
#                                 lines, the action's flags as go build's: --go-flag) and run
#                                 against gc's build and run of the original (the check's
#                                 reference); each directory test's packages made a module (their
#                                 local imports, "./a", printed as the paths gc resolves them to,
#                                 RPS11), built and run against its golden output; each errorcheck
#                                 program printed from its forms of mode :full (the corpus
#                                 linux-errtest-full: bin/repr-go read --full --corpus linux-errtest
#                                 when missing) and compiled by gc with all the action's flags, its
#                                 errors judged against the original's // ERROR comments when gc's
#                                 on the original pass (else skip). The results against
#                                 test/goi/check-aot-linux-amd64.edn, test/goi/check-aot-known.edn's
#                                 programs known; then bin/goi divergences --aot. --essential: the
#                                 programs of test/goi/essential-aot.txt (REAP8, RPS33 (a): the
#                                 essential gate's), no divergences
#   bin/goi check --box [--record] [--jobs N] [--only REGEX]
#                                 the check in the box (GS13, GR7a): the programs of
#                                 test/goi/box.txt run by the TamaGo guest (GOI_BOX_EXE, else
#                                 target/arbace-go/box-amd64/arbace-box, bin/arbace-go --build
#                                 --box) on /dev/kvm, each in a box of its own: its forms written
#                                 into the guest's in-memory file system by the guest's standard
#                                 input, then arbace.go.run; against gc's run on linux/amd64 (the
#                                 check's reference, .tmp/goi-check/ref) as the check does, but
#                                 the box's console one stream (GC35: TamaGo writes a program's
#                                 standard output and error to it), against gc's standard
#                                 output then error; test/goi/check-known.edn's and
#                                 test/goi/check-box-known.edn's programs known; the results
#                                 against test/goi/check-box-amd64.edn (a program passing there
#                                 and not now fails; --record writes it); default 8 jobs, each box
#                                 the launcher's vCPUs (ARBACE_BOX_CPUS, 4); GOI_BOX_TIMEOUT, the
#                                 seconds added to each program's timeout for the box (default 60)
#   bin/goi check --box --arch arm64 [...]
#                                 the same in the arm64 box (GOI-SPEC.md "As built: the arm64 box
#                                 check"): the launcher GOI_BOX_EXE runs, a candidate that runs
#                                 the arm64 launcher where KVM/arm64 is (bin/box-arm64-vm goi sets
#                                 it, the emulated aarch64 VM: GOI_BOX_TMO, the program's seconds,
#                                 exported to it); every second program of test/goi/box.txt (GC75;
#                                 GOI_BOX_ALL=1: all), against test/goi/check-box-arm64.edn,
#                                 test/goi/check-box-known-arm64.edn's
#                                 programs known too; the runs in .tmp/goi-check/box-arm64
#   bin/goi check --box --bundle DIR [--arch arm64] [--only REGEX]
#                                 test/goi/box.txt's runs written for a box elsewhere (the Mac's,
#                                 bin/box-mac-bundle; GC76), nothing run: DIR/in/PROGRAM.in, the
#                                 guest's standard input box_run writes, DIR/want/PROGRAM.want,
#                                 the console expected (gc's standard output then error, or a
#                                 directory test's golden output), and DIR/programs.tsv: PROGRAM,
#                                 the timeout's seconds, the status expected, and how to compare
#                                 (one: the console up to the goroutines' traces; dir: as is);
#                                 DIR/known.tsv, the known programs and their reasons
#   bin/goi check --corpus nethttp [--record] [--jobs N] [--only REGEX] [--list FILE] [--gc-only] [--update-want]
#                                 the net/http corpus (NH1, doc/go/NET-HTTP-SURVEY.md, "As built: NH1"):
#                                 test/nethttp's programs (a module, a package main each, listed in
#                                 manifest.edn, loopback only), at the gc level built and run by gc
#                                 (stdout against NAME/want.out, status 0, stderr empty;
#                                 test/nethttp/check-gc-linux-amd64.edn), at goi's level their forms
#                                 (bin/repr-go read ./..., cached by key) run by arbace.go.run against gc's
#                                 run (test/nethttp/check-linux-amd64.edn, --record writes it; a
#                                 program passing there and not now, one not recorded, or, without
#                                 --only, one recorded and not run fails the check, at every level;
#                                 --record takes no --only); the non-passes in the classes of
#                                 test/nethttp/divergences.edn (bin/goi divergences --nethttp);
#                                 --gc-only: the gc level alone, --update-want: rewrites the want.out
#                                 files from gc's runs
#   bin/goi check --corpus nethttp --arbace [--record] [--only REGEX]
#                                 NH12 (a)'s set (As built: NH12 (a), NH18 (c)): test/nethttp/arbace/NAME.ae,
#                                 programs gc cannot run (Arbace fns as handlers and RoundTrippers, reify, a
#                                 handler defined at the REPL, the refused import), each a script of the
#                                 executable (GOI_RUN_EXE) in loopback, its stdout against the hand-written
#                                 NAME.out, results against test/nethttp/arbace/check-linux-amd64.edn, the
#                                 non-passes of this run in test/nethttp/arbace/divergences.edn (bin/goi
#                                 divergences --nethttp-arbace --results)
#   bin/goi divergences [--aot | --nethttp | --nethttp-arbace] [--results FILE] [--table | --programs]
#                                 v1's divergences (GR10, GOI-SPEC.md "v1's divergences"): every
#                                 program not passing in test/goi/check-linux-amd64.edn,
#                                 check-box-amd64.edn and check-box-arm64.edn in a class of
#                                 test/goi/divergences.edn (its result and reason matched), none
#                                 failing or in error, every program of test/goi/essential.txt
#                                 passing; prints each class's count (--table: the spec's table,
#                                 --programs: the programs by class; test/goi/divergences.ae).
#                                 bin/goi check runs it after a whole check that passes, on
#                                 that run's results in place of the linux/amd64 (or AOT, or
#                                 net/http) reference (--results FILE: results.tsv). --aot:
#                                 the AOT level's reference in the classes of
#                                 test/goi/divergences-aot.edn
#
# Environment: ARBACE_HOST_EXE (the tools' host, bin/lib/host.bash; GOI_EXE runs the table's
# generator instead), ARBACE_GOROOT (TamaGo's Go tree, for --gc and the linux corpora's
# conversion).
set -euo pipefail
export CGO_ENABLED=0 # Go's builds never use cgo (doc/go/BOX-NOTES.md, "... cgo dropped", 2026-10-16)
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/bin/lib/tmpdir.bash" # TMPDIR: .tmp/tmp when unset
. "$root/bin/lib/renamed-env.bash"
. "$root/bin/lib/tools.bash"
. "$root/bin/lib/limit.bash" # limited: CPU-time limits with a wall cap (GT6)
. "$root/bin/lib/gate-cache.bash"
. "$root/bin/lib/cover.bash" # ARBACE_COVER_DIR: the cover build, a GOCOVERDIR per program (GT8.3)
cd "$root"

goroot=${ARBACE_GOROOT:-/root/tamago-go}
list=$root/go/arbace/gotable.edn

# the generator's host executable
host_exe() {
  if [ -n "${GOI_EXE:-}" ]; then echo "$GOI_EXE"; return; fi
  . "$root/bin/lib/host.bash"
  arbace_host_exe
}

# linux_forms ARCH EXE: std converted for linux/ARCH by repr/go's native reader (cached under
# .tmp/goi-table/, keyed by repr/go's sources, the checker's and the loader's, which it runs,
# godump and Go's version); prints the root. The checker reads the listed
# packages and their imports from it (GC14: arbace.go.check's declaration layer)
linux_forms() {
  local a=$1 exe=$2 key dir
  key=$( { echo std; cat "$goroot/VERSION"
           (cd "$root" && find arbace/repr/go.ae arbace/repr/go arbace/go/check.ae arbace/go/check arbace/box/plan.ae tools/godump -type f | LC_ALL=C sort | xargs sha256sum); } \
         | sha256sum | cut -c1-16)
  dir=$root/.tmp/goi-table/$key/linux-$a
  if [ ! -f "$dir/.done" ]; then
    echo "== bin/repr-go read --goos linux --goarch $a std (cached in $dir)" >&2
    rm -rf "$dir" "$dir.dumps"
    mkdir -p "$(dirname "$dir")"
    (cd "$root" && REPR_GO_EXE=$exe REPR_GO_DUMPS=$dir.dumps bin/repr-go read --goos linux --goarch "$a" --out "$dir" std) \
      > "$dir.log" 2>&1 || { tail -20 "$dir.log" >&2; echo "goi table: converting std for linux/$a failed ($dir.log)" >&2; return 1; }
    rm -rf "$dir.dumps"
    touch "$dir/.done"
  fi
  echo "$dir"
}

# tamago_hash: the hash of tamago/goroot's forms (for the key: the checker reads the listed
# packages and their imports)
tamago_hash() {
  (cd "$root" && find tamago/goroot -type f -name '*.ae' | LC_ALL=C sort | xargs sha256sum) | sha256sum | cut -c1-64
}

table() {
  local out=$root/target/arbace-go/gotable configs=linux/amd64,linux/arm64,tamago/amd64,tamago/arm64 extra=() exe c args=() key plist= proot=
  while [ $# -gt 0 ]; do
    case $1 in
      --out) out=$2; shift 2 ;;
      --configs) configs=$2; shift 2 ;;
      --no-invokers) extra+=(--no-invokers); shift ;;
      --min-sharing) extra+=(--min-sharing "$2"); shift 2 ;;
      --no-docs) extra+=(--no-docs); shift ;;
      --program-list) plist=$2; shift 2 ;;
      --program-root) proot=$2; shift 2 ;;
      --size) shift; size "$@"; return ;;
      *) echo "goi table: unknown option $1" >&2; return 2 ;;
    esac
  done
  if [ -n "$plist$proot" ]; then
    [ -f "$plist" ] && [ -d "$proot/go" ] || { echo "goi table: --program-list FILE and --program-root DIR (with DIR/go) go together" >&2; return 2; }
    plist=$(cd "$(dirname "$plist")" && pwd)/$(basename "$plist") proot=$(cd "$proot" && pwd)
    extra+=(--program-list "$plist" --program-root "$proot")
  fi
  exe=$(host_exe) || return 1
  for c in ${configs//,/ }; do
    case $c in
      linux/*) args+=(--config "$c=$(linux_forms "${c#linux/}" "$exe")") || return 1 ;;
      tamago/*) args+=(--config "$c=$root/tamago/goroot,$root/tamago/goroot/arch/${c#tamago/}") ;;
      *) echo "goi table: no configuration $c" >&2; return 2 ;;
    esac
  done
  # what the table is made from: the list, the forms (linux's by their cache's key, tamago's by
  # their hash), the generator, its options
  key=$( { echo "${args[*]} ${extra[*]:-}"; cat "$list" "$root/arbace/go/table.ae" "$root/go/arbace.ae" "$root/go/arbace/api.ae"; (cd "$root" && find go/arbace/repr -type f -name '*.ae' | LC_ALL=C sort | xargs cat); (cd "$root" && find arbace/go/check.ae arbace/go/check -type f | LC_ALL=C sort | xargs cat); tamago_hash
         if [ -n "$plist" ]; then cat "$plist"; (cd "$proot" && find go -type f | LC_ALL=C sort | xargs -d '\n' sha256sum); fi; } | sha256sum | cut -c1-64)
  if [ -f "$out/key" ] && [ "$(cat "$out/key")" = "$key" ] && [ -f "$out/go/arbace/gotable.ae" ]; then
    echo "goi table: $out unchanged (key ${key:0:12})" >&2
    return 0
  fi
  rm -rf "$out"
  mkdir -p "$out"
  (cd "$root" && ARBACE_PATH=$root "$exe" -m arbace.go.table --list "$list" --out "$out" "${args[@]}" ${extra[@]+"${extra[@]}"}) >&2 \
    || { echo "goi table: the generator failed" >&2; return 1; }
  echo "$key" > "$out/key"
}

# size [WORK]: the executable of the work module WORK linked as built, without the table and
# without the invokers
size() {
  local work=${1:-$root/target/arbace-go/work-amd64/mod} t ovl full none noinv
  [ -d "$work/gotable" ] || { echo "goi table --size: no work module with the table ($work)" >&2; return 1; }
  t=$root/.tmp/goi-size
  rm -rf "$t"; mkdir -p "$t"
  ovl=$(cd "$root" && bin/jrt overlay | tail -1)
  . "$root/bin/lib/version.bash"
  local v; v=$(arbace_version "$root")
  link() { # link MOD OUT
    (cd "$1" && env GOROOT="$goroot" GOTOOLCHAIN=local GOFLAGS= GOWORK=off GO111MODULE=on GOPROXY=off GOEXPERIMENT= \
       CGO_ENABLED=0 GOOS=linux GOARCH=amd64 GOAMD64=v1 "$goroot/bin/go" build -trimpath -buildvcs=false \
       "-ldflags=-s -w -X 'main.arbaceVersion=$v'" -overlay "$ovl" -o "$2" arbace/cmd/arbace) >> "$t/build.log" 2>&1
  }
  # the module as built, its gotable package replaced: empty (no table), or printed without invokers
  cp -a "$work" "$t/mod-none"
  rm -rf "$t/mod-none/gotable"; mkdir -p "$t/mod-none/gotable"
  printf 'package gotable\n' > "$t/mod-none/gotable/gotable.go"
  echo "== linked without the table" >&2
  link "$t/mod-none" "$t/none" || { tail "$t/build.log" >&2; return 1; }
  echo "== the table without invokers" >&2
  table --out "$t/table-noinv" --configs linux/amd64 --no-invokers || return 1
  cp -a "$work" "$t/mod-noinv"
  rm -rf "$t/mod-noinv/gotable"
  (cd "$root" && REPR_GO_EXE=$(host_exe) bin/repr-go print "$t/table-noinv/go/arbace/gotable.ae" "$t/mod-noinv/gotable") > "$t/print.log" 2>&1 \
    || { tail "$t/print.log" >&2; return 1; }
  cp "$t/table-noinv/go/arbace/gotable/"*.edn.z "$t/mod-noinv/gotable/"
  echo "== linked with the table, without invokers" >&2
  link "$t/mod-noinv" "$t/noinv" || { tail "$t/build.log" >&2; return 1; }
  echo "== linked as built" >&2
  link "$work" "$t/full" || { tail "$t/build.log" >&2; return 1; }
  full=$(stat -c %s "$t/full"); none=$(stat -c %s "$t/none"); noinv=$(stat -c %s "$t/noinv")
  echo "goi table --size: the executable $full bytes (linked without the image of prepared namespaces); without the table $none (the table: $((full - none)) bytes);"
  echo "goi table --size: with the table but no typed invokers $noinv (the invokers: $((full - noinv)) bytes)"
}

# run_exe: the executable that interprets Go forms (GOI_RUN_EXE, else the build's), built when missing
run_exe() {
  local exe=${GOI_RUN_EXE:-$root/target/arbace-go/amd64/arbace}
  # GT8.3, GTS206 (a): with ARBACE_COVER_DIR (and no GOI_RUN_EXE) the cover build's executable, each program's
  # run with its GOCOVERDIR (check_one, check_dir, check_err; not in run_env, which gc's reference runs share and
  # gc_ref's key hashes, review 182 L1), ARBACE_COVER_DIR/goi/ID
  if [ -n "${ARBACE_COVER_DIR:-}" ] && [ -z "${GOI_RUN_EXE:-}" ]; then
    exe=$(cover_exe "$root") || return 1
  fi
  if [ ! -x "$exe" ]; then
    echo "bin/goi: no executable $exe (bin/arbace-go --build)" >&2
    return 1
  fi
  echo "$exe"
}

# gc_env: Go's environment for gc's builds of printed forms (TamaGo's go1.27.1, GOPATH mode)
gc_env() {
  echo GOROOT="$goroot" GOTOOLCHAIN=local GOFLAGS= GO111MODULE=off GOPROXY=off GOEXPERIMENT= CGO_ENABLED=0 \
    GOOS=linux GOARCH=amd64 GOAMD64=v1 GOCACHE="${GOI_GOCACHE:-$(env GOROOT="$goroot" "$goroot/bin/go" env GOCACHE)}"
}

# run_env: the environment Go's test driver gives a run test's program (cmd/internal/testdir's runcmd:
# STDLIB_IMPORTCFG, the importcfg of std's export files it lists as $gcwork/importcfg is listed, GOENV=off and
# GOFLAGS=; and the go command that runs the driver puts GOROOT/bin first on PATH), for gc's reference run and
# goi's and the AOT program's alike: a program that runs the go command runs $goroot's, not the host's, and
# one that reads STDLIB_IMPORTCFG finds it (fixedbugs/bug369.go: without it gc's own run failed, "open : no
# such file or directory", skipped since gc_ref_fails). In gc_ref's key by its definition
run_env() {
  echo STDLIB_IMPORTCFG="$gcwork/importcfg" GOENV=off GOFLAGS= PATH="$goroot/bin:$PATH"
}

# stderr_head FILE: stderr up to the first line that starts with "goroutine " (§11.1), the
# addresses of a [signal ...] line normalized
stderr_head() {
  awk '/^goroutine /{exit} {print}' "$1" | sed -E 's/^\[signal ([A-Z]+): (.*) code=0x[0-9a-f]+ addr=0x[0-9a-f]+ pc=0x[0-9a-f]+\]$/[signal \1: \2 code=X addr=X pc=X]/'
}

# run_tests [--gc] [--regen]: goi's interpreter tests, test/goi/run/go/t/NAME.ae: each program run
# by bin/goi run, its standard output, standard error (up to the goroutines' traces) and exit
# status against NAME.out, NAME.err, NAME.exit; --gc builds each with gc (printed by repr/go)
# and requires gc's to be them too; --regen writes them from gc's run
run_tests() {
  local gc="" regen="" exe t n f pass=0 failn=0 st
  for a in "$@"; do case $a in --gc) gc=1 ;; --regen) regen=1; gc=1 ;; esac; done
  exe=$(run_exe) || return 1
  t=$root/.tmp/goi-test/run
  mkdir -p "$t"
  for f in "$root"/test/goi/run/go/t/*.ae; do
    n=$(basename "$f" .ae)
    if [ -n "$gc" ]; then
      rm -rf "$t/$n.gc"; mkdir -p "$t/$n.gc"
      (cd "$root" && bin/repr-go print "$f" "$t/$n.gc/src") > "$t/$n.gc/print.log" 2>&1 \
        || { echo "goi test: printing $n failed" >&2; failn=$((failn + 1)); continue; }
      # the program's forms directory: its embedded files (go:embed, GS14), beside the Go file
      [ -d "${f%.ae}" ] && cp -R "${f%.ae}/." "$t/$n.gc/src/"
      (cd "$t/$n.gc/src" && env $(gc_env) "$goroot/bin/go" build -o ../exe .) > "$t/$n.gc/build.log" 2>&1 \
        || { echo "goi test: gc's build of $n failed: $(head -3 "$t/$n.gc/build.log")" >&2; failn=$((failn + 1)); continue; }
      st=0; (cd "$goroot/test" && timeout 60 "$t/$n.gc/exe" > "$t/$n.gc/out" 2> "$t/$n.gc/err.raw") || st=$?
      echo $st > "$t/$n.gc/exit"
      stderr_head "$t/$n.gc/err.raw" > "$t/$n.gc/err"
      if [ -n "$regen" ]; then
        cp "$t/$n.gc/out" "${f%.ae}.out"; cp "$t/$n.gc/err" "${f%.ae}.err"; cp "$t/$n.gc/exit" "${f%.ae}.exit"
      elif ! cmp -s "$t/$n.gc/out" "${f%.ae}.out" || ! cmp -s "$t/$n.gc/err" "${f%.ae}.err" || ! cmp -s "$t/$n.gc/exit" "${f%.ae}.exit"; then
        echo "goi test: gc's run of $n differs from its expected output (bin/goi test --regen)" >&2; failn=$((failn + 1)); continue
      fi
    fi
    st=0; (cd "$goroot/test" && timeout 60 "$exe" -m arbace.go.run "$root/test/goi/run" "go.t.$n" > "$t/$n.out" 2> "$t/$n.err.raw") || st=$?
    echo $st > "$t/$n.exit"
    stderr_head "$t/$n.err.raw" > "$t/$n.err"
    if cmp -s "$t/$n.out" "${f%.ae}.out" && cmp -s "$t/$n.err" "${f%.ae}.err" && cmp -s "$t/$n.exit" "${f%.ae}.exit"; then
      pass=$((pass + 1))
    else
      failn=$((failn + 1))
      echo "goi test: $n differs (status $st, expected $(cat "${f%.ae}.exit")):" >&2
      diff "${f%.ae}.out" "$t/$n.out" | head -20 >&2 || true
      diff "${f%.ae}.err" "$t/$n.err" | head -10 >&2 || true
    fi
  done
  echo "goi test: the interpreter's programs (test/goi/run): $pass passed, $failn failed"
  # Go forms at the REPL (test/goi/repl.ae, its package on ARBACE_PATH: test/goi/repl-pkgs)
  st=0
  ARBACE_PATH=$root/test/goi/repl-pkgs${ARBACE_PATH:+:$ARBACE_PATH} "$exe" "$root/test/goi/repl.ae" > "$t/repl.txt" 2>&1 || st=$?
  tail -1 "$t/repl.txt"
  [ "$st" = 0 ] || { grep -v '^goi repl:' "$t/repl.txt" | head -40 >&2; failn=$((failn + 1)); }
  # every user std package importable at the REPL (GR8a: test/goi/std.ae), the packages out of
  # scope and internal ones refused
  st=0
  "$exe" "$root/test/goi/std.ae" > "$t/std.txt" 2>&1 || st=$?
  tail -1 "$t/std.txt"
  [ "$st" = 0 ] || { grep -v '^goi std:' "$t/std.txt" | head -40 >&2; failn=$((failn + 1)); }
  # GOI-SPEC.md §1.4's session typed at the REPL (GR5), against its transcript
  "$exe" < "$root/test/goi/session.in" 2>&1 | sed -e '1s/^Arbace [^ ]* ([0-9a-f]\{7\})$/Arbace DESCRIBE (HASH)/' > "$t/session.out"
  if cmp -s "$t/session.out" "$root/test/goi/session.expected"; then
    echo "goi test: §1.4's session (test/goi/session.in): as its transcript"
  else
    echo "goi test: §1.4's session (test/goi/session.in) differs from test/goi/session.expected:" >&2
    diff "$root/test/goi/session.expected" "$t/session.out" | head -20 >&2 || true
    failn=$((failn + 1))
  fi
  [ "$failn" = 0 ]
}

# action_of GOFILE: the test driver's action line of a $GOROOT/test program (cmd/internal/testdir:
# the first non-empty line that is not a build constraint, without the //)
action_of() {
  awk 'NF==0{next} /^\/\/go:build/{next} /^\/\/ \+build/{next} {sub(/^\/\/ ?/, ""); print; exit}' "$1"
}

# forms_rel PROGRAM: where repr/go puts a program's forms, relative to go/test/ and without the
# extension: the namespace's path, each segment's . and - munged to _ (arbace.repr.go/program-ns:
# typeparam/dictionaryCapture-noinline.go is typeparam/dictionaryCapture_noinline.ae; report 060,
# finding 1: the file spelled like the Go file was never found, and the program was left out of the check)
forms_rel() { local r=${1%.go}; printf '%s' "${r//[.-]/_}"; }

# action_words ACTION: the action line's words as Go's test driver splits them (cmd/internal/testdir's
# splitQuoted: quotes '...' and "..." group words and are dropped), one per line
action_words() {
  printf '%s\n' "$1" | xargs printf '%s\n'
}

# gc_ref PROGRAM FORMS TMO: gc's reference for a run program (RPS12, doc/FULL-SUPPORT-SURVEY.md
# "As built: REAP2"): the original's files (FORMS's go/package :files) built by gc as Go's test
# driver builds them (go build in the program's directory, GOPATH mode, the caller's build flags
# bflags), run in $GOROOT/test with the caller's args (three times TMO), its exit status, standard
# output and standard error up to the goroutines' traces; GOLDEN, whether gc's output (standard
# output then error) is the test's golden .out (ok, differs, or none). Cached in
# .tmp/goi-check/gcref by the original files', the flags', the arguments' and the toolchain's
# hashes, and stderr_head's definition (report 002, finding 8: the error cached is normalized by it). Sets ref; returns 1 (and prints the program's error line) when gc's build fails or its
# run times out
# ref_commit TMP REF MARKER (GTS35 (a), doc/GATE-SURVEY.md, "As built: GT5"): a reference made in
# its own temporary TMP renamed to REF once complete (MARKER, a file of it, written last: what a reader
# asks for); a REF without its marker (an older run killed while writing) is replaced; one another job
# completed first stays, TMP dropped
ref_commit() {
  [ -d "$2" ] && [ ! -f "$2/$3" ] && rm -rf "${2:?}"
  mv -T "$1" "$2" 2>"$1.mv.err" || rm -rf "${1:?}"
  rm -f "$1.mv.err"
}

gc_ref() {
  local p=$1 f=$2 tmo=$3 g=$goroot/test/$1 files=() x key gst
  for x in $(sed -n 's/^ *:files \[\(.*\)\]$/\1/p' "$f" | tr -d '"'); do files+=("$x"); done
  [ ${#files[@]} -gt 0 ] || files=("$(basename "$p")")
  key=$( { cat "$goroot/VERSION"; for x in "${files[@]}"; do echo "$x"; cat "$(dirname "$g")/$x"; done
           echo "flags:"; printf '%s\n' ${bflags[@]+"${bflags[@]}"}; echo "args:"; printf '%s\n' ${args[@]+"${args[@]}"}
           declare -f stderr_head run_env; } | sha256sum | cut -c1-24)
  ref=$gcwork/gcref/$key
  [ -f "$ref/exit" ] && return 0
  rt=$ref.tmp.$$; rm -rf "$rt"; mkdir -p "$rt"
  if ! (cd "$(dirname "$g")" && env $(gc_env) "$goroot/bin/go" build ${bflags[@]+"${bflags[@]}"} -o "$rt/exe" "${files[@]}") > "$rt/build.log" 2>&1; then
    printf '%s\terror\tgc reference: the original'"'"'s build failed: %s\n' "$p" "$(head -1 "$rt/build.log" | cut -c1-200)"; rm -rf "$rt"; return 1
  fi
  gst=0; (cd "$goroot/test" && export $(run_env) && limited $((tmo * 3)) "$rt/exe" ${args[@]+"${args[@]}"} > "$rt/out" 2> "$rt/err.raw" < "$empty") || gst=$?
  # a reference that timed out is no reference (GT6: it was cached as gc's status 124 and judged every later run)
  case $gst in 124|137|152) rm -rf "$rt"; printf '%s\terror\tgc reference: the original timed out\n' "$p"; return 1 ;; esac
  stderr_head "$rt/err.raw" > "$rt/err"
  echo $gst > "$rt/exit"
  if [ -f "$goroot/test/${p%.go}.out" ]; then
    if cat "$rt/out" "$rt/err.raw" | cmp -s - "$goroot/test/${p%.go}.out"; then echo ok; else echo differs; fi > "$rt/golden"
  else
    echo none > "$rt/golden"
  fi
  rm -f "$rt/exe"
  ref_commit "$rt" "$ref" exit
}

# gc_ref_fails REF: why gc's own run, the reference REF (gc_ref's), does not pass the test as Go's
# test driver runs a run test (status 0, its standard output and error the golden .out, or nothing
# without one), or nothing. A golden "differs" with both streams written is taken as passing: the
# driver reads one combined stream, gc_ref two, so their interleaving is not known
gc_ref_fails() {
  local st golden
  st=$(cat "$1/exit"); golden=$(cat "$1/golden" 2>/dev/null || echo none)
  if [ "$st" != 0 ]; then
    echo "status $st"
  elif [ "$golden" = differs ] && { [ ! -s "$1/out" ] || [ ! -s "$1/err.raw" ]; }; then
    echo "its output differs from the golden .out"
  elif [ "$golden" = none ] && { [ -s "$1/out" ] || [ -s "$1/err.raw" ]; }; then
    echo "it writes output and the test has no golden .out"
  fi
}

# aot_build ROOT OUT LOG [FLAG...]: the program of the forms root ROOT built by arbace.build.go
# (bin/build-go, RPS17: the lines layout, FLAGs passed to go build) into OUT, on the tools' host;
# the printed packages cached in .tmp/goi-check/aot/print-cache (by the host's and the forms' hashes)
aot_build() {
  local src=$1 out=$2 log=$3 fl gf=()
  shift 3
  for fl in "$@"; do gf+=(--go-flag "$fl"); done
  (cd "$root" && REPR_GO_EXE=$hexe bin/build-go --layout lines ${gf[@]+"${gf[@]}"} --print-cache "$cwork/print-cache" \
     -o "$out" --work "$out.work" "$src") > "$log" 2>&1
  local s=$?
  rm -rf "$out.work"
  return $s
}

# action_parse PROGRAM: PROGRAM's action line (action_of) as check_one runs it: sets the caller's tmo (-t, then
# test/goi/timeouts.txt's), bflags (at --aot the action's flags, go build's: RPS17) and args (bash's dynamic
# scope: the caller declares them local), each from its default; returns 1 with the caller's why the line to
# print after the id (RESULT<TAB>REASON) when the program is not run so. Review 001, finding 8: check_one's
# controls build their reference with its own action's flags and arguments, not the subject's
action_parse() {
  local p=$1 act x w=()
  tmo=10 bflags=() args=()
  act=$(action_of "$goroot/test/$p")
  if [ -n "${aot:-}" ] || [[ $act == *[\'\"]* ]]; then
    # the action's words as the test driver splits them, its flags go build's (RPS17); at the
    # interpreted level too when it quotes (a flag's value with spaces, -gcflags='all=-N -l')
    x=$(action_words "$act" 2>&1) || { why="error	the action cannot be split: $act"; return 1; }
    while IFS= read -r x; do w+=("$x"); done <<< "$x"
    set -- "${w[@]}"
  else
    set -- $act
  fi
  shift
  while [ $# -gt 0 ] && [ "${1#-}" != "$1" ]; do
    case $1 in
      -t) tmo=$2; shift 2 ;;
      -goexperiment|-godebug) why="skip	the action sets ${1#-}: $act"; return 1 ;;
      # go build's flags (-gcflags, -ldflags, -tags): at --aot the program's build's (RPS17); at the
      # interpreted level gc's reference's alone (gc_ref), goi running the program as written (GOI-SPEC.md
      # "Since v1: gc's flags of run actions"): they choose gc's code generation (checkptr's
      # instrumentation, inlining, softfloat, the SSA checks, the linker's), not what the program prints,
      # and a program whose output does depend on them is a known difference in its own class
      *) bflags+=("$1"); shift ;;
    esac
  done
  # a program's own limit (test/goi/timeouts.txt), where the default is too short for it
  tmo=$(program_tmo "$p" "$tmo")
  args=("$@")
}

# check_one PROGRAM: one program of the check (§11.1): gc's reference (the original built by gc
# and run, gc_ref: RPS12, since REAP2; until then the forms printed by repr/go and built) and goi's
# run (bin/goi run, program mode), or with --aot (REAP2) the forms built by arbace.build.go
# (aot_build) and run; compared: exit status, standard output byte for byte, standard error up to
# the goroutines' traces. Prints PROGRAM<TAB>RESULT<TAB>REASON.
check_one() {
  local id=$1 p=$1 g f args=() bflags=() tmo=10 ns ref r rc st reason x c refp rf why
  g=$goroot/test/$p
  f=$cforms/go/test/$(forms_rel "$p").ae
  [ -f "$f" ] || { printf '%s\terror\tno forms (%s)\n' "$id" "${f#$root/}"; return; }
  action_parse "$p" || { printf '%s\t%s\n' "$id" "$why"; return; }
  ns=$(sed -n '1s/^(ns \([^ )]*\).*/\1/p' "$f")
  # no reference (gc's build failed, its run timed out): its row printed by gc_ref, and the job's status 0
  # (report 002, finding 2: a status 1 made xargs exit 123, and check's pipeline under errexit ended
  # bin/goi before the retry, the counts and the regression comparison)
  gc_ref "$p" "$f" "$tmo" || return 0
  # gc's own run must pass the test as Go's test driver runs it, else there is nothing to judge goi
  # against (report 002, finding 5; check_err skips likewise on gc's errors); its controls are then not
  # printed (controls_judged: not judged, its subject skip)
  x=$(gc_ref_fails "$ref")
  [ -z "$x" ] || { printf '%s\tskip\tgc'"'"'s own run does not pass here: %s\n' "$id" "$x"; return; }
  r=$cwork/run/$id
  mkdir -p "$(dirname "$r")"
  st=0
  if [ -n "${bundle:-}" ]; then
    # the run written for a box elsewhere (GC76): its input and gc's console
    mkdir -p "$(dirname "$bundle/in/$p")" "$(dirname "$bundle/want/$p")"
    box_input "$cforms" "$ns" "${f#$cforms/}" ${args[@]+"${args[@]}"} > "$bundle/in/$p.in"
    cat "$ref/out" "$ref/err" > "$bundle/want/$p.want"
    printf '%s\tbundled\t%s %s one\n' "$id" "$((tmo + ${GOI_BOX_TIMEOUT:-60}))" "$(cat "$ref/exit")"; return
  fi
  if [ -n "${aot:-}" ]; then
    # the program's package file and its forms directory, alone in a forms root
    rm -rf "$r.src" "$r.exe"; mkdir -p "$(dirname "$r.src/go/test/$(forms_rel "$p")")"
    cp "$f" "$r.src/go/test/$(forms_rel "$p").ae"
    [ -d "${f%.ae}" ] && cp -R "${f%.ae}" "$r.src/go/test/$(forms_rel "$p")"
    if ! aot_build "$r.src" "$r.exe" "$r.build.log" ${bflags[@]+"${bflags[@]}"}; then
      printf '%s\terror\tthe AOT build failed: %s\n' "$id" "$(grep -v '^$' "$r.build.log" | head -2 | tr '\n' ' ' | cut -c1-240)"; return
    fi
    (cd "$goroot/test" && export $(run_env) && limited "$tmo" "$r.exe" ${args[@]+"${args[@]}"} > "$r.out" 2> "$r.err.raw" < "$empty") || st=$?
    rm -rf "$r.exe" "$r.src"
  elif [ -n "${box:-}" ]; then
    box_run "$cforms" "$tmo" "$ns" "${f#$cforms/}" ${args[@]+"${args[@]}"} > "$r.out" 2> "$r.err.raw" || st=$?
  else
    (cd "$goroot/test" && export $(run_env) && { [ -z "${ARBACE_COVER_DIR:-}" ] || export $(cover_env goi "$p"); } && limited "$tmo" "$rexe" -m arbace.go.run "$cforms" "$ns" ${args[@]+"${args[@]}"} > "$r.out" 2> "$r.err.raw" < "$empty") || st=$?
    cover_settle goi "$p"
  fi
  stderr_head "$r.err.raw" > "$r.err"
  case $st in
    # goi's own refusals (arbace.go.run: status 125 or 126 with its goi: line), not a program's
    # os.Exit(125) or os.Exit(126), compared with gc's (report 002, finding 9)
    125) [ -z "${aot:-}" ] && grep -q '^goi: unsupported: ' "$r.err.raw" && { printf '%s\tunsupported\t%s\n' "$id" "$(sed -n 's/^goi: unsupported: //p' "$r.err.raw" | head -1)"; return; } ;;
    126) [ -z "${aot:-}" ] && grep -q '^goi: error: ' "$r.err.raw" && { printf '%s\terror\t%s\n' "$id" "$(sed -n 's/^goi: error: //p' "$r.err.raw" | head -1 | cut -c1-300)"; return; } ;;
    124|137|152) printf '%s\terror\ttimeout (%s s)\n' "$id" "$tmo"; return ;;
  esac
  if [ -n "${box:-}" ]; then
    # the box's console: TamaGo writes a Go program's file descriptors 1 and 2 to it, and the
    # board sends it to the launcher's standard error (GC35): the streams compared as one, gc's
    # standard output then its standard error
    cat "$r.out" "$r.err.raw" > "$r.all.raw"; stderr_head "$r.all.raw" > "$r.all"
    cat "$ref/out" "$ref/err" > "$r.gc-all"
    if [ "$st" = "$(cat "$ref/exit")" ] && cmp -s "$r.all" "$r.gc-all"; then
      printf '%s\tpass\t\n' "$id"
    else
      printf '%s\tfail\tstatus %s (gc %s)%s\n' "$id" "$st" "$(cat "$ref/exit")" \
        "$(cmp -s "$r.all" "$r.gc-all" || printf ', the console differs: %s' "$(diff "$r.gc-all" "$r.all" | grep '^[<>]' | head -2 | tr '\n' ' ' | cut -c1-200)")"
    fi
    return
  fi
  run_verdict "$id" "$st" "$r" "$ref"
  # GTS81 (a), GTS86 (b): the negative controls whose subject this program is (test/goi/controls.txt): this
  # run judged again, by run_verdict, against the reference's gc run (gc_ref's, cached with its own entry: the
  # reference's own action, flags, arguments and limit, action_parse's, review 001, finding 8), under the
  # control's id; no run or build of its own. The loop is a pipeline's subshell: action_parse's tmo, bflags
  # and args, and gc_ref's ref (it sets check_one's local ref, the reference's directory), change there
  # alone, so that the subject's are untouched after it, and run_verdict reads the reference's ref
  controls_of "$p" | while read -r c refp; do
    rf=$cforms/go/test/$(forms_rel "$refp").ae
    [ -f "$rf" ] || { printf '%s\terror\tno forms of its reference (%s)\n' "$c" "${rf#$root/}"; continue; }
    action_parse "$refp" || { printf '%s\terror\tits reference is not run: %s\n' "$c" "$(printf '%s' "$why" | tr '\t' ' ')"; continue; }
    gc_ref "$refp" "$rf" "$tmo" > "$r.cref" || { printf '%s\terror\t%s\n' "$c" "$(cut -f3 "$r.cref")"; continue; }
    # the reference's gc run must pass its own test, as the subject's must (report 002, finding 5): else the
    # control is not judged (an error row: controls_judged fails the check while the subject passes), not
    # failed for free against a broken reference
    x=$(gc_ref_fails "$ref")
    [ -z "$x" ] || { printf '%s\terror\tits reference'"'"'s gc run does not pass here: %s\n' "$c" "$x"; continue; }
    run_verdict "$c" "$st" "$r" "$ref"
  done
  rm -f "$r.cref"
}

# run_verdict ID ST R REF: a program's run (status ST, R.out, R.err: check_one's) against gc's (REF: gc_ref's
# exit, out, err): ID<TAB>pass, or fail and the reason
run_verdict() {
  local id=$1 st=$2 r=$3 rd=$4 reason
  if [ "$st" = "$(cat "$rd/exit")" ] && cmp -s "$r.out" "$rd/out" && cmp -s "$r.err" "$rd/err"; then
    printf '%s\tpass\t\n' "$id"
  else
    reason="status $st (gc $(cat "$rd/exit"))"
    cmp -s "$r.out" "$rd/out" || reason="$reason, stdout differs"
    cmp -s "$r.err" "$rd/err" || reason="$reason, stderr differs: $(diff "$rd/err" "$r.err" | grep '^[<>]' | head -2 | tr '\n' ' ' | cut -c1-200)"
    printf '%s\tfail\t%s\n' "$id" "$reason"
  fi
}

# controls_of SUBJECT: GTS81 (a), GTS85 (b), GTS86 (b): the negative controls of this run's level (interp; aot
# with --aot) whose subject SUBJECT is (test/goi/controls.txt), ID REFERENCE a line; none in the box's runs
controls_of() {
  [ -z "${box:-}" ] || return 0
  awk -v l="$([ -n "${aot:-}" ] && echo aot || echo interp)" -v s="$1" '!/^#/ && NF == 4 && $1 == l && $3 == s { print $2, $4 }' "$root/test/goi/controls.txt"
}

# controls_judged LEVEL RESULTS: GTS81 (a): each negative control of LEVEL (interp, aot; test/goi/controls.txt)
# in RESULTS (the checkers' lines): fail is a control's result (its subject's run, errors or output against
# another program's gc run, // ERROR comments or golden output); pass, or another result while its subject
# passes, a problem (status 1); a subject not in the run (GTS86 (b): the control is its run judged twice) is a
# problem too, but left in a selection (--only, --list); printed
controls_judged() {
  local lv=$1 res=$2 bad=0 c sub r rest
  awk -v l="$lv" '!/^#/ && NF == 4 && $1 == l' "$root/test/goi/controls.txt" > "$res.controls"
  while read -r _ c sub _; do
    r=$(awk -F'\t' -v c="$c" '$1 == c { print $2 "\t" $3; exit }' "$res")
    rest=$(awk -F'\t' -v c="$sub" '$1 == c { print $2; exit }' "$res")
    case ${r%%	*} in
      fail) echo "   control $c ($sub judged against another program's reference): fail, as a control must" ;;
      pass) echo "   control passed: $c: the check's comparison passes what differs"; bad=1 ;;
      *) if [ -z "$rest" ] && [ -n "${only:-}${listf:-}" ]; then echo "   control $c: left, its subject $sub not in this run (--only or --list)"
         elif [ -z "$rest" ]; then echo "   control not judged: $c: its subject $sub not in this run"; bad=1
         elif [ "$rest" = pass ]; then echo "   control not judged: $c: ${r:-no result} (its subject passes)"; bad=1
         else echo "   control $c: not judged (${r:-no result}), its subject $rest"; fi ;;
    esac
  done < "$res.controls"
  rm -f "$res.controls"
  return $bad
}

# aot_dir_root ROOT MAIN: a directory test's forms, copied into the forms root ROOT, made a module
# for arbace.build.go (RPS11, REAP2): the main package MAIN (its package file, relative to ROOT)
# the only main one; under Go's test driver's rundir the packages' paths are the driver's -D
# prefix's (test/a for "./a": the forms' :local-imports) and the main package's main, so the module
# is test, the main package at its root and every local import ("./a") printed as the path it
# resolves to (test/a); under runindir the module is the directory's name, the forms' paths
# already. program.edn's go line is the main package's language version (runindir's go.mod's).
# A package's other files (assembly: :other-files) are copied from the test's directory ORIG,
# where the converter left them; a package's files named *_test.go, which Go's test driver compiles
# as any other and go build leaves out, are renamed *_test_.go
aot_dir_root() {
  python3 -I -c '
import os, re, sys
root, main, orig = sys.argv[1:4]
files = []
for d, _, fs in os.walk(root):
    for x in sorted(fs):
        if x.endswith(".ae"): files.append(os.path.join(d, x))
text = {f: open(f, encoding="utf-8").read() for f in files}
pkg = {f: t for f, t in text.items() if re.search(r"^\(go/package ", t, re.M)}
mainf = os.path.join(root, main)
for f, t in list(pkg.items()):
    if f != mainf and re.search(r"^\(go/package main\b", t, re.M):
        os.remove(f); del pkg[f]; del text[f]
local = {}
import shutil
for f, t in pkg.items():
    m = re.search(r"^  :other-files \[(.*)\]$", t, re.M)
    if not m: continue
    others = re.findall(r"\"([^\"]*)\"", m.group(1))
    gofiles = re.findall(r"\"([^\"]*)\"", re.search(r"^  :files \[(.*)\]$", t, re.M).group(1))
    src = next((d for d, _, fs in os.walk(orig) if all(x in fs for x in others + gofiles)), None)
    if src is None: sys.exit("no directory of %s holds %s" % (orig, " ".join(others + gofiles)))
    for x in others: shutil.copyfile(os.path.join(src, x), os.path.join(f[:-3], x))
ren = lambda t: re.sub(r"\"([^\"/]*)_test\.go\"", lambda m: "\"%s_test_.go\"" % m.group(1), t)
for f in list(text):
    t = text[f]
    if f in pkg:
        t = re.sub(r"^  :files \[.*\]$", lambda m: ren(m.group(0)), t, flags=re.M)
    else:
        t = re.sub(r"^(\(in-ns [^)]*\) )?\(go/file \"[^\"]*\"", lambda m: ren(m.group(0)), t, flags=re.M)
    text[f] = t
for t in pkg.values():
    m = re.search(r"^  :local-imports \{(.*)\}$", t, re.M)
    if m:
        kv = re.findall(r"\"((?:[^\"\\]|\\.)*)\"", m.group(1))
        local.update(zip(kv[0::2], kv[1::2]))
mt = text[mainf]
mpath = re.search(r"^  :path \"([^\"]*)\"", mt, re.M).group(1)
lang = re.search(r":lang \"go([0-9.]+)\"", mt)
module = "test" if mpath == "main" else mpath
if mpath == "main":
    text[mainf] = re.sub(r"^  :path \"main\"", "  :path \"test\"", mt, count=1, flags=re.M)
def imports(t):
    # the :imports vectors of the go/file forms: their local paths resolved
    out, i = [], 0
    for m in re.finditer(r":imports \[", t):
        if m.start() < i: continue
        j, depth = m.end(), 1
        while depth:
            c = t[j]
            if c == "\"":
                j += 1
                while t[j] != "\"": j += 2 if t[j] == "\\" else 1
            elif c == "[": depth += 1
            elif c == "]": depth -= 1
            j += 1
        seg = re.sub(r"\"(\./[^\"]*)\"", lambda s: "\"%s\"" % local.get(s.group(1), s.group(1)), t[m.end():j])
        out.append(t[i:m.end()]); out.append(seg); i = j
    out.append(t[i:])
    return "".join(out)
for f, t in text.items():
    t2 = imports(t) if f not in pkg else t
    if t2 != open(f, encoding="utf-8").read(): open(f, "w", encoding="utf-8").write(t2)
with open(os.path.join(root, "program.edn"), "w", encoding="utf-8") as o:
    o.write("{:module \"%s\"%s}\n" % (module, " :go \"%s\"" % lang.group(1) if lang else ""))
print(module)
' "$1" "$2" "$3"
}

# check_dir PROGRAM: one directory test of the check (§11.2, GR4): its action rundir,
# buildrundir or runindir, its packages the forms of PROGRAM's directory (repr/go's corpus
# linux-dirtest), the main package's run by bin/goi run, or with --aot (REAP2, RPS11) the
# packages made a module (aot_dir_root) built by arbace.build.go and run, against the test's
# golden output (the driver's: standard output and error combined, status 0; the round trip's
# level run checks that the printed forms give it under gc). Prints PROGRAM<TAB>RESULT<TAB>REASON.
check_dir() {
  local p=$1 g=$goroot/test/$1 base f c act ns st tmo=10 r want w=() gfl=() lfl=() bflags=() x kind
  act=$(action_of "$g")
  kind=${act%% *}
  if [ -n "${aot:-}" ]; then
    x=$(action_words "$act" 2>&1) || { printf '%s\terror\tthe action cannot be split: %s\n' "$p" "$act"; return; }
    while IFS= read -r x; do w+=("$x"); done <<< "$x"
    set -- "${w[@]}"
  else
    set -- $act
  fi
  shift
  while [ $# -gt 0 ] && [ "${1#-}" != "$1" ]; do
    case $1 in
      -t) tmo=$2; shift 2 ;;
      -gomodversion) shift 2 ;;
      -goexperiment|-godebug) printf '%s\tskip\tthe action sets %s: %s\n' "$p" "${1#-}" "$act"; return ;;
      *) if [ -n "${aot:-}" ]; then
           # rundir's flags are the compiler's, those after -ldflags the linker's (the driver's
           # split); runindir's and buildrundir's go run's
           if [ "$kind" = rundir ]; then
             if [ "$1" = -ldflags ] || [ ${#lfl[@]} -gt 0 ]; then lfl+=("$1"); else gfl+=("$1"); fi
           else
             bflags+=("$1")
           fi
           shift
         else
           # gc's flags, not the program's: the golden output is the reference (action_parse's note)
           shift
         fi ;;
    esac
  done
  tmo=$(program_tmo "$p" "$tmo")
  base=$dforms/go/test/$(forms_rel "$p")_dir
  f=""
  for c in "$base.ae" "$base"/*.ae; do
    if [ -f "$c" ] && grep -q '^(go/package main' "$c"; then f=$c; break; fi
  done
  [ -n "$f" ] || { printf '%s\terror\tno forms of a main package (%s)\n' "$p" "${base#$root/}"; return; }
  ns=$(sed -n '1s/^(ns \([^ )]*\).*/\1/p' "$f")
  r=$cwork/run/$p
  mkdir -p "$(dirname "$r")"
  st=0
  want=$goroot/test/${p%.go}.out
  if [ -n "${bundle:-}" ]; then
    mkdir -p "$(dirname "$bundle/in/$p")" "$(dirname "$bundle/want/$p")"
    box_input "$dforms" "$ns" "${f#$dforms/}" "${base#$dforms/}" "${base#$dforms/}.ae" > "$bundle/in/$p.in"
    if [ -f "$want" ]; then cp "$want" "$bundle/want/$p.want"; else : > "$bundle/want/$p.want"; fi
    printf '%s\tbundled\t%s 0 dir\n' "$p" "$((tmo + ${GOI_BOX_TIMEOUT:-60}))"; return
  fi
  if [ -n "${aot:-}" ]; then
    rm -rf "$r.src" "$r.exe"; mkdir -p "$(dirname "$r.src/${base#$dforms/}")"
    [ -f "$base.ae" ] && cp "$base.ae" "$r.src/${base#$dforms/}.ae"
    [ -d "$base" ] && cp -R "$base" "$r.src/${base#$dforms/}"
    local module
    module=$(aot_dir_root "$r.src" "${f#$dforms/}" "$goroot/test/${p%.go}.dir" 2> "$r.root.log") \
      || { printf '%s\terror\tthe module of the directory'"'"'s forms: %s\n' "$p" "$(tail -1 "$r.root.log" | cut -c1-200)"; return; }
    [ ${#gfl[@]} -gt 0 ] && bflags+=("-gcflags=$module/...=${gfl[*]}")
    [ ${#lfl[@]} -gt 1 ] && bflags+=("-ldflags=${lfl[*]:1}")
    if ! aot_build "$r.src" "$r.exe" "$r.build.log" ${bflags[@]+"${bflags[@]}"}; then
      printf '%s\terror\tthe AOT build failed: %s\n' "$p" "$(grep -v '^$' "$r.build.log" | head -2 | tr '\n' ' ' | cut -c1-240)"; return
    fi
    (cd "$goroot/test" && export $(run_env) && limited "$tmo" "$r.exe" > "$r.out" 2>&1 < "$empty") || st=$?
    rm -rf "$r.exe" "$r.src"
  elif [ -n "${box:-}" ]; then
    box_run "$dforms" "$tmo" "$ns" "${f#$dforms/}" "${base#$dforms/}" "${base#$dforms/}.ae" > "$r.out" 2>&1 || st=$?
  else
    (cd "$goroot/test" && export $(run_env) && { [ -z "${ARBACE_COVER_DIR:-}" ] || export $(cover_env goi "$p"); } && limited "$tmo" "$rexe" -m arbace.go.run "$dforms" "$ns" > "$r.out" 2>&1 < "$empty") || st=$?
    cover_settle goi "$p"
  fi
  case $st in
    # goi's own refusals only (with their goi: line; report 002, finding 9)
    125) [ -z "${aot:-}" ] && grep -q '^goi: unsupported: ' "$r.out" && { printf '%s\tunsupported\t%s\n' "$p" "$(sed -n 's/^goi: unsupported: //p' "$r.out" | head -1)"; return; } ;;
    126) [ -z "${aot:-}" ] && grep -q '^goi: error: ' "$r.out" && { printf '%s\terror\t%s\n' "$p" "$(sed -n 's/^goi: error: //p' "$r.out" | head -1 | cut -c1-300)"; return; } ;;
    124|137|152) printf '%s\terror\ttimeout (%s s)\n' "$p" "$tmo"; return ;;
  esac
  dir_verdict "$p" "$st" "$r.out" "$want"
  # GTS85 (b): the controls whose subject this test is: its run against the reference's golden output
  controls_of "$p" | while read -r c x; do dir_verdict "$c" "$st" "$r.out" "$goroot/test/${x%.go}.out"; done
}

# dir_verdict ID ST OUT WANT: a directory test's run (status ST, OUT its output: check_dir's) against the
# golden WANT (none: no output), status 0: ID<TAB>pass, or fail and the reason
dir_verdict() {
  local id=$1 st=$2 out=$3 want=$4
  if [ "$st" = 0 ] && { if [ -f "$want" ]; then cmp -s "$out" "$want"; else [ ! -s "$out" ]; fi; }; then
    printf '%s\tpass\t\n' "$id"
  else
    printf '%s\tfail\tstatus %s, output differs from the golden %s: %s\n' "$id" "$st" "${want#$goroot/}" \
      "$( { if [ -f "$want" ]; then diff "$want" "$out"; else cat "$out"; fi; } | grep -v '^[0-9]' | head -2 | tr '\n' ' ' | cut -c1-200)"
  fi
}

# check_err PROGRAM: one errorcheck program of the check (GR7b, GOI-SPEC.md "As built: GR7b"):
# its action's flags judged first (those of gc's phases goi does not have make it unsupported);
# gc's reference (the original compiled as Go's test driver compiles an errorcheck test, its
# errors judged; cached by the file's, the toolchain's and the judge's hashes: gocmp_key, report
# 002, finding 8) must pass the judge, else the
# program is skipped; then, as gc's front end goes (GP6, doc/go/GO-PARSER-SURVEY.md "As built:
# GP6"): gc's syntax errors (gc's syntax run by goi, $esyntax/PROGRAM.txt) judged when one is a
# syntax error (gc stops after them: noder's checkFiles) or go/parser rejects the file (no tree:
# syntax's errors are all there is); else goi's checker over the forms (arbace.go.run
# --errorcheck, repr/go's conversion, the corpus linux-errtest), or over the raw forms of an
# invalid program the converter cannot convert (--raw, $eraw: the checker's resolve mode, GPS9
# (b)), with gc's front end's errors beside its type checker (--gc-front, GPS39 (b), GPS41 (c):
# gc's syntax's branch checks in place of goi's own, noder's pragmas', and, when there are no
# other errors, the declarations' checks of noder's writer), its errors judged by `gocmp errorcheck` (Go's test driver's judge: every // ERROR line
# matched, no error unmatched, at least one error when the test expects the compilation to
# fail). A program goi fails whose expected errors go/types does not report either (godump's
# :errors empty: they come from gc's phases after type checking) is unsupported. Prints
# PROGRAM<TAB>RESULT<TAB>REASON.
check_err() {
  local p=$1 g=$goroot/test/$1 f act fl tmo=10 want=1 auto="" lang="" maxerr="" goflags=() why="" ns key ref st r types dump reason syn rejected froot=$eforms raw=""
  local mlev=0 nolinl="" escdebug="" d
  act=$(action_of "$g")
  set -- $act
  [ "$1" = errorcheckwithauto ] && auto=-auto
  shift
  while [ $# -gt 0 ] && [ "${1#-}" != "$1" ]; do
    fl=$1; shift
    case $fl in
      -t) tmo=$1; shift ;;
      -0) want="" ;;
      -1) want=1 ;;
      -e|-d=panic) goflags+=("$fl") ;;
      -e=0|-e=false) goflags+=("$fl"); maxerr=10 ;; # gc's limit of 10 errors (GR10)
      -lang=*) lang=${fl#-lang=}; goflags+=("$fl") ;;
      # gc's -m: its inliner's (without -l), escape analysis' and walk's diagnostics, arbace.go.escape
      # (GOI-SPEC.md, "Since v1: gc's escape analysis"); liveness, the write barriers and the SSA
      # back end's passes stay gc's
      -m) mlev=$((mlev + 1)); goflags+=("$fl") ;;
      -m=*) mlev=${fl#-m=}; goflags+=("$fl") ;;
      -l) nolinl=1; goflags+=("$fl") ;;
      -N) goflags+=("$fl") ;;
      -smallframes) escdebug="$escdebug :smallframes true"; goflags+=("$fl") ;;
      -l=*|-live|-wb=*) why=${why:-"$fl: gc's liveness and write barriers (-l=N: its inliner's debugging), which goi does not have"} ;;
      -d=*) for d in $(echo "${fl#-d=}" | tr ',' ' '); do
              case $d in
                escapemutationscalls|escapemutationscalls=*|zerocopy|zerocopy=*|inlfuncswithclosures|inlfuncswithclosures=*)
                  case $d in *=*) escdebug="$escdebug :${d%%=*} ${d#*=}" ;; *) escdebug="$escdebug :$d 1" ;; esac ;;
                *) why=${why:-"-d=$d: gc's debug flags (its SSA back end's passes), which goi does not have"} ;;
              esac
            done
            goflags+=("$fl") ;;
      -race) why=${why:-"-race: gc's race instrumentation, which goi does not have"} ;;
      -std|-+|-complete|-asmhdr*|-spectre*) why=${why:-"$fl: gc compiling the standard library or the runtime, out of goi's scope"} ;;
      -goexperiment) why=${why:-"-goexperiment: another GOEXPERIMENT"}; shift ;;
      *) why=${why:-"$fl: a flag of gc's"} ;;
    esac
  done
  tmo=$(program_tmo "$p" "$tmo")
  # the escape analysis of the imports' forms (their tags, cached in $gcwork/escape-tags): a first run
  # checks and analyzes the standard packages the program's calls reach
  [ "$mlev" = 0 ] || [ "$tmo" -ge 180 ] || tmo=180
  [ -n "$why" ] && { printf '%s\tunsupported\t%s\n' "$p" "$why"; return; }
  # gc's reference: the errors of the original, judged
  key=$( { cat "$goroot/VERSION"; cat "$g"; printf '%s\n' "${goflags[@]}"; echo "judge: ${gocmp_key:-}"; } | sha256sum | cut -c1-24)
  ref=$gcwork/eref/$key
  if [ ! -f "$ref/judge" ]; then
    rt=$ref.tmp.$$; rm -rf "$rt"; mkdir -p "$rt"
    st=0; (cd "$rt" && export $(gc_env) && limited $((tmo * 3)) "$goroot/bin/go" tool compile -p=p -d=panic -C -e \
            -importcfg="$gcwork/importcfg" -o a.o ${goflags[@]+"${goflags[@]}"} -d=ssa/check/on "$g" > out 2>&1 < "$empty") || st=$?
    rm -f "$rt/a.o"
    case $st in 124|137|152) rm -rf "$rt"; printf '%s\terror\tgc reference: the compile timed out\n' "$p"; return ;; esac
    echo $st > "$rt/exit"
    "$gocmp" errorcheck $auto "$g" "$rt/out" > "$rt/judge" 2>&1 || true
    if [ -n "$want" ] && [ "$st" = 0 ]; then echo "fail: compilation succeeded unexpectedly" > "$rt/judge"; fi
    ref_commit "$rt" "$ref" judge
  fi
  if [ "$(head -1 "$ref/judge")" != pass ]; then
    printf '%s\tskip\tgc'"'"'s own errorcheck does not pass here: %s\n' "$p" "$(sed -n 2,3p "$ref/judge" | tr '\t\n' '  ' | cut -c1-200)"; return
  fi
  f=$eforms/go/test/$(forms_rel "$p").ae
  r=$cwork/erun/$p
  mkdir -p "$(dirname "$r")"
  reason=""
  [ -f "$f" ] || reason=$(awk -F'\t' -v k="$p" '$2 == k { print $1 "\t" $7; exit }' "$etsv")
  # gc's syntax errors (GP6): judged alone when one is a syntax error (gc stops after them) or
  # when go/parser rejects the file
  syn=$esyntax/$p.txt rejected=""
  case $reason in fail*) rejected=1 ;; esac
  if [ -f "$syn" ] && { grep -q '^[^:]*:[0-9]*: syntax error' "$syn" || [ -n "$rejected" ]; }; then
    syn_verdict "$p" "$g" "$syn" "$r.judge"
    # GTS85 (b): the controls whose subject this test is: the same errors against the reference's // ERROR comments
    controls_of "$p" | while read -r c x; do syn_verdict "$c" "$goroot/test/$x" "$syn" "$r.${c//\//_}.judge"; done
    return
  fi
  # the checker's positions are the forms' lines, mapped by arbace.go.run through the file's //line
  # directives (GOI-SPEC.md, "Since v1: line directives"); a /*line directive sets a position within a
  # line, which the forms do not keep (gc's syntax's errors above follow both)
  if grep -qE '/\*line ' "$g"; then
    printf '%s\tunsupported\tline directives: gc'"'"'s positions follow /*line directives within a line, goi'"'"'s errors the forms'"'"' lines\n' "$p"; return
  fi
  if [ ! -f "$f" ]; then
    case $reason in
      fail*) printf '%s\terror\tgo/parser rejects it, and no syntax errors of gc'"'"'s (%s)\n' "$p" "${syn#$root/}"; return ;;
      "") printf '%s\terror\tno forms (%s)\n' "$p" "${f#$root/}"; return ;;
    esac
    # an invalid program the converter cannot convert (GC47): its raw forms (GPS9 (b))
    froot=$eraw raw=--raw f=$eraw/go/test/$(forms_rel "$p").ae
    [ -f "$f" ] || { printf '%s\terror\tno raw forms (%s)\n' "$p" "${f#$root/}"; return; }
  fi
  ns=$(sed -n '1s/^(ns \([^ )]*\).*/\1/p' "$f")
  # go/types' errors (godump's): none where gc reports some means gc's later phases; unknown (empty)
  # when the dump is missing or gocmp cannot read it, and then no program is unsupported for it
  # (report 002, finding 6: it was 0, "go/types reports none", never measured)
  dump=$edumps/$p.edn
  types=""
  if [ -f "$dump" ] && "$gocmp" errorcheck -dump-errors "$dump" > "$r.types" 2> "$r.types.err"; then
    types=$(grep -c . "$r.types" || true)
  fi
  st=0; (cd "$goroot/test" && { [ -z "${ARBACE_COVER_DIR:-}" ] || export $(cover_env goi "$p"); } && limited "$tmo" "$rexe" -m arbace.go.run --errorcheck ${lang:+--lang "$lang"} ${maxerr:+--max-errors "$maxerr"} $raw \
    $( [ "$mlev" = 0 ] || echo "--escape $mlev --escape-std $root/.tmp/repr-go/forms/linux-amd64 --escape-cache $gcwork/escape-tags"; [ -n "$nolinl" ] || echo --inline ) \
    ${escdebug:+--escape-debug "{$escdebug}"} --gc-front "$g" "$froot" "$ns" > "$r.out" 2> "$r.err" < "$empty") || st=$?
  cover_settle goi "$p"
  if { [ "$st" = 124 ] || [ "$st" = 137 ] || [ "$st" = 152 ]; } && [ "$types" = 0 ] && [ -n "$want" ]; then
    printf '%s\tunsupported\terrors of gc'"'"'s phases after type checking (go/types reports none; goi'"'"'s check over %s s)\n' "$p" "$tmo"; return
  fi
  case $st in
    125) printf '%s\tunsupported\t%s\n' "$p" "$(sed -n 's/^goi: unsupported: //p' "$r.err" | head -1)"; return ;;
    126) printf '%s\terror\t%s\n' "$p" "$(sed -n 's/^goi: error: //p' "$r.err" | head -1 | cut -c1-300)"; return ;;
    124|137|152) printf '%s\terror\ttimeout (%s s)\n' "$p" "$tmo"; return ;;
    0|1) ;;
    *) printf '%s\terror\tstatus %s: %s\n' "$p" "$st" "$(head -1 "$r.err" | cut -c1-200)"; return ;;
  esac
  # GTS85 (b): the controls whose subject this test is: goi's errors against the reference's // ERROR comments,
  # by err_verdict as the test's own
  controls_of "$p" | while read -r c x; do
    if err_verdict "$goroot/test/$x" "$r.out" "$st" "$r.${c//\//_}.judge"; then printf '%s\tpass\t\n' "$c"
    else printf '%s\tfail\t%s\n' "$c" "$(sed -n 2,3p "$r.${c//\//_}.judge" | tr '\t\n' '  ' | cut -c1-240)"; fi
  done
  err_verdict "$g" "$r.out" "$st" "$r.judge" && { printf '%s\tpass\t\n' "$p"; return; }
  # gc's -m: goi's port's diagnostics are the program's errors (a difference is a fail, a known one
  # test/goi/check-known.edn's)
  if [ "$types" = 0 ] && [ "$st" = 0 ] && [ "$mlev" = 0 ]; then
    printf '%s\tunsupported\terrors of gc'"'"'s phases after type checking (go/types reports none)\n' "$p"; return
  fi
  printf '%s\tfail\t%s\n' "$p" "$(sed -n 2,3p "$r.judge" | tr '\t\n' '  ' | cut -c1-240)"
}

# syn_verdict ID G SYN JUDGE: gc's syntax errors SYN judged against G's // ERROR comments (gocmp errorcheck,
# check_err's auto and want), the judge's words in JUDGE: ID<TAB>pass, or fail and the reason
syn_verdict() {
  if "$gocmp" errorcheck $auto "$2" "$3" > "$4" 2>&1 && { [ -z "$want" ] || [ -s "$3" ]; } && { [ -n "$want" ] || [ ! -s "$3" ]; }; then
    printf '%s\tpass\t\n' "$1"
  else
    printf '%s\tfail\tgc'"'"'s syntax errors: %s\n' "$1" "$(sed -n 2,3p "$4" | tr '\t\n' '  ' | cut -c1-240)"
  fi
}

# err_verdict G OUT ST JUDGE: goi's errors OUT (its status ST: check_err's) judged against G's // ERROR comments
# (gocmp errorcheck, check_err's auto and want: a test that must fail fails with status 1), the judge's words
# in JUDGE: status 0 when they pass
err_verdict() {
  if "$gocmp" errorcheck $auto "$1" "$2" > "$4" 2>&1 && { [ -z "$want" ] || [ "$3" = 1 ]; }; then return 0; fi
  [ -n "$want" ] && [ "$3" = 0 ] && echo "fail: no error (the compilation must fail)" > "$4"
  return 1
}

# err_aot_verdict G OUT ST JUDGE: gc's errors of the printed forms OUT (status ST: check_err_aot's) judged
# against G's // ERROR comments (gocmp errorcheck, its auto and want: compilation fails or succeeds as wanted),
# the judge's words in JUDGE: status 0 when they pass
err_aot_verdict() {
  if "$gocmp" errorcheck $auto "$1" "$2" > "$4" 2>&1 && { [ -z "$want" ] || [ "$3" != 0 ]; } && { [ -n "$want" ] || [ "$3" = 0 ]; }; then return 0; fi
  [ -n "$want" ] && [ "$3" = 0 ] && echo "fail: compilation succeeded unexpectedly" > "$4"
  return 1
}

# check_err_aot PROGRAM: one errorcheck program at the AOT level (REAP2, RPS17): its action's flags
# all gc's, as Go's test driver passes them (its -d=ssa/check/on added to the first -d= or alone;
# -goexperiment's GOEXPERIMENT), gc's reference the original compiled so and judged (cached by the
# file's, the flags', the toolchain's and the judge's hashes, gocmp_key; one that does not pass is
# skipped), then the
# program's forms of mode :full (the corpus linux-errtest-full: bin/repr-go read --full --corpus
# linux-errtest) printed by repr/go and compiled the same way, their errors judged against the
# original's // ERROR comments (tools/gocmp errorcheck). An invalid program repr/go cannot
# convert has no forms to print: unsupported. Prints PROGRAM<TAB>RESULT<TAB>REASON.
# no_forms_row PROGRAM WANT TSV: the row of an errorcheck program with no full forms, TSV the corpus's
# summary (kind, program, ..., message in the seventh column). unsupported only for an invalid program the
# converter rejects ("errors" or "fail" in the corpus); an error for a program that must compile (WANT
# empty: -0), one the corpus does not list and one it read as ok (report 060, finding 7: all were
# unsupported "no forms: an invalid program ...", so the converter losing valid programs or the corpus
# its entries showed only as more rows at the next --record)
no_forms_row() {
  local p=$1 want=$2 line kind msg
  line=$(awk -F'\t' -v k="$p" '$2 == k { print $1 "\t" $7; exit }' "$3")
  kind=${line%%$'\t'*}; msg=${line#*$'\t'}
  if [ -z "$line" ]; then printf '%s\terror\tno forms: the program is not in the corpus (%s)\n' "$p" "${3##*/}"
  elif [ -z "$want" ]; then printf '%s\terror\tno forms: a valid program (-0) must convert (%s: %s)\n' "$p" "$kind" "$msg"
  elif [ "$kind" != errors ] && [ "$kind" != fail ]; then printf '%s\terror\tno forms: the corpus read it as %s, but there are no forms\n' "$p" "$kind"
  else printf '%s\tunsupported\tno forms: an invalid program repr/go does not convert (%s: %s)\n' "$p" "$kind" "$msg"; fi
}

check_err_aot() {
  local p=$1 g=$goroot/test/$1 f act fl tmo=10 want=1 auto="" goflags=() goexp="" w=() x key ref st r reason i found=""
  act=$(action_of "$g")
  x=$(action_words "$act" 2>&1) || { printf '%s\terror\tthe action cannot be split: %s\n' "$p" "$act"; return; }
  while IFS= read -r x; do w+=("$x"); done <<< "$x"
  set -- "${w[@]}"
  [ "$1" = errorcheckwithauto ] && auto=-auto
  shift
  while [ $# -gt 0 ] && [ "${1#-}" != "$1" ]; do
    fl=$1; shift
    case $fl in
      -t) tmo=$1; shift ;;
      -0) want="" ;;
      -1) want=1 ;;
      -goexperiment) goexp=${goexp:+$goexp,}$1; shift ;;
      -godebug|-gomodversion) shift ;;
      -s) ;;
      *) goflags+=("$fl") ;;
    esac
  done
  tmo=$(program_tmo "$p" "$tmo")
  for i in "${!goflags[@]}"; do
    case ${goflags[$i]} in -d=*) goflags[$i]="${goflags[$i]},ssa/check/on"; found=1; break ;; esac
  done
  [ -n "$found" ] || goflags+=(-d=ssa/check/on)
  # gc's reference: the errors of the original, judged
  key=$( { echo aot; cat "$goroot/VERSION"; cat "$g"; printf '%s\n' "${goflags[@]}" "goexperiment=$goexp"; echo "judge: ${gocmp_key:-}"; } | sha256sum | cut -c1-24)
  ref=$gcwork/earef/$key
  if [ ! -f "$ref/judge" ]; then
    rt=$ref.tmp.$$; rm -rf "$rt"; mkdir -p "$rt"
    st=0; (cd "$rt" && export $(gc_env) GOEXPERIMENT="$goexp" && limited $((tmo * 3)) "$goroot/bin/go" tool compile -p=p -d=panic -C -e \
            -importcfg="$gcwork/importcfg" -o a.o "${goflags[@]}" "$g" > out 2>&1 < "$empty") || st=$?
    rm -f "$rt/a.o"
    case $st in 124|137|152) rm -rf "$rt"; printf '%s\terror\tgc reference: the compile timed out\n' "$p"; return ;; esac
    echo $st > "$rt/exit"
    "$gocmp" errorcheck $auto "$g" "$rt/out" > "$rt/judge" 2>&1 || true
    if [ -n "$want" ] && [ "$st" = 0 ]; then echo "fail: compilation succeeded unexpectedly" > "$rt/judge"; fi
    if [ -z "$want" ] && [ "$st" != 0 ]; then echo "fail: compilation failed unexpectedly" > "$rt/judge"; fi
    ref_commit "$rt" "$ref" judge
  fi
  if [ "$(head -1 "$ref/judge")" != pass ]; then
    printf '%s\tskip\tgc'"'"'s own errorcheck does not pass here: %s\n' "$p" "$(sed -n 2,3p "$ref/judge" | tr '\t\n' '  ' | cut -c1-200)"; return
  fi
  f=$efull/go/test/$(forms_rel "$p").ae
  if [ ! -f "$f" ]; then
    no_forms_row "$p" "$want" "$efull.tsv"; return
  fi
  r=$cwork/erun/$p
  rm -rf "$r.d"; mkdir -p "$r.d"
  if ! (cd "$root" && REPR_GO_EXE=$hexe bin/repr-go print "$f" "$r.d/src") > "$r.print.log" 2>&1; then
    printf '%s\tfail\tprinting the forms failed: %s\n' "$p" "$(grep -v -e '^$' -e '^Full report' -e '^Execution error' -e '\.edn$' "$r.print.log" | tail -1 | cut -c1-200)"; return
  fi
  local files=()
  for x in "$r.d/src"/*.go; do files+=("$(basename "$x")"); done
  st=0; (cd "$r.d/src" && export $(gc_env) GOEXPERIMENT="$goexp" && limited $((tmo * 3)) "$goroot/bin/go" tool compile -p=p -d=panic -C -e \
          -importcfg="$gcwork/importcfg" -o ../a.o "${goflags[@]}" "${files[@]}" > "$r.out" 2>&1 < "$empty") || st=$?
  rm -rf "$r.d"
  case $st in 124|137|152) printf '%s\terror\ttimeout (%s s)\n' "$p" "$((tmo * 3))"; return ;; esac
  # GTS85 (b): the controls whose subject this test is: the same errors against the reference's // ERROR comments
  controls_of "$p" | while read -r c x; do
    if err_aot_verdict "$goroot/test/$x" "$r.out" "$st" "$r.${c//\//_}.judge"; then printf '%s\tpass\t\n' "$c"
    else printf '%s\tfail\t%s\n' "$c" "$(sed -n 1,3p "$r.${c//\//_}.judge" | tr '\t\n' '  ' | cut -c1-240)"; fi
  done
  err_aot_verdict "$g" "$r.out" "$st" "$r.judge" && { printf '%s\tpass\t\n' "$p"; return; }
  printf '%s\tfail\t%s\n' "$p" "$(sed -n 1,3p "$r.judge" | tr '\t\n' '  ' | cut -c1-240)"
}

# box_run ROOT TMO NS FILE [PATH...] [-- ARG...]: program NS in the box (GS13, GR7a): the guest's
# standard input (box_input's) writes FILE and the PATHs (files or directories, relative to the
# forms root ROOT; a directory test's) into its in-memory file system under /goi, then runs
# arbace.go.run on /goi with ARGs; its standard output, error and status are the program's. For
# check_one the arguments after FILE are the program's (a single-file program has no PATHs).
# GOI_BOX_TMO, the seconds the launcher is given, is exported to it (a candidate that runs it
# elsewhere ends it there: bin/box-arm64-vm goi)
box_run() {
  local froot=$1 tmo=$2 ns=$3 file=$4; shift 4
  export GOI_BOX_TMO=$((tmo + ${GOI_BOX_TIMEOUT:-60}))
  box_input "$froot" "$ns" "$file" "$@" | timeout "$GOI_BOX_TMO" "$rexe" -
}

# box_input ROOT NS FILE [PATH...] [-- ARG...]: the guest's standard input for box_run
box_input() {
  local froot=$1 ns=$2 file=$3; shift 3
  local paths=() pargs=()
  if [ -n "${dirtest:-}" ]; then paths=("$@"); else pargs=("$@"); fi
  python3 -c '
import json, os, sys
root, ns, f = sys.argv[1:4]
n = int(sys.argv[4])
paths = sys.argv[5:5 + n]
args = sys.argv[5 + n:]
lit = lambda s: json.dumps(s, ensure_ascii=False)
out = []
def put(rel):
    out.append("(let [f (java.io.File. %s)] (.mkdirs (.getParentFile f)) (spit f %s))"
               % (lit("/goi/" + rel), lit(open(os.path.join(root, rel), encoding="utf-8").read())))
seen = set()
for rel in [f] + paths + ([f[:-3]] if f.endswith(".ae") else []):
    p = os.path.join(root, rel)
    if os.path.isdir(p):
        for d, _, fs in os.walk(p):
            for x in sorted(fs):
                if x.endswith(".ae"):
                    r = os.path.relpath(os.path.join(d, x), root)
                    if r not in seen: seen.add(r); put(r)
    elif os.path.isfile(p) and rel not in seen:
        seen.add(rel); put(rel)
out.append("(require (quote arbace.go.run))")
out.append("(arbace.go.run/-main %s)" % " ".join(lit(x) for x in ["/goi", ns] + args))
print("\n".join(out))
' "$froot" "$ns" "$file" "${#paths[@]}" ${paths[@]+"${paths[@]}"} ${pargs[@]+"${pargs[@]}"}
}

# tool_key DIR: the hash of the checkout's DIR (a tool's sources)
tool_key() {
  (cd "$root" && find "$1" -type f | LC_ALL=C sort | xargs sha256sum) | sha256sum | cut -c1-24
}

# corpus_key: the key of repr/go's corpora goi's check is judged on (report 002, finding 1; until then
# each was read only when its directory was missing, so a long-lived checkout judged goi on the forms
# of whatever repr/go first made them): Go's version, $GOROOT/test's pin and the sources that make
# them (repr/go's converter and native reader, goi's checker it answers with, the loader, the helper
# and tools/gocmp, whose lists name the programs), as check_nethttp keys its forms; and (report 060,
# finding 6) goi's REPL and builder, which interpret go/parser where the table does not list it, that
# go/parser's forms, arbace/box.ae and REPR_GO_READER; not the host's bytes
corpus_key() {
  { cat "$goroot/VERSION"; cat "$root/seed/goroot-test.sha256"
    (cd "$root" && find arbace/repr/go.ae arbace/repr/go arbace/go/check.ae arbace/go/check arbace/box/plan.ae arbace/box.ae \
       bin/repr-go bin/lib/repr-go bin/lib/repr-go-host.bash tools/godump tools/gocmp go/arbace/repr \
       arbace/go.ae arbace/go/repl.ae arbace/go/run.ae arbace/go/build.ae arbace/go/generic.ae arbace/go/table.ae arbace/go/embed.ae \
       tamago/goroot/go/go/parser tamago/goroot/go/go/scanner tamago/goroot/go/go/ast tamago/goroot/go/go/token -type f \
       | LC_ALL=C sort | xargs sha256sum)
    # not the tools' host: goi's interp-level and AOT steps run on different hosts over the same corpora,
    # so a key naming the executable made each re-read them (report 069, finding A); the reader's
    # sources above are what the read depends on, and the reader chosen
    # the reader as bin/repr-go read chooses it (reader=${REPR_GO_READER:-native}): unset and native are one reader
    echo "reader: ${REPR_GO_READER:-native}"; } | sha256sum | cut -c1-24
}

# corpus_stale DIR KEY [LIST...]: whether the corpus DIR must be made again: missing, or made from
# another key than KEY (DIR.goi-key, written once it is made); when it must, its key and the program
# lists LIST it was made from (bin/repr-go's, .tmp/godump/corpus: made again when missing) are removed
corpus_stale() {
  local d=$1 k=$2 l; shift 2
  [ -d "$d" ] && [ -f "$d.goi-key" ] && [ "$(cat "$d.goi-key")" = "$k" ] && return 1
  rm -f "$d.goi-key"
  for l in "$@"; do rm -f "$l"; done
  return 0
}

# refresh_corpora: check's corpora (its variables: cforms, dforms, eforms, efull, edumps, etsv, aot,
# ckey) read by bin/repr-go when stale (corpus_stale)
refresh_corpora() {
  local gd=$root/.tmp/godump/corpus
  if corpus_stale "$cforms" "$ckey" "$gd/linux-test-programs.txt"; then
    echo "== bin/repr-go read --corpus linux-test (.tmp/goi-check/read.log)" >&2
    "$root/bin/repr-go" read --corpus linux-test > "$cwork/read.log" 2>&1 || { tail "$cwork/read.log" >&2; return 1; }
    echo "$ckey" > "$cforms.goi-key"
  fi
  if corpus_stale "$dforms" "$ckey" "$gd/linux-dirtest-list.txt"; then
    echo "== bin/repr-go read --corpus linux-dirtest (.tmp/goi-check/read-dirtest.log)" >&2
    "$root/bin/repr-go" read --corpus linux-dirtest > "$cwork/read-dirtest.log" 2>&1 || { tail "$cwork/read-dirtest.log" >&2; return 1; }
    echo "$ckey" > "$dforms.goi-key"
  fi
  if [ -n "$aot" ] && { corpus_stale "$efull" "$ckey" "$gd/linux-errtest-programs.txt" || [ ! -f "$efull.tsv" ]; }; then
    echo "== bin/repr-go read --full --corpus linux-errtest (.tmp/goi-check/read-errtest-full.log)" >&2
    "$root/bin/repr-go" read --full --corpus linux-errtest > "$gcwork/read-errtest-full.log" 2>&1 \
      || grep -q '^converted [0-9]* of [0-9]* dumps.*, 0 did not read back$' "$gcwork/read-errtest-full.log" \
      || { tail "$gcwork/read-errtest-full.log" >&2; return 1; }
    echo "$ckey" > "$efull.goi-key"
  fi
  if corpus_stale "$eforms" "$ckey" "$gd/linux-errtest-programs.txt" || [ ! -f "$etsv" ]; then
    echo "== bin/repr-go read --corpus linux-errtest (.tmp/goi-check/read-errtest.log)" >&2
    # its invalid programs repr/go cannot convert fail the read (GC47: unsupported, each with its
    # reason below), so a read that converted the rest is the read's success
    "$root/bin/repr-go" read --corpus linux-errtest > "$cwork/read-errtest.log" 2>&1 \
      || grep -q '^converted [0-9]* of [0-9]* dumps.*, 0 did not read back$' "$cwork/read-errtest.log" \
      || { tail "$cwork/read-errtest.log" >&2; return 1; }
    echo "$ckey" > "$eforms.goi-key"
  fi
  # go/types' errors of the error tests, the oracle of "gc's phases after type checking": the
  # helper's dumps (bin/repr-go corpus), made when missing or stale (GPS33)
  if corpus_stale "$edumps" "$ckey" || [ ! -s "$edumps-programs.txt" ]; then
    echo "== bin/repr-go corpus linux-errtest: go/types' errors (.tmp/goi-check/dump-errtest.log)" >&2
    "$root/bin/repr-go" corpus linux-errtest > "$cwork/dump-errtest.log" 2>&1 || { tail "$cwork/dump-errtest.log" >&2; return 1; }
    echo "$ckey" > "$edumps.goi-key"
  fi
}

# missing_rows LIST RESULTS [REF [ONLY [IDS]]]: the programs without a row in RESULTS (report 002, finding 3:
# the regression comparison looked only at the rows there were): each program of LIST ("no result":
# its job printed no row, killed), and each program of the reference REF (only those that match the
# regular expression ONLY, as check's --only, and are in the file IDS, as check's --list) that LIST does not name ("missing": a program the list
# dropped, its forms gone); one line each
missing_rows() {
  local list=$1 res=$2 ref=${3:-} only=${4:-} ids=${5:-}
  { cut -f1 "$res" | sed 's/^/R\t/'
    sed 's/^/L\t/' "$list"
    if [ -n "$ref" ]; then
      sed -n 's/^ *\["\([^"]*\)" :\([a-z]*\).*/\1\t\2/p' "$ref" \
        | while IFS=$'\t' read -r x y; do [ -z "$only" ] || printf '%s\n' "$x" | grep -qE "$only" || continue; [ -z "$ids" ] || grep -qFx -- "$x" "$ids" || continue; printf 'F\t%s\t%s\n' "$x" "$y"; done
    fi; } \
    | awk -F'\t' '$1 == "R" { r[$2] = 1; next } ($2 in r) || seen[$2]++ { next }
                  $1 == "L" { print "   no result: " $2 " (its job printed no row)"; next }
                  { print "   missing: " $2 " (recorded " $3 "): not in this run'"'"'s list (no forms?)" }'
}

# apply_known KNOWN RESULTS: RESULTS (PROGRAM, RESULT, REASON) with the known differences KNOWN
# (PROGRAM, REASON) applied: a listed program that does not pass is known, with the listed reason;
# but a reason that names a kind of result takes only that kind (report 002, finding 4: any result was
# rewritten, so a speed program that now crashed stayed known with its old reason in the run and the
# record; report 060, finding 2: the same for the AOT level's file, whose positions, go command and
# -complete programs now failing otherwise, a crashed print or build, stayed known):
#   "speed: ..."              a timeout (error, "timeout...")
#   "positions: ...", "runs the go command: ...", "runtime.GOROOT ..."   a fail (the output or status differs)
#   "go build's -complete: ..."   an error, the AOT build failed
#   "errorcheck: ..."         a fail of the judge, not of the printing of the forms
# Any other reason takes any non-pass. Prints the rows
apply_known() {
  awk -F'\t' 'function takes(r, res, why) {
                 if (r ~ /^speed: /) return res == "error" && why ~ /^timeout/
                 if (r ~ /^(positions: |runs the go command: |runtime\.GOROOT )/) return res == "fail"
                 if (r ~ /^go build.s -complete: /) return res == "error" && why ~ /^the AOT build failed/
                 if (r ~ /^errorcheck: /) return res == "fail" && why !~ /^printing the forms failed/
                 return 1
               }
               NR==FNR { k[$1] = $2; next }
               ($1 in k) && $2 != "pass" && takes(k[$1], $2, $3) { $2 = "known"; $3 = k[$1] }
               { print $1 "\t" $2 "\t" $3 }' "$1" "$2"
}

# run_program_list GOROOT_TEST CFORMS DFORMS: the run programs to check (§11), sorted: the files whose
# action is run, with forms (CFORMS, forms_rel's spelling), and the directory tests (rundir, buildrundir,
# runindir) with theirs (DFORMS)
run_program_list() {
  local p
  (cd "$1" && find . -name '*.go' | sed 's|^\./||' | LC_ALL=C sort) | while read -r p; do
    case $(action_of "$1/$p") in
      run|"run "*) [ -f "$2/go/test/$(forms_rel "$p").ae" ] && echo "$p" ;;
      rundir|"rundir "*|buildrundir|"buildrundir "*|runindir|"runindir "*)
        { [ -d "$3/go/test/$(forms_rel "$p")_dir" ] || [ -f "$3/go/test/$(forms_rel "$p")_dir.ae" ]; } && echo "$p" ;;
    esac
  done
}

# check [--record] [--jobs N] [--essential] [--only REGEX] [--list FILE]: the check (§11): every run program of
# $GOROOT/test (the corpus linux-test, repr/go's conversion: bin/repr-go read --corpus linux-test,
# run first when missing) interpreted against gc; results in .tmp/goi-check/results.tsv, against
# the reference test/goi/check-linux-amd64.edn (a program passing there and not now fails the
# check; --record writes it) and the known differences test/goi/check-known.edn
check() {
  local record="" jobs=16 only="" essential="" listf="" ref=$root/test/goi/check-linux-amd64.edn known=$root/test/goi/check-known.edn
  local barch=amd64 bknown=""
  box="" bundle="" aot=""
  while [ $# -gt 0 ]; do
    case $1 in
      --record) record=1; shift ;;
      --jobs) jobs=$2; shift 2 ;;
      --only) only=$2; shift 2 ;;
      --list) listf=$2; shift 2 ;;
      --essential) essential=1; shift ;;
      --aot) aot=1; shift ;;
      --box) box=1; shift ;;
      --arch) barch=$2; shift 2 ;;
      --bundle) bundle=$2; shift 2 ;;
      *) echo "bin/goi check: unknown option $1" >&2; return 2 ;;
    esac
  done
  if [ -n "$bundle" ] && [ -z "$box" ]; then echo "bin/goi check: --bundle needs --box" >&2; return 2; fi
  if [ -n "$listf" ]; then
    [ -f "$listf" ] || { echo "bin/goi check: --list: no file $listf" >&2; return 2; }
    [ -z "$record" ] || { echo "bin/goi check: --record writes the whole record: no --list" >&2; return 2; }
    [ -z "$box" ] || { echo "bin/goi check: --list is for the native levels, not --box" >&2; return 2; }
    listf=$(cd "$(dirname "$listf")" && pwd)/$(basename "$listf")
  fi
  if [ -n "$aot" ] && [ -n "$box" ]; then echo "bin/goi check: --aot or --box" >&2; return 2; fi
  if [ -n "$box" ]; then
    # the check in the box (GS13): its own reference and the box's results apart
    bknown=$root/test/goi/check-box-known.edn
    case $barch in
      amd64)
        rexe=${GOI_BOX_EXE:-$root/target/arbace-go/box-amd64/arbace-box}
        [ -n "$bundle" ] || [ -w /dev/kvm ] || { echo "bin/goi check --box: no /dev/kvm" >&2; return 1; } ;;
      arm64)
        # where KVM/arm64 is: the candidate GOI_BOX_EXE (bin/box-arm64-vm goi), or the bundle's
        rexe=${GOI_BOX_EXE:-}
        [ -n "$rexe" ] || [ -n "$bundle" ] || { echo "bin/goi check --box --arch arm64: no GOI_BOX_EXE (bin/box-arm64-vm goi)" >&2; return 1; }
        [ -f "$root/test/goi/check-box-known-arm64.edn" ] && bknown="$bknown $root/test/goi/check-box-known-arm64.edn" ;;
      *) echo "bin/goi check --box: --arch amd64 or arm64" >&2; return 2 ;;
    esac
    [ -n "$bundle" ] || [ -x "$rexe" ] || { echo "bin/goi check --box: no $rexe (bin/arbace-go --build --box)" >&2; return 1; }
    ref=$root/test/goi/check-box-$barch.edn
    [ "$jobs" = 16 ] && jobs=8
  elif [ -n "$aot" ]; then
    # the AOT level (REAP2): its own reference and known differences; no executable of goi's
    ref=$root/test/goi/check-aot-linux-amd64.edn known=$root/test/goi/check-aot-known.edn rexe=""
  else
    rexe=$(run_exe) || return 1
  fi
  . "$root/bin/lib/host.bash"
  hexe=$(arbace_host_exe) || return 1
  cforms=$root/.tmp/repr-go/forms/linux-test
  dforms=$root/.tmp/repr-go/forms/linux-dirtest
  cwork=$root/.tmp/goi-check
  # gc's references, the importcfg and the judge shared by every level and the box
  gcwork=$cwork empty=$cwork/empty
  eforms=$root/.tmp/repr-go/forms/linux-errtest
  efull=$root/.tmp/repr-go/forms/linux-errtest-full
  edumps=$root/.tmp/godump/corpus/linux-errtest
  etsv=$eforms.tsv
  mkdir -p "$cwork/gcref" "$cwork/run" "$cwork/bin"
  : > "$empty"
  # the box's runs apart from the native ones (gc's reference shared)
  if [ -n "$box" ]; then
    # a bundle's apart too: its list and results must not replace a running check's (xargs reads
    # the list as it runs)
    local bw=box; [ "$barch" = amd64 ] || bw=box-$barch; [ -z "$bundle" ] || bw=box-bundle
    mkdir -p "$cwork/$bw"; cwork=$cwork/$bw
  fi
  # the AOT level's runs apart too
  [ -z "$aot" ] || { mkdir -p "$cwork/aot"; cwork=$cwork/aot; }
  if [ -n "$bundle" ]; then
    mkdir -p "$bundle"; bundle=$(cd "$bundle" && pwd); rm -rf "$bundle/in" "$bundle/want"
  fi
  mkdir -p "$cwork/bin"
  # repr/go's corpora, kept by key (corpus_key; report 002, finding 1), refreshed by one check at a time
  ckey=$(corpus_key)
  mkdir -p "$root/.tmp/repr-go"
  exec 9> "$root/.tmp/repr-go/goi-corpora.lock"
  flock 9
  refresh_corpora || return 1
  # the errorcheck programs' judge (tools/gocmp: Go's test driver's) and gc's standard library
  # for their references (the test driver's importcfg)
  gocmp=$gcwork/bin/gocmp
  mkdir -p "$gcwork/bin"
  (cd "$root/tools/gocmp" && env -u GOOS -u GOARCH GOROOT="$goroot" GOTOOLCHAIN=local GOFLAGS= CGO_ENABLED=0 \
     "$goroot/bin/go" build -o "$gocmp.new" . && mv -f "$gocmp.new" "$gocmp") || { echo "bin/goi check: cannot build tools/gocmp" >&2; return 1; }
  # the judge's key: its sources' hash, in the keys of the errorcheck references' cached judgments
  gocmp_key=$(tool_key tools/gocmp)
  # remade when Go's version changed or an export file it names is gone (Go's build cache trimmed:
  # bin/lib/gocache.bash)
  if [ ! -s "$gcwork/importcfg" ] || { [ ! -f "$gcwork/importcfg.version" ] || [ "$(cat "$gcwork/importcfg.version")" != "$(cat "$goroot/VERSION")" ]; } \
     || ! sed -n 's/^packagefile [^=]*=//p' "$gcwork/importcfg" | while read -r x; do [ -f "$x" ] || exit 1; done; then
    env $(gc_env) "$goroot/bin/go" list -export -f '{{if .Export}}packagefile {{.ImportPath}}={{.Export}}{{end}}' std > "$gcwork/importcfg.new" \
      && mv "$gcwork/importcfg.new" "$gcwork/importcfg" && cat "$goroot/VERSION" > "$gcwork/importcfg.version" \
      || { echo "bin/goi check: go list std failed" >&2; return 1; }
  fi
  local list=$cwork/programs.txt
  run_program_list "$goroot/test" "$cforms" "$dforms" > "$list.run"
  # the errorcheck programs (GR7b): the corpus linux-errtest's list
  LC_ALL=C sort -u "$edumps-programs.txt" "$list.run" > "$list"
  rm -f "$list.run"
  # the essential subset: goi's (GS12), or with --aot the AOT level's (REAP8, RPS33 (a))
  [ -n "$essential" ] && grep -v '^#' "$root/test/goi/essential${aot:+-aot}.txt" | grep . > "$list.ess" && mv "$list.ess" "$list"
  # the box's subset: test/goi/box.txt; in the emulated arm64 box every second of its programs,
  # the first, the third, ... (GC75: half the emulation's four hours), unless GOI_BOX_ALL=1
  [ -n "$box" ] && grep -v '^#' "$root/test/goi/box.txt" | grep . > "$list.box" && mv "$list.box" "$list"
  if [ -n "$box" ] && [ -z "$bundle" ] && [ "$barch" = arm64 ] && [ "${GOI_BOX_ALL:-}" != 1 ]; then
    awk 'NR % 2 == 1' "$list" > "$list.half" && mv "$list.half" "$list"
  fi
  [ -n "$only" ] && { grep -E "$only" "$list" > "$list.only" || true; mv "$list.only" "$list"; }
  # GT8.7: --list FILE, the ids (blank and # lines ignored), whole lines, as a selection like --only
  if [ -n "$listf" ]; then
    grep -v '^[[:space:]]*\(#\|$\)' "$listf" > "$cwork/list-ids.txt" || true
    grep -Fx -f "$cwork/list-ids.txt" "$list" > "$list.only" || true; mv "$list.only" "$list"
    listf=$cwork/list-ids.txt
  fi
  # GTS81 (a), GTS86 (b): the negative controls of the level (test/goi/controls.txt) are judged by their
  # subjects' checkers (controls_of), from the subjects' own runs: no entry of the list
  # GP6: gc's syntax errors of the error tests to check (bin/repr-go syntax-errors: gc's syntax
  # run by goi from tamago/cmd's forms), and the raw forms of the error tests (made when missing or stale
  # and one to check has no final forms though go/parser accepts it: the converter cannot convert it)
  esyntax=$cwork/syntax
  eraw=$root/.tmp/repr-go/raw/linux-errtest
  grep -Fx -f "$edumps-programs.txt" "$list" > "$list.err" || true
  if [ -s "$list.err" ] && [ -z "$aot" ]; then
    rm -rf "$esyntax"; mkdir -p "$esyntax"
    echo "== bin/repr-go syntax-errors: $(wc -l < "$list.err") error tests (.tmp/goi-check/syntax.log)" >&2
    (cd "$goroot/test" && xargs -a "$list.err" "$root/bin/repr-go" syntax-errors --out "$esyntax") > "$cwork/syntax.log" 2>&1 \
      || { tail "$cwork/syntax.log" >&2; return 1; }
    local need="" q
    while read -r q; do
      [ -f "$eforms/go/test/$(forms_rel "$q").ae" ] && continue
      if awk -F'\t' -v k="$q" '$2 == k && $1 != "fail" { f = 1 } END { exit !f }' "$etsv"; then need=1; break; fi
    done < "$list.err"
    if [ -n "$need" ] && { [ ! -d "$eraw/go" ] || corpus_stale "$eraw" "$ckey"; }; then
      echo "== bin/repr-go read --reader native --raw --corpus linux-errtest (.tmp/goi-check/read-errtest-raw.log)" >&2
      rm -f "$eraw.goi-key"
      "$root/bin/repr-go" read --reader native --raw --corpus linux-errtest > "$cwork/read-errtest-raw.log" 2>&1 \
        || { tail "$cwork/read-errtest-raw.log" >&2; return 1; }
      echo "$ckey" > "$eraw.goi-key"
    fi
  fi
  rm -f "$list.err"
  # the corpora read: the lock released (corpus_key)
  exec 9>&-
  # the programs that run the go command (go run, go tool: const7.go, linkmain_run.go, issue21576.go, ...)
  # run TamaGo's, the pinned toolchain, not the host's on PATH (GT7: the clean run's empty GOCACHE made the
  # host's go 1.27.2 compile std within issue21576.go's minute, under gc and goi alike; the host's go is
  # pinned by nothing)
  export PATH=$goroot/bin:$PATH
  # gc's -m (GOI-SPEC.md, "Since v1: gc's escape analysis and inliner"): the escape tags of the standard
  # packages the -m programs import, made first by one process into $gcwork/escape-tags (each program a
  # package's imports not yet covered), so that the parallel runs read them instead of each making them
  if [ -z "$aot" ] && [ -z "$box" ]; then
    local wl="" seen=" " q imps im nsq
    while read -r q; do
      grep -qE '^// *errorcheck[a-z]* .*-m( |=|$)' "$goroot/test/$q" 2>/dev/null || continue
      [ -f "$eforms/go/test/$(forms_rel "$q").ae" ] || continue
      imps=$(awk '/^import \(/{f=1;next} f&&/^\)/{f=0} f{print $NF} /^import "/{print $2}' "$goroot/test/$q" | tr -d '"')
      nsq=""
      for im in $imps; do case $seen in *" $im "*) ;; *) seen="$seen$im "; nsq=1 ;; esac; done
      [ -n "$nsq" ] && wl="$wl $(sed -n '1s/^(ns \([^ )]*\).*/\1/p' "$eforms/go/test/$(forms_rel "$q").ae")"
    done < "$list"
    if [ -n "$wl" ]; then
      echo "== goi check: the escape tags of the -m programs' imports (.tmp/goi-check/escape-warm.log)" >&2
      (cd "$goroot/test" && GOMEMLIMIT=${GOI_ESCAPE_WARM_MEM:-1400MiB} "$rexe" -m arbace.go.run --escape-warm "$root/.tmp/repr-go/forms/linux-amd64" "$gcwork/escape-tags" "$eforms" $wl) \
        > "$cwork/escape-warm.log" 2>&1 || true
    fi
  fi
  echo "== goi check: $(wc -l < "$list") programs, $jobs at a time" >&2
  export -f cover_env cover_settle forms_rel no_forms_row limited limited_cpu program_tmo ref_commit action_parse check_one check_dir check_err check_err_aot run_verdict dir_verdict syn_verdict err_verdict err_aot_verdict controls_of action_of action_words gc_ref gc_ref_fails aot_build aot_dir_root stderr_head gc_env run_env box_run box_input
  export root goroot rexe hexe cforms dforms cwork gcwork empty box bundle aot eforms efull edumps etsv gocmp gocmp_key esyntax eraw
  local t0=$SECONDS
  # a job that dies prints no row: xargs's status is not the check's (missing_rows reports the program)
  { xargs -a "$list" -P "$jobs" -I{} bash -c 'case $(action_of "$goroot/test/$1") in errorcheck*) if [ -n "$aot" ]; then check_err_aot "$1"; else check_err "$1"; fi ;; *dir|*"dir "*) dirtest=1 check_dir "$1" ;; *) check_one "$1" ;; esac' _ {} \
      || echo "goi check: xargs exited $?" >&2; } | LC_ALL=C sort > "$cwork/results.tsv"
  # a program that timed out among the others runs again alone: under the host's load a program near
  # the limit (bug358, nosplit) times out at 16 at a time and passes by itself; its second result stands
  timeout_row_ids "$cwork/results.tsv" > "$cwork/timeouts.txt"
  # the first timeout rows of this run, a stale file of an earlier run emptied (review 080, finding 3)
: > "$cwork/first-timeouts.tsv"
  if [ -s "$cwork/timeouts.txt" ] && [ -z "$bundle" ]; then
    echo "== goi check: $(wc -l < "$cwork/timeouts.txt") timed out, run again one at a time (their first rows kept in $cwork/first-timeouts.tsv)" >&2
    keep_first_timeouts "$cwork/results.tsv" "$cwork/first-timeouts.tsv"
    xargs -a "$cwork/timeouts.txt" -P 1 -I{} bash -c 'case $(action_of "$goroot/test/$1") in errorcheck*) if [ -n "$aot" ]; then check_err_aot "$1"; else check_err "$1"; fi ;; *dir|*"dir "*) dirtest=1 check_dir "$1" ;; *) check_one "$1" ;; esac' _ {} \
      > "$cwork/retried.tsv" || echo "goi check: xargs exited $? (the retry)" >&2
    # (a subject's controls' rows come with it, GTS86 (b): those the first run did not print added)
    awk -F'\t' 'NR==FNR { r[$1] = $0; next } ($1 in r) { print r[$1]; delete r[$1]; next } { print } END { for (k in r) print r[k] }' "$cwork/retried.tsv" "$cwork/results.tsv" \
      | LC_ALL=C sort > "$cwork/results.r" && mv "$cwork/results.r" "$cwork/results.tsv"
  fi
  if [ -n "$bundle" ]; then
    # the bundle's list: PROGRAM, the timeout, the status expected, the comparison
    awk -F'\t' '$2=="bundled" { split($3, a, " "); print $1 "\t" a[1] "\t" a[2] "\t" a[3] }' "$cwork/results.tsv" > "$bundle/programs.tsv"
    awk -F'\t' '$2!="bundled"' "$cwork/results.tsv" | sed 's/^/   not bundled: /'
    cat "$known" $bknown | sed -n 's/^ *\["\([^"]*\)" "\(.*\)"\]$/\1\t\2/p' > "$bundle/known.tsv"
    echo "goi check --box --bundle: $(wc -l < "$bundle/programs.tsv") programs in $bundle; $((SECONDS - t0)) s"
    return 0
  fi
  # the known differences: a program listed there is known, with its reason, unless it passes
  # (apply_known: a speed's only when it timed out)
  if [ -f "$known" ]; then
    # in the box, the box's own known differences too (test/goi/check-box-known.edn)
    cat "$known" $bknown | sed -n 's/^ *\["\([^"]*\)" "\(.*\)"\]$/\1\t\2/p' > "$cwork/known.tsv"
    apply_known "$cwork/known.tsv" "$cwork/results.tsv" > "$cwork/results.k" && mv "$cwork/results.k" "$cwork/results.tsv"
  fi
  # GTS81 (a): the negative controls judged, then taken out of the results (no program of the records,
  # the known differences or the divergences): a control must fail, by the comparison, against its
  # reference's gc run; one that passes, or does not reach the comparison while its subject passes,
  # fails the check
  if [ -z "$box" ]; then
    local cst=0
    controls_judged "$([ -n "$aot" ] && echo aot || echo interp)" "$cwork/results.tsv" > "$cwork/controls.txt" || cst=$?
    cat "$cwork/controls.txt"
    grep -v '^_control/' "$cwork/results.tsv" > "$cwork/results.c" || true; mv "$cwork/results.c" "$cwork/results.tsv"
    [ "$cst" = 0 ] || { echo "goi check${aot:+ --aot}: FAILED: a negative control (test/goi/controls.txt)" >&2; return 1; }
  fi
  local total pass fail err uns kn skip
  total=$(wc -l < "$cwork/results.tsv")
  pass=$(awk -F'\t' '$2=="pass"' "$cwork/results.tsv" | wc -l); fail=$(awk -F'\t' '$2=="fail"' "$cwork/results.tsv" | wc -l)
  err=$(awk -F'\t' '$2=="error"' "$cwork/results.tsv" | wc -l); uns=$(awk -F'\t' '$2=="unsupported"' "$cwork/results.tsv" | wc -l)
  kn=$(awk -F'\t' '$2=="known"' "$cwork/results.tsv" | wc -l); skip=$(awk -F'\t' '$2=="skip"' "$cwork/results.tsv" | wc -l)
  echo "goi check${aot:+ --aot}: $total programs: $pass pass, $fail fail, $err error, $uns unsupported, $kn known, $skip skipped; $((SECONDS - t0)) s"
  { awk -F'\t' '$2=="fail" || $2=="error"' "$cwork/results.tsv" | head -30 | sed 's/^/   /'; } || true
  # the programs with no row (report 002, finding 3): a listed program whose job printed none, and in
  # a whole check (not --essential, not the box's) a program of the reference this run did not list
  # (its forms gone: the list takes the programs repr/go converted); neither recorded over
  local missing
  missing=$(missing_rows "$list" "$cwork/results.tsv" "$( [ -n "$record$essential$box" ] || [ ! -f "$ref" ] || echo "$ref")" "$only" "$listf")
  [ -z "$missing" ] || echo "$missing"
  if [ -n "$record" ] && [ -n "$missing" ]; then echo "   not recorded: programs without a result" >&2; return 1; fi
  if [ -n "$record" ]; then
    { if [ -n "$box" ]; then
        echo ";; goi's check in the box (doc/go/GOI-SPEC.md \"As built: GR7a\", GS13): the programs of test/goi/box.txt"
        if [ "$barch" = amd64 ]; then
          echo ";; run by the TamaGo guest on /dev/kvm (amd64) against gc's on linux/amd64, and their result, pass,"
          echo ";; fail, error, unsupported (with the reason), known or skip. bin/goi check --box --record"
        else
          echo ";; (every second one, GC75) run by the $barch guest on KVM/$barch (the emulated aarch64 VM,"
          echo ";; bin/box-arm64-vm goi) against gc's on linux/amd64, and their result, pass, fail, error,"
          echo ";; unsupported (with the reason), known or skip. bin/box-arm64-vm goi --record"
        fi
      elif [ -n "$aot" ]; then
        echo ";; goi's check at the AOT level (REAP2, doc/FULL-SUPPORT-SURVEY.md \"As built: REAP2\"): every program of goi's"
        echo ";; corpora of \$GOROOT/test (linux/amd64), its forms built by arbace.build.go and run (run programs and"
        echo ";; directory tests) or printed from mode :full and compiled by gc (errorcheck programs), against gc on the"
        echo ";; originals, and its result, pass, fail, error, unsupported (with the reason), known or skip."
        echo ";; bin/goi check --aot --record"
      else
        echo ";; goi's check (doc/go/GOI-SPEC.md §11.3): every run program of \$GOROOT/test (linux/amd64) and its"
        echo ";; result, pass, fail, error, unsupported (with the reason), known or skip. bin/goi check --record"
      fi
      echo "["
      awk -F'\t' '{ gsub(/\\/, "&&", $3); gsub(/"/, "\\\"", $3); printf " [\"%s\" :%s \"%s\"]\n", $1, $2, $3 }' "$cwork/results.tsv"
      echo "]"; } > "$ref"
    echo "   recorded $ref"
    return 0
  fi
  [ -f "$ref" ] || { echo "   no reference $ref (bin/goi check --record)" >&2; return 1; }
  local regress
  sed -n 's/^ *\["\([^"]*\)" :pass.*/\1/p' "$ref" > "$cwork/ref-pass.txt"
  regress=$(awk -F'\t' 'NR==FNR { p[$1] = 1; next }
                        ($1 in p) && $2 != "pass" { print "   regression: " $1 ": " $2 " " $3 }' "$cwork/ref-pass.txt" "$cwork/results.tsv")
  # GT8.7: one line `   failing: ID` for each program the regression and missing lines name (a list run's
  # caller reads them: sed -nE 's/^   failing: (.+)$/\1/p'; the divergences' --partial adds its own)
  failing() {
    { printf '%s\n' "$regress" | sed -nE 's/^   regression: ([^ :]+): .*/\1/p'
      printf '%s\n' "$missing" | sed -nE 's/^   (no result|missing): ([^ :]+) \(.*/\2/p'; } | sed '/^$/d;s/^/   failing: /'
  }
  if [ -n "$regress" ] || [ -n "$missing" ]; then
    [ -z "$regress" ] || echo "$regress"
    failing
    # a list run goes on to the divergences of its own results (the other programs that fail)
    if [ -n "$listf" ] && [ -z "$only$essential$box" ]; then check_divergences "$aot" "" "" "" "$cwork/results.tsv" "$listf" || true; fi
    return 1
  fi
  echo "   no regression against $(basename "$ref")"
  # the whole check: its reference's divergences classified (GR10); a list run: its own results alone
  check_divergences "$aot" "$essential" "$only" "$box" "$cwork/results.tsv" "$listf"
}

# check_divergences AOT ESSENTIAL ONLY BOX RESULTS [LIST]: the end of a check (each argument empty or set). A whole
# check classifies this run's results (not the record's: report 002, finding 4, a recorded non-pass that now
# fails or errs was reported nowhere until the next --record). The AOT level's essential subset holds
# test/goi/essential-aot.txt to the record (report 069, finding D: only the whole check did, so a list naming
# a known or skipped program passed the essential gate), seconds, no results of its own
check_divergences() {
  if [ -n "${6:-}" ] && [ -z "$3" ] && [ -z "$2" ] && [ -z "$4" ]; then
    # GT8.7, a --list run (6th argument, the list): its results alone, --partial
    GOI_ROOT=$root arbace_tool -p "$root/test" -m goi.divergences ${1:+--aot} --partial --results "$5"
  elif [ -z "$3" ] && [ -z "$2" ] && [ -z "$4" ]; then
    GOI_ROOT=$root arbace_tool -p "$root/test" -m goi.divergences ${1:+--aot} --results "$5"
  elif [ -n "$1" ] && [ -n "$2" ] && [ -z "$3" ] && [ -z "$4" ]; then
    GOI_ROOT=$root arbace_tool -p "$root/test" -m goi.divergences --aot
  fi
}

# nethttp_gc_env: Go's environment for gc's builds of test/nethttp (a module: the programs import only std)
nethttp_gc_env() {
  echo GOROOT="$goroot" GOTOOLCHAIN=local GOFLAGS=-mod=mod GOPROXY=off GOEXPERIMENT= CGO_ENABLED=0 \
    GOOS=linux GOARCH=amd64 GOAMD64=v1 GOCACHE="${GOI_GOCACHE:-$(env GOROOT="$goroot" "$goroot/bin/go" env GOCACHE)}"
}

# nethttp_one NAME: one program of the net/http corpus (NH1, doc/go/NET-HTTP-SURVEY.md, "As built: NH1"),
# interpreted by arbace.go.run (program mode) from its forms against gc's run of the original (the
# gc level's output, $nwork/gc/NAME.*): exit status, standard output byte for byte, standard error up
# to the goroutines' traces, as check_one compares. Prints NAME<TAB>RESULT<TAB>REASON.
nethttp_one() {
  local p=$1 r=$nwork/run/$1 st=0 reason cause
  mkdir -p "$nwork/run"
  (cd "$nwork" && limited_cpu "${NETHTTP_CPU:-120}" "${NETHTTP_WALL:-90}" "$rexe" -m arbace.go.run "$nforms" "go.nethttp.$p" > "$r.out" 2> "$r.err.raw" < "$empty") || st=$?
  case $st in
    # goi's own refusals only (with their goi: line; report 002, finding 9)
    125) grep -q '^goi: unsupported: ' "$r.err.raw" && { printf '%s\tunsupported\t%s\n' "$p" "$(sed -n 's/^goi: unsupported: //p' "$r.err.raw" | head -1)"; return; } ;;
    126) grep -q '^goi: error: ' "$r.err.raw" && { printf '%s\terror\t%s\n' "$p" "$(sed -n 's/^goi: error: //p' "$r.err.raw" | head -1 | cut -c1-300)"; return; } ;;
    124|137|152) printf '%s\terror\ttimeout (%s s wall, %s s CPU)\n' "$p" "${NETHTTP_WALL:-90}" "${NETHTTP_CPU:-120}"; return ;;
  esac
  stderr_head "$r.err.raw" > "$r.err"
  # GTS81 (a), queue 064: the negative controls whose subject this program is (test/goi/controls.txt, LEVEL nethttp): this
  # run judged by the same comparison against the REFERENCE's gc run (no run of its own); a row _control/ID, pass or fail
  local cid cref
  while read -r cid cref; do
    if [ ! -f "$nwork/gc/$cref.exit" ]; then printf '%s\terror\tno gc run of %s\n' "$cid" "$cref"
    elif [ "$st" = "$(cat "$nwork/gc/$cref.exit")" ] && cmp -s "$r.out" "$nwork/gc/$cref.out" && cmp -s "$r.err" "$nwork/gc/$cref.err"; then
      printf '%s\tpass\t%s against %s\n' "$cid" "$p" "$cref"
    else printf '%s\tfail\t%s against %s\n' "$cid" "$p" "$cref"; fi
  done < <(awk -v s="$p" '!/^#/ && NF == 4 && $1 == "nethttp" && $3 == s { print $2, $4 }' "$root/test/goi/controls.txt")
  if [ "$st" = "$(cat "$nwork/gc/$p.exit")" ] && cmp -s "$r.out" "$nwork/gc/$p.out" && cmp -s "$r.err" "$nwork/gc/$p.err"; then
    printf '%s\tpass\t\n' "$p"
  else
    reason="status $st (gc $(cat "$nwork/gc/$p.exit"))"
    cmp -s "$r.out" "$nwork/gc/$p.out" || reason="$reason, stdout differs"
    # the cause: the first panic, goi or fatal line of standard error, without the log's time and the ports
    cause=$(grep -a -m1 -E 'goi:|panic:|fatal error|interface conversion' "$r.err" | sed -E 's/^[0-9]{4}\/[0-9]+\/[0-9]+ [0-9:]+ //; s/127\.0\.0\.1:[0-9]+/ADDR/g; s/\[::1\]:[0-9]+/ADDR/g' | cut -c1-240 || true)
    [ -z "$cause" ] || reason="$reason: $cause"
    cmp -s "$r.err" "$nwork/gc/$p.err" || [ -n "$cause" ] || reason="$reason, stderr differs"
    printf '%s\tfail\t%s\n' "$p" "$reason"
  fi
}

# nethttp_controls_judged RESULTS: GTS81 (a), queue 064: each nethttp control of test/goi/controls.txt against RESULTS (the
# subjects' rows and the _control/ID rows nethttp_one prints): fail, as a control must; pass (the comparison passes what
# differs), an error (no gc run of the reference) or no row while its subject has a row fail (status 1); a subject with no
# row (--only) is left
nethttp_controls_judged() {
  awk -F'\t' 'FNR == NR { if (!/^#/) { split($0, w, /[ \t]+/); if (w[1] == "nethttp" && w[4] != "") { sub_[w[2]] = w[3]; ref[w[2]] = w[4] } } ; next }
    { row[$1] = $2; note[$1] = $3 }
    END { bad = 0
      for (c in sub_) {
        # (an element tested with "in" before it is read: reading one makes it)
        d = sub_[c] " against " ref[c] "'"'"'s gc run"; has = (c in row); ran = (sub_[c] in row)
        if (!ran) print "goi check --corpus nethttp: control " c ": left (" sub_[c] " not run)"
        else if (has && row[c] == "fail") print "goi check --corpus nethttp: control " c " (" d "): differs, as a control must (GTS81 (a))"
        else if (has && row[c] == "pass") { print "goi check --corpus nethttp: control passed: " c " (" d "): the comparison passes what differs"; bad = 1 }
        else if (has) { print "goi check --corpus nethttp: control not judged: " c " (" d "): " row[c] " " note[c]; bad = 1 }
        else if (row[sub_[c]] == "pass") { print "goi check --corpus nethttp: control not judged: " c " (" d "): no row though " sub_[c] " passes"; bad = 1 }
        else print "goi check --corpus nethttp: control " c ": left (" sub_[c] " " row[sub_[c]] ": no judgment of its run)" }
      exit bad }' "$root/test/goi/controls.txt" "$1"
}

# check_nethttp [--record] [--jobs N] [--only REGEX] [--list FILE] [--gc-only] [--update-want]: the net/http corpus
# (bin/goi check --corpus nethttp; NH1, doc/go/NET-HTTP-SURVEY.md, "As built: NH1"): test/nethttp's
# programs (a module, one package main per directory, listed in manifest.edn), each
#   - at the gc level: built by gc and run on loopback; passing when its status is 0, its standard
#     error empty and its standard output the recorded one, NAME/want.out (--update-want rewrites them
#     from gc's runs); results against test/nethttp/check-gc-linux-amd64.edn;
#   - at goi's level: its forms (bin/repr-go read, linux/amd64, cached by key) run by arbace.go.run in a
#     process of the executable (GOI_RUN_EXE), against gc's run; results against
#     test/nethttp/check-linux-amd64.edn (a program passing there and not now fails the check; --record
#     writes it), the non-passes in the classes of test/nethttp/divergences.edn (bin/goi divergences
#     --nethttp, run after a whole check that passes); its negative control (GTS81 (a), test/goi/controls.txt, LEVEL
#     nethttp): a program's run judged against another's gc run must fail (nethttp_controls_judged), before the record.
# Offline: loopback only. The work in .tmp/goi-check/nethttp.
check_nethttp() {
  local record="" jobs=${NETHTTP_JOBS:-4} only="" listf="" gconly="" updwant="" nd=$root/test/nethttp t0=$SECONDS p
  while [ $# -gt 0 ]; do
    case $1 in
      --record) record=1; shift ;;
      --jobs) jobs=$2; shift 2 ;;
      --only) only=$2; shift 2 ;;
      --list) listf=$2; shift 2 ;;
      --gc-only) gconly=1; shift ;;
      --update-want) updwant=1; shift ;;
      *) echo "bin/goi check --corpus nethttp: unknown option $1" >&2; return 2 ;;
    esac
  done
  # GT8.7: --list FILE, the names a line (blank and # lines ignored), a selection: --only's regular expression of them
  # (the names are plain words; with --only too, the list wins)
  if [ -n "$listf" ]; then
    [ -f "$listf" ] || { echo "bin/goi check --corpus nethttp: --list: no file $listf" >&2; return 2; }
    only="^($(grep -v '^[[:space:]]*\(#\|$\)' "$listf" | paste -sd'|' || true))\$"
  fi
  # report 019, A3: a record of the selected programs alone would drop the others from the reference
  if [ -n "$record" ] && [ -n "$only" ]; then echo "bin/goi check --corpus nethttp: --record writes the whole record: no --only" >&2; return 2; fi
  nwork=$root/.tmp/goi-check/nethttp empty=$root/.tmp/goi-check/empty
  mkdir -p "$nwork/gc" "$(dirname "$empty")"
  : > "$empty"
  # the corpus: every directory with a main.go, the same set as the manifest's
  local names
  names=$(cd "$nd" && for d in */main.go; do echo "${d%/main.go}"; done | LC_ALL=C sort)
  sed -n 's/^ *{:name "\([^"]*\)".*/\1/p' "$nd/manifest.edn" | LC_ALL=C sort > "$nwork/manifest.names"
  echo "$names" > "$nwork/dir.names"
  if ! cmp -s "$nwork/manifest.names" "$nwork/dir.names"; then
    echo "bin/goi check --corpus nethttp: test/nethttp/manifest.edn and the program directories differ:" >&2
    diff "$nwork/manifest.names" "$nwork/dir.names" | head >&2
    return 1
  fi
  local list=$nwork/programs.txt
  if [ -n "$only" ]; then echo "$names" | grep -E "$only" > "$list" || true; else echo "$names" > "$list"; fi
  [ -s "$list" ] || { echo "bin/goi check --corpus nethttp: no program matches $only" >&2; return 1; }
  # the gc level: the whole module built once, each program run alone
  echo "== goi check --corpus nethttp: gc builds $(echo "$names" | wc -l) programs" >&2
  rm -rf "$nwork/gcbin"; mkdir -p "$nwork/gcbin"
  (cd "$nd" && env $(nethttp_gc_env) "$goroot/bin/go" build -o "$nwork/gcbin/" ./...) > "$nwork/gc-build.log" 2>&1 \
    || { tail "$nwork/gc-build.log" >&2; return 1; }
  export -f limited limited_cpu stderr_head nethttp_one
  : > "$nwork/gc.tsv"
  while read -r p; do
    local gst=0
    (cd "$nd/$p" && limited 30 "$nwork/gcbin/$p" > "$nwork/gc/$p.out" 2> "$nwork/gc/$p.err.raw" < "$empty") || gst=$?
    echo $gst > "$nwork/gc/$p.exit"
    stderr_head "$nwork/gc/$p.err.raw" > "$nwork/gc/$p.err"
    [ -z "$updwant" ] || cp "$nwork/gc/$p.out" "$nd/$p/want.out"
    if [ "$gst" != 0 ]; then printf '%s\tfail\t%s\n' "$p" "$(gc_status_reason "$gst" 30)"
    elif [ -s "$nwork/gc/$p.err.raw" ]; then printf '%s\tfail\tgc wrote to standard error\n' "$p"
    elif [ ! -f "$nd/$p/want.out" ]; then printf '%s\tfail\tno recorded output (want.out; --update-want)\n' "$p"
    elif ! cmp -s "$nwork/gc/$p.out" "$nd/$p/want.out"; then printf '%s\tfail\tgc'"'"'s output differs from want.out\n' "$p"
    else printf '%s\tpass\t\n' "$p"; fi
  done < "$list" > "$nwork/gc.tsv"
  nethttp_report gc "$nwork/gc.tsv" "$nd/check-gc-linux-amd64.edn" "$record" "gc's run of test/nethttp's programs on loopback" "bin/goi check --corpus nethttp --record" "As built: NH1" "" || return 1
  [ -z "$gconly" ] || return 0
  # goi's level: the forms, cached by the programs' and the converter's key
  rexe=$(run_exe) || return 1
  . "$root/bin/lib/host.bash"
  hexe=$(arbace_host_exe) || return 1
  local key
  key=$( { cat "$goroot/VERSION"; (cd "$nd" && find . \( -name '*.go' -o -name go.mod \) | LC_ALL=C sort | xargs cat);
           (cd "$root" && find arbace/repr/go.ae arbace/repr/go arbace/go/check.ae arbace/go/check arbace/box/plan.ae tools/godump go/arbace/repr -type f | LC_ALL=C sort | xargs sha256sum); } | sha256sum | cut -c1-24)
  nforms=$nwork/forms
  if [ ! -f "$nforms.key" ] || [ "$(cat "$nforms.key")" != "$key" ] || [ ! -d "$nforms/go" ]; then
    echo "== bin/repr-go read --goos linux --goarch amd64 ./... in test/nethttp (.tmp/goi-check/nethttp/read.log)" >&2
    rm -rf "$nforms" "$nforms.key"
    (cd "$nd" && REPR_GO_EXE=$hexe "$root/bin/repr-go" read --goos linux --goarch amd64 --out "$nforms" ./...) > "$nwork/read.log" 2>&1 \
      || { tail "$nwork/read.log" >&2; return 1; }
    echo "$key" > "$nforms.key"
  fi
  echo "== goi check --corpus nethttp: $(wc -l < "$list") programs, $jobs at a time" >&2
  export root rexe nwork nforms empty
  xargs -a "$list" -P "$jobs" -I{} bash -c 'nethttp_one "$1"' _ {} | LC_ALL=C sort > "$nwork/results.tsv"
  # GTS81 (a): the negative controls judged, then taken out of the results (no program of the records or the classes)
  local cst=0
  nethttp_controls_judged "$nwork/results.tsv" || cst=$?
  grep -v '^_control/' "$nwork/results.tsv" > "$nwork/results.c" || true; mv "$nwork/results.c" "$nwork/results.tsv"
  [ "$cst" = 0 ] || { echo "goi check --corpus nethttp: FAILED: a negative control (test/goi/controls.txt, nethttp)" >&2; return 1; }
  nethttp_report goi "$nwork/results.tsv" "$nd/check-linux-amd64.edn" "$record" "goi's check of test/nethttp (interpreted, net/http listed)" "bin/goi check --corpus nethttp --record" "As built: NH1" "$(nethttp_exe_desc "$rexe")" || return 1
  if [ -z "$only" ] && [ -z "$record" ]; then
    GOI_ROOT=$root arbace_tool -p "$root/test" -m goi.divergences --nethttp --results "$nwork/results.tsv"
  fi
  echo "goi check --corpus nethttp: $((SECONDS - t0)) s" >&2
}

# nethttp_arbace_one NAME: one program of NH12 (a)'s set (test/nethttp/arbace/NAME.ae, a script of the executable:
# Arbace fns and reifies crossing into net/http, a handler defined at the REPL, the refused import), run in its
# directory against its hand-written output NAME.out (gc cannot run these): status 0 and standard output byte for
# byte; standard error is not judged (goi warnings, the server's log) but its first panic or error line is the
# reason of a non-pass. Prints NAME<TAB>RESULT<TAB>REASON.
nethttp_arbace_one() {
  local p=$1 d=$root/test/nethttp/arbace st=0 r=$nwork/arbace/$1 reason cause
  mkdir -p "$nwork/arbace"
  (cd "$d" && limited_cpu "${NETHTTP_CPU:-120}" "${NETHTTP_WALL:-90}" "$rexe" "$p.ae" > "$r.out" 2> "$r.err" < "$empty") || st=$?
  case $st in
    124|137|152) printf '%s\terror\ttimeout (%s s wall, %s s CPU)\n' "$p" "${NETHTTP_WALL:-90}" "${NETHTTP_CPU:-120}"; return ;;
  esac
  if [ "$st" = 0 ] && cmp -s "$r.out" "$d/$p.out"; then
    printf '%s\tpass\t\n' "$p"
  else
    reason="status $st"
    cmp -s "$r.out" "$d/$p.out" || reason="$reason, stdout differs"
    cause=$(grep -a -m1 -E 'goi:|panic:|fatal error|Syntax error|reify:' "$r.err" | sed -E 's/^[0-9]{4}\/[0-9]+\/[0-9]+ [0-9:]+ //; s/127\.0\.0\.1:[0-9]+/ADDR/g; s/^http: panic serving ADDR: //' | cut -c1-240 || true)
    # a stderr with none of the patterns (a checker's error) is a non-pass with no cause, not the runner's end
    [ -n "$cause" ] || cause=$(grep -a -m1 -v '^$' "$r.err" | cut -c1-240 || true)
    [ -z "$cause" ] || reason="$reason: $cause"
    printf '%s\tfail\t%s\n' "$p" "$reason"
  fi
}

# check_nethttp_arbace [--record] [--only REGEX]: NH12 (a)'s set (bin/goi check --corpus nethttp --arbace), the
# programs of test/nethttp/arbace/manifest.edn run one after another (loopback only), results against
# test/nethttp/arbace/check-linux-amd64.edn (a program passing there and not now fails the check, and so does
# one with no entry there and, on a whole run, one recorded and not run; --record writes it, from a whole run
# only), the non-passes in the classes of test/nethttp/arbace/divergences.edn (bin/goi divergences
# --nethttp-arbace). GOI_RUN_EXE is the executable.
check_nethttp_arbace() {
  local record="" only="" nd=$root/test/nethttp/arbace t0=$SECONDS p
  while [ $# -gt 0 ]; do
    case $1 in
      --record) record=1; shift ;;
      --only) only=$2; shift 2 ;;
      *) echo "bin/goi check --corpus nethttp --arbace: unknown option $1" >&2; return 2 ;;
    esac
  done
  if [ -n "$record" ] && [ -n "$only" ]; then echo "bin/goi check --corpus nethttp --arbace: --record writes the whole record: no --only" >&2; return 2; fi
  nwork=$root/.tmp/goi-check/nethttp empty=$root/.tmp/goi-check/empty
  mkdir -p "$nwork" "$(dirname "$empty")"
  : > "$empty"
  local names
  names=$(sed -n 's/^ *{:name "\([^"]*\)".*/\1/p' "$nd/manifest.edn" | LC_ALL=C sort)
  [ "$names" = "$(cd "$nd" && for f in *.ae; do echo "${f%.ae}"; done | LC_ALL=C sort)" ] \
    || { echo "bin/goi check --corpus nethttp --arbace: test/nethttp/arbace/manifest.edn and the programs differ" >&2; return 1; }
  rexe=$(run_exe) || return 1
  export root rexe nwork empty
  export -f limited limited_cpu nethttp_arbace_one
  local sel
  sel=$(echo "$names" | grep -E "${only:-.}" || true)
  [ -n "$sel" ] || { echo "bin/goi check --corpus nethttp --arbace: no program matches $only" >&2; return 1; }
  echo "== goi check --corpus nethttp --arbace: $(echo "$sel" | wc -l) programs" >&2
  echo "$sel" | while read -r p; do nethttp_arbace_one "$p"; done | LC_ALL=C sort > "$nwork/arbace-results.tsv"
  nethttp_report arbace "$nwork/arbace-results.tsv" "$nd/check-linux-amd64.edn" "$record" "goi's check of test/nethttp/arbace (net/http listed)" "bin/goi check --corpus nethttp --arbace --record" "As built: NH12 (a)" "$(nethttp_exe_desc "$rexe")" || return 1
  if [ -z "$only" ] && [ -z "$record" ]; then
    # the run's own results judged (report 002, finding 4, as check_nethttp does)
    GOI_ROOT=$root arbace_tool -p "$root/test" -m goi.divergences --nethttp-arbace --results "$nwork/arbace-results.tsv"
  fi
  echo "goi check --corpus nethttp --arbace: $((SECONDS - t0)) s" >&2
}

# nethttp_listing EXE: whether net/http is in EXE's goi table (GoInterp's paths, what arbace.go.repl/listed? asks),
# as a record's header says it: "net/http listed", "net/http unlisted", or "net/http's listing unknown" when EXE does
# not answer (report 019, A4: the word was written by hand, true of the checkout and not always of the executable)
nethttp_listing() {
  local a=""
  [ -z "$1" ] || a=$(env -u ARBACE_PATH "$1" -e '(print (if (some #{"net/http"} (arbace.lang.GoInterp/paths)) "listed" "unlisted"))' 2> /dev/null) || a=""
  case $a in
    listed|unlisted) echo "net/http $a" ;;
    *) echo "net/http's listing unknown" ;;
  esac
}

# nethttp_exe_desc: the executable the run used, as the record's header names it: its key when it is one of the
# gate's (.../gate-exe/KEY), else its path with what it says it was built from (report 019, A5: a path does not say
# what was built), its version map's :describe and :runtime (bin/lib/version.bash's arbace_runtime_key at its build),
# asked only when the caller records (its `record`, in scope), and ARBACE_PATH when set, the checkout's own path
# written <checkout> (a committed header names no host's path)
nethttp_exe_desc() {
  local exe=$1 d key v=""
  case $exe in
    */gate-exe/*) key=${exe#*/gate-exe/}; d="the gate's executable ${key%%/*}" ;;
    *) d="executable ${exe#$root/}"
       if [ -n "${record:-}" ]; then
         v=$(env -u ARBACE_PATH "$exe" -e '(print (str (:describe *arbace-version*) ", runtime " (:runtime *arbace-version*)))' 2> /dev/null) || v=""
         d="$d (${v:-its version unknown})"
       fi ;;
  esac
  [ -z "${ARBACE_PATH:-}" ] || d="$d, ARBACE_PATH=${ARBACE_PATH//"$root"/<checkout>}"
  echo "$d"
}

# nethttp_report LEVEL TSV REF RECORD WHAT CMD SECTION EXE: the counts of a level's results, and either writes the
# reference REF (RECORD; CMD the command that writes it, SECTION the survey's section, EXE what it was recorded
# on, empty for gc's) or fails on a regression (a program passing in REF and not now), on a program with no
# entry in REF ("new, unrecorded", judged by --record alone) or, on a whole run (the caller's `only` empty), on a
# program of REF with no result ("recorded, not run": removed from the corpus, or a runner that printed no row;
# report 019, A3)
nethttp_report() {
  local level=$1 tsv=$2 ref=$3 record=$4 what=$5 cmdline=$6 section=$7 exe=${8:-} total regress unrec gone
  total=$(wc -l < "$tsv")
  echo "goi check --corpus nethttp ($level): $total programs: $(for r in pass fail error unsupported; do printf '%s %s, ' "$(awk -F'\t' -v r=$r '$2==r' "$tsv" | wc -l)" $r; done | sed 's/, $//')"
  awk -F'\t' '$2=="fail" || $2=="error"' "$tsv" | head -8 | sed 's/^/   /' | cut -c1-240
  if [ -n "$record" ]; then
    # report 019, A4: the callers' WHAT says "net/http listed" by hand; a goi level's record (EXE given) says what the
    # executable that ran it answers (the callers' rexe, in scope)
    [ -z "$exe" ] || what=${what//net\/http listed/$(nethttp_listing "${rexe:-}")}
    { echo ";; $what (doc/go/NET-HTTP-SURVEY.md, \"$section\"): each program and its result, pass,"
      echo ";; fail, error, unsupported (with the reason). $cmdline"
      [ -z "$exe" ] || echo ";; recorded on: $exe"
      echo "["
      awk -F'\t' '{ gsub(/\\/, "&&", $3); gsub(/"/, "\\\"", $3); printf " [\"%s\" :%s \"%s\"]\n", $1, $2, $3 }' "$tsv"
      echo "]"; } > "$ref"
    echo "   recorded ${ref#$root/}"
    return 0
  fi
  [ -f "$ref" ] || { echo "   no reference ${ref#$root/} ($cmdline)" >&2; return 1; }
  sed -n 's/^ *\["\([^"]*\)" :[a-z]*.*/\1/p' "$ref" > "$nwork/ref-all.$level"
  sed -n 's/^ *\["\([^"]*\)" :pass.*/\1/p' "$ref" > "$nwork/ref-pass.$level"
  regress=$(awk -F'\t' 'NR==FNR { p[$1] = 1; next } ($1 in p) && $2 != "pass" { print "   regression: " $1 ": " $2 " " $3 }' "$nwork/ref-pass.$level" "$tsv")
  # FILENAME, not NR==FNR: a reference with no rows must not swallow the results' file
  unrec=$(awk -F'\t' 'FILENAME == ARGV[1] { p[$1] = 1; next } !($1 in p) { n++; names = names (n > 1 ? ", " : "") $1 } END { if (n) print n ", " names }' "$nwork/ref-all.$level" "$tsv")
  if [ -n "$regress" ]; then echo "$regress"; fi
  if [ -n "$unrec" ]; then echo "   new, unrecorded: $unrec ($cmdline judges them)"; fi
  # the callers' --only (check_nethttp's, check_nethttp_arbace's local `only`, in scope here): a partial run is not
  # judged on the programs it did not select
  gone=""
  [ -n "${only:-}" ] || gone=$(awk -F'\t' 'FILENAME == ARGV[1] { r[$1] = 1; next } { delete r[$1] } END { for (p in r) print p }' "$nwork/ref-all.$level" "$tsv" | LC_ALL=C sort | awk '{ n++; names = names (n > 1 ? ", " : "") $0 } END { if (n) print n ", " names }')
  if [ -n "$gone" ]; then echo "   recorded, not run: $gone (a program removed from the corpus: $cmdline; else the runner lost its row)"; fi
  if [ -n "$regress" ] || [ -n "$unrec" ] || [ -n "$gone" ]; then return 1; fi
  echo "   no regression against $(basename "$ref")"
}

usage() { sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; }

cmd=${1:-}
[ $# -gt 0 ] && shift
case $cmd in
  table) table "$@" ;;
  annotations)
    corpora=() forms="" skip=""
    for a in "$@"; do
      if [ -n "$skip" ]; then skip=""; continue; fi
      case $a in --forms) forms=1; skip=1 ;; --work|--reference|--jobs) skip=1 ;; --*|[0-9]*) ;; *) corpora+=("$a") ;; esac
    done
    [ ${#corpora[@]} -gt 0 ] || corpora=(tamago-amd64 tamago-arm64 linux-amd64 linux-test linux-dirtest)
    [ -n "$forms" ] || for c in "${corpora[@]}"; do
      case $c in
        linux-*)
          [ -d "$root/.tmp/repr-go/forms/$c" ] || "$root/bin/repr-go" read --corpus "$c" > "$root/.tmp/goi-$c-read.log" 2>&1 ||
            { echo "bin/goi: bin/repr-go read --corpus $c failed (.tmp/goi-$c-read.log)" >&2; exit 1; }
          # the directory tests and the programs import std: its forms too
          [ "$c" = linux-amd64 ] || [ -d "$root/.tmp/repr-go/forms/linux-amd64" ] ||
            "$root/bin/repr-go" read --corpus linux-amd64 > "$root/.tmp/goi-linux-amd64-read.log" 2>&1 ;;
      esac
    done
    arbace_tool -m arbace.go.check annotations "$@" ;;
  test)
    gc="" regen=""
    for a in "$@"; do
      case $a in
        --gc) gc=1 ;;
        --regen) regen=1 ;;
        *) echo "bin/goi test: unknown option $a" >&2; exit 2 ;;
      esac
    done
    if [ -n "$regen" ]; then
      arbace_tool -p "$root/test" -e "(require 'goi.check-test) (goi.check-test/regen-checked!) (shutdown-agents)"
      run_tests --regen
      exit
    fi
    arbace_tool -p "$root/test" -e "
(require 'arbace.test 'goi.check-test)
(let [r (arbace.test/run-tests 'goi.check-test)]
  (shutdown-agents)
  (System/exit (if (zero? (+ (:fail r) (:error r))) 0 1)))"
    if [ -n "$gc" ]; then
      mkdir -p "$root/.tmp/goi-test"
      arbace_tool -p "$root/test" -m goi.gc-errors "$root/.tmp/goi-test/gc"
    fi
    run_tests ${gc:+--gc} ${regen:+--regen} ;;
  run)
    [ $# -ge 2 ] || { echo "usage: bin/goi run ROOT NS [ARG...]" >&2; exit 2; }
    exec "$(run_exe)" -m arbace.go.run "$@" ;;
  check) if [ "${1:-}" = --corpus ] && [ "${2:-}" = nethttp ]; then
           shift 2
           if [ "${1:-}" = --arbace ]; then shift; check_nethttp_arbace "$@"; else check_nethttp "$@"; fi
         else check "$@"; fi ;;
  divergences) GOI_ROOT=$root arbace_tool -p "$root/test" -m goi.divergences "$@" ;;
  ""|-h|--help|help) usage ;;
  *) echo "bin/goi: unknown command $cmd (bin/goi --help)" >&2; exit 2 ;;
esac

#!/usr/bin/env bash
# bin/java-speed: Java's timeouts judged one by one (GTS208 (a), doc/GATE-SURVEY.md, "GT8, the test budget").
#   bin/java-speed list [speed|hang|all]       the test ids of :speed and :speed-compiled, of the hang classes, or all (divergences.edn)
#   bin/java-speed commands                    the reruns, printed with their environment (what `rerun` runs)
#   bin/java-speed rerun interp|compiled       the timeouts of that level rerun at a long limit (120: 600 s of CPU, the :speed
#                                              threshold), once (JAVA_CHECK_ONCE), 4 jobs, ARBACE_CPU_LOG recording each action's
#                                              CPU time, in a work directory of its own (JAVA_CHECK_WORK=.tmp/java-speed/work-LEVEL),
#                                              the gate's executable, javac's tool and the main checkout's forms (JAVA_CHECK_EXE,
#                                              REPR_JAVA_EXE, JAVA_CHECK_FORMS; the caller's win); compiled also JAVA_CHECK_AOT
#                                              and under bin/heavy-lock; the results are saved under .tmp/java-speed/LEVEL
#                                              (--save), no record touched
#   bin/java-speed record LEVEL CPU-LOG [RESULTS]
#                                              the log's rows joined with the rerun's results (RESULTS, default
#                                              .tmp/java-speed/LEVEL/results.tsv) into test/java/speed-measured.tsv: per test
#                                              the slowest action's CPU, the worst status, the verdict; prints a timeouts.txt line
#                                              (JTREG-NAME SECONDS, 2.5 times the CPU time over limited's 5, GTS102) for a test
#                                              that passed only
#                                              (the classes by level: :speed and :speed-hang interp, :speed-compiled and
#                                              :speed-hang-compiled compiled; rerun LEVEL reruns that level's two)
#   bin/java-speed check                       no :match in divergences.edn takes a timeout; every recorded timeout is named by a
#                                              :tests list; every :speed (:speed-compiled) test has a passing interp (compiled) row in
#                                              speed-measured.tsv (unmeasured counted)
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
div=$root/test/java/divergences.edn
. "$root/bin/lib/tmpdir.bash" 2>/dev/null || true
out=$root/.tmp/java-speed

# class_tests NAME...: the :tests ids of the classes (a class block runs from its ' {:id :NAME' line to the next)
class_tests() {
  local n
  for n in "$@"; do
    awk -v n=":$n" '/^ \{:id / { on = ($2 == n) } on' "$div" | grep -E '^ *:tests ' | grep -oE '"t[0-9]{5}"' | tr -d '"' || true
  done
}

# timeouts LEVEL: ids recorded as timeout at LEVEL
timeouts() { sed -n 's/^ \["\(t[0-9]*\)" "[^"]*" :timeout .*/\1/p' "$root/test/java/check-$1.edn"; }

# regex_of IDS: the --only regex (java-check matches "ID TEST")
regex_of() { echo "^($(paste -sd'|')) "; }

# rerun_cmd LEVEL: sets cmd, the rerun's command line with its environment (the caller's variables win)
rerun_cmd() {
  local lv=$1 ids t pre="" aot="" key gc jdir
  . "$root/bin/lib/gate-cache.bash"; . "$root/bin/lib/javac-key.bash"
  gc=${ARBACE_GATE_CACHE:-$(arbace_gate_cache "$root")}
  key=$(arbace_javac_key "$root")
  jdir=$(arbace_gate_exes "$root")/javac-${key:0:20}
  case $lv in
    interp) ids=$(class_tests speed speed-hang | sort -u); t=120 ;;
    compiled) ids=$(class_tests speed-compiled speed-hang-compiled | sort -u); t=120
              aot="JAVA_CHECK_AOT=${JAVA_CHECK_AOT:-$gc/amd64/aot}"; pre="$root/bin/heavy-lock " ;;
    *) echo "interp|compiled" >&2; return 2 ;;
  esac
  cmd="$pre""env JAVA_CHECK_EXE=${JAVA_CHECK_EXE:-$gc/amd64/arbace} REPR_JAVA_EXE=${REPR_JAVA_EXE:-$jdir/arbace-javac}"
  cmd+=" JAVA_CHECK_FORMS=${JAVA_CHECK_FORMS:-$(arbace_main_checkout "$root")/.tmp/java-check/forms} $aot JAVA_CHECK_WORK=$out/work-$lv"
  cmd+=" ARBACE_HEAVY_CMD=\"$root/bin/heavy-lock\" ARBACE_CPU_LOG=$out/$lv.cpu.tsv JAVA_CHECK_ONCE=1"
  cmd+=" bin/java-check --levels $lv --jobs 4 --timeout $t --only '$(echo "$ids" | regex_of)' --save $out/$lv"
}

case ${1:-} in
  list)
    case ${2:-all} in
      speed) class_tests speed speed-compiled ;;
      hang) class_tests speed-hang speed-hang-compiled ;;
      all) class_tests speed speed-compiled speed-hang speed-hang-compiled ;;
      *) echo "bin/java-speed list [speed|hang|all]" >&2; exit 2 ;;
    esac | sort -u ;;
  commands)
    for lv in interp compiled; do rerun_cmd "$lv"; echo "$cmd"; done ;;
  rerun)
    lv=${2:?interp|compiled}
    rerun_cmd "$lv" || exit 2
    mkdir -p "$out" "$out/work-$lv"; : > "$out/$lv.cpu.tsv"
    cd "$root"
    eval "$cmd" ;;
  record)
    lv=${2:?LEVEL}; log=${3:?CPU-LOG}; res=${4:-$out/$lv/results.tsv}
    tbl=$root/test/java/speed-measured.tsv
    [ -f "$res" ] || { echo "java-speed: no results $res (the rerun's --save)" >&2; exit 2; }
    # a row of the log: STATUS WALL USER SYS COMMAND...; the test is the -Dtest.classes=.../classes/ID of the command.
    # A test's actions are rows of the same test: the largest CPU, the largest status. The verdict is java-check's
    # (results.tsv: ID LEVEL RESULT REASON), not the exit status (a finished test can differ).
    awk -F'\t' -v lv="$lv" 'FILENAME == ARGV[1] { if ($2 == lv) v[$1] = $3; next }
        { id = ""; if (match($5, /classes\/t[0-9]+/)) id = substr($5, RSTART + 8, RLENGTH - 8)
          if (id == "") next
          cpu = $3 + $4
          if (!(id in c) || cpu + 0 > c[id] + 0) c[id] = cpu
          if (!(id in st) || $1 + 0 > st[id] + 0) st[id] = $1 }
        END { for (id in c) { lim = int((c[id] * 2.5 / 5) + 0.999); if (lim < 20) lim = 20
              printf "%s\t%s\t%s\t%.2f\t%d\t%s\n", id, lv, st[id], c[id], lim, (id in v ? v[id] : "none") } }' "$res" "$log" > "$tbl.new"
    { grep '^#' "$tbl" || true; { grep -v '^#' "$tbl" || true; cat "$tbl.new"; } | awk -F'\t' '{ r[$1 FS $2] = $0 } END { for (k in r) print r[k] }' | LC_ALL=C sort; } > "$tbl.tmp"
    mv "$tbl.tmp" "$tbl"; rm -f "$tbl.new"
    echo "# lines for test/java/timeouts.txt (a test that passed, level $lv):"
    awk -F'\t' -v lv="$lv" '!/^#/ && $2 == lv && $3 == 0 && $6 == "pass" && $5 > 20 { print $1, $5 }' "$tbl" |
      while read -r id l; do
        n=$(sed -n "s/^ \[\"$id\" \"\([^\"]*\)\".*/\1/p" "$root/test/java/check-$lv.edn"); printf '%s %s\n' "$n" "$l"
      done ;;
  check)
    bad=0
    if grep -qE ':match \[#"\^timeout' "$div"; then echo "java-speed: a class takes every timeout (:match #\"^timeout \")" >&2; bad=1; fi
    named=$(class_tests speed speed-compiled speed-hang speed-hang-compiled memory-limit interp-volatile flaky-timeout | sort -u)
    for lv in interp compiled; do
      for id in $(timeouts $lv); do
        echo "$named" | grep -qx "$id" || { echo "java-speed: $id times out at $lv and no :tests list names it" >&2; bad=1; }
      done
    done
    n=0; m=0
    for c in speed:interp speed-compiled:compiled; do
      for id in $(class_tests "${c%%:*}"); do
        m=$((m + 1))
        awk -F'\t' -v i="$id" -v l="${c#*:}" '$1 == i && $2 == l && $3 == 0 && $6 == "pass" { f = 1 } END { exit !f }' "$root/test/java/speed-measured.tsv" || n=$((n + 1))
      done
    done
    echo "java-speed: $n of $m :speed and :speed-compiled tests unmeasured"
    exit $bad ;;
  *) sed -n '2,22p' "$0" >&2; exit 2 ;;
esac

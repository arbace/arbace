(in-ns 'go.arbace.box.tree) (go/file "edn.go" :imports [


    ^{:line 4} [errors "errors"]
    ^{:line 5} [fmt "fmt"]
    ^{:line 6} [strconv "strconv"]])




(go/type "The data a tree and a spawn's request and result are written in: the\npart of the Clojure reader's syntax they use.  A map keeps its order.\n"
  ^{:line 12} [Keyword string]
  ^{:line 13} [Vector (slice any)]
  ^{:line 14} [Map (slice KV)]
  ^{:line 15} [KV (struct ^any Key ^any Val)])



^{:go/breaks [[5 25]] :go/end 26} (go/method Get "Get is the value of key k in m, or nil.\n" ^any [^Map m ^any k]
  (range [_ kv m]
    (when (== (.-Key kv) k)
      (return (.-Val kv))))


  nil)





^{:go/end 42} (go/func ReadEDN "ReadEDN reads the one value data holds: a map, a vector, a string, a\nkeyword, an integer (int64), nil, true or false.  Whitespace and commas\nseparate; ; begins a comment to the end of the line.\n" [^{:tag (slice byte)} data] :results [any error]
  (let [r (addr (lit reader :b data))
      (values v err) (.read r)]
    (when (!= err nil)
      (return nil err))

    (.space r)
    (when (!= (.-i r) (len (.-b r)))
      (return nil (.errorf r "more after the value")))

    (return v nil)))


(go/type reader (struct
    ^{:line 45 :tag (slice byte)} b
    ^{:line 46 :tag int} i))


^{:go/end 51} (go/method errorf ^error [^{:tag (* reader)} r ^string f & ^{:tag (slice any)} a]
  (fmt/Errorf "edn: at %d: %s" (.-i r) (fmt/Sprintf f (spread a))))


^{:go/end 66} (go/method space [^{:tag (* reader)} r]
  (while (< (.-i r) (len (.-b r)))
    (switch [c (aget (.-b r) (.-i r))]
      (case [(or (== c \space) (== c \tab) (== c \newline) (== c \return) (== c \,))]
        (inc! (.-i r)))
      (case [(== c \;)]
        (while (and (< (.-i r) (len (.-b r))) (!= (aget (.-b r) (.-i r)) \newline))
          (inc! (.-i r))))

      (default
        (return)))))




^{:go/breaks [[4 73]] :go/end 74} (go/func delimiter ^bool [^byte c]
  (switch c
    (case [\space \tab \newline \return \, \; \{ \} \[ \] \( \) \"]
      (return true)))

  false)


^{:go/end 82} (go/method token ^string [^{:tag (* reader)} r]
  (let [j (.-i r)]
    (while (and (< (.-i r) (len (.-b r))) (not (delimiter (aget (.-b r) (.-i r)))))
      (inc! (.-i r)))

    (conv string (subslice (.-b r) j (.-i r)))))


(go/var errEnd (errors/New "edn: the end of a collection"))

^{:go/end 162} (go/method read [^{:tag (* reader)} r] :results [any error]
  (.space r)
  (when (>= (.-i r) (len (.-b r)))
    (return nil (.errorf r "no value")))

  (switch [c (aget (.-b r) (.-i r))]
    (case [(== c \{)]
      (inc! (.-i r))
      (let [^Map m (zero Map)]
        (while true
          (let [(values k err) (.readIn r \})]
            (when (== err errEnd)
              (return m nil))

            (when (!= err nil)
              (return nil err))

            (let [(values v ^:assign err) (.readIn r \})]
              (when (== err errEnd)
                (return nil (.errorf r "a map's key without a value")))

              (when (!= err nil)
                (return nil err))

              (type-switch k
                (case [string Keyword int64 bool nil])
                (default
                  (return nil (.errorf r "a map's key that is a collection"))))

              (range [_ kv m]
                (when (== (.-Key kv) k)
                  (return nil (.errorf r "a map's key twice: %v" k))))


              (set! m (append m (lit KV k v))))))))

    (case [(== c \[)]
      (inc! (.-i r))
      (let [v (lit Vector)]
        (while true
          (let [(values x err) (.readIn r \])]
            (when (== err errEnd)
              (return v nil))

            (when (!= err nil)
              (return nil err))

            (set! v (append v x))))))

    (case [(== c \")]
      (return (.str r)))
    (case [(== c \:)]
      (inc! (.-i r))
      (let [t (.token r)]
        (when (== t "")
          (return nil (.errorf r "an empty keyword")))

        (return (conv Keyword t) nil)))
    (default
      (let [t (.token r)]
        (switch t
          (case [""]
            (return nil (.errorf r "unexpected %q" c)))
          (case ["nil"]
            (return nil nil))
          (case ["true"]
            (return true nil))
          (case ["false"]
            (return false nil)))

        (let [(values n err) (strconv/ParseInt t 10 64)]
          (when (!= err nil)
            (return nil (.errorf r "not a value it reads: %q" t)))

          (return n nil))))))




^{:go/end 172} (go/method readIn "readIn reads a collection's next value, or errEnd at its closing end.\n" [^{:tag (* reader)} r ^byte end] :results [any error]
  (.space r)
  (when (and (< (.-i r) (len (.-b r))) (== (aget (.-b r) (.-i r)) end))
    (inc! (.-i r))
    (return nil errEnd))

  (.read r))


^{:go/end 206} (go/method str [^{:tag (* reader)} r] :results [string error]
  (inc! (.-i r))
  (let [^{:tag (slice byte)} out (zero (slice byte))]
    (while (< (.-i r) (len (.-b r)))
      (let [c (aget (.-b r) (.-i r))]
        (inc! (.-i r))
        (switch c
          (case [\"]
            (return (conv string out) nil))
          (case [\\]
            (when (>= (.-i r) (len (.-b r)))
              (return "" (.errorf r "a string's escape at the end")))

            (let [e (aget (.-b r) (.-i r))]
              (inc! (.-i r))
              (switch e
                (case [\" \\]
                  (set! out (append out e)))
                (case [\n]
                  (set! out (append out \newline)))
                (case [\t]
                  (set! out (append out \tab)))
                (case [\r]
                  (set! out (append out \return)))
                (default
                  (return "" (.errorf r "a string's escape it does not read: \\%c" e))))))

          (default
            (set! out (append out c))))))


    (return "" (.errorf r "a string without its end"))))

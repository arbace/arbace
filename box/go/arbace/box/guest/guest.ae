;; Package guest is the box's own test guests and the monitor's tests that run them (Arbace's,
;; doc/go/BOX-NOTES.md, "go-whim vendored whole"): go-whim's guest tests (its package guest, at
;; 80c49bf) with its editor and its C guests gone. Three programs stand in:
;;
;;	bare    (cmd/bare) no runtime, Go's assembly: the C guest's hello, its faults and its read-ahead
;;	demo    (cmd/demo) a Go guest on the board, package demo: what the Go editor guest showed
;;	faulty  (cmd/faulty) a Go guest on the board where the editor never goes, as go-whim's
;;
;; Build builds one as an image for the monitor with TamaGo's go; the tests build each once, or
;; take them from the directory $ARBACE_BOX_GUESTS (NAME-ARCH.elf: the arm64 VM, which has no Go,
;; runs images built beforehand by TestImages).
(in-ns 'go.arbace.box.guest) (go/file "guest.go" :doc "Package guest is the box's own test guests and the monitor's tests that run them (Arbace's,\ndoc/go/BOX-NOTES.md, \"go-whim vendored whole\"): go-whim's guest tests (its package guest, at\n80c49bf) with its editor and its C guests gone. Three programs stand in:\n\n\tbare    (cmd/bare) no runtime, Go's assembly: the C guest's hello, its faults and its read-ahead\n\tdemo    (cmd/demo) a Go guest on the board, package demo: what the Go editor guest showed\n\tfaulty  (cmd/faulty) a Go guest on the board where the editor never goes, as go-whim's\n\nBuild builds one as an image for the monitor with TamaGo's go; the tests build each once, or\ntake them from the directory $ARBACE_BOX_GUESTS (NAME-ARCH.elf: the arm64 VM, which has no Go,\nruns images built beforehand by TestImages).\n" :imports [


    ^{:line 15} [errors "errors"]
    ^{:line 16} [fmt "fmt"]
    ^{:line 17} [os "os"]
    ^{:line 18} [exec "os/exec"]
    ^{:line 19} [filepath "path/filepath"]
    ^{:line 20} [strings "strings"]])



(go/var ^{:doc "Programs is the test guests: the package of each, from the module's root.\n"} Programs (lit (map string string)
    ^{:line 25} ["bare" "./box/guest/cmd/bare"]
    ^{:line 26} ["demo" "./box/guest/cmd/demo"]
    ^{:line 27} ["faulty" "./box/guest/cmd/faulty"]
    ^{:line 28} ["ktest" "./box/guest/cmd/ktest"]))




(go/const ^{:val "-T 0x201000 -R 0x1000" :doc "link is where an image is linked: its first segment (the ELF header's page) at 2 MiB, the\nmonitor's image base, text a page above (go-whim's guest/gotamago.go).\n"} link "-T 0x201000 -R 0x1000")





^{:go/end 75} (go/func Build "Build builds the guest name for GOARCH arch from the module at mod (the module arbace, its go.mod\nrequiring TamaGo's goos module) with the Go distribution at goroot (TamaGo's), into out. The Go\nguests are GOOS=tamago, GOOSPKG TamaGo's goos; bare is GOOS=linux with its own entry, _start (its\npackage's main.go).\n" ^error [^string goroot ^string mod ^string name ^string arch ^string out]
  (let [(values pkg ok) (aget Programs name)]
    (when (not ok)
      (return (fmt/Errorf "no guest %q" name)))

    (let [env ^{:go/breaks [7]} (lit (slice string) (+ "GOROOT=" goroot) "GOTOOLCHAIN=local" "GOFLAGS=" "GOWORK=off" "GOPROXY=off"
          "GOEXPERIMENT=" "CGO_ENABLED=0" (+ "GOARCH=" arch) "GOAMD64=v1" "GOARM64=v8.0")
        ^{:line 46} ldflags link]
      (if (== name "bare") (do
          (set! env (append env "GOOS=linux"))
          (set! ldflags (+ "-E _start " link)))

        (set! env (append env "GOOS=tamago" "GOOSPKG=github.com/usbarmory/tamago")))

      (when [err (os/MkdirAll (filepath/Dir out) 493)] (!= err nil)
        (return err))

      ^{:go/breaks [[8 74]]} (let [cmd ^{:go/breaks [5]} (exec/Command (filepath/Join goroot "bin" "go") "build" "-trimpath" "-buildvcs=false"
            "-ldflags" ldflags "-o" out pkg)]
        (set! (.-Dir cmd) mod)
        (range [_ e (os/Environ)]
          (when (and (not (strings/HasPrefix e "GO")) (not (strings/HasPrefix e "CGO_")))
            (set! (.-Env cmd) (append (.-Env cmd) e))))


        (when [c (os/Getenv "GOCACHE")] (!= c "")
          (set! (.-Env cmd) (append (.-Env cmd) (+ "GOCACHE=" c))))

        (when [c (os/Getenv "GOMODCACHE")] (!= c "")
          (set! (.-Env cmd) (append (.-Env cmd) (+ "GOMODCACHE=" c))))

        (set! (.-Env cmd) (append (.-Env cmd) (spread env)))
        (when [(values b err) (.CombinedOutput cmd)] (!= err nil)
          (return (fmt/Errorf "%s: %v\n%s" (strings/Join (.-Args cmd) " ") err b)))

        nil))))




^{:go/end 94} (go/func ModuleDir "ModuleDir is the module arbace's root: the working directory or the nearest one above it with a\ngo.mod that names it (a test runs in its package's directory).\n" [] :results [string error]
  (let [(values d err) (os/Getwd)]
    (when (!= err nil)
      (return "" err))

    (while true
      (when [(values b err) (os/ReadFile (filepath/Join d "go.mod"))] (and (== err nil) (strings/HasPrefix (conv string b) "module arbace\n"))
        (return d nil))

      (let [up (filepath/Dir d)]
        (when (== up d)
          (return "" (errors/New "no go.mod of the module arbace here or above")))

        (set! d up)))))

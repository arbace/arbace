;; The box's test guests (doc/go/BOX-NOTES.md, "go-whim vendored whole"): the package
;; arbace/box/guest/demo, Arbace's own.
(ns go.arbace.box.guest.demo
  (:require [arbace.go :as go]))

(go/package demo
  :path "arbace/box/guest/demo"
  :files ["demo.go"]
  :positions :lines)

(load "demo/demo")

(in-ns 'go.arbace.box.guest) (go/file "ku2_test.go" :imports [


    ^{:line 4} [bytes "bytes"]
    ^{:line 5} [fmt "fmt"]
    ^{:line 6} [os "os"]
    ^{:line 7} [runtime "runtime"]
    ^{:line 8} [strconv "strconv"]
    ^{:line 9} [strings "strings"]
    ^{:line 10} [testing "testing"]

(in-ns 'go.arbace.box.guest) (go/file "ku1_test.go" :imports [


    ^{:line 4} [runtime "runtime"]
    ^{:line 5} [strings "strings"]
    ^{:line 6} [testing "testing"]
    ^{:line 7} [time "time"]

    ^{:line 9} [vmm "arbace/box/vmm"]])








^{:go/end 41} (go/func TestKernelKU1 "TestKernelKU1 is the KU1 check (doc/go/PROCESS-SPEC.md §9, the KU1 row, \"As built: KU1\"): the\nktest guest, run as the kernel on /dev/kvm, builds page tables for processes of its own image,\nenters them at ring 3, serves a SYSCALL, ends one on a page fault, turns a nil dereference into\nthe process's own panic, and switches CR3 between two processes with distinct data. The guest\nprints a line per check and exits 0 only when all pass. amd64 only (K9). The monitor is\nunchanged: this uses vmm.Run as every guest test does.\n" [^{:tag (* testing/T)} t]
  (when (!= runtime/GOARCH "amd64")
    ^{:go/via [common]} (.Skip t "KU1 is amd64 only (arm64 is KU3)"))

  (let [img (image t "ktest")
      ^{:line 23} h (addr (lit recorder))
      (values code err) (vmm/Run (lit vmm/Config :Image img :Host h :Args (lit (slice string) "ktest") :Watchdog (* 30 time/Second)))
      ^{:line 25} out (.String (.-out h))]
    ^{:go/via [common]} (.Logf t "exit %d err %v\n%s" code err out)
    (when (!= err nil)
      ^{:go/via [common]} (.Fatalf t "run: %v\n%s" err out))

    (range [_ want ^{:go/breaks [2 6]} (lit (slice string)
          "ktest: write PASS" "ktest: fault PASS" "ktest: nil PASS" "ktest: data PASS"
          "ktest: all checks passed")]

      (when (not (strings/Contains out want))
        ^{:go/via [common]} (.Fatalf t "missing %q in:\n%s" want out)))


    (when (!= code 0)
      ^{:go/via [common]} (.Fatalf t "exit %d, not 0:\n%s" code out))))

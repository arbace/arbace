;; The box's test guests (doc/go/BOX-NOTES.md, "go-whim vendored whole"): the package
;; arbace/box/guest/cmd/ktest, Arbace's own.
(ns go.arbace.box.guest.cmd.ktest
  (:require [arbace.go :as go]))

(go/package main
  :path "arbace/box/guest/cmd/ktest"
  :files ["bench.go" "main.go"]
  :positions :lines)

(load "ktest/bench")
(load "ktest/main")

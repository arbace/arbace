;; The box's test guests (doc/go/BOX-NOTES.md, "go-whim vendored whole"): the package
;; arbace/box/guest/cmd/bare, Arbace's own.
(ns go.arbace.box.guest.cmd.bare
  (:require [arbace.go :as go]))

(go/package main
  :path "arbace/box/guest/cmd/bare"
  :files ["main.go"]
  :other-files ["bare_amd64.s" "bare_arm64.s"]
  :positions :lines)

(load "bare/main")

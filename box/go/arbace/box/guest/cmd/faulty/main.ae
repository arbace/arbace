;; Command faulty stands in for a Go program on the board where none goes (package guest's
;; TestGoGuestFault): a null pointer written ("null"), a spin with no call ("spin"), a panic ("panic"),
;; and anything else a line on the console and the exit code 7. go-whim's guest/tamago/faulty at 80c49bf.
(in-ns 'go.arbace.box.guest.cmd.faulty) (go/file "main.go" :doc "Command faulty stands in for a Go program on the board where none goes (package guest's\nTestGoGuestFault): a null pointer written (\"null\"), a spin with no call (\"spin\"), a panic (\"panic\"),\nand anything else a line on the console and the exit code 7. go-whim's guest/tamago/faulty at 80c49bf.\n" :imports [

    ^{:line 6} [board "arbace/box/board"]])


(go/var ^{:tag (* int64) :doc "nowhere is a null pointer the compiler cannot see is one.\n"} nowhere)

^{:go/end 29} (go/func main []
  (let [args (board/Args)
      ^{:line 13} what ""]
    (when (> (len args) 1)
      (set! what (aget args 1)))

    (switch what
      (case ["null"]
        (set! @nowhere 1))
      (case ["spin"]
        (go/directive "//lint:ignore SA5002 the spin is the point: the watchdog ends it")
        (while true))

      (case ["panic"]
        (panic (+ "faulty: " what))))

    (println "faulty: hello")
    (board/Exit 7)))

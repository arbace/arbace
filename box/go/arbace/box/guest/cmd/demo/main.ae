;; Command demo is the box's demo guest (package demo; Arbace's, doc/go/BOX-NOTES.md, "go-whim
;; vendored whole"): the program as a virtual machine's only code, built with TamaGo for the
;; monitor, its Host hypercalls (package abi) through the board's doorbell. Its host is go-whim's
;; Go editor guest's (guest/tamago/main.go at 80c49bf), the calls the program makes.
(in-ns 'go.arbace.box.guest.cmd.demo) (go/file "main.go" :doc "Command demo is the box's demo guest (package demo; Arbace's, doc/go/BOX-NOTES.md, \"go-whim\nvendored whole\"): the program as a virtual machine's only code, built with TamaGo for the\nmonitor, its Host hypercalls (package abi) through the board's doorbell. Its host is go-whim's\nGo editor guest's (guest/tamago/main.go at 80c49bf), the calls the program makes.\n" :imports [


    ^{:line 8} [abi "arbace/box/abi"]
    ^{:line 9} [board "arbace/box/board"]
    ^{:line 10} [demo "arbace/box/guest/demo"]])





(go/type host "host is demo.Host as hypercalls: each method one call, the monitor answering it on its own Host\n-- but for the read after a wait, which the wait's call made already (abi.WaitRead) and input\nkeeps.\n" (struct
    ^{:line 17 :tag (func [int32])} deathtrap
    ^{:line 18 :tag input} input))





(go/type input "input is what the merged wait read ahead (go-whim's doc/GUEST.md, *The merged wait and read*):\nas much as the program's one read asks at most, demo.InputBytes. When kept, ret is what is left\nof the read's answer -- the count not yet the program's, from at, or the 0 or -1 it returned.\n" (struct
    ^{:line 25 :tag (array demo/InputBytes byte)} buf
    ^{:line 26 :tag bool} kept
    ^{:line 27 :tag int64} ret
    ^{:line 28 :tag int} at))






^{:go/end 46} (go/method call "call makes hypercall nr. A deadly signal the monitor caught during it comes back as the block's\nevent: the program's deathtrap runs here, where a native host's handler would have; when it\nreturns, a wait or a read is made again, as a native host's select and read go on after their\nEINTR.\n" ^board/Block [^{:tag (* host)} h ^uint64 nr ^int64 a0 ^int64 a1 ^int64 a2 ^int64 a3 ^int64 a4]
  (while true
    (let [b (board/Call nr a0 a1 a2 a3 a4)]
      (when (and (!= (.-Event b) 0) (!= (.-deathtrap h) nil))
        ((.-deathtrap h) (conv int32 (.-Event b)))
        (when (or (== nr abi/WaitForInput) (== nr abi/ReadInput) (== nr abi/WaitRead))
          (continue)))


      (return b))))



^{:go/end 51} (go/method Init [^{:tag (* host)} h ^{:tag (func [int32])} deathtrap]
  (set! (.-deathtrap h) deathtrap)
  (.call h abi/HostInit 0 0 0 0 0))




^{:go/end 66} (go/method WaitForInput "WaitForInput is one call, which reads at once when there is input; while what it read is kept,\nthe answer is yes with no call, as a select says yes to bytes in the tty.\n" ^bool [^{:tag (* host)} h ^int64 ms]
  (let [in (addr (.-input h))]
    (when (.-kept in)
      (return true))

    ^{:go/breaks [4]} (let [b (.call h abi/WaitRead ms (board/Addr (subslice (.-buf in))) (conv int64 (len (.-buf in))) 0 0)]
      (when (== (.-Ret b) 0)
        (return false))

      (set! (values (.-kept in) (.-ret in) (.-at in)) (values true (aget (.-A b) 0) 0))
      true)))




^{:go/end 84} (go/method ReadInput "ReadInput is served from what the wait read, while any is kept: the bytes, as many as buf\nholds, or the read's 0 or -1. Otherwise it is a call of its own.\n" ^int32 [^{:tag (* host)} h ^{:tag (slice byte)} buf]
  (let [in (addr (.-input h))]
    (when (or (not (.-kept in)) (== (len buf) 0))
      (return (conv int32 (.-Ret (.call h abi/ReadInput (board/Addr buf) (conv int64 (len buf)) 0 0 0)))))

    (when (<= (.-ret in) 0)
      (set! (.-kept in) false)
      (return (conv int32 (.-ret in))))

    (let [n (copy buf (subslice (.-buf in) (.-at in) (+ (.-at in) (conv int (.-ret in)))))]
      (set! (.-at in) + n)
      (set! (.-ret in) - (conv int64 n))
      (set! (.-kept in) (> (.-ret in) 0))
      (conv int32 n))))


^{:go/end 86} (go/method Suspend [^{:tag (* host)} h] (.call h abi/Suspend 0 0 0 0 0))

^{:go/end 90} (go/method Write ^int32 [^{:tag (* host)} h ^{:tag (slice byte)} p]
  (conv int32 (.-Ret (.call h abi/Write (board/Addr p) (conv int64 (len p)) 0 0 0))))


^{:go/end 94} (go/func main []
  (board/Exit (conv int32 (demo/Main (addr (lit host)) (board/Args)))))

(in-ns 'go.arbace.box.guest.cmd.demo) (go/file "kernel_amd64.go" :imports [


    ^{:line 4} [strings "strings"]

    ^{:line 6} [board "arbace/box/board"]
    ^:alias ^{:line 7} [boxkernel "arbace/box/kernel"]])







^{:go/end 23} (go/func kernel "kernel is the demo's kernel mode (doc/go/PROCESS-SPEC.md §9, the KU2 check): when the monitor\nboots this image with BOX_KERNEL=1 (or stats) in its environment, the image is the kernel and\nruns itself as a process with the same command line, the box's console its own -- so what the\nmonitor's host sees is the program's output as a process, to hold to its output as a guest.\nok is false when the environment does not ask for it: the guest as always.\n" [] :results [^int32 code ^bool ok]
  (let [env (board/Env)]
    (range [_ e env]
      (when [(values v found) (strings/CutPrefix e (+ boxkernel/KernelEnv "="))] found
        (return (boxkernel/RunSelf (board/Args) env (== v "stats")) true)))


    (return 0 false)))

;; The box's test guests (doc/go/BOX-NOTES.md, "go-whim vendored whole"): the package
;; arbace/box/guest/cmd/demo, Arbace's own.
(ns go.arbace.box.guest.cmd.demo
  (:require [arbace.go :as go]))

(go/package main
  :path "arbace/box/guest/cmd/demo"
  :files ["kernel_amd64.go" "kernel_other.go" "main.go"]
  :positions :lines)

(load "demo/kernel_amd64")
(load "demo/kernel_other")
(load "demo/main")

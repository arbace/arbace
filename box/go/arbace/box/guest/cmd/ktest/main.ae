

;; Command ktest is the KU1 test guest (doc/go/PROCESS-SPEC.md §9, the KU1 row): one image that is
;; the kernel when the monitor boots it (its ELF entry, board.cpuinit) and a process when the
;; kernel enters it (whim_uentry, board.Process). As the kernel it sets the vCPU up for ring 3
;; (board.UserSetup) and runs four checks, each a process of this same image (b1):
;;
;;	write   a process makes a SYSCALL the kernel serves (a Write), then exits -- the crossing works
;;	fault   a process writes a bad address: a page fault at ring 3 ends it with a fault report
;;	nil     a process dereferences nil: the fault becomes the process's own panic, which it recovers
;;	data    two processes of one image with distinct data, each on its own page tables (a CR3 switch)
;;
;; It prints a line per check and exits 0 when all pass, 1 otherwise. The monitor's test
;; (guest_test.go's TestKernelKU1) runs it and holds it to that. amd64 only (KU1, K9).
(in-ns 'go.arbace.box.guest.cmd.ktest) (go/file "main.go" :build ["//go:build amd64"] :doc "Command ktest is the KU1 test guest (doc/go/PROCESS-SPEC.md §9, the KU1 row): one image that is\nthe kernel when the monitor boots it (its ELF entry, board.cpuinit) and a process when the\nkernel enters it (whim_uentry, board.Process). As the kernel it sets the vCPU up for ring 3\n(board.UserSetup) and runs four checks, each a process of this same image (b1):\n\n\twrite   a process makes a SYSCALL the kernel serves (a Write), then exits -- the crossing works\n\tfault   a process writes a bad address: a page fault at ring 3 ends it with a fault report\n\tnil     a process dereferences nil: the fault becomes the process's own panic, which it recovers\n\tdata    two processes of one image with distinct data, each on its own page tables (a CR3 switch)\n\nIt prints a line per check and exits 0 when all pass, 1 otherwise. The monitor's test\n(guest_test.go's TestKernelKU1) runs it and holds it to that. amd64 only (KU1, K9).\n" :imports [


    ^{:line 18} [runtime "runtime"]
    ^{:line 19} [strings "strings"]
    ^{:line 20} [unsafe "unsafe"]

    ^{:line 22} [board "arbace/box/board"]
    ^{:line 23} [kernel "arbace/box/kernel"]])


^{:go/end 77} (go/func main []
  (when (board/Process)
    (process)
    (return))

  ;; the kernel. Pin to the boot vCPU: UserSetup writes this vCPU's MSRs, and a process runs on it.
  (runtime/LockOSThread)
  (when [err (board/UserSetup)] (!= err nil)
    (println "ktest: UserSetup:" (.Error err))
    (board/Exit 1))


  (let [ok true
      ^{:line 39} check ^{:go/end 46} (fn [^string name ^bool pass ^string detail]
        (if pass
          (println "ktest:" name "PASS" detail)
          (do
            (println "ktest:" name "FAIL" detail)
            (set! ok false))))



      ;; write: a SYSCALL served, then exit 7.
      ^{:line 49} p (run "write")]
    (check "write" (and (!= p nil) (.-Exited p) (== (.-ExitCode p) 7) (strings/Contains (conv string (.-Output p)) "process says hello"))
      (detailOf p))

    ;; fault: a page fault at a bad address ends the process with a report, not an exit.
    (set! p (run "fault"))
    (check "fault" (and (!= p nil) (.-Exited p) (!= (.-Fault p) nil) (== (.-Vector (.-Fault p)) 14))
      (faultOf p))

    ;; nil: a nil dereference becomes the process's own panic, recovered; exit 5, no fault report.
    (set! p (run "nil"))
    (check "nil" (and (!= p nil) (.-Exited p) (== (.-Fault p) nil) (== (.-ExitCode p) 5) (strings/Contains (conv string (.-Output p)) "recovered"))
      (detailOf p))

    ;; data: two processes of one image, each with its own data and page tables (a CR3 switch).
    (let [a (run "data" "alpha")
        ^{:line 65} b (run "data" "bravo")
        ^{:line 66} distinct (and (!= a nil) (!= b nil) (.-Exited a) (.-Exited b)
          (strings/Contains (conv string (.-Output a)) "data=alpha") (strings/Contains (conv string (.-Output b)) "data=bravo")
          (not (strings/Contains (conv string (.-Output a)) "bravo")) (not (strings/Contains (conv string (.-Output b)) "alpha"))
          (!= (.CR3 a) (.CR3 b)))]
      (check "data" distinct (+ "a=" (trim a) " b=" (trim b)))

      (when ok
        (println "ktest: all checks passed")
        (board/Exit 0))

      (board/Exit 1))))



^{:go/end 91} (go/func run "run makes and runs a process of this image with the command line ktest plus args.\n" ^{:tag (* kernel/Proc)} [& ^{:tag (slice string)} args]
  (let [(values p err) (kernel/NewProc (append (lit (slice string) "ktest") (spread args)) 0)]
    (when (!= err nil)
      (println "ktest: NewProc:" (.Error err))
      (return nil))

    (when [err (.Run p)] (!= err nil)
      (println "ktest: Run:" (.Error err))
      (return nil))

    ^{:line 90} p))


^{:go/end 98} (go/func detailOf ^string [^{:tag (* kernel/Proc)} p]
  (when (== p nil)
    (return "<nil>"))

  (+ "exit=" (itoa (conv int (.-ExitCode p))) " out=" (conv string (.-Output p))))


^{:go/end 105} (go/func faultOf ^string [^{:tag (* kernel/Proc)} p]
  (when (or (== p nil) (== (.-Fault p) nil))
    (return "<no fault>"))

  (.Error (.-Fault p)))


^{:go/end 112} (go/func trim ^string [^{:tag (* kernel/Proc)} p]
  (when (== p nil)
    (return "<nil>"))

  (conv string (.-Output p)))


^{:go/end 134} (go/func itoa ^string [^int v]
  (when (== v 0)
    (return "0"))

  (let [neg (< v 0)]
    (when neg
      (set! v (- v)))

    (let [^{:tag (array 12 byte)} b (zero (array 12 byte))
        ^{:line 123} i (len b)]
      (while (> v 0)
        (dec! i)
        (aset b i (conv byte (+ \0 (% v 10))))
        (set! v / 10))

      (when neg
        (dec! i)
        (aset b i \-))

      (conv string (subslice b i)))))




(go/var ^{:tag string :doc "tag is a process global: each process writes its own, in its private data, so two processes of\none image do not see each other's (the \"data\" check).\n"} tag)



(go/var ^{:tag (* int64) :doc "nilp is a nil pointer the compiler does not fold away: its dereference faults below the first\npage, which the kernel turns into the process's own panic (the \"nil\" check).\n"} nilp)


^{:go/end 181} (go/func process "process is the ring-3 side: the second runtime, talking to the kernel by system calls.\n" []
  (let [args (board/Args)
      ^{:line 147} what ""]
    (when (> (len args) 1)
      (set! what (aget args 1)))

    (switch what
      (case ["write"]
        (println "process says hello")
        (board/Exit 7))
      (case ["fault"]
        ;; a write to a supervisor-only address at ring 3: a page fault the kernel does not return
        ;; from (it is not below the first page, so not a nil dereference).
        (set! @(conv (* int64) (conv unsafe/Pointer (conv uintptr 0xdead0000))) 1)
        (board/Exit 9)) ; not reached
      (case ["nil"]
        (board/NilPanics) ; tell the kernel this process's sigpanic PC
        (defer (^{:go/end 168} (fn []
              (when [r (recover)] (!= r nil)
                (println "recovered nil dereference")
                (board/Exit 5))

              (board/Exit 6)))) ; no panic: a failure

        (set! @nilp 1)
        (board/Exit 8)) ; not reached
      (case ["data"]
        (when (> (len args) 2)
          (set! tag (aget args 2)))

        (println (+ "process data=" tag))
        (board/Exit 0))
      (default
        (println (+ "process: unknown " what))
        (board/Exit 1)))))

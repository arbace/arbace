;; The box's test guests (doc/go/BOX-NOTES.md, "go-whim vendored whole"): the package
;; arbace/box/guest/cmd/faulty, Arbace's own.
(ns go.arbace.box.guest.cmd.faulty
  (:require [arbace.go :as go]))

(go/package main
  :path "arbace/box/guest/cmd/faulty"
  :files ["main.go"]
  :positions :lines)

(load "faulty/main")

;; go-whim's box, vendored (box/README.md): the package arbace/box/abi, one tree for
;; every target (its files' build constraints select them).
(ns go.arbace.box.abi
  (:require [arbace.go :as go]))

(go/package abi
  :path "arbace/box/abi"
  :files ["abi.go"]
  :positions :lines)

(load "abi/abi")

;; The box's test guests (doc/go/BOX-NOTES.md, "go-whim vendored whole"): the package
;; arbace/box/guest, Arbace's own.
(ns go.arbace.box.guest
  (:require [arbace.go :as go]))

(go/package guest
  :path "arbace/box/guest"
  :files ["guest.go"]
  :test-files ["guest_test.go" "readahead_test.go"]
  :positions :lines)

(load "guest/guest")
(load "guest/guest_test")
(load "guest/readahead_test")

  ^{:line 144} [^{:val 36} ECDataAbortLower 0x24] ; EC: a data abort from a lower exception level
  ^{:line 145} [^{:val 22} ECHVC64 0x16]) ; EC: HVC from AArch64



(go/type Syndrome "Syndrome is an ESR_EL2 value, decoded.\n" uint64)


^{:go/end 152} (go/method EC "EC is the exception class, ESR[31:26].\n" ^uint32 [^Syndrome s] (bit-and (conv uint32 (>> s 26)) 0x3f))


^{:go/end 155} (go/method IL "IL is whether the trapped instruction was 32 bits, ESR[25].\n" ^bool [^Syndrome s] (!= (bit-and (>> s 25) 1) 0))



^{:go/end 159} (go/method ISV "ISV is whether a data abort's instruction syndrome (SAS, SRT, WnR) is valid,\nISS[24].\n" ^bool [^Syndrome s] (!= (bit-and (>> s 24) 1) 0))


^{:go/end 162} (go/method SAS "SAS is the access size, 1 << SAS bytes, ISS[23:22].\n" ^uint32 [^Syndrome s] (bit-and (conv uint32 (>> s 22)) 3))


^{:go/end 165} (go/method SRT "SRT is the register the store read or the load wrote, ISS[20:16].\n" ^uint32 [^Syndrome s] (bit-and (conv uint32 (>> s 16)) 0x1f))


^{:go/end 168} (go/method WnR "WnR is whether the access was a write, ISS[6].\n" ^bool [^Syndrome s] (!= (bit-and (>> s 6) 1) 0))




^{:go/end 183} (go/func DataAbort "DataAbort is the syndrome of a data abort from a lower level with a valid\ninstruction syndrome: what the framework reports for a store to an\nunmapped IPA, and what the KVM backend makes of an MMIO exit.\n" ^Syndrome [^int size ^uint32 srt ^bool write]
  (let [sas (conv uint64 0)]
    (while (< ^int (<< 1 sas) size)
      (inc! sas))

    (let [s (bit-or (<< (conv uint64 ECDataAbortLower) 26) (<< 1 25) (<< 1 24) (<< sas 22) (<< (conv uint64 (bit-and srt 0x1f)) 16))]
      (when write
        (set! s bit-or (<< 1 6)))

      (conv Syndrome s))))

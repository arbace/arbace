^{:go/end 175} (go/func VCPUCreate "VCPUCreate is hv_vcpu_create, on the calling thread (locked: LockThread),\nthe vCPU put on the VM's virtual counter: the first's vTimer offset\nread, every later one's set to it (hv_vcpu_*_vtimer_offset, on the\nvCPU's own thread).\n" [] :results [VCPU (* VCPUExit) error]
  (let [^uint64 v (zero uint64)
      ^{:line 156 :tag (* cExit)} e (zero (* cExit))]
    (when [err (ret (hvVCPUCreate (addr v) (addr e) 0))] (!= err nil)
      (return 0 nil err))

    (.Lock exitsMu)
    (defer (.Unlock exitsMu))
    (let [^error err (zero error)]
      (if vmCounterSet
        (set! err (ret (hvVCPUSetVTimerOff v vmCounter)))
        (when [(set! err (ret (hvVCPUGetVTimerOff v (addr vmCounter))))] (== err nil)
          (set! vmCounterSet true)))

      (when (!= err nil)
        (hvVCPUDestroy v)
        (return 0 nil (fmt/Errorf "the vCPU's vTimer offset: %w" err)))

      (let [rec (addr (lit VCPUExit))]
        (aset exits (conv VCPU v) (lit vcpuExits e rec))
        (return (conv VCPU v) rec nil)))))




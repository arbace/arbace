^{:go/end 137} (go/func VMCreate "VMCreate is hv_vm_create, with hv_vm_config_set_ipa_size when asked (the\nconfig object is not released: one, for the process's one VM).\n" ^error [^{:tag (* VMConfig)} config]
  (when [err (load)] (!= err nil)
    (return err))

  (.Lock exitsMu)
  (set! vmCounterSet false)
  (.Unlock exitsMu)
  (let [c (conv uintptr 0)]
    (when (and (!= config nil) (!= (.-IPASize config) 0))
      (set! c (hvVMConfigCreate))
      (when [err (ret (hvVMConfigSetIPASize c (.-IPASize config)))] (!= err nil)
        (return err)))


    (ret (hvVMCreate c))))




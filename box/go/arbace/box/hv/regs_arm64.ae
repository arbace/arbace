(go/type SysReg "SysReg is hv_sys_reg_t.  Apple's value for a system register is its\nencoding, op0<<14 | op1<<11 | CRn<<7 | CRm<<3 | op2 -- the same packing as\nKVM's ARM64_SYS_REG, which the KVM backend relies on.\n" uint16)


(go/const "The HV_SYS_REG_ values used here.\n"
  ^{:line 55} [^{:tag SysReg :val 49280} SysRegSCTLREL1 0xc080]
  ^{:line 56} [^{:tag SysReg :val 49282} SysRegCPACREL1 0xc082]

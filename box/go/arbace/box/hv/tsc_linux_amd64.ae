(in-ns 'go.arbace.box.hv) (go/file "tsc_linux_amd64.go" :imports [])


(go/const ^{:val 44707 :doc "kvmGetTSCKHz is KVM_GET_TSC_KHZ, _IO(KVMIO, 0xa3), on a vCPU.\n"} kvmGetTSCKHz 0xaea3)






^{:go/end 21} (go/func TSCFrequency "TSCFrequency is the rate of the vCPU's time-stamp counter, in kHz: what a\nguest that keeps its own clock (a Go runtime's nanotime) needs, and has no\narchitectural way to ask on amd64 -- arm64's CNTFRQ_EL0 says it there.\nKVM's answer, KVM_GET_TSC_KHZ; not part of Hypervisor.framework's API,\nwhich has no amd64 guest here.\n" [^VCPU v] :results [uint64 error]
  (let [(values c err) (get v)]
    (when (!= err nil)
      (return 0 err))

    (let [(values khz ^:assign err) (ioctl (.-fd c) kvmGetTSCKHz 0)]
      (when (!= err nil)
        (return 0 (fail Error "KVM_GET_TSC_KHZ" err)))

      (return (conv uint64 khz) nil))))

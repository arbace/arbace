(in-ns 'go.arbace.box.hv) (go/file "regs_amd64.go" :imports [])





(go/type Reg "Reg is a general register, RIP or RFLAGS: x86 names behind the\nframework's shape (Apple's x86 API is not the model).  RAX is 0, so that\na doorbell store's SRT of 0 names the register the store read (the\nguest's ABI stores from RAX).\n" uint32)


(go/const "The x86-64 registers, in KVM's struct kvm_regs order.\n"
  ^{:line 11} [^{:tag Reg :val 0} RegRAX iota]
  ^{:line 12} [^{:val 1} RegRBX]
  ^{:line 13} [^{:val 2} RegRCX]
  ^{:line 14} [^{:val 3} RegRDX]
  ^{:line 15} [^{:val 4} RegRSI]
  ^{:line 16} [^{:val 5} RegRDI]
  ^{:line 17} [^{:val 6} RegRSP]
  ^{:line 18} [^{:val 7} RegRBP]
  ^{:line 19} [^{:val 8} RegR8]
  ^{:line 20} [^{:val 9} RegR9]
  ^{:line 21} [^{:val 10} RegR10]
  ^{:line 22} [^{:val 11} RegR11]
  ^{:line 23} [^{:val 12} RegR12]
  ^{:line 24} [^{:val 13} RegR13]
  ^{:line 25} [^{:val 14} RegR14]
  ^{:line 26} [^{:val 15} RegR15]
  ^{:line 27} [^{:val 16} RegRIP]
  ^{:line 28} [^{:val 17} RegRFLAGS])




(go/type SysReg "SysReg is a control register, EFER, a descriptor table's base or limit, or\none of a segment's four fields: what KVM keeps in struct kvm_sregs.\n" uint16)


(go/const "The system registers.\n"
  ^{:line 37} [^{:tag SysReg :val 1} SysRegCR0 (+ iota 1)]
  ^{:line 38} [^{:val 2} SysRegCR2]
  ^{:line 39} [^{:val 3} SysRegCR3]
  ^{:line 40} [^{:val 4} SysRegCR4]
  ^{:line 41} [^{:val 5} SysRegEFER]
  ^{:line 42} [^{:val 6} SysRegGDTRBase]
  ^{:line 43} [^{:val 7} SysRegGDTRLimit]
  ^{:line 44} [^{:val 8} SysRegIDTRBase]
  ^{:line 45} [^{:val 9} SysRegIDTRLimit])



(go/type Segment "Segment is a segment register, in struct kvm_sregs' order.\n" uint16)


(go/const "The segments.\n"
  ^{:line 53} [^{:tag Segment :val 0} SegCS iota]
  ^{:line 54} [^{:val 1} SegDS]
  ^{:line 55} [^{:val 2} SegES]
  ^{:line 56} [^{:val 3} SegFS]
  ^{:line 57} [^{:val 4} SegGS]
  ^{:line 58} [^{:val 5} SegSS]
  ^{:line 59} [^{:val 6} SegTR]
  ^{:line 60} [^{:val 7} SegLDTR])



(go/const "The four fields of a segment, as VMX names them.\n"
  ^{:line 65} [^{:val 0} segSelector iota]
  ^{:line 66} [^{:val 1} segBase]
  ^{:line 67} [^{:val 2} segLimit]
  ^{:line 68} [^{:val 3} segAR])


(go/const ^{:tag SysReg :val 256} segFirst 0x100)




^{:go/end 76} (go/method Selector "Selector, Base, Limit and AR are the segment's fields as system registers.\nAR is VMX's access-rights encoding: type in bits 0-3, S 4, DPL 5-6, P 7,\nAVL 12, L 13, D/B 14, G 15, unusable 16.\n" ^SysReg [^Segment s] (+ segFirst (* (conv SysReg s) 4) segSelector))
^{:go/end 77} (go/method Base ^SysReg [^Segment s] (+ segFirst (* (conv SysReg s) 4) segBase))
^{:go/end 78} (go/method Limit ^SysReg [^Segment s] (+ segFirst (* (conv SysReg s) 4) segLimit))
^{:go/end 79} (go/method AR ^SysReg [^Segment s] (+ segFirst (* (conv SysReg s) 4) segAR))



^{:go/end 83} (go/func RegForSRT "RegForSRT is the register a data abort's SRT names; the KVM backend\nreports 0, RAX, for a store whose value RAX holds.\n" [^uint32 srt] :results [Reg bool] (return (conv Reg srt) (<= srt (conv uint32 RegR15))))

^{:go/end 408} (go/func describe ^string [^{:tag (* vcpu)} c ^uint32 reason]
  (switch reason
    (case [kvmExitHLT]
      (return "KVM_EXIT_HLT"))
    (case [kvmExitShutdown]
      (return "KVM_EXIT_SHUTDOWN (a triple fault)"))
    (case [kvmExitFailEntry]
      (return (fmt/Sprintf "KVM_EXIT_FAIL_ENTRY, hardware reason %#x" (.u64 c kvmFailEntryReason))))
    (case [kvmExitInternalError]
      (return (fmt/Sprintf "KVM_EXIT_INTERNAL_ERROR, suberror %d" (.u32 c kvmInternalSuberror))))
    (case [kvmExitSystemEvent]
      (return (fmt/Sprintf "KVM_EXIT_SYSTEM_EVENT, type %d" (.u32 c kvmSystemEventType))))
    (case [kvmExitIO]
      (return (fmt/Sprintf "KVM_EXIT_IO, port %#x" (.u16 c kvmIOPort))))
    (case [kvmExitHypercall]
      (return (fmt/Sprintf "KVM_EXIT_HYPERCALL, nr %#x" (.u64 c kvmHypercallNr))))
    (case [kvmExitUnknown]
      (return "KVM_EXIT_UNKNOWN")))

  (fmt/Sprintf "KVM exit reason %d" reason))



  (range [ioctlRetries]
    (when (!= at nil)
      (set! @at (conv uint64 (conv uintptr inner))))

    (let [(values r _ e) (syscall/Syscall syscall/SYS_IOCTL (conv uintptr fd) req (conv uintptr arg))]
      (when (or (== e syscall/EINTR) (== e syscall/EAGAIN))
        (continue))

      (when (!= e 0)
        (return r e))

      (return r nil)))

  (return 0 syscall/EINTR))



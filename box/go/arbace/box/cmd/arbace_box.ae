;; The box's launcher (doc/go/BOX-NOTES.md, S1): the package arbace/box/cmd/arbace-box, Arbace's own.
(ns go.arbace.box.cmd.arbace_box
  (:require [arbace.go :as go]))

(go/package main
  :path "arbace/box/cmd/arbace-box"
  :files ["console.go" "console_darwin.go" "console_linux.go" "main.go" "net.go" "rlwrap_unix.go" "store.go"]
  :positions :lines)

(load "arbace_box/console")
(load "arbace_box/console_darwin")
(load "arbace_box/console_linux")
(load "arbace_box/main")
(load "arbace_box/net")
(load "arbace_box/rlwrap_unix")
(load "arbace_box/store")

(in-ns 'go.arbace.box.cmd.arbace_box) (go/file "net.go" :imports [


    ^{:line 4} [fmt "fmt"]
    ^{:line 5} [os "os"]

    ^{:line 7} [vmm "arbace/box/vmm"]])














^{:go/end 35} (go/func netConfig "netConfig gives the guest a network when ARBACE_BOX_NET says what it may\ndo (doc/go/BOX-NOTES.md, S5; vmm.ParseNetPolicy): none without it, the\nsocket servers' default, listening on the host's loopback addresses,\nwith \"listen\", the box's and the host's loopback with \"loopback\", and\ndial=HOST:PORT patterns for the hosts it may reach, by address or by\nname (resolved by the host, as only names the policy names are).  E.g.\n\n\tARBACE_BOX_NET=listen                    a socket REPL on the host's loopback\n\tARBACE_BOX_NET=loopback,dial=*.example.org:443\n\nThe system-call filter then lets the monitor's sockets through\n(vmm.SeccompNet).\n" [^{:tag (* vmm/Config)} cfg]
  (let [spec (os/Getenv "ARBACE_BOX_NET")
      (values p err) (vmm/ParseNetPolicy spec)]
    (when (!= err nil)
      (fail (fmt/Errorf "ARBACE_BOX_NET=%s: %w" spec err)))

    (when (== p nil)
      (return))

    (set! (.-Net cfg) (vmm/NewNet p))
    (when (!= (.-Seccomp cfg) nil)
      (set! (.-Seccomp cfg) vmm/SeccompNet))))

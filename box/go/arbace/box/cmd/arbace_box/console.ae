

(in-ns 'go.arbace.box.cmd.arbace_box) (go/file "console.go" :build ["//go:build linux"] :imports [


    ^{:line 6} [os "os"]
    ^{:line 7} [syscall "syscall"]])





(go/type console "console is the guest's Host (vmm.Host): this process's standard streams,\ncooked -- the terminal, if any, as the host has it -- and no terminal of\nits own (not a vmm.TermHost).\n" (struct))

^{:go/end 15} (go/func newConsole ^{:tag (* console)} [] (addr (lit console)))



^{:go/end 40} (go/method WaitForInput "WaitForInput waits up to ms milliseconds (for ever when negative) for\nstandard input to be readable: input, or its end.\n" ^bool [^{:tag (* console)} c ^int64 ms]
  (let [^syscall/Timeval tv (zero syscall/Timeval)
      ^{:line 21 :tag (* syscall/Timeval)} tvp (zero (* syscall/Timeval))]
    (when (>= ms 0)
      (set! tv (syscall/NsecToTimeval (* ms 1000000.0)))
      (set! tvp (addr tv)))

    (while true
      (let [^syscall/FdSet r (zero syscall/FdSet)]
        (aset (.-Bits r) 0 1)
        (let [(values n err) (syscall/Select 1 (addr r) nil nil tvp)]
          (when (== err syscall/EINTR)
            (continue))

          (when (!= err nil)
            ;; not a descriptor select can wait on (closed): its read
            ;; answers
            (return true))

          (return (> n 0)))))))






^{:go/end 45} (go/method WatchInput "WatchInput is WaitForInput from the monitor's own goroutine\n(vmm.InputWatcher): select reads nothing, so it may run beside the\nguest's calls.\n" ^bool [^{:tag (* console)} c ^int64 ms] (.WaitForInput c ms))


^{:go/end 59} (go/method ReadInput "ReadInput reads standard input: the count, 0 at its end (or an error).\n" ^int32 [^{:tag (* console)} c ^{:tag (slice byte)} buf]
  (while true
    (let [(values n err) (syscall/Read 0 buf)]
      (when (== err syscall/EINTR)
        (continue))

      (when (or (!= err nil) (< n 0))
        (return 0))

      (return (conv int32 n)))))




^{:go/end 68} (go/method Write "Write writes the guest's output to standard output.\n" ^int32 [^{:tag (* console)} c ^{:tag (slice byte)} p]
  (let [(values n err) (.Write os/Stdout p)]
    (when (and (!= err nil) (== n 0))
      (return -1))

    (conv int32 n)))



^{:go/end 77} (go/method Message "Message writes to standard error, or to standard output when not err.\n" [^{:tag (* console)} c ^{:tag (slice byte)} msg ^bool err]
  (if err
    (.Write os/Stderr msg)

    (.Write os/Stdout msg)))




^{:go/end 80} (go/method Exit "Exit returns: the run ends with the code, which main exits with.\n" [^{:tag (* console)} c ^int32 code])

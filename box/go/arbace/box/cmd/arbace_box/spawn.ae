^{:go/end 283} (go/method answer [^{:tag (* spawnerState)} s ^string what ^string id ^string msg]
  (.Lock (.-out s))
  (defer (.Unlock (.-out s)))
  (fmt/Printf "%s %s %s\n" what id (strings/ReplaceAll msg "\n" " ")))



^{:go/end 325} (go/method schedule "schedule starts the queue's first jobs while they fit.\n" [^{:tag (* spawnerState)} s]
  (.Lock (.-mu s))
  (defer (.Unlock (.-mu s)))
  (while (and (> (len (.-queue s)) 0) (not (.-closed s)))
    (let [j (aget (.-queue s) 0)]
      (when (or (> (+ (.-usedRAM s) (.-ram j)) (.-ram s)) (> (+ (.-usedCPUs s) (.-cpus j)) (.-cpus s)))
        (return))

      (set! (.-queue s) (subslice (.-queue s) 1))
      (set! (.-usedRAM s) + (.-ram j))
      (set! (.-usedCPUs s) + (.-cpus j))
      (let [cmd (exec/Command (.-exe s) "--store" (.-dir s) "--tool" (.-req j))]
        (set! (.-Env cmd) (.-env s))
        (set! (.-Stderr cmd) os/Stderr)
        (let [^strings/Builder out (zero strings/Builder)]
          (set! (.-Stdout cmd) (addr out))
          (when [err (.Start cmd)] (!= err nil)
            (set! (.-usedRAM s) - (.-ram j))
            (set! (.-usedCPUs s) - (.-cpus j))
            (go (.answer s "fail" (.-id j) (.Error err)))
            (continue))

          (aset (.-running s) cmd true)
          (go (^{:go/end 323} (fn []
                (let [err (.Wait cmd)]
                  (.Lock (.-mu s))
                  (delete (.-running s) cmd)
                  (set! (.-usedRAM s) - (.-ram j))
                  (set! (.-usedCPUs s) - (.-cpus j))
                  (.Unlock (.-mu s))
                  (let [res (strings/TrimSpace (.String out))]
                    (if [(values _ ok) (tree/ParseHash res)] (and (== err nil) ok)
                      (.answer s "done" (.-id j) res)

                      (.answer s "fail" (.-id j) (fmt/Sprintf "the tool's launcher: %v" err)))

                    (.schedule s)))))))))))







      (return nil (errors/New (+ "ARBACE_BOX_IMAGE=" p ": no store (ARBACE_BOX_STORE, --store DIR)"))))

    (let [(values st err) (openStore storeDir)]
      (when (!= err nil)
        (return nil err))

      (when isRef
        (let [^bool ok (zero bool)]
          (when [(set! (values h ok) (.Ref st name))] (not ok)
            (return nil (errors/New (+ "ARBACE_BOX_IMAGE=" p ": no such ref"))))))


      (when [(values _ ok) (.Size st h)] (not ok)
        (return nil (fmt/Errorf "ARBACE_BOX_IMAGE=%s: no blob %x" p h)))

      (when [(values _ ok) (readBlob st h)] (not ok)
        (return nil (fmt/Errorf "ARBACE_BOX_IMAGE=%s: blob %x does not read back whole" p h)))

      (vmm/OpenImage (filepath/Join storeDir "blobs" (hex/EncodeToString (subslice h)))))))

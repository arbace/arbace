;; Tool guests (doc/go/BOX-NOTES.md, S7).  With ARBACE_BOX_SPAWN=1 and a
;; store, a guest may spawn others (vmm.Spawner): each request a blob of the
;; store (tree.Request), each child a launcher process of its own run as
;; `arbace-box --store DIR --tool REQUEST` (Hypervisor.framework gives a
;; process one VM, and the monitor's system-call filter allows no exec), by
;; a helper process the launcher starts before the filter goes on
;; (`arbace-box --spawner DIR`), which holds the budget: the RAM and vCPUs of
;; the children running at once, ARBACE_BOX_SPAWN_RAM (storeSize's units; by
;; default half the host's available memory) and ARBACE_BOX_SPAWN_CPUS (by
;; default the host's CPUs).  A request asking more than the budget is
;; refused; one that does not fit beside those running waits, first come
;; first served.



(go/const ^{:val 3221225472 :doc "defaultToolRAM is a child's RAM when its request asks none: vmm's\ndefault slot.\n"} defaultToolRAM (<< 3 30))



(go/const ^{:val 16777216 :doc "consoleMax is the most of a child's console its result keeps: the rest\nis dropped, and a line says so.\n"} consoleMax (<< 16 20))



(go/var ^{:doc "The environment a child launcher inherits from the helper: the store's\nand the monitor's settings, nothing of the guest's.\n"} toolLauncherEnv (lit (slice string) "ARBACE_BOX_STORE_MAX" "ARBACE_BOX_STORE_CACHE" "ARBACE_BOX_SECCOMP" "ARBACE_BOX_PARK" "ARBACE_BOX_WATCHDOG"))



(go/type spawnClient "spawnClient is the monitor's side of the helper: vmm.Spawner over its\nstandard input and output, one line a message.\n" (struct
    ^{:line 49 :tag sync/Mutex} mu
    ^{:line 50 :tag io/Writer} w
    ^{:line 51 :tag int64} next
    ^{:line 52 :tag (map int64 (* spawnJob))} jobs
    ^{:line 53 :tag error} dead))


(go/type spawnJob (struct
    ^{:line 57 :tag (array 32 byte)} res
    ^{:line 58 :tag bool} ended
    ^{:line 59 :tag error} err
    ^{:line 60 :tag (func [])} done))



^{:go/end 81} (go/func startSpawner "startSpawner starts the helper for the store in dir.\n" [^string exe ^string dir] :results [(* spawnClient) error]
  (let [cmd (exec/Command exe "--spawner" dir)]
    (set! (.-Stderr cmd) os/Stderr)
    (let [(values in err) (.StdinPipe cmd)]
      (when (!= err nil)
        (return nil err))

      (let [(values out ^:assign err) (.StdoutPipe cmd)]
        (when (!= err nil)
          (return nil err))

        (when [err (.Start cmd)] (!= err nil)
          (return nil err))

        (let [c (addr (lit spawnClient :w in :jobs (lit (map int64 (* spawnJob)))))]
          (go (.read c out))
          (return c nil))))))



^{:go/end 121} (go/method read "read takes the helper's answers: done ID RESULT, or fail ID WHY.\n" [^{:tag (* spawnClient)} c ^io/Reader r]
  (let [sc (bufio/NewScanner r)]
    (while (.Scan sc)
      (let [f (strings/SplitN (.Text sc) " " 3)]
        (when (!= (len f) 3)
          (continue))

        (let [(values id err) (strconv/ParseInt (aget f 1) 10 64)]
          (when (!= err nil)
            (continue))

          (.Lock (.-mu c))
          (let [j (aget (.-jobs c) id)]
            (when (or (== j nil) (.-ended j))
              (.Unlock (.-mu c))
              (continue))

            (set! (.-ended j) true)
            (switch [(values h ok) (tree/ParseHash (aget f 2))]
              (case [(and (== (aget f 0) "done") ok)]
                (set! (.-res j) h))
              (default
                (set! (.-err j) (errors/New (aget f 2)))))

            (let [done (.-done j)]
              (.Unlock (.-mu c))
              (done))))))

    (.Lock (.-mu c))
    (defer (.Unlock (.-mu c)))
    (set! (.-dead c) (errors/New "the spawner has ended"))
    (range [_ j (.-jobs c)]
      (when (not (.-ended j))
        (set! (values (.-ended j) (.-err j)) (values true (.-dead c)))
        (go ((.-done j)))))))




^{:go/end 136} (go/method Start [^{:tag (* spawnClient)} c ^{:tag (array 32 byte)} req ^{:tag (func [])} done] :results [int64 error]
  (.Lock (.-mu c))
  (defer (.Unlock (.-mu c)))
  (when (!= (.-dead c) nil)
    (return 0 (.-dead c)))

  (let [id (.-next c)]
    (when [(values _ err) (fmt/Fprintf (.-w c) "start %d %s\n" id (hex/EncodeToString (subslice req)))] (!= err nil)
      (return 0 err))

    (inc! (.-next c))
    (aset (.-jobs c) id (addr (lit spawnJob :done done)))
    (return id nil)))


^{:go/end 150} (go/method Poll [^{:tag (* spawnClient)} c ^int64 h] :results [(array 32 byte) bool error]
  (.Lock (.-mu c))
  (defer (.Unlock (.-mu c)))
  (let [j (aget (.-jobs c) h)]
    (switch
      (case [(== j nil)]
        (return (lit (array 32 byte)) false (errors/New "no such spawn")))
      (case [(not (.-ended j))]
        (return (lit (array 32 byte)) false nil)))

    (delete (.-jobs c) h)
    (return (.-res j) true (.-err j))))



(go/type treeStore "treeStore is a vmm.Store as the trees' store (tree.Store).\n" (struct vmm/Store))

^{:go/end 161} (go/method Read [^treeStore s ^{:tag (array 32 byte)} h] :results [(slice byte) error]
  (let [(values b ok) (readBlob (.-Store s) h)]
    (when (not ok)
      (return nil (fmt/Errorf "no blob %x" h)))

    (return b nil)))






^{:go/end 240} (go/func spawner "spawner is the helper (`arbace-box --spawner DIR`): it reads start ID\nREQUEST lines, runs each request's child when the budget lets it, and\nwrites done ID RESULT or fail ID WHY.  At the end of its input it ends\nthe children still running, and itself.\n" ^int [^string dir]
  (let [(values st err) (openStore dir)]
    (when (!= err nil)
      (fmt/Fprintln os/Stderr "arbace-box --spawner:" err)
      (return 1))

    (let [(values exe ^:assign err) (os/Executable)]
      (when (!= err nil)
        (fmt/Fprintln os/Stderr "arbace-box --spawner:" err)
        (return 1))

      (let [(values ramBudget ^:assign err) (storeSize "ARBACE_BOX_SPAWN_RAM" (defaultSpawnRAM))]
        (when (or (!= err nil) (<= ramBudget 0))
          (fmt/Fprintln os/Stderr "arbace-box --spawner: ARBACE_BOX_SPAWN_RAM:" err)
          (return 1))

        (let [cpuBudget (runtime/NumCPU)]
          (when [s (os/Getenv "ARBACE_BOX_SPAWN_CPUS")] (!= s "")
            (when [(set! (values cpuBudget err) (strconv/Atoi s))] (or (!= err nil) (< cpuBudget 1))
              (fmt/Fprintln os/Stderr (+ "arbace-box --spawner: ARBACE_BOX_SPAWN_CPUS=" s ": not a count"))
              (return 1)))


          (let [^{:tag (slice string)} env (zero (slice string))]
            (range [_ n toolLauncherEnv]
              (when [(values v ok) (os/LookupEnv n)] ok
                (set! env (append env (+ n "=" v)))))


            (let [s (addr (lit spawnerState :exe exe :dir dir :env env :ram ramBudget :cpus cpuBudget :running (lit (map (* exec/Cmd) bool))))]
              (set! (.-cond s) (sync/NewCond (addr (.-mu s))))
              ^{:go/breaks [7]} (let [sc (bufio/NewScanner os/Stdin)]
                (while (.Scan sc)
                  (let [f (strings/Fields (.Text sc))]
                    (when (or (!= (len f) 3) (!= (aget f 0) "start"))
                      (continue))

                    (let [id (aget f 1)
                        (values h ok) (tree/ParseHash (aget f 2))]
                      (when (not ok)
                        (.answer s "fail" id "not a hash")
                        (continue))

                      (let [(values b ^:assign ok) (readBlob st h)]
                        (when (not ok)
                          (.answer s "fail" id "no such request")
                          (continue))

                        (let [(values req err) (tree/ParseRequest b)]
                          (when (!= err nil)
                            (.answer s "fail" id (.Error err))
                            (continue))

                          (let [(values ram cpus) (values (.-RAM req) (max (.-CPUs req) 1))]
                            (when (== ram 0)
                              (set! ram defaultToolRAM))

                            (when (or (> ram (.-ram s)) (> cpus (.-cpus s)))
                              (.answer s "fail" id (fmt/Sprintf "the request asks %d bytes and %d vCPUs, beyond the budget (%d, %d)" ram cpus (.-ram s) (.-cpus s)))
                              (continue))

                            (.Lock (.-mu s))
                            (set! (.-queue s) (append (.-queue s) (addr (lit spawnerJob :id id :req (aget f 2) :ram ram :cpus cpus))))
                            (.Unlock (.-mu s))
                            (.schedule s)))))))

                (.Lock (.-mu s))
                (set! (.-closed s) true)
                (range [cmd (.-running s)]
                  (.Kill (.-Process cmd)))

                (.Unlock (.-mu s))
                0))))))))




^{:go/end 256} (go/func defaultSpawnRAM "defaultSpawnRAM is half the host's available memory (MemAvailable), or\n8 GiB where the host does not say.\n" ^int64 []
  (let [(values b err) (os/ReadFile "/proc/meminfo")]
    (when (== err nil)
      (range [_ l (strings/Split (conv string b) "\n")]
        (when [f (strings/Fields l)] (and (>= (len f) 2) (== (aget f 0) "MemAvailable:"))
          (when [(values kb err) (strconv/ParseInt (aget f 1) 10 64)] (== err nil)
            (return (/ (<< kb 10) 2))))))




    (<< 8 30)))


(go/type spawnerState (struct
    ^{:line 259 :tag string} exe ^string dir
    ^{:line 260 :tag (slice string)} env

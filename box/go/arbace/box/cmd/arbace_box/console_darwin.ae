(in-ns 'go.arbace.box.cmd.arbace_box) (go/file "console_darwin.go" :imports [


    ^{:line 4} [bits "math/bits"]
    ^{:line 5} [syscall "syscall"]])




^{:go/end 19} (go/func selectRead "selectRead is select(2) on reading, the count of descriptors ready, as\nLinux's: macOS's select returns no count (go-whim's editor/term, sel).\n" [^int nfd ^{:tag (* syscall/FdSet)} r ^{:tag (* syscall/Timeval)} tv] :results [int error]
  (when [err (syscall/Select nfd r nil nil tv)] (!= err nil)
    (return -1 err))

  (let [n 0]
    (for [i 0] (< (* i 32) nfd) (inc! i)
      (set! n + (bits/OnesCount32 (conv uint32 (aget (.-Bits r) i)))))

    (return n nil)))



(go/const ^{:val 1078490131 :doc "tcgets is tcgetattr's ioctl request (macOS's TIOCGETA).\n"} tcgets syscall/TIOCGETA)

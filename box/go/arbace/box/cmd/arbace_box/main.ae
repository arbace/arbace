;; Command arbace-box is Arbace in the box (doc/go/BOX-NOTES.md, S1): the
;; monitor (package vmm) running Arbace's Go program, built for TamaGo
;; (GOOS=tamago, the board arbace/box/board), as a guest of /dev/kvm, with
;; the guest's console on this process's standard streams.  Its arguments
;; are arbace.main's, as for the executable bin/arbace-go builds: -e, -m, a
;; script (one the guest's image or its in-memory file system holds), - or
;; none for the REPL.  The guest's exit code is the process's.
;;
;; The image is ARBACE_BOX_IMAGE=FILE when that is set, else the one
;; appended to the program (vmm.Append), else the file beside it named as
;; it is with .elf added.
;;
;; The guest's command line is "arbace" and this program's arguments; its
;; environment, written at its entry (guest/abi), the variables TZ, LANG,
;; LANGUAGE, LC_*, GOGC, GOMEMLIMIT, JAVA_TOOL_OPTIONS and ARBACE_* but
;; ARBACE_BOX_* (ARBACE_BOX_FS excepted), and those ARBACE_BOX_ENV names
;; (separated by commas).
;;
;; ARBACE_BOX_CPUS=N gives the guest N vCPUs (1 to vmm.MaxCPUs, "host" the
;; host's CPUs so capped; by default 4, or the host's CPUs when fewer).
;; ARBACE_BOX_WATCHDOG=DURATION ends a guest that runs that long without a
;; hypercall (by default none: an evaluation may compute without output for
;; as long as it takes).  ARBACE_BOX_STATS=FILE appends the run's counts to
;; FILE when it ends; ARBACE_BOX_SECCOMP=0 leaves the system-call filter off;
;; ARBACE_BOX_PARK=DURATION is the longest a parked vCPU waits while another
;; runs (vmm.DefaultPark).  ARBACE_BOX_MAP=0 copies the
;; image's segments into the guest's memory rather than mapping them from
;; the file (vmm.ImageFile's Copy: a faster start under nested
;; virtualization, for the image's pages in this process).
;;
;; The store (doc/go/BOX-NOTES.md, S3; the namespace arbace.box) is the
;; directory ARBACE_BOX_STORE=DIR names, or --store DIR before the
;; arguments (vmm.DirStore); without either the guest has none, and its
;; store calls answer abi.StoreNone.  ARBACE_BOX_STORE_MAX=SIZE is the
;; largest blob it takes (bytes, or with B, KiB, MiB, GiB or TiB; off: no
;; limit; by default 256 MiB).  ARBACE_BOX_FS=REF, which the guest sees,
;; seeds its in-memory file system from the snapshot REF names (a tar,
;; arbace.box/save-fs!).  --store DIR followed by put, get, ref or ls is
;; the store's tool (storeTool), which runs no guest.
;;
;; The console is cooked: the terminal stays as the host has it, so that
;; Ctrl-C ends this process (and the guest) as it ends the JVM.  The REPL
;; runs under rlwrap as the executable's does (ARBACE_RLWRAP;
;; doc/go/EXEC-NOTES.md, "Line editing: rlwrap"): this program is what runs
;; under it.
(in-ns 'go.arbace.box.cmd.arbace_box) (go/file "main.go" :doc "Command arbace-box is Arbace in the box (doc/go/BOX-NOTES.md, S1): the\nmonitor (package vmm) running Arbace's Go program, built for TamaGo\n(GOOS=tamago, the board arbace/box/board), as a guest of /dev/kvm, with\nthe guest's console on this process's standard streams.  Its arguments\nare arbace.main's, as for the executable bin/arbace-go builds: -e, -m, a\nscript (one the guest's image or its in-memory file system holds), - or\nnone for the REPL.  The guest's exit code is the process's.\n\nThe image is ARBACE_BOX_IMAGE=FILE when that is set, else the one\nappended to the program (vmm.Append), else the file beside it named as\nit is with .elf added.\n\nThe guest's command line is \"arbace\" and this program's arguments; its\nenvironment, written at its entry (guest/abi), the variables TZ, LANG,\nLANGUAGE, LC_*, GOGC, GOMEMLIMIT, JAVA_TOOL_OPTIONS and ARBACE_* but\nARBACE_BOX_* (ARBACE_BOX_FS excepted), and those ARBACE_BOX_ENV names\n(separated by commas).\n\nARBACE_BOX_CPUS=N gives the guest N vCPUs (1 to vmm.MaxCPUs, \"host\" the\nhost's CPUs so capped; by default 4, or the host's CPUs when fewer).\nARBACE_BOX_WATCHDOG=DURATION ends a guest that runs that long without a\nhypercall (by default none: an evaluation may compute without output for\nas long as it takes).  ARBACE_BOX_STATS=FILE appends the run's counts to\nFILE when it ends; ARBACE_BOX_SECCOMP=0 leaves the system-call filter off;\nARBACE_BOX_PARK=DURATION is the longest a parked vCPU waits while another\nruns (vmm.DefaultPark).  ARBACE_BOX_MAP=0 copies the\nimage's segments into the guest's memory rather than mapping them from\nthe file (vmm.ImageFile's Copy: a faster start under nested\nvirtualization, for the image's pages in this process).\n\nThe store (doc/go/BOX-NOTES.md, S3; the namespace arbace.box) is the\ndirectory ARBACE_BOX_STORE=DIR names, or --store DIR before the\narguments (vmm.DirStore); without either the guest has none, and its\nstore calls answer abi.StoreNone.  ARBACE_BOX_STORE_MAX=SIZE is the\nlargest blob it takes (bytes, or with B, KiB, MiB, GiB or TiB; off: no\nlimit; by default 256 MiB).  ARBACE_BOX_FS=REF, which the guest sees,\nseeds its in-memory file system from the snapshot REF names (a tar,\narbace.box/save-fs!).  --store DIR followed by put, get, ref or ls is\nthe store's tool (storeTool), which runs no guest.\n\nThe console is cooked: the terminal stays as the host has it, so that\nCtrl-C ends this process (and the guest) as it ends the JVM.  The REPL\nruns under rlwrap as the executable's does (ARBACE_RLWRAP;\ndoc/go/EXEC-NOTES.md, \"Line editing: rlwrap\"): this program is what runs\nunder it.\n" :imports [


    ^{:line 49} [errors "errors"]
    ^{:line 50} [fmt "fmt"]
    ^{:line 51} [os "os"]
    ^{:line 52} [runtime "runtime"]
    ^{:line 53} [strconv "strconv"]
    ^{:line 54} [strings "strings"]
    ^{:line 55} [time "time"]

    ^{:line 57} [vmm "arbace/box/vmm"]])


^{:go/end 138} (go/func main []
  (let [args (subslice os/Args 1)
      ^{:line 62} storeDir (os/Getenv "ARBACE_BOX_STORE")]
    (when (and (>= (len args) 2) (== (aget args 0) "--store"))
      (set! (values storeDir args) (values (aget args 1) (subslice args 2)))
      (when (and (> (len args) 0) (storeCommand (aget args 0)))
        (os/Exit (storeTool storeDir args))))


    (execRlwrap args)
    (let [(values exe err) (os/Executable)]
      (when (!= err nil)
        (fail err))

      (let [(values img ^:assign err) (image exe)]
        (when (!= err nil)
          (fail err))

        (set! (.-Copy img) (== (os/Getenv "ARBACE_BOX_MAP") "0"))
        (let [cfg ^{:go/breaks [2 4 6 8 10]} (lit vmm/Config
              :ImageFile img
              :Host (newConsole)
              :Args (append (lit (slice string) "arbace") (spread args))
              :Env (guestEnv (os/Environ))
              :CPUs (defaultCPUs))]

          (when [p (os/Getenv "ARBACE_BOX_STATS")] (!= p "")
            (let [(values f err) (os/OpenFile p (bit-or os/O_WRONLY os/O_CREATE os/O_APPEND) 0644)]
              (when (!= err nil)
                (fail err))

              (set! (.-Stats cfg) f)))

          (when (!= storeDir "")
            (let [(values st err) (openStore storeDir)]
              (when (!= err nil)
                (fail err))

              (set! (.-Store cfg) st)))

          (when (!= (os/Getenv "ARBACE_BOX_SECCOMP") "0")
            (set! (.-Seccomp cfg) vmm/Seccomp))

          (netConfig (addr cfg))
          (when [w (os/Getenv "ARBACE_BOX_WATCHDOG")] (!= w "")
            (let [(values d err) (time/ParseDuration w)]
              (when (or (!= err nil) (< d 0))
                (fail (fmt/Errorf "ARBACE_BOX_WATCHDOG=%s: not a duration" w)))

              (set! (.-Watchdog cfg) d)))

          (when [c (os/Getenv "ARBACE_BOX_CPUS")] (!= c "")
            (let [(values n err) (strconv/Atoi c)]
              (when (== c "host")
                (set! (values n err) (values (min (runtime/NumCPU) vmm/MaxCPUs) nil)))

              (when (or (!= err nil) (< n 1) (> n vmm/MaxCPUs))
                (fail (fmt/Errorf "ARBACE_BOX_CPUS=%s: not 1 to %d, or host" c vmm/MaxCPUs)))

              (set! (.-CPUs cfg) n)))

          (when [p (os/Getenv "ARBACE_BOX_PARK")] (!= p "")
            (let [(values d err) (time/ParseDuration p)]
              (when (or (!= err nil) (<= d 0))
                (fail (fmt/Errorf "ARBACE_BOX_PARK=%s: not a positive duration" p)))

              (set! (.-Park cfg) d)))

          (let [(values code ^:assign err) (vmm/Run cfg)]
            (when (!= err nil)
              (fmt/Fprintln os/Stderr "arbace-box:" err)
              (let [^{:tag (* vmm/Fault)} f (zero (* vmm/Fault))]
                (when (errors/As err (addr f))
                  (vmm/Die))

                (os/Exit 1)))

            (os/Exit code)))))))


^{:go/end 143} (go/func fail [^error err]
  (fmt/Fprintln os/Stderr "arbace-box:" err)
  (os/Exit 1))




^{:go/end 147} (go/func defaultCPUs "defaultCPUs is the guest's vCPUs when ARBACE_BOX_CPUS does not say: four\n(go-whim's measured default, D9), or the host's CPUs when fewer.\n" ^int [] (min (runtime/NumCPU) 4))



^{:go/end 163} (go/func image "image is the guest: ARBACE_BOX_IMAGE's file, the image appended to exe,\nor exe.elf, mapped by the monitor from its file (vmm.ImageFile).\n" [^string exe] :results [(* vmm/ImageFile) error]
  (when [p (os/Getenv "ARBACE_BOX_IMAGE")] (!= p "")
    (return (vmm/OpenImage p)))

  (let [(values img err) (vmm/AppendedFile exe)]
    (when (not (errors/Is err vmm/ErrNoImage))
      (return img err))

    (when [(values img rerr) (vmm/OpenImage (+ exe ".elf"))] (== rerr nil)
      (return img nil))

    (return nil (errors/New (+ "no guest image: none appended to this program, no ARBACE_BOX_IMAGE, no " exe ".elf (bin/arbace-go --build --box builds one)")))))





^{:go/end 194} (go/func guestEnv "guestEnv is the guest's environment: of env, the variables the guest\nreads (the time zone, the locale, the collector, the JVM's options,\nArbace's own) but the launcher's, and those ARBACE_BOX_ENV names.\n" ^{:tag (slice string)} [^{:tag (slice string)} env]
  (let [extra (lit (map string bool))]
    (range [_ n (strings/Split (os/Getenv "ARBACE_BOX_ENV") ",")]
      (when (!= n "")
        (aset extra n true)))


    (let [^{:tag (slice string)} out (zero (slice string))]
      (range [_ kv env]
        (let [(values name _ ok) (strings/Cut kv "=")]
          (when (not ok)
            (continue))

          (switch
            (case [(aget extra name)])
            (case [(== name "ARBACE_BOX_FS")])
            (case [(strings/HasPrefix name "ARBACE_BOX_")]
              (continue))
            (case [(strings/HasPrefix name "ARBACE_") (strings/HasPrefix name "LC_")])
            (case [(or (== name "TZ") (== name "LANG") (== name "LANGUAGE") (== name "GOGC") (== name "GOMEMLIMIT") (== name "JAVA_TOOL_OPTIONS"))])
            (default
              (continue)))

          (set! out (append out kv))))

      ^{:line 193} out)))

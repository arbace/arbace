^{:go/end 14} (go/func allocAligned "allocAligned returns a zeroed byte slice of n bytes whose first byte is aligned to align (a\npower of two): a Go allocation of n+align, sub-sliced. The returned slice keeps the backing\narray alive, so the physical pages the tables point at stay mapped (§2.1).\n" ^{:tag (slice byte)} [^int n ^int align]
  (let [buf (make (slice byte) (+ n align))
      ^{:line 12} off (bit-and (- align (conv int (bit-and (conv uintptr (conv unsafe/Pointer (addr (aget buf 0)))) (conv uintptr (- align 1))))) (- align 1))]
    (subslice buf off (+ off n) (+ off n))))

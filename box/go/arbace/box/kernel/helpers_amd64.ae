(in-ns 'go.arbace.box.kernel) (go/file "helpers_amd64.go" :imports [


    ^{:line 4} [unsafe "unsafe"]

    ^{:line 6} [abi "arbace/box/abi"]
    ^{:line 7} [board "arbace/box/board"]])





^{:go/end 17} (go/func allocAligned "allocAligned returns a zeroed byte slice of n bytes whose first byte is aligned to align (a\npower of two): a Go allocation of n+align, sub-sliced. The returned slice keeps the backing\narray alive, so the physical pages the tables point at stay mapped (§2.1).\n" ^{:tag (slice byte)} [^int n ^int align]
  (let [buf (make (slice byte) (+ n align))
      ^{:line 15} off (bit-and (- align (conv int (bit-and (conv uintptr (conv unsafe/Pointer (addr (aget buf 0)))) (conv uintptr (- align 1))))) (- align 1))]
    (subslice buf off (+ off n) (+ off n))))






^{:go/end 28} (go/func fillRandom "fillRandom fills b with random bytes for a process's GetRandomData, from the monitor (the kernel\nis a guest, so abi.Random reaches the host; §4.3 forwards a process's call to the kernel's own\ndriver).\n" [^{:tag (slice byte)} b]
  (when (== (len b) 0)
    (return))

  (board/Call abi/Random (board/Addr b) (conv int64 (len b)) 0 0 0))

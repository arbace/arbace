      (put (+ ptrs (* (conv uintptr (+ (len args) 1 (len env))) 8)) 0) ; env's null
      (return (conv uint64 (len args)) (conv uint64 ptrs) nil))))








(go/var ^{:tag bool :doc "Run runs the process until it exits or faults (§3.1, §6.1): the kernel's goroutine enters it\n(board.EnterUser) and, each time it leaves, serves the system call and re-enters, or records the\nend. One vCPU (through KU4). The first entry flushes the process's PCID (its tables are new); the\nlater ones keep its TLB entries (bit 63), so a crossing's two CR3 writes reload no translation.\nTrace, when set, makes Run print a line per crossing (the call number or fault): a debugging\naid, off by default.\n"} Trace)

^{:go/end 312} (go/method Run ^error [^{:tag (* Proc)} p]
  (let [t0 (time/Now)]
    (defer (^{:go/end 282} (fn [] (set! (.-Run (.-Stats p)) (time/Since t0)))))
    (while true
      (board/EnterUser (.-ctx p))
      (inc! (.-Crossings (.-Stats p)))
      (when (not (.-started p))
        (set! (.-started p) true)
        (when (board/PCIDs)
          (set! (.-CR3 (.-ctx p)) bit-or (<< 1 63))))


      (when Trace
        (let [nr (conv uint64 0)]
          (when [(values b ok) (.winBytes p (conv uintptr (.-AX (.-ctx p))) abi/BlockSize)] ok
            (set! nr (.Uint64 binary/LittleEndian (subslice b abi/BlockNr))))

          (println "  trap" (.-Trap (.-ctx p)) "ax" (hex (.-AX (.-ctx p))) "nr" nr "ip" (hex (.-IP (.-ctx p))) "cr2" (hex (.-CR2 (.-ctx p))))))

      (switch (.-Trap (.-ctx p))
        (case [board/TrapSyscall]
          (when (.syscall p t0)
            (return nil)))

        (case [board/TrapFault]
          (.onFault p)
          (when (.-Exited p)
            (return nil)))))))


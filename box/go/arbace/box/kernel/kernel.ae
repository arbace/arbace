  ^{:line 46} [^{:val 4096} page 0x1000]
  ^{:line 47} [^{:val 2097152} imageBase 0x200000]


  ^{:line 50} [^{:val 158 :doc "the Linux arch_prctl SYSCALL the process's settls makes at ring 3 (KS3).\n"} sysArchPrctl 158]
  ^{:line 51} [^{:val 4098} archSetFS 0x1002]
  ^{:line 52} [^{:val 22} einval 22])




    (return (subslice (.-window p) (- va (.-winVA p)) (+ (- va (.-winVA p)) (conv uintptr n))) true))

  (when (and (>= va (.-rwStart (.-b p))) (<= (+ va (conv uintptr n)) (.-imageEnd (.-b p))))
    (let [off (- va (.-rwStart (.-b p)))]
      (return (subslice (.-data p) off (+ off (conv uintptr n))) true)))

  (return nil false))


^{:go/end 366} (go/func itoa ^string [^uint64 v]
  (when (== v 0)
    (return "0"))

  (let [^{:tag (array 20 byte)} b (zero (array 20 byte))
      ^{:line 359} i (len b)]
    (while (> v 0)
      (dec! i)
      (aset b i (conv byte (+ \0 (% v 10))))
      (set! v / 10))

    (conv string (subslice b i))))


^{:go/end 388} (go/func hex ^string [^uint64 v]
  (when (== v 0)
    (return "0x0"))

  (let [^{:tag (array 18 byte)} b (zero (array 18 byte))
      ^{:line 373} i (len b)]
    (while (> v 0)
      (dec! i)
      (let [d (conv byte (bit-and v 0xf))]
        (if (< d 10)
          (aset b i (+ \0 d))

          (aset b i (- (+ \a d) 10)))

        (set! v >> 4)))

    (set! i - 2)
    (aset b i \0)
    (aset b (+ i 1) \x)
    (conv string (subslice b i))))

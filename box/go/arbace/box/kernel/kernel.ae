^{:go/end 196} (go/func writeArgs "writeArgs writes the command line into the window's low bytes (the pointers then the strings),\nas the monitor does for a guest (vmm/layout.go), and returns argc and the argv pointer, both\nas the process's own virtual addresses.\n" [^{:tag (* Proc)} p ^{:tag (slice string)} args] :results [^uint64 argc ^uint64 argv]

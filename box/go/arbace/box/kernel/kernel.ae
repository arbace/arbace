  ^{:line 38} [^{:val 4096} page 0x1000]
  ^{:line 39} [^{:val 2097152} imageBase 0x200000]


  ^{:line 42} [^{:val 158 :doc "the Linux arch_prctl SYSCALL the process's settls makes at ring 3 (KS3).\n"} sysArchPrctl 158]

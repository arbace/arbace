(go/var ^{:tag bool :doc "Run runs the process until it exits or faults (§3.1, §6.1): the kernel's goroutine enters it\n(board.EnterUser) and, each time it leaves, serves the system call and re-enters, or records the\nend. One vCPU (KU1).\nTrace, when set, makes Run print a line per crossing (the call number or fault): a debugging\naid, off by default.\n"} Trace)

^{:go/end 232} (go/method Run ^error [^{:tag (* Proc)} p]
  (while true
    (board/EnterUser (.-ctx p))
    (when Trace
      (let [nr (conv uint64 0)]
        (when [(values b ok) (.winBytes p (conv uintptr (.-AX (.-ctx p))) abi/BlockSize)] ok
          (set! nr (.Uint64 binary/LittleEndian (subslice b abi/BlockNr))))

        (println "  trap" (.-Trap (.-ctx p)) "ax" (hex (.-AX (.-ctx p))) "nr" nr "ip" (hex (.-IP (.-ctx p))) "cr2" (hex (.-CR2 (.-ctx p))))))

    (switch (.-Trap (.-ctx p))
      (case [board/TrapSyscall]
        (let [(values done err) (.syscall p)]
          (when (!= err nil)
            (return err))

          (when done
            (return nil))))

      (case [board/TrapFault]
        (.onFault p)
        (when (.-Exited p)
          (return nil))))))

;; a nil dereference was turned into the process's own panic: re-enter.








^{:go/end 255} (go/method onFault "onFault handles a fault at ring 3 (§8): a page fault below the first page, once the process has\nnamed its sigpanic PC (NilHandler), is turned into the process's own run-time panic by rewriting\nits trap frame (as the board's vectors do for the kernel, BX60); any other fault ends the\nprocess with a report.\n" [^{:tag (* Proc)} p]
  (let [^:const ^{:val 14} pageFault 14]
    (when (and (== (.-Vector (.-ctx p)) pageFault) (< (.-CR2 (.-ctx p)) page) (!= (.-sigpanicPC p) 0))
      ;; push the faulting IP on the process's stack and resume at sigpanic, as if the faulting
      ;; instruction had called it (§8). The stack is the process's; the kernel writes it through
      ;; the kernel alias of the window.
      (let [sp (- (.-SP (.-ctx p)) 8)]
        (when [(values b ok) (.winBytes p (conv uintptr sp) 8)] ok
          (.PutUint64 binary/LittleEndian b (.-IP (.-ctx p)))
          (set! (.-SP (.-ctx p)) sp)
          (set! (.-IP (.-ctx p)) (.-sigpanicPC p))
          (set! (.-Iret (.-ctx p)) 1) ; a full IRETQ: the frame is rewritten, not a SYSRET
          (return))))


    (set! (.-Exited p) true)
    (set! (.-Fault p) (addr (lit FaultReport :Vector (.-Vector (.-ctx p)) :Code (.-Code (.-ctx p)) :IP (.-IP (.-ctx p)) :Addr (.-CR2 (.-ctx p)))))))



(go/const ^{:val 65536 :doc "outputLimit bounds what the kernel keeps of a process's console (§5.3).\n"} outputLimit (<< 1 16))





^{:go/end 329} (go/method syscall "syscall serves the process's system call (§4.3): it reads the call block from the process's\nmemory through the kernel alias of its RAM, checks the buffers it names lie in the process's\nRAM, serves the KU1 calls or refuses, and writes the result back. It returns done when the\nprocess has exited.\n" [^{:tag (* Proc)} p] :results [^bool done ^error err]

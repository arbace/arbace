  (let [(values _ etext nd bss end) (symaddrs)]
    ^{:go/breaks [2 4 6 8]} (lit bounds
      :etext (bit-and-not (- (+ etext page) 1) (- page 1))
      :rwStart (bit-and-not nd (- page 1))
      :dataEnd bss
      :imageEnd (bit-and-not (- (+ end page) 1) (- page 1)))))






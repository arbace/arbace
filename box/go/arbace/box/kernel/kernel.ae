    (range [_ e env]
      (set! need + (+ (conv uintptr (len e)) 1)))

    (when (> need argvReserve)
      (return 0 0 (errors/New "kernel: the command line and environment exceed the process's argument area")))

    (let [off strs
        ^{:line 254} put ^{:go/end 254} (fn [^uintptr va ^uint64 v] (.PutUint64 binary/LittleEndian (subslice (.-window p) (- va (.-winVA p))) v))
        ^{:line 255} str ^{:go/end 260} (fn [^int i ^string s]

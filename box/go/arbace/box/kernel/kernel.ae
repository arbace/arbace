(go/type bounds "bounds is the image's segment boundaries (§2.1), read once from the linker's symbols.\n" (struct
    ^{:line 49 :tag uintptr} etext ; end of text
    ^{:line 50 :tag uintptr} rwStart ; start of the writable segment (the page of noptrdata)
    ^{:line 51 :tag uintptr} dataEnd ; end of the file-backed data (start of bss)
    ^{:line 52 :tag uintptr} imageEnd)) ; end of the image (bss's end, page up)



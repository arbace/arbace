  (+ "process fault " (itoa (.-Vector f)) " (code " (hex (.-Code f)) ") at " (hex (.-IP f)) ", address " (hex (.-Addr f))))


(go/var ^uint16 nextPCID 1)




^{:go/end 167} (go/func NewProc "NewProc loads a process of this image (b1): its private data+bss, a RAM window of winBytes for\nits heap and stack, and page tables that share the image's text and rodata read-only and map the\nrest private (§2.1, §6.1). args is its command line. The process is entered at whim_uentry.\n" [^{:tag (slice string)} args ^uintptr winBytes] :results [(* Proc) error]
  (when (< winBytes (* 32 0x200000))
    (set! winBytes (* 32 0x200000))) ; 64 MiB: room for a small runtime's heap (4 MiB arenas) and stacks

  (set! winBytes (bit-and-not (- (+ winBytes 0x200000) 1) (- 0x200000 1)))
  (let [p (addr (lit Proc :b (segBounds)))

      ;; the private data+bss (§2.1): the image's pristine file-backed data (the board snapshotted it
      ;; before any init ran), then zeros for bss (make zeroes the rest).
      (values img rwStart) (board/DataImage)]
    (when (or (== (len img) 0) (!= rwStart (.-rwStart (.-b p))))
      (return nil errBadSnapshot))

    (set! (.-data p) (allocAligned (conv int (- (.-imageEnd (.-b p)) (.-rwStart (.-b p)))) page))
    (copy (.-data p) img)

    ;; the RAM window: the process's heap and first stack, contiguous, user read/write. Mapped at
    ;; a fixed high virtual address of its own (winVA), well above the image.
    (set! (.-window p) (allocAligned (conv int winBytes) 0x200000))
    (set! (.-winVA p) 0x100000000) ; 4 GiB: above the kernel's identity map (idLimit), so the window's
    ;;                       user mapping does not collide with the supervisor identity map (§2.1)

    (when (board/PCIDs)
      (set! (.-pcid p) nextPCID)
      (inc! nextPCID))


    (let [(values t err) (buildTables p)]
      (when (!= err nil)
        (return nil err))

      (set! (.-tables p) t)

      ;; the entry registers (§3.3), as the board's cpuinit reads them (boot_amd64.s): the command
      ;; line in the window's low bytes, RamStart/RamSize/RamStackOffset the window, the counter's
      ;; rate and the wall clock the kernel's own (board reads them for the process too).
      (let [(values argc argv) (writeArgs p args)
          ^{:line 149} ip (conv uint64 (board/UEntryAddr))
          ;; the heap (goos.RamStart) starts a block above the window's base, so the runtime never
          ;; overwrites the command line, which sits at the window's base (argvReserve; the monitor keeps
          ;; a guest's args below its heap likewise, vmm/layout.go's argsBase/imageBase).
          ^{:line 153} heapStart (+ (conv uint64 (.-winVA p)) argvReserve)
          ^{:line 154} top (+ (conv uint64 (.-winVA p)) (conv uint64 winBytes))]
        (set! (.-ctx p) (board/NewUserContext ip top))
        (set! (.-DI (.-ctx p)) argc)
        (set! (.-SI (.-ctx p)) argv)
        (set! (.-DX (.-ctx p)) heapStart) ; goos.RamStart
        (set! (.-CX (.-ctx p)) (- top heapStart)) ; goos.RamSize
        (set! (.-R8 (.-ctx p)) (conv uint64 stackReserve)) ; goos.RamStackOffset: SP = RamStart+RamSize - this
        (set! (.-R9 (.-ctx p)) (board/TickKHz))
        (set! (.-R10 (.-ctx p)) 1) ; one vCPU (KU1; SMP is KU5)
        (set! (.-R11 (.-ctx p)) (board/WallBase))
        (set! (.-FSBase (.-ctx p)) (board/KernelFSBase)) ; the same image, the same TLS address; its own pages
        (set! (.-CR3 (.-ctx p)) (board/UserCR3 (conv uint64 (rootPA t)) (.-pcid p) true))
        (return p nil)))))





(go/const ^{:val 1048576 :doc "stackReserve is how far below the window's top the process's first stack starts (goos.\nRamStackOffset): the runtime grows its heap from RamStart up and its first stack down from\nRamStart+RamSize-RamStackOffset. KU1 gives the window generously, so a modest reserve does.\n"} stackReserve 0x100000) ; 1 MiB below the window's top: the first (g0) stack, 64 KiB, fits




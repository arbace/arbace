;; Per-process page tables on amd64 (doc/go/PROCESS-SPEC.md §2.1, §2.2, KU1). Each process has its
;; own 4-level tables: the kernel's whole address space identity-mapped supervisor-only (so the
;; crossing code runs at ring 0 with the process's tables loaded until it switches CR3, §2.1, no
;; KPTI), except the image's own 2 MiB region, which is mapped page by page: text and rodata
;; shared read-only and user-accessible (user-executable for text, SMEP off, §2.2), and data and
;; bss remapped to the process's private physical pages, user read/write. The RAM window (heap and
;; stacks) is mapped at the process's own high virtual address to its private physical pages, user
;; read/write.
;;
;; The box's guest runs with virtual = physical (the monitor identity-maps the slot, vmm/layout.go),
;; so a Go slice's address is its physical address: the kernel allocates tables and private pages as
;; Go memory and uses their addresses in page-table entries and CR3 (§2.1).
(in-ns 'go.arbace.box.kernel) (go/file "tables_amd64.go" :doc "Per-process page tables on amd64 (doc/go/PROCESS-SPEC.md §2.1, §2.2, KU1). Each process has its\nown 4-level tables: the kernel's whole address space identity-mapped supervisor-only (so the\ncrossing code runs at ring 0 with the process's tables loaded until it switches CR3, §2.1, no\nKPTI), except the image's own 2 MiB region, which is mapped page by page: text and rodata\nshared read-only and user-accessible (user-executable for text, SMEP off, §2.2), and data and\nbss remapped to the process's private physical pages, user read/write. The RAM window (heap and\nstacks) is mapped at the process's own high virtual address to its private physical pages, user\nread/write.\n\nThe box's guest runs with virtual = physical (the monitor identity-maps the slot, vmm/layout.go),\nso a Go slice's address is its physical address: the kernel allocates tables and private pages as\nGo memory and uses their addresses in page-table entries and CR3 (§2.1).\n" :imports [

    ^{:line 15} [unsafe "unsafe"]])


(go/const "The page-table entry bits (AMD64 vol. 2).\n"
  ^{:line 19} [^{:val 1} ptP (<< 1 0)] ; present
  ^{:line 20} [^{:val 2} ptRW (<< 1 1)] ; writable
  ^{:line 21} [^{:val 4} ptUS (<< 1 2)] ; user-accessible
  ^{:line 22} [^{:val 128} ptPS (<< 1 7)] ; a leaf 2 MiB page (at the PD level)
  ^{:line 23} [^{:val 9223372036854775808N} ptNX (<< 1 63)] ; not executable
  ^{:line 24} [^{:val 4503599627366400} ptAddr 0x000ffffffffff000])




(go/const ^{:val 4294967296 :doc "idLimit is how much of the kernel's space each process's tables identity-map supervisor-only:\nenough for the whole guest RAM the kernel uses (the default Go guest's is 3 GiB; §2.1). 4 GiB.\n"} idLimit (<< 4 30))

(go/type tables (struct
    ^{:line 32 :tag (slice (slice byte))} pages)) ; the page-table pages, kept alive; pages[0] is the PML4 (the root)


^{:go/end 35} (go/func rootPA ^uintptr [^{:tag (* tables)} t] (conv uintptr (conv unsafe/Pointer (addr (aget (aget (.-pages t) 0) 0)))))



^{:go/end 43} (go/method allocPT "allocPT allocates one zeroed, 4 KiB-aligned page-table page and returns it and its physical\naddress (identity: its own address).\n" [^{:tag (* tables)} t] :results [(slice byte) uint64]
  (let [pg (allocAligned page page)]
    (set! (.-pages t) (append (.-pages t) pg))
    (return pg (conv uint64 (conv uintptr (conv unsafe/Pointer (addr (aget pg 0))))))))


^{:go/end 45} (go/func entry ^uint64 [^{:tag (slice byte)} pg ^int i] (ldq (subslice pg (* i 8))))
^{:go/end 46} (go/func setEntry [^{:tag (slice byte)} pg ^int i ^uint64 v] (stq (subslice pg (* i 8)) v))


^{:go/end 107} (go/func buildTables "buildTables builds p's page tables (§2.1).\n" [^{:tag (* Proc)} p] :results [(* tables) error]
  (let [t (addr (lit tables))
      (values pml4 _) (.allocPT t)

      ;; map maps one 4 KiB page va -> pa with the given low bits (present assumed).
      ^{:line 54} mapPage ^{:go/end 63} (fn [^uint64 va ^uint64 pa ^uint64 bits]
        (let [i4 (bit-and (>> va 39) 511)
            ^{:line 56} i3 (bit-and (>> va 30) 511)
            ^{:line 57} i2 (bit-and (>> va 21) 511)
            ^{:line 58} i1 (bit-and (>> va 12) 511)
            ^{:line 59} pdpt (.sub t pml4 (conv int i4) (bit-or ptP ptRW ptUS))
            ^{:line 60} pd (.sub t pdpt (conv int i3) (bit-or ptP ptRW ptUS))
            ^{:line 61} pt (.sub t pd (conv int i2) (bit-or ptP ptRW ptUS))]
          (setEntry pt (conv int i1) (bit-or (bit-and pa ptAddr) bits ptP))))]


    ;; 1. the kernel's whole space, identity-mapped supervisor-only, 2 MiB leaves (§2.1): the
    ;;    crossing code touches the kernel's heap and stacks here at ring 0; no user bit, so a
    ;;    process cannot read it. The image's own 2 MiB region is left out and done page by page.
    (for [base (conv uint64 0)] (< base idLimit) (set! base + 0x200000)
      (when (== base imageBase)
        (continue))

      (let [i4 (bit-and (>> base 39) 511)
          ^{:line 73} i3 (bit-and (>> base 30) 511)
          ^{:line 74} i2 (bit-and (>> base 21) 511)
          ^{:line 75} pdpt (.sub t pml4 (conv int i4) (bit-or ptP ptRW ptUS))
          ^{:line 76} pd (.sub t pdpt (conv int i3) (bit-or ptP ptRW ptUS))]
        (setEntry pd (conv int i2) (bit-or base ptP ptRW ptPS)))) ; supervisor (no ptUS), executable


    ;; 2. the image's 2 MiB region, page by page (§2.1):
    ;;    - [imageBase, etext)   shared text:   user, read-only, executable
    ;;    - [etext, rwStart)     shared rodata: user, read-only, not executable
    ;;    - [rwStart, imageEnd)  private data+bss: user, read/write, not executable
    (for [va (conv uint64 imageBase)] (< va (+ imageBase 0x200000)) (set! va + page)
      (switch
        (case [(< va (conv uint64 (.-etext (.-b p))))]
          (mapPage va va ptUS)) ; text: shared, read-only, user-executable
        (case [(< va (conv uint64 (.-rwStart (.-b p))))]
          (mapPage va va (bit-or ptUS ptNX))) ; rodata: shared, read-only
        (case [(< va (conv uint64 (.-imageEnd (.-b p))))]
          (let [pa (conv uint64 (conv uintptr (conv unsafe/Pointer (addr (aget (.-data p) (- va (conv uint64 (.-rwStart (.-b p)))))))))]
            (mapPage va pa (bit-or ptUS ptRW ptNX)))) ; data+bss: private, user read/write
        (default
          ;; the rest of the image's 2 MiB region is the kernel's heap (it starts at the image's
          ;; end, grows up): identity, supervisor, so the kernel reaches it at ring 0.
          (mapPage va va ptRW))))



    ;; 3. the RAM window (heap and stacks), at the process's own virtual address, to its private
    ;;    physical pages, user read/write (§2.1).
    (let [winPA (conv uint64 (conv uintptr (conv unsafe/Pointer (addr (aget (.-window p) 0)))))]
      (for [off (conv uint64 0)] (< off (conv uint64 (len (.-window p)))) (set! off + page)
        (mapPage (+ (conv uint64 (.-winVA p)) off) (+ winPA off) (bit-or ptUS ptRW ptNX)))

      (return t nil))))




^{:go/end 121} (go/method sub "sub returns the page the entry i of pg points at, allocating and linking it when empty, and\nwidens its permission bits to link (a parent entry must allow what any child does).\n" ^{:tag (slice byte)} [^{:tag (* tables)} t ^{:tag (slice byte)} pg ^int i ^uint64 link]
  (let [e (entry pg i)]
    (when (== (bit-and e ptP) 0)
      (let [(values child pa) (.allocPT t)]
        (setEntry pg i (bit-or (bit-and pa ptAddr) link))
        (return child)))

    (setEntry pg i (bit-or e (bit-and link (bit-or ptRW ptUS))))
    (let [pa (conv uintptr (bit-and e ptAddr))]
      (unsafe/Slice (conv (* byte) (conv unsafe/Pointer pa)) page))))


^{:go/end 126} (go/func ldq ^uint64 [^{:tag (slice byte)} b]
  (bit-or (conv uint64 (aget b 0)) (<< (conv uint64 (aget b 1)) 8) (<< (conv uint64 (aget b 2)) 16) (<< (conv uint64 (aget b 3)) 24)
    (<< (conv uint64 (aget b 4)) 32) (<< (conv uint64 (aget b 5)) 40) (<< (conv uint64 (aget b 6)) 48) (<< (conv uint64 (aget b 7)) 56)))


^{:go/end 137} (go/func stq [^{:tag (slice byte)} b ^uint64 v]
  (aset b 0 (conv byte v))
  (aset b 1 (conv byte (>> v 8)))
  (aset b 2 (conv byte (>> v 16)))
  (aset b 3 (conv byte (>> v 24)))
  (aset b 4 (conv byte (>> v 32)))
  (aset b 5 (conv byte (>> v 40)))
  (aset b 6 (conv byte (>> v 48)))
  (aset b 7 (conv byte (>> v 56))))

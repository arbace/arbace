  ^{:line 18} [^{:val 4096} gdtAddr sysBase]
  ^{:line 19} [^{:val 8192} tssAddr (+ sysBase 0x1000)]
  ^{:line 20} [^{:val 12288} idtAddr (+ sysBase 0x2000)]
  ^{:line 21} [^{:val 8} selCode 0x08]
  ^{:line 22} [^{:val 16} selData 0x10]
  ^{:line 23} [^{:val 24} selTSS 0x18]
  ^{:line 24} [^{:val 32} nVectors 32]
  ^{:line 25} [^{:val 16} vectorSize 16]

  ^{:line 27} [(values ^{:val 1} cr0PE ^{:val 2} cr0MP ^{:val 16} cr0ET ^{:val 32} cr0NE ^{:val 65536} cr0WP ^{:val 2147483648} cr0PG) (values (<< 1 0) (<< 1 1) (<< 1 4) (<< 1 5) (<< 1 16) (<< 1 31))]
  ^{:line 28} [^{:val 32} cr4PAE (<< 1 5)]
  ^{:line 29} [(values ^{:val 256} eferLME ^{:val 1024} eferLMA ^{:val 2048} eferNXE) (values (<< 1 8) (<< 1 10) (<< 1 11))]

  ^{:line 31} [(values ^{:val 1} ptP ^{:val 2} ptRW ^{:val 128} ptPS) (values (<< 1 0) (<< 1 1) (<< 1 7))]
  ^{:line 32} [^{:val 9223372036854775808N} ptNX (<< 1 63)])


(go/var pageFormat ^{:go/breaks [2 4 6]} (lit ptFormat
    :levels 4
    :table ^{:go/end 37} (fn ^uint64 [^uint64 pa] (bit-or pa ptP ptRW))
    :leaf ^{:go/end 50} (fn ^uint64 [^uint64 pa ^perm p ^bool big]
      (let [e (bit-or pa ptP)]
        (when (!= (bit-and p pWrite) 0)
          (set! e bit-or ptRW))

        (when (== (bit-and p pExec) 0)
          (set! e bit-or ptNX))

        (when big
          (set! e bit-or ptPS))

        ^{:line 49} e))))





(go/const ^{:val 128 :doc "tssStride is the distance between two vCPUs' TSSs (doc/GUEST.md,\n*SMP*): each its own IST1, the fault stack of its own.\n"} tssStride 0x80)


^{:go/end 101} (go/func setup "setup writes the system tables and sets the vCPU's registers.\n" ^error [^hv/VCPU v ^{:tag (slice byte)} mem ^{:tag (* layout)} l]
  (let [le binary/LittleEndian]
    (.PutUint64 le (subslice mem (+ gdtAddr 0x00)) 0)
    (.PutUint64 le (subslice mem (+ gdtAddr selCode)) 0x00af9b000000ffff) ; P, DPL 0, code exec/read, L, G
    (.PutUint64 le (subslice mem (+ gdtAddr selData)) 0x00cf93000000ffff) ; P, DPL 0, data read/write, D/B, G
    (let [tss (conv uint64 tssAddr)]
      (.PutUint64 le (subslice mem (+ gdtAddr selTSS)) (bit-or tssLimit (<< (bit-and tss 0xffffff) 16) (<< 0x8b 40) (<< (bit-and (>> tss 24) 0xff) 56)))
      (.PutUint64 le (subslice mem (+ gdtAddr selTSS 8)) (>> tss 32))
      (range [i (max (.-cpus l) 1)]
        (let [t (+ tssAddr (* (conv uint64 i) tssStride))]
          (.PutUint64 le (subslice mem (+ t 0x24)) (.faultTopOf l i)) ; IST1
          (.PutUint16 le (subslice mem (+ t 0x66)) (+ tssLimit 1)))) ; no I/O bitmap

      (range [i nVectors]
        (let [h (+ (.-vectors l) (* (conv uint64 i) vectorSize))
            ^{:line 73} e (+ idtAddr (* (conv uint64 i) 16))]
          (.PutUint64 le (subslice mem e) (bit-or (bit-and h 0xffff) (<< selCode 16) (<< 1 32) (<< 0x8e 40) (<< (bit-and (>> h 16) 0xffff) 48))) ; IST1, interrupt gate, P
          (.PutUint64 le (subslice mem (+ e 8)) (>> h 32))))

      (let [(values root err) (.buildTables l mem pageFormat)]
        (when (!= err nil)
          (return err))

        (when [err (setupSys v l root 0)] (!= err nil)
          (return err))

        ^{:go/breaks [3]} (let [regs (lit (slice (struct
                  ^{:line 85 :tag hv/Reg} r
                  ^{:line 86 :tag uint64} val))

              (lit _ hv/RegRIP (.-entry l))
              (lit _ hv/RegRSP (.-stackTop l))
              (lit _ hv/RegRFLAGS 0x2)
              (lit _ hv/RegRDI (.-argc l))
              (lit _ hv/RegRSI (.-argv l))
              (lit _ hv/RegRDX (.-heap l)))]

          (range [_ r regs]
            (when [err (hv/VCPUSetReg v (.-r r) (.-val r))] (!= err nil)
              (return err)))


          nil)))))


(go/const ^{:val 103} tssLimit 0x67)





        (lit _ hv/SysRegCR0 (bit-or cr0PE cr0MP cr0ET cr0NE cr0WP cr0PG))
        (lit _ hv/SysRegCR3 root)
        (lit _ hv/SysRegCR4 cr4PAE)
        (lit _ hv/SysRegEFER (bit-or eferLME eferLMA eferNXE))
        (lit _ hv/SysRegGDTRBase gdtAddr)
        (lit _ hv/SysRegGDTRLimit (- (+ selTSS 16) 1))
        (lit _ hv/SysRegIDTRBase idtAddr)
        (lit _ hv/SysRegIDTRLimit (- (* nVectors 16) 1))
        (lit _ (.Selector hv/SegTR) selTSS)
        (lit _ (.Base hv/SegTR) (+ tssAddr (* (conv uint64 i) tssStride)))
        (lit _ (.Limit hv/SegTR) tssLimit)
        (lit _ (.AR hv/SegTR) 0x8b))

      ^{:line 126} segs (lit (slice (struct
            ^{:line 127 :tag hv/Segment} s

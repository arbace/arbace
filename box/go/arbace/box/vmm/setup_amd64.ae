            ^{:line 129 :tag uint64} ar))

        (lit _ hv/SegCS selCode 0xa09b)
        (lit _ hv/SegDS selData 0xc093)
        (lit _ hv/SegES selData 0xc093)
        (lit _ hv/SegFS selData 0xc093)
        (lit _ hv/SegGS selData 0xc093)
        (lit _ hv/SegSS selData 0xc093))]

    (range [_ s segs]
      (set! sys (append sys (spread (lit (slice (struct
                  ^{:line 140 :tag hv/SysReg} r
                  ^{:line 141 :tag uint64} val))
              (lit _ (.Selector (.-s s)) (.-sel s)) (lit _ (.Base (.-s s)) 0) (lit _ (.Limit (.-s s)) 0xffffffff) (lit _ (.AR (.-s s)) (.-ar s)))))))

    (range [_ s sys]
      (when [err (hv/VCPUSetSysReg v (.-r s) (.-val s))] (!= err nil)
        (return err)))


    nil))





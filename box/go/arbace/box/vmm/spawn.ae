(in-ns 'go.arbace.box.vmm) (go/file "spawn.go" :imports [

    ^{:line 3} [fmt "fmt"]])




(go/type Spawner "Spawner runs tool guests for a guest's spawn calls (Arbace's\ndoc/go/BOX-NOTES.md, S7): the request a blob of the store, the answer a\nresult blob, the policy and the budget the Spawner's own.\n" (interface



    (^{:doc "Start starts the guest request req asks for and returns at once: a\nhandle, or an error when it refuses.  done is called when the guest\nhas ended (or could not run).\n"} Start [^{:tag (array 32 byte)} req ^{:tag (func [])} done] :results [int64 error])



    (^{:doc "Poll is handle h's result: its hash and true once the guest has\nended, the handle then released; an error for no such handle, or a\nguest it could not run.\n"} Poll [^int64 h] :results [^{:tag (array 32 byte)} res ^bool ended ^error err])))



(go/const "The spawn calls' answers (guest/abi's).\n"
  ^{:line 21} [^{:val -1} spawnRefused -1]
  ^{:line 22} [^{:val -11} spawnRunning -11])




^{:go/end 77} (go/method spawnCall "spawnCall answers the spawn calls: Spawn and SpawnPoll by the Spawner,\nSpawnOut by Output.\n" [^{:tag (* machine)} m ^uint64 nr ^{:tag (array 5 int64)} a] :results [int64 error]
  (let [hashAt ^{:go/end 34} (fn [^int64 addr] :results [(slice byte) error]
        (let [(values p ok) (.guest m addr 32)]
          (when (not ok)
            (return nil (.fault m (fmt/Sprintf "a spawn's hash at %#x, outside the guest's memory" addr))))

          (return p nil)))]

    (switch nr
      (case [callSpawn]
        (let [(values p err) (hashAt (aget a 0))]
          (when (!= err nil)
            (return 0 err))

          (when (== (.-Spawner (.-cfg m)) nil)
            (return spawnRefused nil))

          (let [(values h serr) (.Start (.-Spawner (.-cfg m)) (conv (array 32 byte) p) (.-postEvent m))]
            (when (!= serr nil)
              (return spawnRefused nil))

            (return h nil))))
      (case [callSpawnPoll]
        (let [(values p err) (hashAt (aget a 1))]
          (when (!= err nil)
            (return 0 err))

          (when (== (.-Spawner (.-cfg m)) nil)
            (return spawnRefused nil))

          (let [(values res ended perr) (.Poll (.-Spawner (.-cfg m)) (aget a 0))]
            (switch
              (case [(!= perr nil)]
                (return spawnRefused nil))
              (case [(not ended)]
                (return spawnRunning nil)))

            (copy p (subslice res))
            (return 0 nil))))
      (case [callSpawnOut]
        (let [(values p err) (hashAt (aget a 0))]
          (when (!= err nil)
            (return 0 err))

          (when (or (== (.-Output (.-cfg m)) nil) (not ((.-Output (.-cfg m)) (conv (array 32 byte) p))))
            (return spawnRefused nil))

          (return 0 nil))))

    (return spawnRefused nil)))

(in-ns 'go.arbace.box.vmm) (go/file "mapfixed_linux.go" :imports [


    ^{:line 4} [errors "errors"]
    ^{:line 5} [syscall "syscall"]
    ^{:line 6} [unsafe "unsafe"]])




(go/var ^{:doc "errNoMapFixed is mapFixed's answer where a host cannot map a file into\nthe guest's memory: the caller copies.\n"} errNoMapFixed (errors/New "no fixed mapping"))



^{:go/end 26} (go/func mapFixed "mapFixed maps fd's bytes from off over b, in place, private: b's pages\nare the file's until written.\n" ^error [^{:tag (slice byte)} b ^uintptr fd ^int64 off]
  ^{:go/breaks [4]} (let [at (conv uintptr (conv unsafe/Pointer (addr (aget b 0))))
      (values r _ e) (syscall/Syscall6 syscall/SYS_MMAP at (conv uintptr (len b)) (bit-or syscall/PROT_READ syscall/PROT_WRITE)
        (bit-or syscall/MAP_PRIVATE syscall/MAP_FIXED) fd (conv uintptr off))]
    (when (!= e 0)
      (return e))

    (when (!= r at)
      (return (errors/New "mapped elsewhere")))

    nil))

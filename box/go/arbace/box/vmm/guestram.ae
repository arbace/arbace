(in-ns 'go.arbace.box.vmm) (go/file "guestram.go" :imports [


    ^{:line 4} [fmt "fmt"]
    ^{:line 5} [syscall "syscall"]])





^{:go/end 16} (go/func mapGuest "mapGuest maps the guest's RAM as syscall.Mmap does, after checking it\nagainst the monitor's limit: Hypervisor.framework refuses a map beyond its\nIPA size with HV_BAD_ARGUMENT alone, naming no limit (doc/go/BOX-NOTES.md).\n" [^int fd ^int64 offset ^int length ^int prot ^int flags] :results [(slice byte) error]
  (when (> (conv uint64 length) maxGuestEnd)
    (return nil (fmt/Errorf "the guest's RAM ends at %#x, beyond this monitor's %#x" length (conv uint64 maxGuestEnd))))

  (syscall/Mmap fd offset length prot flags))

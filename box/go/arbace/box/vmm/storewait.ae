(in-ns 'go.arbace.box.vmm) (go/file "storewait.go" :imports [


    ^{:line 4} [errors "errors"]
    ^{:line 5} [os "os"]
    ^{:line 6} [time "time"]])







^{:go/end 31} (go/method awaitBlob "awaitBlob waits for blob h, n bytes, which another writer of the\ndirectory (a guest's spawned guests share it: doc/go/BOX-NOTES.md, S8)\nis writing, created exclusively before Put came to it: nil once it is\nthere whole, else err, as when one a write left short is there, which is\nrefused until removed by hand.\n" ^error [^{:tag (* DirStore)} s ^{:tag (array 32 byte)} h ^int n ^error err]
  (when (not (errors/Is err os/ErrExist))
    (return err))

  (for [i 0] (< i 3000) (inc! i)
    (when [(values f e) (os/Open (.blob s h))] (== e nil)
      (let [(values st ^:assign e) (.Stat f)]
        (.Close f)
        (when (and (== e nil) (== (.Size st) (conv int64 n)))
          (when [(values _ ok) (.load s h)] ok
            (return nil)))))



    (time/Sleep (* 20 time/Millisecond)))

  err)

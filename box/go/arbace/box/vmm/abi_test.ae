(in-ns 'go.arbace.box.vmm) (go/file "abi_test.go" :imports [


    ^{:line 4} [elf "debug/elf"]
    ^{:line 5} [testing "testing"]

    ^{:line 7} [abi "arbace/box/abi"]])




^{:go/end 37} (go/func TestABI "TestABI holds the monitor's numbers to guest/abi's, which the Go guest\nis built on (guest/rt/rt.c spells the same in C).\n" [^{:tag (* testing/T)} t]
  (range [_ c (lit (slice (array 2 int))
        (lit _ callHostInit abi/HostInit) (lit _ callGetWinsize abi/GetWinsize) (lit _ callTermStart abi/TermStart)
        (lit _ callTermStop abi/TermStop) (lit _ callTTYKeys abi/TTYKeys) (lit _ callNowMs abi/NowMs) (lit _ callDelay abi/Delay)
        (lit _ callWaitForInput abi/WaitForInput) (lit _ callReadInput abi/ReadInput) (lit _ callSuspend abi/Suspend)
        (lit _ callExit abi/Exit) (lit _ callMessage abi/Message) (lit _ callAlloc abi/Alloc) (lit _ callFree abi/Free)
        (lit _ callWrite abi/Write) (lit _ callTime abi/Time) (lit _ callRaise abi/Raise) (lit _ callFault abi/Fault)
        (lit _ callRandom abi/Random) (lit _ callWaitRead abi/WaitRead) (lit _ callCPUStart abi/CPUStart)
        (lit _ callCPUPark abi/CPUPark) (lit _ callCPUWake abi/CPUWake) (lit _ callCPUSelf abi/CPUSelf) (lit _ nCalls abi/NCalls)
        (lit _ callBlobPut abi/BlobPut) (lit _ callRefSet abi/RefSet)
        (lit _ callNetInfo abi/NetInfo) (lit _ callNetEvents abi/NetEvents) (lit _ callNetListen abi/NetListen)
        (lit _ callNetDial abi/NetDial) (lit _ callNetAccept abi/NetAccept) (lit _ callNetRead abi/NetRead)
        (lit _ callNetWrite abi/NetWrite) (lit _ callNetClose abi/NetClose) (lit _ callNetShutdown abi/NetShutdown)
        (lit _ callNetStatus abi/NetStatus) (lit _ callNetAddr abi/NetAddr) (lit _ callNetOption abi/NetOption)
        (lit _ callNetLookup abi/NetLookup) (lit _ callEventArea abi/EventArea)
        (lit _ netErrTimeout abi/NetErrTimeout) (lit _ netErrNotFound abi/NetErrNotFound)
        (lit _ netErrTemp abi/NetErrTemp) (lit _ netErrOther abi/NetErrOther)
        (lit _ maxCPUs abi/MaxCPUs)
        (lit _ Doorbell abi/Doorbell) (lit _ cbNr abi/BlockNr) (lit _ cbArgs abi/BlockArgs) (lit _ cbRet abi/BlockRet)
        (lit _ cbEvent abi/BlockEvent) (lit _ cbSize abi/BlockSize))]

    (when (!= (aget c 0) (aget c 1))
      ^{:go/via [common]} (.Errorf t "the monitor's %d is the ABI's %d" (aget c 0) (aget c 1)))))






^{:go/end 55} (go/func TestPlanGo "TestPlanGo: a Go guest's slot is its image and one span read-write to\nGoRAMBytes above the image's base, the vectors' stack at the top.\n" [^{:tag (* testing/T)} t]
  (let [text (addr (lit elf/Prog :ProgHeader (lit elf/ProgHeader :Type elf/PT_LOAD :Flags (bit-or elf/PF_R elf/PF_X) :Vaddr imageBase :Memsz 0x200000)))
      ^{:line 43} data (addr (lit elf/Prog :ProgHeader (lit elf/ProgHeader :Type elf/PT_LOAD :Flags (bit-or elf/PF_R elf/PF_W) :Vaddr (+ imageBase 0x200000) :Memsz 0x145678)))
      ^{:line 44} im (addr (lit image :entry (+ imageBase 0x1000) :vectors (+ imageBase 0x2000) :end (+ imageBase 0x345678) :loads (lit (slice (* elf/Prog)) text data)))
      ^{:line 45} l (planGo im 1 0)]
    (when (or (!= (.-ramStart l) imageBase) (!= (.-size l) (+ imageBase GoRAMBytes)))
      ^{:go/via [common]} (.Fatalf t "ramStart %#x" (.-ramStart l)))

    (when (or (!= (- (.-size l) (.-stackTop l)) FaultStackBytes) (!= (.-faultTop l) (.-size l)) (!= (.-heap l) (+ imageBase 0x346000)))
      ^{:go/via [common]} (.Fatalf t "layout %+v" l))

    (when (or (!= (.permAt l (.-heap l)) (bit-or pRead pWrite)) (!= (.permAt l (- (.-size l) 1)) (bit-or pRead pWrite)) (!= (.permAt l (.-size l)) 0) (!= (.permAt l imageBase) (bit-or pRead pExec)))
      ^{:go/via [common]} (.Fatalf t "spans %+v" (.-spans l)))))



(go/func TestPlanGoHigh "TestPlanGoHigh: RAM that does not fit under the doorbell is above 4 GiB\n(HV1 (b)): the image where it is linked, two ranges of RAM, the doorbell in\nthe hole between them, the runtime's RAM and first stack at the top of\nthe high one; and RAM that fits is one slot, as before.\n" [^{:tag (* testing/T)} t]
  (let [text (addr (lit elf/Prog :ProgHeader (lit elf/ProgHeader :Type elf/PT_LOAD :Flags (bit-or elf/PF_R elf/PF_X) :Vaddr imageBase :Memsz 0x200000)))
      data (addr (lit elf/Prog :ProgHeader (lit elf/ProgHeader :Type elf/PT_LOAD :Flags (bit-or elf/PF_R elf/PF_W) :Vaddr (+ imageBase 0x200000) :Memsz 0x145678)))
      im (addr (lit image :entry (+ imageBase 0x1000) :vectors (+ imageBase 0x2000) :end (+ imageBase 0x345678) :loads (lit (slice (* elf/Prog)) text data)))
      ram (conv uint64 (<< 16 30))
      l (planGo im 4 ram)]
    (when (or (!= (.-ramStart l) highBase) (!= (.-size l) (+ highBase ram)) (!= (.-heap l) highBase))
      ^{:go/via [common]} (.Fatalf t "layout %+v" l))

    (when (or (!= (len (.-ram l)) 2) (!= (aget (.-ram l) 0) (lit span 0 (+ imageBase 0x400000) 0)) (!= (aget (.-ram l) 1) (lit span highBase (.-size l) 0)))
      ^{:go/via [common]} (.Fatalf t "ram %+v" (.-ram l)))

    (when (or (!= (- (.-size l) (.-stackTop l)) (* 4 FaultStackBytes)) (!= (.-faultTop l) (.-size l)))
      ^{:go/via [common]} (.Fatalf t "stacks %+v" l))

    (when (or (.inRAM l Doorbell 8) (.inRAM l (- highBase 8) 16) (not (.inRAM l highBase 8)) (not (.inRAM l (- (.-size l) 8) 8)) (.inRAM l (.-size l) 1) (not (.inRAM l argsBase 8)))
      ^{:go/via [common]} (.Fatalf t "inRAM wrong for %+v" (.-ram l)))

    (when (or (!= (.permAt l highBase) (bit-or pRead pWrite)) (!= (.permAt l (+ imageBase 0x400000)) 0) (!= (.permAt l Doorbell) (bit-or pWrite pDevice)) (!= (.permAt l imageBase) (bit-or pRead pExec)))
      ^{:go/via [common]} (.Fatalf t "spans %+v" (.-spans l)))

    (let [low (planGo im 1 (- Doorbell imageBase))]
      (when (or (!= (.-ramStart low) imageBase) (!= (.-size low) Doorbell) (!= (len (.-ram low)) 1))
        ^{:go/via [common]} (.Fatalf t "the most RAM under the doorbell: %+v" low)))))

^{:go/end 545} (go/method loop "loop runs the vCPU until the guest exits, answering its calls.\n" [^{:tag (* vcpu)} c] :results [int error]
  (let [m (.-m c)]
    (.Store (.-lastCall c) (.UnixNano (time/Now)))
    (while true
      (let [t0 (time/Now)]
        (when [err (hv/VCPURun (.-v c))] (!= err nil)
          (return 1 err))

        (let [t1 (time/Now)]
          (set! (.-guest c) + (.Sub t1 t0))
          (set! (.-longest c) (max (.-longest c) (.Sub t1 t0)))
          (inc! (.-exits c))

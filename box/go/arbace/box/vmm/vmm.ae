^{:go/end 386} (go/func newMachine [^Config cfg] :results [(* machine) error]
  (let [(values f err) (elf/NewFile (.imageAt cfg))]
    (when (!= err nil)
      (return nil (fmt/Errorf "the guest image: %w" err)))

    (let [(values im ^:assign err) (loadImage f elfMachine)]
      (when (!= err nil)
        (return nil err))

      (let [n (min (max (.-CPUs cfg) 1) maxCPUs)]
        (when (and (not (.-tamago im)) (== (.-apEntry im) 0))
          (set! n 1)) ; the C guest: one vCPU, the core's loop on it

        (when (and (> n 1) (== (.-apEntry im) 0))
          (return nil (fmt/Errorf "the guest image has no whim_apentry: it runs on one vCPU, not %d" n)))

        (let [m (addr (lit machine :cfg cfg :l (layoutFor im n (.-RAM cfg)) :host (make (chan (struct)) 1) :quit (make (chan (struct))) :start (time/Now)))]
          (set! (.-limit (.-smp m)) (^{:inst [time/Duration]} cmp/Or (.-Park cfg) DefaultPark))
          (set! (.-watch (.-ev m)) (make (chan (struct)) 1))
          (when (!= (.-Net cfg) nil)
            (set! (.-notify (.-Net cfg)) (.-postEvent m)))

          (set! (values (.-mem m) err) (mapGuest -1 0 (conv int (.-size (.-l m))) (bit-or syscall/PROT_READ syscall/PROT_WRITE)
              (bit-or syscall/MAP_PRIVATE syscall/MAP_ANON syscall/MAP_NORESERVE)))
          (when (!= err nil)
            (return nil (fmt/Errorf "the guest's %d MiB: %w" (>> (.-size (.-l m)) 20) err)))

          (when [err (.loadFrom im (.-mem m) (.-ImageFile cfg))] (!= err nil)
            (.close m)
            (return nil err))

          (when [err (.writeArgs (.-l m) (.-mem m) (.-Args cfg) (.-Env cfg))] (!= err nil)
            (.close m)
            (return nil err))

          (hv/LockThread)
          (when [err (hv/VMCreate nil)] (!= err nil)
            (.close m)
            (return nil err))

          (vmSetup)
          (range [_ r (.-ram (.-l m))]
            (when [err (hv/VMMap (subslice (.-mem m) (.-lo r) (.-hi r)) (conv hv/IPA (.-lo r)) (bit-or hv/MemoryRead hv/MemoryWrite hv/MemoryExec))] (!= err nil)
              (hv/VMDestroy)
              (.close m)
              (return nil err)))

          (let [boot (.newVCPU m 0)]
            (set! (values (.-v boot) (.-exit boot) err) (hv/VCPUCreate))
            (when (!= err nil)
              (hv/VMDestroy)
              (.close m)
              (return nil err))

            (set! (.-cpus m) (lit (slice (* vcpu)) boot))
            (when [err (boot0 (.-v boot) (.-mem m) (.-l m))] (!= err nil)
              (.destroy m)
              (return nil err))

            ;; The other vCPUs, each created on a thread of its own and kept there
            ;; (hv_vcpu_create's rule), all before the guest runs: the filter
            ;; (Seccomp) goes on with them all there, and allows no KVM_CREATE_VCPU.
            (for [i 1] (< i n) (inc! i)
              (let [c (.newVCPU m i)
                  ^{:line 376} ready (make (chan error))]
                (go (.ap c ready))
                (when [err (<! ready)] (!= err nil)
                  (<! (.-done c))
                  (.destroy m)
                  (return nil err))

                (set! (.-cpus m) (append (.-cpus m) c))))

            (return m nil)))))))



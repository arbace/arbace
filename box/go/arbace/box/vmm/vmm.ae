    (defer (.close m))
    (let [r (.run m)]
      (when (!= (.-panic r) nil)
        (let [(values c ok) (assert (interface (ExitCode ^int [])) (.-panic r))]
          (when (not ok)
            (panic (.-panic r)))

          (return (.ExitCode c) nil)))

      (return (.-code r) (.-err r)))))



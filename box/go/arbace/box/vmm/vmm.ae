            ;; read into the guest runtime's buffer, which serves the core's
            ;; read_input from it.  A deadly signal in either unwinds before a
            ;; byte is read (both deliver before they touch stdin), and the guest
            ;; makes the call again, as it makes a wait again.
            (let [(values buf ok) (.guest m (aget a 1) (aget a 2))]
              (when (or (not ok) (<= (aget a 2) 0))
                (return 1 false (.fault m (fmt/Sprintf "wait_read into %#x+%d, outside the guest's memory" (aget a 1) (aget a 2)))))

              (when [(set! ret (b2i (.WaitForInput h (aget a 0))))] (!= ret 0)
                (aset a 0 (conv int64 (.ReadInput h buf))))))

          (case [callSuspend]
            (.Suspend h))
          (case [callExit]
            (.stopOthers c)
            (.report m c)
            (.Exit h (conv int32 (aget a 0)))
            (return (conv int (conv int32 (aget a 0))) true nil))
          (case [callMessage]
            (let [(values msg ok) (.guest m (aget a 0) (aget a 1))]
              (when (not ok)
                (return 1 false (.fault m (fmt/Sprintf "message from %#x+%d, outside the guest's memory" (aget a 0) (aget a 1)))))

              (.Message h msg (!= (aget a 2) 0))))
          (case [callWrite]
            (let [(values p ok) (.guest m (aget a 0) (aget a 1))]
              (when (not ok)
                (return 1 false (.fault m (fmt/Sprintf "write from %#x+%d, outside the guest's memory" (aget a 0) (aget a 1)))))

              (set! ret (conv int64 (.Write h p)))))
          (case [callTime]
            (set! ret (.Time h)))
          (case [callRaise]
            (.Raise h (conv int32 (aget a 0))))
          (case [callRandom]
            (let [(values buf ok) (.guest m (aget a 0) (aget a 1))]
              (when (not ok)
                (return 1 false (.fault m (fmt/Sprintf "random into %#x+%d, outside the guest's memory" (aget a 0) (aget a 1)))))

              (set! ret (random buf)))))

        (.PutUint64 le (subslice cb cbRet) (conv uint64 ret))
        (range [i a]
          (.PutUint64 le (subslice cb (+ cbArgs (* 8 i))) (conv uint64 (aget a i))))

        (return 0 false nil)))))




^{:go/end 654} (go/method report "report writes the stats, when asked for: every vCPU's, summed, once\nthe others have stopped.\n" [^{:tag (* machine)} m ^{:tag (* vcpu)} self]
  (when (== (.-Stats (.-cfg m)) nil)
    (return))

  (let [^Stats st (zero Stats)
      ^{:line 623 :tag time/Duration} parked (zero time/Duration)]
    (range [_ c (.-cpus m)]
      (let [(values runs spurious) (values (.-runs c) (.-spurious c))]
        (when (== c self)
          (set! (values runs spurious) (hv/Stats (.-v c))))

        (set! (.-Exits st) + (.-exits c))
        (set! (.-Runs st) + runs)
        (set! (.-Spurious st) + spurious)
        (set! (.-Guest st) + (.-guest c))
        (set! (.-Longest st) (max (.-Longest st) (.-longest c)))
        (set! (.-Host st) + (- (.-host c) (.-parked c)))
        (set! parked + (.-parked c))))

    (range [nr (.-Calls st)]
      (aset (.-Calls st) nr (.Load (aget (.-calls m) nr))))

    (let [s (addr st)
        ^{:line 641 :tag uint64} calls (zero uint64)]
      (fmt/Fprintf (.-Stats (.-cfg m)) "exits %d runs %d spurious %d guest %dus host %dus longest %dus\n"
        (.-Exits s) (.-Runs s) (.-Spurious s) (.Microseconds (.-Guest s)) (.Microseconds (.-Host s)) (.Microseconds (.-Longest s)))
      (when (> (len (.-cpus m)) 1)
        (fmt/Fprintf (.-Stats (.-cfg m)) "cpus %d started %d parked %dus\n" (len (.-cpus m)) (.startedCPUs m) (.Microseconds parked)))

      (range [nr n (.-Calls s)]
        (when (> n 0)
          (set! calls + n)
          (fmt/Fprintf (.-Stats (.-cfg m)) "call %s %d\n" (aget callNames nr) n)))


      (fmt/Fprintf (.-Stats (.-cfg m)) "calls %d\n" calls))))





^{:go/end 683} (go/method watchdog "watchdog ends a guest one of whose vCPUs has run Watchdog without a\ncall: every vCPU is made to exit (hv_vcpus_exit), and the loops see it\nwas killed.  A vCPU in a call or parked is not running the guest.\n" [^{:tag (* machine)} m ^{:tag (chan :recv (struct))} stop]
  (let [t (time/NewTicker (/ (.-Watchdog (.-cfg m)) 4))]
    (defer (.Stop t))
    (while true
      (select
        (case (<! stop)
          (return))
        (case (<! (.-C t))
          (range [_ c (.-cpus m)]
            (when (and (> (.-id c) 0) (not (.Load (.-started c))))
              (continue))

            (when (.Load (.-inHost c))
              (.Store (.-lastCall c) (.UnixNano (time/Now)))
              (continue))

            (when (> (time/Since (time/Unix 0 (.Load (.-lastCall c)))) (.-Watchdog (.-cfg m)))
              (.Store (.-killed m) true)
              (.halt m)
              (return))))))))







(go/var ^{:doc "ErrNoImage is what the launcher says when it carries no guest.\n"} ErrNoImage (errors/New "whim-guest: no guest image: none appended to this program, no WHIM_GUEST_IMAGE, no program.elf beside it (go tool whim guest builds one)"))



(go/const ^{:val "WHIMGST1" :doc "The image is appended to the launcher: the ELF, then its length and a\nmagic word.\n"} trailerMagic "WHIMGST1")


^{:go/end 722} (go/func Appended "Appended is the guest image appended to the program at path, if any.\n" [^string path] :results [(slice byte) error]
  (let [(values f err) (os/Open path)]
    (when (!= err nil)
      (return nil err))

    (defer (.Close f))
    (let [(values st ^:assign err) (.Stat f)]
      (when (!= err nil)
        (return nil err))

      (let [^{:tag (array 16 byte)} tr (zero (array 16 byte))]
        (when (< (.Size st) 16)
          (return nil ErrNoImage))

        (when [(values _ err) (.ReadAt f (subslice tr) (- (.Size st) 16))] (!= err nil)
          (return nil err))

        (when (!= (conv string (subslice tr 8)) trailerMagic)
          (return nil ErrNoImage))

        (let [n (conv int64 (.Uint64 binary/LittleEndian (subslice tr _ 8)))]
          (when (or (<= n 0) (> n (- (.Size st) 16)))
            (return nil ErrNoImage))

          (let [img (make (slice byte) n)]
            (when [(values _ err) (.ReadAt f img (- (.Size st) 16 n))] (!= err nil)
              (return nil err))

            (return img nil)))))))



^{:go/end 731} (go/func Append "Append is a launcher carrying img: the program's bytes, img, the trailer.\n" ^{:tag (slice byte)} [^{:tag (slice byte)} prog ^{:tag (slice byte)} img]
  (let [out (append (append (lit (slice byte)) (spread prog)) (spread img))
      ^{:line 727 :tag (array 16 byte)} tr (zero (array 16 byte))]
    (.PutUint64 binary/LittleEndian (subslice tr _ 8) (conv uint64 (len img)))
    (copy (subslice tr 8) trailerMagic)
    (append out (spread (subslice tr)))))


^{:go/end 735} (go/func describeFault ^string [^{:tag (array 5 int64)} a]
  (fmt/Sprintf "the guest took exception %d (code %#x) at pc %#x, address %#x" (aget a 0) (aget a 1) (conv uint64 (aget a 2)) (conv uint64 (aget a 3))))

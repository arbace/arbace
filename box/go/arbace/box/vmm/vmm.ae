    (when [err (setWallClock (.-v (aget (.-cpus m) 0)))] (!= err nil)
      (return (lit result :code 1 :err err))))


  (when (!= (.-Seccomp (.-cfg m)) nil)
    (when [err ((.-Seccomp (.-cfg m)))] (!= err nil)
      (return (lit result :code 1 :err (fmt/Errorf "seccomp: %w" err)))))


  (let [stop (make (chan (struct)))]
    (defer (close stop))
    (when (> (.-Watchdog (.-cfg m)) 0)
      (go (.watchdog m stop)))

    (set! (.-running (.-smp m)) 1)
    (.serve (aget (.-cpus m) 0))
    (close (.-loopDone (aget (.-cpus m) 0)))
    (range [_ c (subslice (.-cpus m) 1)]
      (<! (.-loopDone c)))

    (.-end m)))





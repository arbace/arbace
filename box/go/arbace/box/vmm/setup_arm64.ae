(in-ns 'go.arbace.box.vmm) (go/file "setup_arm64.go" :imports [


    ^{:line 4} [elf "debug/elf"]

    ^{:line 6} [hv "arbace/box/hv"]])








(go/const "The arm64 guest starts at EL1 with the MMU on, at its first instruction:\nthe monitor writes 3-level identity page tables for a 32-bit space (4 KiB\ngranule, 2 MiB blocks) and sets, as the framework names them, MAIR_EL1,\nTCR_EL1, TTBR0_EL1, VBAR_EL1 (whim_vectors), SP_EL0 (the stack), SP_EL1\n(the fault stack), SCTLR_EL1 (MMU and caches on), CPSR (EL1t, DAIF\nmasked) and PC.  KVM/arm64 and the framework boot it the same way.\n"
  ^{:line 16} [^{:val 183} elfMachine elf/EM_AARCH64]

  ^{:line 18} [^{:val 1279} mair (bit-or (<< 0x04 8) 0xff)] ; attr0 normal write-back, attr1 device nGnRE
  ^{:line 19} [^{:val 4303369504} tcr (bit-or 32 (<< 1 8) (<< 1 10) (<< 3 12) (<< 1 23) (<< 1 32))]
  ^{:line 20} [^{:val 818939904} sctlrRES1 (bit-or (<< 1 11) (<< 1 20) (<< 1 22) (<< 1 23) (<< 1 28) (<< 1 29))]
  ^{:line 21} [^{:val 818944005} sctlr (bit-or sctlrRES1 (<< 1 0) (<< 1 2) (<< 1 12))] ; M, C, I
  ^{:line 22} [^{:val 964} cpsrEL1t (bit-or 0x4 (<< 0xf 6))] ; EL1 on SP_EL0, D A I F masked

  ^{:line 24} [(values ^{:val 1} dValid ^{:val 2} dTable ^{:val 2} dPage) (values (<< 1 0) (<< 1 1) (<< 1 1))]
  ^{:line 25} [^{:val 4} dAttrDevice (<< 1 2)]
  ^{:line 26} [^{:val 128} dRO (<< 1 7)]
  ^{:line 27} [^{:val 768} dSHInner (<< 3 8)]
  ^{:line 28} [^{:val 1024} dAF (<< 1 10)]
  ^{:line 29} [(values ^{:val 9007199254740992} dPXN ^{:val 18014398509481984} dUXN) (values (<< 1 53) (<< 1 54))])


(go/var pageFormat ^{:go/breaks [2 4 6]} (lit ptFormat
    :levels 3
    :table ^{:go/end 34} (fn ^uint64 [^uint64 pa] (bit-or pa dValid dTable))
    :leaf ^{:go/end 52} (fn ^uint64 [^uint64 pa ^perm p ^bool big]
      (let [e (bit-or pa dValid dAF dUXN)]
        (when (not big)
          (set! e bit-or dPage))

        (if (!= (bit-and p pDevice) 0)
          (set! e bit-or dAttrDevice)

          (set! e bit-or dSHInner))

        (when (== (bit-and p pWrite) 0)
          (set! e bit-or dRO))

        (when (== (bit-and p pExec) 0)
          (set! e bit-or dPXN))

        ^{:line 51} e))))




^{:go/end 82} (go/func setup "setup writes the page tables and sets the vCPU's registers.\n" ^error [^hv/VCPU v ^{:tag (slice byte)} mem ^{:tag (* layout)} l]
  ^{:go/breaks [6]} (let [(values root err) (.buildTables l mem pageFormat)]
    (when (!= err nil)
      (return err))

    (when [err (setupSys v l root 0)] (!= err nil)
      (return err))

    (when [err (hv/VCPUSetSysReg v hv/SysRegSPEL0 (.-stackTop l))] (!= err nil)
      (return err))

    (range [_ r (lit (slice (struct
              ^{:line 68 :tag hv/Reg} r
              ^{:line 69 :tag uint64} val))

          (lit _ hv/RegCPSR cpsrEL1t)
          (lit _ hv/RegPC (.-entry l))
          (lit _ hv/RegX0 (.-argc l))
          (lit _ hv/RegX1 (.-argv l))
          (lit _ hv/RegX2 (.-heap l)))]

      (when [err (hv/VCPUSetReg v (.-r r) (.-val r))] (!= err nil)
        (return err)))


    nil))




^{:go/breaks [5] :go/end 103} (go/func setupSys "setupSys sets vCPU i's system registers: every vCPU's the same but\nSP_EL1, the fault stack of its own.\n" ^error [^hv/VCPU v ^{:tag (* layout)} l ^uint64 root ^int i]
  (range [_ s (lit (slice (struct
            ^{:line 88 :tag hv/SysReg} r
            ^{:line 89 :tag uint64} val))

        (lit _ hv/SysRegMAIREL1 mair)
        (lit _ hv/SysRegTCREL1 tcr)
        (lit _ hv/SysRegTTBR0EL1 root)
        (lit _ hv/SysRegVBAREL1 (.-vectors l))
        (lit _ hv/SysRegSPEL1 (.faultTopOf l i))
        (lit _ hv/SysRegSCTLREL1 sctlr))]

    (when [err (hv/VCPUSetSysReg v (.-r s) (.-val s))] (!= err nil)
      (return err)))


  nil)




^{:go/end 107} (go/func setupAP "setupAP is vCPU i's state until it starts: the boot vCPU's system\nregisters, its own fault stack.\n" ^error [^hv/VCPU v ^{:tag (* layout)} l ^int i] (setupSys v l (.-root l) i))




^{:go/breaks [6] :go/end 131} (go/func startAP "startAP points vCPU v at the image's whim_apentry for abi.CPUStart: a[1]\nthe stack (SP_EL0), a[2] the M's g0 in X0, a[3] the function in X1, its\nnumber a[0] in X2.\n" ^error [^hv/VCPU v ^{:tag (* layout)} l ^{:tag (array 5 int64)} a]
  (when [err (hv/VCPUSetSysReg v hv/SysRegSPEL0 (conv uint64 (aget a 1)))] (!= err nil)
    (return err))

  (range [_ r (lit (slice (struct
            ^{:line 117 :tag hv/Reg} r
            ^{:line 118 :tag uint64} val))

        (lit _ hv/RegCPSR cpsrEL1t)
        (lit _ hv/RegPC (.-apEntry l))
        (lit _ hv/RegX0 (conv uint64 (aget a 2)))
        (lit _ hv/RegX1 (conv uint64 (aget a 3)))
        (lit _ hv/RegX2 (conv uint64 (aget a 0))))]

    (when [err (hv/VCPUSetReg v (.-r r) (.-val r))] (!= err nil)
      (return err)))


  nil)





^{:go/end 145} (go/func advance "advance is what the monitor does after a doorbell's exit, as on the\nframework: PC moved past the store, which the data abort left it on.  An\nHVC's exit is past the HVC already.\n" ^error [^hv/VCPU v ^hv/Syndrome s]
  (when (!= (.EC s) hv/ECDataAbortLower)
    (return nil))

  (let [(values pc err) (hv/VCPUGetReg v hv/RegPC)]
    (when (!= err nil)
      (return err))

    (hv/VCPUSetReg v hv/RegPC (+ pc 4))))



^{:go/end 151} (go/func pc "pc is the vCPU's program counter, for a diagnostic.\n" ^uint64 [^hv/VCPU v]
  (let [(values r _) (hv/VCPUGetReg v hv/RegPC)]

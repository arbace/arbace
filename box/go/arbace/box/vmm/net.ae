  ^{:line 31} [^{:val -11} netEAGAIN -11] ; nothing yet: wait for an event and ask again
  ^{:line 32} [^{:val -9} netEBADF -9] ; no such handle: closed
  ^{:line 33} [^{:val -115} netEINPROGRESS -115] ; a dial or a lookup not done yet
  ^{:line 34} [^{:val -1000} netErrTimeout -1000] ; a dial's time ran out
  ^{:line 35} [^{:val -1001} netErrNotFound -1001] ; a lookup: no such name
  ^{:line 36} [^{:val -1002} netErrTemp -1002] ; a lookup: a temporary failure
  ^{:line 37} [^{:val -1003} netErrOther -1003]) ; any other error







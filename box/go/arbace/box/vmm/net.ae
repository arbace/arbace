    (when (> (len p) room)
      (set! p (subslice p _ room)))

    (set! (.-out h) (append (.-out h) (spread p)))
    (.Broadcast (.-cond h))
    (conv int64 (len p))))


^{:go/breaks [9] :go/end 710} (go/method shutdown ^int64 [^{:tag (* netHandle)} h ^int64 how]
  (.Lock (.-mu h))
  (defer (.Unlock (.-mu h)))
  (when (or (!= (.-kind h) hConn) (== (.-c h) nil))
    (return (- (conv int64 syscall/ENOTCONN))))

  (when (== how 0)
    ;; reading: what comes is dropped, the guest reads the end
    (when [(values cr ok) (assert (interface (CloseRead ^error [])) (.-c h))] ok
      (when [err (.CloseRead cr)] (!= err nil)
        (return (errCode err))))


    (set! (values (.-in h) (.-eof h)) (values nil true))
    (return 0))

  (set! (.-shut h) true)
  (.Broadcast (.-cond h))
  0)




^{:go/end 728} (go/method status "status answers NetStatus: 0, EINPROGRESS while a dial or a lookup is\nunder way, or its failure; and the bytes the guest can read at once.\n" [^{:tag (* netHandle)} h] :results [int64 int64]
  (.Lock (.-mu h))
  (defer (.Unlock (.-mu h)))
  (switch
    (case [(.-pending h)]
      (return netEINPROGRESS 0))
    (case [(!= (.-err h) nil)]
      (return (errCode (.-err h)) 0))
    (case [(== (.-kind h) hLookup)]
      (return 0 (conv int64 (len (.-answer h)))))
    (case [(== (.-kind h) hListener)]
      (return 0 (conv int64 (len (.-accepted h))))))

  (return 0 (conv int64 (len (.-in h)))))




^{:go/end 747} (go/method addr "addr answers NetAddr: the local (or remote) address as host:port into p,\nits length.\n" ^int64 [^{:tag (* netHandle)} h ^bool remote ^{:tag (slice byte)} p]
  (.Lock (.-mu h))
  (defer (.Unlock (.-mu h)))
  (let [^net/Addr a (zero net/Addr)]
    (switch
      (case [(!= (.-l h) nil)]
        (set! a (.Addr (.-l h))))
      (case [(== (.-c h) nil)]
        (return (- (conv int64 syscall/ENOTCONN))))
      (case [remote]
        (set! a (.RemoteAddr (.-c h))))
      (default
        (set! a (.LocalAddr (.-c h)))))

    (conv int64 (copy p (.String a)))))




^{:go/end 775} (go/method option "option answers NetOption: java.net.SocketOptions' option opt set to value\n(set), or its value.\n" [^{:tag (* netHandle)} h ^int opt ^int value ^bool set] :results [int int64]
  (.Lock (.-mu h))
  (let [^any s (zero any)]
    (switch
      (case [(!= (.-l h) nil)]
        (set! s (.-l h)))
      (case [(!= (.-c h) nil)]
        (set! s (.-c h))))

    (.Unlock (.-mu h))
    (when (== s nil)
      (return 0 (- (conv int64 syscall/ENOTCONN))))

    (when set
      (when [err (setOption s opt value)] (!= err nil)
        (return 0 (errCode err)))

      (return 0 0))

    (let [(values v err) (getOption s opt)]
      (when (!= err nil)
        (return 0 (errCode err)))

      (return v 0))))

(in-ns 'go.arbace.box.vmm) (go/file "die_linux.go" :imports [


    ^{:line 4} [syscall "syscall"]
    ^{:line 5} [unsafe "unsafe"]])





^{:go/end 18} (go/func Die "Die ends the process by SIGSEGV at its default action, as the C editor\ndies of a fault: the Go runtime's own handler is taken off first, since\nit would turn the signal into a crash report and exit status 2.\n" []
  (let [^{:tag (array 4 uint64)} dfl (zero (array 4 uint64))] ; struct kernel_sigaction: SIG_DFL, no flags
    (syscall/RawSyscall6 syscall/SYS_RT_SIGACTION (conv uintptr syscall/SIGSEGV) (conv uintptr (conv unsafe/Pointer (addr dfl))) 0 8 0 0)
    (let [^uint64 set (<< 1 (- syscall/SIGSEGV 1))]
      (syscall/RawSyscall6 syscall/SYS_RT_SIGPROCMASK 1 (conv uintptr (conv unsafe/Pointer (addr set))) 0 8 0 0) ; /* SIG_UNBLOCK */
      (syscall/Tgkill (syscall/Getpid) (syscall/Gettid) syscall/SIGSEGV)
      (select))))

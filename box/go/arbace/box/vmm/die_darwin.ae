(in-ns 'go.arbace.box.vmm) (go/file "die_darwin.go" :imports [


    ^{:line 4} [runtime "runtime"]
    ^{:line 5} [syscall "syscall"]

    ^{:line 7} [libsys "arbace/box/libsys"]])






^{:go/end 22} (go/func Die "Die ends the process by SIGSEGV at its default action, as die_linux.go's\ndoes: the Go runtime's handler taken off through libc's sigaction, the\nsignal unblocked on this thread and sent to it (pthread_kill, tgkill's\ncounterpart).  NOT RUN here: built for darwin as a compile check.\n" []
  (runtime/LockOSThread)
  (libsys/Action syscall/SIGSEGV (addr (lit libsys/Sigaction :Handler libsys/SigDfl)))
  (libsys/ThreadMask libsys/SigUnblock (libsys/Bit syscall/SIGSEGV))
  (when (!= (libsys/RaiseThread syscall/SIGSEGV) nil)
    (syscall/Kill (syscall/Getpid) syscall/SIGSEGV))

  (select))

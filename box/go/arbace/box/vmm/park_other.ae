

(in-ns 'go.arbace.box.vmm) (go/file "park_other.go" :build ["//go:build !linux"] :imports [

    ^{:line 5} [time "time"]])



(go/type parker "A parker is a vCPU's park: a wake token in a channel, waited for with a\ntimer (park_linux.go has why Linux's is a futex).\n" (struct ^{:tag (chan (struct))} ch))

^{:go/end 11} (go/method init [^{:tag (* parker)} p] (set! (.-ch p) (make (chan (struct)) 1)))


^{:go/end 19} (go/method wake "wake ends the park, or the next: the token kept until it is taken.\n" [^{:tag (* parker)} p]
  (select
    (case (>! (.-ch p) (lit (struct))))
    (default)))




^{:go/end 44} (go/method wait "wait waits for a wake, until until (zero: no limit): true when woken.\n" ^bool [^{:tag (* parker)} p ^time/Time until]
  (when (.IsZero until)
    (<! (.-ch p))
    (return true))

  (let [d (time/Until until)]
    (when (<= d 0)
      (select
        (case (<! (.-ch p))
          (return true))
        (default
          (return false))))


    (let [t (time/NewTimer d)]
      (defer (.Stop t))
      (select
        (case (<! (.-ch p))
          (return true))
        (case (<! (.-C t))
          (return false))))))



(in-ns 'go.arbace.box.vmm) (go/file "seccomp_net_linux.go" :build ["//go:build linux"] :imports [])




^{:go/end 11} (go/func SeccompNet "SeccompNet is Seccomp for a guest with a network (Config.Net): the\nfilter also lets through the system calls of the monitor's sockets and\nof the host's name service (netSyscalls).\n" ^error []
  (set! allowed (append (subslice allowed _ (len allowed) (len allowed)) (spread netSyscalls)))
  (Seccomp))

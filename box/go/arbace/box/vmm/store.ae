;; THE STORE (doc/LISP-SANDBOX.md, *The store*): the box's data, kept on the
;; host by the monitor, so that what a guest reads and writes is no file of
;; the host's but blobs and refs.  A blob is immutable, named by its
;; SHA-256; a ref is a name pointing at a blob, the only state that
;; changes, by compare-and-set when a guest asks.  The guest's calls
;; (guest/abi's BlobPut, BlobSize, BlobGet, RefGet, RefSet) are the
;; monitor's, not the Host's.


(go/type Store "A Store keeps blobs and refs.  Its methods are called from any vCPU.\n" (interface
    (Put [^{:tag (slice byte)} data] :results [(array 32 byte) error])
    (Size [^{:tag (array 32 byte)} h] :results [int64 bool])
    (Get [^{:tag (array 32 byte)} h ^int64 off ^{:tag (slice byte)} p] :results [int bool])
    (Ref [^string name] :results [(array 32 byte) bool])


    (^{:doc "SetRef points name at h; when old is not nil, only if the ref is old\nnow (all zero: if it does not exist), else ErrConflict.\n"} SetRef ^error [^string name ^{:tag (array 32 byte)} h ^{:tag (* (array 32 byte))} old])))





(go/var ^{:tag error :doc "ErrConflict is a ref's compare-and-set that failed.  It says Conflict(),\nwhich is how a store's user that cannot import vmm (guest/joker/box)\ntells it from other errors.\n"} ErrConflict (lit conflict))

(go/type conflict (struct))

^{:go/end 42} (go/method Error ^string [conflict] "the ref is not what the guest said it was")
^{:go/end 43} (go/method Conflict ^bool [conflict] true)



(go/var ^{:tag error :doc "ErrTooLarge is a blob larger than the store takes (DirStore.Max).  It\nsays TooLarge(), as ErrConflict says Conflict().\n"} ErrTooLarge (lit tooLarge))

(go/type tooLarge (struct))

^{:go/end 51} (go/method Error ^string [tooLarge] "the blob is larger than the store takes")
^{:go/end 52} (go/method TooLarge ^bool [tooLarge] true)





(go/const "The store's answers besides a count or 0 (guest/abi: Store*): -1 none\nor refused, -2 a compare-and-set that failed, -3 no store, -4 a blob\ntoo large, -5 a ref's name the store does not take (doc/go/BOX-NOTES.md,\nS3).  go-whim's guests take any negative answer as a failure.\n"
  ^{:line 59} [^{:val -1} storeRefused -1]
  ^{:line 60} [^{:val -2} storeConflict -2]
  ^{:line 61} [^{:val -3} storeNone -3]
  ^{:line 62} [^{:val -4} storeTooLarge -4]
  ^{:line 63} [^{:val -5} storeBadName -5])




^{:go/breaks [[6 78]] :go/end 79} (go/func RefName "RefName says a ref's name is one the store takes: 1 to 64 of\n[A-Za-z0-9._-], not beginning with a dot.\n" ^bool [^string name]
  (when (or (< (len name) 1) (> (len name) 64) (== (aget name 0) \.))
    (return false))

  (for [i 0] (< i (len name)) (inc! i)
    (let [c (aget name i)]
      (when (not (or (and (>= c \a) (<= c \z)) (and (>= c \A) (<= c \Z)) (and (>= c \0) (<= c \9)) (== c \.) (== c \_) (== c \-)))
        (return false))))


  true)


















(go/type DirStore "A DirStore keeps the store in a directory of the host's: blobs/HASH,\nrefs/NAME (the hash in hex).  It makes only the system calls the\nmonitor's filter allows a running guest (openat, read, write, fstat,\nclose): a blob is written to its own name, created exclusively, and\nheld to its hash when read -- one a write left short (the guest ended,\nthe disk filled) is refused, not served; a ref, 65 bytes, is written in\none write.  Blobs read are kept, verified, up to CacheMax bytes in all,\nthe least recently used dropped first (doc/go/BOX-NOTES.md, S3): a\ngraph's EDN is read in many BlobGets, and a blob is read whole by its\nsize and then its bytes.\n\nThe refs are read and written under a lock of the file refs/.lock\n(fcntl's, which the filter allows) besides the process's mutex, so that\nprocesses sharing the directory -- boxes, Arbace's native executable,\nwhose jrt keeps the same format -- compare and set one at a time and\nnever read a ref half written (doc/go/BOX-NOTES.md, S3).\n" (struct
    ^{:line 98 :tag string} dir

    ^{:line 100 :tag int64 :doc "Max is the largest blob Put takes, ErrTooLarge beyond; 0 none.\n"} Max




    ^{:line 105 :tag int64 :doc "CacheMax is the most bytes of blobs kept, verified, for the next\nreads: the least recently used are dropped first, and a blob larger\nthan CacheMax is read from its file at each use.  0 keeps none;\nOpenDirStore sets DefaultCacheMax.\n"} CacheMax
    ^{:line 106 :tag sync/Mutex} mu
    ^{:line 107 :tag (map (array 32 byte) (* list/Element))} cache
    ^{:line 108 :tag list/List} lru
    ^{:line 109 :tag int64} cached
    ^{:line 110 :tag (* os/File)} lock)) ; refs/.lock, open while the store is




(go/const ^{:val 268435456 :doc "DefaultCacheMax is a DirStore's CacheMax unless its user says otherwise:\n256 MiB, the largest blob the launcher's store takes by default.\n"} DefaultCacheMax (<< 256 20))



(go/type cachedBlob "cachedBlob is a blob the cache keeps, in its list, the most recently\nused first.\n" (struct
    ^{:line 120 :tag (array 32 byte)} h
    ^{:line 121 :tag (slice byte)} b))




^{:go/end 137} (go/func OpenDirStore "OpenDirStore is the store in dir, its directories made when missing --\nbefore the monitor's system-call filter, which allows no mkdir.\n" [^string dir] :results [(* DirStore) error]
  (range [_ d (lit (slice string) "blobs" "refs")]
    (when [err (os/MkdirAll (filepath/Join dir d) 0755)] (!= err nil)
      (return nil (fmt/Errorf "the store: %w" err))))


  (let [(values lock err) (os/OpenFile (filepath/Join dir "refs" ".lock") (bit-or os/O_RDWR os/O_CREATE) 0644)]
    (when (!= err nil)
      (return nil (fmt/Errorf "the store: %w" err)))

    (return (addr (lit DirStore :dir dir :CacheMax DefaultCacheMax :cache (lit (map (array 32 byte) (* list/Element))) :lock lock)) nil)))




^{:go/end 149} (go/method lockRefs "lockRefs takes the refs' lock between processes (typ syscall.F_RDLCK or\nF_WRLCK; F_UNLCK releases it), waiting for it.\n" ^error [^{:tag (* DirStore)} s ^int16 typ]
  (let [lk (lit syscall/Flock_t :Type typ :Whence 0)]
    (while true
      (let [err (syscall/FcntlFlock (.Fd (.-lock s)) syscall/F_SETLKW (addr lk))]
        (when (!= err syscall/EINTR)
          (return err))))))




^{:go/end 153} (go/method blob ^string [^{:tag (* DirStore)} s ^{:tag (array 32 byte)} h]
  (filepath/Join (.-dir s) "blobs" (hex/EncodeToString (subslice h))))


^{:go/end 172} (go/method Put [^{:tag (* DirStore)} s ^{:tag (slice byte)} data] :results [(array 32 byte) error]
  (when (and (> (.-Max s) 0) (> (conv int64 (len data)) (.-Max s)))
    (return (lit (array 32 byte)) ErrTooLarge))

  (let [h (sha256/Sum256 data)]
    (when [(values _ ok) (.load s h)] ok
      (return h nil)) ; content-addressed: there already, and whole

    (let [(values f err) (os/OpenFile (.blob s h) (bit-or os/O_WRONLY os/O_CREATE os/O_EXCL) 0644)]
      (when (!= err nil)
        (return h err)) ; a short one from before is there: refused until removed by hand

      (set! (values _ err) (.Write f data))
      (when [cerr (.Close f)] (== err nil)
        (set! err cerr))

      (return h err))))




^{:go/end 189} (go/method load "load is blob h, from the cache or read and held to its hash, then kept\nas the most recently used (keep).\n" [^{:tag (* DirStore)} s ^{:tag (array 32 byte)} h] :results [(slice byte) bool]
  (.Lock (.-mu s))
  (defer (.Unlock (.-mu s)))
  (when [(values e ok) (aget (.-cache s) h)] ok
    (.MoveToFront (.-lru s) e)
    (return (.-b (assert (* cachedBlob) (.-Value e))) true))

  (let [(values b err) (os/ReadFile (.blob s h))]
    (when (or (!= err nil) (!= (sha256/Sum256 b) h))
      (return nil false))

    (.keep s h b)
    (return b true)))





^{:go/end 210} (go/method keep "keep caches blob h, the most recently used, dropping the least recently\nused blobs until all fit in CacheMax; a blob larger than CacheMax is not\nkept.  Under mu.\n" [^{:tag (* DirStore)} s ^{:tag (array 32 byte)} h ^{:tag (slice byte)} b]
  (when (== (.-cache s) nil)
    (set! (.-cache s) (lit (map (array 32 byte) (* list/Element)))))

  (let [n (conv int64 (len b))]
    (when (> n (.-CacheMax s))
      (return))

    (while (> (+ (.-cached s) n) (.-CacheMax s))
      (let [e (.Back (.-lru s))
          ^{:line 204} old (assert (* cachedBlob) (.Remove (.-lru s) e))]
        (delete (.-cache s) (.-h old))
        (set! (.-cached s) - (conv int64 (len (.-b old))))))

    (aset (.-cache s) h (.PushFront (.-lru s) (addr (lit cachedBlob h b))))
    (set! (.-cached s) + n)))



^{:go/end 217} (go/method Cached "Cached is how many blobs the cache keeps, and their bytes.\n" [^{:tag (* DirStore)} s] :results [^int blobs ^int64 bytes]
  (.Lock (.-mu s))
  (defer (.Unlock (.-mu s)))
  (return (.Len (.-lru s)) (.-cached s)))


^{:go/end 222} (go/method Size [^{:tag (* DirStore)} s ^{:tag (array 32 byte)} h] :results [int64 bool]
  (let [(values b ok) (.load s h)]
    (return (conv int64 (len b)) ok)))


^{:go/end 233} (go/method Get [^{:tag (* DirStore)} s ^{:tag (array 32 byte)} h ^int64 off ^{:tag (slice byte)} p] :results [int bool]
  (let [(values b ok) (.load s h)]
    (when (or (not ok) (< off 0))
      (return 0 false))

    (when (>= off (conv int64 (len b)))
      (return 0 true))

    (return (copy p (subslice b off)) true)))


^{:go/end 246} (go/method Ref [^{:tag (* DirStore)} s ^string name] :results [(array 32 byte) bool]
  (when (not (RefName name))
    (return (lit (array 32 byte)) false))

  (.Lock refMu)
  (defer (.Unlock refMu))
  (when (!= (.lockRefs s syscall/F_RDLCK) nil)
    (return (lit (array 32 byte)) false))

  (defer (.lockRefs s syscall/F_UNLCK))
  (.ref s name))



^{:go/end 257} (go/method ref "ref is ref name, read under the refs' locks.\n" [^{:tag (* DirStore)} s ^string name] :results [(array 32 byte) bool]
  (let [^{:tag (array 32 byte)} h (zero (array 32 byte))
      (values b err) (os/ReadFile (filepath/Join (.-dir s) "refs" name))]
    (when (!= err nil)
      (return h false))

    (let [(values n ^:assign err) (hex/Decode (subslice h) (bytes/TrimSpace b))]
      (return h (and (== err nil) (== n 32))))))


(go/var ^sync/Mutex refMu) ; refs' compare-and-set, across stores of one process

^{:go/end 281} (go/method SetRef ^error [^{:tag (* DirStore)} s ^string name ^{:tag (array 32 byte)} h ^{:tag (* (array 32 byte))} old]
  (when (not (RefName name))
    (return (fmt/Errorf "ref %q: not a name the store takes" name)))

  (when [(values _ ok) (.load s h)] (not ok)
    (return (fmt/Errorf "ref %s: no blob %x" name (subslice h _ 4))))

  (.Lock refMu)
  (defer (.Unlock refMu))
  (when [err (.lockRefs s syscall/F_WRLCK)] (!= err nil)
    (return (fmt/Errorf "ref %s: %w" name err)))

  (defer (.lockRefs s syscall/F_UNLCK))
  (when (!= old nil)
    (let [(values cur ok) (.ref s name)]
      (when (or (!= ok (!= @old (lit (array 32 byte)))) (and ok (!= cur @old)))
        (return ErrConflict))))


  (os/WriteFile (filepath/Join (.-dir s) "refs" name) (conv (slice byte) (+ (hex/EncodeToString (subslice h)) "\n")) 0644))




^{:go/end 393} (go/method storeCall "storeCall answers a store's call; storeNone when the machine has no\nstore.\n" [^{:tag (* machine)} m ^uint64 nr ^{:tag (array 5 int64)} a] :results [int64 error]

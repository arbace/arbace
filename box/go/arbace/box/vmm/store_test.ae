(in-ns 'go.arbace.box.vmm) (go/file "store_test.go" :imports [


    ^{:line 4} [sha256 "crypto/sha256"]
    ^{:line 5} [os "os"]
    ^{:line 6} [filepath "path/filepath"]
    ^{:line 7} [testing "testing"]])





^{:go/end 75} (go/func TestDirStore "TestDirStore: blobs by their hash, read back from any offset; a short\nblob (a write cut off) refused; refs set, read and compared-and-set; a\nname the store does not take refused.\n" [^{:tag (* testing/T)} t]
  (let [dir ^{:go/via [common]} (.TempDir t)
      (values s err) (OpenDirStore dir)]
    (when (!= err nil)
      ^{:go/via [common]} (.Fatal t err))

    (let [data (conv (slice byte) "(defn f [x] x)")
        (values h ^:assign err) (.Put s data)]
      (when (or (!= err nil) (!= h (sha256/Sum256 data)))
        ^{:go/via [common]} (.Fatalf t "put: %x %v" h err))

      (when [(values h2 err) (.Put s data)] (or (!= err nil) (!= h2 h))
        ^{:go/via [common]} (.Fatalf t "put again: %v" err))

      (when [(values n ok) (.Size s h)] (or (not ok) (!= n (conv int64 (len data))))
        ^{:go/via [common]} (.Fatalf t "size: %d %v" n ok))

      (let [buf (make (slice byte) 4)]
        (when [(values n ok) (.Get s h 6 buf)] (or (not ok) (!= (conv string (subslice buf _ n)) "f [x"))
          ^{:go/via [common]} (.Fatalf t "get at 6: %q %v" (subslice buf _ n) ok))

        (when [(values n ok) (.Get s h 100 buf)] (or (not ok) (!= n 0))
          ^{:go/via [common]} (.Fatalf t "get past the end: %d %v" n ok))

        ;; a blob whose file is short: refused, not served
        (let [short (conv (slice byte) "a blob cut off")
            ^{:line 39} hs (sha256/Sum256 short)]
          (when [err (os/WriteFile (.blob s hs) (subslice short _ 5) 0644)] (!= err nil)
            ^{:go/via [common]} (.Fatal t err))

          (when [(values _ ok) (.Size s hs)] ok
            ^{:go/via [common]} (.Fatal t "a short blob served"))

          ;; refs
          (when [(values _ ok) (.Ref s "graph")] ok
            ^{:go/via [common]} (.Fatal t "a ref before any is set"))

          (let [^{:tag (array 32 byte)} none (zero (array 32 byte))]
            (when [err (.SetRef s "graph" h (addr none))] (!= err nil)
              ^{:go/via [common]} (.Fatalf t "set ref, none before: %v" err))

            (when [(values got ok) (.Ref s "graph")] (or (not ok) (!= got h))
              ^{:go/via [common]} (.Fatal t "ref read back"))

            (let [(values h3 _) (.Put s (conv (slice byte) "another"))]
              (when [err (.SetRef s "graph" h3 (addr none))] (!= err ErrConflict)
                ^{:go/via [common]} (.Fatalf t "set ref over one, none expected: %v" err))

              (when [err (.SetRef s "graph" h3 (addr h))] (!= err nil)
                ^{:go/via [common]} (.Fatalf t "compare and set: %v" err))

              (range [_ bad (lit (slice string) "" ".hidden" "a/b" "../x" (conv string (make (slice byte) 65)))]
                (when [err (.SetRef s bad h nil)] (== err nil)
                  ^{:go/via [common]} (.Fatalf t "ref name %q taken" bad)))


              (when [err (.SetRef s "x" (sha256/Sum256 (conv (slice byte) "absent")) nil)] (== err nil)
                ^{:go/via [common]} (.Fatal t "a ref to a blob the store has not"))

              (when [(values _ err) (os/Stat (filepath/Join dir "refs" "graph"))] (!= err nil)
                ^{:go/via [common]} (.Fatal t err)))))))))







^{:go/end 115} (go/func TestDirStoreLimits "TestDirStoreLimits: a blob beyond Max refused as ErrTooLarge; the refs'\nlock file kept beside the refs, not a ref itself (doc/go/BOX-NOTES.md,\nS3); a ref read and written again from a second store on the same\ndirectory.\n" [^{:tag (* testing/T)} t]
  (let [dir ^{:go/via [common]} (.TempDir t)
      (values s err) (OpenDirStore dir)]
    (when (!= err nil)
      ^{:go/via [common]} (.Fatal t err))

    (set! (.-Max s) 8)
    (when [(values _ err) (.Put s (conv (slice byte) "123456789"))] (!= err ErrTooLarge)
      ^{:go/via [common]} (.Fatalf t "a blob over Max: %v" err))

    (let [(values h ^:assign err) (.Put s (conv (slice byte) "12345678"))]
      (when (!= err nil)
        ^{:go/via [common]} (.Fatalf t "a blob of Max: %v" err))

      (when [(values _ ok) (.Ref s ".lock")] ok
        ^{:go/via [common]} (.Fatal t "the lock file read as a ref"))

      (when [err (.SetRef s "r" h nil)] (!= err nil)
        ^{:go/via [common]} (.Fatal t err))

      (let [(values s2 ^:assign err) (OpenDirStore dir)]
        (when (!= err nil)
          ^{:go/via [common]} (.Fatal t err))

        (when [(values got ok) (.Ref s2 "r")] (or (not ok) (!= got h))
          ^{:go/via [common]} (.Fatal t "a ref read from a second store"))

        (let [(values h2 _) (.Put s2 (conv (slice byte) "other"))]
          (when [err (.SetRef s2 "r" h2 (addr h))] (!= err nil)
            ^{:go/via [common]} (.Fatalf t "compare and set from a second store: %v" err))

          (when [err (.SetRef s "r" h (addr h))] (!= err ErrConflict)
            ^{:go/via [common]} (.Fatalf t "a stale compare and set: %v" err)))))))







^{:go/end 222} (go/func TestDirStoreCache "TestDirStoreCache: the blobs read are kept up to CacheMax bytes in all,\nthe least recently used dropped first; a blob larger than CacheMax is\nserved and not kept; a blob dropped is read again from its file and held\nto its hash again (doc/go/BOX-NOTES.md, S3).\n" [^{:tag (* testing/T)} t]
  (let [dir ^{:go/via [common]} (.TempDir t)
      (values s err) (OpenDirStore dir)]
    (when (!= err nil)
      ^{:go/via [common]} (.Fatal t err))

    (when (!= (.-CacheMax s) DefaultCacheMax)
      ^{:go/via [common]} (.Fatalf t "CacheMax %d, not DefaultCacheMax" (.-CacheMax s)))

    (set! (.-CacheMax s) 30)
    (let [blob ^{:go/end 137} (fn ^{:tag (slice byte)} [^byte c ^int n]
          (let [b (make (slice byte) n)]
            (range [i b]
              (aset b i c))

            ^{:line 136} b))

        (values a b c big) (values (blob \a 10) (blob \b 10) (blob \c 10) (blob \z 31))
        (values ^{:tag (array 32 byte)} ha ^{:tag (array 32 byte)} hb ^{:tag (array 32 byte)} hc ^{:tag (array 32 byte)} hbig) (zero (array 32 byte))]
      (range [_ x (lit (slice (struct
                ^{:line 141 :tag (* (array 32 byte))} h
                ^{:line 142 :tag (slice byte)} b))
            (lit _ (addr ha) a) (lit _ (addr hb) b) (lit _ (addr hc) c) (lit _ (addr hbig) big))]
        (let [(values h err) (.Put s (.-b x))]
          (when (!= err nil)
            ^{:go/via [common]} (.Fatal t err))

          (set! @(.-h x) h)))

      (let [cached ^{:go/end 155} (fn [^int want ^int64 wantBytes]
            ^{:go/via [common]} (.Helper t)
            (when [(values n nb) (.Cached s)] (or (!= n want) (!= nb wantBytes))
              ^{:go/via [common]} (.Fatalf t "cached %d blobs, %d bytes; want %d, %d" n nb want wantBytes)))]


        ;; Put reads nothing back: nothing kept yet
        (cached 0 0)
        (range [_ h (lit (slice (array 32 byte)) ha hb hc)]
          (when [(values n ok) (.Size s h)] (or (not ok) (!= n 10))
            ^{:go/via [common]} (.Fatalf t "size: %d %v" n ok)))


        (cached 3 30)
        ;; a used last: b is the least recently used, and goes first
        (when [(values _ ok) (.Size s ha)] (not ok)
          ^{:go/via [common]} (.Fatal t "size of a"))

        (let [d (blob \d 10)
            (values hd ^:assign err) (.Put s d)]
          (when (!= err nil)
            ^{:go/via [common]} (.Fatal t err))

          (when [(values _ ok) (.Size s hd)] (not ok)
            ^{:go/via [common]} (.Fatal t "size of d"))

          (cached 3 30)
          (.Lock (.-mu s))
          (let [(values _ keptA) (aget (.-cache s) ha)
              (values _ keptB) (aget (.-cache s) hb)]
            (.Unlock (.-mu s))
            (when (or (not keptA) keptB)
              ^{:go/via [common]} (.Fatalf t "a kept %v, b kept %v: want a, not b" keptA keptB))

            ;; larger than the cache: served, not kept, the others left alone
            (let [buf (make (slice byte) 64)]
              (when [(values n ok) (.Get s hbig 0 buf)] (or (not ok) (!= n 31) (!= (aget buf 30) \z))
                ^{:go/via [common]} (.Fatalf t "get of a blob larger than the cache: %d %v" n ok))

              (cached 3 30)
              ;; b, dropped, is read again from its file, and held to its hash: a file
              ;; changed under it is refused
              (when [(values n ok) (.Get s hb 0 buf)] (or (not ok) (!= n 10) (!= (aget buf 0) \b))
                ^{:go/via [common]} (.Fatalf t "get of a dropped blob: %d %v" n ok))

              ;; now b, d, a, the most recently used first; a's file changed under it
              (when [err (os/WriteFile (.blob s ha) (conv (slice byte) "changed!!!") 420)] (!= err nil)
                ^{:go/via [common]} (.Fatal t err))

              (when [(values _ ok) (.Size s ha)] (not ok)
                ^{:go/via [common]} (.Fatal t "a kept blob not served from the cache"))

              ;; a, b, d: c read again drops d, and d read again drops a
              (when [(values _ ok) (.Size s hc)] (not ok)
                ^{:go/via [common]} (.Fatal t "size of c"))

              (when [(values _ ok) (.Size s hb)] (not ok)
                ^{:go/via [common]} (.Fatal t "size of b"))

              (when [(values _ ok) (.Size s hd)] (not ok)
                ^{:go/via [common]} (.Fatal t "size of d"))

              (cached 3 30)
              (when [(values _ ok) (.Size s ha)] ok
                ^{:go/via [common]} (.Fatal t "a changed blob served once dropped"))

              ;; CacheMax 0 keeps nothing new
              (set! (.-CacheMax s) 0)
              (.Lock (.-mu s))
              (.keep s hd d)
              (.Unlock (.-mu s))
              (cached 3 30))))))))

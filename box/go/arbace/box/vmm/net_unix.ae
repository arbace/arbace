

(in-ns 'go.arbace.box.vmm) (go/file "net_unix.go" :build ["//go:build linux || darwin"] :imports [


    ^{:line 6} [errors "errors"]
    ^{:line 7} [syscall "syscall"]
    ^{:line 8} [unsafe "unsafe"]])






^{:go/end 35} (go/func sockopt "sockopt is the level and the option of SocketOptions' number opt.\n" [^int opt] :results [int int bool]
  (switch opt
    (case [optTcpNoDelay]
      (return syscall/IPPROTO_TCP syscall/TCP_NODELAY true))
    (case [optIpTos]
      (return syscall/IPPROTO_IP syscall/IP_TOS true))
    (case [optReuseAddr]
      (return syscall/SOL_SOCKET syscall/SO_REUSEADDR true))
    (case [optKeepAlive]
      (return syscall/SOL_SOCKET syscall/SO_KEEPALIVE true))
    (case [optReusePort]
      (return syscall/SOL_SOCKET soReusePort true))
    (case [optSndBuf]
      (return syscall/SOL_SOCKET syscall/SO_SNDBUF true))
    (case [optRcvBuf]
      (return syscall/SOL_SOCKET syscall/SO_RCVBUF true))
    (case [optOOBInline]
      (return syscall/SOL_SOCKET syscall/SO_OOBINLINE true)))

  (return 0 0 false))


^{:go/end 43} (go/func rawConn [^any s] :results [syscall/RawConn error]
  (let [(values sc ok) (assert syscall/Conn s)]
    (when (not ok)
      (return nil syscall/ENOTSOCK))

    (.SyscallConn sc)))




^{:go/end 74} (go/func setOption "setOption sets option opt of a listener or a connection, as jrt's\nOSHost does natively (net_linux.ae).\n" ^error [^any s ^int opt ^int value]
  (let [(values rc err) (rawConn s)]
    (when (!= err nil)
      (return err))

    (let [^error serr (zero error)]
      (if (== opt optLinger)
        (let [^syscall/Linger l (zero syscall/Linger)]
          (when (>= value 0)
            (set! (values (.-Onoff l) (.-Linger l)) (values 1 (conv int32 value))))

          (set! err (.Control rc ^{:go/end 60} (fn [^uintptr fd]
                (set! serr (syscall/SetsockoptLinger (conv int fd) syscall/SOL_SOCKET syscall/SO_LINGER (addr l)))))))


        (let [(values level name ok) (sockopt opt)]
          (when (not ok)
            (return (errors/New "unknown option")))

          (set! err (.Control rc ^{:go/end 68} (fn [^uintptr fd]
                (set! serr (syscall/SetsockoptInt (conv int fd) level name value)))))))


      (when (!= err nil)
        (return err))

      ^{:line 73} serr)))




^{:go/end 115} (go/func getOption "getOption is option opt of a listener or a connection (a boolean's 1\nwhen set; SO_LINGER's -1 when off).\n" [^any s ^int opt] :results [int error]
  (let [(values rc err) (rawConn s)]
    (when (!= err nil)
      (return 0 err))

    (let [^int v (zero int)
        ^{:line 84 :tag error} serr (zero error)]
      (if (== opt optLinger)
        (let [^syscall/Linger l (zero syscall/Linger)
            ^{:line 87} size (conv uint32 (unsafe/Sizeof l))]
          (set! err (.Control rc ^{:go/end 93} (fn [^uintptr fd]
                (when [(values _ _ e) (syscall/Syscall6 syscall/SYS_GETSOCKOPT fd syscall/SOL_SOCKET syscall/SO_LINGER
                      (conv uintptr (conv unsafe/Pointer (addr l))) (conv uintptr (conv unsafe/Pointer (addr size))) 0)] (!= e 0)
                  (set! serr e)))))


          (if (== (.-Onoff l) 0)
            (set! v -1)

            (set! v (conv int (.-Linger l)))))


        (let [(values level name ok) (sockopt opt)]
          (when (not ok)
            (return 0 (errors/New "unknown option")))

          (set! err (.Control rc ^{:go/end 106} (fn [^uintptr fd]
                (set! (values v serr) (syscall/GetsockoptInt (conv int fd) level name)))))))


      (when (!= err nil)
        (return 0 err))

      (when (and (== serr nil) (!= opt optLinger) (!= opt optSndBuf) (!= opt optRcvBuf) (!= opt optIpTos) (!= v 0))
        (set! v 1))

      (return v serr))))

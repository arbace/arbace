(in-ns 'go.arbace.box.vmm) (go/file "tamago_arm64.go" :imports [


    ^{:line 4} [hv "arbace/box/hv"]])








^{:go/end 29} (go/func setupGo "setupGo is a Go guest's entry state past the C guest's (guest/abi): X2\nRamStart (in place of the C guest's heap), X3 RamSize, X4 the offset of\nthe runtime's first stack under the top, X5 the vCPUs it has (doc/GUEST.md,\n*SMP*).  The counter's rate needs no\nregister: the board reads CNTFRQ_EL0, which KVM/arm64 lets EL1 read, as\nit does CNTVCT_EL0 (doc/GUEST.md, *The second guest*, arm64).\n" ^error [^hv/VCPU v ^{:tag (* layout)} l]
  ^{:go/breaks [3]} (let [regs (lit (slice (struct
            ^{:line 15 :tag hv/Reg} r
            ^{:line 16 :tag uint64} val))

        (lit _ hv/RegX2 (.-ramStart l))
        (lit _ hv/RegX3 (- (.-size l) (.-ramStart l)))
        (lit _ hv/RegX4 (- (.-size l) (.-stackTop l)))
        (lit _ hv/RegX5 (conv uint64 (.-cpus l))))]

    (range [_ r regs]
      (when [err (hv/VCPUSetReg v (.-r r) (.-val r))] (!= err nil)
        (return err)))


    nil))

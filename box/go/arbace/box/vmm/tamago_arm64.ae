(in-ns 'go.arbace.box.vmm) (go/file "tamago_arm64.go" :imports [


    ^{:line 4} [time "time"]

    ^{:line 6} [hv "arbace/box/hv"]])








(go/const ^{:val 68719476736 :doc "maxGuestEnd is the end of the highest RAM a guest may have: 64 GiB, the\n36-bit addresses of the guest's translation (TCR_EL1's T0SZ and IPS,\nsetup_arm64.go) and of Hypervisor.framework's default IPA size.\n"} maxGuestEnd (<< 1 36))



^{:go/end 31} (go/func setupGo "setupGo is a Go guest's entry state past the C guest's (guest/abi): X2\nRamStart (in place of the C guest's heap), X3 RamSize, X4 the offset of\nthe runtime's first stack under the top, X5 the vCPUs it has (doc/GUEST.md,\n*SMP*).  The counter's rate needs no\nregister: the board reads CNTFRQ_EL0, which KVM/arm64 lets EL1 read, as\nit does CNTVCT_EL0 (doc/GUEST.md, *The second guest*, arm64).\n" ^error [^hv/VCPU v ^{:tag (* layout)} l]
  ^{:go/breaks [3]} (let [regs (lit (slice (struct
            ^{:line 17 :tag hv/Reg} r
            ^{:line 18 :tag uint64} val))

        (lit _ hv/RegX2 (.-ramStart l))
        (lit _ hv/RegX3 (- (.-size l) (.-ramStart l)))
        (lit _ hv/RegX4 (- (.-size l) (.-stackTop l)))
        (lit _ hv/RegX5 (conv uint64 (.-cpus l))))]

    (range [_ r regs]
      (when [err (hv/VCPUSetReg v (.-r r) (.-val r))] (!= err nil)
        (return err)))


    nil))






^{:go/end 39} (go/func setWallClock "setWallClock puts the host's wall clock, Unix nanoseconds, in a Go\nguest's X6 (guest/abi's entry state; D10, Arbace's addition): read just\nbefore the boot vCPU first runs, so that the board's clock, zero at its\nentry, offset by it is the wall clock.\n" ^error [^hv/VCPU v]
  (hv/VCPUSetReg v hv/RegX6 (conv uint64 (.UnixNano (time/Now)))))

(in-ns 'go.arbace.box.vmm) (go/file "alt_arm64.go" :imports [

    ^{:line 3} [hv "arbace/box/hv"]])






(go/const ^{:val 3271557207 :doc "AltHVC is the alternative trap's SMCCC function ID (guest/rt/rt.c's\nWHIM_HVC_FN): an HVC with it in X0 is a call, the call block's address in\nX1 -- measured against the doorbell (doc/GUEST.md, milestone 5).  KVM\nanswers HVCs itself unless told to forward a range\n(KVM_ARM_VM_SMCCC_FILTER); the framework returns every one.\n"} AltHVC 0xc3000057)



^{:go/end 20} (go/func altCall "altCall is the register holding the call block when an exit is a call\nmade the alternative way.\n" [^hv/VCPU v ^hv/Syndrome s ^uint64 _] :results [hv/Reg bool]
  (when (!= (.EC s) hv/ECHVC64)
    (return 0 false))

  (let [(values fn err) (hv/VCPUGetReg v hv/RegX0)]
    (return hv/RegX1 (and (== err nil) (== fn AltHVC)))))





^{:go/end 25} (go/func vmSetup "vmSetup has KVM forward the alternative trap's HVC; a kernel without the\nfilter (before 6.4) leaves the doorbell the only way, which it always is\nfor the runtime as built by default.\n" [] (hv/ForwardHVC AltHVC 1))

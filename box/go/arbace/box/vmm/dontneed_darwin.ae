(in-ns 'go.arbace.box.vmm) (go/file "dontneed_darwin.go" :imports [])





^{:go/end 7} (go/func dontNeed "dontNeed would give b's pages back to the host; the syscall package has\nno madvise on macOS, and the pages stay (an AP's unused stack, 8 MiB\neach, touched by the guest's runtime as it cleared them).  NOT RUN\nhere: built for darwin as a compile check.\n" [(slice byte)])

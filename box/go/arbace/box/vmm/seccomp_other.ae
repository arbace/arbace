

(in-ns 'go.arbace.box.vmm) (go/file "seccomp_other.go" :build ["//go:build !linux"] :imports [])




(go/var ^{:tag (func [] [error]) :doc "Seccomp is nil outside Linux: there is no system-call filter to put on.\nOn macOS the monitor's hardening is the app sandbox, which its signature's\nentitlements ask for (doc/GUEST.md, *Running on the Mac*).\n"} Seccomp)

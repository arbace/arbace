^{:go/end 196} (go/func imageSymbols "imageSymbols is the values of the symbols of the 64-bit ELF image f\nnamed in names, of those it defines: one pass over its symbol table,\nread with its strings, that makes no Symbol of each (f.Symbols makes\none of each of Arbace's 150,000, 30 MB the launcher kept to the end).\n" [^{:tag (* elf/File)} f & ^{:tag (slice string)} names] :results [(map string uint64) error]
  (let [symtab (.SectionByType f elf/SHT_SYMTAB)]
    (when (== symtab nil)
      (return nil elf/ErrNoSymbols))

    (when (>= (conv int ^{:go/via [SectionHeader]} (.-Link symtab)) (len (.-Sections f)))
      (return nil (errors/New "the symbol table's strings are not a section")))

    (let [(values syms err) (.Data symtab)]
      (when (!= err nil)
        (return nil err))

      (let [(values strs ^:assign err) (.Data (aget (.-Sections f) ^{:go/via [SectionHeader]} (.-Link symtab)))]
        (when (!= err nil)
          (return nil err))

        (let [found (lit (map string uint64))]
          ;; each symbol: its name's offset (4 bytes), info, other, section (2),
          ;; value (8), size (8); the first is the null symbol
          (for [i elf/Sym64Size] (<= (+ i elf/Sym64Size) (len syms)) (set! i + elf/Sym64Size)
            (let [at (.Uint32 ^{:go/via [FileHeader]} (.-ByteOrder f) (subslice syms i))]
              (when (>= (conv int at) (len strs))
                (continue))

              (let [name (subslice strs at)]
                (when [n (bytes/IndexByte name 0)] (>= n 0)
                  (set! name (subslice name _ n)))

                (range [_ w names]
                  (when (== (conv string name) w)
                    (aset found w (.Uint64 ^{:go/via [FileHeader]} (.-ByteOrder f) (subslice syms (+ i 8)))))))))



          (return found nil))))))

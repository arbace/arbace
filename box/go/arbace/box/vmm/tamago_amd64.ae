(in-ns 'go.arbace.box.vmm) (go/file "tamago_amd64.go" :imports [


    ^{:line 4} [time "time"]

    ^{:line 6} [hv "arbace/box/hv"]])








(go/const ^{:val 1099511627776 :doc "maxGuestEnd is the end of the highest RAM a guest may have: 1 TiB, the\nTamaGo runtime's heap addresses' 40 bits (goos.HeapAddrBits).\n"} maxGuestEnd (<< 1 40))







^{:go/end 44} (go/func setupGo "setupGo is a Go guest's entry state past the C guest's (guest/abi): the\nRAM the runtime may use, the offset of its first stack under the top,\nand the time-stamp counter's rate, which TamaGo's nanotime scales -- read\nfrom KVM, since amd64 has no register that says it -- and in R10 the\nvCPUs it has (doc/GUEST.md, *SMP*).  The board enables\nSSE itself, as its own first instructions.\n" ^error [^hv/VCPU v ^{:tag (* layout)} l]
  (let [(values khz err) (hv/TSCFrequency v)]
    (when (!= err nil)
      (return err))

    ^{:go/breaks [3]} (let [regs (lit (slice (struct
              ^{:line 29 :tag hv/Reg} r
              ^{:line 30 :tag uint64} val))

          (lit _ hv/RegRDX (.-ramStart l))
          (lit _ hv/RegRCX (- (.-size l) (.-ramStart l)))
          (lit _ hv/RegR8 (- (.-size l) (.-stackTop l)))
          (lit _ hv/RegR10 (conv uint64 (.-cpus l)))
          (lit _ hv/RegR9 khz))]

      (range [_ r regs]
        (when [err (hv/VCPUSetReg v (.-r r) (.-val r))] (!= err nil)
          (return err)))


      nil)))






^{:go/end 52} (go/func setWallClock "setWallClock puts the host's wall clock, Unix nanoseconds, in a Go\nguest's R11 (guest/abi's entry state; D10, Arbace's addition): read just\nbefore the boot vCPU first runs, so that the board's clock, zero at its\nentry, offset by it is the wall clock.\n" ^error [^hv/VCPU v]
  (hv/VCPUSetReg v hv/RegR11 (conv uint64 (.UnixNano (time/Now)))))

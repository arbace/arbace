(in-ns 'go.arbace.box.vmm) (go/file "tamago_amd64.go" :imports [


    ^{:line 4} [hv "arbace/box/hv"]])








^{:go/end 34} (go/func setupGo "setupGo is a Go guest's entry state past the C guest's (guest/abi): the\nRAM the runtime may use, the offset of its first stack under the top,\nand the time-stamp counter's rate, which TamaGo's nanotime scales -- read\nfrom KVM, since amd64 has no register that says it -- and in R10 the\nvCPUs it has (doc/GUEST.md, *SMP*).  The board enables\nSSE itself, as its own first instructions.\n" ^error [^hv/VCPU v ^{:tag (* layout)} l]
  (let [(values khz err) (hv/TSCFrequency v)]
    (when (!= err nil)
      (return err))

    ^{:go/breaks [3]} (let [regs (lit (slice (struct
              ^{:line 19 :tag hv/Reg} r
              ^{:line 20 :tag uint64} val))

          (lit _ hv/RegRDX (.-ramStart l))
          (lit _ hv/RegRCX (- (.-size l) (.-ramStart l)))
          (lit _ hv/RegR8 (- (.-size l) (.-stackTop l)))
          (lit _ hv/RegR10 (conv uint64 (.-cpus l)))
          (lit _ hv/RegR9 khz))]

      (range [_ r regs]
        (when [err (hv/VCPUSetReg v (.-r r) (.-val r))] (!= err nil)
          (return err)))


      nil)))

(in-ns 'go.arbace.box.vmm) (go/file "alt_amd64.go" :imports [

    ^{:line 3} [hv "arbace/box/hv"]])





(go/const ^{:val 20823 :doc "AltPort is the alternative trap's port (guest/rt/rt.c's WHIM_PORT): an\n`out` there is a call, the call block's address in EAX -- measured against\nthe doorbell (doc/GUEST.md, milestone 5).  KVM reports it as\nKVM_EXIT_IO, which hv reports as an exception of its own class.\n"} AltPort 0x5157)



^{:go/end 15} (go/func altCall "altCall is the register holding the call block when an exit is a call\nmade the alternative way.\n" [^hv/VCPU _ ^hv/Syndrome s ^uint64 addr] :results [hv/Reg bool]
  (return hv/RegRAX (and (== (.EC s) hv/ECPortIO) (== addr AltPort))))



^{:go/end 18} (go/func vmSetup "vmSetup is what the ISA's VM needs before its vCPU: nothing on amd64.\n" [])

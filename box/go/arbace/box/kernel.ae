;; The box's kernel: processes at ring 3 (doc/go/PROCESS-SPEC.md, KU1): the package
;; arbace/box/kernel, Arbace's own.
(ns go.arbace.box.kernel
  (:require [arbace.go :as go]))

(go/package kernel
  :path "arbace/box/kernel"
  :files ["helpers_amd64.go" "kernel.go" "tables_amd64.go"]
  :other-files ["kernel_amd64.s"]
  :positions :lines)

(load "kernel/helpers_amd64")
(load "kernel/kernel")
(load "kernel/tables_amd64")

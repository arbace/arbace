;; go-whim's box, vendored (box/README.md): the package arbace/box/hv, one tree for
;; every target (its files' build constraints select them).
(ns go.arbace.box.hv
  (:require [arbace.go :as go]))

(go/package hv
  :path "arbace/box/hv"
  :files ["hv.go" "hvf_darwin.go" "kvm_linux.go" "kvm_linux_amd64.go" "kvm_linux_arm64.go" "regs_amd64.go" "regs_arm64.go" "tsc_linux_amd64.go"]
  :test-files ["hv_amd64_test.go" "hv_arm64_test.go"]
  :positions :lines)

(load "hv/hv")
(load "hv/hvf_darwin")
(load "hv/kvm_linux")
(load "hv/kvm_linux_amd64")
(load "hv/kvm_linux_arm64")
(load "hv/regs_amd64")
(load "hv/regs_arm64")
(load "hv/tsc_linux_amd64")
(load "hv/hv_amd64_test")
(load "hv/hv_arm64_test")

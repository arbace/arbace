;; purego v0.11.1, vendored (box/README.md; doc/go/BOX-NOTES.md, S4, BX62): the package
;; arbace/box/purego, its files for darwin/arm64.
(ns go.arbace.box.purego
  (:require [arbace.go :as go]))

(go/package purego
  :path "arbace/box/purego"
  :files ["cdecl.go" "dlerror.go" "dlfcn.go" "dlfcn_darwin.go" "func.go" "gen.go" "go_runtime.go" "nocgo.go" "struct_arm64.go" "syscall.go" "syscall_notstackargs.go" "syscall_unix.go"]
  :other-files ["abi_arm64.h" "dlfcn_stubs.s" "sys_arm64.s" "sys_unix_arm64.s" "zcallback_arm64.s"]
  :positions :lines)

(load "purego/cdecl")
(load "purego/dlerror")
(load "purego/dlfcn")
(load "purego/dlfcn_darwin")
(load "purego/func")
(load "purego/gen")
(load "purego/go_runtime")
(load "purego/nocgo")
(load "purego/struct_arm64")
(load "purego/syscall")
(load "purego/syscall_notstackargs")
(load "purego/syscall_unix")

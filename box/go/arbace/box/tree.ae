;; The box's tool guests (doc/go/BOX-NOTES.md, S7): the package arbace/box/tree, Arbace's own.
(ns go.arbace.box.tree
  (:require [arbace.go :as go]))

(go/package tree
  :path "arbace/box/tree"
  :files ["edn.go" "request.go" "tree.go"]
  :test-files ["tree_test.go"]
  :positions :lines)

(load "tree/edn")
(load "tree/request")
(load "tree/tree")
(load "tree/tree_test")

;; go-whim's box, vendored (box/README.md): the package arbace/box/libsys, one tree for
;; every target (its files' build constraints select them).
(ns go.arbace.box.libsys
  (:require [arbace.go :as go]))

(go/package libsys
  :path "arbace/box/libsys"
  :files ["libsys.go"]
  :positions :lines)

(load "libsys/libsys")

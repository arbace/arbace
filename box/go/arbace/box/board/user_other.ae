

;; Processes are amd64-only so far (doc/go/PROCESS-SPEC.md, KU1; arm64 is KU3). On other arches the
;; board's process hooks are no-ops, so the kernel's data snapshot (hwinit1) and the kernel package
;; do not build there yet.
(in-ns 'go.arbace.box.board) (go/file "user_other.go" :build ["//go:build !amd64"] :doc "Processes are amd64-only so far (doc/go/PROCESS-SPEC.md, KU1; arm64 is KU3). On other arches the\nboard's process hooks are no-ops, so the kernel's data snapshot (hwinit1) and the kernel package\ndo not build there yet.\n" :imports [])


^{:go/end 9} (go/func snapshotData "snapshotData does nothing where processes are not built (a guest never reads a snapshot).\n" [])


^{:go/end 12} (go/func DataImage "DataImage is empty where processes are not built.\n" [] :results [^{:tag (slice byte)} image ^uintptr rwStart] (return nil 0))

^{:go/end 177} (go/func Env "Env is the environment the monitor wrote into guest memory after the\ncommand line's pointers (guest/abi): NAME=VALUE strings.\n" ^{:tag (slice string)} []
  (when (== bootArgv nil)
    (return nil))

  (let [^{:tag (slice string)} env (zero (slice string))]
    (for [i (+ (conv uintptr bootArgc) 1)] _ (inc! i)
      (let [p @(conv (* (* byte)) (unsafe/Add bootArgv (* i 8)))]
        (when (== p nil)
          (return env))

        (let [n 0]
          (while (!= @(conv (* byte) (unsafe/Add (conv unsafe/Pointer p) n)) 0)
            (inc! n))

          (set! env (append env (conv string (unsafe/Slice p n)))))))))








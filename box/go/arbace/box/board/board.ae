^{:go/end 216} (go/func NilPanics "NilPanics makes a page fault below the first page, in Go code, the\nrun-time panic a nil dereference is on Linux (Arbace's addition; amd64,\nand arm64 since S4: a data abort below the first page), which recover sees as a\nruntime.Error: what a program that recovers from nil dereferences needs\n(Arbace's NullPointerException).  Without it, as go-whim's guests run,\nthe fault ends the run.\n" []
  (let [f sigpanic]
    (set! sigpanicPC @@(conv (* (* uintptr)) (conv unsafe/Pointer (addr f))))
    (when (!= process 0)
      ;; a process has no vectors of its own: the kernel takes its faults and must know the
      ;; PC a nil dereference resumes at (doc/go/PROCESS-SPEC.md §4.2, §8, KU1).
      (Call abi/NilHandler (conv int64 sigpanicPC) 0 0 0 0))))









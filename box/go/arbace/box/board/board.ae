  (when (== bootArgv nil)
    (return nil))

  (let [ptrs (unsafe/Slice (conv (* (* byte)) bootArgv) (conv int bootArgc))
      ^{:line 148} args (make (slice string) (len ptrs))]
    (range [i p ptrs]

;; Package board is a TamaGo board for whim's monitor (vmm/, doc/GUEST.md):
;; the runtime hooks of GOOS=tamago (runtime/goos) answered as the C guest
;; answers its host -- by hypercalls through the doorbell -- or in the
;; guest where an exit would cost too much.
;;
;;	CPUInit        cpuinit (boot_ISA.s): the monitor's entry state taken
;;	               (guest/abi), SSE on (amd64) or FP and
;;	               SIMD (arm64), the first stack, the runtime's rt0
;;	Hwinit0        nothing: the monitor has set the machine up
;;	Hwinit1        goos.Exit and goos.Idle set
;;	Nanotime       the counter (TSC; CNTVCT_EL0), at the rate the monitor
;;	               said (amd64) or CNTFRQ_EL0 says (arm64), from the
;;	               host's wall clock at the entry (R11; X6): in the guest,
;;	               since the scheduler asks it often; TamaGo's runtime
;;	               takes it for the wall clock too
;;	Printk         a line buffered, then abi.Message to stderr: a call
;;	GetRandomData  abi.Random: a call
;;	InitRNG        nothing
;;	Exit           abi.Exit: a call, which never returns
;;	Idle           one vCPU: abi.CPUPark to near the deadline, then a spin
;;	               to it, there being no interrupt to wait for; several: a
;;	               spin, then abi.CPUPark
;;	RamStart, RamSize, RamStackOffset
;;	               the monitor's, in registers at the entry
;;	Task, Wake, ProcID
;;	               on several vCPUs (smp.go): abi.CPUStart, abi.CPUWake
;;	               and abi.CPUSelf
;;
;; No interrupts, no timer: the runtime schedules its goroutines
;; cooperatively on each vCPU, and a vCPU only stops in a hypercall.  An
;; exception goes through the monitor's IDT to whim_vectors, which reports
;; it by abi.Fault as the C guest's vectors do.
(in-ns 'go.arbace.box.board) (go/file "board.go" :doc "Package board is a TamaGo board for whim's monitor (vmm/, doc/GUEST.md):\nthe runtime hooks of GOOS=tamago (runtime/goos) answered as the C guest\nanswers its host -- by hypercalls through the doorbell -- or in the\nguest where an exit would cost too much.\n\n\tCPUInit        cpuinit (boot_ISA.s): the monitor's entry state taken\n\t               (guest/abi), SSE on (amd64) or FP and\n\t               SIMD (arm64), the first stack, the runtime's rt0\n\tHwinit0        nothing: the monitor has set the machine up\n\tHwinit1        goos.Exit and goos.Idle set\n\tNanotime       the counter (TSC; CNTVCT_EL0), at the rate the monitor\n\t               said (amd64) or CNTFRQ_EL0 says (arm64), from the\n\t               host's wall clock at the entry (R11; X6): in the guest,\n\t               since the scheduler asks it often; TamaGo's runtime\n\t               takes it for the wall clock too\n\tPrintk         a line buffered, then abi.Message to stderr: a call\n\tGetRandomData  abi.Random: a call\n\tInitRNG        nothing\n\tExit           abi.Exit: a call, which never returns\n\tIdle           one vCPU: abi.CPUPark to near the deadline, then a spin\n\t               to it, there being no interrupt to wait for; several: a\n\t               spin, then abi.CPUPark\n\tRamStart, RamSize, RamStackOffset\n\t               the monitor's, in registers at the entry\n\tTask, Wake, ProcID\n\t               on several vCPUs (smp.go): abi.CPUStart, abi.CPUWake\n\t               and abi.CPUSelf\n\nNo interrupts, no timer: the runtime schedules its goroutines\ncooperatively on each vCPU, and a vCPU only stops in a hypercall.  An\nexception goes through the monitor's IDT to whim_vectors, which reports\nit by abi.Fault as the C guest's vectors do.\n" :imports [


    ^{:line 36} [math "math"]
    ^{:line 37} [bits "math/bits"]
    ^{:line 38} [goos "runtime/goos"]
    ^{:line 39} [unsafe "unsafe"]

    ^{:line 41} [abi "arbace/box/abi"]])



(go/const "For the assembly (go_asm.h).\n"

  ^{:line 47} [^{:val 4026531840} doorbellAddr abi/Doorbell]

  ^{:line 49} [^{:val 18} callFault abi/Fault]

  ^{:line 51} [^{:val 64} blockSize abi/BlockSize])



(go/var "What cpuinit keeps of the entry state.\n"
  ^{:line 56} [^uint64 bootArgc]
  ^{:line 57} [^unsafe/Pointer bootArgv] ; **byte, guest-physical: the guest is identity-mapped
  ^{:line 58} [^uint64 tickKHz] ; the counter's rate: the monitor's (amd64), CNTFRQ_EL0's (arm64)
  ^{:line 59} [^uint64 tickBase] ; the counter at the entry: nanotime's zero
  ^{:line 60} [^uint64 nsPerTick] ; nanoseconds a tick, 32.32 fixed point
  ^{:line 61} [^uint64 wallBase] ; the host's wall clock at the entry, Unix ns: nanotime's zero
  ^{:line 62} [^uint64 ncpu] ; the vCPUs the monitor gave: 1, or more (smp.go)

  ^{:line 64} [^uintptr vectors])



(go/type Block "Block is the call block (guest/abi): what the monitor reads and writes.\n" (struct
    ^{:line 69 :tag uint64} Nr
    ^{:line 70 :tag (array 5 int64)} A
    ^{:line 71 :tag int64} Ret
    ^{:line 72 :tag uint64} Event))





(go/directive "//lint:ignore U1000 the assembly's")
(go/var ^{:tag (array (* 2 abi/BlockSize) byte) :doc "faultArea holds the vectors' call block, aligned to the block's size\nwhen used.\n"} faultArea)


(go/func ^:extern ^:go/noescape doorbell [^unsafe/Pointer cb])
(go/func ^:extern ticks ^uint64 []) ; the time-stamp counter, CNTVCT_EL0
(go/func ^:extern pause [])








^{:go/end 100} (go/func ^:go/nosplit Call "Call makes hypercall nr and returns the block as the monitor left it.\nThe block is on the caller's stack, aligned to its size: each call its\nown, whichever vCPU makes it.  Pointer arguments are addresses\n(guest-physical is virtual here); it grows no stack, so an address taken\njust before it stays good.\n" ^Block [^uint64 nr ^int64 a0 ^int64 a1 ^int64 a2 ^int64 a3 ^int64 a4]
  (let [^{:tag (array (* 2 abi/BlockSize) byte)} area (zero (array (* 2 abi/BlockSize) byte))
      ^{:line 95} p (conv unsafe/Pointer (addr (aget area 0)))
      ^{:line 96} b (conv (* Block) (unsafe/Add p (bit-and (- (conv uintptr p)) (- abi/BlockSize 1))))]
    (set! @b (lit Block :Nr nr :A (lit (array 5 int64) a0 a1 a2 a3 a4)))
    (doorbell (conv unsafe/Pointer b))
    ^{:line 99} @b))





^{:go/end 110} (go/func ^:go/nosplit Addr "Addr is the address of p's first byte, 0 when it has none.\n" ^int64 [^{:tag (slice byte)} p]
  (when (== (len p) 0)
    (return 0))

  (conv int64 (conv uintptr (conv unsafe/Pointer (addr (aget p 0))))))



^{:go/end 127} (go/func Args "Args is the command line the monitor wrote into guest memory.\n" ^{:tag (slice string)} []
  (when (== bootArgv nil)
    (return nil))

  (let [ptrs (unsafe/Slice (conv (* (* byte)) bootArgv) (conv int bootArgc))
      ^{:line 118} args (make (slice string) (len ptrs))]
    (range [i p ptrs]
      (let [n 0]
        (while (!= @(conv (* byte) (unsafe/Add (conv unsafe/Pointer p) n)) 0)
          (inc! n))

        (aset args i (conv string (unsafe/Slice p n)))))

    ^{:line 126} args))




^{:go/end 147} (go/func Env "Env is the environment the monitor wrote into guest memory after the\ncommand line's pointers (guest/abi): NAME=VALUE strings.\n" ^{:tag (slice string)} []
  (when (== bootArgv nil)
    (return nil))

  (let [^{:tag (slice string)} env (zero (slice string))]
    (for [i (+ (conv uintptr bootArgc) 1)] _ (inc! i)
      (let [p @(conv (* (* byte)) (unsafe/Add bootArgv (* i 8)))]
        (when (== p nil)
          (return env))

        (let [n 0]
          (while (!= @(conv (* byte) (unsafe/Add (conv unsafe/Pointer p) n)) 0)
            (inc! n))

          (set! env (append env (conv string (unsafe/Slice p n)))))))))







^{:go/end 158} (go/func ^:go/nosplit Exit "Exit ends the guest with code: the console flushed, then abi.Exit, which\nthe monitor never resumes.\n" [^int32 code]
  (flush)
  (while true
    (Call abi/Exit (conv int64 code) 0 0 0 0)))






(go/directive "//lint:ignore U1000 the assembly's")
(go/var ^{:tag uintptr :doc "sigpanicPC is sigpanic's entry when a nil dereference is a run-time\npanic (NilPanics), else 0: the vectors (boot_amd64.s) read it.\n"} sigpanicPC)







^{:go/end 175} (go/func NilPanics "NilPanics makes a page fault below the first page, in Go code, the\nrun-time panic a nil dereference is on Linux (Arbace's addition; amd64:\narm64's vectors still report every exception), which recover sees as a\nruntime.Error: what a program that recovers from nil dereferences needs\n(Arbace's NullPointerException).  Without it, as go-whim's guests run,\nthe fault ends the run.\n" []
  (let [f sigpanic]
    (set! sigpanicPC @@(conv (* (* uintptr)) (conv unsafe/Pointer (addr f))))))







^{:go/end 182} (go/func ^{:go/linkname "sigpanic runtime.sigpanic"} sigpanic "sigpanic is where a nil dereference resumes: the runtime's name, so that\nthe unwinder takes the faulting instruction's frame as it takes a\nsignal's (no sigpanic of its own on TamaGo).\n" [] (panic (lit memoryError)))


(go/type memoryError "memoryError is the run-time error of a nil dereference, as the runtime's.\n" (struct))

^{:go/breaks [3] :go/end 189} (go/method Error ^string [memoryError]
  "runtime error: invalid memory address or nil pointer dereference")


^{:go/end 191} (go/method RuntimeError [memoryError])


^{:go/end 194} (go/func ^{:go/linkname "hwinit0 runtime/goos.Hwinit0"} hwinit0 [])


^{:go/end 200} (go/func ^{:go/linkname "hwinit1 runtime/goos.Hwinit1"} hwinit1 []
  (set! goos/Exit Exit)
  (set! goos/Idle idle))









^{:go/end 223} (go/func idle "idle waits for the scheduler's next timer.  On one vCPU nothing but a\ntimer can make a goroutine runnable (no interrupts, and the vCPU is\nstopped while a call is answered): a wait longer than parkNs parks the\nvCPU in the monitor (abi.CPUPark) until spinNs before the deadline, the\nrest is a spin; with no timer it returns, and the scheduler looks again\n-- a guest deadlocked spins, and the monitor's watchdog ends it.  On\nseveral, another vCPU can, and the idle one parks (smp.go).\n" [^int64 until]
  (when (> ncpu 1)
    (idleSMP until)
    (return))

  (when (or (<= until 0) (== until math/MaxInt64))
    (return))

  (when [ns (- until (nanotime))] (> ns parkNs)
    (Call abi/CPUPark (- ns spinNs) 0 0 0 0))

  (while (< (nanotime) until)
    (pause)))





(go/const ^{:val 200000 :doc "parkNs is the shortest wait one vCPU parks for, rather than spins:\na park is two exits and the host's timer.\n"} parkNs 200000)



^{:go/end 241} (go/func ^:go/nosplit ^{:go/linkname "nanotime runtime/goos.Nanotime"} nanotime ^int64 []
  (when (== nsPerTick 0)
    (let [khz tickKHz]
      (when (== khz 0)
        (set! khz 1000000)) ; no rate said: a guess of 1 GHz

      (set! nsPerTick (/ (<< 1000000 32) khz))))

  (let [(values hi lo) (bits/Mul64 (- (ticks) tickBase) nsPerTick)]
    (conv int64 (+ wallBase (bit-or (<< hi 32) (>> lo 32))))))




(go/var "The console: the runtime's own output (a panic's report), a line at a\ntime to the monitor's stderr.\n"
  ^{:line 246} [^{:tag (array 256 byte)} line]
  ^{:line 247} [^int lineN])




^{:go/end 258} (go/func ^:go/nosplit ^{:go/linkname "printk runtime/goos.Printk"} printk [^byte c]
  (aset line lineN c)
  (inc! lineN)
  (when (or (== c \newline) (== lineN (len line)))
    (flush)))




^{:go/end 266} (go/func ^:go/nosplit flush []
  (when (> lineN 0)
    (Call abi/Message (conv int64 (conv uintptr (conv unsafe/Pointer (addr (aget line 0))))) (conv int64 lineN) 1 0 0)
    (set! lineN 0)))




^{:go/end 269} (go/func ^{:go/linkname "initRNG runtime/goos.InitRNG"} initRNG [])



^{:go/end 277} (go/func ^:go/nosplit ^{:go/linkname "getRandomData runtime/goos.GetRandomData"} getRandomData [^{:tag (slice byte)} b]
  (when (> (len b) 0)
    (Call abi/Random (Addr b) (conv int64 (len b)) 0 0 0)))

^{:go/end 249} (go/func ^{:go/linkname "hwinit0 runtime/goos.Hwinit0"} hwinit0 "hwinit0 starts the heap at RamStart (goos.Bloc) when the monitor has put\nthe RAM above the image (vmm's planGo, HV1 (b), doc/go/BOX-NOTES.md: RAM\nthat does not fit under the doorbell is above 4 GiB): the runtime's break\nwould start at the image's end, in no memory.  Before osinit, which reads\nit.\n" [] (when
    (> (conv uintptr goos/RamStart) (conv uintptr (conv unsafe/Pointer (addr bootArgc))))
    (set! goos/Bloc (conv uintptr goos/RamStart))))


^{:go/end 262} (go/func ^{:go/linkname "hwinit1 runtime/goos.Hwinit1"} hwinit1 []
  (set! goos/Exit Exit)
  (set! goos/Idle idle)
  (when (== process 0)
    ;; snapshot the image's pristine writable data for processes (doc/go/PROCESS-SPEC.md §2.1,
    ;; KU1): on amd64 this copies it, before any package init runs (osinit calls Hwinit1, well
    ;; before runtime.main's doInit), so the kernel can give a process the image's initial data,
    ;; not the kernel's once it has run; on other arches (arm64 is KU3) it is a no-op.
    (snapshotData)))













^{:go/end 293} (go/func idle "idle waits for the scheduler's next timer.  On one vCPU nothing but a\ntimer can make a goroutine runnable (no interrupts, and the vCPU is\nstopped while a call is answered) -- or, once the program has named an\nevent area (EventArea), the host's event: a wait longer than parkNs\nparks the vCPU in the monitor (abi.CPUPark) until spinNs before the\ndeadline, the rest is a spin, unless an event ended the park; with no\ntimer it parks until an event when there is an event area, else it\nreturns, and the scheduler looks again -- a guest deadlocked spins, and\nthe monitor's watchdog ends it.  On several, another vCPU can, and the\nidle one parks (smp.go).\n" [^int64 until]
  (when (> ncpu 1)
    (idleSMP until)
    (return))

  (when (or (<= until 0) (== until math/MaxInt64))
    (when events
      (Call abi/CPUPark -1 0 0 0 0))

    (return))

  (when [ns (- until (nanotime))] (> ns parkNs)
    (when (!= (.-Ret (Call abi/CPUPark (- ns spinNs) 0 0 0 0)) 0)
      (return)))


  (while (< (nanotime) until)
    (pause)))




(go/var ^{:tag bool :doc "events is whether the program has named an event area (EventArea).\n"} events)






^{:go/end 306} (go/func EventArea "EventArea names the program's event area to the monitor (abi.EventArea;\nArbace's addition): area[0] the events the monitor has posted, area[1]\nthose the program has taken, which it writes.  While they differ a park\nends at once; with them one idle vCPU parks without a timer until an\nevent.  false when the monitor refused it.\n" ^bool [^{:tag (* (array 2 uint64))} area]
  (set! events (== (.-Ret (Call abi/EventArea (conv int64 (conv uintptr (conv unsafe/Pointer area))) 0 0 0 0)) 0))
  ^{:line 305} events)




(go/const ^{:val 200000 :doc "parkNs is the shortest wait one vCPU parks for, rather than spins:\na park is two exits and the host's timer.\n"} parkNs 200000)



^{:go/end 324} (go/func ^:go/nosplit ^{:go/linkname "nanotime runtime/goos.Nanotime"} nanotime ^int64 []
  (when (== nsPerTick 0)
    (let [khz tickKHz]
      (when (== khz 0)
        (set! khz 1000000))

      (set! nsPerTick (/ (<< 1000000 32) khz))))

  (let [(values hi lo) (bits/Mul64 (- (ticks) tickBase) nsPerTick)]
    (conv int64 (+ wallBase (bit-or (<< hi 32) (>> lo 32))))))





(go/var "The pristine image of the writable segment's file-backed data (doc/go/PROCESS-SPEC.md §2.1, KU1):\nthe box's program is the kernel and every process (b1), so a process of it needs the image's\ninitial data, not the kernel's once it has run (the inittask states NotStarted, the runtime's\nglobals as linked). hwinit1 snapshots it before any package init runs, and the kernel copies it\ninto a new process's private data pages. A guest never reads it; the copy is a behaviour-neutral\nfew tens of KiB.\n"
  ^{:line 127} [^{:tag (array (* 192 1024) byte)} dataSnap]
  ^{:line 128} [^int dataLen]
  ^{:line 129} [^uintptr dataLo]) ; the writable segment's first page (rwStart)


(go/func ^:extern segData [] :results [^uintptr rwStart ^uintptr dataEnd])


^{:go/end 144} (go/func ^:go/nosplit snapshotData []
  (let [(values lo hi) (segData)
      ^{:line 137} n (conv int (- hi lo))]
    (when (or (< n 0) (> n (len dataSnap)))
      (return)) ; too large to snapshot: the kernel reports it when it builds a process

    (set! dataLo lo)
    (set! dataLen n)
    (copy (subslice dataSnap _ n) (unsafe/Slice (conv (* byte) (conv unsafe/Pointer lo)) n))))





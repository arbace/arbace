^{:go/end 209} (go/func UserSetup "UserSetup prepares the calling vCPU for processes, once: the GDT with the user's segments,\nSYSCALL's MSRs, GS's base its own area, PCIDs and SMAP when the CPU has them (SMEP stays off:\na crossing runs the shared text, user pages, with the process's tables loaded). The caller is\nlocked to its vCPU (runtime.LockOSThread). KU1: one vCPU at a time is what is tested.\n" ^error []
  (when (!= (rdmsr msrGSBase) 0)
    (return nil))

  (when (== userGDT nil)
    (let [^{:tag (array 10 byte)} d (zero (array 10 byte))]
      (sgdt (conv unsafe/Pointer (addr d)))
      (let [limit @(conv (* uint16) (conv unsafe/Pointer (addr (aget d 0))))
          ^{:line 162} base @(conv (* uint64) (conv unsafe/Pointer (addr (aget d 2))))]
        (when (< (+ limit 1) (* 5 8))
          (return (errors/New "board: the monitor's GDT has no TSS")))

        (let [g (new (array 8 uint64))]
          (for [i 0] (< i 5) (inc! i)
            (aset g i @(conv (* uint64) (conv unsafe/Pointer (+ (conv uintptr base) (* 8 (conv uintptr i)))))))

          (aset g 6 0x00cff3000000ffff) ; data, DPL 3
          (aset g 7 0x00affb000000ffff) ; code, DPL 3, long mode
          (set! userGDT g)
          (let [(values _ _ c _) (cpuid 1 0)]
            (set! pcids (!= (bit-and c (<< 1 17)) 0))
            (let [(values _ b _ _) (cpuid 7 0)]
              (set! smap (!= (bit-and b (<< 1 20)) 0))))))))

  (let [^{:tag (array 10 byte)} d (zero (array 10 byte))]
    (set! @(conv (* uint16) (conv unsafe/Pointer (addr (aget d 0)))) (- (* 8 8) 1))
    (set! @(conv (* uint64) (conv unsafe/Pointer (addr (aget d 2)))) (conv uint64 (conv uintptr (conv unsafe/Pointer userGDT))))
    (lgdt (conv unsafe/Pointer (addr d)))

    (let [cr4 (readCR4)]
      (when (and pcids (== (bit-and (readCR3) 0xfff) 0))
        (set! cr4 bit-or cr4PCIDE))

      (when smap
        (set! cr4 bit-or cr4SMAP))

      (writeCR4 cr4)

      ^{:go/breaks [14]} (let [u (addr (lit userCPU))]
        (set! (.-self u) (conv uintptr (conv unsafe/Pointer u)))
        (set! (.-kfx u) (bit-and-not (+ (conv uintptr (conv unsafe/Pointer (addr (aget (.-kfxa u) 0)))) 15) 15))
        (set! (.-kcr3 u) (bit-and-not (readCR3) 0xfff))
        (when (!= (bit-and cr4 cr4PCIDE) 0)
          (set! (.-kcr3 u) bit-or (<< 1 63))) ; the kernel's PCID 0: its tables never change

        (set! (.-kfs u) (rdmsr msrFSBase))
        (set! userCPUs (append userCPUs u))

        (wrmsr msrEFER (bit-or (rdmsr msrEFER) eferSCE))
        (wrmsr msrSTAR (bit-or (<< selUserBase 48) (<< selKernelCode 32)))
        (wrmsr msrLSTAR (conv uint64 (sysentryAddr)))
        (wrmsr msrFMASK fmask)
        (wrmsr msrKernelGSBase 0)
        (wrmsr msrGSBase (conv uint64 (.-self u)))
        nil))))




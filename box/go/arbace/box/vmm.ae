;; go-whim's box, vendored (box/README.md): the package arbace/box/vmm, one tree for
;; every target (its files' build constraints select them).
(ns go.arbace.box.vmm
  (:require [arbace.go :as go]))

(go/package vmm
  :path "arbace/box/vmm"
  :files ["alt_amd64.go" "alt_arm64.go" "die_darwin.go" "die_linux.go" "dontneed_darwin.go" "dontneed_linux.go" "events.go" "imagefile.go" "layout.go" "mapfixed_darwin.go" "mapfixed_linux.go" "net.go" "net_darwin.go" "net_linux.go" "net_other.go" "net_unix.go" "netpolicy.go" "park_linux.go" "park_other.go" "seccomp_linux.go" "seccomp_linux_amd64.go" "seccomp_linux_arm64.go" "seccomp_net_linux.go" "seccomp_net_linux_amd64.go" "seccomp_net_linux_arm64.go" "seccomp_net_other.go" "seccomp_other.go" "setup_amd64.go" "setup_arm64.go" "smp.go" "spawn.go" "store.go" "tamago.go" "tamago_amd64.go" "tamago_arm64.go" "vmm.go"]
  :test-files ["abi_test.go" "imagefile_test.go" "layout_test.go" "net_test.go" "store_test.go"]
  :positions :lines)

(load "vmm/alt_amd64")
(load "vmm/alt_arm64")
(load "vmm/die_darwin")
(load "vmm/die_linux")
(load "vmm/dontneed_darwin")
(load "vmm/dontneed_linux")
(load "vmm/events")
(load "vmm/imagefile")
(load "vmm/layout")
(load "vmm/mapfixed_darwin")
(load "vmm/mapfixed_linux")
(load "vmm/net")
(load "vmm/net_darwin")
(load "vmm/net_linux")
(load "vmm/net_other")
(load "vmm/net_unix")
(load "vmm/netpolicy")
(load "vmm/park_linux")
(load "vmm/park_other")
(load "vmm/seccomp_linux")
(load "vmm/seccomp_linux_amd64")
(load "vmm/seccomp_linux_arm64")
(load "vmm/seccomp_net_linux")
(load "vmm/seccomp_net_linux_amd64")
(load "vmm/seccomp_net_linux_arm64")
(load "vmm/seccomp_net_other")
(load "vmm/seccomp_other")
(load "vmm/setup_amd64")
(load "vmm/setup_arm64")
(load "vmm/smp")
(load "vmm/spawn")
(load "vmm/store")
(load "vmm/tamago")
(load "vmm/tamago_amd64")
(load "vmm/tamago_arm64")
(load "vmm/vmm")
(load "vmm/abi_test")
(load "vmm/imagefile_test")
(load "vmm/layout_test")
(load "vmm/net_test")
(load "vmm/store_test")

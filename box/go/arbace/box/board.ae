;; go-whim's box, vendored (box/README.md): the package arbace/box/board, one tree for
;; every target (its files' build constraints select them).
(ns go.arbace.box.board
  (:require [arbace.go :as go]))

(go/package board
  :path "arbace/box/board"
  :files ["board.go" "smp.go" "user_amd64.go" "user_other.go"]
  :other-files ["boot_amd64.s" "boot_arm64.s" "user_amd64.s"]
  :positions :lines)

(load "board/board")
(load "board/smp")
(load "board/user_amd64")
(load "board/user_other")

(go/var
  ^{:line 44} [^{:tag (func [^int32 sig ^{:tag (* Sigaction)} act ^{:tag (* Sigaction)} old] [int32])} sigaction]
  ^{:line 45} [^{:tag (func [^int32 how ^{:tag (* uint32)} set ^{:tag (* uint32)} old] [int32])} pthreadSigmask]
  ^{:line 46} [^{:tag (func [^{:tag (* uint32)} set] [int32])} sigpending]
  ^{:line 47} [^{:tag (func [] [uintptr])} pthreadSelf]

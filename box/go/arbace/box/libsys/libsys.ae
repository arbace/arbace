^{:go/end 85} (go/func Action "Action sets sig's action to act (when not nil) and returns the one before.\n" [^syscall/Signal sig ^{:tag (* Sigaction)} act] :results [Sigaction error]
  (let [^Sigaction old (zero Sigaction)]



;; Package libsys is the few signal functions of macOS's libSystem that
;; package syscall does not offer and a raw system call cannot replace:
;; sigaction (the kernel's form takes the trampoline libc supplies, and the Go
;; runtime installs its handlers through libc), pthread_sigmask, sigpending
;; and pthread_kill -- bound by purego, no cgo, as hv binds
;; Hypervisor.framework.  The terminal host's Suspend and the monitor's Die
;; use them for what rt_sigaction, rt_sigprocmask, rt_sigpending and tgkill
;; do on Linux.  NOT RUN here: written against <signal.h>, built for darwin
;; as a compile check.
(in-ns 'go.arbace.box.libsys) (go/file "libsys.go" :build ["//go:build darwin"] :doc "Package libsys is the few signal functions of macOS's libSystem that\npackage syscall does not offer and a raw system call cannot replace:\nsigaction (the kernel's form takes the trampoline libc supplies, and the Go\nruntime installs its handlers through libc), pthread_sigmask, sigpending\nand pthread_kill -- bound by purego, no cgo, as hv binds\nHypervisor.framework.  The terminal host's Suspend and the monitor's Die\nuse them for what rt_sigaction, rt_sigprocmask, rt_sigpending and tgkill\ndo on Linux.  NOT RUN here: written against <signal.h>, built for darwin\nas a compile check.\n" :imports [


    ^{:line 15} [fmt "fmt"]
    ^{:line 16} [sync "sync"]
    ^{:line 17} [syscall "syscall"]

    ^{:line 19} [purego "arbace/box/purego"]])


(go/const ^{:val "/usr/lib/libSystem.B.dylib"} lib "/usr/lib/libSystem.B.dylib")




(in-ns 'go.arbace.box.purego) (go/file "dlfcn.go" :build ["//go:build (darwin || freebsd || linux || netbsd) && !android && !faketime"] :imports [


    ^{:line 9} [unsafe "unsafe"]])


;; Unix Specification for dlfcn.h: https://pubs.opengroup.org/onlinepubs/7908799/xsh/dlfcn.h.html

(go/var
  ^{:line 15} [^{:tag (func [^string path ^int mode] [uintptr])} fnDlopen]
  ^{:line 16} [^{:tag (func [^uintptr handle ^string name] [uintptr])} fnDlsym]
  ^{:line 17} [^{:tag (func [] [string])} fnDlerror]
  ^{:line 18} [^{:tag (func [^uintptr handle] [bool])} fnDlclose])


^{:go/end 26} (go/func init []
  (RegisterFunc (addr fnDlopen) dlopenABI0)
  (RegisterFunc (addr fnDlsym) dlsymABI0)
  (RegisterFunc (addr fnDlerror) dlerrorABI0)
  (RegisterFunc (addr fnDlclose) dlcloseABI0))














^{:go/end 46} (go/func Dlopen "Dlopen examines the dynamic library or bundle file specified by path. If the file is compatible\nwith the current process and has not already been loaded into the\ncurrent process, it is loaded and linked. After being linked, if it contains\nany initializer functions, they are called, before Dlopen\nreturns. It returns a handle that can be used with Dlsym and Dlclose.\nA second call to Dlopen with the same path will return the same handle, but the internal\nreference count for the handle will be incremented. Therefore, all\nDlopen calls should be balanced with a Dlclose call.\n\nThis function is not available on Windows.\nUse [golang.org/x/sys/windows.LoadLibrary], [golang.org/x/sys/windows.LoadLibraryEx],\n[golang.org/x/sys/windows.NewLazyDLL], or [golang.org/x/sys/windows.NewLazySystemDLL] for Windows instead.\n" [^string path ^int mode] :results [uintptr error]
  (let [u (fnDlopen path mode)]
    (when (== u 0)
      (return 0 (lit Dlerror (fnDlerror))))

    (return u nil)))









^{:go/end 61} (go/func Dlsym "Dlsym takes a \"handle\" of a dynamic library returned by Dlopen and the symbol name.\nIt returns the address where that symbol is loaded into memory. If the symbol is not found,\nin the specified library or any of the libraries that were automatically loaded by Dlopen\nwhen that library was loaded, Dlsym returns zero.\n\nThis function is not available on Windows.\nUse [golang.org/x/sys/windows.GetProcAddress] for Windows instead.\n" [^uintptr handle ^string name] :results [uintptr error]
  (let [u (fnDlsym handle name)]
    (when (== u 0)
      (return 0 (lit Dlerror (fnDlerror))))

    (return u nil)))








^{:go/breaks [[5 73]] :go/end 74} (go/func Dlclose "Dlclose decrements the reference count on the dynamic library handle.\nIf the reference count drops to zero and no other loaded libraries\nuse symbols in it, then the dynamic library is unloaded.\n\nThis function is not available on Windows.\nUse [golang.org/x/sys/windows.FreeLibrary] for Windows instead.\n" ^error [^uintptr handle]
  (when (fnDlclose handle)
    (return (lit Dlerror (fnDlerror))))

  nil)


^{:go/end 78} (go/func loadSymbol [^uintptr handle ^string name] :results [uintptr error]
  (Dlsym handle name))


;; these functions exist in dlfcn_stubs.s and are calling C functions linked to in dlfcn_GOOS.go
;; the indirection is necessary because a function is actually a pointer to the pointer to the code.
;; sadly, I do not know of anyway to remove the assembly stubs entirely because //go:linkname doesn't
;; appear to work if you link directly to the C function on darwin arm64.


(go/var ^{:tag uint8 :go/linkname "dlopen dlopen"} dlopen)
(go/var dlopenABI0 (conv uintptr (conv unsafe/Pointer (addr dlopen))))


(go/var ^{:tag uint8 :go/linkname "dlsym dlsym"} dlsym)
(go/var dlsymABI0 (conv uintptr (conv unsafe/Pointer (addr dlsym))))


(go/var ^{:tag uint8 :go/linkname "dlclose dlclose"} dlclose)
(go/var dlcloseABI0 (conv uintptr (conv unsafe/Pointer (addr dlclose))))


(go/var ^{:tag uint8 :go/linkname "dlerror dlerror"} dlerror)
(go/var dlerrorABI0 (conv uintptr (conv unsafe/Pointer (addr dlerror))))

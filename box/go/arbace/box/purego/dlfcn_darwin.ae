(in-ns 'go.arbace.box.purego) (go/file "dlfcn_darwin.go" :imports [])

;; Source for constants: https://opensource.apple.com/source/dyld/dyld-360.14/include/dlfcn.h.auto.html

(go/const
  ^{:line 9} [^{:val 18446744073709551614N} RTLD_DEFAULT (- (<< 1 64) 2)] ; Pseudo-handle for dlsym so search for any loaded symbol
  ^{:line 10} [^{:val 1} RTLD_LAZY 0x1] ; Relocations are performed at an implementation-dependent time.
  ^{:line 11} [^{:val 2} RTLD_NOW 0x2] ; Relocations are performed when the object is loaded.
  ^{:line 12} [^{:val 4} RTLD_LOCAL 0x4] ; All symbols are not made available for relocation processing by other modules.
  ^{:line 13} [^{:val 8} RTLD_GLOBAL 0x8]) ; All symbols are available for relocation processing of other modules.


(go/directive "//go:cgo_import_dynamic purego_dlopen dlopen \"/usr/lib/libSystem.B.dylib\"")
(go/directive "//go:cgo_import_dynamic purego_dlsym dlsym \"/usr/lib/libSystem.B.dylib\"")
(go/directive "//go:cgo_import_dynamic purego_dlerror dlerror \"/usr/lib/libSystem.B.dylib\"")
(go/directive "//go:cgo_import_dynamic purego_dlclose dlclose \"/usr/lib/libSystem.B.dylib\"")
(go/directive "//go:cgo_import_dynamic purego_error __error \"/usr/lib/libSystem.B.dylib\"")

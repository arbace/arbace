;; purego v0.11.1, vendored (box/README.md; doc/go/BOX-NOTES.md, S4, BX62): the package
;; arbace/box/purego/internal/fakecgo, its files for darwin/arm64.
(ns go.arbace.box.purego.internal.fakecgo
  (:require [arbace.go :as go]))

(go/package fakecgo
  :path "arbace/box/purego/internal/fakecgo"
  :files ["callbacks.go" "doc.go" "fakecgo.go" "go_darwin.go" "go_libinit.go" "go_setenv.go" "go_util.go" "iscgo.go" "libcgo.go" "libcgo_darwin.go" "setenv.go" "threadentry_noasm.go" "zsymbols.go" "zsymbols_darwin.go"]
  :other-files ["abi_arm64.h" "abi_ppc64x.h" "asm_arm64.s" "trampolines_arm64.s" "ztrampolines_darwin.s" "ztrampolines_stubs.s"]
  :positions :lines)

(load "fakecgo/callbacks")
(load "fakecgo/doc")
(load "fakecgo/fakecgo")
(load "fakecgo/go_darwin")
(load "fakecgo/go_libinit")
(load "fakecgo/go_setenv")
(load "fakecgo/go_util")
(load "fakecgo/iscgo")
(load "fakecgo/libcgo")
(load "fakecgo/libcgo_darwin")
(load "fakecgo/setenv")
(load "fakecgo/threadentry_noasm")
(load "fakecgo/zsymbols")
(load "fakecgo/zsymbols_darwin")

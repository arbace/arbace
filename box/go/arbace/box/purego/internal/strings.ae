;; purego v0.11.1, vendored (box/README.md; doc/go/BOX-NOTES.md, S4, BX62): the package
;; arbace/box/purego/internal/strings, its files for darwin/arm64.
(ns go.arbace.box.purego.internal.strings
  (:require [arbace.go :as go]))

(go/package strings
  :path "arbace/box/purego/internal/strings"
  :files ["strings.go"]
  :positions :lines)

(load "strings/strings")

(in-ns 'go.arbace.box.purego.internal.strings) (go/file "strings.go" :imports [


    ^{:line 7} [unsafe "unsafe"]])



^{:go/end 13} (go/func hasSuffix "hasSuffix tests whether the string s ends with suffix.\n" ^bool [^string s ^string suffix]
  (and (>= (len s) (len suffix)) (== (subslice s (- (len s) (len suffix))) suffix)))



^{:go/end 23} (go/func CString "CString converts a go string to *byte that can be passed to C code.\n" ^{:tag (* byte)} [^string name]
  (when (hasSuffix name "\u0000")
    (return (addr (aget @(conv (* (slice byte)) (conv unsafe/Pointer (addr name))) 0))))

  (let [b (make (slice byte) (+ (len name) 1))]
    (copy b name)
    (addr (aget b 0))))



^{:go/end 40} (go/func GoString "GoString copies a null-terminated char* to a Go string.\n" ^string [^uintptr c]
  ;; We take the address and then dereference it to trick go vet from creating a possible misuse of unsafe.Pointer
  (let [ptr @(conv (* unsafe/Pointer) (conv unsafe/Pointer (addr c)))]
    (when (== ptr nil)
      (return ""))

    (let [^int length (zero int)]
      (while true
        (when (== @(conv (* byte) (unsafe/Add ptr (conv uintptr length))) \u0000)
          (break))

        (inc! length))

      (conv string (unsafe/Slice (conv (* byte) ptr) length)))))

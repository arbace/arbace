(in-ns 'go.arbace.box.purego.internal.fakecgo) (go/file "fakecgo.go" :build ["//go:build !cgo && (darwin || freebsd || linux || netbsd)"] :imports [

    ^{:line 8} [_ "unsafe"]])


(go/func ^:extern setg_trampoline "setg_trampoline calls setg with the G provided\n" [^uintptr setg ^uintptr G])


(go/func ^:extern call5 "call5 takes fn the C function and 5 arguments and calls the function with those arguments\n" ^uintptr [^uintptr fn ^uintptr a1 ^uintptr a2 ^uintptr a3 ^uintptr a4 ^uintptr a5])

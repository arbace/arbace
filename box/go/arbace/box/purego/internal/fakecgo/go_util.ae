(in-ns 'go.arbace.box.purego.internal.fakecgo) (go/file "go_util.go" :build ["//go:build !cgo && (darwin || freebsd || linux || netbsd)"] :imports [

    ^{:line 8} [unsafe "unsafe"]])

;; _cgo_thread_start is split into three parts in cgo since only one part is system dependent (keep it here for easier handling)









^{:go/end 38} (go/func ^:go/norace ^:go/nosplit x_cgo_thread_start "_cgo_thread_start(ThreadStart *arg) (runtime/cgo/gcc_util.c)\nThis get's called instead of the go code for creating new threads\n-> pthread_* stuff is used, so threads are setup correctly for C\nIf this is missing, TLS is only setup correctly on thread 1!\nThis function should be go:systemstack instead of go:nosplit (but that requires runtime)\n" [^{:tag (* ThreadStart)} arg]
  (let [^{:tag (* ThreadStart)} ts (zero (* ThreadStart))]
    ;; Make our own copy that can persist after we return.
    ;;	_cgo_tsan_acquire();
    (set! ts (conv (* ThreadStart) (malloc (unsafe/Sizeof @ts))))
    ;;	_cgo_tsan_release();
    (when (== ts nil)
      (println "fakecgo: out of memory in thread_start")
      (abort))

    ;; *ts = *arg would cause a writebarrier so copy using slices
    (let [^:const ^{:val 8} ptrSize (unsafe/Sizeof (conv uintptr 0))
        ^{:line 32} s1 (unsafe/Slice (conv (* uintptr) (conv unsafe/Pointer ts)) (/ (unsafe/Sizeof @ts) ptrSize))
        ^{:line 33} s2 (unsafe/Slice (conv (* uintptr) (conv unsafe/Pointer arg)) (/ (unsafe/Sizeof @arg) ptrSize))]
      (range [i s2]
        (aset s1 i (aget s2 i)))

      (_cgo_sys_thread_start ts)))) ; OS-dependent half

(in-ns 'go.arbace.box.purego.internal.fakecgo) (go/file "go_darwin.go" :build ["//go:build !cgo"] :imports [

    ^{:line 9} [unsafe "unsafe"]])



^{:go/end 38} (go/func ^:go/norace ^:go/nosplit _cgo_sys_thread_start [^{:tag (* ThreadStart)} ts]
  (let [^pthread_attr_t attr (zero pthread_attr_t)
      (values ^sigset_t ign ^sigset_t oset) (zero sigset_t)
      ^{:line 16 :tag pthread_t} p (zero pthread_t)
      ^{:line 17 :tag size_t} size (zero size_t)
      ^{:line 18 :tag int} err (zero int)]

    (sigfillset (addr ign))
    (pthread_sigmask SIG_SETMASK (addr ign) (addr oset))

    (set! size (pthread_get_stacksize_np (pthread_self)))
    (pthread_attr_init (addr attr))
    (pthread_attr_setstacksize (addr attr) size)
    ;; Leave stacklo=0 and set stackhi=size; mstart will do the rest.
    (set! (.-stackhi (.-g ts)) (conv uintptr size))

    (set! err (_cgo_try_pthread_create (addr p) (addr attr) (conv unsafe/Pointer threadentry_trampolineABI0) ts))

    (pthread_sigmask SIG_SETMASK (addr oset) nil)

    (when (!= err 0)
      (print "fakecgo: pthread_create failed: ")
      (println err)
      (abort))))






(go/var ^{:tag byte :doc "threadentry_trampolineABI0 maps the C ABI to Go ABI then calls the Go function\n" :go/linkname "x_threadentry_trampoline threadentry_trampoline"} x_threadentry_trampoline)
(go/var threadentry_trampolineABI0 (addr x_threadentry_trampoline))



^{:go/end 61} (go/func ^:go/norace ^:go/nosplit threadentry ^unsafe/Pointer [^unsafe/Pointer v]
  ^{:go/breaks [[5 60]]} (let [ts @(conv (* ThreadStart) v)]
    (free v)

    ;; TODO: support ios
    ;;#if TARGET_OS_IPHONE
    ;;	darwin_arm_init_thread_exception_port();
    ;;#endif
    (setg_trampoline setg_func (conv uintptr (conv unsafe/Pointer (.-g ts))))

    (callThreadEntryFn (.-fn ts))

    nil))



(go/var ^{:tag uintptr :doc "here we will store a pointer to the provided setg func\n"} setg_func)








^{:go/end 86} (go/func ^:go/norace ^:go/nosplit x_cgo_init "x_cgo_init(G *g, void (*setg)(void*)) (runtime/cgo/gcc_linux_amd64.c)\nThis get's called during startup, adjusts stacklo, and provides a pointer to setg_gcc for us\nAdditionally, if we set _cgo_init to non-null, go won't do it's own TLS setup\nThis function can't be go:systemstack since go is not in a state where the systemcheck would work.\n" [^{:tag (* G)} g ^uintptr setg]
  (let [^size_t size (zero size_t)]

    (set! setg_func setg)
    (set! size (pthread_get_stacksize_np (pthread_self)))
    (set! (.-stacklo g) (conv uintptr (unsafe/Add (conv unsafe/Pointer (addr size)) (+ (- size) 4096))))))


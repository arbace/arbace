(in-ns 'go.arbace.box.purego.internal.fakecgo) (go/file "setenv.go" :build ["//go:build !cgo && (darwin || freebsd || linux || netbsd)"] :imports [

    ^{:line 9} [_ "unsafe"]]) ; for go:linkname


(go/directive "//go:linkname _cgo_setenv runtime._cgo_setenv")
(go/var ^{:tag byte :go/linkname "x_cgo_setenv_trampoline x_cgo_setenv_trampoline"} x_cgo_setenv_trampoline)
(go/var _cgo_setenv (addr x_cgo_setenv_trampoline))


(go/directive "//go:linkname _cgo_unsetenv runtime._cgo_unsetenv")
(go/var ^{:tag byte :go/linkname "x_cgo_unsetenv_trampoline x_cgo_unsetenv_trampoline"} x_cgo_unsetenv_trampoline)
(go/var _cgo_unsetenv (addr x_cgo_unsetenv_trampoline))

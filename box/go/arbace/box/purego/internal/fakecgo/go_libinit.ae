(in-ns 'go.arbace.box.purego.internal.fakecgo) (go/file "go_libinit.go" :build ["//go:build !cgo && (darwin || freebsd || linux || netbsd)"] :imports [


    ^{:line 9} [syscall "syscall"]
    ^{:line 10} [unsafe "unsafe"]])


(go/var
  ^{:line 14} [^pthread_key_t pthread_g]

  ^{:line 16} [runtime_init_cond PTHREAD_COND_INITIALIZER]
  ^{:line 17} [runtime_init_mu PTHREAD_MUTEX_INITIALIZER]
  ^{:line 18} [^int runtime_init_done])




^{:go/end 28} (go/func ^:go/norace ^:go/nosplit x_cgo_notify_runtime_init_done []
  (pthread_mutex_lock (addr runtime_init_mu))
  (set! runtime_init_done 1)
  (pthread_cond_broadcast (addr runtime_init_cond))
  (pthread_mutex_unlock (addr runtime_init_mu)))






^{:go/end 40} (go/func ^:go/norace x_cgo_bindm "Store the g into a thread-specific value associated with the pthread key pthread_g.\nAnd pthread_key_destructor will dropm when the thread is exiting.\n" [^unsafe/Pointer g]
  ;; We assume this will always succeed, otherwise, there might be extra M leaking,
  ;; when a C thread exits after a cgo call.
  ;; We only invoke this function once per thread in runtime.needAndBindM,
  ;; and the next calls just reuse the bound m.
  (pthread_setspecific pthread_g g))







^{:go/end 72} (go/func ^:go/norace ^:go/nosplit _cgo_try_pthread_create "_cgo_try_pthread_create retries pthread_create if it fails with\nEAGAIN.\n" ^int [^{:tag (* pthread_t)} thread ^{:tag (* pthread_attr_t)} attr ^unsafe/Pointer pfn ^{:tag (* ThreadStart)} arg]
  (let [^syscall/Timespec ts (zero syscall/Timespec)
      ;; tries needs to be the same type as syscall.Timespec.Nsec
      ;; but the fields are int32 on 32bit and int64 on 64bit.
      ;; tries is assigned to syscall.Timespec.Nsec in order to match its type.
      ^{:line 52} tries (.-Nsec ts)
      ^{:line 53 :tag int} err (zero int)]

    ^:assign (range [tries 20]
      ;; inlined this call because it ran out of stack when inlining was disabled
      (set! err (conv int (call5 pthread_createABI0 (conv uintptr (conv unsafe/Pointer thread)) (conv uintptr (conv unsafe/Pointer attr)) (conv uintptr pfn) (conv uintptr (conv unsafe/Pointer arg)) 0)))
      (when (== err 0)
        ;; inlined this call because it ran out of stack when inlining was disabled
        (call5 pthread_detachABI0 (conv uintptr @thread) 0 0 0 0)
        (return 0))

      (when (!= err (conv int syscall/EAGAIN))
        (return err))

      (set! (.-Sec ts) 0)
      (set! (.-Nsec ts) (* (+ tries 1) 1000 1000)) ; Milliseconds.
      ;; inlined this call because it ran out of stack when inlining was disabled
      (call5 nanosleepABI0 (conv uintptr (conv unsafe/Pointer (addr ts))) 0 0 0 0))

    (conv int syscall/EAGAIN)))

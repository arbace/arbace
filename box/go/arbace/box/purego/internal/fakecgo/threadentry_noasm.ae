(in-ns 'go.arbace.box.purego.internal.fakecgo) (go/file "threadentry_noasm.go" :build ["//go:build !cgo && !amd64 && (darwin || freebsd || linux || netbsd)"] :imports [

    ^{:line 8} [unsafe "unsafe"]])









^{:go/end 24} (go/func ^:go/norace ^:go/nosplit callThreadEntryFn "callThreadEntryFn calls fn (runtime.mstart). On architectures without the\namd64 frame-pointer epilogue issue this is a plain indirect call. It must be\nnosplit and norace like the threadentry callers so it neither inserts a\nmorestack preamble nor runs race instrumentation during the fragile\nthread-bootstrap window.\n" [^uintptr fn]
  ;; fn is the code pointer. Build a func value whose first word is fn by
  ;; pointing the closure at &fn, then call it (same trick fakecgo has always
  ;; used to call a raw PC from Go).
  (let [fnPtr (conv uintptr (conv unsafe/Pointer (addr fn)))]
    (@(conv (* (func [])) (conv unsafe/Pointer (addr fnPtr))))))

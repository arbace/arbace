(in-ns 'go.arbace.box.purego.internal.fakecgo) (go/file "go_setenv.go" :build ["//go:build !cgo && (darwin || freebsd || linux || netbsd)"] :imports [])



^{:go/end 12} (go/func ^:go/norace ^:go/nosplit x_cgo_setenv [^{:tag (* (array 2 (* byte)))} arg]
  (setenv (aget arg 0) (aget arg 1) 1))




^{:go/end 18} (go/func ^:go/norace ^:go/nosplit x_cgo_unsetenv [^{:tag (* (array 1 (* byte)))} arg]
  (unsetenv (aget arg 0)))

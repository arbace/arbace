(in-ns 'go.arbace.box.purego) (go/file "syscall_notstackargs.go" :build ["//go:build !(ppc64le || s390x)"] :imports [

    ^{:line 8} [unsafe "unsafe"]])










(go/type callbackArgs "callbackArgs is the argument block passed from the assembly trampoline\nto callbackWrap when C code calls a Go callback registered with NewCallback.\nThe assembly fills in the fields before calling callbackWrap, which uses\nthem to determine which Go function to invoke and where to read its\narguments from, and writes the return value back into result.\n\ncallbackArgs is only used on Unix. On Windows, callbacks are handled by\nthe runtime's own callback mechanism, so this type is compiled but unused,\nserving only as a stub to satisfy cross-platform compilation.\n" (struct
    ^{:line 20 :tag uintptr} index









    ^{:line 30 :tag unsafe/Pointer :doc "args points to the argument block.\n\nThe structure of the arguments goes\nfloat registers followed by the\ninteger registers followed by the stack.\n\nThis variable is treated as a contiguous\nblock of memory containing all of the arguments\nfor this callback.\n"} args

    ^{:line 32 :tag (array 4 uintptr) :doc "Below are out-args from callbackWrap\n"} result))


^{:go/breaks [3] :go/end 37} (go/method stackFrame ^unsafe/Pointer [^{:tag (* callbackArgs)} c]
  nil)


^{:go/breaks [3] :go/end 41} (go/method intFrame ^unsafe/Pointer [^{:tag (* callbackArgs)} c]
  nil)


^{:go/end 48} (go/method setInt64Result [^{:tag (* callbackArgs)} c ^int64 result]
  (aset (.-result c) 0 (conv uintptr result))
  (when (== (unsafe/Sizeof (conv uintptr 0)) 4)
    (aset (.-result c) 1 (conv uintptr (>> result 32)))))



^{:go/end 55} (go/method setUint64Result [^{:tag (* callbackArgs)} c ^uint64 result]
  (aset (.-result c) 0 (conv uintptr result))
  (when (== (unsafe/Sizeof (conv uintptr 0)) 4)
    (aset (.-result c) 1 (conv uintptr (>> result 32)))))

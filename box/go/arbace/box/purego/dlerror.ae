(in-ns 'go.arbace.box.purego) (go/file "dlerror.go" :build ["//go:build darwin || freebsd || linux || netbsd"] :imports [])




(go/type Dlerror "Dlerror represents an error value returned from Dlopen, Dlsym, or Dlclose.\n\nThis type is not available on Windows as there is no counterpart to it on Windows.\n" (struct
    ^{:line 12 :tag string} s))


^{:go/end 17} (go/method Error ^string [^Dlerror e]
  (.-s e))

(in-ns 'javax.management)

(import '(com.sun.jmx.defaults JmxProperties)
        '(com.sun.jmx.mbeanserver DescriptorCache
                                  Introspector
                                  MBeanSupport
                                  MXBeanSupport
                                  StandardMBeanSupport
                                  Util)
        '(java.util HashMap Map WeakHashMap)
        '(javax.management.openmbean OpenMBeanAttributeInfo
                                     OpenMBeanAttributeInfoSupport
                                     OpenMBeanConstructorInfo
                                     OpenMBeanConstructorInfoSupport
                                     OpenMBeanOperationInfo
                                     OpenMBeanOperationInfoSupport
                                     OpenMBeanParameterInfo
                                     OpenMBeanParameterInfoSupport)
        '(jdk.internal.jrt SystemLoggers$Logger$Level))

(defclass ^:public StandardMBean
  :implements [DynamicMBean MBeanRegistration]

  (field ^:private ^:static ^:final ^DescriptorCache descriptors
    (DescriptorCache/getInstance JMX/proof))

  (field ^:private ^:volatile ^{:tag (MBeanSupport ?)} mbean)

  (field ^:private ^:volatile ^MBeanInfo cachedMBeanInfo)

  (method ^:private construct :type-params [T] :throws [NotCompliantMBeanException] ^void [this
                                                                                           ^:mutable ^T implementation
                                                                                           ^:mutable ^{:tag (Class T)} mbeanInterface
                                                                                           ^boolean nullImplementationAllowed
                                                                                           ^boolean isMXBean]
    (when (nil? implementation)
      (if nullImplementationAllowed
          (set! implementation (Util/cast this))
          (throw (IllegalArgumentException. "implementation is null"))))
    (if isMXBean
        (do
          (when (nil? mbeanInterface)
            (set! mbeanInterface
                  (cast Class
                        (Util/cast (Introspector/getMXBeanInterface (.getClass implementation))))))
          (set! (.-mbean this) (MXBeanSupport. implementation mbeanInterface)))
        (do
          (when (nil? mbeanInterface)
            (set! mbeanInterface
                  (cast Class
                        (Util/cast (Introspector/getStandardMBeanInterface
                                     (.getClass implementation))))))
          (set! (.-mbean this) (StandardMBeanSupport. implementation mbeanInterface)))))

  (constructor :type-params [T] :throws [NotCompliantMBeanException] ^:public [this
                                                                               ^T implementation
                                                                               ^{:tag (Class T)} mbeanInterface]
    (.construct this implementation mbeanInterface false false))

  (constructor :throws [NotCompliantMBeanException] ^:protected [this
                                                                 ^{:tag (Class ?)} mbeanInterface]
    (.construct this nil mbeanInterface true false))

  (constructor :type-params [T] ^:public [this ^T implementation ^{:tag (Class T)} mbeanInterface
                                          ^boolean isMXBean]
    (try
      (.construct this implementation mbeanInterface false isMXBean)
      (catch NotCompliantMBeanException e (throw (IllegalArgumentException. e)))))

  (constructor ^:protected [this ^{:tag (Class ?)} mbeanInterface ^boolean isMXBean]
    (try
      (.construct this nil mbeanInterface true isMXBean)
      (catch NotCompliantMBeanException e (throw (IllegalArgumentException. e)))))

  (method ^:public setImplementation :throws [NotCompliantMBeanException] ^void [this implementation]
    (when (nil? implementation) (throw (IllegalArgumentException. "implementation is null")))
    (if (.isMXBean this)
        (set! (.-mbean this)
              (MXBeanSupport. implementation (cast Class (Util/cast (.getMBeanInterface this)))))
        (set! (.-mbean this)
              (StandardMBeanSupport. implementation
                                     (cast Class (Util/cast (.getMBeanInterface this)))))))

  (method ^:public getImplementation [this] (.getResource mbean))

  (method ^:public ^:final getMBeanInterface ^{:tag (Class ?)} [this]
    (.getMBeanInterface mbean))

  (method ^:public getImplementationClass ^{:tag (Class ?)} [this]
    (.getClass (.getResource mbean)))

  (method ^:public getAttribute :throws [AttributeNotFoundException
                                         MBeanException
                                         ReflectionException] [this ^String attribute]
    (.getAttribute mbean attribute))

  (method ^:public setAttribute :throws [AttributeNotFoundException
                                         InvalidAttributeValueException
                                         MBeanException
                                         ReflectionException] ^void [this ^Attribute attribute]
    (.setAttribute mbean attribute))

  (method ^:public getAttributes ^AttributeList [this ^String/1 attributes]
    (.getAttributes mbean attributes))

  (method ^:public setAttributes ^AttributeList [this ^AttributeList attributes]
    (.setAttributes mbean attributes))

  (method ^:public invoke :throws [MBeanException ReflectionException] [this ^String actionName
                                                                        ^Object/1 params
                                                                        ^String/1 signature]
    (.invoke mbean actionName params signature))

  (method ^:public getMBeanInfo ^MBeanInfo [this]
    (try
      (let [cached (.getCachedMBeanInfo this)] (when (some? cached) (return cached)))
      (catch RuntimeException x
        (when (.isLoggable JmxProperties/MISC_LOGGER SystemLoggers$Logger$Level/DEBUG)
          (.log JmxProperties/MISC_LOGGER
                SystemLoggers$Logger$Level/DEBUG
                "Failed to get cached MBeanInfo"
                x))))
    (when (.isLoggable JmxProperties/MISC_LOGGER SystemLoggers$Logger$Level/TRACE)
      (.log JmxProperties/MISC_LOGGER
            SystemLoggers$Logger$Level/TRACE
            (java-str "Building MBeanInfo for " (.getName (.getImplementationClass this)))))
    (let [^{:tag (MBeanSupport ?)} msupport mbean
          bi (.getMBeanInfo msupport)
          impl (.getResource msupport)
          immutableInfo (StandardMBean/immutableInfo (.getClass this))
          cname (.getClassName this bi)
          text (.getDescription this bi)
          ctors (.getConstructors this bi impl)
          attrs (.getAttributes this bi)
          ops (.getOperations this bi)
          ntfs (.getNotifications this bi)
          desc (.getDescriptor this bi immutableInfo)
          nmbi (MBeanInfo. cname text attrs ctors ops ntfs desc)]
      (try
        (.cacheMBeanInfo this nmbi)
        (catch RuntimeException x
          (when (.isLoggable JmxProperties/MISC_LOGGER SystemLoggers$Logger$Level/DEBUG)
            (.log JmxProperties/MISC_LOGGER
                  SystemLoggers$Logger$Level/DEBUG
                  "Failed to cache MBeanInfo"
                  x))))
      nmbi))

  (method ^:protected getClassName ^String [this ^MBeanInfo info]
    (if (nil? info) (.getName (.getImplementationClass this)) (.getClassName info)))

  (method ^:protected getDescription ^String [this ^MBeanInfo info]
    (when (some? info) (.getDescription info)))

  (method ^:protected getDescription ^String [this ^MBeanFeatureInfo info]
    (when (some? info) (.getDescription info)))

  (method ^:protected getDescription ^String [this ^MBeanAttributeInfo info]
    (.getDescription this ^MBeanFeatureInfo info))

  (method ^:protected getDescription ^String [this ^MBeanConstructorInfo info]
    (.getDescription this ^MBeanFeatureInfo info))

  (method ^:protected getDescription ^String [this ^MBeanConstructorInfo ctor
                                              ^MBeanParameterInfo param ^int sequence]
    (when (some? param) (.getDescription param)))

  (method ^:protected getParameterName ^String [this ^MBeanConstructorInfo ctor
                                                ^MBeanParameterInfo param ^int sequence]
    (when (some? param) (.getName param)))

  (method ^:protected getDescription ^String [this ^MBeanOperationInfo info]
    (.getDescription this ^MBeanFeatureInfo info))

  (method ^:protected getImpact ^int [this ^MBeanOperationInfo info]
    (if (nil? info) MBeanOperationInfo/UNKNOWN (.getImpact info)))

  (method ^:protected getParameterName ^String [this ^MBeanOperationInfo op
                                                ^MBeanParameterInfo param ^int sequence]
    (when (some? param) (.getName param)))

  (method ^:protected getDescription ^String [this ^MBeanOperationInfo op ^MBeanParameterInfo param
                                              ^int sequence]
    (when (some? param) (.getDescription param)))

  (method ^:protected getConstructors ^MBeanConstructorInfo/1 [this ^MBeanConstructorInfo/1 ctors
                                                               impl]
    (when (some? ctors) (when-not (and (some? impl) (not (identical? impl this))) ctors)))

  (method getNotifications ^MBeanNotificationInfo/1 [this ^MBeanInfo info]
    nil)

  (method getDescriptor ^Descriptor [this ^MBeanInfo info ^boolean immutableInfo]
    (let [^:mutable ^ImmutableDescriptor desc nil]
      (if (or (or (nil? info) (nil? (.getDescriptor info)))
              (== (alength (.getFieldNames (.getDescriptor info))) 0))
          (let [interfaceClassNameS (java-str "interfaceClassName="
                                              (.getName (.getMBeanInterface this)))
                immutableInfoS (java-str "immutableInfo=" immutableInfo)]
            (set! desc (ImmutableDescriptor. (new String/1 [interfaceClassNameS immutableInfoS])))
            (set! desc (.get descriptors desc)))
          (let [d (.getDescriptor info)
                ^{:tag (Map String Object)} fields (HashMap.)]
            (for-each [^String fieldName (.getFieldNames d)]
              (if (.equals fieldName "immutableInfo")
                  (.put fields fieldName (Boolean/toString immutableInfo))
                  (.put fields fieldName (.getFieldValue d fieldName))))
            (set! desc (ImmutableDescriptor. fields))))
      desc))

  (method ^:protected getCachedMBeanInfo ^MBeanInfo [this]
    cachedMBeanInfo)

  (method ^:protected cacheMBeanInfo ^void [this ^MBeanInfo info]
    (set! cachedMBeanInfo info))

  (method ^:private isMXBean ^boolean [this] (.isMXBean mbean))

  (method ^:private ^:static identicalArrays :type-params [T] ^boolean [^T/1 a ^T/1 b]
    (cond
      (identical? a b) true
      (or (or (nil? a) (nil? b)) (not (== (alength a) (alength b)))) false
      :else
        (do
          (loop [^int i 0]
            (if (< i (alength a))
                (if (not (identical? (aget a i) (aget b i)))
                    (return false)
                    (recur (unchecked-inc-int i)))
                nil))
          true)))

  (method ^:private ^:static equal :type-params [T] ^boolean [^T a ^T b]
    (cond (identical? a b) true (or (nil? a) (nil? b)) false :else (.equals a b)))

  (method ^:private ^:static customize ^MBeanParameterInfo [^MBeanParameterInfo pi ^String name
                                                            ^String description]
    (cond
      (and (StandardMBean/equal name (.getName pi))
           (StandardMBean/equal description (.getDescription pi)))
        pi
      (instance? OpenMBeanParameterInfo pi)
        (let [opi (cast OpenMBeanParameterInfo pi)]
          (OpenMBeanParameterInfoSupport. name description (.getOpenType opi) (.getDescriptor pi)))
      :else (MBeanParameterInfo. name (.getType pi) description (.getDescriptor pi))))

  (method ^:private ^:static customize ^MBeanConstructorInfo [^MBeanConstructorInfo ci
                                                              ^String description
                                                              ^MBeanParameterInfo/1 signature]
    (cond
      (and (StandardMBean/equal description (.getDescription ci))
           (StandardMBean/identicalArrays signature (.getSignature ci)))
        ci
      (instance? OpenMBeanConstructorInfo ci)
        (let [oparams (StandardMBean/paramsToOpenParams signature)]
          (OpenMBeanConstructorInfoSupport. (.getName ci) description oparams (.getDescriptor ci)))
      :else (MBeanConstructorInfo. (.getName ci) description signature (.getDescriptor ci))))

  (method ^:private ^:static customize ^MBeanOperationInfo [^MBeanOperationInfo oi
                                                            ^String description
                                                            ^MBeanParameterInfo/1 signature
                                                            ^int impact]
    (cond
      (and (and (StandardMBean/equal description (.getDescription oi))
                (StandardMBean/identicalArrays signature (.getSignature oi)))
           (== impact (.getImpact oi)))
        oi
      (instance? OpenMBeanOperationInfo oi)
        (let [ooi (cast OpenMBeanOperationInfo oi)
              oparams (StandardMBean/paramsToOpenParams signature)]
          (OpenMBeanOperationInfoSupport. (.getName oi)
                                          description
                                          oparams
                                          (.getReturnOpenType ooi)
                                          impact
                                          (.getDescriptor oi)))
      :else
        (MBeanOperationInfo. (.getName oi)
                             description
                             signature
                             (.getReturnType oi)
                             impact
                             (.getDescriptor oi))))

  (method ^:private ^:static customize ^MBeanAttributeInfo [^MBeanAttributeInfo ai
                                                            ^String description]
    (cond
      (StandardMBean/equal description (.getDescription ai)) ai
      (instance? OpenMBeanAttributeInfo ai)
        (let [oai (cast OpenMBeanAttributeInfo ai)]
          (OpenMBeanAttributeInfoSupport. (.getName ai)
                                          description
                                          (.getOpenType oai)
                                          (.isReadable ai)
                                          (.isWritable ai)
                                          (.isIs ai)
                                          (.getDescriptor ai)))
      :else
        (MBeanAttributeInfo. (.getName ai)
                             (.getType ai)
                             description
                             (.isReadable ai)
                             (.isWritable ai)
                             (.isIs ai)
                             (.getDescriptor ai))))

  (method ^:private ^:static paramsToOpenParams ^OpenMBeanParameterInfo/1 [^MBeanParameterInfo/1 params]
    (if (instance? OpenMBeanParameterInfo/1 params)
        (cast OpenMBeanParameterInfo/1 params)
        (let [^OpenMBeanParameterInfo/1 oparams (new
                                                  OpenMBeanParameterInfoSupport/1
                                                  (alength params))]
          (System/arraycopy params 0 oparams 0 (alength params))
          oparams)))

  (method ^:private getConstructors ^MBeanConstructorInfo/1 [this ^MBeanInfo info impl]
    (let [ctors (.getConstructors this (.getConstructors info) impl)]
      (when (some? ctors)
        (let [ctorlen (alength ctors)
              nctors (new MBeanConstructorInfo/1 ctorlen)]
          (loop [^int i 0]
            (when (< i ctorlen)
              (let [c (aget ctors i)
                    params (.getSignature c)
                    ^:mutable ^MBeanParameterInfo/1 nps nil]
                (if (some? params)
                    (let [plen (alength params)]
                      (set! nps (new MBeanParameterInfo/1 plen))
                      (loop [^int ii 0]
                        (when (< ii plen)
                          (let [p (aget params ii)]
                            (aset nps
                                  ii
                                  (StandardMBean/customize
                                    p
                                    (.getParameterName this c p ii)
                                    (.getDescription this c p ii)))
                            (recur (unchecked-inc-int ii))))))
                    (set! nps nil))
                (aset nctors i (StandardMBean/customize c (.getDescription this c) nps))
                (recur (unchecked-inc-int i)))))
          nctors))))

  (method ^:private getOperations ^MBeanOperationInfo/1 [this ^MBeanInfo info]
    (let [ops (.getOperations info)]
      (when (some? ops)
        (let [oplen (alength ops)
              nops (new MBeanOperationInfo/1 oplen)]
          (loop [^int i 0]
            (when (< i oplen)
              (let [o (aget ops i)
                    params (.getSignature o)
                    ^:mutable ^MBeanParameterInfo/1 nps nil]
                (if (some? params)
                    (let [plen (alength params)]
                      (set! nps (new MBeanParameterInfo/1 plen))
                      (loop [^int ii 0]
                        (when (< ii plen)
                          (let [p (aget params ii)]
                            (aset nps
                                  ii
                                  (StandardMBean/customize
                                    p
                                    (.getParameterName this o p ii)
                                    (.getDescription this o p ii)))
                            (recur (unchecked-inc-int ii))))))
                    (set! nps nil))
                (aset nops
                      i
                      (StandardMBean/customize o (.getDescription this o) nps (.getImpact this o)))
                (recur (unchecked-inc-int i)))))
          nops))))

  (method ^:private getAttributes ^MBeanAttributeInfo/1 [this ^MBeanInfo info]
    (let [atts (.getAttributes info)]
      (when (some? atts)
        (let [^:mutable ^MBeanAttributeInfo/1 natts nil
              attlen (alength atts)]
          (set! natts (new MBeanAttributeInfo/1 attlen))
          (loop [^int i 0]
            (when (< i attlen)
              (let [a (aget atts i)]
                (aset natts i (StandardMBean/customize a (.getDescription this a)))
                (recur (unchecked-inc-int i)))))
          natts))))

  (method ^:public preRegister :throws [Exception] ^ObjectName [this ^MBeanServer server
                                                                ^ObjectName name]
    (.register mbean server name)
    name)

  (method ^:public postRegister ^void [this ^Boolean registrationDone]
    (when-not (.booleanValue registrationDone) (.unregister mbean)))

  (method ^:public preDeregister :throws [Exception] ^void [this])

  (method ^:public postDeregister ^void [this] (.unregister mbean))

  (field ^:private ^:static ^:final ^{:tag (Map (Class ?) Boolean)} mbeanInfoSafeMap (WeakHashMap.))

  (method ^:static immutableInfo ^boolean [^{:tag (Class (? extends StandardMBean))} subclass]
    (if (or (identical? subclass StandardMBean) (identical? subclass StandardEmitterMBean))
        true
        (locking mbeanInfoSafeMap
          (let [^:mutable safe (cast Boolean (.get mbeanInfoSafeMap subclass))]
            (when (nil? safe)
              (try
                (set! safe (StandardMBean/mBeanInfoSafe subclass))
                (catch Exception e (set! safe false)))
              (.put mbeanInfoSafeMap subclass safe))
            safe))))

  (method ^:static overrides ^boolean [^{:tag (Class ?)} subclass ^{:tag (Class ?)} superclass
                                       ^String name & ^{:tag (array (Class ?))} params]
    (loop [^{:tag (Class ?)} c subclass]
      (when-not (identical? c superclass)
        (try (.getDeclaredMethod c name params) (return true) (catch NoSuchMethodException e))
        (recur (.getSuperclass c))))
    false)

  (method ^:private ^:static mBeanInfoSafe ^boolean [^{:tag (Class ?)} subclass]
    (cond
      (StandardMBean/overrides subclass StandardMBean "cacheMBeanInfo" MBeanInfo) false
      (StandardMBean/overrides subclass StandardMBean "getCachedMBeanInfo" (cast Class/1 nil)) false
      (StandardMBean/overrides subclass StandardMBean "getMBeanInfo" (cast Class/1 nil)) false
      :else
        (do
          (when (.isAssignableFrom StandardEmitterMBean subclass)
            (when (StandardMBean/overrides subclass
                                           StandardEmitterMBean
                                           "getNotificationInfo"
                                           (cast Class/1 nil))
              (return false)))
          true))))

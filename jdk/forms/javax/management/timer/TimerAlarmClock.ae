(in-ns 'javax.management.timer)

(import '(com.sun.jmx.defaults JmxProperties)
        '(java.util Date TimerTask)
        '(jdk.internal.jrt SystemLoggers$Logger$Level))

(defclass TimerAlarmClock
  :extends TimerTask

  (field ^Timer listener nil)

  (field ^long timeout 10000)

  (field ^Date next nil)

  (constructor ^:public [this ^Timer listener ^long timeout]
    (set! (.-listener this) listener)
    (set! (.-timeout this) (Math/max 0 timeout)))

  (constructor ^:public [this ^Timer listener ^Date next]
    (set! (.-listener this) listener)
    (set! (.-next this) next))

  (method ^:public run ^void [this]

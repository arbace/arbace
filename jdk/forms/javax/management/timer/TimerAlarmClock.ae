      (let [notif (TimerAlarmClockNotification. this)] (.notifyAlarmClock listener notif))
      (catch Exception e
        (.log JmxProperties/TIMER_LOGGER
              SystemLoggers$Logger$Level/TRACE
              "Got unexpected exception when sending a notification"
              e)))))

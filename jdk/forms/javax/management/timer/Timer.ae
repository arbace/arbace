          (do (when (some? alarmClock) (.cancel alarmClock)) (.remove timerTable notifID)))))

  (method notifyAlarmClock ^void [this ^TimerAlarmClockNotification notification]
    (let [^:mutable ^TimerNotification timerNotification nil
          ^:mutable ^Date timerDate nil
          alarmClock (cast TimerAlarmClock (.getSource notification))]

          (when (identical? (aget obj ALARM_CLOCK_INDEX) alarmClock)
            (set! timerNotification (cast TimerNotification (aget obj TIMER_NOTIF_INDEX)))
            (set! timerDate (cast Date (aget obj TIMER_DATE_INDEX)))
            (break))))
      (.sendNotification this timerDate timerNotification)
      (.updateTimerTable this (.getNotificationID timerNotification))))

  (method sendNotification ^void [this ^Date timeStamp ^TimerNotification notification]
    (when (.isLoggable JmxProperties/TIMER_LOGGER SystemLoggers$Logger$Level/TRACE)
      (let [strb (.append (.append (.append (.append
                                              (.append
                                                (.append
                                                  (.append
                                                    (.append
                                                      (.append
                                                        (StringBuilder.)
                                                        "sending timer notification:")
                                                      "\n\tNotification source = ")
                                                    (.getSource notification))
                                                  "\n\tNotification type = ")
                                                (.getType notification))
                                              "\n\tNotification ID = ")
                                            (.getNotificationID notification))
                                   "\n\tNotification date = ")

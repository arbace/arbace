                      (do
                        (set! alarmClock (TimerAlarmClock. this date))
                        (aset obj ALARM_CLOCK_INDEX ^Object alarmClock)
                        (.schedule timer alarmClock (.-next alarmClock)))
                      (do
                        (set! alarmClock (TimerAlarmClock. this (.longValue period)))
                        (aset obj ALARM_CLOCK_INDEX ^Object alarmClock)
                        (.schedule timer alarmClock (.-timeout alarmClock)))))

        (.setSequenceNumber notification curSeqNumber)
        (.sendNotification this (cast TimerNotification (.cloneTimerNotification notification))))
      (.log JmxProperties/TIMER_LOGGER SystemLoggers$Logger$Level/TRACE "timer notification sent"))))

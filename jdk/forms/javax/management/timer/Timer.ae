  (method ^:private ^:synchronized updateTimerTable ^void [this ^Integer notifID]
    (let [obj (cast Object/1 (.get timerTable notifID))
          date (cast Date (aget obj TIMER_DATE_INDEX))
          period (cast Long (aget obj TIMER_PERIOD_INDEX))
          ^:mutable nbOccurences (cast Long (aget obj TIMER_NB_OCCUR_INDEX))
          fixedRate (cast Boolean (aget obj FIXED_RATE_INDEX))
          ^:mutable alarmClock (cast TimerAlarmClock (aget obj ALARM_CLOCK_INDEX))]

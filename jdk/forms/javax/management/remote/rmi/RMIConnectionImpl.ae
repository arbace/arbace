                              (aget filterValues i))))
          (aset ids
                i
                (cast Integer
                      (.doOperation this
                                    ADD_NOTIFICATION_LISTENERS
                                    (new Object/1 [(aget names i) (aget filterValues i)])
                                    nil)))
          (set! i (unchecked-inc-int i)))
        ids
        (catch Exception e
          (loop [^int j 0]
            (when (< j i)
              (try
                (.removeNotificationListener (.getServerNotifFwd this) (aget names j) (aget ids j))
                (catch Exception eee))
              (recur (unchecked-inc-int j))))
          (cond
            (instance? ClassCastException e) (throw (cast ClassCastException e))
            (instance? IOException e) (throw (cast IOException e))
            (instance? InstanceNotFoundException e) (throw (cast InstanceNotFoundException e))
            (instance? RuntimeException e) (throw (cast RuntimeException e))
            :else (throw (IOException. (java-str "Got unexpected server exception: " e) e)))))))

  (method ^:public addNotificationListener :throws [InstanceNotFoundException IOException] ^void [this
                                                                                                  ^ObjectName name
                                                                                                  ^ObjectName listener
                                                                                                  ^MarshalledObject filter
                                                                                                  ^MarshalledObject handback
                                                                                                  ^Subject delegationSubject]
    (RMIConnectionImpl/checkNonNull "Target MBean name" name)
    (RMIConnectionImpl/checkNonNull "Listener MBean name" listener)
    (let [^:mutable ^NotificationFilter filterValue nil
          ^:mutable ^Object handbackValue nil
          debug (.debugOn logger)
          targetCl (.getClassLoaderFor this name)]
      (when debug
        (.debug logger
                "addNotificationListener(ObjectName,ObjectName,NotificationFilter,Object)"
                (java-str "connectionId="
                          connectionId
                          " unwrapping filter with target extended ClassLoader.")))
      (set! filterValue
            (cast NotificationFilter
                  (.unwrap this
                           filter
                           targetCl
                           defaultClassLoader
                           NotificationFilter
                           delegationSubject)))
      (when debug
        (.debug logger
                "addNotificationListener(ObjectName,ObjectName,NotificationFilter,Object)"
                (java-str "connectionId="
                          connectionId
                          " unwrapping handback with target extended ClassLoader.")))
      (set! handbackValue
            (.unwrap this handback targetCl defaultClassLoader Object delegationSubject))
      (try
        (let [params (new Object/1 [name listener filterValue handbackValue])]
          (when debug
            (.debug logger
                    "addNotificationListener(ObjectName,ObjectName,NotificationFilter,Object)"
                    (java-str "connectionId="
                              connectionId
                              ", name="
                              name
                              ", listenerName="
                              listener
                              ", filter="
                              filterValue
                              ", handback="
                              handbackValue)))
          (.doOperation this ADD_NOTIFICATION_LISTENER_OBJECTNAME params delegationSubject))
        (catch Exception e
          (when (instance? InstanceNotFoundException e) (throw (cast InstanceNotFoundException e)))
          (when (instance? IOException e) (throw (cast IOException e)))
          (when (instance? RuntimeException e) (throw (cast RuntimeException e)))
          (throw (IOException. (java-str "Got unexpected server exception: " e) e))))))

  (method ^:public removeNotificationListeners :throws [InstanceNotFoundException
                                                        ListenerNotFoundException
                                                        IOException] ^void [this ^ObjectName name
                                                                            ^Integer/1 listenerIDs
                                                                            ^Subject delegationSubject]
    (when (or (nil? name) (nil? listenerIDs))
      (throw (IllegalArgumentException. "Illegal null parameter")))
    (loop [^int i 0]
      (if (< i (alength listenerIDs))
          (if (nil? (aget listenerIDs i))
              (throw (IllegalArgumentException. "Null listener ID"))
              (recur (unchecked-inc-int i)))
          nil))
    (try
      (let [params (new Object/1 [name listenerIDs])]
        (when (.debugOn logger)
          (.debug logger
                  "removeNotificationListener(ObjectName,Integer[])"
                  (java-str "connectionId="
                            connectionId
                            ", name="
                            name
                            ", listenerIDs="
                            (RMIConnectionImpl/objects listenerIDs))))
        (.doOperation this REMOVE_NOTIFICATION_LISTENER params delegationSubject))
      (catch Exception e
        (when (instance? InstanceNotFoundException e) (throw (cast InstanceNotFoundException e)))
        (when (instance? ListenerNotFoundException e) (throw (cast ListenerNotFoundException e)))
        (when (instance? IOException e) (throw (cast IOException e)))
        (when (instance? RuntimeException e) (throw (cast RuntimeException e)))
        (throw (IOException. (java-str "Got unexpected server exception: " e) e)))))

  (method ^:public removeNotificationListener :throws [InstanceNotFoundException
                                                       ListenerNotFoundException
                                                       IOException] ^void [this ^ObjectName name
                                                                           ^ObjectName listener
                                                                           ^Subject delegationSubject]
    (RMIConnectionImpl/checkNonNull "Target MBean name" name)
    (RMIConnectionImpl/checkNonNull "Listener MBean name" listener)
    (try
      (let [params (new Object/1 [name listener])]
        (when (.debugOn logger)
          (.debug logger
                  "removeNotificationListener(ObjectName,ObjectName)"
                  (java-str "connectionId=" connectionId ", name=" name ", listenerName=" listener)))
        (.doOperation this REMOVE_NOTIFICATION_LISTENER_OBJECTNAME params delegationSubject))
      (catch Exception e
        (when (instance? InstanceNotFoundException e) (throw (cast InstanceNotFoundException e)))
        (when (instance? ListenerNotFoundException e) (throw (cast ListenerNotFoundException e)))
        (when (instance? IOException e) (throw (cast IOException e)))
        (when (instance? RuntimeException e) (throw (cast RuntimeException e)))
        (throw (IOException. (java-str "Got unexpected server exception: " e) e)))))

  (method ^:public removeNotificationListener :throws [InstanceNotFoundException
                                                       ListenerNotFoundException
                                                       IOException] ^void [this ^ObjectName name
                                                                           ^ObjectName listener
                                                                           ^MarshalledObject filter
                                                                           ^MarshalledObject handback
                                                                           ^Subject delegationSubject]
    (RMIConnectionImpl/checkNonNull "Target MBean name" name)
    (RMIConnectionImpl/checkNonNull "Listener MBean name" listener)
    (let [^:mutable ^NotificationFilter filterValue nil
          ^:mutable ^Object handbackValue nil
          debug (.debugOn logger)
          targetCl (.getClassLoaderFor this name)]
      (when debug
        (.debug logger
                "removeNotificationListener(ObjectName,ObjectName,NotificationFilter,Object)"
                (java-str "connectionId="
                          connectionId
                          " unwrapping filter with target extended ClassLoader.")))
      (set! filterValue
            (cast NotificationFilter
                  (.unwrap this
                           filter
                           targetCl
                           defaultClassLoader
                           NotificationFilter
                           delegationSubject)))
      (when debug
        (.debug logger
                "removeNotificationListener(ObjectName,ObjectName,NotificationFilter,Object)"
                (java-str "connectionId="
                          connectionId
                          " unwrapping handback with target extended ClassLoader.")))
      (set! handbackValue
            (.unwrap this handback targetCl defaultClassLoader Object delegationSubject))
      (try
        (let [params (new Object/1 [name listener filterValue handbackValue])]
          (when debug
            (.debug logger
                    "removeNotificationListener(ObjectName,ObjectName,NotificationFilter,Object)"
                    (java-str "connectionId="
                              connectionId
                              ", name="
                              name
                              ", listenerName="
                              listener
                              ", filter="
                              filterValue
                              ", handback="
                              handbackValue)))
          (.doOperation this
                        REMOVE_NOTIFICATION_LISTENER_OBJECTNAME_FILTER_HANDBACK
                        params
                        delegationSubject))
        (catch Exception e
          (when (instance? InstanceNotFoundException e) (throw (cast InstanceNotFoundException e)))
          (when (instance? ListenerNotFoundException e) (throw (cast ListenerNotFoundException e)))
          (when (instance? IOException e) (throw (cast IOException e)))
          (when (instance? RuntimeException e) (throw (cast RuntimeException e)))
          (throw (IOException. (java-str "Got unexpected server exception: " e) e))))))

  (method ^:public fetchNotifications :throws [IOException] ^NotificationResult [this
                                                                                 ^long clientSequenceNumber
                                                                                 ^int maxNotifications
                                                                                 ^long timeout]
    (when (.debugOn logger)
      (.debug logger
              "fetchNotifications"
              (java-str "connectionId=" connectionId ", timeout=" timeout)))
    (when (or (< maxNotifications 0) (< timeout 0))
      (throw (IllegalArgumentException. "Illegal negative argument")))
    (let [serverTerminated (.reqIncoming serverCommunicatorAdmin)]
      (try
        (cond
          serverTerminated
            (do
              (when (.debugOn logger)
                (.debug
                  logger
                  "fetchNotifications"
                  "The notification server has been closed, returns null to force the client to stop fetching"))
              nil)
          (nil? subject)
            (.fetchNotifs (.getServerNotifFwd this) clientSequenceNumber timeout maxNotifications)
          :else
            (try
              (cast NotificationResult
                    (Subject/callAs subject
                                    (lambda Callable ^NotificationResult []
                                      (.fetchNotifs
                                        (.getServerNotifFwd this)
                                        clientSequenceNumber
                                        timeout
                                        maxNotifications))))
              (catch CompletionException ce
                (let [thr (.getCause ce)]
                  (if-instance [^SecurityException se thr]
                    (throw se)
                    (if-instance [^IOException ioe thr] (throw ioe) (throw (RuntimeException. thr))))))))
        (finally (.rspOutgoing serverCommunicatorAdmin)))))

  (method ^:public toString ^String [this]
    (java-str (.toString super) ": connectionId=" connectionId))

  (defclass ^:private RMIServerCommunicatorAdmin
    :extends ServerCommunicatorAdmin

    (constructor ^:public [this ^long timeout] (super. timeout))

    (method ^:protected doStop ^void [this]
      (try
        (.close RMIConnectionImpl/this)
        (catch IOException ie
          (.warning logger "RMIServerCommunicatorAdmin-doStop" (java-str "Failed to close: " ie))
          (.debug logger "RMIServerCommunicatorAdmin-doStop" ie)))))

  (method ^:private getClassLoaderFor :throws [InstanceNotFoundException] ^ClassLoader [this
                                                                                        ^:final ^ObjectName name]
    (.getClassLoaderFor mbeanServer name))

  (method ^:private doOperation :throws [Exception] [this ^:final ^int operation
                                                     ^:final ^Object/1 params
                                                     ^:final ^Subject delegationSubject]
    (when (some? delegationSubject)
      (throw (UnsupportedOperationException. "Subject Delegation has been removed.")))
    (.reqIncoming serverCommunicatorAdmin)
    (try
      (if (nil? subject)
          (.doOperationInner this operation params)
          (try
            (Subject/callAs subject (lambda Callable [] (.doOperationInner this operation params)))
            (catch CompletionException ce
              (let [thr (.getCause ce)]
                (if-instance [^Exception e thr] (throw e) (throw (RuntimeException. thr)))))))
      (catch Error e (throw (JMXServerErrorException. (.toString e) e)))
      (finally (.rspOutgoing serverCommunicatorAdmin))))

  (method ^:private doOperationInner :throws [Exception] [this ^int operation ^Object/1 params]
    (switch operation
      CREATE_MBEAN
        (.createMBean mbeanServer (cast String (aget params 0)) (cast ObjectName (aget params 1)))
      CREATE_MBEAN_LOADER
        (.createMBean mbeanServer
                      (cast String (aget params 0))
                      (cast ObjectName (aget params 1))
                      (cast ObjectName (aget params 2)))
      CREATE_MBEAN_PARAMS
        (.createMBean mbeanServer
                      (cast String (aget params 0))
                      (cast ObjectName (aget params 1))
                      (cast Object/1 (aget params 2))
                      (cast String/1 (aget params 3)))
      CREATE_MBEAN_LOADER_PARAMS
        (.createMBean mbeanServer
                      (cast String (aget params 0))
                      (cast ObjectName (aget params 1))
                      (cast ObjectName (aget params 2))
                      (cast Object/1 (aget params 3))
                      (cast String/1 (aget params 4)))
      GET_ATTRIBUTE
        (.getAttribute mbeanServer (cast ObjectName (aget params 0)) (cast String (aget params 1)))
      GET_ATTRIBUTES
        (.getAttributes mbeanServer
                        (cast ObjectName (aget params 0))
                        (cast String/1 (aget params 1)))
      GET_DEFAULT_DOMAIN (.getDefaultDomain mbeanServer)
      GET_DOMAINS (.getDomains mbeanServer)
      GET_MBEAN_COUNT (.getMBeanCount mbeanServer)
      GET_MBEAN_INFO (.getMBeanInfo mbeanServer (cast ObjectName (aget params 0)))
      GET_OBJECT_INSTANCE (.getObjectInstance mbeanServer (cast ObjectName (aget params 0)))
      INVOKE
        (.invoke mbeanServer
                 (cast ObjectName (aget params 0))
                 (cast String (aget params 1))
                 (cast Object/1 (aget params 2))
                 (cast String/1 (aget params 3)))
      IS_INSTANCE_OF
        (if (.isInstanceOf mbeanServer
                           (cast ObjectName (aget params 0))
                           (cast String (aget params 1)))
            Boolean/TRUE
            Boolean/FALSE)
      IS_REGISTERED
        (if (.isRegistered mbeanServer (cast ObjectName (aget params 0)))
            Boolean/TRUE
            Boolean/FALSE)
      QUERY_MBEANS
        (.queryMBeans mbeanServer (cast ObjectName (aget params 0)) (cast QueryExp (aget params 1)))
      QUERY_NAMES
        (.queryNames mbeanServer (cast ObjectName (aget params 0)) (cast QueryExp (aget params 1)))
      SET_ATTRIBUTE
        (do
          (.setAttribute mbeanServer
                         (cast ObjectName (aget params 0))
                         (cast Attribute (aget params 1)))
          nil)
      SET_ATTRIBUTES
        (.setAttributes mbeanServer
                        (cast ObjectName (aget params 0))
                        (cast AttributeList (aget params 1)))
      UNREGISTER_MBEAN (do (.unregisterMBean mbeanServer (cast ObjectName (aget params 0))) nil)
      ADD_NOTIFICATION_LISTENERS
        (.addNotificationListener (.getServerNotifFwd this)
                                  (cast ObjectName (aget params 0))
                                  (cast NotificationFilter (aget params 1)))
      ADD_NOTIFICATION_LISTENER_OBJECTNAME
        (do
          (.addNotificationListener mbeanServer
                                    (cast ObjectName (aget params 0))
                                    (cast ObjectName (aget params 1))
                                    (cast NotificationFilter (aget params 2))
                                    (aget params 3))
          nil)
      REMOVE_NOTIFICATION_LISTENER
        (do
          (.removeNotificationListener (.getServerNotifFwd this)
                                       (cast ObjectName (aget params 0))
                                       (cast Integer/1 (aget params 1)))
          nil)
      REMOVE_NOTIFICATION_LISTENER_OBJECTNAME
        (do
          (.removeNotificationListener mbeanServer
                                       (cast ObjectName (aget params 0))
                                       (cast ObjectName (aget params 1)))
          nil)
      REMOVE_NOTIFICATION_LISTENER_OBJECTNAME_FILTER_HANDBACK
        (do
          (.removeNotificationListener mbeanServer
                                       (cast ObjectName (aget params 0))
                                       (cast ObjectName (aget params 1))
                                       (cast NotificationFilter (aget params 2))
                                       (aget params 3))
          nil)
      (throw (IllegalArgumentException. "Invalid operation"))))

  (method ^:private ^:static setCcl ^ClassLoader [^ClassLoader classLoader]
    (let [currentThread (Thread/currentThread)
          old (.getContextClassLoader currentThread)]
      (when-not (identical? classLoader old) (.setContextClassLoader currentThread classLoader))
      old))

  (method ^:private unwrap :type-params [T] :throws [IOException] ^T [this
                                                                      ^:final ^{:tag (MarshalledObject ?)} mo
                                                                      ^:final ^ClassLoader cl
                                                                      ^:final ^{:tag (Class T)} wrappedClass
                                                                      ^Subject delegationSubject]
    (when (some? delegationSubject)
      (throw (UnsupportedOperationException. "Subject Delegation has been removed.")))
    (when (some? mo)
      (try
        (let [old (RMIConnectionImpl/setCcl cl)]
          (try (.cast wrappedClass (.get mo)) (finally (RMIConnectionImpl/setCcl old))))
        (catch Exception e
          (when (instance? IOException e) (throw (cast IOException e)))
          (.warning logger "unwrap" (java-str "Failed to unmarshall object: " e))
          (.debug logger "unwrap" e)
          (throw (UnmarshalException. (.toString e) e))))))

  (method ^:private unwrap :type-params [T] :throws [IOException] ^T [this
                                                                      ^:final ^{:tag (MarshalledObject ?)} mo
                                                                      ^:final ^ClassLoader cl1
                                                                      ^:final ^ClassLoader cl2
                                                                      ^:final ^{:tag (Class T)} wrappedClass
                                                                      ^Subject delegationSubject]
    (when (some? mo)
      (try
        (let [^ClassLoader orderCL (CombinedClassLoader.
                                     (.getContextClassLoader (Thread/currentThread))
                                     (OrderClassLoaders. cl1 cl2))]
          (return (.unwrap this mo orderCL wrappedClass delegationSubject)))
        (catch Exception e
          (when (instance? IOException e) (throw (cast IOException e)))
          (when (instance? ClassNotFoundException e) (throw (UnmarshalException. (.toString e) e)))
          (.warning logger "unwrap" (java-str "Failed to unmarshall object: " e))
          (.debug logger "unwrap" e)))
      nil))

  (field ^:private ^:static ^:final ^Object/1 NO_OBJECTS (new Object/1 0))

  (field ^:private ^:static ^:final ^String/1 NO_STRINGS (new String/1 0))

  (method ^:private ^:static nullIsEmpty ^Object/1 [^Object/1 array]
    (if (nil? array) NO_OBJECTS array))

  (method ^:private ^:static nullIsEmpty ^String/1 [^String/1 array]
    (if (nil? array) NO_STRINGS array))

  (method ^:private ^:static checkNonNull ^void [^String what x]
    (when (nil? x)
      (let [^RuntimeException wrapped (IllegalArgumentException.
                                        (java-str what " must not be null"))]
        (throw (RuntimeOperationsException. wrapped)))))

  (field ^:private ^:final ^Subject subject)

  (field ^:private ^:final ^RMIServerImpl rmiServer)

  (field ^:private ^:final ^MBeanServer mbeanServer)

  (field ^:private ^:final ^ClassLoader defaultClassLoader)

  (field ^:private ^:final ^ClassLoader defaultContextClassLoader)

  (field ^:private ^:final ^ClassLoaderWithRepository classLoaderWithRepository)

  (field ^:private ^boolean terminated false)

  (field ^:private ^:final ^String connectionId)

  (field ^:private ^:final ^ServerCommunicatorAdmin serverCommunicatorAdmin)

  (field ^:private ^:static ^:final ^int ADD_NOTIFICATION_LISTENERS 1)

  (field ^:private ^:static ^:final ^int ADD_NOTIFICATION_LISTENER_OBJECTNAME 2)

  (field ^:private ^:static ^:final ^int CREATE_MBEAN 3)

  (field ^:private ^:static ^:final ^int CREATE_MBEAN_PARAMS 4)

  (field ^:private ^:static ^:final ^int CREATE_MBEAN_LOADER 5)

  (field ^:private ^:static ^:final ^int CREATE_MBEAN_LOADER_PARAMS 6)

  (field ^:private ^:static ^:final ^int GET_ATTRIBUTE 7)

  (field ^:private ^:static ^:final ^int GET_ATTRIBUTES 8)

  (field ^:private ^:static ^:final ^int GET_DEFAULT_DOMAIN 9)

  (field ^:private ^:static ^:final ^int GET_DOMAINS 10)

  (field ^:private ^:static ^:final ^int GET_MBEAN_COUNT 11)

  (field ^:private ^:static ^:final ^int GET_MBEAN_INFO 12)

  (field ^:private ^:static ^:final ^int GET_OBJECT_INSTANCE 13)

  (field ^:private ^:static ^:final ^int INVOKE 14)

  (field ^:private ^:static ^:final ^int IS_INSTANCE_OF 15)

  (field ^:private ^:static ^:final ^int IS_REGISTERED 16)

  (field ^:private ^:static ^:final ^int QUERY_MBEANS 17)

  (field ^:private ^:static ^:final ^int QUERY_NAMES 18)

  (field ^:private ^:static ^:final ^int REMOVE_NOTIFICATION_LISTENER 19)

  (field ^:private ^:static ^:final ^int REMOVE_NOTIFICATION_LISTENER_OBJECTNAME 20)

  (field ^:private ^:static ^:final ^int REMOVE_NOTIFICATION_LISTENER_OBJECTNAME_FILTER_HANDBACK 21)

  (field ^:private ^:static ^:final ^int SET_ATTRIBUTE 22)

  (field ^:private ^:static ^:final ^int SET_ATTRIBUTES 23)

  (field ^:private ^:static ^:final ^int UNREGISTER_MBEAN 24)

  (field ^:private ^ServerNotifForwarder serverNotifForwarder)

  (field ^:private ^{:tag (Map String ?)} env)

  (method ^:private ^:static objects ^String [^:final ^Object/1 objs]
    (if (nil? objs) "null" (.toString (Arrays/asList objs))))

  (method ^:private ^:static strings ^String [^:final ^String/1 strs]
    (RMIConnectionImpl/objects strs))

  (field ^:private ^:static ^:final ^ClassLogger logger
    (ClassLogger. "javax.management.remote.rmi" "RMIConnectionImpl"))

  (defclass ^:private ^:static ^:final CombinedClassLoader
    :extends ClassLoader

    (defclass ^:private ^:static ^:final ClassLoaderWrapper
      :extends ClassLoader

      (constructor [this ^ClassLoader cl] (super. cl))

      (method ^:protected loadClass :throws [ClassNotFoundException] ^{:tag (Class ?)} [this
                                                                                        ^String name
                                                                                        ^boolean resolve]
        (.loadClass super name resolve)))

    (field ^:final ^ClassLoaderWrapper defaultCL)

    (constructor ^:private [this ^ClassLoader parent ^ClassLoader defaultCL]
      (super. parent)
      (set! (.-defaultCL this) (ClassLoaderWrapper. defaultCL)))

    (method ^:protected loadClass :throws [ClassNotFoundException] ^{:tag (Class ?)} [this
                                                                                      ^String name
                                                                                      ^boolean resolve]
      (try
        (.loadClass super name resolve)
        (catch Exception e
          (loop [^Throwable t e]
            (if (some? t)
                (if (instance? SecurityException t)
                    (throw (if (identical? t e)
                               (cast SecurityException t)
                               (SecurityException. (.getMessage t) e)))
                    (recur (.getCause t)))
                nil))))
      (let [^{:tag (Class ?)} cl (.loadClass defaultCL name resolve)] cl))))

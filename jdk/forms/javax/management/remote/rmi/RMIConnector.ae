                "RMIClientCommunicatorAdmin-checkConnection"
                "Calling the method getDefaultDomain."))
      (.getDefaultDomain connection nil))

    (method ^:protected doStart :throws [IOException] ^void [this]
      (let [^:mutable ^RMIServer stub nil]
        (try
          (set! stub

    (set! terminated false)
    (set! connectionBroadcaster (NotificationBroadcasterSupport.)))

  (method ^:private ^:static checkStub ^void [^:mutable ^Remote stub ^{:tag (Class ?)} stubClass]
    (when-not (identical? (.getClass stub) stubClass)
      (if (not (Proxy/isProxyClass (.getClass stub)))
          (throw (SecurityException. (java-str "Expecting a " (.getName stubClass) " stub!")))
          (let [handler (Proxy/getInvocationHandler stub)]
            (if (not (identical? (.getClass handler) RemoteObjectInvocationHandler))
                (throw (SecurityException.
                         (java-str "Expecting a dynamic proxy instance with a "
                                   (.getName RemoteObjectInvocationHandler)
                                   " invocation handler!")))
                (set! stub (cast Remote handler))))))
    (let [ref (.getRef (cast RemoteObject stub))]
      (when-not (identical? (.getClass ref) UnicastRef2)
        (throw (SecurityException.
                 (java-str "Expecting a " (.getName UnicastRef2) " remote reference in stub!"))))
      (let [liveRef (.getLiveRef (cast UnicastRef2 ref))
            csf (.getClientSocketFactory liveRef)]
        (when (or (nil? csf) (not (identical? (.getClass csf) SslRMIClientSocketFactory)))
          (throw (SecurityException.
                   (java-str "Expecting a "
                             (.getName SslRMIClientSocketFactory)
                             " RMI client socket factory in stub!")))))))

  (method ^:private findRMIServer :throws [NamingException IOException] ^RMIServer [this
                                                                                    ^JMXServiceURL directoryURL
                                                                                    ^{:tag (Map String Object)} environment]
    (let [path (.getURLPath directoryURL)
          ^:mutable end (.indexOf path \;)]
      (when (< end 0) (set! end (.length path)))
      (cond
        (.startsWith path "/jndi/") (.findRMIServerJNDI this (.substring path 6 end) environment)
        (.startsWith path "/stub/") (.findRMIServerJRMP this (.substring path 6 end) environment)
        :else
          (let [msg (java-str "URL path must begin with /jndi/ or /stub/ or /ior/: " path)]
            (throw (MalformedURLException. msg))))))

  (method ^:private findRMIServerJNDI :throws [NamingException] ^RMIServer [this ^String jndiURL
                                                                            ^{:tag (Map String ?)} env]
    (let [ctx (InitialContext. (EnvHelp/mapToHashtable env))
          objref (.lookup ctx jndiURL)]
      (.close ctx)
      (RMIConnector/narrowJRMPServer objref)))

  (method ^:private ^:static narrowJRMPServer ^RMIServer [objref]
    (cast RMIServer objref))

  (method ^:private findRMIServerJRMP :throws [IOException] ^RMIServer [this ^String base64
                                                                        ^{:tag (Map String ?)} env]
    (let [^:mutable ^byte/1 serialized nil]
      (try
        (set! serialized (RMIConnector/base64ToByteArray base64))
        (catch IllegalArgumentException e
          (throw (MalformedURLException. (java-str "Bad BASE64 encoding: " (.getMessage e))))))
      (let [bin (ByteArrayInputStream. serialized)
            loader (EnvHelp/resolveClientClassLoader env)
            ^ObjectInputStream oin (if (nil? loader)
                                       (ObjectInputStream. bin)
                                       ^ObjectInputStream (ObjectInputStreamWithLoader. bin loader))
            ^:mutable ^Object stub nil]
        (try
          (set! stub (.readObject oin))
          (catch ClassNotFoundException e
            (throw (MalformedURLException. (java-str "Class not found: " e)))))
        (cast RMIServer stub))))


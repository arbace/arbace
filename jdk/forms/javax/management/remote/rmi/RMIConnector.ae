    (method ^:public gotIOException :throws [IOException] ^void [this ^IOException ioe]
      (if (instance? NoSuchObjectException ioe)
          (.gotIOException super ioe)
          (do
            (try
              (.getDefaultDomain connection nil)
              (catch IOException ioexc
                (let [^:mutable toClose false]
                  (locking this (when-not terminated (set! terminated true) (set! toClose true)))
                  (when toClose
                    (let [^Notification failedNotif (JMXConnectionNotification.
                                                      JMXConnectionNotification/FAILED
                                                      this
                                                      connectionId
                                                      (let [old-5 clientNotifSeqNo]
                                                        (set!
                                                          clientNotifSeqNo
                                                          (unchecked-inc clientNotifSeqNo))
                                                        old-5)
                                                      (java-str
                                                        "Failed to communicate with the server: "
                                                        (.toString ioe))
                                                      ioe)]
                      (.sendNotification RMIConnector/this failedNotif)
                      (try (.close RMIConnector/this true) (catch Exception e)))))))
            (when (instance? ServerException ioe)
              (let [tt (.-detail (cast ServerException ioe))]
                (cond
                  (instance? IOException tt) (throw (cast IOException tt))
                  (instance? RuntimeException tt) (throw (cast RuntimeException tt)))))
            (throw ioe))))

    (method ^:public reconnectNotificationListeners :throws [IOException] ^void [this
                                                                                 ^ClientListenerInfo/1 old]
      (let [len (alength old)
            ^:mutable ^int i 0
            ^:mutable clis (new ClientListenerInfo/1 len)
            names (new ObjectName/1 len)
            listeners (new NotificationListener/1 len)
            filters (new NotificationFilter/1 len)
            ^{:tag (array (MarshalledObject NotificationFilter))} mFilters (cast
                                                                             MarshalledObject/1
                                                                             (Util/cast
                                                                               (new
                                                                                 MarshalledObject/1
                                                                                 len)))
            handbacks (new Object/1 len)]
        (set! i 0)
        (while (< i len)
          (aset names i (.getObjectName (aget old i)))
          (aset listeners i (.getListener (aget old i)))
          (aset filters i (.getNotificationFilter (aget old i)))
          (aset mFilters i (MarshalledObject. (aget filters i)))
          (aset handbacks i (.getHandback (aget old i)))
          (set! i (unchecked-inc-int i)))
        (try
          (let [ids (.addListenersWithSubjects RMIConnector/this names mFilters nil false)]
            (set! i 0)
            (while (< i len)
              (aset clis
                    i
                    (ClientListenerInfo. (aget ids i)
                                         (aget names i)
                                         (aget listeners i)
                                         (aget filters i)
                                         (aget handbacks i)))
              (set! i (unchecked-inc-int i)))
            (.postReconnection rmiNotifClient clis)
            (return))
          (catch InstanceNotFoundException infe))
        (let [^:mutable ^int j 0]
          (set! i 0)
          (while (< i len)
            (try
              (let [id (.addListenerWithSubject RMIConnector/this
                                                (aget names i)
                                                (MarshalledObject. (aget filters i))
                                                nil
                                                false)]
                (aset clis
                      j
                      (ClientListenerInfo. id
                                           (aget names i)
                                           (aget listeners i)
                                           (aget filters i)
                                           (aget handbacks i)))

        (.close RMIConnector/this)
        (catch IOException ioe
          (.warning logger
                    "RMIClientCommunicatorAdmin-doStop"
                    (java-str "Failed to call the method close():" ioe))
          (.debug logger "RMIClientCommunicatorAdmin-doStop" ioe)))))


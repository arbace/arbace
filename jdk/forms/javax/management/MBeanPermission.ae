  (method ^:public implies ^boolean [this ^Permission p]
    (if (not (instance? MBeanPermission p))
        false
        (let [that (cast MBeanPermission p)]
          (if (== (bit-and-int (.-mask this) QueryMBeans) QueryMBeans)
              (when-not (== (bit-and-int (bit-or-int (.-mask this) QueryNames) (.-mask that))
                            (.-mask that))
                (return false))
              (when-not (== (bit-and-int (.-mask this) (.-mask that)) (.-mask that)) (return false)))
          (when (some? (.-classNamePrefix that))
            (cond
              (nil? (.-classNamePrefix this)) (return false)
              (.-classNameExactMatch this)
                (do
                  (when-not (.-classNameExactMatch that) (return false))
                  (when-not (.equals (.-classNamePrefix that) (.-classNamePrefix this))
                    (return false)))
              :else
                (when-not (.startsWith (.-classNamePrefix that) (.-classNamePrefix this))
                  (return false))))
          (when (some? (.-member that))
            (if (nil? (.-member this))
                (return false)
                (when-not (.equals (.-member this) "*")
                  (when-not (.equals (.-member this) (.-member that)) (return false)))))
          (when (some? (.-objectName that))
            (if (nil? (.-objectName this))
                (return false)
                (when-not (.apply (.-objectName this) (.-objectName that))
                  (when-not (.equals (.-objectName this) (.-objectName that)) (return false)))))
          true)))

  (method ^:public equals ^boolean [this obj]
    (cond
      (identical? obj this) true
      (not (instance? MBeanPermission obj)) false
      :else
        (let [that (cast MBeanPermission obj)]
          (and (== (.-mask this) (.-mask that)) (.equals (.getName this) (.getName that))))))

  (method ^:private readObject :throws [IOException ClassNotFoundException] ^void [this
                                                                                   ^ObjectInputStream in]
    (.defaultReadObject in)
    (.parseName this)
    (.parseActions this)))

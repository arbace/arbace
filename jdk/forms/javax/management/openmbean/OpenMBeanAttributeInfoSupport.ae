              (when (< i n)
                (let [stringish (Array/get x i)
                      converted (OpenMBeanAttributeInfoSupport/convertFromStrings
                                  stringish
                                  componentOpenType)]
                  (Array/set targetArray i converted)
                  (recur (unchecked-inc-int i)))))
            (OpenMBeanAttributeInfoSupport/cast targetArray))))))


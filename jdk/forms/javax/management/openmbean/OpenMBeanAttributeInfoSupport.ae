  (method ^:private ^:static convertFromStringArray :type-params [T] ^T [x
                                                                         ^{:tag (OpenType T)} openType]
    (let [^{:tag (ArrayType ?)} arrayType (cast ArrayType openType)
          ^{:tag (OpenType ?)} baseType (.getElementOpenType arrayType)
          dim (.getDimension arrayType)
          ^:mutable squareBrackets "["]

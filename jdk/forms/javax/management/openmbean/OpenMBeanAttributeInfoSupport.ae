        (when (< i dim)
          (set! squareBrackets (java-str squareBrackets "["))
          (recur (unchecked-inc-int i))))
      (let [^:mutable ^{:tag (Class ?)} stringArrayClass nil
            ^:mutable ^{:tag (Class ?)} targetArrayClass nil]

            (set! stringArrayClass (Class/forName (java-str squareBrackets "Ljava.lang.String;")))
            (set! targetArrayClass (Class/forName (java-str squareBrackets "L" baseClassName ";"))))
          (catch ClassNotFoundException e (throw (NoClassDefFoundError. (.toString e)))))
        (when-not (.isInstance stringArrayClass x)
          (let [msg (java-str "Value for "
                              dim
                              "-dimensional array of "
                              (.getTypeName baseType)
                              " must be same type or a String array with same dimensions")]
            (throw (IllegalArgumentException. msg))))

              (try
                (set! componentOpenType (ArrayType. (unchecked-subtract-int dim 1) baseType))
                (catch OpenDataException e (throw (IllegalArgumentException. (.getMessage e) e)))))
          (let [n (Array/getLength x)
                targetArray (cast Object/1
                                  (Array/newInstance (.getComponentType targetArrayClass) n))]

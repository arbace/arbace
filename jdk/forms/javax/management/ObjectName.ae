    (Hashtable. (._getKeyPropertyList this)))

  (method ^:public getKeyPropertyListString ^String [this]
    (if (== (alength _kp_array) 0)
        ""
        (let [^:final total_size (unchecked-subtract-int
                                   (unchecked-subtract-int
                                     (unchecked-subtract-int
                                       (.length _canonicalName)
                                       (.getDomainLength this))
                                     1)
                                   (if (.isPropertyListPattern this) 2 0))
              ^:final dest_chars (new char/1 total_size)
              ^:final value (.toCharArray _canonicalName)]
          (.writeKeyPropertyListString this value dest_chars 0)
          (String. dest_chars))))

  (method ^:private getSerializedNameString ^String [this]
    (let [^:final total_size (.length _canonicalName)
          ^:final dest_chars (new char/1 total_size)
          ^:final value (.toCharArray _canonicalName)
          ^:final offset (unchecked-add-int (.getDomainLength this) 1)]
      (System/arraycopy value 0 dest_chars 0 offset)
      (let [^:final end (.writeKeyPropertyListString this value dest_chars offset)]
        (when (.isPropertyListPattern this)
          (if (== end offset)
              (aset dest_chars end \*)
              (do (aset dest_chars end \,) (aset dest_chars (unchecked-add-int end 1) \*))))
        (String. dest_chars))))

  (method ^:private writeKeyPropertyListString ^int [this ^char/1 canonicalChars ^char/1 data
                                                     ^int offset]
    (if (== (alength _kp_array) 0)
        offset
        (let [^:final dest_chars data
              ^:final value canonicalChars
              ^:mutable index offset
              ^:final len (alength _kp_array)
              ^:final last (unchecked-subtract-int len 1)]
          (loop [^int i 0]
            (when (< i len)
              (let [^:final prop (aget _kp_array i)
                    ^:final prop_len (unchecked-add-int
                                       (unchecked-add-int
                                         (.-_key_length prop)
                                         (.-_value_length prop))
                                       1)]
                (System/arraycopy value (.-_key_index prop) dest_chars index prop_len)
                (set! index (unchecked-add-int index prop_len))
                (if (< i last)
                    (do
                      (aset dest_chars index \,)
                      (set! index (unchecked-inc-int index))
                      (recur (unchecked-inc-int i)))
                    (recur (unchecked-inc-int i))))))
          index)))

  (method ^:public getCanonicalKeyPropertyListString ^String [this]
    (if (== (alength _ca_array) 0)
        ""
        (let [^:mutable len (.length _canonicalName)]
          (when (.isPropertyListPattern this) (set! len (unchecked-subtract-int len 2)))
          (.substring _canonicalName (unchecked-add-int (.getDomainLength this) 1) len))))

  (method ^:public toString ^String [this]
    (.getSerializedNameString this))

  (method ^:public equals ^boolean [this object]
    (cond
      (identical? this object) true
      (not (instance? ObjectName object)) false
      :else
        (let [on (cast ObjectName object)
              on_string (.-_canonicalName on)]
          (if (identical? _canonicalName on_string) true false))))

  (method ^:public hashCode ^int [this] (.hashCode _canonicalName))

  (method ^:public ^:static quote ^String [^String s]
    (let [^:final buf (StringBuilder. "\"")
          ^:final len (.length s)]
      (loop [^int i 0]
        (when (< i len)
          (let [^:mutable c (.charAt s i)]
            (switch c \newline (do (set! c \n) (.append buf \\)) (\\ \" \* \?) (.append buf \\))
            (.append buf c)
            (recur (unchecked-inc-int i)))))
      (.append buf \")
      (.toString buf)))

  (method ^:public ^:static unquote ^String [^String q]
    (let [^:final buf (StringBuilder.)
          ^:final len (.length q)]
      (when (or (or (< len 2) (not (== (.charAt q 0) \")))
                (not (== (.charAt q (unchecked-subtract-int len 1)) \")))
        (throw (IllegalArgumentException. "Argument not quoted")))
      (let [^:mutable ^int i 1]
        (while (< i (unchecked-subtract-int len 1))
          (let [^:mutable c (.charAt q i)]
            (if (== c \\)
                (do
                  (when (== i (unchecked-subtract-int len 2))
                    (throw (IllegalArgumentException. "Trailing backslash")))
                  (set! c (.charAt q (set! i (unchecked-inc-int i))))
                  (switch c
                    \n (set! c \newline)
                    (\\ \" \* \?) nil
                    (throw (IllegalArgumentException.
                             (java-str "Bad character '" c "' after backslash")))))
                (switch c
                  (\* \? \" \newline)
                    (throw (IllegalArgumentException.
                             (java-str "Invalid unescaped character '"
                                       c
                                       "' in the string to unquote")))))
            (.append buf c))
          (set! i (unchecked-inc-int i))))
      (.toString buf)))

  (field ^:public ^:static ^:final ^ObjectName WILDCARD (sun.management.Util/newObjectName "*:*"))

  (method ^:public apply ^boolean [this ^ObjectName name]
    (when (nil? name) (throw (NullPointerException.)))
    (cond
      (.isPattern name) false
      (not (.isPattern this)) (.equals _canonicalName (.-_canonicalName name))
      :else (and (.matchDomains this name) (.matchKeys this name))))

  (method ^:private ^:final matchDomains ^boolean [this ^ObjectName name]
    (let [useOptimized (and (identical? (.getClass this) ObjectName)
                            (identical? (.getClass name) ObjectName))]
      (cond
        (.isDomainPattern this)
          (if useOptimized
              (Util/wildmatch (.-_canonicalName name)
                              _canonicalName
                              0
                              (.getDomainLength name)
                              0
                              (.getDomainLength this))
              (Util/wildmatch (.getDomain name) (.getDomain this)))
        useOptimized
          (and (== (.getDomainLength this) (.getDomainLength name))
               (.regionMatches _canonicalName 0 (.-_canonicalName name) 0 (.getDomainLength this)))
        :else (.equals (.getDomain this) (.getDomain name)))))

  (method ^:private ^:final matchKeys ^boolean [this ^ObjectName name]
    (cond
      (and (and (.isPropertyValuePattern this) (not (.isPropertyListPattern this)))
           (not (== (alength (.-_ca_array name)) (alength _ca_array))))
        false
      (.isPropertyPattern this)
        (let [^:final ^{:tag (Map String String)} nameProps (._getKeyPropertyList name)
              ^:final props _ca_array
              ^:final cn _canonicalName]
          (loop [^int i (unchecked-subtract-int (alength props) 1)]
            (when (>= i 0)
              (let [^:final p (aget props i)
                    ^:final k (.getKeyString p cn)
                    ^:final v (cast String (.get nameProps k))]
                (when (nil? v) (return false))
                (when (and (.isPropertyValuePattern this) (instance? PatternProperty p))
                  (if (Util/wildmatch v (.getValueString p cn))
                      (continue (unchecked-dec-int i))
                      (return false)))
                (if (.equals v (.getValueString p cn)) (recur (unchecked-dec-int i)) (return false)))))
          true)
      :else
        (let [^:final p1 (.getCanonicalKeyPropertyListString name)
              ^:final p2 (.getCanonicalKeyPropertyListString this)]
          (.equals p1 p2))))

  (method ^:public setMBeanServer ^void [this ^MBeanServer mbs])

  (method ^:public compareTo ^int [this ^ObjectName name]
    (if (identical? name this)
        0
        (let [domainValue (.compareTo (.getDomain this) (.getDomain name))]
          (if (not (== domainValue 0))
              domainValue
              (let [^:mutable thisTypeKey (.getKeyProperty this "type")
                    ^:mutable anotherTypeKey (.getKeyProperty name "type")]
                (when (nil? thisTypeKey) (set! thisTypeKey ""))
                (when (nil? anotherTypeKey) (set! anotherTypeKey ""))
                (let [typeKeyValue (.compareTo thisTypeKey anotherTypeKey)]
                  (if (not (== typeKeyValue 0))
                      typeKeyValue
                      (.compareTo (.getCanonicalName this) (.getCanonicalName name))))))))))

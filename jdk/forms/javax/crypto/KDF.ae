                        (when (and (not skipDebug) (some? pdebug))
                          (.println pdebug
                                    (java-str "The provider "
                                              (.getName (.provider currOne))
                                              " is selected")))
                        (return result))
                      (catch Exception e
                        (when (and (not skipDebug) (some? pdebug))
                          (.println
                            pdebug
                            (java-str
                              "A "
                              (.getAlgorithm this)
                              " derivation cannot be performed using the supplied derivation inputs, using "
                              (.getName (.provider currOne))
                              ". Another Provider will be attempted."))
                          (.printStackTrace e (.getPrintStream pdebug)))
                        (when (nil? lastException) (set! lastException e))
                        (java-assert (some? serviceIterator) "serviceIterator was null")
                        (set! currOne (KDF/getNext serviceIterator kdfParameters)))))

  (method ^:private chooseProvider :throws [InvalidAlgorithmParameterException
                                            NoSuchAlgorithmException] [this ^String algorithm
                                                                       ^AlgorithmParameterSpec derivationSpec]
    (let [isDeriveData (nil? algorithm)]
      (locking lock
        (if (KDF/checkSpiNonNull theOne)
            (if isDeriveData
                ^Object (.engineDeriveData (.spi theOne) derivationSpec)
                ^Object (.engineDeriveKey (.spi theOne) algorithm derivationSpec))
            (let [^:mutable ^Exception lastException nil]
              (when-not (KDF/checkSpiNonNull candidate)
                (throw (AssertionError. "Unexpected Error: candidate is null!")))
              (let [^:mutable currOne candidate]
                (try
                  (while true
                    (try

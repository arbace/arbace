                  (.println
                    pdebug
                    (java-str
                      "A derivation cannot be performed using the supplied KDFParameters, using "
                      (.getName prov)
                      ". Another Provider will be attempted."))
                  (.printStackTrace nsae (.getPrintStream pdebug))))))))
      (when (and (not skipDebug) (some? pdebug))
        (.println pdebug
                  "No provider can be found that supports the specified algorithm and parameters"))
      (if hasOne
          (throw
            (InvalidAlgorithmParameterException.
              "The KDFParameters supplied could not be used in combination with the supplied algorithm for the selected Provider"))
          (throw (NoSuchAlgorithmException.
                   "No available provider supports the specified algorithm")))))


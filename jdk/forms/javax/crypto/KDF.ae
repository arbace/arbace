  (method ^:private ^:static getNext :throws [NoSuchAlgorithmException
                                              InvalidAlgorithmParameterException] ^Delegate [^{:tag (Iterator Provider$Service)} serviceIter
                                                                                             ^KDFParameters kdfParameters]
    (let [^:mutable hasOne false]
      (while (.hasNext serviceIter)
        (let [s (cast Provider$Service (.next serviceIter))
              prov (.getProvider s)]
          (when-not (not (JceSecurity/canUseProvider prov))
            (set! hasOne true)
            (try
              (let [obj (.newInstance s kdfParameters)]
                (if (not (instance? KDFSpi obj))
                    (when (and (not skipDebug) (some? pdebug))
                      (.println pdebug "obj was not an instance of KDFSpi (should not happen)"))
                    (return (Delegate. (cast KDFSpi obj) prov))))
              (catch NoSuchAlgorithmException nsae

      (let [cert (cast X509Certificate certificate)
            ^{:tag (Set String)} critSet (.getCriticalExtensionOIDs cert)]
        (when (and (and (some? critSet) (not (.isEmpty critSet)))
                   (.contains critSet (.value KnownOIDs/KeyUsage)))
          (let [keyUsageInfo (.getKeyUsage cert)]
            (when (and (some? keyUsageInfo)
                       (or (and (and (== opmode Cipher/ENCRYPT_MODE) (> (alength keyUsageInfo) 3))
                                (= (aget keyUsageInfo 3) false))
                           (and (and (== opmode Cipher/WRAP_MODE) (> (alength keyUsageInfo) 2))
                                (= (aget keyUsageInfo 2) false))))
              (throw (InvalidKeyException. "Wrong key usage")))))))
    (let [^PublicKey publicKey (when (some? certificate) (.getPublicKey certificate))]
      (if (some? spi)
          (do (.checkCryptoPerm this spi publicKey) (.engineInit spi opmode publicKey random))
          (try
            (.chooseProvider this I_CERT opmode publicKey nil nil random)
            (catch InvalidAlgorithmParameterException e (throw (InvalidKeyException. e)))))
      (set! initialized true)
      (set! (.-opmode this) opmode)
      (when (and (not skipDebug) (some? pdebug)) (.println pdebug (.toString this)))))

  (method ^:private checkCipherState ^void [this]
    (when-not (instance? NullCipher this)
      (when-not initialized (throw (IllegalStateException. "Cipher not initialized")))
      (when (and (not (== opmode Cipher/ENCRYPT_MODE)) (not (== opmode Cipher/DECRYPT_MODE)))
        (throw (IllegalStateException. "Cipher not initialized for encryption/decryption")))))

  (method ^:public ^:final update ^byte/1 [this ^byte/1 input]
    (.checkCipherState this)
    (when (nil? input) (throw (IllegalArgumentException. "Null input buffer")))
    (.chooseFirstProvider this)
    (when-not (== (alength input) 0) (.engineUpdate spi input 0 (alength input))))

  (method ^:public ^:final update ^byte/1 [this ^byte/1 input ^int inputOffset ^int inputLen]
    (.checkCipherState this)
    (when (or (or (or (nil? input) (< inputOffset 0))
                  (> inputLen (unchecked-subtract-int (alength input) inputOffset)))
              (< inputLen 0))
      (throw (IllegalArgumentException. "Bad arguments")))
    (.chooseFirstProvider this)
    (when-not (== inputLen 0) (.engineUpdate spi input inputOffset inputLen)))

  (method ^:public ^:final update :throws [ShortBufferException] ^int [this ^byte/1 input
                                                                       ^int inputOffset
                                                                       ^int inputLen ^byte/1 output]
    (.checkCipherState this)
    (when (or (or (or (nil? input) (< inputOffset 0))
                  (> inputLen (unchecked-subtract-int (alength input) inputOffset)))
              (< inputLen 0))
      (throw (IllegalArgumentException. "Bad arguments")))
    (.chooseFirstProvider this)
    (if (== inputLen 0) 0 (.engineUpdate spi input inputOffset inputLen output 0)))

  (method ^:public ^:final update :throws [ShortBufferException] ^int [this ^byte/1 input
                                                                       ^int inputOffset
                                                                       ^int inputLen ^byte/1 output
                                                                       ^int outputOffset]
    (.checkCipherState this)
    (when (or (or (or (or (nil? input) (< inputOffset 0))
                      (> inputLen (unchecked-subtract-int (alength input) inputOffset)))
                  (< inputLen 0))
              (< outputOffset 0))
      (throw (IllegalArgumentException. "Bad arguments")))
    (.chooseFirstProvider this)
    (if (== inputLen 0) 0 (.engineUpdate spi input inputOffset inputLen output outputOffset)))

  (method ^:public ^:final update :throws [ShortBufferException] ^int [this ^ByteBuffer input
                                                                       ^ByteBuffer output]
    (.checkCipherState this)
    (when (or (nil? input) (nil? output))
      (throw (IllegalArgumentException. "Buffers must not be null")))
    (when (identical? input output)
      (throw
        (IllegalArgumentException.
          "Input and output buffers must not be the same object, consider using buffer.duplicate()")))
    (when (.isReadOnly output) (throw (ReadOnlyBufferException.)))
    (.chooseFirstProvider this)
    (.engineUpdate spi input output))

  (method ^:public ^:final doFinal :throws [IllegalBlockSizeException BadPaddingException] ^byte/1 [this]
    (.checkCipherState this)
    (.chooseFirstProvider this)
    (.engineDoFinal spi nil 0 0))

  (method ^:public ^:final doFinal :throws [IllegalBlockSizeException
                                            ShortBufferException
                                            BadPaddingException] ^int [this ^byte/1 output
                                                                       ^int outputOffset]
    (.checkCipherState this)
    (when (or (nil? output) (< outputOffset 0)) (throw (IllegalArgumentException. "Bad arguments")))
    (.chooseFirstProvider this)
    (.engineDoFinal spi nil 0 0 output outputOffset))

  (method ^:public ^:final doFinal :throws [IllegalBlockSizeException BadPaddingException] ^byte/1 [this
                                                                                                    ^byte/1 input]
    (.checkCipherState this)
    (when (nil? input) (throw (IllegalArgumentException. "Null input buffer")))
    (.chooseFirstProvider this)
    (.engineDoFinal spi input 0 (alength input)))

  (method ^:public ^:final doFinal :throws [IllegalBlockSizeException BadPaddingException] ^byte/1 [this
                                                                                                    ^byte/1 input
                                                                                                    ^int inputOffset
                                                                                                    ^int inputLen]
    (.checkCipherState this)
    (when (or (or (or (nil? input) (< inputOffset 0))
                  (> inputLen (unchecked-subtract-int (alength input) inputOffset)))
              (< inputLen 0))
      (throw (IllegalArgumentException. "Bad arguments")))
    (.chooseFirstProvider this)
    (.engineDoFinal spi input inputOffset inputLen))

  (method ^:public ^:final doFinal :throws [ShortBufferException
                                            IllegalBlockSizeException
                                            BadPaddingException] ^int [this ^byte/1 input
                                                                       ^int inputOffset
                                                                       ^int inputLen ^byte/1 output]
    (.checkCipherState this)
    (when (or (or (or (nil? input) (< inputOffset 0))
                  (> inputLen (unchecked-subtract-int (alength input) inputOffset)))
              (< inputLen 0))
      (throw (IllegalArgumentException. "Bad arguments")))
    (.chooseFirstProvider this)
    (.engineDoFinal spi input inputOffset inputLen output 0))

  (method ^:public ^:final doFinal :throws [ShortBufferException
                                            IllegalBlockSizeException
                                            BadPaddingException] ^int [this ^byte/1 input
                                                                       ^int inputOffset
                                                                       ^int inputLen ^byte/1 output
                                                                       ^int outputOffset]
    (.checkCipherState this)
    (when (or (or (or (or (nil? input) (< inputOffset 0))
                      (> inputLen (unchecked-subtract-int (alength input) inputOffset)))
                  (< inputLen 0))
              (< outputOffset 0))
      (throw (IllegalArgumentException. "Bad arguments")))
    (.chooseFirstProvider this)
    (.engineDoFinal spi input inputOffset inputLen output outputOffset))

  (method ^:public ^:final doFinal :throws [ShortBufferException
                                            IllegalBlockSizeException
                                            BadPaddingException] ^int [this ^ByteBuffer input
                                                                       ^ByteBuffer output]
    (.checkCipherState this)
    (when (or (nil? input) (nil? output))
      (throw (IllegalArgumentException. "Buffers must not be null")))
    (when (identical? input output)
      (throw
        (IllegalArgumentException.
          "Input and output buffers must not be the same object, consider using buffer.duplicate()")))
    (when (.isReadOnly output) (throw (ReadOnlyBufferException.)))
    (.chooseFirstProvider this)
    (.engineDoFinal spi input output))

  (method ^:public ^:final wrap :throws [IllegalBlockSizeException InvalidKeyException] ^byte/1 [this
                                                                                                 ^Key key]
    (when-not (instance? NullCipher this)
      (when-not initialized (throw (IllegalStateException. "Cipher not initialized")))
      (when-not (== opmode Cipher/WRAP_MODE)
        (throw (IllegalStateException. "Cipher not initialized for wrapping keys"))))
    (.chooseFirstProvider this)
    (.engineWrap spi key))

  (method ^:public ^:final unwrap :throws [InvalidKeyException NoSuchAlgorithmException] ^Key [this
                                                                                               ^byte/1 wrappedKey
                                                                                               ^String wrappedKeyAlgorithm
                                                                                               ^int wrappedKeyType]
    (when-not (instance? NullCipher this)
      (when-not initialized (throw (IllegalStateException. "Cipher not initialized")))
      (when-not (== opmode Cipher/UNWRAP_MODE)
        (throw (IllegalStateException. "Cipher not initialized for unwrapping keys"))))
    (when (and (and (not (== wrappedKeyType SECRET_KEY)) (not (== wrappedKeyType PRIVATE_KEY)))
               (not (== wrappedKeyType PUBLIC_KEY)))
      (throw (InvalidParameterException. "Invalid key type")))
    (.chooseFirstProvider this)
    (.engineUnwrap spi wrappedKey wrappedKeyAlgorithm wrappedKeyType))

  (method ^:private getAlgorithmParameterSpec :throws [InvalidParameterSpecException] ^AlgorithmParameterSpec [this
                                                                                                               ^AlgorithmParameters params]
    (when (some? params)
      (let [alg (.toUpperCase (.getAlgorithm params) Locale/ENGLISH)]
        (cond
          (.equalsIgnoreCase alg "RC2") (.getParameterSpec params RC2ParameterSpec)
          (.equalsIgnoreCase alg "RC5") (.getParameterSpec params RC5ParameterSpec)
          (.startsWith alg "PBE") (.getParameterSpec params PBEParameterSpec)
          (.startsWith alg "DES") (.getParameterSpec params IvParameterSpec)))))

  (method ^:private ^:static getConfiguredPermission :throws [NullPointerException
                                                              NoSuchAlgorithmException] ^CryptoPermission [^String transformation]
    (when (nil? transformation) (throw (NullPointerException.)))
    (let [parts (Cipher/tokenizeTransformation transformation)]
      (.getCryptoPermission JceSecurityManager/INSTANCE (aget parts 0))))

  (method ^:public ^:static ^:final getMaxAllowedKeyLength :throws [NoSuchAlgorithmException] ^int [^String transformation]
    (let [cp (Cipher/getConfiguredPermission transformation)] (.getMaxKeySize cp)))

  (method ^:public ^:static ^:final getMaxAllowedParameterSpec :throws [NoSuchAlgorithmException] ^AlgorithmParameterSpec [^String transformation]
    (let [cp (Cipher/getConfiguredPermission transformation)] (.getAlgorithmParameterSpec cp)))

  (method ^:public ^:final updateAAD ^void [this ^byte/1 src]
    (when (nil? src) (throw (IllegalArgumentException. "src buffer is null")))
    (.updateAAD this src 0 (alength src)))

  (method ^:public ^:final updateAAD ^void [this ^byte/1 src ^int offset ^int len]
    (.checkCipherState this)
    (when (or (or (or (nil? src) (< offset 0)) (< len 0))
              (> len (unchecked-subtract-int (alength src) offset)))
      (throw (IllegalArgumentException. "Bad arguments")))
    (.chooseFirstProvider this)
    (when-not (== len 0) (.engineUpdateAAD spi src offset len)))

  (method ^:public ^:final updateAAD ^void [this ^ByteBuffer src]
    (.checkCipherState this)
    (when (nil? src) (throw (IllegalArgumentException. "src ByteBuffer is null")))
    (.chooseFirstProvider this)
    (when-not (== (.remaining src) 0) (.engineUpdateAAD spi src)))

  (method ^:public toString ^String [this]
    (let [sb (StringBuilder.)]
      (.append (.append (.append sb "Cipher.") transformation) ", mode: ")
      (switch opmode
        0 (.append sb "not initialized")
        ENCRYPT_MODE (.append sb "encryption")
        DECRYPT_MODE (.append sb "decryption")
        WRAP_MODE (.append sb "key wrapping")
        UNWRAP_MODE (.append sb "key unwrapping")
        (.append (.append sb "error:") opmode))
      (.append (.append sb ", algorithm from: ") (.getProviderName this))
      (.toString sb))))

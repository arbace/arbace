    (let [cCount (.count (.filter (.chars requestedTemplate)
                                  (lambda IntPredicate ^boolean [^int c] (== c \C))))]
      (.replaceFirst (.replaceAll requestedTemplate "j" jPattern)
                     "C+"
                     (.replaceAll CPattern "([hkHK])" (.repeat "$1" (unchecked-int cCount))))))


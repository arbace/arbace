                ^{:tag (Map String String)} typeMap (HashMap.)]
            (when (.containsKey r inputRegionsKey)
              (let [m (.matcher p (.getString r inputRegionsKey))]
                (while (.find m)
                  (for-each [^String region (.split (.group m 2) " ")]
                    (.put typeMap region (.group m 1))))))
            (.put skeletons type typeMap)))
        (set! inputSkeletons skeletons)))
    (when (nil? jPattern)
      (set! jPattern (.resolveInputSkeleton this "preferred"))
      (set! CPattern (.resolveInputSkeleton this "allowed"))
      (when (== (.length CPattern) 2)
        (let [ba (new byte/1 2)]
          (aset ba 0 (unchecked-byte (.charAt CPattern 1)))
          (aset ba 1 (unchecked-byte (.charAt CPattern 0)))
          (set! CPattern (String. ba))))))


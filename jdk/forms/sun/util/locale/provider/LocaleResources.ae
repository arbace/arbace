              1 (List/of skeleton o1 o2 o3 o4 s1 s2 s3 s4)
              2 (List/of skeleton o2 o1 o3 o4 s2 s1 s3 s4)
              3 (List/of skeleton o3 o4 o2 o1 s3 s4 s2 s1)
              (List/of skeleton o4 o3 o2 o1 s4 s3 s2 s1)))
          (List/of skeleton))))


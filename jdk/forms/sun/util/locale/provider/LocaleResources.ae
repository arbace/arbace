                o2 (java-str prefix (.repeat pChar 2) suffix)
                o3 (java-str prefix (.repeat pChar 3) suffix)
                o4 (java-str prefix (.repeat pChar 4) suffix)
                s1 (java-str prefix subChar suffix)
                s2 (java-str prefix (.repeat subChar 2) suffix)
                s3 (java-str prefix (.repeat subChar 3) suffix)
                s4 (java-str prefix (.repeat subChar 4) suffix)]

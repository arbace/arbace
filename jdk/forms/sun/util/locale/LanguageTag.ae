              (let [var (.current varitr)]
                (when-not (LanguageTag/isVariant var) (break))
                (when (nil? variants) (set! variants (ArrayList.)))
                (.add variants var)
                (.next varitr)))
            (when (some? variants) (set! hasSubtag true))
            (when-not (.isDone varitr)
              (let [sj (StringJoiner. SEP)]
                (while (not (.isDone varitr))
                  (let [prvv (.current varitr)]
                    (when-not (LanguageTag/isPrivateuseSubtag prvv) (break))
                    (.add sj prvv)
                    (.next varitr)))
                (when (> (.length sj) 0) (set! privuseVar (.toString sj)))))))
        (let [^:mutable ^{:tag (List String)} extensions nil
              ^:mutable ^String privateuse nil]
          (when (some? localeExtensions)
            (let [^{:tag (Set Character)} locextKeys (.getKeys localeExtensions)]
              (for-each [^Character locextKey locextKeys]
                (let [ext (.getExtension localeExtensions locextKey)]
                  (if (LanguageTag/isPrivateusePrefixChar locextKey)
                      (set! privateuse (.getValue ext))
                      (do

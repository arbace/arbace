  (method ^:public ^:static parseLocale ^LanguageTag [^BaseLocale baseLocale
                                                      ^LocaleExtensions localeExtensions]
    (let [^:mutable language EMPTY_SUBTAG
          ^:mutable script EMPTY_SUBTAG
          ^:mutable region EMPTY_SUBTAG
          ^:mutable baseLanguage (.getLanguage baseLocale)
          baseScript (.getScript baseLocale)
          baseRegion (.getRegion baseLocale)
          ^:mutable baseVariant (.getVariant baseLocale)
          ^:mutable hasSubtag false
          ^:mutable ^String privuseVar nil]
      (when (LanguageTag/isLanguage baseLanguage)
        (set! baseLanguage (switch baseLanguage "iw" "he" "ji" "yi" "in" "id" baseLanguage))
        (set! language baseLanguage))
      (when (LanguageTag/isScript baseScript)
        (set! script (LanguageTag/canonicalizeScript baseScript))
        (set! hasSubtag true))
      (when (LanguageTag/isRegion baseRegion)
        (set! region (LanguageTag/canonicalizeRegion baseRegion))
        (set! hasSubtag true))
      (when (and (and (.equals language "no") (.equals region "NO")) (.equals baseVariant "NY"))
        (set! language "nn")
        (set! baseVariant EMPTY_SUBTAG))
      (let [^:mutable ^{:tag (List String)} variants nil]
        (when-not (.isEmpty baseVariant)
          (let [varitr (StringTokenIterator. baseVariant BaseLocale/SEP)]

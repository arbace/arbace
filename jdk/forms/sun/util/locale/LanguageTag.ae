          (set! variants (if (nil? variants) EMPTY_SUBTAGS (Collections/unmodifiableList variants)))
          (LanguageTag. language script region privateuse EMPTY_SUBTAGS variants extensions)))))

  (method ^:private ^:static legacyToPreferred ^String [^String tag]
    (when-not (< (.length tag) 5)
      (switch tag
        "art-lojban" "jbo"
        "cel-gaulish" "xtg-x-cel-gaulish"
        "en-gb-oed" "en-GB-x-oed"
        "i-ami" "ami"
        "i-bnn" "bnn"
        "i-default" "en-x-i-default"
        "i-enochian" "und-x-i-enochian"
        ("i-hak" "zh-hakka") "hak"
        "i-klingon" "tlh"
        "i-lux" "lb"
        "i-mingo" "see-x-i-mingo"
        "i-navajo" "nv"
        "i-pwn" "pwn"
        "i-tao" "tao"
        "i-tay" "tay"
        "i-tsu" "tsu"
        "no-bok" "nb"
        "no-nyn" "nn"
        "sgn-be-fr" "sfb"
        "sgn-be-nl" "vgt"
        "sgn-ch-de" "sgg"
        "zh-guoyu" "cmn"
        "zh-min" "nan-x-zh-min"
        "zh-min-nan" "nan"
        "zh-xiang" "hsn"
        nil)))

  (method ^:public ^:static isLanguage ^boolean [^String s]
    (let [len (.length s)] (and (and (>= len 2) (<= len 8)) (LocaleUtils/isAlphaString s))))

  (method ^:public ^:static isExtlang ^boolean [^String s]
    (and (== (.length s) 3) (LocaleUtils/isAlphaString s)))

  (method ^:public ^:static isScript ^boolean [^String s]
    (and (== (.length s) 4) (LocaleUtils/isAlphaString s)))

  (method ^:public ^:static isRegion ^boolean [^String s]
    (or (and (== (.length s) 2) (LocaleUtils/isAlphaString s))
        (and (== (.length s) 3) (LocaleUtils/isNumericString s))))

  (method ^:public ^:static isVariant ^boolean [^String s]
    (let [len (.length s)]
      (cond
        (and (>= len 5) (<= len 8)) (LocaleUtils/isAlphaNumericString s)
        (== len 4)
          (and (and (and (LocaleUtils/isNumeric (.charAt s 0))
                         (LocaleUtils/isAlphaNumeric (.charAt s 1)))
                    (LocaleUtils/isAlphaNumeric (.charAt s 2)))
               (LocaleUtils/isAlphaNumeric (.charAt s 3)))
        :else false)))

  (method ^:public ^:static isExtensionSingleton ^boolean [^String s]
    (and (and (== (.length s) 1) (LocaleUtils/isAlphaString s))
         (not (LocaleUtils/caseIgnoreMatch PRIVATEUSE s))))

  (method ^:public ^:static isExtensionSingletonChar ^boolean [^char c]
    (LanguageTag/isExtensionSingleton (String/valueOf c)))

  (method ^:public ^:static isExtensionSubtag ^boolean [^String s]
    (let [len (.length s)] (and (and (>= len 2) (<= len 8)) (LocaleUtils/isAlphaNumericString s))))

  (method ^:public ^:static isPrivateusePrefix ^boolean [^String s]
    (and (== (.length s) 1) (LocaleUtils/caseIgnoreMatch PRIVATEUSE s)))

  (method ^:public ^:static isPrivateusePrefixChar ^boolean [^char c]
    (LocaleUtils/caseIgnoreMatch PRIVATEUSE (String/valueOf c)))

  (method ^:public ^:static isPrivateuseSubtag ^boolean [^String s]
    (let [len (.length s)] (and (and (>= len 1) (<= len 8)) (LocaleUtils/isAlphaNumericString s))))

  (method ^:public ^:static canonicalizeLanguage ^String [^String s]
    (LocaleUtils/toLowerString s))

  (method ^:public ^:static canonicalizeExtlang ^String [^String s]
    (LocaleUtils/toLowerString s))

  (method ^:public ^:static canonicalizeScript ^String [^String s]
    (LocaleUtils/toTitleString s))

  (method ^:public ^:static canonicalizeRegion ^String [^String s]
    (LocaleUtils/toUpperString s))

  (method ^:public ^:static canonicalizeVariant ^String [^String s]
    (LocaleUtils/toLowerString s))

  (method ^:public ^:static canonicalizeExtension ^String [^String s]
    (LocaleUtils/toLowerString s))

  (method ^:public ^:static canonicalizeExtensionSingleton ^String [^String s]
    (LocaleUtils/toLowerString s))

  (method ^:public ^:static canonicalizeExtensionSubtag ^String [^String s]
    (LocaleUtils/toLowerString s))

  (method ^:public ^:static canonicalizePrivateuse ^String [^String s]
    (LocaleUtils/toLowerString s))

  (method ^:public ^:static canonicalizePrivateuseSubtag ^String [^String s]
    (LocaleUtils/toLowerString s))

  (method ^:public toString ^String [this]
    (let [sb (StringBuilder.)]
      (when-not (.isEmpty language)
        (.append sb language)
        (for-each [^String extlang extlangs] (.append (.append sb SEP) extlang))
        (when-not (.isEmpty script) (.append (.append sb SEP) script))
        (when-not (.isEmpty region) (.append (.append sb SEP) region))
        (for-each [^String variant variants] (.append (.append sb SEP) variant))
        (for-each [^String extension extensions] (.append (.append sb SEP) extension)))
      (when-not (.isEmpty privateuse)
        (when (> (.length sb) 0) (.append sb SEP))
        (.append sb privateuse))
      (.toString sb))))

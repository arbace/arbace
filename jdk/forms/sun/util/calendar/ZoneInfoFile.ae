                                     (unchecked-add
                                       (unchecked-multiply 365 yearEst)
                                       (unchecked-divide yearEst 4))
                                     (unchecked-divide yearEst 100))
                                   (unchecked-divide yearEst 400)))]
          (when (< doyEst 0)
            (set! yearEst (unchecked-dec yearEst))
            (set! doyEst
                  (unchecked-subtract zeroDay
                                      (unchecked-add
                                        (unchecked-subtract
                                          (unchecked-add
                                            (unchecked-multiply 365 yearEst)
                                            (unchecked-divide yearEst 4))
                                          (unchecked-divide yearEst 100))
                                        (unchecked-divide yearEst 400)))))
          (set! yearEst (unchecked-add yearEst adjust))
          (let [marchDoy0 (unchecked-int doyEst)
                marchMonth0 (unchecked-divide-int
                              (unchecked-add-int (unchecked-multiply-int marchDoy0 5) 2)
                              153)]
            (set! yearEst (unchecked-add yearEst (unchecked-divide-int marchMonth0 10)))
            (unchecked-int yearEst))))))

  (field ^:private ^:static ^:final ^int/1 toCalendarDOW
    (new int/1
         [-1
          Calendar/MONDAY
          Calendar/TUESDAY
          Calendar/WEDNESDAY
          Calendar/THURSDAY
          Calendar/FRIDAY
          Calendar/SATURDAY
          Calendar/SUNDAY]))

  (field ^:private ^:static ^:final ^int/1 toSTZTime
    (new int/1 [SimpleTimeZone/UTC_TIME SimpleTimeZone/WALL_TIME SimpleTimeZone/STANDARD_TIME]))

  (field ^:private ^:static ^:final ^long OFFSET_MASK 0x0f)

  (field ^:private ^:static ^:final ^long DST_MASK 0xf0)

  (field ^:private ^:static ^:final ^int DST_NSHIFT 4)

  (field ^:private ^:static ^:final ^int TRANSITION_NSHIFT 12)

  (field ^:private ^:static ^:final ^int LASTYEAR 2100)

  (method ^:private ^:static indexOf ^int [^int/1 offsets ^:mutable ^int from ^int nOffsets
                                           ^:mutable ^int offset]
    (set! offset (unchecked-multiply-int offset 1000))
    (while (< from nOffsets)
      (when (== (aget offsets from) offset) (return from))
      (set! from (unchecked-inc-int from)))
    (aset offsets from offset)
    from)

  (method ^:private ^:static addTrans ^int [^long/1 transitions ^int nTrans ^int/1 offsets
                                            ^:mutable ^int nOffsets ^long trans ^int offset
                                            ^int stdOffset]
    (let [offsetIndex (ZoneInfoFile/indexOf offsets 0 nOffsets offset)]
      (when (== offsetIndex nOffsets) (set! nOffsets (unchecked-inc-int nOffsets)))
      (let [^:mutable ^int dstIndex 0]
        (when-not (== offset stdOffset)
          (set! dstIndex
                (ZoneInfoFile/indexOf offsets 1 nOffsets (unchecked-subtract-int offset stdOffset)))
          (when (== dstIndex nOffsets) (set! nOffsets (unchecked-inc-int nOffsets))))
        (aset transitions
              nTrans
              (bit-or (bit-or (bit-shift-left (unchecked-multiply trans 1000) TRANSITION_NSHIFT)
                              (bit-and (bit-shift-left-int dstIndex DST_NSHIFT) DST_MASK))
                      (bit-and offsetIndex OFFSET_MASK)))
        nOffsets)))

  (defclass ^:private ^:static Checksum
    :extends CRC32

    (method ^:public update ^void [this ^int val]
      (let [b (new byte/1 4)]
        (aset b 0 (unchecked-byte (unsigned-bit-shift-right-int val 24)))
        (aset b 1 (unchecked-byte (unsigned-bit-shift-right-int val 16)))
        (aset b 2 (unchecked-byte (unsigned-bit-shift-right-int val 8)))
        (aset b 3 (unchecked-byte val))
        (.update this b)))

    (method update ^void [this ^long val]
      (let [b (new byte/1 8)]
        (aset b 0 (unchecked-byte (unsigned-bit-shift-right val 56)))
        (aset b 1 (unchecked-byte (unsigned-bit-shift-right val 48)))
        (aset b 2 (unchecked-byte (unsigned-bit-shift-right val 40)))
        (aset b 3 (unchecked-byte (unsigned-bit-shift-right val 32)))
        (aset b 4 (unchecked-byte (unsigned-bit-shift-right val 24)))
        (aset b 5 (unchecked-byte (unsigned-bit-shift-right val 16)))
        (aset b 6 (unchecked-byte (unsigned-bit-shift-right val 8)))
        (aset b 7 (unchecked-byte val))
        (.update this b))))

  (defclass ^:private ^:static ZoneOffsetTransitionRule
    (field ^:private ^:final ^int month)

    (field ^:private ^:final ^byte dom)

    (field ^:private ^:final ^int dow)

    (field ^:private ^:final ^int secondOfDay)

    (field ^:private ^:final ^int timeDefinition)

    (field ^:private ^:final ^int standardOffset)

    (field ^:private ^:final ^int offsetBefore)

    (field ^:private ^:final ^int offsetAfter)

    (constructor :throws [IOException] [this ^DataInput in]
      (let [data (.readInt in)
            dowByte (unsigned-bit-shift-right-int (bit-and-int data (bit-shift-left-int 7 19)) 19)
            timeByte (unsigned-bit-shift-right-int (bit-and-int data (bit-shift-left-int 31 14)) 14)
            stdByte (unsigned-bit-shift-right-int (bit-and-int data (bit-shift-left-int 255 4)) 4)
            beforeByte (unsigned-bit-shift-right-int (bit-and-int data (bit-shift-left-int 3 2)) 2)
            afterByte (bit-and-int data 3)]
        (set! (.-month this) (unsigned-bit-shift-right-int data 28))
        (set! (.-dom this)
              (unchecked-byte
                (unchecked-subtract-int
                  (unsigned-bit-shift-right-int (bit-and-int data (bit-shift-left-int 63 22)) 22)
                  32)))
        (set! (.-dow this) (if (== dowByte 0) -1 dowByte))
        (set! (.-secondOfDay this)
              (if (== timeByte 31) (.readInt in) (unchecked-multiply-int timeByte 3600)))
        (set! (.-timeDefinition this)
              (unsigned-bit-shift-right-int (bit-and-int data (bit-shift-left-int 3 12)) 12))
        (set! (.-standardOffset this)
              (if (== stdByte 255)
                  (.readInt in)
                  (unchecked-multiply-int (unchecked-subtract-int stdByte 128) 900)))
        (set! (.-offsetBefore this)
              (if (== beforeByte 3)
                  (.readInt in)
                  (unchecked-add-int standardOffset (unchecked-multiply-int beforeByte 1800))))
        (set! (.-offsetAfter this)
              (if (== afterByte 3)
                  (.readInt in)
                  (unchecked-add-int standardOffset (unchecked-multiply-int afterByte 1800))))))

    (method getTransitionEpochSecond ^long [this ^int year]
      (let [^:mutable epochDay 0]
        (if (< dom 0)
            (do
              (set! epochDay
                    (ZoneOffsetTransitionRule/toEpochDay
                      year
                      month
                      (unchecked-add-int
                        (unchecked-add-int (ZoneOffsetTransitionRule/lengthOfMonth year month) 1)
                        dom)))
              (when-not (== dow -1)
                (set! epochDay (ZoneOffsetTransitionRule/previousOrSame epochDay dow))))
            (do
              (set! epochDay (ZoneOffsetTransitionRule/toEpochDay year month dom))
              (when-not (== dow -1)
                (set! epochDay (ZoneOffsetTransitionRule/nextOrSame epochDay dow)))))
        (let [^:mutable ^int difference 0]
          (switch timeDefinition
            0 (set! difference 0)
            1 (set! difference (unchecked-negate-int offsetBefore))
            2 (set! difference (unchecked-negate-int standardOffset)))
          (unchecked-add (unchecked-add (unchecked-multiply epochDay 86400) secondOfDay) difference))))

    (method ^:static ^:final isLeapYear ^boolean [^int year]
      (CalendarUtils/isGregorianLeapYear year))

    (method ^:static ^:final lengthOfMonth ^int [^int year ^int month]
      (switch month 2 (if (ZoneOffsetTransitionRule/isLeapYear year) 29 28) (4 6 9 11) 30 31))

    (method ^:static ^:final toEpochDay ^long [^int year ^int month ^int day]
      (let [^long y year
            ^long m month
            ^:mutable total 0]
        (set! total (unchecked-add total (unchecked-multiply 365 y)))
        (if (>= y 0)
            (set! total
                  (unchecked-add total
                                 (unchecked-add
                                   (unchecked-subtract
                                     (unchecked-divide (unchecked-add y 3) 4)
                                     (unchecked-divide (unchecked-add y 99) 100))
                                   (unchecked-divide (unchecked-add y 399) 400))))
            (set! total
                  (unchecked-subtract total
                                      (unchecked-add
                                        (unchecked-subtract
                                          (unchecked-divide y -4)
                                          (unchecked-divide y -100))
                                        (unchecked-divide y -400)))))
        (set! total
              (unchecked-add total
                             (unchecked-divide (unchecked-subtract (unchecked-multiply 367 m) 362)
                                               12)))
        (set! total (unchecked-add total (unchecked-subtract-int day 1)))
        (when (> m 2)
          (set! total (unchecked-dec total))
          (when-not (ZoneOffsetTransitionRule/isLeapYear year) (set! total (unchecked-dec total))))
        (unchecked-subtract total DAYS_0000_TO_1970)))

    (method ^:static ^:final previousOrSame ^long [^long epochDay ^int dayOfWeek]
      (ZoneOffsetTransitionRule/adjust epochDay dayOfWeek 1))

    (method ^:static ^:final nextOrSame ^long [^long epochDay ^int dayOfWeek]
      (ZoneOffsetTransitionRule/adjust epochDay dayOfWeek 0))

    (method ^:static ^:final adjust ^long [^long epochDay ^int dow ^int relative]
      (let [calDow (unchecked-add-int (unchecked-int (Math/floorMod (unchecked-add epochDay 3) 7))
                                      1)]
        (cond
          (and (< relative 2) (== calDow dow)) epochDay
          (== (bit-and-int relative 1) 0)
            (let [daysDiff (unchecked-subtract-int calDow dow)]
              (unchecked-add epochDay
                             (if (>= daysDiff 0)
                                 (unchecked-subtract-int 7 daysDiff)
                                 (unchecked-negate-int daysDiff))))
          :else
            (let [daysDiff (unchecked-subtract-int dow calDow)]
              (unchecked-subtract epochDay
                                  (if (>= daysDiff 0)
                                      (unchecked-subtract-int 7 daysDiff)
                                      (unchecked-negate-int daysDiff)))))))))

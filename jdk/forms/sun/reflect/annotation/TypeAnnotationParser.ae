        (TypeAnnotationParser/buildAnnotatedTypes
          rawAnnotations
          cp
          decl
          decl
          (.getGenericInterfaces decl)
          TypeAnnotation$TypeAnnotationTarget/CLASS_IMPLEMENTS)))

  (method ^:public ^:static parseTypeVariableAnnotations :type-params [(D
                                                                         extends
                                                                         GenericDeclaration)] ^Annotation/1 [^D genericDecl
                                                                                                             ^int typeVarIndex]
    (let [^:mutable ^AnnotatedElement decl nil
          ^:mutable ^TypeAnnotation$TypeAnnotationTarget predicate nil]
      (if-instance [^{:tag (Class ?)} classDecl genericDecl]
        (do
          (set! decl classDecl)
          (set! predicate TypeAnnotation$TypeAnnotationTarget/CLASS_TYPE_PARAMETER))
        (if-instance [^Executable execDecl genericDecl]
          (do
            (set! decl execDecl)
            (set! predicate TypeAnnotation$TypeAnnotationTarget/METHOD_TYPE_PARAMETER))
          (throw
            (AssertionError.
              (java-str "Unknown GenericDeclaration " genericDecl "\nthis should not happen.")))))
      (let [^{:tag (List TypeAnnotation)} typeVarAnnos (TypeAnnotation/filter
                                                         (TypeAnnotationParser/parseAllTypeAnnotations
                                                           decl)
                                                         predicate)
            ^{:tag (List Annotation)} res (ArrayList. (.size typeVarAnnos))]
        (for-each [^TypeAnnotation t typeVarAnnos]
          (when (== (.getCount (.getTargetInfo t)) typeVarIndex) (.add res (.getAnnotation t))))
        (cast Annotation/1 (.toArray res (new Annotation/1 0))))))


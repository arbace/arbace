  (method ^:private ^:static parseTypeAnnotations ^TypeAnnotation/1 [^byte/1 rawAnnotations
                                                                     ^ConstantPool cp
                                                                     ^AnnotatedElement baseDecl
                                                                     ^{:tag (Class ?)} container]
    (if (nil? rawAnnotations)
        EMPTY_TYPE_ANNOTATION_ARRAY

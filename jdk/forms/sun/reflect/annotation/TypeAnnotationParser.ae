                  (when (.isInterface c) (set! startIndex 1))
                  (when-instance [^ParameterizedType p b0]
                    (let [^{:tag (Class ?)} c (cast Class (.getRawType p))]
                      (when (.isInterface c) (set! startIndex 1)))))))
            (loop [^int i 0]

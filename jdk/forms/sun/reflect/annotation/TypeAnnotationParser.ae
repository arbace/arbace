  (method ^:static mapTypeAnnotations ^{:tag (Map (Class (? extends Annotation)) Annotation)} [^TypeAnnotation/1 typeAnnos]
    (let [^{:tag (Map (Class (? extends Annotation)) Annotation)} result (LinkedHashMap.)]
      (for-each [^TypeAnnotation t typeAnnos]
        (let [a (.getAnnotation t)]

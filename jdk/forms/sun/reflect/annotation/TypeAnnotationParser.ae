  (method ^:private ^:static parseAnnotatedBounds :type-params [(D extends GenericDeclaration)] ^AnnotatedType/1 [^Type/1 bounds
                                                                                                                  ^D decl
                                                                                                                  ^int typeVarIndex
                                                                                                                  ^TypeAnnotation$LocationInfo loc]
    (let [^{:tag (List TypeAnnotation)} candidates (TypeAnnotationParser/fetchBounds decl)]

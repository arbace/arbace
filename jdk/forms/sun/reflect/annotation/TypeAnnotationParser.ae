      (let [typeAnnotations (cast TypeAnnotation/1 (.toArray l EMPTY_TYPE_ANNOTATION_ARRAY))]
        (AnnotatedTypeFactory/buildAnnotatedType
          type
          (AnnotatedTypeFactory/nestingForType type TypeAnnotation$LocationInfo/BASE_LOCATION)
          typeAnnotations
          typeAnnotations))))


                  (return res))))
        CLASS_TYPE_PARAMETER_BOUND
          (return (TypeAnnotationParser/parse2ByteTarget
                    TypeAnnotation$TypeAnnotationTarget/CLASS_TYPE_PARAMETER_BOUND
                    buf))
        METHOD_TYPE_PARAMETER_BOUND
          (return (TypeAnnotationParser/parse2ByteTarget
                    TypeAnnotation$TypeAnnotationTarget/METHOD_TYPE_PARAMETER_BOUND
                    buf))
        FIELD
          (return (TypeAnnotation$TypeAnnotationTargetInfo.
                    TypeAnnotation$TypeAnnotationTarget/FIELD))
        METHOD_RETURN
          (return (TypeAnnotation$TypeAnnotationTargetInfo.
                    TypeAnnotation$TypeAnnotationTarget/METHOD_RETURN))
        METHOD_RECEIVER
          (return (TypeAnnotation$TypeAnnotationTargetInfo.
                    TypeAnnotation$TypeAnnotationTarget/METHOD_RECEIVER))
        METHOD_FORMAL_PARAMETER
          (let [index (bit-and-int (.get buf) 0xFF)]
            (return (TypeAnnotation$TypeAnnotationTargetInfo.
                      TypeAnnotation$TypeAnnotationTarget/METHOD_FORMAL_PARAMETER
                      index)))
        THROWS
          (return (TypeAnnotationParser/parseShortTarget
                    TypeAnnotation$TypeAnnotationTarget/THROWS
                    buf))

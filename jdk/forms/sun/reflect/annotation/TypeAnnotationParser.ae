  (method ^:private ^:static parseTypeAnnotation ^TypeAnnotation [^ByteBuffer buf ^ConstantPool cp
                                                                  ^AnnotatedElement baseDecl
                                                                  ^{:tag (Class ?)} container]
    (try
      (let [ti (TypeAnnotationParser/parseTargetInfo buf)
            locationInfo (TypeAnnotation$LocationInfo/parseLocationInfo buf)
            a (AnnotationParser/parseAnnotation buf cp container false)]
        (when (some? ti) (TypeAnnotation. ti locationInfo a baseDecl)))
      (catch [IllegalArgumentException BufferUnderflowException] e
        (throw (AnnotationFormatError. e)))))

  (method ^:private ^:static parseTargetInfo ^TypeAnnotation$TypeAnnotationTargetInfo [^ByteBuffer buf]
    (let [posCode (bit-and-int (.get buf) 0xFF)]
      (switch posCode
        (CLASS_TYPE_PARAMETER METHOD_TYPE_PARAMETER)
          (let [index (bit-and-int (.get buf) 0xFF)
                ^TypeAnnotation$TypeAnnotationTargetInfo res (if (== posCode CLASS_TYPE_PARAMETER)
                                                                 (TypeAnnotation$TypeAnnotationTargetInfo.
                                                                   TypeAnnotation$TypeAnnotationTarget/CLASS_TYPE_PARAMETER
                                                                   index)
                                                                 (TypeAnnotation$TypeAnnotationTargetInfo.
                                                                   TypeAnnotation$TypeAnnotationTarget/METHOD_TYPE_PARAMETER
                                                                   index))]
            (return res))
        CLASS_EXTENDS
          (let [index (.getShort buf)]
            (cond
              (== index -1)
                (return (TypeAnnotation$TypeAnnotationTargetInfo.
                          TypeAnnotation$TypeAnnotationTarget/CLASS_EXTENDS))
              (>= index 0)
                (let [res (TypeAnnotation$TypeAnnotationTargetInfo.
                            TypeAnnotation$TypeAnnotationTarget/CLASS_IMPLEMENTS

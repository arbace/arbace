          (set! target TypeAnnotation$TypeAnnotationTarget/METHOD_TYPE_PARAMETER_BOUND)
          (set! boundsDecl (cast Executable decl))))
      (TypeAnnotation/filter (TypeAnnotationParser/parseAllTypeAnnotations boundsDecl) target)))

  (method ^:static parseAllTypeAnnotations ^TypeAnnotation/1 [^AnnotatedElement decl]
    (let [^:mutable ^{:tag (Class ?)} container nil
          ^:mutable ^byte/1 rawBytes nil]

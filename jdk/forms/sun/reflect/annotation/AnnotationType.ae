;; Converted from overlay/jdk/java.base/sun/reflect/annotation/AnnotationType.java by arbace.repr.java. Regenerate rather than edit.

(in-ns 'sun.reflect.annotation)

(import '(java.lang.annotation Annotation Inherited Retention RetentionPolicy)
        '(java.lang.reflect Method Modifier)
        '(java.util HashMap Map)
        '(java.util.concurrent ConcurrentHashMap))

(defclass ^:public AnnotationType
  (field ^:private ^:final ^{:tag (Map String (Class ?))} memberTypes)

  (field ^:private ^:final ^{:tag (Map String Object)} memberDefaults)

  (field ^:private ^:final ^{:tag (Map String Method)} members)

  (field ^:private ^:final ^RetentionPolicy retention)

  (field ^:private ^:final ^boolean inherited)

  (field ^:private ^:static ^:final ^{:tag (ConcurrentHashMap (Class (? extends Annotation)) AnnotationType)} TYPES
    (ConcurrentHashMap.))

  (method ^:public ^:static getInstance ^AnnotationType [^{:tag (Class (? extends Annotation))} annotationClass]
    (let [^:mutable result (cast AnnotationType (.get TYPES annotationClass))]
      (when (nil? result)
        (set! result (AnnotationType. annotationClass))
        (when (some? (.putIfAbsent TYPES annotationClass result))
          (set! result (cast AnnotationType (.get TYPES annotationClass)))
          (java-assert (some? result))))
      result))

  (constructor ^:private [this ^:final ^{:tag (Class (? extends Annotation))} annotationClass]
    (when-not (.isAnnotation annotationClass)
      (throw (IllegalArgumentException. "Not an annotation type")))
    (let [methods (.getDeclaredMethods annotationClass)]
      (set! memberTypes (HashMap. (unchecked-add-int (alength methods) 1) (float 1.0)))
      (set! memberDefaults (HashMap. 0))
      (set! members (HashMap. (unchecked-add-int (alength methods) 1) (float 1.0)))
      (for-each [^Method method methods]
        (when (and (and (Modifier/isPublic (.getModifiers method))
                        (Modifier/isAbstract (.getModifiers method)))
                   (not (.isSynthetic method)))
          (when-not (== (.getParameterCount method) 0)
            (throw (IllegalArgumentException. (java-str method " has params"))))
          (let [name (.getName method)
                ^{:tag (Class ?)} type (.getReturnType method)]
            (.put memberTypes name (AnnotationType/invocationHandlerReturnType type))
            (.put members name method)
            (let [defaultValue (.getDefaultValue method)]
              (when (some? defaultValue) (.put memberDefaults name defaultValue))))))
      (if (and (not (identical? annotationClass Retention))
               (not (identical? annotationClass Inherited)))
          (let [ret (cast Retention (.getDeclaredAnnotation annotationClass Retention))]
            (set! retention (if (nil? ret) RetentionPolicy/CLASS (.value ret)))
            (set! inherited (some? (.getDeclaredAnnotation annotationClass Inherited))))
          (do (set! retention RetentionPolicy/RUNTIME) (set! inherited false)))))

  (method ^:public ^:static invocationHandlerReturnType ^{:tag (Class ?)} [^{:tag (Class ?)} type]
    (cond
      (identical? type Byte/TYPE) Byte
      (identical? type Character/TYPE) Character
      (identical? type Double/TYPE) Double
      (identical? type Float/TYPE) Float
      (identical? type Integer/TYPE) Integer
      (identical? type Long/TYPE) Long
      (identical? type Short/TYPE) Short
      (identical? type Boolean/TYPE) Boolean
      :else type))

  (method ^:public memberTypes ^{:tag (Map String (Class ?))} [this]
    memberTypes)

  (method ^:public members ^{:tag (Map String Method)} [this] members)

  (method ^:public memberDefaults ^{:tag (Map String Object)} [this]
    memberDefaults)

  (method ^:public retention ^RetentionPolicy [this] retention)

  (method ^:public isInherited ^boolean [this] inherited)

  (method ^:public toString ^String [this]
    (java-str "Annotation Type:\n   Member types: "
              memberTypes
              "\n   Member defaults: "
              memberDefaults
              "\n   Retention policy: "
              retention
              "\n   Inherited: "
              inherited)))

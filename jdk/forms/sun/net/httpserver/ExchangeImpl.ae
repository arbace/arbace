    (field ^:private ^:static ^:final ^byte/1 CRLF (new byte/1 [0x0D 0x0A]))

    (method ^:public sendResponseHeaders :throws [IOException] ^void [this ^int rCode
                                                                      ^:mutable ^long contentLen]
      (let [logger (.getLogger server)]
        (when sentHeaders (throw (IOException. "headers already sent")))
        (set! (.-rcode this) rCode)
        (let [statusLine (java-str "HTTP/1.1 " rCode (Code/msg rCode))
              tmpout (ByteArrayOutputStream.)
              o (.getPlaceholderResponseBody this)]
          (.write tmpout (.bytes this statusLine false 0) 0 (.length statusLine))
          (.write tmpout CRLF)
          (let [^:mutable noContentToSend false
                ^:mutable noContentLengthHeader false]
            (.set rspHdrs "Date" (.format FORMATTER (Instant/now)))
            (when (or (or (and (>= rCode 100) (< rCode 200)) (== rCode 204)) (== rCode 304))
              (when-not (== contentLen HttpExchange/RSPBODY_EMPTY)
                (let [msg (java-str "sendResponseHeaders: rCode = "
                                    rCode
                                    ": forcing contentLen = RSPBODY_EMPTY")]
                  (.log logger SystemLoggers$Logger$Level/WARNING msg)))
              (set! contentLen HttpExchange/RSPBODY_EMPTY)
              (set! noContentLengthHeader (not (== rCode 304))))
            (cond
              (or (.isHeadRequest this) (== rCode 304))
                (do
                  (when (>= contentLen 0)
                    (let [msg
                            "sendResponseHeaders: being invoked with a content length for a HEAD request"]
                      (.log logger SystemLoggers$Logger$Level/WARNING msg)))
                  (set! noContentToSend true)
                  (set! contentLen 0)
                  (.setWrappedStream o (FixedLengthOutputStream. this ros contentLen)))
              (== contentLen HttpExchange/RSPBODY_CHUNKED)
                (if http10
                    (do (.setWrappedStream o (UndefLengthOutputStream. this ros)) (set! close true))
                    (do
                      (.set rspHdrs "Transfer-encoding" "chunked")
                      (.setWrappedStream o (ChunkedOutputStream. this ros))))
              :else
                (do
                  (when (== contentLen HttpExchange/RSPBODY_EMPTY)
                    (set! noContentToSend true)
                    (set! contentLen 0))
                  (when-not noContentLengthHeader
                    (.set rspHdrs "Content-length" (Long/toString contentLen)))
                  (.setWrappedStream o (FixedLengthOutputStream. this ros contentLen))))
            (when-not close
              (let [^{:tag (Stream String)} conheader (cast
                                                        Stream
                                                        (.orElse
                                                          (.map
                                                            (Optional/ofNullable
                                                              (.get rspHdrs "Connection"))
                                                            (method-ref
                                                              Function
                                                              ^Stream [List]
                                                              List/.stream))
                                                          (Stream/empty)))]

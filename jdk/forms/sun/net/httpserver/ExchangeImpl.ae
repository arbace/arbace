    (method write :throws [IOException] ^void [this ^Headers map ^OutputStream os]
      (let [^{:tag (Set (Map$Entry String (List String)))} entries (.entrySet map)]
        (for-each [^{:tag (Map$Entry String (List String))} entry entries]
          (let [key (cast String (.getKey entry))
                ^:mutable ^byte/1 buf nil
                ^{:tag (List String)} values (cast List (.getValue entry))]
            (for-each [^String val values]
              (let [^:mutable i (.length key)]
                (set! buf (.bytes this key true 2))
                (aset buf i (unchecked-byte \:))
                (set! i (unchecked-inc-int i))
                (aset buf i (unchecked-byte \space))
                (set! i (unchecked-inc-int i))
                (.write os buf 0 i)
                (set! buf (.bytes this val false 2))
                (set! i (.length val))
                (aset buf i (unchecked-byte \return))
                (set! i (unchecked-inc-int i))
                (aset buf i (unchecked-byte \newline))
                (set! i (unchecked-inc-int i))
                (.write os buf 0 i)))))
        (.write os \return)
        (.write os \newline)))

    (field ^:private ^byte/1 rspbuf (new byte/1 128))

    (method ^:private bytes :throws [IOException] ^byte/1 [this ^String s ^boolean isKey ^int extra]
      (Utils/checkHeader s (not isKey))
      (let [slen (.length s)]
        (when (> (unchecked-add-int slen extra) (alength rspbuf))
          (let [diff (unchecked-subtract-int (unchecked-add-int slen extra) (alength rspbuf))]

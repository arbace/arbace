;; Converted from overlay/jdk/java.base/sun/net/httpserver/HttpConnection.java by arbace.repr.java. Regenerate rather than edit.

(in-ns 'sun.net.httpserver)

(import '(java.io IOException InputStream OutputStream)
        '(java.nio.channels SelectionKey SocketChannel)
        '(javax.net.ssl SSLContext SSLEngine)
        '(jdk.internal.jrt SystemLoggers$Logger SystemLoggers$Logger$Level))

(defclass HttpConnection
  (field ^HttpContextImpl context)

  (field ^SSLEngine engine)

  (field ^SSLContext sslContext)

  (field ^SSLStreams sslStreams)

  (field ^InputStream i)

  (field ^InputStream raw)

  (field ^OutputStream rawout)

  (field ^SocketChannel chan)

  (field ^SelectionKey selectionKey)

  (field ^String protocol)

  (field ^long idleStartTime)

  (field ^:volatile ^long reqStartedTime)

  (field ^:volatile ^long rspStartedTime)

  (field ^int remaining)

  (field ^boolean closed false)

  (field ^SystemLoggers$Logger logger)

  (defclass ^:public ^:enum State
    (constants IDLE REQUEST RESPONSE NEWLY_ACCEPTED))

  (field ^:volatile ^State state)

  (method ^:public toString ^String [this]
    (let [sb (StringBuilder. (.getSimpleName HttpConnection))]
      (when (some? chan) (.append sb " (") (.append sb chan) (.append sb ")"))
      (.toString sb)))

  (constructor [this])

  (method setChannel ^void [this ^SocketChannel c] (set! chan c))

  (method setContext ^void [this ^HttpContextImpl ctx] (set! context ctx))

  (method getState ^State [this] state)

  (method setState ^void [this ^State s] (set! state s))

  (method setParameters ^void [this ^InputStream in ^OutputStream rawout ^SocketChannel chan
                               ^SSLEngine engine ^SSLStreams sslStreams ^SSLContext sslContext
                               ^String protocol ^HttpContextImpl context ^InputStream raw]
    (set! (.-context this) context)
    (set! (.-i this) in)
    (set! (.-rawout this) rawout)
    (set! (.-raw this) raw)
    (set! (.-protocol this) protocol)
    (set! (.-engine this) engine)
    (set! (.-chan this) chan)
    (set! (.-sslContext this) sslContext)
    (set! (.-sslStreams this) sslStreams)
    (set! (.-logger this) (.getLogger context)))

  (method getChannel ^SocketChannel [this] chan)

  (method ^:synchronized close ^void [this]
    (when-not closed
      (set! closed true)
      (when (and (some? logger) (some? chan))
        (.log logger
              SystemLoggers$Logger$Level/TRACE
              (java-str "Closing connection: " (.toString chan))))
      (if (not (.isOpen chan))
          (ServerImpl/dprint "Channel already closed")
          (do
            (try (when (some? raw) (.close raw)) (catch IOException e (ServerImpl/dprint e)))
            (try (when (some? rawout) (.close rawout)) (catch IOException e (ServerImpl/dprint e)))
            (try
              (when (some? sslStreams) (.close sslStreams))
              (catch IOException e (ServerImpl/dprint e)))
            (try (.close chan) (catch IOException e (ServerImpl/dprint e)))))))

  (method setRemaining ^void [this ^int r] (set! remaining r))

  (method getRemaining ^int [this] remaining)

  (method getSelectionKey ^SelectionKey [this] selectionKey)

  (method getInputStream ^InputStream [this] i)

  (method getRawOutputStream ^OutputStream [this] rawout)

  (method getProtocol ^String [this] protocol)

  (method getSSLEngine ^SSLEngine [this] engine)

  (method getSSLContext ^SSLContext [this] sslContext)

  (method getHttpContext ^HttpContextImpl [this] context))

      (set! rejected true)
      (.logReply ServerImpl/this code requestStr message)
      (.sendReply this code true (java-str "<h1>" code (Code/msg code) "</h1>" message)))

    (method sendReply ^void [this ^int code ^boolean closeNow ^:mutable ^String text]
      (try
        (let [builder (StringBuilder. 512)]
          (.append (.append (.append (.append builder "HTTP/1.1 ") code) (Code/msg code)) "\r\n")
          (if (and (some? text) (not (== (.length text) 0)))
              (.append (.append (.append (.append builder "Content-Length: ") (.length text))
                                "\r\n")
                       "Content-Type: text/html\r\n")
              (do (.append builder "Content-Length: 0\r\n") (set! text "")))
          (when closeNow (.append builder "Connection: close\r\n"))
          (.append (.append builder "\r\n") text)
          (let [s (.toString builder)
                b (.getBytes s StandardCharsets/ISO_8859_1)]
            (.write rawout b)
            (.flush rawout)
            (when closeNow (.closeConnection ServerImpl/this connection))))
        (catch IOException e
          (.log logger SystemLoggers$Logger$Level/TRACE "ServerImpl.sendReply" e)
          (.closeConnection ServerImpl/this connection)))))

  (method logReply ^void [this ^int code ^String requestStr ^:mutable ^String text]
    (when-not (not (.isLoggable logger SystemLoggers$Logger$Level/DEBUG))
      (when (nil? text) (set! text ""))
      (let [^String r (if (> (.length requestStr) 80)
                          (java-str (.substring requestStr 0 80) "<TRUNCATED>")
                          requestStr)]
        (let [message (java-str r " [" code " " (Code/msg code) "] (" text ")")]
          (.log logger SystemLoggers$Logger$Level/DEBUG message)))))

  (field ^:private ^int exchangeCount 0)

  (method ^:synchronized startExchange ^void [this]
    (set! exchangeCount (unchecked-inc-int exchangeCount)))

  (method ^:synchronized getExchangeCount ^int [this] exchangeCount)

  (method ^:synchronized endExchange ^int [this]
    (set! exchangeCount (unchecked-dec-int exchangeCount))
    (java-assert (>= exchangeCount 0))
    exchangeCount)

  (method getWrapper ^HttpServer [this] wrapper)

  (method requestStarted ^void [this ^HttpConnection c]
    (set! (.-reqStartedTime c) (System/currentTimeMillis))
    (.setState c HttpConnection$State/REQUEST)
    (.add reqConnections c))

  (method markIdle ^void [this ^HttpConnection c]
    (let [^:mutable close false]
      (locking idleConnections
        (if (>= (.size idleConnections) MAX_IDLE_CONNECTIONS)
            (set! close true)
            (do
              (set! (.-idleStartTime c) (System/currentTimeMillis))
              (.setState c HttpConnection$State/IDLE)
              (.add idleConnections c))))
      (when close (.close c) (.remove allConnections c))))

  (method markNewlyAccepted ^void [this ^HttpConnection c]
    (set! (.-idleStartTime c) (System/currentTimeMillis))
    (.setState c HttpConnection$State/NEWLY_ACCEPTED)
    (.add newlyAcceptedConnections c))

  (method requestCompleted ^void [this ^HttpConnection c]
    (let [s (.getState c)]
      (java-assert (identical? s HttpConnection$State/REQUEST)
        (java-str "State is not REQUEST (" s ")"))
      (.remove reqConnections c)
      (set! (.-rspStartedTime c) (System/currentTimeMillis))
      (.add rspConnections c)
      (.setState c HttpConnection$State/RESPONSE)))

  (method responseCompleted ^void [this ^HttpConnection c]
    (let [s (.getState c)]
      (java-assert (identical? s HttpConnection$State/RESPONSE)
        (java-str "State is not RESPONSE (" s ")"))
      (.remove rspConnections c)
      (.setState c HttpConnection$State/IDLE)))

  (defclass IdleTimeoutTask
    :extends TimerTask

    (method ^:public run ^void [this]
      (.closeConnections this idleConnections IDLE_INTERVAL)
      (.closeConnections this newlyAcceptedConnections NEWLY_ACCEPTED_CONN_IDLE_INTERVAL))

    (method ^:private closeConnections ^void [this ^{:tag (Set HttpConnection)} connections
                                              ^long idleInterval]
      (let [currentTime (System/currentTimeMillis)
            ^{:tag (ArrayList HttpConnection)} toClose (ArrayList.)]
        (.forEach connections
                  (lambda Consumer ^void [^HttpConnection c]
                    (when (>= (unchecked-subtract currentTime (.-idleStartTime c)) idleInterval)
                      (.add toClose c))))
        (for-each [^HttpConnection c toClose]
          (when (and (>= (unchecked-subtract currentTime (.-idleStartTime c)) idleInterval)
                     (.remove connections c))
            (.remove allConnections c)
            (.close c)
            (when (.isLoggable logger SystemLoggers$Logger$Level/TRACE)
              (.log logger SystemLoggers$Logger$Level/TRACE (java-str "Closed idle connection " c))))))))

  (defclass ReqRspTimeoutTask
    :extends TimerTask

    (method ^:public run ^void [this]
      (let [^:mutable ^{:tag (ArrayList HttpConnection)} toClose (ArrayList.)
            ^:final currentTime (System/currentTimeMillis)]
        (locking reqConnections
          (when-not (== MAX_REQ_TIME -1)
            (for-each [^HttpConnection c reqConnections]
              (when (>= (unchecked-subtract currentTime (.-reqStartedTime c)) MAX_REQ_TIME)
                (.add toClose c)))
            (for-each [^HttpConnection c toClose]
              (.log logger SystemLoggers$Logger$Level/DEBUG (java-str "closing: no request: " c))
              (.remove reqConnections c)
              (.remove allConnections c)
              (.close c))))
        (set! toClose (ArrayList.))
        (locking rspConnections
          (when-not (== MAX_RSP_TIME -1)
            (for-each [^HttpConnection c rspConnections]
              (when (>= (unchecked-subtract currentTime (.-rspStartedTime c)) MAX_RSP_TIME)
                (.add toClose c)))
            (for-each [^HttpConnection c toClose]
              (.log logger SystemLoggers$Logger$Level/DEBUG (java-str "closing: no response: " c))
              (.remove rspConnections c)
              (.remove allConnections c)
              (.close c)))))))

  (method ^:private ^:static getTimeMillis ^long [^long secs]
    (if (<= secs 0)
        -1
        (let [^:final milli (unchecked-multiply secs 1000)] (if (> milli 0) milli -1)))))

  (method ^:private closeConnection ^void [this ^HttpConnection conn]
    (.close conn)
    (.remove allConnections conn)
    (switch (.getState conn)
      REQUEST (.remove reqConnections conn)
      RESPONSE (.remove rspConnections conn)
      IDLE (.remove idleConnections conn)
      NEWLY_ACCEPTED (.remove newlyAcceptedConnections conn))
    (java-assert (not (.remove reqConnections conn)))
    (java-assert (not (.remove rspConnections conn)))
    (java-assert (not (.remove idleConnections conn)))
    (java-assert (not (.remove newlyAcceptedConnections conn))))


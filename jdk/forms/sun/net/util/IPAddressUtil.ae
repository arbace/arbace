  (field ^:private ^:static ^:final ^long TERMINAL_PARSE_ERROR -2)

  (field ^:private ^:static ^:final ^String ALLOW_AMBIGUOUS_IPADDRESS_LITERALS_SP
    "jdk.net.allowAmbiguousIPAddressLiterals")

  (field ^:private ^:static ^:final ^boolean ALLOW_AMBIGUOUS_IPADDRESS_LITERALS_SP_VALUE
    (Boolean/getBoolean ALLOW_AMBIGUOUS_IPADDRESS_LITERALS_SP))

  (defclass ^:private ^:static MASKS
    (field ^:private ^:static ^:final ^String DELAY_URL_PARSING_SP "jdk.net.url.delayParsing")

    (field ^:private ^:static ^:final ^boolean DELAY_URL_PARSING_SP_VALUE)

    (field ^:static ^:final ^long L_USERINFO_MASK (bit-and L_EXCLUDE (bit-not L_COLON)))

    (field ^:static ^:final ^long H_USERINFO_MASK (bit-and H_EXCLUDE (bit-not H_COLON)))

    (field ^:static ^:final ^long L_HOSTNAME_MASK)

    (field ^:static ^:final ^long H_HOSTNAME_MASK)

    (field ^:static ^:final ^long L_SCOPE_MASK)

    (field ^:static ^:final ^long H_SCOPE_MASK)

    (static-initializer
      (let [value (System/getProperty DELAY_URL_PARSING_SP "false")]
        (set! DELAY_URL_PARSING_SP_VALUE (or (.isEmpty value) (Boolean/parseBoolean value)))
        (if DELAY_URL_PARSING_SP_VALUE
            (do
              (set! L_HOSTNAME_MASK (bit-or L_NON_PRINTABLE L_SLASH))
              (set! H_HOSTNAME_MASK (bit-or H_NON_PRINTABLE H_SLASH))
              (set! L_SCOPE_MASK (bit-or L_NON_PRINTABLE L_IPV6_DELIMS))
              (set! H_SCOPE_MASK (bit-or H_NON_PRINTABLE H_IPV6_DELIMS)))
            (do
              (set! L_HOSTNAME_MASK
                    (bit-or (bit-or (bit-or L_NON_PRINTABLE L_SLASH) L_UNWISE) L_EXCLUDED_DELIMS))
              (set! H_HOSTNAME_MASK
                    (bit-or (bit-or (bit-or H_NON_PRINTABLE H_SLASH) H_UNWISE) H_EXCLUDED_DELIMS))
              (set! L_SCOPE_MASK
                    (bit-or (bit-or (bit-or (bit-or (bit-or L_NON_PRINTABLE L_IPV6_DELIMS) L_SLASH)
                                            L_BACKSLASH)
                                    L_FRAGMENT)
                            L_QUERY))
              (set! H_SCOPE_MASK
                    (bit-or (bit-or (bit-or (bit-or (bit-or H_NON_PRINTABLE H_IPV6_DELIMS) H_SLASH)
                                            H_BACKSLASH)
                                    H_FRAGMENT)
                            H_QUERY))))))))

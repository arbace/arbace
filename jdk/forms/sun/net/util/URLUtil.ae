(in-ns 'sun.net.util)

(import '(java.net URL)
        '(java.util Locale))

(defclass ^:public URLUtil
  (method ^:public ^:static urlNoFragString ^String [^URL url]
    (let [strForm (StringBuilder.)
          ^:mutable protocol (.getProtocol url)]
      (when (some? protocol)
        (when (and (and (not (identical? protocol "file")) (not (identical? protocol "jrt")))
                   (not (identical? protocol "jar")))
          (set! protocol (.toLowerCase protocol Locale/ROOT)))
        (.append strForm protocol)
        (.append strForm "://"))
      (let [host (.getHost url)]
        (when (some? host)
          (when-not (.isEmpty host) (.append strForm (.toLowerCase host Locale/ROOT)))
          (let [^:mutable port (.getPort url)]
            (when (== port -1) (set! port (.getDefaultPort url)))
            (when-not (== port -1) (.append (.append strForm ":") port))))
        (let [file (.getFile url)] (when (some? file) (.append strForm file)) (.toString strForm))))))

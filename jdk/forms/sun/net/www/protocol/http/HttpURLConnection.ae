            (if (== ret -1) ret (bit-and-int (aget b 0) 0x00FF)))
          (catch IOException ioex (when (some? cacheRequest) (.abort cacheRequest)) (throw ioex))))

      (method ^:public read :throws [IOException] ^int [this ^byte/1 b]
        (.read this b 0 (alength b)))

      (method ^:public read :throws [IOException] ^int [this ^byte/1 b ^int off ^int len]
        (.ensureOpen this)
        (try
          (let [newLen (.read super b off len)
                ^:mutable ^int nWrite 0]
            (if (> inCache 0)
                (if (>= inCache newLen)
                    (do (set! inCache (unchecked-subtract-int inCache newLen)) (set! nWrite 0))
                    (do (set! nWrite (unchecked-subtract-int newLen inCache)) (set! inCache 0)))
                (set! nWrite newLen))
            (when (and (> nWrite 0) (some? outputStream))
              (.write outputStream
                      b
                      (unchecked-add-int off (unchecked-subtract-int newLen nWrite))
                      nWrite))
            (when marked (set! markCount (unchecked-add-int markCount newLen)))
            newLen)
          (catch IOException ioex (when (some? cacheRequest) (.abort cacheRequest)) (throw ioex))))

      (field ^:private ^byte/1 skipBuffer)

      (field ^:private ^:static ^:final ^int SKIP_BUFFER_SIZE 8096)

      (method ^:public skip :throws [IOException] ^long [this ^long n]
        (.ensureOpen this)
        (let [^:mutable remaining n
              ^:mutable ^int nr 0]
          (when (nil? skipBuffer) (set! skipBuffer (new byte/1 SKIP_BUFFER_SIZE)))
          (let [localSkipBuffer skipBuffer]
            (if (<= n 0)
                0
                (do
                  (while (> remaining 0)
                    (set! nr
                          (.read this
                                 localSkipBuffer
                                 0
                                 (unchecked-int (Math/min SKIP_BUFFER_SIZE remaining))))
                    (when (< nr 0) (break))
                    (set! remaining (unchecked-subtract remaining nr)))
                  (unchecked-subtract n remaining))))))

      (method ^:public close :throws [IOException] ^void [this]
        (when-not closed
          (try
            (when (some? outputStream)
              (if (not (== (.read this) -1)) (.abort cacheRequest) (.close outputStream)))
            (.close super)
            (catch IOException ioex (when (some? cacheRequest) (.abort cacheRequest)) (throw ioex))
            (finally
              (set! closed true)
              (set! (.-http HttpURLConnection/this) nil)
              (.checkResponseCredentials HttpURLConnection/this true))))))

    (defclass StreamingOutputStream
      :extends FilterOutputStream

      (field ^long expected)

      (field ^long written)

      (field ^boolean closed)

      (field ^boolean error)

      (field ^IOException errorExcp)

      (constructor [this ^OutputStream os ^long expectedLength]
        (super. os)
        (set! expected expectedLength)
        (set! written 0)
        (set! closed false)
        (set! error false))

      (method ^:public write :throws [IOException] ^void [this ^int b]
        (.checkError this)
        (set! written (unchecked-inc written))
        (when (and (not (== expected -1)) (> written expected))
          (throw (IOException. "too many bytes written")))
        (.write (.-out this) b))

      (method ^:public write :throws [IOException] ^void [this ^byte/1 b]
        (.write this b 0 (alength b)))

      (method ^:public write :throws [IOException] ^void [this ^byte/1 b ^int off ^int len]
        (.checkError this)
        (set! written (unchecked-add written len))
        (when (and (not (== expected -1)) (> written expected))
          (.close (.-out this))
          (throw (IOException. "too many bytes written")))
        (.write (.-out this) b off len))

      (method checkError :throws [IOException] ^void [this]
        (when closed (throw (IOException. "Stream is closed")))
        (when error (throw errorExcp))
        (cond
          (instance? PrintStream (.-out this))
            (when (.checkError (cast PrintStream (.-out this)))
              (throw (IOException. "Error writing request body to server")))
          (instance? ChunkedOutputStream (.-out this))
            (when (.checkError (cast ChunkedOutputStream (.-out this)))
              (throw (IOException. "Error writing request body to server")))))

      (method writtenOK ^boolean [this] (and closed (not error)))

      (method ^:public close :throws [IOException] ^void [this]
        (when-not closed
          (set! closed true)
          (if (not (== expected -1))
              (do
                (when-not (== written expected)
                  (set! error true)
                  (set! errorExcp (IOException. "insufficient data written"))
                  (.close (.-out this))
                  (throw errorExcp))
                (.flush super))
              (do
                (.close super)
                (let [o (.getOutputStream http)] (.write o \return) (.write o \newline) (.flush o)))))))

    (defclass ^:static ErrorStream
      :extends InputStream

      (field ^ByteBuffer buffer)

      (field ^InputStream is)

      (constructor ^:private [this ^ByteBuffer buf]
        (set! buffer buf)
        (set! is nil))

      (constructor ^:private [this ^ByteBuffer buf ^InputStream is]
        (set! buffer buf)
        (set! (.-is this) is))

      (method ^:public ^:static getErrorStream ^InputStream [^InputStream is ^long cl
                                                             ^HttpClient http]
        (when-not (== cl 0)
          (try
            (let [oldTimeout (.getReadTimeout http)]
              (.setReadTimeout http (unchecked-divide-int timeout4ESBuffer 5))
              (let [^:mutable expected 0
                    ^:mutable isChunked false]
                (if (< cl 0)
                    (do (set! expected bufSize4ES) (set! isChunked true))
                    (set! expected cl))
                (when (<= expected bufSize4ES)
                  (let [exp (unchecked-int expected)
                        buffer (new byte/1 exp)
                        ^:mutable ^int count 0
                        ^:mutable ^int time 0
                        ^:mutable ^int len 0]
                    (loop []
                      (try
                        (set! len
                              (.read is
                                     buffer
                                     count
                                     (unchecked-subtract-int (alength buffer) count)))
                        (when (< len 0)
                          (when isChunked (break))
                          (throw (IOException. (java-str
                                                 "the server closes before sending "
                                                 cl
                                                 " bytes of data"))))
                        (set! count (unchecked-add-int count len))
                        (catch SocketTimeoutException ex
                          (set! time
                                (unchecked-add-int time (unchecked-divide-int timeout4ESBuffer 5)))))
                      (when (and (< count exp) (< time timeout4ESBuffer)) (recur)))
                    (.setReadTimeout http oldTimeout)
                    (when-not (== count 0)
                      (if (or (and (== count expected) (not isChunked)) (and isChunked (< len 0)))
                          (do (.close is) (ErrorStream. (ByteBuffer/wrap buffer 0 count)))
                          (ErrorStream. (ByteBuffer/wrap buffer 0 count) is)))))))
            (catch IOException ioex nil))))

      (method ^:public available :throws [IOException] ^int [this]
        (if (nil? is) (.remaining buffer) (unchecked-add-int (.remaining buffer) (.available is))))

      (method ^:public read :throws [IOException] ^int [this]
        (let [b (new byte/1 1)
              ret (.read this b)]
          (if (== ret -1) ret (bit-and-int (aget b 0) 0x00FF))))

      (method ^:public read :throws [IOException] ^int [this ^byte/1 b]
        (.read this b 0 (alength b)))

      (method ^:public read :throws [IOException] ^int [this ^byte/1 b ^int off ^int len]
        (let [rem (.remaining buffer)]
          (cond
            (> rem 0) (let [^int ret (if (< rem len) rem len)] (.get buffer b off ret) ret)
            (nil? is) -1
            :else (.read is b off len))))

      (method ^:public close :throws [IOException] ^void [this]
        (set! buffer nil)
        (when (some? is) (.close is))))

    (method ^:private ^:static newURL :throws [MalformedURLException] ^URL [^String spec]
      (URL. spec))

    (method ^:private ^:static newURL :throws [MalformedURLException] ^URL [^URL context
                                                                            ^String spec]
      (URL. context spec))

    (method ^:private ^:static validateNTLMCredentials :throws [IOException] ^void [^PasswordAuthentication pw]
      (when (some? pw)
        (let [password (.getPassword pw)]
          (when (some? password)
            (loop [^int i 0]
              (if (< i (alength password))
                  (if (== (aget password i) 0)
                      (throw (IOException. "NUL character not allowed in NTLM password"))
                      (recur (unchecked-inc-int i)))
                  nil)))
          (let [username (.getUserName pw)]
            (when (and (some? username) (not (== (.indexOf username 0) -1)))
              (throw (IOException. "NUL character not allowed in NTLM username or domain"))))))))

  (defclass EmptyInputStream
    :extends InputStream

    (method ^:public available ^int [this] 0)

    (method ^:public read ^int [this] -1)))

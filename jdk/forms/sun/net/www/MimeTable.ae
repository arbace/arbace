  (method ^:public ^:synchronized getContentTypeFor ^String [this ^String fileName]
    (let [entry (.findByFileName this fileName)] (when (some? entry) (.getType entry))))

  (method ^:private add ^void [this ^MimeEntry m]
    (let [exts (.getExtensions m)]
      (when (some? exts) (for-each [^String ext exts] (.put extensionMap ext m)))))

  (method ^:private findByFileExtension ^MimeEntry [this ^String fname]
    (let [^:mutable i (.lastIndexOf fname \.)]
      (set! i (Math/max i (.lastIndexOf fname \/)))
      (set! i (Math/max i (.lastIndexOf fname \?)))
      (let [^:mutable ext ""]
        (when (and (not (== i -1)) (== (.charAt fname i) \.))
          (set! ext (.toLowerCase (.substring fname i) Locale/ROOT)))
        (cast MimeEntry (.get extensionMap ext)))))

  (method ^:private findByFileName ^MimeEntry [this ^String fname]
    (let [hashIndex (.lastIndexOf fname HASH_MARK)]
      (when (> hashIndex 0)
        (let [entry (.findByFileExtension this (.substring fname 0 hashIndex))]
          (when (some? entry) (return entry))))
      (.findByFileExtension this fname)))

  (method ^:private ^:synchronized load ^void [this]
    (let [entries (Properties.)
          ^:mutable ^File file nil
          ^:mutable ^InputStream in nil
          userTablePath (System/getProperty "content.types.user.table")]
      (if (and (some? userTablePath) (.exists (set! file (File. userTablePath))))
          (try
            (set! in (FileInputStream. file))
            (catch FileNotFoundException e
              (.println System/err (java-str "Warning: " (.getPath file) " mime table not found."))
              (return)))
          (do
            (set! in (.getResourceAsStream MimeTable "content-types.properties"))
            (when (nil? in) (throw (InternalError. "default mime table not found")))))
      (try
        (with-resources [in in] (.load entries in))
        (catch IOException e (.println System/err (java-str "Warning: " (.getMessage e)))))
      (.parse this entries)))

  (method ^:private parse ^void [this ^Properties entries]
    (let [tempFileTemplate (cast String (.get entries "temp.file.template"))]
      (when (some? tempFileTemplate) (.remove entries "temp.file.template"))
      (let [^{:tag (Enumeration ?)} types (.propertyNames entries)]
        (while (.hasMoreElements types)
          (let [type (cast String (.nextElement types))
                attrs (.getProperty entries type)]
            (.parse this type attrs))))))

  (method ^:private parse ^void [this ^String type ^String attrs]
    (let [newEntry (MimeEntry. type)
          tokenizer (StringTokenizer. attrs ";")]
      (while (.hasMoreTokens tokenizer)
        (let [pair (.nextToken tokenizer)] (MimeTable/parse pair newEntry)))
      (.add this newEntry)))

  (method ^:private ^:static parse ^void [^String pair ^MimeEntry entry]
    (let [^:mutable ^String name nil
          ^:mutable ^String value nil
          ^:mutable gotName false
          tokenizer (StringTokenizer. pair "=")]
      (while (.hasMoreTokens tokenizer)
        (if gotName
            (set! value (.trim (.nextToken tokenizer)))
            (do (set! name (.trim (.nextToken tokenizer))) (set! gotName true))))
      (MimeTable/fill entry name value)))

  (method ^:private ^:static fill ^void [^MimeEntry entry ^String name ^String value]
    (cond
      (.equalsIgnoreCase "description" name) (.setDescription entry value)
      (.equalsIgnoreCase "action" name) (.setAction entry (MimeTable/getActionCode value))
      (.equalsIgnoreCase "application" name) (.setCommand entry value)
      (.equalsIgnoreCase "icon" name) (.setImageFileName entry value)
      (.equalsIgnoreCase "file_extensions" name) (.setExtensions entry value)))

  (method ^:private ^:static getActionCode ^int [^String action]
    (loop [^int i 0]
      (if (< i (alength MimeEntry/actionKeywords))
          (if (.equalsIgnoreCase action (aget MimeEntry/actionKeywords i))
              (return i)
              (recur (unchecked-inc-int i)))
          nil))
    MimeEntry/UNKNOWN))

(defclass ^:public ^:final MimeTable
  :implements [FileNameMap]

  (field ^:private ^:static ^:final ^int HASH_MARK \#)

  (field ^:private ^:final ^{:tag (Hashtable String MimeEntry)} extensionMap (Hashtable.))

  (constructor ^:private [this] (.load this))


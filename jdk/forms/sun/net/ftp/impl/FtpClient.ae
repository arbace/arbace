          (throw (FtpProtocolException. "Passive mode failed")))
        (set! portSocket (ServerSocket. 0 1 (.getLocalAddress server)))
        (try
          (set! myAddress (.getInetAddress portSocket))
          (when (.isAnyLocalAddress myAddress) (set! myAddress (.getLocalAddress server)))
          (set! portCmd
                (java-str "EPRT |"
                          (if (instance? Inet6Address myAddress) "2" "1")
                          "|"
                          (.getHostAddress myAddress)
                          "|"
                          (.getLocalPort portSocket)
                          "|"))
          (when (or (not (.issueCommand this portCmd)) (not (.issueCommand this cmd)))
            (set! portCmd "PORT ")
            (let [addr (.getAddress myAddress)]
              (loop [^int i 0]
                (when (< i (alength addr))
                  (set! portCmd (java-str portCmd (bit-and-int (aget addr i) 0xFF) ","))
                  (recur (unchecked-inc-int i))))
              (set! portCmd
                    (java-str portCmd
                              (bit-and-int (unsigned-bit-shift-right-int
                                             (.getLocalPort portSocket)
                                             8)
                                           0xff)
                              ","
                              (bit-and-int (.getLocalPort portSocket) 0xff)))

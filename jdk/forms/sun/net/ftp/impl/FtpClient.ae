                        (return (InetSocketAddress. s port))
                        (throw (FtpProtocolException. ERROR_MSG))))
                (let [hostName (.getHostName address)]
                  (when-not (or (IPAddressUtil/isIPv4LiteralAddress hostName)
                                (IPAddressUtil/isIPv6LiteralAddress hostName))
                    (let [names (FtpClient/getAllByName hostName)
                          resAddress (cast String
                                           (.orElse
                                             (.findFirst
                                               (.filter
                                                 (.map
                                                   (Arrays/stream names)
                                                   (method-ref
                                                     Function
                                                     ^String [InetAddress]
                                                     InetAddress/.getHostAddress))
                                                 (method-ref
                                                   Predicate
                                                   [String]
                                                   s
                                                   String/.equalsIgnoreCase)))
                                             nil))]
                      (when (some? resAddress) (return (InetSocketAddress. s port)))))
                  (throw (FtpProtocolException. ERROR_MSG))))))))


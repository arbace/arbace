                  (.isLoopbackAddress address)
                    (if (.equals (.getHostAddress (FtpClient/getLocalHost)) s)
                        (return (InetSocketAddress. s port))
                        (throw (FtpProtocolException. ERROR_MSG)))
                  (.startsWith s "127.")

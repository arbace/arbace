        (> defaultSoTimeout 0) (.setSoTimeout s defaultSoTimeout))
      s))

  (method ^:private disconnect :throws [IOException] ^void [this]
    (when (.isConnected this) (.close server))
    (set! server nil)
    (set! in nil)
    (set! out nil)
    (set! lastTransSize -1)
    (set! lastFileName nil)
    (set! restartOffset 0)
    (set! welcomeMsg nil)
    (set! lastReplyCode nil)
    (.setSize serverResponse 0))

  (method ^:public isConnected ^boolean [this] (some? server))

  (method ^:public getServerAddress ^SocketAddress [this]
    (when (some? server) (.getRemoteSocketAddress server)))

  (method ^:public connect :throws [FtpProtocolException IOException] ^sun.net.ftp.FtpClient [this
                                                                                              ^SocketAddress dest]
    (.connect this dest -1))

  (method ^:public connect :throws [FtpProtocolException IOException] ^sun.net.ftp.FtpClient [this
                                                                                              ^SocketAddress dest
                                                                                              ^int timeout]
    (when-not (instance? InetSocketAddress dest)
      (throw (IllegalArgumentException. "Wrong address type")))
    (set! serverAddr (cast InetSocketAddress dest))
    (.tryConnect this serverAddr timeout)
    (when-not (.readReply this)
      (throw (FtpProtocolException. (java-str "Welcome message: " (.getResponseString this))
                                    lastReplyCode)))
    (set! welcomeMsg (.substring (.getResponseString this) 4))
    this)

  (method ^:private tryLogin :throws [FtpProtocolException IOException] ^void [this ^String user
                                                                               ^char/1 password]
    (.issueCommandCheck this (java-str "USER " user))
    (when (identical? lastReplyCode FtpReplyCode/NEED_PASSWORD)
      (when (and (some? password) (> (alength password) 0))
        (.issueCommandCheck this (java-str "PASS " (String/valueOf password))))))

  (method ^:public login :throws [FtpProtocolException IOException] ^sun.net.ftp.FtpClient [this
                                                                                            ^String user
                                                                                            ^char/1 password]
    (when-not (.isConnected this)
      (throw (FtpProtocolException. "Not connected yet" FtpReplyCode/BAD_SEQUENCE)))
    (when (or (nil? user) (.isEmpty user))
      (throw (IllegalArgumentException. "User name can't be null or empty")))
    (.tryLogin this user password)
    (let [^:mutable ^String l nil
          sb (StringBuilder.)]
      (loop [^int i 0]
        (when (< i (.size serverResponse))
          (set! l (cast String (.elementAt serverResponse i)))
          (if (some? l)
              (do
                (when (and (>= (.length l) 4) (.startsWith l "230")) (set! l (.substring l 4)))
                (.append sb l)
                (recur (unchecked-inc-int i)))
              (recur (unchecked-inc-int i)))))
      (set! welcomeMsg (.toString sb))
      (set! loggedIn true)
      this))

  (method ^:public login :throws [FtpProtocolException IOException] ^sun.net.ftp.FtpClient [this
                                                                                            ^String user
                                                                                            ^char/1 password
                                                                                            ^String account]
    (when-not (.isConnected this)
      (throw (FtpProtocolException. "Not connected yet" FtpReplyCode/BAD_SEQUENCE)))
    (when (or (nil? user) (.isEmpty user))
      (throw (IllegalArgumentException. "User name can't be null or empty")))
    (.tryLogin this user password)
    (when (identical? lastReplyCode FtpReplyCode/NEED_ACCOUNT)
      (.issueCommandCheck this (java-str "ACCT " account)))
    (let [sb (StringBuilder.)]
      (when (some? serverResponse)
        (for-each [^:mutable ^String l serverResponse]
          (when (some? l)
            (when (and (>= (.length l) 4) (.startsWith l "230")) (set! l (.substring l 4)))
            (.append sb l))))
      (set! welcomeMsg (.toString sb))
      (set! loggedIn true)
      this))

  (method ^:public close :throws [IOException] ^void [this]
    (when (.isConnected this)
      (try (.issueCommand this "QUIT") (catch FtpProtocolException e))
      (set! loggedIn false))
    (.disconnect this))

  (method ^:public isLoggedIn ^boolean [this] loggedIn)

  (method ^:public changeDirectory :throws [FtpProtocolException IOException] ^sun.net.ftp.FtpClient [this
                                                                                                      ^String remoteDirectory]
    (when (or (nil? remoteDirectory) (.isEmpty remoteDirectory))
      (throw (IllegalArgumentException. "directory can't be null or empty")))
    (.issueCommandCheck this (java-str "CWD " remoteDirectory))
    this)

  (method ^:public changeToParentDirectory :throws [FtpProtocolException IOException] ^sun.net.ftp.FtpClient [this]
    (.issueCommandCheck this "CDUP")
    this)

  (method ^:public getWorkingDirectory :throws [FtpProtocolException IOException] ^String [this]
    (.issueCommandCheck this "PWD")
    (let [answ (.getResponseString this)]
      (when-not (not (.startsWith answ "257")) (.substring answ 5 (.lastIndexOf answ \")))))

  (method ^:public setRestartOffset ^sun.net.ftp.FtpClient [this ^long offset]
    (when (< offset 0) (throw (IllegalArgumentException. "offset can't be negative")))
    (set! restartOffset offset)
    this)

  (method ^:public getFile :throws [FtpProtocolException IOException] ^sun.net.ftp.FtpClient [this
                                                                                              ^String name
                                                                                              ^OutputStream local]
    (if (> restartOffset 0)
        (let [^:mutable ^Socket s nil]
          (try
            (set! s (.openDataConnection this (java-str "REST " restartOffset)))
            (finally (set! restartOffset 0)))
          (.issueCommandCheck this (java-str "RETR " name))
          (.getTransferSize this)
          (with-resources [remote (.createInputStream this (.getInputStream s))]
            (.transferTo remote local)))
        (let [s (.openDataConnection this (java-str "RETR " name))]
          (.getTransferSize this)
          (with-resources [remote (.createInputStream this (.getInputStream s))]
            (.transferTo remote local))))
    (.completePending this))

  (method ^:public getFileStream :throws [FtpProtocolException IOException] ^InputStream [this
                                                                                          ^String name]
    (let [^:mutable ^Socket s nil]
      (if (> restartOffset 0)
          (do
            (try
              (set! s (.openDataConnection this (java-str "REST " restartOffset)))
              (finally (set! restartOffset 0)))
            (when (some? s)
              (.issueCommandCheck this (java-str "RETR " name))
              (.getTransferSize this)
              (.createInputStream this (.getInputStream s))))
          (do
            (set! s (.openDataConnection this (java-str "RETR " name)))
            (when (some? s) (.getTransferSize this) (.createInputStream this (.getInputStream s)))))))

  (method ^:public putFileStream :throws [FtpProtocolException IOException] ^OutputStream [this
                                                                                           ^String name
                                                                                           ^boolean unique]
    (let [^String cmd (if unique "STOU " "STOR ")
          s (.openDataConnection this (java-str cmd name))]
      (when (some? s)
        (let [bm (identical? type sun.net.ftp.FtpClient$TransferType/BINARY)]
          (TelnetOutputStream. (.getOutputStream s) bm)))))

  (method ^:public putFile :throws [FtpProtocolException IOException] ^sun.net.ftp.FtpClient [this
                                                                                              ^String name
                                                                                              ^InputStream local
                                                                                              ^boolean unique]
    (let [^String cmd (if unique "STOU " "STOR ")]
      (when (identical? type sun.net.ftp.FtpClient$TransferType/BINARY)
        (let [s (.openDataConnection this (java-str cmd name))]
          (with-resources [remote (.createOutputStream this (.getOutputStream s))]
            (.transferTo local remote))))
      (.completePending this)))

  (method ^:public appendFile :throws [FtpProtocolException IOException] ^sun.net.ftp.FtpClient [this
                                                                                                 ^String name
                                                                                                 ^InputStream local]
    (let [s (.openDataConnection this (java-str "APPE " name))]
      (with-resources [remote (.createOutputStream this (.getOutputStream s))]
        (.transferTo local remote))
      (.completePending this)))

  (method ^:public rename :throws [FtpProtocolException IOException] ^sun.net.ftp.FtpClient [this
                                                                                             ^String from
                                                                                             ^String to]
    (.issueCommandCheck this (java-str "RNFR " from))
    (.issueCommandCheck this (java-str "RNTO " to))
    this)

  (method ^:public deleteFile :throws [FtpProtocolException IOException] ^sun.net.ftp.FtpClient [this
                                                                                                 ^String name]
    (.issueCommandCheck this (java-str "DELE " name))
    this)

  (method ^:public makeDirectory :throws [FtpProtocolException IOException] ^sun.net.ftp.FtpClient [this
                                                                                                    ^String name]
    (.issueCommandCheck this (java-str "MKD " name))
    this)

  (method ^:public removeDirectory :throws [FtpProtocolException IOException] ^sun.net.ftp.FtpClient [this
                                                                                                      ^String name]
    (.issueCommandCheck this (java-str "RMD " name))
    this)

  (method ^:public noop :throws [FtpProtocolException IOException] ^sun.net.ftp.FtpClient [this]
    (.issueCommandCheck this "NOOP")
    this)

  (method ^:public getStatus :throws [FtpProtocolException IOException] ^String [this ^String name]
    (.issueCommandCheck this ^String (if (nil? name) "STAT" (java-str "STAT " name)))
    (let [^{:tag (Vector String)} resp (.getResponseStrings this)
          sb (StringBuilder.)]
      (loop [^int i 1]
        (when (< i (unchecked-subtract-int (.size resp) 1))
          (.append sb (cast String (.get resp i)))
          (recur (unchecked-inc-int i))))
      (.toString sb)))

  (method ^:public getFeatures :throws [FtpProtocolException IOException] ^{:tag (List String)} [this]
    (let [^{:tag (ArrayList String)} features (ArrayList.)]
      (.issueCommandCheck this "FEAT")
      (let [^{:tag (Vector String)} resp (.getResponseStrings this)]
        (loop [^int i 1]
          (when (< i (unchecked-subtract-int (.size resp) 1))
            (let [s (cast String (.get resp i))]
              (.add features (.substring s 1 (unchecked-subtract-int (.length s) 1)))
              (recur (unchecked-inc-int i)))))
        features)))

  (method ^:public abort :throws [FtpProtocolException IOException] ^sun.net.ftp.FtpClient [this]
    (.issueCommandCheck this "ABOR")
    this)

  (method ^:public completePending :throws [FtpProtocolException IOException] ^sun.net.ftp.FtpClient [this]
    (while replyPending
      (set! replyPending false)
      (when-not (.readReply this)
        (throw (FtpProtocolException. (.getLastResponseString this) lastReplyCode))))
    this)

  (method ^:public reInit :throws [FtpProtocolException IOException] ^sun.net.ftp.FtpClient [this]
    (.issueCommandCheck this "REIN")
    (set! loggedIn false)
    (when useCrypto
      (when (instance? SSLSocket server)
        (let [session (.getSession (cast SSLSocket server))]
          (.invalidate session)
          (set! server oldSocket)
          (set! oldSocket nil)
          (try
            (set! out
                  (PrintStream. (BufferedOutputStream. (.getOutputStream server)) true encoding))
            (catch UnsupportedEncodingException e
              (throw (InternalError. (java-str encoding "encoding not found") e))))
          (set! in (BufferedInputStream. (.getInputStream server))))))
    (set! useCrypto false)
    this)

  (method ^:public setType :throws [FtpProtocolException IOException] ^sun.net.ftp.FtpClient [this
                                                                                              ^sun.net.ftp.FtpClient$TransferType type]
    (let [^:mutable cmd "NOOP"]
      (set! (.-type this) type)
      (when (identical? type sun.net.ftp.FtpClient$TransferType/ASCII) (set! cmd "TYPE A"))
      (when (identical? type sun.net.ftp.FtpClient$TransferType/BINARY) (set! cmd "TYPE I"))
      (when (identical? type sun.net.ftp.FtpClient$TransferType/EBCDIC) (set! cmd "TYPE E"))
      (.issueCommandCheck this cmd)
      this))

  (method ^:public list :throws [FtpProtocolException IOException] ^InputStream [this ^String path]
    (let [^:mutable ^Socket s nil]
      (set! s (.openDataConnection this ^String (if (nil? path) "LIST" (java-str "LIST " path))))
      (when (some? s) (.createInputStream this (.getInputStream s)))))

  (method ^:public nameList :throws [FtpProtocolException IOException] ^InputStream [this
                                                                                     ^String path]
    (let [^:mutable ^Socket s nil]
      (set! s (.openDataConnection this ^String (if (nil? path) "NLST" (java-str "NLST " path))))
      (when (some? s) (.createInputStream this (.getInputStream s)))))

  (method ^:public getSize :throws [FtpProtocolException IOException] ^long [this ^String path]
    (when (or (nil? path) (.isEmpty path))
      (throw (IllegalArgumentException. "path can't be null or empty")))
    (.issueCommandCheck this (java-str "SIZE " path))
    (if (identical? lastReplyCode FtpReplyCode/FILE_STATUS)
        (let [^:mutable s (.getResponseString this)]
          (set! s (.substring s 4 (unchecked-subtract-int (.length s) 1)))
          (Long/parseLong s))
        -1))

  (field ^:private ^:static ^:final ^DateTimeFormatter RFC3659_DATETIME_FORMAT
    (.withZone (DateTimeFormatter/ofPattern "yyyyMMddHHmmss[.SSS]") ZoneOffset/UTC))

  (method ^:public getLastModified :throws [FtpProtocolException IOException] ^Date [this
                                                                                     ^String path]
    (.issueCommandCheck this (java-str "MDTM " path))
    (when (identical? lastReplyCode FtpReplyCode/FILE_STATUS)
      (let [s (.getResponseString this)]
        (FtpClient/parseRfc3659TimeValue (.substring s 4 (unchecked-subtract-int (.length s) 1))))))

  (method ^:private ^:static parseRfc3659TimeValue ^Date [^String s]
    (let [^:mutable ^Date result nil]
      (try
        (let [d (ZonedDateTime/parse s RFC3659_DATETIME_FORMAT)]
          (set! result (Date/from (.toInstant d))))
        (catch DateTimeParseException ex))
      result))

  (method ^:public setDirParser ^sun.net.ftp.FtpClient [this ^FtpDirParser p]
    (set! parser p)
    this)

  (defclass ^:private ^:static FtpFileIterator
    :implements [(Iterator FtpDirEntry) Closeable]

    (field ^:private ^BufferedReader in nil)

    (field ^:private ^FtpDirEntry nextFile nil)

    (field ^:private ^FtpDirParser fparser nil)

    (field ^:private ^boolean eof false)

    (constructor ^:public [this ^FtpDirParser p ^BufferedReader in]
      (set! (.-in this) in)
      (set! (.-fparser this) p)
      (.readNext this))

    (method ^:private readNext ^void [this]
      (set! nextFile nil)
      (when-not eof
        (let [^:mutable ^String line nil]
          (try
            (loop []
              (set! line (.readLine in))
              (when (some? line)
                (set! nextFile (.parseLine fparser line))
                (when (some? nextFile) (return)))
              (when (some? line) (recur)))
            (.close in)
            (catch IOException iOException))
          (set! eof true))))

    (method ^:public hasNext ^boolean [this] (some? nextFile))

    (method ^:public next ^FtpDirEntry [this]
      (let [ret nextFile] (.readNext this) ret))

    (method ^:public remove ^void [this]
      (throw (UnsupportedOperationException. "Not supported yet.")))

    (method ^:public close :throws [IOException] ^void [this]
      (when (and (some? in) (not eof)) (.close in))
      (set! eof true)
      (set! nextFile nil)))

  (method ^:public listFiles :throws [FtpProtocolException IOException] ^{:tag (Iterator FtpDirEntry)} [this
                                                                                                        ^String path]
    (let [^:mutable ^Socket s nil
          ^:mutable ^BufferedReader sin nil]
      (try
        (set! s (.openDataConnection this ^String (if (nil? path) "MLSD" (java-str "MLSD " path))))
        (catch FtpProtocolException FtpException))
      (if (some? s)
          (do
            (set! sin (BufferedReader. (InputStreamReader. (.getInputStream s))))
            (FtpFileIterator. mlsxParser sin))
          (do
            (set!
              s
              (.openDataConnection this ^String (if (nil? path) "LIST" (java-str "LIST " path))))
            (when (some? s)
              (set! sin (BufferedReader. (InputStreamReader. (.getInputStream s))))
              (return (FtpFileIterator. parser sin)))
            nil))))

  (method ^:private sendSecurityData :throws [IOException FtpProtocolException] ^boolean [this
                                                                                          ^byte/1 buf]
    (let [s (.encodeToString (Base64/getMimeEncoder) buf)]
      (.issueCommand this (java-str "ADAT " s))))

  (method ^:private getSecurityData ^byte/1 [this]
    (let [s (.getLastResponseString this)]
      (when (.equalsIgnoreCase (.substring s 4 9) "ADAT=")
        (.decode (Base64/getMimeDecoder) (.substring s 9 (unchecked-subtract-int (.length s) 1))))))

  (method ^:public useKerberos :throws [FtpProtocolException IOException] ^sun.net.ftp.FtpClient [this]
    this)

  (method ^:public getWelcomeMsg ^String [this] welcomeMsg)

  (method ^:public getLastReplyCode ^FtpReplyCode [this] lastReplyCode)

  (method ^:public getLastResponseString ^String [this]
    (let [sb (StringBuilder.)]
      (when (some? serverResponse)
        (for-each [^String l serverResponse] (when (some? l) (.append sb l))))
      (.toString sb)))

  (method ^:public getLastTransferSize ^long [this] lastTransSize)

  (method ^:public getLastFileName ^String [this] lastFileName)

  (method ^:public startSecureSession :throws [FtpProtocolException IOException] ^sun.net.ftp.FtpClient [this]
    (when-not (.isConnected this)
      (throw (FtpProtocolException. "Not connected yet" FtpReplyCode/BAD_SEQUENCE)))
    (when (nil? sslFact)
      (try
        (set! sslFact (cast SSLSocketFactory (SSLSocketFactory/getDefault)))
        (catch Exception e (throw (IOException. (.getLocalizedMessage e))))))
    (.issueCommandCheck this "AUTH TLS")
    (let [^:mutable ^Socket s nil]
      (try
        (set! s (.createSocket sslFact server (.getHostName serverAddr) (.getPort serverAddr) true))
        (catch SSLException ssle (try (.disconnect this) (catch Exception e)) (throw ssle)))
      (set! oldSocket server)
      (set! server s)
      (try
        (set! out (PrintStream. (BufferedOutputStream. (.getOutputStream server)) true encoding))
        (catch UnsupportedEncodingException e
          (throw (InternalError. (java-str encoding "encoding not found") e))))
      (set! in (BufferedInputStream. (.getInputStream server)))
      (.issueCommandCheck this "PBSZ 0")
      (.issueCommandCheck this "PROT P")
      (set! useCrypto true)
      this))

  (method ^:public endSecureSession :throws [FtpProtocolException IOException] ^sun.net.ftp.FtpClient [this]
    (if (not useCrypto)
        this
        (do
          (.issueCommandCheck this "CCC")
          (.issueCommandCheck this "PROT C")
          (set! useCrypto false)
          (set! server oldSocket)
          (set! oldSocket nil)
          (try
            (set! out
                  (PrintStream. (BufferedOutputStream. (.getOutputStream server)) true encoding))
            (catch UnsupportedEncodingException e
              (throw (InternalError. (java-str encoding "encoding not found") e))))
          (set! in (BufferedInputStream. (.getInputStream server)))
          this)))

  (method ^:public allocate :throws [FtpProtocolException IOException] ^sun.net.ftp.FtpClient [this
                                                                                               ^long size]
    (.issueCommandCheck this (java-str "ALLO " size))
    this)

  (method ^:public structureMount :throws [FtpProtocolException IOException] ^sun.net.ftp.FtpClient [this
                                                                                                     ^String struct]
    (.issueCommandCheck this (java-str "SMNT " struct))
    this)

  (method ^:public getSystem :throws [FtpProtocolException IOException] ^String [this]
    (.issueCommandCheck this "SYST")
    (let [resp (.getResponseString this)] (.substring resp 4)))

  (method ^:public getHelp :throws [FtpProtocolException IOException] ^String [this ^String cmd]
    (.issueCommandCheck this (java-str "HELP " cmd))
    (let [^{:tag (Vector String)} resp (.getResponseStrings this)]
      (if (== (.size resp) 1)
          (.substring (cast String (.get resp 0)) 4)
          (let [sb (StringBuilder.)]
            (loop [^int i 1]
              (when (< i (unchecked-subtract-int (.size resp) 1))
                (.append sb (.substring (cast String (.get resp i)) 3))
                (recur (unchecked-inc-int i))))
            (.toString sb)))))

  (method ^:public siteCmd :throws [FtpProtocolException IOException] ^sun.net.ftp.FtpClient [this
                                                                                              ^String cmd]
    (.issueCommandCheck this (java-str "SITE " cmd))
    this))

        (not (== (bit-and-int threadStatus JVMTI_THREAD_STATE_RUNNABLE) 0)) Thread$State/RUNNABLE
        (not (== (bit-and-int threadStatus JVMTI_THREAD_STATE_BLOCKED_ON_MONITOR_ENTER) 0))
          Thread$State/BLOCKED
        (not (== (bit-and-int threadStatus JVMTI_THREAD_STATE_WAITING_INDEFINITELY) 0))
          Thread$State/WAITING
        (not (== (bit-and-int threadStatus JVMTI_THREAD_STATE_WAITING_WITH_TIMEOUT) 0))
          Thread$State/TIMED_WAITING
        (not (== (bit-and-int threadStatus JVMTI_THREAD_STATE_TERMINATED) 0))
          Thread$State/TERMINATED
        (== (bit-and-int threadStatus JVMTI_THREAD_STATE_ALIVE) 0) Thread$State/NEW
        :else Thread$State/RUNNABLE)))

  (field ^:private ^:static ^:final ^int JMM_THREAD_STATE_FLAG_MASK (unchecked-int 0xFFF00000))

  (field ^:private ^:static ^:final ^int JMM_THREAD_STATE_FLAG_SUSPENDED 0x00100000)

  (field ^:private ^:static ^:final ^int JMM_THREAD_STATE_FLAG_NATIVE 0x00400000)

  (field ^:private ^:static ^:final ^int JVMTI_THREAD_STATE_ALIVE 0x0001)

  (field ^:private ^:static ^:final ^int JVMTI_THREAD_STATE_TERMINATED 0x0002)

  (field ^:private ^:static ^:final ^int JVMTI_THREAD_STATE_RUNNABLE 0x0004)

  (field ^:private ^:static ^:final ^int JVMTI_THREAD_STATE_BLOCKED_ON_MONITOR_ENTER 0x0400)

  (field ^:private ^:static ^:final ^int JVMTI_THREAD_STATE_WAITING_INDEFINITELY 0x0010)

  (field ^:private ^:static ^:final ^int JVMTI_THREAD_STATE_WAITING_WITH_TIMEOUT 0x0020))

  (method ^:public ^:static isThreadRunningNative ^boolean [^int state]
    (not (== (bit-and-int state JMM_THREAD_STATE_FLAG_NATIVE) 0)))

  (method ^:public ^:static toThreadState ^Thread$State [^int state]
    (let [threadStatus (bit-and-int state (bit-not-int JMM_THREAD_STATE_FLAG_MASK))]

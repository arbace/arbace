(in-ns 'sun.management)

(import '(java.lang.management RuntimeMXBean ThreadMXBean)
        '(jdk.internal.jrt HostManagement))

(defclass ^:public ManagementFactoryHelper
  (field ^:private ^:static ^:final ^VMManagement jvm (VMManagementImpl.))

  (constructor ^:private [this])

  (method ^:public ^:static getVMManagement ^VMManagement [] jvm)

  (field ^:private ^:static ^ThreadImpl threadMBean nil)

  (field ^:private ^:static ^RuntimeImpl runtimeMBean nil)

  (method ^:public ^:static ^:synchronized getThreadMXBean ^ThreadMXBean []

      (let [paramAlg (.getAlgorithm parameters)]
        (when-not (.equalsIgnoreCase (.-algorithm this) (.getAlgorithm parameters))
          (let [^{:tag (Collection String)} aliases (AlgorithmDecomposer/getAliases
                                                      (.-algorithm this))]
            (when-not (.contains aliases paramAlg) (return true))))
        (let [keySize (KeyUtil/getKeySize parameters)]
          (cond
            (== keySize 0) false
            (> keySize 0)
              (not (or (or (< keySize minSize) (> keySize maxSize)) (== prohibitedSize keySize)))
            :else true))))


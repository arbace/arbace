            (set! (.-maxSize this) Integer/MAX_VALUE)
            (set! prohibitedSize length))
        NE (do (set! (.-minSize this) length) (set! (.-maxSize this) length))
        LT (do (set! (.-minSize this) length) (set! (.-maxSize this) Integer/MAX_VALUE))
        LE
          (do
            (set! (.-minSize this) (unchecked-add-int length 1))
            (set! (.-maxSize this) Integer/MAX_VALUE))
        GT (do (set! (.-minSize this) 0) (set! (.-maxSize this) length))
        GE
          (do
            (set! (.-minSize this) 0)
            (set! (.-maxSize this) (if (> length 1) (unchecked-subtract-int length 1) 0)))
        (do (set! (.-minSize this) Integer/MAX_VALUE) (set! (.-maxSize this) -1))))


      (if (not (== (.compareToIgnoreCase (.-algorithm this) (.getAlgorithm key)) 0))
          true
          (let [size (KeyUtil/getKeySize key)]
            (cond
              (== size 0) false
              (> size 0) (not (or (or (< size minSize) (> size maxSize)) (== prohibitedSize size)))
              :else true)))))

  (method ^:private cachedCheckAlgorithm ^boolean [this ^String algorithm]
    (let [^:mutable ^{:tag (Map String Boolean)} cache nil]
      (when (nil? (set! cache (cast Map (.get cacheRef))))
        (locking this
          (when (nil? (set! cache (cast Map (.get cacheRef))))
            (set! cache (ConcurrentHashMap.))
            (set! cacheRef (SoftReference. cache)))))
      (let [^:mutable result (cast Boolean (.get cache algorithm))]
        (if (some? result)
            result
            (do
              (set! result
                    (and (DisabledAlgorithmConstraints/checkAlgorithm
                           disabledAlgorithms
                           algorithm
                           (.-decomposer this))
                         (.checkDisabledPatterns this algorithm)))
              (.put cache algorithm result)
              result)))))

  (method ^:private checkDisabledPatterns ^boolean [this ^:final ^String algorithm]
    (or (nil? disabledPatterns)
        (.noneMatch (.stream disabledPatterns)
                    (lambda Predicate ^boolean [^Pattern p] (.matches (.matcher p algorithm))))))

  (method ^:private getDisabledPatterns ^{:tag (List Pattern)} [this]
    (let [^:mutable ^{:tag (List Pattern)} ret nil
          ^{:tag (List String)} patternStrings (ArrayList. 4)]
      (for-each [^String p disabledAlgorithms]
        (when (.contains p "*")
          (when-not (.startsWith p "TLS_")
            (throw (IllegalArgumentException. "Wildcard pattern must start with \"TLS_\"")))
          (.add patternStrings p)))
      (when-not (.isEmpty patternStrings)
        (set! ret (ArrayList. (.size patternStrings)))
        (for-each [^String p patternStrings]
          (.remove disabledAlgorithms p)
          (.add ret (Pattern/compile (java-str "^\\Q" (.replace p "*" "\\E.*\\Q") "\\E$")))))
      ret))


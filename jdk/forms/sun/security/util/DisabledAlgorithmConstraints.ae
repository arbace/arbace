              (throw (CertPathValidatorException.
                       (java-str "Algorithm constraints check failed on keysize limits: "
                                 (.-algorithm this)
                                 " "
                                 (KeyUtil/getKeySize key)
                                 " bit key"
                                 (.extendedExceptionMsg cp))
                       nil
                       nil
                       -1
                       CertPathValidatorException$BasicReason/ALGORITHM_CONSTRAINED))))))


(in-ns 'sun.security.util)

(import '(java.io PrintStream)
        '(java.time Instant ZoneId)
        '(java.time.format DateTimeFormatter)
        '(java.util HexFormat Locale)
        '(java.util.function Function Predicate)
        '(java.util.stream Stream))

(defclass ^:public Debug
  (field ^:private ^String prefix)

  (field ^:private ^:static ^String args)

  (static-initializer
    (set! args (System/getProperty "java.security.debug"))
    (let [args2 (System/getProperty "java.security.auth.debug")]
      (cond (nil? args) (set! args args2) (some? args2) (set! args (java-str args "," args2)))
      (when (some? args)
        (set! args (.toLowerCase args Locale/ENGLISH))
        (when (.equals args "help") (Debug/Help)))))

  (method ^:public ^:static Help ^void []
    (.println System/err)
    (.println System/err "all           turn on all debugging")
    (.println System/err "certpath      PKIX CertPathBuilder and")
    (.println System/err "              CertPathValidator debugging")
    (.println System/err "combiner      SubjectDomainCombiner debugging")
    (.println System/err "gssloginconfig")
    (.println System/err "              GSS LoginConfigImpl debugging")
    (.println System/err "configfile    JAAS ConfigFile loading")
    (.println System/err "configparser  JAAS ConfigFile parsing")
    (.println System/err "jar           jar verification")
    (.println System/err "logincontext  login context results")
    (.println System/err "jca           JCA engine class debugging")
    (.println System/err "keystore      KeyStore debugging")
    (.println System/err "pcsc          Smartcard library debugging")
    (.println System/err "provider      security provider debugging")
    (.println System/err "pkcs11        PKCS11 session manager debugging")
    (.println System/err "pkcs11keystore")
    (.println System/err "              PKCS11 KeyStore debugging")
    (.println System/err "pkcs12        PKCS12 KeyStore debugging")
    (.println System/err "properties    Security property and configuration file debugging")
    (.println System/err "sunpkcs11     SunPKCS11 provider debugging")
    (.println System/err "securerandom  SecureRandom")
    (.println System/err "ts            timestamping")
    (.println System/err "x509          X.509 certificate debugging")
    (.println System/err)
    (.println System/err "The following can be used with provider:")
    (.println System/err)
    (.println System/err "engine=<engines>")
    (.println System/err "              only dump output for the specified list")
    (.println System/err "              of JCA engines. Supported values:")
    (.println System/err "              Cipher, KDF, KeyAgreement, KeyGenerator,")
    (.println System/err "              KeyPairGenerator, KeyStore, Mac,")
    (.println System/err "              MessageDigest, SecureRandom, Signature.")
    (.println System/err)
    (.println System/err "The following can be used with certpath:")
    (.println System/err)
    (.println System/err "ocsp          dump the OCSP protocol exchanges")
    (.println System/err "verbose       verbose debugging")
    (.println System/err)
    (.println System/err "The following can be used with x509:")
    (.println System/err)
    (.println
      System/err
      "ava           embed non-printable/non-escaped characters in AVA components as hex strings")
    (.println System/err)
    (.println System/err "Note: Separate multiple options with a comma")
    (System/exit 0))

  (method ^:public ^:static getInstance ^Debug [^String option]
    (Debug/getInstance option option))

  (method ^:public ^:static getInstance ^Debug [^String option ^String prefix]
    (when (Debug/isOn option) (let [d (Debug.)] (set! (.-prefix d) prefix) d)))

  (method ^:private ^:static formatCaller ^String []
    (cast String
          (.walk (StackWalker/getInstance)
                 (lambda Function ^String [^Stream s]
                   (cast String
                         (.orElse (.findFirst
                                    (.map (.dropWhile
                                            s
                                            (lambda Predicate ^boolean [^StackWalker$StackFrame f]
                                              (.startsWith
                                                (.getClassName f)
                                                "sun.security.util.Debug")))
                                          (lambda Function ^String [^StackWalker$StackFrame f]
                                            (java-str (.getFileName f) ":" (.getLineNumber f)))))
                                  "unknown caller"))))))

  (method ^:public ^:static of ^Debug [^String prefix ^String property]
    (when (and (some? property) (.startsWith (.toLowerCase property Locale/ROOT) "true"))
      (let [d (Debug.)] (set! (.-prefix d) prefix) d)))

  (method ^:public ^:static isOn ^boolean [^String option]
    (cond (nil? args) false (.contains args "all") true :else (.contains args option)))

  (method ^:public ^:static isVerbose ^boolean [] (Debug/isOn "verbose"))

  (method ^:public println ^void [this ^String message]
    (.println System/err (java-str prefix (.extraInfo this) ": " message)))

  (method ^:public println ^void [this obj ^String message]
    (.println System/err
              (java-str prefix
                        (.extraInfo this)
                        " ["
                        (.getSimpleName (.getClass obj))
                        "@"
                        (System/identityHashCode obj)
                        "]: "
                        message)))

  (method ^:public println ^void [this]
    (.println System/err (java-str prefix (.extraInfo this) ":")))

  (method ^:public println ^void [this ^String prefix ^String message]
    (.println System/err (java-str prefix (.extraInfo this) ": " message)))

  (method ^:private extraInfo ^String [this]
    (String/format "[0x%s|%s|%s|%s]"
                   (new Object/1
                        [(.toUpperCase (Long/toHexString (.threadId (Thread/currentThread)))
                                       Locale/ROOT)
                         (.getName (Thread/currentThread))
                         (Debug/formatCaller)
                         (.format FormatHolder/DATE_TIME_FORMATTER (Instant/now))])))

  (method ^:public getPrintStream ^PrintStream [this] System/err)

  (method ^:public ^:static toHexString ^String [^BigInteger b]
    (let [^:mutable hexValue (.toString b 16)
          sb (StringBuilder. (unchecked-multiply-int (.length hexValue) 2))]
      (if (.startsWith hexValue "-")
          (do (.append sb "   -") (set! hexValue (.substring hexValue 1)))
          (.append sb "    "))
      (when-not (== (unchecked-remainder-int (.length hexValue) 2) 0)
        (set! hexValue (java-str "0" hexValue)))
      (let [^:mutable ^int i 0]
        (while (< i (.length hexValue))
          (.append sb (.substring hexValue i (unchecked-add-int i 2)))
          (set! i (unchecked-add-int i 2))
          (when-not (== i (.length hexValue))
            (cond
              (== (unchecked-remainder-int i 64) 0) (.append sb "\n    ")
              (== (unchecked-remainder-int i 8) 0) (.append sb " "))))
        (.toString sb))))

  (method ^:public ^:static toString ^String [^byte/1 b]
    (if (nil? b) "(null)" (.formatHex (HexFormat/ofDelimiter ":") b)))

  (method ^:public ^:static toString ^String [^BigInteger b]
    (Debug/toString (.toByteArray b)))

  (defclass ^:private ^:static FormatHolder
    (field ^:private ^:static ^:final ^String PATTERN "yyyy-MM-dd kk:mm:ss.SSS")

    (field ^:private ^:static ^:final ^DateTimeFormatter DATE_TIME_FORMATTER
      (.withZone (DateTimeFormatter/ofPattern PATTERN Locale/ENGLISH) (ZoneId/systemDefault)))))

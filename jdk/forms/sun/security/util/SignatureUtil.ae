          ^:mutable kAlg (.getAlgorithm privateKey)]
      (cond
        (or (or (instance? EdECPrivateKey privateKey) (.equalsIgnoreCase kAlg "Ed25519"))
            (.equalsIgnoreCase kAlg "Ed448"))
          (do
            (when (instance? EdECPrivateKey privateKey)
              (set! kAlg (.getName (.getParams (cast EdECPrivateKey privateKey)))))

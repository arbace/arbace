  (method ^:public ^:static checkKeyAndSigAlgMatch ^void [^PrivateKey key ^:mutable ^String sAlg]
    (let [kAlg (.toUpperCase (.getAlgorithm key) Locale/ENGLISH)]
      (set! sAlg (SignatureUtil/checkName sAlg))
      (if-instance [^NamedPKCS8Key n8k key]
        (when (and (not (.equalsIgnoreCase sAlg (.getAlgorithm n8k)))
                   (not (.equalsIgnoreCase sAlg (.getName (.getParams n8k)))))
          (throw
            (IllegalArgumentException. "key algorithm not compatible with signature algorithm")))
        (switch sAlg
          "RSASSA-PSS"
            (when (and (not (.equals kAlg "RSASSA-PSS")) (not (.equals kAlg "RSA")))
              (throw (IllegalArgumentException.
                       "key algorithm not compatible with signature algorithm")))
          "EDDSA"
            (when (and (and (not (.equals kAlg "EDDSA")) (not (.equals kAlg "ED448")))
                       (not (.equals kAlg "ED25519")))
              (throw (IllegalArgumentException.
                       "key algorithm not compatible with signature algorithm")))
          ("ED25519" "ED448")
            (cond
              (instance? EdECKey key)
                (let [groupName (.toUpperCase (.getName (.getParams (cast EdECKey key))) Locale/US)]
                  (when-not (.equals sAlg groupName)
                    (throw (IllegalArgumentException.
                             "key algorithm not compatible with signature algorithm"))))
              (and (not (.equals kAlg "EDDSA")) (not (.equals kAlg sAlg)))
                (throw (IllegalArgumentException.
                         "key algorithm not compatible with signature algorithm")))
          (when (.contains sAlg "WITH")
            (when (or (or (and (.endsWith sAlg "WITHRSA") (not (.equals kAlg "RSA")))
                          (and (.endsWith sAlg "WITHECDSA") (not (.equals kAlg "EC"))))
                      (and (.endsWith sAlg "WITHDSA") (not (.equals kAlg "DSA"))))
              (throw (IllegalArgumentException.
                       "key algorithm not compatible with signature algorithm"))))))))

  (method ^:public ^:static getDefaultSigAlgForKey ^String [^PrivateKey k]
    (let [kAlg (.toUpperCase (.getAlgorithm k) Locale/ENGLISH)]
      (switch kAlg
        ("DH" "XDH" "X25519" "X448") nil
        "DSA" "SHA256withDSA"
        "RSA" (java-str (SignatureUtil/ifcFfcStrength (KeyUtil/getKeySize k)) "withRSA")
        "EC" (java-str (SignatureUtil/ecStrength (KeyUtil/getKeySize k)) "withECDSA")
        "EDDSA"
          (if (instance? EdECPrivateKey k) (.getName (.getParams (cast EdECPrivateKey k))) kAlg)
        (when-not (.contains kAlg "KEM") kAlg))))


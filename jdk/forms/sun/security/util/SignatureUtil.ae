      (if (> with 0)
          (.substring signatureAlgorithm 0 with)
          (throw (IllegalArgumentException.
                   (java-str "Cannot extract digest algorithm from " signatureAlgorithm))))))

  (method ^:public ^:static extractKeyAlgFromDwithE ^String [^:mutable ^String signatureAlgorithm]
    (set! signatureAlgorithm (.toUpperCase signatureAlgorithm Locale/ENGLISH))
    (let [with (.indexOf signatureAlgorithm "WITH")
          ^:mutable ^String keyAlgorithm nil]
      (when (> with 0)
        (let [and (.indexOf signatureAlgorithm "AND" (unchecked-add-int with 4))]
          (if (> and 0)
              (set! keyAlgorithm (.substring signatureAlgorithm (unchecked-add-int with 4) and))
              (set! keyAlgorithm (.substring signatureAlgorithm (unchecked-add-int with 4))))
          (when (.endsWith keyAlgorithm "INP1363FORMAT")
            (set! keyAlgorithm
                  (.substring keyAlgorithm 0 (unchecked-subtract-int (.length keyAlgorithm) 13))))
          (when (.equalsIgnoreCase keyAlgorithm "ECDSA") (set! keyAlgorithm "EC"))))
      keyAlgorithm))

  (method ^:public ^:static getDefaultParamSpec ^AlgorithmParameterSpec [^:mutable ^String sigAlg
                                                                         ^Key k]

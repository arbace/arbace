      (catch [NoSuchAlgorithmException IOException] e (throw (ProviderException. e)))))

  (method ^:public ^:static getParamSpec :throws [ProviderException] ^AlgorithmParameterSpec [^:mutable ^String sigName
                                                                                              ^:mutable ^AlgorithmParameters params]

                        (when (some? debug)
                          (.println debug
                                    (java-str "Signature File: Manifest Main Attributes digest "
                                              (.getAlgorithm digest)))
                          (.println debug
                                    (java-str "  sigfile  "
                                              (.formatHex (HexFormat/of) expectedHash)))
                          (.println debug
                                    (java-str "  computed "
                                              (.formatHex (HexFormat/of) computedHash)))
                          (.println debug))
                        (when-not (MessageDigest/isEqual computedHash expectedHash)
                          (set! attrsVerified false)
                          (when (some? debug)
                            (.println debug "Verification of Manifest main attributes failed")
                            (.println debug))
                          (break)))))))))))
      (when (some? debug)
        (.println debug "PermittedAlgs mapping: ")
        (for-each [^String key (.keySet permittedAlgs)]
          (.println debug (java-str key " : " (.toString (cast Boolean (.get permittedAlgs key)))))))
      (when validEntry
        (when weakAlgs
          (throw (SignatureException.

          ^:mutable ^CodeSigner/1 cachedSigners nil]
      (loop [^int i (unchecked-subtract-int (.size signerCache) 1)]
        (when-not (== i -1)
          (set! cachedSigners (cast CodeSigner/1 (.get signerCache i)))
          (if (SignatureFileVerifier/matches cachedSigners oldSigners newSigners)
              (do (.put signers name cachedSigners) (return))
              (recur (unchecked-dec-int i)))))
      (if (nil? oldSigners)
          (set! cachedSigners newSigners)
          (do
            (set! cachedSigners
                  (new CodeSigner/1 (unchecked-add-int (alength oldSigners) (alength newSigners))))
            (System/arraycopy oldSigners 0 cachedSigners 0 (alength oldSigners))
            (System/arraycopy newSigners 0 cachedSigners (alength oldSigners) (alength newSigners))))
      (.add signerCache cachedSigners)
      (when (> (.size signerCache) SIGNER_CACHE_SIZE) (^[int] List/.remove signerCache 0))
      (.put signers name cachedSigners)))


                                   (SignatureFileVerifier/contains oldSigners (aget signers i)))
                              (SignatureFileVerifier/contains newSigners (aget signers i)))]
                (if (not found) (return false) (recur (unchecked-inc-int i))))))
          true)))

  (method updateSigners ^void [this ^CodeSigner/1 newSigners
                               ^{:tag (Hashtable String CodeSigner/1)} signers ^String name]

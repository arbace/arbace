  (method ^:private getSigners :throws [IOException
                                        NoSuchAlgorithmException
                                        SignatureException
                                        CertificateException] ^CodeSigner/1 [this
                                                                             ^SignerInfo/1 infos
                                                                             ^PKCS7 block]
    (let [^:mutable ^{:tag (ArrayList CodeSigner)} signers nil]
      (loop [^int i 0]
        (when (< i (alength infos))
          (let [info (aget infos i)
                ^{:tag (ArrayList X509Certificate)} chain (.getCertificateChain info block)
                certChain (.generateCertPath certificateFactory chain)]
            (when (nil? signers) (set! signers (ArrayList.)))
            (.add signers (CodeSigner. certChain (.getTimestamp info)))
            (if (some? debug)
                (do
                  (.println debug (java-str "Signature Block Certificate: " (.get chain 0)))
                  (recur (unchecked-inc-int i)))
                (recur (unchecked-inc-int i))))))
      (when (some? signers) (cast CodeSigner/1 (.toArray signers (new CodeSigner/1 0))))))


          mde (.get md name (.isOldStyle block))
          ^:mutable weakAlgs true
          ^:mutable validEntry false]
      (when (nil? mde)
        (throw (SecurityException. (java-str "no manifest section for signature file entry " name))))
      (when (some? sfAttr)
        (for-each [^{:tag (Map$Entry Object Object)} se (.entrySet sfAttr)]
          (let [key (.toString (.getKey se))]
            (when (.endsWith (.toUpperCase key Locale/ENGLISH) "-DIGEST")
              (let [algorithm (.substring key 0 (unchecked-subtract-int (.length key) 7))]
                (set! validEntry true)
                (when-not (not (.permittedCheck this key algorithm))
                  (set! weakAlgs false)
                  (let [digest (.getDigest this algorithm)]
                    (when (some? digest)
                      (let [^:mutable ok false
                            expected (.decode (Base64/getMimeDecoder) (cast String (.getValue se)))
                            ^:mutable ^byte/1 computed (if workaround
                                                           (.digestWorkaround mde digest)
                                                           (.digest mde digest))]
                        (when (some? debug)
                          (.println debug
                                    (java-str "Signature Block File: "
                                              name
                                              " digest="
                                              (.getAlgorithm digest)))
                          (.println debug
                                    (java-str "  expected " (.formatHex (HexFormat/of) expected)))
                          (.println debug
                                    (java-str "  computed " (.formatHex (HexFormat/of) computed)))
                          (.println debug))
                        (if (MessageDigest/isEqual computed expected)
                            (do (set! oneDigestVerified true) (set! ok true))
                            (when-not workaround
                              (set! computed (.digestWorkaround mde digest))
                              (when (MessageDigest/isEqual computed expected)
                                (when (some? debug)
                                  (.println debug
                                            (java-str
                                              "  re-computed "
                                              (.formatHex (HexFormat/of) computed)))
                                  (.println debug))
                                (set! workaround true)
                                (set! oneDigestVerified true)
                                (set! ok true))))
                        (when-not ok
                          (throw (SecurityException.
                                   (java-str "invalid "
                                             (.getAlgorithm digest)
                                             " signature file digest for "
                                             name)))))))))))))
      (when (some? debug)
        (.println debug "PermittedAlgs mapping: ")
        (for-each [^String key (.keySet permittedAlgs)]
          (.println debug (java-str key " : " (.toString (cast Boolean (.get permittedAlgs key)))))))
      (when (and validEntry weakAlgs)
        (throw (SignatureException.
                 (java-str
                   "Manifest Main Attribute check failed (DIGEST).  Disabled algorithm(s) used: "
                   (.getWeakAlgorithms this "DIGEST")))))

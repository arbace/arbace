        (let [key (.toString (.getKey se))]
          (when (.endsWith (.toUpperCase key Locale/ENGLISH) ATTR_DIGEST)
            (let [algorithm (.substring
                              key
                              0
                              (unchecked-subtract-int (.length key) (.length ATTR_DIGEST)))]

                  (set! hr (unchecked-multiply-int 10 (DerValue/toDigit (aget buffer pos) type)))
                  (set! pos (unchecked-inc-int pos))
                  (set! hr (unchecked-add-int hr (DerValue/toDigit (aget buffer pos) type)))
                  (set! pos (unchecked-inc-int pos))
                  (set! min (unchecked-multiply-int 10 (DerValue/toDigit (aget buffer pos) type)))
                  (set! pos (unchecked-inc-int pos))
                  (set! min (unchecked-add-int min (DerValue/toDigit (aget buffer pos) type)))

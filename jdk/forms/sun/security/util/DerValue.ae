  (method ^:private ^:static toDigit :throws [IOException] ^int [^byte b ^String type]
    (when (or (< b \0) (> b \9))
      (throw (IOException. (java-str "Parse " type " time, invalid format"))))
    (unchecked-subtract-int b \0))

  (method ^:public getTime :throws [IOException] ^Date [this]
    (if (== tag tag_UtcTime) (.getUTCTime this) (.getGeneralizedTime this)))

  (method ^:public getUTCTime :throws [IOException] ^Date [this]

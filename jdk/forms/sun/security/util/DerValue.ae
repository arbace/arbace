    (.getTimeInternal this false))

  (method ^:public getGeneralizedTime :throws [IOException] ^Date [this]
    (when-not (== tag tag_GeneralizedTime)
      (throw (IOException. (java-str "DerValue.getGeneralizedTime, not a GeneralizedTime: " tag))))
    (when (< (unchecked-subtract-int end start) 13)
      (throw (IOException. "DER Generalized Time length error")))
    (set! (.-pos data) (.-end data))
    (.getTimeInternal this true))

  (method ^:public equals ^boolean [this o]
    (if (identical? this o)
        true
        (if-instance [^DerValue other o]
          (cond
            (not (== tag (.-tag other))) false
            (and (and (identical? buffer (.-buffer other)) (== start (.-start other)))
                 (== end (.-end other)))
              true
            :else (Arrays/equals buffer start end (.-buffer other) (.-start other) (.-end other)))
          false)))

  (method ^:public toString ^String [this]
    (String/format "DerValue(%02x, %s, %d, %d)"
                   (new Object/1
                        [(bit-and-int 0xff tag)
                         (.formatHex (.withUpperCase (HexFormat/of)) buffer)
                         start
                         end])))

  (method ^:public toByteArray ^byte/1 [this]
    (set! (.-pos data) (.-start data))
    (let [out (DerOutputStream.)]
      (.write out tag)
      (.putLength out (unchecked-subtract-int end start))
      (let [headLen (.size out)
            result (Arrays/copyOf (.buf out)
                                  (unchecked-add-int (unchecked-subtract-int end start) headLen))]
        (System/arraycopy buffer start result headLen (unchecked-subtract-int end start))
        result)))

  (method ^:public toDerInputStream :throws [IOException] ^DerInputStream [this]
    (if (or (== tag tag_Sequence) (== tag tag_Set))
        data
        (throw (IOException. (java-str "toDerInputStream rejects tag type " tag)))))

  (method ^:public length ^int [this] (unchecked-subtract-int end start))

  (method ^:public ^:static isPrintableStringChar ^boolean [^char ch]
    (if (or (or (and (>= ch \a) (<= ch \z)) (and (>= ch \A) (<= ch \Z)))
            (and (>= ch \0) (<= ch \9)))

                             (unchecked-multiply (aget a 8) (aget a 8)))
          c17 (unchecked-multiply 2 (unchecked-multiply (aget a 8) (aget a 9)))
          c18 (unchecked-multiply (aget a 9) (aget a 9))]
      (.carryReduce this r c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15 c16 c17 c18))))

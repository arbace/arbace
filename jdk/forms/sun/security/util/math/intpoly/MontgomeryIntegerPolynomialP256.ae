                           (bit-shift-right c2 BITS_PER_LIMB)))
      (set! c2 (bit-and c2 LIMB_MASK))
      (set! c4
            (unchecked-add (unchecked-subtract c9 (aget modulus 4))
                           (bit-shift-right c3 BITS_PER_LIMB)))
      (set! c3 (bit-and c3 LIMB_MASK))
      (let [mask (bit-shift-right c4 63)]
        (aset r 0 (bit-or (bit-and c5 mask) (bit-and c0 (bit-not mask))))
        (aset r 1 (bit-or (bit-and c6 mask) (bit-and c1 (bit-not mask))))
        (aset r 2 (bit-or (bit-and c7 mask) (bit-and c2 (bit-not mask))))
        (aset r 3 (bit-or (bit-and c8 mask) (bit-and c3 (bit-not mask))))
        (aset r 4 (bit-or (bit-and c9 mask) (bit-and c4 (bit-not mask)))))))

  (method ^:protected finalCarryReduceLast ^void [this ^long/1 limbs]
    (.reduce this limbs))

  (method ^:protected carryValue ^long [this ^long x]
    (bit-shift-right x BITS_PER_LIMB))

  (method ^:protected postEncodeCarry ^void [this ^long/1 v])

  (method ^:protected reduce ^void [this ^long/1 limbs]
    (let [^:mutable b0 (aget limbs 0)
          ^:mutable b1 (aget limbs 1)
          ^:mutable b2 (aget limbs 2)
          ^:mutable b3 (aget limbs 3)
          ^:mutable b4 (aget limbs 4)
          carry (bit-shift-right b4 48)]
      (set! b4 (unchecked-subtract b4 (bit-shift-left carry 48)))
      (set! b0 (unchecked-add b0 carry))
      (set! b1 (unchecked-subtract b1 (bit-shift-left carry 44)))
      (set! b3 (unchecked-subtract b3 (bit-shift-left carry 36)))
      (set! b4 (unchecked-add b4 (bit-shift-left carry 16)))
      (set! b1 (unchecked-add b1 (bit-shift-right b0 BITS_PER_LIMB)))
      (set! b2 (unchecked-add b2 (bit-shift-right b1 BITS_PER_LIMB)))
      (set! b3 (unchecked-add b3 (bit-shift-right b2 BITS_PER_LIMB)))
      (set! b4 (unchecked-add b4 (bit-shift-right b3 BITS_PER_LIMB)))
      (set! b0 (bit-and b0 LIMB_MASK))
      (set! b1 (bit-and b1 LIMB_MASK))
      (set! b2 (bit-and b2 LIMB_MASK))
      (set! b3 (bit-and b3 LIMB_MASK))
      (let [^:mutable ^long c0 0
            ^:mutable ^long c1 0
            ^:mutable ^long c2 0
            ^:mutable ^long c3 0
            ^:mutable ^long c4 0]
        (set! c0 (unchecked-add (aget modulus 0) b0))
        (set!
          c1
          (unchecked-add (unchecked-add (aget modulus 1) b1) (bit-shift-right c0 BITS_PER_LIMB)))
        (set! c0 (bit-and c0 LIMB_MASK))
        (set!
          c2
          (unchecked-add (unchecked-add (aget modulus 2) b2) (bit-shift-right c1 BITS_PER_LIMB)))
        (set! c1 (bit-and c1 LIMB_MASK))
        (set!
          c3
          (unchecked-add (unchecked-add (aget modulus 3) b3) (bit-shift-right c2 BITS_PER_LIMB)))
        (set! c2 (bit-and c2 LIMB_MASK))
        (set!
          c4
          (unchecked-add (unchecked-add (aget modulus 4) b4) (bit-shift-right c3 BITS_PER_LIMB)))
        (set! c3 (bit-and c3 LIMB_MASK))
        (let [mask (bit-shift-right b4 BITS_PER_LIMB)]
          (aset limbs 0 (bit-or (bit-and b0 (bit-not mask)) (bit-and c0 mask)))
          (aset limbs 1 (bit-or (bit-and b1 (bit-not mask)) (bit-and c1 mask)))
          (aset limbs 2 (bit-or (bit-and b2 (bit-not mask)) (bit-and c2 mask)))
          (aset limbs 3 (bit-or (bit-and b3 (bit-not mask)) (bit-and c3 mask)))
          (aset limbs 4 (bit-or (bit-and b4 (bit-not mask)) (bit-and c4 mask)))))))

  (method ^:public getElement ^IntegerPolynomial$ImmutableElement [this ^byte/1 v ^int offset
                                                                   ^int length ^byte highByte]
    (let [vLimbs (new long/1 NUM_LIMBS)
          montLimbs (new long/1 NUM_LIMBS)]
      (.encode super v offset length highByte vLimbs)
      (.mult this vLimbs h montLimbs)
      (IntegerPolynomial$ImmutableElement. montLimbs 0)))

  (method ^:protected reduceIn ^void [this ^long/1 limbs ^:mutable ^long v ^int i]
    (set! v (unchecked-add v (bit-shift-right v 32)))
    (let [i-1 (unchecked-subtract-int i 1)]
      (aset limbs i-1 (unchecked-add (aget limbs i-1) (bit-and (bit-shift-left v 20) LIMB_MASK))))
    (let [i-2 (unchecked-subtract-int i 2)]
      (aset limbs
            i-2
            (unchecked-subtract (aget limbs i-2) (bit-and (bit-shift-left v 40) LIMB_MASK))))
    (let [i-3 (unchecked-subtract-int i 1)]
      (aset limbs i-3 (unchecked-subtract (aget limbs i-3) (bit-shift-right v 12))))
    (let [i-4 (unchecked-subtract-int i 4)]
      (aset limbs
            i-4
            (unchecked-subtract (aget limbs i-4) (bit-and (bit-shift-left v 48) LIMB_MASK))))
    (let [i-5 (unchecked-subtract-int i 3)]
      (aset limbs i-5 (unchecked-subtract (aget limbs i-5) (bit-shift-right v 4))))
    (let [i-6 (unchecked-subtract-int i 5)]
      (aset limbs i-6 (unchecked-add (aget limbs i-6) (bit-and (bit-shift-left v 4) LIMB_MASK))))
    (let [i-7 (unchecked-subtract-int i 4)]
      (aset limbs i-7 (unchecked-add (aget limbs i-7) (bit-shift-right v 48))))))

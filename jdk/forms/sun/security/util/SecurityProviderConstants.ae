            (>= dhGroupSize 15360) 512
            (>= dhGroupSize 8192) 400
            (>= dhGroupSize 7680) 384
            (>= dhGroupSize 6144) 352
            (>= dhGroupSize 4096) 304
            (>= dhGroupSize 3072) 256
            (>= dhGroupSize 2048) 224
            :else 160)
          (^[int int] Math/max (if (>= dhGroupSize 2048) 1024 (bit-shift-right-int dhGroupSize 1))
                               384))))


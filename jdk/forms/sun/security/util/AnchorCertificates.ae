(in-ns 'sun.security.util)

(import '(java.io File FileInputStream)
        '(java.security KeyStore)
        '(java.security.cert X509Certificate)
        '(java.util Collections Enumeration HashSet Set)
        '(javax.security.auth.x500 X500Principal)
        '(sun.security.x509 X509CertImpl))

(defclass ^:public AnchorCertificates
  (field ^:private ^:static ^:final ^Debug debug (Debug/getInstance "certpath"))

  (field ^:private ^:static ^:final ^String HASH "SHA-256")

  (field ^:private ^:static ^{:tag (Set String)} certs (Collections/emptySet))

  (field ^:private ^:static ^{:tag (Set X500Principal)} certIssuers (Collections/emptySet))

  (static-initializer
    (let [f (File. (FilePaths/cacerts))]
      (try
        (let [cacerts (KeyStore/getInstance "JKS")]
          (with-resources [fis (FileInputStream. f)]
            (.load cacerts fis nil)
            (set! certs (HashSet.))
            (set! certIssuers (HashSet.))
            (let [^{:tag (Enumeration String)} list (.aliases cacerts)]
              (while (.hasMoreElements list)
                (let [alias (cast String (.nextElement list))]
                  (when (.contains alias " [jdk")
                    (let [cert (cast X509Certificate (.getCertificate cacerts alias))
                          fp (X509CertImpl/getFingerprint HASH cert debug)]
                      (when (some? fp)
                        (.add certs fp)
                        (.add certIssuers (.getSubjectX500Principal cert))))))))))
        (catch Exception e
          (when (some? debug) (.println debug "Error parsing cacerts") (.printStackTrace e))))))

  (method ^:public ^:static contains ^boolean [^X509Certificate cert]
    (let [key (X509CertImpl/getFingerprint HASH cert debug)
          result (and (some? key) (.contains certs key))]
      (when (and result (some? debug))
        (.println debug
                  (java-str "AnchorCertificate.contains: matched " (.getSubjectX500Principal cert))))
      result))

  (method ^:public ^:static issuerOf ^boolean [^X509Certificate cert]
    (.contains certIssuers (.getIssuerX500Principal cert)))

  (constructor ^:private [this]))

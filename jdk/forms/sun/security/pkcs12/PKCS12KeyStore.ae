    (.setCertEntry this alias cert nil))

  (method ^:private setCertEntry :throws [KeyStoreException] ^void [this ^String alias
                                                                    ^Certificate cert
                                                                    ^{:tag (Set KeyStore$Entry$Attribute)} attributes]
    (when (and (some? cert) (not (instance? X509Certificate cert)))
      (throw (KeyStoreException.
               (java-str "Only X.509 certificates are supported - rejecting class: "
                         (.getName (.getClass cert))))))
    (let [entry (cast Entry (.get entries (.toLowerCase alias Locale/ENGLISH)))]
      (when (instance? KeyEntry entry)
        (throw (KeyStoreException. "Cannot overwrite own certificate")))
      (let [certEntry (CertEntry. (cast X509Certificate cert) nil alias AnyUsage attributes)]
        (set! certificateCount (unchecked-inc-int certificateCount))
        (.populateAttributes this certEntry)
        (.put entries (.toLowerCase alias Locale/ENGLISH) certEntry)
        (when (some? debug)
          (.println debug (java-str "Setting a trusted certificate at alias '" alias "'"))))))

  (method ^:public ^:synchronized engineDeleteEntry :throws [KeyStoreException] ^void [this
                                                                                       ^String alias]
    (when (some? debug) (.println debug (java-str "Removing entry at alias '" alias "'")))
    (let [entry (cast Entry (.remove entries (.toLowerCase alias Locale/ENGLISH)))]
      (when (some? entry)
        (if-instance [^PrivateKeyEntry keyEntry entry]
          (do
            (when (some? (.-chain keyEntry))
              (set! certificateCount
                    (unchecked-subtract-int certificateCount (alength (.-chain keyEntry)))))
            (set! privateKeyCount (unchecked-dec-int privateKeyCount)))
          (cond
            (instance? CertEntry entry) (set! certificateCount (unchecked-dec-int certificateCount))
            (instance? SecretKeyEntry entry)
              (set! secretKeyCount (unchecked-dec-int secretKeyCount)))))))


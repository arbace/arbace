  (method ^:public ^:synchronized engineSetKeyEntry :throws [KeyStoreException] ^void [this
                                                                                       ^String alias
                                                                                       ^byte/1 key
                                                                                       ^Certificate/1 chain]
    (PKCS12KeyStore/checkX509Certs chain)
    (try
      (EncryptedPrivateKeyInfo. key)
      (catch IOException ioe
        (throw (KeyStoreException.
                 (java-str "Private key is not stored as PKCS#8 EncryptedPrivateKeyInfo: " ioe)
                 ioe))))
    (let [entry (PrivateKeyEntry.)]
      (set! (.-date entry) (Date.))
      (when (some? debug)
        (.println debug (java-str "Setting a protected private key at alias '" alias "'")))
      (set! (.-keyId entry)
            (.getBytes (java-str "Time " (.getTime (.-date entry))) StandardCharsets/UTF_8))
      (set! (.-alias entry) (.toLowerCase alias Locale/ENGLISH))
      (set! (.-protectedPrivKey entry) (.clone key))
      (when (some? chain)
        (when (and (> (alength chain) 1) (not (.validateChain this chain)))
          (throw (KeyStoreException. "Certificate chain is not valid")))
        (set! (.-chain entry) (.clone chain))
        (set! certificateCount (unchecked-add-int certificateCount (alength chain)))
        (when (some? debug)
          (.println debug
                    (java-str "Setting a "
                              (alength (.-chain entry))
                              "-certificate chain at alias '"
                              alias
                              "'"))))
      (set! privateKeyCount (unchecked-inc-int privateKeyCount))
      (.populateAttributes this entry)
      (.put entries (.toLowerCase alias Locale/ENGLISH) entry)))

  (method ^:private getSalt ^byte/1 [this]
    (let [salt (new byte/1 SALT_LEN)]
      (when (nil? random) (set! random (SecureRandom.)))
      (.nextBytes random salt)
      salt))

  (method ^:private getPBEAlgorithmParameters :throws [IOException] ^AlgorithmParameters [this
                                                                                          ^String algorithm
                                                                                          ^int iterationCount]
    (let [^:mutable ^AlgorithmParameters algParams nil
          ^:mutable salt (.getSalt this)]
      (when (identical? (KnownOIDs/findMatch algorithm) KnownOIDs/PBEWithMD5AndDES)
        (set! salt (Arrays/copyOf salt 8)))
      (let [paramSpec (PBEParameterSpec. salt iterationCount)]
        (try
          (set! algParams (AlgorithmParameters/getInstance algorithm))
          (.init algParams paramSpec)
          (catch Exception e
            (throw (IOException. (java-str "getPBEAlgorithmParameters failed: " (.getMessage e)) e))))
        algParams)))

  (method ^:private getPBEKey :throws [IOException] ^SecretKey [this ^char/1 password]
    (let [^:mutable ^SecretKey skey nil
          keySpec (PBEKeySpec. password)]
      (try
        (let [skFac (SecretKeyFactory/getInstance "PBE")]
          (set! skey (.generateSecret skFac keySpec)))
        (catch Exception e
          (throw (IOException. (java-str "getSecretKey failed: " (.getMessage e)) e)))
        (finally (.clearPassword keySpec)))
      skey))

  (method ^:private encryptPrivateKey :throws [UnrecoverableKeyException] ^byte/1 [this ^byte/1 data
                                                                                   ^KeyStore$PasswordProtection passwordProtection]
    (let [^:mutable ^byte/1 key nil]
      (try
        (let [^:mutable ^String algorithm nil
              ^:mutable ^AlgorithmParameters algParams nil
              ^:mutable ^AlgorithmId algid nil]
          (set! algorithm (.getProtectionAlgorithm passwordProtection))
          (if (some? algorithm)
              (let [algParamSpec (.getProtectionParameters passwordProtection)]
                (if (some? algParamSpec)
                    (do
                      (set! algParams (AlgorithmParameters/getInstance algorithm))
                      (.init algParams algParamSpec))
                    (set! algParams
                          (.getPBEAlgorithmParameters
                            this
                            algorithm
                            (PKCS12KeyStore/defaultKeyPbeIterationCount)))))
              (do
                (set! algorithm (PKCS12KeyStore/defaultKeyProtectionAlgorithm))
                (set! algParams
                      (.getPBEAlgorithmParameters
                        this
                        algorithm
                        (PKCS12KeyStore/defaultKeyPbeIterationCount)))))
          (let [pbeOID (PKCS12KeyStore/mapPBEAlgorithmToOID algorithm)]
            (when (nil? pbeOID)
              (throw (IOException. (java-str "PBE algorithm '"
                                             algorithm
                                             " 'is not supported for key entry protection"))))
            (let [cipher (Cipher/getInstance algorithm)
                  skey (.getPBEKey this (.getPassword passwordProtection))]
              (try
                (.init cipher Cipher/ENCRYPT_MODE skey algParams)
                (finally (KeyUtil/destroySecretKeys skey)))
              (let [encryptedKey (.doFinal cipher data)]
                (set! algid (AlgorithmId. pbeOID (.getParameters cipher)))
                (when (some? debug)
                  (.println debug (java-str "  (Cipher algorithm: " (.getAlgorithm cipher) ")")))
                (let [encrInfo (EncryptedPrivateKeyInfo. algid encryptedKey)]
                  (set! key (.getEncoded encrInfo)))))))
        (catch Exception e
          (let [uke (UnrecoverableKeyException.
                      (java-str "Encrypt Private Key failed: " (.getMessage e)))]
            (.initCause uke e)
            (throw uke))))
      key))

  (method ^:private ^:static mapPBEAlgorithmToOID :throws [NoSuchAlgorithmException] ^ObjectIdentifier [^String algorithm]
    (if (.startsWith (.toLowerCase algorithm Locale/ENGLISH) "pbewithhmacsha")
        pbes2_OID
        (.getOID (AlgorithmId/get algorithm))))

  (method ^:public ^:synchronized engineSetCertificateEntry :throws [KeyStoreException] ^void [this
                                                                                               ^String alias

  (method ^:public engineContainsAlias ^boolean [this ^String alias]
    (.containsKey entries (.toLowerCase alias Locale/ENGLISH)))

  (method ^:public engineSize ^int [this] (.size entries))

  (method ^:public engineIsKeyEntry ^boolean [this ^String alias]
    (let [entry (cast Entry (.get entries (.toLowerCase alias Locale/ENGLISH)))]
      (.internalIsKeyEntry this entry)))

  (method ^:private internalIsKeyEntry ^boolean [this ^Entry entry]
    (instance? KeyEntry entry))

  (method ^:public engineIsCertificateEntry ^boolean [this ^String alias]
    (let [entry (cast Entry (.get entries (.toLowerCase alias Locale/ENGLISH)))]
      (.internalIsCertificateEntry this entry)))

  (method ^:private internalIsCertificateEntry ^boolean [this ^Entry entry]
    (if-instance [^CertEntry certEntry entry] (some? (.-trustedKeyUsage certEntry)) false))

  (method ^:public engineEntryInstanceOf ^boolean [this ^String alias
                                                   ^{:tag (Class (? extends KeyStore$Entry))} entryClass]
    (if (identical? entryClass KeyStore$TrustedCertificateEntry)
        (.engineIsCertificateEntry this alias)
        (let [entry (cast Entry (.get entries (.toLowerCase alias Locale/ENGLISH)))]
          (cond
            (identical? entryClass KeyStore$PrivateKeyEntry) (instance? PrivateKeyEntry entry)
            (identical? entryClass KeyStore$SecretKeyEntry) (instance? SecretKeyEntry entry)
            :else false))))

  (method ^:public engineGetCertificateAlias ^String [this ^Certificate cert]
    (let [^:mutable ^Certificate certElem nil]
      (loop [^{:tag (Enumeration String)} e (.engineAliases this)]
        (when (.hasMoreElements e)
          (let [alias (cast String (.nextElement e))
                entry (cast Entry (.get entries alias))]
            (cond
              (instance? PrivateKeyEntry entry)
                (when (some? (.-chain (cast PrivateKeyEntry entry)))
                  (set! certElem (aget (.-chain (cast PrivateKeyEntry entry)) 0)))
              (and (instance? CertEntry entry) (some? (.-trustedKeyUsage (cast CertEntry entry))))
                (set! certElem (.-cert (cast CertEntry entry)))
              :else (continue e))
            (if (and (some? certElem) (.equals certElem cert)) (return alias) (recur e)))))
      nil))

  (method ^:public ^:synchronized engineStore :throws [IOException
                                                       NoSuchAlgorithmException
                                                       CertificateException] ^void [this
                                                                                    ^OutputStream stream
                                                                                    ^char/1 password]
    (let [pfx (DerOutputStream.)
          version (DerOutputStream.)]
      (.putInteger version VERSION_3)
      (let [pfxVersion (.toByteArray version)]
        (.writeBytes pfx pfxVersion)
        (let [authSafe (DerOutputStream.)
              authSafeContentInfo (DerOutputStream.)]
          (when (or (> privateKeyCount 0) (> secretKeyCount 0))
            (when (some? debug)
              (.println debug
                        (java-str "Storing "
                                  (unchecked-add-int privateKeyCount secretKeyCount)
                                  " protected key(s) in a PKCS#7 data")))
            (let [safeContentData (.createSafeContent this)
                  dataContentInfo (ContentInfo. safeContentData)]
              (.encode dataContentInfo authSafeContentInfo)))
          (when (> certificateCount 0)
            (when (nil? certProtectionAlgorithm)
              (set! certProtectionAlgorithm (PKCS12KeyStore/defaultCertProtectionAlgorithm)))
            (when (< certPbeIterationCount 0)
              (set! certPbeIterationCount (PKCS12KeyStore/defaultCertPbeIterationCount)))
            (when (some? debug)
              (.println debug
                        (java-str "Storing "
                                  certificateCount
                                  " certificate(s) in a PKCS#7 encryptedData")))
            (let [certsData (.getCertificateData this)]
              (if (and (some? password) (not (.equalsIgnoreCase certProtectionAlgorithm "NONE")))
                  (let [encrData (DerOutputStream.)]
                    (.putInteger encrData 0)
                    (.writeBytes encrData (.encryptContent this certsData password))
                    (let [encrDataContent (DerOutputStream.)]
                      (.write encrDataContent DerValue/tag_Sequence encrData)
                      (let [encrContentInfo (ContentInfo.
                                              ContentInfo/ENCRYPTED_DATA_OID
                                              (DerValue. (.toByteArray encrDataContent)))]
                        (.encode encrContentInfo authSafeContentInfo))))
                  (let [dataContentInfo (ContentInfo. certsData)]
                    (.encode dataContentInfo authSafeContentInfo)))))
          (let [cInfo (DerOutputStream.)]
            (.write cInfo DerValue/tag_SequenceOf authSafeContentInfo)
            (let [authenticatedSafe (.toByteArray cInfo)
                  contentInfo (ContentInfo. authenticatedSafe)]
              (.encode contentInfo authSafe)
              (let [authSafeData (.toByteArray authSafe)]
                (.writeBytes pfx authSafeData)
                (when (nil? macAlgorithm) (set! macAlgorithm (PKCS12KeyStore/defaultMacAlgorithm)))
                (when (< macIterationCount 0)
                  (set! macIterationCount (PKCS12KeyStore/defaultMacIterationCount)))
                (when (and (some? password) (not (.equalsIgnoreCase macAlgorithm "NONE")))
                  (let [macData (MacData/generateMac
                                  password
                                  authenticatedSafe
                                  macAlgorithm
                                  macIterationCount
                                  (.getSalt this))]
                    (.write pfx macData)))
                (let [pfxout (DerOutputStream.)]
                  (.write pfxout DerValue/tag_Sequence pfx)
                  (let [pfxData (.toByteArray pfxout)] (.write stream pfxData) (.flush stream))))))))))

  (method ^:public engineGetAttributes ^{:tag (Set KeyStore$Entry$Attribute)} [this ^String alias]
    (if (not (.engineContainsAlias this alias))
        (.engineGetAttributes super alias)
        (let [entry (cast Entry (.get entries (.toLowerCase alias Locale/ENGLISH)))]
          (Collections/unmodifiableSet (HashSet. (.-attributes entry))))))

  (method ^:public engineGetEntry :throws [KeyStoreException
                                           NoSuchAlgorithmException
                                           UnrecoverableEntryException] ^KeyStore$Entry [this
                                                                                         ^String alias
                                                                                         ^KeyStore$ProtectionParameter protParam]
    (when-not (not (.engineContainsAlias this alias))
      (let [entry (cast Entry (.get entries (.toLowerCase alias Locale/ENGLISH)))]
        (when (nil? protParam)
          (if (.internalIsCertificateEntry this entry)
              (do
                (when (some? debug)
                  (.println debug (java-str "Retrieved a trusted certificate at alias '" alias "'")))
                (return (KeyStore$TrustedCertificateEntry.
                          (.-cert (cast CertEntry entry))
                          (.-attributes entry))))
              (throw (UnrecoverableKeyException. "requested entry requires a password"))))
        (when (instance? KeyStore$PasswordProtection protParam)
          (cond
            (.internalIsCertificateEntry this entry)
              (throw (UnsupportedOperationException.
                       "trusted certificate entries are not password-protected"))
            (.internalIsKeyEntry this entry)
              (let [pp (cast KeyStore$PasswordProtection protParam)
                    password (.getPassword pp)
                    key (.internalGetKey this entry password)]
                (cond
                  (instance? PrivateKey key)
                    (let [chain (.internalGetCertificateChain this entry)]
                      (return (KeyStore$PrivateKeyEntry.
                                (cast PrivateKey key)
                                chain
                                (.-attributes entry))))
                  (instance? SecretKey key)
                    (return (KeyStore$SecretKeyEntry. (cast SecretKey key) (.-attributes entry)))))
            :else
              (throw (UnsupportedOperationException.
                       "untrusted certificate entries are not password-protected"))))
        (throw (UnsupportedOperationException.)))))

  (method ^:public ^:synchronized engineSetEntry :throws [KeyStoreException] ^void [this
                                                                                    ^String alias
                                                                                    ^KeyStore$Entry entry
                                                                                    ^KeyStore$ProtectionParameter protParam]
    (when (and (some? protParam) (not (instance? KeyStore$PasswordProtection protParam)))
      (throw (KeyStoreException. "unsupported protection parameter")))
    (let [^:mutable ^KeyStore$PasswordProtection pProtect nil]
      (when (some? protParam) (set! pProtect (cast KeyStore$PasswordProtection protParam)))
      (cond
        (instance? KeyStore$TrustedCertificateEntry entry)
          (if (and (some? protParam) (some? (.getPassword pProtect)))
              (throw (KeyStoreException. "trusted certificate entries are not password-protected"))
              (let [tce (cast KeyStore$TrustedCertificateEntry entry)]
                (.setCertEntry this alias (.getTrustedCertificate tce) (.getAttributes tce))
                (return)))
        (instance? KeyStore$PrivateKeyEntry entry)
          (if (or (nil? pProtect) (nil? (.getPassword pProtect)))
              (throw (KeyStoreException. "non-null password required to create PrivateKeyEntry"))
              (let [pke (cast KeyStore$PrivateKeyEntry entry)]
                (.setKeyEntry this
                              alias
                              (.getPrivateKey pke)
                              pProtect
                              (.getCertificateChain pke)
                              (.getAttributes pke))
                (return)))
        (instance? KeyStore$SecretKeyEntry entry)
          (if (or (nil? pProtect) (nil? (.getPassword pProtect)))
              (throw (KeyStoreException. "non-null password required to create SecretKeyEntry"))
              (let [ske (cast KeyStore$SecretKeyEntry entry)]
                (.setKeyEntry this alias (.getSecretKey ske) pProtect nil (.getAttributes ske))
                (return))))
      (throw
        (KeyStoreException. (java-str "unsupported entry type: " (.getName (.getClass entry)))))))

  (method ^:private populateAttributes ^void [this ^Entry entry]
    (when (nil? (.-attributes entry)) (set! (.-attributes entry) (HashSet.)))
    (.add (.-attributes entry) (PKCS12Attribute. (.toString PKCS9FriendlyName_OID) (.-alias entry)))
    (let [keyIdValue (.-keyId entry)]
      (when (some? keyIdValue)
        (.add (.-attributes entry)
              (PKCS12Attribute. (.toString PKCS9LocalKeyId_OID) (Debug/toString keyIdValue))))
      (when (instance? CertEntry entry)
        (let [trustedKeyUsageValue (.-trustedKeyUsage (cast CertEntry entry))]
          (when (some? trustedKeyUsageValue)
            (if (== (alength trustedKeyUsageValue) 1)
                (.add (.-attributes entry)
                      (PKCS12Attribute. (.toString TrustedKeyUsage_OID)
                                        (.toString (aget trustedKeyUsageValue 0))))
                (.add (.-attributes entry)
                      (PKCS12Attribute. (.toString TrustedKeyUsage_OID)
                                        (Arrays/toString trustedKeyUsageValue)))))))))

  (method ^:private validateChain ^boolean [this ^Certificate/1 certChain]
    (loop [^int i 0]
      (when (< i (unchecked-subtract-int (alength certChain) 1))
        (let [issuerDN (.getIssuerX500Principal (cast X509Certificate (aget certChain i)))
              subjectDN (.getSubjectX500Principal
                          (cast X509Certificate (aget certChain (unchecked-add-int i 1))))]
          (if (not (.equals issuerDN subjectDN)) (return false) (recur (unchecked-inc-int i))))))
    (let [^{:tag (Set Certificate)} set (HashSet. (Arrays/asList certChain))]
      (== (.size set) (alength certChain))))

  (method ^:private ^:static checkX509Certs :throws [KeyStoreException] ^void [^Certificate/1 certs]
    (when (some? certs)
      (for-each [^Certificate cert certs]
        (when-not (instance? X509Certificate cert)
          (throw (KeyStoreException.
                   (java-str "Only X.509 certificates are supported - rejecting class: "
                             (.getName (.getClass cert)))))))))

  (method ^:private getBagAttributes ^byte/1 [this ^String alias ^byte/1 keyId
                                              ^{:tag (Set KeyStore$Entry$Attribute)} attributes]
    (.getBagAttributes this alias keyId nil attributes))

  (method ^:private getBagAttributes ^byte/1 [this ^String alias ^byte/1 keyId
                                              ^ObjectIdentifier/1 trustedUsage
                                              ^{:tag (Set KeyStore$Entry$Attribute)} attributes]
    (let [^:mutable ^byte/1 localKeyID nil
          ^:mutable ^byte/1 friendlyName nil
          ^:mutable ^byte/1 trustedKeyUsage nil]
      (when-not (and (nil? alias) (nil? keyId))
        (let [bagAttrs (DerOutputStream.)]
          (when (some? alias)
            (let [bagAttr1 (DerOutputStream.)]
              (.putOID bagAttr1 PKCS9FriendlyName_OID)
              (let [bagAttrContent1 (DerOutputStream.)
                    bagAttrValue1 (DerOutputStream.)]
                (.putBMPString bagAttrContent1 alias)
                (.write bagAttr1 DerValue/tag_Set bagAttrContent1)
                (.write bagAttrValue1 DerValue/tag_Sequence bagAttr1)
                (set! friendlyName (.toByteArray bagAttrValue1)))))
          (when (some? keyId)
            (let [bagAttr2 (DerOutputStream.)]
              (.putOID bagAttr2 PKCS9LocalKeyId_OID)
              (let [bagAttrContent2 (DerOutputStream.)
                    bagAttrValue2 (DerOutputStream.)]
                (.putOctetString bagAttrContent2 keyId)
                (.write bagAttr2 DerValue/tag_Set bagAttrContent2)
                (.write bagAttrValue2 DerValue/tag_Sequence bagAttr2)
                (set! localKeyID (.toByteArray bagAttrValue2)))))
          (when (some? trustedUsage)
            (let [bagAttr3 (DerOutputStream.)]
              (.putOID bagAttr3 TrustedKeyUsage_OID)
              (let [bagAttrContent3 (DerOutputStream.)
                    bagAttrValue3 (DerOutputStream.)]
                (for-each [^ObjectIdentifier usage trustedUsage] (.putOID bagAttrContent3 usage))
                (.write bagAttr3 DerValue/tag_Set bagAttrContent3)
                (.write bagAttrValue3 DerValue/tag_Sequence bagAttr3)
                (set! trustedKeyUsage (.toByteArray bagAttrValue3)))))
          (let [attrs (DerOutputStream.)]
            (when (some? friendlyName) (.writeBytes attrs friendlyName))
            (when (some? localKeyID) (.writeBytes attrs localKeyID))
            (when (some? trustedKeyUsage) (.writeBytes attrs trustedKeyUsage))
            (when (some? attributes)
              (for-each [^KeyStore$Entry$Attribute attribute attributes]
                (let [attributeName (.getName attribute)]
                  (when-not (or (or (.equals (.value (aget CORE_ATTRIBUTES 0)) attributeName)
                                    (.equals (.value (aget CORE_ATTRIBUTES 1)) attributeName))
                                (.equals (.value (aget CORE_ATTRIBUTES 2)) attributeName))
                    (.writeBytes attrs (.getEncoded (cast PKCS12Attribute attribute)))))))
            (.write bagAttrs DerValue/tag_Set attrs)
            (.toByteArray bagAttrs))))))

  (method ^:private getCertificateData :throws [CertificateException] ^byte/1 [this]
    (let [out (DerOutputStream.)]
      (loop [^{:tag (Enumeration String)} e (.engineAliases this)]
        (when (.hasMoreElements e)
          (let [alias (cast String (.nextElement e))
                entry (cast Entry (.get entries alias))
                ^Certificate/1 certs (if-instance [^PrivateKeyEntry keyEntry entry]
                                       (if (some? (.-chain keyEntry))
                                           (.-chain keyEntry)
                                           (new Certificate/1 0))
                                       (if (instance? CertEntry entry)
                                           (new Certificate/1 [(.-cert (cast CertEntry entry))])
                                           (new Certificate/1 0)))]
            (loop [^int i 0]
              (when (< i (alength certs))
                (let [safeBag (DerOutputStream.)]
                  (.putOID safeBag CertBag_OID)
                  (let [certBag (DerOutputStream.)]
                    (.putOID certBag PKCS9CertType_OID)
                    (let [certValue (DerOutputStream.)
                          cert (cast X509Certificate (aget certs i))]
                      (.putOctetString certValue (.getEncoded cert))
                      (.write certBag
                              (DerValue/createTag DerValue/TAG_CONTEXT true (unchecked-byte 0))
                              certValue)
                      (let [certout (DerOutputStream.)]
                        (.write certout DerValue/tag_Sequence certBag)
                        (let [certBagValue (.toByteArray certout)
                              bagValue (DerOutputStream.)]
                          (.writeBytes bagValue certBagValue)
                          (.write safeBag
                                  (DerValue/createTag DerValue/TAG_CONTEXT true (unchecked-byte 0))
                                  bagValue)
                          (let [^:mutable ^byte/1 bagAttrs nil]
                            (if (== i 0)
                                (if-instance [^KeyEntry keyEntry entry]
                                  (set! bagAttrs
                                        (.getBagAttributes
                                          this
                                          (.-alias keyEntry)
                                          (.-keyId keyEntry)
                                          (.-attributes keyEntry)))
                                  (let [certEntry (cast CertEntry entry)]
                                    (set! bagAttrs
                                          (.getBagAttributes
                                            this
                                            (.-alias certEntry)
                                            (.-keyId certEntry)
                                            (.-trustedKeyUsage certEntry)
                                            (.-attributes certEntry)))))
                                (set! bagAttrs
                                      (.getBagAttributes
                                        this
                                        (.getName (.getSubjectX500Principal cert))
                                        nil
                                        (.-attributes entry))))
                            (when (some? bagAttrs) (.writeBytes safeBag bagAttrs))
                            (.write out DerValue/tag_Sequence safeBag)
                            (recur (unchecked-inc-int i))))))))))
            (recur e))))
      (let [safeBagValue (DerOutputStream.)]
        (.write safeBagValue DerValue/tag_SequenceOf out)
        (.toByteArray safeBagValue))))

  (method ^:private createSafeContent :throws [IOException] ^byte/1 [this]
    (let [out (DerOutputStream.)]
      (loop [^{:tag (Enumeration String)} e (.engineAliases this)]
        (when (.hasMoreElements e)
          (let [alias (cast String (.nextElement e))
                entry (cast Entry (.get entries alias))]
            (if-instance [^KeyEntry keyEntry entry]
              (let [safeBag (DerOutputStream.)]
                (cond
                  (instance? PrivateKeyEntry keyEntry)
                    (do
                      (.putOID safeBag PKCS8ShroudedKeyBag_OID)
                      (let [encrBytes (.-protectedPrivKey (cast PrivateKeyEntry keyEntry))
                            ^:mutable ^EncryptedPrivateKeyInfo encrInfo nil]
                        (try
                          (set! encrInfo (EncryptedPrivateKeyInfo. encrBytes))
                          (catch IOException ioe
                            (throw (IOException.
                                     (java-str
                                       "Private key not stored as PKCS#8 EncryptedPrivateKeyInfo"
                                       (.getMessage ioe))))))
                        (let [bagValue (DerOutputStream.)]
                          (.writeBytes bagValue (.getEncoded encrInfo))
                          (.write safeBag
                                  (DerValue/createTag DerValue/TAG_CONTEXT true (unchecked-byte 0))
                                  bagValue))))
                  (instance? SecretKeyEntry keyEntry)
                    (do
                      (.putOID safeBag SecretBag_OID)
                      (let [secretBag (DerOutputStream.)]
                        (.putOID secretBag PKCS8ShroudedKeyBag_OID)
                        (let [secretKeyValue (DerOutputStream.)]
                          (.putOctetString secretKeyValue
                                           (.-protectedSecretKey (cast SecretKeyEntry keyEntry)))
                          (.write secretBag
                                  (DerValue/createTag DerValue/TAG_CONTEXT true (unchecked-byte 0))
                                  secretKeyValue)
                          (let [secretBagSeq (DerOutputStream.)]
                            (.write secretBagSeq DerValue/tag_Sequence secretBag)
                            (let [secretBagValue (.toByteArray secretBagSeq)
                                  bagValue (DerOutputStream.)]
                              (.writeBytes bagValue secretBagValue)
                              (.write safeBag
                                      (DerValue/createTag
                                        DerValue/TAG_CONTEXT
                                        true
                                        (unchecked-byte 0))
                                      bagValue))))))
                  :else (continue e))
                (let [bagAttrs (.getBagAttributes this alias (.-keyId entry) (.-attributes entry))]
                  (.writeBytes safeBag bagAttrs)
                  (.write out DerValue/tag_Sequence safeBag)
                  (recur e)))
              (recur e)))))
      (let [safeBagValue (DerOutputStream.)]
        (.write safeBagValue DerValue/tag_Sequence out)
        (.toByteArray safeBagValue))))

  (method ^:private encryptContent :throws [IOException] ^byte/1 [this ^byte/1 data ^char/1 password]
    (let [^:mutable ^byte/1 encryptedData nil]
      (try
        (let [algParams (.getPBEAlgorithmParameters
                          this
                          certProtectionAlgorithm
                          certPbeIterationCount)
              bytes (DerOutputStream.)
              cipher (Cipher/getInstance certProtectionAlgorithm)
              skey (.getPBEKey this password)]
          (try
            (.init cipher Cipher/ENCRYPT_MODE skey algParams)
            (finally (KeyUtil/destroySecretKeys skey)))
          (set! encryptedData (.doFinal cipher data))
          (let [algId (AlgorithmId. (PKCS12KeyStore/mapPBEAlgorithmToOID certProtectionAlgorithm)
                                    (.getParameters cipher))]
            (.encode algId bytes)
            (let [encodedAlgId (.toByteArray bytes)]
              (when (some? debug)
                (.println debug (java-str "  (Cipher algorithm: " (.getAlgorithm cipher) ")")))
              (let [bytes2 (DerOutputStream.)]
                (.putOID bytes2 ContentInfo/DATA_OID)
                (.writeBytes bytes2 encodedAlgId)
                (let [tmpout2 (DerOutputStream.)]
                  (.putOctetString tmpout2 encryptedData)
                  (.writeImplicit bytes2
                                  (DerValue/createTag DerValue/TAG_CONTEXT false (unchecked-byte 0))
                                  tmpout2)
                  (let [out (DerOutputStream.)]
                    (.write out DerValue/tag_Sequence bytes2)
                    (.toByteArray out)))))))
        (catch IOException ioe (throw ioe))
        (catch Exception e
          (throw (IOException. (java-str "Failed to encrypt safe contents entry: " e) e))))))

  (method ^:public ^:synchronized engineLoad :throws [IOException
                                                      NoSuchAlgorithmException
                                                      CertificateException] ^void [this
                                                                                   ^InputStream stream
                                                                                   ^char/1 password]
    (set! certProtectionAlgorithm nil)
    (set! certPbeIterationCount -1)
    (set! macAlgorithm nil)
    (set! macIterationCount -1)
    (when (some? stream)
      (set! counter 0)
      (let [val (DerValue. stream)
            s (.toDerInputStream val)
            version (.getInteger s)]
        (when-not (== version VERSION_3)
          (throw (IOException. "PKCS12 keystore not in version 3 format")))
        (.clear entries)
        (let [^:mutable ^byte/1 authSafeData nil
              authSafe (ContentInfo. s)
              ^:mutable contentType (.getContentType authSafe)]
          (if (.equals contentType ContentInfo/DATA_OID)
              (set! authSafeData (.getData authSafe))
              (throw (IOException. "public key protected PKCS12 not supported")))
          (let [as (DerInputStream. authSafeData)
                safeContentsArray (.getSequence as 2)
                count (alength safeContentsArray)]
            (set! privateKeyCount 0)
            (set! secretKeyCount 0)
            (set! certificateCount 0)
            (let [^:mutable seeEncBag false]
              (loop [^int i 0]
                (when (< i count)
                  (let [^:mutable ^ContentInfo safeContents nil
                        ^:mutable ^DerInputStream sci nil
                        ^:mutable ^byte/1 eAlgId nil]
                    (set! sci (DerInputStream. (.toByteArray (aget safeContentsArray i))))
                    (set! safeContents (ContentInfo. sci))
                    (set! contentType (.getContentType safeContents))
                    (cond
                      (.equals contentType ContentInfo/DATA_OID)
                        (do
                          (when (some? debug) (.println debug "Loading PKCS#7 data"))
                          (.loadSafeContents this (DerInputStream. (.getData safeContents)))
                          (recur (unchecked-inc-int i)))
                      (.equals contentType ContentInfo/ENCRYPTED_DATA_OID)
                        (if (nil? password)
                            (do
                              (when (some? debug)
                                (.println
                                  debug
                                  "Warning: skipping PKCS#7 encryptedData - no password was supplied"))
                              (recur (unchecked-inc-int i)))
                            (let [edi (.toDerInputStream (.getContent safeContents))
                                  edVersion (.getInteger edi)
                                  seq (.getSequence edi 3)]
                              (when-not (== (alength seq) 3)
                                (throw (IOException. "Invalid length for EncryptedContentInfo")))
                              (let [edContentType (.getOID (aget seq 0))]
                                (set! eAlgId (.toByteArray (aget seq 1)))
                                (when-not (.isContextSpecific (aget seq 2) (unchecked-byte 0))
                                  (throw (IOException.
                                           (java-str
                                             "unsupported encrypted content type "
                                             (.-tag (aget seq 2))))))
                                (let [^:mutable newTag DerValue/tag_OctetString]
                                  (when (.isConstructed (aget seq 2))
                                    (set! newTag (unchecked-byte (bit-or-int newTag 0x20))))
                                  (.resetTag (aget seq 2) newTag)
                                  (let [rawData (.getOctetString (aget seq 2))
                                        aid (AlgorithmId/parse (aget seq 1))
                                        algParams (.getParameters aid)
                                        ^:mutable ^PBEParameterSpec pbeSpec nil
                                        ^:mutable ^int ic 0]
                                    (when (some? algParams)
                                      (try
                                        (set! pbeSpec
                                              (cast
                                                PBEParameterSpec
                                                (.getParameterSpec algParams PBEParameterSpec)))
                                        (catch InvalidParameterSpecException ipse
                                          (throw (IOException. "Invalid PBE algorithm parameters"))))
                                      (set! ic (.getIterationCount pbeSpec))
                                      (when (> ic MAX_ITERATION_COUNT)
                                        (throw (IOException. "cert PBE iteration count too large")))
                                      (set! certProtectionAlgorithm (.getName aid))
                                      (set! certPbeIterationCount ic)
                                      (set! seeEncBag true))
                                    (when (some? debug)
                                      (.println debug
                                                (java-str
                                                  "Loading PKCS#7 encryptedData ("
                                                  certProtectionAlgorithm
                                                  " iterations: "
                                                  ic
                                                  ")")))
                                    (try
                                      (RetryWithZero/run
                                        (lambda RetryWithZero [^char/1 pass]
                                          (let [cipher (Cipher/getInstance certProtectionAlgorithm)
                                                skey (.getPBEKey this pass)]
                                            (try
                                              (.init cipher Cipher/DECRYPT_MODE skey algParams)
                                              (finally (KeyUtil/destroySecretKeys skey)))
                                            (.loadSafeContents
                                              this
                                              (DerInputStream. (.doFinal cipher rawData)))
                                            nil))
                                        password)
                                      (catch Exception e
                                        (throw (IOException.
                                                 "keystore password was incorrect"
                                                 (UnrecoverableKeyException.
                                                   (java-str
                                                     "failed to decrypt safe contents entry: "
                                                     e))))))
                                    (recur (unchecked-inc-int i)))))))
                      :else (throw (IOException. "public key protected PKCS12 not supported"))))))
              (when (and (not seeEncBag) (> certificateCount 0))
                (set! certProtectionAlgorithm "NONE"))
              (if (> (.available s) 0)
                  (when (some? password)
                    (let [macData (MacData. s)
                          ic (.getIterations macData)]
                      (try
                        (when (> ic MAX_ITERATION_COUNT)
                          (throw (InvalidAlgorithmParameterException.
                                   (java-str "MAC iteration count too large: " ic))))
                        (set! macAlgorithm (.getMacAlgorithm macData))
                        (set! macIterationCount ic)
                        (RetryWithZero/run
                          (let [authSafeData authSafeData]
                            (lambda RetryWithZero ^Void [^char/1 pass]
                              (.verifyMac macData pass authSafeData)
                              (cast Void nil)))
                          password)
                        (catch Exception e
                          (throw (IOException. (java-str "Integrity check failed: " e) e))))))
                  (set! macAlgorithm "NONE"))
              (let [list (cast PrivateKeyEntry/1 (.toArray keyList (new PrivateKeyEntry/1 0)))]
                (loop [^int m 0]
                  (when (< m (alength list))
                    (let [entry (aget list m)]
                      (if (some? (.-keyId entry))
                          (let [^{:tag (ArrayList X509Certificate)} chain (ArrayList.)
                                ^:mutable cert (.findMatchedCertificate this entry)]
                            (label :mainloop
                              (while (some? cert)
                                (when-not (.isEmpty chain)
                                  (for-each [^X509Certificate chainCert chain]
                                    (when (.equals cert chainCert)
                                      (when (some? debug)
                                        (.println
                                          debug
                                          (java-str
                                            "Loop detected in certificate chain. Skip adding repeated cert to chain. Subject: "
                                            (.toString (.getSubjectX500Principal cert)))))
                                      (break :mainloop))))
                                (.add chain cert)
                                (when (KeyStoreUtil/isSelfSigned cert) (break))
                                (set! cert (.findIssuer this cert))))
                            (if (> (.size chain) 0)
                                (do
                                  (set! (.-chain entry)
                                        (cast Certificate/1 (.toArray chain (new Certificate/1 0))))
                                  (recur (unchecked-inc-int m)))
                                (recur (unchecked-inc-int m))))
                          (recur (unchecked-inc-int m))))))
                (when (some? debug)
                  (.println debug
                            (java-str "PKCS12KeyStore load: private key count: "
                                      privateKeyCount
                                      ". secret key count: "
                                      secretKeyCount
                                      ". certificate count: "
                                      certificateCount)))
                (.clear certEntries)
                (.clear allCerts)
                (.clear keyList))))))))

  (method ^:private findIssuer ^X509Certificate [this ^X509Certificate input]
    (let [^:mutable ^X509Certificate fallback nil
          issuerPrinc (.getIssuerX500Principal input)
          issuerIdExtension (.getExtensionValue input (.value KnownOIDs/AuthorityKeyID))
          ^:mutable ^byte/1 issuerId nil]
      (when (some? issuerIdExtension)
        (try
          (set! issuerId
                (.getEncodedKeyIdentifier
                  (AuthorityKeyIdentifierExtension.
                    false
                    (.getOctetString (DerValue. issuerIdExtension)))))
          (catch IOException e)))
      (for-each [^X509Certificate cert allCerts]
        (when (.equals (.getSubjectX500Principal cert) issuerPrinc)
          (if (some? issuerId)
              (let [subjectIdExtension (.getExtensionValue cert (.value KnownOIDs/SubjectKeyID))
                    ^:mutable ^byte/1 subjectId nil]
                (when (some? subjectIdExtension)
                  (try
                    (set! subjectId (.getOctetString (DerValue. subjectIdExtension)))
                    (catch IOException e)))
                (if (some? subjectId)
                    (when (Arrays/equals issuerId subjectId) (return cert))
                    (set! fallback cert)))
              (return cert))))
      fallback))

  (method ^:public ^:static isPasswordless :throws [IOException] ^boolean [^File f]
    (with-resources [stream (FileInputStream. f)]
      (let [val (DerValue. stream)
            s (.toDerInputStream val)]
        (.getInteger s)
        (let [authSafe (ContentInfo. s)
              as (DerInputStream. (.getData authSafe))]
          (for-each [^DerValue seq (.getSequence as 2)]
            (let [sci (DerInputStream. (.toByteArray seq))
                  safeContents (ContentInfo. sci)]
              (when (.equals (.getContentType safeContents) ContentInfo/ENCRYPTED_DATA_OID)
                (return false))))
          (when (> (.available s) 0) (return false)))))
    true)

  (method ^:private findMatchedCertificate ^X509Certificate [this ^PrivateKeyEntry entry]
    (let [^:mutable ^CertEntry keyIdMatch nil
          ^:mutable ^CertEntry aliasMatch nil]
      (for-each [^CertEntry ce certEntries]
        (cond
          (Arrays/equals (.-keyId entry) (.-keyId ce))
            (do
              (set! keyIdMatch ce)
              (when (.equalsIgnoreCase (.-alias entry) (.-alias ce)) (return (.-cert ce))))
          (.equalsIgnoreCase (.-alias entry) (.-alias ce)) (set! aliasMatch ce)))
      (cond (some? keyIdMatch) (.-cert keyIdMatch) (some? aliasMatch) (.-cert aliasMatch))))

  (method ^:private loadSafeContents :throws [IOException CertificateException] ^void [this
                                                                                       ^DerInputStream stream]
    (let [safeBags (.getSequence stream 2)
          count (alength safeBags)]
      (loop [^int i 0]
        (when (< i count)
          (let [^:mutable ^ObjectIdentifier bagId nil
                ^:mutable ^DerInputStream sbi nil
                ^:mutable ^DerValue bagValue nil
                ^:mutable ^Object bagItem nil]
            (set! sbi (.toDerInputStream (aget safeBags i)))
            (set! bagId (.getOID sbi))
            (set! bagValue (.getDerValue sbi))
            (when-not (.isContextSpecific bagValue (unchecked-byte 0))
              (throw
                (IOException. (java-str "unsupported PKCS12 bag value type " (.-tag bagValue)))))
            (set! bagValue (.getDerValue (.-data bagValue)))
            (cond
              (.equals bagId PKCS8ShroudedKeyBag_OID)
                (let [kEntry (PrivateKeyEntry.)]
                  (set! (.-protectedPrivKey kEntry) (.toByteArray bagValue))
                  (set! bagItem kEntry)
                  (set! privateKeyCount (unchecked-inc-int privateKeyCount)))
              (.equals bagId CertBag_OID)
                (let [cs (DerInputStream. (.toByteArray bagValue))
                      certValues (.getSequence cs 2)]
                  (when-not (== (alength certValues) 2)
                    (throw (IOException. "Invalid length for CertBag")))
                  (let [certId (.getOID (aget certValues 0))]
                    (when-not (.isContextSpecific (aget certValues 1) (unchecked-byte 0))
                      (throw (IOException. (java-str
                                             "unsupported PKCS12 cert value type "
                                             (.-tag (aget certValues 1))))))
                    (let [certValue (.getDerValue (.-data (aget certValues 1)))
                          cf (CertificateFactory/getInstance "X509")
                          ^:mutable ^X509Certificate cert nil]
                      (set! cert
                            (cast X509Certificate
                                  (.generateCertificate
                                    cf
                                    (ByteArrayInputStream. (.getOctetString certValue)))))
                      (set! bagItem cert)
                      (set! certificateCount (unchecked-inc-int certificateCount)))))
              (.equals bagId SecretBag_OID)
                (let [ss (DerInputStream. (.toByteArray bagValue))
                      secretValues (.getSequence ss 2)]
                  (when-not (== (alength secretValues) 2)
                    (throw (IOException. "Invalid length for SecretBag")))
                  (let [secretId (.getOID (aget secretValues 0))]
                    (when-not (.isContextSpecific (aget secretValues 1) (unchecked-byte 0))
                      (throw (IOException. (java-str
                                             "unsupported PKCS12 secret value type "
                                             (.-tag (aget secretValues 1))))))
                    (let [secretValue (.getDerValue (.-data (aget secretValues 1)))
                          kEntry (SecretKeyEntry.)]
                      (set! (.-protectedSecretKey kEntry) (.getOctetString secretValue))
                      (set! bagItem kEntry)
                      (set! secretKeyCount (unchecked-inc-int secretKeyCount)))))
              (some? debug) (.println debug (java-str "Unsupported PKCS12 bag type: " bagId)))
            (let [^:mutable ^DerValue/1 attrSet nil]
              (try (set! attrSet (.getSet sbi 3)) (catch IOException e (set! attrSet nil)))
              (let [^:mutable ^String alias nil
                    ^:mutable ^byte/1 keyId nil
                    ^:mutable ^ObjectIdentifier/1 trustedKeyUsage nil
                    ^{:tag (Set PKCS12Attribute)} attributes (HashSet.)]
                (when (some? attrSet)
                  (loop [^int j 0]
                    (when (< j (alength attrSet))
                      (let [encoded (.toByteArray (aget attrSet j))
                            as (DerInputStream. encoded)
                            attrSeq (.getSequence as 2)]
                        (when-not (== (alength attrSeq) 2)
                          (throw (IOException. "Invalid length for Attribute")))
                        (let [attrId (.getOID (aget attrSeq 0))
                              vs (DerInputStream. (.toByteArray (aget attrSeq 1)))
                              ^:mutable ^DerValue/1 valSet nil]
                          (try
                            (set! valSet (.getSet vs 1))
                            (catch IOException e
                              (throw (IOException.
                                       (java-str
                                         "Attribute "
                                         attrId
                                         " should have a value "
                                         (.getMessage e))))))
                          (cond
                            (.equals attrId PKCS9FriendlyName_OID)
                              (do
                                (set! alias (.getBMPString (aget valSet 0)))
                                (recur (unchecked-inc-int j)))
                            (.equals attrId PKCS9LocalKeyId_OID)
                              (do
                                (set! keyId (.getOctetString (aget valSet 0)))
                                (recur (unchecked-inc-int j)))
                            (.equals attrId TrustedKeyUsage_OID)
                              (do
                                (set! trustedKeyUsage (new ObjectIdentifier/1 (alength valSet)))
                                (loop [^int k 0]
                                  (when (< k (alength valSet))
                                    (aset trustedKeyUsage k (.getOID (aget valSet k)))
                                    (recur (unchecked-inc-int k))))
                                (recur (unchecked-inc-int j)))
                            :else
                              (do
                                (.add attributes (PKCS12Attribute. encoded))
                                (recur (unchecked-inc-int j)))))))))
                (if-instance [^KeyEntry entry bagItem]
                  (do
                    (when (nil? keyId)
                      (if (instance? PrivateKeyEntry bagItem)
                          (if (== privateKeyCount 1)
                              (set! keyId (.getBytes "01" StandardCharsets/UTF_8))
                              (continue (unchecked-inc-int i)))
                          (set! keyId (.getBytes "00" StandardCharsets/UTF_8))))
                    (set! (.-keyId entry) keyId)
                    (let [keyIdStr (String. keyId StandardCharsets/UTF_8)
                          ^:mutable ^Date date nil]
                      (when (.startsWith keyIdStr "Time ")
                        (try
                          (set! date (Date. (Long/parseLong (.substring keyIdStr 5))))
                          (catch Exception e)))
                      (when (nil? date) (set! date (Date.)))
                      (set! (.-date entry) date)
                      (when (instance? PrivateKeyEntry bagItem) (.add keyList entry))
                      (when (nil? (.-attributes entry)) (set! (.-attributes entry) (HashSet.)))
                      (.addAll (.-attributes entry) attributes)
                      (when (nil? alias) (set! alias (.getUnfriendlyName this)))
                      (set! (.-alias entry) alias)
                      (.populateAttributes this entry)
                      (.put entries (.toLowerCase alias Locale/ENGLISH) entry)
                      (recur (unchecked-inc-int i))))
                  (if-instance [^X509Certificate cert bagItem]
                    (do
                      (when (and (nil? keyId) (== privateKeyCount 1))
                        (when (== i 0) (set! keyId (.getBytes "01" StandardCharsets/UTF_8))))
                      (if (some? trustedKeyUsage)
                          (do
                            (when (nil? alias) (set! alias (.getUnfriendlyName this)))
                            (let [certEntry (CertEntry. cert keyId alias trustedKeyUsage attributes)]
                              (.populateAttributes this certEntry)
                              (.put entries (.toLowerCase alias Locale/ENGLISH) certEntry)))
                          (.add certEntries (CertEntry. cert keyId alias)))
                      (.add allCerts cert)
                      (recur (unchecked-inc-int i)))
                    (recur (unchecked-inc-int i)))))))))))

  (method ^:private getUnfriendlyName ^String [this]
    (set! counter (unchecked-inc-int counter))
    (String/valueOf counter))

  (field ^:private ^:static ^:final ^long/2 PKCS12_HEADER_PATTERNS
    (new long/2
         [[0x3080020103308006 0x092A864886F70D01 0x0701A08024800400]
          [0x3082000002010330
           (unchecked-long 0x82000006092A8648)
           (unchecked-long 0x86F70D010701A080)]
          [0x3000020103300006 0x092A864886F70D01 0x0701A00004000000]
          [0x3081000201033081 0x0006092A864886F7 0x0D010701A0810004]
          [0x3082000002010330
           (unchecked-long 0x810006092A864886)
           (unchecked-long 0xF70D010701A08100)]
          [0x3083000000020103 0x3082000006092A86 0x4886F70D010701A0]
          [0x3083000000020103 0x308300000006092A (unchecked-long 0x864886F70D010701)]
          [0x3084000000000201 0x0330830000000609 0x2A864886F70D0107]
          [0x3084000000000201 0x0330840000000006 0x092A864886F70D01]]))

  (field ^:private ^:static ^:final ^long/2 PKCS12_HEADER_MASKS
    (new long/2
         [[(unchecked-long 0xFFFFFFFFFFFFFFFF)
           (unchecked-long 0xFFFFFFFFFFFFFFFF)
           (unchecked-long 0xFFFFFFFFFFFFFF00)]
          [(unchecked-long 0xFFFF0000FFFFFFFF)
           (unchecked-long 0xFF0000FFFFFFFFFF)
           (unchecked-long 0xFFFFFFFFFFFFFFF0)]
          [(unchecked-long 0xFF00FFFFFFFF00FF)
           (unchecked-long 0xFFFFFFFFFFFFFFFF)
           (unchecked-long 0xFFFFFF00FF000000)]
          [(unchecked-long 0xFFFF00FFFFFFFFFF)
           0x00FFFFFFFFFFFFFF
           (unchecked-long 0xFFFFFFFFFFFF00FF)]
          [(unchecked-long 0xFFFF0000FFFFFFFF)
           (unchecked-long 0xFF00FFFFFFFFFFFF)
           (unchecked-long 0xFFFFFFFFFFFFFF00)]
          [(unchecked-long 0xFFFF000000FFFFFF)
           (unchecked-long 0xFFFF0000FFFFFFFF)
           (unchecked-long 0xFFFFFFFFFFFFFFFF)]
          [(unchecked-long 0xFFFF000000FFFFFF)
           (unchecked-long 0xFFFF000000FFFFFF)
           (unchecked-long 0xFFFFFFFFFFFFFFFF)]
          [(unchecked-long 0xFFFF00000000FFFF)
           (unchecked-long 0xFFFFFF000000FFFF)
           (unchecked-long 0xFFFFFFFFFFFFFFFF)]
          [(unchecked-long 0xFFFF00000000FFFF)
           (unchecked-long 0xFFFFFF00000000FF)
           (unchecked-long 0xFFFFFFFFFFFFFFFF)]]))

  (method ^:public engineProbe :throws [IOException] ^boolean [this ^InputStream stream]
    (let [^DataInputStream dataStream (if (instance? DataInputStream stream)
                                          (cast DataInputStream stream)
                                          (DataInputStream. stream))]
      (let [firstPeek (.readLong dataStream)
            nextPeek (.readLong dataStream)
            finalPeek (.readLong dataStream)
            ^:mutable result false]
        (loop [^int i 0]
          (if (< i (alength PKCS12_HEADER_PATTERNS))
              (if (and (and (== (aget PKCS12_HEADER_PATTERNS i 0)
                                (bit-and firstPeek (aget PKCS12_HEADER_MASKS i 0)))
                            (== (aget PKCS12_HEADER_PATTERNS i 1)
                                (bit-and nextPeek (aget PKCS12_HEADER_MASKS i 1))))
                       (== (aget PKCS12_HEADER_PATTERNS i 2)
                           (bit-and finalPeek (aget PKCS12_HEADER_MASKS i 2))))
                  (set! result true)
                  (recur (unchecked-inc-int i)))
              nil))
        result)))

  (method ^:private ^:static useLegacy ^boolean []
    (some? (System/getProperty USE_LEGACY_PROP)))

  (method ^:private ^:static defaultCertProtectionAlgorithm ^String []
    (if (PKCS12KeyStore/useLegacy)
        LEGACY_CERT_PBE_ALGORITHM
        (let [result (SecurityProperties/getOverridableProperty
                       "keystore.pkcs12.certProtectionAlgorithm")]
          (if (and (some? result) (not (.isEmpty result))) result DEFAULT_CERT_PBE_ALGORITHM))))

  (method ^:private ^:static defaultCertPbeIterationCount ^int []
    (if (PKCS12KeyStore/useLegacy)
        LEGACY_PBE_ITERATION_COUNT
        (let [result (SecurityProperties/getOverridableProperty
                       "keystore.pkcs12.certPbeIterationCount")]
          (if (and (some? result) (not (.isEmpty result)))
              (PKCS12KeyStore/string2IC "certPbeIterationCount" result)
              DEFAULT_CERT_PBE_ITERATION_COUNT))))

  (method ^:private ^:static defaultKeyProtectionAlgorithm ^String []
    (if (PKCS12KeyStore/useLegacy)
        LEGACY_KEY_PBE_ALGORITHM
        (let [name1 "keystore.pkcs12.keyProtectionAlgorithm"
              name2 "keystore.PKCS12.keyProtectionAlgorithm"
              ^:mutable result (System/getProperty name1)]
          (when (nil? result)
            (set! result (System/getProperty name2))
            (when (nil? result)
              (set! result (Security/getProperty name1))
              (when (nil? result) (set! result (Security/getProperty name2)))))
          (if (and (some? result) (not (.isEmpty result))) result DEFAULT_KEY_PBE_ALGORITHM))))

  (method ^:private ^:static defaultKeyPbeIterationCount ^int []
    (if (PKCS12KeyStore/useLegacy)
        LEGACY_PBE_ITERATION_COUNT
        (let [result (SecurityProperties/getOverridableProperty
                       "keystore.pkcs12.keyPbeIterationCount")]
          (if (and (some? result) (not (.isEmpty result)))
              (PKCS12KeyStore/string2IC "keyPbeIterationCount" result)
              DEFAULT_KEY_PBE_ITERATION_COUNT))))

  (method ^:private ^:static defaultMacAlgorithm ^String []
    (if (PKCS12KeyStore/useLegacy)
        LEGACY_MAC_ALGORITHM
        (let [result (SecurityProperties/getOverridableProperty "keystore.pkcs12.macAlgorithm")]
          (if (and (some? result) (not (.isEmpty result))) result DEFAULT_MAC_ALGORITHM))))

  (method ^:private ^:static defaultMacIterationCount ^int []
    (if (PKCS12KeyStore/useLegacy)
        LEGACY_MAC_ITERATION_COUNT
        (let [result (SecurityProperties/getOverridableProperty "keystore.pkcs12.macIterationCount")]
          (if (and (some? result) (not (.isEmpty result)))
              (PKCS12KeyStore/string2IC "macIterationCount" result)
              DEFAULT_MAC_ITERATION_COUNT))))

  (method ^:private ^:static string2IC ^int [^String type ^String value]
    (let [^:mutable ^int number 0]
      (try
        (set! number (Integer/parseInt value))
        (catch NumberFormatException e
          (throw (IllegalArgumentException.
                   (java-str "keystore.pkcs12." type " is not a number: " value)))))
      (when (or (<= number 0) (> number MAX_ITERATION_COUNT))
        (throw (IllegalArgumentException. (java-str "Invalid keystore.pkcs12." type ": " value))))
      number)))

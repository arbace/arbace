                    (.println debug
                              (java-str "Retrieved a certificate at alias '"
                                        alias
                                        "' (trusted for any purpose)"))
                    (.println debug
                              (java-str "Retrieved a certificate at alias '"
                                        alias
                                        "' (trusted for limited purposes)"))))
              (.-cert (cast CertEntry entry)))
          (instance? PrivateKeyEntry entry)
            (when (some? (.-chain (cast PrivateKeyEntry entry)))
              (when (some? debug)
                (.println debug (java-str "Retrieved a certificate at alias '" alias "'")))
              (aget (.-chain (cast PrivateKeyEntry entry)) 0))))))


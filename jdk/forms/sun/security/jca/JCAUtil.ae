  (method ^:public ^:static tryCommitCertEvent ^void [^Certificate cert]
    (when (or (X509CertificateEvent/isTurnedOn) (EventHelper/isLoggingSecurity))
      (when-instance [^X509Certificate x509 cert]
        (let [pKey (.getPublicKey x509)
              algId (.getSigAlgName x509)
              serNum (Debug/toString (.getSerialNumber x509))
              subject (.toString (.getSubjectX500Principal x509))
              issuer (.toString (.getIssuerX500Principal x509))
              keyType (.getAlgorithm pKey)
              length (KeyUtil/getKeySize pKey)
              hashCode (.hashCode x509)
              certifcateId (Integer/toUnsignedLong hashCode)
              beginDate (.getTime (.getNotBefore x509))
              endDate (.getTime (.getNotAfter x509))]
          (when (X509CertificateEvent/isTurnedOn)
            (let [xce (X509CertificateEvent.)]
              (set! (.-algorithm xce) algId)
              (set! (.-serialNumber xce) serNum)
              (set! (.-subject xce) subject)
              (set! (.-issuer xce) issuer)
              (set! (.-keyType xce) keyType)
              (set! (.-keyLength xce) length)
              (set! (.-certificateId xce) certifcateId)
              (set! (.-validFrom xce) beginDate)
              (set! (.-validUntil xce) endDate)
              (.commit xce)))
          (when (EventHelper/isLoggingSecurity)
            (EventHelper/logX509CertificateEvent
              algId
              serNum
              subject
              issuer
              keyType
              length
              certifcateId
              beginDate
              endDate)))))))

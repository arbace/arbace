        (.encode digestEncryptionAlgorithmId seq)
        (.putOctetString seq encryptedDigest)
        (when (some? unauthenticatedAttributes)
          (.encode unauthenticatedAttributes (unchecked-byte 0xA1) seq))
        (.write out DerValue/tag_Sequence seq))))


      (let [tsTokenAttr (.getAttribute unauthenticatedAttributes
                                       PKCS9Attribute/SIGNATURE_TIMESTAMP_TOKEN_OID)]
        (when (some? tsTokenAttr) (PKCS7. (cast byte/1 (.getValue tsTokenAttr)))))))

  (method ^:public getTimestamp :throws [IOException
                                         NoSuchAlgorithmException
                                         SignatureException
                                         CertificateException] ^Timestamp [this]
    (if (or (some? timestamp) (not hasTimestamp))
        timestamp
        (let [tsToken (.getTsToken this)]
          (if (nil? tsToken)
              (do (set! hasTimestamp false) nil)
              (do
                (when-not (.equals (.getContentType (.getContentInfo tsToken))
                                   ContentInfo/TIMESTAMP_TOKEN_INFO_OID)
                  (throw (SignatureException. "Not using id-ct-TSTInfo")))
                (let [encTsTokenInfo (.getData (.getContentInfo tsToken))
                      tsa (.verify tsToken encTsTokenInfo)]
                  (when (or (nil? tsa) (== (alength tsa) 0))
                    (throw (SignatureException. "Unable to verify timestamp")))
                  (let [^{:tag (ArrayList X509Certificate)} chain (.getCertificateChain
                                                                    (aget tsa 0)
                                                                    tsToken)
                        cf (CertificateFactory/getInstance "X.509")
                        tsaChain (.generateCertPath cf chain)
                        tsTokenInfo (TimestampToken. encTsTokenInfo)]
                    (.verifyTimestamp this tsTokenInfo)
                    (.putAll algorithms (.-algorithms (aget tsa 0)))
                    (set! timestamp (Timestamp. (.getDate tsTokenInfo) tsaChain))
                    timestamp)))))))

  (method ^:private verifyTimestamp :throws [NoSuchAlgorithmException SignatureException] ^void [this
                                                                                                 ^TimestampToken token]
    (let [digestAlgId (.getHashAlgorithm token)]
      (.put algorithms digestAlgId (AlgorithmInfo. "TimestampToken digestAlgorithm field" false))
      (let [md (MessageDigest/getInstance (.getName digestAlgId))]
        (when-not (MessageDigest/isEqual (.getHashedMessage token) (.digest md encryptedDigest))
          (throw (SignatureException.
                   (java-str "Signature timestamp (#"
                             (Debug/toString (.getSerialNumber token))
                             ") generated on "
                             (.getDate token)
                             " is inapplicable"))))
        (when (some? debug)
          (.println debug)
          (.println debug
                    (java-str "Detected signature timestamp (#"
                              (Debug/toString (.getSerialNumber token))
                              ") generated on "
                              (.getDate token)))
          (.println debug)))))

  (method ^:public toString ^String [this]
    (let [hexDump (HexDumpEncoder.)
          ^:mutable out ""]
      (set! out (java-str out (java-str "Signer Info for (issuer): " issuerName "\n")))
      (set! out (java-str out (java-str "\tversion: " (Debug/toHexString version) "\n")))
      (set! out
            (java-str out
                      (java-str "\tcertificateSerialNumber: "
                                (Debug/toHexString certificateSerialNumber)
                                "\n")))
      (set! out (java-str out (java-str "\tdigestAlgorithmId: " digestAlgorithmId "\n")))
      (when (some? authenticatedAttributes)
        (set! out
              (java-str out (java-str "\tauthenticatedAttributes: " authenticatedAttributes "\n"))))
      (set!
        out
        (java-str out (java-str "\tdigestEncryptionAlgorithmId: " digestEncryptionAlgorithmId "\n")))
      (set! out
            (java-str out
                      (java-str "\tencryptedDigest: \n"
                                (.encodeBuffer hexDump encryptedDigest)
                                "\n")))
      (when (some? unauthenticatedAttributes)
        (set! out
              (java-str out
                        (java-str "\tunauthenticatedAttributes: " unauthenticatedAttributes "\n"))))
      out))

  (method ^:public ^:static verifyAlgorithms :throws [SignatureException] ^{:tag (Set String)} [^SignerInfo/1 infos
                                                                                                ^JarConstraintsParameters params
                                                                                                ^String name]
    (let [^{:tag (Map AlgorithmId AlgorithmInfo)} algorithms (HashMap.)]
      (for-each [^SignerInfo info infos] (.putAll algorithms (.-algorithms info)))
      (let [^{:tag (Set String)} enabledAlgorithms (HashSet.)]
        (try
          (for-each [^Map$Entry algEntry (.entrySet algorithms)]
            (let [info (cast AlgorithmInfo (.getValue algEntry))]
              (.setExtendedExceptionMsg params name (.field info))
              (let [algId (cast AlgorithmId (.getKey algEntry))]
                (.permits JAR_DISABLED_CHECK
                          (.getName algId)
                          (.getParameters algId)
                          params
                          (.checkKey info))
                (.add enabledAlgorithms (.getName algId)))))
          (catch CertPathValidatorException e (throw (SignatureException. e))))
        enabledAlgorithms))))

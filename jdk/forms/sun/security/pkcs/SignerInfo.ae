  (method ^:public getCertificateChain :throws [IOException] ^{:tag (ArrayList X509Certificate)} [this
                                                                                                  ^PKCS7 block]
    (let [^:mutable ^X509Certificate userCert nil]
      (set! userCert (.getCertificate block certificateSerialNumber issuerName))
      (when (some? userCert)
        (let [^{:tag (ArrayList X509Certificate)} certList (ArrayList.)]
          (.add certList userCert)
          (let [pkcsCerts (.getCertificates block)]
            (if (or
                  (nil? pkcsCerts)
                  (.equals (.getSubjectX500Principal userCert) (.getIssuerX500Principal userCert)))
                certList
                (let [^:mutable ^Principal issuer (.getIssuerX500Principal userCert)
                      ^:mutable ^int start 0]
                  (while true
                    (let [^:mutable match false
                          ^:mutable i start]
                      (while (< i (alength pkcsCerts))
                        (if (.equals issuer (.getSubjectX500Principal (aget pkcsCerts i)))
                            (do
                              (.add certList (aget pkcsCerts i))
                              (if (.equals (.getSubjectX500Principal (aget pkcsCerts i))
                                           (.getIssuerX500Principal (aget pkcsCerts i)))
                                  (set! start (alength pkcsCerts))
                                  (do
                                    (set! issuer (.getIssuerX500Principal (aget pkcsCerts i)))
                                    (let [tmpCert (aget pkcsCerts start)]
                                      (aset pkcsCerts start (aget pkcsCerts i))
                                      (aset pkcsCerts i tmpCert)
                                      (set! start (unchecked-inc-int start)))))
                              (set! match true)
                              (break))
                            (set! i (unchecked-inc-int i))))
                      (when-not match (break))))
                  certList)))))))

  (method verify :throws [NoSuchAlgorithmException SignatureException] ^SignerInfo [this
                                                                                    ^PKCS7 block
                                                                                    ^:mutable ^byte/1 data
                                                                                    ^:mutable ^X509Certificate cert]

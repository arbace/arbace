  (method ^:private ^:static algorithmsConformanceCheck :throws [NoSuchAlgorithmException] ^void [^AlgorithmId digAlgId
                                                                                                  ^AlgorithmId encAlgId
                                                                                                  ^PublicKey key
                                                                                                  ^boolean directSign]
    (let [encAlg (.getName encAlgId)]
      (switch encAlg
        "RSASSA-PSS"
          (let [spec (cast PSSParameterSpec
                           (SignatureUtil/getParamSpec encAlg (.getParameters encAlgId)))]
            (when (nil? spec)
              (throw
                (NoSuchAlgorithmException. "Missing PSSParameterSpec for RSASSA-PSS algorithm")))
            (when-not (.equals (AlgorithmId/get (.getDigestAlgorithm spec)) digAlgId)
              (throw (NoSuchAlgorithmException.
                       (java-str "Incompatible digest algorithm " digAlgId)))))
        "Ed25519"
          (when-not (.equalsOID digAlgId AlgorithmId/SHA512_oid)
            (throw (NoSuchAlgorithmException. (java-str "Incompatible digest algorithm " digAlgId))))
        "Ed448"
          (if directSign
              (when-not (.equalsOID digAlgId AlgorithmId/SHAKE256_512_oid)
                (throw (NoSuchAlgorithmException.
                         (java-str "Incompatible digest algorithm " digAlgId))))
              (when-not (.equals digAlgId SignatureUtil$DigestAlgHolder/shake256lenWith512)
                (throw (NoSuchAlgorithmException.
                         (java-str "Incompatible digest algorithm " digAlgId)))))
        "HSS/LMS"
          (when-not (.equalsOID digAlgId (KeyUtil/hashAlgFromHSS key))
            (throw (NoSuchAlgorithmException. (java-str "Incompatible digest algorithm " digAlgId))))
        "ML-DSA-44"
          (when (and (and (and (and (and (and (and
                                                (not (.equalsOID digAlgId AlgorithmId/SHA256_oid))
                                                (not (.equalsOID digAlgId AlgorithmId/SHA384_oid)))
                                              (not (.equalsOID digAlgId AlgorithmId/SHA512_oid)))
                                         (not (.equalsOID digAlgId AlgorithmId/SHA3_256_oid)))
                                    (not (.equalsOID digAlgId AlgorithmId/SHA3_384_oid)))
                               (not (.equalsOID digAlgId AlgorithmId/SHA3_512_oid)))
                          (not (.equalsOID digAlgId AlgorithmId/SHAKE128_256_oid)))
                     (not (.equalsOID digAlgId AlgorithmId/SHAKE256_512_oid)))
            (throw (NoSuchAlgorithmException. (java-str "Incompatible digest algorithm " digAlgId))))
        "ML-DSA-65"
          (when (and (and (and (and (not (.equalsOID digAlgId AlgorithmId/SHA384_oid))
                                    (not (.equalsOID digAlgId AlgorithmId/SHA512_oid)))
                               (not (.equalsOID digAlgId AlgorithmId/SHA3_384_oid)))
                          (not (.equalsOID digAlgId AlgorithmId/SHA3_512_oid)))
                     (not (.equalsOID digAlgId AlgorithmId/SHAKE256_512_oid)))
            (throw (NoSuchAlgorithmException. (java-str "Incompatible digest algorithm " digAlgId))))
        "ML-DSA-87"
          (when (and (and (not (.equalsOID digAlgId AlgorithmId/SHA512_oid))
                          (not (.equalsOID digAlgId AlgorithmId/SHA3_512_oid)))
                     (not (.equalsOID digAlgId AlgorithmId/SHAKE256_512_oid)))
            (throw (NoSuchAlgorithmException. (java-str "Incompatible digest algorithm " digAlgId)))))))

  (method ^:public ^:static makeSigAlg ^String [^AlgorithmId digAlgId ^AlgorithmId encAlgId]
    (let [encAlg (.getName encAlgId)
          ^:mutable keyAlg (SignatureUtil/extractKeyAlgFromDwithE encAlg)]
      (when (nil? keyAlg)
        (if (or (or (.equals encAlg "RSA") (.equals encAlg "DSA")) (.equals encAlg "EC"))
            (set! keyAlg encAlg)
            (return encAlg)))
      (let [^:mutable digAlg (.getName digAlgId)]
        (when (.startsWith digAlg "SHA-") (set! digAlg (java-str "SHA" (.substring digAlg 4))))
        (when (.equals keyAlg "EC") (set! keyAlg "ECDSA"))
        (java-str digAlg "with" keyAlg))))


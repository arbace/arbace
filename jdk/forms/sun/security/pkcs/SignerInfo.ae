  (method ^:private checkCMSAlgorithmProtection :throws [IOException] ^void [this]
    (when (some? authenticatedAttributes)
      (let [ap (.getAttribute authenticatedAttributes PKCS9Attribute/CMS_ALGORITHM_PROTECTION_OID)]
        (when (some? ap)
          (let [dv (DerValue. (cast byte/1 (.getValue ap)))
                data (.data dv)
                d (AlgorithmId/parse (.getDerValue data))
                ds (.getDerValue data)]
            (when (> (.available data) 0)
              (throw (IOException. "Unknown field in CMSAlgorithmProtection")))
            (when-not (.isContextSpecific ds (unchecked-byte 1))
              (throw (IOException. "No signature algorithm in CMSAlgorithmProtection")))
            (let [s (AlgorithmId/parse (.withTag ds DerValue/tag_Sequence))]
              (when (or (not (.equals s digestEncryptionAlgorithmId))
                        (not (.equals d digestAlgorithmId)))
                (throw (IOException. "CMSAlgorithmProtection check failed")))))))))

  (method ^:public encode ^void [this ^DerOutputStream out]
    (let [seq (DerOutputStream.)]
      (.putInteger seq version)
      (let [issuerAndSerialNumber (DerOutputStream.)]
        (.encode issuerName issuerAndSerialNumber)
        (.putInteger issuerAndSerialNumber certificateSerialNumber)
        (.write seq DerValue/tag_Sequence issuerAndSerialNumber)

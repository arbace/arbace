  (method ^:public ^:static getTimestampingURI ^URI [^X509Certificate tsaCertificate]
    (when (some? tsaCertificate)
      (try
        (let [extensionValue (.getExtensionValue
                               tsaCertificate
                               (.value KnownOIDs/SubjectInfoAccess))]
          (when (nil? extensionValue) (return nil))
          (let [^:mutable der (DerInputStream. extensionValue)]
            (set! der (DerInputStream. (.getOctetString der)))
            (let [derValue (.getSequence der 5)
                  ^:mutable ^AccessDescription description nil
                  ^:mutable ^GeneralName location nil
                  ^:mutable ^URIName uri nil]
              (loop [^int i 0]
                (when (< i (alength derValue))
                  (set! description (AccessDescription. (aget derValue i)))
                  (if (.equals (.getAccessMethod description)
                               (ObjectIdentifier/of KnownOIDs/AD_TimeStamping))
                      (do
                        (set! location (.getAccessLocation description))
                        (if (== (.getType location) GeneralNameInterface/NAME_URI)
                            (do
                              (set! uri (cast URIName (.getName location)))
                              (if (or (.equalsIgnoreCase (.getScheme uri) "http")
                                      (.equalsIgnoreCase (.getScheme uri) "https"))
                                  (return (.getURI uri))
                                  (recur (unchecked-inc-int i))))
                            (recur (unchecked-inc-int i))))
                      (recur (unchecked-inc-int i))))))))
        (catch IOException ioe))
      nil))

  (method ^:public ^:static generateTimestampToken :throws [IOException CertificateException] ^byte/1 [^Timestamper tsa
                                                                                                       ^String tSAPolicyID
                                                                                                       ^String tSADigestAlg
                                                                                                       ^byte/1 toBeTimestamped]
    (let [^:mutable ^MessageDigest messageDigest nil
          ^:mutable ^TSRequest tsQuery nil]
      (try
        (set! messageDigest (MessageDigest/getInstance tSADigestAlg))
        (set! tsQuery (TSRequest. tSAPolicyID toBeTimestamped messageDigest))
        (catch NoSuchAlgorithmException e (throw (IllegalArgumentException. e))))
      (let [nonce (BigInteger. 64 (JCAUtil/getDefSecureRandom))]
        (.setNonce tsQuery nonce)
        (.requestCertificate tsQuery true)
        (let [tsReply (.generateTimestamp tsa tsQuery)
              status (.getStatusCode tsReply)]
          (when (and (not (== status 0)) (not (== status 1)))
            (throw (IOException. (java-str "Error generating timestamp: "
                                           (.getStatusCodeAsText tsReply)
                                           " "
                                           (.getFailureCodeAsText tsReply)))))
          (when (and (some? tSAPolicyID)
                     (not (.equals tSAPolicyID (.getPolicyID (.getTimestampToken tsReply)))))
            (throw (IOException. "TSAPolicyID changed in timestamp token")))
          (let [tsToken (.getToken tsReply)
                tst (.getTimestampToken tsReply)]
            (try
              (when-not (.equals (.getHashAlgorithm tst) (AlgorithmId/get tSADigestAlg))
                (throw (IOException. (java-str "Digest algorithm not "
                                               tSADigestAlg
                                               " in timestamp token"))))
              (catch NoSuchAlgorithmException nase (throw (IllegalArgumentException.))))
            (when-not (MessageDigest/isEqual (.getHashedMessage tst) (.getHashedMessage tsQuery))
              (throw (IOException. "Digest octets changed in timestamp token")))
            (let [replyNonce (.getNonce tst)]
              (when (and (nil? replyNonce) (some? nonce))
                (throw (IOException. "Nonce missing in timestamp token")))
              (when (and (some? replyNonce) (not (.equals replyNonce nonce)))
                (throw (IOException. "Nonce changed in timestamp token")))
              (for-each [^SignerInfo si (.getSignerInfos tsToken)]
                (let [cert (.getCertificate si tsToken)]
                  (if (nil? cert)
                      (throw (CertificateException. "Certificate not included in timestamp token"))
                      (do
                        (when-not (.contains (.getCriticalExtensionOIDs cert)
                                             (.value KnownOIDs/extendedKeyUsage))
                          (throw
                            (CertificateException. "Certificate is not valid for timestamping")))
                        (let [^{:tag (List String)} keyPurposes (.getExtendedKeyUsage cert)]
                          (when (or
                                  (nil? keyPurposes)
                                  (not (.contains keyPurposes (.value KnownOIDs/KP_TimeStamping))))
                            (throw (CertificateException.
                                     "Certificate is not valid for timestamping"))))))))
              (.getEncodedToken tsReply))))))))

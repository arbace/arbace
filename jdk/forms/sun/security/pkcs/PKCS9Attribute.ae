                           oid
                           " constructing PKCS9Attribute; was "
                           (.toString (.getClass value))
                           ", should be "
                           (.toString clazz)))))
      (set! (.-value this) value)))

  (constructor :throws [IOException] ^:public [this ^DerValue derVal]

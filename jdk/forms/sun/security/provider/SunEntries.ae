  (method ^:private ^:static getOverridableSeedSource ^String []
    (let [^:mutable egdSource (System/getProperty PROP_EGD "")]
      (if (not (== (.length egdSource) 0))
          egdSource
          (do
            (set! egdSource (Security/getProperty PROP_RNDSOURCE))
            (if (nil? egdSource) "" egdSource)))))


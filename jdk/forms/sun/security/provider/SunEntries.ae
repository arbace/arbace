  (field ^:private ^:static ^:final ^String PROP_EGD "java.security.egd")

  (field ^:private ^:static ^:final ^String PROP_RNDSOURCE "securerandom.source")

  (field ^:private ^:static ^:final ^boolean useLegacyDSA
    (Boolean/getBoolean "jdk.security.legacyDSAKeyPairGenerator"))

  (field ^:static ^:final ^String URL_DEV_RANDOM "file:/dev/random")

  (field ^:static ^:final ^String URL_DEV_URANDOM "file:/dev/urandom")


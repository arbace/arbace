    (set! DEF_SECURE_RANDOM_ALGO
          (if (and (NativePRNG/isAvailable)
                   (or (.equals seedSource URL_DEV_URANDOM) (.equals seedSource URL_DEV_RANDOM)))
              "NativePRNG"
              "DRBG")))

  (method ^:static getSeedSource ^String [] seedSource)

  (method ^:static getDeviceFile :throws [IOException] ^File [^URL device]
    (try
      (let [deviceURI (.toURI device)]
        (if (.isOpaque deviceURI)
            (let [localDir (.toURI (File. (StaticProperty/userDir)))
                  uriPath (java-str (.toString localDir) (.substring (.toString deviceURI) 5))]
              (File. (URI/create uriPath)))
            (File. deviceURI)))
      (catch URISyntaxException use (File. (.getPath device))))))

(in-ns 'sun.security.provider)

(import '(java.io File)
        '(java.security MessageDigest NoSuchAlgorithmException)
        '(java.util Random)
        '(jdk.internal.jrt HostRandom))

(defclass ^:abstract SeedGenerator
  (constructor ^:private [this])

  (method ^:public ^:static generateSeed ^void [^byte/1 result]
    (HostRandom/fill result 0 (alength result)))

  (method ^:static getSystemEntropy ^byte/1 []
    (let [^:mutable ^MessageDigest md nil]
      (try
        (set! md (MessageDigest/getInstance "SHA"))
        (catch NoSuchAlgorithmException nsae
          (throw (InternalError. "internal error: SHA-1 not available." nsae))))
      (let [b (unchecked-byte (System/currentTimeMillis))]
        (.update md b)
        (try
          (for-each [^String s (new String/1
                                    ["java.version" "os.name" "os.arch" "user.name" "user.home"
                                     "user.dir" "java.io.tmpdir"])]
            (let [v (System/getProperty s)]
              (.update md (.getBytes s))
              (when (some? v) (.update md (.getBytes v)))))
          (let [names (.list (File. (System/getProperty "java.io.tmpdir" "/tmp")))]
            (when (some? names)
              (let [^:mutable ^int count 0
                    r (Random.)]
                (for-each [^String name names]
                  (when (or (< count 512) (.nextBoolean r)) (.update md (.getBytes name)))
                  (when (> (let [old-1 count] (set! count (unchecked-inc-int count)) old-1) 1024)
                    (break))))))
          (catch Exception ex (.update md (unchecked-byte (.hashCode ex)))))
        (let [rt (Runtime/getRuntime)
              ^:mutable memBytes (SeedGenerator/longToByteArray (.totalMemory rt))]
          (.update md memBytes 0 (alength memBytes))
          (set! memBytes (SeedGenerator/longToByteArray (.freeMemory rt)))
          (.update md memBytes 0 (alength memBytes))
          (.digest md)))))

  (method ^:private ^:static longToByteArray ^byte/1 [^:mutable ^long l]
    (let [retVal (new byte/1 8)]
      (loop [^int i 0]
        (when (< i 8)
          (aset retVal i (unchecked-byte l))
          (set! l (bit-shift-right l 8))
          (recur (unchecked-inc-int i))))
      retVal)))

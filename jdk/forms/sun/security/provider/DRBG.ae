      (when (nil? cap) (set! cap DrbgParameters$Capability/NONE))
      (when (nil? mech) (set! mech "Hash_DRBG"))
      (when (nil? usedf) (set! usedf true))
      (set! mdp
            (MoreDrbgParameters. es
                                 mech
                                 algorithm
                                 nonce
                                 usedf
                                 (DrbgParameters/instantiation strength cap ps)))
      (.createImpl this)))

  (method ^:private createImpl ^void [this]
    (switch (.toLowerCase (.-mech mdp) Locale/ROOT)
      "hash_drbg" (set! impl (HashDrbg. mdp))
      "hmac_drbg" (set! impl (HmacDrbg. mdp))
      "ctr_drbg" (set! impl (CtrDrbg. mdp))
      (throw (IllegalArgumentException. (java-str "Unsupported mech: " (.-mech mdp))))))

  (method ^:protected engineSetSeed ^void [this ^byte/1 seed]

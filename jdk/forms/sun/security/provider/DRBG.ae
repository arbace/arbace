(defclass ^:public ^:final DRBG
  :extends SecureRandomSpi

  (field ^:private ^:static ^:final ^String PROP_NAME "securerandom.drbg.config")

  (field ^:private ^:static ^:final ^long serialVersionUID 9)

  (field ^:private ^:transient ^AbstractDrbg impl)

  (field ^:private ^:final ^MoreDrbgParameters mdp)

  (constructor ^:public [this ^:mutable ^SecureRandomParameters params]
    (let [^:mutable ^String mech nil
          ^:mutable ^Boolean usedf nil
          ^:mutable ^String algorithm nil
          ^:mutable ^int strength -1
          ^:mutable ^DrbgParameters$Capability cap nil
          ^:mutable ^byte/1 ps nil
          ^:mutable ^EntropySource es nil
          ^:mutable ^byte/1 nonce nil
          config (Security/getProperty PROP_NAME)]
      (when (and (some? config) (not (.isEmpty config)))
        (for-each [^:mutable ^String part (.split config ",")]
          (set! part (.trim part))
          (switch (.toLowerCase part Locale/ROOT)
            ""
              (throw (IllegalArgumentException.
                       (java-str (java-str "aspect in " PROP_NAME) " cannot be empty")))
            "pr_and_reseed"
              (do
                (DRBG/checkTwice (some? cap) "capability")
                (set! cap DrbgParameters$Capability/PR_AND_RESEED))
            "reseed_only"
              (do
                (DRBG/checkTwice (some? cap) "capability")
                (set! cap DrbgParameters$Capability/RESEED_ONLY))
            "none"
              (do
                (DRBG/checkTwice (some? cap) "capability")
                (set! cap DrbgParameters$Capability/NONE))
            ("hash_drbg" "hmac_drbg" "ctr_drbg")
              (do (DRBG/checkTwice (some? mech) "mechanism name") (set! mech part))
            "no_df" (do (DRBG/checkTwice (some? usedf) "usedf flag") (set! usedf false))
            "use_df" (do (DRBG/checkTwice (some? usedf) "usedf flag") (set! usedf true))
            (try
              (let [tmp (Integer/parseInt part)]
                (when (< tmp 0)
                  (throw (IllegalArgumentException.
                           (java-str (java-str (java-str "strength in " PROP_NAME)
                                               " cannot be negative: ")
                                     part))))
                (DRBG/checkTwice (>= strength 0) "strength")
                (set! strength tmp))
              (catch NumberFormatException e
                (DRBG/checkTwice (some? algorithm) "algorithm name")
                (set! algorithm part))))))
      (when (some? params)
        (when-instance [^MoreDrbgParameters m params]
          (set! params
                (DrbgParameters/instantiation (.-strength m)
                                              (.-capability m)
                                              (.-personalizationString m)))
          (set! es (.-es m))
          (set! nonce (.-nonce m))
          (when (some? (.-mech m)) (set! mech (.-mech m)))
          (when (some? (.-algorithm m)) (set! algorithm (.-algorithm m)))
          (set! usedf (.-usedf m)))
        (if-instance [^DrbgParameters$Instantiation dp params]
          (do
            (set! ps (.getPersonalizationString dp))

  (method ^:protected engineReseed ^void [this ^SecureRandomParameters params]
    (.engineReseed impl params))

  (method ^:protected engineGetParameters ^SecureRandomParameters [this]
    (.engineGetParameters impl))

  (method ^:public toString ^String [this] (.toString impl))

  (method ^:private ^:static checkTwice ^void [^boolean flag ^String name]
    (when flag
      (throw (IllegalArgumentException.
               (java-str name " cannot be provided more than once in " PROP_NAME)))))

  (method ^:private readObject :throws [IOException ClassNotFoundException] ^void [this
                                                                                   ^ObjectInputStream s]
    (.defaultReadObject s)

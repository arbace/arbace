(in-ns 'sun.security.provider.certpath)

(import '(java.security GeneralSecurityException KeyFactory PublicKey SignatureException)
        '(java.security.cert CertPathValidatorException
                             CertPathValidatorException$BasicReason
                             Certificate
                             CertificateExpiredException
                             CertificateNotYetValidException
                             PKIXCertPathChecker
                             PKIXReason
                             TrustAnchor
                             X509Certificate)
        '(java.security.interfaces DSAPublicKey)
        '(java.security.spec DSAPublicKeySpec)
        '(java.util Collection Date Set)
        '(javax.security.auth.x500 X500Principal)
        '(sun.security.util Debug)
        '(sun.security.x509 X500Name))

(defclass BasicChecker
  :extends PKIXCertPathChecker

  (field ^:private ^:static ^:final ^Debug debug (Debug/getInstance "certpath"))

  (field ^:private ^:final ^PublicKey trustedPubKey)

  (field ^:private ^:final ^X500Principal caName)

  (field ^:private ^:final ^Date date)

  (field ^:private ^:final ^String sigProvider)

  (field ^:private ^:final ^boolean sigOnly)

  (field ^:private ^X500Principal prevSubject)

  (field ^:private ^PublicKey prevPubKey)

  (constructor [this ^TrustAnchor anchor ^Date date ^String sigProvider ^boolean sigOnly]
    (if (some? (.getTrustedCert anchor))
        (do
          (set! (.-trustedPubKey this) (.getPublicKey (.getTrustedCert anchor)))
          (set! (.-caName this) (.getSubjectX500Principal (.getTrustedCert anchor))))
        (do
          (set! (.-trustedPubKey this) (.getCAPublicKey anchor))
          (set! (.-caName this) (.getCA anchor))))
    (set! (.-date this) date)
    (set! (.-sigProvider this) sigProvider)
    (set! (.-sigOnly this) sigOnly)
    (set! (.-prevPubKey this) trustedPubKey))

  (method ^:public init :throws [CertPathValidatorException] ^void [this ^boolean forward]
    (if (not forward)
        (do
          (set! prevPubKey trustedPubKey)
          (when (PKIX/isDSAPublicKeyWithoutParams prevPubKey)
            (throw (CertPathValidatorException. "Key parameters missing")))
          (set! prevSubject caName))
        (throw (CertPathValidatorException. "forward checking not supported"))))

  (method ^:public isForwardCheckingSupported ^boolean [this] false)

  (method ^:public getSupportedExtensions ^{:tag (Set String)} [this] nil)

  (method ^:public check :throws [CertPathValidatorException] ^void [this ^Certificate cert
                                                                     ^{:tag (Collection String)} unresolvedCritExts]
    (let [currCert (cast X509Certificate cert)]
      (when-not sigOnly (.verifyValidity this currCert) (.verifyNameChaining this currCert))
      (.verifySignature this currCert)
      (.updateState this currCert)))

  (method ^:private verifySignature :throws [CertPathValidatorException] ^void [this
                                                                                ^X509Certificate cert]
    (let [msg "signature"]
      (when (some? debug) (.println debug (java-str "---checking " msg "...")))
      (try
        (.verify cert prevPubKey sigProvider)
        (catch SignatureException e
          (throw (CertPathValidatorException.
                   (java-str msg " check failed")
                   e
                   nil
                   -1
                   CertPathValidatorException$BasicReason/INVALID_SIGNATURE)))
        (catch GeneralSecurityException e
          (throw (CertPathValidatorException. (java-str msg " check failed") e))))
      (when (some? debug) (.println debug (java-str msg " verified.")))))

  (method ^:private verifyValidity :throws [CertPathValidatorException] ^void [this
                                                                               ^X509Certificate cert]
    (let [msg "validity"]
      (when (some? debug) (.println debug (java-str "---checking " msg ":" (.toString date) "...")))
      (try
        (.checkValidity cert date)
        (catch CertificateExpiredException e
          (throw (CertPathValidatorException. (java-str msg " check failed")
                                              e
                                              nil
                                              -1
                                              CertPathValidatorException$BasicReason/EXPIRED)))
        (catch CertificateNotYetValidException e
          (throw (CertPathValidatorException. (java-str msg " check failed")
                                              e
                                              nil
                                              -1
                                              CertPathValidatorException$BasicReason/NOT_YET_VALID))))
      (when (some? debug) (.println debug (java-str msg " verified.")))))

  (method ^:private verifyNameChaining :throws [CertPathValidatorException] ^void [this
                                                                                   ^X509Certificate cert]
    (when (some? prevSubject)
      (let [msg "subject/issuer name chaining"]
        (when (some? debug) (.println debug (java-str "---checking " msg "...")))
        (let [currIssuer (.getIssuerX500Principal cert)]
          (when (.isEmpty (X500Name/asX500Name currIssuer))
            (throw (CertPathValidatorException.
                     (java-str msg " check failed: empty/null issuer DN in certificate is invalid")
                     nil
                     nil
                     -1
                     PKIXReason/NAME_CHAINING)))
          (when-not (.equals currIssuer prevSubject)
            (throw (CertPathValidatorException. (java-str msg " check failed")
                                                nil
                                                nil
                                                -1
                                                PKIXReason/NAME_CHAINING)))
          (when (some? debug) (.println debug (java-str msg " verified.")))))))

  (method ^:private updateState :throws [CertPathValidatorException] ^void [this
                                                                            ^X509Certificate currCert]
    (let [^:mutable cKey (.getPublicKey currCert)]
      (when (some? debug)
        (.println debug
                  (java-str "BasicChecker.updateState issuer: "
                            (.toString (.getIssuerX500Principal currCert))
                            "; subject: "
                            (.getSubjectX500Principal currCert)
                            "; serial#: "
                            (Debug/toString (.getSerialNumber currCert)))))
      (when (PKIX/isDSAPublicKeyWithoutParams cKey)
        (set! cKey (BasicChecker/makeInheritedParamsKey cKey prevPubKey))
        (when (some? debug)
          (.println debug "BasicChecker.updateState Made key with inherited params")))
      (set! prevPubKey cKey)
      (set! prevSubject (.getSubjectX500Principal currCert))))

  (method ^:static makeInheritedParamsKey :throws [CertPathValidatorException] ^PublicKey [^PublicKey keyValueKey
                                                                                           ^PublicKey keyParamsKey]
    (when (or (not (instance? DSAPublicKey keyValueKey))
              (not (instance? DSAPublicKey keyParamsKey)))
      (throw (CertPathValidatorException.
               "Input key is not appropriate type for inheriting parameters")))
    (let [params (.getParams (cast DSAPublicKey keyParamsKey))]
      (when (nil? params) (throw (CertPathValidatorException. "Key parameters missing")))
      (try
        (let [y (.getY (cast DSAPublicKey keyValueKey))
              kf (KeyFactory/getInstance "DSA")
              ks (DSAPublicKeySpec. y (.getP params) (.getQ params) (.getG params))]
          (.generatePublic kf ks))
        (catch GeneralSecurityException e
          (throw (CertPathValidatorException.
                   (java-str "Unable to generate key with inherited parameters: " (.getMessage e))
                   e))))))

  (method getPublicKey ^PublicKey [this] prevPubKey))

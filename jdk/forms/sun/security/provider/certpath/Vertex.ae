;; Converted from jdk26u src/java.base/share/classes/sun/security/provider/certpath/Vertex.java by arbace.repr.java. Regenerate rather than edit.

(in-ns 'sun.security.provider.certpath)

(import '(java.security.cert CertificateException X509Certificate)
        '(sun.security.util Debug)
        '(sun.security.x509 X509CertImpl))

(defclass ^:final Vertex
  (field ^:private ^:static ^:final ^Debug debug (Debug/getInstance "certpath"))

  (field ^:private ^:final ^X509Certificate cert)

  (field ^:private ^int index)

  (field ^:private ^Throwable throwable)

  (constructor [this ^X509Certificate cert]
    (set! (.-cert this) cert)
    (set! (.-index this) -1))

  (method ^:public getCertificate ^X509Certificate [this] cert)

  (method ^:public getIndex ^int [this] index)

  (method setIndex ^void [this ^int ndx] (set! index ndx))

  (method ^:public getThrowable ^Throwable [this] throwable)

  (method setThrowable ^void [this ^Throwable throwable]
    (set! (.-throwable this) throwable))

  (method ^:public toString ^String [this]
    (java-str (.certToString this) (.throwableToString this) (.indexToString this)))

  (method ^:public certToString ^String [this]
    (let [sb (StringBuilder.)
          ^:mutable ^X509CertImpl x509Cert nil]
      (try
        (set! x509Cert (X509CertImpl/toImpl cert))
        (catch CertificateException ce
          (when (some? debug)
            (.println debug "Vertex.certToString() unexpected exception")
            (.printStackTrace ce))
          (return (.toString sb))))
      (.append (.append (.append sb "Issuer:     ") (.getIssuerX500Principal x509Cert)) "\n")
      (.append (.append (.append sb "Subject:    ") (.getSubjectX500Principal x509Cert)) "\n")
      (.append (.append (.append sb "SerialNum:  ") (Debug/toString (.getSerialNumber x509Cert)))
               "\n")
      (.append (.append (.append sb "Expires:    ") (.toString (.getNotAfter x509Cert))) "\n")
      (let [iUID (.getIssuerUniqueID x509Cert)]
        (when (some? iUID)
          (.append sb "IssuerUID:  ")
          (for-each [^boolean b iUID] (^[int] StringBuilder/.append sb (if b 1 0)))
          (.append sb "\n"))
        (let [sUID (.getSubjectUniqueID x509Cert)]
          (when (some? sUID)
            (.append sb "SubjectUID: ")
            (for-each [^boolean b sUID] (^[int] StringBuilder/.append sb (if b 1 0)))
            (.append sb "\n"))
          (let [sKeyID (.getSubjectKeyIdentifierExtension x509Cert)]
            (when (some? sKeyID)
              (let [keyID (.getKeyIdentifier sKeyID)]
                (.append (.append sb "SubjKeyID:  ") (.toString keyID))))
            (let [aKeyID (.getAuthorityKeyIdentifierExtension x509Cert)]
              (when (some? aKeyID)
                (let [keyID (.getKeyIdentifier aKeyID)]
                  (.append (.append sb "AuthKeyID:  ") (.toString keyID))))
              (.toString sb)))))))

  (method ^:public throwableToString ^String [this]
    (let [sb (StringBuilder. "Exception:  ")]
      (if (some? throwable) (.append sb (.toString throwable)) (.append sb "null"))
      (.append sb "\n")
      (.toString sb)))

  (method ^:public moreToString ^String [this]
    (java-str "Last cert?  " (if (== index -1) "Yes" "No") "\n"))

  (method ^:public indexToString ^String [this]
    (java-str "Index:      " index "\n")))

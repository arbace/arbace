        (when (and (some? responseExtensions) (> (.size responseExtensions) 0))
          (set! count (.size responseExtensions))
          (.append (.append sb count) ^String (if (== count 1) " extension:\n" " extensions:\n"))
          (for-each [^String extId (.keySet responseExtensions)]
            (.append (.append sb (.get responseExtensions extId)) "\n")))
        (.toString sb))))

  (method ^:private ^:static parseExtensions :throws [IOException] ^{:tag (Map String Extension)} [^DerValue derVal]

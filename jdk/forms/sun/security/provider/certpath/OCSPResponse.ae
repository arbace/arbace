            (do (when (some? debug) (.println debug "Verified signature of OCSP Response")) true)
            (do
              (when (some? debug) (.println debug "Error verifying signature of OCSP Response"))
              false)))
      (catch [InvalidAlgorithmParameterException
              InvalidKeyException
              NoSuchAlgorithmException
              SignatureException] e
        (throw (CertPathValidatorException. e)))))


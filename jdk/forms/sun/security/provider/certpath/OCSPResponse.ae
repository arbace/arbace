            (set! name (.getCA anchor))
            (set! pubKey (.getCAPublicKey anchor))
            (set! certificate (.getTrustedCert anchor)))))

    (method getCertificate ^X509Certificate [this] certificate)

    (method getName ^X500Principal [this] name)

    (method getPublicKey ^PublicKey [this] pubKey)

    (method getAnchor ^TrustAnchor [this] anchor)


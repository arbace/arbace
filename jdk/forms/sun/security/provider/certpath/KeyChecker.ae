(defclass KeyChecker
  :extends PKIXCertPathChecker

  (field ^:private ^:static ^:final ^Debug debug (Debug/getInstance "certpath"))

  (field ^:private ^:final ^int certPathLen)

  (field ^:private ^:final ^CertSelector targetConstraints)

  (field ^:private ^int remainingCerts)

  (field ^:private ^{:tag (Set String)} supportedExts)

  (constructor [this ^int certPathLen ^CertSelector targetCertSel]
    (set! (.-certPathLen this) certPathLen)
    (set! (.-targetConstraints this) targetCertSel))

  (method ^:public init :throws [CertPathValidatorException] ^void [this ^boolean forward]
    (if (not forward)
        (set! remainingCerts certPathLen)
        (throw (CertPathValidatorException. "forward checking not supported"))))

  (method ^:public isForwardCheckingSupported ^boolean [this] false)

  (method ^:public getSupportedExtensions ^{:tag (Set String)} [this]
    (when (nil? supportedExts)
      (set! supportedExts (HashSet/newHashSet 3))
      (.add supportedExts (.toString PKIXExtensions/KeyUsage_Id))
      (.add supportedExts (.toString PKIXExtensions/ExtendedKeyUsage_Id))
      (.add supportedExts (.toString PKIXExtensions/SubjectAlternativeName_Id))
      (set! supportedExts (Collections/unmodifiableSet supportedExts)))
    supportedExts)

  (method ^:public check :throws [CertPathValidatorException] ^void [this ^Certificate cert
                                                                     ^{:tag (Collection String)} unresCritExts]
    (let [currCert (cast X509Certificate cert)]
      (set! remainingCerts (unchecked-dec-int remainingCerts))
      (if (== remainingCerts 0)
          (when (and (some? targetConstraints) (not (.match targetConstraints currCert)))
            (throw (CertPathValidatorException. "target certificate constraints check failed")))
          (KeyChecker/verifyCAKeyUsage currCert))
      (when (and (some? unresCritExts) (not (.isEmpty unresCritExts)))
        (.remove unresCritExts (.toString PKIXExtensions/KeyUsage_Id))
        (.remove unresCritExts (.toString PKIXExtensions/ExtendedKeyUsage_Id))
        (.remove unresCritExts (.toString PKIXExtensions/SubjectAlternativeName_Id)))))

  (field ^:private ^:static ^:final ^int KEY_CERT_SIGN 5)

  (method ^:static verifyCAKeyUsage :throws [CertPathValidatorException] ^void [^X509Certificate cert]
    (let [msg "CA key usage"]
      (when (some? debug)
        (.println debug (java-str "KeyChecker.verifyCAKeyUsage() ---checking " msg "...")))
      (let [keyUsageBits (.getKeyUsage cert)]
        (when (some? keyUsageBits)
          (when-not (aget keyUsageBits KEY_CERT_SIGN)
            (throw (CertPathValidatorException.
                     (java-str msg " check failed: keyCertSign bit is not set")
                     nil
                     nil
                     -1
                     PKIXReason/INVALID_KEY_USAGE)))
          (when (some? debug)
            (.println debug (java-str "KeyChecker.verifyCAKeyUsage() " msg " verified."))))))))

            (.put certStoreCache params ucs))
        (some? debug) (.println debug "URICertStore.getInstance: cache hit"))
      ucs))

  (method ^:static getInstance ^CertStore [^AccessDescription ad]
    (when-not (not (.equals (.getAccessMethod ad) AccessDescription/Ad_CAISSUERS_Id))
      (let [gn (.getName (.getAccessLocation ad))]
        (when-not (not (instance? URIName gn))
          (let [uri (.getURI (cast URIName gn))]
            (when (and Builder/USE_AIA (not CA_ISS_ALLOW_ANY))
              (let [normAIAUri (.normalize uri)
                    scheme (AllowedScheme/nameOf (.getScheme normAIAUri))]
                (when (nil? scheme)

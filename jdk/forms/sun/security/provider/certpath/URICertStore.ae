  (defclass ^:abstract ^:static URIRuleMatcher
    (field ^:protected ^:final ^int wellKnownPort)

    (constructor ^:protected [this ^int port] (set! wellKnownPort port))

    (method schemeHostPortCheck ^boolean [this ^URI filterRule ^URI caIssuer]
      (cond
        (not (.equalsIgnoreCase (.getScheme filterRule) (.getScheme caIssuer))) false
        (not (.equalsIgnoreCase (.getHost filterRule) (.getHost caIssuer))) false
        :else
          (do
            (try
              (let [^int fPort (if (== (.getPort filterRule) -1)
                                   wellKnownPort
                                   (.getPort filterRule))
                    ^int caiPort (if (== (.getPort caIssuer) -1) wellKnownPort (.getPort caIssuer))]
                (when-not (== fPort caiPort) (return false)))
              (catch IllegalArgumentException iae (return false)))
            true)))

    (method ^:abstract matchRule ^boolean [this ^URI filterRule ^URI caIssuer]))

  (defclass ^:static HttpFtpRuleMatcher
    :extends URIRuleMatcher

    (field ^:static ^:final ^HttpFtpRuleMatcher HTTP (HttpFtpRuleMatcher. 80))

    (field ^:static ^:final ^HttpFtpRuleMatcher HTTPS (HttpFtpRuleMatcher. 443))

    (field ^:static ^:final ^HttpFtpRuleMatcher FTP (HttpFtpRuleMatcher. 21))

    (constructor ^:private [this ^int port] (super. port))

    (method matchRule ^boolean [this ^URI filterRule ^URI caIssuer]
      (cond
        (not (.schemeHostPortCheck this filterRule caIssuer)) false
        (not (HttpFtpRuleMatcher/isRootOf filterRule caIssuer))
          (do
            (when (some? debug)
              (.println
                debug
                "allowedAIALocations: Match failed: AIA URI is not within the rule's path hierarchy."))
            false)
        :else true))

    (method ^:private ^:static isRootOf ^boolean [^URI base ^URI candidate]
      (let [basePath (cast String
                           (.orElse (.filter (Optional/of (.getPath base))
                                             (lambda Predicate ^boolean [^String p]
                                               (not (.isEmpty p))))
                                    "/"))
            candPath (cast String
                           (.orElse (.filter (Optional/of (.getPath candidate))
                                             (lambda Predicate ^boolean [^String p]
                                               (not (.isEmpty p))))
                                    "/"))]
        (if (.endsWith basePath "/") (.startsWith candPath basePath) (.equals candPath basePath)))))

  (defclass ^:static LdapRuleMatcher
    :extends URIRuleMatcher

    (field ^:static ^:final ^LdapRuleMatcher LDAP (LdapRuleMatcher. 389))

    (field ^:static ^:final ^LdapRuleMatcher LDAPS (LdapRuleMatcher. 636))

    (constructor ^:private [this ^int port] (super. port))

    (method matchRule ^boolean [this ^URI filterRule ^URI caIssuer]
      (if (not (.schemeHostPortCheck this filterRule caIssuer))
          false
          (do
            (try
              (let [filterBaseDn (X500Principal. (.replaceFirst (.getPath filterRule) "^/+" ""))
                    caIssBaseDn (X500Principal. (.replaceFirst (.getPath caIssuer) "^/+" ""))]
                (when-not (.equals filterBaseDn caIssBaseDn)
                  (when (some? debug)
                    (.println debug
                              (java-str "allowedAIALocations: Match failed: Base DN mismatch ("
                                        filterBaseDn
                                        " vs "
                                        caIssBaseDn
                                        ")")))
                  (return false)))
              (catch IllegalArgumentException iae
                (when (some? debug)
                  (.println debug (java-str "allowedAIALocations: Match failed on DN: " iae)))
                (return false)))
            true))))

  (defclass ^:private ^:static SizeLimitedInputStream
    :extends FilterInputStream

    (field ^:private ^:final ^long maxBytes)

    (field ^:private ^long bytesRead 0)

    (constructor ^:private [this ^InputStream in ^long maxBytes]
      (super. in)
      (set! (.-maxBytes this) maxBytes))

    (method ^:public read :throws [IOException] ^int [this]
      (when (>= bytesRead maxBytes)
        (throw (IllegalArgumentException. (java-str "InputStream exceeded max size of " maxBytes))))
      (let [b (.read super)] (when-not (== b -1) (set! bytesRead (unchecked-inc bytesRead))) b))

    (method ^:public read :throws [IOException] ^int [this ^byte/1 b ^int off ^int len]
      (when (>= bytesRead maxBytes)
        (throw (IllegalArgumentException. (java-str "InputStream exceeded max size of " maxBytes))))
      (let [remaining (unchecked-subtract maxBytes bytesRead)
            toRead (unchecked-int (Math/min len remaining))
            n (.read super b off toRead)]
        (when-not (== n -1) (set! bytesRead (unchecked-add bytesRead n)))
        n))))

                    (let [aiaUriStrs (.split (.trim aiaPropVal) "\\s+")]
                      (URICertStore/addCaIssUriFilters aiaUriStrs)))
                  (when (.isEmpty CA_ISS_URI_FILTERS)
                    (when (some? debug)

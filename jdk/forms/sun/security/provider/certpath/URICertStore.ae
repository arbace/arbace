                    (let [oldLastModified lastModified]
                      (.setConnectTimeout connection CACERT_CONNECT_TIMEOUT)
                      (.setReadTimeout connection CACERT_READ_TIMEOUT)
                      (with-resources [in (.getInputStream connection)]
                        (set! lastModified (.getLastModified connection))
                        (when-not (== oldLastModified 0)
                          (if (== oldLastModified lastModified)
                              (do
                                (when (some? debug)
                                  (.println debug "Not modified, using cached copy"))
                                (return (URICertStore/getMatchingCerts certs selector)))
                              (when-instance [^HttpURLConnection hconn connection]
                                (when (== (.getResponseCode hconn)
                                          HttpURLConnection/HTTP_NOT_MODIFIED)
                                  (when (some? debug)
                                    (.println debug "Not modified, using cached copy"))
                                  (return (URICertStore/getMatchingCerts certs selector))))))
                        (when (some? debug) (.println debug "Downloading new certificates..."))
                        (set! certs (.generateCertificates factory in)))
                      (return (URICertStore/getMatchingCerts certs selector))))
                  (catch [IOException CertificateException] e
                    (when (some? debug)
                      (.println debug "Exception fetching certificates:")
                      (.printStackTrace e))))
                (set! lastModified 0)
                (set! certs (Collections/emptySet))
                certs)))))

  (method ^:private ^:static getMatchingCerts ^{:tag (Collection X509Certificate)} [^{:tag (Collection X509Certificate)} certs
                                                                                    ^CertSelector selector]
    (if (nil? selector)
        certs
        (let [^{:tag (List X509Certificate)} matchedCerts (ArrayList. (.size certs))]
          (for-each [^X509Certificate cert certs]
            (when (.match selector cert) (.add matchedCerts cert)))
          matchedCerts)))

  (method ^:public ^:synchronized engineGetCRLs :throws [CertStoreException] ^{:tag (Collection X509CRL)} [this
                                                                                                           ^CRLSelector selector]
    (when ldap
      (try
        (return (.getCRLs ldapCertStore selector))
        (catch CertStoreException cse (throw (PKIX$CertStoreTypeException. "LDAP" cse)))))
    (let [time (System/currentTimeMillis)]
      (if (< (unchecked-subtract time lastChecked) CHECK_INTERVAL)
          (do
            (when (some? debug) (.println debug "Returning CRL from cache"))
            (URICertStore/getMatchingCRLs crl selector))
          (do
            (set! lastChecked time)
            (try
              (let [connection (.openConnection (.toURL uri))]
                (when-not (== lastModified 0) (.setIfModifiedSince connection lastModified))
                (let [oldLastModified lastModified]
                  (.setConnectTimeout connection CRL_CONNECT_TIMEOUT)
                  (.setReadTimeout connection CRL_READ_TIMEOUT)
                  (with-resources [in (.getInputStream connection)]
                    (set! lastModified (.getLastModified connection))
                    (when-not (== oldLastModified 0)
                      (if (== oldLastModified lastModified)
                          (do
                            (when (some? debug) (.println debug "Not modified, using cached copy"))
                            (return (URICertStore/getMatchingCRLs crl selector)))
                          (when-instance [^HttpURLConnection hconn connection]
                            (when (== (.getResponseCode hconn) HttpURLConnection/HTTP_NOT_MODIFIED)
                              (when (some? debug)
                                (.println debug "Not modified, using cached copy"))
                              (return (URICertStore/getMatchingCRLs crl selector))))))

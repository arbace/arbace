                        "allowedAIALocations: Warning - The caIssuer URI "
                        normAIAUri
                        " in the AuthorityInfoAccess extension is denied access. Use the com.sun.security.allowedAIALocations security/system property to allow access.")))
                  (return nil))))
            (try
              (URICertStore/getInstance (URICertStoreParameters. uri))
              (catch Exception ex
                (when (some? debug)
                  (.println debug (java-str "exception creating CertStore: " ex))
                  (.printStackTrace ex))
                nil)))))))

  (method ^:public ^:synchronized engineGetCertificates :throws [CertStoreException] ^{:tag (Collection X509Certificate)} [this
                                                                                                                           ^CertSelector selector]
    (if ldap
        (.getCertificates ldapCertStore selector)
        (let [time (System/currentTimeMillis)]
          (if (< (unchecked-subtract time lastChecked) CHECK_INTERVAL)
              (do
                (when (some? debug) (.println debug "Returning certificates from cache"))
                (URICertStore/getMatchingCerts certs selector))
              (do

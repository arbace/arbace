  (method ^:private ^:static getMatchingCRLs ^{:tag (Collection X509CRL)} [^X509CRL crl
                                                                           ^CRLSelector selector]
    (if (or (nil? selector) (and (some? crl) (.match selector crl)))
        (Collections/singletonList crl)
        (Collections/emptyList)))


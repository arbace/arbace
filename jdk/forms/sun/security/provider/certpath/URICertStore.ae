                        debug
                        "allowedAIALocations: Warning: No valid filters found. Deny-all URI filtering is active.")))))))
        (finally (set! CA_ISS_ALLOW_ANY allowAny)))))

  (method ^:private ^:static addCaIssUriFilters ^void [^String/1 aiaUriStrs]
    (for-each [^String aiaStr aiaUriStrs]
      (when (and (some? aiaStr) (not (.isEmpty aiaStr)))
        (try
          (let [^:mutable ^AllowedScheme scheme nil
                aiaUri (.normalize (URI. aiaStr))]
            (cond
              (or (not (.isAbsolute aiaUri)) (.isOpaque aiaUri))
                (when (some? debug)
                  (.println debug
                            (java-str "allowedAIALocations: Skipping non-absolute or opaque URI "
                                      aiaUri)))
              (nil? (.getHost aiaUri))
                (when (some? debug)
                  (.println debug
                            (java-str
                              "allowedAIALocations: Skipping URI rule with no hostname or address: "
                              aiaUri)))
              (some? (set! scheme (AllowedScheme/nameOf (.getScheme aiaUri))))
                (do
                  (when (or (identical? scheme AllowedScheme/LDAP)
                            (identical? scheme AllowedScheme/LDAPS))
                    (try
                      (X500Principal. (.replaceFirst (.getPath aiaUri) "^/+" ""))
                      (catch IllegalArgumentException iae
                        (when (some? debug)
                          (.println debug
                                    (java-str "allowedAIALocations: Skipping LDAP rule: " iae)))
                        (continue))))
                  (when (some? (.getQuery aiaUri))
                    (when (some? debug)
                      (.println debug "allowedAIALocations: Rule will ignore non-null query")))
                  (when (some? (.getFragment aiaUri))
                    (when (some? debug)
                      (.println debug "allowedAIALocations: Rule will ignore non-null fragment")))
                  (.add CA_ISS_URI_FILTERS aiaUri)
                  (when (some? debug)
                    (.println debug
                              (java-str "allowedAIALocations: Added " aiaUri " to URI filters"))))
              (some? debug)
                (.println debug
                          (java-str "allowedAIALocations: Disallowed filter URI scheme: "
                                    (.getScheme aiaUri)))))
          (catch URISyntaxException urise
            (when (some? debug)
              (.println debug
                        (java-str "allowedAIALocations: Skipping filter URI entry "
                                  aiaStr
                                  ": parse failure at index "
                                  (.getIndex urise)))))))))

  (constructor :throws [InvalidAlgorithmParameterException NoSuchAlgorithmException] [this
                                                                                      ^CertStoreParameters params]

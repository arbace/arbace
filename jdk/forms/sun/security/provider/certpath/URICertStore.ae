      (throw (InvalidAlgorithmParameterException.
               "params must be instanceof URICertStoreParameters")))
    (set! (.-uri this) (.getURI (cast URICertStoreParameters params)))
    (when (.equals (.toLowerCase (.getScheme uri) Locale/ENGLISH) "ldap")
      (set! ldap true)
      (set! ldapCertStore (CertStore/getInstance "LDAP" params)))
    (try
      (set! factory (CertificateFactory/getInstance "X.509"))
      (catch CertificateException e (throw (RuntimeException.)))))


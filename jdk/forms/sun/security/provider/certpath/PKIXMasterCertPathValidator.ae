(defclass PKIXMasterCertPathValidator
  (field ^:private ^:static ^:final ^Debug debug (Debug/getInstance "certpath"))

  (method ^:static validate :throws [CertPathValidatorException] ^void [^CertPath cpOriginal
                                                                        ^{:tag (List X509Certificate)} reversedCertList
                                                                        ^{:tag (List PKIXCertPathChecker)} certPathCheckers]
    (let [cpSize (.size reversedCertList)]
      (when (some? debug)
        (.println debug "--------------------------------------------------------------")
        (.println debug "Executing PKIX certification path validation algorithm."))
      (loop [^int i 0]
        (when (< i cpSize)
          (let [currCert (cast X509Certificate (.get reversedCertList i))]
            (when (some? debug)
              (.println debug
                        (java-str "Checking cert"
                                  (unchecked-add-int i 1)
                                  " - Subject: "
                                  (.getSubjectX500Principal currCert))))
            (let [^:mutable ^{:tag (Set String)} unresCritExts (.getCriticalExtensionOIDs currCert)]
              (when (nil? unresCritExts) (set! unresCritExts (Collections/emptySet)))
              (when (and (some? debug) (not (.isEmpty unresCritExts)))
                (let [joiner (StringJoiner. ", " "{" "}")]
                  (for-each [^String oid unresCritExts] (.add joiner oid))
                  (.println debug (java-str "Set of critical extensions: " (.toString joiner)))))
              (loop [^int j 0]
                (when (< j (.size certPathCheckers))
                  (let [currChecker (cast PKIXCertPathChecker (.get certPathCheckers j))]
                    (when (some? debug)
                      (.println debug
                                (java-str "-Using checker"
                                          (unchecked-add-int j 1)
                                          " ... ["
                                          (.getName (.getClass currChecker))
                                          "]")))
                    (when (== i 0) (.init currChecker false))
                    (try
                      (.check currChecker currCert unresCritExts)
                      (when (some? debug)
                        (.println debug
                                  (java-str "-checker"
                                            (unchecked-add-int j 1)
                                            " validation succeeded")))
                      (catch CertPathValidatorException cpve
                        (throw (CertPathValidatorException.
                                 (.getMessage cpve)
                                 ^Throwable (if (some? (.getCause cpve))
                                                (.getCause cpve)
                                                ^Throwable cpve)
                                 cpOriginal
                                 (unchecked-subtract-int cpSize (unchecked-add-int i 1))
                                 (.getReason cpve)))))
                    (recur (unchecked-inc-int j)))))
              (when-not (.isEmpty unresCritExts)
                (throw (CertPathValidatorException.
                         "unrecognized critical extension(s)"
                         nil
                         cpOriginal
                         (unchecked-subtract-int cpSize (unchecked-add-int i 1))
                         PKIXReason/UNRECOGNIZED_CRIT_EXT)))
              (if (some? debug)
                  (do
                    (.println
                      debug
                      (java-str "\ncert" (unchecked-add-int i 1) " validation succeeded.\n"))
                    (recur (unchecked-inc-int i)))
                  (recur (unchecked-inc-int i)))))))
      (when (some? debug)
        (.println debug "Cert path validation succeeded. (PKIX validation algorithm)")
        (.println debug "--------------------------------------------------------------")))))

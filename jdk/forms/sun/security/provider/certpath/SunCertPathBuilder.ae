  (method ^:private ^:static addVertices ^{:tag (List Vertex)} [^{:tag (Collection X509Certificate)} certs
                                                                ^{:tag (List (List Vertex))} adjList
                                                                ^{:tag (List X509Certificate)} cpList]
    (let [^{:tag (List Vertex)} l (cast List
                                        (.get adjList (unchecked-subtract-int (.size adjList) 1)))]
      (for-each [^X509Certificate cert certs]
        (let [^:mutable repeated false]
          (for-each [^X509Certificate cpListCert cpList]
            (when (SunCertPathBuilder/repeated cpListCert cert)
              (when (some? debug)
                (.println debug
                          "cert with repeated subject, public key, and subjectAltNames detected"))
              (set! repeated true)
              (break)))
          (when-not repeated (.add l (Vertex. cert)))))
      l))

  (method ^:private ^:static repeated ^boolean [^X509Certificate currCert ^X509Certificate nextCert]
    (if (.equals currCert nextCert)
        true
        (and (and (.equals (.getSubjectX500Principal currCert) (.getSubjectX500Principal nextCert))
                  (.equals (.getPublicKey currCert) (.getPublicKey nextCert)))
             (SunCertPathBuilder/altNamesEqual currCert nextCert))))

  (method ^:private ^:static altNamesEqual ^boolean [^X509Certificate currCert
                                                     ^X509Certificate nextCert]
    (let [^:mutable ^X509CertImpl curr nil
          ^:mutable ^X509CertImpl next nil]
      (try
        (set! curr (X509CertImpl/toImpl currCert))
        (set! next (X509CertImpl/toImpl nextCert))
        (catch CertificateException ce (return false)))
      (let [currAltNameExt (.getSubjectAlternativeNameExtension curr)
            nextAltNameExt (.getSubjectAlternativeNameExtension next)]
        (if (some? currAltNameExt)
            (if (nil? nextAltNameExt)
                false
                (Arrays/equals (.getExtensionValue currAltNameExt)
                               (.getExtensionValue nextAltNameExt)))
            (nil? nextAltNameExt))))))

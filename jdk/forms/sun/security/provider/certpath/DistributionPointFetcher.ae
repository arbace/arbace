          (catch [InvalidAlgorithmParameterException NoSuchAlgorithmException] e
            (when (some? debug)
              (.println debug (java-str "Can't create URICertStore: " (.getMessage e))))
            (return nil)))
        (let [^{:tag (Collection (? extends CRL))} crls (.getCRLs ucs nil)]
          (when-not (.isEmpty crls) (cast X509CRL (.next (.iterator crls))))))))

  (method ^:private ^:static getCRLs :throws [CertStoreException] ^{:tag (Collection X509CRL)} [^X500Name name

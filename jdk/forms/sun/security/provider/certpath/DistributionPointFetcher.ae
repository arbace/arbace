  (method ^:private ^:static getFullNames :throws [IOException] ^GeneralNames [^X500Name issuer
                                                                               ^RDN rdn]
    (let [^{:tag (List RDN)} rdns (ArrayList. (.rdns issuer))]
      (.add rdns rdn)
      (let [fullName (X500Name. (cast RDN/1 (.toArray rdns (new RDN/1 0))))
            fullNames (GeneralNames.)]
        (.add fullNames (GeneralName. fullName))
        fullNames)))

  (method ^:private ^:static issues :throws [IOException] ^boolean [^X509CertImpl cert
                                                                    ^X509CRLImpl crl
                                                                    ^String provider]
    (let [^:mutable ^boolean matched false
          issuerSelector (AdaptableX509CertSelector.)
          usages (.getKeyUsage cert)]
      (when (some? usages) (aset usages 6 true) (.setKeyUsage issuerSelector usages))
      (let [crlIssuer (.getIssuerX500Principal crl)]
        (.setSubject issuerSelector crlIssuer)
        (let [crlAKID (.getAuthKeyIdExtension crl)]
          (.setSkiAndSerialNumber issuerSelector crlAKID)
          (set! matched (.match issuerSelector cert))
          (when (and matched (or (nil? crlAKID) (nil? (.getAuthorityKeyIdentifierExtension cert))))
            (try
              (.verify crl (.getPublicKey cert) provider)
              (catch GeneralSecurityException e (set! matched false))))
          matched)))))

  (method ^:private ^:static stripOutSeparators ^String [^String value]
    (let [chars (.toCharArray value)
          hexNumber (StringBuilder.)]
      (loop [^int i 0]
        (if (< i (alength chars))
            (if (HexFormat/isHexDigit (aget chars i))
                (do (.append hexNumber (aget chars i)) (recur (unchecked-inc-int i)))
                (recur (unchecked-inc-int i)))
            nil))
      (.toString hexNumber)))


  (field ^:private ^:static ^:final ^boolean/1 ALL_REASONS
    (new boolean/1 [true true true true true true true true true]))

  (method ^:private verifyPossibleCRLs ^{:tag (Collection X509CRL)} [this ^{:tag (Set X509CRL)} crls
                                                                     ^X509Certificate cert
                                                                     ^PublicKey prevKey
                                                                     ^boolean signFlag
                                                                     ^boolean/1 reasonsMask
                                                                     ^{:tag (Set TrustAnchor)} anchors]
    (try
      (let [certImpl (X509CertImpl/toImpl cert)]
        (when (some? debug)
          (.println debug
                    (java-str "RevocationChecker.verifyPossibleCRLs: Checking CRLDPs for "
                              (.getSubjectX500Principal certImpl))))
        (let [ext (.getCRLDistributionPointsExtension certImpl)
              ^:mutable ^{:tag (List DistributionPoint)} points nil]
          (if (nil? ext)
              (let [certIssuer (cast X500Name (.getIssuerDN certImpl))
                    point (DistributionPoint. (.add (GeneralNames.) (GeneralName. certIssuer))
                                              nil
                                              nil)]
                (set! points (Collections/singletonList point)))
              (set! points (.getDistributionPoints ext)))
          (let [^{:tag (Set X509CRL)} results (HashSet.)]
            (for-each [^DistributionPoint point points]
              (for-each [^X509CRL crl crls]
                (when (DistributionPointFetcher/verifyCRL
                        certImpl
                        point
                        crl
                        reasonsMask
                        signFlag
                        prevKey
                        nil
                        (.sigProvider params)
                        anchors
                        certStores
                        (.date params)
                        (.variant params)
                        anchor)
                  (.add results crl)))
              (when (Arrays/equals reasonsMask ALL_REASONS) (break)))
            results)))
      (catch [CertificateException CRLException IOException] e
        (when (some? debug)
          (.println debug (java-str "Exception while verifying CRL: " (.getMessage e)))
          (.printStackTrace e))
        (Collections/emptySet))))

  (method ^:private verifyWithSeparateSigningKey :throws [CertPathValidatorException] ^void [this
                                                                                             ^X509Certificate cert
                                                                                             ^PublicKey prevKey
                                                                                             ^boolean signFlag
                                                                                             ^{:tag (Set X509Certificate)} stackedCerts]
    (let [msg "revocation status"]
      (when (some? debug)
        (.println debug
                  (java-str "RevocationChecker.verifyWithSeparateSigningKey() ---checking "
                            msg
                            "...")))
      (when (and (some? stackedCerts) (.contains stackedCerts cert))
        (when (some? debug)
          (.println debug "RevocationChecker.verifyWithSeparateSigningKey() circular dependency"))
        (throw (CertPathValidatorException.
                 "Could not determine revocation status"
                 nil
                 nil
                 -1
                 CertPathValidatorException$BasicReason/UNDETERMINED_REVOCATION_STATUS)))
      (if (not signFlag)
          (.buildToNewKey this cert nil stackedCerts)
          (.buildToNewKey this cert prevKey stackedCerts))))

  (field ^:private ^:static ^:final ^boolean/1 CRL_SIGN_USAGE
    (new boolean/1 [false false false false false false true]))

  (method ^:private buildToNewKey :throws [CertPathValidatorException] ^void [this
                                                                              ^X509Certificate currCert
                                                                              ^PublicKey prevKey
                                                                              ^:mutable ^{:tag (Set X509Certificate)} stackedCerts]
    (when (some? debug) (.println debug "RevocationChecker.buildToNewKey() starting work"))
    (let [^{:tag (Set PublicKey)} badKeys (HashSet.)]
      (when (some? prevKey) (.add badKeys prevKey))
      (let [^X509CertSelector certSel (RejectKeySelector. badKeys)]
        (.setSubject certSel (.getIssuerX500Principal currCert))
        (.setKeyUsage certSel CRL_SIGN_USAGE)
        (let [^{:tag (Set TrustAnchor)} newAnchors (if (nil? anchor)
                                                       (.trustAnchors params)
                                                       (Collections/singleton anchor))
              ^:mutable ^PKIXBuilderParameters builderParams nil]
          (try
            (set! builderParams (PKIXBuilderParameters. newAnchors certSel))
            (catch InvalidAlgorithmParameterException iape (throw (RuntimeException. iape))))
          (.setInitialPolicies builderParams (.initialPolicies params))
          (.setCertStores builderParams certStores)
          (.setExplicitPolicyRequired builderParams (.explicitPolicyRequired params))
          (.setPolicyMappingInhibited builderParams (.policyMappingInhibited params))
          (.setAnyPolicyInhibited builderParams (.anyPolicyInhibited params))
          (.setDate builderParams (.date params))
          (.setSigProvider builderParams (.sigProvider params))
          (.setRevocationEnabled builderParams false)
          (.setCertPathCheckers builderParams
                                (.toList (.filter
                                           (.stream (.certPathCheckers params))
                                           (lambda Predicate ^boolean [^PKIXCertPathChecker checker]
                                             (not (identical? checker this))))))
          (when Builder/USE_AIA
            (let [^:mutable ^X509CertImpl currCertImpl nil]
              (try
                (set! currCertImpl (X509CertImpl/toImpl currCert))
                (catch CertificateException ce
                  (when (some? debug)
                    (.println
                      debug
                      (java-str "RevocationChecker.buildToNewKey: error decoding cert: " ce)))))
              (let [^:mutable ^AuthorityInfoAccessExtension aiaExt nil]
                (when (some? currCertImpl)
                  (set! aiaExt (.getAuthorityInfoAccessExtension currCertImpl)))
                (when (some? aiaExt)
                  (let [^{:tag (List AccessDescription)} adList (.getAccessDescriptions aiaExt)]
                    (when (some? adList)
                      (for-each [^AccessDescription ad adList]
                        (let [cs (URICertStore/getInstance ad)]
                          (when (some? cs)
                            (when (some? debug) (.println debug "adding AIAext CertStore"))
                            (.addCertStore builderParams cs))))))))))
          (let [^:mutable ^CertPathBuilder builder nil]
            (try
              (set! builder (CertPathBuilder/getInstance "PKIX"))
              (catch NoSuchAlgorithmException nsae (throw (CertPathValidatorException. nsae))))
            (while true
              (try
                (when (some? debug)
                  (.println debug "RevocationChecker.buildToNewKey() about to try build ..."))
                (let [cpbr (cast PKIXCertPathBuilderResult (.build builder builderParams))]
                  (when (some? debug)
                    (.println debug
                              "RevocationChecker.buildToNewKey() about to check revocation ..."))
                  (when (nil? stackedCerts) (set! stackedCerts (HashSet.)))
                  (.add stackedCerts currCert)
                  (let [ta (.getTrustAnchor cpbr)
                        ^:mutable prevKey2 (.getCAPublicKey ta)]
                    (when (nil? prevKey2) (set! prevKey2 (.getPublicKey (.getTrustedCert ta))))
                    (let [^:mutable signFlag true
                          ^{:tag (List (? extends Certificate))} cpList (.getCertificates
                                                                          (.getCertPath cpbr))]
                      (try
                        (loop [^int i (unchecked-subtract-int (.size cpList) 1)]
                          (when (>= i 0)
                            (let [cert (cast X509Certificate (.get cpList i))]
                              (when (some? debug)
                                (.println debug
                                          (java-str
                                            "RevocationChecker.buildToNewKey() index "
                                            i
                                            " checking "
                                            cert)))
                              (.checkCRLs this
                                          cert
                                          prevKey2
                                          nil
                                          signFlag
                                          true
                                          stackedCerts
                                          newAnchors)
                              (set! signFlag (RevocationChecker/certCanSignCrl cert))
                              (set! prevKey2 (.getPublicKey cert))
                              (recur (unchecked-dec-int i)))))
                        (catch CertPathValidatorException cpve
                          (.add badKeys (.getPublicKey cpbr))
                          (continue)))
                      (when (some? debug)
                        (.println debug
                                  (java-str "RevocationChecker.buildToNewKey() got key "
                                            (.getPublicKey cpbr))))
                      (let [newKey (.getPublicKey cpbr)
                            ^X509Certificate newCert (when-not (.isEmpty cpList)
                                                       (cast X509Certificate (.get cpList 0)))]
                        (try
                          (.checkCRLs this
                                      currCert
                                      newKey
                                      newCert
                                      true
                                      false
                                      nil
                                      (.trustAnchors params))
                          (return)
                          (catch CertPathValidatorException cpve
                            (when (identical? (.getReason cpve)
                                              CertPathValidatorException$BasicReason/REVOKED)
                              (throw cpve))))
                        (.add badKeys newKey)))))
                (catch InvalidAlgorithmParameterException iape
                  (throw (CertPathValidatorException. iape)))
                (catch CertPathBuilderException cpbe
                  (throw (CertPathValidatorException.
                           "Could not determine revocation status"
                           nil
                           nil
                           -1
                           CertPathValidatorException$BasicReason/UNDETERMINED_REVOCATION_STATUS))))))))))

  (defclass ^:private ^:static RejectKeySelector
    :extends X509CertSelector

    (field ^:private ^:final ^{:tag (Set PublicKey)} badKeySet)

    (constructor [this ^{:tag (Set PublicKey)} badPublicKeys]
      (set! (.-badKeySet this) badPublicKeys))

    (method ^:public match ^boolean [this ^Certificate cert]
      (cond
        (not (.match super cert)) false
        (.contains badKeySet (.getPublicKey cert))
          (do (when (some? debug) (.println debug "RejectKeySelector.match: bad key")) false)
        :else
          (do (when (some? debug) (.println debug "RejectKeySelector.match: returning true")) true)))

    (method ^:public toString ^String [this]
      (java-str "RejectKeySelector: [\n" (.toString super) badKeySet "]"))))

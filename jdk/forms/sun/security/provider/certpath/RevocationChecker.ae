                              (try
                                (let [^Extension nonceExt (OCSPNonceExtension. DEFAULT_NONCE_BYTES)]
                                  (if (> (.size ocspExtensions) 0)
                                      (do
                                        (set! tmpExtensions (ArrayList. ocspExtensions))
                                        (.add tmpExtensions nonceExt))
                                      (set! tmpExtensions (List/of nonceExt)))
                                  (when (some? debug)
                                    (.println
                                      debug

              (when (some? debug) (.println debug (java-str "mergedNC = " newConstraints)))
              (when (some? newConstraints) (cast NameConstraintsExtension (.clone newConstraints))))
            (do
              (try
                (.merge prevNC newConstraints)
                (catch IOException ioe (throw (CertPathValidatorException. ioe))))
              (when (some? debug) (.println debug (java-str "mergedNC = " prevNC)))
              prevNC)))))

  (method ^:private checkBasicConstraints :throws [CertPathValidatorException] ^void [this
                                                                                      ^X509Certificate currCert]
    (let [msg "basic constraints"]
      (when (some? debug)
        (.println debug (java-str "---checking " msg "..."))
        (.println debug (java-str "i = " i ", maxPathLength = " maxPathLength)))
      (when (< i certPathLength)
        (let [^:mutable ^int pathLenConstraint -1]
          (if (< (.getVersion currCert) 3)
              (when (== i 1)
                (when (X509CertImpl/isSelfIssued currCert)
                  (set! pathLenConstraint Integer/MAX_VALUE)))
              (set! pathLenConstraint (.getBasicConstraints currCert)))
          (when (== pathLenConstraint -1)
            (throw (CertPathValidatorException.
                     (java-str msg " check failed: this is not a CA certificate")
                     nil
                     nil
                     -1
                     PKIXReason/NOT_CA_CERT)))
          (when-not (X509CertImpl/isSelfIssued currCert)
            (when (<= maxPathLength 0)
              (throw
                (CertPathValidatorException.
                  (java-str
                    msg
                    " check failed: pathLenConstraint violated - this cert must be the last cert in the certification path")
                  nil
                  nil
                  -1
                  PKIXReason/PATH_TOO_LONG)))
            (set! maxPathLength (unchecked-dec-int maxPathLength)))
          (when (< pathLenConstraint maxPathLength) (set! maxPathLength pathLenConstraint))))
      (when (some? debug)
        (.println debug (java-str "after processing, maxPathLength = " maxPathLength))
        (.println debug (java-str msg " verified.")))))

  (method ^:static mergeBasicConstraints ^int [^X509Certificate cert ^:mutable ^int maxPathLength]
    (let [pathLenConstraint (.getBasicConstraints cert)]
      (when-not (X509CertImpl/isSelfIssued cert)
        (set! maxPathLength (unchecked-dec-int maxPathLength)))
      (when (< pathLenConstraint maxPathLength) (set! maxPathLength pathLenConstraint))
      maxPathLength)))

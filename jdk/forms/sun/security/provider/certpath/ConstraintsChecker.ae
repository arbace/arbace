(defclass ConstraintsChecker
  :extends PKIXCertPathChecker

  (field ^:private ^:static ^:final ^Debug debug (Debug/getInstance "certpath"))

  (field ^:private ^:final ^int certPathLength)

  (field ^:private ^int maxPathLength)


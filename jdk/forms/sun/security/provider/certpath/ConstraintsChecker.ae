        (.remove unresCritExts (.toString PKIXExtensions/BasicConstraints_Id))
        (.remove unresCritExts (.toString PKIXExtensions/NameConstraints_Id)))))

  (method ^:private verifyNameConstraints :throws [CertPathValidatorException] ^void [this
                                                                                      ^X509Certificate currCert]
    (let [msg "name constraints"]
      (when (some? debug) (.println debug (java-str "---checking " msg "...")))
      (when (and (some? prevNC)
                 (or (== i certPathLength) (not (X509CertImpl/isSelfIssued currCert))))
        (when (some? debug)
          (.println debug
                    (java-str "prevNC = " prevNC ", currDN = " (.getSubjectX500Principal currCert))))
        (try
          (when-not (.verify prevNC currCert)
            (throw (CertPathValidatorException. (java-str msg " check failed")
                                                nil
                                                nil
                                                -1
                                                PKIXReason/INVALID_NAME)))
          (catch IOException ioe (throw (CertPathValidatorException. ioe)))))
      (set! prevNC (ConstraintsChecker/mergeNameConstraints currCert prevNC))
      (when (some? debug) (.println debug (java-str msg " verified.")))))

  (method ^:static mergeNameConstraints :throws [CertPathValidatorException] ^NameConstraintsExtension [^X509Certificate currCert
                                                                                                        ^NameConstraintsExtension prevNC]
    (let [^:mutable ^X509CertImpl currCertImpl nil]
      (try
        (set! currCertImpl (X509CertImpl/toImpl currCert))
        (catch CertificateException ce (throw (CertPathValidatorException. ce))))
      (let [newConstraints (.getNameConstraintsExtension currCertImpl)]

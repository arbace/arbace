  (method ^:private matchSubjectKeyID ^boolean [this ^X509Certificate xcert]
    (if (nil? ski)
        true
        (do
          (try
            (let [extVal (.getExtensionValue xcert (.value KnownOIDs/SubjectKeyID))]

(defclass AdaptableX509CertSelector
  :extends X509CertSelector

  (field ^:private ^:static ^:final ^Debug debug (Debug/getInstance "certpath"))

  (field ^:private ^Date startDate)

  (field ^:private ^Date endDate)

  (field ^:private ^byte/1 ski)


  (method ^:public match ^boolean [this ^Certificate cert]
    (let [xcert (cast X509Certificate cert)]
      (if (not (.matchSubjectKeyID this xcert))
          false
          (let [version (.getVersion xcert)]
            (when (and (some? serial) (> version 2))
              (when-not (.equals serial (.getSerialNumber xcert)) (return false)))

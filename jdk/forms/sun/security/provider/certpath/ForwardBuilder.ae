(defclass ^:public ^:final ForwardBuilder
  :extends Builder

  (field ^:private ^:static ^:final ^Debug debug (Debug/getInstance "certpath"))

  (field ^:private ^:final ^{:tag (Set X509Certificate)} trustedCerts)

  (field ^:private ^:final ^{:tag (Set X500Principal)} trustedSubjectDNs)


  (constructor ^:private [this])

  (method ^:static check :throws [IOException CertPathValidatorException] ^OCSPResponse [^{:tag (List CertId)} certIds
                                                                                         ^URI responderURI
                                                                                         ^OCSPResponse$IssuerInfo issuerInfo
                                                                                         ^X509Certificate responderCert
                                                                                         ^Date date
                                                                                         ^{:tag (List Extension)} extensions
                                                                                         ^String variant]
    (let [^:mutable ^byte/1 nonce nil]
      (for-each [^Extension ext extensions]
        (when (.equals (.getId ext) (.toString PKIXExtensions/OCSPNonce_Id))
          (set! nonce (.getValue ext))))
      (let [^:mutable ^OCSPResponse ocspResponse nil]
        (try
          (let [response (OCSP/getOCSPBytes certIds responderURI extensions)]
            (set! ocspResponse (OCSPResponse. response))
            (.verify ocspResponse certIds issuerInfo responderCert date nonce variant))

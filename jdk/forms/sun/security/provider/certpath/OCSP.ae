(defclass ^:public ^:final OCSP
  (field ^:private ^:static ^:final ^Debug debug (Debug/getInstance "certpath"))

  (field ^:private ^:static ^:final ^int DEFAULT_CONNECT_TIMEOUT 15000)

  (field ^:private ^:static ^:final ^int CONNECT_TIMEOUT
    (OCSP/initializeTimeout "com.sun.security.ocsp.timeout" DEFAULT_CONNECT_TIMEOUT))

  (field ^:private ^:static ^:final ^int READ_TIMEOUT
    (OCSP/initializeTimeout "com.sun.security.ocsp.readtimeout" CONNECT_TIMEOUT))

  (field ^:private ^:static ^:final ^boolean USE_GET
    (OCSP/initializeBoolean "com.sun.security.ocsp.useget" true))

  (method ^:private ^:static initializeTimeout ^int [^String prop ^int def]
    (let [timeoutVal (SecurityProperties/getTimeoutSystemProp prop def debug)]
      (when (some? debug) (.println debug (java-str prop " set to " timeoutVal " milliseconds")))
      timeoutVal))

  (method ^:private ^:static initializeBoolean ^boolean [^String prop ^boolean def]
    (let [value (SecurityProperties/getBooleanSystemProp prop def debug)]
      (when (some? debug) (.println debug (java-str prop " set to " value)))

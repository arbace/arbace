                     "Unable to determine revocation status due to network error"
                     ioe
                     nil
                     -1
                     CertPathValidatorException$BasicReason/UNDETERMINED_REVOCATION_STATUS))))
        ocspResponse)))

  (method ^:public ^:static getOCSPBytes :throws [IOException] ^byte/1 [^{:tag (List CertId)} certIds
                                                                        ^URI responderURI
                                                                        ^{:tag (List Extension)} extensions]
    (let [request (OCSPRequest. certIds extensions)
          bytes (.encodeBytes request)
          responder (.toString responderURI)]
      (when (some? debug) (.println debug (java-str "connecting to OCSP service at: " responder)))
      (Event/report Event$ReporterCategory/CRLCHECK "event.ocsp.check" responder)
      (let [^:mutable ^URL url nil
            ^:mutable ^HttpURLConnection con nil]
        (try
          (let [encodedGetReq (StringBuilder. responder)]
            (when-not (.endsWith responder "/") (.append encodedGetReq "/"))
            (.append encodedGetReq
                     (URLEncoder/encode (.encodeToString (Base64/getEncoder) bytes)
                                        StandardCharsets/UTF_8))
            (if (and USE_GET (<= (.length encodedGetReq) 255))
                (do
                  (set! url (.toURL (URI. (.toString encodedGetReq))))
                  (set! con (cast HttpURLConnection (.openConnection url)))
                  (.setConnectTimeout con CONNECT_TIMEOUT)
                  (.setReadTimeout con READ_TIMEOUT)
                  (.setDoOutput con true)
                  (.setDoInput con true)
                  (.setRequestMethod con "GET"))
                (do
                  (set! url (.toURL responderURI))
                  (set! con (cast HttpURLConnection (.openConnection url)))
                  (.setConnectTimeout con CONNECT_TIMEOUT)
                  (.setReadTimeout con READ_TIMEOUT)
                  (.setDoOutput con true)
                  (.setDoInput con true)
                  (.setRequestMethod con "POST")
                  (.setRequestProperty con "Content-type" "application/ocsp-request")
                  (.setRequestProperty con "Content-length" (String/valueOf (alength bytes)))
                  (let [out (.getOutputStream con)] (.write out bytes) (.flush out))))
            (let [respCode (.getResponseCode con)]
              (when-not (== respCode HttpURLConnection/HTTP_OK)
                (let [msg (java-str "Received HTTP error: "
                                    respCode
                                    " - "
                                    (.getResponseMessage con))]
                  (when (some? debug) (.println debug msg))
                  (throw (IOException. msg))))
              (let [contentLength (.getContentLength con)]
                (if (== contentLength -1)
                    (.readAllBytes (.getInputStream con))
                    (IOUtils/readExactlyNBytes (.getInputStream con) contentLength)))))
          (catch URISyntaxException urise (throw (IOException. urise)))
          (finally (when (some? con) (.disconnect con)))))))

  (method ^:public ^:static getResponderURI ^URI [^X509Certificate cert]
    (try (OCSP/getResponderURI (X509CertImpl/toImpl cert)) (catch CertificateException ce nil)))

  (method ^:static getResponderURI ^URI [^X509CertImpl certImpl]
    (let [aia (.getAuthorityInfoAccessExtension certImpl)]
      (when (some? aia)
        (let [^{:tag (List AccessDescription)} descriptions (.getAccessDescriptions aia)]
          (for-each [^AccessDescription description descriptions]
            (when (.equals (.getAccessMethod description) AccessDescription/Ad_OCSP_Id)
              (let [generalName (.getAccessLocation description)]
                (when (== (.getType generalName) GeneralNameInterface/NAME_URI)
                  (let [uri (cast URIName (.getName generalName))] (return (.getURI uri)))))))
          nil))))


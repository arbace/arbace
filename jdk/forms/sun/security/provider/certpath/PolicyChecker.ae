                      (java-str "PolicyChecker.checkPolicy() AFTER PROCESSING: policyMapping = "
                                policyMapping))
            (.println debug
                      (java-str "PolicyChecker.checkPolicy() AFTER PROCESSING: inhibitAnyPolicy = "
                                inhibitAnyPolicy))
            (.println debug
                      (java-str "PolicyChecker.checkPolicy() AFTER PROCESSING: policyTree = "
                                rootNode))
            (.println debug (java-str "PolicyChecker.checkPolicy() " msg " verified")))))))

  (method ^:static mergeExplicitPolicy :throws [CertPathValidatorException] ^int [^:mutable ^int explicitPolicy
                                                                                  ^X509CertImpl currCert
                                                                                  ^boolean finalCert]

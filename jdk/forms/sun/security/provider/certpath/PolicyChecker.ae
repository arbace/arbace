  (method ^:private ^:static processParents ^boolean [^int certIndex ^boolean policiesCritical
                                                      ^boolean rejectPolicyQualifiers
                                                      ^PolicyNodeImpl rootNode ^String curPolicy
                                                      ^{:tag (Set PolicyQualifierInfo)} pQuals
                                                      ^boolean matchAny]
    (let [^:mutable foundMatch false]
      (when (some? debug)
        (.println debug (java-str "PolicyChecker.processParents(): matchAny = " matchAny)))
      (let [^{:tag (Set PolicyNodeImpl)} parentNodes (.getPolicyNodesExpected
                                                       rootNode
                                                       (unchecked-subtract-int certIndex 1)
                                                       curPolicy
                                                       matchAny)]

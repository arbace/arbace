  (method ^:private ^:static rewriteLeafNodes ^PolicyNodeImpl [^int certIndex
                                                               ^{:tag (Set String)} initPolicies
                                                               ^:mutable ^PolicyNodeImpl rootNode]
    (let [^{:tag (Set PolicyNodeImpl)} anyNodes (.getPolicyNodesValid rootNode certIndex ANY_POLICY)]
      (if (.isEmpty anyNodes)
          rootNode

          (when (some? debug)
            (.println debug
                      (java-str "PolicyChecker.processParents() found parent:\n"
                                (.asString curParent))))
          (set! foundMatch true)
          (let [^:mutable ^{:tag (Set String)} curExpPols nil]
            (if (.equals curPolicy ANY_POLICY)
                (let [^{:tag (Set String)} parExpPols (.getExpectedPolicies curParent)]
                  (label :parentExplicitPolicies
                    (for-each [^String curParExpPol parExpPols]
                      (let [^{:tag (Iterator PolicyNodeImpl)} childIter (.getChildren curParent)]
                        (while (.hasNext childIter)
                          (let [childNode (cast PolicyNodeImpl (.next childIter))
                                childPolicy (.getValidPolicy childNode)]
                            (when (.equals curParExpPol childPolicy)
                              (when (some? debug)
                                (.println
                                  debug
                                  (java-str
                                    childPolicy
                                    " in parent's expected policy set already appears in child node")))
                              (continue :parentExplicitPolicies))))
                        (let [^{:tag (Set String)} expPols (HashSet.)]
                          (.add expPols curParExpPol)
                          (PolicyNodeImpl. curParent
                                           curParExpPol
                                           pQuals
                                           policiesCritical
                                           expPols
                                           false))))))
                (do
                  (set! curExpPols (HashSet.))
                  (.add curExpPols curPolicy)
                  (PolicyNodeImpl. curParent curPolicy pQuals policiesCritical curExpPols false)))))
        foundMatch)))


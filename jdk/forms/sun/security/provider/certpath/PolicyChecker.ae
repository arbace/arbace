  (method ^:private ^:static removeInvalidNodes :throws [CertPathValidatorException] ^PolicyNodeImpl [^:mutable ^PolicyNodeImpl rootNode
                                                                                                      ^int certIndex
                                                                                                      ^{:tag (Set String)} initPolicies
                                                                                                      ^CertificatePoliciesExtension currCertPolicies]
    (let [^{:tag (List PolicyInformation)} policyInfo (.getCertPolicies currCertPolicies)
          ^:mutable childDeleted false]

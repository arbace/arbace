                                                                                                         ^int policyMapping
                                                                                                         ^:mutable ^PolicyNodeImpl rootNode
                                                                                                         ^boolean policiesCritical
                                                                                                         ^{:tag (Set PolicyQualifierInfo)} anyQuals]
    (let [polMappingsExt (.getPolicyMappingsExtension currCert)]
      (if (nil? polMappingsExt)
          rootNode

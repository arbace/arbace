                            (let [a (.coef this QWithChecksum i)]
                              (if (== a twoPowWMinus1)
                                  (.getY lmOtSig
                                         i
                                         preCandidate
                                         (unchecked-add-int 22 (unchecked-multiply-int i n)))
                                  (do
                                    (aset preZi 20 (unchecked-byte (bit-shift-right-int i 8)))
                                    (aset preZi 21 (unchecked-byte i))
                                    (.getY lmOtSig i preZi 23)))

                                (when (< j twoPowWMinus1)
                                  (aset preZi 22 (unchecked-byte j))
                                  (if (< j twoPowWMinus2)
                                      (do
                                        (.digestFixedLengthPreprocessed
                                          this
                                          sha256
                                          preZi
                                          hashLen
                                          preZi
                                          23
                                          n)
                                        (recur (unchecked-inc-int j)))
                                      (do
                                        (.digestFixedLengthPreprocessed
                                          this
                                          sha256
                                          preZi
                                          hashLen
                                          preCandidate
                                          (unchecked-add-int 22 (unchecked-multiply-int i n))
                                          n)
                                        (recur (unchecked-inc-int j))))))
                              (recur (unchecked-inc-int i)))))
                        (.update md
                                 preCandidate
                                 0
                                 (unchecked-add-int 22 (unchecked-multiply-int p n)))
                        (set! result (.digest md))))))
                (catch DigestException e (throw (ProviderException. "Digest failed" e))))
              (when-not (== n hashAlg_n) (set! result (Arrays/copyOfRange result 0 n)))
              result))))))

  (defclass ^:public ^:static KeyFactoryImpl
    :extends KeyFactorySpi

    (method ^:protected engineGeneratePublic :throws [InvalidKeySpecException] ^PublicKey [this
                                                                                           ^KeySpec keySpec]
      (if-instance [^X509EncodedKeySpec x509Spec keySpec]
        (try
          (return (HSSPublicKey. (.getEncoded x509Spec) true))
          (catch InvalidKeyException e (throw (InvalidKeySpecException. e))))
        (when-instance [^RawKeySpec rawSpec keySpec]
          (try
            (return (HSSPublicKey. (.getKeyArr rawSpec) false))
            (catch InvalidKeyException e (throw (InvalidKeySpecException. e))))))
      (throw (InvalidKeySpecException. "Unrecognized KeySpec")))

    (method ^:protected engineGeneratePrivate :throws [InvalidKeySpecException] ^PrivateKey [this
                                                                                             ^KeySpec keySpec]
      (throw (InvalidKeySpecException. "Private key generation is not supported")))

    (method ^:protected engineGetKeySpec :type-params [(T extends KeySpec)] :throws [InvalidKeySpecException] ^T [this
                                                                                                                  ^Key key
                                                                                                                  ^{:tag (Class T)} keySpec]
      (when (nil? key) (throw (InvalidKeySpecException. "key should not be null")))
      (when (and (.equals (.getFormat key) "X.509")
                 (.equalsIgnoreCase (.getAlgorithm key) "HSS/LMS"))
        (when (.isAssignableFrom keySpec X509EncodedKeySpec)
          (return (cast KeySpec (.cast keySpec (X509EncodedKeySpec. (.getEncoded key))))))
        (throw (InvalidKeySpecException. "keySpec is not an X509EncodedKeySpec")))
      (throw (InvalidKeySpecException. "Wrong key format or key algorithm")))

    (method ^:protected engineTranslateKey :throws [InvalidKeyException] ^Key [this ^Key key]
      (when (nil? key) (throw (InvalidKeyException. "key cannot be null")))
      (let [^:mutable ^PublicKey pKey nil]
        (try
          (when (instance? HSSPublicKey key) (return key))
          (let [x509EncodedKeySpec (cast X509EncodedKeySpec
                                         (.engineGetKeySpec this key X509EncodedKeySpec))]
            (set! pKey (.engineGeneratePublic this x509EncodedKeySpec)))
          (catch InvalidKeySpecException e (throw (InvalidKeyException. e))))
        pKey)))

  (defclass ^:static HSSPublicKey
    :extends X509Key
    :implements [Serializable]

    (field ^:private ^:static ^:final ^long serialVersionUID 21)

    (field ^:private ^:transient ^int L)

    (field ^:private ^:transient ^LMSPublicKey lmsPublicKey)

    (constructor :throws [InvalidKeyException] [this ^byte/1 keyArray ^boolean x509Encoded]
      (if x509Encoded
          (do
            (.decode this keyArray)
            (when (or (not (.equals (.value KnownOIDs/HSSLMS) (.toString (.getOID (.-algid this)))))
                      (some? (.getParameters (.-algid this))))
              (throw (InvalidKeyException. "X509Key is not an HSS key"))))
          (let [inLen (alength keyArray)]
            (when (< inLen 4) (throw (InvalidKeyException. "HSS public key too short")))
            (set! L (LMSUtils/fourBytesToInt keyArray 0))
            (set! lmsPublicKey
                  (LMSPublicKey. (Arrays/copyOfRange keyArray 4 (alength keyArray)) 0 true))
            (set! (.-algid this) (AlgorithmId. (ObjectIdentifier/of KnownOIDs/HSSLMS)))
            (.setKey this (BitArray. (unchecked-multiply-int 8 (alength keyArray)) keyArray)))))

    (method ^:public toString ^String [this]
      (let [encoder (HexDumpEncoder.)]
        (java-str "HSS/LMS public key, number of layers: "
                  L
                  ", LMS type: "
                  (LMSUtils/lmsType (.-type lmsPublicKey))
                  ",\nOTS type: "
                  (LMSUtils/lmotsType (.-otsType lmsPublicKey))
                  ", byte array representation:\n"
                  (.encode encoder (.toByteArray (.getKey this))))))

    (method ^:protected parseKeyBits :throws [InvalidKeyException] ^void [this]
      (let [^:mutable keyArray (.toByteArray (.getKey this))]
        (when (< (alength keyArray) 12)
          (throw (InvalidKeyException. "LMS public key is too short")))
        (when (and (== (aget keyArray 0) DerValue/tag_OctetString)
                   (== (aget keyArray 1) (unchecked-subtract-int (alength keyArray) 2)))
          (set! keyArray (Arrays/copyOfRange keyArray 2 (alength keyArray)))
          (.setKey this (BitArray. (unchecked-multiply-int (alength keyArray) 8) keyArray)))
        (set! L (LMSUtils/fourBytesToInt keyArray 0))
        (set! lmsPublicKey (LMSPublicKey. keyArray 4 true))))

    (method ^:private writeReplace :throws [ObjectStreamException] [this]
      (KeyRep. KeyRep$Type/PUBLIC (.getAlgorithm this) (.getFormat this) (.getEncoded this)))

    (method ^:private readObject :throws [ObjectStreamException] ^void [this ^ObjectInputStream s]
      (throw (InvalidObjectException. "HSS public keys are not directly deserializable"))))

  (defclass ^:static HSSSignature
    (field ^:private ^:final ^int Nspk)

    (field ^:private ^:final ^LMSignature/1 siglist)

    (field ^:private ^:final ^LMSPublicKey/1 pubList)

    (constructor :throws [SignatureException] [this ^byte/1 sigArr ^HSSPublicKey pubKey]
      (when (< (alength sigArr) 4) (throw (SignatureException. "HSS signature is too short")))
      (set! Nspk (LMSUtils/fourBytesToInt sigArr 0))
      (when-not (== (unchecked-add-int Nspk 1) (.-L pubKey))
        (throw (SignatureException. "HSS signature and public key have different tree heights")))
      (set! siglist (new LMSignature/1 (unchecked-add-int Nspk 1)))
      (set! pubList (new LMSPublicKey/1 Nspk))
      (let [^:mutable ^int index 4]
        (try
          (loop [^int i 0]
            (when (< i Nspk)
              (aset siglist i (LMSignature. sigArr index false))
              (set! index (unchecked-add-int index (.sigArrayLength (aget siglist i))))
              (aset pubList i (LMSPublicKey. sigArr index false))
              (when-not (.hasSameHash (.-lmsParams (.-lmsPublicKey pubKey))
                                      (.-lmsParams (aget pubList i)))
                (throw (SignatureException.
                         "Digest algorithm in public key and Signature do not match")))
              (set! index (unchecked-add-int index (.keyArrayLength (aget pubList i))))
              (recur (unchecked-inc-int i))))
          (aset siglist Nspk (LMSignature. sigArr index true))
          (catch InvalidKeyException e
            (throw (SignatureException. "Invalid key in HSS signature" e))))))))

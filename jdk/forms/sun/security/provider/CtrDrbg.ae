          (loop [^int i 0]
            (when (< (unchecked-multiply-int i blockLen) (alength temp))
              (let [iv (new byte/1 blockLen)]
                (aset iv 0 (unchecked-byte (bit-shift-right-int i 24)))
                (aset iv 1 (unchecked-byte (bit-shift-right-int i 16)))
                (aset iv 2 (unchecked-byte (bit-shift-right-int i 8)))
                (aset iv 3 (unchecked-byte i))
                (let [^:mutable tailLen (unchecked-subtract-int
                                          (alength temp)
                                          (unchecked-multiply-int blockLen i))]
                  (when (> tailLen blockLen) (set! tailLen blockLen))
                  (System/arraycopy (.bcc this k iv ln input (new byte/1 [(unchecked-byte 0x80)]))

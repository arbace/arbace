  (method ^:protected initEngine ^void [this]
    (try
      (set! cipher (Cipher/getInstance cipherAlg "SunJCE"))
      (catch [NoSuchProviderException NoSuchAlgorithmException NoSuchPaddingException] e
        (try
          (set! cipher (Cipher/getInstance cipherAlg))
          (catch [NoSuchAlgorithmException NoSuchPaddingException] exc
            (throw (InternalError. (java-str "internal error: " cipherAlg " not available.") exc)))))))

  (method ^:private status ^void [this]
    (when (some? CtrDrbg/debug)
      (.println CtrDrbg/debug this (java-str "Key = " (.formatHex (HexFormat/of) k)))
      (.println CtrDrbg/debug this (java-str "V   = " (.formatHex (HexFormat/of) v)))
      (.println CtrDrbg/debug this (java-str "reseed counter = " (.-reseedCounter this)))))

  (method ^:private update ^void [this ^byte/1 input]
    (when-not (== (alength input) seedLen)
      (throw (IllegalArgumentException. (java-str "input length not seedLen: " (alength input)))))
    (try
      (let [m (unchecked-divide-int (unchecked-subtract-int (unchecked-add-int seedLen blockLen) 1)
                                    blockLen)
            ^:mutable temp (new byte/1 (unchecked-multiply-int m blockLen))]
        (loop [^int i 0]
          (when (< i m)
            (CtrDrbg/addOne v ctrLen)
            (.init cipher Cipher/ENCRYPT_MODE (SecretKeySpec. k keyAlg))
            (.doFinal cipher v 0 blockLen temp (unchecked-multiply-int i blockLen))
            (recur (unchecked-inc-int i))))

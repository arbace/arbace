    (.configure this params))

  (method ^:private ^:static alg2strength ^int [^String algorithm]
    (switch (.toUpperCase algorithm Locale/ROOT)
      "AES-128" 128
      "AES-192" 192
      "AES-256" 256
      (throw (IllegalArgumentException. (java-str algorithm " not supported in CTR_DBRG")))))

  (method ^:protected chooseAlgorithmAndStrength ^void [this]
    (if (some? (.-requestedAlgorithm this))
        (do
          (set! (.-algorithm this) (.toUpperCase (.-requestedAlgorithm this) Locale/ROOT))
          (let [supportedStrength (CtrDrbg/alg2strength (.-algorithm this))]
            (if (>= (.-requestedInstantiationSecurityStrength this) 0)
                (let [tryStrength (CtrDrbg/getStandardStrength
                                    (.-requestedInstantiationSecurityStrength this))]
                  (when (> tryStrength supportedStrength)
                    (throw (IllegalArgumentException.
                             (java-str (.-algorithm this)
                                       " does not support strength "
                                       (.-requestedInstantiationSecurityStrength this)))))
                  (set! (.-securityStrength this) tryStrength))
                (set! (.-securityStrength this)
                      (Math/min CtrDrbg/DEFAULT_STRENGTH supportedStrength)))))
        (let [^:mutable ^int tryStrength (if (< (.-requestedInstantiationSecurityStrength this) 0)
                                             CtrDrbg/DEFAULT_STRENGTH
                                             (.-requestedInstantiationSecurityStrength this))]
          (set! tryStrength (CtrDrbg/getStandardStrength tryStrength))
          (cond
            (and (<= tryStrength 128) (< AES_LIMIT 256)) (set! (.-algorithm this) "AES-128")
            (>= AES_LIMIT 256) (set! (.-algorithm this) "AES-256")
            :else
              (throw (IllegalArgumentException.
                       (java-str "unsupported strength "
                                 (.-requestedInstantiationSecurityStrength this)))))
          (set! (.-securityStrength this) tryStrength)))
    (switch (.toUpperCase (.-algorithm this) Locale/ROOT)
      ("AES-128" "AES-192" "AES-256")
        (do
          (set! (.-keyAlg this) "AES")
          (set! (.-cipherAlg this) "AES/ECB/NoPadding")
          (switch (.-algorithm this)
            "AES-128" (set! (.-keyLen this) (unchecked-divide-int 128 8))
            "AES-192"
              (do
                (set! (.-keyLen this) (unchecked-divide-int 192 8))
                (when (< AES_LIMIT 192)
                  (throw (IllegalArgumentException.
                           (java-str (.-algorithm this)
                                     " not available (because policy) in CTR_DBRG")))))
            "AES-256"
              (do
                (set! (.-keyLen this) (unchecked-divide-int 256 8))
                (when (< AES_LIMIT 256)
                  (throw (IllegalArgumentException.
                           (java-str (.-algorithm this)
                                     " not available (because policy) in CTR_DBRG")))))
            (throw (IllegalArgumentException.
                     (java-str (.-algorithm this) " not supported in CTR_DBRG"))))
          (set! (.-blockLen this) (unchecked-divide-int 128 8)))
      (throw (IllegalArgumentException. (java-str (.-algorithm this) " not supported in CTR_DBRG"))))

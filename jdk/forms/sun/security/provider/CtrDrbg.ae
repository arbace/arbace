        (set! v (Arrays/copyOfRange temp (unchecked-subtract-int seedLen blockLen) seedLen)))
      (catch GeneralSecurityException e (throw (InternalError. e)))))

  (method ^:protected instantiateAlgorithm ^void [this ^byte/1 ei]
    (when (some? CtrDrbg/debug) (.println CtrDrbg/debug this "instantiate"))
    (let [^:mutable ^byte/1 more nil]
      (if (.-usedf this)
          (if (nil? (.-personalizationString this))
              (set! more (.-nonce this))
              (do
                (when (< (unchecked-add-int (alength (.-nonce this))
                                            (alength (.-personalizationString this)))
                         0)
                  (throw
                    (IllegalArgumentException. "nonce plus personalization string is too long")))
                (set! more
                      (Arrays/copyOf (.-nonce this)
                                     (unchecked-add-int
                                       (alength (.-nonce this))
                                       (alength (.-personalizationString this)))))
                (System/arraycopy (.-personalizationString this)
                                  0
                                  more
                                  (alength (.-nonce this))
                                  (alength (.-personalizationString this)))))
          (set! more (.-personalizationString this)))
      (.reseedAlgorithm this ei more)))

  (method ^:private df ^byte/1 [this ^byte/1 input]
    (let [l (alength input)
          n seedLen
          ln (new byte/1 8)]
      (aset ln 0 (unchecked-byte (bit-shift-right-int l 24)))
      (aset ln 1 (unchecked-byte (bit-shift-right-int l 16)))
      (aset ln 2 (unchecked-byte (bit-shift-right-int l 8)))
      (aset ln 3 (unchecked-byte l))
      (aset ln 4 (unchecked-byte (bit-shift-right-int n 24)))
      (aset ln 5 (unchecked-byte (bit-shift-right-int n 16)))
      (aset ln 6 (unchecked-byte (bit-shift-right-int n 8)))
      (aset ln 7 (unchecked-byte n))
      (let [^:mutable k (new byte/1 keyLen)]
        (loop [^int i 0]
          (when (< i (alength k)) (aset k i (unchecked-byte i)) (recur (unchecked-inc-int i))))

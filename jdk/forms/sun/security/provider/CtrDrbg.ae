  (method ^:private bcc ^byte/1 [this ^byte/1 k & ^byte/2 data]
    (let [^:mutable chain (new byte/1 blockLen)
          ^:mutable ^int n1 0
          ^:mutable ^int n2 0]
      (while (< n1 (alength data))
        (let [^:mutable ^int j 0]
          (set! j 0)
          (label :out
            (while (< j blockLen)
              (while (>= n2 (alength (aget data n1)))
                (set! n1 (unchecked-inc-int n1))
                (when (>= n1 (alength data)) (break :out))
                (set! n2 0))
              (aset chain j (unchecked-byte (bit-xor-int (aget chain j) (aget data n1 n2))))
              (set! n2 (unchecked-inc-int n2))
              (set! j (unchecked-inc-int j))))
          (when (== j 0) (break))
          (try
            (.init cipher Cipher/ENCRYPT_MODE (SecretKeySpec. k keyAlg))
            (set! chain (.doFinal cipher chain))
            (catch GeneralSecurityException e (throw (InternalError. e))))))
      chain))

  (method ^:protected ^:synchronized reseedAlgorithm ^void [this ^:mutable ^byte/1 ei
                                                            ^byte/1 additionalInput]
    (cond
      (.-usedf this)
        (do
          (when (some? additionalInput)
            (when (< (unchecked-add-int (alength ei) (alength additionalInput)) 0)
              (throw (IllegalArgumentException. "entropy plus additional input is too long")))
            (let [temp (Arrays/copyOf ei (unchecked-add-int (alength ei) (alength additionalInput)))]
              (System/arraycopy additionalInput 0 temp (alength ei) (alength additionalInput))
              (set! ei temp)))
          (set! ei (.df this ei)))
      (some? additionalInput)
        (loop [^int i 0]
          (when (< i (alength additionalInput))
            (aset ei i (unchecked-byte (bit-xor-int (aget ei i) (aget additionalInput i))))
            (recur (unchecked-inc-int i)))))
    (when (nil? v) (set! k (new byte/1 keyLen)) (set! v (new byte/1 blockLen)))
    (.update this ei)
    (set! (.-reseedCounter this) 1))

  (method ^:private ^:static addOne ^void [^byte/1 data ^int len]
    (loop [^int i 0]
      (when (< i len)
        (let [i-1 (unchecked-subtract-int (unchecked-subtract-int (alength data) 1) i)]
          (aset data i-1 (unchecked-byte (unchecked-inc-int (aget data i-1)))))
        (when-not (not (== (aget data
                                 (unchecked-subtract-int
                                   (unchecked-subtract-int (alength data) 1)
                                   i))
                           0))
          (recur (unchecked-inc-int i))))))

  (method ^:public ^:synchronized generateAlgorithm ^void [this ^byte/1 result
                                                           ^:mutable ^byte/1 additionalInput]
    (when (some? CtrDrbg/debug) (.println CtrDrbg/debug this "generateAlgorithm"))
    (if (some? additionalInput)
        (do
          (if (.-usedf this)
              (set! additionalInput (.df this additionalInput))
              (set! additionalInput (Arrays/copyOf additionalInput seedLen)))
          (.update this additionalInput))
        (set! additionalInput (new byte/1 seedLen)))
    (let [^:mutable ^int pos 0
          ^:mutable len (alength result)]
      (while (> len 0)
        (CtrDrbg/addOne v ctrLen)
        (try
          (.init cipher Cipher/ENCRYPT_MODE (SecretKeySpec. k keyAlg))
          (if (> len blockLen)
              (.doFinal cipher v 0 blockLen result pos)
              (let [out (.doFinal cipher v)]

          (catch GeneralSecurityException e (throw (InternalError. e))))
        (set! len (unchecked-subtract-int len blockLen))
        (when (<= len 0) (break))
        (set! pos (unchecked-add-int pos blockLen)))
      (.update this additionalInput)
      (set! (.-reseedCounter this) (unchecked-inc-int (.-reseedCounter this)))))


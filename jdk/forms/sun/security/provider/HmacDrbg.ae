      (set! v (new byte/1 (.-outLen this)))
      (Arrays/fill v (unchecked-byte 1)))
    (.update this input)
    (set! (.-reseedCounter this) 1))

  (method ^:public ^:synchronized generateAlgorithm ^void [this ^byte/1 result
                                                           ^byte/1 additionalInput]
    (when (some? HmacDrbg/debug) (.println HmacDrbg/debug this "generateAlgorithm"))
    (when (some? additionalInput) (.update this (Collections/singletonList additionalInput)))

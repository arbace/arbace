                        acc
                        (bit-shift-left-int (bit-and-int (aget v offset) 0xff) top)))
                (set! offset (unchecked-inc-int offset))
                (set! top (unchecked-add-int top 8)))
              (aset (aget result i)
                    j
                    (unchecked-subtract-int maxValue

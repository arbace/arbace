                      (unchecked-add-int tOffset 3)
                      (unchecked-add-int
                        (bit-and-int (bit-shift-right-int (aget v (unchecked-add-int vOffset 3)) 6)
                                     0x3)
                        (bit-and-int (bit-shift-left-int (aget v (unchecked-add-int vOffset 4)) 2)
                                     0x3FF)))
                (recur (unchecked-inc-int j)))))
          (recur (unchecked-inc-int i))))
      t1))

  (method ^:public bitUnpack ^int/2 [this ^int/2 result ^byte/1 v ^int offset ^int dim ^int maxValue
                                     ^int bitsPerCoeff]
    (switch bitsPerCoeff
      3 (.bitUnpackGeneral this result v offset dim maxValue 3)
      4 (.bitUnpackGeneral this result v offset dim maxValue 4)
      13 (.bitUnpackGeneral this result v offset dim maxValue 13)
      18 (.bitUnpack18 this result v offset dim maxValue)
      20 (.bitUnpack20 this result v offset dim maxValue)
      (throw (RuntimeException.
               (java-str "Wrong bitsPerCoeff value in bitUnpack (" bitsPerCoeff ")."))))
    result)

  (method ^:public bitUnpackGeneral ^void [this ^int/2 result ^byte/1 v ^:mutable ^int offset
                                           ^int dim ^int maxValue ^int bitsPerCoeff]

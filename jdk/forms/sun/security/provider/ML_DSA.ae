              (set! offset (unchecked-inc-int offset))
              (set! acc (bit-shift-right-int acc 8))
              (set! shift (unchecked-subtract-int shift 8)))
            (recur (unchecked-inc-int m)))))))

  (method ^:public t1Unpack ^int/2 [this ^byte/1 v]
    (let [t1 (ML_DSA/integerMatrixAlloc mlDsa_k ML_DSA_N)]
      (loop [^int i 0]
        (when (< i mlDsa_k)
          (loop [^int j 0]
            (when (< j (unchecked-divide-int ML_DSA_N 4))
              (let [tOffset (unchecked-multiply-int j 4)

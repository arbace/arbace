                        (bit-and-int (bit-shift-right-int (aget v (unchecked-add-int vOffset 2)) 4)
                                     0xF)
                        (bit-and-int (bit-shift-left-int (aget v (unchecked-add-int vOffset 3)) 4)
                                     0x3FF)))

  (constructor ^:public [this ^int security_level]
    (switch security_level
      ML_DSA_44
        (do
          (set! level 2)
          (set! tau 39)
          (set! lambda 128)
          (set! gamma1 (bit-shift-left-int 1 17))
          (set! gamma1Bits 17)
          (set! gamma2 (unchecked-divide-int (unchecked-subtract-int ML_DSA_Q 1) 88))
          (set! mlDsa_k 4)
          (set! mlDsa_l 4)
          (set! eta 2)
          (set! beta 78)
          (set! omega 80)
          (set! publicKeyLength 1312)
          (set! signatureLength 2420)
          (set! s1PackedLength 384)
          (set! s2PackedLength 384)
          (set! t0PackedLength 1664)
          (set! s1s2CoeffSize 3)
          (set! wCoeffSize 6))
      ML_DSA_65
        (do
          (set! level 3)
          (set! tau 49)
          (set! lambda 192)
          (set! gamma1 (bit-shift-left-int 1 19))
          (set! gamma2 (unchecked-divide-int (unchecked-subtract-int ML_DSA_Q 1) 32))
          (set! mlDsa_k 6)
          (set! mlDsa_l 5)
          (set! eta 4)
          (set! beta 196)
          (set! omega 55)
          (set! publicKeyLength 1952)
          (set! signatureLength 3293)
          (set! s1PackedLength 640)
          (set! s2PackedLength 768)
          (set! t0PackedLength 2496)
          (set! s1s2CoeffSize 4)
          (set! wCoeffSize 4)
          (set! gamma1Bits 19))
      ML_DSA_87
        (do
          (set! level 4)
          (set! tau 60)
          (set! lambda 256)
          (set! gamma1 (bit-shift-left-int 1 19))
          (set! gamma1Bits 19)
          (set! gamma2 (unchecked-divide-int (unchecked-subtract-int ML_DSA_Q 1) 32))
          (set! mlDsa_k 8)
          (set! mlDsa_l 7)
          (set! eta 2)
          (set! beta 120)
          (set! omega 75)
          (set! publicKeyLength 2592)
          (set! signatureLength 4595)
          (set! s1PackedLength 672)
          (set! s2PackedLength 768)
          (set! t0PackedLength 3328)
          (set! s1s2CoeffSize 3)
          (set! wCoeffSize 4))
      (throw (IllegalArgumentException. "Wrong security level"))))

  (defclass ^:public ^:record ML_DSA_PrivateKey [^byte/1 rho ^byte/1 k ^byte/1 tr ^int/2 s1
                                                 ^int/2 s2 ^int/2 t0]
    (method destroy ^void [this]
      (Arrays/fill k (unchecked-byte 0))
      (for-each [^int/1 b s1] (Arrays/fill b (unchecked-byte 0)))
      (for-each [^int/1 b s2] (Arrays/fill b (unchecked-byte 0)))
      (for-each [^int/1 b t0] (Arrays/fill b (unchecked-byte 0)))))

  (defclass ^:public ^:record ML_DSA_PublicKey [^byte/1 rho ^int/2 t1])

  (defclass ^:public ^:record ML_DSA_KeyPair [^ML_DSA_PrivateKey privateKey
                                              ^ML_DSA_PublicKey publicKey])

  (defclass ^:public ^:record ML_DSA_Signature [^byte/1 commitmentHash ^int/2 response
                                                ^boolean/2 hint])

  (method ^:public checkPublicKey :throws [InvalidKeyException] [this ^byte/1 pk]
    (let [pk_size (unchecked-add-int 32
                                     (unchecked-multiply-int
                                       (unchecked-multiply-int mlDsa_k 32)
                                       (unchecked-subtract-int 23 ML_DSA_D)))]
      (when-not (== (alength pk) pk_size)
        (throw (InvalidKeyException. "Incorrect public key size")))
      nil))

  (method ^:public checkPrivateKey :throws [InvalidKeyException] [this ^byte/1 sk]
    (let [^int eta_bits (if (== eta 4) 4 3)
          sk_size (unchecked-add-int 128
                                     (unchecked-multiply-int
                                       32
                                       (unchecked-add-int
                                         (unchecked-multiply-int
                                           (unchecked-add-int mlDsa_l mlDsa_k)
                                           eta_bits)
                                         (unchecked-multiply-int ML_DSA_D mlDsa_k))))]
      (when-not (== (alength sk) sk_size)
        (throw (InvalidKeyException. "Incorrect private key size")))
      nil))

  (method ^:public generateKeyPairInternal ^ML_DSA_KeyPair [this ^byte/1 randomBytes]
    (let [hash (SHA3$SHAKE256. 0)
          crHash (SHA3$SHAKE256. TR_LEN)]
      (.update hash randomBytes)
      (.update hash (unchecked-byte mlDsa_k))
      (.update hash (unchecked-byte mlDsa_l))
      (let [rho (.squeeze hash A_SEED_LEN)
            rhoPrime (.squeeze hash S1S2_SEED_LEN)
            k (.squeeze hash K_LEN)]
        (.reset hash)
        (let [keygenA (.generateA this rho)
              s1 (ML_DSA/integerMatrixAlloc mlDsa_l ML_DSA_N)
              s2 (ML_DSA/integerMatrixAlloc mlDsa_k ML_DSA_N)]
          (.sampleS1S2 this s1 s2 hash rhoPrime)
          (.mlDsaVectorNtt this s1)
          (let [As1 (ML_DSA/integerMatrixAlloc mlDsa_k ML_DSA_N)]
            (.matrixVectorPointwiseMultiply this As1 keygenA s1)
            (.mlDsaVectorInverseNtt this s1)
            (.mlDsaVectorInverseNtt this As1)
            (let [t (.vectorAddPos this As1 s2)
                  t0 (ML_DSA/integerMatrixAlloc mlDsa_k ML_DSA_N)
                  t1 (ML_DSA/integerMatrixAlloc mlDsa_k ML_DSA_N)]
              (.power2Round this t t0 t1)
              (let [pk (ML_DSA_PublicKey. rho t1)
                    publicKeyBytes (.pkEncode this pk)]
                (.update crHash publicKeyBytes)
                (let [tr (.digest crHash)
                      sk (ML_DSA_PrivateKey. rho k tr s1 s2 t0)]
                  (ML_DSA_KeyPair. sk pk)))))))))

  (method ^:private ^:static deepClone ^int/2 [^int/2 array]
    (let [clone (new int/2 (alength array))]
      (loop [^int i 0]
        (when (< i (alength array))
          (aset clone i (.clone (aget array i)))
          (recur (unchecked-inc-int i))))
      clone))

  (method ^:public privKeyToPubKey ^ML_DSA_PublicKey [this ^ML_DSA_PrivateKey sk]
    (let [keygenA (.generateA this (.-rho sk))
          s1 (ML_DSA/deepClone (.-s1 sk))]
      (.mlDsaVectorNtt this s1)
      (let [As1 (ML_DSA/integerMatrixAlloc mlDsa_k ML_DSA_N)]
        (.matrixVectorPointwiseMultiply this As1 keygenA s1)
        (.mlDsaVectorInverseNtt this As1)
        (let [t (.vectorAddPos this As1 (.-s2 sk))
              t0 (ML_DSA/integerMatrixAlloc mlDsa_k ML_DSA_N)
              t1 (ML_DSA/integerMatrixAlloc mlDsa_k ML_DSA_N)]
          (.power2Round this t t0 t1)
          (when-not (Arrays/deepEquals t0 (.-t0 sk))
            (throw (IllegalArgumentException. "t0 does not patch")))
          (let [crHash (SHA3$SHAKE256. TR_LEN)
                pk (ML_DSA_PublicKey. (.-rho sk) t1)
                publicKeyBytes (.pkEncode this pk)]
            (.update crHash publicKeyBytes)
            (let [tr (.digest crHash)]
              (when-not (Arrays/equals tr (.-tr sk))
                (throw (IllegalArgumentException. "tr does not patch")))
              (ML_DSA_PublicKey. (.-rho sk) t1)))))))

  (method ^:public signInternal ^ML_DSA_Signature [this ^byte/1 message ^byte/1 rnd ^byte/1 skBytes]
    (let [sk (.skDecode this skBytes)
          hash (SHA3$SHAKE256. 0)]
      (.mlDsaVectorNtt this (.s1 sk))
      (.mlDsaVectorNtt this (.s2 sk))
      (.mlDsaVectorNtt this (.t0 sk))
      (let [aHat (.generateA this (.rho sk))]
        (.update hash (.tr sk))
        (.update hash message)
        (let [mu (.squeeze hash MU_LEN)]
          (.reset hash)
          (.update hash (.k sk))
          (.update hash rnd)
          (.update hash mu)
          (let [rhoDoublePrime (.squeeze hash MASK_SEED_LEN)]
            (.reset hash)
            (let [^:mutable z (ML_DSA/integerMatrixAlloc mlDsa_l ML_DSA_N)
                  h (ML_DSA/booleanMatrixAlloc mlDsa_k ML_DSA_N)
                  ^:mutable commitmentHash (new byte/1 (unchecked-divide-int lambda 4))
                  y (ML_DSA/integerMatrixAlloc mlDsa_l ML_DSA_N)
                  yy (ML_DSA/integerMatrixAlloc mlDsa_l ML_DSA_N)
                  ^:mutable w (ML_DSA/integerMatrixAlloc mlDsa_k ML_DSA_N)
                  w0 (ML_DSA/integerMatrixAlloc mlDsa_k ML_DSA_N)
                  w1 (ML_DSA/integerMatrixAlloc mlDsa_k ML_DSA_N)
                  w_ct0 (ML_DSA/integerMatrixAlloc mlDsa_k ML_DSA_N)
                  c (new int/1 ML_DSA_N)
                  cs1 (ML_DSA/integerMatrixAlloc mlDsa_l ML_DSA_N)
                  cs2 (ML_DSA/integerMatrixAlloc mlDsa_k ML_DSA_N)
                  ct0 (ML_DSA/integerMatrixAlloc mlDsa_k ML_DSA_N)
                  ^:mutable ^int kappa 0]
              (while true
                (.expandMask this y rhoDoublePrime kappa)
                (loop [^int i 0]
                  (when (< i (alength y))
                    (System/arraycopy (aget y i) 0 (aget yy i) 0 ML_DSA_N)
                    (recur (unchecked-inc-int i))))
                (.mlDsaVectorNtt this y)
                (.matrixVectorPointwiseMultiply this w aHat y)
                (.mlDsaVectorInverseNtt this w)
                (.decompose this w w0 w1)
                (.update hash mu)
                (.update hash (.simpleBitPack this wCoeffSize w1))
                (set! commitmentHash (.squeeze hash (unchecked-divide-int lambda 4)))
                (.reset hash)
                (.sampleInBall this c commitmentHash)
                (ML_DSA/mlDsaNtt c)
                (.nttConstMultiply this cs1 c (.s1 sk))
                (.nttConstMultiply this cs2 c (.s2 sk))
                (.mlDsaVectorInverseNtt this cs1)
                (.mlDsaVectorInverseNtt this cs2)
                (set! z (.vectorAdd this z yy cs1))
                (.vectorSub this w0 cs2 false)
                (set! kappa (unchecked-add-int kappa mlDsa_l))
                (when-not (or (.vectorNormBound this z (unchecked-subtract-int gamma1 beta))
                              (.vectorNormBound this w0 (unchecked-subtract-int gamma2 beta)))
                  (.nttConstMultiply this ct0 c (.t0 sk))
                  (.mlDsaVectorInverseNtt this ct0)
                  (set! w (.vectorSub this w cs2 false))
                  (let [hint_weight (.makeHint this h w (.vectorAdd this w_ct0 w ct0))]
                    (when (or (.vectorNormBound this ct0 gamma2) (> hint_weight omega)) (continue)))
                  (.destroy sk)
                  (return (ML_DSA_Signature. commitmentHash z h))))))))))

  (method ^:public verifyInternal :throws [SignatureException] ^boolean [this ^byte/1 pkBytes
                                                                         ^byte/1 message
                                                                         ^byte/1 sigBytes]
    (let [sig (.sigDecode this sigBytes)
          hash (SHA3$SHAKE256. 0)
          pk (.pkDecode this pkBytes)
          aHat (.generateA this (.rho pk))]
      (.update hash pkBytes)
      (let [tr (.squeeze hash TR_LEN)]
        (.reset hash)
        (.update hash tr)
        (.update hash message)
        (let [mu (.squeeze hash MU_LEN)]
          (.reset hash)
          (let [cHat (new int/1 ML_DSA_N)]
            (.sampleInBall this cHat (.commitmentHash sig))
            (ML_DSA/mlDsaNtt cHat)
            (let [zNorm (.vectorNormBound this (.response sig) (unchecked-subtract-int gamma1 beta))]
              (.mlDsaVectorNtt this (.response sig))
              (let [aHatZ (ML_DSA/integerMatrixAlloc mlDsa_k ML_DSA_N)]
                (.matrixVectorPointwiseMultiply this aHatZ aHat (.response sig))
                (let [t1Hat (.vectorConstMul this (bit-shift-left-int 1 ML_DSA_D) (.t1 pk))]
                  (.mlDsaVectorNtt this t1Hat)
                  (let [ct1 (ML_DSA/integerMatrixAlloc mlDsa_k ML_DSA_N)]
                    (.nttConstMultiply this ct1 cHat t1Hat)
                    (let [wApprox (.vectorSub this aHatZ ct1 true)]
                      (.mlDsaVectorInverseNtt this wApprox)
                      (let [w1Prime (.useHint this (.hint sig) wApprox)]
                        (.update hash mu)
                        (.update hash (.simpleBitPack this wCoeffSize w1Prime))
                        (let [cTildePrime (.squeeze hash (unchecked-divide-int lambda 4))
                              hashEq (MessageDigest/isEqual (.commitmentHash sig) cTildePrime)]
                          (and (not zNorm) hashEq)))))))))))))

  (method ^:public simpleBitPack ^byte/1 [this ^int bitsPerCoeff ^int/2 vector]
    (let [result (new byte/1
                      (unchecked-divide-int
                        (unchecked-multiply-int (unchecked-multiply-int mlDsa_k ML_DSA_N)
                                                bitsPerCoeff)
                        8))
          ^:mutable ^int acc 0
          ^:mutable ^int shift 0
          ^:mutable ^int i 0]
      (for-each [^int/1 poly vector]
        (loop [^int m 0]
          (when (< m ML_DSA_N)
            (set! acc (unchecked-add-int acc (bit-shift-left-int (aget poly m) shift)))
            (set! shift (unchecked-add-int shift bitsPerCoeff))
            (while (>= shift 8)
              (aset result i (unchecked-byte acc))
              (set! i (unchecked-inc-int i))
              (set! acc (bit-shift-right-int acc 8))
              (set! shift (unchecked-subtract-int shift 8)))
            (recur (unchecked-inc-int m)))))
      result))

  (method ^:public bitPack ^void [this ^int/2 vector ^int bitsPerCoeff ^int maxValue ^byte/1 output
                                  ^:mutable ^int offset]
    (let [vecLen (alength vector)
          ^:mutable ^int acc 0
          ^:mutable ^int shift 0]
      (for-each [^int/1 poly vector]
        (loop [^int m 0]
          (when (< m ML_DSA_N)
            (set! acc
                  (unchecked-add-int acc
                                     (bit-shift-left-int
                                       (unchecked-subtract-int maxValue (aget poly m))
                                       shift)))
            (set! shift (unchecked-add-int shift bitsPerCoeff))
            (while (>= shift 8)

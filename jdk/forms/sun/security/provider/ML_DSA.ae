                    j
                    (unchecked-subtract-int maxValue
                                            (unchecked-add-int
                                              (unchecked-add-int
                                                (bit-and-int (aget v vIndex) 0xff)
                                                (bit-shift-left-int
                                                  (bit-and-int
                                                    (aget v (unchecked-add-int vIndex 1))
                                                    0xff)
                                                  8))
                                              (bit-shift-left-int
                                                (bit-and-int
                                                  (aget v (unchecked-add-int vIndex 2))
                                                  0xf)
                                                16))))
              (aset (aget result i)
                    (unchecked-add-int j 1)
                    (unchecked-subtract-int maxValue
                                            (unchecked-add-int
                                              (unchecked-add-int
                                                (bit-and-int
                                                  (bit-shift-right-int
                                                    (aget v (unchecked-add-int vIndex 2))
                                                    4)
                                                  0xf)
                                                (bit-shift-left-int
                                                  (bit-and-int
                                                    (aget v (unchecked-add-int vIndex 3))
                                                    0xff)
                                                  4))
                                              (bit-shift-left-int
                                                (bit-and-int
                                                  (aget v (unchecked-add-int vIndex 4))
                                                  0xff)
                                                12))))
              (set! vIndex (unchecked-add-int vIndex 5))
              (recur (unchecked-add-int j 2))))
          (recur (unchecked-inc-int i))))))

  (method ^:private hintBitPack ^void [this ^boolean/2 h ^byte/1 buffer ^int offset]
    (let [^:mutable ^int idx 0]
      (loop [^int i 0]
        (when (< i mlDsa_k)
          (loop [^int j 0]
            (if (< j ML_DSA_N)
                (if (aget h i j)
                    (do
                      (aset buffer (unchecked-add-int offset idx) (unchecked-byte j))
                      (set! idx (unchecked-inc-int idx))
                      (recur (unchecked-inc-int j)))
                    (recur (unchecked-inc-int j)))
                nil))
          (aset buffer (unchecked-add-int (unchecked-add-int offset omega) i) (unchecked-byte idx))
          (recur (unchecked-inc-int i))))))

  (method ^:private hintBitUnpack ^boolean/2 [this ^byte/1 y ^int offset]
    (let [h (ML_DSA/booleanMatrixAlloc mlDsa_k ML_DSA_N)
          ^:mutable ^int idx 0]
      (loop [^int i 0]
        (when (< i mlDsa_k)
          (let [^int j (aget y (unchecked-add-int (unchecked-add-int offset omega) i))]
            (when (or (< j idx) (> j omega)) (return nil))
            (let [first idx]
              (while (< idx j)
                (when (> idx first)
                  (when (>= (bit-and-int (aget y
                                               (unchecked-subtract-int
                                                 (unchecked-add-int offset idx)
                                                 1))
                                         0xff)
                            (bit-and-int (aget y (unchecked-add-int offset idx)) 0xff))
                    (return nil)))
                (let [hintIndex (bit-and-int (aget y (unchecked-add-int offset idx)) 0xff)]
                  (aset (aget h i) hintIndex true)
                  (set! idx (unchecked-inc-int idx))))
              (recur (unchecked-inc-int i))))))
      (while (< idx omega)
        (when-not (== (aget y (unchecked-add-int offset idx)) 0) (return nil))
        (set! idx (unchecked-inc-int idx)))
      h))

  (method ^:public pkEncode ^byte/1 [this ^ML_DSA_PublicKey key]
    (let [t1Packed (.simpleBitPack this 10 (.-t1 key))
          publicKeyBytes (new byte/1 (unchecked-add-int A_SEED_LEN (alength t1Packed)))]
      (System/arraycopy (.-rho key) 0 publicKeyBytes 0 A_SEED_LEN)
      (System/arraycopy t1Packed 0 publicKeyBytes A_SEED_LEN (alength t1Packed))
      publicKeyBytes))

  (method ^:public pkDecode ^ML_DSA_PublicKey [this ^byte/1 pk]
    (let [rho (Arrays/copyOfRange pk 0 A_SEED_LEN)
          v (Arrays/copyOfRange pk A_SEED_LEN (alength pk))
          t1 (.t1Unpack this v)]
      (ML_DSA_PublicKey. rho t1)))

  (method ^:public skEncode ^byte/1 [this ^ML_DSA_PrivateKey key]
    (let [skBytes (new byte/1
                       (unchecked-add-int
                         (unchecked-add-int
                           (unchecked-add-int
                             (unchecked-add-int (unchecked-add-int A_SEED_LEN K_LEN)
                                                (alength (.-tr key)))
                             s1PackedLength)
                           s2PackedLength)
                         t0PackedLength))
          ^:mutable ^int pos 0]
      (System/arraycopy (.-rho key) 0 skBytes pos A_SEED_LEN)
      (set! pos (unchecked-add-int pos A_SEED_LEN))
      (System/arraycopy (.-k key) 0 skBytes pos K_LEN)
      (set! pos (unchecked-add-int pos K_LEN))
      (System/arraycopy (.-tr key) 0 skBytes pos TR_LEN)
      (set! pos (unchecked-add-int pos TR_LEN))
      (.bitPack this (.-s1 key) s1s2CoeffSize eta skBytes pos)
      (set! pos (unchecked-add-int pos s1PackedLength))
      (.bitPack this (.-s2 key) s1s2CoeffSize eta skBytes pos)
      (set! pos (unchecked-add-int pos s2PackedLength))
      (.bitPack this (.-t0 key) T0_COEFF_SIZE (bit-shift-left-int 1 12) skBytes pos)
      skBytes))

  (method ^:public skDecode ^ML_DSA_PrivateKey [this ^byte/1 sk]
    (let [rho (new byte/1 A_SEED_LEN)]
      (System/arraycopy sk 0 rho 0 A_SEED_LEN)
      (let [k (new byte/1 K_LEN)]
        (System/arraycopy sk A_SEED_LEN k 0 K_LEN)
        (let [tr (new byte/1 TR_LEN)]
          (System/arraycopy sk (unchecked-add-int A_SEED_LEN K_LEN) tr 0 TR_LEN)
          (let [^:mutable start (unchecked-add-int (unchecked-add-int A_SEED_LEN K_LEN) TR_LEN)
                ^:mutable end (unchecked-add-int
                                start
                                (unchecked-multiply-int
                                  (unchecked-multiply-int 32 mlDsa_l)
                                  s1s2CoeffSize))
                s1 (ML_DSA/integerMatrixAlloc mlDsa_l ML_DSA_N)]
            (.bitUnpack this s1 sk start mlDsa_l eta s1s2CoeffSize)
            (set! start end)
            (set! end
                  (unchecked-add-int end
                                     (unchecked-multiply-int
                                       (unchecked-multiply-int 32 s1s2CoeffSize)
                                       mlDsa_k)))
            (let [s2 (ML_DSA/integerMatrixAlloc mlDsa_k ML_DSA_N)]
              (.bitUnpack this s2 sk start mlDsa_k eta s1s2CoeffSize)
              (set! start end)
              (let [t0 (ML_DSA/integerMatrixAlloc mlDsa_k ML_DSA_N)]
                (.bitUnpack this t0 sk start mlDsa_k (bit-shift-left-int 1 12) T0_COEFF_SIZE)
                (ML_DSA_PrivateKey. rho k tr s1 s2 t0))))))))

  (method ^:public sigEncode ^byte/1 [this ^ML_DSA_Signature sig]
    (let [cSize (unchecked-divide-int lambda 4)
          zSize (unchecked-multiply-int (unchecked-multiply-int mlDsa_l 32)
                                        (unchecked-add-int 1 gamma1Bits))
          sigBytes (new byte/1
                        (unchecked-add-int (unchecked-add-int (unchecked-add-int cSize zSize) omega)
                                           mlDsa_k))]
      (System/arraycopy (.-commitmentHash sig) 0 sigBytes 0 cSize)
      (.bitPack this (.-response sig) (unchecked-add-int gamma1Bits 1) gamma1 sigBytes cSize)
      (.hintBitPack this (.-hint sig) sigBytes (unchecked-add-int cSize zSize))
      sigBytes))

  (method ^:public sigDecode :throws [SignatureException] ^ML_DSA_Signature [this ^byte/1 sig]
    (let [cSize (unchecked-divide-int lambda 4)
          zSize (unchecked-multiply-int (unchecked-multiply-int mlDsa_l 32)
                                        (unchecked-add-int 1 gamma1Bits))
          sigLen (unchecked-add-int (unchecked-add-int (unchecked-add-int cSize zSize) omega)
                                    mlDsa_k)]
      (when-not (== (alength sig) sigLen)
        (throw (SignatureException. "Incorrect signature length")))
      (let [cTilde (Arrays/copyOfRange sig 0 (unchecked-divide-int lambda 4))
            ^:mutable start cSize
            end (unchecked-add-int start zSize)
            z (ML_DSA/integerMatrixAlloc mlDsa_l ML_DSA_N)]
        (.bitUnpack this z sig start mlDsa_l gamma1 (unchecked-add-int gamma1Bits 1))
        (set! start end)
        (let [h (.hintBitUnpack this sig start)]
          (when (nil? h) (throw (SignatureException. "Invalid hints encoding")))
          (ML_DSA_Signature. cTilde z h)))))

  (defclass ^:private Shake256Slicer
    (field ^SHA3$SHAKE256 xof)

    (field ^byte/1 block)

    (field ^int byteOffset)

    (field ^int current)

    (field ^int bitsInCurrent)

    (field ^int bitsPerCall)

    (field ^int bitMask)

    (constructor [this ^SHA3$SHAKE256 xof ^int bitsPerCall]
      (set! (.-xof this) xof)
      (set! (.-bitsPerCall this) bitsPerCall)
      (set! bitMask (unchecked-subtract-int (bit-shift-left-int 1 bitsPerCall) 1))
      (set! current 0)
      (set! byteOffset SHAKE256_BLOCK_SIZE)
      (set! bitsInCurrent 0)
      (set! block (new byte/1 SHAKE256_BLOCK_SIZE)))

    (method reset ^void [this]
      (.reset xof)
      (set! current 0)
      (set! byteOffset SHAKE256_BLOCK_SIZE)
      (set! bitsInCurrent 0))

    (method squeezeBits ^int [this]
      (while (< bitsInCurrent bitsPerCall)
        (when (== byteOffset SHAKE256_BLOCK_SIZE)
          (.squeeze xof block 0 SHAKE256_BLOCK_SIZE)
          (set! byteOffset 0))
        (set! current
              (unchecked-add-int current
                                 (bit-shift-left-int
                                   (bit-and-int (aget
                                                  block
                                                  (let [old-1 byteOffset]
                                                    (set! byteOffset (unchecked-inc-int byteOffset))
                                                    old-1))
                                                0xff)
                                   bitsInCurrent)))
        (set! bitsInCurrent (unchecked-add-int bitsInCurrent 8)))
      (let [result (bit-and-int current bitMask)]
        (set! current (bit-shift-right-int current bitsPerCall))
        (set! bitsInCurrent (unchecked-subtract-int bitsInCurrent bitsPerCall))
        result)))

  (method ^:private sampleInBall ^void [this ^int/1 c ^byte/1 rho]
    (let [xof (SHA3$SHAKE256. 0)
          slicer (Shake256Slicer. xof 8)]
      (.update xof rho)
      (let [^:mutable parity 0]
        (loop [^int i 0]
          (when (< i 8)
            (let [^long sample (.squeezeBits slicer)]
              (set! parity (bit-or parity (bit-shift-left sample (unchecked-multiply-int 8 i))))
              (recur (unchecked-inc-int i)))))
        (Arrays/fill c 0)
        (let [^int k 8]
          (loop [^int i (unchecked-subtract-int 256 tau)]
            (when (< i 256)
              (let [^:mutable j (.squeezeBits slicer)]
                (while (> j i) (set! j (.squeezeBits slicer)))
                (aset c i (aget c j))
                (aset c
                      j
                      (unchecked-int
                        (unchecked-subtract 1 (unchecked-multiply 2 (bit-and parity 1)))))
                (set! parity (bit-shift-right parity 1))
                (recur (unchecked-inc-int i)))))))))

  (method ^:private generateA ^int/3 [this ^byte/1 seed]
    (let [a (new int/3 mlDsa_k)]
      (loop [^int i 0]
        (when (< i mlDsa_k) (aset a i (new int/2 mlDsa_l)) (recur (unchecked-inc-int i))))
      (let [^int nrPar 2
            rhoLen (alength seed)
            seedBuf (new byte/1 SHAKE128_BLOCK_SIZE)]
        (System/arraycopy seed 0 seedBuf 0 (alength seed))
        (aset seedBuf (unchecked-add-int rhoLen 2) 0x1F)
        (aset seedBuf (unchecked-subtract-int SHAKE128_BLOCK_SIZE 1) (unchecked-byte 0x80))
        (let [xofBufArr (new byte/2 nrPar SHAKE128_BLOCK_SIZE)
              iIndex (new int/1 nrPar)
              jIndex (new int/1 nrPar)
              parsedBuf (new int/1 (unchecked-divide-int SHAKE128_BLOCK_SIZE 3))
              ^:mutable ^int parInd 0
              ^:mutable ^boolean allDone false
              ofs (new int/1 nrPar)]
          (Arrays/fill ofs 0)
          (let [aij (new int/2 nrPar)]
            (try
              (let [parXof (SHA3Parallel$Shake128Parallel. xofBufArr)]
                (loop [^int i 0]
                  (when (< i mlDsa_k)
                    (loop [^int j 0]
                      (when (< j mlDsa_l)
                        (aset xofBufArr parInd (.clone seedBuf))
                        (aset (aget xofBufArr parInd) rhoLen (unchecked-byte j))
                        (aset (aget xofBufArr parInd)
                              (unchecked-add-int rhoLen 1)
                              (unchecked-byte i))
                        (aset iIndex parInd i)
                        (aset jIndex parInd j)
                        (aset ofs parInd 0)
                        (aset aij parInd (new int/1 ML_DSA_N))
                        (set! parInd (unchecked-inc-int parInd))
                        (if (or (== parInd nrPar)
                                (and (== i (unchecked-subtract-int mlDsa_k 1))
                                     (== j (unchecked-subtract-int mlDsa_l 1))))
                            (do
                              (.reset parXof xofBufArr)
                              (set! allDone false)
                              (while (not allDone)
                                (set! allDone true)
                                (.squeezeBlock parXof)
                                (loop [^int k 0]
                                  (when (< k parInd)
                                    (let [^:mutable ^int parsedOfs 0
                                          ^:mutable ^int tmp 0]
                                      (when (< (aget ofs k) ML_DSA_N)
                                        (loop [^int l 0]
                                          (when (< l SHAKE128_BLOCK_SIZE)
                                            (let [rawBuf (aget xofBufArr k)]
                                              (aset
                                                parsedBuf
                                                (unchecked-divide-int l 3)
                                                (unchecked-add-int
                                                  (unchecked-add-int
                                                    (bit-and-int (aget rawBuf l) 0xFF)
                                                    (bit-shift-left-int
                                                      (bit-and-int
                                                        (aget rawBuf (unchecked-add-int l 1))
                                                        0xFF)
                                                      8))
                                                  (bit-shift-left-int
                                                    (bit-and-int
                                                      (aget rawBuf (unchecked-add-int l 2))
                                                      0x7F)
                                                    16)))
                                              (recur (unchecked-add-int l 3))))))
                                      (while (and
                                               (< (aget ofs k) ML_DSA_N)
                                               (<
                                                 parsedOfs
                                                 (unchecked-divide-int SHAKE128_BLOCK_SIZE 3)))
                                        (set! tmp (aget parsedBuf parsedOfs))
                                        (set! parsedOfs (unchecked-inc-int parsedOfs))
                                        (when (< tmp ML_DSA_Q)
                                          (aset (aget aij k) (aget ofs k) tmp)
                                          (aset ofs k (unchecked-inc-int (aget ofs k)))))
                                      (if (< (aget ofs k) ML_DSA_N)
                                          (do (set! allDone false) (recur (unchecked-inc-int k)))
                                          (recur (unchecked-inc-int k)))))))
                              (loop [^int k 0]
                                (when (< k parInd)
                                  (aset (aget a (aget iIndex k)) (aget jIndex k) (aget aij k))
                                  (recur (unchecked-inc-int k))))
                              (set! parInd 0)
                              (recur (unchecked-inc-int j)))
                            (recur (unchecked-inc-int j)))))
                    (recur (unchecked-inc-int i)))))
              (catch InvalidAlgorithmParameterException e
                (throw (RuntimeException. "Internal error."))))
            a)))))

  (method ^:private sampleS1S2 ^void [this ^int/2 s1 ^int/2 s2 ^SHA3$SHAKE256 xof ^byte/1 rhoPrime]
    (let [seed (new byte/1 (unchecked-add-int S1S2_SEED_LEN 2))]
      (System/arraycopy rhoPrime 0 seed 0 S1S2_SEED_LEN)
      (let [slicer (Shake256Slicer. xof 4)]
        (loop [^int i 0]
          (when (< i mlDsa_l)
            (aset seed S1S2_SEED_LEN (unchecked-byte i))
            (aset seed (unchecked-add-int S1S2_SEED_LEN 1) 0)
            (.reset slicer)
            (.update xof seed)
            (if (== eta 2)
                (do
                  (loop [^int j 0]
                    (when (< j ML_DSA_N)
                      (let [^:mutable ^int sample 0]
                        (loop [] (set! sample (.squeezeBits slicer)) (when (> sample 14) (recur)))
                        (aset (aget s1 i)
                              j
                              (unchecked-add-int
                                (unchecked-subtract-int eta sample)
                                (unchecked-multiply-int
                                  (bit-shift-right-int (unchecked-multiply-int 205 sample) 10)
                                  5)))
                        (recur (unchecked-inc-int j)))))
                  (recur (unchecked-inc-int i)))
                (do
                  (loop [^int j 0]
                    (when (< j ML_DSA_N)
                      (let [^:mutable ^int sample 0]
                        (loop []
                          (set! sample (.squeezeBits slicer))
                          (when (> sample (unchecked-multiply-int 2 eta)) (recur)))
                        (aset (aget s1 i) j (unchecked-subtract-int eta sample))
                        (recur (unchecked-inc-int j)))))
                  (recur (unchecked-inc-int i))))))
        (loop [^int i 0]
          (when (< i mlDsa_k)
            (aset seed S1S2_SEED_LEN (unchecked-byte (unchecked-add-int mlDsa_l i)))
            (aset seed (unchecked-add-int S1S2_SEED_LEN 1) 0)
            (.reset slicer)
            (.update xof seed)
            (if (== eta 2)
                (do
                  (loop [^int j 0]
                    (when (< j ML_DSA_N)
                      (let [^:mutable ^int sample 0]
                        (loop [] (set! sample (.squeezeBits slicer)) (when (> sample 14) (recur)))
                        (aset (aget s2 i)
                              j
                              (unchecked-add-int
                                (unchecked-subtract-int eta sample)
                                (unchecked-multiply-int
                                  (bit-shift-right-int (unchecked-multiply-int 205 sample) 10)
                                  5)))
                        (recur (unchecked-inc-int j)))))
                  (recur (unchecked-inc-int i)))
                (do
                  (loop [^int j 0]
                    (when (< j ML_DSA_N)
                      (let [^:mutable ^int sample 0]
                        (loop []
                          (set! sample (.squeezeBits slicer))
                          (when (> sample (unchecked-multiply-int 2 eta)) (recur)))
                        (aset (aget s2 i) j (unchecked-subtract-int eta sample))
                        (recur (unchecked-inc-int j)))))
                  (recur (unchecked-inc-int i)))))))))

  (method ^:private expandMask ^void [this ^int/2 result ^byte/1 rho ^int mu]
    (let [xof (SHA3$SHAKE256. 0)
          c (unchecked-add-int 1 gamma1Bits)
          v (new byte/1 (unchecked-multiply-int (unchecked-multiply-int mlDsa_l 32) c))]
      (loop [^int r 0]
        (when (< r mlDsa_l)
          (let [a (unchecked-add-int mu r)
                n (new byte/1 [(unchecked-byte a) (unchecked-byte (bit-shift-right-int a 8))])]
            (.update xof rho)
            (.update xof n)
            (.squeeze xof
                      v
                      (unchecked-multiply-int (unchecked-multiply-int r 32) c)
                      (unchecked-multiply-int 32 c))
            (.reset xof)
            (recur (unchecked-inc-int r)))))
      (.bitUnpack this result v 0 mlDsa_l gamma1 c)))

  (method ^:private power2Round ^void [this ^int/2 input ^int/2 lowPart ^int/2 highPart]
    (loop [^int i 0]
      (when (< i mlDsa_k)
        (loop [^int m 0]
          (when (< m ML_DSA_N)
            (let [rplus (aget input i m)
                  ^:mutable r0 (bit-and-int (aget input i m) D_MASK)
                  r00 (unchecked-subtract-int
                        (bit-shift-left-int 1 (unchecked-subtract-int ML_DSA_D 1))
                        r0)]
              (set! r0
                    (unchecked-subtract-int r0
                                            (bit-and-int
                                              (bit-shift-right-int r00 31)
                                              (bit-shift-left-int 1 ML_DSA_D))))
              (aset (aget lowPart i) m r0)
              (aset (aget highPart i)
                    m
                    (bit-shift-right-int (unchecked-subtract-int rplus r0) ML_DSA_D))
              (recur (unchecked-inc-int m)))))
        (recur (unchecked-inc-int i)))))

  (method ^:private decompose ^void [this ^int/2 input ^int/2 lowPart ^int/2 highPart]
    (let [^int multiplier (if (== gamma2 95232) 22 8)]
      (loop [^int i 0]
        (when (< i mlDsa_k)
          (ML_DSA/mlDsaDecomposePoly (aget input i)
                                     (aget lowPart i)
                                     (aget highPart i)
                                     (unchecked-multiply-int gamma2 2)
                                     multiplier)
          (recur (unchecked-inc-int i))))))

  (method ^:private highBits ^int/2 [this ^int/2 input]
    (let [lowPart (ML_DSA/integerMatrixAlloc mlDsa_k ML_DSA_N)
          highPart (ML_DSA/integerMatrixAlloc mlDsa_k ML_DSA_N)]
      (.decompose this input lowPart highPart)
      highPart))

  (method ^:private makeHint ^int [this ^boolean/2 res ^int/2 z ^int/2 r]
    (let [^:mutable ^int hammingWeight 0
          r1 (.highBits this r)
          v1 (.highBits this z)]
      (loop [^int i 0]
        (when (< i mlDsa_k)
          (loop [^int j 0]
            (if (< j ML_DSA_N)
                (if (not (== (aget r1 i j) (aget v1 i j)))
                    (do
                      (aset (aget res i) j true)
                      (set! hammingWeight (unchecked-inc-int hammingWeight))
                      (recur (unchecked-inc-int j)))
                    (do (aset (aget res i) j false) (recur (unchecked-inc-int j))))
                nil))
          (recur (unchecked-inc-int i))))
      hammingWeight))

  (method ^:private useHint ^int/2 [this ^boolean/2 h ^int/2 r]
    (let [m (unchecked-divide-int (unchecked-subtract-int ML_DSA_Q 1)
                                  (unchecked-multiply-int 2 gamma2))
          lowPart r
          highPart (ML_DSA/integerMatrixAlloc mlDsa_k ML_DSA_N)]
      (.decompose this r lowPart highPart)
      (loop [^int i 0]
        (when (< i mlDsa_k)
          (loop [^int j 0]
            (when (< j ML_DSA_N)
              (when (aget h i j)
                (let [arr-2 (aget highPart i)]
                  (aset arr-2
                        j
                        (unchecked-add-int (aget arr-2 j) (if (> (aget lowPart i j) 0) 1 -1)))))
              (aset (aget highPart i)
                    j
                    (unchecked-remainder-int
                      (unchecked-add-int (unchecked-remainder-int (aget highPart i j) m) m)
                      m))
              (recur (unchecked-inc-int j))))
          (recur (unchecked-inc-int i))))
      highPart))

  (method ^:public ^:static mlDsaNtt ^void [^int/1 coeffs]
    (java-assert (== (alength coeffs) ML_DSA_N))
    (ML_DSA/implDilithiumAlmostNtt coeffs MONT_ZETAS_FOR_VECTOR_NTT)
    (ML_DSA/implDilithiumMontMulByConstant coeffs MONT_R_MOD_Q))

  (method ^:static ^{IntrinsicCandidate true} implDilithiumAlmostNtt ^int [^int/1 coeffs
                                                                           ^int/1 zetas]
    (ML_DSA/implDilithiumAlmostNttJava coeffs)
    1)

  (method ^:static implDilithiumAlmostNttJava ^void [^int/1 coeffs]
    (let [dimension ML_DSA_N
          ^:mutable ^int m 0]
      (loop [^int l (unchecked-divide-int dimension 2)]
        (when (> l 0)
          (loop [^int s 0]
            (when (< s dimension)
              (loop [^int j s]
                (when (< j (unchecked-add-int s l))
                  (let [tmp (ML_DSA/montMul (aget MONT_ZETAS_FOR_NTT m)
                                            (aget coeffs (unchecked-add-int j l)))]
                    (aset coeffs
                          (unchecked-add-int j l)
                          (unchecked-subtract-int (aget coeffs j) tmp))
                    (aset coeffs j (unchecked-add-int (aget coeffs j) tmp))
                    (recur (unchecked-inc-int j)))))
              (set! m (unchecked-inc-int m))
              (recur (unchecked-add-int s (unchecked-multiply-int 2 l)))))
          (recur (unchecked-divide-int l 2))))))


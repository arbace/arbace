              (let [ge (GSSException. GSSException/FAILURE
                                      -1
                                      (java-str "Could not use DES cipher - " (.getMessage e)))]
                (.initCause ge e)
                (throw ge))))
          (let [^int padSize (aget finalBlock (unchecked-subtract-int blockSize 1))]
            (when (or (< padSize 1) (> padSize 8))
              (throw
                (GSSException. GSSException/DEFECTIVE_TOKEN -1 "Invalid padding on Wrap Token")))
            (set! (.-padding token) (aget WrapToken/pads padSize))
            (set! blockSize (unchecked-subtract-int blockSize padSize))
            (System/arraycopy finalBlock 0 dataOutBuf dataOffset blockSize))))))

  (method ^:private ^:static getDesEncryptionKey :throws [GSSException] ^byte/1 [^byte/1 key]
    (when (> (alength key) 8) (throw (GSSException. GSSException/FAILURE -100 "Invalid DES Key!")))
    (let [retVal (new byte/1 (alength key))]
      (loop [^int i 0]
        (when (< i (alength key))
          (aset retVal i (unchecked-byte (bit-xor-int (aget key i) 0xf0)))
          (recur (unchecked-inc-int i))))
      retVal))


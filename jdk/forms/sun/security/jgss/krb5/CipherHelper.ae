  (defclass ^:static WrapTokenInputStream
    :extends InputStream

    (field ^:private ^:final ^InputStream is)

    (field ^:private ^:final ^int length)

    (field ^:private ^int remaining)

    (field ^:private ^int temp)

    (constructor ^:public [this ^InputStream is ^int length]
      (set! (.-is this) is)
      (set! (.-length this) length)
      (set! remaining length))

    (method ^:public ^:final read :throws [IOException] ^int [this]
      (if (== remaining 0)
          -1
          (do
            (set! temp (.read is))
            (when-not (== temp -1) (set! remaining (unchecked-subtract-int remaining temp)))
            temp)))

    (method ^:public ^:final read :throws [IOException] ^int [this ^byte/1 b]
      (if (== remaining 0)
          -1
          (do
            (set! temp (Math/min remaining (alength b)))
            (set! temp (.read is b 0 temp))
            (when-not (== temp -1) (set! remaining (unchecked-subtract-int remaining temp)))
            temp)))

    (method ^:public ^:final read :throws [IOException] ^int [this ^byte/1 b ^int off ^int len]
      (if (== remaining 0)
          -1
          (do
            (set! temp (Math/min remaining len))
            (set! temp (.read is b off temp))
            (when-not (== temp -1) (set! remaining (unchecked-subtract-int remaining temp)))
            temp)))

    (method ^:public ^:final skip :throws [IOException] ^long [this ^long n]
      (if (== remaining 0)
          0
          (do
            (set! temp (unchecked-int (Math/min remaining n)))
            (set! temp (unchecked-int (.skip is temp)))
            (set! remaining (unchecked-subtract-int remaining temp))
            temp)))

    (method ^:public ^:final available :throws [IOException] ^int [this]
      (Math/min remaining (.available is)))

    (method ^:public ^:final close :throws [IOException] ^void [this]
      (set! remaining 0))))

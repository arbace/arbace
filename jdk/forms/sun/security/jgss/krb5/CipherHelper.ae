  (method ^:private desCbcDecrypt :throws [GSSException] ^void [this ^WrapToken token ^byte/1 key
                                                                ^byte/1 cipherText
                                                                ^:mutable ^int offset
                                                                ^:mutable ^int len
                                                                ^byte/1 dataOutBuf
                                                                ^:mutable ^int dataOffset]
    (try
      (let [^:mutable ^int temp 0
            des (.getInitializedDes this false key ZERO_IV)]
        (set! temp (.update des cipherText offset WrapToken/CONFOUNDER_SIZE (.-confounder token)))
        (set! offset (unchecked-add-int offset WrapToken/CONFOUNDER_SIZE))
        (set! len (unchecked-subtract-int len WrapToken/CONFOUNDER_SIZE))
        (let [^:mutable blockSize (.getBlockSize des)
              numBlocks (unchecked-subtract-int (unchecked-divide-int len blockSize) 1)]
          (loop [^int i 0]
            (when (< i numBlocks)
              (set! temp (.update des cipherText offset blockSize dataOutBuf dataOffset))
              (set! offset (unchecked-add-int offset blockSize))
              (set! dataOffset (unchecked-add-int dataOffset blockSize))
              (recur (unchecked-inc-int i))))
          (let [finalBlock (new byte/1 blockSize)]

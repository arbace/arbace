              (when (or (< padSize 1) (> padSize 8))
                (throw (GSSException. GSSException/DEFECTIVE_TOKEN
                                      -1
                                      "Invalid padding on Wrap Token")))
              (set! (.-padding token) (aget WrapToken/pads padSize))
              (set! blockSize (unchecked-subtract-int blockSize padSize))
              (System/arraycopy finalBlock 0 dataOutBuf dataOffset blockSize)))))
      (catch GeneralSecurityException e
        (let [ge (GSSException. GSSException/FAILURE
                                -1
                                (java-str "Could not use DES cipher - " (.getMessage e)))]
          (.initCause ge e)
          (throw ge)))))

  (method ^:private desCbcDecrypt :throws [GSSException IOException] ^void [this ^WrapToken token
                                                                            ^byte/1 key
                                                                            ^InputStream is
                                                                            ^:mutable ^int len
                                                                            ^byte/1 dataOutBuf
                                                                            ^:mutable ^int dataOffset]
    (let [^:mutable ^int temp 0
          des (.getInitializedDes this false key ZERO_IV)
          truncatedInputStream (WrapTokenInputStream. is len)
          cis (CipherInputStream. truncatedInputStream des)]
      (set! temp (.read cis (.-confounder token)))
      (set! len (unchecked-subtract-int len temp))
      (let [^:mutable blockSize (.getBlockSize des)
            numBlocks (unchecked-subtract-int (unchecked-divide-int len blockSize) 1)]
        (loop [^int i 0]
          (when (< i numBlocks)
            (set! temp (.read cis dataOutBuf dataOffset blockSize))
            (set! dataOffset (unchecked-add-int dataOffset blockSize))
            (recur (unchecked-inc-int i))))
        (let [finalBlock (new byte/1 blockSize)]
          (set! temp (.read cis finalBlock))
          (try
            (.doFinal des)

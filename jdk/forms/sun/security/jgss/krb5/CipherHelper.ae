        (set! ptext
              (ArcFourHmac/decryptRaw keybytes KG_USAGE_SEAL ZERO_IV ciphertext cStart cLen seqNum))
        (catch GeneralSecurityException e
          (let [ge (GSSException. GSSException/FAILURE
                                  -1
                                  (java-str "Could not use ArcFour Cipher - " (.getMessage e)))]
            (.initCause ge e)
            (throw ge))))
      (let [^int padSize (aget ptext (unchecked-subtract-int (alength ptext) 1))]
        (when (< padSize 1)
          (throw (GSSException. GSSException/DEFECTIVE_TOKEN -1 "Invalid padding on Wrap Token")))
        (set! (.-padding token) (aget WrapToken/pads padSize))
        (let [len (unchecked-subtract-int
                    (unchecked-subtract-int (alength ptext) WrapToken/CONFOUNDER_SIZE)
                    padSize)]
          (System/arraycopy ptext WrapToken/CONFOUNDER_SIZE plaintext pStart len)
          (System/arraycopy ptext 0 (.-confounder token) 0 WrapToken/CONFOUNDER_SIZE)))))

  (method ^:private arcFourEncrypt :throws [GSSException] ^byte/1 [this ^WrapToken token
                                                                   ^byte/1 confounder
                                                                   ^byte/1 plaintext ^int start
                                                                   ^int len ^byte/1 padding]
    (let [all (new byte/1
                   (unchecked-add-int (unchecked-add-int (alength confounder) len)
                                      (alength padding)))]

  (method ^:private ^:static getHexBytes ^String [^byte/1 bytes ^int pos ^int len]
    (let [sb (StringBuilder.)]
      (loop [^int i 0]
        (when (< i len)
          (let [b1 (bit-and-int (bit-shift-right-int (aget bytes i) 4) 0x0f)
                b2 (bit-and-int (aget bytes i) 0x0f)]
            (.append sb (Integer/toHexString b1))
            (.append sb (Integer/toHexString b2))
            (.append sb \space)
            (recur (unchecked-inc-int i)))))
      (.toString sb)))


  (method ^:public inquireSecContext :throws [GSSException] [this ^String type]
    (when-not (.isEstablished this)
      (throw (GSSException. GSSException/NO_CONTEXT -1 "Security context not established.")))
    (switch type
      "KRB5_GET_SESSION_KEY" (return (KerberosSessionKey. key))
      "KRB5_GET_SESSION_KEY_EX"
        (return (javax.security.auth.kerberos.EncryptionKey. (.getBytes key) (.getEType key)))
      "KRB5_GET_TKT_FLAGS" (return (.clone tktFlags))
      "KRB5_GET_AUTHZ_DATA"
        (if (.isInitiator this)
            (throw (GSSException. GSSException/UNAVAILABLE
                                  -1
                                  "AuthzData not available on initiator side."))
            (return authzData))
      "KRB5_GET_AUTHTIME" (return authTime)
      "KRB5_GET_KRB_CRED"
        (do
          (when-not (.isInitiator this)
            (throw (GSSException. GSSException/UNAVAILABLE
                                  -1
                                  "KRB_CRED not available on acceptor side.")))
          (let [sender (KerberosPrincipal. (.getName (.getKrb5PrincipalName myName)))
                recipient (KerberosPrincipal. (.getName (.getKrb5PrincipalName peerName)))]
            (try
              (let [krbCred (.getMessage (KrbCred. tgt serviceCreds key))]
                (return (KerberosCredMessage. sender recipient krbCred)))
              (catch [KrbException IOException] e
                (let [gsse (GSSException. GSSException/UNAVAILABLE
                                          -1
                                          "KRB_CRED not generated correctly.")]
                  (.initCause gsse e)
                  (throw gsse)))))))
    (throw (GSSException. GSSException/UNAVAILABLE -1 "Inquire type not supported.")))


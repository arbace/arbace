;; Converted from jdk26u src/java.security.jgss/share/classes/sun/security/jgss/krb5/Krb5Util.java by arbace.repr.java. Regenerate rather than edit.

(in-ns 'sun.security.jgss.krb5)

(import '(java.io IOException)
        '(javax.security.auth Subject)
        '(javax.security.auth.kerberos KerberosPrincipal KerberosTicket KeyTab)
        '(javax.security.auth.login LoginException)
        '(sun.security.jgss GSSCaller GSSUtil)
        '(sun.security.krb5 Credentials EncryptionKey KerberosSecrets KrbException PrincipalName))

(defclass ^:public Krb5Util
  (constructor ^:private [this])

  (method ^:static getServiceTicket ^KerberosTicket [^GSSCaller caller ^String clientPrincipal
                                                     ^String serverPrincipal]
    (let [currSubj (Subject/current)
          ticket (cast KerberosTicket
                       (SubjectComber/find currSubj serverPrincipal clientPrincipal KerberosTicket))]
      ticket))

  (method ^:static getInitialTicket :throws [LoginException] ^KerberosTicket [^GSSCaller caller
                                                                              ^String clientPrincipal]
    (let [currSubj (Subject/current)
          ^:mutable ticket (cast KerberosTicket
                                 (SubjectComber/find currSubj nil clientPrincipal KerberosTicket))]
      (when (and (nil? ticket) (not (GSSUtil/useSubjectCredsOnly caller)))
        (let [subject (GSSUtil/login caller GSSUtil/GSS_KRB5_MECH_OID)]
          (set! ticket
                (cast KerberosTicket
                      (SubjectComber/find subject nil clientPrincipal KerberosTicket)))))
      ticket))

  (method ^:public ^:static getServiceCreds :throws [LoginException] ^ServiceCreds [^GSSCaller caller
                                                                                    ^String serverPrincipal]
    (let [currSubj (Subject/current)
          ^:mutable ^ServiceCreds sc nil]
      (when (some? currSubj) (set! sc (ServiceCreds/getInstance currSubj serverPrincipal)))
      (when (and (nil? sc) (not (GSSUtil/useSubjectCredsOnly caller)))
        (let [subject (GSSUtil/login caller GSSUtil/GSS_KRB5_MECH_OID)]
          (set! sc (ServiceCreds/getInstance subject serverPrincipal))))
      sc))

  (method ^:public ^:static credsToTicket ^KerberosTicket [^Credentials serviceCreds]
    (let [sessionKey (.getSessionKey serviceCreds)
          kt (KerberosTicket. (.getEncoded serviceCreds)
                              (KerberosPrincipal. (.getName (.getClient serviceCreds)))
                              (KerberosPrincipal.
                                (.getName (.getServer serviceCreds))
                                KerberosPrincipal/KRB_NT_SRV_INST)
                              (.getBytes sessionKey)
                              (.getEType sessionKey)
                              (.getFlags serviceCreds)
                              (.getAuthTime serviceCreds)
                              (.getStartTime serviceCreds)
                              (.getEndTime serviceCreds)
                              (.getRenewTill serviceCreds)
                              (.getClientAddresses serviceCreds))
          clientAlias (.getClientAlias serviceCreds)
          serverAlias (.getServerAlias serviceCreds)]
      (when (some? clientAlias)
        (.kerberosTicketSetClientAlias (KerberosSecrets/getJavaxSecurityAuthKerberosAccess)
                                       kt
                                       (KerberosPrincipal.
                                         (.getName clientAlias)
                                         (.getNameType clientAlias))))
      (when (some? serverAlias)
        (.kerberosTicketSetServerAlias (KerberosSecrets/getJavaxSecurityAuthKerberosAccess)
                                       kt
                                       (KerberosPrincipal.
                                         (.getName serverAlias)
                                         (.getNameType serverAlias))))
      kt))

  (method ^:public ^:static ticketToCreds :throws [KrbException IOException] ^Credentials [^KerberosTicket kerbTicket]
    (let [clientAlias (.kerberosTicketGetClientAlias
                        (KerberosSecrets/getJavaxSecurityAuthKerberosAccess)
                        kerbTicket)
          serverAlias (.kerberosTicketGetServerAlias
                        (KerberosSecrets/getJavaxSecurityAuthKerberosAccess)
                        kerbTicket)]
      (Credentials. (.getEncoded kerbTicket)
                    (.getName (.getClient kerbTicket))
                    ^String (when (some? clientAlias) (.getName clientAlias))
                    (.getName (.getServer kerbTicket))
                    ^String (when (some? serverAlias) (.getName serverAlias))
                    (.getEncoded (.getSessionKey kerbTicket))
                    (.getSessionKeyType kerbTicket)
                    (.getFlags kerbTicket)
                    (.getAuthTime kerbTicket)
                    (.getStartTime kerbTicket)
                    (.getEndTime kerbTicket)
                    (.getRenewTill kerbTicket)
                    (.getClientAddresses kerbTicket))))

  (method ^:public ^:static snapshotFromJavaxKeyTab ^sun.security.krb5.internal.ktab.KeyTab [^KeyTab ktab]
    (.keyTabTakeSnapshot (KerberosSecrets/getJavaxSecurityAuthKerberosAccess) ktab))

  (method ^:public ^:static keysFromJavaxKeyTab ^EncryptionKey/1 [^KeyTab ktab ^PrincipalName cname]
    (.readServiceKeys (Krb5Util/snapshotFromJavaxKeyTab ktab) cname))

  (method ^:public ^:static keyInfo ^String [^byte/1 data]
    (cond
      (nil? data) "null key"
      (== (alength data) 0) "empty key"
      :else
        (do
          (for-each [^byte b data]
            (when-not (== b 0) (return (java-str (alength data) "-byte key"))))
          (java-str (alength data) "-byte zero key")))))

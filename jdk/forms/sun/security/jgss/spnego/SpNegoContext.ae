  (method ^:public ^:final getDelegCred :throws [GSSException] ^GSSCredentialSpi [this]
    (when (and (not (== state STATE_IN_PROCESS)) (not (== state STATE_DONE)))
      (throw (GSSException. GSSException/NO_CONTEXT)))
    (if (some? mechContext)
        (let [delegCred (cast GSSCredentialImpl (.getDelegCred mechContext))]
          (when (some? delegCred)
            (let [initiate (== (.getUsage delegCred) GSSCredential/INITIATE_ONLY)
                  mechCred (.getElement delegCred internal_mech initiate)
                  cred (SpNegoCredElement. mechCred)]
              (.getInternalCred cred))))
        (throw (GSSException. GSSException/NO_CONTEXT -1 "getDelegCred called in invalid state!"))))

  (method ^:public ^:final getWrapSizeLimit :throws [GSSException] ^int [this ^int qop
                                                                         ^boolean confReq
                                                                         ^int maxTokSize]
    (if (some? mechContext)
        (.getWrapSizeLimit mechContext qop confReq maxTokSize)
        (throw (GSSException. GSSException/NO_CONTEXT
                              -1
                              "getWrapSizeLimit called in invalid state!"))))

  (method ^:public ^:final wrap :throws [GSSException] ^byte/1 [this ^byte/1 inBuf ^int offset
                                                                ^int len ^MessageProp msgProp]
    (if (some? mechContext)
        (.wrap mechContext inBuf offset len msgProp)
        (throw (GSSException. GSSException/NO_CONTEXT -1 "Wrap called in invalid state!"))))

  (method ^:public ^:final ^{Deprecated {:since "11"}} wrap :throws [GSSException] ^void [this
                                                                                          ^InputStream is
                                                                                          ^OutputStream os
                                                                                          ^MessageProp msgProp]
    (if (some? mechContext)
        (.wrap mechContext is os msgProp)
        (throw (GSSException. GSSException/NO_CONTEXT -1 "Wrap called in invalid state!"))))


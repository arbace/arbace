  (method ^:public ^:final verifyMIC :throws [GSSException] ^void [this ^byte/1 inTok ^int tokOffset
                                                                   ^int tokLen ^byte/1 inMsg
                                                                   ^int msgOffset ^int msgLen
                                                                   ^MessageProp msgProp]
    (if (some? mechContext)
        (.verifyMIC mechContext inTok tokOffset tokLen inMsg msgOffset msgLen msgProp)
        (throw (GSSException. GSSException/NO_CONTEXT -1 "verifyMIC called in invalid state!"))))

  (method ^:public ^:final ^{Deprecated {:since "11"}} verifyMIC :throws [GSSException] ^void [this
                                                                                               ^InputStream is
                                                                                               ^InputStream msgStr
                                                                                               ^MessageProp msgProp]
    (if (some? mechContext)
        (.verifyMIC mechContext is msgStr msgProp)
        (throw (GSSException. GSSException/NO_CONTEXT -1 "verifyMIC called in invalid state!"))))

  (method ^:private ^:static printState ^String [^int state]
    (switch state
      STATE_NEW "STATE_NEW"
      STATE_IN_PROCESS "STATE_IN_PROCESS"
      STATE_DONE "STATE_DONE"
      STATE_DELETED "STATE_DELETED"
      (java-str "Unknown state " state)))

  (method ^:public inquireSecContext :throws [GSSException] [this ^String type]
    (when (nil? mechContext)
      (throw (GSSException. GSSException/NO_CONTEXT -1 "Underlying mech not established.")))
    (if (instance? GSSContextImpl mechContext)
        (.inquireSecContext (cast GSSContextImpl mechContext) type)
        (throw (GSSException. GSSException/BAD_MECH
                              -1
                              "inquireSecContext not supported by underlying mech.")))))

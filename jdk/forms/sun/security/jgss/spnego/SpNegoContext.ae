                      (.println
                        DEBUG
                        (java-str "SpNegoContext: negotiated mechanism = " (aget mechSet j))))
                    (return (aget mechSet j)))
                  (recur (unchecked-inc-int j)))
              nil))
        (recur (unchecked-inc-int i))))

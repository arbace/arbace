                                                                  ^int len ^MessageProp msgProp]
    (if (some? mechContext)
        (.unwrap mechContext inBuf offset len msgProp)
        (throw (GSSException. GSSException/NO_CONTEXT -1 "UnWrap called in invalid state!"))))

  (method ^:public ^:final ^{Deprecated {:since "11"}} unwrap :throws [GSSException] ^void [this
                                                                                            ^InputStream is
                                                                                            ^OutputStream os
                                                                                            ^MessageProp msgProp]
    (if (some? mechContext)
        (.unwrap mechContext is os msgProp)

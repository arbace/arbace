      (when-not (.getMutualAuthState mechContext) (set! mutualAuthState false))
      (when-not (.getReplayDetState mechContext) (set! replayDetState false))
      (when-not (.getSequenceDetState mechContext) (set! sequenceDetState false))
      (when-not (.getIntegState mechContext) (set! integState false))
      (when-not (.getConfState mechContext) (set! confState false))))

  (method ^:private verifyMechListMIC :throws [GSSException] ^boolean [this ^byte/1 mechTypes
                                                                       ^byte/1 token]

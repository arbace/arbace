(in-ns 'sun.security.jgss.spnego)

(import '(java.io IOException)
        '(org.ietf.jgss GSSException)
        '(sun.security.jgss GSSToken)
        '(sun.security.util DerOutputStream DerValue ObjectIdentifier))

(defclass ^:abstract SpNegoToken
  :extends GSSToken

  (field ^:static ^:final ^int NEG_TOKEN_INIT_ID 0x00)

  (field ^:static ^:final ^int NEG_TOKEN_TARG_ID 0x01)

  (defclass ^:enum NegoResult
    (constants ACCEPT_COMPLETE ACCEPT_INCOMPLETE REJECT))

  (field ^:private ^:final ^int tokenType)

  (field ^:public ^:static ^ObjectIdentifier OID)

  (static-initializer
    (try
      (set! OID (ObjectIdentifier/of (.toString SpNegoMechFactory/GSS_SPNEGO_MECH_OID)))
      (catch IOException ioe)))

  (constructor ^:protected [this ^int tokenType]
    (set! (.-tokenType this) tokenType))

  (method ^:abstract encode :throws [GSSException] ^byte/1 [this])

  (method getEncoded :throws [IOException GSSException] ^byte/1 [this]
    (let [token (DerOutputStream.)]
      (.write token (.encode this))
      (switch tokenType
        NEG_TOKEN_INIT_ID
          (let [initToken (DerOutputStream.)]
            (.write initToken
                    (DerValue/createTag DerValue/TAG_CONTEXT
                                        true
                                        (unchecked-byte NEG_TOKEN_INIT_ID))
                    token)
            (.toByteArray initToken))
        NEG_TOKEN_TARG_ID
          (let [targToken (DerOutputStream.)]
            (.write targToken
                    (DerValue/createTag DerValue/TAG_CONTEXT
                                        true
                                        (unchecked-byte NEG_TOKEN_TARG_ID))
                    token)
            (.toByteArray targToken))
        (.toByteArray token))))

  (method ^:final getType ^int [this] tokenType)

  (method ^:static getTokenName ^String [^int type]
    (switch type
      NEG_TOKEN_INIT_ID "SPNEGO NegTokenInit"
      NEG_TOKEN_TARG_ID "SPNEGO NegTokenTarg"
      "SPNEGO Mechanism Token"))

  (method ^:static getNegoResultString ^String [^int result]
    (switch result
      0 "Accept Complete"
      1 "Accept InComplete"
      2 "Reject"
      (java-str "Unknown Negotiated Result: " result)))

  (method ^:static checkNextField :throws [GSSException] ^int [^int last ^int current]
    (if (< last current)
        current
        (throw (GSSException. GSSException/DEFECTIVE_TOKEN
                              -1
                              "Invalid SpNegoToken token : wrong order")))))

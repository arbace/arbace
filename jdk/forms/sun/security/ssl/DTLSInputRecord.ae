                            (SSLLogger/fine
                              (java-str "Rejected client hello fragment (bad random len) fo="
                                        (.-fragmentOffset hsf)
                                        " fl="
                                        (.-fragmentLength hsf))))
                          nil)
                        (do
                          (.position fragmentData (unchecked-add-int (.position fragmentData) 32))
                          (let [sessId (Record/getBytes8 fragmentData)]
                            (if (and (> (alength sessId) 0)
                                     (not SSLConfiguration/enableDtlsResumeCookie))
                                hsf
                                (let [cookie (Record/getBytes8 fragmentData)]
                                  (if (and firstHello (not (== (alength cookie) 0)))
                                      (do
                                        (when (and (SSLLogger/isOn) (SSLLogger/isOn "verbose"))
                                          (SSLLogger/fine
                                            (java-str
                                              "Rejected initial client hello fragment (bad cookie len) fo="
                                              (.-fragmentOffset hsf)
                                              " fl="
                                              (.-fragmentLength hsf))))
                                        nil)
                                      (do
                                        (Record/getBytes16 fragmentData)
                                        (Record/getBytes8 fragmentData)
                                        (if firstHello
                                            (DTLSInputRecord/truncateChFragment
                                              hsf
                                              (.position fragmentData))
                                            (let [hcMgr (.getHelloCookieManager
                                                          sslContext
                                                          ProtocolVersion/DTLS10)
                                                  msgFragBuf (ByteBuffer/wrap
                                                               (.-fragment hsf)
                                                               0
                                                               (.position fragmentData))
                                                  chMsg (ClientHello$ClientHelloMessage.
                                                          shc
                                                          msgFragBuf
                                                          nil)]
                                              (if (not (.isCookieValid hcMgr shc chMsg cookie))
                                                  (DTLSInputRecord/truncateChFragment
                                                    hsf
                                                    (.position fragmentData))
                                                  (do
                                                    (set! (.-acceptCliHelloFragments shc) true)
                                                    hsf)))))))))))))
                (catch IOException ioe
                  (when (and (SSLLogger/isOn) (SSLLogger/isOn "verbose"))
                    (SSLLogger/fine
                      (java-str "Rejected client hello fragment fo="
                                (.-fragmentOffset hsf)
                                " fl="
                                (.-fragmentLength hsf))))
                  nil)))
            hsf)))

    (method queueUpChangeCipherSpec :throws [SSLProtocolException] ^void [this ^RecordFragment rf]
      (when-not (not (.isDesirable this rf))
        (.cleanUpRetransmit this rf)
        (when expectCCSFlight
          (set! (.-handshakeType handshakeFlight) HandshakeFlight/HF_UNKNOWN)
          (set! (.-flightEpoch handshakeFlight) (.-recordEpoch rf)))
        (when (< (.-maxRecordSeq handshakeFlight) (.-recordSeq rf))
          (set! (.-maxRecordSeq handshakeFlight) (.-recordSeq rf)))
        (.bufferFragment this rf)))

    (method queueUpFragment :throws [SSLProtocolException] ^void [this ^RecordFragment rf]
      (when-not (not (.isDesirable this rf)) (.cleanUpRetransmit this rf) (.bufferFragment this rf)))

    (method ^:private bufferFragment ^void [this ^RecordFragment rf]
      (.add bufferedFragments rf)
      (when flightIsReady (set! flightIsReady false))
      (when-not needToCheckFlight (set! needToCheckFlight true)))

    (method ^:private cleanUpRetransmit ^void [this ^RecordFragment rf]
      (let [^:mutable isNewFlight false]
        (when (some? precedingFlight)
          (if (< (.-flightEpoch precedingFlight) (.-recordEpoch rf))
              (set! isNewFlight true)
              (if-instance [^HandshakeFragment hsf rf]
                (when (< (.-maxMessageSeq precedingFlight) (.-messageSeq hsf))
                  (set! isNewFlight true))
                (when-not (== (.-contentType rf) (.-id ContentType/CHANGE_CIPHER_SPEC))
                  (when (< (.-maxRecordEpoch precedingFlight) (.-recordEpoch rf))
                    (set! isNewFlight true))))))
        (when-not (not isNewFlight)
          (loop [^{:tag (Iterator RecordFragment)} it (.iterator bufferedFragments)]
            (when (.hasNext it)
              (let [frag (cast RecordFragment (.next it))
                    ^:mutable isOld false]
                (cond
                  (< (.-recordEpoch frag) (.-maxRecordEpoch precedingFlight)) (set! isOld true)
                  (== (.-recordEpoch frag) (.-maxRecordEpoch precedingFlight))
                    (when (<= (.-recordSeq frag) (.-maxRecordSeq precedingFlight))
                      (set! isOld true)))
                (when-not isOld
                  (when-instance [^HandshakeFragment hsf frag]
                    (set! isOld (<= (.-messageSeq hsf) (.-maxMessageSeq precedingFlight)))))
                (when isOld (.remove it) (recur it)))))
          (set! precedingFlight nil))))

    (method ^:private isDesirable :throws [SSLProtocolException] ^boolean [this ^RecordFragment rf]
      (let [previousEpoch (unchecked-subtract-int nextRecordEpoch 1)]
        (if (< (.-recordEpoch rf) previousEpoch)
            (do
              (when (and (SSLLogger/isOn) (SSLLogger/isOn "verbose"))
                (SSLLogger/fine "Too old epoch to use this record, discard it."))
              false)
            (do
              (if (== (.-recordEpoch rf) previousEpoch)
                  (let [^:mutable isDesired true]
                    (if (nil? precedingFlight)
                        (set! isDesired false)
                        (if-instance [^HandshakeFragment hsf rf]
                          (when (> (.-minMessageSeq precedingFlight) (.-messageSeq hsf))
                            (set! isDesired false))
                          (cond
                            (== (.-contentType rf) (.-id ContentType/CHANGE_CIPHER_SPEC))
                              (when-not (== (.-flightEpoch precedingFlight) (.-recordEpoch rf))
                                (set! isDesired false))
                            (or (< (.-recordEpoch rf) (.-maxRecordEpoch precedingFlight))
                                (and (== (.-recordEpoch rf) (.-maxRecordEpoch precedingFlight))
                                     (<= (.-recordSeq rf) (.-maxRecordSeq precedingFlight))))
                              (set! isDesired false))))
                    (when-not isDesired
                      (when (and (SSLLogger/isOn) (SSLLogger/isOn "verbose"))
                        (SSLLogger/fine "Too old retransmission to use, discard it."))
                      (return false)))
                  (when (and (== (.-recordEpoch rf) nextRecordEpoch)
                             (> nextRecordSeq (.-recordSeq rf)))
                    (when (and (SSLLogger/isOn) (SSLLogger/isOn "verbose"))
                      (SSLLogger/fine "Lagging behind record (sequence), discard it."))
                    (return false)))
              (when (== (.-recordEpoch rf) handshakeEpoch)
                (when-instance [^HandshakeFragment hsf rf]
                  (when (.containsKey (.-holesMap handshakeFlight) (.-handshakeType hsf))
                    (let [cachedMsgSeq (cast Integer
                                             (.get
                                               (.-messageSeqMap handshakeFlight)
                                               (.-handshakeType hsf)))]
                      (when (and (some? cachedMsgSeq) (not (== cachedMsgSeq (.-messageSeq hsf))))
                        (throw
                          (SSLProtocolException.
                            (java-str
                              "Two message sequence numbers are used for the same handshake message ("
                              (SSLHandshake/nameOf (.-handshakeType hsf))
                              ")"))))))))
              true))))

    (method ^:private isEmpty ^boolean [this]
      (or (or (.isEmpty bufferedFragments) (and (not flightIsReady) (not needToCheckFlight)))
          (and needToCheckFlight (not (.flightIsReady this)))))

    (method acquirePlaintext :throws [SSLProtocolException] ^Plaintext [this]
      (if (.isEmpty bufferedFragments)
          (do
            (when (and (SSLLogger/isOn) (SSLLogger/isOn "verbose"))
              (SSLLogger/fine "No received handshake messages"))
            nil)
          (do
            (when (and (not flightIsReady) needToCheckFlight)
              (set! flightIsReady (.flightIsReady this))
              (when flightIsReady
                (when (.isRetransmitOf handshakeFlight precedingFlight)
                  (.clear bufferedFragments)
                  (.resetHandshakeFlight this precedingFlight)
                  (when (and (SSLLogger/isOn) (SSLLogger/isOn "verbose"))
                    (SSLLogger/fine "Received a retransmission flight."))
                  (return Plaintext/PLAINTEXT_NULL)))
              (set! needToCheckFlight false))
            (if (not flightIsReady)
                (do
                  (when (and (SSLLogger/isOn) (SSLLogger/isOn "verbose"))
                    (SSLLogger/fine
                      (java-str "The handshake flight is not ready to use: "
                                (.-handshakeType handshakeFlight))))
                  nil)
                (let [rFrag (cast RecordFragment (.first bufferedFragments))
                      ^:mutable ^Plaintext plaintext nil]
                  (if (not (.-isCiphertext rFrag))
                      (do
                        (set! plaintext (.acquireHandshakeMessage this))
                        (when (.isEmpty bufferedFragments)
                          (.clear (.-holesMap handshakeFlight))
                          (set! precedingFlight (cast HandshakeFlight (.clone handshakeFlight)))
                          (.resetHandshakeFlight this precedingFlight)
                          (when (and expectCCSFlight
                                     (== (.-handshakeType precedingFlight)
                                         HandshakeFlight/HF_UNKNOWN))
                            (set! expectCCSFlight false))))
                      (set! plaintext (.acquireCachedMessage this)))
                  plaintext)))))

    (method ^:private resetHandshakeFlight ^void [this ^HandshakeFlight prev]
      (set! (.-handshakeType handshakeFlight) HandshakeFlight/HF_UNKNOWN)
      (set! (.-flightEpoch handshakeFlight) (.-maxRecordEpoch prev))
      (if (not (== (.-flightEpoch prev) (.-maxRecordEpoch prev)))
          (set! (.-minMessageSeq handshakeFlight) 0)
          (set! (.-minMessageSeq handshakeFlight) (unchecked-add-int (.-maxMessageSeq prev) 1)))
      (set! (.-maxMessageSeq handshakeFlight) 0)
      (set! (.-maxRecordEpoch handshakeFlight) (.-flightEpoch handshakeFlight))
      (set! (.-maxRecordSeq handshakeFlight) (unchecked-add (.-maxRecordSeq prev) 1))
      (.clear (.-holesMap handshakeFlight))
      (.clear (.-messageSeqMap handshakeFlight))
      (set! flightIsReady false)
      (set! needToCheckFlight false))

    (method ^:private acquireCachedMessage :throws [SSLProtocolException] ^Plaintext [this]
      (let [rFrag (cast RecordFragment (.first bufferedFragments))]
        (if (not (== readEpoch (.-recordEpoch rFrag)))
            (do
              (when (> readEpoch (.-recordEpoch rFrag))
                (when (and (SSLLogger/isOn) (SSLLogger/isOn "verbose"))
                  (SSLLogger/fine "Discard old buffered ciphertext fragments."))
                (.remove bufferedFragments rFrag))
              (when flightIsReady (set! flightIsReady false))
              (when (and (SSLLogger/isOn) (SSLLogger/isOn "verbose"))
                (SSLLogger/fine "Not yet ready to decrypt the cached fragments."))
              nil)
            (do
              (.remove bufferedFragments rFrag)
              (let [fragment (ByteBuffer/wrap (.-fragment rFrag))
                    ^:mutable ^ByteBuffer plaintextFragment nil]
                (try
                  (let [plaintext (.decrypt (.-readCipher DTLSInputRecord/this)
                                            (.-contentType rFrag)
                                            fragment
                                            (.-recordEnS rFrag))]
                    (set! plaintextFragment (.-fragment plaintext))
                    (set! (.-contentType rFrag) (.-contentType plaintext)))
                  (catch GeneralSecurityException gse
                    (when (and (SSLLogger/isOn) (SSLLogger/isOn "verbose"))
                      (SSLLogger/fine "Discard invalid record: " gse))
                    (return nil)))
                (if (== (.-contentType rFrag) (.-id ContentType/HANDSHAKE))
                    (do
                      (while (> (.remaining plaintextFragment) 0)
                        (let [hsFrag (DTLSInputRecord/parseHandshakeMessage
                                       (.-contentType rFrag)
                                       (.-majorVersion rFrag)
                                       (.-minorVersion rFrag)
                                       (.-recordEnS rFrag)
                                       (.-recordEpoch rFrag)
                                       (.-recordSeq rFrag)
                                       plaintextFragment)]
                          (when (nil? hsFrag)
                            (when (and (SSLLogger/isOn) (SSLLogger/isOn "verbose"))
                              (SSLLogger/fine "Invalid handshake fragment, discard it"
                                              plaintextFragment))
                            (return nil))
                          (.queueUpHandshake this hsFrag)
                          (when-not (== (.-handshakeType hsFrag) (.-id SSLHandshake/FINISHED))
                            (set! flightIsReady false)
                            (set! needToCheckFlight true))))
                      (.acquirePlaintext this))
                    (Plaintext. (.-contentType rFrag)
                                (.-majorVersion rFrag)
                                (.-minorVersion rFrag)
                                (.-recordEpoch rFrag)
                                (Authenticator/toLong (.-recordEnS rFrag))
                                plaintextFragment)))))))

    (method ^:private acquireHandshakeMessage ^Plaintext [this]
      (let [^:mutable rFrag (cast RecordFragment (.first bufferedFragments))]
        (if (== (.-contentType rFrag) (.-id ContentType/CHANGE_CIPHER_SPEC))
            (do
              (set! (.-nextRecordEpoch this) (unchecked-add-int (.-recordEpoch rFrag) 1))
              (set! (.-nextRecordSeq this) 0)
              (.remove bufferedFragments rFrag)
              (Plaintext. (.-contentType rFrag)
                          (.-majorVersion rFrag)
                          (.-minorVersion rFrag)
                          (.-recordEpoch rFrag)
                          (Authenticator/toLong (.-recordEnS rFrag))
                          (ByteBuffer/wrap (.-fragment rFrag))))
            (let [hsFrag (cast HandshakeFragment rFrag)]
              (if (and (== (.-messageLength hsFrag) (.-fragmentLength hsFrag))
                       (== (.-fragmentOffset hsFrag) 0))
                  (do
                    (.remove bufferedFragments rFrag)
                    (set! (.-nextRecordSeq this) (unchecked-add (.-recordSeq hsFrag) 1))
                    (let [recordFrag (new byte/1 (unchecked-add-int (.-messageLength hsFrag) 4))
                          plaintext (Plaintext. (.-contentType hsFrag)
                                                (.-majorVersion hsFrag)
                                                (.-minorVersion hsFrag)
                                                (.-recordEpoch hsFrag)
                                                (Authenticator/toLong (.-recordEnS hsFrag))
                                                (ByteBuffer/wrap recordFrag))]
                      (aset recordFrag 0 (.-handshakeType hsFrag))
                      (aset recordFrag
                            1
                            (unchecked-byte
                              (bit-and-int (unsigned-bit-shift-right-int
                                             (.-messageLength hsFrag)
                                             16)
                                           0xFF)))
                      (aset recordFrag
                            2
                            (unchecked-byte
                              (bit-and-int (unsigned-bit-shift-right-int (.-messageLength hsFrag) 8)
                                           0xFF)))
                      (aset recordFrag
                            3
                            (unchecked-byte (bit-and-int (.-messageLength hsFrag) 0xFF)))
                      (System/arraycopy (.-fragment hsFrag)
                                        0
                                        recordFrag
                                        4
                                        (.-fragmentLength hsFrag))
                      (.handshakeHashing this hsFrag plaintext)
                      plaintext))
                  (let [recordFrag (new byte/1 (unchecked-add-int (.-messageLength hsFrag) 4))
                        plaintext (Plaintext. (.-contentType hsFrag)
                                              (.-majorVersion hsFrag)
                                              (.-minorVersion hsFrag)
                                              (.-recordEpoch hsFrag)
                                              (Authenticator/toLong (.-recordEnS hsFrag))
                                              (ByteBuffer/wrap recordFrag))]
                    (aset recordFrag 0 (.-handshakeType hsFrag))
                    (aset recordFrag
                          1
                          (unchecked-byte
                            (bit-and-int (unsigned-bit-shift-right-int (.-messageLength hsFrag) 16)
                                         0xFF)))
                    (aset recordFrag
                          2
                          (unchecked-byte
                            (bit-and-int (unsigned-bit-shift-right-int (.-messageLength hsFrag) 8)
                                         0xFF)))
                    (aset recordFrag 3 (unchecked-byte (bit-and-int (.-messageLength hsFrag) 0xFF)))
                    (let [msgSeq (.-messageSeq hsFrag)
                          ^:mutable maxRecodeSN (.-recordSeq hsFrag)
                          ^:mutable hmFrag hsFrag]
                      (loop []
                        (System/arraycopy (.-fragment hmFrag)
                                          0
                                          recordFrag
                                          (unchecked-add-int (.-fragmentOffset hmFrag) 4)
                                          (.-fragmentLength hmFrag))
                        (.remove bufferedFragments rFrag)
                        (when (< maxRecodeSN (.-recordSeq hmFrag))
                          (set! maxRecodeSN (.-recordSeq hmFrag)))
                        (when-not (.isEmpty bufferedFragments)
                          (set! rFrag (cast RecordFragment (.first bufferedFragments)))
                          (if (not (== (.-contentType rFrag) (.-id ContentType/HANDSHAKE)))
                              (break)
                              (set! hmFrag (cast HandshakeFragment rFrag))))
                        (when (and (not (.isEmpty bufferedFragments))
                                   (== msgSeq (.-messageSeq hmFrag)))
                          (recur)))
                      (.handshakeHashing this hsFrag plaintext)
                      (set! (.-nextRecordSeq this) (unchecked-add maxRecodeSN 1))
                      plaintext)))))))

    (method flightIsReady ^boolean [this]
      (let [flightType (.-handshakeType handshakeFlight)]
        (cond
          (== flightType HandshakeFlight/HF_UNKNOWN)
            (if expectCCSFlight
                (let [isReady (.hasFinishedMessage this)]
                  (when (and (SSLLogger/isOn) (SSLLogger/isOn "verbose"))
                    (SSLLogger/fine (java-str "Has the final flight been received? " isReady)))
                  isReady)
                (do
                  (when (and (SSLLogger/isOn) (SSLLogger/isOn "verbose"))
                    (SSLLogger/fine "No flight is received yet."))
                  false))
          (or (or (== flightType (.-id SSLHandshake/CLIENT_HELLO))
                  (== flightType (.-id SSLHandshake/HELLO_REQUEST)))
              (== flightType (.-id SSLHandshake/HELLO_VERIFY_REQUEST)))
            (let [isReady (.hasCompleted this flightType)]
              (when (and (SSLLogger/isOn) (SSLLogger/isOn "verbose"))
                (SSLLogger/fine (java-str "Is the handshake message completed? " isReady)))
              isReady)
          (== flightType (.-id SSLHandshake/SERVER_HELLO))
            (cond
              (not (.hasCompleted this flightType))
                (do
                  (when (and (SSLLogger/isOn) (SSLLogger/isOn "verbose"))
                    (SSLLogger/fine "The ServerHello message is not completed yet."))
                  false)
              (.hasFinishedMessage this)
                (do
                  (when (and (SSLLogger/isOn) (SSLLogger/isOn "verbose"))
                    (SSLLogger/fine "It's an abbreviated handshake."))
                  true)
              :else
                (let [^{:tag (List HoleDescriptor)} holes (cast
                                                            List
                                                            (.get
                                                              (.-holesMap handshakeFlight)
                                                              (.-id SSLHandshake/SERVER_HELLO_DONE)))]
                  (if (or (nil? holes) (not (.isEmpty holes)))
                      (do
                        (when (and (SSLLogger/isOn) (SSLLogger/isOn "verbose"))
                          (SSLLogger/fine "Not yet got the ServerHelloDone message"))
                        false)
                      (let [isReady (.hasCompleted
                                      this
                                      bufferedFragments
                                      (.-minMessageSeq handshakeFlight)
                                      (.-maxMessageSeq handshakeFlight))]
                        (when (and (SSLLogger/isOn) (SSLLogger/isOn "verbose"))
                          (SSLLogger/fine
                            (java-str "Is the ServerHello flight (message "
                                      (.-minMessageSeq handshakeFlight)
                                      "-"
                                      (.-maxMessageSeq handshakeFlight)
                                      ") completed? "
                                      isReady)))
                        isReady))))
          (or (== flightType (.-id SSLHandshake/CERTIFICATE))
              (== flightType (.-id SSLHandshake/CLIENT_KEY_EXCHANGE)))
            (if (not (.hasCompleted this flightType))
                (do
                  (when (and (SSLLogger/isOn) (SSLLogger/isOn "verbose"))
                    (SSLLogger/fine
                      "The ClientKeyExchange or client Certificate message is not completed yet."))
                  false)
                (do
                  (when (== flightType (.-id SSLHandshake/CERTIFICATE))
                    (when (and (.needClientVerify this bufferedFragments)
                               (not (.hasCompleted this (.-id SSLHandshake/CERTIFICATE_VERIFY))))
                      (when (and (SSLLogger/isOn) (SSLLogger/isOn "verbose"))
                        (SSLLogger/fine "Not yet have the CertificateVerify message"))
                      (return false)))
                  (if (not (.hasFinishedMessage this))
                      (do
                        (when (and (SSLLogger/isOn) (SSLLogger/isOn "verbose"))
                          (SSLLogger/fine "Not yet have the ChangeCipherSpec and Finished messages"))
                        false)
                      (let [isReady (.hasCompleted
                                      this
                                      bufferedFragments
                                      (.-minMessageSeq handshakeFlight)
                                      (.-maxMessageSeq handshakeFlight))]
                        (when (and (SSLLogger/isOn) (SSLLogger/isOn "verbose"))
                          (SSLLogger/fine
                            (java-str "Is the ClientKeyExchange flight (message "
                                      (.-minMessageSeq handshakeFlight)
                                      "-"
                                      (.-maxMessageSeq handshakeFlight)
                                      ") completed? "
                                      isReady)))
                        isReady))))
          :else
            (do
              (when (and (SSLLogger/isOn) (SSLLogger/isOn "verbose"))
                (SSLLogger/fine "Need to receive more handshake messages"))
              false))))

    (method ^:private hasFinishedMessage ^boolean [this]
      (let [^:mutable hasCCS false
            ^:mutable hasFin false]
        (for-each [^RecordFragment fragment bufferedFragments]
          (cond
            (== (.-contentType fragment) (.-id ContentType/CHANGE_CIPHER_SPEC)) (set! hasCCS true)
            (and (== (.-contentType fragment) (.-id ContentType/HANDSHAKE))
                 (.-isCiphertext fragment))
              (set! hasFin true)))
        (and (and hasCCS hasFin)
             (or (or (not (.-isClientMode (.-sslConfig (.-tc DTLSInputRecord/this))))
                     (not (.-statelessResumption (.-handshakeContext (.-tc DTLSInputRecord/this)))))
                 (.hasCompleted this (.-id SSLHandshake/NEW_SESSION_TICKET))))))

    (method ^:private needClientVerify ^boolean [this ^{:tag (Set RecordFragment)} fragments]
      (for-each [^RecordFragment rFrag fragments]
        (when (or (not (== (.-contentType rFrag) (.-id ContentType/HANDSHAKE)))
                  (.-isCiphertext rFrag))
          (break))
        (let [hsFrag (cast HandshakeFragment rFrag)]
          (when-not (not (== (.-handshakeType hsFrag) (.-id SSLHandshake/CERTIFICATE)))
            (return (and (some? (.-fragment rFrag))
                         (> (alength (.-fragment rFrag)) DTLSRecord/minCertPlaintextSize))))))
      false)

    (method ^:private hasCompleted ^boolean [this ^byte handshakeType]
      (let [^{:tag (List HoleDescriptor)} holes (cast
                                                  List
                                                  (.get (.-holesMap handshakeFlight) handshakeType))]
        (if (nil? holes) false (.isEmpty holes))))

    (method ^:private hasCompleted ^boolean [this ^{:tag (Set RecordFragment)} fragments
                                             ^:mutable ^int presentMsgSeq ^int endMsgSeq]
      (for-each [^RecordFragment rFrag fragments]
        (when (or (not (== (.-contentType rFrag) (.-id ContentType/HANDSHAKE)))
                  (.-isCiphertext rFrag))
          (break))
        (let [hsFrag (cast HandshakeFragment rFrag)]
          (when-not (== (.-messageSeq hsFrag) presentMsgSeq)
            (if (== (.-messageSeq hsFrag) (unchecked-add-int presentMsgSeq 1))
                (do
                  (when-not (.hasCompleted this (.-handshakeType hsFrag)) (return false))
                  (set! presentMsgSeq (.-messageSeq hsFrag)))
                (break)))))
      (>= presentMsgSeq endMsgSeq))

    (method ^:private handshakeHashing ^void [this ^HandshakeFragment hsFrag ^Plaintext plaintext]
      (let [hsType (.-handshakeType hsFrag)]
        (when-not (not (.isHashable (.-handshakeHash DTLSInputRecord/this) hsType))
          (.position (.-fragment plaintext) 4)
          (let [temporary (new byte/1 (unchecked-add-int (.remaining (.-fragment plaintext)) 12))]
            (aset temporary 0 (.-handshakeType hsFrag))
            (aset temporary
                  1
                  (unchecked-byte
                    (bit-and-int (bit-shift-right-int (.-messageLength hsFrag) 16) 0xFF)))
            (aset temporary
                  2
                  (unchecked-byte
                    (bit-and-int (bit-shift-right-int (.-messageLength hsFrag) 8) 0xFF)))
            (aset temporary 3 (unchecked-byte (bit-and-int (.-messageLength hsFrag) 0xFF)))
            (aset temporary
                  4
                  (unchecked-byte (bit-and-int (bit-shift-right-int (.-messageSeq hsFrag) 8) 0xFF)))
            (aset temporary 5 (unchecked-byte (bit-and-int (.-messageSeq hsFrag) 0xFF)))
            (aset temporary 6 0)
            (aset temporary 7 0)
            (aset temporary 8 0)
            (aset temporary 9 (aget temporary 1))
            (aset temporary 10 (aget temporary 2))
            (aset temporary 11 (aget temporary 3))
            (.get (.-fragment plaintext) temporary 12 (.remaining (.-fragment plaintext)))
            (.receive (.-handshakeHash DTLSInputRecord/this) temporary)
            (.position (.-fragment plaintext) 0)))))))

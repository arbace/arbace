  (defclass ^:private ^:static ^:final RSAKAGenerator
    :implements [SSLKeyAgreementGenerator]

    (constructor ^:private [this])

    (method ^:public createKeyDerivation :throws [IOException] ^SSLKeyDerivation [this
                                                                                  ^HandshakeContext context]
      (let [^:mutable ^RSAPremasterSecret premaster nil]
        (if (instance? ClientHandshakeContext context)
            (for-each [^SSLPossession possession (.-handshakePossessions context)]
              (when (instance? RSAPremasterSecret possession)
                (set! premaster (cast RSAPremasterSecret possession))
                (break)))
            (for-each [^SSLCredentials credential (.-handshakeCredentials context)]
              (when (instance? RSAPremasterSecret credential)
                (set! premaster (cast RSAPremasterSecret credential))
                (break))))
        (when (nil? premaster)
          (throw (.fatal (.-conContext context)
                         Alert/HANDSHAKE_FAILURE
                         "No sufficient RSA key agreement parameters negotiated")))
        (RSAKAKeyDerivation. context (.-premasterSecret premaster))))


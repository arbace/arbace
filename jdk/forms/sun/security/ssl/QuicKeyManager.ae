      (Objects/requireNonNull negotiatedVersion)
      (when (.keysAvailable this)
        (throw (IllegalStateException.
                 (java-str "Keys already derived for " (.-keySpace this) " key space"))))
      (set! (.-negotiatedVersion this) negotiatedVersion)
      (try
        (let [kd (.-handshakeKeyDerivation handshakeContext)
              client_application_traffic_secret_0 (.deriveKey kd "TlsClientAppTrafficSecret")
              server_application_traffic_secret_0 (.deriveKey kd "TlsServerAppTrafficSecret")]
          (.deriveOneRttKeys this
                             (.-negotiatedVersion this)
                             client_application_traffic_secret_0
                             server_application_traffic_secret_0
                             (.-negotiatedCipherSuite handshakeContext)
                             clientMode))
        (catch GeneralSecurityException e (throw (SSLException. "Missing cipher algorithm" e)))))

    (method deriveOneRttKeys :throws [IOException GeneralSecurityException] ^void [this
                                                                                   ^:final ^QuicVersion version
                                                                                   ^:final ^SecretKey client_application_traffic_secret_0
                                                                                   ^:final ^SecretKey server_application_traffic_secret_0
                                                                                   ^:final ^CipherSuite negotiatedCipherSuite
                                                                                   ^:final ^boolean clientMode]
      (let [clientKeys (QuicKeyManager/deriveQuicKeys
                         version
                         negotiatedCipherSuite
                         client_application_traffic_secret_0)
            serverKeys (QuicKeyManager/deriveQuicKeys
                         version
                         negotiatedCipherSuite
                         server_application_traffic_secret_0)
            ^:mutable ^QuicCipher$QuicReadCipher readCipher nil
            ^:mutable ^QuicCipher$QuicWriteCipher writeCipher nil
            ^:const ^int keyPhase 0]
        (if clientMode
            (do
              (set! readCipher
                    (QuicCipher/createReadCipher
                      negotiatedCipherSuite
                      server_application_traffic_secret_0
                      (.-key serverKeys)
                      (.-iv serverKeys)
                      (.-hp serverKeys)
                      keyPhase))
              (set! writeCipher
                    (QuicCipher/createWriteCipher
                      negotiatedCipherSuite
                      client_application_traffic_secret_0
                      (.-key clientKeys)
                      (.-iv clientKeys)
                      (.-hp clientKeys)
                      keyPhase)))
            (do
              (set! readCipher
                    (QuicCipher/createReadCipher
                      negotiatedCipherSuite
                      client_application_traffic_secret_0
                      (.-key clientKeys)
                      (.-iv clientKeys)
                      (.-hp clientKeys)
                      keyPhase))
              (set! writeCipher
                    (QuicCipher/createWriteCipher
                      negotiatedCipherSuite
                      server_application_traffic_secret_0
                      (.-key serverKeys)
                      (.-iv serverKeys)
                      (.-hp serverKeys)
                      keyPhase))))
        (let [nPlus1ReadCipher (OneRttKeyManager/generateNextReadCipher version readCipher)
              nPlus1WriteCipher (OneRttKeyManager/generateNextWriteCipher version writeCipher)]
          (.lock (.-keySeriesLock this))
          (try
            (when (some? (.-keySeries this))
              (throw (IllegalStateException.
                       (java-str "Keys already available for keyspace: " (.-keySpace this)))))
            (set! (.-keySeries this)
                  (KeySeries. nil
                              (CipherPair. readCipher writeCipher)
                              (CipherPair. nPlus1ReadCipher nPlus1WriteCipher)))
            (finally (.unlock (.-keySeriesLock this)))))))

    (method ^:private ^:static generateNextWriteCipher :throws [IOException
                                                                GeneralSecurityException] ^QuicCipher$QuicWriteCipher [^:final ^QuicVersion quicVersion
                                                                                                                       ^:final ^QuicCipher$QuicWriteCipher current]
      (let [^SSLKeyDerivation kd (QuicTLSKeyDerivation.
                                   (.getCipherSuite current)
                                   (.getBaseSecret current))
            tlsData (QuicKeyManager/getQuicData quicVersion)
            nplus1Secret (.deriveKey kd (.getTlsKeyUpdateLabel tlsData))
            quicKeys (QuicKeyManager/deriveQuicKeys
                       quicVersion
                       (.getCipherSuite current)
                       nplus1Secret
                       (.getHeaderProtectionKey current))
            ^int nextKeyPhase (if (== (.getKeyPhase current) 0) 1 0)
            next (QuicCipher/createWriteCipher (.getCipherSuite current)
                                               nplus1Secret
                                               (.-key quicKeys)
                                               (.-iv quicKeys)
                                               (.-hp quicKeys)
                                               nextKeyPhase)]
        next))

    (method ^:private ^:static generateNextReadCipher :throws [IOException GeneralSecurityException] ^QuicCipher$QuicReadCipher [^:final ^QuicVersion quicVersion
                                                                                                                                 ^:final ^QuicCipher$QuicReadCipher current]
      (let [^SSLKeyDerivation kd (QuicTLSKeyDerivation.
                                   (.getCipherSuite current)
                                   (.getBaseSecret current))
            tlsData (QuicKeyManager/getQuicData quicVersion)
            nPlus1Secret (.deriveKey kd (.getTlsKeyUpdateLabel tlsData))
            quicKeys (QuicKeyManager/deriveQuicKeys
                       quicVersion
                       (.getCipherSuite current)
                       nPlus1Secret
                       (.getHeaderProtectionKey current))
            ^int nextKeyPhase (if (== (.getKeyPhase current) 0) 1 0)
            next (QuicCipher/createReadCipher (.getCipherSuite current)
                                              nPlus1Secret
                                              (.-key quicKeys)
                                              (.-iv quicKeys)
                                              (.-hp quicKeys)
                                              nextKeyPhase)]
        next))

    (method ^:private generateNextKeys :throws [GeneralSecurityException IOException] ^KeySeries [this
                                                                                                  ^:final ^QuicVersion version
                                                                                                  ^:final ^KeySeries currentSeries]
      (.lock (.-keySeriesLock this))
      (try
        (if (not (identical? (.-keySeries this) currentSeries))
            (.-keySeries this)
            (let [nPlus1ReadCipher (OneRttKeyManager/generateNextReadCipher
                                     version
                                     (.-readCipher (.-current currentSeries)))
                  nPlus1WriteCipher (OneRttKeyManager/generateNextWriteCipher
                                      version
                                      (.-writeCipher (.-current currentSeries)))
                  newSeries (KeySeries. (.-old currentSeries)
                                        (.-current currentSeries)
                                        (CipherPair. nPlus1ReadCipher nPlus1WriteCipher))]
              (set! (.-keySeries this) newSeries)
              newSeries))
        (finally (.unlock (.-keySeriesLock this)))))

    (method ^:private rolloverKeys ^KeySeries [this ^:final ^QuicVersion version
                                               ^:final ^KeySeries currentSeries]
      (.lock (.-keySeriesLock this))
      (try
        (if (not (identical? (.-keySeries this) currentSeries))
            (.-keySeries this)
            (do
              (java-assert (some? (.-next currentSeries)) "Key series missing next keys")
              (let [oldReadCipher (.-old currentSeries)
                    writeCipherToDiscard (.-writeCipher (.-current currentSeries))
                    newSeries (KeySeries. (.-readCipher (.-current currentSeries))
                                          (.-next currentSeries)
                                          nil)]
                (set! (.-keySeries this) newSeries)
                (when (some? oldReadCipher)
                  (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl"))
                    (SSLLogger/finest
                      (java-str "discarding old read key of key phase: "
                                (.getKeyPhase oldReadCipher))))
                  (.discard oldReadCipher false))
                (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl"))
                  (SSLLogger/finest
                    (java-str "discarding write key of key phase: "
                              (.getKeyPhase writeCipherToDiscard))))
                (.discard writeCipherToDiscard false)
                newSeries)))
        (finally (.unlock (.-keySeriesLock this))))))

  (defclass ^:private ^:static ^:final QuicTLSKeyDerivation
    :implements [SSLKeyDerivation]

    (defclass ^:private ^:enum HkdfLabel
      (constants
        (quickey ["quic key"])
        (quiciv ["quic iv"])
        (quichp ["quic hp"])
        (quicku ["quic ku"])
        (quicv2key ["quicv2 key"])
        (quicv2iv ["quicv2 iv"])
        (quicv2hp ["quicv2 hp"])
        (quicv2ku ["quicv2 ku"]))

      (field ^:private ^:final ^String label)

      (field ^:private ^:final ^byte/1 tls13LabelBytes)

      (constructor [this ^:final ^String label]
        (Objects/requireNonNull label)
        (set! (.-label this) label)
        (set! (.-tls13LabelBytes this) (.getBytes (java-str "tls13 " label) StandardCharsets/UTF_8)))

      (method ^:private ^:static fromLabel ^HkdfLabel [^:final ^String label]
        (Objects/requireNonNull label)
        (for-each [^HkdfLabel hkdfLabel (HkdfLabel/values)]
          (when (.equals (.-label hkdfLabel) label) (return hkdfLabel)))
        (throw (IllegalArgumentException. (java-str "unrecognized label: " label)))))

    (field ^:private ^:final ^CipherSuite cs)

    (field ^:private ^:final ^SecretKey secret)

    (constructor ^:private [this ^:final ^CipherSuite cs ^:final ^SecretKey secret]
      (set! (.-cs this) (cast CipherSuite (Objects/requireNonNull cs)))
      (set! (.-secret this) (cast SecretKey (Objects/requireNonNull secret))))

    (method ^:public deriveKey :throws [IOException] ^SecretKey [this ^:final ^String algorithm]
      (let [hkdfLabel (HkdfLabel/fromLabel algorithm)]
        (try
          (let [hkdf (KDF/getInstance (.-hkdfAlgorithm (.-hashAlg (.-cs this))))
                keyLength (.getKeyLength this hkdfLabel)
                hkdfInfo (QuicKeyManager/createHkdfInfo (.-tls13LabelBytes hkdfLabel) keyLength)
                keyAlgo (.getKeyAlgorithm this hkdfLabel)]
            (.deriveKey hkdf keyAlgo (HKDFParameterSpec/expandOnly secret hkdfInfo keyLength)))
          (catch GeneralSecurityException gse
            (throw (SSLHandshakeException. "Could not derive key" gse))))))

    (method ^:public deriveData :throws [IOException] ^byte/1 [this ^:final ^String algorithm]
      (let [hkdfLabel (HkdfLabel/fromLabel algorithm)]
        (try
          (let [hkdf (KDF/getInstance (.-hkdfAlgorithm (.-hashAlg (.-cs this))))
                keyLength (.getKeyLength this hkdfLabel)
                hkdfInfo (QuicKeyManager/createHkdfInfo (.-tls13LabelBytes hkdfLabel) keyLength)]
            (.deriveData hkdf (HKDFParameterSpec/expandOnly secret hkdfInfo keyLength)))
          (catch GeneralSecurityException gse
            (throw (SSLHandshakeException. "Could not derive key" gse))))))

    (method ^:private getKeyLength ^int [this ^:final ^HkdfLabel hkdfLabel]
      (switch hkdfLabel
        (quicku quicv2ku) (.-hashLength (.-hashAlg (.-cs this)))
        (quiciv quicv2iv) (.-ivSize (.-bulkCipher (.-cs this)))
        (.-keySize (.-bulkCipher (.-cs this)))))

    (method ^:private getKeyAlgorithm ^String [this ^:final ^HkdfLabel hkdfLabel]
      (switch hkdfLabel
        (quicku quicv2ku) "TlsUpdateNplus1"
        (quiciv quicv2iv) (throw (IllegalArgumentException. "IV not expected"))
        (.-algorithm (.-bulkCipher (.-cs this))))))

  (defclass ^:private ^:enum QuicTLSData
    (constants
      (V1 ["38762cf7f55934b34d179ae6a4c80cadccbb7f0a" "be0c690b9f66575a1d766b54e368c84e"
           "461599d35d632bf2239825bb" "quic key" "quic iv" "quic hp" "quic ku"])
      (V2 ["0dede3def700a6db819381be6e269dcbf9bd2ed9" "8fb4b01b56ac48e260fbcbcead7ccc92"
           "d86969bc2d7c6d9990efb04a" "quicv2 key" "quicv2 iv" "quicv2 hp" "quicv2 ku"]))

    (field ^:private ^:final ^byte/1 initialSalt)

    (field ^:private ^:final ^SecretKey retryKey)

    (field ^:private ^:final ^GCMParameterSpec retryIvSpec)

    (field ^:private ^:final ^String keyLabel)

    (field ^:private ^:final ^String ivLabel)

    (field ^:private ^:final ^String hpLabel)

    (field ^:private ^:final ^String kuLabel)

    (constructor [this ^String initialSalt ^String retryKey ^String retryIv ^String keyLabel
                  ^String ivLabel ^String hpLabel ^String kuLabel]
      (set! (.-initialSalt this) (.parseHex (HexFormat/of) initialSalt))
      (set! (.-retryKey this) (SecretKeySpec. (.parseHex (HexFormat/of) retryKey) "AES"))
      (set! retryIvSpec (GCMParameterSpec. 128 (.parseHex (HexFormat/of) retryIv)))
      (set! (.-keyLabel this) keyLabel)
      (set! (.-ivLabel this) ivLabel)
      (set! (.-hpLabel this) hpLabel)
      (set! (.-kuLabel this) kuLabel))

    (method ^:public getInitialSalt ^byte/1 [this] initialSalt)

    (method ^:public getRetryCipher :throws [QuicTransportException] ^Cipher [this ^boolean incoming]
      (let [^:mutable ^Cipher retryCipher nil]
        (try
          (set! retryCipher (Cipher/getInstance "AES/GCM/NoPadding"))
          (.init retryCipher
                 (if incoming Cipher/DECRYPT_MODE Cipher/ENCRYPT_MODE)
                 retryKey
                 retryIvSpec)
          (catch Exception e
            (throw (QuicTransportException. "Cipher not available"
                                            nil
                                            0
                                            (unchecked-add
                                              QuicTLSEngineImpl/BASE_CRYPTO_ERROR
                                              (.-id Alert/INTERNAL_ERROR))
                                            e))))
        retryCipher))

    (method ^:public getTlsKeyLabel ^String [this] keyLabel)

    (method ^:public getTlsIvLabel ^String [this] ivLabel)

    (method ^:public getTlsHpLabel ^String [this] hpLabel)

    (method ^:public getTlsKeyUpdateLabel ^String [this] kuLabel)))

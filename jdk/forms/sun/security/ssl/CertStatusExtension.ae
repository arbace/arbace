            (do
              (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake"))
                (SSLLogger/finest "Stapling is disabled for this connection"))
              nil)
          (nil? (.-currentCertEntry shc))
            (do
              (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake"))
                (SSLLogger/finest "Found null CertificateEntry in context"))
              nil)
          :else
            (do
              (try
                (let [cf (CertificateFactory/getInstance "X.509")
                      x509Cert (cast
                                 X509Certificate
                                 (.generateCertificate
                                   cf
                                   (ByteArrayInputStream. (.-encoded (.-currentCertEntry shc)))))
                      respBytes (cast byte/1 (.get (.-responseMap (.-stapleParams shc)) x509Cert))]
                  (when (nil? respBytes)
                    (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake,verbose"))
                      (SSLLogger/finest
                        (java-str "No status response found for "
                                  (.getSubjectX500Principal x509Cert))))
                    (set! (.-currentCertEntry shc) nil)
                    (return nil))
                  (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake,verbose"))
                    (SSLLogger/finest
                      (java-str "Found status response for "
                                (.getSubjectX500Principal x509Cert)
                                ", response length: "
                                (alength respBytes))))
                  (let [^CertStatusResponse certResp (if (identical?
                                                           (.-statReqType (.-stapleParams shc))
                                                           CertStatusRequestType/OCSP)
                                                         ^CertStatusResponse (OCSPStatusResponse.
                                                                               (.-id
                                                                                 (.-statReqType
                                                                                   (.-stapleParams
                                                                                     shc)))
                                                                               respBytes)
                                                         (CertStatusResponse.
                                                           (.-id
                                                             (.-statReqType (.-stapleParams shc)))
                                                           respBytes))]
                    (set! producedData (.toByteArray certResp))))
                (catch CertificateException ce
                  (throw (.fatal (.-conContext shc)
                                 Alert/BAD_CERTIFICATE
                                 "Failed to parse server certificates"
                                 ce)))
                (catch IOException ioe
                  (throw (.fatal (.-conContext shc)
                                 Alert/BAD_CERT_STATUS_RESPONSE
                                 "Failed to parse certificate status response"
                                 ioe))))
              (set! (.-currentCertEntry shc) nil)
              producedData)))))

  (defclass ^:private ^:static ^:final CTCertStatusResponseConsumer
    :implements [SSLExtension$ExtensionConsumer]

    (constructor ^:private [this])

    (method ^:public consume :throws [IOException] ^void [this ^ConnectionContext context
                                                          ^SSLHandshake$HandshakeMessage message
                                                          ^ByteBuffer buffer]
      (let [chc (cast ClientHandshakeContext context)
            spec (CertStatusResponseSpec. chc buffer)]
        (when (.isStaplingEnabled (.-sslContext chc) true)
          (set! (.-staplingActive chc) true)
          (cond
            (and (some? (.-handshakeSession chc)) (not (.-isResumption chc)))
              (let [^{:tag (List byte/1)} respList (ArrayList.
                                                     (.getStatusResponses (.-handshakeSession chc)))]
                (.add respList (.-encodedResponse (.-statusResponse spec)))
                (.setStatusResponses (.-handshakeSession chc) respList))
            (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake,verbose"))
              (SSLLogger/finest "Ignoring stapled data on resumed session")))))))

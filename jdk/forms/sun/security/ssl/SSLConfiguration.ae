                      (set! (.-namedGroups this) NamedGroup$SupportedGroups/namedGroups))
                  (set! (.-preferLocalCipherSuites this) (.getUseCipherSuitesOrder params))
                  (set! (.-enableRetransmissions this) (.getEnableRetransmissions params))
                  (set! (.-maximumPacketSize this) (.getMaximumPacketSize params))))))))))

  (method addHandshakeCompletedListener ^void [this ^HandshakeCompletedListener listener]
    (when (nil? handshakeListeners) (set! handshakeListeners (HashSet. 4)))
    (.add handshakeListeners listener))

  (method removeHandshakeCompletedListener ^void [this ^HandshakeCompletedListener listener]
    (when (nil? handshakeListeners) (throw (IllegalArgumentException. "no listeners")))
    (when-not (.remove handshakeListeners listener)
      (throw (IllegalArgumentException. "listener not registered")))
    (when (.isEmpty handshakeListeners) (set! handshakeListeners nil)))

  (method isAvailable ^boolean [this ^SSLExtension extension]
    (for-each [^ProtocolVersion protocolVersion enabledProtocols]
      (when (.isAvailable extension protocolVersion)
        (when (if isClientMode
                  (.contains SSLExtension$ClientExtensions/defaults extension)
                  (.contains SSLExtension$ServerExtensions/defaults extension))
          (return true))))
    false)

  (method isAvailable ^boolean [this ^SSLExtension extension ^ProtocolVersion protocolVersion]
    (and (.isAvailable extension protocolVersion)
         (if isClientMode
             (.contains SSLExtension$ClientExtensions/defaults extension)
             (.contains SSLExtension$ServerExtensions/defaults extension))))

  (method getEnabledExtensions ^SSLExtension/1 [this ^SSLHandshake handshakeType]
    (let [^{:tag (List SSLExtension)} extensions (ArrayList.)]
      (for-each [^SSLExtension extension (SSLExtension/values)]
        (when (identical? (.-handshakeType extension) handshakeType)
          (when (.isAvailable this extension) (.add extensions extension))))
      (cast SSLExtension/1 (.toArray extensions (new SSLExtension/1 0)))))

  (method getExclusiveExtensions ^SSLExtension/1 [this ^SSLHandshake handshakeType
                                                  ^{:tag (List SSLExtension)} excluded]
    (let [^{:tag (List SSLExtension)} extensions (ArrayList.)]
      (for-each [^SSLExtension extension (SSLExtension/values)]
        (when (identical? (.-handshakeType extension) handshakeType)
          (when (and (.isAvailable this extension) (not (.contains excluded extension)))
            (.add extensions extension))))
      (cast SSLExtension/1 (.toArray extensions (new SSLExtension/1 0)))))

  (method getEnabledExtensions ^SSLExtension/1 [this ^SSLHandshake handshakeType
                                                ^ProtocolVersion protocolVersion]
    (.getEnabledExtensions this handshakeType (List/of protocolVersion)))

  (method getEnabledExtensions ^SSLExtension/1 [this ^SSLHandshake handshakeType
                                                ^{:tag (List ProtocolVersion)} activeProtocols]
    (let [^{:tag (List SSLExtension)} extensions (ArrayList.)]
      (for-each [^SSLExtension extension (SSLExtension/values)]
        (when (identical? (.-handshakeType extension) handshakeType)
          (when-not (not (.isAvailable this extension))
            (for-each [^ProtocolVersion protocolVersion activeProtocols]
              (when (.isAvailable extension protocolVersion) (.add extensions extension) (break))))))
      (cast SSLExtension/1 (.toArray extensions (new SSLExtension/1 0)))))

  (method toggleClientMode ^void [this]
    (set! (.-isClientMode this) (not (= (.-isClientMode this) true)))
    (when (or (Arrays/equals signatureSchemes CustomizedClientSignatureSchemes/signatureSchemes)
              (Arrays/equals signatureSchemes CustomizedServerSignatureSchemes/signatureSchemes))
      (set! (.-signatureSchemes this)
            (if isClientMode
                CustomizedClientSignatureSchemes/signatureSchemes
                CustomizedServerSignatureSchemes/signatureSchemes))))

  (method ^:public isUseCompatibilityMode ^boolean [this]
    (and useCompatibilityMode (not isQuic)))

  (method ^:public setQuic ^void [this ^boolean quic] (set! isQuic quic))

  (method ^:public clone [this]
    (try
      (let [config (cast SSLConfiguration (.clone super))]
        (when (some? handshakeListeners)
          (set! (.-handshakeListeners config) (cast HashSet (.clone handshakeListeners))))
        (return config))
      (catch CloneNotSupportedException cnse))

  (defclass ^:private ^:static ^:final CustomizedClientSignatureSchemes
    (field ^:private ^:static ^:final ^String/1 signatureSchemes
      (SSLConfiguration/getCustomizedSignatureScheme "jdk.tls.client.SignatureSchemes")))

  (defclass ^:private ^:static ^:final CustomizedServerSignatureSchemes
    (field ^:private ^:static ^:final ^String/1 signatureSchemes
      (SSLConfiguration/getCustomizedSignatureScheme "jdk.tls.server.SignatureSchemes")))

  (method ^:private ^:static getCustomizedSignatureScheme ^String/1 [^String propertyName]
    (let [^:mutable property (System/getProperty propertyName)]
      (when (and (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,sslctx"))
                 (not (.isVirtual (Thread/currentThread))))
        (SSLLogger/fine (java-str "System property " propertyName " is set to '" property "'")))
      (when (and (some? property) (not (.isEmpty property)))
        (when (and (and (> (.length property) 1) (== (.charAt property 0) \"))
                   (== (.charAt property (unchecked-subtract-int (.length property) 1)) \"))
          (set! property (.substring property 1 (unchecked-subtract-int (.length property) 1)))))
      (when (and (some? property) (not (.isEmpty property)))
        (let [signatureSchemeNames (.split property ",")
              ^{:tag (List String)} signatureSchemes (ArrayList. (alength signatureSchemeNames))]
          (for-each [^:mutable ^String schemeName signatureSchemeNames]
            (set! schemeName (.trim schemeName))
            (when-not (.isEmpty schemeName)
              (let [scheme (SignatureScheme/nameOf schemeName)]
                (cond
                  (and (some? scheme) (.-isAvailable scheme)) (.add signatureSchemes schemeName)
                  (and (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,sslctx"))
                       (not (.isVirtual (Thread/currentThread))))
                    (SSLLogger/fine
                      (java-str "The current installed providers do not support signature scheme: "
                                schemeName))))))
          (when-not (.isEmpty signatureSchemes)
            (return (cast String/1 (.toArray signatureSchemes (new String/1 0)))))))
      nil)))

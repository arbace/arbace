  (method setSSLParameters ^void [this ^SSLParameters params]
    (let [ac (.getAlgorithmConstraints params)]
      (when (some? ac) (set! (.-userSpecifiedAlgorithmConstraints this) ac))
      (let [^:mutable sa (.getCipherSuites params)]
        (when (some? sa) (set! (.-enabledCipherSuites this) (CipherSuite/validValuesOf sa)))
        (set! sa (.getProtocols params))
        (when (some? sa)
          (set! (.-enabledProtocols this) (ProtocolVersion/namesOf sa))
          (set! (.-maximumProtocolVersion this) ProtocolVersion/NONE)
          (for-each [^ProtocolVersion pv enabledProtocols]
            (when (> (.compareTo pv maximumProtocolVersion) 0)
              (set! (.-maximumProtocolVersion this) pv))))
        (cond
          (.getNeedClientAuth params)
            (set! (.-clientAuthType this) ClientAuthType/CLIENT_AUTH_REQUIRED)
          (.getWantClientAuth params)
            (set! (.-clientAuthType this) ClientAuthType/CLIENT_AUTH_REQUESTED)
          :else (set! (.-clientAuthType this) ClientAuthType/CLIENT_AUTH_NONE))
        (let [s (.getEndpointIdentificationAlgorithm params)]
          (when (some? s) (set! (.-identificationProtocol this) s))
          (let [^{:tag (List SNIServerName)} sniNames (.getServerNames params)]
            (when (some? sniNames)
              (set! (.-noSniExtension this) (.isEmpty sniNames))
              (set! (.-serverNames this) sniNames))
            (let [^{:tag (Collection SNIMatcher)} matchers (.getSNIMatchers params)]
              (when (some? matchers)
                (set! (.-noSniMatcher this) (.isEmpty matchers))
                (set! (.-sniMatchers this) matchers))
              (set! sa (.getApplicationProtocols params))
              (when (some? sa) (set! (.-applicationProtocols this) sa))

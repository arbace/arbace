    (set! (.-isClientMode this) isClientMode)
    (set! (.-enableSessionCreation this) true)
    (set! (.-socketAPSelector this) nil)
    (set! (.-engineAPSelector this) nil)
    (set! (.-handshakeListeners this) nil)
    (set! (.-noSniExtension this) false)
    (set! (.-noSniMatcher this) false))

  (method getSSLParameters ^SSLParameters [this]
    (let [params (SSLParameters.)]
      (.setAlgorithmConstraints params (.-userSpecifiedAlgorithmConstraints this))
      (.setProtocols params (ProtocolVersion/toStringArray enabledProtocols))
      (.setCipherSuites params (CipherSuite/namesOf enabledCipherSuites))
      (switch (.-clientAuthType this)
        CLIENT_AUTH_REQUIRED (.setNeedClientAuth params true)
        CLIENT_AUTH_REQUESTED (.setWantClientAuth params true)
        (.setWantClientAuth params false))
      (.setEndpointIdentificationAlgorithm params (.-identificationProtocol this))
      (if (and (.isEmpty serverNames) (not noSniExtension))
          (.setServerNames params nil)
          (.setServerNames params (.-serverNames this)))
      (if (and (.isEmpty sniMatchers) (not noSniMatcher))
          (.setSNIMatchers params nil)
          (.setSNIMatchers params (.-sniMatchers this)))
      (.setApplicationProtocols params (.-applicationProtocols this))
      (.setUseCipherSuitesOrder params (.-preferLocalCipherSuites this))
      (.setEnableRetransmissions params (.-enableRetransmissions this))
      (.setMaximumPacketSize params (.-maximumPacketSize this))

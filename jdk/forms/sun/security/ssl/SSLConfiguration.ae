  (constructor [this ^SSLContextImpl sslContext ^boolean isClientMode]
    (set! (.-userSpecifiedAlgorithmConstraints this) SSLAlgorithmConstraints/DEFAULT)
    (set! (.-enabledProtocols this) (.getDefaultProtocolVersions sslContext (not isClientMode)))
    (set! (.-enabledCipherSuites this) (.getDefaultCipherSuites sslContext (not isClientMode)))
    (set! (.-clientAuthType this) ClientAuthType/CLIENT_AUTH_NONE)
    (set! (.-identificationProtocol this) nil)
    (set! (.-serverNames this) (Collections/emptyList))
    (set! (.-sniMatchers this) (Collections/emptyList))
    (set! (.-preferLocalCipherSuites this) true)
    (set! (.-applicationProtocols this) (new String/1 0))
    (set! (.-enableRetransmissions this) (.isDTLS sslContext))
    (set! (.-maximumPacketSize this) 0)
    (set! (.-signatureSchemes this)
          (cond
            isClientMode
              (if (some? CustomizedClientSignatureSchemes/signatureSchemes)
                  CustomizedClientSignatureSchemes/signatureSchemes
                  SignatureScheme$SupportedSigSchemes/DEFAULT)
            (some? CustomizedServerSignatureSchemes/signatureSchemes)
              CustomizedServerSignatureSchemes/signatureSchemes
            :else SignatureScheme$SupportedSigSchemes/DEFAULT))
    (set! (.-namedGroups this) NamedGroup$SupportedGroups/namedGroups)
    (set! (.-maximumProtocolVersion this) ProtocolVersion/NONE)
    (for-each [^ProtocolVersion pv enabledProtocols]

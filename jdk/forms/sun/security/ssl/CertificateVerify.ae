    (field ^:private ^:final ^SignatureScheme signatureScheme)

    (field ^:private ^:final ^byte/1 signature)

    (constructor :throws [IOException] [this ^HandshakeContext context
                                        ^X509Authentication$X509Possession x509Possession]
      (super. context)
      (let [^{:tag (Map$Entry SignatureScheme Signature)} schemeAndSigner
              (SignatureScheme/getSignerOfPreferableAlgorithm
                (.-sslConfig context)
                (.-algorithmConstraints context)
                (.-peerRequestedSignatureSchemes context)
                x509Possession
                (.-negotiatedProtocol context))]
        (when (nil? schemeAndSigner)
          (throw (.fatal (.-conContext context)
                         Alert/INTERNAL_ERROR
                         (java-str "No supported CertificateVerify signature algorithm for "
                                   (.getAlgorithm (.-popPrivateKey x509Possession))
                                   "  key"))))
        (set! (.-signatureScheme this) (cast SignatureScheme (.getKey schemeAndSigner)))
        (let [hashValue (.digest (.-handshakeHash context))
              ^:mutable ^byte/1 contentCovered nil]
          (if (.-isClientMode (.-sslConfig context))
              (do
                (set! contentCovered
                      (Arrays/copyOf clientSignHead
                                     (unchecked-add-int
                                       (alength clientSignHead)
                                       (alength hashValue))))
                (System/arraycopy hashValue
                                  0
                                  contentCovered
                                  (alength clientSignHead)
                                  (alength hashValue)))
              (do
                (set! contentCovered
                      (Arrays/copyOf serverSignHead
                                     (unchecked-add-int
                                       (alength serverSignHead)
                                       (alength hashValue))))
                (System/arraycopy hashValue
                                  0
                                  contentCovered
                                  (alength serverSignHead)
                                  (alength hashValue))))
          (let [^:mutable ^byte/1 temporary nil]
            (try
              (let [signer (cast Signature (.getValue schemeAndSigner))]
                (.update signer contentCovered)
                (set! temporary (.sign signer)))
              (catch SignatureException ikse
                (throw (.fatal (.-conContext context)
                               Alert/HANDSHAKE_FAILURE
                               "Cannot produce CertificateVerify signature"
                               ikse))))
            (set! (.-signature this) temporary)))))

    (constructor :throws [IOException] [this ^HandshakeContext context ^ByteBuffer m]
      (super. context)
      (when (< (.remaining m) 4)
        (throw (.fatal (.-conContext context)
                       Alert/ILLEGAL_PARAMETER
                       "Invalid CertificateVerify message: no sufficient data")))
      (let [ssid (Record/getInt16 m)]
        (set! (.-signatureScheme this) (SignatureScheme/valueOf ssid))
        (when (nil? signatureScheme)
          (throw (.fatal (.-conContext context)
                         Alert/HANDSHAKE_FAILURE
                         (java-str "Invalid signature algorithm ("
                                   ssid
                                   ") used in CertificateVerify handshake message"))))
        (when-not (.contains (.-localSupportedSignAlgs context) signatureScheme)
          (throw (.fatal (.-conContext context)
                         Alert/HANDSHAKE_FAILURE
                         (java-str "Unsupported signature algorithm ("
                                   (.-name signatureScheme)
                                   ") used in CertificateVerify handshake message"))))
        (let [^:mutable ^X509Authentication$X509Credentials x509Credentials nil]
          (for-each [^SSLCredentials cd (.-handshakeCredentials context)]
            (when (instance? X509Authentication$X509Credentials cd)
              (set! x509Credentials (cast X509Authentication$X509Credentials cd))
              (break)))
          (when (or (nil? x509Credentials) (nil? (.-popPublicKey x509Credentials)))
            (throw (.fatal (.-conContext context)
                           Alert/HANDSHAKE_FAILURE
                           "No X509 credentials negotiated for CertificateVerify")))
          (set! (.-signature this) (Record/getBytes16 m))
          (let [hashValue (.digest (.-handshakeHash context))
                ^:mutable ^byte/1 contentCovered nil]
            (if (.-isClientMode (.-sslConfig context))
                (do
                  (set! contentCovered
                        (Arrays/copyOf serverSignHead
                                       (unchecked-add-int
                                         (alength serverSignHead)
                                         (alength hashValue))))
                  (System/arraycopy hashValue
                                    0
                                    contentCovered
                                    (alength serverSignHead)
                                    (alength hashValue)))
                (do
                  (set! contentCovered
                        (Arrays/copyOf clientSignHead
                                       (unchecked-add-int
                                         (alength clientSignHead)
                                         (alength hashValue))))
                  (System/arraycopy hashValue
                                    0
                                    contentCovered
                                    (alength clientSignHead)
                                    (alength hashValue))))
            (try
              (let [signer (.getVerifier signatureScheme (.-popPublicKey x509Credentials))]
                (.update signer contentCovered)
                (when-not (.verify signer signature)
                  (throw (.fatal (.-conContext context)
                                 Alert/HANDSHAKE_FAILURE
                                 "Invalid CertificateVerify signature"))))
              (catch [NoSuchAlgorithmException InvalidAlgorithmParameterException] nsae
                (throw (.fatal (.-conContext context)
                               Alert/INTERNAL_ERROR
                               (java-str "Unsupported signature algorithm ("
                                         (.-name signatureScheme)
                                         ") used in CertificateVerify handshake message")
                               nsae)))
              (catch [InvalidKeyException SignatureException] ikse
                (throw (.fatal (.-conContext context)
                               Alert/HANDSHAKE_FAILURE
                               "Cannot verify CertificateVerify signature"
                               ikse))))))))

    (method ^:public handshakeType ^SSLHandshake [this]
      SSLHandshake/CERTIFICATE_VERIFY)

    (method ^:public messageLength ^int [this]
      (unchecked-add-int 4 (alength signature)))

    (method ^:public send :throws [IOException] ^void [this ^HandshakeOutStream hos]
      (.putInt16 hos (.-id signatureScheme))
      (.putBytes16 hos signature))

    (method ^:public toString ^String [this]
      (let [messageFormat (MessageFormat.
                            "\"CertificateVerify\": '{'\n  \"signature algorithm\": {0}\n  \"signature\": '{'\n{1}\n  '}'\n'}'"
                            Locale/ENGLISH)
            hexEncoder (HexDumpEncoder.)
            messageFields (new Object/1
                               [(.-name signatureScheme)
                                (Utilities/indent (.encodeBuffer hexEncoder signature) "    ")])]
        (.format messageFormat messageFields))))

  (defclass ^:private ^:static ^:final T13CertificateVerifyProducer
    :implements [HandshakeProducer]

    (constructor ^:private [this])

    (method ^:public produce :throws [IOException] ^byte/1 [this ^ConnectionContext context
                                                            ^SSLHandshake$HandshakeMessage message]
      (let [hc (cast HandshakeContext context)
            ^:mutable ^X509Authentication$X509Possession x509Possession nil]
        (for-each [^SSLPossession possession (.-handshakePossessions hc)]
          (when (instance? X509Authentication$X509Possession possession)
            (set! x509Possession (cast X509Authentication$X509Possession possession))
            (break)))
        (cond
          (or (nil? x509Possession) (nil? (.-popPrivateKey x509Possession)))
            (do
              (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake"))
                (SSLLogger/fine "No X.509 credentials negotiated for CertificateVerify"))
              nil)
          (.-isClientMode (.-sslConfig hc))
            (.onProduceCertificateVerify this (cast ClientHandshakeContext context) x509Possession)
          :else
            (.onProduceCertificateVerify this (cast ServerHandshakeContext context) x509Possession))))

    (method ^:private onProduceCertificateVerify :throws [IOException] ^byte/1 [this
                                                                                ^ServerHandshakeContext shc
                                                                                ^X509Authentication$X509Possession x509Possession]
      (let [cvm (T13CertificateVerifyMessage. shc x509Possession)]
        (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake"))
          (SSLLogger/fine "Produced server CertificateVerify handshake message" cvm))
        (.write cvm (.-handshakeOutput shc))
        (.flush (.-handshakeOutput shc))
        nil))

    (method ^:private onProduceCertificateVerify :throws [IOException] ^byte/1 [this
                                                                                ^ClientHandshakeContext chc
                                                                                ^X509Authentication$X509Possession x509Possession]
      (let [cvm (T13CertificateVerifyMessage. chc x509Possession)]
        (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake"))
          (SSLLogger/fine "Produced client CertificateVerify handshake message" cvm))
        (.write cvm (.-handshakeOutput chc))
        (.flush (.-handshakeOutput chc))
        nil)))

  (defclass ^:private ^:static ^:final T13CertificateVerifyConsumer
    :implements [SSLConsumer]

    (constructor ^:private [this])

    (method ^:public consume :throws [IOException] ^void [this ^ConnectionContext context
                                                          ^ByteBuffer message]
      (let [hc (cast HandshakeContext context)]
        (.remove (.-handshakeConsumers hc) (.-id SSLHandshake/CERTIFICATE_VERIFY))
        (when (.containsKey (.-handshakeConsumers hc) (.-id SSLHandshake/CERTIFICATE))
          (throw (.fatal (.-conContext hc)
                         Alert/UNEXPECTED_MESSAGE
                         "Unexpected Certificate Verify handshake message")))
        (let [cvm (T13CertificateVerifyMessage. hc message)]
          (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake"))
            (SSLLogger/fine "Consuming CertificateVerify handshake message" cvm)))))))

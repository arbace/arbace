                defaultKeyStoreProvider (cast String (.get props "keyStoreProvider"))]
            (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,defaultctx"))
              (SSLLogger/fine (java-str "keyStore is : " defaultKeyStore))
              (SSLLogger/fine (java-str "keyStore type is : " defaultKeyStoreType))
              (SSLLogger/fine (java-str "keyStore provider is : " defaultKeyStoreProvider)))
            (when (and (.equals P11KEYSTORE defaultKeyStoreType)
                       (not (.equals NONE defaultKeyStore)))
              (throw (IllegalArgumentException.
                       (java-str (java-str (java-str "if keyStoreType is " P11KEYSTORE)
                                           ", then keyStore must be ")
                                 NONE))))
            (let [^:mutable ^FileInputStream fs nil
                  ^:mutable ^KeyStore ks nil
                  ^:mutable ^char/1 passwd nil]
              (try
                (when (and (not (.isEmpty defaultKeyStore)) (not (.equals NONE defaultKeyStore)))
                  (set! fs (FileInputStream. defaultKeyStore)))
                (let [defaultKeyStorePassword (cast String (.get props "keyStorePasswd"))]
                  (when-not (.isEmpty defaultKeyStorePassword)
                    (set! passwd (.toCharArray defaultKeyStorePassword)))
                  (when-not (== (.length defaultKeyStoreType) 0)
                    (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,defaultctx"))
                      (SSLLogger/finest "init keystore"))
                    (if (.isEmpty defaultKeyStoreProvider)
                        (set! ks (KeyStore/getInstance defaultKeyStoreType))
                        (set! ks (KeyStore/getInstance defaultKeyStoreType defaultKeyStoreProvider)))
                    (.load ks fs passwd)))
                (finally (when (some? fs) (.close fs) (set! fs nil))))
              (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,defaultctx"))
                (SSLLogger/fine
                  (java-str "init keymanager of type " (KeyManagerFactory/getDefaultAlgorithm))))
              (let [kmf (KeyManagerFactory/getInstance (KeyManagerFactory/getDefaultAlgorithm))]
                (if (.equals P11KEYSTORE defaultKeyStoreType)
                    (.init kmf ks nil)
                    (.init kmf ks passwd))
                (.getKeyManagers kmf)))))))

    (defclass ^:private ^:static ^:final DefaultSSLContextHolder
      (field ^:private ^:static ^:final ^SSLContextImpl sslContext)

      (field ^:private ^:static ^:final ^Exception reservedException)

      (static-initializer
        (let [^:mutable ^Exception reserved nil
              ^:mutable ^SSLContextImpl mediator nil]
          (if (some? DefaultManagersHolder/reservedException)
              (set! reserved DefaultManagersHolder/reservedException)
              (try
                (set! mediator (DefaultSSLContext.))
                (catch Exception e
                  (set! reserved (KeyManagementException. (.getMessage e)))
                  (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,defaultctx"))
                    (SSLLogger/warning "Failed to load default SSLContext" e)))))
          (set! sslContext mediator)
          (set! reservedException reserved))))

    (defclass ^:public ^:static ^:final DefaultSSLContext
      :extends CustomizedTLSContext

      (constructor :throws [Exception] ^:public [this]
        (when (some? DefaultManagersHolder/reservedException)
          (throw DefaultManagersHolder/reservedException))
        (try
          (.engineInit super
                       DefaultManagersHolder/keyManagers
                       DefaultManagersHolder/trustManagers
                       nil)
          (catch Exception e
            (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,defaultctx"))
              (SSLLogger/fine "default context init failed: " e))
            (throw e))))

      (method ^:protected engineInit :throws [KeyManagementException] ^void [this ^KeyManager/1 km
                                                                             ^TrustManager/1 tm
                                                                             ^SecureRandom sr]
        (throw (KeyManagementException. "Default SSLContext is initialized automatically")))

      (method ^:static getDefaultImpl :throws [Exception] ^SSLContextImpl []
        (when (some? DefaultSSLContextHolder/reservedException)
          (throw DefaultSSLContextHolder/reservedException))
        DefaultSSLContextHolder/sslContext))

    (defclass ^:private ^:abstract ^:static AbstractDTLSContext
      :extends SSLContextImpl

      (field ^:private ^:static ^:final ^{:tag (List ProtocolVersion)} supportedProtocols)

      (field ^:private ^:static ^:final ^{:tag (List ProtocolVersion)} serverDefaultProtocols)

      (field ^:private ^:static ^:final ^{:tag (List CipherSuite)} supportedCipherSuites)

      (field ^:private ^:static ^:final ^{:tag (List CipherSuite)} serverDefaultCipherSuites)

      (static-initializer
        (set! supportedProtocols
              (Arrays/asList
                (new ProtocolVersion/1 [ProtocolVersion/DTLS12 ProtocolVersion/DTLS10])))
        (set! serverDefaultProtocols
              (SSLContextImpl/getAvailableProtocols
                (new ProtocolVersion/1 [ProtocolVersion/DTLS12 ProtocolVersion/DTLS10])))
        (set! supportedCipherSuites
              (SSLContextImpl/getApplicableSupportedCipherSuites supportedProtocols))
        (set! serverDefaultCipherSuites
              (SSLContextImpl/getApplicableEnabledCipherSuites serverDefaultProtocols false)))

      (method ^:protected engineGetDefaultSSLParameters ^SSLParameters [this]
        (let [engine (.createSSLEngineImpl this)]
          (.setUseClientMode engine true)
          (.getSSLParameters engine)))

      (method ^:protected engineGetSupportedSSLParameters ^SSLParameters [this]
        (let [engine (.createSSLEngineImpl this)
              params (SSLParameters.)]
          (.setCipherSuites params (.getSupportedCipherSuites engine))
          (.setProtocols params (.getSupportedProtocols engine))
          params))

      (method getSupportedProtocolVersions ^{:tag (List ProtocolVersion)} [this]
        supportedProtocols)

      (method getSupportedCipherSuites ^{:tag (List CipherSuite)} [this]
        supportedCipherSuites)

      (method getServerDefaultProtocolVersions ^{:tag (List ProtocolVersion)} [this]
        serverDefaultProtocols)

      (method getServerDefaultCipherSuites ^{:tag (List CipherSuite)} [this]
        serverDefaultCipherSuites)

      (method createSSLEngineImpl ^SSLEngine [this] (SSLEngineImpl. this))

      (method createSSLEngineImpl ^SSLEngine [this ^String host ^int port]
        (SSLEngineImpl. this host port))

      (method isDTLS ^boolean [this] true))

    (defclass ^:public ^:static ^:final DTLS10Context
      :extends AbstractDTLSContext

      (field ^:private ^:static ^:final ^{:tag (List ProtocolVersion)} clientDefaultProtocols)

      (field ^:private ^:static ^:final ^{:tag (List CipherSuite)} clientDefaultCipherSuites)

      (static-initializer
        (set! clientDefaultProtocols
              (SSLContextImpl/getAvailableProtocols
                (new ProtocolVersion/1 [ProtocolVersion/DTLS10])))
        (set! clientDefaultCipherSuites
              (SSLContextImpl/getApplicableEnabledCipherSuites clientDefaultProtocols true)))

      (method getClientDefaultProtocolVersions ^{:tag (List ProtocolVersion)} [this]
        clientDefaultProtocols)

      (method getClientDefaultCipherSuites ^{:tag (List CipherSuite)} [this]
        clientDefaultCipherSuites))

    (defclass ^:public ^:static ^:final DTLS12Context
      :extends AbstractDTLSContext

      (field ^:private ^:static ^:final ^{:tag (List ProtocolVersion)} clientDefaultProtocols)

      (field ^:private ^:static ^:final ^{:tag (List CipherSuite)} clientDefaultCipherSuites)

      (static-initializer
        (set! clientDefaultProtocols
              (SSLContextImpl/getAvailableProtocols
                (new ProtocolVersion/1 [ProtocolVersion/DTLS12 ProtocolVersion/DTLS10])))
        (set! clientDefaultCipherSuites
              (SSLContextImpl/getApplicableEnabledCipherSuites clientDefaultProtocols true)))

      (method getClientDefaultProtocolVersions ^{:tag (List ProtocolVersion)} [this]
        clientDefaultProtocols)

      (method getClientDefaultCipherSuites ^{:tag (List CipherSuite)} [this]
        clientDefaultCipherSuites))

    (defclass ^:private ^:static CustomizedDTLSContext
      :extends AbstractDTLSContext

      (field ^:private ^:static ^:final ^{:tag (List ProtocolVersion)} clientDefaultProtocols)

      (field ^:private ^:static ^:final ^{:tag (List ProtocolVersion)} serverDefaultProtocols)

      (field ^:private ^:static ^:final ^{:tag (List CipherSuite)} clientDefaultCipherSuites)

      (field ^:private ^:static ^:final ^{:tag (List CipherSuite)} serverDefaultCipherSuites)

      (field ^:private ^:static ^:final ^IllegalArgumentException reservedException)

      (static-initializer
        (set! reservedException CustomizedSSLProtocols/reservedException)
        (if (nil? reservedException)
            (do
              (set! clientDefaultProtocols
                    (CustomizedDTLSContext/customizedProtocols
                      true
                      CustomizedSSLProtocols/customizedClientProtocols))
              (set! serverDefaultProtocols
                    (CustomizedDTLSContext/customizedProtocols
                      false
                      CustomizedSSLProtocols/customizedServerProtocols))
              (set! clientDefaultCipherSuites
                    (SSLContextImpl/getApplicableEnabledCipherSuites clientDefaultProtocols true))
              (set! serverDefaultCipherSuites
                    (SSLContextImpl/getApplicableEnabledCipherSuites serverDefaultProtocols false)))
            (do
              (set! clientDefaultProtocols nil)
              (set! serverDefaultProtocols nil)
              (set! clientDefaultCipherSuites nil)
              (set! serverDefaultCipherSuites nil))))

      (method ^:private ^:static customizedProtocols ^{:tag (List ProtocolVersion)} [^boolean client
                                                                                     ^{:tag (List ProtocolVersion)} customized]
        (let [^{:tag (List ProtocolVersion)} refactored (ArrayList.)]
          (for-each [^ProtocolVersion pv customized] (when (.-isDTLS pv) (.add refactored pv)))
          (let [^:mutable ^ProtocolVersion/1 candidates nil]
            (if (.isEmpty refactored)
                (set! candidates
                      (new ProtocolVersion/1 [ProtocolVersion/DTLS12 ProtocolVersion/DTLS10]))
                (do
                  (set! candidates (new ProtocolVersion/1 (.size customized)))
                  (set! candidates (cast ProtocolVersion/1 (.toArray refactored candidates)))))
            (SSLContextImpl/getAvailableProtocols candidates))))

      (constructor ^:protected [this]
        (when (some? reservedException) (throw reservedException)))

      (method getClientDefaultProtocolVersions ^{:tag (List ProtocolVersion)} [this]
        clientDefaultProtocols)

      (method getServerDefaultProtocolVersions ^{:tag (List ProtocolVersion)} [this]
        serverDefaultProtocols)

      (method getClientDefaultCipherSuites ^{:tag (List CipherSuite)} [this]
        clientDefaultCipherSuites)

      (method getServerDefaultCipherSuites ^{:tag (List CipherSuite)} [this]
        serverDefaultCipherSuites))

    (defclass ^:public ^:static ^:final DTLSContext
      :extends CustomizedDTLSContext))

  (defclass ^:final AbstractTrustManagerWrapper
    :extends X509ExtendedTrustManager
    :implements [X509TrustManager]

    (field ^:private ^:final ^X509TrustManager tm)

    (constructor [this ^X509TrustManager tm] (set! (.-tm this) tm))

    (method ^:public checkClientTrusted :throws [CertificateException] ^void [this
                                                                              ^X509Certificate/1 chain
                                                                              ^String authType]
      (.checkClientTrusted tm chain authType))

    (method ^:public checkServerTrusted :throws [CertificateException] ^void [this
                                                                              ^X509Certificate/1 chain
                                                                              ^String authType]
      (.checkServerTrusted tm chain authType))

    (method ^:public getAcceptedIssuers ^X509Certificate/1 [this]
      (.getAcceptedIssuers tm))

    (method ^:public checkClientTrusted :throws [CertificateException] ^void [this
                                                                              ^X509Certificate/1 chain
                                                                              ^String authType
                                                                              ^Socket socket]
      (.checkClientTrusted tm chain authType)
      (.checkAdditionalTrust this chain authType socket true))

    (method ^:public checkServerTrusted :throws [CertificateException] ^void [this
                                                                              ^X509Certificate/1 chain
                                                                              ^String authType
                                                                              ^Socket socket]
      (.checkServerTrusted tm chain authType)
      (.checkAdditionalTrust this chain authType socket false))

    (method ^:public checkClientTrusted :throws [CertificateException] ^void [this
                                                                              ^X509Certificate/1 chain
                                                                              ^String authType
                                                                              ^SSLEngine engine]
      (.checkClientTrusted tm chain authType)
      (.checkAdditionalTrust this chain authType engine true))

    (method ^:public checkServerTrusted :throws [CertificateException] ^void [this
                                                                              ^X509Certificate/1 chain
                                                                              ^String authType
                                                                              ^SSLEngine engine]
      (.checkServerTrusted tm chain authType)
      (.checkAdditionalTrust this chain authType engine false))

    (method ^:private checkAdditionalTrust :throws [CertificateException] ^void [this
                                                                                 ^X509Certificate/1 chain
                                                                                 ^String authType
                                                                                 ^Socket socket
                                                                                 ^boolean checkClientTrusted]
      (when (and (some? socket) (.isConnected socket))
        (when-instance [^SSLSocket sslSocket socket]
          (let [session (.getHandshakeSession sslSocket)]
            (when (nil? session) (throw (CertificateException. "No handshake session")))
            (let [identityAlg (.getEndpointIdentificationAlgorithm (.getSSLParameters sslSocket))]
              (when (and (some? identityAlg) (not (.isEmpty identityAlg)))
                (X509TrustManagerImpl/checkIdentity session chain identityAlg checkClientTrusted))
              (let [^AlgorithmConstraints constraints (SSLAlgorithmConstraints/forSocket
                                                        sslSocket
                                                        SSLAlgorithmConstraints$SIGNATURE_CONSTRAINTS_MODE/LOCAL
                                                        true)]
                (.checkAlgorithmConstraints this chain constraints checkClientTrusted)))))))

    (method ^:private checkAdditionalTrust :throws [CertificateException] ^void [this
                                                                                 ^X509Certificate/1 chain
                                                                                 ^String authType
                                                                                 ^SSLEngine engine
                                                                                 ^boolean checkClientTrusted]
      (when (some? engine)
        (let [session (.getHandshakeSession engine)]
          (when (nil? session) (throw (CertificateException. "No handshake session")))
          (let [identityAlg (.getEndpointIdentificationAlgorithm (.getSSLParameters engine))]
            (when (and (some? identityAlg) (not (.isEmpty identityAlg)))
              (X509TrustManagerImpl/checkIdentity session chain identityAlg checkClientTrusted))
            (let [^AlgorithmConstraints constraints (SSLAlgorithmConstraints/forEngine
                                                      engine
                                                      SSLAlgorithmConstraints$SIGNATURE_CONSTRAINTS_MODE/LOCAL
                                                      true)]
              (.checkAlgorithmConstraints this chain constraints checkClientTrusted))))))

    (method ^:private checkAlgorithmConstraints :throws [CertificateException] ^void [this
                                                                                      ^X509Certificate/1 chain
                                                                                      ^AlgorithmConstraints constraints
                                                                                      ^boolean checkClientTrusted]
      (try
        (let [^:mutable checkedLength (unchecked-subtract-int (alength chain) 1)
              ^{:tag (Collection X509Certificate)} trustedCerts (HashSet.)
              certs (.getAcceptedIssuers tm)]
          (when (and (some? certs) (> (alength certs) 0)) (Collections/addAll trustedCerts certs))
          (when (.contains trustedCerts (aget chain checkedLength))
            (set! checkedLength (unchecked-dec-int checkedLength)))
          (when (>= checkedLength 0)
            (let [checker (AlgorithmChecker. constraints
                                             ^String (if checkClientTrusted
                                                         Validator/VAR_TLS_CLIENT
                                                         Validator/VAR_TLS_SERVER))]
              (.init checker false)
              (loop [^int i checkedLength]
                (when (>= i 0)
                  (let [cert (aget chain i)]
                    (.check checker cert (Collections/emptySet))
                    (recur (unchecked-dec-int i))))))))
        (catch CertPathValidatorException cpve
          (throw
            (CertificateException. "Certificates do not conform to algorithm constraints" cpve))))))


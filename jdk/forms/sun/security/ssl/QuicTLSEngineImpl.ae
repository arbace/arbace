  (method ^:public getDelegatedTask ^Runnable [this] nil)

  (method ^:public getPeerHost ^String [this] peerHost)

  (method ^:public getPeerPort ^int [this] peerPort)

  (method ^:public useDelegatedTask ^boolean [this] true)

  (method ^:public getLocalQuicTransportParameters ^byte/1 [this]
    (let [ltp localQuicTransportParameters]
      (when (some? ltp) (let [result (new byte/1 (.remaining ltp))] (.get ltp 0 result) result))))

  (method ^:public setLocalQuicTransportParameters ^void [this ^ByteBuffer params]
    (set! (.-localQuicTransportParameters this) params))

  (method ^:public restartHandshake :throws [IOException] ^void [this]
    (when (some? negotiatedVersion) (throw (IllegalStateException. "Version already negotiated")))
    (when (or (not (identical? sendKeySpace QuicTLSEngine$KeySpace/INITIAL))
              (not (identical? handshakeState QuicTLSEngine$HandshakeState/NEED_RECV_CRYPTO)))
      (throw (IllegalStateException. "Unexpected handshake state")))
    (let [context (.-handshakeContext conContext)
          chc (cast ClientHandshakeContext context)]
      (.finish (.-handshakeHash chc))
      (.reproduce (.-extensions (.-initialClientHelloMsg chc))
                  chc
                  (new SSLExtension/1
                       [SSLExtension/CH_QUIC_TRANSPORT_PARAMETERS SSLExtension/CH_PRE_SHARED_KEY]))
      (.write (.-initialClientHelloMsg chc) (.-handshakeOutput chc))
      (set! handshakeState QuicTLSEngine$HandshakeState/NEED_SEND_CRYPTO)))

  (method ^:public setRemoteQuicTransportParametersConsumer ^void [this
                                                                   ^QuicTransportParametersConsumer consumer]
    (set! (.-remoteQuicTransportParametersConsumer this) consumer))

  (method processRemoteQuicTransportParameters :throws [QuicTransportException] ^void [this
                                                                                       ^ByteBuffer buffer]
    (.accept remoteQuicTransportParametersConsumer buffer))

  (method ^:public tryMarkHandshakeDone ^boolean [this]
    (when (.getUseClientMode this)
      (throw (IllegalStateException. "Not expected to be called in client mode")))
    (let [confirmed
            ^boolean (^[QuicTLSEngineImpl QuicTLSEngine$HandshakeState QuicTLSEngine$HandshakeState] VarHandle/.compareAndSet
                       HANDSHAKE_STATE_HANDLE
                       this
                       QuicTLSEngine$HandshakeState/NEED_SEND_HANDSHAKE_DONE
                       QuicTLSEngine$HandshakeState/HANDSHAKE_CONFIRMED)]
      (when confirmed
        (when (SSLLogger/isOn)
          (SSLLogger/fine "QuicTLSEngine (server) marked handshake state as HANDSHAKE_CONFIRMED")))
      confirmed))

  (method ^:public tryReceiveHandshakeDone ^boolean [this]
    (let [isClient (.getUseClientMode this)]
      (when-not isClient
        (throw (IllegalStateException. "Not expected to receive HANDSHAKE_DONE in server mode")))
      (let [confirmed
              ^boolean (^[QuicTLSEngineImpl QuicTLSEngine$HandshakeState QuicTLSEngine$HandshakeState] VarHandle/.compareAndSet
                         HANDSHAKE_STATE_HANDLE
                         this
                         QuicTLSEngine$HandshakeState/NEED_RECV_HANDSHAKE_DONE
                         QuicTLSEngine$HandshakeState/HANDSHAKE_CONFIRMED)]
        (when confirmed
          (when (SSLLogger/isOn)
            (SSLLogger/fine
              "QuicTLSEngine (client) received HANDSHAKE_DONE, marking state as HANDSHAKE_DONE")))
        confirmed)))

  (method ^:public isTLSHandshakeComplete ^boolean [this]
    (let [isClient (.getUseClientMode this)
          hsState (.-handshakeState this)]
      (if isClient
          (or (identical? hsState QuicTLSEngine$HandshakeState/NEED_RECV_HANDSHAKE_DONE)
              (identical? hsState QuicTLSEngine$HandshakeState/HANDSHAKE_CONFIRMED))
          (identical? hsState QuicTLSEngine$HandshakeState/HANDSHAKE_CONFIRMED))))

  (method ^:public getOneRttKeyPhase :throws [QuicKeyUnavailableException] ^int [this]
    (.getKeyPhase (.getReadCipher (.-oneRttKeyManager this)))))

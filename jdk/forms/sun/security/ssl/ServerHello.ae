            (when-not (not (HandshakeContext/isNegotiable proposed (.-negotiatedProtocol shc) cs))
              (when (identical? (.-clientAuthType (.-sslConfig shc))
                                ClientAuthType/CLIENT_AUTH_REQUIRED)

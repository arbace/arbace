          (for-each [^CipherSuite cs legacySuites]
            (let [ke (SSLKeyExchange/valueOf (.-keyExchange cs) (.-negotiatedProtocol shc))]
              (when (some? ke)
                (let [hcds (.createPossessions ke shc)]
                  (when (and (some? hcds) (not (== (alength hcds) 0)))
                    (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake"))

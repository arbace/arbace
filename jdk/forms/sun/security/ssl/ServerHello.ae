                                                               ^ClientHello$ClientHelloMessage clientHello]
      (let [^:mutable ^{:tag (List CipherSuite)} preferred nil
            ^:mutable ^{:tag (List CipherSuite)} proposed nil]
        (if (.-preferLocalCipherSuites (.-sslConfig shc))
            (do
              (set! preferred (.-activeCipherSuites shc))
              (set! proposed (.-cipherSuites clientHello)))

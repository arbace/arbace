                                    (.-negotiatedProtocol shc))]
        (.produce (.-extensions hhrm) shc serverHelloExtensions)
        (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake"))
          (SSLLogger/fine "Reproduced HelloRetryRequest handshake message" hhrm))
        (let [hos (HandshakeOutStream. nil)] (.write hhrm hos) (.toByteArray hos)))))

  (defclass ^:private ^:static ^:final ServerHelloConsumer
    :implements [SSLConsumer]

    (constructor ^:private [this])

    (method ^:public consume :throws [IOException] ^void [this ^ConnectionContext context
                                                          ^ByteBuffer message]
      (let [chc (cast ClientHandshakeContext context)]
        (.remove (.-handshakeConsumers chc) (.-id SSLHandshake/SERVER_HELLO))
        (when-not (.isEmpty (.-handshakeConsumers chc))
          (.remove (.-handshakeConsumers chc) (.-id SSLHandshake/HELLO_VERIFY_REQUEST)))
        (when-not (.isEmpty (.-handshakeConsumers chc))
          (throw (.fatal (.-conContext chc)
                         Alert/UNEXPECTED_MESSAGE
                         "No more message expected before ServerHello is processed")))
        (let [shm (ServerHelloMessage. chc message)]
          (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake"))
            (SSLLogger/fine "Consuming ServerHello handshake message" shm))
          (if (.isHelloRetryRequest (.-serverRandom shm))
              (.onHelloRetryRequest this chc shm)
              (.onServerHello this chc shm)))))

    (method ^:private onHelloRetryRequest :throws [IOException] ^void [this
                                                                       ^ClientHandshakeContext chc
                                                                       ^ServerHelloMessage helloRetryRequest]
      (let [extTypes (new SSLExtension/1 [SSLExtension/HRR_SUPPORTED_VERSIONS])]
        (.consumeOnLoad (.-extensions helloRetryRequest) chc extTypes)
        (let [^:mutable ^ProtocolVersion serverVersion nil
              svs (cast SupportedVersionsExtension$SHSupportedVersionsSpec
                        (.get (.-handshakeExtensions chc) SSLExtension/HRR_SUPPORTED_VERSIONS))]
          (if (some? svs)
              (set! serverVersion (ProtocolVersion/valueOf (.-selectedVersion svs)))
              (set! serverVersion (.-serverVersion helloRetryRequest)))
          (when-not (.contains (.-activeProtocols chc) serverVersion)
            (throw (.fatal (.-conContext chc)
                           Alert/PROTOCOL_VERSION
                           (java-str "The server selected protocol version "
                                     serverVersion
                                     " is not accepted by client preferences "
                                     (.-activeProtocols chc)))))
          (when-not (.useTLS13PlusSpec serverVersion)
            (throw (.fatal (.-conContext chc)
                           Alert/PROTOCOL_VERSION
                           (java-str "Unexpected HelloRetryRequest for " (.-name serverVersion)))))
          (set! (.-negotiatedProtocol chc) serverVersion)
          (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake"))
            (SSLLogger/fine (java-str "Negotiated protocol version: " (.-name serverVersion))))
          (SignatureScheme/updateHandshakeLocalSupportedAlgs chc)
          (.clear (.-handshakePossessions chc))
          (if (.-isDTLS serverVersion)
              (.consume d13HrrHandshakeConsumer chc helloRetryRequest)
              (.consume t13HrrHandshakeConsumer chc helloRetryRequest)))))

    (method ^:private onServerHello :throws [IOException] ^void [this ^ClientHandshakeContext chc
                                                                 ^ServerHelloMessage serverHello]
      (let [extTypes (new SSLExtension/1 [SSLExtension/SH_SUPPORTED_VERSIONS])]
        (.consumeOnLoad (.-extensions serverHello) chc extTypes)
        (let [^:mutable ^ProtocolVersion serverVersion nil
              svs (cast SupportedVersionsExtension$SHSupportedVersionsSpec
                        (.get (.-handshakeExtensions chc) SSLExtension/SH_SUPPORTED_VERSIONS))]
          (if (some? svs)
              (set! serverVersion (ProtocolVersion/valueOf (.-selectedVersion svs)))
              (set! serverVersion (.-serverVersion serverHello)))
          (when-not (.contains (.-activeProtocols chc) serverVersion)
            (throw (.fatal (.-conContext chc)
                           Alert/PROTOCOL_VERSION
                           (java-str "The server selected protocol version "
                                     serverVersion
                                     " is not accepted by client preferences "
                                     (.-activeProtocols chc)))))
          (set! (.-negotiatedProtocol chc) serverVersion)
          (when-not (.-isNegotiated (.-conContext chc))
            (set! (.-protocolVersion (.-conContext chc)) (.-negotiatedProtocol chc))
            (.setVersion (.-outputRecord (.-conContext chc)) (.-negotiatedProtocol chc)))
          (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake"))
            (SSLLogger/fine (java-str "Negotiated protocol version: " (.-name serverVersion))))
          (SignatureScheme/updateHandshakeLocalSupportedAlgs chc)
          (when (.isVersionDowngrade (.-serverRandom serverHello) chc)
            (throw (.fatal (.-conContext chc)
                           Alert/ILLEGAL_PARAMETER
                           "A potential protocol version downgrade attack")))
          (cond
            (.-isDTLS serverVersion)
              (if (.useTLS13PlusSpec serverVersion)
                  (.consume d13HandshakeConsumer chc serverHello)
                  (do
                    (.clear (.-handshakePossessions chc))
                    (.consume d12HandshakeConsumer chc serverHello)))
            (.useTLS13PlusSpec serverVersion) (.consume t13HandshakeConsumer chc serverHello)
            :else
              (do
                (.clear (.-handshakePossessions chc))
                (.consume t12HandshakeConsumer chc serverHello)))))))

  (defclass ^:private ^:static ^:final T12ServerHelloConsumer
    :implements [HandshakeConsumer]

    (constructor ^:private [this])

    (method ^:public consume :throws [IOException] ^void [this ^ConnectionContext context
                                                          ^SSLHandshake$HandshakeMessage message]
      (let [chc (cast ClientHandshakeContext context)
            serverHello (cast ServerHelloMessage message)]
        (when-not (.isNegotiable chc (.-serverVersion serverHello))
          (throw (.fatal
                   (.-conContext chc)
                   Alert/PROTOCOL_VERSION
                   (java-str
                     "Server chose "
                     (.-serverVersion serverHello)
                     ", but that protocol version is not enabled or not supported by the client."))))
        (set! (.-negotiatedCipherSuite chc) (.-cipherSuite serverHello))
        (.determine (.-handshakeHash chc) (.-negotiatedProtocol chc) (.-negotiatedCipherSuite chc))
        (set! (.-serverHelloRandom chc) (.-serverRandom serverHello))
        (when (nil? (.-keyExchange (.-negotiatedCipherSuite chc)))
          (throw (.fatal (.-conContext chc)
                         Alert/PROTOCOL_VERSION
                         (java-str
                           "TLS 1.2 or prior version does not support the server cipher suite: "
                           (.-name (.-negotiatedCipherSuite chc))))))
        (let [^:mutable extTypes (new SSLExtension/1 [SSLExtension/SH_RENEGOTIATION_INFO])]
          (.consumeOnLoad (.-extensions serverHello) chc extTypes)
          (when (some? (.-resumingSession chc))
            (if (.equals (.-sessionId serverHello) (.getSessionId (.-resumingSession chc)))
                (let [sessionSuite (.getSuite (.-resumingSession chc))]
                  (when-not (identical? (.-negotiatedCipherSuite chc) sessionSuite)
                    (throw (.fatal (.-conContext chc)
                                   Alert/PROTOCOL_VERSION
                                   "Server returned wrong cipher suite for session")))
                  (let [sessionVersion (.getProtocolVersion (.-resumingSession chc))]
                    (when-not (identical? (.-negotiatedProtocol chc) sessionVersion)
                      (throw (.fatal (.-conContext chc)
                                     Alert/PROTOCOL_VERSION
                                     "Server resumed with wrong protocol version")))
                    (set! (.-isResumption chc) true)
                    (.setAsSessionResumption (.-resumingSession chc) true)
                    (set! (.-handshakeSession chc) (.-resumingSession chc))))
                (do
                  (.invalidate (.-resumingSession chc))
                  (set! (.-resumingSession chc) nil)
                  (set! (.-isResumption chc) false)
                  (when-not (.-enableSessionCreation (.-sslConfig chc))
                    (throw (.fatal (.-conContext chc)
                                   Alert/PROTOCOL_VERSION
                                   "New session creation is disabled"))))))
          (set! extTypes (.getEnabledExtensions (.-sslConfig chc) SSLHandshake/SERVER_HELLO))
          (.consumeOnLoad (.-extensions serverHello) chc extTypes)
          (when-not (.-isResumption chc)
            (when (some? (.-resumingSession chc))
              (.invalidate (.-resumingSession chc))
              (set! (.-resumingSession chc) nil))
            (when-not (.-enableSessionCreation (.-sslConfig chc))
              (throw (.fatal (.-conContext chc)
                             Alert/PROTOCOL_VERSION
                             "New session creation is disabled")))
            (if (and (== (.length (.-sessionId serverHello)) 0) (.-statelessResumption chc))
                (let [newId (SessionId. true (.getSecureRandom (.-sslContext chc)))]
                  (set! (.-handshakeSession chc)
                        (SSLSessionImpl. chc (.-negotiatedCipherSuite chc) newId))
                  (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake"))
                    (SSLLogger/fine (java-str "Locally assigned Session Id: " (.toString newId)))))
                (set! (.-handshakeSession chc)
                      (SSLSessionImpl. chc (.-negotiatedCipherSuite chc) (.-sessionId serverHello))))
            (.setMaximumPacketSize (.-handshakeSession chc) (.-maximumPacketSize (.-sslConfig chc))))
          (.setRandoms (.-handshakeSession chc) (.-clientHelloRandom chc) (.-serverHelloRandom chc))
          (.consumeOnTrade (.-extensions serverHello) chc extTypes)
          (if (.-isResumption chc)
              (let [kdg (SSLTrafficKeyDerivation/valueOf (.-negotiatedProtocol chc))]
                (if (nil? kdg)
                    (throw (.fatal (.-conContext chc)
                                   Alert/INTERNAL_ERROR
                                   (java-str "Not supported key derivation: "
                                             (.-negotiatedProtocol chc))))
                    (set! (.-handshakeKeyDerivation chc)
                          (.createKeyDerivation kdg chc (.getMasterSecret (.-resumingSession chc)))))
                (when (.-statelessResumption chc)
                  (.putIfAbsent (.-handshakeConsumers chc)
                                (.-id SSLHandshake/NEW_SESSION_TICKET)
                                SSLHandshake/NEW_SESSION_TICKET))
                (.putIfAbsent (.-consumers (.-conContext chc))
                              (.-id ContentType/CHANGE_CIPHER_SPEC)
                              ChangeCipherSpec/t10Consumer)
                (.put (.-handshakeConsumers chc) (.-id SSLHandshake/FINISHED) SSLHandshake/FINISHED))
              (let [ke (SSLKeyExchange/valueOf (.-keyExchange (.-negotiatedCipherSuite chc))
                                               (.-negotiatedProtocol chc))]
                (set! (.-handshakeKeyExchange chc) ke)
                (when (some? ke)
                  (for-each [^SSLHandshake handshake (.getRelatedHandshakers ke chc)]
                    (.put (.-handshakeConsumers chc) (.-id handshake) handshake)))
                (.put (.-handshakeConsumers chc)
                      (.-id SSLHandshake/SERVER_HELLO_DONE)
                      SSLHandshake/SERVER_HELLO_DONE)))))))

  (method ^:private ^:static setUpPskKD :throws [SSLHandshakeException] ^void [^HandshakeContext hc
                                                                               ^SecretKey psk]
    (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake"))
      (SSLLogger/fine "Using PSK to derive early secret"))
    (try
      (let [hashAlg (.-hashAlg (.-negotiatedCipherSuite hc))
            hkdf (KDF/getInstance (.-hkdfAlgorithm hashAlg))
            earlySecret (.deriveKey hkdf
                                    "TlsEarlySecret"
                                    (.extractOnly
                                      (.addSalt (.addIKM (HKDFParameterSpec/ofExtract) psk)
                                                (new byte/1 (.-hashLength hashAlg)))))]
        (set! (.-handshakeKeyDerivation hc) (SSLSecretDerivation. hc earlySecret)))
      (catch GeneralSecurityException gse
        (throw (SSLHandshakeException. "Could not generate secret" gse)))))

  (defclass ^:private ^:static ^:final T13ServerHelloConsumer
    :implements [HandshakeConsumer]

    (constructor ^:private [this])

    (method ^:public consume :throws [IOException] ^void [this ^ConnectionContext context
                                                          ^SSLHandshake$HandshakeMessage message]
      (let [chc (cast ClientHandshakeContext context)
            serverHello (cast ServerHelloMessage message)]
        (when-not (identical? (.-serverVersion serverHello) ProtocolVersion/TLS12)
          (throw (.fatal (.-conContext chc)
                         Alert/PROTOCOL_VERSION
                         "The ServerHello.legacy_version field is not TLS 1.2")))
        (set! (.-negotiatedCipherSuite chc) (.-cipherSuite serverHello))
        (.determine (.-handshakeHash chc) (.-negotiatedProtocol chc) (.-negotiatedCipherSuite chc))
        (set! (.-serverHelloRandom chc) (.-serverRandom serverHello))
        (let [extTypes (.getEnabledExtensions (.-sslConfig chc) SSLHandshake/SERVER_HELLO)]
          (.consumeOnLoad (.-extensions serverHello) chc extTypes)
          (if (not (.-isResumption chc))
              (do
                (when (some? (.-resumingSession chc))
                  (.invalidate (.-resumingSession chc))
                  (set! (.-resumingSession chc) nil))
                (when-not (.-enableSessionCreation (.-sslConfig chc))
                  (throw (.fatal (.-conContext chc)
                                 Alert/PROTOCOL_VERSION
                                 "New session creation is disabled")))
                (set! (.-handshakeSession chc)
                      (SSLSessionImpl. chc (.-negotiatedCipherSuite chc) (.-sessionId serverHello)))
                (.setMaximumPacketSize (.-handshakeSession chc)
                                       (.-maximumPacketSize (.-sslConfig chc))))
              (let [psk (.consumePreSharedKey (.-resumingSession chc))]
                (when (nil? psk)
                  (throw (.fatal (.-conContext chc)
                                 Alert/INTERNAL_ERROR
                                 "No PSK available. Unable to resume.")))
                (set! (.-handshakeSession chc) (.-resumingSession chc))
                (ServerHello/setUpPskKD chc psk)))
          (.consumeOnTrade (.-extensions serverHello) chc extTypes)
          (.update (.-handshakeHash chc))
          (let [ke (.-handshakeKeyExchange chc)]
            (when (nil? ke)
              (throw (.fatal (.-conContext chc) Alert/INTERNAL_ERROR "Not negotiated key shares")))
            (let [handshakeKD (.createKeyDerivation ke chc)
                  handshakeSecret (.deriveKey handshakeKD "TlsHandshakeSecret")
                  kdg (SSLTrafficKeyDerivation/valueOf (.-negotiatedProtocol chc))]
              (when (nil? kdg)
                (throw (.fatal (.-conContext chc)
                               Alert/INTERNAL_ERROR
                               (java-str "Not supported key derivation: "
                                         (.-negotiatedProtocol chc)))))
              (let [^SSLKeyDerivation secretKD (SSLSecretDerivation. chc handshakeSecret)
                    readSecret (.deriveKey secretKD "TlsServerHandshakeTrafficSecret")
                    readKD (.createKeyDerivation kdg chc readSecret)
                    readKey (.deriveKey readKD "TlsKey")
                    readIv (IvParameterSpec. (.deriveData readKD "TlsIv"))
                    ^:mutable ^SSLCipher$SSLReadCipher readCipher nil]
                (try
                  (set! readCipher
                        (.createReadCipher (.-bulkCipher (.-negotiatedCipherSuite chc))
                                           (Authenticator/valueOf (.-negotiatedProtocol chc))
                                           (.-negotiatedProtocol chc)
                                           readKey
                                           readIv
                                           (.getSecureRandom (.-sslContext chc))))
                  (catch GeneralSecurityException gse
                    (throw (.fatal (.-conContext chc)
                                   Alert/HANDSHAKE_FAILURE
                                   "Missing cipher algorithm"
                                   gse))))
                (when (nil? readCipher)
                  (throw (.fatal (.-conContext chc)
                                 Alert/ILLEGAL_PARAMETER
                                 (java-str "Illegal cipher suite ("
                                           (.-negotiatedCipherSuite chc)
                                           ") and protocol version ("
                                           (.-negotiatedProtocol chc)
                                           ")"))))
                (set! (.-baseReadSecret chc) readSecret)
                (.changeReadCiphers (.-inputRecord (.-conContext chc)) readCipher)
                (let [writeSecret (.deriveKey secretKD "TlsClientHandshakeTrafficSecret")
                      writeKD (.createKeyDerivation kdg chc writeSecret)
                      writeKey (.deriveKey writeKD "TlsKey")
                      writeIv (IvParameterSpec. (.deriveData writeKD "TlsIv"))
                      ^:mutable ^SSLCipher$SSLWriteCipher writeCipher nil]
                  (try
                    (set! writeCipher
                          (.createWriteCipher (.-bulkCipher (.-negotiatedCipherSuite chc))
                                              (Authenticator/valueOf (.-negotiatedProtocol chc))
                                              (.-negotiatedProtocol chc)
                                              writeKey
                                              writeIv
                                              (.getSecureRandom (.-sslContext chc))))
                    (catch GeneralSecurityException gse
                      (throw (.fatal (.-conContext chc)
                                     Alert/HANDSHAKE_FAILURE
                                     "Missing cipher algorithm"
                                     gse))))
                  (when (nil? writeCipher)
                    (throw (.fatal (.-conContext chc)
                                   Alert/ILLEGAL_PARAMETER
                                   (java-str "Illegal cipher suite ("
                                             (.-negotiatedCipherSuite chc)
                                             ") and protocol version ("
                                             (.-negotiatedProtocol chc)
                                             ")"))))
                  (set! (.-baseWriteSecret chc) writeSecret)
                  (.changeWriteCiphers (.-outputRecord (.-conContext chc))
                                       writeCipher
                                       (not (== (.length (.-sessionId serverHello)) 0)))
                  (set! (.-handshakeKeyDerivation chc) secretKD)
                  (when (.-isQuic (.-sslConfig chc))
                    (let [engine (cast QuicTLSEngineImpl (.-transport (.-conContext chc)))]
                      (try
                        (.deriveHandshakeKeys engine)
                        (catch IOException e
                          (throw (.fatal (.-conContext chc)
                                         Alert/HANDSHAKE_FAILURE
                                         "Failed to derive keys"
                                         e))))))
                  (.putIfAbsent (.-consumers (.-conContext chc))
                                (.-id ContentType/CHANGE_CIPHER_SPEC)
                                ChangeCipherSpec/t13Consumer)
                  (.put (.-handshakeConsumers chc)
                        (.-id SSLHandshake/ENCRYPTED_EXTENSIONS)
                        SSLHandshake/ENCRYPTED_EXTENSIONS)
                  (.put (.-handshakeConsumers chc)
                        (.-id SSLHandshake/CERTIFICATE_REQUEST)
                        SSLHandshake/CERTIFICATE_REQUEST)
                  (.put (.-handshakeConsumers chc)
                        (.-id SSLHandshake/CERTIFICATE)
                        SSLHandshake/CERTIFICATE)
                  (.put (.-handshakeConsumers chc)
                        (.-id SSLHandshake/CERTIFICATE_VERIFY)
                        SSLHandshake/CERTIFICATE_VERIFY)
                  (.put (.-handshakeConsumers chc)
                        (.-id SSLHandshake/FINISHED)
                        SSLHandshake/FINISHED)))))))))

  (defclass ^:private ^:static ^:final T13HelloRetryRequestConsumer
    :implements [HandshakeConsumer]

    (constructor ^:private [this])

    (method ^:public consume :throws [IOException] ^void [this ^ConnectionContext context
                                                          ^SSLHandshake$HandshakeMessage message]
      (let [chc (cast ClientHandshakeContext context)
            helloRetryRequest (cast ServerHelloMessage message)]
        (when-not (identical? (.-serverVersion helloRetryRequest) ProtocolVersion/TLS12)
          (throw (.fatal (.-conContext chc)
                         Alert/PROTOCOL_VERSION
                         "The HelloRetryRequest.legacy_version is not TLS 1.2")))
        (set! (.-negotiatedCipherSuite chc) (.-cipherSuite helloRetryRequest))
        (let [extTypes (.getEnabledExtensions (.-sslConfig chc) SSLHandshake/HELLO_RETRY_REQUEST)]
          (.consumeOnLoad (.-extensions helloRetryRequest) chc extTypes)
          (.consumeOnTrade (.-extensions helloRetryRequest) chc extTypes)
          (.finish (.-handshakeHash chc))
          (let [hos (HandshakeOutStream. nil)]
            (try
              (.write (.-initialClientHelloMsg chc) hos)
              (catch IOException ioe
                (throw (.fatal (.-conContext chc)
                               Alert/HANDSHAKE_FAILURE
                               "Failed to construct message hash"
                               ioe))))
            (.deliver (.-handshakeHash chc) (.toByteArray hos))
            (.determine (.-handshakeHash chc)
                        (.-negotiatedProtocol chc)
                        (.-negotiatedCipherSuite chc))
            (let [clientHelloHash (.digest (.-handshakeHash chc))
                  hashLen (.-hashLength (.-hashAlg (.-negotiatedCipherSuite chc)))
                  hashedClientHello (new byte/1 (unchecked-add-int 4 hashLen))]
              (aset hashedClientHello 0 (.-id SSLHandshake/MESSAGE_HASH))
              (aset hashedClientHello 1 (unchecked-byte 0x00))
              (aset hashedClientHello 2 (unchecked-byte 0x00))
              (aset hashedClientHello 3 (unchecked-byte (bit-and-int hashLen 0xFF)))
              (System/arraycopy clientHelloHash 0 hashedClientHello 4 hashLen)
              (.finish (.-handshakeHash chc))
              (.deliver (.-handshakeHash chc) hashedClientHello)
              (let [hrrBodyLen (.remaining (.-handshakeRecord helloRetryRequest))
                    hrrMessage (new byte/1 (unchecked-add-int 4 hrrBodyLen))]
                (aset hrrMessage 0 (.-id SSLHandshake/HELLO_RETRY_REQUEST))
                (aset hrrMessage
                      1
                      (unchecked-byte (bit-and-int (bit-shift-right-int hrrBodyLen 16) 0xFF)))
                (aset hrrMessage
                      2
                      (unchecked-byte (bit-and-int (bit-shift-right-int hrrBodyLen 8) 0xFF)))
                (aset hrrMessage 3 (unchecked-byte (bit-and-int hrrBodyLen 0xFF)))
                (let [hrrBody (.duplicate (.-handshakeRecord helloRetryRequest))]
                  (.get hrrBody hrrMessage 4 hrrBodyLen)
                  (.receive (.-handshakeHash chc) hrrMessage)
                  (.reproduce (.-extensions (.-initialClientHelloMsg chc))
                              chc
                              (new SSLExtension/1
                                   [SSLExtension/CH_COOKIE
                                    SSLExtension/CH_KEY_SHARE
                                    SSLExtension/CH_PRE_SHARED_KEY]))
                  (.produce SSLHandshake/CLIENT_HELLO context helloRetryRequest))))))))))

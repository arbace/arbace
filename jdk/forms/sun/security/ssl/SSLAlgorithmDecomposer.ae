(in-ns 'sun.security.ssl)

(import '(java.util HashSet Set)
        '(sun.security.util AlgorithmDecomposer))

(defclass SSLAlgorithmDecomposer
  :extends AlgorithmDecomposer

  (field ^:private ^:final ^boolean onlyX509)

  (constructor [this ^boolean onlyX509] (set! (.-onlyX509 this) onlyX509))

  (constructor [this] (this. false))

  (method ^:private decomposes ^{:tag (Set String)} [this ^CipherSuite$KeyExchange keyExchange]
    (let [^{:tag (Set String)} components (HashSet.)]
      (switch keyExchange
        K_NULL (when-not onlyX509 (.add components "K_NULL"))
        K_RSA (.add components "RSA")
        K_RSA_EXPORT (do (.add components "RSA") (.add components "RSA_EXPORT"))
        K_DH_RSA
          (do
            (.add components "RSA")
            (.add components "DH")
            (.add components "DiffieHellman")
            (.add components "DH_RSA"))
        K_DH_DSS
          (do
            (.add components "DSA")
            (.add components "DSS")
            (.add components "DH")
            (.add components "DiffieHellman")
            (.add components "DH_DSS"))
        K_DHE_DSS
          (do
            (.add components "DSA")
            (.add components "DSS")
            (.add components "DH")
            (.add components "DHE")
            (.add components "DiffieHellman")
            (.add components "DHE_DSS"))
        K_DHE_RSA
          (do
            (.add components "RSA")
            (.add components "DH")
            (.add components "DHE")
            (.add components "DiffieHellman")
            (.add components "DHE_RSA"))
        K_DH_ANON
          (when-not onlyX509
            (.add components "ANON")
            (.add components "DH")
            (.add components "DiffieHellman")
            (.add components "DH_ANON"))
        K_ECDH_ECDSA
          (do (.add components "ECDH") (.add components "ECDSA") (.add components "ECDH_ECDSA"))
        K_ECDH_RSA
          (do (.add components "ECDH") (.add components "RSA") (.add components "ECDH_RSA"))
        K_ECDHE_ECDSA
          (do (.add components "ECDHE") (.add components "ECDSA") (.add components "ECDHE_ECDSA"))
        K_ECDHE_RSA
          (do (.add components "ECDHE") (.add components "RSA") (.add components "ECDHE_RSA"))
        K_ECDH_ANON
          (when-not onlyX509
            (.add components "ECDH")
            (.add components "ANON")
            (.add components "ECDH_ANON"))
        nil)
      components))

  (method ^:private decomposes ^{:tag (Set String)} [this ^SSLCipher bulkCipher]
    (let [^{:tag (Set String)} components (HashSet.)]
      (when (some? (.-transformation bulkCipher))
        (.addAll components (.decompose super (.-transformation bulkCipher))))
      (switch bulkCipher
        B_NULL (.add components "C_NULL")
        B_RC2_40 (.add components "RC2_CBC_40")
        B_RC4_40 (.add components "RC4_40")
        B_RC4_128 (.add components "RC4_128")
        B_DES_40 (do (.add components "DES40_CBC") (.add components "DES_CBC_40"))
        B_DES (.add components "DES_CBC")
        B_3DES (.add components "3DES_EDE_CBC")
        B_AES_128 (.add components "AES_128_CBC")
        B_AES_256 (.add components "AES_256_CBC")
        B_AES_128_GCM (.add components "AES_128_GCM")
        B_AES_256_GCM (.add components "AES_256_GCM"))
      components))

  (method ^:private decomposes ^{:tag (Set String)} [this ^CipherSuite$MacAlg macAlg
                                                     ^SSLCipher cipher]
    (let [^{:tag (Set String)} components (HashSet.)]
      (cond
        (and (identical? macAlg CipherSuite$MacAlg/M_NULL)
             (not (identical? (.-cipherType cipher) CipherType/AEAD_CIPHER)))
          (.add components "M_NULL")
        (identical? macAlg CipherSuite$MacAlg/M_MD5)
          (do (.add components "MD5") (.add components "HmacMD5"))
        (identical? macAlg CipherSuite$MacAlg/M_SHA)
          (do (.add components "SHA1") (.add components "SHA-1") (.add components "HmacSHA1"))
        (identical? macAlg CipherSuite$MacAlg/M_SHA256)
          (do (.add components "SHA256") (.add components "SHA-256") (.add components "HmacSHA256"))
        :else
          (when (identical? macAlg CipherSuite$MacAlg/M_SHA384)
            (.add components "SHA384")
            (.add components "SHA-384")
            (.add components "HmacSHA384")))
      components))

  (method ^:private decomposes ^{:tag (Set String)} [this ^CipherSuite$HashAlg hashAlg]
    (let [^{:tag (Set String)} components (HashSet.)]
      (if (identical? hashAlg CipherSuite$HashAlg/H_SHA256)
          (do (.add components "SHA256") (.add components "SHA-256") (.add components "HmacSHA256"))
          (when (identical? hashAlg CipherSuite$HashAlg/H_SHA384)
            (.add components "SHA384")
            (.add components "SHA-384")
            (.add components "HmacSHA384")))
      components))

  (method ^:private decompose ^{:tag (Set String)} [this ^CipherSuite$KeyExchange keyExchange
                                                    ^SSLCipher cipher ^CipherSuite$MacAlg macAlg
                                                    ^CipherSuite$HashAlg hashAlg]
    (let [^{:tag (Set String)} components (HashSet.)]
      (when (some? keyExchange) (.addAll components (.decomposes this keyExchange)))
      (if onlyX509
          components
          (do
            (when (some? cipher) (.addAll components (.decomposes this cipher)))
            (when (some? macAlg) (.addAll components (.decomposes this macAlg cipher)))
            (when (some? hashAlg) (.addAll components (.decomposes this hashAlg)))
            components))))

  (method ^:public decompose ^{:tag (Set String)} [this ^String algorithm]
    (when (or (.startsWith algorithm "SSL_") (.startsWith algorithm "TLS_"))
      (let [^:mutable ^CipherSuite cipherSuite nil]
        (try (set! cipherSuite (CipherSuite/nameOf algorithm)) (catch IllegalArgumentException iae))
        (when (and (some? cipherSuite)
                   (not (identical? cipherSuite CipherSuite/TLS_EMPTY_RENEGOTIATION_INFO_SCSV)))
          (return (.decompose this
                              (.-keyExchange cipherSuite)
                              (.-bulkCipher cipherSuite)
                              (.-macAlg cipherSuite)
                              (.-hashAlg cipherSuite))))))
    (.decompose super algorithm)))

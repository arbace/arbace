  (method ^:public setUseClientMode ^void [this ^boolean mode]
    (.lock engineLock)
    (try (.setUseClientMode conContext mode) (finally (.unlock engineLock))))

  (method ^:public getUseClientMode ^boolean [this]
    (.lock engineLock)
    (try (.-isClientMode (.-sslConfig conContext)) (finally (.unlock engineLock))))

  (method ^:public setNeedClientAuth ^void [this ^boolean need]
    (.lock engineLock)
    (try
      (set! (.-clientAuthType (.-sslConfig conContext))
            (if need ClientAuthType/CLIENT_AUTH_REQUIRED ClientAuthType/CLIENT_AUTH_NONE))
      (finally (.unlock engineLock))))

  (method ^:public getNeedClientAuth ^boolean [this]
    (.lock engineLock)
    (try
      (identical? (.-clientAuthType (.-sslConfig conContext)) ClientAuthType/CLIENT_AUTH_REQUIRED)
      (finally (.unlock engineLock))))

  (method ^:public setWantClientAuth ^void [this ^boolean want]
    (.lock engineLock)
    (try
      (set! (.-clientAuthType (.-sslConfig conContext))
            (if want ClientAuthType/CLIENT_AUTH_REQUESTED ClientAuthType/CLIENT_AUTH_NONE))
      (finally (.unlock engineLock))))

  (method ^:public getWantClientAuth ^boolean [this]
    (.lock engineLock)
    (try
      (identical? (.-clientAuthType (.-sslConfig conContext)) ClientAuthType/CLIENT_AUTH_REQUESTED)
      (finally (.unlock engineLock))))

  (method ^:public setEnableSessionCreation ^void [this ^boolean flag]
    (.lock engineLock)
    (try
      (set! (.-enableSessionCreation (.-sslConfig conContext)) flag)
      (finally (.unlock engineLock))))

  (method ^:public getEnableSessionCreation ^boolean [this]
    (.lock engineLock)
    (try (.-enableSessionCreation (.-sslConfig conContext)) (finally (.unlock engineLock))))

  (method ^:public getSSLParameters ^SSLParameters [this]
    (.lock engineLock)
    (try (.getSSLParameters (.-sslConfig conContext)) (finally (.unlock engineLock))))

  (method ^:public setSSLParameters ^void [this ^SSLParameters params]
    (.lock engineLock)
    (try
      (.setSSLParameters (.-sslConfig conContext) params)
      (when-not (== (.-maximumPacketSize (.-sslConfig conContext)) 0)
        (.changePacketSize (.-outputRecord conContext)
                           (.-maximumPacketSize (.-sslConfig conContext))))
      (finally (.unlock engineLock))))

  (method ^:public getApplicationProtocol ^String [this]
    (.lock engineLock)
    (try (.-applicationProtocol conContext) (finally (.unlock engineLock))))

  (method ^:public getHandshakeApplicationProtocol ^String [this]
    (.lock engineLock)
    (try
      (when (some? (.-handshakeContext conContext))
        (.-applicationProtocol (.-handshakeContext conContext)))
      (finally (.unlock engineLock))))

  (method ^:public setHandshakeApplicationProtocolSelector ^void [this
                                                                  ^{:tag (BiFunction SSLEngine (List String) String)} selector]
    (.lock engineLock)
    (try
      (set! (.-engineAPSelector (.-sslConfig conContext)) selector)
      (finally (.unlock engineLock))))

  (method ^:public getHandshakeApplicationProtocolSelector ^{:tag (BiFunction SSLEngine (List String) String)} [this]
    (.lock engineLock)
    (try (.-engineAPSelector (.-sslConfig conContext)) (finally (.unlock engineLock))))

  (method ^:public useDelegatedTask ^boolean [this] true)

  (method ^:public toString ^String [this]
    (java-str "SSLEngine[hostname="
              (.getPeerHost this)
              ", port="
              (.getPeerPort this)
              ", "
              (.-conSession conContext)
              "]"))

  (method ^:private checkTaskThrown :throws [SSLException] ^void [this]
    (let [^:mutable ^Exception exc nil]
      (.lock engineLock)
      (try
        (let [hc (.-handshakeContext conContext)]
          (when (and (some? hc) (some? (.-delegatedThrown hc)))
            (set! exc (.-delegatedThrown hc))
            (set! (.-delegatedThrown hc) nil))
          (when (some? (.-delegatedThrown conContext))
            (if (some? exc)
                (when (identical? (.-delegatedThrown conContext) exc)
                  (set! (.-delegatedThrown conContext) nil))
                (do
                  (set! exc (.-delegatedThrown conContext))
                  (set! (.-delegatedThrown conContext) nil)))))
        (finally (.unlock engineLock)))
      (when (some? exc)
        (cond
          (instance? SSLException exc) (throw (cast SSLException exc))
          (instance? RuntimeException exc) (throw (cast RuntimeException exc))
          :else (throw (SSLEngineImpl/getTaskThrown exc))))))

  (method ^:private ^:static getTaskThrown ^SSLException [^Exception taskThrown]
    (let [^:mutable msg (.getMessage taskThrown)]
      (when (nil? msg) (set! msg "Delegated task threw Exception or Error"))
      (cond
        (instance? RuntimeException taskThrown) (throw (RuntimeException. msg taskThrown))
        (instance? SSLHandshakeException taskThrown) (SSLHandshakeException. msg taskThrown)
        (instance? SSLKeyException taskThrown) (SSLKeyException. msg taskThrown)
        (instance? SSLPeerUnverifiedException taskThrown)
          (SSLPeerUnverifiedException. msg taskThrown)
        (instance? SSLProtocolException taskThrown) (SSLProtocolException. msg taskThrown)
        (instance? SSLException taskThrown) (cast SSLException taskThrown)
        :else (SSLException. msg taskThrown))))

  (defclass ^:private ^:static DelegatedTask
    :implements [Runnable]

    (field ^:private ^:final ^SSLEngineImpl engine)

    (constructor [this ^SSLEngineImpl engineInstance]
      (set! (.-engine this) engineInstance))

    (method ^:public run ^void [this]
      (.lock (.-engineLock engine))
      (try
        (let [^:mutable hc (.-handshakeContext (.-conContext engine))]
          (when-not (or (nil? hc) (.isEmpty (.-delegatedActions hc)))
            (try
              (while (not (.isEmpty (.-delegatedActions hc)))
                (let [^{:tag (Map$Entry Byte ByteBuffer)} me (cast
                                                               Map$Entry
                                                               (.poll (.-delegatedActions hc)))]
                  (when (some? me)
                    (try
                      (.dispatch hc
                                 (.byteValue (cast Byte (.getKey me)))
                                 (cast ByteBuffer (.getValue me)))
                      (catch Exception e
                        (throw (.fatal (.-conContext hc)
                                       Alert/INTERNAL_ERROR
                                       "Unhandled exception"
                                       e)))))))
              (catch SSLException se
                (when (nil? (.-delegatedThrown (.-conContext engine)))
                  (set! (.-delegatedThrown (.-conContext engine)) se))
                (set! hc (.-handshakeContext (.-conContext engine)))
                (cond
                  (some? hc) (set! (.-delegatedThrown hc) se)
                  (some? (.-closeReason (.-conContext engine)))
                    (set! (.-closeReason (.-conContext engine)) (SSLEngineImpl/getTaskThrown se))))
              (catch RuntimeException rte
                (when (nil? (.-delegatedThrown (.-conContext engine)))
                  (set! (.-delegatedThrown (.-conContext engine)) rte))
                (set! hc (.-handshakeContext (.-conContext engine)))
                (cond
                  (some? hc) (set! (.-delegatedThrown hc) rte)
                  (some? (.-closeReason (.-conContext engine)))
                    (set! (.-closeReason (.-conContext engine)) rte))))
            (set! hc (.-handshakeContext (.-conContext engine)))
            (when (some? hc) (set! (.-taskDelegated hc) false))))
        (finally (.unlock (.-engineLock engine)))))))

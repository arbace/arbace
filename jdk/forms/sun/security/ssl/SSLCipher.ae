                (throw (RuntimeException. "invalid key or spec in AEAD mode" ikae))))
            (let [outputSize (.getOutputSize cipher (.remaining bb))
                  aad (.acquireAuthenticationBytes (.-authenticator this) contentType outputSize sn)]
              (.updateAAD cipher aad)
              (let [pos (.position bb)]
                (when (and (SSLLogger/isOn) (SSLLogger/isOn "plaintext"))
                  (SSLLogger/fine "Plaintext before ENCRYPTION" (.duplicate bb)))
                (let [dup (.duplicate bb)]
                  (when (> outputSize (.remaining bb))
                    (.limit bb (unchecked-add-int pos outputSize)))
                  (let [^:mutable ^int len 0]
                    (try
                      (set! len (.doFinal cipher dup bb))
                      (catch [IllegalBlockSizeException BadPaddingException ShortBufferException] ibse
                        (throw (RuntimeException.
                                 (java-str "Cipher error in AEAD mode in JCE provider "
                                           (.getName (.getProvider cipher)))
                                 ibse))))
                    (when-not (== len outputSize)
                      (throw (RuntimeException.
                               (java-str "Cipher buffering error in JCE provider "
                                         (.getName (.getProvider cipher))))))
                    (when (.-keyLimitEnabled this)
                      (set! (.-keyLimitCountdown this)
                            (unchecked-subtract (.-keyLimitCountdown this) len)))
                    len)))))))

      (method getExplicitNonceSize ^int [this] 0)

      (method calculateFragmentSize ^int [this ^int packetLimit ^int headerSize]
        (unchecked-subtract-int (unchecked-subtract-int packetLimit headerSize) tagSize))

      (method calculatePacketSize ^int [this ^int fragmentSize ^int headerSize]
        (unchecked-add-int (unchecked-add-int fragmentSize headerSize) tagSize))))

  (method ^:private ^:static addMac ^void [^Authenticator$MAC signer ^ByteBuffer destination
                                           ^byte contentType]
    (when-not (== (.-size (.macAlg signer)) 0)
      (let [dstContent (.position destination)
            hash (.compute signer contentType destination false)]
        (.limit destination (unchecked-add-int (.limit destination) (alength hash)))
        (.put destination hash)
        (.position destination dstContent))))

  (method ^:private ^:static checkStreamMac :throws [BadPaddingException] ^void [^Authenticator$MAC signer
                                                                                 ^ByteBuffer bb
                                                                                 ^byte contentType
                                                                                 ^byte/1 sequence]
    (let [tagLen (.-size (.macAlg signer))]
      (when-not (== tagLen 0)
        (let [contentLen (unchecked-subtract-int (.remaining bb) tagLen)]
          (when (< contentLen 0) (throw (BadPaddingException. "bad record")))
          (when (SSLCipher/checkMacTags contentType bb signer sequence false)
            (throw (BadPaddingException. "bad record MAC")))))))

  (method ^:private ^:static checkCBCMac :throws [BadPaddingException] ^void [^Authenticator$MAC signer
                                                                              ^ByteBuffer bb
                                                                              ^byte contentType
                                                                              ^int cipheredLength
                                                                              ^byte/1 sequence]
    (let [^:mutable ^BadPaddingException reservedBPE nil
          tagLen (.-size (.macAlg signer))
          pos (.position bb)]
      (when-not (== tagLen 0)
        (let [^:mutable contentLen (unchecked-subtract-int (.remaining bb) tagLen)]
          (when (< contentLen 0)
            (set! reservedBPE (BadPaddingException. "bad record"))
            (set! contentLen (unchecked-subtract-int cipheredLength tagLen))
            (.limit bb (unchecked-add-int pos cipheredLength)))
          (when (SSLCipher/checkMacTags contentType bb signer sequence false)
            (when (nil? reservedBPE) (set! reservedBPE (BadPaddingException. "bad record MAC"))))
          (let [^:mutable remainingLen (SSLCipher/calculateRemainingLen
                                         signer
                                         cipheredLength
                                         contentLen)]
            (set! remainingLen (unchecked-add-int remainingLen (.-size (.macAlg signer))))
            (let [temporary (ByteBuffer/allocate remainingLen)]
              (SSLCipher/checkMacTags contentType temporary signer sequence true)))))
      (when (some? reservedBPE) (throw reservedBPE))))

  (method ^:private ^:static checkMacTags ^boolean [^byte contentType ^ByteBuffer bb
                                                    ^Authenticator$MAC signer ^byte/1 sequence
                                                    ^boolean isSimulated]
    (let [tagLen (.-size (.macAlg signer))
          position (.position bb)
          lim (.limit bb)
          macOffset (unchecked-subtract-int lim tagLen)]
      (.limit bb macOffset)
      (let [hash (.compute signer contentType bb sequence isSimulated)]
        (when (or (nil? hash) (not (== tagLen (alength hash))))
          (throw (RuntimeException. "Internal MAC error")))
        (.position bb macOffset)
        (.limit bb lim)
        (try
          (let [results (SSLCipher/compareMacTags bb hash)] (not (== (aget results 0) 0)))
          (finally (.position bb position) (.limit bb macOffset))))))

  (method ^:private ^:static compareMacTags ^int/1 [^ByteBuffer bb ^byte/1 tag]
    (let [results (new int/1 [0 0])]
      (for-each [^byte t tag]
        (if (not (== (.get bb) t))
            (aset results 0 (unchecked-inc-int (aget results 0)))
            (aset results 1 (unchecked-inc-int (aget results 1)))))
      results))

  (method ^:private ^:static calculateRemainingLen ^int [^Authenticator$MAC signer
                                                         ^:mutable ^int fullLen
                                                         ^:mutable ^int usedLen]
    (let [blockLen (.-hashBlockSize (.macAlg signer))
          minimalPaddingLen (.-minimalPaddingSize (.macAlg signer))]
      (set! fullLen
            (unchecked-add-int fullLen
                               (unchecked-subtract-int
                                 13
                                 (unchecked-subtract-int blockLen minimalPaddingLen))))
      (set! usedLen
            (unchecked-add-int usedLen
                               (unchecked-subtract-int
                                 13
                                 (unchecked-subtract-int blockLen minimalPaddingLen))))
      (unchecked-add-int 0x01
                         (unchecked-multiply-int
                           (unchecked-int
                             (unchecked-subtract
                               (Math/ceil (unchecked-divide
                                            fullLen
                                            (unchecked-multiply 1.0 blockLen)))
                               (Math/ceil (unchecked-divide
                                            usedLen
                                            (unchecked-multiply 1.0 blockLen)))))
                           blockLen))))

  (method ^:private ^:static addPadding ^int [^ByteBuffer bb ^int blockSize]
    (let [len (.remaining bb)
          ^:mutable offset (.position bb)
          ^:mutable newlen (unchecked-add-int len 1)
          ^:mutable ^byte pad 0
          ^:mutable ^int i 0]
      (when-not (== (unchecked-remainder-int newlen blockSize) 0)
        (set! newlen (unchecked-add-int newlen (unchecked-subtract-int blockSize 1)))
        (set! newlen (unchecked-subtract-int newlen (unchecked-remainder-int newlen blockSize))))
      (set! pad (unchecked-byte (unchecked-subtract-int newlen len)))
      (.limit bb (unchecked-add-int newlen offset))
      (set! i 0)
      (set! offset (unchecked-add-int offset len))
      (while (< i pad)
        (.put bb offset (unchecked-byte (unchecked-subtract-int pad 1)))
        (set! offset (unchecked-inc-int offset))
        (set! i (unchecked-inc-int i)))
      (.position bb offset)
      (.limit bb offset)
      newlen))

  (method ^:private ^:static removePadding :throws [BadPaddingException] ^int [^ByteBuffer bb
                                                                               ^int tagLen
                                                                               ^int blockSize
                                                                               ^ProtocolVersion protocolVersion]
    (let [len (.remaining bb)
          offset (.position bb)
          padOffset (unchecked-subtract-int (unchecked-add-int offset len) 1)
          padLen (bit-and-int (.get bb padOffset) 0xFF)
          newLen (unchecked-subtract-int len (unchecked-add-int padLen 1))]
      (when (< (unchecked-subtract-int newLen tagLen) 0)
        (SSLCipher/checkPadding (.duplicate bb) (unchecked-byte (bit-and-int padLen 0xFF)))
        (throw (BadPaddingException. (java-str "Invalid Padding length: " padLen))))
      (let [results (SSLCipher/checkPadding
                      (.position (.duplicate bb) (unchecked-add-int offset newLen))
                      (unchecked-byte (bit-and-int padLen 0xFF)))]
        (cond
          (.useTLS10PlusSpec protocolVersion)
            (when-not (== (aget results 0) 0)
              (throw (BadPaddingException. "Invalid TLS padding data")))
          (> padLen blockSize)
            (throw (BadPaddingException.
                     (java-str "Padding length ("
                               padLen
                               ") of SSLv3 message should not be bigger than the block size ("
                               blockSize
                               ")"))))
        (.limit bb (unchecked-add-int offset newLen))
        newLen)))

  (method ^:private ^:static checkPadding ^int/1 [^ByteBuffer bb ^byte pad]
    (when-not (.hasRemaining bb) (throw (RuntimeException. "hasRemaining() must be positive")))
    (let [results (new int/1 [0 0])]
      (.mark bb)
      (let [^:mutable ^int i 0]
        (while (<= i 256)
          (while (and (.hasRemaining bb) (<= i 256))
            (if (not (== (.get bb) pad))
                (aset results 0 (unchecked-inc-int (aget results 0)))
                (aset results 1 (unchecked-inc-int (aget results 1))))
            (set! i (unchecked-inc-int i)))
          (.reset bb)))
      results)))

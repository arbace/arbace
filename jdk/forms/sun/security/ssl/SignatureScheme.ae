  (method ^:private ^:static getSupportedAlgorithms ^{:tag (List SignatureScheme)} [^SSLConfiguration config
                                                                                    ^SSLAlgorithmConstraints constraints
                                                                                    ^{:tag (List ProtocolVersion)} activeProtocols
                                                                                    ^{:tag (Set SSLScope)} scopes]
    (let [^{:tag (List SignatureScheme)} supported (LinkedList.)
          ^:mutable ^{:tag (List SignatureScheme)} schemesToCheck nil]
      (if (identical? (.-signatureSchemes config) SupportedSigSchemes/DEFAULT)
          (set! schemesToCheck (Arrays/asList (SignatureScheme/values)))
          (do
            (set! schemesToCheck (ArrayList.))
            (for-each [^String name (.-signatureSchemes config)]
              (let [ss (SignatureScheme/nameOf name)]

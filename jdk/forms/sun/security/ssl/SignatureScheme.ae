                    (.add schemesToCheck ss)
                    (SSLLogger/logWarning "ssl,handshake"
                                          (java-str
                                            "Unavailable configured signature scheme: "
                                            name)))))))
      (for-each [^SignatureScheme ss schemesToCheck]
        (if (not (.-isAvailable ss))
            (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake,verbose"))
              (SSLLogger/finest (java-str "Ignore unsupported signature scheme: " (.-name ss))))
            (let [^:mutable isMatch false]
              (for-each [^ProtocolVersion pv activeProtocols]
                (when (.isSupportedProtocol ss pv scopes) (set! isMatch true) (break)))
              (cond
                isMatch
                  (cond
                    (.isPermitted ss constraints scopes) (.add supported ss)
                    (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake,verbose"))
                      (SSLLogger/finest (java-str "Ignore disabled signature scheme: " (.-name ss))))
                (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake,verbose"))
                  (SSLLogger/finest (java-str "Ignore inactive signature scheme: " (.-name ss)))))))
      supported))

  (method ^:static getSupportedAlgorithms ^{:tag (List SignatureScheme)} [^SSLConfiguration config
                                                                          ^SSLAlgorithmConstraints constraints
                                                                          ^ProtocolVersion protocolVersion
                                                                          ^int/1 algorithmIds
                                                                          ^{:tag (Set SSLScope)} scopes]
    (let [^{:tag (List SignatureScheme)} supported (LinkedList.)]
      (for-each [^int ssid algorithmIds]
        (let [ss (SignatureScheme/valueOf ssid)]
          (cond
            (nil? ss)
              (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake"))
                (SSLLogger/warning
                  (java-str "Unsupported signature scheme: " (SignatureScheme/nameOf ssid))))
            (and (or (identical? (.-signatureSchemes config) SupportedSigSchemes/DEFAULT)
                     (Utilities/contains (.-signatureSchemes config) (.-name ss)))
                 (.isAllowed ss constraints protocolVersion scopes))
              (.add supported ss)
            (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake"))
              (SSLLogger/warning (java-str "Unsupported signature scheme: " (.-name ss))))))
      supported))

  (method ^:static getPreferableAlgorithm ^SignatureScheme [^SSLAlgorithmConstraints constraints
                                                            ^{:tag (List SignatureScheme)} schemes

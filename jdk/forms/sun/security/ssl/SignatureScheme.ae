                (when (some? signer) (return (AbstractMap$SimpleImmutableEntry. ss signer)))))))
      nil))

  (method ^:private isSupportedProtocol ^boolean [this ^ProtocolVersion version
                                                  ^{:tag (Set SSLScope)} scopes]
    (if (and (some? scopes) (.equals scopes HANDSHAKE_SCOPE))
        (.contains (.-handshakeSupportedProtocols this) version)
        (.contains (.-supportedProtocols this) version)))

  (method ^:private isAllowed ^boolean [this ^SSLAlgorithmConstraints constraints
                                        ^ProtocolVersion version ^{:tag (Set SSLScope)} scopes]
    (and (and isAvailable (.isSupportedProtocol this version scopes))
         (.isPermitted this constraints scopes)))


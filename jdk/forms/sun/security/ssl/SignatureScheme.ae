                    (when (and (some? keyGroup) (NamedGroup/isEnabled sslConfig keyGroup))
                      (let [signer (.getSigner ss signingKey)]
                        (when (some? signer) (return (AbstractMap$SimpleImmutableEntry. ss signer)))))))

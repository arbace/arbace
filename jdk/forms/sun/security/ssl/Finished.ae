                  (.containsKey (.-handshakeConsumers chc) (.-id SSLHandshake/CERTIFICATE_VERIFY)))
          (throw (.fatal (.-conContext chc)
                         Alert/UNEXPECTED_MESSAGE
                         "Unexpected Finished handshake message"))))
      (let [fm (FinishedMessage. chc message)]
        (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake"))
          (SSLLogger/fine "Consuming server Finished handshake message" fm))
        (when (.-secureRenegotiation (.-conContext chc))
          (set! (.-serverVerifyData (.-conContext chc)) (.-verifyData fm)))
        (.remove (.-consumers (.-conContext chc)) (.-id ContentType/CHANGE_CIPHER_SPEC))
        (.update (.-handshakeHash chc))
        (let [kd (.-handshakeKeyDerivation chc)]
          (when (nil? kd)
            (throw (.fatal (.-conContext chc) Alert/INTERNAL_ERROR "no key derivation")))
          (let [kdg (SSLTrafficKeyDerivation/valueOf (.-negotiatedProtocol chc))]
            (when (nil? kdg)
              (throw
                (.fatal (.-conContext chc)
                        Alert/INTERNAL_ERROR
                        (java-str "Not supported key derivation: " (.-negotiatedProtocol chc)))))
            (when (and (not (.-isResumption chc)) (.isRejoinable (.-handshakeSession chc)))
              (.put (cast SSLSessionContextImpl (.engineGetClientSessionContext (.-sslContext chc)))
                    (.-handshakeSession chc)))
            (let [^:mutable ^SecretKey saltSecret nil]
              (try
                (set! saltSecret (.deriveKey kd "TlsSaltSecret"))
                (let [hashAlg (.-hashAlg (.-negotiatedCipherSuite chc))
                      hkdf (KDF/getInstance (.-hkdfAlgorithm hashAlg))
                      zeros (new byte/1 (.-hashLength hashAlg))
                      masterSecret (.deriveKey hkdf
                                               "TlsMasterSecret"
                                               (.extractOnly
                                                 (.addIKM
                                                   (.addSalt
                                                     (HKDFParameterSpec/ofExtract)
                                                     saltSecret)
                                                   zeros)))
                      ^SSLKeyDerivation secretKD (SSLSecretDerivation. chc masterSecret)
                      readSecret (.deriveKey secretKD "TlsServerAppTrafficSecret")
                      writeKD (.createKeyDerivation kdg chc readSecret)
                      readKey (.deriveKey writeKD "TlsKey")
                      readIv (IvParameterSpec. (.deriveData writeKD "TlsIv"))
                      readCipher (.createReadCipher
                                   (.-bulkCipher (.-negotiatedCipherSuite chc))
                                   (Authenticator/valueOf (.-negotiatedProtocol chc))
                                   (.-negotiatedProtocol chc)
                                   readKey
                                   readIv
                                   (.getSecureRandom (.-sslContext chc)))]
                  (when (nil? readCipher)
                    (throw (.fatal (.-conContext chc)
                                   Alert/ILLEGAL_PARAMETER
                                   (java-str "Illegal cipher suite ("
                                             (.-negotiatedCipherSuite chc)
                                             ") and protocol version ("
                                             (.-negotiatedProtocol chc)
                                             ")"))))
                  (set! (.-baseReadSecret chc) readSecret)
                  (.changeReadCiphers (.-inputRecord (.-conContext chc)) readCipher)
                  (set! (.-handshakeKeyDerivation chc) secretKD)
                  (when (.-isQuic (.-sslConfig chc))
                    (let [engine (cast QuicTLSEngineImpl (.-transport (.-conContext chc)))]
                      (try
                        (.deriveOneRTTKeys engine)
                        (catch IOException e
                          (throw (.fatal (.-conContext chc)
                                         Alert/INTERNAL_ERROR
                                         "Failure to derive application secrets"
                                         e)))))))
                (catch GeneralSecurityException gse
                  (throw (.fatal (.-conContext chc)
                                 Alert/INTERNAL_ERROR
                                 "Failure to derive application secrets"
                                 gse)))
                (finally (KeyUtil/destroySecretKeys saltSecret)))
              (.put (.-handshakeProducers chc) (.-id SSLHandshake/FINISHED) SSLHandshake/FINISHED)
              (let [probableHandshakeMessages (new
                                                SSLHandshake/1
                                                [SSLHandshake/CERTIFICATE
                                                 SSLHandshake/CERTIFICATE_VERIFY
                                                 SSLHandshake/FINISHED])]
                (for-each [^SSLHandshake hs probableHandshakeMessages]
                  (let [handshakeProducer (cast HandshakeProducer
                                                (.remove (.-handshakeProducers chc) (.-id hs)))]
                    (when (some? handshakeProducer) (.produce handshakeProducer chc nil))))))))))

    (method ^:private onConsumeFinished :throws [IOException] ^void [this
                                                                     ^ServerHandshakeContext shc
                                                                     ^ByteBuffer message]
      (when-not (.-isResumption shc)
        (when (or (.containsKey (.-handshakeConsumers shc) (.-id SSLHandshake/CERTIFICATE))
                  (.containsKey (.-handshakeConsumers shc) (.-id SSLHandshake/CERTIFICATE_VERIFY)))
          (throw (.fatal (.-conContext shc)
                         Alert/UNEXPECTED_MESSAGE
                         "Unexpected Finished handshake message"))))
      (let [fm (FinishedMessage. shc message)]
        (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake"))
          (SSLLogger/fine "Consuming client Finished handshake message" fm))
        (when (.-secureRenegotiation (.-conContext shc))
          (set! (.-clientVerifyData (.-conContext shc)) (.-verifyData fm)))
        (let [kd (.-handshakeKeyDerivation shc)]
          (when (nil? kd)
            (throw (.fatal (.-conContext shc) Alert/INTERNAL_ERROR "no key derivation")))
          (let [kdg (SSLTrafficKeyDerivation/valueOf (.-negotiatedProtocol shc))]
            (when (nil? kdg)
              (throw
                (.fatal (.-conContext shc)
                        Alert/INTERNAL_ERROR
                        (java-str "Not supported key derivation: " (.-negotiatedProtocol shc)))))
            (try
              (let [readSecret (.deriveKey kd "TlsClientAppTrafficSecret")
                    readKD (.createKeyDerivation kdg shc readSecret)
                    readKey (.deriveKey readKD "TlsKey")
                    readIv (IvParameterSpec. (.deriveData readKD "TlsIv"))
                    readCipher (.createReadCipher
                                 (.-bulkCipher (.-negotiatedCipherSuite shc))
                                 (Authenticator/valueOf (.-negotiatedProtocol shc))
                                 (.-negotiatedProtocol shc)
                                 readKey
                                 readIv
                                 (.getSecureRandom (.-sslContext shc)))]
                (when (nil? readCipher)
                  (throw (.fatal (.-conContext shc)
                                 Alert/ILLEGAL_PARAMETER
                                 (java-str "Illegal cipher suite ("
                                           (.-negotiatedCipherSuite shc)
                                           ") and protocol version ("
                                           (.-negotiatedProtocol shc)
                                           ")"))))
                (set! (.-baseReadSecret shc) readSecret)
                (.changeReadCiphers (.-inputRecord (.-conContext shc)) readCipher)
                (let [exporterSecret (.deriveKey kd "TlsExporterMasterSecret")]
                  (.setExporterMasterSecret (.-handshakeSession shc) exporterSecret)
                  (.update (.-handshakeHash shc))
                  (let [sd (.forContext (cast SSLSecretDerivation kd) shc)
                        resumptionMasterSecret (.deriveKey sd "TlsResumptionMasterSecret")]
                    (.setResumptionMasterSecret (.-handshakeSession shc) resumptionMasterSecret))))
              (catch GeneralSecurityException gse
                (throw (.fatal (.-conContext shc)
                               Alert/INTERNAL_ERROR
                               "Failure to derive application secrets"
                               gse))))
            (set! (.-conSession (.-conContext shc)) (.finish (.-handshakeSession shc)))
            (set! (.-protocolVersion (.-conContext shc)) (.-negotiatedProtocol shc))
            (set! (.-handshakeFinished shc) true)
            (when-not (.isDTLS (.-sslContext shc)) (.finishHandshake (.-conContext shc)))
            (Finished/recordEvent (.-conSession (.-conContext shc)))
            (when (> SSLConfiguration/serverNewSessionTicketCount 0)
              (.produce NewSessionTicket/t13PosthandshakeProducer shc)))))))

  (method ^:private ^:static recordEvent ^void [^SSLSessionImpl session]
    (let [event (TLSHandshakeEvent.)]
      (when (or (.shouldCommit event) (EventHelper/isLoggingSecurity))
        (let [^:mutable ^int hash 0]
          (try
            (set! hash (.hashCode (aget (.getCertificateChain session) 0)))
            (catch SSLPeerUnverifiedException e))
          (let [peerCertificateId (Integer/toUnsignedLong hash)]
            (when (.shouldCommit event)
              (set! (.-peerHost event) (.getPeerHost session))
              (set! (.-peerPort event) (.getPeerPort session))
              (set! (.-cipherSuite event) (.getCipherSuite session))
              (set! (.-protocolVersion event) (.getProtocol session))
              (set! (.-certificateId event) peerCertificateId)
              (.commit event))
            (when (EventHelper/isLoggingSecurity)
              (EventHelper/logTLSHandshakeEvent nil
                                                (.getPeerHost session)
                                                (.getPeerPort session)
                                                (.getCipherSuite session)
                                                (.getProtocol session)
                                                peerCertificateId))))))))
